// lhcatholicby.GCH_CH_2

[{"GCH_CH_2_ID":"12","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041a\u043b\u0456\u043c\u044d\u043d\u0442\u0430 \u0406, \u043f\u0430\u043f\u044b, \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 59, 2 &ndash; 60, 4; 61, 3: Funk 1, 135-141)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0440\u044b\u043d\u0456\u0446\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 &ndash; \u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0456 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u0445 \u043f\u0430\u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0441\u0443\u0441\u0432\u0435\u0442\u0443 \u043f\u0440\u0430\u0437 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0435 \u0414\u0437\u0456\u0446\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u0446\u044d\u043b\u044b\u043c \u043b\u0456\u043a \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0441\u0432\u0430\u0456\u0445, \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0401\u043d \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430\u0441 \u0441\u0430 \u0437\u043c\u0440\u043e\u043a\u0443 \u0434\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u0430\u0434 \u043d\u0435\u0432\u0443\u0446\u0442\u0432\u0430 \u0434\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0441\u043b\u0430\u0432\u044b \u0456\u043c\u044f \u0441\u0432\u0430\u0439\u0433\u043e, \u043a\u0430\u0431 \u043c\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u0456\u043c\u044f \u0422\u0432\u0430\u0451 \u044f\u043a \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0443\u0441\u044f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u043a\u0430\u0431 \u043c\u044b, \u0430\u0434\u043a\u0440\u044b\u045e\u0448\u044b \u0432\u043e\u0447\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u043f\u0440\u044b\u0437\u043d\u0430\u043b\u0456 \u0426\u044f\u0431\u0435 \u0430\u0434\u043d\u0430\u0433\u043e, \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u0445; \u0441\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0435\u0448 \u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b\u0445; \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u0435\u0448 \u043f\u044b\u0445\u0443 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u0445; \u0440\u043e\u0431\u0456\u0448 \u0434\u0430\u0440\u044d\u043c\u043d\u044b\u043c\u0456 \u043d\u0430\u043c\u0435\u0440\u044b \u043d\u0430\u0440\u043e\u0434\u0430\u045e; \u0443\u0437\u0432\u044b\u0448\u0430\u0435\u0448 \u043f\u0430\u043a\u043e\u0440\u043b\u0456\u0432\u044b\u0445 \u0456 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u0435\u0448 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u0445; \u0440\u043e\u0431\u0456\u0448 \u0431\u0430\u0433\u0430\u0442\u044b\u043c\u0456 \u0456 \u0431\u0435\u0434\u043d\u044b\u043c\u0456; \u0437\u0430\u0431\u0456\u0432\u0430\u0435\u0448 \u0456 \u0440\u0430\u0442\u0443\u0435\u0448; \u0422\u044b \u0430\u0434\u0437\u0456\u043d\u044b \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u0446\u0430 \u0434\u0443\u0448\u0430\u045e \u0456 \u0411\u043e\u0433 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 (\u043f\u0430\u0440. \u0406\u0441 57, 15; 13, 1; \u041f\u0441 33 [32], 10 \u0456 \u043d\u0430\u0441\u0442.). \u0422\u044b \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435\u0448 \u0443 \u0431\u0435\u0437\u0434\u0430\u043d\u044c; \u0432\u0435\u0434\u0430\u0435\u0448 \u043b\u044e\u0434\u0441\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b; \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0448 \u0446\u044f\u0436\u043a\u0430 \u0445\u0432\u043e\u0440\u044b\u0445 \u0456 \u0440\u0430\u0442\u0443\u0435\u0448 \u0442\u044b\u0445, \u0448\u0442\u043e \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0456 \u043d\u0430\u0434\u0437\u0435\u044e. \u0422\u044b &ndash; \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0456 \u043d\u0430\u0433\u043b\u044f\u0434\u0447\u044b\u043a \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0434\u0443\u0445\u0430. \u0422\u044b \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435\u0448 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u0437 \u0443\u0441\u0456\u0445 \u0432\u044b\u0431\u0456\u0440\u0430\u0435\u0448 \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0422\u044b \u043d\u0430\u0441 \u0432\u044b\u0445\u0430\u0432\u0430\u045e, \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0456 \u045e\u0441\u043b\u0430\u0432\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0431\u0443\u0434\u0437\u044c \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0430\u0439 \u043d\u0430\u0448\u0430\u0439. \u0412\u044b\u0437\u0432\u0430\u043b\u0456 \u0442\u044b\u0445 \u0437 \u043d\u0430\u0441, \u0445\u0442\u043e \u0430\u043f\u044b\u043d\u0443\u045e\u0441\u044f \u045e \u043d\u044f\u0434\u043e\u043b\u0456; \u043f\u0430\u0434\u044b\u043c\u0456 \u0442\u044b\u0445, \u0448\u0442\u043e \u045e\u043f\u0430\u043b\u0456; \u043f\u0440\u044b\u0439\u0434\u0437\u0456 \u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0442\u044b\u043c, \u0445\u0442\u043e \u045e \u0433\u0430\u043b\u0435\u0447\u044b; \u0430\u0437\u0434\u0430\u0440\u0430\u0432\u0456 \u043d\u044f\u0434\u0443\u0436\u044b\u0445; \u0432\u044f\u0440\u043d\u0456 \u0442\u044b\u0445 \u0437 \u0422\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u0445\u0442\u043e \u0437\u0431\u0456\u045e\u0441\u044f \u0437 \u0434\u0430\u0440\u043e\u0433\u0456; \u043d\u0430\u043a\u0430\u0440\u043c\u0456 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u0445; \u0432\u044b\u0437\u0432\u0430\u043b\u0456 \u043d\u0430\u0448\u044b\u0445 \u0432\u044f\u0437\u043d\u044f\u045e; \u043f\u0430\u0434\u044b\u043c\u0456 \u0431\u044f\u0441\u0441\u0456\u043b\u044c\u043d\u044b\u0445; \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440 \u043c\u0430\u043b\u0430\u0434\u0443\u0448\u043d\u044b\u0445; \u043d\u044f\u0445\u0430\u0439 \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0448\u0442\u043e \u0422\u044b &ndash; \u0430\u0434\u0437\u0456\u043d\u044b \u0411\u043e\u0433, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0414\u0437\u0456\u0446\u044f \u0422\u0432\u0430\u0451, \u0430 &laquo;\u043c\u044b \u043d\u0430\u0440\u043e\u0434 \u0422\u0432\u043e\u0439 \u0456 \u0430\u0432\u0435\u0447\u043a\u0456 \u0442\u0432\u0430\u0451\u0439 \u043f\u0430\u0448\u044b&raquo; (\u041f\u0441 79 [78], 13).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0435\u043c \u0443\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u045e \u0432\u0435\u0447\u043d\u044b \u043b\u0430\u0434 \u0441\u0443\u0441\u0432\u0435\u0442\u0443. \u0422\u044b, \u041f\u0430\u043d\u0435, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u045e \u0437\u044f\u043c\u043b\u044e, \u0432\u0435\u0440\u043d\u044b \u0432\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u0445, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u045e \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u044f\u0445, \u0434\u0437\u0456\u045e\u043d\u044b \u045e \u0441\u0432\u0430\u0451\u0439 \u043c\u043e\u0446\u044b \u0456 \u0432\u0435\u043b\u0456\u0447\u044b; \u043c\u0443\u0434\u0440\u044b \u045e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456 \u0456 \u045e\u043c\u0435\u043b\u044b \u0432\u0430 \u045e\u043b\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u043d\u0456 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0433\u0430. \u0422\u044b \u0434\u043e\u0431\u0440\u044b \u0432\u0430 \u045e\u0441\u0456\u043c, \u0448\u0442\u043e \u0431\u0430\u0447\u043d\u0430\u0435, \u0456 \u0432\u0435\u0440\u043d\u044b \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0430 \u0426\u044f\u0431\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430, \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b; \u0430\u0434\u043f\u0443\u0441\u0446\u0456 \u043d\u0430\u043c \u043d\u0430\u0448\u044b \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456, \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0433\u0440\u0430\u0445\u0456 \u0456 \u043f\u0440\u0430\u0432\u0456\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0437\u0430\u043b\u0456\u0447\u044b \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443 \u0441\u043b\u0443\u0433\u0430\u043c \u0422\u0432\u0430\u0456\u043c, \u0430\u043b\u0435 \u0430\u0447\u044b\u0441\u0446\u0456 \u043d\u0430\u0441 \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0441\u0432\u0430\u0451\u0439 \u0456 \u0441\u043a\u0456\u0440\u0443\u0439 \u043d\u0430\u0448\u044b \u043a\u0440\u043e\u043a\u0456, \u043a\u0430\u0431 \u043c\u044b \u0436\u044b\u043b\u0456 \u045e \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u0441\u0442\u0430\u0446\u0435 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0440\u0430\u0431\u0456\u043b\u0456, \u0448\u0442\u043e \u0434\u043e\u0431\u0440\u0430\u0435 \u0456 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u0422\u0430\u0431\u0435 \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0430 \u0447\u0430\u043b\u0435 \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u041f\u0430\u043d\u0435, \u043f\u0430\u043a\u0430\u0436\u044b \u0441\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u043f\u0430-\u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u043a\u0430\u0431 \u043c\u044b \u0446\u0435\u0448\u044b\u043b\u0456\u0441\u044f \u0441\u043f\u0430\u043a\u043e\u0435\u043c, \u0431\u044b\u043b\u0456 \u0430\u0431\u0430\u0440\u043e\u043d\u0435\u043d\u044b\u044f \u0422\u0432\u0430\u0451\u0439 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0439 \u043f\u0440\u0430\u0432\u0456\u0446\u0430\u0439 \u0456 \u0431\u044b\u043b\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b\u044f \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443 \u0422\u0432\u0430\u0451\u0439 \u0443\u0437\u043d\u044f\u0442\u0430\u0439 \u0440\u0443\u043a\u043e\u0439. \u0423\u0440\u0430\u0442\u0443\u0439 \u043d\u0430\u0441 \u0430\u0434 \u0443\u0441\u0456\u0445, \u0445\u0442\u043e \u043d\u0430\u0441 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0439 \u043d\u0430\u043c \u0456 \u045e\u0441\u0456\u043c \u0436\u044b\u0445\u0430\u0440\u0430\u043c \u0437\u044f\u043c\u043b\u0456 \u0437\u0433\u043e\u0434\u0443 \u0456 \u043c\u0456\u0440, \u044f\u043a \u0434\u0430\u045e \u043d\u0430\u0448\u044b\u043c \u043f\u0440\u043e\u0434\u043a\u0430\u043c, \u044f\u043a\u0456\u044f \u043f\u0430\u0431\u043e\u0436\u043d\u0430 \u0426\u044f\u0431\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u045e \u0432\u0435\u0440\u044b \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u0422\u043e\u043b\u044c\u043a\u0456 \u0422\u044b \u043c\u043e\u0436\u0430\u0448 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0430\u043c \u0433\u044d\u0442\u0430\u0435 \u0456 \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0434\u0430\u0431\u0440\u043e, \u0422\u0430\u0431\u0435 \u0434\u0437\u044f\u043a\u0443\u0435\u043c \u043f\u0440\u0430\u0437 \u0421\u0432\u044f\u0442\u0430\u0440\u0430 \u0456 \u0430\u043f\u0435\u043a\u0443\u043d\u0430 \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u0448\u0430\u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0422\u0430\u0431\u0435 \u0441\u043b\u0430\u0432\u0430 \u0456 \u0432\u0435\u043b\u0456\u0447 \u0446\u044f\u043f\u0435\u0440, \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u045e \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435 \u0456 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 77 (76), 14-16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456 \u0431\u043e\u0433 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0456, \u044f\u043a \u043d\u0430\u0448 \u0411\u043e\u0433? <span style=\"color: #ff0000;\">*<\/span> \u0422\u044b &ndash; \u0411\u043e\u0433, \u044f\u043a\u0456 \u0447\u044b\u043d\u0456\u0446\u044c \u0446\u0443\u0434\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0441\u0432\u0430\u044e \u043c\u043e\u0446. \u0421\u0432\u0430\u0451\u0439 \u0440\u0443\u043a\u043e\u044e \u0422\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b &ndash; \u0411\u043e\u0433, \u044f\u043a\u0456 \u0447\u044b\u043d\u0456\u0446\u044c \u0446\u0443\u0434\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"13","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0434\u0440\u0430\u0431\u044f\u0437\u043d\u044b\u044f &laquo;\u0420\u044d\u0433\u0443\u043b\u044b&raquo; \u0441\u0432. \u0411\u0430\u0437\u044b\u043b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Resp. 2, 1: PG 31, 908-910)<\/span><br \/><span style=\"color: #ff0000;\">\u0423 \u043d\u0430\u0441 \u0451\u0441\u0446\u044c \u043f\u0440\u044b\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u044f \u043c\u043e\u0446 \u043b\u044e\u0431\u043e\u0432\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430 \u043d\u0435\u043b\u044c\u0433\u0430 \u043d\u0430\u0431\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e. \u041c\u044b \u0436 \u043d\u0435 \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0430\u0434 \u0456\u043d\u0448\u044b\u0445 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u0443, \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u0436\u044b\u0446\u0446\u044f, \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u0446\u0456 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u0446\u0430\u045e. \u0413\u044d\u0442\u0430\u043a \u0436\u0430, \u043d\u0430\u0432\u0430\u0442 \u043d\u0430\u0448\u043c\u0430\u0442 \u0431\u043e\u043b\u044c\u0448, \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430 \u043d\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0456 \u0437\u0432\u043e\u043d\u043a\u0443. \u0423 \u0441\u0430\u043c\u043e\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0436\u044b\u0432\u043e\u0439 \u0456\u0441\u0442\u043e\u0442\u044b (\u043a\u0430\u0436\u0443 \u043f\u0440\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430) \u0451\u0441\u0446\u044c \u043f\u044d\u045e\u043d\u0430\u044f \u0441\u0456\u043b\u0430 \u0440\u043e\u0437\u0443\u043c\u0443, \u044f\u043a \u0431\u044b \u043d\u0430\u0441\u0435\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0437\u043c\u044f\u0448\u0447\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0456 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u043b\u044e\u0431\u0456\u0446\u044c. \u041f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u044b\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u0433\u044d\u0442\u0430\u0435 \u043d\u0430\u0441\u0435\u043d\u043d\u0435, \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u043f\u0440\u0430\u0440\u043e\u0448\u0447\u0432\u0430\u0435 \u044f\u0433\u043e, \u0443\u043c\u0435\u043b\u0430 \u0436\u044b\u0432\u0456\u0446\u044c \u0456 \u0437 \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u0443\u0445\u0432\u0430\u043b\u044f\u044e\u0447\u044b \u0432\u0430\u0448\u0443 \u0440\u0443\u043f\u043d\u0430\u0441\u0446\u044c, \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0443\u044e \u0434\u043b\u044f \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0433\u044d\u0442\u0430\u0439 \u043c\u044d\u0442\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0437 \u0411\u043e\u0436\u0430\u0439 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0430\u0439 \u0456 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u044e \u0432\u0430\u0448\u044b\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u045e \u0440\u0430\u0441\u043f\u0430\u043b\u0456\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043c\u0435\u043d\u043d\u044f, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u043c\u043d\u0435 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0441\u0445\u0430\u0432\u0430\u043d\u0443\u044e \u045e \u0432\u0430\u0441 \u0456\u0441\u043a\u0440\u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451 \u0437\u0430\u0437\u043d\u0430\u0447\u044b\u043c, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c, \u044f\u043a \u0411\u043e\u0433 \u0434\u0430\u045e \u043d\u0430\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0434 \u042f\u0433\u043e \u0441\u0456\u043b\u044b \u0456 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0456\u0445. \u0422\u0430\u043c\u0443 \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043d\u0430\u0440\u0430\u043a\u0430\u0446\u044c, \u043d\u0456\u0431\u044b \u0430\u0434 \u043d\u0430\u0441 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0446\u0430 \u043d\u0435\u0448\u0442\u0430 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0435, \u0430\u0431\u043e \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430, \u043d\u0456\u0431\u044b \u043c\u044b \u0434\u0430\u0435\u043c \u043d\u0435\u0448\u0442\u0430 \u0431\u043e\u043b\u044c\u0448\u0430\u0435, \u0447\u044b\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456. \u041a\u0430\u043b\u0456 \u043c\u044b \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u0430 \u0456 \u043d\u0430\u043b\u0435\u0436\u043d\u0430 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0435\u043c \u0433\u044d\u0442\u044b\u044f \u0441\u0456\u043b\u044b, \u043c\u044b \u0432\u044f\u0434\u0437\u0451\u043c \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0430\u0437\u0434\u043e\u0431\u043b\u0435\u043d\u0430\u0435 \u0446\u043d\u043e\u0442\u0430\u043c\u0456; \u0430 \u043a\u0430\u043b\u0456 \u045e\u0436\u044b\u0432\u0430\u0435\u043c \u0456\u0445 \u043d\u0435\u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c, \u0442\u0440\u0430\u043f\u043b\u044f\u0435\u043c \u045e \u0437\u0430\u0433\u0430\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u045e \u0442\u044b\u043c \u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u0430\u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u0443: \u0434\u0440\u044d\u043d\u043d\u0430\u0435 \u0456 \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u043d\u0430\u0435 \u0411\u043e\u0436\u044b\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u043c \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043d\u043d\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044f\u045e, \u044f\u043a\u0456\u044f \u0411\u043e\u0433 \u0434\u0430\u045e \u043d\u0430\u043c \u0434\u043b\u044f \u0430\u0436\u044b\u0446\u0446\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0434\u0430\u0431\u0440\u0430. \u0406 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0446\u043d\u043e\u0442\u0430, \u044f\u043a\u043e\u0439 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0411\u043e\u0433, \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0446\u044c \u0456\u0445 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0411\u043e\u0436\u044b\u043c \u043d\u0430\u043a\u0430\u0437\u0430\u043c \u0456 \u0437 \u0434\u043e\u0431\u0440\u044b\u043c \u043d\u0430\u043c\u0435\u0440\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0435 \u0432\u044b\u0448\u044d\u0439 \u043c\u043e\u0436\u043d\u0430 \u043f\u0430\u045e\u0442\u0430\u0440\u044b\u0446\u044c \u0456 \u045e \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u043b\u044e\u0431\u043e\u0432\u0456. \u041f\u0435\u0440\u0448 \u0447\u044b\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430, \u043c\u044b \u0430\u0434\u0440\u0430\u0437\u0443 \u043f\u0430\u0441\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0456 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430. \u041d\u0435 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430 \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u0437\u043d\u0435\u0448\u043d\u044f\u0433\u0430 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u043d\u044f, \u0430\u043b\u0435 \u043a\u043e\u0436\u043d\u044b \u043c\u043e\u0436\u0430 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u043c\u0443 \u0441\u0430\u043c \u0456 \u0430\u0434 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435. \u0411\u043e \u043c\u044b \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u0430 \u0456\u043c\u043a\u043d\u0451\u043c\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0435 \u0456 \u0434\u043e\u0431\u0440\u0430\u0435, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u043d\u0435 \u045e\u0441\u0456\u043c \u0430\u0434\u043d\u043e \u0456 \u0442\u043e\u0435 \u0436 \u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u0434\u043e\u0431\u0440\u044b\u043c \u0456 \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u043c. \u041d\u0430\u0441 \u0436\u0430 \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0432\u0443\u0447\u044b\u0446\u044c \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0440\u043e\u0434\u043d\u044b\u0445 \u0456 \u0431\u043b\u0456\u0437\u043a\u0456\u0445, \u0430\u043b\u0435 \u043c\u044b \u0456\u0445 \u043b\u044e\u0431\u0456\u043c \u0441\u043f\u0430\u043d\u0442\u0430\u043d\u043d\u0430 \u0456 \u0437 \u0443\u0441\u0451\u0439 \u0437\u044b\u0447\u043b\u0456\u0432\u0430\u0441\u0446\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0448\u0442\u043e \u0436 &ndash; \u0441\u043f\u044b\u0442\u0430\u044e\u0441\u044f &ndash; \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0434\u0437\u0456\u045e\u043d\u044b\u043c, \u0447\u044b\u043c \u0411\u043e\u0436\u0430\u044f \u043a\u0440\u0430\u0441\u0430? \u0428\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u043b\u044e\u0431\u0430\u0435 \u0456 \u043c\u0456\u043b\u0430\u0435, \u0447\u044b\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0435 \u043d\u0430\u0434 \u0411\u043e\u0436\u0430\u044e \u0432\u0435\u043b\u0456\u0447\u0447\u0443? \u042f\u043a\u043e\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0434\u0443\u0448\u044b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0446\u043d\u0430\u0435 \u0434\u044b \u0456\u043c\u043a\u043b\u0456\u0432\u0430\u0435, \u044f\u043a \u0442\u043e\u0435, \u044f\u043a\u0456\u043c \u0411\u043e\u0433 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u0443\u044e \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443 \u0434\u0443\u0448\u0443, \u0448\u0442\u043e \u043a\u0430\u0436\u0430: &laquo;\u042f \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e\u044e&raquo; (\u043f\u0430\u0440. \u041f\u043f 2, 5). \u041a\u0440\u0430\u0441\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0431\u043b\u044f\u0441\u043a\u0443 \u043f\u0430-\u043f\u0440\u043e\u0441\u0442\u0443 \u043d\u0435\u0430\u043f\u0456\u0441\u0430\u043b\u044c\u043d\u0430\u044f \u0456 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 18 (17), 2-3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0443 \u043b\u044e\u0431\u0456\u0446\u044c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u043c\u043e\u0446 \u043c\u0430\u044f.<span style=\"color: #ff0000;\"> *<\/span> \u041f\u0430\u043d &ndash; \u043c\u0430\u044f \u0441\u043a\u0430\u043b\u0430 i \u043c\u0430\u044f \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044f, \u0401\u043d \u043c\u043e\u0439 \u0417\u0431\u0430\u045e\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u043c\u043e\u0439 &ndash; \u0430\u0431\u0430\u0440\u043e\u043d\u0430 \u043c\u0430\u044f, \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d &ndash; \u043c\u0430\u044f \u0441\u043a\u0430\u043b\u0430 i \u043c\u0430\u044f \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044f, \u0401\u043d \u043c\u043e\u0439 \u0417\u0431\u0430\u045e\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"14","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u044f\u045e&raquo; \u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 4, 6, 3. 5. 6. 7: SC 100, 422. 446. 448-454)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0410\u0439\u0446\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0437&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0421\u044b\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0410\u0439\u0446\u0430 \u0431\u0435\u0437 \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0433. \u0437\u043d. \u043a\u0430\u043b\u0456 \u043d\u0435 \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0421\u044b\u043d. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435\u043b\u044c\u0433\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0421\u044b\u043d\u0430 \u0431\u0435\u0437 \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456 \u0410\u0439\u0446\u0430. \u0412\u043e\u043b\u044e \u0410\u0439\u0446\u0430 \u0421\u044b\u043d \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u043f\u0440\u0430\u0437 \u0442\u043e\u0435, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0441\u044b\u043b\u0430\u0435, \u0421\u044b\u043d \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u043c\u0443 \u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c. \u0422\u043e\u043b\u044c\u043a\u0456 \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0432\u0435\u0434\u0430\u0435 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0456 \u043d\u0435\u0430\u043f\u0456\u0441\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u0410\u0439\u0446\u0430. \u0413\u044d\u0442\u0443 \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u0443\u044e \u043f\u0440\u0430\u045e\u0434\u0443 \u0430\u0434\u043a\u0440\u044b\u045e \u043d\u0430\u043c \u041f\u0430\u043d. \u0422\u0430\u043c\u0443 \u0421\u044b\u043d \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u043d\u0430\u043c \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0410\u0439\u0446\u0430. \u0410 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0410\u0439\u0446\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0437&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0421\u044b\u043d\u0430, \u0431\u043e \u045e\u0441\u0451 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u044f\u045e\u043d\u044b\u043c \u043f\u0440\u0430\u0437 \u0421\u043b\u043e\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0439\u0446\u0435\u0446 \u0430\u0434\u043a\u0440\u044b\u045e \u0421\u044b\u043d\u0430, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u045e\u0441\u0456\u043c, \u0456 \u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443\u0441\u0456\u0445, \u0445\u0442\u043e \u045e \u042f\u0433\u043e \u0432\u0435\u0440\u044b\u0446\u044c, \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044e \u0456 \u0432\u0435\u0447\u043d\u044b\u043c \u0448\u0447\u0430\u0441\u0446\u0435\u043c. \u0412\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e &ndash; \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u0432\u043e\u043b\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0421\u043b\u043e\u0432\u0430 \u043f\u0440\u0430\u0437 \u0441\u0432\u043e\u0439 \u0443\u043b\u0430\u0441\u043d\u044b \u0441\u0442\u0430\u043d \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435, \u0448\u0442\u043e \u0411\u043e\u0433 &ndash; \u0433\u044d\u0442\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c; \u043f\u0440\u0430\u0437 \u0441\u0432\u0435\u0442 &ndash; \u0448\u0442\u043e \u0401\u043d \u041f\u0430\u043d, \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0441\u0432\u0435\u0442\u0443; \u043f\u0440\u0430\u0437 \u0430\u0436\u044b\u0446\u0446\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f &ndash; \u0448\u0442\u043e \u0401\u043d \u0417\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u044c\u043d\u0456\u043a \u0433\u044d\u0442\u0430\u0433\u0430; \u043f\u0440\u0430\u0437 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0421\u044b\u043d\u0430 &ndash; \u0448\u0442\u043e \u0401\u043d \u0410\u0439\u0446\u0435\u0446, \u044f\u043a\u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u0421\u044b\u043d\u0430. \u0425\u043e\u0446\u044c \u0443\u0441\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c, \u0430\u043b\u0435 \u043d\u0435 \u045e\u0441\u0435 \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u0432\u0435\u0440\u0430\u0446\u044c. \u0422\u0430\u043a \u043f\u0440\u0430\u0437 \u0417\u0430\u043a\u043e\u043d \u0456 \u041f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0421\u043b\u043e\u0432\u0430 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0430 \u0441\u044f\u0431\u0435 \u0456 \u0410\u0439\u0446\u0430, \u0456 \u0445\u043e\u0446\u044c \u0443\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0441\u043b\u0443\u0445\u0430\u045e \u0430\u0434\u043d\u043e \u0456 \u0442\u043e\u0435 \u0436, \u0430\u0434\u043d\u0430\u043a \u043d\u0435 \u045e\u0441\u0435 \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456. \u041f\u0440\u0430\u0437 \u0442\u043e\u0435 \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0441\u0442\u0430\u043b\u0430 \u0431\u0430\u0447\u043d\u044b\u043c \u0456 \u0434\u0430\u0442\u044b\u043a\u0430\u043b\u044c\u043d\u044b\u043c, \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0410\u0439\u0446\u0435\u0446. \u0425\u043e\u0446\u044c \u043d\u0435 \u045e\u0441\u0435 \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u042f\u0433\u043e, \u0430\u0434\u043d\u0430\u043a \u0443\u0441\u0435 \u043f\u0430\u0431\u0430\u0447\u044b\u043b\u0456 \u0410\u0439\u0446\u0430 \u045e \u0421\u044b\u043d\u0443. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0410\u0439\u0446\u0435\u0446 \u0431\u044b\u045e \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0439 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044e \u0421\u044b\u043d\u0430, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0421\u044b\u043d \u0431\u044b\u045e \u0431\u0430\u0447\u043d\u0430\u0439 \u043f\u0440\u0430\u044f\u0432\u0430\u0439 \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b \u0432\u043e\u043b\u044e \u0410\u0439\u0446\u0430, \u0421\u044b\u043d \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u045e\u0441\u0451 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0430\u0436 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430. \u0411\u0435\u0437 \u042f\u0433\u043e \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0411\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u0410\u0439\u0446\u0430 \u0451\u0441\u0446\u044c \u0421\u044b\u043d. \u0410\u0439\u0446\u0430 \u0436 \u043c\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u0435\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044e \u0410\u0439\u0446\u0430 \u043f\u0440\u0430\u0437 \u0421\u044b\u043d\u0430. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0421\u044b\u043d\u0430, \u0430\u043f\u0440\u043e\u0447 \u0410\u0439\u0446\u0430; \u0456 \u0410\u0439\u0446\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u0430\u043f\u0440\u043e\u0447 \u0421\u044b\u043d\u0430 \u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u043c\u0443 \u0421\u044b\u043d \u0437\u0430\u0445\u043e\u0447\u0430 \u0430\u0434\u043a\u0440\u044b\u0446\u044c&raquo; (\u041c\u0446 11, 27). \u0421\u043b\u043e\u0432\u044b &laquo;\u0437\u0430\u0445\u043e\u0447\u0430 \u0430\u0434\u043a\u0440\u044b\u0446\u044c&raquo; \u0430\u0434\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u0456, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b \u0421\u043b\u043e\u0432\u0430 \u043f\u0430\u0447\u0430\u043b\u043e \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0430\u0434 \u041c\u0430\u0440\u044b\u0456, \u0430\u043b\u0435 \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0443\u0441\u0456\u0445 \u0447\u0430\u0441\u043e\u045e. \u0421\u044b\u043d, \u044f\u043a\u0456 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u0435 \u0441\u0432\u0430\u0439\u043c\u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044e, \u0430\u0431&rsquo;\u044f\u045e\u043b\u044f\u0435 \u0410\u0439\u0446\u0430 \u045e\u0441\u0456\u043c, \u043a\u0430\u043c\u0443 \u0410\u0439\u0446\u0435\u0446 \u0445\u043e\u0447\u0430 \u0430\u0434\u043a\u0440\u044b\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430 \u0456 \u044f\u043a \u0445\u043e\u0447\u0430. \u0422\u0430\u043c\u0443 \u0432\u0430 \u045e\u0441\u0456\u043c \u0456 \u043f\u0440\u0430\u0437 \u0443\u0441\u0451 \u0451\u0441\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433 \u0410\u0439\u0446\u0435\u0446, \u0430\u0434\u043d\u043e \u0421\u043b\u043e\u0432\u0430, \u0421\u044b\u043d \u0456 \u0430\u0434\u0437\u0456\u043d \u0414\u0443\u0445, \u0430\u0434\u043d\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0434\u043b\u044f \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u045e \u042f\u0433\u043e \u0432\u0435\u0440\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 1, 18; \u041c\u0446 11, 27<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e. <span style=\"color: #ff0000;\">*<\/span> \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0421\u044b\u043d, \u044f\u043a\u0456 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0410\u0439\u0446\u0430, \u0401\u043d \u0430\u0431&rsquo;\u0432\u044f\u0441\u0446\u0456\u045e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0439\u0446\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u0430\u043f\u0440\u043e\u0447 \u0421\u044b\u043d\u0430 \u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u043c\u0443 \u0421\u044b\u043d \u0437\u0430\u0445\u043e\u0447\u0430 \u0430\u0434\u043a\u0440\u044b\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0421\u044b\u043d, \u044f\u043a\u0456 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0410\u0439\u0446\u0430, \u0401\u043d \u0430\u0431&rsquo;\u0432\u044f\u0441\u0446\u0456\u045e.<\/p>\r\n"}, {"GCH_CH_2_ID":"15","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0440\u0430\u043c\u043e\u0432\u0430 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e&raquo; \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 40-42; PG 25, 79-83)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0421\u043b\u043e\u0432\u0430 \u0410\u0439\u0446\u0430 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0435, \u0443\u043b\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0435 \u0456 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u045e\u0441\u0451<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0439\u0446\u0435\u0446 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u043d\u0430\u0447\u043d\u0430 \u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0437\u0430 \u045e\u0441\u0435 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u044f \u0440\u044d\u0447\u044b, \u0431\u043e \u0401\u043d \u044f\u043a \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u044b \u041a\u0456\u0440\u0430\u045e\u043d\u0456\u043a \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0451\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u045e\u043b\u0430\u0441\u043d\u0430\u043c\u0443 \u0421\u043b\u043e\u0432\u0443, \u043d\u0430\u0448\u0430\u043c\u0443 \u041f\u0430\u043d\u0443 \u0456 \u0417\u0431\u0430\u045e\u0446\u0443 \u0425\u0440\u044b\u0441\u0442\u0443, \u0443\u0441\u0456\u043c \u0456 \u045e\u0441\u044e\u0434\u044b \u043a\u0456\u0440\u0443\u0435, \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0456 \u045e\u0441\u0451 \u0440\u043e\u0431\u0456\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0430\u043b\u0456\u0447\u044b\u0446\u044c \u0441\u043b\u0443\u0448\u043d\u044b\u043c. \u0422\u0430\u043c\u0443 \u0441\u0432\u0435\u0442, \u044f\u043a\u0456\u043c \u043c\u044b \u044f\u0433\u043e \u0431\u0430\u0447\u044b\u043c \u0456 \u044f\u043a\u0456\u043c \u0411\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u044f\u0433\u043e, \u0434\u043e\u0431\u0440\u044b, \u0431\u043e \u0442\u0430\u043a \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0411\u043e\u0433. \u0406 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0430\u0441\u043f\u0440\u044d\u0447\u044b\u0446\u044c. \u041a\u0430\u043b\u0456 \u0431 \u0443\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0440\u0443\u0445\u0430\u043b\u0430\u0441\u044f \u0431\u044f\u0437\u043c\u044d\u0442\u043d\u0430 \u0456 \u0441\u0432\u0435\u0442 \u0456\u0441\u043d\u0430\u0432\u0430\u045e \u0431\u044b \u045e\u0441\u043b\u044f\u043f\u0443\u044e, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0431 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u043c\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456. \u0410\u0434\u043d\u0430\u043a \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0432\u0435\u0442 \u0431\u044b\u045e \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u044b \u0440\u0430\u0437\u0443\u043c\u043d\u0430, \u043c\u0443\u0434\u0440\u0430 \u0456 \u045e\u043c\u0435\u043b\u0430 \u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u044b \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043a\u0440\u0430\u0441\u043e\u0439, \u0442\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u045e \u044f\u0433\u043e, \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u043d\u0435 \u0445\u0442\u043e \u0456\u043d\u0448\u044b, \u044f\u043a \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0443\u0442 \u043c\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0430\u0441\u043e\u0431\u0430 \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u043e\u0435 \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c \u0443\u0441\u0456\u0445 \u0440\u044d\u0447\u0430\u045e, \u0436\u044b\u0432\u044b\u043c \u0456 \u0434\u0437\u0435\u0439\u043d\u044b\u043c. \u042f\u043d\u043e \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0443\u0441\u0456\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e. \u042f\u043d\u043e \u0430\u0434\u0437\u0456\u043d\u0430\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0410\u0439\u0446\u0430. \u0421\u0432\u0430\u0451\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u042f\u043d\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0441\u0430\u0431\u043e\u044e \u0436 \u0441\u0432\u0435\u0442. \u042f\u043d\u043e, \u0421\u043b\u043e\u0432\u0430 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, \u0443\u043d\u0435\u0441\u043b\u0430 \u043f\u0430\u0440\u0430\u0434\u0430\u043a \u0443 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0435 \u0421\u043b\u043e\u0432\u0430\u043c \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0410\u0439\u0446\u0430 \u0456, \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u045e\u0448\u044b \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u0439 \u043f\u0440\u043e\u0446\u0456\u043b\u0435\u0433\u043b\u044b\u044f \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b, \u0443\u0442\u0432\u0430\u0440\u044b\u043b\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u0433\u0430\u0440\u043c\u043e\u043d\u0456\u044e. \u042f\u043d\u043e &ndash; \u0430\u0434\u0437\u0456\u043d\u044b \u0434\u043e\u0431\u0440\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0410\u0439\u0446\u0430, \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0434\u0430\u0431\u0440\u0430. \u042f\u043d\u043e \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0435, \u0443\u043b\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0435 \u0456 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u045e\u0441\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u0445\u0442\u043e \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0443\u0441\u0451 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0456 \u0434\u0430\u045e \u0443\u0441\u0456\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u043c \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u0443\u044e \u0456\u043c \u043d\u0430\u0442\u0443\u0440\u0443, \u043d\u0435 \u0445\u0430\u0446\u0435\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u043b\u0456\u0441\u044f \u0441\u043b\u044f\u043f\u044b\u043c \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u0456 \u043f\u0430\u0434\u043b\u0435\u0433\u043b\u0456 \u043f\u043e\u045e\u043d\u0430\u043c\u0443 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044e. \u0423 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0456 \u043f\u0440\u044b \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0435 \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u0401\u043d \u043a\u0456\u0440\u0443\u0435 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0442\u0430\u043c \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u044f\u0433\u043e. \u0422\u0430\u043a \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u0430\u0435 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0421\u043b\u043e\u0432\u0430, \u041f\u0440\u043e\u0432\u0456\u0434\u0430\u043c \u0456 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u043d\u0435\u043c, \u043c\u043e\u0436\u0430 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0456 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u0456\u0441\u043d\u0430\u0432\u0430\u0446\u044c. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u044f\u043d\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0421\u043b\u043e\u0432\u0430 \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u042f\u0433\u043e \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u0435. \u0422\u0430\u043a, \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u0446\u044c, \u0448\u0442\u043e \u043d\u0435\u043f\u0430\u0437\u0431\u0435\u0436\u043d\u0430 \u0430\u0434\u0431\u044b\u043b\u043e\u0441\u044f \u0431, \u043a\u0430\u043b\u0456 \u0431 \u0421\u043b\u043e\u0432\u0430 \u043d\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0430 \u044f\u0433\u043e. \u042f\u043a \u043d\u0430\u0441 \u0432\u0443\u0447\u0430\u0446\u044c \u0443 \u0421\u0432\u044f\u0442\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0456 \u0441\u043b\u0443\u0433\u0456 \u043f\u0440\u0430\u045e\u0434\u044b: &laquo;\u0401\u043d \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f&raquo; (\u041a\u043b\u0441 1, 15), \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e \u0406\u043c \u0456 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u045e\u0441\u0451 \u0456\u0441\u043d\u0443\u0435, \u0440\u044d\u0447\u044b \u0431\u0430\u0447\u043d\u044b\u044f \u0456 \u043d\u044f\u0431\u0430\u0447\u043d\u044b\u044f. \u0401\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0413\u0430\u043b\u0430\u0432\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0435 \u0456 \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0435 \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0432\u0430 \u045e\u0441\u0451, \u0443\u0441\u044e\u0434\u044b \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0435 \u0441\u0432\u0430\u044e \u043c\u043e\u0446 \u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u045e\u0441\u0435 \u0431\u0430\u0447\u043d\u044b\u044f \u0456 \u043d\u044f\u0431\u0430\u0447\u043d\u044b\u044f \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456 \u0441\u0432\u0430\u0456\u043c \u0431\u043b\u044f\u0441\u043a\u0430\u043c, \u0442\u0430\u043a \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u0456 \u0430\u0431&rsquo;\u044f\u0434\u043d\u043e\u045e\u0432\u0430\u0435 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043f\u0430-\u0437\u0430 \u042f\u0433\u043e \u043c\u043e\u0446\u0430\u0439. \u0423\u0441\u0451 \u0456 \u045e\u0441\u044e\u0434\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0430\u0434 \u042f\u0433\u043e \u0436\u044b\u0446\u0446\u0451, \u0456 \u045e\u0441\u0451 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0406\u043c, \u043a\u043e\u0436\u043d\u0430\u044f \u0440\u044d\u0447 \u043f\u0430\u0430\u0441\u043e\u0431\u043a\u0443 \u0456 \u045e\u0441\u0435 \u0440\u0430\u0437\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041f\u0440\u044b\u043f 8, 22-30<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0435\u0440\u0448 \u0447\u044b\u043c \u0411\u043e\u0433 \u043d\u0430\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u045e\u0447\u044b\u043d\u0456\u045e \u0437\u044f\u043c\u043b\u044e, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u044f\u0435 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0456, \u043a\u0430\u043b\u0456 \u044f\u0448\u0447\u044d \u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0430 \u0431\u0435\u0437\u0434\u0430\u043d\u044c \u0432\u043e\u0434, <span style=\"color: #ff0000;\">*<\/span> \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u0433\u043e\u0440\u044b \u0441\u0442\u0430\u043b\u0456, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u043c\u044f\u043d\u0435 \u041f\u0430\u043d \u043f\u0435\u0440\u0430\u0434 \u043f\u0430\u0433\u043e\u0440\u043a\u0430\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0401\u043d \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u043d\u0435\u0431\u0430, \u044f \u0431\u044b\u043b\u0430 \u0437 \u0406\u043c, \u0443\u043b\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u045e\u0441\u0451.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0435\u0440\u0448 \u0447\u044b\u043c \u0433\u043e\u0440\u044b \u0441\u0442\u0430\u043b\u0456, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u043c\u044f\u043d\u0435 \u041f\u0430\u043d \u043f\u0435\u0440\u0430\u0434 \u043f\u0430\u0433\u043e\u0440\u043a\u0430\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"16","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0440\u0430\u043c\u043e\u0432\u0430 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e&raquo; \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 42-43; PG 25, 83-87)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0421\u043b\u043e\u0432\u0443 \u045e\u0441\u0435 \u0440\u044d\u0447\u044b \u045e\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0443\u044e \u0411\u043e\u0436\u0443\u044e \u0433\u0430\u0440\u043c\u043e\u043d\u0456\u044e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u043c\u0430 \u0456 \u043d\u0435 \u045e\u0437\u043d\u0456\u043a\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430, \u0448\u0442\u043e \u0431 \u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0430 \u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u0431 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u0430 \u045e \u0421\u043b\u043e\u0432\u0435 \u0456 \u043f\u0440\u0430\u0437 \u0421\u043b\u043e\u0432\u0430, \u044f\u043a \u0432\u0443\u0447\u044b\u0446\u044c \u0441\u0432. \u042f\u043d: &laquo;\u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430, \u0456 \u0421\u043b\u043e\u0432\u0430 \u0431\u044b\u043b\u043e \u045e \u0411\u043e\u0433\u0430, \u0456 \u0411\u043e\u0433\u0430\u043c \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430. \u042f\u043d\u043e \u0431\u044b\u043b\u043e \u045e \u0411\u043e\u0433\u0430 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443. \u0423\u0441\u0451 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u0456 \u0431\u0435\u0437 \u042f\u0433\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f&raquo; (\u043f\u0430\u0440. \u042f\u043d 1, 1).<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043c\u0443\u0437\u044b\u043a\u0430 \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0434\u043e\u0431\u0440\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0430\u0439 \u043b\u0456\u0440\u044b, \u0441\u043f\u0430\u043b\u0443\u0447\u0430\u044e\u0447\u044b \u043d\u0456\u0437\u043a\u0456\u044f, \u0432\u044b\u0441\u043e\u043a\u0456\u044f, \u0441\u044f\u0440\u044d\u0434\u043d\u0456\u044f \u0456 \u0456\u043d\u0448\u044b\u044f \u0433\u0443\u043a\u0456, \u0443\u0442\u0432\u0430\u0440\u0430\u0435 \u0430\u0434\u043d\u0443 \u043c\u0435\u043b\u043e\u0434\u044b\u044e, \u0442\u0430\u043a \u0456 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0430\u044f, \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u045e \u0441\u0432\u0430\u0456\u0445 \u0434\u0430\u043b\u043e\u043d\u044f\u0445 \u0441\u0443\u0441\u0432\u0435\u0442, \u0431\u044b\u0446\u0446\u0430\u043c \u043b\u0456\u0440\u0443, \u0441\u043f\u0430\u043b\u0443\u0447\u0430\u0435 \u0437\u044f\u043c\u043d\u044b\u044f \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0440\u044d\u0447\u044b, \u0441\u0443\u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u0446\u044d\u043b\u0430\u0435 \u0437 \u043f\u0430\u0430\u0441\u043e\u0431\u043d\u044b\u043c\u0456 \u0447\u0430\u0441\u0442\u043a\u0430\u043c\u0456, \u0443\u0441\u0456\u043c \u043a\u0456\u0440\u0443\u0435 \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u044f\u0439 \u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u043c. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0443\u0442\u0432\u0430\u0440\u0430\u0435 \u0430\u0434\u0437\u0456\u043d \u0441\u0432\u0435\u0442 \u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u0430\u0440\u0430\u0434\u0430\u043a \u0441\u0432\u0435\u0442\u0443, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0441\u0443\u043b\u0430\u0434\u0434\u0437\u0435\u043c \u0456 \u043a\u0440\u0430\u0441\u043e\u0439. \u0422\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u043e\u0435 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u044b\u043c \u0443 \u0410\u0439\u0446\u0430, \u0443\u0441\u0451 \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0440\u0443\u0445 \u0443 \u0437\u0430\u043b\u0435\u0436\u043d\u0430\u0441\u0446\u0456 \u0430\u0434 \u0432\u043e\u043b\u0456 \u0410\u0439\u0446\u0430. \u0423\u0441\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0430\u0434 \u042f\u0433\u043e \u0436\u044b\u0446\u0446\u0451 \u0456 \u045e\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0443\u044e \u0411\u043e\u0436\u0443\u044e \u0433\u0430\u0440\u043c\u043e\u043d\u0456\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0442\u0430\u043a\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0432\u043e\u0431\u0440\u0430\u0437\u0430, \u0432\u043e\u0437\u044c\u043c\u0435\u043c \u0437\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0445\u043e\u0440, \u044f\u043a\u0456 \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0437 \u043c\u043d\u043e\u0433\u0456\u0445 \u0441\u043f\u0435\u0432\u0430\u043a\u043e\u045e. \u042f\u043a \u0456 \u045e \u0445\u043e\u0440\u044b, \u044f\u043a\u0456 \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0437 \u043c\u043d\u043e\u0433\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u043c\u0443\u0436\u0447\u044b\u043d \u0456 \u0445\u043b\u043e\u043f\u0446\u0430\u045e, \u0434\u0437\u044f\u045e\u0447\u0430\u0442, \u0441\u0442\u0430\u0440\u044b\u0445 \u0456 \u044e\u043d\u0430\u043a\u043e\u045e, \u0443\u0441\u0435 \u043f\u0430\u0434 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0430\u0434\u043d\u0430\u0433\u043e \u0434\u044b\u0440\u044b\u0436\u043e\u0440\u0430 \u0441\u043f\u044f\u0432\u0430\u044e\u0446\u044c \u0443 \u0437\u0430\u043b\u0435\u0436\u043d\u0430\u0441\u0446\u0456 \u0430\u0434 \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u044b\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u0445 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044f\u045e \u0456 \u043d\u0430\u0431\u044b\u0442\u044b\u0445 \u0443\u043c\u0435\u043d\u043d\u044f\u045e: \u043c\u0443\u0436\u0447\u044b\u043d\u0430 &ndash; \u044f\u043a \u043c\u0443\u0436\u0447\u044b\u043d\u0430, \u0445\u043b\u043e\u043f\u0435\u0446 &ndash; \u044f\u043a \u0445\u043b\u043e\u043f\u0435\u0446, \u0441\u0442\u0430\u0440\u044b &ndash; \u044f\u043a \u0441\u0442\u0430\u0440\u044b, \u044e\u043d\u0430\u043a &ndash; \u044f\u043a \u044e\u043d\u0430\u043a, \u0430\u0434\u043d\u0430\u043a \u0443\u0441\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u0430\u0434\u043d\u0443 \u043c\u0435\u043b\u043e\u0434\u044b\u044e. \u0410\u0431\u043e \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u0434\u0443\u0448\u0430 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u0440\u043e\u0437\u043d\u044b\u044f \u043f\u0430\u0447\u0443\u0446\u0446\u0456, \u0443\u043b\u0456\u0447\u0432\u0430\u044e\u0447\u044b \u045e\u0441\u044e \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0430\u0441\u0446\u044c \u0456\u0445 \u0434\u0437\u0435\u044f\u043d\u043d\u044f\u045e. \u0422\u0430\u043a, \u0430\u0434\u0437\u0456\u043d \u0456 \u0442\u043e\u0439 \u0436\u0430 \u043f\u0440\u0430\u0434\u043c\u0435\u0442 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u0440\u043e\u0437\u043d\u044b\u044f \u0440\u044d\u0430\u043a\u0446\u044b\u0456: \u0432\u043e\u043a\u0430 \u0431\u0430\u0447\u044b\u0446\u044c, \u0432\u0443\u0445\u0430 \u0447\u0443\u0435, \u0440\u0443\u043a\u0430 \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u0435\u0446\u0446\u0430, \u0441\u043c\u0430\u043a \u0456 \u043d\u044e\u0445 \u0430\u0434\u0447\u0443\u0432\u0430\u044e\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u044f \u0447\u0430\u0441\u0442\u043a\u0456 \u0446\u0435\u043b\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0435 \u0444\u0443\u043d\u043a\u0446\u044b\u0456, \u043d\u0430\u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u043d\u043e\u0433\u0456 \u0445\u043e\u0434\u0437\u044f\u0446\u044c. \u0422\u043e\u0435 \u0436 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456. \u0425\u043e\u0446\u044c \u0433\u044d\u0442\u0430\u0435 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0435 \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435, \u0430\u0434\u043d\u0430\u043a \u044f\u0433\u043e \u043c\u043e\u0436\u043d\u0430 \u045e\u0436\u044b\u0446\u044c \u0443 \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0437\u0456\u043d\u044b\u043c \u0456\u043c\u043f\u0443\u043b\u044c\u0441\u0430\u043c \u0432\u043e\u043b\u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u045e\u0441\u0451: \u043a\u043e\u0436\u043d\u0430\u044f \u0440\u044d\u0447 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0451\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456, \u0430 \u045e\u0441\u0435 \u0440\u0430\u0437\u0430\u043c \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u043b\u0430\u0434.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0422\u0431 12, 6. 18. 20<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0411\u043e\u0433\u0430 \u0456 \u0445\u0432\u0430\u043b\u0456\u0446\u0435 \u042f\u0433\u043e \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0436\u044b\u0432\u044b\u043c\u0456 <span style=\"color: #ff0000;\">*<\/span> \u0437\u0430 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b, \u044f\u043a\u0456\u044f \u0432\u0430\u043c \u0437\u0440\u0430\u0431\u0456\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u042f\u0433\u043e, \u0441\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u042f\u043c\u0443 \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u0446\u0435 \u045e\u0441\u0435 \u042f\u0433\u043e \u0446\u0443\u0434\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b, \u044f\u043a\u0456\u044f \u0432\u0430\u043c \u0437\u0440\u0430\u0431\u0456\u045e.<\/p>\r\n"}, {"GCH_CH_2_ID":"17","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e \u0441\u0432. \u041a\u043b\u0456\u043c\u044d\u043d\u0442\u0430 \u0406, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 31-33: Funk 1, 99-103)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0411\u043e\u0433 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u045e \u0443\u0441\u0456\u0445 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0434\u0443\u043c\u0430\u0435\u043c\u0441\u044f \u043d\u0430\u0434 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0411\u043e\u0436\u044b\u043c \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u043c, \u044f\u043a\u0456\u044f \u0448\u043b\u044f\u0445\u0456 \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u044f\u0433\u043e? \u0417\u0433\u0430\u0434\u0430\u0435\u043c \u0445\u043e\u0434 \u043f\u0430\u0434\u0437\u0435\u044f\u045e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443. \u0417\u0430 \u0448\u0442\u043e \u0410\u0431\u0440\u0430\u0433\u0430\u043c, \u043d\u0430\u0448 \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445, \u0431\u044b\u045e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b? \u0425\u0456\u0431\u0430 \u043d\u0435 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u043f\u0440\u0430\u045e\u0434\u0443? \u0406\u0441\u0430\u0430\u043a, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0430\u0434\u0431\u0443\u0434\u0437\u0435\u0446\u0446\u0430, \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0443. \u042f\u043a\u0443\u0431 \u0443 \u043f\u0430\u043a\u043e\u0440\u044b \u0441\u0430\u0441\u0442\u0443\u043f\u0456\u045e \u0441\u0432\u0430\u044e \u0437\u044f\u043c\u043b\u044e \u0431\u0440\u0430\u0442\u0443 \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u041b\u0430\u0431\u0430\u043d\u0430 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u044f\u043c\u0443. \u0406 \u044f\u043c\u0443 \u0431\u044b\u043b\u0456 \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u044f \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0436\u044d\u0437\u043b\u0430\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0448\u0447\u044b\u0440\u0430 \u043f\u0430\u0434\u0443\u043c\u0430\u0446\u044c \u043d\u0430\u0434 \u0434\u0430\u0440\u0430\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456, \u043c\u043e\u0436\u043d\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0456\u0445 \u0445\u0430\u0440\u0430\u0441\u0442\u0432\u043e. \u0411\u043e \u0430\u0434 \u042f\u043a\u0443\u0431\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0443\u0441\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u044b \u0456 \u043b\u0435\u0432\u0456\u0442\u044b, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u043f\u0440\u044b \u0430\u043b\u0442\u0430\u0440\u044b \u041f\u0430\u043d\u0430. \u0410\u0434 \u044f\u0433\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0410\u0434 \u044f\u0433\u043e \u043f\u0440\u0430\u0437 \u0440\u043e\u0434 \u042e\u0434\u044b &ndash; \u043a\u0430\u0440\u0430\u043b\u0456, \u043a\u043d\u044f\u0437\u0456 \u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u044b. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f \u044f\u0433\u043e \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456 \u0446\u0435\u0448\u044b\u043b\u0456\u0441\u044f \u043d\u0435 \u043c\u0435\u043d\u0448\u044b\u043c \u0433\u043e\u043d\u0430\u0440\u0430\u043c, \u0431\u043e \u041f\u0430\u043d \u0430\u0431\u044f\u0446\u0430\u045e: &laquo;\u041f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0442\u0432\u0430\u0451 \u0431\u0443\u0434\u0437\u0435 \u044f\u043a \u0437\u043e\u0440\u043a\u0456 \u043d\u0430 \u043d\u0435\u0431\u0435&raquo; (\u0411\u044b\u0446 15, 5; 22, 17, 26, 4). \u0406 \u045e\u0441\u0435 \u044f\u043d\u044b \u0437\u0434\u0430\u0431\u044b\u043b\u0456 \u0441\u043b\u0430\u0432\u0443 \u0456 \u043f\u0430\u0448\u0430\u043d\u0443 \u043d\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435, \u0441\u0432\u0430\u0456\u043c \u0441\u043f\u0440\u0430\u0432\u0430\u043c \u0446\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0443\u0447\u044b\u043d\u043a\u0430\u043c, \u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u0433\u043e \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456. \u0406 \u043c\u044b, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u042f\u0433\u043e \u0432\u043e\u043b\u044f\u0439 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435\u043c \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435 \u043d\u0435 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0440\u043e\u0437\u0443\u043c, \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0446\u0456 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456, \u0430\u043b\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b, \u043f\u0440\u0430\u0437 \u044f\u043a\u0443\u044e \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0411\u043e\u0433 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u045e \u0443\u0441\u0456\u0445 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443. \u0406 \u042f\u043c\u0443 \u0441\u043b\u0430\u0432\u0430 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0448\u0442\u043e \u0436 \u043d\u0430\u043c \u0440\u0430\u0431\u0456\u0446\u044c, \u0431\u0440\u0430\u0442\u044b? \u0410\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u0446\u0430 \u0430\u0434 \u0434\u043e\u0431\u0440\u044b\u0445 \u0441\u043f\u0440\u0430\u045e \u0456 \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u0446\u044c \u043b\u044e\u0431\u043e\u045e? \u041d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u043d\u0430\u043c \u0433\u044d\u0442\u0430\u0433\u0430, \u0430\u043b\u0435 \u0437 \u0440\u0443\u043f\u043d\u0430\u0441\u0446\u044e \u0456 \u0433\u0430\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044e \u0434\u0443\u0445\u0430 \u043f\u0430\u0441\u043f\u044f\u0448\u0430\u0435\u043c\u0441\u044f \u0434\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b. \u0411\u043e \u0441\u0430\u043c \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0456 \u041f\u0430\u043d \u0441\u0443\u0441\u0432\u0435\u0442\u0443 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456. \u0401\u043d \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u043d\u044f\u0431\u0451\u0441\u044b \u0441\u0432\u0430\u0451\u0439 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0456 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0439 \u043c\u043e\u0446\u0430\u0439, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u045e \u0456\u0445 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0441\u0432\u0430\u0451\u0439. \u0401\u043d \u0430\u0434\u0434\u0437\u044f\u043b\u0456\u045e \u0437\u044f\u043c\u043b\u044e \u0430\u0434 \u0432\u0430\u0434\u044b, \u0448\u0442\u043e \u044f\u0435 \u0430\u0442\u0430\u0447\u0430\u0435, \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u043d\u0430 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u044b\u043c \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443 \u0441\u0432\u0430\u0451\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456; \u0456 \u0436\u044b\u0432\u044b\u043c \u0456\u0441\u0442\u043e\u0442\u0430\u043c, \u044f\u043a\u0456\u044f \u044f\u0435 \u043d\u0430\u0441\u044f\u043b\u044f\u044e\u0446\u044c, \u0441\u0432\u0430\u0456\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u043c \u0434\u0430\u045e \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u0435; \u0441\u0432\u0430\u0451\u044e \u043c\u043e\u0446\u0430\u0439 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u043c\u043e\u0440\u0430, \u044f\u043a\u043e\u0435 \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0441\u0442\u0432\u0430\u0440\u044b\u045e, \u0436\u044b\u0432\u044b\u043c\u0456 \u0456\u0441\u0442\u043e\u0442\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430 \u045e\u0441\u044f\u0433\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 &ndash; \u043d\u0430\u0439\u0446\u0443\u0434\u043e\u045e\u043d\u0435\u0439\u0448\u0443\u044e \u0436\u044b\u0432\u0443\u044e \u0456\u0441\u0442\u043e\u0442\u0443, \u0430\u0434\u043e\u0440\u0430\u043d\u0443\u044e \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u0434\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0411\u043e\u0436\u0430\u0433\u0430. \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0411\u043e\u0433: &laquo;\u0421\u0442\u0432\u043e\u0440\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u0432\u043e\u0431\u0440\u0430\u0437 \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u043d\u0430\u0448\u0430; \u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0411\u043e\u0433 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430: \u043c\u0443\u0436\u0447\u044b\u043d\u0430\u043c \u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u0439 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0456\u0445&raquo; (\u043f\u0430\u0440. \u0411\u044b\u0446 1, 26-27). \u0417\u0430\u0432\u044f\u0440\u0448\u044b\u045e\u0448\u044b \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u043f\u0430\u0445\u0432\u0430\u043b\u0456\u045e \u0443\u0441\u0451, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u043b\u0430\u0434\u0437\u0456\u0446\u0435\u0441\u044f \u0456 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0439\u0446\u0435\u0441\u044f&raquo; (\u0411\u044b\u0446 1, 28). \u0414\u044b\u043a \u043f\u0430\u0431\u0430\u0447\u044b\u043c \u0436\u0430, \u0448\u0442\u043e \u045e\u0441\u0435 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u044f \u0431\u044b\u043b\u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u044b \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456 \u0456 \u0448\u0442\u043e \u0441\u0430\u043c \u041f\u0430\u043d \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0440\u0430\u0431\u0456\u045e \u0442\u0430\u043a. \u041c\u0430\u044e\u0447\u044b \u0442\u0430\u043a\u0456 \u045e\u0437\u043e\u0440, \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430 \u0456\u0441\u0446\u0456 \u0437\u0430 \u042f\u0433\u043e \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u044f\u0439 \u0456 \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u0443\u0447\u044b\u043d\u043a\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<br \/> <br \/><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0414\u0430\u043d 9, 4; \u0420\u044b\u043c 8, 28<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0411\u043e\u0433 \u0432\u044f\u043b\u0456\u043a\u0456 \u0456 \u0433\u0440\u043e\u0437\u043d\u044b, \u0401\u043d \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u042f\u0433\u043e\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u0451 \u0441\u0430\u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0431\u0440\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u042f\u0433\u043e\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"21","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0434\u0430 \u042d\u0444\u0435\u0441\u0446\u0430\u045e \u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 2, 2 &ndash; 5, 2: Funk 1, 175-177)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0423 \u0433\u0430\u0440\u043c\u0430\u043d\u0456\u0447\u043d\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u045e\u0441\u044f\u043b\u044f\u043a \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u0432\u0430\u0441, \u043a\u0430\u0431 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u044f \u045e \u0430\u0434\u0437\u0456\u043d\u0430\u0439 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0456\u0441\u043a\u0443\u043f\u0443 \u0456 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0443, \u0432\u044b \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0456 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0432\u0430 \u045e\u0441\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043f\u0430\u0432\u0443\u0447\u0430\u044e \u0432\u0430\u0441 \u044f\u043a \u043d\u0435\u0445\u0442\u0430 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b, \u0431\u043e \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u044f \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b \u0434\u0437\u0435\u043b\u044f \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0433\u044d\u0442\u0430 \u043d\u0435 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u045e\u0436\u043e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0446\u044f\u043f\u0435\u0440 \u044f \u043f\u0430\u0447\u044b\u043d\u0430\u044e \u0431\u044b\u0446\u044c \u042f\u0433\u043e \u0432\u0443\u0447\u043d\u0435\u043c \u0456 \u043c\u0430\u0433\u0443 \u0437\u0432\u044f\u0440\u0442\u0430\u0446\u0446\u0430 \u0434\u0430 \u0432\u0430\u0441 \u044f\u043a \u0434\u0430 \u0442\u0430\u043a\u0456\u0445 \u0436\u0430 \u0432\u0443\u0447\u043d\u044f\u045e. \u041c\u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u043b\u0456 \u043c\u044f\u043d\u0435 \u0432\u0435\u0440\u0430\u0439, \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u0435\u043c, \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044e. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043b\u044e\u0431\u043e\u045e \u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u043c\u043d\u0435 \u043c\u0430\u045e\u0447\u0430\u0446\u044c \u043d\u0430\u043a\u043e\u043d\u0442 \u0432\u0430\u0441, \u044f \u0437\u0430\u0433\u0430\u0434\u0437\u044f \u043f\u0430\u0432\u0443\u0447\u0430\u044e \u0432\u0430\u0441, \u043a\u0430\u0431 \u0432\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u0437\u0456\u043d\u0430\u0434\u0443\u0448\u043d\u044b\u043c\u0456 \u045e \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0456 \u0432\u043e\u043b\u0456 \u0411\u043e\u0436\u0430\u0439. \u042f\u043a \u0432\u043e\u043b\u044e \u0410\u0439\u0446\u0430 \u0432\u044b\u044f\u045e\u043b\u044f\u0435 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043d\u0435\u0430\u0434\u043b\u0443\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u043d\u0430\u0448\u0430, \u0442\u0430\u043a \u0431\u0456\u0441\u043a\u0443\u043f\u044b, \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u044f \u043d\u0430 \u0434\u0430\u0440\u043e\u0433\u0430\u0445 \u0436\u044b\u0446\u0446\u044f, \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u0432\u043e\u043b\u044e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0432\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c, \u0448\u0442\u043e \u0432\u044b \u0456 \u0440\u043e\u0431\u0456\u0446\u0435. \u0411\u043e \u0432\u0430\u0448\u0430 \u0441\u043b\u0430\u045e\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u0433\u043e\u0434\u043d\u0430\u0435 \u0411\u043e\u0433\u0430, \u0442\u0430\u043a \u0437\u043b\u0443\u0447\u0430\u043d\u0430 \u0437 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c, \u044f\u043a \u0441\u0442\u0440\u0443\u043d\u044b \u0446\u044b\u0442\u0440\u044b. \u0422\u0430\u043c\u0443 \u045e \u0432\u0430\u0448\u0430\u0439 \u0437\u0433\u043e\u0434\u043d\u0430\u0439 \u0456 \u0433\u0430\u0440\u043c\u0430\u043d\u0456\u0447\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0441\u043f\u044f\u0432\u0430\u0435 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0412\u044b \u0436 \u0441\u0430\u043c\u0456 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043f\u0430\u0430\u0441\u043e\u0431\u043d\u044b\u043c\u0456 \u0441\u0442\u0440\u0443\u043d\u0430\u043c\u0456, \u043a\u0430\u0431 \u0443 \u0441\u0443\u0433\u0443\u0447\u043d\u0430\u0439 \u0437\u0433\u043e\u0434\u0437\u0435 \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430 \u043f\u0430\u0447\u044b\u043d\u0430\u043b\u0456 \u0441\u043f\u0435\u045e \u0411\u043e\u0436\u044b \u0456 \u0430\u0434\u043d\u0430\u0433\u0430\u043b\u043e\u0441\u043d\u0430 \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u0410\u0439\u0446\u0443 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0410 \u0401\u043d \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0435 \u0432\u0430\u0441 \u0456 \u043f\u0430\u0437\u043d\u0430\u0435 \u043f\u0430 \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u0445 \u0432\u0430\u0448\u044b\u0445, \u0448\u0442\u043e \u0432\u044b \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u0435 \u0434\u0430 \u0421\u044b\u043d\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u043a\u0430\u0440\u044b\u0441\u043d\u0430 \u0432\u0430\u043c \u0431\u044b\u0446\u044c \u0443 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u0435\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u0411\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f \u0437\u0430 \u0442\u0430\u043a\u0456 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u043f\u0440\u0430\u043c\u0435\u0436\u0430\u043a \u0447\u0430\u0441\u0443 \u043d\u0430\u043b\u0430\u0434\u0437\u0456\u045e \u0442\u0430\u043a\u043e\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435, \u0430 \u043d\u0435 \u0437\u044f\u043c\u043d\u043e\u0435 \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430 \u0437 \u0432\u0430\u0448\u044b\u043c \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c, \u0434\u044b\u043a \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0435\u0439\u0448\u044b\u044f \u0432\u044b, \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u0442\u0430\u043a, \u044f\u043a \u041a\u0430\u0441\u0446\u0451\u043b \u0437 \u0415\u0437\u0443\u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0456 \u044f\u043a \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437 \u0410\u0439\u0446\u043e\u043c \u0443 \u0433\u0430\u0440\u043c\u0430\u043d\u0456\u0447\u043d\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0432\u0430\u0435 \u0441\u044f\u0431\u0435: \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0430\u043b\u0442\u0430\u0440\u0430, \u0451\u043d \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0445\u043b\u0435\u0431\u0430. \u041a\u0430\u043b\u0456 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0434\u0432\u0443\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u043c\u0430\u0435 \u0442\u0430\u043a\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043c\u043e\u0446, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u045e\u0441\u044f\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430?<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042d\u0444 4, 1. 3-4<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u043b\u044e \u0432\u0430\u0441 \u044f, \u0432\u044f\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f, \u044f\u043a\u0456\u043c \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0420\u0443\u043f\u043b\u0456\u0432\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0434\u043d\u043e \u0446\u0435\u043b\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445, \u044f\u043a \u0456 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u045e \u0430\u0434\u043d\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0443\u043f\u043b\u0456\u0432\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e.<\/p>\r\n"}, {"GCH_CH_2_ID":"22","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0434\u0430 \u042d\u0444\u0435\u0441\u0446\u0430\u045e \u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 13 &ndash; 18, 1: Funk 1, 183-187)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u0430\u0439\u0446\u0435 \u0432\u0435\u0440\u0443 \u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043b\u044e\u0431\u043e\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u0447\u0430\u0441\u0446\u0435\u0439 \u0437\u0431\u0456\u0440\u0430\u0446\u0446\u0430 \u0434\u043b\u044f \u043f\u0430\u0434\u0437\u044f\u043a\u0456 \u041f\u0430\u043d\u0443 \u0456 \u042f\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0411\u043e \u043a\u0430\u043b\u0456 \u0432\u044b \u0447\u0430\u0441\u0442\u0430 \u0437\u0431\u0456\u0440\u0430\u0435\u0446\u0435\u0441\u044f \u045e \u0430\u0434\u043d\u044b\u043c \u0456 \u0442\u044b\u043c \u0436\u0430 \u043c\u0435\u0441\u0446\u044b, \u0441\u043b\u0430\u0431\u0435\u0435 \u043c\u043e\u0446 \u0441\u0430\u0442\u0430\u043d\u044b, \u0430 \u0432\u0430\u0448\u0430 \u0437\u0433\u043e\u0434\u043d\u0430\u044f \u0432\u0435\u0440\u0430 \u0430\u0431\u044f\u0441\u0448\u043a\u043e\u0434\u0436\u0432\u0430\u0435 \u0437\u0433\u0443\u0431\u0443, \u044f\u043a\u0443\u044e \u0451\u043d \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c. \u041d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0433\u0430 \u0437\u0430 \u0441\u043f\u0430\u043a\u043e\u0439, \u044f\u043a\u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0434\u0430\u0440\u044d\u043c\u043d\u0430\u0439 \u0443\u0441\u044f\u043a\u0443\u044e \u0432\u0430\u0440\u043e\u0436\u0430\u0441\u0446\u044c \u0437\u044f\u043c\u043d\u044b\u0445 \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u044f\u0433\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u0446\u0435, \u043a\u0430\u043b\u0456 \u045e \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f \u0432\u0435\u0440\u0430 \u0456 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u043e \u044f\u043d\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u043d\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u044f\u0433\u043e \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0439 \u043c\u044d\u0442\u0430\u0439: \u0432\u0435\u0440\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0430\u0447\u0430\u0442\u0430\u043a, \u0430 \u043b\u044e\u0431\u043e\u045e &ndash; \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u044f \u043c\u044d\u0442\u0430. \u0421\u043f\u0430\u043b\u0443\u0447\u044d\u043d\u043d\u0435\u043c \u0430\u0431\u0435\u0434\u0437\u0432\u044e\u0445 \u0451\u0441\u0446\u044c \u0441\u0430\u043c \u0411\u043e\u0433, \u0430 \u045e\u0441\u0435 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f \u0446\u043d\u043e\u0442\u044b \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0437 \u0433\u044d\u0442\u044b\u0445 \u0434\u0437\u0432\u044e\u0445. \u0425\u0442\u043e \u0432\u044b\u0437\u043d\u0430\u0435 \u0432\u0435\u0440\u0443, \u043d\u0435 \u043f\u0430\u043c\u044b\u043b\u044f\u0435\u0446\u0446\u0430, \u0430 \u0445\u0442\u043e \u0432\u044b\u0437\u043d\u0430\u0435 \u043b\u044e\u0431\u043e\u045e, \u043d\u0435 \u043c\u0430\u0435 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u0456. \u0414\u0440\u044d\u0432\u0430 \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0446\u0430 \u043f\u0430 \u043f\u043b\u0430\u0434\u0430\u0445 (\u043f\u0430\u0440. \u041c\u0446 12, 33), \u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430, \u043c\u043e\u0436\u043d\u0430 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043f\u0430 \u043b\u0430\u0434\u0437\u0435 \u0436\u044b\u0446\u0446\u044f. \u0411\u043e \u0446\u044f\u043f\u0435\u0440 \u0442\u0440\u044d\u0431\u0430 \u043d\u0435 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c, \u0430\u043b\u0435 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0446\u043d\u043e\u0442\u044b \u0432\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u0435\u043f\u0435\u0439 \u043c\u0430\u045e\u0447\u0430\u0446\u044c \u0456 \u0431\u044b\u0446\u044c, \u0447\u044b\u043c \u043a\u0430\u0437\u0430\u0446\u044c \u0456 \u043d\u0435 \u0431\u044b\u0446\u044c. \u041d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435 \u0434\u043e\u0431\u0440\u0430\u0435 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u043e\u0435, \u0447\u0430\u043c\u0443 \u0432\u0443\u0447\u0430\u0446\u044c. \u0422\u0430\u043c\u0443 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u0437\u0456\u043d \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a, \u0442\u043e\u0439, \u044f\u043a\u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0456 \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0443 \u0446\u0456\u0448\u044b, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0430\u0440\u0442\u0430\u0435 \u0410\u0439\u0446\u0430. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u0441\u043b\u043e\u0432\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u043e\u0439 \u0437\u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0456 \u042f\u0433\u043e \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435 \u0456 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0441\u0442\u0430\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c: \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u0430\u043c \u0456 \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0443 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0456. \u041d\u0456\u0448\u0442\u043e \u043d\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0430\u0434 \u041f\u0430\u043d\u0430, \u0456 \u045e\u0441\u0435 \u043d\u0430\u0448\u044b \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0432\u044f\u0434\u043e\u043c\u044b \u042f\u043c\u0443. \u0411\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0443\u0441\u0451 \u0442\u0430\u043a, \u0431\u044b\u0446\u0446\u0430\u043c \u0401\u043d \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439, \u0430 \u0401\u043d \u043a\u0430\u0431 \u0441\u0442\u0430\u045e \u043d\u0430\u0448\u044b\u043c \u0411\u043e\u0433\u0430\u043c \u0443 \u043d\u0430\u0441. \u0401\u043d \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0456\u043c \u043d\u0430\u0441\u0430\u043c\u0440\u044d\u0447 \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u043d\u0430\u043c, \u043a\u0430\u043b\u0456 \u043c\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u042f\u0433\u043e \u043b\u044e\u0431\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0439\u0446\u0435\u0441\u044f, \u0431\u0440\u0430\u0442\u044b \u043c\u0430\u0435. \u0422\u044b\u044f, \u0445\u0442\u043e \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u0435 \u0441\u0435\u043c&rsquo;\u0456, \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 6, 9-10). \u041a\u0430\u043b\u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430\u043a \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u0443\u0436\u043e \u0431\u044b\u043b\u0456 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b\u044f \u0441\u043c\u0435\u0440\u0446\u044e, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043a\u0430\u0436\u043e\u043d\u044b\u043c \u0432\u0443\u0447\u044d\u043d\u043d\u0435\u043c \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u045e \u0431\u044b \u0432\u0435\u0440\u0443 \u045e \u0411\u043e\u0433\u0430, \u0437\u0430 \u044f\u043a\u0443\u044e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0431\u044b\u045e \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b. \u0422\u043e\u0439, \u043a\u0430\u0433\u043e \u0431 \u0437\u0430\u043f\u043b\u044f\u043c\u0456\u045e \u0442\u0430\u043a\u0456 \u045e\u0447\u044b\u043d\u0430\u043a, \u043f\u043e\u0439\u0434\u0437\u0435 \u045e \u043d\u0435\u043f\u0430\u0433\u0430\u0441\u043d\u044b \u0430\u0433\u043e\u043d\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0442\u044b\u043c, \u0445\u0442\u043e \u044f\u0433\u043e \u0441\u043b\u0443\u0445\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u0433\u0430\u043b\u0430\u0432\u0443, \u043a\u0430\u0431 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u044e. \u041d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0439\u0446\u0435 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0431\u0440\u044b\u0434\u043a\u0456\u043c \u0432\u0443\u0447\u044d\u043d\u043d\u0435\u043c \u043a\u043d\u044f\u0437\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u043a\u0430\u0431 \u043d\u0435 \u0441\u0445\u0430\u043f\u0456\u045e \u0432\u0430\u0441 \u0443 \u043f\u0430\u043b\u043e\u043d \u0437\u0430\u043c\u0435\u0441\u0442 \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0427\u0430\u043c\u0443 \u043c\u044b \u045e\u0441\u0435 \u043d\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u043c\u0441\u044f \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c\u0456, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441? \u0427\u0430\u043c\u0443 \u0431\u0435\u0437\u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430 \u0433\u0456\u043d\u0435\u043c, \u043d\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u044e\u0447\u044b \u0434\u0430\u0440\u0443, \u044f\u043a\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430\u043c \u041f\u0430\u043d?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u043e\u0439 \u0434\u0443\u0445 \u0441\u0445\u0456\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0437\u0435\u043b\u044f \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0434\u0430 \u043a\u0440\u044b\u0436\u0430, \u044f\u043a\u0456 \u0434\u043b\u044f \u043d\u044f\u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445 &ndash; \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u0433\u0440\u0430\u0445\u0443, \u0430 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 &ndash; \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 3, 17; 1 \u041a\u0430\u0440 10, 31<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0451, \u0448\u0442\u043e \u0432\u044b \u0440\u043e\u0431\u0456\u0446\u0435 \u0441\u043b\u043e\u0432\u0430\u043c \u0446\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c,<span style=\"color: #ff0000;\"> *<\/span> \u0440\u0430\u0431\u0456\u0446\u0435 \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u0451 \u0440\u0430\u0431\u0456\u0446\u0435 \u043d\u0430 \u0445\u0432\u0430\u043b\u0443 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u0431\u0456\u0446\u0435 \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"23","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e \u0441\u0432. \u041a\u043b\u0456\u043c\u044d\u043d\u0442\u0430 \u0406, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 49-50: Funk 1, 123-125)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0425\u0442\u043e \u0437\u043c\u043e\u0436\u0430 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u043f\u043e\u0432\u044f\u0437\u044c \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456?<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043c\u0430\u0435 \u043b\u044e\u0431\u043e\u045e \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u043d\u044f\u0445\u0430\u0439 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u043d\u0430\u043a\u0430\u0437\u044b \u0425\u0440\u044b\u0441\u0442\u0430. \u0425\u0442\u043e \u0437\u043c\u043e\u0436\u0430 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u043f\u043e\u0432\u044f\u0437\u044c \u043b\u044e\u0431\u043e\u0432\u0456 \u0411\u043e\u0436\u0430\u0439? \u0425\u0442\u043e \u0437\u0434\u043e\u043b\u0435\u0435 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0432\u0435\u043b\u0456\u0447 \u043a\u0440\u0430\u0441\u044b \u042f\u0433\u043e\u043d\u0430\u0439? \u0412\u044b\u0448\u044b\u043d\u044f, \u043d\u0430 \u044f\u043a\u0443\u044e \u045e\u0437\u043d\u044f\u043b\u0430\u0441\u044f \u043b\u044e\u0431\u043e\u045e, \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u044f. \u041b\u044e\u0431\u043e\u045e \u0437\u043b\u0443\u0447\u0430\u0435 \u043d\u0430\u0441 \u0437 \u0411\u043e\u0433\u0430\u043c, &laquo;\u043b\u044e\u0431\u043e\u045e \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0433\u0440\u0430\u0445\u043e\u045e&raquo; (1 \u041f 4, 8). \u041b\u044e\u0431\u043e\u045e \u0443\u0441\u0451 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435, \u0443\u0441\u0451 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0437\u043d\u043e\u0441\u0456\u0446\u044c; \u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u0440\u0443\u0434\u043d\u0430\u0433\u0430, \u043d\u0456\u0447\u043e\u0433\u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u0430\u0433\u0430; \u043b\u044e\u0431\u043e\u045e \u043d\u0435 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u0437\u0432\u0430\u0434\u0430\u045e \u0456 \u043d\u0435 \u045e\u0441\u0447\u044b\u043d\u0430\u0435 \u0431\u0443\u043d\u0442\u0443, \u043b\u044e\u0431\u043e\u045e \u0443\u0441\u0451 \u0440\u043e\u0431\u0456\u0446\u044c \u0443 \u0437\u0433\u043e\u0434\u0437\u0435; \u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u045e\u0441\u0435 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u044f \u0411\u043e\u0436\u044b\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u044f, \u0431\u0435\u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u0456\u0448\u0442\u043e \u043d\u0435 \u043c\u0456\u043b\u0430\u0435 \u0411\u043e\u0433\u0443. \u0417 \u043b\u044e\u0431\u043e\u0432\u0456 \u0411\u043e\u0433 \u0443\u0437\u044f\u045e \u043d\u0430\u0441 \u0434\u0430 \u0441\u044f\u0431\u0435. \u0417 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u043d\u0430\u0441 \u041f\u0430\u043d \u043d\u0430\u0448 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u044f\u0439 \u0430\u0434\u0434\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e, \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u0437\u0430 \u043d\u0430\u0448\u0430 \u0446\u0435\u043b\u0430, \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443 \u0437\u0430 \u043d\u0430\u0448\u044b \u0434\u0443\u0448\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0439 \u0446\u043d\u043e\u0442\u0430\u0439 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a \u0446\u044f\u0436\u043a\u0430 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u044f\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c. \u0417\u0440\u0430\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u0437\u0434\u0430\u0442\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u0411\u043e\u0433 \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u0433\u043e\u0434\u043d\u044b\u043c. \u0422\u0430\u043c\u0443 \u043f\u0430\u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0456 \u043f\u0430\u043f\u0440\u043e\u0441\u0456\u043c \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u043c\u044b \u0442\u0440\u044b\u043c\u0430\u043b\u0456\u0441\u044f \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0431\u044b\u043b\u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u044f \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043b\u044e\u0434\u0441\u043a\u043e\u0439 \u0437\u0430\u0433\u0430\u043d\u044b \u0446\u0456 \u043f\u0440\u0430\u0432\u0456\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456, \u043f\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b \u0437 \u0410\u0434\u0430\u043c\u0430 \u0430\u0436 \u0434\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0434\u043d\u044f, \u043f\u0440\u0430\u043c\u0456\u043d\u0443\u043b\u0456; \u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0437 \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439 \u0437\u0434\u0430\u0431\u044b\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u0437\u0430\u043d\u044f\u043b\u0456 \u043c\u0435\u0441\u0446\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u0430\u0431&rsquo;\u044f\u0432\u044f\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0411\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0423\u0432\u0430\u0439\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u045e \u0441\u0432\u0430\u0435 \u043f\u0430\u043a\u043e\u0456, \u043f\u0430\u043a\u0443\u043b\u044c \u0433\u043d\u0435\u045e \u0456 \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u0435 \u041c\u0430\u0435 \u043d\u0435 \u043f\u0440\u0430\u043c\u0456\u043d\u0443\u0446\u044c; \u0456 \u0437\u0433\u0430\u0434\u0430\u044e \u0434\u043e\u0431\u0440\u044b\u044f \u0434\u043d\u0456, \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u0443 \u0432\u0430\u0441 \u0437 \u043c\u0430\u0433\u0456\u043b \u0432\u0430\u0448\u044b\u0445&raquo; (\u043f\u0430\u0440. \u0406\u0441 26, 20; \u042d\u0437\u0445 37, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043c\u044b, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u043d\u0430\u043a\u0430\u0437\u044b \u041f\u0430\u043d\u0430 \u045e \u0437\u0433\u043e\u0434\u0437\u0435 \u043b\u044e\u0431\u043e\u0432\u0456, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e \u043d\u0430\u043c \u0431\u044b\u043b\u0456 \u0430\u0434\u043f\u0443\u0448\u0447\u0430\u043d\u044b \u0433\u0440\u0430\u0445\u0456. \u0411\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f, \u043a\u0430\u043c\u0443 \u0430\u0434\u043f\u0443\u0448\u0447\u0430\u043d\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0447\u044b\u0435 \u0433\u0440\u0430\u0445\u0456 \u0441\u0446\u0451\u0440\u0442\u044b. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u043e\u043c\u0443 \u041f\u0430\u043d \u043d\u0435 \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u0433\u0440\u044d\u0445 \u0456 \u045e \u0432\u0443\u0441\u043d\u0430\u0445 \u044f\u043a\u043e\u0433\u0430 \u043d\u044f\u043c\u0430 \u043f\u0430\u0434\u043c\u0430\u043d\u0443 (\u043f\u0430\u0440. \u041f\u0441 33 [32], 1). \u0414\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0411\u043e\u0433 \u0432\u044b\u0431\u0440\u0430\u045e \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u043e\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 4, 16. 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0443\u044e \u043c\u0430\u0435 \u0434\u0430 \u043d\u0430\u0441 \u0411\u043e\u0433 <span style=\"color: #ff0000;\">*<\/span> \u0425\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u045e \u0411\u043e\u0433\u0443, \u0456 \u0411\u043e\u0433 \u0443 \u0456\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0443\u0434\u0437\u0435\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u0431\u043e \u043b\u044e\u0431\u043e\u045e \u0430\u0434 \u0411\u043e\u0433\u0430<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u045e \u0411\u043e\u0433\u0443, \u0456 \u0411\u043e\u0433 \u0443 \u0456\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"24","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0430\u0433\u043c\u0430\u0442\u044b\u0447\u043d\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b <br \/>&laquo;Lumen gentium&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 2. 16)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u043e\u0441\u044c \u042f \u0437\u0431\u0430\u045e\u043b\u044e \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0439 \u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0447\u0430\u0439 \u0437\u0430\u0434\u0443\u043c\u044b \u0441\u0432\u0430\u0451\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442, \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0443\u0437\u043d\u044f\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0434\u0430 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u0411\u043e\u0436\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0456\u0445 \u043f\u0430\u0441\u043b\u044f \u0433\u0440\u044d\u0445\u0430\u043f\u0430\u0434\u0437\u0435\u043d\u043d\u044f \u045e \u0410\u0434\u0430\u043c\u0435, \u0430\u043b\u0435 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0434\u0430\u0432\u0430\u045e \u0456\u043c \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0434\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f, \u044f\u043a\u0456 &laquo;\u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f&raquo; (\u041a\u043b\u0441 1, 15). \u0423\u0441\u0456\u0445 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0410\u0439\u0446\u0435\u0446 \u043f\u0435\u0440\u0430\u0434 \u0432\u044f\u043a\u0430\u043c\u0456 &laquo;\u043d\u0430\u043f\u0435\u0440\u0430\u0434 \u043f\u0430\u0437\u043d\u0430\u045e \u0456 \u043f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0431\u044b\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u043a\u0430\u0431 \u0401\u043d \u0431\u044b\u045e \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u043c\u0456\u0436 \u043c\u043d\u043e\u0433\u0456\u043c\u0456 \u0431\u0440\u0430\u0442\u0430\u043c\u0456&raquo; (\u0420\u044b\u043c 8, 29). \u0412\u0435\u0440\u0443\u044e\u0447\u044b\u0445 \u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0401\u043d \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u044f\u043a\u0456 \u045e\u0436\u043e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0432\u0435\u0442\u0443 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u044b \u045e \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u0445, \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b \u045e \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0456 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u045e \u0421\u0442\u0430\u0440\u044b\u043c \u0417\u0430\u043f\u0430\u0432\u0435\u0446\u0435, \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u045e \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0447\u0430\u0441\u044b, \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u044b \u043f\u0440\u0430\u0437 \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u0441\u043b\u0430\u045e\u043d\u0430 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u045e \u043a\u0430\u043d\u0446\u044b \u0432\u044f\u043a\u043e\u045e. \u0412\u043e\u0441\u044c \u0442\u0430\u0434\u044b, \u044f\u043a \u0447\u044b\u0442\u0430\u0435\u043c \u0443 \u0441\u0432\u044f\u0442\u044b\u0445 \u0430\u0439\u0446\u043e\u045e, \u0443\u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f, \u043f\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b \u0437 \u0410\u0434\u0430\u043c\u0430, &laquo;\u0430\u0434 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0410\u0431\u044d\u043b\u044f \u0430\u0436 \u0434\u0430 \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430 \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0433\u0430&raquo; \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0430\u0431\u0440\u0430\u043d\u044b\u044f \u0410\u0439\u0446\u043e\u043c \u0443 \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435 \u0442\u044b\u044f, \u0445\u0442\u043e \u044f\u0448\u0447\u044d \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u043f\u0430-\u0440\u043e\u0437\u043d\u0430\u043c\u0443 \u0437\u0432\u044f\u0437\u0430\u043d\u044b \u0437 \u0411\u043e\u0436\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u0423 \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443 \u0433\u044d\u0442\u0430 \u0442\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u043f\u0435\u0440\u0448\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0456 \u0437 \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0425\u0440\u044b\u0441\u0442\u0443\u0441 (\u043f\u0430\u0440. \u0420\u044b\u043c 9, 4-5), \u043d\u0430\u0440\u043e\u0434, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u0434\u0437\u0435\u043b\u044f \u0430\u0439\u0446\u043e\u045e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044f, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u043d\u0435 \u0448\u043a\u0430\u0434\u0443\u0435 \u0430\u0431 \u0434\u0430\u0440\u0430\u0445 \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0456 (\u043f\u0430\u0440. \u0420\u044b\u043c 11, 28-29). \u0410\u043b\u0435 \u043f\u043b\u0430\u043d \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f, \u0456 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u0443 \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443 \u043c\u0443\u0441\u0443\u043b\u044c\u043c\u0430\u043d, \u044f\u043a\u0456\u044f, \u0432\u044b\u0437\u043d\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u044e \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0432\u0435\u0440\u044b \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u044e\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u043c\u0456 \u0430\u0434\u0437\u0456\u043d\u0430\u043c\u0443 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0443 \u0430\u043f\u043e\u0448\u043d\u0456 \u0434\u0437\u0435\u043d\u044c. \u041d\u0435\u0434\u0430\u043b\u0451\u043a\u0430 \u0411\u043e\u0433 \u0456 \u0430\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u0448\u0443\u043a\u0430\u0435 \u043d\u0435\u0432\u044f\u0434\u043e\u043c\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430\u0432\u043e\u0431\u043c\u0430\u0446\u0430\u043a \u0456 \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u0445 \u0432\u044b\u044f\u0432\u0430\u045e, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u0443\u0441\u0456\u043c \u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0434\u044b\u0445\u0430\u043d\u043d\u0435 \u0456 \u045e\u0441\u0451 (\u043f\u0430\u0440. \u0414\u0437 17, 25-28), \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0417\u0431\u0430\u045e\u0446\u0430 \u0445\u0430\u0446\u0435\u045e, \u043a\u0430\u0431 \u0443\u0441\u0435 \u043b\u044e\u0434\u0437\u0456 \u0431\u044b\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b (\u043f\u0430\u0440. 1 \u0426\u0456\u043c 2, 4). \u0422\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043f\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u0456\u043d\u0435 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0430\u043b\u0435 \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0448\u0443\u043a\u0430\u0435 \u0411\u043e\u0433\u0430 \u0456 \u0441\u0442\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u043b\u0430\u0441\u043a\u0456 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u042f\u0433\u043e\u043d\u0443\u044e \u0432\u043e\u043b\u044e, \u043f\u0430\u0437\u043d\u0430\u043d\u0443\u044e \u043f\u0440\u0430\u0437 \u043d\u0430\u043a\u0430\u0437 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f, \u043c\u043e\u0433\u0443\u0446\u044c \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0411\u043e\u0436\u044b \u041f\u0440\u043e\u0432\u0456\u0434 \u043d\u0435 \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u0435 \u045e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0439 \u0434\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0435 \u043f\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u0456\u043d\u0435 \u043d\u0430\u043e\u0433\u0443\u043b \u044f\u0448\u0447\u044d \u043d\u0435 \u0434\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u0432\u044b\u0440\u0430\u0437\u043d\u0430\u0433\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 \u0441\u043f\u0440\u0430\u0431\u0443\u0435, \u043d\u0435 \u0431\u0435\u0437 \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439, \u0432\u0435\u0441\u0446\u0456 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u0423\u0441\u0451, \u0448\u0442\u043e \u045e \u0456\u0445 \u0451\u0441\u0446\u044c \u0437 \u0434\u0430\u0431\u0440\u0430 \u0456 \u043f\u0440\u0430\u045e\u0434\u044b, \u041a\u0430\u0441\u0446\u0451\u043b \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0430\u0435 \u044f\u043a \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0443\u044e \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u043e\u045e\u043a\u0443 \u0456 \u044f\u043a \u0434\u0430\u0440 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043a\u0430\u0431 \u0451\u043d \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430 \u0437\u0434\u0430\u0431\u044b\u045e \u0436\u044b\u0446\u0446\u0451. <br \/> <br \/><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042d\u0444 1, 9-10; \u041a\u043b\u0441 1, 19-20<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u0432\u044b\u0440\u0430\u0448\u044b\u045e, \u043a\u0430\u043b\u0456 \u043d\u0430\u0434\u044b\u0448\u043b\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0447\u0430\u0441\u0443, \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0443\u0441\u0451 \u045e \u0425\u0440\u044b\u0441\u0446\u0435: <span style=\"color: #ff0000;\">*<\/span> \u0422\u043e\u0435, \u0448\u0442\u043e \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u0445 \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0410\u0439\u0446\u0443, \u043a\u0430\u0431 \u0443 \u0406\u043c \u0436\u044b\u043b\u0430 \u045e\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0456 \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u0446\u044c \u0437 \u0441\u0430\u0431\u043e\u044e \u045e\u0441\u0451.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u043e\u0435, \u0448\u0442\u043e \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u0445 \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"25","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0424\u0443\u043b\u044c\u0433\u0435\u043d\u0442\u044b\u044f \u0420\u0443\u0441\u043f\u0435\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 14, 36-37: CCL 91, 429-431)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0436\u044b\u0432\u044b, \u043a\u0430\u0431 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span>\u041f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451 \u0442\u0440\u044d\u0431\u0430 \u0437\u0432\u044f\u0440\u043d\u0443\u0446\u044c \u0443\u0432\u0430\u0433\u0443 \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0437\u0430\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u043c\u044b \u043a\u0430\u0436\u0430\u043c: &laquo;\u041f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0421\u044b\u043d\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430&raquo;, \u0430\u043b\u0435 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0433\u0430\u0432\u043e\u0440\u044b\u043c: &laquo;\u041f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430&raquo;. \u0412\u0430 \u045e\u0441\u044f\u043a\u0456\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0435 \u0434\u0430\u0440\u043c\u0430 \u0446\u044d\u043b\u0435\u0431\u0440\u0443\u0435 \u0433\u044d\u0442\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0442\u043e\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u0443 \u044f\u043a\u043e\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0442\u0430\u045e \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u043c \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 (\u043f\u0430\u0440. 1 \u0426\u0456\u043c 2, 5), &laquo;\u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0430\u0432\u0435\u043a\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u0435\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430&raquo; (\u041f\u0441 111 [110], 4; \u043f\u0430\u0440. \u0413\u0431\u0440 7, 17). \u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0401\u043d \u0430\u0434\u043d\u043e\u0439\u0447\u044b \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u043d\u0435\u0440\u0443\u043a\u0430\u0442\u0432\u043e\u0440\u043d\u0443\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 (\u043f\u0430\u0440. \u0413\u0431\u0440 9, 24-25); \u0443\u0437\u044b\u0448\u043e\u045e \u0443 \u0441\u0430\u043c\u043e \u043d\u0435\u0431\u0430, \u0434\u0437\u0435 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0410\u0439\u0446\u0430 \u0456 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430\u0434 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u0436\u0430: &laquo;\u041f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0443 \u0445\u0432\u0430\u043b\u044b \u0411\u043e\u0433\u0443, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043f\u043b\u0451\u043d \u0432\u0443\u0441\u043d\u0430\u045e, \u044f\u043a\u0456\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0446\u044c \u0456\u043c\u0435\u043d\u0456 \u042f\u0433\u043e\u043d\u0430\u043c\u0443&raquo; (\u0413\u0431\u0440 13, 15). \u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u043c\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043c \u0430\u0445\u0432\u044f\u0440\u0443 \u0445\u0432\u0430\u043b\u044b \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u0431\u043e \u043f\u0440\u0430\u0437 \u042f\u0433\u043e\u043d\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c \u043c\u044b \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u043b\u0456\u0441\u044f \u0437 \u0411\u043e\u0433\u0430\u043c, \u0445\u043e\u0446\u044c \u0440\u0430\u043d\u0435\u0439 \u0431\u044b\u043b\u0456 \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456 \u042f\u043c\u0443. \u041f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u0456 \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0441\u0442\u0430\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441, \u0456 \u043d\u0430\u0448\u0430 \u0430\u0445\u0432\u044f\u0440\u0430 \u043c\u043e\u0436\u0430 \u0441\u0442\u0430\u0446\u044c \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0439 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0411\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u0441\u0432. \u041f\u0451\u0442\u0440 \u043f\u0430\u0432\u0443\u0447\u0430\u0435 \u043d\u0430\u0441, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0412\u044b \u0441\u0430\u043c\u0456, \u044f\u043a \u0436\u044b\u0432\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456, \u0431\u0443\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u0434\u043e\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b, \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u044f\u0442\u043e\u0435, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u044f \u0411\u043e\u0433\u0443, \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430&raquo; (1 \u041f 2, 5). \u0412\u043e\u0441\u044c \u0442\u0430\u043c\u0443 \u0456 \u043a\u0430\u0436\u0430\u043c \u043c\u044b \u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443: &laquo;\u041f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u0437\u0433\u0430\u0434\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u0430\u0440, \u0433\u044d\u0442\u0430 \u045e\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0435 \u043d\u0430 \u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u044f\u043a \u043d\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u041f\u0430\u043d\u0430, \u0443 \u044f\u043a\u043e\u0439 \u0411\u043e\u0436\u044b \u0421\u044b\u043d, &laquo;\u0431\u0443\u0434\u0443\u0447\u044b \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0411\u043e\u0433\u0430, \u0432\u044b\u0440\u0430\u043a\u0441\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456&raquo;. \u0423 \u0433\u044d\u0442\u0430\u0439 \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0401\u043d &laquo;\u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0430\u0436\u043d\u043e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456&raquo; (\u0424\u043b\u043f 2, 6-8), \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435, \u0441\u0442\u0430\u045e\u0448\u044b \u043c\u0430\u043b\u0430 \u043c\u0435\u043d\u0448\u044b\u043c \u0430\u0434 \u0430\u043d\u0451\u043b\u0430\u045e (\u043f\u0430\u0440. \u0413\u0431\u0440 2, 6-8), \u0437\u0430\u0441\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0440\u043e\u045e\u043d\u044b\u043c \u0410\u0439\u0446\u0443 \u045e \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456. \u0421\u044b\u043d \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435, \u0431\u0443\u0434\u0443\u0447\u044b \u0440\u043e\u045e\u043d\u044b\u043c \u0410\u0439\u0446\u0443, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u045e\u0441\u044f \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439. \u0401\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u044f\u0431\u0435 \u043c\u0435\u043d\u0448\u044b\u043c, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456. \u0417\u043c\u044f\u043d\u0448\u044d\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u0433\u044d\u0442\u0430 \u042f\u0433\u043e \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435; \u0430 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u044f\u043a \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u0435 \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0441\u043b\u0443\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0425\u0440\u044b\u0441\u0442\u0443, \u044f\u043a\u0456 \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0411\u043e\u0436\u0430\u0439, \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0443, \u043c\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043c \u0430\u0445\u0432\u044f\u0440\u0443 \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0410\u0439\u0446\u0443. \u041f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456, \u0401\u043d \u0441\u0442\u0430\u045e \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0436\u044b\u0432\u0443\u044e, \u043f\u0440\u044b\u0435\u043c\u043d\u0443\u044e \u0411\u043e\u0433\u0443 \u0430\u0445\u0432\u044f\u0440\u0443. \u0410\u0434\u043d\u0430\u043a \u043c\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0443, \u043a\u0430\u043b\u0456 \u0431 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0441\u0442\u0430\u045e \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441. \u0423 \u0406\u043c \u0441\u0430\u043c\u0430 \u043d\u0430\u0442\u0443\u0440\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0440\u043e\u0434\u0443 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0437\u0431\u0430\u045e\u0447\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u0430\u0439. \u041a\u0430\u043b\u0456 \u043c\u044b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u043c, \u0448\u0442\u043e \u043d\u0430\u0448\u044b \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u045e\u0437\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0421\u0432\u044f\u0442\u0430\u0440\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430, \u043c\u044b \u0432\u044b\u0437\u043d\u0430\u0435\u043c \u0443 \u0406\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0440\u043e\u0434\u0443, \u044f\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u041a\u043e\u0436\u043d\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b\u0431\u0456\u0440\u0430\u044e\u0446\u044c \u0437 \u043b\u044e\u0434\u0437\u0435\u0439, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439 \u0443 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0411\u043e\u0436\u044b\u0445, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0430\u0440\u044b \u0456 \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u0430\u0445\u0456&raquo; (\u0413\u0431\u0440 5, 1). \u041a\u0430\u043b\u0456 \u043c\u044b \u043a\u0430\u0436\u0430\u043c: &laquo;\u0421\u044b\u043d \u0422\u0432\u043e\u0439&raquo;, \u0456 \u0434\u0430\u0434\u0430\u0451\u043c: &laquo;\u044f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430&raquo;, \u043c\u044b \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435\u043c \u043f\u0440\u0430 \u0442\u0443\u044e \u0435\u0434\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u043f\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u043c\u0430\u044e\u0446\u044c \u0410\u0439\u0446\u0435\u0446, \u0456 \u0421\u044b\u043d, \u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b. \u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u0456\u0434\u0430\u0446\u044c, \u0448\u0442\u043e \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0456 \u0430\u0431\u0432\u044f\u0437\u0430\u043a, \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0431\u0440 4, 16. 15\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0431\u043b\u0456\u0437\u0456\u043c\u0441\u044f \u0437 \u0434\u0430\u0432\u0435\u0440\u0430\u043c \u0434\u0430 \u0442\u0440\u043e\u043d\u0430 \u043b\u0430\u0441\u043a\u0456, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u043b\u0430\u0441\u043a\u0443 \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0447\u0430\u0441\u043e\u0432\u0430\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e \u043c\u044b \u043c\u0430\u0435\u043c \u043d\u0435 \u0442\u0430\u043a\u043e\u0433\u0430 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u044f\u043a\u0456 \u043d\u0435 \u043c\u043e\u0433 \u0431\u044b \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u0446\u044c \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044f\u043c \u043d\u0430\u0448\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u043b\u0430\u0441\u043a\u0443 \u0434\u043b\u044f \u0441\u0432\u043e\u0435\u0447\u0430\u0441\u043e\u0432\u0430\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"26","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0417 \u0442\u0432\u043e\u0440\u0430 &laquo;\u0414\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c&raquo; \u0414\u044b\u044f\u0434\u043e\u0445\u0430 \u0424\u0430\u0442\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 12. 13. 14: PG 65, 1171-1172)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0422\u0440\u044d\u0431\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u044f\u0431\u0435, \u0442\u043e\u0439 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430. \u0410 \u0445\u0442\u043e \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0434\u0437\u0435\u043b\u044f \u0431\u043e\u043b\u044c\u0448 \u0432\u0430\u0436\u043d\u0430\u0433\u0430 \u0441\u043a\u0430\u0440\u0431\u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u045e \u0411\u043e\u0433\u0443, \u0442\u043e\u0439 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430. \u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435, \u0448\u0442\u043e \u0451\u043d \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0448\u0443\u043a\u0430\u0435 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b, \u0430 \u0445\u0443\u0442\u0447\u044d\u0439 \u0441\u043b\u0430\u0432\u044b \u0411\u043e\u0436\u0430\u0439. \u0411\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u044f\u0431\u0435, \u0448\u0443\u043a\u0430\u0435 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b, \u0430 \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u0442\u043e\u0439 \u0448\u0443\u043a\u0430\u0435 \u0441\u043b\u0430\u0432\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0443\u043b\u0430\u0439 \u0434\u0443\u0448\u044b, \u044f\u043a\u0430\u044f \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u0443\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u0437\u0430\u045e\u0436\u0434\u044b \u0448\u0443\u043a\u0430\u0446\u044c \u0441\u043b\u0430\u0432\u044b \u0411\u043e\u0436\u0430\u0439 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0434\u0430\u0440\u0443\u0447\u044d\u043d\u043d\u044f\u0445, \u044f\u043a\u0456\u044f \u0440\u043e\u0431\u0456\u0446\u044c, \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0441\u0432\u0430\u0439\u043c\u0443 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u043d\u044e \u042f\u0433\u043e \u0432\u043e\u043b\u0456. \u0411\u043e\u0433\u0443 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u044f\u0433\u043e \u0432\u0435\u043b\u0456\u0447\u044b \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0441\u043b\u0430\u0432\u0430, \u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 &ndash; \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u043d\u0435, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0435 \u043c\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u043c \u045e \u0431\u043b\u0456\u0437\u043a\u0430\u0435 \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c. \u041a\u0430\u043b\u0456 \u0456 \u043c\u044b, \u0443\u0441\u0446\u0435\u0448\u0430\u043d\u044b\u044f \u0441\u043b\u0430\u0432\u0430\u0439 \u041f\u0430\u043d\u0430, \u0431\u0443\u0434\u0437\u0435\u043c \u0433\u044d\u0442\u0430\u043a \u0440\u0430\u0431\u0456\u0446\u044c, \u0442\u0430\u0434\u044b \u043f\u0430\u0447\u043d\u0451\u043c \u0441\u043b\u0435\u0434\u0430\u043c \u0437\u0430 \u042f\u043d\u0430\u043c \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u0435\u043c \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u0446\u044c: &laquo;\u042f\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c, \u0430 \u043c\u043d\u0435 \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u0446\u0446\u0430 \u043c\u0435\u043d\u0448\u044b\u043c&raquo; (\u042f\u043d 3, 30).<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0432\u0435\u0434\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u043f\u0430\u043a\u0443\u0442\u0430\u0432\u0430\u045e, \u0448\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430 \u0442\u0430\u043a, \u044f\u043a \u0445\u0430\u0446\u0435\u045e \u0431\u044b. \u0410\u0434\u043d\u0430\u043a \u0451\u043d \u0442\u0430\u043a \u043b\u044e\u0431\u0456\u045e \u0411\u043e\u0433\u0430, \u0448\u0442\u043e \u044f\u0433\u043e \u0434\u0443\u0448\u0430 \u043f\u0430\u043b\u0430\u043b\u0430 \u043c\u043e\u0446\u043d\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0443 \u0456\u043c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u045e\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433, \u0430 \u0441\u0430\u043c \u0451\u043d \u0431\u044b\u045e \u044f\u043a \u0431\u044b \u043d\u0456\u0447\u044b\u043c. \u0410\u043b\u0435 \u0442\u0430\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u0435, \u043a\u0430\u043b\u0456 \u044f\u0433\u043e \u0445\u0432\u0430\u043b\u044f\u0446\u044c. \u0423 \u0441\u0432\u0430\u0456\u043c \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u043f\u0430\u043a\u043e\u0440\u044b \u0451\u043d \u0434\u0443\u043c\u0430\u0435 \u043d\u0435 \u043f\u0440\u0430 \u045e\u043b\u0430\u0441\u043d\u0443\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0431 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 \u0411\u043e\u0433\u0443, \u044f\u043a \u0437\u0430\u043a\u043e\u043d \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0432\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c. \u041f\u0440\u0430\u0437 \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430 \u0451\u043d \u0442\u0440\u044b\u043c\u0430\u0435 \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443 \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u0439 \u0443 \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0434\u0443\u043c\u0430\u0435 \u043f\u0440\u0430 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u0437 \u043f\u0430\u043a\u043e\u0440\u0430\u0439 \u043f\u0440\u044b\u0437\u043d\u0430\u045e\u0448\u044b \u0441\u044f\u0431\u0435 \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u044b\u043c \u0441\u043b\u0443\u0433\u043e\u044e. \u0414\u044b\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0456 \u043c\u044b \u0440\u0430\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430\u043a, \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u044e\u0447\u044b \u045e\u0441\u044f\u043a\u0430\u0433\u0430 \u0433\u043e\u043d\u0430\u0440\u0443 \u0456 \u0441\u043b\u0430\u0432\u044b \u0434\u0437\u0435\u043b\u044f \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u0433\u0430 \u0431\u0430\u0433\u0430\u0446\u0446\u044f \u043b\u044e\u0431\u043e\u0432\u0456 \u0411\u043e\u0436\u0430\u0439, \u044f\u043a\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430 \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u0442\u0430\u0433\u043e \u0432\u0435\u0434\u0430\u0435 \u0411\u043e\u0433. \u0427\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u0435\u0445\u0442\u0430 \u043f\u0440\u044b\u043c\u0430\u0435, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0451\u043d \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u043a\u0430\u043b\u0456 \u043a\u0430\u043c\u0443\u0441\u044c\u0446\u0456 \u045e\u0434\u0430\u043b\u043e\u0441\u044f \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456, \u0451\u043d \u0433\u043e\u0440\u0430\u0447\u0430 \u043f\u0440\u0430\u0433\u043d\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u043f\u0440\u0430\u0441\u0432\u044f\u0442\u043b\u0435\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e \u0441\u0430\u043c\u0443 \u0433\u043b\u044b\u0431. \u0422\u0430\u0434\u044b \u0451\u043d \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430 \u0441\u044f\u0431\u0435 \u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u0437\u043c\u044f\u043d\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0445\u043e\u0446\u044c \u0456 \u0436\u044b\u0432\u0435, \u0443 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u044f\u0433\u043e \u044f\u043a \u0431\u044b \u043d\u044f\u043c\u0430 \u045e \u0441\u0432\u0435\u0446\u0435. \u0425\u043e\u0446\u044c \u0451\u043d \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0446\u0435\u043b\u0435, \u044f\u0433\u043e \u0434\u0443\u0448\u0430 \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0432\u0430\u043d\u0434\u0440\u0443\u0435 \u0434\u0430 \u0411\u043e\u0433\u0430. \u042f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043f\u0430\u043b\u0430\u0435 \u0430\u0433\u043d\u0451\u043c \u043b\u044e\u0431\u043e\u0432\u0456, \u0451\u043d \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u0435\u0441\u043d\u0430 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b \u0437 \u0411\u043e\u0433\u0430\u043c, \u0448\u0442\u043e \u0446\u0430\u043b\u043a\u0430\u043c \u0456\u0433\u043d\u0430\u0440\u0443\u0435 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0456 \u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c: &laquo;\u041a\u0430\u043b\u0456 \u043c\u044b \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043c \u0437 \u0441\u044f\u0431\u0435, \u0442\u043e \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0433\u0430, \u0430 \u043a\u0430\u043b\u0456 \u045e \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u043c \u0440\u043e\u0437\u0443\u043c\u0435, \u0442\u043e \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441&raquo; (2 \u041a\u0430\u0440 5, 13).<br \/> <br \/><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 3, 16; 1 \u042f\u043d 4, 10\u0430. 19b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043a \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0411\u043e\u0433 \u0441\u0432\u0435\u0442, \u0448\u0442\u043e \u0430\u0434\u0434\u0430\u045e \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u045e, \u0430\u043b\u0435 \u043c\u0435\u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u0442\u044b\u043c \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043b\u044e\u0431\u043e\u045e, \u0448\u0442\u043e \u043d\u0435 \u043c\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u0411\u043e\u0433\u0430, \u0430 \u0401\u043d \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u045e, \u0430\u043b\u0435 \u043c\u0435\u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"27","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u044f\u045e&raquo; \u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 4, 18, 1-2. 4. 5: SC 100, 596-598. 606. 610-612)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0427\u044b\u0441\u0442\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0445\u0432\u044f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435, \u0443\u0441\u043f\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0430\u043c \u044f\u043a \u0447\u044b\u0441\u0442\u0430\u044f \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u044f \u042f\u043c\u0443 \u0430\u0445\u0432\u044f\u0440\u0430. \u0401\u043d \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u043d\u0430\u0441 \u0430\u0445\u0432\u044f\u0440\u044b, \u0430\u043b\u0435 \u043a\u0430\u043b\u0456 \u0434\u0430\u0440 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u043d\u044f\u0442\u044b, \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u0451\u0441 \u044f\u0433\u043e. \u041f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0434\u0430\u0440\u0443 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u0448\u0430\u043d\u0430 \u0456 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430. \u0416\u0430\u0434\u0430\u044e\u0447\u044b, \u043a\u0430\u0431 \u043c\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u0437 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u043e\u0439 \u0456 \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u044e \u0441\u044d\u0440\u0446\u0430, \u041f\u0430\u043d \u043d\u0430\u0432\u0443\u0447\u0430\u045e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: &laquo;\u041a\u0430\u043b\u0456 \u0442\u044b \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u0448 \u0434\u0430\u0440 \u0441\u0432\u043e\u0439 \u0434\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430 \u0456 \u045e\u0441\u043f\u043e\u043c\u043d\u0456\u0448 \u0442\u0430\u043c, \u0448\u0442\u043e \u0431\u0440\u0430\u0442 \u0442\u0432\u043e\u0439 \u043c\u0430\u0435 \u043d\u0435\u0448\u0442\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u043f\u0430\u043a\u0456\u043d\u044c \u0442\u0430\u043c \u0434\u0430\u0440 \u0441\u0432\u043e\u0439 \u043f\u0435\u0440\u0430\u0434 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430\u043c \u0456 \u0456\u0434\u0437\u0456 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0430\u043c\u0456\u0440\u044b\u0441\u044f \u0437 \u0431\u0440\u0430\u0442\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u0456 \u0442\u0430\u0434\u044b \u043f\u0440\u044b\u0439\u0434\u0437\u0456 \u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0456 \u0434\u0430\u0440 \u0441\u0432\u043e\u0439&raquo; (\u041c\u0446 5, 23). \u0422\u0430\u043a, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0411\u043e\u0433\u0443 \u043f\u0435\u0440\u0448\u044b \u043f\u043b\u0451\u043d \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u044f\u043a \u043a\u0430\u0436\u0430 \u041c\u0430\u0439\u0441\u0435\u0439: &laquo;\u041d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0439\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0437 \u043f\u0443\u0441\u0442\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456&raquo; (\u0421\u0456\u0440 35, 4). \u0406 \u0442\u0430\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e \u0430\u0434\u0434\u0430\u044e\u0447\u044b \u0411\u043e\u0433\u0443 \u0442\u043e\u0435, \u0447\u044b\u043c \u0431\u044b\u045e \u0430\u0434\u043e\u0440\u0430\u043d\u044b, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043f\u0430\u0448\u0430\u043d\u0443, \u044f\u043a\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u0430\u0445\u0432\u044f\u0440\u0430\u045e \u043d\u0435 \u0431\u044b\u043b\u043e \u0430\u0434\u043c\u0435\u043d\u0435\u043d\u0430: \u0430\u0445\u0432\u044f\u0440\u044b \u0431\u044b\u043b\u0456 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456, \u044f\u043d\u044b \u0451\u0441\u0446\u044c \u0456 \u0446\u044f\u043f\u0435\u0440. \u0411\u044b\u043b\u0456 \u045e \u043d\u0430\u0440\u043e\u0434\u0437\u0435 \u0411\u043e\u0436\u044b\u043c, \u0446\u044f\u043f\u0435\u0440 &ndash; \u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0435. \u0417\u043c\u044f\u043d\u0456\u043b\u0430\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0456\u0445 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c, \u0431\u043e \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u045e\u0436\u043e \u043d\u0435 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456, \u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c\u0456. \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0456 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b, \u0430\u0434\u043d\u0430\u043a \u0430\u0445\u0432\u044f\u0440\u044b \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u0445 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u044e\u0446\u0446\u0430, \u0442\u0430\u043c\u0443 \u0441\u0432\u0430\u0431\u043e\u0434\u0430 \u043c\u043e\u0436\u0430 \u043f\u0440\u0430\u044f\u0432\u0456\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0437 \u0430\u0445\u0432\u044f\u0440\u0430\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435. \u0423 \u041f\u0430\u043d\u0430 \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u043b\u0456\u0448\u043d\u044f\u0433\u0430, \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435\u0456\u0441\u0442\u043e\u0442\u043d\u0430\u0433\u0430 \u0456 \u043d\u0435\u0430\u0431\u0433\u0440\u0443\u043d\u0442\u0430\u0432\u0430\u043d\u0430\u0433\u0430. \u0406 \u0442\u0430\u043c\u0443 \u044f\u043d\u044b \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043b\u0456 \u041f\u0430\u043d\u0443 \u0441\u0432\u0430\u044e \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u043d\u0443, \u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0441\u0432\u0430\u0431\u043e\u0434\u0443, \u0430\u0434\u0434\u0430\u044e\u0446\u044c \u0443\u0441\u0451 \u043d\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u041f\u0430\u043d\u0443. \u042f\u043d\u044b \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u0430\u0434\u0434\u0430\u044e\u0446\u044c \u043d\u0435 \u043c\u0435\u043d\u0448\u0443\u044e \u0447\u0430\u0441\u0442\u043a\u0443, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043c\u0430\u044e\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u0431\u043e\u043b\u044c\u0448\u0430\u0435. \u042f\u043d\u044b \u0440\u043e\u0431\u044f\u0446\u044c, \u044f\u043a \u0442\u0430\u044f \u0431\u0435\u0434\u043d\u0430\u044f \u045e\u0434\u0430\u0432\u0430, \u0448\u0442\u043e \u043a\u0456\u043d\u0443\u043b\u0430 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u043e\u0439 \u043d\u0430\u0431\u044b\u0442\u0430\u043a \u0443 \u0441\u043a\u0430\u0440\u0431\u043e\u043d\u043a\u0443 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0411\u043e\u0433\u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u0431\u044b\u0446\u044c \u0443\u0434\u0437\u044f\u0447\u043d\u044b\u043c\u0456 \u0411\u043e\u0433\u0443 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044e, \u0430\u0445\u0432\u044f\u0440\u0443\u044e\u0447\u044b \u043f\u0435\u0440\u0448\u044b \u043f\u043b\u0451\u043d \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u0448\u0442\u043e \u042f\u043c\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c, \u0437 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435\u043c, \u0448\u0447\u044b\u0440\u0430\u0439 \u0432\u0435\u0440\u0430\u0439, \u0446\u0432\u0451\u0440\u0434\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0456 \u0433\u0430\u0440\u0430\u0447\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e. \u0422\u043e\u043b\u044c\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044e \u0447\u044b\u0441\u0442\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u0437 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u043c \u042f\u043c\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u042f\u043c\u0443, \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430 \u0432\u044b\u0437\u043d\u0430\u044e\u0447\u044b \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u0434\u0443\u0445\u0430 \u0456 \u0446\u0435\u043b\u0430. \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0437\u044f\u043c\u043d\u044b \u0445\u043b\u0435\u0431 \u043d\u0430 \u0437\u0430\u043a\u043b\u0456\u043a \u0411\u043e\u0433\u0430 \u045e\u0436\u043e \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u0445\u043b\u0435\u0431\u0430\u043c, \u0430\u043b\u0435 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044f\u0439, \u044f\u043a\u0430\u044f \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0437 \u0434\u0432\u0443\u0445 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430\u045e: \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430, \u0442\u0430\u043a \u0456 \u0446\u0435\u043b\u044b \u043d\u0430\u0448\u044b, \u043f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044e, \u0443\u0436\u043e \u043d\u0435 \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u044e\u0446\u044c \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044e, \u0430 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0431\u0440 10, 1. 14; \u042d\u0444 5, 2b<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u043a\u043e\u043d \u043c\u0430\u0435 \u0446\u0435\u043d\u044c \u0431\u0443\u0434\u0443\u0447\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u0430\u043b\u0435 \u043d\u0435 \u0441\u0430\u043c \u0432\u043e\u0431\u0440\u0430\u0437 \u0441\u043f\u0440\u0430\u0432\u0430\u045e. \u0422\u0430\u043c\u0443 \u0430\u0434\u043d\u044b \u0456 \u0442\u044b\u044f \u0436 \u0430\u0445\u0432\u044f\u0440\u044b, \u044f\u043a\u0456\u044f \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u0446\u0430, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0456\u043c\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0410 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u043d\u043e\u0439 \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043d\u0430\u0441 \u044f\u043a \u0434\u0430\u0440 \u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u0411\u043e\u0433\u0443 \u043d\u0430 \u043f\u0440\u044b\u0435\u043c\u043d\u044b \u043f\u0430\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u043d\u043e\u0439 \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u044c.<br \/><span style=\"text-align: left;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"31","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u0441\u0432\u044f\u0442\u0443\u044e \u041b\u0456\u0442\u0443\u0440\u0433\u0456\u044e <br \/>&laquo;Sacrosanctum Concilium&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 7-8, 106)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u044b \u045e \u0441\u0432\u0430\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0430\u045e\u0436\u0434\u044b \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u045e \u0441\u0432\u0430\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u045e \u043b\u0456\u0442\u0443\u0440\u0433\u0456\u0447\u043d\u044b\u0445 \u0434\u0437\u0435\u044f\u043d\u043d\u044f\u0445. \u0401\u043d \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u045e \u0430\u0445\u0432\u044f\u0440\u044b \u0441\u0432. \u0406\u043c\u0448\u044b \u0456 \u045e \u0430\u0441\u043e\u0431\u0435 \u0446\u044d\u043b\u0435\u0431\u0440\u0430\u043d\u0442\u0430, &laquo;\u0431\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0441\u044f\u0431\u0435 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b, \u0446\u044f\u043f\u0435\u0440 \u0430\u0445\u0432\u044f\u0440\u0443\u0435 \u0441\u044f\u0431\u0435 \u043f\u0440\u0430\u0437 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e&raquo;, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u045e \u044d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0447\u043d\u044b\u0445 \u043f\u043e\u0441\u0442\u0430\u0446\u044f\u0445. \u0421\u0432\u0430\u0451\u0439 \u0441\u0456\u043b\u0430\u0439 \u0401\u043d \u0442\u0430\u043a \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u0445, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u045e\u0434\u0437\u044f\u043b\u044f\u0435 \u0445\u0440\u043e\u0441\u0442, \u0442\u043e \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0401\u043d \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u043e\u0432\u0435, \u0431\u043e \u043a\u0430\u043b\u0456 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0447\u044b\u0442\u0430\u044e\u0446\u044c \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0401\u043d \u0441\u0430\u043c. \u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0456 \u0441\u043f\u044f\u0432\u0430\u0435 \u043f\u0441\u0430\u043b\u044c\u043c\u044b, \u0431\u043e \u0401\u043d \u0441\u0430\u043c \u0430\u0431\u044f\u0446\u0430\u045e: &laquo;\u0414\u0437\u0435 \u0434\u0432\u043e\u0435 \u0446\u0456 \u0442\u0440\u043e\u0435 \u0441\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f \u045e \u0456\u043c\u044f \u041c\u0430\u0451, \u0442\u0430\u043c \u042f \u0451\u0441\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0456\u0445&raquo; (\u041c\u0446 18, 20).<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0443 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u0411\u043e\u0433 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0430 \u043b\u044e\u0434\u0437\u0456 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u0430\u043b\u0443\u0447\u0430\u0435 \u0434\u0430 \u0441\u044f\u0431\u0435 \u041a\u0430\u0441\u0446\u0451\u043b, \u0441\u0432\u0430\u044e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0443\u044e \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0443, \u044f\u043a\u0430\u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u041f\u0430\u043d\u0430 \u0456 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0430\u0434\u0434\u0430\u0435 \u043a\u0443\u043b\u044c\u0442 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u043c\u0443 \u0410\u0439\u0446\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u041b\u0456\u0442\u0443\u0440\u0433\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043b\u0456\u0447\u044b\u0446\u0446\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0430\u0433\u0430 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0443 \u0425\u0440\u044b\u0441\u0442\u0430; \u0443 \u0451\u0439 \u043f\u0440\u0430\u0437 \u0431\u0430\u0447\u043d\u044b\u044f \u0437\u043d\u0430\u043a\u0456 \u0432\u044b\u0440\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u0456 \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u044b\u043c \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437\u043d\u0430\u043a\u0443 \u0441\u043f\u043e\u0441\u0430\u0431\u0430\u043c \u0430\u0436\u044b\u0446\u0446\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430 \u041c\u0456\u0441\u0442\u044b\u0447\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0433. \u0437\u043d. \u0413\u0430\u043b\u0430\u0432\u0430 \u0456 \u044f\u0435 \u0447\u043b\u0435\u043d\u044b, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0446\u044d\u043b\u0430\u0441\u043d\u044b \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u044b \u043a\u0443\u043b\u044c\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u045e\u0441\u044f\u043a\u0430\u044f \u043b\u0456\u0442\u0443\u0440\u0433\u0456\u0447\u043d\u0430\u044f \u0446\u044d\u043b\u0435\u0431\u0440\u0430\u0446\u044b\u044f \u044f\u043a \u0441\u043f\u0440\u0430\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0421\u0432\u044f\u0442\u0430\u0440\u0430 \u0456 \u042f\u0433\u043e \u0446\u0435\u043b\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b, &ndash; \u0433\u044d\u0442\u0430 \u043f\u0435\u0440\u0448\u0430\u0441\u043d\u0430\u0435 \u0441\u0430\u043a\u0440\u0430\u043b\u044c\u043d\u0430\u0435 \u0434\u0437\u0435\u044f\u043d\u043d\u0435, \u0437 \u043f\u043b\u0451\u043d\u043d\u0430\u0441\u0446\u044e \u044f\u043a\u043e\u0433\u0430 \u043f\u0430 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u0456 \u0432\u0430\u0440\u0442\u0430\u0441\u0446\u0456 \u043d\u0435 \u0437\u0440\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u043d\u0456\u044f\u043a\u0430\u0435 \u0456\u043d\u0448\u0430\u0435 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0437\u044f\u043c\u043d\u043e\u0439 \u041b\u0456\u0442\u0443\u0440\u0433\u0456\u0456 \u043c\u044b \u044f\u043a \u0431\u044b \u043f\u0440\u0430\u0434\u0447\u0443\u0432\u0430\u0435\u043c \u043d\u044f\u0431\u0435\u0441\u043d\u0443\u044e \u041b\u0456\u0442\u0443\u0440\u0433\u0456\u044e, \u044f\u043a\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0431\u044b\u0432\u0430\u0446\u0446\u0430 \u045e \u0441\u0432\u044f\u0442\u044b\u043c \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u043c\u0441\u044f \u044f\u043a \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u044b, \u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430 \u044f\u043a \u0441\u043b\u0443\u0433\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0441\u043a\u0456\u043d\u0456\u0456. \u0420\u0430\u0437\u0430\u043c \u0437 \u0443\u0441\u0456\u043c \u0432\u043e\u0439\u0441\u043a\u0430\u043c \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u043c\u043e\u0446\u044b \u043c\u044b \u0441\u043f\u044f\u0432\u0430\u0435\u043c \u0411\u043e\u0433\u0443 \u0433\u0456\u043c\u043d \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f; \u0437 \u043f\u0430\u0448\u0430\u043d\u0430\u0439 \u0437\u0433\u0430\u0434\u0432\u0430\u0435\u043c \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u043c\u0441\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043d\u0435\u0439\u043a\u0456 \u045e\u0434\u0437\u0435\u043b \u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0437 \u0456\u043c\u0456; \u0447\u0430\u043a\u0430\u0435\u043c \u0417\u0431\u0430\u045e\u0446\u0443, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0401\u043d \u043d\u0435 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u044f\u043a \u0436\u044b\u0446\u0446\u0451 \u043d\u0430\u0448\u0430 \u0456 \u043f\u0430\u043a\u0443\u043b\u044c \u043c\u044b \u043d\u0435 \u0437&rsquo;\u044f\u0432\u0456\u043c\u0441\u044f \u0437 \u0406\u043c \u0443 \u0441\u043b\u0430\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0433\u043e\u0434\u043d\u0430 \u0437 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0439 \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u044f\u0439, \u044f\u043a\u0430\u044f \u043f\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u0437 \u0441\u0430\u043c\u0430\u0433\u0430 \u0434\u043d\u044f \u0423\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u041a\u0430\u0441\u0446\u0451\u043b \u0446\u044d\u043b\u0435\u0431\u0440\u0443\u0435 \u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u043a\u043e\u0436\u043d\u044b \u0432\u043e\u0441\u044c\u043c\u044b \u0434\u0437\u0435\u043d\u044c, \u044f\u043a\u0456 \u0441\u043b\u0443\u0448\u043d\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0434\u043d\u0451\u043c \u041f\u0430\u043d\u0430, \u0430\u0431\u043e \u043d\u044f\u0434\u0437\u0435\u043b\u044f\u0439. \u0423 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0432\u0435\u0440\u043d\u0456\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0431\u0456\u0440\u0430\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c, \u043a\u0430\u0431 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0456 \u0456, \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u041c\u0443\u043a\u0443, \u0423\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0456 \u0441\u043b\u0430\u0432\u0443 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u0456\u0445 &laquo;\u0430\u0434\u0440\u0430\u0434\u0437\u0456\u045e \u0434\u0430 \u0436\u044b\u0432\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445&raquo; (1 \u041f 1, 3). \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043d\u044f\u0434\u0437\u0435\u043b\u044f &ndash; \u0433\u044d\u0442\u0430 \u043f\u0435\u0440\u0448\u0430\u0441\u043d\u044b \u0441\u0432\u044f\u0442\u043e\u0447\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u0456 \u044f\u0433\u043e \u0442\u0440\u044d\u0431\u0430 \u0442\u0430\u043a \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0432\u0430\u0446\u044c \u0456 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u0446\u044c \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e, \u043a\u0430\u0431 \u0451\u043d \u0441\u0442\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043d\u0451\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443 \u0430\u0434 \u043f\u0440\u0430\u0446\u044b. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u044f\u0434\u0437\u0435\u043b\u044f &ndash; \u0433\u044d\u0442\u0430 \u0430\u0441\u043d\u043e\u0432\u0430 \u0456 \u044f\u0434\u0440\u043e \u045e\u0441\u044f\u0433\u043e \u043b\u0456\u0442\u0443\u0440\u0433\u0456\u0447\u043d\u0430\u0433\u0430 \u0433\u043e\u0434\u0430, \u044f\u0435 \u043d\u0435\u043b\u044c\u0433\u0430 \u0437\u0430\u0441\u043b\u0430\u043d\u044f\u0446\u044c \u0456\u043d\u0448\u044b\u043c\u0456 \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u043d\u043d\u044f\u043c\u0456, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u0432\u0430\u0436\u043d\u0430\u0433\u0430 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d, \u041a\u0430\u043c. \u0434\u0430 \u041f\u0441 86 (85), 1<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441 \u044f\u043a \u043d\u0430\u0448 \u0421\u0432\u044f\u0442\u0430\u0440; \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441 \u044f\u043a \u043d\u0430\u0448\u0430 \u0413\u0430\u043b\u0430\u0432\u0430; \u0430 \u043c\u044b \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0434\u0430 \u042f\u0433\u043e \u044f\u043a \u0434\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0430\u043c\u0443 \u043f\u0440\u044b\u0437\u043d\u0430\u0435\u043c \u0443 \u0406\u043c \u0433\u0430\u043b\u0430\u0441\u044b \u043d\u0430\u0448\u044b, \u0430 \u045e \u043d\u0430\u0441 &ndash; \u042f\u0433\u043e\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u043c\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430 \u0437 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0430\u0434\u0434\u0437\u044f\u043b\u044f\u0446\u044c \u0430\u0434 \u044f\u0435 \u0421\u044b\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u043f\u0440\u044b\u0437\u043d\u0430\u0435\u043c \u0443 \u0406\u043c \u0433\u0430\u043b\u0430\u0441\u044b \u043d\u0430\u0448\u044b, \u0430 \u045e \u043d\u0430\u0441 &ndash; \u042f\u0433\u043e\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"32","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u043c \u0441\u0432\u0435\u0446\u0435 <br \/>&laquo;Gaudium et spes&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(N. 48)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u0441\u0443\u0436\u044d\u043d\u0441\u0442\u0432\u0430 \u0456 \u0441\u044f\u043c&rsquo;\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043b\u044b\u0431\u043e\u043a\u0430\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0441\u0443\u0436\u044d\u043d\u0441\u043a\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u044f \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c \u0456 \u045e\u043d\u0430\u0440\u043c\u0430\u0432\u0430\u043d\u0430\u044f \u042f\u0433\u043e \u0437\u0430\u043a\u043e\u043d\u0430\u043c\u0456, \u0443\u0441\u0442\u0430\u043b\u0451\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0441\u0443\u0436\u044d\u043d\u0441\u043a\u0456 \u0441\u0430\u044e\u0437, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u043d\u0435\u0437\u0432\u0430\u0440\u043e\u0442\u043d\u0443\u044e \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0443\u044e \u0437\u0433\u043e\u0434\u0443. \u0422\u0430\u043a \u043f\u0440\u0430\u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0430\u043a\u0442, \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u044f\u043a\u043e\u0433\u0430 \u0441\u0443\u0436\u044d\u043d\u0446\u044b \u0430\u0434\u0434\u0430\u044e\u0446\u044c \u0441\u044f\u0431\u0435 \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u043c\u0443 \u0456 \u043f\u0440\u044b\u043c\u0430\u044e\u0446\u044c, \u043f\u0430\u045e\u0441\u0442\u0430\u0435 \u0437 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456 \u0456\u043d\u0441\u0442\u044b\u0442\u0443\u0442 \u0441\u0443\u0436\u044d\u043d\u0441\u0442\u0432\u0430, \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0435\u0440\u0430\u0434 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u0442\u0432\u0430\u043c. \u0413\u044d\u0442\u044b \u0441\u0432\u044f\u0442\u044b \u0441\u0430\u044e\u0437 \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0431\u0440\u0430 \u044f\u043a \u0441\u0443\u0436\u044d\u043d\u0446\u0430\u045e \u0456 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430, \u0442\u0430\u043a \u0456 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u0442\u0432\u0430 \u043d\u0435 \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u044f, \u0431\u043e \u0441\u0430\u043c \u0411\u043e\u0433 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0442\u0432\u0430\u0440\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0441\u0443\u0436\u044d\u043d\u0441\u0442\u0432\u0430, \u0430\u0434\u043e\u0440\u0430\u043d\u0430\u0433\u0430 \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456 \u0456 \u043c\u044d\u0442\u0430\u043c\u0456. \u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u043c\u0430\u0435 \u0432\u044f\u043b\u0456\u0437\u043d\u0430\u0435 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0434\u043b\u044f \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0440\u043e\u0434\u0443, \u0434\u043b\u044f \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430\u0433\u0430 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0435\u043d\u043d\u044f \u0456 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u043b\u0451\u0441\u0443 \u043f\u0430\u0430\u0441\u043e\u0431\u043d\u044b\u0445 \u0447\u043b\u0435\u043d\u0430\u045e \u0441\u044f\u043c&rsquo;\u0456, \u0434\u043b\u044f \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456, \u0441\u0442\u0430\u0431\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0434\u0430\u0431\u0440\u0430 \u0441\u0430\u043c\u043e\u0439 \u0441\u044f\u043c&rsquo;\u0456 \u0456 \u045e\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430. \u041f\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0456\u043d\u0441\u0442\u044b\u0442\u0443\u0442 \u0441\u0443\u0436\u044d\u043d\u0441\u0442\u0432\u0430 \u0456 \u0441\u0443\u0436\u044d\u043d\u0441\u043a\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0456 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u044f\u043a \u0431\u044b \u044f\u0435 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0432\u044f\u043d\u0446\u043e\u043c. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0456 \u043c\u0443\u0436\u0447\u044b\u043d\u0430, \u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u044f\u043a\u0456\u044f \u045e \u0441\u0443\u0436\u044d\u043d\u0441\u043a\u0456\u043c \u0441\u0430\u044e\u0437\u0435 &laquo;\u045e\u0436\u043e \u043d\u0435 \u0434\u0432\u043e\u0435, \u0430\u043b\u0435 \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430&raquo; (\u041c\u0446 19, 6), \u043f\u0440\u0430\u0437 \u0441\u0430\u043c\u0430\u0435 \u0446\u0435\u0441\u043d\u0430\u0435 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u0430\u0441\u043e\u0431\u0430\u045e \u0456 \u0441\u043f\u0440\u0430\u045e \u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u043c\u0443 \u045e\u0437\u0430\u0435\u043c\u043d\u0443\u044e \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0443 \u0456 \u043f\u0430\u0441\u043b\u0443\u0433\u0443, \u0437\u0432\u0435\u0434\u0432\u0430\u044e\u0446\u044c \u0441\u044d\u043d\u0441 \u0441\u0432\u0430\u0451\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u0437 \u043a\u043e\u0436\u043d\u044b\u043c \u0434\u043d\u0451\u043c \u043f\u0430\u045e\u043d\u0435\u0439 \u0434\u0430\u0441\u044f\u0433\u0430\u044e\u0446\u044c \u044f\u0435. \u0413\u044d\u0442\u044b \u0433\u043b\u044b\u0431\u043e\u043a\u0456 \u0441\u0430\u044e\u0437 \u0456 \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u044f \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u043c\u0443 \u0434\u0437\u0432\u044e\u0445 \u0430\u0441\u043e\u0431\u0430\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430\u0431\u0440\u043e \u0434\u0437\u044f\u0446\u0435\u0439 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0446\u044c \u0446\u0430\u043b\u043a\u0430\u0432\u0456\u0442\u0430\u0439 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456 \u0430\u0434 \u0441\u0443\u0436\u044d\u043d\u0446\u0430\u045e \u0456 \u043d\u0435\u0440\u0430\u0437\u0440\u044b\u045e\u043d\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d \u0448\u0447\u043e\u0434\u0440\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u0433\u044d\u0442\u0443 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0430\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0437 \u0411\u043e\u0436\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0431\u044b\u043b\u0430 \u045e\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u0430 \u043d\u0430 \u045e\u0437\u043e\u0440 \u042f\u0433\u043e \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c. \u042f\u043a \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0411\u043e\u0433 \u0432\u044b\u0439\u0448\u0430\u045e \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0441\u0432\u0430\u0439\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u0437 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0430\u043c \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456, \u0442\u0430\u043a \u0456 \u0446\u044f\u043f\u0435\u0440 \u0417\u0431\u0430\u045e\u0446\u0430 \u0456 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456\u043c \u0441\u0443\u0436\u044d\u043d\u0446\u0430\u043c \u043f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0441\u0443\u0436\u044d\u043d\u0441\u0442\u0432\u0430 \u0456 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0437 \u0456\u043c\u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439, \u043a\u0430\u0431, \u044f\u043a \u0401\u043d \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u041a\u0430\u0441\u0446\u0451\u043b \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u044f\u0433\u043e, \u0442\u0430\u043a \u0456 \u0441\u0443\u0436\u044d\u043d\u0446\u044b \u0432\u0430 \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u0456 \u0456 \u045e \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430\u0439 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456 \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u0433\u043e. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u0441\u0443\u0436\u044d\u043d\u0441\u043a\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0443\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0411\u043e\u0436\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u043a\u0456\u0440\u0443\u0435\u0446\u0446\u0430 \u0456 \u045e\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u0435\u0446\u0446\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u0447\u0430\u044e \u043c\u043e\u0446\u0430\u0439 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0437\u0431\u0430\u045e\u0447\u044b\u043c \u0434\u0437\u0435\u044f\u043d\u043d\u0435\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043a\u0430\u0431 \u043f\u0430\u0441\u043f\u044f\u0445\u043e\u0432\u0430 \u0432\u0435\u0441\u0446\u0456 \u0441\u0443\u0436\u044d\u043d\u0446\u0430\u045e \u0434\u0430 \u0411\u043e\u0433\u0430, \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0456 \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u0446\u044c \u0456\u0445 \u0432\u0430 \u045e\u0437\u043d\u0451\u0441\u043b\u044b\u043c \u0437\u0430\u0434\u0430\u043d\u043d\u0456 \u0431\u0430\u0446\u044c\u043a\u0456 \u0456 \u043c\u0430\u0446\u0456. \u0422\u0430\u043c\u0443 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456\u044f \u0441\u0443\u0436\u044d\u043d\u0446\u044b \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u0446\u0430 \u0434\u043b\u044f \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u045e \u0456 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0430\u043d\u0443 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u043c \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043c. \u041d\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0447\u044b \u044f\u0433\u043e \u043c\u043e\u0446\u0430\u0439 \u0441\u0432\u043e\u0439 \u0441\u0443\u0436\u044d\u043d\u0441\u043a\u0456 \u0456 \u0441\u044f\u043c\u0435\u0439\u043d\u044b \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a, \u044f\u043d\u044b \u0441\u0430\u043c\u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0446\u0446\u0430 \u0434\u0443\u0445\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0446\u0456\u043d\u0430\u0435 \u045e\u0441\u0451 \u0456\u0445 \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0440\u0430\u0439, \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0456 \u043b\u044e\u0431\u043e\u045e\u044e; \u0443\u0441\u0451 \u0431\u043e\u043b\u044c\u0448 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u044e\u0446\u0446\u0430 \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u0456 \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0433\u0430 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f, \u0430 \u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u0434\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0434\u0437\u0435\u0446\u0456, \u0430 \u043d\u0430\u0432\u0430\u0442 \u0443\u0441\u0435, \u0445\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0441\u044f\u043c\u0435\u0439\u043d\u044b\u043c \u043a\u043e\u043b\u0435, \u043b\u044f\u0433\u0447\u044d\u0439 \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u044c \u0448\u043b\u044f\u0445 \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456, \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0441\u0430\u043c\u0456\u0445 \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u0456 \u0441\u044f\u043c\u0435\u0439\u043d\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430. \u0422\u0430\u043a \u0441\u0443\u0436\u044d\u043d\u0446\u044b, \u0430\u0437\u0434\u043e\u0431\u043b\u0435\u043d\u044b\u044f \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e \u0456 \u0437\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u0431\u0430\u0446\u044c\u043a\u043e\u045e\u0441\u0442\u0432\u0430 \u0456 \u043c\u0430\u0446\u044f\u0440\u044b\u043d\u0441\u0442\u0432\u0430, \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0440\u044d\u043b\u0456\u0433\u0456\u0439\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u045e \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443 \u0456\u043c \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u0446\u0456 \u044f\u043a \u0436\u044b\u0432\u044b\u044f \u0447\u043b\u0435\u043d\u044b \u0441\u044f\u043c&rsquo;\u0456 \u043f\u0430-\u0441\u0432\u043e\u0439\u043c\u0443 \u0441\u043f\u0440\u044b\u044f\u044e\u0446\u044c \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044e \u0431\u0430\u0446\u044c\u043a\u043e\u045e. \u041f\u0430\u0447\u0443\u0446\u0446\u0451\u043c \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u0456, \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0434\u0430\u0432\u0435\u0440\u0443 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u0437\u0430 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u0456 \u043f\u0430-\u0441\u044b\u043d\u043e\u045e\u0441\u043a\u0443 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0456\u0445 \u0443 \u043d\u0435\u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0447\u0430\u0441 \u0456 \u045e \u0430\u0434\u0437\u0456\u043d\u043e\u0446\u0435 \u0441\u0442\u0430\u0440\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 5, 32. 25b. 33b<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044f\u043b\u0456\u043a\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0433\u044d\u0442\u0430\u044f, \u0430 \u043a\u0430\u0436\u0443 \u044f \u045e \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u041a\u0430\u0441\u0446\u0451\u043b \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u044f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u044b\u043a \u043d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0437 \u0432\u0430\u0441 \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u0436\u043e\u043d\u043a\u0443 \u0442\u0430\u043a, \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u0430 \u0436\u043e\u043d\u043a\u0430 \u043d\u044f\u0445\u0430\u0439 \u0448\u0430\u043d\u0443\u0435 \u043c\u0443\u0436\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u041a\u0430\u0441\u0446\u0451\u043b \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u044f\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"33","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0434\u0440\u0430\u0431\u044f\u0437\u043d\u044b\u044f &laquo;\u0420\u044d\u0433\u0443\u043b\u044b&raquo; \u0441\u0432. \u0411\u0430\u0437\u044b\u043b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Resp. 2, 2-4: PG 31, 914-915)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0427\u044b\u043c \u0430\u0434\u0434\u0437\u044f\u0447\u044b\u043c \u041f\u0430\u043d\u0443 \u0437\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c?<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0430\u044f \u0436 \u043c\u043e\u0432\u0430 \u0437\u0434\u043e\u043b\u0435\u0435 \u043d\u0430\u043b\u0435\u0436\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u0434\u0430\u0440\u044b \u0411\u043e\u0436\u044b\u044f? \u0406\u0445 \u0442\u0430\u043a\u043e\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430, \u0448\u0442\u043e \u044f\u043d\u044b \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u044e\u0446\u0446\u0430 \u043f\u0430\u0434\u043b\u0456\u043a\u0443. \u0406\u0445 \u0432\u0435\u043b\u0456\u0447 \u0442\u0430\u043a\u0430\u044f \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u044f, \u0448\u0442\u043e \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0430\u0434\u043d\u0430\u0433\u043e, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u043b\u0456 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430 \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u0414\u0430\u045e\u0446\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0451\u0441\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043c\u044b \u043d\u0456\u044f\u043a, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0431 \u0445\u0430\u0446\u0435\u043b\u0456, \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0430\u0431\u043c\u0456\u043d\u0443\u0446\u044c \u0456 \u0430\u0431 \u0447\u044b\u043c \u043d\u0456\u0445\u0442\u043e, \u0430\u0434\u043e\u0440\u0430\u043d\u044b \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u043d\u0435 \u043c\u043e\u0436\u0430 \u043c\u0430\u045e\u0447\u0430\u0446\u044c, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0430\u0448\u043c\u0430\u0442 \u043c\u0435\u043d\u0448, \u0447\u044b\u043c \u0442\u0440\u044d\u0431\u0430. \u0411\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u0441\u0432\u043e\u0439 \u0432\u043e\u0431\u0440\u0430\u0437 \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430. \u0423\u0434\u0430\u0441\u0442\u043e\u0456\u045e \u044f\u0433\u043e \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u0430\u0437\u0434\u043e\u0431\u0456\u045e \u044f\u0433\u043e \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u0437\u044f\u043c\u043d\u044b\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e. \u0414\u0430\u045e \u044f\u043c\u0443 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u043d\u0435\u0432\u0435\u0440\u0430\u0433\u043e\u0434\u043d\u0430\u0439 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044e \u0440\u0430\u044e \u0456 \u043d\u0430\u0440\u044d\u0448\u0446\u0435 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u044f\u0433\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043e\u043c \u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0437\u044f\u043c\u043d\u044b\u043c. \u0422\u0430\u0434\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u0434\u0434\u0430\u045e\u0441\u044f \u0441\u043f\u0430\u043a\u0443\u0441\u0435 \u0437\u043c\u0435\u044f \u0456 \u0442\u0440\u0430\u043f\u0456\u045e \u0443 \u0433\u0440\u044d\u0445, \u0430 \u043f\u0440\u0430\u0437 \u044f\u0433\u043e &ndash; \u0443 \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u045e \u043d\u044f\u0434\u043e\u043b\u044e, \u044f\u043a\u0443\u044e \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u045e, \u0430\u0434\u043d\u0430\u043a \u0411\u043e\u0433 \u044f\u0433\u043e \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u044f\u043c\u0443 \u0417\u0430\u043a\u043e\u043d, \u043a\u0430\u0431 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u045e \u044f\u043c\u0443; \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0430\u043d\u0451\u043b\u0430\u045e, \u043a\u0430\u0431 \u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u0456 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u043b\u0456\u0441\u044f \u0430\u0431 \u0456\u043c, \u043f\u0430\u0441\u044b\u043b\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u043a\u0430\u0431 \u0432\u044b\u043a\u0440\u044b\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u043b\u0456 \u0446\u043d\u043e\u0446\u0435. \u041f\u0430\u0433\u0440\u043e\u0437\u0430\u043c\u0456 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u0456 \u045e\u0442\u0430\u0439\u043c\u043e\u045e\u0432\u0430\u045e \u044f\u0433\u043e \u0441\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0437\u043b\u0430, \u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u043c\u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u045e \u0434\u0430 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430. \u0427\u0430\u0441\u0442\u0430 \u0456 \u043d\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0437\u0435 \u0440\u043e\u0437\u043d\u044b\u0445 \u0430\u0441\u043e\u0431\u0430\u045e \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u045e \u043d\u0430\u043f\u0435\u0440\u0430\u0434 \u0434\u043b\u044f \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u044f \u0456\u043d\u0448\u044b\u0445 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u044b \u043b\u0451\u0441 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0456 \u0434\u0440\u044d\u043d\u043d\u0430\u0433\u0430 \u0448\u043b\u044f\u0445\u0443. \u0406 \u043d\u0430\u0432\u0430\u0442 \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0443\u043f\u0430\u0440\u0442\u0430 \u0442\u0440\u044b\u043c\u0430\u045e\u0441\u044f \u0441\u0432\u0430\u0451\u0439 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456, \u0411\u043e\u0433 \u0443\u0441\u0451 \u0430\u0434\u043d\u043e \u043d\u0435 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0430\u0434 \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430\u044f \u0434\u0430\u0431\u0440\u044b\u043d\u044f \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0430 \u043d\u0430\u0441, \u0456 \u043c\u044b \u043d\u0435 \u0437\u043c\u0430\u0433\u043b\u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0433\u0430 \u0434\u0430 \u043d\u0430\u0441, \u0430\u0434\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0433\u043e\u043d\u0430\u0440, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430\u0441 \u041f\u0430\u043d, \u0445\u043e\u0446\u044c \u0456 \u0437\u043d\u044f\u0432\u0430\u0436\u044b\u043b\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0414\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u0446\u0443. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u043d\u0430\u0448 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u0432\u0451\u045e \u043d\u0430\u0441 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0432\u044f\u0440\u043d\u0443\u045e \u0434\u0430 \u0436\u044b\u0446\u0446\u044f. \u0423 \u0433\u044d\u0442\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0441\u043f\u043e\u0441\u0430\u0431 \u0430\u043a\u0430\u0437\u0430\u043d\u043d\u044f \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u0435: &laquo;\u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0431\u0443\u0434\u0443\u0447\u044b \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0411\u043e\u0433\u0430, \u043d\u0435 \u0441\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u045e \u0437 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u043d\u0430\u0440\u043e\u045e\u043d\u0456 \u0437 \u0411\u043e\u0433\u0430\u043c, \u0430\u043b\u0435 \u0432\u044b\u0440\u0430\u043a\u0441\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456&raquo; (\u0424\u043b\u043f 2, 6-7).<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 &laquo;\u045e\u0437\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u043d\u0430\u0448\u044b\u044f \u0456 \u043f\u0430\u043d\u0451\u0441 \u043d\u0430\u0448\u044b \u0445\u0432\u0430\u0440\u043e\u0431\u044b. \u0401\u043d \u0437\u0440\u0430\u043d\u0435\u043d\u044b \u0431\u044b\u045e \u0437\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u043d\u0430\u0448\u044b\u044f, \u0440\u0430\u0437\u0434\u0430\u045e\u043b\u0435\u043d\u044b \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u0430\u0432\u0456\u043d\u044b&raquo; (\u043f\u0430\u0440. \u0406\u0441 53, 4-5). \u0401\u043d &laquo;\u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0430\u0434 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0443, \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u043c \u0437\u0430 \u043d\u0430\u0441&raquo; (\u0413\u0430\u043b 3, 13), \u0456 \u043f\u0430\u043c\u0451\u0440 \u0441\u0430\u043c\u0430\u0439 \u0433\u0430\u043d\u0435\u0431\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u044e, \u043a\u0430\u0431 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u043d\u0430\u0441 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u045e \u0441\u043b\u0430\u0432\u0435. \u042f\u043c\u0443 \u0431\u044b\u043b\u043e \u043d\u0435\u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f, \u0430\u043b\u0435 \u0401\u043d \u044f\u0448\u0447\u044d \u0456 \u0430\u0434\u0430\u0440\u044b\u045e \u0456\u0445 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e \u0441\u0432\u0430\u0451\u0439 \u0411\u043e\u0441\u043a\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0432\u0435\u0447\u043d\u044b \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0432\u0435\u043b\u0456\u0447\u0447\u0443 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u045e\u044f\u045e\u043b\u0435\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0436 \u043c\u044b \u0430\u0434\u0434\u0430\u043c\u043e \u041f\u0430\u043d\u0443 &laquo;\u0437\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0401\u043d \u043d\u0430\u043c \u0437\u0440\u0430\u0431\u0456\u045e&raquo; (\u043f\u0430\u0440. \u041f\u0441 116 [115], 12)? \u0401\u043d \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043e\u0431\u0440\u044b, \u0448\u0442\u043e \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u045e\u0437\u0430\u043c\u0435\u043d \u043d\u0456\u0447\u043e\u0433\u0430. \u042f\u043c\u0443 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u043d\u0430\u0432\u0430\u0442 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u043d\u0430\u043c \u0443\u0434\u0437\u044f\u043b\u0456\u045e. \u041a\u0430\u043b\u0456 \u044f \u0434\u0443\u043c\u0430\u044e \u043f\u0440\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 (\u043a\u0430\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0448\u0447\u044b\u0440\u0430), \u043c\u044f\u043d\u0435 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u0436\u0430\u0445 \u0456 \u0437\u0434\u0440\u0430\u043d\u0446\u0432\u0435\u043d\u043d\u0435 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u0431\u0435\u0437\u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u044c \u0446\u0456 \u043f\u0440\u0430\u0437 \u0437\u0430\u043d\u044f\u0442\u0430\u0441\u0446\u044c \u043c\u0430\u0440\u043d\u044b\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456 \u044f \u043c\u0430\u0433\u0443 \u0441\u0442\u0440\u0430\u0446\u0456\u0446\u044c \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0443\u044e \u0456 \u0441\u0442\u0430\u0446\u044c \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0440\u0430\u0434\u043c\u0435\u0442\u0430\u043c \u0441\u043e\u0440\u0430\u043c\u0443 \u0456 \u0430\u0433\u0456\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 102 (103), 2. 4. \u0413\u0430\u043b 2, 20\u0441<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456, \u0434\u0443\u0448\u0430 \u043c\u0430\u044f, \u041f\u0430\u043d\u0430 \u0456 \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0439 \u043f\u0440\u0430 \u045e\u0441\u0435 \u042f\u0433\u043e \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b.<span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0436\u044b\u0446\u0446\u0451 \u0442\u0432\u0430\u0451 \u0440\u0430\u0442\u0443\u0435 \u0430\u0434 \u0437\u0430\u0433\u0443\u0431\u044b, \u043b\u0456\u0442\u0430\u0441\u0446\u044e \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e \u0446\u044f\u0431\u0435 \u043a\u0430\u0440\u0430\u043d\u0443\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043c\u044f\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0436\u044b\u0446\u0446\u0451 \u0442\u0432\u0430\u0451 \u0440\u0430\u0442\u0443\u0435 \u0430\u0434 \u0437\u0430\u0433\u0443\u0431\u044b, \u043b\u0456\u0442\u0430\u0441\u0446\u044e \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e \u0446\u044f\u0431\u0435 \u043a\u0430\u0440\u0430\u043d\u0443\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"34","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u041f\u0435\u0441\u043d\u044f \u043f\u0435\u0441\u043d\u044f\u045e&raquo; \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 61, 3-5: Opera omnia, 1839, 1, 2, 3033)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0414\u0437\u0435 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e\u0441\u044f \u0433\u0440\u044d\u0445, \u0442\u0430\u043c \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u043b\u0430\u0441\u044f \u043b\u0430\u0441\u043a\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435 \u0436 \u043d\u0430\u043c, \u0441\u043b\u0430\u0431\u044b\u043c \u043b\u044e\u0434\u0437\u044f\u043c, \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u0443\u044e \u0431\u044f\u0441\u043f\u0435\u043a\u0443 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439, \u044f\u043a \u043d\u0435 \u045e \u0440\u0430\u043d\u0430\u0445 \u0417\u0431\u0430\u045e\u0446\u044b? \u042f \u0436\u044b\u0432\u0443 \u045e \u0456\u0445 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0439 \u0451\u0441\u0446\u044c \u042f\u0433\u043e\u043d\u0430\u044f \u043c\u043e\u0446 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0425\u0456\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u0435\u0442, \u0433\u043d\u044f\u0446\u0435 \u0446\u0435\u043b\u0430, \u0434&rsquo;\u044f\u0431\u0430\u043b \u0447\u044b\u043d\u0456\u0446\u044c \u043f\u0430\u0434\u043a\u043e\u043f\u044b, \u0430\u043b\u0435 \u044f \u043d\u0435 \u043f\u0430\u0434\u0430\u044e, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u0446\u0432\u0451\u0440\u0434\u0430\u0439 \u0441\u043a\u0430\u043b\u0435. \u042f \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0433\u0440\u0430\u0445\u043e\u043c, \u043c\u044f\u043d\u0435 \u043c\u0443\u0447\u044b\u0446\u044c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435, \u0430\u043b\u0435 \u043d\u0435 \u0437\u0430\u043c\u0443\u0447\u044b\u0446\u044c \u0434\u0430 \u043a\u0430\u043d\u0446\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u044f \u045e\u0441\u043f\u043e\u043c\u043d\u044e \u0430\u0431 \u0440\u0430\u043d\u0430\u0445 \u041f\u0430\u043d\u0430. \u0401\u043d &laquo;\u0437\u0440\u0430\u043d\u0435\u043d\u044b \u0431\u044b\u045e \u0437\u0430 \u043d\u0430\u0448\u044b \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456&raquo; (\u0406\u0441 53, 5). \u0428\u0442\u043e \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c, \u0430\u0434 \u0447\u0430\u0433\u043e \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u0431 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430? \u041a\u0430\u043b\u0456 \u044f \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u044e \u043f\u0440\u0430 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u0439\u0441\u043d\u044b \u043b\u0435\u043a, \u0443\u0436\u043e \u043d\u0435 \u043c\u0430\u0433\u0443 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u0446\u0446\u0430 \u043d\u0456\u044f\u043a\u0430\u0439 \u043b\u0456\u0445\u043e\u0439 \u0445\u0432\u0430\u0440\u043e\u0431\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430 \u043f\u0430\u043c\u044b\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043a\u0430\u0436\u0430: &laquo;\u041c\u0430\u0451 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0437\u0430\u043d\u0430\u0434\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u043a\u0430\u0431 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0446\u044c \u044f\u0433\u043e&raquo; (\u0411\u044b\u0446 4, 13). \u0425\u0456\u0431\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0451\u043d \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u0430\u045e \u0434\u0430 \u0447\u043b\u0435\u043d\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u044f\u0433\u043e \u043d\u0435 \u0434\u0430\u0442\u044b\u0447\u044b\u043b\u0456 \u0437\u0430\u0441\u043b\u0443\u0433\u0456 \u0425\u0440\u044b\u0441\u0442\u0430. \u0422\u0430\u043c\u0443 \u0451\u043d \u043d\u0435 \u043c\u043e\u0433 \u043b\u0456\u0447\u044b\u0446\u044c \u0456 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0443, \u044f\u043a \u0440\u043e\u0431\u044f\u0446\u044c \u0447\u043b\u0435\u043d\u044b \u045e \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0433\u0430\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0436 \u0437 \u0443\u043f\u044d\u045e\u043d\u0435\u043d\u0430\u0441\u0446\u044e \u0447\u044d\u0440\u043f\u0430\u044e \u0441\u0430\u0431\u0435 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435\u0441\u0442\u0430\u0435, \u0437 \u0441\u044d\u0440\u0446\u0430 \u041f\u0430\u043d\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u043e \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e \u0456 \u043d\u044f\u043c\u0430 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443 \u045e \u0440\u0430\u043d\u0430\u0445, \u043f\u0440\u0430\u0437 \u044f\u043a\u0456\u044f \u044f\u043d\u0430 \u0432\u044b\u0446\u044f\u043a\u0430\u0435. \u041f\u0440\u0430\u0431\u0456\u043b\u0456 \u042f\u0433\u043e \u0440\u0443\u043a\u0456 \u0456 \u043d\u043e\u0433\u0456, \u043f\u0440\u0430\u0431\u0456\u043b\u0456 \u0434\u0437\u0456\u0434\u0430\u044e \u0431\u043e\u043a, \u0442\u0430\u043c\u0443 \u043f\u0440\u0430\u0437 \u0440\u0430\u043d\u044b \u043c\u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0435\u043d\u0430 \u043f\u0456\u0446\u044c &laquo;\u043c\u0451\u0434 \u0441\u0430 \u0441\u043a\u0430\u043b\u044b \u0456 \u0430\u043b\u0435\u0439 \u0437 \u0441\u0430\u043c\u0430\u0433\u0430 \u0446\u0432\u0451\u0440\u0434\u0430\u0433\u0430 \u043a\u0430\u043c\u0435\u043d\u044e&raquo; (\u0414\u0440\u0433 32, 13), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0441\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044c \u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u044c, &laquo;\u044f\u043a\u0456 \u0441\u0430\u043b\u043e\u0434\u043a\u0456 \u0451\u0441\u0446\u044c \u041f\u0430\u043d&raquo; (\u043f\u0430\u0440. \u041f\u0441 35 [34], 9).<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043c\u0435\u045e \u0434\u0443\u043c\u043a\u0456 \u0441\u043f\u0430\u043a\u043e\u044e, \u0430 \u044f \u043d\u0435 \u0432\u0435\u0434\u0430\u045e. &laquo;\u0411\u043e \u0445\u0442\u043e \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u0440\u043e\u0437\u0443\u043c \u041f\u0430\u043d\u0430? \u0410\u0431\u043e \u0445\u0442\u043e \u0431\u044b\u045e \u0434\u0430\u0440\u0430\u0434\u0446\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u043c&raquo; (\u043f\u0430\u0440. \u0420\u044b\u043c 11, 34)? \u0410\u043b\u0435 \u0446\u0432\u0456\u043a, \u044f\u043a\u0456 \u043f\u0440\u0430\u0431\u0456\u0432\u0430\u0435, \u0441\u0442\u0430\u045e \u043a\u043b\u044e\u0447\u043e\u043c, \u044f\u043a\u0456 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u043c\u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0432\u043e\u043b\u0456 \u0411\u043e\u0436\u0430\u0439. \u0406 \u0448\u0442\u043e \u0436 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0443 \u0440\u0430\u043d\u0435? \u0426\u0432\u0456\u043a \u043a\u0440\u044b\u0447\u044b\u0446\u044c, \u043a\u0440\u044b\u0447\u044b\u0446\u044c \u0440\u0430\u043d\u0430, \u0448\u0442\u043e \u0411\u043e\u0433 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u045e \u0437 \u0441\u0430\u0431\u043e\u044e \u0441\u0432\u0435\u0442. &laquo;\u041c\u0435\u0447 \u043f\u0440\u0430\u0446\u044f\u045e \u042f\u0433\u043e\u043d\u0443\u044e \u0434\u0443\u0448\u0443 \u0456 \u0434\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430&raquo; (\u043f\u0430\u0440. \u041f\u0441 115 [114], 18; 54, 22), \u043a\u0430\u0431 \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u0443\u0436\u043e \u0432\u0435\u0434\u0430\u045e \u043d\u0430\u0448\u044b \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0440\u0430\u043d\u044b \u0446\u0435\u043b\u0430 \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0441\u044d\u0440\u0446\u0430, \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u043b\u044e\u0431\u043e\u0432\u0456, \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430 &laquo;\u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430, \u0437 \u044f\u043a\u043e\u0439 \u043d\u0430\u0432\u0435\u0434\u0430\u045e \u043d\u0430\u0441 \u0423\u0441\u0445\u043e\u0434 \u0437 \u0432\u044b\u0448\u044b\u043d\u0456&raquo; (\u041b\u043a 1, 78). \u0406 \u0447\u0430\u043c\u0443 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0430\u0434\u043a\u0440\u044b\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0440\u0430\u043d\u044b? \u0423 \u0447\u044b\u043c \u0436\u0430 \u0442\u0430\u043a \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430, \u044f\u043a \u043d\u0435 \u045e \u0422\u0432\u0430\u0456\u0445 \u0440\u0430\u043d\u0430\u0445, \u0437\u0430\u044f\u0441\u043d\u0435\u043b\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0422\u044b, \u041f\u0430\u043d\u0435, \u0441\u0430\u043b\u043e\u0434\u043a\u0456, \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u044b, \u0456 \u0431\u0430\u0433\u0430\u0442\u044b \u043d\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c? \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0447\u044b\u043c \u0442\u043e\u0439, \u0445\u0442\u043e \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0430\u0434\u0434\u0430\u0435 \u0437\u0430 \u0432\u044b\u0434\u0430\u0434\u0437\u0435\u043d\u044b\u0445 \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u0430\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u043d\u0435 \u0431\u0443\u0434\u0443 \u0431\u0435\u0434\u043d\u044b \u043d\u0430 \u0437\u0430\u0441\u043b\u0443\u0433\u0456, \u043f\u0430\u043a\u0443\u043b\u044c \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0431\u0430\u0433\u0430\u0442\u044b \u043d\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430, \u0442\u043e \u0456 \u044f \u0431\u0443\u0434\u0443 \u0431\u0430\u0433\u0430\u0442\u044b \u043d\u0430 \u0437\u0430\u0441\u043b\u0443\u0433\u0456. \u0410\u043b\u0435 \u0448\u0442\u043e \u0440\u0430\u0431\u0456\u0446\u044c, \u043a\u0430\u043b\u0456 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435 \u0434\u0430\u043a\u0430\u0440\u0430\u0435 \u043c\u044f\u043d\u0435 \u045e \u043c\u043d\u043e\u0441\u0442\u0432\u0435 \u0433\u0440\u0430\u0445\u043e\u045e? &laquo;\u0414\u0437\u0435 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e\u0441\u044f \u0433\u0440\u044d\u0445, \u0442\u0430\u043c \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u043b\u0430\u0441\u044f \u043b\u0430\u0441\u043a\u0430&raquo; (\u0420\u044b\u043c 5, 20). \u0406 \u043a\u0430\u043b\u0456 &laquo;\u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443 \u0456 \u043d\u0430\u0432\u0435\u043a\u0456&raquo; (\u043f\u0430\u0440. \u041f\u0441 90 [89], 2), \u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 &laquo;\u0431\u0443\u0434\u0443 \u0430\u043f\u044f\u0432\u0430\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430&raquo; (\u043f\u0430\u0440. \u041f\u0441 10 [9], 16). \u0426\u0456 \u0451\u0441\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u043c\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c? &laquo;\u041f\u0430\u043d\u0435, \u0431\u0443\u0434\u0443 \u043f\u043e\u043c\u043d\u0456\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0422\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c&raquo; (\u043f\u0430\u0440. \u041f\u0441 10 [9], 16). \u042f\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u0456 \u043c\u0430\u0451\u0439, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0422\u044b \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0430\u0434 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 53, 5; 1 \u041f 2, 24<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0437\u0440\u0430\u043d\u0435\u043d\u044b \u0431\u044b\u045e \u0437\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u043d\u0430\u0448\u044b\u044f, \u0440\u0430\u0437\u0434\u0430\u045e\u043b\u0435\u043d\u044b \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u0430\u0432\u0456\u043d\u044b. \u041f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0441\u0432\u0435\u0442\u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u0430 \u0456\u043c, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u045e \u0440\u0430\u043d\u0430\u0445 \u042f\u0433\u043e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0434\u0430\u0440\u043e\u045e\u0435. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u0441\u0430\u043c, \u0443 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u045e\u0437\u043d\u0451\u0441 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f \u043d\u0430 \u0434\u0440\u044d\u0432\u0430, \u043a\u0430\u0431 \u043c\u044b, \u043f\u0430\u0437\u0431\u044b\u045e\u0448\u044b\u0441\u044f \u0433\u0440\u0430\u0445\u043e\u045e, \u0436\u044b\u043b\u0456 \u0434\u0437\u0435\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u045e \u0440\u0430\u043d\u0430\u0445 \u042f\u0433\u043e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0434\u0430\u0440\u043e\u045e\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"35","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u042f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u041d\u0435\u0430\u043f\u0430\u043b\u044f<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 7: PLS 4, 785-786)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041b\u044e\u0431\u0456 \u041f\u0430\u043d\u0430 \u0456 \u0445\u0430\u0434\u0437\u0456 \u0448\u043b\u044f\u0445\u0430\u043c\u0456 \u042f\u0433\u043e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0430\u043d &ndash; \u043c\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u043c\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435: \u043a\u0430\u0433\u043e \u0436 \u043c\u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430?&raquo; (\u041f\u0441 27 [26], 1). \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0431\u044b\u045e \u0433\u044d\u0442\u044b \u0441\u043b\u0443\u0433\u0430, \u044f\u043a\u0456 \u0432\u0435\u0434\u0430\u045e, \u044f\u043a \u044f\u0433\u043e \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u044e\u0446\u044c, \u0430\u0434\u043a\u0443\u043b\u044c \u044f\u0433\u043e \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u044e\u0446\u044c \u0456 \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435. \u0401\u043d \u0431\u0430\u0447\u044b\u045e \u0441\u0432\u044f\u0442\u043b\u043e, \u043d\u0435 \u0442\u043e\u0435, \u044f\u043a\u043e\u0435 \u0441\u0445\u0456\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0430 \u0437\u043c\u044f\u0440\u043a\u0430\u043d\u043d\u044f, \u0430\u043b\u0435 \u0442\u043e\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u044f\u043a\u043e\u0433\u0430 \u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c. \u0414\u0443\u0448\u044b \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u044f \u043d\u0435 \u043a\u0456\u0434\u0430\u044e\u0446\u0446\u0430 \u045e \u0433\u0440\u0430\u0445\u0456, \u043d\u0435 \u0446\u0435\u0440\u043f\u044f\u0446\u044c \u043f\u0430\u0440\u0430\u0437\u0443 \u0430\u0434 \u0437\u0430\u0433\u0430\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043a\u0430\u0437\u0430\u045e: &laquo;\u0425\u0430\u0434\u0437\u0456\u0446\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441&raquo; (\u042f\u043d 12, 35). \u041f\u0440\u0430 \u044f\u043a\u043e\u0435 \u0436 \u0441\u0432\u044f\u0442\u043b\u043e \u043a\u0430\u0437\u0430\u045e \u0401\u043d, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0440\u0430 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435? &laquo;\u042f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0430 \u0441\u0432\u0435\u0442 \u044f\u043a \u0441\u0432\u044f\u0442\u043b\u043e&raquo; (\u042f\u043d 12, 46), \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u0430\u0447\u0430\u0446\u044c, \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456, \u0430 \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u044b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0440\u043e\u043a. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d &ndash; \u043d\u0430\u0448\u0430 \u0441\u0432\u044f\u0442\u043b\u043e, \u0441\u043e\u043d\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043a\u043e\u0435 \u0430\u043f\u0440\u0430\u043c\u0435\u043d\u044c\u0432\u0430\u0435 \u0441\u0432\u043e\u0439 \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456. \u041f\u0440\u0430\u0440\u043e\u043a \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u045e \u0430\u0431 \u0433\u044d\u0442\u044b\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0430\u043d &ndash; \u043c\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u043c\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435: \u043a\u0430\u0433\u043e \u0436 \u043c\u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043b\u0430\u0432\u0435\u043a, \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b \u0437\u043d\u0443\u0442\u0440\u044b, \u043d\u0435 \u043a\u0443\u043b\u044c\u0433\u0430\u0435, \u043d\u0435 \u0437\u0431\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0430 \u0448\u043b\u044f\u0445\u0443 \u0456 \u045e\u0441\u0451 \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435. \u0422\u043e\u0439, \u0445\u0442\u043e \u0437\u0434\u0430\u043b\u0451\u043a \u0431\u0430\u0447\u044b\u0446\u044c \u0440\u0430\u0434\u0437\u0456\u043c\u0443, \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u043d\u044f\u0434\u043e\u043b\u044e, \u043d\u0435 \u0441\u043c\u0443\u0442\u043a\u0443\u0435 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0447\u0430\u0441\u043e\u0432\u044b\u0445 \u0441\u043f\u0440\u0430\u045e, \u0430\u043b\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u0411\u043e\u0433\u0430. \u041f\u0440\u044b\u043d\u0456\u0436\u0430\u0435 \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456 \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u043a\u043e\u0440\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0413\u044d\u0442\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u044f\u043a\u043e\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 &laquo;\u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0433\u044d\u0442\u044b \u0441\u0432\u0435\u0442&raquo; (\u043f\u0430\u0440. \u042f\u043d 1, 9), \u0434\u0430\u0435\u0446\u0446\u0430 \u045e\u0441\u0456\u043c \u0431\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u044b\u043c, \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043f\u0430\u0436\u0430\u0434\u0430\u0435 \u0456 \u043a\u0430\u043b\u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u0435, \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u043c\u0443, \u043a\u0430\u043c\u0443 \u0445\u043e\u0447\u0430 \u0430\u0434\u043a\u0440\u044b\u0446\u0446\u0430 \u0421\u044b\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0436\u044b\u045e \u0443 \u0446\u0435\u043c\u0440\u044b \u0456 \u0446\u0435\u043d\u0456 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c, \u0443 \u0437\u043c\u0440\u043e\u043a\u0443 \u0437\u043b\u0430 \u0456 \u0437\u043c\u0440\u043e\u043a\u0443 \u0433\u0440\u0430\u0445\u043e\u045e, \u0441\u0430 \u0441\u0442\u0440\u0430\u0445\u0430\u043c \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0441\u044f\u0431\u0435, \u0448\u043a\u0430\u0434\u0443\u0435, \u0441\u0430\u0440\u043e\u043c\u0435\u0435\u0446\u0446\u0430 \u0456 \u043a\u0430\u0436\u0430: &laquo;\u041f\u0430\u043d &ndash; \u043c\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u043c\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435: \u043a\u0430\u0433\u043e \u0436 \u043c\u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430?&raquo; \u0412\u044f\u043b\u0456\u043a\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0431\u0440\u0430\u0442\u044b \u043c\u0430\u0435. \u0413\u044d\u0442\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u0435 \u0431\u0430\u0456\u0446\u0446\u0430, \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0435\u0446\u0446\u0430 \u0441\u0442\u043e\u043c\u043b\u0435\u043d\u0430\u0441\u0446\u0456, \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0430 \u043f\u0430\u043a\u0443\u0442\u044b. \u0422\u0430\u043c\u0443 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u0433\u043e\u043b\u0430\u0441, \u0430\u043b\u0435 \u045e \u0434\u0443\u043c\u043a\u0430\u0445 \u043a\u0440\u044b\u0447\u0430\u0446\u044c \u043d\u0430 \u045e\u0441\u044e \u043c\u043e\u0446: &laquo;\u041f\u0430\u043d &ndash; \u043c\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u043c\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435: \u043a\u0430\u0433\u043e \u0436 \u043c\u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430?&raquo; \u041a\u0430\u043b\u0456 \u0401\u043d \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435, \u0401\u043d \u0437\u0431\u0430\u045e\u043b\u044f\u0435, \u043a\u0430\u0433\u043e \u043c\u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430? \u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0446\u0435\u043c\u0440\u0430 \u0441\u043f\u0430\u043a\u0443\u0441 &ndash; \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u043c\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c. \u041f\u0440\u044b\u0439\u0441\u0446\u0456 \u043c\u043e\u0436\u0430, \u0430\u043b\u0435 \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u043a\u0430\u0440\u0430\u043d\u0456\u0446\u0446\u0430; \u043c\u043e\u0436\u0430 \u0430\u0441\u0430\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0448\u0430 \u0441\u044d\u0440\u0446\u0430, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0447\u044b. \u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0441\u043b\u0435\u043f\u0430\u0442\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e &ndash; \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u043c\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c. \u0401\u043d \u043d\u0430\u0448\u0430 \u043c\u043e\u0446 \u0456 \u0433\u044d\u0442\u0430 \u0401\u043d \u0434\u0430\u0435 \u043d\u0430\u043c, \u0430 \u043c\u044b \u0434\u0430\u0435\u043c \u042f\u043c\u0443. \u0411\u044f\u0436\u044b\u0446\u0435 \u0434\u0430 \u043b\u0435\u043a\u0430\u0440\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u044f\u0448\u0447\u044d \u043c\u043e\u0436\u0430\u0446\u0435, \u043a\u0430\u0431, \u043a\u0430\u043b\u0456 \u0437\u0430\u0445\u043e\u0447\u0430\u0446\u0435 \u0441\u0430\u043c\u0456, \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u043e\u0437\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0434\u0440 9, 10. 4\u0430<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0448\u043b\u0456, \u041f\u0430\u043d\u0435, \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0437 \u0441\u044f\u0434\u0437\u0456\u0431\u044b \u0432\u0435\u043b\u0456\u0447\u044b \u0441\u0432\u0430\u0451\u0439, \u043a\u0430\u0431 \u044f\u043d\u0430 \u0431\u044b\u043b\u0430 \u0441\u0430 \u043c\u043d\u043e\u044e \u0456 \u0441\u0430 \u043c\u043d\u043e\u044e \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043b\u0430, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u044f \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f, \u0448\u0442\u043e \u0422\u0430\u0431\u0435 \u043b\u044e\u0431\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d\u0435, \u0434\u0430\u0439 \u043c\u043d\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0448\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u044b \u0422\u0432\u0430\u0456\u043c \u0442\u0440\u043e\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u044f \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f, \u0448\u0442\u043e \u0422\u0430\u0431\u0435 \u043b\u044e\u0431\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"36","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u042f\u043d\u0430 \u0424\u0456\u0448\u0430\u0440\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 101: Opera omnia, ed. 1597, pp. 1588-1589)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0426\u0443\u0434\u044b \u0411\u043e\u0436\u044b\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0411\u043e\u0433 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0440\u043e\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0437 \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0430\u0439 \u043d\u044f\u0432\u043e\u043b\u0456, \u0443\u0447\u044b\u043d\u0456\u045e\u0448\u044b \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0437\u043d\u0430\u043a\u0430\u045e \u0456 \u0446\u0443\u0434\u0430\u045e: \u043f\u0435\u0440\u0430\u0432\u0451\u045e \u043f\u0430 \u0441\u0443\u0448\u044b \u043f\u0440\u0430\u0437 \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0435 \u043c\u043e\u0440\u0430; \u043a\u0430\u0440\u043c\u0456\u045e \u0456\u0445 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0430\u043c &ndash; \u043c\u0430\u043d\u043d\u0430\u0439 \u0456 \u043f\u0435\u0440\u0430\u043f\u0451\u043b\u043a\u0430\u043c\u0456; \u043f\u0440\u0430\u0431\u0456\u045e \u0434\u043b\u044f \u0441\u0430\u0441\u043c\u044f\u0433\u043b\u044b\u0445 \u043d\u0435\u0432\u044b\u0447\u0430\u0440\u043f\u0430\u043b\u044c\u043d\u0443\u044e \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u0437 \u0441\u0430\u043c\u0430\u0439 \u0446\u0432\u0451\u0440\u0434\u0430\u0439 \u0441\u043a\u0430\u043b\u044b; \u0434\u0430\u045e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0432\u0430\u044f\u0432\u0430\u043b\u0456 \u0437 \u0456\u043c; \u043f\u0440\u044b\u043c\u0443\u0441\u0456\u045e \u0432\u043e\u0434\u044b \u042f\u0440\u0434\u0430\u043d\u0430 \u043d\u0430 \u043f\u044d\u045e\u043d\u044b \u0447\u0430\u0441 \u043f\u043b\u044b\u0441\u0446\u0456 \u045e \u0430\u0434\u0432\u0430\u0440\u043e\u0442\u043d\u044b\u043c \u043a\u0456\u0440\u0443\u043d\u043a\u0443; \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u0456 \u0440\u0430\u0437\u043c\u0435\u0440\u043a\u0430\u0432\u0430\u045e \u0437\u044f\u043c\u043b\u044e, \u0430\u0431\u044f\u0446\u0430\u043d\u0443\u044e \u0456\u043c, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e \u0456 \u0440\u043e\u0434\u0430\u045e. \u0425\u043e\u0446\u044c \u0401\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430 \u0434\u043b\u044f \u0456\u0445 \u0437 \u0442\u0430\u043a\u043e\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0456 \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u044e, \u0442\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0437 \u043d\u044f\u045e\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e, \u044f\u043a \u0431\u044b \u0437\u0430\u0431\u044b\u045e\u0448\u044b \u043f\u0440\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430, \u043f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0456 \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u045e\u0448\u044b \u043a\u0443\u043b\u044c\u0442 \u0411\u043e\u0436\u044b, \u043d\u0435 \u0440\u0430\u0437 \u0430\u0434\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0433\u0430\u043d\u0435\u0431\u043d\u0430\u043c\u0443 \u0456 \u0437\u043b\u0430\u0447\u044b\u043d\u043d\u0430\u043c\u0443 \u0456\u0434\u0430\u043b\u0430\u043f\u0430\u043a\u043b\u043e\u043d\u0441\u0442\u0432\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0437\u043d\u0435\u0439 \u0456 \u043d\u0430\u0441, &laquo;\u043a\u0430\u043b\u0456 \u043c\u044b \u044f\u0448\u0447\u044d \u0431\u044b\u043b\u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c\u0456, \u0445\u0430\u0434\u0437\u0456\u043b\u0456 \u0434\u0430 \u043d\u044f\u043c\u044b\u0445 \u0456\u0434\u0430\u043b\u0430\u045e, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0432\u0430\u0434\u0437\u0456\u043b\u0456 \u043d\u0430\u0441&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 12, 2), \u0411\u043e\u0433 \u0430\u0434\u0440\u044d\u0437\u0430\u045e \u0430\u0434 \u043f\u0440\u044b\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0434\u0440\u044d\u0432\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u0446\u0442\u0432\u0430 \u0456, \u043f\u0430\u043b\u0430\u043c\u0430\u045e\u0448\u044b \u043f\u0440\u044b\u0440\u043e\u0434\u043d\u044b\u044f \u0433\u0430\u043b\u0456\u043d\u044b, \u043f\u0440\u044b\u0448\u0447\u0430\u043f\u0456\u045e \u043d\u0430\u0441 \u0434\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0430\u043b\u0456\u0432\u044b \u044e\u0434\u044d\u0439\u0441\u043a\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0434\u0430\u043b\u0443\u0447\u044b\u045e \u0434\u0430 \u0441\u0430\u043a\u0430\u0432\u0456\u0442\u044b\u0445 \u043a\u0430\u0440\u0430\u043d\u0451\u045e \u0441\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456. \u041d\u0430\u0440\u044d\u0448\u0446\u0435, &laquo;\u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e, \u0430\u043b\u0435 \u0430\u0434\u0434\u0430\u045e \u042f\u0433\u043e \u0437\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441 \u044f\u043a \u0434\u0430\u0440 \u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u0411\u043e\u0433\u0443 \u043d\u0430 \u043f\u0440\u044b\u0435\u043c\u043d\u044b \u043f\u0430\u0445, \u043a\u0430\u0431 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0456 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u043d\u0430\u0440\u043e\u0434 \u0432\u044b\u0431\u0440\u0430\u043d\u044b&raquo; (\u0420\u044b\u043c 8, 32; \u042d\u0444 5, 2; \u0426\u0456\u0442 2, 14).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u0430 \u0437\u043d\u0430\u043a\u0456, \u0430 \u0441\u0430\u043c\u044b\u044f \u043f\u044d\u045e\u043d\u044b\u044f \u0434\u043e\u043a\u0430\u0437\u044b \u042f\u0433\u043e \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456, \u0430\u0434\u043d\u0430\u043a \u043c\u044b, \u0441\u0442\u0440\u0430\u0448\u044d\u043d\u043d\u0430 \u043d\u044f\u045e\u0434\u0437\u044f\u0447\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456, \u0456 \u043d\u0430\u0432\u0430\u0442 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u043d\u044f\u045e\u0434\u0437\u044f\u0447\u043d\u044b\u044f \u0431\u0435\u0437 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043c\u0435\u0440\u044b, \u043d\u0435 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u043c \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u043b\u044e\u0431\u043e\u045e \u0456 \u043d\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u0435\u043c \u0432\u0435\u043b\u0456\u0447\u044b \u0430\u043a\u0430\u0437\u0430\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u045e, \u0430\u043b\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435\u043c \u0448\u0447\u043e\u0434\u0440\u044b\u043c \u0417\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0434\u043b\u044f \u043d\u0430\u0441 \u0442\u0430\u043a\u043e\u0433\u0430 \u0434\u0430\u0431\u0440\u0430 \u0456 \u044f\u043a \u0431\u044b \u0433\u0440\u044d\u0431\u0443\u0435\u043c \u0406\u043c; \u043d\u0430\u0432\u0430\u0442 \u042f\u0433\u043e \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e, \u043d\u0435 \u043d\u0430\u0442\u0445\u043d\u044f\u0435 \u043d\u0430\u0441 \u0443\u043b\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0456 \u0437\u0432\u044b\u0447\u0430\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0433\u0430 \u043d\u0430\u043a\u0430\u0437\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0432\u0430\u0440\u0442\u0430 \u0437\u0430\u043f\u0456\u0441\u0430\u0446\u044c \u0433\u044d\u0442\u0430 \u0434\u043b\u044f \u0456\u043d\u0448\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u043d\u0430 \u0432\u0435\u0447\u043d\u0443\u044e \u043f\u0430\u043c\u044f\u0446\u044c, \u043a\u0430\u0431 \u0443\u0441\u0435, \u0445\u0442\u043e \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0456\u043c\u0435\u043c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e, \u043f\u0440\u044b\u0437\u043d\u0430\u044e\u0447\u044b \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430 \u0434\u0430 \u043d\u0430\u0441, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0456 \u042f\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 68 (67), 27; 96 (95), 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043b\u0430\u045e\u0446\u0435 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0441\u0445\u043e\u0434\u0437\u0435, <span style=\"color: #ff0000;\">*<\/span> \u0432\u044b, \u0445\u0442\u043e \u0437 \u0432\u044b\u0442\u043e\u043a\u0430\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0443 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e, \u0441\u043f\u044f\u0432\u0430\u0439 \u041f\u0430\u043d\u0443, \u0443\u0441\u044f \u0437\u044f\u043c\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b, \u0445\u0442\u043e \u0437 \u0432\u044b\u0442\u043e\u043a\u0430\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"37","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u043c \u0441\u0432\u0435\u0446\u0435 <br \/>&laquo;Gaudium et spes&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 18. 22)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0422\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0441\u043c\u0435\u0440\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u043b\u0451\u0441\u0443 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0441\u043c\u0435\u0440\u0446\u0456. \u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043c\u0443\u0447\u0430\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043a\u0443\u0442\u044b \u0456 \u0431\u0443\u0434\u0443\u0447\u0430\u0435 \u0442\u043b\u0435\u043d\u043d\u0435 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u045e \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u0441\u0442\u0440\u0430\u0445 \u0437\u043d\u0456\u043a\u043d\u0443\u0446\u044c \u043d\u0430\u0437\u0430\u045e\u0436\u0434\u044b. \u042f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0456\u043d\u0441\u0442\u044b\u043d\u043a\u0442\u044b\u045e\u043d\u0430 \u0440\u043e\u0431\u0456\u0446\u044c \u0441\u043b\u0443\u0448\u043d\u044b \u0432\u044b\u0431\u0430\u0440, \u0430\u0434\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u0436\u0430\u0445\u043b\u0456\u0432\u0430\u0435 \u043f\u043e\u045e\u043d\u0430\u0435 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435 \u0456 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0435 \u0437\u043d\u0456\u043a\u043d\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0451\u0439 \u0430\u0441\u043e\u0431\u044b. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0441\u0435\u043d\u043d\u0435 \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456, \u044f\u043a\u043e\u0435 \u043d\u043e\u0441\u0456\u0446\u044c \u0443 \u0441\u0430\u0431\u0435, \u043d\u0435\u043b\u044c\u0433\u0430 \u0437\u0432\u0435\u0441\u0446\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430 \u043c\u0430\u0442\u044d\u0440\u044b\u0456, \u044f\u043d\u043e \u043f\u0430\u045e\u0441\u0442\u0430\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u0456. \u0423\u0441\u0435 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0442\u044d\u0445\u043d\u0456\u043a\u0456, \u0445\u043e\u0446\u044c \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u044f, \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0441\u0443\u043d\u044f\u0446\u044c \u043d\u0435\u043f\u0430\u043a\u043e\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430: \u043f\u0430\u0434\u0430\u045e\u0436\u044d\u043d\u043d\u0435 \u0431\u0456\u044f\u043b\u0430\u0433\u0456\u0447\u043d\u0430\u0433\u0430 \u0434\u0430\u045e\u0433\u0430\u043b\u0435\u0446\u0446\u044f \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0456\u0446\u044c \u043f\u0440\u0430\u0433\u0456 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u0435 \u043d\u0435\u043f\u0430\u0437\u0431\u044b\u045e\u043d\u0430 \u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u045e \u0441\u044d\u0440\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e \u043c\u0430\u0440\u043d\u044b\u044f \u045e\u0441\u0435 \u0444\u0430\u043d\u0442\u0430\u0437\u0456\u0456, \u0430\u0434\u043d\u0430\u043a \u041a\u0430\u0441\u0446\u0451\u043b, \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b \u0411\u043e\u0436\u044b\u043c \u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435\u043c, \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u044b\u045e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c \u0434\u043b\u044f \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0439 \u043c\u044d\u0442\u044b \u043f\u0430-\u0437\u0430 \u043c\u0435\u0436\u0430\u043c\u0456 \u0437\u044f\u043c\u043d\u043e\u0439 \u043d\u044f\u0434\u043e\u043b\u0456. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u044f \u0432\u0435\u0440\u0430 \u0432\u0443\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c, \u0430\u0434 \u044f\u043a\u043e\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u044b\u045e \u0431\u044b \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u045e, \u0431\u0443\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043d\u0430, \u043a\u0430\u043b\u0456 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0417\u0431\u0430\u045e\u0446\u0430 \u0432\u0435\u0440\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0441\u0442\u0440\u0430\u0447\u0430\u043d\u0430\u0435 \u0437 \u044f\u0433\u043e \u0432\u0456\u043d\u044b. \u0411\u043e\u0433 \u043a\u043b\u0456\u043a\u0430\u045e \u0456 \u043a\u043b\u0456\u0447\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430\u043b\u0443\u0447\u044b\u0446\u0446\u0430 \u0434\u0430 \u042f\u0433\u043e \u045e\u0441\u0451\u0439 \u0441\u0432\u0430\u0451\u0439 \u043d\u0430\u0442\u0443\u0440\u0430\u0439 \u0443 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0433\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0413\u044d\u0442\u0443\u044e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u0437\u0434\u0430\u0431\u044b\u045e \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u044b \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u0441\u0432\u0430\u0451\u044e \u0441\u043c\u0435\u0440\u0446\u044e \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456. \u0422\u0430\u043c\u0443 \u0432\u0435\u0440\u0430, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u0430\u044f \u043d\u0430 \u0441\u0430\u043b\u0456\u0434\u043d\u044b\u0445 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0430\u0445, \u0434\u0430\u0435 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0430\u0434\u043a\u0430\u0437 \u043d\u0430 \u044f\u0433\u043e \u0437\u0430\u043d\u0435\u043f\u0430\u043a\u043e\u0435\u043d\u0430\u0441\u0446\u044c \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u043b\u0451\u0441\u0430\u043c. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u044f\u043d\u0430 \u0434\u0430\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u043c\u0435\u0446\u044c \u0437\u043d\u043e\u0441\u0456\u043d\u044b \u0437 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u043c\u0456 \u0431\u0440\u0430\u0442\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u0443\u0436\u043e \u0437\u0430\u0431\u0440\u0430\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0434\u0430\u044e\u0447\u044b \u043d\u0430\u0434\u0437\u0435\u044e, \u0448\u0442\u043e \u044f\u043d\u044b \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u045e \u0411\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430\u043c \u0431\u0435\u0437\u0443\u043c\u043e\u045e\u043d\u0430 \u043a\u0456\u0440\u0443\u0435 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0437\u043b\u0430, \u0437\u0430\u0437\u043d\u0430\u044e\u0447\u044b \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043c\u0435\u0440\u0446\u044c. \u0410\u043b\u0435 \u0434\u0430\u043b\u0443\u0447\u0430\u043d\u044b \u0434\u0430 \u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0435\u043d\u044b \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456, \u0451\u043d, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b \u043d\u0430\u0434\u0437\u0435\u044f\u0439, \u0434\u043e\u0439\u0434\u0437\u0435 \u0434\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e, \u0430\u043b\u0435 \u0456 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456, \u0443 \u0447\u044b\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445 \u043d\u044f\u0431\u0430\u0447\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u043b\u0430\u0441\u043a\u0430. \u0411\u043e \u043a\u0430\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0456\u0445 \u0456 \u043a\u0430\u043b\u0456 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0430\u0434\u043d\u043e, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0431\u043e\u0441\u043a\u0430\u0435, \u0442\u0430\u0434\u044b \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u044b\u0437\u043d\u0430\u0446\u044c, \u0448\u0442\u043e \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0434\u0430\u0435 \u045e\u0441\u0456\u043c \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0434\u0430\u043b\u0443\u0447\u044b\u0446\u0446\u0430 \u0434\u0430 \u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0432\u044f\u0434\u043e\u043c\u044b\u043c \u0411\u043e\u0433\u0443 \u0447\u044b\u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0430\u044f \u0456 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0430\u044f \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u043c \u043f\u0440\u0430\u0437 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0435 \u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435. \u0417\u043d\u0430\u0447\u044b\u0446\u044c, \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0437\u0430\u0433\u0430\u0434\u043a\u0430 \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u0456 \u0441\u043c\u0435\u0440\u0446\u0456, \u044f\u043a\u0430\u044f \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0435 \u043d\u0430\u0441 \u043f\u0430-\u0437\u0430 \u042f\u0433\u043e\u043d\u044b\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435\u043c. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u044e \u0437\u043d\u0456\u0448\u0447\u044b\u045e\u0448\u044b \u0441\u043c\u0435\u0440\u0446\u044c, \u0456 \u0448\u0447\u043e\u0434\u0440\u0430 \u0430\u0434\u0430\u0440\u044b\u045e \u043d\u0430\u0441 \u0436\u044b\u0446\u0446\u0451\u043c, \u043a\u0430\u0431 \u043c\u044b, \u044f\u043a \u0441\u044b\u043d\u044b \u045e \u0421\u044b\u043d\u0435, \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u045e \u0414\u0443\u0445\u0443: &laquo;\u0410\u0431\u0431\u0430, \u041e\u0439\u0447\u0430!&raquo;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 27 (26), 1; 23 (22), 4ab<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d &ndash; \u043c\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u043c\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435: \u043a\u0430\u0433\u043e \u0436 \u043c\u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430? <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u043d &ndash; \u0430\u0445\u043e\u0432\u0430 \u0436\u044b\u0446\u0446\u044f \u043c\u0430\u0439\u0433\u043e: \u043a\u0430\u0433\u043e \u0436 \u043c\u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0446\u0446\u0430? <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u043f\u0430\u0439\u0434\u0443 \u0434\u0430\u043b\u0456\u043d\u0430\u0439 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0446\u0435\u043d\u044e, \u043d\u0435 \u0431\u0443\u0434\u0443 \u0431\u0430\u044f\u0446\u0446\u0430 \u0437\u043b\u0430, \u0431\u043e \u0422\u044b \u0441\u0430 \u043c\u043d\u043e\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d &ndash; \u0430\u0445\u043e\u0432\u0430 \u0436\u044b\u0446\u0446\u044f \u043c\u0430\u0439\u0433\u043e: \u043a\u0430\u0433\u043e \u0436 \u043c\u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0446\u0446\u0430?<\/p>\r\n"}, {"GCH_CH_2_ID":"41","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0434\u0430 \u0421\u043c\u0456\u0440\u043d\u0446\u0430\u045e \u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Inscriptio; nn. 1,1 &ndash; 4, 1: Funk 1, 235-237)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043a\u043b\u0456\u0447\u0430 \u043d\u0430\u0441 \u0443 \u0441\u0432\u0430\u0451 \u0441\u043b\u0430\u045e\u043d\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0406\u0433\u043d\u0430\u0446\u044b\u0439, \u043d\u0430\u0437\u044b\u0432\u0430\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0422\u044d\u0430\u0444\u0430\u043d\u0430\u043c, \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041a\u0430\u0441\u0446\u0451\u043b\u0443, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0434\u0430\u0440\u044b \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u043f\u043e\u045e\u043d\u0430\u043c\u0443 \u0432\u0435\u0440\u044b \u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u0430\u0434\u043e\u0440\u0430\u043d\u0430\u043c\u0443 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u043c\u0456 \u043b\u0430\u0441\u043a\u0430\u043c\u0456, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0430\u043c \u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0447\u0430\u043c\u0443. \u041a\u0430\u0441\u0446\u0451\u043b\u0443, \u044f\u043a\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0421\u043c\u0456\u0440\u043d\u0435, \u0448\u0442\u043e \u045e \u0410\u0437\u0456\u0456, \u0448\u0447\u044b\u0440\u0430\u0435 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435 \u045e \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c \u0434\u0443\u0445\u0443 \u0456 \u0411\u043e\u0436\u044b\u043c \u0441\u043b\u043e\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u0432\u0430\u0441 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e. \u0411\u043e \u045e\u0431\u0430\u0447\u044b\u045e \u044f, \u0448\u0442\u043e \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456 \u045e \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u0439 \u0432\u0435\u0440\u044b, \u043d\u0456\u0431\u044b \u043f\u0440\u044b\u0431\u0456\u0442\u044b\u044f \u0434\u0443\u0448\u043e\u0439 \u0456 \u0446\u0435\u043b\u0430\u043c \u0434\u0430 \u043a\u0440\u044b\u0436\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0443\u044e \u043a\u0440\u043e\u045e, \u043f\u043e\u045e\u043d\u044b\u044f \u043c\u043e\u0446\u043d\u0430\u0439 \u0432\u0435\u0440\u044b \u045e \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 &laquo;\u0446\u0435\u043b\u0430\u043c \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u0440\u043e\u0434\u0443 \u0414\u0430\u0432\u0456\u0434\u0430&raquo; (\u0420\u044b\u043c 1, 3), \u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f \u0456 \u043c\u043e\u0446\u044b \u0411\u043e\u0436\u0430\u0439, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0437 \u0414\u0437\u0435\u0432\u044b, \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u0430\u0433\u0430 \u042f\u043d\u0430\u043c \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u0435\u043c, \u043a\u0430\u0431 &laquo;\u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430&raquo; (\u041c\u0446 3, 15); \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0437\u0430 \u043d\u0430\u0441 \u043f\u0440\u044b \u041f\u043e\u043d\u0446\u0456\u0456 \u041f\u0456\u043b\u0430\u0446\u0435 \u0456 \u0442\u044d\u0442\u0440\u0430\u0440\u0445\u0443 \u0406\u0440\u0430\u0434\u0437\u0435 (\u043c\u044b \u0436 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u043f\u043b\u0451\u043d\u0430\u043c \u0433\u044d\u0442\u0430\u0439 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0439 \u042f\u0433\u043e \u043c\u0443\u043a\u0456), \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u043d\u0435\u0441\u0446\u0456 \u0441\u0446\u044f\u0433 \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u0432\u0435\u0440\u043d\u044b\u0445, \u0446\u0456 \u0442\u043e \u0437 \u044e\u0434\u044d\u044f\u045e, \u0446\u0456 \u0442\u043e \u0437 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0443 \u0430\u0434\u043d\u044b\u043c \u0446\u0435\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u0436 \u0433\u044d\u0442\u0430 \u0401\u043d \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u0434\u043b\u044f \u043d\u0430\u0441, \u043a\u0430\u0431 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0401\u043d \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0446\u044f\u0440\u043f\u0435\u045e, \u043a\u0430\u0431 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0436 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u043f\u0430\u0441\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0401\u043d \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u045e \u0446\u0435\u043b\u0435, \u0456 \u043c\u043e\u0446\u043d\u0430 \u0432\u0435\u0440\u0443, \u0448\u0442\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u0446\u0435\u043b\u0435 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0430\u0436 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c. \u041a\u0430\u043b\u0456 \u0436 \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u041f\u044f\u0442\u0440\u0443 \u0456 \u044f\u0433\u043e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u0434\u044b\u0434\u0437\u0456\u0446\u0435, \u0434\u0430\u043a\u0440\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u0456 \u045e\u0431\u0430\u0447\u0446\u0435, \u0448\u0442\u043e \u042f \u043c\u0430\u044e \u0446\u0435\u043b\u0430&raquo; (\u043f\u0430\u0440. \u041b\u043a 24, 39). \u0406 \u044f\u043d\u044b \u0442\u0443\u0442 \u0436\u0430 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u042f\u0433\u043e, \u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0440\u044d\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u042f\u0433\u043e \u0446\u0435\u043b\u0430 \u0456 \u0434\u0443\u0445\u0430. \u0422\u0430\u043c\u0443 \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u043b\u0456 \u045e\u0436\u043e \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043d\u0430\u0434 \u0451\u0439 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443. \u041f\u0430\u0441\u043b\u044f \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0401\u043d \u0435\u045e \u0437 \u0456\u043c\u0456 \u0456 \u043f\u0456\u045e \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0445\u043e\u0446\u044c \u0434\u0443\u0445\u0430\u043c \u0431\u044b\u045e \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b \u0437 \u0410\u0439\u0446\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u044e \u0432\u0430\u043c, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0445\u043e\u0446\u044c \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a\u043e\u0439 \u0451\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u044f \u0432\u0435\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0430\u043b 2, 19. 20<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043f\u0430\u043c\u0451\u0440 \u0434\u043b\u044f \u0417\u0430\u043a\u043e\u043d\u0443, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0433\u0430. \u0410 \u0448\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u0436\u044b\u0432\u0443 \u045e \u0446\u0435\u043b\u0435, \u0442\u043e \u0436\u044b\u0432\u0443 \u0432\u0435\u0440\u0430\u044e \u045e \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043c\u044f\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u0406 \u045e\u0436\u043e \u043d\u0435 \u044f \u0436\u044b\u0432\u0443, \u0430 \u0436\u044b\u0432\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043c\u044f\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"42","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0413\u0456\u043b\u044f\u0440\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 132: PLS 1, 244-245)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0423\u0441\u0435 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u0431\u044b\u043b\u0456 \u0430\u0434\u0437\u0456\u043d\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0434\u0443\u0448\u043e\u044e <\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u042f\u043a \u0436\u0430 \u0434\u043e\u0431\u0440\u0430 \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430, \u043a\u0430\u043b\u0456 \u0431\u0440\u0430\u0442\u044b \u0436\u044b\u0432\u0443\u0446\u044c \u0440\u0430\u0437\u0430\u043c&raquo; (\u041f\u0441 133 [132], 1). \u0414\u043e\u0431\u0440\u0430 \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430, \u043a\u0430\u043b\u0456 \u0431\u0440\u0430\u0442\u044b \u0436\u044b\u0432\u0443\u0446\u044c \u0443 \u0437\u0433\u043e\u0434\u0437\u0435, \u0431\u043e \u0436\u044b\u0432\u0443\u0447\u044b \u0440\u0430\u0437\u0430\u043c, \u0441\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u042f\u043d\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u0446\u0430 \u0431\u0440\u0430\u0442\u0430\u043c\u0456, \u0431\u043e \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u043c\u0430\u044e\u0446\u044c \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u044b\u044f \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u0435 \u045e\u0437\u043d\u0451\u0441\u043b\u0430\u0435 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435 \u043c\u0435\u043b\u0430 \u043c\u0435\u0441\u0446\u0430 \u043d\u0430 \u0441\u0430\u043c\u044b\u043c \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f. \u0411\u043e \u0447\u044b\u0442\u0430\u0435\u043c: &laquo;\u0423\u0441\u0435 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u0431\u044b\u043b\u0456 \u0430\u0434\u0437\u0456\u043d\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0434\u0443\u0448\u043e\u044e&raquo; (\u0414\u0437 4, 32). \u041d\u0430\u043b\u0435\u0436\u044b\u0446\u044c, \u043a\u0430\u0431 \u043d\u0430\u0440\u043e\u0434 \u0411\u043e\u0436\u044b \u0430\u0434\u0447\u0443\u0432\u0430\u045e \u0441\u044f\u0431\u0435 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u0410\u0439\u0446\u0430, \u0441\u0442\u0432\u0430\u0440\u0430\u045e \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430 \u045e \u0430\u0434\u043d\u044b\u043c \u0414\u0443\u0445\u0443, \u0436\u044b\u045e \u0440\u0430\u0437\u0430\u043c \u0443 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0441\u0442\u0432\u0435, \u0441\u043a\u043b\u0430\u0434\u0430\u045e \u0447\u043b\u0435\u043d\u044b \u0430\u0434\u043d\u0430\u0433\u043e \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043e\u0431\u0440\u0430 \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430, \u043a\u0430\u043b\u0456 \u0431\u0440\u0430\u0442\u044b \u0436\u044b\u0432\u0443\u0446\u044c \u0440\u0430\u0437\u0430\u043c. \u041f\u0440\u0430\u0440\u043e\u043a \u0434\u0430\u0435 \u0433\u044d\u0442\u0430\u043c\u0443 \u0442\u0430\u043a\u043e\u0435 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0435: &laquo;\u0413\u044d\u0442\u0430 \u044f\u043a \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b \u0430\u043b\u0435\u0439 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0435, \u044f\u043a\u0456 \u0441\u0446\u044f\u043a\u0430\u0435 \u043d\u0430 \u0431\u0430\u0440\u0430\u0434\u0443, \u043d\u0430 \u0431\u0430\u0440\u0430\u0434\u0443 \u0410\u0430\u0440\u043e\u043d\u0430, \u0448\u0442\u043e \u0441\u0446\u044f\u043a\u0430\u0435 \u0434\u0430 \u043a\u0440\u0430\u0451\u045e \u044f\u0433\u043e\u043d\u044b\u0445 \u0448\u0430\u0442\u0430\u045e&raquo; (\u041f\u0441 133 [132], 2). \u0410\u043b\u0435\u0439, \u044f\u043a\u0456\u043c \u0410\u0430\u0440\u043e\u043d \u0431\u044b\u045e \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u043d\u044b \u043d\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u0437\u043c\u044f\u0448\u0447\u0430\u045e \u0448\u043c\u0430\u0442 \u0434\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044f\u045e. \u0421\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0411\u043e\u0433\u0443 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0430\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0432\u044f\u0442\u0430\u0440\u0430. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043d\u0430\u0448 \u041f\u0430\u043d \u0431\u044b\u045e \u0434\u0443\u0445\u043e\u045e\u043d\u0430 \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u043d\u044b &laquo;\u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0441\u0432\u0430\u0456\u0445&raquo; (\u043f\u0430\u0440. \u041f\u0441 45 [44], 8). \u0413\u044d\u0442\u0430 \u043d\u0435 \u0437\u044f\u043c\u043d\u043e\u0435 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435; \u043d\u0435 \u0430\u043b\u0435\u0435\u043c \u0437 \u0440\u043e\u0433\u0443, \u044f\u043a \u0443 \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u0430\u043b\u0435 &laquo;\u0430\u043b\u0435\u0435\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u0456&raquo; (\u041f\u0441 45 [44], 8). \u041f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u044f \u0410\u0430\u0440\u043e\u043d \u043f\u0430 \u043f\u0440\u0430\u0432\u0443 \u043d\u0430\u0441\u0456\u045e \u0456\u043c\u044f &laquo;\u043d\u0430\u043c\u0430\u0448\u0447\u0430\u043d\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435 \u0430\u043b\u0435\u0435\u043c \u0432\u044b\u0433\u0430\u043d\u044f\u0435 \u0430\u0434\u0443\u0441\u044e\u043b\u044c \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u044f \u043f\u0430\u0432\u0435\u0432\u044b \u0441\u044d\u0440\u0446\u0430, \u0442\u0430\u043a \u0456 \u043f\u0440\u0430\u0437 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435 \u043b\u044e\u0431\u043e\u045e\u044e \u043c\u044b \u0434\u0430\u0435\u043c \u043f\u0440\u044b\u0435\u043c\u043d\u044b \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u0432\u043e\u0434\u0430\u0440 \u0437\u0433\u043e\u0434\u044b, \u044f\u043a \u043a\u0430\u0437\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u041c\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b \u0432\u043e\u0434\u0430\u0440 \u0434\u043b\u044f \u0411\u043e\u0433\u0430&raquo; (2 \u041a\u0430\u0440 2, 15). \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u0456\u043b\u044b\u043c \u0431\u044b\u045e \u0411\u043e\u0433\u0443 \u0430\u043b\u0435\u0439, \u044f\u043a\u0456\u043c \u0431\u044b\u045e \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u043d\u044b \u043f\u0435\u0440\u0448\u044b \u0441\u0432\u044f\u0442\u0430\u0440, \u0410\u0430\u0440\u043e\u043d, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043e\u0431\u0440\u0430 \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430, \u043a\u0430\u043b\u0456 \u0431\u0440\u0430\u0442\u044b \u0436\u044b\u0432\u0443\u0446\u044c \u0440\u0430\u0437\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435\u0439 \u0441\u043f\u043b\u044b\u0432\u0430\u0435 \u0437 \u0433\u0430\u043b\u0430\u0432\u044b \u043d\u0430 \u0431\u0430\u0440\u0430\u0434\u0443. \u0410 \u0431\u0430\u0440\u0430\u0434\u0430 &ndash; \u0433\u044d\u0442\u0430 \u045e\u043f\u0440\u044b\u0433\u0430\u0436\u044d\u043d\u043d\u0435 \u0441\u0442\u0430\u043b\u0430\u0433\u0430 \u043c\u0443\u0436\u0447\u044b\u043d\u044b. \u0422\u0430\u043c\u0443 \u043c\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043d\u0435\u043f\u0430\u045e\u043d\u0430\u043b\u0435\u0442\u043d\u0456\u043c\u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u043c\u043e\u0436\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 &ndash; \u044f\u043a \u043a\u0430\u0436\u0443\u0446\u044c &ndash; \u043d\u0435\u043f\u0430\u045e\u043d\u0430\u043b\u0435\u0442\u043d\u0456\u043c\u0456 \u045e \u0434\u0440\u044d\u043d\u043d\u044b\u043c, \u0430\u043b\u0435 \u0441\u0442\u0430\u043b\u044b\u043c\u0456 \u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u0423\u0441\u0456\u0445 \u043d\u044f\u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u043d\u0435\u043f\u0430\u045e\u043d\u0430\u043b\u0435\u0442\u043d\u0456\u043c\u0456, \u0431\u043e \u044f\u043d\u044b \u0437\u0430\u0441\u043b\u0430\u0431\u044b\u044f \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0446\u0432\u0451\u0440\u0434\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a, \u0431\u043e \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0446\u044c \u043c\u0430\u043b\u0430\u043a\u0430. \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0442\u0430\u043a \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043a\u0430\u0436\u0430: &laquo;\u042f \u043a\u0430\u0440\u043c\u0456\u045e \u0432\u0430\u0441 \u043c\u0430\u043b\u0430\u043a\u043e\u043c, \u0430 \u043d\u0435 \u0446\u0432\u0451\u0440\u0434\u0430\u0439 \u0435\u0436\u0430\u0439, \u0431\u043e \u0432\u044b \u044f\u0448\u0447\u044d \u0431\u044b\u043b\u0456 \u0441\u043b\u0430\u0431\u044b\u044f, \u0434\u044b \u0456 \u0446\u044f\u043f\u0435\u0440 \u044f\u0448\u0447\u044d \u043d\u044f\u0434\u0443\u0436\u044b\u044f&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 3, 2).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 12, 5; \u042d\u0444 4, 7; 1 \u041a\u0430\u0440 12, 13<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b, \u043c\u043d\u043e\u0433\u0456\u044f, \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u043c \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0430 \u043f\u0430\u0430\u0441\u043e\u0431\u043a\u0443 \u0430\u0434\u0437\u0456\u043d \u0434\u043b\u044f \u0430\u0434\u043d\u0430\u0433\u043e &ndash; \u0447\u043b\u0435\u043d\u044b. <span style=\"color: #ff0000;\">*<\/span> \u041a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437 \u043d\u0430\u0441 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043b\u0430\u0441\u043a\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0434\u0430\u0440\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u0435 \u043c\u044b \u045e \u0430\u0434\u043d\u044b\u043c \u0414\u0443\u0445\u0443 \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u044f \u0456 \u045e\u0441\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u044f \u0430\u0434\u043d\u044b\u043c \u0414\u0443\u0445\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437 \u043d\u0430\u0441 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043b\u0430\u0441\u043a\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0434\u0430\u0440\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"43","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u044f\u045e&raquo; \u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 3, 19, 1. 3 &ndash; 20, 1: SCh 34, 332. 336-338)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u044f\u043a \u043f\u0435\u0440\u0448\u044b \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c. \u0421\u044b\u043d \u0411\u043e\u0433\u0430 \u0441\u0442\u0430\u045e \u0421\u044b\u043d\u0430\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b \u0437 \u0411\u043e\u0436\u044b\u043c \u0421\u043b\u043e\u0432\u0430\u043c \u0456 \u045e\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u044b, \u0441\u0442\u0430\u045e \u0411\u043e\u0436\u044b\u043c \u0434\u0437\u0456\u0446\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0456\u043d\u0430\u043a\u0448 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0456 \u043d\u0435\u0441\u044f\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u0437 \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u044e \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044e. \u0410\u0434\u043d\u0430\u043a, \u0446\u0456 \u0437\u043c\u0430\u0433\u043b\u0456 \u0431 \u043c\u044b \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0442\u0430\u043a\u043e\u0433\u0430 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u044f, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u0441\u0442\u0430\u043b\u0430 \u0442\u044b\u043c, \u0447\u044b\u043c \u043c\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f, \u043a\u0430\u0431 \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u044c, \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435, \u043a\u0430\u0431 \u043c\u044b \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044b\u043d \u0411\u043e\u0436\u044b, \u043d\u0430\u0448 \u041f\u0430\u043d, \u0421\u043b\u043e\u0432\u0430 \u0410\u0439\u0446\u0430, \u0441\u0442\u0430\u045e \u0421\u044b\u043d\u0430\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u042f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u041c\u0430\u0440\u044b\u0456, \u044f\u043a\u0430\u044f \u0431\u044b\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u0437\u043d\u0430\u043a \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u045e\u043d\u0456\u0437\u0435 \u0456 \u0432\u044b\u0441\u043e\u043a\u0430 \u045e\u0433\u0430\u0440\u044b. \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043f\u0440\u0430\u0441\u0456\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0437\u043d\u0430\u043a\u0443, \u0431\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0434\u0443\u043c\u0430\u045e, \u0448\u0442\u043e \u0434\u0437\u0435\u0432\u0430 \u043c\u043e\u0436\u0430 \u0441\u0442\u0430\u0446\u044c \u043c\u0430\u0446\u0456-\u0434\u0437\u0435\u0432\u0430\u0439 \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u044c \u0441\u044b\u043d\u0430. \u041d\u0435 \u0434\u0443\u043c\u0430\u045e, \u0448\u0442\u043e \u0433\u044d\u0442\u044b \u0421\u044b\u043d, &laquo;\u0411\u043e\u0433 \u0437 \u043d\u0430\u043c\u0456&raquo;, \u0441\u044b\u0434\u0437\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u0448\u0443\u043a\u0430\u0446\u044c \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0443\u044e \u0430\u0432\u0435\u0447\u043a\u0443 (\u0430 \u0431\u044b\u043b\u0430 \u044f\u043d\u0430 \u042f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c), \u043d\u0435 \u0434\u0443\u043c\u0430\u045e, \u0448\u0442\u043e \u045e\u0437\u044b\u0434\u0437\u0435 \u043d\u0430 \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0456 \u0434\u0430\u0440\u0443\u0447\u044b\u0446\u044c \u0410\u0439\u0446\u0443 \u0430\u0434\u0448\u0443\u043a\u0430\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u045e \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435 \u044f\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435. \u042f\u043a \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441-\u0413\u0430\u043b\u0430\u0432\u0430, \u0442\u0430\u043a \u0436\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0435 \u0440\u044d\u0448\u0442\u0430 \u0446\u0435\u043b\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443\u0441\u0435 \u043b\u044e\u0434\u0437\u0456, \u043a\u0430\u043b\u0456 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0447\u0430\u0441 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0437\u0430 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u043c \u043f\u043e\u0432\u044f\u0437\u044f\u043c \u0433\u044d\u0442\u0430\u0435 \u0446\u0435\u043b\u0430 \u0437&rsquo;\u044f\u0434\u043d\u0430\u0435\u0446\u0446\u0430 \u0456 \u045e\u043c\u0430\u0446\u0443\u0435\u0446\u0446\u0430 \u0411\u043e\u0436\u044b\u043c \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0435\u043c, \u0430 \u045e\u0441\u0435 \u0447\u043b\u0435\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0451 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 \u045e \u0446\u0435\u043b\u0435. \u0423 \u0410\u0439\u0446\u0430 \u0448\u043c\u0430\u0442 \u043f\u0430\u043c\u044f\u0448\u043a\u0430\u043d\u043d\u044f\u045e, \u0431\u043e \u0448\u043c\u0430\u0442 \u0451\u0441\u0446\u044c \u0447\u043b\u0435\u043d\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u044b\u043c \u0430\u043a\u0430\u0437\u0430\u045e\u0441\u044f \u0411\u043e\u0433, \u044f\u043a\u0456, \u0431\u0430\u0447\u0430\u0447\u044b \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u044f\u043c\u0443 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443, \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u0443\u044e \u0421\u043b\u043e\u0432\u0430\u043c. \u0411\u043e, \u043a\u0430\u043b\u0456 \u043c\u043e\u0446 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u043b\u0430\u0441\u044f \u043f\u0440\u0430\u0437 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c, \u0421\u043b\u043e\u0432\u0430 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u042f\u0433\u043e \u0432\u0435\u043b\u0456\u0447\u043d\u0443\u044e \u043c\u043e\u0446.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 15, 20. 22. 21<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u041f\u0435\u0440\u0448\u044b\u043d\u0435\u0446 \u0441\u044f\u0440\u043e\u0434 \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e, \u044f\u043a \u0443 \u0410\u0434\u0430\u043c\u0435 \u045e\u0441\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0446\u044c, \u0442\u0430\u043a \u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u045e\u0441\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0442\u0430\u043a \u043f\u0440\u0430\u0437 \u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0430 &ndash; \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e, \u044f\u043a \u0443 \u0410\u0434\u0430\u043c\u0435 \u045e\u0441\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0446\u044c, \u0442\u0430\u043a \u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u045e\u0441\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"44","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0432\u043e\u0440 &laquo;\u041f\u0440\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c&raquo; \u0414\u0437\u0456\u044f\u0434\u043e\u0445\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0424\u043e\u0442\u044b\u043a\u0456<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 6. 26. 27. 30: PG 65, 1169. 1175-1176)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0423\u043c\u0435\u043d\u043d\u0435 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0434\u0443\u0445\u0430\u045e \u0434\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u044b\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">C\u0432\u044f\u0442\u043b\u043e\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u043c\u0435\u043d\u043d\u0435 \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u0430 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u0456 \u0437\u043b\u043e. \u041a\u0430\u043b\u0456 \u0442\u0430\u043a \u0451\u0441\u0446\u044c, \u0442\u0430\u0434\u044b \u0448\u043b\u044f\u0445 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0411\u043e\u0433\u0430, \u0421\u043e\u043d\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0443\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0440\u043e\u0437\u0443\u043c, \u044f\u043a\u0456 \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0448\u0443\u043a\u0430\u0435 \u043b\u044e\u0431\u043e\u0432\u0456, \u0443 \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0432\u0435\u0434\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u0437\u043c\u0430\u0433\u0430\u044e\u0446\u0446\u0430, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043a\u043b\u0430\u043f\u043e\u0446\u044f\u0446\u0446\u0430 \u043f\u0440\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0430\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u044e, \u043a\u0430\u0431 \u0440\u043e\u0437\u0443\u043c, \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u0430 \u0430\u0446\u044d\u043d\u044c\u0432\u0430\u044e\u0447\u044b \u045e\u0437\u043d\u0456\u043a\u0430\u044e\u0447\u044b\u044f \u045e \u0456\u043c \u0434\u0443\u043c\u043a\u0456, \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0437\u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u0434\u043e\u0431\u0440\u044b\u044f, \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u044b\u044f \u0411\u043e\u0433\u0430\u043c, \u0430 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u0456 \u0442\u044b\u044f, \u0448\u0442\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0434 \u0441\u0430\u0442\u0430\u043d\u044b, \u0430\u0434\u043a\u0456\u0434\u0432\u0430\u045e \u0430\u0434 \u0441\u044f\u0431\u0435. \u0411\u043e \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430\u0435 \u043c\u043e\u0440\u0430 &ndash; \u043f\u0440\u0430\u0437\u0440\u044b\u0441\u0442\u0430\u0435, \u0456 \u0440\u044b\u0431\u0430\u043a\u0456 \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0440\u044b\u0431. \u0423\u0441\u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043d\u0430\u0435 \u0431\u0443\u0440\u0430\u0439, \u0445\u0430\u0432\u0430\u0435 \u045e \u0431\u0443\u0440\u043b\u0456\u0432\u044b\u0445 \u0445\u0432\u0430\u043b\u044f\u0445 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b\u0445 \u0432\u043e\u0434\u0430\u0445 \u043c\u043e\u0436\u043d\u0430 \u043b\u0451\u0433\u043a\u0430 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c. \u0406 \u0442\u0430\u0434\u044b \u0434\u0430\u0440\u043c\u0430 \u043f\u0440\u0430\u0446\u0443\u044e\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u0437\u0430\u043a\u0456\u0434\u0432\u0430\u0435 \u0441\u0435\u0442\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u0435 \u0440\u043e\u0437\u0443\u043c\u0443 \u043c\u043e\u0436\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b. \u041f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u044b \u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430 \u0437\u043b\u043e\u0434\u0437\u0435\u044f, \u044f\u0433\u043e \u0437\u0434\u0430\u0431\u044b\u0447\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0432\u0435\u0440\u043d\u0443\u0442\u0430. \u0422\u0430\u043c\u0443 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u0435\u043c, \u043a\u0430\u0431 \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430 \u045e \u043d\u0430\u0441 \u043f\u0430\u043b\u0430\u043b\u0430 \u0441\u0432\u044f\u0442\u043b\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u041a\u0430\u043b\u0456 \u044f\u043d\u043e \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0440\u043e\u0437\u0443\u043c\u0443, \u0442\u0430\u0434\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430 \u0447\u044d\u0437\u043d\u0443\u0446\u044c \u0437\u043c\u0440\u043e\u0447\u043d\u044b\u044f \u0456 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u044b\u044f \u043f\u0430\u0441\u0442\u043a\u0456 \u0441\u0430\u0442\u0430\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: &laquo;\u0414\u0443\u0445\u0430 \u043d\u0435 \u0433\u0430\u0441\u0456\u0446\u0435&raquo; (1 \u0422\u044d\u0441 5, 19). \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u0435 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u0439\u0446\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0434\u0440\u044d\u043d\u043d\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0456 \u0437\u043b\u044b\u043c\u0456 \u0434\u0443\u043c\u043a\u0430\u043c\u0456, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u045e \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0446\u044c \u0432\u0430\u0441 \u0441\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c. \u041d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u0433\u044d\u0442\u0430 \u043d\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0432\u0435\u0447\u043d\u0430\u0435 \u0456 \u0436\u044b\u0432\u0430\u0442\u0432\u043e\u0440\u043d\u0430\u0435, \u0430\u043b\u0435 \u042f\u0433\u043e \u0437\u0430\u0441\u043c\u0443\u0447\u044d\u043d\u043d\u0435, \u0430 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0435\u0439 \u0430\u0434\u0434\u0430\u043b\u0435\u043d\u043d\u0435, \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u0440\u043e\u0437\u0443\u043c \u0441\u0432\u044f\u0442\u043b\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f, \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u044f\u0433\u043e \u045e \u0446\u0435\u043c\u0440\u044b \u0456 \u0437\u043c\u0440\u043e\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c &ndash; \u0433\u044d\u0442\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0441\u043c\u0430\u043a, \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u0430\u0446\u044d\u043d\u044c\u0432\u0430\u0435\u043c \u0441\u043f\u0440\u0430\u0432\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u042f\u043a \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0441\u043c\u0430\u043a\u0443 \u043c\u044b \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u0430 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0435\u043c, \u043a\u0430\u043b\u0456 \u043c\u0430\u0435\u043c \u0434\u043e\u0431\u0440\u0430\u0435 \u0437\u0434\u0430\u0440\u043e\u045e\u0435, \u0448\u0442\u043e \u0434\u043e\u0431\u0440\u0430\u0435, \u0430 \u0448\u0442\u043e \u0434\u0440\u044d\u043d\u043d\u0430\u0435, \u0456 \u0456\u043c\u043a\u043d\u0451\u043c\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435, \u0442\u0430\u043a \u0456 \u0440\u043e\u0437\u0443\u043c, \u043a\u0430\u043b\u0456 \u043c\u0430\u0435 \u043f\u043e\u045e\u043d\u0443\u044e \u0440\u0430\u045e\u043d\u0430\u0432\u0430\u0433\u0443 \u0456 \u0432\u043e\u043b\u044c\u043d\u044b \u0430\u0434 \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u044b\u0445 \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u045e, \u0437\u0434\u043e\u043b\u044c\u043d\u044b \u0430\u0434\u0447\u0443\u0446\u044c \u0411\u043e\u0436\u0430\u0435 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435. \u0417\u0434\u043e\u043b\u044c\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043e\u045e\u0433\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u044f\u0433\u043e \u0441\u043b\u043e\u0434\u044b\u0447 \u043f\u0440\u0430\u0437 \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456. \u0406\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0451\u043d \u0434\u0430 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u0445 \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430: &laquo;\u041c\u0430\u043b\u044e\u0441\u044f \u0430\u0431 \u0442\u044b\u043c, \u043a\u0430\u0431 \u043b\u044e\u0431\u043e\u045e \u0432\u0430\u0448\u0430\u044f \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043b\u0430 \u045e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456 \u0456 \u0432\u0430 \u045e\u0441\u044f\u043a\u0456\u043c \u0430\u0434\u0447\u0443\u0432\u0430\u043d\u043d\u0456, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043b\u0456 \u043b\u0435\u043f\u0448\u0430\u0435&raquo; (\u043f\u0430\u0440. \u0424\u043b\u043f 1, 9-10).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0422\u043e\u0431 4, 19\u0430; 14, 8b<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u045e \u043a\u043e\u0436\u043d\u044b \u0447\u0430\u0441 \u0456 \u043f\u0440\u0430\u0441\u0456 \u045e \u042f\u0433\u043e, \u043a\u0430\u0431 \u0448\u043b\u044f\u0445\u0456 \u0442\u0432\u0430\u0435 \u0431\u044b\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u0431 \u0443\u0441\u0435 \u043d\u0430\u043c\u0435\u0440\u044b \u0442\u0432\u0430\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u0441\u043f\u044f\u0445\u043e\u0432\u044b\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406\u043c\u043a\u043d\u0456\u0441\u044f \u0440\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u042f\u043c\u0443, \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0456 \u0437 \u0443\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0441\u0456\u043b\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0443\u0441\u0435 \u043d\u0430\u043c\u0435\u0440\u044b \u0442\u0432\u0430\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u0441\u043f\u044f\u0445\u043e\u0432\u044b\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"45","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0442\u044d\u0445\u0435\u0437\u0430 \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cat. 13, 1. 3. 6. 23: PG 33, 771-774. 779. 799.802)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041d\u044f\u0445\u0430\u0439 \u043a\u0440\u044b\u0436 \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u043d\u0430\u0432\u0430\u0442 \u043f\u0430\u0434\u0447\u0430\u0441 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b \u0447\u044b\u043d \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0445\u0432\u0430\u043b\u0443 \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443, \u0430\u043b\u0435 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0445\u0432\u0430\u043b\u0430 &ndash; \u043a\u0440\u044b\u0436. \u0420\u0430\u0437\u0443\u043c\u0435\u044e\u0447\u044b \u0433\u044d\u0442\u0443\u044e \u043f\u0440\u0430\u045e\u0434\u0443, \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430: &laquo;\u041d\u044f\u0445\u0430\u0439 \u044f \u043d\u0435 \u0431\u0443\u0434\u0443 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0456\u0447\u044b\u043c, \u0430\u043a\u0440\u0430\u043c\u044f \u043a\u0440\u044b\u0436\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430&raquo; (\u0413\u0430\u043b 6, 14).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u0431\u044b\u043b\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0430 \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u0430\u0433\u0430 \u0430\u0434 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0437\u0440\u043e\u043a \u0443 \u043a\u0443\u043f\u0430\u043b\u044c\u043d\u0456 \u0421\u0456\u043b\u043e\u044d. \u042f\u043a\u0443\u044e \u0436 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u043c\u0435\u043b\u0456 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u044b\u044f \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443? \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0456 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u043f\u0430\u0434\u0437\u0435\u044f\u0439 \u0431\u044b\u043b\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u041b\u0430\u0437\u0430\u0440\u0430, \u044f\u043a\u0456 \u0442\u0440\u044b \u0434\u043d\u0456 \u043b\u044f\u0436\u0430\u045e \u0443 \u043c\u0430\u0433\u0456\u043b\u0435. \u0410\u0434\u043d\u0430\u043a \u0433\u044d\u0442\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0442\u044b\u0447\u044b\u043b\u0430\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u0433\u043e. \u042f\u043a\u0430\u044f \u0436 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0434\u043b\u044f \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0437\u0430\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u045e \u0441\u043c\u0435\u0440\u0446\u0456 \u0433\u0440\u0430\u0445\u0443? \u0426\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0431\u044b\u043b\u043e \u0442\u043e\u0435, \u043a\u0430\u043b\u0456 \u043f\u044f\u0446\u0446\u044e \u0445\u043b\u044f\u0431\u0430\u043c\u0456, \u043d\u0456\u0431\u044b \u0437 \u043d\u0435\u0432\u044b\u0447\u044d\u0440\u043f\u043d\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u043d\u0430\u0441\u044b\u0446\u0456\u043b\u0430\u0441\u044f \u043f\u044f\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u043b\u044e\u0434\u0437\u0435\u0439. \u0410\u0434\u043d\u0430\u043a, \u0448\u0442\u043e \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u0433\u043e\u043b\u0430\u0434 \u0432\u0435\u0434\u0430\u045e? \u041d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u0431\u044b\u043b\u043e \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u044f\u043a\u0443\u044e \u0432\u0430\u0441\u044f\u043c\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e \u0437\u0432\u044f\u0437\u0432\u0430\u045e \u0441\u0430\u0442\u0430\u043d\u0430. \u0410\u043b\u0435 \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u045e \u0430\u0434\u043d\u043e\u0441\u0456\u043d\u0430\u0445 \u0434\u0430 \u043d\u0430\u0441 \u0443\u0441\u0456\u0445, \u0437\u0432\u044f\u0437\u0430\u043d\u044b\u0445 \u0432\u0443\u0437\u043b\u0430\u043c\u0456 \u0433\u0440\u0430\u0445\u0443?<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u043e\u0441\u044c \u0445\u0432\u0430\u043b\u0430 \u043a\u0440\u044b\u0436\u0430 \u0437\u0430\u044f\u0441\u043d\u0435\u043b\u0430 \u043d\u0430\u0434 \u0442\u044b\u043c\u0456, \u043a\u0430\u0433\u043e \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u045e \u0446\u0435\u043c\u0440\u044b; \u044f\u043d\u0430 \u045e\u0441\u0456\u0445 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u043b\u0430 \u0437-\u043f\u0430\u0434 \u0443\u043b\u0430\u0434\u044b \u0433\u0440\u0430\u0445\u0443, \u0430\u0434\u043a\u0443\u043f\u0456\u043b\u0430 \u045e\u0432\u0435\u0441\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0440\u043e\u0434.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0430\u0440\u043e\u043c\u0435\u0446\u0446\u0430 \u043a\u0440\u044b\u0436\u0430 \u0417\u0431\u0430\u045e\u0446\u044b, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0456\u043c. \u041a\u0440\u044b\u0436 \u0434\u043b\u044f \u044e\u0434\u044d\u044f\u045e &ndash; \u0437\u0433\u0430\u0440\u0448\u044d\u043d\u043d\u0435, \u0434\u043b\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e &ndash; \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430, \u0430 \u0434\u043b\u044f \u043d\u0430\u0441 &ndash; \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0414\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u043d\u0430 \u0437\u0430\u0433\u0443\u0431\u0443, \u0451\u043d &ndash; \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430, \u0434\u043b\u044f \u043d\u0430\u0441 \u0436\u0430, \u044f\u043a\u0456\u044f \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, &ndash; \u043c\u043e\u0446 \u0411\u043e\u0436\u0430\u044f. \u0422\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u043d\u0430\u0441, \u0431\u044b\u045e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0430\u043b\u0435 \u0456 \u0421\u044b\u043d\u0430\u043c \u0411\u043e\u0433\u0430 &ndash; \u0411\u043e\u0433\u0430\u043c, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0430\u0440\u0430\u043d\u0430\u043a, \u0437\u0430\u0431\u0456\u0442\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u0433\u0430\u0434\u0443 \u041c\u0430\u0439\u0441\u0435\u044f, \u0430\u0434\u0432\u0451\u045e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0430\u043d\u0451\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u0456. \u0426\u0456 \u0436 \u043d\u0435 \u043d\u0430\u043c\u043d\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043c\u043e\u0436\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u0433\u0440\u0430\u0445\u0443 \u0411\u043e\u0436\u044b \u0411\u0430\u0440\u0430\u043d\u0430\u043a, \u044f\u043a\u0456 \u0437\u0430\u0431\u0456\u0440\u0430\u0435 \u0433\u0440\u0430\u0445\u0456 \u0441\u0432\u0435\u0442\u0443? \u041a\u0430\u043b\u0456 \u043a\u0440\u043e\u045e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0439 \u0436\u044b\u0432\u0451\u043b\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0430 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435, \u0442\u043e \u0446\u0456 \u0436 \u043a\u0440\u043e\u045e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0431\u043e\u043b\u044c\u0448 \u0448\u0447\u043e\u0434\u0440\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435?<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043d\u0435 \u043f\u0430\u043c\u0451\u0440 \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456 \u0456 \u043d\u0435 \u0431\u044b\u045e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b \u0437 \u043f\u0440\u044b\u043c\u0443\u0441\u0443, \u0430\u043b\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u0433\u044d\u0442\u0430 \u0434\u0430\u0431\u0440\u0430\u0432\u043e\u043b\u044c\u043d\u0430. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0448\u0442\u043e \u0401\u043d \u043a\u0430\u0436\u0430: &laquo;\u042f \u043c\u0430\u044e \u045e\u043b\u0430\u0434\u0443 \u0436\u044b\u0446\u0446\u0451 \u0430\u0434\u0434\u0430\u0446\u044c \u0456 \u043c\u0430\u044e \u045e\u043b\u0430\u0434\u0443 \u0437\u043d\u043e\u045e \u0443\u0437\u044f\u0446\u044c \u044f\u0433\u043e&raquo; (\u043f\u0430\u0440. \u042f\u043d 10, 18). \u0414\u0430\u0431\u0440\u0430\u0432\u043e\u043b\u044c\u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u043c\u0443\u043a\u0443, \u0440\u0430\u0434\u0443\u044e\u0447\u044b\u0441\u044f \u0442\u0430\u043a\u043e\u0439 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u0440\u0430\u0434\u0443\u044e\u0447\u044b\u0441\u044f \u0431\u0443\u0434\u0443\u0447\u0430\u0439 \u043f\u0435\u0440\u0430\u043c\u043e\u0437\u0435 \u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043b\u044e\u0434\u0437\u0435\u0439. \u041d\u0435 \u0441\u0430\u0440\u043e\u043c\u0435\u045e\u0441\u044f \u043a\u0440\u044b\u0436\u0430, \u0431\u043e \u043f\u0440\u0430\u0437 \u044f\u0433\u043e \u0434\u0430\u0432\u0430\u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u0432\u0435\u0442\u0443. \u0406 \u0446\u044f\u0440\u043f\u0435\u045e \u043d\u0435 \u0445\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c, \u0430\u043b\u0435 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u045e \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0437\u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043a\u0440\u044b\u0436 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0445\u0432\u0456\u043b\u0456\u043d\u044b \u0441\u043f\u0430\u043a\u043e\u044e. \u0414\u0430\u0432\u0435\u0440\u0441\u044f \u044f\u043c\u0443 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0445\u0432\u0456\u043b\u0456\u043d\u044b \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443. \u041d\u0435 \u0456\u043c\u043a\u043d\u0456\u0441\u044f \u0431\u044b\u0446\u044c \u0441\u044f\u0431\u0440\u0430\u043c \u0415\u0437\u0443\u0441\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u0441\u043f\u0430\u043a\u043e\u044e, \u0430 \u0432\u043e\u0440\u0430\u0433\u0430\u043c &ndash; \u0443 \u0447\u0430\u0441 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u044b. \u0412\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440 \u0442\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0448 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f, \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0434\u0430\u0440\u044b \u0442\u0432\u0430\u0439\u0433\u043e \u041a\u0430\u0440\u0430\u043b\u044f. \u041a\u0430\u043b\u0456 \u0440\u0430\u0441\u043f\u0430\u0447\u043d\u0435\u0446\u0446\u0430 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0430, \u0437\u043c\u0430\u0433\u0430\u0439\u0441\u044f \u043c\u0443\u0436\u043d\u0430 \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u041a\u0430\u0440\u0430\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u0431\u044b\u045e \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0434\u043b\u044f \u0446\u044f\u0431\u0435. \u0401\u043d \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u0433\u0440\u0430\u0445\u0443. \u0410 \u0442\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b\u043c \u0437\u0430 \u0422\u0430\u0433\u043e, \u0445\u0442\u043e \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0431\u044b\u045e \u043f\u0440\u044b\u0431\u0456\u0442\u044b \u0434\u0430 \u0434\u0440\u044d\u0432\u0430? \u041d\u0435 \u0442\u044b \u0430\u0445\u0432\u044f\u0440\u043e\u045e\u0432\u0430\u0435\u0448 \u0434\u0430\u0440, \u0431\u043e \u0442\u044b \u043f\u0435\u0440\u0448\u044b\u043c \u044f\u0433\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e. \u0422\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u043b\u0430\u0446\u0456\u0448 \u0443\u0437\u0430\u0435\u043c\u043d\u0430\u0441\u0446\u044e, \u0430\u0434\u0434\u0430\u0435\u0448 \u0434\u043e\u045e\u0433 \u0422\u0430\u043c\u0443, \u0445\u0442\u043e \u0437\u0430 \u0446\u044f\u0431\u0435 \u0431\u044b\u045e \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u0413\u0430\u043b\u0433\u043e\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 1, 18. 23<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u0456\u043d\u0435, \u0441\u043b\u043e\u0432\u0430 \u0430\u0431 \u043a\u0440\u044b\u0436\u044b &ndash; \u0433\u044d\u0442\u0430 \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0430\u043b\u0435 \u0434\u043b\u044f \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u0437\u0431\u0430\u045e\u043b\u044f\u0435\u043c\u0441\u044f, &ndash; \u0433\u044d\u0442\u0430 \u043c\u043e\u0446 \u0411\u043e\u0436\u0430\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u044b \u0436 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u0434\u043b\u044f \u044e\u0434\u044d\u044f\u045e &ndash; \u0437\u0433\u0430\u0440\u0448\u044d\u043d\u043d\u0435, \u0434\u043b\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e &ndash; \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043b\u0435 \u0434\u043b\u044f \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u0437\u0431\u0430\u045e\u043b\u044f\u0435\u043c\u0441\u044f, &ndash; \u0433\u044d\u0442\u0430 \u043c\u043e\u0446 \u0411\u043e\u0436\u0430\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"46","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u044c\u043d\u0430\u0433\u0430 \u0410\u045e\u0442\u0430\u0440\u0430 IV \u0441\u0442\u0430\u0433\u043e\u0434\u0434\u0437\u044f<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 18. 7-11: PG 34, 639-642)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0432\u044f\u0434\u0437\u0435 \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u0448\u043b\u044f\u0445\u0430\u043c\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0428\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c\u0456, \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u043c\u0456 \u0448\u043b\u044f\u0445\u0430\u043c\u0456 \u0432\u044f\u0434\u0437\u0435 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u043e\u0434\u043d\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u0446\u0430 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456 \u0456 \u0430\u0434\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u043d\u0443\u0442\u0440\u0430\u043d\u0430 \u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u0456 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435. \u0406\u0445 \u0441\u044d\u0440\u0446\u0430\u043c\u0456 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430 \u043a\u0456\u0440\u0443\u0435 \u043b\u0430\u0441\u043a\u0430 \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0441\u043f\u0430\u043a\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u0441\u0430\u043c \u044f\u043d\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u045e \u0441\u043c\u0443\u0442\u043a\u0443 \u0456 \u0436\u0430\u043b\u043e\u0431\u0435 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u045e\u0441\u044f\u0433\u043e \u0440\u043e\u0434\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430. \u0423\u0437\u043d\u043e\u0441\u044f\u0446\u044c \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0437\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u044f \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u0441\u043c\u0443\u0442\u043a\u0443\u044e\u0446\u044c \u0430\u0436 \u0434\u0430 \u0441\u043b\u0451\u0437.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u0441\u0430\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0440\u0430\u0441\u043f\u0430\u043b\u044c\u0432\u0430\u0435 \u0456\u0445 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0456 \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u0435\u043c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0431 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u043c\u0430\u0433\u0447\u044b\u043c\u044b\u043c, \u044f\u043d\u044b \u0437\u0430\u043c\u043a\u043d\u0443\u043b\u0456 \u0431 \u0443 \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439: \u0434\u043e\u0431\u0440\u044b\u0445 \u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u0445.<br \/>\u0427\u0430\u0441\u0430\u043c \u0443 \u043f\u0430\u043a\u043e\u0440\u044b \u0434\u0443\u0445\u0430 \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u044e\u0446\u044c \u0441\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0456 \u043b\u0456\u0447\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0430\u043f\u043e\u0448\u043d\u0456\u043c\u0456 \u0456 \u0441\u0430\u043c\u044b\u043c\u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u0441\u0430\u043c \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0442\u0440\u044b\u0432\u0430\u044e\u0446\u044c \u0443 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u0441\u0430\u043c \u044f\u043d\u044b \u044f\u043a \u0432\u043e\u043b\u0430\u0442, \u044f\u043a\u0456 \u0430\u043f\u0440\u0430\u043d\u0430\u0435 \u0437\u0431\u0440\u043e\u044e \u043a\u0430\u0440\u0430\u043b\u044f \u0456 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0443, \u043c\u0443\u0436\u043d\u0430 \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0437 \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456 \u0456 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0430\u0434\u0437\u044f\u0432\u0430\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u0443\u044e \u0437\u0431\u0440\u043e\u044e \u0414\u0443\u0445\u0430, \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0437 \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456 \u0456, \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0448\u044b, \u043a\u0456\u0434\u0430\u0435 \u0456\u0445 \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u043d\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u043d\u043e\u045e \u0436\u0430, \u0447\u0430\u0441\u0430\u043c \u0434\u0443\u0448\u0430 \u0442\u0430\u043a\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0441\u0442\u0430\u043d\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0446\u0456\u0448\u044b\u043d\u0456, \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0441\u0446\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e, \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0440\u0430\u0441\u043a\u043e\u0448\u044b, \u0433\u0430\u0440\u043c\u043e\u043d\u0456\u044e \u0456 \u0448\u0447\u0430\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u0441\u0430\u043c \u0443 \u0432\u044b\u043d\u0456\u043a\u0443 \u0434\u0430\u0440\u0443 \u0432\u0435\u0434\u0430\u045e, \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0440\u043e\u0437\u0443\u043c\u0443 \u0456 \u043d\u0435\u0441\u043f\u0430\u0437\u043d\u0430\u043d\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043b\u0430\u0441\u043a\u0443 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u044f \u043c\u043e\u0432\u0430, \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u043d\u0435 \u045e \u0441\u0442\u0430\u043d\u0435 \u0432\u044b\u0440\u0430\u0437\u0456\u0446\u044c. \u0427\u0430\u0441\u0430\u043c \u0451\u043d \u0437\u043d\u043e\u045e \u0442\u0430\u043a\u0456 \u0436, \u044f\u043a \u0443\u0441\u0435 \u0456\u043d\u0448\u044b\u044f \u043b\u044e\u0434\u0437\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u043e\u0437\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043b\u0430\u0441\u043a\u0430 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e \u043b\u044e\u0434\u0437\u044f\u0445, \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u0448\u043b\u044f\u0445\u0430\u043c\u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0443\u0448\u0443. \u0423\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u044f\u0435 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u044f\u0439 \u0456 \u0444\u0430\u0440\u043c\u0456\u0440\u0443\u0435 \u0440\u043e\u0437\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c, \u043a\u0430\u0431 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u044f\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u043c\u0443 \u0410\u0439\u0446\u0443 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u0439, \u0431\u0435\u0437 \u0437\u0430\u0433\u0430\u043d\u044b \u0456 \u0447\u044b\u0441\u0442\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0456 \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c \u0411\u043e\u0433\u0430, \u043f\u0440\u043e\u0441\u0456\u043c \u0437 \u043b\u044e\u0431\u043e\u045e\u044e \u0456 \u043c\u043e\u0446\u043d\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u044f\u0439, \u043a\u0430\u0431 \u0401\u043d \u0443\u0434\u0437\u044f\u043b\u0456\u045e \u043d\u0430\u043c \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u041d\u044f\u0445\u0430\u0439 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043a\u0456\u0440\u0443\u0435 \u043d\u0430\u043c\u0456, \u043d\u044f\u0445\u0430\u0439 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456, \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u043d\u0430\u0441 \u0441\u0432\u0430\u0456\u043c \u0448\u0447\u043e\u0434\u0440\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0435\u043c, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u043a\u0456\u0440\u0430\u0432\u0430\u043d\u043d\u044f \u043c\u044b \u0437\u043c\u0430\u0433\u043b\u0456 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430: &laquo;\u041a\u0430\u0431 \u0432\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u045e\u0441\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u043e\u044e \u0411\u043e\u0436\u0430\u0439&raquo; (\u043f\u0430\u0440. \u042d\u0444 3, 19).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u042f\u043d 2, 20. 27; \u0401\u044d\u043b 2, 23\u0430b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u043c\u0430\u0435\u0446\u0435 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435 \u0430\u0434 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0410 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0434 \u042f\u0433\u043e, \u0443 \u0432\u0430\u0441 \u0436\u044b\u0432\u0435, \u0456 \u0432\u044b \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0435, \u043a\u0430\u0431 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0432\u0443\u0447\u044b\u045e \u0432\u0430\u0441, \u0431\u043e \u042f\u0433\u043e \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435 \u0432\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u044f\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0435\u0441\u044f \u045e \u041f\u0430\u043d\u0443, \u0411\u043e\u0433\u0443 \u0432\u0430\u0448\u044b\u043c, \u0431\u043e \u0434\u0430\u045e \u0432\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0434 \u042f\u0433\u043e, \u0443 \u0432\u0430\u0441 \u0436\u044b\u0432\u0435, \u0456 \u0432\u044b \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0435, \u043a\u0430\u0431 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0432\u0443\u0447\u044b\u045e \u0432\u0430\u0441, \u0431\u043e \u042f\u0433\u043e \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435 \u0432\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u044f\u043c\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"47","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u043c \u0441\u0432\u0435\u0446\u0435 <br \/>&laquo;Gaudium et spes&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 35-36)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u0430\u0439\u0446\u0435 \u0432\u0435\u0440\u0443 \u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043b\u044e\u0431\u043e\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0434\u0430 \u044f\u0433\u043e. \u0411\u043e, \u043f\u0440\u0430\u0446\u0443\u044e\u0447\u044b, \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u043c\u044f\u043d\u044f\u0435 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c \u0456 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435. \u0401\u043d \u043c\u043d\u043e\u0433\u0430\u043c\u0443 \u0432\u0443\u0447\u044b\u0446\u0446\u0430, \u0440\u0430\u0437\u0432\u0456\u0432\u0430\u0435 \u0441\u0432\u0430\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0430 \u043c\u0435\u0436\u044b \u0441\u0432\u0430\u0439\u0433\u043e &laquo;\u044f&raquo; \u0456 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0431\u0435. \u041a\u0430\u043b\u0456 \u0434\u043e\u0431\u0440\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0433\u044d\u0442\u0430\u0435 \u0440\u0430\u0437\u0432\u0456\u0446\u0446\u0451, \u0442\u043e \u044f\u043d\u043e \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0435 \u0437\u0430 \u0437\u043d\u0435\u0448\u043d\u0456\u044f \u0431\u0430\u0433\u0430\u0446\u0446\u0456, \u044f\u043a\u0456\u044f \u043c\u043e\u0436\u043d\u0430 \u0437\u0434\u0430\u0431\u044b\u0446\u044c. \u0412\u0430\u0440\u0442\u0430\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u0435\u0446\u0446\u0430 \u0442\u044b\u043c, \u0447\u044b\u043c \u0451\u043d \u0451\u0441\u0446\u044c, \u0430 \u043d\u0435 \u0442\u044b\u043c, \u0447\u044b\u043c \u0451\u043d \u0432\u0430\u043b\u043e\u0434\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u045e\u0441\u0451, \u0448\u0442\u043e \u043b\u044e\u0434\u0437\u0456 \u0440\u043e\u0431\u044f\u0446\u044c \u0434\u043b\u044f \u045e\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u043d\u043d\u044f \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043f\u0430\u0448\u044b\u0440\u044d\u043d\u043d\u044f \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u0442\u0432\u0430, \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0433\u0443\u043c\u0430\u043d\u0456\u0437\u0430\u0446\u044b\u0456 \u0441\u0444\u0435\u0440\u044b \u0441\u0430\u0446\u044b\u044f\u043b\u044c\u043d\u044b\u0445 \u0441\u0443\u0432\u044f\u0437\u044f\u045e, \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u0442\u044d\u0445\u043d\u0456\u0447\u043d\u044b \u043f\u0440\u0430\u0433\u0440\u044d\u0441. \u0411\u043e \u0433\u044d\u0442\u044b \u043f\u0440\u0430\u0433\u0440\u044d\u0441 \u043c\u043e\u0436\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0446\u044c \u043f\u044d\u045e\u043d\u0443\u044e \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u0443\u044e \u0431\u0430\u0437\u0443 \u0434\u043b\u044f \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0435\u043d\u043d\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u0441\u0430\u043c \u043f\u0430 \u0441\u0430\u0431\u0435 \u0430\u0436\u044b\u0446\u0446\u044f\u0432\u0456\u0446\u044c \u0433\u044d\u0442\u0430\u0435 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0435\u043d\u043d\u0435 \u043d\u0435 \u043c\u043e\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0434\u043b\u044f \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u043e\u0440\u043c\u0430\u0439 \u0442\u043e\u0435, \u043a\u0430\u043b\u0456 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0411\u043e\u0436\u044b\u043c \u043d\u0430\u043c\u0435\u0440\u0430\u043c \u0456 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u044f\u0439 \u044f\u043d\u0430 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u0434\u0430\u0431\u0440\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u0456 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0436\u044b\u0446\u0446\u044f\u0432\u0456\u0446\u044c \u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0441\u0432\u0430\u0451 \u0456\u043d\u0434\u044b\u0432\u0456\u0434\u0443\u0430\u043b\u044c\u043d\u0430\u0435 \u0446\u0456 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u043a\u0430\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0430\u0447\u043d\u0430, \u044f\u043a \u043c\u043d\u043e\u0433\u0456\u044f \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0431\u0430\u044f\u0446\u0446\u0430, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0446\u044f\u0441\u043d\u0435\u0439\u0448\u0443\u044e \u0441\u0443\u0432\u044f\u0437\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456 \u0437 \u0440\u044d\u043b\u0456\u0433\u0456\u044f\u0439 \u043c\u043e\u0433\u0443\u0446\u044c \u0443\u0437\u043d\u0456\u043a\u043d\u0443\u0446\u044c \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b \u0434\u043b\u044f \u0430\u045e\u0442\u0430\u043d\u043e\u043c\u0456\u0456 \u043b\u044e\u0434\u0437\u0435\u0439, \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044f\u045e \u0446\u0456 \u043d\u0430\u0432\u0443\u043a\u0456. \u041a\u0430\u043b\u0456 \u043f\u0430\u0434 \u0430\u045e\u0442\u0430\u043d\u043e\u043c\u0456\u044f\u0439 \u0443 \u0437\u044f\u043c\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u043c\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u044f \u0440\u044d\u0447\u044b \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u0440\u0430\u0432\u0430\u043c\u0456 \u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044f\u043c\u0456, \u044f\u043a\u0456\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u0441\u0442\u0443\u043f\u043e\u0432\u0430 \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c, \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u0456 \u045e\u043b\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0446\u044c, \u0442\u043e \u0430\u045e\u0442\u0430\u043d\u043e\u043c\u0456\u0456 \u045e \u0442\u0430\u043a\u0456\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0456 \u0442\u0440\u044d\u0431\u0430 \u0434\u0430\u0431\u0456\u0432\u0430\u0446\u0446\u0430; \u0431\u043e \u044f\u0435 \u0434\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u0446\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u044e\u0434\u0437\u0456 \u043d\u0430\u0448\u044b\u0445 \u0447\u0430\u0441\u043e\u045e, \u0430\u043b\u0435 \u044f\u043d\u0430 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u043e\u043b\u0456 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f. \u0423\u0441\u0435 \u0440\u044d\u0447\u044b, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b, \u043c\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u044e \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0441\u0446\u044c, \u0434\u0430\u0431\u0440\u043e \u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0441\u0432\u0430\u0435 \u043f\u0440\u0430\u0432\u044b \u0456 \u043f\u0430\u0440\u0430\u0434\u0430\u043a, \u044f\u043a\u0456\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u0432\u0430\u0436\u0430\u0446\u044c, \u043f\u0440\u044b\u0437\u043d\u0430\u045e\u0448\u044b \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u044b\u044f \u043c\u0435\u0442\u0430\u0434\u044b \u043a\u0430\u043d\u043a\u0440\u044d\u0442\u043d\u044b\u0445 \u043d\u0430\u0432\u0443\u043a \u0446\u0456 \u0442\u044d\u0445\u043d\u0456\u043a\u0456. \u0422\u0430\u043c\u0443 \u043c\u0435\u0442\u0430\u0434\u044b\u0447\u043d\u0430\u0435 \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0432\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0432\u0443\u043a\u043e\u0432\u044b\u0445 \u0434\u044b\u0441\u0446\u044b\u043f\u043b\u0456\u043d\u0430\u0445, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u043e \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043f\u0430-\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u043a\u043e\u0432\u0430 \u0456 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043c\u0430\u0440\u0430\u043b\u044c\u043d\u044b\u043c\u0456 \u043d\u043e\u0440\u043c\u0430\u043c\u0456, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c \u0432\u0435\u0440\u044b, \u0431\u043e \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0441\u0432\u0435\u0446\u043a\u0456\u0445 \u0441\u043f\u0440\u0430\u045e \u0456 \u0441\u043f\u0440\u0430\u045e \u0432\u0435\u0440\u044b \u0451\u0441\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0456 \u0442\u043e\u0439 \u0436\u0430 \u0411\u043e\u0433. \u0411\u0435\u0437\u0443\u043c\u043e\u045e\u043d\u0430, \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0430\u043a\u043e\u0440\u043d\u0430 \u0456 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430 \u0441\u043f\u0440\u0430\u0431\u0443\u0435 \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u0456, \u0445\u043e\u0446\u044c \u0451\u043d \u0433\u044d\u0442\u0430\u0433\u0430 \u0456 \u043d\u0435 \u045e\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u0435, \u043a\u0456\u0440\u0443\u0435 \u0440\u0443\u043a\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u045e\u0441\u0435 \u0440\u044d\u0447\u044b \u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0456\u0445 \u0442\u044b\u043c, \u0447\u044b\u043c \u044f\u043d\u044b \u0451\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0435\u043d\u0430 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u0435 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u044f\u045e, \u044f\u043a\u0456\u044f \u0440\u0430\u043d\u0435\u0439 \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u043b\u0456\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u0441\u0430\u043c\u0456\u0445 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e \u044f\u043a \u0432\u044b\u043d\u0456\u043a \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0441\u043b\u0443\u0448\u043d\u0430\u0439 \u0430\u045e\u0442\u0430\u043d\u043e\u043c\u0456\u0456 \u043d\u0430\u0432\u0443\u043a \u0456 \u044f\u043a\u0456\u044f, \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u045e\u0448\u044b \u043a\u0430\u043d\u0444\u043b\u0456\u043a\u0442\u044b \u0456 \u0441\u043f\u0440\u044d\u0447\u043a\u0456, \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u043c\u043d\u043e\u0433\u0456\u0445 \u0434\u0430 \u0434\u0443\u043c\u043a\u0456 \u043f\u0440\u0430 \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u043d\u0430\u0441\u0446\u044c \u0432\u0435\u0440\u044b \u0456 \u043d\u0430\u0432\u0443\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u0432\u044b\u0440\u0430\u0437 &laquo;\u0430\u045e\u0442\u0430\u043d\u043e\u043c\u0456\u044f \u0447\u0430\u0441\u043e\u0432\u044b\u0445 \u0440\u044d\u0447\u0430\u045e&raquo; \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u044f \u0440\u044d\u0447\u044b \u043d\u0435 \u0437\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043c\u043e\u0436\u0430 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0446\u044c \u0456\u0445 \u0431\u0435\u0437 \u0430\u0434\u043d\u044f\u0441\u0435\u043d\u043d\u044f \u0434\u0430 \u0411\u043e\u0433\u0430, \u0442\u043e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u0411\u043e\u0433\u0430, \u0430\u0434\u0447\u0443\u0432\u0430\u0435, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u043c\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043f\u043e\u0433\u043b\u044f\u0434\u044b \u0442\u0430\u043a\u043e\u0433\u0430 \u043a\u0448\u0442\u0430\u043b\u0442\u0443. \u0421\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0431\u0435\u0437 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u043c\u0430\u0440\u043d\u0435\u0435. \u0417\u0440\u044d\u0448\u0442\u044b, \u0443\u0441\u0435 \u0432\u0435\u0440\u043d\u0456\u043a\u0456, \u044f\u043a\u0443\u044e \u0431 \u0440\u044d\u043b\u0456\u0433\u0456\u044e \u043d\u0456 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u043b\u0456, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e \u043c\u043e\u0432\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e \u0447\u0443\u043b\u0456 \u0433\u043e\u043b\u0430\u0441 \u0456 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0437\u0430\u0431\u044b\u0432\u0430\u044e\u0447\u044b \u0411\u043e\u0433\u0430, \u0441\u0430\u043c\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0442\u0440\u0430\u043f\u043b\u044f\u0435 \u045e \u0446\u0435\u043c\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0414\u0440\u0433 2, 7; 8, 5b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u0446\u044f\u0431\u0435 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0442\u0432\u0430\u0456\u0445 \u0440\u0443\u043a; \u0430\u043f\u044f\u043a\u0443\u0435\u0446\u0446\u0430 \u0442\u0430\u0431\u043e\u044e \u043f\u0430\u0434\u0447\u0430\u0441 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043a\u0456 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043f\u0443\u0441\u0442\u044b\u043d\u044e. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0437 \u0442\u0430\u0431\u043e\u044e, \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u043c\u0435\u0446\u044c \u043d\u044f\u0441\u0442\u0430\u0447\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043a \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0435 \u0431\u0430\u0446\u044c\u043a\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044b\u043d\u0430, \u0442\u0430\u043a \u041f\u0430\u043d \u0411\u043e\u0433 \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0435 \u0446\u044f\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0437 \u0442\u0430\u0431\u043e\u044e, \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u043c\u0435\u0446\u044c \u043d\u044f\u0441\u0442\u0430\u0447\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"51","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Praefatio: PL 35, 2105-2107)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0421\u043f\u0430\u0437\u043d\u0430\u0439\u043c\u0430 \u0411\u043e\u0436\u0443\u044e \u043b\u0430\u0441\u043a\u0443 <\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043d\u0430\u043f\u0456\u0441\u0430\u045e &laquo;\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e&raquo;, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u0411\u043e\u0436\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0437\u0440\u0430\u0431\u0456\u043b\u0430 \u0456\u0445 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c\u0456 \u0430\u0434 \u0417\u0430\u043a\u043e\u043d\u0443. \u0411\u043e \u043a\u0430\u043b\u0456 \u0456\u043c \u0431\u044b\u043b\u043e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0437&rsquo;\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u043d\u0435\u0439\u043a\u0456\u044f \u043b\u044e\u0434\u0437\u0456, \u0433\u0430\u0431\u0440\u044d\u0456 \u043f\u0430 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0456, \u044f\u043a\u0456\u044f \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0456\u0441\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u045e \u043b\u0430\u0441\u043a\u0456 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f. \u0414\u044b\u043a \u0432\u043e\u0441\u044c, \u0433\u044d\u0442\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u043b\u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0446\u0446\u0430 \u0417\u0430\u043a\u043e\u043d\u0443, \u044f\u043a\u0456 \u0411\u043e\u0433 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0434\u0430\u045e \u0441\u043b\u0443\u0433\u0430\u043c \u0433\u0440\u0430\u0445\u0443, \u0430 \u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456; \u0433\u0440\u044d\u0448\u043d\u044b\u043c \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u0430\u045e \u0441\u0432\u044f\u0442\u044b \u0417\u0430\u043a\u043e\u043d, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0456\u0445\u043d\u0456\u044f \u0433\u0440\u0430\u0445\u0456, \u0430 \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0456\u0445, \u0431\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u0430\u0441\u043a\u0430 \u0432\u0435\u0440\u044b, \u0448\u0442\u043e \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e, \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0433\u0440\u0430\u0445\u0456. \u0412\u043e\u0441\u044c \u0436\u0430, \u0433\u044d\u0442\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0436\u0430\u0434\u0430\u043b\u0456 \u043d\u0430\u043a\u0430\u0437\u0430\u043c \u0417\u0430\u043a\u043e\u043d\u0443 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u0446\u044c \u0413\u0430\u043b\u0430\u0442\u0430\u045e, \u044f\u043a\u0456\u044f \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u043b\u0430\u0441\u043a\u0456. \u0411\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b\u044f, \u0448\u0442\u043e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u043d\u0435\u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430\u0435, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u043d\u0435 \u043f\u0440\u044b\u043c\u0443\u0446\u044c \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f \u0456 \u043d\u0435 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0443\u044e\u0446\u0446\u0430 \u0456\u043d\u0448\u044b\u043c \u043d\u0430\u043a\u0430\u0437\u0430\u043c \u044e\u0434\u0430\u0456\u0437\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0413\u0430\u043b\u0430\u0442\u044b \u043f\u0430\u0447\u0430\u043b\u0456 \u043f\u0430\u0434\u0430\u0437\u0440\u0430\u0432\u0430\u0446\u044c, \u0448\u0442\u043e \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b, \u044f\u043a\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0456\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u0435 \u045e\u043a\u0430\u0437\u0430\u043d\u043d\u0456 \u0456\u043d\u0448\u044b\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u044f\u043a\u0456\u044f \u0430\u0431\u0430\u0432\u044f\u0437\u0432\u0430\u044e\u0446\u044c \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0436\u044b\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u044b\u043d\u0446\u044b\u043f\u0430\u045e \u044e\u0434\u0430\u0456\u0437\u043c\u0443. \u041f\u0435\u0440\u0430\u0434 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430\u0439 \u0437\u0433\u0430\u0440\u0448\u044d\u043d\u043d\u044f \u0432\u044b\u0441\u0442\u0443\u043f\u0456\u045e \u041f\u0451\u0442\u0440 \u0456 \u043f\u0430\u0447\u0430\u045e \u0443\u0434\u0430\u0432\u0430\u0446\u044c, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0456 \u0451\u043d \u0441\u0430\u043c \u043b\u0456\u0447\u044b\u045e, \u0448\u0442\u043e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0434\u0430\u0446\u044c \u043f\u043b\u0451\u043d\u0443 \u0431\u0435\u0437 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u043d\u044f\u045e \u0417\u0430\u043a\u043e\u043d\u0443. \u0410\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u045e\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0430\u0434\u0432\u0451\u045e \u044f\u0433\u043e \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, \u043f\u0440\u0430 \u0448\u0442\u043e \u0441\u0430\u043c \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0432\u0430 \u045e\u0437\u0433\u0430\u0434\u0430\u043d\u044b\u043c \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456. \u0413\u044d\u0442\u0430\u0435 \u0436 \u043f\u044b\u0442\u0430\u043d\u043d\u0435 \u0437\u0430\u043a\u0440\u0430\u043d\u0430\u0435 &laquo;\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0420\u044b\u043c\u043b\u044f\u043d\u0430\u045e&raquo;. \u0417\u0434\u0430\u0435\u0446\u0446\u0430, \u0430\u0434\u043d\u0430\u043a, \u0448\u0442\u043e \u043f\u0430\u043c\u0456\u0436 \u0433\u044d\u0442\u044b\u043c\u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f\u043c\u0456 \u0430\u0434\u0431\u044b\u043b\u043e\u0441\u044f \u0448\u0442\u043e\u0441\u044c\u0446\u0456, \u0448\u0442\u043e \u0441\u043f\u044b\u043d\u0456\u043b\u0430 \u043d\u044f\u0437\u0433\u043e\u0434\u0443 \u0456 \u0432\u044b\u0440\u0430\u0448\u044b\u043b\u0430 \u0441\u043f\u0440\u044d\u0447\u043a\u0443 \u043f\u0430\u043c\u0456\u0436 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u044f \u0431\u044b\u043b\u0456 \u044e\u0434\u044d\u044f\u043c\u0456, \u0456 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0431\u044b\u045e \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 &laquo;\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e&raquo; \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0430\u0432\u0430\u0433\u0430\u045e\u0441\u044f \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u0430\u045e\u0442\u0430\u0440\u044b\u0442\u044d\u0442\u0443 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0437 \u044e\u0434\u0430\u0456\u0437\u043c\u0443 \u0456 \u0441\u0445\u0456\u043b\u044f\u043b\u0456\u0441\u044f \u0434\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0417\u0430\u043a\u043e\u043d\u0443. \u041f\u0430\u0447\u0430\u043b\u0456 \u0456\u043c \u0432\u0435\u0440\u044b\u0446\u044c \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u041f\u0430\u0432\u0435\u043b \u0434\u0440\u044d\u043d\u043d\u0430 \u0432\u0443\u0447\u044b\u0446\u044c, \u0431\u043e \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0456\u0445 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044e. \u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0440\u0430\u0441\u043f\u0430\u0447\u044b\u043d\u0430\u0435 \u0442\u0430\u043a: &laquo;\u0417\u0434\u0437\u0456\u045e\u043b\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u043b\u0430\u0441\u043a\u0430\u044e \u0425\u0440\u044b\u0441\u0442\u0430, \u0432\u044b \u0442\u0430\u043a \u0445\u0443\u0442\u043a\u0430 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430\u0432\u0435\u0441\u0446\u044f&raquo; (\u0413\u0430\u043b 1, 6).<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0430 \u045e\u0441\u0442\u0443\u043f\u0435 \u043a\u043e\u0440\u0430\u0442\u043a\u0430 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0441\u043f\u0440\u044d\u0447\u043a\u0456. \u0423\u0436\u043e \u045e \u0441\u0430\u043c\u0456\u043c \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0456, \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0447\u044b \u0441\u044f\u0431\u0435 \u0410\u043f\u043e\u0441\u0442\u043b\u0430\u043c, \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c &laquo;\u043d\u0435 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u0456 \u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c&raquo; (\u0413\u0430\u043b 1, 1), \u0447\u0430\u0433\u043e \u043d\u044f\u043c\u0430 \u045e \u043d\u0456\u0432\u043e\u0434\u043d\u044b\u043c \u0456\u043d\u0448\u044b\u043c \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456, \u043c\u043e\u0446\u043d\u0430 \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0432\u0430\u0435, \u0448\u0442\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u0440\u0430\u0441\u043f\u0430\u045e\u0441\u044e\u0434\u0436\u0432\u0430\u0435 \u0433\u044d\u0442\u0430\u0435 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435, \u043d\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 \u0430\u0434 \u043b\u044e\u0434\u0437\u0435\u0439. \u041a\u0430\u0436\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u043b\u0456\u0447\u044b\u0446\u044c \u044f\u0433\u043e \u043c\u0435\u043d\u0448\u044b\u043c \u0437\u0430 \u0456\u043d\u0448\u044b\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0443 \u0442\u044b\u043c, \u0448\u0442\u043e \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0441\u0446\u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f. \u0412\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0451\u043d \u0410\u043f\u043e\u0441\u0442\u0430\u043b, &laquo;\u0432\u044b\u0431\u0440\u0430\u043d\u044b \u043d\u0435 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u0456 \u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0430\u043b\u0435 \u0415\u0437\u0443\u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0456 \u0411\u043e\u0433\u0430\u043c \u0410\u0439\u0446\u043e\u043c&raquo; (\u0413\u0430\u043b 1, 1).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0430\u043b 3, 24-25. 23<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u043a\u043e\u043d \u0441\u0442\u0430\u045e \u043d\u0430\u0448\u044b\u043c \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0430\u043c, \u044f\u043a\u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u043c\u044b \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043b\u0456\u0441\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u043b\u0456 \u0436 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0432\u0435\u0440\u0430, \u043c\u044b \u045e\u0436\u043e \u043d\u0435\u043f\u0430\u0434\u0443\u043b\u0430\u0434\u043d\u044b\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0435\u0440\u0448 \u0447\u044b\u043c \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0432\u0435\u0440\u0430, \u043c\u044b \u0431\u044b\u043b\u0456 \u0437\u0430\u043c\u043a\u043d\u0451\u043d\u044b\u044f \u043f\u0430\u0434 \u0432\u0430\u0440\u0442\u0430\u044e \u0417\u0430\u043a\u043e\u043d\u0443 \u0434\u0430 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443, \u043a\u0430\u043b\u0456 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0432\u0435\u0440\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0436 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0432\u0435\u0440\u0430, \u043c\u044b \u045e\u0436\u043e \u043d\u0435\u043f\u0430\u0434\u0443\u043b\u0430\u0434\u043d\u044b\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"52","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;Breviloquium&raquo; \u0441\u0432. \u0411\u0430\u043d\u0430\u0432\u044d\u043d\u0442\u0443\u0440\u044b, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Prologus: Opera omnia 5, 201-202)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0434\u0430\u0435 \u043d\u0430\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u043b\u0451\u043d\u0430\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u043f\u043e\u0448\u0443\u043a\u0430\u045e \u0456 \u0430\u0434\u043a\u0440\u044b\u0446\u0446\u044f, \u0430\u043b\u0435 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u0411\u043e\u0436\u0430\u0433\u0430 \u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0410\u0439\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, &laquo;\u0430\u0434 \u044f\u043a\u043e\u0433\u0430 \u0431\u044f\u0440\u044d \u0441\u0432\u0430\u044e \u043d\u0430\u0437\u0432\u0443 \u043a\u043e\u0436\u043d\u044b \u0440\u043e\u0434 \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u0445 \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456&raquo; (\u042d\u0444 3, 15).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434 \u042f\u0433\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0421\u044b\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u043d\u0430\u0441 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b. \u0413\u044d\u0442\u044b \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u044f\u043a\u0456 \u045e\u0441\u0456\u043c \u0440\u0430\u0437\u043c\u044f\u0440\u043a\u043e\u045e\u0432\u0430\u0435 \u0441\u0432\u0430\u0435 \u0434\u0430\u0440\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0451\u0439 \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u0432\u043e\u043b\u0456, \u0434\u0430\u0435 \u0432\u0435\u0440\u0443, \u0430 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0436\u044b\u0432\u0435 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u043d\u0430\u0448\u044b\u0445 (\u043f\u0430\u0440. \u042d\u0444 3, 17). \u0412\u0435\u0440\u0430 \u0433\u044d\u0442\u0430\u044f &ndash; \u0433\u044d\u0442\u0430 \u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0417 \u044f\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u0432\u044b\u043f\u043b\u044b\u0432\u0430\u0435 \u0432\u0435\u0440\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 \u045e\u0441\u044f\u0433\u043e \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043a\u0430\u0431 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043c\u043e\u0433 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u043d\u0435 \u043c\u0435\u045e \u0443 \u0441\u0430\u0431\u0435 \u0432\u0435\u0440\u044b \u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u044f\u043a \u0441\u0432\u044f\u0442\u043b\u0430, \u0431\u0440\u0430\u043c\u044b, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443 \u045e\u0441\u044f\u0433\u043e \u041f\u0456\u0441\u0430\u043d\u043d\u044f. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u043e\u045e\u0433\u0430 \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0443\u0435\u043c \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u041f\u0430\u043d\u0430, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043e\u045e\u0433\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u0430 \u0432\u0435\u0440\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0430\u043c, \u044f\u043a\u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435, \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u044f\u043a\u043e\u0435 \u043a\u0456\u0440\u0443\u0435, \u0431\u0440\u0430\u043c\u0430\u0439, \u044f\u043a\u0430\u044f \u045e\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0441 \u0432\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0437\u0432\u044b\u0448\u043f\u0440\u044b\u0440\u043e\u0434\u043d\u0430\u0435 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435. \u042f\u043d\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u0435\u0440\u0430\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0439 \u043d\u0430\u043c \u0430\u0434 \u0411\u043e\u0433\u0430, &laquo;\u043a\u0430\u0431 \u043d\u0435 \u0434\u0443\u043c\u0430\u043b\u0456 \u043f\u0440\u0430 \u0441\u044f\u0431\u0435 \u043b\u0435\u043f\u0448, \u0447\u044b\u043c \u0442\u0440\u044d\u0431\u0430 \u0434\u0443\u043c\u0430\u0446\u044c, \u0430\u043b\u0435 \u0430\u0446\u044d\u043d\u044c\u0432\u0430\u043b\u0456 \u0441\u044f\u0431\u0435 \u0446\u0432\u044f\u0440\u043e\u0437\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u044b, \u0443\u0434\u0437\u0435\u043b\u0435\u043d\u0430\u0439 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0430\u043c&raquo; (\u0420\u044b\u043c 12, 3).<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u043c\u0435\u0441\u0442\u0430\u043c, \u0430\u0431\u043e \u0456\u043d\u0430\u043a\u0448 \u043f\u043b\u0451\u043d\u0430\u043c \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u0432\u0430\u0436\u043d\u0430\u044f \u0440\u044d\u0447, \u0430\u043b\u0435 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f. \u0411\u043e \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 &ndash; \u0433\u044d\u0442\u0430 \u043a\u043d\u0456\u0433\u0430, \u0443 \u044f\u043a\u043e\u0439 \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u044b \u0441\u043b\u043e\u0432\u044b \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u042f\u043d\u044b \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u0440\u044b\u043b\u0456, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0435\u043b\u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0443 \u044f\u043a\u0456\u043c \u0431\u0443\u0434\u0437\u0435\u043c \u043c\u0435\u0446\u044c \u0432\u0435\u0434\u044b \u0456 \u043b\u044e\u0431\u0456\u0446\u044c; \u0443 \u0456\u043c \u0440\u044d\u0430\u043b\u0456\u0437\u0443\u0435\u0446\u0446\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u043d\u0430\u0448\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435. \u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430, \u0442\u0430\u0434\u044b \u043c\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u0435\u043c, \u0448\u0442\u043e \u043b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 (\u043f\u0430\u0440. \u042d\u0444 3, 19). \u0422\u0430\u043a \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u044f &laquo;\u045e\u0441\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u043e\u044e \u0411\u043e\u0436\u0430\u0439&raquo; (\u042d\u0444 3, 19). \u0414\u0430 \u0433\u044d\u0442\u0430\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u0445\u043e\u0447\u0430 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u043d\u0430\u0441 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0437\u0433\u0430\u0434\u0430\u043d\u044b\u043c \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435\u043c \u0441\u0432. \u041f\u0430\u045e\u043b\u0430. \u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0456 \u0437 \u0442\u0430\u043a\u0456\u043c \u043d\u0430\u043c\u0435\u0440\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0432\u0443\u0447\u044b\u0446\u044c \u044f\u043c\u0443 \u0456 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0433\u044d\u0442\u044b \u043f\u043b\u0451\u043d \u0456 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u043c\u044d\u0442\u044b \u043f\u0430\u0434 \u043d\u0430\u043b\u0435\u0436\u043d\u044b\u043c \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u044f, \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0447\u0430\u0446\u044c \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0441\u0430 \u0448\u0447\u044b\u0440\u0430\u0439 \u0432\u0435\u0440\u044b, \u0437\u0433\u0456\u043d\u0430\u044e\u0447\u044b \u043a\u0430\u043b\u0435\u043d\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430, \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0456\u0446\u044c \u0434\u0430 \u0410\u0439\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u043a\u0430\u0431 \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u042f\u0433\u043e \u043b\u044e\u0431\u043e\u0432\u0456. \u0422\u0430\u0434\u044b, \u043f\u0430\u0437\u043d\u0430\u044e\u0447\u044b \u042f\u0433\u043e \u0456 \u043b\u044e\u0431\u044f\u0447\u044b, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u0432\u0435\u0440\u044b \u0456 \u045e\u043a\u0430\u0440\u0430\u043d\u0451\u043d\u044b\u044f \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u043c\u044b \u0437\u043c\u043e\u0436\u0430\u043c \u043f\u0430\u0437\u043d\u0430\u0446\u044c, &laquo;\u0447\u044b\u043c \u0451\u0441\u0446\u044c \u0448\u044b\u0440\u044b\u043d\u044f \u0456 \u0434\u0430\u045e\u0436\u044b\u043d\u044f, \u0456 \u0432\u044b\u0448\u044b\u043d\u044f, \u0456 \u0433\u043b\u044b\u0431\u0456\u043d\u044f&raquo; \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f. \u0422\u0430\u043a \u043c\u044b \u0434\u043e\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0421\u0432\u044f\u0442\u043e\u0439 \u0422\u0440\u043e\u0439\u0446\u044b, \u0443 \u044f\u043a\u043e\u0439 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0430\u0436\u044b\u0446\u0446\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u0434\u0430\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u0434\u0430\u0431\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 24, 27. 25<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0437\u0443\u0441, \u043f\u0430\u0447\u0430\u045e\u0448\u044b \u0430\u0434 \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0430\u0434 \u0443\u0441\u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, <span style=\"color: #ff0000;\">*<\/span> \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u045e \u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u0430 \u045e\u0441\u0456\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0456 \u0434\u0430\u0442\u044b\u0447\u044b\u043b\u0430 \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f \u0456 \u043c\u0430\u0440\u0443\u0434\u043d\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c, \u043a\u0430\u0431 \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c \u0443\u0441\u044f\u043c\u0443, \u0448\u0442\u043e \u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u045e \u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u0430 \u045e\u0441\u0456\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0456 \u0434\u0430\u0442\u044b\u0447\u044b\u043b\u0430 \u042f\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"53","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0411\u044b\u0446\u0446\u044f&raquo; \u0410\u0440\u044b\u0433\u0435\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 8, 6. 8. 9: PG 12, 206-209)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0410\u0445\u0432\u044f\u0440\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0423\u0437\u044f\u045e \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u0434\u0440\u043e\u0432\u044b \u043d\u0430 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0435 \u0456 \u045e\u0441\u043a\u043b\u0430\u045e \u043d\u0430 \u0406\u0441\u0430\u0430\u043a\u0430, \u0441\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e. \u0423\u0437\u044f\u045e \u0443 \u0440\u0443\u043a\u0456 \u0430\u0433\u043e\u043d\u044c \u0456 \u043d\u043e\u0436, \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u0430\u0431\u043e\u0434\u0432\u0430 \u0440\u0430\u0437\u0430\u043c&raquo; (\u0411\u044b\u0446 22, 6). \u0406\u0441\u0430\u0430\u043a, \u044f\u043a\u0456 \u043d\u044f\u0441\u0435 \u0434\u0440\u043e\u0432\u044b \u043d\u0430 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0435, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u044f\u0441\u0435 \u0441\u0432\u043e\u0439 \u043a\u0440\u044b\u0436. \u041d\u0430\u0441\u0456\u0446\u044c \u0434\u0440\u043e\u0432\u044b \u0431\u044b\u043b\u043e \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0436\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u0439. \u041f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u044e\u0446\u044c \u0434\u0430\u043b\u0435\u0439\u0448\u044b\u044f \u0441\u043b\u043e\u0432\u044b: &laquo;...\u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u0430\u0431\u043e\u0434\u0432\u0430 \u0440\u0430\u0437\u0430\u043c&raquo;. \u041a\u0430\u043b\u0456 \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u043d\u0451\u0441 \u0430\u0433\u043e\u043d\u044c \u0456 \u043d\u043e\u0436 \u0434\u043b\u044f \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u043d\u043d\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u0406\u0441\u0430\u0430\u043a \u043d\u0435 \u0456\u0448\u043e\u045e \u0437\u0430 \u0456\u043c, \u0430\u043b\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c, \u043a\u0430\u0431 \u0431\u0430\u0447\u043d\u044b\u043c \u0431\u044b\u043b\u043e, \u0448\u0442\u043e \u043d\u0430\u0440\u043e\u045e\u043d\u0456 \u0437 \u0430\u0439\u0446\u043e\u043c \u043c\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0443\u044e \u045e\u043b\u0430\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0448\u0442\u043e \u0434\u0437\u0435\u0435\u0446\u0446\u0430 \u0434\u0430\u043b\u0435\u0439? \u0406\u0441\u0430\u0430\u043a, \u044f\u043a \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0441\u043f\u044b\u0442\u0430\u045e \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0430\u0446\u044c\u043a\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0410\u0439\u0446\u0435\u0446 \u043c\u043e\u0439&raquo; (\u0411\u044b\u0446 22, 7). \u041c\u043e\u0432\u0430 \u0441\u044b\u043d\u0430 \u045e \u0442\u0430\u043a\u0443\u044e \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u0441\u043f\u0430\u043a\u0443\u0441\u044b. \u0426\u0456 \u045e\u044f\u045e\u043b\u044f\u0435\u0448 \u0441\u0430\u0431\u0435, \u044f\u043a \u043c\u043e\u0446\u043d\u0430 \u0433\u043e\u043b\u0430\u0441 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430\u0433\u0430 \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0443 \u0441\u044b\u043d\u0430 \u045e\u0437\u0440\u0443\u0448\u044b\u045e \u0431\u0430\u0446\u044c\u043a\u043e\u045e\u0441\u043a\u0430\u0435 \u0441\u044d\u0440\u0446\u0430? \u0412\u043e\u0441\u044c \u0436\u0430, \u0410\u0431\u0440\u0430\u0433\u0430\u043c, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0441\u0432\u0430\u044e \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430\u0441\u0446\u044c \u0443 \u0432\u0435\u0440\u044b, \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0437 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u043b\u044c\u043d\u044b\u043c \u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043d\u043d\u0435\u043c \u0443 \u0433\u043e\u043b\u0430\u0441\u0435: &laquo;\u0413\u044d\u0442\u0430 \u044f, \u0441\u044b\u043d\u0435 \u043c\u043e\u0439&raquo;. \u0422\u043e\u0439 \u0441\u043f\u044b\u0442\u0430\u045e: &laquo;\u0412\u043e\u0441\u044c \u0430\u0433\u043e\u043d\u044c \u0456 \u0434\u0440\u043e\u0432\u044b, \u0434\u0437\u0435 \u0436 \u044f\u0433\u043d\u044f \u043d\u0430 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0435?&raquo; \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0411\u043e\u0433 \u043d\u0430\u0433\u043b\u0435\u0434\u0437\u0456\u0446\u044c \u0441\u0430\u0431\u0435 \u044f\u0433\u043d\u044f \u043d\u0430 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0435, \u0441\u044b\u043d\u0435 \u043c\u043e\u0439&raquo; (\u0411\u044b\u0446 22, 7-8).<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0434\u0437\u0456\u045e\u043b\u044f\u0435 \u043c\u044f\u043d\u0435 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u044b \u0456 \u0440\u0430\u0437\u0443\u043c\u043d\u044b \u0430\u0434\u043a\u0430\u0437 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430. \u041d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0451\u043d \u0431\u0430\u0447\u044b\u045e \u0443 \u0434\u0443\u0445\u0443, \u0431\u043e \u043a\u0430\u0436\u0430 \u043d\u0435 \u043f\u0440\u0430 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456\u044f \u043f\u0430\u0434\u0437\u0435\u0456, \u0430\u043b\u0435 \u043f\u0440\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u044e: &laquo;\u0411\u043e\u0433 \u043d\u0430\u0433\u043b\u0435\u0434\u0437\u0456\u0446\u044c \u0441\u0430\u0431\u0435 \u044f\u0433\u043d\u044f&raquo;. \u0421\u044b\u043d\u0443, \u044f\u043a\u0456 \u043f\u044b\u0442\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0430\u0434\u0431\u044b\u0446\u0446\u0430 \u0446\u044f\u043f\u0435\u0440, \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435, \u0443\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0434\u0431\u0443\u0434\u0437\u0435\u0446\u0446\u0430 \u043f\u0430\u0437\u043d\u0435\u0439. \u0411\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u041f\u0430\u043d \u043d\u0430\u0433\u043b\u0435\u0434\u0437\u0456\u045e \u0441\u0430\u0431\u0435 \u044f\u0433\u043d\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0406 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e, \u0456 \u045e\u0437\u044f\u045e \u043d\u043e\u0436, \u043a\u0430\u0431 \u0437\u0430\u043a\u0430\u043b\u043e\u0446\u044c \u0441\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e. \u0410\u043b\u0435 \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u044f\u0433\u043e \u0437 \u043d\u0435\u0431\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &ldquo;\u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0435, \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0435&rdquo;. \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &ldquo;\u0413\u044d\u0442\u0430 \u044f&rdquo;. \u0410\u043d\u0451\u043b \u0441\u043a\u0430\u0437\u0430\u045e: &ldquo;\u041d\u0435 \u043f\u0430\u0434\u044b\u043c\u0430\u0439 \u0440\u0443\u043a\u0456 \u0442\u0432\u0430\u0451\u0439 \u043d\u0430 \u0445\u043b\u043e\u043f\u0446\u0430 \u0456 \u043d\u0435 \u0440\u0430\u0431\u0456 \u0437 \u0456\u043c \u043d\u0456\u0447\u043e\u0433\u0430, \u0431\u043e \u0446\u044f\u043f\u0435\u0440 \u042f \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0442\u044b \u0431\u0430\u0456\u0448\u0441\u044f \u0411\u043e\u0433\u0430&rdquo;&raquo; (\u0411\u044b\u0446 22, 10-12). \u041f\u0430\u0440\u0430\u045e\u043d\u0430\u0435\u043c \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0437 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435\u043c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u0430 \u0411\u043e\u0433\u0430: &laquo;\u0401\u043d \u043d\u0430\u0432\u0430\u0442 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e, \u0430\u043b\u0435 \u0430\u0434\u0434\u0430\u045e \u042f\u0433\u043e \u0437\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441&raquo; (\u043f\u0430\u0440. \u0420\u044b\u043c 8, 32). \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u0437 \u044f\u043a\u043e\u0439 \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u044e \u0411\u043e\u0433 \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0447\u0430\u0435 \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456. \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0411\u043e\u0433\u0443 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0441\u044b\u043d\u0430, \u044f\u043a\u0456 \u0456 \u0442\u0430\u043a \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043f\u0430\u043c\u0435\u0440\u0446\u0456. \u0411\u043e\u0433 \u0436\u0430 \u0430\u0434\u0434\u0430\u045e \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0437\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0423\u0437\u043d\u044f\u045e \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u0432\u043e\u0447\u044b \u0441\u0432\u0430\u0435 \u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0437\u0430 \u0441\u0430\u0431\u043e\u044e \u0431\u0430\u0440\u0430\u043d\u0447\u044b\u043a\u0430, \u044f\u043a\u0456 \u0437\u0430\u0431\u043b\u044b\u0442\u0430\u045e\u0441\u044f \u045e \u0433\u0443\u0448\u0447\u0430\u0440\u044b \u0440\u0430\u0433\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456&raquo; (\u0411\u044b\u0446 22, 13). \u041c\u044b \u0441\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u043b\u0456 \u0440\u0430\u043d\u0435\u0439, \u0448\u0442\u043e \u0406\u0441\u0430\u0430\u043a \u0431\u044b\u045e \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430. \u0410\u0434\u043d\u0430\u043a \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0430\u0440\u0430\u043d\u0430\u043a. \u0412\u0430\u0440\u0442\u0430 \u0437\u0430\u0434\u0443\u043c\u0430\u0446\u0430, \u0447\u0430\u043c\u0443 \u0406\u0441\u0430\u0430\u043a, \u044f\u043a\u0456 \u043d\u0435 \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u044f\u043a \u0456 \u0437\u0430\u0431\u0456\u0442\u044b \u0431\u0430\u0440\u0430\u043d\u0430\u043a, \u043d\u0430\u0440\u043e\u045e\u043d\u0456 \u0430\u0434\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0421\u043b\u043e\u0432\u0430\u043c \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 &laquo;\u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c&raquo; (\u042f\u043d 1, 14). \u0422\u0430\u043c\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0446\u0435\u0440\u043f\u0456\u0446\u044c, \u0430\u043b\u0435 \u045e \u0446\u0435\u043b\u0435; \u043f\u0430\u043c\u0456\u0440\u0430\u0435, \u0430\u043b\u0435 \u045e \u0446\u0435\u043b\u0435, \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u044f\u043a\u043e\u0433\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0431\u0430\u0440\u0430\u043d\u0430\u043a, \u044f\u043a \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0441\u0432. \u042f\u043d: &laquo;\u0412\u043e\u0441\u044c \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0431\u044f\u0440\u044d \u043d\u0430 \u0441\u044f\u0431\u0435 \u0433\u0440\u0430\u0445\u0456 \u0441\u0432\u0435\u0442\u0443&raquo; (\u042f\u043d 1, 29). \u0421\u043b\u043e\u0432\u0430 \u0436, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0434\u0443\u0445\u0430, \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u044b\u043c. \u042f\u0433\u043e \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0451\u0441\u0446\u044c \u0406\u0441\u0430\u0430\u043a. \u0422\u0430\u043c\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0456 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u0431\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0434\u0443\u0445\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0410\u0439\u0446\u0443 \u0430\u0445\u0432\u044f\u0440\u0443, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0436 \u0446\u0435\u043b\u0430 \u0441\u0430\u043c \u0430\u0445\u0432\u044f\u0440\u0443\u0435 \u0441\u044f\u0431\u0435 \u043d\u0430 \u0430\u043b\u0442\u0430\u0440\u044b \u043a\u0440\u044b\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 19, 16b-17; \u0411\u044b\u0446 22, 6<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u045e\u0437\u044f\u043b\u0456 \u0415\u0437\u0443\u0441\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0406, \u043d\u0435\u0441\u0443\u0447\u044b \u0441\u0432\u043e\u0439 \u043a\u0440\u044b\u0436, \u0401\u043d \u0432\u044b\u0439\u0448\u0430\u045e \u043d\u0430 \u043c\u0435\u0441\u0446\u0430, \u044f\u043a\u043e\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0430\u0441\u044f \u041c\u0435\u0441\u0446\u0430\u043c \u0427\u044d\u0440\u0430\u043f\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0437\u044f\u045e \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u0434\u0440\u043e\u0432\u044b \u043d\u0430 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0435 \u0456 \u045e\u0441\u043a\u043b\u0430\u045e \u043d\u0430 \u0406\u0441\u0430\u0430\u043a\u0430, \u0441\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406, \u043d\u0435\u0441\u0443\u0447\u044b \u0441\u0432\u043e\u0439 \u043a\u0440\u044b\u0436, \u0401\u043d \u0432\u044b\u0439\u0448\u0430\u045e \u043d\u0430 \u043c\u0435\u0441\u0446\u0430, \u044f\u043a\u043e\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0430\u0441\u044f \u041c\u0435\u0441\u0446\u0430\u043c \u0427\u044d\u0440\u0430\u043f\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"54","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 35, 4-6. 13: PL 16 [ed. 1845], 1078-1079. 1081)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0421\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b \u0411\u043e\u0436\u044b\u044f, \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c <\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0414\u0443\u0445\u0430 \u045e\u0442\u0430\u0439\u043c\u043e\u045e\u0432\u0430\u0435 \u045e\u0447\u044b\u043d\u043a\u0456 \u0446\u0435\u043b\u0430, \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c. \u0406 \u043d\u0456\u0447\u043e\u0433\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u0434\u0437\u0456\u045e\u043d\u0430\u0433\u0430. \u0411\u043e, \u043c\u0430\u044e\u0447\u044b \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0451\u043d \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0434\u0437\u0456\u0446\u0435\u043c \u0411\u043e\u0436\u044b\u043c. \u0406 \u044f\u043a \u0434\u0437\u0456\u0446\u044f \u0411\u043e\u0436\u0430\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043d\u0435 \u0434\u0443\u0445\u0430 \u043d\u044f\u0432\u043e\u043b\u0456, \u0430\u043b\u0435 \u0434\u0443\u0445\u0430 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0442\u043e \u0441\u0430\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043d\u0430\u0448\u0430\u043c\u0443 \u0434\u0443\u0445\u0443, \u0448\u0442\u043e \u043c\u044b &ndash; \u0434\u0437\u0435\u0446\u0456 \u0411\u043e\u0436\u044b\u044f. \u0413\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u045e \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445: &laquo;\u0410\u0431\u0431\u0430 \u041e\u0439\u0447\u0430!&raquo;, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u045e &laquo;\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e&raquo; (\u043f\u0430\u0440. \u0413\u0430\u043b 4, 6). \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0430\u0436\u043d\u044b\u043c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456, \u0451\u0441\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b &ndash; &laquo;\u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b \u0411\u043e\u0436\u044b\u044f, \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c&raquo; (\u0420\u044b\u043c 8, 17). \u0421\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0451\u0441\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0435 \u045e \u042f\u0433\u043e \u0445\u0432\u0430\u043b\u0435; \u0443 \u0445\u0432\u0430\u043b\u0435 \u0436 \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c, \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0437\u0430 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u0446\u044c \u043d\u0430\u0441 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f, \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0434\u0430\u0434\u0430\u0435, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u0430\u044f \u043d\u0435\u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u043c\u0430\u0435\u043c, \u043d\u044f\u0437\u043d\u0430\u0447\u043d\u0430\u044f \u0456 \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0437 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430\u0439 \u0437\u0430 \u043f\u0440\u044b\u043d\u044f\u0442\u044b \u0446\u044f\u0436\u0430\u0440; \u044f\u043d\u0430 \u0432\u044b\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0433\u043e\u0434\u043d\u044b\u044f \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u042f\u0433\u043e \u0445\u0432\u0430\u043b\u0443 \u0442\u0432\u0430\u0440\u0430\u043c \u0443 \u0442\u0432\u0430\u0440.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0446\u044c \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0441\u0446\u044c \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f, \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0434\u0430\u0434\u0430\u0435, \u0448\u0442\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0447\u0430\u043a\u0430\u0435 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0441\u044b\u043d\u043e\u045e \u0411\u043e\u0436\u044b\u0445. \u0426\u044f\u043f\u0435\u0440 \u044f\u043d\u043e \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430 \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u0430 \u043d\u0430\u0434\u0437\u0435\u0456. \u0411\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u044f\u0433\u043e \u0430\u0434 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u043d\u044f \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0456 \u0430\u0434\u043e\u0440\u044b\u0446\u044c \u0445\u0432\u0430\u043b\u043e\u044e \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445. \u0406 \u043a\u0430\u043b\u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u0430 \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445, \u0430\u0434\u043d\u0430 \u0456 \u0442\u0430\u044f \u0436 \u0441\u0432\u0430\u0431\u043e\u0434\u0430 \u0431\u0443\u0434\u0437\u0435 \u043b\u0451\u0441\u0430\u043c \u0456\u0445 \u0441\u0430\u043c\u044b\u0445 \u0456 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430\u0435 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u044f\u0448\u0447\u044d \u043d\u0435 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0443\u0441\u0451 \u0441\u0442\u0430\u0440\u044d\u043d\u043d\u0435 \u045e\u0437\u0434\u044b\u0445\u0430\u0435, \u0447\u0430\u043a\u0430\u044e\u0447\u044b \u0445\u0432\u0430\u043b\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f. \u041f\u0440\u0430\u0433\u043d\u0435 \u0434\u0430\u0446\u044c \u0441\u0432\u0435\u0442\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0443\u0445\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0431\u044b\u0446\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b\u043c \u0437 \u043d\u044f\u0432\u043e\u043b\u0456 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u043c\u0430\u0435 \u0437\u0430\u0440\u043e\u0434\u0430\u043a \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0443\u0437\u0434\u044b\u0445\u0430\u044e\u0446\u044c, \u0447\u0430\u043a\u0430\u044e\u0447\u044b \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0413\u044d\u0442\u0430\u0435 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435\u043c \u0443\u0441\u044f\u0433\u043e \u0446\u0435\u043b\u0430, \u043a\u0430\u043b\u0456 \u044f\u043a \u0443\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u0435 \u0434\u0437\u0456\u0446\u044f \u0411\u043e\u0436\u0430\u0435 \u0442\u0432\u0430\u0440\u0430\u043c \u0443 \u0442\u0432\u0430\u0440 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0433\u044d\u0442\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0414\u0430\u0431\u0440\u043e. \u0413\u044d\u0442\u0430\u0435 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456\u0441\u043d\u0443\u0435 \u045e\u0436\u043e \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u041f\u0430\u043d\u0430, \u0431\u043e \u0414\u0443\u0445 \u043a\u043b\u0456\u0447\u0430: &laquo;\u0410\u0431\u0431\u0430 \u041e\u0439\u0447\u0430!&raquo;, \u044f\u043a \u0447\u044b\u0442\u0430\u0435\u043c \u0443 &laquo;\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e&raquo; (\u043f\u0430\u0440. \u0413\u0430\u043b 4, 6). \u042f\u043d\u043e \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u043a\u0430\u043b\u0456 \u045e\u0441\u0435, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0433\u043e\u0434\u043d\u044b \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u0411\u043e\u0436\u0430\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u0443 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0441\u0446\u0456, \u043f\u0430\u0448\u0430\u043d\u0435 \u0456 \u0445\u0432\u0430\u043b\u0435. \u0422\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u0430\u0434\u0447\u0443\u0435 \u0441\u044f\u0431\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u043c. \u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430, \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u044e\u0447\u044b: &laquo;\u041c\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u044f \u043f\u0440\u0430\u0437 \u043d\u0430\u0434\u0437\u0435\u044e&raquo; (\u0420\u044b\u043c 8, 24). \u041d\u0430\u0434\u0437\u0435\u044f \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0430\u0441 \u0437\u0431\u0430\u045e\u043b\u044f\u0435, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0456 \u0432\u0435\u0440\u0430, \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0412\u0435\u0440\u0430 \u0442\u0432\u0430\u044f \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043b\u0430 \u0446\u044f\u0431\u0435&raquo; (\u041b\u043a 18, 42).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 8, 17b; 5, 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> M\u044b \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b \u0411\u043e\u0436\u044b\u044f, \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u0435\u0440\u043f\u0456\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c, \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0456 \u045e\u0441\u043b\u0430\u0432\u0456\u0446\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u044b\u044f \u042f\u0433\u043e \u043a\u0440\u044b\u0432\u0451\u0439, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u044f \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0430\u0434 \u0433\u043d\u0435\u0432\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u0435\u0440\u043f\u0456\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c, \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0456 \u045e\u0441\u043b\u0430\u0432\u0456\u0446\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"55","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 37. 38: PL 35, 2131-2132)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041d\u044f\u0445\u0430\u0439 \u0432\u043e\u0431\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0441\u0444\u0430\u0440\u043c\u0443\u0435\u0446\u0446\u0430 \u045e \u0432\u0430\u0441<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u044b \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430: &laquo;\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0442\u0430\u043a\u0456\u043c\u0456, \u044f\u043a \u044f&raquo; (\u0413\u0430\u043b 4, 12). \u0412\u043e\u0441\u044c \u0436\u0430 \u044f, \u0445\u043e\u0446\u044c \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0441\u044f \u0433\u0430\u0431\u0440\u044d\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u044f, \u043a\u0456\u0440\u0443\u044e\u0447\u044b\u0441\u044f \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435\u043c, \u0430\u0434\u043a\u0456\u0434\u0430\u044e \u0442\u043e\u0435, \u0448\u0442\u043e \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435. &laquo;\u0411\u043e \u0456 \u044f \u0442\u0430\u043a\u0456, \u044f\u043a \u0432\u044b&raquo; (\u0413\u0430\u043b 4, 12). \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u0417\u0430\u0442\u044b\u043c, \u043a\u0430\u0431 \u043d\u0435 \u043b\u0456\u0447\u044b\u043b\u0456 \u044f\u0433\u043e \u0432\u043e\u0440\u0430\u0433\u0430\u043c, \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0456\u043c, \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u0441\u0446\u044e \u0456 \u043f\u0430\u0432\u0430\u0433\u0430\u044e, \u043f\u0440\u0430 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0443\u044e \u043c\u0430\u0435 \u0434\u0430 \u0456\u0445. \u041a\u0430\u0436\u0430: &laquo;\u0412\u044b \u043c\u044f\u043d\u0435 \u043d\u0456\u0447\u044b\u043c \u043d\u0435 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u043b\u0456&raquo; (\u0413\u0430\u043b 4, 12). \u0413\u044d\u0442\u0430 \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0435 \u0442\u0430\u043a, \u044f\u043a \u0431\u044b \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0435 \u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u044f \u0445\u0430\u0447\u0443 \u0432\u0430\u0441 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0436 \u0434\u0430\u0434\u0430\u0435: &laquo;\u0414\u0437\u0435\u0446\u0456 \u043c\u0430\u0435&raquo; (\u0413\u0430\u043b 4, 19). \u041a\u0430\u0436\u0430 \u0442\u0430\u043a, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u044f\u043a \u0430\u0439\u0446\u0430. &laquo;\u042f \u0437\u043d\u043e\u045e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e \u0432\u0430\u0441, &ndash; \u043a\u0430\u0436\u0430, &ndash; \u043f\u0430\u043a\u0443\u043b\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0441\u0444\u0430\u0440\u043c\u0443\u0435\u0446\u0446\u0430 \u045e \u0432\u0430\u0441&raquo; (\u0413\u0430\u043b 4, 19). \u041a\u0430\u0436\u0430 \u0433\u044d\u0442\u0430, \u0430\u0442\u0430\u044f\u0441\u0430\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u0441\u044f\u0431\u0435 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0437 \u041c\u0430\u0446\u0456-\u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c, \u0431\u043e \u0456 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043a\u0430\u0436\u0430: &laquo;\u041c\u044b \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u0430\u043c\u0456 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0456, \u044f\u043a \u043a\u0430\u0440\u043c\u0456\u043b\u0456\u0446\u0430 \u0430\u043f\u044f\u043a\u0443\u0435\u0446\u0446\u0430 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456, \u0442\u0430\u043a \u0456 \u043c\u044b&raquo; (\u043f\u0430\u0440. 1 \u0422\u044d\u0441 2, 7).<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0436\u0430, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0444\u0430\u0440\u043c\u0443\u0435\u0446\u0446\u0430 \u045e \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u043c \u0434\u0430 \u043b\u0430\u0441\u043a\u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u044b, \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u043b\u0430\u0433\u043e\u0434\u043d\u044b\u043c \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c, \u044f\u043a\u0456 \u043d\u0435 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u043c\u0456, \u0448\u0442\u043e \u0432\u044b\u043d\u0456\u043a\u0430\u044e\u0446\u044c \u0437 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043d\u0456\u0447\u044b\u043c. \u0411\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u0430\u0441\u043a\u0430 \u0434\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0437\u0430\u0441\u043b\u0443\u0433\u0456, \u0442\u0430\u043a \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043c\u043e\u0436\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u044f\u0433\u043e &laquo;\u043d\u0430\u0439\u043c\u0435\u043d\u0448\u044b\u043c&raquo;, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u043e\u044e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0422\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0430\u0434\u043d\u0430\u043c\u0443 \u0437 \u0433\u044d\u0442\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u041c\u0430\u0456\u0445 \u043c\u0435\u043d\u0448\u044b\u0445, \u0432\u044b \u041c\u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0456&raquo; (\u041c\u0446 25, 40). \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0444\u0430\u0440\u043c\u0443\u0435\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u0435\u0446\u0446\u0430 \u0434\u0430 \u042f\u0433\u043e; \u0430 \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u0430\u0437 \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u044f\u0434\u043d\u0430\u0435\u0446\u0446\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u0435\u043d\u043d\u0435 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0430\u0442\u0430\u044f\u0441\u0430\u043c\u043b\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u044f\u043c\u0443 \u043d\u0430 \u0433\u044d\u0442\u0430 \u044f\u0433\u043e \u0441\u0442\u0430\u043d. &laquo;\u0425\u0442\u043e \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, &ndash; \u043a\u0430\u0436\u0430 \u042f\u043d \u0430\u043f\u043e\u0441\u0442\u0430\u043b, &ndash; \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0442\u0430\u043a, \u044f\u043a \u0401\u043d \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u045e&raquo; (1 \u042f\u043d 2, 6).<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044f\u0434\u043e\u043c\u0430, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u043c\u0430\u0446\u0456, \u043a\u0430\u0431 \u0442\u0430\u043c \u0440\u0430\u0437\u0432\u0456\u0432\u0430\u0446\u0446\u0430, \u0430 \u043a\u0430\u043b\u0456 \u045e\u0436\u043e \u0441\u0444\u0430\u0440\u043c\u0443\u0435\u0446\u0446\u0430, \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u0432\u0435\u0442. \u0422\u0430\u043c\u0443 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435: &laquo;\u042f \u0437\u043d\u043e\u045e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e \u0432\u0430\u0441, \u043f\u0430\u043a\u0443\u043b\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0441\u0444\u0430\u0440\u043c\u0443\u0435\u0446\u0446\u0430 \u045e \u0432\u0430\u0441&raquo;, \u0437\u043c\u0443\u0448\u0430\u0435 \u043d\u0430\u0441 \u0437\u0430\u0434\u0443\u043c\u0430\u0446\u0446\u0430. \u041c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0448\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0442\u0443\u0442 \u043a\u043b\u043e\u043f\u0430\u0442\u044b \u0456 \u043f\u0430\u043a\u0443\u0442\u044b, \u0441\u044f\u0440\u043e\u0434 \u044f\u043a\u0456\u0445 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u045e \u0456\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0443. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u0456\u0445 \u043d\u0430\u043d\u043e\u0432\u0430, \u043c\u0430\u044e\u0447\u044b \u043d\u0435\u0441\u043f\u0430\u043a\u043e\u0439 \u0437-\u0437\u0430 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b\u0445 \u043f\u0430\u043c\u044b\u043b\u0430\u043a, \u044f\u043a\u0456\u044f \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435 \u045e \u0456\u0445. \u041a\u043b\u043e\u043f\u0430\u0442 \u043f\u0440\u0430 \u0433\u0430\u043b\u0430\u0442\u0430\u045e \u0441\u044f\u0440\u043e\u0434 \u0456\u0441\u043d\u0443\u044e\u0447\u044b\u0445 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a, \u043a\u043b\u043e\u043f\u0430\u0442, \u044f\u043a\u0456 \u043f\u0430\u0440\u0430\u045e\u043d\u043e\u045e\u0432\u0430\u0435 \u0437 \u043f\u0440\u0430\u0446\u044d\u0441\u0430\u043c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f, \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u0446\u044c \u044f\u043c\u0443 \u0442\u0430\u043a \u0434\u043e\u045e\u0433\u0430, \u0430\u0436 &laquo;\u043f\u0430\u043a\u0443\u043b\u044c \u0443\u0441\u0435 \u043c\u044b \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430, \u0434\u0430 \u043c\u0435\u0440\u044b \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b, \u043a\u0430\u0431 \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u044b\u043b\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456, \u044f\u043a\u0456\u0445 \u0445\u0456\u0441\u0442\u0430\u0435 \u0456 \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u044b \u0432\u0435\u0446\u0435\u0440 \u0432\u0443\u0447\u044d\u043d\u043d\u044f\u045e&raquo; (\u043f\u0430\u0440. \u042d\u0444 4, 13-14).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u045e\u043b\u0430: &laquo;\u042f \u0437\u043d\u043e\u045e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e \u0432\u0430\u0441, \u043f\u0430\u043a\u0443\u043b\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0441\u0444\u0430\u0440\u043c\u0443\u0435\u0446\u0446\u0430 \u045e \u0432\u0430\u0441&raquo;, \u043d\u0435 \u0430\u0434\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u0434\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0432\u0435\u0440\u044b, \u0434\u0430 \u044f\u043a\u043e\u0439 \u044f\u043d\u044b \u045e\u0436\u043e \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b, \u0430\u043b\u0435 \u0434\u0430\u0442\u044b\u0447\u0430\u0446\u044c \u044f\u0435 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u044f \u0456 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0435\u043d\u043d\u044f. \u041f\u0440\u0430 \u0433\u044d\u0442\u0430\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0451\u043d \u043a\u0430\u0436\u0430 \u044f\u0448\u0447\u044d \u0440\u0430\u0437 \u0443 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b: &laquo;\u041d\u0430 \u043c\u043d\u0435 \u0448\u0442\u043e\u0434\u043d\u044f \u043b\u044f\u0436\u044b\u0446\u044c \u043a\u043b\u043e\u043f\u0430\u0442 \u0430\u0431 \u0443\u0441\u0456\u0445 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u0445. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0437\u043d\u0435\u043c\u0430\u0433\u0430\u0435, \u0446\u0456 \u044f \u043d\u0435 \u0437\u043d\u0435\u043c\u0430\u0433\u0430\u044e? \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0437\u0430\u0437\u043d\u0430\u0435 \u0437\u0433\u0430\u0440\u0448\u044d\u043d\u043d\u0435, \u0446\u0456 \u044f \u043d\u0435 \u043f\u0430\u043a\u0443\u0442\u0443\u044e?&raquo;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 4, 15; \u041f\u0440\u044b\u043f 4, 18<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0443\u0447\u044b \u0448\u0447\u044b\u0440\u044b\u043c\u0456 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0432\u0430 \u045e\u0441\u0456\u043c \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0413\u0430\u043b\u0430\u0432\u043e\u044e, &ndash; \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u0446\u0435\u0436\u043a\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u044f \u0434\u0430 \u0440\u0430\u043d\u0456\u0448\u043d\u044f\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u044f\u043a\u043e\u0435 \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u043d\u0430\u0431\u0456\u0440\u0430\u0435 \u043c\u043e\u0446 \u0430\u0436 \u0434\u0430 \u043f\u043e\u045e\u0434\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0430 \u045e\u0441\u0456\u043c \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0413\u0430\u043b\u0430\u0432\u043e\u044e, &ndash; \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"56","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo in Nativitate Domini 7, 2. 6: PL 54, 217-218. 220-221)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u0437\u043d\u0430\u0439 \u0441\u0432\u0430\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448 \u041f\u0430\u043d, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b \u045e \u0441\u0432\u0435\u0442 \u044f\u043a \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u045e \u0431\u044b\u0446\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0411\u043e\u0433\u0430\u043c. \u0401\u043d \u0434\u0430\u045e \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u043d\u043e\u0432\u0430\u043c\u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044e, \u0430 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0434\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0443. \u042f\u043a\u0456 \u0436 \u0440\u043e\u0437\u0443\u043c \u0431\u044b\u045e \u0431\u044b \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0456 \u044f\u043a\u0456 \u044f\u0437\u044b\u043a \u0437\u043c\u043e\u0433 \u0431\u044b \u0433\u043e\u0434\u043d\u0430 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u0433\u044d\u0442\u0443\u044e \u043b\u0430\u0441\u043a\u0443? \u041d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0430\u0434\u0448\u0443\u043a\u0430\u043b\u0430 \u0441\u0442\u0440\u0430\u0447\u0430\u043d\u0443\u044e \u043d\u044f\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u044c, \u0441\u0442\u0430\u0440\u0430\u0441\u0446\u044c \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456, \u043d\u0435\u0437\u043d\u0430\u0451\u043c\u044b\u044f \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0443\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u0443\u0434\u0437\u0456\u0441\u044f, \u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0456 \u043f\u0430\u0437\u043d\u0430\u0439 \u0441\u0432\u0430\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c! \u0423\u0441\u043f\u043e\u043c\u043d\u0456, \u0448\u0442\u043e \u0442\u044b \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430. \u0406 \u0445\u043e\u0446\u044c \u0443 \u0410\u0434\u0430\u043c\u0435 \u0433\u044d\u0442\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0431\u044b\u045e \u0441\u043a\u0430\u0436\u043e\u043d\u044b, \u0430\u0434\u043d\u0430\u043a \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0451\u043d \u0431\u044b\u045e \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u044b. \u0417 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435, \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0439 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430, \u0442\u0430\u043a, \u044f\u043a \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0448\u0441\u044f \u0437\u044f\u043c\u043b\u0451\u0439, \u043c\u043e\u0440\u0430\u043c, \u043d\u0435\u0431\u0430\u043c, \u043f\u0430\u0432\u0435\u0442\u0440\u0430\u043c, \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0456 \u0440\u0430\u043a\u043e\u044e. \u0417\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0432\u0430\u0440\u0442\u0430\u0435 \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u044f \u0456 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0435, \u0443\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0439 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0440\u043e\u043a\u0430\u043c \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0443\u0441\u0456\u043c \u0437\u0430\u043f\u0430\u043b\u0430\u043c \u0434\u0443\u0445\u0430 \u043f\u0440\u044b\u043c\u0456 \u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u043b\u043e, &laquo;\u044f\u043a\u043e\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0441\u0432\u0435\u0442&raquo; (\u042f\u043d 1, 19). \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043f\u0440\u0430 \u042f\u0433\u043e \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0440\u043e\u043a: &laquo;\u0413\u043b\u044f\u043d\u044c\u0446\u0435 \u043d\u0430 \u042f\u0433\u043e \u0456 \u043f\u0440\u0430\u0441\u0432\u044f\u0442\u043b\u0456\u0446\u0435\u0441\u044f, \u0456 \u0442\u0432\u0430\u0440\u044b \u0432\u0430\u0448\u044b\u044f \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0441\u043e\u0440\u0430\u043c\u0443&raquo; (\u041f\u0441 34 [33], 6). \u041a\u0430\u043b\u0456 \u043c\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0411\u043e\u0436\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439 \u0456 \u0414\u0443\u0445 \u0411\u043e\u0436\u044b \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441, \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0443 \u0434\u0443\u0448\u044b \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u0432\u0430\u0436\u043d\u044b\u043c \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u0441 \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0435 \u043d\u0430 \u043d\u0435\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043d\u0435 \u0445\u043e\u0447\u0430\u043c \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0446\u044c \u0432\u0430\u043c \u0446\u0456 \u0440\u0430\u0456\u0446\u044c, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043b\u0456 \u0442\u044b\u043c, \u0448\u0442\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430 \u0411\u043e\u0433\u0430\u043c; \u043d\u0435 \u0445\u043e\u0447\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u0434\u0443\u043c\u0430\u043b\u0456, \u043d\u0456\u0431\u044b\u0442\u0430 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0437 \u0442\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u044f\u043a\u0456\u044f \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0434\u043e\u0431\u0440\u044b \u0411\u043e\u0433, \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u0435 \u045e \u0447\u044b\u043c\u0441\u044c\u0446\u0456 \u0432\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u044b. \u041d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u043c\u044b \u0445\u043e\u0447\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u043a\u043e\u0436\u043d\u044b\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c, \u043a\u043e\u0436\u043d\u0430\u0439 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044e \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0440\u0430\u0437\u0443\u043c\u043d\u0430 \u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u044b. &laquo;\u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u0430\u0447\u043d\u0430\u0435, &ndash; \u044f\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, &ndash; \u0447\u0430\u0441\u043e\u0432\u0430\u0435, \u0430 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435 &ndash; \u0432\u0435\u0447\u043d\u0430\u0435&raquo; (2 \u041a\u0430\u0440 4, 18).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u043c\u0441\u044f \u0434\u043b\u044f \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0433\u0430, \u0430 \u043f\u0430\u0441\u043b\u044f \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u0435\u043c\u0441\u044f \u0434\u043b\u044f \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u0456, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u044b\u0432\u044f\u0437\u0432\u0430\u0446\u0446\u0430 \u0434\u0430 \u0447\u0430\u0441\u043e\u0432\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0432\u0435\u0447\u043d\u044b\u0445. \u0411\u0443\u0434\u0437\u0435\u043c \u0434\u0443\u043c\u0430\u0446\u044c \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0411\u043e\u0436\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0434\u0430\u043b\u0430 \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u043a\u0430\u0431 \u043c\u044b \u0437\u0431\u043b\u0456\u0437\u043a\u0443 \u043c\u0430\u0433\u043b\u0456 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u043f\u0440\u0430\u0434\u043c\u0435\u0442 \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c \u0441\u043b\u043e\u0432\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430: &laquo;\u0412\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0456 \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u0411\u043e\u0433\u0443! \u041a\u0430\u043b\u0456 \u0436 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435, \u0442\u0430\u0434\u044b \u0456 \u0432\u044b \u0437&rsquo;\u044f\u0432\u0456\u0446\u0435\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443 \u0445\u0432\u0430\u043b\u0435&raquo; (\u041a\u043b\u0441 3, 3), \u044f\u043a\u0456 \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 144 (143), 9; 118 (117), 28<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0436\u0430, \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e \u0422\u0430\u0431\u0435 \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u044e,<span style=\"color: #ff0000;\"> *<\/span> \u043d\u0430 \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u0441\u0442\u0440\u0443\u043d\u043d\u0430\u0439 \u0430\u0440\u0444\u0435 \u0437\u0430\u0439\u0433\u0440\u0430\u044e \u0422\u0430\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b &ndash; \u043c\u043e\u0439 \u0411\u043e\u0433, \u0431\u0443\u0434\u0443 \u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0426\u044f\u0431\u0435; \u0411\u043e\u0436\u0430 \u043c\u043e\u0439, \u0431\u0443\u0434\u0443 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0446\u044c \u0426\u044f\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430 \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u0441\u0442\u0440\u0443\u043d\u043d\u0430\u0439 \u0430\u0440\u0444\u0435 \u0437\u0430\u0439\u0433\u0440\u0430\u044e \u0422\u0430\u0431\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"57","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0431\u043b. \u0406\u0441\u0430\u0430\u043a\u0430, \u0430\u0431\u0430\u0442\u0430 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u0443 \u0421\u0442\u044d\u043b\u043b\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 31: PL 194, 1292-1293)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0430\u0432\u0430\u0433\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 <\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u043c\u044b \u043c\u0430\u043b\u0430 \u0440\u0443\u043f\u043b\u0456\u0432\u044b\u044f \u045e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u044b\u043c \u043f\u043e\u0448\u0443\u043a\u0443 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044e, \u043a\u0430\u0431, \u043d\u0435\u0441\u0443\u0447\u044b \u0446\u044f\u0436\u0430\u0440\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u0443\u043c\u0435\u043b\u0456 \u0430\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0442\u0430\u043c, \u0434\u0437\u0435 \u0433\u044d\u0442\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430? \u0411\u043e \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u0441 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0441\u043b\u043e\u0432\u0430\u043c\u0456: &laquo;\u041d\u0430\u0441\u0456\u0446\u0435 \u0446\u044f\u0436\u0430\u0440\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0456 \u0442\u0430\u043a \u0432\u044b\u043a\u0430\u043d\u0430\u0435\u0446\u0435 \u0437\u0430\u043a\u043e\u043d \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b&raquo; (\u0413\u0430\u043b 6, 2). \u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043a\u0430\u0436\u0430: &laquo;\u0426\u044f\u0440\u043f\u0456\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e \u043b\u044e\u0431\u043e\u0432\u0456&raquo; (\u043f\u0430\u0440. \u042d\u0444 4, 2). \u0423 \u0433\u044d\u0442\u044b\u043c, \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b \u0437\u0430\u043a\u043e\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u044e \u045e \u043c\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0442\u0430 \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u0432\u044b\u043f\u0440\u0430\u0432\u0456\u0446\u044c \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0430\u0431\u0441\u0442\u0430\u0432\u0456\u043d\u0430\u045e \u0430\u0431\u043e \u0444\u0456\u0437\u0456\u0447\u043d\u0430\u0439 \u0446\u0456 \u043c\u0430\u0440\u0430\u043b\u044c\u043d\u0430\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456, \u0447\u0430\u043c\u0443 \u043d\u0435 \u0437\u043d\u043e\u0448\u0443 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430? \u0427\u0430\u043c\u0443 \u043d\u0435 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u044e \u044f\u043c\u0443 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u041f\u0456\u0441\u0430\u043d\u043d\u044f: &laquo;\u0412\u0430\u0441 \u0431\u0443\u0434\u0443\u0446\u044c \u043a\u0430\u0440\u043c\u0456\u0446\u044c \u0456 \u043d\u0430\u0441\u0456\u0446\u044c \u043d\u0430 \u0440\u0443\u043a\u0430\u0445, \u0456 \u043d\u0430 \u043a\u0430\u043b\u0435\u043d\u044f\u0445 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0435\u0441\u0446\u0456\u0446\u044c \u0432\u0430\u0441&raquo; (\u0406\u0441 66, 12). \u0426\u0456 \u043d\u0435 \u0442\u0430\u043c\u0443 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u0448\u0442\u043e \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u043c\u043d\u0435 \u0442\u043e\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0430\u044f \u045e\u0441\u0451 \u0437\u043d\u043e\u0441\u0456\u0446\u044c, \u044f\u043a\u0430\u044f \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u044f \u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u044f?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0437\u0430\u043a\u043e\u043d \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043c\u0443\u043a\u0443 &laquo;\u045e\u0437\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u043d\u0430\u0448\u044b\u044f \u0456 \u043f\u0430\u043d\u0451\u0441 \u043d\u0430\u0448\u044b \u0445\u0432\u0430\u0440\u043e\u0431\u044b&raquo; (\u0406\u0441 53, 4), \u043d\u0451\u0441 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043b\u044e\u0431\u0456\u045e, \u0456 \u043b\u044e\u0431\u0456\u045e \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043d\u0451\u0441. \u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u0430\u0440\u043e\u0436\u0430 \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0442\u0430, \u044f\u043a\u043e\u043c\u0443 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0435 \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u0435, \u0445\u0442\u043e \u0441\u043e\u0447\u044b\u0446\u044c \u0437\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u044f\u0433\u043e \u0441\u043f\u0430\u0442\u044b\u043a\u043d\u0435\u043d\u043d\u0435\u043c, \u0442\u043e\u0439 \u0431\u0435\u0437 \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u044f \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u045e\u0441\u044f \u0437\u0430\u043a\u043e\u043d\u0443 \u0434&rsquo;\u044f\u0431\u043b\u0430 \u0456 \u0441\u043f\u0430\u045e\u043d\u044f\u0435 \u044f\u0433\u043e. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u044c\u043c\u0430 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b\u044f \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e, \u043f\u043e\u045e\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u043d\u044f\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u0456 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u0430\u044f \u0434\u0430\u0440\u043e\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u0439 \u0431\u044b \u044f\u043d\u0430 \u043d\u0435 \u0431\u044b\u043b\u0430, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0443, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043c\u0430\u0435 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430, \u0430 \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0411\u043e\u0433\u0430 &ndash; \u0456 \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430. \u0422\u043e\u043b\u044c\u043a\u0456 \u043b\u044e\u0431\u043e\u045e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0432\u044b\u0440\u0430\u0448\u0430\u0446\u044c, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0437\u0440\u0430\u0431\u0456\u0446\u044c, \u0430 \u0448\u0442\u043e \u043d\u0435, \u0448\u0442\u043e \u0437\u043c\u044f\u043d\u0456\u0446\u044c, \u0430 \u0448\u0442\u043e \u043d\u0435. \u041b\u044e\u0431\u043e\u045e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u044b\u043d\u0446\u044b\u043f\u0430\u043c \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u044d\u0442\u0430\u044e, \u0434\u0430 \u044f\u043a\u043e\u0439 \u0442\u0440\u044d\u0431\u0430 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430. \u041a\u0430\u043b\u0456 \u0448\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0448\u0447\u044b\u0440\u0430 \u0440\u043e\u0431\u0456\u0446\u0446\u0430 \u0434\u043b\u044f \u044f\u0435 \u0456 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0451\u044e, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u0434\u0430\u0441\u0446\u044c \u043d\u0430\u043c \u0433\u044d\u0442\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0442\u043e\u0439, \u043a\u0430\u043c\u0443 \u043c\u044b \u0431\u0435\u0437 \u044f\u0435 \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430, \u0456 \u0431\u0435\u0437 \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u043d\u0430\u043e\u0433\u0443\u043b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430\u043c, &ndash; \u0411\u043e\u0433, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 3, 11; \u0413\u0430\u043b 5, 14\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0432\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u044f, \u044f\u043a\u0443\u044e \u0432\u044b \u0447\u0443\u043b\u0456 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u043c\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e \u045e\u0432\u0435\u0441\u044c \u0417\u0430\u043a\u043e\u043d \u0441\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u045e \u0430\u0434\u043d\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u043c\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"61","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f\u045e&raquo; \u0441\u0432. \u042f\u0444\u0440\u044d\u043c\u0430, \u0434\u044b\u044f\u043a\u0430\u043d\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(1, 18-19: SCh 121, 52-53)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 &ndash; \u043d\u0435\u0432\u044b\u0447\u0430\u0440\u043f\u0430\u043b\u044c\u043d\u0430\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0437\u043c\u043e\u0436\u0430, \u041f\u0430\u043d\u0435, \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u043d\u0443\u0446\u044c \u0433\u043b\u044b\u0431\u0456\u043d\u044e \u0422\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u043e\u0432\u0430? \u041c\u044b \u0431\u043e\u043b\u044c\u0448 \u0440\u0430\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u043c\u0441\u044f \u0437 \u0456\u043c, \u0447\u044b\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u043c, \u0442\u0430\u043a \u044f\u043a \u0441\u043f\u0440\u0430\u0433\u043d\u0451\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043f&rsquo;\u0435 \u0432\u0430\u0434\u0443 \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u044b. \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0432\u044b\u044f\u045e\u043b\u044f\u0435 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u044f \u0430\u0434\u0446\u0435\u043d\u043d\u0456, \u0443 \u0437\u0430\u043b\u0435\u0436\u043d\u0430\u0441\u0446\u0456 \u0430\u0434 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044f\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u0433\u043e \u043f\u0430\u0437\u043d\u0430\u0435. \u041f\u0430\u043d \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u045e \u0441\u0432\u0430\u0451 \u0441\u043b\u043e\u0432\u0430 \u0440\u043e\u0437\u043d\u0430\u043a\u0430\u043b\u044f\u0440\u043e\u0432\u0430\u0439 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044e, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u044f\u0433\u043e \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u0435, \u043c\u043e\u0433 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u044f\u0433\u043e \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0435. \u0423 \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u043e\u0432\u0435 \u041f\u0430\u043d \u0437\u0430\u043c\u043a\u043d\u0443\u045e \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0437 \u043d\u0430\u0441 \u043c\u043e\u0433 \u0443 \u0442\u044b\u043c, \u0448\u0442\u043e \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435, \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u043a\u0430\u0440\u044b\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0434\u0440\u044d\u0432\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u0435 \u0437 \u043a\u043e\u0436\u043d\u0430\u0439 \u0433\u0430\u043b\u0456\u043d\u044b \u0434\u0430\u0435 \u0442\u0430\u0431\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043f\u043b\u043e\u0434. \u042f\u043d\u043e \u044f\u043a \u0442\u0430\u044f \u0430\u0434\u043a\u0440\u044b\u0442\u0430\u044f \u0441\u043a\u0430\u043b\u0430 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u044f\u043a\u0430\u044f \u045e\u0441\u0456\u043c \u0434\u0430\u0432\u0430\u043b\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u043d\u0430\u043f\u043e\u0439. &laquo;\u0423\u0441\u0435, &ndash; \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, &ndash; \u043f\u0456\u043b\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u043d\u0430\u043f\u043e\u0439, \u043f\u0456\u043b\u0456 \u0437 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0441\u043a\u0430\u043b\u044b&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 10, 4).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0445\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0437\u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0447\u0430\u0441\u0442\u043a\u0443 \u0433\u044d\u0442\u044b\u0445 \u0431\u0430\u0433\u0430\u0446\u0446\u044f\u045e, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0434\u0443\u043c\u0430\u0435, \u0448\u0442\u043e \u045e \u0411\u043e\u0436\u044b\u043c \u0441\u043b\u043e\u0432\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0451\u043d \u0441\u0430\u043c \u0437\u043d\u0430\u0439\u0448\u043e\u045e, \u0430\u043b\u0435 \u043d\u044f\u0445\u0430\u0439 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0441\u044f\u0440\u043e\u0434 \u043c\u043d\u043e\u0433\u0456\u0445 \u0441\u043a\u0430\u0440\u0431\u0430\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430 \u044f\u043c\u0443 \u045e\u0434\u0430\u043b\u043e\u0441\u044f \u045e\u0431\u0430\u0447\u044b\u0446\u044c. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0441\u043b\u043e\u0432\u0430 \u0441\u043b\u0430\u0431\u043e\u0435 \u0456 \u043d\u044f\u0434\u0443\u0436\u0430\u0435, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0456\u043c \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0447\u0430\u0441\u0442\u043a\u0430 \u0441\u0442\u0430\u043b\u0430 \u044f\u0433\u043e \u043b\u0451\u0441\u0430\u043c, \u043b\u0435\u043f\u0448 \u043d\u044f\u0445\u0430\u0439, \u043d\u044f\u0437\u0434\u043e\u043b\u044c\u043d\u044b \u0434\u0430 \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u0411\u043e\u0433\u0430 \u0437\u0430 \u042f\u0433\u043e \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0441\u0446\u044c. \u0422\u0430\u043c\u0443 \u0440\u0430\u0434\u0443\u0439\u0441\u044f \u043d\u0430\u0441\u044b\u0447\u044d\u043d\u043d\u0435\u043c, \u0430 \u043d\u0435 \u0441\u0443\u043c\u0443\u0439, \u0448\u0442\u043e \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0441\u043b\u043e\u0432\u0430 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0442\u0432\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0456. \u0425\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u0442\u043e\u0439 \u043f&rsquo;\u0435 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u043d\u0435 \u0441\u0443\u043c\u0443\u0435, \u0448\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0432\u044b\u043f\u0456\u0446\u044c \u043a\u0440\u044b\u043d\u0456\u0446\u044b. \u041b\u0435\u043f\u0448 \u043d\u044f\u0445\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u0435 \u0442\u0432\u0430\u0451 \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u0447\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0432\u044b\u0447\u0430\u0440\u043f\u0430\u0446\u044c \u043a\u0440\u044b\u043d\u0456\u0446\u0443. \u041a\u0430\u043b\u0456 \u043d\u0430\u0442\u0430\u043b\u0456\u0448 \u043f\u0440\u0430\u0433\u0443 \u0431\u0435\u0437 \u0432\u044b\u0447\u0430\u0440\u043f\u0430\u043d\u043d\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u043c\u043e\u0436\u0430\u0448 \u043f\u0456\u0446\u044c \u0437 \u044f\u0435 \u0437\u043d\u043e\u045e \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u043f\u0440\u0430\u0433\u043d\u0435\u0448. \u041a\u0430\u043b\u0456 \u0436 \u0437 \u043d\u0430\u0442\u0430\u043b\u0435\u043d\u043d\u0435\u043c \u043f\u0440\u0430\u0433\u0456 \u0432\u044b\u0447\u0430\u0440\u043f\u0430\u043b\u0430\u0441\u044f \u0456 \u043a\u0440\u044b\u043d\u0456\u0446\u0430, \u0442\u043e \u0442\u0430\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430 \u043d\u0430\u0434 \u0451\u0439 \u0441\u0442\u0430\u043b\u0430 \u0431 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0434\u0437\u044f\u043a\u0443\u0439 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f. \u0422\u043e\u0435, \u0447\u0430\u0433\u043e \u0442\u044b \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u045e \u0456 \u0437\u0430\u0431\u0440\u0430\u045e &ndash; \u0443\u0436\u043e \u0442\u0432\u0430\u044f \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c, \u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f, \u0447\u0430\u043a\u0430\u0435 \u0446\u044f\u0431\u0435. \u0422\u043e\u0435, \u0447\u0430\u0433\u043e \u0442\u044b \u043d\u0435 \u043c\u043e\u0433 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0430\u0434\u0440\u0430\u0437\u0443, \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448 \u043f\u0430\u0437\u043d\u0435\u0439, \u043a\u0430\u043b\u0456 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0435\u0448. \u041d\u0435 \u0456\u043c\u043a\u043d\u0456\u0441\u044f \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u0430\u0434\u0440\u0430\u0437\u0443 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u0456 \u043d\u0435 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044c \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0451\u0439 \u043b\u044f\u043d\u043e\u0442\u044b \u0430\u0434 \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u043c\u043e\u0436\u043d\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u043e\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 1, 25; \u043f\u0430\u0440. \u0411\u0430\u0440 4, 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0433\u044d\u0442\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0451\u0441\u0446\u044c \u0414\u043e\u0431\u0440\u0430\u044f \u041d\u0430\u0432\u0456\u043d\u0430, \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430\u044f \u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u043a\u043d\u0456\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e \u0411\u043e\u0436\u044b\u0445 \u0456 \u0417\u0430\u043a\u043e\u043d, \u044f\u043a\u0456 \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456; \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u044f\u0433\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435, \u0436\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0433\u044d\u0442\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0451\u0441\u0446\u044c \u0414\u043e\u0431\u0440\u0430\u044f \u041d\u0430\u0432\u0456\u043d\u0430, \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430\u044f \u0432\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"62","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo de diversis 15: PL 183, 577-579)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0428\u0443\u043a\u0430\u043d\u043d\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u043c\u0441\u044f \u043f\u0440\u0430 \u0435\u0436\u0443, \u044f\u043a\u0430\u044f \u043d\u0435 \u043f\u0441\u0443\u0435\u0446\u0446\u0430. \u041f\u0440\u0430\u0446\u0443\u0439\u043c\u0430, \u043a\u0430\u0431 \u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u041f\u0440\u0430\u0446\u0443\u0439\u043c\u0430 \u045e \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0443 \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0434\u044b\u043d\u0430\u0440 &ndash; \u0434\u0437\u0451\u043d\u043d\u044b \u0437\u0430\u0440\u043e\u0431\u0430\u043a. \u041f\u0440\u0430\u0446\u0443\u0439\u043c\u0430 \u045e \u0441\u0432\u044f\u0442\u043b\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u044f\u043a\u0430\u044f \u043a\u0430\u0436\u0430: &laquo;\u0425\u0442\u043e \u0441\u0430 \u043c\u043d\u043e\u0439 \u043f\u0440\u0430\u0446\u0443\u0435, \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u0446\u044c&raquo; (\u043f\u0430\u0440. \u0421\u0456\u0440 24, 21). &laquo;\u0420\u0430\u043b\u043b\u044f &mdash; \u0433\u044d\u0442\u0430 \u0441\u0432\u0435\u0442&raquo; (\u041c\u0446 13, 38), &ndash; \u043a\u0430\u0436\u0430 \u041f\u0440\u0430\u045e\u0434\u0430. \u041d\u0430 \u0451\u0439 \u043f\u0440\u0430\u0446\u0443\u0439\u043c\u0430. \u0423 \u0451\u0439 \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u0441\u043a\u0430\u0440\u0431. \u0417\u0434\u0430\u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u044f\u0433\u043e. \u0410 \u0433\u044d\u0442\u044b\u043c \u0441\u043a\u0430\u0440\u0431\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u0434\u0430\u0431\u044b\u0442\u0430\u044f \u0441\u0430 \u0441\u0445\u043e\u0432\u0456\u0448\u0447\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c. \u041c\u044b \u045e\u0441\u0435 \u0448\u0443\u043a\u0430\u0435\u043c \u044f\u0435, \u0443\u0441\u0435 \u043f\u0440\u0430\u0433\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u043a\u0430\u0436\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0432\u044b \u0445\u043e\u0447\u0430\u0446\u0435 \u043f\u044b\u0442\u0430\u0446\u0446\u0430 &ndash; \u043f\u044b\u0442\u0430\u0439\u0446\u0435\u0441\u044f, \u0432\u044f\u0440\u0442\u0430\u0439\u0446\u0435\u0441\u044f, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435&raquo; (\u0406\u0441 21, 12). \u041f\u044b\u0442\u0430\u0435\u0448\u0441\u044f, \u0430\u0434 \u0447\u0430\u0433\u043e \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430? \u042f\u043d\u0430 \u043a\u0430\u0436\u0430: &laquo;\u0410\u0434\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0430\u0434 \u0441\u0432\u0430\u0456\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e&raquo;. \u0422\u044b \u043a\u0430\u0436\u0430\u0448: &laquo;\u041a\u0430\u043b\u0456 \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0443 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u045e \u043c\u0430\u0456\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u0445, \u0434\u0437\u0435 \u0437\u043d\u0430\u0439\u0434\u0443 \u044f\u0435? \u0411\u043e \u043c\u0430\u044f \u0434\u0443\u0448\u0430 \u0433\u043e\u0440\u0430\u0447\u0430 \u0436\u0430\u0434\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u0406 \u043c\u0430\u043b\u0430 \u0451\u0439 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u044f\u0435, \u0430\u043b\u0435 \u043f\u0440\u0430\u0433\u043d\u0435, \u043a\u0430\u0431 \u044f\u043d\u0430 \u043c\u0435\u043b\u0430 &ldquo;\u043c\u0435\u0440\u0443 \u0434\u043e\u0431\u0440\u0443\u044e, \u0443\u0446\u0456\u0441\u043d\u0443\u0442\u0443\u044e, \u0443\u0442\u0440\u044d\u0441\u0435\u043d\u0443\u044e \u0456 \u0437 \u0432\u0435\u0440\u0445\u0430\u043c&rdquo; (\u043f\u0430\u0440. \u041b\u043a 6, 38). \u0422\u0430\u043a\u0443\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u044f \u043f\u0440\u044b\u043d\u044f\u045e \u0431\u044b&raquo;. \u0406 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430. \u0411\u043e \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u044f\u043a\u0456 \u043f\u043e\u045e\u043d\u044b \u0440\u0430\u0437\u0432\u0430\u0433\u0456 (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 3, 13). \u0422\u0430\u043c\u0443 \u0448\u0443\u043a\u0430\u0439, \u043f\u0430\u043a\u0443\u043b\u044c \u043c\u043e\u0436\u0430\u0448 \u044f\u0435 \u0437\u043d\u0430\u0439\u0441\u0446\u0456, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0439 \u044f\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u044f\u043d\u0430 \u0431\u043b\u0456\u0437\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0447\u0430\u0448 \u0432\u0435\u0434\u0430\u0446\u044c \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u0430 \u0431\u043b\u0456\u0437\u043a\u0430? &laquo;\u0411\u043b\u0456\u0437\u043a\u0430 \u0434\u0430 \u0446\u044f\u0431\u0435 \u0441\u043b\u043e\u0432\u0430, \u043d\u0430 \u0432\u0443\u0441\u043d\u0430\u0445 \u0442\u0432\u0430\u0456\u0445 \u0456 \u045e \u0441\u044d\u0440\u0446\u044b \u0442\u0432\u0430\u0456\u043c&raquo; (\u0420\u044b\u043c 10, 8). \u041d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u0456, \u043a\u0430\u0431 \u0442\u044b \u0448\u0443\u043a\u0430\u045e \u0443 \u0448\u0447\u044b\u0440\u0430\u0441\u0446\u0456 \u0441\u044d\u0440\u0446\u0430. \u0422\u0430\u043a \u0443 \u0441\u044d\u0440\u0446\u044b \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0430 \u0432\u0443\u0441\u043d\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0448 \u0440\u0430\u0437\u0432\u0430\u0433\u0430\u0439. \u0422\u0430\u043c\u0443 \u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044f \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u0446\u0430, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430, \u043a\u0430\u0431 \u043d\u0435 \u0430\u0434\u043a\u0456\u043d\u0443\u0446\u044c \u043d\u0430\u0437\u0430\u0434.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0442\u044b \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u043c\u0451\u0434, \u043a\u0430\u043b\u0456 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c! \u0422\u0430\u043c\u0443 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0439 \u0437 \u043c\u0435\u0440\u0430\u044e, \u043a\u0430\u0431, \u043f\u0435\u0440\u0430\u043d\u0430\u0441\u044b\u0446\u0456\u045e\u0448\u044b\u0441\u044f, \u043d\u0435 \u0430\u0434\u043a\u0456\u043d\u0443\u045e. \u0422\u0430\u043a \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0439, \u043a\u0430\u0431 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u0430\u0433\u043d\u0443\u045e. \u0411\u043e \u043a\u0430\u0436\u0430: &laquo;\u0422\u044b\u044f, \u0445\u0442\u043e \u043c\u044f\u043d\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435, \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u044f\u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c&raquo; (\u043f\u0430\u0440. \u0421\u0456\u0440 24, 20). \u041d\u0435 \u0434\u0443\u043c\u0430\u0439, \u0448\u0442\u043e \u043c\u0430\u0435\u0448 \u044f\u0435 \u0437\u0430\u0448\u043c\u0430\u0442. \u041d\u0435 \u0436\u0430\u0434\u0430\u0439 \u044f\u0435 \u043d\u0430\u0431\u044b\u0432\u0430\u0446\u044c \u0442\u0430\u043a, \u043a\u0430\u0431 \u0437-\u0437\u0430 \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430\u0441\u0446\u0456 \u0432\u044b\u043a\u0456\u043d\u0443\u0446\u044c \u044f\u0435 \u0456 \u043a\u0430\u0431 \u0437-\u0437\u0430 \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u043d\u043d\u044f \u044f\u0435 \u043f\u043e\u0448\u0443\u043a\u0443 \u043d\u0435 \u0431\u044b\u043b\u043e \u045e \u0446\u044f\u0431\u0435 \u0437\u0430\u0431\u0440\u0430\u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u0430\u0435\u0448. \u041f\u0430\u043a\u0443\u043b\u044c \u043c\u043e\u0436\u043d\u0430 \u044f\u0435 \u0437\u043d\u0430\u0439\u0441\u0446\u0456, \u043f\u0430\u043a\u0443\u043b\u044c \u044f\u043d\u0430 \u0431\u043b\u0456\u0437\u043a\u0430, \u043d\u0435\u043b\u044c\u0433\u0430 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u044f\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c. \u041d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u044f\u043a \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0421\u0430\u043b\u0430\u043c\u043e\u043d: &laquo;\u041d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u044f\u0431\u0435 \u0434\u043e\u0431\u0440\u0430 \u0430\u0434\u0447\u0443\u0432\u0430\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0437&rsquo;\u0435\u045e \u0437\u0430\u0448\u043c\u0430\u0442 \u043c\u0451\u0434\u0443; \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0448\u0443\u043a\u0430\u0435 \u0411\u043e\u0436\u0443\u044e \u0432\u0435\u043b\u0456\u0447, \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0432\u0430\u043b\u0435\u043d\u044b \u042f\u0433\u043e \u0445\u0432\u0430\u043b\u043e\u0439&raquo; (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 25, 27).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b, \u043d\u0430\u0432\u0430\u0442 \u0437\u043d\u0430\u0447\u043d\u0430 \u0431\u043e\u043b\u044c\u0448 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u0442\u0440\u044b\u0432\u0430\u043d\u043d\u0456 &ndash; \u044f\u043a \u0437\u0434\u0430\u0435\u0446\u0446\u0430 &ndash; \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u044b\u0445 \u0442\u0440\u043e\u0445 \u0432\u044b\u043f\u0430\u0434\u043a\u0430\u0445 \u0442\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u043f\u043e\u045e\u043d\u044b\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456: \u043a\u0430\u043b\u0456 \u0432\u044b\u0437\u043d\u0430\u0435\u0448 \u0443\u043b\u0430\u0441\u043d\u044b\u044f \u043f\u0440\u0430\u0432\u0456\u043d\u044b, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u0448 \u041f\u0430\u043d\u0430 \u0456 \u0434\u0437\u044f\u043a\u0443\u0435\u0448 \u042f\u043c\u0443, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435\u0448 \u0434\u0437\u0435\u043b\u044f \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u044f. &laquo;\u0411\u043e \u0441\u044d\u0440\u0446\u0430\u043c \u0432\u0435\u0440\u0430\u0446\u044c \u0434\u043b\u044f \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044f, \u0430 \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0432\u044b\u0437\u043d\u0430\u044e\u0446\u044c \u0434\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f&raquo; (\u0420\u044b\u043c 10, 10). \u0410 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: &laquo;\u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0440\u0430\u043c\u043e\u0432\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u0435 \u0441\u0430\u043c \u0441\u044f\u0431\u0435&raquo; (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 18, 12). \u0423 \u043f\u0430\u043b\u043e\u0432\u0435 \u043f\u0440\u0430\u043c\u043e\u0432\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u041f\u0430\u043d\u0430, \u0456 \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u043a\u0430\u043b\u0456 \u0445\u043e\u043f\u0456\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0446\u044c \u0432\u0430 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0434\u0440 7, 10. 11; 8, 2<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u0437\u0434\u0430\u0440\u043e\u045e\u0435 \u0456 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c, \u0456 \u0431\u043e\u043b\u044c\u0448 \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u043c\u0435\u0446\u044c \u044f\u0435 \u0447\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e. <span style=\"color: #ff0000;\">*<\/span> \u0410 \u0440\u0430\u0437\u0430\u043c \u0437 \u0451\u044e \u0434\u0430 \u043c\u044f\u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e\u0441\u0435 \u0434\u0430\u0431\u0440\u043e\u0442\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0448\u0443\u043a\u0430\u045e \u044f\u0435 \u0437 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456, \u044f \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e \u044f\u0435 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u0440\u0430\u0437\u0430\u043c \u0437 \u0451\u044e \u0434\u0430 \u043c\u044f\u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e\u0441\u0435 \u0434\u0430\u0431\u0440\u043e\u0442\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"63","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0440\u0430\u043c\u043e\u0432\u0430 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0430\u0440\u044b\u044f\u043d\u0430\u045e&raquo; \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 2, 78. 81-82: PG 26, 311. 319)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u0437\u043d\u0430\u0439\u043c\u0430 \u0410\u0439\u0446\u0430 \u043f\u0440\u0430\u0437 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, <\/span><\/em><br \/><em><span style=\"color: #ff0000;\">\u044f\u043a\u0430\u044f \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044b\u043b\u0430 \u0456 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u044f \u0411\u043e\u0436\u0430\u044f \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u0441\u0442\u0432\u0430\u0440\u0430\u043b\u044c\u043d\u0456\u0446\u0430 \u0456 \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u045e\u0441\u044f\u0433\u043e. \u0411\u043e \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0422\u044b \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043f\u0440\u0430\u0437 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c&raquo;, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: &laquo;\u0417\u044f\u043c\u043b\u044f \u043f\u043e\u045e\u043d\u0430\u044f \u0422\u0432\u0430\u0456\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e&raquo; (\u043f\u0430\u0440. \u041f\u0441 103 [102], 24). \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u0431 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0456, \u0430\u043b\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0456 \u0434\u043e\u0431\u0440\u0430, \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0411\u043e\u0433\u0443 \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u0446\u044c \u0456\u0445 \u0441\u0432\u0430\u0451\u0439 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044e, \u0456 \u045e \u043a\u043e\u0436\u043d\u044b\u043c \u0437 \u0456\u0445, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0440\u0430\u0437\u0430\u043c \u0432\u044b\u0446\u0456\u0441\u043d\u0443\u0446\u044c \u043d\u0456\u0431\u044b \u0444\u043e\u0440\u043c\u0443 \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u042f\u0435 \u0432\u043e\u0431\u0440\u0430\u0437\u0430, \u0456 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u044b\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e, \u0441\u0442\u0430\u043b\u0456 \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u0431\u044b\u0446\u044c \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043d\u0430\u0448\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0421\u043b\u043e\u0432\u0430, \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u0433\u044d\u0442\u0430\u043a \u0456 \u043d\u0430\u0448\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0421\u043b\u043e\u0432\u0430, \u0443\u0432\u0430\u0441\u043e\u0431\u043b\u0435\u043d\u0430\u0439 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u044f\u043d\u0430 \u0434\u0430\u0435 \u043d\u0430\u043c \u0443\u043c\u0435\u043d\u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u043e\u0431\u0456\u0446\u044c \u043d\u0430\u0441 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c\u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0441\u0442\u0432\u0430\u0440\u0430\u043b\u044c\u043d\u0443\u044e \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u043f\u0440\u0430\u0437 \u044f\u043a\u0443\u044e \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0410\u0439\u0446\u0430. \u0411\u043e \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0425\u0442\u043e \u0432\u044b\u0437\u043d\u0430\u0435 \u0421\u044b\u043d\u0430, \u043c\u0430\u0435 \u0456 \u0410\u0439\u0446\u0430&raquo; (1 \u042f\u043d 2, 23), \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: &laquo;\u0425\u0442\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u041c\u044f\u043d\u0435, \u043f\u0440\u044b\u043c\u0430\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435&raquo; (\u041c\u0446 10, 40). \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0433\u044d\u0442\u0430\u0439 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0431\u044b\u043b\u043e \u045e \u043d\u0430\u0441 \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u0445, \u0442\u0430\u043c\u0443 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0446\u0430\u043b\u043a\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043f\u0440\u044b\u045e\u043b\u0430\u0448\u0447\u0430\u0432\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u0430\u0435 \u0433\u044d\u0442\u0430\u0435 \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0430\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0432\u0435\u0442 \u0441\u0432\u0430\u0451\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e \u0411\u043e\u0433\u0430 \u045e \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0439, \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0411\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445&raquo; (1 \u041a\u0430\u0440 1, 21). \u0422\u0430\u043c\u0443 \u0411\u043e\u0433 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0443\u0436\u043e \u0434\u0430\u045e\u0436\u044d\u0439 \u0431\u044b\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043d\u044b\u043c, \u044f\u043a \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c, \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0456 \u0446\u0435\u043d\u044e \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e, \u043a\u0430\u0431 \u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u044f \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u0446\u0435\u043b\u0430, \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0432\u0430 \u0423\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u0443\u044e \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0443\u0441\u0435 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0433\u044d\u0442\u0430\u044f \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430, \u044f\u043a\u0430\u044f \u045e\u0436\u043e \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0443 \u0441\u0432\u0430\u0456\u043c \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0456 \u0431\u044b\u043b\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044e (\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0456 \u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u0431\u044b\u043b\u0430 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430), \u0446\u044f\u043f\u0435\u0440 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430 \u0441\u044f\u0431\u0435, \u0430 \u043f\u0440\u0430\u0437 \u0441\u044f\u0431\u0435 &ndash; \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0439\u0446\u0430. \u041f\u043e\u0442\u044b\u043c \u0442\u0430\u044f \u0441\u0430\u043c\u0430\u044f \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c, &ndash; \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u042f\u043d, &ndash; \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0448\u044b \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u0437 \u043d\u044f\u0432\u043e\u043b\u0456, \u044f\u0448\u0447\u044d \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0435\u0439 \u0432\u044b\u044f\u0432\u0456\u043b\u0430 \u0441\u044f\u0431\u0435, \u0430 \u043f\u0440\u0430\u0437 \u0441\u044f\u0431\u0435 &ndash; \u0410\u0439\u0446\u0430. \u0410\u0434\u0441\u044e\u043b\u044c \u042f\u0435 \u0441\u043b\u043e\u0432\u044b: &laquo;\u0423\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0426\u044f\u0431\u0435, \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430&raquo; (\u043f\u0430\u0440. \u042f\u043d 17, 3).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u045e\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430 \u042f\u0433\u043e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c. \u0411\u043e \u0430\u0434\u043d\u043e \u0451\u0441\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0410\u0439\u0446\u0430 \u043f\u0440\u0430\u0437 \u0421\u044b\u043d\u0430 \u0456 \u0421\u044b\u043d\u0430 \u043f\u0440\u0430\u0437 \u0410\u0439\u0446\u0430. \u0410\u0439\u0446\u0435\u0446 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u045e \u0421\u044b\u043d\u0435, \u0430 \u0421\u044b\u043d \u0443\u0441\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043c\u0430\u0435 \u045e \u0410\u0439\u0446\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u042f \u0431\u044b\u043b\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c \u0437 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c&raquo; (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 8, 30).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 2, 6. 9; \u041c\u0446 23, 10b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u0432\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435 \u045e \u0406\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u045e \u0406\u043c \u0446\u044f\u043b\u0435\u0441\u043d\u0430 \u0436\u044b\u0432\u0435 \u045e\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0434\u0437\u0456\u043d \u0443 \u0432\u0430\u0441 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a &mdash; \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u045e \u0406\u043c \u0446\u044f\u043b\u0435\u0441\u043d\u0430 \u0436\u044b\u0432\u0435 \u045e\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"64","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e&raquo; \u041f\u0440\u0430\u043a\u043e\u043f\u0430 \u0437 \u0413\u0430\u0437\u044b, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 9: PG 87-1, 1299-1303)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0430\u044f \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u043b\u0430 \u043d\u0430\u043c \u0432\u044f\u0447\u044d\u0440\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0437\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0430 \u0434\u043e\u043c \u0441\u0432\u043e\u0439&raquo; (\u041f\u0440\u044b\u043f 9, 1). \u0421\u0430\u043c\u0430\u0456\u0441\u043d\u0430\u044f \u043c\u043e\u0446 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u043b\u0430 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u044f\u043a \u0436\u044b\u043b\u043b\u0451 \u045e\u0432\u0435\u0441\u044c \u0441\u0443\u0441\u0432\u0435\u0442, \u0443 \u044f\u043a\u0456\u043c \u0436\u044b\u0432\u0435 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u0434\u0437\u0435\u044f\u043d\u043d\u0435. \u042f\u043d\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0433\u0430 \u043d\u0430 \u0432\u043e\u0431\u0440\u0430\u0437 \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435, \u0451\u043d \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0434\u0430 \u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0456 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0406 \u0432\u044b\u0447\u0430\u0441\u0430\u043b\u0430 \u0441\u0435\u043c \u043a\u0430\u043b\u043e\u043d\u0430\u045e \u044f\u0433\u043e&raquo; (\u041f\u0440\u044b\u043f 9, 1). \u0421\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u043c\u0443, \u0430 \u043f\u0430\u0441\u043b\u044f \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u043c\u0443 \u043d\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0411\u043e\u0433 \u0434\u0430\u045e \u0441\u0435\u043c \u0434\u0430\u0440\u043e\u045e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043a\u0430\u0431 \u0432\u0435\u0440\u044b\u045e \u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u045e \u042f\u0433\u043e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u044b\u043c \u0434\u0430\u0440\u0430\u043c \u0446\u043d\u043e\u0442\u0430 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f, \u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0446\u043d\u043e\u0446\u0435. \u0406 \u0442\u0430\u043a \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u045e \u043f\u043e\u045e\u043d\u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u043f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u045e\u0434\u0437\u0435\u043b \u0443 \u0437\u0432\u044b\u0448\u043f\u0440\u044b\u0440\u043e\u0434\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u0445 \u043c\u043e\u0446\u0430\u044e \u043d\u044f\u0437\u043b\u043e\u043c\u043d\u0430\u0439 \u0432\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u044f \u0434\u0430\u0440\u044b \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0440\u043e\u0437\u0443\u043c\u0443. \u041c\u0443\u0436\u043d\u0430\u0441\u0446\u044c \u0434\u0430\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u0434\u0430\u043d\u0430 \u0448\u0443\u043a\u0430\u0446\u044c \u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u0443\u0441\u044f\u0433\u043e, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043d\u0430\u0442\u0443\u0440\u0430\u044e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0448\u0443\u043a\u0430\u0446\u044c \u0432\u043e\u043b\u0456 \u0411\u043e\u0436\u0430\u0439, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u044f\u043a\u043e\u0439 \u0443\u0441\u0451 \u0431\u044b\u043b\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430. \u0420\u0430\u0434\u0430 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u044b\u044f, \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u044f \u0411\u043e\u0436\u044b\u044f \u043d\u0430\u043c\u0435\u0440\u044b \u0456 \u0440\u0430\u0456\u0446\u044c \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0456\u0445 \u0443 \u0434\u0443\u043c\u043a\u0430\u0445, \u0441\u043b\u043e\u0432\u0430\u0445 \u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u0445. \u0420\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0447\u044b\u043d\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u043f\u0440\u044b\u043c\u0430\u0435\u043c \u0433\u044d\u0442\u044b\u044f \u043d\u0430\u043c\u0435\u0440\u044b \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u043c, \u0430\u0434\u043a\u0456\u0434\u0432\u0430\u044e\u0447\u044b \u045e\u0441\u0451, \u0448\u0442\u043e \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0417\u043c\u044f\u0448\u0430\u043b\u0430 \u0432\u0456\u043d\u043e \u0441\u0432\u0430\u0451 \u0456 \u0441\u0442\u043e\u043b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0430&raquo; (\u041f\u0440\u044b\u043f 9, 2). \u0423 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u0443 \u044f\u043a\u0456\u043c \u043d\u0456\u0431\u044b \u045e \u043a\u0435\u043b\u0456\u0445\u0443 \u0437\u043c\u044f\u0448\u0430\u043d\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430 \u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u044f, \u0411\u043e\u0433 \u043f\u0430\u044f\u0434\u043d\u0430\u045e \u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u045e \u0437 \u0432\u0435\u0434\u0430\u043d\u043d\u0435\u043c \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u044f\u043a \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u0441\u0443\u0441\u0432\u0435\u0442\u0443. \u041f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u044b\u0445 \u0440\u044d\u0447\u0430\u045e \u0443\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043d\u0456\u0431\u044b \u0432\u0456\u043d\u043e, \u0443 \u0441\u0442\u0430\u043d \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u044f. \u0414\u0430\u044e\u0447\u044b \u0441\u044f\u0431\u0435 \u044f\u043a \u0445\u043b\u0435\u0431 \u0437 \u043d\u0435\u0431\u0430, \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0448\u044b, \u043d\u0430\u0432\u0443\u043a\u0430 \u0441\u043f\u0430\u0442\u0430\u043b\u044f\u0435 \u043f\u0440\u0430\u0433\u0443 \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u0446\u044c. \u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u0440\u044b\u0445\u0442\u0443\u0435 \u044f\u043a \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0434\u043b\u044f \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0432\u044f\u0447\u044d\u0440\u044b \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435 \u045e \u0451\u0439 \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0412\u044b\u0441\u043b\u0430\u043b\u0430 \u0441\u043b\u0443\u0436\u0430\u043d\u0430\u043a \u0441\u0432\u0430\u0456\u0445, \u043a\u0430\u0431 \u0437\u0430\u043f\u0440\u0430\u0448\u0430\u043b\u0456 \u043d\u0430 \u0433\u0430\u0441\u0446\u0456\u043d\u0443&raquo; (\u043f\u0430\u0440. \u041c\u0446 22, 3). \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0441\u043b\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u0445 \u042f\u0433\u043e \u0431\u043e\u0441\u043a\u0430\u0439 \u0432\u043e\u043b\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u0414\u043e\u0431\u0440\u0443\u044e \u041d\u0430\u0432\u0456\u043d\u0443, \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u0437\u0430 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u044b \u0456 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b \u0437\u0430\u043a\u043e\u043d, \u0431\u043e \u044f\u043d\u044b \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0434 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u041f\u0440\u0430\u0437 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u043a\u0435\u043b\u0456\u0445\u0443, \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435, \u0431\u0435\u0437 \u0437\u043c\u044f\u0448\u0430\u043d\u043d\u044f, \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0443 \u0430\u0434\u043d\u043e\u0439 \u0430\u0441\u043e\u0431\u0435. \u0412\u0443\u0441\u043d\u0430\u043c\u0456 \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u0443\u0433 \u043a\u043b\u0456\u0447\u0430: &laquo;\u041a\u0430\u043b\u0456 \u043a\u0430\u043c\u0443 \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u0432\u0435\u0434\u0430\u045e, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435&raquo;. \u0427\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u043e\u043c\u0443 \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u0432\u0435\u0434\u0430\u045e, \u0433\u044d\u0442\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0443\u043c\u0430\u0435, \u0448\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u0411\u043e\u0433\u0430. \u041d\u044f\u0445\u0430\u0439 \u0430\u0434\u043a\u0456\u043d\u0435 \u0441\u0432\u0430\u044e \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u0437\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u041c\u044f\u043d\u0435 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0456 \u043f\u0430\u0437\u043d\u0430\u0435, \u0448\u0442\u043e \u042f &ndash; \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0456 \u041f\u0430\u043d \u0443\u0441\u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u043c\u0443 \u044f\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u043b\u0430: &ldquo;\u0425\u0430\u0434\u0437\u0456\u0446\u0435, \u0435\u0448\u0446\u0435 \u0445\u043b\u0435\u0431 \u043c\u043e\u0439, \u043f\u0456\u0446\u0435 \u0432\u0456\u043d\u043e, \u044f\u043a\u043e\u0435 \u0437\u043c\u044f\u0448\u0430\u043b\u0430&rdquo;&raquo; (\u041f\u0440\u044b\u043f 9, 4). \u0422\u044b\u043c, \u043a\u0430\u043c\u0443 \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u045e, \u0448\u0442\u043e \u0432\u044b\u043d\u0456\u043a\u0430\u044e\u0446\u044c \u0437 \u0432\u0435\u0440\u044b, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u043c\u0430\u044e\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043d\u0430\u0432\u0443\u043a\u0443, \u043a\u0430\u0436\u0430: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0439\u0446\u0435 \u043c\u0430\u0451 \u0426\u0435\u043b\u0430, \u044f\u043a\u043e\u0435, \u044f\u043a \u0445\u043b\u0435\u0431, \u0443\u043c\u0430\u0446\u0443\u0435 \u0432\u0430\u0448\u0443\u044e \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044c; \u043f\u0456\u0446\u0435 \u043c\u0430\u044e \u041a\u0440\u043e\u045e, \u044f\u043a\u0430\u044f, \u0430\u0434\u043e\u0440\u0432\u0430\u044e\u0447\u044b \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c, \u0443\u0437\u0432\u0435\u0441\u044f\u043b\u0456\u0446\u044c \u0432\u0430\u0441 \u044f\u043a \u0432\u0456\u043d\u043e \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456. \u0411\u043e \u044f \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0437\u043c\u044f\u0448\u0430\u043b\u0430 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044c \u0437 \u041a\u0440\u044b\u0432\u0451\u044e \u0434\u043b\u044f \u0432\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0440\u044b\u043f 9, 1. 2b; \u042f\u043d 6, 56<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0437\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0430 \u0434\u043e\u043c \u0441\u0432\u043e\u0439 \u0456 \u0432\u044b\u0447\u0430\u0441\u0430\u043b\u0430 \u0441\u0435\u043c \u043a\u0430\u043b\u043e\u043d\u0430\u045e \u044f\u0433\u043e, <span style=\"color: #ff0000;\">*<\/span> \u0437\u043c\u044f\u0448\u0430\u043b\u0430 \u0432\u0456\u043d\u043e \u0441\u0432\u0430\u0451 \u0456 \u0441\u0442\u043e\u043b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0442\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435 \u041c\u0430\u0451 \u0426\u0435\u043b\u0430 \u0456 \u043f&rsquo;\u0435 \u041c\u0430\u044e \u041a\u0440\u043e\u045e, \u0442\u0440\u044b\u0432\u0430\u0435 \u045e\u0432\u0430 \u041c\u043d\u0435, \u0430 \u042f \u045e \u0456\u043c, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u043c\u044f\u0448\u0430\u043b\u0430 \u0432\u0456\u043d\u043e \u0441\u0432\u0430\u0451 \u0456 \u0441\u0442\u043e\u043b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"65","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 36, 65-66: \u0421SEL 64, 123-125)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0410\u0434\u043a\u0440\u044b\u0439 \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u043d\u0430 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043a\u0456\u0440\u0443\u0435 \u043d\u0430\u0448\u044b\u043c\u0456 \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0456 \u0441\u044d\u0440\u0446\u0430\u043c, \u043d\u044f\u0445\u0430\u0439 \u044f\u0437\u044b\u043a \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0435. \u0417\u0430\u043a\u043e\u043d \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u045e \u0441\u044d\u0440\u0446\u044b \u0442\u0432\u0430\u0456\u043c. \u0422\u0430\u043c\u0443 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430 \u0442\u0430\u0431\u0435: &laquo;\u0411\u0443\u0434\u0437\u0435\u0448 \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u0433\u044d\u0442\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0434\u043e\u043c\u0430, \u043f\u0430\u0434\u0447\u0430\u0441 \u0442\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430, \u043a\u043b\u0430\u0434\u0443\u0447\u044b\u0441\u044f \u0441\u043f\u0430\u0446\u044c \u0456 \u045e\u0441\u0442\u0430\u044e\u0447\u044b&raquo; (\u043f\u0430\u0440. \u0414\u0440\u0433 6, 7). \u0422\u0430\u043c\u0443 \u0433\u0430\u0432\u043e\u0440\u044b\u043c \u043f\u0440\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u0431\u043e \u0401\u043d \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044e, \u0421\u043b\u043e\u0432\u0430\u043c, \u0421\u043b\u043e\u0432\u0430\u043c \u0441\u0430\u043c\u043e\u0433\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0410\u0434\u043a\u0440\u044b\u0439 \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u043d\u0430 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430&raquo;. \u0411\u043e\u0436\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0434\u044b\u0445\u0430\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u042f\u0433\u043e \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0430\u0434 \u0456\u043c. \u041f\u0440\u0430 \u041f\u0430\u043d\u0430 \u0433\u0430\u0432\u043e\u0440\u044b\u043c \u0437\u0430\u045e\u0441\u0451\u0434\u044b. \u041a\u0430\u043b\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u043c \u043f\u0440\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c &ndash; \u0401\u043d \u0451\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u043c \u043f\u0440\u0430 \u0446\u043d\u043e\u0442\u0443, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0441\u043f\u0430\u043a\u043e\u0439 &ndash; \u0401\u043d \u0451\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u043c \u0430\u0431 \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0436\u044b\u0446\u0446\u0456 \u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456 &ndash; \u0401\u043d \u0451\u0441\u0446\u044c \u0443\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0410\u0434\u043a\u0440\u044b\u0439 \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u043d\u0430 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430&raquo;. \u0422\u044b \u0430\u0434\u043a\u0440\u044b\u0439, \u0430 \u0401\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u0446\u044c. \u0414\u0430\u0432\u0456\u0434 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0436\u0430: &laquo;\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u044e, \u0448\u0442\u043e \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u041f\u0430\u043d&raquo; (\u043f\u0430\u0440. \u041f\u0441 85 [84], 9), \u0430 \u0421\u044b\u043d \u0411\u043e\u0436\u044b: &laquo;\u0428\u044b\u0440\u043e\u043a\u0430 \u0440\u0430\u0441\u043a\u0440\u044b\u0439 \u0432\u0443\u0441\u043d\u044b, \u043a\u0430\u0431 \u042f \u0456\u0445 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e&raquo; (\u041f\u0441 81 [80], 11). \u0410\u0434\u043d\u0430\u043a \u043d\u0435 \u045e\u0441\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u044f \u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u043f\u0430\u045e\u043d\u0430\u0442\u0443 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u044f\u043a \u0421\u0430\u043b\u0430\u043c\u043e\u043d, \u044f\u043a \u0414\u0430\u043d\u0456\u044d\u043b\u044c. \u0410\u043b\u0435 \u045e\u0441\u0456\u043c, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u044f, \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0434\u0443\u0445 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456; \u0443\u0441\u0456\u043c, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c. \u041a\u0430\u043b\u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u0448, \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448 \u0434\u0443\u0445\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0434\u043e\u043c\u0430&raquo; (\u0414\u0440\u0433 6, 7), \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439 \u0456 \u043a\u0430\u0436\u044b \u043f\u0440\u0430 \u0411\u043e\u0436\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b. &laquo;\u0414\u043e\u043c&raquo; \u043c\u043e\u0436\u0430\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u044f\u043a &laquo;\u041a\u0430\u0441\u0446\u0451\u043b&raquo;, \u043c\u043e\u0436\u0430\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u044f\u043a \u043d\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0443 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435\u043c \u0434\u0430 \u0441\u044f\u0431\u0435. \u0410\u0434\u043d\u0430\u043a \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0439 \u0437 \u0440\u0430\u0437\u0432\u0430\u0433\u0430\u0439, \u043a\u0430\u0431 \u043d\u0435 \u0442\u0440\u0430\u043f\u0456\u0446\u044c \u0443 \u0433\u0440\u044d\u0445 \u0448\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u044f. \u041a\u0430\u043b\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0448\u0441\u044f \u0434\u043e\u043c\u0430, \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u0439 \u0437 \u0441\u0430\u0431\u043e\u044e, \u044f\u043a \u0431\u044b \u043c\u0435\u045e \u0441\u044f\u0431\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u0446\u044c. \u041a\u0430\u043b\u0456 \u0442\u044b \u045e \u0434\u0430\u0440\u043e\u0437\u0435, \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0439, \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u0446\u044c \u0431\u044f\u0437\u0434\u0437\u0435\u0439\u0441\u043d\u044b\u043c. \u0411\u0443\u0434\u0437\u0435\u0448 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0443 \u0434\u0430\u0440\u043e\u0437\u0435, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u0431\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0451\u0441\u0446\u044c \u0434\u0430\u0440\u043e\u0433\u0430\u0439. \u041f\u0430\u0434\u0447\u0430\u0441 \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430 \u043a\u0430\u0436\u044b \u0441\u0430\u0431\u0435 \u0456 \u0425\u0440\u044b\u0441\u0442\u0443. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u044f\u043a \u0431\u044b \u0442\u044b \u043c\u043e\u0433 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u0446\u044c \u0434\u0430 \u042f\u0433\u043e: &laquo;\u0425\u0430\u0447\u0443, \u043a\u0430\u0431 \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u043c\u0430\u043b\u0456\u043b\u0456\u0441\u044f \u043d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u0443\u0437\u0434\u044b\u043c\u0430\u044e\u0447\u044b \u0447\u044b\u0441\u0442\u044b\u044f \u0440\u0443\u043a\u0456 \u0431\u0435\u0437 \u0433\u043d\u0435\u0432\u0443 \u0456 \u0441\u043f\u0440\u044d\u0447\u0430\u043a&raquo; (1 \u0426\u0456\u043c 2, 8). \u041f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0439, \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430, \u043a\u0430\u043b\u0456 \u0456\u0434\u0437\u0435\u0448 \u0441\u043f\u0430\u0446\u044c, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u0441\u043d\u0443\u0446\u044c \u0443 \u0441\u043c\u0435\u0440\u0446\u0456. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0448\u0442\u043e \u0442\u0430\u0434\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u041d\u0435 \u0434\u0430\u043c \u0437\u0430\u0441\u043d\u0443\u0446\u044c \u0441\u0432\u0430\u0456\u043c \u0432\u0430\u0447\u0430\u043c \u0456 \u043f\u0430\u0432\u0435\u043a\u0430\u043c \u043c\u0430\u0456\u043c \u0437\u0430\u0434\u0440\u0430\u043c\u0430\u0446\u044c, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0443 \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u0448\u0430\u0442\u0440\u0430 \u0434\u043b\u044f \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u042f\u043a\u0443\u0431\u0430&raquo; (\u041f\u0441 132 [131], 4-5).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0430\u0431\u0443\u0434\u0436\u0430\u0435\u0448\u0441\u044f \u0456 \u045e\u0441\u0442\u0430\u0435\u0448, \u043a\u0430\u0436\u044b \u043f\u0440\u0430 \u042f\u0433\u043e, \u043a\u0430\u0431 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u042f\u0433\u043e \u043d\u0430\u043a\u0430\u0437. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u044f\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u0446\u044f\u0431\u0435. \u0414\u0443\u0448\u0430 \u0442\u0432\u0430\u044f \u043a\u0430\u0436\u0430: &laquo;\u0427\u0443\u044e \u0433\u043e\u043b\u0430\u0441 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430 \u043c\u0430\u0439\u0433\u043e \u043a\u0430\u043b\u044f \u043c\u0430\u0456\u0445 \u0434\u0437\u0432\u044f\u0440\u044d\u0439&raquo; (\u043f\u0430\u0440. \u041f\u043f 5, 2), \u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441: &laquo;\u0410\u0434\u0447\u044b\u043d\u0456, \u0441\u044f\u0441\u0442\u0440\u0430 \u043c\u0430\u044f, \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430 \u043c\u0430\u044f&raquo;. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u044f\u043a \u043c\u043e\u0436\u0430\u0448 \u0430\u0431\u0443\u0434\u0437\u0456\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430. \u0414\u0443\u0448\u0430 \u043a\u0430\u0436\u0430: &laquo;\u041f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u0434\u043e\u0447\u043a\u0456 \u0435\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0456\u044f, \u0430\u0431\u0443\u0434\u0437\u0456\u0446\u0435 \u0456 \u0430\u0436\u044b\u0432\u0456\u0446\u0435 \u045e \u0441\u0430\u0431\u0435 \u043b\u044e\u0431\u043e\u045e&raquo; (\u043f\u0430\u0440. \u041f\u043f 3, 5). \u0413\u044d\u0442\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0451\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 1, 30b. 31; \u042f\u043d 1, 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0456 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435\u043c, \u0456 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435\u043c, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0431\u044b\u043b\u043e, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0425\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443&raquo;. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u043c\u044b \u045e\u0441\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043b\u0430\u0441\u043a\u0443 \u0437\u0430\u043c\u0435\u0441\u0442 \u043b\u0430\u0441\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0431\u044b\u043b\u043e, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0425\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443&raquo;.<\/p>\r\n"}, {"GCH_CH_2_ID":"66","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u041f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0441\u0432. \u042f\u043d\u0430&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 4, 6: PL 35, 2008-2009)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0416\u0430\u0434\u0430\u043d\u043d\u0435 \u0441\u044d\u0440\u0446\u0430 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0436 \u043d\u0430\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u0430? &laquo;\u041c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u043c \u042f\u0433\u043e \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c&raquo; (1 \u042f\u043d 3, 2). \u042f\u0437\u044b\u043a \u0441\u043a\u0430\u0437\u0430\u045e, \u044f\u043a \u0443\u043c\u0435\u045e, \u043f\u0440\u0430 \u0430\u0441\u0442\u0430\u0442\u043d\u044f\u0435 \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u044b\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u044b. \u0428\u0442\u043e \u0436 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c \u0441\u0432. \u042f\u043d \u0443 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0456 \u0437 \u0442\u044b\u043c, \u043a\u0430\u0442\u043e\u0440\u044b \u0451\u0441\u0446\u044c, \u0456 \u0448\u0442\u043e \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0431\u0443\u0434\u0443\u0447\u044b \u0442\u0430\u043a\u0456\u043c\u0456 \u0434\u0430\u043b\u0451\u043a\u0456\u043c\u0456 \u0430\u0434 \u0432\u0435\u043b\u0456\u0447\u044b \u042f\u043d\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0437\u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u044f; \u0437\u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u0430 \u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0442\u0430\u043c\u0443, \u0447\u0430\u0433\u043e \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0432\u044b\u043c\u0430\u0432\u0456\u0446\u044c \u0441\u043b\u043e\u0432\u0430\u043c\u0456. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0446\u044f\u043f\u0435\u0440 \u043d\u0435 \u043c\u043e\u0436\u0430\u0446\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0431\u0430\u0447\u0430\u043d\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u0443\u0441\u044f \u0432\u0430\u0448\u0430\u044f \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044c \u0432\u044b\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u0436\u0430\u0434\u0430\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u0436\u044b\u0446\u0446\u0451 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u044b\u043c \u0441\u0443\u043c\u0430\u043c. \u041f\u0430 \u0447\u044b\u043c \u0442\u044b \u0441\u0443\u043c\u0443\u0435\u0448, \u0442\u0430\u0433\u043e \u044f\u0448\u0447\u044d \u043d\u0435 \u0431\u0430\u0447\u044b\u0448. \u041a\u0430\u043b\u0456, \u0430\u0434\u043d\u0430\u043a, \u0441\u0443\u043c\u0443\u0435\u0448, \u0442\u0430\u0434\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0448\u0441\u044f \u0433\u0430\u0442\u043e\u0432\u044b\u043c \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u0448, \u043a\u0430\u043b\u0456 \u044f\u043d\u043e \u043d\u0430\u0441\u0442\u0430\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u043d\u0435\u0439\u043a\u0430\u0435 \u043d\u0430\u0447\u044b\u043d\u043d\u0435 \u0456 \u0432\u0435\u0434\u0430\u0435\u0448 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0431\u0443\u0434\u0437\u0435 \u045e\u043a\u043b\u0430\u0441\u0446\u0456, \u0442\u0430\u0434\u044b \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u0448 \u043f\u0430\u0434\u043e\u043b, \u0442\u043e\u0440\u0431\u0443, \u043c\u0435\u0445 \u0446\u0456 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0435. \u0412\u0435\u0434\u0430\u0435\u0448, \u044f\u043a \u0448\u043c\u0430\u0442 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0443\u043a\u043b\u0430\u0441\u0446\u0456, \u0456 \u0431\u0430\u0447\u044b\u0448, \u044f\u043a \u043c\u0430\u043b\u0430 \u043c\u0435\u0441\u0446\u0430. \u0422\u0430\u043c\u0443, \u0440\u0430\u0441\u0446\u044f\u0433\u0432\u0430\u044e\u0447\u044b, \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u0448 \u0451\u043c\u0456\u0441\u0442\u0430\u0441\u0446\u044c. \u0422\u0430\u043a\u0456\u043c \u0436\u0430 \u0441\u043f\u043e\u0441\u0430\u0431\u0430\u043c \u0411\u043e\u0433, \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u044e\u0447\u044b \u043d\u0430\u043c \u0447\u0430\u043a\u0430\u0446\u044c, \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435; \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u044e\u0447\u044b \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0435, \u043f\u0430\u0448\u044b\u0440\u0430\u0435 \u0434\u0443\u0448\u0443; \u043f\u0430\u0448\u044b\u0440\u0430\u044e\u0447\u044b \u0434\u0443\u0448\u0443, \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c, \u0431\u0440\u0430\u0442\u044b, \u0431\u043e \u0447\u0430\u043a\u0430\u0435 \u043d\u0430\u0441 \u043d\u0430\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u044f\u043a \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043f\u0430\u0448\u044b\u0440\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u0431 \u0437\u0434\u043e\u043b\u0435\u0446\u044c \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u0441\u0442\u0430\u043d\u0435. \u0401\u043d \u043a\u0430\u0436\u0430: &laquo;\u0411\u0440\u0430\u0442\u044b, \u044f \u043d\u0435 \u043b\u0456\u0447\u0443, \u0448\u0442\u043e \u045e\u0436\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0433\u044d\u0442\u0430&raquo; (\u043f\u0430\u0440. \u0424\u043b\u043f 3, 13).<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0436 \u0442\u044b \u0440\u043e\u0431\u0456\u0448 \u0443 \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u043a\u0430\u043b\u0456 \u044f\u0448\u0447\u044d \u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u045e? &laquo;\u0417\u0430\u0431\u044b\u0432\u0430\u044e \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430 \u043c\u043d\u043e\u044e, \u0456 \u0441\u044f\u0433\u0430\u044e \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043d\u0430\u043f\u0435\u0440\u0430\u0434\u0437\u0435. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u044d\u0442\u044b \u0456\u043c\u043a\u043d\u0443\u0441\u044f \u0434\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b \u0432\u044b\u0441\u043e\u043a\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435&raquo; (\u043f\u0430\u0440. \u0424\u043b\u043f 3, 13-14). \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0441\u044f\u0431\u0435, \u0448\u0442\u043e \u0432\u044b\u0441\u0456\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u0456 \u0431\u044f\u0436\u044b\u0446\u044c \u0434\u0430 \u043c\u044d\u0442\u044b. \u0420\u0430\u0437\u0443\u043c\u0435\u0435, \u0448\u0442\u043e \u044f\u0448\u0447\u044d \u043d\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0442\u043e\u0435, &laquo;\u0447\u0430\u0433\u043e \u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430, \u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430, \u0456 \u0448\u0442\u043e \u043d\u0435 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0441\u044d\u0440\u0446\u0430&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 2, 9).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u043d\u043d\u0435 \u045e \u0446\u043d\u043e\u0446\u0435. \u0421\u0432\u044f\u0442\u043e\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0441 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u0446\u044c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u0430\u0441\u043e\u0431\u0456\u043c \u043d\u0430\u0448\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0441\u0432\u0435\u0442\u0443. \u0420\u0430\u043d\u0435\u0439 \u043c\u044b \u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0440\u0430 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0435 \u043f\u0440\u044b\u0431\u0440\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u0430\u0435 \u0431\u044b\u0446\u044c \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u043c. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0434\u0430\u0431\u0440\u043e\u043c, \u043f\u0430\u0437\u0431\u0443\u0434\u0437\u044c\u0441\u044f \u0437\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0443\u043c\u0430\u0439, \u0411\u043e\u0433 \u043f\u0440\u0430\u0433\u043d\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u043c\u0451\u0434\u0430\u043c; \u0430\u043b\u0435 \u043a\u0430\u043b\u0456 \u0442\u044b \u043f\u043e\u045e\u043d\u044b \u0432\u043e\u0446\u0430\u0442\u0443, \u0434\u0437\u0435 \u0437\u043c\u0435\u0441\u0446\u0456\u0448 \u043c\u0451\u0434? \u0422\u0440\u044d\u0431\u0430 \u0432\u044b\u043b\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u043b\u0430 \u043d\u0430\u0447\u044b\u043d\u043d\u0435, \u0442\u0440\u044d\u0431\u0430 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u0447\u044b\u043d\u043d\u0435 \u043d\u0430\u0432\u0430\u0442 \u043a\u043e\u0448\u0442\u0430\u043c \u0446\u044f\u0436\u043a\u043e\u0439, \u043c\u0430\u0437\u043e\u043b\u044c\u043d\u0430\u0439 \u043f\u0440\u0430\u0446\u044b, \u043a\u0430\u0431 \u044f\u043d\u043e \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u044b\u0434\u0430\u0442\u043d\u044b\u043c \u0434\u043b\u044f \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u043c\u0435\u0441\u0446\u0456\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u043c: \u043c\u0451\u0434, \u0437\u043e\u043b\u0430\u0442\u0430, \u0432\u0456\u043d\u043e &ndash; \u0434\u0443\u043c\u0430\u0435\u043c \u043f\u0440\u0430 \u0442\u0443\u044e \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u0441\u0442\u0430\u0440\u0430\u0435\u043c\u0441\u044f \u0432\u044b\u0440\u0430\u0437\u0456\u0446\u044c, \u0430 \u044f\u043d\u0430 &ndash; \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u044f. \u0406 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0451\u044e \u0411\u043e\u0433. \u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u043c &laquo;\u0411\u043e\u0433&raquo;, &ndash; \u0448\u0442\u043e \u0436 \u043c\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456? \u0413\u044d\u0442\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0432\u044b\u0440\u0430\u0436\u0430\u0435 \u045e\u0441\u0451 \u043d\u0430\u0448\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435. \u0422\u0430\u043c\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u045e \u0441\u0442\u0430\u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0437\u0432\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0434\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0433\u0430: \u043f\u0430\u0448\u044b\u0440\u044b\u043c \u0441\u044f\u0431\u0435 \u0434\u043b\u044f \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435. &laquo;\u041c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u043c \u042f\u0433\u043e \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c&raquo; (1 \u042f\u043d 3, 2).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 37 (36), 4-5\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u0434\u0443\u0439\u0441\u044f \u045e \u041f\u0430\u043d\u0443, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0401\u043d \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0430\u0440\u0443\u0447\u044b \u041f\u0430\u043d\u0443 \u0448\u043b\u044f\u0445 \u0441\u0432\u043e\u0439, \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0439\u0441\u044f \u043d\u0430 \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0401\u043d \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"67","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0440\u0430\u043c\u043e\u0432\u0430 \u043f\u0430\u043f\u044b \u041f\u0456\u044f XII \u0434\u0430 \u043c\u0430\u043b\u0430\u0434\u044b\u0445 \u0441\u0443\u0436\u044d\u043d\u0441\u0442\u0432\u0430\u045e<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Discorsi e Radiomessaggi, 11 mart. 1942: 3, 385-390)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0416\u043e\u043d\u043a\u0430 &ndash; \u0441\u043e\u043d\u0446\u0430 \u0441\u044f\u043c&rsquo;\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0441\u043e\u043d\u0446\u0430 \u0441\u044f\u043c&rsquo;\u0456 &ndash; \u0433\u044d\u0442\u0430 \u0436\u043e\u043d\u043a\u0430. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u044f\u0435 \u0456 \u044f\u043a \u043d\u0430\u0432\u0443\u0447\u0430\u0435 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435: &laquo;\u041b\u044e\u0431\u0430\u0441\u0446\u044c \u0434\u043e\u0431\u0440\u0430\u0439 \u0436\u043e\u043d\u043a\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0441\u0430\u043b\u043e\u0434\u0443 \u044f\u0435 \u043c\u0443\u0436\u0443. \u041b\u044e\u0431\u0430\u0441\u0446\u044c \u043d\u0430\u0434 \u043b\u044e\u0431\u0430\u0441\u0446\u044e &ndash; \u0441\u0430\u0440\u0430\u043c\u043b\u0456\u0432\u0430\u044f \u0436\u043e\u043d\u043a\u0430, \u0456 \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0433\u0430 \u0437\u0430 \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u0443\u044e \u0434\u0443\u0448\u0443. \u042f\u043a \u0441\u043e\u043d\u0446\u0430 \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0434 \u0432\u044b\u0448\u044b\u043d\u044f\u043c\u0456 \u041f\u0430\u043d\u0430, \u0442\u0430\u043a \u0445\u0430\u0440\u0430\u0441\u0442\u0432\u043e \u0434\u043e\u0431\u0440\u0430\u0439 \u0436\u043e\u043d\u043a\u0456 &ndash; \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u043d\u0435 \u0434\u043e\u043c\u0443 \u044f\u0435&raquo; (\u043f\u0430\u0440. \u0421\u0456\u0440 26, 13-16).<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0436\u043e\u043d\u043a\u0430 \u0456 \u043c\u0430\u0446\u0456 &ndash; \u043d\u0456\u0431\u044b \u0441\u043e\u043d\u0446\u0430 \u0441\u044f\u043c&rsquo;\u0456. \u0421\u043e\u043d\u0446\u0430, \u0431\u043e \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u044f, \u0430\u0445\u0432\u044f\u0440\u043d\u0430\u044f, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u044f, \u0443\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u044f \u0456 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u044f \u045e \u0430\u0434\u043d\u043e\u0441\u0456\u043d\u0430\u0445 \u0434\u0430 \u045e\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u043c\u0430\u0433\u043b\u043e \u0431 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u043c\u0443\u0436\u0430 \u0456 \u0434\u0437\u044f\u0446\u0435\u0439 \u0431\u043e\u043b\u044c\u0448 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c. \u0421\u0435\u0435 \u0432\u0430\u043a\u043e\u043b \u0441\u044f\u0431\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u0446\u044f\u043f\u043b\u043e. \u041a\u0430\u043b\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430, \u0448\u0442\u043e \u0441\u0443\u0436\u044d\u043d\u0441\u0442\u0432\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0435, \u043a\u0430\u043b\u0456 \u0441\u0443\u0436\u044d\u043d\u0446\u044b, \u044f\u043a\u0456\u044f \u044f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c, \u043d\u0435 \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u0443\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f, \u0430\u043b\u0435 \u0448\u0447\u0430\u0441\u0446\u044f \u0434\u0440\u0443\u0433\u043e\u0439 \u0430\u0441\u043e\u0431\u044b, \u0442\u043e \u0433\u044d\u0442\u0430\u044f \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u0446\u043d\u043e\u0442\u0430 \u0456 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u045e \u043f\u044d\u045e\u043d\u044b\u043c \u0441\u044d\u043d\u0441\u0435 \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430 \u0430\u0431\u043e\u0434\u0432\u0443\u0445 \u0441\u0443\u0436\u044d\u043d\u0446\u0430\u045e, \u0430\u043b\u0435 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0434\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u044b. \u042f\u0435 \u043f\u0440\u044b\u0440\u043e\u0434\u0430 \u043d\u0430\u0434\u0437\u0435\u043b\u0435\u043d\u0430 \u043f\u0430\u0447\u0443\u0446\u0446\u0451\u043c \u043c\u0430\u0446\u044f\u0440\u044b\u043d\u0441\u0442\u0432\u0430, \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0441\u044d\u0440\u0446\u0430 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044e. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u044b\u043c \u0434\u0430\u0440\u0430\u043c, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u0435\u0446\u0446\u0430 \u0437 \u043d\u0435\u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044f\u043c\u0456, \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u0441\u043f\u0430\u0433\u0430\u0434\u0430\u044e. \u041a\u0430\u043b\u0456 \u0437\u0430\u043a\u0440\u0430\u043d\u0443\u0442\u0430 \u044f\u0435 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0430\u0434\u043f\u043b\u043e\u0447\u0432\u0430\u0435 \u043f\u0430\u0432\u0430\u0433\u0430\u044e \u0456 \u043f\u0430\u0448\u0430\u043d\u0430\u044e. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a, \u044f\u043a \u0441\u043e\u043d\u0446\u0430, \u044f\u043a\u043e\u0435 \u0437\u0430\u0440\u0430\u043d\u043a\u0430\u0439 \u0440\u0430\u0437&rsquo;\u044f\u0441\u043d\u044f\u0435 \u0448\u044d\u0440\u044b\u044f \u0445\u0432\u0456\u043b\u0456\u043d\u044b \u0440\u0430\u043d\u043a\u0443 \u0456 \u0437\u0430\u043b\u0430\u0442\u044b\u043c\u0456 \u043f\u0440\u043e\u043c\u043d\u044f\u043c\u0456 \u043f\u0440\u0430\u043d\u0456\u0437\u0432\u0430\u0435 \u0432\u044f\u0447\u044d\u0440\u043d\u0456 \u0437\u043c\u0440\u043e\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u0416\u043e\u043d\u043a\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u043e\u043d\u0446\u0430\u043c \u0441\u044f\u043c&rsquo;\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u0441\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u043e\u0437\u0456\u0440\u043a\u0443 \u0456 \u0446\u0435\u043f\u043b\u044b\u043d\u0456 \u0441\u043b\u043e\u0432\u0430\u045e. \u042f\u0435 \u0432\u043e\u0447\u044b \u0456 \u0433\u043e\u043b\u0430\u0441 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0446\u044c \u0441\u043b\u043e\u0434\u044b\u0447\u0447\u0443 \u0434\u0443\u0448\u0443, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u044e\u0446\u044c, \u0443\u0437\u0440\u0443\u0448\u0432\u0430\u044e\u0446\u044c, \u043d\u0430\u0442\u0445\u043d\u044f\u044e\u0446\u044c, \u0441\u0446\u0456\u0448\u0432\u0430\u044e\u0446\u044c \u043f\u0430\u0440\u044b\u0432\u044b \u0433\u043d\u0435\u0432\u0443 \u0456 \u0441\u0445\u0456\u043b\u044f\u044e\u0446\u044c \u043c\u0443\u0436\u0430 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0434\u0430\u0431\u0440\u043e\u043c, \u0432\u0435\u0441\u0446\u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u0443\u044e \u0441\u044f\u043c\u0435\u0439\u043d\u0443\u044e \u0440\u0430\u0437\u043c\u043e\u0432\u0443 \u043f\u0430\u0441\u043b\u044f \u0434\u043e\u045e\u0433\u0456\u0445 \u0446\u044f\u0436\u043a\u0456\u0445 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u044b\u0445 \u0437\u0430\u043d\u044f\u0442\u043a\u0430\u045e \u0446\u0456 \u0442\u043e \u043d\u0430 \u043f\u0440\u0430\u0446\u044b, \u0446\u0456 \u043d\u0430 \u043f\u043e\u043b\u0456, \u0443 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0433\u0430\u043d\u0434\u043b\u044e \u0446\u0456 \u0440\u0430\u043c\u044f\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0416\u043e\u043d\u043a\u0430 \u0451\u0441\u0446\u044c \u0441\u043e\u043d\u0446\u0430\u043c \u0441\u044f\u043c&rsquo;\u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u0443\u044e \u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u0443\u044e \u0448\u0447\u044b\u0440\u0430\u0441\u0446\u044c, \u0433\u043e\u0434\u043d\u0443\u044e \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u0443, \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0443\u044e \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0443, \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u043a\u043b\u043e\u043f\u0430\u0442 \u043f\u0440\u0430 \u0446\u0435\u043b\u0430 \u0456 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443, \u043f\u0440\u0430\u0437 \u0441\u0446\u0456\u043f\u043b\u044b \u0456 \u0437\u044b\u0447\u043b\u0456\u0432\u044b \u0441\u0442\u044b\u043b\u044c \u0436\u044b\u0446\u0446\u044f. \u0414\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u045e, \u0432\u044f\u0441\u0451\u043b\u044b \u0432\u044b\u0440\u0430\u0437 \u0442\u0432\u0430\u0440\u0443, \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435, \u043d\u0435\u0437\u043b\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u045e\u0441\u043c\u0435\u0448\u043a\u0430, \u0441\u043f\u0430\u0433\u0430\u0434\u043b\u0456\u0432\u0430 \u0441\u0445\u0456\u043b\u0435\u043d\u043d\u0430\u044f \u0433\u0430\u043b\u0430\u0432\u0430 \u043d\u0430\u0434\u0430\u044e\u0446\u044c \u0451\u0439 \u0432\u044b\u0433\u043b\u044f\u0434 \u043f\u0440\u044b\u0432\u0430\u0431\u043d\u0430\u0439 \u0456 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u043f\u0440\u043e\u0441\u0442\u0430\u0439 \u043a\u0432\u0435\u0442\u043a\u0456, \u044f\u043a\u0430\u044f \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435 \u0441\u0432\u0430\u0435 \u043f\u044f\u043b\u0451\u0441\u0442\u043a\u0456, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0456 \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u0446\u044c \u0446\u044f\u043f\u043b\u043e \u0441\u043e\u043d\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041e, \u043a\u0430\u043b\u0456 \u0431 \u0432\u044b \u043c\u0430\u0433\u043b\u0456 \u0432\u0435\u0434\u0430\u0446\u044c, \u044f\u043a\u043e\u0435 \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0451 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u045e\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u0456 \u045e \u0441\u044d\u0440\u0446\u044b \u0431\u0430\u0446\u044c\u043a\u0456 \u0441\u044f\u043c&rsquo;\u0456 \u0456 \u0434\u0437\u044f\u0446\u0435\u0439 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u0456 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0442\u0430\u043a\u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u0436\u043e\u043d\u043a\u0456 \u0456 \u043c\u0430\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0456\u0440 26, 13. 15. 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041b\u044e\u0431\u0430\u0441\u0446\u044c \u0434\u043e\u0431\u0440\u0430\u0439 \u0436\u043e\u043d\u043a\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0441\u0430\u043b\u043e\u0434\u0443 \u044f\u0435 \u043c\u0443\u0436\u0443. <span style=\"color: #ff0000;\">*<\/span> \u041b\u044e\u0431\u0430\u0441\u0446\u044c \u043d\u0430\u0434 \u043b\u044e\u0431\u0430\u0441\u0446\u044e &ndash; \u0441\u0430\u0440\u0430\u043c\u043b\u0456\u0432\u0430\u044f \u0436\u043e\u043d\u043a\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043a \u0441\u043e\u043d\u0446\u0430 \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0434 \u0432\u044b\u0448\u044b\u043d\u044f\u043c\u0456 \u041f\u0430\u043d\u0430, \u0442\u0430\u043a \u0445\u0430\u0440\u0430\u0441\u0442\u0432\u043e \u0434\u043e\u0431\u0440\u0430\u0439 \u0436\u043e\u043d\u043a\u0456 &ndash; \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u043d\u0435 \u0434\u043e\u043c\u0443 \u044f\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041b\u044e\u0431\u0430\u0441\u0446\u044c \u043d\u0430\u0434 \u043b\u044e\u0431\u0430\u0441\u0446\u044e &ndash; \u0441\u0430\u0440\u0430\u043c\u043b\u0456\u0432\u0430\u044f \u0436\u043e\u043d\u043a\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"71","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0432\u043e\u0440 &laquo;\u041f\u0440\u0430 \u043b\u044e\u0431\u043e\u045e&raquo; \u041c\u0430\u043a\u0441\u0456\u043c\u0430 \u0412\u044b\u0437\u043d\u0430\u045e\u0446\u044b, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Centuria 1, cap. 1, 4-5. 16-17. 23-24. 26-28. 30-40: PG 90, 962-967)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0411\u0435\u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u045e\u0441\u0451 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0434 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0431\u043e\u045e &ndash; \u0433\u044d\u0442\u0430 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u044f \u0433\u0430\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430, \u044f\u043a\u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430. \u0422\u0430\u043a\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u043d\u0435\u043b\u044c\u0433\u0430 \u043c\u0435\u0446\u044c \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u043a\u0430\u043b\u0456 \u0442\u044b \u0434\u0443\u0445\u043e\u045e\u043d\u0430 \u043f\u0440\u044b\u0432\u044f\u0437\u0430\u043d\u044b \u0434\u0430 \u044f\u043a\u0456\u0445-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0437\u044f\u043c\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u0442\u043e\u0439 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0435 \u042f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456 \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0456 \u0432\u0435\u0434\u044b \u043f\u0440\u0430 \u042f\u0433\u043e; \u0434\u0430 \u042f\u0433\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u0456 \u043b\u044e\u0431\u043e\u045e\u044e \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u0456\u0441\u043d\u0443\u0435, \u0431\u044b\u043b\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430 \u0411\u043e\u0433\u0430\u043c, \u0456 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433 \u043d\u0430\u043c\u043d\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0437\u0430 \u0440\u044d\u0447\u044b, \u044f\u043a\u0456\u044f \u0441\u0442\u0432\u0430\u0440\u044b\u045e, \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0430\u0434\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u043d\u0430\u0439\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0435\u0439\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456, \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0446\u044d\u043d\u0456\u0446\u044c \u0411\u043e\u0433\u0430 \u043c\u0435\u043d\u0448 \u0437\u0430 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u044f \u0406\u043c \u0440\u044d\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041a\u0430\u043b\u0456 \u043b\u044e\u0431\u0456\u0446\u0435 \u041c\u044f\u043d\u0435, \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u041c\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456&raquo; (\u042f\u043d 14, 15). &laquo;\u0413\u044d\u0442\u0430 \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u0432\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e&raquo; (\u042f\u043d 15, 17). \u0425\u0442\u043e \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0442\u043e\u0439 \u043d\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0430 \u0445\u0442\u043e \u043d\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0442\u043e\u0439 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043c\u043e\u0436\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0443\u0441\u0456\u0445 \u0431\u0435\u0437 \u0430\u0434\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u0442\u043e\u0439 \u0443\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430. \u0422\u0430\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u0437\u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u0430\u0435, \u0430\u043b\u0435 \u0437 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0411\u043e\u0436\u0430\u0439 \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u044e \u0434\u0437\u0435\u043b\u0456\u0446\u0446\u0430 \u0437 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0411\u043e\u0433\u0430, \u0445\u0442\u043e, \u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443, \u043d\u0435 \u0440\u043e\u0431\u0456\u0446\u044c \u0440\u043e\u0437\u043d\u0456\u0446\u044b \u043f\u0430\u043c\u0456\u0436 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0434\u043e\u0431\u0440\u044b\u043c \u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u043c, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c, \u0430\u043b\u0435 \u045e\u0441\u0456\u0445 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0430\u0442\u0440\u044d\u0431, \u0445\u043e\u0446\u044c \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0446\u044d\u043d\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0433\u043e\u0434\u043d\u0430\u0433\u0430 \u0456 \u0430\u0434\u0434\u0430\u043d\u0430\u0433\u0430, \u0447\u044b\u043c \u043d\u044f\u0433\u043e\u0434\u043d\u0456\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0431\u043e\u045e \u0432\u044b\u0440\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u043d\u043d\u0456 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0443 \u0434\u0437\u044f\u043b\u0435\u043d\u043d\u0456 \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0432\u0443\u043a\u0430\u0439 \u0456 \u045e \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u044b\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 \u0431\u043b\u0456\u0436\u043d\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u0430\u0434 \u0441\u044d\u0440\u0446\u0430 \u0430\u0434\u043a\u0456\u0434\u0432\u0430\u0435 \u0441\u043f\u0430\u043a\u0443\u0441\u044b \u0441\u0432\u0435\u0442\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0448\u0447\u044b\u0440\u0430 \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0435 \u0441\u044f\u0431\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044e \u0431\u043b\u0456\u0436\u043d\u044f\u043c\u0443, \u0442\u043e\u0439, \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e\u0448\u044b\u0441\u044f \u0445\u0443\u0442\u043a\u0430 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0441\u0442\u0440\u0430\u0441\u0446\u0456 \u0456 \u0437\u0430\u0433\u0430\u043d\u044b, \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u0411\u043e\u0436\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u0442\u043e\u0439 \u043f\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0437\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456 \u043d\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0446\u044c \u0456 \u043d\u0435 \u0437\u043d\u0435\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0456 \u041f\u0430\u043d\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 \u043c\u0443\u0436\u043d\u0430 \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0446\u044f\u0436\u0430\u0440\u044b, \u0437\u043d\u044f\u0432\u0430\u0433\u0456 \u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043d\u0435 \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u043d\u0456\u043a\u043e\u043c\u0443 \u0437\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041d\u0435 \u043a\u0430\u0436\u044b\u0446\u0435, &ndash; \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043f\u0440\u0430\u0440\u043e\u043a \u0415\u0440\u0430\u043c\u0456\u044f, &ndash; &ldquo;\u0441\u0432\u044f\u0442\u044b\u043d\u044f \u041f\u0430\u043d\u0430&rdquo;&raquo; (\u0415\u0440 7, 4). \u0422\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u0456\u043c\u043a\u043d\u0456\u0441\u044f \u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u0421\u0430\u043c\u0430 \u0432\u0435\u0440\u0430 \u045e \u041f\u0430\u043d\u0430 \u043c\u0430\u0439\u0433\u043e, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043c\u043e\u0436\u0430 \u043c\u044f\u043d\u0435 \u0437\u0431\u0430\u0432\u0456\u0446\u044c&raquo;. \u041d\u0435 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0442\u0430\u043a, \u043a\u0430\u043b\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u043d\u0435 \u0437\u0434\u0430\u0431\u0443\u0434\u0437\u0435\u0448 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u042f\u0433\u043e. \u041d\u0430\u043a\u043e\u043d\u0442 \u0441\u0430\u043c\u043e\u0439 \u0432\u0435\u0440\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439: &laquo;\u0417\u043b\u044b\u044f \u0434\u0443\u0445\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0435\u0440\u0430\u0446\u044c \u0456 \u0434\u0440\u044b\u0436\u0430\u0446\u044c!&raquo; (\u042f\u043a 2, 19).<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u044f\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u043b\u044e\u0431\u043e\u0432\u0456 \u0451\u0441\u0446\u044c \u0441\u044d\u0440\u0446\u0430, \u0433\u0430\u0442\u043e\u0432\u0430\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u043c\u0443, \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u044c \u0456 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0435 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043d\u043d\u0435 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 13, 34; 1 \u042f\u043d 2, 10. 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0434\u0430\u044e \u0432\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e. \u042f\u043a \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441, \u0442\u0430\u043a \u0456 \u0432\u044b \u043b\u044e\u0431\u0456\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e. <span style=\"color: #ff0000;\">*<\/span> \u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u045e \u0441\u0432\u044f\u0442\u043b\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430 \u0442\u044b\u043c \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u043b\u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u043c \u042f\u0433\u043e\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u045e \u0441\u0432\u044f\u0442\u043b\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"72","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442\u0430&raquo; \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 5; PG 44, 683-686)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u043e\u0447\u044b \u043c\u0443\u0434\u0440\u0430\u0433\u0430 \u045e\u0437\u0456\u0440\u0430\u044e\u0446\u0446\u0430 \u045e \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0434\u0443\u0448\u0430 \u0437\u0432\u044f\u0440\u0442\u0430\u0435 \u0432\u043e\u0447\u044b \u0441\u0432\u0430\u0435 \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0413\u0430\u043b\u0430\u0432\u044b, \u044f\u043a\u043e\u0439 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0441\u0432. \u041f\u0430\u045e\u043b\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435 \u043d\u0430 \u0456\u043c\u044f \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0439, \u0431\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u045e \u0442\u043e\u0439 \u0447\u0430\u0441 \u0445\u0443\u0442\u043a\u0430\u0441\u0446\u044c \u043f\u043e\u0437\u0456\u0440\u043a\u0443, \u0431\u043e \u045e\u0437\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u0442\u0443\u0434\u044b, \u0434\u0437\u0435 \u043d\u044f\u043c\u0430 \u0437\u043c\u0440\u043e\u043a\u0443 \u0437\u043b\u0430. \u0412\u044f\u043b\u0456\u043a\u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b \u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0434\u0430 \u044f\u0433\u043e \u043c\u0435\u043b\u0456 &laquo;\u0432\u043e\u0447\u044b \u045e \u0433\u0430\u043b\u0430\u0432\u0435&raquo;, \u044f\u043a \u0456 \u045e\u0441\u0435, \u0445\u0442\u043e \u0436\u044b\u0432\u0435, \u0440\u0443\u0445\u0430\u0435\u0446\u0446\u0430 \u0456 \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0430\u043a\u0440\u0443\u0436\u0430\u043d\u044b \u0437 \u0443\u0441\u0456\u0445 \u0431\u0430\u043a\u043e\u045e \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u043d\u0435 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u0443 \u0446\u0435\u043c\u0440\u0443, \u0442\u0430\u043a \u0436\u0430 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435 \u0441\u0432\u043e\u0439 \u043f\u043e\u0437\u0456\u0440\u043a \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043c\u043e\u0433 \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u043d\u0430 \u043d\u0435\u0439\u043a\u0430\u0439 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043c\u0430\u0435 &laquo;\u0432\u043e\u0447\u044b \u045e \u0433\u0430\u043b\u0430\u0432\u0435&raquo; &ndash; \u043f\u0430\u0434 \u0433\u0430\u043b\u0430\u0432\u043e\u0439 \u0440\u0430\u0437\u0443\u043c\u0435\u044e \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0456 \u043f\u0440\u044b\u0447\u044b\u043d\u0443 \u045e\u0441\u044f\u0433\u043e &ndash; \u0442\u043e\u0439 \u0443\u0433\u043b\u044f\u0434\u0430\u0435\u0446\u0446\u0430 \u045e \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0435 \u0414\u0430\u0431\u0440\u043e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0434\u0430\u0431\u0440\u043e\u043c \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f\u0445 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u044b\u043c. \u0422\u0430\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u0433\u043b\u044f\u0434\u0430\u0435\u0446\u0446\u0430 \u045e \u043f\u0440\u0430\u045e\u0434\u0443, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0441\u0446\u044c &ndash; \u0443\u0433\u043b\u044f\u0434\u0430\u0435\u0446\u0446\u0430 \u0432\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0434\u0430\u0431\u0440\u043e. &laquo;\u0423 \u043c\u0443\u0434\u0440\u0430\u0433\u0430 \u0432\u043e\u0447\u044b \u045e \u0433\u0430\u043b\u0430\u0432\u0435 \u044f\u0433\u043e\u043d\u0430\u0439, \u0430 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b \u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0446\u0435\u043c\u0440\u044b&raquo; (\u042d\u043a\u043b 2, 14). \u0425\u0442\u043e \u043d\u0435 \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043b\u044f\u043c\u043f\u044b \u043d\u0430 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0443, \u0430\u043b\u0435 \u0445\u0430\u0432\u0430\u0435 \u044f\u0435 \u043f\u0430\u0434 \u043b\u043e\u0436\u043a\u0430\u043c, \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435 \u045e \u0446\u0435\u043c\u0440\u0443 \u0441\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0436\u0430 \u0448\u043c\u0430\u0442 \u0442\u0430\u043a\u0456\u0445, \u044f\u043a\u0456\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435 \u045e \u0432\u0435\u0447\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u0445, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0446\u044c \u043d\u0430\u0434 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c\u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044f\u043c\u0456, \u0430\u043b\u0435 \u043b\u0456\u0447\u0430\u0446\u0446\u0430 \u0441\u043b\u044f\u043f\u044b\u043c\u0456 \u0456 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c\u0456. \u0421\u0432. \u041f\u0430\u0432\u0435\u043b \u043b\u0456\u0447\u044b\u045e \u0433\u044d\u0442\u0430 \u0433\u043e\u043d\u0430\u0440\u0430\u043c, \u043a\u0430\u043b\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e, \u0448\u0442\u043e \u0441\u0442\u0430\u045e \u043d\u044f\u043c\u0443\u0434\u0440\u044b\u043c \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u042f\u0433\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0435 \u0437\u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0430\u0441\u044f \u043d\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044f\u0445, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u043c\u044b \u0432\u0435\u043b\u044c\u043c\u0456 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u043c\u0441\u044f \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435. \u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: &laquo;\u041c\u044b \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430&raquo; (1 \u041a\u0430\u0440 4, 10). \u0413\u044d\u0442\u0430 \u0442\u0430\u043a, \u044f\u043a \u0431\u044b \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0423 \u0442\u044b\u043c, \u0448\u0442\u043e \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043c\u044b \u0441\u043b\u044f\u043f\u044b\u044f, \u0431\u043e \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u043c \u0437\u0440\u043e\u043a \u0443\u0433\u043e\u0440\u0443 \u0456 \u043c\u0430\u0435\u043c &ldquo;\u0432\u043e\u0447\u044b \u045e \u0433\u0430\u043b\u0430\u0432\u0435&rdquo;&raquo;. \u0422\u0430\u043c\u0443 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043d\u0435 \u043c\u0435\u045e \u0434\u043e\u043c\u0443 \u0456 \u045e\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f, \u0431\u044b\u045e \u0443\u0431\u043e\u0433\u0456\u043c, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u045e \u0434\u0430\u0440\u043e\u0437\u0435, \u0446\u044f\u0440\u043f\u0435\u045e \u0433\u043e\u043b\u0430\u0434 \u0456 \u043f\u0440\u0430\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u0431\u044b \u044f\u0433\u043e, \u0431\u0430\u0447\u0430\u0447\u044b \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u044b, \u0431\u0456\u0447\u0430\u0432\u0430\u043d\u0430\u0433\u0430, \u0442\u043e\u043d\u0443\u0447\u0430\u0433\u0430 \u045e \u0445\u0432\u0430\u043b\u044f\u0445 \u043f\u0430\u0441\u043b\u044f \u043a\u0430\u0440\u0430\u0431\u043b\u0435\u043a\u0440\u0443\u0448\u044d\u043d\u043d\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u043b\u0456 \u0432\u044f\u043b\u0456 \u044f\u0433\u043e \u045e \u043a\u0430\u0439\u0434\u0430\u043d\u0430\u0445 \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u043c\u0435\u0441\u0446\u0430 \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u0435? \u0406 \u0445\u043e\u0446\u044c \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u044f\u043c\u0443 \u0433\u044d\u0442\u043a\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u0446\u044c, \u0451\u043d \u043d\u0435 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e \u0441\u0432\u0430\u0456\u0445 \u0432\u0430\u0447\u044d\u0439, \u0430\u043b\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u0435\u045e \u0456\u0445 &laquo;\u0443 \u0433\u0430\u043b\u0430\u0432\u0435&raquo;, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e\u0447\u044b: &laquo;\u0425\u0442\u043e \u0430\u0434\u043b\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430? \u041d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u0446\u0456 \u043f\u0440\u044b\u0433\u043d\u0451\u0442, \u0446\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434, \u0446\u0456 \u0433\u043e\u043b\u0430\u0434, \u0446\u0456 \u0433\u0430\u043b\u0435\u0447\u0430, \u0446\u0456 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430, \u0446\u0456 \u043c\u0435\u0447?&raquo; (\u0420\u044b\u043c 8, 35). \u0413\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435: &laquo;\u0425\u0442\u043e \u0436 \u0437\u0434\u043e\u043b\u0435\u0435 \u0432\u044b\u0440\u0432\u0430\u0446\u044c \u043c\u043d\u0435 \u0432\u043e\u0447\u044b \u0437 \u0433\u0430\u043b\u0430\u0432\u044b \u0456 \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u0446\u0456 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430: &laquo;\u0428\u0443\u043a\u0430\u0439\u0446\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445&raquo; (\u041a\u043b\u0441 3, 1-2), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, &laquo;\u043c\u0430\u0439\u0446\u0435 \u0432\u043e\u0447\u044b \u045e \u0433\u0430\u043b\u0430\u0432\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 123 (122), 2; \u042f\u043d 8, 12b<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043a, \u044f\u043a \u0432\u043e\u0447\u044b \u0441\u043b\u0443\u0433\u0430\u045e \u0437\u0432\u0435\u0440\u043d\u0443\u0442\u044b \u043d\u0430 \u0440\u0443\u043a\u0456 \u0456\u0445 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043e\u045e, <span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u043a \u043d\u0430\u0448\u044b\u044f \u0432\u043e\u0447\u044b &ndash; \u0434\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0401\u043d \u043d\u0435 \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f &ndash; \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0442\u0443. \u0425\u0442\u043e \u0456\u0434\u0437\u0435 \u0437\u0430 \u041c\u043d\u043e\u044e, \u0442\u043e\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0446\u0435\u043c\u0440\u044b, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u0436\u044b\u0446\u0446\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043a \u043d\u0430\u0448\u044b\u044f \u0432\u043e\u0447\u044b &ndash; \u0434\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0401\u043d \u043d\u0435 \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"73","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0415\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442\u0430&raquo; \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0437\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 6: PG 44, 702-703)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0427\u0430\u0441 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u0446\u0430 \u0456 \u0447\u0430\u0441 \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0401\u0441\u0446\u044c &laquo;\u0447\u0430\u0441 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u0446\u0430 \u0456 \u0447\u0430\u0441 \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c&raquo;, \u044f\u043a \u043a\u0430\u0436\u0430 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442. \u0412\u0435\u043b\u044c\u043c\u0456 \u0441\u043b\u0443\u0448\u043d\u0430 \u043d\u0430 \u0441\u0430\u043c\u044b\u043c \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0451\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0433\u044d\u0442\u0443\u044e \u0441\u0443\u0432\u044f\u0437\u044c \u043f\u0430\u043c\u0456\u0436 \u0441\u043c\u0435\u0440\u0446\u044e \u0456 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435\u043c. \u0411\u043e \u043f\u0430\u0441\u043b\u044f \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u043d\u0435\u043f\u0430\u0437\u0431\u0435\u0436\u043d\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0441\u043c\u0435\u0440\u0446\u044c, \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u043f\u0430\u045e\u0441\u0442\u0430\u0435, \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u0435 \u0440\u0430\u0441\u043f\u0430\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u0441\u0446\u044c &laquo;\u0447\u0430\u0441 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u0446\u0430 \u0456 \u0447\u0430\u0441 \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c&raquo;. \u041a\u0430\u0431 \u0456 \u043c\u043d\u0435 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441 \u0456 \u045e \u0434\u043e\u0431\u0440\u044b \u043f\u0430\u043c\u0435\u0440\u0446\u0456. \u0417\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0448\u0442\u043e \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0442\u0430\u043a\u043e\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0456 \u0442\u0430\u043a\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c, \u0434\u0430 \u044f\u043a\u0456\u0445 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0456\u0434\u0437\u0435 \u043c\u044d\u0442\u0430\u043d\u0430\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0456 \u0441\u0432\u044f\u0434\u043e\u043c\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043a\u0430\u0431 \u044f\u043d\u044b \u043c\u0430\u0433\u043b\u0456 \u0441\u0442\u0430\u0446\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0446\u043d\u043e\u0442\u044b. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u0430\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u043d\u0435 \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434 \u0432\u043e\u043b\u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c \u0432\u044b\u0431\u0430\u0440\u0430\u043c \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u0430\u0433\u0430. \u0422\u043e\u0435, \u0448\u0442\u043e \u0430\u0434 \u043d\u0430\u0441 \u043d\u0435 \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c, \u043d\u0435 \u043c\u043e\u0436\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u0446\u0430 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0430\u043c \u0446\u0456 \u0446\u043d\u043e\u0442\u0430\u0439. \u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0437\u0430\u0434\u0443\u043c\u0430\u0446\u0446\u0430, \u0447\u044b\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u045e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441, \u0430 \u0447\u044b\u043c &ndash; \u0441\u043c\u0435\u0440\u0446\u044c \u0443 \u0434\u043e\u0431\u0440\u0443\u044e \u0445\u0432\u0456\u043b\u0456\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u043c\u0430\u044e, \u0448\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c \u0456 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u0447\u0430\u0441\u0435 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0440\u043e\u043a \u0406\u0441\u0430\u044f, \u0440\u0430\u0441\u043f\u0430\u0447\u044b\u043d\u0430\u0435 \u0441\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0436\u0430\u0439 \u0456 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0441\u0432\u0435\u0442 \u0443 \u043f\u0430\u043a\u0443\u0442\u0430\u0445 \u0434\u0443\u0448\u044b. \u0422\u0430\u043c\u0443 \u043c\u044b, \u0442\u0430\u043a \u0431\u044b \u043c\u043e\u0432\u0456\u0446\u044c, \u0441\u0430\u043c\u0456 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0431\u0430\u0446\u044c\u043a\u0430\u043c\u0456, \u043a\u0430\u043b\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u043d\u044e \u0434\u0430\u0431\u0440\u0430 \u0456 \u0437 \u0443\u0434\u0437\u0435\u043b\u0430\u043c \u0432\u043e\u043b\u044c\u043d\u0430\u0439 \u0432\u043e\u043b\u0456 \u0444\u0430\u0440\u043c\u0456\u0440\u0443\u0435\u043c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u043c \u0456 \u0434\u0430\u0451\u043c \u043d\u0430 \u0441\u0432\u0435\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0440\u043e\u0431\u0456\u043c \u0442\u0430\u043a, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u043c\u0430\u0435\u043c \u0411\u043e\u0433\u0430. \u0421\u0442\u0430\u043d\u043e\u0432\u0456\u043c\u0441\u044f \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0411\u043e\u0433\u0430, \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0446\u043d\u043e\u0442\u044b, \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430. \u0410\u043b\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u043c\u0441\u044f \u044f\u043a \u043d\u044f\u043f\u043e\u045e\u043d\u044b\u044f, \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u044f, \u043d\u044f\u0441\u0442\u0430\u043b\u044b\u044f, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u044b\u045e \u0443 \u043d\u0430\u0441 \u0441\u0444\u0430\u0440\u043c\u0456\u0440\u0430\u0432\u0430\u043d\u044b, \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, &laquo;\u0432\u043e\u0431\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430&raquo;. \u0410 \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0411\u043e\u0436\u044b \u0431\u044b\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0456 \u043f\u043e\u045e\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e\u0436\u043e \u0432\u044f\u0434\u043e\u043c\u0430, \u0448\u0442\u043e \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u0446\u0430 \u045e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441, \u0432\u044f\u0434\u043e\u043c\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c \u0443 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441. \u0412\u044f\u0434\u043e\u043c\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0443 \u044f\u043a\u0456\u043c \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0456 \u0434\u043b\u044f \u0441\u0432. \u041f\u0430\u045e\u043b\u0430 \u043a\u043e\u0436\u043d\u044b \u0447\u0430\u0441 \u0431\u044b\u045e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0434\u043b\u044f \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456. \u041f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0432\u0430\u0435 \u0433\u044d\u0442\u0430 \u045e \u0441\u0432\u0430\u0456\u0445 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f\u0445: &laquo;\u042f \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u043c\u0456\u0440\u0430\u044e&raquo; (1 \u041a\u0430\u0440 15, 31) \u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: &laquo;\u0417\u0430 \u0446\u044f\u0431\u0435 \u0437\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u0441 \u0443\u0432\u0435\u0441\u044c \u0434\u0437\u0435\u043d\u044c&raquo; (\u0420\u044b\u043c 8, 36). \u0421\u0430\u043c\u0456 \u045e \u0441\u0430\u0431\u0435 \u043c\u044b \u043d\u043e\u0441\u0456\u043c \u043f\u0440\u044b\u0441\u0443\u0434 \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0430\u0447\u044b\u043c \u0432\u044b\u0440\u0430\u0437\u043d\u0430, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u041f\u0430\u0432\u0435\u043b \u043f\u0430\u043c\u0456\u0440\u0430\u0435 \u0448\u0442\u043e\u0434\u043d\u044f. \u041d\u0435 \u0436\u044b\u0432\u0435 \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u045e\u0442\u0430\u0439\u043c\u043e\u045e\u0432\u0430\u0435 \u0446\u0435\u043b\u0430, \u0443 \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435 \u043d\u043e\u0441\u0456\u0446\u044c \u043f\u0430\u043c\u0456\u0440\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0446\u0435\u043b\u0430. \u041d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043a\u0440\u044b\u0436\u0443\u0435 \u0441\u044f\u0431\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u043d\u0435 \u0436\u044b\u0432\u0435 \u045e\u0436\u043e \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0436\u044b\u0432\u0435 \u045e \u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0414\u0443\u043c\u0430\u044e, \u0448\u0442\u043e \u0442\u0430\u043a\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c, \u044f\u043a\u0430\u044f \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0434\u043e\u0431\u0440\u0430\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043a\u0430\u0436\u0430: &laquo;\u042f \u0437\u0430\u0431\u0456\u0432\u0430\u044e, \u0456 \u042f \u0430\u0436\u044b\u045e\u043b\u044f\u044e&raquo; (\u043f\u0430\u0440. \u0414\u0440\u0433 32, 39). \u041a\u0430\u0436\u0430, \u043a\u0430\u0431 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0411\u043e\u0436\u044b\u043c \u0434\u0430\u0440\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443 \u0456 \u0436\u044b\u0446\u0446\u0451 \u045e \u0414\u0443\u0445\u0443. \u041f\u0440\u044b\u0432\u0451\u045e \u0441\u043c\u0435\u0440\u0446\u044c, \u0442\u0430\u043c\u0443 \u0430\u0431\u044f\u0446\u0430\u0435 \u0430\u0436\u044b\u0432\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0440\u0433 32, 39b; \u0410\u043f 1, 18<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0437\u0430\u0431\u0456\u0432\u0430\u044e, \u0456 \u042f \u0430\u0436\u044b\u045e\u043b\u044f\u044e, \u042f \u0440\u0430\u043d\u044e, \u0456 \u042f \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u044e, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0430\u0434 \u0440\u0443\u043a\u0456 \u041c\u0430\u0451\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u043c\u0430\u044e \u043a\u043b\u044e\u0447\u044b \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0430\u0434\u0445\u043b\u0430\u043d\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0430\u0434 \u0440\u0443\u043a\u0456 \u041c\u0430\u0451\u0439.<\/p>\r\n"}, {"GCH_CH_2_ID":"74","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442\u0430 \u0441\u0432. \u0413\u0435\u0440\u0430\u043d\u0456\u043c\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(PL 23, 1057-1059)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0428\u0443\u043a\u0430\u0439\u0446\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0406 \u043a\u0430\u043b\u0456 \u044f\u043a\u043e\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0411\u043e\u0433 \u0434\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0456 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u044c, \u0456 \u0434\u0430\u0435 \u0441\u0456\u043b\u0443 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u0433\u044d\u0442\u044b\u043c \u0456 \u043c\u0435\u0446\u044c \u0447\u0430\u0441\u0442\u043a\u0443 \u0441\u0432\u0430\u044e, \u0456 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0437 \u043f\u0440\u0430\u0446\u044b \u0441\u0432\u0430\u0451\u0439, \u0442\u043e \u0433\u044d\u0442\u0430 \u0434\u0430\u0440 \u0411\u043e\u0436\u044b. \u0411\u043e \u0451\u043d \u043d\u044f\u0434\u043e\u045e\u0433\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0434\u043d\u0456 \u0436\u044b\u0446\u0446\u044f \u0441\u0432\u0430\u0439\u0433\u043e, \u0431\u043e \u0411\u043e\u0433 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u044f\u0433\u043e \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0441\u044d\u0440\u0446\u0430&raquo; (\u042d\u043a\u043b 5, 18-19). \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442 \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u045e \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0456 \u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u044f\u043a\u0456 \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c \u0456 \u0437 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0435\u043c \u0437\u0431\u0456\u0440\u0430\u0435 \u0447\u0430\u0441\u043e\u0432\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b, \u0431\u043e\u043b\u044c\u0448 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u0456\u043c \u0434\u043d\u0451\u043c. \u0425\u043e\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u0451\u043d \u043c\u0430\u0435 \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u0434\u0440\u043e\u0431\u043d\u0443\u044e \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044c, \u0430 \u0442\u0430\u043c \u043f\u0435\u0440\u0430\u0436\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0448\u043c\u0430\u0442 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e. \u0401\u043d \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c, \u0447\u0430\u043c\u0443 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043d\u043d\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c &ndash; \u0433\u044d\u0442\u0430 \u0411\u043e\u0436\u044b \u0434\u0430\u0440: &laquo;\u0411\u043e \u0451\u043d \u043d\u044f\u0434\u043e\u045e\u0433\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0434\u043d\u0456 \u0436\u044b\u0446\u0446\u044f \u0441\u0432\u0430\u0439\u0433\u043e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433, \u043a\u0430\u043b\u0456 \u0434\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0430\u0434\u0440\u044b\u0432\u0430\u0435 \u044f\u0433\u043e \u0430\u0434 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0440\u044b\u043a\u0440\u0430\u0435. \u0422\u0430\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u043c\u0430\u0432\u0430\u0446\u044c \u0456 \u043d\u0435\u043f\u0430\u043a\u043e\u0456\u0446\u0446\u0430, \u0431\u043e \u0430\u0445\u043e\u043f\u0456\u0446\u044c \u044f\u0433\u043e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044c \u0430\u0434 \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0439 \u0445\u0432\u0456\u043b\u0456\u043d\u044b. \u0410\u0434\u043d\u0430\u043a \u0436\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430, \u043d\u0430\u0439\u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0430\u0439 \u0440\u044d\u0447\u0447\u0443 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u043c\u044f\u0446\u044c \u043f\u0440\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0456 \u043d\u0430\u043f\u043e\u0439, \u044f\u043a\u0456\u044f \u045e\u0434\u0437\u044f\u043b\u044f\u0435 \u0411\u043e\u0433, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0431\u0430\u0447\u044b\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0432\u0430 \u045e\u0441\u0451\u0439 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0446\u044b, \u0431\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0446\u044f\u0436\u043a\u043e\u0439 \u043f\u0440\u0430\u0446\u044b \u0456 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u043c \u043c\u044b \u045e\u0431\u0430\u0447\u044b\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0434\u0430\u0431\u0440\u043e. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u043d\u0430\u0448 \u043b\u0451\u0441: \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u043f\u0440\u0430\u0446\u0430\u0439 \u0456 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u043c\u0456. \u0406 \u0445\u043e\u0446\u044c \u0443\u0436\u043e \u0433\u044d\u0442\u0430 \u0441\u0430\u043c\u043e \u0451\u0441\u0446\u044c \u0434\u0430\u0431\u0440\u043e\u043c, \u0430\u043b\u0435 \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0436\u044b\u0446\u0446\u0451 \u043d\u0430\u0448\u0430\u0435 (\u043f\u0430\u0440. \u041a\u043b\u0441 3, 4).<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0423\u0441\u044f \u043f\u0440\u0430\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 &ndash; \u0434\u043b\u044f \u044f\u0433\u043e \u0432\u0443\u0441\u043d\u0430\u045e, \u0430\u043b\u0435 \u0434\u0443\u0448\u0430 \u044f\u0433\u043e \u043d\u0435 \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u0446\u0430. \u042f\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0430 \u043c\u0443\u0434\u0440\u0430\u0433\u0430 \u043d\u0430\u0434 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c, \u0456 \u0431\u0435\u0434\u043d\u0430\u0433\u0430, \u0448\u0442\u043e \u0432\u0435\u0434\u0430\u0435 \u044f\u043a \u0436\u044b\u0446\u044c?&raquo; (\u042d\u043a\u043b 6, 7). \u041a\u043e\u0436\u043d\u0443\u044e \u043f\u0440\u0430\u0446\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u044e\u0446\u044c \u0432\u0443\u0441\u043d\u044b, \u0442\u0440\u0443\u0448\u0447\u0430\u0446\u044c \u0437\u0443\u0431\u044b, \u043f\u0435\u0440\u0430\u0432\u0430\u0440\u0432\u0430\u0435 \u0441\u0442\u0440\u0430\u045e\u043d\u0456\u043a. \u0410 \u043a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u043a\u0440\u044b\u0445\u0443 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456 \u045e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043d\u043d\u0456, \u044f\u043d\u0430 \u0442\u0440\u044b\u0432\u0430\u0435 \u0434\u0430\u0442\u0443\u043b\u044c, \u043f\u0430\u043a\u0443\u043b\u044c \u0435\u0436\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0432\u0443\u0441\u043d\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0433\u044d\u0442\u0430, \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043d\u0430\u0441\u044b\u0447\u0430\u0435\u0446\u0446\u0430. \u0414\u0437\u0435\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430 \u043f\u0430 \u0434\u0437\u0432\u044e\u0445 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0445. \u041d\u0430\u0439\u043f\u0435\u0440\u0448 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0451\u043d \u0437\u043d\u043e\u045e \u043f\u0440\u0430\u0433\u043d\u0435 \u0435\u0436\u044b, \u0431\u043e \u044f\u043a \u043c\u0443\u0434\u0440\u044b, \u0442\u0430\u043a \u0456 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b \u043d\u0435 \u043c\u043e\u0436\u0430 \u0436\u044b\u0446\u044c \u0431\u0435\u0437 \u0435\u0436\u044b; \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u045e\u0431\u043e\u0433\u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0436\u0430\u0434\u0430\u0435, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0441\u0432\u0430\u0451 \u0441\u043b\u0430\u0431\u043e\u0435 \u0446\u0435\u043b\u0430 \u0456 \u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0437 \u0433\u043e\u043b\u0430\u0434\u0443. \u041f\u0430-\u0434\u0440\u0443\u0433\u043e\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0434\u0443\u0448\u0430 \u043d\u0435 \u043c\u0430\u0435 \u043d\u0456\u044f\u043a\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u0437 \u0435\u0436\u044b \u0434\u043b\u044f \u0446\u0435\u043b\u0430, \u0431\u043e \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u043c\u0443\u0434\u0440\u0430\u0446\u0430 \u0456 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430, \u0434\u044b \u0456 \u0431\u0435\u0434\u043d\u044b \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0442\u0443\u0434\u044b, \u0434\u0437\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u045e\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043c\u043e\u0436\u043d\u0430 \u0430\u0434\u043d\u0435\u0441\u0446\u0456 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0434\u0430 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442\u0430, \u044f\u043a\u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u0432\u0435\u0434\u0430\u044e\u0447\u044b \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0443\u0441\u044e \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u0446\u0443 \u043c\u0430\u0435 \u045e \u0432\u0443\u0441\u043d\u0430\u0445 \u0456 \u043d\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u0441\u044b\u0442\u0430\u0441\u0446\u0456, \u0431\u043e \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u043f\u0440\u0430\u0433\u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0430 \u043c\u0443\u0434\u0440\u0430\u0446\u0430 \u043d\u0430\u0434 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u0435, \u0448\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0431\u043e\u0433\u0456\u043c (\u0442\u0430\u043a\u043e\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c), \u0456\u0434\u0437\u0435 \u0432\u0443\u0437\u043a\u0430\u0439 \u0456 \u0441\u0442\u0440\u043e\u043c\u043a\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u0439 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f. \u0401\u043d \u0443\u0431\u043e\u0433\u0456 \u043d\u0430 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0456 \u0432\u0435\u0434\u0430\u0435, \u0434\u0437\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0436\u044b\u0446\u0446\u0451\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0421\u0456\u0440 23, 4-6. 3b<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d\u0435, \u041e\u0439\u0447\u0430 \u0456 \u0411\u043e\u0436\u0430 \u043c\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f, \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439 \u043c\u044f\u043d\u0435 \u045e \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f; \u0430\u0434\u0431\u044f\u0440\u044b \u0430\u0434 \u043c\u044f\u043d\u0435 \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u0430\u0435 \u0432\u043e\u043a\u0430 \u0456 \u0430\u0434\u0432\u044f\u0440\u043d\u0456 \u0430\u0434 \u043c\u044f\u043d\u0435 \u043f\u0440\u0430\u0433\u0430\u0432\u0456\u0442\u0430\u0441\u0446\u044c. <span style=\"color: #ff0000;\">*<\/span> \u0410\u0434\u0445\u0456\u043b\u0456 \u0430\u0434 \u043c\u044f\u043d\u0435 \u0431\u0435\u0441\u0441\u0430\u0440\u043e\u043c\u043d\u0443\u044e \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u043b\u0456\u0441\u044f \u043c\u0430\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u0456 \u043a\u0430\u0431 \u043d\u0435 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u043b\u0456 \u043c\u0430\u0435 \u0433\u0440\u0430\u0445\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u0445\u0456\u043b\u0456 \u0430\u0434 \u043c\u044f\u043d\u0435 \u0431\u0435\u0441\u0441\u0430\u0440\u043e\u043c\u043d\u0443\u044e \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_2_ID":"75","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0456&raquo; \u0441\u0432. \u041a\u0430\u043b\u044e\u043c\u0431\u0430\u043d\u0430, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Instr. 1 de Fide, 3-5: Opera, Dublin, 1957, pp. 62-66)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041d\u0435\u0432\u044b\u043c\u0435\u0440\u043d\u0430\u044f \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u045e\u0441\u044e\u0434\u044b, \u0431\u044f\u0437\u043c\u0435\u0440\u043d\u044b \u045e \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u043b\u0456\u0447\u044b \u0456 \u0431\u043b\u0456\u0437\u043a\u0456 \u043d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b. \u0401\u043d \u0441\u0430\u043c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u042f &ndash; \u0411\u043e\u0433 \u0431\u043b\u0456\u0437\u043a\u0456, \u0430 \u043d\u0435 \u0411\u043e\u0433 \u0434\u0430\u043b\u0451\u043a\u0456&raquo; (\u043f\u0430\u0440. \u0415\u0440 23, 23). \u0410 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433, \u044f\u043a\u043e\u0433\u0430 \u0448\u0443\u043a\u0430\u0435\u043c, \u043d\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0434\u0430\u043b\u0451\u043a\u0430, \u0430\u043b\u0435 \u045e \u043d\u0430\u0441 \u0441\u0430\u043c\u0456\u0445, \u043a\u0430\u043b\u0456 \u043c\u044b \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435\u043c \u0433\u044d\u0442\u0430\u0433\u0430. \u0416\u044b\u0432\u0435 \u045e \u043d\u0430\u0441, \u044f\u043a \u0434\u0443\u0448\u0430 \u045e \u0446\u0435\u043b\u0435, \u043a\u0430\u043b\u0456 \u043c\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u043c\u0456 \u042f\u0433\u043e \u0447\u043b\u0435\u043d\u0430\u043c\u0456, \u043a\u0430\u043b\u0456 \u043c\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u043e\u045e. \u0422\u0430\u0434\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u0441\u044f\u043b\u044e\u0441\u044f \u045e \u0456\u0445 \u0456 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0441\u044f&raquo; (\u043f\u0430\u0440. \u041b\u0456\u0447 26, 12). \u041a\u0430\u043b\u0456 \u043c\u044b \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435\u043c \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0401\u043d \u0431\u044b\u045e \u0443 \u043d\u0430\u0441, \u0442\u0430\u0434\u044b \u0401\u043d \u0430\u0436\u044b\u045e\u043b\u044f\u0435 \u043d\u0430\u0441 \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u044f\u043a \u0441\u0432\u0430\u0435 \u0436\u044b\u0432\u044b\u044f \u0447\u043b\u0435\u043d\u044b: &laquo;\u0411\u043e \u045e \u0406\u043c \u043c\u044b \u0436\u044b\u0432\u0435\u043c, &ndash; \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, &ndash; \u0440\u0443\u0445\u0430\u0435\u043c\u0441\u044f \u0456 \u0456\u0441\u043d\u0443\u0435\u043c&raquo; (\u0414\u0437 17, 28).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0445\u0442\u043e \u0437\u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u042f\u0433\u043e \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u0443\u044e, \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0443\u044e \u0456\u0441\u0442\u043e\u0442\u0443? \u0425\u0442\u043e \u0437\u043c\u043e\u0436\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0432\u0435\u043b\u0456\u0447 \u0411\u043e\u0433\u0430? \u0425\u0442\u043e \u0430\u0434\u0432\u0430\u0436\u044b\u0446\u0446\u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0432\u0435\u0434\u0430\u043d\u043d\u0435\u043c \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435, \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435, \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0456 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u0451, \u0443 \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0443\u0441\u0451, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435\u043b\u044c\u0433\u0430 \u045e\u0445\u0430\u043f\u0456\u0446\u044c, \u044f\u043a\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0431\u0430\u0447\u044b\u045e \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u0401\u043d \u0451\u0441\u0446\u044c. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0441\u043c\u0435\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0435\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043b\u044c\u043d\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0411\u043e\u0433\u0430: \u043a\u0456\u043c \u0451\u0441\u0446\u044c, \u0430\u0434\u043a\u0443\u043b\u044c \u0456 \u043d\u0430\u0432\u043e\u0448\u0442\u0430. \u041d\u0435\u043b\u044c\u0433\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c, \u043d\u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u043d\u0456 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c. \u041f\u0430\u0432\u0435\u0440 \u0436\u0430 \u0437 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u043e\u0439 \u0456 \u043c\u043e\u0446\u0430\u044e, \u0448\u0442\u043e \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u0431\u044b\u045e \u0456 \u044f\u043a\u0456\u043c \u0431\u0443\u0434\u0437\u0435, \u0431\u043e \u0411\u043e\u0433 \u043d\u044f\u0437\u043c\u0435\u043d\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0456\u043c \u0436\u0430 \u0451\u0441\u0446\u044c \u0411\u043e\u0433? \u0410\u0439\u0446\u0435\u0446, \u0421\u044b\u043d \u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b &ndash; \u0433\u044d\u0442\u0430 \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0439. \u0422\u044b\u044f \u0436, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u043d\u0435\u0430\u0431\u0441\u044f\u0436\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430, \u043d\u044f\u0445\u0430\u0439 \u0440\u0430\u043d\u0435\u0439 \u0441\u043f\u0440\u0430\u0431\u0443\u044e\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0441\u0443\u0441\u0432\u0435\u0442. \u0412\u0435\u0434\u044b \u043f\u0440\u0430 \u0421\u0432\u044f\u0442\u0443\u044e \u0422\u0440\u043e\u0439\u0446\u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u044b\u044f \u0437 \u0433\u043b\u044b\u0431\u0456\u043d\u044f\u043c\u0456 \u043c\u043e\u0440\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u041c\u0443\u0434\u0440\u0430\u0446\u0430: &laquo;\u0425\u0442\u043e \u0436 \u043c\u043e\u0436\u0430 \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435\u0434\u0430\u0441\u044f\u0433\u0430\u043b\u044c\u043d\u0430\u0435?&raquo; (\u043f\u0430\u0440. \u042d\u043a\u043b 7, 24). \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u043c\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0434\u043b\u044f \u043b\u044e\u0434\u0441\u043a\u043e\u0433\u0430 \u0432\u043e\u043a\u0430 \u043c\u0430\u0440\u0441\u043a\u0456\u044f \u0433\u043b\u044b\u0431\u0456\u043d\u0456, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0456 \u0421\u0432\u044f\u0442\u0430\u044f \u0422\u0440\u043e\u0439\u0446\u0430 \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u044f \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0440\u043e\u0437\u0443\u043c\u0443. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0445\u043e\u0447\u0430 \u0432\u0435\u0434\u0430\u0446\u044c, \u044f\u043a \u0451\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0432\u0435\u0440\u044b\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0434\u0443\u043c\u0430\u0435, \u0448\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u043f\u0440\u0430\u0437 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0435, \u0447\u044b\u043c \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443. \u0427\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0435\u0446\u0446\u0430 \u0411\u043e\u0436\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u044f\u043d\u0430 \u0430\u0434\u0434\u0430\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434 \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0406\u043c\u043a\u043d\u0456\u0441\u044f \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430 \u043d\u0435 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0448\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u044f, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c \u0436\u044b\u0446\u0446\u044f; \u043d\u0435 \u043f\u0440\u0430\u0437 \u0441\u043b\u043e\u0432\u044b, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u044f\u043a\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043f\u0440\u043e\u0441\u0442\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430, \u0430 \u043d\u0435 \u0437 \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f\u045e \u0432\u0443\u0447\u043e\u043d\u0430\u0439 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456. \u041a\u0430\u043b\u0456 \u0432\u044b\u0440\u0430\u0448\u044b\u0448 \u0443 \u0441\u0432\u0430\u0456\u0445 \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f\u0445 \u0448\u0443\u043a\u0430\u0446\u044c \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0435, \u044f\u043d\u043e \u0430\u0434\u044b\u0434\u0437\u0435 \u0434\u0430\u043b\u0435\u0439 \u0430\u0434 \u0446\u044f\u0431\u0435 (\u043f\u0430\u0440. \u042d\u043a\u043b 7, 23). \u0410 \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u0442\u043e \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0442\u0430\u043c, \u0434\u0437\u0435 \u044f\u043d\u0430 \u0451\u0441\u0446\u044c: \u043a\u0430\u043b\u044f \u0442\u0432\u0430\u0456\u0445 \u0431\u0440\u0430\u043c. \u0422\u0430\u043c, \u0434\u0437\u0435 \u044f\u043d\u0430 \u0451\u0441\u0446\u044c, \u043c\u043e\u0436\u0430\u0448 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u044f\u0435, \u0445\u043e\u0446\u044c \u043d\u0430\u0432\u0430\u0442 \u0456 \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430. \u041c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u044f\u0435 \u043f\u0430-\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0432\u0435\u0440\u044b\u043c \u0443 \u041d\u044f\u0431\u0430\u0447\u043d\u0430\u0433\u0430, \u043d\u0430\u0432\u0430\u0442 \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0447\u044b. \u0411\u043e\u0433 \u043d\u044f\u0431\u0430\u0447\u043d\u044b, \u0456 \u0442\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u0445\u043e\u0446\u044c \u043f\u044d\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043c\u043e\u0436\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u042f\u0433\u043e \u0447\u044b\u0441\u0442\u0430\u0435 \u0441\u044d\u0440\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 36 (35), 6-7\u0430; \u0420\u044b\u043c 11, 33<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0432\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u041f\u0430\u043d\u0435, \u0434\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u045e, \u0430 \u0422\u0432\u0430\u044f \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c &ndash; \u043f\u0430 \u0441\u0430\u043c\u044b\u044f \u0445\u043c\u0430\u0440\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0432\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u044f\u043a \u0432\u044b\u0441\u043e\u043a\u0456\u044f \u0433\u043e\u0440\u044b, \u0430 \u0422\u0432\u0430\u0435 \u0441\u0443\u0434\u044b, \u044f\u043a \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0433\u043b\u044b\u0431. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041e \u0433\u043b\u044b\u0431\u0456\u043d\u044f \u0431\u0430\u0433\u0430\u0446\u0446\u044f \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430! \u042f\u043a\u0456\u044f \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u044b\u044f \u043f\u0440\u044b\u0441\u0443\u0434\u044b \u042f\u0433\u043e \u0456 \u043d\u044f\u0437\u0432\u0435\u0434\u0430\u043d\u044b\u044f \u0448\u043b\u044f\u0445\u0456 \u042f\u0433\u043e\u043d\u044b\u044f!<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0432\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u044f\u043a \u0432\u044b\u0441\u043e\u043a\u0456\u044f \u0433\u043e\u0440\u044b, \u0430 \u0422\u0432\u0430\u0435 \u0441\u0443\u0434\u044b, \u044f\u043a \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0433\u043b\u044b\u0431.<\/p>\r\n"}, {"GCH_CH_2_ID":"76","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442\u0430&raquo; \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0410\u0433\u0440\u044b\u0434\u0436\u044d\u043d\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 8, 6: PG 98, 1071-1074)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0423\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0434\u0443\u0445 \u043c\u043e\u0439 \u0443 \u041f\u0430\u043d\u0443 <\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0415\u0448 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0445\u043b\u0435\u0431 \u0441\u0432\u043e\u0439 \u0456 \u043f\u0456 \u0432\u0456\u043d\u043e \u0441\u0432\u0430\u0451 \u0437 \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u0431\u043e \u045e\u0441\u0446\u0435\u0448\u044b\u045e\u0441\u044f \u0411\u043e\u0433 \u0442\u0432\u0430\u0456\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456. \u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0442\u0432\u0430\u0451 \u0431\u0443\u0434\u0437\u0435 \u0431\u0435\u043b\u044b\u043c, \u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443 \u0430\u043b\u0435\u044e \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0435 \u0422\u0432\u0430\u0451\u0439&raquo; (\u042d\u043a\u043b 9, 7).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0431 \u043c\u044b \u0437\u0430\u0445\u0430\u0446\u0435\u043b\u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u045e \u043d\u0435\u043f\u0430\u0441\u0440\u044d\u0434\u043d\u044b\u043c \u0456 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0456, \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u0431 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u043d\u0430\u0441 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442, \u043a\u0430\u0431 \u043c\u044b \u0436\u044b\u043b\u0456 \u045e \u043f\u0440\u0430\u0441\u0442\u0430\u0446\u0435 \u0456 \u043f\u0440\u044b\u0432\u044f\u0437\u0430\u043d\u043d\u0430\u0441\u0446\u0456 \u0434\u0430 \u045e\u043a\u0430\u0437\u0430\u043d\u043d\u044f\u045e \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0439 \u0432\u0435\u0440\u044b \u045e \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043b\u0456 \u0445\u043b\u0435\u0431 \u0456 \u043f\u0456\u043b\u0456 \u0432\u0456\u043d\u043e \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u0437 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c. \u0417\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0437\u0433\u0443\u0431\u043d\u044b\u043c \u0432\u0443\u0447\u044d\u043d\u043d\u044f\u043c \u0446\u0456 \u043d\u0435\u045e\u043b\u0430\u0441\u0446\u0456\u0432\u044b\u043c \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u043c, \u0430\u043b\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u043e\u043b\u044c\u0448 \u043c\u0435\u043b\u0456 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043b\u0443\u0448\u043d\u0430\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430 \u043c\u0435\u0440\u044b \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u043b\u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u043c \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u043e\u0441\u0456\u0446\u044c, \u0437 \u043f\u043e\u045e\u043d\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u043d\u0430\u0441\u0446\u044e \u045e \u0433\u044d\u0442\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0456 \u0447\u044b\u043d\u0430\u0445, \u0443 \u044f\u043a\u0456\u0445 \u0441\u0430\u043c \u0411\u043e\u0433 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0436 \u0442\u043b\u0443\u043c\u0430\u0447\u044d\u043d\u043d\u0435 \u0432\u044f\u0434\u0437\u0435 \u043d\u0430\u0441 \u0434\u0430 \u0431\u043e\u043b\u044c\u0448 \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u044f. \u0417\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043c\u044b\u0441\u043b\u0456\u0446\u044c \u043f\u0440\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0456 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043b\u044c\u043d\u044b \u0425\u043b\u0435\u0431, \u044f\u043a\u0456 \u0437\u044b\u0448\u043e\u045e \u0437 \u043d\u0435\u0431\u0430 \u0456 \u0434\u0430\u045e \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0435\u0442\u0443. \u0417\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0456\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0432\u0456\u043d\u043e, \u044f\u043a\u043e\u0435 \u0432\u044b\u0446\u044f\u043a\u043b\u0430 \u045e \u0447\u0430\u0441 \u0437\u0431\u0430\u045e\u0447\u0430\u0439 \u043c\u0443\u043a\u0456 \u0437 \u0431\u043e\u043a\u0443 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u0439 \u043b\u0430\u0437\u044b. \u041f\u0440\u0430 \u0456\u0445 \u043a\u0430\u0436\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f: &laquo;\u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u0435\u043b\u0456, \u0415\u0437\u0443\u0441 \u0443\u0437\u044f\u045e \u0445\u043b\u0435\u0431, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e&raquo; \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u044b\u043c \u0432\u0443\u0447\u043d\u044f\u043c: &ldquo;\u0411\u044f\u0440\u044b\u0446\u0435 \u0456 \u0435\u0448\u0446\u0435, \u0433\u044d\u0442\u0430 \u0426\u0435\u043b\u0430 \u041c\u0430\u0451&rdquo;. \u0406 \u045e\u0437\u044f\u045e\u0448\u044b \u043a\u0435\u043b\u0456\u0445, \u0456 \u045e\u0437\u043d\u0451\u0441\u0448\u044b \u043f\u0430\u0434\u0437\u044f\u043a\u0443, \u0434\u0430\u045e \u0456\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u041f\u0456\u0446\u0435 \u0437 \u044f\u0433\u043e \u045e\u0441\u0435, \u0431\u043e \u0433\u044d\u0442\u0430 \u041a\u0440\u043e\u045e \u041c\u0430\u044f \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u044f\u043a\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u043b\u0456\u0442\u0430 \u0437\u0430 \u043c\u043d\u043e\u0433\u0456\u0445 \u0434\u0437\u0435\u043b\u044f \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u044f \u0433\u0440\u0430\u0445\u043e\u045e&rdquo;&raquo; (\u043f\u0430\u0440. \u041c\u0446 26, 26-28). \u0422\u044b\u044f, \u0448\u0442\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u044e\u0446\u044c \u0433\u044d\u0442\u044b \u0445\u043b\u0435\u0431 \u0456 \u043f&rsquo;\u044e\u0446\u044c \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u0435 \u0432\u0456\u043d\u043e, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0432\u0435\u0441\u044f\u043b\u044f\u0446\u0446\u0430 \u0456 \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0422\u044b \u0434\u0430\u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c&raquo; (\u043f\u0430\u0440. \u041f\u0441 4, 8).<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u043c\u0430\u044e, \u0448\u0442\u043e \u0441\u043b\u043e\u0432\u044b \u045e\u0432\u0430\u0441\u043e\u0431\u043b\u0435\u043d\u0430\u0439 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b: &laquo;\u0425\u0430\u0434\u0437\u0456\u0446\u0435, \u0435\u0448\u0446\u0435 \u0445\u043b\u0435\u0431 \u043c\u043e\u0439, \u043f\u0456\u0446\u0435 \u0432\u0456\u043d\u043e, \u044f\u043a\u043e\u0435 \u0437\u043c\u044f\u0448\u0430\u043b\u0430&raquo; \u0437 \u043a\u043d\u0456\u0433\u0456 \u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e (9, 5) \u0434\u0430\u0442\u044b\u0447\u0430\u0446\u044c \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0445\u043b\u0435\u0431\u0430 \u0456 \u0432\u0456\u043d\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u043d\u0430 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043b\u044c\u043d\u044b \u045e\u0434\u0437\u0435\u043b \u0443 \u0421\u043b\u043e\u0432\u0435. \u0422\u044b\u044f, \u0448\u0442\u043e \u043c\u0430\u044e\u0446\u044c \u0443\u0434\u0437\u0435\u043b, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u0433\u044d\u0442\u0430\u0433\u0430; \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043d\u0430\u0441\u0456\u0446\u044c \u0431\u0435\u043b\u044b\u044f \u0448\u0430\u0442\u044b, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0443\u0447\u044b\u043d\u043a\u0456 \u0441\u0432\u044f\u0442\u043b\u0430, \u044f\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0443 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u043b\u043e \u0432\u0430\u0448\u0430 \u0442\u0430\u043a \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0432\u0430\u0448\u044b \u0434\u043e\u0431\u0440\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u0410\u0439\u0446\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u044f\u043a\u0456 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445&raquo; (\u041c\u0446 5, 16). \u0422\u0430\u0434\u044b \u0441\u043f\u043b\u044b\u0432\u0435 \u043d\u0430 \u0456\u0445 \u0433\u0430\u043b\u043e\u0432\u044b \u0430\u043b\u0435\u0439, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0414\u0443\u0445 \u041f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a\u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u0435 \u0456 \u0430\u0431\u0430\u0440\u043e\u043d\u0456\u0446\u044c \u0430\u0434 \u043a\u043e\u0436\u043d\u0430\u0439 \u0440\u0430\u043d\u044b \u0433\u0440\u0430\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 16 (15), 8b-9\u0430. 5\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u043c\u044f\u043d\u0435, \u0456 \u044f \u043d\u0435 \u043f\u0430\u0445\u0456\u0441\u043d\u0443\u0441\u044f. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0430\u043c\u0443 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u0434\u0443\u0448\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d &ndash; \u0447\u0430\u0441\u0442\u043a\u0430 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u043c\u0430\u0451\u0439 \u0456 \u043a\u0435\u043b\u0456\u0445\u0430 \u043c\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u0434\u0443\u0448\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"77","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442\u0430&raquo; \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0410\u0433\u0440\u044b\u0436\u044d\u043d\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 10, 2: PG 98, 1138-1139)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u0441\u0442\u0443\u043f\u0456\u0446\u0435 \u0434\u0430 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0440\u0430\u0441\u0432\u044f\u0442\u043b\u0456\u0446\u0435\u0441\u044f <\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0421\u0430\u043b\u043e\u0434\u043a\u0430\u0435, &ndash; \u043a\u0430\u0436\u0430 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442, &ndash; \u0441\u0432\u044f\u0442\u043b\u043e&raquo; (\u042d\u043a\u043b 11, 7), \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430 \u043d\u0430\u0448\u044b\u043c \u0432\u0430\u0447\u0430\u043c \u0431\u0430\u0447\u044b\u0446\u044c \u0441\u043e\u043d\u0446\u0430. \u041a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u0441\u0432\u044f\u0442\u043b\u0430, \u0441\u0432\u0435\u0442 \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u0431\u044b \u0441\u0432\u043e\u0439 \u0432\u044b\u0433\u043b\u044f\u0434 \u0456 \u045e\u0441\u0451 \u0431 \u0436\u044b\u0432\u043e\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430. \u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u041c\u0430\u0439\u0441\u0435\u0439, \u0437\u0430\u0433\u043b\u044b\u0431\u043b\u044f\u044e\u0447\u044b\u0441\u044f \u045e \u0411\u043e\u0436\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b: &laquo;\u0406 \u045e\u0431\u0430\u0447\u044b\u045e \u0411\u043e\u0433 \u0441\u0432\u044f\u0442\u043b\u043e, \u0448\u0442\u043e \u044f\u043d\u043e \u0434\u043e\u0431\u0440\u0430\u0435&raquo; (\u0411\u044b\u0446 1, 3). \u041d\u0430\u043c \u0436\u0430 \u0432\u044b\u043f\u0430\u0434\u0430\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043f\u0440\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, &laquo;\u044f\u043a\u043e\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0441\u0432\u0435\u0442&raquo; (\u042f\u043d 1, 9), \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0417\u0431\u0430\u045e\u0446\u0443 \u0456 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f \u0441\u0432\u0435\u0442\u0443, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0456 \u0437\u044b\u0448\u043e\u045e \u0443 \u0441\u0430\u043c\u044b\u044f \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u044f. \u0413\u044d\u0442\u0430 \u043f\u0440\u0430 \u042f\u0433\u043e \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0440\u043e\u043a \u0414\u0430\u0432\u0456\u0434: &laquo;\u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u0411\u043e\u0433\u0443, \u0441\u043b\u0430\u045e\u0446\u0435 \u0456\u043c\u044f \u042f\u0433\u043e, \u0440\u0430\u045e\u043d\u044f\u0439\u0446\u0435 \u0434\u0430\u0440\u043e\u0433\u0443 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u043d\u0430 \u0417\u0430\u0445\u0430\u0434. \u041f\u0430\u043d &ndash; \u0456\u043c\u044f \u042f\u0433\u043e, \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c&raquo; (\u043f\u0430\u0440. \u041f\u0441 68 [67], 5).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442 \u043d\u0430\u0437\u0432\u0430\u045e \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0430\u043b\u043e\u0434\u043a\u0456\u043c \u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u043d\u0430\u043c \u043f\u0440\u044b\u0435\u043c\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0421\u043e\u043d\u0446\u0430 \u0445\u0432\u0430\u043b\u044b, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043d\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u045e \u043c\u043e\u043c\u0430\u043d\u0442 \u0411\u043e\u0441\u043a\u0430\u0433\u0430 \u0423\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f &ndash; \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0442\u0443. \u0425\u0442\u043e \u0456\u0434\u0437\u0435 \u0437\u0430 \u041c\u043d\u043e\u044e, \u0442\u043e\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0446\u0435\u043c\u0440\u044b, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u0436\u044b\u0446\u0446\u044f&raquo; (\u042f\u043d 8, 12). \u0406 \u0434\u0430\u043b\u0435\u0439: &laquo;\u0410 \u0441\u0443\u0434 \u0443 \u0442\u044b\u043c, \u0448\u0442\u043e \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0440\u044b\u0439\u0448\u043b\u043e \u043d\u0430 \u0441\u0432\u0435\u0442&raquo; (\u042f\u043d 3, 19). \u0422\u0430\u043a \u0441\u043e\u043d\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u044f\u043a\u043e\u0435 \u0431\u0430\u0447\u044b\u043b\u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u044f \u0432\u043e\u0447\u044b, \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0421\u043e\u043d\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0413\u044d\u0442\u0430\u0435 \u0421\u043e\u043d\u0446\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u044b\u043b\u043e \u043f\u043e\u045e\u043d\u0430\u0435 \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u044b\u045e \u0433\u043e\u0434\u043d\u044b \u0441\u0442\u0430\u0446\u044c \u0432\u0443\u0447\u043d\u0435\u043c \u041f\u0430\u043d\u0430 \u0456 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u043d\u0430 \u045e\u043b\u0430\u0441\u043d\u044b\u044f \u0432\u043e\u0447\u044b \u044f\u043a \u0401\u043d \u0436\u044b\u045e \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439, \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0437 \u0456\u043c\u0456, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0431\u044b\u045e \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0445\u043e\u0446\u044c \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0401\u043d \u0431\u044b\u045e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0411\u043e\u0433\u0430\u043c \u0456 \u0442\u0430\u043c\u0443 \u043c\u043e\u0433 \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0442\u0430\u043a, \u0448\u0442\u043e \u0441\u043b\u044f\u043f\u044b\u044f \u043f\u0430\u0447\u044b\u043d\u0430\u043b\u0456 \u0431\u0430\u0447\u044b\u0446\u044c, \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u044b\u044f \u0445\u0430\u0434\u0437\u0456\u0446\u044c, \u043d\u044f\u043c\u044b\u044f \u0447\u0443\u0446\u044c, \u043f\u0440\u0430\u043a\u0430\u0436\u043e\u043d\u044b\u044f \u0430\u0447\u044b\u0448\u0447\u0430\u043b\u0456\u0441\u044f, \u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f \u0430\u0434\u043d\u044b\u043c \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c \u0432\u044f\u0440\u0442\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0440\u044d\u0447\u044b \u0456 \u0446\u044f\u043f\u0435\u0440 \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u0441\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u0430\u0433\u0430 \u0437\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0432\u043e\u0447\u044b \u0434\u0443\u0448\u044b \u0434\u0430 \u042f\u0433\u043e, \u043a\u0430\u0431 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u0456 \u045e\u0433\u043b\u044f\u0434\u0430\u0446\u0446\u0430 \u045e \u0433\u044d\u0442\u0443\u044e \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0443\u044e \u0411\u043e\u0441\u043a\u0443\u044e \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u043c \u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u044b\u043c \u043f\u0440\u0430\u0437 \u0443\u0434\u0437\u0435\u043b \u0456 \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u044c \u0441\u0430 \u0421\u0432\u044f\u0442\u043b\u043e\u043c, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0441\u043b\u043e\u0434\u044b\u0447\u0443, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u043c \u0443 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u043d\u0430\u0431\u044b\u0446\u044c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435, \u0456 \u045e\u0440\u044d\u0448\u0446\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0411\u043e\u0436\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e \u043d\u0430\u043c \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442, \u043a\u0430\u043b\u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0436\u044b\u0432\u0435 \u0448\u043c\u0430\u0442 \u0433\u0430\u0434\u043e\u045e, \u043d\u044f\u0445\u0430\u0439 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u045e\u0441\u0456\u043c\u0456&raquo; (\u043f\u0430\u0440. \u042d\u043a\u043b 6, 3). \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0421\u043e\u043d\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0434\u043b\u044f \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u0445\u0442\u043e \u045e\u0433\u043b\u044f\u0434\u0430\u0435\u0446\u0446\u0430 \u045e \u044f\u0433\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0414\u0430\u0432\u0456\u0434\u0430: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0443\u0437\u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u0456 \u045e\u0437\u0432\u0435\u0441\u044f\u043b\u044f\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0456 \u0442\u0440\u044b\u0443\u043c\u0444\u0443\u044e\u0446\u044c \u0443 \u0440\u0430\u0434\u0430\u0441\u0446\u0456&raquo; (\u043f\u0430\u0440. \u041f\u0441 68 [67], 4), \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: &laquo;\u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u041f\u0430\u043d\u0443, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f, \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u042f\u0433\u043e&raquo; (\u043f\u0430\u0440. \u041f\u0441 33 [32], 1).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 34 (33), 4. 6; \u043f\u0430\u0440. \u041a\u043b\u0441 1, 12b-13\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0439 \u041f\u0430\u043d\u0430 \u0441\u0430 \u043c\u043d\u043e\u0439, \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0437\u0432\u044b\u0448\u0430\u0446\u044c \u0456\u043c\u044f \u042f\u0433\u043e \u0440\u0430\u0437\u0430\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0413\u043b\u044f\u043d\u044c\u0446\u0435 \u043d\u0430 \u042f\u0433\u043e \u0456 \u043f\u0440\u0430\u0441\u0432\u044f\u0442\u043b\u0456\u0446\u0435\u0441\u044f, \u0456 \u0442\u0432\u0430\u0440\u044b \u0432\u0430\u0448\u044b\u044f \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0441\u043e\u0440\u0430\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0430\u0441 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c\u0456 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0435 \u0441\u0432\u044f\u0442\u044b\u0445 \u0443 \u0441\u0432\u044f\u0442\u043b\u0435 \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0437-\u043f\u0430\u0434 \u0443\u043b\u0430\u0434\u044b \u0446\u0435\u043c\u0440\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u043b\u044f\u043d\u044c\u0446\u0435 \u043d\u0430 \u042f\u0433\u043e \u0456 \u043f\u0440\u0430\u0441\u0432\u044f\u0442\u043b\u0456\u0446\u0435\u0441\u044f, \u0456 \u0442\u0432\u0430\u0440\u044b \u0432\u0430\u0448\u044b\u044f \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0441\u043e\u0440\u0430\u043c\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"81","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0401\u0432\u0430&raquo; \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 1, 2. 36: PL 75, 529-530. 543-544)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0456 \u0431\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0456, \u0448\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0447\u044b\u043c \u0451\u0441\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u041d\u0435 \u0437\u0434\u0430\u0431\u044b\u045e\u0448\u044b \u0446\u043d\u043e\u0442\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043d\u044b \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u0443 \u043d\u044f\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u0456. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0434\u043b\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043d\u0435 \u045e\u043c\u0435\u044e\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u043d\u044f\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u044c \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u0432\u0443\u0447\u043d\u044f\u045e \u0441\u043b\u043e\u0432\u0430\u043c\u0456: &laquo;\u0425\u0430\u0447\u0443, \u043a\u0430\u0431 \u0432\u044b \u0431\u044b\u043b\u0456 \u043c\u0443\u0434\u0440\u044b\u044f \u045e \u0434\u043e\u0431\u0440\u044b\u043c \u0456 \u043d\u0435\u0437\u0430\u043f\u043b\u044f\u043c\u043b\u0435\u043d\u044b\u044f \u0437\u043b\u043e\u043c&raquo;. \u0406 \u044f\u0448\u0447\u044d: &laquo;\u041d\u0435 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u045e \u0434\u0443\u043c\u043a\u0430\u0445, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0434\u043b\u044f \u0437\u043b\u0430&raquo; (1 \u041a\u0430\u0440 14, 20).<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0447\u0430\u043c\u0443 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0432\u0430\u0441\u043e\u0431\u043b\u0435\u043d\u0430\u044f \u041f\u0440\u0430\u045e\u0434\u0430 \u0434\u0430\u0435 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b \u043d\u0430\u043a\u0430\u0437 \u0441\u0432\u0430\u0456\u043c \u0432\u0443\u0447\u043d\u044f\u043c: &laquo;\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u044f, \u044f\u043a \u0437\u043c\u0435\u0456, \u0456 \u043f\u0440\u043e\u0441\u0442\u044b\u044f, \u044f\u043a \u0433\u0430\u043b\u0443\u0431\u044b&raquo; (\u041c\u0446 10, 16). \u0423 \u0433\u044d\u0442\u044b\u043c \u043d\u0430\u043a\u0430\u0437\u0435 \u0430\u0431\u0435\u0434\u0437\u0432\u0435 \u0446\u043d\u043e\u0442\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u044f\u043a \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u044f: \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0437\u043c\u044f\u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u043e\u0439 \u0433\u043e\u043b\u0443\u0431\u0430, \u0430 \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u0430 \u0433\u043e\u043b\u0443\u0431\u0430 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0445\u0456\u0442\u0440\u0430\u0441\u0446\u044c \u0437\u043c\u044f\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043b\u044e\u0434\u0437\u044f\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0433\u0430\u043b\u0443\u0431\u043a\u0456, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0430\u0433\u043d\u044e, \u0431\u043e \u045e\u0441\u0435, \u0445\u0442\u043e \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0443\u043b\u0430\u0441\u0446\u0456\u0432\u0443\u044e \u043f\u0440\u0430\u0441\u0442\u0430\u0446\u0435 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0433\u043e\u0440\u0430\u0447\u0430 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0434\u043b\u044f \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0413\u044d\u0442\u0430 \u0431\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0456 \u0431\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u044b, \u044f\u043a\u0456 \u045e\u0445\u0456\u043b\u044f\u045e\u0441\u044f \u0430\u0434 \u0437\u043b\u0430&raquo; (\u0401\u045e 1, 1). \u0425\u0442\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0410\u0439\u0447\u044b\u043d\u044b, \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u0436\u044b\u0432\u0435 \u045e \u043f\u0440\u0430\u0441\u0442\u0430\u0446\u0435 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u041f\u0440\u0430\u0441\u0442\u0430\u0442\u0443 \u0432\u044b\u044f\u045e\u043b\u044f\u0435 \u0432\u0430 \u045e\u0447\u044b\u043d\u043a\u0430\u0445, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u0456 \u0432\u0435\u0440\u044b. \u0401\u043d \u043f\u043e\u045e\u043d\u044b \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u044b \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0434\u0430\u0431\u0440\u0430, \u044f\u043a\u043e\u0435 \u0447\u044b\u043d\u0456\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0432\u044b\u0448\u044d\u0439\u0448\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u044f\u043a\u0456\u044f \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u045e \u0441\u044d\u0440\u0446\u044b. \u0401\u0441\u0446\u044c \u043b\u044e\u0434\u0437\u0456, \u044f\u043a\u0456\u043c \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u044b \u045e \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u0456 \u0434\u0430\u0431\u0440\u0430. \u042f\u043d\u044b \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u043d\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b \u0437\u0430 \u045e\u0447\u044b\u043d\u0435\u043d\u0430\u0435 \u0434\u0430\u0431\u0440\u043e, \u0430\u043b\u0435 \u0437\u043d\u0435\u0448\u043d\u044f\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043c\u0443\u0434\u0440\u044d\u0446 \u043a\u0430\u0436\u0430: &laquo;\u0413\u043e\u0440\u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0443, \u0448\u0442\u043e \u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0430 \u0434\u0437\u0432\u044e\u0445 \u0441\u0446\u0435\u0436\u043a\u0430\u0445&raquo; (\u0421\u0456\u0440 2, 12). \u0414\u0437\u0432\u044e\u043c\u0430 \u0441\u0446\u0435\u0436\u043a\u0430\u043c\u0456 \u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0433\u0440\u044d\u0448\u043d\u0456\u043a \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u044f\u0433\u043e \u045e\u0447\u044b\u043d\u0430\u043a \u0437\u043d\u0435\u0448\u043d\u0435 \u043d\u0456\u0431\u044b \u043f\u0430\u0431\u043e\u0436\u043d\u044b, \u0430\u043b\u0435 \u043d\u0430\u043c\u0435\u0440 \u0437\u044f\u043c\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u0443\u0448\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0411\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u044b, \u044f\u043a\u0456 \u045e\u0445\u0456\u043b\u044f\u045e\u0441\u044f \u0430\u0434 \u0437\u043b\u0430&raquo;, \u0431\u043e \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0434\u0430\u0440\u043e\u0433\u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u044b \u043f\u0440\u0430\u0437 \u0431\u043e\u044f\u0437\u044c \u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u044f\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e. \u041f\u0430-\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0435 \u0437\u043b\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0431\u043e\u043b\u044c\u0448 \u0443\u0436\u043e \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u0446\u044c. \u041a\u0430\u043b\u0456 \u0436 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u0431\u043e\u044f\u0437\u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u0434\u0430\u0431\u0440\u043e, \u0442\u043e \u0433\u044d\u0442\u044b\u043c \u0456 \u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u0431\u043e \u044f\u0448\u0447\u044d \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430 \u043d\u0435 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0430\u0434 \u0437\u043b\u0430, \u0456 \u0433\u0440\u0430\u0448\u044b\u045e \u0431\u044b, \u043a\u0430\u043b\u0456 \u0431 \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0433\u044d\u0442\u0430 \u0440\u0430\u0431\u0456\u0446\u044c \u0431\u0435\u0441\u043f\u0430\u043a\u0430\u0440\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u043d\u0430, \u0448\u0442\u043e \u0401\u045e \u0431\u0430\u044f\u045e\u0441\u044f \u0411\u043e\u0433\u0430, \u0432\u0435\u043b\u044c\u043c\u0456 \u0441\u043b\u0443\u0448\u043d\u0430 \u0434\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430, \u0448\u0442\u043e \u045e\u0445\u0456\u043b\u044f\u045e\u0441\u044f \u0430\u0434 \u0437\u043b\u0430. \u0411\u043e \u043a\u0430\u043b\u0456 \u043b\u044e\u0431\u043e\u045e \u0456\u0434\u0437\u0435 \u0437\u0430 \u0431\u043e\u044f\u0437\u0437\u044e, \u0442\u0430\u0434\u044b \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u044f\u0448\u0447\u044d \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0434\u0443\u0448\u044b, \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0447\u044b\u043d\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0431\u0440 13, 21; 2 \u041c\u0430\u043a 1, 4<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0411\u043e\u0433 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u0446\u044c \u0432\u0430\u0441 \u0432\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u043a\u0430\u0431 \u0432\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u042f\u0433\u043e\u043d\u0443\u044e \u0432\u043e\u043b\u044e,<span style=\"color: #ff0000;\"> *<\/span> \u0440\u043e\u0431\u044f\u0447\u044b \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u042f\u043c\u0443, \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0430\u0434\u043a\u0440\u044b\u0435 \u0432\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0434\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0417\u0430\u043a\u043e\u043d\u0443 \u0456 \u0434\u043b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u043e\u0431\u044f\u0447\u044b \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u042f\u043c\u0443, \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"82","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0401\u0432\u0430&raquo; \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 3, 15-16: PL 75, 606-608)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0414\u0430\u0431\u0440\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0447\u0430\u043c\u0443 \u0437\u043b\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043d\u0435 \u043c\u043e\u0436\u0430\u043c?<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432. \u041f\u0430\u0432\u0435\u043b, \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u045e\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u044e\u0447\u044b \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430, \u043a\u0430\u0437\u0430\u045e: &laquo;\u041c\u044b \u043c\u0430\u0435\u043c \u0441\u043a\u0430\u0440\u0431 \u0443 \u0433\u043b\u0456\u043d\u044f\u043d\u044b\u0445 \u043d\u0430\u0447\u044b\u043d\u043d\u044f\u0445, \u043a\u0430\u0431 \u0432\u0435\u043b\u0456\u0447 \u043c\u043e\u0446\u044b \u0431\u044b\u043b\u0430 \u0411\u043e\u0436\u0430\u044f, \u0430 \u043d\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0430\u0434 \u043d\u0430\u0441&raquo; (2 \u041a\u0430\u0440 4, 7). \u0423 \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u043c\u0443\u0436\u0430 \u0401\u0432\u0430 \u0433\u043b\u0456\u043d\u044f\u043d\u0430\u0435 \u043d\u0430\u0447\u044b\u043d\u043d\u0435 \u0431\u044b\u043b\u043e \u0440\u0430\u0437\u0431\u0456\u0442\u0430 \u043d\u0430\u043d\u0435\u0441\u0435\u043d\u044b\u043c\u0456 \u0440\u0430\u043d\u0430\u043c\u0456, \u0430\u043b\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0441\u043a\u0430\u0440\u0431 \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u044b\u043c. \u0412\u043e\u043d\u043a\u0430\u0432\u0430 \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0431\u0430\u043b\u044e\u0447\u044b\u044f \u0440\u0430\u043d\u044b, \u0443 \u0434\u0443\u0448\u044b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043d\u0430\u0437\u0430\u043f\u0430\u0448\u0432\u0430\u0435 \u0441\u043a\u0430\u0440\u0431 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u044f\u043a\u0456 \u0432\u044b\u044f\u0432\u0456\u045e\u0441\u044f \u045e \u0441\u043b\u043e\u0432\u0430\u0445, \u043f\u043e\u045e\u043d\u044b\u0445 \u0441\u0432\u044f\u0442\u043e\u0439 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456: &laquo;\u0414\u0430\u0431\u0440\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0447\u0430\u043c\u0443 \u0437\u043b\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043d\u0435 \u043c\u043e\u0436\u0430\u043c?&raquo; (\u0401\u045e 2, 10). \u0411\u043e\u0436\u044b\u044f \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b, \u044f\u043a \u0437\u044f\u043c\u043d\u044b\u044f, \u0442\u0430\u043a \u0456 \u0432\u0435\u0447\u043d\u044b\u044f, \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0434\u0430\u0431\u0440\u043e\u043c, \u0430 \u0437\u043b\u043e\u043c &ndash; \u0441\u043f\u0430\u0437\u043d\u0430\u043d\u044b\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u041f\u0430\u043d \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430: &laquo;\u042f &ndash; \u041f\u0430\u043d, \u0456 \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430. \u042f \u0444\u0430\u0440\u043c\u0443\u044e \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u0441\u0442\u0432\u0430\u0440\u0430\u044e \u0446\u0435\u043c\u0440\u0443, \u0447\u044b\u043d\u044e \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442 \u0456 \u0441\u0442\u0432\u0430\u0440\u0430\u044e \u043d\u044f\u0434\u043e\u043b\u044e&raquo; (\u0406\u0441 45, 5\u0430. 7).<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u042f \u0444\u0430\u0440\u043c\u0443\u044e \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u0441\u0442\u0432\u0430\u0440\u0430\u044e \u0446\u0435\u043c\u0440\u0443&raquo;, \u0431\u043e \u043a\u0430\u043b\u0456 \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f \u0432\u043e\u043d\u043a\u0430\u0432\u0430 \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0446\u0435\u043c\u0440\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e, \u0442\u0430\u0434\u044b \u045e\u043d\u0443\u0442\u0440\u044b \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044e \u0411\u043e\u0436\u044b\u0445 \u0441\u043f\u0440\u0430\u045e \u0433\u0430\u0440\u044b\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u0443\u0448\u044b. &laquo;\u0427\u044b\u043d\u044e \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442 \u0456 \u0441\u0442\u0432\u0430\u0440\u0430\u044e \u043d\u044f\u0434\u043e\u043b\u044e&raquo;, \u0431\u043e \u043a\u0430\u043b\u0456 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u0434\u043e\u0431\u0440\u0430\u0435 \u043f\u0430 \u0441\u0432\u0430\u0451\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0430\u043b\u0435 \u043d\u0435\u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430 \u0436\u0430\u0434\u0430\u043d\u0430\u0435 \u043d\u0430\u043c\u0456 \u0432\u044f\u0434\u0437\u0435 \u043d\u0430\u0441 \u0434\u0430 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f \u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435\u043c, \u0442\u0430\u0434\u044b \u043c\u044b \u0437\u043d\u043e\u045e \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0441\u043f\u0430\u043a\u043e\u0439 \u0437 \u0411\u043e\u0433\u0430\u043c. \u0413\u0440\u044d\u0445 \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u0435 \u043f\u0440\u044b\u044f\u0437\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u043c\u0456\u0436 \u043d\u0430\u043c\u0456 \u0456 \u0411\u043e\u0433\u0430\u043c, \u0442\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u043c\u044b \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u0441\u043f\u0430\u043a\u043e\u044e \u0441\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c. \u041a\u0430\u043b\u0456 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u0434\u043e\u0431\u0440\u0430\u0435 \u043f\u0430 \u0441\u0432\u0430\u0451\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f, \u0442\u0430\u0434\u044b, \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b\u044f, \u043c\u044b \u0437 \u043f\u0430\u043a\u043e\u0440\u0430\u0439 \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435\u043c \u0441\u043f\u0430\u043a\u043e\u0439 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0430 \u045e\u0441\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u0401\u0432\u0430 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0439 \u0443\u0432\u0430\u0433\u0456 \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0437 \u044f\u043a\u043e\u0439 \u0451\u043d \u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c \u043d\u0430\u043c\u043e\u0432\u0430\u043c \u0436\u043e\u043d\u043a\u0456: &laquo;\u0414\u0430\u0431\u0440\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0447\u0430\u043c\u0443 \u0437\u043b\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043d\u0435 \u043c\u043e\u0436\u0430\u043c?&raquo; \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0441\u043f\u0430\u043c\u0456\u043d \u043f\u0440\u0430 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b, \u044f\u043a\u0456\u044f \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0434 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f. \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435, \u043a\u0430\u043b\u0456 \u0441\u0432\u043e\u0435\u0447\u0430\u0441\u043e\u0432\u0430 \u045e\u043c\u0430\u0446\u0443\u0435 \u044f\u0433\u043e \u045e\u0441\u043f\u0430\u043c\u0456\u043d \u043f\u0440\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b. \u0422\u0430\u043c\u0443 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0423 \u0447\u0430\u0441 \u043f\u043e\u0441\u043f\u0435\u0445\u0443 \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0439 \u043f\u0440\u0430 \u043f\u0440\u044b\u043a\u0440\u0430\u0441\u0446\u0456, \u0430 \u045e \u043f\u0440\u044b\u043a\u0440\u044b\u044f \u0445\u0432\u0456\u043b\u0456\u043d\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u0439 \u043f\u0440\u0430 \u0448\u0447\u0430\u0441\u0446\u0435&raquo; (\u043f\u0430\u0440. \u0421\u0456\u0440 11, 25).<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u0456 \u043d\u0435 \u043c\u0430\u0435 \u043d\u0456\u044f\u043a\u0456\u0445 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u045e, \u0442\u043e\u0439 \u0443 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c \u043d\u0430\u0441\u0442\u0440\u043e\u0456 \u0445\u0443\u0442\u043a\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u043c. \u0410 \u043a\u0430\u0433\u043e \u043c\u0443\u0447\u0430\u044e\u0446\u044c \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0456 \u0456 \u0445\u0442\u043e \u043d\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f \u0430\u0434 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u0445 \u0440\u0430\u043d\u0435\u0439 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u045e, \u0433\u0443\u0431\u043b\u044f\u0435 \u0440\u0430\u045e\u043d\u0430\u0432\u0430\u0433\u0443 \u0434\u0443\u0445\u0430, \u0443\u043f\u0430\u0434\u0430\u044e\u0447\u044b \u0446\u0430\u043b\u043a\u0430\u043c \u0443 \u0440\u043e\u0441\u043f\u0430\u0447.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u043b\u0443\u0447\u044b\u0446\u044c \u0430\u0431\u0435\u0434\u0437\u0432\u0435 \u0433\u044d\u0442\u044b\u044f \u043f\u0430\u0441\u0442\u0430\u0432\u044b, \u043a\u0430\u0431 \u0430\u0434\u043d\u0430 \u0434\u0430\u043f\u0430\u045e\u043d\u044f\u043b\u0430 \u0434\u0440\u0443\u0433\u0443\u044e; \u043a\u0430\u0431 \u0443\u0441\u043f\u0430\u043c\u0456\u043d \u043f\u0440\u0430 \u0434\u0430\u0431\u0440\u043e \u0434\u0430\u0432\u0430\u045e \u043f\u0430\u043b\u0451\u0433\u043a\u0443 \u045e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u0448\u0442\u043e \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u043b\u0430 \u043d\u0430\u0441 \u0437-\u0437\u0430 \u043f\u0440\u044b\u043a\u0440\u044b\u0445 \u043f\u0435\u0440\u0430\u0436\u044b\u0432\u0430\u043d\u043d\u044f\u045e, \u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0434\u0430\u0431\u0440\u0443 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u0441\u0442\u0440\u0430\u0445 \u043f\u0435\u0440\u0430\u0434 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0441\u0432\u043e\u0439 \u0434\u0443\u0445, \u0437\u043c\u0443\u0447\u0430\u043d\u044b \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u043c\u0456 \u0441\u0432\u044f\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0401\u045e \u043f\u0440\u044b\u0433\u0430\u0434\u0432\u0430\u0435 \u0441\u043b\u043e\u0434\u044b\u0447 \u0430\u0434 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u0445 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u045e \u0456 \u043a\u0430\u0436\u0430: &laquo;\u0414\u0430\u0431\u0440\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0447\u0430\u043c\u0443 \u0437\u043b\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043d\u0435 \u043c\u043e\u0436\u0430\u043c?&raquo;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0401\u045e 2, 10b; 1, 21-22<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430\u0431\u0440\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0447\u0430\u043c\u0443 \u0437\u043b\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043d\u0435 \u043c\u043e\u0436\u0430\u043c? <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u043d \u0434\u0430\u045e, \u0456 \u041f\u0430\u043d \u0437\u0430\u0431\u0440\u0430\u045e. \u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u0456\u043c\u044f \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0430 \u045e\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u0401\u045e, \u0456 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0456\u0447\u043e\u0433\u0430 \u0434\u0440\u044d\u043d\u043d\u0430\u0433\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0434\u0430\u045e, \u0456 \u041f\u0430\u043d \u0437\u0430\u0431\u0440\u0430\u045e. \u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u0456\u043c\u044f \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"83","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0421\u043f\u043e\u0432\u0435\u0434\u0437\u044c&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 10, 1. 1 &ndash; 2. 2; 5. 7: \u0421\u0421L 27, 155. 158)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0422\u044b, \u041f\u0430\u043d\u0435, \u0431\u0430\u0447\u044b\u0448 \u043c\u044f\u043d\u0435 \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u044f \u0451\u0441\u0446\u044c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0437\u043d\u0430\u044e \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u044f\u043a\u0456 \u0432\u0435\u0434\u0430\u0435\u0448 \u043c\u044f\u043d\u0435, \u0441\u043f\u0430\u0437\u043d\u0430\u044e \u0442\u0430\u043a, \u044f\u043a \u0456 \u044f \u0441\u043f\u0430\u0437\u043d\u0430\u043d\u044b (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 13, 12). \u041c\u043e\u0446 \u043c\u0430\u0451\u0439 \u0434\u0443\u0448\u044b, \u0443\u0432\u0430\u0439\u0434\u0437\u0456 \u045e \u044f\u0435 \u0456 \u045e\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u0431\u0435\u0437 \u043f\u043b\u044f\u043c\u044b \u0446\u0456 \u0437\u0430\u0433\u0430\u043d\u044b (\u043f\u0430\u0440. \u042d\u0444 5, 27) \u044f\u043d\u0430 \u0446\u0430\u043b\u043a\u0430\u043c \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0422\u0430\u0431\u0435. \u0421\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0442\u0430\u043a \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u0456 \u0442\u0430\u043c\u0443 \u043a\u0430\u0436\u0443, \u0448\u0442\u043e \u0433\u044d\u0442\u0430\u044f \u043d\u0430\u0434\u0437\u0435\u044f \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u043a\u0430\u043b\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430. \u0406\u043d\u0448\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0430\u043f\u043b\u0430\u043a\u0432\u0430\u044e\u0446\u0446\u0430, \u0447\u044b\u043c \u043c\u0435\u043d\u0448 \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0441\u043b\u0451\u0437\u0430\u045e, \u0456 \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u044e\u0446\u044c, \u0447\u044b\u043c \u043c\u0435\u043d\u0448 \u0456\u0445 \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0435\u043c. &laquo;\u0422\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0433\u043b\u044b\u0431\u043e\u043a\u0443\u044e \u043f\u0440\u0430\u045e\u0434\u0443&raquo; (\u041f\u0441 51 [50], 8), \u0431\u043e &laquo;\u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0443, \u0456\u0434\u0437\u0435 \u0434\u0430 \u0441\u0432\u044f\u0442\u043b\u0430&raquo; (\u042f\u043d 3, 21). \u0422\u0430\u043c\u0443 \u044f \u0436\u0430\u0434\u0430\u044e \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0443\u044e \u0441\u043f\u043e\u0432\u0435\u0434\u0437\u044c \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u044f\u0435 \u045e \u043c\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0435\u0440\u0430\u0434 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u0433\u044d\u0442\u0430\u0439 \u043a\u043d\u0456\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e, \u041f\u0430\u043d\u0435, \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0430\u0434\u0445\u043b\u0430\u043d\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f. \u0406 \u0448\u0442\u043e \u0436 \u044f \u043c\u0430\u0433\u0443 \u0437\u0430\u043a\u0440\u044b\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0432\u044b\u0437\u043d\u0430\u0446\u044c? \u0411\u043e\u043b\u044c\u0448 \u0437\u0430\u043a\u0440\u044b\u045e \u0431\u044b \u0426\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0441\u0430\u0431\u043e\u044e, \u0447\u044b\u043c \u0441\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e. \u0422\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440, \u043a\u0430\u043b\u0456 \u043c\u0430\u0451 \u0434\u044b\u0445\u0430\u043d\u043d\u0435 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u043d\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0443 \u045e \u0441\u0430\u0431\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f, \u0422\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0448\u0441\u044f \u043c\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u043c\u0430\u0456\u043c \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435\u043c, \u043b\u044e\u0431\u043e\u045e\u044e \u0456 \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0435\u043c. \u0421\u0430\u0440\u043e\u043c\u043b\u044e\u0441\u044f \u0441\u044f\u0431\u0435, \u043f\u0430\u043a\u0456\u0434\u0430\u044e \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u0432\u044b\u0431\u0440\u0430\u0446\u044c \u0426\u044f\u0431\u0435, \u0456 \u043d\u0435 \u0445\u0430\u0447\u0443 \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u043d\u0456 \u0441\u0430\u0431\u0435, \u043d\u0456 \u0422\u0430\u0431\u0435, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b, \u041f\u0430\u043d\u0435, \u0431\u0430\u0447\u044b\u0448 \u043c\u044f\u043d\u0435 \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u044f \u0451\u0441\u0446\u044c. \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0440\u0430\u0431\u043b\u044e \u0433\u044d\u0442\u0430\u0435 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435, \u044f \u045e\u0436\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u0440\u0430\u043d\u0435\u0439. \u0412\u044b\u0437\u043d\u0430\u044e \u043d\u0435 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043c \u0434\u0443\u0448\u044b, \u0430\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0434\u0443\u0448\u044b \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043c \u0440\u043e\u0437\u0443\u043c\u0443, \u044f\u043a\u0456 \u0434\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0422\u0432\u0430\u0456\u0445 \u0432\u0443\u0448\u044d\u0439. \u041a\u0430\u043b\u0456 \u044f \u0433\u0440\u044d\u0448\u043d\u044b, \u043c\u0430\u044f \u0441\u043f\u043e\u0432\u0435\u0434\u0437\u044c \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u044f \u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u044e\u0441\u044f \u0441\u0430\u043c\u043e\u043c\u0443 \u0441\u0430\u0431\u0435; \u043a\u0430\u043b\u0456 \u044f \u0434\u043e\u0431\u0440\u044b &ndash; \u0443 \u0430\u0434\u043c\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0441\u0432\u0430\u0456\u0445 \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u045e, &laquo;\u0431\u043e \u0422\u044b, \u041f\u0430\u043d\u0435, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u0448 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430&raquo; (\u041f\u0441 5, 13), \u0430\u043b\u0435 \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0430\u0434\u043e\u0440\u0432\u0430\u0435\u0448 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044e \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430. \u0422\u0430\u043c\u0443 \u043c\u0430\u044f \u0441\u043f\u043e\u0432\u0435\u0434\u0437\u044c \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0446\u0456\u0448\u044b\u043d\u0456 \u0456 \u045e \u0437\u0430\u043a\u043b\u0456\u043a\u0443. \u0411\u043e \u0432\u0443\u0441\u043d\u044b \u043c\u0430\u045e\u0447\u0430\u0446\u044c, \u0430\u043b\u0435 \u043a\u0440\u044b\u0447\u044b\u0446\u044c \u0441\u044d\u0440\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0430\u0441\u0443\u0434\u0436\u0430\u0435\u0448 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435. &laquo;\u0411\u043e \u0445\u0442\u043e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u0432\u0435\u0434\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435, \u0430\u043a\u0440\u0430\u043c\u044f \u0434\u0443\u0445\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u045e \u0456\u043c \u0441\u0430\u043c\u0456\u043c?&raquo; (1 \u041a\u0430\u0440 2, 11). \u0410\u0434\u043d\u0430\u043a \u0451\u0441\u0446\u044c \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043d\u0430\u0432\u0430\u0442 \u044f\u0433\u043e \u0434\u0443\u0445. \u0410 \u0422\u044b, \u041f\u0430\u043d\u0435, \u0432\u0435\u0434\u0430\u0435\u0448 \u0443\u0441\u0451, \u0431\u043e \u0422\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u044f\u0433\u043e. \u0406 \u0445\u043e\u0446\u044c \u044f \u0430\u0434\u0447\u0443\u0432\u0430\u044e \u0430\u0433\u0456\u0434\u0443 \u0434\u0430 \u0441\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0422\u0432\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0456 \u043b\u0456\u0447\u0443 \u0441\u044f\u0431\u0435 \u043f\u044b\u043b\u0430\u043c \u0456 \u043f\u043e\u043f\u0435\u043b\u0430\u043c, \u0430\u0434\u043d\u0430\u043a \u0432\u0435\u0434\u0430\u044e \u043f\u0440\u0430 \u0426\u044f\u0431\u0435 \u0448\u0442\u043e\u0441\u044c\u0446\u0456, \u0447\u0430\u0433\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u044e \u043f\u0440\u0430 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0411\u043e \u0446\u044f\u043f\u0435\u0440 \u043c\u044b \u0431\u0430\u0447\u044b\u043c \u043f\u0440\u0430\u0437 \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0430, \u0446\u044c\u043c\u044f\u043d\u0430&raquo; (1 \u041a\u0430\u0440 13, 12), \u0430 \u043d\u0435 \u0442\u0432\u0430\u0440\u0430\u043c \u0443 \u0442\u0432\u0430\u0440. \u0406 \u0442\u0430\u043c\u0443, \u043f\u0430\u043a\u0443\u043b\u044c \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0443\u044e \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0426\u044f\u0431\u0435, \u044f \u0431\u043b\u0456\u0436\u044d\u0439 \u0434\u0430 \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430, \u0447\u044b\u043c \u0434\u0430 \u0426\u044f\u0431\u0435. \u0410\u0434\u043d\u0430\u043a \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0422\u044b \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b, \u0430 \u044f \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u043f\u0435\u0440\u0430\u0434 \u044f\u043a\u0456\u043c\u0456 \u0441\u043f\u0430\u043a\u0443\u0441\u0430\u043c\u0456 \u0437\u043c\u0430\u0433\u0443 \u0446\u0456 \u043d\u0435 \u0437\u043c\u0430\u0433\u0443 \u045e\u0441\u0442\u0430\u044f\u0446\u044c. \u0422\u0430\u043c\u0443 \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0422\u044b, \u0431\u0443\u0434\u0443\u0447\u044b \u0432\u0435\u0440\u043d\u044b\u043c, \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0448 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u043d\u0430\u0441 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043c\u0430\u0435\u043c \u0441\u0456\u043b\u044b, \u0430\u043b\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0434\u0430\u0441\u0456 \u0456 \u0432\u044b\u0439\u0441\u0446\u0435, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0446\u044c (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 10, 13).<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u0437\u043d\u0430\u044e \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u0435\u0434\u0430\u044e \u043f\u0440\u0430 \u0441\u044f\u0431\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u044e. \u0422\u043e\u0435, \u0448\u0442\u043e \u0432\u0435\u0434\u0430\u044e, \u0432\u0435\u0434\u0430\u044e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0432\u0430\u0439\u043c\u0443 \u0441\u0432\u044f\u0442\u043b\u0443; \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0434\u0430\u0442\u0443\u043b\u044c \u043d\u0435 \u0431\u0443\u0434\u0443 \u0432\u0435\u0434\u0430\u0446\u044c, \u043f\u0430\u043a\u0443\u043b\u044c \u0443 \u0441\u0432\u044f\u0442\u043b\u0435 \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u043c\u043e\u0439 \u0437\u043c\u0440\u043e\u043a \u043d\u0435 \u0441\u0442\u0430\u043d\u0435, \u044f\u043a \u043f\u043e\u045e\u0434\u0437\u0435\u043d\u044c (\u043f\u0430\u0440. \u0406\u0441 58, 10).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 139 (138), 1. 2b. 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d\u0435, \u0422\u044b \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u0456 \u043f\u0430\u0437\u043d\u0430\u045e. <span style=\"color: #ff0000;\">*<\/span> \u0417\u0434\u0430\u043b\u0451\u043a \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0448 \u043c\u0430\u0435 \u0434\u0443\u043c\u043a\u0456. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0443\u0434\u044b \u043f\u0430\u0439\u0434\u0443 \u0430\u0434 \u0414\u0443\u0445\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0456 \u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u043a\u0443\u0434\u044b \u045e\u0446\u044f\u043a\u0443?<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0434\u0430\u043b\u0451\u043a \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0448 \u043c\u0430\u0435 \u0434\u0443\u043c\u043a\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"84","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0421\u043f\u043e\u0432\u0435\u0434\u0437\u044c&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 10, 26. 37 &ndash; 29. 40: \u0421\u0421L 27, 174-176)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0423\u0441\u044f \u043c\u0430\u044f \u043d\u0430\u0434\u0437\u0435\u044f \u043d\u0430 \u0422\u0432\u0430\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435 \u0436 \u0437\u043d\u0430\u0439\u0434\u0443 \u044f \u0426\u044f\u0431\u0435, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c? \u0422\u044b \u043d\u0435 \u0431\u044b\u045e \u0443 \u043c\u0430\u0456\u043c \u0440\u043e\u0437\u0443\u043c\u0435 \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u044f \u043f\u0430\u0437\u043d\u0430\u045e \u0426\u044f\u0431\u0435. \u0414\u0437\u0435 \u0436, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0430-\u043d\u0430\u0434 \u0441\u0430\u0431\u043e\u044e \u045e \u0422\u0430\u0431\u0435 \u044f \u0441\u0443\u0441\u0442\u0440\u044d\u045e \u0426\u044f\u0431\u0435 \u0456 \u043f\u0430\u0437\u043d\u0430\u045e? \u041d\u0435 \u0456\u0434\u0437\u0435 \u0442\u0443\u0442 \u0433\u0430\u0432\u043e\u0440\u043a\u0430 \u043f\u0440\u0430 \u043c\u0435\u0441\u0446\u0430 \u045e \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u044b. \u041c\u044b \u0430\u0434\u0434\u0430\u043b\u044f\u0435\u043c\u0441\u044f \u0430\u0434 \u0426\u044f\u0431\u0435 \u0456 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u043c\u0441\u044f, \u0430\u043b\u0435 \u043d\u0435 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430 \u045e \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u044b. \u0411\u043e \u0422\u044b, \u041f\u0440\u0430\u045e\u0434\u0430, \u043f\u0440\u044b\u043c\u0430\u0435\u0448 \u0443\u0441\u0456\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u043f\u044b\u0442\u0430\u0446\u044c, \u0456 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435\u0448 \u0443\u0441\u0456\u043c, \u0445\u0442\u043e \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043f\u044b\u0442\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430 \u0440\u043e\u0437\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0432\u0430\u0435 \u0430\u0434\u043a\u0430\u0437\u044b \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u044b\u044f, \u0430\u043b\u0435 \u043d\u0435 \u045e\u0441\u0435 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0447\u0443\u044e\u0446\u044c \u0456\u0445. \u0423\u0441\u0435 \u043f\u044b\u0442\u0430\u044e\u0446\u0446\u0430 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0445\u043e\u0447\u0443\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0447\u0443\u044e\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0445\u0430\u0446\u0435\u043b\u0456 \u0431 \u043f\u0430\u0447\u0443\u0446\u044c. \u0422\u0432\u0430\u0456\u043c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0441\u043b\u0443\u0433\u043e\u044e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u043f\u0430\u0447\u0443\u0446\u044c \u0430\u0434 \u0426\u044f\u0431\u0435 \u043d\u0435 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u0430\u043b\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0447\u0443\u045e \u0430\u0434 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u043e\u0437\u043d\u0430 \u044f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0426\u044f\u0431\u0435, \u041f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0434\u0430\u045e\u043d\u044f\u044f \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043d\u043e\u0432\u0430\u044f! \u041f\u043e\u0437\u043d\u0430 \u044f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0426\u044f\u0431\u0435! \u0422\u044b \u0431\u044b\u045e \u0443\u0432\u0430 \u043c\u043d\u0435, \u0430 \u044f \u0431\u044b\u045e \u0437\u0432\u043e\u043d\u043a\u0443 \u0456 \u0437\u0432\u043e\u043d\u043a\u0443 \u0448\u0443\u043a\u0430\u045e \u0426\u044f\u0431\u0435. \u0421\u0430\u043c, \u043f\u043e\u045e\u043d\u044b \u0431\u0440\u044b\u0434\u043e\u0442\u044b, \u044f \u0431\u0435\u0433 \u0437\u0430 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044e, \u044f\u043a\u0443\u044e \u0422\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e. \u0422\u044b \u0431\u044b\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u0430\u043b\u0435 \u044f \u043d\u0435 \u0431\u044b\u045e \u0437 \u0422\u0430\u0431\u043e\u044e. \u0417\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0426\u044f\u0431\u0435 \u045e\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u043c\u044f\u043d\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456, \u044f\u043a\u0456\u044f \u0431 \u0443\u0432\u043e\u0433\u0443\u043b\u0435 \u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0456, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0456 \u045e \u0422\u0430\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u043c\u0430\u044e \u043d\u0435\u043c\u0430\u0442\u0443. \u0417\u0430\u0456\u0441\u043d\u0430\u0432\u0430\u045e, \u0422\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e \u0437\u043d\u0456\u0448\u0447\u044b\u043b\u0430 \u043c\u0430\u044e \u0441\u043b\u0435\u043f\u0430\u0442\u0443. \u0422\u044b \u0440\u0430\u0441\u0441\u0435\u044f\u045e \u043d\u0430\u0432\u043e\u043a\u0430\u043b \u0432\u043e\u0434\u0430\u0440, \u0430 \u044f \u043f\u0430\u0447\u0443\u045e \u0456 \u045e\u0434\u044b\u0445\u0430\u044e \u0426\u044f\u0431\u0435. \u0410\u0434\u043d\u043e\u0439\u0447\u044b \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u045e, \u0430 \u0446\u044f\u043f\u0435\u0440 \u0430\u0434\u0447\u0443\u0432\u0430\u044e \u043d\u0435\u0434\u0430\u0445\u043e\u043f \u0456 \u043f\u0440\u0430\u0433\u043d\u0443; \u0422\u044b \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f, \u0456 \u044f \u043f\u0430\u043b\u0430\u044e \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0435\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u0441\u043f\u0430\u043a\u043e\u044e. \u041a\u0430\u043b\u0456 \u044f \u0446\u0430\u043b\u043a\u0430\u043c \u0437\u043b\u0443\u0447\u0443\u0441\u044f \u0437 \u0422\u0430\u0431\u043e\u044e, \u043d\u0435 \u0431\u0443\u0434\u0443 \u043c\u0435\u0446\u044c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f \u0456 \u0446\u044f\u0436\u0430\u0440\u0443. \u041c\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0442\u0430\u0434\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u0431\u043e \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0422\u0430\u0431\u043e\u044e. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430, \u043a\u0430\u0433\u043e \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435\u0448, \u0442\u0430\u0433\u043e \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0448, \u0430 \u044f \u0441\u0430\u043c \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0441\u044f \u0446\u044f\u0436\u0430\u0440\u0430\u043c, \u0431\u043e \u044f\u0448\u0447\u044d \u043d\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0422\u0430\u0431\u043e\u044e. \u0417\u043c\u0430\u0433\u0430\u044e\u0446\u0446\u0430 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u043d\u0430\u0434 \u044f\u043a\u043e\u0439 \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u043b\u0430\u043a\u0430\u0446\u044c, \u0441\u0430 \u0441\u043c\u0443\u0442\u043a\u0430\u043c, \u044f\u043a\u043e\u043c\u0443 \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430, \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0456 \u0436 \u044f \u0431\u0435\u0434\u043d\u044b! \u041f\u0430\u043d\u0435, \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e! \u041d\u0430\u0432\u0430\u0442 \u043c\u043e\u0439 \u043d\u044f\u0433\u043e\u0434\u043d\u044b \u0441\u043c\u0443\u0442\u0430\u043a \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0441\u0430 \u0448\u043b\u044f\u0445\u0435\u0442\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0456 \u044f \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0437 \u0456\u0445 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430. \u0410\u0445, \u041f\u0430\u043d\u0435, \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e! \u042f \u043d\u0435 \u0445\u0430\u0432\u0430\u044e \u0441\u0432\u0430\u0456\u0445 \u0440\u0430\u043d\u0430\u045e: \u0422\u044b &ndash; \u041b\u0435\u043a\u0430\u0440, \u044f &ndash; \u0445\u0432\u043e\u0440\u044b; \u0422\u044b &ndash; \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b, \u0430 \u045e\u0432\u0430 \u043c\u043d\u0435 \u045e\u0441\u0451 \u043a\u043b\u0456\u0447\u0430 \u0430\u0431 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0425\u0456\u0431\u0430 \u0436\u044b\u0446\u0446\u0451 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043d\u0435 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f?&raquo; (\u0401\u045e 7, 1). \u0425\u0442\u043e \u0436 \u0431\u0443\u0434\u0437\u0435 \u0436\u0430\u0434\u0430\u0446\u044c \u0441\u0430\u0431\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u0456 \u043d\u0435\u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044f\u045e. \u0422\u044b \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435\u0448 \u043d\u0430\u043c \u0456\u0445 \u0437\u043d\u043e\u0441\u0456\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c. \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437\u043d\u043e\u0441\u0456\u0446\u044c, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0431 \u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430 \u0437 \u0430\u0445\u0432\u043e\u0442\u0430\u0439. \u0425\u043e\u0446\u044c \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0437 \u0430\u0445\u0432\u043e\u0442\u0430\u0439, \u0430\u0434\u043d\u0430\u043a, \u043d\u0430\u043f\u044d\u045e\u043d\u0430, \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u0456\u0445 \u043d\u0435 \u043c\u0435\u0446\u044c. \u0422\u0430\u043a \u0441\u044f\u0440\u043e\u0434 \u043d\u044f\u045e\u0434\u0430\u0447 \u0441\u0443\u043c\u0443\u044e \u043f\u0430 \u043f\u043e\u0441\u043f\u0435\u0445\u0430\u0445, \u0430 \u0441\u044f\u0440\u043e\u0434 \u043f\u043e\u0441\u043f\u0435\u0445\u0443 \u0431\u0430\u044e\u0441\u044f \u043d\u044f\u045e\u0434\u0430\u0447. \u0414\u0437\u0435 \u0436 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0430, \u0434\u0437\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u0431 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f? \u0413\u043e\u0440\u0430 \u043f\u043e\u0441\u043f\u0435\u0445\u0443 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u0434\u0432\u043e\u0439\u0447\u044b \u0433\u043e\u0440\u0430: \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u043c\u0456 \u0456 \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e. \u0413\u043e\u0440\u0430 \u0437\u044f\u043c\u043d\u044b\u043c \u043d\u044f\u045e\u0434\u0430\u0447\u0430\u043c, \u0442\u0440\u043e\u0439\u0447\u044b \u0433\u043e\u0440\u0430, \u0431\u043e \u045e\u0437\u043c\u0430\u0446\u043d\u044f\u044e\u0446\u044c \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u043f\u043e\u0441\u043f\u0435\u0445\u0443, \u043d\u044f\u0441\u0443\u0446\u044c \u043d\u0435\u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456 \u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u044e\u0446\u044c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c. &laquo;\u0425\u0456\u0431\u0430 \u0436\u044b\u0446\u0446\u0451 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043d\u0435 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f?&raquo; (\u0401\u045e 7, 1).<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u044f \u043c\u0430\u044f \u043d\u0430\u0434\u0437\u0435\u044f \u043d\u0430 \u0422\u0432\u0430\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 19, 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u043e\u0437\u043d\u0430 \u044f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0426\u044f\u0431\u0435, \u041f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0434\u0430\u045e\u043d\u044f\u044f \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043d\u043e\u0432\u0430\u044f! \u041f\u043e\u0437\u043d\u0430 \u044f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0426\u044f\u0431\u0435!<span style=\"color: #ff0000;\"> *<\/span> \u0422\u044b \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u043c\u0430\u044e \u043d\u0435\u043c\u0430\u0442\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0456 \u0432\u044b\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u043c\u0430\u044e \u043d\u0435\u043c\u0430\u0442\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"85","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0401\u0432\u0430&raquo; \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 10, 7-8. 10: PL 75, 922. 925-926)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0428\u043c\u0430\u0442\u0433\u0440\u0430\u043d\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0430\u0433\u0430 \u0417\u0430\u043a\u043e\u043d\u0443 <\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0436 \u0456\u043d\u0448\u0430\u0435 \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0437\u0430\u043c\u0435\u0441\u0442 \u0411\u043e\u0436\u0430\u0433\u0430 \u0417\u0430\u043a\u043e\u043d\u0443, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0430\u044f \u0432\u0443\u0447\u044b\u0446\u044c, \u044f\u043a \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0443 \u0441\u0432\u0430\u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0436\u044b\u0446\u0446\u044f? \u041f\u0440\u0430 \u0433\u044d\u0442\u044b \u0417\u0430\u043a\u043e\u043d \u043a\u0430\u0436\u0430 \u043d\u0430\u043c \u041f\u0440\u0430\u045e\u0434\u0430: &laquo;\u0412\u043e\u0441\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u041c\u0430\u044f, \u043a\u0430\u0431 \u0432\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441&raquo; (\u042f\u043d 15, 12). \u0410 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430: &laquo;\u041b\u044e\u0431\u043e\u045e \u043d\u0435 \u0447\u044b\u043d\u0456\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u043c\u0443 \u0437\u043b\u0430; \u043b\u044e\u0431\u043e\u045e \u0451\u0441\u0446\u044c \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c \u0417\u0430\u043a\u043e\u043d\u0443&raquo; (\u0420\u044b\u043c 13, 10). \u0406 \u0437\u043d\u043e\u045e \u043a\u0430\u0436\u0430: &laquo;\u041d\u0430\u0441\u0456\u0446\u0435 \u0446\u044f\u0436\u0430\u0440\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0456 \u0442\u0430\u043a \u0432\u044b\u043a\u0430\u043d\u0430\u0435\u0446\u0435 \u0437\u0430\u043a\u043e\u043d \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b&raquo; (\u0413\u0430\u043b 6, 2).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u0433\u044d\u0442\u044b \u0417\u0430\u043a\u043e\u043d, &ndash; \u043c\u044b \u043a\u0430\u0436\u0430\u043c, &ndash; \u0448\u043c\u0430\u0442\u0433\u0440\u0430\u043d\u043d\u044b, \u0431\u043e \u043b\u044e\u0431\u043e\u045e \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u0441\u0432\u0430\u0451\u0439 \u0448\u0447\u044b\u0440\u0430\u0439 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u045e\u0441\u0435 \u0434\u0437\u0435\u044f\u043d\u043d\u0456, \u0445\u0430\u0440\u0430\u043a\u0442\u044d\u0440\u043d\u044b\u044f \u043f\u0430\u0430\u0441\u043e\u0431\u043d\u044b\u043c \u0446\u043d\u043e\u0442\u0430\u043c. \u0420\u0430\u0441\u043f\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u0434\u0437\u0432\u044e\u043c\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u043c\u0456, \u0430\u043b\u0435 \u043f\u0430\u0448\u044b\u0440\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u043c\u043d\u043e\u0433\u0456\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456. \u0428\u043c\u0430\u0442\u0433\u0440\u0430\u043d\u043d\u0430\u0441\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0417\u0430\u043a\u043e\u043d\u0443 \u0442\u0440\u0430\u043f\u043d\u0430 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0443 \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u041b\u044e\u0431\u043e\u045e \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u044f, \u043b\u044e\u0431\u043e\u045e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u044f, \u043d\u0435 \u0437\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u0446\u0456\u0446\u044c, \u043b\u044e\u0431\u043e\u045e \u043d\u0435 \u043f\u044b\u0445\u043b\u0456\u0432\u0430\u044f, \u043d\u0435 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430, \u043d\u0435 \u0431\u0435\u0441\u0441\u0430\u0440\u043e\u043c\u043d\u0430\u044f, \u043d\u0435 \u0448\u0443\u043a\u0430\u0435 \u0441\u0432\u0430\u0439\u0433\u043e, \u043d\u0435 \u0433\u043d\u0435\u0432\u0430\u0435\u0446\u0446\u0430, \u043d\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u0435 \u0437\u043b\u0430, \u043d\u0435 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u043f\u0440\u0430\u045e\u0434\u0430\u0439&raquo; (1 \u041a\u0430\u0440 13, 4-6).<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0431\u043e\u045e \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u044f, \u0431\u043e \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430 \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u043a\u0440\u044b\u045e\u0434\u044b. \u041b\u0430\u0441\u043a\u0430\u0432\u0430\u044f, \u0431\u043e \u0448\u0447\u043e\u0434\u0440\u0430 \u0430\u0434\u043f\u043b\u043e\u0447\u0432\u0430\u0435 \u0434\u0430\u0431\u0440\u043e\u043c \u0437\u0430\u043c\u0435\u0441\u0442 \u0437\u043b\u0430. \u041d\u0435 \u0437\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u0446\u0456\u0446\u044c, \u0431\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0435 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u043d\u0435 \u045e\u043c\u0435\u0435 \u0437\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u0446\u0456\u0446\u044c \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0439 \u0437\u044f\u043c\u043d\u043e\u0439 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456. \u041d\u0435 \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u0430\u044f, \u0431\u043e \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u043f\u0440\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b, \u043d\u0435 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0437\u043d\u0435\u0448\u043d\u0456\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u0430\u0435. \u041d\u0435 \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0430\u044f, \u0431\u043e \u043a\u043b\u0430\u043f\u043e\u0446\u044f\u0447\u044b\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0433\u0430 \u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u043d\u0435 \u0440\u043e\u0431\u0456\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430, \u0448\u0442\u043e \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c \u0434\u043e\u0431\u0440\u0430\u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043f\u0440\u0430\u0433\u043d\u0435 \u043f\u0430\u0445\u0432\u0430\u043b\u044b, \u0431\u043e \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0434\u0430\u0431\u0440\u043e, \u0442\u044b\u043c \u043c\u0435\u043d\u0448 \u043f\u0440\u0430\u0433\u043d\u0435 \u0437\u043d\u0435\u0448\u043d\u044f\u0433\u0430 \u0431\u0430\u0433\u0430\u0446\u0446\u044f. \u041d\u0435 \u0448\u0443\u043a\u0430\u0435 \u0441\u0432\u0430\u0439\u0433\u043e, \u0431\u043e \u043d\u0435 \u043b\u0456\u0447\u044b\u0446\u044c \u0441\u0432\u0430\u0456\u043c \u043d\u0456\u0447\u043e\u0433\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u043e\u0436\u0430 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0437 \u0451\u0439 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b. \u041d\u0435 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0447\u0430\u0441\u043e\u0432\u0430 \u043c\u0430\u0435 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435. \u041d\u0435 \u0433\u043d\u0435\u0432\u0430\u0435\u0446\u0446\u0430, \u0456 \u043d\u0430\u0432\u0430\u0442 \u0437\u0440\u0430\u043d\u0435\u043d\u0430\u044f \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u043d\u0435 \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u044f \u043f\u043e\u043c\u0441\u0442\u044b, \u0431\u043e \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0437\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443. \u041d\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u0435 \u0437\u043b\u0430, \u0431\u043e \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0434\u0443\u0448\u0443 \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u0432\u044b\u043a\u0430\u0440\u0430\u043d\u044f\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c, \u0442\u0430\u043c\u0443 \u043d\u0435 \u0434\u0430\u043f\u0443\u0441\u043a\u0430\u0435 \u045e \u0434\u0443\u0448\u0443 \u043d\u0456\u0447\u043e\u0433\u0430, \u0448\u0442\u043e \u0431 \u043c\u0430\u0433\u043b\u043e \u044f\u0435 \u0437\u0430\u043f\u043b\u044f\u043c\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0431\u043e \u045e \u0441\u0432\u0430\u0456\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u043b\u044e\u0431\u0456\u0446\u044c \u0443\u0441\u0456\u0445 \u043d\u0430\u0432\u0430\u0442 \u0443 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0456\u0445 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u045e \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u0439 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456. \u0420\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0431\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0456\u043d\u0448\u044b\u0445 \u044f\u043a \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u0443 \u0456 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0434\u0430\u0431\u0440\u0443, \u044f\u043a\u043e\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u0443 \u0456\u0445, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u043f\u0430\u043c\u043d\u0430\u0436\u044d\u043d\u043d\u0435 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u0448\u043c\u0430\u0442\u0433\u0440\u0430\u043d\u043d\u044b\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u0430\u043a\u043e\u043d \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 13, 8. 10b; \u0413\u0430\u043b 5, 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0456\u043a\u043e\u043c\u0443 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b\u044f, \u0430\u043f\u0440\u043e\u0447 \u0443\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0431\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0432\u044b\u043a\u0430\u043d\u0430\u045e \u0417\u0430\u043a\u043e\u043d. <span style=\"color: #ff0000;\">*<\/span> \u041b\u044e\u0431\u043e\u045e \u0451\u0441\u0446\u044c \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c \u0417\u0430\u043a\u043e\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0432\u0435\u0441\u044c \u0417\u0430\u043a\u043e\u043d \u0441\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u045e \u0430\u0434\u043d\u044b\u043c: \u043b\u044e\u0431\u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041b\u044e\u0431\u043e\u045e \u0451\u0441\u0446\u044c \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c \u0417\u0430\u043a\u043e\u043d\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"86","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0401\u0432\u0430&raquo; \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 10, 47-48: PL 75, 946-947)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0422\u043e\u0439, \u0445\u0442\u043e \u045e\u0441\u0451 \u0432\u0435\u0434\u0430\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0431\u044b\u045e \u0432\u044b\u0441\u043c\u0435\u044f\u043d\u044b \u0441\u0432\u0430\u0456\u043c \u0441\u044f\u0431\u0440\u0430\u043c, \u044f\u043a \u044f, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0411\u043e\u0433\u0430, \u0401\u043d \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0435 \u044f\u0433\u043e&raquo; (\u0401\u045e 12, 4 Vlg).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u043b\u0430\u0431\u0430\u044f \u0434\u0443\u0448\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u045e \u043b\u044e\u0434\u0437\u0435\u0439 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430\u043c\u0443 \u0434\u0430\u0431\u0440\u0443, \u043d\u044f\u0440\u044d\u0434\u043a\u0430 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0441\u0430\u0431\u0435 \u0437\u043d\u0435\u0448\u043d\u0456\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u0456. \u0422\u0430\u0434\u044b \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u0435 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u045e \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0441\u044d\u0440\u0446\u0430 \u0436\u0430\u0434\u0430\u0435. \u0422\u0430\u043c\u0443, \u0448\u0442\u043e \u0447\u0443\u0435 \u0432\u043e\u043d\u043a\u0456, \u043f\u0430\u0434\u0434\u0430\u0435\u0446\u0446\u0430 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0456 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u0448\u0442\u043e \u043c\u0435\u043d\u0448 \u0437\u0432\u044f\u0440\u0442\u0430\u0435 \u045e\u0432\u0430\u0433\u0456 \u043d\u0430 \u0441\u0432\u0430\u044e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c, \u0447\u044b\u043c \u043d\u0430 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u0443\u044e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c. \u041f\u0440\u044b\u043c\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u043f\u0430\u0445\u0432\u0430\u043b\u044b \u0456 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0442\u0430\u0433\u043e, \u0447\u044b\u043c \u043f\u0430\u0447\u0430\u043b\u0430 \u0431\u044b\u0446\u044c. \u0410\u0434\u0434\u0430\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0442\u0430\u0433\u043e, \u0448\u0442\u043e, \u044f\u043a \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0451\u0439, \u043c\u0430\u0433\u043b\u043e \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u044f\u0435 \u0433\u043e\u0434\u043d\u0430\u0439 \u042f\u0433\u043e \u043f\u0430\u0445\u0432\u0430\u043b\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0434\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0442\u0430\u043a, \u0448\u0442\u043e \u0434\u0443\u0448\u0430 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430 \u0447\u044b\u043d\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0430\u0434\u043d\u0430\u043a \u0437 \u044f\u0435 \u043d\u0430\u0441\u043c\u0456\u0445\u0430\u044e\u0446\u0446\u0430 \u043b\u044e\u0434\u0437\u0456. \u0417\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0440\u044d\u0447\u044b, \u0430 \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u0435\u0446\u0446\u0430 \u0441\u0430 \u0437\u043d\u044f\u0432\u0430\u0433\u0430\u0439. \u0406 \u0445\u043e\u0446\u044c \u0443 \u0432\u044b\u043d\u0456\u043a\u0443 \u043f\u0430\u0445\u0432\u0430\u043b \u044f\u043d\u0430 \u043c\u0430\u0433\u043b\u0430 \u0431 \u0437\u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437\u043d\u0435\u0448\u043d\u044f\u0435, \u044f\u043d\u0430, \u0441\u043f\u0430\u0437\u043d\u0430\u045e\u0448\u044b \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0443\u0442\u0440\u0430 \u0456 \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0411\u043e\u0433\u0443, \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0437\u0432\u043e\u043d\u043a\u0443 \u043d\u0435 \u043c\u0430\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456. \u0426\u0430\u043b\u043a\u0430\u043c \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u0456 \u0441\u044f\u0440\u043e\u0434 \u043a\u043f\u0456\u043d\u0430\u045e \u0456 \u0437\u043d\u044f\u0432\u0430\u0433 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u045e\u0441\u0451 \u0432\u0435\u0434\u0430\u0435. \u0422\u0430\u043a \u0434\u0443\u0448\u0430 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0442\u044b\u043c \u0431\u043b\u0456\u0436\u044d\u0439 \u0434\u0430 \u0411\u043e\u0433\u0430, \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u0434\u0430\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434 \u043b\u044e\u0434\u0441\u043a\u0456\u0445 \u043f\u0430\u0445\u0432\u0430\u043b. \u0410\u0445\u0432\u043e\u0442\u043d\u0430 \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0456 \u043f\u0440\u0430\u0437 \u0437\u043d\u0435\u0448\u043d\u044f\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0439 \u0443 \u0441\u043f\u0430\u0441\u0446\u0456\u0436\u044d\u043d\u043d\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u043b\u0443\u0448\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0431\u044b\u045e \u0432\u044b\u0441\u043c\u0435\u044f\u043d\u044b \u0441\u0432\u0430\u0456\u043c \u0441\u044f\u0431\u0440\u0430\u043c, \u044f\u043a \u044f, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0411\u043e\u0433\u0430, \u0401\u043d \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0435 \u044f\u0433\u043e&raquo; (\u0401\u045e 12, 4 Vlg). \u041a\u0430\u043b\u0456 \u043a\u0435\u043f\u0441\u043a\u0456\u044f \u043b\u044e\u0434\u0437\u0456 \u0440\u043e\u0431\u044f\u0446\u044c \u043f\u0440\u044b\u043a\u0440\u0430\u0441\u0446\u044c \u0434\u043e\u0431\u0440\u044b\u043c, \u0442\u043e \u0433\u044d\u0442\u044b\u043c \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c, \u044f\u043a\u043e\u0433\u0430 \u0441\u0432\u0435\u0434\u043a\u0443 \u0441\u0432\u0430\u0456\u0445 \u0447\u044b\u043d\u0430\u045e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0448\u0443\u043a\u0430\u0446\u044c. \u0427\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u043f\u0440\u044b\u043a\u0440\u0430\u0441\u0446\u044c, \u0430\u043b\u0435 \u0430\u0434\u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u0443 \u0434\u0443\u0448\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0434\u0430\u0431\u0440\u044b\u043d\u044e \u0411\u043e\u0433\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0437\u043d\u0435\u0448\u043d\u0435 \u0451\u043d \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043b\u044e\u0434\u0441\u043a\u0456\u0445 \u043f\u0430\u0445\u0432\u0430\u043b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0440\u044d\u0431\u0430 \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0446\u044c \u0441\u043b\u0443\u0448\u043d\u0430\u0441\u0446\u044c \u0434\u0430\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u044f: &laquo;&hellip;\u044f\u043a \u044f&raquo;. \u0401\u0441\u0446\u044c \u043b\u044e\u0434\u0437\u0456, \u044f\u043a\u0456\u043c\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u044e\u0446\u044c \u0456\u043d\u0448\u044b\u044f \u0456 \u044f\u043a\u0456\u044f \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0456 \u045e \u0411\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435\u043c \u0437\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u0443\u044e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0442\u043e \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0448\u0442\u043e \u0437 \u0442\u0430\u043a\u043e\u0439 \u043f\u0430\u0433\u0430\u0440\u0434\u044b \u043d\u0435 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u043d\u0456\u044f\u043a\u0430\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0412\u044b\u0441\u043c\u0435\u044f\u043d\u0430\u0439 \u0431\u044b\u0432\u0430\u0435 \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430&raquo; (\u0401\u045e 12, 4 Vlg). \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u044b\u043c \u0445\u0430\u0432\u0430\u043d\u043d\u0456 \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u045e, \u0443 \u043f\u0435\u0440\u0430\u0456\u043d\u0430\u0447\u0432\u0430\u043d\u043d\u0456 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u044f \u0441\u043b\u043e\u0432\u0430\u045e, \u0443 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0456 \u0444\u0430\u043b\u044c\u0448\u0443 \u044f\u043a \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u043f\u0440\u0430\u045e\u0434\u044b \u044f\u043a \u0444\u0430\u043b\u044c\u0448\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0436\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u0432\u0430 \u045e\u043d\u0456\u043a\u0430\u043d\u043d\u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u0456, \u0443 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0456 \u0434\u0443\u043c\u0430\u043a \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0432\u0430 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u043d\u0456 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435, \u0443 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u043d\u043d\u0456 \u0444\u0430\u043b\u044c\u0448\u0443, \u0443 \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043b\u0456\u0432\u044b\u043c \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u0456 \u0434\u0430\u0431\u0440\u0430, \u0443 \u0431\u043e\u043b\u044c\u0448 \u0430\u0445\u0432\u043e\u0442\u043d\u044b\u043c \u0437\u043d\u044f\u0441\u0435\u043d\u043d\u0456 \u0437\u043b\u0430, \u0430 \u043d\u0435 \u045e \u044f\u0433\u043e \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u0456, \u0443 \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u043d\u043d\u0456 \u0430\u0434\u043f\u043b\u0430\u0442\u044b \u0437\u0430 \u0437\u043d\u044f\u0432\u0430\u0433\u0443, \u0443 \u043f\u0440\u044b\u0437\u043d\u0430\u043d\u043d\u0456 \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c \u0437\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u043a\u0440\u044b\u045e\u0434\u044b \u0437\u0430 \u043f\u0440\u0430\u045e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u044f \u043f\u0440\u0430\u043c\u0430\u043b\u0456\u043d\u0435\u0439\u043d\u0430\u0441\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0432\u044b\u0441\u043c\u0435\u0439\u0432\u0430\u0435\u0446\u0446\u0430. \u0411\u043e \u043c\u0443\u0434\u0440\u044b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u043b\u0456\u0447\u0430\u0446\u044c \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0430\u043c\u0435\u0440\u0430\u045e \u0431\u0435\u0437\u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u044e. \u0423\u0441\u0451, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u0430\u0435 \u045e \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0441\u0446\u0456, \u043b\u0456\u0447\u044b\u0446\u0446\u0430 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c, \u0456 \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430\u043c \u0434\u043b\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0441\u0432\u0435\u0442\u0443 \u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u0442\u043e\u0435, \u0434\u0430 \u0447\u0430\u0433\u043e \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u041f\u0440\u0430\u045e\u0434\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 119 (118), 104b. 105; \u042f\u043d 6, 68 b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0436\u0443 \u045e\u0441\u044f\u043a\u0456 \u0448\u043b\u044f\u0445 \u0456\u043b\u0436\u044b\u0432\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0421\u043b\u043e\u0432\u0430 \u0422\u0432\u0430\u0451 &ndash; \u0441\u0432\u0435\u0442\u0430\u0447 \u0434\u043b\u044f \u043c\u0430\u0451\u0439 \u043d\u0430\u0433\u0456 \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u043b\u044f \u043c\u0430\u0451\u0439 \u0441\u0446\u0435\u0436\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d\u0435, \u0434\u0430 \u043a\u0430\u0433\u043e \u043c\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u043c? \u0422\u044b \u043c\u0430\u0435\u0448 \u0441\u043b\u043e\u0432\u044b \u0436\u044b\u0446\u0446\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043b\u043e\u0432\u0430 \u0422\u0432\u0430\u0451 &ndash; \u0441\u0432\u0435\u0442\u0430\u0447 \u0434\u043b\u044f \u043c\u0430\u0451\u0439 \u043d\u0430\u0433\u0456 \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u043b\u044f \u043c\u0430\u0451\u0439 \u0441\u0446\u0435\u0436\u043a\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"87","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0422\u0440\u0430\u043a\u0442\u0430\u0442&raquo; \u0441\u0432. \u0417\u044f\u043d\u043e\u043d\u0430 \u0437 \u0412\u0435\u0440\u043e\u043d\u044b, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 15, 2: PL 11, 441-443)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0401\u045e &ndash; \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b! \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u043c, \u0401\u045e \u0431\u044b\u045e \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430. \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0435 \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u0446\u044c \u0433\u044d\u0442\u0430. \u0411\u043e\u0433 \u043d\u0430\u0437\u0432\u0430\u045e \u0401\u0432\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c. \u0410 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0441\u0430\u043c\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0423 \u042f\u0433\u043e \u043d\u0456\u0431\u044b \u043a\u0430\u043b\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u045e\u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0430\u0436\u044b\u045e\u043b\u044f\u044e\u0446\u0446\u0430. \u041f\u0440\u0430 \u042f\u0433\u043e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0414\u043b\u044f \u0432\u0430\u0441 \u0443\u0437\u044b\u0434\u0437\u0435 \u0421\u043e\u043d\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456&raquo; (\u043f\u0430\u0440. \u041c\u0430\u043b 3, 20). \u0401\u045e \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c. \u0410 \u041f\u0430\u043d &ndash; \u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u045e\u0434\u0430, \u044f\u043a \u043a\u0430\u0436\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435: &laquo;\u042f &ndash; \u0434\u0430\u0440\u043e\u0433\u0430, \u0456 \u043f\u0440\u0430\u045e\u0434\u0430, \u0456 \u0436\u044b\u0446\u0446\u0451&raquo; (\u042f\u043d 14, 6).<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u045e \u0431\u044b\u045e \u0431\u0430\u0433\u0430\u0442\u044b\u043c. \u0410\u043b\u0435 \u0445\u0442\u043e \u0431\u0430\u0433\u0430\u0446\u0435\u0439\u0448\u044b \u0437\u0430 \u041f\u0430\u043d\u0430? \u0423\u0441\u0435 \u0431\u0430\u0433\u0430\u0446\u0435\u0456 &ndash; \u042f\u0433\u043e\u043d\u044b\u044f \u0441\u043b\u0443\u0433\u0456. \u042f\u043c\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0443\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0456 \u043a\u043e\u0436\u043d\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0414\u0430\u0432\u0456\u0434\u0430: &laquo;\u041f\u0430\u043d\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0437\u044f\u043c\u043b\u044f \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0430 \u0451\u0439, \u0441\u0443\u0441\u0432\u0435\u0442 \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0456\u043c&raquo; (\u041f\u0441 24 [23], 1). \u0421\u0430\u0442\u0430\u043d\u0430 \u0442\u0440\u043e\u0439\u0447\u044b \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u0435 \u0401\u0432\u0430. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u041f\u0430\u043d\u0430, \u044f\u043a \u043a\u0430\u0436\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0441\u0430\u0442\u0430\u043d\u0430 \u0442\u0440\u043e\u0439\u0447\u044b \u0430\u0441\u043c\u0435\u043b\u0456\u045e\u0441\u044f \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u0446\u044c. \u0401\u045e \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u0443\u0432\u0435\u0441\u044c \u0441\u0432\u043e\u0439 \u043c\u0430\u0451\u043d\u0442\u0430\u043a. \u0410 \u041f\u0430\u043d \u0434\u0437\u0435\u043b\u044f \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u043d\u0430\u0441 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0441\u0432\u0430\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b, \u0441\u0442\u0430\u045e\u0441\u044f \u045e\u0431\u043e\u0433\u0456\u043c, \u043a\u0430\u0431 \u043d\u0430\u0441 \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0431\u0430\u0433\u0430\u0442\u044b\u043c\u0456. \u0421\u0430\u0442\u0430\u043d\u0430 \u045e \u0441\u0432\u0430\u0451\u0439 \u0437\u043b\u043e\u0441\u0446\u0456 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u045e \u0443\u0441\u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439 \u0401\u0432\u0430. \u0410 \u0444\u0430\u0440\u044b\u0441\u0435\u0456 \u045e \u0441\u0432\u0430\u0456\u043c \u0448\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0435 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0434\u0437\u044f\u0446\u0435\u0439 \u041f\u0430\u043d\u0430. \u0401\u045e \u0431\u044b\u045e \u043f\u0430\u043a\u0440\u044b\u0442\u044b \u043f\u0440\u0430\u043a\u0430\u0437\u0430\u0439. \u0410 \u041f\u0430\u043d, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0446\u0435\u043b\u0430, \u043f\u0440\u044b\u043d\u044f\u045e \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u044b\u044f \u044f\u0437\u0432\u044b \u045e\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0440\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0416\u043e\u043d\u043a\u0430 \u0401\u0432\u0430 \u043d\u0430\u043c\u0430\u045e\u043b\u044f\u043b\u0430 \u044f\u0433\u043e \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u0446\u044c \u0411\u043e\u0433\u0443. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u041f\u0430\u043d\u0430 \u043d\u0430\u043c\u0430\u0433\u0430\u043b\u0456\u0441\u044f \u0441\u0445\u0456\u043b\u0456\u0446\u044c \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430, \u043a\u0430\u0431 \u0401\u043d \u043f\u0430\u0434\u0437\u044f\u043b\u044f\u045e \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u0445. \u0427\u044b\u0442\u0430\u0435\u043c, \u0448\u0442\u043e \u0401\u0432\u0430 \u0430\u0431\u0440\u0430\u0436\u0430\u043b\u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0441\u044f\u0431\u0440\u044b. \u0410 \u041f\u0430\u043d\u0430 \u0430\u0431\u0440\u0430\u0436\u0430\u043b\u0456 \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u0430\u0440\u044b, \u044f\u043a\u0456\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u043b\u0456 \u0441\u043b\u0430\u0432\u0456\u0446\u044c \u042f\u0433\u043e. \u0401\u045e \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0441\u043c\u0435\u0446\u0446\u0456, \u043f\u043e\u045e\u043d\u044b\u043c \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u0447\u0430\u0440\u0432\u044f\u043a\u043e\u045e. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u041f\u0430\u043d \u0430\u043f\u044b\u043d\u0443\u045e\u0441\u044f \u043d\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0441\u043c\u0435\u0442\u043d\u0456\u043a\u0443, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0441\u044f\u0440\u043e\u0434 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u0445 \u0447\u0430\u0440\u0432\u044f\u043a\u043e\u045e &ndash; \u043b\u044e\u0434\u0437\u0435\u0439, \u043f\u043e\u045e\u043d\u044b\u0445 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430\u045e \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u045e \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0437\u0434\u0430\u0440\u043e\u045e\u044f \u0456 \u0437\u043d\u043e\u045e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043c\u0430\u0451\u043d\u0442\u0430\u043a. \u0410 \u041f\u0430\u043d \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0430\u0434\u0430\u0440\u044b\u045e \u0441\u0432\u0430\u0456\u0445 \u0432\u0435\u0440\u043d\u044b\u0445 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0434\u0430\u0440\u043e\u045e\u0435\u043c, \u0430\u043b\u0435 \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0443\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c, \u043f\u0440\u0430 \u0448\u0442\u043e, \u0434\u0430\u0440\u044d\u0447\u044b, \u0441\u0430\u043c \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u0443 \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u0423\u0441\u0451 \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u041c\u043d\u0435 \u0410\u0439\u0446\u043e\u043c&raquo; (\u041c\u0446 11, 27). \u0401\u045e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043d\u043e\u0432\u044b\u0445 \u0441\u044b\u043d\u043e\u045e \u0437\u0430\u043c\u0435\u0441\u0442 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u041f\u0430\u043d \u0437\u0430\u043c\u0435\u0441\u0442 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0441\u0432\u044f\u0442\u044b\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u044f\u043a \u0441\u044b\u043d\u043e\u045e. \u0401\u045e, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0448\u0447\u0430\u0441\u0446\u0435, \u0441\u043f\u0430\u0447\u044b\u045e \u0443 \u0441\u043f\u0430\u043a\u043e\u0456. \u0410 \u041f\u0430\u043d \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043d\u0430\u0432\u0435\u043a\u0456, \u043f\u0435\u0440\u0430\u0434 \u0432\u044f\u043a\u0430\u043c\u0456 \u0456 \u0432\u0430 \u045e\u0441\u0435 \u0432\u044f\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0431\u0440 12, 1\u0441-2\u0430; \u043f\u0430\u0440. 2 \u041a\u0430\u0440 6, 4-5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0437\u0435\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0431\u0435\u0433\u0447\u044b \u045e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u043c \u0434\u043b\u044f \u043d\u0430\u0441 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u043f\u0430\u0447\u044b\u043d\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0456 \u0437\u0430\u0432\u044f\u0440\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0432\u0435\u0440\u044b. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0430 \u045e\u0441\u0456\u043c \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u043c \u0441\u044f\u0431\u0435 \u044f\u043a \u0441\u043b\u0443\u0433\u0430\u045e \u0411\u043e\u0436\u044b\u0445: \u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0443 \u0442\u0443\u0440\u0431\u043e\u0442\u0430\u0445, \u0443 \u043f\u0430\u0442\u0440\u044d\u0431\u0435, \u0432\u0430 \u045e\u0446\u0456\u0441\u043a\u0443, \u043f\u0430\u0434 \u0443\u0434\u0430\u0440\u0430\u043c\u0456, \u0443 \u0432\u044f\u0437\u043d\u0456\u0446\u0430\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u043f\u0430\u0447\u044b\u043d\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0456 \u0437\u0430\u0432\u044f\u0440\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0432\u0435\u0440\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"91","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0421\u043f\u043e\u0432\u0435\u0434\u0437\u044c&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 1, 1. 1 &minus; 2. 2; 5. 5; CCL 27, 1-3)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u0435\u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430\u0435 \u043d\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0430\u0434\u043f\u0430\u0447\u043d\u0435 \u045e \u0422\u0430\u0431\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0412\u044f\u043b\u0456\u043a\u0456 \u041f\u0430\u043d \u0456 \u0433\u043e\u0434\u043d\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0445\u0432\u0430\u043b\u044b; \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043c\u043e\u0446 \u042f\u0433\u043e\u043d\u0430\u044f \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u042f\u0433\u043e\u043d\u0430\u044f \u043d\u0435\u0432\u044b\u043c\u0435\u0440\u043d\u0430\u044f&raquo; (\u041f\u0441 48 [47], 1; 96 [95], 4; 145 [144], 3; 147 [146], 5). \u0426\u044f\u0431\u0435 \u0445\u043e\u0447\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0447\u0430\u0441\u0442\u043a\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u044f\u043a\u0456 \u043d\u044f\u0441\u0435 \u045e\u0441\u044e\u0434\u044b \u0437 \u0441\u0430\u0431\u043e\u044e \u0441\u0432\u0430\u044e \u0447\u0430\u0441\u043e\u0432\u0430\u0441\u0446\u044c, \u0434\u043e\u043a\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u0440\u0430\u0445\u0443 \u0456 \u0434\u043e\u043a\u0430\u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0422\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u0456\u0448 \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u044b\u043c. \u041d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0441\u0432\u0430\u044e \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u0430\u0441\u0446\u044c \u0426\u044f\u0431\u0435 \u0445\u043e\u0447\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0434\u0440\u043e\u0431\u043d\u0430\u044f \u0447\u0430\u0441\u0442\u043a\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f. \u0422\u044b \u0434\u0430\u0435\u0448 \u044f\u043c\u0443 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0430\u0434 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0426\u044f\u0431\u0435, \u0431\u043e \u0422\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0456 \u043d\u0435\u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430\u0435 \u043d\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0430\u0434\u043f\u0430\u0447\u043d\u0435 \u045e \u0422\u0430\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0434\u0430\u0439 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0446\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0442\u0440\u044d\u0431\u0430 \u0426\u044f\u0431\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c. \u042f\u043a \u0436\u0430 \u043c\u043e\u0436\u0430 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0426\u044f\u0431\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0426\u044f\u0431\u0435? \u041d\u0435\u0441\u0432\u044f\u0434\u043e\u043c\u0430 \u043c\u043e\u0436\u0430 \u0451\u043d \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0433\u0430. \u0426\u0456 \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u0442\u0440\u044d\u0431\u0430 \u0426\u044f\u0431\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c, \u043a\u0430\u0431 \u0426\u044f\u0431\u0435 \u043f\u0430\u0437\u043d\u0430\u0446\u044c? \u0410\u043b\u0435 &laquo;\u044f\u043a \u0436\u0430 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0442\u0430\u0433\u043e, \u0443 \u043a\u0430\u0433\u043e \u043d\u0435 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456? \u042f\u043a \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043d\u0435 \u0447\u0443\u043b\u0456?&raquo; (\u0420\u044b\u043c 10, 14).<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u044f\u0446\u044c \u041f\u0430\u043d\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u042f\u0433\u043e \u0448\u0443\u043a\u0430\u0435&raquo; (\u041f\u0441 22 [21], 27). \u0422\u044b\u044f, \u0448\u0442\u043e \u0448\u0443\u043a\u0430\u044e\u0446\u044c, \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u044c \u042f\u0433\u043e, \u0430, \u0437\u043d\u0430\u0439\u0448\u043e\u045e\u0448\u044b, \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u044f\u0446\u044c. \u0414\u044b\u043a \u0436\u0430 \u0431\u0443\u0434\u0443 \u0448\u0443\u043a\u0430\u0446\u044c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0426\u044f\u0431\u0435. \u0411\u0443\u0434\u0443 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0426\u044f\u0431\u0435 \u0437 \u0432\u0435\u0440\u0430\u044e \u045e \u0426\u044f\u0431\u0435, \u0431\u043e \u0426\u044f\u0431\u0435 \u0430\u0431\u0432\u044f\u0448\u0430\u043b\u0456 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441. \u041f\u0430\u043d\u0435, \u0426\u044f\u0431\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043c\u0430\u044f \u0432\u0435\u0440\u0430, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u044f \u0422\u0430\u0431\u043e\u044e, \u044f\u043a\u0443\u044e \u0422\u044b \u043f\u0440\u044b\u0448\u0447\u0430\u043f\u0456\u045e \u043c\u043d\u0435 \u043f\u0440\u0430\u0437 \u0443\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0433\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u044f\u043a \u0436\u0430 \u044f \u043c\u0430\u0433\u0443 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u043c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u043c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430 \u0456 \u041f\u0430\u043d\u0430? \u0422\u0430\u043a\u0456 \u0437\u0430\u043a\u043b\u0456\u043a \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u043f\u0440\u0430\u0448\u044d\u043d\u043d\u0435\u043c \u043c\u0430\u0451\u0439 \u0434\u0443\u0448\u044b. \u0426\u0456 \u0436 \u0451\u0441\u0446\u044c \u0443\u0432\u0430 \u043c\u043d\u0435 \u0442\u0430\u043a\u043e\u0435 \u043c\u0435\u0441\u0446\u0430, \u043a\u0443\u0434\u044b \u043c\u043e\u0433 \u0431\u044b \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u043c\u043e\u0439 \u0411\u043e\u0433? \u0414\u0437\u0435 \u0436 \u0443\u0432\u043e\u0439\u0434\u0437\u0435 \u0434\u0430 \u043c\u044f\u043d\u0435 \u0411\u043e\u0433, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e? \u0411\u043e\u0436\u0430 \u043c\u043e\u0439, \u0446\u0456 \u0436 \u0451\u0441\u0446\u044c \u0443\u0432\u0430 \u043c\u043d\u0435 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0442\u0430\u043a\u043e\u0435, \u0448\u0442\u043e \u043c\u0430\u0433\u043b\u043e \u0431 \u0426\u044f\u0431\u0435 \u0430\u0445\u0430\u043f\u0456\u0446\u044c? \u0406 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u0435\u0437 \u0426\u044f\u0431\u0435 \u043d\u0456\u0448\u0442\u043e \u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0430 \u0431 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0456\u0441\u043d\u0443\u0435, \u0442\u043e \u0446\u0456 \u043d\u0435 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0430\u0434\u0441\u044e\u043b\u044c, \u0448\u0442\u043e \u0456\u0441\u043d\u0430\u0435 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u0426\u044f\u0431\u0435?<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u0441\u043d\u0443\u044e, \u0430 \u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u045e \u0431\u044b \u045e\u0432\u043e\u0433\u0443\u043b\u0435, \u043a\u0430\u043b\u0456 \u0431 \u0422\u044b \u043d\u0435 \u0431\u044b\u045e \u0443\u0432\u0430 \u043c\u043d\u0435, \u0442\u043e \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u0436 \u043f\u0440\u0430\u0441\u0456\u0446\u044c, \u043a\u0430\u0431 \u0422\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u043c\u044f\u043d\u0435? \u042f \u043d\u0435 \u0441\u044b\u0448\u043e\u045e \u044f\u0448\u0447\u044d \u045e \u043a\u0440\u0430\u0456\u043d\u0443 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0430 \u0422\u044b \u0442\u0430\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430. \u0411\u043e &laquo;\u043a\u0430\u043b\u0456 \u0441\u043f\u0430\u0447\u043d\u0443 \u045e \u0430\u0434\u0445\u043b\u0430\u043d\u0456, \u0422\u044b \u043f\u043e\u0431\u0430\u0447&raquo; (\u041f\u0441 139 [138], 8).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0431\u044b\u043b\u043e \u0431 \u043c\u044f\u043d\u0435, \u0411\u043e\u0436\u0430 \u043c\u043e\u0439, \u043d\u0435 \u0431\u044b\u043b\u043e \u043c\u044f\u043d\u0435 \u045e\u0432\u043e\u0433\u0443\u043b\u0435, \u043a\u0430\u043b\u0456 \u0431 \u0422\u044b \u043d\u0435 \u0431\u044b\u045e \u0443\u0432\u0430 \u043c\u043d\u0435, \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u043a\u0430\u043b\u0456 \u0431 \u044f \u043d\u0435 \u0431\u044b\u045e \u0443 \u0422\u0430\u0431\u0435, \u0431\u043e \u045e\u0441\u0451 \u0437 \u0426\u044f\u0431\u0435, \u043f\u0440\u0430\u0437 \u0426\u044f\u0431\u0435 \u0456 \u0434\u043b\u044f \u0426\u044f\u0431\u0435 (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 8, 6). \u0422\u0430\u043a, \u043e \u041f\u0430\u043d\u0435, \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a. \u0422\u0430\u043c\u0443, \u043a\u0443\u0434\u044b \u0436 \u043c\u043d\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0426\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u044f \u045e \u0422\u0430\u0431\u0435? \u0426\u0456 \u0430\u0434\u043a\u0443\u043b\u044c \u0436\u0430 \u0422\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u043c\u044f\u043d\u0435? \u041a\u0443\u0434\u044b \u0436 \u043c\u043d\u0435 \u043f\u0430\u0439\u0441\u0446\u0456 \u043f\u0430-\u0437\u0430 \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e, \u043a\u0430\u0431 \u0430\u0434\u0442\u0443\u043b\u044c \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u043c\u043e\u0439 \u0411\u043e\u0433, \u044f\u043a\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0426\u0456 \u0436 \u043d\u0435 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u044e \u042f \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e&raquo; (\u0415\u0440 23, 24)?<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0436 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u043c\u043d\u0435 \u0430\u0434\u043f\u0430\u0447\u044b\u0446\u044c \u0443 \u0422\u0430\u0431\u0435? \u0425\u0442\u043e \u0436 \u0443\u0432\u044f\u0434\u0437\u0435 \u0426\u044f\u0431\u0435 \u045e \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u0431 \u0422\u044b \u043d\u0430\u0441\u044b\u0446\u0456\u045e \u044f\u0433\u043e, \u043a\u0430\u0431 \u0437\u0430\u0431\u044b\u045e \u044f \u043f\u0440\u0430 \u0441\u0432\u0430\u0451 \u0437\u043b\u043e \u0456 \u043f\u0440\u044b\u0442\u0443\u043b\u0456\u045e\u0441\u044f \u0434\u0430 \u0426\u044f\u0431\u0435, \u043c\u0430\u0439\u0433\u043e \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430? \u0425\u0442\u043e \u0422\u044b \u0434\u043b\u044f \u043c\u044f\u043d\u0435? \u0411\u0443\u0434\u0437\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u043c\u043d\u0435 \u0433\u044d\u0442\u0430 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c. \u0425\u0442\u043e \u0436 \u044f \u0434\u043b\u044f \u0426\u044f\u0431\u0435, \u0448\u0442\u043e \u0422\u044b \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435\u0448 \u043c\u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0426\u044f\u0431\u0435, \u0430 \u043a\u0430\u043b\u0456 \u0431 \u044f \u043d\u0435 \u043b\u044e\u0431\u0456\u045e, \u0422\u044b \u0431 \u0433\u043d\u0435\u0432\u0430\u045e\u0441\u044f \u0456 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u045e \u0431\u044b \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435\u043c. \u0426\u0456 \u0436 \u043d\u0435\u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0442\u0430\u0433\u043e \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f, \u0448\u0442\u043e \u044f \u043d\u0435 \u043b\u044e\u0431\u043b\u044e \u0426\u044f\u0431\u0435?<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0445, \u041f\u0430\u043d\u0435, \u0411\u043e\u0436\u0430 \u043c\u043e\u0439! \u0421\u043a\u0430\u0436\u044b \u043c\u043d\u0435 \u045e \u0441\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u0445\u0442\u043e \u044f \u0434\u043b\u044f \u0426\u044f\u0431\u0435. &laquo;\u0421\u043a\u0430\u0436\u044b \u043c\u0430\u0451\u0439 \u0434\u0443\u0448\u044b: \u042f &ndash; \u0442\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435&raquo; (\u041f\u0441 35 [34], 3). \u0421\u043a\u0430\u0436\u044b \u0442\u0430\u043a, \u043a\u0430\u0431 \u044f \u043f\u0430\u0447\u0443\u045e. \u0412\u043e\u0441\u044c \u0432\u0443\u0448\u044b \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0437\u0432\u0435\u0440\u043d\u0443\u0442\u044b \u0434\u0430 \u0426\u044f\u0431\u0435; \u0430\u0434\u043a\u0440\u044b\u0439 \u0456\u0445 \u0456 &laquo;\u0441\u043a\u0430\u0436\u044b \u043c\u0430\u0451\u0439 \u0434\u0443\u0448\u044b: \u042f &ndash; \u0442\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435&raquo; (\u041f\u0441 35 [34], 3). \u042f \u043f\u0430\u0431\u044f\u0433\u0443 \u0437\u0430 \u0422\u0432\u0430\u0456\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u0456 \u0441\u0445\u0430\u043f\u043b\u044e \u0426\u044f\u0431\u0435. \u041d\u0435 \u0430\u0434\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u0439 \u0430\u0434 \u043c\u044f\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430. \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u043c\u0440\u0443, \u043a\u0430\u0431 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0435 \u043f\u0430\u043c\u0451\u0440, \u0430\u043b\u0435 \u0441\u0443\u0437\u0456\u0440\u0430\u045e \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 73 (72), 25-26; 35 (34), 3\u0441<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0433\u043e, \u0430\u043f\u0440\u043e\u0447 \u0426\u044f\u0431\u0435, \u044f \u043c\u0430\u044e \u045e \u043d\u0435\u0431\u0435? \u041a\u0430\u043b\u0456 \u044f \u0437 \u0422\u0430\u0431\u043e\u044e, \u043c\u044f\u043d\u0435 \u043d\u0435 \u0440\u0430\u0434\u0443\u0435 \u0437\u044f\u043c\u043b\u044f. \u0417\u043d\u0435\u043c\u0430\u0433\u0430\u0435 \u043c\u0430\u0451 \u0446\u0435\u043b\u0430 \u0456 \u0441\u044d\u0440\u0446\u0430 \u043c\u0430\u0451. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e\u0433 &ndash; \u0441\u043a\u0430\u043b\u0430 \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0456 \u043c\u0430\u044f \u0434\u043e\u043b\u044f \u043d\u0430\u0432\u0435\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043a\u0430\u0436\u044b \u043c\u0430\u0451\u0439 \u0434\u0443\u0448\u044b: \u042f &ndash; \u0442\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 &ndash; \u0441\u043a\u0430\u043b\u0430 \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0456 \u043c\u0430\u044f \u0434\u043e\u043b\u044f \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"92","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0414\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435&raquo; \u0441\u0432. \u0414\u0430\u0440\u0430\u0442\u044d\u044f, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Doct. 7, De accusatione sui ipsius, 1-2: PG 88, 1695-1699)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u0447\u044b\u043d\u0430 \u043d\u0435\u0441\u043f\u0430\u043a\u043e\u044e \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u0432\u0456\u043d\u0430\u0432\u0430\u0446\u0456\u043c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u043c, \u0431\u0440\u0430\u0442\u044b, \u044f\u043a \u0433\u044d\u0442\u0430 \u0434\u0437\u0435\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u0447\u0430\u0441\u0430\u043c \u0445\u0442\u043e\u0441\u044c\u0446\u0456, \u043f\u0430\u0447\u0443\u045e\u0448\u044b \u043f\u0440\u044b\u043a\u0440\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u043f\u0440\u044b\u043c\u0430\u0435 \u044f\u0433\u043e \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u043d\u0435 \u0447\u0443\u045e \u044f\u0433\u043e \u045e\u0432\u043e\u0433\u0443\u043b\u0435, \u0430 \u0447\u0430\u0441\u0430\u043c, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0447\u0443\u0435, \u043c\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0456 \u043d\u0435\u043f\u0430\u043a\u043e\u0456\u0446\u0446\u0430. \u0423 \u0447\u044b\u043c \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u0442\u0430\u043a\u0456\u0445 \u0440\u043e\u0437\u043d\u044b\u0445 \u0440\u044d\u0430\u043a\u0446\u044b\u0439? \u0406 \u0446\u0456 \u043d\u0430 \u0433\u044d\u0442\u0430 \u0430\u0434\u043d\u0430, \u0446\u0456 \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u043f\u0440\u044b\u0447\u044b\u043d? \u0428\u0442\u043e \u0442\u044b\u0447\u044b\u0446\u0446\u0430 \u043c\u044f\u043d\u0435, \u044f \u0431\u0430\u0447\u0443 \u0448\u043c\u0430\u0442 \u043f\u0440\u044b\u0447\u044b\u043d, \u0430\u043b\u0435 \u0430\u0434\u043d\u0430, \u0442\u0430\u043a \u0431\u044b \u043c\u043e\u0432\u0456\u0446\u044c, \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u045e\u0441\u0435 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043f\u0440\u0430\u0431\u0443\u044e \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c. \u0412\u043e\u0441\u044c, \u043d\u0430\u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0443\u044e \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0441\u0446\u044c \u0456 \u0434\u0443\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u044b. \u0417\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430, \u044f\u043a \u043a\u0430\u0436\u0443\u0446\u044c, \u0443 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0441\u0442\u0430\u043d\u0435. \u0426\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0441\u0442\u0430\u0432\u0456\u0446\u0446\u0430 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u044f\u043b\u0451\u0433\u043a\u0430\u0433\u0430 \u0431\u0440\u0430\u0442\u0430. \u0410 \u0456\u043d\u0448\u044b, \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043f\u0440\u044b\u0432\u044f\u0437\u0430\u043d\u0430\u0441\u0446\u0456 \u0434\u0430 \u0431\u0440\u0430\u0442\u0430, \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430 \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0434 \u044f\u0433\u043e \u043a\u043e\u0436\u043d\u0443\u044e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0417\u0434\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u0442\u044b\u043c, \u0445\u0442\u043e \u044f\u0433\u043e \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0435, \u043b\u0456\u0447\u044b\u0446\u044c \u044f\u0433\u043e \u043d\u0456\u0447\u044b\u043c, \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u044b \u0434\u0430 \u045e\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u0451\u043d \u0440\u043e\u0431\u0456\u0446\u044c, \u0456 \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0451\u043d \u043a\u0430\u0436\u0430 \u0456 \u044f\u043a \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430. \u0422\u0430\u043c\u0443 \u0431\u044b\u0432\u0430\u0435, \u043a\u0430\u0436\u0443, \u0448\u0442\u043e \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0441\u043f\u0430\u043a\u043e\u044e \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0447\u0430\u0441\u0430\u043c \u0437 \u043f\u0430\u0433\u0430\u0440\u0434\u044b \u0456 \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u0430\u0441\u0446\u0456. \u0413\u044d\u0442\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0437\u0433\u0443\u0431\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u0434\u0430\u0445\u043e\u043f \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u0435 \u043d\u0430 \u0431\u0440\u0430\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0447\u044b\u043d\u044f\u0435 \u043a\u0440\u044b\u045e\u0434\u0443, \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u043d\u0435\u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0439 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043f\u0430\u0441\u0442\u0430\u0432\u044b \u045e \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043c\u043e\u043c\u0430\u043d\u0442, \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0435\u043f\u0440\u044b\u044f\u0437\u043d\u0430\u0441\u0446\u0456 \u0434\u0430 \u0431\u0440\u0430\u0442\u0430. \u0406\u0441\u043d\u0443\u0435 \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e \u0448\u043c\u0430\u0442 \u0456\u043d\u0448\u044b\u0445 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u043e\u0436\u043d\u0430 \u043f\u0435\u0440\u0430\u043b\u0456\u0447\u044b\u0446\u044c. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u045e\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u043c, \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u0432\u044b\u0441\u043d\u043e\u0432\u044b, \u0448\u0442\u043e \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u043d\u0435\u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u044f \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u0432\u0456\u043d\u0430\u0432\u0430\u0446\u0456\u043c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435. \u0410\u0434\u0441\u044e\u043b\u044c \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u045e\u0441\u044f \u043d\u0430\u0448\u0430\u044f \u043f\u0430\u043a\u0443\u0442\u0430, \u0442\u0430\u043c\u0443 \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043d\u0456\u043a\u043e\u043b\u0456 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0441\u043f\u0430\u043a\u043e\u044e. \u0422\u0430\u043c\u0443 \u043d\u0456\u0447\u043e\u0433\u0430 \u0434\u0437\u0456\u045e\u043d\u0430\u0433\u0430, \u0448\u0442\u043e \u045e\u0441\u0435 \u0441\u0432\u044f\u0442\u044b\u044f \u043c\u0443\u0436\u044b \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456 \u043f\u0430-\u0437\u0430 \u0433\u044d\u0442\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u0439 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0439 \u0456\u043d\u0448\u0430\u0439, \u044f\u043a\u0430\u044f \u0431 \u0432\u044f\u043b\u0430 \u0434\u0430 \u0441\u043f\u0430\u043a\u043e\u044e. \u0414\u0430\u0440\u044d\u0447\u044b \u043c\u044b \u0441\u0430\u043c\u0456 \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0456\u043d\u0448\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0456 \u0434\u0430 \u0441\u043f\u0430\u043a\u043e\u044e. \u041d\u0430\u043c \u0436\u0430 \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u043c\u044b \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u0456 \u0448\u0442\u043e \u0456\u0434\u0437\u0451\u043c \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u044b\u043c \u0448\u043b\u044f\u0445\u0430\u043c, \u0431\u0435\u0437 \u0437\u0433\u043e\u0434\u044b \u043d\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0443 \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u044b\u043c \u043c\u0430\u043b\u044b\u043c \u0432\u0456\u043d\u0430\u0432\u0430\u0446\u0456\u0446\u044c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435!<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441, \u043a\u0430\u043b\u0456 \u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0442\u044b\u0441\u044f\u0447\u044b \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u044b\u0445 \u0447\u044b\u043d\u0430\u045e, \u0430\u043b\u0435 \u0430\u0434\u044b\u0448\u043e\u045e \u0430\u0434 \u0433\u044d\u0442\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0456, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0435 \u043c\u0443\u0447\u044b\u0446\u044c \u0441\u044f\u0431\u0435 \u0456 \u0456\u043d\u0448\u044b\u0445, \u0433\u0443\u0431\u043b\u044f\u044e\u0447\u044b \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0443\u0432\u0435\u0441\u044c \u043f\u043b\u0451\u043d \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 1, 8. 9; \u041f\u0440\u044b\u043f 28, 13<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u043d\u0435 \u043c\u0430\u0435\u043c \u0433\u0440\u0430\u0445\u0443, \u0430\u0448\u0443\u043a\u0432\u0430\u0435\u043c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435.<span style=\"color: #ff0000;\"> *<\/span> \u041a\u0430\u043b\u0456 \u0436 \u0432\u044b\u0437\u043d\u0430\u0451\u043c \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f, \u0442\u043e \u0411\u043e\u0433, \u0432\u0435\u0440\u043d\u044b \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u043c \u0433\u0440\u0430\u0445\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u044f \u0442\u043e\u0439, \u0445\u0442\u043e \u0445\u0430\u0432\u0430\u0435 \u0441\u0432\u0430\u0435 \u043f\u0430\u043c\u044b\u043b\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0436 \u0432\u044b\u0437\u043d\u0430\u0451\u043c \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f, \u0442\u043e \u0411\u043e\u0433, \u0432\u0435\u0440\u043d\u044b \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u043c \u0433\u0440\u0430\u0445\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"93","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0414\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435&raquo; \u0441\u0432. \u0414\u0430\u0440\u0430\u0442\u044d\u044f, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Doct. 13, De accusatione sui ipsius, 2-3: PG 88, 1699)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u044b \u0441\u043f\u0430\u043a\u043e\u0439 \u0434\u0443\u0448\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u0445\u0442\u043e \u0432\u0456\u043d\u0430\u0432\u0430\u0446\u0456\u0446\u044c \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u043a\u043e\u0436\u043d\u044b \u0440\u0430\u0437 \u043f\u0440\u044b \u0441\u0443\u0441\u0442\u0440\u044d\u0447\u044b \u0437 \u043d\u0435\u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044f\u043c\u0456, \u043a\u0440\u044b\u045e\u0434\u0430\u0439, \u0437\u043d\u044f\u0432\u0430\u0433\u0430\u0439 \u0446\u0456 \u044f\u043a\u0456\u043c-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0456\u043d\u0448\u044b\u043c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435\u043c, \u043f\u0440\u044b\u043c\u0430\u0435 \u045e\u0441\u0451 \u0437 \u0430\u043f\u0442\u044b\u043c\u0456\u0437\u043c\u0430\u043c, \u0443\u0441\u0451 \u043b\u0456\u0447\u044b\u0446\u044c \u0441\u043b\u0443\u0448\u043d\u044b\u043c \u0456 \u045e \u043d\u0456\u044f\u043a\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u043d\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u043d\u0435\u0441\u043f\u0430\u043a\u043e\u044e. \u0426\u0456 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u0441\u043f\u0430\u043a\u0430\u0439\u043d\u0435\u0439\u0448\u0430\u0435 \u0437\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0436 \u043c\u043e\u0433 \u0431\u044b \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u042f\u043a \u0436\u0430 \u044f \u043c\u0430\u0433\u0443 \u0432\u0456\u043d\u0430\u0432\u0430\u0446\u0456\u0446\u044c \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u043c\u043e\u0439 \u0431\u0440\u0430\u0442 \u0430\u0431\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0441\u0430 \u043c\u043d\u043e\u044e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u044f \u043d\u0435 \u0434\u0430\u045e \u0434\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0456\u044f\u043a\u0430\u0439 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0436\u0430, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0431\u043e\u044f\u0437\u0437\u044e \u0411\u043e\u0436\u0430\u0439, \u043f\u0440\u0430\u0432\u0435\u0440\u044b\u0446\u044c \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c, \u043d\u0430\u043f\u044d\u045e\u043d\u0430, \u0448\u0442\u043e \u043d\u0430 \u0441\u0430\u043c\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0434\u0430\u045e \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0443 \u0447\u044b\u043d\u0430\u043c, \u0441\u043b\u043e\u0432\u0430\u043c \u0430\u0431\u043e \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u043c\u0456. \u041a\u0430\u043b\u0456 \u0436 \u0441\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u0446\u044c, \u0448\u0442\u043e \u043d\u0456 \u045e \u0447\u044b\u043c \u0433\u044d\u0442\u044b\u043c \u043d\u0435 \u0434\u0430\u045e \u043f\u0430\u0434\u0441\u0442\u0430\u045e, \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u045e \u043a\u0430\u043b\u0456-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0443 \u0442\u043e\u0439 \u0446\u0456 \u0456\u043d\u0448\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u0430\u0431\u043e \u0431\u044b\u045e \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b \u043f\u0435\u0440\u0430\u0434 \u043a\u0456\u043c-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0437\u0443\u0441\u0456\u043c \u0456\u043d\u0448\u044b\u043c. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0437 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0430\u0431\u043e \u043d\u0430\u0432\u0430\u0442 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0456\u043d\u0448\u044b\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e \u0446\u044f\u043f\u0435\u0440 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0437\u0430\u0441\u043b\u0443\u0436\u0430\u043d\u0430\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043e\u0436\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0434\u0430\u0440\u044b\u0446\u0446\u0430, \u0448\u0442\u043e \u0445\u0442\u043e\u0441\u044c\u0446\u0456, \u0445\u0442\u043e, \u044f\u043a \u0441\u0430\u043c \u043c\u044f\u0440\u043a\u0443\u0435, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u044b \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0441\u0446\u044c, \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0436\u0430\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0431\u0440\u0430\u0442\u0430 \u0456 \u0434\u0443\u043c\u0430\u0435, \u0448\u0442\u043e \u0441\u043b\u0443\u0448\u043d\u0430 \u0433\u043d\u0435\u0432\u0430\u0435\u0446\u0446\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041a\u0430\u043b\u0456 \u0431 \u0451\u043d \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043d\u0435 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u045e \u0431\u044b \u0456 \u043d\u0435 \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u045e, \u044f \u0431 \u043d\u0435 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0433\u0440\u0430\u0445\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043d\u0435\u0448\u043d\u0435, \u0433\u044d\u0442\u0430 \u043f\u0430\u0434\u043c\u0430\u043d \u0456 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0435. \u0426\u0456 \u0436 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u0441\u043b\u043e\u0432\u0430\u045e, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u044b\u043d\u0451\u0441 \u043d\u0435\u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u0435? \u0401\u043d \u0432\u044b\u044f\u0432\u0456\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0436\u043e \u0431\u044b\u043b\u043e \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u043a\u0430\u0431 \u043a\u0430\u043b\u0456 \u0437\u0430\u0445\u043e\u0447\u0430, \u043c\u043e\u0433 \u0447\u044b\u043d\u0456\u0446\u044c \u043f\u0430\u043a\u0443\u0442\u0443. \u0422\u0430\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0433\u0430 \u043f\u0448\u0430\u043d\u0456\u0447\u043d\u0430\u0433\u0430 \u0445\u043b\u0435\u0431\u0430, \u044f\u043a\u0456 \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u044f\u0433\u043e \u0440\u0430\u0437\u043b\u0430\u043c\u0430\u044e\u0446\u044c, \u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u044b\u043c. \u0414\u0443\u043c\u0430\u0435, \u0448\u0442\u043e \u0451\u043d \u043f\u043e\u045e\u043d\u044b \u0441\u043f\u0430\u043a\u043e\u044e, \u0430\u043b\u0435 \u045e\u043d\u0443\u0442\u0440\u044b \u0431\u044b\u043b\u0430 \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u044f \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u043d\u0435 \u0432\u0435\u0434\u0430\u045e. \u042f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0431\u0440\u0430\u0442 \u0456 \u0441\u043a\u0430\u0436\u0430 \u0441\u043b\u043e\u0432\u0430, \u0442\u0443\u0442 \u0436\u0430 \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u044c \u0456 \u0431\u0440\u0443\u0434, \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u045e \u0441\u044d\u0440\u0446\u044b. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0442\u0430\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0440\u0430\u0433\u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u0448\u043a\u0430\u0434\u0443\u0435, \u043d\u044f\u0445\u0430\u0439 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u0446\u0446\u0430, \u0430 \u043d\u0430\u0432\u0430\u0442 \u0443\u0431\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0431\u043e\u043b\u044c\u0448 \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u0431\u0440\u0430\u0442\u0443, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u0443\u0447\u044b\u0446\u044c \u044f\u0433\u043e \u043d\u0456\u044f\u043a\u0456\u044f \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456, \u0430 \u0451\u043d, \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u0442\u044b\u043c \u043c\u0435\u043d\u0448 \u0431\u0443\u0434\u0437\u0435 \u0456\u0445 \u0430\u0434\u0447\u0443\u0432\u0430\u0446\u044c. \u0411\u043e \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0443\u0448\u0430 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043c\u043e\u0446\u043d\u0430\u0439 \u0456 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0439 \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0441\u0443\u0441\u0442\u0440\u044d\u0447\u043d\u044b\u044f \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0401\u045e 9, 2. 14; 15, 15<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u0435\u0446\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c.<span style=\"color: #ff0000;\"> *<\/span> \u0428\u0442\u043e \u0436 \u043c\u0430\u0433\u0443 \u044f \u0430\u0434\u043a\u0430\u0437\u0430\u0446\u044c \u042f\u043c\u0443, \u0448\u0443\u043a\u0430\u044e\u0447\u044b \u0441\u043b\u043e\u0432\u044b \u043f\u0435\u0440\u0430\u0434 \u0406\u043c?<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0401\u043d \u043d\u0435 \u0434\u0430\u0432\u044f\u0440\u0430\u0435 \u0441\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u044b\u043c, \u043a\u0430\u043b\u0456 \u043d\u044f\u0431\u0451\u0441\u044b \u043d\u0435\u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0447\u044b\u0441\u0442\u044b\u044f \u0434\u043b\u044f \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0428\u0442\u043e \u0436 \u043c\u0430\u0433\u0443 \u044f \u0430\u0434\u043a\u0430\u0437\u0430\u0446\u044c \u042f\u043c\u0443, \u0448\u0443\u043a\u0430\u044e\u0447\u044b \u0441\u043b\u043e\u0432\u044b \u043f\u0435\u0440\u0430\u0434 \u0406\u043c?<\/p>\r\n"}, {"GCH_CH_2_ID":"94","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0401\u0432\u0430&raquo; \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 23, 23-24: PL 76, 265-266)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u044f \u0432\u0435\u0434\u044b \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u044e\u0446\u044c \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u0430\u0441\u0446\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0421\u043b\u0443\u0445\u0430\u0439, \u0401\u045e, \u043c\u0430\u044e \u043c\u043e\u0432\u0443, \u0441\u0445\u0456\u043b\u0456 \u0432\u0443\u0445\u0430 \u0434\u0430 \u045e\u0441\u0456\u0445 \u043c\u0430\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u045e&raquo; (\u0401\u045e 33, 1). \u0412\u0435\u0434\u044b \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u0446\u0430 \u0442\u044b\u043c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u0432\u0443\u0447\u0430\u0446\u044c, \u043d\u0435 \u045e\u043c\u0435\u044e\u0446\u044c \u0440\u0430\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0437 \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0456 \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0432\u0435\u0440\u0430\u0433\u043e\u0434\u043d\u0430 \u043f\u0435\u0440\u0430\u0434\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a\u0443\u044e \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u044e\u0446\u044c. \u0417 \u0456\u0445 \u043c\u043e\u0432\u044b \u0432\u044b\u043d\u0456\u043a\u0430\u0435, \u0448\u0442\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u044e \u043b\u0456\u0447\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0432\u0435\u043b\u044c\u043c\u0456 \u0432\u044b\u0441\u043e\u043a\u0430 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u0430 \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u0433\u043b\u044f\u0434\u0437\u044f\u0446\u044c \u044f\u043a \u043d\u0430 \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u043d\u0456\u0436\u044d\u0439\u0448\u0430\u0433\u0430, \u0430\u043c\u0430\u043b\u044c \u0443 \u043f\u0440\u043e\u0440\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u043b\u0443\u0448\u043d\u0430 \u043a\u0430\u0436\u0430 \u0456\u043c \u041f\u0430\u043d \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430: &laquo;\u0412\u044b \u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u043d\u0430\u0434 \u0456\u043c\u0456 \u0441\u0456\u043b\u0430\u044e \u0456 \u0433\u0432\u0430\u043b\u0442\u0430\u043c&raquo; (\u042d\u0437\u0445 34, 4). \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0441\u0443\u0440\u043e\u0432\u0430 \u0456 \u0431\u044f\u0437\u043b\u0456\u0442\u0430\u0441\u043d\u0430 \u043a\u0456\u0440\u0443\u044e\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u0441\u0442\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u0432\u044b\u043f\u0440\u0430\u0432\u0456\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u043f\u0430\u0434\u0443\u043b\u0430\u0434\u043d\u044b\u0445 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b\u043c \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c, \u0430\u043b\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c \u0441\u0443\u0440\u043e\u0432\u0430 \u0456 \u0441\u0442\u0430\u0440\u0430\u044e\u0446\u0446\u0430 \u0456\u0445 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u044f \u0432\u0435\u0434\u044b \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u044e\u0446\u044c \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043d\u0430\u0432\u0430\u0442 \u0443 \u0434\u0443\u043c\u043a\u0430\u0445, \u0447\u044b\u043c \u0430\u0434\u0434\u0430\u043d\u0435\u0439 \u0441\u0442\u0440\u044d\u043b\u0430\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u045e \u043f\u0430\u0440\u0430\u0436\u0430\u044e\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c \u043f\u044b\u0445\u0456. \u0406\u043c\u043a\u043d\u0443\u0446\u0446\u0430, \u043a\u0430\u0431 \u0441\u0432\u0430\u0456\u043c\u0456 \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u044b\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u043c\u0456 \u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u044e\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u0430\u0445 \u0441\u043b\u0443\u0445\u0430\u0447\u043e\u045e. \u0421\u0442\u0430\u0440\u0430\u044e\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0436\u044b\u0446\u0446\u0451\u043c \u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0430\u0431 \u043f\u0430\u043a\u043e\u0440\u044b, \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u0446\u044b \u0456 \u043c\u0430\u0446\u0456 \u045e\u0441\u0456\u0445 \u0446\u043d\u043e\u0442\u0430\u045e, \u0442\u0430\u043a, \u043a\u0430\u0431 \u0432\u0443\u0447\u043d\u0456 \u043f\u0440\u0430\u045e\u0434\u044b \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u043b\u0456 \u044f\u0435 \u0440\u044d\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043d\u0430\u0439 \u0443 \u0436\u044b\u0446\u0446\u0456, \u0430 \u043d\u0435 \u045e \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, \u043d\u0456\u0431\u044b \u0437\u0430\u0431\u044b\u0432\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u045e\u0437\u043d\u0451\u0441\u043b\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u0442\u0432\u0430, \u043a\u0430\u0436\u0430: &laquo;\u041c\u044b \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u0430\u043c\u0456 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441&raquo; (1 \u0422\u044d\u0441 2, 7). \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0451\u0442\u0440: &laquo;\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0433\u0430\u0442\u043e\u0432\u044b\u043c\u0456 \u0434\u0430\u0446\u044c \u0430\u0434\u043a\u0430\u0437 \u043a\u043e\u0436\u043d\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0432\u0430\u0441 \u0441\u043b\u043e\u0432\u0430 \u043f\u0440\u0430 \u0432\u0430\u0448\u0443 \u043d\u0430\u0434\u0437\u0435\u044e&raquo; (1 \u041f 3, 15). \u0406 \u0442\u0443\u0442 \u0436\u0430 \u0434\u0430\u0434\u0430\u0435, \u043a\u0430\u0436\u0443\u0447\u044b \u043f\u0440\u0430 \u0441\u043f\u043e\u0441\u0430\u0431 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u044f: &laquo;\u0410\u043b\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0433\u044d\u0442\u0430 \u043b\u0430\u0433\u043e\u0434\u043d\u0430, \u0437 \u0431\u043e\u044f\u0437\u0437\u044e \u0411\u043e\u0436\u0430\u0439 \u0456 \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435\u043c&raquo; (1 \u041f 3, 16).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430 \u0441\u0432\u0430\u0439\u043c\u0443 \u0432\u0443\u0447\u043d\u044e \u0426\u0456\u043c\u0430\u0444\u0435\u044e: &laquo;\u0417\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0439 \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u0439 \u0437 \u0443\u0441\u0451\u0439 \u043f\u0430\u0432\u0430\u0433\u0430\u044e&raquo; (\u0426\u0456\u0442 2,15), \u043d\u0435 \u0440\u044d\u043a\u0430\u043c\u0435\u043d\u0434\u0443\u0435 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0446\u044c, \u0430\u043b\u0435 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0437 \u043f\u0430\u0432\u0430\u0433\u0430\u044e, \u0448\u0442\u043e \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0441\u0430 \u0441\u043f\u043e\u0441\u0430\u0431\u0443 \u0436\u044b\u0446\u0446\u044f. \u0417 \u043f\u0430\u0432\u0430\u0433\u0430\u044e \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0446\u044c \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u043f\u0430\u045e\u043d\u044f\u044e\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0446\u044c. \u0411\u043e, \u043a\u0430\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u0430\u043c, \u0442\u0430\u0434\u044b \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0435 \u0431\u044b\u0446\u044c \u0432\u0435\u0440\u0430\u0433\u043e\u0434\u043d\u044b\u043c. \u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0440\u0430\u0456\u0446\u044c \u0431\u044b\u0446\u044c \u043d\u0435 \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u044b\u043c \u0443 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0456, \u0430\u043b\u0435 \u0433\u043e\u0434\u043d\u044b\u043c \u0434\u0430\u0432\u0435\u0440\u0443, \u0448\u0442\u043e \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0422\u0430\u043c\u0443 \u043f\u0440\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0401\u043d \u0456\u0445 \u0432\u0443\u0447\u044b\u045e \u044f\u043a \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u043b\u0430\u0434\u0443, \u0430 \u043d\u0435 \u044f\u043a \u043a\u043d\u0456\u0436\u043d\u0456\u043a\u0456 \u0456 \u0444\u0430\u0440\u044b\u0441\u0435\u0456&raquo; (\u041c\u0446 7, 29). \u0413\u044d\u0442\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0437 \u043c\u043e\u0446\u0430\u044e, \u0431\u043e \u043d\u0435 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0447\u044b\u043d\u0443, \u044f\u043a\u0456 \u0431 \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u045e \u0434\u0430\u043a\u043e\u0440\u0443. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0439 \u043c\u043e\u0446\u044b \u043c\u0435\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u043d\u0430\u043c \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 5, 5b; \u041c\u0446 11, 29b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043f\u0440\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u045e\u0441\u0435 \u0432\u0430 \u045e\u0437\u0430\u0435\u043c\u043d\u0443\u044e \u043f\u0430\u043a\u043e\u0440\u0443,<span style=\"color: #ff0000;\"> *<\/span> \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u043c, \u0430 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0434\u0430\u0435 \u043b\u0430\u0441\u043a\u0443. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u0432\u0443\u0447\u044b\u0446\u0435\u0441\u044f \u0430\u0434 \u041c\u044f\u043d\u0435, \u0431\u043e \u042f \u0446\u0456\u0445\u0456 \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u0441\u044d\u0440\u0446\u0430\u043c, \u0456 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u0441\u043f\u0430\u043a\u043e\u0439 \u0434\u043b\u044f \u0441\u0432\u0430\u0456\u0445 \u0434\u0443\u0448\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u043c, \u0430 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0434\u0430\u0435 \u043b\u0430\u0441\u043a\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"95","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0401\u0432\u0430&raquo; \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 29, 2-4: PL 76, 478-480)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0430\u0441\u0446\u0451\u043b \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u044f\u043a \u0440\u0430\u043d\u0456\u0448\u043d\u044f\u044f \u0437\u043e\u0440\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u0440\u0430\u043d\u043a\u0430, \u0448\u0442\u043e \u0437\u0430\u0432\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u0430\u043d\u0456\u0448\u043d\u044f\u0439 \u0437\u043e\u0440\u043a\u0430\u0439, \u0440\u0430\u0441\u0441\u0435\u0439\u0432\u0430\u0435 \u0446\u0435\u043c\u0440\u0443 \u0456 \u043d\u044f\u0441\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0442\u0430\u043c\u0443 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u045e\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445. \u0411\u043e \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043d\u043e\u0447\u044b \u043d\u044f\u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456 \u0434\u0430 \u0441\u0432\u044f\u0442\u043b\u0430 \u0432\u0435\u0440\u044b, \u0442\u0430\u0434\u044b \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0437\u0430\u0440\u0430\u043d\u043a\u0456 \u0440\u0430\u0441\u043f\u0430\u0447\u044b\u043d\u0430\u0435 \u0434\u0437\u0435\u043d\u044c, \u0430 \u0446\u0435\u043c\u0440\u0430 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u044f\u0442\u043b\u0443, \u0448\u0442\u043e \u043f\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u044c \u0437 \u0432\u044b\u0448\u044b\u043d\u0456. \u0422\u0430\u043c\u0443 \u0441\u043b\u0443\u0448\u043d\u0430 \u045e \u043a\u043d\u0456\u0437\u0435 \u041f\u0435\u0441\u043d\u0456 \u043f\u0435\u0441\u043d\u044f\u045e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u041a\u0456\u043c \u0451\u0441\u0446\u044c \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u044f\u043a \u0437\u0430\u0440\u0430\u043d\u043a\u0430&raquo; (\u041f\u043f 6,10). \u0422\u0430\u043a \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a\u0456 \u043c\u043a\u043d\u0435 \u0434\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0431\u044b\u045e \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0437\u0430\u0440\u0430\u043d\u043a\u0430\u0439. \u0411\u043e, \u043a\u0430\u043b\u0456 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0437\u043c\u0440\u043e\u043a \u0433\u0440\u0430\u0445\u043e\u045e, \u0442\u0430\u0434\u044b \u044f\u0441\u043d\u0435\u0435 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u044e\u0447\u044b \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0437\u0433\u0430\u0434\u0430\u043d\u0443\u044e \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u0430\u0441\u0446\u044c \u0437\u0430\u0440\u0430\u043d\u043a\u0456, \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435\u043c \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u0432\u0430\u0436\u043d\u0430\u0435. \u0411\u043b\u044f\u0441\u043a \u0437\u0430\u0440\u0430\u043d\u043a\u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u0430\u0434\u044b\u0445\u043e\u0434 \u043d\u043e\u0447\u044b, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0434\u043d\u044f \u0432\u0430 \u045e\u0441\u0451\u0439 \u044f\u0433\u043e \u043f\u043e\u045e\u043d\u0456. \u0411\u043e \u043a\u0430\u043b\u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0446\u0435\u043c\u0440\u0443 \u0456 \u043f\u0440\u044b\u043c\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0434\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0437\u043c\u044f\u0448\u0430\u043d\u0430\u0435 \u0437 \u0446\u0435\u043c\u0440\u0430\u0439. \u0406 \u043c\u044b \u045e\u0441\u0435, \u044f\u043a\u0456\u044f \u0456\u0434\u0437\u0451 \u0437\u0430 \u043f\u0440\u0430\u045e\u0434\u0430\u0439, \u0447\u044b\u043c \u0436\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u043b\u044f\u0441\u043a\u0430\u043c \u0437\u0430\u0440\u0430\u043d\u043a\u0456? \u041d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u043d\u0430\u0448\u044b\u0445 \u0447\u044b\u043d\u0430\u045e \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u0443, \u0430 \u045e \u0456\u043d\u0448\u044b\u0445 \u043c\u044b \u0437\u043d\u043e\u045e \u0430\u043a\u0430\u0437\u0432\u0430\u0435\u043c\u0441\u044f \u043d\u0435 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u043c\u0456 \u0440\u044d\u0448\u0442\u0430\u043a \u0446\u0435\u043c\u0440\u044b. \u0422\u0430\u043c\u0443 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043f\u0440\u0430\u0440\u043e\u043a \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u041d\u0456\u0445\u0442\u043e \u0437 \u0436\u044b\u0432\u044b\u0445 \u043d\u0435 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e&raquo; (\u041f\u0441143 [142], 2). \u0406 \u0437\u043d\u043e\u045e \u0436\u0430 \u0434\u0437\u0435\u0441\u044c\u0446\u0456 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0423\u0441\u0435 \u043c\u044b \u0441\u043f\u0430\u0442\u044b\u043a\u0430\u0435\u043c\u0441\u044f \u0448\u043c\u0430\u0442 \u0443 \u0447\u044b\u043c&raquo; (\u042f\u043a 3, 2).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430: &laquo;\u041d\u043e\u0447 \u043c\u0456\u043d\u0443\u043b\u0430&raquo;, \u043d\u0435 \u0434\u0430\u0434\u0430\u0435: &laquo;\u0456 \u043d\u0430\u0441\u0442\u0430\u045e \u0434\u0437\u0435\u043d\u044c&raquo;, \u0430\u043b\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0456 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u045e\u0441\u044f \u0434\u0437\u0435\u043d\u044c&raquo; (\u0420\u044b\u043c 13, 12). \u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u043f\u0430\u0441\u043b\u044f \u043d\u043e\u0447\u044b \u0434\u0437\u0435\u043d\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u0430 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u045e\u0441\u044f, \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u043f\u0435\u0440\u044b\u044f\u0434 \u043f\u0430\u043c\u0456\u0436 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0456 \u0446\u0435\u043c\u0440\u0430\u0439, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0435. \u0421\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0441\u0442\u0430\u043d\u0435 \u0434\u043d\u0451\u043c \u0443 \u043f\u043e\u045e\u043d\u0456, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e \u0456\u043c \u0443\u0436\u043e \u0446\u0435\u043d\u044e \u0433\u0440\u0430\u0445\u0443. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0434\u043d\u0451\u043c \u0443 \u043f\u043e\u045e\u043d\u0456, \u043a\u0430\u043b\u0456 \u0437\u0430\u044f\u0441\u043d\u0435\u0435 \u045e\u0441\u0451\u0439 \u043c\u043e\u0446\u0430\u044e \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430. \u0410\u0431 \u0442\u044b\u043c, \u0448\u0442\u043e \u0437\u0430\u0440\u0430\u043d\u043a\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u0442\u043e \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u045e\u0441\u0442\u0430\u0435, \u0432\u0435\u043b\u044c\u043c\u0456 \u0441\u043b\u0443\u0448\u043d\u0430 \u0433\u0430\u0432\u043e\u0440\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u044b: &laquo;\u0422\u044b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u045e \u0437\u0430\u0440\u0430\u043d\u0456\u0446\u044b \u043c\u0435\u0441\u0446\u0430&raquo; (\u0401\u045e 38, 12). \u0412\u044b\u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434\u043b\u044f \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u043c\u0435\u0441\u0446\u0430, \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u043c\u0435\u0441\u0446\u0430 \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u0435. \u0428\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u0435\u0441\u0446\u0430\u043c \u0437\u0430\u0440\u0430\u043d\u043a\u0456, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u043b\u044f\u0441\u043a \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u045e\u0433\u043b\u044f\u0434\u0430\u043d\u043d\u044f? \u041a\u0430\u043b\u0456 \u044f\u043d\u0430 \u0442\u0430\u043c \u0430\u043f\u044b\u043d\u0435\u0446\u0446\u0430, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e \u0451\u0439 \u043d\u0456\u0447\u043e\u0433\u0430 \u0441\u0430 \u0437\u043c\u0440\u043e\u043a\u0443 \u043d\u043e\u0447\u044b, \u044f\u043a\u0430\u044f \u043f\u0440\u0430\u043c\u0456\u043d\u0443\u043b\u0430. \u041c\u0435\u0441\u0446\u0430, \u043a\u0443\u0434\u044b \u0456\u0434\u0437\u0435 \u0437\u0430\u0440\u0430\u043d\u043a\u0430, \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442\u0430\u043c \u0443 \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u0414\u0443\u0448\u0430 \u043c\u0430\u044f \u043f\u0440\u0430\u0433\u043d\u0435 \u0411\u043e\u0433\u0430, \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u044f \u043f\u0440\u044b\u0439\u0434\u0443 \u0456 \u0437&rsquo;\u044f\u045e\u043b\u044e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0436\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c&raquo; (\u041f\u0441 42 [41], 2).<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u0430\u0435, \u0432\u044f\u0434\u043e\u043c\u0430\u0435 \u0451\u0439 \u043c\u0435\u0441\u0446\u0430, \u0441\u043f\u044f\u0448\u0430\u0435\u0446\u0446\u0430 \u0437\u0430\u0440\u0430\u043d\u043a\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u043c\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0456 \u0431\u044b\u0446\u044c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0456 \u044f\u0448\u0447\u044d: &laquo;\u0414\u043b\u044f \u043c\u044f\u043d\u0435 \u0436\u044b\u0446\u0446\u0451 &ndash; \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u0441\u043c\u0435\u0440\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u0432\u044b\u0433\u0430\u0434\u0430&raquo; (\u0424\u043b\u043f 1, 21).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0424\u043b\u043f 1, 3. 6. 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0437\u044f\u043a\u0443\u044e \u0411\u043e\u0433\u0443 \u043c\u0430\u0439\u043c\u0443 \u043f\u0440\u044b \u043a\u043e\u0436\u043d\u0430\u0439 \u0437\u0433\u0430\u0434\u0446\u044b \u043f\u0440\u0430 \u0432\u0430\u0441. <span style=\"color: #ff0000;\">*<\/span> \u0423\u043f\u044d\u045e\u043d\u0435\u043d\u044b, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0447\u0430\u045e \u0443 \u0432\u0430\u0441 \u0434\u043e\u0431\u0440\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443, \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u0446\u044c \u044f\u0435 \u0434\u0430 \u0434\u043d\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u0430\u043b\u044e\u0441\u044f \u0437\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u043b\u044e\u0431\u043e\u045e \u0432\u0430\u0448\u0430\u044f \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043b\u0430 \u045e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456 \u0456 \u0432\u0430 \u045e\u0441\u044f\u043a\u0456\u043c \u0430\u0434\u0447\u0443\u0432\u0430\u043d\u043d\u0456. \u041d. \u0423\u043f\u044d\u045e\u043d\u0435\u043d\u044b, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0447\u0430\u045e \u0443 \u0432\u0430\u0441 \u0434\u043e\u0431\u0440\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443, \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u0446\u044c \u044f\u0435 \u0434\u0430 \u0434\u043d\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"96","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0422\u0440\u0430\u043a\u0442\u0430\u0442&raquo; \u0411\u0430\u043b\u0434\u0443\u0456\u043d\u0430 \u041a\u0430\u043d\u0442\u044d\u0440\u0431\u0435\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 6: PL 204, 466-467)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u043d \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u0434\u0443\u043c\u043a\u0456 \u0456 \u043d\u0430\u043c\u0435\u0440\u044b \u0441\u044d\u0440\u0446\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0432\u0435\u0434\u0430\u0435 \u0434\u0443\u043c\u043a\u0456 \u0456 \u043d\u0430\u043c\u0435\u0440\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430. \u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0432\u0435\u0434\u0430\u0435 \u0456\u0445 \u0443\u0441\u0435. \u041c\u044b \u0436 \u0432\u0435\u0434\u0430\u0435\u043c \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u043d\u0430\u043c \u043f\u0430\u0437\u043d\u0430\u0446\u044c, \u0434\u0430\u044e\u0447\u044b \u043b\u0430\u0441\u043a\u0443 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f. \u0411\u043e \u043d\u0435 \u045e\u0441\u0451, \u0448\u0442\u043e \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u0432\u0435\u0434\u0430\u0435 \u044f\u0433\u043e \u0434\u0443\u0445; \u043f\u0440\u0430\u0437 \u0434\u0430\u0431\u0440\u0430\u0432\u043e\u043b\u044c\u043d\u044b\u044f \u0456 \u0437\u043c\u0443\u0448\u0430\u043d\u044b\u044f \u0434\u0443\u043c\u043a\u0456 \u0451\u043d \u0444\u0430\u0440\u043c\u0456\u0440\u0443\u0435 \u043f\u043e\u0433\u043b\u044f\u0434, \u044f\u043a\u0456 \u043d\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u0456. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435 \u0432\u0430\u0447\u044b\u043c\u0430 \u0446\u0435\u043b\u0430, \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u043d\u0435 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0430\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u043d\u044f \u0437\u0440\u043e\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0440\u044d\u0434\u043a\u0430 \u043d\u0430\u0448\u0430\u0435 \u045e\u044f\u045e\u043b\u0435\u043d\u043d\u0435, \u043d\u0435\u0439\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0430\u0431\u043e \u043d\u0430\u0432\u0430\u0442 \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u043b\u044c\u043d\u0456\u043a \u043f\u0430\u0434\u0441\u043e\u045e\u0432\u0430\u0435 \u043d\u0430\u043c \u0448\u0442\u043e\u0441\u044c\u0446\u0456, \u0448\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u0430\u0435 \u0432\u044b\u0433\u043b\u044f\u0434 \u0434\u0430\u0431\u0440\u0430, \u0430\u043b\u0435 \u045e \u0411\u043e\u0436\u044b\u0445 \u0432\u0430\u0447\u0430\u0445 \u043d\u0435 \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435 \u043d\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0430\u044f \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0446\u043d\u043e\u0446\u0435. \u0411\u043e \u0456\u0441\u043d\u0443\u044e\u0446\u044c \u0443\u044f\u045e\u043d\u044b\u044f \u0446\u043d\u043e\u0442\u044b \u0430\u0431\u043e \u0437\u0430\u0433\u0430\u043d\u044b, \u044f\u043a\u0456\u044f \u0437\u0432\u043e\u0434\u0437\u044f\u0446\u044c \u0441\u044d\u0440\u0446\u0430 \u0456 \u0430\u0448\u0443\u043a\u0432\u0430\u044e\u0446\u044c \u0440\u043e\u0437\u0443\u043c, \u0442\u0430\u043a \u0448\u0442\u043e \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u0432\u043e\u0431\u0440\u0430\u0437 \u0434\u0430\u0431\u0440\u0430 \u0451\u0441\u0446\u044c \u0443 \u0434\u0440\u044d\u043d\u043d\u0430\u0439 \u0440\u044d\u0447\u044b, \u0456 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0434\u0440\u044d\u043d\u043d\u0430\u044f \u0440\u044d\u0447 \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0435 \u043d\u0456\u0431\u044b \u0434\u0430\u0431\u0440\u043e. \u0413\u044d\u0442\u0430 \u0432\u044b\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0439 \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u0456 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u044f, \u043d\u0430\u0434 \u044f\u043a\u0456\u043c \u0442\u0440\u044d\u0431\u0430 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u0456 \u044f\u043a\u043e\u0433\u0430 \u0442\u0440\u044d\u0431\u0430 \u0432\u0435\u043b\u044c\u043c\u0456 \u0431\u0430\u044f\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0401\u0441\u0446\u044c \u0448\u043b\u044f\u0445\u0456, \u044f\u043a\u0456\u044f \u0437\u0434\u0430\u044e\u0446\u0446\u0430 \u043b\u044e\u0434\u0437\u044f\u043c \u0441\u043b\u0443\u0448\u043d\u044b\u043c\u0456, \u0430 \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456&raquo; (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f. 16, 25). \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u042f\u043d, \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u044e\u0447\u044b \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u043a\u043e\u0439 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430\u0439, \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u043d\u0430\u0441 \u0443 \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u041f\u0440\u0430\u0432\u044f\u0440\u0430\u0439\u0446\u0435 \u0434\u0443\u0445\u0430\u045e, \u0446\u0456 \u044f\u043d\u044b \u0430\u0434 \u0411\u043e\u0433\u0430&raquo; (1 \u042f\u043d 4, 1). \u0425\u0442\u043e \u0436 \u043c\u043e\u0436\u0430 \u0432\u044b\u0440\u0430\u0448\u044b\u0446\u044c, \u0446\u0456 \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u044f\u043d\u044b \u0430\u0434 \u0411\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0434\u0430\u0440\u0443 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0434\u0443\u0445\u0430\u045e, \u043a\u0430\u0431 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430 \u0456 \u043f\u0430\u0434\u0440\u0430\u0431\u044f\u0437\u043d\u0430 \u0430\u0446\u0430\u043d\u0456\u0446\u044c \u0434\u0443\u043c\u043a\u0456, \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0456 \u0456 \u043d\u0430\u043c\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0440 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f &minus; \u043c\u0430\u0446\u0456 \u045e\u0441\u0456\u0445 \u0446\u043d\u043e\u0442\u0430\u045e. \u0422\u0430\u043c\u0443 \u044f\u0433\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u043a\u043e\u0436\u043d\u044b \u044f\u043a \u0434\u043b\u044f \u043f\u0430\u0440\u0430\u0434\u0430\u045e \u0456\u043d\u0448\u044b\u043c, \u0442\u0430\u043a \u0456 \u0434\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u043a\u0456\u0440\u0430\u0432\u0430\u043d\u043d\u044f \u0456 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u043c\u043a\u0430 \u0430\u0431 \u0442\u044b\u043c, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0431\u0456\u0446\u044c, \u0441\u043b\u0443\u0448\u043d\u0430\u044f, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u0446\u0430 \u0432\u043e\u043b\u044f\u0439 \u0411\u043e\u0433\u0430. \u0406\u043d\u0442\u044d\u043d\u0446\u044b\u044f \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u043e\u0434\u043d\u0430\u0439 \u0456 \u0441\u0432\u044f\u0442\u043e\u0439 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0437 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u043e\u0439 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430. \u0423\u0441\u0451 \u043d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0456 \u043a\u043e\u0436\u043d\u044b \u0447\u044b\u043d \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u043a\u0430\u043b\u0456 \u0432\u043e\u043a\u0430 \u0431\u0443\u0434\u0437\u0435 \u0448\u043b\u044f\u0445\u0435\u0442\u043d\u044b\u043c \u0456 \u0448\u0447\u044b\u0440\u044b\u043c. \u0410 \u0441\u0442\u0430\u043d\u0435 \u0442\u0430\u043a\u0456\u043c \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043d\u0430\u043b\u0435\u0436\u043d\u0430\u043c\u0443 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044e \u0431\u0443\u0434\u0437\u0435 \u0432\u0435\u0434\u0430\u0446\u044c, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0431\u0456\u0446\u044c, \u0430, \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u044e\u0447\u044b \u045e \u043f\u0440\u0430\u0441\u0442\u0430\u0446\u0435 \u0456 \u0437 \u0434\u043e\u0431\u0440\u0430\u0439 \u0456\u043d\u0442\u044d\u043d\u0446\u044b\u044f\u0439, \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u0456. \u0420\u0430\u0437\u0443\u043c\u043d\u0430\u044f \u0440\u0430\u0437\u0432\u0430\u0433\u0430 \u043d\u0435 \u0434\u0430\u043f\u0443\u0441\u043a\u0430\u0435 \u043f\u0430\u043c\u044b\u043b\u0430\u043a, \u0430 \u0434\u043e\u0431\u0440\u0430\u044f \u0456\u043d\u0442\u044d\u043d\u0446\u044b\u044f \u0432\u044b\u043a\u043b\u044e\u0447\u0430\u0435 \u045e\u0434\u0430\u0432\u0430\u043d\u043d\u0435. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u0435, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0443 \u0440\u0430\u0437\u0432\u0430\u0437\u0435 \u0456 \u0434\u043e\u0431\u0440\u0430\u0439 \u0456\u043d\u0442\u044d\u043d\u0446\u044b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u045e\u0441\u0451 \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0431\u0456\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u043b\u0435 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f, \u044f\u043a \u0431\u044b \u045e \u0441\u0430\u043c\u0456\u043c \u0411\u043e\u0433\u0443 \u0456 \u043f\u0430\u0434 \u0432\u043e\u043a\u0430\u043c \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0456\u0445 6, 8; \u041f\u0441 37 (36), 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041e \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0434\u0430\u0431\u0440\u043e\u043c, \u0456 \u0447\u0430\u0433\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0446\u044f\u0431\u0435 \u041f\u0430\u043d: <span style=\"color: #ff0000;\">*<\/span> \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u043b\u044e\u0431\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u0430 \u0445\u0430\u0434\u0437\u0456 \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u0411\u043e\u0433\u0430\u043c. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0439\u0441\u044f \u043d\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0447\u044b\u043d\u0456 \u0434\u0430\u0431\u0440\u043e; \u0436\u044b\u0432\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0441\u0442\u0443\u043f\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u043b\u044e\u0431\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u0430 \u0445\u0430\u0434\u0437\u0456 \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u0411\u043e\u0433\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"97","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432. \u042f\u043d\u0430&raquo; <br \/>\u0441\u0432. \u0422\u0430\u043c\u0430\u0448\u0430 \u0410\u043a\u0432\u0456\u043d\u0441\u043a\u0430\u0433\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(\u0421\u0430\u0440. 14, lect. 2)<\/span><br \/><span style=\"color: #ff0000;\">\u0414\u0430\u0440\u043e\u0433\u0430 \u0434\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0440\u043e\u0433\u0430\u0439 \u0451\u0441\u0446\u044c \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0456 \u0442\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: &laquo;\u042f &ndash; \u0434\u0430\u0440\u043e\u0433\u0430&raquo; (\u042f\u043d 14, 6). \u0413\u044d\u0442\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0442\u0430\u043a, \u0431\u043e &laquo;\u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u043c\u044b \u043c\u0430\u0435\u043c \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u0430 \u0410\u0439\u0446\u0430&raquo; (\u042d\u0444 2, 18).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430\u044f \u0434\u0430\u0440\u043e\u0433\u0430 \u043d\u0435 \u0430\u0434\u0434\u0437\u0435\u043b\u0435\u043d\u0430 \u0430\u0434 \u043c\u044d\u0442\u044b, \u0430 \u043d\u0430\u0432\u0430\u0442 \u0437\u043b\u0443\u0447\u0430\u043d\u0430 \u0437 \u0451\u0439, \u0442\u0430\u043c\u0443 \u0434\u0430\u0434\u0430\u0435: &laquo;&hellip; \u0456 \u043f\u0440\u0430\u045e\u0434\u0430, \u0456 \u0436\u044b\u0446\u0446\u0451&raquo;. \u041f\u0430\u043d &minus; \u0433\u044d\u0442\u0430 \u0434\u0430\u0440\u043e\u0433\u0430 \u0456 \u043c\u044d\u0442\u0430 \u0434\u0430\u0440\u043e\u0433\u0456. \u042f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0430\u0440\u043e\u0433\u0430\u0439, \u044f\u043a \u0411\u043e\u0433 &minus; \u043c\u044d\u0442\u0430\u044e. \u0410\u0434\u0437\u0456\u043d \u0456 \u0434\u0440\u0443\u0433\u0456 \u0432\u044b\u0440\u0430\u0437 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430 \u0430\u043a\u0440\u044d\u0441\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u043c\u044d\u0442\u0443 \u0434\u0430\u0440\u043e\u0433\u0456. \u041c\u044d\u0442\u0430\u044e \u0434\u0430\u0440\u043e\u0433\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e. \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0440\u0430\u0433\u043d\u0435 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0434\u0437\u0432\u044e\u0445 \u0440\u044d\u0447\u0430\u045e: \u043d\u0430\u0439\u043f\u0435\u0440\u0448, \u0448\u0442\u043e \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u043c\u0443, \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u045e\u0434\u044b; \u043f\u0430-\u0434\u0440\u0443\u0433\u043e\u0435, \u0448\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u044b\u043c \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e, \u043f\u0440\u0430\u0446\u044f\u0433 \u0441\u0432\u0430\u0439\u0433\u043e \u0456\u0441\u043d\u0432\u0430\u043d\u043d\u044f. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0430\u0440\u043e\u0433\u0430\u0439 \u0434\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u045e\u0434\u044b, \u0431\u043e \u0441\u0430\u043c \u0451\u0441\u0446\u044c \u041f\u0440\u0430\u045e\u0434\u0430\u0439: &laquo;\u041d\u0430\u0432\u0443\u0447\u044b \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435, \u0448\u043b\u044f\u0445\u0443 \u0422\u0432\u0430\u0439\u043c\u0443, \u043a\u0430\u0431 \u0445\u0430\u0434\u0437\u0456\u045e \u044f \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0422\u0432\u0430\u0451\u0439&raquo; (\u041f\u0441 86 [85], 11). \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430\u0440\u043e\u0433\u0430\u0439, \u044f\u043a\u0430\u044f \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f: &laquo;\u0422\u044b \u0434\u0430\u045e \u043c\u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0434\u0430\u0440\u043e\u0433\u0443 \u0436\u044b\u0446\u0446\u044f&raquo; (\u041f\u0441 16 [15], 11 Vlg).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043c\u044d\u0442\u0443 \u0434\u0430\u0440\u043e\u0433\u0456 \u043d\u0430\u0437\u0432\u0430\u045e &laquo;\u043f\u0440\u0430\u045e\u0434\u0430\u0439 \u0456 \u0436\u044b\u0446\u0446\u0451\u043c&raquo;. \u0425\u0440\u044b\u0441\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0456 \u0430\u0434\u043d\u044b\u043c \u0456 \u0434\u0440\u0443\u0433\u0456\u043c. \u041f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0401\u043d &ndash; \u0436\u044b\u0446\u0446\u0451: &laquo;\u0423 \u0406\u043c \u0431\u044b\u043b\u043e \u0436\u044b\u0446\u0446\u0451&raquo;. \u0417&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u045e\u0434\u0430\u0439, \u0431\u043e &laquo;\u0436\u044b\u0446\u0446\u0451 \u0431\u044b\u043b\u043e \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u043b\u044e\u0434\u0437\u0435\u0439&raquo; (\u042f\u043d 1, 4).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u044b \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0435\u0448\u0441\u044f, \u043a\u0443\u0434\u044b \u0456\u0441\u0446\u0456, \u0442\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u043e \u0401\u043d &minus;\u0434\u0430\u0440\u043e\u0433\u0430: &laquo;\u0413\u044d\u0442\u0430 \u0434\u0430\u0440\u043e\u0433\u0430, \u0456\u0434\u0437\u0456\u0446\u0435 \u043f\u0430 \u0451\u0439&raquo; (\u0406\u0441 30, 21). \u0410 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d \u043a\u0430\u0436\u0430: &laquo;\u0406\u0434\u0437\u0456 \u043f\u0440\u0430\u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 &minus; \u0456 \u0434\u043e\u0439\u0434\u0437\u0435\u0448 \u0434\u0430 \u0411\u043e\u0433\u0430&raquo;. \u041b\u0435\u043f\u0448 \u0456\u0441\u0446\u0456 \u0441\u043b\u0443\u0448\u043d\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u0439, \u0441\u043f\u0430\u0442\u044b\u043a\u0430\u044e\u0447\u044b\u0441\u044f, \u0447\u044b\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u043c\u0456 \u043a\u0440\u043e\u043a\u0430\u043c\u0456 \u0431\u043b\u0443\u043a\u0430\u0446\u044c \u043f\u0430 \u0431\u0435\u0437\u0434\u0430\u0440\u043e\u0436\u0436\u044b. \u0425\u0442\u043e \u043a\u0443\u043b\u044c\u0433\u0430\u0435 \u043d\u0430 \u0441\u043b\u0443\u0448\u043d\u0430\u0439 \u0434\u0430\u0440\u043e\u0437\u0435, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0456\u0434\u0437\u0435 \u043f\u0430\u0432\u043e\u043b\u0456, \u0430\u043b\u0435 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u043c\u044d\u0442\u044b. \u0425\u0442\u043e \u0436 \u0431\u043b\u0443\u043a\u0430\u0435 \u043f\u0430 \u0431\u0435\u0437\u0434\u0430\u0440\u043e\u0436\u0436\u044b, \u0447\u044b\u043c \u0445\u0443\u0442\u0447\u044d\u0439 \u0456\u0434\u0437\u0435, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u0434\u0430\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434 \u043c\u044d\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0435\u0448\u0441\u044f, \u043a\u0443\u0434\u044b \u0456\u0441\u0446\u0456, \u0437&rsquo;\u044f\u0434\u043d\u0430\u0439\u0441\u044f \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0431\u043e \u0401\u043d &minus; \u043f\u0440\u0430\u045e\u0434\u0430, \u044f\u043a\u043e\u0439 \u0442\u044b \u0445\u043e\u0447\u0430\u0448 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c: &laquo;\u041c\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u0422\u0432\u0430\u044e \u043f\u0440\u0430\u045e\u0434\u0443&raquo; (\u041f\u0440\u044b\u043f 8, 7). \u041a\u0430\u043b\u0456 \u0442\u044b \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0435\u0448\u0441\u044f, \u044f\u043a \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u0446\u044c \u0441\u0432\u0430\u0451 \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u0435, \u0437&rsquo;\u044f\u0434\u043d\u0430\u0439\u0441\u044f \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0431\u043e \u0401\u043d &minus; \u0436\u044b\u0446\u0446\u0451: &laquo;\u0425\u0442\u043e \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u041c\u044f\u043d\u0435, \u0442\u043e\u0439 \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u0436\u044b\u0446\u0446\u0451 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0430\u0434 \u041f\u0430\u043d\u0430&raquo; (\u041f\u0440\u044b\u043f 8, 35).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448 \u0431\u044b\u0446\u044c \u0443 \u0431\u044f\u0441\u043f\u0435\u0446\u044b; \u0442\u0430\u0434\u044b \u043d\u0435 \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u0435\u0448, \u0431\u043e \u0401\u043d &minus; \u0434\u0430\u0440\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u0442\u044b\u044f, \u0445\u0442\u043e \u0437 \u0406\u043c, \u043d\u0435 \u0431\u043b\u0443\u043a\u0430\u044e\u0446\u044c, \u0430\u043b\u0435 \u0456\u0434\u0443\u0446\u044c \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u0439. \u041d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0430\u043c\u044b\u043b\u0456\u0446\u0446\u0430, \u0431\u043e \u0401\u043d &minus; \u043f\u0440\u0430\u045e\u0434\u0430 \u0456 \u0432\u0443\u0447\u044b\u0446\u044c \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u0411\u043e \u043a\u0430\u0436\u0430: &laquo;\u042f \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0456 \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0430 \u0441\u0432\u0435\u0442, \u043a\u0430\u0431 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0430\u0431 \u043f\u0440\u0430\u045e\u0434\u0437\u0435&raquo; (\u042f\u043d 18, 37). \u042f\u043d\u044b \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430\u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430, \u0431\u043e \u0401\u043d &minus; \u0436\u044b\u0446\u0446\u0451 \u0456 \u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043a\u0430\u0431 \u0432\u044b \u043c\u0435\u043b\u0456 \u0436\u044b\u0446\u0446\u0451 \u0456 \u043c\u0435\u043b\u0456 \u045e \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u0443&raquo; (\u042f\u043d 10, 10).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0401\u045e 42, 10b. 11ab. 12a; 1 \u041a\u0430\u0440 10, 13b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e \u041f\u0430\u043d \u0443\u0434\u0432\u0430\u044f \u045e\u0441\u0451, \u0448\u0442\u043e \u043c\u0435\u045e \u0401\u045e. \u0422\u0430\u0434\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u044f\u0433\u043e \u0431\u0440\u0430\u0442\u044b \u044f\u0433\u043e\u043d\u044b\u044f \u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u043b\u0456 \u044f\u0433\u043e. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u041f\u0430\u043d \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456 \u0401\u0432\u0430 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0432\u0435\u0440\u043d\u044b\u043c, \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u0432\u0430\u0441 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043c\u0430\u0435\u0446\u0435 \u0441\u0456\u043b\u044b, \u0430\u043b\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0434\u0430\u0441\u0446\u044c \u0456 \u0432\u044b\u0439\u0441\u0446\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u041f\u0430\u043d \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456 \u0401\u0432\u0430 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"101","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041b\u0456\u0441\u0442 \u0434\u0430 \u0420\u044b\u043c\u043b\u044f\u043d\u0430\u045e&raquo; \u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Inscriptio, 1, 1 &minus; 2, 2: Funk 1, 213-215)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0430\u0447\u0443 \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u043d\u0435 \u043b\u044e\u0434\u0437\u044f\u043c, \u0430 \u0411\u043e\u0433\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0406\u0433\u043d\u0430\u0446\u044b\u0439, \u044f\u043a\u043e\u0433\u0430 \u0437\u0432\u0430\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0422\u044d\u0430\u0444\u043e\u0440\u0430\u043c, &ndash; \u041a\u0430\u0441\u0446\u0451\u043b\u0443, \u044f\u043a\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u0430\u0441\u0446\u044b \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0410\u0439\u0446\u0430 \u0456 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u042f\u0433\u043e \u0421\u044b\u043d\u0430; \u041a\u0430\u0441\u0446\u0451\u043b\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u043c\u0443 \u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u0430\u043c\u0443 \u0432\u043e\u043b\u044f\u044e \u0442\u0430\u0433\u043e, \u044f\u043a\u0456 \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u043a\u0430\u0437\u0430\u043c \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0443\u0441\u0451 \u0434\u0430 \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0434\u0437\u0435\u043b\u044f \u0432\u0435\u0440\u044b \u0456 \u043b\u044e\u0431\u043e\u0432\u0456 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430; \u041a\u0430\u0441\u0446\u0451\u043b\u0443, \u044f\u043a\u0456 \u043c\u0430\u0435 \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u043e \u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043d\u0430 \u0442\u044d\u0440\u044b\u0442\u043e\u0440\u044b\u0456 \u0420\u044b\u043c\u0430, \u0433\u043e\u0434\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0430, \u0433\u043e\u0434\u043d\u0430\u043c\u0443 \u043f\u0430\u0448\u0430\u043d\u044b, \u0433\u043e\u0434\u043d\u0430\u043c\u0443 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u0446\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u043c, \u0433\u043e\u0434\u043d\u0430\u043c\u0443 \u0445\u0432\u0430\u043b\u044b, \u0430\u0436\u044b\u0446\u0446\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0441\u0432\u0430\u0456\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e, \u0433\u043e\u0434\u043d\u0430\u043c\u0443 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u044b; \u041a\u0430\u0441\u0446\u0451\u043b\u0443, \u044f\u043a\u0456 \u045e\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u0432\u0430\u0435 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0456 \u043c\u0430\u0435 \u0437\u0430\u043a\u043e\u043d \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b \u0456 \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0456\u043c\u0435\u043d\u0435\u043c \u0410\u0439\u0446\u0430; \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u0433\u044d\u0442\u0430\u043c\u0443 \u0448\u043b\u044e \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435 \u045e \u0456\u043c\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430. \u0423 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u043d\u0430\u0448\u044b\u043c \u0411\u043e\u0433\u0443, \u0437\u044b\u0447\u0443 \u0448\u0447\u043e\u0434\u0440\u0430\u0439 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u045e\u0441\u0456\u043c \u0442\u044b\u043c, \u0445\u0442\u043e \u0446\u0435\u043b\u0430\u043c \u0456 \u0434\u0443\u0445\u0430\u043c \u043f\u0440\u044b\u0445\u0456\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0411\u043e\u0436\u044b\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e, \u0445\u0442\u043e \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u043b\u0430\u0441\u043a\u0430\u0439 \u0411\u043e\u0433\u0430, \u0445\u0442\u043e \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e \u0441\u0432\u0430\u0456\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445 \u044f \u043f\u0440\u0430\u0441\u0456\u045e \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0401\u043d \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u043c\u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0432\u0430\u0448\u0430\u0435 \u0441\u0432\u044f\u0442\u043e\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u0456 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f \u0431\u044b\u045e \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u044b \u045e \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u0445, \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0432\u043e\u043b\u044f \u0411\u043e\u0433\u0430 \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u043c\u044f\u043d\u0435 \u0433\u043e\u0434\u043d\u044b\u043c \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u043c\u044d\u0442\u044b \u0456 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0432\u0430\u043c, \u0431\u0443\u0434\u0443\u0447\u044b \u0432\u044f\u0437\u043d\u0435\u043c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435. \u041f\u0430\u0447\u0430\u0442\u0430\u043a \u0431\u044b\u045e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0434\u043e\u0431\u0440\u044b\u043c. \u041a\u0430\u0431 \u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u0435\u045e \u043b\u0430\u0441\u043a\u0443 \u0431\u0435\u0437 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0441\u0432\u0430\u044e \u0447\u0430\u0441\u0442\u043a\u0443. \u0410\u0434\u043d\u0430\u043a \u0431\u0430\u044e\u0441\u044f, \u043a\u0430\u0431 \u0432\u0430\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u043d\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u043b\u0430 \u043c\u043d\u0435, \u0431\u043e \u0432\u0430\u043c \u043d\u044f\u0446\u044f\u0436\u043a\u0430 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0445\u043e\u0447\u0430\u0446\u0435, \u043c\u043d\u0435 \u0436 \u0432\u0435\u043b\u044c\u043c\u0456 \u043d\u044f\u043b\u0451\u0433\u043a\u0430 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u0432\u044b \u043d\u0435 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u0446\u0435 \u043c\u043d\u0435 \u0441\u0432\u0430\u044e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0445\u0430\u0447\u0443, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0456\u0441\u044f \u043d\u0435 \u043b\u044e\u0434\u0437\u044f\u043c, \u0430\u043b\u0435 \u0411\u043e\u0433\u0443. \u0414\u0430\u0440\u044d\u0447\u044b, \u0432\u044b \u0433\u044d\u0442\u0430 \u0456 \u0440\u043e\u0431\u0456\u0446\u0435. \u0428\u0442\u043e \u0434\u0430 \u043c\u044f\u043d\u0435, \u0442\u043e \u045e\u0436\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0432\u044b\u043f\u0430\u0434\u0437\u0435 \u043c\u043d\u0435 \u0442\u0430\u043a\u0430\u044f \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0432\u044b \u0441\u0432\u0430\u0456\u043c \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435\u043c \u043d\u0435 \u0437\u043c\u043e\u0436\u0430\u0446\u0435 \u043f\u0440\u044b\u0447\u044b\u043d\u0456\u0446\u0446\u0430 \u0434\u0430 \u043d\u0430\u0439\u0446\u0443\u0434\u043e\u045e\u043d\u0435\u0439\u0448\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b. \u041a\u0430\u043b\u0456 \u0436 \u0432\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u0435\u0446\u0435 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435 \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0431\u0430\u0440\u0430\u043d\u0456\u0446\u044c \u043c\u044f\u043d\u0435, \u044f \u0441\u0442\u0430\u043d\u0443 \u0441\u043b\u043e\u0432\u0430\u043c \u0411\u043e\u0433\u0430, \u0430 \u043a\u0430\u043b\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u0446\u0435 \u043c\u0430\u0451 \u0437\u044f\u043c\u043d\u043e\u0435 \u0436\u044b\u0446\u0446\u0451, \u044f \u0431\u0443\u0434\u0443 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c. \u041d\u0435 \u043c\u043e\u0436\u0430\u0446\u0435 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043c\u043d\u0435 \u043b\u0435\u043f\u0448\u0430\u0439 \u043f\u0430\u0441\u043b\u0443\u0433\u0456, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u043e\u0439, \u043a\u0430\u0431 \u044f \u0431\u044b\u045e \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u044b \u045e \u0430\u0445\u0432\u044f\u0440\u0443, \u0434\u044b \u0456 \u0430\u043b\u0442\u0430\u0440 \u0443\u0436\u043e \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b. \u0412\u044b \u0436, \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u043d\u0430 \u0445\u0432\u0430\u043b\u0443 \u0410\u0439\u0446\u0430 \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435, \u0448\u0442\u043e \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0421\u0456\u0440\u044b\u0456, \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0437 \u0423\u0441\u0445\u043e\u0434\u0443 \u043d\u0430 \u0417\u0430\u0445\u0430\u0434. \u0413\u044d\u0442\u0430 \u043f\u0440\u044b\u0433\u043e\u0436\u0430, \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0443 \u0406\u043c \u0437\u043d\u043e\u045e \u043f\u0430\u045e\u0441\u0442\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0424\u043b\u043f 1, 21; \u0413\u0430\u043b 6, 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u043b\u044f \u043c\u044f\u043d\u0435 \u0436\u044b\u0446\u0446\u0451 &ndash; \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u0441\u043c\u0435\u0440\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u0432\u044b\u0433\u0430\u0434\u0430.<span style=\"color: #ff0000;\"> *<\/span> \u041d\u044f\u0445\u0430\u0439 \u043c\u043d\u0435 \u043d\u0435 \u0434\u0430\u0432\u044f\u0434\u0437\u0435\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0456\u0447\u044b\u043c, \u0430\u043a\u0440\u0430\u043c\u044f \u043a\u0440\u044b\u0436\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0441\u0432\u0435\u0442 \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0434\u043b\u044f \u043c\u044f\u043d\u0435, \u0430 \u044f \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u043c\u043d\u0435 \u043d\u0435 \u0434\u0430\u0432\u044f\u0434\u0437\u0435\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0456\u0447\u044b\u043c, \u0430\u043a\u0440\u0430\u043c\u044f \u043a\u0440\u044b\u0436\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"102","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041b\u0456\u0441\u0442 \u0434\u0430 \u0420\u044b\u043c\u043b\u044f\u043d\u0430\u045e&raquo; \u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(3, 1 &minus; 5, 3: Funk 1, 215-219)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0430\u0431 \u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u0456\u0447\u044b\u045e\u0441\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430\u043c, \u0430\u043b\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0456\u043c \u0431\u044b\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0432\u0430\u043b\u0456, \u0430\u043b\u0435 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u043b\u0456 \u0456\u043d\u0448\u044b\u0445. \u0422\u0430\u043c\u0443 \u0445\u0430\u0447\u0443, \u043a\u0430\u0431 \u0432\u0430\u0441 \u0430\u0431\u0430\u0432\u044f\u0437\u0432\u0430\u043b\u0430 \u0442\u043e\u0435, \u0447\u0430\u043c\u0443 \u0432\u044b \u043d\u0430\u0432\u0443\u0447\u0430\u0435\u0446\u0435 \u0456 \u0448\u0442\u043e \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0446\u0435. \u0414\u043b\u044f \u043c\u044f\u043d\u0435 \u043f\u0440\u0430\u0441\u0456\u0446\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0446\u044b \u0434\u0443\u0445\u0430 \u0456 \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u0430\u0432\u0430\u0440\u044b\u045e, \u0430\u043b\u0435 \u0456 \u0445\u0430\u0446\u0435\u045e, \u043a\u0430\u0431 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u0456\u0447\u044b\u045e\u0441\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430\u043c, \u0430\u043b\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0456\u043c \u0431\u044b\u045e. \u041a\u0430\u043b\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u0443\u0434\u0443 \u0456\u043c, \u0431\u0443\u0434\u0443 \u043c\u0435\u0446\u044c \u043f\u0440\u0430\u0432\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u0446\u0430 \u0456\u043c \u0456 \u0441\u0442\u0430\u0446\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0432\u0435\u0440\u043d\u044b\u043c, \u0431\u043e \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u044f\u043d\u0435 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435. \u0417 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u043d\u0430 \u0441\u0432\u0435\u0446\u0435, \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443 \u043f\u043e\u045e\u043d\u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0410\u0439\u0446\u0430. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0441\u0432\u0435\u0442 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u0442\u0432\u0430, \u0442\u043e \u0433\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u044f\u043d\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435 \u0432\u044b\u043d\u0456\u043a\u0430\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f, \u0430\u043b\u0435 \u0441\u043f\u0440\u0430\u0432\u0430\u044e \u0411\u043e\u0436\u0430\u0439 \u043c\u043e\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043f\u0456\u0448\u0443 \u045e\u0441\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0456 \u0430\u0431&rsquo;\u044f\u045e\u043b\u044f\u044e \u045e\u0441\u0456\u043c, \u0448\u0442\u043e \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0430\u043c\u0440\u0443 \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u0432\u044b \u043d\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u0446\u0435 \u043c\u043d\u0435 \u045e \u0433\u044d\u0442\u044b\u043c. \u041f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u043f\u0430\u045e\u0441\u0442\u0440\u044b\u043c\u0430\u0439\u0446\u0435\u0441\u044f \u0430\u0434 \u0437\u0430\u045e\u0447\u0430\u0441\u043d\u0430\u0439 \u0441\u043f\u0430\u0433\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0414\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u043c\u043d\u0435 \u0441\u0442\u0430\u0446\u044c \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0430\u043c \u0434\u043b\u044f \u0434\u0437\u0456\u043a\u0456\u0445 \u0437\u0432\u044f\u0440\u043e\u045e, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u0456\u043c \u044f \u0434\u0430\u0439\u0434\u0443 \u0434\u0430 \u0411\u043e\u0433\u0430. \u042f &minus; \u0411\u043e\u0436\u0430\u044f \u043f\u0448\u0430\u043d\u0456\u0446\u0430. \u0411\u0443\u0434\u0443 \u0437\u043c\u0435\u043b\u0435\u043d\u044b \u0437\u0443\u0431\u0430\u043c\u0456 \u0434\u0437\u0456\u043a\u0456\u0445 \u0437\u0432\u044f\u0440\u043e\u045e, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u0447\u044b\u0441\u0442\u044b\u043c \u0445\u043b\u0435\u0431\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u0435\u043f\u0448 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0439\u0446\u0435 \u0437\u0432\u044f\u0440\u043e\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u043c\u0430\u0451\u0439 \u043c\u0430\u0433\u0456\u043b\u0430\u0439 \u0456 \u043a\u0430\u0431 \u0430\u0434 \u043c\u044f\u043d\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f, \u043a\u0430\u0431 \u043d\u0456\u043a\u043e\u043c\u0443 \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u044f \u043d\u0435 \u043d\u0430\u0440\u0430\u0431\u0456\u045e \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u045e. \u041a\u0430\u043b\u0456 \u0441\u0432\u0435\u0442 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u043c\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430, \u0442\u0430\u0434\u044b \u0431\u0443\u0434\u0443 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0432\u0443\u0447\u043d\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430. \u041f\u0440\u0430\u0441\u0456\u0446\u0435 \u0437\u0430 \u043c\u044f\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u044b\u0445 \u0437\u0432\u044f\u0440\u043e\u045e \u044f \u0441\u0442\u0430\u045e \u0430\u0445\u0432\u044f\u0440\u043d\u044b\u043c \u0434\u0430\u0440\u0430\u043c \u0434\u043b\u044f \u0411\u043e\u0433\u0430. \u042f \u043d\u0435 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u044e \u0432\u0430\u043c \u044f\u043a \u041f\u0451\u0442\u0440 \u0456 \u041f\u0430\u0432\u0435\u043b. \u042f\u043d\u044b \u0431\u044b\u043b\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u0430 \u044f \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b; \u044f\u043d\u044b \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u044f, \u044f \u0430\u0436 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a. \u041a\u0430\u043b\u0456, \u0430\u0434\u043d\u0430\u043a, \u044f \u0432\u044b\u0446\u044f\u0440\u043f\u043b\u044e \u0443\u0441\u0451, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043c\u044f\u043d\u0435, \u0456 \u045e \u0406\u043c \u044f \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443 \u045e\u0436\u043e \u044f\u043a \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430, \u0431\u0443\u0434\u0443\u0447\u044b \u045e \u043a\u0430\u0439\u0434\u0430\u043d\u0430\u0445, \u044f \u0430\u0434\u0432\u044b\u043a\u0430\u044e \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u0447\u0430\u0433\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0421\u0456\u0440\u044b\u0456 \u0430\u0436 \u0434\u0430 \u0420\u044b\u043c\u0430 &laquo;\u044f \u0437\u043c\u0430\u0433\u0430\u044e\u0441\u044f \u0437 \u0434\u0437\u0456\u043a\u0456\u043c\u0456 \u0437\u0432\u044f\u0440\u0430\u043c\u0456&raquo;, \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u043d\u0430 \u043c\u043e\u0440\u044b, \u0443\u0434\u0437\u0435\u043d\u044c \u0456 \u045e\u043d\u0430\u0447\u044b, \u043f\u0440\u044b\u0432\u044f\u0437\u0430\u043d\u044b \u0434\u0430 \u0434\u0437\u0435\u0441\u044f\u0446\u0456 \u043b\u0435\u0430\u043f\u0430\u0440\u0434\u0430\u045e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434\u0430 \u0430\u0434\u0434\u0437\u0435\u043b\u0443 \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u045e, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u044f\u0448\u0447\u044d \u0433\u043e\u0440\u0448\u044b\u043c\u0456, \u043a\u0430\u043b\u0456 \u0456\u043c \u0447\u044b\u043d\u044f\u0446\u044c \u0434\u0430\u0431\u0440\u043e. \u0417\u043d\u0435\u0441\u0435\u043d\u044b\u044f \u0430\u0434 \u0456\u0445 \u043a\u0440\u044b\u045e\u0434\u044b \u0440\u043e\u0431\u044f\u0446\u044c \u043c\u044f\u043d\u0435 \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u0430\u043b\u0435 \u0433\u044d\u0442\u0430 \u043c\u044f\u043d\u0435 \u044f\u0448\u0447\u044d \u043d\u0435 \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435. \u041e, \u043a\u0430\u0431 \u043c\u043d\u0435 \u045e\u0436\u043e \u0430\u043f\u044b\u043d\u0443\u0446\u0446\u0430 \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u0445 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0437\u0432\u044f\u0440\u043e\u045e. \u041e, \u043a\u0430\u0431 \u044f\u043d\u044b \u0445\u0443\u0442\u043a\u0430 \u043a\u0456\u043d\u0443\u043b\u0456\u0441\u044f \u043d\u0430 \u043c\u044f\u043d\u0435. \u042f \u0431\u0443\u0434\u0443 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0446\u044c \u0456\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u0430\u0434\u0440\u0430\u0437\u0443 \u0436 \u043c\u044f\u043d\u0435 \u043f\u0430\u0436\u044d\u0440\u043b\u0456, \u0430 \u043d\u0435 \u044f\u043a \u0456\u043d\u0448\u044b\u0445, \u0434\u0430 \u044f\u043a\u0456\u0445 \u044f\u043d\u044b \u043d\u0435 \u0430\u0441\u043c\u0435\u043b\u0456\u043b\u0456\u0441\u044f \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u0446\u0446\u0430. \u041a\u0430\u043b\u0456 \u0436 \u044f\u043d\u044b \u043d\u0435 \u0437\u0430\u0445\u043e\u0447\u0443\u0446\u044c, \u043f\u0440\u044b\u043c\u0443\u0448\u0443 \u0456\u0445. \u0414\u0430\u0440\u0443\u0439\u0446\u0435 \u043c\u043d\u0435, \u0430\u043b\u0435 \u044f \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043a\u0430\u0440\u044b\u0441\u043d\u0430. \u0412\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440 \u044f \u043f\u0430\u0447\u044b\u043d\u0430\u044e \u0431\u044b\u0446\u044c \u0432\u0443\u0447\u043d\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u044f \u0456\u0441\u0442\u043e\u0442\u0430, \u044f\u043a \u0431\u0430\u0447\u043d\u0430\u044f, \u0442\u0430\u043a \u0456 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u044f, \u043d\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u0435 \u043c\u043d\u0435 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041d\u044f\u0445\u0430\u0439 \u0441\u043f\u0430\u0437\u043d\u0430\u044e \u044f \u043c\u0443\u0447\u044d\u043d\u043d\u0435 \u0430\u0433\u043d\u0451\u043c, \u043c\u0443\u043a\u0443 \u043a\u0440\u044b\u0436\u0430, \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0443 \u0437 \u0434\u0437\u0456\u043a\u0456\u043c\u0456 \u0437\u0432\u044f\u0440\u0430\u043c\u0456, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443 \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u043d\u044b \u0456\u043c\u0456, \u043d\u044f\u0445\u0430\u0439 \u0437\u043b\u0430\u043c\u0430\u044e\u0446\u044c \u043c\u043d\u0435 \u043a\u043e\u0441\u0442\u043a\u0456, \u0430\u0434\u0440\u0430\u0437\u0430\u044e\u0446\u044c \u0447\u043b\u0435\u043d\u044b, \u0437\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u0446\u0435\u043b\u0430, \u043d\u044f\u0445\u0430\u0439 \u0441\u043f\u0430\u0437\u043d\u0430\u044e \u044f \u0441\u0430\u043c\u044b\u044f \u0441\u0442\u0440\u0430\u0448\u044d\u043d\u043d\u044b\u044f \u043f\u0430\u043a\u0443\u0442\u044b \u0437 \u0431\u043e\u043a\u0443 \u0441\u0430\u0442\u0430\u043d\u044b, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u043b\u0443\u0447\u044b\u0446\u0446\u0430 \u043c\u043d\u0435 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0430\u043b 2, 19. 20<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u0437 \u0417\u0430\u043a\u043e\u043d \u044f \u043f\u0430\u043c\u0451\u0440 \u0434\u043b\u044f \u0417\u0430\u043a\u043e\u043d\u0443, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0433\u0430. \u0410 \u0448\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u0436\u044b\u0432\u0443 \u045e \u0446\u0435\u043b\u0435, \u0442\u043e \u0436\u044b\u0432\u0443 \u0432\u0435\u0440\u0430\u044e \u045e \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043c\u044f\u043d\u0435. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u0406 \u045e\u0436\u043e \u043d\u0435 \u044f \u0436\u044b\u0432\u0443, \u0430 \u0436\u044b\u0432\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043c\u044f\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"103","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041b\u0456\u0441\u0442 \u0434\u0430 \u0420\u044b\u043c\u043b\u044f\u043d\u0430\u045e&raquo; \u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(6, 1 &minus; 9, 3: Funk 1, 219-223)<\/span><br \/><span style=\"color: #ff0000;\">\u041c\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0431\u044b\u043b\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043f\u0440\u044b\u0434\u0430\u0434\u0443\u0446\u0446\u0430 \u043c\u043d\u0435 \u0437\u044f\u043c\u043d\u044b\u044f \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u044b \u0441\u0432\u0435\u0442\u0443. \u041b\u0435\u043f\u0448 \u043c\u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0447\u044b\u043c \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0443\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0451\u0439. \u0428\u0443\u043a\u0430\u044e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u043d\u0430\u0441; \u043f\u0440\u0430\u0433\u043d\u0443 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441. \u0411\u043b\u0456\u0437\u043a\u0430\u0435 \u043c\u0430\u0451 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435. \u0412\u044b\u0431\u0430\u0447\u0430\u0439\u0446\u0435 \u043c\u043d\u0435, \u0431\u0440\u0430\u0442\u044b! \u041d\u0435 \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0439\u0446\u0435 \u0436\u044b\u0446\u044c, \u043d\u0435 \u0436\u0430\u0434\u0430\u0439\u0446\u0435, \u043a\u0430\u0431 \u044f \u043f\u0430\u043c\u0451\u0440. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436\u0430\u0434\u0430\u044e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0411\u043e\u0433\u0443, \u043d\u0435 \u0432\u044b\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u043c\u044f\u043d\u0435 \u0441\u0432\u0435\u0442\u0443 \u0456 \u043d\u0435 \u0437\u0432\u043e\u0434\u0437\u044c\u0446\u0435 \u0442\u044b\u043c, \u0448\u0442\u043e \u0437\u044f\u043c\u043d\u043e\u0435. \u0414\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u0446\u044c \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e. \u041a\u0430\u043b\u0456 \u0434\u0430\u0441\u044f\u0433\u043d\u0443 \u044f\u0433\u043e, \u0431\u0443\u0434\u0443 \u045e\u043f\u043e\u045e\u043d\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c. \u0414\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u043c\u043d\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u043c\u0443\u043a\u0443 \u043c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043c\u0430\u0435 \u042f\u0433\u043e \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435, \u0447\u0430\u0433\u043e \u044f \u0436\u0430\u0434\u0430\u044e, \u0430 \u0432\u0435\u0434\u0430\u044e\u0447\u044b \u043f\u0440\u044b\u0447\u044b\u043d\u0443 \u043c\u0430\u0439\u0433\u043e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f, \u0437\u043b\u0456\u0442\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043d\u044f\u0437\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0445\u043e\u0447\u0430 \u0432\u044b\u043a\u0440\u0430\u0441\u0446\u0456 \u043c\u044f\u043d\u0435 \u0456 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c \u043c\u0430\u0439\u043c\u0443 \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u044e \u0434\u0430 \u0411\u043e\u0433\u0430. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u0437 \u0432\u0430\u0441 \u043d\u0435 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u044f\u0433\u043e. \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0431\u043e\u043b\u044c\u0448 \u043d\u0430 \u043c\u0430\u0456\u043c \u0431\u0430\u043a\u0443, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043d\u0430 \u0431\u0430\u043a\u0443 \u0411\u043e\u0433\u0430. \u041d\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043f\u0440\u0430\u0433\u043d\u0435\u0446\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e \u0432\u0430\u0441 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456. \u041d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u0431 \u043f\u0440\u0430\u0441\u0456\u045e, \u0431\u0443\u0434\u0443\u0447\u044b \u045e \u0432\u0430\u0441, \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435; \u043f\u0430\u0432\u0435\u0440\u0446\u0435 \u043b\u0435\u043f\u0448 \u0442\u0430\u043c\u0443, \u043f\u0440\u0430 \u0448\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u043f\u0456\u0448\u0443 \u0432\u0430\u043c. \u0411\u043e \u043f\u0456\u0448\u0443, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0440\u044b \u0436\u044b\u0446\u0446\u0456, \u0430\u043b\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u0447\u044b \u0441\u043c\u0435\u0440\u0446\u0456. \u041c\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0431\u044b\u043b\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u044f, \u0456 \u043d\u044f\u043c\u0430 \u045e\u0436\u043e \u045e\u0432\u0430 \u043c\u043d\u0435 \u0437\u044f\u043c\u043d\u043e\u0439 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0422\u043e\u043b\u044c\u043a\u0456 \u0436\u044b\u0432\u0430\u044f \u0432\u0430\u0434\u0430 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0434\u0430 \u043c\u044f\u043d\u0435 \u0437 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0441\u044d\u0440\u0446\u0430 \u0456 \u043a\u0430\u0436\u0430: &laquo;\u0406\u0434\u0437\u0456 \u0434\u0430 \u0410\u0439\u0446\u0430&raquo;. \u041d\u0435 \u0440\u0430\u0434\u0443\u0435 \u043c\u044f\u043d\u0435 \u043d\u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a, \u043d\u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0435\u0442\u0443. \u041f\u0440\u0430\u0433\u043d\u0443 \u0411\u043e\u0436\u0430\u0433\u0430 \u0445\u043b\u0435\u0431\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0426\u0435\u043b\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437 \u0440\u043e\u0434\u0443 \u0414\u0430\u0432\u0456\u0434\u0430, \u0456 \u043d\u0430\u043f\u043e\u044e, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u042f\u0433\u043e \u041a\u0440\u043e\u045e &minus; \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0445\u0430\u0447\u0443 \u045e\u0436\u043e \u0431\u043e\u043b\u044c\u0448 \u0436\u044b\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0422\u0430\u043a \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0432\u044b \u0437\u0430\u0445\u043e\u0447\u0430\u0446\u0435. \u0423 \u0433\u044d\u0442\u044b\u0445 \u043a\u0430\u0440\u043e\u0442\u043a\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441: \u0432\u0435\u0440\u0446\u0435 \u043c\u043d\u0435, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0432\u0430\u043c \u0443\u0431\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u044f \u043a\u0430\u0436\u0443 \u0448\u0447\u044b\u0440\u0430. \u0413\u044d\u0442\u0430 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0432\u0443\u0441\u043d\u044b \u0410\u0439\u0446\u0435\u0446 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e. \u041c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u0437\u0430 \u043c\u044f\u043d\u0435, \u043a\u0430\u0431 \u044f \u0434\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u042f\u0433\u043e. \u042f \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0432\u0430\u043c, \u043a\u0456\u0440\u0443\u044e\u0447\u044b\u0441\u044f \u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435\u043c, \u0430\u043b\u0435 \u0411\u043e\u0436\u044b\u043c. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u0446\u044f\u0440\u043f\u0435\u0446\u044c, \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0430\u043a\u0430\u043c \u0432\u0430\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u043c\u044f\u043d\u0435, \u0430 \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b, \u0442\u043e \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0432\u0430\u0448\u0443\u044e \u043d\u0435\u043f\u0440\u044b\u044f\u0437\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445 \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0421\u0456\u0440\u044b\u0456, \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u044f\u043a\u043e\u0433\u0430 \u0437\u0430\u043c\u0435\u0441\u0442 \u043c\u044f\u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0430\u043c \u0411\u043e\u0433. \u0421\u0430\u043c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0431\u0443\u0434\u0437\u0435 \u0447\u0443\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0456\u043c \u044f\u043a \u0431\u0456\u0441\u043a\u0443\u043f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0430\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u045e. \u042f \u0430\u0434\u0447\u0443\u0432\u0430\u044e \u0441\u043e\u0440\u0430\u043c, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u0443 \u0434\u0430 \u044f\u0433\u043e, \u0431\u043e \u044f \u043d\u0435 \u0432\u0430\u0440\u0442\u044b \u0433\u044d\u0442\u0430\u0433\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0437 \u0443\u0441\u0456\u0445 \u044f \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u044b \u0456 \u0431\u044b\u0446\u0446\u0430\u043c &laquo;\u0432\u044b\u043a\u0456\u0434\u044b\u0448&raquo;. \u0410\u043b\u0435 \u043f\u0440\u0430\u0437 \u0411\u043e\u0436\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u044f \u0441\u0442\u0430\u043d\u0443 \u043a\u0456\u043c\u0441\u044c\u0446\u0456, \u043a\u0430\u043b\u0456 \u0434\u0430\u0439\u0434\u0443 \u0434\u0430 \u0411\u043e\u0433\u0430. \u0412\u0456\u0442\u0430\u0435 \u0432\u0430\u0441 \u043c\u043e\u0439 \u0434\u0443\u0445 \u0456 \u043b\u044e\u0431\u043e\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u045e, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043c\u044f\u043d\u0435 \u045e \u0456\u043c\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u043f\u0440\u044b \u0433\u044d\u0442\u044b\u043c \u043d\u0435 \u044f\u043a \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0433\u0430 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0430. \u041d\u0430\u0432\u0430\u0442 \u0442\u044b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u044b \u045e \u0430\u0441\u043e\u0431\u043d\u044b\u0445 \u0433\u0430\u0440\u0430\u0434\u0430\u0445, \u044f\u043a\u0456\u044f \u043d\u0435 \u0431\u044b\u043b\u0456 \u043d\u0430 \u043c\u0430\u0456\u043c \u0448\u043b\u044f\u0445\u0443, \u0447\u0430\u043a\u0430\u043b\u0456 \u043c\u044f\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 1, 24. 29<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0426\u044f\u043f\u0435\u0440 \u044f \u0440\u0430\u0434\u0443\u044e\u0441\u044f \u0437\u0430 \u0432\u0430\u0441 \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0434\u0430\u043f\u0430\u045e\u043d\u044f\u044e \u043d\u0435\u0434\u0430\u0445\u043e\u043f \u0443 \u043c\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u0430 \u042f\u0433\u043e\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u044f \u0456 \u043f\u0440\u0430\u0446\u0443\u044e, \u0437\u043c\u0430\u0433\u0430\u044e\u0447\u044b\u0441\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043c\u043e\u0446\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0430\u044f \u043c\u0430\u0433\u0443\u0442\u043d\u0430 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0434\u0430\u043f\u0430\u045e\u043d\u044f\u044e \u043d\u0435\u0434\u0430\u0445\u043e\u043f \u0443 \u043c\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u0430 \u042f\u0433\u043e\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b.<\/p>\r\n"}, {"GCH_CH_2_ID":"104","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430&raquo; \u0410\u0440\u044b\u0433\u0435\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 4, 1: PG 12, 842-843)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0430\u0445\u043e\u0434 \u043f\u0440\u0430\u0437 \u042f\u0440\u0434\u0430\u043d<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0432\u0451\u045e \u0411\u043e\u0436\u044b \u043d\u0430\u0440\u043e\u0434 \u043f\u0440\u0430\u0437 \u042f\u0440\u0434\u0430\u043d. \u0421\u0432\u044f\u0442\u0430\u0440\u044b \u0456 \u043b\u0435\u0432\u0456\u0442\u044b \u0441\u0442\u0430\u043b\u0456, \u0456 \u0432\u043e\u0434\u044b, \u0431\u044b\u0446\u0446\u0430\u043c \u0437 \u043f\u0430\u0448\u0430\u043d\u044b \u0434\u0430 \u0441\u043b\u0443\u0433\u0430\u045e \u0411\u043e\u0436\u044b\u0445, \u0441\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0441\u0432\u043e\u0439 \u0431\u0435\u0433, \u0441\u0442\u0430\u043b\u0456 \u0432\u0430\u043b\u0430\u043c \u0456 \u0430\u0434\u043a\u0440\u044b\u043b\u0456 \u0411\u043e\u0436\u0430\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b \u043f\u0440\u0430\u0445\u043e\u0434. \u041d\u0435 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u0439\u0441\u044f, \u043a\u0430\u043b\u0456 \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u0442\u0430\u0431\u0435, \u043e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d, \u043f\u0440\u0430 \u0433\u044d\u0442\u044b\u044f \u043f\u0430\u0434\u0437\u0435\u0456 \u0433\u0430\u0431\u0440\u044d\u0439\u0441\u043a\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443. \u0422\u0430\u0431\u0435, \u044f\u043a\u0456 \u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0446\u0435 \u0445\u0440\u043e\u0441\u0442\u0443 \u043f\u0440\u0430\u0439\u0448\u043e\u045e \u0445\u0432\u0430\u043b\u0456 \u042f\u0440\u0434\u0430\u043d\u0430, \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0430\u0431\u044f\u0446\u0430\u0435 \u0440\u044d\u0447\u044b \u043d\u0430\u043c\u043d\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448\u044b\u044f \u0456 \u0441\u0430\u043c\u044b\u044f \u045e\u0437\u043d\u0451\u0441\u043b\u044b\u044f; \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u0442\u0430\u0431\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u043d\u044f\u0431\u0451\u0441\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0448\u0442\u043e \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445: &laquo;\u041f\u0430\u0441\u043b\u044f \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u043d\u0430 \u0430\u0431\u043b\u043e\u043a\u0430\u0445 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u041f\u0430\u043d\u0443 \u0456 \u0433\u044d\u0442\u0430\u043a \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0437 \u041f\u0430\u043d\u0430\u043c&raquo; (\u043f\u0430\u0440. 1 \u0422\u044d\u0441 4, 17). \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0431\u0430\u0456\u0446\u0446\u0430, \u0431\u043e \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043d\u0430 \u044f\u0433\u043e\u043d\u044b\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u044f\u043a \u0411\u043e\u0433 \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0435 \u0430\u0431 \u0433\u044d\u0442\u044b\u043c \u043f\u0440\u0430\u0437 \u0432\u0443\u0441\u043d\u044b \u043f\u0440\u0430\u0440\u043e\u043a\u0430: &laquo;\u041a\u0430\u043b\u0456 \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u043f\u0440\u0430\u0437 \u0430\u0433\u043e\u043d\u044c, \u043d\u0435 \u0437\u0433\u0430\u0440\u044b\u0448, \u0431\u043e \u042f &minus; \u041f\u0430\u043d, \u0442\u0432\u043e\u0439 \u0411\u043e\u0433&raquo; (\u043f\u0430\u0440. \u0406\u0441 43, 2). \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e \u0441\u0432\u0430\u0456\u043c \u0434\u043e\u043c\u0435, \u0430 \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u044f\u043c\u0443. \u0410\u0434\u043d\u0430\u043a \u043d\u0435 \u0434\u0443\u043c\u0430\u0439, \u0448\u0442\u043e \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0430\u0434\u0431\u044b\u0432\u0430\u043b\u0430\u0441\u044f \u0434\u043b\u044f \u043d\u0430\u0448\u044b\u0445 \u0430\u0439\u0446\u043e\u045e, \u0430\u043b\u0435 \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u0442\u044b\u0447\u044b\u0446\u0446\u0430 \u043d\u0430\u0441. \u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0442\u0430\u0431\u0435. \u041a\u0430\u043b\u0456 \u043f\u0430\u043a\u0456\u043d\u0435\u0448 \u0446\u0435\u043c\u0440\u0443 \u0456\u0434\u0430\u043b\u0430\u043f\u0430\u043a\u043b\u043e\u043d\u0441\u0442\u0432\u0430 \u0456 \u0432\u044b\u0440\u0430\u0448\u044b\u0448 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0411\u043e\u0436\u044b \u0437\u0430\u043a\u043e\u043d, \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u0434\u044b \u043f\u0430\u0447\u043d\u0435\u0448 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0415\u0433\u0456\u043f\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u0442\u044b \u0431\u044b\u045e \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u044b \u0434\u0430 \u0448\u044d\u0440\u0430\u0433\u0443 \u043a\u0430\u0442\u044d\u0445\u0443\u043c\u044d\u043d\u0430\u045e \u0456 \u043f\u0430\u0447\u0430\u045e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u043d\u0430\u043a\u0430\u0437\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0442\u0430\u0434\u044b \u0442\u044b \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0435 \u043c\u043e\u0440\u0430. \u041a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0437\u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0448\u0441\u044f \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0456\u043c\u043a\u043d\u0435\u0448\u0441\u044f \u043f\u0430\u0447\u0443\u0446\u044c \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u044f\u043a\u043e\u0435 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0442\u0430\u0431\u0435 \u0445\u0432\u0430\u043b\u0430 \u041f\u0430\u043d\u0430. \u0410 \u043a\u0430\u043b\u0456 \u0442\u044b \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0456\u0448 \u0434\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0445\u0440\u043e\u0441\u0442\u0443 \u0456 \u045e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0456 \u043b\u0435\u0432\u0456\u0442\u0430\u045e \u0431\u0443\u0434\u0437\u0435\u0448 \u0443\u0432\u0435\u0434\u0437\u0435\u043d\u044b \u045e \u0433\u044d\u0442\u044b\u044f \u045e\u0437\u043d\u0451\u0441\u043b\u044b\u044f \u0456 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u0432\u044f\u0434\u043e\u043c\u044b\u044f \u0442\u044b\u043c, \u0445\u0442\u043e \u043c\u0430\u0435 \u043f\u0440\u0430\u0432\u0430 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0456\u0445, \u0442\u0430\u0434\u044b \u045e\u0432\u043e\u0439\u0434\u0437\u0435\u0448 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u044e \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0443 \u0410\u0431\u044f\u0446\u0430\u043d\u0443\u044e \u0437\u044f\u043c\u043b\u044e. \u0423 \u0451\u0439 \u0415\u0437\u0443\u0441 \u043f\u0440\u044b\u043c\u0430\u0435 \u043f\u0430\u0441\u043b\u044f \u041c\u0430\u0439\u0441\u0435\u044f \u0430\u043f\u0435\u043a\u0443 \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0442\u0432\u0430\u0456\u043c \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u043d\u0430 \u043d\u043e\u0432\u044b\u043c \u0448\u043b\u044f\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0436, \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u043c\u043d\u043e\u0433\u0456\u044f \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0411\u043e\u0436\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u043e\u0440\u0430 \u0440\u0430\u0437\u044b\u0448\u043b\u043e\u0441\u044f \u0434\u043b\u044f \u0446\u044f\u0431\u0435, \u0430 \u0440\u0430\u043a\u0430 \u0441\u043f\u044b\u043d\u0456\u043b\u0430 \u0441\u0432\u0430\u044e \u043f\u043b\u044b\u043d\u044c, \u0442\u0430\u0434\u044b \u0437\u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f \u0434\u0430 \u0456\u0445 \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0435\u0448: &laquo;\u0428\u0442\u043e \u0437 \u0442\u0430\u0431\u043e\u0439, \u043c\u043e\u0440\u0430, \u0448\u0442\u043e \u0442\u044b \u045e\u0446\u044f\u043a\u0430\u0435\u0448? \u0427\u0430\u043c\u0443, \u042f\u0440\u0434\u0430\u043d, \u0442\u044b \u043f\u0430\u0432\u044f\u0440\u043d\u0443\u045e \u043d\u0430\u0437\u0430\u0434? \u0413\u043e\u0440\u044b, \u0448\u0442\u043e \u0432\u044b \u0441\u043a\u0430\u0447\u0430\u0446\u0435, \u044f\u043a \u0430\u0432\u0435\u0447\u043a\u0456, \u0456 \u043d\u0456\u0431\u044b \u044f\u0433\u043d\u044f\u0442\u044b, \u043f\u0430\u0433\u043e\u0440\u043a\u0456?&raquo; \u0422\u0430\u0434\u044b \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0430\u0434\u043a\u0430\u0436\u0430 \u0442\u0430\u0431\u0435: &laquo;\u0414\u0440\u044b\u0436\u044b, \u0437\u044f\u043c\u043b\u044f, \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0411\u043e\u0433\u0430 \u042f\u043a\u0443\u0431\u0430, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u045e \u0441\u043a\u0430\u043b\u0443 \u045e \u0432\u043e\u0437\u0435\u0440\u0430 \u0432\u0430\u0434\u044b, \u0430 \u0446\u0432\u0451\u0440\u0434\u044b \u043a\u0430\u043c\u0435\u043d\u044c &ndash; \u0443 \u0432\u043e\u0434\u043d\u0443\u044e \u043a\u0440\u044b\u043d\u0456\u0446\u0443&raquo; (\u041f\u0441 114 [113\u0410], 5-8).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041c\u0434\u0440 17, 1\u0430; 19, 22\u0430; \u041f\u0441 77 (76), 20\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044f\u043b\u0456\u043a\u0456\u044f \u0422\u0432\u0430\u0435 \u0441\u0443\u0434\u044b, \u041f\u0430\u043d\u0435, \u0456 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043d\u044b\u044f. <span style=\"color: #ff0000;\">*<\/span> \u0422\u044b \u045e\u0437\u0432\u044b\u0441\u0456\u045e \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u0430\u0437 \u043c\u043e\u0440\u0430 \u0448\u043b\u044f\u0445 \u0422\u0432\u043e\u0439, \u0456 \u0422\u0432\u0430\u044f \u0441\u0446\u0435\u0436\u043a\u0430 \u043f\u0440\u0430\u0437 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0432\u043e\u0434\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u045e\u0437\u0432\u044b\u0441\u0456\u045e \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e.<\/p>\r\n"}, {"GCH_CH_2_ID":"105","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430&raquo; \u0410\u0440\u044b\u0433\u0435\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 6, 4: PG 12, 855-856)<\/span><br \/><span style=\"color: #ff0000;\">\u0417\u0434\u0430\u0431\u044b\u0432\u0430\u043d\u043d\u0435 \u0415\u0440\u044b\u0445\u043e\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0437\u044f\u0442\u044b \u045e \u0430\u0431\u043b\u043e\u0433\u0443 \u0415\u0440\u044b\u0445\u043e\u043d \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u043e\u0432\u0430 \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u0437\u0434\u0430\u0431\u044b\u0446\u044c. \u042f\u043a \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u043b\u0456 \u0415\u0440\u044b\u0445\u043e\u043d? \u041d\u0435 \u043f\u0430\u0434\u044b\u043c\u0430\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e \u043c\u044f\u0447\u0430, \u043d\u0435 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u043b\u0456 \u0430\u0441\u0430\u0434\u043d\u044b\u0445 \u043c\u0430\u0448\u044b\u043d, \u043d\u0435 \u043f\u0443\u0441\u043a\u0430\u043b\u0456 \u0441\u0442\u0440\u044d\u043b\u0430\u045e. \u0412\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0440\u0443\u0431\u044b \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e, \u0456 \u043d\u0430 \u0456\u0445 \u0433\u0443\u0447\u0430\u043d\u043d\u0435 \u0440\u0443\u0448\u0430\u0446\u0446\u0430 \u043c\u0443\u0440\u044b \u0415\u0440\u044b\u0445\u043e\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0421\u0432\u044f\u0442\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0456 \u0415\u0440\u044b\u0445\u043e\u043d \u0447\u0430\u0441\u0442\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0422\u0430\u043a, \u043d\u0430\u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u0443 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u045e \u0415\u0440\u044b\u0445\u043e\u043d \u0456 \u0442\u0440\u0430\u043f\u0456\u045e \u0443 \u0440\u0443\u043a\u0456 \u0440\u0430\u0437\u0431\u043e\u0439\u043d\u0456\u043a\u0430\u045e, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0410\u0434\u0430\u043c\u0430, \u0432\u044b\u0434\u0430\u043b\u0435\u043d\u0430\u0433\u0430 \u0437 \u0440\u0430\u044e \u0456 \u0432\u044b\u0433\u043d\u0430\u043d\u0430\u0433\u0430 \u045e \u0441\u0432\u0435\u0442. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043b\u044f\u043f\u044b\u044f \u0437 \u0415\u0440\u044b\u0445\u043e\u043d\u0430, \u0434\u0430 \u044f\u043a\u0456\u0445 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0415\u0437\u0443\u0441, \u043a\u0430\u0431 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u0456\u043c \u0437\u0440\u043e\u043a, \u0431\u044b\u043b\u0456 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u043b\u044e\u0434\u0437\u0435\u0439 \u0441\u0432\u0435\u0442\u0443, \u0448\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u045e \u0437\u043c\u0440\u043e\u043a\u0443 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u044f. \u0414\u044b\u043a \u0432\u043e\u0441\u044c, \u0415\u0440\u044b\u0445\u043e\u043d, \u0448\u0442\u043e \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0433\u044d\u0442\u044b \u0441\u0432\u0435\u0442, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u043d\u0430 \u0437\u0433\u0443\u0431\u0443. \u0414\u0430\u0440\u044d\u0447\u044b, \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435 \u0441\u0432\u0435\u0442\u0443 \u0437\u0434\u0430\u045e\u043d\u0430 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0430\u0441\u044f \u045e \u0421\u0432\u044f\u0442\u044b\u0445 \u041a\u043d\u0456\u0433\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0451\u043d \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b \u0456 \u0447\u044b\u043c? \u041d\u0430 \u0433\u0443\u043a \u0442\u0440\u0443\u0431\u044b &minus; \u043a\u0430\u0436\u0430 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435. \u042f\u043a\u043e\u0439 \u0442\u0440\u0443\u0431\u044b? \u041d\u044f\u0445\u0430\u0439 \u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0430\u0434\u043a\u0440\u044b\u0435 \u0442\u0430\u0431\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0448\u0442\u043e \u0451\u043d \u043a\u0430\u0436\u0430: &laquo;\u041d\u0430 \u0433\u0443\u043a \u0442\u0440\u0443\u0431\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u044f\u043a \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u044b\u044f, \u0431\u043e \u0441\u0430\u043c \u041f\u0430\u043d \u043d\u0430 \u0437\u0430\u043a\u043b\u0456\u043a \u0456 \u043d\u0430 \u0433\u043e\u043b\u0430\u0441 \u0430\u0440\u0445\u0430\u043d\u0451\u043b\u0430 \u0456 \u0442\u0440\u0443\u0431\u044b \u0411\u043e\u0436\u0430\u0439 \u0441\u044b\u0434\u0437\u0435 \u0437 \u043d\u0435\u0431\u0430&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 15, 52; 1 \u0422\u044d\u0441 4, 16). \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u0434\u044b \u043d\u0430 \u0433\u0443\u043a \u0442\u0440\u0443\u0431\u044b \u041f\u0430\u043d \u043d\u0430\u0448, \u0415\u0437\u0443\u0441, \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430 \u0415\u0440\u044b\u0445\u043e\u043d \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u044f\u0433\u043e \u0434\u0430\u0448\u0447\u044d\u043d\u0442\u0443, \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u0446\u0430 \u0437 \u0443\u0441\u0451\u0439 \u0441\u0432\u0430\u0451\u0439 \u0441\u044f\u043c&rsquo;\u0451\u0439 \u0443\u0440\u0430\u0442\u0443\u0435\u0446\u0446\u0430. \u041f\u0440\u044b\u0439\u0434\u0437\u0435, &ndash; \u043a\u0430\u0436\u0430, &ndash; \u043d\u0430\u0448 \u041f\u0430\u043d, \u0415\u0437\u0443\u0441, \u043f\u0440\u044b\u0431\u0443\u0434\u0437\u0435 \u043d\u0430 \u0433\u043e\u043b\u0430\u0441 \u0442\u0440\u0443\u0431\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0436\u0430 \u041f\u0430\u043d \u0443\u0440\u0430\u0442\u0443\u0435 \u0442\u0443\u044e, \u044f\u043a\u0430\u044f \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u042f\u0433\u043e \u0432\u044b\u0441\u043b\u0430\u043d\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0430\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043f\u0440\u044b\u043d\u044f\u0442\u044b\u0445 \u0437 \u0432\u0435\u0440\u0430\u044e \u0456 \u043b\u044e\u0431\u043e\u045e\u044e, \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0430 \u0432\u044b\u0441\u043e\u043a\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0434\u043e\u043c\u0435; \u043d\u044f\u0445\u0430\u0439 \u044f\u0435 \u0437\u043b\u0443\u0447\u044b\u0446\u044c \u0456 \u043d\u044f\u0445\u0430\u0439 \u0437&rsquo;\u044f\u0434\u043d\u0430\u0435 \u0437 \u0434\u043e\u043c\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0433\u0430\u0434\u0432\u0430\u0446\u044c \u044f\u0435 \u0440\u0430\u043d\u0435\u0439\u0448\u044b\u0445 \u043f\u0430\u043c\u044b\u043b\u0430\u043a \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u044f\u0435 \u0440\u0430\u043d\u0435\u0439\u0448\u044b\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e. \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0431\u044b\u043b\u0430 \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u0446\u0430\u0439, \u0430\u0434\u043d\u0430\u043a \u0446\u044f\u043f\u0435\u0440 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c, \u044f\u043a \u0447\u044b\u0441\u0442\u0430\u044f \u0434\u0437\u0435\u0432\u0430, \u0430\u0434\u043d\u0430\u043c\u0443 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0443, \u0425\u0440\u044b\u0441\u0442\u0443. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0448\u0442\u043e \u043f\u0440\u0430 \u044f\u0435 \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u042f \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0432\u0430\u0441, \u044f\u043a \u0447\u044b\u0441\u0442\u0443\u044e \u0434\u0437\u0435\u0432\u0443, \u0430\u0434\u043d\u0430\u043c\u0443 \u043c\u0443\u0436\u0443, \u0425\u0440\u044b\u0441\u0442\u0443&raquo;. \u0417 \u044f\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u043a\u0430\u0436\u0430: &laquo;\u0411\u043e \u0456 \u043c\u044b \u0431\u044b\u043b\u0456 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f, \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u044f, \u0437\u0432\u0435\u0434\u0437\u0435\u043d\u044b\u044f, \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0440\u043e\u0437\u043d\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u043c \u0456 \u045e\u0446\u0435\u0445\u0430\u043c&raquo; (\u043f\u0430\u0440. \u0426\u0456\u0442 3, 3).<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u0445\u043e\u0447\u0430\u0448 \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0433\u044d\u0442\u0430\u044f \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u0446\u0430 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0430 \u0451\u0439 \u0431\u044b\u0446\u044c? \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0441\u043b\u043e\u0432\u044b \u0441\u0432. \u041f\u0430\u045e\u043b\u0430: &laquo;\u0406 \u0442\u0430\u043a\u0456\u043c\u0456 \u0431\u044b\u043b\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u0432\u0430\u0441. \u0410\u043b\u0435 \u0432\u044b \u0430\u0431\u043c\u044b\u043b\u0456\u0441\u044f \u0456 \u0431\u044b\u043b\u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b\u044f \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 6, 11). \u041a\u0430\u0431 \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0443\u0446\u044c \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0415\u0440\u044b\u0445\u043e\u043d\u0430\u043c, \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0430\u0434 \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u043e\u045e \u043d\u0430\u0434\u0437\u0435\u0439\u043d\u044b \u0437\u043d\u0430\u043a \u0432\u044b\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f: \u0447\u044b\u0440\u0432\u043e\u043d\u0443\u044e \u0441\u0442\u0443\u0436\u043a\u0443. \u0422\u0430\u043a \u043f\u0440\u0430\u0437 \u041a\u0440\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u0431\u044b\u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u041f\u0430\u043d\u0443 \u043d\u0430\u0448\u044b\u043c, \u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 49, 22bc. 26cd; \u042f\u043d 8, 28\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c, \u042f \u043f\u0430\u0434\u044b\u043c\u0443 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u045e\u0437\u043d\u0456\u043c\u0443 \u0441\u0432\u043e\u0439 \u0441\u0446\u044f\u0433 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u043a\u043e\u0436\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d, \u0442\u0432\u043e\u0439 \u0417\u0431\u0430\u045e\u0446\u0430 \u0456 \u0442\u0432\u043e\u0439 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c, \u041c\u043e\u0446\u043d\u044b \u042f\u043a\u0443\u0431\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u045e\u0437\u0432\u044b\u0441\u0456\u0446\u0435 \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430, \u0442\u0430\u0434\u044b \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u042f \u0451\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u043a\u043e\u0436\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u0448\u0442\u043e \u042f &ndash; \u041f\u0430\u043d, \u0442\u0432\u043e\u0439 \u0417\u0431\u0430\u045e\u0446\u0430 \u0456 \u0442\u0432\u043e\u0439 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c, \u041c\u043e\u0446\u043d\u044b \u042f\u043a\u0443\u0431\u0430\u045e.<\/p>\r\n"}, {"GCH_CH_2_ID":"106","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 1, 4. 7-8: CSEL 64, 4-7)<\/span><br \/><span style=\"color: #ff0000;\">\u0426\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u041f\u0441\u0430\u043b\u044c\u043c\u0430\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u0443\u0441\u0451 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u0446\u0430 \u043b\u0430\u0441\u043a\u0430\u0439 \u0411\u043e\u0433\u0430, \u0430\u0434\u043d\u0430\u043a \u0443 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u043f\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u0446\u0430 \u0451\u0439 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u043a\u043d\u0456\u0433\u0430 \u041f\u0441\u0430\u043b\u044c\u043c\u0430\u045e. \u0421\u0430\u043c \u041c\u0430\u0439\u0441\u0435\u0439, \u044f\u043a\u0456 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u043c\u043e\u0432\u0430\u0439 \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u043d\u0430\u043c \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u044e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u043a\u0430\u043b\u0456 \u043d\u0435\u0437\u0430\u0431\u044b\u045e\u043d\u044b\u043c \u0456 \u0433\u043e\u0434\u043d\u044b\u043c \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0447\u044b\u043d\u0430\u043c \u043f\u0440\u0430\u0432\u0451\u045e \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u043f\u0440\u0430\u0437 \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0435 \u043c\u043e\u0440\u0430 \u0456 \u0431\u0430\u0447\u044b\u045e, \u044f\u043a \u0433\u0456\u043d\u0443\u045e \u0444\u0430\u0440\u0430\u043e\u043d \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0432\u043e\u0439\u0441\u043a\u0430\u043c, \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u045e \u0442\u0430\u0434\u044b \u0441\u0432\u0430\u0451\u0439 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 (\u0431\u043e \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0440\u044d\u0447\u044b, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043c\u043e\u0446) \u0456 \u043f\u0440\u0430\u0441\u043f\u044f\u0432\u0430\u045e \u0443 \u0433\u043e\u043d\u0430\u0440 \u041f\u0430\u043d\u0430 \u043f\u0435\u0441\u043d\u044e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u041c\u0456\u0440\u044b\u044f\u043c, \u0441\u044f\u0441\u0442\u0440\u0430 \u041c\u0430\u0439\u0441\u0435\u044f, \u0443\u0437\u044f\u045e\u0448\u044b \u0431\u0443\u0431\u0435\u043d, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043b\u0430 \u0441\u0432\u0430\u0456\u0445 \u0441\u044f\u0431\u0440\u043e\u0432\u0430\u043a, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0417\u0430\u0441\u043f\u044f\u0432\u0430\u0435\u043c \u0443 \u0433\u043e\u043d\u0430\u0440 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f; \u043a\u043e\u043d\u0435\u0439 \u0456 \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0430\u045e \u0441\u043a\u0456\u043d\u0443\u045e \u0443 \u043c\u0430\u0440\u0441\u043a\u0456\u044f \u0433\u043b\u044b\u0431\u0456\u043d\u0456&raquo; (\u0417\u044b\u0445 15, 21).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u0456\u0441\u0442\u043e\u0440\u044b\u044f \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0435, \u0437\u0430\u043a\u043e\u043d \u0432\u0443\u0447\u044b\u0446\u044c, \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435, \u043d\u0430\u043f\u0430\u043c\u0456\u043d \u0434\u0430\u043a\u0430\u0440\u0430\u0435, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0430\u043d\u043d\u0435 \u043f\u0430\u0431\u0443\u0434\u0436\u0430\u0435. \u0417 \u043a\u043d\u0456\u0433\u0456 \u041f\u0441\u0430\u043b\u044c\u043c\u0430\u045e \u043a\u043e\u0436\u043d\u044b \u043c\u043e\u0436\u0430 \u043c\u0435\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043b\u0435\u043a, \u0448\u0442\u043e \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0425\u0442\u043e \u0431 \u044f\u0435 \u043d\u0435 \u0447\u044b\u0442\u0430\u045e, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u043b\u0435\u043a, \u043a\u0430\u0431 \u043b\u0435\u043a\u0430\u0432\u0430\u0446\u044c \u0440\u0430\u043d\u044b, \u043d\u0430\u043d\u0435\u0441\u0435\u043d\u044b\u044f \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e. \u0425\u0442\u043e \u0431 \u043d\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u045e, \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u045e \u0451\u0439, \u043d\u0456\u0431\u044b \u043d\u0430 \u0434\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u043c \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0441\u0442\u0430\u0434\u044b\u0451\u043d\u0435, \u044f\u043a \u043d\u0430 \u0430\u0440\u044d\u043d\u0435 \u0446\u043d\u043e\u0442\u0430\u045e, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u0440\u043e\u0437\u043d\u044b\u044f \u0441\u043f\u043e\u0441\u0430\u0431\u044b \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f, \u043a\u0430\u0431 \u043c\u043e\u0433 \u0432\u044b\u0431\u0440\u0430\u0446\u044c, \u0448\u0442\u043e \u043f\u0430\u043b\u0456\u0447\u044b\u0446\u044c \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0456 \u0448\u0442\u043e \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0434\u0437\u0435\u0439\u0441\u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0436\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0441\u0442\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0456 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0447\u044b\u043d\u044b \u043f\u0440\u043e\u0434\u043a\u0430\u045e, \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0456\u0445 \u0441\u0430\u0431\u0440\u0430\u043d\u044b\u043c\u0456 \u045e \u0430\u0434\u043d\u044b\u043c \u043f\u0441\u0430\u043b\u044c\u043c\u0435; \u043f\u0440\u0430\u0437 \u043a\u0430\u0440\u043e\u0442\u043a\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435 \u0437\u0430\u0441\u0432\u043e\u0456\u0446\u044c \u0443\u0432\u0435\u0441\u044c \u0433\u044d\u0442\u044b \u0441\u043a\u0430\u0440\u0431 \u0443 \u043f\u0430\u043c\u044f\u0446\u0456. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0445\u043e\u0447\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043c\u043e\u0446 \u0437\u0430\u043a\u043e\u043d\u0443, \u044f\u043a\u0456 \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0431\u043e &laquo;\u043b\u044e\u0431\u043e\u045e \u043d\u0435 \u0447\u044b\u043d\u0456\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u043c\u0443 \u0437\u043b\u0430; \u043b\u044e\u0431\u043e\u045e \u0451\u0441\u0446\u044c \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c \u0437\u0430\u043a\u043e\u043d\u0443&raquo; (\u0420\u044b\u043c 13, 10), \u043d\u044f\u0445\u0430\u0439 \u0447\u044b\u0442\u0430\u0435 \u045e \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u0445, \u0437 \u044f\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0437\u0435\u043b\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0430\u0434 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f \u045e\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0430\u0434\u0437\u0456\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u045e \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430\u043c. \u0422\u0430\u0434\u044b \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c, \u0448\u0442\u043e \u0445\u0432\u0430\u043b\u0430, \u044f\u043a\u043e\u0439 \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435 \u043b\u044e\u0431\u043e\u045e, \u043d\u0435 \u043c\u0435\u043d\u0448\u0430\u044f \u0437\u0430 \u0442\u0443\u044e, \u044f\u043a\u0430\u044f \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434\u0432\u0430\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0448\u0442\u043e \u0436 \u0432\u044b \u0441\u043a\u0430\u0436\u0430\u0446\u0435 \u043f\u0440\u0430 \u0432\u0435\u043b\u0456\u0447 \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u0430\u0433\u0430 \u045e \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u0445 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430? \u0422\u043e\u0435, \u0448\u0442\u043e \u043d\u0435\u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u0456\u043d\u0448\u044b\u044f, \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442\u0443 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0456 \u0430\u0434\u043a\u0440\u044b\u0442\u0430, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u0448\u0442\u043e \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u044f\u0433\u043e \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430, \u0431\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u0411\u043e\u0433: &laquo;\u041d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0435 \u0430\u0434 \u0446\u044f\u0431\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u043f\u0430\u0441\u0430\u0434\u0436\u0443 \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u0442\u0432\u0430\u0456\u043c&raquo; (\u041f\u0441 132 [131], 11). \u0423 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u0445 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u042f\u0433\u043e \u0437\u0431\u0430\u045e\u0447\u0430\u044f \u043c\u0443\u043a\u0430, \u0441\u043c\u0435\u0440\u0446\u044c, \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435, \u0443\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u0435 \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u044f\u0434\u0437\u0435\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0410\u0439\u0446\u0430. \u0422\u043e\u043b\u044c\u043a\u0456 \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0456\u0445\u0442\u043e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u0435 \u0430\u0434\u0432\u0430\u0436\u044b\u045e\u0441\u044f \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0456 \u0448\u0442\u043e \u043f\u043e\u0442\u044b\u043c \u0441\u0430\u043c \u041f\u0430\u043d \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0443 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 57 (56), 8-9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u0430\u0442\u043e\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u043c\u0430\u0451, \u041f\u0430\u043d\u0435, \u0433\u0430\u0442\u043e\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u043c\u0430\u0451, <span style=\"color: #ff0000;\">*<\/span> \u044f \u0431\u0443\u0434\u0443 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0456 \u0433\u0440\u0430\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u0430\u0447\u043d\u0456\u0441\u044f, \u0434\u0443\u0448\u0430 \u043c\u0430\u044f, \u043f\u0440\u0430\u0447\u043d\u0456\u0446\u0435\u0441\u044f, \u043f\u0441\u0430\u043b\u0442\u044b\u0440 \u0456 \u0430\u0440\u0444\u0430, \u0456 \u044f \u0430\u0431\u0443\u0434\u0436\u0443 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0431\u0443\u0434\u0443 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0456 \u0433\u0440\u0430\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_2_ID":"107","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 1, 9-12: CSEL 64, 7. 9-10)<\/span><br \/><span style=\"color: #ff0000;\">\u0417\u0430\u0441\u043f\u044f\u0432\u0430\u044e \u0434\u0443\u0445\u0430\u043c \u0456 \u0440\u043e\u0437\u0443\u043c\u0430\u043c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0436 \u0451\u0441\u0446\u044c \u043f\u0440\u044b\u0433\u0430\u0436\u044d\u0439\u0448\u0430\u0435 \u0437\u0430 \u043f\u0441\u0430\u043b\u044c\u043c? \u0414\u0430\u0432\u0456\u0434 \u0441\u043b\u0443\u0448\u043d\u0430 \u043a\u0430\u0436\u0430: &laquo;\u0425\u0432\u0430\u043b\u0456\u0446\u0435 \u041f\u0430\u043d\u0430, \u0431\u043e \u043f\u0440\u044b\u0435\u043c\u043d\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0431\u043e \u043f\u0440\u044b\u0435\u043c\u043d\u0430 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u042f\u043c\u0443 \u043f\u0435\u0441\u043d\u044e \u0445\u0432\u0430\u043b\u044b&raquo; (\u041f\u0441 147 [146], 1). \u0412\u0435\u043b\u044c\u043c\u0456 \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u0430, \u0431\u043e \u043f\u0441\u0430\u043b\u044c\u043c &minus; \u0433\u044d\u0442\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0443, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0411\u043e\u0433\u0430, \u0445\u0432\u0430\u043b\u0430 \u0441\u0445\u043e\u0434\u0443, \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u0445, \u0437\u0430\u043a\u043b\u0456\u043a \u0441\u0432\u0435\u0442\u0443, \u0433\u043e\u043b\u0430\u0441 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043c\u0435\u043b\u0430\u0434\u044b\u0447\u043d\u0430\u0435 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u0432\u0435\u0440\u044b, \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0435 \u0432\u044b\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0430\u0437\u0434\u0430\u0431\u043b\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0431\u043e\u0434\u044b, \u043a\u0440\u044b\u043a \u0432\u044f\u0441\u0435\u043b\u043b\u044f, \u0432\u044b\u0431\u0443\u0445 \u0440\u0430\u0434\u0430\u0441\u0446\u0456. \u041f\u0441\u0430\u043b\u044c\u043c \u0441\u0443\u0446\u0456\u0448\u0430\u0435 \u0433\u043d\u0435\u045e, \u0430\u0434\u0434\u0430\u043b\u044f\u0435 \u0442\u0443\u0440\u0431\u043e\u0442\u044b, \u0441\u0443\u0446\u044f\u0448\u0430\u0435 \u045e \u0441\u0443\u043c\u0435. \u0423\u043d\u0430\u0447\u044b &minus; \u0430\u0431\u0430\u0440\u043e\u043d\u0430, \u0443\u0434\u0437\u0435\u043d\u044c &minus; \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0441\u0432\u044f\u0442\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445, \u0432\u043e\u0431\u0440\u0430\u0437 \u0430\u0441\u0430\u043b\u043e\u0434\u044b, \u0433\u0430\u0440\u0430\u043d\u0442\u044b\u044f \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0437\u0433\u043e\u0434\u044b; \u044f\u043a \u0430\u0440\u0444\u0430 \u043b\u0443\u0447\u044b\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u044f \u0456 \u0440\u043e\u0437\u043d\u044b\u044f \u0433\u0430\u043b\u0430\u0441\u044b \u045e \u0430\u0434\u0437\u0456\u043d \u0433\u0430\u0440\u043c\u0430\u043d\u0456\u0447\u043d\u044b \u0441\u043f\u0435\u045e. \u041f\u0441\u0430\u043b\u044c\u043c\u0430\u043c \u0440\u0430\u0441\u043f\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u0440\u0430\u043d\u0456\u0446\u0430, \u0430 \u0437\u043c\u0440\u043e\u043a \u0430\u0434\u0431\u0456\u0432\u0430\u0435 \u044f\u0433\u043e \u0440\u044d\u0445\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043f\u0441\u0430\u043b\u044c\u043c\u0435 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0447\u0430\u0435 \u0437 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c. \u0421\u043f\u0435\u0432\u0430\u043a\u0443 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043f\u0430\u0433\u043b\u044b\u0431\u043b\u044f\u0435 \u044f\u0433\u043e \u0432\u0435\u0434\u044b. \u042f\u043a\u0443\u044e \u0436 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0442\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0448 \u043f\u0440\u0430\u0437 \u0447\u044b\u0442\u0430\u043d\u043d\u0435 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e. \u041a\u0430\u043b\u0456 \u0447\u044b\u0442\u0430\u044e: &laquo;\u0421\u043f\u0435\u045e \u0434\u043b\u044f \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430&raquo;, \u043f\u0430\u043b\u0430\u044e \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u0441\u0432\u044f\u0442\u043e\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u0423 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u0445 \u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0443 \u0434\u0430\u0440 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f\u045e, \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f, \u0441\u043a\u0430\u0440\u0431\u044b \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u045e. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c \u0432\u0443\u0447\u0443\u0441\u044f \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0446\u044c \u0433\u0440\u0430\u0445\u0443 \u0456 \u0440\u0430\u0437\u0432\u0443\u0447\u0432\u0430\u044e\u0441\u044f \u0441\u0430\u0440\u043e\u043c\u0435\u0446\u0446\u0430 \u043f\u0430\u043a\u0443\u0442\u044b \u0437\u0430 \u0433\u0440\u0430\u0445\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u044b\u043c \u0436\u0430 \u0451\u0441\u0446\u044c \u043f\u0441\u0430\u043b\u044c\u043c, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043c \u0446\u043d\u043e\u0442\u0430\u045e? \u0428\u0430\u043d\u043e\u045e\u043d\u044b \u043f\u0440\u0430\u0440\u043e\u043a, \u0443\u0434\u0430\u0440\u0430\u044e\u0447\u044b \u045e \u0456\u0445 \u043f\u0430\u043b\u0430\u0447\u043a\u0430\u0439 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0440\u0430\u0441\u0441\u0435\u0439\u0432\u0430\u0435 \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0441\u043b\u043e\u0434\u044b\u0447 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u043f\u0435\u0441\u043d\u0456. \u041a\u0430\u043b\u0456 \u043d\u0430 \u0441\u0442\u0440\u0443\u043d\u0430\u0445 \u043b\u044e\u0442\u043d\u0456, \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u044b\u0445 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0447\u0430\u0441\u0442\u0430\u043a \u0437\u0432\u044f\u0440\u043e\u045e, \u0441\u043f\u0430\u043b\u0443\u0447\u0430\u0435 \u0433\u0430\u043b\u0430\u0441\u044b \u0440\u043e\u0437\u043d\u044b\u0445 \u0430\u0434\u0446\u0435\u043d\u043d\u044f\u045e \u0456 \u0433\u0443\u0447\u0430\u043d\u043d\u044f \u0456 \u0434\u0430 \u043d\u0435\u0431\u0430 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435 \u043f\u0435\u0441\u043d\u044e \u0411\u043e\u0436\u0430\u0439 \u0445\u0432\u0430\u043b\u044b, \u0442\u0430\u0434\u044b \u0432\u0443\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443, \u0430 \u043f\u0430\u0441\u043b\u044f \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0443 \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0456 \u0440\u043e\u0437\u043d\u044b\u044f \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u044f\u043a\u0456\u044f \u043f\u0430\u043a\u0430\u0436\u0443\u0446\u044c \u0411\u043e\u0433\u0443 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u0439 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0432\u0456\u0434 \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u043d\u0430\u0441, \u0448\u0442\u043e \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u043f\u0441\u0430\u043b\u044c\u043c \u0443 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0441\u044d\u0440\u0446\u0430. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u0440\u043e\u0431\u0456\u0446\u044c \u041f\u0430\u0432\u0435\u043b, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043a\u0430\u0436\u0430: &laquo;\u0411\u0443\u0434\u0443 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0434\u0443\u0445\u0430\u043c \u0456 \u0431\u0443\u0434\u0443 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0440\u043e\u0437\u0443\u043c\u0430\u043c, \u0431\u0443\u0434\u0443 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0434\u0443\u0445\u0430\u043c \u0456 \u0431\u0443\u0434\u0443 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0440\u043e\u0437\u0443\u043c\u0430\u043c&raquo; (1 \u041a\u0430\u0440 14, 15). \u0414\u0430\u0432\u0456\u0434 \u0432\u0443\u0447\u044b\u045e \u043d\u0430\u0441 \u044f\u0448\u0447\u044d \u045e\u043b\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u0447\u044b\u043d\u044b \u045e \u0441\u0432\u044f\u0442\u043b\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u045e, \u043a\u0430\u0431 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044c \u0430\u0434 \u0441\u043f\u044f\u0432\u0430\u043d\u043d\u044f \u043d\u0435 \u0430\u0431\u0443\u0434\u0436\u0430\u043b\u0430 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0446\u0435\u043b\u0430, \u044f\u043a\u0430\u044f \u043d\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435, \u0430\u043b\u0435 \u0437\u043d\u044f\u0432\u043e\u043b\u044c\u0432\u0430\u0435 \u0434\u0443\u0448\u0443. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443 \u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0441\u043f\u044f\u0432\u0430\u0435 \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b: &laquo;\u042f \u0431\u0443\u0434\u0443 \u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0426\u044f\u0431\u0435 \u043d\u0430 \u0430\u0440\u0444\u0435, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430, \u0421\u0432\u044f\u0442\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0423\u0437\u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u0432\u0443\u0441\u043d\u044b \u043c\u0430\u0435, \u043a\u0430\u043b\u0456 \u044f \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u044e \u0422\u0430\u0431\u0435, \u0456 \u043c\u0430\u044f \u0434\u0443\u0448\u0430, \u044f\u043a\u0443\u044e \u0422\u044b \u0430\u0434\u043a\u0443\u043f\u0456\u045e&raquo; (\u043f\u0430\u0440. \u041f\u0441 71 [70], 22-23).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 92 (91), 2. 4<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u043e\u0431\u0440\u0430 \u0451\u0441\u0446\u044c \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u041f\u0430\u043d\u0443 <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0456\u043c\u044f \u0422\u0432\u0430\u0451, \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430 \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u0441\u0442\u0440\u0443\u043d\u043d\u0430\u0439 \u0430\u0440\u0444\u0435 \u0456 \u043d\u0430 \u043b\u0456\u0440\u044b, \u043f\u0430\u0434 \u0433\u0440\u0430\u043d\u043d\u0435 \u0433\u0443\u0441\u043b\u044f\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0456\u043c\u044f \u0422\u0432\u0430\u0451, \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"111","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u041f\u0430\u043d\u0441\u043a\u0443\u044e&raquo; \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 4-6: CSEL 3, 268-270)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u044f\u0445\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0432\u044b\u043f\u043b\u044b\u0432\u0430\u0435 \u0437 \u043f\u0430\u043a\u043e\u0440\u043d\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f, \u0445\u0442\u043e \u043c\u043e\u043b\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0440\u043e\u0431\u044f\u0446\u044c \u0433\u044d\u0442\u0430 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430; \u0443 \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0441\u0446\u0456 \u0456 \u0437 \u043f\u0430\u0448\u0430\u043d\u0430\u044e. \u0411\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u0448\u0442\u043e \u043c\u044b \u0441\u0442\u0430\u0456\u043c \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0411\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u0411\u043e\u0433\u0443 \u044f\u043a \u043f\u0430\u0441\u0442\u0430\u0432\u0430\u0439 \u0446\u0435\u043b\u0430, \u0442\u0430\u043a \u0456 \u0441\u043f\u043e\u0441\u0430\u0431\u0430\u043c \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0411\u043e \u044f\u043a \u043d\u044f\u0432\u044b\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u0446\u0430 \u0433\u0440\u043e\u043c\u043a\u0456\u043c \u043a\u0440\u044b\u043a\u0430\u043c, \u0442\u0430\u043a \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442 \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u044b\u043c \u043b\u044e\u0434\u0437\u044f\u043c \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0441\u0446\u0456 \u0456 \u0441\u0446\u0456\u043f\u043b\u0430\u0441\u0446\u0456. \u0414\u044b \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u045e \u043d\u0430\u043c \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0432\u0430 \u045e\u043a\u0440\u044b\u0446\u0446\u0456, \u0443 \u043c\u0435\u0441\u0446\u0430\u0445 \u0437\u0430\u043a\u0440\u044b\u0442\u044b\u0445 \u0456 \u0430\u0434\u0430\u0441\u043e\u0431\u043b\u0435\u043d\u044b\u0445, \u043d\u0430\u0432\u0430\u0442 \u0443 \u0441\u0432\u0430\u0456\u043c \u043f\u0430\u043a\u043e\u0456. \u0413\u044d\u0442\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u043d\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u044b, \u0431\u043e \u043c\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u0435\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u045e\u0441\u044e\u0434\u044b, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c \u0456 \u0447\u0443\u0435 \u045e\u0441\u0451, \u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u043e\u0439 \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u043b\u0456\u0447\u044b \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e \u0441\u0430\u043c\u044b\u044f \u0441\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0456 \u043d\u0430\u0439\u0433\u043b\u044b\u0431\u0435\u0439\u0448\u044b\u044f \u043c\u0435\u0441\u0446\u044b. \u041d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u042f &minus; \u0411\u043e\u0433 \u0431\u043b\u0456\u0437\u043a\u0456, \u0430 \u043d\u0435 \u0434\u0430\u043b\u0451\u043a\u0456. \u0426\u0456 \u0436 \u043c\u043e\u0436\u0430 \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043a\u0430\u0431 \u044f\u0433\u043e \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u045e? \u0426\u0456 \u0436 \u0433\u044d\u0442\u0430 \u043d\u0435 \u042f \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u044e \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e?&raquo; (\u043f\u0430\u0440. \u0415\u0440 23, 23-24). \u0406 \u0437\u043d\u043e\u045e: &laquo;\u041d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0432\u043e\u0447\u044b \u041f\u0430\u043d\u0430 \u0433\u043b\u044f\u0434\u0437\u044f\u0446\u044c \u043d\u0430 \u0434\u043e\u0431\u0440\u044b\u0445 \u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u0445&raquo; (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 15, 3).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u043c\u044b \u0437\u0431\u0456\u0440\u0430\u0435\u043c\u0441\u044f \u0437 \u0431\u0440\u0430\u0442\u0430\u043c\u0456 \u0456 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u0411\u043e\u0433\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u043c \u0441\u0432\u044f\u0442\u044b\u044f \u0430\u0431\u0440\u0430\u0434\u044b, \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0441\u0446\u0456\u043f\u043b\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u0440\u0430\u0434\u0430\u043a. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u044b\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u043d\u0430\u0448\u044b\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0431\u044f\u0437\u0434\u0443\u043c\u043d\u0430 \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0448\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u043d\u044b\u043c\u0456 \u045e \u043f\u0440\u043e\u0441\u044c\u0431\u0435, \u044f\u043a\u0443\u044e \u0442\u0440\u044d\u0431\u0430 \u0434\u0430\u0440\u0443\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0443 \u0437 \u0443\u0441\u0451\u0439 \u0441\u0446\u0456\u043f\u043b\u0430\u0441\u0446\u044e \u0456 \u043f\u0430\u0448\u0430\u043d\u0430\u044e. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0441\u043b\u0443\u0445\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0430 \u043d\u0435 \u044f\u0437\u044b\u043a. \u0422\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e \u0434\u0443\u043c\u043a\u0456, \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0441\u043f\u0435\u0448\u043a\u0456. \u0421\u0430\u043c \u041f\u0430\u043d \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0435\u0446\u0435 \u0437\u043b\u043e \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445?&raquo; (\u041c\u0446 9, 4). \u0406 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b: &laquo;\u0406 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0443\u0441\u0435 \u041a\u0430\u0441\u0446\u0451\u043b\u044b, \u0448\u0442\u043e \u042f \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u043d\u0443\u0442\u0440\u043e \u0456 \u0441\u044d\u0440\u0446\u044b&raquo; (\u0410\u043f 2, 23).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u0430\u043d\u043d\u0430, \u044f\u043a\u0430\u044f \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u043e\u045e\u0432\u0430\u043b\u0430\u0441\u044f, \u044f\u043a \u0447\u044b\u0442\u0430\u0435\u043c \u0443 \u041f\u0435\u0440\u0448\u0430\u0439 \u043a\u043d\u0456\u0437\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u045e, \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u043f\u0430\u0440\u0430\u0434\u044b. \u041c\u0430\u043b\u0456\u043b\u0430\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430 \u045e \u0446\u0456\u0448\u044b\u043d\u0456, \u0443 \u043f\u0430\u043a\u043e\u0440\u044b, \u0443 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u0430 \u043d\u0435 \u0433\u0443\u0447\u043d\u044b\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043c. \u042f\u0435 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0431\u044b\u043b\u0430 \u045e\u0442\u043e\u0435\u043d\u0430\u044f, \u0430\u043b\u0435 \u0432\u0435\u0440\u0430 \u044f\u045e\u043d\u0430\u044f. \u041c\u0430\u043b\u0456\u043b\u0430\u0441\u044f \u043d\u0435 \u0432\u0443\u0441\u043d\u0430\u043c\u0456, \u0430\u043b\u0435 \u0441\u044d\u0440\u0446\u0430\u043c, \u0431\u043e \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u043b\u0430, \u0448\u0442\u043e \u0411\u043e\u0433 \u0447\u0443\u0435 \u0442\u0430\u043a\u0443\u044e \u043c\u0430\u043b\u0456\u0442\u0432\u0443. \u0410\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0442\u043e\u0435, \u0430\u0431 \u0447\u044b\u043c \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u043f\u0440\u0430\u0441\u0456\u043b\u0430. \u041f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0433\u044d\u0442\u0430 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u0413\u0430\u043d\u043d\u0430 \u0436 \u043a\u0430\u0437\u0430\u043b\u0430 \u045e \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c; \u0445\u043e\u0446\u044c \u044f\u0435 \u0432\u0443\u0441\u043d\u044b \u0432\u0430\u0440\u0443\u0448\u044b\u043b\u0456\u0441\u044f, \u0433\u043e\u043b\u0430\u0441\u0443 \u044f\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u0447\u0443\u0432\u0430\u0446\u044c. \u0406 \u041f\u0430\u043d \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e \u044f\u0435&raquo; (\u043f\u0430\u0440. 1 \u0421\u0430\u043c 1, 13). \u0422\u043e\u0435 \u0436 \u0447\u044b\u0442\u0430\u0435\u043c \u0443 \u043f\u0441\u0430\u043b\u044c\u043c\u0435: &laquo;\u041f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445 \u0456 \u043f\u0430\u043a\u0443\u0442\u0443\u0439\u0446\u0435 \u045e \u0434\u0430\u043c\u0430\u0445 \u0441\u0432\u0430\u0456\u0445&raquo; (\u043f\u0430\u0440. \u041f\u0441 4, 5). \u0422\u043e\u0435 \u0436 \u0441\u0430\u043c\u0430\u0435 \u0440\u0430\u0456\u0446\u044c \u043d\u0430\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u044e \u0456 \u043a\u0430\u0436\u0430: &laquo;\u0426\u044f\u0431\u0435, \u043e \u041f\u0430\u043d\u0435, \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0443 \u0434\u0443\u0445\u0443&raquo; (\u043f\u0430\u0440. \u0411\u0430\u0440 6, 5).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f! \u0422\u043e\u0439, \u0445\u0442\u043e \u043c\u043e\u043b\u0456\u0446\u0446\u0430, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u044f\u043a \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u043c\u044b\u0442\u043d\u0456\u043a \u043f\u043e\u0431\u0430\u0447 \u0437 \u0444\u0430\u0440\u044b\u0441\u0435\u0435\u043c. \u041d\u0435 \u045e\u0437\u0434\u044b\u043c\u0430\u045e \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u0430 \u0432\u043e\u0447\u044b \u0456 \u043d\u0435 \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u0430\u045e \u0443\u0437\u043d\u0451\u0441\u043b\u0430 \u0440\u0443\u043a\u0456, \u0430\u043b\u0435 \u0431\u0456\u045e \u0441\u044f\u0431\u0435 \u045e \u0433\u0440\u0443\u0434\u0437\u0456 \u0456, \u0432\u044b\u0437\u043d\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u0435 \u045e\u043a\u0440\u044b\u0442\u044b\u044f \u0433\u0440\u0430\u0445\u0456, \u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0411\u043e\u0436\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u0406 \u0445\u043e\u0446\u044c \u0444\u0430\u0440\u044b\u0441\u0435\u0439 \u0431\u044b\u045e \u0446\u0430\u043b\u043a\u0430\u043c \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0435\u043d\u044b \u0441\u0430\u0431\u043e\u044e, \u0430\u043b\u0435 \u0431\u043e\u043b\u044c\u0448 \u043d\u0430 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435 \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u045e \u043c\u044b\u0442\u043d\u0456\u043a, \u044f\u043a\u0456 \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0431\u0435\u0437 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0441\u0432\u0430\u044e \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u044c, \u0431\u043e \u043d\u044f\u043c\u0430 \u043d\u0456\u043a\u043e\u0433\u0430 \u0431\u0435\u0437 \u0432\u0456\u043d\u044b. \u041c\u0430\u043b\u0456\u045e\u0441\u044f \u0437 \u043f\u0430\u043a\u043e\u0440\u0430\u044e, \u0432\u044b\u0437\u043d\u0430\u044e\u0447\u044b \u0433\u0440\u0430\u0445\u0456, \u0456 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e \u044f\u0433\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0443\u0434\u0437\u044f\u043b\u044f\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u0437\u0432\u0430\u0436\u044b\u043c, \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0456 \u0430\u043d\u0451\u043b\u0430\u043c\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u043f\u0441\u0430\u043b\u044c\u043c\u044b, \u043a\u0430\u0431 \u043d\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0431\u044b\u043b\u043e \u0437\u0433\u043e\u0434\u043d\u0430\u0435 \u0437 \u0442\u044b\u043c, \u0448\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u043d\u0430\u0448\u044b\u044f \u0432\u0443\u0441\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0435\u0434\u0430\u0439\u043c\u0430, \u0448\u0442\u043e \u043d\u0435 \u0448\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u0435, \u0430\u043b\u0435 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0441\u0446\u044c \u0441\u044d\u0440\u0446\u0430 \u0456 \u0441\u043b\u0451\u0437\u044b \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u043d\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u043f\u0441\u0430\u043b\u044c\u043c\u044b, \u043a\u0430\u0431 \u043d\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0431\u044b\u043b\u043e \u0437\u0433\u043e\u0434\u043d\u0430\u0435 \u0437 \u0442\u044b\u043c, \u0448\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u043d\u0430\u0448\u044b\u044f \u0432\u0443\u0441\u043d\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"112","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u041f\u0430\u043d\u0441\u043a\u0443\u044e&raquo; \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 8-9: CSEL 3, 271-272)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041d\u0430\u0448\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 &ndash; \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u0430\u044f \u0456 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u043d\u0435 \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u043b\u0456\u043b\u0456\u0441\u044f \u043f\u0440\u044b\u0432\u0430\u0442\u043d\u0430 \u0456 \u0430\u0441\u043e\u0431\u043d\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430 \u0441\u044f\u0431\u0435. \u041d\u0435 \u043a\u0430\u0436\u0430\u043c: &laquo;\u041e\u0439\u0447\u0430 \u043c\u043e\u0439, \u043a\u0430\u0442\u043e\u0440\u044b \u0451\u0441\u0446\u044c \u0443 \u043d\u0435\u0431\u0435&raquo; \u0430\u0431\u043e: &laquo;\u0425\u043b\u0435\u0431\u0430 \u043c\u0430\u0439\u0433\u043e \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430\u0433\u0430 \u0434\u0430\u0439 \u043c\u043d\u0435 \u0441\u0451\u043d\u043d\u044f&raquo;. \u041d\u0456\u0445\u0442\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u043f\u0440\u0430 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e \u0456 \u043d\u0435 \u043f\u0440\u043e\u0441\u0456\u0446\u044c, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u0451\u043d \u0441\u0430\u043c \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u045e \u0441\u043f\u0430\u043a\u0443\u0441\u044b \u0456 \u0431\u044b\u045e \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b \u0430\u0434 \u0437\u043b\u0430. \u041d\u0430\u0448\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 &ndash; \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u0430\u044f \u0456 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u044f. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u043c\u043e\u043b\u0456\u043c\u0441\u044f, \u043d\u0435 \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0437\u0430 \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0430\u0434\u043d\u0430\u0433\u043e, \u0430\u043b\u0435 \u0437\u0430 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434, \u0431\u043e, \u044f\u043a \u0443\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434, \u0441\u0442\u0432\u0430\u0440\u0430\u0435\u043c \u0430\u0434\u043d\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a \u0437\u0433\u043e\u0434\u044b, \u0442\u043e\u0439, \u044f\u043a\u0456 \u0432\u0443\u0447\u044b\u045e \u043d\u0430\u0441 \u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u043f\u0430\u0436\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0437\u0430 \u045e\u0441\u0456\u0445, \u0442\u0430\u043a \u044f\u043a \u0456 \u0401\u043d \u0443\u0437\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441. \u0413\u044d\u0442\u044b \u0437\u0430\u043a\u043e\u043d \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u0442\u0440\u044b \u044e\u043d\u0430\u043a\u0456, \u0443\u043a\u0456\u043d\u0443\u0442\u044b\u044f \u045e \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u0443\u044e \u043f\u0435\u0447. \u041c\u0430\u043b\u0456\u043b\u0456\u0441\u044f \u045e \u0430\u0434\u0437\u0456\u043d \u0433\u043e\u043b\u0430\u0441 \u0456 \u045e \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0441\u0442\u0432\u0435. \u041f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043a\u0430\u0436\u0430 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435, \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u0456\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u0434\u0430\u0435 \u043d\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0434\u043b\u044f \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f, \u043a\u0430\u0431 \u0456 \u043c\u044b \u0431\u044b\u043b\u0456 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u043d\u044b\u043c\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u0456\u043c. &laquo;\u0413\u044d\u0442\u044b\u044f \u0442\u0440\u043e\u0435, &minus; \u043a\u0430\u0436\u0430, &minus; \u0443 \u0430\u0434\u0437\u0456\u043d \u0433\u043e\u043b\u0430\u0441 \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u0433\u0456\u043c\u043d \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u0411\u043e\u0433\u0430&raquo; (\u043f\u0430\u0440. \u0414\u0430\u043d 3, 51). \u041c\u0430\u043b\u0456\u043b\u0456\u0441\u044f \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u0430\u0434\u0437\u0456\u043d \u0433\u043e\u043b\u0430\u0441, \u0445\u043e\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0432\u0443\u0447\u044b\u045e \u0456\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0435. \u0410 \u0433\u044d\u0442\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0431\u044b\u043b\u0430 \u0434\u0437\u0435\u0439\u0441\u043d\u0430\u0439 \u0456 \u043f\u043b\u0451\u043d\u043d\u0430\u0439, \u0431\u043e \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u045e \u0434\u0443\u0445\u0443, \u043f\u043e\u045e\u043d\u0430\u044f \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u044b \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u041f\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u045e\u0432\u0430\u0436\u044b\u043c, \u0448\u0442\u043e \u0442\u0430\u043a \u043c\u0430\u043b\u0456\u043b\u0456\u0441\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0443\u0447\u043d\u044f\u043c\u0456 \u043f\u0430\u0441\u043b\u044f \u0423\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u044f. &laquo;\u0423\u0441\u0435 \u044f\u043d\u044b, &minus; \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, &minus; \u0441\u0443\u043c\u0435\u0441\u043d\u0430 \u0442\u0440\u044b\u0432\u0430\u043b\u0456 \u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456 \u0456 \u041c\u0430\u0440\u044b\u044f\u0439, \u043c\u0430\u0446\u0456 \u0415\u0437\u0443\u0441\u0430, \u0456 \u0437 \u0431\u0440\u0430\u0442\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456&raquo; (\u0414\u0437 1,14). \u0422\u0440\u044b\u0432\u0430\u044e\u0447\u044b \u0440\u0430\u0437\u0430\u043c \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u044c \u0456 \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u044c, \u0448\u0442\u043e \u0411\u043e\u0433, \u044f\u043a\u0456 \u0440\u044b\u0445\u0442\u0443\u0435 \u0434\u043e\u043c \u0434\u043b\u044f \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430\u045e (\u043f\u0430\u0440. \u041f\u0441 68 [67], 7), \u0443 \u0441\u0432\u0430\u044e \u0432\u0435\u0447\u043d\u0443\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u043f\u0440\u044b\u043c\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430 \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f! \u042f\u043a\u0456\u044f \u0436 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0437\u043c\u044f\u0448\u0447\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u041f\u0430\u043d\u0441\u043a\u0430\u044f! \u042f\u043a \u0436\u0430 \u0448\u043c\u0430\u0442 \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u0430 \u045e \u0441\u0446\u0456\u0441\u043b\u044b\u0445, \u0430\u043b\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u0445 \u043c\u043e\u0446\u0430\u044e \u0434\u0443\u0445\u0430 \u0441\u043b\u043e\u0432\u0430\u0445. \u0423 \u043d\u0430\u0448\u044b\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445 \u0456 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u0445 \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430, \u0447\u0430\u0433\u043e \u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u043a\u0430\u0440\u043e\u0442\u043a\u0456\u043c \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0432\u0443\u043a\u0456. &laquo;\u041c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u0442\u0430\u043a: \u041e\u0439\u0447\u0430 \u043d\u0430\u0448, \u043a\u0430\u0442\u043e\u0440\u044b \u0451\u0441\u0446\u044c \u0443 \u043d\u0435\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u043e\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0456 \u0432\u0435\u0440\u043d\u0443\u0442\u044b \u0411\u043e\u0433\u0443 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u0433\u043e \u043b\u0430\u0441\u0446\u044b, \u043a\u0430\u0436\u0430 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443: &laquo;\u041e\u0439\u0447\u0430&raquo;, \u0431\u043e \u045e\u0436\u043e \u043f\u0430\u0447\u0430\u045e \u0431\u044b\u0446\u044c \u042f\u0433\u043e \u0441\u044b\u043d\u0430\u043c. &laquo;\u0414\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u044b\u0439\u0448\u043b\u043e, &minus; \u043a\u0430\u0436\u0430 \u0441\u0432. \u042f\u043d, &minus; \u0456 \u0441\u0432\u0430\u0435 \u042f\u0433\u043e \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456. \u0410 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u045e \u042f\u0433\u043e, \u0434\u0430\u043b\u043e \u045e\u043b\u0430\u0434\u0443 \u0441\u0442\u0430\u0446\u044c \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456, \u0442\u044b\u043c, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435&raquo; (\u042f\u043d 1, 11-12). \u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e\u043d\u0430\u0435 \u0456\u043c\u044f \u0456 \u0441\u0442\u0430\u045e \u0411\u043e\u0436\u044b\u043c \u0434\u0437\u0456\u0446\u0435\u043c, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c, \u0430 \u043d\u0430\u0437\u0432\u0430\u045e\u0448\u044b \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0456\u043c \u0410\u0439\u0446\u043e\u043c \u0443 \u043d\u0435\u0431\u0435, \u0432\u044b\u0437\u043d\u0430\u0446\u044c, \u0448\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u042f\u0433\u043e \u0441\u044b\u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 22 (21), 23; 57 (56), 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0443 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0456\u043c\u044f \u0422\u0432\u0430\u0451 \u0431\u0440\u0430\u0442\u0430\u043c \u043c\u0430\u0456\u043c,<span style=\"color: #ff0000;\"> *<\/span> \u043d\u0430 \u0441\u0445\u043e\u0434\u0437\u0435 \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0443\u0434\u0443 \u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0426\u044f\u0431\u0435 \u043c\u0456\u0436 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456, \u041f\u0430\u043d\u0435, \u0431\u0443\u0434\u0443 \u045e\u0441\u0445\u0432\u0430\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435 \u0441\u044f\u0440\u043e\u0434 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430 \u0441\u0445\u043e\u0434\u0437\u0435 \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"113","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u041f\u0430\u043d\u0441\u043a\u0443\u044e&raquo; \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 11-12: CSEL 3, 274-275)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u0432\u044f\u0446\u0456\u0441\u044f \u0456\u043c\u044f \u0422\u0432\u0430\u0451<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0430\u044f \u0436 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430, \u044f\u043a\u0430\u044f \u0436 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u042f\u0433\u043e \u043b\u0456\u0442\u0430\u0441\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u043c\u0456 \u0456 \u0434\u0430\u0431\u0440\u044b\u043d\u044f, \u0448\u0442\u043e \u0437\u0430\u0445\u0430\u0446\u0435\u045e, \u043a\u0430\u0431 \u043c\u044b, \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0447\u044b\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0456 \u042f\u0433\u043e \u0410\u0439\u0446\u043e\u043c, \u0430 \u0441\u044f\u0431\u0435 \u0441\u044b\u043d\u0430\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456, \u044f\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0421\u044b\u043d\u0430\u043c \u0411\u043e\u0433\u0430. \u041d\u0456\u0445\u0442\u043e \u0437 \u043d\u0430\u0441 \u043d\u0435 \u0430\u0441\u043c\u0435\u043b\u0456\u045e\u0441\u044f \u0431 \u043d\u0430\u0437\u0432\u0430\u0446\u0446\u0430 \u0442\u0430\u043a\u0456\u043c \u0456\u043c\u0435\u043c, \u043a\u0430\u043b\u0456 \u0431 \u0401\u043d \u0441\u0430\u043c \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u043c \u0442\u0430\u043a \u043c\u0430\u043b\u0456\u0446\u0446\u0430. \u0422\u0430\u043c\u0443 \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u0431\u0440\u0430\u0442\u044b \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0456 \u0432\u0435\u0434\u0430\u0446\u044c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043c\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u043e\u043c, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u044f\u043a \u0411\u043e\u0436\u044b\u044f \u0434\u0437\u0435\u0446\u0456, \u043a\u0430\u0431 \u0411\u043e\u0433 \u0433\u0430\u043d\u0430\u0440\u044b\u045e\u0441\u044f \u043d\u0430\u043c\u0456, \u044f\u043a \u0456 \u043c\u044b \u0433\u0430\u043d\u0430\u0440\u044b\u043c\u0441\u044f \u0411\u043e\u0433\u0430\u043c, \u043d\u0430\u0448\u044b\u043c \u0410\u0439\u0446\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u044f\u043a \u0411\u043e\u0436\u044b\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e \u0431\u0430\u0447\u043d\u0430, \u0448\u0442\u043e \u0411\u043e\u0433 \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441. \u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0448\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u043d\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0434\u0443\u0445\u0443. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u0441\u0442\u0430\u043b\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c\u0456 \u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u043d\u0435\u0431\u0430, \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u043c\u043a\u0456 \u0456 \u0447\u044b\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0456 \u0441\u0432\u044f\u0442\u044b\u044f, \u0431\u043e \u0441\u0430\u043c \u041f\u0430\u043d \u0411\u043e\u0433 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u044b\u0445, \u0445\u0442\u043e \u041c\u044f\u043d\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435, \u0456 \u042f \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044e, \u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0435 \u041c\u044f\u043d\u0435, \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u043d\u044f\u0432\u0430\u0436\u0430\u043d\u044b\u044f&raquo; (\u043f\u0430\u0440. 1 \u0421\u0430\u043c 2, 30). \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0441\u0432. \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0443 \u0441\u0432\u0430\u0456\u043c \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456: &laquo;\u0411\u043e \u0432\u044b \u043a\u0443\u043f\u043b\u0435\u043d\u044b \u0437\u0430 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0446\u0430\u043d\u0443! \u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0411\u043e\u0433\u0430 \u045e \u0446\u0435\u043b\u0435 \u0432\u0430\u0448\u044b\u043c&raquo; (1 \u041a\u0430\u0440 6, 20).<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0442\u044b\u043c \u043a\u0430\u0436\u0430\u043c: &laquo;\u0421\u0432\u044f\u0446\u0456\u0441\u044f \u0456\u043c\u044f \u0422\u0432\u0430\u0451&raquo;. \u0422\u0430\u043a \u043a\u0430\u0436\u0430\u043c \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0436\u0430\u0434\u0430\u0435\u043c \u0411\u043e\u0433\u0443, \u043a\u0430\u0431 \u042f\u0433\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u043b\u0456 \u043d\u0430\u0448\u044b\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u0430\u043b\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043f\u0440\u043e\u0441\u0456\u043c \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u042f\u0433\u043e \u0456\u043c\u044f \u0441\u0432\u044f\u0446\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0441. \u0425\u0442\u043e \u0436 \u043c\u043e\u0433 \u0431\u044b \u0430\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433 \u0430\u0441\u0432\u044f\u0447\u0430\u0435? \u0401\u043d \u0441\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u044f\u043a \u042f \u0441\u0432\u044f\u0442\u044b&raquo; (\u043f\u0430\u0440. \u041b\u0435\u0432 11, 45). \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443 \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c \u0456 \u043c\u043e\u043b\u0456\u043c, \u043a\u0430\u0431 \u043c\u044b, \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b\u044f \u043f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442, \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0442\u044b\u043c, \u0447\u044b\u043c \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c. \u0406 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0430\u0431 \u0433\u044d\u0442\u044b\u043c \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c. \u041c\u044b \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u043c \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430\u0433\u0430 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f: \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0433\u0440\u0430\u0448\u044b\u043c, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430\u0435 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0430\u0447\u044b\u0448\u0447\u0430\u0446\u0446\u0430 \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u0433\u044d\u0442\u0430\u0435 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u043d\u0430\u043c \u043f\u0440\u0430\u0437 \u0411\u043e\u0436\u0443\u044e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c, \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0443 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u041d\u0456 \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u0456\u043a\u0456, \u043d\u0456 \u0456\u0434\u0430\u043b\u0430\u043f\u0430\u043a\u043b\u043e\u043d\u043d\u0456\u043a\u0456, \u043d\u0456 \u0447\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u043a\u0456, \u043d\u0456 \u0431\u043b\u0443\u0434\u043d\u0456\u043a\u0456, \u043d\u0456 \u043c\u0443\u0436\u0430\u043b\u043e\u0436\u043d\u0456\u043a\u0456, \u043d\u0456 \u0437\u043b\u043e\u0434\u0437\u0435\u0456, \u043d\u0456 \u0445\u0446\u0456\u045e\u0446\u044b, \u043d\u0456 \u043f&rsquo;\u044f\u043d\u0456\u0446\u044b, \u043d\u0456 \u043f\u0430\u043a\u043b\u0451\u043f\u043d\u0456\u043a\u0456, \u043d\u0456 \u0440\u0430\u0431\u0430\u045e\u043d\u0456\u043a\u0456 \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435. \u0406 \u0442\u0430\u043a\u0456\u043c\u0456 \u0431\u044b\u043b\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u0432\u0430\u0441. \u0410\u043b\u0435 \u0432\u044b \u0430\u0431\u043c\u044b\u043b\u0456\u0441\u044f, \u0432\u044b \u0431\u044b\u043b\u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b\u044f, \u0431\u044b\u043b\u0456 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u044b\u044f \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u045e \u0414\u0443\u0445\u0443 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430!&raquo; (1 \u041a\u0430\u0440 6, 9-11). \u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u043c\u044b \u0431\u044b\u043b\u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b\u044f \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u0433\u044d\u0442\u0430\u0435 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0442\u0440\u044b\u0432\u0430\u043b\u0430 \u045e \u043d\u0430\u0441 \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u0430 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u043d \u043d\u0430\u0448 \u0456 \u0421\u0443\u0434\u0434\u0437\u044f \u0442\u0430\u043c\u0443, \u043a\u0430\u0433\u043e \u0441\u0430\u043c \u0430\u0437\u0434\u0430\u0440\u0430\u0432\u0456\u045e \u0456 \u0432\u044f\u0440\u043d\u0443\u045e \u0434\u0430 \u0436\u044b\u0446\u0446\u044f, \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0435 \u0437\u043d\u043e\u045e \u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u043a\u0430\u0431 \u0437 \u0456\u043c \u043d\u0435 \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0433\u043e\u0440\u0448\u0430\u0435, \u0442\u0430\u043c\u0443 \u043c\u044b \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430, \u0442\u0430\u043c\u0443 \u043f\u0440\u043e\u0441\u0456\u043c \u0434\u043d\u0451\u043c \u0456 \u043d\u043e\u0447\u0447\u0443, \u043a\u0430\u0431 \u0433\u044d\u0442\u0430\u0435 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0456 \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f, \u0448\u0442\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u042f\u0433\u043e \u043b\u0430\u0441\u043a\u0456, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u0433\u043e \u0430\u043f\u0435\u0446\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0441 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0437\u0445 36, 23\u0430. 25\u0430. 26\u0430. 27b; \u041b\u0435\u0432 11, 44b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0441\u0432\u044f\u0447\u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0456\u043c\u044f \u041c\u0430\u0451. \u0410\u043a\u0440\u0430\u043f\u043b\u044e \u0432\u0430\u0441 \u0432\u0430\u0434\u043e\u044e \u0447\u044b\u0441\u0442\u0430\u044e \u0456 \u0434\u0430\u043c \u0432\u0430\u043c \u0441\u044d\u0440\u0446\u0430 \u043d\u043e\u0432\u0430\u0435 \u0456 \u0434\u0443\u0445 \u043d\u043e\u0432\u044b \u045e \u043d\u0443\u0442\u0440\u043e \u0432\u0430\u0448\u0430\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0437\u0440\u0430\u0431\u043b\u044e \u0442\u0430\u043a, \u0448\u0442\u043e \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0417\u0430\u043a\u043e\u043d\u0435 \u041c\u0430\u0456\u043c, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u041c\u0430\u0435 \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u044f\u043a \u042f \u0441\u0432\u044f\u0442\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0437\u0440\u0430\u0431\u043b\u044e \u0442\u0430\u043a, \u0448\u0442\u043e \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0417\u0430\u043a\u043e\u043d\u0435 \u041c\u0430\u0456\u043c, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u041c\u0430\u0435 \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0456\u0445.<\/p>\r\n"}, {"GCH_CH_2_ID":"114","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u041f\u0430\u043d\u0441\u043a\u0443\u044e&raquo; \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 13-15: CSEL 3, 275-278)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0422\u0432\u0430\u0451, \u0431\u0443\u0434\u0437\u044c \u0432\u043e\u043b\u044f \u0422\u0432\u0430\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"background-color: transparent; text-align: justify;\">&laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0422\u0432\u0430\u0451&raquo;. \u041c\u044b \u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u043f\u0440\u044b\u0448\u043b\u043e \u0434\u0430 \u043d\u0430\u0441 \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u0456\u043c\u044f \u0411\u043e\u0433\u0430 \u0431\u044b\u043b\u043e \u045e \u043d\u0430\u0441 \u0441\u0432\u044f\u0442\u044b\u043c. \u041a\u0430\u043b\u0456 \u0411\u043e\u0433 \u043d\u0435 \u0431\u044b\u045e \u041a\u0430\u0440\u0430\u043b\u0451\u043c \u0446\u0456 \u043a\u0430\u043b\u0456 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u043b\u043e\u0441\u044f \u045e \u0406\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0430? \u041c\u044b \u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u043d\u0430\u0448\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435 \u043d\u0430\u043c \u0411\u043e\u0433\u0430\u043c \u0456 \u0432\u044b\u0441\u043b\u0443\u0436\u0430\u043d\u0430\u0435 \u041c\u0443\u043a\u0430\u044e \u0456 \u041a\u0440\u044b\u0432\u0451\u044e \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431, \u043a\u0430\u043b\u0456 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430 \u0437\u0430\u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043c\u044b, \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u042f\u0433\u043e \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435\u043c: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u0410\u0439\u0446\u0430 \u041c\u0430\u0439\u0433\u043e, \u043f\u0440\u044b\u043c\u0456\u0446\u0435 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430\u0435 \u0432\u0430\u043c \u0430\u0434 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443&raquo; (\u041c\u0446 25, 34).<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0433\u0447\u044b\u043c\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0431\u0440\u0430\u0442\u044b \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0448\u0442\u043e \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u044b\u043c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c, \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u043f\u0440\u0430\u0433\u043d\u0435\u043c, \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u044f\u043a\u043e\u0433\u0430 \u043f\u0456\u043b\u044c\u043d\u0430 \u0447\u0430\u043a\u0430\u0435\u043c. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0433\u044d\u0442\u0430 \u0423\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435, \u0431\u043e \u045e \u0406\u043c \u043c\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0435\u043c, \u0442\u043e \u043c\u043e\u0436\u0430\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u0401\u043d \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0411\u043e\u0433\u0430, \u0431\u043e \u045e \u0406\u043c \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c. \u0422\u0430\u043c\u0443 \u043c\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u0430\u0431 \u0411\u043e\u0436\u044b\u043c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0430\u0431 \u041d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435, \u0431\u043e \u0456\u0441\u043d\u0443\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u044f\u043c\u043d\u043e\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0410\u0434\u043d\u0430\u043a \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u0440\u0430\u043a\u0441\u044f \u0441\u0432\u0435\u0442\u0443, \u0442\u043e\u0439 \u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0437\u0430 \u044f\u0433\u043e \u0433\u043e\u043d\u0430\u0440 \u0456 \u045e\u043b\u0430\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0411\u0443\u0434\u0437\u044c \u0432\u043e\u043b\u044f \u0422\u0432\u0430\u044f \u044f\u043a \u0443 \u043d\u0435\u0431\u0435, \u0442\u0430\u043a \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456&raquo;. \u041c\u044b \u043f\u0440\u043e\u0441\u0456\u043c \u043d\u0435 \u0430\u0431 \u0442\u044b\u043c, \u043a\u0430\u0431 \u0411\u043e\u0433 \u043c\u043e\u0433 \u0447\u044b\u043d\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0445\u043e\u0447\u0430, \u0430\u043b\u0435 \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0445\u043e\u0447\u0430 \u0411\u043e\u0433. \u0411\u043e \u0445\u0442\u043e \u0437\u043c\u043e\u0436\u0430 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c \u0411\u043e\u0433\u0443 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0401\u043d \u0445\u043e\u0447\u0430? \u0410\u0434\u043d\u0430\u043a \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0430\u0442\u0430\u043d\u0430 \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u0435 \u043d\u0430\u043c \u0431\u044b\u0446\u044c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u0411\u043e\u0433\u0443 \u045e \u0434\u0443\u043c\u043a\u0430\u0445 \u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u0445, \u0442\u0430\u043c\u0443 \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c \u0456 \u043c\u043e\u043b\u0456\u043c, \u043a\u0430\u0431 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0441 \u0411\u043e\u0436\u0430\u044f \u0432\u043e\u043b\u044f. \u041a\u0430\u0431 \u0433\u044d\u0442\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u043d\u0430\u043c \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430 \u0411\u043e\u0436\u0430\u044f \u0432\u043e\u043b\u044f, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0436\u0430\u044f \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430 \u0456 \u0430\u043f\u0435\u043a\u0430. \u041d\u0456\u0445\u0442\u043e \u045e\u043b\u0430\u0441\u043d\u044b\u043c\u0456 \u0441\u0456\u043b\u0430\u043c\u0456 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0430\u0441\u0442\u0430\u043a\u043e\u0432\u0430 \u043c\u043e\u0446\u043d\u044b\u043c, \u0431\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0440\u043e\u0431\u044f\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b\u043c. \u0414\u044b \u0456 \u0441\u0430\u043c \u041f\u0430\u043d, \u0443\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u043d\u0430 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u0439 \u0406\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u043a\u0430\u0436\u0430: &laquo;\u041e\u0439\u0447\u0430 \u041c\u043e\u0439, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043d\u044f\u0445\u0430\u0439 \u0430\u0431\u043c\u0456\u043d\u0435 \u0433\u044d\u0442\u044b \u043a\u0435\u043b\u0456\u0445 \u041c\u044f\u043d\u0435&raquo;. \u0414\u0430\u044e\u0447\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0432\u0443\u0447\u043d\u044f\u043c, \u043a\u0430\u0431 \u044f\u043d\u044b \u0441\u043f\u0430\u045e\u043d\u044f\u043b\u0456 \u043d\u0435 \u0441\u0432\u0430\u044e, \u0430\u043b\u0435 \u0411\u043e\u0436\u0443\u044e \u0432\u043e\u043b\u044e, \u0434\u0430\u0434\u0430\u045e: &laquo;\u0410\u0434\u043d\u0430\u043a, \u043d\u0435 \u044f\u043a \u042f \u0445\u0430\u0447\u0443, \u0430\u043b\u0435 \u044f\u043a \u0422\u044b&raquo; (\u041c\u0446 26, 39).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u044f\u0439 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043f\u043e\u045e\u043d\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0456 \u0447\u0430\u043c\u0443 \u0401\u043d \u043d\u0430\u0432\u0443\u0447\u0430\u045e: \u043f\u0430\u043a\u043e\u0440\u0430 \u045e \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u0445, \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u044c \u0443 \u0432\u0435\u0440\u044b, \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0441\u0446\u044c \u0443 \u0441\u043b\u043e\u0432\u0430\u0445, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0432\u0430 \u045e\u0447\u044b\u043d\u043a\u0430\u0445, \u043b\u0430\u0434 \u0443 \u0437\u0432\u044b\u0447\u0430\u044f\u0445; \u0432\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u044f \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u043d\u044f\u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c\u0456 \u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u044c, \u0430\u043b\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c\u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u0430\u0446\u044c \u043a\u0440\u044b\u045e\u0434\u044b, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0441\u043f\u0430\u043a\u043e\u0439 \u0437 \u0431\u0440\u0430\u0442\u0430\u043c\u0456, \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0401\u043d \u0410\u0439\u0446\u0435\u0446, \u0431\u0430\u044f\u0446\u0446\u0430 \u042f\u0433\u043e, \u0431\u043e \u0401\u043d \u0411\u043e\u0433, \u043d\u0435 \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430 \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u043e \u0456 \u0401\u043d \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0441\u0442\u0430\u0432\u0456\u045e \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u043d\u0430\u0441. \u0412\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u044f \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u042f\u0433\u043e \u043b\u044e\u0431\u043e\u0432\u0456, \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0456 \u0430\u0434\u0432\u0430\u0433\u0430\u0439 \u0441\u0442\u0430\u044f\u0446\u044c \u043f\u0430\u0434 \u043a\u0440\u044b\u0436\u0430\u043c; \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u0446\u0446\u0430 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u045e \u042f\u0433\u043e \u0456\u043c\u044f \u0456 \u0437\u0430 \u042f\u0433\u043e \u0433\u043e\u043d\u0430\u0440, \u0431\u044b\u0446\u044c \u0446\u0432\u0451\u0440\u0434\u044b\u043c\u0456 \u045e \u0441\u043b\u043e\u0432\u0430\u0445 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f \u0432\u0435\u0440\u044b, \u043f\u0430\u0434\u0447\u0430\u0441 \u043c\u0443\u0447\u044d\u043d\u043d\u044f\u045e \u043c\u0435\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044e, \u044f\u043a\u0430\u044f \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u045e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435, \u0443 \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u0441\u043c\u0435\u0440\u0446\u0456 &minus; \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0437\u0430 \u044f\u043a\u0443\u044e \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0431\u044b\u0446\u044c \u0441\u0443\u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u0433\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u044b\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e, \u0433\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0432\u043e\u043b\u0456 \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041c\u0446 7, 21b; \u041c\u043a 3, 35<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0432\u043e\u043b\u044e \u0410\u0439\u0446\u0430 \u041c\u0430\u0439\u0433\u043e, \u044f\u043a\u0456 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445, <span style=\"color: #ff0000;\">*<\/span> \u0442\u043e\u0439 \u0443\u0432\u043e\u0439\u0434\u0437\u0435 \u045e \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0432\u043e\u043b\u044e \u0411\u043e\u0436\u0443\u044e, \u0442\u043e\u0439 \u041c\u043d\u0435 \u0431\u0440\u0430\u0442, \u0456 \u0441\u044f\u0441\u0442\u0440\u0430, \u0456 \u043c\u0430\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u043e\u0439 \u0443\u0432\u043e\u0439\u0434\u0437\u0435 \u045e \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"115","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u041f\u0430\u043d\u0441\u043a\u0443\u044e&raquo; \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 18. 22: CSEL 3, 280-281, 283-284)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0440\u043e\u0441\u044c\u0431\u0430 \u0430\u0431 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u044b\u043c \u0445\u043b\u0435\u0431\u0435 \u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0456 \u0433\u0440\u0430\u0445\u043e\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u043b\u0435\u0439 \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u041f\u0430\u043d\u0441\u043a\u0430\u0439 \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c: &laquo;\u0425\u043b\u0435\u0431\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430\u0433\u0430 \u0434\u0430\u0439 \u043d\u0430\u043c \u0441\u0451\u043d\u043d\u044f&raquo;. \u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u043c\u043e\u0436\u043d\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0441\u044d\u043d\u0441\u0435. \u0410\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 \u045e \u0411\u043e\u0436\u044b\u043c \u043d\u0430\u043c\u0435\u0440\u044b \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &minus; \u0445\u043b\u0435\u0431 \u0436\u044b\u0446\u0446\u044f, \u0430 \u0445\u043b\u0435\u0431 \u0433\u044d\u0442\u044b \u043d\u0435 \u0445\u043b\u0435\u0431 \u0443\u0441\u0456\u0445, \u0430\u043b\u0435 \u043d\u0430\u0448. \u042f\u043a \u043a\u0430\u0436\u0430\u043c: &laquo;\u041e\u0439\u0447\u0430 \u043d\u0430\u0448&raquo;, \u0431\u043e \u0411\u043e\u0433 &ndash; \u0410\u0439\u0446\u0435\u0446 \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u042f\u0433\u043e \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u0456 \u0432\u0435\u0440\u0430\u0446\u044c, \u0442\u0430\u043a \u0456 \u043a\u043b\u0456\u0447\u0430\u043c: &laquo;\u0425\u043b\u0435\u0431\u0430 \u043d\u0430\u0448\u0430\u0433\u0430&raquo;, \u0431\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0451\u0441\u0446\u044c \u0445\u043b\u0435\u0431\u0430\u043c \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u042f\u0433\u043e \u0426\u0435\u043b\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0443\u0441\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u0434\u0430\u0446\u044c \u0442\u0430\u0433\u043e \u0445\u043b\u0435\u0431\u0430, \u043a\u0430\u0431 \u043c\u044b, \u044f\u043a\u0456\u044f \u043d\u0430\u043b\u0435\u0436\u044b\u043c \u0425\u0440\u044b\u0441\u0442\u0443 \u0456 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u043f\u0440\u044b\u043c\u0430\u0435\u043c, \u044f\u043a \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u042f\u0433\u043e \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044e, \u043d\u0435 \u0431\u044b\u043b\u0456 \u0430\u0434\u043b\u0443\u0447\u0430\u043d\u044b\u044f \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u0446\u044f\u0436\u043a\u043e\u0439 \u043f\u0440\u0430\u0432\u0456\u043d\u044b, \u044f\u043a\u0430\u044f \u0431 \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u0456\u043b\u0430 \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0445\u043b\u0435\u0431. \u0411\u043e \u0441\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f &ndash; \u0445\u043b\u0435\u0431 \u0436\u044b\u0432\u044b, \u044f\u043a\u0456 \u0441\u044b\u0448\u043e\u045e \u0437 \u043d\u0435\u0431\u0430. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u044b \u0445\u043b\u0435\u0431, \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0432\u0435\u0447\u043d\u0430. \u0410 \u0445\u043b\u0435\u0431, \u044f\u043a\u0456 \u042f \u0434\u0430\u043c, &minus; \u0433\u044d\u0442\u0430 \u0426\u0435\u043b\u0430 \u041c\u0430\u0451 \u0434\u0437\u0435\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u0441\u0432\u0435\u0442\u0443&raquo; (\u042f\u043d 6, 51).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435 \u042f\u0433\u043e \u0445\u043b\u0435\u0431, \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0432\u0435\u0447\u043d\u0430, \u0442\u043e \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430\u044f \u0440\u044d\u0447, \u0448\u0442\u043e \u0442\u0430\u043a \u0436\u044b\u0432\u0443\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u042f\u0433\u043e \u0426\u0435\u043b\u0430 \u0456 \u043d\u0430 \u043c\u043e\u0446\u044b \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u043d\u0430\u043b\u0435\u0436\u043d\u0430\u0441\u0446\u0456 \u043f\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044e. \u041d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0442\u0440\u044d\u0431\u0430 \u0431\u0430\u044f\u0446\u0446\u0430 \u0456 \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u043a\u0430\u0431 \u0443 \u0432\u044b\u043d\u0456\u043a\u0443 \u045e\u0441\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0445\u043b\u0435\u0431\u0430 \u0432\u044b \u043d\u0435 \u0430\u0434\u043b\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0426\u0435\u043b\u0430 \u0456 \u043d\u0435 \u0430\u0434\u044b\u0448\u043b\u0456 \u0430\u0434 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043f\u0435\u0440\u0430\u0434 \u0447\u044b\u043c \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0435 \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443 \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u041a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0426\u0435\u043b\u0430 \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0456 \u043f\u0456\u0446\u044c \u041a\u0440\u044b\u0432\u0456 \u042f\u0433\u043e\u043d\u0430\u0439, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043c\u0435\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u0436\u044b\u0446\u0446\u044f&raquo; (\u042f\u043d 6, 53). \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443 \u043f\u0440\u043e\u0441\u0456\u043c \u0430\u0431 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u044b\u043c \u0443\u0434\u0437\u044f\u043b\u0435\u043d\u043d\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0445\u043b\u0435\u0431\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u0436\u044b\u0432\u0443\u0447\u044b \u0456 \u0442\u0440\u044b\u0432\u0430\u044e\u0447\u044b \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u043c\u044b \u043d\u0435 \u0430\u0434\u0434\u0430\u043b\u0456\u043b\u0456\u0441\u044f \u0430\u0434 \u042f\u0433\u043e \u0430\u0441\u0432\u044f\u0447\u0430\u043b\u044c\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0456 \u0456 \u0430\u0434 \u042f\u0433\u043e \u0426\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0442\u044b\u043c \u0442\u0430\u043a\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u043f\u0440\u043e\u0441\u0456\u043c \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u044f \u0433\u0440\u0430\u0445\u043e\u045e: &laquo;\u0410\u0434\u043f\u0443\u0441\u0446\u0456 \u043d\u0430\u043c \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u043d\u0430\u0448\u044b\u044f, \u044f\u043a \u0456 \u043c\u044b \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0435\u043c \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b\u043c \u043d\u0430\u0448\u044b\u043c&raquo;. \u041f\u0430\u0441\u043b\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0430\u0431 \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0443 \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c \u0430\u0431 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0456 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430, \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u0430 \u0456 \u0430\u0431\u0430\u0447\u043b\u0456\u0432\u0430 \u043f\u0440\u0430\u0437 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u0435 \u0434\u0430 \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0430\u0431 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0456 \u0433\u0440\u0430\u0445\u043e\u045e \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u043c, \u0448\u0442\u043e \u043c\u044b &minus; \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0456. \u041a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u045e\u0437\u0432\u044b\u0448\u0430\u045e\u0441\u044f \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u0430, \u0443\u0437\u043d\u043e\u0441\u044f\u0447\u044b\u0441\u044f, \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u045e \u0441\u044f\u0431\u0435, \u0437\u0430\u043a\u043b\u0456\u043a \u0434\u0430 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0430\u0431 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0456 \u0433\u0440\u0430\u0445\u043e\u045e \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043d\u0430\u043c, \u0448\u0442\u043e \u043c\u044b \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u0434\u0430\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u0432. \u042f\u043d \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u043d\u0430\u0441 \u0443 \u0441\u0432\u0430\u0456\u043c \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456: &laquo;\u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u043d\u0435 \u043c\u0430\u0435\u043c \u0433\u0440\u0430\u0445\u0443, \u0430\u0448\u0443\u043a\u0432\u0430\u0435\u043c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u0456 \u043d\u044f\u043c\u0430 \u045e \u043d\u0430\u0441 \u043f\u0440\u0430\u045e\u0434\u044b. \u041a\u0430\u043b\u0456 \u0436 \u0432\u044b\u0437\u043d\u0430\u0451\u043c \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f, \u0442\u043e \u0401\u043d, \u0432\u0435\u0440\u043d\u044b \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u043c \u0433\u0440\u0430\u0445\u0456&raquo; (1 \u042f\u043d 1, 8-9). \u0423 \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0437\u043c\u044f\u0448\u0447\u0430\u044e\u0446\u0446\u0430 \u0434\u0437\u0432\u0435 \u043f\u0440\u0430\u045e\u0434\u044b: \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0430\u0431 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0456 \u0433\u0440\u0430\u0445\u043e\u045e, \u043f\u0430-\u0434\u0440\u0443\u0433\u043e\u0435, \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435, \u0431\u043e \u0430\u0431 \u0456\u043c \u043f\u0440\u043e\u0441\u0456\u043c. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0432\u0435\u0440\u043d\u044b\u043c, \u0431\u043e \u0441\u043f\u0430\u045e\u043d\u044f\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u044f \u0433\u0440\u0430\u0445\u043e\u045e. \u0422\u043e\u0439, \u0445\u0442\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043d\u0430\u043c \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0430\u0431 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0456 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e \u0456 \u0433\u0440\u0430\u0445\u043e\u045e, \u0430\u0431\u044f\u0446\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 31 (30), 2\u0430. 4; 25 (24), 18<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u044f \u0448\u0443\u043a\u0430\u044e \u043f\u0440\u044b\u0441\u0442\u0430\u043d\u0456\u0448\u0447\u0430, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0443 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b \u043d\u0430\u0432\u0435\u043a\u0456. \u0411\u043e \u0422\u044b \u043c\u0430\u044f \u0441\u043a\u0430\u043b\u0430 \u0456 \u043c\u0430\u044f \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044f, <span style=\"color: #ff0000;\">*<\/span> \u0434\u0437\u0435\u043b\u044f \u0456\u043c\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u043a\u0456\u0440\u0443\u0439 \u043c\u043d\u043e\u044e \u0456 \u0432\u044f\u0434\u0437\u0456 \u043c\u044f\u043d\u0435. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u043b\u044f\u043d\u044c \u043d\u0430 \u043c\u0430\u0451 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435 \u0456 \u043c\u0443\u043a\u0443 \u0456 \u0434\u0430\u0440\u0443\u0439 \u0443\u0441\u0435 \u0433\u0440\u0430\u0445\u0456 \u043c\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0437\u0435\u043b\u044f \u0456\u043c\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u043a\u0456\u0440\u0443\u0439 \u043c\u043d\u043e\u044e \u0456 \u0432\u044f\u0434\u0437\u0456 \u043c\u044f\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"116","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u041f\u0430\u043d\u0441\u043a\u0443\u044e&raquo; \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 23-24: CSEL 3, 284-285)<\/span><br \/><span style=\"color: #ff0000;\">\u042f\u043a \u0434\u0437\u0435\u0446\u0456 \u0411\u043e\u0436\u044b\u044f \u0431\u0443\u0434\u0437\u0435\u043c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0411\u043e\u0436\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430 \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0430\u0431 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0456 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0434\u0430\u0434\u0430\u045e \u044f\u043a \u0431\u044b \u0437\u0430\u043a\u043e\u043d, \u044f\u043a\u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u0432\u0430\u0435 \u043d\u0430\u0441 \u0443\u043c\u043e\u0432\u0430\u0439 \u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435\u043c, \u043a\u0430\u0431 \u043c\u044b \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u044f \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e \u0443 \u0442\u0430\u043a\u043e\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456, \u0443 \u044f\u043a\u043e\u0439 \u043c\u044b \u0441\u0430\u043c\u0456 \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0435\u043c \u0456\u0445 \u043d\u0430\u0448\u044b\u043c \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b\u043c. \u041d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e, \u043a\u0430\u043b\u0456 \u0441\u0430\u043c\u0456 \u043d\u0435 \u043f\u0440\u0430\u0431\u0430\u0447\u044b\u043c \u043d\u0430\u0448\u044b\u043c \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b\u043c. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u0443 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043a\u0430\u0436\u0430: &laquo;\u042f\u043a\u043e\u0439 \u043c\u0435\u0440\u0430\u044e \u043c\u0435\u0440\u0430\u0435\u0446\u0435, \u0442\u0430\u043a\u043e\u0439 \u0456 \u0432\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043c\u0435\u0440\u0430\u043d\u0430&raquo; (\u041c\u0446 7, 2). \u0421\u043b\u0443\u0433\u0430, \u044f\u043a\u043e\u043c\u0443 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u0434\u0430\u0440\u0430\u0432\u0430\u045e \u0443\u0432\u0435\u0441\u044c \u0434\u043e\u045e\u0433, \u0431\u044b\u045e \u043a\u0456\u043d\u0443\u0442\u044b \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u0443, \u0431\u043e \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0434\u0430\u0440\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0439\u043c\u0443 \u0441\u0430\u0441\u043b\u0443\u0433\u0443. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0431\u044b\u0446\u044c \u0434\u043e\u0431\u0440\u044b\u043c \u0434\u0430 \u0441\u0430\u0441\u043b\u0443\u0433\u0456, \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0434 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u0437 \u0443\u0441\u0451\u0439 \u0441\u0443\u0440&rsquo;\u0451\u0437\u043d\u0430\u0441\u0446\u044e \u044f\u0448\u0447\u044d \u043c\u0430\u0446\u043d\u0435\u0439 \u043f\u0430\u045e\u0442\u0430\u0440\u044b\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443 \u0441\u0432\u0430\u0456\u0445 \u043d\u0430\u043a\u0430\u0437\u0430\u0445: &laquo;\u0406 \u043a\u0430\u043b\u0456 \u0441\u0442\u0430\u0456\u0446\u0435 \u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0435, &minus; \u043a\u0430\u0436\u0430, &minus; \u0434\u0430\u0440\u0443\u0439\u0446\u0435, \u043a\u0430\u043b\u0456 \u0448\u0442\u043e \u043c\u0430\u0435\u0446\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043a\u0430\u0433\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c, \u043a\u0430\u0431 \u0456 \u0410\u0439\u0446\u0435\u0446 \u0432\u0430\u0448, \u044f\u043a\u0456 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445, \u0434\u0430\u0440\u0430\u0432\u0430\u045e \u0432\u0430\u043c \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u0432\u0430\u0448\u044b\u044f&raquo; (\u041c\u043a 11, 25). \u0423 \u0434\u0437\u0435\u043d\u044c \u0441\u0443\u0434\u0430 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0440\u0430\u0437&rsquo;\u044f\u0441\u043d\u0435\u043d\u043d\u044f, \u0431\u043e \u0431\u0443\u0434\u0437\u0435\u0448 \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b \u0441\u0432\u0430\u0456\u043c \u0443\u043b\u0430\u0441\u043d\u044b\u043c \u0441\u0443\u0434\u043e\u043c \u0456 \u045e \u0441\u0430\u0431\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u0435\u0448 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u0456\u043d\u0448\u0430\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e, \u043a\u0430\u0431 \u0443 \u042f\u0433\u043e \u0434\u043e\u043c\u0435 \u0436\u044b\u043b\u0456 \u0433\u043e\u0434\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456, \u043f\u043e\u045e\u043d\u044b\u044f \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u0456. \u0425\u043e\u0447\u0430, \u043a\u0430\u0431 \u043c\u044b \u0437\u0430\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0442\u0430\u043a\u0456\u043c\u0456, \u044f\u043a\u0456\u043c\u0456 \u0401\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u043f\u0430\u045e\u0442\u043e\u0440\u043d\u0430\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435, \u043a\u0430\u0431 \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u0411\u043e\u0436\u044b\u044f \u043c\u044b \u0442\u0440\u044b\u0432\u0430\u043b\u0456 \u045e \u0411\u043e\u0436\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0456, \u043a\u0430\u0431 \u043c\u0430\u044e\u0447\u044b \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445, \u043c\u0435\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u044b\u044f \u0434\u0443\u043c\u043a\u0456 \u0456 \u043f\u0430\u0447\u0443\u0446\u0446\u0456. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443 \u0411\u043e\u0433 \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0435 \u0430\u0445\u0432\u044f\u0440\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u045e \u043d\u044f\u0437\u0433\u043e\u0434\u0437\u0435. \u0422\u0430\u043a\u043e\u043c\u0443 \u0440\u0430\u0456\u0446\u044c \u0430\u0434\u044b\u0441\u0446\u0456 \u0430\u0434 \u0430\u043b\u0442\u0430\u0440\u0430 \u0456 \u043f\u0430\u044f\u0434\u043d\u0430\u0446\u0446\u0430 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0431\u0440\u0430\u0442\u0430\u043c, \u043a\u0430\u0431 \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u044f\u043a\u0456\u044f \u045e\u0437\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u045e \u0441\u043f\u0430\u043a\u043e\u0456, \u0431\u044b\u043b\u0456 \u043f\u0440\u044b\u043d\u044f\u0442\u044b\u044f \u0411\u043e\u0433\u0430\u043c. \u041d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0448 \u0441\u043f\u0430\u043a\u043e\u0439, \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u043a\u0430\u044f \u0437\u0433\u043e\u0434\u0430, \u043d\u0430\u0440\u043e\u0434, \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b \u0435\u0434\u043d\u0430\u0441\u0446\u044e \u0410\u0439\u0446\u0430, \u0421\u044b\u043d\u0430 \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0410\u0431\u044d\u043b\u044c \u0456 \u041a\u0430\u0456\u043d \u044f\u043a \u043f\u0435\u0440\u0448\u044b\u044f \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u0430\u0445\u0432\u044f\u0440\u0443, \u0411\u043e\u0433 \u043d\u0435 \u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0434\u0430\u0440\u044b, \u0430\u043b\u0435 \u043d\u0430 \u0456\u0445 \u0441\u044d\u0440\u0446\u0430. \u0422\u0430\u043c\u0443 \u043b\u044e\u0431\u044b \u0431\u044b\u045e \u0411\u043e\u0433\u0443 \u0434\u0430\u0440 \u0442\u0430\u0433\u043e, \u0447\u044b\u0451 \u0441\u044d\u0440\u0446\u0430 \u0431\u044b\u043b\u043e \u043c\u0456\u043b\u044b\u043c. \u0410\u0431\u044d\u043b\u044c, \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0441\u0432\u0430\u0451\u0439 \u0430\u0445\u0432\u044f\u0440\u0430\u0439, \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u0430\u0439 \u0411\u043e\u0433\u0443 \u045e \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0441\u044d\u0440\u0446\u0430, \u043f\u0430\u0432\u0443\u0447\u044b\u045e \u0456\u043d\u0448\u044b\u0445, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u044c \u0441\u0432\u043e\u0439 \u0434\u0430\u0440, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u0446\u0446\u0430 \u0434\u0430 \u0430\u043b\u0442\u0430\u0440\u0430 \u0437 \u0411\u043e\u0436\u0430\u0439 \u0431\u043e\u044f\u0437\u0437\u044e, \u0443 \u043f\u0440\u0430\u0441\u0442\u0430\u0446\u0435, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0436\u044b\u0432\u0443\u0447\u044b \u045e \u0437\u0433\u043e\u0434\u0437\u0435. \u0410\u0431\u044d\u043b\u044c \u0441\u0430\u043c \u0445\u0443\u0442\u043a\u0430 \u0437\u043c\u043e\u0433 \u0441\u0442\u0430\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0434\u043b\u044f \u0411\u043e\u0433\u0430. \u041f\u043e\u045e\u043d\u044b \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u044f\u043a \u043f\u0435\u0440\u0448\u044b \u043c\u0443\u0447\u0430\u043d\u0456\u043a \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u045e \u0442\u0440\u044b\u0443\u043c\u0444\u0430\u043c \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0456 \u041c\u0443\u043a\u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430. \u0422\u0430\u043a\u0456\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0430\u0434 \u041f\u0430\u043d\u0430, \u0442\u0430\u043a\u0456\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u041f\u0430\u043d\u0430\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u0434\u0437\u0435\u043d\u044c \u0441\u0443\u0434\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u043d\u044f\u0437\u0433\u043e\u0434\u0437\u0435 \u0456 \u043d\u0435\u043f\u0440\u044b\u044f\u0437\u043d\u0430\u0441\u0446\u0456, \u0445\u0442\u043e \u043d\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u043f\u0430\u043a\u043e\u044e \u0437 \u0431\u0440\u0430\u0442\u0430\u043c\u0456, \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 &minus; \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u0456 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f &minus; \u0431\u044b\u045e \u0432\u044b\u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0431\u043e \u043d\u0430\u0441\u0456\u045e \u0456\u043c\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430, \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0443\u0446\u044c \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u043d\u043d\u044f \u045e \u0431\u0440\u0430\u0442\u043d\u044f\u0439 \u043d\u044f\u0437\u0433\u043e\u0434\u0437\u0435. \u0411\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0442\u043e\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u0437\u0430\u0431\u043e\u0439\u0446\u0430&raquo; (1 \u042f\u043d 3, 15). \u0417\u0430\u0431\u043e\u0439\u0446\u0430 \u0436 \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0456 \u0436\u044b\u0446\u044c \u0437 \u0411\u043e\u0433\u0430\u043c. \u041d\u0435 \u043c\u043e\u0436\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0431\u044b\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0445\u0430\u0446\u0435\u045e \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u042e\u0434\u0443, \u0430 \u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 4, 1. 3. 4b; \u0420\u044b\u043c 15, 5\u0430. 6\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u043b\u044e \u0432\u0430\u0441 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f, \u044f\u043a\u0456\u043c \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u0441\u0442\u0430\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e. <span style=\"color: #ff0000;\">*<\/span> \u0412\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u045e \u0430\u0434\u043d\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410 \u0411\u043e\u0433 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f \u043d\u044f\u0445\u0430\u0439 \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0432\u0430\u0441 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430\u043c\u0456 \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u044e, \u043a\u0430\u0431 \u0432\u044b \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430, \u0430\u0434\u043d\u044b\u043c\u0456 \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u045e \u0430\u0434\u043d\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"117","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u041f\u0430\u043d\u0441\u043a\u0443\u044e&raquo; \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 28-30: CSEL 3, 287-289)<\/span><br \/><span style=\"color: #ff0000;\">\u0422\u0440\u044d\u0431\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0430\u043b\u0435 \u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0436 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0433\u0430, \u0431\u0440\u0430\u0442\u044b \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0447\u0430\u043c\u0443 \u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u041f\u0430\u043d\u0441\u043a\u0430\u0439 \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u043d\u0430\u0441 \u0411\u043e\u0433? \u0423 \u0433\u044d\u0442\u044b\u0445 \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u0401\u043d \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0443\u0441\u0435 \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b. \u0423\u0436\u043e \u0434\u0430\u045e\u043d\u043e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u044f\u0435 \u043f\u0440\u0430\u0440\u043e\u043a \u0406\u0441\u0430\u044f, \u043a\u0430\u043b\u0456 \u043f\u043e\u045e\u043d\u044b \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u043f\u0440\u0430 \u0432\u0435\u043b\u0456\u0447 \u0456 \u0434\u0430\u0431\u0440\u044b\u043d\u044e \u0411\u043e\u0433\u0430. \u0428\u0442\u043e \u0433\u044d\u0442\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u0431\u0443\u0434\u0437\u0435 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0446\u044c \u0443\u0441\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0431\u043e \u0411\u043e\u0433 \u0443\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0441\u043a\u0430\u0436\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0430\u0435 \u0441\u043b\u043e\u0432\u0430. \u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 &minus; \u041f\u0430\u043d \u043d\u0430\u0448, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430 \u0441\u0430\u0431\u0440\u0430\u045e\u0448\u044b \u0432\u0443\u0447\u043e\u043d\u044b\u0445 \u0456 \u043d\u0435\u0432\u0443\u043a\u0430\u045e, \u043f\u0435\u0440\u0430\u0434\u0430\u0432\u0430\u045e \u0443\u0441\u0456\u043c: \u043c\u0443\u0436\u0447\u044b\u043d\u0430\u043c \u0456 \u0436\u044b\u043d\u0447\u044b\u043d\u0430\u043c, \u043c\u0430\u043b\u0430\u0434\u044b\u043c \u0456 \u0441\u0442\u0430\u0440\u044b\u043c, \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0448\u0442\u043e \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u041f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u045e \u0456\u0445 \u0441\u0446\u0456\u0441\u043b\u0430, \u043a\u0430\u0431 \u043f\u0430\u043c\u044f\u0446\u044c \u043d\u0435 \u043d\u0443\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0432\u0443\u043a\u0456, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0437\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441 \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0448\u0442\u043e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0434\u043b\u044f \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0432\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u045e, \u0443 \u0447\u044b\u043c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430\u0441\u0446\u044e, \u0432\u044b\u044f\u0432\u0456\u045e \u044f\u0433\u043e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u0410 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0426\u044f\u0431\u0435, \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430&raquo; (\u042f\u043d 17, 3). \u0417 \u043a\u043d\u0456\u0433 \u0417\u0430\u043a\u043e\u043d\u0443 \u0456 \u041f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0432\u044b\u0431\u0440\u0430\u045e \u0430\u0441\u043d\u043e\u045e\u043d\u044b\u044f \u0456 \u0441\u0430\u043c\u044b\u044f \u0432\u0430\u0436\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456: &laquo;\u041f\u0435\u0440\u0448\u0430\u044f \u0442\u0430\u043a\u0430\u044f: &ldquo;\u0421\u043b\u0443\u0445\u0430\u0439, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u041f\u0430\u043d \u0411\u043e\u0433 \u043d\u0430\u0448 &ndash; \u041f\u0430\u043d \u0430\u0434\u0437\u0456\u043d\u044b; \u043b\u044e\u0431\u0456 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u0439 \u0442\u0432\u0430\u0451\u0439, \u0456 \u045e\u0441\u0456\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0456 \u045e\u0441\u0451\u0439 \u043c\u043e\u0446\u0430\u044e \u0442\u0432\u0430\u0451\u0439&rdquo;. \u0414\u0440\u0443\u0433\u0430\u044f: &ldquo;\u041b\u044e\u0431\u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435&rdquo;. \u041d\u0430 \u0433\u044d\u0442\u044b\u0445 \u0434\u0437\u0432\u044e\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u0445 \u0433\u0440\u0443\u043d\u0442\u0443\u0435\u0446\u0446\u0430 \u045e\u0432\u0435\u0441\u044c \u0417\u0430\u043a\u043e\u043d \u0456 \u041f\u0440\u0430\u0440\u043e\u043a\u0456&raquo; (\u043f\u0430\u0440. \u041c\u043a 12, 29-31). \u0406 \u044f\u0448\u0447\u044d: &laquo;\u0423\u0441\u0451, \u0448\u0442\u043e \u0445\u043e\u0447\u0430\u0446\u0435, \u043a\u0430\u0431 \u0440\u0430\u0431\u0456\u043b\u0456 \u0432\u0430\u043c \u043b\u044e\u0434\u0437\u0456, \u0456 \u0432\u044b \u0456\u043c \u0440\u0430\u0431\u0456\u0446\u0435, \u0431\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u0417\u0430\u043a\u043e\u043d \u0456 \u041f\u0440\u0430\u0440\u043e\u043a\u0456&raquo; (\u043f\u0430\u0440. \u041c\u0446 7, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0432\u0443\u0447\u044b\u045e \u043d\u0430\u0441 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043b\u043e\u0432\u0430\u043c, \u0430\u043b\u0435 \u0456 \u0447\u044b\u043d\u0430\u043c. \u041c\u0430\u043b\u0456\u045e\u0441\u044f \u0447\u0430\u0441\u0442\u0430 \u0456 \u0433\u043e\u0440\u0430\u0447\u0430, \u0434\u0430\u044e\u0447\u044b \u043d\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f. \u0411\u043e \u0447\u044b\u0442\u0430\u0435\u043c: &laquo;\u0410 \u0401\u043d \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0443 \u043f\u0443\u0441\u0442\u044b\u043d\u043d\u044b\u044f \u043c\u0435\u0441\u0446\u044b \u0456 \u043c\u0430\u043b\u0456\u045e\u0441\u044f&raquo; (\u041b\u043a 5, 16). \u0410 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: &laquo;\u0401\u043d \u0443\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u0433\u0430\u0440\u0443 \u043f\u0430\u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0456 \u043f\u0440\u0430\u0432\u0451\u045e \u0443\u0441\u044e \u043d\u043e\u0447 \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0434\u0430 \u0411\u043e\u0433\u0430&raquo; (\u041b\u043a 6, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0456 \u043f\u0440\u0430\u0441\u0456\u045e \u043d\u0435 \u0437\u0430 \u0441\u044f\u0431\u0435, \u0431\u043e \u044f\u043a \u0436\u0430 \u043c\u0435\u045e \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0430\u0431 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c, \u0430\u043b\u0435 \u043f\u0440\u0430\u0441\u0456\u045e \u0437\u0430 \u043d\u0430\u0441 \u0433\u0440\u044d\u0448\u043d\u044b\u0445, \u0430\u0431 \u0447\u044b\u043c \u0441\u0430\u043c \u043a\u0430\u0436\u0430 \u041f\u044f\u0442\u0440\u0443: &laquo;\u0421\u0430\u0442\u0430\u043d\u0430 \u0434\u0430\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u043f\u0440\u0430\u0441\u0435\u044f\u0446\u044c \u0432\u0430\u0441, \u044f\u043a \u043f\u0448\u0430\u043d\u0456\u0446\u0443, \u0430\u043b\u0435 \u042f \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u045e \u0437\u0430 \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u043d\u0435 \u0437\u043d\u0456\u043a\u043b\u0430 \u0442\u0432\u0430\u044f \u0432\u0435\u0440\u0430&raquo; (\u041b\u043a 22, 31-32). \u0406 \u0442\u0443\u0442 \u0436\u0430 \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0434\u0430 \u0410\u0439\u0446\u0430 \u0437\u0430 \u045e\u0441\u0456\u0445: &laquo;\u041d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430 \u0456\u0445 \u043f\u0440\u0430\u0448\u0443, \u0430\u043b\u0435 \u0456 \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u041c\u044f\u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430 \u0456\u0445\u043d\u044f\u0433\u0430, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e, \u044f\u043a \u0422\u044b, \u041e\u0439\u0447\u0430, \u0443\u0432\u0430 \u041c\u043d\u0435, \u0456 \u042f \u045e \u0422\u0430\u0431\u0435, \u043a\u0430\u0431 \u0456 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u045e \u041d\u0430\u0441&raquo; (\u042f\u043d 17, 20-21).<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0430\u044f \u0436 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0434\u0430\u0431\u0440\u044b\u043d\u044f \u0411\u043e\u0433\u0430; \u044f\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u043a\u043b\u043e\u043f\u0430\u0442 \u043f\u0440\u0430 \u043d\u0430\u0448\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435! \u041d\u0435\u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0431\u044b\u043b\u043e \u042f\u043c\u0443 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c \u043d\u0430\u0441 \u0441\u0432\u0430\u0451\u0439 \u041a\u0440\u044b\u0432\u0451\u044e, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0437\u0430 \u043d\u0430\u0441. \u0413\u043b\u044f\u0434\u0437\u0456, \u0447\u0430\u0433\u043e \u0447\u0430\u043a\u0430\u0435 \u0442\u043e\u0439, \u044f\u043a\u0456 \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441: \u043a\u0430\u0431 \u043c\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e, \u044f\u043a \u0430\u0434\u043d\u043e \u0410\u0439\u0446\u0435\u0446 \u0456 \u0421\u044b\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 25 (24), 1-2\u0430. 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430 \u0426\u044f\u0431\u0435, \u043e \u041f\u0430\u043d\u0435, \u0443\u0437\u043d\u043e\u0448\u0443 \u044f \u0434\u0443\u0448\u0443 \u043c\u0430\u044e. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e\u0436\u0430, \u043d\u0430 \u0426\u044f\u0431\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0443 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044f\u0434\u0437\u0456 \u043c\u044f\u043d\u0435 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0422\u0432\u0430\u0451\u0439 \u0456 \u043d\u0430\u0432\u0443\u0447\u044b, \u0431\u043e \u0422\u044b \u0411\u043e\u0433 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043c\u0430\u0439\u0433\u043e, \u043d\u0430 \u0426\u044f\u0431\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0436\u0430, \u043d\u0430 \u0426\u044f\u0431\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0443 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"121","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0421\u0432\u044f\u0442\u0443\u044e \u0422\u0440\u043e\u0439\u0446\u0443&raquo; \u0441\u0432. \u0424\u0430\u0443\u0441\u0442\u044b\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 30-40: C\u0421L 69, 340-341)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u0430\u043b\u0430\u0434\u0430\u0440 \u0456 \u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0430\u0432\u0435\u043a\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0446\u0435\u043b\u0430, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0441\u0442\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c. \u0401\u043d \u043a\u0430\u0440\u043e\u043b\u044c \u0456 \u0441\u0432\u044f\u0442\u0430\u0440, \u0431\u043e \u0417\u0431\u0430\u045e\u0446\u0443 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043d\u0435\u0441\u0442\u0430\u0432\u0430\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0448\u0442\u043e \u0401\u043d \u0441\u0430\u043c \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0441\u0432\u0430\u0451 \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043a\u0430\u0440\u0430\u043b\u0451\u043c: &laquo;\u042f \u0431\u044b\u045e \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u0406\u043c \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u043d\u0430 \u0421\u0456\u0451\u043d\u0435, \u043d\u0430 \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b&raquo; (\u043f\u0430\u0440. \u041f\u0441 2, 6). \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u044f\u043a \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u042f\u0433\u043e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0443\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c: &laquo;\u0422\u044b \u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0430\u0432\u0435\u043a\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430&raquo; (\u041f\u0441 110 [109], 4).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0430\u0440\u043e\u043d \u0443 \u0421\u0442\u0430\u0440\u044b\u043c \u0417\u0430\u043f\u0430\u0432\u0435\u0446\u0435 \u043f\u0435\u0440\u0448\u044b\u043c \u0431\u044b\u045e \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u043d\u044b \u043d\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430. \u0410\u0434\u043d\u0430\u043a \u0411\u043e\u0433 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e &laquo;\u043d\u0430 \u045e\u0437\u043e\u0440 \u0410\u0430\u0440\u043e\u043d\u0430&raquo;, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0434\u0443\u043c\u0430\u045e, \u0448\u0442\u043e \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0417\u0431\u0430\u045e\u0446\u044b \u043c\u043e\u0436\u043d\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443. \u0421\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0436 \u0410\u0430\u0440\u043e\u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u043b\u0430\u0441\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0435, \u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0456\u043d\u0448\u044b\u0445, \u0431\u043e \u0401\u043d \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u041f\u0456\u0441\u0430\u043d\u043d\u044f: &laquo;\u0422\u044b \u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0430\u0432\u0435\u043a\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0441\u0432\u0430\u0456\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c \u0446\u0435\u043b\u0435 \u0417\u0431\u0430\u045e\u0446\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u0456 \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u043d\u044b\u043c \u043d\u0435 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c, \u0430\u043b\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u0430. \u0422\u044b\u044f, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e \u0406\u0437\u0440\u0430\u044d\u043b\u0456 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435 \u043d\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0430\u0431\u043e \u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0456\u0441\u044f \u043a\u0430\u0440\u0430\u043b\u044f\u043c\u0456 \u0430\u0431\u043e \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456. \u0410\u0434\u043d\u0430\u043a \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0431\u044b\u045e \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u0430\u043b\u0435 \u0446\u0456 \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u0446\u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c. \u0422\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u044f \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u045e\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u044f\u043a \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0417\u0430\u043a\u043e\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0445\u043e\u0446\u044c \u043d\u0456\u0445\u0442\u043e \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u0431\u044b\u045e \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u0430\u0434\u043d\u0430\u043a, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0435 \u0430\u0431\u043e \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0430\u0435 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435, \u043f\u0440\u044b\u043c\u0430\u045e \u0456\u043c\u044f \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430. \u0417\u0431\u0430\u045e\u0446\u0430, \u044f\u043a \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a, \u0431\u044b\u045e \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u043d\u044b \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u043a\u0430\u0431 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u043f\u0440\u0430 \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u044b \u041f\u0456\u0441\u0430\u043d\u043d\u044f: &laquo;\u0422\u0430\u043c\u0443 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0446\u044f\u0431\u0435 \u0411\u043e\u0433, \u0442\u0432\u043e\u0439 \u0411\u043e\u0433, \u0430\u043b\u0435\u0435\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0442\u0432\u0430\u0456\u0445&raquo; (\u041f\u0441 45 [44], 8). \u0401\u043d \u0431\u044b\u045e \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u043d\u044b \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0456\u043d\u0448\u044b\u0445, \u0431\u043e \u042f\u0433\u043e \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435 \u0431\u044b\u043b\u043e \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u0430 \u0430\u043b\u0435\u0435\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0441\u0430\u043c\u0456\u043c \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0442\u0430\u043a \u0431\u044b\u043b\u043e, \u043c\u044b \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f \u0430\u0434 \u0417\u0431\u0430\u045e\u0446\u044b. \u041a\u0430\u043b\u0456 \u0401\u043d \u0443\u0437\u044f\u045e \u043a\u043d\u0456\u0433\u0443 \u0406\u0441\u0430\u0456, \u0430\u0434\u043a\u0440\u044b\u045e \u044f\u0435 \u0456 \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u045e: &laquo;\u0414\u0443\u0445 \u041f\u0430\u043d\u0430 \u043d\u0430 \u041c\u043d\u0435, \u0431\u043e \u0401\u043d \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u041c\u044f\u043d\u0435&raquo; (\u041b\u043a 4, 18), \u0442\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u045e, \u0448\u0442\u043e \u0433\u044d\u0442\u0430\u0435 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u045e\u0436\u043e \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u041f\u0451\u0442\u0440, \u043a\u043d\u044f\u0437\u044c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043a\u0430\u043b\u0456 &ndash; \u044f\u043a \u0430\u043f\u0430\u0432\u044f\u0434\u0430\u044e\u0446\u044c \u0414\u0437\u0435\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e &ndash; \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0434\u0430 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0433\u0430 \u0456 \u0431\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u0430\u0433\u0430 \u0441\u043e\u0442\u043d\u0456\u043a\u0430, \u0432\u0443\u0447\u044b\u045e, \u0448\u0442\u043e \u0433\u044d\u0442\u044b\u043c \u0430\u043b\u0435\u0435\u043c, \u044f\u043a\u0456 \u045e\u043a\u0430\u0437\u0430\u045e \u043d\u0430 \u0417\u0431\u0430\u045e\u0446\u0443 \u044f\u043a \u043d\u0430 \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u0456\u043d\u0430\u043a\u0448 \u043a\u0430\u0436\u0443\u0447\u044b, \u0411\u043e\u0436\u0430\u044f \u043c\u043e\u0446. \u041c\u0456\u0436 \u0456\u043d\u0448\u044b\u043c \u0451\u043d \u0442\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0412\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0430\u0434\u0431\u044b\u0432\u0430\u043b\u0430\u0441\u044f \u043f\u0430 \u045e\u0441\u0451\u0439 \u042e\u0434\u044d\u0456, \u043f\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b \u0430\u0434 \u0413\u0430\u043b\u0456\u043b\u0435\u0456, \u043f\u0430\u0441\u043b\u044f \u0445\u0440\u043e\u0441\u0442\u0443, \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430\u0433\u0430 \u042f\u043d\u0430\u043c. \u042f\u043a \u0411\u043e\u0433 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0456 \u043c\u043e\u0446\u0430\u0439 \u0415\u0437\u0443\u0441\u0430 \u0437 \u041d\u0430\u0437\u0430\u0440\u044d\u0442\u0430, \u044f\u043a\u0456 \u0445\u0430\u0434\u0437\u0456\u045e, \u0440\u043e\u0431\u044f\u0447\u044b \u0434\u0430\u0431\u0440\u043e \u0456 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u045e\u0441\u0456\u0445, \u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043d\u044b\u0445 \u0434&rsquo;\u044f\u0431\u043b\u0430\u043c, \u0431\u043e \u0437 \u0406\u043c \u0431\u044b\u045e \u0411\u043e\u0433&raquo; (\u0414\u0437 10, 37-38).<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0431\u0430\u0447\u044b\u0448, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u041f\u0451\u0442\u0440 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0443 \u0441\u0432\u0430\u0456\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c \u0446\u0435\u043b\u0435 \u0431\u044b\u045e \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u043d\u044b \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0456 \u043c\u043e\u0446\u0430\u044e. \u0422\u0430\u043c\u0443 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0415\u0437\u0443\u0441 \u0441\u0442\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u044e \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0441\u0442\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0431\u0440 6, 20<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u0437\u0432\u0430\u0436\u0446\u0435, \u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d &ndash; \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430 \u042f\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u043d\u0435 \u043c\u0430\u0435 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0456 \u043d\u0435 \u043c\u0430\u0435 \u043a\u0430\u043d\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043a \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a \u0401\u043d \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0430 \u043d\u0430\u0441 \u0437\u0430 \u0437\u0430\u0441\u043b\u043e\u043d\u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u043d\u0430\u0432\u0435\u043a\u0456 \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d &ndash; \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430 \u042f\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u043d\u0435 \u043c\u0430\u0435 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0456 \u043d\u0435 \u043c\u0430\u0435 \u043a\u0430\u043d\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"122","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u041f\u0430\u043d\u0441\u043a\u0443\u044e&raquo; \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(PG 46, 254-255)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d &minus; \u0434\u0440\u0443\u0433\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432. \u041f\u0430\u0432\u0435\u043b \u043b\u0435\u043f\u0448 \u0437\u0430 \u045e\u0441\u0456\u0445 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u043a\u0456\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u0456\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456, \u044f\u043a\u0456\u043c \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u045e \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456\u043c\u044f. \u0401\u043d \u0437 \u0442\u0430\u043a\u043e\u0439 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0441\u0446\u044e \u0456\u0448\u043e\u045e \u042f\u0433\u043e \u0441\u043b\u0435\u0434\u0430\u043c, \u0448\u0442\u043e \u045e \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d\u0430. \u041a\u0430\u043d\u0435\u0448\u043d\u0435, \u043f\u0440\u0430\u0437 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u045e\u0441\u044f \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0437\u043e\u0440\u0443, \u0448\u0442\u043e \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043d\u0435 \u041f\u0430\u0432\u0435\u043b \u0436\u044b\u0432\u0435 \u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435, \u0430\u043b\u0435 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0414\u0430\u0440\u044d\u0447\u044b, \u0441\u0430\u043c \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0433\u044d\u0442\u0430, \u0446\u0430\u043b\u043a\u0430\u043c \u0443\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u044e\u0447\u044b \u0442\u043e\u0435, \u0448\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u044f\u0433\u043e \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c: &laquo;\u0412\u044b \u0448\u0443\u043a\u0430\u0435\u0446\u0435 \u0434\u043e\u043a\u0430\u0437\u0443, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u043c\u044f\u043d\u0435 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441&raquo; (2 \u041a\u0430\u0440 13, 3), \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: &laquo;\u0406 \u045e\u0436\u043e \u043d\u0435 \u044f \u0436\u044b\u0432\u0443, \u0430 \u0436\u044b\u0432\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441&raquo; (\u0413\u0430\u043b 2, 20).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0433\u044d\u0442\u0430 \u043c\u043e\u0446 \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0430\u044f, \u0441\u043f\u0430\u043a\u043e\u0439, \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0443 \u044f\u043a\u0456\u043c \u0436\u044b\u0432\u0435 \u0411\u043e\u0433, \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435, \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435, \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440, \u041f\u0430\u0441\u0445\u0430, \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u0434\u043b\u044f \u0434\u0443\u0448\u0430\u045e, \u0437\u0437\u044f\u043d\u043d\u0435 \u0445\u0432\u0430\u043b\u044b, \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0411\u043e\u0433\u0430, \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0441\u0432\u0435\u0442\u0443, \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0456 \u043d\u0430\u043f\u043e\u0439, \u0441\u043a\u0430\u043b\u0430 \u0456 \u0432\u0430\u0434\u0430, \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442 \u0432\u0435\u0440\u044b, \u0432\u0443\u0433\u043b\u0430\u0432\u044b \u043a\u0430\u043c\u0435\u043d\u044c, \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0432\u044f\u043b\u0456\u043a\u0456 \u0411\u043e\u0433, \u0413\u0430\u043b\u0430\u0432\u0430 \u0446\u0435\u043b\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u0441\u044f\u0440\u043e\u0434 \u043c\u043d\u043e\u0433\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u043f\u0435\u0440\u0448\u044b\u043d\u0435\u0446 \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u0443\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u043d\u044b \u0445\u0432\u0430\u043b\u043e\u0439 \u0456 \u043f\u0430\u0448\u0430\u043d\u0430\u0439 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0421\u044b\u043d, \u041f\u0430\u043d \u0445\u0432\u0430\u043b\u044b, \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0443\u0441\u0456\u0445 \u0440\u044d\u0447\u0430\u045e, \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043f\u0430\u043a\u043e\u044e, \u043a\u0430\u0440\u043e\u043b\u044c \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0443\u043b\u0430\u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u043d\u0435 \u043c\u0430\u0435 \u043c\u0435\u0436\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u0448\u0447\u044d \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u0456\u043d\u0448\u044b\u043c\u0456 \u0456\u043c\u0451\u043d\u0430\u043c\u0456 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u0456\u0445 \u0442\u0430\u043a \u0448\u043c\u0430\u0442, \u0448\u0442\u043e \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u045e\u0441\u0435 \u043f\u0435\u0440\u0430\u043b\u0456\u0447\u044b\u0446\u044c. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0437\u0431\u044f\u0440\u043e\u043c \u0456\u0445 \u0440\u0430\u0437\u0430\u043c \u0456 \u0441\u0443\u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043c \u0456\u0445 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0456, \u044f\u043d\u044b \u043f\u0430\u043a\u0430\u0436\u0443\u0446\u044c \u043d\u0430\u043c \u0443\u0441\u0451 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043a\u0440\u044b\u044e\u0446\u044c \u042f\u0433\u043e \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0443\u044e \u0432\u0435\u043b\u0456\u0447, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0443\u0445\u0430\u043c \u0456 \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u043c\u044b \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u044f \u044f\u0433\u043e \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u044f \u0434\u0430\u0431\u0440\u044b\u043d\u044f \u0434\u0430\u043b\u0430 \u043d\u0430\u043c \u0441\u0430\u043c\u0430\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435, \u0441\u0430\u043c\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u0441\u0430\u043c\u0430\u0435 \u0411\u043e\u0441\u043a\u0430\u0435 \u0456\u043c\u044f, \u0456 \u043c\u044b, \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f \u0456\u043c\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u0441\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456, \u0442\u043e \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u043c\u044b \u045e \u0441\u0430\u0431\u0435 \u043f\u0430\u043a\u0430\u0437\u0430\u043b\u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0433\u044d\u0442\u0430\u0435 \u0456\u043c\u044f; \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456, \u0430\u043b\u0435 \u043a\u0430\u0431 \u043d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0431\u044b\u043b\u043e \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0456\u043c\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 5, 12; 89 (88), 16b-17a<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0443\u0437\u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u045e\u0441\u0435, \u0445\u0442\u043e \u0448\u0443\u043a\u0430\u0435 \u045e \u0426\u044f\u0431\u0435 \u043f\u0440\u044b\u0442\u0443\u043b\u043a\u0443, \u043d\u044f\u0445\u0430\u0439 \u0432\u0435\u0447\u043d\u0430 \u0432\u0435\u0441\u044f\u043b\u044f\u0446\u0446\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0422\u044b \u0456\u0445 \u0430\u0431\u0430\u0440\u043e\u043d\u0456\u0448, \u0456 \u045e\u0441\u0446\u0435\u0448\u0430\u0446\u0446\u0430 \u0422\u0430\u0431\u043e\u044e \u0442\u044b\u044f, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0422\u0432\u0430\u0451 \u0456\u043c\u044f. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u0445\u0442\u043e \u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u043b\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0422\u0432\u0430\u0439\u0433\u043e, \u041f\u0430\u043d\u0435, \u0456 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0456\u043c\u0435\u043d\u0456 \u0422\u0432\u0430\u0439\u043c\u0443 \u045e\u0432\u0435\u0441\u044c \u0434\u0437\u0435\u043d\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u0456\u0445 \u0430\u0431\u0430\u0440\u043e\u043d\u0456\u0448, \u0456 \u045e\u0441\u0446\u0435\u0448\u0430\u0446\u0446\u0430 \u0422\u0430\u0431\u043e\u044e \u0442\u044b\u044f, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0422\u0432\u0430\u0451 \u0456\u043c\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"123","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0443\u044e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c&raquo; <br \/>\u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(PG 46, 283-286)<\/span><br \/><span style=\"color: #ff0000;\">\u041c\u044b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u0441\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0440\u044b \u0440\u044d\u0447\u044b \u0430\u043a\u0440\u044d\u0441\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0456 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430: \u0434\u0437\u0435\u044f\u043d\u043d\u0435, \u0441\u043b\u043e\u0432\u0430, \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u0435. \u0421\u044f\u0440\u043e\u0434 \u0456\u0445 \u043f\u0435\u0440\u0448\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 \u0437\u0430\u0439\u043c\u0430\u0435 \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u0435. \u041d\u0430 \u0434\u0440\u0443\u0433\u0456\u043c \u043c\u0435\u0441\u0446\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0456 \u0432\u044b\u044f\u045e\u043b\u044f\u0435 \u0434\u0443\u043c\u043a\u0443, \u0448\u0442\u043e \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0456 \u0441\u0444\u0430\u0440\u043c\u0456\u0440\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u045e \u0434\u0443\u0448\u044b. \u041f\u0430\u0441\u043b\u044f \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u044f \u0456 \u043c\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456\u0434\u0437\u0435 \u0434\u0437\u0435\u044f\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0440\u044d\u0430\u043b\u0456\u0437\u0443\u0435 \u043d\u0430\u043c\u0435\u0440, \u044f\u043a\u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u045e \u0440\u043e\u0437\u0443\u043c\u0435. \u041a\u0430\u043b\u0456 \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u0440\u043e\u0437\u043d\u044b\u0445 \u0430\u043a\u0430\u043b\u0456\u0447\u043d\u0430\u0441\u0446\u044f\u045e \u043c\u044b \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435\u043c, \u043c\u044b\u0441\u043b\u0456\u043c \u0446\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u043c, \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u0430\u0435 \u043d\u0430\u0448\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u0447\u044b\u043d \u0456 \u0434\u0443\u043c\u043a\u0430 \u0431\u044b\u043b\u0456 \u0437\u0433\u043e\u0434\u043d\u044b\u044f \u0437 \u0443\u0441\u0456\u043c \u0442\u044b\u043c, \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u043c\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u0442\u0430\u043a\u043e\u0433\u0430 \u043d\u0435 \u0434\u0443\u043c\u0430\u043b\u0456, \u043d\u0435 \u043a\u0430\u0437\u0430\u043b\u0456 \u0456 \u043d\u0435 \u0447\u044b\u043d\u0456\u043b\u0456, \u0448\u0442\u043e \u043c\u0430\u0433\u043b\u043e \u0431 \u043d\u0430\u0441 \u0430\u0434\u0434\u0430\u043b\u0456\u0446\u044c \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u045e\u0437\u043e\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0436 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0433\u0430\u043d\u0430\u0440\u043e\u0432\u0430\u0435 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0443\u0441\u0435 \u0441\u0432\u0430\u0435 \u0434\u0443\u043c\u043a\u0456, \u0441\u043b\u043e\u0432\u044b, \u0443\u0447\u044b\u043d\u043a\u0456 \u0456 \u043f\u0440\u0430\u0432\u044f\u0440\u0430\u0446\u044c, \u0446\u0456 \u0432\u044f\u0434\u0443\u0446\u044c \u044f\u043d\u044b \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0446\u0456 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442 \u0430\u0434\u0434\u0430\u043b\u044f\u044e\u0446\u044c \u0430\u0434 \u042f\u0433\u043e. \u041f\u0430-\u0440\u043e\u0437\u043d\u0430\u043c\u0443 \u043c\u043e\u0436\u043d\u0430 \u0440\u0430\u0431\u0456\u0446\u044c \u0442\u0430\u043a\u0443\u044e \u0432\u044b\u0441\u043e\u043a\u0443\u044e \u0430\u0446\u044d\u043d\u043a\u0443. \u0428\u0442\u043e \u0431 \u043d\u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0430\u0441\u044f, \u043d\u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u043b\u0430\u0441\u044f \u0446\u0456 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u043b\u0430\u0441\u044f \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u0441\u0442\u0440\u0430\u0441\u0446\u0435\u0439, \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043d\u0435 \u0437\u0433\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u0425\u0443\u0442\u0447\u044d\u0439 \u043c\u0430\u0435 \u0430\u0434\u0431\u0456\u0442\u0430\u043a \u0456 \u0440\u044b\u0441\u044b \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a\u0430, \u044f\u043a\u0456 \u0442\u043e\u043f\u0456\u0446\u044c \u043f\u044f\u0440\u043b\u0456\u043d\u044b \u0434\u0443\u0445\u0430 \u045e \u0431\u0430\u0433\u043d\u0435 \u0441\u0442\u0440\u0430\u0441\u0446\u0435\u0439, \u043a\u0430\u0431 \u0437\u0430\u0446\u044c\u043c\u0456\u0446\u044c \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0431\u043b\u044f\u0441\u043a \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0433\u0430 \u043a\u0430\u043c\u0435\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451, \u0448\u0442\u043e \u0447\u044b\u0441\u0442\u0430\u0435 \u0456 \u0432\u043e\u043b\u044c\u043d\u0430\u0435 \u0430\u0434 \u044f\u043a\u043e\u0433\u0430-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043d\u0435\u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0433\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u044f, \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0422\u0440\u043e\u0439\u0446\u044b \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u043f\u0430\u043a\u043e\u044e, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0425\u0442\u043e \u0447\u044d\u0440\u043f\u0430\u0435 \u0437 \u042f\u0433\u043e, \u044f\u043a \u0437 \u0447\u044b\u0441\u0442\u0430\u0439 \u0456 \u043d\u0435\u0437\u0430\u0431\u0440\u0443\u0434\u0436\u0430\u043d\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u0434\u0443\u043c\u043a\u0456 \u0456 \u043f\u0430\u0447\u0443\u0446\u0446\u0456 \u0441\u044d\u0440\u0446\u0430, \u0434\u0430\u0441\u044f\u0433\u0430\u0435 \u0442\u0430\u043a\u043e\u0433\u0430 \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u0435\u043d\u043d\u044f \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0437\u043e\u0440\u0443 \u0456 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u044f\u043a\u043e\u0435 \u0456\u0441\u043d\u0443\u0435 \u043f\u0430\u043c\u0456\u0436 \u0432\u0430\u0434\u043e\u044e \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0456 \u0442\u043e\u0439, \u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u043f\u0430\u0442\u043e\u043a\u0443 \u0446\u0456 \u043f\u0435\u0440\u0430\u043b\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0430\u043c\u0444\u0430\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0456 \u045e \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445, \u0442\u0430\u044f \u0441\u0430\u043c\u0430\u044f. \u0410\u0434\u043d\u0430\u043a \u0442\u0430\u044f, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u0430 \u043d\u0430\u0448\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434\u0442\u0443\u043b\u044c \u0456 \u0446\u044f\u0447\u044d \u0434\u0430 \u043d\u0430\u0441, \u043d\u0435\u0441\u0443\u0447\u044b \u0437 \u0441\u0430\u0431\u043e\u044e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u044f \u0436\u044b\u0446\u0446\u0451\u0432\u044b\u044f \u045e\u043a\u0430\u0437\u0430\u043d\u043d\u0456. \u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u044b\u044f \u045e\u043a\u0430\u0437\u0430\u043d\u043d\u0456 \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u043e \u044f\u043d\u044b \u043a\u0456\u0440\u0443\u044e\u0446\u044c \u0436\u044b\u0446\u0446\u0451\u043c \u0456 \u0432\u044f\u0434\u0443\u0446\u044c \u044f\u0433\u043e \u045e \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u043b\u0430\u0434\u0437\u0435, \u0456 \u0442\u0430\u0434\u044b \u043d\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0437\u0433\u043e\u0434\u0430 \u0456 \u0441\u0443\u043b\u0430\u0434\u0434\u0437\u0435 \u043f\u0430\u043c\u0456\u0436 \u0437\u043d\u0435\u0448\u043d\u0456\u043c \u0456 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c. \u0422\u0430\u043c\u0443, \u043d\u0430 \u043c\u0430\u044e \u0434\u0443\u043c\u043a\u0443, \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u043c\u044b, \u043d\u043e\u0441\u044f\u0447\u044b \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0432\u044b\u044f\u0432\u0456\u043b\u0456 \u045e \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u043c\u043a\u0430\u0445, \u0441\u043b\u043e\u0432\u0430\u0445 \u0456 \u0447\u044b\u043d\u0430\u0445 \u0443\u0441\u0451, \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0433\u044d\u0442\u0430\u0435 \u0456\u043c\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 3, 17; \u0420\u044b\u043c 14, 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u045e\u0441\u0451, \u0448\u0442\u043e \u0431 \u0432\u044b \u043d\u0456 \u0440\u0430\u0431\u0456\u043b\u0456 \u0441\u043b\u043e\u0432\u0430\u043c \u0446\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c, <span style=\"color: #ff0000;\">*<\/span> \u0443\u0441\u0451 \u0440\u0430\u0431\u0456\u0446\u0435 \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0456\u0445\u0442\u043e \u0437 \u043d\u0430\u0441 \u043d\u0435 \u0436\u044b\u0432\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0451 \u0440\u0430\u0431\u0456\u0446\u0435 \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"124","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0414\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430&raquo; \u0431\u043b. \u042d\u043b\u044c\u0440\u044d\u0434\u0430, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 3: PL 195, 692-693)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435, \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d\u0430\u0442\u0430\u043d, \u0441\u0430\u043c\u044b \u0441\u043b\u0430\u0432\u0443\u0442\u044b \u0441\u044f\u0440\u043e\u0434 \u044e\u043d\u0430\u043a\u043e\u045e, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0441\u0432\u0430\u0451 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435 \u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u0447\u0430\u043a\u0430\u043b\u0430 \u044f\u0433\u043e, \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0434\u0430\u043c\u043e\u0432\u0443 \u0437 \u0414\u0430\u0432\u0456\u0434\u0430\u043c, \u043f\u0440\u0430\u0437 \u0448\u0442\u043e \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0440\u043e\u045e\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u043c\u0456\u0436 \u0441\u043b\u0443\u0433\u043e\u044e \u0456 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043e\u043c. \u0414\u0430\u0432\u0456\u0434\u0430, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b\u0433\u043d\u0430\u045e \u044f\u0433\u043e\u043d\u044b \u0431\u0430\u0446\u044c\u043a\u0430 \u0456 \u044f\u043a\u0456 \u0445\u0430\u0432\u0430\u045e\u0441\u044f \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u043d\u044b\u0445 \u043c\u0435\u0441\u0446\u0430\u0445, \u044f\u043a\u0456 \u0431\u044b\u045e \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u043d\u0430 \u0437\u0430\u0431\u043e\u0439\u0441\u0442\u0432\u0430, \u0451\u043d \u043b\u0456\u0447\u044b\u045e \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u0441\u044f\u0431\u0435 \u0456 \u043f\u0440\u044b \u0433\u044d\u0442\u044b\u043c \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u045e \u0441\u044f\u0431\u0435, \u0430 \u044f\u0433\u043e \u045e\u0437\u0432\u044b\u0448\u0430\u045e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0422\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u0430 \u044f \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u043b\u044f \u0446\u044f\u0431\u0435 \u0434\u0440\u0443\u0433\u0456\u043c&raquo; (\u043f\u0430\u0440. 1 \u0421\u0430\u043c 23, 17).<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430! \u0413\u044d\u0442\u0430 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u044f \u0440\u044d\u0447! \u041a\u0430\u0440\u043e\u043b\u044c \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0443 \u0456 \u043f\u0430\u0434\u0431\u0443\u0445\u0442\u043e\u0440\u044b\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e, \u044f\u043a \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0432\u043e\u0440\u0430\u0433\u0430, \u0443\u0441\u044e \u043a\u0440\u0430\u0456\u043d\u0443. \u0410\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0446\u0456\u045e\u0448\u044b \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0443 \u0437\u0434\u0440\u0430\u0434\u0437\u0435, \u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u0456\u0445 \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0434\u0430\u0437\u0440\u044d\u043d\u043d\u044f. \u041f\u0435\u0440\u0430\u0442\u0440\u0430\u0441\u0430\u0435 \u043b\u044f\u0441\u044b, \u0430\u0431\u0448\u0443\u043a\u0432\u0430\u0435 \u0434\u0430\u043b\u0456\u043d\u044b, \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u044f\u0445 \u0456 \u045e\u0437\u0433\u043e\u0440\u043a\u0430\u0445 \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0437\u0431\u0440\u043e\u0439\u043d\u044b\u044f \u0430\u0442\u0440\u0430\u0434\u044b. \u0423\u0441\u0435 \u0430\u0431\u044f\u0446\u0430\u044e\u0446\u044c \u0441\u0443\u0446\u0456\u0448\u044b\u0446\u044c \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u0435 \u043a\u0430\u0440\u0430\u043b\u044f. \u0422\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u0437\u0456\u043d \u0401\u043d\u0430\u0442\u0430\u043d, \u044f\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043c\u0435\u0446\u044c \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u0447\u044b\u043d \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u0446\u044c \u0414\u0430\u0432\u0456\u0434\u0430, \u043f\u0440\u044b\u0437\u043d\u0430\u045e, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u0431\u0430\u0446\u044c\u043a\u0443, \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0447\u044b \u0441\u044f\u0431\u0440\u0443 \u045e\u0446\u044f\u0447\u044b, \u0434\u0430\u0446\u044c \u043f\u0430\u0440\u0430\u0434\u0443 \u045e \u0442\u0430\u043a\u0456\u0445 \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u0445. \u041f\u0430\u0441\u0442\u0430\u0432\u0456\u045e\u0448\u044b \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430 \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430, \u043a\u0430\u0436\u0430: &laquo;\u0422\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u0430 \u044f \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u043b\u044f \u0446\u044f\u0431\u0435 \u0434\u0440\u0443\u0433\u0456\u043c&raquo;. \u0417\u0430\u045e\u0432\u0430\u0436, \u044f\u043a \u043c\u043e\u0446\u043d\u0430 \u0441\u0442\u0430\u0440\u0430\u045e\u0441\u044f \u0431\u0430\u0446\u044c\u043a\u0430 \u0430\u0431\u0443\u0434\u0437\u0456\u0446\u044c \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0434\u0430 \u0441\u044f\u0431\u0440\u0430, \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u0441\u044b\u043d\u0430, \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u044e\u0447\u044b \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0442\u043e\u0439 \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u0443\u043b\u0430\u0441\u043d\u044b \u0433\u043e\u043d\u0430\u0440.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0432\u0430\u0442 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0414\u0430\u0432\u0456\u0434 \u0431\u044b\u045e \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0401\u043d\u0430\u0442\u0430\u043d \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0441\u044f\u0431\u0440\u0430: &laquo;\u0427\u0430\u043c\u0443 \u0414\u0430\u0432\u0456\u0434 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043c\u0435\u0440\u0446\u0456? \u0423 \u0447\u044b\u043c \u044f\u0433\u043e \u0432\u0456\u043d\u0430? \u0428\u0442\u043e \u0451\u043d \u0437\u0440\u0430\u0431\u0456\u045e? \u0401\u043d \u0436\u0430 \u0440\u044b\u0437\u044b\u043a\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u0432\u0430\u044e\u044e\u0447\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0444\u0456\u043b\u0456\u0441\u0442\u044b\u043c\u043b\u044f\u043d\u0430\u045e, \u0430 \u0442\u044b \u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f. \u0427\u0430\u043c\u0443 \u0451\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043c\u0435\u0440\u0446\u0456?&raquo; (\u043f\u0430\u0440. 1 \u0421\u0430\u043c 20, 32; 19, 3). \u041d\u0430 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0430\u0448\u0430\u043b\u0435\u043b\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u0445\u0430\u0446\u0435\u045e \u043f\u0440\u0430\u0431\u0456\u0446\u044c \u0401\u043d\u0430\u0442\u0430\u043d\u0430 \u0434\u0437\u0456\u0434\u0430\u0439 \u0456, \u0434\u0430\u0434\u0430\u044e\u0447\u044b \u0434\u0430 \u043f\u0430\u0433\u0440\u043e\u0437\u0430\u045e \u0437\u043d\u044f\u0432\u0430\u0433\u0456, \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e: &laquo;\u0421\u044b\u043d \u0432\u0435\u0440\u0430\u043b\u043e\u043c\u043d\u0430\u0439 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u044f \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0442\u044b \u043b\u044e\u0431\u0456\u0448 \u044f\u0433\u043e \u043d\u0430 \u0441\u0432\u0430\u044e \u0433\u0430\u043d\u044c\u0431\u0443 \u0456 \u0433\u0430\u043d\u044c\u0431\u0443 \u0442\u0432\u0430\u0451\u0439 \u0431\u044f\u0441\u0441\u043b\u0430\u045e\u043d\u0430\u0439 \u043c\u0430\u0446\u0456&raquo; (\u043f\u0430\u0440. 1 \u0421\u0430\u043c 20, 30). \u0417\u0430\u0442\u044b\u043c \u0432\u044b\u043b\u0456\u045e \u0443\u0441\u044e \u0441\u0432\u0430\u044e \u0430\u0442\u0440\u0443\u0442\u0443, \u043a\u0430\u0431 \u0437\u0430\u0440\u0430\u0437\u0456\u0446\u044c \u0451\u0439 \u0441\u044d\u0440\u0446\u0430 \u044e\u043d\u0430\u043a\u0430, \u0456 \u0434\u0430\u0434\u0430\u045e \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u043b\u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u0446\u044c \u0434\u0430 \u0430\u043c\u0431\u0456\u0446\u044b\u0439, \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u044c, \u0440\u0430\u0441\u043f\u0430\u043b\u0456\u0446\u044c \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0456 \u0433\u043e\u0440\u044b\u0447: &laquo;\u041f\u0430\u043a\u0443\u043b\u044c \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0441\u044b\u043d \u0415\u0441\u044d\u044f, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b\u043c \u0442\u0432\u0430\u0451 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430&raquo; (\u043f\u0430\u0440. 1 \u0421\u0430\u043c 20, 31).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0433\u043e \u0436 \u043d\u0435 \u0437\u0430\u043a\u0440\u0430\u043d\u0443\u043b\u0456 \u0431 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b? \u0425\u0442\u043e \u0436 \u0431\u044b \u043d\u0435 \u0430\u0434\u0447\u0443\u045e \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456? \u0427\u044b\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u043f\u0430\u0432\u0430\u0433\u0456 \u0456 \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430 \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044b\u043b\u0456 \u0431 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u043d\u0435 \u0430\u0441\u043b\u0430\u0431\u0456\u043b\u0456 \u0431, \u043d\u0435 \u0430\u0441\u0443\u0434\u0437\u0456\u043b\u0456 \u0431 \u043d\u0430 \u0437\u0430\u0431\u044b\u0446\u0446\u0451? \u0401\u043d\u0430\u0442\u0430\u043d, \u043f\u043e\u045e\u043d\u044b \u043b\u044e\u0431\u043e\u0432\u0456, \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u0432\u0435\u0440\u043d\u044b\u043c \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0443. \u0417\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0430\u0434\u0432\u0430\u0433\u0443 \u043f\u0435\u0440\u0430\u0434 \u043f\u0430\u0433\u0440\u043e\u0437\u0430\u043c\u0456, \u0431\u0443\u0434\u0443\u0447\u044b \u043d\u044f\u0437\u043b\u043e\u043c\u043d\u044b\u043c \u043f\u0435\u0440\u0430\u0434 \u0437\u043d\u044f\u0432\u0430\u0433\u0430\u043c\u0456, \u0430\u0434\u0434\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430 \u0437\u0430 \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430, \u043d\u0435 \u0434\u0443\u043c\u0430\u045e \u043f\u0440\u0430 \u045e\u043b\u0430\u0441\u043d\u0443\u044e \u0445\u0432\u0430\u043b\u0443, \u0430\u043b\u0435, \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u045e\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u0436\u0430: &laquo;\u0422\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u0430 \u044f \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u043b\u044f \u0446\u044f\u0431\u0435 \u0434\u0440\u0443\u0433\u0456\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435, \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430. \u041d\u0435 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u044f\u0433\u043e \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u044c, \u043d\u0435 \u0430\u0441\u043b\u0430\u0431\u0456\u0446\u044c \u043f\u0430\u0434\u0430\u0437\u0440\u043e\u043d\u0430\u0441\u0446\u044c, \u043d\u0435 \u0440\u0430\u0437\u0430\u0440\u0432\u0435 \u043f\u0440\u0430\u0433\u0430 \u045e\u043b\u0430\u0434\u044b. \u041f\u0435\u0440\u0430\u0434 \u0432\u044f\u043b\u0456\u043a\u0456\u043c\u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u043c\u0456 \u043d\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u044c, \u043f\u0430\u0434 \u0443\u0434\u0430\u0440\u0430\u043c\u0456 \u043d\u0435 \u0437\u043d\u044f\u0432\u0435\u0440\u044b\u0446\u0446\u0430; \u043f\u0435\u0440\u0430\u0434 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u043c\u0456 \u043d\u0435 \u0441\u0430\u0433\u043d\u0435\u0446\u0446\u0430, \u043f\u0435\u0440\u0430\u0434 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c\u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044f\u043c\u0456 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u0439. &laquo;\u0406\u0434\u0437\u0456 \u0456 \u0442\u044b \u0440\u0430\u0431\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430&raquo; (\u041b\u043a 10, 37).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0456\u0440 6, 14. 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0435\u0440\u043d\u044b \u0441\u044f\u0431\u0440\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043c\u043e\u0446\u043d\u0430\u044f \u0430\u0431\u0430\u0440\u043e\u043d\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0445\u0442\u043e \u044f\u0433\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0442\u043e\u0439 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u043a\u0430\u0440\u0431.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433\u0430\u0431\u0430\u044f\u0437\u043d\u044b \u0434\u043e\u0431\u0440\u044b \u0441\u044f\u0431\u0440\u0430; \u0442\u0430\u043c\u0443, \u044f\u043a\u0456 \u0451\u043d \u0441\u0430\u043c, \u0442\u0430\u043a\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u043b\u0456\u0436\u043d\u0456 \u044f\u0433\u043e\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u044f\u0433\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0442\u043e\u0439 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u043a\u0430\u0440\u0431.<\/p>\r\n"}, {"GCH_CH_2_ID":"125","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Orat. 6 De beatitudinibus: PG 44, 1263-1266)<\/span><br \/><span style=\"color: #ff0000;\">\u0412\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u0456 \u0411\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0436\u044b\u0432\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043a\u0430\u043b\u0456 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u0437 \u0432\u044b\u0441\u043e\u043a\u0430\u0439 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u043d\u0430 \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u0435 \u043c\u043e\u0440\u0430, \u0430\u0434\u0447\u0443\u0432\u0430\u044e \u0456 \u044f, \u043a\u0430\u043b\u0456 \u0437 \u0432\u044b\u0448\u044b\u043d\u0456 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0437 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0433\u0430\u0440\u044b, \u0433\u043b\u044f\u0434\u0436\u0443 \u045e \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0443\u044e \u0433\u043b\u044b\u0431\u0456\u043d\u044e \u0411\u043e\u0436\u044b\u0445 \u043d\u0430\u043c\u0435\u0440\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u0441\u0442\u0430 \u043d\u0430\u0434 \u043c\u0430\u0440\u0441\u043a\u0456\u043c \u0431\u0435\u0440\u0430\u0433\u0430\u043c \u043c\u043e\u0436\u043d\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0433\u0430\u0440\u0443, \u0431\u044b\u0446\u0446\u0430\u043c \u043d\u0430\u043f\u0430\u043b\u043e\u0432\u0443 \u0430\u0434\u0440\u044d\u0437\u0430\u043d\u0443\u044e \u0437 \u0431\u043e\u043a\u0443 \u043c\u043e\u0440\u0430, \u0433\u043b\u0430\u0434\u043a\u0443\u044e \u0437\u0432\u0435\u0440\u0445\u0443 \u0430\u0436 \u0434\u0430 \u043d\u0456\u0437\u0443, \u0432\u044f\u0440\u0448\u044b\u043d\u044f \u044f\u043a\u043e\u0439 \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u043f\u0440\u043e\u0441\u0442\u0430 \u043d\u0430\u0434 \u0431\u044f\u0437\u0434\u043e\u043d\u043d\u0435\u043c \u0432\u043e\u0434. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0437 \u0442\u0430\u043a\u043e\u0439 \u0432\u044b\u0448\u044b\u043d\u0456 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u0443 \u0433\u043b\u044b\u0431 \u043c\u043e\u0440\u0430, \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u043a\u0440\u0443\u0436\u044d\u043d\u043d\u0435, \u044f\u043a \u0456 \u044f \u0430\u0434\u0447\u0443\u0432\u0430\u044e \u043a\u0440\u0443\u0436\u044d\u043d\u043d\u0435 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0433\u0430 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u044f \u041f\u0430\u043d\u0430: &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0447\u044b\u0441\u0442\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c, \u0431\u043e \u044f\u043d\u044b \u0411\u043e\u0433\u0430 \u045e\u0431\u0430\u0447\u0430\u0446\u044c&raquo; (\u041c\u0446 5, 8). \u0411\u043e\u0433 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0441\u044f\u0431\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u043c\u0430\u0435 \u0447\u044b\u0441\u0442\u0430\u0435 \u0441\u044d\u0440\u0446\u0430. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0441\u0432. \u042f\u043d \u043a\u0430\u0436\u0430: &laquo;\u0411\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e&raquo; (\u042f\u043d 1, 18). \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, \u043c\u0430\u044e\u0447\u044b \u0442\u0430\u043a\u043e\u0435 \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0435 \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u0435, \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u045e \u0433\u044d\u0442\u0430 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u0411\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e \u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u043d\u0435 \u043c\u043e\u0436\u0430&raquo; (\u043f\u0430\u0440. 1 \u0426\u0456\u043c 6, 16). \u0413\u044d\u0442\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0411\u043e\u0433 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u0439 \u0441\u043b\u0456\u0437\u043a\u0430\u0439 \u0456 \u043f\u0430\u043a\u0440\u0443\u0447\u0430\u0441\u0442\u0430\u0439 \u0441\u043a\u0430\u043b\u043e\u0439, \u044f\u043a\u0430\u044f \u043d\u0435 \u0434\u0430\u0435 \u043d\u0456\u044f\u043a\u0430\u0439 \u0430\u043f\u043e\u0440\u044b \u043d\u0430\u0448\u044b\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f\u043c, \u0441\u043a\u0430\u043b\u043e\u0439, \u044f\u043a\u0443\u044e \u041c\u0430\u0439\u0441\u0435\u0439 \u0443 \u0441\u0432\u0430\u0456\u0445 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u0445 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0439, \u0448\u0442\u043e \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0456 \u043d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c \u043d\u0435 \u043c\u043e\u0436\u0430 \u0442\u0443\u0434\u044b \u0437\u0430\u0431\u0440\u0430\u0446\u0446\u0430: &laquo;\u0427\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0436\u044b\u0432\u044b\u043c&raquo; (\u043f\u0430\u0440. \u0417\u044b\u0445 33, 20).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u0456 \u0411\u043e\u0433\u0430. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0456 \u043d\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u044b \u042f\u043d, \u041f\u0430\u0432\u0435\u043b \u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430. \u0426\u0456 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435\u0448 \u0443\u0436\u043e \u0433\u044d\u0442\u0430\u0435 \u043a\u0440\u0443\u0436\u044d\u043d\u043d\u0435 \u0440\u043e\u0437\u0443\u043c\u0443, \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u043d\u0430\u0435 \u0433\u043b\u044b\u0431\u0456\u043d\u0451\u0439 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u044f \u041f\u0430\u043d\u0430? \u041a\u0430\u043b\u0456 \u0411\u043e\u0433 &minus; \u0433\u044d\u0442\u0430 \u0436\u044b\u0446\u0446\u0451, \u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u0441\u0443\u0437\u0456\u0440\u0430\u0435 \u0411\u043e\u0433\u0430, \u043d\u0435 \u043c\u0430\u0435 \u0436\u044b\u0446\u0446\u044f. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0456, \u044f\u043a \u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u044f \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0441\u0432\u0435\u0434\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u0411\u043e\u0433\u0430 \u0431\u0430\u0447\u044b\u0446\u044c \u043d\u0435\u043b\u044c\u0433\u0430. \u0414\u0437\u0435 \u0436 \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0434\u0437\u0435\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u041f\u0430\u043d \u043f\u0430\u0434\u044b\u043c\u0430\u0435 \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0441\u043b\u0430\u0431\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e. \u0422\u0430\u043a \u0436\u0430 \u043f\u0430\u0441\u0442\u0443\u043f\u0456\u045e \u0441\u0430 \u0441\u043b\u0430\u0431\u044b\u043c \u041f\u044f\u0442\u0440\u043e\u043c, \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043d\u0430 \u043f\u0430\u0432\u0435\u0440\u0445\u043d\u0456 \u0432\u0430\u0434\u044b, \u0431\u044b\u0446\u0446\u0430\u043c \u043d\u0430 \u043d\u044f\u0437\u043c\u0435\u043d\u043d\u044b\u043c \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u044b\u043c \u0433\u0440\u0443\u043d\u0446\u0435, \u043a\u0430\u0431 \u0442\u043e\u0439 \u043d\u0435 \u043f\u0430\u0442\u0430\u043d\u0443\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430 \u043d\u0430\u0441 \u0421\u043b\u043e\u0432\u0430 \u0432\u044b\u0446\u044f\u0433\u043d\u0435 \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443 \u0456 \u0437\u0431\u044f\u043d\u0442\u044d\u0436\u0430\u043d\u044b\u0445 \u0433\u043b\u044b\u0431\u0456\u043d\u0451\u0439 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f\u045e \u0443\u043c\u0430\u0446\u0443\u0435 \u045e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0456, \u043c\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0436\u043e \u0431\u0430\u044f\u0446\u0446\u0430, \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b\u0441\u044f \u043c\u043e\u0446\u043d\u0430 \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0448\u044b\u043c \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c. \u0411\u043e \u043a\u0430\u0436\u0430: &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0447\u044b\u0441\u0442\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c, \u0431\u043e \u044f\u043d\u044b \u0411\u043e\u0433\u0430 \u045e\u0431\u0430\u0447\u0430\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 1, 18; \u041f\u0441 145 (144), 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e.<span style=\"color: #ff0000;\"> *<\/span> \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0410\u0439\u0446\u0430, \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044f\u043b\u0456\u043a\u0456 \u041f\u0430\u043d \u0456 \u0433\u043e\u0434\u043d\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0445\u0432\u0430\u043b\u044b, \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u0430\u044f \u0432\u0435\u043b\u0456\u0447 \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0410\u0439\u0446\u0430, \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u045e.<\/p>\r\n"}, {"GCH_CH_2_ID":"126","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Orat. 6 De beatitudinibus: PG 44, 1266-1267)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u0430\u0434\u0437\u0435\u044f \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435: &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0447\u044b\u0441\u0442\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c, \u0431\u043e \u044f\u043d\u044b \u0411\u043e\u0433\u0430 \u045e\u0431\u0430\u0447\u0430\u0446\u044c&raquo; \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u0448\u0442\u043e \u0437\u043c\u044f\u0448\u0447\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u043f\u0430\u045e\u043d\u0430\u0442\u0443 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f. \u0427\u0430\u0433\u043e \u0436 \u044f\u0448\u0447\u044d \u043c\u043e\u0436\u043d\u0430 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u043f\u0430\u0441\u043b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u0442\u0430\u043a\u043e\u0433\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e \u0442\u044b\u043c, \u043a\u0430\u0433\u043e \u0441\u0443\u0437\u0456\u0440\u0430\u0435\u043c, \u043c\u044b \u043c\u0430\u0435\u043c \u0443\u0441\u0451? \u0411\u043e \u043d\u0430 \u043c\u043e\u0432\u0435 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f &laquo;\u0431\u0430\u0447\u044b\u0446\u044c&raquo; \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u0435 \u0436, \u0448\u0442\u043e &laquo;\u043c\u0435\u0446\u044c&raquo;. \u041d\u0430\u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435: &laquo;\u0422\u044b \u045e\u0431\u0430\u0447\u044b\u0448 \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430&raquo; (\u041f\u0441 128 [127], 5) \u0430\u0437\u043d\u0430\u0447\u0430\u0435 &laquo;\u0431\u0443\u0434\u0437\u0435\u0448 \u043c\u0435\u0446\u044c&raquo;. \u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a \u043a\u0430\u0436\u0430: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0437\u0433\u0456\u043d\u0435 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b, \u043a\u0430\u0431 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u045e \u0451\u043d \u0445\u0432\u0430\u043b\u044b \u041f\u0430\u043d\u0430&raquo; (\u043f\u0430\u0440. \u0406\u0441 26, 10), \u0442\u043e \u043f\u0430\u0434 \u0441\u043b\u043e\u0432\u0430\u043c &laquo;\u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u045e&raquo; \u0440\u0430\u0437\u0443\u043c\u0435\u0435 &laquo;\u043d\u0435 \u043c\u0435\u045e \u0443\u0434\u0437\u0435\u043b\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430, \u043c\u0430\u0435 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b: \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0432\u0435\u0447\u043d\u0443\u044e \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u044c, \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435, \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0443\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0441\u0430\u043b\u043e\u0434\u043a\u0456 \u0437\u0430\u043a\u043b\u0456\u043a \u0414\u0443\u0445\u0430, \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u0443\u044e \u0445\u0432\u0430\u043b\u0443, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u0435 \u0432\u044f\u0441\u0435\u043b\u043b\u0435 \u0456 \u043d\u0430\u043e\u0433\u0443\u043b \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0434\u0430\u0431\u0440\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0448\u0447\u0430\u0441\u0446\u0435, \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u0430\u0435 \u045e \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0435 \u043d\u0430\u043c\u0456 \u043f\u0440\u0430\u0437 \u043d\u0430\u0434\u0437\u0435\u044e, \u043d\u0430\u043e\u0433\u0443\u043b \u043d\u0435 \u043c\u0430\u0435 \u043c\u0435\u0436\u0430\u045e. \u0410\u0434\u043d\u0430\u043a \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 &minus; \u0448\u0442\u043e \u0430\u0434\u0437\u043d\u0430\u0447\u044b\u043b\u0456 \u043c\u044b \u0440\u0430\u043d\u0435\u0439 &minus; \u0443\u043c\u043e\u0432\u0430\u044e \u0431\u0430\u0447\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0441\u044d\u0440\u0446\u0430, \u0442\u043e \u043c\u043e\u0439 \u0440\u043e\u0437\u0443\u043c \u0437\u043d\u043e\u045e \u0443 \u0437\u0430\u043c\u044f\u0448\u0430\u043d\u043d\u0456. \u0422\u0430\u043c\u0443 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u044e\u0441\u044f, \u0446\u0456 \u0433\u044d\u0442\u0430\u044f \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0441\u044d\u0440\u0446\u0430 \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0447\u0430\u0441\u0430\u043c \u0434\u0430 \u0442\u044b\u0445 \u0440\u044d\u0447\u0430\u045e, \u044f\u043a\u0456\u0445 \u0443\u0432\u043e\u0433\u0443\u043b\u0435 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c, \u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u044e\u0446\u044c \u0456 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u0456 \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b. \u0411\u043e \u043a\u0430\u043b\u0456 \u0411\u043e\u0433\u0430 \u043c\u043e\u0436\u043d\u0430 \u0431\u0430\u0447\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0441\u044d\u0440\u0446\u0430, \u0442\u043e \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u041f\u0430\u0432\u0435\u043b \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456, \u0431\u043e \u0441\u0430\u043c\u0456 \u043a\u0430\u0436\u0443\u0446\u044c, \u0448\u0442\u043e \u043d\u0456 \u044f\u043d\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430, \u043d\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u044b. \u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435, \u0448\u0442\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e \u0417\u0431\u0430\u045e\u0446\u0430 \u044f\u043a \u0448\u0447\u0430\u0441\u0446\u0435, \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0442\u0430 \u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435\u0434\u0430\u0441\u044f\u0433\u0430\u043b\u044c\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e \u044f\u043a\u0430\u044f \u0436 \u043d\u0430\u043c \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043c\u043e\u0436\u043d\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0440\u044d\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u0435\u0434\u0430\u0435\u043c? \u0413\u044d\u0442\u0430 \u0442\u0430\u043a, \u044f\u043a \u0431\u044b \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0434\u043e\u0431\u0440\u0430 \u0431\u044b\u0446\u044c \u0443 \u043d\u0435\u0431\u0435, \u0431\u043e \u0442\u0430\u043c \u043c\u043e\u0436\u043d\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0440\u044d\u0447\u044b, \u044f\u043a\u0456\u0445 \u043d\u0435\u043b\u044c\u0433\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435. \u041a\u0430\u043b\u0456 \u0431 \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c, \u044f\u043a \u0442\u0440\u0430\u043f\u0456\u0446\u044c \u0443 \u043d\u0435\u0431\u0430, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0431\u044b\u043b\u043e \u0431 \u0434\u043e\u0431\u0440\u0430 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u043b\u0443\u0445\u0430\u0447\u0430\u043c \u043f\u0440\u0430 \u0448\u0447\u0430\u0441\u0446\u0435 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u043d\u043d\u044f \u045e \u043d\u0435\u0431\u0435. \u0410\u0434\u043d\u0430\u043a, \u044f\u043a \u0434\u043e\u045e\u0433\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0442\u0443\u0434\u044b \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u0446\u044c, \u0442\u043e \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0440\u0430 \u0448\u0447\u0430\u0441\u0446\u0435 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u043d\u043d\u044f \u045e \u043d\u0435\u0431\u0435 \u043d\u0435 \u043c\u0430\u0435 \u043d\u0456\u044f\u043a\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456. \u041d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u043c\u043e\u0436\u0430 \u043d\u0430\u0441 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u0446\u044c, \u0431\u043e \u043c\u044b \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f, \u044f\u043a\u0456\u0445 \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e \u043c\u044b \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b, \u0448\u0442\u043e \u043c\u043d\u043e\u0433\u0430\u0433\u0430 \u043d\u0430\u043c \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0437\u0430\u043a\u0440\u044b\u0442\u0430\u0433\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u0442\u0443\u0434\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0443. \u0426\u0456 \u0436 \u041f\u0430\u043d \u0442\u0430\u043a\u0456\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430\u0441 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0430-\u0437\u0430 \u043d\u0430\u0448\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443 \u0456 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u043d\u0435 \u0442\u0430\u043a. \u0411\u043e\u0433 \u043d\u0435 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043b\u044f\u0442\u0430\u0446\u044c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u043c, \u044f\u043a\u0456\u043c \u043d\u0435 \u0434\u0430\u045e \u043a\u0440\u044b\u043b\u0430\u045e, \u043d\u0456 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u0446\u044c \u043f\u0430\u0434 \u0432\u0430\u0434\u043e\u0439 \u0442\u044b\u043c, \u043a\u0430\u043c\u0443 \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0436\u044b\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u043f\u0430\u0440\u0430\u0434\u0430\u043a \u0441\u0432\u0435\u0442\u0443 \u0434\u0430\u0441\u0442\u0430\u0441\u0430\u0432\u0430\u043d\u044b \u0434\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044f\u045e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e \u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0430-\u0437\u0430 \u0456\u0445 \u0441\u0456\u043b\u044b, \u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043c\u043e\u0436\u0430\u043c \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u0446\u044c, \u0448\u0442\u043e \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430, \u0431\u043e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u041a\u0430\u043d\u0435\u0448\u043d\u0435, \u0442\u0440\u044d\u0431\u0430 \u0434\u0443\u043c\u0430\u0446\u044c, \u0448\u0442\u043e \u043d\u0456 \u042f\u043d, \u043d\u0456 \u041f\u0430\u0432\u0435\u043b, \u043d\u0456 \u041c\u0430\u0439\u0441\u0435\u0439, \u0446\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0456\u043c \u043d\u0435 \u0431\u044b\u045e \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0442\u0430\u0433\u043e \u0448\u0447\u0430\u0441\u0446\u044f, \u044f\u043a\u043e\u0435 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u0431\u0430\u0447\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430; \u043d\u0456 \u041f\u0430\u0432\u0435\u043b, \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u0420\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456&raquo; (2 \u0426\u0456\u043c 4, 8); \u043d\u0456 \u042f\u043d, \u044f\u043a\u0456 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u045e \u043d\u0430 \u0433\u0440\u0443\u0434\u0437\u044f\u0445 \u0415\u0437\u0443\u0441\u0430; \u043d\u0456 \u041c\u0430\u0439\u0441\u0435\u0439, \u044f\u043a\u043e\u043c\u0443 \u0411\u043e\u0433 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0426\u044f\u0431\u0435 \u0432\u044b\u0431\u0440\u0430\u045e \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445&raquo; (\u0417\u044b\u0445 33, 17). \u041a\u0430\u043b\u0456 \u0436 \u0442\u044b\u044f, \u0445\u0442\u043e \u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0431\u0430\u0447\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0448\u044b\u044f \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u0456, \u0437 \u0443\u0441\u0451\u0439 \u0443\u043f\u044d\u045e\u043d\u0435\u043d\u0430\u0441\u0446\u044e \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u0430 \u0448\u0447\u0430\u0441\u0446\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u0456 \u0411\u043e\u0433\u0430, \u044f\u043a\u043e\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430, \u0442\u043e \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0441\u044d\u0440\u0446\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u0434\u0430\u0441\u044f\u0433\u0430\u0435\u0446\u0446\u0430 \u0448\u0447\u0430\u0441\u0446\u0435, \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u043d\u0435\u0434\u0430\u0441\u044f\u0433\u0430\u043b\u044c\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u045e\u0434\u0443 \u043a\u0430\u0437\u0430\u043b\u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0440\u0430\u0437\u0430\u043c \u0437 \u041f\u0430\u045e\u043b\u0430\u043c \u0434\u0443\u043c\u0430\u043b\u0456, \u0448\u0442\u043e \u0431\u0430\u0447\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0456\u043b\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u043d\u0435 \u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c \u0456\u043c \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435 \u041f\u0430\u043d\u0430, \u0443 \u044f\u043a\u0456\u043c \u0401\u043d \u0430\u0431\u044f\u0446\u0430\u0435 \u043b\u044e\u0434\u0437\u044f\u043c \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430, \u0448\u0442\u043e \u044f\u043d\u044b \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 63 (62), 2bc; 17 (16), 15<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0426\u044f\u0431\u0435 \u043f\u0440\u0430\u0433\u043d\u0435 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f, <span style=\"color: #ff0000;\">*<\/span> \u043c\u0430\u0451 \u0446\u0435\u043b\u0430 \u043f\u0430 \u0422\u0430\u0431\u0435 \u0442\u0443\u0436\u044b\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u045e\u0431\u0430\u0447\u0443 \u0422\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0447\u043d\u0443\u0441\u044f, \u0431\u0443\u0434\u0443 \u043d\u0430\u0441\u044b\u0447\u0430\u0446\u0446\u0430 \u0422\u0432\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u0451 \u0446\u0435\u043b\u0430 \u043f\u0430 \u0422\u0430\u0431\u0435 \u0442\u0443\u0436\u044b\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_2_ID":"127","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Orat. 6 De beatitudinibus: PG 44, 1270-1271)<\/span><br \/><span style=\"color: #ff0000;\">\u0411\u043e\u0433\u0430 \u043c\u043e\u0436\u043d\u0430 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u045e \u0441\u044d\u0440\u0446\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"background-color: transparent; text-align: justify;\">\u0417\u0434\u0430\u0440\u043e\u045e\u0435 \u0446\u0435\u043b\u0430 \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0430\u0431\u0440\u043e\u043c \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0410\u0434\u043d\u0430\u043a \u0448\u0447\u0430\u0441\u0446\u0435 \u043d\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u0432\u0435\u0434\u0430\u0446\u044c, \u0447\u044b\u043c \u0451\u0441\u0446\u044c \u0437\u0434\u0430\u0440\u043e\u045e\u0435, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u044f\u0433\u043e \u043c\u0435\u0446\u044c. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u043f\u0430\u0445\u0432\u0430\u043b\u0443 \u0437\u0434\u0430\u0440\u043e\u045e\u044e, \u0430\u043b\u0435 \u0437&rsquo;\u0435\u045e \u043d\u0435\u0437\u0434\u0430\u0440\u043e\u0432\u0443\u044e \u0435\u0436\u0443 \u0456 \u0437\u0430\u0445\u0432\u0430\u0440\u044d\u045e, \u044f\u043a\u0443\u044e \u0436 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0437 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u044f\u0433\u0430 \u0430\u043f\u0430\u0432\u044f\u0434\u0430\u043d\u043d\u044f \u043f\u0440\u0430 \u0437\u0434\u0430\u0440\u043e\u045e\u0435? \u041f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u043f\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u0432\u044b\u0448\u044d\u0439 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0448\u0447\u0430\u0441\u0446\u0435 \u043d\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u0432\u0435\u0434\u0430\u0446\u044c \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0440\u0430 \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u042f\u0433\u043e \u045e \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b: &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0447\u044b\u0441\u0442\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c, \u0431\u043e \u044f\u043d\u044b \u0411\u043e\u0433\u0430 \u045e\u0431\u0430\u0447\u0430\u0446\u044c&raquo; (\u041c\u0446 5, 8).<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u043c\u0430\u044e, \u0448\u0442\u043e \u0433\u044d\u0442\u0430\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u043d\u0435 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0437 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0431\u0430\u0447\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430 \u044f\u043a \u0431\u044b \u0437\u0431\u043e\u043a\u0443, \u0430\u043b\u0435 \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430\u043c \u0442\u043e\u0435, \u043d\u0430 \u0448\u0442\u043e \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u045e\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u0456\u043d\u0448\u044b\u044f \u0441\u043b\u043e\u0432\u044b: &laquo;\u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u045e \u0432\u0430\u0441&raquo; (\u043f\u0430\u0440. \u041b\u043a 17, 21). \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043d\u0435\u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0439 \u043f\u0440\u044b\u0432\u044f\u0437\u0430\u043d\u0430\u0441\u0446\u0456, \u0442\u0430\u0434\u044b \u045e \u0441\u0432\u0430\u0451\u0439 \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u0456 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0434\u0430\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u045e \u0441\u0432\u0430\u0456\u043c \u043a\u0430\u0440\u043e\u0442\u043a\u0456\u043c \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0456 \u0417\u0431\u0430\u045e\u0446\u0430 \u043f\u0435\u0440\u0430\u0434\u0430\u0435 \u043d\u0430\u043c \u0432\u043e\u0441\u044c \u0442\u0430\u043a\u043e\u0435 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435: &laquo;\u0412\u044b \u045e\u0441\u0435, \u044f\u043a\u0456\u044f \u0436\u0430\u0434\u0430\u0435\u0446\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0414\u0430\u0431\u0440\u043e, \u043a\u0430\u043b\u0456 \u0447\u0443\u0435\u0446\u0435, \u0448\u0442\u043e \u0432\u0435\u043b\u0456\u0447 \u0411\u043e\u0436\u0430\u044f \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u043f\u0430-\u043d\u0430\u0434 \u043d\u044f\u0431\u0451\u0441\u0430\u043c\u0456, \u0448\u0442\u043e \u0445\u0432\u0430\u043b\u0430 \u042f\u0433\u043e \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u0430\u044f, \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u044f \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c, \u043d\u0435\u0430\u0445\u043e\u043f\u043d\u0430\u044f \u0456 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430, \u043d\u0435 \u0437\u043d\u0435\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u0437-\u0437\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u0446\u0435 \u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u0436\u0430\u0434\u0430\u0435\u0446\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u0437\u043d\u0456\u0448\u0447\u044b\u0448 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u0456 \u0437\u043d\u044f\u0432\u043e\u043b\u044c\u0432\u0430\u0435 \u0442\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u0443 \u0442\u0430\u0431\u0435 \u043d\u0430\u043d\u043e\u0432\u0430 \u0437\u0430\u044f\u0441\u043d\u0435\u0435 \u0411\u043e\u0436\u0430\u044f \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c. \u042f\u043a \u0436\u0430\u043b\u0435\u0437\u0430, \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u0430\u0435 \u0430\u0434 \u0456\u0440\u0436\u044b, \u043f\u0435\u0440\u0430\u043b\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0456 \u0431\u043b\u0456\u0448\u0447\u044b\u0446\u044c \u043d\u0430 \u0441\u043e\u043d\u0446\u044b, \u0442\u0430\u043a \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u043e\u0433\u0430 \u041f\u0430\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u0430\u043c, \u043f\u0430\u0441\u043b\u044f \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u045e\u0437\u043d\u0456\u043a\u043b\u0430 \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u043d\u0435\u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u045e, \u043d\u0430\u043d\u043e\u0432\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0437\u043e\u0440\u0443 \u0456 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0456 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0434\u043e\u0431\u0440\u044b\u043c. \u0411\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0414\u0430\u0431\u0440\u0430, \u0437 \u0443\u0441\u0451\u0439 \u0443\u043f\u044d\u045e\u043d\u0435\u043d\u0430\u0441\u0446\u044e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043e\u0431\u0440\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043a\u0430\u043b\u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u0441\u044f\u0431\u0435, \u0443 \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0436\u0430\u0434\u0430\u0435. \u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u0430\u0435 \u0447\u044b\u0441\u0442\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b, \u0431\u043e \u045e\u0433\u043b\u044f\u0434\u0430\u044e\u0447\u044b\u0441\u044f \u045e \u0441\u0432\u0430\u044e \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c, \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435 \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0443 \u0441\u0432\u043e\u0439 \u043f\u0435\u0440\u0448\u0430\u045e\u0437\u043e\u0440. \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0441\u043e\u043d\u0446\u0430 \u045e \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0443, \u0445\u043e\u0446\u044c \u043d\u0435 \u0433\u043b\u044f\u0434\u0437\u044f\u0446\u044c \u0443 \u043d\u0435\u0431\u0430, \u0430\u0434\u043d\u0430\u043a \u0443 \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0443 \u0431\u0430\u0447\u044b\u0446\u044c \u043d\u0435 \u0433\u043e\u0440\u0448 \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435\u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0430 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0441\u043e\u043d\u0446\u0430, \u0442\u0430\u043a \u0456 \u0432\u044b, \u044f\u043a \u043a\u0430\u0436\u0430 \u0434\u0430\u043b\u0435\u0439 \u0417\u0431\u0430\u045e\u0446\u0430, \u0445\u043e\u0446\u044c \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u0432\u0430\u043c \u0441\u0456\u043b, \u043a\u0430\u0431 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0456 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u043a\u0430\u043b\u0456 \u0437\u0432\u0435\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0434\u0430 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u0456 \u0456 \u043a\u0440\u0430\u0441\u044b \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u044f, \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u0430\u0433\u0430 \u045e \u0432\u0430\u0441 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u045e \u0441\u0430\u0431\u0435 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0448\u0443\u043a\u0430\u0435\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u044b\u0441\u0442\u0430\u0441\u0446\u044c, \u0441\u0432\u0430\u0431\u043e\u0434\u0430 \u0430\u0434 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0430\u045e \u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u043d\u043d\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430 \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b. \u041a\u0430\u043b\u0456 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u0443 \u0442\u0430\u0431\u0435, \u0442\u043e \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u045e \u0442\u0430\u0431\u0435 \u0451\u0441\u0446\u044c \u0411\u043e\u0433. \u0422\u0430\u043c\u0443 \u043a\u0430\u043b\u0456 \u0442\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u0430 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f, \u0432\u043e\u043b\u044c\u043d\u0430\u0435 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0437\u0430\u0433\u0430\u043d\u044b, \u0434\u0430\u043b\u0451\u043a\u0430\u0435 \u0430\u0434 \u044f\u043a\u043e\u0433\u0430-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0441\u043a\u0430\u0436\u044d\u043d\u043d\u044f, \u0442\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u044f\u0441\u043d\u0430\u0441\u0446\u0456 \u0456 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u043f\u043e\u0437\u0456\u0440\u043a\u0443, \u0431\u043e \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b \u043f\u043e\u0437\u0456\u0440\u043a \u0431\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u044e\u0446\u044c \u043d\u0435\u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b\u044f \u0432\u043e\u0447\u044b. \u041f\u0430\u0441\u043b\u044f \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f \u0446\u0435\u043c\u0440\u044b, \u044f\u043a\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u045e, \u0442\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0448 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0441\u044d\u0440\u0446\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0435 \u0431\u0430\u0447\u0430\u043d\u043d\u0435. \u0427\u044b\u043c \u044f\u043d\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u044b\u0441\u0442\u0430\u0441\u0446\u044e, \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044e, \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u043e\u0439, \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u043c\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u0456\u0434\u0443 \u043f\u0440\u043e\u043c\u043d\u044f\u043c\u0456 \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u044f\u043a\u0456\u044f \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u044e\u0446\u044c \u043d\u0430\u043c \u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 14, 6\u0430. 9b; 6, 47b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0437\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e: \u042f &ndash; \u0434\u0430\u0440\u043e\u0433\u0430, \u0456 \u043f\u0440\u0430\u045e\u0434\u0430, \u0456 \u0436\u044b\u0446\u0446\u0451. <span style=\"color: #ff0000;\">*<\/span> \u0425\u0442\u043e \u0431\u0430\u0447\u044b\u045e \u041c\u044f\u043d\u0435, \u0431\u0430\u0447\u044b\u045e \u0410\u0439\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c, \u043c\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0431\u0430\u0447\u044b\u045e \u041c\u044f\u043d\u0435, \u0431\u0430\u0447\u044b\u045e \u0410\u0439\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"131","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u043f\u0430\u043f\u044b \u041f\u0430\u045e\u043b\u0430 VI<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. Manilae habita die 29 novembris 1970)<\/span><br \/><span style=\"color: #ff0000;\">\u0410\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u043c\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u0441\u044f\u043c\u0443 \u0441\u0432\u0435\u0442\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0413\u043e\u0440\u0430 \u043c\u043d\u0435, \u043a\u0430\u043b\u0456 \u044f \u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f&raquo; (1 \u041a\u0430\u0440 9, 16). \u0410\u0434 \u042f\u0433\u043e, \u0430\u0434 \u0441\u0430\u043c\u043e\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u044f \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0433\u044d\u0442\u044b \u043d\u0430\u043a\u0430\u0437. \u042f &ndash; \u0430\u043f\u043e\u0441\u0442\u0430\u043b, \u0441\u0432\u0435\u0434\u043a\u0430. \u0427\u044b\u043c \u0434\u0430\u043b\u0435\u0439\u0448\u0430\u044f \u043c\u044d\u0442\u0430, \u0447\u044b\u043c \u0441\u043a\u043b\u0430\u0434\u0430\u043d\u0435\u0439 \u0437\u0430\u0434\u0430\u043d\u043d\u0435, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0433\u0430\u0440\u0430\u0447\u0430\u044f \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0430\u044f \u043d\u0430\u0441 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435. \u042f \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043d\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u042f\u0433\u043e \u0456\u043c\u044f: \u0415\u0437\u0443\u0441 &ndash; \u0433\u044d\u0442\u0430 &laquo;\u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0421\u044b\u043d \u0411\u043e\u0433\u0430 \u0416\u044b\u0432\u043e\u0433\u0430&raquo; (\u041c\u0446 16, 16). \u0413\u044d\u0442\u0430 \u0401\u043d \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e \u043d\u0430\u043c \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0401\u043d &ndash; \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f (\u043f\u0430\u0440. \u041a\u043b\u0441 1, 15), &laquo;\u0443\u0441\u0451 \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0406\u043c&raquo; (\u041a\u043b\u0441 1, 17). \u0401\u043d &ndash; \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c; \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0434\u043b\u044f \u043d\u0430\u0441, \u043f\u0430\u043c\u0451\u0440 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441. \u0401\u043d &ndash; \u0446\u044d\u043d\u0442\u0440 \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0456 \u0441\u0432\u0435\u0442\u0443. \u0401\u043d \u0432\u0435\u0434\u0430\u0435 \u043d\u0430\u0441 \u0456 \u043b\u044e\u0431\u0456\u0446\u044c. \u0401\u043d \u0442\u0430\u0432\u0430\u0440\u044b\u0448 \u0456 \u0441\u044f\u0431\u0440\u0430 \u045e \u0436\u044b\u0446\u0446\u0456, \u043c\u0443\u0436 \u0431\u043e\u043b\u044e \u0456 \u043d\u0430\u0434\u0437\u0435\u0456. \u0401\u043d \u0437\u043d\u043e\u045e \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u043d\u0430\u0448\u044b\u043c \u0421\u0443\u0434\u0434\u0437\u0451\u044e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 &ndash; \u044f\u043a \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u043c\u0441\u044f &ndash; \u0432\u0435\u0447\u043d\u0430\u0439 \u043f\u043e\u045e\u043d\u044f\u0439 \u0436\u044b\u0446\u0446\u044f \u0456 \u043d\u0430\u0448\u044b\u043c \u0448\u0447\u0430\u0441\u0446\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u044f \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0432\u0430\u045e \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u043f\u0440\u0430 \u042f\u0433\u043e: \u0401\u043d &ndash; \u0441\u0432\u044f\u0442\u043b\u043e, \u0401\u043d &ndash; \u043f\u0440\u0430\u045e\u0434\u0430, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 &laquo;\u0434\u0430\u0440\u043e\u0433\u0430, \u0456 \u043f\u0440\u0430\u045e\u0434\u0430, \u0456 \u0436\u044b\u0446\u0446\u0451&raquo; (\u042f\u043d 14, 6). \u0401\u043d &ndash; \u0445\u043b\u0435\u0431 \u0456 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b: \u0437\u0430\u0441\u043f\u0430\u043a\u043e\u0439\u0432\u0430\u0435 \u0433\u043e\u043b\u0430\u0434 \u0456 \u0441\u043f\u0430\u0442\u0430\u043b\u044f\u0435 \u043f\u0440\u0430\u0433\u0443. \u0401\u043d &ndash; \u043f\u0430\u0441\u0442\u044b\u0440, \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440, \u0443\u0437\u043e\u0440, \u043d\u0430\u0448\u0430\u0435 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u0456 \u0431\u0440\u0430\u0442. \u042f\u043a \u043c\u044b, \u0430 \u043d\u0430\u0432\u0430\u0442 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u043d\u0430\u0441, \u0431\u044b\u045e \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b, \u0443\u0431\u043e\u0433\u0456, \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043d\u044b, \u0437\u043c\u0443\u0447\u0430\u043d\u044b, \u0433\u043d\u0430\u043d\u044b, \u0441\u043f\u0430\u043a\u0443\u0442\u0430\u0432\u0430\u043d\u044b. \u0414\u043b\u044f \u043d\u0430\u0441 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e, \u0447\u044b\u043d\u0456\u045e \u0446\u0443\u0434\u044b, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u045e \u043d\u043e\u0432\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0443 \u044f\u043a\u0456\u043c \u0443\u0431\u043e\u0433\u0456\u044f \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f, \u0434\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u0439 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0434\u0437\u0435 \u0447\u044b\u0441\u0442\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u043b\u0430\u0447\u0430, \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u0456 \u0441\u0443\u0446\u0435\u0448\u0430\u043d\u044b, \u0434\u0437\u0435 \u043f\u0440\u0430\u0433\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0441\u044b\u0447\u0430\u043d\u044b\u044f, \u0434\u0437\u0435 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0456 \u043c\u043e\u0433\u0443\u0446\u044c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435, \u0434\u0437\u0435 \u045e\u0441\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0431\u0440\u0430\u0442\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0440\u0430 \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u045e\u0436\u043e \u0447\u0443\u043b\u0456. \u0414\u0430\u0440\u044d\u0447\u044b, \u0431\u043e\u043b\u044c\u0448\u0430\u0441\u0446\u044c \u0437 \u0432\u0430\u0441 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u042f\u0433\u043e, \u0431\u043e \u0432\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0435\u0441\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456. \u0422\u0430\u043c\u0443 \u0432\u0430\u043c, \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435, \u044f \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u044e \u042f\u0433\u043e \u0456\u043c\u044f, \u0430 \u045e\u0441\u0456\u0445 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e: \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &minus; \u0433\u044d\u0442\u0430 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0456 \u043a\u0430\u043d\u0435\u0446, \u0430\u043b\u044c\u0444\u0430 \u0456 \u0430\u043c\u0435\u0433\u0430, \u041a\u0430\u0440\u043e\u043b\u044c \u043d\u043e\u0432\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0442\u0430\u044f\u043c\u043d\u0456\u0447\u0430\u0435 \u0456 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0435 \u0440\u0430\u0437&rsquo;\u044f\u0441\u043d\u0435\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u043b\u0451\u0441\u0443 \u0456 \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430. \u0401\u043d &ndash; \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a, \u044f\u043a \u0431\u044b \u043c\u043e\u0441\u0442 \u043f\u0430\u043c\u0456\u0436 \u043d\u0435\u0431\u0430\u043c \u0456 \u0437\u044f\u043c\u043b\u044e. \u0401\u043d &ndash; \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0441\u0430\u043c\u044b\u043c \u043f\u043e\u045e\u043d\u044b\u043c \u0456 \u0441\u0430\u043c\u044b\u043c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0447\u044b\u043d\u0430\u043c, \u0431\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0421\u044b\u043d\u0430\u043c \u0411\u043e\u0433\u0430, \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b\u043c, \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u044b\u043c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0421\u044b\u043d\u0430\u043c \u041c\u0430\u0440\u044b\u0456, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0439 \u043f\u0430\u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456, \u042f\u0433\u043e \u041c\u0430\u0446\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430 \u0456 \u043d\u0430\u0448\u0430\u0439 \u041c\u0430\u0446\u0456 \u043f\u0440\u0430\u0437 \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u044c \u0437 \u0414\u0443\u0445\u0430\u043c \u041c\u0456\u0441\u0442\u044b\u0447\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441! \u041f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435: \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u042f\u0433\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0432\u0430\u043c \u043d\u0430 \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c; \u0445\u043e\u0447\u0430\u043c, \u043a\u0430\u0431 \u042f\u0433\u043e \u0456\u043c\u044f \u0433\u0443\u0447\u0430\u043b\u0430 \u0430\u0436 \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u0441\u0432\u0435\u0442\u0443 \u0456 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 2 \u0426\u0456\u043c 1, 10b; \u042f\u043d 1, 16; \u041a\u043b\u0441 1, 16b-17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0431\u0430\u045e\u0446\u0430 \u043d\u0430\u0448, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u0436\u044b\u0446\u0446\u0451 \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0417 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u043c\u044b \u045e\u0441\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043b\u0430\u0441\u043a\u0443 \u0437\u0430\u043c\u0435\u0441\u0442 \u043b\u0430\u0441\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e \u045e\u0441\u0451 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0456 \u0434\u043b\u044f \u042f\u0433\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430, \u0401\u043d \u0451\u0441\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c, \u0456 \u045e\u0441\u0451 \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0406\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u043c\u044b \u045e\u0441\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043b\u0430\u0441\u043a\u0443 \u0437\u0430\u043c\u0435\u0441\u0442 \u043b\u0430\u0441\u043a\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"132","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Serm. 47, 1. 2. 3. 6, De ovibus: CCL 41, 572-573, 575-576)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u043d &ndash; \u043d\u0430\u0448 \u0411\u043e\u0433, \u0430 \u043c\u044b &ndash; \u043d\u0430\u0440\u043e\u0434 \u042f\u0433\u043e \u043f\u0430\u0448\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u0442\u043e \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u0432\u044b\u044f\u045e\u043b\u044f\u044e\u0446\u044c \u043d\u0430\u0448\u0443\u044e \u0432\u0435\u0440\u0443 \u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b &ndash; \u0430\u0432\u0435\u0447\u043a\u0456 \u0411\u043e\u0433\u0430: &laquo;\u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u0401\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0430\u0441, \u0456 \u043c\u044b \u042f\u0433\u043e\u043d\u044b\u044f&raquo; (\u041f\u0441 100 [99], 3), &laquo;\u0431\u043e \u0401\u043d &ndash; \u043d\u0430\u0448 \u0411\u043e\u0433, \u0430 \u043c\u044b &ndash; \u043d\u0430\u0440\u043e\u0434 \u042f\u0433\u043e\u043d\u0430\u0439 \u043f\u0430\u0448\u044b \u0456 \u0430\u0432\u0435\u0447\u043a\u0456 \u0440\u0443\u043a\u0456 \u042f\u0433\u043e\u043d\u0430\u0439&raquo; (\u041f\u0441 95 [94], 7). \u0417\u044f\u043c\u043d\u044b\u044f \u043f\u0430\u0441\u0442\u0443\u0445\u0456 \u043d\u0435 \u0441\u0430\u043c\u0456 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0441\u0430\u0431\u0435 \u0430\u0432\u0435\u0447\u0430\u043a, \u043d\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u043b\u0456 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043f\u0430\u0441\u0432\u044f\u0446\u044c. \u041f\u0430\u043d, \u0411\u043e\u0433 \u043d\u0430\u0448, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0430\u043c \u0456 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c, \u0441\u0430\u043c \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0430\u0432\u0435\u0447\u0430\u043a, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0456 \u042f\u043c\u0443 \u0456 \u043a\u0430\u0431 \u0401\u043d \u0456\u0445 \u043a\u0430\u0440\u043c\u0456\u045e. \u041d\u0456\u0445\u0442\u043e \u0456\u043d\u0448\u044b \u043d\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0430\u0432\u0435\u0447\u0430\u043a, \u041f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u044f\u043a\u0456\u0445 \u0401\u043d \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0401\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u043f\u0435\u0441\u043d\u0456 \u043c\u044b \u0432\u044b\u0437\u043d\u0430\u043b\u0456, \u0448\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u042f\u0433\u043e \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456, \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u042f\u0433\u043e \u043f\u0430\u0448\u044b, \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456 \u045e \u042f\u0433\u043e \u0440\u0443\u043a\u0430\u0445, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u043a\u0430\u0436\u0430 \u043d\u0430\u043c, \u0441\u0432\u0430\u0456\u043c \u0430\u0432\u0435\u0447\u043a\u0430\u043c. \u041f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e, \u0446\u044f\u043f\u0435\u0440 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0430\u0432\u0435\u0447\u0430\u043a. \u041c\u044b \u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0437 \u0431\u043e\u044f\u0437\u0437\u044e, \u0432\u044b \u0436 &ndash; \u0437 \u0431\u0430\u0434\u0437\u0451\u0440\u0430\u0441\u0446\u044e. \u0428\u0442\u043e \u0436 \u043c\u044b \u043f\u0430\u0447\u0443\u0435\u043c \u0441\u0451\u043d\u043d\u044f? \u041c\u043e\u0436\u0430 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442: \u043c\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c \u0437 \u0431\u0430\u0434\u0437\u0451\u0440\u0430\u0441\u0446\u044e, \u0430 \u0432\u044b \u0437 \u0431\u043e\u044f\u0437\u0437\u044e? \u0412\u043e\u0441\u044c \u0436\u0430 \u043d\u0435. \u041d\u0430\u0439\u043f\u0435\u0440\u0448 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u0441\u0442\u044b\u0440\u044b, \u0430 \u043f\u0430\u0441\u0442\u044b\u0440 \u0441\u043b\u0443\u0445\u0430\u0435 \u0437 \u0431\u043e\u044f\u0437\u0437\u044e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u0411\u043e\u0433 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u0430\u0432\u0435\u0447\u043a\u0430\u043c. \u041a\u0430\u043b\u0456 \u0436 \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u0430 \u0441\u043b\u0443\u0445\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a, \u0433\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u044f\u043c\u0443 \u043d\u0435\u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b \u0430\u0432\u0435\u0447\u043a\u0456. \u041f\u0430-\u0434\u0440\u0443\u0433\u043e\u0435, \u044f\u043a \u0443\u0436\u043e \u0441\u043a\u0430\u0437\u0430\u043b\u0456, \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0434\u0437\u0432\u0435 \u0440\u044d\u0447\u044b: \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435, \u0456 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456, \u043c\u044b \u043d\u0430\u043b\u0435\u0436\u044b\u043c, \u043a\u0430\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043c \u0441\u044f\u0431\u0435 \u0433\u043e\u0434\u043d\u0430, \u0434\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e; \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435, \u0442\u043e \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0430\u043c\u0456 \u0441\u0442\u0432\u0430\u0440\u0430\u0435\u043c \u0430\u045e\u0447\u0430\u0440\u043d\u044e. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0446\u0456 \u0442\u043e \u0434\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e, \u0446\u0456 \u0442\u043e \u0434\u0430 \u0430\u0432\u0435\u0447\u0430\u043a, \u043d\u0430\u043c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0442\u0440\u044d\u0431\u0430 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0437 \u0431\u043e\u044f\u0437\u0437\u044e, \u0430 \u0437\u0430\u043a\u043b\u0430\u043f\u043e\u0447\u0430\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c \u0436\u0430, \u0431\u0440\u0430\u0442\u044b, \u0443 \u0447\u044b\u043c \u041f\u0430\u043d \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u0435 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a, \u0448\u0442\u043e \u0430\u0431\u044f\u0446\u0430\u0435 \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u042f\u043c\u0443. \u041a\u0430\u0436\u0430: &laquo;\u0412\u044b &minus; \u043c\u0430\u0435 \u0430\u0432\u0435\u0447\u043a\u0456&raquo; (\u042d\u0437\u0445 34, 31). \u0411\u0440\u0430\u0442\u044b! \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435, \u044f\u043a\u043e\u0435 \u0433\u044d\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 &ndash; \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u0430\u045e\u0447\u0430\u0440\u043d\u0456 \u041f\u0430\u043d\u0430, \u0442\u043e \u043d\u0430\u0432\u0430\u0442 \u0443 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u0456\u0445 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u0445 i \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u0445 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435. &laquo;\u041f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f&raquo; \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0442\u043e\u0439, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u041d\u0435 \u0434\u0440\u044d\u043c\u043b\u0435 \u0456 \u043d\u0435 \u0441\u043f\u0456\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u0446\u0435\u0440\u0430\u0436\u044d \u0406\u0437\u0440\u0430\u044d\u043b\u044c&raquo; (\u041f\u0441 121 [120], 4). \u0401\u043d \u0447\u0443\u0432\u0430\u0435 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u043a\u0430\u043b\u0456 \u043c\u044b \u045e\u0441\u0442\u0430\u0451\u043c, \u0456 \u0447\u0443\u0432\u0430\u0435, \u043a\u0430\u043b\u0456 \u043a\u043b\u0430\u0434\u0437\u0435\u043c\u0441\u044f \u0441\u043f\u0430\u0446\u044c. \u0410\u045e\u0447\u0430\u0440\u043d\u044f \u045e \u0431\u044f\u0441\u043f\u0435\u0446\u044b, \u043a\u0430\u043b\u0456 \u0447\u0443\u0432\u0430\u0435 \u0437\u044f\u043c\u043d\u044b \u043f\u0430\u0441\u0442\u044b\u0440. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0431\u043e\u043b\u044c\u0448 \u043c\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c\u0441\u044f \u045e \u0431\u044f\u0441\u043f\u0435\u0446\u044b, \u0431\u043e \u043d\u0430\u0448\u044b\u043c \u041f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u0451\u0441\u0446\u044c \u0411\u043e\u0433, \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u0441\u0442\u044b\u0440\u0430\u043c, \u0430\u043b\u0435 \u0456 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c. \u0414\u0430 \u0432\u0430\u0441, \u043c\u0430\u0435 \u0430\u0432\u0435\u0447\u043a\u0456, \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u041f\u0430\u043d: &laquo;\u0412\u043e\u0441\u044c \u042f \u0431\u0443\u0434\u0443 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043f\u0430\u043c\u0456\u0436 \u0430\u0434\u043d\u044b\u043c\u0456 \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456 \u0456 \u0434\u0440\u0443\u0433\u0456\u043c\u0456, \u043f\u0430\u043c\u0456\u0436 \u0431\u0430\u0440\u0430\u043d\u0430\u043c\u0456 \u0456 \u043a\u0430\u0437\u043b\u0430\u043c\u0456&raquo; (\u042d\u0437\u0445 34, 17). \u0410\u0434\u043d\u0430\u043a \u0430\u0434\u043a\u0443\u043b\u044c \u0436\u0430 \u045e\u0437\u044f\u043b\u0456\u0441\u044f \u043a\u0430\u0437\u043b\u044b \u045e \u0430\u045e\u0447\u0430\u0440\u043d\u0456 \u0411\u043e\u0433\u0430? \u0411\u043e \u043d\u0430 \u0442\u044b\u0445 \u0436\u0430 \u043f\u0430\u0448\u0430\u0445, \u043a\u0430\u043b\u044f \u0442\u044b\u0445 \u0436\u0430 \u043a\u0440\u044b\u043d\u0456\u0446 \u043f\u0430\u0441\u0432\u044f\u0446\u0446\u0430 \u043a\u0430\u0437\u043b\u044b, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u044f \u0441\u0442\u0430\u0446\u044c \u0437\u043b\u0435\u0432\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u0430. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u043f\u0440\u044b\u043d\u044f\u0442\u044b\u044f, \u043f\u0430\u0437\u043d\u0435\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u0434\u0437\u0435\u043b\u0435\u043d\u044b\u044f. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u043f\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0437\u0435 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a. \u0422\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u0441\u0430\u043c \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u043f\u0430\u0434\u0437\u0435\u043b: \u0430\u0434\u043d\u044b\u0445 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0437\u043b\u0435\u0432\u0430, \u0434\u0440\u0443\u0433\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 10, 27-28; \u042d\u0437\u0445 34, 15<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0432\u0435\u0447\u043a\u0456 \u041c\u0430\u0435 \u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u041c\u043e\u0439, \u0456 \u042f \u0432\u0435\u0434\u0430\u044e \u0456\u0445, \u0456 \u044f\u043d\u044b \u0456\u0434\u0443\u0446\u044c \u0437\u0430 \u041c\u043d\u043e\u044e. \u0406 \u042f \u0434\u0430\u044e \u0456\u043c \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u043d\u0430\u0432\u0435\u043a\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u044f\u043d\u044b \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c \u043d\u0456\u043a\u043e\u043b\u0456, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u044b\u0440\u0432\u0435 \u0456\u0445 \u0437 \u0440\u0443\u043a\u0456 \u041c\u0430\u0451\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a \u041c\u0430\u0456\u0445 \u0456 c\u0430\u043c \u0431\u0443\u0434\u0443 \u045e\u043a\u043b\u0430\u0434\u0432\u0430\u0446\u044c \u0456\u0445 \u043d\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u044f\u043d\u044b \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c \u043d\u0456\u043a\u043e\u043b\u0456, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u044b\u0440\u0432\u0435 \u0456\u0445 \u0437 \u0440\u0443\u043a\u0456 \u041c\u0430\u0451\u0439.<\/p>\r\n"}, {"GCH_CH_2_ID":"133","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Serm. 47, 12-14, De ovibus: CCL 41, 582-584)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0430\u043b\u0456 \u0431 \u044f \u0434\u0430\u0433\u0430\u0434\u0436\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c, \u0442\u043e \u043d\u0435 \u0431\u044b\u045e \u0431\u044b \u0441\u043b\u0443\u0433\u043e\u044e \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0411\u043e \u0445\u0432\u0430\u043b\u0430 \u043d\u0430\u0448\u0430\u044f &ndash; \u0433\u044d\u0442\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430&raquo; (2 \u041a\u0430\u0440 1, 12). \u0401\u0441\u0446\u044c \u043b\u044e\u0434\u0437\u0456, \u044f\u043a\u0456\u044f \u043b\u0435\u0433\u043a\u0430\u0434\u0443\u043c\u043d\u0430 \u0430\u0431\u043c\u0430\u045e\u043b\u044f\u044e\u0446\u044c, \u043f\u043b\u044f\u0442\u043a\u0430\u0440\u0430\u0446\u044c, \u043d\u0430\u0440\u0430\u043a\u0430\u044e\u0446\u044c, \u043d\u0430\u043c\u0430\u0433\u0430\u044e\u0446\u0446\u0430 \u0432\u044b\u0434\u0443\u043c\u0430\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0431\u0430\u0447\u0430\u0446\u044c, \u0456 \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u043f\u0440\u0430 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u043f\u0430\u0434\u0430\u0437\u0440\u0430\u0432\u0430\u0446\u044c. \u0410\u0434\u043d\u043e\u0441\u043d\u0430 \u0442\u0430\u043a\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u0430\u043c \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0435, \u0430 \u043d\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f. \u0411\u0440\u0430\u0442\u044b \u043c\u0430\u0435! \u041d\u0430\u0432\u0430\u0442 \u0443 \u0442\u044b\u0445, \u043a\u0430\u043c\u0443 \u0445\u043e\u0447\u0430\u043c \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430, \u043c\u044b \u043d\u0435 \u0448\u0443\u043a\u0430\u0435\u043c \u0456 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0448\u0443\u043a\u0430\u0446\u044c \u043d\u0430\u0448\u0430\u0439 \u0441\u043b\u0430\u0432\u044b. \u0416\u0430\u0434\u0430\u0435\u043c \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0431\u0440\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e, \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0447\u044b \u043d\u0430\u0441, \u043d\u0435 \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u0435, \u043a\u0430\u043b\u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c. \u041a\u0430\u043b\u0456 \u043c\u044b \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u0436 \u043d\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435\u043c, \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430. \u0401\u043d \u0441\u0430\u043c \u0432\u044f\u0434\u0437\u0435 \u0430\u045e\u0447\u0430\u0440\u043d\u044e \u0456 \u0437 \u0443\u0441\u0456\u043c\u0456 \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456 \u0441\u0442\u0432\u0430\u0440\u0430\u0435 \u0430\u0434\u043d\u043e, \u0431\u043e \u045e\u0441\u0435 \u044f\u043d\u044b \u0451\u0441\u0446\u044c \u0443 \u0406\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u043c\u044b \u0456\u043c\u043a\u043d\u0435\u043c\u0441\u044f \u0434\u0430\u0433\u0430\u0434\u0436\u0430\u0446\u044c \u043b\u044e\u0434\u0437\u044f\u043c, \u0442\u043e \u043d\u0435 \u0448\u0443\u043a\u0430\u0435\u043c \u0441\u0432\u0430\u0451\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u0430\u043b\u0435 \u043f\u0440\u0430\u0433\u043d\u0435\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0437 \u0456\u043c\u0456, \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u044f\u043d\u044b \u043b\u044e\u0431\u044f\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0439 \u0445\u0432\u0430\u043b\u044b, \u0430\u043b\u0435 \u0441\u0430\u0431\u0435 \u043d\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c. \u0422\u044b\u043c, \u0445\u0442\u043e \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443, \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0431 \u044f \u0456 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0434\u0430\u0433\u0430\u0434\u0436\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c, \u0442\u043e \u043d\u0435 \u0431\u044b\u045e \u0431\u044b \u0441\u043b\u0443\u0433\u043e\u044e \u0425\u0440\u044b\u0441\u0442\u0430!&raquo; (\u0413\u0430\u043b 1, 10). \u0406\u043c \u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430: &laquo;\u0406\u043c\u043a\u043d\u0456\u0446\u0435\u0441\u044f \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u045e\u0441\u0456\u043c \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445, \u044f\u043a \u0456 \u044f \u0441\u0442\u0430\u0440\u0430\u044e\u0441\u044f \u0434\u0430\u0433\u0430\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u0456\u043c \u0432\u0430 \u045e\u0441\u0456\u043c&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 10, 33). \u0410\u0431\u043e\u0434\u0432\u0430 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0456 \u043f\u0440\u0430\u0437\u0440\u044b\u0441\u0442\u044b\u044f, \u0430\u0431\u043e\u0434\u0432\u0430 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b\u044f, \u0430\u0431\u043e\u0434\u0432\u0430 \u0447\u044b\u0441\u0442\u044b\u044f \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u044f. \u0422\u0430\u043c\u0443 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0439 \u0456 \u043f\u0456, \u0430\u043b\u0435 \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u0439 \u043f\u0430\u0448\u044b \u0456 \u043d\u0435 \u043c\u0443\u0446\u0456 \u0432\u0430\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0443\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u043b\u043e \u0432\u0430\u0448\u0430 \u0442\u0430\u043a \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0432\u0430\u0448\u044b \u0434\u043e\u0431\u0440\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u0410\u0439\u0446\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u044f\u043a\u0456 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445&raquo; (\u041c\u0446 5, 16), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0442\u0430\u0433\u043e, \u044f\u043a\u0456 \u0432\u0430\u0441 \u0442\u0430\u043a\u0456\u043c\u0456 \u045e\u0447\u044b\u043d\u0456\u045e. &laquo;\u041c\u044b &ndash; \u043d\u0430\u0440\u043e\u0434 \u042f\u0433\u043e\u043d\u0430\u0439 \u043f\u0430\u0448\u044b \u0456 \u0430\u0432\u0435\u0447\u043a\u0456 \u0440\u0443\u043a\u0456 \u042f\u0433\u043e\u043d\u0430\u0439&raquo; (\u041f\u0441 95 [94], 7). \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e \u0446\u044f\u0431\u0435 \u0434\u043e\u0431\u0440\u044b\u043c, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0445\u0432\u0430\u043b\u0443, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u0442\u0430\u043a\u0456, a\u043b\u0435 \u043d\u0435 \u0442\u044b \u0441\u0430\u043c, \u0431\u043e \u0441\u0430\u043c \u043f\u0430 \u0441\u0430\u0431\u0435 \u0442\u044b \u043c\u043e\u0436\u0430\u0448 \u0431\u044b\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u043c. \u0427\u0430\u043c\u0443 \u0436 \u0442\u044b \u0441\u0442\u0430\u0440\u0430\u0435\u0448\u0441\u044f \u0437\u043c\u044f\u043d\u0456\u0446\u044c \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u043f\u0430\u0440\u0430\u0434\u0430\u043a \u0440\u044d\u0447\u0430\u045e, \u0448\u0443\u043a\u0430\u044e\u0447\u044b \u043f\u0430\u0445\u0432\u0430\u043b\u044b, \u043a\u0430\u043b\u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0434\u043e\u0431\u0440\u0430\u0435, \u0430 \u043a\u0430\u043b\u0456 \u0437\u0440\u043e\u0431\u0456\u0448 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0434\u0440\u044d\u043d\u043d\u0430\u0435, \u0441\u043f\u0440\u0430\u0431\u0443\u0435\u0448 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u0446\u044c \u041f\u0430\u043d\u0430? \u0422\u043e\u0439 \u0436\u0430, \u0445\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u043b\u043e \u0432\u0430\u0448\u0430 \u0442\u0430\u043a \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456&raquo; (\u041c\u0446 5, 16), \u0441\u043a\u0430\u0437\u0430\u045e \u0443 \u0442\u043e\u0439 \u0441\u0430\u043c\u0430\u0439 \u043f\u0440\u0430\u043c\u043e\u0432\u0435: &laquo;\u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u043d\u0435 \u0447\u044b\u043d\u0456\u0446\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0432\u0430\u0448\u0430\u0439 \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456&raquo; (\u041c\u0446 6, 1). \u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0437\u0434\u0430\u044e\u0446\u0446\u0430 \u0442\u0430\u0431\u0435 \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u043b\u0456\u0432\u044b\u043c\u0456, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0443 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043c \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437\u0430\u043c\u0443\u0446\u0456\u0448 \u0432\u0430\u0434\u044b \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u0442\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u041f\u0456\u0441\u0430\u043d\u043d\u044f \u0456 \u0441\u0430\u043c \u0431\u0443\u0434\u0437\u0435\u0448 \u0437 \u0456\u043c \u0443 \u0437\u0433\u043e\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u043f\u0430\u0441\u0442\u0430\u0440\u0430\u0435\u043c\u0441\u044f, \u0431\u0440\u0430\u0442\u044b, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043e\u0431\u0440\u0430 \u0436\u044b\u0446\u044c, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043e\u0431\u0440\u0430 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456. \u041f\u0430\u0441\u0442\u0430\u0440\u0430\u0435\u043c\u0441\u044f \u043c\u0435\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0447\u044b\u0441\u0442\u0430\u0435 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u043d\u0430\u0448\u0430\u044f \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0456 \u045e\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0451\u0439 \u043d\u0435\u043c\u0430\u0447\u044b, \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u0430\u0433\u043b\u043e \u0431 \u0441\u0442\u0430\u0446\u044c \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u043f\u0430\u0434\u0430\u0437\u0440\u043e\u043d\u0430\u0441\u0446\u0456 \u0437 \u0431\u043e\u043a\u0443 \u0441\u043b\u0430\u0431\u0430\u0433\u0430 \u0431\u0440\u0430\u0442\u0430. \u041c\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0442\u043e\u0435, \u043a\u0430\u0431 \u043c\u044b \u0441\u0430\u043c\u0456, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0456\u0446\u044c \u0447\u044b\u0441\u0442\u0443\u044e \u0432\u0430\u0434\u0443 \u0456 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0447\u044b\u0441\u0442\u0443\u044e \u0442\u0440\u0430\u0432\u0443, \u043d\u0435 \u0442\u0430\u043f\u0442\u0430\u043b\u0456 \u043f\u0430\u0448\u044b \u0411\u043e\u0433\u0430 \u0456 \u043a\u0430\u0431 \u0430\u0432\u0435\u0447\u043a\u0456 \u043d\u0435 \u0431\u044b\u043b\u0456 \u0432\u044b\u043c\u0443\u0448\u0430\u043d\u044b\u044f \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u043d\u0430 \u043f\u0430\u0442\u0430\u043f\u0442\u0430\u043d\u0430\u0439 \u043f\u0430\u0448\u044b \u0456 \u043f\u0456\u0446\u044c \u043c\u0443\u0442\u043d\u0443\u044e \u0432\u0430\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0424\u043b\u043f 2, 2. 3-4; 1 \u0422\u044d\u0441 5, 14b. 15b<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043c\u0430\u044e, \u043a\u0430\u0431 \u0432\u044b \u0434\u0443\u043c\u0430\u043b\u0456 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435, \u043c\u0435\u043b\u0456 \u0442\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u044b\u043c\u0456 \u0456 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430\u043c\u0456; \u0443 \u043f\u0430\u043a\u043e\u0440\u044b \u043b\u0456\u0447\u044b\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0437\u0430 \u0441\u044f\u0431\u0435. <span style=\"color: #ff0000;\">*<\/span> \u041d\u0435 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0435\u0441\u044f \u043a\u043e\u0436\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0441\u0432\u0430\u0451, \u0430\u043b\u0435 \u0456 \u043f\u0440\u0430 \u0456\u043d\u0448\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u043f\u044f\u043a\u0443\u0439\u0446\u0435\u0441\u044f \u0445\u0432\u043e\u0440\u044b\u043c\u0456, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b\u043c\u0456 \u0434\u0430 \u045e\u0441\u0456\u0445; \u0440\u0430\u0431\u0456\u0446\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443 \u0456 \u045e\u0441\u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u043e\u0431\u0440\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0435\u0441\u044f \u043a\u043e\u0436\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0441\u0432\u0430\u0451, \u0430\u043b\u0435 \u0456 \u043f\u0440\u0430 \u0456\u043d\u0448\u044b\u0445.<\/p>\r\n"}, {"GCH_CH_2_ID":"134","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0428\u043b\u044f\u0445 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456&raquo; \u0441\u0432. \u0422\u044d\u0440\u044d\u0437\u044b \u0410\u0432\u0456\u043b\u044c\u0441\u043a\u0430\u0439, \u043f\u0430\u043d\u043d\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 30, 1-5; Oeuvres compl&egrave;tes, Descl&eacute;e de Brouwer, Paris, 1964, 467-468)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0422\u0432\u0430\u0451<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0456 \u0436 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0445\u043e\u0446\u044c \u0431\u044b \u0441\u0430\u043c\u044b \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b, \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430 \u0437\u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0437 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u0439 \u0434\u0430 \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0437\u043d\u0430\u0447\u043d\u0430\u0433\u0430 \u0456 \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u0430\u0433\u0430, \u043d\u0435 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043d\u0430\u0434 \u0442\u044b\u043c, \u043f\u0440\u0430 \u0448\u0442\u043e, \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u0456 \u044f\u043a \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0441\u0456\u0446\u044c, \u043a\u0430\u0431 \u044f\u0433\u043e \u0441\u043b\u043e\u0432\u044b \u0431\u044b\u043b\u0456 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u0442\u044b\u044f, \u043a\u0430\u0431 \u043d\u0435 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u044b \u0446\u0456 \u043f\u0440\u044b\u043a\u0440\u0430\u0441\u0446\u0456, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430, \u043a\u0430\u043b\u0456 \u043c\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0442\u0430\u043a\u0430\u044f \u0437\u043d\u0430\u0447\u043d\u0430\u044f \u0440\u044d\u0447, \u044f\u043a \u0442\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u043d\u0430\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u041f\u0430\u043d \u0415\u0437\u0443\u0441? \u0422\u0443\u0442, \u0434\u0443\u043c\u0430\u044e, \u043f\u0430\u045e\u0441\u0442\u0430\u0435 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0435 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0435: \u0446\u0456 \u0422\u044b, \u041f\u0430\u043d\u0435, \u043d\u0435 \u043c\u043e\u0433 \u0431\u044b \u045e \u0430\u0434\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u0446\u044c \u0443\u0441\u0451 \u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u041e\u0439\u0447\u0430, \u0434\u0430\u0439 \u043d\u0430\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u043b\u044f \u043d\u0430\u0441 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0435 \u0456 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430\u0435?&raquo; \u0411\u043e\u043b\u044c\u0448, \u044f\u043a \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u043d\u044f\u043c\u0430 \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u045e\u0441\u0451 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u0432\u0435\u0434\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0432\u0435\u0447\u043d\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c! \u0422\u0430\u0431\u0435 \u0456 \u0422\u0432\u0430\u0439\u043c\u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u043c\u0443 \u0410\u0439\u0446\u0443 \u0445\u0430\u043f\u0430\u043b\u0430 \u0442\u0430\u043a\u043e\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a \u0422\u044b \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u045e \u0413\u0435\u0442\u0441\u0456\u043c\u0430\u043d\u0441\u043a\u0456\u043c \u0441\u0430\u0434\u0437\u0435. \u0422\u044b \u0432\u044b\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u0434\u044b \u0410\u0439\u0446\u0443 \u0441\u0432\u0430\u0451 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0456 \u0441\u0442\u0440\u0430\u0445, \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0434\u0434\u0430\u044e\u0447\u044b\u0441\u044f \u042f\u0433\u043e \u0432\u043e\u043b\u0456. \u0410\u0434\u043d\u0430\u043a, \u043e \u043c\u043e\u0439 \u041f\u0430\u043d\u0435, \u0422\u044b \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0435\u0448, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u044f \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456, \u044f\u043a \u0422\u044b. \u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u043c\u044b \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u043f\u0440\u0430 \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u044b\u044f \u0434\u0430\u0440\u044b \u0456 \u043f\u0430\u0430\u0441\u043e\u0431\u043a\u0443. \u0422\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b \u0437\u043c\u043e\u0436\u0430\u043c \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0446\u0456 \u0442\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u043f\u0440\u043e\u0441\u0456\u043c, \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430\u0435 \u043d\u0430\u043c \u0456 \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0435. \u041a\u0430\u043b\u0456 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435\u043c, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043d\u0435 \u0442\u0430\u043a, \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0451\u043c \u043f\u0440\u0430\u0441\u0456\u0446\u044c. \u0422\u0430\u043a\u0456\u044f \u045e\u0436\u043e \u043c\u044b. \u041a\u0430\u043b\u0456 \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0442\u0430\u0433\u043e, \u0430\u0431 \u0447\u044b\u043c \u043f\u0440\u043e\u0441\u0456\u043c, \u0442\u0430\u0434\u044b, \u043c\u0430\u044e\u0447\u044b \u0432\u043e\u043b\u044c\u043d\u0443\u044e \u0432\u043e\u043b\u044e, \u043d\u0435 \u0445\u043e\u0447\u0430\u043c \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0445\u0432\u044f\u0440\u0443\u0435 \u043d\u0430\u043c \u0411\u043e\u0433. \u041d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0430\u0435 \u0411\u043e\u0433, \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435, \u043c\u044b, \u043a\u0430\u043b\u0456 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u043c, \u0442\u0430\u043a \u0431\u044b \u043c\u043e\u0432\u0456\u0446\u044c, \u043f\u0430\u043b\u0456\u0447\u0430\u043d\u044b\u0445 \u0433\u0440\u043e\u0448\u0430\u0439 \u043d\u0430 \u0434\u0430\u043b\u043e\u043d\u0456, \u043d\u0435 \u0434\u0443\u043c\u0430\u0435\u043c, \u0448\u0442\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u043e\u0440\u0430\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0434\u043e\u0431\u0440\u044b \u0415\u0437\u0443\u0441 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043d\u0430\u043c \u0432\u044b\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u043c\u0456 \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c \u0430\u0431 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u043d\u0430\u0441 \u0411\u043e\u0436\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430: &laquo;\u0421\u0432\u044f\u0446\u0456\u0441\u044f \u0456\u043c\u044f \u0422\u0432\u0430\u0451, \u043f\u0440\u044b\u0439\u0434\u0437\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0422\u0432\u0430\u0451&raquo;. \u041f\u0440\u0430\u0448\u0443, \u0443\u0431\u0430\u0447\u0446\u0435 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0443\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430. \u042f \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e \u043d\u0430\u0434 \u0433\u044d\u0442\u044b\u043c, \u0431\u043e \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u043c\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456, \u043f\u0440\u0430 \u0448\u0442\u043e \u043f\u0440\u043e\u0441\u0456\u043c, \u043c\u043e\u043b\u044f\u0447\u044b\u0441\u044f \u0430\u0431 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u041d\u0430\u0448 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0441\u043f\u0430\u043b\u0443\u0447\u044b\u045e \u0433\u044d\u0442\u044b\u044f \u0434\u0437\u0432\u0435 \u043f\u0440\u043e\u0441\u044c\u0431\u044b, \u0431\u043e \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0430\u0448\u0430\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u0456 \u043d\u044f\u045e\u043c\u0435\u043b\u0430\u0441\u0446\u0456 \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043d\u0430\u043b\u0435\u0436\u043d\u0430 \u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0441\u0432\u044f\u0442\u043e\u0435 \u0406\u043c\u044f \u0421\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, \u043a\u0430\u043b\u0456 \u043d\u0430\u043c \u0443 \u0433\u044d\u0442\u044b\u043c \u043d\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0436\u0430 \u0401\u043d \u0441\u0430\u043c, \u0434\u0430\u044e\u0447\u044b \u043d\u0430\u043c \u0441\u0432\u0430\u0451 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0422\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u0445\u0430\u0447\u0443 \u0432\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u044f\u043a \u0441\u0430\u043c\u0430 \u0433\u044d\u0442\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u044e, \u043a\u0430\u0431 \u0432\u044b \u0432\u0435\u0434\u0430\u043b\u0456, \u043f\u0440\u0430 \u0448\u0442\u043e \u043f\u0440\u043e\u0441\u0456\u0446\u0435, \u043a\u0430\u0431 \u0432\u044b \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430 \u0456 \u0430\u0434\u0434\u0430\u043d\u0430 \u0456 \u0441\u0442\u0430\u0440\u0430\u043b\u0456\u0441\u044f \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u044f \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043c\u043e\u0436\u0430 \u043d\u0430\u0441 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043d\u0435 \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u0430\u0434\u043d\u0430 \u0437 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0434\u0443\u0448\u0430 \u043d\u0435 \u0437\u0430\u0439\u043c\u0430\u0435\u0446\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0441\u0432\u0435\u0442\u0443, \u0430\u043b\u0435 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u045e\u0441\u0456\u0445, \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u0441\u043f\u0430\u043a\u043e\u0439, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0441\u043b\u0430\u0432\u0456\u0446\u044c, \u0443\u0441\u0445\u0432\u0430\u043b\u044f\u0435 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u0441\u0432\u044f\u0442\u043e\u0435 \u0456\u043c\u044f \u0411\u043e\u0433\u0430, \u0448\u0442\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0431\u0440\u0430\u0436\u0430\u0435 \u042f\u0433\u043e \u0433\u0440\u0430\u0445\u0430\u043c\u0456, \u0430\u043b\u0435 \u045e\u0441\u0435 \u043b\u044e\u0434\u0437\u0456 \u042f\u0433\u043e \u043b\u044e\u0431\u044f\u0446\u044c. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0441\u0430\u043c\u0430 \u0434\u0443\u0448\u0430 \u043d\u0435 \u0437\u0430\u0439\u043c\u0430\u0435\u0446\u0446\u0430 \u043d\u0456\u0447\u044b\u043c \u0456\u043d\u0448\u044b\u043c, \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0411\u043e\u0433\u0430 \u0456 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u043b\u044e\u0431\u0456\u0446\u044c, \u0431\u043e \u0432\u0435\u0434\u0430\u0435 \u042f\u0433\u043e. \u041a\u0430\u043b\u0456 \u0431 \u043c\u044b \u0432\u0435\u0434\u0430\u043b\u0456 \u042f\u0433\u043e, \u0442\u043e \u043b\u044e\u0431\u0456\u043b\u0456 \u0431 \u042f\u0433\u043e \u045e\u0436\u043e \u0442\u0443\u0442, \u0448\u0442\u043e \u043f\u0440\u0430\u045e\u0434\u0430, \u043d\u0435 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0434\u044b \u0456 \u043d\u0435 \u0442\u0430\u043a \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430, \u0430\u043b\u0435 \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043d\u0430\u043c\u043d\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u0440\u043e\u0431\u0456\u043c \u0433\u044d\u0442\u0430 \u0446\u044f\u043f\u0435\u0440.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433, \u044f\u043a\u0456 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u043a\u0430\u0440\u044b\u0441\u043d\u0430 \u0434\u043b\u044f \u042f\u0433\u043e \u0434\u0437\u044f\u0446\u0435\u0439, \u0437\u043c\u0443\u0448\u0430\u0435 \u043d\u0430\u0441 \u043f\u0440\u0430\u0441\u0456\u0446\u044c, \u0448\u0443\u043a\u0430\u0446\u044c \u0456 \u0441\u0442\u0443\u043a\u0430\u0446\u044c. <span style=\"color: #ff0000;\">*<\/span> \u041c\u044b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u0430\u0440\u0442\u044b\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u0435\u0440\u044b\u0446\u044c, \u043c\u043e\u0446\u043d\u0430 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u0456 \u0433\u043e\u0440\u0430\u0447\u0430 \u0436\u0430\u0434\u0430\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u043d\u043e\u0433\u0456\u044f \u0440\u043e\u0431\u044f\u0446\u044c \u0433\u044d\u0442\u0430 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430\u0437 \u0441\u043b\u0451\u0437\u044b, \u0447\u044b\u043c \u043f\u0440\u0430\u0437 \u0441\u043b\u043e\u0432\u044b, \u0431\u043e\u043b\u044c\u0448 \u043f\u043b\u0430\u0447\u0430\u043c, \u0447\u044b\u043c \u043c\u043e\u0432\u0430\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u0430\u0440\u0442\u044b\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u0435\u0440\u044b\u0446\u044c, \u043c\u043e\u0446\u043d\u0430 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u0456 \u0433\u043e\u0440\u0430\u0447\u0430 \u0436\u0430\u0434\u0430\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_2_ID":"135","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0434\u043b\u044f \u043d\u043e\u0432\u0430\u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u0445 \u0434\u0430 41 \u043f\u0441\u0430\u043b\u044c\u043c\u0430&raquo; \u0441\u0432. \u0413\u0435\u0440\u0430\u043d\u0456\u043c\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(CCL 78, 542-544)<\/span><br \/><span style=\"color: #ff0000;\">\u0423\u0432\u0430\u0439\u0434\u0443 \u045e \u0422\u0432\u0430\u044e \u0446\u0443\u0434\u043e\u045e\u043d\u0443\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u042f\u043a \u043b\u0430\u043d\u044c \u043f\u0440\u0430\u0433\u043d\u0435 \u0432\u0430\u0434\u044b \u0437 \u043f\u0430\u0442\u043e\u043a\u0443, \u0442\u0430\u043a \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u043f\u0440\u0430\u0433\u043d\u0435 \u0426\u044f\u0431\u0435, \u0411\u043e\u0436\u0430&raquo; (42 [41], 2). \u042f\u043a \u0430\u043b\u0435\u043d\u044c \u043f\u0440\u0430\u0433\u043d\u0435 \u0432\u0430\u0434\u044b \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u0442\u0430\u043a \u0456 \u043d\u0430\u0448\u044b\u044f \u043d\u043e\u0432\u0430\u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u044f, \u044f\u043a\u0456\u044f \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u0415\u0433\u0456\u043f\u0435\u0442 \u0456 \u0441\u0432\u0435\u0442, \u044f\u043a\u0456\u044f \u043f\u0430\u0442\u0430\u043f\u0456\u043b\u0456 \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u045e \u043c\u043e\u0440\u044b \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u043b\u0456 \u045e \u0445\u0440\u043e\u0441\u0446\u0435 \u045e\u0441\u0451 \u044f\u0433\u043e \u0432\u043e\u0439\u0441\u043a\u0430, \u043f\u0430\u0441\u043b\u044f \u0440\u0430\u0437\u0433\u0440\u043e\u043c\u0443 \u0441\u0430\u0442\u0430\u043d\u044b \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u043a\u0440\u044b\u043d\u0456\u0446 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0410\u0439\u0446\u0430, \u0421\u044b\u043d\u0430 \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431 \u0442\u044b\u043c, \u0448\u0442\u043e \u0410\u0439\u0446\u0435\u0446 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0415\u0440\u0430\u043c\u0456\u0456: &laquo;\u042f\u043d\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u041c\u044f\u043d\u0435 &ndash; \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b, \u043a\u0430\u0431 \u0432\u044b\u0447\u0430\u0441\u0430\u0446\u044c \u0441\u0430\u0431\u0435 \u043a\u0430\u043b\u043e\u0434\u0437\u0435\u0436\u044b, \u043a\u0430\u043b\u043e\u0434\u0437\u0435\u0436\u044b \u0434\u0437\u044e\u0440\u0430\u0432\u044b\u044f, \u0448\u0442\u043e \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0443\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u0430\u0434\u044b&raquo; (\u0415\u0440 2, 13). \u041f\u0440\u0430 \u0421\u044b\u043d\u0430 \u0436 \u0447\u044b\u0442\u0430\u0435\u043c \u0443 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b: &laquo;\u0422\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456&raquo; (\u0411\u0430\u0440 3, 12). \u041f\u0440\u0430 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430: &laquo;\u0425\u0442\u043e \u0431 \u043f\u0456\u045e \u0432\u0430\u0434\u0443, \u044f\u043a\u0443\u044e \u042f \u0434\u0430\u043c \u044f\u043c\u0443, \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u0435 \u0441\u043c\u0430\u0433\u0456 \u043d\u0430\u0432\u0435\u043a\u0456; \u0430 \u0432\u0430\u0434\u0430, \u044f\u043a\u0443\u044e \u0434\u0430\u043c \u044f\u043c\u0443, \u0441\u0442\u0430\u043d\u0435 \u045e \u0456\u043c \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0432\u0430\u0434\u044b, \u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435&raquo; (\u042f\u043d 4, 14). \u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0431\u044b\u043b\u0456 \u0442\u0443\u0442 \u0436\u0430 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u0430\u043d\u044b\u044f \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442\u0430\u043c, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0417\u0431\u0430\u045e\u0446\u0430 \u0442\u0430\u043a \u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u0417 \u0432\u044b\u0448\u044d\u0439 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b\u0445 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u044f\u045e \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435, \u0448\u0442\u043e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0421\u0432\u044f\u0442\u043e\u0439 \u0422\u0440\u043e\u0439\u0446\u044b \u0441\u0442\u0432\u0430\u0440\u0430\u0435 \u043f\u0430\u0442\u0440\u043e\u0439\u043d\u0443\u044e \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0442\u0430\u043a\u0456\u0445 \u043a\u0440\u044b\u043d\u0456\u0446 \u043f\u0440\u0430\u0433\u043d\u0435 \u0434\u0443\u0448\u0430 \u0432\u0435\u0440\u0443\u044e\u0447\u0430\u0433\u0430 \u0456 \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0442\u0430\u043a\u0456\u0445 \u043a\u0440\u044b\u043d\u0456\u0446 \u043f\u0440\u0430\u0433\u043d\u0435 \u0456 \u043a\u0430\u0436\u0430: &laquo;\u0414\u0443\u0448\u0430 \u043c\u0430\u044f \u043f\u0440\u0430\u0433\u043d\u0435 \u0411\u043e\u0433\u0430, \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b&raquo; (\u043f\u0430\u0440. \u041f\u0441 42 [41], 3). \u0413\u044d\u0442\u0430 \u043d\u0435 \u0431\u044b\u043b\u0430 \u043c\u0456\u043c\u0430\u043b\u0451\u0442\u043d\u0430\u044f \u043f\u0440\u0430\u0433\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 \u0433\u0430\u0440\u0430\u0447\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0456 \u0448\u0447\u044b\u0440\u044b \u043f\u043e\u0448\u0443\u043a. \u041f\u0435\u0440\u0430\u0434 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0435\u043c \u0445\u0440\u043e\u0441\u0442\u0443 \u043a\u0430\u0442\u044d\u0445\u0443\u043c\u044d\u043d\u044b \u043a\u0430\u0437\u0430\u043b\u0456 \u0441\u0430\u0431\u0435: &laquo;\u041a\u0430\u043b\u0456 \u044f \u043f\u0430\u0439\u0434\u0443 \u0456 \u0437&rsquo;\u044f\u045e\u043b\u044e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0436\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c?&raquo; (\u041f\u0441 42 [41], 3). \u0406 \u0432\u043e\u0441\u044c \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u0456\u0445 \u043f\u0440\u043e\u0441\u044c\u0431\u0430: \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0456 \u0441\u0442\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0411\u043e\u0433\u0430, \u043f\u0435\u0440\u0430\u0434 \u0430\u043b\u0442\u0430\u0440\u043e\u043c \u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u0439 \u0417\u0431\u0430\u045e\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u043f\u0443\u0448\u0447\u0430\u043d\u044b\u044f \u0434\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u044f \u0426\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f \u045e \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u044f\u043d\u044b, \u043f\u043e\u045e\u043d\u044b\u044f \u043d\u0430\u0434\u0437\u0435\u0456, \u043a\u043b\u0456\u0447\u0443\u0446\u044c \u0456 \u043a\u0430\u0436\u0443\u0446\u044c: &laquo;\u042f \u045e\u0432\u0430\u0439\u0434\u0443 \u045e \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0448\u0430\u0446\u0451\u0440, \u0443 \u0434\u043e\u043c \u0441\u0430\u043c\u043e\u0433\u0430 \u0411\u043e\u0433\u0430&raquo; (\u043f\u0430\u0440. \u041f\u0441 42 [41], 5 Vlg.). \u0414\u043e\u043c\u0430\u043c \u0411\u043e\u0433\u0430, \u042f\u0433\u043e \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041a\u0430\u0441\u0446\u0451\u043b, \u0431\u043e \u045e \u0456\u043c \u0433\u0443\u0447\u044b\u0446\u044c &laquo;\u0433\u043e\u043b\u0430\u0441 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u0445\u0432\u0430\u043b\u044b, \u0456 \u0441\u043f\u0435\u045e \u0441\u0432\u044f\u0442\u043a\u0443\u044e\u0447\u044b\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u0436, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u044f \u0446\u044f\u043f\u0435\u0440 \u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u0456\u0434\u0443\u0447\u044b \u0437\u0430 \u043d\u0430\u0448\u044b\u043c\u0456 \u045e\u043a\u0430\u0437\u0430\u043d\u043d\u044f\u043c\u0456, \u0441\u0442\u0430\u043b\u0456 \u0437\u043b\u043e\u045e\u043b\u0435\u043d\u044b\u044f \u0411\u043e\u0436\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u044f\u043a \u0440\u044b\u0431\u044b \u0437 \u0441\u0435\u0442\u0430\u043a \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0441\u043a\u0430\u0436\u0430\u0446\u0435: &laquo;\u0412\u043e\u0441\u044c \u0443 \u043d\u0430\u0441 \u0437\u043c\u044f\u043d\u0456\u045e\u0441\u044f \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b \u0431\u0435\u0433 \u0440\u044d\u0447\u0430\u045e&raquo;. \u0411\u043e \u043a\u0430\u043b\u0456 \u0440\u044b\u0431\u0443 \u0432\u044b\u0446\u044f\u0433\u0432\u0430\u044e\u0446\u044c \u0437 \u043c\u043e\u0440\u0430, \u044f\u043d\u0430 \u043f\u0430\u043c\u0456\u0440\u0430\u0435. \u0410\u0434\u043d\u0430\u043a \u043d\u0430\u0441 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0437\u043b\u0430\u0432\u0456\u043b\u0456 \u0456 \u0432\u044b\u0446\u044f\u0433\u043d\u0443\u043b\u0456 \u0437 \u043c\u043e\u0440\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u043a\u0430\u0431 \u043c\u044b \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0456 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f. \u041f\u0430\u043a\u0443\u043b\u044c \u043c\u044b \u0431\u044b\u043b\u0456 \u045e \u0441\u0432\u0435\u0446\u0435, \u043d\u0430\u0448 \u0437\u0440\u043e\u043a \u0431\u044b\u045e \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e\u043d\u0456\u0437\u0435, \u0430 \u0436\u044b\u0446\u0446\u0451 \u043d\u0430\u0448\u0430 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0441\u044f\u0440\u043e\u0434 \u0431\u0440\u0443\u0434\u0443. \u0410\u0434\u043d\u0430\u043a \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0441 \u0434\u0430\u0441\u0442\u0430\u043b\u0456 \u0437 \u0431\u0435\u0437\u0434\u0430\u043d\u0456, \u043c\u044b \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u043e\u043d\u0446\u0430, \u043f\u0430\u0447\u0430\u043b\u0456 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0456, \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u044b\u044f \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u043a\u0430\u0436\u0430\u043c \u043d\u0430\u0448\u0430\u0439 \u0434\u0443\u0448\u044b: &laquo; \u0421\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0439\u0441\u044f \u043d\u0430 \u0411\u043e\u0433\u0430, \u0431\u043e \u044f\u0448\u0447\u044d \u0431\u0443\u0434\u0443 \u0441\u043b\u0430\u0432\u0456\u0446\u044c \u042f\u0433\u043e, \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043c\u0430\u0439\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0456 \u043c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430&raquo; (\u041f\u0441 42 [41], 6).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 27 (26), 4<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u043d\u0430\u0433\u043e \u044f \u043f\u0440\u0430\u0448\u0443 \u045e \u041f\u0430\u043d\u0430 \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u0430\u0434\u0430\u044e, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u043c\u043d\u0435 \u045e \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0436\u044b\u0446\u0446\u044f \u043c\u0430\u0439\u0433\u043e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u0431 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u0445\u0430\u0440\u0430\u0441\u0442\u0432\u043e \u041f\u0430\u043d\u0430 \u0456 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u043d\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0436\u044b\u0446\u044c \u043c\u043d\u0435 \u045e \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0436\u044b\u0446\u0446\u044f \u043c\u0430\u0439\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"136","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 &laquo;\u041f\u0440\u044b\u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0441\u0432\u044f\u0442\u044b\u0445&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 15, 30-31: PL 44, 981-983)<\/span><br \/><span style=\"color: #ff0000;\">\u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u0440\u043e\u0434\u0443 \u0414\u0430\u0432\u0456\u0434\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0442\u043b\u0443\u043c\u0430\u0447\u044d\u043d\u043d\u0435\u043c \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044d\u043d\u043d\u044f \u0456 \u043b\u0430\u0441\u043a\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0430\u043c \u0417\u0431\u0430\u045e\u0446\u0430, &laquo;\u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456: \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441&raquo; (1 \u0426\u0456\u043c 2, 5). \u0411\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u0456\u043c \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043c \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u043c \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u0440\u044b \u0430\u0431\u043e \u0441\u0432\u0430\u0456\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0442\u0430\u043a\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c? \u041d\u044f\u0445\u0430\u0439 \u0436\u0430 \u043c\u043d\u0435 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0430\u0434\u043a\u0430\u0436\u0430, \u043f\u0440\u0430\u0448\u0443, \u0447\u044b\u043c \u0433\u044d\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u045e \u0441\u0430\u0431\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u045e \u043f\u0440\u044b\u043d\u044f\u0442\u044b \u0411\u043e\u0436\u044b\u043c \u0421\u043b\u043e\u0432\u0430\u043c \u045e \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430 \u0430\u0441\u043e\u0431\u044b? \u042f\u043a\u0456 \u0436 \u0434\u043e\u0431\u0440\u044b \u0447\u044b\u043d \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u0437\u0456\u045e \u0433\u044d\u0442\u0430\u0435 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u0435? \u0428\u0442\u043e \u0436 \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0440\u0430\u0431\u0456\u045e, \u0443\u0432\u0430 \u0448\u0442\u043e \u0432\u0435\u0440\u044b\u045e, \u0430\u0431 \u0447\u044b\u043c \u043f\u0440\u0430\u0441\u0456\u045e, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0442\u0430\u043a\u043e\u0435 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0435 \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u0435? \u0426\u0456 \u0436 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0421\u043b\u043e\u0432\u0443, \u044f\u043a\u043e\u0435 \u0441\u0442\u0432\u0430\u0440\u0430\u0435 \u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435, \u0437 \u0441\u0430\u043c\u0430\u0433\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0433\u044d\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0456\u0441\u043d\u0430\u0432\u0430\u045e \u044f\u043a \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0421\u044b\u043d \u0411\u043e\u0436\u044b?<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0432\u0435\u0434\u0430\u0446\u044c, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u045e \u043d\u0430\u0448\u0430\u0439 \u0413\u0430\u043b\u0430\u0432\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u043b\u0430\u0441\u043a\u0456, \u044f\u043a\u0430\u044f \u0441\u043f\u043b\u044b\u0432\u0430\u0435 \u043d\u0430 \u045e\u0441\u0435 \u0447\u043b\u0435\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u044b, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0439 \u043a\u043e\u0436\u043d\u0430\u043c\u0443. \u0413\u044d\u0442\u0430\u044f \u043b\u0430\u0441\u043a\u0430, \u044f\u043a\u0430\u044f \u045e \u043c\u043e\u043c\u0430\u043d\u0442 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u044f \u0432\u0435\u0440\u044b \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0440\u043e\u0431\u0456\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430\u043c, \u0430\u0434\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u042f\u0433\u043e \u045e\u0447\u044b\u043d\u0456\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0442\u0430\u043c\u0443 \u0441\u0430\u043c\u0430\u043c\u0443 \u0414\u0443\u0445\u0443, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u043c\u0443 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0442\u0430\u043c\u0443 \u0441\u0430\u043c\u0430\u043c\u0443 \u0414\u0443\u0445\u0443 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u0414\u0443\u0445\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u043e\u0433\u0443\u043b\u0435 \u043d\u0435 \u043c\u0435\u045e \u0433\u0440\u0430\u0445\u0443. \u0411\u043e\u0433 \u0440\u0430\u043d\u0435\u0439 \u0432\u0435\u0434\u0430\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430, \u0448\u0442\u043e \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0456\u0446\u044c. \u0422\u0430\u043c\u0443 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0441\u0432\u044f\u0442\u044b\u0445 \u043d\u0430\u0439\u0432\u044b\u0440\u0430\u0437\u043d\u0435\u0439 \u0437\u0430\u044f\u0441\u043d\u0435\u043b\u0430 \u045e \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u044b\u043c. \u0425\u0442\u043e \u0436 \u0441\u044f\u0440\u043e\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u044b, \u043c\u043e\u0436\u0430 \u0433\u044d\u0442\u0430 \u0430\u0441\u043f\u0440\u044d\u0447\u044b\u0446\u044c? \u041c\u044b \u0436 \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f, \u0448\u0442\u043e \u0441\u0430\u043c \u041f\u0430\u043d \u0445\u0432\u0430\u043b\u044b \u044f\u043a \u0411\u043e\u0436\u044b \u0421\u044b\u043d, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0431\u044b\u045e \u043f\u0440\u0430\u0434\u0431\u0430\u0447\u0430\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u0431\u044b\u045e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430 \u0421\u044b\u043d\u0430\u043c \u0414\u0430\u0432\u0456\u0434\u0430, \u0441\u0442\u0430\u0446\u044c \u043f\u043e\u045e\u043d\u044b\u043c \u043c\u043e\u0446\u044b \u0411\u043e\u0436\u044b\u043c \u0421\u044b\u043d\u0430\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0414\u0443\u0445\u0430 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456. \u0423 \u0432\u044b\u043d\u0456\u043a\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435\u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430\u0433\u0430 \u0456 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0421\u043b\u043e\u0432\u0430\u043c, \u044f\u043a\u043e\u0435 \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u0441\u043b\u0443\u0448\u043d\u0430 \u0456 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043c\u043e\u0436\u043d\u0430 \u043d\u0430\u0437\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u0411\u043e\u0436\u044b\u043c \u0421\u044b\u043d\u0430\u043c \u0456 \u0421\u044b\u043d\u0430\u043c \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c: \u0421\u044b\u043d\u0430\u043c \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c, \u0431\u043e \u043f\u0440\u044b\u043d\u044f\u0442\u044b \u0431\u044b\u045e \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a; \u0421\u044b\u043d\u0430\u043c \u0411\u043e\u0436\u044b\u043c, \u0431\u043e \u043f\u0440\u044b\u043c\u0430\u045e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0411\u043e\u0436\u044b \u0421\u044b\u043d. \u0406\u043d\u0430\u043a\u0448 \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u0431 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0430 \u043d\u0435 \u045e \u0442\u0440\u043e\u0445 \u0410\u0441\u043e\u0431\u0430\u0445, \u0430\u043b\u0435 \u045e \u0447\u0430\u0442\u044b\u0440\u043e\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0434\u0431\u0430\u0447\u0430\u043d\u0430\u0435 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u043d\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0442\u0430\u043a\u043e\u0435 \u045e\u0437\u043d\u0451\u0441\u043b\u0430\u0435 \u0456 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0435, \u0448\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0430\u0433\u0430 \u045e\u0432\u043e\u0433\u0443\u043b\u0435 \u043d\u0435 \u043c\u0430\u0433\u043b\u043e \u0456 \u0431\u044b\u0446\u044c. \u0406 \u0437\u043d\u043e\u045e \u0436\u0430, \u0411\u043e\u0441\u043a\u0430\u0441\u0446\u044c \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u0446\u0446\u0430, \u0447\u044b\u043c \u0443 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044f\u043c\u0456 \u0446\u0435\u043b\u0430, \u0430\u0436 \u0434\u0430 \u043a\u0440\u044b\u0436\u043e\u0432\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456. \u042f\u043a \u0401\u043d \u0430\u0434\u0437\u0456\u043d \u0431\u044b\u045e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0431\u044b\u0446\u044c \u043d\u0430\u0448\u0430\u0439 \u0413\u0430\u043b\u0430\u0432\u043e\u0439, \u0442\u0430\u043a \u0456 \u043c\u044b \u043c\u043d\u043e\u0433\u0456\u044f \u0431\u044b\u043b\u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u044f \u0441\u0442\u0430\u0446\u044c \u042f\u0433\u043e \u0447\u043b\u0435\u043d\u0430\u043c\u0456. \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u0456, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u043f\u0430\u043b\u0456 \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u0433\u0440\u0430\u0445\u0443 \u0410\u0434\u0430\u043c\u0430, \u043d\u0456\u0447\u043e\u0433\u0430 \u0442\u0443\u0442 \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0441\u043a\u0430\u0437\u0430\u0446\u044c. \u0422\u043e\u043b\u044c\u043a\u0456 \u043b\u0430\u0441\u043a\u0430 \u0411\u043e\u0433\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430, \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u041f\u0430\u043d\u0430. \u041a\u0430\u043b\u0456 \u0431 \u0445\u0442\u043e \u0430\u0434\u043a\u0440\u044b\u045e, \u0448\u0442\u043e \u0430\u0434\u0437\u0456\u043d\u0430\u0435 \u0456 \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u0430\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430-\u0413\u0430\u043b\u0430\u0432\u044b \u0431\u044b\u043b\u043e \u043f\u043b\u0451\u043d\u0430\u043c \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u0445 \u0437\u0430\u0441\u043b\u0443\u0433, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u0448\u0443\u043a\u0430\u0435 \u0456 \u045e \u043d\u0430\u0441, \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u0445 \u0447\u043b\u0435\u043d\u0430\u0445, \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u0445 \u0437\u0430\u0441\u043b\u0443\u0433 \u0434\u043b\u044f \u043d\u0430\u0448\u044b\u0445 \u043c\u043d\u043e\u0433\u0456\u0445 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0430\u043b 4, 4-5; \u042d\u0444 2, 4; \u0420\u044b\u043c 8, 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u043d\u0430\u0434\u044b\u0448\u043b\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0447\u0430\u0441\u0443, \u043f\u0430\u0441\u043b\u0430\u045e \u0411\u043e\u0433 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0417\u0430\u043a\u043e\u043d\u0443, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u045e \u0417\u0430\u043a\u043e\u043d\u0443. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0443 \u0441\u0432\u0430\u0451\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u0442\u0430\u043c\u0443 \u043f\u0430\u0441\u043b\u0430\u045e \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0433\u0440\u044d\u0448\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u045e \u0417\u0430\u043a\u043e\u043d\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"137","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0442\u044d\u0445\u0435\u0437\u0430 \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cat. I, 2-3. 5-6: PG 33, 371. 375-378)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u0430\u0441\u0442\u0430\u045e \u0447\u0430\u0441 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0437 \u0432\u0430\u0441 \u0442\u0443\u0442 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u044b\u0445 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a \u0433\u0440\u0430\u0445\u0443, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u0434\u0430 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0434\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u044b. \u041d\u044f\u0445\u0430\u0439, \u0430\u0434\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u043d\u044f\u0432\u043e\u043b\u0456 \u0433\u0440\u0430\u0445\u0443 \u0456 \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e, \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u041f\u0430\u043d\u0443 \u0456 \u0441\u0442\u0430\u043d\u0435 \u0433\u043e\u0434\u043d\u044b\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0410\u0434\u043a\u0456\u043d\u044c\u0446\u0435 \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0448\u0442\u043e \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u0435 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456 \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u044b\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e. \u0412\u044b\u0437\u043d\u0430\u0439\u0446\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u0456 \u0430\u043f\u0440\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u045e \u043d\u043e\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f. \u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u045e \u0432\u0435\u0440\u044b \u043f\u0435\u0440\u0448\u044b\u044f \u0434\u0430\u0440\u044b \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043a\u0430\u0431 \u0441\u0430\u043c\u0456 \u0431\u044b\u043b\u0456 \u043f\u0440\u044b\u043d\u044f\u0442\u044b\u044f \u045e \u0432\u0435\u0447\u043d\u044b\u044f \u0441\u044f\u043b\u0456\u0431\u044b. \u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0447\u044b \u0437\u043d\u0430\u043a, \u043a\u0430\u0431 \u041f\u0430\u043d \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u043f\u0440\u044b\u0437\u043d\u0430\u045e \u0432\u0430\u0441 \u044f\u043a \u0441\u0432\u0430\u0456\u0445 \u0445\u0430\u0442\u043d\u0456\u0445. \u0414\u0430\u043b\u0443\u0447\u044b\u0446\u0435\u0441\u044f \u0434\u0430 \u0430\u045e\u0447\u0430\u0440\u043d\u0456 \u041f\u0430\u043d\u0430, \u0441\u0432\u044f\u0442\u043e\u0439 \u0456 \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0439, \u043a\u0430\u0431, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b\u043c\u0456 \u043f\u0430 \u043f\u0440\u0430\u0432\u0456\u0446\u044b \u0411\u043e\u0433\u0430, \u043c\u0430\u0433\u043b\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f \u0436, \u0445\u0442\u043e \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0430\u043a\u0440\u044b\u0442\u044b \u0433\u0430\u043d\u044c\u0431\u0430\u0439 \u0433\u0440\u0430\u0445\u0443, \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0437\u043b\u0435\u0432\u0430, \u0431\u043e \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u044f\u043a\u0443\u044e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0445\u0432\u044f\u0440\u0443\u0435 \u045e \u043a\u0443\u043f\u0435\u043b\u0456 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f. \u042f \u043d\u0435 \u043c\u0430\u044e \u0442\u0443\u0442 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0434\u0443\u0448\u044b. \u0411\u043e \u0446\u0435\u043b\u044b \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e\u0446\u0446\u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0437\u044f\u043c\u043d\u044b\u043c \u0431\u0430\u0446\u044c\u043a\u0430\u043c, \u0430 \u0434\u0443\u0448\u0430 \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443. &laquo;\u0414\u0443\u0445 \u0432\u0435\u0435 \u0442\u0430\u043c, \u0434\u0437\u0435 \u0445\u043e\u0447\u0430&raquo;. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0433\u043e\u0434\u043d\u044b\u043c, \u043f\u0430\u0447\u0443\u0435\u0448 \u0441\u043b\u043e\u0432\u044b: &laquo;\u0414\u043e\u0431\u0440\u0430, \u0441\u043b\u0443\u0433\u0430 \u0434\u043e\u0431\u0440\u044b \u0456 \u0432\u0435\u0440\u043d\u044b&raquo; (\u041c\u0446 25, 23). \u041f\u0430\u0447\u0443\u0435\u0448, \u043a\u0430\u043b\u0456 \u0442\u0432\u0430\u0451 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u043a\u0430\u0436\u043e\u043d\u0430\u0435 \u043d\u0456\u044f\u043a\u0456\u043c \u043f\u0430\u0434\u043c\u0430\u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0437 \u0432\u0430\u0441 \u0442\u0443\u0442 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u044b\u0445 \u043d\u0430\u043c\u0435\u0440\u0432\u0430\u0435\u0446\u0446\u0430 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u0411\u043e\u0436\u0443\u044e \u043b\u0430\u0441\u043a\u0443, \u0443\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u045e \u0437\u043c\u0430\u043d \u0456 \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u0437\u043d\u0430\u0447\u043d\u0430\u0441\u0446\u0456 \u0442\u044b\u0445 \u0441\u043f\u0440\u0430\u045e. \u0422\u0430\u043c\u0443 \u043c\u0430\u0439 \u0430\u0434\u043a\u0440\u044b\u0442\u0443\u044e \u0434\u0443\u0448\u0443 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e \u0441\u044d\u0440\u0446\u0430 \u0456 \u043d\u044b\u0440\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u043d\u0430\u0441\u0442\u0430\u045e \u0447\u0430\u0441 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f \u0433\u0440\u0430\u0445\u043e\u045e. \u0412\u044b\u0437\u043d\u0430\u0439, \u0448\u0442\u043e \u0442\u044b \u045e\u0447\u044b\u043d\u0456\u045e \u0441\u043b\u043e\u0432\u0430\u043c \u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c, \u0443\u0434\u0437\u0435\u043d\u044c \u0456 \u045e\u043d\u0430\u0447\u044b. \u0417\u0440\u0430\u0431\u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u045e \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0447\u0430\u0441, \u0430 \u045e \u0434\u0437\u0435\u043d\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u044b\u043c\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0441\u043a\u0430\u0440\u0431.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0447\u044b\u0441\u0446\u0456 \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u0431 \u044f\u043d\u043e \u043c\u0430\u0433\u043b\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0441\u0430\u043c\u0443\u044e \u0448\u0447\u043e\u0434\u0440\u0443\u044e \u043b\u0430\u0441\u043a\u0443. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0443\u0441\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e, \u0430\u043b\u0435 \u045e\u0434\u0437\u0435\u043b \u0443 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c \u0434\u0430\u0435\u0446\u0446\u0430 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u0432\u0435\u0440\u044b. \u041a\u0430\u043b\u0456 \u0442\u044b \u043c\u0430\u043b\u0430 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e, \u043c\u0430\u043b\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448. \u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e \u0448\u043c\u0430\u0442, \u0448\u043c\u0430\u0442 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448. \u0411\u044f\u0436\u044b\u0448 \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0442\u0430\u043c\u0443 \u0442\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0431\u0430\u0447 \u0456\u043d\u0448\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u043c\u0430\u0435\u0448 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0433\u043e. \u0422\u044b \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0448, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e. \u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0442\u044b \u0434\u0430\u0440\u0430\u0432\u0430\u045e \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0440\u0430\u0432\u0456\u043d\u0456\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0440\u044b\u043f 28, 13; 1 \u042f\u043d 1, 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u0445\u0430\u0432\u0430\u0435 \u0441\u0432\u0430\u0435 \u043f\u0430\u043c\u044b\u043b\u043a\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0425\u0442\u043e \u0436 \u043f\u0440\u044b\u0437\u043d\u0430\u0435\u0446\u0446\u0430 \u045e \u0456\u0445 \u0456 \u0432\u044b\u043f\u0440\u0430\u045e\u043b\u044f\u0435, \u0442\u043e\u0439 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0436 \u0432\u044b\u0437\u043d\u0430\u0435\u043c \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f, \u0442\u043e \u0411\u043e\u0433, \u0432\u0435\u0440\u043d\u044b \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u043c \u0433\u0440\u0430\u0445\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0436 \u043f\u0440\u044b\u0437\u043d\u0430\u0435\u0446\u0446\u0430 \u045e \u0456\u0445 \u0456 \u0432\u044b\u043f\u0440\u0430\u045e\u043b\u044f\u0435, \u0442\u043e\u0439 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_2_ID":"141","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Serm. 19, 2-3: CCL 41, 252-254)<\/span><br \/><span style=\"color: #ff0000;\">\u0410\u0445\u0432\u044f\u0440\u0430 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 &ndash; \u0434\u0443\u0445 \u043f\u0430\u043a\u043e\u0440\u043d\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0432\u0456\u0434 \u043a\u0430\u0436\u0430: &laquo;\u042f \u0432\u0435\u0434\u0430\u044e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u043c\u0430\u0435&raquo; (\u041f\u0441 51 [50], 5). \u041a\u0430\u043b\u0456 \u044f \u043f\u0440\u044b\u0437\u043d\u0430\u044e, \u0422\u044b \u0437\u0430\u0431\u0443\u0434\u0437\u044c. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0434\u0443\u043c\u0430\u0446\u044c, \u0448\u0442\u043e \u043c\u044b \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u044f \u0456 \u043d\u0435 \u043c\u0430\u0435\u043c \u0433\u0440\u0430\u0445\u0443. \u041a\u0430\u0431 \u0436\u044b\u0446\u0446\u0451 \u0437\u0430\u0441\u043b\u0443\u0436\u0432\u0430\u043b\u0430 \u043f\u0430\u0445\u0432\u0430\u043b\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0430\u0431 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0456 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e. \u041b\u044e\u0434\u0437\u0456 \u0436, \u044f\u043a\u0456\u043c \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u043d\u0430\u0434\u0437\u0435\u0456, \u0442\u044b\u043c \u043c\u0435\u043d\u0448 \u0437\u0432\u044f\u0440\u0442\u0430\u044e\u0446\u044c \u0443\u0432\u0430\u0433\u0443 \u043d\u0430 \u0441\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456, \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0432\u044b\u0448\u0443\u043a\u0432\u0430\u044e\u0446\u044c \u0456\u0445 \u0443 \u0456\u043d\u0448\u044b\u0445. A \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0432\u044b\u043f\u0440\u0430\u0432\u0456\u0446\u044c \u0437\u043b\u043e, \u0430\u043b\u0435 \u043a\u0430\u0431 \u044f\u0433\u043e \u0430\u0441\u0443\u0434\u0437\u0456\u0446\u044c. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u043d\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044f, \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u0446\u044c \u0456\u043d\u0448\u044b\u0445. \u0410\u043b\u0435 \u043d\u0435 \u0442\u0430\u043a\u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0456 \u043f\u0430\u043a\u0443\u0442\u044b \u0440\u0430\u0456\u0446\u044c \u043d\u0430\u043c \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442 \u0443 \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u042f \u0432\u0435\u0434\u0430\u044e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u043c\u0430\u0435, \u0456 \u0433\u0440\u044d\u0445 \u043c\u043e\u0439 \u0437\u0430\u045e\u0436\u0434\u044b \u043f\u0435\u0440\u0430\u0434\u0430 \u043c\u043d\u043e\u044e&raquo; (\u041f\u0441 51 [50], 5). \u041d\u0435 \u0448\u0443\u043a\u0430\u045e \u0447\u0443\u0436\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e. \u0414\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0451 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435, \u043d\u0435 \u0430\u0448\u0443\u043a\u0432\u0430\u045e \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u045e\u0441\u044f \u043d\u0430\u0434 \u0441\u0430\u0431\u043e\u044e. \u041d\u0435 \u0434\u0430\u0433\u0430\u0434\u0436\u0430\u045e \u0441\u0430\u0431\u0435, \u0442\u0430\u043c\u0443 \u043c\u0435\u045e \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0430\u0431 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0447\u0430\u0448 \u043f\u0430\u044f\u0434\u043d\u0430\u0446\u0446\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c? \u041f\u0430\u0441\u0442\u0443\u043f\u0430\u0439 \u0442\u0430\u043a, \u043a\u0430\u0431 \u0411\u043e\u0433 \u043f\u0430\u044f\u0434\u043d\u0430\u045e\u0441\u044f \u0437 \u0442\u0430\u0431\u043e\u044e. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u043f\u0440\u0430 \u0448\u0442\u043e \u0447\u044b\u0442\u0430\u0435\u043c \u0443 \u0433\u044d\u0442\u044b\u043c \u043f\u0441\u0430\u043b\u044c\u043c\u0435: &laquo;\u0411\u043e \u0422\u044b \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0435\u0448 \u0430\u0445\u0432\u044f\u0440\u044b, \u0443\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0435, \u0445\u043e\u0446\u044c \u0431\u044b \u0434\u0430\u045e \u044f, \u0422\u0430\u0431\u0435 \u043d\u0435 \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430&raquo; (\u041f\u0441 51 [50], 18). \u0410 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u0448 \u0430\u0445\u0432\u044f\u0440\u044b? \u041d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0430\u0445\u0432\u044f\u0440\u0443\u0435\u0448? \u041d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0434\u0430\u0441\u0456, \u043a\u0430\u0431 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430? \u042f\u043a \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0411\u043e \u0422\u044b \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0435\u0448 \u0430\u0445\u0432\u044f\u0440\u044b, \u0443\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0435, \u0445\u043e\u0446\u044c \u0431\u044b \u0434\u0430\u045e \u044f, \u0422\u0430\u0431\u0435 \u043d\u0435 \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430&raquo; (\u041f\u0441 51 [50], 18). \u0421\u043b\u0443\u0445\u0430\u0439 \u0434\u0430\u043b\u0435\u0439 \u0456 \u043a\u0430\u0436\u044b: &laquo;\u0410\u0445\u0432\u044f\u0440\u0430 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 &ndash; \u0434\u0443\u0445 \u043f\u0430\u043a\u043e\u0440\u043d\u044b, \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b\u043c \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0422\u044b, \u0411\u043e\u0436\u0430, \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435\u0448&raquo; (\u041f\u0441 51 [50], 19). \u0410\u0434\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u044b\u044f \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0430\u0445\u0432\u044f\u0440\u044b, \u0442\u044b \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u0448 \u0446\u044f\u043f\u0435\u0440. \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0442\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u045e \u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u0436\u044b\u0432\u0451\u043b \u0441\u0430 \u0441\u0442\u0430\u0442\u043a\u0443. &laquo;\u041a\u0430\u043b\u0456 \u0431 \u0442\u044b \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0430\u0445\u0432\u044f\u0440\u0430\u045e, \u044f \u043f\u0440\u044b\u043d\u0451\u0441 \u0431\u044b \u043d\u0430\u043f\u044d\u045e\u043d\u0430&raquo; (\u043f\u0430\u0440. \u041f\u0441 51 [50], 18). \u0410 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0435\u0448 \u0443\u0436\u043e \u0442\u044b\u0445, \u0430\u043b\u0435 \u0430\u0434\u043d\u0430\u043a \u043f\u0440\u0430\u0433\u043d\u0435\u0448 \u0430\u0445\u0432\u044f\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0423\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0456, &ndash; \u043a\u0430\u0436\u0430, &ndash; \u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u044e\u0446\u0446\u0430 \u0422\u0430\u0431\u0435&raquo;. \u041a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u044e\u0446\u0446\u0430, \u0442\u043e \u0446\u0456 \u0436 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e\u0436\u043e \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u044b\u0445 \u0422\u0430\u0431\u0435 \u0430\u0445\u0432\u044f\u0440? \u0410\u043b\u0435 \u0436 &laquo;\u0430\u0445\u0432\u044f\u0440\u0430 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 &ndash; \u0434\u0443\u0445 \u043f\u0430\u043a\u043e\u0440\u043d\u044b, \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b\u043c \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0422\u044b, \u0411\u043e\u0436\u0430, \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435\u0448&raquo; (\u041f\u0441 51 [50], 19). \u0423 \u0446\u044f\u0431\u0435 \u0451\u0441\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u044b \u043c\u043e\u0433 \u0431\u044b \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u045e \u0430\u0445\u0432\u044f\u0440\u0443. \u041d\u0435 \u043c\u0430\u0435\u0448 \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0430\u0446\u0446\u0430 \u0441\u0432\u044f\u0440\u043e\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0430\u0442\u043a\u0443 \u0456 \u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u043a\u0430\u0440\u0430\u0431\u043b\u0456, \u043a\u0430\u0431 \u0434\u0430\u0431\u0440\u0430\u0446\u0446\u0430 \u0434\u0430 \u0441\u0430\u043c\u044b\u0445 \u0434\u0430\u043b\u0451\u043a\u0456\u0445 \u043a\u0440\u0430\u0456\u043d \u0456 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u0430\u0434\u0442\u0443\u043b\u044c \u0434\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456. \u0421\u0442\u0430\u0440\u0430\u0439\u0441\u044f \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435 \u0411\u043e\u0433\u0443. \u0422\u0440\u044d\u0431\u0430 \u0430\u0431\u0443\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u044b \u0441\u043a\u0440\u0443\u0445\u0443. \u0427\u0430\u043c\u0443 \u0431\u0430\u0456\u0448\u0441\u044f, \u0448\u0442\u043e \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b\u043c, \u044f\u043d\u043e \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u0446\u044c? \u0422\u044b \u0436 \u0447\u044b\u0442\u0430\u0435\u0448: &laquo;\u0427\u044b\u0441\u0442\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0441\u0442\u0432\u0430\u0440\u044b \u045e\u0432\u0430 \u043c\u043d\u0435, \u0411\u043e\u0436\u0430&raquo; (\u041f\u0441 51 [50], 12). \u041a\u0430\u0431 \u043c\u0430\u0433\u043b\u043e \u0441\u044d\u0440\u0446\u0430 \u0441\u0442\u0430\u0446\u044c \u0447\u044b\u0441\u0442\u044b\u043c, \u0442\u0440\u044d\u0431\u0430 \u0430\u0431\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u043a\u0440\u0443\u0445\u0443 \u045e \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043c\u044b \u0433\u0440\u0430\u0448\u044b\u043c, \u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u043c\u0441\u044f \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433\u0443 \u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u044e\u0446\u0446\u0430 \u0433\u0440\u0430\u0445\u0456. A \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0431\u044f\u0437\u0433\u0440\u044d\u0448\u043d\u044b\u043c\u0456, \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u045e \u0442\u044b\u043c \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0434\u0430 \u0411\u043e\u0433\u0430, \u0448\u0442\u043e \u043d\u0430\u043c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u042f\u043c\u0443 \u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430. \u0422\u0430\u043a \u0442\u044b \u0437&rsquo;\u044f\u0434\u043d\u0430\u0435\u0448\u0441\u044f \u0437 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u044f\u0439, \u0431\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u0431\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u045e \u0442\u0430\u0431\u0435 \u0442\u043e\u0435, \u0434\u0430 \u0447\u0430\u0433\u043e \u0456 \u0411\u043e\u0433, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0446\u044f\u0431\u0435, \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u0430\u0433\u0456\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 51 (50), 12<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u0440\u0430\u0445\u0456 \u043c\u0430\u0435, \u041f\u0430\u043d\u0435, \u043f\u0440\u0430\u0431\u0456\u043b\u0456 \u043c\u044f\u043d\u0435, \u044f\u043a \u0441\u0442\u0440\u044d\u043b\u044b, \u0430\u043b\u0435 \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u0430\u0434\u043a\u0440\u044b\u044e\u0446\u0446\u0430 \u0440\u0430\u043d\u044b, <span style=\"color: #ff0000;\">*<\/span> \u0430\u0437\u0434\u0430\u0440\u0430\u0432\u0456 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u043b\u0435\u043a\u0430\u043c \u043f\u0430\u043a\u0443\u0442\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0427\u044b\u0441\u0442\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0441\u0442\u0432\u0430\u0440\u044b \u045e\u0432\u0430 \u043c\u043d\u0435, \u0411\u043e\u0436\u0430, \u0456 \u0430\u0434\u043d\u0430\u0432\u0456 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0442\u0440\u044b\u0432\u0430\u043b\u044b \u0434\u0443\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0437\u0434\u0430\u0440\u0430\u0432\u0456 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u043b\u0435\u043a\u0430\u043c \u043f\u0430\u043a\u0443\u0442\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"142","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041b\u0456\u0441\u0442 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&raquo; \u0441\u0432. \u041a\u043b\u0456\u043c\u044d\u043d\u0442\u0430 \u0406, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 46, 2 &minus; 47, 4; 48, 1-6: Funk 1, 119-123)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435 \u043a\u043b\u0430\u043f\u043e\u0446\u044f\u0446\u0446\u0430 \u043f\u0440\u0430 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0435 \u0434\u0430\u0431\u0440\u043e, \u0430 \u043d\u0435 \u043f\u0440\u0430 \u0441\u0432\u0430\u0451 \u045e\u043b\u0430\u0441\u043d\u0430\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u042f\u0434\u043d\u0430\u0439\u0446\u0435\u0441\u044f \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0431\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u0437 \u0456\u043c\u0456 \u043b\u0443\u0447\u044b\u0446\u0446\u0430, \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u0446\u0430&raquo;. \u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0447\u044b\u0442\u0430\u0435\u043c: &laquo;\u0417 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u044b\u043c \u0431\u0443\u0434\u0437\u0435\u0448 \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u044b, \u0437 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u0431\u0443\u0434\u0437\u0435\u0448 \u0432\u044b\u0431\u0440\u0430\u043d\u044b, \u0430 \u0437 \u0445\u0456\u0442\u0440\u044b\u043c \u0441\u0442\u0430\u043d\u0435\u0448 \u0445\u0456\u0442\u0440\u044b\u043c&raquo; (\u043f\u0430\u0440. \u041f\u0441 18 [17], 26). \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u044f\u0434\u043d\u0430\u0446\u0446\u0430 \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u043c\u0456 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c\u0456, \u0431\u043e \u044f\u043d\u044b \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0411\u043e\u0433\u0430. \u0410\u0434\u043a\u0443\u043b\u044c \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0441\u043f\u0440\u044d\u0447\u043a\u0456 \u0456 \u0433\u043d\u0435\u045e, \u0437\u0432\u0430\u0434\u044b, \u043f\u0430\u0434\u0437\u0435\u043b \u0456 \u0432\u043e\u0439\u043d\u044b? \u0426\u0456 \u0436 \u043d\u0435 \u0430\u0434\u043d\u0430\u0433\u043e \u043c\u044b \u043c\u0430\u0435\u043c \u0411\u043e\u0433\u0430, \u0430\u0434\u043d\u0430\u0433\u043e \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0434\u043d\u0430\u0433\u043e \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u0430\u0433\u0430 \u043d\u0430\u043c \u0414\u0443\u0445\u0430 \u043b\u0430\u0441\u043a\u0456, \u0430\u0434\u043d\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435? \u0427\u0430\u043c\u0443 \u0436 \u043c\u044b \u0440\u0430\u0437\u0440\u044b\u0432\u0430\u0435\u043c \u0456 \u0440\u0430\u0437\u0434\u0437\u0456\u0440\u0430\u0435\u043c \u0447\u043b\u0435\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u0447\u0430\u043c\u0443 \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u0435\u043c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430 \u0456 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0434\u0434\u0430\u0435\u043c\u0441\u044f \u0448\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0443, \u0448\u0442\u043e \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u043c \u0430\u0431 \u0442\u044b\u043c, \u0448\u0442\u043e \u043c\u044b \u0447\u043b\u0435\u043d\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0433\u0430\u0434\u0430\u0439\u0446\u0435 \u0441\u0430\u0431\u0435 \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0413\u043e\u0440\u0430 \u0433\u044d\u0442\u0430\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443! \u041b\u0435\u043f\u0448 \u0431\u044b\u043b\u043e \u0431 \u044f\u043c\u0443 \u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u0446\u0430, \u0447\u044b\u043c \u0431\u044b\u0446\u044c \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u0433\u0440\u0430\u0445\u0443 \u0430\u0434\u043d\u0430\u0433\u043e \u0437 \u043c\u0430\u0456\u0445 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445. \u041b\u0435\u043f\u0448 \u0431\u044b\u043b\u043e \u0431, \u043a\u0430\u043b\u0456 \u0431 \u043f\u0430\u0432\u0435\u0441\u0456\u043b\u0456 \u043d\u0430 \u0448\u044b\u044e \u044f\u043c\u0443 \u043c\u043b\u044b\u043d\u0430\u0432\u044b \u043a\u0430\u043c\u0435\u043d\u044c \u0456 \u043a\u0456\u043d\u0443\u043b\u0456 \u045e \u043c\u043e\u0440\u0430, \u0447\u044b\u043c \u0451\u043d \u0431\u044b \u0441\u043f\u0430\u043a\u0443\u0441\u0456\u045e \u0430\u0434\u043d\u043e\u0433\u0430 \u0437 \u0433\u044d\u0442\u044b\u0445 \u043c\u0430\u0456\u0445 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445&raquo; (\u043f\u0430\u0440. \u041b\u043a 17, 1-2). \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u043f\u0430\u0434\u0437\u0435\u043b \u0437\u0433\u043e\u0440\u0448\u044b\u045e \u043c\u043d\u043e\u0433\u0456\u0445 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u0441\u044f\u0440\u043e\u0434 \u043c\u043d\u043e\u0433\u0456\u0445 \u043f\u0430\u0441\u0435\u044f\u045e \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0435, \u043c\u043d\u043e\u0433\u0456\u0445 \u0437\u043d\u0435\u0430\u0445\u0432\u043e\u0446\u0456\u045e, \u0443\u0441\u0456\u0445 \u0430\u043a\u0443\u043d\u0443\u045e \u0443 \u0441\u043c\u0443\u0442\u0430\u043a, \u0443\u0441\u0456\u043c \u043f\u0440\u044b\u043d\u0451\u0441 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435. \u0406 \u0433\u044d\u0442\u0430 \u043d\u044f\u0437\u0433\u043e\u0434\u0430 \u0442\u0440\u044b\u0432\u0430\u0435 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u043d\u0430\u0434\u0430\u043b\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0447\u044b\u0442\u0430\u0439\u0446\u0435 \u043b\u0456\u0441\u0442 \u0441\u0432. \u041f\u0430\u045e\u043b\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430. \u0428\u0442\u043e \u0436 \u0442\u0430\u043a\u043e\u0433\u0430 \u0451\u043d \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0432\u0430\u043c, \u043a\u0430\u043b\u0456 \u0440\u0430\u0441\u043f\u0430\u0447\u044b\u043d\u0430\u045e \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0437 \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u044f \u0451\u043d \u043f\u0456\u0441\u0430\u045e \u0432\u0430\u043c \u043f\u0440\u0430 \u0441\u044f\u0431\u0435, \u043f\u0440\u0430 \u041a\u0435\u0444\u0430\u0441\u0430 \u0456 \u0410\u043f\u043e\u043b\u0430\u0441\u0430, \u0431\u043e \u0456 \u0442\u0430\u0434\u044b \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0456 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u043f\u0430\u0434\u0437\u0435\u043b\u044b. \u0410\u0434\u043d\u0430\u043a \u0443 \u0442\u044b\u043c, \u0448\u0442\u043e \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456\u0441\u044f, \u0432\u044b \u043c\u0430\u0435\u0446\u0435 \u043c\u0435\u043d\u0448\u0443\u044e \u0432\u0456\u043d\u0443, \u0431\u043e \u0442\u0430\u0434\u044b \u0432\u044b \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0441\u043b\u0430\u045e\u043d\u044b\u0445 \u0441\u0432\u0430\u0456\u043c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c, \u0430\u0431\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u044b\u045e \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u0456\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043c\u0430\u0433\u0430 \u0445\u0443\u0442\u0447\u044d\u0439 \u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0441\u043a\u043e\u043d\u0447\u044b\u043c \u0437 \u0433\u044d\u0442\u044b\u043c \u0431\u044f\u0437\u043b\u0430\u0434\u0434\u0437\u0435\u043c. \u0423\u043f\u0430\u0434\u0437\u0451\u043c \u0434\u0430 \u043d\u043e\u0433 \u041f\u0430\u043d\u0430 \u0456 \u0441\u0430 \u0441\u043b\u044f\u0437\u044c\u043c\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0441\u0456\u0446\u044c, \u043a\u0430\u0431 \u0401\u043d \u0437\u043b\u0456\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u043a\u0430\u0431 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u043f\u0430\u044f\u0434\u043d\u0430\u0446\u0446\u0430 \u0437 \u0406\u043c \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u043d\u0430\u0441 \u0437\u043d\u043e\u045e \u0434\u0430 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0456 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u043f\u0435\u0440\u0430\u0436\u044b\u0432\u0430\u043d\u043d\u044f \u0431\u0440\u0430\u0442\u043d\u044f\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0431\u043e \u0433\u044d\u0442\u0430 &minus; \u0431\u0440\u0430\u043c\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u0434\u043a\u0440\u044b\u0442\u0430\u044f \u0434\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0410\u0434\u0447\u044b\u043d\u0456\u0446\u0435 \u043c\u043d\u0435 \u0431\u0440\u0430\u043c\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f \u045e\u0432\u0430\u0439\u0434\u0443 \u045e \u0456\u0445 \u0456 \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u041f\u0430\u043d\u0430. \u0412\u043e\u0441\u044c \u0431\u0440\u0430\u043c\u044b \u041f\u0430\u043d\u0430 &ndash; \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u045e\u0432\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u0456\u0445&raquo; (\u041f\u0441 118 [117], 19-20). \u0428\u043c\u0430\u0442 \u0451\u0441\u0446\u044c \u0430\u0434\u0447\u044b\u043d\u0435\u043d\u044b\u0445 \u0431\u0440\u0430\u043c, \u0430\u043b\u0435 \u0431\u0440\u0430\u043c\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435. \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f, \u0445\u0442\u043e \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u043f\u0440\u0430\u0437 \u044f\u0435 \u0456 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0435 \u043a\u0440\u043e\u043a\u0456 \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0441\u043f\u0430\u043a\u043e\u0439 \u0432\u0430 \u045e\u0441\u0456\u043c. \u041d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u0432\u0435\u0440\u043d\u044b, \u0437\u0434\u043e\u043b\u044c\u043d\u044b \u045e \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0456, \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b \u045e \u0441\u043b\u0443\u0445\u0430\u043d\u043d\u0456, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b \u045e \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u0445. \u0422\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0441\u0446\u0456\u043f\u043b\u044b, \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u044f\u0433\u043e \u0448\u0430\u043d\u0443\u044e\u0446\u044c. \u041f\u0430\u0432\u0456\u043d\u0435\u043d \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u0430\u0431 \u0442\u044b\u043c, \u0448\u0442\u043e \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0435 \u0434\u043b\u044f \u045e\u0441\u0456\u0445, \u0430 \u043d\u0435 \u0430\u0431 \u0443\u043b\u0430\u0441\u043d\u044b\u043c \u0434\u0430\u0431\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 9, 19\u0430. 22; \u042f\u043a 29, 15-16\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0443\u0447\u044b \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c \u0430\u0434 \u0443\u0441\u0456\u0445, \u044f \u0441\u0442\u0430\u045e \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0443\u0441\u0456\u0445. \u0414\u043b\u044f \u043d\u044f\u0434\u0443\u0436\u044b\u0445 \u044f \u0441\u0442\u0430\u045e, \u044f\u043a \u043d\u044f\u0434\u0443\u0436\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0414\u043b\u044f \u045e\u0441\u0456\u0445 \u044f \u0441\u0442\u0430\u045e \u0443\u0441\u0456\u043c, \u043a\u0430\u0431 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0431\u044b\u045e \u0432\u0430\u0447\u044b\u043c\u0430 \u0434\u043b\u044f \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u044b\u0445, \u043d\u0430\u0433\u0430\u043c\u0456 \u0434\u043b\u044f \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u0430\u0433\u0430, \u0430\u0439\u0446\u043e\u043c \u0434\u043b\u044f \u045e\u0431\u043e\u0433\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u043b\u044f \u045e\u0441\u0456\u0445 \u044f \u0441\u0442\u0430\u045e \u0443\u0441\u0456\u043c, \u043a\u0430\u0431 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445.<\/p>\r\n"}, {"GCH_CH_2_ID":"143","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 32, 29: CCL 38, 272-273)<\/span><br \/><span style=\"color: #ff0000;\">\u0422\u044b\u044f, \u0448\u0442\u043e \u043f\u0430-\u0437\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c, \u0445\u043e\u0447\u0443\u0446\u044c \u0446\u0456 \u043d\u0435 \u0445\u043e\u0447\u0443\u0446\u044c, \u043d\u0430\u0448\u044b\u044f \u0431\u0440\u0430\u0442\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u0434\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u044e, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0432\u043e\u043d\u043a\u0456, \u0446\u0456 \u0442\u043e \u0434\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u043d\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u044e\u0446\u044c \u044f\u0448\u0447\u044d \u0425\u0440\u044b\u0441\u0442\u0430, \u0446\u0456 \u0442\u043e \u0434\u0430 \u0430\u0434\u043b\u0443\u0447\u0430\u043d\u044b\u0445 \u0430\u0434 \u043d\u0430\u0441, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u043c\u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u044e\u0446\u044c \u0413\u0430\u043b\u0430\u0432\u0443, \u0430\u043b\u0435 \u043d\u0435 \u0445\u043e\u0447\u0443\u0446\u044c \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u0426\u0435\u043b\u0430. \u0417 \u0431\u043e\u043b\u0435\u043c \u0434\u0443\u043c\u0430\u0435\u043c \u043f\u0440\u0430 \u0456\u0445 \u044f\u043a \u043f\u0440\u0430 \u043d\u0430\u0448\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e. \u0425\u043e\u0447\u0443\u0446\u044c \u0446\u0456 \u043d\u0435 \u0445\u043e\u0447\u0443\u0446\u044c, \u044f\u043d\u044b \u043d\u0430\u0448\u044b\u044f \u0431\u0440\u0430\u0442\u044b. \u042f\u043d\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u0431 \u043d\u0430\u0448\u044b\u043c\u0456 \u0431\u0440\u0430\u0442\u0430\u043c\u0456, \u043a\u0430\u043b\u0456 \u0431 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c: &laquo;\u041e\u0439\u0447\u0430 \u043d\u0430\u0448&raquo; (\u041c\u0446 6, 9).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0422\u044b\u043c, \u0445\u0442\u043e \u0432\u0430\u043c \u043a\u0430\u0436\u0430: &ldquo;\u0412\u044b \u043d\u0435 \u043d\u0430\u0448\u044b\u044f \u0431\u0440\u0430\u0442\u044b&rdquo;, \u0441\u043a\u0430\u0436\u044b\u0446\u0435: &ldquo;\u0412\u044b \u0431\u0440\u0430\u0442\u044b \u043d\u0430\u0448\u044b\u044f&rdquo;&raquo; (\u0406\u0441 66, 5). \u041f\u0430\u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u043c\u043e\u0433 \u0442\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u043a: \u043f\u0440\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e? \u041d\u0435, \u0431\u043e \u043c\u044b \u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c \u0456\u0445 \u0431\u0440\u0430\u0442\u0430\u043c\u0456 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043c\u043e\u0432\u0430\u044e \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f. \u0422\u0430\u0434\u044b \u043c\u043e\u0436\u0430 \u043f\u0440\u0430 \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u044f\u043a\u0456\u044f \u043d\u0435 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0425\u0440\u044b\u0441\u0442\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u044b\u0442\u0430\u0439\u0446\u0435 \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u0441\u0432. \u041f\u0430\u045e\u043b\u0430 \u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u0439\u0446\u0435\u0441\u044f, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430 &laquo;\u0431\u0440\u0430\u0442\u044b&raquo; \u0431\u0435\u0437 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0434\u0430\u0434\u0430\u0442\u043a\u0443, \u043c\u0430\u0435 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e: &laquo;\u0410 \u0442\u044b \u0447\u0430\u043c\u0443 \u0430\u0441\u0443\u0434\u0436\u0430\u0435\u0448 \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e? \u0406 \u0447\u0430\u043c\u0443 \u0442\u044b \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435\u0448 \u0431\u0440\u0430\u0442\u0430\u043c \u0441\u0432\u0430\u0456\u043c?&raquo; (\u0420\u044b\u043c 14, 10). \u0406 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b: &laquo;\u0410\u043b\u0435 \u0432\u044b \u0441\u0430\u043c\u0456 \u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u0435 \u0456 \u0430\u0448\u0443\u043a\u0432\u0430\u0435\u0446\u0435, \u0456 \u043f\u0440\u044b \u0433\u044d\u0442\u044b\u043c \u0431\u0440\u0430\u0442\u043e\u045e!&raquo; (1 \u041a\u0430\u0440 6, 8).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f, \u0445\u0442\u043e \u043d\u0430\u043c \u043a\u0430\u0436\u0430: &laquo;\u0412\u044b \u043d\u0435 \u043d\u0430\u0448\u044b\u044f \u0431\u0440\u0430\u0442\u044b&raquo;, \u043b\u0456\u0447\u0430\u0446\u044c \u043d\u0430\u0441 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c\u0456. \u0422\u0430\u043c\u0443 \u0445\u043e\u0447\u0443\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u0441 \u043d\u0430\u043d\u043e\u0432\u0430 \u0437 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c, \u0448\u0442\u043e \u0434\u0430\u044e\u0446\u044c \u043d\u0430\u043c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043c\u044b \u043d\u0435 \u043c\u0430\u0435\u043c. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u0432\u044b\u0440\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u043c\u044b\u043b\u043a\u0430 \u043d\u0435\u043f\u0440\u044b\u0437\u043d\u0430\u043d\u043d\u044f \u043d\u0430\u0441 \u0431\u0440\u0430\u0442\u0430\u043c\u0456. \u0414\u044b\u043a \u0447\u0430\u043c\u0443 \u0436 \u043d\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a: &laquo;\u0410\u0434\u043a\u0430\u0436\u044b\u0446\u0435 \u0456\u043c: &ldquo;\u0412\u044b \u043d\u0430\u0448\u044b\u044f \u0431\u0440\u0430\u0442\u044b&rdquo;&raquo;, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043c\u044b \u0431\u0430\u0447\u044b\u043c \u0443 \u0456\u0445 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u0435\u043c. \u042f\u043d\u044b \u043d\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u044e\u0446\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u0445\u0440\u043e\u0441\u0442\u0443 \u0456 \u043d\u0435 \u043b\u0456\u0447\u0430\u0446\u044c \u043d\u0430\u0441 \u0431\u0440\u0430\u0442\u0430\u043c\u0456, \u043c\u044b \u0436, \u043d\u0435 \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u044e\u0447\u044b \u045e\u0434\u0437\u0435\u043b\u0435\u043d\u0430\u0433\u0430 \u0456\u043c\u0456, \u0430\u043b\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u044e\u0447\u044b \u0456\u0445 \u0445\u0440\u043e\u0441\u0442 \u0441\u0432\u0430\u0456\u043c \u0443\u043b\u0430\u0441\u043d\u044b\u043c, \u043a\u0430\u0436\u0430\u043c: &laquo;\u0412\u044b \u043d\u0430\u0448\u044b\u044f \u0431\u0440\u0430\u0442\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0432\u0430\u043c \u0441\u043a\u0430\u0436\u0443\u0446\u044c: &laquo;\u0427\u0430\u043c\u0443 \u043d\u0430\u0441 \u0448\u0443\u043a\u0430\u0435\u0446\u0435? \u0427\u0430\u0433\u043e \u0445\u043e\u0447\u0430\u0446\u0435 \u0430\u0434 \u043d\u0430\u0441?&raquo;. \u041c\u044b \u0430\u0434\u043a\u0430\u0436\u0430\u043c: &laquo;\u0412\u044b \u043d\u0430\u0448\u044b\u044f \u0431\u0440\u0430\u0442\u044b&raquo;. \u041a\u0430\u043b\u0456 \u0441\u043a\u0430\u0436\u0443\u0446\u044c: &laquo;\u041f\u0430\u043a\u0456\u043d\u044c\u0446\u0435 \u043d\u0430\u0441 \u0443 \u0441\u043f\u0430\u043a\u043e\u0456; \u043c\u044b \u043d\u0435 \u043c\u0430\u0435\u043c \u0437 \u0432\u0430\u043c\u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430&raquo;. \u0410\u0434\u043d\u0430\u043a \u043c\u044b \u043c\u0430\u0435\u043c \u0448\u043c\u0430\u0442 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430: \u0432\u044b\u0437\u043d\u0430\u0451\u043c \u0442\u0430\u0433\u043e \u0441\u0430\u043c\u0430\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u0430\u043c\u0443 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u0443 \u0430\u0434\u043d\u044b\u043c \u0426\u0435\u043b\u0435, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b\u044f \u0430\u0434\u043d\u043e\u0439 \u0413\u0430\u043b\u0430\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u043c\u044b \u0437\u0430\u043a\u043b\u0456\u043d\u0430\u0435\u043c \u0432\u0430\u0441 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0443\u044e \u0432\u0435\u043b\u0456\u0437\u0430\u0440\u043d\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u044f\u043a\u043e\u0439 \u043a\u043e\u0440\u043c\u0456\u043c\u0441\u044f, \u0445\u043b\u0435\u0431\u0430\u043c \u044f\u043a\u043e\u0439 \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435\u043c\u0441\u044f, \u0437\u0430\u043a\u043b\u0456\u043d\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u041f\u0430\u043d\u0430\u043c \u043d\u0430\u0448\u044b\u043c, \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c (\u0443\u0436\u043e \u043f\u0430\u0440\u0430, \u043a\u0430\u0431 \u043c\u044b \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456 \u0456\u043c \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0456 \u0448\u0447\u043e\u0434\u0440\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u043f\u0440\u043e\u0441\u044f\u0447\u044b \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0434\u0430\u045e \u0456\u043c \u043d\u0430\u0440\u044d\u0448\u0446\u0435 \u0446\u0432\u044f\u0440\u043e\u0437\u044b \u0440\u043e\u0437\u0443\u043c, \u043a\u0430\u0431 \u044f\u043d\u044b \u0430\u043f\u0430\u043c\u044f\u0442\u0430\u043b\u0456\u0441\u044f \u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043b\u0456\u0441\u044f, \u0448\u0442\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043c\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043c\u0430\u0433\u043b\u0456 \u0431 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0437\u0435; \u0437\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u045e \u0456\u0445 \u0442\u043e\u043b\u044c\u043a\u0456 \u0445\u0432\u0430\u0440\u043e\u0431\u0430 \u0437\u0430\u045e\u0437\u044f\u0442\u0430\u0441\u0446\u0456, \u044f\u043a\u0430\u044f \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0430\u0441\u043b\u0430\u0431\u043b\u044f\u0435, \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043d\u0430\u0431\u0456\u0440\u0430\u0435 \u043c\u043e\u0446), \u043c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u0437 \u0433\u0430\u0440\u0430\u0447\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430 \u0411\u043e\u0433\u0430 \u0437\u0430 \u0441\u043b\u0430\u0431\u044b\u0445, \u0437\u0430 \u043c\u0443\u0434\u0440\u044b\u0445 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u043f\u0430\u0447\u0443\u0446\u0446\u0451\u0432\u044b\u0445 \u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u0445. \u0413\u044d\u0442\u0430 \u043d\u0430\u0448\u044b\u044f \u0431\u0440\u0430\u0442\u044b: \u0443\u0434\u0437\u044f\u043b\u044f\u044e\u0446\u044c \u0442\u044b\u044f \u0441\u0430\u043c\u044b\u044f \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u044b. \u0425\u043e\u0446\u044c \u0456 \u043d\u0435 \u0437 \u043d\u0430\u043c\u0456, \u0430\u043b\u0435 \u0442\u044b\u044f \u0441\u0430\u043c\u044b\u044f. \u0410\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u0430\u0434\u043d\u043e &laquo;\u0410\u043c\u044d\u043d&raquo;, \u0445\u043e\u0446\u044c \u0456 \u043d\u0435 \u0437 \u043d\u0430\u043c\u0456, \u0430\u043b\u0435 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 &laquo;\u0410\u043c\u044d\u043d&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042d\u0444 4, 1. 3. 4<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u043b\u044e \u0432\u0430\u0441 \u044f, \u0432\u044f\u0437\u0435\u043d\u044c \u0443 \u041f\u0430\u043d\u0443, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f, \u044f\u043a\u0456\u043c \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b; <span style=\"color: #ff0000;\">*<\/span> \u0441\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0434\u043d\u043e \u0446\u0435\u043b\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445, \u044f\u043a \u0456 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u045e \u0430\u0434\u043d\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e.<\/p>\r\n"}, {"GCH_CH_2_ID":"144","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0421\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u044b \u0442\u0432\u043e\u0440 &laquo;\u0412\u0443\u0447\u044d\u043d\u043d\u0435 \u0414\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e&raquo;<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 9, 1 &minus; 10, 6; 14, 1-3: Funk 2, 19-22. 26)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0440\u0430 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0437\u044f\u043a\u0443 \u045e\u0437\u043d\u043e\u0441\u044c\u0446\u0435 \u0442\u0430\u043a. \u041f\u0430\u0434\u0437\u044f\u043a\u0443 \u043d\u0430\u0434 \u043a\u0435\u043b\u0456\u0445\u0430\u043c: &laquo;\u0414\u0437\u044f\u043a\u0443\u0435\u043c \u0422\u0430\u0431\u0435, \u041e\u0439\u0447\u0430 \u043d\u0430\u0448, \u0437\u0430 \u0441\u0432\u044f\u0442\u044b, \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u044b \u0448\u0447\u044d\u043f \u0422\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0456 \u0414\u0430\u0432\u0456\u0434\u0430, \u044f\u043a\u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u043b\u0443\u0433\u0443. \u0422\u0430\u0431\u0435 \u0445\u0432\u0430\u043b\u0430 \u043d\u0430\u0432\u0435\u043a\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0442\u044b\u043c \u043d\u0430\u0434 \u0440\u0430\u0437\u043b\u0430\u043c\u0430\u043d\u044b\u043c \u0445\u043b\u0435\u0431\u0430\u043c: &laquo;\u0414\u0437\u044f\u043a\u0443\u0435\u043c \u0422\u0430\u0431\u0435, \u041e\u0439\u0447\u0430 \u043d\u0430\u0448, \u0437\u0430 \u0436\u044b\u0446\u0446\u0451 \u0456 \u0437\u0430 \u0432\u0435\u0440\u0443, \u044f\u043a\u0443\u044e \u0434\u0430\u045e \u043d\u0430\u043c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u043b\u0443\u0433\u0443. \u0422\u0430\u0431\u0435 \u0445\u0432\u0430\u043b\u0430 \u043d\u0430\u0432\u0435\u043a\u0456. \u042f\u043a \u0433\u044d\u0442\u044b \u0445\u043b\u0435\u0431 \u0431\u044b\u045e \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b \u043f\u0430 \u045e\u0437\u0433\u043e\u0440\u043a\u0430\u0445, a \u043a\u0430\u043b\u0456 \u0431\u044b\u045e \u0441\u0430\u0431\u0440\u0430\u043d\u044b, \u0441\u0442\u0430\u045e \u0447\u044b\u043c\u0441\u044c\u0446\u0456 \u0430\u0434\u043d\u044b\u043c, \u0442\u0430\u043a \u043d\u044f\u0445\u0430\u0439 \u0437\u0431\u044f\u0440\u044d\u0446\u0446\u0430 \u0422\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b \u0437 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456 \u0434\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0411\u043e \u0422\u0432\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u0456 \u043c\u043e\u0446 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0430\u0432\u0435\u043a\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435 \u0456 \u043d\u0435 \u043f&rsquo;\u0435 \u0432\u0430\u0448\u0430\u0439 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0456 \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431\u044b\u045e \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430. \u041f\u0440\u0430 \u0433\u044d\u0442\u0430 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0435 \u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0441\u0430\u0431\u0430\u043a\u0430\u043c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0441\u0432\u044f\u0442\u043e\u0435&raquo; (M\u0446 7, 6).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043d\u043d\u044f \u0434\u0437\u044f\u043a\u0443\u0439\u0446\u0435 \u0442\u0430\u043a: &laquo;\u0414\u0437\u044f\u043a\u0443\u0435\u043c \u0422\u0430\u0431\u0435, \u041e\u0439\u0447\u0430 \u0441\u0432\u044f\u0442\u044b, \u0437\u0430 \u0422\u0432\u0430\u0451 \u0456\u043c\u044f \u0441\u0432\u044f\u0442\u043e\u0435, \u044f\u043a\u043e\u043c\u0443 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0436\u044b\u043b\u043b\u0451 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u043d\u0430\u0448\u044b\u0445; \u0434\u0437\u044f\u043a\u0443\u043c \u0437\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435, \u0432\u0435\u0440\u0443 \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u0434\u0430\u045e \u043d\u0430\u043c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u043b\u0443\u0433\u0443. \u0422\u0430\u0431\u0435 \u0445\u0432\u0430\u043b\u0430 \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b! \u0422\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0451 \u0434\u043b\u044f \u0456\u043c\u044f \u0441\u0432\u0430\u0439\u0433\u043e. \u0422\u044b \u0434\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c \u043d\u0430\u043f\u043e\u0439 \u0456 \u0435\u0436\u0443, \u043a\u0430\u0431 \u044f\u043d\u044b \u0422\u0430\u0431\u0435 \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u043b\u0456. \u041d\u0430\u043c \u0436\u0430 \u0422\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0435\u0436\u0443 \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u043d\u0430\u043f\u043e\u0439, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u043b\u0443\u0433\u0443. \u0417\u0430 \u045e\u0441\u0451 \u0434\u0437\u044f\u043a\u0443\u0435\u043c \u0422\u0430\u0431\u0435, \u0431\u043e \u0422\u044b \u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u0422\u0430\u0431\u0435 \u0445\u0432\u0430\u043b\u0430 \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u043f\u0430\u043c\u044f\u0442\u0430\u0439 \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0422\u0432\u043e\u0439. \u0411\u0430\u0440\u0430\u043d\u0456 \u044f\u0433\u043e \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430 \u0456 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c \u0443 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u0417 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u0431\u0430\u043a\u043e\u045e \u0441\u0432\u0435\u0442\u0443 \u0437\u0431\u044f\u0440\u044b \u044f\u0433\u043e, \u0430\u0441\u0432\u044f\u0446\u0456 \u045e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u0422\u0432\u0430\u0456\u043c, \u044f\u043a\u043e\u0435 \u0422\u044b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u044f\u0433\u043e. \u0411\u043e \u0422\u0432\u0430\u044f \u043c\u043e\u0446 \u0456 \u0445\u0432\u0430\u043b\u0430 \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0430\u0439 \u0436\u0430 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0422\u0432\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0456 \u043f\u0440\u0430\u043c\u0456\u043d\u0435 \u0441\u0432\u0435\u0442 \u0433\u044d\u0442\u044b. \u0413\u0430\u0441\u0430\u043d\u043d\u0430 \u0411\u043e\u0433\u0443 \u0414\u0430\u0432\u0456\u0434\u0430. \u0425\u0442\u043e \u0441\u0432\u044f\u0442\u044b, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0456\u0446\u044c, \u0445\u0442\u043e \u0436 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0456\u043c, \u043d\u044f\u0445\u0430\u0439 \u043a\u0430\u0435\u0446\u0446\u0430. Maran atha. \u0410\u043c\u044d\u043d&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u0431\u0440\u0430\u043d\u044b\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430, \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0439\u0446\u0435 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0432\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456, \u043a\u0430\u0431 \u0430\u0445\u0432\u044f\u0440\u0430 \u0432\u0430\u0448\u0430\u044f \u0431\u044b\u043b\u0430 \u0447\u044b\u0441\u0442\u0430\u044f; \u043f\u0430\u0441\u043b\u044f \u043b\u0430\u043c\u0430\u0439\u0446\u0435 \u0445\u043b\u0435\u0431 \u0456 \u045e\u0437\u043d\u043e\u0441\u044c\u0446\u0435 \u043f\u0430\u0434\u0437\u044f\u043a\u0443. \u0410 \u0442\u043e\u0439, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u043d\u044f\u0437\u0433\u043e\u0434\u0437\u0435 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0431\u0440\u0430\u0442\u0430\u043c, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u043c\u0456\u0440\u044b\u0446\u0446\u0430 \u0437 \u0456\u043c, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0434\u0430\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0432\u0430\u0441, \u043a\u0430\u0431 \u0432\u0430\u0448\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430 \u0431\u044b\u043b\u0430 \u0447\u044b\u0441\u0442\u0430\u0439. \u0411\u043e \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0423 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0456 \u045e \u043a\u043e\u0436\u043d\u044b \u0447\u0430\u0441 \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u043c\u043d\u0435 \u0430\u0445\u0432\u044f\u0440\u0430 \u0447\u044b\u0441\u0442\u0430\u044f, \u0431\u043e \u042f &ndash; \u0432\u044f\u043b\u0456\u043a\u0456 \u041a\u0430\u0440\u043e\u043b\u044c, &minus; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &minus; \u0430 \u041c\u0430\u0451 \u0456\u043c\u044f \u0431\u0443\u0434\u0437\u0435 \u045e \u043f\u0430\u0448\u0430\u043d\u0435 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e&raquo; (\u043f\u0430\u0440. \u041c\u0430\u043b 1, 11. 14).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 10, 16-17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0435\u043b\u0456\u0445 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u044f\u043a\u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c, \u0446\u0456 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0434\u0437\u0435\u043b\u0430\u043c \u0443 \u041a\u0440\u044b\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430?<span style=\"color: #ff0000;\"> *<\/span> \u0425\u043b\u0435\u0431, \u044f\u043a\u0456 \u043b\u0430\u043c\u0430\u0435\u043c, \u0446\u0456 \u0436 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0434\u0437\u0435\u043b\u0430\u043c \u0443 \u0426\u0435\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0430? <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0434\u0437\u0456\u043d \u0451\u0441\u0446\u044c \u0445\u043b\u0435\u0431, \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430 &ndash; \u043c\u044b \u043c\u043d\u043e\u0433\u0456\u044f. \u0411\u043e \u043c\u044b \u045e\u0441\u0435 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u0425\u043b\u0435\u0431\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u043b\u0435\u0431, \u044f\u043a\u0456 \u043b\u0430\u043c\u0430\u0435\u043c, \u0446\u0456 \u0436 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0434\u0437\u0435\u043b\u0430\u043c \u0443 \u0426\u0435\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0430?<\/p>\r\n"}, {"GCH_CH_2_ID":"145","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 118 \u043f\u0441\u0430\u043b\u044c\u043c\u0430 &raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 12. 13-14: CSEL 62, 258-259)<\/span><br \/><span style=\"color: #ff0000;\">C\u0432\u044f\u0442\u044b\u043d\u044f \u0411\u043e\u0433\u0430 \u0441\u0432\u044f\u0442\u0430\u044f, \u0430 \u0432\u044b \u0451\u0439 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0435\u0441\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u042f \u0456 \u0410\u0439\u0446\u0435\u0446 \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u044f\u0433\u043e, \u0456 \u0437\u0440\u043e\u0431\u0456\u043c \u0436\u044b\u043b\u043b\u0451 \u045e \u044f\u0433\u043e&raquo; (\u042f\u043d 14, 23). \u0410\u0434\u0447\u044b\u043d\u0456 \u0441\u0432\u0430\u0435 \u0434\u0437\u0432\u0435\u0440\u044b \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0430\u0434\u043a\u0440\u044b\u0439 \u0442\u0432\u0430\u044e \u0434\u0443\u0448\u0443, \u043f\u0430\u0448\u044b\u0440 \u0442\u0432\u043e\u0439 \u0440\u043e\u0437\u0443\u043c, \u043a\u0430\u0431 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u044b, \u0441\u043a\u0430\u0440\u0431 \u0441\u043f\u0430\u043a\u043e\u044e, \u0441\u043b\u043e\u0434\u044b\u0447 \u043b\u0430\u0441\u043a\u0456. \u041f\u0430\u0448\u044b\u0440 \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u0432\u044b\u0431\u044f\u0436\u044b \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0432\u0435\u0447\u043d\u0430\u043c\u0443 \u0441\u0432\u044f\u0442\u043b\u0443, &laquo;\u044f\u043a\u043e\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430&raquo; (\u042f\u043d 1, 9). \u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0437\u0437\u044f\u0435 \u045e\u0441\u0456\u043c. \u041a\u0430\u043b\u0456, \u0430\u0434\u043d\u0430\u043a, \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u0441\u0432\u0430\u0451 \u0430\u043a\u043d\u043e, \u0441\u0430\u043c \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u044f\u0435 \u0441\u044f\u0431\u0435 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430. \u041a\u0430\u043b\u0456 \u0442\u044b \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435\u0448 \u0434\u0437\u0432\u0435\u0440\u044b \u0442\u0432\u0430\u0439\u0433\u043e \u0440\u043e\u0437\u0443\u043c\u0443, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0432\u043e\u043d\u043a\u0456. \u0428\u0442\u043e \u043f\u0440\u0430\u045e\u0434\u0430, \u0401\u043d \u0437\u043c\u043e\u0433 \u0431\u044b \u045e\u0432\u0430\u0439\u0441\u0446\u0456, \u0430\u043b\u0435 \u043d\u0435 \u0445\u043e\u0447\u0430 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0431\u0435\u0437 \u0437\u0430\u043f\u0440\u0430\u0448\u044d\u043d\u043d\u044f, \u043d\u0435 \u0445\u043e\u0447\u0430 \u0437\u043c\u0443\u0448\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u0445\u043e\u0447\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0437 \u0414\u0437\u0435\u0432\u044b, \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u042f\u0435 \u045e\u043b\u043e\u043d\u043d\u044f, \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u044e\u0447\u044b \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0447\u044b \u045e\u0441\u0456\u0445. \u042f\u0433\u043e \u043f\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0443\u0441\u0435, \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435 \u0431\u043b\u044f\u0441\u043a\u0443 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u044f\u043a\u043e\u0435 \u043d\u0435 \u0437\u0433\u0430\u0441\u0456\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u044f \u043c\u043e\u0446. \u0421\u043e\u043d\u0446\u0430, \u043d\u0430 \u044f\u043a\u043e\u0435 \u043c\u044b \u0448\u0442\u043e\u0434\u043d\u044f \u0433\u043b\u044f\u0434\u0437\u0456\u043c, \u0430\u0434\u0441\u0442\u0443\u043f\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u0437\u043c\u0440\u043e\u043a\u0430\u043c \u043d\u043e\u0447\u044b, \u0430\u043b\u0435 \u0441\u043e\u043d\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0437\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0431\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0441\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0437\u043b\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439, \u0443 \u0447\u044b\u0435 \u0434\u0437\u0432\u0435\u0440\u044b \u0441\u0442\u0443\u043a\u0430\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0410 \u043d\u0430\u0448\u044b\u043c\u0456 \u0434\u0437\u0432\u044f\u0440\u0430\u043c\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u0435\u0440\u0430. \u0406 \u043a\u0430\u043b\u0456 \u044f\u043d\u0430 \u043c\u043e\u0446\u043d\u0430\u044f, \u0442\u043e \u0442\u0440\u044b\u043c\u0430\u0435 \u045e \u0431\u044f\u0441\u043f\u0435\u0446\u044b \u045e\u0432\u0435\u0441\u044c \u0434\u043e\u043c. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043f\u0440\u0430\u0437 \u0442\u0430\u043a\u0456\u044f \u0434\u0437\u0432\u0435\u0440\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0422\u0430\u043c\u0443 \u045e \u043a\u043d\u0456\u0437\u0435 \u041f\u0435\u0441\u043d\u0456 \u043f\u0435\u0441\u043d\u044f\u045e \u041a\u0430\u0441\u0446\u0451\u043b \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435: &laquo;\u0421\u043b\u0443\u0445\u0430\u0439, \u043c\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u0441\u0442\u0443\u043a\u0430\u0435 \u045e \u0434\u0437\u0432\u0435\u0440\u044b&raquo; (\u041f\u043f 5, 2). \u0422\u0430\u043c\u0443 \u043f\u0430\u0447\u0443\u0439 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0442\u0443\u043a\u0430\u0435\u0446\u0446\u0430, \u043f\u0430\u0447\u0443\u0439 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456: &laquo;\u0410\u0434\u0447\u044b\u043d\u0456 \u043c\u043d\u0435, \u0441\u044f\u0441\u0442\u0440\u0430 \u043c\u0430\u044f, \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430, \u043c\u0430\u044f \u0433\u0430\u043b\u0443\u0431\u043a\u0430, \u0442\u044b \u043c\u0430\u044f \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u044f, \u0431\u043e \u0440\u0430\u0441\u0430 \u043f\u0430\u043a\u0440\u044b\u043b\u0430 \u043c\u0430\u044e \u0433\u0430\u043b\u0430\u0432\u0443, \u0430 \u043f\u0430\u0441\u043c\u044b \u0432\u0430\u043b\u0430\u0441\u043e\u045e \u0441\u0442\u0430\u043b\u0456 \u0432\u0456\u043b\u044c\u0433\u043e\u0442\u043d\u044b\u043c\u0456 \u0430\u0434 \u043a\u0440\u043e\u043f\u043b\u044f\u045e \u043d\u043e\u0447\u044b&raquo; (\u041f\u043f 5, 2).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0443\u043c\u0430\u0439, \u0448\u0442\u043e \u0411\u043e\u0433-\u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0443\u043a\u0430\u0435\u0446\u0446\u0430 \u045e \u0442\u0432\u0430\u0435 \u0434\u0437\u0432\u0435\u0440\u044b \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u042f\u0433\u043e \u0433\u0430\u043b\u0430\u0432\u0430 \u043f\u0430\u043a\u0440\u044b\u0442\u0430\u044f \u043d\u0430\u0447\u043d\u043e\u0439 \u0440\u0430\u0441\u043e\u0439. \u0423 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0401\u043d \u043f\u0440\u0430\u0433\u043d\u0435 \u043d\u0430\u0432\u0435\u0434\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043c\u0430\u0435 \u0441\u043f\u0430\u043a\u0443\u0441\u044b \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u043a\u0430\u0431 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u045e \u0430\u0431\u0430\u0440\u0430\u043d\u0456\u0446\u044c \u0456\u0445 \u0430\u0434 \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u042f\u0433\u043e \u0413\u0430\u043b\u0430\u0432\u0430 \u043f\u0430\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0440\u0430\u0441\u043e\u0439 \u0456 \u043a\u0440\u043e\u043f\u043b\u044f\u043c\u0456, \u043a\u0430\u043b\u0456 \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u042f\u0433\u043e \u0446\u0435\u043b\u0430. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u0434\u044b \u0442\u0440\u044d\u0431\u0430 \u0447\u0443\u0432\u0430\u0446\u044c, \u043a\u0430\u0431 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u043d\u0435 \u0430\u0434\u044b\u0448\u043e\u045e \u043d\u0435\u0437\u0430\u043f\u0440\u043e\u0448\u0430\u043d\u044b\u043c. \u041a\u0430\u043b\u0456 \u0436 \u0442\u044b \u0441\u043f\u0456\u0448, \u0456 \u0441\u044d\u0440\u0446\u0430 \u0442\u0432\u0430\u0451 \u043d\u0435 \u0447\u0443\u0432\u0430\u0435, \u0401\u043d \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u043d\u0430\u0432\u0430\u0442 \u043d\u0435 \u043f\u0430\u0441\u0442\u0443\u043a\u0430\u045e\u0448\u044b. \u041a\u0430\u043b\u0456 \u0436 \u0442\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0447\u0443\u0432\u0430\u0435, \u0442\u0430\u0434\u044b \u0401\u043d \u0441\u0442\u0443\u043a\u0430\u0435\u0446\u0446\u0430 \u0456 \u043f\u0440\u043e\u0441\u0456\u0446\u044c, \u043a\u0430\u0431 \u0442\u044b \u044f\u043c\u0443 \u0430\u0434\u0447\u044b\u043d\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0456\u0441\u043d\u0443\u044e\u0446\u044c \u0434\u0437\u0432\u0435\u0440\u044b \u0434\u0443\u0448\u044b, \u0456\u0441\u043d\u0443\u044e\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0440\u0430\u043c\u044b, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u041f\u0430\u0434\u044b\u043c\u0456\u0446\u0435 \u0432\u044f\u0440\u0445\u0456 \u0432\u0430\u0448\u044b\u044f, \u0431\u0440\u0430\u043c\u044b, \u0443\u0437\u043d\u0456\u043c\u0456\u0446\u0435\u0441\u044f, \u0430\u0434\u0432\u0435\u0447\u043d\u044b\u044f \u0432\u0430\u0440\u043e\u0442\u044b, \u043a\u0430\u0431 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u043b\u0430\u0432\u044b&raquo; (\u041f\u0441 24 [23], 7). \u041a\u0430\u043b\u0456 \u0437\u0430\u0445\u043e\u0447\u0430\u0448 \u043f\u0430\u0434\u043d\u044f\u0446\u044c \u0432\u044f\u0440\u0445\u0456 \u0431\u0440\u0430\u043c\u044b \u0442\u0432\u0430\u0451\u0439 \u0432\u0435\u0440\u044b, \u0434\u0430 \u0446\u044f\u0431\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u043b\u0430\u0432\u044b \u045e \u0442\u0440\u044b\u0443\u043c\u0444\u0435 \u0441\u0432\u0430\u0451\u0439 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456, \u044f\u043a\u0443\u044e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043f\u0430\u0434\u0447\u0430\u0441 \u041c\u0443\u043a\u0456. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043c\u0430\u0435 \u0441\u0432\u0430\u0435 \u0431\u0440\u0430\u043c\u044b. \u041c\u044b \u0447\u044b\u0442\u0430\u0435\u043c \u043f\u0440\u0430 \u0456\u0445 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0440\u043e\u043a\u0430: &laquo;\u0410\u0434\u0447\u044b\u043d\u0456\u0446\u0435 \u043c\u043d\u0435 \u0431\u0440\u0430\u043c\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456&raquo; (\u041f\u0441 118 [117], 19). \u0422\u0430\u043c\u0443 \u0434\u0443\u0448\u0430 \u043c\u0430\u0435 \u0441\u0432\u0430\u0435 \u0434\u0437\u0432\u0435\u0440\u044b, \u043c\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0432\u0430\u044e \u0431\u0440\u0430\u043c\u0443. \u041f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u0441\u0442\u0443\u043a\u0430\u0435 \u045e \u044f\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0441\u0442\u0443\u043a\u0430\u0435 \u045e \u0434\u0437\u0432\u0435\u0440\u044b. \u0410\u0434\u0447\u044b\u043d\u0456 \u042f\u043c\u0443; \u0401\u043d \u0445\u043e\u0447\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456, \u0445\u043e\u0447\u0430 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0443 \u045e \u0447\u0443\u0432\u0430\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 3, 20; \u041c\u0446 24, 46<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0441\u0442\u0430\u044e \u043a\u0430\u043b\u044f \u0434\u0437\u0432\u044f\u0440\u044d\u0439 \u0456 \u0441\u0442\u0443\u043a\u0430\u044e. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043f\u0430\u0447\u0443\u0435 \u041c\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u0456 \u0430\u0434\u0447\u044b\u043d\u0456\u0446\u044c \u0434\u0437\u0432\u0435\u0440\u044b, <span style=\"color: #ff0000;\">*<\/span> \u0443\u0432\u0430\u0439\u0434\u0443 \u0434\u0430 \u044f\u0433\u043e \u0456 \u0431\u0443\u0434\u0443 \u0432\u044f\u0447\u044d\u0440\u0430\u0446\u044c \u0437 \u0456\u043c, \u0430 \u0451\u043d \u0441\u0430 \u041c\u043d\u043e\u044e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439 \u0441\u043b\u0443\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u044f\u0433\u043e\u043d\u044b, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u0437\u0430\u0441\u0442\u0430\u043d\u0435 \u045e \u0447\u0443\u0432\u0430\u043d\u043d\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0432\u0430\u0439\u0434\u0443 \u0434\u0430 \u044f\u0433\u043e \u0456 \u0431\u0443\u0434\u0443 \u0432\u044f\u0447\u044d\u0440\u0430\u0446\u044c \u0437 \u0456\u043c, \u0430 \u0451\u043d \u0441\u0430 \u041c\u043d\u043e\u044e.<\/p>\r\n"}, {"GCH_CH_2_ID":"146","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041b\u0456\u0441\u0442 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&raquo; \u0441\u0432. \u041a\u043b\u0456\u043c\u044d\u043d\u0442\u0430 \u0406, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 50, 1 &minus; 51, 3; 54, 1-4: Funk 1, 125-127. 129)<\/span><br \/><span style=\"color: #ff0000;\">\u041c\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u043a\u0430\u043b\u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u041f\u0430\u043d\u0430 \u045e \u0437\u0433\u043e\u0434\u0437\u0435 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0430\u0447\u044b\u0446\u0435, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u044f\u043a\u043e\u0439 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0439 \u0456 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0439 \u0446\u043d\u043e\u0442\u0430\u0439 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a \u0436\u0430 \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u0441\u043b\u043e\u0432\u0430\u045e, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u044f\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c. \u0425\u0442\u043e \u0436 \u043c\u043e\u0436\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u044f\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u0411\u043e\u0433 \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u0433\u043e\u0434\u043d\u044b\u043c \u0433\u044d\u0442\u0430\u0433\u0430? \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0456 \u045e\u043f\u0440\u043e\u0448\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u043c\u044b \u0442\u0440\u044b\u0432\u0430\u043b\u0456 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0431\u0443\u0434\u0443\u0447\u044b \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c\u0456 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456. \u0423\u0441\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456, \u043f\u0430\u0447\u0430\u045e\u0448\u044b \u0430\u0434 \u0410\u0434\u0430\u043c\u0430 \u0430\u0436 \u0434\u0430 \u0441\u0451\u043d\u043d\u044f, \u043f\u0440\u0430\u043c\u0456\u043d\u0443\u043b\u0456; \u0442\u044b\u044f, \u0445\u0442\u043e \u0437 \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0442\u0440\u044b\u0432\u0430\u044e\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b\u0445, \u0456 \u0430\u0431&rsquo;\u044f\u0432\u044f\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0411\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0423\u0432\u0430\u0439\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0443\u044e \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u045e \u0432\u0430\u0448\u044b\u044f \u043f\u0430\u043a\u043e\u0456, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u0430\u043c\u0456\u043d\u0435 \u043c\u043e\u0439 \u0433\u043d\u0435\u045e \u0456 \u0430\u0431\u0443\u0440\u044d\u043d\u043d\u0435. \u0423 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u044f \u045e\u0441\u043f\u043e\u043c\u043d\u044e \u0456 \u0432\u044b\u0432\u044f\u0434\u0443 \u0432\u0430\u0441 \u0437 \u0432\u0430\u0448\u044b\u0445 \u043c\u0430\u0433\u0456\u043b\u0430\u045e&raquo; (\u043f\u0430\u0440. \u0406\u0441 26, 20; \u042d\u0437\u0445 37, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043c\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u043a\u0430\u043b\u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u043c \u0411\u043e\u0436\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u045e \u0437\u0433\u043e\u0434\u0437\u0435 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e \u043d\u0430\u043c \u0431\u044b\u043b\u0456 \u0430\u0434\u043f\u0443\u0448\u0447\u0430\u043d\u044b \u0433\u0440\u0430\u0445\u0456. \u0411\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439, \u043a\u0430\u043c\u0443 \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0456 \u0447\u044b\u0439 \u0433\u0440\u044d\u0445 \u0437\u0430\u0431\u044b\u0442\u044b. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u043e\u043c\u0443 \u041f\u0430\u043d \u043d\u0435 \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u0432\u0456\u043d\u044b, \u0456 \u045e \u0434\u0443\u0448\u044b \u044f\u043a\u043e\u0433\u0430 \u043d\u044f\u043c\u0430 \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u0443&raquo; (\u041f\u0441 32 [31], 1-2). \u0413\u044d\u0442\u0430\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0432\u044b\u0431\u0440\u0430\u045e \u0411\u043e\u0433 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430. \u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0430\u0431 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430, \u044f\u043a\u043e\u0435 \u043c\u044b \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0456, \u043f\u0430\u0434\u0434\u0430\u044e\u0447\u044b\u0441\u044f \u045e\u043f\u043b\u044b\u0432\u0430\u043c \u0441\u043b\u0443\u0433\u0430\u045e \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a\u0430. \u0410 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u044b \u043d\u044f\u0437\u0433\u043e\u0434\u044b \u0456 \u0431\u0443\u043d\u0442\u0443 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0430\u0434\u0443\u043c\u0430\u0446\u0446\u0430 \u043d\u0430\u0434 \u043d\u0430\u0448\u0430\u0439 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u044f\u0439. \u0422\u044b\u044f \u0436, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0431\u043e\u044f\u0437\u0456 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u0431\u043e\u043b\u044c\u0448 \u0436\u0430\u0434\u0430\u044e\u0446\u044c \u0441\u0430\u043c\u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c, \u0447\u044b\u043c \u043a\u0430\u0431 \u0446\u044f\u0440\u043f\u0435\u043b\u0456 \u0456\u043d\u0448\u044b\u044f; \u0441\u0430\u043c\u0456 \u0436\u0430\u0434\u0430\u044e\u0446\u044c \u043f\u0430\u043d\u0435\u0441\u0446\u0456 \u0448\u043a\u043e\u0434\u0443, \u0447\u044b\u043c \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c, \u043a\u0430\u0431 \u0441\u0432\u044f\u0442\u0430 \u0456 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430 \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u044f \u043d\u0430\u043c \u0437\u0433\u043e\u0434\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u044f\u043a\u0443\u044e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0441\u0442\u0440\u0430\u0442\u0443. \u041b\u0435\u043f\u0448 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u043f\u0440\u044b\u0437\u043d\u0430\u0446\u044c \u0441\u0432\u0430\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u044b, \u0447\u044b\u043c \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0446\u0432\u0451\u0440\u0434\u044b\u043c \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0437 \u0432\u0430\u0441 \u0448\u043b\u044f\u0445\u0435\u0442\u043d\u044b, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0456 \u043f\u043e\u045e\u043d\u044b \u043b\u044e\u0431\u043e\u0432\u0456? \u041d\u044f\u0445\u0430\u0439 \u0441\u043a\u0430\u0436\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u0437-\u0437\u0430 \u043c\u044f\u043d\u0435 \u045e\u0437\u043d\u0456\u043a\u0430\u044e\u0446\u044c \u0441\u043f\u0440\u044d\u0447\u043a\u0430, \u043d\u044f\u0437\u0433\u043e\u0434\u0430 \u0456 \u043f\u0430\u0434\u0437\u0435\u043b, \u0441\u0430\u0441\u0442\u0443\u043f\u043b\u044e. \u0410\u0434\u044b\u0434\u0443, \u043a\u0443\u0434\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u043f\u0430\u0436\u0430\u0434\u0430\u0435\u0446\u0435; \u0437\u0440\u0430\u0431\u043b\u044e \u045e\u0441\u0451, \u0448\u0442\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u0435 \u0441\u0445\u043e\u0434. \u041d\u044f\u0445\u0430\u0439 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u045e\u0447\u0430\u0440\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u0436\u044b\u0432\u0435 \u045e \u0441\u043f\u0430\u043a\u043e\u0456 \u0437 \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u043c\u0456 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u043c\u0456&raquo;. \u0425\u0442\u043e \u0442\u0430\u043a \u0437\u0440\u043e\u0431\u0456\u0446\u044c, \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0445\u0432\u0430\u043b\u0443 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0456 \u045e\u0441\u044e\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u043d\u044f\u0442\u044b. &laquo;\u041f\u0430\u043d\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0437\u044f\u043c\u043b\u044f \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0430 \u0451\u0439&raquo; (\u041f\u0441 24 [23], 1). \u0422\u0430\u043a \u043f\u0430\u0432\u043e\u0434\u0437\u044f\u0446\u044c \u0441\u044f\u0431\u0435 \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u0411\u043e\u0436\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c. \u0410\u0431 \u0442\u0430\u043a\u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u0445 \u044f\u043d\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0448\u043a\u0430\u0434\u0430\u0432\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 4, 21; \u041c\u0446 22, 40<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b \u043c\u0430\u0435\u043c \u0430\u0434 \u0411\u043e\u0433\u0430 \u0442\u0430\u043a\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c,<span style=\"color: #ff0000;\"> *<\/span> \u043a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u043b\u044e\u0431\u0456\u045e \u0456 \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430 \u0433\u044d\u0442\u044b\u0445 \u0434\u0437\u0432\u044e\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u0445 \u0433\u0440\u0443\u043d\u0442\u0443\u0435\u0446\u0446\u0430 \u045e\u0432\u0435\u0441\u044c \u0417\u0430\u043a\u043e\u043d \u0456 \u041f\u0440\u0430\u0440\u043e\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u043b\u044e\u0431\u0456\u045e \u0456 \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"147","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 126, 2: CCL 40, 1857-1858)<\/span><br \/><span style=\"color: #ff0000;\">C\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0448 \u041f\u0430\u043d, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043b\u0430\u043c\u043e\u043d \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0411\u043e\u0433\u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u044f\u043a\u0430\u044f \u0431\u044b\u043b\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435\u043c \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0446\u0435\u043b\u0430 \u041f\u0430\u043d\u0430. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043a\u0430\u0436\u0430 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456: &laquo;\u0417\u0440\u0443\u0439\u043d\u0443\u0439\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0433\u044d\u0442\u0443\u044e, \u0456 \u042f \u0437\u0430 \u0442\u0440\u044b \u0434\u043d\u0456 \u045e\u0437\u0432\u044f\u0434\u0443 \u044f\u0435&raquo; (\u042f\u043d 2, 19). \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0442\u043e\u0439 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0442\u0430\u043a \u0456 \u041f\u0430\u043d \u043d\u0430\u0448 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u0421\u0430\u043b\u0430\u043c\u043e\u043d, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u043c\u0443\u0436 \u0441\u043f\u0430\u043a\u043e\u044e, \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0441\u0432\u044f\u0442\u044b\u043d\u044e. \u0406\u043c\u044f \u0436 \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 &laquo;\u043c\u0443\u0436 \u0441\u043f\u0430\u043a\u043e\u044e&raquo;. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0436\u0430 \u043c\u0443\u0436\u0430\u043c \u0441\u043f\u0430\u043a\u043e\u044e \u0451\u0441\u0446\u044c \u0442\u043e\u0439, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: &laquo;\u0401\u043d &ndash; \u0441\u043f\u0430\u043a\u043e\u0439 \u043d\u0430\u0448, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0430\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435 \u0430\u0434\u0437\u0456\u043d\u044b\u043c&raquo; (\u042d\u0444 2, 14). \u0422\u0430\u043a, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u043c\u0443\u0436\u0430\u043c \u0441\u043f\u0430\u043a\u043e\u044e, \u0431\u043e \u045e \u0441\u0430\u0431\u0435 \u0441\u0430\u043c\u0456\u043c \u0437&rsquo;\u044f\u0434\u043d\u0430\u045e \u0434\u0432\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u043b\u0435\u0433\u043b\u044b\u044f \u043c\u0443\u0440\u044b, \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0447\u044b\u0441\u044f \u0432\u0443\u0433\u043b\u0430\u0432\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u0435\u043c \u0434\u043b\u044f \u0430\u0431\u043e\u0434\u0432\u0443\u0445. \u0401\u043d \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043c\u0443\u0436 \u0441\u043f\u0430\u043a\u043e\u044e, \u0431\u043e \u0441\u0442\u0430\u045e \u0432\u0443\u0433\u043b\u0430\u0432\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u0435\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u043a\u0456 \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0437 \u0434\u0432\u0443\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e: \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u0437 \u044e\u0434\u044d\u044f\u045e \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u0445 \u0437 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430\u043c, \u043c\u0443\u0436\u0430\u043c \u0441\u043f\u0430\u043a\u043e\u044e, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0410\u043b\u0435 \u0441\u044b\u043d \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u0411\u044d\u044d\u0440 \u0428\u044d\u0431\u044b, \u0421\u0430\u043b\u0430\u043c\u043e\u043d, \u043a\u0430\u0440\u043e\u043b\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456 \u0431\u0443\u0434\u0443\u0435 \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0431\u044b\u045e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435\u043c \u043c\u0443\u0436\u0430 \u0441\u043f\u0430\u043a\u043e\u044e. \u0410 \u043a\u0430\u0431 \u0442\u044b \u043d\u0435 \u0434\u0443\u043c\u0430\u045e, \u0448\u0442\u043e \u0421\u0430\u043b\u0430\u043c\u043e\u043d \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0434\u043e\u043c \u0434\u043b\u044f \u0411\u043e\u0433\u0430, \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u045e\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u043d\u0435 \u0431\u0443\u0434\u0443\u0435 \u0434\u043e\u043c, \u0442\u043e \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a\u0456 \u043f\u0440\u0430\u0446\u0443\u044e\u0446\u044c \u0434\u0430\u0440\u044d\u043c\u043d\u0430&raquo; (\u041f\u0441 127 [126], 1). \u0410 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0434\u043e\u043c \u0431\u0443\u0434\u0443\u0435 \u041f\u0430\u043d; \u043d\u0430\u0448 \u041f\u0430\u043d, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0431\u0443\u0434\u0443\u0435 \u0441\u0432\u043e\u0439 \u0434\u043e\u043c. \u041c\u043d\u043e\u0433\u0456\u044f \u043f\u0440\u0430\u0446\u0443\u044e\u0446\u044c \u043d\u0430 \u0431\u0443\u0434\u043e\u045e\u043b\u0456, \u0430\u043b\u0435, \u043a\u0430\u043b\u0456 \u0401\u043d \u043d\u0435 \u043f\u0430\u0431\u0443\u0434\u0443\u0435, &laquo;\u0442\u043e \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a\u0456 \u043f\u0440\u0430\u0446\u0443\u044e\u0446\u044c \u0434\u0430\u0440\u044d\u043c\u043d\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0436 \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u0443\u0434\u0443\u0435? \u0413\u044d\u0442\u0430 \u045e\u0441\u0435, \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u0445\u0442\u043e \u0446\u044d\u043b\u0435\u0431\u0440\u0443\u0435 \u0411\u043e\u0436\u044b\u044f \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u044b. \u0422\u0430\u043a, \u0443\u0441\u0435 \u043c\u044b \u0440\u0443\u043f\u0456\u043c\u0441\u044f, \u0443\u0441\u0435 \u043f\u0440\u0430\u0446\u0443\u0435\u043c, \u0443\u0441\u0435 \u0431\u0443\u0434\u0443\u0435\u043c; \u0434\u0430 \u043d\u0430\u0441 \u0456\u043d\u0448\u044b\u044f \u0440\u0443\u043f\u0456\u043b\u0456\u0441\u044f, \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043b\u0456, \u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456. \u0410\u043b\u0435 &laquo;\u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u043d\u0435 \u0431\u0443\u0434\u0443\u0435 \u0434\u043e\u043c, \u0442\u043e \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a\u0456 \u043f\u0440\u0430\u0446\u0443\u044e\u0446\u044c \u0434\u0430\u0440\u044d\u043c\u043d\u0430&raquo;. \u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b, \u0456 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u041f\u0430\u0432\u0435\u043b, \u0431\u0430\u0447\u0430\u0447\u044b, \u0448\u0442\u043e \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c \u043d\u0435\u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430, \u043a\u0430\u0436\u0430: &laquo;\u0412\u044b \u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043d\u0430 \u0434\u043d\u0456, \u043c\u0435\u0441\u044f\u0446\u044b, \u0447\u0430\u0441\u044b \u0456 \u0433\u0430\u0434\u044b! \u0411\u0430\u044e\u0441\u044f, \u0446\u0456 \u043d\u0435 \u0434\u0430\u0440\u043c\u0430 \u044f \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u0432\u0430\u0441?&raquo; (\u0413\u0430\u043b 4, 10-11). \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u0441\u0430\u043c \u0431\u0443\u0434\u0443\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0430\u043c \u0437\u043d\u0443\u0442\u0440\u044b, \u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u0442\u044b\u0445, \u0434\u0437\u0435\u043b\u044f \u043a\u0430\u0433\u043e \u0434\u0430\u0440\u044d\u043c\u043d\u0430 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e. \u0422\u0430\u043c\u0443 \u043c\u044b \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435\u043c \u0437\u043d\u0435\u0448\u043d\u0435, \u0401\u043d \u0431\u0443\u0434\u0443\u0435 \u045e\u043d\u0443\u0442\u0440\u044b. \u042f\u043a \u0441\u043b\u0443\u0445\u0430\u0435\u0446\u0435, \u0431\u0430\u0447\u044b\u043c, \u0430\u043b\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0443\u043c\u0430\u0435\u0446\u0435, \u0432\u0435\u0434\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c \u0432\u0430\u0448\u044b\u044f \u0434\u0443\u043c\u043a\u0456. \u0401\u043d \u0431\u0443\u0434\u0443\u0435, \u0401\u043d \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u0435, \u0401\u043d \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u0431\u043e\u044f\u0437\u044c, \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0440\u043e\u0437\u0443\u043c \u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0432\u0435\u0440\u044b \u0432\u0430\u0448\u0443\u044e \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c. \u0410\u0434\u043d\u0430\u043a \u0456 \u043c\u044b \u043f\u0440\u0430\u0446\u0443\u0435\u043c; \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u0412\u0430\u043b 8, 15; \u042f\u043d 2, 19<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0430 \u0445\u0432\u0430\u043b\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u044f\u0435; \u0443\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u043a\u0430\u0440\u043e\u043b\u044c \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: <span style=\"color: #ff0000;\">*<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u041f\u0430\u043d, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0437\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u0430\u0439\u0446\u0443 \u043c\u0430\u0439\u043c\u0443, \u0414\u0430\u0432\u0456\u0434\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u0440\u0443\u0439\u043d\u0443\u0439\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0433\u044d\u0442\u0443\u044e, \u0456 \u042f \u0437\u0430 \u0442\u0440\u044b \u0434\u043d\u0456 \u045e\u0437\u0432\u044f\u0434\u0443 \u044f\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u041f\u0430\u043d, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0437\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u0430\u0439\u0446\u0443 \u043c\u0430\u0439\u043c\u0443, \u0414\u0430\u0432\u0456\u0434\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"151","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 1-7: SCh 25 bis, 156-158)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0440\u044b\u043d\u0456\u0446\u0430 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0447\u044b\u0442\u0430\u043b\u0430\u0441\u044f \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u044f \u041f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0430\u045e \u0446\u0456 \u043f\u0430\u0440\u0430\u0434\u044b \u043a\u043d\u0456\u0433\u0456 \u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e, \u044f \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u043d\u0430 \u044d\u0442\u044b\u0447\u043d\u044b\u044f \u0442\u044d\u043c\u044b. \u0425\u0430\u0446\u0435\u045e, \u043a\u0430\u0431 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b\u044f \u0456 \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u043d\u044b\u044f, \u0432\u044b \u043f\u0440\u044b\u0437\u0432\u044b\u0447\u0430\u0456\u043b\u0456\u0441\u044f \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u043e\u0434\u043a\u0430\u045e \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0411\u043e\u0436\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u043a\u0430\u0431, \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u044f \u043f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442, \u0442\u0440\u044b\u043c\u0430\u043b\u0456\u0441\u044f \u0442\u0430\u0433\u043e \u043b\u0430\u0434\u0443 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u0456 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b\u043c. \u0410\u0434\u043d\u0430\u043a \u0446\u044f\u043f\u0435\u0440 \u043d\u0430\u0441\u0442\u0430\u045e \u0447\u0430\u0441 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0432\u0430\u043c \u043f\u0440\u0430 \u0441\u0432\u044f\u0442\u044b\u044f \u0430\u0431\u0440\u0430\u0434\u044b \u0456 \u0440\u0430\u0441\u043a\u0440\u044b\u0446\u044c \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u045e. \u041a\u0430\u043b\u0456 \u0431 \u043c\u044b \u0441\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043b\u0456 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u0440\u0430\u043d\u0435\u0439, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u0432\u044b \u0431\u044b\u043b\u0456 \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u044f, &ndash; \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0431 \u0431\u043e\u043b\u044c\u0448 \u0437\u0434\u0440\u0430\u0434\u0430\u0439, \u0447\u044b\u043c \u0442\u043b\u0443\u043c\u0430\u0447\u044d\u043d\u043d\u0435\u043c. \u0410\u0434\u043d\u0430\u043a \u0436\u0430 \u0441\u0432\u044f\u0442\u043b\u043e \u0442\u0430\u044f\u043c\u043d\u0456\u0446 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e \u043d\u0435\u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u0445, \u0447\u044b\u043c \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u044f\u043d\u043e \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0430\u043d\u0430 \u045e\u0441\u0442\u0443\u043f\u043d\u044b\u043c \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0430\u0434\u043a\u0440\u044b\u0439\u0446\u0435 \u0441\u0432\u0430\u0435 \u0432\u0443\u0448\u044b \u0456 \u0430\u0434\u0447\u0443\u0439\u0446\u0435 \u0430\u0441\u0430\u043b\u043e\u0434\u0443 \u0430\u0434 \u0432\u043e\u0434\u0430\u0440\u0443 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u0432\u0430\u043c \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u045e. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u043c\u044b \u043c\u0435\u043b\u0456 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u043f\u0430\u0434\u0447\u0430\u0441 \u0443\u0441\u0442\u0443\u043f\u043d\u0430\u0433\u0430 \u0430\u0431\u0440\u0430\u0434\u0443 \u0430\u0434\u043a\u0440\u044b\u0446\u0446\u044f. \u041c\u044b \u043a\u0430\u0437\u0430\u043b\u0456 \u0442\u0430\u0434\u044b: &laquo;\u042d\u0444\u0444\u0430\u0442\u0430&raquo;, \u0448\u0442\u043e \u0437\u043d\u0430\u0447\u044b\u0446\u044c: &laquo;\u0410\u0434\u043a\u0440\u044b\u0439\u0441\u044f&raquo; (\u041c\u043a 7, 34). \u041c\u044b \u0442\u0430\u043a \u043a\u0430\u0437\u0430\u043b\u0456, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u043b\u0430\u0441\u043a\u0456, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u043f\u0440\u0430 \u0448\u0442\u043e \u045e \u044f\u0433\u043e \u043f\u044b\u0442\u0430\u044e\u0446\u0446\u0430, \u0456 \u043f\u0430\u043c\u044f\u0442\u0430\u045e, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u0446\u044c. \u0423 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456 \u043c\u044b \u0447\u044b\u0442\u0430\u0435\u043c, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0433\u044d\u0442\u044b \u0430\u0431\u0440\u0430\u0434, \u043a\u0430\u043b\u0456 \u0432\u044b\u043b\u0435\u0447\u044b\u045e \u043d\u044f\u043c\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0441\u0432\u0430\u044e \u0447\u0430\u0440\u0433\u0443, \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e \u0430\u0434\u043a\u0440\u044b\u043b\u0430\u0441\u044f \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0435 \u041c\u0435\u0441\u0446\u0430, \u0456 \u0442\u044b \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f. \u041f\u0440\u044b\u0433\u0430\u0434\u0430\u0439, \u0448\u0442\u043e \u045e \u0446\u044f\u0431\u0435 \u043f\u044b\u0442\u0430\u043b\u0456\u0441\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u0442\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u045e. \u0422\u044b \u0432\u044b\u0440\u0430\u043a\u0441\u044f \u0441\u0430\u0442\u0430\u043d\u044b, \u044f\u0433\u043e \u0441\u043f\u0440\u0430\u045e, \u0441\u0432\u0435\u0442\u0443, \u044f\u0433\u043e \u0431\u0430\u0433\u0430\u0446\u0446\u044f \u0456 \u0440\u0430\u0441\u043a\u043e\u0448\u0430\u045e. \u0422\u0432\u043e\u0439 \u0430\u0434\u043a\u0430\u0437 \u0431\u044b\u045e \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u043a\u0440\u044b\u0442\u044b \u043d\u0435 \u045e \u0433\u0440\u043e\u0431\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0430\u043b\u0435 \u045e \u041a\u043d\u0456\u0437\u0435 \u0436\u044b\u0432\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u045e\u0431\u0430\u0447\u044b\u045e \u0442\u0430\u043c \u0434\u044b\u044f\u043a\u0430\u043d\u0430, \u0443\u0431\u0430\u0447\u044b\u045e \u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u0443\u0431\u0430\u0447\u044b\u045e \u0431\u0456\u0441\u043a\u0443\u043f\u0430. \u041d\u0435 \u0437\u0432\u0430\u0436\u0430\u0439 \u043d\u0430 \u0456\u0445 \u0432\u044b\u0433\u043b\u044f\u0434, \u0430\u043b\u0435 \u043d\u0430 \u0445\u0430\u0440\u044b\u0437\u043c\u0443 \u0456\u0445 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f. \u0422\u044b \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0443 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0412\u0443\u0441\u043d\u044b \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0432\u0435\u0434\u044b, \u0443 \u044f\u0433\u043e \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u045e, \u0431\u043e \u0451\u043d \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u043d\u0451\u043b\u0430\u043c \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430&raquo; (\u043f\u0430\u0440. \u041c\u0430\u043b 2, 7). \u0422\u0443\u0442 \u043d\u0435\u043b\u044c\u0433\u0430 \u043d\u0456 \u043f\u0430\u043c\u044b\u043b\u0456\u0446\u0446\u0430, \u043d\u0456 \u0437\u0430\u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c: \u0430\u043d\u0451\u043b &ndash; \u0433\u044d\u0442\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u041d\u0435 \u0430\u0446\u044d\u043d\u044c\u0432\u0430\u0439 \u044f\u0433\u043e \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443, \u0430\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u0434\u0430\u043d\u043d\u044f. \u0420\u0430\u0437\u0432\u0430\u0436\u0430\u0439 \u043d\u0430\u0434 \u0442\u044b\u043c, \u0448\u0442\u043e \u0451\u043d \u0442\u0430\u0431\u0435 \u043f\u0435\u0440\u0430\u043a\u0430\u0437\u0430\u045e, \u0443\u0448\u0430\u043d\u0443\u0439 \u044f\u0433\u043e \u043f\u0430\u0441\u043b\u0443\u0433\u0443, \u043f\u0440\u044b\u0437\u043d\u0430\u0439 \u044f\u0433\u043e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u0432\u044b\u0439\u0448\u0430\u045e\u0448\u044b \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044e \u0456 \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0446\u0446\u0430, \u0442\u044b \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u043d\u0430 \u0423\u0441\u0445\u043e\u0434, \u0431\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u0440\u0430\u043a\u0430\u0435\u0446\u0446\u0430 \u0441\u0430\u0442\u0430\u043d\u044b, \u043f\u0430\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u045e\u0433\u043b\u044f\u0434\u0430\u0435\u0446\u0446\u0430 \u045e \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0426\u0456\u0442 3, 3. 5b; \u042d\u0444 2, 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043c\u044b \u0431\u044b\u043b\u0456 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f, \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u044f, \u0437\u0432\u0435\u0434\u0437\u0435\u043d\u044b\u044f, \u0436\u044b\u043b\u0456 \u045e \u0437\u043b\u043e\u0441\u0446\u0456 \u0456 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456, \u0431\u044b\u043b\u0456 \u043d\u0435\u043d\u0430\u0432\u0456\u0441\u043d\u044b\u044f \u0456 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e. <span style=\"color: #ff0000;\">*<\/span> \u0410\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439 \u0437\u0431\u0430\u0432\u0456\u045e \u043d\u0430\u0441 \u0411\u043e\u0433 \u043f\u0440\u0430\u0437 \u043a\u0443\u043f\u0435\u043b\u044c \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0456 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0421\u0432\u044f\u0442\u044b\u043c \u0414\u0443\u0445\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u043c\u044b \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0436\u044b\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e \u043d\u0430\u0448\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u0456 \u0431\u044b\u043b\u0456 \u043f\u0430 \u043f\u0440\u044b\u0440\u043e\u0434\u0437\u0435 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0433\u043d\u0435\u0432\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439 \u0437\u0431\u0430\u0432\u0456\u045e \u043d\u0430\u0441 \u0411\u043e\u0433 \u043f\u0440\u0430\u0437 \u043a\u0443\u043f\u0435\u043b\u044c \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0456 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0421\u0432\u044f\u0442\u044b\u043c \u0414\u0443\u0445\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"152","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 8-11: SCh 25 bis, 158-160)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u045e\u0442\u043e\u0440\u043d\u0430\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0437 \u0432\u0430\u0434\u044b \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0442\u044b \u045e\u0431\u0430\u0447\u044b\u045e \u0443 \u0431\u0430\u043f\u0442\u044b\u0441\u0442\u044d\u0440\u044b\u0456? \u0417\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0432\u0430\u0434\u0443, \u0430\u043b\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456. \u0422\u0430\u043c \u0431\u044b\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u044b\u044f\u043a\u0430\u043d\u044b, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u043b\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0456\u0441\u043a\u0443\u043f, \u044f\u043a\u0456 \u0437\u0430\u0434\u0430\u0432\u0430\u045e \u043f\u044b\u0442\u0430\u043d\u043d\u0456 \u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u045e \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0446\u044f\u0431\u0435 \u043f\u0430\u0432\u0443\u0447\u044b\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u0448\u0442\u043e &laquo;\u043c\u044b \u043d\u0435 \u045e\u0437\u0456\u0440\u0430\u0435\u043c\u0441\u044f \u045e \u0431\u0430\u0447\u043d\u0430\u0435, \u0430\u043b\u0435 \u045e \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u0430\u0447\u043d\u0430\u0435 &ndash; \u0447\u0430\u0441\u043e\u0432\u0430\u0435, \u0430 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435 &ndash; \u0432\u0435\u0447\u043d\u0430\u0435&raquo; (2 \u041a\u0430\u0440 4, 18). \u0414\u0430\u0440\u044d\u0447\u044b, \u0443 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u043e\u0436\u0430\u0448 \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u0446\u044c: &laquo;\u0410\u0434 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443 \u042f\u0433\u043e \u043d\u044f\u0431\u0430\u0447\u043d\u044b\u044f \u0440\u044b\u0441\u044b: \u0430\u0434\u0432\u0435\u0447\u043d\u0430\u044f \u042f\u0433\u043e \u043c\u043e\u0446 \u0456 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044c, \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u043b\u044c\u043d\u044b\u044f \u045e \u0447\u044b\u043d\u0430\u0445&raquo; (\u0420\u044b\u043c 1, 20). \u0422\u0430\u043c\u0443 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u041f\u0430\u043d \u043a\u0430\u0436\u0430: &laquo;\u041d\u0435 \u0432\u0435\u0440\u044b\u0446\u0435 \u041c\u043d\u0435, \u043f\u0430\u0432\u0435\u0440\u0446\u0435 \u0441\u043f\u0440\u0430\u0432\u0430\u043c \u041c\u0430\u0456\u043c&raquo; (\u042f\u043d 10, 38). \u0422\u0430\u043c\u0443 \u043f\u0430\u0432\u0435\u0440, \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u0442\u0443\u0442. \u042f\u043a \u0436\u0430 \u0442\u044b \u043c\u043e\u0436\u0430\u0448 \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e \u0447\u044b\u043d\u044b, \u0430\u043b\u0435 \u043d\u0435 \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c?<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0443\u043c\u0430\u0439, \u044f\u043a\u0430\u044f \u0436 \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u0430\u044f \u0433\u044d\u0442\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430, \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u0430\u044f \u043d\u0430 \u0441\u0430\u043c\u044b\u043c \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0432\u0435\u0442\u0443. \u041d\u0430\u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e, &laquo;\u0414\u0443\u0445 \u0411\u043e\u0436\u044b \u043b\u0443\u043d\u0430\u045e \u043d\u0430\u0434 \u0432\u043e\u0434\u0430\u043c\u0456&raquo; (\u0411\u044b\u0446 1, 2). \u0426\u0456 \u0436 \u0442\u043e\u0439, \u044f\u043a\u0456 \u043b\u0443\u043d\u0430\u045e, \u043d\u0435 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u045e? \u041f\u0440\u044b\u0437\u043d\u0430\u0439, \u0448\u0442\u043e \u0451\u043d \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u045e \u043f\u0440\u044b \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456 \u0441\u0432\u0435\u0442\u0443, \u0431\u043e \u043f\u0440\u0430\u0440\u043e\u043a \u043a\u0430\u0436\u0430: &laquo;\u0421\u043b\u043e\u0432\u0430\u043c \u041f\u0430\u043d\u0430 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u043d\u044f\u0431\u0451\u0441\u044b, \u0434\u044b\u0445\u0430\u043d\u043d\u0435\u043c \u042f\u0433\u043e \u0432\u0443\u0441\u043d\u0430\u045e &ndash; \u0443\u0441\u044f \u0456\u0445\u043d\u044f\u044f \u043c\u043e\u0446&raquo; (\u041f\u0441 33 [32], 6). \u041d\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u0430\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435: \u0448\u0442\u043e \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u045e \u0456 \u0448\u0442\u043e \u043b\u0443\u043d\u0430\u045e. \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u043b\u0443\u043d\u0430\u045e, \u0414\u0430\u0432\u0456\u0434 &ndash; \u0448\u0442\u043e \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0456\u043d\u0448\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435. \u041a\u043e\u0436\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u043f\u0430\u0434\u0434\u0430\u043b\u043e\u0441\u044f \u0441\u043a\u0430\u0436\u044d\u043d\u043d\u044e \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u045e\u043b\u0430\u0441\u043d\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e. &laquo;\u041c\u043e\u0439 \u0414\u0443\u0445, &minus; \u043a\u0430\u0436\u0430 \u0411\u043e\u0433, &minus; \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u043b\u044e\u0434\u0437\u044f\u0445, \u0431\u043e \u044f\u043d\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0446\u0435\u043b\u0430\u043c&raquo; (\u0411\u044b\u0446 6, 3). \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0411\u043e\u0433 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u0448\u0442\u043e \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0446\u0435\u043b\u0430 \u0456 \u043f\u043b\u044f\u043c\u0430 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443 \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u043b\u0430\u0441\u043a\u0443. \u0422\u0430\u043c\u0443 \u0411\u043e\u0433, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0430\u045e, \u0443\u0447\u044b\u043d\u0456\u045e \u043f\u0430\u0442\u043e\u043f \u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u043c\u0443 \u041d\u043e\u044e \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u043a\u0430\u045e\u0447\u044d\u0433. \u041a\u0430\u043b\u0456 \u0432\u043e\u0434\u044b \u0441\u044b\u0448\u043b\u0456, \u041d\u043e\u0439 \u0432\u044b\u043f\u0443\u0441\u0446\u0456\u045e \u0437 \u043a\u0430\u045e\u0447\u044d\u0433\u0430 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043a\u0440\u0443\u043a\u0430, \u043f\u0430\u0441\u043b\u044f \u0433\u0430\u043b\u0443\u0431\u043a\u0443, \u044f\u043a\u0430\u044f, &minus; \u044f\u043a \u0447\u044b\u0442\u0430\u0435\u043c, &minus; \u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0437 \u0430\u043b\u0456\u045e\u043a\u0430\u0432\u0430\u0439 \u0433\u0430\u043b\u0456\u043d\u043a\u0430\u0439. \u0411\u0430\u0447\u044b\u0448 \u0432\u0430\u0434\u0443, \u0431\u0430\u0447\u044b\u0448 \u0434\u0440\u044d\u0432\u0430, \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435\u0448 \u0433\u0430\u043b\u0443\u0431\u043a\u0443. \u0426\u0456 \u043c\u043e\u0436\u0430\u0448 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430 \u045e \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0456 \u0433\u044d\u0442\u044b\u0445 \u043f\u0430\u0434\u0437\u0435\u0439?<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0432\u0430\u0434\u0443 \u0437\u0430\u043d\u0443\u0440\u0430\u0435\u0446\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043a\u0430\u0431 \u0437\u043c\u044b\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0456 \u0433\u0440\u044d\u0445. \u0422\u0443\u0442 \u0437\u043d\u0456\u043a\u0430\u0435 \u043a\u043e\u0436\u043d\u0430\u044f \u043f\u0440\u0430\u0432\u0456\u043d\u0430. \u0414\u0430 \u0434\u0440\u044d\u0432\u0430 \u0431\u044b\u045e \u043f\u0440\u044b\u0431\u0456\u0442\u044b \u041f\u0430\u043d \u0415\u0437\u0443\u0441, \u043a\u0430\u043b\u0456 \u0446\u044f\u0440\u043f\u0435\u045e \u0437\u0430 \u043d\u0430\u0441. \u0423 \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0433\u0430\u043b\u0443\u0431\u043a\u0456 \u0441\u044b\u0448\u043e\u045e, \u044f\u043a \u0432\u0443\u0447\u044b\u0446\u044c \u0446\u044f\u0431\u0435 \u041d\u043e\u0432\u044b \u0417\u0430\u043f\u0430\u0432\u0435\u0442, \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u044f\u043a\u0456 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u0446\u044f\u0431\u0435 \u043f\u043e\u045e\u043d\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u0434\u0443\u0448\u044b \u0456 \u0440\u043e\u0437\u0443\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 44, 3. 4; \u042f\u043d 4, 14b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0432\u044b\u043b\u044c\u044e \u0432\u0430\u0434\u0443 \u043d\u0430 \u0441\u043f\u0440\u0430\u0433\u043d\u0435\u043d\u0443\u044e \u0433\u043b\u0435\u0431\u0443 \u0456 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u043d\u0430 \u0432\u044b\u0441\u0430\u0445\u043b\u0443\u044e \u0437\u044f\u043c\u043b\u044e; \u0432\u044b\u043b\u044c\u044e \u0434\u0443\u0445 \u041c\u043e\u0439.<span style=\"color: #ff0000;\"> *<\/span> \u0406 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0440\u0430\u0441\u0446\u0456 \u043f\u0430\u043c\u0456\u0436 \u0442\u0440\u0430\u0432\u0430\u043c\u0456, \u044f\u043a \u0456\u0432\u044b \u043a\u0430\u043b\u044f \u0432\u043e\u0434\u043d\u044b\u0445 \u043f\u0430\u0442\u043e\u043a\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0430\u0434\u0430, \u044f\u043a\u0443\u044e \u0434\u0430\u043c, \u0441\u0442\u0430\u043d\u0435 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0432\u0430\u0434\u044b, \u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0440\u0430\u0441\u0446\u0456 \u043f\u0430\u043c\u0456\u0436 \u0442\u0440\u0430\u0432\u0430\u043c\u0456, \u044f\u043a \u0456\u0432\u044b \u043a\u0430\u043b\u044f \u0432\u043e\u0434\u043d\u044b\u0445 \u043f\u0430\u0442\u043e\u043a\u0430\u045e.<\/p>\r\n"}, {"GCH_CH_2_ID":"153","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 12-16. 19: SCh 25 bis, 162-164)<\/span><br \/><span style=\"color: #ff0000;\">\u0413\u044d\u0442\u0430 \u045e\u0441\u0451 \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0437 \u0456\u043c\u0456 \u044f\u043a \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435 \u0431\u0443\u0434\u0443\u0447\u044b\u0445 \u0440\u044d\u0447\u0430\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441, \u0448\u0442\u043e &laquo;\u0430\u0439\u0446\u044b \u043d\u0430\u0448\u044b\u044f \u045e\u0441\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u0434 \u0432\u043e\u0431\u043b\u0430\u043a\u0430\u043c \u0456 \u045e\u0441\u0435 \u043f\u0440\u0430\u0439\u0448\u043b\u0456 \u043f\u0440\u0430\u0437 \u043c\u043e\u0440\u0430, \u0456 \u045e\u0441\u0435 \u0430\u043a\u0443\u043d\u0443\u043b\u0456\u0441\u044f \u0437\u0430 \u041c\u0430\u0439\u0441\u0435\u0435\u043c \u0443 \u0432\u043e\u0431\u043b\u0430\u043a\u0443 \u0456 \u045e \u043c\u043e\u0440\u044b&raquo; (1 \u041a\u0430\u0440 10, 1-2). \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0441\u0430\u043c \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u045e \u0433\u0456\u043c\u043d\u0435: &laquo;\u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u0414\u0443\u0445\u0430 \u0422\u0432\u0430\u0439\u0433\u043e, \u0456 \u043f\u0440\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u0456\u0445 \u043c\u043e\u0440\u0430&raquo; (\u043f\u0430\u0440. \u0417\u044b\u0445 15, 10). \u0413\u044d\u0442\u044b \u043f\u0435\u0440\u0430\u0445\u043e\u0434, \u043f\u0430\u0434\u0447\u0430\u0441 \u044f\u043a\u043e\u0433\u0430 \u0433\u0456\u043d\u0443\u0446\u044c \u0435\u0433\u0456\u043f\u0446\u044f\u043d\u0435, \u0430 \u0433\u0430\u0431\u0440\u044d\u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0432\u044b\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430, &ndash; \u044f\u043a \u0442\u044b \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u045e, &ndash; \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435\u043c \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0445\u0440\u043e\u0441\u0442\u0443. \u0427\u0430\u043c\u0443 \u0436 \u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0433\u044d\u0442\u044b \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u045e \u0456\u043c \u0437\u043d\u0456\u0448\u0447\u0430\u0435\u0446\u0446\u0430 \u0433\u0440\u044d\u0445 \u0456 \u0433\u0456\u043d\u0435 \u0437\u043b\u043e, \u0443 \u0442\u043e\u0439 \u0447\u0430\u0441 \u044f\u043a \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0456 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u0437\u0430\u0441\u0442\u0430\u044e\u0446\u0446\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0447\u044b\u0442\u0430\u0435\u0448, \u0448\u0442\u043e \u0430\u0439\u0446\u044b \u043d\u0430\u0448\u044b\u044f \u0431\u044b\u043b\u0456 \u045e \u0432\u043e\u0431\u043b\u0430\u043a\u0443. \u0413\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u043d\u0430\u0435 \u0432\u043e\u0431\u043b\u0430\u043a\u0430, \u044f\u043a\u043e\u0435 \u0437\u0430\u0441\u043f\u0430\u043a\u043e\u0439\u0432\u0430\u0435 \u0430\u0433\u043e\u043d\u044c \u0441\u0442\u0440\u0430\u0441\u0446\u0435\u0439; \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u043d\u0430\u0435 \u0432\u043e\u0431\u043b\u0430\u043a\u0430, \u044f\u043a\u043e\u0435 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043d\u0430\u0432\u0435\u0434\u0430\u045e \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b. \u041f\u0430\u0437\u043d\u0435\u0439 \u0441\u043f\u0430\u0447\u044b\u045e \u043d\u0430 \u0414\u0437\u0435\u0432\u0435 \u041c\u0430\u0440\u044b\u0456 \u0456 \u0430\u0433\u0430\u0440\u043d\u0443\u043b\u0430 \u042f\u0435 \u041c\u043e\u0446 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430, \u043a\u0430\u043b\u0456 \u0437\u0430\u0447\u0430\u043b\u0430 \u0417\u0431\u0430\u045e\u0446\u0443 \u0441\u0432\u0435\u0442\u0443. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0433\u044d\u0442\u044b \u0446\u0443\u0434 \u0431\u044b\u045e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u044b \u041c\u0430\u0439\u0441\u0435\u0435\u043c. \u041a\u0430\u043b\u0456 \u045e\u0436\u043e \u045e \u0441\u0430\u043c\u0456\u043c \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0456 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u045e \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u0446\u0456 \u043c\u0430\u0433\u043b\u043e \u043d\u0435 \u0431\u044b\u0446\u044c \u042f\u0433\u043e \u045e \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0456? \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0417\u0430\u043a\u043e\u043d \u0431\u044b\u045e \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043f\u0440\u0430\u0437 \u041c\u0430\u0439\u0441\u0435\u044f, \u0430 \u043b\u0430\u0441\u043a\u0430 \u0456 \u043f\u0440\u0430\u045e\u0434\u0430 \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430&raquo; (\u042f\u043d 1, 17).<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0434\u044b \u045e \u041c\u0430\u0440\u0430 \u0431\u044b\u043b\u0456 \u0433\u043e\u0440\u043a\u0456\u044f. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u043a\u0456\u043d\u0443\u045e \u0442\u0443\u0434\u044b \u0434\u0440\u044d\u0432\u0430, \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u0441\u0430\u043b\u043e\u0434\u043a\u0456\u043c\u0456. \u0411\u043e \u0432\u0430\u0434\u0430 \u0431\u0435\u0437 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u041a\u0440\u044b\u0436\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0410\u043b\u0435, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u0439 \u0437\u0431\u0430\u045e\u0447\u0430\u0433\u0430 \u043a\u0440\u044b\u0436\u0430, \u0441\u0442\u0430\u043d\u0435 \u043f\u0440\u044b\u0434\u0430\u0442\u043d\u0430\u0439 \u0434\u043b\u044f \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0430\u0431\u043c\u044b\u0446\u0446\u044f \u0456 \u0434\u043b\u044f \u0437\u0431\u0430\u045e\u0447\u0430\u0433\u0430 \u043d\u0430\u043f\u043e\u044e. \u0422\u0430\u043a \u044f\u043a \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0443\u043a\u0456\u043d\u0443\u045e \u0434\u0440\u044d\u0432\u0430 \u045e \u043a\u0440\u044b\u043d\u0456\u0446\u0443, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0441\u0432\u044f\u0442\u0430\u0440 \u0434\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u0432\u0430\u0434\u044b \u0434\u0430\u043b\u0443\u0447\u0430\u0435 \u0437\u0430\u043a\u043b\u0456\u043a \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u043a\u0440\u044b\u0436\u0430, \u0456 \u0442\u0430\u0434\u044b \u0432\u0430\u0434\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u0439 \u0456 \u045e\u0434\u0437\u044f\u043b\u044f\u0435 \u043b\u0430\u0441\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0432\u0435\u0440\u044b\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0430\u0447\u0430\u043c \u0446\u0435\u043b\u0430: \u0431\u043e\u043b\u044c\u0448 \u0431\u0430\u0447\u043d\u044b\u043c \u0451\u0441\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435, \u0431\u043e \u044f\u043d\u043e \u0432\u0435\u0447\u043d\u0430\u0435, \u0442\u043e\u0435 \u0436 &ndash; \u0437\u044f\u043c\u043d\u043e\u0435. \u041b\u0435\u043f\u0448 \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0446\u0446\u0430 \u043d\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0430\u0447\u0430\u0446\u044c \u0432\u043e\u0447\u044b \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435 \u0434\u0443\u0448\u0430 \u0456 \u0440\u043e\u0437\u0443\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0440\u044d\u0448\u0446\u0435, \u043d\u044f\u0445\u0430\u0439 \u0432\u0443\u0447\u0430\u0446\u044c \u043d\u0430\u0441 \u043f\u0430\u0447\u0443\u0442\u044b\u044f \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u0442\u0430\u043c\u0443 \u0441\u043b\u043e\u0432\u044b \u043a\u043d\u0456\u0433\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u045e. \u041d\u0430\u0430\u043c\u0430\u043d, \u043f\u0430 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0456 \u0441\u0456\u0440\u044b\u0435\u0446, \u0445\u0432\u0430\u0440\u044d\u045e \u043d\u0430 \u043f\u0440\u0430\u043a\u0430\u0437\u0443, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0433 \u044f\u0433\u043e \u0432\u044b\u043b\u0435\u0447\u044b\u0446\u044c. \u0422\u0430\u0434\u044b \u0430\u0434\u043d\u0430 \u0437 \u0434\u0437\u044f\u045e\u0447\u0430\u0442, \u0437\u0430\u0431\u0440\u0430\u043d\u044b\u0445 \u0443 \u043d\u044f\u0432\u043e\u043b\u044e, \u0441\u043a\u0430\u0437\u0430\u043b\u0430, \u0448\u0442\u043e \u045e \u0406\u0437\u0440\u0430\u044d\u043b\u0456 \u0451\u0441\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u043a, \u044f\u043a\u0456 \u043c\u043e\u0436\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u044f\u0433\u043e \u0430\u0434 \u0433\u044d\u0442\u0430\u0439 \u0445\u0432\u0430\u0440\u043e\u0431\u044b. \u041d\u0430\u0430\u043c\u0430\u043d, \u0443\u0437\u044f\u045e\u0448\u044b \u0437 \u0441\u0430\u0431\u043e\u044e, \u044f\u043a \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0437\u043e\u043b\u0430\u0442\u0430 \u0456 \u0441\u0440\u044d\u0431\u0440\u0430, \u0456\u0434\u0437\u0435 \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u042f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439 \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f \u0430\u0431 \u043f\u0440\u044b\u0447\u044b\u043d\u0435 \u0432\u0456\u0437\u0456\u0442\u0443 \u041d\u0430\u0430\u043c\u0430\u043d\u0430, \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u0441\u0432\u0430\u0435 \u0448\u0430\u0442\u044b \u0456 \u043a\u0440\u044b\u0447\u0430\u045e, \u0448\u0442\u043e \u0437\u0430\u0448\u043c\u0430\u0442 \u0430\u0434 \u044f\u0433\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435, \u0431\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043c\u0435\u0436\u044b \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0439 \u0443\u043b\u0430\u0434\u044b. \u0422\u0430\u0434\u044b \u0415\u043b\u0456\u0441\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044e \u043f\u0440\u044b\u0441\u043b\u0430\u0446\u044c \u0441\u0456\u0440\u044b\u0439\u0446\u0430 \u0434\u0430 \u044f\u0433\u043e, \u043a\u0430\u0431 \u0451\u043d \u043f\u0430\u0437\u043d\u0430\u045e, \u0448\u0442\u043e \u045e \u0406\u0437\u0440\u0430\u044d\u043b\u0456 \u0451\u0441\u0446\u044c \u0411\u043e\u0433. \u041a\u0430\u043b\u0456 \u0436 \u0442\u043e\u0439 \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0437\u0430\u0433\u0430\u0434 \u0441\u0435\u043c \u0440\u0430\u0437\u043e\u045e \u0430\u0431\u043c\u044b\u0446\u0446\u0430 \u045e \u042f\u0440\u0434\u0430\u043d\u0435. \u041d\u0430\u0430\u043c\u0430\u043d \u0436\u0430 \u043f\u0430\u0434\u0443\u043c\u0430\u045e, \u0448\u0442\u043e \u045e \u044f\u0433\u043e \u0431\u0430\u0446\u044c\u043a\u0430\u045e\u0448\u0447\u044b\u043d\u0435 \u0440\u044d\u043a\u0456 \u043c\u0430\u044e\u0446\u044c \u043b\u0435\u043f\u0448\u044b\u044f \u0432\u043e\u0434\u044b, \u0456 \u0445\u043e\u0446\u044c \u0451\u043d \u0430\u043a\u0443\u043d\u0430\u045e\u0441\u044f \u045e \u0456\u0445 \u0448\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e, \u0430\u0434\u043d\u0430\u043a \u043d\u0435 \u0430\u0447\u044b\u0441\u0446\u0456\u045e\u0441\u044f. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u0441\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u044f\u0433\u043e \u0430\u0434 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u0437\u0430\u0433\u0430\u0434\u0443 \u043f\u0440\u0430\u0440\u043e\u043a\u0430. \u0410\u043b\u0435 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u0430\u0433\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u044f \u0441\u043b\u0443\u0433, \u0451\u043d \u0441\u0430\u0441\u0442\u0443\u043f\u0456\u045e \u0456 \u0430\u0431\u043c\u044b\u045e\u0441\u044f. \u041a\u0430\u043b\u0456 \u0430\u0447\u044b\u0441\u0446\u0456\u045e\u0441\u044f, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043d\u0435 \u0432\u0430\u0434\u0430 \u0430\u0447\u044b\u0448\u0447\u0430\u0435, \u0430\u043b\u0435 \u043b\u0430\u0441\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0430\u043c\u0430\u043d \u043f\u0435\u0440\u0430\u0434 \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u0435\u043c \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u045e\u0441\u044f. \u0422\u044b \u0436, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u0435, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041f\u0441 78 (77), 52\u0430. 53; 1 \u041a\u0430\u0440 10, 2<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0432\u044b\u0432\u0435\u045e \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a \u0430\u0432\u0435\u0447\u0430\u043a, \u0456 \u0432\u0451\u045e \u0456\u0445 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430, \u0456 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u043b\u0456\u0441\u044f \u044f\u043d\u044b, <span style=\"color: #ff0000;\">*<\/span> \u0430 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0456\u0445\u043d\u0456\u0445 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u043c\u043e\u0440\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u0435 \u0430\u043a\u0443\u043d\u0443\u043b\u0456\u0441\u044f \u0437\u0430 \u041c\u0430\u0439\u0441\u0435\u0435\u043c \u0443 \u0432\u043e\u0431\u043b\u0430\u043a\u0443 \u0456 \u045e \u043c\u043e\u0440\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0456\u0445\u043d\u0456\u0445 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u043c\u043e\u0440\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"154","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 19-21. 24. 26-38: SCh 25 bis, 164-170)<\/span><br \/><span style=\"color: #ff0000;\">\u0412\u0430\u0434\u0430 \u043d\u0435 \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u0431\u0435\u0437 \u0443\u0434\u0437\u0435\u043b\u0443 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0436\u043e \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0432\u0435\u0440\u044b\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u043c \u0432\u0430\u0447\u0430\u043c. \u0410 \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0442\u0430\u043a \u0442\u0430\u043c\u0443, \u043a\u0430\u0431 \u0432\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u0430 \u0456 \u0442\u044b \u043d\u0435 \u043a\u0430\u0437\u0430\u045e, \u044f\u043a \u0442\u043e\u0439 \u041d\u0430\u0430\u043c\u0430\u043d: &laquo;\u0413\u044d\u0442\u0430 \u0456 \u0451\u0441\u0446\u044c \u0442\u0430\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430, \u044f\u043a\u043e\u0439 &ldquo;\u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430, \u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430, \u0456 \u0447\u0430\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043d\u0435 \u0437\u0434\u043e\u043b\u0435\u043b\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c&rdquo; (1 \u041a\u0430\u0440 2, 9)?&raquo; \u042f \u0436 \u0431\u0430\u0447\u0443 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0430\u0434\u0443, \u043d\u0430 \u044f\u043a\u0443\u044e \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u0433\u043b\u044f\u0434\u0436\u0443! \u0426\u0456 \u0436 \u043c\u043e\u0436\u0430 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u043c\u044f\u043d\u0435 \u0433\u044d\u0442\u0430\u044f \u0432\u0430\u0434\u0430, \u0443 \u044f\u043a\u0443\u044e \u044f \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437\u043e\u045e \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u044f? \u0414\u044b\u043a \u0436\u0430 \u0432\u0435\u0434\u0430\u0439 \u0446\u044f\u043f\u0435\u0440, \u0448\u0442\u043e \u0441\u0430\u043c\u0430 \u0432\u0430\u0434\u0430 \u0431\u0435\u0437 \u0443\u0434\u0437\u0435\u043b\u0443 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043d\u0435 \u0430\u0447\u044b\u0448\u0447\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0447\u044b\u0442\u0430\u045e, \u0448\u0442\u043e \u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0446\u0435 \u0445\u0440\u043e\u0441\u0442\u0443 &laquo;\u0442\u0440\u044b&raquo; \u0441\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c &laquo;\u0430\u0434\u043d\u043e&raquo; (\u043f\u0430\u0440. 1 \u042f\u043d 5, 8): \u0432\u0430\u0434\u0430, \u043a\u0440\u043e\u045e \u0456 \u0414\u0443\u0445. \u041a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043d\u0430\u0433\u043e \u0437 \u0456\u0445, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0443 \u0445\u0440\u043e\u0441\u0442\u0443. \u0411\u043e \u0447\u044b\u043c \u0436\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u0430\u0434\u0430 \u0431\u0435\u0437 \u043a\u0440\u044b\u0436\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u0432\u0430\u0434\u043e\u0439, \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u0430\u0439 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u0439 \u043c\u043e\u0446\u044b? \u0406 \u043d\u044f\u043c\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0443 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0431\u0435\u0437 \u0432\u0430\u0434\u044b, \u0431\u043e &laquo;\u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0432\u0430\u0434\u044b \u0456 \u0414\u0443\u0445\u0430, \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430&raquo; (\u042f\u043d 3, 5). \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043a\u0430\u0442\u044d\u0445\u0443\u043c\u044d\u043d \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u043a\u0440\u044b\u0436 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u0456\u043c \u0431\u044b\u045e \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b \u045e \u0456\u043c\u044f \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430, \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043d\u0435 \u043c\u043e\u0436\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043d\u0456 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u044f \u0433\u0440\u0430\u0445\u043e\u045e, \u043d\u0456 \u0434\u0430\u0440\u0443 \u043b\u0430\u0441\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0447\u0430\u0441\u044b \u0421\u0442\u0430\u0440\u043e\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u041d\u0430\u0430\u043c\u0430\u043d, \u0441\u0456\u0440\u044b\u0435\u0446, \u0430\u043a\u0443\u043d\u0443\u045e\u0441\u044f \u0441\u0435\u043c \u0440\u0430\u0437\u043e\u045e. \u0410 \u0442\u044b \u0431\u044b\u045e \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b \u045e \u0456\u043c\u044f \u0422\u0440\u043e\u0439\u0446\u044b. \u0422\u044b \u0432\u044b\u0437\u043d\u0430\u045e \u0410\u0439\u0446\u0430, \u0421\u044b\u043d\u0430 \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u0417\u0430\u043f\u043e\u043c\u043d\u0456 \u0447\u0430\u0440\u0433\u0443 \u043f\u0430\u0434\u0437\u0435\u0439. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0443\u044e \u0432\u0435\u0440\u0443 \u0442\u044b \u043f\u0430\u043c\u0451\u0440 \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0434\u043b\u044f \u0411\u043e\u0433\u0430. \u0422\u044b \u043d\u0456\u0431\u044b \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b \u045e \u0432\u0430\u0434\u0437\u0435; \u043f\u0430\u043c\u0451\u0440 \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443; \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0434\u043b\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0422\u0430\u043c\u0443 \u043f\u0430\u0432\u0435\u0440, \u0448\u0442\u043e \u0432\u0430\u0434\u0430 \u043d\u0435 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u0430 \u043c\u043e\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0440\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043d\u044b \u043a\u0430\u043b\u044f \u043a\u0443\u043f\u0430\u043b\u044c\u043d\u0456 \u0411\u044d\u0442\u044d\u0437\u0434\u0430 \u0447\u0430\u043a\u0430\u045e &laquo;\u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430&raquo;. \u041a\u0430\u0433\u043e, \u043a\u0430\u043b\u0456 \u043d\u0435 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0437 \u0414\u0437\u0435\u0432\u044b? \u0417 \u042f\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u0435\u043c \u043b\u0435\u0447\u044b\u0446\u044c \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445 \u0443\u0436\u043e \u043d\u0435 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435, \u0430\u043b\u0435 \u045e\u0441\u0456\u0445 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u0435 \u0441\u0430\u043c\u0430 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c. \u0415\u0437\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u044b\u043c, \u0447\u044b\u0439\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u0447\u0430\u043a\u0430\u043b\u0456, \u043f\u0440\u0430 \u044f\u043a\u043e\u0433\u0430 \u0411\u043e\u0433 \u0410\u0439\u0446\u0435\u0446 \u043a\u0430\u0437\u0430\u045e \u042f\u043d\u0443 \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044e: &laquo;\u041d\u0430\u0434 \u043a\u0456\u043c \u0443\u0431\u0430\u0447\u044b\u0448 \u0414\u0443\u0445\u0430, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0406\u043c, \u0442\u043e\u0439 \u0451\u0441\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c&raquo; (\u042f\u043d 1, 33). \u041f\u0440\u0430 \u042f\u0433\u043e \u0441\u0432\u0435\u0434\u0447\u044b\u045e \u042f\u043d, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u042f \u0431\u0430\u0447\u044b\u045e \u0414\u0443\u0445\u0430, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u044f\u043a \u0433\u043e\u043b\u0443\u0431 \u0437 \u043d\u0435\u0431\u0430 \u0456 \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u043d\u0430 \u0406\u043c&raquo; (\u042f\u043d 1, 32). \u0414\u043b\u044f \u0447\u0430\u0433\u043e \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u044f\u043a \u0433\u043e\u043b\u0443\u0431? \u0414\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0442\u044b \u045e\u0431\u0430\u0447\u044b\u045e, \u043a\u0430\u0431 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u0448\u0442\u043e \u0433\u044d\u0442\u044b \u0433o\u043b\u0443\u0431, \u044f\u043a\u043e\u0433\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u041d\u043e\u0439 \u0432\u044b\u043f\u0443\u0441\u0446\u0456\u045e \u0437 \u043a\u0430\u045e\u0447\u044d\u0433\u0430, \u0431\u044b\u045e \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0456 \u043a\u0430\u0431 \u0442\u044b \u045e\u0431\u0430\u0447\u044b\u045e \u0443 \u0433\u044d\u0442\u044b\u043c \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u043c\u043e\u0436\u0430\u0448 \u0442\u044b \u044f\u0448\u0447\u044d \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0410\u0439\u0446\u0435\u0446 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456: &laquo;\u0413\u044d\u0442\u0430 \u0421\u044b\u043d \u041c\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u044f\u043a\u043e\u0433\u0430 \u042f \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e&raquo; (\u041c\u0446 3, 17), \u043a\u0430\u043b\u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0421\u044b\u043d, \u043d\u0430\u0434 \u044f\u043a\u0456\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0433\u043e\u043b\u0443\u0431\u0430, \u043a\u0430\u043b\u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u044f\u043a\u0456 \u0441\u044b\u0448\u043e\u045e \u0443 \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0433\u043e\u043b\u0443\u0431\u0430, \u043a\u0430\u043b\u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0414\u0430\u0432\u0456\u0434: &laquo;\u0413\u043e\u043b\u0430\u0441 \u041f\u0430\u043d\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0432\u043e\u0434\u0430\u043c\u0456, \u0437\u0430\u0433\u0443\u0447\u0430\u045e \u0411\u043e\u0433 \u0432\u0435\u043b\u0456\u0447\u044b, \u041f\u0430\u043d \u043d\u0430\u0434 \u0432\u043e\u0434\u0430\u043c\u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u043c\u0456!&raquo; (\u041f\u0441 29 [28], 3), \u043a\u0430\u043b\u0456 \u045e\u0440\u044d\u0448\u0446\u0435 \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u043f\u0430 \u043f\u0440\u043e\u0441\u044c\u0431\u0435 \u0413\u0435\u0434\u044d\u043e\u043d\u0430 \u0430\u0433\u043e\u043d\u044c \u0441\u044b\u0448\u043e\u045e \u0437 \u043d\u0435\u0431\u0430 (C\u0443\u0434 6, 17-21), \u0437\u043d\u043e\u045e \u0431\u044b\u045e \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c \u0406\u043b\u043b\u0456 \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u045e \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b (1 \u0412\u0430\u043b 18, 38).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u044b\u044f \u044f\u043a\u0430\u0441\u0446\u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e, \u0430\u043b\u0435 \u043d\u0430 \u0456\u0445 \u0437\u0430\u0434\u0430\u043d\u043d\u0435. \u0428\u0442\u043e \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u044f\u043a\u0430\u0441\u0446\u044f\u045e, \u0442\u043e \u044f\u043a \u0446\u044d\u043d\u0456\u0448 \u0406\u043b\u043b\u044e, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0448\u0430\u043d\u0443\u0439 \u041f\u044f\u0442\u0440\u0430 \u0456 \u041f\u0430\u045e\u043b\u0430, \u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u0434\u0430\u043b\u0456 \u043d\u0430\u043c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443, \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u0443\u044e \u0430\u0434 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430. \u0406\u043c \u0431\u044b\u045e \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0431\u0430\u0447\u043d\u044b \u0430\u0433\u043e\u043d\u044c, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456, \u0443 \u043d\u0430\u0441 \u0436\u0430, \u044f\u043a\u0456\u044f \u0432\u0435\u0440\u044b\u043c, \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u043d\u044f\u0431\u0430\u0447\u043d\u044b \u0430\u0433\u043e\u043d\u044c. \u0414\u043b\u044f \u0456\u0445 \u0451\u043d \u0431\u044b\u045e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435\u043c, \u0434\u043b\u044f \u043d\u0430\u0441 &ndash; \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u043c. \u0412\u0435\u0440\u0443, \u0448\u0442\u043e \u041f\u0430\u043d, \u044f\u043a\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0411\u043e, \u0434\u0437\u0435 \u0434\u0432\u043e\u0435 \u0446\u0456 \u0442\u0440\u043e\u0435 \u0441\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f \u045e \u0456\u043c\u044f \u041c\u0430\u0451, \u0442\u0430\u043c \u042f \u0451\u0441\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0456\u0445&raquo; (\u041c\u0446 18, 20), \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u043d\u0430 \u0437\u0430\u043a\u043b\u0456\u043a \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0441\u0432\u044f\u0442\u0430\u0440\u0430. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0431\u043e\u043b\u044c\u0448 \u0401\u043d \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u0442\u0430\u043c, \u0434\u0437\u0435 \u0451\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b, \u0434\u0437\u0435 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0446\u0446\u0430 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0456\u045e \u0434\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0432\u0430\u0434\u044b \u0445\u0440\u043e\u0441\u0442\u0443. \u041f\u0440\u044b\u0433\u0430\u0434\u0430\u0439, \u0448\u0442\u043e \u0442\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u045e. \u0422\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0432\u0435\u0440\u044b\u0448 \u0443 \u0410\u0439\u0446\u0430, \u0432\u0435\u0440\u044b\u0448 \u0443 \u0421\u044b\u043d\u0430 \u0456 \u0432\u0435\u0440\u044b\u0448 \u0443 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u041d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0412\u0435\u0440\u0443 \u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u044b, \u0443 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u0435\u043d\u0448\u044b, \u0443 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0430\u043f\u043e\u0448\u043d\u0456&raquo;. \u041f\u0430 \u043f\u0440\u044b\u0447\u044b\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f \u0442\u044b \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043d\u044b \u0432\u0435\u0440\u044b\u0446\u044c \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430 \u045e \u0421\u044b\u043d\u0430, \u044f\u043a \u0456 \u045e \u0410\u0439\u0446\u0430, \u0456 \u0433\u044d\u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a \u0456 \u045e \u0421\u044b\u043d\u0430, \u0437\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435\u043c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0442\u044b \u0432\u0435\u0440\u044b\u0448 \u0443 \u043a\u0440\u044b\u0436 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 3, 11b; \u0406\u0441 1, 16\u0441. 17\u0430. 18b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0456\u0434\u0437\u0435 \u0437\u0430 \u043c\u043d\u043e\u044e, \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u044b \u0437\u0430 \u043c\u044f\u043d\u0435, \u0456 \u044f \u043d\u044f\u0432\u0430\u0440\u0442\u044b \u043d\u0435\u0441\u0446\u0456 \u0441\u0430\u043d\u0434\u0430\u043b\u0456 \u042f\u0433\u043e\u043d\u044b\u044f. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0456 \u0430\u0433\u043d\u0451\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u044c\u0446\u0435 \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e, \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0435\u0441\u044f \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0456 \u0430\u0433\u043d\u0451\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"155","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 29-30. 34-35. 37. 42: SCh 25 bis, 172-178)<\/span><br \/><span style=\"color: #ff0000;\">\u0422\u043b\u0443\u043c\u0430\u0447\u044d\u043d\u043d\u0435 \u0430\u0431\u0440\u0430\u0434\u0430\u045e \u043f\u0430\u0441\u043b\u044f \u0445\u0440\u043e\u0441\u0442\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u0439\u0448\u0430\u045e\u0448\u044b \u0437 \u0432\u0430\u0434\u044b, \u0442\u044b \u043f\u0430\u0434\u044b\u0448\u043e\u045e \u0434\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u0430. \u041f\u0430\u0434\u0443\u043c\u0430\u0439, \u0448\u0442\u043e \u0442\u0430\u0434\u044b \u0441\u0442\u0430\u043b\u0430\u0441\u044f. \u0426\u0456 \u0436 \u043d\u0435 \u0442\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u0414\u0430\u0432\u0456\u0434: &laquo;\u0413\u044d\u0442\u0430 \u044f\u043a \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b \u0430\u043b\u0435\u0439 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0435, \u044f\u043a\u0456 \u0441\u0446\u044f\u043a\u0430\u0435 \u043d\u0430 \u0431\u0430\u0440\u0430\u0434\u0443, \u043d\u0430 \u0431\u0430\u0440\u0430\u0434\u0443 \u0410\u0430\u0440\u043e\u043d\u0430&raquo; (\u041f\u0441 133 [132], 2). \u041f\u0440\u0430 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0430\u043b\u0435\u0439 \u043a\u0430\u0436\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0421\u0430\u043b\u0430\u043c\u043e\u043d: &laquo;\u0406\u043c\u044f \u0442\u0432\u0430\u0451, \u044f\u043a \u0440\u0430\u0437\u043b\u0456\u0442\u044b \u0430\u043b\u0435\u0439, \u0434\u0437\u044f\u045e\u0447\u0430\u0442\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u0446\u044f\u0431\u0435 \u0456 \u043f\u0430\u0432\u044f\u043b\u0456&raquo; (\u041f\u043f 1, 3). \u041f\u0430\u043d\u0435 \u0415\u0437\u0443! \u042f\u043a \u0436\u0430 \u0448\u043c\u0430\u0442 \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u0445 \u0434\u0443\u0448 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0430 \u0426\u044f\u0431\u0435 \u0441\u0451\u043d\u043d\u044f \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u043b\u0430: &laquo;\u041f\u0430\u0432\u044f\u0434\u0437\u0456 \u043d\u0430\u0441 \u0437\u0430 \u0441\u0430\u0431\u043e\u044e, \u0430 \u043c\u044b \u043f\u0430\u0431\u044f\u0436\u044b\u043c \u0437\u0430 \u0432\u043e\u0434\u0430\u0440\u0430\u043c \u0422\u0432\u0430\u0456\u0445 \u0448\u0430\u0442\u0430\u045e&raquo; (\u041f\u043f 1, 4), \u043a\u0430\u0431 \u0443\u0434\u044b\u0445\u043d\u0443\u0446\u044c \u0432\u043e\u0434\u0430\u0440 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044f \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0430\u0431\u0440\u0430\u0434\u0443, \u0431\u043e &laquo;\u043c\u0443\u0434\u0440\u044d\u0446 \u043c\u0430\u0435 \u0432\u043e\u0447\u044b \u045e \u0433\u0430\u043b\u0430\u0432\u0435&raquo; (\u042d\u043a\u043b 2, 14). \u0410\u043b\u0435\u0439 \u0441\u043f\u043b\u044b\u0432\u0430\u0435 \u043f\u0430 \u0431\u0430\u0440\u0430\u0434\u0437\u0435, \u0431\u043e \u044f\u043d\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u043d\u043d\u0435\u043c \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456, \u043f\u0430 \u0431\u0430\u0440\u0430\u0434\u0437\u0435 \u0410\u0430\u0440\u043e\u043d\u0430 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0451\u043d \u0441\u0442\u0430\u045e &laquo;\u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u0440\u043e\u0434\u0430\u043c&raquo; (\u043f\u0430\u0440. 1 \u041f 2, 9), \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0456\u043c \u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u043c. \u041c\u044b \u045e\u0441\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0439, \u043a\u0430\u0431 \u0443\u0442\u0432\u0430\u0440\u0430\u0446\u044c \u0411\u043e\u0436\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0442\u044b\u043c \u0442\u044b \u043f\u0440\u044b\u043d\u044f\u045e \u0431\u0435\u043b\u044b\u044f \u0448\u0430\u0442\u044b \u044f\u043a \u0437\u043d\u0430\u043a, \u0448\u0442\u043e \u0442\u044b \u045e\u0436\u043e \u0437\u043d\u044f\u045e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443 \u0433\u0440\u0430\u0445\u0443 \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u0447\u044b\u0441\u0442\u044b\u044f \u0448\u0430\u0442\u044b \u043d\u044f\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u0456, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u043a\u0430\u0436\u0430 \u041f\u0440\u0430\u0440\u043e\u043a: &laquo;\u0410\u043a\u0440\u0430\u043f\u0456 \u043c\u044f\u043d\u0435 \u0456\u0441\u043e\u043f\u0430\u043c &ndash; \u0456 \u0431\u0443\u0434\u0443 \u0447\u044b\u0441\u0442\u044b, \u0430\u0431\u043c\u044b\u0439 \u043c\u044f\u043d\u0435 &ndash; \u0456 \u0441\u0442\u0430\u043d\u0443 \u0431\u044f\u043b\u0435\u0439\u0448\u044b \u0437\u0430 \u0441\u043d\u0435\u0433&raquo; (\u041f\u0441 51 [50], 9). \u0411\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u044f\u043a \u0417\u0430\u043a\u043e\u043d\u0443, \u0442\u0430\u043a \u0456 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u0445\u0440\u043e\u0441\u0442, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u0435. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443, \u0431\u043e \u041c\u0430\u0439\u0441\u0435\u0439 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0430\u043a\u0440\u0430\u043f\u043b\u0435\u043d\u043d\u0435 \u0433\u0430\u043b\u0456\u043d\u043a\u0430\u0439 \u0456\u0441\u043e\u043f\u0443, \u0437\u0430\u043d\u0443\u0440\u0430\u043d\u0430\u0439 \u0443 \u043a\u0440\u044b\u0432\u0456 \u044f\u0433\u043d\u044f\u0446\u0456. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u0431\u043e \u0448\u0430\u0442\u044b \u0425\u0440\u044b\u0441\u0442\u0430 \u0431\u044b\u043b\u0456 \u0431\u0435\u043b\u044b\u044f \u044f\u043a \u0441\u043d\u0435\u0433, \u043a\u0430\u043b\u0456 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456 \u0401\u043d \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e \u0445\u0432\u0430\u043b\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f. \u0411\u044f\u043b\u0435\u0439\u0448\u044b\u043c \u0437\u0430 \u0441\u043d\u0435\u0433 \u0451\u0441\u0446\u044c \u043a\u043e\u0436\u043d\u044b, \u043a\u0430\u043c\u0443 \u0430\u0434\u043f\u0443\u0448\u0447\u0430\u043d\u044b \u0433\u0440\u044d\u0445. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u044e: &laquo;\u041a\u0430\u043b\u0456 \u0433\u0440\u0430\u0445\u0456 \u0432\u0430\u0448\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0447\u044b\u0440\u0432\u0430\u043d\u044c &minus; \u0437\u0431\u044f\u043b\u0435\u044e\u0446\u044c \u044f\u043a \u0441\u043d\u0435\u0433&raquo; (\u0406\u0441 1, 18).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0441\u0446\u0451\u043b, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0433\u044d\u0442\u044b\u044f \u0448\u0430\u0442\u044b &laquo;\u043f\u0440\u0430\u0437 \u043a\u0443\u043f\u0435\u043b\u044c \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f&raquo; (\u0426\u0456\u0442 3, 5), \u043a\u043b\u0456\u0447\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u041f\u0435\u0441\u043d\u0456 \u043f\u0435\u0441\u043d\u044f\u045e: &laquo;\u0422\u044b \u0446\u0435\u043c\u043d\u0430\u0441\u043a\u0443\u0440\u0430\u044f \u0456 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u044f, \u043e \u0434\u0430\u0447\u043a\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430!&raquo; (\u043f\u0430\u0440. \u041f\u043f 1, 5). \u041a\u0430\u0441\u0446\u0451\u043b \u0437\u0430\u0446\u0435\u043c\u043d\u0435\u043d\u044b \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0430 \u043f\u0440\u044b\u0433\u043e\u0436\u044b \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u0430\u0441\u0446\u044b. \u0417\u0430\u0446\u0435\u043c\u043d\u0435\u043d\u044b, \u0431\u043e \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0437 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e, \u043f\u0440\u044b\u0433\u043e\u0436\u044b \u043f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0432\u0435\u0440\u044b. \u0414\u043e\u0447\u043a\u0456 \u0435\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0456\u044f, \u0431\u0430\u0447\u0430\u0447\u044b \u0433\u044d\u0442\u044b\u044f \u0448\u0430\u0442\u044b, \u043a\u043b\u0456\u0447\u0443\u0446\u044c: &laquo;\u041a\u0456\u043c \u0451\u0441\u0446\u044c \u0442\u0430\u044f, \u0448\u0442\u043e \u0432\u044b\u0439\u0448\u043b\u0430 \u045e\u0441\u044f \u0443 \u0431\u0435\u043b\u0456?&raquo; \u0411\u044b\u043b\u0430 \u0446\u0435\u043c\u043d\u0430\u0441\u043a\u0443\u0440\u0430\u0439, \u0447\u0430\u043c\u0443 \u0436 \u0446\u044f\u043f\u0435\u0440 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0440\u0430\u043f\u0442\u0430\u043c \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u0430 \u0431\u0435\u043b\u0430\u0439?<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0441\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0431\u0435\u043b\u044b\u0445 \u0448\u0430\u0442\u0430\u0445, \u0437\u0430 \u044f\u043a\u0456, \u044f\u043a \u0447\u044b\u0442\u0430\u0435\u043c \u0443 \u043a\u043d\u0456\u0437\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0417\u0430\u0445\u0430\u0440\u044b\u0456, \u043f\u0440\u044b\u043d\u044f\u045e \u0433\u0430\u043d\u0435\u0431\u043d\u044b\u044f \u0448\u0430\u0442\u044b (\u043f\u0430\u0440. \u0417\u0430\u0445 3, 3), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u0430 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u0443\u044e \u0456 \u0430\u0431\u043c\u044b\u0442\u0443\u044e \u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0446\u0435 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0434\u0443\u0448\u0443, \u0456 \u043a\u0430\u0436\u0430: &laquo;\u042f\u043a\u0430\u044f \u0436 \u0442\u044b \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u044f, \u0441\u044f\u0431\u0440\u043e\u045e\u043a\u0430 \u043c\u0430\u044f, \u044f\u043a\u0430\u044f \u0436 \u0442\u044b \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u044f!&raquo; (\u041f\u043f 4, 1). \u0413\u044d\u0442\u0443\u044e \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u043f\u0440\u044b\u043d\u044f\u045e \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u0441\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0437\u044f\u043c\u043b\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0439, \u0448\u0442\u043e \u0442\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0437\u043d\u0430\u043a: &laquo;\u0414\u0443\u0445\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f, \u0434\u0443\u0445\u0430 \u043f\u0430\u0440\u0430\u0434\u044b \u0456 \u043c\u043e\u0446\u044b, \u0434\u0443\u0445\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0456 \u0431\u043e\u044f\u0437\u0456 \u041f\u0430\u043d\u0430&raquo; (\u043f\u0430\u0440. \u0406\u0441 11, 2). \u0411\u0435\u0440\u0430\u0436\u044b \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e. \u0426\u044f\u0431\u0435 \u0411\u043e\u0433 \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0437\u043d\u0430\u0447\u044b\u045e, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0456, \u044f\u043a \u043d\u0430\u0432\u0443\u0447\u0430\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b, &laquo;\u0434\u0430\u045e \u0441\u044d\u0440\u0446\u0430\u043c \u043d\u0430\u0448\u044b\u043c \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0414\u0443\u0445\u0430&raquo; (2 \u041a\u0430\u0440 1, 22).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 1, 13b-14; 2 \u041a\u0430\u0440 1, 21b-22<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u044f \u043f\u044f\u0447\u0430\u0446\u0446\u044e \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0433\u0430 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0437\u0430\u0434\u0430\u0442\u043a\u0430\u043c \u043d\u0430\u0448\u0430\u0439 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b<span style=\"color: #ff0000;\"> *<\/span> \u0434\u0437\u0435\u043b\u044f \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043d\u0430\u0431\u044b\u0442\u043a\u0443. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u043d\u0430\u0441 \u0411\u043e\u0433, \u044f\u043a\u0456 \u043f\u0430\u0437\u043d\u0430\u0447\u044b\u045e \u043d\u0430\u0441 \u0456 \u0434\u0430\u045e \u0441\u044d\u0440\u0446\u0430\u043c \u043d\u0430\u0448\u044b\u043c \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0414\u0443\u0445\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0437\u0435\u043b\u044f \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043d\u0430\u0431\u044b\u0442\u043a\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"156","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 43. 47-49: SCh 25 bis, 178-180. 182)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u043c\u043e\u0432\u0430 \u043f\u0440\u0430 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044e \u0434\u0430 \u043d\u043e\u0432\u0430\u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u0445<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0447\u044b\u0448\u0447\u0430\u043d\u0430\u044f \u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u0430\u044f \u0430\u0434\u0437\u043d\u0430\u043a\u0430\u043c\u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u0437\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u0456\u0442\u0430 \u043d\u043e\u0432\u0430\u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u0445 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0430\u043b\u0442\u0430\u0440\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0406 \u044f \u043f\u0430\u0434\u044b\u0434\u0443 \u0434\u0430 \u0430\u043b\u0442\u0430\u0440\u0430 \u0411\u043e\u0433\u0430, \u0434\u0430 \u0411\u043e\u0433\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u0432\u044f\u0441\u0435\u043b\u043b\u044f \u043c\u0430\u0439\u0433\u043e&raquo; (\u041f\u0441 43 [42], 4). \u041f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0434\u0430\u045e\u043d\u044f\u0433\u0430 \u0433\u0440\u0430\u0445\u0443 \u0456 &laquo;\u0430\u0434\u043d\u0430\u0432\u0456\u045e\u0448\u044b, \u044f\u043a \u0443 \u0430\u0440\u043b\u0430, \u0441\u0432\u0430\u044e \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u044c&raquo; (\u041f\u0441 103 [102], 4), \u0441\u043f\u044f\u0448\u0430\u0435\u0446\u0446\u0430 \u0451\u043d \u043d\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0443\u044e \u0433\u0430\u0441\u0446\u0456\u043d\u0443. \u041f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b \u0456 \u045e\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u0441\u0432\u044f\u0442\u044b \u0430\u043b\u0442\u0430\u0440, \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0435: &laquo;\u0422\u044b \u0441\u0442\u043e\u043b \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043d\u0430\u043a\u0440\u044b\u0432\u0430\u0435\u0448&raquo; (\u041f\u0441 23 [22], 5). \u0417\u0430\u0442\u044b\u043c \u0414\u0430\u0432\u0456\u0434 \u0443\u043a\u043b\u0430\u0434\u0432\u0430\u0435 \u045e \u044f\u0433\u043e \u0432\u0443\u0441\u043d\u044b \u0441\u043b\u043e\u0432\u044b: &laquo;\u041f\u0430\u043d &ndash; \u043f\u0430\u0441\u0442\u044b\u0440 \u043c\u043e\u0439, \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u0431\u0443\u0434\u0443 \u043c\u0435\u0446\u044c \u043d\u044f\u0441\u0442\u0430\u0447\u044b. \u0401\u043d \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c \u043c\u043d\u0435 \u043d\u0430 \u0437\u044f\u043b\u0451\u043d\u044b\u0445 \u043f\u0430\u0448\u0430\u0445, \u0434\u0430 \u0432\u043e\u0434\u0430\u045e \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b\u0445 \u0432\u044f\u0434\u0437\u0435 \u043c\u044f\u043d\u0435&raquo;. \u0406 \u0434\u0430\u043b\u0435\u0439: &laquo;\u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u043f\u0430\u0439\u0434\u0443 \u0434\u0430\u043b\u0456\u043d\u0430\u0439 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0446\u0435\u043d\u044e, \u043d\u0435 \u0431\u0443\u0434\u0443 \u0431\u0430\u044f\u0446\u0446\u0430 \u0437\u043b\u0430, \u0431\u043e \u0422\u044b \u0441\u0430 \u043c\u043d\u043e\u044e. \u0422\u0432\u0430\u0451 \u0436\u0430\u0437\u043b\u043e \u0456 \u0422\u0432\u043e\u0439 \u043f\u043e\u0441\u0430\u0445 \u043c\u044f\u043d\u0435 \u0441\u0443\u0446\u044f\u0448\u0430\u044e\u0446\u044c. \u0422\u044b \u0441\u0442\u043e\u043b \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043d\u0430\u043a\u0440\u044b\u0432\u0430\u0435\u0448 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u043c\u0430\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e; \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u0435\u0448 \u0433\u0430\u043b\u0430\u0432\u0443 \u043c\u0430\u044e \u0430\u043b\u0435\u0435\u043c, \u043a\u0435\u043b\u0456\u0445 \u043c\u043e\u0439 \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b&raquo; (\u041f\u0441 23 [22], 1-5).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u0437&rsquo;\u044f\u0432\u0430\u0439 \u0431\u044b\u043b\u0430 \u043c\u0430\u043d\u043d\u0430, \u044f\u043a\u0443\u044e \u0411\u043e\u0433 \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u045e \u043f\u0440\u0430\u0430\u0439\u0446\u0430\u043c, \u0430 \u0442\u044b\u044f \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043b\u0456 \u0435\u0436\u0443 \u0437 \u043d\u0435\u0431\u0430. \u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u045e \u0445\u043b\u0435\u0431 \u0430\u043d\u0451\u043b\u0430\u045e&raquo; (\u041f\u0441 78 [77], 25). \u0410\u0434\u043d\u0430\u043a \u0443\u0441\u0435, \u0445\u0442\u043e \u044f\u0433\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u045e, \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456. \u0415\u0436\u0430, \u044f\u043a\u0443\u044e \u043f\u0440\u044b\u043c\u0430\u0435\u0448 \u0442\u044b, &laquo;\u0445\u043b\u0435\u0431 \u0436\u044b\u0432\u044b, \u044f\u043a\u0456 \u0441\u044b\u0448\u043e\u045e \u0437 \u043d\u0435\u0431\u0430&raquo; (\u042f\u043d 6, 51), \u0441\u0456\u043b\u043a\u0443\u0435 \u0434\u043b\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0425\u0442\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u044f\u0433\u043e, &laquo;\u043d\u0435 \u043f\u0430\u043c\u0440\u044d \u043d\u0456\u043a\u043e\u043b\u0456&raquo; (\u042f\u043d 11, 26), \u0431\u043e \u0433\u044d\u0442\u0430 \u0426\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u043f\u0435\u0440 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u043c, \u0448\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435: \u0445\u043b\u0435\u0431 \u0430\u043d\u0451\u043b\u0430\u045e \u0446\u0456 \u0426\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0448\u0442\u043e \u0434\u0430\u0435 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u0422\u0430\u044f \u0435\u0436\u0430 \u0431\u044b\u043b\u0430 \u0437 \u043d\u0435\u0431\u0430, \u0433\u044d\u0442\u0430\u044f \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u044f\u0431\u0451\u0441\u044b; \u0442\u0430\u044f \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u043d\u0435\u0431\u0443, \u0433\u044d\u0442\u0430\u044f &ndash; \u041f\u0430\u043d\u0443 \u043d\u044f\u0431\u0451\u0441\u0430\u045e; \u0442\u0430\u044f, \u043a\u0430\u043b\u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0430\u0441\u044f \u043d\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u043f\u0441\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0433\u044d\u0442\u0430\u044f \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u0435 \u043d\u0456\u044f\u043a\u0430\u0439 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456; \u0445\u0442\u043e \u0437 \u0432\u0435\u0440\u0430\u0439 \u043f\u0440\u044b\u043c\u0430\u0435 \u0426\u0435\u043b\u0430 \u0456 \u0448\u0430\u043d\u0443\u0435 \u044f\u0433\u043e, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f. \u0414\u043b\u044f \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0430\u045e \u0432\u0430\u0434\u0430 \u0432\u044b\u043f\u043b\u044b\u043b\u0430 \u0441\u0430 \u0441\u043a\u0430\u043b\u044b, \u0434\u043b\u044f \u0446\u044f\u0431\u0435 &ndash; \u041a\u0440\u043e\u045e \u0437 \u0431\u043e\u043a\u0443 \u0425\u0440\u044b\u0441\u0442\u0430. \u0422\u044b\u043c \u0432\u0430\u0434\u0430 \u043d\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441 \u0441\u043f\u0430\u0442\u0430\u043b\u0456\u043b\u0430 \u043f\u0440\u0430\u0433\u0443, \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u041a\u0440\u043e\u045e \u0441\u043b\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456. \u0406\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0456\u043d \u043f\u0456\u045e \u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0430\u0434\u0447\u0443\u0432\u0430\u045e \u043f\u0440\u0430\u0433\u0443, \u0430 \u0442\u044b, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0456\u0446\u044c, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c. \u0422\u043e\u0435 \u0431\u044b\u043b\u043e \u0446\u0435\u043d\u0435\u043c, \u0433\u044d\u0442\u0430 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0446\u044f\u0431\u0435 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u0435, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0446\u0435\u043d\u0435\u043c, \u044f\u043a\u043e\u0439 \u0436\u0430 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0439 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c, \u0446\u0435\u043d\u044c \u044f\u043a\u043e\u0439 \u0443\u0436\u043e \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u0435. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439. \u0422\u043e\u0435, \u0448\u0442\u043e \u0430\u0434\u0431\u044b\u0432\u0430\u043b\u0430\u0441\u044f \u045e \u0447\u0430\u0441\u044b \u043f\u0440\u0430\u0430\u0439\u0446\u043e\u045e, \u0431\u044b\u043b\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u0435\u043d\u0435\u043c. &laquo;\u0423\u0441\u0435 \u043f\u0456\u043b\u0456, &ndash; \u043a\u0430\u0436\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b, &ndash; \u0437 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0441\u043a\u0430\u043b\u044b, \u0448\u0442\u043e \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u043b\u0430 \u0456\u043c, \u0430 \u0441\u043a\u0430\u043b\u043e\u044e \u0431\u044b\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0410\u0434\u043d\u0430\u043a \u0431\u043e\u043b\u044c\u0448\u0430\u0441\u0446\u044c \u0437 \u0456\u0445 \u043d\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430 \u0411\u043e\u0433\u0430, \u0442\u0430\u043c\u0443 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0437\u0430\u0433\u0443\u0431\u043b\u0435\u043d\u044b \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456. \u0413\u044d\u0442\u0430 \u0430\u0434\u0431\u044b\u043b\u043e\u0441\u044f \u044f\u043a \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0434\u043b\u044f \u043d\u0430\u0441&raquo; (1 \u041a\u0430\u0440 10, 4-6). \u0426\u044f\u043f\u0435\u0440 \u0442\u044b \u045e\u0436\u043e \u0432\u0435\u0434\u0430\u0435\u0448, \u0448\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435: \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u0437\u0430 \u0446\u0435\u043d\u044c &ndash; \u0441\u0432\u044f\u0442\u043b\u043e, \u0437\u0430 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435 &ndash; \u043f\u0440\u0430\u045e\u0434\u0430, \u0437\u0430 \u043c\u0430\u043d\u043d\u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u0443\u044e &ndash; \u0426\u0435\u043b\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 10, 1b-2. 11\u0430. 3-4\u0430<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0439\u0446\u044b \u043d\u0430\u0448\u044b\u044f \u045e\u0441\u0435 \u043f\u0440\u0430\u0439\u0448\u043b\u0456 \u043f\u0440\u0430\u0437 \u043c\u043e\u0440\u0430, \u0456 \u045e\u0441\u0435 \u0430\u043a\u0443\u043d\u0443\u043b\u0456\u0441\u044f \u0437\u0430 \u041c\u0430\u0439\u0441\u0435\u0435\u043c \u0443 \u0432\u043e\u0431\u043b\u0430\u043a\u0443 \u0456 \u045e \u043c\u043e\u0440\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0413\u044d\u0442\u0430 \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0437 \u0456\u043c\u0456 \u044f\u043a \u043f\u0440\u044b\u043a\u043b\u0430\u0434.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u0435 \u0435\u043b\u0456 \u0442\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u0435\u0436\u0443, \u0456 \u045e\u0441\u0435 \u043f\u0456\u043b\u0456 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u043d\u0430\u043f\u043e\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0437 \u0456\u043c\u0456 \u044f\u043a \u043f\u0440\u044b\u043a\u043b\u0430\u0434.<\/p>\r\n"}, {"GCH_CH_2_ID":"157","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 52-54. 58: SCh 25 bis, 186-188. 190)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442, \u044f\u043a\u0456 \u043f\u0440\u044b\u043c\u0430\u0435\u0448, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0441\u043b\u043e\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0430\u0447\u044b\u043c, \u0448\u0442\u043e \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u043b\u0430\u0441\u043a\u0456 \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0437\u0430 \u043f\u0440\u044b\u0440\u043e\u0434\u043d\u044b\u044f \u0441\u0456\u043b\u044b, \u0430\u043b\u0435 \u0436 \u043c\u044b \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0456 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043f\u0440\u0430 \u043b\u0430\u0441\u043a\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e. \u041a\u0430\u043b\u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043c\u0435\u043b\u0430 \u0442\u0430\u043a\u0443\u044e \u043c\u043e\u0446, \u0448\u0442\u043e \u0437\u043c\u044f\u043d\u044f\u043b\u0430 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b \u043f\u0430\u0440\u0430\u0434\u0430\u043a, \u0448\u0442\u043e \u0436 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u0441\u0432\u044f\u0442\u043e\u0435 \u0411\u043e\u0436\u0430\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0443 \u044f\u043a\u0456\u043c \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u0441\u0430\u043c\u043e\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b. \u0421\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442, \u044f\u043a\u0456 \u0442\u044b \u043f\u0440\u044b\u043c\u0430\u0435\u0448, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0441\u043b\u043e\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041a\u0430\u043b\u0456 \u0441\u043b\u043e\u0432\u0430 \u0406\u043b\u043b\u0456 \u043c\u0435\u043b\u0430 \u0442\u0430\u043a\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043c\u043e\u0446, \u0448\u0442\u043e \u0441\u043f\u0430\u0441\u043b\u0430\u043b\u0430 \u0430\u0433\u043e\u043d\u044c \u0437 \u043d\u0435\u0431\u0430, \u0442\u043e \u0446\u0456 \u0436 \u0441\u043b\u043e\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u043c\u0430\u0435 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430\u0439 \u043c\u043e\u0446\u044b, \u043a\u0430\u0431 \u0437\u043c\u044f\u043d\u0456\u0446\u044c \u043f\u0440\u044b\u0440\u043e\u0434\u0443 \u044f\u043a\u043e\u0439-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0440\u044d\u0447\u044b? \u0422\u044b \u0447\u044b\u0442\u0430\u045e \u043f\u0440\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0441\u0432\u0435\u0442\u0443: &laquo;\u0401\u043d \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e &ndash; \u0456 \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u0401\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e &ndash; \u0456 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f&raquo; (\u041f\u0441 33 [32], 9). \u0426\u0456 \u0436 \u0441\u043b\u043e\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u043e\u0435 \u0437 \u043d\u0456\u0447\u043e\u0433\u0430 \u045e\u0447\u044b\u043d\u0456\u043b\u0430 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0430, \u043d\u0435 \u043c\u0435\u043b\u0430 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430\u0439 \u043c\u043e\u0446\u044b, \u043a\u0430\u0431 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0436\u043e \u0456\u0441\u043d\u0443\u0435, \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u0446\u044c \u0443 \u0442\u043e\u0435, \u0447\u044b\u043c \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0436 \u0433\u044d\u0442\u044b\u044f \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u044d\u043d\u043d\u0456? \u0412\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u043c \u0434\u043e\u043a\u0430\u0437\u044b \u0437 \u0436\u044b\u0446\u0446\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u045e\u0431\u0430\u0447\u044b\u043c \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043b\u044c\u043d\u0443\u044e \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c \u043d\u0430 \u0444\u043e\u043d\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0423\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u041f\u0430\u043d\u0430. \u0426\u0456 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 \u0437 \u041c\u0430\u0440\u044b\u0456 \u0430\u0434\u0431\u044b\u043b\u043e\u0441\u044f \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u0437\u0430\u043a\u043e\u043d\u0430\u043c? \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0437\u0430\u043a\u043e\u043d\u0443 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0456 \u043c\u0443\u0436\u0447\u044b\u043d\u0430 \u0434\u0430\u044e\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0434\u0437\u0456\u0446\u044f\u0446\u0456. \u0417\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0448\u0442\u043e \u0414\u0437\u0435\u0432\u0430 \u041c\u0430\u0440\u044b\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u043f\u0430-\u0437\u0430 \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u043f\u0440\u044b\u0440\u043e\u0434\u044b. \u0422\u0430\u043c\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b\u0437\u043d\u0430\u0451\u043c, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0426\u0435\u043b\u0430\u043c, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u043c \u0437 \u0414\u0437\u0435\u0432\u044b. \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0436 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0448 \u0437\u0430\u043a\u043e\u043d\u0443 \u043f\u0440\u044b\u0440\u043e\u0434\u044b \u045e \u0426\u0435\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u0441\u0430\u043c\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0437 \u0414\u0437\u0435\u0432\u044b \u0431\u044b\u043b\u043e \u043f\u0430-\u0437\u0430 \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u043f\u0440\u044b\u0440\u043e\u0434\u044b? \u0426\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0446\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u0426\u0435\u043b\u0430\u043c, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430 \u0456 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u0430. \u0413\u044d\u0442\u044b \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043c \u042f\u0433\u043e \u0426\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043c \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u043a\u0430\u0436\u0430: &laquo;\u0413\u044d\u0442\u0430 \u0426\u0435\u043b\u0430 \u041c\u0430\u0451&raquo;. \u041f\u0435\u0440\u0430\u0434 \u0432\u044b\u043c\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0441\u0432\u044f\u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0431\u044b\u043b\u043e \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0435, \u0430\u043b\u0435 \u043f\u0430\u0441\u043b\u044f \u043a\u0430\u043d\u0441\u044d\u043a\u0440\u0430\u0446\u044b\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0436\u043e \u0426\u0435\u043b\u0430\u043c. \u0417\u0431\u0430\u045e\u0446\u0430 \u043a\u0430\u0436\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430 \u0441\u0432\u0430\u044e \u041a\u0440\u043e\u045e. \u041f\u0435\u0440\u0430\u0434 \u043a\u0430\u043d\u0441\u044d\u043a\u0440\u0430\u0446\u044b\u044f\u0439 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0456\u043d\u0430\u043a\u0448, \u043f\u0430\u0441\u043b\u044f \u043a\u0430\u043d\u0441\u044d\u043a\u0440\u0430\u0446\u044b\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041a\u0440\u044b\u0432\u0451\u0439. \u0422\u044b \u0436 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435\u0448: &laquo;\u0410\u043c\u044d\u043d&raquo;, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c: &laquo;\u0413\u044d\u0442\u0430 \u043f\u0440\u0430\u045e\u0434\u0430&raquo;. \u0422\u043e\u0435, \u0448\u0442\u043e \u0432\u044b\u043c\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0432\u0443\u0441\u043d\u044b, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u0440\u043e\u0437\u0443\u043c; \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u043d\u044f\u0445\u0430\u0439 \u0447\u0443\u0435 \u0456 \u0441\u044d\u0440\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0441\u0446\u0451\u043b, \u0443\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u044e\u0447\u044b \u0442\u0430\u043a\u0456\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u043b\u0430\u0441\u043a\u0456, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u0441\u0432\u0430\u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u0441\u044f\u0431\u0440\u043e\u045e \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u044b \u0456 \u043a\u0430\u0436\u0430: &laquo;\u0421\u043f\u0430\u0436\u044b\u0432\u0430\u0439\u0446\u0435, \u0441\u044f\u0431\u0440\u044b \u043c\u0430\u0435, \u043f\u0456\u0446\u0435 \u0456 \u0441\u043c\u0430\u043a\u0443\u0439\u0446\u0435, \u0431\u0440\u0430\u0442\u044b \u043c\u0430\u0435&raquo; (\u043f\u0430\u0440. \u041f\u043f 5, 1). \u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0442\u0430\u0431\u0435 \u043a\u0430\u0436\u0430, \u0447\u044b\u043c \u0451\u0441\u0446\u044c \u0433\u044d\u0442\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0456 \u043d\u0430\u043f\u043e\u0439: &laquo;\u041f\u0430\u043a\u0430\u0448\u0442\u0443\u0439\u0446\u0435 \u0456 \u045e\u0431\u0430\u0447\u0446\u0435, \u044f\u043a\u0456 \u0434\u043e\u0431\u0440\u044b \u0451\u0441\u0446\u044c \u041f\u0430\u043d! \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430&raquo; (\u041f\u0441 34 [33], 9). \u0423 \u0433\u044d\u0442\u044b\u043c \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0446\u0435 \u0451\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0431\u043e \u0433\u044d\u0442\u044b \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0451\u0441\u0446\u044c \u0426\u0435\u043b\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430. \u0406 \u0433\u044d\u0442\u0430 \u0435\u0436\u0430 \u043d\u0435 \u0434\u043b\u044f \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0434\u043b\u044f \u0434\u0443\u0448\u044b. \u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u044f\u0433\u043e, \u043a\u0430\u0436\u0430: &laquo;\u0410\u0439\u0446\u044b \u043d\u0430\u0448\u044b\u044f \u0435\u043b\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u0435\u0436\u0443 \u0456 \u043f\u0456\u043b\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u043d\u0430\u043f\u043e\u0439&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 10, 1-4). \u0426\u0435\u043b\u0430 \u0411\u043e\u0433\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0446\u0435\u043b\u0430\u043c. \u0426\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0426\u0435\u043b\u0430\u043c \u0411\u043e\u0436\u0430\u0433\u0430 \u0414\u0443\u0445\u0430, \u0431\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0414\u0443\u0445\u0430\u043c, \u044f\u043a \u0447\u044b\u0442\u0430\u0435\u043c: &laquo;\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0434\u043b\u044f \u043d\u0430\u0441 \u0414\u0443\u0445\u0430\u043c&raquo; (\u043f\u0430\u0440. \u041f\u043b 4, 20). \u0423 \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u0447\u044b\u0442\u0430\u0435\u043c: &laquo;\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u0432\u0430\u0441&raquo;. \u0423\u0440\u044d\u0448\u0446\u0435, \u044f\u043a \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0440\u043e\u043a, \u0433\u044d\u0442\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a &laquo;\u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u043b\u044e\u0434\u0441\u043a\u043e\u0435 \u0441\u044d\u0440\u0446\u0430&raquo;, \u0430 \u043d\u0430\u043f\u043e\u0439 &laquo;\u0432\u0435\u0441\u044f\u043b\u0456\u0446\u044c \u0441\u044d\u0440\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430&raquo; (\u043f\u0430\u0440. \u041f\u0441 104 [103], 15).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 26, 26; \u043f\u0430\u0440. \u0401\u045e 31, 31<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u0435\u043b\u0456, \u0415\u0437\u0443\u0441 \u0443\u0437\u044f\u045e \u0445\u043b\u0435\u0431, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e, \u043f\u0430\u043b\u0430\u043c\u0430\u045e \u0456, \u0434\u0430\u045e\u0448\u044b \u0432\u0443\u0447\u043d\u044f\u043c, \u0441\u043a\u0430\u0437\u0430\u045e: <span style=\"color: #ff0000;\">*<\/span> \u0411\u044f\u0440\u044b\u0446\u0435 \u0456 \u0435\u0448\u0446\u0435, \u0433\u044d\u0442\u0430 \u0426\u0435\u043b\u0430 \u041c\u0430\u0451.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u0437\u0430\u043b\u0456 \u043b\u044e\u0434\u0437\u0456 \u0448\u0430\u0442\u0440\u0430 \u043c\u0430\u0439\u0433\u043e: \u0426\u0456 \u0451\u0441\u0446\u044c \u0445\u0442\u043e\u0441\u044c\u0446\u0456, \u0445\u0442\u043e \u0431 \u043d\u0435 \u043d\u0430\u0441\u044b\u0446\u0456\u045e\u0441\u044f?<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u044f\u0440\u044b\u0446\u0435 \u0456 \u0435\u0448\u0446\u0435, \u0433\u044d\u0442\u0430 \u0426\u0435\u043b\u0430 \u041c\u0430\u0451.<\/p>\r\n"}, {"GCH_CH_2_ID":"161","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e \u0443 \u041c\u0430\u0433\u043d\u044d\u0437\u0456\u0456&raquo; <br \/>\u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Inscriptio; nn. 1, 1 &ndash; 5, 2: Funk 1, 191-195)<\/span><br \/><span style=\"color: #ff0000;\">\u0422\u0440\u044d\u0431\u0430 \u0431\u044b\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u043d\u0430\u0437\u0432\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0406\u0433\u043d\u0430\u0446\u044b\u0439, \u043d\u0430\u0437\u044b\u0432\u0430\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0422\u044d\u0430\u0444\u0430\u043d\u0430\u043c, \u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e \u041c\u0430\u0433\u043d\u044d\u0437\u0456\u0456 \u043d\u0430\u0434 \u041c\u0435\u0430\u043d\u0434\u0440\u0430\u043c, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u043c\u0443 \u043b\u0430\u0441\u043a\u0430\u0439 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u043d\u0430\u0448\u044b\u043c \u0417\u0431\u0430\u045e\u0446\u044b, &ndash; \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435 \u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0448\u0447\u043e\u0434\u0440\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e \u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443 \u0456 \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u044f \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f \u043f\u0440\u0430 \u0432\u0430\u0448\u0443\u044e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430, \u0432\u0435\u043b\u044c\u043c\u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0456 \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u0446\u044c \u0434\u0430 \u0432\u0430\u0441 \u0443 \u0432\u0435\u0440\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0423\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u044b \u0433\u0430\u043d\u0430\u0440\u043e\u0432\u044b\u043c \u0456\u043c\u0435\u043d\u0435\u043c \u044f, \u0432\u044f\u0437\u0435\u043d\u044c, \u0441\u043f\u044f\u0432\u0430\u044e \u0445\u0432\u0430\u043b\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443 i \u0437\u044b\u0447\u0443 \u0432\u0430\u043c \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u0446\u0435\u043b\u0430\u043c \u0456 \u0434\u0443\u0445\u0430\u043c \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u044b\u043c \u0432\u0435\u0447\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u0437\u044b\u0447\u0443 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u044f \u045e \u0432\u0435\u0440\u044b \u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u0435 \u045e\u0441\u0451, \u0456 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0436\u0430\u0434\u0430\u044e \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u0415\u0437\u0443\u0441\u0430\u043c \u0456 \u0410\u0439\u0446\u043e\u043c. \u041c\u0430\u044e\u0447\u044b \u045e \u0406\u043c \u0430\u043f\u0456\u0440\u044b\u0448\u0447\u0430 \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u0441\u043f\u0430\u043a\u0443\u0441\u0430\u045e \u043a\u043d\u044f\u0437\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u043c\u044b \u0437\u043c\u043e\u0436\u0430\u043c \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0443 \u0430\u0441\u043e\u0431\u0435 \u0432\u0430\u0448\u0430\u0433\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u0430, \u0437\u0430\u0441\u043b\u0443\u0436\u0430\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u0414\u0430\u043c\u0430\u0441\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0430\u0441\u043e\u0431\u0435 \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u044b\u0445 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e: \u0411\u0430\u0441\u0430 \u0456 \u0410\u043f\u0430\u043b\u043e\u043d\u0456\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0430\u0439\u0433\u043e \u0441\u0430\u0441\u043b\u0443\u0433\u0456 \u0434\u044b\u044f\u043a\u0430\u043d\u0430 \u0417\u0430\u0446\u0456\u0451\u043d\u0430, \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044e \u044f\u043a\u043e\u0433\u0430 \u044f \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b. \u0401\u043d \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b \u0431\u0456\u0441\u043a\u0443\u043f\u0443 \u044f\u043a \u043b\u0430\u0441\u0446\u044b \u0411\u043e\u0436\u0430\u0439, \u0430 \u043a\u0430\u043b\u0435\u0433\u0456\u0456 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e &ndash; \u044f\u043a \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u043c \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0456 \u0432\u0430\u043c \u0432\u044b\u043f\u0430\u0434\u0430\u0435 \u043d\u0435 \u0437\u043b\u043e\u045e\u0436\u044b\u0432\u0430\u0446\u044c \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0456\u0441\u043a\u0443\u043f\u0430, \u0430\u043b\u0435, \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u043c\u043e\u0446 \u0411\u043e\u0433\u0430, \u0430\u043a\u0440\u0443\u0436\u044b\u0446\u044c \u044f\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043f\u0430\u0448\u0430\u043d\u0430\u0439. \u042f, \u0434\u0430\u0440\u044d\u0447\u044b, \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f, \u0448\u0442\u043e \u0441\u0432\u044f\u0442\u044b\u044f \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u044b \u043d\u0435 \u0437\u043b\u043e\u045e\u0436\u044b\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u043c\u0430\u043b\u0430\u0434\u044b\u043c \u0443\u0437\u0440\u043e\u0441\u0442\u0430\u043c, \u0430\u043b\u0435, \u0431\u0443\u0434\u0443\u0447\u044b \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u043c\u0456 \u045e \u0411\u043e\u0433\u0443, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0431\u0456\u0441\u043a\u0443\u043f\u0443, \u0456 \u043d\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u043c\u0443, \u043a\u043e\u043b\u044c\u043a\u0456 \u0410\u0439\u0446\u0443 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u0456\u0441\u043a\u0443\u043f\u0430\u043c \u0443\u0441\u0456\u0445. \u0422\u0430\u043c\u0443 \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0430\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e, \u0442\u0440\u044d\u0431\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0448\u0447\u044b\u0440\u0443\u044e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c, \u0431\u043e \u043d\u0435 \u0431\u0430\u0447\u043d\u044b \u0431\u0456\u0441\u043a\u0443\u043f \u043f\u0430\u0434\u043c\u0430\u043d\u0432\u0430\u0435\u0446\u0446\u0430, \u0430\u043b\u0435 \u045e\u0432\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0437\u043c\u0430\u043d \u043d\u044f\u0431\u0430\u0447\u043d\u044b. \u0413\u044d\u0442\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u043d\u0435 \u0434\u0430\u0442\u044b\u0447\u0430\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0432\u0435\u0434\u0430\u0435 \u045e\u043a\u0440\u044b\u0442\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0440\u044d\u0431\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u0446\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456, \u0430\u043b\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u044b\u0446\u044c \u0456\u043c\u0456. \u0410\u0434\u043d\u0430\u043a \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0456\u044f, \u044f\u043a\u0456\u044f \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u044e\u0446\u0446\u0430 \u043d\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u0430, \u0430\u043b\u0435 \u045e\u0441\u0451 \u0440\u043e\u0431\u044f\u0446\u044c \u0431\u0435\u0437 \u044f\u0433\u043e. \u0422\u0430\u043a\u0456\u044f \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u043c\u0435\u0446\u044c \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f, \u0430 \u0456\u0445 \u0441\u0445\u043e\u0434\u044b \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043f\u0440\u0430\u0432\u0430\u043c\u043e\u0446\u043d\u044b\u043c\u0456 \u0456 \u0437\u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u0437 \u043d\u0430\u043a\u0430\u0437\u0430\u043c \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u045e\u0441\u0451 \u043c\u0430\u0435 \u0441\u0432\u043e\u0439 \u043a\u0430\u043d\u0435\u0446, \u0434\u0437\u0432\u0435 \u0440\u044d\u0447\u044b \u0441\u0442\u0430\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u043c\u0456: \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0436\u044b\u0446\u0446\u0451, \u0456 \u043a\u043e\u0436\u043d\u044b \u043f\u043e\u0439\u0434\u0437\u0435 \u043d\u0430 \u0441\u0432\u0430\u0451 \u043c\u0435\u0441\u0446\u0430. \u042f\u043a \u0434\u0437\u0432\u0435 \u043c\u0430\u043d\u0435\u0442\u044b, \u0430\u0434\u043d\u0430 \u0411\u043e\u0436\u0430\u044f, \u0434\u0440\u0443\u0433\u0430\u044f \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0441\u0432\u0435\u0442\u0443, \u0456 \u043a\u043e\u0436\u043d\u0430\u044f \u0437 \u0456\u0445 \u043c\u0430\u0435 \u0441\u0432\u043e\u0439 \u0443\u043b\u0430\u0441\u043d\u044b \u0437\u043d\u0430\u043a: \u043d\u044f\u0432\u0435\u0440\u043d\u044b\u044f &ndash; \u0437\u043d\u0430\u043a \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0430 \u0432\u0435\u0440\u043d\u044b\u044f, \u044f\u043a\u0456\u044f \u0442\u0440\u044b\u0432\u0430\u044e\u0446\u044c \u0443 \u043b\u044e\u0431\u043e\u0432\u0456, &ndash; \u0437\u043d\u0430\u043a \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041a\u0430\u043b\u0456, \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0447\u044b \u042f\u0433\u043e \u041c\u0443\u043a\u0443, \u043c\u044b \u043d\u0435 \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0434\u0437\u0435\u043b\u044f \u042f\u0433\u043e, \u0442\u043e \u045e \u043d\u0430\u0441 \u043d\u044f\u043c\u0430 \u042f\u0433\u043e \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u0426\u0456\u043c 4, 12b. 16b. 15<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0442\u0430\u043d\u044c \u0434\u043b\u044f \u0432\u0435\u0440\u043d\u044b\u0445 \u0443\u0437\u043e\u0440\u0430\u043c \u0443 \u0441\u043b\u043e\u0432\u0435, \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u0445, \u043b\u044e\u0431\u043e\u0432\u0456, \u0432\u0435\u0440\u044b \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0441\u0446\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0420\u043e\u0431\u044f\u0447\u044b \u0442\u0430\u043a, \u0456 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0437\u0431\u0430\u0432\u0456\u0448, \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0446\u044f\u0431\u0435 \u0441\u043b\u0443\u0445\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0431 \u0433\u044d\u0442\u044b\u043c \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0441\u044f, \u0433\u044d\u0442\u0430\u043c\u0443 \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0439, \u043a\u0430\u0431 \u0442\u0432\u043e\u0439 \u043f\u043e\u0441\u0442\u0443\u043f \u0431\u044b\u045e \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u044b \u0434\u043b\u044f \u045e\u0441\u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u043e\u0431\u044f\u0447\u044b \u0442\u0430\u043a, \u0456 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0437\u0431\u0430\u0432\u0456\u0448, \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0446\u044f\u0431\u0435 \u0441\u043b\u0443\u0445\u0430\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"162","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e \u0443 \u041c\u0430\u0433\u043d\u044d\u0437\u0456\u0456&raquo; <br \/>\u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 6, 1 &ndash; 9, 2: Funk 1, 195-199)<\/span><br \/><span style=\"color: #ff0000;\">\u0410\u0434\u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u0430\u0434\u043d\u0430 \u043d\u0430\u0434\u0437\u0435\u044f \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0441\u0432\u044f\u0442\u043e\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u045e\u0441\u044e \u0432\u0430\u0448\u0443\u044e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0443 \u0437\u0433\u0430\u0434\u0430\u043d\u044b\u0445 \u0430\u0441\u043e\u0431\u0430\u0445 \u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e\u0448\u044b \u044f\u0435 \u045e \u0432\u0435\u0440\u044b, \u0437\u0430\u043a\u043b\u0456\u043d\u0430\u044e, \u043a\u0430\u0431 \u0432\u044b \u0441\u0442\u0430\u0440\u0430\u043b\u0456\u0441\u044f \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u0443\u0441\u0451 \u045e \u0441\u0432\u044f\u0442\u043e\u0439 \u0411\u043e\u0436\u0430\u0439 \u0437\u0433\u043e\u0434\u0437\u0435 \u043f\u0430\u0434 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0431\u0456\u0441\u043a\u0443\u043f\u0430, \u044f\u043a\u0456 \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u0435 \u0430\u0434 \u0456\u043c\u044f \u0411\u043e\u0433\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e, \u044f\u043a\u0456\u044f \u045e\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u043d\u0456\u0431\u044b \u043a\u0430\u043b\u0435\u0433\u0456\u044e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0435\u043b\u044c\u043c\u0456 \u0434\u0430\u0440\u0430\u0433\u0456\u0445 \u043c\u043d\u0435 \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u045e, \u0448\u0442\u043e \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u0415\u0437\u0443\u0441\u0443 \u0425\u0440\u044b\u0441\u0442\u0443, \u044f\u043a\u0456 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443 \u0431\u044b\u045e \u0443 \u0410\u0439\u0446\u0430 \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u045e \u043a\u0430\u043d\u0446\u044b \u0447\u0430\u0441\u043e\u045e. \u041f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435 \u045e\u0441\u0435 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u044f\u0439, \u0448\u0430\u043d\u0443\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u0430 \u0432\u0430 \u045e\u0437\u0430\u0435\u043c\u043d\u044b\u0445 \u0430\u0434\u043d\u043e\u0441\u0456\u043d\u0430\u0445 \u043d\u0435 \u043a\u0456\u0440\u0443\u0439\u0446\u0435\u0441\u044f \u043b\u044e\u0434\u0441\u043a\u0456\u043c\u0456 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u043c\u0456, \u0430\u043b\u0435 \u0442\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u045e \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c, \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0432\u0430\u043c\u0456 \u043a\u0456\u0440\u0443\u0435, \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u0433\u044d\u0442\u044b\u043c \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u044f\u043a \u041f\u0430\u043d \u0431\u0435\u0437 \u0410\u0439\u0446\u0430, \u0437 \u044f\u043a\u0456\u043c \u0443\u0442\u0432\u0430\u0440\u0430\u0435 \u0430\u0434\u043d\u043e, \u043d\u0435 \u0440\u0430\u0431\u0456\u045e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0456 \u0441\u0430\u043c, \u043d\u0456 \u043f\u0440\u0430\u0437 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0442\u0430\u043a \u0456 \u0432\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0431\u0435\u0437 \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e. \u041d\u0435 \u0441\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f, \u043a\u0430\u0431 \u0434\u0430\u0431\u0440\u043e\u043c \u0431\u044b\u043b\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u0430\u043c\u0456 \u0447\u044b\u043d\u0456\u0446\u0435, \u0430\u043b\u0435 \u045e\u0441\u0451 \u0440\u0430\u0431\u0456\u0446\u0435 \u045e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456: \u0430\u0434\u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u0430\u0434\u043d\u0430 \u043f\u0440\u043e\u0441\u044c\u0431\u0430, \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445, \u0430\u0434\u043d\u0430 \u043d\u0430\u0434\u0437\u0435\u044f \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u045e \u0448\u0447\u044b\u0440\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0442\u0430\u043a \u044f\u043a \u0430\u0434\u0437\u0456\u043d \u0451\u0441\u0446\u044c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0456\u043c. \u042f\u0434\u043d\u0430\u0439\u0446\u0435\u0441\u044f \u045e\u0441\u0435, \u044f\u043a \u0443 \u0430\u0434\u043d\u043e\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0411\u043e\u0433\u0430, \u043d\u0456\u0431\u044b \u0432\u0430\u043a\u043e\u043b \u0442\u0430\u0433\u043e \u0441\u0430\u043c\u0430\u0433\u0430 \u0430\u043b\u0442\u0430\u0440\u0430, \u0442\u0430\u0433\u043e \u0441\u0430\u043c\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0430\u0434 \u0410\u0439\u0446\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u044f\u043a\u0456 \u0431\u044b\u045e \u0443 \u0410\u0439\u0446\u0430 \u0456 \u0434\u0430 \u042f\u0433\u043e \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0443\u0446\u044c \u0441\u044f\u0431\u0435 \u0447\u0443\u0436\u044b\u043c \u0432\u0443\u0447\u044d\u043d\u043d\u0435\u043c \u0456 \u0441\u0442\u0430\u0440\u044b\u043c\u0456, \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c\u0456 \u0431\u0430\u0439\u043a\u0430\u043c\u0456. \u0411\u043e \u043a\u0430\u043b\u0456 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0436\u044b\u0432\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0433\u0430\u0431\u0440\u044d\u0439\u0441\u043a\u0430\u0433\u0430 \u0437\u0430\u043a\u043e\u043d\u0443, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u043c, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043b\u0430\u0441\u043a\u0456. \u0421\u0432\u044f\u0442\u044b\u044f \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u0436\u044b\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0442\u0430\u043c\u0443 \u0456\u0445 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043b\u0456. \u0421\u0430\u043c \u0411\u043e\u0433 \u0456\u0445 \u0432\u0451\u045e, \u043a\u0430\u0431 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u0446\u044c \u043d\u044f\u0432\u0435\u0440\u043d\u044b\u0445, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433, \u044f\u043a\u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u042f\u0433\u043e \u0421\u044b\u043d\u0430. \u0401\u043d &minus; \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0432\u044b\u0439\u0448\u043b\u0430 \u0437 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u044f. \u0401\u043d \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u045e\u0441\u044f \u0410\u0439\u0446\u0443, \u044f\u043a\u0456 \u042f\u0433\u043e \u043f\u0430\u0441\u043b\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u0442\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u045e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0434\u0430\u045e\u043d\u0435\u0439\u0448\u0430\u0433\u0430 \u043b\u0430\u0434\u0443, \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u043d\u043e\u0432\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0456 \u043d\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0443\u0436\u043e \u0448\u0430\u0431\u0430\u0442\u0443, \u0430\u043b\u0435 \u0441\u0432\u044f\u0442\u043a\u0443\u044e\u0446\u044c \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430, \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u0443 \u044f\u043a\u0456\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u043c\u0443 \u0456 \u042f\u0433\u043e \u041c\u0443\u0446\u044b (\u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0430\u0441\u043f\u0440\u044d\u0447\u0432\u0430\u044e\u0446\u044c \u0433\u044d\u0442\u0430, \u0430\u0434\u043d\u0430\u043a \u043c\u044b \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0432\u0435\u0440\u0443 \u0456 \u0442\u0440\u044b\u0432\u0430\u0435\u043c \u0443 \u0451\u0439 \u043c\u043e\u0446\u043d\u0430, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c\u0456 \u0432\u0443\u0447\u043d\u044f\u043c\u0456 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430), \u0442\u043e \u044f\u043a \u0436\u0430 \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u0436\u044b\u0446\u044c \u0431\u0435\u0437 \u042f\u0433\u043e, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0448\u0442\u043e \u0456 \u0441\u0430\u043c\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456, \u042f\u0433\u043e \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0432\u0443\u0447\u043d\u0456, \u0447\u0430\u043a\u0430\u043b\u0456 \u042f\u0433\u043e \u044f\u043a \u0441\u0432\u0430\u0439\u0433\u043e \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430? \u0412\u043e\u0441\u044c \u0436\u0430 \u0442\u043e\u0439, \u044f\u043a\u043e\u0433\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0447\u0430\u043a\u0430\u043b\u0456, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0456\u0445 \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u041f 3, 8. 9b; \u0420\u044b\u043c 12, 10. 11\u0441<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u045e\u0441\u0435 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430\u043c\u0456, \u0447\u0443\u043b\u044b\u043c\u0456, \u043b\u044e\u0431\u044f\u0447\u044b\u043c\u0456 \u0431\u0440\u0430\u0442\u043e\u045e, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041b\u044e\u0431\u0456\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0431\u0440\u0430\u0442\u043d\u044f\u044e \u043b\u044e\u0431\u043e\u045e\u044e, \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e \u0432\u0435\u0442\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0441\u043b\u0443\u0436\u044b\u0446\u0435 \u041f\u0430\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"163","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e \u0443 \u041c\u0430\u0433\u043d\u044d\u0437\u0456\u0456&raquo; <br \/>\u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(N. 10, 1-15: Funk 1, 199-203)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u044b\u043c\u0456 \u0434\u0430 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u0430. \u041a\u0430\u043b\u0456 \u0431 \u0401\u043d \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u045e \u0437 \u043d\u0430\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u0448\u044b\u0445 \u0447\u044b\u043d\u0430\u045e, \u043d\u0430\u0441 \u0431\u044b \u045e\u0436\u043e \u043d\u0435 \u0431\u044b\u043b\u043e. \u0422\u0430\u043c\u0443 \u043c\u044b, \u0441\u0442\u0430\u045e\u0448\u044b \u042f\u0433\u043e \u0432\u0443\u0447\u043d\u044f\u043c\u0456, \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0436\u044b\u0446\u044c \u043f\u0430-\u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0443. \u0425\u0442\u043e \u043d\u0435 \u043d\u043e\u0441\u0456\u0446\u044c \u0456\u043c\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430, \u0430\u043b\u0435 \u043d\u0435\u0439\u043a\u0430\u0435 \u0456\u043d\u0448\u0430\u0435, \u0451\u043d \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0411\u043e\u0433\u0443. \u0422\u0430\u043c\u0443 \u0430\u0434\u043a\u0456\u043d\u044c\u0446\u0435 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0443\u044e \u0440\u043e\u0448\u0447\u044b\u043d\u0443, \u0443\u0436\u043e \u0441\u0442\u0430\u0440\u0443\u044e \u0456 \u043a\u0456\u0441\u043b\u0443\u044e, \u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u0446\u0435\u0441\u044f \u045e \u043d\u043e\u0432\u0443\u044e \u0437\u0430\u043a\u0432\u0430\u0441\u043a\u0443, \u044f\u043a\u043e\u0439 \u0451\u0441\u0446\u044c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u041d\u044f\u0445\u0430\u0439 \u0401\u043d \u0441\u0442\u0430\u043d\u0435 \u0441\u043e\u043b\u043b\u044e \u0432\u0430\u0448\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u0437 \u0432\u0430\u0441 \u043d\u0435 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u045e\u0441\u044f, \u0431\u043e \u043f\u0430\u0445 \u0434\u0430\u0441\u0446\u044c \u043f\u0440\u0430 \u0432\u0430\u0441 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435. \u041d\u0435\u0434\u0430\u0440\u044d\u0447\u043d\u044b\u043c \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u043d\u0456 \u044e\u0434\u0430\u0456\u0437\u043c\u0443. \u0411\u043e \u043d\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u0442\u0432\u0430 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0430 \u045e \u044e\u0434\u0430\u0456\u0437\u043c, \u0430\u043b\u0435 \u044e\u0434\u0430\u0456\u0437\u043c \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0443 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u0442\u0432\u0430. \u042f\u043d\u043e \u044f\u0434\u043d\u0430\u0435 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u043c\u0430\u0435! \u042f \u043f\u0456\u0448\u0443 \u0442\u0430\u043a \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f, \u0448\u0442\u043e \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u0432\u0430\u0441 \u043f\u0430\u0434\u0434\u0430\u043b\u0456\u0441\u044f \u0442\u0430\u043a\u0456\u043c \u0443\u043f\u043b\u044b\u0432\u0430\u043c, \u0430\u043b\u0435, \u0445\u043e\u0446\u044c \u044f \u043c\u0435\u043d\u0448 \u0432\u0430\u0440\u0442\u044b \u0437\u0430 \u0432\u0430\u0441, \u043a\u0430\u0431 \u0432\u0430\u0441 \u043f\u0435\u0440\u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0447\u044b: \u043d\u0435 \u0442\u0440\u0430\u043f\u043b\u044f\u0439\u0446\u0435 \u045e \u043f\u0430\u0441\u0442\u043a\u0456 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430\u0433\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f, \u0430\u043b\u0435 \u0446\u0430\u043b\u043a\u0430\u043c \u0443\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u0439\u0446\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u043c\u0443\u043a\u0443 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435, \u044f\u043a\u0456\u044f \u043c\u0435\u043b\u0456 \u043c\u0435\u0441\u0446\u0430 \u045e \u0447\u0430\u0441\u044b \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u041f\u043e\u043d\u0446\u0456\u044f \u041f\u0456\u043b\u0430\u0442\u0430, \u044f\u043a\u0456\u044f \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u045e \u0430\u0441\u043e\u0431\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u0437 \u0432\u0430\u0441 \u043d\u0435 \u0430\u0434\u0434\u0430\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u0431\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0430\u043c\u0456 \u0432\u0430 \u045e\u0441\u0456\u043c, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f \u0432\u0430\u0440\u0442\u044b \u0433\u044d\u0442\u0430\u0433\u0430. \u0425\u043e\u0446\u044c \u0456 \u045e \u043a\u0430\u0439\u0434\u0430\u043d\u0430\u0445, \u044f \u043d\u0435 \u0440\u0430\u045e\u043d\u0430\u044e\u0441\u044f \u043d\u0456 \u0437 \u043a\u0456\u043c \u0437 \u0432\u0430\u0441, \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u0445. \u042f \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0432\u044b \u043d\u0435 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u044f, \u0431\u043e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043c\u0430\u0435\u0446\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u043a\u0430\u043b\u0456 \u0432\u0430\u0441 \u0445\u0432\u0430\u043b\u044e, \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0432\u044b \u0441\u0430\u0440\u043e\u043c\u0435\u0435\u0446\u0435\u0441\u044f, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u0435 \u0441\u0430\u043c \u0441\u044f\u0431\u0435&raquo; (\u041f\u0441 19 [18], 17).<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u043c\u043e\u0446\u043d\u0430 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0432\u0443\u0447\u044d\u043d\u043d\u0456 \u041f\u0430\u043d\u0430 \u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043a\u0430\u0431 \u0443\u0441\u0451, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u0435, \u0431\u044b\u043b\u043e \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c \u0434\u043b\u044f \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u0430, \u0443 \u0432\u0435\u0440\u044b \u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u0443 \u0421\u044b\u043d\u0435, \u0410\u0439\u0446\u0443 \u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c, \u0443 \u0442\u044b\u043c, \u0448\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u0456 \u043a\u0430\u043d\u0446\u043e\u043c, \u0443 \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u0456 \u0437 \u0432\u0430\u0448\u044b\u043c \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u044b\u043c \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c, \u0437 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0439 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043a\u0430\u0440\u043e\u043d\u0430\u0439 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u0442\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0456\u043b\u044b\u043c\u0456 \u0411\u043e\u0433\u0443 \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u043c\u0456. \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u0431\u0456\u0441\u043a\u0443\u043f\u0443 \u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443, \u044f\u043a \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430 \u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u0410\u0439\u0446\u0443, \u044f\u043a \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0425\u0440\u044b\u0441\u0442\u0443, \u0410\u0439\u0446\u0443 \u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443, \u043a\u0430\u0431 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0431\u044b\u043b\u0430 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u0456 \u0431\u0430\u0447\u043d\u0430\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0432\u044b \u043f\u043e\u045e\u043d\u044b\u044f \u0411\u043e\u0433\u0430, \u0442\u0430\u043c\u0443 \u043c\u0430\u0451 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u0435 \u043a\u0430\u0440\u043e\u0442\u043a\u0430\u0435. \u0423 \u0441\u0432\u0430\u0456\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445 \u043f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u043c\u044f\u043d\u0435, \u043a\u0430\u0431 \u044f \u043c\u043e\u0433 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430, \u0456 \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0421\u0456\u0440\u044b\u0456, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u044f, \u043d\u044f\u0433\u043e\u0434\u043d\u044b, \u043d\u0430\u043b\u0435\u0436\u0443. \u042f \u043f\u0440\u0430\u0433\u043d\u0443 \u0432\u0430\u0448\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0456 \u043b\u044e\u0431\u043e\u0432\u0456 \u045e \u0411\u043e\u0433\u0443, \u043a\u0430\u0431 \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0443 \u0421\u0456\u0440\u044b\u0456, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0443 \u0432\u0430\u0448\u0430\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0448\u0447\u043e\u0434\u0440\u044b\u044f \u043b\u0430\u0441\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430 \u0421\u043c\u0456\u0440\u043d\u044b, \u0434\u0437\u0435 \u043f\u0456\u0448\u0443 \u0433\u044d\u0442\u044b \u043b\u0456\u0441\u0442, \u0432\u0456\u0442\u0430\u044e\u0446\u044c \u0432\u0430\u0441 \u044d\u0444\u0435\u0441\u0446\u044b. \u042f\u043d\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0441\u044e\u0434\u044b \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u0411\u043e\u0433\u0430. \u042f\u043a \u0456 \u0432\u044b, \u044f\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c \u0421\u043c\u0456\u0440\u043d\u044b, \u041f\u0430\u043b\u0456\u043a\u0430\u0440\u043f\u0430\u043c, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043b\u0456 \u043c\u044f\u043d\u0435 \u0432\u0430 \u045e\u0441\u0456\u043c. \u0412\u0456\u0442\u0430\u044e\u0446\u044c \u0432\u0430\u0441 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u044b \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0411\u044b\u0432\u0430\u0439\u0446\u0435 \u0456 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u044f, \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u045e \u0411\u043e\u0433\u0443. \u0426\u0435\u0448\u0446\u0435\u0441\u044f \u0414\u0443\u0445\u0430\u043c \u043d\u0435\u043f\u0430\u0434\u0437\u0435\u043b\u044c\u043d\u044b\u043c, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0415\u0437\u0443\u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 3, 16\u0430. 17. 19b; \u041a\u043b\u0441 2, 6b-7\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u0434\u0430\u045e \u0432\u0430\u043c, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0432\u044b, \u0443\u043a\u0430\u0440\u0430\u043d\u0456\u045e\u0448\u044b\u0441\u044f \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e\u0448\u044b\u0441\u044f \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u045e\u0441\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u043e\u044e \u0411\u043e\u0436\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435 \u045e \u0406\u043c, \u0443\u043a\u0430\u0440\u0430\u043d\u0451\u043d\u044b\u044f \u0456 \u0437\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u0406\u043c, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0432\u0435\u0440\u0430\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0432\u044b, \u0443\u043a\u0430\u0440\u0430\u043d\u0456\u045e\u0448\u044b\u0441\u044f \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e\u0448\u044b\u0441\u044f \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u045e\u0441\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u043e\u044e \u0411\u043e\u0436\u0430\u0439.<\/p>\r\n"}, {"GCH_CH_2_ID":"164","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0432\u043e\u0440 &laquo;\u041d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430&raquo;<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 2, 1, 1-6)<\/span><br \/><span style=\"color: #ff0000;\">\u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 &minus; \u0433\u044d\u0442\u0430 \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0443 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0432\u044f\u0440\u043d\u0456\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u043f\u0430\u043a\u0456\u043d\u044c \u0433\u044d\u0442\u044b \u043c\u0430\u0440\u043d\u044b \u0441\u0432\u0435\u0442, \u0456 \u0434\u0443\u0448\u0430 \u0442\u0432\u0430\u044f \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u0439. \u0411\u043e \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0443 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c. \u0414\u0430 \u0446\u044f\u0431\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0442\u0430\u0431\u0435 \u0441\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u0446\u0435\u0445\u0456, \u043a\u0430\u043b\u0456 \u045e\u043d\u0443\u0442\u0440\u044b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0435\u0448 \u042f\u043c\u0443 \u0433\u043e\u0434\u043d\u0430\u0435 \u043c\u0435\u0441\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u044f \u042f\u0433\u043e\u043d\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u0456 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0437\u043d\u0443\u0442\u0440\u044b, \u0456 \u0442\u0430\u043c \u0401\u043d \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435 (\u043f\u0430\u0440. \u041f\u0441 45 [44], 14). \u0401\u043d \u0447\u0430\u0441\u0442\u0430 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430: \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u044b \u043f\u043e\u045e\u043d\u044b\u044f \u0441\u043b\u043e\u0434\u044b\u0447\u044b, \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0441\u043f\u0430\u043a\u043e\u0439 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0448\u0447\u043e\u0434\u0440\u044b\u043c, \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430\u0441\u0446\u044c \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0442\u0430\u043c\u0443, \u0432\u0435\u0440\u043d\u0430\u044f \u0434\u0443\u0448\u0430, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439 \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0434\u043b\u044f \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430, \u043a\u0430\u0431 \u0401\u043d \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u0446\u044f\u0431\u0435 \u0456 \u045e \u0442\u0430\u0431\u0435 \u043f\u0430\u0441\u044f\u043b\u0456\u0446\u0446\u0430. \u0411\u043e \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u041c\u044f\u043d\u0435, \u0442\u043e\u0439 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u041c\u0430\u0451, \u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u044f\u0433\u043e, \u0456 \u0437\u0440\u043e\u0431\u0456\u043c \u0436\u044b\u043b\u043b\u0451 \u045e \u044f\u0433\u043e&raquo; (\u042f\u043d 14, 23).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439 \u0441\u044d\u0440\u0446\u0430 \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u043c\u0435\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u0443\u0434\u0437\u0435\u0448 \u0431\u0430\u0433\u0430\u0442\u044b\u043c: \u042f\u0433\u043e \u0430\u0434\u043d\u0430\u0433\u043e \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0447\u0443\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e; \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0434\u0430\u043d\u0430 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u045e\u0441\u0451, \u0456 \u0442\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u0430\u0434 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0430\u043b\u043a\u0430\u043c \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0439\u0441\u044f \u043d\u0430 \u0411\u043e\u0433\u0430. \u0422\u043e\u043b\u044c\u043a\u0456 \u042f\u0433\u043e \u0431\u043e\u0439\u0441\u044f, \u0442\u043e\u043b\u044c\u043a\u0456 \u042f\u0433\u043e \u043b\u044e\u0431\u0456. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u0437\u0430 \u0446\u044f\u0431\u0435, \u0401\u043d \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u044f\u043a \u043d\u0430\u0439\u043b\u0435\u043f\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043d\u0435 \u043c\u0430\u0435\u0448 \u0442\u0443\u0442 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430\u0433\u0430 \u043c\u0435\u0441\u0446\u0430, \u0456 \u0434\u0437\u0435 \u0431 \u0442\u044b \u043d\u0456 \u0431\u044b\u045e, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0447\u0443\u0436\u044b\u043c \u0456 \u043f\u0440\u044b\u0445\u0430\u0434\u043d\u0435\u043c. \u041d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u0435\u0448 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443, \u043a\u0430\u043b\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0434\u0443\u043c\u043a\u0456 \u0442\u0432\u0430\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430, \u0430 \u0442\u0432\u0430\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u0430 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041a\u0430\u043b\u0456 \u043d\u0435 \u0437\u043c\u043e\u0436\u0430\u0448 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043f\u0440\u0430 \u045e\u0437\u043d\u0451\u0441\u043b\u044b\u044f \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u0430\u0434\u043f\u0430\u0447\u043d\u0456 \u045e \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0456 \u043f\u0440\u0430 \u043c\u0443\u043a\u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0430\u0441\u044f\u043b\u0456\u0441\u044f \u045e \u042f\u0433\u043e \u0440\u0430\u043d\u0430\u0445. \u0417 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0456 \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0431 \u0442\u044b \u0445\u043e\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u043f\u0440\u0430\u043d\u0456\u043a \u0443 \u0441\u044d\u0440\u0446\u0430 \u0415\u0437\u0443\u0441\u0430 \u0456 \u0445\u043e\u0446\u044c \u043a\u0440\u044b\u0445\u0443 \u0441\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u045e \u042f\u0433\u043e \u043f\u0430\u043b\u044b\u043c\u043d\u0435\u044e\u0447\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0443\u0436\u043e \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u045e \u0431\u044b \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435 \u0446\u0456 \u043d\u0435\u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435; \u0442\u0430\u0434\u044b \u0431 \u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u044f\u043c, \u0431\u043e \u043b\u044e\u0431\u043e\u045e \u0415\u0437\u0443\u0441\u0430 \u0434\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0441\u0456\u043b\u0443 \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0430 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 71 (70), 1-2\u0430. 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430 \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0443 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b \u043d\u0430\u0432\u0435\u043a\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0412\u044b\u0437\u0432\u0430\u043b\u0456 \u043c\u044f\u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0422\u0432\u0430\u0451\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e \u0422\u044b &ndash; \u043c\u0430\u044f \u043d\u0430\u0434\u0437\u0435\u044f, \u041f\u0430\u043d\u0435, \u0422\u044b &ndash; \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u043d\u0435 \u043c\u0430\u0451 \u0437 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u043c\u0430\u0451\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b\u0437\u0432\u0430\u043b\u0456 \u043c\u044f\u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0422\u0432\u0430\u0451\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"165","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 43, 89-90: CSEL 64, 324-326)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u044f\u0441\u043d\u0435\u0435 \u045e \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u0441\u0432\u044f\u0442\u043b\u043e \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0427\u0430\u043c\u0443 \u0445\u0430\u0432\u0430\u0435\u0448 \u0422\u044b \u0441\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430?&raquo; (\u041f\u0441 44 [43], 25). \u0423 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u043c\u044b \u0434\u0443\u043c\u0430\u0435\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e \u0430\u0434 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430. \u0422\u0430\u0434\u044b \u0446\u0435\u043c\u0440\u0430 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u043d\u0430\u0448\u0430 \u0441\u044d\u0440\u0446\u0430 \u0456 \u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0440\u0430\u045e\u0434\u044b. \u041a\u0430\u043b\u0456 \u0436 \u0411\u043e\u0433 \u0447\u0443\u0432\u0430\u0435 \u043d\u0430\u0434 \u043d\u0430\u0448\u044b\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u0435 \u043d\u0430\u0441, \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043d\u0456\u0448\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u043a\u0456\u043d\u0443\u0446\u044c \u043d\u0430\u0441 \u0443 \u0446\u0435\u043c\u0440\u0443. \u042f\u043a \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u044f\u0441\u043d\u0435\u0435 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0456\u043d\u0448\u044b\u044f \u0447\u043b\u0435\u043d\u044b \u0446\u0435\u043b\u0430, \u0456 \u043c\u044b \u0437 \u043b\u0451\u0433\u043a\u0430\u0441\u0446\u044e \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0435\u043c\u0441\u044f, \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0447\u044b\u0439\u0441\u044c\u0446\u0456 \u0442\u0432\u0430\u0440, \u0437\u043d\u0430\u0451\u043c\u044b \u0451\u043d \u0446\u0456 \u043d\u0435, \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u045e\u0441\u0451, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0431\u043e\u043b\u044c\u0448 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0411\u043e\u0433\u0430 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u0440\u0430\u0437&rsquo;\u044f\u0441\u043d\u0435\u043d\u043d\u0435 &ndash; \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u044f \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f &ndash; \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430, \u044f\u043a\u0456 \u044f\u043a \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u0440\u0430\u043f\u043d\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u043c\u0456 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u042f\u0433\u043e \u043d\u0430\u0448\u0430\u043c\u0443 \u0440\u043e\u0437\u0443\u043c\u0443. \u041a\u0430\u0436\u0430: &laquo;\u0411\u043e\u0433, \u044f\u043a\u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u045e: &ldquo;\u041d\u044f\u0445\u0430\u0439 \u0437 \u0446\u0435\u043c\u0440\u044b \u0437\u0430\u0437\u0437\u044f\u0435 \u0441\u0432\u044f\u0442\u043b\u043e&rdquo;, \u0437\u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0443 \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0441\u043b\u0430\u0432\u044b \u0411\u043e\u0436\u0430\u0439 \u0443 \u0430\u0431\u043b\u0456\u0447\u0447\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430&raquo; (1 \u041a\u0430\u0440 4, 6). \u041c\u044b \u045e\u0436\u043e \u0440\u0430\u043d\u0435\u0439 \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f, \u044f\u043a \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u043d\u0430\u0441 \u0441\u0432\u044f\u0442\u043b\u043e \u0425\u0440\u044b\u0441\u0442\u0430. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u0443\u0448. \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0441\u043b\u0430\u045e \u042f\u0433\u043e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u043a\u0430\u0431 \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u044f \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u043c\u044b, \u044f\u043a\u0456\u044f \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0431\u044b\u043b\u0456 \u045e \u0446\u0435\u043c\u0440\u044b, \u0437\u043c\u0430\u0433\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0456 \u0432\u0435\u0447\u043d\u044b\u044f \u0440\u044d\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0440\u044d\u0447\u044b, \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u044f \u043a\u0430\u0436\u0443 \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0451\u0442\u0440 \u0441\u043a\u0430\u0437\u0430\u045e \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u0430\u043c\u0443 \u0430\u0434 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f: &laquo;\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u043d\u0430\u0441&raquo;. \u041a\u0443\u043b\u044c\u0433\u0430\u0432\u044b \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u041f\u044f\u0442\u0440\u0430, \u0456 \u0431\u044b\u045e \u0430\u0441\u0432\u0435\u0447\u0430\u043d\u044b \u043b\u0430\u0441\u043a\u0430\u0439 \u0432\u0435\u0440\u044b; \u043d\u0435 \u0431\u044b\u045e \u0431\u044b \u0430\u0437\u0434\u0430\u0440\u043e\u045e\u043b\u0435\u043d\u044b, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u043f\u0430\u0432\u0435\u0440\u044b\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u0442\u0430\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0431\u043b\u044f\u0441\u043a \u0445\u0432\u0430\u043b\u044b \u0431\u044b\u045e \u0443\u0436\u043e \u045e \u0441\u0430\u043c\u0456\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u0445, \u0430\u0434\u043d\u0430\u043a \u0417\u0430\u043a\u0445\u0435\u0439, \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0448\u044b\u0441\u044f, \u0448\u0442\u043e \u0442\u0443\u0442 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u041f\u0430\u043d \u0415\u0437\u0443\u0441, \u0437\u0430\u043b\u0435\u0437 \u043d\u0430 \u0434\u0440\u044d\u0432\u0430, \u0431\u043e \u0431\u044b\u045e \u043c\u0430\u043b\u043e\u0433\u0430 \u0440\u043e\u0441\u0442\u0443 \u0456 \u043d\u0435 \u043c\u043e\u0433 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u042f\u0433\u043e \u045e \u043d\u0430\u0442\u043e\u045e\u043f\u0435. \u041a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0441\u0432\u044f\u0442\u043b\u043e. \u0406 \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0437\u0430\u0431\u0456\u0440\u0430\u045e \u0447\u0443\u0436\u043e\u0435, \u0446\u044f\u043f\u0435\u0440 \u0440\u0430\u0437\u0434\u0430\u045e \u0441\u0432\u0430\u0451.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0427\u0430\u043c\u0443 \u0445\u0430\u0432\u0430\u0435\u0448 \u0422\u044b \u0441\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430?&raquo; (\u041f\u0441 44 [43], 25). \u0410\u043b\u0435 \u043d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u0445\u0430\u0432\u0430\u0435\u0448 \u0430\u0434 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u0441\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u044f\u0433\u043e \u0441\u0432\u044f\u0442\u043b\u043e \u0451\u0441\u0446\u044c \u0443 \u043d\u0430\u0441 (\u043f\u0430\u0440. \u041f\u0441 4, 7). \u041c\u044b \u043c\u0430\u0435\u043c \u044f\u0433\u043e \u045e \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445, \u044f\u043d\u043e \u044f\u0441\u043d\u0435\u0435 \u045e \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0434\u0443\u0448\u044b, \u0431\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0433 \u0431\u044b \u0432\u044b\u0441\u0442\u0430\u044f\u0446\u044c, \u043a\u0430\u043b\u0456 \u0431 \u0422\u044b \u0441\u0445\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 5, 8. 11\u0430; \u0413\u0431\u0440 10, 32<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0432\u044b \u0431\u044b\u043b\u0456 \u0446\u0435\u043c\u0440\u0430\u0439, \u0430 \u0446\u044f\u043f\u0435\u0440 \u0432\u044b \u0441\u0432\u044f\u0442\u043b\u043e \u045e \u041f\u0430\u043d\u0443. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435, \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u0441\u0432\u044f\u0442\u043b\u0430, \u0456 \u043d\u0435 \u0431\u044f\u0440\u044b\u0446\u0435 \u045e\u0434\u0437\u0435\u043b \u0443 \u0431\u044f\u0441\u043f\u043b\u0451\u043d\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0446\u0435\u043c\u0440\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0437\u0433\u0430\u0434\u0430\u0439\u0446\u0435 \u043c\u0456\u043d\u0443\u043b\u044b\u044f \u0434\u043d\u0456, \u043a\u0430\u043b\u0456 \u0432\u044b, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0440\u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u043c\u0456, \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0446\u044f\u0436\u043a\u0456\u044f \u043f\u0430\u043a\u0443\u0442\u044b \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435, \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u0441\u0432\u044f\u0442\u043b\u0430, \u0456 \u043d\u0435 \u0431\u044f\u0440\u044b\u0446\u0435 \u045e\u0434\u0437\u0435\u043b \u0443 \u0431\u044f\u0441\u043f\u043b\u0451\u043d\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0446\u0435\u043c\u0440\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"166","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0421\u043f\u043e\u0432\u0435\u0434\u0437\u044c&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 10, 43, 68-70: CSEL 27, 192-193)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0456\u0445<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u043c, \u044f\u043a\u043e\u0433\u0430 \u045e \u0441\u0432\u0430\u0451\u0439 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0422\u044b \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c, \u043a\u0430\u0431 \u043f\u0430 \u042f\u0433\u043e \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0437\u0435 \u043c\u044b \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u043f\u0430\u043a\u043e\u0440\u044b, \u0451\u0441\u0446\u044c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456. \u0401\u043d, \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u0445 \u0456 \u0433\u0440\u044d\u0448\u043d\u044b\u0445: \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u044f\u043a \u0411\u043e\u0433. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430\u0439 \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0436\u044b\u0446\u0446\u0451 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439, \u0442\u0430\u043c\u0443 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0437 \u0411\u043e\u0433\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0401\u043d \u043c\u043e\u0433 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0443 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u044b\u0445 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u0445 \u0441\u043c\u0435\u0440\u0446\u044c, \u044f\u043a\u0443\u044e \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0441\u0430\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456. \u042f\u043a \u0436\u0430 \u0422\u044b \u043d\u0430\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e, \u0434\u043e\u0431\u0440\u044b \u041e\u0439\u0447\u0430, \u0448\u0442\u043e &laquo;\u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e, \u0430\u043b\u0435 \u0430\u0434\u0434\u0430\u045e \u042f\u0433\u043e \u0437\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441&raquo; (\u0420\u044b\u043c 8, 32), \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e! \u042f\u043a \u0436\u0430 \u0422\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u0434\u043b\u044f \u044f\u043a\u0456\u0445 \u0417\u0431\u0430\u045e\u0446\u0430 &laquo;\u043d\u0435 \u0441\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u045e \u0437 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u043d\u0430\u0440\u043e\u045e\u043d\u0456 \u0437 \u0411\u043e\u0433\u0430\u043c, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0430\u0436\u043d\u043e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u0441\u043c\u0435\u0440\u0446\u0456 \u043a\u0440\u044b\u0436\u043e\u0432\u0430\u0439&raquo; (\u0424\u043b\u043f 2, 4. 8)! \u0401\u043d \u0430\u0434\u0437\u0456\u043d\u044b \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u044f\u043a\u0456 \u043c\u0430\u0435 \u045e\u043b\u0430\u0434\u0443 \u0436\u044b\u0446\u0446\u0451 \u0430\u0434\u0434\u0430\u0446\u044c \u0456 \u0437\u043d\u043e\u045e \u0443\u0437\u044f\u0446\u044c \u044f\u0433\u043e (\u043f\u0430\u0440. \u042f\u043d 10, 18). \u0417 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u043d\u0430\u0441 \u0441\u0442\u0430\u045e\u0441\u044f \u0434\u043b\u044f \u0426\u044f\u0431\u0435 \u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430\u043c, \u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u0439; \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430\u043c \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0430\u0445\u0432\u044f\u0440\u0430\u0439. \u041f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u0439 \u0441\u0442\u0430\u045e\u0441\u044f \u0434\u043b\u044f \u043d\u0430\u0441 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u0456 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435\u043c; \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u0431\u043e \u0401\u043d &ndash; \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435. \u041f\u0440\u0430\u0437 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0437 \u0426\u044f\u0431\u0435 \u0456 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u043d\u0430\u043c \u0401\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u043d\u0430\u0441, \u0422\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e, \u0422\u0432\u0430\u0456\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043c\u043e\u0446\u043d\u0430 \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0422\u044b \u0432\u044b\u043b\u0435\u0447\u044b\u0448 \u0443\u0441\u0435 \u043d\u0430\u0448\u044b\u044f \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e &laquo;\u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430 \u0456 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441&raquo; (\u0420\u044b\u043c 8, 34). \u0406\u043d\u0430\u043a\u0448 \u043c\u044f\u043d\u0435 \u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0430 \u0431 \u0440\u043e\u0441\u043f\u0430\u0447. \u0428\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u043c\u0430\u0435 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 &minus; \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f, \u0430\u043b\u0435 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u044b \u0437\u0430 \u0456\u0445 \u0422\u0432\u043e\u0439 \u043b\u0435\u043a. \u041c\u044b \u043c\u0430\u0433\u043b\u0456 \u0431 \u0434\u0443\u043c\u0430\u0446\u044c, \u0448\u0442\u043e \u0422\u0432\u0430\u0451 \u0421\u043b\u043e\u0432\u0430 \u0434\u0430\u043b\u0451\u043a\u0430\u0435 \u0430\u0434 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u044f \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u0456 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0431 \u042f\u043d\u043e \u043d\u0435 \u0441\u0442\u0430\u043b\u0430 \u0446\u0435\u043b\u0430\u043c \u0456 \u043d\u0435 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441. \u041f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b \u0441\u0432\u0430\u0456\u043c\u0456 \u0433\u0440\u0430\u0445\u0430\u043c\u0456 \u0456 \u0446\u044f\u0436\u0430\u0440\u0430\u043c \u043c\u0430\u0451\u0439 \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u0430\u0441\u0446\u0456 \u044f \u045e\u0436\u043e \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u045e \u0443 \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u0456 \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0443\u0446\u044f\u0447\u044b \u045e \u0441\u0430\u043c\u043e\u0442\u043d\u0430\u0441\u0446\u044c. \u0410\u0434\u043d\u0430\u043a \u0422\u044b \u0441\u0442\u0440\u044b\u043c\u0430\u045e \u043c\u044f\u043d\u0435 \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0415\u0437\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0456\u0445, \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u0432\u0435, \u0443\u0436\u043e \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0441\u044f\u0431\u0435 \u0436\u044b\u043b\u0456, \u0430 \u0434\u0437\u0435\u043b\u044f \u041f\u0430\u043c\u0435\u0440\u043b\u0430\u0433\u0430 \u0437\u0430 \u0456\u0445&raquo; (2 \u041a\u0430\u0440 5, 15).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0443\u0441\u0435 \u043c\u0430\u0435 \u043a\u043b\u043e\u043f\u0430\u0442\u044b, \u043a\u0430\u0431 \u044f \u0436\u044b\u045e \u0456 &laquo;\u045e\u0431\u0430\u0447\u044b\u045e \u0446\u0443\u0434\u044b \u0422\u0432\u0430\u0439\u0433\u043e \u0417\u0430\u043a\u043e\u043d\u0443&raquo; (\u041f\u0441 119 [118], 18). \u0422\u044b \u0432\u0435\u0434\u0430\u0435\u0448 \u043c\u0430\u044e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0441\u0446\u044c \u0456 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c (\u041f\u0441 69 [68], 6). \u041d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0439 \u043c\u044f\u043d\u0435 \u0456 \u0432\u044b\u043b\u0435\u0447\u044b. \u0422\u0432\u043e\u0439 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0421\u044b\u043d, &laquo;\u0443 \u044f\u043a\u0456\u043c \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u045e\u0441\u0435 \u0441\u043a\u0430\u0440\u0431\u044b \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f&raquo; (\u041a\u043b\u0441 2, 3), \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043c\u044f\u043d\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u044e\u0446\u044c \u043c\u044f\u043d\u0435 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u044f (\u043f\u0430\u0440. \u041f\u0441 119 [118], 122), \u0431\u043e \u044f \u043f\u0430\u043c\u044f\u0442\u0430\u044e \u043f\u0440\u0430 \u0446\u0430\u043d\u0443 \u043c\u0430\u0439\u0433\u043e \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f. \u042f\u043d\u0430 \u043c\u043e\u0439 \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0456 \u043d\u0430\u043f\u043e\u0439, \u044f \u0440\u0430\u0437\u0434\u0430\u044e \u044f\u0435 \u0456\u043d\u0448\u044b\u043c \u0456 \u0441\u0430\u043c, \u0443\u0431\u043e\u0433\u0456, \u043f\u0440\u0430\u0433\u043d\u0443 \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435 \u0456 \u043d\u0430\u0441\u044b\u0447\u0430\u0435\u0446\u0446\u0430. &laquo;\u041d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u044f\u0446\u044c \u041f\u0430\u043d\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u042f\u0433\u043e \u0448\u0443\u043a\u0430\u0435&raquo; (\u041f\u0441 22 [21], 27).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 5, 14. 15b; \u0420\u044b\u043c 6, 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u0434\u0443\u043c\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0456\u0445, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u0432\u0435, \u0443\u0436\u043e \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0441\u044f\u0431\u0435 \u0436\u044b\u043b\u0456, \u0430 \u0434\u0437\u0435\u043b\u044f \u041f\u0430\u043c\u0435\u0440\u043b\u0430\u0433\u0430 \u0437\u0430 \u0456\u0445 \u0456 \u0423\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u043f\u0430\u043c\u0451\u0440, \u0434\u044b\u043a \u043f\u0430\u043c\u0451\u0440 \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443, \u0430 \u0448\u0442\u043e \u0436\u044b\u0432\u0435, \u0434\u044b\u043a \u0436\u044b\u0432\u0435 \u0434\u043b\u044f \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u0432\u0435, \u0443\u0436\u043e \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0441\u044f\u0431\u0435 \u0436\u044b\u043b\u0456, \u0430 \u0434\u0437\u0435\u043b\u044f \u041f\u0430\u043c\u0435\u0440\u043b\u0430\u0433\u0430 \u0437\u0430 \u0456\u0445 \u0456 \u0423\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u0430\u0433\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"167","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&raquo; <br \/>\u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 13, 1-2: PG 61, 491-492)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0430\u0434\u043a\u0440\u044b\u043b\u0430\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0421\u044d\u0440\u0446\u0430 \u043d\u0430\u0448\u0430\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0448\u044b\u0440\u043e\u043a\u0456\u043c&raquo; (2 \u041a\u0430\u0440 6, 11). \u042f\u043a \u0440\u0430\u0441\u0448\u044b\u0440\u0430\u0435 \u0446\u044f\u043f\u043b\u043e, \u0442\u0430\u043a \u0456 \u043b\u044e\u0431\u043e\u045e \u043c\u043e\u0436\u0430 \u043f\u0430\u0448\u044b\u0440\u0430\u0446\u044c, \u0431\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0446\u043d\u043e\u0442\u0430\u0439, \u043f\u043e\u045e\u043d\u0430\u0439 \u0436\u0430\u0440\u0443 \u0456 \u0446\u044f\u043f\u043b\u0430. \u0413\u044d\u0442\u0430 \u044f\u043d\u0430 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u043b\u0430 \u0432\u0443\u0441\u043d\u044b i \u0441\u044d\u0440\u0446\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430. &laquo;\u041b\u044e\u0431\u043b\u044e \u0432\u0430\u0441, &minus; \u043a\u0430\u0436\u0430, &ndash; \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0431\u043e \u0456 \u0441\u044d\u0440\u0446\u0430 \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435; \u0442\u0430\u043c\u0443 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u044e \u0430\u0434\u043a\u0440\u044b\u0442\u0430, \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0456 \u045e\u0441\u0451\u0439 \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430\u0441\u0446\u044e&raquo;. \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u0435\u045e \u0431\u043e\u043b\u044c\u0448 \u0448\u044b\u0440\u043e\u043a\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430 \u0437\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430. \u0423\u0441\u0456\u0445 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445 \u043b\u044e\u0431\u0456\u045e \u0442\u0430\u043a, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u043a\u043e\u0436\u043d\u044b \u0431\u044b\u045e \u044f\u0433\u043e \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c; \u0437 \u043d\u0435\u043f\u0430\u0434\u0437\u0435\u043b\u044c\u043d\u044b\u043c \u0456 \u043d\u0435\u0430\u0441\u043b\u0430\u0431\u043d\u044b\u043c \u043f\u0430\u0447\u0443\u0446\u0446\u0451\u043c \u043b\u044e\u0431\u0456\u045e \u043a\u043e\u0436\u043d\u0430\u0433\u0430. \u0406 \u0448\u0442\u043e \u0434\u0437\u0456\u045e\u043d\u0430\u0433\u0430 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0451\u043d \u0442\u0430\u043a \u043c\u043e\u0446\u043d\u0430 \u043b\u044e\u0431\u0456\u045e \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445 \u0456 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442, \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u044f\u0432\u0435\u0440\u0443\u044e\u0447\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041b\u044e\u0431\u043b\u044e \u0432\u0430\u0441&raquo;, \u0430\u043b\u0435 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u045e: &laquo;\u0412\u0443\u0441\u043d\u044b \u043d\u0430\u0448\u044b\u044f \u0430\u0434\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456, \u043a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0435, \u0456 \u0441\u044d\u0440\u0446\u0430 \u043d\u0430\u0448\u0430\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0448\u044b\u0440\u043e\u043a\u0456\u043c&raquo; (2 \u041a\u0430\u0440 6, 11). \u0423\u0441\u0456\u0445 \u043d\u043e\u0441\u0456\u043c \u0443 \u0441\u044d\u0440\u0446\u044b, \u0456 \u043d\u0435 \u044f\u043a-\u043d\u0435\u0431\u0443\u0434\u0437\u044c, \u0430\u043b\u0435 \u0437 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u0441\u0446\u044e. \u0411\u043e \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u043b\u044e\u0431\u044f\u0446\u044c, \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u0434\u043e\u0431\u0440\u0430 \u045e \u0441\u044d\u0440\u0446\u044b \u043b\u044e\u0431\u044f\u0447\u0430\u0433\u0430. \u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: &laquo;\u0412\u0430\u043c \u043d\u0435 \u0446\u0435\u0441\u043d\u0430 \u045e \u043d\u0430\u0441, \u0430\u043b\u0435 \u0432\u0430\u0448\u0430\u0435 \u045e\u043b\u043e\u043d\u043d\u0435 \u0446\u0435\u0441\u043d\u0430\u0435&raquo; (2 \u041a\u0430\u0440 6, 12). \u0417\u0430\u045e\u0432\u0430\u0436, \u0448\u0442\u043e \u0434\u0430\u043a\u0430\u0440\u0430\u0435 \u0437 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e, \u0443\u043b\u0430\u0441\u0446\u0456\u0432\u0430\u0439 \u043b\u044e\u0434\u0437\u044f\u043c, \u044f\u043a\u0456\u044f \u043b\u044e\u0431\u044f\u0446\u044c. \u041d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0435 \u043b\u044e\u0431\u0456\u0446\u0435 \u043c\u044f\u043d\u0435&raquo;, \u0430\u043b\u0435: &laquo;\u041d\u0435 \u043b\u044e\u0431\u0456\u0446\u0435 \u043c\u044f\u043d\u0435 \u0442\u0430\u043a, \u044f\u043a \u044f&raquo;. \u041d\u0435 \u0445\u043e\u0447\u0430 \u0440\u0430\u0431\u0456\u0446\u044c \u043f\u0440\u044b\u043a\u0440\u044b\u0445 \u0434\u0430\u043a\u043e\u0440\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0456 \u0437 \u043f\u0430\u0430\u0441\u043e\u0431\u043d\u044b\u0445 \u044f\u0433\u043e \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f\u045e, \u043c\u043e\u0436\u043d\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0451\u043d \u0430\u043a\u0440\u0443\u0436\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0432\u0435\u0440\u043d\u044b\u0445. \u0412\u043e\u0441\u044c \u0448\u0442\u043e \u043f\u0456\u0448\u0430 \u0420\u044b\u043c\u043b\u044f\u043d\u0430\u043c: &laquo;\u041a\u043e\u0436\u043d\u0443\u044e \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u045e \u0441\u0432\u0430\u0456\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445 \u043f\u0440\u0430\u0448\u0443, \u043a\u0430\u0431 \u043c\u043d\u0435 \u043f\u0430\u0448\u0447\u0430\u0441\u0446\u0456\u043b\u0430 \u043a\u0430\u043b\u0456-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u0432\u0430\u0441&raquo; (\u0420\u044b\u043c 1, 10). \u0423 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e \u0451\u043d \u043a\u0430\u0436\u0430: &laquo;\u0414\u0437\u0435\u0446\u0456 \u043c\u0430\u0435, \u044f \u0437\u043d\u043e\u045e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e \u0432\u0430\u0441 \u0443 \u043f\u0430\u043a\u0443\u0442\u0430\u0445&raquo; (\u0413\u0430\u043b 4, 19). \u0406 \u0437\u043d\u043e\u045e \u0436\u0430 \u0434\u0430 \u042d\u0444\u0435\u0441\u0446\u0430\u045e: &laquo;\u0422\u0430\u043c\u0443 \u044f \u0441\u0445\u0456\u043b\u044f\u044e \u043a\u0430\u043b\u0435\u043d\u0456 \u043c\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u0410\u0439\u0446\u043e\u043c \u0456 \u043c\u0430\u043b\u044e\u0441\u044f \u0437\u0430 \u0432\u0430\u0441&raquo; (\u043f\u0430\u0440. \u042d\u0444 3, 14); \u0434\u0430 \u0422\u044d\u0441\u0430\u043b\u0430\u043d\u0456\u043a\u0456\u0439\u0446\u0430\u045e: &laquo;\u0411\u043e \u0445\u0442\u043e \u043d\u0430\u0448\u0430 \u043d\u0430\u0434\u0437\u0435\u044f, \u0430\u0431\u043e \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0430\u0431\u043e \u0432\u044f\u043d\u043e\u043a \u0445\u0432\u0430\u043b\u044b? \u0426\u0456 \u0436 \u043d\u0435 \u0432\u044b?&raquo; (1 \u0422\u044d\u0441 2, 19). \u0421\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u045e, \u0448\u0442\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u044b \u043d\u0430\u0441\u0456\u045e \u0456\u0445 \u0443 \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u041a\u0430\u043b\u0430\u0441\u044f\u043d\u0430\u043c \u043f\u0456\u0448\u0430: &laquo;\u042f \u0445\u0430\u0447\u0443, \u043a\u0430\u0431 \u0432\u044b \u0432\u0435\u0434\u0430\u043b\u0456, \u044f\u043a\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0443 \u044f \u0432\u044f\u0434\u0443 \u0437\u0430 \u0432\u0430\u0441, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u043d\u0435 \u0431\u0430\u0447\u044b\u045e \u043c\u044f\u043d\u0435 \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430, \u043a\u0430\u0431 \u0431\u044b\u043b\u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0430\u043d\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f&raquo; (\u043f\u0430\u0440. \u041a\u043b\u0441 2, 1-2). \u0406 \u0437\u043d\u043e\u045e \u043f\u0456\u0448\u0430 \u0422\u044d\u0441\u0430\u043b\u0430\u043d\u0456\u043a\u0456\u0439\u0446\u0430\u043c: &laquo;\u042f\u043a \u043a\u0430\u0440\u043c\u0456\u043b\u0456\u0446\u0430 \u0430\u043f\u044f\u043a\u0443\u0435\u0446\u0446\u0430 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456, \u0442\u0430\u043a \u0456 \u043c\u044b \u0437 \u0447\u0443\u043b\u0430\u0441\u0446\u0456 \u0434\u0430 \u0432\u0430\u0441 \u043f\u0430\u0436\u0430\u0434\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u0432\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0430\u043b\u0435 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451&raquo; (1 \u0422\u044d\u0441 2, 7-8).<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0412\u0430\u043c \u043d\u0435 \u0446\u0435\u0441\u043d\u0430 \u045e \u043d\u0430\u0441&raquo;. \u0413\u044d\u0442\u044b\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0456\u0445 \u043b\u044e\u0431\u0456\u0446\u044c, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u0456\u0445\u043d\u044e\u044e \u043b\u044e\u0431\u043e\u045e, \u043a\u0430\u0431 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0437\u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0446\u044c \u0456\u0445\u043d\u0456\u043c\u0456 \u0441\u044d\u0440\u0446\u0430\u043c\u0456. \u0421\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u041f\u0440\u044b\u0439\u0448\u043e\u045e \u0426\u0456\u0442 \u0456 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0432\u0430\u0448\u0443\u044e \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0432\u0430\u0448 \u043f\u043b\u0430\u0447, \u0432\u0430\u0448\u0443\u044e \u043b\u044e\u0431\u043e\u045e&raquo; (\u043f\u0430\u0440. 2 \u041a\u0430\u0440 7, 6-7).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 13, 4. 6; \u041f\u0440\u044b\u043f 10, 12<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041b\u044e\u0431\u043e\u045e \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u044f, \u043b\u044e\u0431\u043e\u045e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u044f, \u043d\u0435 \u0437\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u0446\u0456\u0446\u044c, \u043b\u044e\u0431\u043e\u045e \u043d\u0435 \u043f\u044b\u0445\u043b\u0456\u0432\u0430\u044f, <span style=\"color: #ff0000;\">*<\/span> \u043d\u0435 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u043f\u0440\u0430\u045e\u0434\u0430\u0439. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0440\u0430\u0441\u043f\u0430\u0447\u044b\u043d\u0430\u0435 \u0441\u043f\u0440\u044d\u0447\u043a\u0456; \u043b\u044e\u0431\u043e\u045e \u0436\u0430 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u043a\u043e\u0436\u043d\u0443\u044e \u043f\u0440\u0430\u0432\u0456\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u043f\u0440\u0430\u045e\u0434\u0430\u0439.<\/p>\r\n"}, {"GCH_CH_2_ID":"171","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&raquo; <br \/>\u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 14, 1-2: PG 61, 497-499)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u045e\u043d\u0430\u0442\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0441\u044f\u0440\u043e\u0434 \u0443\u0446\u0456\u0441\u043a\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0417\u043d\u043e\u045e \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0437\u0430\u043a\u0440\u0430\u043d\u0430\u0435 \u0442\u044d\u043c\u0443 \u043b\u044e\u0431\u043e\u0432\u0456, \u0437\u043b\u0430\u0433\u043e\u0434\u0436\u0432\u0430\u044e\u0447\u044b \u0441\u0443\u0440\u043e\u0432\u044b \u043d\u0430\u043f\u0430\u043c\u0456\u043d. \u041a\u0430\u043b\u0456 \u043f\u0430\u043f\u0440\u0430\u043a\u043d\u0443\u045e \u0456\u0445 \u0456 \u0434\u0430\u043a\u0430\u0440\u044b\u045e, \u0448\u0442\u043e \u0442\u0430\u043a \u043c\u043e\u0446\u043d\u0430 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u043d\u0435 \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u043b\u0456 \u044f\u043c\u0443 \u0442\u0430\u043a\u043e\u0439 \u0436\u0430 \u043b\u044e\u0431\u043e\u045e\u044e, \u0430 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0430\u0434 \u044f\u0433\u043e \u0456 \u0434\u0430\u043b\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0434\u0430 \u0432\u0435\u0440\u0430\u043b\u043e\u043c\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0451\u043d \u0430\u0434\u0440\u0430\u0437\u0443 \u0437\u043b\u0430\u0433\u043e\u0434\u0436\u0432\u0430\u0435 \u0432\u0430\u0441\u0442\u0440\u044b\u043d\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u043f\u0440\u043e\u043a\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u043d\u0430\u0441&raquo; (2 \u041a\u0430\u0440 7, 2), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043b\u044e\u0431\u0456\u0446\u0435 \u043d\u0430\u0441. \u041f\u0440\u043e\u0441\u0456\u0446\u044c \u0430\u0431 \u043d\u0435\u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u0430\u0441\u0446\u044b, \u044f\u043a\u0430\u044f \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u044f \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u0435 \u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u0447\u044b\u043c \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u0435 \u043f\u0440\u044b\u043c\u0430\u0435. \u041d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041b\u044e\u0431\u0456\u0446\u0435 \u043d\u0430\u0441&raquo;, \u0430\u043b\u0435 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u0441\u0446\u044e: &laquo;\u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u043d\u0430\u0441&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0436, &ndash; \u043a\u0430\u0436\u0430, &ndash; \u0432\u044b\u0434\u0430\u043b\u0456\u045e \u043c\u044f\u043d\u0435 \u0437 \u0432\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e? \u0425\u0442\u043e \u0432\u044b\u043a\u0456\u043d\u0443\u045e? \u0427\u0430\u043c\u0443 \u043d\u0430\u043c \u0442\u0430\u043a \u0446\u0435\u0441\u043d\u0430 \u045e \u0432\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445? \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0412\u0430\u043c \u043d\u0435 \u0446\u0435\u0441\u043d\u0430 \u045e \u043d\u0430\u0441, \u0430\u043b\u0435 \u0432\u0430\u0448\u0430\u0435 \u045e\u043b\u043e\u043d\u043d\u0435 \u0446\u0435\u0441\u043d\u0430\u0435&raquo; (2 \u041a\u0430\u0440 6, 12), \u0442\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043a\u0430\u0436\u0430: &laquo;\u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u043d\u0430\u0441&raquo;. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0437\u043d\u043e\u045e \u0437\u0434\u0430\u0431\u044b\u045e \u0456\u0445 \u0434\u043b\u044f \u0441\u044f\u0431\u0435. \u0411\u043e \u043d\u0456\u0448\u0442\u043e \u0442\u0430\u043a \u043c\u043e\u0446\u043d\u0430 \u043d\u0435 \u0441\u0445\u0456\u043b\u044f\u0435 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0434\u0430 \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a \u0443\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u0435\u043d\u043d\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043b\u044e\u0431\u044f\u0447\u044b \u0433\u043e\u0440\u0430\u0447\u0430 \u044f\u0435 \u043f\u0440\u0430\u0433\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u042f, &ndash; \u043a\u0430\u0436\u0430, &ndash; \u0440\u0430\u043d\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0432\u044b \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u043d\u0430\u0448\u044b\u0445, \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u043c \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0456 \u0440\u0430\u0437\u0430\u043c \u0436\u044b\u0446\u044c&raquo; (2 \u041a\u0430\u0440 7, 3). \u041c\u043e\u0446 \u043b\u044e\u0431\u043e\u0432\u0456 \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u043d\u0430\u0432\u0430\u0442 \u0431\u0443\u0434\u0443\u0447\u044b \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b\u043c \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u0451\u043d \u043f\u0440\u0430\u0433\u043d\u0435 \u0437 \u0456\u043c\u0456 \u0436\u044b\u0446\u044c \u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c. \u0412\u044b \u045e \u043d\u0430\u0448\u044b\u043c \u0441\u044d\u0440\u0446\u044b \u043d\u0435 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c, \u0430\u043b\u0435 \u0442\u0430\u043a, \u044f\u043a \u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0440\u0430\u043d\u0435\u0439. \u0417\u0434\u0430\u0440\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043b\u044e\u0431\u0456\u0446\u044c, \u0430\u043b\u0435 \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0456, \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c. \u0417 \u043d\u0430\u043c\u0456 \u043d\u0435 \u0442\u0430\u043a.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u042f \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c&raquo; (2 \u041a\u0430\u0440 7, 4). \u042f\u043a\u0456\u043c \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c? \u0422\u0430\u043a\u0456\u043c, \u044f\u043a\u043e\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0432\u0430\u0441. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u043d\u0430 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0443\u044e \u0434\u0430\u0440\u043e\u0433\u0443, \u0432\u044b \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u043c\u0456. \u0425\u0430\u0440\u0430\u043a\u0442\u044d\u0440\u043d\u0430\u044f \u044f\u043a\u0430\u0441\u0446\u044c \u043b\u044e\u0431\u044f\u0447\u0430\u0433\u0430 &ndash; \u0441\u043a\u0430\u0440\u0434\u0437\u0456\u0446\u0446\u0430, \u0448\u0442\u043e \u044f\u0433\u043e \u043b\u044e\u0431\u044f\u0446\u044c \u043d\u0435\u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u043e\u044f\u0437\u044c, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u044b\u043c\u0456 \u043f\u0430\u043f\u0440\u043e\u043a\u0430\u043c\u0456 \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043f\u0440\u044b\u043a\u0440\u0430\u0441\u0446\u0456 \u0442\u0430\u043c\u0443, \u043a\u0430\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u044c. \u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: &laquo;\u042f \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c, \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0440\u0430\u0434\u0430\u0441\u0446\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0442\u0430\u043a, \u044f\u043a \u0431\u044b \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u0432\u0435\u043b\u044c\u043c\u0456 \u043f\u0435\u0440\u0430\u0436\u044b\u0432\u0430\u045e \u0437\u0430 \u0432\u0430\u0441, \u0430\u043b\u0435 \u0432\u044b \u0432\u043e\u0441\u044c \u0443\u0447\u044b\u043d\u0456\u043b\u0456 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e, \u0456 \u0433\u044d\u0442\u044b\u043c \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u043c\u043d\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c. \u0412\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u043b\u0456 \u043f\u0440\u044b\u0447\u044b\u043d\u0443 \u0441\u043c\u0443\u0442\u043a\u0443, \u0430\u043b\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456 \u043c\u044f\u043d\u0435 \u0448\u0447\u043e\u0434\u0440\u044b\u043c \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432. \u041f\u0430\u0432\u0435\u043b \u0432\u044b\u044f\u045e\u043b\u044f\u0435 \u0441\u0432\u0430\u044e \u0432\u0435\u043b\u0456\u0447 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0440\u0430\u0434\u0430\u0441\u0446\u044e&raquo;, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0434\u0430\u0434\u0430\u043d\u044b\u0445 \u0430\u0434\u0440\u0430\u0437\u0443 \u0436 \u043f\u0430\u0441\u043b\u044f: &laquo;\u0443 \u043a\u043e\u0436\u043d\u044b\u043c \u0443\u0446\u0456\u0441\u043a\u0443 \u043d\u0430\u0448\u044b\u043c&raquo;. \u0420\u0430\u0434\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u0432\u044b \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u043c\u043d\u0435, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u044f, \u0448\u0442\u043e \u043d\u0430\u0432\u0430\u0442 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435 \u043d\u0435 \u045e \u0441\u0442\u0430\u043d\u0435 \u044f\u0435 \u0437\u0430\u0446\u044c\u043c\u0456\u0446\u044c; \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u043b\u0456\u0447\u0447\u0443 \u044f\u043d\u0430 \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u0435 \u045e\u0441\u0435 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u043d\u044b\u044f \u043d\u0435\u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456 \u0456 \u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u043f\u0430\u0434\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 12, 12. 15<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0437\u043d\u0430\u043a\u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u045e \u0432\u0430\u0441 <span style=\"color: #ff0000;\">*<\/span> \u043f\u0440\u0430\u0437 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0437 \u0446\u0443\u0434\u044b \u0456 \u043c\u043e\u0446\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0432\u0435\u043b\u044c\u043c\u0456 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0430\u043d\u044f\u0441\u0443 \u0432\u044b\u0434\u0430\u0442\u043a\u0456 \u0456 \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0430\u0434\u0434\u0430\u043c \u0437\u0430 \u0434\u0443\u0448\u044b \u0432\u0430\u0448\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u0437 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0437 \u0446\u0443\u0434\u044b \u0456 \u043c\u043e\u0446\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"172","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0426\u044d\u0437\u0430\u0440\u044b\u044f \u0437 \u0410\u0440\u043b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 25, 1: CCL 103, 111-112)<\/span><br \/><span style=\"color: #ff0000;\">\u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u0456 \u0411\u043e\u0436\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u044f, \u0431\u043e \u044f\u043d\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c&raquo; (\u041c\u0446 5, 7). \u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0441\u043b\u043e\u0432\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u0448\u043c\u0430\u0442 \u0441\u043b\u043e\u0434\u044b\u0447\u044b, \u0430 \u043a\u0430\u043b\u0456 \u0441\u043b\u043e\u0432\u0430 \u043c\u0430\u0435, \u0442\u043e \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043e\u043b\u044c\u0448 \u0441\u0430\u043c\u0430 \u0440\u044d\u0447. \u0423\u0441\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u043d\u0430 \u0436\u0430\u043b\u044c \u043d\u0435 \u045e\u0441\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c \u0442\u0430\u043a, \u043a\u0430\u0431 \u044f\u0435 \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u0446\u044c. \u0423\u0441\u0435 \u0445\u043e\u0447\u0443\u0446\u044c \u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0430\u043b\u0435 \u043d\u044f\u043c\u043d\u043e\u0433\u0456\u044f \u0445\u043e\u0447\u0443\u0446\u044c \u0431\u044b\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043c\u043e\u0436\u0430\u0448 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0430\u0431 \u043d\u0435\u0447\u044b\u043c, \u0447\u0430\u0433\u043e \u0441\u0430\u043c \u043d\u0435 \u0445\u043e\u0447\u0430\u0448 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u0446\u044c? \u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0443 \u043d\u0435\u0431\u0435, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0446\u044c \u044f\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0410 \u0442\u0430\u043c\u0443, \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u045e\u0441\u0435 \u043f\u0440\u0430\u0433\u043d\u0435\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0432\u043e\u0437\u044c\u043c\u0435\u043c \u044f\u0435 \u0441\u0430\u0431\u0435 \u044f\u043a \u0430\u0431\u0430\u0440\u043e\u043d\u0446\u0443 \u045e\u0436\u043e \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u043a\u0430\u0431 \u044f\u043d\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u043b\u0430 \u043d\u0430\u0441 \u0443 \u0431\u0443\u0434\u0443\u0447\u044b\u043c. \u0411\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456\u0441\u043d\u0443\u0435 \u045e \u043d\u0435\u0431\u0435, \u0430\u043b\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u044f\u0435 \u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0411\u043e \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0422\u0432\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u041f\u0430\u043d\u0435, \u0434\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u045e&raquo; (\u041f\u0441 36 [35], 6).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0456\u0441\u043d\u0443\u0435 \u0430\u0434\u043d\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0434\u0440\u0443\u0433\u0430\u044f &ndash; \u0443 \u043d\u0435\u0431\u0435, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u043b\u044e\u0434\u0441\u043a\u0430\u044f \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0430\u044f. \u0423 \u0447\u044b\u043c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u043b\u044e\u0434\u0441\u043a\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c? \u0423 \u0442\u044b\u043c, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u043b\u0456 \u043f\u0440\u0430 \u045e\u0431\u043e\u0433\u0456\u0445. \u0410 \u045e \u0447\u044b\u043c \u0411\u043e\u0436\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c? \u041d\u0430\u043f\u044d\u045e\u043d\u0430 \u045e \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u043d\u0456 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e. \u0422\u0430\u043c\u0443 \u045e\u0441\u0451, \u0448\u0442\u043e \u043b\u044e\u0434\u0441\u043a\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430\u0435 \u043f\u0430\u0434\u0447\u0430\u0441 \u0434\u0430\u0440\u043e\u0433\u0456, \u0411\u043e\u0436\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u0443 \u0430\u0439\u0447\u044b\u043d\u0435. \u041d\u0430 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0443\u0431\u043e\u0433\u0456\u0445 \u0411\u043e\u0433 \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0433\u043e\u043b\u0430\u0434 \u0456 \u0445\u043e\u043b\u0430\u0434, \u044f\u043a \u0441\u0430\u043c \u043a\u0430\u0436\u0430: &laquo;\u0422\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0430\u0434\u043d\u0430\u043c\u0443 \u0437 \u0433\u044d\u0442\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u041c\u0430\u0456\u0445 \u043c\u0435\u043d\u0448\u044b\u0445, \u0432\u044b \u041c\u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0456&raquo; (\u041c\u0446 25, 40). \u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u045e \u043d\u0435\u0431\u0435 \u0445\u043e\u0447\u0430 \u0434\u0430\u0432\u0430\u0446\u044c, \u0445\u043e\u0447\u0430 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0456\u044f \u0436 \u043c\u044b? \u041a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0434\u0430\u0435, \u043c\u044b \u043f\u0440\u044b\u043c\u0430\u0435\u043c \u0430\u0445\u0432\u043e\u0442\u043d\u0430, \u0430 \u043a\u0430\u043b\u0456 \u043f\u0440\u043e\u0441\u0456\u0446\u044c, \u043c\u044b \u043d\u0435 \u0445\u043e\u0447\u0430\u043c \u0434\u0430\u0446\u044c! \u041a\u0430\u043b\u0456 \u045e\u0431\u043e\u0433\u0456 \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0433\u043e\u043b\u0430\u0434, \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u043f\u0430\u0442\u0440\u044d\u0431\u0435, \u044f\u043a \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u0430\u043c \u043a\u0430\u0436\u0430: &laquo;\u042f \u0431\u044b\u045e \u0433\u0430\u043b\u043e\u0434\u043d\u044b, \u0456 \u0432\u044b \u043d\u0435 \u0434\u0430\u043b\u0456 \u041c\u043d\u0435 \u0435\u0441\u0446\u0456&raquo; (\u041c\u0446 25, 42). \u0422\u0430\u043c\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u044c \u043d\u044f\u0447\u0443\u043b\u044b\u043c \u0434\u0430 \u043f\u0430\u0442\u0440\u044d\u0431\u0430\u045e \u0443\u0431\u043e\u0433\u0456\u0445, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0433\u043d\u0435\u0448 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0433\u0430\u043b\u043e\u0434\u043d\u044b, \u0431\u0440\u0430\u0442\u044b! \u0412\u0430 \u045e\u0441\u0456\u0445 \u0443\u0431\u043e\u0433\u0456\u0445 \u043f\u0440\u0430\u0433\u043d\u0435 \u0456 \u0441\u043c\u0430\u0433\u043d\u0435, \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u0443 \u043d\u0435\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u044b\u0442\u0430\u044e \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b: \u0447\u0430\u0433\u043e \u0445\u043e\u0447\u0430\u0446\u0435 \u0456 \u0447\u0430\u0433\u043e \u0448\u0443\u043a\u0430\u0435\u0446\u0435, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0435 \u045e \u043a\u0430\u0441\u0446\u0451\u043b? \u041d\u0430\u043f\u044d\u045e\u043d\u0430, \u043d\u0456\u0447\u043e\u0433\u0430 \u0456\u043d\u0448\u0430\u0433\u0430, \u044f\u043a \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0443 \u043d\u0435\u0431\u0435. \u0423\u0431\u043e\u0433\u0456 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0437 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u0439 \u0434\u0430 \u0446\u044f\u0431\u0435. \u0422\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u043e\u0441\u0456\u0448 \u0411\u043e\u0433\u0430. \u0401\u043d \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u043a\u0430\u0432\u0430\u043b\u0430\u043a \u0445\u043b\u0435\u0431\u0430, \u0430 \u0442\u044b &minus; \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u0414\u0430\u0439 \u0443\u0431\u043e\u0433\u0430\u043c\u0443, \u0456 \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u0448 \u043d\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u044b: &laquo;\u0414\u0430\u0432\u0430\u0439\u0446\u0435, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u0430\u043c&raquo; (\u041b\u043a 6, 38). \u041d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u044e, \u044f\u043a \u0442\u044b \u043c\u043e\u0433 \u0431\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c, \u043a\u0430\u043b\u0456 \u0441\u0430\u043c \u043d\u0435 \u0445\u043e\u0447\u0430\u0448 \u0434\u0430\u0440\u0430\u0432\u0430\u0446\u044c. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0435 \u045e \u043a\u0430\u0441\u0446\u0451\u043b, \u0430\u0445\u0432\u044f\u0440\u0443\u0439\u0446\u0435 \u045e\u0431\u043e\u0433\u0456\u043c \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0456\u0445 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 6, 36. 37\u0441-38\u0430; \u041c\u0446 5, 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456, \u044f\u043a \u0456 \u0410\u0439\u0446\u0435\u0446 \u0432\u0430\u0448 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b.<span style=\"color: #ff0000;\"> *<\/span> \u041f\u0440\u0430\u0431\u0430\u0447\u0430\u0439\u0446\u0435, \u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u0430\u0446\u044c \u0432\u0430\u043c; \u0434\u0430\u0432\u0430\u0439\u0446\u0435, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u044f, \u0431\u043e \u044f\u043d\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u0431\u0430\u0447\u0430\u0439\u0446\u0435, \u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u0430\u0446\u044c \u0432\u0430\u043c; \u0434\u0430\u0432\u0430\u0439\u0446\u0435, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"173","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u0411\u0430\u0437\u044b\u043b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 6 De caritate, 3. 6: PG 31, 266-267. 275)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u0435\u0439\u0446\u0435 \u0437\u0435\u0440\u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u044c \u044f\u043a \u0437\u044f\u043c\u043b\u044f, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u043b\u043e\u0434, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u044c \u0433\u043e\u0440\u0448\u044b \u0437\u0430 \u043d\u0435\u0430\u0434\u0443\u0448\u0430\u045e\u043b\u0451\u043d\u043d\u0443\u044e \u0440\u044d\u0447. \u0417\u044f\u043c\u043b\u044f \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u043b\u043e\u0434 \u043d\u0435 \u0434\u043b\u044f \u0441\u0432\u0430\u0451\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u0430\u043b\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0442\u0430\u0431\u0435. \u0422\u044b \u0436 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0437\u0431\u0456\u0440\u0430\u0435\u0448 \u043f\u043b\u0451\u043d \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u043d\u0430\u0441\u0446\u0456. \u0411\u043e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0456 \u043f\u043b\u0430\u0442\u0430 \u0437\u0430 \u0434\u043e\u0431\u0440\u044b\u044f \u0447\u044b\u043d\u044b \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0456\u0445 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e. \u041a\u0430\u043b\u0456 \u0442\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0433 \u0433\u0430\u043b\u043e\u0434\u043d\u0430\u043c\u0443, \u0442\u0432\u0430\u0456\u043c \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u044b \u0430\u0434\u0434\u0430\u045e, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0446\u044f\u0431\u0435 \u0437 \u043b\u0456\u0448\u043a\u0430\u043c. \u0422\u0430\u043a \u044f\u043a \u0437\u0435\u0440\u043d\u0435, \u043a\u0456\u043d\u0443\u0442\u0430\u0435 \u045e \u0437\u044f\u043c\u043b\u044e, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0441\u0435\u0439\u0431\u0456\u0442\u0443, \u0442\u0430\u043a \u0456 \u0445\u043b\u0435\u0431, \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b \u0433\u0430\u043b\u043e\u0434\u043d\u0430\u043c\u0443, \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0442\u0430\u0431\u0435 \u0448\u043c\u0430\u0442 \u043a\u0430\u0440\u044b\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0435 \u0442\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0446\u044b \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u0430\u0433\u0430 \u043f\u0430\u0441\u0435\u0432\u0443 \u045e \u043d\u0435\u0431\u0435. \u0411\u043e \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0401\u043d \u043f\u0440\u0430\u043b\u0456\u045e \u043d\u0430 \u0432\u0430\u0441 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c&raquo; (\u041e\u0441 10, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0441\u0442\u0430\u043d\u0435 \u0447\u0430\u0441, \u043a\u0430\u043b\u0456 \u043f\u0430\u043a\u0456\u043d\u0435\u0448 \u0433\u0440\u043e\u0448\u044b, \u0445\u043e\u0446\u044c \u0431\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e. \u0410 \u0434\u0430 \u041f\u0430\u043d\u0430 \u043f\u0430\u043d\u044f\u0441\u0435\u0448 \u0445\u0432\u0430\u043b\u0443 \u0441\u0432\u0430\u0456\u0445 \u0434\u043e\u0431\u0440\u044b\u0445 \u0447\u044b\u043d\u0430\u045e. \u0406 \u0442\u0430\u0434\u044b \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434, \u0441\u0442\u043e\u044f\u0447\u044b \u0432\u0430\u043a\u043e\u043b \u0446\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0421\u0443\u0434\u0434\u0437\u0451\u044e \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443, \u043d\u0430\u0437\u0430\u0432\u0435 \u0446\u044f\u0431\u0435 \u043a\u0430\u0440\u043c\u0456\u043b\u044c\u0446\u0430\u043c, \u043b\u0430\u0441\u043a\u0430\u0432\u044b\u043c \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0435\u043c, \u043d\u0430\u0437\u0430\u0432\u0435 \u045e\u0441\u0456\u043c\u0456 \u0456\u043c\u0451\u043d\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0441\u043b\u0430\u0432\u044f\u0446\u044c \u0442\u0432\u0430\u044e \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u0430\u0441\u0446\u044c. \u0426\u0456 \u0436 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0448, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0456\u044f, \u0445\u0442\u043e \u0432\u044b\u0434\u0430\u0442\u043a\u043e\u045e\u0432\u0430\u0435 \u045e\u0441\u0435 \u0441\u0440\u043e\u0434\u043a\u0456 \u043d\u0430 \u0432\u0456\u0434\u043e\u0432\u0456\u0448\u0447\u044b, \u043a\u0430\u043c\u0435\u0434\u044b\u044f\u043d\u0442\u0430\u045e, \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0431\u0430\u0440\u0446\u043e\u045e, \u0431\u0430\u0456 \u0441\u0430 \u0437\u0432\u044f\u0440\u0430\u043c\u0456, \u0441\u0430\u043c \u0432\u044b\u0433\u043b\u044f\u0434 \u044f\u043a\u0456\u0445 \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u0430\u0433\u0456\u0434\u0443? \u0420\u043e\u0431\u044f\u0446\u044c \u0433\u044d\u0442\u0430 \u0434\u043b\u044f \u043c\u0456\u043c\u0430\u043b\u0451\u0442\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b, \u0434\u043b\u044f \u043a\u0440\u044b\u043a\u0443 \u043d\u0430\u0442\u043e\u045e\u043f\u0443 \u0456 \u0430\u043f\u043b\u0430\u0434\u044b\u0441\u043c\u0435\u043d\u0442\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0442\u044b, \u0446\u0456 \u0436 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043a\u0443\u043f\u044b\u043c \u0443 \u0432\u044b\u0434\u0430\u0442\u043a\u0430\u0445, \u044f\u043a\u0456\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0442\u0430\u0431\u0435 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0445\u0432\u0430\u043b\u0443? \u0421\u0430\u043c \u0411\u043e\u0433 \u0443\u0437\u0432\u044b\u0441\u0456\u0446\u044c \u0446\u044f\u0431\u0435, \u043f\u0430\u0445\u0432\u0430\u043b\u044f\u0446\u044c \u0430\u043d\u0451\u043b\u044b, \u0443\u0441\u0435 \u043b\u044e\u0434\u0437\u0456, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0432\u0435\u0442\u0443, \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u0446\u044f\u0431\u0435 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c. \u0412\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0437\u0430 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0435 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0437\u044f\u043c\u043d\u044b\u043c\u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448 \u0432\u0435\u0447\u043d\u0443\u044e \u0445\u0432\u0430\u043b\u0443, \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0410\u043b\u0435 \u0442\u044b \u043d\u0435 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0448\u0441\u044f \u043f\u0440\u0430 \u0442\u0430\u043a\u0456\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b; \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435\u0448 \u0442\u044b\u043c\u0456, \u044f\u043a\u0456\u044f \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u0432\u0430\u0435 \u0442\u0430\u0431\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435, \u044f\u043a\u043e\u0435 \u0446\u044f\u043f\u0435\u0440 \u043c\u0430\u0435\u0448. \u0410 \u043f\u0430\u0441\u043b\u044f \u0440\u0430\u0437\u0434\u0430\u0439 \u0441\u0432\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0456, \u0431\u0443\u0434\u0437\u044c \u0448\u0447\u043e\u0434\u0440\u044b\u043c \u0456 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u044b\u043c, \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u044e\u0447\u044b \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u043c. \u041d\u044f\u0445\u0430\u0439 \u0456 \u043f\u0440\u0430 \u0446\u044f\u0431\u0435 \u043a\u0430\u0436\u0443\u0446\u044c: &laquo;\u0420\u0430\u0441\u043a\u0456\u0434\u0430\u045e, \u0440\u0430\u0437\u0434\u0430\u045e \u0431\u0435\u0434\u043d\u044b\u043c; \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u044f\u0433\u043e\u043d\u0430\u044f \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456&raquo; (\u041f\u0441 112 [111], 9).<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0436\u0430 \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0443\u0434\u0437\u044f\u0447\u043d\u044b \u0448\u0447\u043e\u0434\u0440\u0430\u043c\u0443 \u0414\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u0446\u0443, \u044f\u043a \u0436\u0430 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0456 \u0431\u044b\u0446\u044c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0430\u043a\u0430\u0437\u0430\u043d\u0430\u0439 \u0442\u0430\u0431\u0435 \u043b\u0430\u0441\u043a\u0456. \u0411\u043e \u043d\u0435 \u0442\u044b \u0441\u0442\u0443\u043a\u0430\u0435\u0448 \u0443 \u0434\u0437\u0432\u0435\u0440\u044b \u0447\u0443\u0436\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430\u043b\u0435 \u044f\u043d\u044b \u0441\u0442\u0430\u044f\u0446\u044c \u043a\u0430\u043b\u044f \u0442\u0432\u0430\u0456\u0445 \u0434\u0437\u0432\u044f\u0440\u044d\u0439. \u0410 \u0442\u044b \u0441\u0443\u043c\u043d\u044b \u0456 \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u044b. \u041f\u0430\u0437\u0431\u044f\u0433\u0430\u0435\u0448 \u0441\u0443\u0441\u0442\u0440\u044d\u0447\u044b, \u043a\u0430\u0431 \u0432\u044b\u043f\u0430\u0434\u043a\u0430\u043c \u043d\u0435 \u0437\u0433\u0443\u0431\u0456\u0446\u044c \u0447\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u0456. \u0422\u044b \u045e\u043c\u0435\u0435\u0448 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043d\u043e: &laquo;\u041d\u0435 \u043c\u0430\u044e, \u043d\u0435 \u0434\u0430\u043c, \u044f \u0441\u0430\u043c \u0431\u0435\u0434\u043d\u044b&raquo;. \u041e \u0442\u0430\u043a, \u0442\u044b \u0431\u0435\u0434\u043d\u044b \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0435 \u043c\u0430\u0435\u0448 \u043d\u0456\u0447\u043e\u0433\u0430: \u043d\u0435 \u043c\u0430\u0435\u0448 \u043b\u044e\u0431\u043e\u0432\u0456, \u043d\u0435 \u043c\u0430\u0435\u0448 \u0434\u0430\u0431\u0440\u044b\u043d\u0456, \u043d\u0435 \u043c\u0430\u0435\u0448 \u0432\u0435\u0440\u044b \u045e \u0411\u043e\u0433\u0430 \u0456 \u0432\u0435\u0447\u043d\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 58, 7-8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0437\u044f\u043b\u0456\u0441\u044f \u0437 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u043c \u0445\u043b\u0435\u0431\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u043f\u0443\u0441\u043a\u0430\u0439 \u0443 \u0434\u043e\u043c \u0431\u0435\u0434\u043d\u044b\u0445 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0430\u045e; <span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u0434\u044b \u0437\u0430\u0437\u0437\u044f\u0435, \u044f\u043a \u0437\u043e\u043b\u0430\u043a, \u0441\u0432\u044f\u0442\u043b\u043e \u0442\u0432\u0430\u0451, \u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0442\u0432\u0430\u044f \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u043f\u0440\u0430\u043d\u0456 \u0433\u043e\u043b\u0430\u0433\u0430, \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0448, \u0456 \u0430\u0434 \u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u0445\u0430\u0432\u0430\u0439\u0441\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u0434\u044b \u0437\u0430\u0437\u0437\u044f\u0435, \u044f\u043a \u0437\u043e\u043b\u0430\u043a, \u0441\u0432\u044f\u0442\u043b\u043e \u0442\u0432\u0430\u0451, \u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0442\u0432\u0430\u044f \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e.<\/p>\r\n"}, {"GCH_CH_2_ID":"174","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0442\u044d\u0445\u0435\u0437\u0430 \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cat. 18, 23-25: PG 33, 1043-1047)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0430\u0441\u0446\u0451\u043b &minus; \u0441\u0445\u043e\u0434 \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456\u043c, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u044b\u043c, \u0431\u043e \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 &ndash; \u0430\u0434 \u0430\u0434\u043d\u0430\u0433\u043e \u043a\u0430\u043d\u0446\u0430 \u0430\u0436 \u0434\u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u0430. \u0422\u0430\u043a \u0437\u0430\u0432\u0435\u0446\u0446\u0430, \u0431\u043e \u0446\u0430\u043b\u043a\u0430\u043c \u0456 \u0431\u0435\u0437 \u043f\u0430\u043c\u044b\u043b\u0430\u043a \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0443 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0430\u0447\u043d\u0430\u0435 \u0456 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435, \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0456 \u0437\u044f\u043c\u043d\u043e\u0435, \u0431\u043e \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u043c\u0456 \u043a\u0456\u0440\u0443\u044e\u0446\u044c \u0456 \u044f\u043a\u0456\u044f \u043a\u0456\u0440\u0443\u044e\u0446\u044c, \u0432\u0443\u0447\u043e\u043d\u044b\u0445 \u0456 \u043f\u0440\u043e\u0441\u0442\u044b\u0445, \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u043d\u0430\u043b\u0435\u0436\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0411\u043e\u0433\u0430; \u0431\u043e \u043b\u0435\u0447\u044b\u0446\u044c \u0443\u0441\u0435 \u0432\u0456\u0434\u044b \u0433\u0440\u0430\u0445\u043e\u045e \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0430\u0435 \u045e\u0441\u0435 \u0432\u0456\u0434\u044b \u0446\u043d\u043e\u0442\u0430\u045e, \u044f\u043a\u0456\u044f \u0432\u044b\u0440\u0430\u0436\u0430\u044e\u0446\u0446\u0430 \u044f\u043a \u0443 \u0441\u043b\u043e\u0432\u0430\u0445, \u0442\u0430\u043a \u0456 \u045e \u0447\u044b\u043d\u0430\u0445, \u0456 \u045e\u0440\u044d\u0448\u0446\u0435 \u045e\u0441\u0435 \u0432\u0456\u0434\u044b \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u0445 \u0434\u0430\u0440\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043c\u0430 \u043d\u0430\u0437\u0432\u0430 &laquo;\u041a\u0430\u0441\u0446\u0451\u043b&raquo;, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0441\u0445\u043e\u0434, \u0432\u0435\u043b\u044c\u043c\u0456 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u044f, \u0431\u043e \u0451\u043d &laquo;\u0441\u043a\u043b\u0456\u043a\u0430\u0435&raquo; \u0456 \u0437\u0431\u0456\u0440\u0430\u0435 \u045e \u0430\u0434\u043d\u043e \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043a\u0430\u0436\u0430 \u0411\u043e\u0433 \u0443 \u043a\u043d\u0456\u0437\u0435 \u041b\u0435\u0432\u0456\u0442\u0430: &laquo;\u0417\u0431\u044f\u0440\u044b \u045e\u0441\u044e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043f\u0440\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0435 \u045e \u0448\u0430\u0446\u0451\u0440 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044f&raquo; (\u041b\u0435\u0432 8, 3). \u0412\u0430\u0440\u0442\u0430 \u0430\u0434\u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0441\u043b\u043e\u0432\u0430 &laquo;\u0437\u0431\u044f\u0440\u044b&raquo; \u043f\u0435\u0440\u0448\u044b \u0440\u0430\u0437 \u0431\u044b\u043b\u043e \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043d\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0443\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0456\u0432\u0430\u045e \u0410\u0430\u0440\u043e\u043d\u0430 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c. \u0410 \u045e \u043a\u043d\u0456\u0437\u0435 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0411\u043e\u0433 \u043a\u0430\u0436\u0430 \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0417\u0431\u044f\u0440\u044b \u041c\u043d\u0435 \u043d\u0430\u0440\u043e\u0434, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0447\u0443\u0435 \u041c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b, \u043a\u0430\u0431 \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u041c\u044f\u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430&raquo; (\u043f\u0430\u0440. \u0414\u0440\u0433 4, 10). \u041a\u0430\u0436\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b, \u043a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0442\u0430\u0431\u043b\u0456\u0446\u044b: &laquo;\u041d\u0430 \u0456\u0445 \u0431\u044b\u043b\u0456 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u045e\u0441\u0435 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0432\u0430\u043c \u0411\u043e\u0433 \u043d\u0430 \u0433\u0430\u0440\u044b, \u0441\u044f\u0440\u043e\u0434 \u0430\u0433\u043d\u044e, \u0443 \u0434\u0437\u0435\u043d\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0430&raquo; (\u043f\u0430\u0440. \u0414\u0440\u0433 10, 4), \u043a\u0430\u0436\u0443\u0447\u044b \u0431\u043e\u043b\u044c\u0448 \u0432\u044b\u0440\u0430\u0437\u043d\u0430: &laquo;\u0443 \u0434\u0437\u0435\u043d\u044c, \u0443 \u044f\u043a\u0456\u043c \u0432\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u041f\u0430\u043d\u0430\u043c \u043d\u0430 \u0441\u0445\u043e\u0434&raquo;. \u0406 \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u043b\u0456\u0447\u0430: &laquo;\u042f \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435 \u043d\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0441\u0445\u043e\u0434\u0437\u0435, \u0431\u0443\u0434\u0443 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0446\u044c \u0426\u044f\u0431\u0435 \u0441\u044f\u0440\u043e\u0434 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443&raquo; (\u041f\u0441 35 [34], 18).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442 \u0441\u043f\u044f\u0432\u0430\u045e: &laquo;\u0421\u043b\u0430\u045e\u0446\u0435 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0441\u0445\u043e\u0434\u0437\u0435, \u0432\u044b, \u0445\u0442\u043e \u0437 \u0432\u044b\u0442\u043e\u043a\u0430\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f&raquo; (\u041f\u0441 68 [67], 27). \u0417\u0431\u0430\u045e\u0446\u0430 \u0441\u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0440\u0443\u0433\u0456 \u0441\u0445\u043e\u0434, \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0441\u0432\u044f\u0442\u044b, \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b, \u043f\u0440\u0430 \u044f\u043a\u0456 \u043a\u0430\u0437\u0430\u045e \u041f\u044f\u0442\u0440\u0443: &laquo;\u041d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0441\u043a\u0430\u043b\u0435 \u042f \u043f\u0430\u0431\u0443\u0434\u0443\u044e \u041a\u0430\u0441\u0446\u0451\u043b \u041c\u043e\u0439, \u0456 \u0431\u0440\u0430\u043c\u044b \u043f\u044f\u043a\u0435\u043b\u044c\u043d\u044b\u044f \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443\u0446\u044c \u044f\u0433\u043e&raquo; (\u041c\u0446 16, 18). \u041f\u0430\u0441\u043b\u044f \u0430\u0434\u043a\u0456\u0434\u0432\u0430\u043d\u043d\u044f \u0442\u0430\u0433\u043e, \u044f\u043a\u0456 \u0431\u044b\u045e \u0443 \u042e\u0434\u044d\u0456, \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u044b \u043f\u0430\u0448\u044b\u0440\u044b\u043b\u0456\u0441\u044f \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435. \u0427\u044b\u0442\u0430\u0435\u043c \u043f\u0440\u0430 \u0456\u0445 \u0443 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u0445: &laquo;\u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0443 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e, \u0445\u0432\u0430\u043b\u0430 \u042f\u043c\u0443 \u043d\u0430 \u0441\u0445\u043e\u0434\u0437\u0435 \u0441\u0432\u044f\u0442\u044b\u0445&raquo; (\u041f\u0441 149, 1). \u0410 \u0433\u0430\u0431\u0440\u044d\u044f\u043c \u043f\u0440\u0430\u0440\u043e\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0435: &laquo;\u041d\u0435 \u043c\u0430\u044e \u045e \u0432\u0430\u0441 \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b&raquo; \u0456 \u0434\u0430\u0434\u0430\u0435: &laquo;\u0422\u0430\u043c\u0443 \u0430\u0434 \u0443\u0441\u0445\u043e\u0434\u0443 \u0441\u043e\u043d\u0446\u0430 \u0430\u0436 \u0434\u0430 \u044f\u0433\u043e \u0437\u0430\u0445\u0430\u0434\u0443 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430 \u0406\u043c\u044f \u043c\u0430\u0451 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e&raquo;. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u044b \u0441\u0432\u044f\u0442\u044b \u0456 \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u043f\u0456\u0448\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b \u0434\u0430 \u0426\u0456\u043c\u0430\u0444\u0435\u044f: &laquo;\u041f\u0456\u0448\u0443 \u0442\u0430\u0431\u0435, \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u045e \u0434\u043e\u043c\u0435 \u0411\u043e\u0436\u044b\u043c, \u044f\u043a\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0436\u044b\u0432\u043e\u0433\u0430 \u0411\u043e\u0433\u0430, \u0441\u0442\u0430\u045e\u043f\u043e\u043c \u0456 \u0430\u043f\u0456\u0440\u044b\u0448\u0447\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u044b&raquo; (\u043f\u0430\u0440. 1 \u0426\u0456\u043c 3, 14-15).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 2, 9-10\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u0436 &ndash; \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u0440\u043e\u0434, \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0446\u043d\u043e\u0442\u044b \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u0437 \u0446\u0435\u043c\u0440\u044b \u045e \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435 \u0441\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u0435 \u043d\u0430\u0440\u043e\u0434, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043d\u0430\u0440\u043e\u0434 \u0411\u043e\u0436\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0446\u043d\u043e\u0442\u044b \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u0437 \u0446\u0435\u043c\u0440\u044b \u045e \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435 \u0441\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"175","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0442\u044d\u0445\u0435\u0437\u0430 \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cat. 18, 26-29: PG 33, 1047-1050)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0430\u0441\u0446\u0451\u043b &ndash; \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b&raquo; &minus; \u0432\u043e\u0441\u044c \u0442\u0430\u043a\u043e\u0435 \u0456\u043c\u044f \u0441\u0432\u044f\u0442\u043e\u0439 \u0456 \u043c\u0430\u0446\u0456 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043d\u0430\u0441. \u042f\u043d\u0430 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0431\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;&hellip; \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u041a\u0430\u0441\u0446\u0451\u043b \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u044f\u0433\u043e&raquo; (\u042d\u0444 5, 25). \u0401\u0441\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0456 \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435\u043c &laquo;\u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u0448\u0442\u043e \u045e\u0433\u0430\u0440\u044b, \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0433\u0430, \u0451\u043d &ndash; \u043d\u0430\u0448\u0430\u044f \u043c\u0430\u0446\u0456&raquo; (\u043f\u0430\u0440. \u0413\u0430\u043b 4, 26). \u0414\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u044f, \u0446\u044f\u043f\u0435\u0440 \u043c\u0430\u0446\u0456 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0430\u0433\u0430 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u043f\u0435\u0440\u0448\u0443\u044e \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0443, \u0443 \u0434\u0440\u0443\u0433\u043e\u0439, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443 \u041a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, &laquo;\u0430\u0434\u043d\u044b\u0445 \u0411\u043e\u0433 \u043f\u0430\u0441\u0442\u0430\u0432i\u045e \u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u043d\u0430\u0439\u043f\u0435\u0440\u0448 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043ci, \u0434\u0440\u0443\u0433\u0456\u0445 &ndash; \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043ci, \u0442\u0440\u044d\u0446i\u0445 &ndash; \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456, \u043f\u043e\u0442\u044b\u043c \u0434\u0430\u045e \u043c\u043e\u0446, \u043f\u043e\u0442\u044b\u043c &ndash; \u0434\u0430\u0440\u044b \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456, \u043a\u0456\u0440\u0430\u0432\u0430\u043d\u043d\u044f, \u0440\u043e\u0437\u043d\u044b\u044f \u043c\u043e\u0432\u044b&raquo; (1 \u041a\u0430\u0440 12, 28), \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0440\u043e\u0434\u0443 \u0446\u043d\u043e\u0442\u044b: \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0440\u043e\u0437\u0443\u043c, \u0443\u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u044c, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0434\u0430\u0431\u0440\u044b\u043d\u044e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u044f\u0437\u043b\u043e\u043c\u043d\u0443\u044e \u0441\u044f\u0440\u043e\u0434 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u043f\u0440\u0430\u0437 \u0437\u0431\u0440\u043e\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043a\u0443\u044e \u0442\u0440\u044b\u043c\u0430\u0435 \u045e \u043f\u0440\u0430\u0432\u0430\u0439 \u0456 \u043b\u0435\u0432\u0430\u0439 \u0440\u0443\u0446\u0446\u044d, \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u0448\u0430\u043d\u044b \u0456 \u0433\u0430\u043d\u044c\u0431\u044b \u045e \u0447\u0430\u0441\u044b \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443 \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u0443\u0432\u044f\u043d\u0447\u0430\u045e \u0441\u0432\u044f\u0442\u044b\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u043a\u0430\u0440\u043e\u043d\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0443\u0447\u044b\u043d\u0435\u043d\u0430\u0439 \u0437 \u043c\u043d\u043e\u0433\u0456\u0445 \u0456 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u0445 \u043a\u0432\u0435\u0442\u0430\u043a. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430, \u0443 \u0447\u0430\u0441 \u0441\u043f\u0430\u043a\u043e\u044e, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456 \u0411\u043e\u0433\u0430 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043d\u0430\u043b\u0435\u0436\u043d\u0443\u044e \u0445\u0432\u0430\u043b\u0443 \u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0456 \u045e\u043b\u0430\u0434\u0430\u0440\u043e\u045e, \u0430\u0434 \u043b\u044e\u0434\u0437\u0435\u0439 \u0443\u0441\u0456\u0445 \u0441\u0442\u0430\u043d\u0430\u045e \u0456 \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u041a\u0430\u0440\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a\u0456\u044f \u0436\u044b\u0432\u0443\u0446\u044c \u0443 \u0440\u043e\u0437\u043d\u044b\u0445 \u043a\u0440\u0430\u0456\u043d\u0430\u0445, \u043c\u0430\u044e\u0446\u044c \u0430\u0431\u043c\u0435\u0436\u0430\u0432\u0430\u043d\u0443\u044e \u045e\u043b\u0430\u0434\u0443. \u0410\u0434\u043d\u0430\u043c\u0443 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0432\u044f\u0442\u043e\u043c\u0443, \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0443\u043b\u0430\u0434\u0430, \u044f\u043a\u0430\u044f \u0440\u0430\u0441\u043f\u0430\u0441\u0446\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u0430\u0436 \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456. \u0411\u043e \u0411\u043e\u0433, &ndash; \u044f\u043a \u0447\u044b\u0442\u0430\u0435\u043c, &ndash; &laquo;\u0443\u0441\u0442\u0430\u043b\u0451\u045e\u0432\u0430\u0435 \u0441\u043f\u0430\u043a\u043e\u0439 \u043d\u0430 \u044f\u0433\u043e \u043c\u0435\u0436\u0430\u0445&raquo; (\u043f\u0430\u0440. \u041f\u0441 147, 14).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0436, \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u0441\u0432\u044f\u0442\u044b\u043c \u0456 \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u043c\u0456, \u044f\u043a \u0456 \u0441\u043b\u0430\u045e\u043d\u044b\u043c\u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c\u0456, \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c\u0456 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0422\u0430\u043c\u0443, \u043a\u0430\u0431 \u0433\u044d\u0442\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0430\u0434 \u041f\u0430\u043d\u0430, \u043c\u044b \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b. \u041c\u044d\u0442\u0430, \u0434\u0430 \u044f\u043a\u043e\u0439 \u043c\u044b \u0456\u043c\u043a\u043d\u0435\u043c\u0441\u044f, \u043c\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0432\u0430\u0433\u0443, \u0431\u043e \u043c\u044b \u0456\u043c\u043a\u043d\u0451\u043c\u0441\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u0422\u0430\u043c\u0443 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u0432\u0435\u0440\u044b \u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441, \u0448\u0442\u043e \u0430\u043f\u0440\u0430\u0447\u0430 &laquo;\u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u0446\u0435\u043b\u0430&raquo;, \u043f\u0440\u0430 \u0448\u0442\u043e \u043c\u044b \u043a\u0430\u0437\u0430\u043b\u0456 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u0435\u0440\u044b\u0446\u044c \u0443 &laquo;\u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435&raquo;. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0434\u0430 \u044f\u0433\u043e \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0410\u0439\u0446\u0435\u0446. \u0401\u043d \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u045e\u0441\u0456\u043c, \u0431\u044b\u0446\u0446\u0430\u043c \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0434\u0430\u0440\u044b \u043f\u0440\u0430\u0437 \u0421\u044b\u043d\u0430 \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u0423 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0401\u043d \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0430\u0431\u044f\u0446\u0430\u045e \u043d\u0430\u043c \u0448\u0447\u0430\u0441\u0446\u0435 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041f\u0441 33 (32), 12<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u043f\u0430\u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u043a\u0430\u0436\u0443\u0447\u044b: <span style=\"color: #ff0000;\">*<\/span> \u0422\u044b, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0441\u043f\u0440\u0430\u0432\u0430 \u041c\u0430\u0456\u0445 \u0440\u0443\u043a \u0456 \u041c\u0430\u044f \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u043d\u0430\u0440\u043e\u0434, \u0411\u043e\u0433\u0430\u043c \u044f\u043a\u043e\u0433\u0430 \u0451\u0441\u0446\u044c \u041f\u0430\u043d, \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0401\u043d \u0432\u044b\u0431\u0440\u0430\u045e \u0441\u0430\u0431\u0435 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0441\u043f\u0440\u0430\u0432\u0430 \u041c\u0430\u0456\u0445 \u0440\u0443\u043a \u0456 \u041c\u0430\u044f \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"176","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u041f\u0430\u043b\u0456\u043a\u0430\u0440\u043f\u0430&raquo; \u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Inscriptio; nn. 1, 1 &minus; 4, 3: Funk 1, 247-249)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u045e\u0441\u0451 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0401\u043d \u043d\u0430\u0441 \u043f\u0440\u044b\u043d\u044f\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0406\u0433\u043d\u0430\u0446\u044b\u0439, \u043d\u0430\u0437\u044b\u0432\u0430\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0422\u044d\u0430\u0444\u0430\u043d\u0430\u043c, \u041f\u0430\u043b\u0456\u043a\u0430\u0440\u043f\u0443, \u044f\u043a\u0456 \u0441\u0446\u0435\u0440\u0430\u0436\u044d \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0421\u043c\u0456\u0440\u043d\u0435, \u0430 \u0431\u043e\u043b\u044c\u0448, \u044f\u043a\u043e\u0433\u0430 \u0441\u0446\u0435\u0440\u0430\u0436\u044d \u0411\u043e\u0433 \u0410\u0439\u0446\u0435\u0446 \u0456 \u041f\u0430\u043d \u043d\u0430\u0448 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, &ndash; \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0432\u0456\u043d\u0448\u0430\u0432\u0430\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u043f\u0440\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u0442\u0432\u0430\u0451\u0439 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u0430\u0439 \u044f\u043a \u0431\u044b \u043d\u0430 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u0439 \u0441\u043a\u0430\u043b\u0435, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e \u0411\u043e\u0433\u0430, \u0448\u0442\u043e \u044f \u0441\u0442\u0430\u045e \u0433\u043e\u0434\u043d\u044b\u043c \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0442\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043e\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u043a\u0430\u0431 \u044f \u043c\u043e\u0433 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0456\u043c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e \u0411\u043e\u0433\u0443. \u0417\u0430\u043a\u043b\u0456\u043d\u0430\u044e \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443, \u0443 \u044f\u043a\u0443\u044e \u0442\u044b \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b, &ndash; \u043f\u0430\u0441\u043a\u043e\u0440 \u0441\u0432\u043e\u0439 \u0431\u0435\u0433 \u0456 \u043f\u0440\u0430\u0437 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u0435 \u045e\u0441\u0456\u043c \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456. \u0410\u043a\u0430\u0436\u044b \u0432\u0435\u043b\u0456\u0447 \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u0441\u043b\u0443\u0433\u0456 \u043f\u0440\u0430\u0437 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b \u043a\u043b\u043e\u043f\u0430\u0442 \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u0430. \u0406\u043c\u043a\u043d\u0456\u0441\u044f \u0434\u0430 \u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u043f\u0430-\u043d\u0430\u0434 \u044f\u043a\u043e\u0439 \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430. \u0423\u043c\u0435\u0439 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0443\u0441\u0456\u0445, \u044f\u043a \u0456 \u041f\u0430\u043d \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0446\u044f\u0431\u0435. \u041f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u0443\u0441\u0456\u0445 \u0437 \u043b\u044e\u0431\u043e\u045e\u044e, \u044f\u043a \u0434\u0430\u0440\u044d\u0447\u044b, \u0456 \u0447\u044b\u043d\u0456\u0448. \u041d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0432\u0430\u0439 \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u043f\u0440\u0430\u0441\u0456 \u0430\u0431 \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. \u0411\u0443\u0434\u0437\u044c \u0447\u0443\u0439\u043d\u044b, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0446\u0432\u044f\u0440\u043e\u0437\u044b\u043c \u0441\u0432\u043e\u0439 \u0440\u043e\u0437\u0443\u043c. \u041f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0439 \u0434\u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0430\u0430\u0441\u043e\u0431\u043a\u0443 \u043d\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0441\u0430\u043c\u043e\u0433\u0430 \u0411\u043e\u0433\u0430. \u041d\u0430\u0441\u0456 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u045e\u0441\u0456\u0445 \u044f\u043a \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0430\u0442\u043b\u0435\u0442. \u0414\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430\u0446\u044b, \u0442\u0430\u043c \u0456 \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u044b\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043b\u044e\u0431\u0456\u0448 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043e\u0431\u0440\u044b\u0445 \u0432\u0443\u0447\u043d\u044f\u045e, \u043d\u0435 \u043c\u0430\u0435\u0448 \u0437\u0430\u0441\u043b\u0443\u0433\u0456. \u0417\u0434\u0430\u0431\u044b\u0432\u0430\u0439 \u0441\u0432\u0430\u0451\u0439 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e \u0431\u043e\u043b\u044c\u0448 \u0442\u044b\u0445, \u0448\u0442\u043e \u045e\u043f\u0430\u043b\u0456. \u041d\u0435 \u043a\u043e\u0436\u043d\u0430\u044f \u0440\u0430\u043d\u0430 \u043b\u0435\u0447\u044b\u0446\u0446\u0430 \u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u043b\u0435\u043a\u0430\u043c. \u0413\u0432\u0430\u043b\u0442\u043e\u045e\u043d\u044b\u044f \u0432\u044b\u0431\u0443\u0445\u0456 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0441\u043b\u043e\u0434\u044b\u0447\u0447\u0443. &laquo;\u0412\u0430 \u045e\u0441\u0456\u043c \u0431\u0443\u0434\u0437\u044c \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b, \u044f\u043a \u0437\u043c\u0435\u0456, \u0456 \u043f\u0440\u043e\u0441\u0442\u044b, \u044f\u043a \u0433\u0430\u043b\u0443\u0431\u044b&raquo; (\u043f\u0430\u0440. \u041c\u0446 10, 16). \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443 \u0442\u044b \u0456\u0441\u0442\u043e\u0442\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u044f \u0456 \u0434\u0443\u0445\u043e\u0432\u0430\u044f, \u0442\u0430\u043c\u0443 \u0437 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e \u0441\u0442\u0430\u045e\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u0448. \u041a\u0430\u043b\u0456 \u043c\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0430\u0447\u043d\u0430\u0435, \u043f\u0440\u0430\u0441\u0456 \u0430\u0431 \u043d\u0430\u043b\u0435\u0436\u043d\u044b\u043c \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456, \u043a\u0430\u0431 \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u043c\u0435\u045e \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443, \u0430\u043b\u0435 \u043c\u0435\u045e \u0448\u0447\u043e\u0434\u0440\u044b \u0432\u044f\u043b\u0456\u043a\u0456 \u0434\u0430\u0440. \u042f\u043a \u0441\u0442\u044b\u0440\u043d\u0430\u0432\u044b \u0447\u0430\u043a\u0430\u0435 \u0432\u0435\u0442\u0440\u0443, \u0430 \u043c\u0430\u0440\u0430\u043a, \u044f\u043a\u043e\u0433\u0430 \u043a\u0456\u0434\u0430\u0435 \u0431\u0443\u0440\u0430, &minus; \u043f\u043e\u0440\u0442\u0443, \u0442\u0430\u043a \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u044f \u0445\u0432\u0456\u043b\u0456\u043d\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u0442\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0442\u0432\u0430\u0456\u043c\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430. \u0411\u0443\u0434\u0437\u044c \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u043c \u044f\u043a \u0411\u043e\u0436\u044b \u0437\u043c\u0430\u0433\u0430\u0440; \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u043f\u0440\u0430 \u0448\u0442\u043e \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0435\u0448. \u0417\u0430 \u0446\u044f\u0431\u0435 \u044f \u0430\u0445\u0432\u044f\u0440\u0443\u044e \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0456 \u043a\u0430\u0439\u0434\u0430\u043d\u044b, \u044f\u043a\u0456\u043c \u0442\u044b \u0430\u043a\u0430\u0437\u0430\u045e \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0448\u0430\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0442\u0440\u044b\u0432\u043e\u0436\u0430\u0446\u0446\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u0433\u043e\u0434\u043d\u044b\u043c \u0432\u0435\u0440\u044b, \u0430\u043b\u0435 \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0446\u044c \u043f\u0430\u043c\u044b\u043b\u043a\u043e\u0432\u0430. \u0411\u0443\u0434\u0437\u044c \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u044b\u043c \u044f\u043a \u043a\u0430\u0432\u0430\u043b\u044c\u043d\u044f \u043f\u0430\u0434 \u0443\u0434\u0430\u0440\u0430\u043c \u043c\u043e\u043b\u0430\u0442\u0430. \u041c\u0443\u0436\u043d\u0430\u0441\u0446\u044c \u0437\u043c\u0430\u0433\u0430\u0440\u0430 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0451\u043d \u0443\u043c\u0435\u0435 \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u043a\u0440\u044b\u045e\u0434\u044b \u0456 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0446\u044c. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0431\u043e\u043b\u044c\u0448 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u045e\u0441\u0451 \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0456 \u0401\u043d \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430\u0441. \u0421\u0442\u0430\u043d\u0430\u0432\u0456\u0441\u044f \u0431\u043e\u043b\u044c\u0448 \u0440\u0443\u043f\u043b\u0456\u0432\u044b\u043c; \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0439 \u0434\u0430\u0434\u0437\u0435\u043d\u0443\u044e \u0445\u0432\u0456\u043b\u0456\u043d\u0443. \u0427\u0430\u043a\u0430\u0439 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0451\u0441\u0446\u044c \u043f\u0430-\u0437\u0430 \u0447\u0430\u0441\u0430\u043c, \u0445\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u0435\u0447\u043d\u044b\u043c \u0456 \u043d\u044f\u0431\u0430\u0447\u043d\u044b\u043c, \u0456 \u044f\u043a\u0456 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441 \u0441\u0442\u0430\u045e\u0441\u044f \u0431\u0430\u0447\u043d\u044b\u043c, \u044f\u043a\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435\u043d\u0430\u043c\u0430\u0446\u0430\u043b\u044c\u043d\u044b\u043c, \u044f\u043a\u0456 \u043d\u0435 \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044e, \u0430\u043b\u0435 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441 \u043f\u0440\u044b\u043d\u044f\u045e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435, \u0456 \u044f\u043a\u0456 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u045e \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u043f\u0430\u043a\u0443\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0434\u043e\u0432\u044b \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u043d\u044b\u044f. \u041f\u0430\u0441\u043b\u044f \u0411\u043e\u0433\u0430 \u0442\u044b \u0431\u0443\u0434\u0437\u044c \u0456\u0445 \u0430\u043f\u0435\u043a\u0443\u043d\u043e\u043c. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0448\u0442\u043e \u043d\u0435 \u0434\u0437\u0435\u0435\u0446\u0446\u0430 \u0431\u0435\u0437 \u0442\u0432\u0430\u0451\u0439 \u0437\u0433\u043e\u0434\u044b \u0456 \u0442\u044b \u043d\u0435 \u0447\u044b\u043d\u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u0435\u0437 \u0411\u043e\u0433\u0430, \u044f\u043a, \u0434\u0430\u0440\u044d\u0447\u044b, \u0456 \u043d\u0435 \u0447\u044b\u043d\u0456\u0448. \u0411\u0443\u0434\u0437\u044c \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u044b. \u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u044b\u044f \u0441\u0445\u043e\u0434\u044b \u0430\u0434\u0431\u044b\u0432\u0430\u044e\u0446\u0446\u0430 \u0447\u0430\u0441\u0446\u0435\u0439. \u0417\u0430\u043f\u0440\u0430\u0448\u0430\u0439 \u0443\u0441\u0456\u0445 \u043f\u0430-\u0456\u043c\u0435\u043d\u0456. \u041d\u0435 \u0431\u0443\u0434\u0437\u044c \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u044b \u0434\u0430 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e, \u0436\u0430\u043d\u0447\u044b\u043d \u0446\u0456 \u043c\u0443\u0436\u0447\u044b\u043d, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u044f\u043d\u044b \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u044b\u043c\u0456, \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u043d\u044f\u0445\u0430\u0439 \u043b\u0435\u043f\u0448 \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u044f\u043d\u044b \u043c\u0430\u0433\u043b\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0430\u0434 \u042f\u0433\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0443\u044e \u0441\u0432\u0430\u0431\u043e\u0434\u0443. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u044f \u043d\u0430 \u043a\u043e\u0448\u0442 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u043d\u0435 \u0441\u0442\u0430\u043b\u0456 \u044f\u043d\u044b \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u0426\u0456\u043c 6, 11b-12\u0430; 2 \u0426\u0456\u043c 2, 10\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406\u043c\u043a\u043d\u0456\u0441\u044f \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0432\u0435\u0440\u044b, \u043b\u044e\u0431\u043e\u0432\u0456, \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0417\u043c\u0430\u0433\u0430\u0439\u0441\u044f \u0434\u043e\u0431\u0440\u044b\u043c \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435\u043c \u0432\u0435\u0440\u044b, \u0442\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u045e\u0441\u0451 \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e \u0434\u0437\u0435\u043b\u044f \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445, \u043a\u0430\u0431 \u0456 \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u043c\u0430\u0433\u0430\u0439\u0441\u044f \u0434\u043e\u0431\u0440\u044b\u043c \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435\u043c \u0432\u0435\u0440\u044b, \u0442\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"177","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u041f\u0430\u043b\u0456\u043a\u0430\u0440\u043f\u0430&raquo; \u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 5, 1 &minus; 8, 1. 3: Funk 1, 249-253)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0451 \u0434\u0437\u0435\u0435\u0446\u0446\u0430 \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0436\u0430\u0439 \u0445\u0432\u0430\u043b\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0437\u0431\u044f\u0433\u0430\u0439 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u0437 \u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456, \u0434\u044b \u0456 \u0456\u043d\u0448\u044b\u0445 \u043f\u0435\u0440\u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0439. \u0416\u0430\u043d\u0447\u044b\u043d\u0430\u043c, \u0441\u0451\u0441\u0442\u0440\u0430\u043c \u043c\u0430\u0456\u043c, \u0441\u043a\u0430\u0436\u044b, \u043a\u0430\u0431 \u043b\u044e\u0431\u0456\u043b\u0456 \u041f\u0430\u043d\u0430 \u0456 \u0431\u044b\u043b\u0456 \u0432\u0435\u0440\u043d\u044b\u044f \u0441\u0432\u0430\u0456\u043c \u043c\u0443\u0436\u0430\u043c \u0446\u0435\u043b\u0430\u043c \u0456 \u0434\u0443\u0448\u043e\u044e. \u0406 \u0431\u0440\u0430\u0442\u0430\u043c \u043c\u0430\u0456\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u0439 \u0443 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430, &laquo;\u043a\u0430\u0431 \u044f\u043d\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0441\u0432\u0430\u0456\u0445 \u0436\u043e\u043d\u0430\u043a, \u044f\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u041a\u0430\u0441\u0446\u0451\u043b&raquo; (\u043f\u0430\u0440. \u042d\u0444 5, 25). \u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u045e\u043c\u0435\u0435 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u0446\u0435\u043b\u0430 \u041f\u0430\u043d\u0430, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u044b\u043c \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430, \u0443\u043f\u0430\u0434\u0437\u0435; \u043a\u0430\u043b\u0456 \u043b\u0456\u0447\u044b\u0446\u044c \u0441\u044f\u0431\u0435 \u0431\u043e\u043b\u044c\u0448 \u0433\u043e\u0434\u043d\u044b\u043c \u0437\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u0430, \u0437\u0433\u0456\u043d\u0435. \u0412\u044b\u043f\u0430\u0434\u0430\u0435, \u043a\u0430\u0431 \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0456 \u0441\u0443\u0436\u044d\u043d\u0441\u0442\u0432\u0430 \u0437 \u0432\u0435\u0434\u0430\u043d\u043d\u044f \u0431\u0456\u0441\u043a\u0443\u043f\u0430, \u043a\u0430\u0431 \u0441\u0443\u0436\u044d\u043d\u0441\u0442\u0432\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u043e\u043b\u0456 \u041f\u0430\u043d\u0430, \u0430 \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0451 \u0434\u0437\u0435\u0435\u0446\u0446\u0430 \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0436\u0430\u0439 \u0445\u0432\u0430\u043b\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u045e \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u0456 \u0437 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c, \u043a\u0430\u0431 \u0456 \u0411\u043e\u0433 \u0431\u044b\u045e \u0437 \u0432\u0430\u043c\u0456. \u0421\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0430\u0445\u0432\u044f\u0440\u0443\u044e \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u0431\u0456\u0441\u043a\u0443\u043f\u0443, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u043c, \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u043c; \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456 \u043c\u0435\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u0411\u043e\u0433\u0443. \u0421\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u0447\u0430\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0437 \u0434\u0440\u0443\u0433\u0456\u043c, \u0440\u0430\u0437\u0430\u043c \u0437\u043c\u0430\u0433\u0430\u0439\u0446\u0435\u0441\u044f, \u0440\u0430\u0437\u0430\u043c \u0431\u044f\u0436\u044b\u0446\u0435, \u0440\u0430\u0437\u0430\u043c \u0437\u043d\u043e\u0441\u044c\u0446\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u0440\u0430\u0437\u0430\u043c \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0439\u0446\u0435 \u044f\u043a \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u043c, \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u043a\u0430\u043c \u0456 \u0441\u043b\u0443\u0433\u0430\u043c \u0411\u043e\u0433\u0430. \u0421\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u0442\u0430\u043c\u0443, \u0434\u0437\u0435\u043b\u044f \u043a\u0430\u0433\u043e \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0435\u0441\u044f \u0456 \u0430\u0434 \u043a\u0430\u0433\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u043f\u043b\u0430\u0442\u0443. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0437\u0434\u0440\u0430\u0434\u043d\u0456\u043a\u0430. \u041d\u044f\u0445\u0430\u0439 \u0445\u0440\u043e\u0441\u0442 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u0448\u044b\u043c \u0448\u0447\u044b\u0442\u043e\u043c, \u0432\u0435\u0440\u0430 &ndash; \u0448\u043b\u0435\u043c\u0430\u043c, \u043b\u044e\u0431\u043e\u045e &ndash; \u0434\u0437\u0456\u0434\u0430\u044e, \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c &ndash; \u0437\u0431\u0440\u043e\u044f\u0439. \u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u044b\u044f \u0434\u043e\u0431\u0440\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u0448\u044b\u043c \u0441\u043a\u0430\u0440\u0431\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u043c\u0435\u043b\u0456 \u043f\u0440\u0430\u0432\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u0430\u043b\u0435\u0436\u043d\u0430\u0435 \u0432\u0430\u043c. \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u043f\u043e\u045e\u043d\u044b\u044f \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u0430\u0434\u043d\u044b \u0434\u0430 \u0434\u0440\u0443\u0433\u0456\u0445, \u044f\u043a \u0456 \u0411\u043e\u0433 \u043b\u0430\u0433\u043e\u0434\u043d\u044b \u0434\u0430 \u0432\u0430\u0441. \u041a\u0430\u0431 \u0432\u044b \u0431\u044b\u043b\u0456 \u043c\u0430\u0456\u043c \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u044b\u043c \u0433\u043e\u043d\u0430\u0440\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 &ndash; \u044f\u043a \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u043b\u0456 \u043c\u043d\u0435 &ndash; \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0421\u0456\u0440\u044b\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0430\u0448\u044b\u043c \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0441\u043f\u0430\u043a\u043e\u0435\u043c, \u0442\u0430\u043c\u0443 \u0456 \u044f \u0431\u043e\u043b\u044c\u0448 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b \u045e \u0441\u0432\u0430\u0456\u043c \u0434\u0430\u0432\u0435\u0440\u044b \u0432\u043e\u043b\u0456 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435 \u044f \u043c\u043e\u0433 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0441\u0442\u0430\u0446\u044c \u0432\u0430\u0448\u044b\u043c \u0432\u0443\u0447\u043d\u0435\u043c \u0443 \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f. \u0422\u0440\u044d\u0431\u0430, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u045e \u0411\u043e\u0433\u0443 \u041f\u0430\u043b\u0456\u043a\u0430\u0440\u043f\u0435, \u0441\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0448\u0430\u043d\u043e\u045e\u043d\u044b \u0441\u0445\u043e\u0434 \u0456 \u0432\u044b\u0431\u0440\u0430\u0446\u044c \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u0432\u0430\u043c \u0434\u0430\u0440\u0430\u0433\u043e\u0433\u0430 \u0456 \u0430\u0434\u0434\u0430\u043d\u0430\u0433\u0430, \u0445\u0442\u043e \u043c\u043e\u0433 \u0431\u044b \u0431\u044b\u0446\u044c \u0411\u043e\u0436\u044b\u043c \u0432\u044b\u0441\u043b\u0430\u043d\u043d\u0456\u043a\u0430\u043c. \u041d\u044f\u0445\u0430\u0439 \u043f\u043e\u0439\u0434\u0437\u0435 \u045e \u0421\u0456\u0440\u044b\u044e, \u043a\u0430\u0431 \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0436\u0430\u0439 \u0445\u0432\u0430\u043b\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0432\u0430\u0448\u0443\u044e \u0431\u044f\u0441\u0441\u0442\u0440\u0430\u0448\u043d\u0443\u044e \u043b\u044e\u0431\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d \u043d\u0435 \u0436\u044b\u0432\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043d\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 \u045e \u0411\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u0435 \u0433\u044d\u0442\u0430, \u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0433\u044d\u0442\u0430 \u0441\u043f\u0440\u0430\u0432\u0430\u0439 \u0411\u043e\u0433\u0430 \u0456 \u0432\u0430\u0448\u0430\u0439. \u0421\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u0433\u043e \u043b\u0430\u0441\u0446\u044b \u0432\u044b \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0434\u043e\u0431\u0440\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u043d\u0430 \u0411\u043e\u0436\u0443\u044e \u0445\u0432\u0430\u043b\u0443. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f \u0432\u0435\u0434\u0430\u044e \u0432\u0430\u0448\u044b\u044f \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0437\u0430 \u043f\u0440\u0430\u045e\u0434\u0443, \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u044e \u0432\u0430\u043c \u043a\u0430\u0440\u043e\u0442\u043a\u0456\u044f \u0441\u043b\u043e\u0432\u044b \u0437\u0430\u0430\u0445\u0432\u043e\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043d\u0435 \u043c\u043e\u0433 \u043d\u0430\u043f\u0456\u0441\u0430\u0446\u044c \u0443\u0441\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c, \u0431\u043e \u0441\u043f\u044f\u0448\u0430\u045e\u0441\u044f \u0430\u0434\u043f\u043b\u044b\u0446\u044c \u0437 \u0422\u0440\u0430\u0430\u0434\u044b \u045e \u041d\u0435\u0430\u043f\u0430\u043b\u044c, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0442\u0430\u043a\u043e\u0435 \u0437\u0430\u0434\u0430\u043d\u043d\u0435. \u0422\u044b \u0436 \u0432\u0435\u0434\u0430\u0435\u0448 \u0432\u043e\u043b\u044e \u0411\u043e\u0433\u0430, \u0442\u0430\u043c\u0443 \u043d\u0430\u043f\u0456\u0448\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c, \u0448\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u043d\u0430 \u0423\u0441\u0445\u043e\u0434\u0437\u0435, \u043a\u0430\u0431 \u044f\u043d\u044b, \u043a\u0430\u043b\u0456 \u0437\u043c\u043e\u0433\u0443\u0446\u044c, \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435: \u043d\u044f\u0445\u0430\u0439 \u0432\u044b\u0448\u043b\u044e\u0446\u044c \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456\u043a\u0430\u045e, \u0456\u043d\u0448\u044b\u044f \u043d\u044f\u0445\u0430\u0439 \u0432\u044b\u0448\u043b\u044e\u0446\u044c \u043b\u0456\u0441\u0442\u044b \u043f\u0440\u0430\u0437 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0442\u044b \u043f\u0430\u0448\u043b\u0435\u0448, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0445\u0432\u0430\u043b\u0443 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u043a\u0430\u043f\u043e\u043c\u043d\u0430\u043c\u0443 \u0447\u044b\u043d\u0443, \u0447\u0430\u0433\u043e \u0442\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u0430\u0440\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0416\u0430\u0434\u0430\u044e \u0432\u0430\u043c \u043f\u043e\u0441\u043f\u0435\u0445\u0443 \u045e \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u044b\u043c \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435. \u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u0442\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u045e \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u0430\u043f\u0435\u0446\u044b \u0411\u043e\u0433\u0430. \u0411\u044b\u0432\u0430\u0439\u0446\u0435 \u045e \u041f\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 15, 58; 2 \u0422\u044d\u0441 3, 13<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u043e\u0446\u043d\u044b\u043c\u0456, \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u044b\u043c\u0456, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0434\u0434\u0430\u043d\u044b\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0435 \u041f\u0430\u043d\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0432\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u043d\u0435 \u0434\u0430\u0440\u044d\u043c\u043d\u0430\u044f \u043f\u0440\u0430\u0446\u0430 \u0432\u0430\u0448\u0430 \u045e \u041f\u0430\u043d\u0443. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0432\u0430\u0439\u0446\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u043d\u0435 \u0434\u0430\u0440\u044d\u043c\u043d\u0430\u044f \u043f\u0440\u0430\u0446\u0430 \u0432\u0430\u0448\u0430 \u045e \u041f\u0430\u043d\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"181","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u00ab\u041b\u0456\u0441\u0442\u0430\u00bb, \u0448\u0442\u043e \u043f\u0440\u044b\u043f\u0456\u0441\u0432\u0430\u0435\u0446\u0446\u0430 \u0411\u0430\u0440\u043d\u0430\u0431\u0435&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 1, 1-8; 2, 1-5: Funk 1, 3-7)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0430\u0434\u0437\u0435\u044f \u0436\u044b\u0446\u0446\u044f \u2013 \u0433\u044d\u0442\u0430 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0456 \u043a\u0430\u043d\u0435\u0446 \u043d\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u044b<\/span><\/p>\r\n<p style=\"text-indent: 28.35pt; text-align: justify;\"><span>\u0412\u0456\u0442\u0430\u044e \u0432\u0430\u0441, \u0441\u044b\u043d\u044b \u0456 \u0434\u043e\u0447\u043a\u0456, \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u2013 \u0441\u043f\u0430\u043a\u043e\u0439 \u0432\u0430\u043c!<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u042f\u043a\u0456\u044f \u0436 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0456 \u0448\u0447\u043e\u0434\u0440\u044b\u044f \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b, \u0448\u0442\u043e \u0443\u0447\u044b\u043d\u0456\u045e \u0432\u0430\u043c \u0411\u043e\u0433. \u0422\u0430\u043c\u0443 \u0432\u0430\u0448\u044b\u044f \u0441\u0432\u044f\u0442\u044b\u044f \u0456 \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b\u044f \u0434\u0443\u0448\u044b \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0446\u044c \u043c\u044f\u043d\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0431\u043e \u0432\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043f\u0440\u044b\u0448\u0447\u044d\u043f\u043b\u0435\u043d\u0443\u044e \u0432\u0430\u043c \u043b\u0430\u0441\u043a\u0443, \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0434\u0430\u0440. \u0420\u0430\u0434\u0443\u044e\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u0434\u0437\u0435\u0456 \u043d\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0431\u043e \u0431\u0430\u0447\u0443 \u0414\u0443\u0445\u0430, \u0448\u0442\u043e \u043f\u0440\u0430\u043b\u0456\u045e\u0441\u044f \u043d\u0430 \u0432\u0430\u0441 \u0437 \u043d\u0430\u0439\u0431\u0430\u0433\u0430\u0446\u0435\u0439\u0448\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u041f\u0430\u043d\u0430. \u042f \u0432\u0435\u043b\u044c\u043c\u0456 \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u044e\u0441\u044f \u0432\u0430\u0448\u0430\u0439 \u043f\u0430\u0441\u0442\u0430\u0432\u0430\u0439, \u044f\u043a\u043e\u0439 \u044f \u0442\u0430\u043a \u0447\u0430\u043a\u0430\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 26.95pt; text-align: justify;\"><span>\u0422\u0430\u043a, \u044f \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b \u045e \u0433\u044d\u0442\u044b\u043c \u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u0433\u044d\u0442\u0430 \u045e\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u044e, \u0431\u043e \u0447\u0430\u0441\u0442\u0430 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0434\u0430 \u0432\u0430\u0441. \u041f\u0430\u043d \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u045e \u043c\u043d\u0435 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0448\u043b\u044f\u0445\u0443. \u0406 \u0433\u044d\u0442\u0430 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0432\u044b\u043a\u043b\u0456\u043a, \u043a\u0430\u0431 \u043b\u044e\u0431\u0456\u0446\u044c \u0432\u0430\u0441 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0441\u044f\u0431\u0435. \u0423 \u0432\u0430\u0441 \u0436\u044b\u0432\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f \u0432\u0435\u0440\u0430 \u0456 \u043b\u044e\u0431\u043e\u045e \u043f\u0440\u0430\u0437 \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u0412\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0443 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u0446\u0446\u0430 \u0437 \u0432\u0430\u043c\u0456 \u0442\u044b\u043c, \u0448\u0442\u043e \u0441\u0430\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u045e, \u0456 \u0448\u0442\u043e \u043c\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u043f\u0430\u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0442\u0430\u043a\u0456\u043c, \u044f\u043a \u0432\u044b, \u044f \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u043a\u043e\u0440\u0430\u0442\u043a\u0430 \u043d\u0430\u043f\u0456\u0441\u0430\u0446\u044c \u0432\u0430\u043c, \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0435\u0440\u0430\u0439 \u0432\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0435\u043b\u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u044f \u0432\u0435\u0434\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 26.95pt; text-align: justify;\"><span>\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0442\u0440\u043e\u043c \u0440\u044d\u0447\u0430\u043c \u0432\u0443\u0447\u044b\u0446\u044c \u041f\u0430\u043d: \u043d\u0430\u0434\u0437\u0435\u0456 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u0456 \u043a\u0430\u043d\u0446\u043e\u043c \u043d\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u044b; \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u0456 \u043a\u0430\u043d\u0446\u043e\u043c \u0441\u0443\u0434\u0430; \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0430\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c \u0456 \u043f\u043e\u045e\u043d\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u044e \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0447\u044b\u043d\u0430\u045e. \u041f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u041f\u0430\u043d \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u043d\u0430\u043c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043c\u0456\u043d\u0443\u043b\u044b\u044f \u0456 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456\u044f \u0440\u044d\u0447\u044b, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0430\u0434\u0447\u0443\u0446\u044c \u0441\u043c\u0430\u043a \u0431\u0443\u0434\u0443\u0447\u044b\u0445. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u0431\u0430\u0447\u044b\u043c, \u0448\u0442\u043e \u045e\u0441\u0451 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u0430\u0433\u0430 \u043f\u0430\u0440\u0430\u0434\u043a\u0443, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u043e\u043b\u044c\u0448 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u043a\u0440\u043e\u0447\u044b\u0446\u044c \u0448\u043b\u044f\u0445\u0430\u043c \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0436\u0430\u0439. \u042f \u0436 \u043d\u0435 \u044f\u043a \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a, \u0430\u043b\u0435 \u044f\u043a \u0432\u0430\u0448 \u0431\u0440\u0430\u0442, \u0434\u0430\u043c \u0432\u0430\u043c \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0456, \u043a\u0430\u0431 \u0432\u044b \u043c\u0430\u0433\u043b\u0456 \u0441\u0451\u043d\u043d\u044f \u0447\u044d\u0440\u043f\u0430\u0446\u044c \u0437 \u0456\u0445 \u0430\u0434\u0432\u0430\u0433\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 26.95pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0441\u0442\u0430\u043b\u0456 \u0441\u0443\u043c\u043d\u044b\u044f \u0434\u043d\u0456 \u0456 \u0432\u043e\u0440\u0430\u0433 \u043d\u0435 \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0435, \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0447\u0443\u0432\u0430\u0446\u044c \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0411\u043e\u0436\u0443\u044e \u0432\u043e\u043b\u044e. \u041d\u0430\u0448\u0443\u044e \u0432\u0435\u0440\u0443 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0431\u043e\u044f\u0437\u044c \u0456 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c, \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u045e\u0441\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0435. \u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u044b\u044f \u0446\u043d\u043e\u0442\u044b \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u0446\u0430 \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u044b\u043c\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u0442\u0430\u0434\u044b \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0434\u0430\u043b\u0443\u0447\u0430\u0446\u0446\u0430 \u0434\u0430 \u0456\u0445 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435, \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0456 \u0432\u0435\u0434\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 26.95pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0437 \u0443\u0441\u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0431\u044b\u043b\u043e \u043d\u0430\u043c \u0430\u0431\u2019\u044f\u045e\u043b\u0435\u043d\u0430, \u0448\u0442\u043e \u041f\u0430\u043d \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0445\u0432\u044f\u0440\u0430\u045e, \u0443\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f\u045e \u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u045e, \u0431\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u041c\u043d\u0435 \u0432\u0430\u0448\u044b\u044f \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0430\u0445\u0432\u044f\u0440\u044b? \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 \u042f \u0441\u044b\u0442\u044b \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f\u043c\u0456 \u0456 \u0442\u043b\u0443\u0448\u0447\u0443 \u0431\u0430\u0440\u0430\u043d\u043e\u045e, \u043a\u0440\u044b\u0432\u0456 \u0446\u044f\u043b\u044f\u0442 \u0456 \u043a\u0430\u0437\u043b\u043e\u045e \u042f \u043d\u0435 \u0445\u0430\u0447\u0443. \u0425\u0442\u043e \u043f\u0440\u043e\u0441\u0456\u0446\u044c, \u043a\u0430\u0431 \u0432\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u043b\u0456\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u041c\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0456 \u0442\u0430\u043f\u0442\u0430\u043b\u0456 \u041c\u0430\u0435 \u043f\u0430\u043d\u0430\u0434\u0432\u043e\u0440\u043a\u0456? \u041d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u044c\u0446\u0435 \u0431\u043e\u043b\u044c\u0448 \u043c\u0430\u0440\u043d\u044b\u0445 \u0430\u0445\u0432\u044f\u0440\u0430\u045e, \u043a\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u045e \u041c\u044f\u043d\u0435 \u0430\u0433\u0456\u0434\u0443. \u0421\u0432\u044f\u0442\u0430\u045e \u043c\u0430\u043b\u0430\u0434\u0437\u0456\u043a\u0430, \u0448\u0430\u0431\u0430\u0442\u0443 \u0456 \u0441\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0441\u0445\u043e\u0434\u0430\u045e \u042f \u043d\u0435 \u043c\u0430\u0433\u0443 \u0437\u043d\u0435\u0441\u0446\u0456\u00bb (\u043f\u0440\u0430. \u0406\u0441 1, 11-13).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0413\u0430\u043b 2, 16; \u0411\u044b\u0446 15, 6&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043c\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u0431 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u0432\u0435\u0440\u044b\u045e \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u041f\u0430\u043d\u0443, \u0456 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u0430 \u044f\u043c\u0443 \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041c\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"182","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u00ab\u041b\u0456\u0441\u0442\u0430\u00bb, \u0448\u0442\u043e \u043f\u0440\u044b\u043f\u0456\u0441\u0432\u0430\u0435\u0446\u0446\u0430 \u0411\u0430\u0440\u043d\u0430\u0431\u0435&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 2, 6-10; 3, 1. 3; 4, 10-14: Funk 1, 7-9. 13)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u043e\u0432\u044b \u0417\u0430\u043a\u043e\u043d \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e\u0433 \u0430\u0434\u043a\u0456\u043d\u0443\u045e \u0434\u0430\u045e\u043d\u0456\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u043a\u0430\u0431 \u043d\u043e\u0432\u044b \u0417\u0430\u043a\u043e\u043d \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u044f\u0440\u043c\u0430 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0441\u0446\u0456, \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0445\u0432\u044f\u0440\u0443, \u044f\u043a\u0430\u044f \u0431 \u043d\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0411\u043e \u0401\u043d \u043a\u0430\u0436\u0430 \u0433\u0430\u0431\u0440\u044d\u044f\u043c: \u00ab\u0426\u0456 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e \u042f \u0432\u0430\u0448\u044b\u043c \u043f\u0440\u043e\u0434\u043a\u0430\u043c, \u043a\u0430\u043b\u0456 \u0432\u044b\u0432\u0435\u045e \u0456\u0445 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u041c\u043d\u0435 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0456 \u0456 \u0430\u0445\u0432\u044f\u0440\u044b? \u042f \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0456\u043c: \u201c\u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0435 \u0437\u043b\u043e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430; \u043d\u0435 \u0456\u043c\u043a\u043d\u0456\u0446\u0435\u0441\u044f \u0434\u0430 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u0445 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u045e\u201d\u00bb (\u043f\u0430\u0440. \u0415\u0440 7, 22-23).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u043d\u0430\u043c\u0435\u0440 \u043d\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0431\u043e \u043c\u044b \u0436 \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f. \u0401\u043d \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0434\u0430 \u043d\u0430\u0441, \u0431\u043e \u043d\u0435 \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u043c\u044b, \u0456\u043c\u043a\u043d\u0443\u0447\u044b\u0441\u044f \u0434\u0430 \u042f\u0433\u043e, \u0431\u043b\u0443\u043a\u0430\u043b\u0456 \u044f\u043a \u0442\u044b\u044f. \u0401\u043d \u0442\u0430\u043a \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0434\u0430 \u043d\u0430\u0441: \u00ab\u0410\u0445\u0432\u044f\u0440\u0430 \u0411\u043e\u0433\u0443 \u2013 \u0433\u044d\u0442\u0430 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b \u0434\u0443\u0445; \u0441\u044d\u0440\u0446\u0430, \u044f\u043a\u043e\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f, \u2013 \u0433\u044d\u0442\u0430 \u0432\u043e\u0434\u0430\u0440 \u0434\u043b\u044f \u041f\u0430\u043d\u0430\u00bb (\u043f\u0430\u0440. \u041f\u0441 51 [50], 19). \u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u043d\u0430\u043c, \u0431\u0440\u0430\u0442\u044b, \u0440\u0443\u043f\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0432\u0451\u045e \u043d\u0430\u0441 \u0432\u043e\u0440\u0430\u0433 \u0456 \u043c\u044b \u043d\u0435 \u0430\u0434\u0434\u0430\u043b\u0456\u043b\u0456\u0441\u044f \u0430\u0434 \u043d\u0430\u0448\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406\u043c \u0436\u0430, \u0433\u0430\u0431\u0440\u044d\u044f\u043c, \u0401\u043d \u0437\u043d\u043e\u045e \u043a\u0430\u0436\u0430: \u00ab\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u043f\u0430\u0441\u0446\u0456\u0446\u0435 \u0434\u043b\u044f \u041c\u044f\u043d\u0435, \u044f\u043a \u0441\u0451\u043d\u043d\u044f, \u043a\u0430\u0431 \u0431\u044b\u045e \u0447\u0443\u0442\u043d\u044b \u0432\u0430\u0448 \u0433\u043e\u043b\u0430\u0441 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445? \u0425\u0456\u0431\u0430 \u0442\u0430\u043a\u0456 \u042f \u0432\u044b\u0431\u0440\u0430\u045e \u043f\u043e\u0441\u0442, \u043a\u0430\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u0442\u0430\u0439\u043c\u043e\u045e\u0432\u0430\u0435 \u0434\u0443\u0448\u0443 \u0441\u0432\u0430\u044e?\u00bb (\u043f\u0430\u0440. \u0406\u0441 58, 4-5). \u041d\u0430\u043c \u0436\u0430 \u043a\u0430\u0436\u0430: \u00ab\u0412\u043e\u0441\u044c \u043f\u043e\u0441\u0442, \u044f\u043a\u0456 \u042f \u0432\u044b\u0431\u0440\u0430\u045e: \u0440\u0430\u0437\u0431\u0456 \u043a\u0430\u0439\u0434\u0430\u043d\u044b \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f, \u0440\u0430\u0437\u0432\u044f\u0436\u044b \u043f\u0443\u0442\u044b \u043d\u044f\u0432\u043e\u043b\u0456, \u0430\u0434\u043f\u0443\u0441\u0446\u0456 \u043d\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u0443 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u0445 \u0456 \u0440\u0430\u0437\u0430\u0440\u0432\u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0443\u044e \u0434\u0430\u043c\u043e\u0432\u0443. \u0414\u0437\u044f\u043b\u0456\u0441\u044f \u0437 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u043c \u0441\u0432\u0430\u0456\u043c \u0445\u043b\u0435\u0431\u0430\u043c, \u0430\u043f\u0440\u0430\u043d\u0456 \u0433\u043e\u043b\u0430\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u045e\u0431\u0430\u0447\u044b\u0448, \u0456 \u043f\u0443\u0441\u0446\u0456 \u045e \u0434\u043e\u043c \u0431\u0435\u0434\u043d\u044b\u0445 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0430\u045e\u00bb (\u043f\u0430\u0440. \u0406\u0441 58, 6-10).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0437\u0431\u044f\u0433\u0430\u0439\u043c\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456, \u0430\u0434\u043a\u0456\u043d\u044c\u043c\u0430 \u045e\u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044b, \u0448\u0442\u043e \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u0437\u043b\u0430. \u041d\u0435 \u0436\u044b\u0432\u0456\u0446\u0435 \u0430\u0434\u0430\u0441\u043e\u0431\u043b\u0435\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0434\u0443\u043c\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0432\u044b \u045e\u0436\u043e \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u044b\u044f, \u0430\u043b\u0435 \u0437\u0431\u0456\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u0440\u0430\u0437\u0430\u043c, \u0456\u043c\u043a\u043d\u0456\u0446\u0435\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043a\u0430\u0440\u044b\u0441\u043d\u0430 \u0434\u043b\u044f \u045e\u0441\u0456\u0445. \u0411\u043e \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u0413\u043e\u0440\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u043b\u0456\u0447\u044b\u0446\u044c \u0441\u044f\u0431\u0435 \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c, \u0445\u0442\u043e \u043c\u0443\u0434\u0440\u044b \u045e \u0441\u0432\u0430\u0456\u0445 \u0432\u0430\u0447\u0430\u0445\u00bb (\u043f\u0430\u0440. \u0406\u0441 5, 21). \u0411\u0443\u0434\u0437\u044c\u043c\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u0441\u0442\u0430\u043d\u044c\u043c\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0411\u043e\u0436\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e\u043c\u0435\u0435\u043c, \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0411\u043e\u0436\u0443\u044e \u0431\u043e\u044f\u0437\u044c \u0456 \u043f\u0430\u0441\u0442\u0430\u0440\u0430\u0435\u043c\u0441\u044f \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0411\u043e\u0436\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u043a\u0430\u0431 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0443 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0456 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456. \u041f\u0430\u043d \u043d\u0435\u043f\u0440\u0430\u0434\u0443\u0437\u044f\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u0435\u0442 (\u043f\u0430\u0440. 1 \u041f 1, 17). \u041a\u043e\u0436\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0437\u0430 \u0441\u0432\u0430\u0435 \u045e\u0447\u044b\u043d\u043a\u0456: \u043a\u0430\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u044f\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c; \u043a\u0430\u043b\u0456 \u0434\u0440\u044d\u043d\u043d\u044b, \u044f\u0433\u043e \u0447\u0430\u043a\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0441\u0456\u045e\u043d\u044b\u043c\u0456, \u043c\u0430\u044e\u0447\u044b \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u043d\u0435, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0431\u0430\u044f\u0446\u0446\u0430 \u0441\u043f\u0430\u0447\u044b\u0446\u044c \u0443 \u0433\u0440\u0430\u0445\u0430\u0445, \u043a\u0430\u0431 \u043a\u043d\u044f\u0437\u044c \u0446\u0435\u043c\u0440\u044b \u043d\u0435 \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u045e \u043d\u0430\u043c\u0456 \u0456 \u043d\u0435 \u0432\u044b\u0440\u0432\u0430\u045e \u043d\u0430\u0441 \u0437 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041f\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0430\u0439\u0446\u0435 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435, \u0431\u0440\u0430\u0442\u044b \u043c\u0430\u0435. \u041a\u0430\u043b\u0456 \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u043a\u0456\u0445 \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0437\u043d\u0430\u043a\u0430\u045e \u0456 \u0446\u0443\u0434\u0430\u045e, \u0448\u0442\u043e \u043c\u0435\u043b\u0456 \u043c\u0435\u0441\u0446\u0430 \u045e \u0406\u0437\u0440\u0430\u044d\u043b\u0456, \u0433\u0430\u0431\u0440\u044d\u0456 \u0431\u044b\u043b\u0456 \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b\u044f, \u0441\u0446\u0435\u0440\u0430\u0436\u044b\u0446\u0435\u0441\u044f, \u043a\u0430\u0431 \u2013 \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u2013 \u043d\u0435 \u0431\u044b\u043b\u043e \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u00ab\u0448\u043c\u0430\u0442 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u0445, \u0430\u043b\u0435 \u043c\u0430\u043b\u0430 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445\u00bb (\u041c\u0446 22, 14).&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0413\u0430\u043b 3, 24-25. 23\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417\u0430\u043a\u043e\u043d \u0441\u0442\u0430\u045e \u043d\u0430\u0448\u044b\u043c \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0430\u043c, \u044f\u043a\u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u043c\u044b \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043b\u0456\u0441\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041a\u0430\u043b\u0456 \u0436 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0432\u0435\u0440\u0430, \u043c\u044b \u045e\u0436\u043e \u043d\u0435\u043f\u0430\u0434\u0443\u043b\u0430\u0434\u043d\u044b\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0435\u0440\u0448 \u0447\u044b\u043c \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0432\u0435\u0440\u0430, \u043c\u044b \u0431\u044b\u043b\u0456 \u0437\u0430\u043c\u043a\u043d\u0451\u043d\u044b\u044f \u043f\u0430\u0434 \u0432\u0430\u0440\u0442\u0430\u044e \u0417\u0430\u043a\u043e\u043d\u0443 \u0434\u0430 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443, \u043a\u0430\u043b\u0456 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u0432\u0435\u0440\u044b. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u043b\u0456 \u0436.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"183","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u00ab\u041b\u0456\u0441\u0442\u0430\u00bb, \u0448\u0442\u043e \u043f\u0440\u044b\u043f\u0456\u0441\u0432\u0430\u0435\u0446\u0446\u0430 \u0411\u0430\u0440\u043d\u0430\u0431\u0435&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 5, 1-8; 6, 11-16: Funk 1, 13-15. 19-21)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u043e\u0432\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0432\u044b\u0434\u0430\u045e \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u043a\u0430\u0431 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u044e \u0433\u0440\u0430\u0445\u043e\u045e \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u043b\u0456\u0446\u0446\u0451 \u042f\u0433\u043e \u043a\u0440\u044b\u0432\u0456. \u041f\u0440\u0430 \u042f\u0433\u043e \u0431\u044b\u043b\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044e \u0456 \u043d\u0430\u043c. \u0412\u043e\u0441\u044c \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435: \u00ab\u0401\u043d \u0437\u0440\u0430\u043d\u0435\u043d\u044b \u0431\u044b\u045e \u0437\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u043d\u0430\u0448\u044b\u044f, \u0440\u0430\u0437\u0434\u0430\u045e\u043b\u0435\u043d\u044b \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u0430\u0432\u0456\u043d\u044b, \u0443 \u0440\u0430\u043d\u0430\u0445 \u044f\u0433\u043e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0434\u0430\u0440\u043e\u045e\u0435. \u042f\u043a \u044f\u0433\u043d\u0451, \u042f\u0433\u043e \u0432\u044f\u043b\u0456 \u043d\u0430 \u0437\u0430\u0440\u044d\u0437, \u044f\u043a \u0430\u0432\u0435\u0447\u043a\u0430 \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0441\u0442\u0440\u044b\u0436\u044d \u044f\u0435, \u0401\u043d \u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u045e \u0432\u0443\u0441\u043d\u0430\u045e \u0441\u0432\u0430\u0456\u0445\u00bb (\u043f\u0430\u0440. \u0406\u0441 53, 5-7). \u0422\u0430\u043c\u0443 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0433\u043e\u0440\u0430\u0447\u0430 \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u041f\u0430\u043d\u0443, \u0448\u0442\u043e \u0401\u043d \u0430\u0431\u2019\u044f\u0432\u0456\u045e \u043d\u0430\u043c \u043c\u0456\u043d\u0443\u043b\u044b\u044f \u0440\u044d\u0447\u044b, \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456\u043c, \u0448\u0442\u043e \u043d\u0430\u0432\u0430\u0442 \u0431\u0443\u0434\u0443\u0447\u044b\u044f \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u0439. \u0411\u043e \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435: \u00ab\u041d\u0435 \u0432\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u0430 \u0441\u0442\u0430\u0432\u0456\u0446\u0446\u0430 \u0441\u0456\u043b\u043e \u0434\u043b\u044f \u043f\u0442\u0443\u0448\u0430\u043a\u00bb. \u0413\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0433\u0456\u043d\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e, \u0432\u0435\u0434\u0430\u044e\u0447\u044b \u0448\u043b\u044f\u0445 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0437\u0431\u043e\u0447\u0432\u0430\u0435 \u043d\u0430 \u0448\u043b\u044f\u0445 \u0446\u0435\u043c\u0440\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u044f\u0448\u0447\u044d, \u043c\u0430\u0435 \u0431\u0440\u0430\u0442\u044b. \u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u044f\u043a \u0432\u0430\u043b\u0430\u0434\u0430\u0440 \u0443\u0441\u044f\u0433\u043e \u0456 \u0442\u043e\u0439, \u043a\u0430\u043c\u0443 \u0411\u043e\u0433 \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0430\u0434\u0447\u0430\u0441 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443: \u00ab\u0423\u0447\u044b\u043d\u0456\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041d\u0430\u0448\u0430\u0433\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0456 \u041d\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430\u00bb (\u0411\u044b\u0446 1, 26), \u043d\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u0430 \u043d\u0430\u0441, \u0447\u0430\u043c\u0443 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0430\u0434 \u043b\u044e\u0434\u0437\u0435\u0439? \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435. \u041f\u0440\u0430\u0440\u043e\u043a\u0456, \u044f\u043a\u0456\u044f \u0430\u0434 \u042f\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0433\u044d\u0442\u0443\u044e \u043b\u0430\u0441\u043a\u0443, \u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0440\u0430 \u042f\u0433\u043e. \u0401\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u0446\u0435\u043b\u0435 \u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c, \u043a\u0430\u0431 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u044c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435; \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456, \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u044f \u0430\u0439\u0446\u0430\u043c, \u0440\u044b\u0445\u0442\u0443\u044e\u0447\u044b \u0441\u0430\u0431\u0435 \u043f\u0430\u0434\u0447\u0430\u0441 \u043f\u043e\u0431\u044b\u0442\u0443 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043d\u043e\u0432\u044b \u043d\u0430\u0440\u043e\u0434, \u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c. \u0412\u0443\u0447\u044b\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0446\u0443\u0434\u044b \u0456 \u0437\u043d\u0430\u043a\u0456, \u0445\u043e\u0446\u044c \u0442\u044b\u044f \u043d\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u0432\u0430\u043b\u0456 \u042f\u0433\u043e \u0456 \u043d\u0435 \u043b\u044e\u0431\u0456\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u043d \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e; \u0443\u0447\u044b\u043d\u0456\u045e \u0442\u0430\u043a, \u0448\u0442\u043e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043d\u043e\u0432\u0430\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u043d\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0434\u0443\u0448\u044b \u0434\u0437\u0456\u0446\u044f\u0446\u0456, \u044f\u043a \u0431\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0430\u0441 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u043d\u0430\u043d\u0430\u0432\u0430. \u0413\u044d\u0442\u0430 \u043f\u0440\u0430 \u043d\u0430\u0441 \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u045e \u0441\u043b\u043e\u0432\u0430\u0445 \u0410\u0439\u0446\u0430, \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u0445 \u0434\u0430 \u0421\u044b\u043d\u0430: \u00ab\u0423\u0447\u044b\u043d\u0456\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041d\u0430\u0448\u0430\u0433\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0456 \u041d\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430. \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u043d\u0443\u0435 \u043d\u0430\u0434 \u0440\u044b\u0431\u0430\u043c\u0456 \u043c\u0430\u0440\u0441\u043a\u0456\u043c\u0456, \u043d\u0430\u0434 \u043f\u0442\u0430\u0441\u0442\u0432\u0430\u043c \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c, \u043d\u0430\u0434 \u0436\u044b\u0432\u0451\u043b\u0430\u043c\u0456, \u043d\u0430\u0434 \u0443\u0441\u0451\u044e \u0437\u044f\u043c\u043b\u0451\u044e\u00bb (\u0411\u044b\u0446 1, 26). \u041a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0443\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u043c\u044b \u2013 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041f\u043b\u0430\u0434\u0437\u0456\u0446\u0435\u0441\u044f \u0456 \u0440\u0430\u0437\u043c\u043d\u0430\u0436\u0430\u0439\u0446\u0435\u0441\u044f, \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0439\u0446\u0435 \u0437\u044f\u043c\u043b\u044e\u00bb (\u0411\u044b\u0446 1, 28).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u0421\u044b\u043d\u0443. \u0426\u044f\u043f\u0435\u0440 \u044f \u043f\u0430\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u0401\u043d \u043a\u0430\u0436\u0430 \u043d\u0430\u043c. \u0423 \u0433\u044d\u0442\u044b\u044f \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0447\u0430\u0441\u044b \u0401\u043d \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0434\u0440\u0443\u0433\u043e\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435. \u041f\u0430\u043d \u043a\u0430\u0436\u0430: \u00ab\u0412\u043e\u0441\u044c \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0440\u044d\u0447\u044b \u0437\u0440\u0430\u0431\u043b\u044e \u043f\u0435\u0440\u0448\u044b\u043c\u0456\u00bb. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0430\u0442\u044b\u0447\u044b\u043b\u0430 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430: \u00ab\u0423\u0432\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u045e \u0437\u044f\u043c\u043b\u044e, \u0448\u0442\u043e \u0441\u043e\u0447\u044b\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0456 \u043c\u0451\u0434\u0430\u043c\u00bb (\u043f\u0430\u0440. \u0417\u044b\u0445 33, 3). \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0456\u043d\u0448\u0430\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430, \u043c\u044b \u2013 \u043d\u043e\u0432\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435. \u00ab\u0412\u043e\u0441\u044c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0432\u044b\u043c\u0443 \u0441\u044d\u0440\u0446\u0430 \u043a\u0430\u043c\u0435\u043d\u043d\u0430\u0435 \u0437 \u0456\u0445 \u0446\u0435\u043b\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0437 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043f\u0440\u0430\u0434\u0431\u0430\u0447\u044b\u045e \u0414\u0443\u0445 \u041f\u0430\u043d\u0430, \u0430 \u0434\u0430\u043c \u0456\u043c \u0441\u044d\u0440\u0446\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435\u00bb (\u043f\u0430\u0440. \u042d\u0437\u0445 11, 19). \u0401\u043d \u0441\u0430\u043c \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u0446\u0435\u043b\u0435 \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441. \u0411\u0440\u0430\u0442\u044b \u043c\u0430\u0435, \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 \u045e \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445 \u0440\u043e\u0431\u0456\u0446\u044c \u044f\u0433\u043e \u0447\u044b\u0441\u0442\u0430\u0439 \u0441\u043a\u0456\u043d\u0456\u044f\u0439. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u041f\u0430\u043d \u0437\u043d\u043e\u045e \u043a\u0430\u0436\u0430: \u00ab\u0411\u0443\u0434\u0443 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0456\u043c\u044f \u0422\u0432\u0430\u0451 \u0431\u0440\u0430\u0442\u0430\u043c \u043c\u0430\u0456\u043c, \u043d\u0430 \u0441\u0445\u043e\u0434\u0437\u0435 \u0441\u0432\u044f\u0442\u044b\u0445 \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435\u00bb (\u043f\u0430\u0440. \u041f\u0441 22 [21], 23). \u0413\u044d\u0442\u0430 \u043d\u0430\u0441 \u0401\u043d \u043f\u0440\u044b\u0432\u0451\u045e \u0432\u0430 \u045e\u0440\u0430\u0434\u043b\u0456\u0432\u0443\u044e \u0437\u044f\u043c\u043b\u044e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0414\u0437 3, 25; \u0413\u0430\u043b 3, 8\u0430<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u044b \u2013 \u0441\u044b\u043d\u044b \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u044f\u043a\u0456 \u0411\u043e\u0433 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0430\u0439\u0446\u0430\u043c\u0456 \u0432\u0430\u0448\u044b\u043c\u0456, \u043a\u0430\u0436\u0443\u0447\u044b \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443: <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0443 \u0442\u0432\u0430\u0456\u043c \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0435 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0437\u044f\u043c\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u0430\u0434\u0431\u0430\u0447\u044b\u043b\u0430, \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u0435 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0443\u0436\u043e \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u043b\u0430 \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"184","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u00ab\u041b\u0456\u0441\u0442\u0430\u00bb, \u0448\u0442\u043e \u043f\u0440\u044b\u043f\u0456\u0441\u0432\u0430\u0435\u0446\u0446\u0430 \u0411\u0430\u0440\u043d\u0430\u0431\u0435&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 19, 1-3. 5-7. 8-12: Funk 1, 53-57)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0414\u0430\u0440\u043e\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430 \u0434\u0430\u0440\u043e\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430: \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0456\u0441\u0446\u0456 \u043f\u0430 \u0451\u0439 \u0434\u0430 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430\u0439 \u043c\u044d\u0442\u044b, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0448\u043a\u0430\u0434\u0443\u0435 \u0441\u0456\u043b\u0430\u045e. \u0412\u043e\u0441\u044c \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0456, \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u0456\u0441\u0446\u0456 \u0433\u044d\u0442\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u0439. \u041b\u044e\u0431\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0446\u044f\u0431\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u045e, \u0431\u043e\u0439\u0441\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0446\u044f\u0431\u0435 \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u045e, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0446\u044f\u0431\u0435 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456. \u0411\u0443\u0434\u0437\u044c \u043f\u0440\u043e\u0441\u0442\u044b \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0431\u0430\u0433\u0430\u0442\u044b \u0434\u0443\u0445\u0430\u043c. \u041f\u0430\u0437\u0431\u044f\u0433\u0430\u0439 \u0442\u044b\u0445, \u0445\u0442\u043e \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0434\u0430\u0440\u043e\u0433\u0443 \u0441\u043c\u0435\u0440\u0446\u0456; \u043c\u0430\u0439 \u0430\u0433\u0456\u0434\u0443 \u0434\u0430 \u045e\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0443. \u041c\u0430\u0439 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0434\u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0430\u0434\u043c\u0430\u043d\u0443 \u0456 \u0442\u0430\u0434\u044b \u043d\u0435 \u0437\u0430\u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0440\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u041f\u0430\u043d\u0430. \u041d\u0435 \u045e\u0437\u0432\u044b\u0448\u0430\u0439\u0441\u044f, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u044c \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0432\u0430 \u045e\u0441\u0456\u043c. \u041d\u0435 \u0456\u043c\u043a\u043d\u0456\u0441\u044f \u0434\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u0445\u0432\u0430\u043b\u044b. \u041d\u0435 \u043c\u0430\u0439 \u0434\u0440\u044d\u043d\u043d\u044b\u0445 \u043d\u0430\u043c\u0435\u0440\u0430\u045e \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0456 \u043d\u0435 \u043f\u0443\u0441\u043a\u0430\u0439 \u043f\u044b\u0445\u0443 \u045e \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041b\u044e\u0431\u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435. \u041d\u0435 \u0437\u0430\u0431\u0456\u0432\u0430\u0439 \u043d\u0435\u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u043f\u043b\u043e\u0434\u0443; \u043d\u0435 \u0437\u0430\u0431\u0456\u0432\u0430\u0439 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0441\u043b\u044f \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f. \u041d\u0435 \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u0439 \u043a\u043b\u043e\u043f\u0430\u0442\u0443 \u043f\u0440\u0430 \u0441\u044b\u043d\u0430 \u0446\u0456 \u0434\u0430\u0447\u043a\u0443, \u0430\u043b\u0435 \u0437 \u0434\u0437\u044f\u0446\u0456\u043d\u0441\u0442\u0432\u0430 \u0432\u0443\u0447\u044b \u0456\u0445 \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0436\u0430\u0439. \u041d\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u0439 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430; \u043d\u0435 \u0431\u0443\u0434\u0437\u044c \u0445\u0446\u0456\u0432\u044b\u043c. \u041d\u0435 \u0441\u044f\u0431\u0440\u0443\u0439 \u0437 \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u044b\u043c\u0456, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u044c \u0441\u044f\u0431\u0440\u0430\u043c \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u0445 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0442\u043e \u0431 \u043d\u0456 \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u0443\u0441\u0451 \u043b\u0456\u0447\u044b \u0434\u0430\u0431\u0440\u043e\u043c, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b\u043c, \u0448\u0442\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0434\u0437\u0435\u0435\u0446\u0446\u0430 \u0431\u0435\u0437 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456. \u041d\u0435 \u0431\u0443\u0434\u0437\u044c \u0434\u0432\u0443\u0434\u0443\u0448\u043d\u044b\u043c \u043d\u0456 \u045e \u0434\u0443\u043c\u043a\u0430\u0445, \u043d\u0456 \u045e \u043c\u043e\u0432\u0435, \u0431\u043e \u0456\u043b\u0436\u044b\u0432\u044b \u044f\u0437\u044b\u043a \u2013 \u0433\u044d\u0442\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0441\u043c\u0435\u0440\u0446\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0437\u044f\u043b\u0456\u0441\u044f \u045e\u0441\u0456\u043c \u0437 \u0431\u043b\u0456\u0436\u043d\u0456\u043c\u0456 \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u0439 \u0441\u0432\u0430\u0451\u0439 \u0443\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044e. \u041a\u0430\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0434\u0437\u0435\u043b\u0456\u0446\u0435\u0441\u044f \u0432\u0435\u0447\u043d\u044b\u043c\u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0431\u043e\u043b\u044c\u0448 \u0442\u0440\u044d\u0431\u0430 \u0434\u0437\u044f\u043b\u0456\u0446\u0446\u0430 \u0447\u0430\u0441\u043e\u0432\u044b\u043c\u0456. \u041d\u0435 \u0431\u0443\u0434\u0437\u044c \u0448\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u043d\u044b\u043c, \u0431\u043e \u044f\u0437\u044b\u043a \u2013 \u0433\u044d\u0442\u0430 \u043f\u0430\u0441\u0442\u043a\u0430 \u0441\u043c\u0435\u0440\u0446\u0456. \u0414\u0437\u0435\u043b\u044f \u0434\u0430\u0431\u0440\u0430 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c, \u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0436\u0430\u0448. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043a\u0440\u044b\u0442\u0430\u0439 \u0442\u0432\u0430\u044f \u0440\u0443\u043a\u0430 \u0434\u043b\u044f \u0431\u0440\u0430\u043d\u043d\u044f, \u0430 \u0437\u0430\u043a\u0440\u044b\u0442\u0430\u0439 \u0434\u043b\u044f \u0434\u0430\u0432\u0430\u043d\u043d\u044f. \u042f\u043a \u0437\u0440\u044d\u043d\u043a\u0443 \u0432\u043e\u043a\u0430 \u043b\u044e\u0431\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0442\u0430\u0431\u0435 \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u043d\u0451\u043c \u0456 \u043d\u043e\u0447\u0447\u0443 \u043f\u0430\u043c\u044f\u0442\u0430\u0439 \u043f\u0440\u0430 \u0434\u0437\u0435\u043d\u044c \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u0443\u0434\u0430: \u0456\u043c\u043a\u043d\u0456\u0441\u044f \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0443 \u0442\u0430\u0432\u0430\u0440\u044b\u0441\u0442\u0432\u0435 \u0441\u0432\u044f\u0442\u044b\u0445, \u0446\u0456 \u0442\u043e \u0434\u0437\u0435\u043b\u044f \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0441\u043b\u043e\u0432\u0430, \u0446\u0456 \u0434\u043b\u044f \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f, \u0446\u0456 \u0434\u043b\u044f \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f, \u044f\u043a \u0441\u043b\u043e\u0432\u0430\u043c \u0442\u044b \u043c\u043e\u0433 \u0431\u044b \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443, \u0446\u0456, \u043f\u0440\u0430\u0446\u0443\u044e\u0447\u044b \u0440\u0443\u043a\u0430\u043c\u0456, \u0434\u043b\u044f \u043a\u0430\u043c\u043f\u0435\u043d\u0441\u0430\u0446\u044b\u0456 \u0437\u0430 \u0441\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u044c \u0443 \u0434\u0430\u0432\u0430\u043d\u043d\u0456. \u041a\u0430\u043b\u0456 \u0434\u0430\u0435\u0448 \u2013 \u043d\u0435 \u043d\u0430\u0440\u0430\u043a\u0430\u0439, \u0442\u0430\u0434\u044b \u0434\u0430\u0432\u0435\u0434\u0430\u0435\u0448\u0441\u044f, \u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0448\u0447\u043e\u0434\u0440\u0430 \u0434\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443. \u0421\u0446\u0435\u0440\u0430\u0436\u044b \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u0430\u0431\u0435 \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430, \u043d\u0435 \u0434\u0430\u0434\u0430\u044e\u0447\u044b \u0456 \u043d\u0435 \u0430\u0434\u0434\u044b\u043c\u0430\u044e\u0447\u044b \u043d\u0456\u0447\u043e\u0433\u0430. \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u0430\u0439 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0434\u0430 \u0437\u043b\u0430. \u0423 \u0441\u0443\u0434\u0437\u0435 \u0431\u0443\u0434\u0437\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b. \u041d\u0435 \u043f\u0440\u044b\u0447\u044b\u043d\u044f\u0439\u0441\u044f \u0434\u0430 \u0440\u0430\u0437\u043b\u0430\u0434\u0443, \u0430\u043b\u0435 \u0441\u043f\u0440\u044b\u044f\u0439 \u0441\u043f\u0430\u043a\u043e\u044e, \u044f\u0434\u043d\u0430\u044e\u0447\u044b \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u0432\u0430\u0440\u044b\u0446\u0446\u0430. \u0412\u044b\u0437\u043d\u0430\u0432\u0430\u0439 \u0441\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456. \u041d\u0435 \u043f\u0430\u0447\u044b\u043d\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0437 \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435\u043c. \u0413\u044d\u0442\u0430 \u2013 \u0434\u0430\u0440\u043e\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 119 (118), 101-102&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e \u043d\u043e\u0433\u0456 \u0441\u0432\u0430\u0435 \u0430\u0434 \u043a\u043e\u0436\u043d\u0430\u0439 \u0437\u043b\u043e\u0439 \u0441\u0446\u0435\u0436\u043a\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0422\u0432\u0430\u0451 \u0441\u043b\u043e\u0432\u0430, \u041f\u0430\u043d\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0435 \u045e\u0445\u0456\u043b\u044f\u044e\u0441\u044f \u0430\u0434 \u0422\u0432\u0430\u0456\u0445 \u043f\u0440\u044b\u0441\u0443\u0434\u0430\u045e, \u0431\u043e \u0422\u044b \u0432\u0443\u0447\u044b\u0448 \u043c\u044f\u043d\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"185","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u0411\u0430\u043b\u0434\u0443\u0456\u043d\u0430 \u041a\u0430\u043d\u0442\u0443\u0430\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 10: PL 204, 513-514. 516)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041b\u044e\u0431\u043e\u045e, \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u044f \u0437\u0430 \u0441\u043c\u0435\u0440\u0446\u044c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043c\u0435\u0440\u0446\u044c \u043c\u043e\u0446\u043d\u0430\u044f, \u0431\u043e \u044f\u043d\u0430 \u043c\u0430\u0435 \u043c\u043e\u0446 \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u0446\u044c \u043d\u0430\u0441 \u0436\u044b\u0446\u0446\u044f. \u041b\u044e\u0431\u043e\u045e \u043c\u043e\u0446\u043d\u0430\u044f, \u0431\u043e \u043c\u0430\u0435 \u043c\u043e\u0446 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u043d\u0430\u043c \u043b\u0435\u043f\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043c\u0435\u0440\u0446\u044c \u043c\u043e\u0446\u043d\u0430\u044f, \u0431\u043e \u043c\u0430\u0435 \u043c\u043e\u0446 \u0437\u0430\u0431\u0440\u0430\u0446\u044c \u0443 \u043d\u0430\u0441 \u0446\u0435\u043b\u0430. \u041b\u044e\u0431\u043e\u045e \u043c\u043e\u0446\u043d\u0430\u044f, \u0431\u043e \u043c\u0430\u0435 \u043c\u043e\u0446 \u0430\u0434\u0430\u0431\u0440\u0430\u0446\u044c \u0437\u0434\u0430\u0431\u044b\u0447\u0443 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u044f\u0435 \u043d\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043c\u0435\u0440\u0446\u044c \u043c\u043e\u0446\u043d\u0430\u044f; \u043d\u0456\u0445\u0442\u043e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0432\u044b\u0441\u0442\u0430\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0451\u0439. \u041b\u044e\u0431\u043e\u045e \u043c\u043e\u0446\u043d\u0430\u044f; \u0443\u043c\u0435\u0435 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0447\u044b \u0441\u043c\u0435\u0440\u0446\u044c, \u0437\u043b\u0430\u043c\u0430\u0446\u044c \u044f\u0435 \u0434\u0436\u0430\u043b\u0430, \u0443\u0442\u0430\u0439\u043c\u0430\u0432\u0430\u0446\u044c \u044f\u0435 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u0430\u0434\u0430\u0431\u0440\u0430\u0446\u044c \u0443 \u044f\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443. \u041f\u0440\u044b\u0439\u0434\u0437\u0435 \u0447\u0430\u0441, \u043a\u0430\u043b\u0456 \u044f\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0456 \u043a\u0430\u043b\u0456 \u0441\u043a\u0430\u0436\u0443\u0446\u044c: \u00abC\u043c\u0435\u0440\u0446\u044c, \u0434\u0437\u0435 \u0442\u0432\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430? \u0421\u043c\u0435\u0440\u0446\u044c, \u0434\u0437\u0435 \u0442\u0432\u0430\u0451 \u0434\u0436\u0430\u043b\u0430?\u00bb (1 \u041a\u0430\u0440 15, 55).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041a\u0430\u0445\u0430\u043d\u043d\u0435 \u043c\u043e\u0446\u043d\u0430\u0435, \u044f\u043a \u0441\u043c\u0435\u0440\u0446\u044c\u00bb (\u043f\u0430\u0440. \u041f\u043f 8, 6), \u0431\u043e \u0441\u043c\u0435\u0440\u0446\u044e \u0434\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430. \u0422\u0430\u043c\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043a\u0430\u0436\u0430: \u00ab\u0421\u043c\u0435\u0440\u0446\u044c, \u042f \u2013 \u0442\u0432\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c; \u0430\u0434\u0445\u043b\u0430\u043d\u044c, \u042f \u2013 \u0442\u0432\u0430\u044f \u043f\u0430\u0433\u0456\u0431\u0435\u043b\u044c\u00bb (\u043f\u0430\u0440. \u041e\u0441 13, 14). \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043d\u0430\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u044f \u0437\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0431\u043e \u044f\u043d\u0430 \u0441\u0430\u043c\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u044f\u043a \u0431\u044b \u0441\u043c\u0435\u0440\u0446\u044e, \u0448\u0442\u043e \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0441\u0442\u0430\u0440\u043e\u0435 \u0436\u044b\u0446\u0446\u0451, \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u044b, \u0430\u0434\u0445\u0456\u043b\u044f\u0435 \u0434\u0437\u0435\u044f\u043d\u043d\u0456 \u0441\u043c\u0435\u0440\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u2013 \u0433\u044d\u0442\u0430 \u043d\u0456\u0431\u044b \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0441\u0446\u044c. \u0425\u043e\u0446\u044c \u044f\u043d\u0430 \u0434\u0430\u043b\u0451\u043a\u0430\u044f \u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0434\u0430 \u043d\u0430\u0441, \u0430\u043b\u0435 \u044f\u043d\u0430 \u2013 \u044f\u0435 \u0432\u043e\u0431\u0440\u0430\u0437 \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430. \u0411\u043e \u00ab\u0401\u043d \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441\u00bb (1 \u042f\u043d 4, 10). \u0414\u0430\u044e\u0447\u044b \u043d\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456, \u0401\u043d \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u0437\u043e\u0440\u0430\u043c; \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u043c\u044b \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u0435\u043c\u0441\u044f \u0434\u0430 \u042f\u0433\u043e, \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u043f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430. \u042f\u043a \u0401\u043d \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u0442\u0430\u043a \u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0401\u043d \u00ab\u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u043a\u0430\u0431 \u043c\u044b \u0456\u0448\u043b\u0456 \u0441\u043b\u0435\u0434\u0430\u043c \u0437\u0430 \u0406\u043c\u00bb (1 \u041f 2, 21).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: \u00ab\u041f\u0430\u0441\u0442\u0430\u045e \u043c\u044f\u043d\u0435, \u044f\u043a \u043f\u044f\u0447\u0430\u0446\u044c \u043d\u0430 \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430\u00bb (\u041f\u043f 8, 6). \u0413\u044d\u0442\u044b\u043c \u043d\u0456\u0431\u044b \u043a\u0430\u0436\u0430: \u00ab\u041b\u044e\u0431\u0456 \u041c\u044f\u043d\u0435 \u0442\u0430\u043a, \u044f\u043a \u042f \u043b\u044e\u0431\u043b\u044e \u0446\u044f\u0431\u0435. \u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u041c\u044f\u043d\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u0434\u0443\u043c\u043a\u0430\u0445, \u043f\u0430\u043c\u044f\u0446\u0456, \u0436\u0430\u0434\u0430\u043d\u043d\u0456, \u0443 \u0441\u0432\u0430\u0456\u043c \u0443\u0437\u0434\u044b\u0445\u0443, \u0437\u0430\u043a\u043b\u0456\u043a\u0443 \u0456 \u043f\u043b\u0430\u0447\u044b. \u041f\u0430\u043c\u044f\u0442\u0430\u0439, \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430, \u044f\u043a\u0456\u043c \u042f \u0446\u044f\u0431\u0435 \u045e\u0447\u044b\u043d\u0456\u045e; \u044f\u043a \u0443\u0437\u0432\u044b\u0441\u0456\u045e \u0446\u044f\u0431\u0435 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456, \u044f\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e \u0430\u0434\u0430\u0440\u044b\u045e \u0446\u044f\u0431\u0435, \u044f\u043a \u0430\u043a\u0440\u0443\u0436\u044b\u045e \u0446\u044f\u0431\u0435 \u0445\u0432\u0430\u043b\u043e\u0439 \u0456 \u043f\u0430\u0448\u0430\u043d\u0430\u0439, \u044f\u043a \u0443\u0447\u044b\u043d\u0456\u045e \u0446\u044f\u0431\u0435 \u043c\u0430\u043b\u0430 \u043c\u0435\u043d\u0448\u044b\u043c \u0437\u0430 \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a \u0443\u0441\u0451 \u043f\u0430\u043a\u043b\u0430\u045e \u043f\u0430\u0434 \u0442\u0432\u0430\u0435 \u043d\u043e\u0433\u0456 (\u043f\u0430\u0440. \u041f\u0441 8, 6-7). \u041f\u0430\u043c\u044f\u0442\u0430\u0439 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u042f \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u043b\u044f \u0426\u044f\u0431\u0435, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430 \u0442\u043e\u0435, \u044f\u043a \u0436\u043e\u0440\u0441\u0442\u043a\u0430, \u044f\u043a \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u042f \u0446\u044f\u0440\u043f\u0435\u045e \u0434\u043b\u044f \u0446\u044f\u0431\u0435. \u0417\u0430\u0434\u0443\u043c\u0430\u0439\u0441\u044f, \u0446\u0456 \u043d\u0435 \u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0448 \u041c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043b\u044e\u0431\u0456\u0448 \u041c\u044f\u043d\u0435. \u0411\u043e \u0445\u0442\u043e \u0436 \u043b\u044e\u0431\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u0442\u0430\u043a, \u044f\u043a \u042f? \u0425\u0442\u043e \u0436 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0446\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u042f? \u0425\u0442\u043e \u0436 \u0430\u0434\u043a\u0443\u043f\u0456\u045e, \u043a\u0430\u043b\u0456 \u043d\u0435 \u042f?\u00bb<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0430\u0431\u044f\u0440\u044b, \u041f\u0430\u043d\u0435, \u0430\u0434 \u043c\u044f\u043d\u0435 \u043a\u0430\u043c\u0435\u043d\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0437\u0430\u0431\u044f\u0440\u044b \u043d\u0435\u0430\u0431\u0440\u044d\u0437\u0430\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430. \u0414\u0430\u0439 \u043c\u043d\u0435 \u043d\u043e\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0441\u044d\u0440\u0446\u0430 \u0437 \u043f\u043b\u043e\u0446\u0456, \u0447\u044b\u0441\u0442\u0430\u0435 \u0441\u044d\u0440\u0446\u0430! \u0422\u044b, \u044f\u043a\u0456 \u0430\u0447\u044b\u0448\u0447\u0430\u0435\u0448 \u0437\u0430\u0431\u0440\u0443\u0434\u0436\u0430\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0456 \u043b\u044e\u0431\u0456\u0448 \u0441\u044d\u0440\u0446\u0430 \u0447\u044b\u0441\u0442\u0430\u0435, \u043f\u0440\u044b\u043c\u0456 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u043f\u0430\u0441\u044f\u043b\u0456\u0441\u044f \u045e \u0456\u043c, \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0439 \u0456\u043c \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456 \u044f\u0433\u043e. \u0422\u044b \u0431\u043e\u043b\u044c\u0448\u044b \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0432\u0430 \u043c\u043d\u0435 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0435, \u0422\u044b \u043d\u0430\u0439\u0431\u043b\u0456\u0436\u044d\u0439 \u0434\u0430 \u043c\u044f\u043d\u0435 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0441\u0430\u043c\u0430\u0435 \u0431\u043b\u0456\u0437\u043a\u0430\u0435. \u0422\u044b \u2013 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0456 \u045e\u0437\u043e\u0440 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u043f\u0430\u043a\u0456\u043d\u044c \u0443 \u043c\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u0430\u0434\u0431\u0456\u0442\u0430\u043a \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u043e\u0431\u0440\u0430\u0437\u0430, \u0432\u044b\u0446\u0456\u0441\u043d\u0456 \u043d\u0430 \u043c\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u0422\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u00ab\u0411\u043e\u0433 \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0456 \u043c\u0430\u044f \u0434\u043e\u043b\u044f \u043d\u0430\u0432\u0435\u043a\u0456\u00bb (\u041f\u0441 73 [72], 26).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u043f 8, 6bc. 7a; \u042f\u043d 15, 13\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u0445\u0430\u043d\u043d\u0435 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0435, \u044f\u043a \u0441\u043c\u0435\u0440\u0446\u044c, \u044f\u0433\u043e \u043f\u043e\u043b\u044b\u043c\u044f \u2013 \u0433\u044d\u0442\u0430 \u043f\u043e\u043b\u044b\u043c\u044f \u0430\u0433\u043d\u044e, \u0411\u043e\u0436\u0430\u0435 \u043f\u043e\u043b\u044b\u043c\u044f. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0412\u044f\u043b\u0456\u043a\u0456\u044f \u0432\u043e\u0434\u044b \u043d\u0435 \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0430\u0433\u0430\u0441\u0456\u0446\u044c \u043a\u0430\u0445\u0430\u043d\u043d\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0437\u0430 \u0442\u0443\u044e, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0430\u0434\u0434\u0430\u0435 \u0437\u0430 \u0441\u044f\u0431\u0440\u043e\u045e \u0441\u0432\u0430\u0456\u0445.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0412\u044f\u043b\u0456\u043a\u0456\u044f \u0432\u043e\u0434\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"186","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0414\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u043f\u0435\u0441\u043d\u044f\u00bb \u0441\u0432. \u042f\u043d\u0430 \u0430\u0434 \u041a\u0440\u044b\u0436\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Red. A, str. 38)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u0430\u0440\u0443\u0447\u0443\u0441\u044f \u0437 \u0442\u0430\u0431\u043e\u044e \u043d\u0430\u0432\u0435\u043a\u0456&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0414\u0443\u0448\u0430, \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u0430\u044f \u0437 \u0411\u043e\u0433\u0430\u043c \u0456 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0435\u043d\u0430\u044f \u045e \u0406\u043c, \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0442\u044b\u043c \u0443\u0437\u043d\u0451\u0441\u043b\u044b\u043c \u0443 \u0411\u043e\u0433\u0443 \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u0435\u043c, \u044f\u043a\u0456\u043c \u0411\u043e\u0433 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0451\u0439 \u0434\u0430 \u0441\u044f\u0431\u0435, \u044f\u043a \u044f\u0435 \u045e\u0437\u043e\u0440. \u0413\u044d\u0442\u0430 \u2013 \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f \u0434\u043e\u0431\u0440\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u044e \u2013 \u0445\u0430\u0446\u0435\u045e \u0432\u044b\u0440\u0430\u0437\u0456\u0446\u044c \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, \u043a\u0430\u043b\u0456 \u043a\u0430\u0437\u0430\u045e: \u00ab\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u0441\u044b\u043d\u044b, \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u0443 \u0432\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0414\u0443\u0445\u0430 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a\u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435: \u00ab\u0410\u0431\u0431\u0430, \u041e\u0439\u0447\u0430!\u00bb (\u0413\u0430\u043b 4, 6). \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u0434\u0437\u0435\u0435\u0446\u0446\u0430 \u045e \u043b\u044e\u0434\u0437\u044f\u0445 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0441 \u043d\u0435 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0443\u0448\u0430 \u043c\u043e\u0436\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u0442\u0430\u043a\u0456\u044f \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u044f \u0440\u044d\u0447\u044b. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433 \u0443\u0434\u0437\u044f\u043b\u044f\u0435 \u0451\u0439 \u043b\u0430\u0441\u043a\u0443 \u0411\u043e\u0441\u043a\u0430\u0433\u0430 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u044f \u0437 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0422\u0440\u043e\u0439\u0446\u0430\u0439, \u0447\u0430\u043c\u0443 \u044f\u043d\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u0441\u0432\u043e\u0439 \u0447\u044b\u043d \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f, \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0456 \u043b\u044e\u0431\u043e\u0432\u0456 \u045e \u0422\u0440\u043e\u0439\u0446\u044b \u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0422\u0440\u043e\u0439\u0446\u0430\u0439, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0422\u0440\u043e\u0439\u0446\u0430 \u0441\u0430\u043c\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u0433\u044d\u0442\u0430, \u0430\u0434\u043d\u0430\u043a, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u045e\u0434\u0437\u0435\u043b\u0443, \u0431\u043e \u0441\u0430\u043c \u0411\u043e\u0433 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u045e\u0441\u0451 \u045e \u0451\u0439.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0456 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430, \u044f\u043a \u0433\u044d\u0442\u0430 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430, \u0431\u043e \u043c\u043e\u0436\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u043f\u043e\u0441\u0430\u0431, \u043f\u0440\u0430\u0437 \u044f\u043a\u0456 \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u0432\u044b\u0441\u043b\u0443\u0436\u044b\u045e \u043d\u0430\u043c \u0433\u044d\u0442\u0443\u044e \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0443\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0442\u0430\u043a, \u0448\u0442\u043e \u043c\u044b \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456. \u0422\u0430\u043c\u0443 \u0401\u043d \u0442\u0430\u043a \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0410\u0439\u0446\u0430: \u00ab\u041e\u0439\u0447\u0430, \u0445\u0430\u0447\u0443, \u043a\u0430\u0431 \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u0422\u044b \u0434\u0430\u045e \u041c\u043d\u0435, \u0431\u044b\u043b\u0456 \u0441\u0430 \u041c\u043d\u043e\u044e \u0442\u0430\u043c, \u0434\u0437\u0435 \u042f \u0451\u0441\u0446\u044c\u00bb (\u042f\u043d 17, 24), \u043a\u0430\u0431 \u044f\u043d\u044b \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u045e\u0434\u0437\u0435\u043b\u0443 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u0442\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u044f\u043a\u0456\u044f \u042f \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e. \u041a\u0430\u0436\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u00ab\u041d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430 \u0456\u0445 \u043f\u0440\u0430\u0448\u0443, \u0430\u043b\u0435 \u0456 \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u041c\u044f\u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430 \u0456\u0445\u043d\u044f\u0433\u0430, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e, \u044f\u043a \u0422\u044b, \u041e\u0439\u0447\u0430, \u0443\u0432\u0430 \u041c\u043d\u0435, \u0456 \u042f \u045e \u0422\u0430\u0431\u0435, \u043a\u0430\u0431 \u0456 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u045e \u041d\u0430\u0441, \u043a\u0430\u0431 \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0441\u0432\u0435\u0442, \u0448\u0442\u043e \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435. \u0406 \u0441\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u0422\u044b \u0434\u0430\u045e \u041c\u043d\u0435, \u042f \u0434\u0430\u045e \u0456\u043c, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e, \u044f\u043a \u0456 \u041c\u044b \u0430\u0434\u043d\u043e. \u042f \u045e \u0456\u0445, \u0430 \u0422\u044b \u045e\u0432\u0430 \u041c\u043d\u0435. \u041a\u0430\u0431 \u0431\u044b\u043b\u0456 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u045e \u0430\u0434\u043d\u043e, \u043a\u0430\u0431 \u0441\u0432\u0435\u0442 \u043f\u0430\u0437\u043d\u0430\u045e, \u0448\u0442\u043e \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435 \u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0456\u0445, \u044f\u043a \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u041c\u044f\u043d\u0435\u00bb (\u042f\u043d 17, 20-23).<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043a \u0434\u0437\u0435\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0401\u043d \u043f\u0435\u0440\u0430\u0434\u0430\u0435 \u0456\u043c \u0442\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0443\u044e \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u0421\u044b\u043d\u0443, \u0430\u0434\u043d\u0430\u043a, \u043d\u0435 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c, \u044f\u043a \u0443 \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u0421\u044b\u043d\u0430, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0435\u043d\u043d\u0435 \u043b\u044e\u0431\u043e\u0432\u0456. \u0411\u043e \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0434\u0443\u043c\u0430\u0446\u044c, \u0448\u0442\u043e \u0421\u044b\u043d \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0410\u0439\u0446\u0430, \u043a\u0430\u0431 \u0432\u0435\u0440\u043d\u0456\u043a\u0456 \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e \u043f\u0430 \u043f\u0440\u044b\u0440\u043e\u0434\u0437\u0435 \u0456 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456, \u044f\u043a \u0410\u0439\u0446\u0435\u0446 \u0456 \u0421\u044b\u043d \u0451\u0441\u0446\u044c \u0430\u0434\u043d\u043e, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456, \u043a\u0430\u0431 \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0410\u0439\u0446\u0435\u0446 \u0456 \u0421\u044b\u043d \u0441\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0443 \u043b\u044e\u0431\u043e\u0432\u0456. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443 \u0434\u0443\u0448\u044b \u043c\u0430\u044e\u0446\u044c \u0442\u044b\u044f \u0441\u0430\u043c\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u043f\u0440\u0430\u0437 \u0443\u0434\u0437\u0435\u043b, \u044f\u043a\u0456\u044f \u043c\u0430\u0435 \u0411\u043e\u0433 \u043f\u0430 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u044b\u0440\u043e\u0434\u0437\u0435; \u0442\u0430\u043c\u0443 \u044f\u043d\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0411\u043e\u0441\u043a\u0456\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u045e\u0434\u0437\u0435\u043b\u0443, \u044f\u043d\u044b \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0456 \u0431\u043b\u0456\u0437\u043a\u0456\u044f \u0441\u0430\u043c\u043e\u043c\u0443 \u0411\u043e\u0433\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0441\u0432. \u041f\u0451\u0442\u0440 \u043a\u0430\u0436\u0430: \u00ab\u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u043c\u043d\u043e\u0436\u0430\u0446\u0446\u0430 \u045e \u0432\u0430\u0441 \u043b\u0430\u0441\u043a\u0430 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u043f\u0440\u0430\u0437 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u0456 \u0415\u0437\u0443\u0441\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430. \u0410\u0434 \u0411\u043e\u0441\u043a\u0430\u0439 \u0441\u0456\u043b\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u043d\u0430\u043c \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u0430 \u045e\u0441\u0451 \u0434\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b \u0456 \u0445\u0432\u0430\u043b\u044b, \u043f\u0440\u0430\u0437 \u0448\u0442\u043e \u0434\u0430\u045e \u043d\u0430\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0456\u0445 \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b\u00bb (2 \u041f 1, 2-4). \u0422\u0430\u043a \u0451\u0441\u0446\u044c, \u0448\u0442\u043e \u0434\u0443\u0448\u0430 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0435 \u045e \u0434\u0437\u0435\u044f\u043d\u043d\u0456 \u0422\u0440\u043e\u0439\u0446\u044b \u043f\u0440\u0430\u0437 \u0437\u0433\u0430\u0434\u0430\u043d\u0443\u044e \u0435\u0434\u043d\u0430\u0441\u0446\u044c. \u0423 \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0433\u044d\u0442\u0430 \u0430\u0434\u0431\u0443\u0434\u0437\u0435\u0446\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430, \u0430\u043b\u0435 \u045e \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0434\u0443\u0448\u0430 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0441\u043c\u0430\u043a \u0433\u044d\u0442\u0430\u0433\u0430 \u0456 \u043d\u0430\u0434\u0437\u0435\u0439\u043d\u0443\u044e \u0433\u0430\u0440\u0430\u043d\u0442\u044b\u044e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041e \u0434\u0443\u0448\u044b, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u044f, \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0442\u0430\u043a\u0456\u043c\u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456! \u0428\u0442\u043e \u0436 \u0432\u044b \u0440\u043e\u0431\u0456\u0446\u0435? \u0427\u044b\u043c \u0437\u0430\u0439\u043c\u0430\u0435\u0446\u0435\u0441\u044f? \u041e \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u044f \u0441\u043b\u044f\u043f\u044b\u044f \u0441\u044b\u043d\u044b \u0410\u0434\u0430\u043c\u0430! \u041f\u0435\u0440\u0430\u0434 \u0442\u0430\u043a\u0456\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0432\u044b \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0435\u0441\u044f \u0441\u043b\u044f\u043f\u044b\u043c\u0456! \u041f\u0435\u0440\u0430\u0434 \u0442\u0430\u043a\u0456\u043c \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043c \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0435\u0441\u044f \u0433\u043b\u0443\u0445\u0456\u043c\u0456!<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u042f\u043d 3, 1. 2b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u044f\u043a\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430\u045e \u043d\u0430\u043c \u0410\u0439\u0446\u0435\u0446,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u043a\u0430\u0431 \u043c\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0456\u0441\u044f \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456, \u0456 \u043c\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0456\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0401\u043d \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u0446\u0430, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u043c \u042f\u0433\u043e \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431 \u043c\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"187","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u044f\u045e\u00bb \u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 4, 17, 4-6: SCh 100, 590-594)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0445\u0430\u0447\u0443, \u0430 \u043d\u0435 \u0430\u0445\u0432\u044f\u0440\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e\u0433 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0430\u0434 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0430\u045e \u0430\u0445\u0432\u044f\u0440\u0430\u045e \u0456 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f\u045e, \u0430\u043b\u0435 \u0434\u0437\u0435\u043b\u044f \u0456\u0445\u043d\u044f\u0433\u0430 \u0434\u0430\u0431\u0440\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0410\u0434\u043a\u0440\u044b\u0432\u0430\u044e\u0447\u044b \u0456\u043c \u0441\u0432\u0430\u044e \u0432\u043e\u043b\u044e, \u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041e\u0441\u0456\u044e: \u00ab\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0445\u0430\u0447\u0443, \u0430 \u043d\u0435 \u0430\u0445\u0432\u044f\u0440\u044b, \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u0456\u00bb (\u041e\u0441 6, 6). \u0410\u043b\u0435 \u0456 \u043d\u0430\u0448 \u041f\u0430\u043d \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u0432\u0443\u0447\u044b\u045e \u0456\u0445, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u041a\u0430\u043b\u0456 \u0431 \u0432\u044b \u0432\u0435\u0434\u0430\u043b\u0456, \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435: <\/span><span style=\"font-style: italic;\">\u201c\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0445\u0430\u0447\u0443, \u0430 \u043d\u0435 \u0430\u0445\u0432\u044f\u0440\u044b\u201d<\/span><span>, \u043d\u0435 \u0430\u0441\u0443\u0434\u0437\u0456\u043b\u0456 \u0431 \u043d\u0435\u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b\u0445\u00bb (\u041c\u0446 12, 7). \u0413\u044d\u0442\u044b\u043c \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0441\u0446\u044c \u0441\u043b\u043e\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0430 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0446\u044f\u043d\u0430\u045e \u043f\u0430\u043f\u0440\u0430\u043a\u043d\u0443\u045e \u0437\u0430 \u0456\u0445 \u043d\u0430\u045e\u043c\u044b\u0441\u043d\u0430\u0435 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0432\u0430\u0456\u043c \u0432\u0443\u0447\u043d\u044f\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0411\u043e\u0433\u0443 \u0445\u0432\u044f\u0440\u0443 \u0437 \u0443\u0441\u044f\u0433\u043e \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430 \u0411\u043e\u0433\u0430\u043c. \u041d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0401\u043d \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u045e, \u0430\u043b\u0435 \u043a\u0430\u0431 \u044f\u043d\u044b \u0441\u0430\u043c\u0456 \u043d\u0435 \u0430\u043a\u0430\u0437\u0430\u043b\u0456\u0441\u044f \u043d\u044f\u045e\u0434\u0437\u044f\u0447\u043d\u044b\u043c\u0456 \u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u043c\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u0445 \u043f\u043b\u0430\u0434\u043e\u045e. \u0422\u0430\u043c\u0443 \u045e\u0437\u044f\u045e \u0445\u043b\u0435\u0431, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u0430\u045e \u0434\u0430 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u045e, \u0443\u0437\u043d\u0451\u0441 \u043f\u0430\u0434\u0437\u044f\u043a\u0443 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0413\u044d\u0442\u0430 \u0426\u0435\u043b\u0430 \u041c\u0430\u0451\u00bb. \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u045e\u0437\u044f\u045e \u043a\u0435\u043b\u0456\u0445 \u0437 \u0432\u0456\u043d\u043e\u043c, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u043c \u044f\u043a \u0456 \u043c\u044b, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u044f\u043d\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u042f\u0433\u043e \u041a\u0440\u044b\u0432\u0451\u044e, \u0443\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u043d\u043e\u0432\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 (\u043f\u0430\u0440. \u041c\u0446 26, 28).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u0441\u0446\u0451\u043b, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0433\u044d\u0442\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u0430\u0434 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u044f\u0435 \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u0434\u0430\u0435 \u043d\u0430\u043c \u0435\u0436\u0443 \u044f\u043a \u0433\u0430\u0440\u0430\u043d\u0442\u044b\u044e \u0434\u0430\u0440\u043e\u045e \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443. \u0413\u044d\u0442\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u043b\u0430\u0445\u0456\u044f, \u0430\u0434\u0437\u0456\u043d \u0437 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0443 \u0441\u043b\u043e\u0432\u0430\u0445: \u00ab\u041d\u0435 \u043c\u0430\u044e \u045e \u0432\u0430\u0441 \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u2013 \u0456 \u043d\u0435 \u043f\u0440\u044b\u043c\u0443 \u0430\u0445\u0432\u044f\u0440\u0430\u045e \u0437 \u0432\u0430\u0448\u044b\u0445 \u0440\u0443\u043a. \u0411\u043e \u0430\u0434 \u0443\u0441\u0445\u043e\u0434\u0443 \u0441\u043e\u043d\u0446\u0430 \u0456 \u0434\u0430 \u0437\u0430\u0445\u0430\u0434\u0443 \u041c\u0430\u0451 \u0456\u043c\u044f \u0431\u0443\u0434\u0437\u0435 \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0446\u0446\u0430 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u043d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430\u0440 \u043a\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u041c\u0430\u0439\u043c\u0443 \u0456\u043c\u0435\u043d\u0456 \u0456 \u0447\u044b\u0441\u0442\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430; \u0431\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u041c\u0430\u0451 \u0456\u043c\u044f \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b\u00bb (\u043f\u0430\u0440. \u041c\u0430\u043b 1, 10-11). \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0431\u044b\u043b\u044b \u043d\u0430\u0440\u043e\u0434 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0411\u043e\u0433\u0443 \u0430\u0445\u0432\u044f\u0440\u044b, \u0430\u043b\u0435 \u043d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0447\u044b\u0441\u0442\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430, \u0430 \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0446\u0446\u0430 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a\u043e\u0435 \u0436 \u0456\u043c\u044f \u045e\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u043c\u0456\u0436 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0456\u043c\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u045e\u0437\u0432\u044b\u0448\u0430\u043d\u044b \u0410\u0439\u0446\u0435\u0446 \u0456 \u045e\u0437\u0432\u044b\u0448\u0430\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a? \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430 \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0441\u0442\u0430\u045e\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0442\u0430\u043c\u0443 \u0401\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u044f\u0433\u043e \u0441\u0432\u0430\u0456\u043c. \u041a\u0430\u043b\u0456 \u0431 \u043d\u0435\u0439\u043a\u0456 \u043a\u0430\u0440\u043e\u043b\u044c \u0437\u0440\u0430\u0431\u0456\u045e \u0432\u044b\u044f\u0432\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044b\u043d\u0430, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043c\u043e\u0433 \u0431\u044b \u043d\u0430\u0437\u0432\u0430\u0446\u044c \u044f\u0435 \u0441\u0432\u0430\u0451\u0439, \u0431\u043e \u044f\u043d\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0441\u044b\u043d\u0430 \u0456 \u0451\u043d \u0441\u0430\u043c \u044f\u0435 \u0437\u0440\u0430\u0431\u0456\u045e. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043c\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0448\u0442\u043e \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435, \u0410\u0439\u0446\u0435\u0446 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u0432\u0430\u0456\u043c, \u0431\u043e \u0433\u044d\u0442\u0430 \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u0456 \u0401\u043d \u0441\u0430\u043c \u044f\u0433\u043e \u0434\u0430\u045e \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043b\u044e\u0434\u0437\u0435\u0439 (\u043f\u0430\u0440. \u0414\u0437 4, 12).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0456\u043c\u044f \u0421\u044b\u043d\u0430 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0410\u0439\u0446\u0443 \u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0443 \u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u0430\u043c\u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0440\u043e\u043a: \u00ab\u041d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430\u0440 \u043a\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u041c\u0430\u0439\u043c\u0443 \u0456\u043c\u0435\u043d\u0456 \u0456 \u0447\u044b\u0441\u0442\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430\u00bb (\u043f\u0430\u0440. \u041c\u0430\u043b 1, 11). \u0412\u043e\u0441\u044c \u0436\u0430 \u0434\u0430\u0440\u0430\u043c \u043a\u0430\u0434\u0436\u044d\u043d\u043d\u044f, \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u042f\u043d \u0443 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0435, \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0441\u0432\u044f\u0442\u044b\u0445 (\u043f\u0430\u0440. \u0410\u043f 5, 8).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041b\u043a 22, 19. 20; \u041f\u0440\u044b\u043f 9, 5\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0413\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u0426\u0435\u043b\u0430 \u041c\u0430\u0451, \u044f\u043a\u043e\u0435 \u0437\u0430 \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0434\u0430\u043d\u0430; \u0433\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u041a\u0440\u043e\u045e \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u044f\u043a\u0430\u044f \u0437\u0430 \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u043b\u0456\u0442\u0430, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u041a\u043e\u0436\u043d\u044b \u0440\u0430\u0437, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c, \u0433\u044d\u0442\u0430 \u0447\u044b\u043d\u0456\u0446\u0435 \u043d\u0430 \u041c\u0430\u044e \u043f\u0430\u043c\u044f\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0425\u0430\u0434\u0437\u0456\u0446\u0435, \u0435\u0448\u0446\u0435 \u0445\u043b\u0435\u0431 \u041c\u043e\u0439, \u043f\u0456\u0446\u0435 \u0432\u0456\u043d\u043e, \u044f\u043a\u043e\u0435 \u0432\u0430\u043c \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u043e\u0436\u043d\u044b \u0440\u0430\u0437.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"191","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0414\u044b\u044f\u043b\u043e\u0433\u0456 \u043f\u0440\u0430 \u0411\u043e\u0436\u044b \u041f\u0440\u043e\u0432\u0456\u0434\u00bb \u0441\u0432. \u041a\u0430\u0446\u044f\u0440\u044b\u043d\u044b \u0421\u0456\u0435\u043d\u0441\u043a\u0430\u0439, \u043f\u0430\u043d\u043d\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(4, 13: ed. latina, Ingolstadii 1583, ff. 19v-20)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u043e\u0432\u044f\u0437\u0456 \u043b\u044e\u0431\u043e\u0432\u0456<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041c\u043e\u0439 \u043d\u0430\u0439\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0435\u0439\u0448\u044b \u041f\u0430\u043d\u0435, \u0433\u043b\u044f\u043d\u044c \u0437 \u043b\u044e\u0431\u043e\u045e\u044e \u043d\u0430 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u043d\u0430 \u041c\u0456\u0441\u0442\u044b\u0447\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u042f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0443\u0441\u043b\u0430\u0432\u0456\u0446\u0446\u0430 \u0422\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043e\u0435 \u0456\u043c\u044f \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u044b\u0448 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456 \u0422\u0432\u0430\u0456\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e, \u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u043d\u0435, \u0431\u0435\u0434\u043d\u0430\u0439, \u044f\u043a\u0430\u044f \u0442\u0430\u043a \u043c\u043e\u0446\u043d\u0430 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u043b\u0430 \u0422\u0432\u0430\u044e \u0432\u0435\u043b\u0456\u0447. \u042f\u043a \u0436\u0430 \u044f \u043c\u0430\u0433\u043b\u0430 \u0431 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0431 \u0443\u0431\u0430\u0447\u044b\u043b\u0430 \u0441\u044f\u0431\u0435 \u0436\u044b\u0432\u043e\u0439, \u0430 \u0422\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u2013 \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u0441\u043c\u0435\u0440\u0446\u044e, \u043a\u0430\u043b\u0456 \u0431 \u0446\u0435\u043c\u0440\u0430 \u0433\u0440\u0430\u0445\u0443 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043c\u0430\u0451\u0439 \u043d\u044f\u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u043d\u044f\u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0456\u043d\u0448\u044b\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u0431 \u0422\u0432\u0430\u044e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0443\u044e \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0433\u043e\u0440\u0430\u0447\u0430 \u043f\u0440\u0430\u0448\u0443 \u0430\u0431 \u0442\u043e\u0439 \u043d\u0435\u0432\u044b\u043c\u043e\u045e\u043d\u0430\u0439 \u043b\u0430\u0441\u0446\u044b, \u043a\u0430\u0431 \u0422\u044b \u043f\u0440\u0430\u044f\u0432\u0456\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u045e \u0456\u043c\u044f \u0433\u044d\u0442\u0430\u0439 \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0430\u044f \u0441\u0445\u0456\u043b\u0456\u043b\u0430 \u0426\u044f\u0431\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u0441\u0432\u043e\u0439 \u0432\u043e\u0431\u0440\u0430\u0437 \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430. \u0406 \u0447\u0430\u043c\u0443 \u0436 \u0433\u044d\u0442\u0430, \u0441\u043a\u0430\u0436\u044b, \u0422\u044b \u0430\u0434\u0430\u0440\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e? \u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0442\u0430\u043a \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u0422\u044b \u045e\u0431\u0430\u0447\u044b\u045e \u0441\u0432\u0430\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u045e \u0441\u0430\u0431\u0435 \u0441\u0430\u043c\u0456\u043c \u0456 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0443 \u0456\u043c \u0430\u0441\u0430\u043b\u043e\u0434\u0443. \u0410\u0434\u043d\u0430\u043a \u044f \u0448\u0447\u044b\u0440\u0430 \u0432\u044b\u0437\u043d\u0430\u044e, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0433\u0440\u044d\u0445 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0434\u0430 \u044f\u043a\u043e\u0439 \u0431\u044b\u045e \u0443\u0437\u043d\u044f\u0442\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0410 \u0422\u044b, \u044f\u043a\u043e\u0433\u0430 \u0432\u044f\u043b\u0430 \u0442\u0430\u044f \u0441\u0430\u043c\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0456 \u044f\u043a\u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u045e \u0443 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u043f\u0430\u044f\u0434\u043d\u0430\u0446\u044c \u0437 \u0441\u0430\u0431\u043e\u044e \u043b\u044e\u0434\u0437\u0435\u0439, \u0434\u0430\u045e \u043d\u0430\u043c \u0421\u043b\u043e\u0432\u0430 \u2013 \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u041f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u043c \u043f\u0430\u043c\u0456\u0436 \u043d\u0430\u043c\u0456 \u0456 \u0422\u0430\u0431\u043e\u044e. \u0401\u043d \u0441\u0442\u0430\u045e \u043d\u0430\u0448\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e. \u0423 \u0441\u0430\u0431\u0435 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0443\u0441\u044e \u043d\u0430\u0448\u0443\u044e \u043d\u044f\u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u045e\u0441\u0435 \u0433\u0440\u0430\u0445\u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u0422\u044b, \u041d\u044f\u0431\u0435\u0441\u043d\u044b \u041e\u0439\u0447\u0430, \u0447\u0430\u043a\u0430\u045e \u0430\u0434 \u042f\u0433\u043e, \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u044e\u0447\u044b \u042f\u043c\u0443 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043d\u0430\u0448\u0443\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041e \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u0433\u043b\u044b\u0431\u0456\u043d\u044f \u043b\u044e\u0431\u043e\u0432\u0456! \u042f\u043a\u043e\u0435 \u0436 \u0441\u044d\u0440\u0446\u0430 \u043c\u043e\u0436\u0430 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0442\u0430\u043a\u0456\u043c \u0446\u0432\u0451\u0440\u0434\u044b\u043c \u0456 \u043d\u0435 \u0437\u0432\u0430\u0440\u0443\u0445\u043d\u0443\u0446\u0446\u0430, \u0456 \u043d\u0435 \u0437\u0430\u0434\u0440\u044b\u0436\u044d\u0446\u044c, \u0431\u0430\u0447\u0443\u0447\u044b, \u0448\u0442\u043e \u0442\u0430\u043a\u0430\u044f \u045e\u0437\u043d\u0451\u0441\u043b\u0430\u044f \u0432\u0435\u043b\u0456\u0447 \u0441\u044b\u0448\u043b\u0430 \u0434\u0430 \u0442\u0430\u043a\u043e\u0439 \u0431\u044f\u0437\u0434\u043e\u043d\u043d\u0430\u0439 \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u0430\u0441\u0446\u0456. \u0411\u043e \u0442\u0430\u043a\u043e\u0439 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0448\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041c\u044b \u2013 \u0422\u0432\u043e\u0439 \u0432\u043e\u0431\u0440\u0430\u0437, \u0430 \u0422\u044b \u2013 \u043d\u0430\u0448 \u043f\u0440\u0430\u0437 \u0435\u0434\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u0422\u044b \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u044e \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c. \u0422\u044b \u0441\u0445\u0430\u0432\u0430\u045e \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0443\u044e \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044c \u043f\u0430\u0434 \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u043c \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u043c \u0441\u043a\u0430\u0436\u043e\u043d\u0430\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b. \u041d\u0430\u0432\u043e\u0448\u0442\u0430? \u0422\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u0435\u043b\u044f \u0422\u0432\u0430\u0451\u0439 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0443\u044e \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0443 \u043f\u0430\u043a\u043e\u0440\u044b \u0456 \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b\u0430\u045e \u043c\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u043c\u0430\u043b\u044e \u0422\u0432\u0430\u044e \u0412\u0435\u043b\u0456\u0447 \u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0431\u0435\u0434\u043d\u044b\u043c \u0441\u0442\u0430\u0440\u044d\u043d\u043d\u044f\u043c \u0441\u0432\u0430\u044e \u043b\u0430\u0441\u043a\u0430\u0432\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 101 (100), 1-2\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u0431\u0443\u0434\u0443 \u0430\u043f\u044f\u0432\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435; \u0431\u0443\u0434\u0443 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0411\u0443\u0434\u0443 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0430\u0434 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c \u0448\u043b\u044f\u0445\u0430\u043c. \u041a\u0430\u043b\u0456 \u0436 \u0422\u044b \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u0448 \u0434\u0430 \u043c\u044f\u043d\u0435?<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u0443\u0434\u0443 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0443 \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u0443\u0434\u0443 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"192","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u041f\u0440\u0430 \u0411\u043e\u0436\u0430\u0435 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u00bb \u0422\u044d\u0430\u0434\u043e\u0440\u0430 \u041a\u0456\u0440\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 26-27: PG 75, 1466-1467)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u044b\u043b\u0435\u0447\u0443 \u0456\u0445\u043d\u0456\u044f \u0440\u0430\u043d\u044b<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0415\u0437\u0443\u0441 \u0434\u0430\u0431\u0440\u0430\u0432\u043e\u043b\u044c\u043d\u0430 \u0456\u0434\u0437\u0435 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u044b\u043c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u043c. \u0427\u0430\u0441\u0442\u0430 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u043f\u0440\u0430 \u0456\u0445. \u041d\u0430\u0432\u0430\u0442 \u0434\u0430\u043a\u0430\u0440\u044b\u045e \u041f\u044f\u0442\u0440\u0430, \u044f\u043a\u0456 \u0441\u043b\u0443\u0445\u0430\u045e \u043f\u0440\u0430 \u0456\u0445 \u0437 \u043d\u0435\u0430\u0445\u0432\u043e\u0442\u0430\u044e. \u0422\u043b\u0443\u043c\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443. \u0422\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0441\u0445\u0430\u043f\u0456\u0446\u044c \u042f\u0433\u043e, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u045e\u0441\u044f \u0434\u0430\u0431\u0440\u0430\u0432\u043e\u043b\u044c\u043d\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u042f \u2013 \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u0432\u044b \u0448\u0443\u043a\u0430\u0435\u0446\u0435\u00bb (\u043f\u0430\u0440. \u042f\u043d 18, 5). \u041a\u0430\u043b\u0456 \u042f\u0433\u043e \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u043b\u0456, \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e. \u0406 \u0445\u043e\u0446\u044c \u043c\u043e\u0433 \u0443\u043a\u0440\u044b\u0446\u0446\u0430, \u043d\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u045e. \u0410\u0434\u043d\u0430\u043a \u0440\u0430\u043d\u0435\u0439 \u0448\u043c\u0430\u0442\u0440\u0430\u0437\u043e\u0432\u0430 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u045e \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b\u0445 \u043d\u0430 \u042f\u0433\u043e \u043f\u0430\u0441\u0442\u0430\u043a.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0401\u043d \u043f\u043b\u0430\u0447\u0430 \u043d\u0430\u0434 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430\u043c, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043d\u044f\u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435, \u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430\u0435 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0441\u043b\u0430\u0432\u0443\u0442\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456. \u0426\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0443\u0434\u0430\u0440\u044b \u043f\u0430 \u0442\u0432\u0430\u0440\u044b \u0430\u0434 \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u0430 \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u0430\u0433\u0430 \u0441\u043b\u0443\u0433\u0456. \u042f\u0433\u043e \u0431\u2019\u044e\u0446\u044c \u043f\u0430 \u0442\u0432\u0430\u0440\u044b, \u0430\u043f\u043b\u0451\u045e\u0432\u0430\u044e\u0446\u044c, \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u044e\u0446\u044c, \u0437\u0434\u0437\u0435\u043a\u0443\u044e\u0446\u0446\u0430 \u043d\u0430\u0434 \u0406\u043c, \u0431\u0456\u0447\u0443\u044e\u0446\u044c, \u0432\u044b\u0434\u0430\u044e\u0446\u044c \u043d\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u043d\u0435. \u0414\u0432\u0443\u0445 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e \u043b\u0456\u0447\u044b\u0446\u044c \u0441\u044f\u0431\u0440\u0430\u043c\u0456 \u045e \u0441\u0432\u0430\u0456\u043c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0456; \u042f\u0433\u043e \u0437\u0430\u043b\u0456\u0447\u044b\u043b\u0456 \u0434\u0430 \u0440\u0430\u0437\u0431\u043e\u0439\u043d\u0456\u043a\u0430\u045e \u0456 \u0440\u0430\u0431\u0430\u045e\u043d\u0456\u043a\u043e\u045e. \u0401\u043d \u043f\u0440\u044b\u043c\u0430\u0435 \u0436\u043e\u045e\u0446\u044c \u0456 \u0432\u043e\u0446\u0430\u0442 \u0437 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0443. \u042f\u0433\u043e \u045e\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u0446\u0435\u0440\u043d\u0435\u043c \u0437\u0430\u043c\u0435\u0441\u0442 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u044b\u0445 \u0433\u0430\u043b\u0456\u043d\u0430\u043a \u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0443, \u0430\u0434\u0437\u0435\u043b\u0456 \u045e \u0447\u044b\u0440\u0432\u043e\u043d\u044b\u044f \u0448\u0430\u0442\u044b, \u043a\u0430\u0431 \u043d\u0430\u0441\u043c\u044f\u044f\u0446\u0446\u0430, \u042f\u0433\u043e \u0431\u2019\u044e\u0446\u044c \u0442\u0440\u044b\u0441\u0446\u0456\u043d\u0430\u0439, \u043f\u0440\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u0434\u0437\u0456\u0434\u0430\u0439, \u0430 \u043f\u0430\u0441\u043b\u044f \u043a\u043b\u0430\u0434\u0443\u0446\u044c \u0443 \u0433\u0440\u0430\u0431\u043d\u0456\u0446\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u0401\u043d \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0431\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u0437\u0433\u0440\u0430\u0448\u044b\u045e, \u0432\u0430\u0440\u0442\u044b\u044f \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u0401\u043d, \u043d\u0435 \u043c\u0430\u044e\u0447\u044b \u043d\u0456\u044f\u043a\u0430\u0439 \u043f\u0440\u0430\u0432\u0456\u043d\u044b, \u0441\u043f\u043e\u045e\u043d\u0456\u045e\u0448\u044b \u045e\u0441\u0451, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0435, \u043f\u0440\u044b\u043d\u044f\u045e \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430\u0435 \u0434\u043b\u044f \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e, \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u043f\u0440\u044b\u0441\u0443\u0434 \u0434\u0430\u045e\u043d\u044f\u0433\u0430 \u0430\u0434\u043a\u0456\u0434\u0432\u0430\u043d\u043d\u044f. \u00ab\u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u2013 \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, \u2013 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0430\u0434 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0443 \u0417\u0430\u043a\u043e\u043d\u0443, \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u043c \u0437\u0430 \u043d\u0430\u0441, \u0431\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u201c\u041f\u0440\u0430\u043a\u043b\u044f\u0442\u044b \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u0456\u0441\u0456\u0446\u044c \u043d\u0430 \u0434\u0440\u044d\u0432\u0435\u201d\u00bb (\u0413\u0430\u043b 3, 13; \u043f\u0430\u0440. \u0414\u0440\u0433 21, 23). \u041f\u0440\u0430\u0437 \u0446\u044f\u0440\u043d\u043e\u0432\u0443\u044e \u043a\u0430\u0440\u043e\u043d\u0443 \u0401\u043d \u0441\u043f\u044b\u043d\u0456\u045e \u043c\u0443\u0447\u044d\u043d\u043d\u0456 \u0410\u0434\u0430\u043c\u0430, \u044f\u043a\u0456 \u043f\u0430\u0441\u043b\u044f \u0433\u0440\u0430\u0445\u0443 \u043f\u0430\u0447\u0443\u045e \u0441\u043b\u043e\u0432\u044b: \u00ab\u041f\u0440\u0430\u043a\u043b\u044f\u0442\u0430\u044f \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0437\u044f\u043c\u043b\u044f \u043f\u0440\u0430\u0437 \u0446\u044f\u0431\u0435; \u0446\u0435\u0440\u043d\u0456 \u0456 \u0430\u0441\u043e\u0442 \u044f\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u0431\u0435 \u0440\u0430\u0441\u0446\u0456\u0446\u044c\u00bb (\u043f\u0430\u0440. \u0411\u044b\u0446 3, 17-18).<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0420\u0430\u0437\u0430\u043c \u0437 \u0436\u043e\u045e\u0446\u044e \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0456 \u043f\u043e\u045e\u043d\u044b\u043c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f \u0436\u044b\u0446\u0446\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0433\u043e\u0440\u043a\u0430\u0435 \u0456 \u0446\u044f\u0436\u043a\u043e\u0435. \u0420\u0430\u0437\u0430\u043c \u0437 \u0432\u043e\u0446\u0430\u0442\u0430\u043c \u043f\u0440\u044b\u043d\u044f\u045e \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0456\u0445 \u043d\u0430\u0437\u0430\u0434 \u0434\u0430 \u0441\u0442\u0430\u043d\u0443 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456. \u041f\u0443\u0440\u043f\u0443\u0440 \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u045e \u042f\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0442\u0440\u044b\u0441\u0446\u0456\u043d\u0430 \u2013 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0456 \u043d\u0435\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c \u0441\u0456\u043b\u044b \u0441\u0430\u0442\u0430\u043d\u044b. \u0428\u0447\u0430\u043a\u0430 \u0431\u044b\u043b\u0430 \u0437\u043d\u0430\u043a\u0430\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u044f. \u0401\u043d \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u043c\u0443\u0447\u044d\u043d\u043d\u0456, \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0456 \u045e\u0434\u0430\u0440\u044b, \u044f\u043a\u0456\u044f \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0456 \u043d\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0417 \u0430\u0434\u043a\u0440\u044b\u0442\u0430\u0433\u0430 \u0431\u043e\u043a\u0443 \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430, \u044f\u043a \u0443 \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u0410\u0434\u0430\u043c\u0430, \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u044f\u043a\u0430\u044f \u043f\u0440\u0430\u0437 \u0433\u0440\u044d\u0445 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u0441\u043c\u0435\u0440\u0446\u044c. \u0417 \u042f\u0433\u043e \u0430\u0434\u043a\u0440\u044b\u0442\u0430\u0433\u0430 \u0431\u043e\u043a\u0443 \u0432\u044b\u0446\u044f\u043a\u0430\u0435 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u0430\u044f \u0441\u0432\u0430\u0456\u043c \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u044b\u043c \u043f\u0430\u0442\u043e\u043a\u0430\u043c \u043d\u044f\u0441\u0435 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0435\u0442\u0443. \u0410\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435 \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442 \u0456 \u0430\u043f\u0440\u0430\u043d\u0430\u0435 \u045e \u0448\u0430\u0442\u044b \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456, \u0434\u0440\u0443\u0433\u0456 \u043a\u043e\u0440\u043c\u0456\u0446\u044c \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u0445 \u043b\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u0441\u0442\u0430\u043b\u0430 \u043d\u0430 \u045e\u0437\u043e\u0440 \u0434\u0437\u044f\u0446\u0435\u0439, \u044f\u043a\u0456\u0445 \u043a\u043e\u0440\u043c\u044f\u0446\u044c \u043c\u0430\u043b\u0430\u043a\u043e\u043c.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0406\u0441 53, 5; 1 \u041f 2, 24\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0401\u043d \u0437\u0440\u0430\u043d\u0435\u043d\u044b \u0431\u044b\u045e \u0437\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u043d\u0430\u0448\u044b\u044f, \u0440\u0430\u0437\u0434\u0430\u045e\u043b\u0435\u043d\u044b \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u0430\u0432\u0456\u043d\u044b.<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u041f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0441\u0432\u0435\u0442\u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u0430 \u0456\u043c, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u045e \u0440\u0430\u043d\u0430\u0445 \u044f\u0433\u043e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0434\u0430\u0440\u043e\u045e\u0435.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0401\u043d \u0441\u0430\u043c, \u0443 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u045e\u0437\u043d\u0451\u0441 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f \u043d\u0430 \u0434\u0440\u044d\u0432\u0430, \u043a\u0430\u0431 \u043c\u044b, \u043f\u0430\u0437\u0431\u044b\u045e\u0448\u044b\u0441\u044f \u0433\u0440\u0430\u0445\u043e\u045e, \u0436\u044b\u043b\u0456 \u0434\u0437\u0435\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u045e \u0440\u0430\u043d\u0430\u0445<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"193","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u041f\u0440\u0430 \u0411\u043e\u0436\u0430\u0435 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u00bb \u0422\u044d\u0430\u0434\u043e\u0440\u0430 \u041a\u0456\u0440\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 28: PG 75, 1467-1470)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423 \u0440\u0430\u043d\u0430\u0445 \u042f\u0433\u043e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0434\u0430\u0440\u043e\u045e\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041b\u0435\u043a\u0430\u043c \u0434\u043b\u044f \u043d\u0430\u0441 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b. \u041f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0432\u0443\u0447\u044b\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u043a, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0401\u043d \u0443\u0437\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456 \u0456 \u043f\u0430\u043d\u0451\u0441 \u043d\u0430\u0448\u044b \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456; \u0430 \u043c\u044b \u043f\u0440\u044b\u0437\u043d\u0430\u043b\u0456 \u042f\u0433\u043e \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b\u043c, \u043f\u0430\u0431\u0456\u0442\u044b\u043c \u0456 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u044b\u043c. \u0401\u043d \u0437\u0440\u0430\u043d\u0435\u043d\u044b \u0431\u044b\u045e \u0437\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u043d\u0430\u0448\u044b\u044f, \u0440\u0430\u0437\u0434\u0430\u045e\u043b\u0435\u043d\u044b \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u0430\u0432\u0456\u043d\u044b. \u041f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0441\u0432\u0435\u0442\u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u0430 \u0456\u043c, \u0456 \u045e \u0440\u0430\u043d\u0430\u0445 \u042f\u0433\u043e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0434\u0430\u0440\u043e\u045e\u0435. \u0423\u0441\u0435 \u043c\u044b \u0431\u043b\u0443\u043a\u0430\u043b\u0456, \u044f\u043a \u0430\u0432\u0435\u0447\u043a\u0456; \u0442\u0430\u043c\u0443, \u044f\u043a \u0430\u0432\u0435\u0447\u043a\u0443, \u043f\u0430\u0432\u044f\u043b\u0456 \u042f\u0433\u043e \u043d\u0430 \u0437\u0430\u0440\u044d\u0437, \u0401\u043d \u043c\u0430\u045e\u0447\u0430\u045e, \u044f\u043a \u044f\u0433\u043d\u0451, \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0441\u0442\u0440\u044b\u0436\u044d \u044f\u0433\u043e\u00bb (\u043f\u0430\u0440. \u0406\u0441 53, 4-7).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a \u043f\u0430\u0441\u0442\u044b\u0440, \u044f\u043a\u0456, \u0431\u0430\u0447\u0443\u0447\u044b \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a, \u0431\u044f\u0440\u044d \u0430\u0434\u043d\u0443 \u0456 \u0432\u044f\u0434\u0437\u0435 \u044f\u0435 \u043d\u0430 \u043f\u0430\u0448\u044b, \u044f\u043a\u0456\u044f \u0441\u0430\u043c \u0432\u044b\u0431\u0440\u0430\u045e, \u0430 \u0437\u0430 \u0451\u044e \u0456\u0434\u0437\u0435 \u0437\u0430 \u0456\u043c \u0443\u0432\u0435\u0441\u044c \u0441\u0442\u0430\u0442\u0430\u043a, \u0442\u0430\u043a \u0456 \u0411\u043e\u0433-\u0421\u043b\u043e\u0432\u0430, \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0431\u043b\u0443\u043a\u0430\u044e\u0447\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0440\u043e\u0434, \u043f\u0440\u044b\u043d\u044f\u045e \u0456 \u0441\u043f\u0430\u043b\u0443\u0447\u044b\u045e \u0437 \u0441\u0430\u0431\u043e\u044e \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456. \u0413\u044d\u0442\u044b\u043c \u0432\u044f\u0440\u043d\u0443\u045e \u0434\u0430 \u0441\u044f\u0431\u0435 \u045e\u0441\u0451 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u0456 \u043f\u0430\u0432\u0451\u045e \u043d\u0430 \u0411\u043e\u0436\u044b\u044f \u043f\u0430\u0448\u044b \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u043c\u0435\u043b\u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e \u0456 \u0431\u044b\u043b\u0456 \u0432\u044b\u0434\u0430\u0434\u0437\u0435\u043d\u044b\u044f \u043d\u0430 \u0437\u0434\u0430\u0431\u044b\u0447\u0443 \u0432\u0430\u045e\u043a\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443 \u043d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430 \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430\u0448\u0443\u044e \u043f\u0440\u044b\u0440\u043e\u0434\u0443, \u0442\u0430\u043c\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d \u043f\u0430\u0439\u0448\u043e\u045e \u043d\u0430 \u0437\u0431\u0430\u045e\u0447\u0443\u044e \u043c\u0443\u043a\u0443, \u0431\u044b\u045e \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b \u045e \u0433\u0440\u0430\u0431\u043d\u0456\u0446\u0443, \u0442\u0430\u043c\u0443 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0441\u0442\u0430\u0440\u0430\u0434\u0430\u045e\u043d\u044e\u044e \u043d\u044f\u0432\u043e\u043b\u044e, \u0430 \u0442\u043b\u0435\u043d\u043d\u044b\u043c \u0430\u0431\u044f\u0446\u0430\u045e \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c. \u0410\u0431\u043d\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u0456 \u0432\u044f\u0440\u0442\u0430\u044e\u0447\u044b \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0443\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0434\u0430\u045e \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c, \u044f\u043a\u0456\u044f \u0447\u0430\u043a\u0430\u043b\u0456 \u042f\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u044b\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0411\u043e, \u2013 \u043a\u0430\u0436\u0430, \u2013 \u044f\u043a \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u044f \u0430\u0434 \u0432\u0430\u0441 \u043f\u0440\u044b\u0440\u043e\u0434\u0430 \u043f\u0440\u0430\u0437 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0437 \u0411\u043e\u0433\u0430\u043c \u0456 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u0437 \u0406\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435, \u0430, \u043f\u0430\u0437\u0431\u044b\u045e\u0448\u044b\u0441\u044f \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u043a\u0443\u0442\u0430\u045e, \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0430 \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456, \u0442\u0430\u043a \u0456 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b \u0430\u0434 \u0436\u043e\u0440\u0441\u0442\u043a\u0430\u0439 \u043d\u044f\u0432\u043e\u043b\u0456 \u0441\u043c\u0435\u0440\u0446\u0456, \u0430, \u043f\u0430\u0437\u0431\u044b\u045e\u0448\u044b\u0441\u044f \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456 \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f, \u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0435\u0441\u044f \u045e \u0448\u0430\u0442\u044b \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0401\u043d \u043f\u0440\u0430\u0437 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u043b\u0430\u0441\u043a\u0443 \u0445\u0440\u043e\u0441\u0442\u0443 \u045e\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c. \u00ab\u0414\u044b\u043a \u0456\u0434\u0437\u0456\u0446\u0435, \u2013 \u043a\u0430\u0436\u0430, \u2013 \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u0439\u0446\u0435 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u0435 \u0456\u0445 \u0443 \u0456\u043c\u044f \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430, \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430\u00bb (\u041c\u0446 28, 19). \u0425\u0440\u043e\u0441\u0442 \u043d\u0456\u0431\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0456 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0441\u043c\u0435\u0440\u0446\u0456 \u041f\u0430\u043d\u0430. \u00ab\u0411\u043e \u043a\u0430\u043b\u0456 \u043c\u044b, \u2013 \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, \u2013 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u0437 \u0406\u043c \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u0441\u043c\u0435\u0440\u0446\u0456 \u042f\u0433\u043e\u043d\u0430\u0439, \u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f\u00bb (\u0420\u044b\u043c 6, 5).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042f\u043d 10, 15b. 18a; \u0415\u0440 12, 7\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0430\u0434\u0434\u0430\u044e \u0437\u0430 \u0430\u0432\u0435\u0447\u0430\u043a.<\/span><span style=\"color: #ff0000;\"> *<\/span><span> \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0434\u0431\u0456\u0440\u0430\u0435 \u044f\u0433\u043e \u045e \u041c\u044f\u043d\u0435, \u0430\u043b\u0435 \u042f \u0441\u0430\u043c \u0430\u0434\u0434\u0430\u044e \u044f\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u043f\u0430\u043a\u0456\u043d\u0443\u045e c\u0432\u043e\u0439 \u0434\u043e\u043c, \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0441\u0432\u0430\u044e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443. \u0410\u0434\u0434\u0430\u045e \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451, \u044f\u043a\u043e\u0435 \u043f\u0430\u043b\u044e\u0431\u0456\u045e, \u0443 \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0456\u0445\u0442\u043e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"194","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 47, 7: CCL 38, 543-545)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0430\u0434\u0437\u0435\u043c\u0446\u0435, \u0443\u0437\u044b\u0434\u0437\u0435\u043c \u043d\u0430 \u0433\u0430\u0440\u0443 \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u00ab\u042f\u043a \u043c\u044b \u0447\u0443\u043b\u0456, \u0442\u0430\u043a \u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0456\u00bb (\u041f\u0441 48 [47], 9). \u041e \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u041a\u0430\u0441\u0446\u0451\u043b! \u0423 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0447\u0430\u0441 \u0442\u044b \u043f\u0430\u0447\u0443\u045e, \u0443 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0447\u0430\u0441 \u0443\u0431\u0430\u0447\u044b\u045e! \u041f\u0430\u0447\u0443\u045e \u0443 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u044f\u0445, \u0431\u0430\u0447\u044b\u045e \u0443 \u0436\u044b\u0446\u0446\u0456; \u043f\u0430\u0447\u0443\u045e \u0443 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430\u0445, \u0431\u0430\u0447\u044b\u045e \u0443 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456. \u0411\u043e \u045e\u0441\u0451, \u0448\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430, \u0443\u0436\u043e \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u0430. \u041f\u0430\u0434\u044b\u043c\u0456 \u0432\u043e\u0447\u044b \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0441\u0432\u0435\u0442; \u0443\u0431\u0430\u0447 \u0441\u0432\u0430\u044e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443, \u044f\u043a\u0430\u044f \u0441\u044f\u0433\u0430\u0435 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456; \u0443\u0431\u0430\u0447, \u0448\u0442\u043e \u0441\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u044f\u043c\u0443 \u045e\u0441\u0435 \u043a\u0430\u0440\u0430\u043b\u0456, \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u044f\u043c\u0443\u00bb (\u041f\u0441 72 [71], 11). \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u044f\u043a \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u0441\u043b\u043e\u0432\u044b: \u00ab\u0411\u0443\u0434\u0437\u044c \u0443\u0437\u0432\u044f\u043b\u0456\u0447\u0430\u043d\u044b \u043f\u0430-\u043d\u0430\u0434 \u043d\u044f\u0431\u0451\u0441\u0430\u043c\u0456, \u0411\u043e\u0436\u0430, \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0451\u0439 \u2013 \u0422\u0432\u0430\u044f \u0441\u043b\u0430\u0432\u0430\u00bb (\u041f\u0441 108 [107], 6). \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0442\u0430\u0433\u043e, \u0447\u044b\u0435 \u0440\u0443\u043a\u0456 \u0456 \u043d\u043e\u0433\u0456 \u0431\u044b\u043b\u0456 \u043f\u0440\u0430\u0431\u0456\u0442\u044b\u044f \u0446\u0432\u0456\u043a\u0430\u043c\u0456, \u0447\u044b\u0435 \u043a\u043e\u0441\u0442\u043a\u0456 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u043b\u0456\u0447\u0430\u043d\u044b\u044f, \u0430\u0431 \u0447\u044b\u0451 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u043a\u0456\u0434\u0430\u043b\u0456 \u043b\u0451\u0441\u044b. \u0423\u0431\u0430\u0447, \u0448\u0442\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u0431\u0430\u0447\u044b\u043b\u0456 \u043f\u0440\u044b\u0431\u0456\u0442\u044b\u043c \u0434\u0430 \u043a\u0440\u044b\u0436\u0430; \u0443\u0431\u0430\u0447, \u0448\u0442\u043e \u0442\u043e\u0439, \u043a\u0456\u043c \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u043b\u0456, \u043a\u0430\u043b\u0456 \u0432\u0430\u043d\u0434\u0440\u0430\u0432\u0430\u045e \u043f\u0430 \u0437\u044f\u043c\u043b\u0456, \u0446\u044f\u043f\u0435\u0440 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u043d\u0435\u0431\u0435. \u0413\u043b\u044f\u0434\u0437\u0456, \u044f\u043a \u0441\u043f\u0430\u045e\u043d\u044f\u044e\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u044b: \u00ab\u0423\u0441\u043f\u043e\u043c\u043d\u044f\u0446\u044c \u0456 \u043d\u0430\u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u041f\u0430\u043d\u0430 \u045e\u0441\u0435 \u043c\u0435\u0436\u044b \u0437\u044f\u043c\u043b\u0456, \u0456 \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e \u045e\u0441\u0435 \u043f\u043b\u044f\u043c\u0451\u043d\u044b \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e\u00bb (\u041f\u0441 22 [21], 28). \u0413\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430, \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0439 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e: \u00ab\u042f\u043a \u043c\u044b \u0447\u0443\u043b\u0456, \u0442\u0430\u043a \u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0456\u00bb (\u041f\u0441 48 [47], 9).<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0433\u044d\u0442\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435\u0446\u0446\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e: \u00ab\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u0434\u0430\u0447\u043a\u0430, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0456 \u0441\u0445\u0456\u043b\u0456 \u0441\u0432\u0430\u0451 \u0432\u0443\u0445\u0430, \u0437\u0430\u0431\u0443\u0434\u0437\u044c \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439 \u0456 \u0434\u043e\u043c \u0442\u0432\u0430\u0439\u0433\u043e \u0430\u0439\u0446\u0430\u00bb (\u041f\u0441 45 [44], 11). \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0431\u0430\u0447\u044b\u0448, \u043f\u0430\u0437\u043d\u0435\u0439 \u043f\u0430\u0447\u0443\u0439 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0447\u0443\u043b\u0430. \u00ab\u041d\u0430\u0440\u043e\u0434, \u2013 \u043a\u0430\u0436\u0430, \u2013 \u044f\u043a\u043e\u0433\u0430 \u042f \u043d\u0435 \u0432\u0435\u0434\u0430\u045e, \u0431\u0443\u0434\u0437\u0435 \u041c\u043d\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c; \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u041c\u043d\u0435 \u043d\u0430 \u0437\u0430\u043a\u043b\u0456\u043a\u00bb (\u043f\u0430\u0440. \u041f\u0441 18 [17], 44-45). \u041a\u0430\u043b\u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u043d\u0430\u0432\u0430\u0442 \u043d\u0430 \u0437\u0430\u043a\u043b\u0456\u043a, \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043d\u0435 \u0431\u0430\u0447\u044b\u045e. \u0422\u043e \u0434\u0437\u0435 \u0436 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u0441\u043b\u043e\u0432\u044b: \u00ab\u0423\u0431\u0430\u0447\u0430\u0446\u044c \u044f\u043d\u044b \u0442\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u0456\u043c \u043d\u0435 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430, \u0456 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0447\u0443\u043b\u0456\u00bb (\u0406\u0441 52, 15)? \u041f\u0435\u0440\u0448\u044b\u043c\u0456 \u043f\u0430\u0447\u0443\u043b\u0456 \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0442\u044b\u044f, \u0434\u0430 \u043a\u0430\u0433\u043e \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u043d\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u044b\u044f; \u0442\u044b\u044f \u0436, \u0445\u0442\u043e \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043d\u0435 \u0447\u0443\u045e, \u043f\u0430\u0441\u043b\u044f, \u0441\u043b\u0443\u0445\u0430\u044e\u0447\u044b, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456. \u0410 \u0442\u044b\u044f, \u0434\u0430 \u043a\u0430\u0433\u043e \u0431\u044b\u043b\u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u044b\u044f \u043f\u0440\u0430\u0440\u043e\u043a\u0456, \u044f\u043d\u044b \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0431\u044b\u043b\u0456 \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b\u044f. \u041d\u0430\u0441\u0456\u043b\u0456 \u043a\u043d\u0456\u0433\u0456, \u0430\u043b\u0435 \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456 \u043f\u0440\u0430\u045e\u0434\u044b; \u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0441\u043a\u0440\u044b\u0436\u0430\u043b\u0456 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0430\u043b\u0435 \u043d\u0435 \u043c\u0435\u043b\u0456 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b. \u041c\u044b \u0436 \u00ab\u044f\u043a \u0447\u0443\u043b\u0456, \u0442\u0430\u043a \u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0456\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u00ab\u0423 \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0443 \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430\u00bb (\u041f\u0441 48 [47], 9). \u0422\u0430\u043c \u043f\u0430\u0447\u0443\u043b\u0456 \u0456 \u0442\u0430\u043c \u0443\u0431\u0430\u0447\u044b\u043b\u0456. \u00ab\u0411\u043e\u0433 \u0443\u043c\u0430\u0446\u0443\u0435 \u044f\u0433\u043e \u043d\u0430\u0432\u0435\u043a\u0456\u00bb (\u041f\u0441 48 [47], 9). \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u045e\u0437\u0432\u044b\u0448\u0430\u044e\u0446\u0446\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u043a\u0430\u0436\u0430: \u00ab\u0412\u043e\u0441\u044c \u0442\u0443\u0442 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0432\u043e\u0441\u044c \u0442\u0430\u043c\u00bb. \u0422\u043e\u0439, \u0445\u0442\u043e \u043a\u0430\u0436\u0430: \u00ab\u0412\u043e\u0441\u044c \u0442\u0443\u0442, \u0432\u043e\u0441\u044c \u0442\u0430\u043c\u00bb, \u0441\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u043f\u0430\u0434\u0437\u0435\u043b\u044b. \u0410 \u0411\u043e\u0433 \u0430\u0431\u044f\u0446\u0430\u045e \u0435\u0434\u043d\u0430\u0441\u0446\u044c: \u00ab\u0432\u043e\u0441\u044c \u0441\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u043a\u0430\u0440\u0430\u043b\u0456\u00bb (\u043f\u0430\u0440. \u041f\u0441 48 [47], 5) \u0456 \u043d\u0435 \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456\u0441\u044f \u0437-\u0437\u0430 \u043f\u0430\u0434\u0437\u0435\u043b\u0430\u045e. \u0410 \u043c\u043e\u0436\u0430 \u0433\u044d\u0442\u044b \u0433\u043e\u0440\u0430\u0434, \u044f\u043a\u0456 \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u045e \u043d\u0430\u0434 \u0441\u0432\u0435\u0442\u0430\u043c, \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b? \u041d\u0456\u043a\u043e\u043b\u0456: \u00ab\u0411\u043e\u0433 \u0443\u043c\u0430\u0446\u0443\u0435 \u044f\u0433\u043e \u043d\u0430\u0432\u0435\u043a\u0456\u00bb (\u041f\u0441 48 [47], 9). \u041a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0443\u043c\u0430\u0446\u0443\u0435 \u044f\u0433\u043e \u043d\u0430\u0432\u0435\u043a\u0456, \u0447\u0430\u043c\u0443 \u0436 \u0442\u044b \u0431\u0430\u0456\u0448\u0441\u044f, \u0448\u0442\u043e \u043d\u0435 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u044b?<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041b\u0435\u0432 26, 11-12; 2 \u041a\u0430\u0440 6, 16b<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417\u043c\u044f\u0448\u0447\u0443 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0441\u0432\u0430\u044e \u0441\u043a\u0456\u043d\u0456\u044e \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443 \u0432\u0430\u043c\u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0446\u044c; <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u0443\u0434\u0443 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0456 \u0431\u0443\u0434\u0443 \u0432\u0430\u0448\u044b\u043c \u0411\u043e\u0433\u0430\u043c, \u0430 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041c\u044b \u2013 \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0436\u044b\u0432\u043e\u0433\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u0411\u043e\u0433.<\/span><span style=\"color: #ff0000;\"> \u041d.<\/span><span> \u0411\u0443\u0434\u0443.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"195","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u0410\u0431 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456\u00bb \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0437 \u041d\u0456\u0441\u044b, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(PG 46, 259-262)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u2013 \u043d\u0430\u0448 \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u043d\u0430\u0448\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0401\u043d \u2013 \u0441\u043f\u0430\u043a\u043e\u0439 \u043d\u0430\u0448, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0430\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435 \u0430\u0434\u0437\u0456\u043d\u044b\u043c\u00bb (\u042d\u0444 2, 14). \u0423\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u044e\u0447\u044b, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u043f\u0430\u043a\u043e\u0435\u043c, \u043c\u044b \u0430\u0434\u043a\u0440\u044b\u0435\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0456\u043c\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u044b \u0441\u043f\u0430\u043a\u043e\u0439, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0443 \u043d\u0430\u0441, \u043c\u044b \u043f\u0430\u043a\u0430\u0436\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u043d\u0430\u0448\u044b\u043c \u0436\u044b\u0446\u0446\u0456. \u00ab\u0401\u043d \u0437\u0430\u0431\u0456\u045e \u0443 \u0441\u0430\u0431\u0435 \u0432\u0430\u0440\u043e\u0436\u0430\u0441\u0446\u044c\u00bb (\u043f\u0430\u0440. \u042d\u0444 2, 16), \u2013 \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u043c, \u043a\u0430\u0431 \u044f\u043d\u0430 \u0430\u0434\u0436\u044b\u043b\u0430 \u045e \u043d\u0430\u0441 \u0437\u043d\u043e\u045e, \u0430\u043b\u0435 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043f\u0430\u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u044f\u043d\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u0430 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u044f\u043d\u0430 \u0431\u044b\u043b\u0430 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0411\u043e\u0433\u0430\u043c, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430 \u0432\u044f\u0440\u0442\u0430\u0446\u044c \u044f\u0435 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u043d\u0430 \u0441\u0432\u0430\u044e \u0437\u0433\u0443\u0431\u0443 \u043f\u0440\u0430\u0437 \u0433\u043d\u0435\u045e \u0456 \u043f\u0430\u043c\u044f\u0446\u044c \u043f\u0440\u0430 \u0437\u043d\u044f\u0432\u0430\u0433\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u043f\u0430\u043a\u043e\u0435\u043c, \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u043d\u0430\u0441, \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430\u0431\u2019\u0451\u043c \u0443 \u0441\u0430\u0431\u0435 \u0432\u0430\u0440\u043e\u0436\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u0443 \u043d\u0430\u0448\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u0442\u043e\u0435, \u0448\u0442\u043e \u2013 \u044f\u043a \u0432\u0435\u0440\u044b\u043c \u2013 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u045e \u0406\u043c. \u042f\u043a \u0401\u043d \u0437\u0431\u0443\u0440\u044b\u045e \u043c\u0443\u0440, \u0448\u0442\u043e \u043f\u0430\u0434\u0437\u044f\u043b\u044f\u045e \u0434\u0432\u0430 \u043d\u0430\u0440\u043e\u0434\u044b, \u0430, \u0437\u2019\u044f\u0434\u043d\u0430\u045e\u0448\u044b \u0456\u0445 \u0443 \u0441\u0430\u0431\u0435, \u0443 \u0430\u0434\u043d\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u045e\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u045e \u0441\u043f\u0430\u043a\u043e\u0439, \u0442\u0430\u043a \u0456 \u043c\u044b \u045e\u0441\u0442\u0430\u043b\u044e\u0435\u043c \u0441\u043f\u0430\u043a\u043e\u0439 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0437 \u043d\u0430\u043c\u0456 \u0437\u0432\u043e\u043d\u043a\u0443, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u043f\u0430\u0434\u044b\u043c\u0430\u0435 \u0431\u0443\u043d\u0442 \u0443\u043d\u0443\u0442\u0440\u044b, \u043a\u0430\u0431 \u0446\u0435\u043b\u0430 \u043d\u0435 \u0437\u043c\u0430\u0433\u0430\u043b\u0430\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0434\u0443\u0445\u0430, \u0430 \u0434\u0443\u0445 \u2013 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u0435\u043b\u0430. \u041f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u045e\u0448\u044b \u0411\u043e\u0436\u0430\u043c\u0443 \u0437\u0430\u043a\u043e\u043d\u0443 \u0446\u044f\u043b\u0435\u0441\u043d\u0443\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0441\u0442\u0430\u045e\u0448\u044b \u043d\u043e\u0432\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u044f\u043a\u0456 \u043d\u044f\u0441\u0435 \u0441\u043f\u0430\u043a\u043e\u0439, \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0435\u043d\u044b\u044f \u0437 \u0434\u0432\u0443\u0445 \u0443 \u0430\u0434\u043d\u043e, \u0431\u0443\u0434\u0437\u0435\u043c \u043c\u0435\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u0441\u043f\u0430\u043a\u043e\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u0430\u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0441\u043f\u0430\u043a\u043e\u044e: \u0437\u0433\u043e\u0434\u0430 \u043f\u0430\u043c\u0456\u0436 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0431\u044b\u045e \u043f\u0430\u0434\u0437\u0435\u043b\u0435\u043d\u044b. \u041a\u0430\u043b\u0456 \u045e \u043d\u0430\u0441 \u0441\u043f\u044b\u043d\u044f\u0435\u0446\u0446\u0430 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0430\u044f \u0432\u0430\u0439\u043d\u0430, \u0442\u0430\u0434\u044b, \u043c\u0430\u044e\u0447\u044b \u0441\u043f\u0430\u043a\u043e\u0439, \u043c\u044b \u0441\u0430\u043c\u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u043c\u0441\u044f \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u0456 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u043c, \u0448\u0442\u043e \u0456\u043c\u044f, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u0443, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u0430 \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0434\u0430 \u043d\u0430\u0441.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u044e\u0447\u044b, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0432\u043e\u043b\u044c\u043d\u044b\u043c \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043c\u0430\u043d\u044b, \u043c\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u043c, \u0448\u0442\u043e \u0456 \u043d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f \u043f\u0440\u043e\u043c\u043d\u044f\u043c\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430. \u0412\u043e\u0441\u044c \u0436\u0430 \u043f\u0440\u043e\u043c\u043d\u044f\u043c\u0456 \u00ab\u0421\u043e\u043d\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456\u00bb \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0446\u043d\u043e\u0442\u044b, \u044f\u043a\u0456\u044f \u0437\u0437\u044f\u044e\u0446\u044c \u0443 \u0441\u0432\u0435\u0446\u0435, \u043a\u0430\u0431 \u043c\u044b, \u0430\u0434\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u00ab\u045e\u0447\u044b\u043d\u043a\u0456 \u0446\u0435\u043c\u0440\u044b, \u044f\u043a \u0443 \u0434\u0437\u0435\u043d\u044c, \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043b\u0456 \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u0441\u0442\u043e\u0439\u043d\u0430\u00bb (\u043f\u0430\u0440. \u0420\u044b\u043c 13, 13). \u0410\u0434\u043a\u0456\u043d\u0435\u043c \u0441\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0443\u0441\u0451 \u045e \u0441\u0432\u044f\u0442\u043b\u0435 \u0434\u043d\u044f. \u0422\u0430\u0434\u044b \u0441\u0430\u043c\u0456 \u0441\u0442\u0430\u043d\u0435\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0456, \u2013 \u044f\u043a \u0433\u044d\u0442\u0430 \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u0441\u0432\u044f\u0442\u043b\u0443, \u2013 \u0431\u0443\u0434\u0437\u0435\u043c \u0430\u0441\u0432\u044f\u0447\u0430\u0446\u044c \u0456\u043d\u0448\u044b\u0445 \u043d\u0430\u0448\u044b\u043c\u0456 \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u043a\u0430\u043b\u0456 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u043c, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u2013 \u0433\u044d\u0442\u0430 \u043d\u0430\u0448\u0430\u0435 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435, \u0442\u0430\u0434\u044b, \u0443\u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u043b\u0456\u0445\u0456\u0445 \u0434\u0443\u043c\u0430\u043a \u0456 \u0447\u044b\u043d\u0430\u045e, \u043c\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0441\u0442\u0430\u043d\u0435\u043c \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0456\u043c\u044f,&nbsp; \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u0441\u0456\u043b\u0443 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456, \u0430 \u043d\u0435 \u0441\u043b\u043e\u0432\u0430\u043c.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041b\u043a 1, 78. 79\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0430\u0432\u0435\u0434\u0430\u045e \u043d\u0430\u0441 \u0423\u0441\u0445\u043e\u0434 \u0437 \u0432\u044b\u0448\u044b\u043d\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u043d\u0430\u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u043d\u043e\u0433\u0456 \u043d\u0430\u0448\u044b\u044f \u043d\u0430 \u0448\u043b\u044f\u0445 \u0441\u043f\u0430\u043a\u043e\u044e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u0431 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u0443 \u0446\u0435\u043c\u0440\u044b \u0456 \u045e \u0446\u0435\u043d\u0456 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u0431 \u043d\u0430\u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"196","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u00ab\u041f\u0440\u0430 \u0445\u0440\u043e\u0441\u0442\u00bb \u0441\u0432. \u041f\u0430\u0446\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 5-6: PL 13, 1092-1093)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u043c\u044b \u0432\u044f\u0434\u0437\u0435\u043c \u043d\u043e\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0425\u0440\u044b\u0441\u0446\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u0440\u044d\u0445 \u0410\u0434\u0430\u043c\u0430 \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e \u043d\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439: \u00ab\u042f\u043a \u043f\u0440\u0430\u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u2013 \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u2013 \u0433\u0440\u044d\u0445 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0441\u0432\u0435\u0442 \u0456 \u043f\u0440\u0430\u0437 \u0433\u0440\u044d\u0445 \u2013 \u0441\u043c\u0435\u0440\u0446\u044c, \u0442\u0430\u043a \u0456 \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0430 \u043d\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439\u00bb (\u0420\u044b\u043c 5, 12). \u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0430 \u043d\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u0411\u043e \u044f\u043a \u0410\u0434\u0430\u043c \u043f\u0440\u0430\u0437 \u0433\u0440\u044d\u0445 \u043f\u0440\u044b\u043d\u0451\u0441 \u0437\u0433\u0443\u0431\u0443 \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u043c, \u0442\u0430\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u045e\u0441\u0456\u043c \u0441\u0432\u0430\u0451 \u0432\u044b\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0432\u0430\u0435 \u0433\u044d\u0442\u0430 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: \u00ab\u042f\u043a \u043f\u0440\u0430\u0437 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043c\u043d\u043e\u0433\u0456\u044f \u0441\u0442\u0430\u043b\u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u043c\u0456, \u0442\u0430\u043a \u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u043c\u043d\u043e\u0433\u0456\u044f \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c\u0456; \u044f\u043a \u0433\u0440\u044d\u0445 \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u045e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u043c\u0435\u0440\u0446\u0456, \u0442\u0430\u043a \u0456 \u043b\u0430\u0441\u043a\u0430 \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0430 \u043f\u0440\u0430\u0437 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430\u00bb (\u0420\u044b\u043c 5, 19. 21).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0442\u043e\u0441\u044c\u0446\u0456 \u0441\u043a\u0430\u0436\u0430 \u043c\u043d\u0435: \u00ab\u0413\u0440\u044d\u0445 \u0410\u0434\u0430\u043c\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e \u043d\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0431\u043e \u045e\u0441\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0434 \u044f\u0433\u043e; \u0430 \u0446\u0456 \u0436 \u043c\u044b \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043c \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u043f\u0440\u0430\u0432\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0430\u0434 \u042f\u0433\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435?\u00bb \u041d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0433\u044d\u0442\u0430 \u045e \u0444\u0456\u0437\u0456\u0447\u043d\u044b\u043c \u0441\u044d\u043d\u0441\u0435. \u042f \u043f\u0430\u043a\u0430\u0436\u0443 \u0432\u0430\u043c, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u043c\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f. \u0423 \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0447\u0430\u0441\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043d\u044f\u045e \u0434\u0443\u0448\u0443 \u0456 \u0446\u0435\u043b\u0430 \u0437 \u041c\u0430\u0440\u044b\u0456. \u041f\u0440\u044b\u0439\u0448\u043e\u045e \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0446\u0435\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u044f\u0433\u043e \u045e \u0430\u0434\u0445\u043b\u0430\u043d\u0456, \u0437\u043b\u0443\u0447\u044b\u045e \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0434\u0443\u0445\u0430\u043c \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u044f\u0433\u043e \u0441\u0432\u0430\u0456\u043c. \u0413\u044d\u0442\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0437\u0430\u0440\u0443\u0447\u044b\u043d\u044b \u041f\u0430\u043d\u0430, \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u044b\u044f \u045e \u0430\u0434\u043d\u044b\u043c \u0446\u0435\u043b\u0435, \u043a\u0430\u0431 \u043c\u043e\u0446\u0430\u044e \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0441\u0442\u0430\u043b\u0456 \u0434\u0432\u043e\u0435 \u045e \u0430\u0434\u043d\u044b\u043c \u0446\u0435\u043b\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417 \u0433\u044d\u0442\u044b\u0445 \u0437\u0430\u0440\u0443\u0447\u044b\u043d\u0430\u045e, \u043d\u0430 \u044f\u043a\u0456\u044f \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0414\u0443\u0445 \u041f\u0430\u043d\u0430, \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456 \u043d\u0430\u0440\u043e\u0434. \u041f\u0440\u0430\u0437 \u0441\u043f\u0430\u043b\u0443\u0447\u044d\u043d\u043d\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0437 \u0434\u0443\u0448\u043e\u0439 \u043c\u044b \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0435\u043c \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u043c\u0430\u0446\u0456; \u0430 \u043f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b \u043d\u0430 \u0441\u0432\u0435\u0442, \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0436\u044b\u0446\u0446\u0451 \u045e \u0425\u0440\u044b\u0441\u0446\u0435. \u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: \u00ab\u041f\u0435\u0440\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0410\u0434\u0430\u043c \u0441\u0442\u0430\u045e \u0436\u044b\u0432\u043e\u0439 \u0456\u0441\u0442\u043e\u0442\u0430\u0439, \u0430\u043f\u043e\u0448\u043d\u0456 \u0410\u0434\u0430\u043c \u2013 \u0436\u044b\u0432\u0430\u0442\u0432\u043e\u0440\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c\u00bb (1 \u041a\u0430\u0440 15, 45). \u0412\u043e\u0441\u044c \u0442\u0430\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u0441\u0432\u0430\u0456\u0445 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0442\u0430\u0433\u043e \u0436 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430: \u00ab\u042f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u0432\u0430\u0441 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435\u00bb (1 \u041a\u0430\u0440 4, 15). \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043c\u043e\u0446\u0430\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u043a\u043b\u0456\u0447\u0430 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043d\u043e\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430; \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0451\u043d \u043b\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0445\u0440\u043e\u0441\u0442\u0443 \u043d\u0430 \u0440\u0443\u043a\u0430\u0445 \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u0401\u043d \u043c\u043e\u0433 \u043d\u0430\u0441 \u0430\u0434\u0440\u0430\u0434\u0437\u0456\u0446\u044c. \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u042f\u043d \u0442\u0430\u043a \u043a\u0430\u0436\u0430: \u00ab\u0422\u044b\u043c, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u042f\u0433\u043e, \u0434\u0430\u043b\u043e \u045e\u043b\u0430\u0434\u0443 \u0441\u0442\u0430\u0446\u044c \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456\u00bb (\u042f\u043d 1, 12). \u0413\u044d\u0442\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0430\u0434\u0431\u044b\u0446\u0446\u0430 \u0456\u043d\u0430\u043a\u0448, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u044b \u0445\u0440\u043e\u0441\u0442\u0443 \u0456 \u043a\u0430\u043d\u0444\u0456\u0440\u043c\u0430\u0446\u044b\u0456 \u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0433\u0443 \u0431\u0456\u0441\u043a\u0443\u043f\u0430. \u0425\u0440\u043e\u0441\u0442 \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e, \u043a\u0430\u043d\u0444\u0456\u0440\u043c\u0430\u0446\u044b\u044f \u0434\u0430\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0456 \u0430\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0433\u0443 \u0440\u0443\u043a \u0456 \u0432\u0443\u0441\u043d\u0430\u045e \u0431\u0456\u0441\u043a\u0443\u043f\u0430. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0443\u0432\u0435\u0441\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u043d\u043e\u0432\u0430 \u0456 \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u00ab\u043a\u0430\u0431, \u044f\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u0442\u0430\u043a \u0456 \u043d\u0430\u043c \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0430\u0431\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456\u00bb (\u0420\u044b\u043c 6, 4). \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043a\u0430\u0431 \u043c\u044b, \u043f\u0430\u0437\u0431\u044b\u045e\u0448\u044b\u0441\u044f \u043f\u0430\u043c\u044b\u043b\u0430\u043a \u0434\u0430\u045e\u043d\u044f\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0414\u0443\u0445\u0430 \u0432\u044f\u043b\u0456 \u043d\u043e\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0425\u0440\u044b\u0441\u0446\u0435.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0420\u044b\u043c 5, 19. 21; 1 \u042f\u043d 4, 10&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e \u044f\u043a \u043f\u0440\u0430\u0437 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043c\u043d\u043e\u0433\u0456\u044f \u0441\u0442\u0430\u043b\u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u043c\u0456, \u0442\u0430\u043a \u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u043c\u043d\u043e\u0433\u0456\u044f \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431, \u044f\u043a \u0433\u0440\u044d\u0445 \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u045e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u043c\u0435\u0440\u0446\u0456, \u0442\u0430\u043a \u0456 \u043b\u0430\u0441\u043a\u0430 \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0430 \u043f\u0440\u0430\u0437 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u041f\u0430\u0441\u043b\u0430\u045e \u0411\u043e\u0433 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u0431.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"197","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u00ab\u041f\u0440\u0430 \u0445\u0440\u043e\u0441\u0442\u00bb \u0441\u0432. \u041f\u0430\u0446\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 6-7: PL 13, 1093-1094)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0442\u043e \u0436, \u0411\u043e\u0436\u0430, \u0451\u0441\u0446\u044c \u044f\u043a \u0422\u044b, \u044f\u043a\u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u0435\u0448 \u0431\u0435\u0437\u0430\u043a\u043e\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041f\u0435\u0440\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437 \u0437\u044f\u043c\u043b\u0456 \u0451\u0441\u0446\u044c \u043f\u044b\u043b\u0430\u043c; \u0434\u0440\u0443\u0433\u0456 \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u2013 \u0437 \u043d\u0435\u0431\u0430. \u042f\u043a \u043c\u044b \u043d\u0430\u0441\u0456\u043b\u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437 \u043f\u044b\u043b\u0443, \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u0456\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430\u00bb (1 \u041a\u0430\u0440 15, 47. 49). \u0411\u0440\u0430\u0442\u044b \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0447\u044b, \u043c\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u0435\u043c \u0441\u043c\u0435\u0440\u0446\u0456. \u0410 \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0437\u044f\u043c\u043d\u043e\u0435 \u0446\u0435\u043b\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u044b\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0442\u044b\u043c, \u0448\u0442\u043e \u0401\u043d \u0441\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0425\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u041c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0456 \u043f\u0430\u043c\u0440\u044d, \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c\u00bb (\u042f\u043d 11, 25).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u043c\u044b \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0435\u043c \u043d\u0430 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u041f\u0430\u043d\u0430, \u0448\u0442\u043e \u0410\u0431\u0440\u0430\u0433\u0430\u043c, \u0406\u0441\u0430\u0430\u043a, \u042f\u043a\u0443\u0431, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u0435 \u0441\u0432\u044f\u0442\u044b\u044f \u0411\u043e\u0436\u044b\u044f \u0436\u044b\u0432\u0443\u0446\u044c \u043d\u0430\u0434\u0430\u043b\u0435\u0439. \u0413\u044d\u0442\u0430 \u043f\u0440\u0430 \u0456\u0445 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0423\u0441\u0435 \u0436\u044b\u0432\u0443\u0446\u044c \u0434\u043b\u044f \u042f\u0433\u043e; \u0411\u043e\u0433 \u043d\u0435 \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0430 \u0436\u044b\u0432\u044b\u0445\u00bb (\u043f\u0430\u0440. \u041c\u0446 22, 32). \u041f\u0440\u0430 \u0441\u044f\u0431\u0435 \u0436 \u0441\u0430\u043c \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: \u00ab\u0414\u043b\u044f \u043c\u044f\u043d\u0435 \u0436\u044b\u0446\u0446\u0451 \u2013 \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u2013 \u0433\u044d\u0442\u0430 \u0432\u044b\u0433\u0430\u0434\u0430, \u043c\u0430\u044e \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0456 \u0431\u044b\u0446\u044c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c\u00bb (\u043f\u0430\u0440. \u0424\u043b\u043f 1, 21-23). \u0406 \u044f\u0448\u0447\u044d: \u00ab\u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435\u043c \u0443 \u0446\u0435\u043b\u0435, \u043c\u044b \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u041f\u0430\u043d\u0430, \u0431\u043e \u0436\u044b\u0432\u0451\u043c \u0432\u0435\u0440\u0430\u044e, \u0430 \u043d\u0435 \u0431\u0430\u0447\u0430\u043d\u043d\u0435\u043c\u00bb (2 \u041a\u0430\u0440 5, 6). \u0413\u044d\u0442\u0430 \u043d\u0430\u0448\u0430 \u0432\u0435\u0440\u0430, \u0431\u0440\u0430\u0442\u044b \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f. \u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e: \u00ab\u041a\u0430\u043b\u0456 \u043c\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0451\u043c\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u0442\u043e \u043c\u044b \u0441\u0430\u043c\u044b\u044f \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u044f \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439\u00bb (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 15, 19). \u041d\u0430\u0448\u0430\u0435 \u0437\u044f\u043c\u043d\u043e\u0435 \u0436\u044b\u0446\u0446\u0451, \u2013 \u044f\u043a \u0432\u044b \u0441\u0430\u043c\u0456 \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u2013 \u0442\u0440\u044b\u0432\u0430\u0435 \u0442\u0430\u043a \u0434\u043e\u045e\u0433\u0430, \u044f\u043a \u0437\u0432\u044f\u0440\u043e\u045e \u0446\u0456 \u043f\u0442\u0443\u0448\u0430\u043a, \u0430\u0431\u043e \u043d\u0430\u0432\u0430\u0442 \u0456 \u043c\u0435\u043d\u0448. \u0412\u044b\u043a\u043b\u044e\u0447\u043d\u0430\u0439 \u0443\u043b\u0430\u0441\u0446\u0456\u0432\u0430\u0441\u0446\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u043a\u0430\u043b\u0456 \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u043c. \u042f\u043a \u0433\u0440\u044d\u0445 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u0442\u0430\u043a \u0446\u043d\u043e\u0442\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0430\u0434 \u044f\u0435. \u0416\u044b\u0446\u0446\u0451 \u0433\u0443\u0431\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435; \u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0446\u043d\u043e\u0446\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430. \u00ab\u0420\u0430\u0441\u043f\u043b\u0430\u0442\u0430 \u0437\u0430 \u0433\u0440\u044d\u0445 \u2013 \u0441\u043c\u0435\u0440\u0446\u044c, \u0430 \u0434\u0430\u0440 \u0411\u043e\u0433\u0430 \u2013 \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u041f\u0430\u043d\u0443 \u043d\u0430\u0448\u044b\u043c\u00bb (\u0420\u044b\u043c 6, 23).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0401\u043d \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441, \u044f\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: \u00ab\u0401\u043d \u0434\u0430\u0440\u0430\u0432\u0430\u045e \u0443\u0441\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u044b, \u0441\u0446\u0451\u0440 \u0437\u0430\u043f\u0456\u0441 \u043d\u0430\u0448\u044b\u0445 \u0434\u0430\u045e\u0433\u043e\u045e, \u044f\u043a\u0456 \u0431\u044b\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441, \u0456 \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u045e \u044f\u0433\u043e, \u043f\u0440\u044b\u0431\u0456\u045e\u0448\u044b \u0434\u0430 \u043a\u0440\u044b\u0436\u0430. \u0420\u0430\u0437\u0437\u0431\u0440\u043e\u0456\u045e \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0456 \u0456 \u045e\u043b\u0430\u0434\u044b, \u0432\u044b\u0441\u0442\u0430\u0432\u0456\u045e \u0456\u0445 \u043d\u0430\u043f\u0430\u043a\u0430\u0437, \u0442\u0440\u044b\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0448\u044b \u0456\u0445\u00bb (\u043f\u0430\u0440. \u041a\u043b\u0441 2, 13-15). \u0412\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u0445, \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u043d\u0430\u0448\u044b\u044f \u043a\u0430\u0439\u0434\u0430\u043d\u044b, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0414\u0430\u0432\u0456\u0434\u0430: \u00ab\u041f\u0430\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435 \u0432\u044f\u0437\u043d\u044f\u045e, \u041f\u0430\u043d \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0441\u043b\u044f\u043f\u044b\u043c, \u041f\u0430\u043d \u0443\u0437\u043d\u0456\u043c\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u044b\u0445\u00bb (\u041f\u0441 146 [145], 7-8). \u0406 \u044f\u0448\u0447\u044d: \u00ab\u0422\u044b \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u043c\u0430\u0435 \u043a\u0430\u0439\u0434\u0430\u043d\u044b. \u042f \u043f\u0440\u044b\u043d\u044f\u0441\u0443 \u0422\u0430\u0431\u0435 \u0430\u0445\u0432\u044f\u0440\u0443 \u0445\u0432\u0430\u043b\u044b\u00bb (\u041f\u0441 116 [115], 16-17). \u041c\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435\u043c\u0441\u044f \u0437 \u043f\u0443\u0442\u0430\u045e, \u043a\u0430\u043b\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0443 \u0445\u0440\u043e\u0441\u0442\u0443 \u0437\u0431\u0456\u0440\u0430\u0435\u043c\u0441\u044f \u043f\u0430\u0434 \u0448\u0442\u0430\u043d\u0434\u0430\u0440\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b\u044f \u043c\u043e\u0446\u0430\u044e \u043a\u0440\u044b\u0432\u0456 \u0456 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043c\u044b \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u043b\u0456 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b\u044f, \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b\u044f, \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u044b\u043d\u044f\u0442\u044b\u044f \u0434\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u00ab\u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u043a\u0430\u043c\u0443 \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0456 \u0447\u044b\u0439 \u0433\u0440\u044d\u0445 \u0437\u0430\u0431\u044b\u0442\u044b\u00bb (\u043f\u0430\u0440. \u041f\u0441 32 [31], 1). \u0417 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b\u0430\u045e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0434\u0437\u0435\u043b\u044f \u045e\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f, \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u0446\u0435, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u0447\u044b\u0441\u0442\u044b\u044f \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u044f \u0430\u0436 \u0434\u0430 \u0434\u043d\u044f \u041f\u0430\u043d\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u041a\u0430\u0440 15, 47. 49; \u041a\u043b\u0441 3, 9b. 10&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0435\u0440\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437 \u0437\u044f\u043c\u043b\u0456 \u0451\u0441\u0446\u044c \u043f\u044b\u043b\u0430\u043c; \u0434\u0440\u0443\u0433\u0456 \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u2013 \u0437 \u043d\u0435\u0431\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0406 \u044f\u043a \u043c\u044b \u043d\u0430\u0441\u0456\u043b\u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437 \u043f\u044b\u043b\u0443, \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u0456\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0412\u044b \u0437\u043d\u044f\u043b\u0456 \u0437 \u0441\u044f\u0431\u0435 \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u044f\u0433\u043e\u043d\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0456\u0441\u044f \u045e \u043d\u043e\u0432\u0430\u0433\u0430, \u044f\u043a\u0456 \u0430\u0431\u043d\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u044f\u0433\u043e. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406 \u044f\u043a \u043c\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"201","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u0441\u0432. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041c\u0430\u0446\u0432\u0435\u044f\u00bb \u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 15, 6. 7: PG 57, 231-232)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u043e\u043b\u044c \u0437\u044f\u043c\u043b\u0456 \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0442\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0412\u044b \u2013 \u0441\u043e\u043b\u044c \u0437\u044f\u043c\u043b\u0456\u00bb (\u041c\u0446<\/span><span style=\"font-style: italic;\"> <\/span><span>5, 13). \u041d\u0435 \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441 \u0441\u0430\u043c\u0456\u0445 \u0434\u0430\u0440\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0432\u0430\u043c \u0421\u043b\u043e\u0432\u0430, \u0430\u043b\u0435 \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0431\u0440\u0430 \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443. \u042f \u043d\u0435 \u043f\u0430\u0441\u044b\u043b\u0430\u044e \u0432\u0430\u0441 \u0434\u0430 \u0434\u0432\u0443\u0445, \u0434\u0430 \u0434\u0437\u0435\u0441\u044f\u0446\u0456, \u0434\u0430 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u0456 \u0433\u0430\u0440\u0430\u0434\u043e\u045e, \u043d\u0435 \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0430\u043b\u0435 \u0434\u0430 \u045e\u0441\u0456\u0445 \u0437\u0435\u043c\u043b\u044f\u045e \u0456 \u043c\u043e\u0440\u0430\u045e, \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443, \u044f\u043a\u0456 \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u0435 \u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456. \u041a\u0430\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0412\u044b \u2013 \u0441\u043e\u043b\u044c \u0437\u044f\u043c\u043b\u0456\u00bb, \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430, \u0448\u0442\u043e \u0441\u0430\u043c\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u043f\u0440\u044b\u0440\u043e\u0434\u0430 \u0431\u044b\u043b\u0430 \u0430\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u0430 \u0456 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430 \u0433\u0440\u0430\u0445\u043e\u043c. \u041f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434 \u0432\u0443\u0447\u043d\u044f\u045e \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0442\u044b\u0445 \u0446\u043d\u043e\u0442\u0430\u045e, \u044f\u043a\u0456\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c\u0456 \u0456 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u043c\u0456 \u045e \u0430\u043f\u0435\u0446\u044b \u043d\u0430\u0434 \u0456\u043d\u0448\u044b\u043c\u0456. \u0422\u043e\u0439, \u0445\u0442\u043e \u043b\u0430\u0433\u043e\u0434\u043d\u044b, \u0441\u0446\u0456\u043f\u043b\u044b, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u043d\u0435 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u0441\u0432\u0430\u0456\u0445 \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u043c\u0456 \u0434\u0430\u0431\u0440\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043b\u044f \u0456\u043d\u0448\u044b\u0445. \u0425\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0437 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u043c\u0456\u0440\u0430\u0442\u0432\u043e\u0440\u0446\u0430\u043c, \u044f\u043a\u043e\u0433\u0430 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0442\u043e\u0439 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u043f\u0440\u044b\u0447\u044b\u043d\u044f\u0435\u0446\u0446\u0430 \u0434\u0430 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0434\u0430 \u043d\u044f\u0437\u043d\u0430\u0447\u043d\u044b\u0445 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e, \u0434\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u0434\u0440\u043e\u0431\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u043d\u043d\u044f\u045e. \u041d\u0435. \u00ab\u0412\u044b \u2013 \u0441\u043e\u043b\u044c \u0437\u044f\u043c\u043b\u0456\u00bb. \u0428\u0442\u043e \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435? \u0426\u0456 \u0433\u044d\u0442\u0430 \u044f\u043d\u044b \u0432\u044f\u0440\u043d\u0443\u043b\u0456 \u0441\u0432\u0435\u0436\u0430\u0441\u0446\u044c \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0435? \u041d\u0456 \u045e \u044f\u043a\u0456\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443. \u0422\u043e\u0435, \u0448\u0442\u043e \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u043f\u0430\u0441\u043b\u044f \u0437\u043c\u044f\u0448\u0430\u043d\u043d\u044f \u0437 \u0441\u043e\u043b\u043b\u044e \u043d\u0435 \u0441\u0442\u0430\u043d\u0435 \u0441\u0432\u0435\u0436\u044b\u043c. \u0422\u0430\u043c\u0443 \u043d\u0435, \u044f\u043d\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0456. \u0410\u043b\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0435 \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u0430, \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430 \u0456\u043c, \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u0430 \u0430\u0434 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456, \u044f\u043d\u044b \u0437\u043c\u044f\u0448\u0430\u043b\u0456 \u0437 \u0441\u043e\u043b\u043b\u044e \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u0441\u0432\u0435\u0436\u044b\u043c, \u044f\u043a \u0431\u044b\u043b\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u0430 \u0430\u0434 \u041f\u0430\u043d\u0430. \u0412\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0430\u0439 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456 \u0431\u044b\u043b\u043e \u0441\u043f\u0440\u0430\u0432\u0430\u044e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043c\u043e\u0446\u044b, \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0430\u0434 \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f \u0434\u0430 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u044f\u0433\u0430 \u0441\u0442\u0430\u043d\u0443 \u0441\u0442\u0430\u043b\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u043c \u0456\u0445 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0439 \u043f\u0440\u0430\u0446\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0426\u0456 \u0431\u0430\u0447\u044b\u0448, \u044f\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u043e\u0432\u0430 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0456\u043c, \u0448\u0442\u043e \u044f\u043d\u044b \u0431\u043e\u043b\u044c\u0448\u044b\u044f \u0437\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e. \u0401\u043d \u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0456\u0445 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u041f\u0430\u043b\u0435\u0441\u0442\u044b\u043d\u044b, \u0430\u043b\u0435 \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443. \u041d\u0435 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u0439\u0446\u0435\u0441\u044f, \u044f\u043a \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u042f, \u0430\u0431\u043c\u0456\u043d\u0430\u044e\u0447\u044b \u0456\u043d\u0448\u044b\u0445, \u0437\u0432\u044f\u0440\u0442\u0430\u044e\u0441\u044f \u0434\u0430 \u0432\u0430\u0441 \u0456 \u0432\u044f\u0434\u0443 \u0434\u0430 \u0442\u0430\u043a\u0456\u0445 \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a. \u041f\u0430\u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0434\u0430 \u044f\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456 \u0433\u0430\u0440\u0430\u0434\u043e\u045e, \u043a\u0440\u0430\u0456\u043d \u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u042f \u043f\u0430\u0441\u044b\u043b\u0430\u044e \u0432\u0430\u0441 \u0443 \u044f\u043a\u0430\u0441\u0446\u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u045e. \u0422\u0430\u043c\u0443 \u0436\u0430\u0434\u0430\u044e, \u043a\u0430\u0431 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u0431\u044b\u043b\u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u044f, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0432\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0442\u0430\u043a\u0456\u043c\u0456 \u0456\u043d\u0448\u044b\u0445. \u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0437\u0440\u043e\u0431\u0456\u0446\u0435, \u0442\u043e \u0456 \u0432\u0430\u043c \u0441\u0430\u043c\u0456\u043c \u043d\u0435 \u0445\u043e\u043f\u0456\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0456\u043d\u0448\u044b\u044f \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u044e\u0446\u044c, \u044f\u043d\u044b \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0432\u0430\u0448\u0443\u044e \u043f\u0430\u0441\u043b\u0443\u0433\u0443; \u043a\u0430\u043b\u0456 \u0436 \u0432\u044b \u045e\u043f\u0430\u0434\u0437\u0435\u0446\u0435, \u0442\u043e \u0456\u043d\u0448\u044b\u0445 \u043f\u0430\u0446\u044f\u0433\u043d\u0435\u0446\u0435 \u0434\u0430 \u0437\u0433\u0443\u0431\u044b. \u0422\u0430\u043c\u0443, \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0434\u0430\u0440\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0432\u0430\u043c \u0437\u0430\u0434\u0430\u043d\u043d\u0435, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0432\u0430\u0448\u0430\u044f \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: \u00ab\u041a\u0430\u043b\u0456 \u0436 \u0441\u043e\u043b\u044c \u0441\u0442\u0440\u0430\u0446\u0456\u0446\u044c \u0441\u043c\u0430\u043a, \u0442\u043e \u0447\u044b\u043c \u043f\u0430\u0441\u043e\u043b\u0456\u0448 \u044f\u0435? \u042f\u043d\u0430 \u045e\u0436\u043e \u043d\u0456 \u043d\u0430 \u0448\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u0434\u0430\u0441\u0446\u0430, \u0445\u0456\u0431\u0430 \u0448\u0442\u043e \u0432\u044b\u043a\u0456\u043d\u0443\u0446\u044c \u044f\u0435 \u0432\u043e\u043d \u043d\u0430 \u043f\u0430\u0442\u0430\u043f\u0442\u0430\u043d\u043d\u0435 \u043b\u044e\u0434\u0437\u044f\u043c\u00bb (\u041c\u0446 5, 13).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u043a\u0430\u0431 \u0432\u0443\u0447\u043d\u0456, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u044b: \u00ab\u0411\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u0441 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0446\u044c, \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0456 \u045e\u0441\u044f\u043b\u044f\u043a \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u0446\u044c \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u00bb (\u041c\u0446 5, 11), \u043d\u0435 \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430\u0435 \u0456\u043c, \u043a\u0430\u0436\u0430, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0432\u044b \u043d\u0435 \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0443\u0441\u0451 \u0433\u044d\u0442\u0430, \u0442\u043e \u042f \u0434\u0430\u0440\u043c\u0430 \u0432\u0430\u0441 \u0432\u044b\u0431\u0440\u0430\u045e. \u0412\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456 \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u0431\u0443\u0434\u0443\u0446\u044c, \u0430\u0434\u043d\u0430\u043a, \u044f\u043d\u044b \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u0441\u0443\u0446\u044c \u0432\u0430\u043c \u0448\u043a\u043e\u0434\u0443, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u0446\u044c \u043f\u0440\u0430 \u0432\u0430\u0448\u0443\u044e \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c. \u041a\u0430\u043b\u0456 \u0436 \u0432\u044b \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u0435\u0446\u0435\u0441\u044f \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430 \u0430\u0434\u0434\u0430\u043d\u044b\u043c\u0456, \u0437\u043d\u0430\u0447\u043d\u0430 \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0446\u0435\u0440\u043f\u0456\u0446\u0435; \u0443\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0432\u0430\u0441 \u0441\u0443\u0440\u043e\u0432\u0430 \u0430\u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0456 \u045e\u0441\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u044f\u0446\u044c \u0432\u0430\u043c\u0456. \u0413\u044d\u0442\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043f\u0430\u0442\u0430\u043f\u0442\u0430\u043d\u043d\u0435 \u045e\u0441\u0456\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0430\u043b\u0435\u0439 \u043f\u0430\u0434\u0430\u0435 \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u043d\u0451\u0441\u043b\u0430\u0435 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0435: \u00ab\u0412\u044b \u2013 \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0442\u0443\u00bb (\u041c\u0446 5, 14). \u0417\u043d\u043e\u045e \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0441\u0432\u0435\u0442; \u043d\u0435 \u043f\u0440\u0430 \u0430\u0434\u0437\u0456\u043d \u043d\u0430\u0440\u043e\u0434 \u0446\u0456 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0440\u0430\u0434\u043e\u045e, \u0430\u043b\u0435 \u043f\u0440\u0430 \u045e\u0441\u044e \u0437\u044f\u043c\u043b\u044e. \u0422\u0443\u0442 \u043c\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0440\u043e\u0437\u0443\u043c\u0443, \u043d\u0430\u0448\u043c\u0430\u0442 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0435\u0439\u0448\u0430\u0435 \u0437\u0430 \u043f\u0440\u043e\u043c\u043d\u0456 \u0441\u043e\u043d\u0446\u0430, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u0441\u043e\u043b\u044c. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u043e\u043b\u044c, \u043f\u0430\u0441\u043b\u044f \u0441\u0432\u044f\u0442\u043b\u043e, \u043a\u0430\u0431 \u0442\u044b \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u044f\u043a\u0430\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u045e, \u044f\u043a\u0456 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u044e\u0446\u044c \u0443\u0433\u043b\u044b\u0431, \u044f\u043a\u043e\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u043c\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435. \u042f\u043d\u043e \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u0435 \u045e\u0432\u0430\u0433\u0443, \u0441\u043f\u0440\u044b\u044f\u0435 \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0436\u0430\u043d\u043d\u044e, \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0446\u043d\u043e\u0442\u044b. \u00ab\u041d\u0435 \u043c\u043e\u0436\u0430 \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u0433\u043e\u0440\u0430\u0434, \u044f\u043a\u0456 \u0441\u0442\u0430\u0456\u0446\u044c \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0433\u0430\u0440\u044b. \u0406, \u0437\u0430\u043f\u0430\u043b\u0456\u045e\u0448\u044b \u0441\u0432\u0435\u0442\u0430\u0447, \u043d\u0435 \u0441\u0442\u0430\u0432\u044f\u0446\u044c \u044f\u0433\u043e \u043f\u0430\u0434 \u043f\u0430\u0441\u0443\u0434\u0437\u0456\u043d\u0430\u0439\u00bb (\u041c\u0446 5, 14-15). \u042f\u043d\u043e \u043f\u0430-\u043d\u043e\u0432\u0430\u043c\u0443 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u0441\u0430\u0447\u044b\u0446\u044c \u0437\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u043c\u0456 \u0456 \u0432\u0443\u0447\u044b\u0446\u044c \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0441\u044f\u0431\u0435 \u044f\u043a \u043d\u0430 \u0442\u044b\u0445, \u043d\u0430 \u043a\u0430\u0433\u043e \u0433\u043b\u044f\u0434\u0437\u044f\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u044f, \u0456 \u0445\u0442\u043e \u0441\u043f\u0430\u0442\u044b\u043a\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0443\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0414\u0437 1, 8; \u041c\u0446 5, 16&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0440\u044b\u043c\u0435\u0446\u0435 \u043c\u043e\u0446 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u043d\u0430 \u0432\u0430\u0441 \u0441\u044b\u0434\u0437\u0435, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u0430\u0456\u043c\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456 \u0430\u0436\u043d\u043e \u0434\u0430 \u043a\u0440\u0430\u044e \u0437\u044f\u043c\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u043b\u043e \u0432\u0430\u0448\u0430 \u0442\u0430\u043a \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0432\u0430\u0448\u044b \u0434\u043e\u0431\u0440\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u0410\u0439\u0446\u0430 \u0432\u0430\u0448\u0430\u0433\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0431\u0443\u0434\u0437\u0435\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"202","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0401\u0432\u0430\u00bb \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 3, 39-40: PL 75, 619-620)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u043d\u0435\u0448\u043d\u0456\u044f \u043a\u0430\u043d\u0444\u043b\u0456\u043a\u0442\u044b, \u0443\u043d\u0443\u0442\u0440\u0430\u043d\u044b\u044f \u0442\u0440\u044b\u0432\u043e\u0433\u0456&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0432\u044f\u0442\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e \u0443\u043c\u0435\u044e\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437 \u0456\u043c\u0456 \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430, \u0456 \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u045e\u0432\u0435\u0441\u0446\u0456 \u0456\u0445 \u0443 \u0437\u043c\u0430\u043d. \u0421\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0435\u0440\u0448\u044b\u0445 \u043f\u0430\u0434\u044b\u043c\u0430\u044e\u0446\u044c \u0448\u0447\u044b\u0442 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0434\u0440\u0443\u0433\u0456\u0445 \u2013 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0437\u0431\u0440\u043e\u044e \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u045e. \u0423 \u0430\u0431\u043e\u0434\u0432\u0443\u0445 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u0445 \u043d\u0430\u0431\u044b\u0432\u0430\u044e\u0446\u044c \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0443\u044e \u0441\u0442\u0443\u043f\u0435\u043d\u044c \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456. \u0417 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u0437\u0432\u0430\u0433\u0430\u044e \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u043f\u0430\u043c\u044b\u043b\u043a\u0456 \u0437\u043d\u0443\u0442\u0440\u044b, \u0437\u0432\u043e\u043d\u043a\u0443 \u0436 \u043c\u0443\u0436\u043d\u0430 \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b. \u0410\u0434\u043d\u044b\u0445 \u0432\u044b\u043f\u0440\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u043f\u0440\u0430\u0437 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0434\u0440\u0443\u0433\u0456\u0445 \u2013 \u043f\u0440\u0430\u0437 \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0426\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e, \u043f\u0440\u0430\u0437 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u0435 \u0432\u044f\u0434\u0443\u0446\u044c \u0441\u043b\u0430\u0431\u044b\u0445 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0421\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u0442\u044b\u043c, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0435 \u0430\u0434\u0446\u044f\u0433\u0432\u0430\u043b\u0456 \u0456\u043d\u0448\u044b\u0445, \u0437\u0430 \u0433\u044d\u0442\u044b\u0445 \u0431\u0430\u044f\u0446\u0446\u0430, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0435 \u0441\u044b\u0448\u043b\u0456 \u0437 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0448\u043b\u044f\u0445\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0430\u0432\u0430\u0439\u0446\u0435 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u043c, \u044f\u043a \u0436\u0430\u045e\u043d\u0435\u0440 \u0411\u043e\u0436\u0430\u0433\u0430 \u0432\u043e\u0439\u0441\u043a\u0430 \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0430\u0434\u043d\u044b\u0445 \u0456 \u0434\u0440\u0443\u0433\u0456\u0445. \u0401\u043d \u043a\u0430\u0436\u0430: \u00ab\u0417\u0432\u043e\u043d\u043a\u0443 \u2013 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u0443\u043d\u0443\u0442\u0440\u044b \u2013 \u0431\u043e\u044f\u0437\u044c\u00bb (2 \u041a\u0430\u0440 7, 5). \u041f\u0435\u0440\u0430\u043b\u0456\u0447\u0432\u0430\u0435 \u0437\u043d\u0435\u0448\u043d\u0456\u044f \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b: \u00ab\u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u043d\u0430 \u0440\u044d\u043a\u0430\u0445, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u0430\u0434 \u0440\u0430\u0437\u0431\u043e\u0439\u043d\u0456\u043a\u0430\u045e, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u0430\u0434 \u0441\u0443\u0430\u0439\u0447\u044b\u043d\u043d\u0456\u043a\u0430\u045e, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u0430\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u045e \u0433\u043e\u0440\u0430\u0434\u0437\u0435, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u043d\u0430 \u043c\u043e\u0440\u044b, \u0443 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b \u0441\u044f\u0440\u043e\u0434 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e\u00bb (2 \u041a\u0430\u0440 11, 26). \u0417\u0433\u0430\u0434\u0432\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430 \u0441\u0442\u0440\u044d\u043b\u044b, \u044f\u043a\u0456\u044f \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0435 \u045e \u0433\u044d\u0442\u0430\u0439 \u0432\u0430\u0439\u043d\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f: \u00ab\u0423 \u043f\u0440\u0430\u0446\u044b \u0456 \u0437\u043d\u044f\u043c\u043e\u0437\u0435, \u0447\u0430\u0441\u0442\u0430 \u045e \u043d\u0435\u0434\u0430\u0441\u044b\u043f\u0430\u043d\u043d\u0456, \u0443 \u0433\u043e\u043b\u0430\u0434\u0437\u0435 \u0456 \u0441\u043c\u0430\u0437\u0435, \u0447\u0430\u0441\u0442\u0430 \u045e \u043f\u043e\u0441\u0446\u0435, \u0443 \u0445\u043e\u043b\u0430\u0434\u0437\u0435 \u0456 \u0433\u0430\u043b\u0435\u0447\u044b\u00bb (2 \u041a\u0430\u0440 11, 27).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u044f\u0440\u043e\u0434 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u0445 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0431\u044f\u0441\u043f\u0435\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u0439\u0441\u043a\u043e\u0432\u0430\u0433\u0430 \u043b\u0430\u0433\u0435\u0440\u0430. \u0410\u043b\u0435 \u0442\u0443\u0442 \u0436\u0430 \u0434\u0430\u0434\u0430\u0435: \u00ab\u0410\u043a\u0440\u0430\u043c\u044f \u0456\u043d\u0448\u044b\u0445 \u0440\u044d\u0447\u0430\u045e, \u043d\u0430 \u043c\u043d\u0435 \u0448\u0442\u043e\u0434\u043d\u044f \u043b\u044f\u0436\u044b\u0446\u044c \u043a\u043b\u043e\u043f\u0430\u0442 \u0430\u0431 \u0443\u0441\u0456\u0445 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u0445\u00bb (2 \u041a\u0430\u0440 11, 28). \u0412\u043e\u0441\u044c \u044f\u043a \u0451\u043d \u043c\u0443\u0436\u043d\u0430 \u043f\u0440\u044b\u043c\u0430\u0435 \u043d\u0430 \u0441\u044f\u0431\u0435 \u0446\u044f\u0436\u0430\u0440 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e \u0456, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u043c, \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0431\u0430\u0440\u0430\u043d\u0456\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u0456\u0445. \u041a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0441\u0432\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u043f\u0435\u0440\u0430\u043b\u0456\u0447\u0432\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0447\u044b\u043d\u0435\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0434\u0443\u043c\u0430\u0435\u043c, \u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u0430\u0446\u044b, \u043a\u0430\u0431 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0437\u0432\u043e\u043d\u043a\u0443 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0446\u044c \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b, \u0430 \u045e\u043d\u0443\u0442\u0440\u044b \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0441\u0430 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044f\u043c\u0456. \u0417\u0432\u043e\u043d\u043a\u0443 \u0440\u0430\u0441\u043f\u0430\u0447\u044b\u043d\u0430\u0435 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0443: \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u045e\u0434\u0430\u0440\u044b, \u043a\u0430\u0439\u0434\u0430\u043d\u044b; \u0443\u043d\u0443\u0442\u0440\u044b \u043f\u0435\u0440\u0430\u0436\u044b\u0432\u0430\u0435 \u0431\u043e\u044f\u0437\u044c, \u0431\u043e \u043f\u0430\u043b\u043e\u0445\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u044f\u0433\u043e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0448\u043a\u043e\u0434\u0443 \u043d\u0435 \u044f\u043c\u0443, \u0430\u043b\u0435 \u0432\u0443\u0447\u043d\u044f\u043c. \u0422\u0430\u043c\u0443 \u043f\u0456\u0448\u0430 \u0456\u043c: \u00ab\u041a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u043d\u044f\u0432\u0435\u0440\u044b\u045e\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u045e\u0446\u0456\u0441\u043a\u0443. \u0412\u044b \u0436 \u0441\u0430\u043c\u0456 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u043c\u044b \u043d\u0430 \u0433\u044d\u0442\u0430 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u00bb (1 \u0422\u044d\u0441 3, 3). \u041a\u0430\u043b\u0456 \u0441\u0430\u043c \u0446\u044f\u0440\u043f\u0435\u045e, \u0431\u0430\u044f\u045e\u0441\u044f, \u043a\u0430\u0431 \u043d\u0435 \u045e\u043f\u0430\u043b\u0456 \u0456\u043d\u0448\u044b\u044f; \u043a\u0430\u0431 \u0432\u0443\u0447\u043d\u0456, \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0448\u044b\u0441\u044f \u043f\u0440\u0430 \u044f\u0433\u043e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0437\u0430 \u0432\u0435\u0440\u0443, \u043d\u0435 \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u044f\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041e \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u044f \u0433\u043b\u044b\u0431\u0456\u043d\u044f \u043b\u044e\u0431\u043e\u0432\u0456! \u0401\u043d \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0430 \u0441\u0432\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u0430\u043b\u0435 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430, \u043a\u0430\u0431 \u0432\u0443\u0447\u043d\u0456 \u043d\u0435 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u0448\u043a\u043e\u0434\u0443 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u044f. \u0401\u043d \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0430 \u0440\u0430\u043d\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u043d\u0430\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u043b\u044f\u0447\u044b\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0440\u0430\u043d\u044b \u0456\u043d\u0448\u044b\u0445. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u044b\u043c \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u044b\u044f \u043b\u044e\u0434\u0437\u0456: \u0441\u0430\u043c\u0456, \u043a\u0430\u043b\u0456 \u0446\u0435\u0440\u043f\u044f\u0446\u044c, \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0456\u043d\u0448\u044b\u0445; \u043a\u0430\u043b\u0456 \u0441\u0430\u043c\u0456 \u0446\u0435\u0440\u043f\u044f\u0446\u044c \u043f\u0440\u0430\u0437 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456, \u0434\u0430\u044e\u0446\u044c \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0456, \u043a\u0430\u0431 \u0456\u043d\u0448\u044b\u043c \u0445\u0430\u043f\u0456\u043b\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430. \u042f\u043d\u044b \u0431\u044b\u0446\u0446\u0430\u043c \u0430\u0434\u0432\u0430\u0436\u043d\u044b\u044f \u043b\u0435\u043a\u0430\u0440\u044b, \u044f\u043a\u0456\u044f \u0441\u0430\u043c\u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0445\u0432\u0430\u0440\u043e\u0431\u0443. \u0421\u0430\u043c\u0456 \u0446\u0435\u0440\u043f\u044f\u0446\u044c \u0431\u0430\u043b\u044e\u0447\u044b\u044f \u0440\u0430\u043d\u044b, \u0430 \u0456\u043d\u0448\u044b\u043c \u043d\u044f\u0441\u0443\u0446\u044c \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u044b \u043b\u0435\u043a.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0401\u045e 13, 20. 21; \u043f\u0430\u0440. \u0415\u0440 10, 24&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041d\u0435 \u0431\u0443\u0434\u0443 \u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u0430\u0434 \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435; \u0430\u0434\u0432\u044f\u0434\u0437\u0456 \u0430\u0434 \u043c\u044f\u043d\u0435 \u0440\u0443\u043a\u0443 \u0422\u0432\u0430\u044e, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0436\u0430\u0445 \u0422\u0432\u043e\u0439 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0435 \u043c\u044f\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u0440\u0430\u0439 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435, \u0430\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0443\u0434\u0430, \u0430 \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u043d\u0435\u0432\u0443, \u043a\u0430\u0431 \u044f \u043d\u0435 \u0431\u044b\u045e \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406 \u0436\u0430\u0445.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"203","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u045e \u0433\u043e\u043d\u0430\u0440 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0446\u0456 \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430, \u0430\u0431\u0430\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 2, 1-2. 4: Opera omnia, Edit. Cisterc. 4 [1966], 21-23)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430\u044f \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c, \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u0430\u044f \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0430\u043c\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u0437\u0456\u043d\u0430 \u0433\u043e\u0434\u043d\u044b\u043c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435\u043c \u0411\u043e\u0433\u0430 \u0431\u044b\u043b\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0437 \u0414\u0437\u0435\u0432\u044b; \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0433\u043e\u0434\u043d\u044b\u043c \u043c\u0430\u0446\u044f\u0440\u044b\u043d\u0441\u0442\u0432\u0430\u043c \u0414\u0437\u0435\u0432\u044b \u0431\u044b\u043b\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u043d\u0430 \u0441\u0432\u0435\u0442 \u0411\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e, \u043a\u0430\u0431 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0432\u044b\u0431\u0440\u0430\u045e \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u0436\u0430\u043d\u0447\u044b\u043d, \u0446\u0456 \u043b\u0435\u043f\u0448 \u0441\u0442\u0432\u0430\u0440\u044b\u045e, \u0442\u0430\u043a\u0443\u044e \u041c\u0430\u0446\u0456, \u044f\u043a\u0430\u044f \u0431\u044b\u043b\u0430 \u0432\u0430\u0440\u0442\u0430\u044f \u042f\u0433\u043e \u0456 \u042f\u043c\u0443 \u043b\u044e\u0431\u0430\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0416\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u0431\u044b\u043b\u0430 \u043f\u0430\u043d\u043d\u0430\u0439; \u043a\u0430\u0431 \u044f\u043a \u0411\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b \u0401\u043d \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0411\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439, \u0437\u043c\u044b\u0432\u0430\u044e\u0447\u044b \u0437 \u0443\u0441\u0456\u0445 \u043f\u043b\u044f\u043c\u044b \u0433\u0440\u0430\u0445\u0443. \u041f\u0430\u0436\u0430\u0434\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u0431 \u0431\u044b\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u044f \u043f\u0430\u043a\u043e\u0440\u044b \u0442\u0430\u044f, \u0437 \u044f\u043a\u043e\u0439 \u0401\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u044f\u043a \u0446\u0456\u0445\u0456 \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u0441\u044d\u0440\u0446\u0430\u043c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0442\u0430\u0446\u044c \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u043c \u0456 \u0437\u0431\u0430\u045e\u0447\u044b\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u044b\u0445 \u0446\u043d\u043e\u0442\u0430\u045e. \u0422\u043e\u0439 \u0436\u0430, \u0445\u0442\u043e \u0441\u0445\u0456\u043b\u0456\u045e \u042f\u0435 \u0434\u0430\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430 \u0456 \u0430\u0434\u0430\u0440\u044b\u045e \u042f\u0435 \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u043f\u0430\u043a\u043e\u0440\u044b, \u0430\u0434\u0430\u0440\u044b\u045e \u042f\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0430\u0446\u044f\u0440\u044b\u043d\u0441\u0442\u0432\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406\u043d\u0430\u043a\u0448, \u044f\u043a \u043c\u043e\u0433 \u0431\u044b \u0430\u043d\u0451\u043b \u043f\u0430\u0437\u043d\u0435\u0439 \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u042f\u0435 \u043f\u043e\u045e\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u043a\u0430\u043b\u0456 \u0431 \u0443 \u0401\u0439 \u0431\u044b\u043b\u043e \u0445\u043e\u0446\u044c \u043a\u0440\u044b\u0445\u0443 \u0434\u0430\u0431\u0440\u0430, \u044f\u043a\u043e\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u0431 \u043b\u0430\u0441\u043a\u0430\u0439. \u0422\u0430\u043c\u0443, \u043a\u0430\u0431 \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u0430 \u0437\u0430\u0447\u0430\u0446\u044c \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u044c \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0421\u0432\u044f\u0442\u044b\u0445, \u0431\u044b\u043b\u0430 \u0441\u0432\u044f\u0442\u043e\u044e \u0446\u0435\u043b\u0430\u043c, \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0434\u0430\u0440 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430; \u043a\u0430\u0431 \u0431\u044b\u043b\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0432\u044f\u0442\u043e\u044e \u0434\u0443\u0445\u0430\u043c, \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u043b\u0430\u0441\u043a\u0443 \u043f\u0430\u043a\u043e\u0440\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a\u0456\u043c\u0456 \u0434\u044b\u044f\u0434\u044d\u043c\u0430\u043c\u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u0430 \u041a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u044f \u0414\u0437\u0435\u0432\u0430, \u0448\u0442\u043e \u044f\u0441\u043d\u0435\u0435 \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u044b\u043c \u0431\u043b\u044f\u0441\u043a\u0430\u043c \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u0430. \u0417 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0430\u0434\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u0456 \u0401\u0439 \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u044e\u0446\u0446\u0430 \u045e \u043d\u0435\u0431\u0435, \u042f\u043d\u0430 \u0437\u0432\u044f\u0440\u043d\u0443\u043b\u0430 \u043d\u0430 \u0441\u044f\u0431\u0435 \u043f\u043e\u0437\u0456\u0440\u043a\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0436\u044b\u0445\u0430\u0440\u043e\u045e, \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u043e\u0433\u0430 \u041a\u0430\u0440\u0430\u043b\u044f \u0437\u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u0441\u0430\u0431\u043e\u044e \u0456 \u0432\u044b\u0432\u0435\u043b\u0430 \u0437 \u0432\u044b\u0448\u044b\u043d\u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u2013 \u0430\u043d\u0451\u043b\u0430 \u0434\u0430 \u0414\u0437\u0435\u0432\u044b\u00bb (\u043f\u0430\u0440. \u041b\u043a 1, 26-27), \u0434\u0437\u0435\u0432\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u0434\u0437\u0435\u0432\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0434\u0443\u0445\u0430, \u0434\u0437\u0435\u0432\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0440\u0430\u0448\u044d\u043d\u043d\u044f, \u0434\u0437\u0435\u0432\u044b, \u044f\u043a\u0430\u044f, \u2013 \u044f\u043a \u043f\u0456\u0448\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u2013 \u0441\u0432\u044f\u0442\u0430\u044f \u0456 \u0434\u0443\u0445\u0430\u043c, \u0456 \u0446\u0435\u043b\u0430\u043c. \u042f\u0435 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u0432\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u0430, \u0443 \u0430\u043f\u043e\u0448\u043d\u044e\u044e \u0445\u0432\u0456\u043b\u0456\u043d\u0443, \u0430\u043b\u0435 \u042f\u043d\u0430 \u0431\u044b\u043b\u0430 \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u044f \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443, \u043f\u0440\u0430\u0434\u0431\u0430\u0447\u0430\u043d\u0430\u044f \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430\u044f \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c. \u042f\u0435 \u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u0430\u043d\u0451\u043b\u044b, \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0456, \u0430\u0431\u044f\u0446\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041b\u043a 1, 35; \u041f\u0441 45 (44), 11\u0430. 12\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0441\u044b\u0434\u0437\u0435 \u043d\u0430 \u0426\u044f\u0431\u0435, \u041c\u0430\u0440\u044b\u044f, \u0456 \u043c\u043e\u0446 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0430\u0445\u0456\u043d\u0435 \u0426\u044f\u0431\u0435. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0422\u0430\u043c\u0443 \u0456 \u0421\u0432\u044f\u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430, \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0430 \u0421\u044b\u043d\u0430\u043c \u0411\u043e\u0436\u044b\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u0434\u0430\u0447\u043a\u0430, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0456 \u0441\u0445\u0456\u043b\u0456 \u0441\u0432\u0430\u0451 \u0432\u0443\u0445\u0430, \u043a\u0430\u0440\u043e\u043b\u044c \u043f\u0440\u0430\u0433\u043d\u0435 \u0442\u0432\u0430\u0451\u0439 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u0456. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u0430\u043c\u0443.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"204","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo Cailau-Saint-Yves 2, 92: PLS 2, 441-442)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0442\u043e \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0435 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430, \u0442\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u043c\u0443\u0447\u044d\u043d\u043d\u0456 \u0456 \u043f\u0430\u043a\u0443\u0442\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u043c \u0456 \u0441\u0440\u043e\u0434\u043a\u0430\u043c \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f. \u0410\u043b\u0435 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043d\u0435 \u0430\u0431\u044f\u0446\u0430\u0435 \u043d\u0430\u043c \u0441\u043f\u0430\u043a\u043e\u044e, \u0446\u0456\u0448\u044b \u0456 \u0431\u044f\u0441\u043f\u0435\u043a\u0456. \u041d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456 \u043a\u0430\u0436\u0443\u0446\u044c \u043f\u0440\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u0443\u0446\u0456\u0441\u043a \u0456 \u0437\u0433\u0430\u0440\u0448\u044d\u043d\u043d\u0456. \u0410\u0434\u043d\u0430\u043a \u00ab\u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0435 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430, \u0431\u0443\u0434\u0437\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u00bb (\u041c\u0446 10, 22). \u0406 \u0448\u0442\u043e \u0436 \u0431\u044b\u043b\u043e \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u043a\u0430\u043b\u0456-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0443 \u0437\u044f\u043c\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u043f\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b \u0430\u0434 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u044c; \u044f\u043a\u0456 \u043d\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043f\u0440\u0430\u043a\u043b\u0451\u043d, \u0430\u0434 \u044f\u043a\u043e\u0433\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043c\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b, \u0431\u0440\u0430\u0442\u044b, \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430, \u043d\u0430\u0440\u0430\u043a\u0430\u0446\u044c \u00ab\u044f\u043a \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u0456\u0445 \u043d\u0430\u0440\u0430\u043a\u0430\u043b\u0456 \u0456 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0456 \u0430\u0434 \u0437\u0433\u0443\u0431\u043d\u0456\u043a\u0430\u00bb (1 \u041a\u0430\u0440 10, 10). \u0428\u0442\u043e \u0436 \u0442\u0430\u043a\u043e\u0433\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0441\u0443\u0441\u0442\u0440\u044d\u043b\u0430 \u0446\u044f\u043f\u0435\u0440 \u043b\u044e\u0434\u0437\u0435\u0439, \u0447\u0430\u0433\u043e \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043f\u0440\u043e\u0434\u043a\u0456? \u0410\u0431\u043e, \u043a\u0430\u043b\u0456 \u043c\u044b \u0437\u043d\u043e\u0441\u0456\u043c \u043d\u0430\u0448\u044b\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u0446\u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u043c, \u044f\u043a \u0446\u044f\u0440\u043f\u0435\u043b\u0456 \u0442\u044b\u044f? \u0410\u0434\u043d\u0430\u043a \u0442\u044b \u043b\u0451\u0433\u043a\u0430 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u043d\u0430\u0440\u0430\u043a\u0430\u044e\u0446\u044c \u043d\u0430 \u0441\u0432\u043e\u0439 \u0447\u0430\u0441 \u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b\u044f, \u0448\u0442\u043e \u0447\u0430\u0441, \u043a\u0430\u043b\u0456 \u0436\u044b\u043b\u0456 \u043f\u0440\u043e\u0434\u043a\u0456, \u0431\u044b\u045e \u0434\u043e\u0431\u0440\u044b. \u0410\u043b\u0435, \u043a\u0430\u043b\u0456 \u0431 \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u0446\u0456 \u0456\u0445 \u0443 \u0442\u044b\u044f \u0447\u0430\u0441\u044b, \u044f\u043d\u044b \u0431 \u0437\u043d\u043e\u045e \u043d\u0430\u0440\u0430\u043a\u0430\u043b\u0456. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u0434\u0443\u043c\u0430\u0435\u0448, \u0448\u0442\u043e \u0442\u043e\u0439 \u0447\u0430\u0441 \u0431\u044b\u045e \u0434\u043e\u0431\u0440\u044b, \u0442\u043e \u043b\u0456\u0447\u044b\u0448 \u0442\u0430\u043a \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0442\u043e\u0439 \u0447\u0430\u0441 \u0443\u0436\u043e \u043d\u0435 \u0442\u0432\u043e\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0442\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b \u0430\u0434 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0443, \u043a\u0430\u043b\u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0443 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u043a\u0430\u043b\u0456 \u0442\u044b \u043f\u0430\u0437\u043d\u0430\u045e \u0446\u0456 \u043d\u0430\u0432\u0430\u0442 \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u043d\u0443\u045e \u0421\u0432\u044f\u0442\u044b\u044f \u041f\u0456\u0441\u0430\u043d\u043d\u0456, \u0442\u043e \u044f \u0432\u0435\u043b\u044c\u043c\u0456 \u0434\u0437\u0456\u045e\u043b\u044e\u0441\u044f, \u043a\u0430\u043b\u0456 \u0442\u044b \u043a\u0430\u0436\u0430\u0448, \u0448\u0442\u043e \u0410\u0434\u0430\u043c \u0436\u044b\u045e \u0443 \u0434\u043e\u0431\u0440\u044b \u0447\u0430\u0441. \u0422\u0432\u0430\u0435 \u0431\u0430\u0446\u044c\u043a\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u044b\u043b\u0456 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0430\u043d\u044b\u044f \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430\u0439 \u0410\u0434\u0430\u043c\u0430. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0410\u0434\u0430\u043c\u0443 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u0423 \u043f\u043e\u0446\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0443\u0434\u0437\u0435\u0448 \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u0446\u044c \u0445\u043b\u0435\u0431 \u0456 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0437 \u044f\u043a\u043e\u0439 \u0442\u044b \u0431\u044b\u045e \u0443\u0437\u044f\u0442\u044b: \u0446\u0435\u0440\u043d\u0456 \u0456 \u043f\u0443\u0441\u0442\u0430\u0437\u0435\u043b\u043b\u0435 \u044f\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u0431\u0435 \u0434\u0430\u0432\u0430\u0446\u044c\u00bb (\u043f\u0430\u0440. \u0411\u044b\u0446 3, 19. 18). \u0412\u043e\u0441\u044c \u0448\u0442\u043e \u0442\u044b \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u045e, \u0432\u043e\u0441\u044c \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e, \u0448\u0442\u043e \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u0443\u0448\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0441\u0443\u0434\u0443 \u0411\u043e\u0433\u0430. \u0427\u0430\u043c\u0443 \u0436 \u0434\u0443\u043c\u0430\u0435\u0448, \u0448\u0442\u043e \u0431\u044b\u043b\u044b\u044f \u0447\u0430\u0441\u044b \u043b\u0435\u043f\u0448\u044b\u044f \u0437\u0430 \u0442\u0432\u0430\u0435? \u0410\u0434 \u0442\u0430\u0433\u043e \u0410\u0434\u0430\u043c\u0430 \u0434\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0410\u0434\u0430\u043c\u0430 \u2013 \u0446\u044f\u0436\u0430\u0440, \u043f\u043e\u0442, \u0446\u0435\u0440\u043d\u0456 \u0456 \u043c\u0443\u0447\u044d\u043d\u043d\u0456. \u0410 \u043c\u043e\u0436\u0430 \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u045e \u043d\u0430\u0441 \u043f\u0430\u0442\u043e\u043f? \u0410 \u043c\u043e\u0436\u0430 \u0441\u0443\u0441\u0442\u0440\u044d\u043b\u0456 \u043d\u0430\u0441 \u0446\u044f\u0436\u043a\u0456\u044f \u0447\u0430\u0441\u044b \u0433\u043e\u043b\u0430\u0434\u0443 \u0456 \u0432\u043e\u0439\u043d\u0430\u045e, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u0447\u044b\u0442\u0430\u0435\u043c, \u043a\u0430\u0431 \u0441\u0451\u043d\u043d\u044f \u043c\u044b \u043d\u0430\u0440\u0430\u043a\u0430\u043b\u0456 \u043d\u0430 \u0411\u043e\u0433\u0430?&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436\u0430\u0445\u043b\u0456\u0432\u044b\u043c \u0431\u044b\u045e \u0442\u043e\u0439 \u0447\u0430\u0441! \u0426\u0456 \u0436 \u043d\u0435 \u0442\u0440\u0430\u043f\u0435\u0447\u0430\u043c \u043c\u044b, \u0441\u043b\u0443\u0445\u0430\u044e\u0447\u044b \u0434\u044b \u0447\u044b\u0442\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u0442\u044b\u044f \u043f\u0430\u0434\u0437\u0435\u0456? \u0414\u0430\u0432\u0430\u0439\u0446\u0435 \u0436 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u043b\u0435\u043f\u0448 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u043c\u0443 \u0447\u0430\u0441\u0443, \u0430 \u043d\u0435 \u043d\u0430\u0440\u0430\u043a\u0430\u0446\u044c.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 77 (76), 6-7\u0430. 3\u0430; 51 (50), 3&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0420\u0430\u0437\u0432\u0430\u0436\u0430\u044e \u043f\u0440\u0430 \u0434\u0430\u045e\u043d\u0456\u044f \u0434\u043d\u0456, \u043f\u0440\u0430 \u043c\u0456\u043d\u0443\u043b\u044b\u044f \u0433\u0430\u0434\u044b. \u0423\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u044e \u043d\u043e\u0447\u0447\u0443 \u0441\u0432\u0430\u0435 \u043f\u0435\u0441\u043d\u0456, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e \u045e \u0441\u044d\u0440\u0446\u044b \u043c\u0430\u0456\u043c <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u043a\u0430\u0436\u0443: \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e, \u0411\u043e\u0436\u0430.&nbsp;<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423 \u0434\u0437\u0435\u043d\u044c \u043c\u0430\u0451\u0439 \u043d\u044f\u0434\u043e\u043b\u0456 \u044f \u0448\u0443\u043a\u0430\u044e \u041f\u0430\u043d\u0430, \u043c\u0430\u044f \u0440\u0443\u043a\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u0442\u0430 \u045e\u043d\u0430\u0447\u044b. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406 \u043a\u0430\u0436\u0443.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"205","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u041f\u0440\u0430 \u0430\u043d\u0451\u043b\u044c\u0441\u043a\u0430\u0435 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435\u00bb, \u0411\u0430\u043b\u0434\u0443\u0456\u043d\u0430 \u041a\u0430\u043d\u0442\u0443\u0430\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 7: PL 204, 477-478)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u044b\u0439\u0434\u0437\u0435 \u043f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u0437 \u043a\u043e\u0440\u0430\u043d\u044f \u0415\u0441\u044d\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0430 \u0441\u043b\u043e\u0432\u0430\u045e \u0410\u043d\u0451\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u044f, \u044f\u043a\u0456\u043c\u0456 \u0448\u0442\u043e\u0434\u043d\u044f \u0437 \u043f\u0430\u0448\u0430\u043d\u0430\u044e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0443\u044e \u041f\u0430\u043d\u043d\u0443, \u043c\u044b \u043f\u0440\u044b\u0432\u044b\u043a\u043b\u0456 \u0434\u0430\u0434\u0430\u0432\u0430\u0446\u044c: \u00ab\u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043f\u043b\u043e\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e\u00bb. \u0413\u044d\u0442\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430 \u043d\u0430 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435 \u041c\u0430\u0440\u044b\u0456 \u0410\u043b\u044c\u0436\u0431\u0435\u0442\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u044e\u0447\u044b \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0435 \u0410\u043d\u0451\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u044f: \u00ab\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0422\u044b \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043f\u043b\u043e\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e\u00bb (\u041b\u043a 1, 42). \u041f\u0440\u0430 \u0433\u044d\u0442\u044b \u043f\u043b\u043e\u0434 \u043a\u0430\u0436\u0430 \u0406\u0441\u0430\u044f: \u00ab\u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u041f\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0445\u0430\u0440\u0430\u0441\u0442\u0432\u043e\u043c \u0456 \u0441\u043b\u0430\u0432\u0430\u044e, \u0456 \u043f\u043b\u043e\u0434 \u0437\u044f\u043c\u043b\u0456 \u2013 \u0433\u043e\u043d\u0430\u0440\u0430\u043c \u0456 \u0430\u0437\u0434\u043e\u0431\u0430\u044e\u00bb (\u0406\u0441 4, 2). \u0425\u0442\u043e \u0436 \u0433\u044d\u0442\u044b \u043f\u043b\u043e\u0434, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0421\u0432\u044f\u0442\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043d\u0430\u0448\u0447\u0430\u0434\u0430\u043a \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u043f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u041f\u0430\u043d\u0430, \u043a\u0432\u0435\u0442\u043a\u0430 \u0437 \u043a\u043e\u0440\u0430\u043d\u044f \u0415\u0441\u044d\u044f, \u043f\u043b\u043e\u0434 \u0436\u044b\u0446\u0446\u044f, \u0443 \u044f\u043a\u0456\u043c \u0456 \u043c\u044b \u043c\u0430\u0435\u043c \u0443\u0434\u0437\u0435\u043b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u045e \u043d\u0430\u0441\u0435\u043d\u043d\u0456, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u045e \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0443, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u045e \u043a\u0432\u0435\u0442\u0446\u044b, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u045e \u043f\u043b\u043e\u0434\u0437\u0435, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0432\u0430 \u045e\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456. \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043d\u0430\u0448\u0447\u0430\u0434\u0430\u043a \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0441\u0442\u0430\u045e \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u043c \u0414\u0430\u0432\u0456\u0434\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u0437\u0456\u043d\u044b \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439 \u0451\u0441\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0432\u0430 \u045e\u0441\u0456\u043c; \u0437\u0432\u044b\u0448 \u043c\u0435\u0440\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0430\u043c \u043c\u043e\u0433 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0435. \u042f\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0448\u0447\u043e\u0434\u0440\u0430 \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0442\u044b\u043c, \u0448\u0442\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u00ab\u042f\u043a \u0437\u044f\u043c\u043b\u044f \u0434\u0430\u0435 \u0441\u0432\u0430\u044e \u0440\u0430\u0441\u043b\u0456\u043d\u043d\u0430\u0441\u0446\u044c, \u0456 \u044f\u043a \u0441\u0430\u0434 \u0440\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0430\u0441\u0435\u044f\u043d\u0430\u0435 \u045e \u0456\u043c, \u0442\u0430\u043a \u041f\u0430\u043d \u0411\u043e\u0433 \u0443\u0447\u044b\u043d\u0456\u0446\u044c, \u0448\u0442\u043e \u045e\u0437\u044b\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0441\u043b\u0430\u0432\u0430 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456\u00bb (\u0406\u0441 61, 11). \u0413\u044d\u0442\u0430 \u043f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u0434\u043e\u0440\u0430\u043d\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u044b \u043a\u0432\u0435\u0442\u043a\u0430\u044e \u0445\u0432\u0430\u043b\u044b. \u042f\u043a\u043e\u0439 \u0445\u0432\u0430\u043b\u044b? \u041d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0439, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0436\u043d\u0430 \u0441\u0430\u0431\u0435 \u045e\u044f\u0432\u0456\u0446\u044c. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439, \u0448\u0442\u043e \u045e\u0432\u043e\u0433\u0443\u043b\u0435 \u043d\u0435\u043b\u044c\u0433\u0430 \u0441\u0430\u0431\u0435 \u045e\u044f\u0432\u0456\u0446\u044c. \u0411\u043e \u0432\u044b\u0440\u0430\u0441\u0442\u0430\u0435 \u043a\u0432\u0435\u0442\u043a\u0430 \u0437 \u043a\u043e\u0440\u0430\u043d\u044f \u0415\u0441\u044d\u044f. \u042f\u043a \u0432\u044b\u0441\u043e\u043a\u0430? \u0412\u044b\u0448\u044d\u0439 \u0443\u0432\u043e\u0433\u0443\u043b\u0435 \u0437\u0430 \u045e\u0441\u0451, \u0431\u043e \u00ab\u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0451\u0441\u0446\u044c \u0443 \u0445\u0432\u0430\u043b\u0435 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430\u00bb (\u043f\u0430\u0440. \u0424\u043b\u043f 2, 11). \u042f\u0433\u043e \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0430\u0436 \u0434\u0430 \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u043f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u041f\u0430\u043d\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0445\u0432\u0430\u043b\u0443 \u0456 \u0437\u0437\u044f\u043d\u043d\u0435, \u0430 \u043f\u043b\u043e\u0434 \u0437\u044f\u043c\u043b\u0456 \u2013 \u0441\u0432\u0430\u044e \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u044f\u043a\u0430\u044f \u0436 \u043d\u0430\u043c \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u043b\u043e\u0434\u0443? \u0428\u0442\u043e, \u0430\u043a\u0440\u0430\u043c\u044f \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u0437 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043f\u043b\u043e\u0434. \u0411\u043e \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u0441\u0435\u043d\u043d\u044f, \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0430, \u043a\u0432\u0435\u0442\u043a\u0456 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043f\u043b\u043e\u0434 \u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u043d\u0430\u0441. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u043d\u0430\u0441\u0435\u043d\u043d\u0456 \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u044f, \u0437\u0430\u0442\u044b\u043c \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0443 \u043f\u0440\u0430\u0437 \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0435 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u043a\u0432\u0435\u0442\u0446\u044b \u043f\u0440\u0430\u0437 \u043d\u0430\u0434\u0437\u0435\u044e \u0456 \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u043d\u043d\u0435 \u0445\u0432\u0430\u043b\u044b. \u0413\u044d\u0442\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043f\u0440\u0430\u0437 \u0411\u043e\u0433\u0430 \u043f\u043b\u043e\u0434 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u043c \u0411\u043e\u0433\u0430\u043c, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u045e \u0406\u043c. \u0401\u043d \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043b\u044f \u043d\u0430\u0441, \u043a\u0430\u0431 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u0406\u043c \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u045e \u0406\u043c \u043d\u0430\u0448\u0443\u044e \u0445\u0432\u0430\u043b\u0443. \u0411\u043e \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435\u043c, \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u043c \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443, \u0411\u043e\u0433 \u0434\u0430\u045e \u042f\u043c\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0420\u044b\u043c 15, 12; \u041f\u0441 72 (71), 17\u0430. 7\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u043a\u043e\u0440\u0430\u043d\u044c \u0415\u0441\u044d\u044f \u0456 \u045e\u0441\u0442\u0430\u043d\u0435, \u043a\u0430\u0431 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456; \u043d\u0430 \u042f\u0433\u043e \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456; <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435 \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423 \u0434\u043d\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0437\u0430\u043a\u0440\u0430\u0441\u0443\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0441\u043f\u0430\u043a\u043e\u0439. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406\u043c\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"206","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e\u00bb \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 48, 13-14: CSEL, 64, 367-368)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0434\u0437\u0456\u043d\u044b \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0440\u0430\u0442 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0432\u044b\u043a\u0443\u043f\u0456\u0446\u044c, \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0456\u043d\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a; \u0401\u043d \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0437\u0430 \u0441\u044f\u0431\u0435 \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0456 \u0434\u0430\u0432\u0430\u0446\u044c \u0432\u044b\u043a\u0443\u043f \u0411\u043e\u0433\u0443 \u0437\u0430 \u0441\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456 (\u043f\u0430\u0440. \u041f\u0441 49 [48], 8-9). \u0414\u044b\u043a \u00ab\u0447\u0430\u0433\u043e \u043c\u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430 \u045e \u0434\u043d\u0456 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u00bb (\u041f\u0441 49 [48], 6). \u0428\u0442\u043e \u043c\u043e\u0436\u0430 \u043f\u0440\u044b\u0447\u044b\u043d\u0456\u0446\u044c \u043c\u043d\u0435 \u0448\u043a\u043e\u0434\u0443, \u043a\u0430\u043b\u0456 \u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f, \u0430\u043b\u0435 \u0441\u0430\u043c \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0441\u044f \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u0435\u043c. \u042f \u0432\u044b\u0431\u0430\u045e\u043b\u044f\u044e \u0456\u043d\u0448\u044b\u0445, \u0442\u043e \u0446\u0456 \u0431\u0443\u0434\u0443 \u0431\u0430\u044f\u0446\u0446\u0430 \u0437\u0430 \u0441\u044f\u0431\u0435? \u0412\u043e\u0441\u044c \u0443\u0441\u0451 \u0447\u044b\u043d\u044e \u043d\u043e\u0432\u044b\u043c; \u0430 \u0433\u044d\u0442\u0430 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0432\u0430\u0442 \u0431\u0440\u0430\u0442\u043d\u044e\u044e \u043f\u043e\u0432\u044f\u0437\u044c \u0456 \u043b\u044e\u0431\u043e\u045e. \u0411\u0440\u0430\u0442, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0430\u0434 \u0442\u043e\u0439 \u0441\u0430\u043c\u0430\u0439 \u043c\u0430\u0446\u0456, \u043d\u0435 \u043c\u043e\u0436\u0430 \u0432\u044b\u0431\u0430\u0432\u0456\u0446\u044c, \u0431\u043e \u043c\u0430\u0435 \u0442\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c. \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0430\u043b\u0435 \u0442\u043e\u0439, \u043f\u0440\u0430 \u044f\u043a\u043e\u0433\u0430 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u00ab\u041f\u0430\u043d \u043f\u0430\u0448\u043b\u0435 \u0456\u043c \u0437\u0431\u0430\u045e\u0446\u0443 \u0456 \u0430\u0431\u0430\u0440\u043e\u043d\u0446\u0443, \u044f\u043a\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u0456\u0445\u00bb (\u0406\u0441 19, 20), \u0442\u043e\u0439, \u044f\u043a\u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0441\u044f\u0431\u0435: \u00ab\u0428\u0443\u043a\u0430\u0435\u0446\u0435, \u044f\u043a \u0437\u0430\u0431\u0456\u0446\u044c \u041c\u044f\u043d\u0435, \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0432\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u0443\u00bb (\u042f\u043d 8, 40).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a, \u0445\u043e\u0446\u044c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0445\u0442\u043e \u0436 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u044f\u0433\u043e? \u0410 \u0447\u0430\u043c\u0443 \u043d\u0435 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0435? \u042f\u043a \u0430\u0434\u0437\u0456\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433, \u0442\u0430\u043a \u00ab\u0430\u0434\u0437\u0456\u043d \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u2013 \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441\u00bb (1 \u0426\u0456\u043c 2, 5). \u0401\u043d \u0441\u0430\u043c \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u0431\u0440\u0430\u0442\u043e\u045e. \u0417\u0430 \u0447\u0443\u0436\u044b\u0445 \u043f\u0440\u0430\u043b\u0456\u045e \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e, \u044f\u043a\u043e\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0434\u0434\u0430\u045e \u0431\u044b \u0437\u0430 \u0431\u0440\u0430\u0442\u0430. \u0401\u043d \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u0432\u044b\u043a\u0443\u043f\u0456\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u0433\u0440\u0430\u0445\u0443: \u00ab\u2026\u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u043d\u0430 \u0432\u043e\u0434\u043a\u0443\u043f \u0437\u0430 \u045e\u0441\u0456\u0445\u00bb (1 \u0426\u0456\u043c 2, 6), \u044f\u043a \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u042f\u0433\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0441\u0432\u0435\u0434\u043a\u0430, \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b: \u00ab\u042f \u043a\u0430\u0436\u0443 \u043f\u0440\u0430\u045e\u0434\u0443, \u043d\u0435 \u0445\u043b\u0443\u0448\u0443\u00bb (\u0420\u044b\u043c 9, 1).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0427\u0430\u043c\u0443 \u0436 \u0442\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u0430\u0434\u0437\u0456\u043d \u0432\u044b\u0431\u0430\u045e\u043b\u044f\u0435? \u0411\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0440\u043e\u045e\u043d\u044b\u043c \u042f\u043c\u0443 \u045e \u043b\u044e\u0431\u043e\u0432\u0456: \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0401\u043d \u0430\u0434\u0434\u0430\u0435 \u0437\u0430 \u0431\u0440\u0430\u0442\u043e\u045e; \u043d\u044f\u043c\u0430 \u043d\u0456\u043a\u043e\u0433\u0430 \u0440\u043e\u045e\u043d\u0430\u0433\u0430 \u045e \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u0456: \u0443\u0441\u0435 \u043f\u0430\u0434\u0443\u043b\u0430\u0434\u043d\u044b\u044f \u0433\u0440\u0430\u0445\u0443, \u0443\u0441\u0435 \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u045e\u043f\u0430\u0434\u043a\u0430\u043c \u0410\u0434\u0430\u043c\u0430. \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u0435\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u0435 \u0441\u0442\u0430\u0440\u043e\u043c\u0443 \u0433\u0440\u0430\u0445\u0443. \u0410\u043b\u0435 \u043c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0433\u044d\u0442\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041f\u0430\u043d \u0415\u0437\u0443\u0441, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u044f\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443, \u043a\u0430\u0431 \u0443 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u0446\u044c \u0433\u0440\u0430\u0445\u0456 \u045e\u0441\u0456\u0445 \u0456 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0437\u043c\u044b\u0446\u044c \u043f\u0440\u044b\u0441\u0443\u0434, \u044f\u043a\u0456 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0435 \u043d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u0442\u044b \u0441\u043a\u0430\u0436\u0430\u0448: \u00ab\u0427\u0430\u043c\u0443 \u0430\u0441\u043f\u0440\u044d\u0447\u0432\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u0431\u0440\u0430\u0442 \u043c\u043e\u0436\u0430 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c, \u043a\u0430\u043b\u0456 \u0401\u043d \u0441\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u045e: \u201c\u0411\u0443\u0434\u0443 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0456\u043c\u044f \u0422\u0432\u0430\u0451 \u0431\u0440\u0430\u0442\u0430\u043c \u043c\u0430\u0456\u043c\u201d (\u041f\u0441 22 [21], 23)?\u00bb \u0412\u043e\u0441\u044c \u0436\u0430, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u045e \u043d\u0430\u043c \u0433\u0440\u0430\u0445\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u043a \u043d\u0430\u0448 \u0431\u0440\u0430\u0442, \u0430\u043b\u0435 \u044f\u043a \u0411\u043e\u0433. \u0411\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u00ab\u0411\u043e\u0433 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u043f\u0430\u044f\u0434\u043d\u0430\u045e \u0437 \u0441\u0430\u0431\u043e\u044e \u0441\u0432\u0435\u0442\u00bb (2 \u041a\u0430\u0440 5, 19). \u0423 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u043f\u0440\u0430 \u044f\u043a\u043e\u0433\u0430 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u043c\u0456\u00bb (\u042f\u043d 1, 14). \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0401\u043d \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u045e \u0446\u0435\u043b\u0435, \u0442\u043e \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441 \u044f\u043a \u0411\u043e\u0433, \u0430 \u043d\u0435 \u044f\u043a \u0431\u0440\u0430\u0442.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0406\u0441 53, 12b; \u041b\u043a 23, 34\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0410\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0456 \u0431\u044b\u045e \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u044b \u0434\u0430 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0401\u043d \u0441\u0430\u043c \u043f\u0430\u043d\u0451\u0441 \u0433\u0440\u0430\u0445\u0456 \u043c\u043d\u043e\u0433\u0456\u0445 \u0456 \u0441\u0442\u0430\u045e \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430\u043c \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0415\u0437\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e: \u041e\u0439\u0447\u0430, \u043f\u0440\u0430\u0431\u0430\u0447 \u0456\u043c, \u0431\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0440\u043e\u0431\u044f\u0446\u044c. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0401\u043d \u0441\u0430\u043c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"207","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e\u00bb \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 48, 14-15: CSEL, 64, 368-370)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u043f\u0430\u044f\u0434\u043d\u0430\u045e \u0441\u0432\u0435\u0442 \u0437 \u0411\u043e\u0433\u0430\u043c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u0434\u043d\u0430\u044e\u0447\u044b \u0441\u0432\u0435\u0442 \u0437 \u0411\u043e\u0433\u0430\u043c, \u0441\u0430\u043c \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u044f\u0434\u043d\u0430\u043d\u043d\u044f. \u0411\u043e \u0437\u0430 \u044f\u043a\u0456 \u0436 \u0433\u0440\u044d\u0445 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043f\u0430\u043a\u0443\u0442\u0430\u0432\u0430\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u045e \u0433\u0440\u0430\u0445\u0443? \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0433\u0430\u0431\u0440\u044d\u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u043b\u0456 \u0434\u044b\u0434\u0440\u0430\u0445\u043c\u0443, \u044f\u043a\u0443\u044e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443 \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u0446\u044c \u0437\u0430 \u0433\u0440\u044d\u0445, \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u044f\u0442\u0440\u0443: \u00ab\u042f\u043a \u0442\u0430\u0431\u0435 \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u0421\u044b\u043c\u043e\u043d\u0435? \u0417 \u043a\u0430\u0433\u043e \u0431\u044f\u0440\u0443\u0446\u044c \u043c\u044b\u0442\u0430 \u0430\u0431\u043e \u043f\u0430\u0434\u0430\u0442\u0430\u043a \u0437\u044f\u043c\u043d\u044b\u044f \u043a\u0430\u0440\u0430\u043b\u0456? \u0421\u0430 \u0441\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e \u0446\u0456 \u0437 \u0447\u0443\u0436\u044b\u0445?\u00bb \u0410 \u043a\u0430\u043b\u0456 \u0451\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0417 \u0447\u0443\u0436\u044b\u0445\u00bb, \u0415\u0437\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: \u00ab\u0417\u043d\u0430\u0447\u044b\u0446\u044c, \u0441\u044b\u043d\u044b \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u044f. \u0410\u043b\u0435 \u043a\u0430\u0431 \u043d\u0430\u043c \u043d\u0435 \u0441\u043f\u0430\u043a\u0443\u0441\u0456\u0446\u044c \u0456\u0445, \u0456\u0434\u0437\u0456 \u043d\u0430 \u043c\u043e\u0440\u0430, \u0437\u0430\u043a\u0456\u043d\u044c \u0432\u0443\u0434\u0443 \u0456 \u0432\u0430\u0437\u044c\u043c\u0456 \u043f\u0435\u0440\u0448\u0443\u044e \u0440\u044b\u0431\u0456\u043d\u0443, \u044f\u043a\u0443\u044e \u0437\u043b\u043e\u0432\u0456\u0448; \u043a\u0430\u043b\u0456 \u0430\u0434\u043a\u0440\u044b\u0435\u0448 \u0451\u0439 \u0440\u043e\u0442, \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u0441\u0442\u0430\u0442\u044d\u0440. \u0412\u0430\u0437\u044c\u043c\u0456 \u0456 \u0430\u0434\u0434\u0430\u0439 \u044f\u0433\u043e \u0437\u0430 \u041c\u044f\u043d\u0435 \u0456 \u0437\u0430 \u0441\u044f\u0431\u0435\u00bb (\u041c\u0446 17, 25-27).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0443 \u0447\u044b\u043d\u0456\u0446\u044c \u043f\u0430\u043a\u0443\u0442\u0443, \u0431\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u044b\u045e \u0443 \u043d\u044f\u0432\u043e\u043b\u0456 \u0433\u0440\u0430\u0445\u0443. \u042f\u043a \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u0431\u044b\u045e \u0432\u043e\u043b\u044c\u043d\u044b \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456. \u0421\u044b\u043d \u0451\u0441\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435, \u0430 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u043d\u044f\u0432\u043e\u043b\u0456. \u0422\u0430\u043c\u0443 \u0421\u044b\u043d \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b \u0456 \u043d\u0435 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043d\u044b \u0434\u0430\u0432\u0430\u0446\u044c \u0432\u043e\u0434\u043a\u0443\u043f, \u043a\u0430\u0431 \u0432\u044b\u0431\u0430\u0432\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443. \u0410\u043b\u0435 \u042f\u0433\u043e\u043d\u0430\u044f \u043a\u0440\u043e\u045e \u043c\u0430\u0433\u043b\u0430 \u0441\u0442\u0430\u0446\u044c \u0448\u0447\u043e\u0434\u0440\u0430\u0439 \u043f\u043b\u0430\u0442\u0430\u0439 \u0437\u0430 \u045e\u0441\u0435 \u0433\u0440\u0430\u0445\u0456 \u0441\u0432\u0435\u0442\u0443. \u0411\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435 \u0456\u043d\u0448\u044b\u0445 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u0430\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043a\u0430\u0436\u0443 \u0431\u043e\u043b\u044c\u0448. \u041d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043d\u044b \u0434\u0430\u0432\u0430\u0446\u044c \u0432\u043e\u0434\u043a\u0443\u043f \u0437\u0430 \u0432\u044b\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u0447\u044b\u043d\u0456\u0446\u044c \u043f\u0430\u043a\u0443\u0442\u0443 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u043b\u0456 \u0432\u043e\u0437\u044c\u043c\u0435\u043c \u043f\u0430\u0434 \u0443\u0432\u0430\u0433\u0443 \u043a\u0430\u043d\u043a\u0440\u044d\u0442\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u043c, \u0448\u0442\u043e \u043d\u0456\u0445\u0442\u043e \u0437 \u0456\u0445 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0430\u0434\u043f\u0430\u043a\u0443\u0442\u0432\u0430\u0446\u044c \u0437\u0430 \u0441\u044f\u0431\u0435. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0436\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435\u043c \u0443\u0441\u0456\u0445. \u0401\u043d \u0441\u0430\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0437\u0430 \u045e\u0441\u0456\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0427\u044b\u044f \u0436 \u043a\u0440\u043e\u045e \u043c\u0430\u0433\u043b\u0430 \u0431 \u043c\u0435\u0446\u044c \u0441\u0456\u043b\u0443 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f, \u043a\u0430\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u0430\u043b\u0456\u045e \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0434\u0437\u0435\u043b\u044f \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443? \u0426\u0456 \u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u0446\u044c \u0447\u044b\u044e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043a\u0440\u043e\u045e \u0437 \u043a\u0440\u044b\u0432\u0451\u044e \u0425\u0440\u044b\u0441\u0442\u0430? \u0406 \u0446\u0456 \u0451\u0441\u0446\u044c \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u043f\u043b\u0430\u0442\u0443 \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0437\u0430 \u0442\u0443\u044e, \u044f\u043a\u0443\u044e \u045e \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435 \u043f\u0440\u044b\u043d\u0451\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u043f\u0430\u044f\u0434\u043d\u0430\u045e \u0441\u0432\u0435\u0442 \u0437 \u0411\u043e\u0433\u0430\u043c? \u0423\u0432\u043e\u0433\u0443\u043b\u0435, \u0446\u0456 \u0451\u0441\u0446\u044c \u043d\u0435\u0439\u043a\u0430\u044f \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430, \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435, \u0446\u0456 \u0451\u0441\u0446\u044c \u043b\u0435\u043f\u0448\u044b \u0430\u0431\u0430\u0440\u043e\u043d\u0446\u0430 \u0437\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0442\u0430\u045e \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u045e\u0441\u0456\u0445 \u0456 \u0445\u0442\u043e \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0430\u0434\u0434\u0430\u045e \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u0435 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430 \u043d\u0456 \u043f\u043b\u0430\u0442\u0430, \u043d\u0456 \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0437 \u0431\u043e\u043a\u0443 \u043f\u0430\u0430\u0441\u043e\u0431\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0431\u043e \u0437\u0430 \u045e\u0441\u0456\u0445 \u0437\u0430\u043f\u043b\u0430\u0446\u0456\u043b\u0430 \u043a\u0440\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430. \u0413\u044d\u0442\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0456 \u0441\u0430\u043c \u043f\u0430\u044f\u0434\u043d\u0430\u045e \u043d\u0430\u0441 \u0437 \u0410\u0439\u0446\u043e\u043c. \u0426\u044f\u0440\u043f\u0435\u045e \u0430\u0436 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430, \u0431\u043e \u045e\u0437\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u045e\u0441\u0435 \u043d\u0430\u0448\u044b\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456. \u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: \u00ab\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435, \u0443\u0441\u0435 \u0441\u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0456 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0430\u043d\u044b\u044f, \u0456 \u042f \u0441\u0443\u043f\u0430\u043a\u043e\u044e \u0432\u0430\u0441\u00bb (\u041c\u0446 11, 28).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041a\u043b\u0441 1, 21-22; \u0420\u044b\u043c 3, 25a&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u0430\u0441, \u044f\u043a\u0456\u044f \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0431\u044b\u043b\u0456 \u0430\u0434\u0447\u0443\u0436\u0430\u043d\u044b\u044f \u0456 \u0432\u0430\u0440\u043e\u0436\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u044f \u0456 \u0441\u0432\u0430\u0456\u0445 \u043b\u0456\u0445\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u045e, \u0446\u044f\u043f\u0435\u0440 \u0411\u043e\u0433 \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u045e \u0443 \u0441\u0432\u0430\u0456\u043c \u0437\u044f\u043c\u043d\u044b\u043c \u0446\u0435\u043b\u0435 \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0432\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0441\u0430\u0431\u043e\u044e \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u0456 \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f\u0433\u043e \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0411\u043e\u0433 \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u045e \u042f\u0433\u043e\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u0431 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"211","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u043c \u0441\u0432\u0435\u0446\u0435&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00abGaudium et spes\u00bb \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(N. 39)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0427\u0430\u043a\u0430\u043d\u043d\u0435 \u043d\u043e\u0432\u0430\u0439 \u0437\u044f\u043c\u043b\u0456<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c \u0447\u0430\u0441\u0443, \u043a\u0430\u043b\u0456 \u0441\u043a\u043e\u043d\u0447\u044b\u0446\u0446\u0430 \u0437\u044f\u043c\u043b\u044f \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430, \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0437\u043c\u0435\u043d\u0435\u043d\u044b \u0441\u0432\u0435\u0442. \u041f\u0440\u0430\u043c\u0456\u043d\u0430\u0435 \u0432\u043e\u0431\u0440\u0430\u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0441\u043a\u0430\u0436\u043e\u043d\u044b \u0433\u0440\u0430\u0445\u043e\u043c, \u0430\u043b\u0435 \u043c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u0440\u044b\u0445\u0442\u0443\u0435 \u043d\u043e\u0432\u0430\u0435 \u0436\u044b\u043b\u043b\u0451 \u0456 \u043d\u043e\u0432\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u0443 \u044f\u043a\u043e\u0439 \u0436\u044b\u0432\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0448\u0447\u0430\u0441\u0446\u0435 \u044f\u043a\u043e\u0439 \u0437\u0430\u0441\u043f\u0430\u043a\u043e\u0456\u0446\u044c \u0456 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0434\u0437\u0435 \u045e\u0441\u044f\u043a\u0456\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0441\u043f\u0430\u043a\u043e\u044e, \u0448\u0442\u043e \u0433\u0430\u0440\u0430\u0446\u044c \u0443 \u043b\u044e\u0434\u0441\u043a\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445. \u0422\u0430\u0434\u044b, \u043f\u0430\u0441\u043b\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456 \u043d\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u0411\u043e\u0436\u044b\u044f \u0434\u0437\u0435\u0446\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043f\u0430\u0441\u0435\u044f\u043d\u0430 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u0456 \u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456, \u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u043b\u044e\u0431\u043e\u045e \u0456 \u044f\u0435 \u0441\u043f\u0440\u0430\u0432\u0430, \u0443\u0441\u0451 \u0442\u043e\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0411\u043e\u0433 \u0443\u0447\u044b\u043d\u0456\u045e \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u0430 \u0437 \u043d\u044f\u0432\u043e\u043b\u0456 \u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u043c\u044b \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0456\u044f\u043a\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 \u0451\u043d \u0437\u0434\u0430\u0431\u0443\u0434\u0437\u0435 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442, \u0430 \u0441\u0442\u0440\u0430\u0446\u0456\u0446\u044c \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435. \u0410\u0434\u043d\u0430\u043a \u0447\u0430\u043a\u0430\u043d\u043d\u0435 \u043d\u043e\u0432\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0441\u043b\u0430\u0431\u0435\u0446\u044c, \u0430 \u0445\u0443\u0442\u0447\u044d\u0439 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0446\u044c \u0434\u0430 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0439 \u043f\u0440\u0430\u0446\u044b \u043d\u0430 \u0442\u043e\u0439 \u0437\u044f\u043c\u043b\u0456, \u0434\u0437\u0435 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0435 \u0446\u0435\u043b\u0430 \u043d\u043e\u0432\u0430\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0441\u044f\u043c\u2019\u0456, \u044f\u043a\u043e\u0435 \u043c\u043e\u0436\u0430 \u0434\u0430\u0446\u044c \u043f\u044d\u045e\u043d\u0430\u0435 \u045e\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u043e\u0432\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0422\u0430\u043c\u0443, \u0445\u043e\u0446\u044c \u0456 \u0442\u0440\u044d\u0431\u0430 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0446\u044c \u0437\u044f\u043c\u043d\u044b \u043f\u0440\u0430\u0433\u0440\u044d\u0441 \u0430\u0434 \u0440\u043e\u0441\u0442\u0443 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0430\u0434\u043d\u0430\u043a \u0434\u043b\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043d\u0435 \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u0430, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u044b \u043f\u0440\u0430\u0433\u0440\u044d\u0441 \u043c\u043e\u0436\u0430 \u043f\u0430\u0441\u043f\u0440\u044b\u044f\u0446\u044c \u043b\u0435\u043f\u0448\u0430\u043c\u0443 \u045e\u043b\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u043d\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456. \u0411\u043e \u043a\u0430\u043b\u0456 \u043c\u044b \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u043f\u0430\u0433\u0430\u043d\u0434\u0430\u0432\u0430\u0446\u044c \u0443 \u0434\u0443\u0445\u0443 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e \u0434\u0430\u0440\u0443\u0447\u044d\u043d\u043d\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u043a\u0443\u044e \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u0443, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443\u0441\u0435 \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u043d\u0430\u0442\u0443\u0440\u044b \u0456 \u043f\u043b\u0451\u043d \u043d\u0430\u0448\u0430\u0433\u0430 \u043a\u043b\u043e\u043f\u0430\u0442\u0443, \u0442\u043e \u043f\u0430\u0441\u043b\u044f \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u043c \u0433\u044d\u0442\u0430 \u043d\u0430\u043d\u043e\u0432\u0430, \u0430\u043b\u0435 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u0430\u0435 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0431\u0440\u0443\u0434\u0443, \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u0430\u0435 \u0456 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0435\u043d\u0430\u0435, \u043a\u0430\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u0410\u0439\u0446\u0443 \u00ab\u0432\u0435\u0447\u043d\u0430\u0435 \u0456 \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430: \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u0436\u044b\u0446\u0446\u044f, \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0456 \u043b\u0430\u0441\u043a\u0456, \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e\u00bb. \u041d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u045e\u0436\u043e \u0442\u0430\u044f\u043c\u043d\u0456\u0447\u0430 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435, \u0430 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0437 \u043f\u0440\u044b\u0439\u0441\u0446\u0435\u043c \u041f\u0430\u043d\u0430.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0406\u0441 49, 13; \u041f\u0441 72 (71), 7\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435, \u043d\u044f\u0431\u0451\u0441\u044b, \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0441\u044f, \u0437\u044f\u043c\u043b\u044f. \u0413\u043e\u0440\u044b, \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0456\u0446\u0435 \u0430\u0434 \u0440\u0430\u0434\u0430\u0441\u0446\u0456. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0411\u043e \u041f\u0430\u043d \u0441\u0443\u0446\u0435\u0448\u044b\u045e \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0456 \u0437\u043b\u0456\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430\u0434 \u0441\u0432\u0430\u0456\u043c\u0456 \u045e\u0431\u043e\u0433\u0456\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423 \u0434\u043d\u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0437\u0430\u043a\u0440\u0430\u0441\u0443\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0441\u043f\u0430\u043a\u043e\u0439. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e \u041f\u0430\u043d.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"212","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430\u00bb \u0441\u0432. \u0422\u0430\u043c\u0430\u0448\u0430 \u0410\u043a\u0432\u0456\u043d\u0441\u043a\u0430\u0433\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 10, lect. 3)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0420\u044d\u0448\u0442\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u0456 \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u042f \u2013 \u0434\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440\u00bb (\u042f\u043d 10, 11). \u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0425\u0440\u044b\u0441\u0442\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u0441\u0442\u044b\u0440\u0430. \u042f\u043a \u043f\u0430\u0441\u0442\u044b\u0440 \u0432\u044f\u0434\u0437\u0435 \u0456 \u043a\u043e\u0440\u043c\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a, \u0442\u0430\u043a \u0432\u0435\u0440\u043d\u044b\u044f \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0441\u0456\u043b\u043a\u0443\u044e\u0446\u0446\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0430\u043c \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0426\u0435\u043b\u0430 \u0456 \u041a\u0440\u044b\u0432\u0456. \u00ab\u0412\u044b \u0431\u044b\u043b\u0456, \u044f\u043a \u0430\u0432\u0435\u0447\u043a\u0456, \u0448\u0442\u043e \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0456, \u2013 \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u2013 \u0430\u043b\u0435 \u0446\u044f\u043f\u0435\u0440 \u0432\u044b \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u041f\u0430\u0441\u0442\u044b\u0440\u0430 \u0456 \u0410\u0445\u043e\u045e\u043d\u0456\u043a\u0430 \u0432\u0430\u0448\u044b\u0445 \u0434\u0443\u0448\u00bb (1 \u041f 2, 25). \u0410 \u043f\u0440\u0430\u0440\u043e\u043a \u043a\u0430\u0436\u0430: \u00ab\u042f\u043a \u043f\u0430\u0441\u0442\u044b\u0440, \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0441\u0442\u0430\u0442\u0430\u043a \u0441\u0432\u043e\u0439\u00bb (\u0406\u0441 40, 11).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u043f\u0430\u0441\u0442\u044b\u0440 \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u0431\u0440\u0430\u043c\u0443, \u0456 \u0448\u0442\u043e \u0401\u043d \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0431\u0440\u0430\u043c\u0430\u0439, \u0430 \u0446\u044f\u043f\u0435\u0440 \u0437\u043d\u043e\u045e \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435, \u0448\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041f\u0430\u0441\u0442\u044b\u0440\u0430\u043c, \u0442\u043e \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435, \u0448\u0442\u043e \u0401\u043d \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u0441\u044f\u0431\u0435. \u0406 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u0441\u044f\u0431\u0435, \u0431\u043e \u0430\u0431\u2019\u044f\u045e\u043b\u044f\u0435 \u0441\u044f\u0431\u0435 \u0456 \u043f\u0440\u0430\u0437 \u0441\u044f\u0431\u0435 \u043f\u0430\u0437\u043d\u0430\u0435 \u0410\u0439\u0446\u0430. \u041c\u044b \u0436 \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u043c \u043f\u0440\u0430\u0437 \u042f\u0433\u043e, \u0431\u043e \u0430\u0434 \u042f\u0433\u043e \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043f\u0430\u043c\u044f\u0442\u0430\u0439, \u0448\u0442\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0431\u0440\u0430\u043c\u0430\u0439, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0401\u043d, \u0431\u043e \u043d\u0456\u0445\u0442\u043e \u0456\u043d\u0448\u044b \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0430\u043b\u0435 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u043f\u0440\u0430\u0437 \u0443\u0434\u0437\u0435\u043b. \u041f\u0440\u0430 \u042f\u043d\u0430 \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044f \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u041d\u0435 \u0431\u044b\u045e \u0451\u043d \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0430\u043b\u0435 \u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0434\u0430\u0446\u044c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u00bb (\u042f\u043d 1, 8), \u0430 \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430: \u00ab\u0411\u044b\u043b\u043e \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435, \u044f\u043a\u043e\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u00bb (\u042f\u043d 1, 9). \u0422\u0430\u043c\u0443 \u043d\u0456\u0445\u0442\u043e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u0431\u0440\u0430\u043c\u0430\u0439. \u0422\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0442\u0430\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u044f\u0431\u0435. \u0410\u043b\u0435 \u0401\u043d \u0441\u0432\u0430\u0451 \u043f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u043f\u0430\u0434\u0437\u044f\u043b\u044f\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0456\u043d\u0448\u044b\u043c\u0456 \u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u0435 \u044f\u0433\u043e \u0441\u0432\u0430\u0456\u043c \u0447\u043b\u0435\u043d\u0430\u043c. \u0422\u0430\u043c\u0443 \u0456 \u041f\u0451\u0442\u0440 \u0431\u044b\u045e \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c, \u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b, \u0456 \u045e\u0441\u0435 \u0434\u043e\u0431\u0440\u044b\u044f \u0431\u0456\u0441\u043a\u0443\u043f\u044b. \u00ab\u042f \u0434\u0430\u043c \u0432\u0430\u043c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e,&nbsp; \u2013 \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u045e \u0421\u0432\u044f\u0442\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0456, \u2013 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430\u00bb (\u0415\u0440 3, 15).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u043e\u0446\u044c \u0443\u0441\u0435 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0456 \u044f\u0433\u043e \u0434\u0437\u0435\u0446\u044c\u043c\u0456, \u0456 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456, \u0430\u0434\u043d\u0430\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043a\u0430\u0436\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0441\u044f\u0431\u0435: \u00ab\u042f \u2013 \u0434\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440\u00bb, \u043a\u0430\u0431 \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0446\u044c \u0446\u043d\u043e\u0442\u0443 \u043b\u044e\u0431\u043e\u0432\u0456. \u0411\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0434\u043e\u0431\u0440\u044b\u043c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e \u043d\u0435 \u0437\u2019\u044f\u0434\u043d\u0430\u0435\u0446\u0446\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0456 \u043d\u0435 \u0441\u0442\u0430\u043d\u0435 \u0447\u043b\u0435\u043d\u0430\u043c \u0414\u043e\u0431\u0440\u0430\u0433\u0430 \u041f\u0430\u0441\u0442\u044b\u0440\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u043f\u0430\u0441\u0442\u044b\u0440\u0430 \u2013 \u043b\u044e\u0431\u043e\u045e. \u0422\u0430\u043c\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043a\u0430\u0436\u0430: \u00ab\u0414\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440 \u0430\u0434\u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0430\u0432\u0435\u0447\u0430\u043a\u00bb (\u042f\u043d 10, 11). \u0422\u0440\u044d\u0431\u0430 \u0432\u0435\u0434\u0430\u0446\u044c, \u0448\u0442\u043e \u0456\u0441\u043d\u0443\u0435 \u0440\u043e\u0437\u043d\u0456\u0446\u0430 \u043f\u0430\u043c\u0456\u0436 \u0434\u043e\u0431\u0440\u044b\u043c \u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u043c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c. \u0414\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0430\u045e\u0447\u0430\u0440\u043d\u044e, \u0434\u0440\u044d\u043d\u043d\u044b \u0434\u0431\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0441\u0432\u0430\u044e \u043a\u0430\u0440\u044b\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0433\u0430\u0432\u043e\u0440\u043a\u0430 \u0456\u0434\u0437\u0435 \u043f\u0440\u0430 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e, \u0430\u0434 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u0451\u043d \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0431\u0440\u0430 \u0430\u045e\u0447\u0430\u0440\u043d\u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451. \u0410\u043b\u0435 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0434\u0430\u0431\u0440\u043e \u0430\u045e\u0447\u0430\u0440\u043d\u0456 \u0441\u0442\u0430\u0456\u0446\u044c \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u0436\u044b\u0446\u0446\u0451 \u043f\u0430\u0441\u0442\u044b\u0440\u0430, \u0442\u043e \u043a\u0430\u043b\u0456 \u0441\u0442\u0430\u0442\u043a\u0443 \u0456 \u044f\u0433\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044e \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0435 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430, \u043a\u043e\u0436\u043d\u044b \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u043f\u0430\u0441\u0442\u044b\u0440 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0443\u043c\u0435\u0446\u044c \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0431\u0440\u0430 \u0430\u045e\u0447\u0430\u0440\u043d\u0456. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u00ab\u0414\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440 \u0430\u0434\u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0430\u0432\u0435\u0447\u0430\u043a\u00bb, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0441\u0432\u0430\u0451 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0441\u0432\u0430\u044e \u045e\u043b\u0430\u0434\u0443 \u0456 \u043b\u044e\u0431\u043e\u045e. \u041d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0456 \u0430\u0434\u043d\u043e, \u0456 \u0434\u0440\u0443\u0433\u043e\u0435, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043a\u0430\u0431 \u0430\u0432\u0435\u0447\u043a\u0456 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0456 \u044f\u043c\u0443 \u0456 \u043a\u0430\u0431 \u0451\u043d \u0456\u0445 \u043b\u044e\u0431\u0456\u045e; \u043f\u0430\u0441\u0430\u0434\u044b \u0431\u0435\u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u0435\u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u044b\u043a\u043b\u0430\u0434 \u0442\u0430\u043a\u043e\u0433\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0434\u0430\u045e \u043d\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441: \u00ab\u0401\u043d \u0430\u0434\u0434\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451. \u0406 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0431\u0440\u0430\u0442\u043e\u045e\u00bb (1 \u042f\u043d 3, 16).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0437\u0445 34, 12b; \u042f\u043d 10, 28b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u043f\u0435\u0440\u0430\u0433\u043b\u0435\u0434\u0436\u0443 \u0430\u0432\u0435\u0447\u0430\u043a \u0441\u0432\u0430\u0456\u0445 <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u044e \u0456\u0445 \u0437 \u0443\u0441\u0456\u0445 \u043c\u0435\u0441\u0446\u0430\u045e, \u043f\u0430 \u044f\u043a\u0456\u0445 \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456\u0441\u044f \u045e \u043f\u0430\u0445\u043c\u0443\u0440\u043d\u044b \u0456 \u0437\u043c\u0440\u043e\u0447\u043d\u044b \u0434\u0437\u0435\u043d\u044c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410\u0432\u0435\u0447\u043a\u0456 \u043c\u0430\u0435 \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c \u043d\u0456\u043a\u043e\u043b\u0456, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u044b\u0440\u0432\u0435 \u0456\u0445 \u0437 \u0440\u0443\u043a\u0456 \u041c\u0430\u0451\u0439.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0432\u044b\u0437\u0432\u0430\u043b\u044e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"213","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. De diabolo tentatore 2, 6: PG 49, 263-264)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u044f\u0446\u044c \u0448\u043b\u044f\u0445\u043e\u045e \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f \u0437 \u0411\u043e\u0433\u0430\u043c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0426\u0456 \u0445\u043e\u0447\u0430\u0446\u0435, \u043a\u0430\u0431 \u044f \u043d\u0430\u0433\u0430\u0434\u0430\u045e \u0432\u0430\u043c \u0448\u043b\u044f\u0445\u0456 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f \u0437 \u0411\u043e\u0433\u0430\u043c? \u042f\u043d\u044b \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0456 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u044f, \u0430\u043b\u0435 \u045e\u0441\u0435 \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u043d\u0435\u0431\u0430. \u041f\u0435\u0440\u0448\u044b \u2013 \u0433\u044d\u0442\u0430 \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u0435 \u0441\u0432\u0430\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e. \u0412\u044b\u0437\u043d\u0430\u0439 \u0441\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435 (\u043f\u0430\u0440. \u0406\u0441 43, 25-26). \u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u0440\u043e\u043a \u043a\u0430\u0436\u0430: \u00ab\u042f \u0441\u043a\u0430\u0437\u0430\u045e: \u201c\u0412\u044b\u0437\u043d\u0430\u044e \u041f\u0430\u043d\u0443 \u043c\u0430\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456\u201d, \u0456 \u0422\u044b \u0437\u043d\u044f\u045e \u0437 \u043c\u044f\u043d\u0435 \u0432\u0456\u043d\u0443 \u0433\u0440\u0430\u0445\u0443 \u043c\u0430\u0439\u0433\u043e\u00bb (\u041f\u0441 32 [31], 5). \u0414\u044b\u043a \u043f\u0440\u044b\u0437\u043d\u0430\u0439 \u0436\u0430 \u0441\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456, \u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430, \u043a\u0430\u0431 \u041f\u0430\u043d \u0434\u0430\u0440\u0430\u0432\u0430\u045e \u0442\u0430\u0431\u0435. \u0411\u043e \u0445\u0442\u043e \u0432\u044b\u0437\u043d\u0430\u0435 \u0441\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456, \u043d\u0435 \u0442\u0430\u043a \u0445\u0443\u0442\u043a\u0430 \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0456\u0445 \u0456\u0437\u043d\u043e\u045e. \u0410\u0431\u0443\u0434\u0437\u0456 \u0441\u0432\u0430\u0451 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435, \u0442\u0432\u0430\u0439\u0433\u043e \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0430\u0433\u0430 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u045e\u0446\u0443, \u043a\u0430\u0431 \u043d\u0435 \u0441\u0443\u0441\u0442\u0440\u044d\u0446\u044c \u0442\u0430\u0431\u0435 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u045e\u0446\u0443 \u043f\u0435\u0440\u0430\u0434 \u0441\u0443\u0434\u043e\u043c \u041f\u0430\u043d\u0430. \u0413\u044d\u0442\u0430 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u044b \u0448\u043b\u044f\u0445 \u0434\u0430 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406\u0441\u043d\u0443\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0440\u0443\u0433\u0456, \u043d\u0435 \u0433\u043e\u0440\u0448\u044b \u0437\u0430 \u043f\u0435\u0440\u0448\u044b, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430: \u043d\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u043a\u0440\u044b\u045e\u0434\u044b, \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0433\u043d\u0435\u0432\u0430\u043c, \u0434\u0430\u0440\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u0431\u043b\u0456\u0436\u043d\u0456\u043c. \u0422\u0430\u043a \u0440\u043e\u0431\u044f\u0447\u044b, \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e, \u044f\u043a\u0456\u044f \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c. \u0413\u044d\u0442\u0430 \u0434\u0440\u0443\u0433\u0456 \u0441\u043f\u043e\u0441\u0430\u0431 \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u044f \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e: \u00ab\u041a\u0430\u043b\u0456 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0446\u044c \u043b\u044e\u0434\u0437\u044f\u043c \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u0456\u0445\u043d\u0456\u044f, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0442\u043e \u0410\u0439\u0446\u0435\u0446 \u0432\u0430\u0448 \u041d\u044f\u0431\u0435\u0441\u043d\u044b \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u0456 \u0432\u0430\u043c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u043e\u0447\u0430\u0448 \u0432\u0435\u0434\u0430\u0446\u044c \u0442\u0440\u044d\u0446\u0456 \u0448\u043b\u044f\u0445 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f? \u0417\u02bc\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0456\u043c \u0433\u043e\u0434\u043d\u0430\u044f, \u043f\u0430\u043b\u044b\u043c\u044f\u043d\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u0448\u0442\u043e \u0456\u0434\u0437\u0435 \u0437 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0441\u044d\u0440\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448 \u0432\u0435\u0434\u0430\u0446\u044c \u044f\u0448\u0447\u044d \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u044b, \u0442\u043e \u043d\u0430\u0437\u0430\u0432\u0443 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443. \u042f\u043d\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043c\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043c\u043e\u0446.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u0456 \u0441\u0446\u0456\u043f\u043b\u044b, \u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u045e \u0456\u043c \u0433\u0440\u0430\u0445\u0456, \u0456 \u043d\u0435 \u043c\u0435\u043d\u0448 \u0437\u0430 \u0442\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0440\u0430\u043d\u0435\u0439. \u0421\u0432\u0435\u0434\u043a\u0430\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u0437\u02bc\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u044b\u0442\u043d\u0456\u043a, \u044f\u043a\u0456 \u043d\u0435 \u043c\u043e\u0433 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0434\u043e\u0431\u0440\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456, \u0430\u043b\u0435 \u0437\u0430\u043c\u0435\u0441\u0442 \u0456\u0445 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0446\u043d\u043e\u0442\u0443 \u043f\u0430\u043a\u043e\u0440\u044b,&nbsp; \u0456 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e\u0441\u044f \u0430\u0434 \u0446\u044f\u0436\u0430\u0440\u0443 \u0433\u0440\u0430\u0445\u043e\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u043c\u044b \u043f\u0430\u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u044f\u0446\u044c \u0448\u043b\u044f\u0445\u043e\u045e \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f \u0437 \u0411\u043e\u0433\u0430\u043c. \u041f\u0435\u0440\u0448\u044b \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0456 \u0433\u0440\u0430\u0445\u043e\u045e, \u0434\u0440\u0443\u0433\u0456 \u2013 \u0443 \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u043d\u0456 \u0431\u043b\u0456\u0436\u043d\u0456\u043c \u043a\u0440\u044b\u045e\u0434\u0430\u045e, \u0442\u0440\u044d\u0446\u0456 \u2013 \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u044b \u0432\u044f\u0434\u0437\u0435 \u043f\u0440\u0430\u0437 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443, \u043f\u044f\u0442\u044b \u2013 \u043f\u0440\u0430\u0437 \u043f\u0430\u043a\u043e\u0440\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u044c \u0431\u044f\u0437\u0434\u0437\u0435\u0439\u043d\u044b\u043c, \u0430\u043b\u0435 \u0448\u0442\u043e\u0434\u043d\u044f \u0456\u0434\u0437\u0456 \u0433\u044d\u0442\u044b\u043c\u0456 \u0448\u043b\u044f\u0445\u0430\u043c\u0456. \u042f\u043d\u044b \u043b\u0451\u0433\u043a\u0456\u044f, \u043d\u0435 \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u0439\u0441\u044f \u043d\u0430 \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c. \u041d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u0436\u044b\u0432\u0435\u0448 \u0443 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u043d\u0435\u0434\u0430\u0441\u0442\u0430\u0442\u043a\u0443, \u043c\u043e\u0436\u0430\u0448 \u043f\u0430\u0437\u0431\u044b\u0446\u0446\u0430 \u0433\u043d\u0435\u0432\u0443, \u0432\u044b\u043b\u0443\u0447\u0430\u0446\u0446\u0430 \u043f\u0430\u043a\u043e\u0440\u0430\u044e, \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0456 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0433\u0440\u0430\u0445\u0456, \u0456 \u043d\u0456\u044f\u043a\u0430\u044f \u0431\u0435\u0434\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c \u0442\u0430\u0431\u0435. \u0410\u043b\u0435 \u0448\u0442\u043e \u044f \u043a\u0430\u0436\u0443? \u041d\u0430\u0432\u0430\u0442 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0448\u043b\u044f\u0445\u0443 \u0451\u0441\u0446\u044c \u043f\u0430\u043a\u0443\u0442\u044b, \u043a\u0430\u043b\u0456 \u0442\u0440\u044d\u0431\u0430 \u0434\u0437\u044f\u043b\u0456\u0446\u0446\u0430 \u0433\u0440\u0430\u0448\u044b\u043c\u0430 (\u043c\u0430\u044e \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443), \u0431\u0435\u0434\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u043d\u0430\u043a\u0430\u0437. \u0421\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0433\u044d\u0442\u0430\u043c\u0443 \u045e\u0434\u0430\u0432\u0430, \u044f\u043a\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043b\u0430 \u0434\u0437\u0432\u0435 \u043b\u0435\u043f\u0442\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f, \u044f\u043a \u043b\u044f\u0447\u044b\u0446\u044c \u043d\u0430\u0448\u0443\u044e \u0434\u0443\u0448\u0443, \u0431\u0443\u0434\u0437\u0435\u043c \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u0433\u044d\u0442\u044b\u043c\u0456 \u043b\u0435\u043a\u0430\u043c\u0456, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u044f \u0432\u044b\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u043f\u0430\u0434\u044b\u0441\u0446\u0456 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0441\u0442\u0430\u043b\u0430, \u043a\u0430\u0431 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456\u0441\u0446\u0456 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0425\u0440\u044b\u0441\u0442\u0443, \u041a\u0430\u0440\u0430\u043b\u044e \u0445\u0432\u0430\u043b\u044b, \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u0435\u0447\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0434\u0430\u0431\u0440\u044b\u043d\u044e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0422\u043e\u0431 12, 8ac. 9a; \u041b\u043a 6, 37\u0441-38\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u0437 \u043f\u043e\u0441\u0442\u0430\u043c \u2013 \u0433\u044d\u0442\u0430 \u0434\u043e\u0431\u0440\u0430, \u043b\u0435\u043f\u0448 \u0434\u0430\u0432\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443, \u0447\u044b\u043c \u0437\u0431\u0456\u0440\u0430\u0446\u044c \u0437\u0430\u043b\u0430\u0442\u044b\u044f \u0441\u043a\u0430\u0440\u0431\u044b, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0440\u0430\u0431\u0430\u0447\u0430\u0439\u0446\u0435, \u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u0430\u0446\u044c \u0432\u0430\u043c, \u0434\u0430\u0432\u0430\u0439\u0446\u0435, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u0430\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"214","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0441\u0432. \u041a\u0430\u043b\u0443\u043c\u0431\u0430\u043d\u0430, \u0430\u0431\u0430\u0442\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Instr. 13, De Christo fonte vitae, 1-2: Opera, Dublin 1957, 116-118)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435 \u0456 \u043f\u2019\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u045e\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u043c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b, \u0442\u0430\u043a\u0456\u044f \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u044f \u0434\u043b\u044f \u0432\u0430\u0441. \u0420\u0430\u0441\u043f\u0430\u043b\u044c\u0432\u0430\u0439\u0446\u0435, \u0430 \u043d\u0435 \u0433\u0430\u0441\u0456\u0446\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u0434\u0443\u0448\u0430\u0445 \u043f\u0440\u0430\u0433\u0443 \u0432\u0430\u0434\u044b, \u0448\u0442\u043e \u0432\u044b\u0446\u044f\u043a\u0430\u0435 \u0437 \u0411\u043e\u0436\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b. \u041f\u0440\u0430 \u044f\u0435 \u0445\u0430\u0447\u0443 \u0446\u044f\u043f\u0435\u0440 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c. \u041f\u0456\u0446\u0435, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0432\u0430\u0439\u0446\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c. \u0416\u044b\u0432\u0430\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430, \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f \u043a\u043b\u0456\u0447\u0430 \u043d\u0430\u0441 \u0434\u0430 \u0441\u044f\u0431\u0435 \u0456 \u043a\u0430\u0436\u0430: \u00ab\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435 \u0456 \u043f\u2019\u0435\u00bb (\u042f\u043d 7, 37).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0440\u0430\u0437\u0443\u043c\u0435\u0439\u0446\u0435, \u0448\u0442\u043e \u0432\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u043f\u0456\u0446\u044c. \u041f\u0440\u0430\u0440\u043e\u043a \u0415\u0440\u0430\u043c\u0456\u044f \u043a\u0430\u0436\u0430 \u0432\u0430\u043c, \u0441\u0430\u043c\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u043a\u0430\u0436\u0430: \u00ab\u201d\u042f\u043d\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u041c\u044f\u043d\u0435, \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b\u201d, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d\u00bb (\u0415\u0440 2, 13). \u0410 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0441\u0430\u043c \u041f\u0430\u043d, \u043d\u0430\u0448 \u0411\u043e\u0433, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0436\u044b\u0446\u0446\u044f. \u0422\u0430\u043c\u0443 \u0437\u0430\u043f\u0440\u0430\u0448\u0430\u0435 \u043d\u0430\u0441 \u0434\u0430 \u0441\u044f\u0431\u0435, \u0434\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u043a\u0430\u0431 \u043c\u044b \u043f\u0456\u043b\u0456 \u0437 \u044f\u0435. \u041f\u2019\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c; \u043f\u2019\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0430\u0441\u044b\u0447\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0436\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c; \u0445\u0442\u043e \u043c\u043e\u0446\u043d\u0430 \u043b\u044e\u0431\u0456\u0446\u044c, \u043c\u043e\u0446\u043d\u0430 \u043f\u0440\u0430\u0433\u043d\u0435; \u043f\u2019\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0433\u043e\u0440\u0430\u0447\u0430 \u043f\u0440\u0430\u0433\u043d\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0430\u0434\u043a\u0443\u043b\u044c \u0431\u2019\u0435 \u0433\u044d\u0442\u0430\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430. \u0410\u0434\u0442\u0443\u043b\u044c, \u0430\u0434\u043a\u0443\u043b\u044c \u0437\u044b\u0448\u043e\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0445\u043b\u0435\u0431. \u0411\u043e \u0445\u043b\u0435\u0431 \u0456 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u2013 \u0433\u044d\u0442\u0430 \u0430\u0434\u0437\u0456\u043d \u0456 \u0442\u043e\u0439 \u0436\u0430 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0421\u044b\u043d, \u043d\u0430\u0448 \u0411\u043e\u0433, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d, \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c. \u0425\u043e\u0446\u044c \u043c\u044b \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435\u043c \u042f\u0433\u043e, \u043b\u044e\u0431\u044f\u0447\u044b, \u0445\u043e\u0446\u044c \u043f\u0440\u0430\u0433\u043d\u0435\u043c, \u043f\u0440\u0430\u0433\u043d\u0443\u0447\u044b, \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u043f\u0440\u0430\u0433\u043d\u0435\u043c. \u0411\u0443\u0434\u0437\u0435\u043c \u043f\u0456\u0446\u044c \u0437 \u042f\u0433\u043e \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u044f\u043a \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0437 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e; \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0456\u0446\u044c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437 \u0433\u0430\u0440\u0430\u0447\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043c\u0430\u043a\u0430\u0432\u0430\u0446\u044c \u0441\u043b\u043e\u0434\u044b\u0447 \u042f\u0433\u043e \u0434\u0430\u0431\u0440\u044b\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0441\u0430\u043b\u043e\u0434\u043a\u0456 \u0456 \u0434\u043e\u0431\u0440\u044b; \u0445\u043e\u0446\u044c \u043c\u044b \u043f\u2019\u0435\u043c \u042f\u0433\u043e \u0456 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435\u043c, \u0430\u0434\u043d\u0430\u043a, \u0443\u0441\u0451 \u0440\u043e\u045e\u043d\u0430 \u0430\u0434\u0447\u0443\u0432\u0430\u0435\u043c \u0433\u043e\u043b\u0430\u0434 \u0456 \u0441\u043c\u0430\u0433\u0443; \u0433\u044d\u0442\u0430\u044f \u0435\u0436\u0430 \u0456 \u0433\u044d\u0442\u044b \u043d\u0430\u043f\u043e\u0439 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0437\u0430\u043a\u0430\u043d\u0447\u0432\u0430\u044e\u0446\u0446\u0430. \u0425\u043e\u0446\u044c \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435\u043c \u042f\u0433\u043e, \u0430\u043b\u0435 \u043d\u0435 \u0437\u043c\u043e\u0436\u0430\u043c \u0441\u043f\u0430\u0436\u044b\u0446\u044c \u042f\u0433\u043e \u0446\u0430\u043b\u043a\u0430\u043c, \u0445\u043e\u0446\u044c \u043f\u2019\u0451\u043c, \u0430\u043b\u0435 \u043d\u0435 \u0437\u043c\u043e\u0436\u0430\u043c \u0432\u044b\u043f\u0456\u0446\u044c \u0434\u0430 \u0434\u043d\u0430. \u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u0440\u043e\u043a \u043a\u0430\u0436\u0430: \u00ab\u0421\u0430\u0441\u043c\u0430\u0433\u043b\u044b\u044f, \u0443\u0441\u0435 \u0456\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u0432\u043e\u0434\u0430\u045e\u00bb (\u0406\u0441 55, 1). \u0401\u043d \u2013 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u0430 \u043d\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430\u0441\u044b\u0447\u0430\u043d\u044b. \u0422\u0430\u043c\u0443 \u0401\u043d \u043a\u043b\u0456\u0447\u0430 \u0434\u0430 \u0441\u044f\u0431\u0435 \u0441\u0430\u0441\u043c\u0430\u0433\u043b\u044b\u0445; \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u0430\u0437\u0432\u0430\u045e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u043c\u0456. \u042f\u043d\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0447\u044d\u0440\u043f\u0430\u0446\u044c, \u0430\u043b\u0435 \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0431\u0443\u0434\u0443\u0446\u044c \u0447\u044d\u0440\u043f\u0430\u0446\u044c, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u0447\u0443\u0432\u0430\u0446\u044c \u0441\u043c\u0430\u0433\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430, \u043a\u0430\u0431 \u043c\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u0430\u0433\u043d\u0443\u043b\u0456, \u0448\u0443\u043a\u0430\u043b\u0456 \u0456 \u043b\u044e\u0431\u0456\u043b\u0456 \u00ab\u041a\u0440\u044b\u043d\u0456\u0446\u0443 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445\u00bb, \u0443 \u044f\u043a\u0456\u043c, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430, \u00ab\u0441\u0445\u0430\u0432\u0430\u043d\u044b \u045e\u0441\u0435 \u0441\u043a\u0430\u0440\u0431\u044b \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f\u00bb (\u041a\u043b\u0441 2, 3). \u0413\u044d\u0442\u0430 \u044f\u043d\u043e \u043a\u043b\u0456\u0447\u0430 \u0441\u0430\u0441\u043c\u0430\u0433\u043b\u044b\u0445 \u043f\u0456\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u0433\u043d\u0435\u0448, \u043f\u0456 \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0436\u044b\u0446\u0446\u044f; \u043a\u0430\u043b\u0456 \u0433\u0430\u043b\u043e\u0434\u043d\u044b, \u0435\u0448 \u0445\u043b\u0435\u0431 \u0436\u044b\u0446\u0446\u044f. \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0445\u043b\u0435\u0431\u0430 \u0456 \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b. \u041d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u044e\u0447\u044b \u0456 \u043f\u2019\u044e\u0447\u044b, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c. \u0414\u043e\u0431\u0440\u0430\u044f \u0440\u044d\u0447 \u2013 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0456 \u043f\u0456\u0446\u044c, \u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c. \u0422\u0430\u043c\u0443 \u043a\u0430\u0440\u043e\u043b\u044c \u0456 \u043f\u0440\u0430\u0440\u043e\u043a \u043a\u0430\u0436\u0443\u0446\u044c: \u00ab\u041f\u0430\u043a\u0430\u0448\u0442\u0443\u0439\u0446\u0435 \u0456 \u045e\u0431\u0430\u0447\u0446\u0435, \u044f\u043a\u0456 \u0434\u043e\u0431\u0440\u044b \u0451\u0441\u0446\u044c \u041f\u0430\u043d\u00bb (\u041f\u0441 34 [34], 9).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042f\u043d 7, 37-38&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0415\u0437\u0443\u0441 \u0441\u0442\u0430\u045e \u0456, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e\u0447\u044b, \u0441\u043a\u0430\u0437\u0430\u045e: <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435 \u0456 \u043f\u2019\u0435.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0425\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u041c\u044f\u043d\u0435, \u0443 \u0442\u0430\u0433\u043e \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u043f\u0430\u0446\u044f\u043a\u0443\u0446\u044c \u0440\u044d\u043a\u0456 \u0432\u0430\u0434\u044b \u0436\u044b\u0432\u043e\u0439.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u043b\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"215","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0441\u0432. \u041a\u0430\u043b\u0443\u043c\u0431\u0430\u043d\u0430, \u0430\u0431\u0430\u0442\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Instr. 13, De Christo fonte vitae, 2-3: Opera, Dublin 1957, 118-120)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0422\u044b, \u0411\u043e\u0436\u0430, \u0434\u043b\u044f \u043d\u0430\u0441 <\/span><span style=\"color: #ff0000;\">\u2013<\/span><span style=\"color: #ff0000; font-style: italic;\"> \u0443\u0441\u0451<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0440\u0430\u0442\u044b, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0437\u0430\u043a\u043b\u0456\u043a, \u044f\u043a\u0456\u043c \u0416\u044b\u0446\u0446\u0451 \u0437\u0430\u043f\u0440\u0430\u0448\u0430\u0435 \u043d\u0430\u0441 \u0434\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0436\u044b\u0446\u0446\u044f. \u0413\u044d\u0442\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u0430 \u0456 \u0431\u043b\u044f\u0441\u043a\u0443. \u0417 \u044f\u0433\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u045e\u0441\u0451: \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0436\u044b\u0446\u0446\u0451 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e. \u0414\u0430\u045e\u0446\u0430 \u0436\u044b\u0446\u0446\u044f \u2013 \u0433\u044d\u0442\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f, \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0441\u0432\u044f\u0442\u043b\u0430 \u2013 \u0433\u044d\u0442\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u0430. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043d\u0430 \u0447\u0430\u0441\u043e\u0432\u044b\u044f \u0440\u044d\u0447\u044b, \u043d\u0456\u0431\u044b \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u044f \u0440\u044b\u0431\u044b, \u0430\u043b\u0435 \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u043f\u0430-\u0437\u0430 \u0431\u0430\u0447\u043d\u044b\u043c \u0441\u0432\u0435\u0442\u0430\u043c \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u0441\u0432\u044f\u0442\u043b\u0430, \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u0436\u044b\u0446\u0446\u044f, \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b, \u043a\u0430\u0431 \u0447\u044d\u0440\u043f\u0430\u0446\u044c \u0436\u044b\u0432\u0443\u044e \u0432\u0430\u0434\u0443, \u00ab\u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435\u00bb (\u042f\u043d 4, 14).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0411\u043e\u0436\u0430 \u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u041f\u0430\u043d\u0435, \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u043c\u044f\u043d\u0435 \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u043c \u0437 \u0443\u0441\u0456\u043c\u0456, \u0445\u0442\u043e \u0426\u044f\u0431\u0435 \u043f\u0440\u0430\u0433\u043d\u0435, \u044f \u043c\u043e\u0433 \u0447\u044d\u0440\u043f\u0430\u0446\u044c \u0437 \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b. \u041a\u0430\u0431 \u044f, \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u0441\u043b\u043e\u0434\u044b\u0447\u0447\u0443, \u0448\u0442\u043e\u0440\u0430\u0437 \u043c\u0430\u0446\u043d\u0435\u0439 \u0442\u0440\u044b\u043c\u0430\u045e\u0441\u044f \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0456 \u043a\u0430\u0437\u0430\u045e: \u00ab\u042f\u043a\u0430\u044f \u0436 \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b, \u0443 \u044f\u043a\u043e\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0445\u0430\u043f\u0430\u0435 \u0432\u0430\u0434\u044b, \u201c\u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435\u201d\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041e \u041f\u0430\u043d\u0435, \u0422\u044b \u2013 \u0442\u0430\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430, \u044f\u043a\u043e\u0439 \u043c\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u0430\u0433\u043d\u0435\u043c, \u0437 \u044f\u043a\u043e\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u043e\u0436\u0430\u043c \u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0447\u044d\u0440\u043f\u0430\u0446\u044c. \u041f\u0430\u043d\u0435 \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u0430\u0432\u0430\u0439 \u043d\u0430\u043c \u0433\u044d\u0442\u0443\u044e \u0432\u0430\u0434\u0443, \u043a\u0430\u0431 \u044f\u043d\u0430 \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0441 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b, \u00ab\u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435\u00bb. \u0425\u0442\u043e \u0436 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u043b\u0430\u0441\u043a\u0430, \u0430\u0431 \u044f\u043a\u043e\u0439 \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c? \u0410\u0434\u043d\u0430\u043a \u0422\u044b, \u043e \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u043b\u0430\u0432\u044b, \u0443\u043c\u0435\u0435\u0448 \u0434\u0430\u0432\u0430\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0440\u044d\u0447\u044b \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0440\u044d\u0447\u044b \u0430\u0431\u044f\u0446\u0430\u045e. \u041d\u044f\u043c\u0430 \u043d\u0456\u043a\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448\u0430\u0433\u0430 \u0437\u0430 \u0426\u044f\u0431\u0435, \u0430 \u0422\u044b \u0434\u0430\u045e \u043d\u0430\u043c \u0441\u044f\u0431\u0435 \u0456 \u0437\u0430 \u043d\u0430\u0441 \u0441\u044f\u0431\u0435 \u0432\u044b\u0434\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u0434\u0430\u0437\u0432\u043e\u043b\u044c \u043d\u0430\u043c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u043b\u044e\u0431\u0456\u043c, \u0431\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0445\u043e\u0447\u0430\u043c \u043c\u0435\u0446\u044c \u043f\u0430-\u0437\u0430 \u0422\u0430\u0431\u043e\u044e. \u0422\u044b \u0434\u043b\u044f \u043d\u0430\u0441 \u2013 \u0443\u0441\u0451: \u043d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0441\u0432\u044f\u0442\u043b\u043e, \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a, \u043d\u0430\u043f\u043e\u0439 \u0456 \u043d\u0430\u0448 \u0411\u043e\u0433.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u043d\u0430\u0448 \u0415\u0437\u0443, \u043d\u0430\u043f\u043e\u045e\u043d\u0456 \u043d\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0435\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430, \u0437\u0440\u0430\u043d\u044c \u043d\u0430\u0448\u0443\u044e \u0434\u0443\u0448\u0443 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u045e\u044e, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u0430\u044f \u0434\u0443\u0448\u0430 \u043c\u0430\u0433\u043b\u0430 \u0437 \u0443\u0441\u0451\u0439 \u0448\u0447\u044b\u0440\u0430\u0441\u0446\u044e \u0441\u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u041f\u0430\u043a\u0430\u0436\u044b \u043c\u043d\u0435, \u043a\u0430\u0433\u043e \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0430 \u043c\u0430\u044f \u0434\u0443\u0448\u0430\u00bb, \u0431\u043e \u044f\u043d\u0430 \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u0430 \u043b\u044e\u0431\u043e\u045e\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0433\u043d\u0443, \u043a\u0430\u0431 \u0433\u044d\u0442\u044b\u044f \u0440\u0430\u043d\u044b \u0431\u044b\u043b\u0456 \u045e\u0432\u0430 \u043c\u043d\u0435, \u043e \u041f\u0430\u043d\u0435. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u0434\u0443\u0448\u0430, \u044f\u043a\u0430\u044f \u0442\u0430\u043a \u0437\u0440\u0430\u043d\u0435\u043d\u0430 \u043b\u044e\u0431\u043e\u045e\u044e. \u042f\u043d\u0430 \u0448\u0443\u043a\u0430\u0435 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0456 \u043f\u2019\u0435, \u0430\u0434\u043d\u0430\u043a, \u043f\u2019\u044e\u0447\u044b, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u0430\u0433\u043d\u0435, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0446\u0435\u0440\u043f\u0456\u0446\u044c, \u043f\u0440\u0430\u0433\u043d\u0443\u0447\u044b \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u2019\u0435, \u043f\u0440\u0430\u0433\u043d\u0443\u0447\u044b. \u0422\u0430\u043a \u043b\u044e\u0431\u044f\u0447\u044b, \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u0448\u0443\u043a\u0430\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u0435, \u043a\u0430\u043b\u0456 \u0437\u0440\u0430\u043d\u0456\u045e. \u041d\u044f\u0445\u0430\u0439 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u0435 \u0437\u0440\u0430\u043d\u0456\u0446\u044c \u043d\u0430\u0448\u0443\u044e \u0434\u0443\u0448\u0443 \u0441\u0432\u0430\u0451\u0439 \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u0430\u0439 \u0440\u0430\u043d\u0430\u0439 \u0411\u043e\u0433 \u0456 \u041f\u0430\u043d \u043d\u0430\u0448 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0456 \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u044b \u043b\u0435\u043a\u0430\u0440, \u044f\u043a\u043e\u043c\u0443 \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u042f\u043d 4, 14-15\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0425\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0456\u0446\u044c \u0432\u0430\u0434\u0443, \u044f\u043a\u0443\u044e \u042f \u0434\u0430\u043c \u044f\u043c\u0443, \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u0435 \u0441\u043c\u0430\u0433\u0456 \u043d\u0430\u0432\u0435\u043a\u0456; <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0432\u0430\u0434\u0430, \u044f\u043a\u0443\u044e \u0434\u0430\u043c \u044f\u043c\u0443, \u0441\u0442\u0430\u043d\u0435 \u045e \u0456\u043c \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0432\u0430\u0434\u044b, \u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d\u0435, \u0434\u0430\u0439 \u043c\u043d\u0435 \u0433\u044d\u0442\u0430\u0439 \u0432\u0430\u0434\u044b, \u043a\u0430\u0431 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0412\u0430\u0434\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"216","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0401\u044d\u043b\u044f\u00bb \u0441\u0432. \u0413\u0435\u0440\u0430\u043d\u0456\u043c\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(PL 25, 967-968)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0434\u0430 \u041c\u044f\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0417\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0434\u0430 \u041c\u044f\u043d\u0435 \u045e\u0441\u0456\u043c \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c\u00bb (\u0401\u044d\u043b 2, 12). \u0410\u0431\u0443\u0434\u0437\u0456\u0446\u0435 \u0441\u043a\u0440\u0443\u0445\u0443 \u043f\u0440\u0430\u0437 \u043f\u043e\u0441\u0442, \u043f\u043b\u0430\u0447 \u0456 \u0433\u0430\u043b\u0430\u0448\u044d\u043d\u043d\u0435, \u043a\u0430\u0431 \u0446\u044f\u043f\u0435\u0440, \u0437\u0432\u044f\u0440\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0437 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u0439, \u043f\u0430\u0441\u043b\u044f \u0432\u044b \u0431\u044b\u043b\u0456 \u043d\u0430\u0441\u044b\u0447\u0430\u043d\u044b\u044f; \u0446\u044f\u043f\u0435\u0440 \u2013 \u043f\u043b\u0430\u0447, \u043f\u0430\u0441\u043b\u044f \u2013 \u0440\u0430\u0434\u0430\u0441\u0446\u044c; \u0446\u044f\u043f\u0435\u0440 \u2013 \u0441\u043c\u0443\u0442\u0430\u043a, \u043f\u0430\u0441\u043b\u044f \u2013 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e \u0446\u044f\u0436\u043a\u0456\u044f \u0445\u0432\u0456\u043b\u0456\u043d\u044b \u0456 \u045e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0432\u044b \u043c\u0430\u0435\u0446\u0435 \u0437\u0432\u044b\u0447\u0430\u0439 \u0440\u0430\u0437\u0440\u044b\u0432\u0430\u0446\u044c \u0448\u0430\u0442\u044b (\u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0456\u045e, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456, \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440, \u043a\u0430\u0431 \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0446\u044c \u0432\u0456\u043d\u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b; \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435, \u044f\u043a \u0447\u044b\u0442\u0430\u0435\u043c, \u0437\u0440\u0430\u0431\u0456\u045e \u041f\u0430\u0432\u0435\u043b \u0456 \u0411\u0430\u0440\u043d\u0430\u0431\u0430, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u043b\u0456 \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u0430), \u0442\u043e \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u044e \u0432\u0430\u043c, \u043d\u0435 \u0440\u0430\u0437\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u0441\u0432\u0430\u0451 \u0430\u0434\u0437\u0435\u043d\u043d\u0435, \u0430\u043b\u0435 \u0441\u044d\u0440\u0446\u044b. \u042f\u043d\u044b \u043f\u043e\u045e\u043d\u044b\u044f \u0433\u0440\u0430\u0445\u043e\u045e, \u0456 \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0440\u0430\u044f\u0432\u044f\u0446\u044c \u0441\u043a\u0440\u0443\u0445\u0456, \u0441\u0430\u043c\u0456 \u0440\u0430\u0437\u0430\u0440\u0432\u0443\u0446\u0446\u0430 \u043d\u0456\u0431\u044b \u043c\u044f\u0445\u0456. \u0422\u0430\u043a \u0440\u0430\u0431\u0456\u0446\u0435 \u2013 \u0456 \u0432\u0435\u0440\u043d\u0435\u0446\u0435\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u0430\u0434 \u044f\u043a\u043e\u0433\u0430 \u0430\u0434\u044b\u0448\u043b\u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456. \u041d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0431\u0435\u0437\u043b\u0456\u0447 \u0432\u0430\u0448\u044b\u0445 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f\u045e \u043d\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u045e \u0411\u043e\u0436\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u0431\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0437\u043c\u043e\u0436\u0430 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0456 \u0433\u0440\u044d\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e\u0433 \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b; \u043f\u0440\u0430\u0433\u043d\u0435 \u0431\u043e\u043b\u044c\u0448 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430, \u0430 \u043d\u0435 \u044f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u0456. \u0401\u043d \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b \u0456 \u043f\u043e\u045e\u043d\u044b \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456; \u043d\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u043b\u044e\u0434\u0437\u0435\u0439 \u0443 \u043d\u0435\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0434\u043e\u045e\u0433\u0430 \u0447\u0430\u043a\u0430\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f. \u0401\u043d \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u0456 \u043c\u043e\u0436\u0430 \u0430\u0434\u043c\u044f\u043d\u0456\u0446\u044c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435. \u0413\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043c\u044b \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e, \u0442\u043e \u0456 \u0401\u043d \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0435 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0446\u044c \u0456 \u043d\u0435 \u0441\u043f\u0430\u0448\u043b\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e. \u041a\u0430\u043b\u0456 \u0437\u043c\u0435\u043d\u0456\u043c\u0441\u044f \u043c\u044b, \u0442\u043e \u0437\u043c\u0435\u043d\u0456\u0446\u0446\u0430 \u0456 \u0401\u043d. \u0417\u043b\u043e \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0442\u0443\u0442 \u044f\u043a \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u043b\u0435\u0433\u043b\u0430\u0441\u0446\u044c \u0446\u043d\u043e\u0442\u044b, \u0430\u043b\u0435 \u044f\u043a \u0432\u0456\u0434 \u0442\u0430\u0433\u043e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f, \u043f\u0440\u0430 \u044f\u043a\u043e\u0435 \u0447\u044b\u0442\u0430\u0435\u043c: \u00ab\u0425\u043e\u043f\u0456\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0434\u043d\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u043a\u043b\u043e\u043f\u0430\u0442\u0443\u00bb (\u041c\u0446 6, 34) \u0456: \u00ab\u0426\u0456 \u0451\u0441\u0446\u044c \u0443 \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0437\u043b\u043e, \u044f\u043a\u043e\u0433\u0430 \u0431 \u043d\u0435 \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u041f\u0430\u043d\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u044d\u043b\u044c \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041f\u0430\u043d \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b, \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b \u0456 \u0448\u043c\u0430\u0442\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u044b, \u043d\u0435\u0430\u0445\u0432\u043e\u0447\u044b \u0434\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f\u00bb (\u0401\u044d\u043b 2, 13-14). \u0410\u043b\u0435 \u043a\u0430\u0431 \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u044f \u0434\u0430\u0431\u0440\u044b\u043d\u044f \u043d\u0435 \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u043d\u0430\u0448\u0430\u0439 \u043b\u0435\u0433\u043a\u0430\u0434\u0443\u043c\u043d\u0430\u0441\u0446\u0456, \u0443 \u0441\u0432\u0430\u0456\u043c \u043f\u0440\u0430\u0440\u043e\u0446\u043a\u0456\u043c \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0456 \u0451\u043d \u0434\u0430\u0434\u0430\u0435: \u00ab\u042f \u043a\u043b\u0456\u0447\u0443 \u0432\u0430\u0441 \u0434\u0430 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f, \u0456 \u0433\u044d\u0442\u0430 \u043c\u043e\u0439 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a, \u0456 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0411\u043e\u0433 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430 \u043b\u0430\u0441\u043a\u0430\u0432\u044b, \u044f\u043a \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0414\u0430\u0432\u0456\u0434: \u201e\u0417\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e, \u0411\u043e\u0436\u0430, \u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u0446\u0456 \u0422\u0432\u0430\u0451\u0439; \u0456 \u045e \u043f\u0430\u045e\u043d\u0430\u0446\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0422\u0432\u0430\u0451\u0439 \u0437\u043d\u0456\u0448\u0447\u044b \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u043c\u0430\u0435\u201d (\u041f\u0441 51 [50], 3)\u00bb. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u0446\u0446\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c \u0443 \u042f\u0433\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456, \u0442\u043e \u0430\u0441\u0446\u044f\u0440\u043e\u0436\u043d\u0430 \u043a\u0430\u0436\u0443, \u0430, \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0435\u0439, \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u044e \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u0447\u044b\u043c \u0447\u0430\u043a\u0430\u043d\u043d\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0425\u0442\u043e \u0432\u0435\u0434\u0430\u0435, \u043c\u043e\u0436\u0430 \u043f\u0430\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0401\u043d \u0456 \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u0435\u00bb (\u0401\u044d\u043b 2, 14). \u0412\u044b\u0440\u0430\u0437 \u00ab\u0445\u0442\u043e \u0432\u0435\u0434\u0430\u0435\u00bb \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0432\u0430\u0435 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0430\u0431\u043e \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0410\u0445\u0432\u044f\u0440\u0430 \u043d\u0435\u043a\u0440\u044b\u0432\u0430\u0432\u0430\u044f \u0456 \u0437 \u043d\u0430\u043f\u043e\u044f\u045e \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430\u00bb (\u043f\u0430\u0440. \u0401\u044d\u043b 2, 14). \u0413\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u043f\u0430\u0441\u043b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u044f \u043c\u044b \u0437\u043c\u043e\u0436\u0430\u043c \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0411\u043e\u0433\u0443 \u0430\u0445\u0432\u044f\u0440\u044b.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041f\u0441 24 (23), 4; 2 \u041a\u0430\u0440 6, 6; \u043f\u0430\u0440. \u041a\u043b\u0441 2, 14; \u0401\u044d\u043b 2, 13\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u045e\u0441\u0435 \u0440\u0430\u0437\u0430\u043c \u0434\u0430 \u0411\u043e\u0433\u0430 \u0437 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0434\u0443\u0448\u043e\u044e, \u0443 \u043d\u0435\u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u043a\u0430\u0431 \u0437\u0430\u043f\u0456\u0441 \u0432\u0430\u0448\u044b\u0445 \u0434\u0430\u045e\u0433\u043e\u045e \u0431\u044b\u045e \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u043d\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0420\u0430\u0437\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f, \u0430 \u043d\u0435 \u0432\u0430\u0448\u0430\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435; \u043d\u0430\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431 \u0437\u0430\u043f\u0456\u0441.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"217","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432. \u041c\u0430\u0446\u0432\u0435\u044f\u00bb \u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 50, 3-4: PG 58, 508-509)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0437\u0434\u0430\u0431\u043b\u044f\u044e\u0447\u044b \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0439 \u043f\u0440\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u0445<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448 \u0430\u0434\u0434\u0430\u0446\u044c \u043f\u0430\u0448\u0430\u043d\u0443 \u0426\u0435\u043b\u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0439 \u043f\u0440\u0430 \u042f\u0433\u043e, \u043a\u0430\u043b\u0456 \u0401\u043d \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u043f\u0430\u0442\u0440\u044d\u0431\u0435. \u041d\u0435 \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0439 \u042f\u0433\u043e \u0448\u0430\u045e\u043a\u043e\u0432\u044b\u043c\u0456 \u0448\u0430\u0442\u0430\u043c\u0456 \u045e \u043a\u0430\u0441\u0446\u0451\u043b\u0435, \u043a\u0430\u043b\u0456 \u0437\u0432\u043e\u043d\u043a\u0443 \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435\u0448, \u0448\u0442\u043e \u0401\u043d \u0437\u043c\u0435\u0440\u0437 \u0456 \u043d\u0430\u0433\u0456. \u0411\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0413\u044d\u0442\u0430 \u0426\u0435\u043b\u0430 \u041c\u0430\u0451\u00bb, \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e, \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u00ab\u042f \u0431\u044b\u045e \u0433\u0430\u043b\u043e\u0434\u043d\u044b, \u0456 \u0432\u044b \u043d\u0435 \u0434\u0430\u043b\u0456 \u041c\u043d\u0435 \u0435\u0441\u0446\u0456\u00bb (\u041c\u0446 25, 42), \u0456 \u044f\u0448\u0447\u044d: \u00ab\u0447\u0430\u0433\u043e \u0432\u044b \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0430\u0434\u043d\u0430\u043c\u0443 \u0437 \u0433\u044d\u0442\u044b\u0445 \u043c\u0435\u043d\u0448\u044b\u0445, \u0442\u0430\u0433\u043e \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u041c\u043d\u0435\u00bb (\u041c\u0446 25, 45). \u0422\u0443\u0442, \u0443 \u043a\u0430\u0441\u0446\u0451\u043b\u0435, \u0401\u043d \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u043f\u043b\u0430\u0448\u0447\u0430, \u0430\u043b\u0435 \u0447\u044b\u0441\u0442\u044b\u0445 \u0434\u0443\u0448\u0430\u045e, \u0430 \u0442\u0430\u043c, \u0437\u0432\u043e\u043d\u043a\u0443, \u0432\u0435\u043b\u044c\u043c\u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0442\u0430\u043a \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0456 \u0442\u0430\u043a \u0443\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a \u0401\u043d \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435. \u0411\u043e \u043d\u0430\u0439<\/span><span><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span>\u043c\u0456\u043b\u0435\u0439\u0448\u044b\u043c \u0434\u043b\u044f \u042f\u0433\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u0401\u043d \u0441\u0430\u043c \u043f\u0440\u0430\u0433\u043d\u0435, \u0430 \u043d\u0435 \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u043c\u044b \u0442\u0430\u043a\u0456\u043c \u043b\u0456\u0447\u044b\u043c. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a \u0434\u0443\u043c\u0430\u045e \u041f\u0451\u0442\u0440, \u0448\u0442\u043e \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435 \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u042f\u043c\u0443 \u0430\u0431\u043c\u044b\u0446\u044c \u0441\u0430\u0431\u0435 \u043d\u043e\u0433\u0456. \u041d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u0433\u044d\u0442\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u043f\u0430\u0448\u0430\u043d\u044b, \u0430\u043b\u0435 \u0447\u044b\u043c\u0441\u044c\u0446\u0456 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u0456\u043d\u0448\u044b\u043c. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0442\u044b \u0430\u0434\u0434\u0430\u0439 \u042f\u043c\u0443 \u043f\u0430\u0448\u0430\u043d\u0443 \u044f\u043a \u0401\u043d \u0445\u043e\u0447\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0440\u0430\u0437\u0434\u0430\u0439 \u0441\u0432\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u043c. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433\u0443 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b \u043d\u0435 \u0437\u0430\u043b\u0430\u0442\u044b \u043f\u043e\u0441\u0443\u0434, \u0430\u043b\u0435 \u0437\u0430\u043b\u0430\u0442\u0430\u044f \u0434\u0443\u0448\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u0436\u0443 \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0442\u044b \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u045e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u0430\u043b\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0445\u0430\u0447\u0443, \u043a\u0430\u0431 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0430 \u043d\u0430\u0432\u0430\u0442 \u043f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451, \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u044b. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043c\u0430\u0435 \u0442\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u0430\u043b\u0435 \u043d\u0430\u0448\u043c\u0430\u0442 \u0431\u043e\u043b\u044c\u0448 \u0446\u044d\u043d\u0456\u0446\u044c \u0456\u043d\u0448\u044b\u044f. \u0423 \u043f\u0435\u0440\u0448\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u043c\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u0434\u0430\u045e\u0446\u0430; \u0443 \u0434\u0440\u0443\u0433\u0456\u043c \u2013 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435. \u0423 \u043f\u0435\u0440\u0448\u044b\u043c \u2013 \u0434\u0430\u0440 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u044e \u0433\u043e\u043d\u0430\u0440\u0443, \u0443 \u0434\u0440\u0443\u0433\u0456\u043c \u2013 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u0434\u0430\u0431\u0440\u044b\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a\u0430\u044f \u0436 \u043a\u0430\u0440\u044b\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u0441\u0442\u043e\u043b \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u044e\u0446\u044c \u0437\u0430\u043b\u0430\u0442\u044b\u044f \u043a\u0435\u043b\u0456\u0445\u0456, \u0430 \u0401\u043d \u0441\u0430\u043c \u2013 \u0433\u0430\u043b\u043e\u0434\u043d\u044b. \u0414\u0430\u0439 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0435\u0441\u0446\u0456 \u0433\u0430\u043b\u043e\u0434\u043d\u0430\u043c\u0443, \u0430 \u043f\u0430\u0441\u043b\u044f \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0439 \u042f\u0433\u043e \u0441\u0442\u043e\u043b. \u041f\u0440\u044b\u043d\u043e\u0441\u0456\u0448 \u0443 \u0434\u0430\u0440 \u0437\u0430\u043b\u0430\u0442\u044b \u043a\u0435\u043b\u0456\u0445, \u0430 \u043d\u0435 \u043f\u0430\u0434\u0430\u045e \u043a\u0443\u0431\u043a\u0430 \u0432\u0430\u0434\u044b? \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0436 \u0437\u0430\u0441\u0446\u0456\u043b\u0430\u0446\u044c \u0441\u0442\u043e\u043b \u0425\u0440\u044b\u0441\u0442\u0430 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u043c\u0456 \u0430\u0431\u0440\u0443\u0441\u0430\u043c\u0456, \u043a\u0430\u043b\u0456 \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u0435\u0448 \u042f\u043c\u0443 \u045e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u043c \u0430\u0434\u0437\u0435\u043d\u043d\u0456? \u042f\u043a\u0430\u044f \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c? \u0421\u043a\u0430\u0436\u044b \u043c\u043d\u0435, \u043a\u0430\u043b\u0456 \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0435\u0448 \u0433\u0430\u043b\u043e\u0434\u043d\u0430\u0433\u0430 \u0456 \u043d\u0435 \u0437\u043e\u0439\u043c\u0435\u0448\u0441\u044f \u0456\u043c, \u0430 \u0431\u0443\u0434\u0437\u0435\u0448 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0446\u044c \u0434\u043b\u044f \u044f\u0433\u043e \u0441\u0442\u043e\u043b \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u043c\u0456 \u0440\u044d\u0447\u0430\u043c\u0456, \u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u0451\u043d \u0442\u0430\u0431\u0435 \u0437\u0430 \u0433\u044d\u0442\u0430 \u045e\u0434\u0437\u044f\u0447\u043d\u044b, \u0430 \u043c\u043e\u0436\u0430 \u0445\u0443\u0442\u0447\u044d\u0439 \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u0435\u0446\u0446\u0430. \u0410 \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0448 \u044f\u0433\u043e, \u0434\u0440\u044b\u0436\u0430\u0447\u0430\u0433\u0430 \u0430\u0434 \u0445\u043e\u043b\u0430\u0434\u0443, \u0443 \u043f\u0430\u0440\u0432\u0430\u043d\u0430\u0439 \u0432\u043e\u043f\u0440\u0430\u0442\u0446\u044b \u0456 \u043f\u0430\u043a\u0456\u043d\u0435\u0448 \u0431\u0435\u0437 \u0430\u0434\u0437\u0435\u043d\u043d\u044f, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0437\u0430\u043b\u0430\u0442\u044b\u044f \u043a\u0430\u043b\u043e\u043d\u044b, \u0434\u0443\u043c\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u0448 \u0433\u044d\u0442\u0430 \u0434\u0437\u0435\u043b\u044f \u042f\u0433\u043e \u0445\u0432\u0430\u043b\u044b, \u0442\u043e \u0446\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u043b\u0456\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u042f\u0433\u043e \u043d\u044f\u0433\u043e\u0434\u043d\u0430 \u0432\u044b\u0441\u043c\u0435\u0439\u0432\u0430\u044e\u0446\u044c \u0456 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u044e\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0434\u0443\u043c\u0430\u0439, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u0430\u043d\u0434\u0440\u0443\u0435 \u0456 \u0431\u043b\u0443\u043a\u0430\u0435, \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0434\u0430\u0445\u0443 \u043d\u0430\u0434 \u0433\u0430\u043b\u0430\u0432\u043e\u0439; \u0430 \u0442\u044b, \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u042f\u0433\u043e \u0434\u0430 \u0441\u044f\u0431\u0435, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0435\u0448 \u0434\u043b\u044f \u042f\u0433\u043e \u043f\u0430\u0434\u043b\u043e\u0433\u0443, \u0441\u0446\u0435\u043d\u044b \u0456 \u043a\u0430\u043f\u0456\u0442\u044d\u043b\u0456 \u043a\u0430\u043b\u043e\u043d\u0430\u045e. \u0421\u044f\u0440\u044d\u0431\u0440\u0430\u043d\u044b\u043c\u0456 \u043b\u0430\u043d\u0446\u0443\u0433\u0430\u043c\u0456 \u043f\u0440\u044b\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435\u0448 \u043b\u044f\u043c\u043f\u044b, \u0430 \u043d\u0430 \u042f\u0433\u043e, \u0437\u0432\u044f\u0437\u0430\u043d\u0430\u0433\u0430 \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u044b, \u043d\u0430\u0432\u0430\u0442 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0435 \u0445\u043e\u0447\u0430\u0448. \u041a\u0430\u0436\u0443 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u0456\u0446\u044c \u0443\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u043d\u043d\u0456, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0442\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u045e \u043f\u0440\u0430 \u0442\u043e\u0435 \u0456 \u0434\u0440\u0443\u0433\u043e\u0435, \u0430 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0430\u044e, \u043a\u0430\u0431 \u0442\u044b \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u045e\u0441\u044f \u043f\u0440\u0430 \u0433\u044d\u0442\u0430\u0435, \u0430 \u043f\u0430\u0437\u043d\u0435\u0439 \u043f\u0440\u0430 \u0442\u043e\u0435. \u0411\u043e \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u043b\u0456 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u045e \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u043d\u043d\u0435, \u0430\u043b\u0435 \u0442\u044b\u044f, \u0445\u0442\u043e \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0441\u0446\u044f\u0433\u0432\u0430\u044e\u0446\u044c \u043d\u0430 \u0441\u044f\u0431\u0435 \u043a\u0430\u0440\u0443 \u043d\u0435\u043f\u0430\u0433\u0430\u0441\u043d\u0430\u0433\u0430 \u0430\u0433\u043d\u044e, \u043a\u0430\u0440\u0443 \u0440\u0430\u0437\u0430\u043c \u0437 \u0434\u044d\u043c\u0430\u043d\u0430\u043c\u0456. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0435\u0448 \u043a\u0430\u0441\u0446\u0451\u043b, \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0439 \u043f\u0440\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u0430\u0433\u0430. \u0411\u043e \u0441\u0432\u044f\u0442\u044b\u043d\u044f, \u044f\u043a\u043e\u0439 \u0451\u043d \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430, \u043d\u0430\u0448\u043c\u0430\u0442 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0435\u0439\u0448\u0430\u044f \u0437\u0430 \u0442\u0443\u044e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0446 25, 35. 40; \u043f\u0430\u0440. \u041f\u0440\u044b\u043f 19, 17\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u0431\u044b\u045e \u0433\u0430\u043b\u043e\u0434\u043d\u044b, \u0456 \u0432\u044b \u0434\u0430\u043b\u0456 \u041c\u043d\u0435 \u0435\u0441\u0446\u0456; \u043f\u0440\u0430\u0433\u043d\u0443\u045e, \u0456 \u0432\u044b \u043d\u0430\u043f\u0430\u0456\u043b\u0456 \u041c\u044f\u043d\u0435; \u0431\u044b\u045e \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u044b\u043c, \u0456 \u0432\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u041c\u044f\u043d\u0435. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043a\u0430\u0436\u0443 \u0432\u0430\u043c: \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0430\u0434\u043d\u0430\u043c\u0443 \u0437 \u0433\u044d\u0442\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u041c\u0430\u0456\u0445 \u043c\u0435\u043d\u0448\u044b\u0445, \u0432\u044b \u041c\u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0456.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0425\u0442\u043e \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u0431\u0435\u0434\u043d\u044b\u043c, \u043f\u0430\u0437\u044b\u0447\u0430\u0435 \u0441\u0430\u043c\u043e\u043c\u0443 \u041f\u0430\u043d\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"221","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 23A, 1-4: CCL 41, 321-323)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u043d \u043f\u0440\u0430\u044f\u0432\u0456\u045e \u0434\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u043a\u0430\u043b\u0456 \u0440\u043e\u0431\u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0447\u0443\u0435\u043c \u0456 \u0448\u0442\u043e \u0430\u043f\u044f\u0432\u0430\u0435\u043c. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u043d\u0430\u0448\u0430\u0435 \u0441\u043b\u0443\u0445\u0430\u043d\u043d\u0435 \u2013 \u0433\u044d\u0442\u0430 \u0441\u043f\u0435\u045e, \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u044c \u2013 \u043f\u043b\u0451\u043d \u0441\u043f\u0435\u0432\u0443. \u042f \u045e\u0436\u043e \u043a\u0430\u0437\u0430\u045e \u0440\u0430\u043d\u0435\u0439, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u0431\u044f\u0441\u043f\u043b\u0451\u043d\u043d\u044b\u043c\u0456 \u045e \u043a\u0430\u0441\u0446\u0451\u043b\u0435, \u043a\u0430\u043b\u0456 \u0447\u0443\u0435\u0446\u0435 \u043f\u0440\u0430 \u0442\u0430\u043a\u0456\u044f \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0441\u0432\u044f\u0442\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u0430\u043b\u0435 \u0441\u0432\u044f\u0442\u0430 \u043d\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0435. \u0411\u043e \u043c\u044b \u00ab\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043b\u0430\u0441\u043a\u0430\u044e \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u2013 \u044f\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b. \u2013 \u0406 \u043d\u0435 \u043f\u0440\u0430\u0437 \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0445\u0432\u0430\u043b\u0456\u045e\u0441\u044f\u00bb (\u043f\u0430\u0440. \u042d\u0444 2, 8-9). \u00ab\u0412\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043b\u0430\u0441\u043a\u0430\u044e\u00bb (\u042d\u0444 2, 5). \u0420\u0430\u043d\u0435\u0439 \u043c\u044b \u043d\u0435 \u0436\u044b\u043b\u0456 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0432\u044f\u0442\u0430, \u043a\u0430\u0431 \u0411\u043e\u0433 \u043c\u043e\u0433 \u043f\u0430\u043b\u044e\u0431\u0456\u0446\u044c \u0442\u0430\u043a\u043e\u0435 \u0436\u044b\u0446\u0446\u0451 \u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u0421\u044b\u0434\u0437\u0435\u043c, \u0434\u0430\u043f\u0430\u043c\u043e\u0436\u0430\u043c \u043b\u044e\u0434\u0437\u044f\u043c, \u0431\u043e \u044f\u043d\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c \u0433\u043e\u0434\u043d\u0430\u00bb. \u041d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u042f\u043c\u0443 \u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u043d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u042f\u043c\u0443 \u043d\u0435 \u0434\u0430\u0441\u043f\u0430\u0434\u043e\u0431\u044b \u0431\u044b\u043b\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0440\u043e\u0431\u0456\u043c. \u042f\u043c\u0443 \u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u0441\u0430\u043c \u0443 \u043d\u0430\u0441 \u0437\u0440\u0430\u0431\u0456\u045e. \u0422\u0430\u043c\u0443 \u045e\u0441\u0451, \u0448\u0442\u043e \u043c\u044b \u0440\u043e\u0431\u0456\u043c, \u0401\u043d \u0430\u0434\u043a\u0456\u043d\u0435, \u0430 \u045e\u0440\u0430\u0442\u0443\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u0430\u043c \u0443\u0447\u044b\u043d\u0456\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u0434\u043e\u0431\u0440\u044b\u043c\u0456. \u0410\u0434\u043d\u0430\u043a \u0411\u043e\u0433 \u0437\u043b\u0456\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u043f\u0430\u043c\u0451\u0440 \u043d\u0435 \u0437\u0430 \u0434\u043e\u0431\u0440\u044b\u0445, \u0430\u043b\u0435 \u0437\u0430 \u0434\u0440\u044d\u043d\u043d\u044b\u0445, \u043d\u0435 \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445, \u0430\u043b\u0435 \u0437\u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e. \u0411\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u00ab\u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445\u00bb (\u0420\u044b\u043c 5, 6). \u0414\u0430\u043b\u0435\u0439 \u0436\u0430 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u0411\u043e \u043d\u0430\u045e\u0440\u0430\u0434 \u0446\u0456 \u043d\u0435\u0445\u0442\u0430 \u043f\u0430\u043c\u0440\u044d \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430. \u041c\u043e\u0436\u0430, \u0437\u0430 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0435\u0445\u0442\u0430 \u0456 \u0430\u0434\u0432\u0430\u0436\u044b\u0446\u0446\u0430 \u043f\u0430\u043c\u0435\u0440\u0446\u0456\u00bb (\u0420\u044b\u043c 5, 7). \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u043c\u043e\u0436\u0430 \u0441\u0442\u0430\u0446\u0446\u0430, \u0448\u0442\u043e \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0430\u0434\u0432\u0430\u0436\u044b\u0446\u0446\u0430 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0437\u0430 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0410\u0434\u043d\u0430\u043a \u0437\u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430, \u0434\u0440\u044d\u043d\u043d\u0430\u0433\u0430 \u0456 \u043b\u0436\u044b\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0445\u0442\u043e \u0436 \u0437\u0430\u0445\u043e\u0447\u0430 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0430\u043a\u0440\u0430\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430, \u0448\u0442\u043e \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0440\u0430\u0442\u044b, \u0443 \u043d\u0430\u0441 \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0456\u044f\u043a\u0456\u0445 \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e; \u0443\u0441\u0435 \u0431\u044b\u043b\u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u044f. \u0406 \u0445\u043e\u0446\u044c \u0442\u0430\u043a\u0456\u043c\u0456 \u0431\u044b\u043b\u0456 \u045e\u0447\u044b\u043d\u043a\u0456 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430\u0434\u043d\u0430\u043a, \u0411\u043e\u0436\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0430 \u0456\u0445. \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0441. \u041d\u0456 \u0437\u043e\u043b\u0430\u0442\u0430\u043c \u0446\u0456 \u0441\u0440\u044d\u0431\u0440\u0430\u043c, \u0430\u043b\u0435 \u042f\u0433\u043e \u043f\u0440\u0430\u043b\u0456\u0442\u0430\u0439 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e. \u0401\u043d \u0441\u0442\u0430\u045e \u0411\u0430\u0440\u0430\u043d\u043a\u0430\u043c \u0431\u0435\u0437 \u0437\u0430\u0433\u0430\u043d\u044b, \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0432\u044f\u043b\u0456 \u043d\u0430 \u0437\u0430\u0431\u0456\u0446\u0446\u0451 \u0434\u0437\u0435\u043b\u044f \u0437\u0430\u043f\u043b\u044f\u043c\u043b\u0435\u043d\u044b\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u043c\u0456 \u0430\u0432\u0435\u0447\u0430\u043a (\u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u043f\u043b\u044f\u043c\u043b\u0435\u043d\u044b\u044f, \u0430 \u043d\u0435 \u0446\u0430\u043b\u043a\u0430\u043c \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u044b\u044f). \u0412\u043e\u0441\u044c \u044f\u043a\u0443\u044e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043b\u0430\u0441\u043a\u0443. \u0411\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0436\u044b\u0446\u044c \u0433\u043e\u0434\u043d\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u043e\u0446\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0433\u0443\u0431\u0456\u0446\u044c \u0442\u0430\u043a\u043e\u0433\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0434\u0430\u0440\u0443. \u0412\u044f\u043b\u0456\u043a\u0456 \u041b\u0435\u043a\u0430\u0440 \u043f\u0440\u044b\u0431\u044b\u045e \u0434\u0430 \u043d\u0430\u0441 \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0443\u0441\u0435 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456. \u041a\u0430\u043b\u0456 \u0437\u043d\u043e\u045e \u0445\u043e\u0447\u0430\u043c \u0445\u0432\u0430\u0440\u044d\u0446\u044c, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0430\u0431\u0435 \u0437\u0440\u043e\u0431\u0456\u043c \u0448\u043a\u043e\u0434\u0443, \u0430\u043b\u0435 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0441\u0442\u0430\u043d\u0435\u043c \u043d\u044f\u045e\u0434\u0437\u044f\u0447\u043d\u044b\u043c\u0456 \u045e \u0430\u0434\u043d\u043e\u0441\u0456\u043d\u0430\u0445 \u0434\u0430 \u041b\u0435\u043a\u0430\u0440\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0441\u0446\u0435\u0436\u043a\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0401\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e, \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0448\u043b\u044f\u0445\u0430\u043c \u043f\u0430\u043a\u043e\u0440\u044b, \u044f\u043a\u0456\u043c \u0401\u043d \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043d\u0430\u0441. \u0421\u0432\u0430\u0456\u043c \u0432\u0443\u0447\u044d\u043d\u043d\u0435\u043c \u0401\u043d \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u045e \u0434\u0430\u0440\u043e\u0433\u0443 \u043f\u0430\u043a\u043e\u0440\u044b; \u0446\u0435\u0440\u043f\u044f\u0447\u044b \u0437\u0430 \u043d\u0430\u0441, \u0401\u043d \u043f\u0440\u0430\u0439\u0448\u043e\u045e \u044f\u0435 \u045e\u0441\u044e. \u00ab\u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u043c\u0456 (\u042f\u043d 1, 14), \u043a\u0430\u0431 \u0437\u0430 \u043d\u0430\u0441 \u043c\u043e\u0433 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0430\u043c\u0435\u0440\u0446\u0456. \u041d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b \u0411\u043e\u0433 \u043f\u0440\u044b\u043d\u044f\u045e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0437\u0430 \u043d\u0430\u0441 \u0456 \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u044e \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u043d\u0430\u0448\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c, \u0448\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e \u041f\u0430\u043d, \u0447\u044b\u043c \u0430\u0434\u0430\u0440\u044b\u045e \u043d\u0430\u0441. \u041c\u0430\u0433\u0443\u0442\u043d\u044b \u2013 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435, \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u044b \u2013 \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b, \u0437\u0430\u0431\u0456\u0442\u044b \u2013 \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0456 \u0431\u044b\u045e \u0443\u0437\u0432\u044b\u0448\u0430\u043d\u044b, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u045e \u0430\u0434\u0445\u043b\u0430\u043d\u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0443 \u0441\u0430\u0431\u0435 \u045e\u0437\u0432\u044b\u0441\u0456\u0446\u044c \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u045e\u0436\u043e \u045e\u0437\u0432\u044b\u0441\u0456\u045e \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0456 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u0432\u0435\u0440\u044b, \u044f\u043a\u0430\u044f \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435. \u0412\u043e\u0441\u044c, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0401\u043d \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u043d\u0430\u043c \u0448\u043b\u044f\u0445 \u043f\u0430\u043a\u043e\u0440\u044b. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u044f\u0433\u043e \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430, \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043c \u041f\u0430\u043d\u0430 \u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u0437\u0430\u0441\u043b\u0443\u0436\u0430\u043d\u0430 \u0437\u043c\u043e\u0436\u0430\u043c \u0441\u043f\u044f\u0432\u0430\u0446\u044c: \u00ab\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0426\u044f\u0431\u0435, \u0411\u043e\u0436\u0430, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0456\u043c\u044f \u0422\u0432\u0430\u0451\u00bb (\u043f\u0430\u0440. \u041f\u0441 75 [74], 2).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 86 (85), 12-13\u0430; 118 (117), 28\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0411\u0443\u0434\u0443 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430 \u043c\u043e\u0439, \u0456\u043c\u044f \u0422\u0432\u0430\u0451 \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0432\u0435\u0447\u043d\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e \u0422\u0432\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0422\u044b \u2013 \u043c\u043e\u0439 \u0411\u043e\u0433, \u0431\u0443\u0434\u0443 \u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0426\u044f\u0431\u0435, \u0411\u043e\u0436\u0430 \u043c\u043e\u0439, \u0431\u0443\u0434\u0443 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0446\u044c \u0426\u044f\u0431\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"222","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u00ab\u041f\u0440\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430\u00bb&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib: 3, 3)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u042f \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u045e \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043b\u0443\u0445\u0430\u0439, \u0441\u044b\u043d\u0435, \u041c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b, \u0441\u043b\u043e\u0432\u044b \u043d\u0430\u0439\u0441\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u044b\u044f, \u0431\u043e\u043b\u044c\u0448\u044b\u044f \u0437\u0430 \u045e\u0441\u044e \u045e\u043c\u0435\u043b\u0430\u0441\u0446\u044c \u0444\u0456\u043b\u043e\u0441\u0430\u0444\u0430\u045e \u0456 \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u00ab\u0421\u043b\u043e\u0432\u044b \u041c\u0430\u0435 \u2013 \u0433\u044d\u0442\u0430 \u0434\u0443\u0445 \u0456 \u0436\u044b\u0446\u0446\u0451\u00bb (\u043f\u0430\u0440. \u042f\u043d 6, 63), \u0456 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0456\u0445 \u043c\u0435\u0440\u044b\u0446\u044c \u0440\u043e\u0437\u0443\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0456\u043c\u0456 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u0434\u0437\u0435\u043b\u044f \u043c\u0430\u0440\u043d\u0430\u0433\u0430 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f, \u0430\u043b\u0435 \u045e \u0446\u0456\u0448\u044b \u045e\u0441\u043b\u0443\u0445\u043e\u045e\u0432\u0430\u0446\u0446\u0430 \u0456 \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u0456\u0445 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0434\u044b \u043b\u044e\u0431\u043e\u045e\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u045e \u044f: \u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u043e\u0433\u0430 \u0422\u044b, \u041f\u0430\u043d\u0435, \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0435\u0448 \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u0435\u0448 \u0422\u0432\u0430\u0456\u043c \u0437\u0430\u043a\u043e\u043d\u0430\u043c, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u044f\u043c\u0443 \u043f\u0430\u043b\u0451\u0433\u043a\u0443 \u045e \u0434\u043d\u0456 \u043b\u0456\u0445\u0456\u044f\u00bb (\u041f\u0441 94 [93], 12\u201313). \u041d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0451\u043d \u0431\u0435\u0437 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f \u043d\u0430 \u0437\u044f\u043c\u043b\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u042f, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0432\u0443\u0447\u044b\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0456 \u0430\u0436 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u044e \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0434\u0430 \u045e\u0441\u0456\u0445, \u0430\u043b\u0435 \u043c\u043d\u043e\u0433\u0430 \u0451\u0441\u0446\u044c \u0433\u043b\u0443\u0445\u0456\u0445 \u0456 \u043d\u044f\u0447\u0443\u043b\u044b\u0445 \u0434\u0430 \u041c\u0430\u0439\u0433\u043e \u0433\u043e\u043b\u0430\u0441\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u043d\u043e\u0433\u0430 \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0456\u0445, \u044f\u043a\u0456\u044f \u0430\u0445\u0432\u043e\u0442\u043d\u0435\u0439 \u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c \u0441\u0432\u0435\u0442, \u0430 \u043d\u0435 \u0411\u043e\u0433\u0430, \u0456 \u043b\u044f\u0433\u0447\u044d\u0439 \u0456\u0434\u0443\u0446\u044c \u0437\u0430 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430, \u0447\u044b\u043c \u0437\u0430 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u044f\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0432\u0435\u0442 \u0430\u0431\u044f\u0446\u0430\u0435 \u0440\u044d\u0447\u044b \u0434\u0440\u043e\u0431\u043d\u044b\u044f \u0456 \u043c\u0456\u043d\u0430\u044e\u0447\u044b\u044f, \u0430 \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u044f\u043c\u0443 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0430\u0445\u0432\u043e\u0442\u0430\u0439. \u042f \u0430\u0431\u044f\u0446\u0430\u044e \u0440\u044d\u0447\u044b \u0431\u044f\u0437\u043c\u0435\u0440\u043d\u044b\u044f \u0456 \u0432\u0435\u0447\u043d\u044b\u044f, \u0430 \u0441\u044d\u0440\u0446\u044b \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u0445 \u0437\u0430\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u044b\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0442\u043e \u0436 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u041c\u043d\u0435 \u0433\u044d\u0442\u0430\u043a \u0436\u0430 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0432\u0430 \u045e\u0441\u0456\u043c \u0456 \u0433\u044d\u0442\u0430\u043a \u0436\u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430, \u044f\u043a \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0441\u0432\u0435\u0442\u0443 \u0434\u044b \u044f\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043c?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u044b\u043a \u0447\u044b\u0440\u0432\u0430\u043d\u0435\u0439, \u043b\u044f\u043d\u0456\u0432\u044b \u0456 \u0431\u0443\u0440\u043a\u043b\u0456\u0432\u044b, \u0448\u0442\u043e \u0456\u043d\u0448\u044b\u044f \u0431\u043e\u043b\u044c\u0448 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0440\u0430\u0446\u0443\u044e\u0446\u044c \u043d\u0430 \u0441\u0432\u0430\u044e \u0437\u0430\u0433\u0443\u0431\u0443, \u0447\u044b\u043c \u0442\u044b \u043f\u0440\u0430\u0446\u0443\u0435\u0448 \u0434\u043b\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f; \u0448\u0442\u043e \u0456\u043d\u0448\u044b\u044f \u0431\u043e\u043b\u044c\u0448 \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456, \u0447\u044b\u043c \u0442\u044b \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u0442\u0430\u043a \u0447\u0430\u0441\u0442\u0430 \u044f\u043d\u044b \u0430\u0448\u0443\u043a\u0432\u0430\u044e\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0456\u0445 \u043d\u0430\u0434\u0437\u0435\u044f\u0445. \u041c\u0430\u0451 \u0436 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u0430\u0448\u0443\u043a\u0432\u0430\u0435, \u0456 \u043d\u0435 \u0430\u0434\u043e\u0439\u0434\u0437\u0435 \u0437 \u043f\u0443\u0441\u0442\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c \u041c\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0442\u043e \u0430\u0431\u044f\u0446\u0430\u045e \u2013 \u0442\u043e\u0435 \u0434\u0430\u043c; \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u2013 \u0442\u043e\u0435 \u0441\u043f\u043e\u045e\u043d\u044e, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0435\u0448 \u0432\u0435\u0440\u043d\u0430 \u045e \u041c\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0448\u0447\u043e\u0434\u0440\u0430 \u045e\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0436\u0432\u0430\u044e \u0434\u043e\u0431\u0440\u044b\u0445 \u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u044e \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0430\u043f\u0456\u0448\u044b \u041c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u0456 \u0434\u043e\u0431\u0440\u0430 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439 \u043d\u0430\u0434 \u0456\u043c\u0456, \u0431\u043e \u044f\u043d\u044b \u0432\u0435\u043b\u044c\u043c\u0456 \u0441\u043f\u0430\u0442\u0440\u044d\u0431\u044f\u0446\u0446\u0430 \u0442\u0430\u0431\u0435 \u045e \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u0441\u043f\u0430\u043a\u0443\u0441\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0427\u0430\u0433\u043e \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0448 \u0447\u044b\u0442\u0430\u044e\u0447\u044b, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0448 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0446\u044f\u0431\u0435 \u043d\u0430\u0432\u0435\u0434\u0430\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0432\u0430\u0439\u043d\u044b\u043c \u0441\u043f\u043e\u0441\u0430\u0431\u0430\u043c \u042f \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u044e \u0441\u0432\u0430\u0456\u0445 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445: \u0441\u043f\u0430\u043a\u0443\u0441\u0430\u044e \u0456 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u0434\u0437\u0432\u0435 \u043d\u0430\u0432\u0443\u043a\u0456 \u0434\u0430\u044e \u0456\u043c \u0448\u0442\u043e\u0434\u0437\u0435\u043d\u044c: \u0430\u0434\u043d\u0443 \u2013 \u0433\u0430\u043d\u044f\u0447\u044b \u0456\u0445\u043d\u0456\u044f \u043f\u0440\u0430\u0441\u0442\u0443\u043f\u043a\u0456, \u0434\u0440\u0443\u0433\u0443\u044e \u2013 \u043a\u043b\u0456\u0447\u0443\u0447\u044b \u0456\u0445 \u0434\u0430 \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448\u044b\u0445 \u0446\u043d\u043e\u0442\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0442\u043e \u043c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u041c\u0430\u0435 \u0434\u044b \u0456\u0445 \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0435, \u0442\u043e\u0439 \u043c\u0430\u0435 \u0441\u0443\u0434\u0434\u0437\u044e \u2013 \u0441\u043b\u043e\u0432\u0430, \u0448\u0442\u043e \u045e \u0430\u043f\u043e\u0448\u043d\u0456 \u0434\u0437\u0435\u043d\u044c \u0430\u0441\u0443\u0434\u0437\u0456\u0446\u044c \u044f\u0433\u043e (\u043f\u0430\u0440. \u042f\u043d 12, 48).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 23, 26; 1, 9; 5, 1\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u044b\u043d\u0435, \u0434\u0430\u0439 \u043c\u043d\u0435 \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0442\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0442\u0440\u044b\u043c\u0430\u044e\u0446\u0446\u0430 \u043c\u0430\u0456\u0445 \u0434\u0430\u0440\u043e\u0433,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0431\u043e \u044f\u043d\u044b \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u2013 \u043d\u0456\u0431\u044b \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u044f \u043a\u0430\u0440\u043e\u043d\u0430 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0417\u0432\u044f\u0440\u043d\u0456\u0441\u044f \u0434\u0430 \u043c\u0430\u0451\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u043c\u043e\u0439 \u0441\u044b\u043d\u0435, \u0441\u0445\u0456\u043b\u0456 \u0441\u0432\u0430\u0451 \u0432\u0443\u0445\u0430 \u0434\u0430 \u043c\u0430\u0456\u0445 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f\u045e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u044f\u043d\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"223","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u00ab\u041f\u0440\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430\u00bb&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib: 3, 14)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430\u045e\u0434\u0430 \u041f\u0430\u043d\u0430 \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0430\u0433\u0440\u044b\u043c\u0435\u043b\u0456 \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e \u0441\u0443\u0434\u044b \u0422\u0432\u0430\u0435, \u043e \u041f\u0430\u043d\u0435, \u0437\u0430\u0434\u0440\u044b\u0436\u044d\u043b\u0456 \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443 \u0434\u044b \u0441\u043f\u0430\u043b\u043e\u0445\u0443 \u045e\u0441\u0435 \u043a\u043e\u0441\u0442\u043a\u0456 \u043c\u0430\u0435, \u0430\u0436 \u043c\u043e\u0446\u043d\u0430 \u0441\u0430\u043c\u043b\u0435\u043b\u0430 \u043c\u0430\u044f \u0434\u0443\u0448\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0442\u0430\u044e \u0430\u0441\u043b\u0443\u043f\u044f\u043d\u0435\u043b\u044b \u0456 \u0431\u0430\u0447\u0443, \u0448\u0442\u043e \u043d\u0435\u0431\u0430 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u0422\u0432\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c (\u043f\u0430\u0440. \u0401\u045e 15, 15).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0443 \u0430\u043d\u0451\u043b\u0430\u045e \u0422\u044b \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 (\u043f\u0430\u0440. \u0401\u045e 4, 18) \u0434\u044b \u043d\u0435 \u0434\u0430\u0440\u0430\u0432\u0430\u045e \u0456\u043c, \u0448\u0442\u043e \u0436 \u0431\u0443\u0434\u0437\u0435 \u0441\u0430 \u043c\u043d\u043e\u044e?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0437\u043e\u0440\u043a\u0456 \u043f\u0430\u0437\u043b\u044f\u0442\u0430\u043b\u0456 \u0437 \u043d\u0435\u0431\u0430 (\u043f\u0430\u0440. \u0410\u043f 8, 10), \u0442\u043e \u044f, \u043f\u044b\u043b \u0437\u044f\u043c\u043d\u044b, \u043d\u0430 \u0448\u0442\u043e \u0431\u0443\u0434\u0443 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b\u044f, \u0447\u044b\u0435 \u0441\u043f\u0440\u0430\u0432\u044b \u0437\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0434\u043e\u0431\u0440\u044b\u043c\u0456, \u0443\u043f\u0430\u043b\u0456 \u043d\u0430\u0439\u043d\u0456\u0436\u044d\u0439, \u0430 \u0442\u044b\u044f, \u0448\u0442\u043e \u0435\u043b\u0456 \u0445\u043b\u0435\u0431 \u0430\u043d\u0451\u043b\u0430\u045e, \u2013 \u043f\u0440\u0430\u0433\u0430\u0432\u0456\u0442\u0430 \u043f\u0430\u0441\u043b\u044f \u0433\u043d\u0430\u043b\u0456\u0441\u044f \u0437\u0430 \u0441\u0442\u0440\u0430\u0432\u0430\u044e \u0436\u044b\u0432\u0451\u043b\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u044b\u043a \u043d\u044f\u043c\u0430 \u043d\u0456\u044f\u043a\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 \u0422\u044b, \u043e \u041f\u0430\u043d\u0435, \u043f\u0440\u044b\u043c\u0435\u0448 \u0441\u0432\u0430\u044e \u0440\u0443\u043a\u0443. \u041d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0434\u0430\u0441\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u0422\u044b \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0435\u0448 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0451\u044e. \u041d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u044f \u0441\u0456\u043b\u0430, \u043a\u0430\u043b\u0456 \u0422\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u044f\u0435 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043d\u0430\u0441 \u0441\u0430\u043c\u044b\u0445 \u043f\u0430\u043a\u0456\u0434\u0430\u0435\u0448, \u043c\u044b \u045e\u043f\u0430\u0434\u0430\u0435\u043c \u0456 \u0433\u0456\u043d\u0435\u043c, \u043a\u0430\u043b\u0456 \u0433\u043b\u044f\u043d\u0435\u0448 \u043d\u0430 \u043d\u0430\u0441 \u2013 \u043c\u044b \u043f\u0430\u045e\u0441\u0442\u0430\u0451\u043c \u0456 \u0436\u044b\u0432\u0451\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u044f\u0434\u0443\u0436\u044b\u044f \u043c\u044b, \u0430\u043b\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u043c\u0441\u044f \u043c\u043e\u0446\u043d\u044b\u043c\u0456, \u0441\u0442\u044b\u043d\u0435\u043c, \u0430\u043b\u0435 \u0422\u044b \u043d\u0430\u0441 \u0433\u0440\u044d\u0435\u0448.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u044e \u043c\u0430\u0440\u043d\u0443\u044e \u0445\u0432\u0430\u043b\u044c\u0431\u0443 \u043c\u0430\u044e \u043f\u0440\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u0433\u043b\u044b\u0431\u0456\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u0441\u0443\u0434\u0430 \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0427\u044b\u043c \u0436\u0430 \u0451\u0441\u0446\u044c \u0443\u0441\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0422\u0432\u0430\u0456\u043c? \u0426\u0456 \u0436 \u0433\u043b\u0456\u043d\u0430 \u043f\u0430\u0447\u043d\u0435 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c, \u0445\u0442\u043e \u044f\u0435 \u043b\u0435\u043f\u0456\u0446\u044c? (\u043f\u0430\u0440. \u0406\u0441 29, 16).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a \u043c\u043e\u0436\u0430 \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0442\u043e\u0439, \u0447\u044b\u0451 \u0441\u044d\u0440\u0446\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430 \u0411\u043e\u0433\u0443?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u043d\u0435 \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u043f\u044b\u0448\u043d\u044b\u043c \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043b\u0430 \u0441\u0430\u0431\u0435 \u043f\u0440\u0430\u045e\u0434\u0430, \u0456 \u043d\u0435 \u045e\u0437\u0440\u0443\u0448\u044b\u0446\u0446\u0430 \u043f\u0430\u0445\u0432\u0430\u043b\u043e\u044e \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u045e\u0441\u044e \u043d\u0430\u0434\u0437\u0435\u044e \u045e\u0441\u043a\u043b\u0430\u0434\u0430\u0435 \u043d\u0430 \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u044c, \u2013 \u0443\u0441\u0435 \u044f\u043d\u044b \u043d\u0456\u0448\u0442\u043e; \u044f\u043d\u044b \u0437\u043d\u0456\u043a\u043d\u0443\u0446\u044c, \u044f\u043a \u0433\u0443\u043a \u0456\u0445\u043d\u044f\u0433\u0430 \u0441\u043b\u043e\u0432\u0430: \u00ab\u0410 \u043f\u0440\u0430\u045e\u0434\u0430 \u0411\u043e\u0433\u0430 \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456\u00bb (\u043f\u0430\u0440. \u041f\u0441 117 [116], 2).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 119 (118), 114-115. 113\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u044b \u043c\u0430\u044f \u0430\u0431\u0430\u0440\u043e\u043d\u0430 \u0456 \u043c\u043e\u0439 \u0448\u0447\u044b\u0442, \u044f \u0434\u0430\u0432\u044f\u0440\u0430\u044e \u0422\u0432\u0430\u0456\u043c \u0441\u043b\u043e\u0432\u0430\u043c. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0410\u0434\u044b\u0434\u0437\u0456\u0446\u0435 \u0430\u0434 \u043c\u044f\u043d\u0435, \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u044b, \u044f \u0431\u0443\u0434\u0443 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u043c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0435\u043d\u0430\u0432\u0456\u0434\u0436\u0443 \u0434\u0432\u0443\u0434\u0443\u0448\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430\u043b\u0435 \u043b\u044e\u0431\u043b\u044e \u0422\u0432\u043e\u0439 \u0437\u0430\u043a\u043e\u043d.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u0434\u044b\u0434\u0437\u0456\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"224","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432. \u042f\u043d\u0430\u00bb \u0410\u0440\u044b\u0433\u0435\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tomus 10, 20: PG 14, 370-371)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u00ab\u0417\u0440\u0443\u0439\u043d\u0443\u0439\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0433\u044d\u0442\u0443\u044e, \u0456 \u042f \u0437\u0430 \u0442\u0440\u044b \u0434\u043d\u0456 \u045e\u0437\u0432\u044f\u0434\u0443 \u044f\u0435\u00bb (\u042f\u043d 2, 19). \u0413\u0430\u0431\u0440\u044d\u0456, \u044f\u043a \u043c\u043d\u0435 \u043f\u0430\u0434\u0430\u0435\u0446\u0446\u0430, \u0443\u044f\u045e\u043b\u044f\u044e\u0446\u044c \u0442\u0443\u0442 \u043b\u044e\u0434\u0437\u0435\u0439 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u0445 \u0456 \u043f\u0430\u0447\u0443\u0446\u0446\u0451\u0432\u044b\u0445. \u042f\u043d\u044b \u0432\u0435\u043b\u044c\u043c\u0456 \u0430\u0431\u0443\u0440\u0430\u043d\u044b\u044f, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0432\u044b\u0433\u043d\u0430\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u0434\u043e\u043c \u0410\u0439\u0446\u0430 \u0434\u043e\u043c\u0430\u043c \u0433\u0430\u043d\u0434\u043b\u044e \u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0437\u043d\u0430\u043a\u0443. \u0410\u043b\u0435 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0437\u043d\u0430\u043a \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u0448\u0442\u043e \u0421\u044b\u043d \u0411\u043e\u0436\u044b, \u044f\u043a\u043e\u0433\u0430 \u044f\u043d\u044b \u043d\u0435 \u0445\u0430\u0446\u0435\u043b\u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u044c, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430. \u0423 \u0430\u0434\u043d\u044b\u043c \u0456 \u0442\u044b\u043c \u0436\u0430 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0456 \u0417\u0431\u0430\u045e\u0446\u0430 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u044e. \u0422\u044b\u043c, \u0445\u0442\u043e \u043f\u044b\u0442\u0430\u045e\u0441\u044f: \u00ab\u042f\u043a\u0456\u043c \u0437\u043d\u0430\u043a\u0430\u043c \u043f\u0430\u043a\u0430\u0436\u0430\u0448 \u043d\u0430\u043c, \u0448\u0442\u043e \u0442\u0430\u043a \u043c\u043e\u0436\u0430\u0448 \u0440\u0430\u0431\u0456\u0446\u044c?\u00bb, \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435: \u00ab\u0417\u0440\u0443\u0439\u043d\u0443\u0439\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0433\u044d\u0442\u0443\u044e, \u0456 \u042f \u0437\u0430 \u0442\u0440\u044b \u0434\u043d\u0456 \u045e\u0437\u0432\u044f\u0434\u0443 \u044f\u0435\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041b\u0456\u0447\u0443, \u0448\u0442\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0430\u0434\u043d\u0430\u0433\u043e \u0437 \u043c\u0430\u0433\u0447\u044b\u043c\u044b\u0445 \u0442\u043b\u0443\u043c\u0430\u0447\u044d\u043d\u043d\u044f\u045e, \u044f\u043a \u0441\u0432\u044f\u0442\u044b\u043d\u044f, \u0442\u0430\u043a \u0456 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0411\u043e \u041a\u0430\u0441\u0446\u0451\u043b \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u0437 \u0436\u044b\u0432\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e (\u043f\u0430\u0440. 1 \u041f 2, 5), \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u044b \u00ab\u0436\u044b\u0432\u043e\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439\u00bb, \u043a\u0430\u0431 \u0443\u0442\u0432\u0430\u0440\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u043e\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430. \u0401\u043d \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u00ab\u043d\u0430 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0434\u0437\u0435 \u0441\u0430\u043c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u0443\u0433\u043b\u0430\u0432\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u0435\u043c\u00bb (\u042d\u0444 2, 20), \u0430 \u0442\u0430\u043c\u0443 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f: \u00ab\u0432\u044b \u2013 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0435, \u0430 \u043f\u0430\u0430\u0441\u043e\u0431\u043a\u0443 \u2013 \u0447\u043b\u0435\u043d\u044b\u00bb (1 \u041a\u0430\u0440 12, 27), \u0442\u0430\u043c\u0443 \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0437\u043b\u0443\u0447\u0430\u043d\u044b\u044f \u0440\u0430\u0437\u0430\u043c \u043a\u0430\u043c\u044f\u043d\u0456 \u0456 \u0456\u0445 \u0433\u0430\u0440\u043c\u043e\u043d\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043d\u044b\u044f \u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b\u044f, \u2013 \u044f\u043a \u0431\u044b\u043b\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u043f\u0435\u0440\u0448\u044b\u043c, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u0448\u0442\u043e \u045e\u0441\u0435 \u043a\u043e\u0441\u0442\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0431\u0443\u0434\u0443\u0446\u044c \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b\u044f \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443 \u0456 \u045e\u0446\u0456\u0441\u043a\u0443 \u0437 \u0431\u043e\u043a\u0443 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u2013 \u0430\u0434\u043d\u0430\u043a, \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u045e\u0437\u043d\u0456\u043c\u0435\u0446\u0446\u0430, \u0456 \u0446\u0435\u043b\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0435 \u043d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043f\u0430\u0441\u043b\u044f \u0434\u0437\u0451\u043d \u0443\u0446\u0456\u0441\u043a\u0443, \u044f\u043a\u0456 \u043d\u0430\u0441\u0442\u0430\u043d\u0435, \u0456 \u043f\u0430\u0441\u043b\u044f \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0433\u0430 \u0434\u043d\u044f, \u044f\u043a\u0456\u043c \u0431\u0443\u0434\u0437\u0435 \u0434\u0437\u0435\u043d\u044c \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041d\u0430\u0441\u0442\u0430\u043d\u0435 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c \u043d\u0430 \u043d\u043e\u0432\u044b\u043c \u043d\u0435\u0431\u0435 \u0456 \u043d\u0430 \u043d\u043e\u0432\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u043b\u0456 \u043a\u043e\u0441\u0442\u043a\u0456, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0443\u0432\u0435\u0441\u044c \u0434\u043e\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0448\u044b \u0441\u043c\u0435\u0440\u0446\u044c, \u0443\u0437\u043d\u0456\u043c\u0435\u0446\u0446\u0430 \u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430. \u0422\u0430\u043c\u0443 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0430\u0441\u043b\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u0437\u043c\u044f\u0448\u0447\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u045e\u0441\u044f\u0433\u043e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0446\u0435\u043b\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0411\u043e \u044f\u043a \u0431\u0430\u0447\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0431\u044b\u043b\u043e \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430, \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u0430, \u0430 \u043f\u0430\u0441\u043b\u044f \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0430, \u0442\u0430\u043a \u0456 \u045e\u0441\u0451 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u0445 \u0441\u0432\u044f\u0442\u044b\u0445 \u0431\u044b\u043b\u043e \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0456 \u045e\u0436\u043e \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0436\u044b\u0432\u0435. \u0422\u0430\u043c\u0443 \u043a\u043e\u0436\u043d\u044b \u0437 \u042f\u0433\u043e \u0447\u043b\u0435\u043d\u0430\u045e, \u043f\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0437\u0435 \u0441\u0432. \u041f\u0430\u045e\u043b\u0430, \u043d\u0456\u0447\u044b\u043c \u043d\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u043a\u0440\u044b\u0436\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0441\u0432\u0435\u0442 \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0434\u043b\u044f \u044f\u0433\u043e, \u0430 \u0451\u043d \u2013 \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443 (\u043f\u0430\u0440. \u0413\u0430\u043b 6, 14).<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0401\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c: \u00ab\u043c\u044b \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c\u00bb (\u0420\u044b\u043c 6, 4), \u2013 \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0456 \u0434\u0430\u0434\u0430\u0435, \u0431\u044b\u0446\u0446\u0430 \u045e\u0436\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0433\u0430\u0440\u0430\u043d\u0442\u044b\u044e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f: \u00ab\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043c\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0435\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c\u00bb (\u043f\u0430\u0440. \u0420\u044b\u043c 6, 4).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. 1 \u041a\u0430\u0440 6, 19-20; \u041b\u0435\u0432 11, 43\u0430. 44b<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0426\u0435\u043b\u044b \u0432\u0430\u0448\u044b\u044f \u2013 \u0433\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e \u0432\u0430\u0441, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u043c\u0430\u0435\u0446\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0456 \u0448\u0442\u043e \u0432\u044b \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u0435 \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435! <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0411\u043e\u0433\u0430 \u045e \u0446\u0435\u043b\u0435 \u0432\u0430\u0448\u044b\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0435 \u0433\u0440\u0430\u0448\u044b\u0446\u0435, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0431\u043e \u042f \u0441\u0432\u044f\u0442\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"225","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456\u00bb \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 95, 1-2: PL 54, 461-462)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423\u043a\u043b\u0430\u0434\u0443 \u0437\u0430\u043a\u043e\u043d \u041c\u043e\u0439 \u0443 \u043d\u0443\u0442\u0440\u043e \u0456\u0445\u043d\u044f\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f! \u041a\u0430\u043b\u0456 \u043d\u0430\u0448 \u041f\u0430\u043d, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0456 \u043b\u044f\u0447\u044b\u045e \u0440\u043e\u0437\u043d\u044b\u044f \u0445\u0432\u0430\u0440\u043e\u0431\u044b \u043f\u0430 \u045e\u0441\u0451\u0439 \u0413\u0430\u043b\u0456\u043b\u0435\u0456, \u0441\u043b\u0430\u0432\u0430 \u043f\u0440\u0430 \u042f\u0433\u043e \u0446\u0443\u0434\u044b \u0440\u0430\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u043f\u0430 \u045e\u0441\u0451\u0439 \u0421\u0456\u0440\u044b\u0456. \u0428\u043c\u0430\u0442 \u043b\u044e\u0434\u0437\u0435\u0439 \u0437 \u0443\u0441\u0456\u0445 \u043a\u0443\u0442\u043a\u043e\u045e \u042e\u0434\u044d\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0433\u0430\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0434\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u041b\u0435\u043a\u0430\u0440\u0430. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043b\u044e\u0434\u0441\u043a\u043e\u0435 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0437 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c, \u0456 \u0437 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u0437 \u0431\u0430\u0447\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u0456 \u0446\u0443\u0434\u044b \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u0430\u0431 \u044f\u043d\u044b \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u043b\u0456\u0441\u044f \u045e \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0432\u0443\u0446\u044b \u0456, \u0430\u0434\u0447\u0443\u0432\u0430\u044e\u0447\u044b \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u043d\u0443\u044e \u043c\u043e\u0446 \u0411\u043e\u0433\u0430, \u043d\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u045e \u0437\u0431\u0430\u045e\u0447\u0430\u0439 \u043c\u043e\u0446\u044b \u042f\u0433\u043e \u0432\u0443\u0447\u044d\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u0431 \u0437\u043d\u0435\u0448\u043d\u044f\u0435 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u0446\u044c \u0443 \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u043b\u0435\u043a \u0456 \u0432\u044b\u043b\u0435\u0447\u044b\u0446\u044c \u0434\u0443\u0448\u0443 \u043f\u0430\u0441\u043b\u044f \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0446\u0435\u043b\u0430, \u041f\u0430\u043d \u0430\u0434\u0434\u0430\u043b\u0456\u045e\u0441\u044f \u0430\u0434 \u043d\u0430\u0442\u043e\u045e\u043f\u0443, \u044f\u043a\u0456 \u042f\u0433\u043e \u0430\u043a\u0440\u0443\u0436\u0430\u045e, \u0456 \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u045e\u0441\u044f \u043d\u0430 \u0431\u043b\u0456\u0436\u044d\u0439\u0448\u0443\u044e \u0433\u0430\u0440\u0443. \u0417\u0430\u0431\u0440\u0430\u045e \u0437 \u0441\u0430\u0431\u043e\u044e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043a\u0430\u0431 \u0437 \u0432\u044b\u0448\u044b\u043d\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u0456\u0441\u0442\u044b\u0447\u043d\u0430\u0433\u0430 \u043f\u0430\u0441\u0430\u0434\u0443 \u0434\u0430\u0446\u044c \u0456\u043c \u0443\u0437\u043d\u0451\u0441\u043b\u0443\u044e \u043d\u0430\u0432\u0443\u043a\u0443. \u0413\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u0430\u043c \u0456 \u0441\u0432\u0430\u0456\u043c \u0443\u0447\u044b\u043d\u043a\u0430\u043c \u0401\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0443 \u0441\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0434\u0430 \u041c\u0430\u0439\u0441\u0435\u044f. \u0422\u0430\u0434\u044b \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0430\u0431\u0443\u0434\u0436\u0430\u043b\u0430 \u0442\u0440\u044b\u0432\u043e\u0433\u0443, \u0430\u043b\u0435 \u0446\u044f\u043f\u0435\u0440 \u0430\u0431\u2019\u044f\u0432\u0456\u045e \u0441\u0432\u0430\u044e \u0411\u043e\u0441\u043a\u0443\u044e \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435, \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u0430\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u0415\u0440\u0430\u043c\u0456\u0435\u043c: \u00ab\u0412\u043e\u0441\u044c \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u043d\u0456, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u043a\u0430\u043b\u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0437 \u0434\u043e\u043c\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0437 \u0434\u043e\u043c\u0430\u043c \u042e\u0434\u044b \u043d\u043e\u0432\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 (...) \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u044b\u0445 \u0434\u0437\u0451\u043d, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0443\u043a\u043b\u0430\u0434\u0443 \u0437\u0430\u043a\u043e\u043d \u041c\u043e\u0439 \u0443 \u043d\u0443\u0442\u0440\u043e \u0456\u0445\u043d\u044f\u0435 \u0456 \u043d\u0430\u043f\u0456\u0448\u0443 \u044f\u0433\u043e \u043d\u0430 \u0456\u0445\u043d\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445\u00bb (\u0415\u0440 31, 31. 33; \u043f\u0430\u0440. \u0413\u0431\u0440 8, 8).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u043e\u0439, \u0445\u0442\u043e \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c, \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e; \u0443\u043c\u0435\u043b\u0430\u044f \u0440\u0443\u043a\u0430 \u0421\u043b\u043e\u0432\u0430, \u0448\u0442\u043e \u043f\u0456\u0441\u0430\u043b\u0430 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0443\u0447\u043d\u044f\u045e, \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u043b\u0430 \u043d\u0430\u043a\u0430\u0437\u044b \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043a\u043e\u043d\u0443. \u041d\u0435 \u0441\u0442\u0430\u043b\u0430 \u0442\u0430\u043a, \u044f\u043a \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456, \u0441\u044f\u0440\u043e\u0434 \u0433\u0443\u0441\u0442\u044b\u0445 \u0445\u043c\u0430\u0440, \u0441\u044f\u0440\u043e\u0434 \u0433\u0440\u044b\u043c\u043e\u0442\u0430\u045e \u0456 \u0431\u043b\u0456\u0441\u043a\u0430\u0432\u0456\u0446, \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u044f\u043a\u0456\u043c\u0456 \u043d\u0430\u043f\u0430\u043b\u043e\u0445\u0430\u043d\u044b \u043d\u0430\u0442\u043e\u045e\u043f \u0442\u0440\u044b\u043c\u0430\u045e\u0441\u044f \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0433\u0430\u0440\u044b, \u0430\u043b\u0435 \u043f\u0430\u0434\u0447\u0430\u0441 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430\u0439 \u0440\u0430\u0437\u043c\u043e\u0432\u044b, \u044f\u043a\u0443\u044e \u0447\u0443\u043b\u0456 \u045e\u0441\u0435. \u0422\u0430\u043a \u0441\u043b\u043e\u0434\u044b\u0447 \u043b\u0430\u0441\u043a\u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u043b\u0430 \u0441\u0443\u0440\u043e\u0432\u0430\u0441\u0446\u044c \u0437\u0430\u043a\u043e\u043d\u0443, \u0430 \u0434\u0443\u0445 \u0443\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0441\u0442\u0440\u0430\u0445, \u0443\u043b\u0430\u0441\u0446\u0456\u0432\u044b \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a\u0456\u043c \u0436\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u042f\u0433\u043e \u045e\u043b\u0430\u0441\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b: \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f, \u043d\u044f\u0445\u0430\u0439 \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0433\u0430 \u045e\u0437\u044b\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u044f. \u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u2013 \u043a\u0430\u0436\u0430, \u2013 \u0443\u0431\u043e\u0433\u0456\u044f \u0434\u0443\u0445\u0430\u043c, \u0431\u043e \u0456\u0445 \u0451\u0441\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435\u00bb (\u041c\u0446 5, 3). \u041c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0431 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0446\u0446\u0430, \u043f\u0440\u0430 \u044f\u043a\u0456\u0445 \u0443\u0431\u043e\u0433\u0456\u0445 \u043a\u0430\u0436\u0430 \u0415\u0437\u0443\u0441, \u043a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430 \u00ab\u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u045e\u0431\u043e\u0433\u0456\u044f\u00bb. \u0401\u043d \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u0447\u044b\u045e, \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0433\u044d\u0442\u0430\u0435 \u045e\u0431\u043e\u0441\u0442\u0432\u0430. \u041c\u043e\u0436\u0430 \u0437\u0434\u0430\u0432\u0430\u0446\u0446\u0430, \u0448\u0442\u043e \u0434\u043b\u044f \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0442\u043e\u0439 \u043d\u044f\u0441\u0442\u0430\u0447\u044b, \u0437 \u044f\u043a\u043e\u0439 \u0441\u0443\u0442\u044b\u043a\u0430\u044e\u0446\u0446\u0430 \u043c\u043d\u043e\u0433\u0456\u044f \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430\u0439 \u0456 \u0446\u044f\u0436\u043a\u043e\u0439 \u0433\u0430\u043b\u0435\u0447\u044b. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430: \u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u045e\u0431\u043e\u0433\u0456\u044f \u0434\u0443\u0445\u0430\u043c\u00bb, \u041f\u0430\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0432\u044b\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u043a\u043e\u0440\u0430\u044e, \u0430 \u043d\u0435 \u043d\u044f\u0441\u0442\u0430\u0447\u0430\u0439 \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 78 (77), 1-2\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041e \u043c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u0441\u043b\u0443\u0445\u0430\u0439 \u0437\u0430\u043a\u043e\u043d \u043c\u043e\u0439, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0441\u0445\u0456\u043b\u0456\u0446\u0435 \u0441\u0432\u0430\u0435 \u0432\u0443\u0448\u044b \u0434\u0430 \u0441\u043b\u043e\u0432\u0430\u045e \u043c\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423 \u043f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u0445 \u044f \u0430\u0434\u043a\u0440\u044b\u044e \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u0456 \u0440\u0430\u0441\u043a\u0430\u0436\u0443 \u043f\u0440\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0434\u0430\u045e\u043d\u044f\u0433\u0430 \u0432\u0435\u043a\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0421\u0445\u0456\u043b\u0456\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"226","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456\u00bb \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 95, 2-3: PL 54, 462)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u045e\u0431\u043e\u0433\u0456\u044f \u0434\u0443\u0445\u0430\u043c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043d\u0435\u0448\u043d\u0435, \u0443\u0431\u043e\u0433\u0456\u044f \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u044e\u0446\u044c \u0446\u043d\u043e\u0442\u0443 \u043f\u0430\u043a\u043e\u0440\u044b \u0445\u0443\u0442\u0447\u044d\u0439 \u0437\u0430 \u0431\u0430\u0433\u0430\u0442\u044b\u0445, \u0431\u043e \u043f\u0440\u044b\u044f\u0446\u0435\u043b\u0435\u043c \u0443\u0431\u043e\u0433\u0456\u0445 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0430 \u0431\u0430\u0433\u0430\u0442\u044b\u043c \u0437\u0430\u0437\u0432\u044b\u0447\u0430\u0439 \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u0435 \u043f\u044b\u0445\u0430. \u0410\u0434\u043d\u0430\u043a \u0456 \u043c\u043d\u043e\u0433\u0456\u044f \u0431\u0430\u0433\u0430\u0442\u044b\u044f \u045e\u043c\u0435\u044e\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u043f\u044b\u0445\u0456, \u0430\u043b\u0435 \u0434\u043b\u044f \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u0431\u043e \u043b\u0456\u0447\u0430\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u044e \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u043e\u0436\u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u043c\u0443, \u043a\u0430\u0431 \u0437\u043c\u0435\u043d\u0448\u044b\u0446\u044c \u044f\u0433\u043e \u0431\u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0443\u044e \u0446\u043d\u043e\u0442\u0443 \u043c\u043e\u0433\u0443\u0446\u044c \u043c\u0435\u0446\u044c \u043b\u044e\u0434\u0437\u0456 \u045e\u0441\u0456\u0445 \u0441\u0442\u0430\u043d\u0430\u045e. \u0423\u0441\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u043c\u0435\u0446\u044c \u0442\u0430\u043a\u0443\u044e \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0443\u044e \u043f\u0430\u0442\u0440\u044d\u0431\u0443, \u043d\u0430\u0432\u0430\u0442 \u043d\u0435 \u043c\u0430\u044e\u0447\u044b \u0442\u044b\u0445 \u0441\u0430\u043c\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e. \u041d\u044f\u0440\u043e\u045e\u043d\u0430\u0441\u0446\u044c \u0443 \u0432\u0430\u043b\u043e\u0434\u0430\u043d\u043d\u0456 \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u044b\u043c\u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456 \u043d\u0435 \u043c\u0430\u0435 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u044f \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0440\u043e\u045e\u043d\u044b \u045e \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u0445 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u0445. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0435 \u045e\u0431\u043e\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u043d\u0435 \u043f\u0440\u044b\u0432\u044f\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0447\u0430\u0441\u043e\u0432\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u043d\u0435 \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0446\u044c \u0437\u044f\u043c\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b, \u0430\u043b\u0435 \u0445\u043e\u0447\u0430 \u0431\u0430\u0433\u0430\u0446\u0435\u0446\u044c \u043d\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b, \u043f\u0435\u0440\u0448\u044b\u043c\u0456 \u043f\u0430\u0441\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430, \u0434\u0430\u043b\u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u0433\u0430 \u045e\u0431\u043e\u0441\u0442\u0432\u0430. \u041f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u045e\u0441\u0451 \u0431\u0435\u0437 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u044f. \u041d\u0430 \u0433\u043e\u043b\u0430\u0441 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u044f \u0440\u044b\u0431\u0430\u043a\u0456 \u0442\u0443\u0442 \u0436\u0430 \u0441\u0442\u0430\u043b\u0456 \u0440\u044b\u0431\u0430\u043a\u0430\u043c\u0456 \u043b\u044e\u0434\u0437\u0435\u0439 (\u043f\u0430\u0440. \u041c\u0446 4, 19); \u043c\u043d\u043e\u0433\u0456\u0445 \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u0434\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u0440\u044b, \u0431\u043e \u045e \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e\u0441\u0435 \u00ab\u0431\u044b\u043b\u0456 \u0430\u0434\u0437\u0456\u043d\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0434\u0443\u0448\u043e\u044e\u00bb (\u0414\u0437 4, 32). \u042f\u043d\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u045e\u0441\u044e \u0441\u0432\u0430\u044e \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u044c \u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u0456 \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0439\u043c\u0443 \u0441\u0432\u044f\u0442\u043e\u043c\u0443 \u045e\u0431\u043e\u0441\u0442\u0432\u0443 \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0431\u0430\u0433\u0430\u0442\u044b\u043c\u0456 \u043d\u0430 \u0432\u0435\u0447\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b. \u042f\u043a \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0435 \u043f\u0430\u0434\u0430\u043d\u043d\u0435, \u044f\u043d\u044b \u043c\u043e\u0446\u043d\u0430 \u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u0430\u043b\u0435 \u045e\u0441\u0451 \u043c\u0430\u044e\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0433\u044d\u0442\u0430\u043c\u0443 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0451\u0442\u0440, \u043a\u0430\u043b\u0456 \u044f\u0433\u043e \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u045e \u0430\u0431 \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u043b\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0443 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0421\u0440\u044d\u0431\u0440\u0430 \u0456 \u0437\u043e\u043b\u0430\u0442\u0430 \u043d\u0435 \u043c\u0430\u044e, \u0430\u043b\u0435 \u0448\u0442\u043e \u043c\u0430\u044e, \u0442\u043e\u0435 \u0434\u0430\u044e \u0442\u0430\u0431\u0435: \u0443 \u0456\u043c\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437 \u041d\u0430\u0437\u0430\u0440\u044d\u0442\u0430, \u0443\u0441\u0442\u0430\u043d\u044c \u0456 \u0445\u0430\u0434\u0437\u0456\u00bb (\u0414\u0437 3, 6).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u043d\u0451\u0441\u043b\u0430\u0435 \u0437\u0430 \u0442\u0430\u043a\u0443\u044e \u043f\u0430\u043a\u043e\u0440\u0443? \u0428\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u0431\u0430\u0433\u0430\u0442\u0430\u0435 \u0437\u0430 \u0442\u0430\u043a\u043e\u0435 \u045e\u0431\u043e\u0441\u0442\u0432\u0430? \u041d\u0435 \u043c\u0430\u0435 \u0433\u0440\u043e\u0448\u0430\u0439, \u0430\u043b\u0435 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0434\u0430\u0440\u0430\u043c\u0456 \u043d\u0430\u0442\u0443\u0440\u044b. \u041f\u0451\u0442\u0440 \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0430\u0437\u0434\u0430\u0440\u0430\u0432\u0456\u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u044b\u043c; \u043d\u0435 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0432\u044b\u044f\u0432\u044b \u0426\u044d\u0437\u0430\u0440\u0430 \u043d\u0430 \u043c\u0430\u043d\u0435\u0446\u0435, \u0430\u043b\u0435 \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u0443 \u0445\u0432\u043e\u0440\u044b\u043c \u0432\u043e\u0431\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417 \u0431\u0430\u0433\u0430\u0446\u0446\u044f\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u043a\u0430\u0440\u0431\u0443 \u0441\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u045e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0445\u0430\u0434\u0437\u0456\u0446\u044c, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0433\u044d\u0442\u044b\u044f \u043f\u044f\u0446\u044c \u0442\u044b\u0441\u044f\u0447\u0430\u045e \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u0446\u0443\u0434 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430. \u0413\u044d\u0442\u044b \u045e\u0431\u043e\u0433\u0456, \u044f\u043a\u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043c\u0435\u045e, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0440\u043e\u0441\u0456\u0446\u044c, \u043f\u0430\u0434\u0430\u0440\u0430\u0432\u0430\u045e \u0442\u0430\u043a\u043e\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u0448\u0442\u043e \u0432\u044b\u043b\u0435\u0447\u044b\u045e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u043e\u0433\u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u0430\u0433\u0430, \u0430\u043b\u0435 \u0430\u0437\u0434\u0430\u0440\u0430\u0432\u0456\u045e \u0441\u044d\u0440\u0446\u044b \u043c\u043d\u043e\u0433\u0456\u0445 \u0442\u044b\u0441\u044f\u0447 \u043b\u044e\u0434\u0437\u0435\u0439. \u0422\u044b\u0445, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u044b\u044f, \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c\u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0446 5, 1b-3; \u0406\u0441 66, 2b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u043b\u0456 \u043f\u0430\u0434\u044b\u0448\u043b\u0456 \u0434\u0430 \u0415\u0437\u0443\u0441\u0430 \u0432\u0443\u0447\u043d\u0456 \u042f\u0433\u043e\u043d\u044b\u044f, \u0401\u043d, \u0430\u0434\u043a\u0440\u044b\u045e\u0448\u044b \u0432\u0443\u0441\u043d\u044b \u0441\u0432\u0430\u0435, \u0432\u0443\u0447\u044b\u045e \u0456\u0445, \u043a\u0430\u0436\u0443\u0447\u044b: <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u045e\u0431\u043e\u0433\u0456\u044f \u0434\u0443\u0445\u0430\u043c, \u0431\u043e \u0456\u0445 \u0451\u0441\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u0433\u043b\u044f\u0434\u0436\u0443 \u043d\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u0456 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b \u0434\u0443\u0445\u0430\u043c \u0456 \u0445\u0442\u043e \u0442\u0440\u0430\u043f\u0435\u0447\u0430 \u043f\u0435\u0440\u0430\u0434 \u041c\u0430\u0456\u043c \u0441\u043b\u043e\u0432\u0430\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"227","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456\u00bb \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 95, 4-6: PL 54, 462-464)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0428\u0447\u0430\u0441\u0446\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041f\u0430\u043a\u0430\u0437\u0430\u045e\u0448\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0443\u0431\u043e\u0441\u0442\u0432\u0430, \u041f\u0430\u043d \u0434\u0430\u0434\u0430\u045e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b: \u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u044f, \u0431\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0443\u0446\u0435\u0448\u0430\u043d\u044b\u00bb (\u041c\u0446 5, 4). \u0413\u044d\u0442\u044b \u0441\u043c\u0443\u0442\u0430\u043a, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u044f\u043a\u043e\u043c\u0443 \u0430\u0431\u044f\u0446\u0430\u043d\u0430 \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435, \u043d\u0435 \u043c\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0433\u0430 \u0437 \u043f\u0430\u043a\u0443\u0442\u0430\u043c\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u041d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u0437\u0440\u043e\u0431\u044f\u0446\u044c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c\u0456 \u0441\u043b\u0451\u0437\u044b, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0435 \u0437 \u0431\u043e\u043b\u044e \u045e\u0441\u0451 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430. \u0421\u0432\u044f\u0442\u044b \u043f\u043b\u0430\u0447 \u043c\u0430\u0435 \u0456\u043d\u0448\u0443\u044e \u043f\u0440\u044b\u0447\u044b\u043d\u0443; \u0456\u043d\u0448\u0443\u044e \u043f\u0440\u044b\u0447\u044b\u043d\u0443 \u043c\u0430\u044e\u0446\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u0441\u043b\u0451\u0437\u044b. \u0420\u044d\u043b\u0456\u0433\u0456\u0439\u043d\u044b \u0441\u043c\u0443\u0442\u0430\u043a \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0430\u043f\u043b\u0430\u043a\u0432\u0430\u043d\u043d\u0456 \u0447\u0443\u0436\u044b\u0445 \u0430\u0431\u043e \u045e\u043b\u0430\u0441\u043d\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e; \u0451\u043d \u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u044f \u0411\u043e\u0436\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043b\u044e\u0434\u0441\u043a\u043e\u0433\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u0431\u043e\u043b\u044c\u0448 \u0442\u0440\u044d\u0431\u0430 \u0430\u043f\u043b\u0430\u043a\u0432\u0430\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e, \u0430 \u043d\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u044f\u0433\u043e \u0446\u0435\u0440\u043f\u0456\u0446\u044c, \u0431\u043e \u0437\u043b\u043e \u043d\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043d\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435, \u0430 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0432\u044f\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0434\u0430 \u0445\u0432\u0430\u043b\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0417\u0430\u0442\u044b\u043c \u041f\u0430\u043d \u043a\u0430\u0436\u0430: \u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043b\u0430\u0433\u043e\u0434\u043d\u044b\u044f, \u0431\u043e \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0437\u044f\u043c\u043b\u044e\u00bb (\u041c\u0446 5, 5). \u041b\u044e\u0434\u0437\u044f\u043c \u0446\u0456\u0445\u0456\u043c \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u044b\u043c, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0456 \u0441\u0446\u0456\u043f\u043b\u044b\u043c, \u0442\u044b\u043c, \u044f\u043a\u0456\u044f \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0430\u0431\u044f\u0446\u0430\u043d\u0430 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0437\u044f\u043c\u043b\u044f. \u041d\u0435 \u0442\u0440\u044d\u0431\u0430 \u043b\u0456\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0433\u044d\u0442\u0430\u044f \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0447\u044b\u043c\u0441\u044c\u0446\u0456 \u043c\u0430\u043b\u044b\u043c \u0456 \u043d\u044f\u0432\u0430\u0440\u0442\u0430\u0441\u043d\u044b\u043c, \u0447\u044b\u043c\u0441\u044c\u0446\u0456, \u0448\u0442\u043e \u0432\u044b\u043a\u043b\u044e\u0447\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u043d\u0435\u0431\u0435, \u0431\u043e \u043d\u0456\u0445\u0442\u043e \u0456\u043d\u0448\u044b, \u0430\u043b\u0435 \u044f\u043d\u044b \u045e\u0432\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0422\u043e\u0439 \u0437\u044f\u043c\u043b\u0451\u0439, \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0439 \u0434\u043b\u044f \u0446\u0456\u0445\u0456\u0445, \u0437\u044f\u043c\u043b\u0451\u0439, \u044f\u043a\u0443\u044e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043b\u0430\u0433\u043e\u0434\u043d\u044b\u044f, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0446\u0435\u043b\u0430 \u0441\u0432\u044f\u0442\u044b\u0445. \u041f\u0440\u0430\u0437 \u0437\u0430\u0441\u043b\u0443\u0433\u0456 \u043f\u0430\u043a\u043e\u0440\u044b \u044f\u043d\u043e \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u0446\u0430 \u045e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0456 \u0456 \u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u0445\u0432\u0430\u043b\u0443 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456. \u0410\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u0443\u0436\u043e \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0446\u0446\u0430 \u0434\u0443\u0445\u0443, \u0430\u043b\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0439 \u0433\u0430\u0440\u043c\u043e\u043d\u0456\u0456 \u0437 \u0432\u043e\u043b\u044f\u0439 \u0434\u0443\u0448\u044b. \u0422\u0430\u0434\u044b \u0437\u044f\u043c\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0442\u0430\u043d\u0435 \u043d\u0435\u0430\u0434\u2019\u0435\u043c\u043d\u0430\u0439 \u0456 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430\u0439&nbsp; \u0443\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043a \u0446\u0456\u0445\u0456\u044f \u045e \u0432\u0435\u0447\u043d\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0437\u044f\u043c\u043b\u044e, \u0430 \u0456\u0445 \u043f\u0440\u0430\u0432\u044b \u043d\u0456\u0447\u044b\u043c \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0431\u043c\u0435\u0436\u0430\u0432\u0430\u043d\u044b, \u00ab\u043a\u0430\u043b\u0456 \u0442\u043b\u0435\u043d\u043d\u0430\u0435 \u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c, \u0430 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435 \u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c\u00bb (1 \u041a\u0430\u0440 15, 54). \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u043b\u0430, \u0437\u043c\u0435\u043d\u0456\u0446\u0446\u0430 \u0432\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443, \u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0446\u044f\u0436\u0430\u0440\u0430\u043c, \u0441\u0442\u0430\u043d\u0435 \u0433\u043e\u043d\u0430\u0440\u0430\u043c.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0446 5, 4. 6. 5\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u044f, \u0431\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0443\u0446\u0435\u0448\u0430\u043d\u044b. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u044f \u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u0447\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0431\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0441\u044b\u0447\u0430\u043d\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043b\u0430\u0433\u043e\u0434\u043d\u044b\u044f, \u0431\u043e \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0437\u044f\u043c\u043b\u044e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"231","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456\u00bb \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 95, 6-8: PL 54, 464-465)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0430\u0442\u044b\u043c \u041f\u0430\u043d \u043a\u0430\u0436\u0430: \u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u044f \u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u0447\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0431\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0441\u044b\u0447\u0430\u043d\u044b\u00bb (\u041c\u0446 5, 6). \u0413\u044d\u0442\u044b \u0433\u043e\u043b\u0430\u0434 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0437\u044f\u043c\u043d\u043e\u0439 \u0435\u0436\u044b, \u0433\u044d\u0442\u0430\u044f \u043f\u0440\u0430\u0433\u0430 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u043d\u0430\u043f\u043e\u044e, \u0430\u043b\u0435 \u0447\u0430\u043a\u0430\u0435 \u043d\u0430\u0441\u044b\u0447\u044d\u043d\u043d\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0445\u043e\u0447\u0430 \u045e\u043d\u0456\u043a\u043d\u0443\u0446\u044c \u0432\u0430 \u045e\u0441\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0441\u0430\u043c\u0456\u043c \u041f\u0430\u043d\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0448\u0443\u043a\u0430\u0435 \u0442\u0430\u043a\u043e\u0439 \u0435\u0436\u044b, \u043f\u0440\u0430\u0433\u043d\u0435 \u0442\u0430\u043a\u043e\u0433\u0430 \u043d\u0430\u043f\u043e\u044e. \u0406 \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u045e \u0431\u044b, \u043d\u0430\u043f\u044d\u045e\u043d\u0430, \u043a\u0430\u043b\u0456 \u0431 \u0443\u0436\u043e \u0440\u0430\u043d\u0435\u0439 \u043d\u0435 \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u045e \u044f\u0433\u043e \u0441\u043b\u043e\u0434\u044b\u0447\u044b. \u0421\u043b\u0443\u0445\u0430\u044e\u0447\u044b \u0414\u0443\u0445\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e: \u00ab\u041f\u0430\u043a\u0430\u0448\u0442\u0443\u0439\u0446\u0435 \u0456 \u045e\u0431\u0430\u0447\u0446\u0435, \u044f\u043a\u0456 \u0434\u043e\u0431\u0440\u044b \u0451\u0441\u0446\u044c \u041f\u0430\u043d\u00bb (\u041f\u0441 34 [33], 9), \u0451\u043d \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u044f\u043a \u0431\u044b \u0447\u0430\u0441\u0442\u043a\u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u0456 \u0437\u0430\u043f\u0430\u043b\u0430\u045e \u0442\u0430\u043a\u043e\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u043d\u0430\u0439\u0447\u044b\u0441\u0446\u0435\u0439\u0448\u0430\u0439 \u0440\u0430\u0441\u043a\u043e\u0448\u044b, \u0448\u0442\u043e, \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e\u0448\u044b \u0437\u044f\u043c\u043d\u044b\u043c\u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456, \u0437\u0430\u043f\u0430\u043b\u044c\u0432\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0456 \u043f\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u0435\u0440\u0448\u0430\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u044f\u043a\u0430\u044f \u043a\u0430\u0436\u0430: \u00ab\u041b\u044e\u0431\u0456 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u044e \u0442\u0432\u0430\u0451\u044e, \u0456 \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b \u0442\u0432\u0430\u0456\u0445\u00bb (\u0414\u0440\u0433 6, 5; \u043f\u0430\u0440. \u041c\u0446 22, 37; \u041c\u043a 12, 30; \u041b\u043a 10, 27). \u0410 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430 \u2013 \u0433\u044d\u0442\u0430 \u043d\u0456\u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u044f\u043a \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430 \u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u0437 \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0442\u0430\u043a \u0456 \u043f\u0440\u0430\u0433\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0441\u043f\u0430\u043b\u0443\u0447\u0430\u043d\u0430 \u0437 \u0446\u043d\u043e\u0442\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u044f, \u0431\u043e \u044f\u043d\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c\u00bb (\u041c\u0446 5, 7).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u044b\u0437\u043d\u0430\u0439, \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d, \u0443\u0437\u043d\u0451\u0441\u043b\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u043f\u0430\u0437\u043d\u0430\u0439, \u044f\u043a\u0456\u043c\u0456 \u0448\u043b\u044f\u0445\u0430\u043c\u0456, \u0434\u0430 \u044f\u043a\u0456\u0445 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430\u045e \u0442\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b. \u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u0442\u044b \u0431\u044b\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c, \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u2013 \u043a\u0430\u0431 \u0431\u044b\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b. \u0406 \u0433\u044d\u0442\u0430 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0430\u0431\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456, \u0430 \u0411\u043e\u0436\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u043f\u0440\u0430\u0437 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0430\u0434\u0431\u0456\u045e\u0441\u044f \u045e \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430. \u0412\u0435\u0440\u0430 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430\u044f, \u043a\u0430\u043b\u0456 \u0441\u043f\u0430\u043b\u0443\u0447\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437 \u0443\u0447\u044b\u043d\u043a\u0430\u043c\u0456; \u0442\u0430\u043a \u0441\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u0442\u0432\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0456 \u0442\u044b \u043d\u0430\u0432\u0435\u043a\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448 \u0442\u043e\u0435, \u0448\u0442\u043e \u043b\u044e\u0431\u0456\u0448.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443 \u045e\u0441\u0451 \u0441\u0442\u0430\u043d\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0447\u044b\u0441\u0442\u0430\u0435, \u0442\u043e \u0442\u044b \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u0448 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u044f\u0433\u043e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u0415\u0437\u0443\u0441 \u0430\u0431\u044f\u0446\u0430\u0435 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: \u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0447\u044b\u0441\u0442\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c, \u0431\u043e \u044f\u043d\u044b \u0411\u043e\u0433\u0430 \u045e\u0431\u0430\u0447\u0430\u0446\u044c\u00bb (\u041c\u0446 5, 8).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439, \u043a\u0430\u043c\u0443 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430 \u0442\u0430\u043a\u0430\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430! \u0428\u0442\u043e \u0436 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043c\u0435\u0446\u044c \u0447\u044b\u0441\u0442\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0435 \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0435 \u0434\u0430 \u0432\u044b\u0448\u044d\u0439 \u043d\u0430\u0437\u0432\u0430\u043d\u044b\u0445 \u0446\u043d\u043e\u0442\u0430\u045e? \u042f\u043a\u0456 \u0436 \u0440\u043e\u0437\u0443\u043c \u0437\u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u044f\u043a\u0456 \u0436 \u044f\u0437\u044b\u043a \u0437\u043c\u043e\u0436\u0430 \u0432\u044b\u0440\u0430\u0437\u0456\u0446\u044c \u0448\u0447\u0430\u0441\u0446\u0435, \u044f\u043a\u043e\u0435 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430. \u0410\u043b\u0435 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u0441\u0442\u0430\u043d\u0435 \u043b\u0451\u0441\u0430\u043c \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0435\u043d\u0430\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b: \u00ab\u0411\u043e \u0446\u044f\u043f\u0435\u0440 \u043c\u044b \u0431\u0430\u0447\u044b\u043c \u043f\u0440\u0430\u0437 \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0430, \u0446\u044c\u043c\u044f\u043d\u0430, \u0430 \u0442\u0430\u0434\u044b \u2013 \u0442\u0432\u0430\u0440\u0430\u043c \u0443 \u0442\u0432\u0430\u0440\u00bb (1 \u041a\u0430\u0440 13, 12) \u0443\u0431\u0430\u0447\u044b\u043c \u0411\u043e\u0433\u0430, \u044f\u043a\u0456\u043c \u0401\u043d \u0451\u0441\u0446\u044c, \u0411\u043e\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u0435 \u043c\u043e\u0433 \u0443\u0431\u0430\u0447\u044b\u0446\u044c. \u0417 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u045e\u0431\u0430\u0447\u044b\u043c, \u00ab\u0447\u0430\u0433\u043e \u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430, \u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430, \u0456 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0441\u044d\u0440\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u00bb (1 \u041a\u0430\u0440 2, 9).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 31 (30), 20; 1 \u041a\u0430\u0440 2, 9\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u042f\u043a\u0430\u044f \u0436 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0422\u0432\u0430\u044f \u0434\u0430\u0431\u0440\u044b\u043d\u044f, \u041f\u0430\u043d\u0435, \u044f\u043a\u0443\u044e \u0422\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0426\u044f\u0431\u0435 \u0431\u0430\u0456\u0446\u0446\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0422\u044b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u044f\u0435 \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0430 \u0426\u044f\u0431\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0427\u0430\u0433\u043e \u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430, \u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430, \u0456 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0441\u044d\u0440\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u044b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"232","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456\u00bb \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 95, 8-9: PL 54, 465-466)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u044f\u043b\u0456\u043a\u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0443 \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0422\u0432\u043e\u0439 \u0437\u0430\u043a\u043e\u043d<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0447\u0430\u0441\u0446\u0435 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u0411\u043e\u0433\u0430 \u0431\u044b\u043b\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u0430 \u043b\u044e\u0434\u0437\u044f\u043c \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430. \u0411\u043e \u0432\u043e\u0447\u044b, \u043f\u0440\u044b\u0437\u0432\u044b\u0447\u0430\u0435\u043d\u044b\u044f \u0434\u0430 \u0446\u0435\u043c\u0440\u044b, \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0431\u043b\u044f\u0441\u043a \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430. \u0422\u043e\u0435, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u043b\u044b\u0445 \u0434\u0443\u0448 \u0448\u0447\u0430\u0441\u0446\u0435\u043c, \u0434\u043b\u044f \u0437\u0430\u0431\u0440\u0443\u0434\u0436\u0430\u043d\u044b\u0445 \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0440\u0430\u0439. \u0422\u0430\u043c\u0443 \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u0446\u044c \u0432\u043e\u0447\u044b \u0430\u0434 \u0437\u043c\u0440\u043e\u043a\u0443 \u0437\u044f\u043c\u043d\u044b\u0445 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u044f\u045e, \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u0456\u0445 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443, \u043a\u0430\u0431 \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b \u0437\u0440\u043e\u043a \u043c\u043e\u0433 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u044b\u043c \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u043c \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0448\u0442\u043e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0432\u0443\u0447\u044b\u0446\u044c, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043c\u043e\u0436\u043d\u0430 \u0433\u044d\u0442\u0430 \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u0446\u044c: \u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043c\u0456\u0440\u0430\u0442\u0432\u043e\u0440\u0446\u044b, \u0431\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u044b\u044f \u0441\u044b\u043d\u0430\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456\u00bb (\u041c\u0446 5, 9). \u041d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u044b\u044f, \u0433\u044d\u0442\u0430\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u0435 \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u044f\u043a\u043e\u0433\u0430-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043f\u0430\u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0446\u0456 \u0434\u0430\u043c\u043e\u0432\u044b, \u0430\u043b\u0435 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0442\u043e\u0439 \u0441\u043f\u0430\u043a\u043e\u0439, \u043f\u0440\u0430 \u044f\u043a\u0456 \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: \u00ab\u041c\u0430\u0439\u0446\u0435 \u043c\u0456\u0440 \u0437 \u0411\u043e\u0433\u0430\u043c\u00bb (\u043f\u0430\u0440. \u0420\u044b\u043c 5, 1). \u041f\u0440\u0430 \u0442\u0430\u043a\u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u043a\u0430\u0436\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0440\u043e\u043a: \u00ab\u0412\u044f\u043b\u0456\u043a\u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0443 \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0422\u0432\u043e\u0439 \u0437\u0430\u043a\u043e\u043d, \u044f\u043d\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0441\u043f\u0430\u0442\u044b\u043a\u043d\u0443\u0446\u0446\u0430\u00bb (\u041f\u0441 119 [118], 165).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a\u043e\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u044e \u043d\u0435 \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u0434\u0430\u0446\u044c \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u0430\u0435 \u0446\u0435\u0441\u043d\u0430\u0435 \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430 \u0456 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0445\u0430\u0440\u0430\u043a\u0442\u0430\u0440\u0430\u045e, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u043d\u0435 \u0437\u0433\u043e\u0434\u043d\u044b\u044f \u0437 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u044f\u0439. \u041d\u044f\u0433\u043e\u0434\u043d\u044b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u044e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u044b\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e, \u0437\u043b\u0430\u0447\u044b\u043d\u043d\u044b\u044f \u0441\u0430\u044e\u0437\u044b \u0456 \u0437\u043c\u043e\u0432\u044b \u0437\u043b\u0430. \u041b\u044e\u0431\u043e\u045e \u0441\u0432\u0435\u0442\u0443 \u043d\u0435 \u0437\u0433\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0437 \u043b\u044e\u0431\u043e\u045e\u044e \u0411\u043e\u0433\u0430. \u0425\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0430\u0434\u0430\u0440\u0432\u0430\u0446\u0446\u0430 \u0430\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u044f, \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439. \u0422\u044b\u044f, \u0447\u044b\u0439 \u0440\u043e\u0437\u0443\u043c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u0434\u0430 \u0411\u043e\u0433\u0430, \u0441\u0442\u0430\u0440\u0430\u044e\u0446\u0446\u0430 \u00ab\u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e\u00bb (\u042d\u0444 4, 3), \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c \u0430\u0434 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0437\u0430\u043a\u043e\u043d\u0443, \u0437 \u0432\u0435\u0440\u0430\u0439 \u0432\u044b\u043c\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0435: \u00ab\u0411\u0443\u0434\u0437\u044c \u0432\u043e\u043b\u044f \u0422\u0432\u0430\u044f, \u044f\u043a \u0443 \u043d\u0435\u0431\u0435, \u0442\u0430\u043a \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456\u00bb (\u041c\u0446 6, 10).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430 \u043c\u0456\u0440\u0430\u0442\u0432\u043e\u0440\u0446\u044b, \u044f\u043d\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0430\u0434\u043d\u0430\u043c\u044b\u0441\u043d\u044b\u044f \u0456 \u0441\u0432\u044f\u0442\u0430 \u0437\u0433\u043e\u0434\u043d\u044b\u044f, \u044f\u043d\u044b \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u0446\u0430 \u00ab\u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0411\u043e\u0433\u0430 \u0456 \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430\u00bb (\u043f\u0430\u0440. \u0420\u044b\u043c 8, 17). \u041b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u045e\u0447\u044b\u043d\u0456\u0446\u044c, \u0448\u0442\u043e \u044f\u043d\u044b \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0430\u044f\u0446\u0446\u0430 \u043d\u0456\u044f\u043a\u0456\u0445 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e \u0456 \u043d\u0456\u044f\u043a\u0456\u0445 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u045e, \u0430\u043b\u0435 \u043f\u0430\u0441\u043b\u044f \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u044f \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u0456\u0441\u043f\u044b\u0442\u0430\u045e \u0430\u0434\u043f\u0430\u0447\u043d\u0443\u0446\u044c \u0443 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0456 \u0411\u043e\u0433\u0430, \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0406\u0441 38, 3; \u043f\u0430\u0440. 1 \u042f\u043d 2, 6; 5, 3; 2, 5\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u0443\u0434\u0437\u0435\u043c \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u0411\u043e\u0433\u0430\u043c \u043d\u0430\u0448\u044b\u043c, \u0441\u0430 \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0411\u0443\u0434\u0437\u0435\u043c \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u042f\u0433\u043e\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0425\u0442\u043e \u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435, \u0443 \u0442\u044b\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u0443\u0434\u0437\u0435\u043c \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"233","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430, \u0430\u0431\u0430\u0442\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 5 de diversis, 1-4: Opera omnia, Edit. Cisterc. 6, 1 [1970] 98-103)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u0443\u0434\u0443 \u0447\u0443\u0432\u0430\u0446\u044c, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c, \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u043c\u043d\u0435 \u041f\u0430\u043d<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456 \u0447\u044b\u0442\u0430\u0435\u043c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u0432\u0443\u0447\u044b\u045e \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u045e \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u042f\u0433\u043e \u041c\u0443\u0446\u044b \u043f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u0435 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u0435 \u042f\u0433\u043e \u0426\u0435\u043b\u0430, \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u0426\u044f\u0436\u043a\u0430\u044f \u0433\u044d\u0442\u0430\u044f \u043c\u043e\u0432\u0430!\u00bb \u0406 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0447\u0430\u0441\u0443 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0456 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0437 \u0406\u043c. \u0410 \u043a\u0430\u043b\u0456 \u0441\u043f\u044b\u0442\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u045e, \u0446\u0456 \u044f\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0445\u043e\u0447\u0443\u0446\u044c \u0430\u0434\u044b\u0441\u0446\u0456, \u044f\u043d\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u041f\u0430\u043d\u0435, \u0434\u0430 \u043a\u0430\u0433\u043e \u043c\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u043c? \u0422\u044b \u043c\u0430\u0435\u0448 \u0441\u043b\u043e\u0432\u044b \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f\u00bb (\u042f\u043d 6, 68).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0440\u0430\u0442\u044b \u043c\u0430\u0435, \u0441\u0451\u043d\u043d\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0451\u0441\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0441\u043b\u043e\u0432\u044b \u0415\u0437\u0443\u0441\u0430 \u2013 \u0433\u044d\u0442\u0430 \u0434\u0443\u0445 \u0456 \u0436\u044b\u0446\u0446\u0451, \u0456 \u0442\u0430\u043c\u0443 \u0456\u0434\u0443\u0446\u044c \u0437\u0430 \u0406\u043c. \u0406\u043d\u0448\u044b\u043c \u044f\u043d\u044b \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442 \u0437\u0434\u0430\u044e\u0446\u0446\u0430 \u0437\u0430\u043d\u0430\u0434\u0442\u0430 \u0446\u044f\u0436\u043a\u0456\u043c\u0456, \u0442\u0430\u043c\u0443 \u045e \u0456\u043d\u0448\u044b\u043c \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u043c\u0430\u0440\u043d\u0430\u0433\u0430 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f. \u0412\u043e\u0441\u044c \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u043d\u0430 \u043f\u043b\u043e\u0448\u0447\u0430\u0445, \u043d\u0430 \u0448\u044b\u0440\u043e\u043a\u0430\u0439 \u0456 \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u043d\u0430\u0439 \u0434\u0430\u0440\u043e\u0437\u0435, \u044f\u043a\u0430\u044f \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u043a\u0430\u0431 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u043d\u0430\u0437\u0430\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u043f\u0430 \u0451\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: \u00ab\u0421\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u0430\u0433\u0456\u0434\u0443 \u045e\u0432\u0430 \u041c\u043d\u0435 \u0433\u044d\u0442\u0430\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435, \u0456 \u042f \u0441\u043a\u0430\u0437\u0430\u045e: \u201c\u0413\u044d\u0442\u0430 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0431\u043b\u0443\u043a\u0430\u0435 \u0441\u044d\u0440\u0446\u0430\u043c\u201d\u00bb (\u041f\u0441 95 [94], 10). \u0410 \u045e \u0456\u043d\u0448\u044b\u043c \u043f\u0441\u0430\u043b\u044c\u043c\u0435 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u00ab\u0411\u043e\u0433 \u0440\u0430\u0437 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e\u00bb (\u041f\u0441 62 [61], 12). \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437, \u0431\u043e \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043a\u0430\u0436\u0430. \u0411\u043e \u042f\u0433\u043e \u043f\u0440\u0430\u043c\u043e\u0432\u0430 \u0430\u0434\u043d\u0430, \u043d\u0430\u0441\u043f\u044b\u043d\u043d\u0430\u044f, \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430\u044f \u0456 \u0431\u0435\u0437 \u043a\u0430\u043d\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u043d \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u0440\u0430\u0435 \u0431\u044f\u0437\u043b\u0430\u0434\u0434\u0437\u0435 \u0441\u044d\u0440\u0446\u0430, \u0431\u043e \u0442\u0430\u043c \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0401\u043d \u0436\u044b\u0432\u0435 \u0456 \u0442\u0430\u043c \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435. \u0422\u0430\u043a \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430: \u00ab\u041f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0434\u0430 \u0441\u044d\u0440\u0446\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430\u00bb (\u0406\u0441 40, 2).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u044f\u043a \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u0430 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043d\u0430\u0441 \u043f\u0440\u0430\u0440\u043e\u043a, \u043a\u0430\u0431 \u043c\u044b, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0451\u043d\u043d\u044f \u0447\u0443\u0435\u043c \u042f\u0433\u043e \u0433\u043e\u043b\u0430\u0441, \u043d\u0435 \u0440\u0430\u0431\u0456\u043b\u0456 \u0446\u0432\u0451\u0440\u0434\u044b\u043c\u0456 \u0441\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u044b. \u0413\u044d\u0442\u0430 \u0430\u043c\u0430\u043b\u044c \u0442\u044b\u044f \u0441\u0430\u043c\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u043c\u044b \u0447\u044b\u0442\u0430\u0435\u043c \u0443 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456, \u0434\u0437\u0435 \u041f\u0430\u043d \u043a\u0430\u0436\u0430: \u00ab\u0410\u0432\u0435\u0447\u043a\u0456 \u041c\u0430\u0435 \u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u041c\u043e\u0439\u00bb (\u042f\u043d 10, 27). \u0410 \u0414\u0430\u0432\u0456\u0434 \u0443 \u043f\u0441\u0430\u043b\u044c\u043c\u0435 \u043a\u0430\u0436\u0430: \u00ab\u041d\u0430\u0440\u043e\u0434 \u042f\u0433\u043e\u043d\u0430\u0439 \u043f\u0430\u0448\u044b \u0456 \u0430\u0432\u0435\u0447\u043a\u0456 \u0440\u0443\u043a\u0456 \u042f\u0433\u043e\u043d\u0430\u0439 (\u042f\u0433\u043e\u043d\u0430\u0439, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u041f\u0430\u043d\u0430); \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c\u0456 \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f\u00bb (\u041f\u0441 95 [94], 7-8).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u045e \u0440\u044d\u0448\u0446\u0435 \u0440\u044d\u0448\u0442 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0410\u0431\u0430\u043a\u0443\u043a\u0430. \u0401\u043d \u043d\u0435 \u0437\u0430\u043c\u043e\u045e\u0447\u0432\u0430\u0435 \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0443 \u041f\u0430\u043d\u0430, \u0430\u043b\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0430\u0434 \u0456\u043c \u0443\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u0456 \u0448\u0447\u044b\u0440\u0430. \u0411\u043e \u043a\u0430\u0436\u0430: \u00ab\u042f \u0441\u0442\u0430\u043d\u0443 \u043d\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u0430\u0440\u0446\u0435, \u0456 \u043f\u0430\u0434\u044b\u043c\u0443\u0441\u044f \u043d\u0430 \u0432\u0435\u0436\u0443, \u0456 \u0431\u0443\u0434\u0443 \u043f\u0456\u043b\u044c\u043d\u0430 \u0441\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0441\u043a\u0430\u0436\u0430 \u043c\u043d\u0435 \u0456 \u0448\u0442\u043e \u0430\u0434\u043a\u0430\u0436\u0430 \u043d\u0430 \u0441\u043a\u0430\u0440\u0433\u0443 \u043c\u0430\u044e\u00bb (\u0410\u0431\u043a 2, 1). \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043c\u044b, \u0431\u0440\u0430\u0442\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0430\u0447\u044b\u0446\u044c \u0437\u0430 \u0441\u0430\u0431\u043e\u044e, \u0431\u043e \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456 \u0447\u0430\u0441 \u2013 \u0433\u044d\u0442\u0430 \u0447\u0430\u0441 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0441\u044d\u0440\u0446\u044b, \u0443 \u044f\u043a\u0456\u043c \u0436\u044b\u0432\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043d\u044f\u0445\u0430\u0439 \u043c\u0443\u0434\u0440\u0430 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430 \u0440\u0430\u0445\u0443\u044e\u0446\u0446\u0430 \u043d\u0430\u0448\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b; \u0442\u0430\u043a, \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435 \u0456 \u043d\u0435 \u0434\u0430\u0432\u044f\u0440\u0430\u043b\u0456 \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0432\u0430\u0440\u0446\u0435.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 18 (17), 23; 19 (18), 9; 1 \u042f\u043d 2, 5\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0423\u0441\u0435 \u043f\u0440\u044b\u0441\u0443\u0434\u044b \u041f\u0430\u043d\u0430 \u043f\u0435\u0440\u0430\u0434\u0430 \u043c\u043d\u043e\u044e, \u0456 \u044f \u043d\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u045e \u042f\u0433\u043e\u043d\u044b\u0445 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045e.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0417\u0430\u0433\u0430\u0434\u044b \u041f\u0430\u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0456 \u0440\u0430\u0434\u0443\u044e\u0446\u044c \u0441\u044d\u0440\u0446\u0430, \u043d\u0430\u043a\u0430\u0437 \u041f\u0430\u043d\u0430 \u044f\u0441\u043d\u044b, \u043f\u0440\u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0432\u043e\u0447\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0425\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u042f\u0433\u043e\u043d\u0430\u0435, \u0443 \u0442\u044b\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0417\u0430\u0433\u0430\u0434\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"234","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430, \u0430\u0431\u0430\u0442\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 5 de diversis, 1-4: Opera omnia, Edit. Cisterc. 6, 1 [1970] 98-103)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u0443\u0434\u0443 \u0447\u0443\u0432\u0430\u0446\u044c, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c, \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u043c\u043d\u0435 \u041f\u0430\u043d<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456 \u0447\u044b\u0442\u0430\u0435\u043c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u0432\u0443\u0447\u044b\u045e \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u045e \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u042f\u0433\u043e \u041c\u0443\u0446\u044b \u043f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u0435 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u0435 \u042f\u0433\u043e \u0426\u0435\u043b\u0430, \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u0426\u044f\u0436\u043a\u0430\u044f \u0433\u044d\u0442\u0430\u044f \u043c\u043e\u0432\u0430!\u00bb \u0406 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0447\u0430\u0441\u0443 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0456 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0437 \u0406\u043c. \u0410 \u043a\u0430\u043b\u0456 \u0441\u043f\u044b\u0442\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u045e, \u0446\u0456 \u044f\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0445\u043e\u0447\u0443\u0446\u044c \u0430\u0434\u044b\u0441\u0446\u0456, \u044f\u043d\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456: \u00ab\u041f\u0430\u043d\u0435, \u0434\u0430 \u043a\u0430\u0433\u043e \u043c\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u043c? \u0422\u044b \u043c\u0430\u0435\u0448 \u0441\u043b\u043e\u0432\u044b \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f\u00bb (\u042f\u043d 6, 68).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0440\u0430\u0442\u044b \u043c\u0430\u0435, \u0441\u0451\u043d\u043d\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0451\u0441\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0441\u043b\u043e\u0432\u044b \u0415\u0437\u0443\u0441\u0430 \u2013 \u0433\u044d\u0442\u0430 \u0434\u0443\u0445 \u0456 \u0436\u044b\u0446\u0446\u0451, \u0456 \u0442\u0430\u043c\u0443 \u0456\u0434\u0443\u0446\u044c \u0437\u0430 \u0406\u043c. \u0406\u043d\u0448\u044b\u043c \u044f\u043d\u044b \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442 \u0437\u0434\u0430\u044e\u0446\u0446\u0430 \u0437\u0430\u043d\u0430\u0434\u0442\u0430 \u0446\u044f\u0436\u043a\u0456\u043c\u0456, \u0442\u0430\u043c\u0443 \u045e \u0456\u043d\u0448\u044b\u043c \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u043c\u0430\u0440\u043d\u0430\u0433\u0430 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f. \u0412\u043e\u0441\u044c \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u043d\u0430 \u043f\u043b\u043e\u0448\u0447\u0430\u0445, \u043d\u0430 \u0448\u044b\u0440\u043e\u043a\u0430\u0439 \u0456 \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u043d\u0430\u0439 \u0434\u0430\u0440\u043e\u0437\u0435, \u044f\u043a\u0430\u044f \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u043a\u0430\u0431 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u043d\u0430\u0437\u0430\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u043f\u0430 \u0451\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: \u00ab\u0421\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u0430\u0433\u0456\u0434\u0443 \u045e\u0432\u0430 \u041c\u043d\u0435 \u0433\u044d\u0442\u0430\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435, \u0456 \u042f \u0441\u043a\u0430\u0437\u0430\u045e: \u201c\u0413\u044d\u0442\u0430 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0431\u043b\u0443\u043a\u0430\u0435 \u0441\u044d\u0440\u0446\u0430\u043c\u201d\u00bb (\u041f\u0441 95 [94], 10). \u0410 \u045e \u0456\u043d\u0448\u044b\u043c \u043f\u0441\u0430\u043b\u044c\u043c\u0435 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u00ab\u0411\u043e\u0433 \u0440\u0430\u0437 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e\u00bb (\u041f\u0441 62 [61], 12). \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437, \u0431\u043e \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043a\u0430\u0436\u0430. \u0411\u043e \u042f\u0433\u043e \u043f\u0440\u0430\u043c\u043e\u0432\u0430 \u0430\u0434\u043d\u0430, \u043d\u0430\u0441\u043f\u044b\u043d\u043d\u0430\u044f, \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430\u044f \u0456 \u0431\u0435\u0437 \u043a\u0430\u043d\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u043d \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u0440\u0430\u0435 \u0431\u044f\u0437\u043b\u0430\u0434\u0434\u0437\u0435 \u0441\u044d\u0440\u0446\u0430, \u0431\u043e \u0442\u0430\u043c \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0401\u043d \u0436\u044b\u0432\u0435 \u0456 \u0442\u0430\u043c \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435. \u0422\u0430\u043a \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430: \u00ab\u041f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0434\u0430 \u0441\u044d\u0440\u0446\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430\u00bb (\u0406\u0441 40, 2).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u044f\u043a \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u0430 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043d\u0430\u0441 \u043f\u0440\u0430\u0440\u043e\u043a, \u043a\u0430\u0431 \u043c\u044b, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0451\u043d\u043d\u044f \u0447\u0443\u0435\u043c \u042f\u0433\u043e \u0433\u043e\u043b\u0430\u0441, \u043d\u0435 \u0440\u0430\u0431\u0456\u043b\u0456 \u0446\u0432\u0451\u0440\u0434\u044b\u043c\u0456 \u0441\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u044b. \u0413\u044d\u0442\u0430 \u0430\u043c\u0430\u043b\u044c \u0442\u044b\u044f \u0441\u0430\u043c\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u043c\u044b \u0447\u044b\u0442\u0430\u0435\u043c \u0443 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456, \u0434\u0437\u0435 \u041f\u0430\u043d \u043a\u0430\u0436\u0430: \u00ab\u0410\u0432\u0435\u0447\u043a\u0456 \u041c\u0430\u0435 \u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u041c\u043e\u0439\u00bb (\u042f\u043d 10, 27). \u0410 \u0414\u0430\u0432\u0456\u0434 \u0443 \u043f\u0441\u0430\u043b\u044c\u043c\u0435 \u043a\u0430\u0436\u0430: \u00ab\u041d\u0430\u0440\u043e\u0434 \u042f\u0433\u043e\u043d\u0430\u0439 \u043f\u0430\u0448\u044b \u0456 \u0430\u0432\u0435\u0447\u043a\u0456 \u0440\u0443\u043a\u0456 \u042f\u0433\u043e\u043d\u0430\u0439 (\u042f\u0433\u043e\u043d\u0430\u0439, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u041f\u0430\u043d\u0430); \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c\u0456 \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f\u00bb (\u041f\u0441 95 [94], 7-8).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u045e \u0440\u044d\u0448\u0446\u0435 \u0440\u044d\u0448\u0442 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0410\u0431\u0430\u043a\u0443\u043a\u0430. \u0401\u043d \u043d\u0435 \u0437\u0430\u043c\u043e\u045e\u0447\u0432\u0430\u0435 \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0443 \u041f\u0430\u043d\u0430, \u0430\u043b\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0430\u0434 \u0456\u043c \u0443\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u0456 \u0448\u0447\u044b\u0440\u0430. \u0411\u043e \u043a\u0430\u0436\u0430: \u00ab\u042f \u0441\u0442\u0430\u043d\u0443 \u043d\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u0430\u0440\u0446\u0435, \u0456 \u043f\u0430\u0434\u044b\u043c\u0443\u0441\u044f \u043d\u0430 \u0432\u0435\u0436\u0443, \u0456 \u0431\u0443\u0434\u0443 \u043f\u0456\u043b\u044c\u043d\u0430 \u0441\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0441\u043a\u0430\u0436\u0430 \u043c\u043d\u0435 \u0456 \u0448\u0442\u043e \u0430\u0434\u043a\u0430\u0436\u0430 \u043d\u0430 \u0441\u043a\u0430\u0440\u0433\u0443 \u043c\u0430\u044e\u00bb (\u0410\u0431\u043a 2, 1). \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043c\u044b, \u0431\u0440\u0430\u0442\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0430\u0447\u044b\u0446\u044c \u0437\u0430 \u0441\u0430\u0431\u043e\u044e, \u0431\u043e \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456 \u0447\u0430\u0441 \u2013 \u0433\u044d\u0442\u0430 \u0447\u0430\u0441 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0441\u044d\u0440\u0446\u044b, \u0443 \u044f\u043a\u0456\u043c \u0436\u044b\u0432\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043d\u044f\u0445\u0430\u0439 \u043c\u0443\u0434\u0440\u0430 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430 \u0440\u0430\u0445\u0443\u044e\u0446\u0446\u0430 \u043d\u0430\u0448\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b; \u0442\u0430\u043a, \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435 \u0456 \u043d\u0435 \u0434\u0430\u0432\u044f\u0440\u0430\u043b\u0456 \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0432\u0430\u0440\u0446\u0435.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 18 (17), 23; 19 (18), 9; 1 \u042f\u043d 2, 5\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0423\u0441\u0435 \u043f\u0440\u044b\u0441\u0443\u0434\u044b \u041f\u0430\u043d\u0430 \u043f\u0435\u0440\u0430\u0434\u0430 \u043c\u043d\u043e\u044e, \u0456 \u044f \u043d\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u045e \u042f\u0433\u043e\u043d\u044b\u0445 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0430\u045e.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0417\u0430\u0433\u0430\u0434\u044b \u041f\u0430\u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0456 \u0440\u0430\u0434\u0443\u044e\u0446\u044c \u0441\u044d\u0440\u0446\u0430, \u043d\u0430\u043a\u0430\u0437 \u041f\u0430\u043d\u0430 \u044f\u0441\u043d\u044b, \u043f\u0440\u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0432\u043e\u0447\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0425\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u042f\u0433\u043e\u043d\u0430\u0435, \u0443 \u0442\u044b\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0417\u0430\u0433\u0430\u0434\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"235","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e\u00bb \u0441\u0432. \u0411\u0440\u0443\u043d\u043e\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 83: edit. Cartusiae de Pratis, 1891, 376-377)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0426\u0456 \u0436 \u0437\u0430\u0431\u0443\u0434\u0443 \u043f\u0440\u0430 \u0446\u044f\u0431\u0435, \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u00ab\u042f\u043a\u0456\u044f \u043c\u0456\u043b\u044b\u044f \u0422\u0432\u0430\u0435 \u0448\u0430\u0442\u0440\u044b, \u041f\u0430\u043d\u0435 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e! \u0417\u043d\u0435\u043c\u0430\u0433\u0430\u0435 \u0456 \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u045e \u0434\u0432\u0430\u0440\u044b \u041f\u0430\u043d\u0430\u00bb (\u041f\u0441 84 [83], 2), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434\u0430 \u0432\u0435\u043b\u0456\u0447\u044b \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u044f\u043a\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0436\u044b\u043b\u043b\u0451\u043c \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442 \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c, \u0447\u0430\u043c\u0443 \u0451\u043d \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u045e \u0448\u0430\u0442\u0440\u044b \u041f\u0430\u043d\u0430. \u0412\u043e\u0441\u044c \u0436\u0430 \u0442\u0430\u043c\u0443, \u041f\u0430\u043d\u0435, \u0411\u043e\u0436\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u043c\u043e\u0439 \u0456 \u0411\u043e\u0436\u0430, \u0448\u0442\u043e \u00ab\u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0434\u043e\u043c\u0435 \u0422\u0432\u0430\u0456\u043c\u00bb (\u041f\u0441 84 [83], 5), \u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435. \u0401\u043d \u043d\u0456\u0431\u044b \u043a\u0430\u0436\u0430: \u00ab\u0425\u0442\u043e \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0422\u0432\u0430\u0435 \u0434\u0432\u0430\u0440\u044b, \u0431\u043e \u0422\u044b \u2013 \u0411\u043e\u0433, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c, \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u041a\u0430\u0440\u043e\u043b\u044c, \u0456 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e\u0441\u0435, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0422\u0432\u0430\u0456\u043c \u0434\u043e\u043c\u0435, \u2013 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f\u00bb. \u0414\u0432\u043e\u0440 \u0456 \u0434\u043e\u043c \u0442\u0443\u0442 \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435. \u041a\u0430\u043b\u0456 \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442 \u043a\u0430\u0436\u0430 \u00ab\u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f\u00bb, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u0448\u0442\u043e \u0448\u0447\u0430\u0441\u0446\u0435, \u044f\u043a\u0456\u043c \u044f\u043d\u044b \u0433\u0430\u043d\u0430\u0440\u0430\u0446\u0446\u0430, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0436\u043d\u0430 \u0441\u0430\u0431\u0435 \u045e\u044f\u0432\u0456\u0446\u044c. \u042f\u043d\u044b \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u00ab\u0432\u0435\u0447\u043d\u0430 \u0441\u043f\u044f\u0432\u0430\u044e\u0446\u044c \u0422\u0430\u0431\u0435\u00bb (\u041f\u0441 84 [83], 5) \u0437 \u0433\u0430\u0440\u0430\u0447\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e. \u0412\u0435\u0447\u043d\u0430 \u2013 \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u0443\u0441\u044e \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c. \u041d\u0435 \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u0431 \u0432\u0435\u0447\u043d\u0430, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0431\u044b\u043b\u0456 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0414\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0442\u0430\u043a\u043e\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u045e\u043b\u0430\u0441\u043d\u044b\u043c \u0441\u0456\u043b\u0430\u043c, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u043c\u0430\u0435 \u043d\u0430\u0434\u0437\u0435\u044e, \u0432\u0435\u0440\u0443 \u0456 \u043b\u044e\u0431\u043e\u045e. \u0410 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0439, \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u0441\u044f\u0433\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u044f, \u00ab\u0441\u0456\u043b\u0430 \u044f\u043a\u043e\u0433\u0430 \u045e \u0422\u0430\u0431\u0435\u00bb (\u041f\u0441 84 [83], 6). \u0413\u044d\u0442\u0430\u044f \u0441\u0456\u043b\u0430 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0447\u0430\u043a\u0430\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f \u045e \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430. \u0406\u043d\u0430\u043a\u0448 \u043a\u0430\u0436\u0443\u0447\u044b: \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439 \u0434\u043e\u0439\u0434\u0437\u0435 \u0434\u0430 \u0448\u0447\u0430\u0441\u0446\u044f, \u0445\u0442\u043e \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0443 \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u0456\u0441\u0446\u0456 \u0434\u0430 \u044f\u0433\u043e \u043d\u0435 \u043f\u0440\u0430\u0437 \u0440\u043e\u0437\u043d\u044b\u044f \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u0446\u043d\u043e\u0442\u0430\u045e \u0456 \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u0430 \u0442\u0430\u043c\u0443 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0422\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456. \u0423\u043b\u0430\u0441\u043d\u044b\u043c\u0456 \u0441\u0456\u043b\u0430\u043c\u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430, \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0430\u043c \u041f\u0430\u043d: \u00ab\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u045e\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430 (\u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443\u043b\u0430\u0441\u043d\u044b\u043c\u0456 \u0441\u0456\u043b\u0430\u043c\u0456), \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437 \u043d\u0435\u0431\u0430 \u0441\u044b\u0448\u043e\u045e, \u2013 \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430\u00bb (\u042f\u043d 3, 13).<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0443: \u00ab\u041f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0456\u0441\u0446\u0456 \u043f\u0430 \u043b\u0435\u0441\u0432\u0456\u0446\u044b\u00bb, \u0431\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0433\u044d\u0442\u044b \u2013 \u00ab\u0443 \u0434\u0430\u043b\u0456\u043d\u0435 \u043f\u043b\u0430\u0447\u0443\u00bb (\u041f\u0441 84 [83], 6. 7), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0443 \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u044f\u043a\u043e\u0435, \u0443 \u043f\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0456 \u0437 \u0434\u0440\u0443\u0433\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u043c\u0456\u0437\u044d\u0440\u043d\u0430\u0435 \u0456 \u043f\u043e\u045e\u043d\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e; \u0442\u043e\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0456 \u0437 \u0433\u044d\u0442\u044b\u043c \u0430\u043f\u043e\u0448\u043d\u0456\u043c \u043c\u043e\u0436\u043d\u0430 \u043d\u0430\u0437\u0432\u0430\u0446\u044c \u0433\u0430\u0440\u043e\u0439, \u043f\u043e\u045e\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0441\u0456\u043b\u0430 \u044f\u043a\u043e\u0433\u0430 \u045e \u0422\u0430\u0431\u0435\u00bb, \u0442\u043e \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043c\u043e\u0436\u0430 \u0441\u043f\u044b\u0442\u0430\u0446\u0446\u0430: \u0446\u0456 \u0411\u043e\u0433 \u0434\u0430\u0435 \u0442\u0430\u043a\u0443\u044e \u0441\u0456\u043b\u0443? \u0422\u0430\u043c\u0443 \u0451\u043d \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435: \u0411\u043e\u0433 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0434\u0430\u0435 \u0441\u0456\u043b\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u043c. \u0411\u043e \u0437\u0430\u043a\u0430\u043d\u0430\u0434\u0430\u045e\u0446\u0430, \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0434\u0430\u0435 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0432\u0430\u0446\u044c \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u043b\u0430\u0441\u043a\u0456, \u043f\u0440\u0430\u0437 \u044f\u043a\u0456\u044f \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e, \u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u2013 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f. \u042f\u043d\u044b, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u044b\u043c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u043c, \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0448\u0442\u043e\u0440\u0430\u0437 \u0432\u044b\u0448\u044d\u0439 (\u043f\u0430\u0440. \u041f\u0441 84 [83], 8). \u0423 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u0456, \u043d\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0421\u0456\u0451\u043d\u0435 \u044f\u043d\u044b \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u0411\u043e\u0433\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0431\u0430\u0433\u0430\u043c\u0456, \u044f\u043a\u0456, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0430\u043c, \u0431\u0443\u0434\u0437\u0435 \u0430\u0431\u0430\u0433\u0430\u045e\u043b\u044f\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u042f\u043c\u0443 \u0441\u043b\u0443\u0436\u044b\u0446\u044c. \u041c\u043e\u0436\u043d\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u045e\u0442\u0432\u0430\u0440\u0430\u0435 \u0421\u0456\u0451\u043d, \u0434\u0443\u0445\u043e\u045e\u043d\u0430 \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u0411\u043e\u0433 \u043f\u0430-\u043d\u0430\u0434 \u0431\u0430\u0433\u0430\u043c\u0456, \u0411\u043e\u0433 \u0443 \u0410\u0434\u0437\u0456\u043d\u0430\u0439 \u0422\u0440\u043e\u0439\u0446\u044b. \u0406\u043d\u0430\u043a\u0448 \u043a\u0430\u0436\u0443\u0447\u044b, \u044f\u043d\u044b \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u0443\u0431\u0430\u0447\u0430\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u0411\u043e\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435\u043b\u044c\u0433\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u00ab\u045e\u0441\u0451 \u0432\u0430 \u045e\u0441\u0456\u043c\u00bb (1 \u041a\u0430\u0440 15, 28).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u042f\u043d 3, 2-3\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0426\u044f\u043f\u0435\u0440 \u043c\u044b \u0434\u0437\u0435\u0446\u0456 \u0411\u043e\u0436\u044b\u044f, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u043d\u0435 \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f, \u0447\u044b\u043c \u0431\u0443\u0434\u0437\u0435\u043c. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0401\u043d \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u0446\u0430, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u043c \u042f\u0433\u043e \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043c\u0430\u0435 \u0442\u0430\u043a\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u042f\u0433\u043e, \u0447\u044b\u043d\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c, \u044f\u043a \u0401\u043d \u0451\u0441\u0446\u044c \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0412\u0435\u0434\u0430\u0435\u043c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"236","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0431\u043b. \u0406\u0441\u0430\u0430\u043a\u0430, \u0430\u0431\u0430\u0442\u0430 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u0443 \u0421\u0442\u044d\u043b\u043b\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 11: PL 194, 1728-1729)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430-\u0437\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0435 \u0433\u0440\u0430\u0445\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0437\u0432\u0435 \u0440\u044d\u0447\u044b \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u0430 \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0411\u043e\u0433\u0443: \u0445\u0432\u0430\u043b\u0430, \u044f\u043a\u0430\u044f \u0432\u044b\u043f\u043b\u044b\u0432\u0430\u0435 \u0437 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u044f \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f, \u0456 \u043c\u043e\u0446, \u0448\u0442\u043e \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0456. \u042f\u043c\u0443 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u044b, \u0430\u0434 \u042f\u0433\u043e \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0447\u0430\u043a\u0430\u0446\u044c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u044f. \u0422\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433 \u043c\u043e\u0436\u0430 \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0446\u044c \u0433\u0440\u0430\u0445\u0456, \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0442\u0440\u044d\u0431\u0430 \u0456\u0445 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u0443 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0456 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u043f\u0440\u044b\u043d\u044f\u045e \u0441\u043b\u0430\u0431\u0443\u044e \u0456 \u043c\u0430\u043b\u0430\u0437\u043d\u0430\u0447\u043d\u0443\u044e \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0443, \u0437 \u0441\u043b\u0443\u0433\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u044f\u0435 \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430\u0439. \u041f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043f\u043e\u0431\u0430\u0447 \u0437 \u0441\u0430\u0431\u043e\u044e \u0442\u0443\u044e, \u044f\u043a\u0430\u044f \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0431\u044b\u043b\u0430 \u042f\u0433\u043e \u043f\u0430\u0434\u043d\u043e\u0436\u0436\u0430\u043c. \u042f\u043d\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0437 \u042f\u0433\u043e \u0431\u043e\u043a\u0443, \u0456 \u0442\u0430\u0434\u044b \u0401\u043d \u0443\u0437\u044f\u045e \u044f\u0435 \u0441\u0430\u0431\u0435. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0410\u0439\u0446\u0443, \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0421\u044b\u043d\u0443, \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0421\u044b\u043d\u0443, \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0442\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443, \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0410\u0439\u0446\u0443. \u0422\u0430\u043c\u0443 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0443\u0441\u0451 \u0441\u0432\u0430\u0451\u0439 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b, \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b, \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u0456 \u0437\u043b\u0443\u0447\u044b\u045e \u044f\u0435 \u0437 \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u043e\u044e \u0456 \u0437 \u0410\u0439\u0446\u043e\u043c: \u00ab\u0425\u0430\u0447\u0443, \u2013 \u043a\u0430\u0436\u0430 \u0421\u044b\u043d, \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0447\u044b\u0441\u044f \u0437\u0430 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0443, \u2013 \u043a\u0430\u0431 \u0443\u0441\u0435 \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e, \u044f\u043a \u0422\u044b, \u041e\u0439\u0447\u0430, \u0443\u0432\u0430 \u041c\u043d\u0435, \u0456 \u042f \u045e \u0422\u0430\u0431\u0435\u00bb (\u043f\u0430\u0440. \u042f\u043d 17, 21). \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a \u0441\u0442\u0432\u0430\u0440\u0430\u0435 \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430 \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430 \u0437 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430\u0439. \u0423\u0441\u0451 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0447\u0443\u0436\u043e\u0435 \u045e \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b, \u0437\u043d\u0456\u0448\u0447\u044b\u045e, \u043f\u0440\u044b\u0431\u0456\u045e\u0448\u044b \u0434\u0430 \u043a\u0440\u044b\u0436\u0430. \u041f\u0430\u043d\u0451\u0441 \u044f\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u043d\u0430 \u0434\u0440\u044d\u0432\u0430 \u043a\u0440\u044b\u0436\u0430 \u0456 \u043d\u0430 \u0434\u0440\u044d\u0432\u0435 \u043a\u0440\u044b\u0436\u0430 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0456\u0445. \u0422\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0434\u0430 \u043d\u0430\u0442\u0443\u0440\u044b \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b \u0456 \u0431\u044b\u043b\u043e \u044f\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044e, \u043f\u0440\u044b\u043d\u044f\u045e&nbsp; \u043d\u0430 \u0441\u044f\u0431\u0435. \u0422\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0411\u043e\u0436\u0430\u0435 \u0456 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u042f\u043c\u0443, \u043f\u0430\u0434\u0430\u0440\u0430\u0432\u0430\u045e \u0451\u0439. \u0428\u0442\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0430\u0434 \u0441\u0430\u0442\u0430\u043d\u044b, \u0437\u043d\u0456\u0448\u0447\u044b\u045e, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u043f\u0440\u044b\u043d\u044f\u045e, \u0430 \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0411\u043e\u0441\u043a\u0456\u043c, \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e, \u043a\u0430\u0431 \u0443\u0441\u0451, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0443, \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0456 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b. \u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u0433\u0440\u0430\u0445\u0443, \u043d\u0430 \u0447\u044b\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u0445 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0430\u0434\u043c\u0430\u043d\u0443, \u043c\u043e\u0436\u0430 \u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u0417\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e, \u041f\u0430\u043d\u0435, \u0431\u043e \u044f \u0441\u043b\u0430\u0431\u044b\u00bb (\u041f\u0441 6, 3), \u043a\u0430\u0431, \u043f\u0430\u0434\u0437\u044f\u043b\u044f\u044e\u0447\u044b \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b, \u043f\u0430\u0434\u0437\u044f\u043b\u044f\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u043e\u0441\u044c\u0431\u044b, \u043a\u0430\u0431 \u0443\u0441\u0451 \u0431\u044b\u043b\u043e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u044b\u043c \u0434\u043b\u044f \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430 \u0456 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b. \u0410\u0434\u0441\u044e\u043b\u044c \u0433\u043e\u043d\u0430\u0440 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u044f \u0441\u043f\u043e\u0432\u0435\u0434\u0437\u0456 \u0456 \u043c\u043e\u0446 \u0443\u0434\u0437\u044f\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u044f; \u0442\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u0406\u0434\u0437\u0456, \u043f\u0430\u043a\u0430\u0436\u044b\u0441\u044f \u0441\u0432\u044f\u0442\u0430\u0440\u0443\u00bb (\u041c\u0446 8, 4).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b \u0431\u0435\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0446\u044c, \u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0445\u043e\u0447\u0430 \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0446\u044c \u0431\u0435\u0437 \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u041a\u0430\u0441\u0446\u0451\u043b \u043c\u043e\u0436\u0430 \u045e\u0434\u0437\u044f\u043b\u0456\u0446\u044c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0442\u0430\u043c\u0443, \u0434\u0430 \u043a\u0430\u0433\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0441\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0430\u044e. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0445\u043e\u0447\u0430 \u045e\u0434\u0437\u044f\u043b\u044f\u0446\u044c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c. \u00ab\u0428\u0442\u043e \u0411\u043e\u0433 \u0437\u043b\u0443\u0447\u044b\u045e, \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0440\u0430\u0437\u043b\u0443\u0447\u0430\u0435. \u0412\u044f\u043b\u0456\u043a\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0433\u044d\u0442\u0430\u044f, \u0430 \u043a\u0430\u0436\u0443 \u044f \u045e \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430!\u00bb (\u041c\u0446 19, 6; \u042d\u0444 5, 32).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u0435 \u0456\u043c\u043a\u043d\u0456\u0441\u044f \u0430\u0434\u0434\u0437\u044f\u043b\u044f\u0446\u044c \u0413\u0430\u043b\u0430\u0432\u0443 \u0430\u0434 \u0426\u0435\u043b\u0430. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0431\u044b\u045e \u0431\u044b \u0442\u0430\u0434\u044b \u045e \u043f\u0430\u045e\u043d\u0430\u0446\u0435. \u0423\u0432\u0435\u0441\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0456\u0441\u043d\u0443\u0435 \u0431\u0435\u0437 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0456 \u045e\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u2013 \u0431\u0435\u0437 \u0425\u0440\u044b\u0441\u0442\u0430. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0441\u0451\u0439 \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u2013 \u0433\u044d\u0442\u044b\u044f \u0413\u0430\u043b\u0430\u0432\u0430 \u0456 \u0426\u0435\u043b\u0430, \u0442\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: \u00ab\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u045e\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437 \u043d\u0435\u0431\u0430 \u0441\u044b\u0448\u043e\u045e, \u2013 \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u00bb (\u042f\u043d 3, 13). \u0422\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u044b \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0435 \u0433\u0440\u0430\u0445\u0456.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042f\u043d 17, 20\u0430. 21a. 22. 18\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417\u0430 \u0456\u0445 \u043f\u0440\u0430\u0448\u0443, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e, \u044f\u043a \u0422\u044b, \u041e\u0439\u0447\u0430, \u0443\u0432\u0430 \u041c\u043d\u0435, \u0456 \u042f \u045e \u0422\u0430\u0431\u0435; \u0456 \u0441\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u0422\u044b \u0434\u0430\u045e \u041c\u043d\u0435, \u042f \u0434\u0430\u045e \u0456\u043c, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e, \u044f\u043a \u0456 \u041c\u044b \u0430\u0434\u043d\u043e, \u0456 \u0401\u043d \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f\u043a \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435 \u045e \u0441\u0432\u0435\u0442, \u0442\u0430\u043a \u0456 \u042f \u043f\u0430\u0441\u043b\u0430\u045e \u0456\u0445 \u0443 \u0441\u0432\u0435\u0442.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431 \u044f\u043d\u044b.&nbsp;<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"237","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0440\u0430\u043c\u043e\u0432\u0430 c\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio de incarnatione Verbi, 10: PG 25, 111-114)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0434\u043d\u0430\u0432\u0456 \u0434\u043d\u0456 \u043d\u0430\u0448\u044b\u044f, \u044f\u043a \u0434\u0430\u045e\u043d\u0435\u0439<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043b\u043e\u0432\u0430 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, \u0411\u043e\u0433, \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u0456\u0434\u0443\u0446\u044c \u043d\u0430 \u0437\u0430\u0433\u0443\u0431\u0443. \u041f\u0440\u0430\u0437 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0441\u043c\u0435\u0440\u0446\u044c, \u044f\u043a\u0430\u044f \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0430 \u043d\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456. \u0421\u0432\u0430\u0456\u043c \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435\u043c \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0456\u0445 \u043b\u0435\u0433\u043a\u0430\u0434\u0443\u043c\u043d\u0430\u0441\u0446\u044c; \u0441\u0432\u0430\u0451\u0439 \u0441\u0456\u043b\u0430\u0439 \u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044e \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u0443\u0432\u0435\u0441\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0440\u043e\u0434.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0447\u044b\u0442\u0430\u0446\u044c \u0442\u0432\u043e\u0440\u044b \u0442\u044d\u043e\u043b\u0430\u0433\u0430\u045e, \u0432\u0443\u0447\u043d\u044f\u045e \u0417\u0431\u0430\u0432\u0456\u0446\u0435\u043b\u044f, \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u045e \u0456\u0445 \u0430\u045e\u0442\u0430\u0440\u044b\u0442\u044d\u0446\u0435 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u044d\u043d\u043d\u0435 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u0430\u045e\u0434\u044b. \u042f\u043d\u044b \u043a\u0430\u0436\u0443\u0446\u044c: \u00ab\u041b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u0434\u0443\u043c\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0456\u0445, \u0442\u043e \u045e\u0441\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u0456. \u0401\u043d \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0456\u0445, \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u0432\u0435, \u0443\u0436\u043e \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0441\u044f\u0431\u0435 \u0436\u044b\u043b\u0456, \u0430 \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u0430\u0433\u0430 \u0437\u0430 \u0456\u0445 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u0430\u0433\u0430\u00bb (2 \u041a\u0430\u0440 5, 14-15). \u0406 \u0437\u043d\u043e\u045e: \u00ab\u041c\u044b \u0431\u0430\u0447\u044b\u043c \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u0456 \u0431\u044b\u045e \u043c\u0430\u043b\u0430 \u043c\u0435\u043d\u0448\u044b\u043c \u0430\u0434 \u0430\u043d\u0451\u043b\u0430\u045e, \u0443\u0432\u0435\u043d\u0447\u0430\u043d\u044b \u0441\u043b\u0430\u0432\u0430\u044e \u0456 \u043f\u0430\u0448\u0430\u043d\u0430\u044e, \u0431\u043e \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u0441\u043c\u0435\u0440\u0446\u044c, \u043a\u0430\u0431 \u0437 \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439 \u0437\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u0456\u00bb (\u0413\u0431\u0440 2, 9). \u0417\u0430\u0442\u044b\u043c \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c, \u0447\u0430\u043c\u0443 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u043c \u0431\u044b\u043b\u043e, \u043a\u0430\u0431 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c. \u00ab\u0411\u043e \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0434\u0437\u0435\u043b\u044f \u044f\u043a\u043e\u0433\u0430 \u045e\u0441\u0451 \u0456 \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u045e\u0441\u0451, \u044f\u043a\u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0434\u0430 \u0441\u043b\u0430\u0432\u044b \u043c\u043d\u043e\u0433\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u0443\u0447\u044b\u043d\u0456\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u043f\u0440\u0430\u0437 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456\u0445\u043d\u044f\u0433\u0430\u00bb (\u0413\u0431\u0440 2, 10). \u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043b\u044e\u0434\u0437\u0456 \u0431\u044b\u043b\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b\u044f \u0430\u0434 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u044e\u0447\u0430\u0439 \u0456\u0445 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456\u043c \u043d\u0430\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u043b\u0456 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0431 \u0442\u044b\u043c, \u0448\u0442\u043e \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430 \u043f\u0440\u044b\u043d\u044f\u043b\u043e \u0446\u0435\u043b\u0430 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043c\u0435\u045e \u0446\u0435\u043b\u0430, \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u042f\u0433\u043e \u0446\u0435\u043b\u0430, \u0437\u043d\u043e\u045e \u0442\u0430\u043a \u043a\u0430\u0436\u0430: \u00ab\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u0435\u0446\u0456 \u043c\u0430\u044e\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u0446\u0435\u043b\u0435 \u0456 \u043a\u0440\u044b\u0432\u0456, \u0442\u0430\u043c\u0443 \u045e \u0456\u0445 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0440\u044b\u043d\u044f\u045e \u0443\u0434\u0437\u0435\u043b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0415\u0437\u0443\u0441, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0456\u0437\u0440\u044b\u043d\u0443\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0434\u2019\u044f\u0431\u043b\u0430, \u043a\u0430\u0431 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u045e\u0441\u0451 \u0436\u044b\u0446\u0446\u0451 \u0431\u044b\u045e \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b \u0441\u0442\u0440\u0430\u0445\u0430\u043c \u043f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e\u00bb (\u0413\u0431\u0440 2, 14-15). \u0410\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e\u0448\u044b \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451, \u0401\u043d \u043f\u0430\u043a\u043b\u0430\u045e \u043a\u0430\u043d\u0435\u0446 \u0432\u044b\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u043c\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441 \u043f\u0440\u044b\u0441\u0443\u0434\u0443 \u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u043d\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u0434\u0430\u045e \u043d\u043e\u0432\u044b \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u043d\u0430\u0448\u0430\u043c\u0443 \u0436\u044b\u0446\u0446\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e \u044f\u043a \u0441\u043c\u0435\u0440\u0446\u044c \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u045e\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u0430\u0434 \u0441\u0430\u043c\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0442\u0430\u043a \u0456 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u0436\u044b\u0446\u0446\u044f \u0430\u0434\u0431\u044b\u043b\u043e\u0441\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0421\u043b\u043e\u0432\u0443 \u0411\u043e\u0433\u0430, \u044f\u043a\u043e\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u043c: \u00ab\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0442\u0430\u043a \u043f\u0440\u0430\u0437 \u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u2013 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. \u0411\u043e, \u044f\u043a \u0443 \u0410\u0434\u0430\u043c\u0435 \u045e\u0441\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0446\u044c, \u0442\u0430\u043a \u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u045e\u0441\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b\u00bb (1 \u041a\u0430\u0440 15, 21-22), \u0456 \u0434\u0430\u043b\u0435\u0439 \u0440\u0430\u0437\u0432\u0456\u0432\u0430\u0435 \u0433\u044d\u0442\u0443\u044e \u0442\u044d\u043c\u0443. \u041c\u044b \u043d\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u0435\u043c \u0443\u0436\u043e \u044f\u043a \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u044f \u043d\u0430 \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u0435, \u0430\u043b\u0435 \u0447\u0430\u043a\u0430\u0435\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u045e\u0441\u0456\u0445 \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0448\u0430\u043d\u044b. \u0411\u043e\u0433, \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0456 \u0414\u0430\u045e\u0446\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0430\u0440\u0443 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u045e \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0447\u0430\u0441.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0420\u044b\u043c 3, 23-25\u0430; 1 \u041a\u0430\u0440 15, 22\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0423\u0441\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0411\u043e\u0436\u0430\u0439 \u0441\u043b\u0430\u0432\u044b, \u0430\u043b\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435 \u0434\u0430\u0440\u043c\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u043f\u0440\u0430\u0437 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u042f\u0433\u043e \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0411\u043e\u0433 \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u045e \u042f\u0433\u043e\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f\u043a \u0443 \u0410\u0434\u0430\u043c\u0435 \u045e\u0441\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0446\u044c, \u0442\u0430\u043a \u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u045e\u0441\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u042f\u0433\u043e \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"241","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u044f \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 46, 1-2: CCL 41, 529-530)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u044b \u2013 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u0456 \u043f\u0430\u0441\u0442\u044b\u0440\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u043f\u0435\u0440\u0448\u044b \u0440\u0430\u0437 \u0432\u044b \u0447\u0443\u0435\u0446\u0435, \u0448\u0442\u043e \u045e\u0441\u044f \u043d\u0430\u0448\u0430\u044f \u043d\u0430\u0434\u0437\u0435\u044f \u2013 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u0456 \u0448\u0442\u043e \u0401\u043d \u0441\u0430\u043c \u2013 \u043d\u0430\u0448\u0430\u044f \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u044f \u0456 \u0437\u0431\u0430\u045e\u0447\u0430\u044f \u0445\u0432\u0430\u043b\u0430. \u0412\u044b \u045e \u0430\u045e\u0447\u0430\u0440\u043d\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0446\u0435\u0440\u0430\u0436\u044d \u0456 \u043f\u0430\u0441\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044c. \u0410\u043b\u0435 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0456\u0441\u043d\u0443\u044e\u0446\u044c \u0442\u0430\u043a\u0456\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b, \u044f\u043a\u0456\u044f \u0445\u043e\u0447\u0443\u0446\u044c \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u0446\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456, \u0430\u043b\u0435 \u043d\u0435 \u0445\u043e\u0447\u0443\u0446\u044c \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0456 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e, \u043f\u0440\u044b\u0433\u0430\u0434\u0430\u0435\u043c \u0441\u043b\u043e\u0432\u044b, \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u044f \u0456\u043c \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c. \u0422\u0430\u043c\u0443 \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u045e\u0432\u0430\u0436\u043b\u0456\u0432\u0430, \u0430 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0437 \u0431\u043e\u044f\u0437\u0437\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041f\u0430\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u0430: \u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u043f\u0440\u0430\u0440\u043e\u0447 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043f\u0440\u0430\u0440\u043e\u0447 \u0456 \u0441\u043a\u0430\u0436\u044b \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u00bb (\u042d\u0437\u0445 34, 2). \u0422\u043e\u043b\u044c\u043a\u0456 \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u0447\u0443\u043b\u0456 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442 \u0456 \u0442\u0430\u043c\u0443 \u0432\u044b\u0440\u0430\u0448\u044b\u043b\u0456 \u043f\u0430\u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0437 \u0432\u0430\u043c\u0456 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430. \u0411\u043e\u0433 \u0434\u0430\u043f\u0430\u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u0443, \u043a\u0430\u043b\u0456 \u043c\u044b \u043d\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u0435\u043c \u0448\u0443\u043a\u0430\u0446\u044c \u044f\u0435 \u045e \u0441\u0430\u0431\u0435. \u041a\u0430\u043b\u0456 \u0431 \u043c\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0441\u0432\u0430\u0451 \u0432\u0443\u0447\u044d\u043d\u043d\u0435, \u043c\u044b \u0431\u044b\u043b\u0456 \u0431 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u043f\u0430\u0441\u0432\u044f\u0446\u044c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u0430 \u043d\u0435 \u0430\u0432\u0435\u0447\u0430\u043a. \u041a\u0430\u043b\u0456 \u0436 \u043c\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u042f\u0433\u043e \u0432\u0443\u0447\u044d\u043d\u043d\u0435, \u0401\u043d \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0432\u0430\u0448\u044b\u043c \u041f\u0430\u0441\u0442\u044b\u0440\u0430\u043c, \u043a\u0456\u043c \u0431\u044b \u043d\u0456 \u0431\u044b\u045e \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a. \u00ab\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u201c\u0413\u043e\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456\u044f \u043f\u0430\u0441\u0432\u0456\u043b\u0456 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435! \u0425\u0456\u0431\u0430 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u0441\u0442\u044b\u0440\u044b \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a?\u201d\u00bb (\u042d\u0437\u0445 34, 2). \u0413\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0430\u0432\u0435\u0447\u0430\u043a. \u0406 \u0433\u044d\u0442\u0430 \u043f\u0435\u0440\u0448\u0430\u044f \u043f\u0440\u044b\u0447\u044b\u043d\u0430, \u0447\u0430\u043c\u0443 \u043f\u0430\u0441\u0442\u044b\u0440\u044b \u0447\u0443\u044e\u0446\u044c \u0434\u0430\u043a\u043e\u0440\u044b; \u044f\u043d\u044b \u043f\u0430\u0441\u0432\u044f\u0446\u044c \u0441\u044f\u0431\u0435, \u0430 \u043d\u0435 \u0430\u0432\u0435\u0447\u0430\u043a. \u0425\u0442\u043e \u0436 \u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u043f\u0430\u0441\u0432\u044f\u0446\u044c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435? \u0413\u044d\u0442\u0430 \u0442\u044b\u044f, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: \u00ab\u0423\u0441\u0435 \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e, \u0430 \u043d\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430\u00bb (\u0424\u043b\u043f 2, 21).<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041c\u044b \u0436, \u043a\u0430\u0433\u043e \u041f\u0430\u043d \u0443 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456, \u0430 \u043d\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043d\u0430\u0448\u044b\u043c \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u043c, \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043d\u0430 \u043c\u0435\u0441\u0446\u044b, \u044f\u043a\u043e\u0435 \u0430\u0431\u0430\u0432\u044f\u0437\u0432\u0430\u0435 \u0434\u0430\u0446\u044c \u0446\u044f\u0436\u043a\u0456 \u0440\u0430\u0445\u0443\u043d\u0430\u043a, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0434\u0437\u0432\u0435 \u0441\u043f\u0440\u0430\u0432\u044b: \u043f\u0430-\u043f\u0435\u0440\u0448\u0430\u0435, \u0448\u0442\u043e \u043c\u044b \u2013 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435, \u043f\u0430-\u0434\u0440\u0443\u0433\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u2013 \u043f\u0430\u0441\u0442\u044b\u0440\u044b. \u0422\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435, \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0441\u0430\u043c\u0456\u0445; \u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u0441\u0442\u044b\u0440\u044b, \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0432\u0430\u0441. \u042f\u043a \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0430 \u044f\u043a \u043f\u0430\u0441\u0442\u044b\u0440\u044b, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u0430 \u043f\u0440\u0430 \u0432\u0430\u0448\u0430\u0435 \u0434\u0430\u0431\u0440\u043e.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0401\u0441\u0446\u044c \u0448\u043c\u0430\u0442 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e, \u044f\u043a\u0456\u044f \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456. \u042f\u043d\u044b \u0456\u0434\u0443\u0446\u044c \u0434\u0430 \u0411\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043b\u0451\u0433\u043a\u0456\u043c, \u044f\u043a \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u0448\u043b\u044f\u0445\u0430\u043c \u0456 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0445\u0443\u0442\u043a\u0430, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u044f\u0441\u0443\u0446\u044c \u043c\u0435\u043d\u0448\u044b \u0446\u044f\u0436\u0430\u0440. \u0410 \u043c\u044b, \u044f\u043a \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0434\u0430\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u0430\u0437\u0434\u0430\u0447\u0443 \u0430\u0431 \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0456; \u0430\u043b\u0435 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043f\u0430\u0441\u0442\u044b\u0440\u044b, \u0442\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430\u0432\u0430\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u0430\u0437\u0434\u0430\u0447\u0443 \u0430\u0431 \u043d\u0430\u0448\u044b\u043c \u043f\u0430\u0441\u0442\u044b\u0440\u0441\u0442\u0432\u0435.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 23 (22), 1-2\u0430. 3b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041f\u0430\u043d \u2013 \u043f\u0430\u0441\u0442\u044b\u0440 \u043c\u043e\u0439, \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u0431\u0443\u0434\u0443 \u043c\u0435\u0446\u044c \u043d\u044f\u0441\u0442\u0430\u0447\u044b. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0401\u043d \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c \u043c\u043d\u0435 \u043d\u0430 \u0437\u044f\u043b\u0451\u043d\u044b\u0445 \u043f\u0430\u0448\u0430\u0445.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435 \u043c\u044f\u043d\u0435 \u043d\u0430 \u0441\u0446\u0435\u0436\u043a\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0434\u0437\u0435\u043b\u044f \u0406\u043c\u044f \u0441\u0432\u0430\u0439\u0433\u043e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0401\u043d.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"242","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 46, 3-4: CCL 41, 530-531)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u0441\u0442\u044b\u0440\u044b, \u044f\u043a\u0456\u044f \u043f\u0430\u0441\u0432\u044f\u0446\u044c \u0441\u0430\u043c\u044b\u0445 \u0441\u044f\u0431\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u043c, \u0448\u0442\u043e \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u043a\u0430\u0436\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c, \u044f\u043a\u0456\u044f \u043f\u0430\u0441\u0443\u0446\u044c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u0430 \u043d\u0435 \u0430\u0432\u0435\u0447\u0430\u043a: \u00ab\u0412\u044b \u0435\u043b\u0456 \u0442\u0443\u043a, \u0430\u043f\u0440\u0430\u043d\u0430\u043b\u0456\u0441\u044f \u045e \u0432\u043e\u045e\u043d\u0443 \u0456 \u0440\u044d\u0437\u0430\u043b\u0456 \u0430\u0434\u043a\u043e\u0440\u043c\u043b\u0435\u043d\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u0441\u0432\u0456\u043b\u0456 \u0441\u0442\u0430\u0442\u0430\u043a. \u0412\u044b \u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u043b\u0456 \u0441\u043b\u0430\u0431\u044b\u0445 \u0456 \u043d\u0435 \u043b\u044f\u0447\u044b\u043b\u0456 \u0445\u0432\u043e\u0440\u0430\u0439, \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u0430\u0439 \u043d\u0435 \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0432\u0430\u043b\u0456 \u0456 \u043d\u0435 \u0432\u044f\u0440\u0442\u0430\u043b\u0456 \u0442\u043e\u0439, \u0448\u0442\u043e \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0430, \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u0430\u0439 \u0432\u044b \u043d\u0435 \u0448\u0443\u043a\u0430\u043b\u0456, \u0430\u043b\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u043d\u0430\u0434 \u0456\u043c\u0456 \u0441\u0456\u043b\u0430\u044e \u0456 \u0433\u0432\u0430\u043b\u0442\u0430\u043c. \u0420\u0430\u0441\u0441\u0435\u044f\u043b\u0456\u0441\u044f \u0430\u0432\u0435\u0447\u043a\u0456 \u041c\u0430\u0435, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u045e \u0456\u0445 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u00bb (\u042d\u0437\u0445 34, 3-5).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u0442\u044b\u0440\u0430\u043c, \u044f\u043a\u0456\u044f \u043f\u0430\u0441\u0432\u044f\u0446\u044c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u0430 \u043d\u0435 \u0430\u0432\u0435\u0447\u0430\u043a, \u0432\u044b\u0448\u044d\u0439\u0441\u043a\u0430\u0437\u0430\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u044f\u043d\u044b \u043b\u044e\u0431\u044f\u0446\u044c \u0456 \u0448\u0442\u043e \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u044e\u0446\u044c. \u0428\u0442\u043e \u0436 \u044f\u043d\u044b \u043b\u044e\u0431\u044f\u0446\u044c? \u00ab\u0412\u044b \u0435\u043b\u0456 \u0442\u0443\u043a, \u0430\u043f\u0440\u0430\u043d\u0430\u043b\u0456\u0441\u044f \u045e \u0432\u043e\u045e\u043d\u0443\u00bb. \u041f\u0440\u0430 \u0442\u043e\u0435 \u0436 \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: \u00ab\u0425\u0442\u043e \u0441\u0430\u0434\u0437\u0456\u0446\u044c \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u0456 \u043d\u0435 \u0435\u0441\u0446\u044c \u044f\u0433\u043e \u043f\u043b\u0430\u0434\u043e\u045e? \u0410\u0431\u043e \u0445\u0442\u043e \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0441\u0442\u0430\u0442\u0430\u043a \u0456 \u043d\u0435 \u0435\u0441\u0446\u044c \u043c\u0430\u043b\u0430\u043a\u0430 \u0430\u0434 \u0441\u0442\u0430\u0442\u043a\u0443?\u00bb (1 \u041a\u0430\u0440 9, 7). \u0422\u0430\u043c\u0443 \u043c\u044b \u0431\u0430\u0447\u044b\u043c, \u0448\u0442\u043e \u00ab\u043c\u0430\u043b\u0430\u043a\u043e \u0430\u0434 \u0441\u0442\u0430\u0442\u043a\u0443\u00bb \u2013 \u0433\u044d\u0442\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0430\u0445\u0432\u044f\u0440\u0443\u0435 \u0411\u043e\u0436\u044b \u043d\u0430\u0440\u043e\u0434 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u0434\u043b\u044f \u0456\u0445 \u0443\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0443 \u0441\u043b\u043e\u0432\u0430\u0445, \u044f\u043a\u0456\u044f \u0432\u044b\u0448\u044d\u0439 \u044f \u0437\u0433\u0430\u0434\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u0445\u043e\u0446\u044c \u0456 \u0436\u0430\u0434\u0430\u045e \u0443\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u0446\u0430 \u0437 \u043f\u0440\u0430\u0446\u044b \u0441\u0432\u0430\u0456\u0445 \u0440\u0443\u043a \u0456 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u043d\u0435 \u0448\u0443\u043a\u0430\u045e \u043c\u0430\u043b\u0430\u043a\u0430 \u0430\u0434 \u0430\u0432\u0435\u0447\u0430\u043a, \u0430\u0434\u043d\u0430\u043a \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u043c\u0430\u0435 \u043f\u0440\u0430\u0432\u0430 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0430\u0434 \u0441\u0442\u0430\u0442\u043a\u0443, \u0456 \u0448\u0442\u043e \u041f\u0430\u043d \u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e, \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0436\u044b\u043b\u0456 \u0437 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 9, 14). \u0422\u0430\u043c\u0443 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435, \u0448\u0442\u043e \u0456\u043d\u0448\u044b\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0433\u044d\u0442\u044b\u043c \u043f\u0440\u0430\u0432\u0430\u043c, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u0456\u043c \u0434\u0430\u0434\u0437\u0435\u043d\u0430, \u0430 \u043d\u0435 \u043f\u0440\u044b\u045e\u043b\u0430\u0448\u0447\u0430\u043d\u0430. \u0410\u0434\u043d\u0430\u043a \u041f\u0430\u0432\u0435\u043b \u0443\u0447\u044b\u043d\u0456\u045e \u0431\u043e\u043b\u044c\u0448\u0430\u0435; \u0451\u043d \u043d\u0430\u0432\u0430\u0442 \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u045e \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u044f\u043c\u0443 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430. \u041f\u0430\u0432\u0435\u043b \u0434\u0430\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d, \u0445\u043e\u0446\u044c \u0456\u043d\u0448\u044b\u044f \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u043b\u0456 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c; \u0451\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0431\u043e\u043b\u044c\u0448. \u041c\u0430\u0433\u0447\u044b\u043c\u0430 \u0433\u044d\u0442\u0430 \u044f\u0433\u043e \u045e\u044f\u045e\u043b\u044f\u045e \u0442\u043e\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0445\u0432\u043e\u0440\u0430\u0433\u0430 \u045e \u0434\u043e\u043c \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0443: \u00ab\u041f\u0430\u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0441\u044f \u0430\u0431 \u0456\u043c. \u0410 \u043a\u0430\u043b\u0456 \u043f\u0430\u0442\u0440\u0430\u0446\u0456\u0448 \u0431\u043e\u043b\u044c\u0448, \u044f \u0430\u0434\u0434\u0430\u043c \u0442\u0430\u0431\u0435, \u043a\u0430\u043b\u0456 \u0432\u044f\u0440\u043d\u0443\u0441\u044f\u00bb (\u041b\u043a 10, 35).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0442\u043e \u0436 \u044f\u0448\u0447\u044d \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0435 \u043c\u0430\u043b\u0430\u043a\u0430 \u0430\u0434 \u0441\u0442\u0430\u0442\u043a\u0443? \u042f\u043d\u044b \u0431\u043e\u043b\u044c\u0448 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u044f, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u0443 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u042f\u043d\u044b \u043c\u043e\u0433\u0443\u0446\u044c \u0442\u0430\u043a \u0440\u0430\u0431\u0456\u0446\u044c, \u0430 \u043a\u0430\u043b\u0456 \u043c\u043e\u0433\u0443\u0446\u044c, \u0442\u043e \u0456 \u0440\u043e\u0431\u044f\u0446\u044c. \u042f\u043d\u044b \u0433\u043e\u0434\u043d\u044b\u044f \u043f\u0430\u0445\u0432\u0430\u043b\u044b, \u0430\u043b\u0435 \u0456 \u0442\u044b\u044f \u043d\u0435 \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0434\u0430\u043a\u043e\u0440\u0430\u045e. \u0411\u043e \u0456 \u0441\u0430\u043c \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u045e \u0434\u0430\u0440\u043e\u045e. \u0401\u043d \u043f\u0440\u0430\u0433\u043d\u0443\u045e, \u043a\u0430\u0431 \u0430\u0432\u0435\u0447\u043a\u0456 \u0431\u044b\u043b\u0456 \u043f\u043b\u043e\u0434\u043d\u044b\u044f \u0456 \u043d\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043b\u0456\u0448\u043a\u0443 \u043c\u0430\u043b\u0430\u043a\u0430.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0437\u0445 34, 15-16&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a \u041c\u0430\u0456\u0445 \u0456 c\u0430\u043c \u0431\u0443\u0434\u0443 \u045e\u043a\u043b\u0430\u0434\u0432\u0430\u0446\u044c \u0456\u0445 \u043d\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0417\u0433\u0443\u0431\u043b\u0435\u043d\u0443\u044e \u0430\u0434\u0448\u0443\u043a\u0430\u044e, \u0437\u0432\u0435\u0434\u0437\u0435\u043d\u0443\u044e \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u043d\u0430\u0437\u0430\u0434, \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u0443\u044e \u043f\u0435\u0440\u0430\u0432\u044f\u0436\u0443.&nbsp;<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410\u0441\u043b\u0430\u0431\u043b\u0443\u044e \u043f\u0430\u0434\u043c\u0430\u0446\u0443\u044e, \u0430 \u0442\u043b\u0443\u0441\u0442\u0443\u044e \u0456 \u043c\u043e\u0446\u043d\u0443\u044e \u0431\u0443\u0434\u0443 \u0441\u0446\u0435\u0440\u0430\u0433\u0447\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0417\u0433\u0443\u0431\u043b\u0435\u043d\u0443\u044e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"243","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 46, 4-5: CCL 41, 531-533)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u044b\u043a\u043b\u0430\u0434 \u041f\u0430\u045e\u043b\u0430<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0430\u0434\u043d\u043e\u0439\u0447\u044b \u041f\u0430\u0432\u0435\u043b, \u0431\u0443\u0434\u0443\u0447\u044b \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u044b \u0437\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u0430\u0434\u0447\u0443\u0432\u0430\u045e \u043d\u044f\u0441\u0442\u0430\u0447\u0443, \u0431\u0440\u0430\u0442\u044b \u043f\u0430\u0441\u043b\u0430\u043b\u0456 \u044f\u043c\u0443 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0435, \u043a\u0430\u0431 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0456\u0446\u044c \u044f\u0433\u043e \u043f\u0430\u0442\u0440\u044d\u0431\u044b. \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u0434\u044b \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u043f\u0430\u0434\u0437\u044f\u043a\u0456: \u00ab\u042f \u0432\u0435\u043b\u044c\u043c\u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u045e \u041f\u0430\u043d\u0443, \u0448\u0442\u043e \u0432\u044b \u0437\u043d\u043e\u045e \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0435\u0441\u044f \u043f\u0440\u0430 \u043c\u044f\u043d\u0435. \u0410\u043b\u0435 \u044f \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u0431\u044b\u0446\u044c \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0435\u043d\u044b\u043c \u0442\u044b\u043c, \u0448\u0442\u043e \u045e \u043c\u044f\u043d\u0435 \u0451\u0441\u0446\u044c. \u042f \u045e\u043c\u0435\u044e \u0431\u044b\u0446\u044c \u0456 \u045e \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0456, \u0443\u043c\u0435\u044e \u0431\u044b\u0446\u044c \u0456 \u045e \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u0443. \u0423\u0441\u0451 \u043c\u0430\u0433\u0443 \u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043c\u044f\u043d\u0435 \u045e\u0437\u043c\u0430\u0446\u043d\u044f\u0435. \u0410\u0434\u043d\u0430\u043a \u0432\u044b \u0434\u043e\u0431\u0440\u0430 \u0437\u0440\u0430\u0431\u0456\u043b\u0456, \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u0456\u045e\u0448\u044b \u0441\u0430 \u043c\u043d\u043e\u044e \u043c\u0430\u0451 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435\u00bb (\u043f\u0430\u0440. \u0424\u043b\u043f 4, 10-14).<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041a\u0430\u0431 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c, \u0447\u0430\u0433\u043e \u041f\u0430\u0432\u0435\u043b \u0448\u0443\u043a\u0430\u0435 \u045e \u0456\u0445\u043d\u0456\u043c \u0434\u043e\u0431\u0440\u044b\u043c \u0443\u0447\u044b\u043d\u043a\u0443, \u0456 \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u0446\u044c \u0443 \u043b\u0456\u043a\u0443 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u0430 \u043d\u0435 \u0430\u0432\u0435\u0447\u0430\u043a, \u0451\u043d, \u0430\u0434\u043d\u0430\u043a, \u043d\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435, \u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0456\u0445 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u0456. \u0427\u0430\u0433\u043e \u0436 \u0451\u043d \u0448\u0443\u043a\u0430\u045e \u0443 \u0456\u0445\u043d\u0456\u043c \u0443\u0447\u044b\u043d\u043a\u0443? \u00ab\u041d\u0435 \u0448\u0443\u043a\u0430\u044e \u0434\u0430\u0440\u0443, \u2013 \u043a\u0430\u0436\u0430, \u2013 \u0430\u043b\u0435 \u0448\u0443\u043a\u0430\u044e \u043f\u043b\u0451\u043d\u0443\u00bb. \u041d\u0435 \u0448\u0443\u043a\u0430\u0435 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0441\u0430\u043c\u043e\u043c\u0443 \u0436\u044b\u0446\u044c \u0443 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u0443, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043f\u043b\u0451\u043d\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u044b\u044f \u0436, \u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u044f\u043a \u041f\u0430\u0432\u0435\u043b, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u045e\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u0446\u0430 \u0437 \u043f\u0440\u0430\u0446\u044b \u0441\u0432\u0430\u0456\u0445 \u0440\u0443\u043a, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u043c\u0430\u043b\u0430\u043a\u043e \u0430\u0434 \u0430\u0432\u0435\u0447\u0430\u043a, \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u044c\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0435 \u043f\u0456\u043b\u044c\u043d\u044b\u044f \u043f\u0430\u0442\u0440\u044d\u0431\u044b, \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0447\u044b, \u0430\u0434\u043d\u0430\u043a, \u043f\u0440\u0430 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0430\u043b\u0435 \u043d\u044f\u0445\u0430\u0439 \u043d\u044f\u0441\u0443\u0446\u044c \u043b\u044e\u0434\u0437\u044f\u043c \u0441\u043b\u043e\u0432\u044b \u043f\u0440\u0430\u045e\u0434\u044b. \u042f\u043d\u044b \u0431\u044b\u0446\u0446\u0430\u043c \u0441\u0432\u0435\u0442\u0430\u0447\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u041d\u044f\u0445\u0430\u0439 \u0441\u0446\u0451\u0433\u043d\u044b \u0432\u0430\u0448\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u043d\u044b\u044f \u0456 \u0441\u0432\u0435\u0442\u0430\u0447\u044b \u0437\u0430\u043f\u0430\u043b\u0435\u043d\u044b\u044f\u00bb (\u041b\u043a 12, 35). \u0410 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u00ab\u0417\u0430\u043f\u0430\u043b\u0456\u045e\u0448\u044b \u0441\u0432\u0435\u0442\u0430\u0447, \u043d\u0435 \u0441\u0442\u0430\u0432\u044f\u0446\u044c \u044f\u0433\u043e \u043f\u0430\u0434 \u043f\u0430\u0441\u0443\u0434\u0437\u0456\u043d\u0430\u0439, \u0430\u043b\u0435 \u043d\u0430 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0443, \u0456 \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u0443\u0441\u0456\u043c, \u0445\u0442\u043e \u045e \u0434\u043e\u043c\u0435. \u041d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u043b\u043e \u0432\u0430\u0448\u0430 \u0442\u0430\u043a \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0432\u0430\u0448\u044b \u0434\u043e\u0431\u0440\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u0410\u0439\u0446\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u044f\u043a\u0456 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445\u00bb (\u041c\u0446 5, 15-16).<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u045e \u0434\u043e\u043c\u0435 \u0437\u0430\u043f\u0430\u043b\u0456\u0446\u044c \u043b\u044f\u043c\u043f\u0443, \u0442\u043e \u0446\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u043b\u0456\u0432\u0430\u0446\u044c \u0430\u043b\u0435\u0439, \u043a\u0430\u0431 \u044f\u043d\u0430 \u043d\u0435 \u043f\u0430\u0433\u0430\u0441\u043b\u0430? \u0411\u043e \u043a\u0430\u043b\u0456 \u0431 \u043b\u044f\u043c\u043f\u0430 \u0437 \u0430\u043b\u0435\u0435\u043c \u043d\u0435 \u0441\u0432\u044f\u0446\u0456\u043b\u0430, \u0442\u043e \u044f\u0435 \u043d\u0435 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u0431 \u043d\u0430 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0443, \u0430\u043b\u0435 \u0432\u044b\u043a\u0456\u043d\u0443\u043b\u0456 \u0431 \u044f\u0435. \u0422\u0430\u043c\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0435 \u0441\u0440\u043e\u0434\u043a\u0430\u045e \u0434\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u2013 \u0433\u044d\u0442\u0430 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430, \u0456\u0445 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u2013 \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u043b\u044e\u0431\u043e\u0432\u0456. \u0410\u043b\u0435 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0432\u044b\u0441\u0442\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u043f\u0440\u043e\u0434\u0430\u0436 \u0456 \u043a\u0430\u0448\u0442\u0443\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u043a\u043e\u043b\u044c\u043a\u0456 \u043a\u0430\u0448\u0442\u0443\u0435 \u0445\u0430\u0440\u0447 \u0434\u043b\u044f \u044f\u0435 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e. \u041a\u0430\u043b\u0456 \u0431 \u044f\u0435 \u0442\u0430\u043a \u043f\u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456, \u0442\u043e \u0437\u0430 \u043d\u0456\u0437\u043a\u0456 \u043a\u043e\u0448\u0442 \u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0431 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0440\u044d\u0447. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043b\u0435\u043f\u0448 \u044f\u0435 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0434\u043b\u044f \u045e\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f, \u0430 \u0430\u0434 \u041f\u0430\u043d\u0430 \u2013 \u043f\u043b\u0430\u0442\u0443 \u0437\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435. \u0411\u043e \u043d\u0430\u0440\u043e\u0434 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043d\u0430\u043b\u0435\u0436\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u043c\u0443 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u0430\u0434 \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u043f\u043b\u0430\u0442\u044b, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0430\u0434 \u043a\u0430\u0433\u043e \u045e\u0441\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0446\u0446\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u0447\u0430\u043c\u0443 \u0436 \u0456\u0445 \u0430\u0441\u0443\u0434\u0436\u0430\u044e\u0446\u044c, \u0447\u0430\u043c\u0443 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u044e\u0446\u044c? \u0422\u0430\u043c\u0443, \u0448\u0442\u043e \u043f\u2019\u044e\u0447\u044b \u043c\u0430\u043b\u0430\u043a\u043e \u0456 \u0430\u043f\u0440\u0430\u043d\u0430\u044e\u0447\u044b \u0432\u043e\u045e\u043d\u0443, \u044f\u043d\u044b \u0437\u0430\u0431\u044b\u0432\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u0430\u0432\u0435\u0447\u0430\u043a. \u0428\u0443\u043a\u0430\u044e\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0432\u0430\u0451\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u0430 \u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">2 \u041a\u0430\u0440 12, 14b-15\u0430; \u0424\u043b\u043f 2, 17\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u0448\u0443\u043a\u0430\u044e \u043d\u0435 \u0432\u0430\u0448\u0430\u0433\u0430, \u0430\u043b\u0435 \u0432\u0430\u0441, \u0431\u043e \u043d\u0435 \u0434\u0437\u0435\u0446\u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0431\u0456\u0440\u0430\u0446\u044c \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u0434\u043b\u044f \u0431\u0430\u0446\u044c\u043a\u043e\u045e, \u0430\u043b\u0435 \u0431\u0430\u0446\u044c\u043a\u0456 \u0434\u043b\u044f \u0434\u0437\u044f\u0446\u0435\u0439. \u042f \u0432\u0435\u043b\u044c\u043c\u0456 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0430\u043d\u044f\u0441\u0443 \u0432\u044b\u0434\u0430\u0442\u043a\u0456 <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0430\u0434\u0434\u0430\u043c \u0437\u0430 \u0434\u0443\u0448\u044b \u0432\u0430\u0448\u044b\u044f.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0456 \u043f\u0440\u0430\u043b\u044c\u044e\u0441\u044f \u044f\u043a \u0430\u0445\u0432\u044f\u0440\u0430 \u043d\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0432\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u044b, \u0442\u043e \u0440\u0430\u0434\u0443\u044e\u0441\u044f \u0456 \u0446\u0435\u0448\u0443\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0443\u0441\u0456\u043c\u0456 \u0432\u0430\u043c\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u043d\u0430\u0432\u0430\u0442.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"244","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 46, 6-7: CCL 41, 533-534)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u043e\u0436\u043d\u044b \u043d\u044f\u0445\u0430\u0439 \u0448\u0443\u043a\u0430\u0435 \u043d\u0435 \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u045e\u0436\u043e \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u043b\u0456, \u0448\u0442\u043e \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u00ab\u043f\u0456\u0446\u044c \u043c\u0430\u043b\u0430\u043a\u043e\u00bb, \u0442\u043e \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u043c \u0446\u044f\u043f\u0435\u0440, \u0448\u0442\u043e \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u00ab\u0430\u043f\u0440\u0430\u043d\u0430\u0446\u0446\u0430 \u045e \u0432\u043e\u045e\u043d\u0443\u00bb. \u0414\u0430\u0432\u0430\u0446\u044c \u043c\u0430\u043b\u0430\u043a\u043e \u2013 \u0433\u044d\u0442\u0430 \u0434\u0430\u0432\u0430\u0446\u044c \u043d\u0430 \u045e\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0435, \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u0432\u0430\u0446\u044c \u0432\u043e\u045e\u043d\u0430\u0439 \u2013 \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043f\u0430\u0432\u0430\u0436\u0430\u0446\u044c. \u0422\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u0430 \u043d\u0435 \u0430\u0432\u0435\u0447\u0430\u043a, \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0446\u044c \u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0443 \u0433\u044d\u0442\u044b\u0445 \u0434\u0437\u0432\u044e\u0445 \u0440\u044d\u0447\u0430\u045e: \u043a\u0430\u0431 \u044f\u043d\u044b \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u044c\u0432\u0430\u043b\u0456 \u0456\u0445 \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u0434\u044b \u043a\u0430\u0431 \u043f\u0430\u0432\u0430\u0436\u0430\u043b\u0456 \u0456\u0445 \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0432\u0430\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u043b\u0451\u0433\u043a\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0448\u0442\u043e \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043f\u0430\u0432\u0430\u0433\u0443, \u0431\u043e \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0433\u0430\u0442\u0443. \u041a\u043e\u0436\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043c\u0430\u0435 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u044b. \u0406 \u043a\u0456\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044f\u0434\u0437\u0435 \u0432\u0430\u0441, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u0430\u043a\u0456\u043c \u0436\u0430, \u044f\u043a \u0456 \u0432\u044b? \u0401\u043d \u043c\u0430\u0435 \u0446\u0435\u043b\u0430, \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b, \u0435\u0441\u0446\u044c, \u0441\u043f\u0456\u0446\u044c \u0456 \u045e\u0441\u0442\u0430\u0435; \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0456 \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043f\u0430\u043c\u0440\u044d. \u041a\u0430\u043b\u0456 \u0442\u044b \u0437\u0430\u0434\u0443\u043c\u0430\u0435\u0448\u0441\u044f, \u043a\u0456\u043c \u0451\u043d \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0430\u043c \u043f\u0430 \u0441\u0430\u0431\u0435, \u0430\u0434\u043a\u0430\u0436\u0430\u0448: \u0451\u043d \u2013 \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0448 \u044f\u043c\u0443 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0443\u044e \u043f\u0430\u0432\u0430\u0433\u0443, \u0442\u043e \u0431\u044b\u0446\u0446\u0430\u043c \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435\u0448 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043b\u0430\u0431\u043e\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 9pt; text-align: justify;\"><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0441\u0430\u043c \u041f\u0430\u0432\u0435\u043b \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0442\u0430\u043a\u043e\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0430\u0434 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0423 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456 \u0432\u0430\u0448\u044b\u043c \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043c\u0430\u0451\u0439 \u0445\u0432\u0430\u0440\u043e\u0431\u044b \u0432\u044b \u043d\u0435 \u0430\u0434\u043a\u0456\u043d\u0443\u043b\u0456 \u043c\u044f\u043d\u0435, \u0430\u043b\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u044f\u043a \u0411\u043e\u0436\u0430\u0433\u0430 \u0430\u043d\u0451\u043b\u0430, \u044f\u043a \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 (\u2026) \u0421\u0432\u0435\u0434\u0447\u0443 \u0432\u0430\u043c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0431 \u0431\u044b\u043b\u043e \u043c\u043e\u0436\u043d\u0430, \u0432\u044b \u0432\u044b\u0440\u0432\u0430\u043b\u0456 \u0431 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0456 \u0430\u0434\u0434\u0430\u043b\u0456 \u043c\u043d\u0435\u00bb (\u0413\u0430\u043b 4, 14. 15). \u0410\u0434\u043d\u0430\u043a, \u0441\u043f\u0430\u0437\u043d\u0430\u045e\u0448\u044b \u0442\u0430\u043a\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043f\u0430\u0448\u0430\u043d\u0443, \u0446\u0456 \u0436 \u0451\u043d \u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u0431\u043b\u0443\u043a\u0430\u044e\u0447\u044b\u0445 \u0437 \u0431\u043e\u044f\u0437\u0456, \u0448\u0442\u043e \u0437\u0433\u0443\u0431\u0456\u0446\u044c \u043f\u0430\u0448\u0430\u043d\u0443 \u0446\u0456 \u0448\u0442\u043e \u044f\u0433\u043e \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u0435\u043d\u0448 \u0445\u0432\u0430\u043b\u0456\u0446\u044c, \u043a\u0430\u043b\u0456 \u0451\u043d \u0456\u0445 \u0437\u0433\u0430\u043d\u0456\u0446\u044c? \u041a\u0430\u043b\u0456 \u0431 \u0451\u043d \u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0456\u045e, \u0430\u043f\u044b\u043d\u0443\u045e\u0441\u044f \u0431 \u0441\u044f\u0440\u043e\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0441\u0435 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u043d\u0435 \u0430\u0432\u0435\u0447\u0430\u043a. \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0431\u044b \u0442\u0430\u0434\u044b \u0441\u0430\u0431\u0435: \u00ab\u042f\u043a\u0430\u044f \u043c\u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u0430 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430? \u041d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0440\u043e\u0431\u0456\u0446\u044c, \u0448\u0442\u043e \u0445\u043e\u0447\u0430: \u044f \u043c\u0430\u044e \u045e\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0435, \u043c\u0430\u044e \u043f\u0430\u0448\u0430\u043d\u0443; \u043c\u0430\u043b\u0430\u043a\u0430 \u0456 \u0432\u043e\u045e\u043d\u044b \u043c\u043d\u0435 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430; \u043d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0456\u0434\u0437\u0435, \u043a\u0443\u0434\u044b \u0436\u0430\u0434\u0430\u0435\u00bb. \u0414\u0443\u043c\u0430\u0435\u0448, \u0448\u0442\u043e \u0442\u044b \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b, \u043a\u0430\u043b\u0456 \u043a\u043e\u0436\u043d\u044b \u043f\u043e\u0439\u0434\u0437\u0435, \u043a\u0443\u0434\u044b \u043f\u0430\u0436\u0430\u0434\u0430\u0435? \u041d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u0446\u044c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c, \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0442\u044b \u043d\u0430\u043b\u0435\u0436\u044b\u0448 \u0434\u0430 \u0430\u045e\u0447\u0430\u0440\u043d\u0456: \u00ab\u041a\u0430\u043bi \u0446\u0435\u0440\u043fi\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0447\u043b\u0435\u043d, \u0446\u0435\u0440\u043f\u044f\u0446\u044c \u0437 \u0456\u043c \u0443\u0441\u0435 \u0447\u043b\u0435\u043d\u044b\u00bb (1 \u041a\u0430\u0440 12, 26).<\/span><\/p>\r\n<p style=\"text-indent: 9pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u0443\u0437\u0433\u0430\u0434\u0432\u0430\u044e\u0447\u044b, \u044f\u043a\u0456\u043c\u0456 \u0431\u044b\u043b\u0456 \u0456\u043d\u0448\u044b\u044f \u0434\u0430 \u044f\u0433\u043e, \u043d\u0435 \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u043b\u0430, \u0448\u0442\u043e \u0451\u043d \u0437\u0430\u0431\u044b\u045e \u043f\u0440\u0430 \u0430\u043a\u0430\u0437\u0430\u043d\u0443\u044e \u044f\u043c\u0443 \u043f\u0430\u0432\u0430\u0433\u0443. \u0401\u043d \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u044f\u0433\u043e \u044f\u043a \u0430\u043d\u0451\u043b\u0430 \u0411\u043e\u0436\u0430\u0433\u0430; \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0431 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u043c\u0430\u0433\u0447\u044b\u043c\u044b\u043c, \u044f\u043d\u044b \u0432\u044b\u0440\u0432\u0430\u043b\u0456 \u0431 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0456 \u0430\u0434\u0434\u0430\u043b\u0456 \u044f\u043c\u0443. \u0410\u0434\u043d\u0430\u043a \u0443 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0451\u043d \u0441\u0445\u0456\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u0441\u043b\u0430\u0431\u043e\u0439 \u0456 \u0445\u0432\u043e\u0440\u0430\u0439 \u0430\u0432\u0435\u0447\u043a\u0430\u0439, \u043a\u0430\u0431 \u043d\u0430\u0434\u0440\u044d\u0437\u0430\u0446\u044c \u0440\u0430\u043d\u0443 \u0456 \u043d\u0435 \u043f\u0430\u0442\u0443\u0440\u0430\u0435 \u0445\u0432\u0430\u0440\u043e\u0431\u0435. \u00ab\u0426\u0456 \u0436 \u044f, \u2013 \u043a\u0430\u0436\u0430 \u0451\u043d, \u2013 \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u0432\u0430\u0441 \u0432\u043e\u0440\u0430\u0433\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b \u0432\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u0443\u00bb (\u0413\u0430\u043b 4, 16). \u0422\u0430\u043c\u0443, \u2013 \u044f\u043a \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0432\u044b\u0448\u044d\u0439, \u2013 \u0451\u043d \u0431\u0440\u0430\u045e \u043c\u0430\u043b\u0430\u043a\u043e \u0430\u0434 \u0430\u0432\u0435\u0447\u0430\u043a, \u0430\u043f\u0440\u0430\u043d\u0430\u045e\u0441\u044f \u045e \u0432\u043e\u045e\u043d\u0443, \u0430\u043b\u0435 \u043d\u0435 \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u045e \u0456\u0445. \u0401\u043d \u043d\u0435 \u0448\u0443\u043a\u0430\u045e \u0441\u0432\u0430\u0451\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u0430\u043b\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0421\u0456\u0440 32, 1-2\u0430; \u041c\u043a 9, 35b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u043b\u0456 \u0446\u044f\u0431\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u043b\u0456 \u0431\u044b\u0446\u044c \u0441\u0442\u0430\u0440\u044d\u0439\u0448\u044b\u043c \u043d\u0430 \u0433\u0430\u0441\u0446\u0456\u043d\u0435, \u043d\u0435 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u044f.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0411\u0443\u0434\u0437\u044c \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u044f\u043a \u0430\u0434\u0437\u0456\u043d \u0437 \u0456\u0445, \u043f\u0430\u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0441\u044f \u043f\u0440\u0430 \u0456\u0445.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0431\u044b\u0446\u044c \u043f\u0435\u0440\u0448\u044b\u043c, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0437 \u0443\u0441\u0456\u0445 \u0430\u043f\u043e\u0448\u043d\u0456\u043c \u0456 \u0441\u043b\u0443\u0433\u043e\u044e \u045e\u0441\u0456\u0445.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u0443\u0434\u0437\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"245","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 46, 9: CCL 41, 535-536)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u0443\u0434\u0437\u044c \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0434\u043b\u044f \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e<\/span><\/p>\r\n<p style=\"text-indent: 17.1pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u043b\u044e\u0431\u044f\u0446\u044c \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b, \u0442\u043e \u045e \u0441\u0432\u0430\u044e \u0447\u0430\u0440\u0433\u0443 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u044f\u043d\u044b \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u044e\u0446\u044c. \u041d\u0435\u043c\u0430\u0447\u044b \u0430\u0432\u0435\u0447\u0430\u043a \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0456 \u0431\u0430\u0447\u043d\u044b\u044f. \u041d\u044f\u0448\u043c\u0430\u0442 \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u0445 \u0456 \u0441\u044b\u0442\u044b\u0445, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u0445 \u0435\u0436\u0430\u044e \u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a\u0456\u044f \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u043c\u0456 \u0411\u043e\u0433\u0430\u043c \u043f\u0430\u0448\u0430\u043c\u0456. \u0410\u0434\u043d\u0430\u043a \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b \u043d\u0430\u0432\u0430\u0442 \u0442\u0430\u043a\u0456\u0445 \u043d\u0435 \u0448\u043a\u0430\u0434\u0443\u044e\u0446\u044c. \u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043d\u0435 \u043a\u043b\u0430\u043f\u043e\u0446\u044f\u0446\u0446\u0430 \u043f\u0440\u0430 \u0445\u0432\u043e\u0440\u044b\u0445 \u0456 \u0441\u043b\u0430\u0431\u044b\u0445, \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u044b\u0445 \u0456 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u044b\u0445, \u0434\u044b\u043a \u044f\u0448\u0447\u044d, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430 \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434 \u0456\u0445, \u0437\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u043c\u043e\u0446\u043d\u044b\u0445 \u0456 \u0441\u044b\u0442\u044b\u0445. \u041d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0433\u044d\u0442\u0430, \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437\u0430\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u0436\u044b\u0432\u044b\u043c\u0456. \u0416\u044b\u0432\u0443\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u0410\u043b\u0435 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430 \u0430\u0434 \u0456\u0445 \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c, \u0437\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u0456\u0445. \u00ab\u042f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u2013 \u0441\u043f\u044b\u0442\u0430\u0435\u0448\u0441\u044f \u0442\u044b, \u2013 \u0437\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u0456\u0445 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b?\u00bb \u0417\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u044c, \u043a\u0430\u043b\u0456 \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0440\u044d\u043d\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0437\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u044c, \u043a\u0430\u043b\u0456 \u0434\u0430\u044e\u0446\u044c \u0434\u0440\u044d\u043d\u043d\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u0434. \u041d\u0435\u0437\u0434\u0430\u0440\u043c\u0430 \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0441\u043b\u0443\u0437\u0435 \u0411\u043e\u0436\u0430\u043c\u0443, \u044f\u043a\u0456 \u0437\u0430\u0439\u043c\u0430\u0435 \u0432\u044b\u0441\u043e\u043a\u0430\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0448\u0447\u0430 \u0441\u044f\u0440\u043e\u0434 \u0447\u043b\u0435\u043d\u0430\u045e \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u041f\u0430\u0441\u0442\u044b\u0440\u0430: \u00ab\u0412\u0430 \u045e\u0441\u0456\u043c \u0441\u0430\u043c \u0434\u0430\u0432\u0430\u0439 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e\u00bb (\u0426\u0456\u0442 2, 7). \u0406 \u044f\u0448\u0447\u044d: \u00ab\u0441\u0442\u0430\u043d\u044c \u0434\u043b\u044f \u0432\u0435\u0440\u043d\u044b\u0445 \u0443\u0437\u043e\u0440\u0430\u043c\u00bb (1 \u0426\u0456\u043c 4, 12).<\/span><\/p>\r\n<p style=\"text-indent: 17.1pt; text-align: justify;\"><span>\u041d\u0430\u0432\u0430\u0442 \u0437\u0434\u0430\u0440\u043e\u0432\u0430\u044f \u0430\u0432\u0435\u0447\u043a\u0430, \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u043f\u0430\u0441\u0442\u044b\u0440\u0430, \u0430\u0434\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0430\u0434 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d\u0430, \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435 \u0456\u0445 \u043d\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u043f\u0430\u0447\u044b\u043d\u0430\u0435 \u043a\u0430\u0437\u0430\u0446\u044c \u0443 \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b: \u00ab\u041a\u0430\u043b\u0456 \u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u043c\u043e\u0439 \u043f\u0430\u0441\u0442\u044b\u0440, \u0445\u0442\u043e \u0436 \u044f \u0442\u0430\u043a\u0456, \u043a\u0430\u0431 \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435?\u00bb \u0422\u0430\u043a \u0434\u0440\u044d\u043d\u043d\u044b \u043f\u0430\u0441\u0442\u044b\u0440 \u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u0437\u0434\u0430\u0440\u043e\u0432\u0443\u044e \u0430\u0432\u0435\u0447\u043a\u0443. \u041a\u0430\u043b\u0456 \u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u0437\u0434\u0430\u0440\u043e\u0432\u0443\u044e, \u0442\u043e \u0448\u0442\u043e \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0437 \u0456\u043d\u0448\u044b\u043c\u0456; \u0448\u0442\u043e \u0437\u0440\u043e\u0431\u0456\u0446\u044c, \u043a\u0430\u043b\u0456 \u0436\u044b\u0432\u0443\u0447\u044b \u0434\u0440\u044d\u043d\u043d\u0430, \u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u043d\u0430\u0432\u0430\u0442 \u0442\u0443\u044e, \u044f\u043a\u0443\u044e \u043d\u0435 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u045e, \u0430\u043b\u0435 \u0437\u0430\u0441\u0442\u0430\u045e \u043c\u043e\u0446\u043d\u0430\u0439 \u0456 \u0437\u0434\u0430\u0440\u043e\u0432\u0430\u0439?<\/span><\/p>\r\n<p style=\"text-indent: 17.1pt; text-align: justify;\"><span>\u041a\u0430\u0436\u0443 \u0432\u0430\u043c, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u044f\u0448\u0447\u044d \u0440\u0430\u0437 \u043a\u0430\u0436\u0443. \u041d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u0430\u0432\u0435\u0447\u043a\u0456 \u0436\u044b\u0432\u0443\u0446\u044c, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u043c\u043e\u0446\u043d\u044b\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u043b\u043e\u0432\u0443 \u041f\u0430\u043d\u0430 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u043a\u0430\u0437\u044b \u041f\u0430\u043d\u0430: \u00ab\u0443\u0441\u0451, \u0448\u0442\u043e \u0441\u043a\u0430\u0436\u0443\u0446\u044c \u0432\u0430\u043c, \u0440\u0430\u0431\u0456\u0446\u0435 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u0456\u0445\u043d\u0456\u0445\u00bb (\u041c\u0446 23, 3), \u0430\u0434\u043d\u0430\u043a \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u043d\u044f\u0433\u043e\u0434\u043d\u0430, \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u043a\u0443 \u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u044f\u0433\u043e. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0432\u0430\u0435 \u0441\u044f\u0431\u0435, \u0448\u0442\u043e \u044f\u0433\u043e \u0430\u0445\u0432\u044f\u0440\u0430 \u0436\u044b\u0432\u0435. \u0416\u044b\u0432\u0435, \u0430\u043b\u0435 \u0451\u043d \u2013 \u0437\u0430\u0431\u043e\u0439\u0446\u0430. \u0422\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u043b\u0456 \u0440\u0430\u0441\u043f\u0443\u0441\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u0437 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u043d\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u0443, \u0442\u043e \u0445\u043e\u0446\u044c \u044f\u043d\u0430 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0447\u044b\u0441\u0442\u0430\u0439, \u0451\u043d \u0441\u0430\u043c \u0443\u0447\u044b\u043d\u0456\u045e \u0447\u0443\u0436\u0430\u043b\u043e\u0441\u0442\u0432\u0430. \u0423 \u0433\u044d\u0442\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430 \u0432\u044b\u0440\u0430\u0437\u043d\u044b\u044f \u0456 \u044f\u0441\u043d\u044b\u044f: \u00ab\u2026\u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0437 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u0443, \u0443\u0436\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u0437 \u0451\u044e \u0447\u0443\u0436\u0430\u043b\u043e\u0441\u0442\u0432\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b\u00bb (\u041c\u0446 5, 28). \u0401\u043d \u043d\u0435 \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u044f\u0435 \u043f\u0430\u043a\u043e\u0439, \u0430\u043b\u0435 \u045e \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 17.1pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043d\u0435\u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0441\u044f\u0440\u043e\u0434 \u0442\u044b\u0445, \u0434\u043b\u044f \u043a\u0430\u0433\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0430\u0434 \u044f\u0433\u043e \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c, \u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u0430\u0432\u0435\u0447\u0430\u043a, \u0456 \u043d\u0430\u0432\u0430\u0442 \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u0445. \u0425\u0442\u043e \u0431\u044f\u0440\u044d \u0437 \u0456\u0445 \u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u043f\u0430\u043c\u0456\u0440\u0430\u0435; \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435, \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0436\u044b\u0432\u044b\u043c. \u0410\u0434\u043d\u0430\u043a, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434 \u044f\u0433\u043e, \u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u0430\u0434\u043d\u044b\u0445 \u0456 \u0434\u0440\u0443\u0433\u0456\u0445. \u00ab\u0412\u044b, \u2013 \u043a\u0430\u0436\u0430, \u2013 \u0440\u044d\u0437\u0430\u043b\u0456 \u0430\u0434\u043a\u043e\u0440\u043c\u043b\u0435\u043d\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u0441\u0432\u0456\u043b\u0456 \u0441\u0442\u0430\u0442\u0430\u043a\u00bb (\u042d\u0437\u0445 34, 3).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041b\u043a 12, 48b; \u041c\u0434\u0440 6, 5b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417 \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u043a\u0430\u043c\u0443 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0448\u043c\u0430\u0442, \u0456 \u0441\u043f\u0430\u0433\u043d\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0448\u043c\u0430\u0442; <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u043a\u0430\u043c\u0443 \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430 \u0448\u043c\u0430\u0442, \u0430\u0434 \u0442\u0430\u0433\u043e \u0431\u043e\u043b\u044c\u0448 \u0456 \u0437\u0430\u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041c\u043e\u0446\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u043e\u0446\u043d\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b\u044f. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406 \u043a\u0430\u043c\u0443.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"246","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 46, 10-11: CCL 41, 536-538)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439 \u0434\u0443\u0448\u0443 \u0441\u0432\u0430\u044e \u0434\u043b\u044f \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u044b \u045e\u0436\u043e \u0447\u0443\u043b\u0456, \u0448\u0442\u043e \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u0446\u044f\u043f\u0435\u0440, \u0448\u0442\u043e \u044f\u043d\u044b \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u044e\u0446\u044c: \u00ab\u0412\u044b \u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u043b\u0456 \u0441\u043b\u0430\u0431\u043e\u0439 \u0456 \u043d\u0435 \u043b\u044f\u0447\u044b\u043b\u0456 \u0445\u0432\u043e\u0440\u0430\u0439, \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u0430\u0439 \u043d\u0435 \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0432\u0430\u043b\u0456 \u0456 \u043d\u0435 \u0432\u044f\u0440\u0442\u0430\u043b\u0456 \u0442\u043e\u0439, \u0448\u0442\u043e \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0430, \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u0430\u0439 \u0432\u044b \u043d\u0435 \u0448\u0443\u043a\u0430\u043b\u0456, \u0430\u043b\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u043d\u0430\u0434 \u0456\u043c\u0456 \u0441\u0456\u043b\u0430\u044e \u0456 \u0433\u0432\u0430\u043b\u0442\u0430\u043c\u00bb (\u042d\u0437\u0445 34, 4). \u0412\u044b \u0437\u0430\u0431\u0456\u0432\u0430\u043b\u0456 \u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u0456. \u0425\u0432\u043e\u0440\u0430\u044f \u0430\u0432\u0435\u0447\u043a\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0442\u0430\u044f, \u0448\u0442\u043e \u043c\u0430\u0435 \u0445\u0432\u043e\u0440\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0441\u0445\u0456\u043b\u044c\u043d\u0430\u0435 \u043f\u0430\u0434\u0434\u0430\u0446\u0446\u0430 \u0441\u043f\u0430\u043a\u0443\u0441\u0430\u043c, \u043a\u0430\u043b\u0456 \u0437 \u0456\u043c\u0456 \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0435\u0446\u0446\u0430 \u0431\u0435\u0437 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0430\u043d\u043d\u044f \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u043e\u045e\u043a\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043d\u044f\u0434\u0431\u0430\u043b\u044b \u043f\u0430\u0441\u0442\u044b\u0440 \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u0435 \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0442\u0430\u043a\u043e\u0433\u0430, \u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u0421\u044b\u043d\u0435, \u043a\u0430\u043b\u0456 \u0437\u0431\u0456\u0440\u0430\u0435\u0448\u0441\u044f \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u041f\u0430\u043d\u0443, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439 \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443 \u0434\u0430 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u00bb (\u0421\u0456\u0440 2, 1). \u0425\u0442\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430, \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0441\u043b\u0430\u0431\u043e\u0433\u0430, \u0440\u043e\u0431\u0456\u0446\u044c \u044f\u0433\u043e \u043c\u043e\u0446\u043d\u044b\u043c \u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435, \u043a\u0430\u0431 \u0445\u0443\u0442\u0447\u044d\u0439 \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u043d\u0435 \u0431\u0430\u0447\u044b\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0448\u0447\u0430\u0441\u0446\u044f \u045e \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0446\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0432\u044b\u043a\u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u0437\u044f\u043c\u043d\u044b \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442, \u0442\u043e \u0433\u044d\u0442\u0430 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u044f\u0433\u043e \u0434\u0430 \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u044f, \u0431\u043e \u043a\u0430\u043b\u0456 \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0443\u0446\u044c \u044f\u0433\u043e \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456, \u0431\u0443\u0434\u0437\u0435 \u0446\u044f\u0440\u043f\u0435\u0446\u044c, \u0430\u0431\u043e \u043d\u0430\u0432\u0430\u0442 \u0437\u0443\u0441\u0456\u043c \u0437\u0430\u0433\u0456\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0425\u0442\u043e \u0442\u0430\u043a \u0431\u0443\u0434\u0443\u0435, \u0442\u043e\u0439 \u043d\u0435 \u0431\u0443\u0434\u0443\u0435 \u043d\u0430 \u0441\u043a\u0430\u043b\u0435, \u0430\u043b\u0435 \u0437\u0430\u043a\u043b\u0430\u0434\u0432\u0430\u0435 \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a \u043d\u0430 \u043f\u044f\u0441\u043a\u0443. \u00ab\u0421\u043a\u0430\u043b\u043e\u044e \u0431\u044b\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441\u00bb (1 \u041a\u0430\u0440 10, 4). \u0422\u0430\u043c\u0443 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u043d\u0435 \u0433\u0430\u043d\u044f\u0446\u0446\u0430 \u0437\u0430 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044f\u043c\u0456. \u0421\u043b\u0430\u0431\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0447\u0443\u0435: \u00ab\u0420\u044b\u0445\u0442\u0443\u0439\u0441\u044f \u0434\u0430 \u0441\u043f\u0430\u043a\u0443\u0441\u0430\u045e \u0441\u0432\u0435\u0442\u0443\u00bb. \u0410\u043b\u0435 \u0430\u0434 \u0443\u0441\u0456\u0445 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u041f\u0430\u043d, \u043a\u0430\u043b\u0456 \u0442\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u043d\u0435 \u0430\u0434\u0434\u0430\u043b\u0456\u0446\u0446\u0430 \u0430\u0434 \u042f\u0433\u043e. \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043a\u0430\u0431 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0442\u0432\u0430\u0439\u0433\u043e \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u044f, \u043f\u0440\u044b\u0431\u044b\u045e, \u043a\u0430\u0431 \u043f\u0430\u043c\u0435\u0440\u0446\u0456, \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0437\u043d\u044f\u0432\u0430\u0436\u0430\u043d\u044b\u043c, \u0443\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u043d\u044b\u043c \u0446\u0435\u0440\u043d\u0435\u043c, \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b\u043c \u0456 \u045e\u0440\u044d\u0448\u0446\u0435 \u0431\u044b\u0446\u044c \u043f\u0440\u044b\u0431\u0456\u0442\u044b\u043c \u0434\u0430 \u043a\u0440\u044b\u0436\u0430. \u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u0401\u043d \u0441\u0430\u043c \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u043b\u044f \u0446\u044f\u0431\u0435, \u0442\u044b \u0436 \u043d\u0456\u0447\u043e\u0433\u0430. \u0401\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0414\u044b\u043a \u0445\u0442\u043e \u0436 \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u0446\u044c \u0441\u043b\u0443\u0445\u0430\u0447\u043e\u045e? \u042f\u043d\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u0440\u044b\u0445\u0442\u0443\u044e\u0446\u044c \u0434\u0430 \u0431\u043b\u0456\u0437\u043a\u0456\u0445 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e, \u0430\u043b\u0435 \u043d\u0430\u0432\u0430\u0442 \u0430\u0431\u044f\u0446\u0430\u044e\u0446\u044c \u0448\u0447\u0430\u0441\u0446\u0435 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u0447\u0430\u0433\u043e \u0411\u043e\u0433 \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u0430\u0431\u044f\u0446\u0430\u045e \u0441\u0432\u0435\u0442\u0443. \u041f\u0430\u043d \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0435\u0442\u0443 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u044b\u044f \u043f\u0430\u043a\u0443\u0442\u044b \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456; \u0442\u044b \u0436 \u043f\u0440\u0430\u0433\u043d\u0435\u0448, \u043a\u0430\u0431 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d \u0431\u044b\u045e \u0432\u043e\u043b\u044c\u043d\u044b \u0430\u0434 \u0456\u0445? \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430\u043c, \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: \u00ab\u0423\u0441\u0435, \u0445\u0442\u043e \u0436\u0430\u0434\u0430\u0435 \u0436\u044b\u0446\u044c \u043f\u0430\u0431\u043e\u0436\u043d\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u044b\u044f\u00bb (2 \u0426\u0456\u043c 3, 12). \u0410 \u0442\u044b, \u043f\u0430\u0441\u0442\u044b\u0440, \u044f\u043a\u0456 \u0448\u0443\u043a\u0430\u0435\u0448 \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u0430 \u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435: \u00ab\u0423\u0441\u0456\u0445, \u0445\u0442\u043e \u0436\u0430\u0434\u0430\u0435 \u0436\u044b\u0446\u044c \u043f\u0430\u0431\u043e\u0436\u043d\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u044b\u044f\u00bb, \u043a\u0430\u0436\u0430\u0448: \u00ab\u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0430\u0431\u043e\u0436\u043d\u0430 \u0436\u044b\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u0431\u0443\u0434\u0437\u0435\u0448 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c\u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456. \u041a\u0430\u043b\u0456 \u043d\u0435 \u043c\u0430\u0435\u0448 \u0434\u0437\u044f\u0446\u0435\u0439, \u0431\u0443\u0434\u0437\u0435\u0448 \u0456\u0445 \u043c\u0435\u0446\u044c, \u0432\u044b\u043a\u0430\u0440\u043c\u0456\u0448 \u0443\u0441\u0456\u0445 \u0456 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0435 \u043d\u0435 \u043f\u0430\u043c\u0440\u044d\u00bb. \u0422\u0430\u043a \u0431\u0443\u0434\u0443\u0435\u0448? \u0413\u043b\u044f\u0434\u0437\u0456, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u0448, \u043d\u0430 \u0447\u044b\u043c \u0431\u0443\u0434\u0443\u0435\u0448. \u0422\u044b \u0431\u0443\u0434\u0443\u0435\u0448 \u043d\u0430 \u043f\u044f\u0441\u043a\u0443. \u041f\u043e\u0439\u0434\u0443\u0446\u044c \u0434\u0430\u0436\u0434\u0436\u044b, \u043f\u0430\u0434\u044b\u043c\u0435\u0446\u0446\u0430 \u0440\u0430\u043a\u0430, \u043f\u0430\u0432\u0435\u044e\u0446\u044c \u0432\u044f\u0442\u0440\u044b, \u0443\u0434\u0430\u0440\u0430\u0446\u044c \u0443 \u0434\u043e\u043c, \u0456 \u0451\u043d \u0443\u043f\u0430\u0434\u0437\u0435, \u0456 \u044f\u0433\u043e \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u043b\u0456\u043a\u0456\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0417\u0430\u0431\u044f\u0440\u044b \u0437 \u043f\u044f\u0441\u043a\u0443, \u0431\u0443\u0434\u0443\u0439 \u043d\u0430 \u0441\u043a\u0430\u043b\u0435. \u0422\u043e\u0439, \u043a\u0430\u0433\u043e \u0445\u043e\u0447\u0430\u0448 \u043c\u0435\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430\u043c, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0437\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u0425\u0440\u044b\u0441\u0446\u0435. \u041d\u044f\u0445\u0430\u0439 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435 \u0451\u043d \u043d\u0430\u0434 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0439 \u043c\u0443\u043a\u0430\u0439 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443, \u0437\u0430\u043f\u043b\u0430\u0446\u0456\u045e \u0434\u043e\u045e\u0433, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435 \u043c\u0435\u045e, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0430\u0434 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u043c\u0456 \u0434\u0430 \u044f\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u041f\u0456\u0441\u0430\u043d\u043d\u044f: \u00ab\u041f\u0430\u043d \u0431\u2019\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u043a\u0430\u0433\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u044f\u043a \u0441\u044b\u043d\u0430\u00bb (\u0413\u0431\u0440 12, 6). \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u0434\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f\u045e, \u0456\u043d\u0430\u0447\u0430\u0439 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0447\u0430\u043a\u0430\u0435, \u0448\u0442\u043e \u044f\u0433\u043e \u043f\u0440\u044b\u043c\u0443\u0446\u044c.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u0422\u044d\u0441 2, 4. 3\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f\u043a \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u044b\u044f \u0411\u043e\u0433\u0430\u043c \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0440\u0443\u0447\u044d\u043d\u043d\u044f \u043d\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u043c\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0442\u0430\u043a, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u0434\u0430\u0433\u0430\u0434\u0437\u0456\u0446\u044c \u043d\u0435 \u043b\u044e\u0434\u0437\u044f\u043c, \u0430\u043b\u0435 \u0411\u043e\u0433\u0443.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435 \u043d\u0435 \u0437 \u043f\u0430\u043c\u044b\u043b\u043a\u0456, \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0446\u0456 \u043f\u0430\u0434\u043c\u0430\u043d\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043c\u0443.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"247","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 46, 11-12: CCL 41, 538-539)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u0432\u044f\u0437\u043a\u0430 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u041f\u0430\u043d \u0431\u2019\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u043a\u0430\u0433\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u044f\u043a \u0441\u044b\u043d\u0430\u00bb (\u0413\u0431\u0440 12, 6). \u0410 \u0442\u044b \u043a\u0430\u0436\u0430\u0448: \u00ab\u041c\u043e\u0436\u0430 \u044f \u0431\u0443\u0434\u0443 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435\u043c?\u00bb \u041a\u0430\u043b\u0456 \u0432\u044b\u043a\u043b\u044e\u0447\u0430\u043d\u044b \u0430\u0434 \u0431\u0456\u0446\u0446\u044f, \u0442\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0437 \u043b\u0456\u0447\u0431\u044b \u0441\u044b\u043d\u043e\u045e. \u00ab\u0422\u0430\u043c\u0443, \u2013 \u0442\u044b \u043a\u0430\u0436\u0430\u0448 \u0434\u0430\u043b\u0435\u0439, \u2013 \u0401\u043d \u0431\u2019\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0441\u044b\u043d\u0430?\u00bb \u0422\u0430\u043a, \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430. \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0421\u044b\u043d, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0437 \u0410\u0439\u0446\u0430, \u0440\u043e\u045e\u043d\u044b \u0410\u0439\u0446\u0443 \u045e \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456, \u0421\u043b\u043e\u0432\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0435 \u045e\u0441\u0451 \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u043d\u0435 \u043c\u043e\u0433 \u043f\u0430\u0434\u0432\u044f\u0440\u0433\u0430\u0446\u0446\u0430 \u0431\u0456\u0446\u0446\u044e. \u0422\u0430\u043c\u0443 \u043f\u0440\u044b\u043d\u044f\u045e \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u0446\u044c \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u043c \u0431\u0456\u0446\u0446\u044f. \u0422\u043e\u0439 \u0411\u043e\u0433, \u044f\u043a\u0456 \u0431\u2019\u0435 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u045e \u0433\u0440\u0430\u0445\u0443, \u0446\u0456 \u0436 \u0430\u0431\u043c\u0456\u043d\u0435 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0430\u043d\u0430\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435\u043c \u0443\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u0435 \u0434\u0437\u0456\u0446\u044f? \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u043c\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u0441\u0442\u0430\u0446\u044c \u0443\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456. \u041c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u0441\u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0430\u043c\u0456 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u0430 \u0442\u0430\u043c\u0443 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430\u0439: \u00ab\u041f\u0440\u0430\u0441\u0456 \u045e \u041c\u044f\u043d\u0435, \u0456 \u0434\u0430\u043c \u043d\u0430\u0440\u043e\u0434\u044b \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0442\u0430\u0431\u0435\u00bb (\u041f\u0441 2, 8). \u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0411\u043e\u0433 \u0434\u0430\u045e \u043d\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041a\u0430\u0431 \u0445\u0432\u043e\u0440\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u0430\u0434\u0447\u0430\u0439\u0432\u0430\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0431\u0443\u0434\u0443\u0447\u044b\u0445 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e, \u043d\u0435\u043b\u044c\u0433\u0430, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0434\u0430\u0432\u0430\u0446\u044c \u044f\u043c\u0443 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e \u0456 \u043a\u0430\u0440\u043c\u0456\u0446\u044c \u043b\u0435\u043a\u0430\u043c\u0456. \u0422\u0430\u043a\u043e\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439 \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443 \u0434\u0430 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u00bb (\u0421\u0456\u0440 2, 1). \u041c\u0430\u0433\u0447\u044b\u043c\u0430 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0451\u043d \u043f\u0430\u0447\u043d\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430, \u0431\u0430\u044f\u0446\u0446\u0430, \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u0446\u0446\u0430. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0436\u044b \u044f\u043c\u0443: \u00ab\u0411\u043e\u0433, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0432\u0435\u0440\u043d\u044b\u043c, \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u0432\u0430\u0441 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043c\u0430\u0435\u0446\u0435 \u0441\u0456\u043b\u044b\u00bb (1 \u041a\u0430\u0440 10, 13). \u0422\u0430\u043a \u0442\u0440\u044d\u0431\u0430 \u0430\u0431\u044f\u0446\u0430\u0446\u044c \u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u0431\u0443\u0434\u0443\u0447\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435. \u0423 \u0433\u044d\u0442\u044b\u043c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u0435 \u0441\u043b\u0430\u0431\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u0435\u0446\u0446\u0430 \u0456 \u0441\u043f\u0443\u0436\u0430\u0435\u0446\u0446\u0430, \u0430\u0431\u044f\u0446\u0430\u0439 \u0411\u043e\u0436\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u0410\u043b\u0435 \u043d\u0435 \u043a\u0430\u0436\u044b, \u0448\u0442\u043e \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e, \u0430\u043b\u0435 \u0448\u0442\u043e \u0411\u043e\u0433 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u0431\u043e\u043b\u044c\u0448 \u0437\u0432\u044b\u0448 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0451\u043d \u043c\u043e\u0436\u0430 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0446\u044c. \u0423 \u0433\u044d\u0442\u044b\u043c \u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0432\u0430\u043d\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0456\u044f, \u0445\u0442\u043e \u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u0434\u0430 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u044b\u0445 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0441\u0446\u044e \u0456 \u043f\u0440\u0430\u0433\u043d\u0435 \u0456\u0445 \u0431\u044b\u0446\u0446\u0430\u043c \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u043d\u0430\u043f\u043e\u044e. \u041c\u0430\u043b\u0430 \u0446\u044d\u043d\u044f\u0446\u044c \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u044f \u0432\u0435\u0440\u043d\u044b\u043c \u043b\u0435\u043a\u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e, \u0430\u043b\u0435 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0445\u0432\u0430\u043b\u044b \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430. \u0401\u0441\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u044f, \u044f\u043a\u0456\u044f, \u0447\u0443\u044e\u0447\u044b \u043f\u0440\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u044f \u0456 \u043d\u0435\u043f\u0430\u0437\u0431\u0435\u0436\u043d\u044b\u044f \u0431\u043b\u0456\u0437\u043a\u0456\u044f \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456, \u0430\u0434\u0447\u0430\u0439\u0432\u0430\u044e\u0446\u0446\u0430 \u0456 \u043f\u0430\u0434\u0430\u044e\u0446\u044c \u0434\u0443\u0445\u0430\u043c. \u0410 \u0442\u0430\u043a\u0456\u044f \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456 \u0437\u0430\u043a\u0440\u0430\u043d\u0430\u044e\u0446\u044c \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e, \u0456 \u0430\u0434\u0447\u0443\u0446\u044c \u0456\u0445 \u043c\u043e\u0436\u043d\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0456\u043c\u043a\u043d\u0435\u0448\u0441\u044f \u0431\u044b\u0446\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0437\u0440\u0430\u0431\u0456 \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u043a\u0443 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f, \u043f\u0435\u0440\u0430\u0432\u044f\u0436\u044b \u0440\u0430\u043d\u0443. \u0421\u043a\u0430\u0436\u044b \u0442\u0430\u043a\u043e\u043c\u0443: \u00ab\u041d\u0435 \u0431\u043e\u0439\u0441\u044f; \u0442\u043e\u0439, \u043a\u0430\u043c\u0443 \u0442\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435 \u0446\u044f\u0431\u0435 \u045e \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u0445. \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0432\u0435\u0440\u043d\u044b\u043c \u0456 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u0446\u044f\u0431\u0435 \u043f\u0430-\u043d\u0430\u0434 \u0442\u0432\u0430\u0435 \u0441\u0456\u043b\u044b. \u0413\u044d\u0442\u0430 \u043d\u0435 \u044f \u043a\u0430\u0436\u0443, \u0430\u043b\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u044f\u043a\u0456 \u044f\u0448\u0447\u044d \u0434\u0430\u0434\u0430\u0435: \u201c\u0412\u044b \u0448\u0443\u043a\u0430\u0435\u0446\u0435 \u0434\u043e\u043a\u0430\u0437\u0443, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u043c\u044f\u043d\u0435 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441\u201d (2 \u041a\u0430\u0440 13, 3)\u00bb. \u041a\u0430\u043b\u0456 \u0447\u0443\u0435\u0448 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0442\u044b \u0447\u0443\u0435\u0448 \u0441\u0430\u043c\u043e\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0447\u0443\u0435\u0448 \u0442\u0430\u0433\u043e \u041f\u0430\u0441\u0442\u044b\u0440\u0430, \u044f\u043a\u0456 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044c. \u0413\u044d\u0442\u0430 \u0434\u0430 \u042f\u0433\u043e \u0430\u0434\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u044b: \u00ab\u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u044b \u043d\u0430\u043f\u0430\u0456\u045e \u0456\u0445 \u0441\u043b\u044f\u0437\u044c\u043c\u0456\u00bb (\u043f\u0430\u0440. \u041f\u0441 80 [79], 6). \u0422\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0443 \u0441\u043b\u043e\u0432\u0430\u0445: \u00ab\u041d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u0432\u0430\u0441 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043c\u0430\u0435\u0446\u0435 \u0441\u0456\u043b\u044b\u00bb, \u043f\u0440\u0430\u0440\u043e\u043a \u0432\u044b\u044f\u045e\u043b\u044f\u0435 \u045e \u0441\u043b\u043e\u0432\u0430\u0445 \u00ab\u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u044b\u00bb. \u041d\u044f\u0445\u0430\u0439 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439 \u043d\u0435 \u0430\u0434\u0434\u0430\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431\u2019\u0435 \u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435, \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u0435 \u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0435, \u0443\u0434\u0430\u0440\u0430\u0435 \u0456 \u043b\u0435\u0447\u044b\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 44 (43), 23. 12; \u0420\u044b\u043c 8, 37\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417-\u0437\u0430 \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u043d\u0430\u0441 \u0448\u0442\u043e\u0434\u043d\u044f \u0437\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u0456 \u043b\u0456\u0447\u0430\u0446\u044c \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u043c\u0456 \u043d\u0430 \u0437\u0430\u0440\u044d\u0437. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0410\u043b\u0435 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u043f\u043e\u045e\u043d\u0443\u044e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0422\u044b \u0432\u044b\u0434\u0430\u045e \u043d\u0430\u0441, \u043d\u0456\u0431\u044b \u0430\u0432\u0435\u0447\u0430\u043a, \u043d\u0430 \u0437\u0430\u0440\u044d\u0437 \u0456 \u0440\u0430\u0441\u043a\u0456\u0434\u0430\u045e \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u043b\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"251","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 46, 13: CCL 41, 539-540)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430 \u0441\u043b\u0430\u0431\u044b\u0445 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u043a\u0430\u0436\u0430: \u00ab\u0412\u044b \u043d\u0435 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u0441\u043b\u0430\u0431\u043e\u0439\u00bb. \u041a\u0430\u0436\u0430 \u0442\u0430\u043a \u0434\u0440\u044d\u043d\u043d\u044b\u043c \u0456 \u043d\u0435\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c, \u0442\u044b\u043c, \u0445\u0442\u043e \u0448\u0443\u043a\u0430\u0435 \u0441\u0432\u0430\u0451\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u0430 \u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041a\u0430\u0440\u044b\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0456 \u0432\u043e\u045e\u043d\u0430\u0439, \u0430\u043b\u0435 \u043d\u0435 \u043a\u043b\u0430\u043f\u043e\u0446\u044f\u0446\u0446\u0430 \u043f\u0440\u0430 \u0430\u0432\u0435\u0447\u0430\u043a, \u043d\u0435 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0441\u043b\u0430\u0431\u044b\u0445. \u0421\u044f\u0440\u043e\u0434 \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0441\u043b\u0430\u0431\u044b\u043c\u0456, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043a\u0432\u043e\u043b\u044b\u043c\u0456 (\u0431\u043e \u0445\u0432\u043e\u0440\u044b\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u0446\u0430 \u0441\u043b\u0430\u0431\u044b\u043c\u0456), \u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043f\u0430\u043c\u0456\u0436 \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456 \u0441\u043b\u0430\u0431\u043e\u0439 \u0456 \u0445\u0432\u043e\u0440\u0430\u0439, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u043e\u0439, \u044f\u043a\u0430\u044f \u0430\u0434 \u0447\u0430\u0433\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043f\u0430\u043a\u0443\u0442\u0443\u0435, \u0456\u0441\u043d\u0443\u0435, \u043d\u0430 \u043c\u0430\u044e \u0434\u0443\u043c\u043a\u0443, \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u044f \u0440\u043e\u0437\u043d\u0456\u0446\u0430. \u041f\u0430\u0441\u0442\u0430\u0440\u0430\u0435\u043c\u0441\u044f \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u044f\u0435. \u041c\u0430\u0433\u0447\u044b\u043c\u0430, \u043f\u0440\u044b \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0441\u0446\u0456 \u043c\u044b \u0437\u043c\u0430\u0433\u043b\u0456 \u0431 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u043b\u0435\u043f\u0448 \u0441\u0430\u043c\u0456 \u0430\u0431\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u044b \u0456 \u0437 \u0431\u043e\u043b\u044c\u0448 \u044f\u0441\u043d\u044b\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435\u043c. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u043f\u0430\u043c\u044b\u043b\u043a\u0430\u043c, \u0441\u043a\u0430\u0436\u0443, \u0448\u0442\u043e \u0434\u0443\u043c\u0430\u044e, \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u043d\u0430 \u0441\u043b\u043e\u0432\u044b \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f. \u0423 \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u0441\u043b\u0430\u0431\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0442\u0440\u044d\u0431\u0430 \u0431\u0430\u044f\u0446\u0446\u0430, \u043a\u0430\u0431 \u044f\u0433\u043e \u043d\u0435 \u0441\u0443\u0441\u0442\u0440\u044d\u043b\u0430 \u0441\u043f\u0430\u043a\u0443\u0441\u0430 \u0456 \u043d\u0435 \u0437\u043b\u0430\u043c\u0430\u043b\u0430. \u0410 \u0445\u0442\u043e \u0445\u0432\u043e\u0440\u044b, \u0443\u0436\u043e \u043f\u0430\u043a\u0443\u0442\u0443\u0435 \u0430\u0434 \u043d\u0435\u0439\u043a\u0430\u0439 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u043d\u0435 \u0434\u0430\u0435 \u045e\u0437\u044b\u0441\u0446\u0456 \u043d\u0430 \u0411\u043e\u0436\u044b \u0448\u043b\u044f\u0445 \u0456 \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044e \u0425\u0440\u044b\u0441\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435 \u0436\u044b\u0446\u044c \u0434\u043e\u0431\u0440\u0430, \u0445\u0442\u043e \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0436\u044b\u0446\u044c \u0434\u043e\u0431\u0440\u0430, \u0430\u043b\u0435 \u044f\u043d\u044b \u043c\u0435\u043d\u0448 \u0443\u043c\u0435\u044e\u0446\u044c \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0437\u043b\u043e, \u0447\u044b\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e. \u0410\u0434\u043d\u0430\u043a \u0441\u0456\u043b\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0437\u043d\u044f\u0441\u0435\u043d\u043d\u0456 \u0437\u043b\u0430. \u0422\u0430\u043c\u0443 \u0442\u044b\u044f, \u0445\u0442\u043e \u0432\u044b\u0434\u0430\u0435\u0446\u0446\u0430 \u0440\u0443\u043f\u043b\u0456\u0432\u044b\u043c \u0443 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u0456 \u0434\u0430\u0431\u0440\u0430, \u0430\u043b\u0435 \u043d\u0435 \u045e\u043c\u0435\u0435 \u0456 \u043d\u0435 \u0445\u043e\u0447\u0430 \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u044f\u043a\u0456\u044f \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u0435, \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u0441\u043b\u0430\u0431\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u0422\u044b\u044f \u0436, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0432\u0435\u0442, \u0456 \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u043d\u0435\u0439\u043a\u0430\u0439 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0434 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u0434\u0430\u0431\u0440\u0430, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0445\u0432\u043e\u0440\u044b\u043c\u0456 \u0456 \u043b\u044f\u043d\u0456\u0432\u044b\u043c\u0456. \u0425\u0432\u0430\u0440\u043e\u0431\u0430 \u043d\u0456\u0431\u044b \u0437\u0430\u0431\u0456\u0440\u0430\u0435 \u045e\u0441\u0435 \u0456\u0445\u043d\u0456\u044f \u0441\u0456\u043b\u044b, \u0456 \u044f\u043d\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0440\u0430\u0431\u0456\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a\u0456\u043c \u0431\u044b\u045e \u0443 \u0434\u0443\u0448\u044b \u0442\u043e\u0439 \u043f\u0430\u0440\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043d\u044b, \u044f\u043a\u043e\u0433\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u044f\u0433\u043e \u043d\u0451\u0441, \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u041f\u0430\u043d\u0443. \u0422\u0430\u043c\u0443 \u0437\u043d\u044f\u043b\u0456 \u0434\u0430\u0445 \u0456 \u043f\u0430\u043a\u043b\u0430\u043b\u0456 \u0445\u0432\u043e\u0440\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435, \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u045e \u0434\u0443\u0448\u044b: \u0442\u0440\u044d\u0431\u0430 \u0437\u043d\u044f\u0446\u044c \u0434\u0430\u0445 \u0456 \u043f\u0430\u043a\u043b\u0430\u0441\u0446\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u043f\u0430\u0440\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043d\u0443\u044e \u0434\u0443\u0448\u0443, \u043d\u0435\u0440\u0443\u0445\u043e\u043c\u0443\u044e \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0447\u0430\u0441\u0442\u043a\u0430\u0445, \u0430\u0441\u043b\u0430\u0431\u043b\u0435\u043d\u0443\u044e \u0445\u0432\u0430\u0440\u0430\u0432\u0456\u0442\u0430\u0439 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e. \u041a\u0430\u043b\u0456 \u0436 \u0443\u0441\u0435 \u0447\u0430\u0441\u0442\u043a\u0456 \u043d\u0435\u0440\u0443\u0445\u043e\u043c\u044b\u044f \u0456 \u043d\u0430\u0441\u0442\u0443\u043f\u0456\u045e \u0443\u043d\u0443\u0442\u0440\u0430\u043d\u044b \u043f\u0430\u0440\u0430\u043b\u0456\u0447, \u044f\u043a\u0456 \u043d\u0435 \u0434\u0430\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u041b\u0435\u043a\u0430\u0440\u0430 \u2013 \u0430 \u043c\u043e\u0436\u0430 \u041b\u0435\u043a\u0430\u0440 \u0443\u043a\u0440\u044b\u0442\u044b \u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0435: \u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0456\u043c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0441\u044d\u043d\u0441, \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u045e \u041f\u0456\u0441\u0430\u043d\u043d\u0456 \u2013 \u0442\u0430\u0434\u044b, \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u044e\u0447\u044b \u0437\u0430\u043a\u0440\u044b\u0442\u0430\u0435, \u0430\u0434\u043a\u0440\u044b \u0434\u0430\u0445 \u0456 \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0456 \u043f\u0430\u0440\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043d\u0430\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u044b \u0447\u0443\u043b\u0456, \u0437\u0430 \u0448\u0442\u043e \u0434\u0430\u043a\u0430\u0440\u0430\u043b\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u0435 \u0456 \u043d\u0435 \u0440\u043e\u0431\u0456\u0446\u044c: \u00ab\u0412\u044b \u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u043b\u0456 \u0441\u043b\u0430\u0431\u043e\u0439 \u0456 \u043d\u0435 \u043b\u044f\u0447\u044b\u043b\u0456 \u0445\u0432\u043e\u0440\u0430\u0439\u00bb (\u042d\u0437\u0445 34, 4). \u041c\u044b \u045e\u0436\u043e \u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430. \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u044b\u045e \u0437\u043b\u043e\u043c\u043b\u0435\u043d\u044b \u0441\u0442\u0440\u0430\u0445\u0430\u043c \u043f\u0435\u0440\u0430\u0434 \u043f\u0430\u0433\u0440\u043e\u0437\u0430\u044e \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e. \u041b\u0435\u043a\u0430\u043c \u043d\u0430 \u0433\u044d\u0442\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u044b \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f: \u00ab\u0411\u043e\u0433, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0432\u0435\u0440\u043d\u044b\u043c, \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u0432\u0430\u0441 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043c\u0430\u0435\u0446\u0435 \u0441\u0456\u043b\u044b, \u0430\u043b\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0434\u0430\u0441\u0446\u044c \u0456 \u0432\u044b\u0439\u0441\u0446\u0435, \u043a\u0430\u0431 \u0432\u044b \u043c\u0430\u0433\u043b\u0456 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0446\u044c\u00bb (1 \u041a\u0430\u0440 10, 13).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u041a\u0430\u0440 9, 22-23\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0414\u043b\u044f \u043d\u044f\u0434\u0443\u0436\u044b\u0445 \u044f \u0441\u0442\u0430\u045e \u044f\u043a \u043d\u044f\u0434\u0443\u0436\u044b, \u043a\u0430\u0431 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u043d\u044f\u0434\u0443\u0436\u044b\u0445. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0414\u043b\u044f \u045e\u0441\u0456\u0445 \u044f \u0441\u0442\u0430\u045e \u0443\u0441\u0456\u043c, \u043a\u0430\u0431 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0420\u0430\u0431\u043b\u044e \u0436 \u0433\u044d\u0442\u0430 \u0434\u0437\u0435\u043b\u044f \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u044f\u0433\u043e \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0420\u043e\u0431\u044f\u0447\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"252","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 46, 14-15: CCL 41, 541-542)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0439 \u0443 \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0456 \u043d\u0435\u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0447\u0430\u0441<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0412\u044b \u043d\u0435 \u0432\u044f\u0440\u0442\u0430\u043b\u0456 \u0442\u043e\u0439, \u0448\u0442\u043e \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0430, \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u0430\u0439 \u0432\u044b \u043d\u0435 \u0448\u0443\u043a\u0430\u043b\u0456\u00bb (\u042d\u0437\u0445 34, 4). \u041c\u044b \u0436\u044b\u0432\u0435\u043c \u0441\u044f\u0440\u043e\u0434 \u0437\u0430\u0431\u043e\u0439\u0446\u0430\u045e, \u0456 \u043d\u0430\u043c \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u044e\u0446\u044c \u043a\u043b\u044b\u043a\u0456 \u0430\u0448\u0430\u043b\u0435\u043b\u044b\u0445 \u0432\u0430\u045e\u043a\u043e\u045e, \u0442\u0430\u043c\u0443 \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u0432\u044b \u043c\u0430\u043b\u0456\u043b\u0456\u0441\u044f \u0437\u0430 \u043d\u0430\u0441, \u044f\u043a\u0456\u043c \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0435 \u0442\u0430\u043a\u0430\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430. \u0410\u043b\u0435 \u0436 \u0430\u0432\u0435\u0447\u043a\u0456 \u0431\u044b\u0432\u0430\u044e\u0446\u044c \u0443\u043f\u0430\u0440\u0442\u044b\u043c\u0456. \u041a\u0430\u043b\u0456 \u0448\u0443\u043a\u0430\u0435\u043c \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u044b\u0445, \u044f\u043d\u044b, \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u044b\u044f \u0456 \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u044b\u044f, \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u043d\u0430\u0441: \u00ab\u0427\u0430\u0433\u043e \u0432\u044b \u0445\u043e\u0447\u0430\u0446\u0435 \u0430\u0434 \u043d\u0430\u0441? \u0427\u0430\u043c\u0443 \u0448\u0443\u043a\u0430\u0435\u0446\u0435 \u043d\u0430\u0441?\u00bb \u0411\u044b\u0446\u0446\u0430\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u044f\u043d\u044b \u0431\u043b\u0443\u043a\u0430\u044e\u0446\u044c \u0456 \u0433\u0456\u043d\u0443\u0446\u044c, \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u044b\u043c \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043c\u044b \u0456\u0445 \u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0456 \u0448\u0443\u043a\u0430\u043b\u0456. \u00ab\u041a\u0430\u043b\u0456 \u044f \u0431\u043b\u0443\u043a\u0430\u044e, \u2013 \u043a\u0430\u0436\u0430, \u2013 \u0456 \u0437\u0433\u0443\u0431\u0456\u045e\u0441\u044f, \u0447\u0430\u0433\u043e \u0445\u043e\u0447\u0430\u0448 \u0430\u0434 \u043c\u044f\u043d\u0435? \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u043c\u044f\u043d\u0435 \u0448\u0443\u043a\u0430\u0435\u0448?\u00bb \u0412\u043e\u0441\u044c \u0436\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u0442\u0440\u044b\u0432\u0430\u0435\u0448 \u0443 \u043f\u0430\u043c\u044b\u043b\u0446\u044b, \u044f \u0445\u0430\u0447\u0443 \u0446\u044f\u0431\u0435 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u043d\u0430\u0437\u0430\u0434; \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u0437\u0433\u0443\u0431\u0456\u045e\u0441\u044f, \u0445\u0430\u0447\u0443 \u0430\u0434\u0448\u0443\u043a\u0430\u0446\u044c \u0446\u044f\u0431\u0435. \u00ab\u0410\u043b\u0435 \u044f \u0445\u0430\u0447\u0443 \u0431\u043b\u0443\u043a\u0430\u0446\u044c, \u0445\u0430\u0447\u0443 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b \u0445\u043e\u0447\u0430\u0448 \u0431\u043b\u0443\u043a\u0430\u0446\u044c, \u0445\u043e\u0447\u0430\u0448 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c? \u0410\u043b\u0435 \u044f \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0445\u0430\u0447\u0443 \u0433\u044d\u0442\u0430\u0433\u0430. \u0421\u043a\u0430\u0436\u0443 \u0432\u044b\u0440\u0430\u0437\u043d\u0430, \u044f \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u044b. \u041f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u044e\u0441\u044f \u0434\u0430 \u0441\u043b\u043e\u0432\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430: \u00ab\u041f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0439 \u0441\u043b\u043e\u0432\u0430, \u0431\u0443\u0434\u0437\u044c \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u044b \u045e \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0456 \u043d\u0435\u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0447\u0430\u0441\u00bb (2 \u0426\u0456\u043c 4, 2). \u0414\u043b\u044f \u043a\u0430\u0433\u043e \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b? \u0414\u043b\u044f \u043a\u0430\u0433\u043e \u043d\u0435\u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b? \u0414\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0445\u043e\u0447\u0430, \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b; \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u0445\u043e\u0447\u0430, \u043d\u0435\u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u044f \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u044b \u0456 \u0441\u043a\u0430\u0436\u0443 \u0430\u0434\u043a\u0440\u044b\u0442\u0430: \u00ab\u0422\u044b \u0445\u043e\u0447\u0430\u0448 \u0431\u043b\u0443\u043a\u0430\u0446\u044c, \u0445\u043e\u0447\u0430\u0448 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c, \u0430 \u044f \u043d\u0435 \u0445\u0430\u0447\u0443\u00bb. \u0414\u0430\u0440\u044d\u0447\u044b, \u043d\u0435 \u0445\u043e\u0447\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u044f \u0431\u0430\u044e\u0441\u044f. \u041a\u0430\u043b\u0456 \u0431 \u044f \u0441\u0430\u0441\u0442\u0443\u043f\u0456\u045e, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0448\u0442\u043e \u0401\u043d \u043c\u043d\u0435 \u0441\u043a\u0430\u0436\u0430: \u00ab\u0412\u044b \u043d\u0435 \u0432\u044f\u0440\u0442\u0430\u043b\u0456 \u0442\u0443\u044e, \u0448\u0442\u043e \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0430, \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u0443\u044e \u0432\u044b \u043d\u0435 \u0448\u0443\u043a\u0430\u043b\u0456\u00bb. \u0426\u0456 \u0436 \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u043e\u043b\u044c\u0448 \u0431\u0430\u044f\u0446\u0446\u0430 \u0446\u044f\u0431\u0435, \u0430 \u043d\u0435 \u042f\u0433\u043e? \u00ab\u0423\u0441\u0435 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430\u00bb (2 \u041a\u0430\u0440 5, 10).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0443\u044e \u0430\u0432\u0435\u0447\u043a\u0443 \u043f\u0430\u043a\u043b\u0456\u0447\u0443, \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u0443\u044e \u2013 \u0431\u0443\u0434\u0443 \u0448\u0443\u043a\u0430\u0446\u044c. \u0425\u043e\u0447\u0430\u0448 \u0446\u0456 \u043d\u0435, \u044f \u0431\u0443\u0434\u0443 \u0442\u0430\u043a \u0440\u0430\u0431\u0456\u0446\u044c. \u041f\u0440\u0430\u0439\u0434\u0443 \u043a\u043e\u0436\u043d\u0430\u0439 \u0441\u0446\u0435\u0436\u043a\u0430\u0439, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u043f\u043e\u0448\u0443\u043a\u0443 \u043c\u044f\u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u043d\u0456\u0446\u044c \u0434\u0437\u0456\u043a\u0430\u0435 \u043a\u0443\u0441\u0442\u043e\u045e\u0435. \u0417\u043d\u0456\u0448\u0447\u0443 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u0440\u043e\u0437\u043d\u044b \u0411\u043e\u0433 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u044c \u043c\u0430\u0435 \u0441\u0456\u043b\u044b, \u043f\u0440\u0430\u0439\u0434\u0443 \u045e\u0441\u0435 \u043f\u0430\u0448\u044b. \u0417\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0443\u044e \u043f\u0430\u043a\u043b\u0456\u0447\u0443, \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u0443\u044e \u0431\u0443\u0434\u0443 \u0448\u0443\u043a\u0430\u0446\u044c. \u041a\u0430\u043b\u0456 \u043d\u0435 \u0445\u043e\u0447\u0430\u0448, \u043a\u0430\u0431 \u044f \u0446\u044f\u0440\u043f\u0435\u045e, \u043d\u0435 \u0456\u043c\u043a\u043d\u0456\u0441\u044f \u0431\u043b\u0443\u043a\u0430\u0446\u044c, \u043d\u0435 \u0456\u043c\u043a\u043d\u0456\u0441\u044f \u0437\u0433\u0443\u0431\u0456\u0446\u0446\u0430. \u0426\u0456 \u043d\u0435 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u044f \u045e\u0436\u043e \u043f\u0430\u043a\u0443\u0442\u0443\u044e \u0430\u0434 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0442\u044b \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u045e \u0456 \u0437\u0433\u0443\u0431\u0456\u045e\u0441\u044f. \u0422\u0430\u043c\u0443 \u044f \u0431\u0430\u044e\u0441\u044f, \u043a\u0430\u0431, \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u045e\u0448\u044b \u0446\u044f\u0431\u0435, \u043d\u0435 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0448\u043a\u043e\u0434\u0443 \u0442\u043e\u0439, \u044f\u043a\u0430\u044f \u043c\u043e\u0446\u043d\u0430\u044f. \u041f\u0430\u0447\u0443\u0439 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b: \u00ab\u041c\u043e\u0446\u043d\u0443\u044e \u0432\u044b \u0437\u0430\u0433\u0443\u0431\u0456\u043b\u0456\u00bb (\u043f\u0430\u0440. \u042d\u0437\u0445 34, 3). \u041a\u0430\u043b\u0456 \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u044e \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0443\u044e \u0456 \u0437\u0430\u0433\u0443\u0431\u043b\u0435\u043d\u0443\u044e, \u0442\u043e \u0456 \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u043b\u0456\u0447\u044b\u0446\u0446\u0430 \u043c\u043e\u0446\u043d\u0430\u0439, \u0437\u0430\u0445\u043e\u0447\u0430 \u0431\u043b\u0443\u043a\u0430\u0446\u044c \u0456 \u0433\u0443\u0431\u043b\u044f\u0446\u0446\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0421\u0456\u0440 4, 28-29; 2 \u0426\u0456\u043c 4, 2\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0435 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u0441\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u0442\u0440\u044d\u0431\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u043b\u043e\u0432\u0430\u0445, \u0430 \u0432\u0435\u0434\u044b \u2013 \u0443 \u043c\u043e\u0432\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0439 \u0441\u043b\u043e\u0432\u0430, \u0431\u0443\u0434\u0437\u044c \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u044b \u045e \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0456 \u043d\u0435\u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0447\u0430\u0441, \u0430\u0441\u043f\u0440\u044d\u0447\u0432\u0430\u0439, \u043f\u0430\u043f\u0440\u0430\u045e\u043b\u044f\u0439, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0439 \u0437 \u0443\u0441\u0451\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u045e \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"253","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 46, 18-19: CCL 41, 544-546)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u0430\u0441\u0446\u0451\u043b \u0443\u0441\u044e\u0434\u044b \u0440\u0430\u0437\u0440\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u044f\u043a \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u044f \u043b\u0430\u0437\u0430<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u00ab\u0411\u043b\u0443\u043a\u0430\u044e\u0446\u044c \u0430\u0432\u0435\u0447\u043a\u0456 \u041c\u0430\u0435 \u043f\u0430 \u045e\u0441\u0456\u0445 \u0433\u0430\u0440\u0430\u0445 \u0456 \u043f\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u0432\u044b\u0441\u043e\u043a\u0456\u043c \u043f\u0430\u0433\u043e\u0440\u043a\u0443, \u0456 \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456\u0441\u044f \u0430\u0432\u0435\u0447\u043a\u0456 \u041c\u0430\u0435\u00bb (\u042d\u0437\u0445 34, 6). \u0428\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u00ab\u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456\u0441\u044f \u0430\u0432\u0435\u0447\u043a\u0456 \u041c\u0430\u0435\u00bb? \u042f\u043d\u044b \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439, \u043f\u0440\u044b\u0432\u044f\u0437\u0430\u043d\u044b\u0445 \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u0437\u044f\u043c\u043d\u043e\u0433\u0430, \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u043b\u044e\u0431\u044f\u0446\u044c \u0456 \u0446\u044d\u043d\u044f\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u043b\u0456\u0448\u0447\u044b\u0446\u044c \u0437\u0432\u043e\u043d\u043a\u0443. \u0422\u0430\u043a\u0456\u044f \u043d\u0435 \u0445\u043e\u0447\u0443\u0446\u044c \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c, \u043d\u0435 \u0445\u043e\u0447\u0443\u0446\u044c, \u043a\u0430\u0431 \u0456\u0445 \u0436\u044b\u0446\u0446\u0451 \u0431\u044b\u043b\u043e \u045e\u043a\u0440\u044b\u0442\u0430\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435. \u00ab\u041f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456\u00bb, \u0431\u043e \u043b\u044e\u0431\u044f\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u044f\u043c\u043d\u043e\u0435, \u0431\u043e \u0430\u0432\u0435\u0447\u043a\u0456 \u0431\u043b\u0443\u043a\u0430\u044e\u0446\u044c \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456. \u0410\u043f\u044b\u043d\u0430\u044e\u0446\u0446\u0430 \u043d\u0430 \u043c\u043d\u043e\u0433\u0456\u0445 \u043c\u0435\u0441\u0446\u0430\u0445, \u0430\u043b\u0435 \u0456\u0445 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0430\u0434\u043d\u0430 \u043c\u0430\u0446\u0456 \u2013 \u043f\u044b\u0445\u0430, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0430\u0434\u043d\u0430 \u043c\u0430\u0446\u0456, &nbsp; \u041a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u0443\u0441\u0456\u0445 \u0432\u0435\u0440\u043d\u044b\u0445 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e, \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b\u0445 \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u0456\u0447\u043e\u0433\u0430 \u0434\u0437\u0456\u045e\u043d\u0430\u0433\u0430, \u0448\u0442\u043e \u043f\u044b\u0445\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u043f\u0430\u0434\u0437\u0435\u043b, \u0430 \u043b\u044e\u0431\u043e\u045e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u0430\u0446\u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u0433\u044d\u0442\u0430\u044f \u043c\u0430\u0446\u0456, \u041a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b, \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u041f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u0443\u0441\u044e\u0434\u044b \u0448\u0443\u043a\u0430\u0435 \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u044b\u0445, \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0441\u043b\u0430\u0431\u044b\u0445, \u043b\u0435\u0447\u044b\u0446\u044c \u0445\u0432\u043e\u0440\u044b\u0445, \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0432\u0430\u0435 \u0440\u0430\u043d\u044b \u0441\u043a\u0430\u043b\u0435\u0447\u0430\u043d\u044b\u043c, \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0442\u044b\u0445 \u0456 \u0434\u0440\u0443\u0433\u0456\u0445. \u042f\u043d\u044b \u043d\u0435 \u0437\u043d\u0430\u0451\u043c\u044b\u044f \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u044e, \u0430\u043b\u0435 \u041a\u0430\u0441\u0446\u0451\u043b \u0432\u0435\u0434\u0430\u0435 \u045e\u0441\u0456\u0445, \u0431\u043e \u0451\u043d \u0437 \u0443\u0441\u0456\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0456\u0431\u044b \u0442\u0430\u044f \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u044f \u043b\u0430\u0437\u0430, \u044f\u043a\u0430\u044f \u045e\u0441\u044e\u0434\u044b \u0440\u0430\u0437\u0440\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u043b\u043e\u0434. \u042f\u043d\u044b \u2013 \u043d\u0456\u0431\u044b \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043b\u0456\u0432\u044b\u044f \u0433\u0430\u043b\u0456\u043d\u044b, \u044f\u043a\u0456\u044f \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0451\u0439 \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0431\u044b\u043b\u0456 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u044f \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0430\u0440\u0430\u043c, \u043a\u0430\u0431 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u044f \u043b\u0430\u0437\u0430 \u0431\u044b\u043b\u0430 \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430, \u0430\u043b\u0435 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u0430. \u0413\u0430\u043b\u0456\u043d\u043a\u0456 \u0437\u0430\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0442\u0430\u043c, \u0434\u0437\u0435 \u0456\u0445 \u0430\u0431\u0440\u044d\u0437\u0430\u043b\u0456. \u0412\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a \u0436\u0430, \u0440\u0430\u0437\u0440\u0430\u0441\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0432\u0430 \u045e\u0441\u0435 \u0431\u0430\u043a\u0456, \u0432\u0435\u0434\u0430\u0435 \u0441\u0432\u0430\u0435 \u0433\u0430\u043b\u0456\u043d\u044b: \u0442\u044b\u0445, \u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437\u0430\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u045e \u0456\u043c, \u0456 \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u043f\u0430-\u0437\u0430 \u0456\u043c, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u044b\u043c \u043d\u0435 \u043c\u0435\u043d\u0448, \u0451\u043d \u043a\u043b\u0456\u0447\u0430 \u0431\u043b\u0443\u043a\u0430\u044e\u0447\u044b\u0445, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043f\u0440\u0430 \u0430\u0434\u0440\u044d\u0437\u0430\u043d\u044b\u044f \u0433\u0430\u043b\u0456\u043d\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: \u00ab\u0431\u043e \u043c\u0430\u0435 \u0411\u043e\u0433 \u043c\u043e\u0446 \u0456\u0437\u043d\u043e\u045e \u043f\u0440\u044b\u0448\u0447\u0430\u043f\u0456\u0446\u044c \u0456\u0445!\u00bb (\u0420\u044b\u043c 11, 23). \u0426\u0456 \u0442\u043e \u043c\u043e\u0432\u0430 \u043f\u0440\u0430 \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a, \u0446\u0456 \u043f\u0440\u0430 \u0430\u0434\u0440\u044d\u0437\u0430\u043d\u044b\u044f \u0433\u0430\u043b\u0456\u043d\u044b, \u0430\u043b\u0435 \u0411\u043e\u0433, \u044f\u043a \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u041f\u0430\u0441\u0442\u044b\u0440 \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u0412\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0430\u0440, \u043c\u043e\u0436\u0430 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u0430\u0432\u0435\u0447\u0430\u043a \u043d\u0430\u0437\u0430\u0434 \u0456 \u0437\u043d\u043e\u045e \u043f\u0440\u044b\u0448\u0447\u0430\u043f\u0456\u0446\u044c \u0433\u0430\u043b\u0456\u043d\u044b. \u00ab\u041f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0456\u0441\u044f \u0430\u0432\u0435\u0447\u043a\u0456 \u041c\u0430\u0435. \u041d\u0456\u0445\u0442\u043e \u0456\u0445 \u043d\u0435 \u043f\u0456\u043b\u044c\u043d\u0430\u0432\u0430\u045e, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0448\u0443\u043a\u0430\u045e \u0456\u0445\u00bb (\u042d\u0437\u0445 34, 6). \u0421\u044f\u0440\u043e\u0434 \u0434\u0440\u044d\u043d\u043d\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0456\u043a\u043e\u0433\u0430, \u0445\u0442\u043e \u0431 \u0456\u0445 \u0448\u0443\u043a\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u00ab\u0422\u0430\u043c\u0443, \u043f\u0430\u0441\u0442\u044b\u0440\u044b, \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430: \u042f \u0436\u044b\u0432\u044b, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433\u00bb (\u042d\u0437\u0445 34, 7). \u0417\u0430\u045e\u0432\u0430\u0436\u0446\u0435, \u044f\u043a\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0440\u0430\u0441\u043f\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435. \u0413\u044d\u0442\u0430 \u043d\u0456\u0431\u044b \u043f\u0440\u044b\u0441\u044f\u0433\u0430, \u044f\u043a\u0430\u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0441\u0432\u0435\u0434\u043a\u0456. \u00ab\u042f \u0436\u044b\u0432\u044b, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433\u00bb. \u041f\u0430\u0441\u0442\u044b\u0440\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0430\u043b\u0435 \u0430\u0432\u0435\u0447\u043a\u0456 \u043c\u0430\u044e\u0446\u044c \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0431\u043e \u041f\u0430\u043d \u0436\u044b\u0432\u0435. \u00ab\u042f \u0436\u044b\u0432\u044b, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433\u00bb. \u042f\u043a\u0456\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456? \u0422\u044b\u044f, \u044f\u043a\u0456\u044f \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u0430 \u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0426\u0456 \u0437\u2019\u044f\u0432\u044f\u0446\u0446\u0430, \u0446\u0456 \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u0446\u0430 \u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0448\u0443\u043a\u0430\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u0430\u043b\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430? \u041d\u0430\u043f\u044d\u045e\u043d\u0430 \u0431\u0443\u0434\u0443\u0446\u044c, \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u0446\u0430. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0456\u0445 \u043d\u0435\u0441\u0442\u0430\u0432\u0430\u0446\u044c \u043d\u0456 \u0446\u044f\u043f\u0435\u0440, \u043d\u0456 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u0456.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">2 \u041a\u0430\u0440 3, 4. 6. 5\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u0430\u043a\u0456 \u0434\u0430\u0432\u0435\u0440 \u043c\u044b \u043c\u0430\u0435\u043c \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u043d\u0430\u0441 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c\u0456 \u0431\u044b\u0446\u044c \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443: \u043d\u0435 \u043b\u0456\u0442\u0430\u0440\u044b, \u0430\u043b\u0435 \u0414\u0443\u0445\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043c\u044b \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u044f \u0434\u0443\u043c\u0430\u0446\u044c \u043d\u0435\u0448\u0442\u0430 \u0430\u0434 \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u044f \u0430\u0434 \u0411\u043e\u0433\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u042f\u043a\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"254","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 46, 20-21: CCL 41, 546-548)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0420\u0430\u0431\u0456\u0446\u0435, \u0448\u0442\u043e \u0432\u0430\u043c \u0441\u043a\u0430\u0436\u0443\u0446\u044c, \u0430\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u0456\u0445\u043d\u0456\u0445 \u043d\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0439\u0446\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0422\u0430\u043c\u0443, \u043f\u0430\u0441\u0442\u044b\u0440\u044b, \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430\u00bb. \u0428\u0442\u043e \u0432\u044b \u0447\u0443\u0435\u0446\u0435, \u043f\u0430\u0441\u0442\u044b\u0440\u044b? \u00ab\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0411\u043e\u0433: \u201c\u0412\u043e\u0441\u044c \u042f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e. \u042f \u0441\u043f\u0430\u0433\u0430\u043d\u044e \u0441\u0432\u043e\u0439 \u0441\u0442\u0430\u0442\u0430\u043a \u0437 \u0456\u0445\u043d\u0456\u0445 \u0440\u0443\u043a\u00bb (\u042d\u0437\u0445 34, 9).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0456 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439, \u0411\u043e\u0436\u0430\u044f \u0430\u045e\u0447\u0430\u0440\u043d\u044f: \u0411\u043e\u0433 \u0441\u043f\u0430\u0433\u043e\u043d\u0456\u0446\u044c \u0437 \u0440\u0443\u043a \u0434\u0440\u044d\u043d\u043d\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a, \u0441\u043f\u0430\u0433\u043e\u043d\u0456\u0446\u044c \u0440\u0430\u0445\u0443\u043d\u0430\u043a \u0437\u0430 \u0456\u0445 \u0441\u043c\u0435\u0440\u0446\u044c. \u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043a\u0430\u0436\u0430 \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0442\u0430\u0433\u043e \u0441\u0430\u043c\u0430\u0433\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430: \u00abC\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u042f \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u043e\u043c \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0406 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u041c\u0430\u0456\u0445, \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0435\u0440\u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0446\u044c \u0456\u0445 \u0430\u0434 \u041c\u0430\u0439\u0433\u043e \u0456\u043c\u044f. \u041a\u0430\u043b\u0456 \u042f \u0441\u043a\u0430\u0436\u0443 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0443: \u201c\u0411\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a, \u0442\u044b \u043f\u0430\u043c\u0440\u044d\u0448\u201d, \u0430 \u0442\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u043a\u0430\u0431 \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0447\u044b \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430 \u0430\u0434 \u044f\u0433\u043e \u0434\u0430\u0440\u043e\u0433\u0456, \u0442\u043e \u0451\u043d \u043f\u0430\u043c\u0440\u044d \u045e \u0441\u0432\u0430\u0451\u0439 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0437\u0430 \u044f\u0433\u043e\u043d\u0443\u044e \u043a\u0440\u043e\u045e \u0431\u0443\u0434\u0437\u0435\u0448 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u0442\u044b. \u041a\u0430\u043b\u0456 \u0436 \u0430\u0441\u0446\u0435\u0440\u0430\u0436\u044d\u0448 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430 \u0430\u0434 \u044f\u0433\u043e \u0434\u0430\u0440\u043e\u0433\u0456, \u043a\u0430\u0431 \u0451\u043d \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0430\u0434 \u044f\u0435, \u0456 \u0451\u043d \u043d\u0435 \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0440\u043e\u0433\u0456, \u0442\u043e \u0451\u043d \u043f\u0430\u043c\u0440\u044d \u045e \u0441\u0432\u0430\u0451\u0439 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430 \u0442\u044b \u045e\u0440\u0430\u0442\u0443\u0435\u0448 \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443\u00bb (\u042d\u0437\u0445 33, 7-9).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u044b\u043a \u0448\u0442\u043e \u0436, \u0431\u0440\u0430\u0442\u044b? \u0426\u0456 \u0432\u044b \u045e\u0436\u043e \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0446\u0435, \u044f\u043a \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u043c\u0430\u045e\u0447\u0430\u0446\u044c? \u0411\u044f\u0437\u0431\u043e\u0436\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u043c\u0440\u044d, \u0456 \u043f\u0430\u043c\u0440\u044d \u0437\u0430\u0441\u043b\u0443\u0436\u0430\u043d\u0430. \u041f\u0430\u043c\u0440\u044d \u045e \u0441\u0432\u0430\u0451\u0439 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0456 \u045e \u0441\u0432\u0430\u0456\u043c \u0433\u0440\u0430\u0445\u0443. \u042f\u0433\u043e \u045e\u043b\u0430\u0441\u043d\u0430\u0435 \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u043d\u043d\u0435 \u0437\u0430\u0431\u0456\u043b\u0430 \u044f\u0433\u043e. \u0411\u043e \u0451\u043d \u043c\u043e\u0433 \u0431\u044b \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0436\u044b\u0432\u043e\u0433\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430: \u00ab\u201d\u042f \u0436\u044b\u0432\u044b\u201d, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d\u00bb. \u0410\u043b\u0435 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u044b\u045e \u043d\u044f\u0434\u0431\u0430\u043b\u044b \u0456 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u044b\u045e \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u043e\u043c \u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c, \u043a\u0430\u0431 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u045e, \u0442\u0430\u043c\u0443 \u0442\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043f\u0430\u043c\u0440\u044d, \u0430\u043b\u0435 \u0456 \u0433\u044d\u0442\u044b \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041a\u0430\u043b\u0456 \u0430\u0434\u043d\u0430\u043a, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0442\u044b \u0441\u043a\u0430\u0436\u0430\u0448 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u043c\u0443, \u044f\u043a\u043e\u043c\u0443 \u042f \u043f\u0440\u044b\u0433\u0440\u0430\u0437\u0456\u045e \u043c\u044f\u0447\u043e\u043c: \u201c\u0422\u044b \u043f\u0430\u043c\u0440\u044d\u0448\u201d, \u0430 \u0451\u043d \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u0435 \u0441\u0432\u0430\u0451 \u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435 \u0430\u0434 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f, \u0456 \u043c\u0435\u0447 \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u044f\u0433\u043e \u0456 \u0437\u0430\u0431\u2019\u0435, \u0442\u0430\u0434\u044b \u0451\u043d \u043f\u0430\u043c\u0440\u044d \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u0440\u0430\u0445\u0443, \u0430 \u0442\u044b \u045e\u0440\u0430\u0442\u0443\u0435\u0448 \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443\u00bb. \u0422\u0430\u043c\u0443 \u043d\u0430\u043c \u043d\u0435\u043b\u044c\u0433\u0430 \u043c\u0430\u045e\u0447\u0430\u0446\u044c. \u0412\u044b \u0436, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u043c\u044b \u043c\u0430\u045e\u0447\u044b\u043c, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u0441\u0442\u044b\u0440\u0430, \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u044b\u044f \u045e \u0421\u0432\u044f\u0442\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u043c \u043d\u0430\u0434 \u0442\u044b\u043c, \u043f\u0440\u0430 \u0448\u0442\u043e \u045e\u0436\u043e \u043a\u0430\u0437\u0430\u043b\u0456, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u0446\u0456 \u0411\u043e\u0433 \u0437\u0430\u0431\u044f\u0440\u044d \u045e \u0434\u0440\u044d\u043d\u043d\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e \u0430\u0432\u0435\u0447\u0430\u043a. \u041b\u0456\u0447\u0443, \u0448\u0442\u043e \u0437\u0430\u0431\u044f\u0440\u044d \u0430\u0432\u0435\u0447\u0430\u043a \u0443 \u0434\u0440\u044d\u043d\u043d\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0456\u0445 \u0434\u043e\u0431\u0440\u044b\u043c. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u043a\u0430\u0436\u0430: \u00ab\u042f \u2013 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e. \u042f \u0441\u043f\u0430\u0433\u0430\u043d\u044e \u0441\u0432\u043e\u0439 \u0441\u0442\u0430\u0442\u0430\u043a \u0437 \u0456\u0445\u043d\u0456\u0445 \u0440\u0443\u043a \u0456 \u045e\u0447\u044b\u043d\u044e, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u044c \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a. \u0411\u043e \u043a\u0430\u043b\u0456 \u042f \u043a\u0430\u0436\u0443: \u201c\u041f\u0430\u0441\u0456\u0446\u0435 \u041c\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a\u201d, \u0442\u043e \u044f\u043d\u044b \u043f\u0430\u0441\u0443\u0446\u044c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u0430 \u043d\u0435 \u0430\u0432\u0435\u0447\u0430\u043a. \u0423\u0447\u044b\u043d\u044e, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u044c \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0401\u043d \u0430\u0434\u0431\u0456\u0440\u0430\u0435 \u0441\u0432\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a, \u043a\u0430\u0431 \u0442\u044b\u044f \u043d\u0435 \u0431\u044b\u043b\u0456 \u045e\u0436\u043e \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456? \u00ab\u0423\u0441\u0451, \u0448\u0442\u043e \u0441\u043a\u0430\u0436\u0443\u0446\u044c \u0432\u0430\u043c, \u0440\u0430\u0431\u0456\u0446\u0435 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u0456\u0445\u043d\u0456\u0445\u00bb (\u041c\u0446 23, 3). \u0401\u043d \u043d\u0456\u0431\u044b \u043a\u0430\u0436\u0430: \u00ab\u0422\u043e\u0435, \u0448\u0442\u043e \u044f\u043d\u044b \u043a\u0430\u0436\u0443\u0446\u044c, \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u041c\u044f\u043d\u0435, \u0430 \u0448\u0442\u043e \u0440\u043e\u0431\u044f\u0446\u044c \u2013 \u0430\u0434 \u0456\u0445 \u0441\u0430\u043c\u0456\u0445\u00bb. \u041a\u0430\u043b\u0456 \u0432\u044b \u043d\u0435 \u0440\u043e\u0431\u0456\u0446\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0440\u043e\u0431\u044f\u0446\u044c \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b, \u2013 \u044f\u043d\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0432\u0430\u0448\u044b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b. \u041a\u0430\u043b\u0456 \u0432\u044b \u0437\u0440\u043e\u0431\u0456\u0446\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u044e\u0446\u044c, \u042f \u2013 \u0432\u0430\u0448 \u041f\u0430\u0441\u0442\u044b\u0440.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041b\u043a 12, 42. 43; 1 \u041a\u0430\u0440 4, 2\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0425\u0442\u043e \u0436 \u0432\u0435\u0440\u043d\u044b \u0456 \u0440\u0430\u0437\u0443\u043c\u043d\u044b \u044d\u043a\u0430\u043d\u043e\u043c, \u044f\u043a\u043e\u0433\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043d\u0430\u0434 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456? <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439 \u0441\u043b\u0443\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u044f\u0433\u043e\u043d\u044b, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u0437\u0430\u0441\u0442\u0430\u043d\u0435, \u0448\u0442\u043e \u0451\u043d \u0442\u0430\u043a \u0440\u043e\u0431\u0456\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410\u0434 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u045e \u0436\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u0430\u043a\u0430\u0437\u0430\u045e\u0441\u044f \u0432\u0435\u0440\u043d\u044b\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"255","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 46, 24-25. 27: CCL 41, 551-553)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0430 \u0434\u043e\u0431\u0440\u044b\u0445 \u043f\u0430\u0448\u0430\u0445 \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u042f \u0432\u044b\u0432\u0435\u0434\u0443 \u0456\u0445 \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u0437\u0431\u044f\u0440\u0443 \u0456\u0445 \u0437 \u043a\u0440\u0430\u0456\u043d\u0430\u045e, \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0456\u0445 \u0443 \u0437\u044f\u043c\u043b\u044e \u0456\u0445\u043d\u044e\u044e, \u0456 \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445 \u043d\u0430 \u0433\u043e\u0440\u0430\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f\u00bb (\u042d\u0437\u0445 34, 13). \u0410\u045e\u0442\u0430\u0440\u044b \u0441\u0432\u044f\u0442\u044b\u0445 \u041a\u043d\u0456\u0433 \u043d\u0430\u0437\u0432\u0430\u043d\u044b\u044f \u0442\u0443\u0442 \u00ab\u0433\u0430\u0440\u0430\u043c\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044f\u00bb. \u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0446\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430, \u043f\u0430\u0441\u0456\u0446\u0435 \u0442\u0430\u043c. \u0423\u0441\u0451, \u0448\u0442\u043e \u043f\u0430\u0447\u0443\u0435\u0446\u0435 \u0442\u0430\u043c, \u043a\u0430\u0448\u0442\u0443\u0439\u0446\u0435 \u0437 \u0430\u0441\u0430\u043b\u043e\u0434\u0430\u0439, \u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0432\u043e\u043d\u043a\u0443, \u0430\u0434\u043a\u0456\u0434\u0432\u0430\u0439\u0446\u0435. \u0417\u0431\u0456\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u0432\u0430\u043a\u043e\u043b \u0433\u043e\u0440 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f. \u0422\u0430\u043c \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u0440\u0430\u0441\u043a\u043e\u0448\u0443 \u0432\u0430\u0448\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430, \u0442\u0430\u043c \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u0430\u0442\u0440\u0443\u0442\u043d\u0430\u0433\u0430, \u043d\u0456\u0447\u043e\u0433\u0430 \u0448\u043a\u043e\u0434\u043d\u0430\u0433\u0430, \u0442\u0430\u043c \u2013 \u0441\u0430\u043c\u0430\u044f \u0431\u0430\u0433\u0430\u0442\u0430\u044f \u043f\u0430\u0448\u0430. \u041f\u0440\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u043c\u0456 \u0456 \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u044f \u043f\u0430\u0441\u0432\u0456\u0446\u0435\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u0430\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041a\u0430\u043b\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u045e \u0456 \u043f\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u0441\u0435\u043b\u0456\u0448\u0447\u0430\u0445 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456\u00bb (\u042d\u0437\u0445 34, 13). \u0417 \u0433\u043e\u0440, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u043c\u044b \u043a\u0430\u0437\u0430\u043b\u0456, \u0432\u044b\u043f\u043b\u044b\u0432\u0430\u044e\u0446\u044c \u043f\u0430\u0442\u043e\u043a\u0456 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f, \u0431\u043e \u00ab\u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0440\u0430\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0456\u0445 \u0433\u043e\u043b\u0430\u0441\u00bb, \u0430 \u045e\u0441\u0435 \u0437\u0430\u0441\u0435\u043b\u0435\u043d\u044b\u044f \u043c\u0435\u0441\u0446\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u0431\u0430\u0433\u0430\u0442\u0430\u0439 \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0439 \u043f\u0430\u0448\u0430\u0439 \u0434\u043b\u044f \u0430\u0432\u0435\u0447\u0430\u043a.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041d\u0430 \u0434\u043e\u0431\u0440\u0430\u0439 \u043f\u0430\u0448\u044b \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445 \u0456 \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u0456\u0445 \u0433\u0430\u0440\u0430\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0433\u043e\u043d \u0456\u0445\u043d\u0456. \u0422\u0430\u043c \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c \u0443 \u0434\u043e\u0431\u0440\u044b\u043c \u0437\u0430\u0433\u043e\u043d\u0435\u00bb (\u042d\u0437\u0445 34, 14). \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0442\u0430\u043c \u044f\u043d\u044b \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u0430\u0434\u043f\u0430\u0447\u044b\u0446\u044c \u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u0414\u043e\u0431\u0440\u0430 \u043d\u0430\u043c \u0442\u0443\u0442\u00bb, \u0442\u0430\u043c \u044f\u043d\u044b \u043c\u043e\u0433\u0443\u0446\u044c \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0446\u044c: \u00ab\u0413\u044d\u0442\u0430 \u043f\u0440\u0430\u045e\u0434\u0430, \u0433\u044d\u0442\u0430 \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u043c\u044b \u043d\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0435\u043c\u0441\u044f \u045e \u0433\u044d\u0442\u044b\u043c\u00bb. \u0410\u0434\u043f\u0430\u0447\u043d\u0443\u0446\u044c \u0443 \u0445\u0432\u0430\u043b\u0435 \u041f\u0430\u043d\u0430, \u044f\u043a \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u0437\u0430\u0433\u043e\u043d\u0430\u0445. \u0406 \u0431\u0443\u0434\u0443\u0446\u044c&nbsp; \u0441\u043f\u0430\u0446\u044c, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u00ab\u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c\u00bb \u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0411\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u043d\u0430 \u043f\u0430\u0436\u044b\u045e\u043d\u0430\u0439 \u043f\u0430\u0448\u044b, \u043d\u0430 \u0433\u0430\u0440\u0430\u0445 \u0406\u0437\u0440\u0430\u044d\u043b\u044f\u00bb (\u043f\u0430\u0440. \u042d\u0437\u0445 34, 14). \u042f \u0437\u0433\u0430\u0434\u0430\u045e \u043f\u0440\u0430 \u0433\u043e\u0440\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0434\u043e\u0431\u0440\u044b\u044f \u0433\u043e\u0440\u044b, \u043a\u0443\u0434\u044b \u043c\u044b \u045e\u0437\u043d\u043e\u0441\u0456\u043c \u0432\u043e\u0447\u044b, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0430\u0434\u0442\u0443\u043b\u044c \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443. \u0410\u043b\u0435 \u043d\u0430\u0448\u0430\u044f \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430 \u2013 \u0443 \u0456\u043c\u0435\u043d\u0456 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e (\u043f\u0430\u0440. \u041f\u0441 124 [123], 8). \u0422\u0430\u043c\u0443, \u043a\u0430\u0431 \u043d\u0430\u0448\u0430\u044f \u043d\u0430\u0434\u0437\u0435\u044f \u043d\u0435 \u0431\u044b\u043b\u0430 \u0437\u0432\u044f\u0437\u0430\u043d\u0430\u044f \u0437 \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u0433\u0430\u0440\u0430\u043c\u0456, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e: \u00ab\u042f \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a \u041c\u0430\u0456\u0445\u00bb (\u042d\u0437\u0445 34, 15), \u0442\u0443\u0442 \u0436\u0430 \u0434\u0430\u0434\u0430\u0435: \u00ab\u0421\u0430\u043c \u0431\u0443\u0434\u0443 \u045e\u043a\u043b\u0430\u0434\u0432\u0430\u0446\u044c \u0456\u0445 \u043d\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a\u00bb (\u042d\u0437\u0445 34, 16), \u043a\u0430\u0431 \u0442\u044b \u043d\u0435 \u0437\u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u0430\u0445. \u0423\u0437\u043d\u043e\u0441\u044c \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0434\u0430 \u0433\u043e\u0440\u0430\u045e, \u0430\u0434\u043a\u0443\u043b\u044c \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u0446\u044f\u0431\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430, \u0430\u043b\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u0439 \u043f\u0440\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u0430\u0436\u0430: \u00ab\u0421\u0430\u043c \u0431\u0443\u0434\u0443 \u045e\u043a\u043b\u0430\u0434\u0432\u0430\u0446\u044c \u0456\u0445 \u043d\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a\u00bb. \u0411\u043e \u0442\u0432\u0430\u044f \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430 \u2013 \u0443 \u0456\u043c\u0435\u043d\u0456 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u0437\u0430\u043a\u0430\u043d\u0447\u0432\u0430\u0435 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c: \u00ab\u0411\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445 \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435\u00bb (\u043f\u0430\u0440. \u042d\u0437\u0445 34, 16). \u0417\u0430\u045e\u0432\u0430\u0436, \u0448\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0442\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u0425\u0442\u043e \u0436 \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u0437\u043c\u043e\u0436\u0430 \u0430\u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430. \u0423\u0441\u044e\u0434\u044b \u0448\u043c\u0430\u0442 \u0432\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u044b\u0445 \u0441\u0443\u0434\u0436\u044d\u043d\u043d\u044f\u045e. \u0422\u043e\u0439, \u0443 \u043a\u0456\u043c \u043c\u044b \u0437\u0430\u0441\u0443\u043c\u043d\u044f\u0432\u0430\u043b\u0456\u0441\u044f, \u0440\u0430\u043f\u0442\u0430\u043c \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u044b\u043c. \u0422\u043e\u0439 \u0436\u0430, \u043d\u0430 \u043a\u0430\u0433\u043e \u043c\u044b \u0432\u0435\u043b\u044c\u043c\u0456 \u0440\u0430\u0437\u043b\u0456\u0447\u0432\u0430\u043b\u0456, \u043d\u0435\u0447\u0430\u043a\u0430\u043d\u0430 \u043f\u0430\u0434\u0430\u0435 \u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043d\u0430\u0439\u0433\u043e\u0440\u0448\u044b\u043c. \u042f\u043a \u043d\u0430\u0448 \u0441\u0442\u0440\u0430\u0445, \u0442\u0430\u043a \u0456 \u043b\u044e\u0431\u043e\u045e \u0437\u0432\u0435\u0434\u0432\u0430\u044e\u0446\u044c \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0456\u043c \u0441\u0451\u043d\u043d\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043d\u0430\u0432\u0430\u0442 \u0451\u043d \u0441\u0430\u043c. \u0425\u043e\u0446\u044c \u0443 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u0432\u0435\u0434\u0430\u0435, \u043a\u0456\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0451\u043d\u043d\u044f, \u0430\u043b\u0435 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u043a\u0456\u043c \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u045e\u0442\u0440\u0430. \u0422\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u043d \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u0434\u0430\u044e\u0447\u044b \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u044f\u0433\u043e\u043d\u0430\u0435. \u0410\u0434\u043d\u044b\u043c \u2013 \u0430\u0434\u043d\u043e, \u0434\u0440\u0443\u0433\u0456\u043c \u2013 \u0434\u0440\u0443\u0433\u043e\u0435. \u041a\u043e\u0436\u043d\u0430\u043c\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u044f\u043c\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c: \u0442\u043e\u0435 \u0446\u0456 \u0456\u043d\u0448\u0430\u0435. \u0401\u043d \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u044c. \u041f\u0430\u0441\u0432\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0430\u0441\u0443\u0434\u0437\u0456\u045e \u0456 \u0430\u0434\u043a\u0443\u043f\u0456\u045e. \u0422\u0430\u043c\u0443 \u0401\u043d \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042f\u043d 10, 14; \u042d\u0437\u0445 34, 11. 13\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u2013 \u0434\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440 <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0432\u0435\u0434\u0430\u044e \u0441\u0432\u0430\u0456\u0445, \u0430 \u041c\u0430\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u041c\u044f\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0412\u043e\u0441\u044c \u042f \u0441\u0430\u043c \u0431\u0443\u0434\u0443 \u0448\u0443\u043a\u0430\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a \u041c\u0430\u0456\u0445 \u0456 \u043f\u0435\u0440\u0430\u0433\u043b\u0435\u0434\u0436\u0443 \u0456\u0445, \u042f \u0432\u044b\u0432\u0435\u0434\u0443 \u0456\u0445 \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0432\u0435\u0434\u0430\u044e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"256","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 46, 29-30: CCL 41, 555-557)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0414\u043e\u0431\u0440\u044b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b \u0441\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0437 \u0430\u0434\u043d\u044b\u043c \u041f\u0430\u0441\u0442\u044b\u0440\u0430\u043c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u0430\u0434\u0434\u0437\u044f\u043b\u044f\u0435 \u0441\u0432\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0430\u0434 \u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u042f\u043c\u0443 \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c. \u00ab\u0410\u0432\u0435\u0447\u043a\u0456 \u041c\u0430\u0435, \u2013 \u043a\u0430\u0436\u0430, \u2013 \u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u041c\u043e\u0439, \u0456 \u044f\u043d\u044b \u0456\u0434\u0443\u0446\u044c \u0437\u0430 \u041c\u043d\u043e\u044e\u00bb (\u042f\u043d 10, 27).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0430\u0434\u043d\u044b\u043c \u041f\u0430\u0441\u0442\u044b\u0440\u044b \u044f \u0431\u0430\u0447\u0443 \u045e\u0441\u0456\u0445 \u0434\u043e\u0431\u0440\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e. \u041d\u044f\u043c\u0430 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443 \u045e \u0434\u043e\u0431\u0440\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u0445, \u0430\u043b\u0435 \u045e\u0441\u0435 \u044f\u043d\u044b \u0442\u0440\u044b\u0432\u0430\u044e\u0446\u044c \u0443 \u0410\u0434\u043d\u044b\u043c. \u0428\u043c\u0430\u0442 \u0456\u0445 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u043f\u0430\u0434\u0437\u0435\u043b\u0435\u043d\u044b. \u0422\u0443\u0442 \u0437\u0433\u0430\u0434\u0432\u0430\u0435\u0446\u0446\u0430 \u0410\u0434\u0437\u0456\u043d, \u043a\u0430\u0431 \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c. \u0413\u044d\u0442\u0430 \u043d\u044f\u043f\u0440\u0430\u045e\u0434\u0430, \u0448\u0442\u043e \u043d\u0435 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e, \u0430\u043b\u0435 \u043f\u0440\u0430 \u041f\u0430\u0441\u0442\u044b\u0440\u0430, \u0431\u043e \u041f\u0430\u043d \u043d\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0456\u043a\u043e\u0433\u0430, \u043a\u0430\u043c\u0443 \u043c\u043e\u0433 \u0431\u044b \u0434\u0430\u0440\u0443\u0447\u044b\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a. \u0401\u043d \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0434\u0430\u0440\u0443\u0447\u044b\u045e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u041f\u044f\u0442\u0440\u0430. \u0410\u043b\u0435 \u0456 \u045e \u0430\u0441\u043e\u0431\u0435 \u041f\u044f\u0442\u0440\u0430 \u0401\u043d \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456. \u0428\u043c\u0430\u0442 \u0431\u044b\u043b\u043e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043d\u0430\u043c\u0443 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u041f\u0430\u0441\u0456 \u0430\u0432\u0435\u0447\u0430\u043a \u041c\u0430\u0456\u0445\u00bb (\u042f\u043d 21, 17). \u041d\u044f\u043c\u0430 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443 \u045e \u0434\u043e\u0431\u0440\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u0445, \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u045e \u043d\u0430\u0441; \u0411\u043e\u0436\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u0456\u0445 \u0456 \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043d\u0430\u0447\u0430\u043b\u0435 \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u043a\u0430\u043b\u0456 \u0430\u0432\u0435\u0447\u043a\u0456 \u0434\u043e\u0431\u0440\u044b\u044f, \u0442\u043e \u0434\u043e\u0431\u0440\u044b\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043f\u0430\u0441\u0442\u044b\u0440\u044b, \u0431\u043e \u0434\u043e\u0431\u0440\u044b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0434 \u0434\u043e\u0431\u0440\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a. \u0410\u0434\u043d\u0430\u043a \u0443\u0441\u0435 \u0434\u043e\u0431\u0440\u044b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b \u0442\u0440\u044b\u0432\u0430\u044e\u0446\u044c \u0443 \u0410\u0434\u043d\u044b\u043c \u0456 \u045e\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u0430\u0434\u043d\u043e. \u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u043f\u0430\u0441\u0432\u044f\u0446\u044c, \u0442\u043e \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0421\u044f\u0431\u0440\u044b \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430 \u043d\u0435 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0441\u0432\u0430\u0456\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u0430\u043b\u0435 \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u043f\u0430\u0441\u0432\u044f\u0446\u044c, \u0442\u043e \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0456 \u043a\u0430\u0436\u0430: \u00ab\u0413\u044d\u0442\u0430 \u042f \u043f\u0430\u0441\u0443\u00bb. \u0423 \u0456\u0445 \u2013 \u042f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0441 \u0456 \u042f\u0433\u043e \u043b\u044e\u0431\u043e\u045e. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u041f\u044f\u0442\u0440\u0430, \u044f\u043a\u043e\u043c\u0443 \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u0430\u0432\u0435\u0447\u0430\u043a \u043d\u0456\u0431\u044b \u0441\u0430\u043c\u043e\u043c\u0443 \u0441\u0430\u0431\u0435, \u0401\u043d \u0437\u2019\u044f\u0434\u043d\u0430\u045e \u0437 \u0441\u0430\u0431\u043e\u044e. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0401\u043d \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u044f\u043c\u0443 \u0430\u0432\u0435\u0447\u0430\u043a, \u043a\u0430\u0431 \u0441\u0430\u043c\u0430\u043c\u0443 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0413\u0430\u043b\u0430\u0432\u043e\u044e, \u0430 \u041f\u0451\u0442\u0440 \u043a\u0430\u0431 \u0431\u044b\u045e \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0446\u0435\u043b\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0456 \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u043c \u0431\u044b\u0446\u044c, \u0434\u0432\u0430\u0456\u043c \u0443 \u0430\u0434\u043d\u044b\u043c \u0446\u0435\u043b\u0435, \u044f\u043a \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u043a \u0456 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0434\u0430\u0432\u044f\u0440\u0430\u0435 \u0430\u0432\u0435\u0447\u0430\u043a, \u0442\u043e \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u0401\u043d \u0434\u0430\u0432\u044f\u0440\u0430\u0435 \u043a\u0430\u043c\u0443\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u043c\u0443, \u0430 \u043d\u0435 \u0441\u0430\u0431\u0435, \u043f\u044b\u0442\u0430\u0435\u0446\u0446\u0430: \u00ab\u0426\u0456 \u043b\u044e\u0431\u0456\u0448 \u0442\u044b \u041c\u044f\u043d\u0435?\u00bb \u0406 \u0442\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435: \u00ab\u041b\u044e\u0431\u043b\u044e\u00bb. \u0406 \u0437\u043d\u043e\u045e: \u00ab\u0426\u0456 \u043b\u044e\u0431\u0456\u0448 \u0442\u044b \u041c\u044f\u043d\u0435?\u00bb \u0406 \u0451\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u041b\u044e\u0431\u043b\u044e\u00bb. \u0406 \u0442\u0440\u044d\u0446\u0456 \u0440\u0430\u0437: \u00ab\u0426\u0456 \u043b\u044e\u0431\u0456\u0448 \u0442\u044b \u041c\u044f\u043d\u0435?\u00bb \u0406 \u0451\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u041b\u044e\u0431\u043b\u044e\u00bb (\u043f\u0430\u0440. \u042f\u043d 21, 15-17). \u0423\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u043b\u044e\u0431\u043e\u045e, \u043a\u0430\u0431 \u0433\u0430\u0440\u0430\u043d\u0442\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c. \u0422\u0430\u043c\u0443 \u0401\u043d \u0441\u0430\u043c \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0443 \u0456\u0445, \u0430 \u044f\u043d\u044b \u043f\u0430\u0441\u0432\u044f\u0446\u044c \u0443 \u0406\u043c \u0430\u0434\u043d\u044b\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e, \u0456 \u043d\u0435 \u043a\u0430\u0436\u0430. \u0422\u0430\u043c\u0443 \u043f\u0430\u0441\u0442\u044b\u0440\u044b \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u044f\u0446\u0446\u0430, \u0430\u043b\u0435, \u00ab\u0445\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443\u00bb (2 \u041a\u0430\u0440 10, 17). \u0422\u0430\u043a \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0442\u0430\u043a \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u0430 \u043d\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430. \u041d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u041f\u0440\u0430\u0440\u043e\u043a \u043d\u0435 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e \u0443 \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u043b\u0456\u0445\u0456\u043c \u0447\u0430\u0441\u0435. \u041d\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u042f \u0441\u0430\u043c \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a\u00bb, \u0431\u043e \u044f \u043d\u0435 \u043c\u0430\u044e \u043a\u0430\u043c\u0443 \u0456\u0445 \u0434\u0430\u0440\u0443\u0447\u044b\u0446\u044c. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u041f\u0451\u0442\u0440 \u0434\u044b \u0456\u043d\u0448\u044b\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0431\u044b\u043b\u0456 \u044f\u0448\u0447\u044d \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u0430\u0434\u0437\u0456\u043d \u041f\u0430\u0441\u0442\u044b\u0440, \u0442\u043e\u0439, \u0443 \u044f\u043a\u0456\u043c \u0443\u0441\u0435 \u0441\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u0430\u0434\u043d\u043e, \u043a\u0430\u0436\u0430: \u00ab\u0401\u0441\u0446\u044c \u0443 \u041c\u044f\u043d\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u044f \u0430\u0432\u0435\u0447\u043a\u0456, \u044f\u043a\u0456\u044f \u043d\u0435 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0432\u0430\u0440\u0430. \u0406 \u0433\u044d\u0442\u044b\u0445 \u041c\u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0437\u0456\u043d \u0441\u0442\u0430\u0442\u0430\u043a \u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u0430\u0441\u0442\u044b\u0440\u00bb (\u042f\u043d 10, 16).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0443 \u0430\u0434\u043d\u044b\u043c \u041f\u0430\u0441\u0442\u044b\u0440\u044b, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0430\u0434\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u041f\u0430\u0441\u0442\u044b\u0440\u0430. \u041d\u044f\u0445\u0430\u0439 \u0430\u0432\u0435\u0447\u043a\u0456 \u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c \u0433\u044d\u0442\u044b \u0433\u043e\u043b\u0430\u0441 \u0434\u044b \u0456\u0434\u0443\u0446\u044c \u0437\u0430 \u0441\u0432\u0430\u0456\u043c \u041f\u0430\u0441\u0442\u044b\u0440\u0430\u043c. \u041d\u0435 \u0437\u0430 \u0442\u044b\u043c \u0446\u0456 \u0456\u043d\u0448\u044b\u043c, \u0430\u043b\u0435 \u0437\u0430 \u0410\u0434\u043d\u044b\u043c. \u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0443 \u0406\u043c \u0430\u0434\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u0430 \u043d\u0435 \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u0433\u0430\u043b\u0430\u0441\u0430\u043c\u0456. \u00ab\u0417\u0430\u043a\u043b\u0456\u043a\u0430\u044e \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0432\u044b \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0456 \u0430\u0434\u043d\u043e \u0456 \u0442\u043e\u0435 \u0436 \u0456 \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0430\u043c\u0456\u0436 \u0432\u0430\u043c\u0456 \u0440\u0430\u0441\u043a\u043e\u043b\u0443\u00bb (1 \u041a\u0430\u0440 1, 10). \u041d\u044f\u0445\u0430\u0439 \u0430\u0432\u0435\u0447\u043a\u0456 \u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c \u0442\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u044f\u043a\u0456 \u043d\u0435 \u0441\u0442\u0432\u0430\u0440\u0430\u0435 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0440\u0430\u0441\u043a\u043e\u043b\u0443 \u0456 \u043f\u0430\u0434\u0437\u0435\u043b\u0443, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0456\u0434\u0443\u0446\u044c \u0437\u0430 \u0441\u0432\u0430\u0456\u043c \u041f\u0430\u0441\u0442\u044b\u0440\u0430\u043c, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430: \u00ab\u0410\u0432\u0435\u0447\u043a\u0456 \u041c\u0430\u0435 \u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u041c\u043e\u0439, \u0456 \u044f\u043d\u044b \u0456\u0434\u0443\u0446\u044c \u0437\u0430 \u041c\u043d\u043e\u044e\u00bb (\u042f\u043d 10, 27).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0414\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440, \u044f\u043a\u0456 \u043d\u0435 \u0441\u043f\u0456\u0448, \u0430\u043b\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0447\u0443\u0432\u0430\u0435\u0448, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439, \u041f\u0430\u043d\u0435, \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0430\u0442\u043a\u0443.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456,<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u041f\u0430\u043d\u0435, \u0422\u0432\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u043d\u0435 \u043c\u0435\u045e \u0434\u043e\u0441\u0442\u0443\u043f\u0443 \u0434\u0430 \u043d\u0430\u0441 \u0432\u043e\u0440\u0430\u0433, \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u044b \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u043b\u044c\u043d\u0456\u043a.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"257","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e\u00bb \u0441\u0432. \u0413\u0456\u043b\u044f\u0440\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 64, 14-15: CSEL 22, 245-246)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u0442\u043e\u043a\u0456 \u0440\u0430\u0447\u043d\u044b\u044f \u0432\u0435\u0441\u044f\u043b\u044f\u0446\u044c \u0433\u043e\u0440\u0430\u0434 \u0411\u043e\u0436\u044b<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u00ab\u0411\u043e\u0436\u044b \u043f\u0430\u0442\u043e\u043a \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0432\u0430\u0434\u043e\u044e; \u0422\u044b \u0432\u044b\u0440\u043e\u0448\u0447\u0432\u0430\u0435\u0448 \u0437\u0431\u043e\u0436\u0436\u0430, \u0431\u043e \u0442\u0430\u043a \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0437\u044f\u043c\u043b\u044e\u00bb (65 [64], 10). \u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0433\u044d\u0442\u044b \u043f\u0430\u0442\u043e\u043a. \u0411\u043e \u043f\u0440\u0430\u0440\u043e\u043a \u043a\u0430\u0436\u0430: \u00ab\u041f\u0430\u0442\u043e\u043a\u0456 \u0440\u0430\u0447\u043d\u044b\u044f \u0432\u0435\u0441\u044f\u043b\u044f\u0446\u044c \u0433\u043e\u0440\u0430\u0434 \u0411\u043e\u0436\u044b\u00bb (\u041f\u0441 46 [45], 5). \u0410 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456 \u041f\u0430\u043d \u043a\u0430\u0436\u0430: \u00ab\u0410 \u0445\u0442\u043e \u0431 \u043f\u0456\u045e \u0432\u0430\u0434\u0443, \u044f\u043a\u0443\u044e \u042f \u0434\u0430\u043c \u044f\u043c\u0443, \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u0435 \u0441\u043c\u0430\u0433\u0456 \u043d\u0430\u0432\u0435\u043a\u0456; \u0430 \u0432\u0430\u0434\u0430, \u044f\u043a\u0443\u044e \u0434\u0430\u043c \u044f\u043c\u0443, \u0441\u0442\u0430\u043d\u0435 \u045e \u0456\u043c \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0432\u0430\u0434\u044b, \u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435\u00bb (\u042f\u043d 4, 14). \u0406 \u044f\u0448\u0447\u044d: \u00ab\u201d\u0425\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u041c\u044f\u043d\u0435, \u0443 \u0442\u0430\u0433\u043e, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u045e \u041f\u0456\u0441\u0430\u043d\u043d\u0456, \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u043f\u0430\u0446\u044f\u043a\u0443\u0446\u044c \u0440\u044d\u043a\u0456 \u0432\u0430\u0434\u044b \u0436\u044b\u0432\u043e\u0439\u201d. \u0413\u044d\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u043d \u043f\u0440\u0430 \u0414\u0443\u0445\u0430, \u044f\u043a\u043e\u0433\u0430 \u043c\u0435\u043b\u0456\u0441\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0443 \u042f\u0433\u043e\u00bb (\u042f\u043d 7, 38-39). \u0422\u0430\u043c\u0443 \u0433\u044d\u0442\u044b \u043f\u0430\u0442\u043e\u043a \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0411\u043e\u0436\u0430\u0439 \u0432\u0430\u0434\u043e\u0439. \u041c\u044b \u0437\u0430\u043d\u0443\u0440\u0430\u043d\u044b\u044f \u045e \u0434\u0430\u0440\u0430\u0445 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0456 \u0437 \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0436\u044b\u0446\u0446\u044f \u043f\u043b\u044b\u0432\u0435 \u0434\u0430 \u043d\u0430\u0441 \u0440\u0430\u043a\u0430, \u043f\u043e\u045e\u043d\u0430\u044f \u0411\u043e\u0436\u0430\u0439 \u0432\u0430\u0434\u044b. \u041c\u044b \u043c\u0430\u0435\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u043d\u0443\u044e \u0435\u0436\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0430 \u0435\u0436\u0430? \u0422\u0430\u044f, \u0448\u0442\u043e \u0440\u044b\u0445\u0442\u0443\u0435 \u043d\u0430\u0441 \u0434\u0430 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u0411\u043e\u0436\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u043f\u0440\u0430\u0437 \u0443\u0434\u0437\u0435\u043b \u0443 \u0441\u0432\u044f\u0442\u044b\u043c \u0426\u0435\u043b\u0435 \u0456 \u0432\u044f\u0434\u0437\u0435 \u043d\u0430\u0441 \u0434\u0430 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u044f \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0437 \u0442\u044b\u043c \u0441\u0432\u044f\u0442\u044b\u043c \u0426\u0435\u043b\u0430\u043c. \u041a\u0430\u0436\u0443\u0446\u044c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u043b\u043e\u0432\u044b \u043f\u0441\u0430\u043b\u044c\u043c\u0430: \u00ab\u0422\u044b \u0432\u044b\u0440\u043e\u0448\u0447\u0432\u0430\u0435\u0448 \u0437\u0431\u043e\u0436\u0436\u0430, \u0431\u043e \u0442\u0430\u043a \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0437\u044f\u043c\u043b\u044e\u00bb. \u0413\u044d\u0442\u0430\u044f \u0435\u0436\u0430 \u0437\u0431\u0430\u045e\u043b\u044f\u0435 \u043d\u0430\u0441 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u044f\u043f\u0435\u0440, \u0430\u043b\u0435 \u0456 \u0440\u044b\u0445\u0442\u0443\u0435 \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0410\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f \u043f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0445\u0440\u043e\u0441\u0442\u0443, \u043c\u044b \u043c\u0430\u0435\u043c \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u045e \u0441\u0430\u0431\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u0435\u043c \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u0434\u0430\u0435 \u043d\u0430\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446, \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0430\u0431\u2019\u044f\u045e\u043b\u0435\u043d\u043d\u044f\u045e, \u043c\u043e\u0432\u0443 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u043c\u043e\u0446\u043d\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e, \u0445\u0430\u0440\u044b\u0437\u043c\u0443 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u045e \u0456 \u045e\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0434\u044d\u043c\u0430\u043d\u0430\u043c\u0456. \u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e \u043d\u0430\u0441 \u044f\u043a \u043a\u0440\u043e\u043f\u043b\u044f \u0432\u0430\u0434\u044b \u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u043e\u0432\u0430 \u0434\u0430\u0435 \u0448\u0447\u043e\u0434\u0440\u044b \u043f\u043b\u0451\u043d.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041f\u0441 36 (35), 9-10; 65 (64), 5b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f\u043d\u044b \u043d\u0430\u0441\u044b\u0447\u0430\u044e\u0446\u0446\u0430 \u0442\u0443\u043a\u0430\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443, \u041f\u0430\u043d\u0435, \u0422\u044b \u043f\u043e\u0456\u0448 \u0456\u0445 \u043f\u0430\u0442\u043e\u043a\u0430\u043c \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u0441\u0432\u0430\u0451\u0439. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0411\u043e \u045e \u0422\u0430\u0431\u0435 \u2013 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f, \u0456 \u045e \u0422\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u0435 \u043c\u044b \u0431\u0430\u0447\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e.&nbsp;<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041c\u044b \u043d\u0430\u0441\u044b\u0446\u0456\u043c\u0441\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456 \u0422\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u045e \u0422\u0432\u0430\u0456\u043c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"261","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u00ab\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e\u00bb \u0441\u0432. \u041f\u0430\u043b\u0456\u043a\u0430\u0440\u043f\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Inscriptio; nn. 1, 1 \u2212 2, 3: Funk 1, 267-269)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043b\u0456\u043a\u0430\u0440\u043f, \u0440\u0430\u0437\u0430\u043c \u0437 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u043c\u0456, \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u0411\u043e\u0436\u0430\u043c\u0443 \u045e \u0424\u0456\u043b\u0456\u043f\u0430\u0445, \u044f\u043a\u0456 \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0443\u0435: \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0430\u0434 \u0411\u043e\u0433\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0456 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b, \u043d\u044f\u0445\u0430\u0439 \u0448\u0447\u043e\u0434\u0440\u0430 \u0441\u044b\u0434\u0443\u0446\u044c \u043d\u0430 \u0432\u0430\u0441.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.1pt;\"><span>\u042f \u0432\u0435\u043b\u044c\u043c\u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0430\u043c\u0456 \u045e \u043d\u0430\u0448\u044b\u043c \u041f\u0430\u043d\u0443 \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435, \u0448\u0442\u043e \u0432\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u044f\u043a \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456; \u0448\u0442\u043e \u0432\u044b \u2013 \u044f\u043a \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0432\u0430\u043c \u2013 \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u0456\u043b\u0456 \u0456\u0445 \u0443 \u043a\u0430\u0439\u0434\u0430\u043d\u0430\u0445, \u044f\u043a\u0456\u044f \u0433\u043e\u0434\u043d\u044b\u044f \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043a\u0430\u0440\u043e\u043d\u0430\u0439 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u0445 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430\u045e \u0411\u043e\u0433\u0430 \u0456 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430; \u0440\u0430\u0434\u0443\u044e\u0441\u044f, \u0448\u0442\u043e \u043c\u043e\u0446\u043d\u044b \u043a\u043e\u0440\u0430\u043d\u044c \u0432\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u044b, \u0432\u044f\u0434\u043e\u043c\u044b \u0437 \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u043d\u043d\u0456\u0445 \u0447\u0430\u0441\u043e\u045e, \u0442\u0440\u044b\u0432\u0430\u0435 \u0430\u0436 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u043b\u0451\u043d \u0443 \u043d\u0430\u0448\u044b\u043c \u041f\u0430\u043d\u0443, \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435. \u0401\u043d \u0446\u044f\u0440\u043f\u0435\u045e \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456 \u0430\u0436 \u0434\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u044f \u0441\u043c\u0435\u0440\u0446\u0456. \u00ab\u0410\u043b\u0435 \u0411\u043e\u0433 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e, \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e\u0448\u044b \u0430\u0434 \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u0441\u043c\u0435\u0440\u0446\u0456\u00bb (\u0414\u0437 2, 24). \u00ab\u0425\u043e\u0446\u044c \u0432\u044b \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456, \u0432\u0435\u0440\u044b\u0446\u0435 \u045e \u042f\u0433\u043e. \u0412\u0435\u0441\u044f\u043b\u0456\u0446\u0435\u0441\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u044e \u0456 \u043d\u0430\u0439\u0441\u043b\u0430\u045e\u043d\u0435\u0439\u0448\u0430\u044e\u00bb (\u043f\u0430\u0440. 1 \u041f 1, 8). \u0406 \u043c\u043d\u043e\u0433\u0456\u044f \u0445\u0430\u0446\u0435\u043b\u0456 \u0431 \u0443 \u0451\u0439 \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c. \u0411\u043e \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0432\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043b\u0430\u0441\u043a\u0430\u044e \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u0456 \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u045e (\u043f\u0430\u0440. \u042d\u0444 2, 8-9), \u0430\u043b\u0435 \u0437 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.1pt;\"><span>\u00ab\u0422\u0430\u043c\u0443, \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u045e\u0448\u044b \u0441\u0446\u0451\u0433\u043d\u044b \u0440\u043e\u0437\u0443\u043c\u0443 \u0432\u0430\u0448\u0430\u0433\u0430\u00bb (1 \u041f 1, 13), \u00ab\u0437 \u0431\u043e\u044f\u0437\u0437\u044e \u0441\u043b\u0443\u0436\u044b\u0446\u0435 \u041f\u0430\u043d\u0443\u00bb (\u041f\u0441 2, 11) \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u043f\u0443\u0441\u0442\u044b\u044f \u0440\u0430\u0437\u043c\u043e\u0432\u044b \u0456 \u0432\u044b\u0434\u0443\u043c\u043a\u0456 \u043d\u0430\u0442\u043e\u045e\u043f\u0443, \u0432\u044b\u0437\u043d\u0430\u044e\u0447\u044b \u0432\u0435\u0440\u0443 \u045e \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0430\u0434\u0430\u0440\u044b\u045e \u042f\u0433\u043e \u0445\u0432\u0430\u043b\u043e\u044e (\u043f\u0430\u0440. 1 \u041f 1, 21) \u0456 \u0434\u0430\u045e \u042f\u043c\u0443 \u0442\u0440\u043e\u043d \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0441\u044f\u0431\u0435. \u042f\u043c\u0443 \u0431\u044b\u043b\u043e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u045e \u043d\u0435\u0431\u0430, \u042f\u043c\u0443 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u0436\u044b\u0432\u0435. \u0401\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0436\u044b\u0432\u044b\u0445 \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0456 \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u0440\u0430\u0445\u0443\u043d\u043a\u0443 \u0437\u0430 \u042f\u0433\u043e \u043a\u0440\u043e\u045e \u0430\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u0445\u043e\u0447\u0430 \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u043e\u0439 \u0436\u0430, \u0445\u0442\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u0446\u044c \u0456 \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u0432\u043e\u043b\u044e \u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e, \u043a\u0430\u043b\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u043f\u0430\u043b\u044e\u0431\u0456\u045e, \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u044e\u0447\u044b\u0441\u044f \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043f\u0430\u0434\u043c\u0430\u043d\u0443, \u0445\u0446\u0456\u0432\u0430\u0441\u0446\u0456, \u0437\u043b\u0430\u0441\u043b\u043e\u045e\u044f \u0456 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430\u0433\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f; \u00ab\u043d\u0435 \u0430\u0434\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0437\u043b\u043e\u043c \u0437\u0430 \u0437\u043b\u043e \u0446\u0456 \u0437\u043d\u044f\u0432\u0430\u0433\u0430\u0439 \u0437\u0430 \u0437\u043d\u044f\u0432\u0430\u0433\u0443\u00bb (1 \u041f 3, 9), \u0443\u0434\u0430\u0440\u0430\u043c \u0437\u0430 \u0443\u0434\u0430\u0440, \u0430\u0431\u0440\u0430\u0437\u0430\u0439 \u0437\u0430 \u0430\u0431\u0440\u0430\u0437\u0443, \u0430\u043b\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u041f\u0430\u043d\u0430: \u00ab\u041d\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u0439\u0446\u0435, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0441\u0443\u0434\u0436\u0430\u0446\u044c \u0432\u0430\u0441; \u043f\u0440\u0430\u0431\u0430\u0447\u0430\u0439\u0446\u0435, \u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u0430\u0446\u044c \u0432\u0430\u043c; \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456, \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435; \u044f\u043a\u043e\u0439 \u043c\u0435\u0440\u0430\u044e \u043c\u0435\u0440\u0430\u0435\u0446\u0435, \u0442\u0430\u043a\u043e\u0439 \u0456 \u0432\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043c\u0435\u0440\u0430\u043d\u0430\u00bb (\u043f\u0430\u0440. \u041c\u0446 7, 1; \u041b\u043a 6, 36-38), \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u045e\u0431\u043e\u0433\u0456\u044f \u0456 \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c, \u0431\u043e \u0456\u0445 \u0451\u0441\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435\u00bb (\u043f\u0430\u0440. \u041c\u0446 5, 3. 10).&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">2 \u0426\u0456\u043c 1, 9; \u041f\u0441 115 (113\u0412), 1\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0411\u043e\u0433 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u043d\u0430\u0441 \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0441\u0432\u044f\u0442\u044b\u043c \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435\u043c \u043d\u0435 \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456, <\/span><span style=\"color: #ff0000;\">\/<\/span><span> \u0430\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0456 \u043b\u0430\u0441\u043a\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0439 \u043d\u0430\u043c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435 \u043f\u0435\u0440\u0430\u0434 \u0432\u0435\u0447\u043d\u044b\u043c\u0456 \u0447\u0430\u0441\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0435 \u043d\u0430\u043c, \u041f\u0430\u043d\u0435, \u043d\u0435 \u043d\u0430\u043c, \u0430\u043b\u0435 \u0456\u043c\u0435\u043d\u0456 \u0422\u0432\u0430\u0439\u043c\u0443 \u0434\u0430\u0439 \u0441\u043b\u0430\u0432\u0443 <\/span><span style=\"color: #ff0000;\">\/ <\/span><span>\u0437\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0422\u0432\u0430\u044e \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0414\u0430\u0434\u0437\u0435\u043d\u0430\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"262","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e\u00bb \u0441\u0432. \u041f\u0430\u043b\u0456\u043a\u0430\u0440\u043f\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 3, 1 \u2212 5, 2: Funk 1, 269-273)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u043f\u0440\u0430\u043d\u0435\u043c\u0441\u044f \u045e \u0437\u0431\u0440\u043e\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0411\u0440\u0430\u0442\u044b, \u043a\u0430\u043b\u0456 \u043f\u0456\u0448\u0443 \u0432\u0430\u043c \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0442\u043e \u043d\u0435 \u0437 \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u0432\u043e\u043b\u0456, \u0430\u043b\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0432\u044b \u0441\u0430\u043c\u0456 \u043f\u0440\u0430\u0441\u0456\u043b\u0456. \u041d\u0456 \u044f, \u043d\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u044b \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u043c\u044f\u043d\u0435 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0442\u043e\u0439 \u043c\u0435\u0440\u044b \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0441\u0432. \u041f\u0430\u045e\u043b\u0430, \u044f\u043a\u0456, \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u0443\u043c\u0435\u043b\u0430 \u0456 \u0437 \u043c\u043e\u0446\u0430\u044e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0441\u043b\u043e\u0432\u0430 \u043f\u0440\u0430\u045e\u0434\u044b \u0442\u044b\u043c, \u0445\u0442\u043e \u0442\u0430\u0434\u044b \u0436\u044b\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0441\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0434\u044b\u0445\u043e\u0434\u0443 \u0451\u043d \u043f\u0430\u0441\u044b\u043b\u0430\u045e \u0432\u0430\u043c \u0441\u0432\u0430\u0435 \u043b\u0456\u0441\u0442\u044b. \u041a\u0430\u043b\u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u0446\u0435 \u043d\u0430\u0434 \u0456\u043c\u0456, \u043c\u043e\u0436\u0430\u0446\u0435 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0439 \u0432\u0435\u0440\u044b, \u044f\u043a\u0430\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u0430\u0446\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u0441\u0456\u0445. \u0417\u0430 \u0451\u0439 \u0456\u0434\u0437\u0435 \u043d\u0430\u0434\u0437\u0435\u044f, \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0430\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430 \u0411\u043e\u0433\u0430, \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0433\u044d\u0442\u044b\u0445 \u0446\u043d\u043e\u0442\u0430\u0445, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u043d\u0430\u043a\u0430\u0437 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0425\u0442\u043e \u043c\u0430\u0435 \u043b\u044e\u0431\u043e\u045e, \u0442\u043e\u0439 \u0434\u0430\u043b\u0451\u043a\u0456 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u00ab\u0411\u043e \u043a\u043e\u0440\u0430\u043d\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430 \u2013 \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0433\u0440\u043e\u0448\u0430\u0439\u00bb (1 \u0426\u0456\u043c 6, 10). \u0422\u0430\u043c\u0443, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u00ab\u043c\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043c \u0443 \u0441\u0432\u0435\u0442 \u0456 \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043d\u0456\u0447\u043e\u0433\u0430 \u0432\u044b\u043d\u0435\u0441\u0446\u0456\u00bb (1 \u0426\u0456\u043c 6, 7), \u0430\u043f\u0440\u0430\u043d\u0435\u043c\u0441\u044f \u045e \u0437\u0431\u0440\u043e\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0430\u043c\u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043d\u0430\u043a\u0430\u0437\u0430\u043c\u0456 \u041f\u0430\u043d\u0430. \u0417\u0430\u0442\u044b\u043c \u0432\u0443\u0447\u044b\u0446\u0435 \u0441\u0432\u0430\u0456\u0445 \u0436\u043e\u043d\u0430\u043a, \u043a\u0430\u0431 \u044f\u043d\u044b, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0439 \u0432\u0435\u0440\u0430\u0439 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u043b\u0456\u0441\u044f \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456; \u043d\u044f\u0445\u0430\u0439 \u043a\u0430\u0445\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u0441\u0443\u0436\u044d\u043d\u0446\u0430\u045e \u0437 \u0443\u0441\u0451\u0439 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044e, \u043d\u044f\u0445\u0430\u0439 \u043b\u044e\u0431\u044f\u0446\u044c \u0443\u0441\u0456\u0445 \u0456\u043d\u0448\u044b\u0445 \u0437 \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430\u0439 \u0440\u0430\u0437\u0432\u0430\u0433\u0430\u0439, \u043d\u044f\u0445\u0430\u0439 \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0434\u0437\u044f\u0446\u0435\u0439 \u0443 \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0436\u0430\u0439. \u0423\u0434\u043e\u0432\u0430\u045e \u0436\u0430 \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u0443\u0447\u044b\u0446\u044c, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u044f \u045e \u0432\u0435\u0440\u044b \u041f\u0430\u043d\u0430; \u043d\u044f\u0445\u0430\u0439 \u0442\u0440\u044b\u043c\u0430\u044e\u0446\u0446\u0430 \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430\u0441\u043b\u043e\u045e\u044f, \u0430\u0431\u043c\u043e\u0432\u0430\u045e, \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430\u0433\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f, \u0445\u0446\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430, \u043d\u044f\u0445\u0430\u0439 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u043e\u043b\u044f\u0446\u0446\u0430 \u0437\u0430 \u045e\u0441\u0456\u0445; \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u044f\u043d\u044b \u2013 \u0430\u043b\u0442\u0430\u0440 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e\u0441\u0451 \u0431\u0430\u0447\u044b\u0446\u044c, \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u0437 \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u043c\u0430\u043a, \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u045e \u0446\u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446 \u0441\u044d\u0440\u0446\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0441\u0445\u0430\u0432\u0430\u043d\u044b\u043c \u0430\u0434 \u042f\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0412\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u00ab\u0411\u043e\u0433 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u043d\u0430\u0441\u043c\u0456\u0445\u0430\u0446\u0446\u0430 \u0437 \u0441\u044f\u0431\u0435\u00bb (\u0413\u0430\u043b 6, 7), \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e \u0432\u043e\u043b\u0456 \u0456 \u043d\u0430\u043a\u0430\u0437\u0430\u045e. \u0414\u044b\u044f\u043a\u0430\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0435\u0437 \u0437\u0430\u0433\u0430\u043d\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u042f\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043a \u0441\u043b\u0443\u0433\u0456 \u0411\u043e\u0433\u0430 \u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u043d\u0435 \u043b\u044e\u0434\u0437\u0456. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u044f\u0446\u044c, \u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0432\u0430\u044e\u0446\u044c, \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0445\u0446\u0456\u0432\u044b\u043c\u0456, \u0430\u043b\u0435 \u0432\u0430 \u045e\u0441\u0456\u043c \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u043c\u0435\u0440\u0443, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456, \u043a\u043b\u0430\u043f\u0430\u0442\u043b\u0456\u0432\u044b\u043c\u0456, \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0432\u0435\u0440\u043d\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0441\u043b\u0443\u0433\u043e\u044e. \u041a\u0430\u043b\u0456 \u043c\u044b \u0437\u043c\u043e\u0436\u0430\u043c \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u042f\u043c\u0443 \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c \u0456 \u0431\u0443\u0434\u0443\u0447\u044b. \u0411\u043e \u0401\u043d \u0430\u0431\u044f\u0446\u0430\u045e \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u0446\u044c \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u043d\u0430\u0448\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u042f\u0433\u043e, \u0456 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u043d\u0430\u0441, \u0443 \u0448\u0442\u043e \u043c\u044b \u0432\u0435\u0440\u044b\u043c, \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0424\u043b\u043f 4, 8. 9\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0428\u0442\u043e \u0451\u0441\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435, \u0448\u0442\u043e \u0433\u043e\u0434\u043d\u0430\u0435, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0435, \u0448\u0442\u043e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0435, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u043d\u0435\u0439\u043a\u0430\u044f \u0446\u043d\u043e\u0442\u0430 \u0430\u0431\u043e \u043d\u0435\u0448\u0442\u0430 \u0433\u043e\u0434\u043d\u0430\u0435 \u043f\u0430\u0445\u0432\u0430\u043b\u044b \u2013 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0434\u0443\u043c\u0430\u0439\u0446\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0427\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f, \u0456 \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456, \u0442\u043e\u0435 \u0447\u044b\u043d\u0456\u0446\u0435, \u0456 \u0411\u043e\u0433 \u0441\u043f\u0430\u043a\u043e\u044e \u0431\u0443\u0434\u0437\u0435 \u0437 \u0432\u0430\u043c\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u043b\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"263","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e\u00bb \u0441\u0432. \u041f\u0430\u043b\u0456\u043a\u0430\u0440\u043f\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 6, 1 \u2212 8, 2: Funk 1, 273-275)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0430\u043c \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u044b \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043f\u0430\u0433\u0430\u0434\u043b\u0456\u0432\u044b\u043c\u0456 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456 \u0434\u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u043d\u044f\u0445\u0430\u0439 \u043a\u043b\u0456\u0447\u0443\u0446\u044c \u0431\u043b\u0443\u043a\u0430\u044e\u0447\u044b\u0445, \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u044e\u0446\u044c \u0443\u0441\u0456\u0445 \u0445\u0432\u043e\u0440\u044b\u0445, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0443\u0434\u043e\u0432\u0430\u045e, \u0441\u0456\u0440\u043e\u0442\u0430\u045e \u0456 \u045e\u0431\u043e\u0433\u0456\u0445, \u0430\u043b\u0435 \u043d\u044f\u0445\u0430\u0439 \u043a\u043b\u0430\u043f\u043e\u0446\u044f\u0446\u0446\u0430 \u00ab\u0430\u0431<\/span><span style=\"font-style: italic;\"> <\/span><span>\u0434\u043e\u0431\u0440\u044b\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u0430\u043b\u0435 \u0456 \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456\u00bb (2 \u041a\u0430\u0440 8, 21). \u041d\u044f\u0445\u0430\u0439 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u0446\u0430 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443, \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u044e\u0446\u044c \u043f\u0440\u0430\u0434\u0443\u0437\u044f\u0442\u0430\u0441\u0446\u0456, \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0441\u0443\u0434\u0430, \u043d\u044f\u0445\u0430\u0439 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u044e\u0446\u044c \u0445\u0446\u0456\u0432\u0430\u0441\u0446\u0456, \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u043b\u0435\u0433\u043a\u0430\u0432\u0435\u0440\u043d\u0430 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u043d\u043d\u044f\u045e \u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u043d\u0430\u0434\u0442\u0430 \u0441\u0443\u0440\u043e\u0432\u044b\u043c\u0456 \u045e \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u0456, \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u045e\u0441\u0435 \u043c\u044b \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u0435\u043c \u0433\u0440\u0430\u0445\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c \u0411\u043e\u0433\u0430 \u0434\u0430\u0440\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u043c \u0433\u0440\u0430\u0445\u0456, \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0434\u0430\u0440\u0430\u0432\u0430\u0446\u044c. \u041c\u044b \u0436\u044b\u0432\u0451\u043c \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0411\u043e\u0433\u0430 \u0456 \u041f\u0430\u043d\u0430 \u0456 \u00ab\u045e\u0441\u0435 \u043c\u044b \u0441\u0442\u0430\u043d\u0435\u043c \u043f\u0435\u0440\u0430\u0434 \u0441\u0443\u0434\u043e\u0432\u044b\u043c \u043f\u0430\u0441\u0430\u0434\u0430\u043c \u0411\u043e\u0433\u0430 \u0456 \u043a\u043e\u0436\u043d\u044b \u0437 \u043d\u0430\u0441 \u0430\u0434\u043a\u0430\u0436\u0430 \u0437\u0430 \u0441\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c\u00bb (\u043f\u0430\u0440. \u0420\u044b\u043c 14, 10. 12). \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u044f\u043c\u0443 \u0437 \u0431\u043e\u044f\u0437\u0437\u044e \u0456 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043f\u0430\u0448\u0430\u043d\u0430\u0439, \u0442\u0430\u043a \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0401\u043d \u0441\u0430\u043c, \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b, \u044f\u043a\u0456\u044f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u043d\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u041f\u0430\u043d\u0430. \u0411\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0430\u0434\u0434\u0430\u043d\u044b\u043c\u0456 \u045e \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u0456 \u0434\u0430\u0431\u0440\u0430, \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0439\u043c\u0430 \u0437\u0433\u0430\u0440\u0448\u044d\u043d\u043d\u044f\u045e, \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0430 \u043d\u043e\u0441\u0456\u0446\u044c \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0456 \u0437\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u043b\u0430\u0431\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043d\u0435 \u0432\u044b\u0437\u043d\u0430\u0435, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0446\u0435\u043b\u0435, \u2013 \u0433\u044d\u0442\u0430 \u0430\u043d\u0442\u044b\u0445\u0440\u044b\u0441\u0442\u00bb (\u043f\u0430\u0440. 1 \u042f\u043d 4, 2. 3; 2 \u042f\u043d 7); \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u043a\u0440\u044b\u0436\u0430 \u2013 \u0430\u0434 \u0434\u2019\u044f\u0431\u043b\u0430. \u0422\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u044b\u0441\u0442\u0430\u0441\u043e\u045e\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0434\u043b\u044f \u0441\u0432\u0430\u0456\u0445 \u043f\u0430\u0442\u0440\u044d\u0431\u0430\u045e \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435, \u0448\u0442\u043e \u043d\u044f\u043c\u0430 \u043d\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f, \u043d\u0456 \u0441\u0443\u0434\u0430, \u0442\u043e\u0439 \u2013 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u0441\u0430\u0442\u0430\u043d\u044b. \u0422\u0430\u043c\u0443, \u043f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u043f\u0443\u0441\u0442\u044b\u044f \u045e\u044f\u045e\u043b\u0435\u043d\u043d\u0456 \u043c\u043d\u043e\u0433\u0456\u0445, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u044f \u043d\u0430\u0432\u0443\u043a\u0456, \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f, \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u043d\u0430\u043c \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u043c\u0456 \u0456 \u0446\u0432\u044f\u0440\u043e\u0437\u044b\u043c\u0456, \u043a\u0430\u0431 \u043c\u0430\u0433\u043b\u0456 \u043c\u044b \u043c\u0430\u043b\u0456\u0446\u0446\u0430 (\u043f\u0430\u0440. 1 \u041f 4, 7), \u0431\u0443\u0434\u0437\u0435\u043c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0456 \u043f\u043e\u0441\u0442\u0443, \u043f\u0440\u043e\u0441\u044f\u0447\u044b \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e\u0441\u0451 \u0431\u0430\u0447\u044b\u0446\u044c, \u043a\u0430\u0431 \u00ab\u043d\u0435 \u045e\u0432\u043e\u0434\u0437\u0456\u045e \u043d\u0430\u0441 \u0443 \u0441\u043f\u0430\u043a\u0443\u0441\u0443\u00bb (\u041c\u0446 6, 13), \u0431\u043e \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d: \u00ab\u0414\u0443\u0445 \u0430\u0445\u0432\u043e\u0447\u044b, \u0430\u043b\u0435 \u0446\u0435\u043b\u0430 \u0441\u043b\u0430\u0431\u043e\u0435\u00bb (\u041c\u0446 26, 41).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043c\u043e\u0446\u043d\u0430 \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u043d\u0430\u0434\u0437\u0435\u0456 \u0456 \u0437\u0430\u0440\u0443\u043a\u0456 \u043d\u0430\u0448\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u00ab\u045e \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u045e\u0437\u043d\u0451\u0441 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f \u043d\u0430 \u0434\u0440\u044d\u0432\u0430; \u044f\u043a\u0456 \u043d\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u0433\u0440\u0430\u0445\u0443, \u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0430\u0434\u043c\u0430\u043d\u0443 \u045e \u0432\u0443\u0441\u043d\u0430\u0445 \u042f\u0433\u043e\u043d\u044b\u0445\u00bb (1 \u041f 2, 24. 22). \u0401\u043d \u0443\u0441\u0451 \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u0434\u043b\u044f \u043d\u0430\u0441, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0436\u044b\u0446\u044c \u0437 \u0406\u043c. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0430 \u043a\u0430\u043b\u0456 \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0431\u0443\u0434\u0437\u0435 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u042f\u0433\u043e \u0456\u043c\u044f, \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043c \u042f\u0433\u043e. \u0411\u043e \u0442\u0430\u043a\u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0401\u043d \u0441\u0430\u043c \u0434\u0430\u045e \u043d\u0430\u043c \u0456 \u043c\u044b \u045e \u0433\u044d\u0442\u0430 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0420\u044b\u043c 12, 17b; 2 \u041a\u0430\u0440 6, 3; \u0414\u0437 24, 15\u0430. 16\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0414\u0431\u0430\u0439\u0446\u0435 \u0430\u0431 \u0434\u043e\u0431\u0440\u044b\u043c \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u043d\u0456\u043a\u043e\u043c\u0443 \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0441\u043f\u0430\u0442\u044b\u043a\u0430\u0446\u0446\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u043e\u0441\u044f \u0437\u0430\u0433\u0430\u043d\u044b \u045e \u043d\u0430\u0448\u044b\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041c\u0430\u044e\u0447\u044b \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u0411\u043e\u0433\u0430, \u044f \u0440\u0443\u043f\u043b\u044e\u0441\u044f, \u043a\u0430\u0431 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u0435\u0446\u044c \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u0430\u0435 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"264","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e\u00bb \u0441\u0432. \u041f\u0430\u043b\u0456\u043a\u0430\u0440\u043f\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 9, 1 \u2212 11, 4: Funk 1, 275-279)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0416\u044b\u0432\u0456\u0446\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u044b \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0448\u0443 \u045e\u0441\u0456\u0445 \u0432\u0430\u0441, \u043a\u0430\u0431 \u0432\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u0421\u043b\u043e\u0432\u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u044f\u043a \u0432\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0433\u044d\u0442\u0430, \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0433\u0430 \u0406\u0433\u043d\u0430\u0446\u044b\u044f, \u0417\u0430\u0441\u0456\u043c\u044b \u0456 \u0420\u0443\u0444\u0456\u043d\u0430, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u0445 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u0441\u0430\u043c\u043e\u0433\u0430 \u041f\u0430\u045e\u043b\u0430 \u0456 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e. \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b\u044f, \u0448\u0442\u043e \u044f\u043d\u044b \u045e\u0441\u0435 \u043d\u0435 \u0434\u0430\u0440\u043c\u0430 \u0431\u0435\u0433\u043b\u0456 (\u043f\u0430\u0440. \u0424\u043b\u043f 2, 16), \u0430\u043b\u0435 \u045e \u0432\u0435\u0440\u044b \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456; \u0448\u0442\u043e \u0437\u0430\u0439\u043c\u0430\u044e\u0446\u044c \u043d\u0430\u043b\u0435\u0436\u043d\u0430\u0435 \u0456\u043c \u043c\u0435\u0441\u0446\u0430 \u045e \u041f\u0430\u043d\u0430, \u0437 \u044f\u043a\u0456\u043c \u0440\u0430\u0437\u0430\u043c \u0437\u043d\u043e\u0441\u0456\u043b\u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435. \u0411\u043e \u043d\u0435 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456 \u0441\u0432\u0435\u0442 (\u043f\u0430\u0440. 2 \u0426\u0456\u043c 4, 10), \u0430\u043b\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u043d\u0430\u0441 \u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0431\u044b\u045e \u0443\u0437\u043d\u044f\u0442\u044b \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u045e \u0433\u044d\u0442\u044b\u043c \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u043d\u0456 \u0456 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0439\u0446\u0435 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u041f\u0430\u043d\u0430, \u043c\u043e\u0446\u043d\u044b\u044f \u0456 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u044b\u044f \u045e \u0432\u0435\u0440\u044b, \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u043d\u044f\u0439 \u043b\u044e\u0431\u043e\u045e\u044e, \u043b\u044e\u0431\u044f\u0447\u044b \u0441\u044f\u0431\u0435 \u045e\u0437\u0430\u0435\u043c\u043d\u0430, \u0431\u0443\u0434\u0443\u0447\u044b \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u044b\u043c\u0456 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430, \u0456 \u043d\u0456\u043a\u0456\u043c \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439\u0446\u0435. \u041a\u0430\u043b\u0456 \u043c\u043e\u0436\u0430\u0446\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u043d\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u044c\u0446\u0435, \u00ab\u0431\u043e \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456\u00bb (\u0422\u043e\u0431 4, 10). \u00ab\u041f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443\u00bb (\u042d\u0444 5, 21); \u00ab\u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u043f\u0430\u0432\u043e\u0434\u0437\u044c\u0446\u0435 \u0441\u044f\u0431\u0435 \u0434\u043e\u0431\u0440\u0430\u00bb (1 \u041f 2, 12), \u043a\u0430\u0431 \u0432\u0430\u0448\u044b\u044f \u0434\u043e\u0431\u0440\u044b\u044f \u0447\u044b\u043d\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u0432\u0430\u043c \u0445\u0432\u0430\u043b\u0443 \u0456 \u043a\u0430\u0431 \u0437 \u0432\u0430\u0448\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0435 \u0431\u044b\u045e \u0437\u043d\u044f\u0432\u0430\u0436\u0430\u043d\u044b \u041f\u0430\u043d. \u0413\u043e\u0440\u0430 \u0442\u0430\u043c\u0443, \u043f\u0440\u0430\u0437 \u043a\u0430\u0433\u043e \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u044e\u0446\u044c \u0456\u043c\u0435\u043c \u041f\u0430\u043d\u0430. \u0412\u0443\u0447\u044b\u0446\u0435 \u045e\u0441\u0456\u0445 \u0443\u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456 \u0456 \u0441\u0430\u043c\u0456 \u044f\u0435 \u0442\u0440\u044b\u043c\u0430\u0439\u0446\u0435\u0441\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0432\u0435\u043b\u044c\u043c\u0456 \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u045e\u0441\u044f \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0412\u0430\u043b\u0435\u043d\u0441\u0430, \u0431\u044b\u043b\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430, \u0448\u0442\u043e \u0451\u043d \u0432\u0435\u043b\u044c\u043c\u0456 \u043c\u043e\u0446\u043d\u0430 \u0437\u0430\u0431\u044b\u045e \u043f\u0440\u0430 \u045e\u0434\u0437\u0435\u043b\u0435\u043d\u0443\u044e \u044f\u043c\u0443 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c. \u0422\u0430\u043c\u0443 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u044e \u0432\u0430\u0441, \u043a\u0430\u0431 \u0432\u044b \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u043b\u0456\u0441\u044f \u0445\u0446\u0456\u0432\u0430\u0441\u0446\u0456, \u0431\u044b\u043b\u0456 \u0447\u044b\u0441\u0442\u044b\u044f \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f. \u041f\u0430\u0437\u0431\u044f\u0433\u0430\u0439\u0446\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430. \u0411\u043e \u0445\u0442\u043e \u043d\u0435 \u045e\u043c\u0435\u0435 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0441\u0430\u0431\u043e\u044e, \u044f\u043a \u0436\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0446\u044c \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0456\u043d\u0448\u044b\u0445? \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0446\u0446\u0430 \u0445\u0446\u0456\u0432\u0430\u0441\u0446\u0456, \u043f\u0430\u043f\u0430\u0434\u0437\u0435 \u045e \u0456\u0434\u0430\u043b\u0430\u043f\u0430\u043a\u043b\u043e\u043d\u0441\u0442\u0432\u0430 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u044b \u0434\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u0441\u0443\u0434\u0430 \u041f\u0430\u043d\u0430. \u00ab\u0425\u0456\u0431\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0441\u0432\u044f\u0442\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u0435\u0442?\u00bb (1 \u041a\u0430\u0440 6, 2), \u2013 \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u043d\u0456\u0447\u043e\u0433\u0430 \u0442\u0430\u043a\u043e\u0433\u0430 \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u045e \u0456 \u043d\u0435 \u043f\u0430\u0447\u0443\u045e \u0443 \u0432\u0430\u0441, \u0441\u044f\u0440\u043e\u0434 \u044f\u043a\u0456\u0445 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0456 \u044f\u043a\u0456\u0445 \u0451\u043d \u0437\u0433\u0430\u0434\u0432\u0430\u0435 \u045e \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f. \u0401\u043d \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0432\u0430\u043c\u0456 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0442\u0430\u0434\u044b \u0432\u0435\u0434\u0430\u043b\u0456 \u0411\u043e\u0433\u0430, \u0445\u043e\u0446\u044c \u043c\u044b \u0441\u0430\u043c\u0456 \u044f\u0448\u0447\u044d \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u042f\u0433\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0432\u0435\u043b\u044c\u043c\u0456 \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u045e\u0441\u044f, \u0431\u0440\u0430\u0442\u044b, \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0412\u0430\u043b\u0435\u043d\u0441\u0430 \u0456 \u044f\u0433\u043e \u0436\u043e\u043d\u043a\u0456. \u041a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u043d \u0434\u0430\u045e \u0456\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435. \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0430\u0441\u0446\u044f\u0440\u043e\u0436\u043d\u044b\u044f \u045e \u0433\u044d\u0442\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0456 \u043d\u0435 \u043b\u0456\u0447\u044b\u0446\u0435 \u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456 (\u043f\u0430\u0440. 2 \u0422\u044d\u0441 3, 15), \u0430\u043b\u0435 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u044f\u043a \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0434\u0434\u0430\u0435\u0446\u0446\u0430 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044f\u043c \u0456 \u043f\u0430\u043c\u044b\u043b\u043a\u0430\u043c, \u043a\u0430\u0431 \u0443\u0441\u0451 \u0432\u0430\u0448\u0430\u0435 \u0446\u0435\u043b\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0422\u0430\u043a \u0440\u043e\u0431\u044f\u0447\u044b, \u0431\u0443\u0434\u0443\u0439\u0446\u0435 \u0441\u0430\u043c\u044b\u0445 \u0441\u044f\u0431\u0435.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0424\u043b\u043f 2, 12b-13; \u042f\u043d 15, 5b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417 \u0431\u043e\u044f\u0437\u0437\u044e \u0456 \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0435\u043c \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0439\u0446\u0435 \u0441\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/span><span style=\"color: #ff0000;\"> *<\/span><span> \u0411\u043e \u0433\u044d\u0442\u0430 \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0443 \u0432\u0430\u0441 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0456 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u0436\u0430 \u041f\u0430\u043d: \u0411\u0435\u0437 \u041c\u044f\u043d\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430\u0446\u0435 \u0437\u0440\u0430\u0431\u0456\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u0433\u044d\u0442\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"265","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e\u00bb \u0441\u0432. \u041f\u0430\u043b\u0456\u043a\u0430\u0440\u043f\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 12, 1 \u2212 14: Funk 1, 279-283)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u043c\u0430\u0446\u0443\u0435 \u0432\u0430\u0441 \u0443 \u0432\u0435\u0440\u044b \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u042f \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b, \u0448\u0442\u043e \u0432\u044b \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u0432\u0435\u0434\u0430\u0435\u0446\u0435 \u0421\u0432\u044f\u0442\u044b\u044f \u041f\u0456\u0441\u0430\u043d\u043d\u0456, \u0456 \u043d\u0456\u0448\u0442\u043e \u045e \u0456\u0445 \u0434\u043b\u044f \u0432\u0430\u0441 \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u0439. \u042f \u0436 \u043d\u0435 \u043c\u0430\u044e \u0442\u0430\u043a\u043e\u0433\u0430 \u0434\u0430\u0440\u0443. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u044b\u043c \u043f\u0440\u044b\u0433\u0430\u0434\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u044b: \u00ab\u0413\u043d\u0435\u0432\u0430\u0439\u0446\u0435\u0441\u044f, \u0430\u043b\u0435 \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u0446\u0435\u00bb, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u00ab\u041d\u044f\u0445\u0430\u0439 \u0441\u043e\u043d\u0446\u0430 \u043d\u0435 \u0437\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0433\u043d\u0435\u0432\u0435 \u0432\u0430\u0448\u044b\u043c\u00bb (\u042d\u0444 4, 26; \u043f\u0430\u0440. \u041f\u0441 4, 5). \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b, \u0445\u0442\u043e \u043f\u0430\u043c\u044f\u0442\u0430\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430. \u0421\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0442\u0430\u043a \u0451\u0441\u0446\u044c \u0456 \u045e \u0432\u0430\u0448\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0411\u043e\u0433 \u0456 \u0410\u0439\u0446\u0435\u0446 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0441\u0430\u043c \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b \u0421\u0432\u044f\u0442\u0430\u0440, \u0421\u044b\u043d \u0411\u043e\u0436\u044b, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u044f\u0445\u0430\u0439 \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0435 \u045e \u0432\u0435\u0440\u044b \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0432\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u0456, \u0443 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u0448\u044b, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0456 \u0456 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456. \u041d\u044f\u0445\u0430\u0439 \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c \u0443\u0434\u0437\u0435\u043b \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0435 \u0441\u0432\u0430\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445, \u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0430\u043c\u0456 \u0456 \u043d\u0430\u043c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c \u043d\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456, \u044f\u043a\u0456\u044f \u0432\u0435\u0440\u0430\u0446\u044c \u0443 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u045e \u042f\u0433\u043e \u0410\u0439\u0446\u0430, \u00ab\u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e\u00bb (\u0413\u0430\u043b 1, 1).<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u0437\u0430 \u045e\u0441\u0456\u0445 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445. \u041c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u045e, \u0437\u0430 \u043a\u043d\u044f\u0437\u0451\u045e, \u0437\u0430 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0430\u045e \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u0430\u0441 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c, \u0437\u0430 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u043a\u0440\u044b\u0436\u0430, \u043a\u0430\u0431 \u0432\u0430\u0448 \u043f\u043b\u0451\u043d \u0431\u044b\u045e \u0431\u0430\u0447\u043d\u044b \u0432\u0430 \u045e\u0441\u0456\u043c \u0456 \u043a\u0430\u0431 \u0432\u044b \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u043b\u0456\u0441\u044f \u045e \u0456\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0412\u044b \u043d\u0430\u043f\u0456\u0441\u0430\u043b\u0456 \u043c\u043d\u0435, \u0456 \u0432\u044b, \u0456 \u0406\u0433\u043d\u0430\u0446\u044b\u0439, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0432\u044b\u0440\u0443\u0448\u044b\u0446\u044c \u0443 \u0421\u0456\u0440\u044b\u044e, \u043a\u0430\u0431 \u0437\u0430\u0431\u0440\u0430\u043b\u0456 \u043b\u0456\u0441\u0442 \u0434\u0430 \u0432\u0430\u0441. \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0433\u044d\u0442\u0430 \u0441\u0430\u043c, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u043f\u0430\u0434\u0437\u0435 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c, \u0430\u0431\u043e \u043f\u0430\u0441\u043b\u0430\u043d\u0435\u0446, \u044f\u043a\u043e\u0433\u0430 \u044f \u0441\u043a\u0456\u0440\u0443\u044e \u0434\u0430 \u0432\u0430\u0441.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041b\u0456\u0441\u0442\u044b \u0406\u0433\u043d\u0430\u0446\u044b\u044f, \u044f\u043a\u0456\u044f \u044f \u0432\u0430\u043c \u043f\u0430\u043a\u0456\u043d\u0443\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u044f, \u044f\u043a\u0456\u044f \u045e \u043d\u0430\u0441 \u0431\u044b\u043b\u0456, \u043c\u044b \u043f\u0435\u0440\u0430\u0434\u0430\u043b\u0456 \u0432\u0430\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u043a\u0430\u0437\u0443. \u042f\u043d\u044b \u0434\u0430\u043b\u0443\u0447\u0430\u043d\u044b \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u043b\u0456\u0441\u0442\u0430 \u0456 \u0432\u044b \u043c\u043e\u0436\u0430\u0446\u0435 \u0437\u0430\u0447\u044d\u0440\u043f\u043d\u0443\u0446\u044c \u0437 \u0456\u0445 \u0448\u043c\u0430\u0442 \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0433\u0430. \u0423 \u0456\u0445 \u2013 \u0432\u0435\u0440\u0430, \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u0443 \u043d\u0430\u0448\u044b\u043c \u041f\u0430\u043d\u0443. \u0423 \u0441\u0432\u0430\u044e \u0447\u0430\u0440\u0433\u0443 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u0446\u0435 \u043c\u043d\u0435, \u0448\u0442\u043e \u0432\u044b \u043a\u0430\u043d\u043a\u0440\u044d\u0442\u043d\u0430\u0433\u0430 \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430 \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0456 \u043f\u0440\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u044b\u045e \u0437 \u0456\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u042f \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0433\u044d\u0442\u044b \u043b\u0456\u0441\u0442 \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u041a\u0440\u044d\u0441\u0446\u044d\u043d\u0441\u0430, \u044f\u043a\u043e\u0433\u0430 \u044f \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u045e \u0432\u0430\u043c \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430 \u0456 \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u044e. \u042f\u0433\u043e \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441 \u0431\u044b\u043b\u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u044f. \u0421\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0442\u0430\u043a\u0456\u044f \u0436 \u0431\u0443\u0434\u0443\u0446\u044c \u0456 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441. \u0414\u0430\u0440\u0443\u0447\u0430\u044e \u0432\u0430\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u044f\u0433\u043e \u0441\u044f\u0441\u0442\u0440\u0443, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u0432\u0430\u0441. \u041c\u043e\u0446\u043d\u0430 \u0442\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u045e \u041f\u0430\u043d\u0443 \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435. \u042f\u0433\u043e \u043b\u0430\u0441\u043a\u0430 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0437 \u0432\u0430\u043c\u0456.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0413\u0431\u0440 13, 20\u0430. 21; 2 \u041c\u0430\u043a 1, 3\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e\u0433 \u0441\u043f\u0430\u043a\u043e\u044e \u043d\u044f\u0445\u0430\u0439 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u0446\u044c \u0432\u0430\u0441 \u0432\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u043a\u0430\u0431 \u0432\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u042f\u0433\u043e\u043d\u0443\u044e \u0432\u043e\u043b\u044e, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0440\u043e\u0431\u044f\u0447\u044b \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u042f\u043c\u0443, \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u0401\u043d \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c \u0443\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u0431 \u0432\u044b \u0448\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u042f\u0433\u043e \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u042f\u0433\u043e \u0432\u043e\u043b\u044e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0420\u043e\u0431\u044f\u0447\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"266","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u044f\u043d\u0430\u045e\u00bb \u041f\u0441\u0435\u045e\u0434\u0430-\u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(PLS 1: 617-618)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417\u0430\u045e\u0441\u0451\u0434\u044b \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u041f\u0430\u043d\u0443<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0443 \u0433\u044d\u0442\u044b\u043c \u0447\u044b\u0442\u0430\u043d\u043d\u0456, \u0434\u0437\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: \u00ab\u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e \u041f\u0430\u043d\u0443\u00bb (\u0424\u043b\u043f 4, 4), \u0411\u043e\u0436\u0430\u044f \u0434\u0430\u0431\u0440\u044b\u043d\u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043d\u0430\u0441 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0432\u0435\u0447\u043d\u0430\u043c\u0443 \u0448\u0447\u0430\u0441\u0446\u044e. \u0420\u0430\u0434\u0430\u0441\u0446\u0456 \u0441\u0432\u0435\u0442\u0443 \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0441\u0443\u043c\u0443; \u0430 \u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u0437\u0433\u043e\u0434\u043d\u044b\u044f \u0437 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u044f\u0439, \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u043d\u0435\u043f\u0440\u0430\u043c\u0456\u043d\u0430\u043b\u044c\u043d\u0430\u0439, \u0432\u0435\u0447\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u043a\u0430\u0436\u0430: \u00ab\u042f\u0448\u0447\u044d \u0440\u0430\u0437 \u043a\u0430\u0436\u0443: \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f!\u00bb (\u0424\u043b\u043f 4, 4).<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435, \u043a\u0430\u0431 \u043d\u0430\u0448\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043b\u0430 \u0456 \u0432\u044f\u043b\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0434\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u042f\u0433\u043e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e. \u0427\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043c\u044b \u0456\u043c\u043a\u043d\u0435\u043c\u0441\u044f \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0431\u0443\u0434\u0437\u0435\u043c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c\u0456 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0456 \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u043f\u0430\u0445\u0432\u0430\u043b\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c \u0430\u0434 \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u00ab\u041b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u044f \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u0434\u043e\u043c\u0430\u044f \u045e\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c\u00bb (\u0424\u043b\u043f 4, 5), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u044b\u044f \u0441\u0432\u044f\u0442\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0430\u0447\u043d\u044b\u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u044f\u043a \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0441\u0446\u0456\u043f\u043b\u0430\u0441\u0446\u0456 \u0456 \u0446\u0432\u044f\u0440\u043e\u0437\u0430\u0441\u0446\u0456 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0437 \u0432\u0430\u0448\u0430\u0433\u0430 \u0430\u043a\u0440\u0443\u0436\u044d\u043d\u043d\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u044f\u043a \u043d\u0430\u043f\u0430\u043c\u0456\u043d \u0433\u043e\u0434\u043d\u044b\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u00ab\u041f\u0430\u043d \u0431\u043b\u0456\u0437\u043a\u0430. \u041d\u0456 \u043f\u0440\u0430 \u0448\u0442\u043e \u043d\u0435 \u0442\u0443\u0440\u0431\u0443\u0439\u0446\u0435\u0441\u044f\u00bb (\u0424\u043b\u043f 4, 5-6). \u041f\u0430\u043d \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u043b\u0456\u0437\u043a\u0430 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u042f\u0433\u043e \u043a\u043b\u0456\u0447\u0430 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0432\u0435\u0440\u044b, \u0443 \u043c\u043e\u0446\u043d\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u0401\u043d \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0432\u0430\u043c \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430, \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u0432\u044b \u043f\u0430\u043f\u0440\u043e\u0441\u0456\u0446\u0435. \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u0433\u0430\u0442\u043e\u0432\u044b \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0443\u0441\u0456\u043c, \u0445\u0442\u043e \u042f\u043c\u0443 \u0441\u043b\u0443\u0436\u044b\u0446\u044c. \u0422\u0430\u043c\u0443 \u043c\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u0430\u044f\u0446\u0446\u0430 \u043f\u0430\u0433\u0440\u043e\u0437\u044b \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430\u045e, \u0431\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u0435\u0434\u0430\u0446\u044c, \u0448\u0442\u043e \u0411\u043e\u0433 \u2013 \u0433\u044d\u0442\u0430 \u043d\u0430\u0448\u0430\u044f \u043d\u0430\u0439\u0431\u043b\u0456\u0436\u044d\u0439\u0448\u0430\u044f \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430, \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f: \u00ab\u0411\u043b\u0456\u0437\u043a\u0456 \u041f\u0430\u043d \u0434\u0430 \u0442\u044b\u0445, \u0447\u044b\u0451 \u0441\u044d\u0440\u0446\u0430 \u0437\u043c\u0443\u0447\u0430\u043d\u0430, \u0456 \u0437\u043b\u0430\u043c\u0430\u043d\u044b\u0445 \u0434\u0443\u0445\u0430\u043c \u0401\u043d \u0437\u0431\u0430\u045e\u043b\u044f\u0435. \u0428\u043c\u0430\u0442 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u045e \u0443 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0433\u0430, \u0430\u043b\u0435 \u0430\u0434 \u0443\u0441\u0456\u0445 \u044f\u0433\u043e \u0440\u0430\u0442\u0443\u0435 \u041f\u0430\u043d\u00bb (\u041f\u0441 34 [33], 19-20). \u041a\u0430\u043b\u0456 \u043f\u0430\u0441\u0442\u0430\u0440\u0430\u0435\u043c\u0441\u044f \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u043d\u0430\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u045e, \u0401\u043d \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0446\u044c \u0437 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u00ab\u0423 \u043a\u043e\u0436\u043d\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0456 \u043f\u0440\u043e\u0441\u044c\u0431\u0435 \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u0432\u0430\u0448\u044b\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c\u00bb (\u0424\u043b\u043f 4, 6), \u043a\u0430\u0431 \u0432\u044b, \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0447\u044b \u044f\u043a\u043e\u0435-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435, \u0443\u043c\u0435\u043b\u0456 \u044f\u0433\u043e \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0431\u0435\u0437 \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u044b\u0445 \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u044f\u045e \u0456 \u0441\u0443\u043c\u0443, \u0443 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0442\u0430\u043c\u0443 \u00ab\u0434\u0437\u044f\u043a\u0443\u0439\u0446\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430 \u045e\u0441\u0451 \u0411\u043e\u0433\u0443\u00bb (\u042d\u0444 5, 20).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 40 (39), 2b- 4\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u043d \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043d\u0430 \u0441\u043a\u0430\u043b\u0435 \u043c\u0430\u0435 \u043d\u043e\u0433\u0456, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u043a\u0440\u043e\u043a\u0456 \u043c\u0430\u0435. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0423\u043a\u043b\u0430\u045e \u0443 \u043c\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0401\u043d \u043f\u0430\u0447\u0443\u045e \u043c\u043e\u0439 \u043a\u0440\u044b\u043a \u0456 \u043f\u0430\u0434\u043d\u044f\u045e \u043c\u044f\u043d\u0435 \u0437 \u044f\u043c\u044b \u043f\u0430\u0433\u0456\u0431\u0435\u043b\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0423\u043a\u043b\u0430\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"267","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u043d\u0456\u0433\u0430 \u00ab\u0410\u0431 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456\u043c \u0436\u044b\u0446\u0446\u0456\u00bb \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0437\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(PG 46, 295-298)<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u0443\u0436\u043d\u0430 \u0437\u043c\u0430\u0433\u0430\u0439\u0446\u0435\u0441\u044f \u045e \u0430\u0431\u0430\u0440\u043e\u043d\u0435 \u0432\u0435\u0440\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0442\u043e\u0439 \u043d\u043e\u0432\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435; \u0434\u0430\u045e\u043d\u044f\u0435 \u043c\u0456\u043d\u0443\u043b\u0430, \u0432\u043e\u0441\u044c \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043d\u043e\u0432\u0430\u0435\u00bb (2 \u041a\u0430\u0440 5, 17). \u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u00ab\u043d\u043e\u0432\u044b\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c\u00bb \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u045e \u0447\u044b\u0441\u0442\u0430\u0439 \u0434\u0443\u0448\u044b, \u043d\u0435 \u0437\u0430\u0431\u0440\u0443\u0434\u0436\u0430\u043d\u0430\u0439 \u0433\u0440\u0430\u0445\u043e\u043c, \u0432\u043e\u043b\u044c\u043d\u0430\u0439 \u0430\u0434 \u044f\u043a\u043e\u0433\u0430-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0437\u043b\u0430, \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456. \u0411\u043e \u043a\u0430\u043b\u0456 \u0434\u0443\u0448\u0430 \u045e\u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u043b\u0430 \u0433\u0440\u044d\u0445, \u0446\u0430\u043b\u043a\u0430\u043c \u0434\u0430\u0432\u0435\u0440\u044b\u043b\u0430\u0441\u044f \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0443 \u0446\u043d\u043e\u0442\u0430\u045e, \u0456, \u0437\u043c\u044f\u043d\u0456\u045e\u0448\u044b \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b, \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u043b\u0430\u0441\u043a\u0443 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043d\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0431\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u0439, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u0430\u0439 \u0456 \u043f\u0430\u0434\u0441\u0456\u043b\u043a\u0430\u0432\u0430\u043d\u0430\u0439. \u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u0414\u044b\u043a \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u0435 \u0441\u0442\u0430\u0440\u0443\u044e \u0437\u0430\u043a\u0432\u0430\u0441\u043a\u0443, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0432\u0430\u043c \u043d\u043e\u0432\u044b\u043c \u0446\u0435\u0441\u0442\u0430\u043c\u00bb, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u00ab\u0411\u0443\u0434\u0437\u0435\u043c \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u043d\u0435 \u045e \u0441\u0442\u0430\u0440\u043e\u0439 \u0437\u0430\u043a\u0432\u0430\u0441\u0446\u044b, \u043d\u0435 \u045e \u0437\u0430\u043a\u0432\u0430\u0441\u0446\u044b \u0437\u043b\u0430 \u0456 \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u0443, \u0430\u043b\u0435 \u045e \u043f\u0440\u044d\u0441\u043d\u044b\u043c \u0445\u043b\u0435\u0431\u0435 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u044b\u00bb (1 \u041a\u0430\u0440 5, 8).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044c \u0440\u044b\u0445\u0442\u0443\u0435 \u0434\u043b\u044f \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u0448 \u0448\u043c\u0430\u0442 \u043f\u0430\u0441\u0442\u0430\u043a. \u0410 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u043f\u0440\u044b\u0440\u043e\u0434\u0430 \u0441\u0430\u043c\u0430 \u045e \u0441\u0430\u0431\u0435 \u0441\u043b\u0430\u0431\u0430\u044f, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043d\u0430\u0434 \u0456\u043c \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043d\u0430\u043c \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u044c \u043d\u044f\u0431\u0435\u0441\u043d\u0443\u044e \u0437\u0431\u0440\u043e\u044e. \u0410\u043f\u0440\u0430\u043d\u0456\u0446\u0435\u0441\u044f<\/span><span style=\"font-style: italic;\"> <\/span><span>\u045e \u043f\u0430\u043d\u0446\u044b\u0440 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043d\u0430 \u043d\u043e\u0433\u0456 \u043d\u0430\u0434\u0437\u0435\u043d\u044c\u0446\u0435 \u0433\u0430\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0436\u044b\u0446\u0435 \u0441\u0446\u0451\u0433\u043d\u044b \u0432\u0430\u0448\u044b\u044f \u043f\u0440\u0430\u045e\u0434\u0430\u0439 (\u043f\u0430\u0440. \u042d\u0444 6, 14). \u0426\u0456 \u0431\u0430\u0447\u044b\u0448, \u044f\u043a\u0456\u044f \u0441\u0440\u043e\u0434\u043a\u0456 \u0440\u0430\u0442\u0443\u043d\u043a\u0443 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0442\u0430\u0431\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b? \u042f\u043d\u044b \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u0430\u0434\u043d\u043e\u0439 \u0434\u0430\u0440\u043e\u0433\u0456, \u0434\u0430 \u0430\u0434\u043d\u043e\u0439 \u043c\u044d\u0442\u044b. \u041f\u0440\u044b \u0456\u0445 \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0437 \u043b\u0451\u0433\u043a\u0430\u0441\u0446\u044e \u043c\u043e\u0436\u043d\u0430 \u0456\u0441\u0446\u0456 \u0434\u0430\u0440\u043e\u0433\u0430\u044e \u0436\u044b\u0446\u0446\u044f \u0430\u0436 \u0434\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u044f\u045e \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0436\u044b\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e. \u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0442\u043e\u0439 \u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: \u00ab\u0411\u0443\u0434\u0437\u0435\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0431\u0435\u0433\u0447\u044b \u045e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u043c \u0434\u043b\u044f \u043d\u0430\u0441 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u043f\u0430\u0447\u044b\u043d\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0456 \u0437\u0430\u0432\u044f\u0440\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0432\u0435\u0440\u044b\u00bb (\u0413\u0431\u0440 12, 1-2).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u0432\u0435\u043b\u0456\u0447\u0447\u0443 \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0445\u0442\u043e \u0432\u044b\u0440\u0430\u043a\u0430\u0435\u0446\u0446\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0437\u044f\u043c\u043d\u043e\u0439 \u0441\u043b\u0430\u0432\u044b, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u0430\u0434\u0440\u0430\u0447\u044b\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b. \u0410\u0434\u0440\u0430\u0447\u044b\u0441\u044f \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u2013 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043d\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u043d\u0456\u043a\u043e\u043b\u0456 \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456, \u0430\u043b\u0435 \u0432\u043e\u043b\u0456 \u0411\u043e\u0433\u0430 \u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u044f\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c; \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u043c\u0435\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430 \u043f\u0430-\u0437\u0430 \u0442\u044b\u043c, \u0448\u0442\u043e \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0435. \u0422\u0430\u0434\u044b \u043b\u044f\u0433\u0447\u044d\u0439 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0437\u0430\u0433\u0430\u0434\u044b \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u0437 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044e, \u0434\u0430\u0432\u0435\u0440\u0430\u043c \u0456 \u0430\u0445\u0432\u043e\u0442\u0430\u044e, \u044f\u043a \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0441\u043b\u0443\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0431\u044b\u045e \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b \u0434\u0437\u0435\u043b\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430 \u0431\u0440\u0430\u0442\u043e\u045e. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u0430\u0434\u0430\u0435 \u041f\u0430\u043d, \u043a\u0430\u043b\u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435: \u00ab\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0431\u044b\u0446\u044c \u043f\u0435\u0440\u0448\u044b\u043c, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0437 \u0443\u0441\u0456\u0445 \u0430\u043f\u043e\u0448\u043d\u0456\u043c \u0456 \u0441\u043b\u0443\u0433\u043e\u044e \u045e\u0441\u0456\u0445\u00bb (\u041c\u043a 9, 35).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a\u043e\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u043b\u044e\u0434\u0437\u044f\u043c \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043b\u0456\u0432\u044b\u043c; \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u045e \u044f\u0433\u043e, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0431\u0440\u0430\u0442\u0430\u043c, \u043d\u0456\u0431\u044b \u0456\u0445\u043d\u0456 \u0434\u0430\u045e\u0436\u043d\u0456\u043a. \u0423 \u0441\u0432\u0430\u044e \u0447\u0430\u0440\u0433\u0443 \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u045e\u0437\u044f\u043b\u0456 \u043d\u0430 \u0441\u044f\u0431\u0435 \u0431\u043e\u043b\u044c\u0448\u044b \u0437\u0430 \u0456\u043d\u0448\u044b\u0445 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a, \u0431\u044b\u043b\u0456 \u0431\u043e\u043b\u044c\u0448 \u0441\u0446\u0456\u043f\u043b\u044b\u043c\u0456 \u0437\u0430 \u0441\u0432\u0430\u0456\u0445 \u043f\u0430\u0434\u0434\u0430\u043d\u044b\u0445 \u0456 \u0434\u0430\u0432\u0430\u043b\u0456 \u0456\u043d\u0448\u044b\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0437 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c, \u0448\u0442\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u044b \u0456\u043c, \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0411\u043e\u0436\u0430\u0439 \u0443\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u045e \u0441\u0432\u0430\u044e \u0447\u0430\u0440\u0433\u0443 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0431\u0440\u0430\u0442\u043e\u045e, \u044f\u043a \u043a\u043b\u0430\u043f\u043e\u0446\u044f\u0446\u0446\u0430 \u043f\u0440\u0430 \u0434\u0437\u044f\u0446\u0435\u0439, \u044f\u043a\u0456\u0445 \u0456\u043c \u0434\u0430\u0440\u0443\u0447\u044b\u043b\u0456 \u0431\u0430\u0446\u044c\u043a\u0456, \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044b\u044f \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u044b\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u044b. \u041a\u0430\u043b\u0456 \u0436 \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u2013 \u044f\u043a \u0432\u0443\u0447\u043d\u0456, \u0442\u0430\u043a \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0456, \u2013 \u0430\u0434\u043d\u044b\u044f \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u044e\u0447\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c, \u0434\u0440\u0443\u0433\u0456\u044f \u0441\u0430 \u0448\u0447\u044b\u0440\u0430\u0439 \u0430\u0445\u0432\u043e\u0442\u0430\u044e, \u0432\u0435\u0434\u0443\u0447\u044b \u0431\u0440\u0430\u0442\u043e\u045e \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e \u0430\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0456 \u043f\u0430\u0448\u0430\u043d\u044b, \u0442\u043e \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0432\u0435\u0441\u0446\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0436\u044b\u0446\u0446\u0451, \u0433\u043e\u0434\u043d\u0430\u0435 \u0430\u043d\u0451\u043b\u0430\u045e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0413\u0430\u043b 5, 13; 1 \u041a\u0430\u0440 10, 32\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u0434\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u044b. \u0422\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0441\u0432\u0430\u0431\u043e\u0434\u044b, \u043a\u0430\u0431 \u0434\u0430\u0433\u0430\u0434\u0437\u0456\u0446\u044c \u0446\u0435\u043b\u0443, <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0430\u043b\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0435 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u0443\u043f\u0430\u0434\u043a\u0443 \u043d\u0456 \u0434\u043b\u044f \u044e\u0434\u044d\u044f\u045e, \u043d\u0456 \u0434\u043b\u044f \u0433\u0440\u044d\u043a\u0430\u045e, \u043d\u0456 \u0434\u043b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0411\u043e\u0436\u0430\u0433\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u043b\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"271","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u044f \u0440\u044d\u0433\u0443\u043b\u0430\u00bb \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 2, 4: PL 77, 30-31)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u0441\u0442\u044b\u0440 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b \u045e \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0456, \u0430 \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c \u0443 \u043c\u043e\u0432\u0435&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u0442\u044b\u0440 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u043c \u0443 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0456, \u0430 \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c \u0443 \u043c\u043e\u0432\u0435. \u0401\u043d \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0442\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u0431 \u043c\u0430\u045e\u0447\u0430\u0446\u044c, \u0456 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0437\u0430\u043c\u043e\u045e\u0447\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c. \u0411\u043e \u044f\u043a \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u045e\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0437\u043c\u0430\u043d, \u0442\u0430\u043a \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0435 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u045e \u043f\u0430\u0434\u043c\u0430\u043d\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u043c\u043e\u0433 \u0431\u044b \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0443. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441, \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b, \u0431\u0430\u044e\u0447\u044b\u0441\u044f \u0437\u0433\u0443\u0431\u0456\u0446\u044c \u0441\u0456\u043c\u043f\u0430\u0442\u044b\u044e \u043b\u044e\u0434\u0437\u0435\u0439, \u0447\u0430\u0441\u0442\u0430 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0441\u044f\u0431\u0435 \u0430\u0434 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0435. \u00ab\u041d\u0435 \u0441\u0446\u0435\u0440\u0430\u0433\u0443\u0446\u044c \u0430\u045e\u0447\u0430\u0440\u043d\u0456 \u0437 \u0430\u0434\u0434\u0430\u043d\u043d\u0430\u0441\u0446\u044e \u0434\u043e\u0431\u0440\u044b\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e, \u2013 \u044f\u043a \u043a\u0430\u0436\u0430 \u041f\u0440\u0430\u045e\u0434\u0430, \u2013 \u0430\u043b\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c \u044f\u043a \u043d\u0430\u0439\u043c\u0456\u0442\u044b, \u044f\u043a\u0456\u044f \u045e\u0446\u044f\u043a\u0430\u044e\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u0430\u0433\u0430 \u0432\u0430\u045e\u043a\u0430 \u0456 \u043f\u0440\u044b\u043a\u0440\u044b\u0432\u0430\u044e\u0446\u0446\u0430 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435\u043c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0434\u0430\u043a\u0430\u0440\u0430\u0435 \u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0413\u044d\u0442\u0430 \u043d\u044f\u043c\u044b\u044f \u0441\u0430\u0431\u0430\u043a\u0456, \u044f\u043a\u0456\u044f \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0430\u0434\u0430\u0446\u044c \u0433\u043e\u043b\u0430\u0441\u0443\u00bb (\u043f\u0430\u0440. \u0406\u0441 56, 10). \u0422\u0430\u043c\u0443 \u0434\u0430\u043b\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u0412\u044b \u043d\u0435 \u0441\u0442\u0430\u043b\u0456 \u045e \u0430\u0431\u0430\u0440\u043e\u043d\u0443, \u043d\u0435 \u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456 \u043c\u0443\u0440\u043e\u045e \u0432\u0430\u043a\u043e\u043b \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043a\u0430\u0431 \u0432\u044b\u0441\u0442\u0430\u044f\u0446\u044c \u0443 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435 \u045e \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430\u00bb (\u043f\u0430\u0440. \u042d\u0437\u0445 13, 5). \u0421\u0442\u0430\u0446\u044c \u0443 \u0430\u0431\u0430\u0440\u043e\u043d\u0443 \u2013 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043c\u0443\u0436\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0430\u0431\u0430\u0440\u0430\u043d\u0456\u0446\u044c \u0430\u045e\u0447\u0430\u0440\u043d\u044e \u0430\u0434 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0412\u044b\u0441\u0442\u0430\u044f\u0446\u044c \u0443 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u045e \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430 \u2013 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0441\u0442\u0430\u0446\u044c \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u043c \u0432\u0430\u044f\u0440\u0430\u043c \u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0427\u044b\u043c \u0436\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u0430 \u0441\u0442\u0440\u0430\u0445 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435\u043c \u043f\u0440\u0430\u045e\u0434\u044b, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0443\u0446\u0451\u043a\u0430\u043c\u0456 \u045e \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435? \u0425\u0442\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u045e \u0430\u0431\u0430\u0440\u043e\u043d\u0443 \u0430\u045e\u0447\u0430\u0440\u043d\u0456, \u0442\u043e\u0439 \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f \u043c\u0443\u0440 \u0432\u0430\u043a\u043e\u043b \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0456 \u0442\u0440\u0430\u043f\u043b\u044f\u0435 \u045e \u0433\u0440\u044d\u0445: \u00ab\u041f\u0440\u0430\u0440\u043e\u043a\u0456 \u0442\u0432\u0430\u0435 \u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0442\u0430\u0431\u0435 \u043f\u0443\u0441\u0442\u043e\u0435 \u0456 \u043c\u0430\u0440\u043d\u0430\u0435 \u0456 \u043d\u0435 \u0432\u044b\u043a\u0440\u044b\u0432\u0430\u043b\u0456 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0442\u0432\u0430\u0439\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u0437\u0456\u0446\u044c \u0442\u0432\u043e\u0439 \u043f\u0430\u043b\u043e\u043d\u00bb (\u041f\u043b 2, 14). \u0423 \u0421\u0432\u044f\u0442\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u044c \u0447\u0430\u0441\u0430\u043c \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0437 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u043c\u0456\u043d\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0433\u044d\u0442\u044b\u0445 \u0440\u044d\u0447\u0430\u045e, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u0431\u0443\u0434\u0443\u0447\u044b\u044f. \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u043f\u0430\u043f\u0440\u0430\u043a\u0430\u0435 \u0456\u0445 \u0437\u0430 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u044f \u0432\u0456\u0437\u0456\u0456, \u0431\u043e, \u0431\u0430\u044e\u0447\u044b\u0441\u044f \u0432\u044b\u0441\u0442\u0443\u043f\u0456\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0437\u043b\u0430, \u044f\u043d\u044b \u0431\u0430\u044f\u0437\u043b\u0456\u0432\u0430 \u043b\u0456\u0441\u043b\u0456\u0432\u044f\u0446\u044c \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u043c, \u0430\u0431\u044f\u0446\u0430\u044e\u0447\u044b \u0431\u044f\u0441\u043f\u0435\u043a\u0443. \u041d\u0435 \u0432\u044b\u043a\u0440\u044b\u0432\u0430\u044e\u0446\u044c \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e, \u0431\u043e \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u0446\u0430 \u0430\u0434 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043b\u043e\u0432\u044b \u0434\u0430\u043a\u043e\u0440\u0443 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043d\u0456\u0431\u044b \u043a\u043b\u044e\u0447\u043e\u043c, \u044f\u043a\u0456 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0432\u0456\u043d\u0443, \u043d\u044f\u0440\u044d\u0434\u043a\u0430 \u043d\u0430\u0432\u0430\u0442 \u043d\u0435\u0432\u044f\u0434\u043e\u043c\u0443\u044e \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u044f\u0435 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e. \u0422\u0430\u043c\u0443 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430: \u00ab\u041a\u0430\u0431 \u043c\u043e\u0433 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0446\u044c \u0443 \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u043c \u0432\u0443\u0447\u044d\u043d\u043d\u0456 \u0456 \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c\u00bb (\u0426\u0456\u0442 1, 9). \u0422\u0430\u043c\u0443 \u0456 \u041c\u0430\u043b\u0430\u0445\u0456\u044f \u043a\u0430\u0436\u0430: \u00ab\u0412\u0443\u0441\u043d\u044b \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0441\u0446\u0435\u0440\u0430\u0433\u0447\u044b \u0432\u0435\u0434\u044b, \u0456 \u0442\u0430\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0448\u0443\u043a\u0430\u0446\u044c \u0443 \u044f\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0431\u043e \u0451\u043d \u2013 \u0432\u044b\u0441\u043b\u0430\u043d\u043d\u0456\u043a \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e\u00bb (\u043f\u0430\u0440. \u041c\u0430\u043b 2, 7). \u0410 \u041f\u0430\u043d \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u043f\u0440\u0430\u0437 \u0406\u0441\u0430\u044e: \u00ab\u041a\u0440\u044b\u0447\u044b \u043d\u0430 \u045e\u0441\u044e \u043c\u043e\u0446, \u043d\u0435 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439\u0441\u044f. \u041f\u0430\u0434\u044b\u043c\u0456 \u0433\u043e\u043b\u0430\u0441 \u0441\u0432\u043e\u0439, \u0431\u044b\u0446\u0446\u0430\u043c \u0440\u043e\u0433\u00bb (\u0406\u0441 58, 1).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0445\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u0442\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u043d\u0430 \u0441\u044f\u0431\u0435 \u0437\u0430\u0434\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430. \u0401\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0441\u0442\u0440\u0430\u0448\u043d\u0430\u0433\u0430 \u0421\u0443\u0434\u0434\u0437\u0456, \u044f\u043a\u0456 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c. \u041a\u0430\u043b\u0456 \u0436 \u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0435 \u045e\u043c\u0435\u0435 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u043f\u0430\u0441\u043b\u0443\u0433\u0443 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f, \u044f\u043a \u0436\u0430 \u0431\u0443\u0434\u0437\u0435 \u043a\u0440\u044b\u0447\u0430\u0446\u044c \u0433\u044d\u0442\u044b \u043d\u044f\u043c\u044b \u0432\u044f\u0441\u0442\u0443\u043d? \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0441\u043f\u0430\u0447\u044b\u045e \u043d\u0430\u0434 \u043f\u0435\u0440\u0448\u044b\u043c\u0456 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456 \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u044f\u0437\u044b\u043a\u043e\u045e \u043f\u043e\u043b\u044b\u043c\u044f; \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e, \u0443\u0447\u044b\u043d\u0456\u045e \u0442\u0443\u0442 \u0436\u0430 \u0433\u0430\u0442\u043e\u0432\u044b\u043c\u0456 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u042f\u0433\u043e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 51 (50), 15. 16b-17&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041d\u0430\u0432\u0443\u0447\u0443 \u043d\u044f\u043f\u0440\u0430\u0432\u044b\u0445 \u0448\u043b\u044f\u0445\u0430\u043c \u0422\u0432\u0430\u0456\u043c, \u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0456 \u0434\u0430 \u0426\u044f\u0431\u0435 \u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u041d\u044f\u0445\u0430\u0439 \u0441\u043b\u0430\u0432\u0456\u0446\u044c \u044f\u0437\u044b\u043a \u043c\u043e\u0439 \u0422\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d\u0435, \u0430\u0434\u043a\u0440\u044b\u0439 \u043c\u0430\u0435 \u0432\u0443\u0441\u043d\u044b, \u0456 \u0432\u0443\u0441\u043d\u044b \u043c\u0430\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0422\u0432\u0430\u044e \u0445\u0432\u0430\u043b\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041d\u044f\u0445\u0430\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"272","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u041f\u0440\u0430 \u041a\u0430\u0456\u043d\u0430 \u0456 \u0410\u0431\u044d\u043b\u044f\u00bb \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 1, 9, 34, 38-39: CSEL 32, 371-372)<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0422\u0440\u044d\u0431\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0437\u0430 \u045e\u0441\u0451 \u0446\u0435\u043b\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041f\u0440\u044b\u043d\u043e\u0441\u044c \u0411\u043e\u0433\u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u043f\u0430\u0434\u0437\u044f\u043a\u0456 \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0439 \u0441\u0432\u0430\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456 \u043f\u0435\u0440\u0430\u0434 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c\u00bb (\u041f\u0441 50 [49], 14). \u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u045e\u0437\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u045e \u0456 \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0430\u0434\u0437\u044f\u043a\u0456. \u0422\u0430\u043c\u0443 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0432\u044b\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0442\u0443\u0442 \u0441\u0430\u043c\u0430\u0440\u0430\u043d\u0456\u043d, \u044f\u043a\u0456, \u0430\u0447\u044b\u0441\u0446\u0456\u045e\u0448\u044b\u0441\u044f \u0430\u0434 \u043f\u0440\u0430\u043a\u0430\u0437\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0434\u0437\u0435\u0441\u044f\u0446\u0446\u044e \u0456\u043d\u0448\u044b\u043c\u0456, \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u0411\u043e\u0433\u0430 \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u043c\u0443. \u0415\u0437\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u044f\u0433\u043e: \u00ab\u201d\u041d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u043e\u0441\u044f \u043d\u0456\u043a\u043e\u0433\u0430, \u0445\u0442\u043e \u0431 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u041f\u0430\u043d\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0447\u0443\u0436\u044b\u043d\u0446\u0430?\u201d \u0406 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: \u201c\u0423\u0441\u0442\u0430\u043d\u044c, \u0456\u0434\u0437\u0456; \u0432\u0435\u0440\u0430 \u0442\u0432\u0430\u044f \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043b\u0430 \u0446\u044f\u0431\u0435\u201d\u00bb (\u041b\u043a 17, 18-19).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0432\u0443\u0447\u044b\u045e \u0446\u044f\u0431\u0435 \u043f\u0440\u0430 \u0434\u0430\u0431\u0440\u044b\u043d\u044e \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u044f\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0442\u044b \u043f\u0440\u0430\u0441\u0456\u045e \u0430\u0431 \u043b\u0430\u0441\u0446\u044b \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0434\u043e\u0431\u0440\u044b. \u0417\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u045e \u0434\u0430 \u045e\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0439 \u0456 \u0447\u0430\u0441\u0442\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u0430\u0434\u043d\u0430\u043a \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u044f\u0435 \u043f\u0440\u0430\u0446\u044f\u0433\u043b\u0430\u0441\u0446\u044c \u0441\u0442\u0430\u043c\u043b\u044f\u043b\u0430, \u0430\u043b\u0435 \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u043b\u0430 \u044f\u0435 \u0448\u0447\u044b\u0440\u0430\u0441\u0446\u044c. \u041a\u0430\u043b\u0456 \u0436 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0432\u0435\u043b\u044c\u043c\u0456 \u0434\u043e\u045e\u0433\u0430\u044f, \u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0440\u0430\u0441\u0441\u0435\u0439\u0432\u0430\u043d\u043d\u0435, \u0430 \u043a\u0430\u043b\u0456 \u043d\u044f\u0447\u0430\u0441\u0442\u0430\u044f, \u0442\u043e \u0433\u044d\u0442\u0430 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0441\u0432\u0430\u044e \u0447\u0430\u0440\u0433\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u0443\u0447\u044b\u0446\u044c, \u0448\u0442\u043e, \u043f\u0440\u043e\u0441\u044f\u0447\u044b \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0430\u0431 \u043b\u0430\u0441\u0446\u044b, \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0443\u043c\u0435\u0446\u044c \u0431\u044b\u0446\u044c \u0448\u0447\u043e\u0434\u0440\u044b\u043c \u0434\u043b\u044f \u0456\u043d\u0448\u044b\u0445, \u0456 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0441\u043b\u043e\u0432\u044b \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u0430\u043c \u0443\u0447\u044b\u043d\u043a\u0443. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0440\u0430\u0456\u0446\u044c \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0431\u0435\u0437 \u0433\u043d\u0435\u0432\u0443 \u0456 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0431\u044b\u043b\u0430 \u0448\u0447\u044b\u0440\u0430\u0439 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430\u0439 (\u043f\u0430\u0440. 1 \u0426\u0456\u043c 2, 8). \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0417\u0431\u0430\u045e\u0446\u0430 \u0432\u0443\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0423\u0432\u0430\u0439\u0434\u0437\u0456 \u045e \u043f\u0430\u043a\u043e\u0439 \u0441\u0432\u043e\u0439\u00bb (\u041c\u0446 6, 6).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0442\u0443\u0442 \u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u043f\u0430\u043a\u043e\u0439, \u0430\u0434\u0434\u0437\u0435\u043b\u0435\u043d\u044b \u0441\u0446\u0435\u043d\u0430\u043c\u0456, \u0443 \u044f\u043a\u0456\u043c \u0442\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a, \u0430\u043b\u0435 \u043f\u0440\u0430 \u043f\u0430\u043a\u043e\u0439, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0443 \u0442\u0430\u0431\u0435, \u0443 \u044f\u043a\u0456\u043c \u0437\u0430\u043c\u043a\u043d\u0451\u043d\u044b\u044f \u0442\u0432\u0430\u0435 \u0434\u0443\u043c\u043a\u0456, \u0443 \u044f\u043a\u0456\u043c \u0437\u043c\u044f\u0448\u0447\u0430\u044e\u0446\u0446\u0430 \u0442\u0432\u0430\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0456. \u0413\u044d\u0442\u044b \u043f\u0430\u043a\u043e\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437 \u0442\u0430\u0431\u043e\u044e, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e\u043a\u0440\u044b\u0442\u044b, \u0430 \u0432\u0435\u0434\u0430\u0435 \u044f\u0433\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u0439 \u043f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0437\u0430 \u043d\u0430\u0440\u043e\u0434, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0437\u0430 \u045e\u0441\u0451 \u0446\u0435\u043b\u0430, \u0437\u0430 \u045e\u0441\u0456\u0445 \u0447\u043b\u0435\u043d\u0430\u045e \u041c\u0430\u0446\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e. \u041a\u0430\u043b\u0456 \u043c\u043e\u043b\u0456\u0448\u0441\u044f \u0437\u0430 \u0441\u044f\u0431\u0435, \u0442\u0430\u043a\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0431\u0435. \u041a\u0430\u043b\u0456 \u043a\u043e\u0436\u043d\u044b \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430 \u0441\u044f\u0431\u0435, \u0433\u0440\u044d\u0448\u043d\u0456\u043a \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043c\u0435\u043d\u0448 \u043b\u0430\u0441\u043a\u0456, \u0447\u044b\u043c \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u0456\u043d\u0448\u044b\u0445. \u041a\u0430\u043b\u0456 \u0436 \u043f\u0430\u0430\u0441\u043e\u0431\u043d\u044b\u044f \u0432\u0435\u0440\u043d\u0456\u043a\u0456 \u043c\u043e\u043b\u044f\u0446\u0446\u0430 \u0437\u0430 \u045e\u0441\u0456\u0445, \u0442\u043e \u045e\u0441\u0435 \u043c\u043e\u043b\u044f\u0446\u0446\u0430 \u0437\u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u043c\u043e\u043b\u0456\u0448\u0441\u044f \u0441\u0430\u043c \u0437\u0430 \u0441\u044f\u0431\u0435, \u043c\u043e\u043b\u0456\u0448\u0441\u044f \u2013 \u044f\u043a \u0443\u0436\u043e \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u2013 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0430\u043c. \u041a\u0430\u043b\u0456 \u043c\u043e\u043b\u0456\u0448\u0441\u044f \u0437\u0430 \u045e\u0441\u0456\u0445, \u0443\u0441\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0437\u0430 \u0446\u044f\u0431\u0435. \u0411\u043e \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0448\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0442\u044b. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430&nbsp; \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u0439, \u0431\u043e \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u043f\u0430\u0430\u0441\u043e\u0431\u043d\u044b\u0445 \u0432\u0435\u0440\u043d\u044b\u0445 \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u044e\u0446\u044c \u0434\u043b\u044f \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u0456\u0445 \u0442\u043e\u0435, \u0430\u0431 \u0447\u044b\u043c \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0443\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434. \u041d\u044f\u043c\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u043d\u0430\u0445\u0430\u0431\u0441\u0442\u0432\u0430, \u0430\u043b\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u043f\u0430\u043a\u043e\u0440\u0430 \u0456 \u0431\u043e\u043b\u044c\u0448 \u0448\u0447\u043e\u0434\u0440\u044b \u043f\u043b\u0451\u043d.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 61 (60), 2-3\u0430. 6&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u0447\u0443\u0439, \u0411\u043e\u0436\u0430, \u043c\u0430\u044e \u043f\u0440\u043e\u0441\u044c\u0431\u0443, \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u0439\u0441\u044f \u0434\u0430 \u043c\u0430\u0451\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0417 \u043a\u0440\u0430\u0451\u045e \u0437\u044f\u043c\u043b\u0456 \u044f \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u044e \u0434\u0430 \u0426\u044f\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u043e \u0422\u044b, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430, \u0432\u044b\u0441\u043b\u0443\u0445\u043e\u045e\u0432\u0430\u0435\u0448 \u043c\u0430\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456 \u0456 \u0434\u0430\u0435\u0448 \u043c\u043d\u0435 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u0456\u043c\u0435\u043d\u0456 \u0422\u0432\u0430\u0439\u0433\u043e <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417 \u043a\u0440\u0430\u0451\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"273","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0434\u0430 \u0422\u0440\u0430\u043b\u0456\u0439\u0446\u0430\u045e \u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Inscriptio; nn. 1, 1 \u2212 3, 2; 4, 1-2; 6, 1; 7, 1 \u2013 8, 1: Funk 1, 203-209)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0430\u0447\u0443 \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0447\u044b \u0432\u0430\u0441, \u044f\u043a \u0441\u0432\u0430\u0456\u0445 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406\u0433\u043d\u0430\u0446\u044b\u0439, \u044f\u043a\u043e\u0433\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0422\u044d\u0430\u0444\u043e\u0440\u0430\u043c, \u0422\u0440\u0430\u043b\u0456\u0439\u0441\u043a\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u045e \u0410\u0437\u0456\u0456, \u041a\u0430\u0441\u0446\u0451\u043b\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0430\u043c, \u0410\u0439\u0446\u043e\u043c \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u043c\u0443 \u0456 \u0433\u043e\u0434\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0446\u0435\u043b\u0443, \u043a\u0440\u044b\u0432\u0456 \u0456 \u043f\u0430\u043a\u0443\u0442\u0430\u043c \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u045e \u0447\u0430\u043a\u0430\u043d\u043d\u0456 \u043d\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u045e \u0406\u043c; \u0433\u044d\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u0432\u0456\u0442\u0430\u044e \u0432\u0430 \u045e\u0441\u0456\u043c \u0431\u0430\u0433\u0430\u0446\u0446\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u0437\u0432\u044b\u0447\u0430\u044e \u0456 \u0436\u0430\u0434\u0430\u044e \u044f\u043c\u0443 \u0448\u0447\u043e\u0434\u0440\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0432\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u0446\u0435 \u043d\u044f\u0437\u043b\u043e\u043c\u043d\u0443\u044e \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0443\u044e \u043f\u0430\u0441\u0442\u0430\u0432\u0443 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0432\u044b\u0447\u043a\u0456, \u0430\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u043d\u044f, \u044f\u043a \u043c\u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e \u0432\u0430\u0448 \u0431\u0456\u0441\u043a\u0443\u043f, \u041f\u0430\u043b\u0456\u0431\u0456\u0439, \u044f\u043a\u0456 \u043f\u0440\u044b\u0431\u044b\u045e \u0443 \u0421\u043c\u0456\u0440\u043d\u0443 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u043e\u043b\u0456 \u0411\u043e\u0433\u0430 \u0456 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0447\u044b \u043c\u043d\u0435, \u0432\u044f\u0437\u043d\u044e \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435, \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0456, \u0442\u0430\u043c\u0443 \u044f \u043c\u043e\u0433 \u0431\u0430\u0447\u044b\u0446\u044c \u0443 \u0456\u043c \u0443\u0441\u044e \u0432\u0430\u0448\u0443\u044e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c. \u0410\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u043f\u0440\u0430\u0437 \u044f\u0433\u043e \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0432\u0430\u0448\u0430\u0439 \u0441\u043f\u0430\u0433\u0430\u0434\u044b \u045e \u0411\u043e\u0433\u0443, \u044f \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u045e \u0411\u043e\u0433\u0430, \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c\u0456 \u044f\u043a\u043e\u0433\u0430 \u2013 \u044f\u043a \u044f \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f \u2013 \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u045e \u043f\u043e\u045e\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0456\u0441\u043a\u0443\u043f\u0443 \u044f\u043a \u0415\u0437\u0443\u0441\u0443 \u0425\u0440\u044b\u0441\u0442\u0443, \u0442\u043e \u0431\u0430\u0447\u0443, \u0448\u0442\u043e \u0432\u044b \u043d\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043b\u044e\u0434\u0441\u043a\u0456\u0445 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u044f\u045e, \u0430\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u043f\u0430\u043c\u0451\u0440, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c, \u043c\u044b \u043f\u0430\u0437\u0431\u0435\u0433\u043b\u0456 \u0441\u043c\u0435\u0440\u0446\u0456. \u0422\u0430\u043c\u0443 \u0432\u0430\u0436\u043d\u0430, \u043a\u0430\u0431 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0431\u0435\u0437 \u0431\u0456\u0441\u043a\u0443\u043f\u0430, \u2013 \u0448\u0442\u043e \u0432\u044b \u0434\u0430\u0440\u044d\u0447\u044b \u0456 \u0440\u043e\u0431\u0456\u0446\u0435, \u2013 \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u044b\u0446\u044c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u043c \u044f\u043a \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456, \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0437 \u0406\u043c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u044b\u044f\u043a\u0430\u043d\u044b, \u044f\u043a\u0456\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0456\u0441\u044f \u045e\u0441\u0456\u043c \u0432\u0430 \u045e\u0441\u0456\u043c. \u0411\u043e \u044f\u043d\u044b \u043d\u0435 \u0441\u043b\u0443\u0433\u0456 \u0441\u0442\u0440\u0430\u0432\u0430\u045e \u0456 \u043d\u0430\u043f\u043e\u044f\u045e, \u0430\u043b\u0435 \u0441\u043b\u0443\u0433\u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u044e\u0446\u0446\u0430 \u044f\u043a \u0430\u0433\u043d\u044f \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0434\u0440\u044d\u043d\u043d\u0430\u0433\u0430 \u045e\u0447\u044b\u043d\u043a\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435 \u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u043f\u0430\u0448\u0430\u043d\u0443 \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u043c \u044f\u043a \u0415\u0437\u0443\u0441\u0443 \u0425\u0440\u044b\u0441\u0442\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u0443, \u044f\u043a\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0410\u0439\u0446\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u043c \u2013 \u044f\u043a \u0411\u043e\u0436\u0430\u043c\u0443 \u0441\u0445\u043e\u0434\u0443 \u0456 \u0445\u043e\u0440\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e. \u0411\u0435\u0437 \u0456\u0445 \u043d\u0435\u043b\u044c\u0433\u0430 \u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b. \u042f \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b, \u0448\u0442\u043e \u0432\u044b \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a \u0434\u0443\u043c\u0430\u0435\u0446\u0435. \u0411\u043e \u044f \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0456 \u043c\u0430\u044e \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0432\u0430\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u045e \u0432\u0430\u0448\u044b\u043c \u0431\u0456\u0441\u043a\u0443\u043f\u0435. \u042f\u0433\u043e \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u0435\u043c, \u0430 \u044f\u0433\u043e \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u2013 \u0441\u0456\u043b\u0430\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0441\u043f\u0430\u0437\u043d\u0430\u044e \u0432\u044f\u043b\u0456\u043a\u0456 \u0411\u043e\u0436\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u0430\u043b\u0435 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e \u0441\u044f\u0431\u0435 \u0430\u0434 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043d\u0435 \u045e\u043f\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0445\u0432\u0430\u043b\u0443. \u0410\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0446\u044f\u043f\u0435\u0440 \u043c\u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0431\u0430\u044f\u0446\u0446\u0430 \u0456 \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u043c\u044f\u043d\u0435. \u0411\u043e \u044f \u0436\u0430\u0434\u0430\u044e \u0446\u044f\u0440\u043f\u0435\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0446\u0456 \u044f \u0433\u043e\u0434\u043d\u044b. \u041c\u0430\u044f \u043d\u044f\u0441\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0441\u0446\u044c \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u044f \u0434\u043b\u044f \u045e\u0441\u0456\u0445, \u0430\u043b\u0435 \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u044f\u043d\u0430 \u045e\u0434\u0430\u0440\u0430\u0435 \u045e \u043c\u044f\u043d\u0435 \u0441\u0430\u043c\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u043c\u043d\u0435 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435 \u043a\u043d\u044f\u0437\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0430\u043a\u043b\u0456\u043a\u0430\u044e \u0432\u0430\u0441 \u043d\u0435 \u044f, \u0430\u043b\u0435 \u043b\u044e\u0431\u043e\u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u0432\u044b \u043f\u0440\u044b\u043c\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0443\u044e \u0435\u0436\u0443, \u0430 \u045e\u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456\u0441\u044f \u0430\u0434 \u0430\u0442\u0440\u0443\u0442\u043d\u0430\u0439 \u0440\u0430\u0441\u043b\u0456\u043d\u044b, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0435\u0440\u0430\u0441\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0432\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u045e\u0446\u0430\u043c\u0456 \u0456 \u043d\u0435 \u0430\u0434\u044b\u0434\u0437\u0456\u0446\u0435 \u0430\u0434 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0434 \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456\u0445 \u043d\u0430\u043a\u0430\u0437\u0430\u045e. \u0425\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0442\u043e\u0439 \u0447\u044b\u0441\u0442\u044b, \u0445\u0442\u043e \u0437\u0432\u043e\u043d\u043a\u0443 \u2013 \u043d\u044f\u0447\u044b\u0441\u0442\u044b. \u0406\u043d\u0430\u043a\u0448 \u043a\u0430\u0436\u0443\u0447\u044b, \u0445\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u044c \u0448\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0431\u0435\u0437 \u0431\u0456\u0441\u043a\u0443\u043f\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e \u0456 \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u045e, \u043d\u0435 \u043c\u0430\u0435 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u043f\u0456\u0448\u0443 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u045e \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0442\u0430\u043a\u0456\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b, \u0430\u043b\u0435 \u043f\u0440\u0430\u0433\u043d\u0443 \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0447\u044b \u0432\u0430\u0441 \u044f\u043a \u043c\u0430\u0456\u0445 \u0441\u0430\u043c\u044b\u0445 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u042d\u0444 4, 3-5; 1 \u041a\u0430\u0440 3, 11&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e. \u0410\u0434\u043d\u043e \u0451\u0441\u0446\u044c \u0446\u0435\u043b\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445, \u044f\u043a \u0456 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u045e \u0430\u0434\u043d\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0410\u0434\u0437\u0456\u043d \u0451\u0441\u0446\u044c \u041f\u0430\u043d, \u0430\u0434\u043d\u0430 \u0432\u0435\u0440\u0430, \u0430\u0434\u0437\u0456\u043d \u0445\u0440\u043e\u0441\u0442.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0430\u043a\u043b\u0430\u0441\u0446\u0456 \u0456\u043d\u0448\u0430\u0433\u0430 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443, \u0430\u043a\u0440\u0430\u043c\u044f \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u0434\u0437\u0456\u043d.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"274","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0422\u0440\u0430\u043b\u0456\u0439\u0446\u0430\u045e \u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 8, 1 \u2212 9, 2; 11, 1 \u2013 13, 3: Funk 1, 209-211)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0434\u043d\u0430\u045e\u043b\u044f\u0439\u0446\u0435\u0441\u044f \u045e \u0432\u0435\u0440\u044b, \u044f\u043a\u0430\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0446\u0435\u043b\u0430\u043c \u041f\u0430\u043d\u0430,&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0456 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0430\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u042f\u0433\u043e \u043a\u0440\u044b\u0432\u0451\u044e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u044f \u045e \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0439\u0446\u0435\u0441\u044f \u045e \u0432\u0435\u0440\u044b, \u044f\u043a\u0430\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0446\u0435\u043b\u0430\u043c \u041f\u0430\u043d\u0430, \u0456 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0430\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043a\u0440\u044b\u0432\u0451\u044e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u0437 \u0432\u0430\u0441 \u043d\u0435 \u0442\u0440\u044b\u043c\u0430\u0435 \u043a\u0440\u044b\u045e\u0434\u044b \u043d\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430. \u041d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435, \u043a\u0430\u0431 \u0437-\u0437\u0430 \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456\u0445 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u0437\u043b\u0430\u0441\u043b\u043e\u0432\u0456\u043b\u0456 \u045e\u0441\u044f\u043c\u0443 \u0411\u043e\u0436\u0430\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443: \u00ab\u0413\u043e\u0440\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u044f\u043a\u043e\u0433\u0430 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u041c\u0430\u0451 \u0456\u043c\u044f\u00bb (\u043f\u0430\u0440. \u0406\u0441 52, 5).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u0430\u0436\u0430 \u0432\u0430\u043c \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0435, \u0456 \u043d\u0435 \u043a\u0430\u0436\u0430 \u0432\u0430\u043c \u043f\u0440\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0437 \u0440\u043e\u0434\u0443 \u0414\u0430\u0432\u0456\u0434\u0430, \u043f\u0440\u0430 \u0421\u044b\u043d\u0430 \u041c\u0430\u0440\u044b\u0456, \u044f\u043a\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f, \u0435\u045e \u0456 \u043f\u0456\u045e, \u044f\u043a\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u044b\u045e \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0456 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u043d\u0430 \u043d\u0435\u0431\u0435, \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u043f\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u044e. \u0401\u043d \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u0431\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e \u0410\u0439\u0446\u0435\u0446. \u0406 \u043d\u0430\u0441, \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445 \u0443 \u042f\u0433\u043e, \u0401\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u043f\u0430-\u0437\u0430 \u044f\u043a\u0456\u043c \u043d\u044f\u043c\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0439\u0446\u0435\u0441\u044f \u0448\u043a\u043e\u0434\u043d\u0430\u0439 \u0440\u0430\u0441\u043b\u0456\u043d\u044b, \u044f\u043a\u0430\u044f \u0434\u0430\u0435 \u0441\u043c\u0435\u0440\u0442\u0430\u043d\u043e\u0441\u043d\u044b \u043f\u043b\u043e\u0434. \u0425\u0442\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435 \u044f\u0433\u043e, \u0442\u0443\u0442 \u0436\u0430 \u043f\u0430\u043c\u0456\u0440\u0430\u0435. \u0413\u044d\u0442\u044b\u044f \u0440\u0430\u0441\u043b\u0456\u043d\u044b \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0430\u043c\u0456 \u0410\u0439\u0446\u0430. \u041a\u0430\u043b\u0456 \u0431 \u0442\u0430\u043a\u0456\u043c\u0456 \u0431\u044b\u043b\u0456 \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u0437\u2019\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u0431 \u044f\u043a \u0433\u0430\u043b\u0456\u043d\u043a\u0456 \u043a\u0440\u044b\u0436\u0430, \u0430 \u0456\u0445 \u043f\u043b\u0451\u043d \u0434\u0430\u0432\u0430\u045e \u0431\u044b \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c. \u041f\u0440\u0430\u0437 \u0441\u0432\u043e\u0439 \u043a\u0440\u044b\u0436 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043d\u0430\u0441, \u0441\u0432\u0430\u0456\u0445 \u0447\u043b\u0435\u043d\u0430\u045e, \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445. \u0413\u0430\u043b\u0430\u0432\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u0431\u0435\u0437 \u0447\u043b\u0435\u043d\u0430\u045e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0441\u0430\u043c \u0430\u0431\u044f\u0446\u0430\u0435 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u0456 \u0441\u0430\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u0435\u043c. \u041c\u0430\u0435 \u043a\u0430\u0439\u0434\u0430\u043d\u044b, \u044f\u043a\u0456\u044f \u043d\u0430\u0448\u0443 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u044e, \u043a\u0430\u0431 \u044f \u043c\u043e\u0433 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c \u0432\u0430\u0441 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0437\u0433\u043e\u0434\u0437\u0435 \u0456 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0435. \u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0437 \u0432\u0430\u0441, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u044b, \u0434\u0430\u0434\u0430\u0432\u0430\u043b\u0456 \u0441\u0456\u043b\u044b \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u0410\u0439\u0446\u0430, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0432\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u0446\u0435 \u043c\u044f\u043d\u0435 \u0437 \u043b\u044e\u0431\u043e\u045e\u044e, \u043a\u0430\u0431 \u0433\u044d\u0442\u044b \u043b\u0456\u0441\u0442 \u043d\u0435 \u0441\u0442\u0430\u045e \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0432\u0430\u0441. \u041c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u0446\u044f\u043f\u0435\u0440 \u0437\u0430 \u043c\u044f\u043d\u0435, \u0431\u043e \u045e \u0411\u043e\u0436\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u044f \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e \u0432\u0430\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u044b\u043c \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b, \u044f\u043a\u0430\u044f \u0447\u0430\u043a\u0430\u0435 \u043c\u044f\u043d\u0435, \u0456 \u043d\u0435 \u0431\u044b\u0446\u044c \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0456\u0442\u0430\u0435 \u0432\u0430\u0441 \u043b\u044e\u0431\u043e\u045e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e \u0441\u0430 \u0421\u043c\u0456\u0440\u043d\u044b \u0456 \u042d\u0444\u0435\u0441\u0430. \u041f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445 \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a\u0456 \u045e \u0421\u0456\u0440\u044b\u0456, \u0456\u043c\u044f \u044f\u043a\u043e\u0433\u0430 \u044f \u043d\u0435 \u0432\u0430\u0440\u0442\u044b \u043d\u0430\u0441\u0456\u0446\u044c, \u0431\u043e \u044f \u0430\u043f\u043e\u0448\u043d\u0456 \u0437 \u044f\u0433\u043e \u0447\u043b\u0435\u043d\u0430\u045e. \u0412\u0456\u0442\u0430\u044e \u0432\u0430\u0441 \u0443 \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435; \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u044f \u0431\u0456\u0441\u043a\u0443\u043f\u0443, \u044f\u043a \u0411\u043e\u0436\u044b\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u043c, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u043c. \u041b\u044e\u0431\u0456\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u044e \u0437\u0430 \u0432\u0430\u0441 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u044f\u043f\u0435\u0440, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0434\u0430\u0439\u0434\u0443 \u0434\u0430 \u0411\u043e\u0433\u0430. \u0410\u0436 \u0434\u0430 \u0442\u043e\u0439 \u0445\u0432\u0456\u043b\u0456\u043d\u044b \u043c\u043d\u0435 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0435 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430; \u0430\u0434\u043d\u0430\u043a \u0432\u0435\u0440\u043d\u044b \u0451\u0441\u0446\u044c \u0411\u043e\u0433 \u0443 \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435 \u0456 \u0401\u043d \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u043c\u0430\u044e \u0456 \u0432\u0430\u0448\u0443\u044e \u043f\u0440\u043e\u0441\u044c\u0431\u0443. \u0422\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0406\u043c \u0431\u0435\u0437 \u0433\u0440\u0430\u0445\u0443.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. 2 \u0422\u044d\u0441 2, 14-15\u0430; \u0421\u0456\u0440 15, 13\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e\u0433 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u043f\u0440\u0430\u0437 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0434\u0430 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u0441\u043b\u0430\u0432\u0435 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0422\u0430\u043c\u0443 \u0442\u0440\u044b\u043c\u0430\u0439\u0446\u0435\u0441\u044f \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u0456, \u044f\u043a\u0456\u043c \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423\u0441\u0451 \u0430\u0433\u0456\u0434\u043d\u0430\u0435 \u041f\u0430\u043d \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c, \u0456 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u043d\u044f\u043c\u0456\u043b\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u042f\u0433\u043e \u0431\u0430\u0456\u0446\u0446\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043c\u0443.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"275","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0434\u0430 \u0424\u0456\u043b\u0430\u0434\u044d\u043b\u044c\u0444\u0456\u0439\u0446\u0430\u045e \u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Inscriptio; nn. 1, 1 \u2212 2, 1; 3, 2 \u2013 5: Funk 1, 225-229)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0434\u0437\u0456\u043d \u0431\u0456\u0441\u043a\u0443\u043f \u0437 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u043c\u0456 \u0456 \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u043c\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406\u0433\u043d\u0430\u0446\u044b\u0439, \u043d\u0430\u0437\u044b\u0432\u0430\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0422\u044d\u0430\u0444\u043e\u0440\u0430\u043c, \u0424\u0456\u043b\u0430\u0434\u044d\u043b\u044c\u0444\u0456\u0439\u0441\u043a\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u0456 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u045e \u0410\u0437\u0456\u0456, \u044f\u043a\u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0431\u044b\u045e \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b \u045e \u0441\u043f\u0430\u043a\u043e\u0456 \u0437 \u0411\u043e\u0433\u0430\u043c, \u044f\u043a\u0456 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u043f\u043b\u0451\u043d\u0443 \u043c\u0443\u043a\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430, \u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044e \u0430\u0434\u043e\u0440\u0430\u043d\u044b \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e. \u0413\u044d\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u044f \u0432\u0456\u0442\u0430\u044e \u045e \u043a\u0440\u044b\u0432\u0456 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0401\u043d \u2013 \u043c\u0430\u044f \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u044f \u0456 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430, \u043a\u0430\u043b\u0456 \u044f\u0433\u043e \u0432\u0435\u0440\u043d\u044b\u044f \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u0437 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u043c\u0456 \u0456 \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u043c\u0456, \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u0434\u0443\u043c\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u0432\u043e\u043b\u0456 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0432\u0430\u0448 \u0431\u0456\u0441\u043a\u0443\u043f \u043d\u0435 \u0441\u0430\u043c \u043f\u0430 \u0441\u0430\u0431\u0435 \u043f\u0440\u044b\u043d\u044f\u045e \u043f\u0430\u0441\u043b\u0443\u0433\u0443 \u043a\u0456\u0440\u0430\u0432\u0430\u043d\u043d\u044f \u0456 \u043d\u0435 \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u0446\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0437\u0435\u043b\u044f \u043f\u0443\u0441\u0442\u043e\u0439 \u0441\u043b\u0430\u0432\u044b, \u0430\u043b\u0435 \u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u0456 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u042f \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u044e\u0441\u044f \u044f\u0433\u043e \u0441\u0446\u0456\u043f\u043b\u0430\u0441\u0446\u044e \u0456 \u0442\u044b\u043c, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435 \u0451\u043d \u0431\u043e\u043b\u044c\u0448 \u0440\u043e\u0431\u0456\u0446\u044c, \u0447\u044b\u043c \u043f\u0440\u0430\u0437 \u043f\u0443\u0441\u0442\u044b\u044f \u043f\u0440\u0430\u043c\u043e\u0432\u044b. \u042f\u0433\u043e \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0441\u0443\u0433\u0443\u0447\u043d\u044b\u044f \u0437 \u0411\u043e\u0436\u044b\u043c\u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u043c\u0456, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0430\u0440\u0444\u0430 \u0441\u0430 \u0441\u0442\u0440\u0443\u043d\u0430\u043c\u0456. \u0422\u0430\u043c\u0443 \u044f \u0440\u0430\u0434\u0443\u044e\u0441\u044f \u044f\u0433\u043e \u043f\u0430\u0441\u0442\u0430\u0432\u0435 \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0411\u043e\u0433\u0430, \u0431\u0430\u0447\u0443\u0447\u044b, \u0448\u0442\u043e \u044f\u043d\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f \u0456 \u043f\u043e\u045e\u043d\u0430\u044f \u0446\u043d\u043e\u0442\u0430\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u044f\u0433\u043e \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u0456 \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u043d\u0430 \u045e\u0437\u043e\u0440 \u0436\u044b\u0432\u043e\u0433\u0430 \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u0442\u0430\u043c\u0443, \u0441\u044b\u043d\u044b \u0441\u0432\u044f\u0442\u043b\u0430 \u0456 \u043f\u0440\u0430\u045e\u0434\u044b, \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0439\u0446\u0435\u0441\u044f \u043f\u0430\u0434\u0437\u0435\u043b\u0430\u045e \u0456 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430\u0433\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f; \u0434\u0437\u0435 \u0432\u0430\u0448 \u043f\u0430\u0441\u0442\u044b\u0440, \u0442\u0443\u0434\u044b \u0456\u0434\u0437\u0456\u0446\u0435 \u0456 \u0432\u044b \u044f\u043a \u0430\u045e\u0447\u0430\u0440\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0411\u043e\u0433\u0443 \u0456 \u0415\u0437\u0443\u0441\u0443 \u0425\u0440\u044b\u0441\u0442\u0443, \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u0456 \u0437 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c. \u0422\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u0430\u0437 \u0441\u043a\u0440\u0443\u0445\u0443 \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430 \u0437 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0411\u043e\u0433\u0443, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041d\u0435 \u045e\u0432\u043e\u0434\u0437\u044c\u0446\u0435 \u0441\u044f\u0431\u0435 \u045e \u0437\u043c\u0430\u043d, \u0431\u0440\u0430\u0442\u044b \u043c\u0430\u0435. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u0437\u0430 \u043f\u0430\u0447\u044b\u043d\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u043f\u0430\u0434\u0437\u0435\u043b\u0430\u045e, \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 6, 9. 10). \u0425\u0442\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u0447\u0443\u0436\u043e\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435, \u043d\u044f\u0437\u0433\u043e\u0434\u043d\u044b \u0437 \u043c\u0443\u043a\u0430\u044e \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406\u043c\u043a\u043d\u0456\u0446\u0435\u0441\u044f \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0430\u0434\u043d\u043e\u0439 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0456. \u0411\u043e \u0430\u0434\u043d\u043e \u0451\u0441\u0446\u044c \u0426\u0435\u043b\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0434\u0437\u0456\u043d \u043a\u0435\u043b\u0456\u0445 \u0434\u043b\u044f \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u044f \u043d\u0430\u0441 \u0443 \u042f\u0433\u043e \u041a\u0440\u044b\u0432\u0456, \u0430\u0434\u0437\u0456\u043d \u0430\u043b\u0442\u0430\u0440, \u044f\u043a \u0456 \u0430\u0434\u0437\u0456\u043d \u0431\u0456\u0441\u043a\u0443\u043f \u0437 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u043c\u0456 \u0456 \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u043c\u0456, \u043c\u0430\u0456\u043c\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u043a\u0430\u043c\u0456. \u0422\u0430\u043c\u0443 \u045e\u0441\u0451, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u0435, \u0440\u0430\u0431\u0456\u0446\u0435 \u044f\u043a \u0434\u043b\u044f \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0440\u0430\u0442\u044b \u043c\u0430\u0435, \u044f \u0433\u043e\u0440\u0430\u0447\u0430 \u043b\u044e\u0431\u043b\u044e \u0432\u0430\u0441 \u0456, \u043f\u043e\u045e\u043d\u044b \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0445\u0430\u0447\u0443 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0432\u0430\u0441, \u043d\u0435 \u044f, \u0430\u043b\u0435 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0421\u0442\u0430\u045e\u0448\u044b \u042f\u0433\u043e \u0432\u044f\u0437\u043d\u0435\u043c, \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0431\u0430\u044e\u0441\u044f, \u0431\u043e \u044f \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b. \u0410\u0434\u043d\u0430\u043a \u0432\u0430\u0448\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u0446\u044c \u043c\u044f\u043d\u0435, \u043a\u0430\u0431 \u044f \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u045e \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430\u0439 \u043c\u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b, \u0434\u0430\u0432\u044f\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044e \u044f\u043a \u0446\u0435\u043b\u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c \u044f\u043a \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0444 2, 20. 22. 21\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u044b \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u043d\u0430 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0434\u0437\u0435 \u0441\u0430\u043c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u0443\u0433\u043b\u0430\u0432\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u0435\u043c. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0423<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u0406\u043c \u0456 \u0432\u044b \u0440\u0430\u0437\u0430\u043c \u0431\u0443\u0434\u0443\u0435\u0446\u0435\u0441\u044f, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0436\u044b\u043b\u043b\u0451\u043c \u0411\u043e\u0433\u0430 \u045e \u0414\u0443\u0445\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0430 \u044f\u043a\u0456\u043c \u043a\u043e\u0436\u043d\u044b \u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b \u0431\u0443\u0434\u044b\u043d\u0430\u043a \u0432\u044b\u0440\u0430\u0441\u0442\u0430\u0435 \u044f\u043a \u0441\u0432\u044f\u0442\u0430\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u045e \u041f\u0430\u043d\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0423 \u0406\u043c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"276","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041f\u0435\u0440\u0448\u044b \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u00bb \u0441\u0432. \u0412\u0456\u043d\u0446\u044d\u043d\u0442\u0430 \u041b\u0435\u0440\u044b\u043d\u0441\u043a\u0430\u0433\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 23: PL 50, 667-668)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0420\u0430\u0437\u0432\u0456\u0446\u0446\u0451 \u0434\u0430\u0433\u043c\u0430\u0442\u0443 \u045e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0432\u0435\u0440\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0426\u0456 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u043d\u0435\u0439\u043a\u0430\u0435 \u0440\u0430\u0437\u0432\u0456\u0446\u0446\u0451 \u0432\u0435\u0440\u044b \u045e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435? \u041a\u0430\u043d\u0435\u0448\u043d\u0435, \u043c\u043e\u0436\u0430, \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u0437\u043d\u0430\u0447\u043d\u0430\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0430\u0440\u044d\u0447\u044b, \u0445\u0442\u043e \u0436 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u043a\u0456\u043c \u043d\u0435\u043f\u0440\u044b\u044f\u0437\u043d\u044b\u043c \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0442\u0430\u043a\u0456\u043c \u0432\u0430\u0440\u043e\u0436\u044b\u043c \u0434\u0430 \u0411\u043e\u0433\u0430, \u0448\u0442\u043e \u043f\u0430\u0436\u0430\u0434\u0430\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c \u0433\u044d\u0442\u0430\u043c\u0443? \u0413\u0430\u043b\u043e\u045e\u043d\u0430\u0435, \u043a\u0430\u0431 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0440\u0430\u0437\u0432\u0456\u0446\u0446\u0451 \u0432\u0435\u0440\u044b, \u0430 \u043d\u0435 \u0437\u043c\u0435\u043d\u0430. \u0420\u0430\u0437\u0432\u0456\u0446\u0446\u0451 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u0446\u0446\u0430, \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u044e\u0447\u044b \u0431\u044b\u0446\u044c \u0441\u0430\u0431\u043e\u044e; \u0437\u043c\u0435\u043d\u044b \u0436 \u0430\u0434\u0431\u044b\u0432\u0430\u044e\u0446\u0446\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0430\u0434\u043d\u0430 \u0440\u044d\u0447 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u045e \u0434\u0440\u0443\u0433\u0443\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430, \u043a\u0430\u0431 \u0437 \u0446\u044f\u0433\u0430\u043c \u0447\u0430\u0441\u0443 \u045e \u043a\u043e\u0436\u043d\u044b\u043c \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445, \u0443 \u043f\u0430\u0430\u0441\u043e\u0431\u043d\u044b\u0445 \u0432\u0435\u0440\u043d\u044b\u0445, \u044f\u043a \u0456 \u0432\u0430 \u045e\u0441\u0451\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0440\u0430\u0441\u043b\u043e \u0456 \u0440\u0430\u0437\u0432\u0456\u0432\u0430\u043b\u0430\u0441\u044f \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435, \u0432\u0435\u0434\u044b, \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0430\u0434\u043d\u0430\u043a \u0437 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0433\u0430 \u0441\u0430\u0431\u0435 \u0441\u0442\u0430\u043d\u0443, \u0437 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0442\u0430\u0433\u043e \u0441\u0430\u043c\u0430\u0433\u0430 \u0434\u0430\u0433\u043c\u0430\u0442\u0443, \u0442\u0430\u0433\u043e \u0441\u0430\u043c\u0430\u0433\u0430 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u044f \u0456 \u0442\u0430\u0433\u043e \u0441\u0430\u043c\u0430\u0433\u0430 \u0437\u043c\u0435\u0441\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0427\u043b\u0435\u043d\u044b \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0446\u0456 \u043c\u0430\u043b\u044b\u044f, \u0430 \u045e \u0434\u0430\u0440\u043e\u0441\u043b\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0432\u044f\u043b\u0456\u043a\u0456\u044f, \u0430\u0434\u043d\u0430\u043a \u0433\u044d\u0442\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0442\u044b\u044f \u0441\u0430\u043c\u044b\u044f \u0447\u043b\u0435\u043d\u044b. \u041a\u043e\u043b\u044c\u043a\u0456 \u0456\u0445 \u0443 \u0434\u0437\u044f\u0446\u0435\u0439, \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0456 \u045e \u0434\u0430\u0440\u043e\u0441\u043b\u044b\u0445, \u0430 \u043a\u0430\u043b\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437\u2019\u044f\u0432\u044f\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0440\u043e\u0441\u043b\u044b\u043c \u0443\u0437\u0440\u043e\u0441\u0446\u0435, \u0430\u0434\u043d\u0430\u043a \u0456 \u044f\u043d\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u045e\u0436\u043e \u045e \u0440\u0430\u043d\u0435\u0439\u0448\u044b\u043c \u0437\u0430\u0440\u043e\u0434\u043a\u0443. \u0422\u0430\u043c\u0443 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0441\u0442\u0430\u0440\u043e\u0433\u0430, \u0447\u0430\u0433\u043e \u0440\u0430\u043d\u0435\u0439 \u043d\u0435 \u0431\u044b\u043b\u043e \u045e \u0434\u0437\u0456\u0446\u044f\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u0442\u0430\u043c\u0443 \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u0456 \u0441\u043b\u0443\u0448\u043d\u044b\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u044b\u043d\u0446\u044b\u043f \u0440\u0430\u0437\u0432\u0456\u0446\u0446\u044f, \u043d\u0430\u043b\u0435\u0436\u043d\u044b\u043c \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u043f\u0440\u0430\u0432\u0456\u043b\u0430\u043c \u0440\u0430\u0437\u0432\u0456\u0446\u0446\u044f, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0435\u0439\u0448\u044b\u044f \u0433\u0430\u0434\u044b \u045e \u0431\u043e\u043b\u044c\u0448 \u0431\u0430\u0433\u0430\u0442\u044b\u0445 \u0444\u043e\u0440\u043c\u0430\u0445 \u043f\u0430\u043a\u0430\u0437\u0430\u043b\u0456 \u045e\u0441\u0451 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u0437\u043c\u044f\u0441\u0446\u0456\u043b\u0430 \u045e\u0436\u043e \u043d\u0430 \u0441\u0430\u043c\u044b\u043c \u043f\u0430\u0447\u0430\u0442\u043a\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437 \u0446\u044f\u0433\u0430\u043c \u0447\u0430\u0441\u0443 \u043f\u0440\u044b\u043d\u044f\u045e \u0456\u043d\u0448\u0443\u044e \u0444\u043e\u0440\u043c\u0443, \u043d\u0435 \u0442\u0430\u043a\u0443\u044e \u044f\u043a \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043a\u0430\u043b\u0456 \u0431 \u0437\u043c\u0435\u043d\u0448\u044b\u043b\u0430\u0441\u044f \u0430\u0431\u043e \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u044b\u043b\u0430\u0441\u044f \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u0447\u043b\u0435\u043d\u0430\u045e, \u0442\u0430\u0434\u044b \u045e\u0441\u0451 \u0446\u0435\u043b\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u043e \u0431 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c, \u0431\u044b\u0446\u044c \u043f\u0430\u043a\u0430\u043b\u0435\u0447\u0430\u043d\u044b\u043c, \u0456 \u045e \u043a\u043e\u0436\u043d\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u043e \u0431 \u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0430\u0431\u0435\u0439\u0448\u044b\u043c. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0434\u0430\u0433\u043c\u0430\u0442 \u0432\u0435\u0440\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u0446\u044c \u0437\u0430\u043a\u043e\u043d\u0443 \u0440\u0430\u0437\u0432\u0456\u0446\u0446\u044f, \u043a\u0430\u0431 \u0437 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u0447\u0430\u0441\u0443 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u0446\u0430, \u043f\u0430\u0448\u044b\u0440\u044b\u0446\u0446\u0430 \u0437 \u0433\u0430\u0434\u0430\u043c\u0456 \u0456 \u043f\u0430\u0433\u043b\u044b\u0431\u0456\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0441\u0442\u0430\u0433\u043e\u0434\u0434\u0437\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u0448\u044b\u044f \u043f\u0440\u043e\u0434\u043a\u0456 \u0437\u0430\u0441\u0435\u044f\u043b\u0456 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043f\u043e\u043b\u0435 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043f\u0448\u0430\u043d\u0456\u0446\u0430\u0439 \u0432\u0435\u0440\u044b. \u0411\u044b\u043b\u043e \u0431 \u0434\u0440\u044d\u043d\u043d\u0430 \u0456 \u043d\u044f\u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u0430, \u043a\u0430\u043b\u0456 \u0431 \u043c\u044b, \u0456\u0445 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0456, \u0437\u0431\u0456\u0440\u0430\u043b\u0456 \u0446\u044f\u043f\u0435\u0440 \u043f\u0443\u0441\u0442\u0430\u0437\u0435\u043b\u043b\u0435 \u043f\u0430\u043c\u044b\u043b\u0430\u043a \u0437\u0430\u043c\u0435\u0441\u0442 \u043f\u0440\u0430\u045e\u0434\u044b. \u041d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0433\u044d\u0442\u0430 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u0430 \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u043a\u0430\u0431 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u043d\u0435 \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u044b\u045e \u043a\u0430\u043d\u0446\u0443, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u044f \u043f\u0430\u0441\u0435\u0432\u0443 \u0437\u0435\u0440\u043d\u044f \u0432\u0443\u0447\u044d\u043d\u043d\u044f \u043c\u044b \u0441\u0430\u0431\u0440\u0430\u043b\u0456 \u043f\u043b\u0451\u043d \u0434\u0430\u0433\u043c\u0430\u0442\u0443. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437 \u0446\u044f\u0433\u0430\u043c \u0447\u0430\u0441\u0443 \u043f\u0435\u0440\u0448\u0430\u0441\u043d\u0430\u0435 \u0437\u0435\u0440\u043d\u0435 \u0432\u044b\u0440\u0430\u0441\u043b\u0430, \u0442\u0440\u044d\u0431\u0430 \u044f\u0433\u043e \u0434\u0430\u0433\u043b\u044f\u0434\u0430\u0446\u044c \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0414\u0440\u0433 4, 1\u0430. 2\u0430; \u042f\u043d 6, 63b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0441\u043b\u0443\u0445\u0430\u0439 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0456 \u0437\u0430\u043a\u043e\u043d\u044b, \u044f\u043a\u0456\u044f \u044f \u0432\u0443\u0447\u0443 \u0432\u0430\u0441 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0434\u0430\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u044f \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u0432\u0430\u043c, \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0430\u0434\u044b\u043c\u0430\u0439\u0446\u0435 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0421\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u042f \u043a\u0430\u0436\u0443 \u0432\u0430\u043c, \u0451\u0441\u0446\u044c \u0414\u0443\u0445\u0430\u043c \u0456 \u0436\u044b\u0446\u0446\u0451\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041d\u0456\u0447\u043e\u0433\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"277","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f\u00bb \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 17, 3. 14: PL 76, 1139-1140, 1146)<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0430\u0448\u0430\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c, \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u043c, \u044f\u043a\u0456\u0445 \u0441\u0430\u043c \u043f\u0430\u0441\u043b\u0430\u045e: \u00ab\u0416\u043d\u0456\u0432\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u0434\u044b \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043c\u0430\u043b\u0430; \u0442\u0430\u043c\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u0435 \u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0436\u043d\u0456\u0432\u0430, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u0430\u045e \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043d\u0430 \u0436\u043d\u0456\u0432\u043e \u0441\u0432\u0430\u0451\u00bb (\u041c\u0446 9, 37-38). \u0417\u0430\u043c\u0430\u043b\u0430\u044f \u043b\u0456\u0447\u0431\u0430 \u043f\u0440\u0430\u0446\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u0434\u043b\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0436\u043d\u0456\u0432\u0430. \u041d\u0435 \u043c\u043e\u0436\u0430\u043c \u0431\u0435\u0437 \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0433\u0430 \u0441\u0443\u043c\u0443 \u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0445\u043e\u0446\u044c \u0448\u043c\u0430\u0442 \u0451\u0441\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u0430, \u0430\u0434\u043d\u0430\u043a \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0431\u044b \u044f\u0433\u043e. \u0421\u0432\u0435\u0442 \u043f\u043e\u045e\u043d\u044b \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e, \u0430\u043b\u0435 \u043d\u044f\u0448\u043c\u0430\u0442 \u0451\u0441\u0446\u044c \u043f\u0440\u0430\u0446\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u043d\u0430 \u0436\u043d\u0456\u0432\u0435 \u041f\u0430\u043d\u0430. \u0413\u044d\u0442\u0430 \u043f\u0440\u0430\u045e\u0434\u0430, \u043c\u044b \u043f\u0440\u044b\u043c\u0430\u0435\u043c \u0441\u0442\u0430\u043d \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u0430\u043b\u0435 \u0437\u0430\u0434\u0430\u043d\u043d\u044f\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u0443 \u043d\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u043f\u0430\u0434\u0443\u043c\u0430\u0439\u0446\u0435 \u043d\u0430\u0434 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: \u00ab\u0416\u043d\u0456\u0432\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u0434\u044b \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043c\u0430\u043b\u0430; \u0442\u0430\u043c\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u0435 \u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0436\u043d\u0456\u0432\u0430, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u0430\u045e \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043d\u0430 \u0436\u043d\u0456\u0432\u043e \u0441\u0432\u0430\u0451\u00bb. \u041f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435 \u0441\u043f\u044b\u043d\u044f\u0435\u0446\u0446\u0430 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u0430\u0441\u0446\u0456 \u0441\u043b\u0443\u0445\u0430\u0447\u043e\u045e, \u041f\u0430\u043d \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0443 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044e: \u00ab\u041f\u0440\u0430\u0441\u0456\u0446\u0435 \u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0436\u043d\u0456\u0432\u0430, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u0430\u045e \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043d\u0430 \u0436\u043d\u0456\u0432\u043e \u0441\u0432\u0430\u0451\u00bb. \u041f\u0440\u0430\u0441\u0456\u0446\u0435 \u0437\u0430 \u043d\u0430\u0441, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0434\u043b\u044f \u0432\u0430\u0441 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0442\u0430\u043a, \u044f\u043a \u0432\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u0430\u0440\u0442\u044b\u044f; \u043a\u0430\u0431 \u043d\u0430\u0448 \u044f\u0437\u044b\u043a \u043d\u0435 \u0437\u043c\u0430\u045e\u043a\u0430\u045e, \u043a\u0430\u043b\u0456 \u0442\u0440\u044d\u0431\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0446\u044c, \u043a\u0430\u0431 \u043d\u0430\u0448\u0430\u0435 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043d\u0430 \u0441\u044f\u0431\u0435 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f, \u043d\u0435 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u043b\u0430 \u043d\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0421\u0443\u0434\u0434\u0437\u0451\u044e. \u0411\u043e \u0447\u0430\u0441\u0442\u0430 \u044f\u0437\u044b\u043a \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e \u0437\u0430\u043c\u0430\u045e\u043a\u0430\u0435 \u043f\u0430 \u0456\u0445\u043d\u044f\u0439 \u0436\u0430 \u0432\u0456\u043d\u0435; \u0430\u0434\u043d\u0430\u043a \u0447\u0430\u0441\u0442\u0430 \u0456 \u043f\u0430 \u0432\u0456\u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u0447\u043e\u045e \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u044f\u0437\u044b\u043a \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e \u0447\u0430\u0441\u0430\u043c \u043c\u0430\u045e\u0447\u044b\u0446\u044c \u043f\u0430 \u0456\u0445 \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u0432\u0456\u043d\u0435, \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442: \u00ab\u0410 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0443 \u0411\u043e\u0433 \u0441\u043a\u0430\u0437\u0430\u045e: \u201c\u041d\u0430\u0448\u0442\u043e \u043f\u0435\u0440\u0430\u043b\u0456\u0447\u0432\u0430\u0435\u0448 \u041c\u0430\u0435 \u043d\u0430\u043a\u0430\u0437\u044b\u201d\u00bb (\u041f\u0441 50 [49], 16). \u041f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0456\u0445 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0441\u043f\u044b\u043d\u044f\u0435\u0446\u0446\u0430 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u044b\u0445 \u0441\u043b\u0443\u0445\u0430\u0447\u043e\u045e, \u041f\u0430\u043d \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0443 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044e: \u00ab\u042f \u045e\u0447\u044b\u043d\u044e, \u0448\u0442\u043e \u0442\u0432\u043e\u0439 \u044f\u0437\u044b\u043a \u043f\u0440\u044b\u043b\u0456\u043f\u043d\u0435 \u0434\u0430 \u043f\u0430\u0434\u043d\u044f\u0431\u0435\u043d\u043d\u044f \u0456 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u043d\u044f\u043c\u044b\u043c. \u0406 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0434\u0430\u043a\u0430\u0440\u0430\u0446\u044c \u0456\u0445, \u0431\u043e \u044f\u043d\u044b \u0431\u0443\u043d\u0442\u0430\u045e\u043d\u0456\u0447\u044b \u043d\u0430\u0440\u043e\u0434\u00bb (\u043f\u0430\u0440. \u042d\u0437\u0445 3, 26). \u0422\u044b \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0435\u0448 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c, \u0431\u043e \u0433\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0435 \u041c\u044f\u043d\u0435 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u043c\u0456 \u0456 \u043d\u0435 \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435 \u043d\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u0435 \u0434\u0430 \u043f\u0440\u0430\u045e\u0434\u044b. \u041d\u044f\u043b\u0451\u0433\u043a\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u043f\u0430 \u0447\u044b\u0451\u0439 \u0432\u0456\u043d\u0435 \u0441\u043b\u043e\u0432\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0431\u044b\u043b\u043e \u0437\u0430\u0431\u0440\u0430\u043d\u0430 \u0430\u0434 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e. \u0410\u043b\u0435 \u043f\u0440\u0430\u045e\u0434\u0430 \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0447\u0430\u0441\u0430\u043c \u0448\u043a\u043e\u0434\u0443 \u0432\u0435\u0441\u0442\u0443\u043d\u0430\u043c, \u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u2013 \u0437\u0430\u045e\u0441\u0451\u0434\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u0441\u0446\u044c \u044f\u0448\u0447\u044d \u0430\u0434\u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u0430, \u044f\u043a\u0430\u044f \u045e \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e \u043c\u044f\u043d\u0435 \u0432\u0435\u043b\u044c\u043c\u0456 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u0435. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043a\u0430\u0436\u0443, \u044f \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u044e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0441\u044f\u0431\u0435, \u0431\u043e \u0456 \u044f \u043f\u0430\u0434 \u0446\u0456\u0441\u043a\u0430\u043c \u0436\u0443\u0434\u0430\u0441\u043d\u044b\u0445 \u0447\u0430\u0441\u043e\u045e \u0441\u0430\u0441\u0442\u0443\u043f\u0430\u044e \u043c\u0456\u0436\u0432\u043e\u043b\u044c\u043d\u0430 \u045e \u0433\u044d\u0442\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u0437\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u0437\u043d\u0435\u0448\u043d\u0456\u043c\u0456 \u0440\u044d\u0447\u0430\u043c\u0456, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435 \u043c\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e, \u0430 \u0456\u043d\u0448\u0430\u0435 \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u043c. \u041c\u044b \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u0435\u043c&nbsp; \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0456 \u043d\u0430 \u043d\u0430\u0448\u0430\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u2013 \u044f\u043a \u0431\u0430\u0447\u0443 \u2013 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c\u0441\u044f \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c\u0456. \u0422\u0440\u044b\u043c\u0430\u0435\u043c\u0441\u044f \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456, \u0430 \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u043c \u043f\u0440\u0430 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0456 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456. \u0422\u044b\u044f, \u0445\u0442\u043e \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u044b \u043d\u0430\u043c, \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430, \u0430 \u043c\u044b \u043c\u0430\u045e\u0447\u044b\u043c; \u044f\u043d\u044b \u0430\u043a\u0443\u043d\u0443\u043b\u0456\u0441\u044f \u045e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0430 \u043c\u044b \u043d\u0435 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435\u043c \u0440\u0443\u043a\u0456 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a \u0436\u0430 \u043c\u044b \u0437\u043c\u043e\u0436\u0430\u043c \u0432\u044b\u043f\u0440\u0430\u0432\u0456\u0446\u044c \u0456\u043d\u0448\u044b\u0445, \u043a\u0430\u043b\u0456 \u0441\u0430\u043c\u0456 \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u0435\u043c \u0441\u044f\u0431\u0435? \u0417\u0430\u043d\u044f\u0442\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456 \u0441\u0432\u0435\u0442\u0443, \u043c\u044b \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u043c\u0441\u044f \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u044b\u043c\u0456 \u0434\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u045e, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044e \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0435\u043c \u0441\u044f\u0431\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u043d\u0435\u0448\u043d\u0456\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0441\u0432\u0430\u0456\u0445 \u0445\u0432\u043e\u0440\u044b\u0445 \u0447\u043b\u0435\u043d\u0430\u045e: \u00ab\u041f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u043c\u044f\u043d\u0435 \u043d\u0430 \u0432\u0430\u0440\u0446\u0435 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0430, \u0430 \u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0430 \u043d\u0435 \u045e\u043f\u0456\u043b\u044c\u043d\u0430\u0432\u0430\u045e\u00bb (\u043f\u0430\u0440. \u041f\u043f 1. 6). \u041c\u044b \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b\u044f \u043d\u0430 \u0432\u0430\u0440\u0446\u0435 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0430. \u041d\u0435 \u045e\u043f\u0456\u043b\u044c\u043d\u0430\u0432\u0430\u043b\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0430, \u0431\u043e, \u0437\u0430\u0439\u043c\u0430\u044e\u0447\u044b\u0441\u044f \u0437\u043d\u0435\u0448\u043d\u0456\u043c\u0456 \u0440\u044d\u0447\u0430\u043c\u0456, \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u043b\u0456 \u0441\u0432\u0430\u0451 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041b\u043a 10, 2; \u041f\u0441 62 (61), 9\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0416\u043d\u0456\u0432\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u0434\u044b \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043c\u0430\u043b\u0430; \u0442\u0430\u043c\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u0435 \u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0436\u043d\u0456\u0432\u0430, <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u043a\u0430\u0431 \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430 \u0436\u043d\u0456\u0432\u043e \u0441\u0432\u0430\u0451.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0430\u0440\u043e\u0434\u0437\u0435, \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0439\u0441\u044f \u045e \u043a\u043e\u0436\u043d\u0443\u044e \u0445\u0432\u0456\u043b\u0456\u043d\u0443; \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0432\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"281","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0410\u0433\u0435\u044f\u00bb \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 14: PG 71, 1047-1050)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u0430\u0451 \u0456\u043c\u044f \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u0446\u0430 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u043c\u043e\u043c\u0430\u043d\u0442 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0411\u043e\u0433\u0430 \u0430\u0431\u2019\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u0435; \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u0456 \u045e\u0437\u043d\u0451\u0441\u043b\u0430\u044f \u0437\u0430 \u0431\u044b\u043b\u0443\u044e, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0442\u0430\u0440\u0430\u0437\u0430\u043f\u0430\u0432\u0435\u0442\u043d\u044b \u043a\u0443\u043b\u044c\u0442 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0433\u0430 \u0456 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u043a\u0443\u043b\u044c\u0442\u0443, \u0430 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435 \u0430\u0434 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430 \u0433\u044d\u0442\u0443\u044e \u0442\u044d\u043c\u0443, \u2013 \u044f\u043a \u043c\u044f\u0440\u043a\u0443\u044e, \u2013 \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0435. \u0421\u0432\u044f\u0442\u044b\u043d\u044f \u0431\u044b\u043b\u0430 \u0430\u0434\u043d\u0430, \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435. \u0410\u0445\u0432\u044f\u0440\u044b \u045e \u0451\u0439 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u0456\u0437\u0440\u0430\u044d\u043b\u044c\u0441\u043a\u0456 \u043d\u0430\u0440\u043e\u0434. \u0410\u0434\u043d\u0430\u043a \u0437 \u0442\u0430\u0433\u043e \u043c\u043e\u043c\u0430\u043d\u0442\u0443, \u043a\u0430\u043b\u0456 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0421\u044b\u043d \u0441\u0442\u0430\u045e\u0441\u044f \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u043d\u0430\u0441, \u0445\u043e\u0446\u044c \u00ab\u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u0456 \u0401\u043d \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u043d\u0430\u0441\u00bb (\u041f\u0441 118 [117], 27), \u2013 \u044f\u043a \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0437 \u0442\u0430\u0433\u043e \u043c\u043e\u043c\u0430\u043d\u0442\u0443 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u043c\u0456 \u0456 \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u043c\u0456 \u0448\u0430\u043d\u0430\u0432\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0437 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u0456 \u043a\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430, \u044f\u043a \u0434\u0443\u043c\u0430\u044e, \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u043b\u0430\u0445\u0456\u044f \u0430\u0434 \u0456\u043c\u044f \u0411\u043e\u0433\u0430: \u00ab\u042f \u2013 \u0432\u044f\u043b\u0456\u043a\u0456 \u043a\u0430\u0440\u043e\u043b\u044c, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u041c\u0430\u0451 \u0456\u043c\u044f \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0430 \u045e \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u041c\u0430\u0439\u043c\u0443 \u0456\u043c\u0435\u043d\u0456 \u0434\u0430\u0440 \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u0456 \u0447\u044b\u0441\u0442\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430\u00bb (\u043f\u0430\u0440. \u041c\u0430\u043b 1, 11).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u043d\u043e\u0432\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0448\u043c\u0430\u0442 \u0431\u0430\u0433\u0430\u0446\u0435\u0439\u0448\u0430\u0439. \u0422\u044b\u043c, \u0445\u0442\u043e \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u0456 \u043f\u0440\u0430\u0446\u0443\u0435 \u043d\u0430 \u0431\u0443\u0434\u043e\u0432\u0435 \u0433\u044d\u0442\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0411\u043e\u0433\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u045e\u0434\u0437\u0435\u043b\u0435\u043d\u044b \u0434\u0430\u0440 \u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0437 \u043d\u0435\u0431\u0430 \u2013 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0401\u043d \u2013 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e, \u00ab\u0431\u043e \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u043c\u044b \u043c\u0430\u0435\u043c \u0434\u043e\u0441\u0442\u0443\u043f \u0443 \u0430\u0434\u043d\u044b\u043c \u0414\u0443\u0445\u0443 \u0434\u0430 \u0410\u0439\u0446\u0430\u00bb (\u043f\u0430\u0440. \u042d\u0444 2, 18). \u041f\u0430\u043d \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u0433\u044d\u0442\u0430 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: \u00ab\u0423 \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u042f \u0430\u0434\u0430\u0440\u0443 \u0441\u043f\u0430\u043a\u043e\u0435\u043c\u00bb (\u0410\u0433 2, 9). \u0421\u043f\u0430\u043a\u043e\u0439 \u0434\u0443\u0448\u044b \u2013 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u0430\u0446\u0443\u0435 \u043d\u0430 \u0431\u0443\u0434\u043e\u045e\u043b\u0456 \u0433\u044d\u0442\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456. \u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0436\u0430: \u00ab\u0421\u043f\u0430\u043a\u043e\u0439 \u041c\u043e\u0439 \u0434\u0430\u044e \u0432\u0430\u043c\u00bb (\u042f\u043d 14, 27). \u0410\u0431 \u0442\u044b\u043c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0451\u043d \u043a\u0430\u0440\u044b\u0441\u043d\u044b, \u0432\u0443\u0447\u044b\u0446\u044c \u0441\u0432. \u041f\u0430\u0432\u0435\u043b: \u00ab\u0421\u043f\u0430\u043a\u043e\u0439 \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0456 \u0440\u043e\u0437\u0443\u043c, \u0431\u0443\u0434\u0437\u0435 \u0430\u0431\u0435\u0440\u0430\u0433\u0430\u0446\u044c \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f \u0456 \u0434\u0443\u043c\u043a\u0456 \u0432\u0430\u0448\u044b\u044f\u00bb (\u043f\u0430\u0440. \u0424\u043b\u043f 4, 7). \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0406\u0441\u0430\u044f, \u043c\u0443\u0434\u0440\u044d\u0446, \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0442\u0430\u043a\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: \u00ab\u041f\u0430\u043d\u0435, \u0422\u044b \u0430\u0434\u043e\u0440\u0432\u0430\u0435\u0448 \u043d\u0430\u0441 \u0441\u043f\u0430\u043a\u043e\u0435\u043c, \u0431\u043e \u045e\u0441\u0435 \u043d\u0430\u0448\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0422\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u043b\u044f \u043d\u0430\u0441\u00bb (\u0406\u0441 26, 12). \u0422\u044b\u044f, \u0445\u0442\u043e \u0445\u043e\u0446\u044c \u0440\u0430\u0437 \u0431\u044b\u045e \u0433\u043e\u0434\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b \u0441\u043f\u0430\u043a\u043e\u0439, \u0443\u043c\u0435\u044e\u0446\u044c \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443 \u0456 \u043d\u0430\u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0435 \u0434\u0443\u043c\u043a\u0456 \u043d\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0446\u043d\u043e\u0442\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0441\u043f\u0430\u043a\u043e\u0439 \u0430\u0431\u044f\u0446\u0430\u043d\u044b \u043a\u043e\u0436\u043d\u0430\u043c\u0443, \u0445\u0442\u043e \u0431\u0443\u0434\u0443\u0435. \u0426\u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0435 \u041a\u0430\u0441\u0446\u0451\u043b, \u0456 \u044f\u043a \u043c\u0456\u0441\u0442\u0430\u0433\u043e\u0433, \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b \u043d\u0430\u0447\u0430\u043b\u0435 \u0411\u043e\u0436\u0430\u0439 \u0441\u044f\u043c\u2019\u0456, \u0443\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b; \u0446\u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435 \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443 \u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0436\u044b\u0432\u044b\u043c \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u0435\u043c, \u00ab\u0436\u044b\u043b\u043b\u0451\u043c \u0411\u043e\u0433\u0430 \u045e \u0414\u0443\u0445\u0443\u00bb (\u042d\u0444 2, 22). \u0401\u043d \u0437 \u043b\u0451\u0433\u043a\u0430\u0441\u0446\u044e \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041f\u0441 84 (83), 5; \u0417\u0430\u0445 2, 15\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0434\u043e\u043c\u0435 \u0422\u0432\u0430\u0456\u043c, \u041f\u0430\u043d\u0435, <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u044f\u043d\u044b \u0432\u0435\u0447\u043d\u0430 \u0441\u043f\u044f\u0432\u0430\u044e\u0446\u044c \u0422\u0430\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0434\u0430 \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0443 \u0434\u0437\u0435\u043d\u044c \u0442\u043e\u0439, \u0456 \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0422\u0432\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u042f\u043d\u044b \u0432\u0435\u0447\u043d\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"282","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0424\u0430\u0431\u0456\u044f\u043d\u0430\u00bb \u0441\u0432. \u0424\u0443\u043b\u044c\u0433\u0435\u043d\u0442\u044b\u044f \u0420\u0443\u0441\u043f\u0435\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 28, 16-19: CCL 91 A, 813-814)<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423\u0434\u0437\u0435\u043b \u0443 \u0426\u0435\u043b\u0435 \u0456 \u041a\u0440\u044b\u0432\u0456 \u041f\u0430\u043d\u0430 \u043d\u0430\u0441 \u0430\u0441\u0432\u044f\u0447\u0430\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u044b\u043d\u043e\u0441\u044f\u0447\u044b \u0430\u0445\u0432\u044f\u0440\u044b, \u043c\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u043c \u0437\u0430\u0433\u0430\u0434 \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b, \u043f\u0440\u0430 \u044f\u043a\u043e\u0433\u0430 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0441\u0432\u044f\u0442\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0441\u043b\u043e\u0432\u0430\u043c\u0456: \u00ab\u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0443 \u0442\u0443\u044e \u043d\u043e\u0447, \u043a\u0430\u043b\u0456 \u0431\u044b\u045e \u0432\u044b\u0434\u0430\u043d\u044b, \u0443\u0437\u044f\u045e \u0445\u043b\u0435\u0431, \u0443\u0437\u043d\u0451\u0441 \u043f\u0430\u0434\u0437\u044f\u043a\u0443, \u043f\u0430\u043b\u0430\u043c\u0430\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u201c\u0413\u044d\u0442\u0430 \u0426\u0435\u043b\u0430 \u041c\u0430\u0451, \u044f\u043a\u043e\u0435 \u0437\u0430 \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0434\u0430\u043d\u0430. \u0413\u044d\u0442\u0430 \u0447\u044b\u043d\u0456\u0446\u0435 \u043d\u0430 \u041c\u0430\u044e \u043f\u0430\u043c\u044f\u0446\u044c\u201d. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0437\u044f\u045e \u043f\u0430\u0441\u043b\u044f \u0432\u044f\u0447\u044d\u0440\u044b \u043a\u0435\u043b\u0456\u0445, \u043a\u0430\u0436\u0443\u0447\u044b: \u201c\u0413\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u043a\u0435\u043b\u0456\u0445 \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u045e \u041a\u0440\u044b\u0432\u0456 \u041c\u0430\u0451\u0439. \u041a\u043e\u0436\u043d\u044b \u0440\u0430\u0437, \u043a\u0430\u043b\u0456 \u042f\u0433\u043e \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043f\u0456\u0446\u044c, \u0447\u044b\u043d\u0456\u0446\u0435 \u0433\u044d\u0442\u0430 \u043d\u0430 \u041c\u0430\u044e \u043f\u0430\u043c\u044f\u0446\u044c\u201d. \u041a\u043e\u0436\u043d\u044b \u0440\u0430\u0437, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0435\u0441\u0446\u0456 \u0433\u044d\u0442\u044b \u0425\u043b\u0435\u0431 \u0456 \u043f\u0456\u0446\u044c \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u043a\u0435\u043b\u0456\u0445\u0430, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u0446\u0435 \u0441\u043c\u0435\u0440\u0446\u044c \u041f\u0430\u043d\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0401\u043d \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u00bb (1 \u041a\u0430\u0440 11, 23-26).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0445\u0432\u044f\u0440\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0443\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437\u0430 \u043d\u0430\u0441 \u0430\u0434\u0434\u0430\u045e \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451. \u0401\u043d \u0441\u0430\u043c \u043a\u0430\u0436\u0430: \u00ab\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0437\u0430 \u0442\u0443\u044e, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0430\u0434\u0434\u0430\u0435 \u0437\u0430 \u0441\u044f\u0431\u0440\u043e\u045e \u0441\u0432\u0430\u0456\u0445\u00bb (\u042f\u043d 15, 13). \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u044b\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u043d\u0430\u0441, \u0442\u0430\u043c\u0443 \u043c\u044b \u043a\u043e\u0436\u043d\u044b \u0440\u0430\u0437. \u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043c \u0430\u0445\u0432\u044f\u0440\u0443, \u0443\u0437\u0433\u0430\u0434\u0432\u0430\u0435\u043c \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c, \u043f\u0440\u043e\u0441\u0456\u043c \u0430\u0431 \u0434\u0430\u0440\u044b \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0456 \u045e\u0434\u0437\u044f\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u043e\u0446\u0430\u044e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c. \u0417 \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0442\u0430\u0434\u044b \u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u043c\u043e\u0446\u0430\u044e \u0433\u044d\u0442\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u043f\u0440\u0430\u0437 \u044f\u043a\u0443\u044e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0430\u0434\u0434\u0430\u0446\u044c \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451; \u0434\u043b\u044f \u043d\u0430\u0441, \u043f\u0430\u0441\u043b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u0414\u0443\u0445\u0430 \u0421\u0432\u0430\u044f\u0442\u043e\u0433\u0430, \u0441\u0432\u0435\u0442 \u0431\u044b\u045e \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b, \u0430 \u043c\u044b \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443; \u043a\u0430\u0431 \u043c\u044b \u043d\u0435\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043b\u0456 \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u0425\u0440\u044b\u0441\u0442\u0443, \u00ab\u0431\u043e \u0401\u043d \u043f\u0430\u043c\u0451\u0440 \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443, \u0430 \u0448\u0442\u043e \u0436\u044b\u0432\u0435, \u0434\u044b\u043a \u0436\u044b\u0432\u0435 \u0434\u043b\u044f \u0411\u043e\u0433\u0430\u00bb (\u043f\u0430\u0440. \u0420\u044b\u043c 6, 10), \u2013 \u0445\u0430\u0434\u0437\u0456\u043b\u0456 \u00ab\u045e \u0430\u0431\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456\u00bb (\u0420\u044b\u043c 6, 4). \u0406, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0434\u0430\u0440 \u043b\u044e\u0431\u043e\u0432\u0456, \u043a\u0430\u0431 \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443 \u0456 \u0436\u044b\u043b\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u0432\u044b\u043b\u0456\u043b\u0430\u0441\u044f \u045e \u0441\u044d\u0440\u0446\u044b \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430\u043c\u00bb (\u0420\u044b\u043c 5, 5). \u0421\u0430\u043c \u0443\u0434\u0437\u0435\u043b \u0443 \u0426\u0435\u043b\u0435 \u0456 \u041a\u0440\u044b\u0432\u0456 \u041f\u0430\u043d\u0430 \u043f\u0440\u0430\u0437 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043d\u043d\u0435 \u0445\u043b\u0435\u0431\u0430 \u0456 \u043f\u0456\u0446\u0446\u0451 \u0437 \u043a\u0435\u043b\u0456\u0445\u0430 \u0430\u0431\u0430\u0432\u044f\u0437\u0432\u0430\u0435 \u043d\u0430\u0441 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443 \u0456 \u0432\u0435\u0441\u0446\u0456 \u0436\u044b\u0446\u0446\u0451, \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u0435 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u0411\u043e\u0433\u0443, \u043a\u0430\u0431 \u043c\u044b \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043b\u0456 \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u0441\u0430 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044f\u043c\u0456 \u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u0443\u0441\u0435 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u044f, \u044f\u043a\u0456\u044f \u043b\u044e\u0431\u044f\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0445\u043e\u0446\u044c \u043d\u0435 \u043f\u2019\u044e\u0446\u044c \u0437 \u043a\u0435\u043b\u0456\u0445\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439 \u043c\u0443\u043a\u0456, \u043f\u2019\u044e\u0446\u044c, \u0430\u0434\u043d\u0430\u043a, \u0437 \u043a\u0435\u043b\u0456\u0445\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u041f\u0430\u043d\u0430. \u041d\u0430\u043f\u043e\u0435\u043d\u044b\u044f \u043b\u044e\u0431\u043e\u045e\u044e, \u044f\u043d\u044b \u045e\u0442\u0430\u0439\u043c\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0437\u044f\u043c\u043d\u043e\u0435 \u0446\u0435\u043b\u0430, \u0430 \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u044f \u045e \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0435 \u043a\u043b\u0430\u043f\u043e\u0446\u044f\u0446\u0446\u0430 \u043f\u0440\u0430 \u0437\u044f\u043c\u043d\u044b\u044f \u0440\u044d\u0447\u044b \u0456 \u043d\u0435 \u045e\u0433\u043b\u044f\u0434\u0430\u044e\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0430\u0447\u043d\u0430\u0435, \u0430\u043b\u0435 \u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u043f\u2019\u0451\u043c \u043a\u0435\u043b\u0456\u0445 \u041f\u0430\u043d\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0442\u0440\u044b\u0432\u0430\u0435\u043c \u0443 \u0441\u0432\u044f\u0442\u043e\u0439 \u043b\u044e\u0431\u043e\u0432\u0456; \u0431\u0435\u0437 \u044f\u0435 \u043d\u0430\u0432\u0430\u0442 \u0432\u044b\u0434\u0430\u043d\u043d\u0435 \u0446\u0435\u043b\u0430 \u043d\u0430 \u0441\u043f\u0430\u043b\u044c\u0432\u0430\u043d\u043d\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0437\u043d\u0430\u0447\u044b\u0446\u044c. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0434\u0430\u0440\u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u043c\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u043c\u0441\u044f \u0442\u044b\u043c, \u0448\u0442\u043e \u043c\u0456\u0441\u0442\u044b\u0447\u043d\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u043c \u043f\u0440\u0430\u0437 \u0430\u0445\u0432\u044f\u0440\u0443.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041b\u043a 22, 19; \u042f\u043d 6, 58\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0415\u0437\u0443\u0441, \u0443\u0437\u044f\u045e\u0448\u044b \u0445\u043b\u0435\u0431, \u0443\u0437\u043d\u0451\u0441 \u043f\u0430\u0434\u0437\u044f\u043a\u0443, \u043f\u0430\u043b\u0430\u043c\u0430\u045e \u0456 \u0434\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0413\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u0426\u0435\u043b\u0430 \u041c\u0430\u0451. \u0413\u044d\u0442\u0430 \u0447\u044b\u043d\u0456\u0446\u0435 \u043d\u0430 \u041c\u0430\u044e \u043f\u0430\u043c\u044f\u0446\u044c.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0413\u044d\u0442\u0430 \u0442\u043e\u0439 \u0445\u043b\u0435\u0431, \u044f\u043a\u0456 \u0441\u044b\u0448\u043e\u045e \u0437 \u043d\u0435\u0431\u0430. \u0425\u0442\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435 \u0433\u044d\u0442\u044b \u0445\u043b\u0435\u0431, \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0413\u044d\u0442\u0430 \u0451\u0441\u0446\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"283","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u00bb \u0441\u0432. \u041a\u0430\u043b\u0443\u043c\u0431\u0430\u043d\u0430, \u0430\u0431\u0430\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Instr. De compunctione, 12, 2-3: Opera, Dublin 1957, pp. 112-114)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0421\u0432\u044f\u0442\u0430\u0440\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a\u0456\u044f \u0436 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f, \u044f\u043a\u0456\u044f \u0436 \u00ab\u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0442\u044b\u044f \u0441\u043b\u0443\u0433\u0456, \u044f\u043a\u0456\u0445 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u045e \u0447\u0443\u0432\u0430\u043d\u043d\u0456, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u00bb! (\u041b\u043a 12, 37). \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u0447\u0443\u0432\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0440\u044b\u0445\u0442\u0443\u0435 \u0434\u0430 \u0441\u0443\u0441\u0442\u0440\u044d\u0447\u044b \u0437 \u0411\u043e\u0433\u0430\u043c, \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c \u0443\u0441\u044f\u0433\u043e, \u044f\u043a\u0456 \u0434\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0456 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u0451!<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0456 \u043c\u044f\u043d\u0435, \u0441\u0432\u0430\u0439\u0433\u043e \u043c\u0456\u0437\u044d\u0440\u043d\u0430\u0433\u0430 \u0441\u043b\u0443\u0433\u0443, \u0430\u0431\u0443\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0441\u043d\u0443 \u0456 \u0442\u0430\u043a \u0437\u0430\u043f\u0430\u043b\u0456\u0446\u044c \u0430\u0433\u043d\u0451\u043c \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u043a\u0430\u0431 \u044f\u0435 \u043f\u043b\u043e\u043c\u0435\u043d\u044c, \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u045e\u0437\u043d\u0435\u0441\u043b\u0430\u0441\u044f \u043f\u0430-\u043d\u0430\u0434 \u0437\u043e\u0440\u043a\u0456 \u0456 \u043a\u0430\u0431 \u0441\u0432\u044f\u0442\u044b \u0411\u043e\u0436\u044b \u0430\u0433\u043e\u043d\u044c \u0433\u0430\u0440\u044d\u045e \u0443\u0432\u0430 \u043c\u043d\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b!<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u0431 \u043c\u043e\u0433 \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u0446\u044c, \u043a\u0430\u0431 \u043c\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u043d\u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u043b\u044b\u043c\u043d\u0435\u043b\u0430 \u043d\u043e\u0447\u0447\u0443 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u041f\u0430\u043d\u0430 \u0456 \u0441\u0432\u044f\u0446\u0456\u043b\u0430 \u045e\u0441\u0456\u043c, \u0445\u0442\u043e \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0434\u043e\u043c \u043c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430! \u0410\u0434\u0430\u0440\u044b \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435, \u0443 \u0456\u043c\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0456 \u043c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e, \u043a\u0430\u0431 \u043c\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u043d\u044f \u0441\u0432\u044f\u0446\u0456\u043b\u0430 \u0456 \u043d\u0435 \u0433\u0430\u0441\u043b\u0430; \u043a\u0430\u0431 \u0431\u044b\u043b\u0430 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0436\u0430\u0440\u0430\u043c, \u0434\u043b\u044f \u0456\u043d\u0448\u044b\u0445 \u2013 \u0441\u0432\u044f\u0442\u043b\u043e\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0440\u044b\u0441\u0442\u044d, \u043d\u0430\u0448 \u0441\u0430\u043b\u043e\u0434\u043a\u0456 \u0417\u0431\u0430\u045e\u0446\u0430, \u0422\u044b \u0441\u0430\u043c \u0437\u0430\u043f\u0430\u043b\u0456 \u043d\u0430\u0448\u044b\u044f \u043f\u0430\u0445\u043e\u0434\u043d\u0456; \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u043b\u0430\u044e\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456 \u045e \u0422\u0432\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0430\u0434 \u0426\u044f\u0431\u0435 \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e; \u043d\u044f\u0445\u0430\u0439 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u044e\u0446\u044c \u043d\u0430\u0448 \u0437\u043c\u0440\u043e\u043a \u0456 \u0430\u0434\u0433\u0430\u043d\u044f\u044e\u0446\u044c \u0446\u0435\u043c\u0440\u0443 \u0441\u0432\u0435\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0448\u0443 \u0426\u044f\u0431\u0435, \u043c\u043e\u0439 \u0415\u0437\u0443, \u0437\u0430\u043f\u0430\u043b\u0456 \u043c\u0430\u044e \u043f\u0430\u0445\u043e\u0434\u043d\u044e, \u043a\u0430\u0431 \u0443 \u044f\u0435 \u0441\u0432\u044f\u0442\u043b\u0435 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445, \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0443\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0443 \u044f\u043a\u043e\u0439 \u0436\u044b\u0432\u0435\u0448 \u0422\u044b \u0441\u0430\u043c, \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b \u0421\u0432\u044f\u0442\u0430\u0440 \u0432\u044f\u043a\u043e\u045e, \u043a\u0430\u0431 \u044f \u0441\u0443\u0437\u0456\u0440\u0430\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u0426\u044f\u0431\u0435, \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0426\u044f\u0431\u0435 \u045e\u0433\u043b\u044f\u0434\u0430\u045e\u0441\u044f \u0456 \u0426\u044f\u0431\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u045e; \u043a\u0430\u0431 \u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0426\u044f\u0431\u0435 \u0437 \u043b\u044e\u0431\u043e\u045e\u044e, \u0430 \u043c\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u043d\u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u0432\u044f\u0446\u0456\u043b\u0430 \u0456 \u0433\u0430\u0440\u044d\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u0439\u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0435\u0439\u0448\u044b \u0417\u0431\u0430\u045e\u0446\u0430, \u0437\u2019\u044f\u0432\u0456\u0441\u044f \u043d\u0430\u043c, \u044f\u043a\u0456\u044f \u0441\u0442\u0443\u043a\u0430\u044e\u0446\u044c, \u043a\u0430\u0431 \u043c\u044b, \u043f\u0430\u0437\u043d\u0430\u045e\u0448\u044b \u0426\u044f\u0431\u0435, \u0442\u043e\u043b\u044c\u043a\u0456 \u0426\u044f\u0431\u0435 \u043b\u044e\u0431\u0456\u043b\u0456, \u0442\u043e\u043b\u044c\u043a\u0456 \u0426\u044f\u0431\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u043b\u0456, \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0426\u044f\u0431\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043b\u0456 \u0434\u043d\u0451\u043c \u0456 \u043d\u043e\u0447\u0447\u0443 \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u043b\u0456 \u043f\u0440\u0430 \u0426\u044f\u0431\u0435. \u0423\u043b\u0456 \u045e \u043d\u0430\u0441 \u0442\u0430\u043a\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0426\u044f\u0431\u0435, \u043a\u0430\u0431 \u043c\u044b \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043b\u0456 \u0426\u044f\u0431\u0435 \u0456 \u043b\u044e\u0431\u0456\u043b\u0456 \u0426\u044f\u0431\u0435, \u044f\u043a \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430; \u043d\u0430\u043f\u043e\u045e\u043d\u0456 \u043d\u0430\u0441 \u0434\u0430\u0440\u044d\u0448\u0442\u044b \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u045e\u044e; \u043d\u044f\u0445\u0430\u0439 \u0422\u0432\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0435 \u043d\u0430\u043c\u0456 \u0446\u0430\u043b\u043a\u0430\u043c; \u043d\u044f\u0445\u0430\u0439 \u0422\u0432\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0443\u0441\u0435 \u043d\u0430\u0448\u044b\u044f \u043f\u0430\u0447\u0443\u0446\u0446\u0456, \u043a\u0430\u0431 \u043c\u044b \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u043a\u0440\u0430\u043c\u044f \u0426\u044f\u0431\u0435, \u0432\u0435\u0447\u043d\u044b \u0411\u043e\u0436\u0430! \u0422\u0430\u043a\u043e\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u045e \u043d\u0430\u0441 \u043d\u0435 \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0430\u0433\u0430\u0441\u0456\u0446\u044c \u043d\u0456\u044f\u043a\u0456\u044f \u0432\u043e\u0434\u044b \u0437\u044f\u043c\u043b\u0456, \u043d\u0435\u0431\u0430 \u0456 \u043c\u043e\u0440\u0430, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0442\u044b\u043c, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u00ab\u0412\u044f\u043b\u0456\u043a\u0456\u044f \u0432\u043e\u0434\u044b \u043d\u0435 \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0430\u0433\u0430\u0441\u0456\u0446\u044c \u043a\u0430\u0445\u0430\u043d\u043d\u044f\u00bb (\u041f\u043f 8, 7).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u0446\u0430 \u0433\u044d\u0442\u0430, \u0445\u0430\u0446\u044f \u0431 \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430, \u0456 \u045e \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u043e\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0445\u0432\u0430\u043b\u0430 \u043d\u0430\u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0406\u0441 60, 19-20\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u043e\u043d\u0446\u0430 \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0434\u0437\u0451\u043d\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u043c\u0435\u0441\u044f\u0446\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0446\u044c \u0446\u044f\u0431\u0435, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0430\u043b\u0435 \u041f\u0430\u043d \u0441\u0442\u0430\u043d\u0435 \u0442\u0432\u0430\u0456\u043c \u0432\u0435\u0447\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0456 \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u2013 \u0441\u043b\u0430\u0432\u0430\u0439 \u0442\u0432\u0430\u0451\u0439.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0422\u0432\u0430\u0451 \u0441\u043e\u043d\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0437\u043e\u0439\u0434\u0437\u0435, \u0456 \u043d\u0435 \u0437\u043c\u0435\u043d\u0448\u044b\u0446\u0446\u0430 \u043f\u043e\u045e\u043d\u044f.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u043b\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"284","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u0410\u0434\u043a\u0430\u0437 \u0422\u0430\u043b\u0430\u0441\u0456\u044e\u00bb \u0441\u0432. \u041c\u0430\u043a\u0441\u0456\u043c\u0430 \u0412\u0435\u0440\u0430\u0432\u044b\u0437\u043d\u0430\u045e\u0446\u044b, \u0430\u0431\u0430\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Quaest. 63: PG 90, 667-670)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u0432\u044f\u0442\u043b\u043e, \u044f\u043a\u043e\u0435 \u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0421\u0432\u044f\u0442\u043b\u043e, \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u0430\u0435 \u043d\u0430 \u0441\u0432\u0435\u0447\u043d\u0456\u043a \u2013 \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0410\u0439\u0446\u0430, \u00ab\u044f\u043a\u043e\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0441\u0432\u0435\u0442\u00bb (\u042f\u043d 1, 9), \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043d\u0430\u0448 \u041f\u0430\u043d. \u0401\u043d, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u043d\u044f\u045e \u0446\u0435\u043b\u0430, \u0441\u0442\u0430\u045e \u0456 \u0431\u044b\u045e \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0456 \u0421\u043b\u043e\u0432\u0430\u043c \u0441\u0430\u043c\u043e\u0433\u0430 \u0410\u0439\u0446\u0430. \u0411\u043e\u0436\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0430\u0432\u0443\u0447\u0430\u0435 \u043f\u0440\u0430 \u042f\u0433\u043e \u0437 \u0432\u0435\u0440\u0430\u044e \u0456 \u043b\u044e\u0431\u043e\u045e\u044e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0437\u0432\u044b\u0448\u0430\u0435 \u042f\u0433\u043e \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u043f\u0440\u0430\u0437 \u0436\u044b\u0446\u0446\u0451, \u0437\u0433\u043e\u0434\u043d\u0430\u0435 \u0437 \u0446\u043d\u043e\u0442\u0430\u044e \u0456 \u0437 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e. \u0401\u043d \u044f\u0441\u043d\u0435\u0435 \u0456 \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u0443\u0441\u0456\u043c, \u0445\u0442\u043e \u045e \u0434\u043e\u043c\u0435 (\u043f\u0430\u0440. \u041c\u0446 5, 15), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443 \u0441\u0432\u0435\u0446\u0435, \u044f\u043a \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u0430\u043c \u0411\u043e\u0433-\u0421\u043b\u043e\u0432\u0430 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456: \u00ab\u0406 \u0437\u0430\u043f\u0430\u043b\u0456\u045e\u0448\u044b \u0441\u0432\u0435\u0442\u0430\u0447, \u043d\u0435 \u0441\u0442\u0430\u0432\u044f\u0446\u044c \u044f\u0433\u043e \u043f\u0430\u0434 \u043f\u0430\u0441\u0443\u0434\u0437\u0456\u043d\u0430\u0439, \u0430\u043b\u0435 \u043d\u0430 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0443, \u0456 \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u0443\u0441\u0456\u043c, \u0445\u0442\u043e \u045e \u0434\u043e\u043c\u0435\u00bb (\u041c\u0446 5, 15). \u0401\u043d \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0431\u043e, \u0431\u0443\u0434\u0443\u0447\u044b \u0411\u043e\u0433\u0430\u043c, \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u043a\u0430\u0431 \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a, \u0434\u0443\u043c\u0430\u044e, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u0414\u0430\u0432\u0456\u0434, \u043a\u0430\u043b\u0456 \u043d\u0430\u0437\u0432\u0430\u045e \u041f\u0430\u043d\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0421\u043b\u043e\u0432\u0430 \u0422\u0432\u0430\u0451 \u2013 \u0441\u0432\u0435\u0442\u0430\u0447 \u0434\u043b\u044f \u043c\u0430\u0451\u0439 \u043d\u0430\u0433\u0456 \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u043d\u0430 \u043c\u0430\u0451\u0439 \u0441\u0446\u0435\u0436\u0446\u044b\u00bb (\u041f\u0441 119 [118], 105). \u041c\u043e\u0439 \u0417\u0431\u0430\u045e\u0446\u0430 \u0456 \u0411\u043e\u0433 \u0440\u0430\u0441\u0441\u0435\u0439\u0432\u0430\u0435 \u0446\u0435\u043c\u0440\u0443 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u044f \u0456 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430. \u0422\u0430\u043c\u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043d\u0430\u0437\u0432\u0430\u043b\u0430 \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043b\u043e\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0401\u043d \u0436\u0430 \u043d\u0456\u0431\u044b \u0441\u0432\u044f\u0442\u043b\u043e, \u0440\u0430\u0441\u0441\u0435\u044f\u045e\u0448\u044b \u0446\u0435\u043c\u0440\u0443 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434\u0430\u0433\u043d\u0430\u045e\u0448\u044b \u0446\u0435\u043c\u0440\u0443 \u0433\u0440\u0430\u0445\u0443 \u0456 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f, \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0434\u0430\u0440\u043e\u0433\u0430\u044e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0421\u0432\u0430\u0451\u0439 \u043c\u043e\u0446\u0430\u044e \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0410\u0439\u0446\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0456 \u0436\u0430\u0434\u0430\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0443 \u0406\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u0441\u0432\u0430\u044e \u0447\u0430\u0440\u0433\u0443 \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u0431\u044b\u045e \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0430\u043c, \u0431\u043e \u045e \u0456\u043c \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u043f\u0440\u043e\u043c\u043d\u044f\u043c\u0456 \u043f\u0440\u0430\u045e\u0434\u044b \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0441\u0432\u0435\u0446\u0435, \u043d\u0456\u0431\u044b \u045e \u0434\u043e\u043c\u0435, \u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u043a\u043e\u0436\u043d\u044b \u0440\u043e\u0437\u0443\u043c \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u0430 \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456, \u0441\u044f\u0440\u043e\u0434 \u0441\u0430\u043c\u044b\u0445 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u043d\u043d\u044f\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043d\u0456\u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u043f\u0430\u0434 \u043f\u0430\u0441\u0443\u0434\u0437\u0456\u043d\u0430\u0439. \u0411\u043e \u044f\u043a \u0434\u043e\u045e\u0433\u0430 \u0441\u043b\u043e\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u043f\u0430\u0434 \u043b\u0456\u0442\u0430\u0440\u0430\u0439 \u0437\u0430\u043a\u043e\u043d\u0443 \u044f\u043a \u043f\u0430\u0434 \u043f\u0430\u0441\u0443\u0434\u0437\u0456\u043d\u0430\u0439, \u0443\u0441\u0435 \u043b\u044e\u0434\u0437\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430. \u0423 \u0442\u0430\u043a\u0456\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u044f\u043d\u043e \u043d\u0435 \u0434\u0430\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0431\u0430\u0447\u0430\u043d\u043d\u044f \u0442\u044b\u043c, \u0445\u0442\u043e \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u043f\u0430\u0437\u0431\u044b\u0446\u0446\u0430 \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u0430\u0433\u0430 \u043f\u0430\u0447\u0443\u0446\u0446\u0451\u0432\u0430\u0433\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f, \u0448\u0442\u043e \u045e\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0437\u043c\u0430\u043d \u0456 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c \u043f\u0440\u044b\u0440\u043e\u0434\u043d\u0443\u044e \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u044c \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u045e. \u042f\u043d\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u0430 \u043d\u0430 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0443, \u044f\u043a\u0456\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041a\u0430\u0441\u0446\u0451\u043b, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u0446\u0446\u0430 \u043d\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0456 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0430\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435, \u043a\u0430\u0431 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u0446\u044c \u0443\u0441\u0456\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041b\u0456\u0442\u0430\u0440\u0430 \u0436, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0442\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430, \u043c\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043a\u043e\u0435 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u043d\u0435\u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0430 \u0437 \u044f\u0433\u043e, \u0456 \u0442\u0430\u043c\u0443 \u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u043d\u0443\u0446\u044c \u0443\u0441\u0451 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043f\u0430\u0434 \u043f\u0430\u0441\u0443\u0434\u0437\u0456\u043d\u0443 \u0441\u0432\u044f\u0442\u043b\u043e (\u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0441\u043b\u043e\u0432\u0430, \u0448\u0442\u043e \u0432\u044b\u043a\u0440\u0430\u0441\u0430\u0435 \u043f\u043e\u043b\u044b\u043c\u044f \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f), \u044f\u043a\u043e\u0435 \u043c\u044b \u0437\u0430\u043f\u0430\u043b\u044c\u0432\u0430\u0435\u043c \u043f\u0440\u0430\u0437 \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u0435 \u0456 \u0447\u044b\u043d. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0430\u0431\u043c\u044f\u0436\u043e\u045e\u0432\u0430\u0446\u044c \u043b\u0456\u0442\u0430\u0440\u0430\u0439 \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0443\u044e \u043c\u043e\u0446 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456; \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u043e \u043d\u0430 \u0441\u0432\u0435\u0447\u043d\u0456\u043a, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u043a\u0430\u0431 \u0437 \u0432\u044b\u0441\u043e\u043a\u0430\u0439 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u044f \u0441\u043f\u043b\u044b\u0432\u0430\u045e \u043d\u0430 \u045e\u0441\u0456\u0445 \u0431\u043b\u044f\u0441\u043a \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042f\u043d 12, 35b. 36; 9, 39\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0425\u0430\u0434\u0437\u0456\u0446\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u043c\u0430\u0435\u0446\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u043a\u0430\u0431 \u0446\u0435\u043c\u0440\u0430 \u043d\u0435 \u0430\u0433\u0430\u0440\u043d\u0443\u043b\u0430 \u0432\u0430\u0441. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u041f\u0430\u043a\u0443\u043b\u044c \u043c\u0430\u0435\u0446\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0432\u0435\u0440\u0446\u0435 \u045e \u0441\u0432\u044f\u0442\u043b\u043e, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0441\u0432\u044f\u0442\u043b\u0430.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0433\u044d\u0442\u044b \u0441\u0432\u0435\u0442, \u043a\u0430\u0431 \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u044b\u044f \u0431\u0430\u0447\u044b\u043b\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041f\u0430\u043a\u0443\u043b\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"285","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 26, 4-6: CCL 36, 261-263)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u043e\u0441\u044c \u042f \u045e\u0440\u0430\u0442\u0443\u044e \u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u041c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u0410\u0439\u0446\u0435\u0446, \u044f\u043a\u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435, \u043d\u0435 \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0435 \u044f\u0433\u043e\u00bb (\u042f\u043d 6, 44). \u041d\u0435 \u0434\u0443\u043c\u0430\u0439, \u0448\u0442\u043e \u0446\u044f\u0431\u0435 \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u044e\u0446\u044c \u0433\u0432\u0430\u043b\u0442\u0430\u043c; \u0434\u0443\u0448\u0443 \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043b\u044e\u0431\u043e\u045e. \u041c\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u0430\u044f\u0446\u0446\u0430, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430\u0435 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435 \u0437 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0442\u044b\u044f, \u0445\u0442\u043e \u0448\u0443\u043a\u0430\u0435 \u0441\u043b\u043e\u0432\u0430\u045e, \u0430\u043b\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0411\u043e\u0436\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u045e, \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043f\u0440\u0430\u0447\u0430\u0446\u0446\u0430 \u0437 \u043d\u0430\u043c\u0456 \u0456 \u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u042f\u043a \u044f \u043c\u0430\u0433\u0443 \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c \u0437 \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u0432\u043e\u043b\u0456, \u043a\u0430\u043b\u0456 \u043c\u044f\u043d\u0435 \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u044e\u0446\u044c?\u00bb \u0410\u0434\u043a\u0430\u0437\u0432\u0430\u044e: \u00ab\u041f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u0435 \u0446\u044f\u0431\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u043e\u043b\u044f, \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u0435 \u0446\u044f\u0431\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0441\u0430\u043b\u043e\u0434\u0430\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0431\u044b\u0446\u044c \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443\u0442\u044b\u043c \u0430\u0441\u0430\u043b\u043e\u0434\u0430\u044e? \u00ab\u0420\u0430\u0434\u0443\u0439\u0441\u044f \u045e \u041f\u0430\u043d\u0443, \u2013 \u0456 \u0401\u043d \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430\u00bb (\u041f\u0441 37 [36], 4). \u0406\u0441\u043d\u0443\u0435 \u043d\u0435\u0439\u043a\u0430\u044f \u0430\u0441\u0430\u043b\u043e\u0434\u0430 \u0441\u044d\u0440\u0446\u0430, \u0435\u0436\u0430\u0439 \u044f\u043a\u043e\u0439 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0445\u043b\u0435\u0431. \u041a\u0430\u043b\u0456 \u043f\u0430\u044d\u0442 \u043c\u043e\u0433 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u041a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u0435 \u044f\u0433\u043e \u045e\u043b\u0430\u0441\u043d\u0430\u044f \u0430\u0441\u0430\u043b\u043e\u0434\u0430\u00bb, \u043d\u0435 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0430\u043b\u0435 \u0430\u0441\u0430\u043b\u043e\u0434\u0430, \u043d\u0435 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a, \u0430\u043b\u0435 \u0440\u0430\u0441\u043a\u043e\u0448\u0430, \u0442\u043e \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043e\u043b\u044c\u0448 \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u0430\u0435 \u0437\u0430\u0434\u0430\u0432\u0430\u043b\u044c\u043d\u0435\u043d\u043d\u0435 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0432\u0435\u0447\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u0431\u043e \u045e\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u0446\u0446\u0456 \u0446\u0435\u043b\u0430 \u043c\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u044e \u0430\u0441\u0430\u043b\u043e\u0434\u0443, \u0442\u043e \u0446\u0456 \u0436 \u0434\u0443\u0448\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043c\u0435\u0446\u044c \u0441\u0432\u0430\u044e? \u041a\u0430\u043b\u0456 \u0434\u0443\u0448\u0430 \u045e\u0432\u043e\u0433\u0443\u043b\u0435 \u0456\u0445 \u043d\u0435 \u043c\u0430\u0435, \u0442\u043e \u0447\u0430\u043c\u0443 \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442 \u043a\u0430\u0436\u0430: \u00ab\u0421\u044b\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u0445\u0430\u0432\u0430\u044e\u0446\u0446\u0430 \u045e \u0446\u0435\u043d\u0456 \u043a\u0440\u044b\u043b\u0430\u045e \u0422\u0432\u0430\u0456\u0445. \u041d\u0430\u0441\u044b\u0447\u0430\u044e\u0446\u0446\u0430 \u0442\u0443\u043a\u0430\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443, \u0422\u044b \u043f\u043e\u0456\u0448 \u0456\u0445 \u043f\u0430\u0442\u043e\u043a\u0430\u043c \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u0441\u0432\u0430\u0451\u0439, \u0431\u043e \u045e \u0422\u0430\u0431\u0435 \u2013 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f, \u0456 \u045e \u0422\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u0435 \u043c\u044b \u0431\u0430\u0447\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u00bb (\u041f\u0441 36 [35], 8-10).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u0434\u0430 \u043c\u044f\u043d\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c, \u0456 \u0451\u043d \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u044f \u043a\u0430\u0436\u0443. \u041f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u0433\u043e\u043b\u0430\u0434, \u0448\u0442\u043e \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0443\u0435, \u0445\u0442\u043e \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u0441\u043c\u0430\u0433\u0443 \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0456 \u0445\u0442\u043e \u0441\u0443\u043c\u0443\u0435 \u043f\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0432\u0435\u0447\u043d\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u044b; \u0442\u0430\u043a\u043e\u0433\u0430 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u0434\u0430 \u043c\u044f\u043d\u0435, \u0456 \u0451\u043d \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u043c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b. \u0411\u043e \u043a\u0430\u043b\u0456 \u044f \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u044e \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0437 \u0445\u0430\u043b\u043e\u0434\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u0451\u043d \u043d\u0435 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u044f \u043a\u0430\u0436\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0448 \u0437\u044f\u043b\u0451\u043d\u0443\u044e \u0433\u0430\u043b\u0456\u043d\u043a\u0443 \u0430\u0432\u0435\u0447\u0446\u044b \u0456 \u0433\u044d\u0442\u044b\u043c \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u0435\u0448 \u044f\u0435;&nbsp; \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0448 \u0430\u0440\u044d\u0445\u0456 \u0434\u0437\u0456\u0446\u044f\u0446\u0456, \u0456 \u044f\u043d\u043e \u0446\u044f\u0433\u043d\u0435\u0446\u0446\u0430; \u0431\u044f\u0436\u044b\u0446\u044c \u0442\u0443\u0434\u044b, \u043a\u0443\u0434\u044b \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u0435\u0446\u0446\u0430; \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443\u0442\u044b\u044f \u043b\u044e\u0431\u043e\u045e\u044e \u2013 \u0433\u044d\u0442\u0430 \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443\u0442\u044b\u044f \u043d\u0435 \u0441\u0456\u043b\u0430\u0439, \u0430\u043b\u0435 \u043f\u043e\u0432\u044f\u0437\u044f\u043c\u0456 \u0441\u044d\u0440\u0446\u0430. \u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456 \u0456 \u0437\u044f\u043c\u043d\u044b\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u044e\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0456\u0445, \u0431\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0441\u043b\u043e\u0432\u044b: \u00ab\u041a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u0435 \u044f\u0433\u043e \u045e\u043b\u0430\u0441\u043d\u0430\u044f \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044c\u00bb, \u0442\u043e \u0446\u0456 \u0436 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u043e\u0433\u0430 \u0430\u0431\u2019\u044f\u0432\u0456\u045e \u0410\u0439\u0446\u0435\u0446, \u043d\u0435 \u0437\u043c\u043e\u0433 \u0431\u044b \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443\u0446\u044c? \u0410 \u0447\u0430\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0435 \u0434\u0443\u0448\u0430 \u0431\u043e\u043b\u044c\u0448, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u044b? \u0427\u0430\u043c\u0443 \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u0433\u043e\u043b\u0430\u0434? \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0451\u0439 \u0437\u0434\u0430\u0440\u043e\u0432\u0430\u0435 \u043f\u0430\u0434\u043d\u044f\u0431\u0435\u043d\u043d\u0435, \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0435 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0443, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0456 \u043f\u0456\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043f\u0440\u0430\u045e\u0434\u0443 \u0456 \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u044f \u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u0447\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456\u00bb (\u041c\u0446 5, 6) \u0442\u0443\u0442 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u00ab\u0431\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0441\u044b\u0447\u0430\u043d\u044b\u00bb \u0442\u0430\u043c, \u0443 \u043d\u0435\u0431\u0435! \u0422\u0430\u043a\u043e\u043c\u0443 \u042f \u0434\u0430\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0451\u043d \u043b\u044e\u0431\u0456\u0446\u044c, \u0430\u0434\u0430\u0440\u0443 \u044f\u0433\u043e \u0442\u044b\u043c, \u0447\u0430\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0435. \u0401\u043d \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u0435, \u0443 \u0448\u0442\u043e \u0432\u0435\u0440\u044b\u045e, \u043d\u0435 \u0431\u0430\u0447\u0443\u0447\u044b; \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0443\u045e; \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u0446\u0430 \u0442\u044b\u043c, \u0447\u0430\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0443\u045e. \u041a\u0430\u043b\u0456? \u0414\u0437\u0435? \u041f\u0430\u0434\u0447\u0430\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0431\u043e \u00ab\u042f \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u0443 \u044f\u0433\u043e \u045e \u0430\u043f\u043e\u0448\u043d\u0456 \u0434\u0437\u0435\u043d\u044c\u00bb (\u042f\u043d 6, 54).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042f\u043d 6, 44. 45\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u041c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u0410\u0439\u0446\u0435\u0446, \u044f\u043a\u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435, \u043d\u0435 \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0435 \u044f\u0433\u043e. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0430\u0447\u0443\u045e \u0430\u0434 \u0410\u0439\u0446\u0430 \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u041c\u044f\u043d\u0435.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423 \u041f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u0423\u0441\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u043e\u0436\u043d\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"286","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u043d\u0456\u0433\u0430 \u00ab\u0413\u043e\u0440\u0430\u0434 \u0411\u043e\u0436\u044b\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 10, 6: CCL 47, 278-279)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0447\u044b\u0441\u0442\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430 \u041c\u0430\u0439\u043c\u0443 \u0456\u043c\u0435\u043d\u0456<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043a\u043e\u0436\u043d\u044b \u0447\u044b\u043d, \u044f\u043a\u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u044f \u045e \u0441\u0432\u044f\u0442\u043e\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0437 \u0411\u043e\u0433\u0430\u043c, \u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u0434\u0430 \u0434\u0430\u0431\u0440\u0430, \u044f\u043a\u043e\u0435 \u0434\u0430\u0435 \u043d\u0430\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435. \u0422\u0430\u043c\u0443 \u043d\u0430\u0432\u0430\u0442 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0445\u0432\u044f\u0440\u0430\u0439, \u043a\u0430\u043b\u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u0431\u0435\u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0411\u043e\u0433\u0430. \u0410\u0445\u0432\u044f\u0440\u0430, \u0445\u043e\u0446\u044c \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0436\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0430\u0439. \u0422\u0430\u043c\u0443 \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u044b\u044f \u043b\u0430\u0446\u0456\u043d\u044f\u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0456 \u044f\u0435 <\/span><span style=\"font-style: italic;\">sacrificium<\/span><span> \u2013 \u0441\u0432\u044f\u0442\u043e\u0435 \u0434\u0437\u0435\u044f\u043d\u043d\u0435. \u041a\u043e\u0436\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043f\u0440\u044b\u0441\u0432\u0435\u0447\u0430\u043d\u044b \u0456 \u0430\u0434\u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0411\u043e\u0433\u0443, \u043a\u0430\u043b\u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u0435 \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u0434\u043b\u044f \u0411\u043e\u0433\u0430, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0439. \u0413\u044d\u0442\u0430 \u0456 \u0451\u0441\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u043a\u043e\u0436\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0441\u0430\u043c\u043e\u043c\u0443 \u0441\u0430\u0431\u0435. \u0411\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u00ab\u0411\u0443\u0434\u0437\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b, \u0434\u0430\u0433\u0430\u0434\u0436\u0430\u044e\u0447\u044b \u0411\u043e\u0433\u0443\u00bb (\u043f\u0430\u0440. \u0421\u0456\u0440 30, 24).<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c\u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u043c\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u045e\u0447\u044b\u043d\u043a\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u044b\u044f \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0441\u044f\u0431\u0435 \u0446\u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0433\u0430, \u0456 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044d\u0442\u0430\u044e \u0442\u0430\u043a\u0456\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0448\u0430\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u0430\u0434 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f \u0456 \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u0435 \u0448\u0447\u0430\u0441\u0446\u044f, \u0430 \u0433\u044d\u0442\u0430 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0442\u0430\u043c\u0443 \u0434\u0430\u0431\u0440\u0443, \u043f\u0440\u0430 \u044f\u043a\u043e\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u041c\u043d\u0435 \u0434\u043e\u0431\u0440\u0430 \u0431\u044b\u0446\u044c \u0431\u043b\u0456\u0437\u043a\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430\u00bb (\u041f\u0441 73 [72], 28), \u0442\u043e \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435, \u0448\u0442\u043e \u045e\u0432\u0435\u0441\u044c \u0433\u044d\u0442\u044b \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b \u0433\u043e\u0440\u0430\u0434, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0443\u0441\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0456 \u0441\u0445\u043e\u0434 \u0441\u0432\u044f\u0442\u044b\u0445, \u0430\u0445\u0432\u044f\u0440\u0443\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0443 \u044f\u043a \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0421\u0432\u044f\u0442\u0430\u0440\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043c\u0443\u043a\u0443 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430, \u0441\u0442\u0430\u045e\u0448\u044b \u0441\u043b\u0443\u0433\u043e\u044e, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0441\u0442\u0430\u0446\u044c \u0446\u0435\u043b\u0430\u043c \u0442\u0430\u043a\u043e\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0413\u0430\u043b\u0430\u0432\u044b. \u0413\u044d\u0442\u0443\u044e \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456 \u0401\u043d \u043f\u0440\u044b\u043d\u0451\u0441 \u0443 \u0430\u0445\u0432\u044f\u0440\u0443, \u0443 \u0451\u0439 \u0431\u044b\u045e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u044f\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u043c, \u0443 \u0451\u0439 \u2013 \u0421\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u0443 \u0451\u0439 \u2013 \u0410\u0445\u0432\u044f\u0440\u0430\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043f\u0430\u0436\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u043c\u044b \u0430\u0434\u0434\u0430\u043b\u0456 \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u00ab\u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0443 \u0436\u044b\u0432\u0443\u044e, \u0441\u0432\u044f\u0442\u0443\u044e, \u043f\u0440\u044b\u0435\u043c\u043d\u0443\u044e \u0411\u043e\u0433\u0443 \u044f\u043a \u0432\u044b\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f\u00bb (\u043f\u0430\u0440. \u0420\u044b\u043c 12, 1), \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u043b\u0456\u0441\u044f \u0434\u0430 \u0441\u0432\u0435\u0442\u0443, \u0430\u043b\u0435 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u043b\u0456\u0441\u044f \u043f\u0440\u0430\u0437 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0440\u043e\u0437\u0443\u043c\u0443 \u0434\u043b\u044f \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0411\u043e\u0436\u0430\u044f \u0432\u043e\u043b\u044f, \u0448\u0442\u043e \u0434\u043e\u0431\u0440\u0430\u0435, \u0448\u0442\u043e \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435 \u0411\u043e\u0433\u0443 \u0456 \u0448\u0442\u043e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435, \u0431\u043e \u043c\u044b \u0441\u0430\u043c\u0456 \u0441\u0442\u0432\u0430\u0440\u0430\u0435\u043c \u0430\u0434\u043d\u0443 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443, \u0451\u043d \u043a\u0430\u0436\u0430: \u00ab\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0439 \u043c\u043d\u0435 \u043b\u0430\u0441\u0446\u044b, \u044f \u043a\u0430\u0436\u0443 \u043a\u043e\u0436\u043d\u0430\u043c\u0443, \u0445\u0442\u043e \u0451\u0441\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u043a\u0430\u0431 \u043d\u0435 \u0434\u0443\u043c\u0430\u043b\u0456 \u043f\u0440\u0430 \u0441\u044f\u0431\u0435 \u043b\u0435\u043f\u0448, \u0447\u044b\u043c \u0442\u0440\u044d\u0431\u0430 \u0434\u0443\u043c\u0430\u0446\u044c, \u0430\u043b\u0435 \u0430\u0446\u044d\u043d\u044c\u0432\u0430\u043b\u0456 \u0441\u044f\u0431\u0435 \u0446\u0432\u044f\u0440\u043e\u0437\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u044b, \u0443\u0434\u0437\u0435\u043b\u0435\u043d\u0430\u0439 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0430\u043c. \u0411\u043e \u044f\u043a \u0443 \u0430\u0434\u043d\u044b\u043c \u0446\u0435\u043b\u0435 \u043c\u0430\u0435\u043c \u0448\u043c\u0430\u0442 \u0447\u043b\u0435\u043d\u0430\u045e, \u0456 \u043d\u0435 \u045e\u0441\u0435 \u044f\u043d\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u0442\u044b\u044f \u0441\u0430\u043c\u044b\u044f \u0444\u0443\u043d\u043a\u0446\u044b\u0456, \u0442\u0430\u043a \u0456 \u043c\u044b, \u043c\u043d\u043e\u0433\u0456\u044f, \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u043c \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0430 \u043f\u0430\u0430\u0441\u043e\u0431\u043a\u0443 \u0430\u0434\u0437\u0456\u043d \u0434\u043b\u044f \u0430\u0434\u043d\u0430\u0433\u043e \u2013 \u0447\u043b\u0435\u043d\u044b. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0456 \u043c\u044b \u043c\u0430\u0435\u043c \u0440\u043e\u0437\u043d\u044b\u044f \u0434\u0430\u0440\u044b\u00bb (\u0420\u044b\u043c 12, 3-6).<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430 \u0430\u0445\u0432\u044f\u0440\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e: \u00ab\u0410\u0434\u043d\u043e \u0446\u0435\u043b\u0430 \u2013 \u043c\u044b \u043c\u043d\u043e\u0433\u0456\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435\u00bb (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 10, 17). \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u041a\u0430\u0441\u0446\u0451\u043b \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u0435 \u045e \u0434\u043e\u0431\u0440\u0430 \u0432\u044f\u0434\u043e\u043c\u044b\u043c \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u043c \u0421\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0446\u0435 \u0410\u043b\u0442\u0430\u0440\u0430, \u044f\u043a\u0456 \u0432\u0443\u0447\u044b\u0446\u044c \u044f\u0433\u043e, \u0448\u0442\u043e \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0430\u0445\u0432\u044f\u0440\u0443\u0435, \u0451\u043d \u0430\u0445\u0432\u044f\u0440\u0443\u0435\u0446\u0446\u0430 \u0441\u0430\u043c.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0456\u0445 6, 6\u0430. 8; \u0414\u0440\u0433 10, 14. 12\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417 \u0447\u044b\u043c \u044f \u0437\u2019\u044f\u045e\u043b\u044e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c? \u041e \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0434\u0430\u0431\u0440\u043e\u043c, \u0456 \u0447\u0430\u0433\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0446\u044f\u0431\u0435 \u041f\u0430\u043d:<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u043a\u0430\u0431 \u0442\u044b<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u043f\u0430\u0441\u0442\u0443\u043f\u0430\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u043b\u044e\u0431\u0456\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0445\u0430\u0434\u0437\u0456\u045e \u0443 \u043f\u0430\u043a\u043e\u0440\u044b \u043f\u0435\u0440\u0430\u0434 \u0442\u0432\u0430\u0456\u043c \u0411\u043e\u0433\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u0442\u0432\u0430\u0439\u043c\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044f, \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0430 \u0451\u0439. \u0410 \u0446\u044f\u043f\u0435\u0440, \u0447\u0430\u0433\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0426\u044f\u0431\u0435 \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439?<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431 \u0442\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"287","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u043c \u0441\u0432\u0435\u0446\u0435&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00abGaudium et spes\u00bb \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(N. 40. 45)<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u042f \u2013 \u0410\u043b\u044c\u0444\u0430 \u0456 \u0410\u043c\u0435\u0433\u0430, \u041f\u0435\u0440\u0448\u044b \u0456 \u0410\u043f\u043e\u0448\u043d\u0456<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430\u0435 \u045e\u0437\u0430\u0435\u043c\u0430\u043f\u0440\u0430\u043d\u0456\u043a\u043d\u0435\u043d\u043d\u0435 \u0437\u044f\u043c\u043d\u043e\u0439 \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0434\u0437\u044f\u0440\u0436\u0430\u045e \u043c\u043e\u0436\u043d\u0430 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u0445\u043e\u0446\u044c \u044f\u043d\u043e \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u0439 \u0430\u0437\u043c\u0440\u043e\u0447\u0430\u043d\u0430\u0439 \u0433\u0440\u0430\u0445\u043e\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0456 \u0430\u0436 \u0434\u0430 \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u0430\u0431\u2019\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0441\u0432\u044f\u0442\u043b\u0430 \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445. \u041a\u0430\u0441\u0446\u0451\u043b, \u0456\u0434\u0443\u0447\u044b \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0437\u0431\u0430\u045e\u0447\u0430\u0439 \u043c\u044d\u0442\u044b, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u045e\u0434\u0437\u0435\u043b \u0443 \u0411\u043e\u0436\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u0430\u043b\u0435 \u043d\u0456\u0431\u044b \u043f\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u0446\u0430 \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0411\u043e\u0436\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043f\u0440\u0430\u0437 \u0442\u043e\u0435, \u0448\u0442\u043e \u043b\u0435\u0447\u044b\u0446\u044c \u0456 \u045e\u0437\u0432\u044b\u0448\u0430\u0435 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0430\u0441\u043e\u0431\u044b, \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0441\u0443\u0432\u044f\u0437\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u0442\u0432\u0430 \u0456 \u043d\u0430\u0434\u0430\u0435 \u0433\u043b\u044b\u0431\u0435\u0439\u0448\u044b \u0441\u044d\u043d\u0441 \u0456 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430\u0439 \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456 \u043b\u044e\u0434\u0437\u0435\u0439. \u0422\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b \u043b\u0456\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0456\u0445 \u0430\u0441\u043e\u0431\u043d\u044b\u0445 \u0447\u043b\u0435\u043d\u0430\u045e \u0456 \u045e\u0441\u044e \u0441\u0432\u0430\u044e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0451\u043d \u043c\u043e\u0436\u0430 \u0456\u0441\u0442\u043e\u0442\u043d\u0430 \u043f\u0430\u0441\u043f\u0440\u044b\u044f\u0446\u044c \u0442\u0430\u043c\u0443, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u0441\u044f\u043c\u2019\u044f \u0456 \u044f\u0435 \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u044f \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0456\u0441\u044f \u0431\u043e\u043b\u044c\u0448 \u0433\u0443\u043c\u0430\u043d\u043d\u044b\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u0430\u0441\u0446\u0451\u043b \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u0441\u0432\u0435\u0442\u0443 \u0456 \u0448\u043c\u0430\u0442 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0430\u0434 \u044f\u0433\u043e. \u0401\u043d \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0456 \u0430\u0436\u044b\u0446\u0446\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430. \u0410 \u045e\u0441\u0451 \u0434\u0430\u0431\u0440\u043e, \u044f\u043a\u043e\u0435 \u043d\u0430\u0440\u043e\u0434 \u0411\u043e\u0436\u044b \u043f\u0430\u0434\u0447\u0430\u0441 \u0441\u0432\u0430\u0439\u0433\u043e \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0430\u0432\u0430\u043d\u043d\u044f \u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0441\u044f\u043c\u2019\u0456, \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u041a\u0430\u0441\u0446\u0451\u043b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u00ab\u043f\u0430\u045e\u0441\u044e\u0434\u043d\u044b\u043c \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u00bb, \u044f\u043a\u0456 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0456 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u0411\u043e\u0433\u0430 \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0435 \u045e\u0441\u0451 \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u0441\u0430\u043c\u043e \u0441\u0442\u0430\u043b\u0430 \u0446\u0435\u043b\u0430\u043c \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0431\u0430\u0432\u0456\u045e \u0443\u0441\u0456\u0445 \u0456 \u0430\u0431\u2019\u044f\u0434\u043d\u0430\u045e \u0443 \u0441\u0430\u0431\u0435 \u045e\u0441\u0451. \u041f\u0430\u043d \u2013 \u0433\u044d\u0442\u0430 \u043c\u044d\u0442\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0456, \u043f\u0443\u043d\u043a\u0442, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u0437\u0432\u044f\u0440\u0442\u0430\u044e\u0446\u0446\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0456 \u0456 \u0446\u044b\u0432\u0456\u043b\u0456\u0437\u0430\u0446\u044b\u0439, \u0446\u044d\u043d\u0442\u0440 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0440\u043e\u0434\u0443, \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0443\u0441\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u045e \u0456 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0456\u0445 \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u044f\u045e. \u0401\u043d \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u0410\u0439\u0446\u0435\u0446 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0443\u0437\u0432\u044b\u0441\u0456\u045e \u0456 \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u045e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0441\u044f\u0431\u0435, \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e\u0448\u044b \u042f\u0433\u043e \u0421\u0443\u0434\u0434\u0437\u0451\u0439 \u0436\u044b\u0432\u044b\u0445 \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. \u0410\u0436\u044b\u045e\u043b\u0435\u043d\u044b\u044f \u0456 \u0430\u0431\u2019\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u045e \u042f\u0433\u043e \u0414\u0443\u0445\u0443, \u043c\u044b \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0443\u0435\u043c \u0434\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0456, \u044f\u043a\u043e\u0435 \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u043f\u043b\u0430\u043d\u0443 \u042f\u0433\u043e\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456: \u00ab\u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0443\u0441\u0451 \u045e \u0425\u0440\u044b\u0441\u0446\u0435: \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u0445 \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456\u00bb (\u042d\u0444 1, 10).<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0421\u0430\u043c \u041f\u0430\u043d \u043a\u0430\u0436\u0430: \u00ab\u0412\u043e\u0441\u044c \u043f\u0440\u044b\u0439\u0434\u0443 \u043d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435 \u0456 \u0430\u0434\u043f\u043b\u0430\u0442\u0430 \u041c\u0430\u044f \u0441\u0430 \u041c\u043d\u043e\u044e, \u043a\u0430\u0431 \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445. \u042f \u2013 \u0410\u043b\u044c\u0444\u0430 \u0456 \u0410\u043c\u0435\u0433\u0430, \u041f\u0435\u0440\u0448\u044b \u0456 \u0410\u043f\u043e\u0448\u043d\u0456, \u041f\u0430\u0447\u0430\u0442\u0430\u043a \u0456 \u041a\u0430\u043d\u0435\u0446\u00bb (\u0410\u043f 22, 12-13).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0414\u0437 10, 36; 4, 12\u0430; 10, 42b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u0430\u0451 \u0441\u043b\u043e\u0432\u0430, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u0414\u043e\u0431\u0440\u0443\u044e \u041d\u0430\u0432\u0456\u043d\u0443 \u0430\u0431 \u0441\u043f\u0430\u043a\u043e\u0456 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u041f\u0430\u043d\u0430\u043c \u0443\u0441\u0456\u0445, \u0456 \u043d\u044f\u043c\u0430 \u043d\u0456 \u045e \u043a\u0456\u043c \u0456\u043d\u0448\u044b\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0401\u043d \u2013 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c \u0441\u0443\u0434\u0434\u0437\u044f \u0436\u044b\u0432\u044b\u0445 \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u042f\u043a\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"291","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u041f\u0440\u043e\u0431\u0430\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 130, 8, 15, 17 \u2013 9, 18: CSEL 44, 56-57. 59-60)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u044f\u0445\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435 \u043d\u0430\u0448\u0443\u044e \u043f\u0440\u0430\u0433\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0427\u0430\u043c\u0443 \u043c\u044b \u0431\u043b\u044b\u0442\u0430\u0435\u043c\u0441\u044f \u045e \u0434\u0443\u043c\u043a\u0430\u0445 \u0456 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0435\u043c\u0441\u044f, \u0430\u0431 \u0447\u044b\u043c \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u0431\u0430\u044e\u0447\u044b\u0441\u044f, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0442\u0430\u043a, \u044f\u043a \u0442\u0440\u044d\u0431\u0430? \u0427\u0430\u043c\u0443 \u043d\u0435 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u043f\u0441\u0430\u043b\u044c\u043c\u0430: \u00ab\u0410\u0434\u043d\u0430\u0433\u043e \u044f \u043f\u0440\u0430\u0448\u0443 \u045e \u041f\u0430\u043d\u0430 \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u0430\u0434\u0430\u044e, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u043c\u043d\u0435 \u045e \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0436\u044b\u0446\u0446\u044f \u043c\u0430\u0439\u0433\u043e. \u041a\u0430\u0431 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u0445\u0430\u0440\u0430\u0441\u0442\u0432\u043e \u041f\u0430\u043d\u0430 \u0456 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u043d\u044e\u00bb (\u041f\u0441 27 [26], 4). \u0422\u0430\u043c \u0443\u0441\u0435 \u0434\u043d\u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u0430\u0434\u043d\u044b\u043c, \u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0456 \u043d\u0435 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c, \u0456 \u043d\u0435 \u043f\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u0430\u0434\u0437\u0456\u043d, \u043a\u0430\u043b\u0456 \u0437\u0430\u043a\u0430\u043d\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0440\u0443\u0433\u0456; \u0443\u0441\u0435 \u0442\u0440\u044b\u0432\u0430\u044e\u0446\u044c \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430 \u0440\u0430\u0437\u0430\u043c, \u0430 \u0436\u044b\u0446\u0446\u0451, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c, \u043d\u0435 \u043c\u0430\u0435 \u043a\u0430\u043d\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0416\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c, \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0430 \u043d\u0430\u0441 \u043c\u0430\u043b\u0456\u0446\u0446\u0430. \u041d\u0435 \u045e \u0448\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u0456, \u043d\u0456\u0431\u044b \u0441\u043b\u0443\u0445\u0430\u043d\u043d\u0435 \u0437\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0430\u0434 \u043d\u0430\u0448\u0430\u0433\u0430 \u0448\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u044f. \u041c\u044b \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e, \u2013 \u044f\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u043d\u0430\u043c \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u043c\u044b \u043f\u0430\u043f\u0440\u043e\u0441\u0456\u043c (\u043f\u0430\u0440. \u041c\u0446 6, 7-8).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u043c\u0430\u0433\u043b\u0456 \u0431 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u0446\u0446\u0430, \u0447\u0430\u043c\u0443 \u0434\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u043d\u0430\u0441 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u0435\u0434\u0430\u0435 \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b, \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u043c\u044b \u043f\u0430\u043f\u0440\u043e\u0441\u0456\u043c \u042f\u0433\u043e, \u043a\u0430\u043b\u0456 \u0431 \u043c\u044b \u043d\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u043b\u0456, \u0448\u0442\u043e \u043d\u0430\u0448 \u0411\u043e\u0433 \u0456 \u041f\u0430\u043d \u043d\u0435 \u0445\u043e\u0447\u0430 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430 \u043f\u0440\u0430 \u043d\u0430\u0448\u044b\u044f \u043f\u0430\u0442\u0440\u044d\u0431\u044b, \u0431\u043e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u0456\u0445 \u0432\u0435\u0434\u0430\u0435, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0445\u043e\u0447\u0430 \u0430\u0436\u044b\u0432\u0456\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u043a\u0430\u0431 \u043c\u044b \u045e\u043c\u0435\u043b\u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0451\u043d \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043d\u0430\u043c \u0434\u0430\u0446\u044c. \u0427\u0430\u043c\u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430 \u043d\u0430\u043c: \u00ab\u0410\u0434\u043a\u0440\u044b\u0439\u0446\u0435\u0441\u044f \u0456 \u0432\u044b. \u041d\u0435 \u0445\u0430\u0434\u0437\u0456\u0446\u0435 \u043f\u0430\u0434 \u0447\u0443\u0436\u044b\u043c \u044f\u0440\u043c\u043e\u043c \u0437 \u043d\u044f\u0432\u0435\u0440\u0443\u044e\u0447\u044b\u043c\u0456!\u00bb (\u043f\u0430\u0440. 2 \u041a\u0430\u0440 6, 13-14).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u044b \u0432\u044f\u043b\u0456\u043a\u0456 \u0434\u0430\u0440, \u044f\u043a\u043e\u0433\u0430 \u00ab\u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430\u00bb, \u0431\u043e \u0451\u043d \u043d\u0435 \u043c\u0430\u0435 \u043a\u043e\u043b\u0435\u0440\u0443, \u00ab\u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430\u00bb, \u0431\u043e \u0451\u043d \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u0443\u043a\u0430\u043c, \u00ab\u0456 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0441\u044d\u0440\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u00bb (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 2, 9), \u0431\u043e \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0441\u044d\u0440\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0442\u0443\u0434\u044b \u045e\u0432\u0430\u0439\u0441\u0446\u0456, \u043c\u044b \u043f\u0440\u044b\u043c\u0435\u043c \u044f\u0433\u043e \u0431\u043e\u043b\u044c\u0448 \u043f\u043b\u0451\u043d\u043d\u0430, \u043a\u0430\u043b\u0456 \u043d\u0430\u0448\u0430\u044f \u0432\u0435\u0440\u0430 \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u043c\u043e\u0446\u043d\u0430\u0439, \u043d\u0430\u0448\u0430\u044f \u043d\u0430\u0434\u0437\u0435\u044f \u0431\u043e\u043b\u044c\u0448 \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430\u0439, \u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0431\u043e\u043b\u044c\u0448 \u0433\u0430\u0440\u0430\u0447\u044b\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0433\u044d\u0442\u0430\u0439 \u0432\u0435\u0440\u044b, \u043d\u0430\u0434\u0437\u0435\u0456 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456 \u043c\u044b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0437 \u043d\u0435\u043f\u0430\u0433\u0430\u0441\u043d\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c. \u0410\u0434\u043d\u0430\u043a \u0443 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u0445 \u0433\u0430\u0434\u0437\u0456\u043d\u0430\u0445 \u0456 \u0430\u0431\u0441\u0442\u0430\u0432\u0456\u043d\u0430\u0445 \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u043c\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u0433\u044d\u0442\u044b\u0445 \u0437\u043d\u0430\u043a\u0430\u045e \u043d\u0430\u0433\u0430\u0434\u0430\u0446\u044c \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u045e\u0437\u0440\u0430\u0441\u043b\u0456 \u045e \u0441\u0432\u044f\u0442\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0456, \u0456 \u043a\u0430\u0431 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u0446\u044c \u043d\u0430\u0441 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0446\u044c \u044f\u0433\u043e. \u0427\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0436\u044b\u0432\u044b\u043c \u0431\u0443\u0434\u0437\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448\u044b \u0431\u0443\u0434\u0437\u0435 \u043f\u043b\u0451\u043d. \u0422\u0430\u043c\u0443 \u0441\u043b\u043e\u0432\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430: \u00ab\u041d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u0430\u043b\u0456\u0446\u0435\u0441\u044f\u00bb (1 \u0422\u044d\u0441 5, 17) \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u043d\u0435 \u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u044f\u043a \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u043e\u0436\u0430 \u044f\u0433\u043e \u0434\u0430\u0446\u044c. \u0411\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u043f\u0430-\u0437\u0430 \u0432\u0435\u0447\u043d\u044b\u043c.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0415\u0440 29, 13. 12b. 11b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0412\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u044f\u043d\u0435 \u0448\u0443\u043a\u0430\u0446\u044c<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u0456 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u041c\u044f\u043d\u0435, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u041c\u044f\u043d\u0435.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0412\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043a\u043b\u0456\u043a\u0430\u0446\u044c \u041c\u044f\u043d\u0435, \u0430 \u042f \u0432\u0430\u0441 \u043f\u0430\u0447\u0443\u044e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u0432\u0435\u0434\u0430\u044e \u0441\u0432\u0430\u0435 \u043d\u0430\u043c\u0435\u0440\u044b, \u0448\u0442\u043e \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u043d\u0430\u043a\u043e\u043d\u0442 \u0432\u0430\u0441, \u043d\u0430\u043c\u0435\u0440\u044b \u043c\u0456\u0440\u0443, \u0430 \u043d\u0435 \u045e\u0446\u0456\u0441\u043a\u0443, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0432\u0430\u043c \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u044e \u0456 \u043d\u0430\u0434\u0437\u0435\u044e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0412\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"292","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u041f\u0440\u043e\u0431\u0430\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 130, 9, 18 \u2013 10, 20: CSEL 44, 60-63)<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u044f \u0433\u0430\u0434\u0437\u0456\u043d\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0446\u044c \u043d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c \u0434\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u044b<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043c\u044b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u0430\u0433\u043d\u0435\u043c \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430, \u0442\u0430\u0434\u044b \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0451\u043c \u043c\u0430\u043b\u0456\u0446\u0446\u0430. \u0422\u044b\u043c \u043d\u0435 \u043c\u0435\u043d\u0448 \u0443 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u044f \u0433\u0430\u0434\u0437\u0456\u043d\u044b \u043c\u044b \u0430\u0434\u0440\u044b\u0432\u0430\u0435\u043c \u043d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c \u0430\u0434 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u0445 \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u045e \u0456 \u0437\u0430\u043d\u044f\u0442\u043a\u0430\u045e, \u0441\u044f\u0440\u043e\u0434 \u044f\u043a\u0456\u0445 \u043d\u0456\u0431\u044b \u0445\u0430\u043b\u0430\u0434\u0437\u0435\u0435 \u0441\u0432\u044f\u0442\u043e\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u0456 \u0430\u0434\u0434\u0430\u0435\u043c\u0441\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0435. \u0421\u043b\u043e\u0432\u0430\u043c\u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u043c\u044b \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435\u043c \u0441\u0430\u0431\u0435 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0435\u043c \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c, \u043a\u0430\u0431 \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0430\u0447\u0430\u043b\u043e \u045e\u0436\u043e \u0430\u0441\u0442\u044b\u0432\u0430\u0446\u044c, \u043d\u0435 \u0430\u0445\u0430\u043b\u0430\u0434\u0437\u0435\u043b\u0430 \u045e\u0432\u043e\u0433\u0443\u043b\u0435, \u0430 \u0437-\u0437\u0430 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430\u0433\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u043d\u0435 \u0437\u0433\u0430\u0441\u043b\u0430 \u0437\u0443\u0441\u0456\u043c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430: \u00ab\u0410\u0434\u043a\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u0432\u0430\u0448\u044b\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c\u00bb (\u0424\u043b\u043f 4, 6) \u043d\u0435 \u0432\u0430\u0440\u0442\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0442\u0430\u043a, \u043d\u0456\u0431\u044b \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u0430 \u0456\u0445 \u043a\u0430\u0437\u0430\u0446\u044c \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u0456 \u0442\u0430\u043a \u0456\u0445 \u0432\u0435\u0434\u0430\u0435, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u044f\u043d\u044b \u045e\u0437\u043d\u0456\u043a\u043b\u0456, \u0430\u043b\u0435 \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u0456\u0445 \u0411\u043e\u0433\u0443, \u0430 \u043d\u0435 \u043b\u044e\u0434\u0437\u044f\u043c \u043f\u0440\u0430\u0437 \u0448\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u044e\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044b, \u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043b\u0456\u0448\u043d\u0456\u043c \u0456 \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0434\u0430\u045e\u0436\u044d\u0439, \u043a\u0430\u043b\u0456 \u043c\u044b \u043d\u0435 \u0437\u0430\u043d\u044f\u0442\u044b\u044f, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043a\u0430\u043b\u0456 \u043d\u0430\u043c \u043d\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u0435 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0456\u043d\u0448\u044b\u0445 \u0434\u0440\u043e\u0431\u043d\u044b\u0445 \u0456 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u043d\u043d\u044f\u045e, \u0431\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u0430\u0434\u044b, \u2013 \u044f\u043a \u044f \u045e\u0436\u043e \u0441\u043a\u0430\u0437\u0430\u045e, \u2013 \u0442\u0440\u044d\u0431\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c. \u0414\u043e\u045e\u0433\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u2013 \u044f\u043a \u0434\u0443\u043c\u0430\u044e\u0446\u044c \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f, \u2013 \u0448\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u043d\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b. \u0428\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u0435 \u0456 \u0434\u043e\u045e\u0433\u0430\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u043d\u0435 \u0430\u0434\u043d\u043e \u0456 \u0442\u043e\u0435 \u0436. \u0414\u044b \u0456 \u043f\u0440\u0430 \u041f\u0430\u043d\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430, \u0448\u0442\u043e \u0401\u043d \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u0456\u045e \u043d\u043e\u0447 \u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0434\u043e\u045e\u0433\u0430. \u0420\u043e\u0431\u044f\u0447\u044b \u0442\u0430\u043a, \u0448\u0442\u043e \u0436 \u0456\u043d\u0448\u0430\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0434\u043b\u044f \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0434\u0430\u045e \u043d\u0430\u043c \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u045e \u0447\u0430\u0441\u0435, \u0430 \u045e \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u0439\u0446\u043e\u043c \u0432\u044b\u0441\u043b\u0443\u0445\u043e\u045e\u0432\u0430\u0435 \u043c\u0430\u043b\u0456\u0442\u0432\u044b?<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u041a\u0430\u0436\u0443\u0446\u044c, \u0448\u0442\u043e \u0431\u0440\u0430\u0442\u044b \u045e \u0415\u0433\u0456\u043f\u0446\u0435 \u0447\u0430\u0441\u0442\u0430 \u0447\u044b\u0442\u0430\u044e\u0446\u044c \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u0430\u043b\u0435 \u0432\u0435\u043b\u044c\u043c\u0456 \u043a\u0430\u0440\u043e\u0442\u043a\u0456\u044f \u0456 \u044f\u043a \u0431\u044b \u0441\u043f\u044f\u0448\u0430\u044e\u0447\u044b\u0441\u044f, \u043a\u0430\u0431 \u043d\u0430\u043b\u0435\u0436\u043d\u0430\u044f \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0441\u0446\u044c, \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430\u044f \u0434\u043b\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u0437 \u0446\u044f\u0433\u0430\u043c \u0447\u0430\u0441\u0443 \u043d\u0435 \u0430\u0441\u043b\u0430\u0431\u043b\u0430 \u0456 \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u0437\u043d\u0456\u043a\u043b\u0430. \u0422\u0430\u043a \u044f\u043d\u044b \u0432\u0443\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u0446\u044c \u0434\u0430 \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 \u044f\u0435 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u045e\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0434\u0430\u045e\u0436\u044d\u0439, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u0430\u043f\u0442\u043e\u045e\u043d\u0430 \u043f\u0435\u0440\u0430\u0440\u044b\u0432\u0430\u0446\u044c \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u043a\u0430\u043b\u0456 \u0440\u043e\u0437\u0443\u043c \u044f\u0448\u0447\u044d \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u045e\u0432\u0430\u0433\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u0430 \u0448\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u044f, \u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443 \u045e \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u044b\u0445 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u0445, \u043a\u0430\u043b\u0456 \u0442\u0440\u044b\u0432\u0430\u0435 \u0448\u0447\u044b\u0440\u0430\u044f \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0441\u0446\u044c. \u041a\u0430\u0437\u0430\u0446\u044c \u0448\u043c\u0430\u0442 \u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u2013 \u0433\u044d\u0442\u0430 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0430\u0431 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u043c \u0443 \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430\u0439 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456 \u0441\u043b\u043e\u0432\u0430\u045e. \u0414\u043e\u045e\u0433\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u2013 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0441\u0442\u0443\u043a\u0430\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0437 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u0439 \u0456 \u0433\u0430\u0440\u0430\u0447\u0430\u0439 \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044e \u0441\u044d\u0440\u0446\u0430. \u0417\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0432\u044b\u0440\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u0432\u0430 \u045e\u0437\u0434\u044b\u0445\u0430\u043d\u043d\u044f\u0445, \u0447\u044b\u043c \u0443 \u0441\u043b\u043e\u0432\u0430\u0445, \u0431\u043e\u043b\u044c\u0448 \u0443 \u0441\u043b\u044f\u0437\u0430\u0445, \u0447\u044b\u043c \u0443 \u043f\u0440\u0430\u043c\u043e\u0432\u0430\u0445. \u0411\u043e\u0433 \u043a\u043b\u0430\u0434\u0437\u0435 \u043d\u0430\u0448\u044b\u044f \u0441\u043b\u0451\u0437\u044b \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c (\u043f\u0430\u0440. \u041f\u0441 56 [55], 9), \u0430 \u043d\u0430\u0448\u044b\u044f \u045e\u0437\u0434\u044b\u0445\u0430\u043d\u043d\u0456 \u043d\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u0430\u0434 \u0442\u0430\u0433\u043e (\u043f\u0430\u0440. \u041f\u0441 38 [37], 10), \u0445\u0442\u043e \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0441\u043b\u043e\u0432\u0430\u043c \u0456 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 88 (87), 2-3\u0430; \u0406\u0441 26, 8b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u043d\u0435, \u0411\u043e\u0436\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043c\u0430\u0439\u0433\u043e, \u0443\u0434\u0437\u0435\u043d\u044c \u0456 \u045e\u043d\u0430\u0447\u044b \u044f \u0426\u044f\u0431\u0435 \u043a\u043b\u0456\u043a\u0430\u045e. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u043c\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0434\u043e\u0439\u0434\u0437\u0435 \u0434\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0430\u0448\u0430 \u0434\u0443\u0448\u0430 \u0436\u0430\u0434\u0430\u0435 \u0456\u043c\u0435\u043d\u0456 \u0422\u0432\u0430\u0439\u0433\u043e \u0456 \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0443 \u043f\u0440\u0430 \u0426\u044f\u0431\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041d\u044f\u0445\u0430\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"293","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u041f\u0440\u043e\u0431\u0430\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 130, 11, 21 \u2013 12, 22: CSEL 44, 63-64)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u041f\u0430\u043d\u0441\u043a\u0443\u044e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043b\u043e\u0432\u044b \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u043d\u0430\u043c \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b, \u043a\u0430\u0431 \u043d\u0430\u0433\u0430\u0434\u0430\u0446\u044c \u0441\u0430\u0431\u0435 \u0456 \u045e\u0441\u0432\u044f\u0434\u043e\u043c\u0456\u0446\u044c, \u0430\u0431 \u0447\u044b\u043c \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0441\u0456\u0446\u044c. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0434\u0443\u043c\u0430\u0446\u044c, \u0448\u0442\u043e \u043c\u044b \u0456\u043c\u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u043c \u041f\u0430\u043d\u0430 \u0446\u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u0435\u043c \u042f\u0433\u043e \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u043d\u0430\u0448\u0443\u044e \u0432\u043e\u043b\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043c\u044b \u043a\u0430\u0436\u0430\u043c: \u00ab\u0421\u0432\u044f\u0446\u0456\u0441\u044f \u0456\u043c\u044f \u0422\u0432\u0430\u0451\u00bb, \u0442\u043e \u0430\u0436\u044b\u045e\u043b\u044f\u0435\u043c \u0443 \u0441\u0430\u0431\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u043a\u0430\u0431 \u0456\u043c\u044f \u0411\u043e\u0433\u0430, \u044f\u043a\u043e\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u0432\u044f\u0442\u043e\u0435, \u043f\u0440\u044b\u0437\u043d\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0441\u0432\u044f\u0442\u044b\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043a\u0430\u0431 \u044f\u043d\u044b \u044f\u0433\u043e \u043d\u0435 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u043b\u0456. \u0411\u043e \u0433\u044d\u0442\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u043d\u0435 \u0411\u043e\u0433\u0443, \u0430\u043b\u0435 \u043b\u044e\u0434\u0437\u044f\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043c\u044b \u043a\u0430\u0436\u0430\u043c: \u00ab\u041f\u0440\u044b\u0439\u0434\u0437\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0422\u0432\u0430\u0451\u00bb, \u044f\u043a\u043e\u0435 \u2013 \u0445\u043e\u0447\u0430\u043c \u043c\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0446\u0456 \u043d\u0435 \u2013 \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u0442\u043e \u0430\u0431\u0443\u0434\u0436\u0430\u0435\u043c \u0443 \u0441\u0430\u0431\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u043a\u0430\u0431 \u044f\u043d\u043e \u043f\u0440\u044b\u0439\u0448\u043b\u043e \u0434\u0430 \u043d\u0430\u0441 \u0456 \u043a\u0430\u0431 \u043c\u044b \u0431\u044b\u043b\u0456 \u0433\u043e\u0434\u043d\u044b\u044f \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0456\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u043c: \u00ab\u0411\u0443\u0434\u0437\u044c \u0432\u043e\u043b\u044f \u0422\u0432\u0430\u044f \u044f\u043a \u0443 \u043d\u0435\u0431\u0435, \u0442\u0430\u043a \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456\u00bb, \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c \u0411\u043e\u0433\u0430 \u0430\u0431 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u043c\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u042f\u0433\u043e \u0432\u043e\u043b\u044e \u0442\u0430\u043a, \u044f\u043a \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u044f\u0435 \u0430\u043d\u0451\u043b\u044b \u045e \u043d\u0435\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u043c: \u00ab\u0425\u043b\u0435\u0431\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430\u0433\u0430 \u0434\u0430\u0439 \u043d\u0430\u043c \u0441\u0451\u043d\u043d\u044f\u00bb, \u0442\u043e \u043f\u0440\u0430\u0437 \u0441\u043b\u043e\u0432\u0430 \u00ab\u0441\u0451\u043d\u043d\u044f\u00bb \u043c\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u043c \u00ab\u0446\u044f\u043f\u0435\u0440\u00bb \u0456 \u043f\u0440\u043e\u0441\u0456\u043c \u0434\u043b\u044f \u044f\u0433\u043e \u0430\u0431 \u0443\u0441\u0456\u043c, \u0448\u0442\u043e \u043d\u0430\u043c \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430, \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0447\u044b \u043d\u0430\u0439\u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0443\u044e \u0440\u044d\u0447, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0445\u043b\u0435\u0431, \u0430\u0431\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0431 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0456, \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0446\u0435 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445, \u044f\u043a\u0456 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b \u045e \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0448\u0447\u0430\u0441\u0446\u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u044f\u043c\u043d\u043e\u0433\u0430, \u0430\u043b\u0435 \u0456 \u0432\u0435\u0447\u043d\u0430\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u043c: \u00ab\u0410\u0434\u043f\u0443\u0441\u0446\u0456 \u043d\u0430\u043c \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u043d\u0430\u0448\u044b\u044f, \u044f\u043a \u0456 \u043c\u044b \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0435\u043c \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b\u043c \u043d\u0430\u0448\u044b\u043c\u00bb, \u0442\u043e \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435\u043c \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435, \u0430\u0431 \u0447\u044b\u043c \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0456 \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0431\u0456\u0446\u044c, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u0437\u0430\u0441\u043b\u0443\u0433\u0443, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u043d\u044b\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u043c: \u00ab\u0406 \u043d\u0435 \u045e\u0432\u043e\u0434\u0437\u044c \u043d\u0430\u0441 \u0443 \u0441\u043f\u0430\u043a\u0443\u0441\u0443\u00bb, \u0442\u043e \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435\u043c \u0441\u044f\u0431\u0435 \u0434\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u043a\u0430\u0431 \u043c\u044b, \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u044f \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456, \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u043b\u0456\u0441\u044f \u0441\u043f\u0430\u043a\u0443\u0441\u0435, \u0456\u0434\u0443\u0447\u044b \u0437\u0430 \u043f\u0430\u043c\u044b\u043b\u043a\u0430\u043c\u0456 \u0430\u0431\u043e \u0437\u043d\u044f\u0432\u0435\u0440\u044b\u045e\u0448\u044b\u0441\u044f \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u043c: \u00ab\u0410\u043b\u0435 \u0437\u0431\u0430\u045e \u043d\u0430\u0441 \u0430\u0434 \u0437\u043b\u043e\u0433\u0430\u00bb, \u0442\u043e \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435\u043c \u0441\u0430\u0431\u0435, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u043c\u0430\u0435\u043c \u044f\u0448\u0447\u044d \u0442\u0430\u0433\u043e \u0434\u0430\u0431\u0440\u0430, \u044f\u043a\u043e\u0435 \u0431 \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0430 \u043d\u0430\u0441 \u0430\u0434 \u0443\u0441\u0456\u0445 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u045e. \u0413\u044d\u0442\u0430\u044f \u0430\u043f\u043e\u0448\u043d\u044f\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u044b\u0440\u043e\u043a\u0430\u044f, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d, \u044f\u043a\u043e\u0435 \u0431 \u043d\u0456 \u043c\u0435\u045e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435, \u043c\u043e\u0436\u0430 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0443 \u0451\u0439 \u0441\u0432\u043e\u0439 \u0441\u0443\u043c, \u043c\u043e\u0436\u0430 \u043f\u043b\u0430\u043a\u0430\u0446\u044c \u044f\u0435 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u043f\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0451\u0439 \u0456 \u044f\u0435 \u0437\u0430\u043a\u0430\u043d\u0447\u0432\u0430\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u043d\u0430\u0433\u0430\u0434\u0430\u0446\u044c \u043d\u0430\u043c \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u044f\u043d\u044b \u0432\u044b\u044f\u045e\u043b\u044f\u044e\u0446\u044c. \u0411\u043e \u045e\u0441\u0435 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u043c\u044b \u0432\u044b\u043c\u0430\u045e\u043b\u044f\u0435\u043c, \u0446\u0456 \u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435\u043c \u043c\u0430\u043b\u0456\u0442\u043e\u045e\u043d\u0430\u0433\u0430 \u043f\u0430\u0447\u0443\u0446\u0446\u044f, \u043a\u0430\u0431 \u044f\u043d\u043e \u0431\u044b\u043b\u043e \u0431\u043e\u043b\u044c\u0448 \u0436\u044b\u0432\u044b\u043c, \u0446\u0456 \u043f\u0430\u0437\u043d\u0435\u0439, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e\u0447\u044b \u0434\u0430 \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u044f\u043d\u043e \u0431\u044b\u043b\u043e \u0431\u043e\u043b\u044c\u0448 \u043f\u043e\u045e\u043d\u044b\u043c, \u043d\u0456\u0447\u043e\u0433\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u043d\u0435 \u0432\u044b\u044f\u045e\u043b\u044f\u044e\u0446\u044c, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u0430 \u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u041f\u0430\u043d\u0441\u043a\u0430\u0439, \u043a\u0430\u043b\u0456 \u043c\u044b \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u043d\u0430\u043b\u0435\u0436\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0456 \u045e\u0432\u0430\u0436\u043b\u0456\u0432\u0430. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0433\u0430 \u0437 \u0433\u044d\u0442\u0430\u0439 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439, \u0442\u043e \u044f\u0433\u043e \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u0445\u043e\u0446\u044c \u0433\u044d\u0442\u0430 \u0456 \u0434\u0430\u043f\u0443\u0448\u0447\u0430\u043b\u044c\u043d\u0430, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439. \u0406 \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0446\u0456 \u044f\u043d\u0430 \u0434\u0430\u043f\u0443\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u044f, \u0431\u043e \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. 2 \u041c\u0430\u043a 1, 5. 3\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u043f\u0430\u0447\u0443\u0435 \u043d\u0430\u0448\u044b\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0456 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430 \u043d\u0430\u0441 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u0411\u043e\u0433 \u0432\u0430\u0448 \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435 \u0432\u0430\u0441 \u0443 \u043b\u0456\u0445\u0456 \u0447\u0430\u0441.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c \u0443\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u0431 \u0432\u044b \u0448\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u042f\u0433\u043e \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u042f\u0433\u043e \u0432\u043e\u043b\u044e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041d\u044f\u0445\u0430\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"294","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u041f\u0440\u043e\u0431\u0430\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 130, 12, 22 \u2013 13, 24: CSEL 44, 65-68)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u041f\u0430\u043d\u0441\u043a\u0430\u0439<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u043e\u0439, \u0445\u0442\u043e \u043a\u0430\u0436\u0430: \u00ab\u042f\u043a \u043f\u0440\u0430\u0437 \u043d\u0430\u0441 \u0422\u044b \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0456\u043c \u0441\u0432\u0430\u044e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c, \u0442\u0430\u043a \u043f\u0440\u0430\u0437 \u0456\u0445 \u043f\u0430\u043a\u0430\u0436\u044b \u043d\u0430\u043c \u0441\u0432\u0430\u044e \u0432\u0435\u043b\u0456\u0447\u00bb (\u0421\u0456\u0440 36, 3), \u0456: \u00ab\u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u0432\u0435\u0440\u0430\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u0422\u0432\u0430\u0456\u043c\u00bb (\u0421\u0456\u0440 36, 15), \u0446\u0456 \u0436 \u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u0421\u0432\u044f\u0446\u0456\u0441\u044f \u0456\u043c\u044f \u0422\u0432\u0430\u0451\u00bb?<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0425\u0442\u043e \u043a\u0430\u0436\u0430: \u00ab\u0411\u043e\u0436\u0430, \u0430\u0434\u043d\u0430\u0432\u0456 \u043d\u0430\u0441, \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0437\u0437\u044f\u0435 \u0422\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u2013 \u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u00bb (\u041f\u0441 78 [79], 4), \u0446\u0456 \u0436 \u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u041f\u0440\u044b\u0439\u0434\u0437\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0422\u0432\u0430\u0451\u00bb?<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0425\u0442\u043e \u043a\u0430\u0436\u0430: \u00ab\u0423\u043c\u0430\u0446\u0443\u0439 \u043c\u0430\u0435 \u043a\u0440\u043e\u043a\u0456 \u0422\u0432\u0430\u0456\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0430\u043d\u0443\u0435 \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e \u043d\u0456\u044f\u043a\u0430\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435\u00bb (\u041f\u0441 119 [118], 133), \u0446\u0456 \u0436 \u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u0411\u0443\u0434\u0437\u044c \u0432\u043e\u043b\u044f \u0422\u0432\u0430\u044f \u044f\u043a \u0443 \u043d\u0435\u0431\u0435, \u0442\u0430\u043a \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456\u00bb?<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0425\u0442\u043e \u043a\u0430\u0436\u0430: \u00ab\u041d\u0435 \u0434\u0430\u0432\u0430\u0439 \u043c\u043d\u0435 \u043d\u0456 \u0431\u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u043d\u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u044f\u00bb (\u041f\u0440\u044b\u043f 30, 8), \u0446\u0456 \u0436 \u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u0425\u043b\u0435\u0431\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430\u0433\u0430 \u0434\u0430\u0439 \u043d\u0430\u043c \u0441\u0451\u043d\u043d\u044f\u00bb?<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0425\u0442\u043e \u043a\u0430\u0436\u0430: \u00ab\u0423\u0441\u043f\u043e\u043c\u043d\u0456, \u041f\u0430\u043d\u0435, \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u045e\u0441\u0435 \u044f\u0433\u043e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456\u00bb (\u041f\u0441 132 [131], 1) \u0430\u0431\u043e: \u00ab\u041f\u0430\u043d\u0435, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430, \u043a\u0430\u043b\u0456 \u044f \u0433\u044d\u0442\u0430 \u0437\u0440\u0430\u0431\u0456\u045e, \u043a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u043d\u0430 \u043c\u0430\u0456\u0445 \u0434\u0430\u043b\u043e\u043d\u044f\u0445, \u043a\u0430\u043b\u0456 \u044f \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u045e \u0437\u043b\u043e\u043c \u043c\u0430\u0456\u043c \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u00bb (\u043f\u0430\u0440. \u041f\u0441 7, 1-4), \u0446\u0456 \u0436 \u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u0410\u0434\u043f\u0443\u0441\u0446\u0456 \u043d\u0430\u043c \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u043d\u0430\u0448\u044b, \u044f\u043a \u0456 \u043c\u044b \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0435\u043c \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b\u043c \u043d\u0430\u0448\u044b\u043c\u00bb?<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0425\u0442\u043e \u043a\u0430\u0436\u0430: \u00ab\u0410\u0434 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u043c\u0430\u0456\u0445 \u0432\u044b\u0437\u0432\u0430\u043b\u0456 \u043c\u044f\u043d\u0435, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430, \u0430\u0431\u0430\u0440\u0430\u043d\u0456 \u0430\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u045e\u0441\u0442\u0430\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435\u00bb (\u041f\u0441 59 [58], 2), \u0446\u0456 \u0436 \u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u0417\u0431\u0430\u045e \u043d\u0430\u0441 \u0430\u0434 \u0437\u043b\u043e\u0433\u0430\u00bb?<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u043a\u0430\u043b\u0456 \u0431 \u0442\u044b \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0443\u0441\u0435 \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u0448\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u045e \u0421\u0432\u044f\u0442\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0456, \u0434\u0443\u043c\u0430\u044e, \u0448\u0442\u043e \u0442\u044b \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0431\u044b \u043d\u0456\u0447\u043e\u0433\u0430, \u0448\u0442\u043e \u0431 \u043d\u0435 \u0437\u043c\u044f\u0448\u0447\u0430\u043b\u0430\u0441\u044f \u0431 \u0456 \u043f\u0440\u0430 \u0448\u0442\u043e \u043d\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0431 \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u041f\u0430\u043d\u0441\u043a\u0430\u0439. \u0422\u0430\u043c\u0443 \u043c\u043e\u0436\u043d\u0430 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u043f\u0430\u0434\u0447\u0430\u0441 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u043f\u0440\u043e\u0441\u044f\u0447\u044b \u0430\u0431 \u0442\u044b\u0445 \u0441\u0430\u043c\u044b\u0445 \u0434\u0430\u0440\u0430\u0445, \u0430\u043b\u0435 \u043d\u0435\u043b\u044c\u0433\u0430 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0430\u0431 \u0456\u043d\u0448\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0413\u044d\u0442\u044b\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0437\u0430 \u043d\u0430\u0441 \u0441\u0430\u043c\u0456\u0445, \u0430 \u043d\u0430\u0432\u0430\u0442 \u0431\u0435\u0437 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u044f, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430 \u0432\u043e\u0440\u0430\u0433\u0430\u045e, \u0431\u043e \u045e \u0441\u044d\u0440\u0446\u044b \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u043e\u043b\u0456\u0446\u0446\u0430, \u043c\u043e\u0436\u0430 \u0437\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u0430\u0431\u043e \u043f\u0435\u0440\u0430\u0432\u0430\u0436\u0430\u0446\u044c \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0442\u043e\u0439 \u0446\u0456 \u0456\u043d\u0448\u0430\u0439 \u0430\u0441\u043e\u0431\u044b \u0442\u043e \u0430\u0434\u043d\u043e, \u0442\u043e \u0434\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0451, \u0443 \u0437\u0430\u043b\u0435\u0436\u043d\u0430\u0441\u0446\u0456 \u0430\u0434 \u0431\u043e\u043b\u044c\u0448 \u0446\u0456 \u043c\u0435\u043d\u0448 \u0446\u0435\u0441\u043d\u0430\u0439 \u0441\u0443\u0432\u044f\u0437\u0456 \u0440\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u0446\u0456 \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0413\u044d\u0442\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0442\u044b \u045e\u0436\u043e \u0432\u0435\u0434\u0430\u0435\u0448, \u044f \u0434\u0443\u043c\u0430\u044e, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0442\u043e\u0435, \u044f\u043a \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0430\u0431 \u0447\u044b\u043c \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043c\u0430\u043b\u0456\u0446\u0446\u0430: \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u044f \u043f\u0430\u0432\u0443\u0447\u0430\u044e, \u0430\u043b\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0432\u0443\u0447\u044b\u0446\u044c \u041f\u0430\u043d, \u044f\u043a\u0456 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0440\u044d\u0431\u0430 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u045e \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430. \u0423 \u0447\u044b\u043c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u0448\u0447\u0430\u0441\u0446\u0435, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043b\u0456 \u043c\u043d\u043e\u0433\u0456\u044f \u0456 \u0448\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e. \u0410\u043b\u0435 \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u043d\u0430\u043c \u0437\u0432\u044f\u0440\u0442\u0430\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456 \u0430\u045e\u0442\u0430\u0440\u0430\u045e \u0456 \u0434\u0430 \u0442\u0430\u043a\u043e\u0439 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456 \u043f\u043e\u0433\u043b\u044f\u0434\u0430\u045e? \u0421\u0446\u0456\u0441\u043b\u0430 \u0456 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043a\u0430\u0436\u0430 \u043d\u0430\u043c \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435: \u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u043d\u0430\u0440\u043e\u0434, \u0411\u043e\u0433\u0430\u043c \u044f\u043a\u043e\u0433\u0430 \u0451\u0441\u0446\u044c \u041f\u0430\u043d\u00bb (\u041f\u0441 144 [143], 15). \u041a\u0430\u0431 \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u0436\u044b\u0446\u044c \u0437 \u0406\u043c \u043d\u0430\u0432\u0435\u043a\u0456, \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u0448\u0442\u043e \u00ab\u043c\u044d\u0442\u0430 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u2013 \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u043e\u045e \u0437 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430, \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0432\u0435\u0440\u044b\u00bb (\u043f\u0430\u0440. 1 \u0426\u0456\u043c 1, 5).<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0421\u044f\u0440\u043e\u0434 \u0433\u044d\u0442\u044b\u0445 \u0442\u0440\u043e\u0445 \u0446\u043d\u043e\u0442\u0430\u045e \u043f\u0430\u0434 \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435\u043c \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044e. \u0410 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u043e\u043b\u0456\u0446\u0446\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c, \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u0456 \u0436\u0430\u0434\u0430\u0435, \u0432\u0435\u0440\u0430, \u043d\u0430\u0434\u0437\u0435\u044f \u0456 \u043b\u044e\u0431\u043e\u045e \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u0411\u043e\u0433\u0430, \u0430 \u0451\u043d \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u041f\u0430\u043d\u0441\u043a\u0430\u0439 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435, \u0430\u0431 \u0447\u044b\u043c \u0442\u0440\u044d\u0431\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 102 (101), 2. \u043f\u0430\u0440.18; 130 (129), 2b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u043d\u0435, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043c\u0430\u044e \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u043d\u044f\u0445\u0430\u0439 \u0434\u043e\u0439\u0434\u0437\u0435 \u0434\u0430 \u0426\u044f\u0431\u0435 \u043c\u043e\u0439 \u043a\u0440\u044b\u043a, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u0422\u044b, \u0411\u043e\u0436\u0430, \u043d\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u0435\u0448 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0431\u0435\u0437\u0434\u0430\u043f\u0430\u043c\u043e\u0436\u043d\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u0422\u0432\u0430\u0435 \u0432\u0443\u0448\u044b \u043f\u0430\u0447\u0443\u044e\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u043c\u0430\u0456\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u045e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u0422\u044b, \u0411\u043e\u0436\u0430<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"295","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u041f\u0440\u043e\u0431\u0430\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 130, 14, 25-26: CSEL 44, 68-71)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u0430\u0431 \u0447\u044b\u043c \u043c\u0430\u043b\u0456\u0446\u0446\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u043e\u0436\u0430 \u0445\u043e\u0447\u0430\u0448 \u044f\u0448\u0447\u044d \u0441\u043f\u044b\u0442\u0430\u0446\u0446\u0430, \u0447\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u0430\u0431 \u0447\u044b\u043c \u0442\u0440\u044d\u0431\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430\u00bb (\u0420\u044b\u043c 8, 26). \u041d\u0430\u043f\u044d\u045e\u043d\u0430 \u043d\u0435\u043b\u044c\u0433\u0430 \u0434\u0430\u043f\u0443\u0441\u043a\u0430\u0446\u044c, \u0448\u0442\u043e \u0451\u043d \u0441\u0430\u043c \u0430\u0431\u043e \u0442\u044b\u044f, \u0434\u0430 \u043a\u0430\u0433\u043e \u0451\u043d \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e, \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u041f\u0430\u043d\u0441\u043a\u0430\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0443\u043a\u0430\u0437\u0432\u0430\u0435, \u0448\u0442\u043e \u0451\u043d \u0441\u0430\u043c \u043d\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b \u0430\u0434 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u044f, \u0445\u043e\u0446\u044c \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u045e\u043c\u0435\u045e \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u044f\u043a \u0442\u0440\u044d\u0431\u0430. \u041a\u0430\u0431 \u0451\u043d \u043d\u0435 \u0437\u0430\u0433\u0430\u043d\u0430\u0440\u044b\u045e\u0441\u044f \u0437-\u0437\u0430 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0430\u0431\u2019\u044f\u045e\u043b\u0435\u043d\u043d\u044f\u045e, \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u044f\u043c\u0443 \u0431\u044b\u043b\u043e \u0434\u0436\u0430\u043b\u0430 \u0434\u043b\u044f \u0446\u0435\u043b\u0430, \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456\u043a \u0441\u0430\u0442\u0430\u043d\u044b, \u044f\u043a\u0456 \u043c\u0443\u0447\u044b\u045e \u044f\u0433\u043e. \u0422\u0430\u0434\u044b \u0451\u043d \u0442\u0440\u043e\u0439\u0447\u044b \u043f\u0440\u0430\u0441\u0456\u045e \u041f\u0430\u043d\u0430 \u0430\u0434\u0434\u0430\u043b\u0456\u0446\u044c \u0430\u0434 \u044f\u0433\u043e \u0433\u044d\u0442\u0430\u0435 \u043c\u0443\u0447\u044d\u043d\u043d\u0435, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u043d\u0430\u043f\u044d\u045e\u043d\u0430, \u0430\u0431 \u0447\u044b\u043c \u0442\u0440\u044d\u0431\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430. \u0423\u0440\u044d\u0448\u0446\u0435 \u043f\u0430\u0447\u0443\u045e \u0430\u0434\u043a\u0430\u0437 \u0411\u043e\u0433\u0430, \u0447\u0430\u043c\u0443 \u043d\u0435 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0442\u043e\u0435, \u0430\u0431 \u0447\u044b\u043c \u043f\u0440\u0430\u0441\u0456\u045e, \u0456 \u0447\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e, \u043a\u0430\u0431 \u044f\u043d\u043e \u043d\u0435 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f: \u00ab\u0425\u043e\u043f\u0456\u0446\u044c \u0442\u0430\u0431\u0435 \u041c\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456, \u0431\u043e \u043c\u043e\u0446 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456\u00bb (2 \u041a\u0430\u0440 12, 9).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u045e \u043f\u0430\u043a\u0443\u0442\u0430\u0445, \u044f\u043a\u0456\u044f \u043c\u043e\u0433\u0443\u0446\u044c \u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0446\u044c, \u0456 \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u0446\u044c, \u043c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u0430\u0431 \u0447\u044b\u043c \u0442\u0440\u044d\u0431\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430. \u0410\u043b\u0435 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0430\u043b\u044e\u0447\u044b\u044f, \u0446\u044f\u0436\u043a\u0456\u044f, \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u0430\u0446\u044c \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u044f\u043c, \u0442\u0430\u043c\u0443 \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0436\u0430\u0434\u0430\u043d\u043d\u044f, \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c \u0430\u0434\u0434\u0430\u043b\u0456\u0446\u044c \u0456\u0445 \u0430\u0434 \u043d\u0430\u0441. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0434\u0430\u0432\u044f\u0440\u0430\u0446\u044c \u043d\u0430\u0448\u0430\u043c\u0443 \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443, \u0431\u043e \u043a\u0430\u043b\u0456 \u0401\u043d \u043d\u0435 \u0430\u0434\u0434\u0430\u043b\u044f\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e, \u0442\u043e \u0433\u044d\u0442\u0430 \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0401\u043d \u0437\u0430\u0431\u044b\u045e \u043f\u0440\u0430 \u043d\u0430\u0441. \u041a\u0430\u043b\u0456 \u043c\u044b \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0437\u043d\u043e\u0441\u0456\u043c \u0437\u043b\u043e, \u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u043c\u0441\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0431\u043e\u043b\u044c\u0448\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b. \u0411\u043e \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u00ab\u043c\u043e\u0446 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430\u0435 \u0436 \u0431\u044b\u043b\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0433\u0430\u043d\u0430\u0440\u044b\u045e\u0441\u044f, \u043a\u0430\u043b\u0456 \u0431\u044b\u045e \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u043d\u044b. \u041c\u0430\u0433\u0447\u044b\u043c\u0430, \u0451\u043d \u043f\u0440\u0430\u0441\u0456\u045e \u043d\u0435\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0430\u0431 \u0442\u044b\u043c, \u0448\u0442\u043e \u043b\u0435\u043f\u0448 \u0431\u044b\u043b\u043e \u0431 \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c. \u041a\u0430\u0431 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u0437\u043d\u044f\u0432\u0435\u0440\u0432\u0430\u045e\u0441\u044f \u0456 \u043d\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u045e\u0441\u044f \u045e \u0411\u043e\u0436\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u044b\u045e \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u043d\u044b. \u041c\u0430\u0433\u0447\u044b\u043c\u0430 \u043f\u0440\u0430\u0441\u0456\u045e \u0430\u0431 \u0442\u044b\u043c, \u0448\u0442\u043e \u043c\u0430\u0433\u043b\u043e \u0431 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u044f\u0433\u043e \u0434\u0430 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0431\u0430\u043b\u044e\u0447\u0430\u0433\u0430 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f, \u0446\u0456, \u0430\u0441\u043b\u0430\u0431\u043b\u044f\u044e\u0447\u044b \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442\u0430\u043c, \u043f\u0440\u044b\u0432\u044f\u043b\u043e \u0431 \u0434\u0430 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430\u0433\u0430 \u045e\u043f\u0430\u0434\u043a\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0437\u0434\u0430\u0440\u044b\u0446\u0446\u0430 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0430\u0434\u0432\u0430\u0440\u043e\u0442\u043d\u0430\u0435 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0430\u0431 \u0447\u044b\u043c \u043c\u044b \u043f\u0440\u0430\u0441\u0456\u043b\u0456, \u0442\u0430\u0434\u044b \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0437\u043d\u043e\u0441\u044f\u0447\u044b \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0433\u0443 \u0437\u0430 \u045e\u0441\u0451, \u043c\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430, \u2013 \u043d\u0430\u0432\u0430\u0442 \u0443 \u0441\u0430\u043c\u0430\u0439 \u043c\u0430\u043b\u043e\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456, \u2013 \u0448\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c \u0437\u0430 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0436\u0430\u0434\u0430\u0435\u043c \u043c\u044b \u0441\u0430\u043c\u0456, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0445\u043e\u0447\u0430 \u0411\u043e\u0433. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a\u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0434\u0430\u045e \u043d\u0430\u043c \u0411\u043e\u0441\u043a\u0456 \u041f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a, \u043a\u0430\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041e\u0439\u0447\u0430 \u041c\u043e\u0439, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043d\u044f\u0445\u0430\u0439 \u0430\u0431\u043c\u0456\u043d\u0435 \u0433\u044d\u0442\u044b \u043a\u0435\u043b\u0456\u0445 \u041c\u044f\u043d\u0435\u00bb. \u0410\u0434\u043d\u0430\u043a \u0443 \u0445\u0443\u0442\u043a\u0456\u043c \u0447\u0430\u0441\u0435, \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u0432\u043e\u043b\u044e, \u043f\u0440\u044b\u043d\u044f\u0442\u0443\u044e \u0432\u0430 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456, \u0434\u0430\u0434\u0430\u0435: \u00ab\u0410\u0434\u043d\u0430\u043a, \u043d\u0435 \u044f\u043a \u042f \u0445\u0430\u0447\u0443, \u0430\u043b\u0435 \u044f\u043a \u0422\u044b\u00bb (\u041c\u0446 26, 39). \u0422\u0430\u043c\u0443 \u0441\u043b\u0443\u0448\u043d\u0430, \u0448\u0442\u043e \u00ab\u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u043c\u043d\u043e\u0433\u0456\u044f \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c\u0456\u00bb (\u0420\u044b\u043c 5, 19).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0446 7, 7\u0430. 8; \u041f\u0441 145 (144), 18\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0440\u0430\u0441\u0456\u0446\u0435, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u0430\u043c, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0440\u043e\u0441\u0456\u0446\u044c, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435; \u0456 \u0445\u0442\u043e \u0448\u0443\u043a\u0430\u0435, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c; \u0456 \u0445\u0442\u043e \u0441\u0442\u0443\u043a\u0430\u0435, \u0442\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0447\u044b\u043d\u0435\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u043b\u0456\u0437\u043a\u0456 \u041f\u0430\u043d \u0434\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u042f\u0433\u043e \u043a\u043b\u0456\u0447\u0430. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e \u043a\u043e\u0436\u043d\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"296","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u041f\u0440\u043e\u0431\u0430\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 130, 14, 27 \u2013 15, 28: CSEL 44, 71-73)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0414\u0443\u0445 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u00ab\u0430\u0434\u043d\u0430\u0433\u043e \u045e \u041f\u0430\u043d\u0430 \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u0430\u0434\u0430\u0435\u00bb (\u043f\u0430\u0440. \u041f\u0441 27 [26], 4), \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0437 \u0434\u0430\u0432\u0435\u0440\u0430\u043c \u0456 \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u044b, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u0435. \u041d\u0435 \u0431\u0430\u0456\u0446\u0446\u0430, \u0448\u0442\u043e \u044f\u043c\u0443 \u043c\u043e\u0436\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0448\u043a\u043e\u0434\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435. \u0411\u0435\u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430 \u043d\u0435\u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u043c \u0431\u0443\u0434\u0437\u0435 \u045e\u0441\u0451, \u0448\u0442\u043e \u045e\u0436\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e, \u043a\u0430\u043b\u0456 \u0451\u043d \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u044f\u043a \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c. \u0413\u044d\u0442\u044b\u043c \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0456 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u044f\u043a\u043e\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0432\u0435\u0447\u043d\u044b\u043c \u043a\u0430\u0448\u0442\u0430\u0432\u0430\u043d\u043d\u0456 \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u041f\u0430\u043d\u0430 \u045e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456 \u0456 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0441\u0446\u0456 \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u0430. \u0417 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0433\u044d\u0442\u0430\u0435 \u0430\u0434\u0437\u0456\u043d\u0430\u0435 \u0434\u0430\u0431\u0440\u043e \u043c\u044b \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u043c\u0441\u044f \u043f\u0440\u0430 \u045e\u0441\u0435 \u0456\u043d\u0448\u044b\u044f, \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u0430\u0431 \u0456\u0445. \u0425\u0442\u043e \u0456\u0445 \u0430\u0442\u0440\u044b\u043c\u0430\u0435, \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0443\u0441\u0451, \u0447\u0430\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u0456 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0442\u0430\u0434\u044b \u0430\u043d\u0456 \u0436\u0430\u0434\u0430\u0446\u044c, \u0430\u043d\u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430, \u0448\u0442\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u0431 \u0434\u0430\u0431\u0440\u043e\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f, \u0430\u0431 \u044f\u043a\u043e\u0439 \u0441\u0443\u043c\u0443\u0435\u043c \u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u0436\u044b\u0432\u0451\u043c \u0443 \u043d\u0430\u0434\u0437\u0435\u0456 \u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u043c \u044f\u0448\u0447\u044d \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u043c\u0441\u044f \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u00ab\u0443 \u0446\u0435\u043d\u0456 \u043a\u0440\u044b\u043b\u0430\u045e \u042f\u0433\u043e\u00bb. \u0423 \u0406\u043c \u2013 \u0443\u0441\u0451 \u043d\u0430\u0448\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u00ab\u043d\u0430\u0441\u044b\u0447\u0430\u0446\u0446\u0430 \u0442\u0443\u043a\u0430\u043c \u042f\u0433\u043e \u0434\u043e\u043c\u0443\u00bb \u0456 \u00ab\u043f\u0456\u0446\u044c \u0437 \u043f\u0430\u0442\u043e\u043a\u0443 \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u042f\u0433\u043e\u00bb. \u0423 \u0406\u043c \u2013 \u00ab\u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f, \u0456 \u045e \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043b\u0435 \u043c\u044b \u045e\u0431\u0430\u0447\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u00bb (\u043f\u0430\u0440. \u041f\u0441 36 [35], 8-10), \u043a\u0430\u043b\u0456 \u043d\u0430\u0448\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456, \u043f\u0430\u0441\u043b\u044f \u044f\u043a\u0456\u0445 \u043c\u044b \u045e\u0436\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0448\u0443\u043a\u0430\u0446\u044c \u0437 \u0442\u0443\u0433\u043e\u044e, \u0430\u043b\u0435 \u045e\u0441\u0451 \u0431\u0443\u0434\u0437\u0435\u043c \u043c\u0435\u0446\u044c \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u044b \u0441\u043f\u0430\u043a\u043e\u0439 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435, \u0442\u0430\u043c\u0443 \u043d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u043c\u044b \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0430\u0431 \u0456\u043c, \u043c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u0430\u0431 \u0447\u044b\u043c \u043f\u0440\u0430\u0441\u0456\u0446\u044c, \u043a\u0430\u0431 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0431\u044b\u043b\u0430 \u0442\u0430\u043a\u043e\u0439, \u044f\u043a \u0442\u0440\u044d\u0431\u0430. \u0411\u043e \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043c\u044b \u043d\u0430\u0432\u0430\u0442 \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0443\u044f\u0432\u0456\u0446\u044c \u0441\u0430\u0431\u0435, \u044f\u043a\u0456\u043c \u044f\u043d\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u0442\u0430\u0433\u043e \u043c\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c. \u0423\u0441\u0451, \u0448\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0434\u0443\u043c\u043a\u0443, \u043c\u044b \u0430\u0434\u043a\u0456\u0434\u0432\u0430\u0435\u043c, \u0430\u0434\u0433\u0430\u043d\u044f\u0435\u043c. \u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0448\u0443\u043a\u0430\u0435\u043c, \u0445\u043e\u0446\u044c \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u044f\u043a\u0456\u043c \u044f\u043d\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0456\u0441\u043d\u0443\u0435 \u045e \u043d\u0430\u0441 \u2013 \u0442\u0430\u043a \u0431\u044b \u043c\u043e\u0432\u0456\u0446\u044c \u2013 \u0432\u0443\u0447\u043e\u043d\u0430\u0435 \u043d\u0435\u0432\u0443\u0446\u0442\u0432\u0430. \u0412\u0443\u0447\u043e\u043d\u0430\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456. \u041a\u0430\u043b\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041a\u0430\u043b\u0456 \u0441\u043f\u0430\u0434\u0437\u044f\u0451\u043c\u0441\u044f \u043d\u0430 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0431\u0430\u0447\u044b\u043c, \u0442\u0430\u0434\u044b \u0447\u0430\u043a\u0430\u0435\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u00bb, \u0442\u0443\u0442 \u0436\u0430 \u0434\u0430\u0434\u0430\u045e: \u00ab\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0414\u0443\u0445 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044f\u0445 \u043d\u0430\u0448\u044b\u0445, \u0431\u043e \u043c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u0430\u0431 \u0447\u044b\u043c \u0442\u0440\u044d\u0431\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u0430\u043b\u0435 \u0441\u0430\u043c \u0414\u0443\u0445 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441 \u0441\u0442\u0430\u0433\u043d\u0430\u043d\u043d\u044f\u043c\u0456 \u043d\u0435\u0432\u044b\u043c\u043e\u045e\u043d\u044b\u043c\u0456. \u0422\u043e\u0439 \u0436\u0430, \u0445\u0442\u043e \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u0441\u044d\u0440\u0446\u044b, \u0432\u0435\u0434\u0430\u0435, \u0447\u0430\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0435 \u0414\u0443\u0445, \u0431\u043e \u0401\u043d \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u043f\u0430 \u0432\u043e\u043b\u0456 \u0411\u043e\u0436\u0430\u0439\u00bb (\u0420\u044b\u043c 8, 25-27).<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u0433\u044d\u0442\u0430\u0435 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435 \u043d\u0435\u043b\u044c\u0433\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0443 \u0442\u044b\u043c \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0456, \u0448\u0442\u043e \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u044f\u043a\u0456 \u045e \u0422\u0440\u043e\u0439\u0446\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u044f\u0437\u043c\u0435\u043d\u043d\u044b\u043c \u0411\u043e\u0433\u0430\u043c, \u0430 \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0421\u044b\u043d\u0430\u043c \u0430\u0434\u043d\u044b\u043c \u0411\u043e\u0433\u0430\u043c, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u044f\u043a \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0430\u043c. \u0411\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u0417\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u0441\u0432\u044f\u0442\u044b\u0445\u00bb, \u0431\u043e \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u0456\u0445 \u0434\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u044b. \u0422\u0430\u043a\u0456\u043c \u0436\u0430 \u0447\u044b\u043d\u0430\u043c \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u0412\u0430\u0441 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435 \u041f\u0430\u043d \u0411\u043e\u0433 \u0432\u0430\u0448, \u043a\u0430\u0431 \u043f\u0440\u0430\u0432\u0435\u0440\u044b\u0446\u044c, \u0446\u0456 \u0432\u044b \u043b\u044e\u0431\u0456\u0446\u0435 \u042f\u0433\u043e\u00bb (\u043f\u0430\u0440. \u0414\u0440\u0433 13, 4), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043a\u0430\u0431 \u0432\u044b \u0441\u0430\u043c\u0456 \u043f\u0430\u0437\u043d\u0430\u043b\u0456. \u0422\u0430\u043c\u0443 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u0441\u0432\u044f\u0442\u044b\u0445 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u00ab\u0441\u0442\u0430\u0433\u043d\u0430\u043d\u043d\u044f\u043c\u0456 \u043d\u0435\u0432\u044b\u043c\u043e\u045e\u043d\u044b\u043c\u0456\u00bb, \u043f\u0430\u0431\u0443\u0434\u0436\u0430\u044e\u0447\u044b \u0456\u0445 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430, \u043d\u0435\u0432\u044f\u0434\u043e\u043c\u0430\u0433\u0430 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c, \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430 \u0447\u0430\u043a\u0430\u0435\u043c. \u042f\u043a \u0436\u0430 \u0432\u044b\u0440\u0430\u0437\u0456\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0436\u0430\u0434\u0430\u0435\u043c, \u043a\u0430\u043b\u0456 \u044f\u043d\u043e \u043d\u0430\u043c \u043d\u0435\u0432\u044f\u0434\u043e\u043c\u0430? \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0431 \u044f\u043d\u043e \u0431\u044b\u043b\u043e \u0437\u0443\u0441\u0456\u043c \u043d\u0435\u0432\u044f\u0434\u043e\u043c\u044b\u043c, \u0442\u043e \u0456 \u0436\u0430\u0434\u0430\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0431\u044b\u043b\u043e \u0431 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u0430 \u043a\u0430\u043b\u0456 \u0431 \u044f\u043d\u043e \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430, \u043c\u044b \u0431 \u0443\u0436\u043e \u043d\u0435 \u0456\u043c\u043a\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u044f\u0433\u043e \u0456 \u043d\u0435 \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u0431 \u0430\u0431 \u0456\u043c \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0420\u044b\u043c 8, 26b; \u0417\u0430\u0445 12, 4\u0430. 10\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u0430\u0431 \u0447\u044b\u043c \u0442\u0440\u044d\u0431\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0430\u043b\u0435 \u0441\u0430\u043c \u0414\u0443\u0445 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441 \u0441\u0442\u0430\u0433\u043d\u0430\u043d\u043d\u044f\u043c\u0456 \u043d\u0435\u0432\u044b\u043c\u043e\u045e\u043d\u044b\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d \u043a\u0430\u0436\u0430: \u042f \u0432\u044b\u043b\u044c\u044e \u043d\u0430 \u0434\u043e\u043c \u0414\u0430\u0432\u0456\u0434\u0430 \u0456 \u043d\u0430 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430 \u0434\u0443\u0445 \u043b\u0430\u0441\u043a\u0456 \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u045e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u043b\u0435 \u0441\u0430\u043c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"297","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u0425\u0440\u044b\u0437\u0430\u043b\u043e\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 117: PL 52, 520-521)<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u043b\u043e\u0432\u0430, \u0411\u043e\u0436\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0432. \u041f\u0430\u0432\u0435\u043b \u0432\u0443\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0434\u0432\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0456 \u0434\u0430\u043b\u0456 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u043c\u0443 \u0440\u043e\u0434\u0443: \u0410\u0434\u0430\u043c \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0410\u0431\u043e\u0434\u0432\u0430 \u0440\u043e\u045e\u043d\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u043d\u044f\u0440\u043e\u045e\u043d\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u0441\u043b\u0443\u0433; \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u043f\u0430 \u0437\u043d\u0435\u0448\u043d\u044f\u043c\u0443 \u0432\u044b\u0433\u043b\u044f\u0434\u0443, \u0446\u0430\u043b\u043a\u0430\u043c \u043d\u0435\u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u043f\u0430 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u044e. \u00ab\u041f\u0435\u0440\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0410\u0434\u0430\u043c \u0441\u0442\u0430\u045e \u0436\u044b\u0432\u043e\u0439 \u0456\u0441\u0442\u043e\u0442\u0430\u0439, \u0430\u043f\u043e\u0448\u043d\u0456 \u0410\u0434\u0430\u043c \u2013 \u0436\u044b\u0432\u0430\u0442\u0432\u043e\u0440\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c\u00bb (1 \u041a\u0430\u0440 15, 45).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u044b \u043f\u0435\u0440\u0448\u044b \u0431\u044b\u045e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0430\u043f\u043e\u0448\u043d\u0456\u043c; \u0430\u0434 \u042f\u0433\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0434\u0443\u0448\u0443, \u044f\u043a\u0430\u044f \u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u0413\u044d\u0442\u044b \u0430\u043f\u043e\u0448\u043d\u0456 \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u045e \u0441\u0430\u043c \u0441\u044f\u0431\u0435. \u0401\u043d, \u043a\u0430\u0442\u043e\u0440\u044b \u045e\u0441\u0456\u043c \u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u043d\u0435 \u043c\u043e\u0433 \u0447\u0430\u043a\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u044f \u0430\u0434 \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0433\u0430. \u041f\u0435\u0440\u0448\u044b \u0431\u044b\u045e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0437 \u0441\u0430\u043c\u0430\u0439 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u0433\u043b\u0456\u043d\u044b, \u0434\u0440\u0443\u0433\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u0432\u0435\u0442 \u0437 \u043d\u0430\u0439\u0447\u044b\u0441\u0446\u0435\u0439\u0448\u0430\u0433\u0430 \u045e\u043b\u043e\u043d\u043d\u044f \u0414\u0437\u0435\u0432\u044b. \u0423 \u0442\u044b\u043c \u0437\u044f\u043c\u043b\u044f \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u043b\u0430\u0441\u044f \u045e \u0446\u0435\u043b\u0430, \u0443 \u0433\u044d\u0442\u044b\u043c \u0446\u0435\u043b\u0430 \u0431\u044b\u043b\u043e \u045e\u0437\u043d\u0435\u0441\u0435\u043d\u0430 \u0434\u0430 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u0441\u0430\u043c\u043e\u0433\u0430 \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0442\u043e \u044f\u0448\u0447\u044d? \u0414\u0440\u0443\u0433\u0456 \u0410\u0434\u0430\u043c \u0437\u043c\u044f\u0441\u0446\u0456\u045e \u0441\u0432\u043e\u0439 \u0432\u043e\u0431\u0440\u0430\u0437 \u0443 \u043f\u0435\u0440\u0448\u044b\u043c, \u043a\u0430\u043b\u0456 \u044f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u0430\u045e. \u0422\u0430\u043c\u0443 \u043f\u0440\u044b\u043d\u044f\u045e \u044f\u0433\u043e \u0446\u0435\u043b\u0430 \u0456 \u0456\u043c\u044f, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430. \u0422\u0430\u043c\u0443 \u0451\u0441\u0446\u044c \u043f\u0435\u0440\u0448\u044b \u0410\u0434\u0430\u043c \u0456 \u0430\u043f\u043e\u0448\u043d\u0456 \u0410\u0434\u0430\u043c. \u0422\u043e\u0439 \u043f\u0435\u0440\u0448\u044b \u043c\u0430\u0435 \u043f\u0430\u0447\u0430\u0442\u0430\u043a. \u0413\u044d\u0442\u044b \u0430\u043f\u043e\u0448\u043d\u0456 \u043d\u0435 \u043c\u0430\u0435 \u043a\u0430\u043d\u0446\u0430 \u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u043f\u0435\u0440\u0448\u044b\u043c, \u044f\u043a \u0441\u0430\u043c \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435: \u00ab\u042f \u2013 \u043f\u0435\u0440\u0448\u044b, \u0456 \u042f \u2013 \u0430\u043f\u043e\u0448\u043d\u0456\u00bb (\u0406\u0441 48, 12).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u042f \u2013 \u043f\u0435\u0440\u0448\u044b\u00bb, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0431\u0435\u0437 \u043f\u0430\u0447\u0430\u0442\u043a\u0443. \u00ab\u042f \u2013 \u0430\u043f\u043e\u0448\u043d\u0456\u00bb, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0431\u0435\u0437 \u043a\u0430\u043d\u0446\u0430. \u00ab\u0410\u043b\u0435 \u043d\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u043f\u0435\u0440\u0448\u0430\u0435, \u0430 \u0437\u044f\u043c\u043d\u043e\u0435, \u043f\u043e\u0442\u044b\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435\u00bb (1 \u041a\u0430\u0440 15, 46), \u2013 \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u2013 \u044f\u043a \u0432\u0435\u0434\u0430\u0435\u043c, \u2013 \u0451\u0441\u0446\u044c \u0437\u044f\u043c\u043b\u044f, \u0430 \u0437\u0430\u0442\u044b\u043c \u2013 \u043f\u043b\u043e\u0434. \u0410\u043b\u0435 \u0437\u044f\u043c\u043b\u044f \u043d\u0435 \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u0437\u0430 \u043f\u043b\u043e\u0434. \u0417\u044f\u043c\u043b\u044f \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u043f\u043e\u0442\u0443 \u0456 \u043f\u0440\u0430\u0446\u044b, \u043f\u043b\u043e\u0434 \u0434\u0430\u0435 \u0435\u0436\u0443 \u0456 \u0436\u044b\u0446\u0446\u0451. \u041f\u0440\u0430\u0440\u043e\u043a \u0441\u043b\u0443\u0448\u043d\u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0442\u0430\u043a\u0456\u043c \u043f\u043b\u043e\u0434\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0417\u044f\u043c\u043b\u044f \u043d\u0430\u0448\u0430 \u0434\u0430\u0441\u0446\u044c \u0441\u0432\u043e\u0439 \u043f\u043b\u0451\u043d\u00bb (\u041f\u0441 85 [84], 13). \u042f\u043a\u0456 \u043f\u043b\u0451\u043d? \u0422\u043e\u0439, \u043f\u0440\u0430 \u044f\u043a\u0456 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043a\u0430\u0436\u0430: \u00ab\u041d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0435 \u0430\u0434 \u0446\u044f\u0431\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u043f\u0430\u0441\u0430\u0434\u0436\u0443 \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u0442\u0432\u0430\u0456\u043c\u00bb (\u041f\u0441 132 [131], 11). \u00ab\u041f\u0435\u0440\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437 \u0437\u044f\u043c\u043b\u0456 \u0451\u0441\u0446\u044c \u043f\u044b\u043b\u0430\u043c; \u0434\u0440\u0443\u0433\u0456 \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u2013 \u0437 \u043d\u0435\u0431\u0430, \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u00bb, \u2013 \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u042f\u043a\u0456 \u0431\u044b\u045e \u0437 \u043f\u044b\u043b\u0443, \u0442\u0430\u043a\u0456\u044f \u0456 \u0442\u044b\u044f, \u0448\u0442\u043e \u0437 \u043f\u044b\u043b\u0443; \u044f\u043a\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b, \u0442\u0430\u043a\u0456\u044f \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f\u00bb (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 15, 47-48). \u0414\u044b\u043a \u044f\u043a \u0436\u0430 \u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456\u0441\u044f \u0437 \u043d\u0435\u0431\u0430, \u043c\u043e\u0433\u0443\u0446\u044c \u0441\u0442\u0430\u0446\u044c \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c\u0456, \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u045e\u0448\u044b \u0431\u044b\u0446\u044c \u0442\u044b\u043c\u0456, \u044f\u043a\u0456\u043c\u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456\u0441\u044f, \u0430\u043b\u0435 \u0431\u0443\u0434\u0443\u0447\u044b \u0442\u0430\u043a\u0456\u043c\u0456, \u044f\u043a\u0456\u043c\u0456 \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430\u0437 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435? \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0441\u0432\u0430\u0456\u043c \u0411\u043e\u0441\u043a\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0440\u043e\u0431\u0456\u0446\u044c \u043f\u043b\u043e\u0434\u043d\u044b\u043c \u0434\u0437\u044f\u0432\u043e\u0447\u0443\u044e \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u0445\u0440\u044b\u0441\u0446\u0456\u043b\u044c\u043d\u0430\u0439 \u0432\u0430\u0434\u044b. \u0422\u044b\u0445, \u043a\u0430\u0433\u043e \u0431\u0430\u0433\u043d\u0456\u0441\u0442\u0430\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u043d\u0430 \u0441\u0432\u0435\u0442 \u0434\u0437\u0435\u043b\u044f \u043c\u0430\u0440\u043d\u0430\u0433\u0430 \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043d\u043e\u0432\u0430\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u0434\u043b\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u0435 \u0434\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f, \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u043d\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f, \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043d\u0430\u043c \u0410\u043f\u043e\u0441\u0442\u0430\u043b: \u00ab\u042f\u043a \u043c\u044b \u043d\u0430\u0441\u0456\u043b\u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437 \u043f\u044b\u043b\u0443, \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u0456\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430\u00bb (1 \u041a\u0430\u0440 15, 49).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f, \u2013 \u044f\u043a \u043c\u044b \u045e\u0436\u043e \u0441\u043a\u0430\u0437\u0430\u043b\u0456, \u2013 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0456 \u045e\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u044f \u0411\u043e\u0433\u0430\u043c, \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u043d\u0430\u0441\u0456\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u043d\u0435\u0441\u043a\u0430\u0436\u043e\u043d\u0430\u0435 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f: \u043d\u0435 \u045e \u0441\u043b\u0430\u0432\u0435, \u044f\u043a\u0430\u044f \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u042f\u043c\u0443, \u0430\u043b\u0435 \u045e \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456, \u043f\u0440\u0430\u0441\u0442\u0430\u0446\u0435, \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456, \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043f\u0430\u043a\u043e\u0440\u044b, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u0437\u0433\u043e\u0434\u0437\u0435. \u0411\u043e \u0442\u0430\u043a\u0456\u043c \u0401\u043d \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u043d\u0430\u0441 \u0456 \u0442\u0430\u043a\u0456\u043c \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0437 \u043d\u0430\u043c\u0456.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0420\u044b\u043c 5, 18. 12\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f\u043a \u0443\u043f\u0430\u0434\u0430\u043a \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0440\u044b\u043d\u0451\u0441 \u0443\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u0435, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0442\u0430\u043a \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u0430\u0435 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435 \u045e\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f\u043a \u043f\u0440\u0430\u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0433\u0440\u044d\u0445 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0441\u0432\u0435\u0442 \u0456 \u043f\u0440\u0430\u0437 \u0433\u0440\u044d\u0445 \u2013 \u0441\u043c\u0435\u0440\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043a.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"301","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e\u00bb \u0441\u0432. \u041a\u043b\u0456\u043c\u0435\u043d\u0442\u0430 \u0406, \u043f\u0430\u043f\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 19, 2 \u2013 20, 12: Funk 1, 87-89)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u043e\u0433, \u044f\u043a\u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0443\u0441\u0456\u043c \u0434\u0430\u0431\u0440\u043e, \u043a\u0456\u0440\u0443\u0435 \u0441\u0432\u0435\u0442\u0430\u043c \u0443 \u0433\u0430\u0440\u043c\u043e\u043d\u0456\u0456 \u0456 \u0437\u0433\u043e\u0434\u0437\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u0410\u0439\u0446\u0430 \u0456 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443, \u0437\u0430\u0433\u043b\u044b\u0431\u0456\u043c\u0441\u044f \u043c\u043e\u0446\u043d\u0430 \u045e \u042f\u0433\u043e \u0432\u0435\u043b\u0456\u0447\u043d\u044b\u044f \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0434\u0430\u0440\u044b \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456. \u0411\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043f\u0440\u0430 \u042f\u0433\u043e \u0456 \u0432\u0430\u0447\u044b\u043c\u0430 \u0434\u0443\u0448\u044b \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u043c \u043d\u0430 \u042f\u0433\u043e \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u044c. \u0423\u0431\u0430\u0447\u044b\u043c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u044f\u0431\u0451\u0441\u044b, \u0448\u0442\u043e \u0440\u0443\u0445\u0430\u044e\u0446\u0446\u0430 \u043f\u0430 \u042f\u0433\u043e \u0437\u0430\u0433\u0430\u0434\u0437\u0435, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u042f\u043c\u0443 \u045e \u0441\u043f\u0430\u043a\u043e\u0456. \u0414\u0437\u0435\u043d\u044c \u0456 \u043d\u043e\u0447 \u0456\u0434\u0443\u0446\u044c \u0441\u0432\u0430\u0456\u043c \u0448\u043b\u044f\u0445\u0430\u043c, \u044f\u043a\u0456 \u0401\u043d \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e, \u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u044e\u0446\u044c \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u043c\u0443. \u041f\u0430 \u042f\u0433\u043e \u0437\u0430\u0433\u0430\u0434\u0437\u0435 \u0441\u043e\u043d\u0446\u0430, \u043c\u0435\u0441\u044f\u0446 \u0456 \u0445\u043e\u0440\u044b \u0437\u043e\u0440\u0430\u043a \u0433\u0430\u0440\u043c\u0430\u043d\u0456\u0447\u043d\u0430 \u0440\u0443\u0445\u0430\u044e\u0446\u0446\u0430 \u045e \u043c\u0435\u0436\u0430\u0445, \u044f\u043a\u0456\u044f \u0401\u043d \u0456\u043c \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e \u0432\u043e\u043b\u0456 \u045e\u0440\u0430\u0434\u0436\u0430\u0439\u043d\u0430\u044f \u0437\u044f\u043c\u043b\u044f \u0434\u0430\u0435 \u045e \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0447\u0430\u0441 \u0431\u0430\u0433\u0430\u0442\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u043b\u044e\u0434\u0437\u044f\u043c, \u0434\u0437\u0456\u043a\u0456\u043c \u0436\u044b\u0432\u0451\u043b\u0430\u043c \u0456 \u045e\u0441\u0456\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u043c, \u044f\u043a\u0456\u044f \u0436\u044b\u0432\u0443\u0446\u044c \u043d\u0430 \u0451\u0439, \u0431\u0435\u0437 \u0437\u0430\u043c\u0430\u0440\u0443\u0434\u0436\u0432\u0430\u043d\u043d\u044f \u0456 \u043d\u0456\u044f\u043a\u0456\u0445 \u0437\u043c\u0435\u043d\u0430\u045e \u0443 \u0442\u044b\u043c, \u0448\u0442\u043e \u0456\u043c \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u044f\u043c\u043d\u0456\u0447\u044b\u044f \u0431\u0435\u0437\u0434\u0430\u043d\u0456 \u0456 \u043d\u044f\u0437\u0432\u0435\u0434\u0430\u043d\u044b\u044f \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u044f \u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u0437\u0430\u043a\u043e\u043d\u0430\u043c. \u0411\u044f\u0437\u043c\u0435\u0440\u043d\u044b\u044f \u0432\u043e\u0434\u044b, \u0437\u0430\u043a\u0440\u044b\u0442\u044b\u044f \u043f\u0430 \u042f\u0433\u043e \u0437\u0430\u0433\u0430\u0434\u0437\u0435 \u045e \u0432\u043e\u0434\u043d\u044b\u0445 \u0441\u0445\u043e\u0432\u0456\u0448\u0447\u0430\u0445, \u043d\u0435 \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0437\u0430 \u0441\u0432\u0430\u0435 \u043c\u0435\u0436\u044b, \u0430\u043b\u0435 \u0442\u0440\u044b\u043c\u0430\u044e\u0446\u0446\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0456\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u043d\u0430. \u0411\u043e \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0414\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0434\u043e\u0439\u0434\u0437\u0435\u0448, \u043d\u0435 \u0434\u0430\u043b\u0435\u0439. \u0422\u0443\u0442 \u0437\u043b\u0430\u043c\u0430\u0435\u0448 \u0441\u0432\u0430\u0435 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u044f \u0445\u0432\u0430\u043b\u0456\u00bb (\u0401\u0432 38, 11). \u041d\u0435\u043f\u0435\u0440\u0430\u0430\u0434\u043e\u043b\u044c\u043d\u044b \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439 \u0430\u043a\u0435\u0430\u043d \u0456 \u0441\u0432\u0435\u0442, \u0448\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043f\u0430-\u0437\u0430 \u0456\u043c, \u043a\u0456\u0440\u0443\u044e\u0446\u0446\u0430 \u0442\u044b\u043c\u0456 \u0441\u0430\u043c\u044b\u043c\u0456 \u0437\u0430\u043a\u043e\u043d\u0430\u043c\u0456 \u041f\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u043e\u0440\u044b \u0433\u043e\u0434\u0430: \u0432\u044f\u0441\u043d\u0430, \u043b\u0435\u0442\u0430, \u0432\u043e\u0441\u0435\u043d\u044c, \u0437\u0456\u043c\u0430 \u0437\u043c\u044f\u043d\u044f\u044e\u0446\u0446\u0430 \u043f\u0430\u0441\u043b\u044f\u0434\u043e\u045e\u043d\u0430 \u0430\u0434\u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u0439. \u0412\u044f\u0442\u0440\u044b \u0431\u0435\u0437 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u045e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0451 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u045e \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0447\u0430\u0441. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435\u0432\u044b\u0447\u044d\u0440\u043f\u043d\u044b\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u044f \u0434\u043b\u044f \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456 \u0456 \u0437\u0434\u0430\u0440\u043e\u045e\u044f, \u0431\u0435\u0441\u043f\u0435\u0440\u0430\u043f\u044b\u043d\u043d\u0430 \u0434\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0456 \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u041d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u044b\u044f \u043c\u0430\u043b\u044b\u044f \u0437\u0432\u044f\u0440\u044b \u0436\u044b\u0432\u0443\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0443 \u0441\u043f\u0430\u043a\u043e\u0456 \u0456 \u0437\u0433\u043e\u0434\u0437\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u044f\u043b\u0456\u043a\u0456 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0456 \u041f\u0430\u043d \u0443\u0441\u044f\u0433\u043e \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f, \u043a\u0430\u0431 \u0443\u0441\u0451 \u0430\u0434\u0431\u044b\u0432\u0430\u043b\u0430\u0441\u044f \u045e \u0441\u043f\u0430\u043a\u043e\u0456 \u0456 \u0437\u0433\u043e\u0434\u0437\u0435. \u0401\u043d \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u0434\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e, \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0434\u043b\u044f \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u043c\u044b \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u043c\u0441\u044f \u0434\u0430 \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u043e\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0445\u0432\u0430\u043b\u0430 \u0456 \u0432\u0435\u043b\u0456\u0447 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u042e\u0434\u0442 9, 12; 6, 19\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0412\u0430\u043b\u0430\u0434\u0430\u0440, \u041f\u0430\u043d \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u0456, \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0432\u043e\u0434\u0430\u045e \u0456 \u041a\u0430\u0440\u043e\u043b\u044c \u0443\u0441\u044f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0422\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u041a\u0430\u0440\u043e\u043b\u044c \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u0456, \u0433\u043b\u044f\u043d\u044c \u043d\u0430 \u043d\u0430\u0448\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"302","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e\u00bb \u0441\u0432. \u041a\u043b\u0456\u043c\u0435\u043d\u0442\u0430 \u0406, \u043f\u0430\u043f\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 21, 1 \u2013 22, 5; 23, 1-2: Funk 1, 89-93)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0446\u0446\u0430 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0446\u0435\u0440\u0430\u0436\u044b\u0446\u0435\u0441\u044f, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043a\u0430\u0431 \u0442\u0430\u043a\u0456\u044f \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0411\u043e\u0436\u044b\u044f \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u043d\u0435 \u0441\u0442\u0430\u043b\u0456 \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u0435\u043c \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u0441\u0456\u0445, \u043a\u0430\u043b\u0456 \u043c\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u044b\u0446\u044c \u0433\u043e\u0434\u043d\u0430 \u0411\u043e\u0433\u0430, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0430\u0434\u0437\u0456\u043d\u0430\u0434\u0443\u0448\u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u043e\u0431\u0440\u0430\u0435 \u0456 \u0448\u043b\u044f\u0445\u0435\u0442\u043d\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c. \u0411\u043e \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u0414\u0443\u0445 \u041f\u0430\u043d\u0430 \u0451\u0441\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0448\u0442\u043e \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u045e \u0441\u044d\u0440\u0446\u0430\u00bb (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 20, 27).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0434\u0443\u043c\u0430\u0435\u043c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043b\u0456\u0437\u043a\u0456 \u0434\u0430 \u043d\u0430\u0441 \u0411\u043e\u0433 \u0456 \u044f\u043a \u043d\u0456\u044f\u043a\u0430\u044f \u0434\u0443\u043c\u043a\u0430, \u0456 \u043d\u0456\u044f\u043a\u0430\u0435 \u043d\u0430\u0448\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u0430\u0434 \u042f\u0433\u043e. \u0422\u0430\u043c\u0443 \u0441\u043b\u0443\u0448\u043d\u0430, \u043a\u0430\u043b\u0456 \u043c\u044b \u043d\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u042f\u0433\u043e \u0432\u043e\u043b\u0456. \u041b\u0435\u043f\u0448 \u043d\u0430\u043c \u0442\u0440\u0430\u043f\u0456\u0446\u044c \u0443 \u043d\u044f\u043c\u0456\u043b\u0430\u0441\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u044f\u043c\u0443\u0434\u0440\u044b\u0445 \u0456 \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u0445, \u043d\u0430\u043f\u044b\u0448\u043b\u0456\u0432\u044b\u0445 \u0456 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u044b\u0445, \u0447\u044b\u043c \u0411\u043e\u0433\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0415\u0437\u0443\u0441\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u043b\u0456\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e, \u0448\u0430\u043d\u0443\u0439\u043c\u0430 \u043d\u0430\u0448\u044b\u0445 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e, \u043f\u0430\u0432\u0430\u0436\u0430\u0439\u043c\u0430 \u0441\u0442\u0430\u0440\u044b\u0445, \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u043c\u043e\u043b\u0430\u0434\u0437\u044c, \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0447\u044b \u0456\u0445 \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0436\u0430\u0439, \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u0435\u0441\u0446\u0456 \u043d\u0430\u0448\u044b\u0445 \u0436\u0430\u043d\u0447\u044b\u043d \u0434\u0430 \u0434\u0430\u0431\u0440\u0430. \u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u043f\u043e\u045e\u043d\u044b\u044f \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u0456 \u0437\u0432\u044b\u0447\u0430\u0456 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0443\u044e \u0456 \u0448\u0447\u044b\u0440\u0443\u044e \u0432\u043e\u043b\u044e \u0441\u043f\u0430\u043a\u043e\u044e, \u043d\u044f\u0445\u0430\u0439 \u0430\u043f\u0430\u043d\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u043e\u0439 \u044f\u0437\u044b\u043a \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435\u043c, \u043d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456, \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u0411\u043e\u0433\u0430, \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u043b\u044e\u0431\u043e\u0432\u0456, \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430 \u0430\u0441\u043e\u0431\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u0434\u0437\u0435\u0446\u0456 \u0432\u0430\u0448\u044b\u044f \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430. \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u0430\u0436\u043d\u0430\u0439 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u043a\u043e\u0440\u0430, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0448\u043c\u0430\u0442 \u0443 \u042f\u0433\u043e \u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0447\u044b\u0441\u0442\u0430\u044f \u043b\u044e\u0431\u043e\u045e, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u043e\u0431\u0440\u0430\u0439 \u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u044d\u0447\u0447\u0443 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0436\u0430\u044f \u0431\u043e\u044f\u0437\u044c, \u0448\u0442\u043e \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0441\u0432\u044f\u0442\u0430 \u0456\u0434\u0437\u0435 \u0437\u0430 \u0451\u0439 \u0443 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0441\u044d\u0440\u0446\u0430. \u0411\u043e\u0433 \u0432\u0435\u0434\u0430\u0435 \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u043c\u043a\u0456 \u0456 \u0436\u0430\u0434\u0430\u043d\u043d\u0456, \u042f\u0433\u043e \u0434\u0443\u0445 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u0435 \u045e \u043d\u0430\u0441; \u043a\u0430\u043b\u0456 \u0437\u0430\u0445\u043e\u0447\u0430, \u0437\u0430\u0431\u044f\u0440\u044d \u042f\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0430 \u045e\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u0432\u0435\u0440\u0430 \u045e \u0425\u0440\u044b\u0441\u0442\u0430. \u0401\u043d \u0441\u0430\u043c \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430: \u00ab\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0441\u044b\u043d\u044b, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u043c\u044f\u043d\u0435: \u043d\u0430\u0432\u0443\u0447\u0443 \u0432\u0430\u0441 \u0431\u043e\u044f\u0437\u0456 \u041f\u0430\u043d\u0430. \u0425\u0442\u043e \u0442\u043e\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e \u0436\u044b\u0446\u0446\u0451 \u0456 \u043b\u044e\u0431\u0456\u0446\u044c \u0434\u043e\u045e\u0433\u0456\u044f \u0434\u043d\u0456, \u043a\u0430\u0431 \u0431\u0430\u0447\u044b\u0446\u044c \u0434\u0430\u0431\u0440\u043e? \u0421\u0446\u0435\u0440\u0430\u0436\u044b \u044f\u0437\u044b\u043a \u0441\u0432\u043e\u0439 \u0430\u0434 \u0437\u043b\u043e\u0433\u0430 \u0456 \u0432\u0443\u0441\u043d\u044b \u0441\u0432\u0430\u0435 \u0430\u0434 \u0441\u043b\u043e\u0432\u0430\u045e \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u044b\u0445. \u0410\u0434\u0432\u044f\u0440\u043d\u0456\u0441\u044f \u0430\u0434 \u0437\u043b\u0430 \u0456 \u0440\u0430\u0431\u0456 \u0434\u0430\u0431\u0440\u043e, \u0448\u0443\u043a\u0430\u0439 \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0442\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u044f\u0433\u043e\u00bb (\u041f\u0441 34 [33], 12-15).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041b\u0430\u0441\u043a\u0430\u0432\u044b \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0410\u0439\u0446\u0435\u0446 \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u042f\u0433\u043e; \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u042f\u0433\u043e \u0441\u0430 \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u0401\u043d \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u043b\u0430\u0441\u043a\u0430\u043c\u0456 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u044e \u0456 \u0434\u0430\u0431\u0440\u044b\u043d\u0451\u0439. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430, \u0430 \u0434\u0443\u0448\u0430 \u043d\u0430\u0448\u0430\u044f \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u0445 \u0456 \u0441\u043b\u0430\u045e\u043d\u044b\u0445 \u0434\u0430\u0440\u043e\u045e \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0422\u043e\u0431 4, 19\u0430; 14, 8b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u0430 \u045e\u0441\u0435 \u0447\u0430\u0441\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439 \u0411\u043e\u0433\u0430 \u0456 \u043f\u0440\u0430\u0441\u0456 \u042f\u0433\u043e \u043f\u0440\u0430\u0441\u0442\u0430\u0432\u0430\u0446\u044c \u0448\u043b\u044f\u0445\u0456 \u0442\u0432\u0430\u0435, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0456\u0441\u044f \u045e\u0441\u0435 \u0442\u0432\u0430\u0435 \u043d\u0430\u043c\u0435\u0440\u044b.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0421\u043b\u0443\u0436\u044b \u0411\u043e\u0433\u0443 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0456 \u0440\u0430\u0431\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u042f\u043c\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"303","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e\u00bb \u0441\u0432. \u041a\u043b\u0456\u043c\u0435\u043d\u0442\u0430 \u0406, \u043f\u0430\u043f\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 24, 1-5; 27, 1 \u2013 29, 1: Funk 1, 93-97)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u043e\u0433 \u0432\u0435\u0440\u043d\u044b \u0441\u0432\u0430\u0456\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u043c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u043c, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u044f\u043a \u0411\u043e\u0433 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u045e\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u0430\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435, \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435 \u0447\u0430\u0433\u043e \u0434\u0430\u045e \u043f\u0440\u0430\u0437 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e. \u041f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u0456\u043c\u0441\u044f \u0434\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u0440\u044d\u0433\u0443\u043b\u044f\u0440\u043d\u0430 \u045e \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0447\u0430\u0441. \u0414\u0437\u0435\u043d\u044c \u0456 \u043d\u043e\u0447 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435; \u043d\u043e\u0447 \u0456\u0434\u0437\u0435 \u043d\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a, \u0443\u0441\u0442\u0430\u0435 \u0434\u0437\u0435\u043d\u044c, \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0437\u0435\u043d\u044c, \u0456 \u043d\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u043d\u043e\u0447. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u043c \u043d\u0430 \u043f\u043b\u0430\u0434\u044b \u0437\u044f\u043c\u043b\u0456. \u0427\u044b\u043c \u0451\u0441\u0446\u044c \u0437\u0435\u0440\u043d\u0435 \u0456 \u0430\u0434\u043a\u0443\u043b\u044c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430? \u0412\u043e\u0441\u044c \u0441\u0435\u0439\u0431\u0456\u0442 \u0432\u044b\u0439\u0448\u0430\u045e \u0456 \u043a\u0456\u043d\u0443\u045e \u0443 \u0437\u044f\u043c\u043b\u044e \u0437\u0435\u0440\u043d\u0435. \u0412\u044b\u0441\u0430\u0445\u043b\u0430\u0435 \u0456 \u0433\u043e\u043b\u0430\u0435 \u044f\u043d\u043e \u043f\u0430\u0434\u0430\u0435 \u045e \u0437\u044f\u043c\u043b\u044e \u0456 \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u044e\u0446\u0446\u0430. \u0417\u0430\u0442\u044b\u043c \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0411\u043e\u0436\u044b \u041f\u0440\u043e\u0432\u0456\u0434 \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u044f\u0433\u043e \u0437 \u0440\u0430\u0437\u0431\u0443\u0440\u044d\u043d\u043d\u044f: \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e\u0446\u0446\u0430 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0437\u0451\u0440\u043d\u044b \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u044c \u043f\u043b\u043e\u0434.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0442\u0430\u043a\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0445\u0456\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u0435\u0440\u043d\u044b\u043c \u0441\u0432\u0430\u0456\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u043c \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0443 \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u044b\u0441\u0443\u0434\u0430\u0445. \u0422\u043e\u0439, \u0445\u0442\u043e \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u0456\u045e \u043f\u0430\u0434\u043c\u0430\u043d, \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0441\u0430\u043c \u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0432\u0430\u0435; \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0433\u0430 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u0430\u043a\u0440\u0430\u043c\u044f \u043c\u0430\u043d\u044b. \u0422\u0430\u043c\u0443 \u0430\u0436\u044b\u0432\u0456\u043c \u043d\u0430\u0448\u0443\u044e \u0432\u0435\u0440\u0443 \u045e \u042f\u0433\u043e \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456 \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u0448\u0442\u043e \u045e\u0441\u0451 \u045e \u042f\u0433\u043e \u043c\u043e\u0446\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043b\u043e\u0432\u0430\u043c \u0441\u0432\u0430\u0451\u0439 \u0441\u0456\u043b\u044b \u0401\u043d \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0443\u0441\u0451 \u0456 \u0441\u043b\u043e\u0432\u0430\u043c \u043c\u043e\u0436\u0430 \u045e\u0441\u0451 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c. \u00ab\u0425\u0442\u043e \u042f\u043c\u0443 \u0441\u043a\u0430\u0436\u0430: \u201e\u0428\u0442\u043e \u0422\u044b \u0437\u0440\u0430\u0431\u0456\u045e?\u201d \u0456 \u0445\u0442\u043e \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u042f\u0433\u043e \u043c\u043e\u0446\u044b\u00bb (\u043f\u0430\u0440. \u041c\u0434\u0440 12, 12). \u0401\u043d \u0443\u0441\u0451 \u0440\u043e\u0431\u0456\u0446\u044c, \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430 \u0456 \u044f\u043a \u0445\u043e\u0447\u0430, \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u045e, \u043d\u0435 \u043f\u0440\u0430\u043f\u0430\u0434\u0437\u0435. \u0423\u0441\u0451 \u2013 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c, \u0456 \u043d\u0456\u0448\u0442\u043e \u043d\u0435 \u0441\u0445\u0430\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u042f\u0433\u043e \u0432\u043e\u043b\u0456, \u0431\u043e \u00ab\u043d\u044f\u0431\u0451\u0441\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u0411\u043e\u0436\u0443\u044e \u0441\u043b\u0430\u0432\u0443, \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u0443 \u0440\u0443\u043a \u042f\u0433\u043e \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0435\u0431\u0430\u0441\u0445\u0456\u043b. \u0414\u0437\u0435\u043d\u044c \u0434\u043d\u044e \u0430\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u043d\u043e\u0447 \u043d\u043e\u0447\u044b \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0432\u0435\u0434\u044b. \u041d\u044f\u043c\u0430 \u043c\u043e\u0432\u044b, \u0456 \u043d\u044f\u043c\u0430 \u0441\u043b\u043e\u045e, \u0430\u043b\u0435 \u0447\u0443\u0435\u0446\u0446\u0430 \u0456\u0445 \u0433\u043e\u043b\u0430\u0441\u00bb (\u041f\u0441 19 [18], 2-4).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433 \u0431\u0430\u0447\u044b\u0446\u044c \u0443\u0441\u0451 \u0456 \u045e\u0441\u0451 \u0447\u0443\u0435, \u0431\u0443\u0434\u0437\u0435\u043c \u0431\u0430\u044f\u0446\u0446\u0430 \u042f\u0433\u043e. \u041f\u0430\u043a\u0456\u043d\u0435\u043c \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u043a\u0430\u0431 \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0441\u0443\u0434\u0437\u0435 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0430\u0434\u0447\u0443\u0446\u044c \u0430\u043f\u0435\u043a\u0443 \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u0411\u043e \u0445\u0442\u043e \u0437 \u043d\u0430\u0441 \u043c\u043e\u0436\u0430 \u045e\u0446\u044f\u0447\u044b \u0430\u0434 \u042f\u0433\u043e \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0439 \u0440\u0443\u043a\u0456? \u042f\u043a\u0456 \u0436 \u0441\u0432\u0435\u0442 \u043c\u043e\u0436\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u045e\u0446\u044f\u043a\u0430\u0435 \u0430\u0434 \u042f\u0433\u043e? \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043a\u0430\u0436\u0430: \u00ab\u041a\u0443\u0434\u044b \u043f\u0430\u0439\u0434\u0443 \u0430\u0434 \u0434\u0443\u0445\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0456 \u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u043a\u0443\u0434\u044b \u045e\u0446\u044f\u043a\u0443? \u041a\u0430\u043b\u0456 \u045e\u0437\u044b\u0434\u0443 \u043d\u0430 \u043d\u0435\u0431\u0430, \u0422\u044b \u0442\u0430\u043c; \u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0441\u044f\u043b\u044e\u0441\u044f \u043d\u0430 \u043a\u0440\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u2013 \u0442\u0430\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0443\u0434\u0437\u0435 \u0422\u0432\u0430\u044f \u043f\u0440\u0430\u0432\u0456\u0446\u0430; \u043a\u0430\u043b\u0456 \u0441\u043f\u0430\u0447\u043d\u0443 \u045e \u0430\u0434\u0445\u043b\u0430\u043d\u0456, \u2013 \u0456 \u0442\u0430\u043c \u0422\u0432\u043e\u0439 \u0434\u0443\u0445\u00bb (\u043f\u0430\u0440. \u041f\u0441 139 [138], 7-11). \u0414\u044b\u043a \u043a\u0443\u0434\u044b \u0436 \u0430\u0434\u044b\u0441\u0446\u0456 \u0446\u0456 \u0434\u0437\u0435 \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u045e\u0441\u0451?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u043c\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430 \u045e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0441\u044d\u0440\u0446\u0430, \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0430 \u042f\u0433\u043e \u0447\u044b\u0441\u0442\u044b\u044f \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u044f \u0440\u0443\u043a\u0456, \u0431\u0443\u0434\u0437\u0435\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0433\u0430 \u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u043d\u0430\u0441 \u0447\u0430\u0441\u0442\u043a\u0430\u0439 \u0441\u0432\u0430\u0451\u0439 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0441\u0442 4, 17\u0441. 17d. \u043f\u0430\u0440. 17hh (Vlg)<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u043d\u0435, \u041a\u0430\u0440\u043e\u043b\u044c \u0443\u0441\u0435\u045e\u043b\u0430\u0434\u043d\u044b, \u0443\u0441\u0451 \u045e \u0422\u0432\u0430\u0451\u0439 \u0443\u043b\u0430\u0434\u0437\u0435, \u0456 \u043d\u044f\u043c\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431 \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u045e\u0441\u044f \u0422\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0412\u044b\u0437\u0432\u0430\u043b\u0456 \u043d\u0430\u0441 \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0456\u043c\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0422\u044b \u045e\u0447\u044b\u043d\u0456\u045e \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e, \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u043f\u0430\u0434 \u043d\u0435\u0431\u0430\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0412\u044b\u0437\u0432\u0430\u043b\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"304","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e\u00bb \u0441\u0432. \u041a\u043b\u0456\u043c\u0435\u043d\u0442\u0430 \u0406, \u043f\u0430\u043f\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 30, 3-4; 34, 2 \u2013 35, 5: Funk 1, 99. 103-105)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u0443\u0434\u0437\u0435\u043c \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0448\u043b\u044f\u0445\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u044f \u045e \u0441\u043f\u0430\u043a\u043e\u0439, \u043f\u0430\u043a\u043e\u0440\u0443 \u0456 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c, \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0434\u0430\u043b\u0451\u043a \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0430\u0431\u043c\u043e\u0432\u044b \u0456 \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u044f, \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c\u0456 \u0432\u0430 \u045e\u0447\u044b\u043d\u043a\u0430\u0445, \u0430 \u043d\u0435 \u045e \u0441\u043b\u043e\u0432\u0430\u0445. \u0411\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u0425\u0442\u043e \u0448\u043c\u0430\u0442 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0441\u043b\u0443\u0445\u0430\u0435; \u0446\u0456 \u0436 \u0448\u043c\u0430\u0442\u0441\u043b\u043e\u045e\u043d\u044b \u0434\u0443\u043c\u0430\u0435, \u0448\u0442\u043e \u0451\u043d \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u044b?\u00bb (\u043f\u0430\u0440. \u0401\u045e 11, 2).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u0446\u044c \u0430\u0445\u0432\u043e\u0442\u043d\u044b\u043c\u0456 \u0434\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u0434\u0430\u0431\u0440\u0430. \u0411\u043e \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u0435 \u043d\u0430\u0441: \u00ab\u0412\u043e\u0441\u044c \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u041f\u0430\u043d \u0456 \u0430\u0434\u043f\u043b\u0430\u0442\u0430 \u042f\u0433\u043e \u0437 \u0406\u043c, \u043a\u0430\u0431 \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u044f\u0433\u043e\u043d\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e\u00bb (\u043f\u0430\u0440. \u0410\u043f 22, 12). \u0401\u043d \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043d\u0430\u0441, \u043a\u0430\u0431 \u043c\u044b \u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u042f\u0433\u043e \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u043b\u0456 \u043b\u044f\u043d\u043e\u0442\u044b \u0456 \u043d\u044f\u0434\u0431\u0430\u0439\u043d\u0430\u0441\u0446\u0456 \u045e \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u0456 \u0434\u0430\u0431\u0440\u0430. \u041d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0448\u044b\u043c \u0433\u043e\u043d\u0430\u0440\u0430\u043c \u0456 \u043d\u0430\u0434\u0437\u0435\u044f\u0439. \u0411\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u042f\u0433\u043e \u0432\u043e\u043b\u0456 \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u0448\u0442\u043e \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u044f \u0445\u043e\u0440\u044b \u0430\u043d\u0451\u043b\u0430\u045e \u0441\u0442\u0430\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u042f\u0433\u043e \u0432\u043e\u043b\u044e. \u0411\u043e \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435: \u00ab\u0421\u0432\u044f\u0442\u044b, \u0421\u0432\u044f\u0442\u044b, \u0421\u0432\u044f\u0442\u044b, \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u0423\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u043f\u043e\u045e\u043d\u0430\u044f \u0445\u0432\u0430\u043b\u044b \u042f\u0433\u043e\u00bb (\u0414\u0430\u043d 7, 10; \u0406\u0441 6, 3).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0456\u0440\u0443\u044e\u0447\u044b\u0441\u044f \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435\u043c, \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u0437\u0433\u043e\u0434\u0430\u044e, \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u042f\u0433\u043e \u044f\u043a \u0431\u044b \u0430\u0434\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u043a\u0430\u0431 \u0437\u043c\u0430\u0433\u0447\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u042f\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0456 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u044b\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456. \u0411\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u0427\u0430\u0433\u043e \u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430, \u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430, \u0456 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0441\u044d\u0440\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0442\u043e\u0435 \u0411\u043e\u0433 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e\u00bb (1 \u041a\u0430\u0440 2, 9).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u044f\u043a\u0456\u043c\u0456 \u0436 \u0432\u044f\u043b\u0456\u043a\u0456\u043c\u0456 \u0456 \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0411\u043e\u0436\u044b\u044f \u0434\u0430\u0440\u044b! \u0416\u044b\u0446\u0446\u0451 \u045e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456, \u0445\u0432\u0430\u043b\u0430 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043f\u0440\u0430\u045e\u0434\u0430 \u045e \u0441\u0432\u0430\u0431\u043e\u0434\u0437\u0435, \u0432\u0435\u0440\u0430 \u045e \u043d\u0430\u0434\u0437\u0435\u0456, \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u043d\u0430\u0434 \u0441\u0430\u0431\u043e\u044e \u045e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456; \u043c\u044b \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0437\u043c\u043e\u0436\u0430\u043c \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u043d\u0430\u0448\u044b\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c. \u042f\u043a\u0456\u044f \u0436 \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b \u0442\u044b\u043c, \u0445\u0442\u043e \u042f\u0433\u043e \u0447\u0430\u043a\u0430\u0435? \u0406\u0445 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0441\u0446\u044c \u0456 \u0432\u0435\u043b\u0456\u0447 \u0432\u044f\u0434\u043e\u043c\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u043c\u0443 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044e \u0456 \u0410\u0439\u0446\u0443 \u0432\u044f\u043a\u043e\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0417 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044e \u0431\u0443\u0434\u0437\u0435\u043c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0430\u043f\u044b\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u0447\u0430\u043a\u0430\u0435 \u042f\u0433\u043e, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b. \u0410\u043b\u0435 \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0433\u044d\u0442\u0430 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f? \u0421\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u043d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c \u0437 \u0432\u0435\u0440\u0430\u044e \u043f\u0440\u044b\u0445\u0456\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u042f\u043c\u0443 \u043f\u0440\u044b\u0435\u043c\u043d\u0430 \u0456 \u043b\u044e\u0431\u0430, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0439 \u0432\u043e\u043b\u0456, \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0456\u0441\u0446\u0456 \u0448\u043b\u044f\u0445\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u044b, \u0430\u0434\u043a\u0456\u0434\u0432\u0430\u044e\u0447\u044b \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u0441\u044f\u0431\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 25 (24), 4-5. 16\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0414\u0430\u0439 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0422\u0432\u0430\u0435 \u0434\u0430\u0440\u043e\u0433\u0456, \u041f\u0430\u043d\u0435, \u0456 \u043d\u0430\u0432\u0443\u0447\u044b \u043c\u044f\u043d\u0435 \u0441\u0446\u0435\u0436\u043a\u0430\u043c \u0422\u0432\u0430\u0456\u043c. \u0412\u044f\u0434\u0437\u0456 \u043c\u044f\u043d\u0435 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0422\u0432\u0430\u0451\u0439 \u0456 \u043d\u0430\u0432\u0443\u0447\u044b. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0422\u044b \u0411\u043e\u0433 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043c\u0430\u0439\u0433\u043e, \u043d\u0430 \u0426\u044f\u0431\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u043c\u044f\u043d\u0435 \u0456 \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e, \u0431\u043e \u044f \u0430\u0434\u0437\u0456\u043d\u043e\u043a\u0456 \u0456 \u0431\u0435\u0434\u043d\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u044b \u0411\u043e\u0433.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"305","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041c\u043e\u0432\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0430\u0440\u044b\u044f\u043d\u0430\u045e\u00bb \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 2, 78, 79: PG 26, 311, 314)<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u2013 \u0433\u044d\u0442\u0430 \u0432\u043e\u0431\u0440\u0430\u0437 \u0456 \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e \u043d\u0430\u0441 \u0441\u0430\u043c\u0456\u0445, \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u0445 \u0451\u0441\u0446\u044c \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0442\u0430\u043c\u0443 \u043d\u0435\u0431\u0435\u0441\u043f\u0430\u0434\u0441\u0442\u0430\u045e\u043d\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u0456 \u0441\u0442\u0432\u0430\u0440\u0430\u043b\u044c\u043d\u0430\u044f \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u043f\u0440\u044b\u043f\u0456\u0441\u0432\u0430\u044e\u0447\u044b \u0441\u0430\u0431\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0443\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u0451\u0439, \u043a\u0430\u0436\u0430: \u00ab\u041f\u0430\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445\u00bb (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 8, 22). \u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0443 \u043d\u0430\u0441, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0430 \u0441\u044f\u0431\u0435. \u041a\u0430\u0436\u0430 \u0442\u0430\u043a \u043f\u0440\u0430 \u0441\u044f\u0431\u0435 \u043d\u0435 \u0442\u0430\u043c\u0443, \u0431\u044b\u0446\u0446\u0430\u043c \u0401\u043d, \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c, \u0431\u044b\u045e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c, \u0430\u043b\u0435 \u0448\u0442\u043e \u045e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u0445 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u042f\u0433\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0432\u043e\u0431\u0440\u0430\u0437. \u0422\u0430\u043a \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d: \u00ab\u0425\u0442\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u0432\u0430\u0441, \u041c\u044f\u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0435\u00bb (\u041c\u0446 10, 40), \u0431\u043e \u042f\u0433\u043e \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0451\u0441\u0446\u044c \u0443 \u043d\u0430\u0441, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0436\u0430: \u00ab\u041f\u0430\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435 \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0448\u043b\u044f\u0445\u0443 \u0441\u0432\u0430\u0439\u0433\u043e, \u043f\u0435\u0440\u0430\u0434 \u0434\u0437\u0435\u044f\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456\u00bb (\u041f\u0440\u044b\u043f 8, 22), \u0445\u043e\u0446\u044c \u0441\u0430\u043c \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e, \u0430\u0434\u043d\u0430\u043a \u0443 \u0456\u0445 \u0451\u0441\u0446\u044c \u042f\u0433\u043e\u043d\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0456 \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0432\u043e\u0431\u0440\u0430\u0437 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0430\u0434\u0431\u0456\u0442\u044b \u045e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u0445, \u043a\u0430\u0431 \u0441\u0432\u0435\u0442 \u043f\u0440\u0430\u0437 \u0456\u0445 \u043c\u043e\u0433 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0421\u043b\u043e\u0432\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f, \u0430 \u043f\u0440\u0430\u0437 \u0421\u043b\u043e\u0432\u0430, \u0410\u0439\u0446\u0430. \u041d\u0430\u0432\u0443\u0447\u0430\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b: \u00ab\u0411\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u043e\u0436\u043d\u0430 \u0432\u0435\u0434\u0430\u0446\u044c \u043f\u0440\u0430 \u0411\u043e\u0433\u0430, \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430\u0435 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0430\u0434\u043a\u0440\u044b\u045e \u0456\u043c. \u0410\u0434 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443 \u042f\u0433\u043e \u043d\u044f\u0431\u0430\u0447\u043d\u044b\u044f \u0440\u044b\u0441\u044b <\/span><span style=\"font-weight: bold; font-style: italic;\">\u2013<\/span><span> \u0430\u0434\u0432\u0435\u0447\u043d\u0430\u044f \u042f\u0433\u043e \u043c\u043e\u0446 \u0456 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044c <\/span><span style=\"font-weight: bold; font-style: italic;\">\u2013<\/span><span> \u0431\u0430\u0447\u043d\u044b\u044f \u045e \u0437\u0430\u045e\u0432\u0430\u0436\u043d\u044b\u0445 \u0447\u044b\u043d\u0430\u0445, \u0442\u0430\u043c\u0443 \u043d\u044f\u043c\u0430 \u0456\u043c \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044f\u00bb (\u0420\u044b\u043c 1, 19-20). \u0422\u0430\u043c\u0443 \u0421\u043b\u043e\u0432\u0430 \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c, \u0430 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u044f \u0442\u0440\u044d\u0431\u0430 \u0430\u0434\u043d\u0435\u0441\u0446\u0456 \u0434\u0430 \u0442\u043e\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0443 \u043d\u0430\u0441.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0430\u0440\u044b\u044f\u043d\u0435 \u043d\u0435 \u0436\u0430\u0434\u0430\u044e\u0446\u044c \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430, \u043d\u044f\u0445\u0430\u0439 \u0430\u0434\u043a\u0430\u0436\u0443\u0446\u044c \u043d\u0430\u043c, \u0446\u0456 \u0451\u0441\u0446\u044c \u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u0445 \u043d\u0435\u0439\u043a\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0446\u0456 \u044f\u0435 \u043d\u044f\u043c\u0430? \u041a\u0430\u043b\u0456 \u043d\u044f\u043c\u0430, \u0442\u043e \u0447\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0441\u0443\u043c\u0443\u0435: \u00ab\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0432\u0435\u0442 \u0441\u0432\u0430\u0451\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e \u0411\u043e\u0433\u0430 \u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0439\u00bb (1 \u041a\u0430\u0440 1, 21). \u0410\u0431\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u043b\u0456 \u043d\u044f\u043c\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0447\u0430\u043c\u0443 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u0437\u0433\u0430\u0434\u0432\u0430\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u0443\u0434\u0440\u044b\u0445? \u0411\u043e \u0432\u043e\u0441\u044c \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u041c\u0443\u0434\u0440\u044b \u0431\u0430\u0456\u0446\u0446\u0430 \u0456 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0435 \u0437\u043b\u0430\u00bb (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 14, 16), \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u00ab\u0414\u043e\u043c \u0431\u0443\u0434\u0443\u0435\u0446\u0446\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e\u00bb (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 24, 3).<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u042d\u043a\u043b\u0435\u0437\u0456\u044f\u0441\u0442 \u043a\u0430\u0436\u0430: \u00ab\u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0440\u0430\u0437\u2019\u044f\u0441\u043d\u044f\u0435 \u044f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u00bb (\u043f\u0430\u0440. \u042d\u043a\u043b 8, 1). \u0401\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430\u043a\u0430\u0440\u0430\u0435 \u0434\u0437\u0451\u0440\u0437\u043a\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: \u00ab\u041d\u0435 \u043a\u0430\u0436\u044b: \u201c\u0447\u0430\u043c\u0443 \u0434\u0430\u045e\u043d\u0456\u044f \u0434\u043d\u0456 \u043b\u0435\u043f\u0448\u044b\u044f \u0437\u0430 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456\u044f?\u201d \u0423 \u0433\u044d\u0442\u044b\u043c \u043f\u044b\u0442\u0430\u043d\u043d\u0456 \u043d\u044f\u043c\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456\u00bb (\u043f\u0430\u0440. \u042d\u043a\u043b 7, 10).<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410\u0431 \u0442\u044b\u043c, \u0448\u0442\u043e \u0456\u0441\u043d\u0443\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u0445, \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0441\u044b\u043d \u0421\u0456\u0440\u0430\u0445\u0430 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: \u00ab\u041f\u0430\u043d \u043f\u0440\u0430\u043b\u0456\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043d\u0430 \u045e\u0441\u0435 \u0441\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u043d\u0430 \u043a\u043e\u0436\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u0430\u0440\u0443, \u0456 \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u0451\u044e \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e\u00bb (\u043f\u0430\u0440. \u0421\u0456\u0440 1, 9-10). \u0413\u044d\u0442\u0430\u0435 \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u043d\u043d\u0435 \u043d\u0435 \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430 \u0441\u0430\u043c\u0430\u0456\u0441\u043d\u0430\u0439 \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u044f\u043a\u043e\u0439 \u0451\u0441\u0446\u044c \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0421\u044b\u043d, \u0430\u043b\u0435 \u0434\u0430 \u044f\u0435 \u0430\u0434\u0431\u0456\u0442\u043a\u0430 \u045e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456. \u0414\u044b\u043a \u0447\u0430\u043c\u0443 \u0436 \u0433\u044d\u0442\u0430\u044f \u0442\u0432\u043e\u0440\u0447\u0430\u044f \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0456 \u0430\u0434\u0431\u0456\u0442\u043a\u0430\u043c \u044f\u043a\u043e\u0439 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u0432\u0435\u0434\u044b, \u0440\u0430\u0437\u043b\u0456\u0442\u044b\u044f \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435, \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u0431 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u044f\u043a \u0431\u044b \u043f\u0440\u0430 \u0441\u044f\u0431\u0435: \u00ab\u041f\u0430\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445\u00bb? \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0456\u0441\u043d\u0443\u0435 \u045e \u0441\u0432\u0435\u0446\u0435, \u043d\u0435 \u0441\u0442\u0432\u0430\u0440\u0430\u043b\u044c\u043d\u0430\u044f, \u0430\u043b\u0435 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u044f, \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u0430\u044f \u045e \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0411\u043e\u0433\u0430. \u041f\u0440\u0430\u0437 \u044f\u0435 \u00ab\u043d\u044f\u0431\u0451\u0441\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u0411\u043e\u0436\u0443\u044e \u0441\u043b\u0430\u0432\u0443, \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u0443 \u0440\u0443\u043a \u042f\u0433\u043e \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0435\u0431\u0430\u0441\u0445\u0456\u043b\u00bb (\u041f\u0441 19 [18], 2).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0434\u0440 7, 22. 23\u0430b; 1 \u041a\u0430\u0440 2, 10b<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0401\u0441\u0446\u044c \u0443 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0434\u0443\u0445 \u0440\u0430\u0437\u0443\u043c\u043d\u044b \u0456 \u0441\u0432\u044f\u0442\u044b, \u0430\u0434\u0437\u0456\u043d\u044b, \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b, \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u044b,<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u0440\u0443\u0445\u0430\u0432\u044b, \u0434\u0430\u0431\u0440\u0430\u043b\u044e\u0431\u043d\u044b, \u043d\u044f\u0441\u0442\u0440\u044b\u043c\u0430\u043d\u044b, \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u043d\u044b, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0456 \u045e\u0441\u0451\u0431\u0430\u0447\u043d\u044b, \u044f\u043a\u0456 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0432\u0430 \u045e\u0441\u0435 \u0434\u0443\u0445\u0456.&nbsp;<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0414\u0443\u0445 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0432\u0430 \u045e\u0441\u0451, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0411\u043e\u0436\u044b\u044f.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"306","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0422\u0440\u0430\u043a\u0442\u0430\u0442\u00bb \u0441\u0432. \u0411\u0430\u043b\u0434\u0443\u0456\u043d\u0430 \u041a\u0430\u043d\u0442\u0443\u0430\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 6: PL 204, 451-453)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0436\u044b\u0432\u043e\u0435 \u0456 \u0434\u0437\u0435\u0439\u0441\u043d\u0430\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0436\u044b\u0432\u043e\u0435 \u0456 \u0434\u0437\u0435\u0439\u0441\u043d\u0430\u0435, \u0432\u0430\u0441\u0442\u0440\u044d\u0439\u0448\u0430\u0435 \u0437\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456 \u043c\u0435\u0447 \u0434\u0432\u0443\u0441\u0435\u0447\u043d\u044b\u00bb (\u0413\u0431\u0440 4, 12). \u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u0443\u0441\u0456\u043c, \u0445\u0442\u043e \u0448\u0443\u043a\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u2013 \u0421\u043b\u043e\u0432\u0430, \u041c\u043e\u0446 \u0456 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430, \u2013 \u044f\u043a\u0430\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0441\u0456\u043b\u0430 \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u0430 \u045e \u0411\u043e\u0436\u044b\u043c \u0441\u043b\u043e\u0432\u0435. \u0421\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0410\u0439\u0446\u0430 \u045e \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0447\u0430\u0441 \u0431\u044b\u043b\u043e \u0430\u0431\u2019\u044f\u045e\u043b\u0435\u043d\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c, \u0430 \u0437\u0430\u0442\u044b\u043c, \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430\u0435 \u0456\u043c\u0456, \u0431\u044b\u043b\u043e \u0437 \u0432\u0435\u0440\u0430\u044e \u0456 \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u043f\u0440\u044b\u043d\u044f\u0442\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456. \u0422\u0430\u043c\u0443 \u0421\u043b\u043e\u0432\u0430 \u0456\u0441\u043d\u0443\u0435 \u045e \u0410\u0439\u0446\u0430, \u0421\u043b\u043e\u0432\u0430 \u2013 \u0443 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0456, \u0456 \u0421\u043b\u043e\u0432\u0430 \u2013 \u0443 \u0441\u044d\u0440\u0446\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0436\u044b\u0432\u043e\u0435, \u0431\u043e \u0410\u0439\u0446\u0435\u0446 \u0434\u0430\u045e \u042f\u043c\u0443 \u043c\u043e\u0446 \u043c\u0435\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u045e \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435, \u0442\u0430\u043a \u044f\u043a \u0410\u0439\u0446\u0435\u0446 \u043c\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435. \u0422\u0430\u043c\u0443 \u044f\u043d\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0436\u044b\u0432\u043e\u0435, \u0430\u043b\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0430\u043c\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u044f\u043a \u0434\u0430\u0440\u044d\u0447\u044b \u0456 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0441\u044f\u0431\u0435: \u00ab\u042f \u2013 \u0434\u0430\u0440\u043e\u0433\u0430, \u0456 \u043f\u0440\u0430\u045e\u0434\u0430, \u0456 \u0436\u044b\u0446\u0446\u0451\u00bb (\u042f\u043d 14, 6). \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436\u044b\u0432\u043e\u0435, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0436\u044b\u0446\u0446\u0451\u043c, \u0442\u0430\u043c\u0443 \u0430\u0436\u044b\u045e\u043b\u044f\u0435. \u0411\u043e \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u00ab\u044f\u043a \u0410\u0439\u0446\u0435\u0446 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u0430\u0435 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0456 \u0430\u0436\u044b\u045e\u043b\u044f\u0435, \u0442\u0430\u043a \u0456 \u0421\u044b\u043d \u0430\u0436\u044b\u045e\u043b\u044f\u0435 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0445\u043e\u0447\u0430\u00bb (\u042f\u043d 5, 21). \u0410\u0436\u044b\u045e\u043b\u044f\u0435, \u043a\u0430\u043b\u0456 \u043a\u043b\u0456\u0447\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u0430\u0433\u0430 \u0437 \u043c\u0430\u0433\u0456\u043b\u044b, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u041b\u0430\u0437\u0430\u0440, \u0432\u044b\u0439\u0434\u0437\u0456 \u0432\u043e\u043d\u043a\u0456!\u00bb (\u042f\u043d 11, 43).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430\u0435 \u0421\u043b\u043e\u0432\u0430, \u043a\u0430\u043b\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u0446\u0446\u0430, \u0434\u0430\u0435 \u0437\u043d\u0435\u0448\u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u043c\u0443 \u0441\u043b\u043e\u0432\u0443 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0443\u044e \u043c\u043e\u0446. \u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u0434\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0436\u044b\u0446\u0446\u0451, \u0456 \u044f\u043d\u044b \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u044e\u0446\u0446\u0430 \u044f\u043a \u0441\u044b\u043d\u044b \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430. \u0416\u044b\u0432\u044b\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0421\u043b\u043e\u0432\u0430 \u045e \u0441\u044d\u0440\u0446\u044b \u0410\u0439\u0446\u0430, \u0436\u044b\u0432\u044b\u043c \u0443 \u0432\u0443\u0441\u043d\u0430\u0445 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430, \u0436\u044b\u0432\u044b\u043c \u0443 \u0441\u044d\u0440\u0446\u044b \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0456 \u043b\u044e\u0431\u0456\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436\u044b\u0432\u043e\u0435, \u0442\u043e \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u0456 \u043f\u043b\u0451\u043d\u043d\u0430\u0435: \u043f\u043b\u0451\u043d\u043d\u0430\u0435 \u045e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456, \u043f\u043b\u0451\u043d\u043d\u0430\u0435 \u045e \u043a\u0456\u0440\u0430\u0432\u0430\u043d\u043d\u0456, \u043f\u043b\u0451\u043d\u043d\u0430\u0435 \u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456. \u0428\u0442\u043e \u0436 \u043c\u0430\u0433\u043b\u043e \u0431 \u0431\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u043f\u043b\u0451\u043d\u043d\u044b\u043c? \u0428\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c? \u00ab\u0425\u0442\u043e \u0440\u0430\u0441\u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430, \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u0443\u0441\u044e \u0445\u0432\u0430\u043b\u0443 \u042f\u0433\u043e\u043d\u0443\u044e?\u00bb (\u041f\u0441 106 [105], 2). \u041f\u043b\u0451\u043d\u043d\u0430\u0435, \u043a\u0430\u043b\u0456 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435, \u043f\u043b\u0451\u043d\u043d\u0430\u0435 \u043f\u0430\u0434\u0447\u0430\u0441 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f. \u041d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0431\u0435\u0437 \u043f\u043b\u0451\u043d\u0443, \u0430\u043b\u0435 \u0434\u0430\u0435 \u043f\u043b\u0451\u043d \u0443\u0441\u044e\u0434\u044b, \u043a\u0443\u0434\u044b \u043f\u0430\u0441\u044b\u043b\u0430\u0435\u0446\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043d\u043e \u043f\u043b\u0451\u043d\u043d\u0430\u0435 \u0456 \u00ab\u0432\u0430\u0441\u0442\u0440\u044d\u0439\u0448\u0430\u0435 \u0437\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456 \u043c\u0435\u0447 \u0434\u0432\u0443\u0441\u0435\u0447\u043d\u044b\u00bb (\u0413\u0431\u0440 4, 12), \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u0437 \u0432\u0435\u0440\u0430\u044e \u0456 \u043b\u044e\u0431\u043e\u045e\u044e. \u0428\u0442\u043e \u0436 \u0451\u0441\u0446\u044c \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u044b\u043c \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u0432\u0435\u0440\u044b\u0446\u044c? \u0410\u043b\u044c\u0431\u043e \u0448\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0446\u044f\u0436\u043a\u0456\u043c \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c? \u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0421\u043b\u043e\u0432\u0430, \u042f\u0433\u043e \u0433\u043e\u043b\u0430\u0441 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e \u0441\u044d\u0440\u0446\u0430 \u044f\u043a \u0432\u043e\u0441\u0442\u0440\u0430\u044f \u0441\u0442\u0440\u0430\u043b\u0430, \u0432\u044b\u043f\u0443\u0448\u0447\u0430\u043d\u0430\u044f \u0437 \u043b\u0443\u043a\u0430 \u0432\u043e\u043b\u0430\u0442\u0430, \u0456 \u044f\u043a \u0446\u0432\u0456\u043a\u0456, \u0448\u0442\u043e \u0437\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u0446\u0430 \u0433\u043b\u044b\u0431\u043e\u043a\u0430, \u0434\u0430\u0441\u044f\u0433\u0430\u0435 \u043f\u0430\u0442\u0430\u0435\u043c\u043d\u044b\u0445 \u043a\u0443\u0442\u043a\u043e\u045e \u0434\u0443\u0448\u044b. \u0413\u044d\u0442\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u00ab\u0432\u0430\u0441\u0442\u0440\u044d\u0439\u0448\u0430\u0435 \u0437\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456 \u043c\u0435\u0447 \u0434\u0432\u0443\u0441\u0435\u0447\u043d\u044b\u00bb, \u0431\u043e\u043b\u044c\u0448 \u043f\u043b\u0451\u043d\u043d\u0430\u0435 \u0437\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u043c\u043e\u0446 \u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c, \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0433\u043b\u044b\u0431\u0435\u0439 \u0437\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0432\u0435\u0434\u044b \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430\u0435 \u0437\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u043b\u044e\u0434\u0441\u043a\u0443\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u0432\u0443\u0447\u043e\u043d\u044b\u044f \u043f\u0440\u0430\u043c\u043e\u0432\u044b.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0421\u0456\u0440 1, 5. 16\u0430 (Vlg)<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0440\u044b\u043d\u0456\u0446\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u2013 \u0441\u043b\u043e\u0432\u0430 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0430 \u0448\u043b\u044f\u0445\u0456 \u044f\u0435 \u2013 \u0432\u0435\u0447\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u2013 \u0431\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410 \u0448\u043b\u044f\u0445\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"307","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0414\u044b\u044f\u043b\u043e\u0433 \u00ab\u041f\u0440\u0430 \u0411\u043e\u0436\u044b \u041f\u0440\u043e\u0432\u0456\u0434\u00bb \u0441\u0432. \u041a\u0430\u0446\u044f\u0440\u044b\u043d\u044b \u0421\u0456\u0435\u043d\u0441\u043a\u0430\u0439, \u043f\u0430\u043d\u043d\u044b<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 134, ed. latina, Ingolstadii 1583, ff<\/span><span style=\"color: #ff0000;\"><span style=\"font-size: 0.6em; vertical-align: super;\">0<\/span><\/span><span style=\"color: #ff0000;\">&nbsp;215v-216)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u042f\u043a\u0456 \u0436 \u0434\u043e\u0431\u0440\u044b \u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u041f\u0430\u043d \u0434\u043b\u044f \u045e\u0441\u0456\u0445<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b \u0410\u0439\u0446\u0435\u0446 \u0443 \u0441\u0432\u0430\u0451\u0439 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u043d\u0430 \u041a\u0430\u0446\u044f\u0440\u044b\u043d\u0443 \u0441\u0432\u043e\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u043f\u043e\u0437\u0456\u0440\u043a \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041c\u0430\u044f \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u044f \u0434\u0430\u0447\u043a\u0430! \u041c\u043e\u0446\u043d\u0430 \u0436\u0430\u0434\u0430\u044e \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u0432\u0435\u0442\u0443 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0447\u044b \u043b\u044e\u0434\u0437\u044f\u043c \u0443 \u043a\u043e\u0436\u043d\u0430\u0439 \u0456\u0445 \u043f\u0430\u0442\u0440\u044d\u0431\u0435. \u0410\u0434\u043d\u0430\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443 \u0441\u0432\u0430\u0456\u043c \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c \u0432\u0430 \u045e\u0441\u0456\u043c, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0430\u0434 \u041c\u044f\u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0436\u044b\u0446\u0446\u044f. \u0413\u044d\u0442\u044b\u043c \u0441\u0430\u043c \u0441\u044f\u0431\u0435 \u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u044c. \u0410\u043b\u0435 \u041c\u043e\u0439 \u041f\u0440\u043e\u0432\u0456\u0434 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u0441\u0443\u043f\u0440\u0430\u0432\u0430\u0434\u0436\u0430\u0435 \u044f\u0433\u043e. \u0422\u0430\u043c\u0443 \u042f \u0445\u0430\u0447\u0443, \u043a\u0430\u0431 \u0442\u044b \u0432\u0435\u0434\u0430\u043b\u0430: \u0443\u0441\u0451, \u0448\u0442\u043e \u042f \u0434\u0430\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u0433\u0430 \u041f\u0440\u043e\u0432\u0456\u0434\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e \u043a\u0430\u043b\u0456 \u045e \u0441\u0432\u0430\u0456\u043c \u041f\u0440\u043e\u0432\u0456\u0434\u0437\u0435 \u042f \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u042f \u0437\u0430\u0437\u0456\u0440\u043d\u0443\u045e \u0443 \u0441\u044f\u0431\u0435 \u0456 \u0431\u044b\u045e \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u043b\u044e\u0431\u043e\u045e\u044e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u0456 \u041c\u0430\u0439\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f. \u041c\u043d\u0435 \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u045e \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u044b\u043c \u041f\u0440\u043e\u0432\u0456\u0434\u0437\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u0446\u044c \u044f\u0433\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041c\u0430\u0439\u0433\u043e \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430. \u0422\u0430\u043c\u0443 \u042f \u0434\u0430\u045e \u044f\u043c\u0443 \u043f\u0430\u043c\u044f\u0446\u044c, \u043a\u0430\u0431 \u0451\u043d \u0443\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u045e \u041c\u0430\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b; \u0445\u0430\u0446\u0435\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u0431 \u0451\u043d \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u045e \u0443 \u041c\u0430\u0451\u0439, \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043a\u0440\u0430\u043c\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u042f \u0434\u0430\u045e \u044f\u043c\u0443 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435, \u043a\u0430\u0431 \u0443 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u041c\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0451\u043d \u043f\u0430\u0437\u043d\u0430\u045e \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e \u041c\u0430\u044e \u0432\u043e\u043b\u044e, \u0448\u0447\u043e\u0434\u0440\u0430\u0433\u0430 \u0414\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u0446\u044b \u0456 \u0414\u0430\u045e\u0446\u044b \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u043b\u0430\u0441\u043a\u0430\u045e. \u0414\u0430\u045e \u044f\u043c\u0443 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u043b\u044e\u0431\u0456\u0446\u044c \u0456 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043a\u0430\u0431 \u0451\u043d \u043c\u043e\u0433 \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0437\u043d\u0430\u0435, \u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u044f\u0433\u043e \u0440\u043e\u0437\u0443\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u045e\u0447\u044b\u043d\u0456\u045e \u041c\u043e\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u041f\u0440\u043e\u0432\u0456\u0434 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u043c\u043e\u0433 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u041c\u044f\u043d\u0435 \u0456 \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044c \u0443 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u044f. \u0406 \u044f\u043a \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0443 \u0456\u043d\u0448\u044b\u0445 \u043c\u0435\u0441\u0446\u0430\u0445, \u0443 \u0432\u044b\u043d\u0456\u043a\u0443 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0440\u0430\u0430\u0439\u0446\u0430, \u0410\u0434\u0430\u043c\u0430, \u043d\u0435\u0431\u0430 \u0437\u0430\u043a\u0440\u044b\u043b\u0430\u0441\u044f. \u0417-\u0437\u0430 \u044f\u0433\u043e \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u045e \u0441\u0432\u0435\u0442 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e\u0441\u0435 \u0456\u043d\u0448\u044b\u044f \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0437\u0435\u043b\u044f \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456, \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u043d\u0430\u0439 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044e, \u042f \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0443 \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0439\u043b\u0430\u0441\u043a\u0430\u0432\u0435\u0439\u0448\u044b\u043c \u041f\u0440\u043e\u0432\u0456\u0434\u0437\u0435 \u0441\u043f\u0430\u0441\u043b\u0430\u0446\u044c \u0432\u0430\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0443 \u0432\u0430\u0448\u044b\u0445 \u043f\u0430\u0442\u0440\u044d\u0431\u0430\u0445. \u042f \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0430\u0434 \u042f\u0433\u043e \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u0430\u0434 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456, \u044f\u043a\u0430\u044f \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0431\u0430\u0446\u044c\u043a\u0456 \u0440\u0430\u0437\u043b\u0456\u043b\u0430\u0441\u044f \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435. \u0422\u0430\u0434\u044b \u0401\u043d, \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u043b\u044e\u0431\u043e\u045e\u044e \u0456, \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c, \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0432\u044b\u0439\u0448\u0430\u045e \u043d\u0430\u0441\u0443\u0442\u0440\u0430\u0447 \u0433\u0430\u043d\u0435\u0431\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456 \u043d\u0430\u0439\u0448\u0430\u043d\u043e\u045e\u043d\u0435\u0439\u0448\u0430\u0433\u0430 \u043a\u0440\u044b\u0436\u0430 \u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0430\u045e \u0432\u0430\u043c \u0436\u044b\u0446\u0446\u0451, \u043d\u0435 \u043f\u0440\u0430\u0437 \u0437\u0430\u0441\u043b\u0443\u0433\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430, \u0430\u043b\u0435 \u043d\u0430 \u043c\u043e\u0446\u044b \u0441\u0432\u0430\u0451\u0439 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456\u00bb.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 17 (16), 8-7\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u0446\u0435\u0440\u0430\u0436\u044b \u043c\u044f\u043d\u0435, \u044f\u043a \u0437\u0440\u044d\u043d\u043a\u0443 \u0432\u043e\u043a\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0443 \u0446\u0435\u043d\u0456 \u0422\u0432\u0430\u0456\u0445 \u043a\u0440\u044b\u043b\u0430\u045e \u0441\u0445\u0430\u0432\u0430\u0439 \u043c\u044f\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043a\u0430\u0436\u044b \u0446\u0443\u0434\u044b \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439, \u0417\u0431\u0430\u045e\u0446\u0430, \u044f\u043a\u0456 \u0440\u0430\u0442\u0443\u0435\u0448 \u0430\u0434 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u0422\u0432\u0430\u044e \u043f\u0440\u0430\u0432\u0456\u0446\u0443. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0423 \u0446\u0435\u043d\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"311","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u043c \u0441\u0432\u0435\u0446\u0435&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00abGaudium et spes\u00bb \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/span><\/p>\r\n<p style=\"text-indent: 32pt; text-align: center;\"><span style=\"color: #ff0000;\">(N. 78)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0435\u0441\u0446\u0456 \u0441\u043f\u0430\u043a\u043e\u0439<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043f\u0430\u043a\u043e\u0439 \u2013 \u0433\u044d\u0442\u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u0430 \u0430\u0434\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0432\u0430\u0439\u043d\u044b, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0442\u0430\u043d \u0440\u0430\u045e\u043d\u0430\u0432\u0430\u0433\u0456 \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u043d\u044b\u0445 \u0441\u0456\u043b. \u0421\u043f\u0430\u043a\u043e\u0439 \u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0437 \u0434\u044d\u0441\u043f\u0430\u0442\u044b\u0447\u043d\u0430\u0433\u0430 \u0434\u0430\u043c\u0456\u043d\u0430\u0432\u0430\u043d\u043d\u044f, \u0430\u043b\u0435 \u0441\u043b\u0443\u0448\u043d\u0430 \u0456 \u0442\u0440\u0430\u043f\u043d\u0430 \u0451\u043d \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u00ab\u0441\u043f\u0440\u0430\u0432\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456\u00bb (\u0406\u0441 32, 17). \u0401\u043d \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u043b\u0451\u043d\u0430\u043c \u043f\u0430\u0440\u0430\u0434\u043a\u0443, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u043c\u0443 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u0442\u0432\u0443 \u044f\u0433\u043e \u0411\u043e\u0441\u043a\u0456\u043c \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c; \u0434\u0437\u0435\u043b\u044f \u044f\u0433\u043e \u0430\u0436\u044b\u0446\u0446\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u043b\u044e\u0434\u0437\u0456, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u0443\u0441\u0451 \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0425\u043e\u0446\u044c \u0430\u0433\u0443\u043b\u044c\u043d\u044b\u043c \u0434\u0430\u0431\u0440\u043e\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u043f\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u043a\u0456\u0440\u0443\u0435 \u043d\u0430\u0439\u043f\u0435\u0440\u0448 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b \u0437\u0430\u043a\u043e\u043d, \u0442\u044b\u043c \u043d\u0435 \u043c\u0435\u043d\u0448, \u0443 \u0441\u0432\u0430\u0456\u0445 \u043a\u0430\u043d\u043a\u0440\u044d\u0442\u043d\u044b\u0445 \u0432\u044b\u044f\u045e\u043b\u0435\u043d\u043d\u044f\u0445 \u044f\u043d\u043e \u0437 \u0446\u044f\u0433\u0430\u043c \u0447\u0430\u0441\u0443 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0437\u043c\u044f\u043d\u044f\u0435\u0446\u0446\u0430, \u0442\u0430\u043c\u0443 \u0441\u043f\u0430\u043a\u043e\u0439 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u0430 \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c. \u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u0432\u043e\u043b\u044f \u0437\u043c\u0435\u043d\u043b\u0456\u0432\u0430\u044f \u0456 \u0437\u0440\u0430\u043d\u0435\u043d\u0430\u044f \u0433\u0440\u0430\u0445\u043e\u043c, \u043a\u043b\u043e\u043f\u0430\u0442 \u043f\u0440\u0430 \u0441\u043f\u0430\u043a\u043e\u0439 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u0433\u0430 \u045e\u0442\u0430\u0439\u043c\u0430\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u044f\u045e, \u0430 \u0430\u0434 \u043f\u0440\u0430\u0432\u0430\u043c\u043e\u0446\u043d\u0430\u0439 \u0443\u043b\u0430\u0434\u044b \u2013 \u043f\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435\u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430. \u0422\u0430\u043a\u043e\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u044e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043d\u0435\u043b\u044c\u0433\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u0430\u043d\u0430 \u0434\u0430\u0431\u0440\u043e \u0430\u0441\u043e\u0431\u044b \u0456 \u043a\u0430\u043b\u0456 \u043b\u044e\u0434\u0437\u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0437 \u0434\u0430\u0432\u0435\u0440\u0430\u043c \u0456 \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0434\u0437\u044f\u043b\u0456\u0446\u0446\u0430 \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u0439 \u0431\u0430\u0433\u0430\u0446\u0446\u044f\u043c\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0440\u043e\u0437\u0443\u043c\u0443 \u0456 \u0434\u0443\u0445\u0443. \u0414\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u043f\u0430\u043a\u043e\u044e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0446\u0432\u0451\u0440\u0434\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u043f\u0430\u0432\u0430\u0436\u0430\u0446\u044c \u0456\u043d\u0448\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u0456\u0445 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0435 \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u043d\u043d\u0435 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u0442\u0432\u0430. \u0422\u0430\u043c\u0443 \u0441\u043f\u0430\u043a\u043e\u0439 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u043b\u0451\u043d\u0430\u043c \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0430\u044f \u0437\u043d\u0430\u0447\u043d\u0430 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u043e\u0436\u0430 \u0434\u0430\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u044f\u043c\u043d\u044b \u0441\u043f\u0430\u043a\u043e\u0439, \u044f\u043a\u0456 \u045e\u0437\u043d\u0456\u043a\u0430\u0435 \u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u2013 \u0433\u044d\u0442\u0430 \u0432\u043e\u0431\u0440\u0430\u0437 \u0456 \u0432\u044b\u043d\u0456\u043a \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u044e, \u044f\u043a\u0456 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430. \u0421\u0430\u043c \u0443\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0421\u044b\u043d, \u041a\u043d\u044f\u0437\u044c \u0441\u043f\u0430\u043a\u043e\u044e, \u043f\u0440\u0430\u0437 \u0441\u0432\u043e\u0439 \u043a\u0440\u044b\u0436 \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u045e \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0437 \u0411\u043e\u0433\u0430\u043c, \u0430 \u0432\u044f\u0440\u0442\u0430\u044e\u0447\u044b \u045e\u0441\u0456\u043c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0443 \u0430\u0434\u043d\u044b\u043c \u041d\u0430\u0440\u043e\u0434\u0437\u0435 \u0456 \u045e \u0430\u0434\u043d\u044b\u043c \u0426\u0435\u043b\u0435, \u0437\u0430\u0431\u0456\u045e \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0443 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u0456, \u0443\u0437\u0432\u044b\u0448\u0430\u043d\u044b \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435, \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u0414\u0443\u0445\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u0441\u044d\u0440\u0446\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0434\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u044b \u0437\u0430\u043a\u043b\u0456\u043a, \u043a\u0430\u0431 \u00ab\u0440\u043e\u0431\u044f\u0447\u044b \u043f\u0440\u0430\u045e\u0434\u0443 \u045e \u043b\u044e\u0431\u043e\u0432\u0456\u00bb (\u042d\u0444 4, 15), \u044f\u043d\u044b \u044f\u0434\u043d\u0430\u043b\u0456\u0441\u044f \u0437 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043c\u0456\u0440\u043d\u0430 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u044b\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u043a\u0430\u0431 \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445 \u0432\u044b\u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0456 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0441\u043f\u0430\u043a\u043e\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0437\u0440\u0443\u0448\u0430\u043d\u044b\u044f \u0442\u044b\u043c \u0436\u0430 \u0434\u0443\u0445\u0430\u043c, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434 \u0433\u0432\u0430\u043b\u0442\u0443 \u043f\u0440\u044b \u0430\u0434\u0441\u0442\u043e\u0439\u0432\u0430\u043d\u043d\u0456 \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u0430\u0432\u043e\u045e \u0456 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u043a\u0456\u0445 \u0441\u0440\u043e\u0434\u043a\u0430\u045e \u0430\u0431\u0430\u0440\u043e\u043d\u044b, \u044f\u043a\u0456\u044f \u0434\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u044f \u043d\u0430\u0432\u0430\u0442 \u0441\u043b\u0430\u0431\u0435\u0439\u0448\u044b\u043c, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u0431\u0435\u0437 \u043f\u0430\u0440\u0443\u0448\u044d\u043d\u043d\u044f \u043f\u0440\u0430\u0432\u043e\u045e \u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u045e \u0456\u043d\u0448\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0446\u0456 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u0442\u0432\u0430.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. 1 \u041a\u0440 29, 11. 12; \u043f\u0430\u0440. \u0421\u0456\u0440 50, 25; 2 \u041c\u0430\u043a 1, 24\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0422\u0432\u0430\u044f, \u041f\u0430\u043d\u0435, \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0422\u044b \u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u043f\u0430\u043d\u0443\u0435\u0448. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0410\u0434\u0430\u0440\u044b \u0441\u043f\u0430\u043a\u043e\u0435\u043c, \u041f\u0430\u043d\u0435, \u0434\u043d\u0456 \u043d\u0430\u0448\u044b\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u0433\u0440\u043e\u0437\u043d\u044b \u0456 \u043c\u043e\u0446\u043d\u044b, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u0434\u0430\u0440\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"312","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u043c \u0441\u0432\u0435\u0446\u0435&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00abGaudium et spes\u00bb \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(N. 82-83)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0430\u043f\u0430\u045e\u043d\u044f\u0446\u044c \u0440\u043e\u0437\u0443\u043c\u044b \u0434\u0443\u0445\u0430\u043c \u043c\u0456\u0440\u043d\u0430\u0433\u0430 \u0441\u043f\u043e\u0441\u0430\u0431\u0443 \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u044f&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u043b\u044e\u0434\u0437\u0456 \u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445 \u0430\u0441\u043e\u0431. \u041d\u044f\u0445\u0430\u0439 \u0434\u0431\u0430\u044e\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430 \u045e\u043b\u0430\u0441\u043d\u044b \u045e\u0434\u0437\u0435\u043b. \u0411\u043e \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a\u0456\u043c \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0435 \u0434\u0430\u0431\u0440\u043e \u0456\u0445\u043d\u044f\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0441\u043f\u0440\u044b\u044f\u043d\u043d\u0435 \u0434\u0430\u0431\u0440\u0443 \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443, \u0432\u0435\u043b\u044c\u043c\u0456 \u0437\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0430\u0434 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u0445 \u043f\u043e\u0433\u043b\u044f\u0434\u0430\u045e \u0456 \u043d\u0430\u0441\u0442\u0440\u043e\u044f\u045e \u0448\u044b\u0440\u043e\u043a\u0456\u0445 \u043c\u0430\u0441 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u0442\u0432\u0430. \u0406\u0445 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u045e \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u0456 \u0441\u043f\u0430\u043a\u043e\u044e \u0431\u0443\u0434\u0443\u0446\u044c \u0434\u0430\u0440\u044d\u043c\u043d\u044b\u044f, \u043f\u0430\u043a\u0443\u043b\u044c \u0432\u0430\u0440\u043e\u0436\u0430\u0441\u0446\u044c, \u043f\u0430\u0447\u0443\u0446\u0446\u0451 \u043f\u0430\u0433\u0430\u0440\u0434\u044b \u0456 \u043d\u0435\u0434\u0430\u0432\u0435\u0440\u0443, \u00ab\u0440\u0430\u0441\u0430\u0432\u0430\u044f\u00bb \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0456 \u0437\u0430\u045e\u0437\u044f\u0442\u044b\u044f \u0456\u0434\u044d\u0430\u043b\u043e\u0433\u0456\u0456 \u043f\u0430\u0434\u0437\u044f\u043b\u044f\u044e\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0456\u0445. \u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u043f\u0456\u043b\u044c\u043d\u0430\u044f \u043f\u0430\u0442\u0440\u044d\u0431\u0430 \u045e \u0430\u0431\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0456\u043d\u0442\u044d\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0456 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u043d\u043e\u0432\u0430\u0433\u0430 \u0434\u0443\u0445\u0443 \u045e \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u043a\u0430\u0439 \u0434\u0443\u043c\u0446\u044b. \u0422\u044b\u044f, \u0445\u0442\u043e \u0437\u0430\u0439\u043c\u0430\u0435\u0446\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u0430\u0439 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043c\u043e\u043b\u0430\u0434\u0437\u0456, \u0446\u0456 \u0444\u0430\u0440\u043c\u0456\u0440\u0443\u0435 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u043a\u0443\u044e \u0434\u0443\u043c\u043a\u0443, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043b\u0456\u0447\u044b\u0446\u044c \u0441\u0432\u0430\u0456\u043c \u043f\u0435\u0440\u0448\u044b\u043c \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u043c \u043a\u043b\u043e\u043f\u0430\u0442 \u043f\u0440\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0446\u044c \u0440\u043e\u0437\u0443\u043c\u044b \u045e\u0441\u0456\u0445 \u0434\u0443\u0445\u0430\u043c \u043d\u043e\u0432\u0430\u0433\u0430, \u043c\u0456\u0440\u043d\u0430\u0433\u0430 \u0441\u043f\u043e\u0441\u0430\u0431\u0443 \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u044f. \u041a\u043e\u0436\u043d\u044b \u0437 \u043d\u0430\u0441, \u043c\u0430\u044e\u0447\u044b \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0456 \u0437\u0430\u0434\u0430\u043d\u043d\u0456, \u044f\u043a\u0456\u044f \u043c\u043e\u0436\u0430\u043c \u0440\u0430\u0437\u0430\u043c \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u043b\u0430\u0441\u044f \u0441\u0451\u043d\u043d\u044f \u0434\u0430 \u043b\u0435\u043f\u0448\u0430\u0433\u0430, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0437\u043c\u044f\u043d\u0456\u0446\u044c \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u0441 \u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0432\u0430\u0435 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430\u044f \u043d\u0430\u0434\u0437\u0435\u044f. \u041a\u0430\u043b\u0456 \u043f\u0430\u0441\u043b\u044f \u0432\u044b\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u043f\u0440\u0430\u0431\u043b\u0435\u043c\u044b \u0432\u0430\u0440\u043e\u0436\u0430\u0441\u0446\u0456 \u0456 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u0456 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u044b \u0433\u043e\u0434\u043d\u044b\u044f \u0456 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044b\u044f \u0434\u0430\u043c\u043e\u0432\u044b \u043d\u0430\u043a\u043e\u043d\u0442 \u0443\u043d\u0456\u0432\u0435\u0440\u0441\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u044e, \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u045e\u0436\u043e \u0441\u0451\u043d\u043d\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0441\u0443\u0440\u2019\u0451\u0437\u043d\u0430\u0439 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b, \u0445\u043e\u0446\u044c \u0456 \u043c\u0430\u0435 \u0437\u043d\u0430\u0447\u043d\u044b\u044f \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u0456 \u045e \u043d\u0430\u0432\u0443\u0446\u044b, \u043c\u043e\u0436\u0430 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u0446\u0446\u0430 \u0434\u0430 \u0442\u043e\u0439 \u0437\u0433\u0443\u0431\u043d\u0430\u0439 \u0447\u0430\u0441\u0456\u043d\u044b, \u043a\u0430\u043b\u0456 \u044f\u043c\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0437\u0432\u0435\u0434\u0430\u0446\u044c \u0456\u043d\u0448\u0430\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u044e, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0436\u0443\u0434\u0430\u0441\u043d\u0430\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u044e \u0441\u043c\u0435\u0440\u0446\u0456. \u041d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0433\u044d\u0442\u0430, \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0441\u0430\u043c\u044b\u043c \u0446\u044d\u043d\u0442\u0440\u044b \u0442\u0440\u044b\u0432\u043e\u0433 \u0433\u044d\u0442\u0430\u0433\u0430 \u0447\u0430\u0441\u0443, \u043a\u0430\u0436\u0443\u0447\u044b \u043f\u0440\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430, \u0443 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0435 \u0446\u0432\u0451\u0440\u0434\u0430 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u0456 \u043f\u0430\u0441\u043b\u044f\u0434\u043e\u045e\u043d\u0430, \u0443 \u0437\u0440\u0443\u0447\u043d\u044b \u0456 \u043d\u044f\u0437\u0440\u0443\u0447\u043d\u044b \u0447\u0430\u0441, \u0441\u043f\u0440\u0430\u0431\u0443\u0435 \u0434\u0430\u043d\u0435\u0441\u0446\u0456 \u0434\u0430 \u0441\u0443\u0447\u0430\u0441\u043d\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456 \u0437\u0430\u043a\u043b\u0456\u043a: \u00ab\u0412\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440 \u0437\u0440\u0443\u0447\u043d\u044b \u0447\u0430\u0441\u00bb, \u043a\u0430\u0431 \u0437\u043c\u044f\u043d\u0456\u0446\u044c \u0441\u044d\u0440\u0446\u0430, \u00ab\u0432\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440 \u0447\u0430\u0441 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u043b\u044f \u045e\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u043d\u043d\u044f \u0441\u043f\u0430\u043a\u043e\u044e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u043f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451 \u0432\u044b\u043a\u0430\u0440\u0430\u043d\u0456\u0446\u044c \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u044f\u0437\u0433\u043e\u0434\u044b \u043f\u0430\u043c\u0456\u0436 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u044f\u043a\u0456\u044f \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u0432\u043e\u0439\u043d\u0430\u045e, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043f\u0440\u0430\u044f\u0432\u044b \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0428\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0437 \u0456\u0445 \u0432\u044b\u043d\u0456\u043a\u0430\u044e\u0446\u044c \u0437 \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430\u0439 \u044d\u043a\u0430\u043d\u0430\u043c\u0456\u0447\u043d\u0430\u0439 \u043d\u044f\u0440\u043e\u045e\u043d\u0430\u0441\u0446\u0456 \u0456 \u0437 \u0437\u0430\u043f\u043e\u0437\u043d\u0435\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u043c\u044f\u043d\u0435\u043d\u043d\u044f \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u0445 \u0441\u0440\u043e\u0434\u043a\u0430\u045e. \u0406\u043d\u0448\u044b\u044f \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u045e\u0437\u043d\u0456\u043a\u0430\u044e\u0446\u044c \u0437 \u0434\u0443\u0445\u0443 \u0434\u0430\u043c\u0456\u043d\u0430\u0432\u0430\u043d\u043d\u044f, \u0437 \u043f\u0430\u0433\u0430\u0440\u0434\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0430 \u043a\u0430\u043b\u0456 \u043c\u044b \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u043c \u043d\u0430 \u0433\u043b\u044b\u0431\u0435\u0439\u0448\u044b\u044f \u043f\u0440\u044b\u0447\u044b\u043d\u044b, \u0442\u043e \u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456, \u043d\u0435\u0434\u0430\u0432\u0435\u0440\u0443, \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0456 \u0456\u043d\u0448\u044b\u0445 \u044d\u0433\u0430\u0456\u0441\u0442\u044b\u0447\u043d\u044b\u0445 \u043c\u0430\u0442\u044b\u0432\u0430\u045e. \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043c\u043e\u0436\u0430 \u0432\u044b\u043d\u0435\u0441\u0446\u0456 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0430\u045e \u043f\u0430\u0440\u0430\u0434\u043a\u0443, \u0442\u0430\u043c\u0443 \u0441\u0432\u0435\u0442 \u0430\u0442\u0440\u0443\u0447\u0432\u0430\u044e\u0446\u044c \u0441\u043f\u0440\u044d\u0447\u043a\u0456 \u043f\u0430\u043c\u0456\u0436 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u0456 \u043d\u0430\u0441\u0456\u043b\u043b\u0435 \u043d\u0430\u0432\u0430\u0442 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043b\u044e\u0442\u0443\u0435 \u0432\u0430\u0439\u043d\u0430. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043a\u0456\u044f \u0436 \u043f\u0440\u0430\u044f\u0432\u044b \u0437\u043b\u0430 \u043d\u0430\u0437\u0456\u0440\u0430\u044e\u0446\u0446\u0430 \u045e \u0430\u0434\u043d\u043e\u0441\u0456\u043d\u0430\u0445 \u043f\u0430\u043c\u0456\u0436 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456, \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430, \u043a\u0430\u0431 \u0434\u043b\u044f \u0456\u0445 \u043f\u0435\u0440\u0430\u0430\u0434\u043e\u043b\u0435\u043d\u043d\u044f \u0446\u0456 \u043f\u0440\u0430\u0434\u0443\u0445\u0456\u043b\u0435\u043d\u043d\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043b\u044f \u0441\u043f\u044b\u043d\u0435\u043d\u043d\u044f \u043d\u0435\u045e\u0442\u0430\u0439\u043c\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u043d\u0430\u0441\u0456\u043b\u043b\u044f \u045e\u0441\u0451 \u043b\u0435\u043f\u0448 \u0456 \u0431\u043e\u043b\u044c\u0448 \u0446\u0435\u0441\u043d\u0430 \u045e\u0437\u0430\u0435\u043c\u0430\u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u043b\u0456 \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u0439 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430 \u0441\u043a\u0430\u0430\u0440\u0434\u044b\u043d\u0430\u0432\u0430\u043d\u044b\u044f \u043c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u044f \u0456\u043d\u0441\u0442\u044b\u0442\u0443\u0442\u044b. \u0422\u0440\u044d\u0431\u0430 \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430 \u0441\u0442\u044b\u043c\u0443\u043b\u044f\u0432\u0430\u0446\u044c \u0443\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0430\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u044b\u0439, \u044f\u043a\u0456\u044f \u0431 \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u0435 \u0441\u043f\u0430\u043a\u043e\u044e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0421\u0456\u0440 23, 2; \u043f\u0430\u0440. \u0406\u0441 49, 8; 37, 35; \u041f\u0441 122 (121), 7. 34. 15\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u0443\u0447\u044d\u043d\u043d\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u044f \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044e \u043b\u044f \u0441\u044d\u0440\u0446\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u042f \u043f\u0430\u0447\u0443\u045e \u0446\u044f\u0431\u0435 \u0456 \u0430\u0442\u0430\u0447\u044b\u045e \u0430\u043f\u0435\u043a\u0430\u044e \u0442\u0432\u043e\u0439 \u0433\u043e\u0440\u0430\u0434, \u043d\u044f\u0445\u0430\u0439 \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0442\u0432\u0430\u0435 \u0434\u043d\u0456.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410\u0434\u0432\u044f\u0440\u043d\u0456\u0441\u044f \u0430\u0434 \u0437\u043b\u0430 \u0456 \u0440\u0430\u0431\u0456 \u0434\u0430\u0431\u0440\u043e, \u0448\u0443\u043a\u0430\u0439 \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0442\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u044f\u0433\u043e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u042f \u043f\u0430\u0447\u0443\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"313","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u043c \u0441\u0432\u0435\u0446\u0435&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00abGaudium et spes\u00bb \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(N. 88-90)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0441\u043f\u0430\u043a\u043e\u044e&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0456 \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u0447\u0430\u044e\u0446\u044c \u0443 \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0435 \u043c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u043f\u0430\u0440\u0430\u0434\u043a\u0443, \u0443 \u044f\u043a\u0456\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456\u0441\u044f \u0431, \u0437\u0430\u043a\u043e\u043d\u043d\u044b\u044f \u0441\u0432\u0430\u0431\u043e\u0434\u044b \u0456 \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u043a\u0430\u0435 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u0442\u0432\u0430 \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u045e\u0441\u0456\u0445, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0448\u0442\u043e \u0437\u043d\u0430\u0447\u043d\u0430\u044f \u0447\u0430\u0441\u0442\u043a\u0430 \u0441\u0432\u0435\u0442\u0443 \u044f\u0448\u0447\u044d \u043f\u0430\u043a\u0443\u0442\u0443\u0435 \u043d\u0430 \u0442\u0430\u043a\u0443\u044e \u0433\u0430\u043b\u0435\u0447\u0443, \u0448\u0442\u043e \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u0430 \u045e\u0431\u043e\u0433\u0456\u0445 \u044f\u043a \u0431\u044b \u0433\u0443\u0447\u043d\u0430 \u043a\u043b\u0456\u0447\u0430 \u0434\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u0434\u043b\u044f \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u0435\u043d\u043d\u044f \u043b\u044e\u0434\u0437\u0435\u0439 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u043d\u0430\u0440\u043e\u0434\u044b, \u0443 \u044f\u043a\u0456\u0445 \u0447\u0430\u0441\u0442\u0430 \u0431\u043e\u043b\u044c\u0448\u0430\u0441\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0456\u043c\u0435\u043c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430, \u043c\u0430\u044e\u0446\u044c \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u0437\u0432\u044b\u0448 \u043c\u0435\u0440\u044b, \u0443 \u0442\u043e\u0439 \u0447\u0430\u0441 \u044f\u043a \u0456\u043d\u0448\u044b\u043c \u043d\u0435\u0441\u0442\u0430\u0435 \u0441\u0430\u043c\u0430\u0433\u0430 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0433\u0430 \u0434\u043b\u044f \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u0456\u044f \u0446\u0435\u0440\u043f\u044f\u0446\u044c \u0433\u043e\u043b\u0430\u0434, \u0445\u0432\u0430\u0440\u043e\u0431\u044b \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u043d\u044f\u0434\u043e\u043b\u044e. \u0411\u043e \u0441\u043b\u0430\u0432\u0430\u0439 \u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0443\u0445 \u0443\u0431\u043e\u0441\u0442\u0432\u0430 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0442\u044b\u0445 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043c\u0430\u043b\u0430\u0434\u044b\u0445, \u044f\u043a\u0456\u044f \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0456 \u0430\u0445\u0432\u044f\u0440\u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u044e\u0446\u044c \u0456\u043d\u0448\u044b\u043c \u043b\u044e\u0434\u0437\u044f\u043c \u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0443\u0441\u044f\u0433\u043e \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 (\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0441\u043b\u043e\u0432\u0430\u043c \u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0456\u043c \u0443 \u0433\u044d\u0442\u044b\u043c) \u2013 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0456\u0445 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044f\u045e \u043f\u0430\u043b\u0451\u0433\u043a\u0443 \u0442\u044b\u043c, \u0445\u0442\u043e \u045e \u043d\u0430\u0448 \u0447\u0430\u0441 \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u043d\u044f\u0434\u043e\u043b\u044e, \u0440\u043e\u0431\u044f\u0447\u044b \u0433\u044d\u0442\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u045e\u0434\u043e\u0441\u0442\u0430\u043b\u044c, \u0430 \u043d\u0430\u0432\u0430\u0442, \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u0442\u0430\u0440\u044b\u043c \u0437\u0432\u044b\u0447\u0430\u0435\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0437 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u043e\u0446\u044c \u0437\u0431\u043e\u0440 \u0456 \u0440\u0430\u0437\u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0435 \u0434\u0430\u0440\u043e\u045e \u043d\u0435\u043b\u044c\u0433\u0430 \u0436\u043e\u0440\u0441\u0442\u043a\u0430 \u045e\u043d\u0456\u0444\u0456\u043a\u0430\u0432\u0430\u0446\u044c, \u0430\u0434\u043d\u0430\u043a \u0443 \u0434\u044b\u044f\u0446\u044d\u0437\u0456\u044f\u0445, \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0433\u044d\u0442\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0430\u0434\u0431\u044b\u0432\u0430\u0446\u0446\u0430 \u045e \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u043c \u043f\u0430\u0440\u0430\u0434\u043a\u0443. \u0414\u0437\u0435 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430, \u043a\u0430\u0442\u043e\u043b\u0456\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0431\u2019\u044f\u0434\u043d\u0430\u0446\u0446\u0430 \u045e \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0437 \u0456\u043d\u0448\u044b\u043c\u0456 \u0431\u0440\u0430\u0442\u0430\u043c\u0456-\u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456. \u0411\u043e \u0434\u0443\u0445 \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0435, \u0430\u043b\u0435 \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u043a\u0443\u044e \u0456 \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u043d\u0443\u044e \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u044c \u043f\u0440\u0430\u0434\u0431\u0430\u0447\u043b\u0456\u0432\u0430 \u0456 \u043f\u0430\u0441\u043b\u044f\u0434\u043e\u045e\u043d\u0430. \u0422\u0430\u043c\u0443 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u043f\u0440\u0430\u0437 \u043d\u0430\u043b\u0435\u0436\u043d\u0430\u0435 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435 \u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044e \u0440\u0430\u0437\u0432\u0456\u0446\u0446\u0451\u0432\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u043e\u0432\u0430 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043a\u0430\u0431 \u043f\u0430\u0448\u044b\u0440\u0430\u0446\u044c \u0456 \u0430\u0431\u0443\u0434\u0436\u0430\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u0446\u0442\u0432\u0430 \u043f\u0430\u043c\u0456\u0436 \u043b\u044e\u0434\u0437\u044c\u043c\u0456. \u0401\u043d \u0440\u043e\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u044f\u043a \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0435 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u043a\u0456\u044f \u0456\u043d\u0441\u0442\u044b\u0442\u0443\u0442\u044b, \u0442\u0430\u043a \u0456 \u043f\u0440\u0430\u0437 \u043f\u043e\u045e\u043d\u0430\u0435 \u0456 \u0448\u0447\u044b\u0440\u0430\u0435 \u0430\u0431\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e \u0443\u0441\u0456\u0445 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e, \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u0430\u0435 \u0430\u0434\u043d\u044b\u043c \u0442\u043e\u043b\u044c\u043a\u0456 \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430\u0433\u0430 \u043c\u043e\u0436\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u044d\u0444\u0435\u043a\u0442\u044b\u045e\u043d\u0435\u0439 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c, \u043a\u0430\u043b\u0456 \u0441\u0430\u043c\u0456 \u0432\u0435\u0440\u043d\u0456\u043a\u0456, \u0443\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u044e\u0447\u044b \u0441\u0432\u0430\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0443\u044e \u0430\u0434\u043a\u0430\u0437\u043d\u0430\u0441\u0446\u044c, \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0442\u0430\u0440\u0430\u0446\u0446\u0430 \u0430\u0431\u0443\u0434\u0436\u0430\u0446\u044c \u0443 \u0441\u0432\u0430\u0456\u043c \u0443\u043b\u0430\u0441\u043d\u044b\u043c \u0430\u043a\u0440\u0443\u0436\u044d\u043d\u043d\u0456 \u0432\u043e\u043b\u044e \u0434\u0430 \u0430\u0445\u0432\u043e\u0442\u043d\u0430\u0433\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u0446\u0442\u0432\u0430 \u0437 \u043c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044e. \u0410\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0448\u043c\u0430\u0442 \u043a\u043b\u043e\u043f\u0430\u0442\u0443 \u045e \u0433\u044d\u0442\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u043d\u0430\u043b\u0435\u0436\u043d\u0430\u043c\u0443 \u0444\u0430\u0440\u043c\u0456\u0440\u0430\u0432\u0430\u043d\u043d\u044e \u043c\u043e\u043b\u0430\u0434\u0437\u0456 \u044f\u043a \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0440\u044d\u043b\u0456\u0433\u0456\u0439\u043d\u0430\u0433\u0430, \u0442\u0430\u043a \u0456 \u0433\u0440\u0430\u043c\u0430\u0434\u0437\u044f\u043d\u0441\u043a\u0430\u0433\u0430 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0440\u044d\u0448\u0446\u0435, \u043f\u0430\u0436\u0430\u0434\u0430\u043d\u0430, \u043a\u0430\u0431 \u043a\u0430\u0442\u043e\u043b\u0456\u043a\u0456 \u0437 \u043c\u044d\u0442\u0430\u0439 \u043d\u0430\u043b\u0435\u0436\u043d\u0430\u0433\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u0456\u0445 \u0437\u0430\u0434\u0430\u0447 \u0443 \u043c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0456\u043c\u043a\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u0430\u043a\u0442\u044b\u045e\u043d\u0430\u0433\u0430 \u0456 \u0441\u0442\u0430\u043d\u043e\u045e\u0447\u0430\u0433\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u0446\u0442\u0432\u0430 \u0437 \u0430\u0434\u043b\u0443\u0447\u0430\u043d\u044b\u043c\u0456 \u0431\u0440\u0430\u0442\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0432\u044b\u0437\u043d\u0430\u044e\u0446\u044c \u043f\u0440\u044b\u043d\u0446\u044b\u043f\u044b \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456 \u0456 \u0437 \u0443\u0441\u0456\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u044f\u043a\u0456\u044f \u0448\u0447\u044b\u0440\u0430 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0441\u043f\u0430\u043a\u043e\u044e.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0410\u0431\u043a 3, 3 (Vlg); \u041b\u0435\u0432 26, 1b. 9&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u043e\u0441\u044c \u043f\u0440\u044b\u0445\u043e\u0434\u0436\u0443 \u0437 \u0422\u044d\u043c\u0430\u043d\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u042f, \u041f\u0430\u043d \u0411\u043e\u0433 \u0432\u0430\u0448, \u0430\u0434\u0430\u0440\u0443 \u0432\u0430\u0441 \u0441\u043f\u0430\u043a\u043e\u0435\u043c.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u043f\u0430\u0432\u044f\u0440\u043d\u0443\u0441\u044f \u0434\u0430 \u0432\u0430\u0441, \u0443\u0447\u044b\u043d\u044e \u0432\u0430\u0441 \u043f\u043b\u043e\u0434\u043d\u044b\u043c\u0456 \u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u0443 \u0432\u0430\u0441, \u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u044e \u041c\u043e\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u0432\u0430\u043c\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u042f, \u041f\u0430\u043d.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"314","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0442\u044d\u0445\u0435\u0437\u0430\u00bb \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cat. 5, De fide et symbolo, 10-11: PG 33, 518-519)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u0435\u0440\u0430 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u0441\u0456\u043b\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043b\u043e\u0432\u0430 \u0432\u0435\u0440\u0430 \u2013 \u0430\u0434\u043d\u043e, \u0430\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u043c\u0435\u0441\u0442\u0443 \u043c\u0430\u0435 \u0434\u0432\u0430 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0456. \u041f\u0435\u0440\u0448\u044b \u0432\u0456\u0434 \u0432\u0435\u0440\u044b \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0434\u0430\u0433\u043c\u0430\u0442\u0443 \u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u0456 \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u043a\u0430\u043d\u043a\u0440\u044d\u0442\u043d\u0430\u0439 \u043f\u0440\u0430\u045e\u0434\u044b. \u0422\u0430\u043a\u0430\u044f \u0432\u0435\u0440\u0430 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0434\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u041f\u0430\u043d\u0430: \u00ab\u0425\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u0435 \u041c\u0430\u0451 \u0441\u043b\u043e\u0432\u0430 \u0456 \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435, \u043c\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435 \u0456 \u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0441\u0443\u0434\u00bb (\u042f\u043d 5, 24) \u0456 \u044f\u0448\u0447\u044d: \u00ab\u0425\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0421\u044b\u043d\u0430, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b, \u0430\u043b\u0435 \u043f\u044f\u0440\u043e\u0439\u0434\u0437\u0435 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f\u00bb (\u043f\u0430\u0440. \u042f\u043d 3, 18).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a\u0430\u044f \u0436 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0433\u0430 \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439! \u041f\u0440\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0456 \u0421\u0442\u0430\u0440\u043e\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0456\u0441\u044f \u0411\u043e\u0433\u0443 \u043f\u0430\u0441\u043b\u044f \u043c\u043d\u043e\u0433\u0456\u0445 \u0433\u0430\u0434\u043e\u045e \u043f\u0440\u0430\u0446\u044b. \u0410 \u0442\u0430\u0431\u0435 \u0415\u0437\u0443\u0441 \u0437\u0430 \u0430\u0434\u043d\u0443 \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u0434\u0430\u0435 \u045e\u0441\u0451, \u0448\u0442\u043e \u0442\u044b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043f\u0430\u0441\u043b\u044f \u043c\u043d\u043e\u0433\u0456\u0445 \u0433\u0430\u0434\u043e\u045e \u0432\u0435\u0440\u043d\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f. \u041a\u0430\u043b\u0456 \u0442\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u0448, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041f\u0430\u043d\u0430\u043c, \u043a\u0430\u043b\u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u0448, \u0448\u0442\u043e \u0411\u043e\u0433 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e, \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0430 \u045e \u0440\u0430\u0456 \u0446\u044f\u0431\u0435 \u043f\u0440\u044b\u043c\u0435 \u0442\u043e\u0439, \u044f\u043a\u0456 \u045e\u0432\u0451\u045e \u0442\u0443\u0434\u044b \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u0430\u0433\u0430 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0443. \u041d\u0435 \u0434\u0443\u043c\u0430\u0439, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430. \u0422\u043e\u0439, \u0445\u0442\u043e \u043d\u0430 \u0441\u0432\u044f\u0442\u043e\u0439 \u0413\u0430\u043b\u0433\u043e\u0446\u0435 \u0437\u0431\u0430\u0432\u0456\u045e \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0443, \u044f\u043a\u0456 \u0432\u0435\u0440\u044b\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u0430\u0434\u0437\u0456\u043d\u0443, \u0437\u043c\u043e\u0436\u0430 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0446\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u0442\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u0448.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406\u0441\u043d\u0443\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0440\u0443\u0433\u0456 \u0432\u0456\u0434 \u0432\u0435\u0440\u044b, \u044f\u043a\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u044b\u043c \u0434\u0430\u0440\u0430\u043c, \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u00ab\u0410\u0434\u043d\u0430\u043c\u0443 \u0434\u0430\u0435\u0446\u0446\u0430 \u0414\u0443\u0445\u0430\u043c \u0441\u043b\u043e\u0432\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0434\u0440\u0443\u0433\u043e\u043c\u0443 \u2013 \u0441\u043b\u043e\u0432\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0442\u0430\u0433\u043e \u0441\u0430\u043c\u0430\u0433\u0430 \u0414\u0443\u0445\u0430; \u0456\u043d\u0448\u0430\u043c\u0443 \u2013 \u0432\u0435\u0440\u0430 \u045e \u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u0414\u0443\u0445\u0443; \u0456\u043d\u0448\u0430\u043c\u0443 \u2013 \u0434\u0430\u0440 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e \u0442\u044b\u043c \u0436\u0430 \u0414\u0443\u0445\u0443\u00bb (1 \u041a\u0430\u0440 12, 8-9).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u044b\u043a \u0432\u043e\u0441\u044c, \u0442\u0430\u044f \u0432\u0435\u0440\u0430, \u044f\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u044f\u043a \u0434\u0430\u0440, \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0433\u043c\u0430\u0442\u0430\u045e, \u0430\u043b\u0435 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0443\u044e \u0436 \u0432\u0435\u0440\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u0441\u043f\u0440\u0430\u0432\u044b, \u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u044f\u0433\u043e \u0441\u0456\u043b\u044b. \u0422\u043e\u0439, \u0445\u0442\u043e \u043c\u0430\u0435 \u0442\u0430\u043a\u0443\u044e \u0432\u0435\u0440\u0443, \u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0433\u0430\u0440\u044b: \u00ab\u041f\u0435\u0440\u0430\u0441\u0443\u043d\u044c\u0441\u044f \u0430\u0434\u0441\u044e\u043b\u044c \u0441\u044e\u0434\u044b, \u0456 \u044f\u043d\u0430 \u043f\u0435\u0440\u0430\u0441\u0443\u043d\u0435\u0446\u0446\u0430\u00bb (\u043f\u0430\u0440. \u041c\u0446 17, 20). \u0425\u0442\u043e \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u0442\u0430\u043a\u043e\u0439 \u0432\u0435\u0440\u044b \u0441\u043a\u0430\u0436\u0430 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0435\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u0442\u0430\u043a \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b, \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u043b\u0430\u0441\u043a\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430 \u0442\u0430\u043a\u0443\u044e \u0432\u0435\u0440\u0443 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u041a\u0430\u043b\u0456 \u045e \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u0432\u0435\u0440\u0430 \u0437 \u0433\u0430\u0440\u0447\u044b\u0447\u043d\u0430\u0435 \u0437\u0435\u0440\u043d\u0435\u00bb (\u043f\u0430\u0440. \u041c\u0446 17, 20). \u0413\u0430\u0440\u0447\u044b\u0447\u043d\u0430\u0435 \u0437\u0435\u0440\u043d\u0435 \u0432\u0435\u043b\u044c\u043c\u0456 \u043c\u0430\u043b\u043e\u0435, \u0430\u043b\u0435 \u043c\u0430\u0435 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0443\u044e \u043c\u043e\u0446. \u041f\u0430\u0441\u0435\u044f\u043d\u0430\u0435 \u045e \u044f\u043a\u0456\u043c-\u043d\u0435\u0431\u0443\u0434\u0437\u044c, \u0445\u043e\u0446\u044c \u0431\u044b \u0441\u0430\u043c\u044b\u043c \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u043f\u0443\u0441\u043a\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0433\u0430\u043b\u0456\u043d\u044b, \u0456 \u043a\u0430\u043b\u0456 \u0432\u044b\u0440\u0430\u0441\u0446\u0435, \u0434\u0430\u0435 \u0446\u0435\u043d\u044c \u043d\u0430\u0432\u0430\u0442 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u043f\u0442\u0443\u0448\u043a\u0430\u043c. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0432\u0435\u0440\u0430 \u0437\u0430 \u0432\u0435\u043b\u044c\u043c\u0456 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u045e \u0434\u0443\u0448\u044b \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b. \u0414\u0443\u0448\u0430, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430\u044f \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0432\u0435\u0440\u044b, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435 \u043f\u0440\u0430 \u0411\u043e\u0433\u0430 \u0456, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u0441\u0443\u0437\u0456\u0440\u0430\u0435 \u0411\u043e\u0433\u0430. \u0410\u0431\u043b\u044f\u0442\u0430\u0435 \u0437\u044f\u043c\u043b\u044e \u0430\u0434 \u043a\u0440\u0430\u044e \u0434\u0430 \u043a\u0440\u0430\u044e \u0456 \u043d\u0430\u043f\u0440\u044b\u043a\u0430\u043d\u0446\u044b \u0447\u0430\u0441\u043e\u045e \u0431\u0430\u0447\u044b\u0446\u044c \u0443\u0436\u043e \u0441\u0443\u0434 \u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043c\u0430\u0439 \u0442\u0430\u043a\u0443\u044e \u0432\u0435\u0440\u0443, \u044f\u043a\u0430\u044f \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434 \u0446\u044f\u0431\u0435 \u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0430\u0434 \u042f\u0433\u043e \u0442\u044b \u043c\u043e\u0433 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u044f\u0435 \u0442\u0430\u043a\u043e\u0439, \u044f\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u0441\u0456\u043b\u044b.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0413\u0430\u043b 2, 16; \u0420\u044b\u043c 3, 25\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u044e \u0417\u0430\u043a\u043e\u043d\u0443, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043c\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u0431 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f\u0433\u043e \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0411\u043e\u0433 \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u045e \u042f\u0433\u043e\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041c\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"315","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0442\u044d\u0445\u0435\u0437\u0430\u00bb \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cat. 5, De fide et symbolo, 12-13: PG 33, 519-523)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u0456\u043c\u0432\u0430\u043b \u0432\u0435\u0440\u044b<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456 \u0456 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0456 \u0432\u0435\u0440\u044b \u043f\u0440\u044b\u043c\u0456 \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u0439 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u043f\u0435\u0440\u0430\u0434\u0430\u0435 \u0442\u0430\u0431\u0435 \u041a\u0430\u0441\u0446\u0451\u043b \u0456 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u045e\u0441\u0451 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435. \u0410\u043b\u0435 \u043d\u0435 \u045e\u0441\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0447\u044b\u0442\u0430\u0446\u044c \u041f\u0456\u0441\u0430\u043d\u043d\u0435. \u0410\u0434\u043d\u044b\u043c \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u0430\u0434\u0443\u043a\u0430\u0446\u044b\u0456, \u0434\u0440\u0443\u0433\u0456\u043c \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u044e\u0446\u044c \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u044f \u0437\u0430\u043d\u044f\u0442\u043a\u0456. \u041a\u0430\u0431 \u0443 \u0432\u044b\u043d\u0456\u043a\u0443 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0434\u0443\u0448\u0430 \u043d\u0435 \u0437\u0432\u0435\u0434\u0430\u043b\u0430 \u0448\u043a\u043e\u0434\u044b, \u0443 \u043a\u0430\u0440\u043e\u0442\u043a\u0456\u0445 \u0432\u044b\u0440\u0430\u0437\u0430\u0445 \u0421\u0456\u043c\u0432\u0430\u043b\u0430 \u043c\u044b \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435\u043c \u0443\u0441\u0451 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0432\u0435\u0440\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u042f \u0440\u0430\u044e \u0442\u0430\u0431\u0435 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u044f\u043a \u0432\u0456\u044f\u0442\u044b\u043a \u0433\u044d\u0442\u0443\u044e \u0432\u0435\u0440\u0443 \u043d\u0430 \u045e\u0441\u0451 \u0436\u044b\u0446\u0446\u0451. \u041f\u0430-\u0437\u0430 \u0451\u0439 \u0431\u043e\u043b\u044c\u0448 \u0443\u0436\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0439. \u041d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u0431 \u0441\u0430\u043c, \u0437\u043c\u044f\u043d\u0456\u045e\u0448\u044b \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0435, \u043f\u0430\u0447\u0430\u045e \u043a\u0430\u0437\u0430\u0446\u044c \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0435 \u0437\u0430 \u0442\u043e\u0435, \u0430\u0431 \u0447\u044b\u043c \u044f \u0432\u0443\u0447\u0443 \u0446\u044f\u0431\u0435 \u0441\u0451\u043d\u043d\u044f. \u041d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u0431 \u0432\u0430\u0440\u043e\u0436\u044b \u0430\u043d\u0451\u043b, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u045e\u0441\u044f \u045e \u0430\u043d\u0451\u043b\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u0437\u0432\u0435\u0441\u0446\u0456 \u0446\u044f\u0431\u0435 \u045e \u0437\u043c\u0430\u043d. \u00ab\u041a\u0430\u043b\u0456 \u0431 \u043d\u0430\u0432\u0430\u0442 \u043c\u044b \u0446\u0456 \u0430\u043d\u0451\u043b \u0437 \u043d\u0435\u0431\u0430 \u043f\u0430\u0447\u0430\u043b\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0432\u0430\u043c \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443, \u044f\u043a\u0430\u044f \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0442\u043e\u0439, \u0448\u0442\u043e \u043c\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0432\u0430\u043c, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u043a\u043b\u044f\u0442\u044b!\u00bb (\u0413\u0430\u043b 1, 8).<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0426\u044f\u043f\u0435\u0440 \u0436\u0430, \u0443\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u0441\u043b\u0443\u0445\u0430\u044e\u0447\u044b \u0441\u043b\u043e\u0432\u044b, \u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044f \u0437\u0430\u043f\u043e\u043c\u043d\u0456\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u044b \u0432\u0435\u0440\u044b. \u0423 \u043f\u0440\u044b\u0434\u0430\u0442\u043d\u044b \u0447\u0430\u0441 \u043f\u0430\u0436\u0430\u0434\u0430\u0439 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0456 \u041f\u0456\u0441\u0430\u043d\u043d\u044f, \u0448\u0442\u043e \u0430\u0434\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u0434\u0430 \u043a\u0430\u043d\u043a\u0440\u044d\u0442\u043d\u044b\u0445 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u044d\u043d\u043d\u044f\u045e. \u0421\u0456\u043c\u0432\u0430\u043b \u0432\u0435\u0440\u044b \u043d\u0435 \u0431\u044b\u045e \u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435, \u0437\u043c\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u044f \u0441\u0430\u043c\u044b\u044f \u0432\u0430\u0436\u043d\u044b\u044f \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0456 \u041f\u0456\u0441\u0430\u043d\u043d\u044f, \u0437\u043c\u044f\u0448\u0447\u0430\u0435 \u045e\u0441\u044e \u0434\u0430\u043a\u0442\u0440\u044b\u043d\u0443 \u0432\u0435\u0440\u044b. \u042f\u043a \u0433\u0430\u0440\u0447\u044b\u0447\u043d\u0430\u0435 \u0437\u0435\u0440\u043d\u0435 \u043c\u0430\u0435 \u045e \u0437\u0430\u0440\u043e\u0434\u043a\u0443 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0433\u0430\u043b\u0456\u043d\u044b, \u0442\u0430\u043a \u0456 \u0421\u0456\u043c\u0432\u0430\u043b \u0432\u0435\u0440\u044b \u045e \u043d\u0435\u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u045e\u0441\u0451 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u044f\u043a \u0421\u0442\u0430\u0440\u043e\u0433\u0430, \u0442\u0430\u043a \u0456 \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0441\u0446\u0435\u0440\u0430\u0436\u044b\u0446\u0435\u0441\u044f, \u0431\u0440\u0430\u0442\u044b, \u0456 \u0442\u0440\u044b\u043c\u0430\u0439\u0446\u0435\u0441\u044f \u0432\u0443\u0447\u044d\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u0446\u044f\u043f\u0435\u0440 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0446\u0435, \u0456 \u0437\u0430\u043f\u0456\u0448\u044b\u0446\u0435 \u044f\u0433\u043e \u043d\u0430 \u0441\u043a\u0440\u044b\u0436\u0430\u043b\u044f\u0445 \u0432\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0427\u0443\u0432\u0430\u0439\u0446\u0435 \u0437 \u0443\u0441\u0451\u0439 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044e, \u043a\u0430\u0431 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044c \u0443 \u043c\u043e\u043c\u0430\u043d\u0442 \u0432\u0430\u0448\u0430\u0439 \u043d\u044f\u045e\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0430\u0431\u043e \u043b\u044f\u043d\u043e\u0442\u044b \u043d\u0435 \u0432\u044b\u043a\u0440\u0430\u045e \u0432\u0430\u0448 \u0441\u043a\u0430\u0440\u0431; \u043a\u0430\u0431 \u044f\u043a\u0456-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0456\u043a \u043d\u0435 \u0441\u043a\u0430\u0437\u0456\u045e \u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a\u0430\u044f \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430 \u0432\u0430\u043c. \u0414\u0430\u0440\u0443\u0447\u044d\u043d\u043d\u0435 \u0421\u0456\u043c\u0432\u0430\u043b\u0430 \u0432\u0435\u0440\u044b, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u044f\u043a \u0431\u044b \u0437\u043c\u044f\u0448\u0447\u044d\u043d\u043d\u0435\u043c \u0433\u0440\u043e\u0448\u0430\u0439 \u0443 \u0431\u0430\u043d\u043a, \u0448\u0442\u043e \u043c\u044b \u0456 \u0437\u0440\u0430\u0431\u0456\u043b\u0456. \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u0430\u0434 \u043d\u0430\u0441 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0430\u043c \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430. \u00ab\u041f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u2013 \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u2013 \u044f\u043a\u0456 \u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e\u0441\u044f\u043c\u0443, \u0456 \u043f\u0435\u0440\u0430\u0434 \u0415\u0437\u0443\u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u044f\u043a\u0456 \u0434\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u041f\u043e\u043d\u0446\u0456\u0435\u043c \u041f\u0456\u043b\u0430\u0442\u0430\u043c \u0434\u043e\u0431\u0440\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u00bb (1 \u0426\u0456\u043c 6, 13), \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u0432\u0430\u043c \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0432\u0435\u0440\u0443 \u00ab\u0447\u044b\u0441\u0442\u0430\u0439 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439 \u0430\u0436 \u0434\u0430 \u0430\u0431\u2019\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430\u00bb (1 \u0426\u0456\u043c 6, 14).<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440 \u043f\u0435\u0440\u0430\u043a\u0430\u0437\u0430\u043d\u044b \u0442\u0430\u0431\u0435 \u0441\u043a\u0430\u0440\u0431 \u0436\u044b\u0446\u0446\u044f. \u0423 \u0434\u0437\u0435\u043d\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u2019\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u0430\u0434 \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u0442\u044b \u0430\u0434\u0434\u0430\u045e \u042f\u0433\u043e \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u00ab\u045e \u0441\u0432\u043e\u0439 \u0447\u0430\u0441 \u043f\u0430\u043a\u0430\u0436\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0456 \u0430\u0434\u0437\u0456\u043d\u044b \u043c\u043e\u0446\u043d\u044b, \u041a\u0430\u0440\u043e\u043b\u044c \u043d\u0430\u0434 \u043a\u0430\u0440\u0430\u043b\u044f\u043c\u0456 \u0456 \u041f\u0430\u043d \u043d\u0430\u0434 \u043f\u0430\u043d\u0430\u043c\u0456, \u0430\u0434\u0437\u0456\u043d\u044b \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u045e \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u0435, \u044f\u043a\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e \u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u043d\u0435 \u043c\u043e\u0436\u0430\u00bb (1 \u0426\u0456\u043c 6, 15-16). \u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0430, \u043f\u0430\u0448\u0430\u043d\u0430 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435. \u0410\u043c\u044d\u043d.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0413\u0431\u0440 10, 38-39; \u043f\u0430\u0440. \u0410\u0431\u043a 2, 4\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041c\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b, \u0456, \u043a\u0430\u043b\u0456 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u0446\u0430, \u043d\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u0435 \u044f\u0433\u043e \u043c\u0430\u044f \u0434\u0443\u0448\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0410\u043b\u0435 \u043c\u044b \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u043c \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0434\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0441\u0430\u0431\u0435 \u043d\u0430 \u0437\u0433\u0443\u0431\u0443, \u0430\u043b\u0435 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0425\u0442\u043e \u043d\u0435 \u0436\u044b\u0432\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u044b, \u0442\u043e\u0439 \u043d\u0435 \u0441\u0443\u043f\u0430\u043a\u043e\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u043b\u0435 \u043c\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"316","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435\u00bb \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0437\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Or. 7, in laudem Caesarii fratris, 23-24: PG 35, 786-787)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u0432\u044f\u0442\u0430\u044f \u0440\u044d\u0447 \u2013 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0437\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u00ab\u0427\u044b\u043c \u0451\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0448\u0442\u043e \u0422\u044b \u043f\u0440\u0430 \u044f\u0433\u043e \u043f\u0430\u043c\u044f\u0442\u0430\u0435\u0448?\u00bb (\u041f\u0441 8, 5). \u0428\u0442\u043e \u0436 \u0433\u044d\u0442\u0430 \u0437\u0430 \u043d\u043e\u0432\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430, \u0431\u0430\u0447\u043d\u0430\u044f \u045e\u0432\u0430 \u043c\u043d\u0435? \u042f\u043a\u0456 \u0436 \u044f \u043c\u0430\u043b\u044b \u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0432\u044f\u043b\u0456\u043a\u0456, \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u0431\u044f\u0441\u0441\u043b\u0430\u045e\u0435\u043c \u0456 \u045e\u0437\u043d\u0451\u0441\u043b\u044b, \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b, \u0437\u044f\u043c\u043d\u044b \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b. \u0417 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u043c, \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u2013 \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c, \u0431\u044b\u0446\u044c \u0441\u0443\u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u044b\u043d\u0430\u043c \u0411\u043e\u0436\u044b\u043c, \u0431\u043e\u043b\u044c\u0448 \u2013 \u0441\u0430\u043c\u0456\u043c \u0411\u043e\u0433\u0430\u043c. \u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u0432\u044b\u0440\u0430\u0436\u0430\u0435 \u0442\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443: \u0411\u043e\u0433 \u043f\u0440\u044b\u043d\u044f\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443, \u0441\u0442\u0430\u045e \u0443\u0431\u043e\u0433\u0456\u043c, \u043a\u0430\u0431 \u0443\u0437\u043d\u044f\u0446\u044c \u0443\u043f\u0430\u043b\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u043a\u0430\u0431 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u0441\u0432\u0430\u0439\u043c\u0443 \u0432\u043e\u0431\u0440\u0430\u0437\u0443 \u043f\u0435\u0440\u0448\u0430\u0441\u043d\u0443\u044e \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c, \u043a\u0430\u0431 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043a\u0430\u0431 \u043c\u044b \u045e\u0441\u0435 \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0430\u0434\u043d\u044b\u043c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u044f\u043a\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u0441\u0456\u0445 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u0441\u0442\u0430\u045e \u0443\u0441\u0456\u043c, \u0447\u044b\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430. \u0422\u0430\u043c\u0443 \u043d\u044f\u043c\u0430 \u045e\u0436\u043e \u043d\u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u043d\u0456 \u043c\u0443\u0436\u0447\u044b\u043d\u044b, \u00ab\u043d\u0456 \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u0430, \u043d\u0456 \u0441\u043a\u0456\u0444\u0430, \u043d\u0456 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430, \u043d\u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0433\u0430\u00bb (\u041a\u043b\u0441 3, 11); \u0433\u044d\u0442\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u044f \u0440\u044b\u0441\u044b \u0456 \u0430\u0434\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u0456. \u041c\u044b \u0436 \u043d\u043e\u0441\u0456\u043c \u045e \u0441\u0430\u0431\u0435 \u043f\u044f\u0447\u0430\u0446\u044c \u0411\u043e\u0433\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0456 \u0434\u043b\u044f \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u0431\u044b\u043b\u0456 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u044f; \u0406\u043c \u043c\u044b \u0431\u044b\u043b\u0456 \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u043d\u044b\u044f \u0456 \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u044f, \u043a\u0430\u0431 \u0401\u043d \u0441\u0430\u043c \u043c\u043e\u0433 \u043d\u0430\u0441 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041c\u044b \u0437\u043c\u043e\u0436\u0430\u043c \u0441\u0442\u0430\u0446\u044c \u0442\u0430\u043a\u0456\u043c\u0456, \u044f\u043a \u0447\u0430\u043a\u0430\u0435\u043c, \u043f\u0440\u0430\u0437 \u043c\u043e\u0446 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456 \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430. \u0401\u043d \u043d\u044f\u0448\u043c\u0430\u0442 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u043d\u0430\u0441, \u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0448\u0447\u044b\u0440\u0430 \u042f\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u044c, \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456 \u0446\u044f\u043f\u0435\u0440 \u0456 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0432\u0435\u043a\u0443. \u0417 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u043d\u0430\u0448\u0443\u044e \u0434\u0430 \u042f\u0433\u043e \u043b\u044e\u0431\u043e\u045e \u0456 \u043d\u0430\u0434\u0437\u0435\u044e \u043c\u044b \u045e\u0441\u0451 \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c, \u0437\u0430 \u045e\u0441\u0451 \u0434\u0437\u044f\u043a\u0443\u0435\u043c, \u2013 \u0431\u043e \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u0445 \u0448\u043c\u0430\u0442\u0440\u0430\u0437\u043e\u0432\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u044b\u043b\u0430\u0434\u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u2013 \u0434\u0430\u0432\u044f\u0440\u0430\u044e\u0447\u044b \u0434\u0443\u0448\u044b \u0441\u0432\u0430\u0435 \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u045e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u044b\u043c \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0430\u0432\u0430\u043d\u043d\u0456 \u0430\u043f\u044f\u0440\u044d\u0434\u0437\u0456\u045e \u043d\u0430\u0441 \u043d\u0430 \u0448\u043b\u044f\u0445\u0443 \u0434\u0430 \u0434\u043e\u043c\u0443 \u0410\u0439\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041e \u041f\u0430\u043d\u0435, \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0443\u0441\u044f\u0433\u043e, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u044b\u043b\u0443! \u041e \u0411\u043e\u0436\u0430, \u041e\u0439\u0447\u0430 \u0456 \u041f\u0440\u0430\u0432\u0430\u0434\u044b\u0440 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0440\u043e\u0434\u0443! \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443 \u0436\u044b\u0446\u0446\u044f \u0456 \u0441\u043c\u0435\u0440\u0446\u0456! \u041e \u0410\u043f\u044f\u043a\u0443\u043d\u0435 \u0456 \u0414\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u044e \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u0448! \u0422\u044b \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u0421\u043b\u043e\u0432\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0448 \u0443\u0441\u0451 \u045e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441 \u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435\u0448 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0422\u0432\u0430\u0451\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u041f\u0440\u043e\u0432\u0456\u0434\u0443, \u043f\u0440\u044b\u043c\u0456 \u0446\u044f\u043f\u0435\u0440, \u043f\u0440\u0430\u0448\u0443, \u0426\u044d\u0437\u0430\u0440\u044b\u044f, \u044f\u043a\u0456 \u0430\u043f\u0430\u0440\u044d\u0434\u0437\u0456\u045e \u043c\u044f\u043d\u0435, \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041c\u044f\u043d\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u044b\u043c\u0456 \u045e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441; \u043a\u0456\u0440\u0443\u0439 \u043c\u0430\u0456\u043c \u0437\u044f\u043c\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u0442\u0430\u043a \u0434\u043e\u045e\u0433\u0430, \u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430. \u041f\u0440\u044b\u043c\u0456 \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u044f, \u0430\u043b\u0435 \u043d\u0435 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u043d\u044b\u044f. \u041a\u0430\u0431 \u043d\u0430\u043c \u043d\u0435 \u0431\u044b\u0446\u044c \u0443 \u0430\u043f\u043e\u0448\u043d\u0456 \u0434\u0437\u0435\u043d\u044c \u0443\u043f\u0430\u0440\u0442\u044b\u043c\u0456, \u044f\u043a\u0456\u0445 \u043d\u0430\u0441\u0456\u043b\u0443 \u0432\u044b\u0440\u044b\u0432\u0430\u044e\u0446\u044c \u0430\u0434\u0441\u044e\u043b\u044c \u0456 \u0432\u044f\u0434\u0443\u0446\u044c \u043f\u0430\u0434 \u043f\u0440\u044b\u043c\u0443\u0441\u0430\u043c \u043d\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0441\u0432\u0435\u0442\u0443 \u0456 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0431\u043e\u043b\u044c\u0448 \u044f\u043a \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0456\u0434\u0437\u0435 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0433\u0430 \u0456 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u0435 \u0451\u0441\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u041f\u0430\u043d\u0443 \u043d\u0430\u0448\u044b\u043c; \u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u043d\u0430 \u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435 \u043d\u0430\u0448 \u0411\u043e\u0436\u0430, \u043f\u0440\u044b\u043c\u0456 \u0434\u0443\u0448\u044b \u043d\u0430\u0448\u044b\u0445 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0437\u0430 \u044f\u043a\u0456\u0445 \u0422\u044b \u043f\u0440\u0430\u043b\u0456\u045e \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e; <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043f\u0430\u043c\u044f\u0442\u0430\u0439, \u0448\u0442\u043e \u043c\u044b \u2013 \u043f\u044b\u043b, \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0440\u0430\u043c\u0456\u043d\u0430\u0435 \u044f\u043a \u0442\u0440\u0430\u0432\u0430 \u0456 \u043f\u0430\u043b\u044f\u0432\u0430\u044f \u043a\u0432\u0435\u0442\u043a\u0430.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041b\u0456\u0442\u0430\u0441\u0446\u0456\u0432\u044b, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u041f\u0430\u043d\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041f\u0430\u043c\u044f\u0442\u0430\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"317","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u041f\u0440\u0430 \u0434\u043e\u0431\u0440\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c\u00bb \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 3, 9; 4, 15: CSEL 32, 710. 716-717)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043d\u043e\u0441\u0456\u043c \u0443 \u0441\u0430\u0431\u0435 \u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: \u00ab\u0421\u0432\u0435\u0442 \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0434\u043b\u044f \u043c\u044f\u043d\u0435, \u0430 \u044f \u2013 \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443\u00bb (\u0413\u0430\u043b 6, 14). \u0417\u0430\u0442\u044b\u043c, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u043f\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441, \u0448\u0442\u043e \u045e \u0437\u044f\u043c\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0456\u0441\u043d\u0443\u0435 \u0442\u0430\u043a\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c, \u044f\u043a\u0430\u044f \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u044e, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u043d\u0430\u0441, \u043a\u0430\u0431 \u043c\u044b \u00ab\u043d\u0430\u0441\u0456\u043b\u0456 \u045e \u0446\u0435\u043b\u0435 \u0441\u0432\u0430\u0456\u043c \u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430: \u0431\u043e \u0445\u0442\u043e \u043d\u043e\u0441\u0456\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430, \u0442\u043e\u0439 \u0456 \u0436\u044b\u0446\u0446\u0451 \u041f\u0430\u043d\u0430 \u0415\u0441\u0443\u0441\u0430 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0443 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435\u00bb (\u043f\u0430\u0440. 2 \u041a\u0430\u0440 4, 10-11).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e \u043d\u0430\u0441 \u043a\u0430\u043d\u0430\u043d\u043d\u0435, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e \u045e \u043d\u0430\u0441 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0436\u044b\u0446\u0446\u0451. \u0413\u044d\u0442\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456, \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0435 \u043f\u0430\u0441\u043b\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456, \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0435 \u043f\u0430\u0441\u043b\u044f \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u044f \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u044b, \u043a\u0430\u043b\u0456 \u045e\u0436\u043e \u0437\u0430\u043a\u043e\u043d \u0446\u0435\u043b\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0446\u0446\u0430 \u0437\u0430\u043a\u043e\u043d\u0443 \u0434\u0443\u0445\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e\u0436\u043e \u045e \u043d\u0430\u0448\u044b\u043c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0446\u0435\u043b\u0435 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u044b, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430. \u0406 \u043d\u0435 \u043c\u0430\u0433\u0443 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0446\u0456 \u0433\u044d\u0442\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0435 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u044f \u0437\u0430 \u0436\u044b\u0446\u0446\u0451. \u041c\u044f\u043d\u0435 \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0435 \u0430\u045e\u0442\u0430\u0440\u044b\u0442\u044d\u0442 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430: \u00ab\u0421\u043c\u0435\u0440\u0446\u044c \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e \u043d\u0430\u0441, \u0430 \u0436\u044b\u0446\u0446\u0451 \u2013 \u0443 \u0432\u0430\u0441\u00bb (2 \u041a\u0430\u0440 4, 12). \u042f\u043a \u0436\u0430 \u043c\u043d\u043e\u0433\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0441\u043c\u0435\u0440\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0436\u044b\u0446\u0446\u0451! \u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0432\u0443\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0442\u0443\u0442 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0436\u0430\u0434\u0430\u0446\u044c \u0442\u0430\u043a\u043e\u0439 \u0441\u043c\u0435\u0440\u0446\u0456, \u043a\u0430\u0431 \u0441\u043c\u0435\u0440\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u0430\u044f\u0441\u043d\u0435\u043b\u0430 \u045e \u043d\u0430\u0448\u044b\u043c \u0446\u0435\u043b\u0435. \u0413\u044d\u0442\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0451\u0439 \u00ab\u0437\u043d\u0435\u0448\u043d\u0456 \u043d\u0430\u0448 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0442\u043b\u0435\u0435, \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0437 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430\u00bb (2 \u041a\u0430\u0440 4, 16), \u0430 \u00ab\u0437\u044f\u043c\u043d\u044b \u0434\u043e\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u0436\u044b\u043b\u043b\u044f \u0440\u0430\u0437\u0432\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430\u00bb (\u043f\u0430\u0440. 2 \u041a\u0430\u0440 5, 1), \u043a\u0430\u0431 \u0431\u044b\u043b\u043e \u0434\u043b\u044f \u043d\u0430\u0441 \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0436\u044b\u043b\u043b\u0451 \u045e \u043d\u0435\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u043d\u0435\u0439\u043a\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0441\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044f\u045e \u0446\u0435\u043b\u0430 \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435\u0446\u0446\u0430 \u0437 \u043f\u0443\u0442\u0430\u045e, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u043a\u0430\u0436\u0430 \u0442\u0430\u0431\u0435 \u041f\u0430\u043d \u043f\u0440\u0430\u0437 \u0406\u0441\u0430\u044e: \u00ab\u0420\u0430\u0437\u0430\u0440\u0432\u0430\u0446\u044c \u043a\u0430\u0439\u0434\u0430\u043d\u044b \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f, \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u0446\u044c \u043f\u0443\u0442\u044b \u043d\u044f\u0432\u043e\u043b\u0456, \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043d\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u0443 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u0445 \u0456 \u0440\u0430\u0437\u0431\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u044f\u0440\u043c\u043e\u00bb (\u0406\u0441 58, 6).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u0441\u043c\u0435\u0440\u0446\u044c, \u043a\u0430\u0431 \u0441\u043f\u044b\u043d\u0456\u0446\u044c \u0433\u0440\u044d\u0445; \u0456 \u043a\u0430\u0431 \u0443 \u0432\u044b\u043d\u0456\u043a\u0443 \u0441\u043c\u0435\u0440\u0446\u0456 \u043d\u0435 \u0431\u044b\u043b\u0430 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u043d\u0430\u0442\u0443\u0440\u0430, \u0443\u0434\u0437\u044f\u043b\u0456\u045e \u0434\u0430\u0440 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f. \u0422\u0430\u043a \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c \u0431\u044b\u045e \u0432\u044b\u0433\u043d\u0430\u043d\u044b \u0433\u0440\u044d\u0445, \u0430 \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u0431\u044b\u043b\u0430 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u0430 \u043d\u0430\u0442\u0443\u0440\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0441\u043c\u0435\u0440\u0446\u044c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0430\u043c, \u044f\u043a\u0456 \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430. \u041d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430, \u043a\u0430\u0431 \u043c\u044b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u0456 \u043f\u0435\u0440\u0430\u0445\u043e\u0434: \u0430\u0434 \u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456 \u0434\u0430 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456, \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456, \u0430\u0434 \u043d\u0435\u0441\u043f\u0430\u043a\u043e\u044e \u0434\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0443\u0436\u0430\u0435 \u0446\u044f\u0431\u0435 \u0456\u043c\u044f \u0441\u043c\u0435\u0440\u0446\u0456, \u0430\u043b\u0435 \u0440\u0430\u0434\u0443\u044e\u0446\u044c \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0443. \u0427\u044b\u043c \u0436\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0437\u0430\u0433\u0430\u043d\u0430\u045e \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435\u043c \u0446\u043d\u043e\u0442\u0430\u045e? \u0422\u0430\u043c\u0443 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041d\u044f\u0445\u0430\u0439 \u043c\u0430\u044f \u0434\u0443\u0448\u0430 \u043f\u0430\u043c\u0440\u044d \u0441\u043c\u0435\u0440\u0446\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445\u00bb. \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u0430\u044f \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u0433\u0430\u043d\u0430\u045e, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u043b\u0430\u0441\u043a\u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445, \u044f\u043a\u0456\u044f \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043d\u043e\u0441\u044f\u0446\u044c \u0443 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u0435 \u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">2 \u0426\u0456\u043c 2, 11-12\u0430; \u0421\u0456\u0440 1, 29\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u043a\u0430\u043b\u0456 \u043c\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0442\u043e \u0437 \u0406\u043c \u0456 \u0430\u0436\u044b\u0432\u0451\u043c; <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u043b\u0456 \u0446\u0435\u0440\u043f\u0456\u043c, \u0442\u043e \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435\u043c.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0422\u043e\u0439, \u0445\u0442\u043e \u0446\u0435\u0440\u043f\u0456\u0446\u044c, \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0434\u0430 \u0447\u0430\u0441\u0443, \u0430\u043b\u0435 \u043f\u0430\u0441\u043b\u044f \u0434\u043b\u044f \u044f\u0433\u043e \u0437\u0430\u043a\u0432\u0456\u0442\u043d\u0435\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u043b\u0456 \u0446\u0435\u0440\u043f\u0456\u043c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"321","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0430\u0447\u0430\u0442\u0430\u043a \u0433\u0430\u043c\u0456\u043b\u0456\u0456 \u0430\u045e\u0442\u0430\u0440\u0430 \u0406\u0406 \u0441\u0442.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 32pt; text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 1, 1 \u2013 2, 7: Funk 1, 145-149)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0440\u0430\u0442\u044b, \u0430\u0434\u043d\u043e\u0432\u0456\u043c \u043d\u0430\u0448\u0443\u044e \u0432\u0435\u0440\u0443 \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0421\u0443\u0434\u0434\u0437\u044e \u0436\u044b\u0432\u044b\u0445 \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. \u0411\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0432\u0435\u043b\u0456\u0447 \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u041a\u0430\u043b\u0456 \u043c\u044b \u0437\u043c\u0435\u043d\u0448\u044b\u043c \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u0437\u043c\u0435\u043d\u0448\u044b\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0451\u043c\u0441\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c. \u0422\u044b\u044f, \u0445\u0442\u043e \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u044b \u0434\u0430 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u045e, \u0433\u0440\u0430\u0448\u0430\u0446\u044c. \u0413\u0440\u0430\u0448\u044b\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043c\u044b, \u043a\u0430\u043b\u0456 \u043d\u0435 \u045e\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u0435\u043c \u043f\u0440\u0430\u0437 \u043a\u0430\u0433\u043e, \u0430\u0434\u043a\u0443\u043b\u044c \u0456 \u043a\u0443\u0434\u044b \u043c\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u044f\u043a \u0448\u043c\u0430\u0442 \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u043d\u0430\u0448 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0427\u044b\u043c \u0430\u0434\u0434\u0437\u044f\u0447\u044b\u043c \u043c\u044b \u041f\u0430\u043d\u0443? \u042f\u043a\u0456 \u043f\u043b\u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0433\u043e\u0434\u043d\u044b \u0434\u0430\u0440\u0443, \u044f\u043a\u0456\u043c \u0401\u043d \u043d\u0430\u0441 \u0430\u0434\u0430\u0440\u044b\u045e? \u041e, \u044f\u043a\u0456\u044f \u0436 \u043c\u044b \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u044f\u0433\u043e \u0434\u0430\u045e\u0436\u043d\u0456\u043a\u0456! \u0401\u043d \u0430\u0434\u0430\u0440\u044b\u045e \u043d\u0430\u0441 \u0441\u0432\u044f\u0442\u043b\u043e\u043c; \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u045e, \u043a\u0430\u043b\u0456 \u043c\u044b \u0433\u0456\u043d\u0443\u043b\u0456; \u044f\u043a \u0410\u0439\u0446\u0435\u0446 \u043d\u0430\u0437\u0432\u0430\u045e \u043d\u0430\u0441 \u0441\u0432\u0430\u0456\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456. \u042f\u043a\u043e\u0439 \u0436\u0430 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044e, \u044f\u043a\u043e\u0439 \u0436\u0430 \u043f\u043b\u0430\u0442\u0430\u044e \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0441\u043f\u043b\u0430\u0446\u0456\u0446\u0446\u0430, \u043a\u0430\u0431 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456? \u041c\u044b \u0431\u044b\u043b\u0456 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f, \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u043a\u0430\u043c\u044f\u043d\u044f\u043c, \u0434\u0440\u044d\u0432\u0430\u043c, \u043f\u0440\u0430\u0434\u043c\u0435\u0442\u0430\u043c \u0437 \u0437\u043e\u043b\u0430\u0442\u0430, \u0441\u0435\u0440\u0430\u0431\u0440\u0430 \u0456 \u0436\u0430\u043b\u0435\u0437\u0430, \u0448\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0440\u0443\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0423\u0441\u0451 \u043d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0431\u044b\u043b\u043e \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0441\u043c\u0435\u0440\u0446\u044e. \u041c\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u0437\u043c\u0440\u043e\u043a\u0443, \u0431\u044b\u043b\u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u044b\u043c\u0456, \u0456 \u0432\u043e\u0441\u044c \u0434\u0430 \u043d\u0430\u0441 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0437\u0440\u043e\u043a, \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u0433\u043e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456 \u043c\u044b \u0430\u0434\u044b\u0448\u043b\u0456 \u0430\u0434 \u0446\u0435\u043c\u0440\u044b, \u044f\u043a\u0430\u044f \u043d\u0430\u0441 \u0430\u0442\u0430\u0447\u0430\u043b\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0437\u043c\u0456\u043b\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456. \u041a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u043c\u044b \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0456 \u0456 \u0433\u0456\u043d\u0435\u043c, \u043d\u0435 \u043c\u0430\u044e\u0447\u044b \u043d\u0456\u044f\u043a\u0430\u0439 \u0430\u043f\u0440\u043e\u0447 \u042f\u0433\u043e \u043d\u0430\u0434\u0437\u0435\u0456 \u043d\u0430 \u0440\u0430\u0442\u0443\u043d\u0430\u043a, \u0432\u044b\u0431\u0430\u0432\u0456\u045e \u043d\u0430\u0441 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u041f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u043c\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0456; \u043f\u0430\u0436\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u043c\u044b \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0456 \u0437 \u043d\u0435\u0431\u044b\u0446\u0446\u044f \u0434\u0430 \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u044f!<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u00ab\u0423\u0437\u0440\u0430\u0434\u0443\u0439\u0441\u044f, \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u044f, \u044f\u043a\u0430\u044f \u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430; \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0439 \u0430\u0434 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0441\u044f, \u044f\u043a\u0430\u044f \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0431\u043e\u043b\u044e \u0440\u043e\u0434\u0430\u045e! \u0411\u043e \u045e \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u0441\u044b\u043d\u043e\u045e, \u0447\u044b\u043c \u0441\u044b\u043d\u043e\u045e \u0443 \u0442\u043e\u0439, \u044f\u043a\u0430\u044f \u043c\u0430\u0435 \u043c\u0443\u0436\u0430\u00bb (\u0406\u0441 54, 1). \u0421\u043b\u043e\u0432\u044b \u00ab\u045e\u0437\u0440\u0430\u0434\u0443\u0439\u0441\u044f, \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u044f, \u044f\u043a\u0430\u044f \u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u00bb, \u0430\u0434\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u0434\u0430 \u043d\u0430\u0441. \u0411\u043e \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u044b\u043c \u0431\u044b\u045e \u043d\u0430\u0448 \u041a\u0430\u0441\u0446\u0451\u043b, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0431\u044b\u043b\u0456 \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u044f\u043c\u0443 \u0434\u0437\u0435\u0446\u0456. \u0410 \u0441\u043b\u043e\u0432\u044b \u00ab\u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0439 \u0430\u0434 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0441\u044f, \u044f\u043a\u0430\u044f \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0431\u043e\u043b\u044e \u0440\u043e\u0434\u0430\u045e\u00bb, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u0441 \u0448\u0447\u044b\u0440\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u043d\u0435 \u043f\u0430\u0434\u0430\u0446\u044c \u0434\u0443\u0445\u0430\u043c, \u044f\u043a \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u044f\u043a\u0430\u044f \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0431\u043e\u043b\u044c. \u041d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b: \u00ab\u0423 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u0441\u044b\u043d\u043e\u045e, \u0447\u044b\u043c \u0441\u044b\u043d\u043e\u045e \u0443 \u0442\u043e\u0439, \u044f\u043a\u0430\u044f \u043c\u0430\u0435 \u043c\u0443\u0436\u0430\u00bb, \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043d\u0430\u0448 \u043d\u0430\u0440\u043e\u0434 \u0437\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u043c \u0456 \u0437\u0430\u0431\u044b\u0442\u044b\u043c \u0411\u043e\u0433\u0430\u043c; \u0446\u044f\u043f\u0435\u0440 \u0436\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456, \u0442\u043e \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c\u0456 \u0437\u0430 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043b\u0456\u0447\u044b\u043b\u0456 \u0448\u0430\u043d\u0430\u0432\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0436\u0430: \u00ab\u042f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u043d\u0435 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e, \u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e\u00bb (\u041c\u0446 9, 13). \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0442\u0430\u043a \u043a\u0430\u0436\u0430, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u0436\u0430\u0434\u0430\u0435 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u0456\u043d\u0435. \u0411\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u043d\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u043e\u0446\u043d\u0430 \u0441\u0442\u0430\u0456\u0446\u044c, \u0430\u043b\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u0434\u0430\u0435. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0445\u0430\u0446\u0435\u045e \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0433\u0456\u043d\u0443\u043b\u0430, \u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u043c\u043d\u043e\u0433\u0456\u0445, \u0431\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u043c\u044b \u0456\u0448\u043b\u0456 \u0434\u0430 \u0437\u0433\u0443\u0431\u044b.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u0422\u044d\u0441 5, 9-10; \u041a\u043b\u0441 1, 13\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0411\u043e\u0433 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043d\u0430\u0441 \u043d\u0435 \u0434\u043b\u044f \u0433\u043d\u0435\u0432\u0443, \u0430\u043b\u0435 \u0434\u043b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u043d\u0430\u0441, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u043c\u044b \u0436\u044b\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0401\u043d<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0437-\u043f\u0430\u0434 \u0443\u043b\u0430\u0434\u044b \u0446\u0435\u043c\u0440\u044b \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"322","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0430\u045e\u0442\u0430\u0440\u0430 \u0406\u0406 \u0441\u0442.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 3, 1 \u2013 4, 5; 7, 1-6: Funk 1, 149-153)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u0443\u0434\u0437\u0435\u043c \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0430\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u043c \u0441\u0432\u0430\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430\u0437 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b, \u0436\u044b\u0432\u044b\u044f \u0456\u0441\u0442\u043e\u0442\u044b, \u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043c \u0430\u0445\u0432\u044f\u0440\u0430\u045e \u0456 \u043d\u0435 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u043c\u0441\u044f \u043c\u0451\u0440\u0442\u0432\u044b\u043c \u0431\u0430\u0433\u0430\u043c, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0410\u0439\u0446\u0430 \u043f\u0440\u0430\u045e\u0434\u044b. \u0427\u044b\u043c \u0436\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u0435 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0410\u0439\u0446\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u044b\u043c \u0434\u0430\u0440\u0443\u0447\u044d\u043d\u043d\u0435\u043c \u0441\u044f\u0431\u0435 \u0425\u0440\u044b\u0441\u0442\u0443, \u044f\u043a\u0456 \u0430\u0431\u2019\u044f\u0432\u0456\u045e \u043d\u0430\u043c \u0410\u0439\u0446\u0430? \u0414\u0430\u0440\u044d\u0447\u044b, \u0401\u043d \u0441\u0430\u043c \u043a\u0430\u0436\u0430: \u00ab\u041a\u043e\u0436\u043d\u0430\u0433\u0430, \u0445\u0442\u043e \u0432\u044b\u0437\u043d\u0430\u0435 \u041c\u044f\u043d\u0435 \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u043f\u0440\u044b\u0437\u043d\u0430\u044e \u0456 \u042f \u043f\u0435\u0440\u0430\u0434 \u0410\u0439\u0446\u043e\u043c\u00bb (\u043f\u0430\u0440. \u041b\u043a 12, 8). \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u0441\u0442\u0430\u043d\u0435 \u043d\u0430\u0448\u0430\u0439 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430\u0439, \u043a\u0430\u043b\u0456 \u043c\u044b \u0432\u044b\u0437\u043d\u0430\u0435\u043c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0430\u0441 \u0437\u0431\u0430\u0432\u0456\u045e. \u042f\u043a \u043c\u044b \u042f\u0433\u043e \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c? \u0412\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b \u045e\u0441\u0451, \u0448\u0442\u043e \u0401\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e, \u043d\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u042f\u0433\u043e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e, \u0443\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u042f\u0433\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0443\u0441\u043d\u0430\u043c\u0456, \u0430\u043b\u0435 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u044e. \u0411\u043e \u0401\u043d \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u044e: \u00ab\u0413\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u041c\u044f\u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0432\u0430\u0456\u043c \u044f\u0437\u044b\u043a\u043e\u043c, \u0430\u043b\u0435 \u0441\u044d\u0440\u0446\u0430 \u044f\u0433\u043e\u043d\u0430\u0435 \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u041c\u044f\u043d\u0435\u00bb (\u0406\u0441 29, 13).<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041c\u0430\u043b\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u041f\u0430\u043d\u0430\u043c; \u0433\u044d\u0442\u0430 \u044f\u0448\u0447\u044d \u043d\u0430\u0441 \u043d\u0435 \u0437\u0431\u0430\u0432\u0456\u0446\u044c. \u0411\u043e \u0401\u043d \u043a\u0430\u0436\u0430: \u00ab\u041d\u0435 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043a\u0430\u0436\u0430 \u041c\u043d\u0435: \u201c\u041f\u0430\u043d\u0435, \u041f\u0430\u043d\u0435\u201d, \u0431\u0443\u0434\u0437\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u00bb (\u043f\u0430\u0440. \u041c\u0446 7, 21), \u0430\u043b\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430. \u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u043d\u0430\u0448\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456, \u043b\u044e\u0431\u044f\u0447\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u044e\u0447\u044b \u0447\u0443\u0436\u0430\u043b\u043e\u0441\u0442\u0432\u0430, \u043f\u0430\u043a\u043b\u0451\u043f\u0443 \u0456 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456; \u0436\u044b\u0432\u0443\u0447\u044b \u0432\u0430 \u045e\u0441\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0456, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0456 \u0448\u043b\u044f\u0445\u0435\u0442\u043d\u0430, \u043a\u0456\u0440\u0443\u044e\u0447\u044b\u0441\u044f \u045e\u0437\u0430\u0435\u043c\u043d\u044b\u043c \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u0435\u043c, \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u0447\u044b \u043a\u0430\u0440\u044b\u0441\u0446\u0456. \u041f\u0440\u0430\u0437 \u0442\u0430\u043a\u0456\u044f, \u0430 \u043d\u0435 \u0430\u0434\u0432\u0430\u0440\u043e\u0442\u043d\u044b\u044f \u0447\u044b\u043d\u044b, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0430. \u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u043b\u044e\u0434\u0437\u0435\u0439, \u0430\u043b\u0435 \u0411\u043e\u0433\u0430. \u0406\u043d\u0430\u043a\u0448 \u041f\u0430\u043d \u0441\u043a\u0430\u0436\u0430 \u0432\u0430\u043c: \u00ab\u041d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u0431 \u0432\u044b \u0431\u044b\u043b\u0456 \u0431\u043b\u0456\u0437\u043a\u0430 \u0434\u0430 \u041c\u044f\u043d\u0435, \u0430\u043b\u0435 \u043d\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u041c\u0430\u0456\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e, \u0430\u0434\u043a\u0456\u043d\u0443 \u0432\u0430\u0441 \u0456 \u0441\u043a\u0430\u0436\u0443: \u201c\u0410\u0434\u044b\u0434\u0437\u0456\u0446\u0435 \u0430\u0434 \u041c\u044f\u043d\u0435, \u042f \u043d\u0435 \u0432\u0435\u0434\u0430\u044e \u0430\u0434\u043a\u0443\u043b\u044c \u0432\u044b, \u0448\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435\u201d\u00bb (\u043f\u0430\u0440. \u041c\u0446 7, 23; \u041b\u043a 13, 27).<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0437\u0451\u043c \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0430 \u045e\u0436\u043e \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u043b\u0430\u0441\u044f. \u0423 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u0445 \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0446\u0442\u0432\u0430\u0445 \u043c\u043d\u043e\u0433\u0456\u044f \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u044e\u0446\u044c. \u0410\u0434\u043d\u0430\u043a \u043d\u0435 \u045e\u0441\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443, \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u043d\u0430\u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e\u0441\u044f \u0456 \u043d\u0430\u0439\u043b\u0435\u043f\u0448 \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f. \u041c\u044b \u0436 \u0437\u043c\u0430\u0433\u0430\u0435\u043c\u0441\u044f \u0442\u0430\u043a, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443. \u0411\u0443\u0434\u0437\u0435\u043c \u0436\u044b\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0411\u043e\u0436\u044b\u0445 \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0446\u0442\u0432\u0430\u0445, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u043f\u0440\u0430\u0432\u0430 \u043d\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b. \u0410 \u043a\u0430\u043b\u0456 \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0443\u0441\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043f\u0435\u0440\u0448\u0430\u0439 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b, \u0442\u043e \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430. \u0410\u0434\u043d\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0435 \u045e \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0446\u0442\u0432\u0430\u0445, \u0430\u043b\u0435 \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u043d\u044f\u0433\u043e\u0434\u043d\u0430, \u0437\u0430\u0441\u043b\u0443\u0436\u0432\u0430\u0435 \u043d\u0430 \u0440\u043e\u0437\u0433\u0456 \u0456 \u0432\u044b\u0434\u0430\u043b\u0435\u043d\u043d\u0435 \u0441\u0430 \u0441\u0442\u0430\u0434\u044b\u0451\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0428\u0442\u043e \u0434\u0443\u043c\u0430\u0435\u0446\u0435? \u042f\u043a\u043e\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u045e \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0446\u0442\u0432\u0430\u0445 \u0437\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0432\u044f\u0434\u0437\u0435 \u0441\u044f\u0431\u0435 \u043d\u044f\u0433\u043e\u0434\u043d\u0430? \u041f\u0440\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u043f\u044f\u0447\u0430\u0446\u0456 \u0445\u0440\u043e\u0441\u0442\u0443, \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u041d\u0435 \u0437\u0433\u0456\u043d\u0435 \u0456\u0445 \u0447\u0430\u0440\u0432\u044f\u043a, \u0456 \u043d\u0435 \u0437\u0433\u0430\u0441\u043d\u0435 \u0456\u0445 \u0430\u0433\u043e\u043d\u044c, \u0430 \u0447\u044b\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0433\u0456\u0434\u0430\u044e \u0434\u043b\u044f \u045e\u0441\u044f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u00bb (\u043f\u0430\u0440. \u0406\u0441 66, 24).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u0422\u044d\u0441 1, 9b-10; 1 \u042f\u043d 2, 28\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f\u043d\u044b \u0437\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0436\u044b\u0432\u043e\u043c\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u043c\u0443 \u0411\u043e\u0433\u0443 \u0456 \u0447\u0430\u043a\u0430\u0446\u044c \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0421\u044b\u043d\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u0401\u043d \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e, <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u044f\u043a\u0456 \u0432\u044b\u0431\u0430\u045e\u043b\u044f\u0435 \u043d\u0430\u0441 \u0430\u0434 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0426\u044f\u043f\u0435\u0440, \u0434\u0437\u0435\u0446\u0456, \u0436\u044b\u0432\u0456\u0446\u0435 \u045e \u0406\u043c, \u043a\u0430\u0431, \u043a\u0430\u043b\u0456 \u0401\u043d \u0437\u2019\u044f\u0432\u0456\u0446\u0446\u0430, \u043c\u044b \u043c\u0435\u043b\u0456 \u0430\u0434\u0432\u0430\u0433\u0443 \u0456 \u043d\u0435 \u0431\u044b\u043b\u0456 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b\u044f \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0443 \u0447\u0430\u0441 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u042f\u043a\u0456 \u0432\u044b\u0431\u0430\u045e\u043b\u044f\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"323","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0430\u045e\u0442\u0430\u0440\u0430 \u0406\u0406 \u0441\u0442.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 8, 1 \u2013 9, 11: Funk 1, 153-157)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0428\u0447\u044b\u0440\u0430\u0435 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u0443\u043b\u044c \u043c\u044b \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u0435\u043c \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0437\u043c\u044f\u043d\u0456\u0446\u044c \u0441\u0432\u0430\u0451 \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u0435! \u0411\u043e \u043c\u044b \u0433\u043b\u0456\u043d\u0430 \u045e \u0440\u0443\u043a\u0430\u0445 \u0433\u0430\u043d\u0447\u0430\u0440\u0430. \u0413\u0430\u043d\u0447\u0430\u0440, \u043a\u0430\u043b\u0456 \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u043d\u0430\u0447\u044b\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u045e \u044f\u0433\u043e \u0440\u0443\u043a\u0430\u0445 \u043a\u0440\u044b\u0448\u044b\u0446\u0446\u0430 \u0456 \u043b\u0430\u043c\u0430\u0435\u0446\u0446\u0430, \u043b\u0435\u043f\u0456\u0446\u044c \u044f\u0433\u043e \u043d\u0430\u043d\u043e\u0432\u0430. \u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u044f\u0433\u043e \u045e \u0430\u0433\u043e\u043d\u044c, \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0436\u043e \u0431\u043e\u043b\u044c\u0448 \u0437\u043c\u044f\u043d\u0456\u0446\u044c \u044f\u0433\u043e. \u0422\u0430\u043a \u0456 \u043c\u044b, \u043f\u0430\u043a\u0443\u043b\u044c \u0436\u044b\u0432\u0451\u043c \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u0443\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0430\u0434\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u0446\u0446\u0430 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u043d\u0430\u0448\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u044b\u0445 \u0443 \u0446\u0435\u043b\u0435, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u044c \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430\u043c \u0447\u0430\u0441 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0430\u0434 \u041f\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043f\u0430\u043a\u0456\u043d\u0435\u043c \u0433\u044d\u0442\u044b \u0441\u0432\u0435\u0442, \u043d\u0435 \u0437\u043c\u043e\u0436\u0430\u043c \u0443\u0436\u043e \u0431\u043e\u043b\u044c\u0448 \u043d\u0456 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u0430\u0432\u0456\u043d\u044b, \u043d\u0456 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u043d\u0430 \u0411\u043e\u0436\u044b \u0448\u043b\u044f\u0445. \u0422\u0430\u043c\u0443, \u043c\u0430\u0435 \u0431\u0440\u0430\u0442\u044b, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b \u0432\u043e\u043b\u044e \u0410\u0439\u0446\u0430, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c, \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b\u0441\u044f \u0411\u043e\u0436\u044b\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e, \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u0411\u043e \u041f\u0430\u043d \u043a\u0430\u0436\u0430 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456: \u00ab\u041a\u0430\u043b\u0456 \u0432\u044b \u045e \u043c\u0430\u043b\u044b\u043c \u043d\u0435 \u0431\u044b\u043b\u0456 \u0432\u0435\u0440\u043d\u044b\u044f, \u0445\u0442\u043e \u0434\u0430\u0440\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435? \u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0443 \u0432\u0430\u043c: \u201c\u0412\u0435\u0440\u043d\u044b \u045e \u043c\u0430\u043b\u044b\u043c \u0456 \u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0432\u0435\u0440\u043d\u044b\u201d\u00bb (\u043f\u0430\u0440. \u041b\u043a 16, 10-11). \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0446\u0435\u043b\u0430, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0443\u044e \u043f\u044f\u0447\u0430\u0442\u043a\u0443 \u0445\u0440\u043e\u0441\u0442\u0443 \u2013 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u0436\u044b\u0446\u0446\u0451.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0456\u0445\u0442\u043e \u0437 \u0432\u0430\u0441 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0446\u0435\u043b\u0430 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0441\u0443\u0434\u0430 \u0456 \u0448\u0442\u043e \u044f\u043d\u043e \u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0435. \u0422\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0434\u0443\u043c\u0430\u0439\u0446\u0435: \u0443 \u0447\u044b\u043c, \u043a\u0430\u043b\u0456 \u043d\u0435 \u045e \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0446\u0435\u043b\u0435 \u0432\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u044f \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0437\u0440\u043e\u043a? \u0414\u044b\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0441\u0446\u0435\u0440\u0430\u0433\u0447\u044b \u043d\u0430\u0448\u0430\u0435 \u0446\u0435\u043b\u0430 \u044f\u043a \u0411\u043e\u0436\u0443\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e. \u042f\u043a \u0443 \u0446\u0435\u043b\u0435 \u0432\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0446\u0435\u043b\u0435 \u0432\u044b \u0456 \u043f\u043e\u0439\u0434\u0437\u0435\u0446\u0435. \u041a\u0430\u043b\u0456 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0434\u0443\u0445\u0430\u043c, \u043f\u0440\u044b\u043d\u044f\u045e \u043b\u044e\u0434\u0441\u043a\u043e\u0435 \u0446\u0435\u043b\u0430, \u0456 \u0442\u0430\u043a\u0456\u043c \u043d\u0430\u0441 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e, \u0442\u043e \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u0446\u0435\u043b\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u043a\u0430\u0431 \u043c\u044b \u045e\u0441\u0435 \u043c\u0430\u0433\u043b\u0456 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u041f\u0430\u043a\u0443\u043b\u044c \u043c\u0430\u0435\u043c \u0447\u0430\u0441 \u043d\u0430 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0434\u0430\u0432\u0435\u0440\u044b\u043c\u0441\u044f \u0411\u043e\u0441\u043a\u0430\u043c\u0443 \u043b\u0435\u043a\u0430\u0440\u0443 \u0456 \u0430\u0445\u0432\u044f\u0440\u0443\u0435\u043c \u043f\u043b\u0430\u0442\u0443. \u042f\u043a\u0443\u044e? \u0428\u0447\u044b\u0440\u0430\u0435 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435. \u0411\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u042f\u0433\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0443\u0441\u043d\u0430\u043c\u0456, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u044d\u0440\u0446\u0430\u043c, \u043a\u0430\u0431 \u0401\u043d \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430\u0441 \u044f\u043a \u0441\u0432\u0430\u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439. \u0411\u043e \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0411\u0440\u0430\u0442\u044b \u041c\u0430\u0435 \u2013 \u0433\u044d\u0442\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0432\u043e\u043b\u044e \u041c\u0430\u0439\u0433\u043e \u0410\u0439\u0446\u0430\u00bb (\u043f\u0430\u0440. \u041b\u043a 8, 21).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u042d\u0437\u0445 18, 31\u0430. 32; 2 \u041f 3, 9b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0410\u0434\u043a\u0456\u043d\u044c\u0446\u0435 \u0430\u0434 \u0441\u044f\u0431\u0435 \u045e\u0441\u0435 \u0433\u0440\u0430\u0445\u0456 \u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u0446\u0435 \u045e \u0441\u0430\u0431\u0435 \u043d\u043e\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0456 \u043d\u043e\u0432\u044b \u0434\u0443\u0445. \u042f \u043d\u0435 \u0445\u0430\u0447\u0443 \u0441\u043c\u0435\u0440\u0446\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u0430\u0435\u0446\u0446\u0430, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u2013 <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0422\u0430\u043c\u0443 \u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u043d\u0430 \u0411\u043e\u0436\u044b \u0448\u043b\u044f\u0445 \u2013 \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0436\u044b\u0446\u044c.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b \u0434\u0430 \u043d\u0430\u0441, \u0401\u043d \u043d\u0435 \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u043d\u0435\u0445\u0442\u0430 \u0437\u0430\u0433\u0456\u043d\u0443\u045e, \u0430\u043b\u0435 \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u0443\u0441\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043c\u0443 \u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"324","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0430\u045e\u0442\u0430\u0440\u0430 \u0406\u0406 \u0441\u0442.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 10, 1 \u2013 12, 1; 13, 1: Funk 1, 157-159)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u0443\u0434\u0437\u0435\u043c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u043d\u0430\u0434\u0437\u0435\u0456<\/span><\/p>\r\n<p style=\"text-indent: 25pt; text-align: justify;\"><span>\u0411\u0440\u0430\u0442\u044b \u043c\u0430\u0435, \u043c\u044b \u0432\u044b\u043a\u0430\u043d\u0430\u0435\u043c \u0432\u043e\u043b\u044e \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u043d\u0430\u0441 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u0456 \u0448\u0447\u044b\u0440\u0430 \u0434\u0431\u0430\u0446\u044c \u043f\u0440\u0430 \u0446\u043d\u043e\u0442\u0443. \u0410\u0434\u043a\u0456\u043d\u0435\u043c \u0436\u0430 \u0437\u0430\u0433\u0430\u043d\u044b, \u044f\u043a\u0456\u044f \u043d\u0456\u0431\u044b \u0456\u0434\u0443\u0446\u044c \u043d\u0430\u043f\u0435\u0440\u0430\u0434\u0437\u0435 \u043d\u0430\u0448\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e. \u041f\u0430\u0437\u0431\u044f\u0433\u0430\u0439\u043c\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u043d\u0435 \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u043b\u0430 \u043d\u0430\u043c\u0456 \u0437\u043b\u043e. \u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0437\u0435\u043c \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0434\u0437\u0435\u043b\u044f \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u0434\u0430\u0431\u0440\u0430, \u0441\u043f\u0430\u043a\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u0446\u044c \u043d\u0430\u043c. \u041d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u044f\u0433\u043e \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0434\u0434\u0430\u0435\u0446\u0446\u0430 \u0437\u044f\u043c\u043d\u043e\u043c\u0443 \u0441\u0442\u0440\u0430\u0445\u0443 \u0456 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0431\u0443\u0434\u0443\u0447\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0446\u044d\u043d\u0456\u0446\u044c \u0447\u0430\u0441\u043e\u0432\u0443\u044e \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044c. \u042f\u043d\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u043a\u043e\u043b\u044c\u043a\u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u043d\u044f\u0441\u0443\u0446\u044c \u0437 \u0441\u0430\u0431\u043e\u044e \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0456 \u044f\u043a\u043e\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u045e \u0431\u0443\u0434\u0443\u0447\u0430\u0439 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0435. \u041a\u0430\u043b\u0456 \u0431 \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u044f\u043d\u044b \u0441\u0430\u043c\u0456 \u0442\u0430\u043a \u0440\u0430\u0431\u0456\u043b\u0456, \u0437\u043b\u0430 \u0431\u044b\u043b\u043e \u0431 \u043c\u0435\u043d\u0448. \u0410\u0434\u043d\u0430\u043a \u044f\u043d\u044b \u045e\u043f\u0430\u0440\u0442\u0430 \u043d\u0430\u043c\u0430\u0433\u0430\u044e\u0446\u0446\u0430 \u043f\u0430\u0434\u0441\u043e\u045e\u0432\u0430\u0446\u044c \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u044f \u0432\u0443\u0447\u044d\u043d\u043d\u0456 \u0441\u043b\u0430\u0431\u044b\u043c \u0434\u0443\u0448\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 25pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0411\u043e\u0433\u0443 \u0437 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0441\u0442\u0430\u043d\u0435\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c\u0456. \u041a\u0430\u043b\u0456 \u0436 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0437\u0440\u043e\u0431\u0456\u043c, \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u045e \u0411\u043e\u0436\u044b\u0445 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u0445, \u043d\u0430\u043a\u043b\u0456\u0447\u0430\u043c \u043d\u0430 \u0441\u044f\u0431\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435. \u0411\u043e \u043f\u0440\u0430\u0440\u043e\u043a \u043a\u0430\u0436\u0430: \u00ab\u041d\u044f\u0448\u0447\u0430\u0441\u043d\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u0430\u0435 \u043f\u0430\u0434\u0437\u0435\u043b\u0435\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0445\u0442\u043e \u0441\u0443\u043c\u044f\u043d\u044f\u0432\u0430\u0435\u0446\u0446\u0430, \u0445\u0442\u043e \u043a\u0430\u0436\u0430: \u201c\u041c\u044b \u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0440\u0430\u043d\u0435\u0439, \u0443 \u0447\u0430\u0441\u044b \u043d\u0430\u0448\u044b\u0445 \u0430\u0439\u0446\u043e\u045e: \u0437 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u043c\u044b \u0447\u0430\u043a\u0430\u043b\u0456, \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u043b\u0456\u201d. \u041d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f, \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u0439\u0446\u0435 \u0441\u044f\u0431\u0435 \u0437 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0430\u043c: \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u043a\u0456\u0434\u0432\u0430\u0435 \u043b\u0456\u0441\u0446\u0435, \u0437\u0430\u0442\u044b\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043f\u0443\u043f\u044b\u0448\u043a\u0456, \u0437\u0430\u0442\u044b\u043c \u043a\u0456\u0441\u043b\u044b \u043f\u043b\u043e\u0434, \u0456, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u043f\u043b\u043e\u0434 \u0441\u043f\u0435\u043b\u044b. \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u0456 \u043c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u045e\u0446\u0456\u0441\u043a, \u0430\u043b\u0435 \u043f\u0430\u0441\u043b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 25pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u044b\u043c\u0456 \u045e \u0434\u0443\u043c\u043a\u0430\u0445, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u043d\u0430\u0434\u0437\u0435\u0456, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443. \u0412\u0435\u0440\u043d\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0430\u0431\u044f\u0446\u0430\u045e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u044f\u0433\u043e \u045e\u0447\u044b\u043d\u043a\u0430\u045e. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u0443\u0432\u043e\u0439\u0434\u0437\u0435\u043c \u0443 \u042f\u0433\u043e \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b, \u044f\u043a\u0456\u0445 \u00ab\u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430, \u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430, \u0456 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0441\u044d\u0440\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u00bb (1 \u041a\u0430\u0440 2, 9).<\/span><\/p>\r\n<p style=\"text-indent: 25pt; text-align: justify;\"><span>\u0410 \u0442\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0447\u0430\u043a\u0430\u0446\u044c \u0411\u043e\u0436\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u0437\u0430 \u0433\u0430\u0434\u0437\u0456\u043d\u0430\u0439 \u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0431\u043e \u043c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c \u0434\u043d\u044f \u0430\u0431\u2019\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0411\u043e\u0433\u0430. \u0423\u0436\u043e \u0446\u044f\u043f\u0435\u0440, \u0431\u0440\u0430\u0442\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u0447\u044b\u043d\u0456\u0446\u044c \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435, \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0431\u043e \u0448\u043c\u0430\u0442 \u0443 \u043d\u0430\u0441 \u0437\u043b\u043e\u0441\u0446\u0456 \u0456 \u043c\u044b \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f. \u041f\u0430\u0437\u0431\u0430\u0432\u0456\u043c\u0441\u044f \u043d\u0430\u0448\u044b\u0445 \u0440\u0430\u043d\u0435\u0439\u0448\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u043f\u0440\u0430\u0437 \u0448\u0447\u044b\u0440\u0430\u0435 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u0437\u0434\u0430\u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043b\u0456\u0441\u043b\u0456\u0432\u0456\u0446\u044c, \u0430, \u0456\u0434\u0443\u0447\u044b \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0431\u0443\u0434\u0437\u0435\u043c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0448\u044b\u043c \u0431\u0440\u0430\u0442\u0430\u043c, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0430-\u0437\u0430 \u043d\u0430\u043c\u0456, \u043a\u0430\u0431 \u0437-\u0437\u0430 \u043d\u0430\u0441 \u043d\u0435 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u043b\u0430\u0441\u044f \u0411\u043e\u0436\u0430\u0435 \u0406\u043c\u044f.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u041a\u0430\u0440 15, 58; 2 \u0422\u044d\u0441 3, 13\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u043e\u0446\u043d\u044b\u043c\u0456, \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u044b\u043c\u0456, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0434\u0434\u0430\u043d\u044b\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0435 \u041f\u0430\u043d\u0430 <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0432\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u043d\u0435 \u0434\u0430\u0440\u044d\u043c\u043d\u0430\u044f \u043f\u0440\u0430\u0446\u0430 \u0432\u0430\u0448\u0430 \u045e \u041f\u0430\u043d\u0443.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0432\u0430\u0439\u0446\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0432\u0435\u0434\u0430\u0439\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"325","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0430\u045e\u0442\u0430\u0440\u0430 \u0406\u0406 \u0441\u0442.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 13, 2 \u2013 14, 5: Funk 1, 159-163)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0416\u044b\u0432\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u2013 \u0433\u044d\u0442\u0430 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u041f\u0430\u043d \u043a\u0430\u0436\u0430: \u00ab\u0406\u043c\u044f \u041c\u0430\u0451 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e\u00bb (\u043f\u0430\u0440. \u0406\u0441 52, 5), \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u00ab\u0413\u043e\u0440\u0430 \u0442\u0430\u043c\u0443, \u043f\u0440\u0430\u0437 \u043a\u0430\u0433\u043e \u0456\u043c\u044f \u0411\u043e\u0436\u0430\u0435 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0435\u0446\u0446\u0430\u00bb (\u043f\u0430\u0440. \u0420\u044b\u043c 2, 24). \u0427\u044b\u043c \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0435\u0446\u0446\u0430? \u0422\u044b\u043c, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u043c \u0442\u0430\u0433\u043e, \u0447\u0430\u043c\u0443 \u0432\u0443\u0447\u044b\u043c. \u041a\u0430\u043b\u0456 \u043b\u044e\u0434\u0437\u0456 \u0447\u0443\u044e\u0446\u044c \u0437 \u043d\u0430\u0448\u044b\u0445 \u0432\u0443\u0441\u043d\u0430\u045e \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u0434\u0437\u0456\u0432\u044f\u0446\u0446\u0430 \u044f\u0433\u043e \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u0456 \u0456 \u043c\u043e\u0446\u044b. \u0410\u0434\u043d\u0430\u043a \u043f\u0430\u0441\u043b\u044f, \u043a\u0430\u043b\u0456 \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u044e\u0446\u0446\u0430, \u0448\u0442\u043e \u043d\u0430\u0448\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u043d\u0435 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u044e\u0446\u044c \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u0434\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043d\u0430\u0432\u0430\u0442 \u0434\u0430 \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u0430, \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u043f\u0443\u0441\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0456 \u0448\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0410 \u043a\u0430\u043b\u0456 \u0447\u0443\u044e\u0446\u044c \u0430\u0434 \u043d\u0430\u0441 \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430: \u00ab\u041a\u0430\u043b\u0456 \u0436 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0432\u0430\u0441, \u044f\u043a\u0443\u044e \u043c\u0430\u0435\u0446\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443? \u0423\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435\u0446\u0435 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043b\u044e\u0431\u0456\u0446\u0435 \u0441\u0432\u0430\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u0430\u0441 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c\u00bb (\u043f\u0430\u0440. \u041c\u0446 5, 46), \u0442\u043e, \u0441\u043b\u0443\u0445\u0430\u044e\u0447\u044b, \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0431\u0430\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u043b\u044e\u0431\u0456\u043c \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430\u0441 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c, \u0430\u043b\u0435 \u043d\u0430\u0432\u0430\u0442 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430\u0441 \u043b\u044e\u0431\u0456\u0446\u044c, \u0442\u0430\u0434\u044b \u0430\u0431\u0443\u0440\u0430\u044e\u0446\u0446\u0430 \u043d\u0430 \u043d\u0430\u0441, \u0456 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0406\u043c\u044f \u0411\u043e\u0436\u0430\u0435 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0435\u0446\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u043a\u0430\u043b\u0456 \u043c\u044b \u0432\u044b\u043a\u0430\u043d\u0430\u0435\u043c \u0432\u043e\u043b\u044e \u0411\u043e\u0433\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, \u043c\u044b \u043d\u0430\u043b\u0435\u0436\u044b\u043c \u0434\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u043a\u0456 \u0456\u0441\u043d\u0430\u0432\u0430\u045e \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u0443\u0437\u043d\u0456\u043a\u043b\u0456 \u0441\u043e\u043d\u0446\u0430 \u0456 \u043c\u0435\u0441\u044f\u0446. \u041a\u0430\u043b\u0456 \u043c\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u0432\u043e\u043b\u0456 \u0410\u0439\u0446\u0430, \u0434\u0430 \u043d\u0430\u0441 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u044b \u041f\u0456\u0441\u0430\u043d\u043d\u044f: \u00ab\u0414\u043e\u043c \u041c\u043e\u0439 \u0441\u0442\u0430\u045e\u0441\u044f \u043f\u044f\u0447\u043e\u0440\u0430\u0439 \u0440\u0430\u0437\u0431\u043e\u0439\u043d\u0456\u043a\u0430\u045e\u00bb (\u043f\u0430\u0440. \u0415\u0440 7, 11; \u041c\u0446 21, 13). \u0422\u0430\u043c\u0443 \u0432\u044b\u0431\u0435\u0440\u044b\u043c \u043f\u0440\u044b\u043d\u0430\u043b\u0435\u0436\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0436\u044b\u0446\u0446\u044f, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0414\u0443\u043c\u0430\u044e, \u0432\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0436\u044b\u0432\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 12, 27). \u0411\u043e \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u0421\u0442\u0432\u0430\u0440\u044b\u045e \u0411\u043e\u0433 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u0443\u0436\u0447\u044b\u043d\u0443 \u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u0443\u00bb (\u043f\u0430\u0440. \u0411\u044b\u0446 1, 27; 5, 2). \u041c\u0443\u0436\u0447\u044b\u043d\u0430\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u0439 \u2013 \u041a\u0430\u0441\u0446\u0451\u043b. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0411\u0456\u0431\u043b\u0456\u044f \u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0432\u0443\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0435 \u045e\u0437\u043d\u0456\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u044f\u043f\u0435\u0440, \u0430\u043b\u0435 \u0451\u043d \u0431\u044b\u045e \u043d\u0430\u043f\u0430\u0447\u0430\u0442\u043a\u0443; \u0431\u044b\u045e \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u043d\u0430\u0448 \u0415\u0437\u0443\u0441, \u0430 \u0430\u0431\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u045e \u0433\u044d\u0442\u044b\u044f \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0447\u0430\u0441\u044b \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0413\u044d\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c, \u0430\u0431\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u045e \u0446\u0435\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u045e \u0446\u0435\u043b\u0435, \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u044f\u0433\u043e \u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c. \u0413\u044d\u0442\u0430\u0435 \u0446\u0435\u043b\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0414\u0443\u0445\u0430. \u0425\u0442\u043e \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0432\u043e\u0431\u0440\u0430\u0437, \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u0421\u0446\u0435\u0440\u0430\u0436\u044b\u0446\u0435 \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u0434\u0443\u0445\u0443\u00bb. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u041a\u0430\u0441\u0446\u0451\u043b \u2013 \u0433\u044d\u0442\u0430 \u0446\u0435\u043b\u0430, \u0430 \u0434\u0443\u0445 \u2013 \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0442\u043e \u0432\u044b\u043d\u0456\u043a\u0430\u0435, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0435 \u0446\u0435\u043b\u0430, \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u041a\u0430\u0441\u0446\u0451\u043b. \u0413\u044d\u0442\u0430\u0435 \u0446\u0435\u043b\u0430 \u043f\u0440\u0430\u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043c\u043e\u0436\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u043c\u043e\u0436\u0430 \u043d\u0456 \u0432\u044b\u0440\u0430\u0437\u0456\u0446\u044c, \u043d\u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0411\u043e\u0433\u0441 \u0432\u0430\u0456\u043c \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0415\u0440 7, 3; \u042f\u043a 4, 8\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f: \u041f\u0430\u043f\u0440\u0430\u045e\u0446\u0435 \u0448\u043b\u044f\u0445\u0456 \u0432\u0430\u0448\u044b\u044f \u0456 \u045e\u0447\u044b\u043d\u043a\u0456 \u0432\u0430\u0448\u044b\u044f, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u042f \u0434\u0430\u0437\u0432\u043e\u043b\u044e \u0432\u0430\u043c \u0436\u044b\u0446\u044c \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0430\u0431\u043b\u0456\u0437\u044c\u0446\u0435\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430 \u2013 \u0456 \u0401\u043d \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u0446\u0446\u0430 \u0434\u0430 \u0432\u0430\u0441. \u0410\u0447\u044b\u0441\u0446\u0456\u0446\u0435 \u0440\u0443\u043a\u0456, \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0456, \u0456 \u0430\u0441\u0432\u044f\u0446\u0456\u0446\u0435 \u0441\u044d\u0440\u0446\u044b. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406 \u044f \u0434\u0430\u0437\u0432\u043e\u043b\u044e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"326","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0430\u045e\u0442\u0430\u0440\u0430 \u0406\u0406 \u0441\u0442.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 15, 1 \u2013 17, 2: Funk 1, 163-165)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043d\u0430\u0441 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0414\u0443\u043c\u0430\u044e, \u0448\u0442\u043e \u044f \u0434\u0430\u045e \u0441\u043b\u0443\u0448\u043d\u044b\u044f \u0437\u0430\u045e\u0432\u0430\u0433\u0456 \u043d\u0430\u043a\u043e\u043d\u0442 \u0443\u0441\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c, \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0443\u0435, \u0430\u043b\u0435 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0456 \u043c\u044f\u043d\u0435 \u044f\u043a \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0434\u0430\u045e \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0456. \u0411\u043e \u0433\u044d\u0442\u0430 \u043d\u0435\u043c\u0430\u043b\u0430\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u0430: \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u043d\u0430 \u0448\u043b\u044f\u0445 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u0443\u044e \u0456 \u0437\u0430\u0433\u0443\u0431\u043b\u0435\u043d\u0443\u044e \u0434\u0443\u0448\u0443. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a\u0443\u044e \u043f\u043b\u0430\u0442\u0443 \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u043a\u0430\u0436\u0430, \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u0435, \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0437\u0430\u0446\u044c \u0456 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0437 \u0432\u0435\u0440\u0430\u044e \u0456 \u043b\u044e\u0431\u043e\u045e\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0440\u044b\u0432\u0430\u0439\u043c\u0430 \u045e \u0442\u044b\u043c, \u0443 \u0448\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u044f\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0456 \u0441\u0432\u044f\u0442\u044b\u044f, \u043a\u0430\u0431 \u043c\u044b \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u043c\u0430\u0433\u043b\u0456 \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0446\u044c \u043d\u0430\u0448\u044b\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0434\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430: \u00ab\u0411\u0443\u0434\u0437\u0435\u0448 \u043a\u043b\u0456\u043a\u0430\u0446\u044c \u2013 \u0456 \u042f \u0430\u0434\u043a\u0430\u0436\u0443: \u201c\u0412\u043e\u0441\u044c \u042f\u201d\u00bb (\u043f\u0430\u0440. \u0406\u0441 58, 9). \u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0432\u044b\u044f\u045e\u043b\u044f\u044e\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435: \u041f\u0430\u043d \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0401\u043d \u0431\u043e\u043b\u044c\u0448 \u0433\u0430\u0442\u043e\u0432\u044b \u0434\u0430\u0432\u0430\u0446\u044c, \u0447\u044b\u043c \u043c\u044b \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u043f\u0440\u0430\u0441\u0456\u0446\u044c. \u0421\u043f\u0430\u0437\u043d\u0430\u044e\u0447\u044b \u0442\u0430\u043a\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u0446\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u0445 \u0430\u0434 \u041f\u0430\u043d\u0430 \u043b\u0430\u0441\u043a\u0430\u045e. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0432\u043e\u043b\u044e \u0411\u043e\u0433\u0430, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0440\u0430 \u0434\u043b\u044f \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0434\u043b\u044f \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f, \u043f\u0430\u043a\u0443\u043b\u044c \u043c\u0430\u0435\u043c \u0447\u0430\u0441, \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430. \u0401\u043d \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430\u0441 \u0456 \u0445\u043e\u0447\u0430 \u043d\u0430\u0441 \u043f\u0440\u044b\u043d\u044f\u0446\u044c. \u041a\u0430\u043b\u0456 \u043c\u044b \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u043c\u0441\u044f \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u043c, \u043a\u0430\u0431 \u043d\u0430\u0448\u0430\u044f \u0434\u0443\u0448\u0430 \u0441\u0442\u0430\u043b\u0430 \u0437\u0434\u0430\u0431\u044b\u0442\u043a\u0430\u043c \u0434\u0440\u044d\u043d\u043d\u044b\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e, \u043c\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u0435\u043c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0415\u0437\u0443\u0441\u0430. \u0412\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u045e\u0436\u043e \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0437\u0435\u043d\u044c \u0441\u0443\u0434\u0430, \u00ab\u043f\u0430\u043b\u0430\u044e\u0447\u044b \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u0435\u0447\u00bb (\u043f\u0430\u0440. \u041c\u0430\u043b 3, 19). \u0422\u0430\u0434\u044b \u0437\u043d\u0456\u043a\u043d\u0435 \u0447\u0430\u0441\u0442\u043a\u0430 \u043d\u0435\u0431\u0430, \u0430 \u045e\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u0440\u0430\u0441\u0442\u043e\u043f\u0456\u0446\u0446\u0430 \u044f\u043a \u0432\u043e\u043b\u0430\u0432\u0430 \u045e \u0430\u0433\u043d\u0456. \u0422\u0430\u0434\u044b \u0432\u044b\u044f\u045e\u043b\u0435\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0441\u0435 \u043b\u044e\u0434\u0441\u043a\u0456\u044f \u0447\u044b\u043d\u044b, \u044f\u043a \u0443\u043a\u0440\u044b\u0442\u044b\u044f, \u0442\u0430\u043a \u0456 \u0431\u0430\u0447\u043d\u044b\u044f. \u041c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0430 \u2013 \u0433\u044d\u0442\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f \u043f\u0430\u043a\u0443\u0442\u0430 \u0437\u0430 \u0433\u0440\u044d\u0445. \u041f\u043e\u0441\u0442 \u0431\u043e\u043b\u044c\u0448 \u0432\u0430\u0440\u0442\u044b \u0437\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0430 \u0436 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u0430\u0434\u043d\u043e, \u0456 \u0434\u0440\u0443\u0433\u043e\u0435: \u00ab\u041b\u044e\u0431\u043e\u045e \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0433\u0440\u0430\u0445\u043e\u045e\u00bb (1 \u041f 4, 8), \u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u044f\u043a\u0430\u044f \u0432\u044b\u043f\u043b\u044b\u0432\u0430\u0435 \u0437 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f, \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0443 \u0433\u044d\u0442\u044b\u0445 \u0440\u044d\u0447\u0430\u0445, \u0431\u043e \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0430 \u0437\u043c\u044f\u043d\u0448\u0430\u0435 \u0446\u044f\u0436\u0430\u0440 \u0433\u0440\u0430\u0445\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0417\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043c \u0436\u0430 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u0437 \u043d\u0430\u0441 \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u045e. \u041a\u0430\u043b\u0456 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0430\u0433\u0430\u0434 \u0430\u0434\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0430\u0434 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u044f \u0456\u0434\u0430\u043b\u0430\u043c \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0446\u044c \u0456\u0445, \u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u0432\u0430\u0436\u043d\u0430 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c, \u043a\u0430\u0431 \u0437\u0430\u0433\u0456\u043d\u0443\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u045e\u0436\u043e \u043f\u0430\u0437\u043d\u0430\u045e \u0411\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u043a\u0430\u0431 \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u0446\u044c \u0434\u0430 \u0434\u0430\u0431\u0440\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043b\u0430\u0431\u044b\u0445 \u0456 \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u045e\u0441\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0411\u0443\u0434\u0437\u0435\u043c \u0447\u044b\u043d\u0456\u0446\u044c \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042e\u0434 21; \u043f\u0430\u0440. \u0426\u0456\u0442 2, 12&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0441\u044f\u0431\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u0411\u043e\u0436\u0430\u0439 <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0447\u0430\u043a\u0430\u0439\u0446\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0434\u0437\u0435\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410\u0434\u0440\u043e\u043a\u0448\u044b\u0441\u044f \u0430\u0434 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0441\u0432\u0435\u0442\u0443, \u0436\u044b\u0432\u0456\u0446\u0435 \u045e \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456\u043c \u0436\u044b\u0446\u0446\u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0447\u0430\u043a\u0430\u0439\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"327","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0430\u045e\u0442\u0430\u0440\u0430 \u0406\u0406 \u0441\u0442.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 18, 1 \u2013 20, 5: Funk 1, 167-171)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u0430\u045e\u043d\u044f\u0446\u044c \u0443\u0447\u044b\u043d\u043a\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0411\u0443\u0434\u0437\u0435\u043c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u0434\u0437\u044f\u043a\u0443\u0435 \u0411\u043e\u0433\u0443, \u0448\u0442\u043e \u043f\u0440\u044b \u0436\u044b\u0446\u0446\u0456 \u0431\u044b\u043b\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0441\u043b\u0443\u0433\u0430\u043c\u0456, \u0430 \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0456 \u0434\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445, \u0432\u044b\u0434\u0430\u0434\u0437\u0435\u043d\u044b\u0445 \u043d\u0430 \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u0435. \u042f \u0441\u0430\u043c, \u0445\u043e\u0446\u044c \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0441\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u043c \u0456 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u045e\u0441\u044f \u0441\u043f\u0430\u043a\u0443\u0441\u0430\u045e, \u0430\u043b\u0435 \u0436\u044b\u0432\u0443 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u0441\u0442\u0430\u043a \u0441\u0430\u0442\u0430\u043d\u044b, \u0441\u0442\u0430\u0440\u0430\u044e\u0441\u044f \u0456\u0441\u0446\u0456 \u0448\u043b\u044f\u0445\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u0446\u0446\u0430 \u0434\u0430 \u044f\u0435, \u0431\u043e \u0431\u0430\u044e\u0441\u044f \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0441\u0443\u0434\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b \u0456 \u0441\u0451\u0441\u0442\u0440\u044b, \u043f\u0430\u0441\u043b\u044f \u0432\u044b\u0441\u043b\u0443\u0445\u043e\u045e\u0432\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430 \u043f\u0440\u0430\u045e\u0434\u044b \u044f \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u044e \u0434\u0430 \u0432\u0430\u0441 \u0433\u044d\u0442\u0430\u0435 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u0435, \u043a\u0430\u0431, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430\u0434 \u0442\u044b\u043c, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430, \u0432\u044b \u0437\u0431\u0430\u0432\u0456\u043b\u0456 \u0441\u044f\u0431\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0447\u044b\u0442\u0430\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0430\u043c\u0456. \u0410\u0431 \u0442\u0430\u043a\u043e\u0439 \u043f\u043b\u0430\u0446\u0435 \u044f \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u043a\u0430\u0431 \u0432\u044b \u043d\u0430\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u0436\u044b\u0446\u0446\u0451. \u0422\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0447\u044b, \u043c\u044b \u0434\u0430\u0434\u0437\u0451\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0442\u044b\u043c \u043c\u0430\u043b\u0430\u0434\u044b\u043c \u043b\u044e\u0434\u0437\u044f\u043c, \u044f\u043a\u0456\u044f \u0448\u0447\u044b\u0440\u0430 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044e \u0411\u043e\u0433\u0443 \u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u043d\u044e \u042f\u0433\u043e. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043a\u0430\u0440\u0434\u0437\u0456\u0446\u0446\u0430 \u0456 \u0433\u043d\u0435\u0432\u0430\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043d\u0430\u0441, \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445, \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0446\u044c \u0456 \u0437\u0430\u0445\u043e\u0447\u0430 \u043f\u0440\u0430\u0432\u0435\u0441\u0446\u0456 \u043d\u0430\u0441 \u0430\u0434 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0411\u043e \u0447\u0430\u0441\u0430\u043c, \u0440\u043e\u0431\u044f\u0447\u044b \u0437\u043b\u043e, \u043c\u044b \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u044f\u0441\u0442\u0430\u043b\u0430\u0441\u0446\u0456 \u0440\u043e\u0437\u0443\u043c\u0443 \u0456 \u043c\u0430\u043b\u043e\u0439 \u0432\u0435\u0440\u044b, \u0430 \u0440\u043e\u0437\u0443\u043c \u043d\u0430\u0448 \u0437\u0430\u0446\u0435\u043c\u043d\u0435\u043d\u044b \u0437\u0433\u0443\u0431\u043d\u0430\u0439 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0411\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0441\u043f\u0430\u045e\u043d\u044f\u0446\u044c \u0443\u0447\u044b\u043d\u043a\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b, \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u0435 \u0433\u044d\u0442\u044b\u044f \u043d\u0430\u043a\u0430\u0437\u044b! \u041d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441 \u0446\u0435\u0440\u043f\u044f\u0446\u044c \u0437\u043b\u043e \u045e \u0441\u0432\u0435\u0446\u0435, \u044f\u043d\u044b \u0437\u0431\u044f\u0440\u0443\u0446\u044c \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u044b \u043f\u043b\u0451\u043d \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u0431\u043e \u0434\u043b\u044f \u044f\u0433\u043e \u0430\u0434\u0432\u0435\u0434\u0437\u0435\u043d\u044b \u0447\u0430\u0441 \u0448\u0447\u0430\u0441\u0446\u044f. \u0423\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u0448\u044b \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u0440\u043e\u0434\u043a\u0430\u043c\u0456, \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0432\u0435\u0447\u043d\u0430, \u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0430\u0437\u043c\u0440\u043e\u0447\u044b\u0446\u044c \u043d\u0456\u044f\u043a\u0456 \u0441\u043c\u0443\u0442\u0430\u043a.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0440\u043e\u0441\u043f\u0430\u0447\u044b, \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u043c \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445 \u0443 \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0446\u0435, \u0430 \u0411\u043e\u0436\u044b\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456. \u0411\u0443\u0434\u0437\u0435\u043c \u043c\u0435\u0446\u044c \u0432\u0435\u0440\u0443, \u0431\u0440\u0430\u0442\u044b \u0456 \u0441\u0451\u0441\u0442\u0440\u044b; \u043d\u0430\u0441 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435 \u0436\u044b\u0432\u044b \u0411\u043e\u0433. \u0423 \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u043c\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u0451\u043c \u0443\u0446\u0456\u0441\u043a, \u043a\u0430\u0431 \u0443 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443. \u041d\u0456\u0445\u0442\u043e \u0441\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0434\u0440\u0430\u0437\u0443 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b, \u0430\u043b\u0435 \u0447\u0430\u043a\u0430\u045e \u044f\u0435. \u041a\u0430\u043b\u0456 \u0431 \u0411\u043e\u0433 \u0430\u0434\u0440\u0430\u0437\u0443 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0436\u0432\u0430\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445, \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0431 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u0433\u0430\u043d\u0434\u043b\u044e, \u0434\u0437\u0435 \u043d\u044f\u043c\u0430 \u043c\u0435\u0441\u0446\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044e. \u041d\u0430\u0448\u0430\u044f \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u0431\u044b\u043b\u0430 \u0431 \u0437\u043d\u0435\u0448\u043d\u044f\u0439, \u0431\u043e \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u043c\u044b \u0431 \u0456\u043c\u043a\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u043d\u0435\u0430\u0434\u043a\u043b\u0430\u0434\u043d\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u0430 \u043d\u0435 \u0434\u0430 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u0411\u043e\u0436\u044b \u0441\u0443\u0434 \u043d\u0435\u043f\u0430\u043a\u043e\u0456\u0446\u044c \u0456 \u0437\u043d\u044f\u0432\u043e\u043b\u044c\u0432\u0430\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410\u0434\u0437\u0456\u043d\u0430\u043c\u0443 \u0456 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0443, \u0410\u0439\u0446\u0443 \u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a\u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430\u043c \u0417\u0431\u0430\u0432\u0456\u0446\u0435\u043b\u044f \u0456 \u0414\u0430\u045e\u0446\u0443 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0431\u2019\u044f\u0432\u0456\u045e \u043d\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u0443 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 37 (36), 27\u0430. 28. 1\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0423\u0445\u0456\u043b\u044f\u0439\u0441\u044f \u0430\u0434 \u0437\u043b\u0430 \u0456 \u0447\u044b\u043d\u0456 \u0434\u0430\u0431\u0440\u043e, \u2013 \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0436\u044b\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0411\u043e \u041f\u0430\u043d \u043b\u044e\u0431\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0435 \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0441\u0432\u0430\u0456\u0445 \u0432\u0435\u0440\u043d\u044b\u0445.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u0435 \u0430\u0431\u0443\u0440\u0430\u0439\u0441\u044f \u043d\u0430 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e \u0456 \u043d\u0435 \u0437\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u0446\u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e \u041f\u0430\u043d.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"331","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 32pt; text-align: center;\"><span style=\"color: #ff0000;\">(Ps 95, 14, 15: CCL 39, 1351-1353)<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0446\u0446\u0430 \u043f\u0435\u0440\u0448\u0430\u043c\u0443 \u043f\u0440\u044b\u0439\u0441\u0446\u044e,<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u043a\u0430\u0431 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0446\u0446\u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c \u0442\u0430\u0434\u044b \u045e\u0441\u0435 \u0434\u0440\u044d\u0432\u044b \u043b\u044f\u0441\u043d\u044b\u044f. \u041f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0437\u044f\u043c\u043b\u044e\u00bb (\u041f\u0441 96 [95], 12-13). \u0423\u0436\u043e \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437 \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u0430\u043b\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0437\u043d\u043e\u045e. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u042f\u0433\u043e \u0433\u043e\u043b\u0430\u0441 \u043f\u0440\u0430\u0433\u0443\u0447\u0430\u045e \u0443 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456: \u00ab\u0421\u0451\u043d\u043d\u044f \u045e\u0431\u0430\u0447\u044b\u0446\u0435 \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430, \u044f\u043a\u0456 \u0456\u0434\u0437\u0435 \u043d\u0430 \u0430\u0431\u043b\u043e\u043a\u0430\u0445 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445\u00bb (\u041c\u0446 26, 64). \u0427\u0430\u043c\u0443 \u00ab\u0441\u0451\u043d\u043d\u044f\u00bb? \u0426\u0456 \u0436 \u041f\u0430\u043d \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043f\u0430\u0437\u043d\u0435\u0439, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u043d\u0443\u0446\u044c \u0441\u0442\u0430\u0433\u043d\u0430\u0446\u044c \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0437\u044f\u043c\u043b\u0456? \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0440\u0430\u043d\u0435\u0439 \u0443 \u0441\u0432\u0430\u0456\u0445 \u0432\u0435\u0441\u0442\u0443\u043d\u0430\u0445 \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0443\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0446\u0446\u0430 \u042f\u0433\u043e \u043f\u0435\u0440\u0448\u0430\u043c\u0443 \u043f\u0440\u044b\u0439\u0441\u0446\u044e, \u043a\u0430\u0431 \u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430 \u043d\u0430\u043c \u0434\u0440\u0443\u0433\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0442\u043e \u0436 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0440\u0430\u0431\u0456\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d? \u041d\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0441\u0432\u0435\u0442\u0443, \u0430\u043b\u0435 \u043d\u044f\u0445\u0430\u0439 \u0441\u0432\u0435\u0442 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u044f\u043c\u0443. \u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c? \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0442\u0440\u044d\u0431\u0430 \u0432\u0430\u043b\u043e\u0434\u0430\u0446\u044c \u0437\u044f\u043c\u043d\u044b\u043c\u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456 \u0442\u0430\u043a, \u043d\u0456\u0431\u044b \u0456\u0445 \u0443 \u043d\u0430\u0441 \u043d\u044f\u043c\u0430. \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: \u00ab\u042f \u043a\u0430\u0436\u0443 \u0432\u0430\u043c, \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u0447\u0430\u0441 \u043a\u0430\u0440\u043e\u0442\u043a\u0456. \u0422\u0430\u043c\u0443 \u0442\u044b\u044f, \u0445\u0442\u043e \u043c\u0430\u0435 \u0436\u043e\u043d\u0430\u043a, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043c\u0430\u0435. \u0406 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u043b\u0430\u0447\u0430, \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043f\u043b\u0430\u0447\u0430. \u0406 \u0442\u044b\u044f, \u0445\u0442\u043e \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430, \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430. \u0406 \u0442\u044b\u044f, \u0445\u0442\u043e \u043a\u0443\u043f\u043b\u044f\u0435, \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043d\u0430\u0431\u044b\u0432\u0430\u0435. \u0406 \u0442\u044b\u044f, \u0445\u0442\u043e \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u0435\u0442\u0430\u043c, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430, \u0431\u043e \u043c\u0456\u043d\u0430\u0435 \u0432\u043e\u0431\u0440\u0430\u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u042f \u0445\u0430\u0447\u0443, \u043a\u0430\u0431 \u0432\u044b \u0431\u044b\u043b\u0456 \u0431\u0435\u0441\u043a\u043b\u0430\u043f\u043e\u0442\u043d\u044b\u043c\u0456\u00bb (1 \u041a\u0430\u0440 7, 29-32). \u0422\u043e\u0439, \u0445\u0442\u043e \u0432\u043e\u043b\u044c\u043d\u044b \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u045e, \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430 \u0447\u0430\u043a\u0430\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u041f\u0430\u043d\u0430. \u0428\u0442\u043e \u0436 \u0433\u044d\u0442\u0430 \u0437\u0430 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u043c\u044b \u0431\u0430\u0456\u043c\u0441\u044f, \u0448\u0442\u043e \u0401\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435? \u041b\u044e\u0431\u0456\u043c \u042f\u0433\u043e \u0456 \u0431\u0430\u0456\u043c\u0441\u044f, \u0448\u0442\u043e \u043f\u0440\u044b\u0439\u0434\u0437\u0435. \u0426\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043b\u044e\u0431\u0456\u043c? \u0410 \u043c\u043e\u0436\u0430 \u0431\u043e\u043b\u044c\u0448 \u043b\u044e\u0431\u0456\u043c \u0441\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456? \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u0446\u044c \u0433\u0440\u0430\u0445\u0456, \u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0440\u0430\u0446\u044c \u0437\u0430 \u0433\u0440\u0430\u0445\u0456. \u0425\u043e\u0447\u0430\u043c \u0446\u0456 \u043d\u0435, \u0401\u043d \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043f\u0440\u044b\u0439\u0434\u0437\u0435. \u0422\u043e\u0435, \u0448\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0446\u044f\u043f\u0435\u0440, \u043d\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043f\u0430\u0437\u043d\u0435\u0439. \u041f\u0440\u044b\u0439\u0434\u0437\u0435, \u0430\u043b\u0435 \u0442\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0448 \u0443 \u044f\u043a\u0456 \u0447\u0430\u0441. \u041a\u0430\u043b\u0456 \u0437\u0430\u0441\u0442\u0430\u043d\u0435 \u0446\u044f\u0431\u0435 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u043c, \u0442\u0432\u0430\u0451 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u043d\u0435 \u043f\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c \u0442\u0430\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c \u0442\u0430\u0434\u044b \u045e\u0441\u0435 \u0434\u0440\u044d\u0432\u044b \u043b\u044f\u0441\u043d\u044b\u044f\u00bb. \u041f\u0440\u044b\u0439\u0448\u043e\u045e \u043f\u0435\u0440\u0448\u044b \u0440\u0430\u0437, \u0430 \u043f\u0430\u0441\u043b\u044f \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0437\u044f\u043c\u043b\u044e. \u0422\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u043f\u0430\u0434\u0447\u0430\u0441 \u042f\u0433\u043e \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f, \u00ab\u0448\u0442\u043e \u0401\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u00bb, \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0443\u0446\u044c \u042f\u0433\u043e \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u0435\u0442 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u0430 \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u044b\u00bb (\u041f\u0441 96 [95], 13). \u0428\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u00ab\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u045e\u0434\u044b\u00bb? \u0401\u043d \u0437\u0431\u044f\u0440\u044d \u0432\u0430\u043a\u043e\u043b \u0441\u044f\u0431\u0435 \u0441\u0432\u0430\u0456\u0445 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u043d\u0430 \u0441\u0443\u0434, \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u0445 \u0430\u0434\u0434\u0437\u0435\u043b\u0456\u0446\u044c. \u0410\u0434\u043d\u044b\u0445 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u0430, \u0434\u0440\u0443\u0433\u0456\u0445 \u0437\u043b\u0435\u0432\u0430. \u0428\u0442\u043e \u0436 \u0431\u043e\u043b\u044c\u0448 \u0441\u043b\u0443\u0448\u043d\u0430\u0435 \u0456 \u0448\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u043f\u0440\u044b\u0439\u0441\u0446\u0435\u043c \u0421\u0443\u0434\u0434\u0437\u0456 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0431\u044b\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u0447\u0430\u043a\u0430\u043b\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0430\u0434 \u0421\u0443\u0434\u0434\u0437\u0456, \u043a\u0430\u043b\u0456 \u0442\u043e\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435. \u0422\u044b\u044f, \u0445\u0442\u043e \u0431\u044b\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c, \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u0406 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447, \u0401\u043d \u0441\u043a\u0430\u0436\u0430: \u00ab\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u0410\u0439\u0446\u0430 \u041c\u0430\u0439\u0433\u043e, \u043f\u0440\u044b\u043c\u0456\u0446\u0435 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430\u0435 \u0432\u0430\u043c \u0430\u0434 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443\u00bb (\u041c\u0446 25, 34). \u0406 \u043f\u0440\u044b\u0433\u0430\u0434\u0430\u0435 \u045e\u0447\u044b\u043d\u043a\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456: \u00ab\u042f \u0431\u044b\u045e \u0433\u0430\u043b\u043e\u0434\u043d\u044b, \u0456 \u0432\u044b \u0434\u0430\u043b\u0456 \u041c\u043d\u0435 \u0435\u0441\u0446\u0456; \u043f\u0440\u0430\u0433\u043d\u0443\u045e, \u0456 \u0432\u044b \u043d\u0430\u043f\u0430\u0456\u043b\u0456 \u041c\u044f\u043d\u0435\u00bb \u0456 \u0433\u044d\u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0439 (\u041c\u0446 25, 35-40).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u0442\u044b\u043c, \u044f\u043a\u0456\u044f \u043b\u0435\u0432\u0430\u0440\u0443\u0447, \u0448\u0442\u043e \u043f\u0440\u044b\u0433\u0430\u0434\u0430\u0435? \u0428\u0442\u043e \u044f\u043d\u044b \u043d\u0435 \u0445\u0430\u0446\u0435\u043b\u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u0443\u0447\u044b\u043d\u043a\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u0406 \u0448\u0442\u043e \u0437 \u0456\u043c\u0456? \u00ab\u0423 \u0430\u0433\u043e\u043d\u044c \u0432\u0435\u0447\u043d\u044b\u00bb (\u041c\u0446 25, 41). \u0413\u044d\u0442\u0430\u044f \u0441\u0442\u0440\u0430\u0448\u043d\u0430\u044f \u043d\u0430\u0432\u0456\u043d\u0430 \u0432\u044b\u043a\u043b\u0456\u0447\u0430 \u0432\u044f\u043b\u0456\u043a\u0456 \u043f\u043b\u0430\u0447. \u0410\u043b\u0435 \u0448\u0442\u043e \u0436 \u043a\u0430\u0436\u0430 \u0456\u043d\u0448\u044b \u043f\u0441\u0430\u043b\u044c\u043c: \u00ab\u0423 \u0432\u0435\u0447\u043d\u0430\u0439 \u043f\u0430\u043c\u044f\u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0451\u043d \u043d\u0435 \u043f\u0430\u0431\u0430\u0456\u0446\u0446\u0430 \u0434\u0440\u044d\u043d\u043d\u0430\u0439 \u043d\u0430\u0432\u0456\u043d\u044b\u00bb (\u041f\u0441 112 [111], 6-7). \u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0430 \u0434\u0440\u044d\u043d\u043d\u0430\u044f \u043d\u0430\u0432\u0456\u043d\u0430? \u00ab\u0406\u0434\u0437\u0456\u0446\u0435 \u0430\u0434 \u041c\u044f\u043d\u0435, \u043f\u0440\u0430\u043a\u043b\u044f\u0442\u044b\u044f, \u0443 \u0430\u0433\u043e\u043d\u044c \u0432\u0435\u0447\u043d\u044b, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b \u0434\u2019\u044f\u0431\u043b\u0443 \u0456 \u0430\u043d\u0451\u043b\u0430\u043c \u044f\u0433\u043e\u043d\u044b\u043c\u00bb (\u041c\u0446 25, 41). \u041a\u0430\u0433\u043e \u045e\u0437\u0440\u0430\u0434\u0443\u0435 \u0434\u043e\u0431\u0440\u0430\u044f \u043d\u0430\u0432\u0456\u043d\u0430, \u0442\u043e\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0431\u0430\u044f\u0446\u0446\u0430 \u0434\u0440\u044d\u043d\u043d\u0430\u0439. \u0412\u043e\u0441\u044c \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u00ab\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u00bb, \u0432\u043e\u0441\u044c \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u00ab\u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u045e\u0434\u044b\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0426\u0456 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0442\u044b \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0421\u0443\u0434\u0434\u0437\u044f \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c? \u0426\u0456 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0442\u044b \u043f\u0430\u0434\u043c\u0430\u043d\u0448\u0447\u044b\u043a, \u041f\u0440\u0430\u045e\u0434\u0430 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0443? \u041a\u0430\u043b\u0456 \u0442\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0445\u043e\u0447\u0430\u0448 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0431\u0443\u0434\u0437\u044c \u0456 \u0442\u044b \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c. \u041f\u0440\u0430\u0431\u0430\u0447, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0446\u044f\u0431\u0435 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u045e; \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u0441\u044f \u0442\u044b\u043c, \u0448\u0442\u043e \u043c\u0430\u0435\u0448 \u0437 \u043b\u0456\u0448\u043a\u0430\u043c. \u0414\u0430\u0440\u044d\u0447\u044b, \u0447\u044b\u043c \u0442\u044b \u0434\u0437\u0435\u043b\u0456\u0448\u0441\u044f, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u044b\u043c, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0434 \u041f\u0430\u043d\u0430? \u041a\u0430\u043b\u0456 \u0431 \u0434\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0451, \u0442\u043e \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u0430 \u0431 \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u044c \u0437 \u0442\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u043a\u0443, \u0430\u043b\u0435 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0435\u0448 \u042f\u0433\u043e \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c, \u0442\u0432\u043e\u0439 \u0447\u044b\u043d \u2013 \u0433\u044d\u0442\u0430 \u0430\u0434\u0434\u0430\u0432\u0430\u043d\u043d\u0435. \u00ab\u0428\u0442\u043e \u0436 \u043c\u0430\u0435\u0448 \u0442\u044b, \u0447\u0430\u0433\u043e \u0431 \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u045e?\u00bb (1 \u041a\u0430\u0440 4, 7). \u0412\u043e\u0441\u044c \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u043c\u0456\u043b\u044b\u044f \u0411\u043e\u0433\u0443 \u0430\u0445\u0432\u044f\u0440\u044b: \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u043f\u0430\u043a\u043e\u0440\u0430, \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e, \u0441\u043f\u0430\u043a\u043e\u0439, \u043b\u044e\u0431\u043e\u045e. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0456\u0445, \u0442\u043e \u045e \u0441\u043f\u0430\u043a\u043e\u0456 \u043c\u043e\u0436\u0430\u043c \u0447\u0430\u043a\u0430\u0446\u044c \u0421\u0443\u0434\u0434\u0437\u044e, \u044f\u043a\u0456 \u00ab\u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u0435\u0442 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u0430 \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u044b\u00bb (\u041f\u0441 96 [95], 13).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0430\u0446 16, 27; \u041f\u0441 96 (95), 13b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041f\u0440\u044b\u0439\u0434\u0437\u0435 \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u045e \u0441\u043b\u0430\u0432\u0435 \u0410\u0439\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0437 \u0430\u043d\u0451\u043b\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0442\u0430\u0434\u044b \u0430\u0434\u0434\u0430\u0441\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u0435\u0442 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u0430 \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0442\u0430\u0434\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"332","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u041f\u0440\u0430 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e\u00bb&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0441\u0432. \u0424\u0443\u043b\u044c\u0433\u0435\u043d\u0442\u044b\u044f \u0420\u0443\u0441\u043f\u0435\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 32pt; text-align: center;\"><span style=\"color: #ff0000;\">(Liber 2, 11, 2 \u2013 12, 1, 3-4: CCL 91 A, 693-695)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0443 \u0434\u0440\u0443\u0433\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0448\u043a\u043e\u0434\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0423 \u0456\u043c\u0433\u043d\u0435\u043d\u043d\u0435 \u0432\u043e\u043a\u0430, \u043d\u0430 \u0433\u0443\u043a \u0430\u043f\u043e\u0448\u043d\u044f\u0439 \u0442\u0440\u0443\u0431\u044b. \u041a\u0430\u043b\u0456 \u044f\u043d\u0430 \u0437\u0430\u0433\u0443\u0447\u044b\u0446\u044c, \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u044f\u043a \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u044b\u044f, \u0430 \u043c\u044b \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u043c\u0441\u044f\u00bb (1 \u041a\u0430\u0440 15, 52). \u041a\u0430\u0436\u0443\u0447\u044b \u00ab\u043c\u044b\u00bb, \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u0448\u0442\u043e \u0434\u0430\u0440 \u0431\u0443\u0434\u0443\u0447\u0430\u0439 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u0443\u0441\u0435, \u0445\u0442\u043e \u0446\u044f\u043f\u0435\u0440, \u044f\u043a \u0451\u043d \u0456 \u044f\u0433\u043e \u0441\u044f\u0431\u0440\u044b, \u0432\u044f\u0434\u0437\u0435 \u0441\u0432\u044f\u0442\u043e\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0420\u0430\u0437\u2019\u044f\u0441\u043d\u044f\u044e\u0447\u044b \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0433\u044d\u0442\u0430\u0439 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u044b, \u0451\u043d \u043a\u0430\u0436\u0430: \u00ab\u0422\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0442\u043b\u0435\u043d\u043d\u0430\u0435 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0430\u0441\u044f \u045e \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c, \u0430 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0430\u0441\u044f \u045e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c\u00bb (1 \u041a\u0430\u0440 15, 53). \u0414\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0437\u043c\u0430\u0433\u043b\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u0456\u0446\u044c \u0443 \u043b\u044e\u0434\u0437\u044f\u0445 \u0433\u044d\u0442\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0430, \u044f\u043a\u0430\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0439 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430\u0439, \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0446\u044f\u043f\u0435\u0440 \u0430\u043f\u044f\u0440\u044d\u0434\u0437\u0456\u043b\u0430 \u044f\u0435 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0430, \u044f\u043a\u0430\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u0439 \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u0442\u044b\u044f, \u0445\u0442\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u045e\u0441\u044f, \u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e \u0430\u0434 \u0437\u043b\u0430 \u0434\u0430 \u0434\u0430\u0431\u0440\u0430, \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443, \u0430 \u0431\u0443\u0434\u0437\u0435 \u0451\u0439 \u0431\u0443\u0434\u0443\u0447\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0456\u0445 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u0430\u0441\u0446\u044b: \u0411\u043e\u0436\u044b \u0434\u0430\u0440 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u044b \u0440\u0430\u0441\u043f\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435\u043c, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u043c\u0443 \u043c\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0430\u0435\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u0430. \u0417\u0430\u0442\u044b\u043c \u0432\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0456 \u0446\u0435\u043b\u0430\u045e, \u044f\u043a\u043e\u0435 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445, \u0441\u0442\u0430\u043d \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0456 \u043d\u0435 \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u0435 \u043d\u0456\u044f\u043a\u0456\u043c \u0437\u043c\u0435\u043d\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0430 \u043f\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u0437 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u0434\u043b\u044f \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f. \u041f\u0440\u0430\u0437 \u044f\u0433\u043e \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0445\u043e\u0434 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f, \u0430\u0434 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u0434 \u043d\u044f\u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456 \u0434\u0430 \u0432\u0435\u0440\u044b, \u0430\u0434 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u0434\u0440\u044d\u043d\u043d\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e \u0434\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u045e. \u0422\u044b\u044f, \u0445\u0442\u043e \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u043d\u0435 \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u044e\u0446\u044c \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u043c\u0435\u0440\u0446\u0456. \u041f\u0440\u0430 \u0456\u0445 \u0443 \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0456 \u0441\u0432\u044f\u0442\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u0434\u0437\u0435\u043b \u0443 \u043f\u0435\u0440\u0448\u044b\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0456! \u0414\u0440\u0443\u0433\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u043d\u0430\u0434 \u0456\u043c\u0456 \u045e\u043b\u0430\u0434\u044b\u00bb (\u0410\u043f 20, 6). \u0423 \u0433\u044d\u0442\u0430\u0439 \u0436\u0430 \u043a\u043d\u0456\u0437\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u00ab\u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430 \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u0435 \u0448\u043a\u043e\u0434\u044b \u0430\u0434 \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u043c\u0435\u0440\u0446\u0456\u00bb (\u0410\u043f 2, 11). \u042f\u043a \u043f\u0435\u0440\u0448\u0430\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0456 \u0441\u044d\u0440\u0446\u0430, \u0442\u0430\u043a \u0434\u0440\u0443\u0433\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c \u2013 \u0443 \u0432\u0435\u0447\u043d\u044b\u043c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u043c\u0435\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u043f\u0435\u0440\u0448\u044b\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0456, \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430 \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0443\u0446\u044c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0434\u0440\u0443\u0433\u043e\u0439 \u0441\u043c\u0435\u0440\u0446\u044e. \u0411\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u045e\u0448\u044b\u0441\u044f \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0436\u0430\u0439, \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0434 \u0434\u0440\u044d\u043d\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u0434\u043e\u0431\u0440\u0430\u0433\u0430, \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f, \u0430 \u043f\u0430\u0441\u043b\u044f \u0456\u0445 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435 \u0437\u0430\u043c\u0435\u043d\u0456\u0446\u0446\u0430 \u045e \u0445\u0432\u0430\u043b\u0443.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041a\u043b\u0441 3, 3-4; \u0420\u044b\u043c 6, 11\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0456 \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u0411\u043e\u0433\u0443. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041a\u0430\u043b\u0456 \u0436 \u0437\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435, \u0442\u0430\u0434\u044b \u0456 \u0432\u044b \u0437\u2019\u044f\u0432\u0456\u0446\u0435\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443 \u0445\u0432\u0430\u043b\u0435.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0422\u0430\u043a \u0456 \u0432\u044b \u043b\u0456\u0447\u044b\u0446\u0435 \u0441\u044f\u0431\u0435 \u043c\u0451\u0440\u0442\u0432\u044b\u043c\u0456 \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443, \u0430 \u0436\u044b\u0432\u044b\u043c\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u043b\u0456 \u0436 \u0437\u2019\u044f\u0432\u0456\u0446\u0446\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"333","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0440\u0430\u043c\u043e\u0432\u0430 \u0441\u0432. \u0410\u043d\u0434\u0440\u044d\u044f \u041a\u0440\u044b\u0446\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Orat. 9, in ramos palmarum: PG 97, 1002)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u043e\u0441\u044c \u043a\u0430\u0440\u043e\u043b\u044c \u0442\u0432\u043e\u0439 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0456 \u0437\u0431\u0430\u045e\u0447\u044b<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0406 \u043c\u044b \u0441\u043a\u0430\u0436\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443, \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u044e\u0447\u044b: \u00ab\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430\u00bb (\u041c\u0446 21, 9), \u00ab\u043a\u0430\u0440\u043e\u043b\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f\u00bb (\u041c\u0446 27, 42). \u042f\u043a \u043f\u0430\u043b\u044c\u043c\u0430\u0432\u044b\u044f \u0433\u0430\u043b\u0456\u043d\u043a\u0456, \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0451\u043c \u043f\u0430\u0434 \u042f\u0433\u043e\u043d\u044b\u044f \u043d\u043e\u0433\u0456 \u0441\u043b\u043e\u0432\u044b, \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u044b\u044f \u043d\u0430 \u043a\u0440\u044b\u0436\u044b. \u0411\u0443\u0434\u0437\u0435\u043c \u0443\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u043b\u0456\u045e\u043a\u0430\u0432\u044b\u043c\u0456 \u0433\u0430\u043b\u0456\u043d\u043a\u0430\u043c\u0456, \u0430\u043b\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u044f\u043a\u0430\u044f \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456. \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u042f\u0433\u043e\u043d\u0430\u0439 \u0432\u043e\u043f\u0440\u0430\u0442\u0446\u044b, \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043c \u043b\u044f \u042f\u0433\u043e\u043d\u044b\u0445 \u043d\u043e\u0433 \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u0431, \u043f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b \u0434\u0430 \u043d\u0430\u0441, \u0401\u043d \u0443\u0432\u0435\u0441\u044c \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u045e \u043d\u0430\u0441, \u0430 \u043c\u044b \u0446\u0430\u043b\u043a\u0430\u043c \u0443 \u0406\u043c, \u0456 \u043a\u0430\u0431 \u0401\u043d \u0443\u0432\u0435\u0441\u044c \u0430\u0431\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u045e \u043d\u0430\u0441. \u041f\u0430\u045e\u0442\u043e\u0440\u044b\u043c \u0434\u043b\u044f \u0421\u0456\u0451\u043d\u0430 \u0437\u0430\u043a\u043b\u0456\u043a \u043f\u0440\u0430\u0440\u043e\u043a\u0430: \u00ab\u0421\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0439\u0441\u044f, \u0434\u0430\u0447\u043a\u0430 \u0421\u0456\u0451\u043d\u0430, \u043d\u0435 \u0431\u043e\u0439\u0441\u044f: \u0432\u043e\u0441\u044c \u043a\u0430\u0440\u043e\u043b\u044c \u0442\u0432\u043e\u0439 \u0456\u0434\u0437\u0435 \u0434\u0430 \u0446\u044f\u0431\u0435, \u043f\u0430\u043a\u043e\u0440\u043d\u044b, \u044f\u043a\u0456 \u0435\u0434\u0437\u0435 \u043d\u0430 \u0430\u0441\u043b\u0435, \u043d\u0430 \u0430\u0441\u043b\u044f\u043d\u044f\u0446\u0456, \u0434\u0437\u0456\u0446\u044f\u0446\u0456 \u0430\u0441\u043b\u0456\u0446\u044b\u00bb (\u043f\u0430\u0440. \u0417\u0430\u0445 9, 9).<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u043e\u0439, \u0445\u0442\u043e \u045e\u0441\u044e\u0434\u044b \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435, \u0445\u0442\u043e \u045e\u0441\u0451 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u043a\u0430\u0431 \u0443 \u0442\u0430\u0431\u0435 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u041f\u0440\u044b\u0431\u044b\u0432\u0430\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u00ab\u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u043d\u0435 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e, \u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e\u00bb (\u041c\u0446 9, 13); \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434\u0432\u0435\u0441\u0446\u0456 \u0430\u0434 \u0433\u0440\u0430\u0445\u0443 \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u044b\u0445. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0431\u043e\u0439\u0441\u044f: \u00ab\u0411\u043e\u0433 \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0431\u0435, \u0442\u0430\u043c\u0443 \u043d\u0435 \u043f\u0430\u0445\u0456\u0441\u043d\u0435\u0448\u0441\u044f\u00bb (\u0414\u0440\u0433 7, 21).<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0417 \u0443\u0437\u043d\u044f\u0442\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456 \u043f\u0440\u044b\u043c\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u0440\u0443\u043a\u0430\u0445 \u0443\u0437\u0432\u0451\u045e \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0430\u0431\u0430\u0440\u043e\u043d\u0447\u044b \u043c\u0443\u0440; \u043f\u0440\u044b\u043c\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u0434\u0430\u043b\u043e\u043d\u044f\u0445 \u043f\u0430\u043a\u043b\u0430\u045e \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a. \u041f\u0440\u044b\u043c\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u045e\u0441\u0451, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435, \u0437\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435\u043c \u0433\u0440\u0430\u0445\u0443. \u0420\u0430\u0434\u0443\u0439\u0441\u044f, \u043e \u041c\u0430\u0446\u0456; \u0433\u043e\u0440\u0430\u0434 \u0421\u0456\u0451\u043d, \u043d\u0435 \u0431\u043e\u0439\u0441\u044f, \u00ab\u0410\u0434\u0437\u043d\u0430\u0447\u0430\u0439 \u0441\u0432\u044f\u0442\u044b \u0441\u0432\u0430\u0435\u00bb (\u041d\u0432\u043c 2, 1). \u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u043d\u0430\u0441 \u0443 \u0442\u0430\u0431\u0435. \u0410\u043b\u0435 \u0456 \u0442\u044b, \u0434\u0430\u0447\u043a\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u0440\u0430\u0434\u0443\u0439\u0441\u044f \u043c\u043e\u0446\u043d\u0430, \u0441\u043f\u044f\u0432\u0430\u0439 \u0456 \u0442\u0430\u043d\u0446\u0443\u0439. \u00ab\u0423\u0441\u0442\u0430\u043d\u044c, \u0441\u0432\u044f\u0446\u0456\u0441\u044f, \u2013 \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u043c\u044b \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456, \u2013 \u0431\u043e \u043f\u0440\u044b\u0439\u0448\u043b\u043e \u0442\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e, \u0456 \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u045e\u0437\u044b\u0448\u043b\u0430 \u043d\u0430\u0434 \u0442\u0430\u0431\u043e\u044e\u00bb (\u0406\u0441 60, 1).<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0428\u0442\u043e \u0436 \u0433\u044d\u0442\u0430 \u0437\u0430 \u0441\u0432\u044f\u0442\u043b\u043e? \u0422\u043e\u0435, \u00ab\u044f\u043a\u043e\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0441\u0432\u0435\u0442\u00bb (\u042f\u043d 1, 9). \u0421\u0432\u044f\u0442\u043b\u043e \u0432\u0435\u0447\u043d\u0430\u0435, \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0430-\u0437\u0430 \u0447\u0430\u0441\u0430\u043c, \u044f\u043a\u043e\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u045e \u0447\u0430\u0441\u0435, \u0441\u0432\u044f\u0442\u043b\u043e, \u0430\u0431\u2019\u044f\u045e\u043b\u0435\u043d\u0430\u0435 \u045e \u0446\u0435\u043b\u0435, \u043f\u0430 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u044b\u0440\u043e\u0434\u0437\u0435 \u0437\u0430\u043a\u0440\u044b\u0442\u0430\u0435, \u0441\u0432\u044f\u0442\u043b\u043e, \u044f\u043a\u043e\u0435 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u043f\u0430\u0441\u0442\u0443\u0445\u043e\u045e \u0456 \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u0434\u043b\u044f \u041c\u0443\u0434\u0440\u0430\u0446\u043e\u045e. \u0413\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u043b\u043e, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u043d\u0430 \u0441\u0432\u0435\u0446\u0435 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0435 \u0431\u044b\u045e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0441\u0432\u0435\u0442, \u0430\u043b\u0435 \u044f\u043a\u043e\u0433\u0430 \u0441\u0432\u0435\u0442 \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e. \u0413\u044d\u0442\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0440\u044b\u0439\u0448\u043b\u043e \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0443\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0441\u0432\u0430\u0435 \u042f\u0433\u043e \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u00ab\u0425\u0432\u0430\u043b\u0430 \u041f\u0430\u043d\u0430\u00bb. \u042f\u043a\u0430\u044f \u0445\u0432\u0430\u043b\u0430? \u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0451\u044e \u043a\u0440\u044b\u0436, \u043d\u0430 \u044f\u043a\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0431\u044b\u045e \u0443\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b. \u0401\u043d, \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0445\u0432\u0430\u043b\u044b \u0410\u0439\u0446\u0430, \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u043f\u044f\u0440\u044d\u0434\u0430\u0434\u043d\u0456 \u0441\u0432\u0430\u0451\u0439 \u043c\u0443\u043a\u0456: \u00ab\u0426\u044f\u043f\u0435\u0440 \u0443\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0430 \u0411\u043e\u0433 \u0443\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u045e \u0406\u043c, \u0456 \u0445\u0443\u0442\u043a\u0430 \u045e\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u042f\u0433\u043e\u00bb (\u043f\u0430\u0440. \u042f\u043d 13, 31-32). \u0423 \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u0445\u0432\u0430\u043b\u043e\u044e \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u0432\u0430\u0451 \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u0435 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b. \u0411\u043e \u043a\u0440\u044b\u0436 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u043e\u044e \u0456 \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430. \u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: \u00ab\u042f, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u045e\u0437\u043d\u044f\u0442\u044b \u043d\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u044e, \u0443\u0441\u0456\u0445 \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443 \u0434\u0430 \u0441\u044f\u0431\u0435\u00bb (\u042f\u043d 12, 32).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 118 (117), 26\u0430. 27\u0430. 23\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u0456 \u0401\u043d \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u043d\u0430\u0441.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0442\u0430\u043a, \u2013 \u0456 \u0434\u0437\u0456\u045e\u043d\u0430 \u0433\u044d\u0442\u0430 \u045e \u0432\u0430\u0447\u0430\u0445 \u043d\u0430\u0448\u044b\u0445.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041f\u0430\u043d \u0451\u0441\u0446\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"334","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 21, 1-4: CCL 41, 276-278)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u045e\u0437\u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u00ab\u0410 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u045e\u0437\u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u043f\u0440\u044b\u0442\u0443\u043b\u043a\u0443 \u045e \u0406\u043c, \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u044f\u0446\u0446\u0430 \u045e\u0441\u0435 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c\u00bb (\u041f\u0441 64 [63], 11). \u041c\u044b \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0443\u0441\u043d\u0430\u043c\u0456, \u0430\u043b\u0435 \u0456 \u0441\u044d\u0440\u0446\u0430\u043c. \u0422\u0430\u043a\u0456\u044f \u0441\u043b\u043e\u0432\u044b \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0440\u043e\u0437\u0443\u043c \u0456 \u044f\u0437\u044b\u043a \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430. \u00ab\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u045e\u0437\u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430\u00bb \u043d\u0435 \u0441\u0432\u0435\u0442\u0443, \u0430\u043b\u0435 \u00ab\u045e \u041f\u0430\u043d\u0443\u00bb. \u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u0421\u0432\u044f\u0442\u043b\u043e \u0437\u0437\u044f\u0435 \u0434\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430, \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u2013 \u0434\u043b\u044f \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u043c\u00bb (\u041f\u0441 97 [96], 11). \u0421\u043f\u044b\u0442\u0430\u0435\u0448\u0441\u044f, \u0430\u0434\u043a\u0443\u043b\u044c \u0433\u044d\u0442\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439: \u00ab\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u045e\u0437\u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443\u00bb. \u0410 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b: \u00ab\u0420\u0430\u0434\u0443\u0439\u0441\u044f \u045e \u041f\u0430\u043d\u0443, \u2013 \u0456 \u0401\u043d \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430\u00bb (\u041f\u0441 37 [36], 4).<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0428\u0442\u043e \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u043c \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b? \u0428\u0442\u043e \u043f\u0440\u0430\u043f\u0430\u043d\u0443\u044e\u0446\u044c? \u042f\u043a\u0456 \u0437\u0430\u0433\u0430\u0434 \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u044b \u045e \u0433\u044d\u0442\u044b\u043c \u0432\u044b\u0440\u0430\u0437\u0435? \u042f\u043a\u0456 \u0434\u0430\u0440? \u041a\u0430\u0431 \u043c\u044b \u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u045e \u041f\u0430\u043d\u0443. \u0425\u0442\u043e \u0436 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u0447\u0430\u0433\u043e \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c? \u0426\u0456 \u0431\u0430\u0447\u044b\u043c \u043c\u044b \u041f\u0430\u043d\u0430? \u0413\u044d\u0442\u0430 \u043f\u0440\u0430\u0434\u043c\u0435\u0442 \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456. \u0411\u043e \u0446\u044f\u043f\u0435\u0440 \u043c\u044b \u00ab\u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435\u043c \u0443 \u0446\u0435\u043b\u0435, \u043c\u044b \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u041f\u0430\u043d\u0430, \u0431\u043e \u0436\u044b\u0432\u0451\u043c \u0432\u0435\u0440\u0430\u044e\u00bb (2 \u041a\u0430\u0440 5, 6-7). \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u044b, \u0430 \u043d\u0435 \u043f\u0440\u0430\u0437 \u0431\u0430\u0447\u0430\u043d\u043d\u0435. \u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0431\u0430\u0447\u0430\u043d\u043d\u0435? \u041a\u0430\u043b\u0456 \u0441\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u044b \u0441\u0432. \u042f\u043d\u0430: \u00ab\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0446\u044f\u043f\u0435\u0440 \u043c\u044b \u0434\u0437\u0435\u0446\u0456 \u0411\u043e\u0436\u044b\u044f, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u043d\u0435 \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f, \u0447\u044b\u043c \u0431\u0443\u0434\u0437\u0435\u043c. \u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0401\u043d \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u0446\u0430, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u043c \u042f\u0433\u043e \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c\u00bb (1 \u042f\u043d 3, 2).<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0422\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0441\u0442\u0430\u043d\u0435 \u043f\u043e\u045e\u043d\u0430\u0439 \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439; \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u043f\u043e\u045e\u043d\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c: \u043d\u0430\u0441 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e\u0436\u043e \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044f, \u0430\u043b\u0435 \u043c\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043c\u0441\u044f \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044e. \u0426\u044f\u043f\u0435\u0440, \u0430\u0434\u043d\u0430\u043a, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u044f\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c, \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443. \u041d\u0435\u043c\u0430\u043b\u043e\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0434\u0437\u0435\u044f, \u0437\u0430 \u044f\u043a\u043e\u0439 \u0456\u0434\u0437\u0435 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0426\u044f\u043f\u0435\u0440 \u043c\u044b \u043b\u044e\u0431\u0456\u043c \u0443 \u043d\u0430\u0434\u0437\u0435\u0456. \u0422\u0430\u043c\u0443 \u043f\u0441\u0430\u043b\u044c\u043c \u043a\u0430\u0436\u0430: \u00ab\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u045e\u0437\u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443\u00bb, \u0430 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f\u0448\u0447\u044d \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u0456, \u0430\u0434\u0440\u0430\u0437\u0443 \u0434\u0430\u0434\u0430\u0435: \u00ab\u0431\u0443\u0434\u0437\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u043f\u0440\u044b\u0431\u0435\u0436\u044b\u0448\u0447\u0430 \u045e \u0406\u043c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u0456 \u0446\u044f\u043f\u0435\u0440 \u043c\u044b \u045e\u0436\u043e \u043a\u0430\u0448\u0442\u0443\u0435\u043c \u0437\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0434\u0443\u0445\u0430, \u0430 \u043c\u043e\u0436\u0430 \u0456 \u0431\u043e\u043b\u044c\u0448; \u043c\u044b \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u043c\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043b\u044e\u0431\u0456\u043c. \u0423\u0436\u043e \u0446\u044f\u043f\u0435\u0440, \u0445\u043e\u0446\u044c \u043d\u044f\u0437\u043d\u0430\u0447\u043d\u0430, \u043c\u044b \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u0435\u043c\u0441\u044f \u0456 \u043a\u0430\u0448\u0442\u0443\u0435\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0456 \u043f\u0456\u0446\u044c \u0437 \u0430\u0441\u0430\u043b\u043e\u0434\u0430\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u042f\u043a \u0436\u0430 \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u043d\u0430\u0441? \u0401\u043d \u043d\u0435 \u0434\u0430\u043b\u0451\u043a\u0430! \u0410 \u043a\u0430\u043b\u0456 \u0434\u0430\u043b\u0451\u043a\u0430, \u0442\u043e \u043f\u0430 \u0442\u0432\u0430\u0451\u0439 \u0432\u0456\u043d\u0435. \u041b\u044e\u0431\u0456 \u042f\u0433\u043e, \u0456 \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0456\u0437\u043a\u0430; \u043b\u044e\u0431\u0456, \u0456 \u0401\u043d \u043f\u0430\u0441\u0435\u043b\u0456\u0446\u0446\u0430 \u045e \u0442\u0430\u0431\u0435. \u00ab\u041f\u0430\u043d \u0431\u043b\u0456\u0437\u043a\u0430. \u041d\u0456 \u043f\u0440\u0430 \u0448\u0442\u043e \u043d\u0435 \u0442\u0443\u0440\u0431\u0443\u0439\u0446\u0435\u0441\u044f\u00bb (\u0424\u043b\u043f 4, 5-6). \u0425\u043e\u0447\u0430\u0448 \u0432\u0435\u0434\u0430\u0446\u044c, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0401\u043d \u0437 \u0442\u0430\u0431\u043e\u044e, \u043a\u0430\u043b\u0456 \u0442\u044b \u043b\u044e\u0431\u0456\u0448 \u042f\u0433\u043e? \u00ab\u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u043b\u044e\u0431\u043e\u045e\u00bb (1 \u042f\u043d 4, 8).<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0417\u0430\u043f\u044b\u0442\u0430\u0435\u0448: \u00ab\u0428\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u043b\u044e\u0431\u043e\u045e?\u00bb \u041b\u044e\u0431\u043e\u045e \u2013 \u0433\u044d\u0442\u0430 \u0446\u043d\u043e\u0442\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u043c\u044b \u043b\u044e\u0431\u0456\u043c. \u0428\u0442\u043e \u043b\u044e\u0431\u0456\u043c? \u041d\u0435\u0432\u044b\u043c\u043e\u045e\u043d\u0430\u0435 \u0414\u0430\u0431\u0440\u043e. \u0412\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u0435 \u0414\u0430\u0431\u0440\u043e. \u0414\u0430\u0431\u0440\u043e, \u044f\u043a\u043e\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430. \u0401\u043d \u0441\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0442\u0432\u0430\u0451\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0442\u043e\u0439, \u0430\u0434 \u043a\u0430\u0433\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0442\u0430\u0431\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c. \u042f \u043d\u0435 \u043a\u0430\u0436\u0443 \u043f\u0440\u0430 \u0433\u0440\u044d\u0445, \u0431\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u042f\u0433\u043e \u043d\u044f\u043c\u0430. \u0422\u044b \u043c\u0430\u0435\u0448 \u0430\u0434 \u042f\u0433\u043e \u045e\u0441\u0451, \u0448\u0442\u043e \u043c\u0430\u0435\u0448, \u0437\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435\u043c \u0433\u0440\u0430\u0445\u0443.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0435\u0440\u0448, \u0447\u044b\u043c \u0443\u0431\u0430\u0447\u044b\u0448 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0446\u044f\u043f\u0435\u0440 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u043d\u0435 \u043c\u043e\u0436\u0430\u0448, \u043f\u0430\u0432\u0435\u0440, \u0448\u0442\u043e \u0445\u0443\u0442\u043a\u0430 \u0433\u044d\u0442\u0430 \u045e\u0431\u0430\u0447\u044b\u0448.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0416\u044b\u0432\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u044b, \u043a\u0430\u0431 \u0437\u043c\u043e\u0433 \u0443\u0431\u0430\u0447\u044b\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u043b\u0456 \u0432\u0435\u0440\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0442\u0432\u0430\u0456\u043c \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c \u0443 \u0434\u0430\u0440\u043e\u0437\u0435, \u043d\u0435 \u0434\u043e\u0439\u0434\u0437\u0435\u0448 \u0434\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0433\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u045e \u043d\u0435\u0431\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0416\u044b\u0432\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"335","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u041f\u0435\u0441\u043d\u0456 \u043f\u0435\u0441\u043d\u044f\u045e\u00bb \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0437\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 2: PG 44, 802)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u0434\u0430 \u0414\u043e\u0431\u0440\u0430\u0433\u0430 \u041f\u0430\u0441\u0442\u044b\u0440\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0437\u0435 \u043f\u0430\u0441\u0432\u0456\u0448, \u0414\u043e\u0431\u0440\u044b \u041f\u0430\u0441\u0442\u044b\u0440, \u044f\u043a\u0456 \u043d\u043e\u0441\u0456\u0448 \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u043f\u043b\u044f\u0447\u0430\u0445 \u0443\u0432\u0435\u0441\u044c \u0441\u0442\u0430\u0442\u0430\u043a? (\u0411\u043e \u045e\u0441\u0451 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u2013 \u0433\u044d\u0442\u0430 \u0430\u0432\u0435\u0447\u043a\u0430, \u044f\u043a\u0443\u044e \u0442\u044b \u045e\u0437\u044f\u045e \u043d\u0430 \u043f\u043b\u0435\u0447\u044b). \u041f\u0430\u043a\u0430\u0436\u044b \u043c\u043d\u0435 \u043c\u0435\u0441\u0446\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443, \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u043d\u0430 \u0434\u043e\u0431\u0440\u0443\u044e \u0456 \u0441\u044b\u0442\u0443\u044e \u043f\u0430\u0448\u0443, \u043f\u0430\u043a\u043b\u0456\u0447 \u043c\u044f\u043d\u0435 \u043f\u0430 \u0456\u043c\u0435\u043d\u0456, \u043a\u0430\u0431 \u044f, \u0422\u0432\u0430\u044f \u0430\u0432\u0435\u0447\u043a\u0430, \u043f\u0430\u0447\u0443\u043b\u0430 \u0422\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u0433\u043e\u043b\u0430\u0441\u0443 \u043c\u0430\u0433\u043b\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u00ab\u041f\u0430\u043a\u0430\u0436\u044b \u043c\u043d\u0435 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0422\u0432\u0430\u044f \u0434\u0443\u0448\u0430\u00bb (\u0426\u0456\u0442 1, 6 Vlg).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u044f \u043a\u043b\u0456\u0447\u0443 \u0426\u044f\u0431\u0435, \u0431\u043e \u0456\u043c\u044f \u0422\u0432\u0430\u0451 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0456\u043c\u044f \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435, \u0430 \u045e\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u043f\u0440\u044b\u0440\u043e\u0434\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043d\u0456 \u0432\u044b\u043c\u0430\u0432\u0456\u0446\u044c \u0433\u044d\u0442\u0430\u0435 \u0456\u043c\u044f, \u043d\u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u044f\u0433\u043e. \u0422\u0432\u0430\u0451 \u0456\u043c\u044f, \u0443 \u044f\u043a\u0456\u043c \u0432\u044b\u0440\u0430\u0436\u0430\u043d\u0430 \u0422\u0432\u0430\u044f \u0434\u0430\u0431\u0440\u044b\u043d\u044f, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043c\u0430\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0426\u044f\u0431\u0435. \u042f\u043a \u0436\u0430 \u044f \u043c\u0430\u0433\u0443 \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0426\u044f\u0431\u0435, \u044f\u043a\u0456 \u0442\u0430\u043a \u043c\u043e\u0446\u043d\u0430 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u044f\u043d\u0435, \u0445\u043e\u0446\u044c \u044f \u0431\u044b\u043b\u0430 \u0447\u043e\u0440\u043d\u0430\u0439, \u0448\u0442\u043e \u0430\u0434\u0434\u0430\u045e \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0437\u0430 \u0430\u0432\u0435\u0447\u043a\u0443 \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u0448\u044b. \u041d\u0435\u043b\u044c\u0433\u0430 \u0441\u0430\u0431\u0435 \u045e\u044f\u0432\u0456\u0446\u044c \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0437\u0430 \u0433\u044d\u0442\u0443\u044e: \u0430\u0434\u0434\u0430\u0446\u044c \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0434\u0437\u0435\u043b\u044f \u043c\u0430\u0439\u0433\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043a\u0430\u0436\u044b \u043c\u043d\u0435, \u0434\u0437\u0435 \u0422\u044b \u043f\u0430\u0441\u0432\u0456\u0448, \u043a\u0430\u0431 \u044f, \u0430\u0434\u0448\u0443\u043a\u0430\u045e\u0448\u044b \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u0443\u044e \u043f\u0430\u0448\u0443, \u043c\u0430\u0433\u043b\u0430 \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u0446\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0430\u043c. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u044f\u0433\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c, \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u045e \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u0421\u043a\u0430\u0436\u044b, \u043a\u0430\u0431, \u043f\u0440\u044b\u0431\u0435\u0433\u0448\u044b \u0434\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u044f \u043c\u0430\u0433\u043b\u0430 \u0437\u0430\u0447\u044d\u0440\u043f\u043d\u0443\u0446\u044c \u0411\u043e\u0436\u044b \u043d\u0430\u043f\u043e\u0439. \u0422\u044b \u0441\u0430\u043c \u0434\u0430\u0435\u0448 \u044f\u0433\u043e \u0441\u0430\u0441\u043c\u044f\u0433\u043b\u044b\u043c \u043d\u0456\u0431\u044b \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u044b. \u0413\u044d\u0442\u0430\u044f \u0432\u0430\u0434\u0430 \u0432\u044b\u0446\u044f\u043a\u0430\u0435 \u0437 \u0422\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u043a\u0443, \u0430\u0434\u043a\u0440\u044b\u0442\u0430\u0433\u0430 \u0434\u0437\u0456\u0434\u0430\u0439, \u0456 \u0434\u043b\u044f \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u0445\u0442\u043e \u043a\u0430\u0448\u0442\u0443\u0435 \u044f\u0435, \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u00ab\u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0432\u0430\u0434\u044b, \u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435\u00bb (\u042f\u043d 4, 14).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0448 \u043c\u043d\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u043d\u0430 \u0422\u0432\u0430\u0456\u0445 \u043f\u0430\u0448\u0430\u0445, \u0442\u043e \u0434\u0430\u043f\u0430\u043c\u043e\u0436\u0430\u0448 \u043c\u043d\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0430\u0434\u043f\u0430\u0447\u044b\u0446\u044c \u0430\u043f\u043e\u045e\u0434\u043d\u0456, \u043a\u0430\u043b\u0456, \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430 \u0437\u0430\u0441\u044b\u043d\u0430\u044e\u0447\u044b, \u044f \u0431\u0443\u0434\u0443 \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u043b\u0435, \u044f\u043a\u043e\u0435 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0437\u043c\u0440\u043e\u043a\u0443. \u0411\u043e \u043d\u044f\u043c\u0430 \u0430\u043f\u043e\u045e\u0434\u043d\u0456 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0446\u0435\u043d\u044e, \u043a\u0430\u043b\u0456 \u0441\u043e\u043d\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0430\u0434\u0430\u0435 \u043f\u0440\u043e\u0441\u0442\u0430 \u0437\u0433\u0430\u0440\u044b. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c \u0422\u044b \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435\u0448 \u0430\u0434\u043f\u0430\u0447\u044b\u0446\u044c \u0442\u044b\u043c, \u043a\u0430\u0433\u043e \u043f\u0440\u044b\u0432\u0451\u045e \u043d\u0430 \u043f\u0430\u0448\u0443, \u043f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439 \u0443 \u0422\u0432\u0430\u0435 \u043f\u0430\u043a\u043e\u0456. \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043b\u0456\u0447\u0430\u043d\u044b \u0433\u043e\u0434\u043d\u044b\u043c \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c \u0430\u043f\u043e\u045e\u0434\u043d\u0456, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0437\u0456\u0446\u0451\u043c \u0441\u0432\u044f\u0442\u043b\u0430 \u0456 \u0434\u0437\u0456\u0446\u0451\u043c \u0434\u043d\u044f. \u0425\u0442\u043e \u0430\u0434\u0434\u0430\u043b\u0456\u0446\u0446\u0430 \u0430\u0434 \u0446\u0435\u043c\u0440\u044b \u0432\u0435\u0447\u0430\u0440\u0443 \u0456 \u0430\u0434 \u0446\u0435\u043c\u0440\u044b \u0440\u0430\u043d\u0456\u0446\u044b, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0430\u0434 \u0437\u043b\u0430 \u045e \u044f\u0433\u043e \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0456 \u045e \u043a\u0430\u043d\u0446\u044b, \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0435 \u0430\u043f\u043e\u045e\u0434\u043d\u0456, \u043f\u0440\u044b\u0432\u0435\u0434\u0437\u0435\u043d\u044b \u0442\u0443\u0434\u044b \u0421\u0432\u044f\u0442\u043b\u043e\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043a\u0430\u0436\u044b \u043c\u043d\u0435, \u044f\u043a \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430 \u0456 \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c, \u043f\u0430\u043a\u0430\u0436\u044b \u0434\u0430\u0440\u043e\u0433\u0443 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443 \u0430\u043f\u043e\u045e\u0434\u043d\u0456, \u043a\u0430\u0431 \u044f, \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u0430\u044f \u0432\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430 \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u045e\u0434\u044b, \u043d\u0435 \u0434\u0430\u043b\u0443\u0447\u044b\u043b\u0430\u0441\u044f \u0434\u0430 \u0430\u045e\u0447\u0430\u0440\u043d\u0456, \u044f\u043a\u0430\u044f \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0422\u0430\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430, \u044f\u043a\u0430\u044f \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c, \u0434\u0430\u0434\u0437\u0435\u043d\u0443\u044e \u0451\u0439 \u0411\u043e\u0433\u0430\u043c, \u044f\u043a\u0430\u044f \u043f\u0440\u0430\u0433\u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u0446\u044c, \u044f\u043a \u043c\u043e\u0436\u043d\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 27 (26), 13\u0430. 4\u0430; \u0424\u043b\u043f 1, 21\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u0435\u0440\u0443, \u0448\u0442\u043e \u045e\u0431\u0430\u0447\u0443 \u0434\u0430\u0431\u0440\u044b\u043d\u044e \u041f\u0430\u043d\u0430 \u045e \u043a\u0440\u0430\u0456\u043d\u0435 \u0436\u044b\u0432\u044b\u0445. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0410\u0434\u043d\u0430\u0433\u043e \u044f \u043f\u0440\u0430\u0448\u0443 \u045e \u041f\u0430\u043d\u0430 \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u0430\u0434\u0430\u044e, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u043c\u043d\u0435 \u045e \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0436\u044b\u0446\u0446\u044f \u043c\u0430\u0439\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0414\u043b\u044f \u043c\u044f\u043d\u0435 \u0436\u044b\u0446\u0446\u0451 \u2013 \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u2013 \u0433\u044d\u0442\u0430 \u0432\u044b\u0433\u0430\u0434\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u0434\u043d\u0430\u0433\u043e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"336","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u041f\u0440\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0415\u0437\u0443\u0441\u0430\u00bb \u0441\u0432. \u042f\u043d\u0430 \u042d\u0434\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Pars. 3, 4: Opera omnia 1, 310-312)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0422\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u043d\u0430\u0441 \u0456 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0446\u044c \u0456 \u0434\u0430\u043f\u0430\u045e\u043d\u044f\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u0437\u0431\u0430\u045e\u0447\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443 \u0425\u0440\u044b\u0441\u0442\u0430; \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u042f\u0433\u043e \u0447\u0430\u0441\u0442\u0430, \u043a\u0430\u0431 \u0401\u043d \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u044f\u0435 \u045e \u043d\u0430\u0441 \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0411\u043e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0415\u0437\u0443\u0441\u0430 \u044f\u0448\u0447\u044d \u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0456 \u0441\u0442\u0430\u043d\u0443 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0439 \u0456 \u043f\u043e\u045e\u043d\u0430\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456. \u042f\u043d\u044b \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u045e \u0430\u0441\u043e\u0431\u0435 \u0415\u0437\u0443\u0441\u0430, \u0430\u043b\u0435 \u043d\u0435 \u045e \u043d\u0430\u0441, \u042f\u0433\u043e \u0447\u043b\u0435\u043d\u0430\u0445, \u0456 \u043d\u0435 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u044f\u043a\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u042f\u0433\u043e \u041c\u0456\u0441\u0442\u044b\u0447\u043d\u044b\u043c \u0446\u0435\u043b\u0430\u043c. \u0410\u043b\u0435 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0411\u043e\u0436\u044b \u0421\u044b\u043d \u0445\u043e\u0447\u0430 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u043d\u0430\u043c, \u043d\u0456\u0431\u044b \u0440\u0430\u0437\u0432\u0456\u0432\u0430\u044e\u0447\u044b \u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u045e \u043d\u0430\u0441 \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0430\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u043b\u0430\u0441\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0445\u043e\u0447\u0430 \u043d\u0430\u043c \u0443\u0434\u0437\u044f\u043b\u0456\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u0445 \u0445\u043e\u0447\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0443 \u043d\u0430\u0441 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u044b\u043c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0432\u0443\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435 \u045e \u0441\u0432\u0430\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u0448\u0442\u043e \u043c\u044b \u045e\u0441\u0435 \u043f\u0440\u044b\u0447\u044b\u043d\u044f\u0435\u043c\u0441\u044f \u0434\u0430 \u042f\u0433\u043e \u0431\u0443\u0434\u043e\u0432\u044b, \u0434\u0430 \u0447\u0430\u0441\u0443 \u042f\u0433\u043e \u043f\u0430\u045e\u043d\u0430\u0442\u044b, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434\u0430 \u043c\u0456\u0441\u0442\u044b\u0447\u043d\u0430\u0433\u0430 \u0447\u0430\u0441\u0443, \u044f\u043a\u0456 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u042f\u043c\u0443 \u045e \u041c\u0456\u0441\u0442\u044b\u0447\u043d\u044b\u043c \u0446\u0435\u043b\u0435; \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u0433\u044d\u0442\u044b \u0432\u0435\u043a \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0434\u0437\u0435\u043d\u044c \u0441\u0443\u0434\u0430. \u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0451\u043d \u0434\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u043d\u0435\u0434\u0430\u0445\u043e\u043f \u0443 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 (\u043f\u0430\u0440. \u041a\u043b\u0441 1, 24).<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043a \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0443 \u043d\u0430\u0441 \u0443\u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f \u0456 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0456\u0445. \u0425\u043e\u0447\u0430 \u0434\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0443 \u043d\u0430\u0441 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f, \u0443\u043a\u0440\u044b\u0442\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043f\u0430\u0447\u044b\u043d\u0430\u0435 \u0436\u044b\u0446\u044c \u0443 \u043d\u0430\u0441 \u0456 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u045e \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u0448\u0430\u0445 \u043f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0445\u0440\u043e\u0441\u0442\u0443 \u0456 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u043e\u0431\u0456\u0446\u044c \u0442\u0430\u043a, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u0447\u044b\u043d\u0430\u0435\u043c \u0432\u0435\u0441\u0446\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u0435 \u0437 \u0406\u043c \u0443 \u0411\u043e\u0433\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0425\u043e\u0447\u0430 \u0434\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0443 \u043d\u0430\u0441 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0441\u0432\u0430\u0451\u0439 \u043c\u0443\u043a\u0456, \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u044e\u0447\u044b \u043d\u0430\u043c \u0446\u044f\u0440\u043f\u0435\u0446\u044c, \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0430\u0446\u044c \u0437 \u0406\u043c \u0456 \u045e \u0406\u043c. \u0423\u0440\u044d\u0448\u0446\u0435, \u0445\u043e\u0447\u0430 \u0434\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0443 \u043d\u0430\u0441 \u0441\u0442\u0430\u043d \u0441\u0432\u0430\u0439\u0433\u043e \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0433\u0430 \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u045e \u043d\u0435\u0431\u0435, \u043a\u0430\u043b\u0456 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u0442\u0430\u043a, \u0448\u0442\u043e \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0437 \u0406\u043c \u0456 \u045e \u0406\u043c \u0432\u0435\u0447\u043d\u0430 \u0436\u044b\u0446\u044c \u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0445\u0432\u0430\u043b\u0435. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u044f \u0441\u0442\u0430\u043d\u044b \u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0445\u043e\u0447\u0430 \u0430\u0436\u044b\u0446\u0446\u044f\u0432\u0456\u0446\u044c \u0456 \u0434\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0443 \u043d\u0430\u0441, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u0430\u0445\u0432\u044f\u0440\u0443\u044e\u0447\u044b \u0456\u0445 \u043d\u0430\u043c, \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u044e\u0447\u044b \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0456\u0445, \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u044e\u0447\u044b \u0456\u0445 \u0443 \u043d\u0430\u0441 \u0456 \u043f\u0430\u0448\u044b\u0440\u0430\u044e\u0447\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u0430\u0436 \u0434\u0430 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443, \u044f\u043a\u0456 \u0401\u043d \u0441\u0430\u043c \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434\u043b\u044f \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0433\u0430 \u0456\u0445 \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u044f \u045e \u043d\u0430\u0441 \u0456 \u045e \u0441\u0432\u0430\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0430\u0436 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u0441\u0432\u0435\u0442\u0443.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041a\u043b\u0441 1, 24. 29\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u0440\u0430\u0434\u0443\u044e\u0441\u044f \u0437\u0430 \u0432\u0430\u0441 \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u0456 \u0434\u0430\u043f\u0430\u045e\u043d\u044f\u044e \u043d\u0435\u0434\u0430\u0445\u043e\u043f \u0443 \u043c\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430 <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0437\u0430 \u042f\u0433\u043e\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u043f\u0440\u0430\u0446\u0443\u044e, \u0437\u043c\u0430\u0433\u0430\u044e\u0447\u044b\u0441\u044f \u043c\u043e\u0446\u0430\u044e \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0430\u044f \u043c\u0430\u0433\u0443\u0442\u043d\u0430 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0417\u0430 \u042f\u0433\u043e\u043d\u0430\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"337","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u043d\u0444\u0435\u0440\u044d\u043d\u0446\u044b\u044f \u0441\u0432. \u0422\u0430\u043c\u0430\u0448\u0430 \u0410\u043a\u0432\u0456\u043d\u0441\u043a\u0430\u0433\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Col. Super <\/span><span style=\"color: #ff0000; font-style: italic;\">Credo in Deum<\/span><span style=\"color: #ff0000;\">: Opuscula theologica 2, Taurini 1954, pp. 216-217)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u042f \u043d\u0430\u0441\u044b\u0447\u0443\u0441\u044f, \u043a\u0430\u043b\u0456 \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u0422\u0432\u0430\u044f \u0445\u0432\u0430\u043b\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0441\u044f\u0440\u043e\u0434 \u043f\u0440\u0430\u045e\u0434\u0430\u045e \u0432\u0435\u0440\u044b, \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u044b\u0445 \u0443 \u0421\u0456\u043c\u0432\u0430\u043b\u0435, \u0443 \u043a\u0430\u043d\u0446\u044b \u0437\u0433\u0430\u0434\u0432\u0430\u0435\u0446\u0446\u0430 \u043c\u044d\u0442\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0448\u044b\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451: \u00ab\u0412\u0435\u0440\u0443 \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435. \u0410\u043c\u044d\u043d\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0432\u0435\u0447\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c. \u0411\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430\u0439 \u0456 \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0435\u043c \u0443\u0441\u0456\u0445 \u043d\u0430\u0448\u044b\u0445 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e: \u00ab\u042f \u0442\u0432\u043e\u0439 \u0448\u0447\u044b\u0442; \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0442\u0432\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u0432\u0435\u043b\u044c\u043c\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u044f\u00bb (\u0411\u044b\u0446 15, 1). \u0413\u044d\u0442\u0430\u0435 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0431\u0430\u0447\u0430\u043d\u043d\u0456: \u00ab\u0426\u044f\u043f\u0435\u0440 \u043c\u044b \u0431\u0430\u0447\u044b\u043c \u043f\u0440\u0430\u0437 \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0430, \u0446\u044c\u043c\u044f\u043d\u0430, \u0430 \u0442\u0430\u0434\u044b \u2013 \u0442\u0432\u0430\u0440\u0430\u043c \u0443 \u0442\u0432\u0430\u0440\u00bb (1 \u041a\u0430\u0440 13, 12).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u043f\u0430\u043b\u044f\u0433\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0432\u0435\u0434\u0430\u043d\u043d\u0456 \u0411\u043e\u0433\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430: \u00ab\u0406 \u0431\u0443\u0434\u0437\u0435 \u045e \u0456\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044c, \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u044f \u043f\u0435\u0441\u043d\u044f \u0456 \u0433\u0443\u0447\u0430\u043d\u043d\u0435 \u043c\u0443\u0437\u044b\u043a\u0456\u00bb (\u0406\u0441 51, 3).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0416\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u044f\u0448\u0447\u044d \u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0437\u0430\u0441\u043f\u0430\u043a\u0430\u0435\u043d\u043d\u0456 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e. \u041a\u043e\u0436\u043d\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0442\u0430\u043c \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u045e\u0441\u044f \u0456 \u0436\u0430\u0434\u0430\u045e. \u041d\u0456\u044f\u043a\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0456\u0446\u044c \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0422\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433 \u043c\u043e\u0436\u0430 \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u044c \u0456 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430 \u0456\u0445 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043c\u043e\u0436\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0411\u043e\u0433\u0443, \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430: \u00ab\u0422\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435, \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0456 \u043d\u0435\u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430\u0435 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0441\u043f\u0430\u0447\u043d\u0435 \u045e \u0422\u0430\u0431\u0435\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0432\u044f\u0442\u044b\u044f \u045e \u0441\u0432\u0430\u0451\u0439 \u0430\u0439\u0447\u044b\u043d\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u0435\u0446\u044c \u0411\u043e\u0433\u0430, \u0442\u043e \u0430\u0434\u0441\u044e\u043b\u044c \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435, \u0448\u0442\u043e \u0441\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u045e\u0441\u0435 \u0456\u0445\u043d\u0456\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456, \u0430 \u0445\u0432\u0430\u043b\u0430 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0434\u0437\u0435 \u043d\u0430\u0432\u0430\u0442 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u044f\u043d\u044b \u0447\u0430\u043a\u0430\u044e\u0446\u044c. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u043a\u0430\u0436\u0430: \u00ab\u0423\u0432\u0430\u0439\u0434\u0437\u0456 \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0442\u0432\u0430\u0439\u0433\u043e\u00bb (\u041c\u0446 25, 21). \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c: \u00ab\u041d\u0435 \u045e\u0441\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0443\u0432\u043e\u0439\u0434\u0437\u0435 \u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430, \u0430\u043b\u0435 \u045e\u0441\u0435, \u0445\u0442\u043e \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430, \u0443\u0432\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u0440\u0430\u0434\u0430\u0441\u0446\u044c\u00bb. \u0423 \u043f\u0441\u0430\u043b\u044c\u043c\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u041a\u0430\u043b\u0456 \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u0422\u0432\u0430\u044f \u0445\u0432\u0430\u043b\u0430, \u044f \u0431\u0443\u0434\u0443 \u043d\u0430\u0441\u044b\u0447\u0430\u043d\u044b\u00bb, \u0456 \u044f\u0448\u0447\u044d: \u00ab\u041f\u0430\u043d \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0448\u0447\u0430\u0441\u0446\u0435\u043c \u0442\u0432\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e \u045e\u0441\u0451, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0442\u0430\u043c \u0443 \u043f\u043e\u045e\u043d\u0456. \u041a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0435 \u0448\u0447\u0430\u0441\u0446\u044f, \u0442\u043e \u0442\u0430\u043c \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0435 \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435, \u0431\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u044f\u043d\u043e \u0430\u0434 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0414\u0430\u0431\u0440\u043e\u043c: \u00ab\u0412\u0435\u0447\u043d\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0426\u044f\u0431\u0435\u00bb (\u041f\u0441 16 [15], 11).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0416\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0440\u0430\u0434\u0430\u0441\u043d\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u044f\u0442\u044b\u0445. \u0413\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0434\u0430\u0435 \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435, \u0431\u043e \u043a\u043e\u0436\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0443\u0441\u0435 \u0442\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b, \u044f\u043a\u0456\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043b\u0451\u0441\u0430\u043c \u0443\u0441\u0456\u0445 \u0456\u043d\u0448\u044b\u0445 \u0441\u0432\u044f\u0442\u044b\u0445. \u041a\u043e\u0436\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0448\u0447\u0430\u0441\u0446\u044e \u0456\u043d\u0448\u0430\u0433\u0430 \u044f\u043a \u0441\u0432\u0430\u0439\u043c\u0443 \u045e\u043b\u0430\u0441\u043d\u0430\u043c\u0443, \u0431\u043e \u043a\u043e\u0436\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0456\u043d\u0448\u0430\u0433\u0430 \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u0435 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0443\u0441\u0456\u0445.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 17 (16), 15; 1 \u041a\u0430\u0440 13, 12b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u045e\u0431\u0430\u0447\u0443 \u0422\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u041f\u0430\u043d\u0435, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0447\u043d\u0443\u0441\u044f, \u0431\u0443\u0434\u0443 \u043d\u0430\u0441\u044b\u0447\u0430\u0446\u0446\u0430 \u0422\u0432\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0426\u044f\u043f\u0435\u0440 \u044f \u0432\u0435\u0434\u0430\u044e \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430, \u0442\u0430\u0434\u044b \u0436 \u0441\u043f\u0430\u0437\u043d\u0430\u044e \u0442\u0430\u043a, \u044f\u043a \u0456 \u044f \u0441\u043f\u0430\u0437\u043d\u0430\u043d\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u0447\u043d\u0443\u0441\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"341","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0422\u0432\u043e\u0440 \u00ab\u041f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443\u00bb \u0410\u0440\u044b\u0433\u0435\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 25: PG 11, 495-499)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0422\u0432\u0430\u0451&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0435\u0437\u0430\u045e\u0432\u0430\u0436\u043d\u0430, \u0456 \u043d\u0435\u043b\u044c\u0433\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u044f\u043d\u043e \u0442\u0443\u0442 \u0446\u0456 \u0442\u0430\u043c, \u0430\u043b\u0435 \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u045e \u043d\u0430\u0441, \u0431\u043e \u00ab\u0431\u043b\u0456\u0437\u043a\u0430 \u0434\u0430 \u0446\u044f\u0431\u0435 \u0441\u043b\u043e\u0432\u0430, \u043d\u0430 \u0432\u0443\u0441\u043d\u0430\u0445 \u0442\u0432\u0430\u0456\u0445 \u0456 \u045e \u0441\u044d\u0440\u0446\u044b \u0442\u0432\u0430\u0456\u043c\u00bb (\u0420\u044b\u043c 10, 8), \u0442\u043e \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0430\u0431 \u044f\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u0456, \u043f\u0440\u043e\u0441\u0456\u0446\u044c, \u043a\u0430\u0431 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u0451\u0441\u0446\u044c \u0443 \u0456\u043c, \u0440\u0430\u0437\u0432\u0456\u0432\u0430\u043b\u0430\u0441\u044f, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0430 \u043f\u043b\u0451\u043d \u0456 \u0441\u043f\u0430\u045e\u043d\u044f\u043b\u0430\u0441\u044f. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u043a\u043e\u0436\u043d\u044b\u043c \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u0445, \u0456 \u043a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u043d\u0430\u043a\u0430\u0437\u0430\u043c \u0411\u043e\u0433\u0430. \u0423 \u0442\u0430\u043a\u0456\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0411\u043e\u0433 \u0436\u044b\u0432\u0435 \u043d\u0456\u0431\u044b \u045e \u0434\u043e\u0431\u0440\u0430 \u045e\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b. \u0423 \u0456\u043c \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u0410\u0439\u0446\u0435\u0446, \u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u0439\u0446\u043e\u043c \u0443 \u0434\u0443\u0448\u044b \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: \u00ab\u041f\u0440\u044b\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u044f\u0433\u043e, \u0456 \u0437\u0440\u043e\u0431\u0456\u043c \u0436\u044b\u043b\u043b\u0451 \u045e \u044f\u0433\u043e\u00bb (\u042f\u043d 14, 23).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u043e\u0435 \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u045e \u043d\u0430\u0441, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u0433\u0430 \u0440\u0430\u0437\u0432\u0456\u0446\u0446\u044f \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u0434\u0430\u0441\u043a\u043d\u0430\u043b\u0430\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 \u0441\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0448\u044b \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e, \u00ab\u043f\u0435\u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0433\u0443 \u0456 \u0410\u0439\u0446\u0443, \u043a\u0430\u0431 \u0411\u043e\u0433 \u0431\u044b\u045e \u0443\u0441\u0451 \u0432\u0430 \u045e\u0441\u0456\u043c\u00bb (1 \u041a\u0430\u0440 15, 24. 28). \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0437 \u0441\u044d\u0440\u0446\u0430\u043c, \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0435\u043d\u044b\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0421\u043b\u043e\u0432\u0443, \u0456 \u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0430\u0448\u0430\u043c\u0443 \u0410\u0439\u0446\u0443, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0443 \u043d\u0435\u0431\u0435: \u00ab\u0421\u0432\u044f\u0446\u0456\u0441\u044f \u0456\u043c\u044f \u0422\u0432\u0430\u0451, \u043f\u0440\u044b\u0439\u0434\u0437\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0422\u0432\u0430\u0451 (\u041c\u0446 6, 9-10).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0442\u043e \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0441\u0430\u043c\u043e\u0433\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0435 \u043c\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0433\u0430 \u0437 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435\u043c, \u044f\u043a \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u00ab\u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430 \u043f\u0430\u043c\u0456\u0436 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0434\u044b \u0446\u0435\u043c\u0440\u0430\u044e\u00bb \u0456 \u00ab\u043f\u0430\u043c\u0456\u0436 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0456 \u0411\u044d\u043b\u0456\u0430\u0440\u0430\u043c\u00bb (2 \u041a\u0430\u0440 6, 14-15). \u0422\u0430\u043a \u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u043d\u0435 \u043c\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0433\u0430 \u0437 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0433\u0440\u0430\u0445\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u043c, \u043a\u0430\u0431 \u0411\u043e\u0433 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e \u0443 \u043d\u0430\u0441, \u0442\u043e \u00ab\u043d\u044f\u0445\u0430\u0439 \u0433\u0440\u044d\u0445 \u043d\u0435 \u043f\u0430\u043d\u0443\u0435 \u045e \u0432\u0430\u0448\u044b\u043c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0446\u0435\u043b\u0435\u00bb (\u0420\u044b\u043c 6, 12). \u0422\u0440\u044d\u0431\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043c\u0451\u0440\u0442\u0432\u044b\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u044f\u043c\u043d\u043e\u0435 \u045e \u0446\u0435\u043b\u0435 \u043d\u0430\u0448\u044b\u043c (\u043f\u0430\u0440. \u041a\u043b\u0441 3, 5), \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u043f\u043b\u0451\u043d \u0414\u0443\u0445\u0430. \u0422\u0430\u0434\u044b \u041f\u0430\u043d \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0433\u0443\u043b\u044c\u0432\u0430\u0446\u0446\u0430 \u045e \u043d\u0430\u0441, \u043d\u0456\u0431\u044b \u045e \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0440\u0430\u0456, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u043c\u0456 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0421\u0432\u0430\u0456\u043c \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430\u043c. \u0401\u043d \u0441\u044f\u0434\u0437\u0435 \u045e \u043d\u0430\u0441 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043c\u043e\u0446\u044b, \u044f\u043a\u0443\u044e \u043c\u044b \u0445\u043e\u0447\u0430\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c. \u0401\u043d \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0443\u0441\u0435 \u042f\u0433\u043e \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u0456 \u043d\u0435 \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0443 \u043d\u0430\u0441 \u043f\u0430\u0434\u043d\u043e\u0436\u0436\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u0445 \u043d\u043e\u0433 (\u043f\u0430\u0440. \u041f\u0441 99 [98], 5), \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u045e\u043b\u0430\u0434\u0443, \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u0456 \u043c\u043e\u0446.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u043c\u043e\u0436\u0430 \u0430\u0434\u0431\u044b\u0446\u0446\u0430 \u045e \u043a\u043e\u0436\u043d\u044b\u043c \u0437 \u043d\u0430\u0441, \u0430 \u045e \u043a\u0430\u043d\u0446\u044b \u00ab\u044f\u043a \u0430\u043f\u043e\u0448\u043d\u0456 \u0432\u043e\u0440\u0430\u0433 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c\u00bb (1 \u041a\u0430\u0440 15, 26). \u041a\u0430\u0431 \u0443 \u043d\u0430\u0441 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e: \u00abC\u043c\u0435\u0440\u0446\u044c, \u0434\u0437\u0435 \u0442\u0432\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430? \u0421\u043c\u0435\u0440\u0446\u044c, \u0434\u0437\u0435 \u0442\u0432\u0430\u0451 \u0434\u0436\u0430\u043b\u0430?\u00bb (1 \u041a\u0430\u0440 15, 55). \u0410\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u043d\u0430\u0441 \u00ab\u0442\u043b\u0435\u043d\u043d\u0430\u0435\u00bb, \u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c, \u0430 \u00ab\u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c\u00bb \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435, \u043f\u0430\u0441\u043b\u044f \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f \u0441\u043c\u0435\u0440\u0446\u0456, \u00ab\u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c\u00bb \u0410\u0439\u0446\u0430 (1 \u041a\u0430\u0440 15, 55; \u043f\u0430\u0440. \u041e\u0441 13, 14). \u0422\u0430\u043a \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u0430 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u043f\u043b\u0451\u043d\u0430\u043c \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0410\u043f 11, 15b; \u043f\u0430\u0440. \u041f\u0441 22 (21), 28b-29\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041d\u0430\u0441\u0442\u0430\u043b\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043d\u043d\u0435 \u043d\u0430\u0434 \u0441\u0432\u0435\u0442\u0430\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0456 \u042f\u0433\u043e \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0443\u0441\u0435 \u043f\u043b\u044f\u043c\u0451\u043d\u044b \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0431\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043d\u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u041f\u0430\u043d\u0443. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0401\u043d \u0431\u0443\u0434\u0437\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"342","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Serm. 92, 1. 2. 3: PL 54, 454-455)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u042f\u043a\u0430\u044f \u043f\u0440\u0430\u0446\u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u0442\u0430\u043a\u0430\u044f \u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430<\/span><\/p>\r\n<p style=\"text-indent: 19.95pt; text-align: justify;\"><span>\u041f\u0430\u043d \u043a\u0430\u0436\u0430: \u00ab\u041a\u0430\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430 \u043d\u0435 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043a\u043d\u0456\u0436\u043d\u0456\u043a\u0430\u045e \u0456 \u0444\u0430\u0440\u044b\u0441\u0435\u044f\u045e, \u0442\u043e \u0432\u044b \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u045e \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435\u00bb (\u041c\u0446 5, 20). \u0410\u043b\u0435 \u044f\u043d\u0430 \u043d\u0435 \u0437\u043c\u043e\u0436\u0430 \u0441\u0442\u0430\u0446\u044c \u0431\u043e\u043b\u044c\u0448\u0430\u0439, \u043a\u0430\u043b\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0437\u0430 \u0441\u0443\u0434 (\u043f\u0430\u0440. \u042f\u043a 2, 13). \u0411\u043e \u0448\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u0433\u043e\u0434\u043d\u044b\u043c \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0434\u043b\u044f \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u0443\u0447\u044b\u043d\u0435\u043d\u0430\u0433\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f, \u044f\u043a\u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e \u0437\u0440\u0430\u0431\u0456\u045e \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u044e \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f \u0432\u0435\u0440\u043d\u044b\u0445. \u0422\u0430\u043a \u043f\u0430\u0441\u043b\u044f \u0430\u0434\u0445\u0456\u043b\u0435\u043d\u043d\u044f \u0441\u0443\u0440\u043e\u0432\u0430\u0439 \u043f\u043e\u043c\u0441\u0442\u044b \u0456 \u0441\u043f\u044b\u043d\u0435\u043d\u043d\u044f \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0433\u0440\u044d\u0448\u043d\u0456\u043a \u0437\u043d\u043e\u045e \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043d\u044f\u0432\u0456\u043d\u043d\u044b\u043c, \u0430 \u0441\u043f\u044b\u043d\u0435\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u0446\u043d\u043e\u0442\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 19.95pt; text-align: justify;\"><span>\u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043c\u043e\u0436\u0430 \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043a\u043d\u0456\u0436\u043d\u0456\u043a\u0430\u045e \u0456 \u0444\u0430\u0440\u044b\u0441\u0435\u044f\u045e, \u0431\u043e \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0417\u0430\u043a\u043e\u043d\u0443, \u0430\u043b\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u0435 \u044f\u0433\u043e \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u043f\u043e\u0441\u0442, \u043a\u0430\u0436\u0430: \u00ab\u041a\u0430\u043b\u0456 \u043f\u043e\u0441\u0446\u0456\u0446\u0435, \u043d\u0435 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043f\u0430\u043d\u0443\u0440\u044b\u043c\u0456, \u044f\u043a \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0456\u043a\u0456. \u0411\u043e \u044f\u043d\u044b \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0435 \u0442\u0432\u0430\u0440\u044b, \u043a\u0430\u0431 \u043b\u044e\u0434\u0437\u0456 \u0431\u0430\u0447\u044b\u043b\u0456, \u0448\u0442\u043e \u044f\u043d\u044b \u043f\u043e\u0441\u0446\u044f\u0446\u044c. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043a\u0430\u0436\u0443 \u0432\u0430\u043c: \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443\u00bb (\u041c\u0446 6, 16). \u042f\u043a\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0430\u0445\u0432\u0430\u043b\u0443 \u0430\u0434 \u043b\u044e\u0434\u0437\u0435\u0439? \u041a\u0430\u0431 \u044f\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c, \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0442\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u045e\u044f\u045e\u043d\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0456, \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u044e\u0447\u044b \u0433\u043e\u043b\u0430\u0441\u0443 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f, \u043b\u044e\u0431\u0456\u0446\u044c \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0443\u044e \u0441\u043b\u0430\u0432\u0443. \u0422\u0430\u0434\u044b \u043d\u044f\u043f\u0440\u0430\u045e\u0434\u0430, \u044f\u043a\u0430\u044f \u043f\u0440\u0430\u0437 \u0443\u043a\u0440\u044b\u0432\u0430\u043d\u043d\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u0435 \u0441\u0430\u043c\u0443 \u0441\u044f\u0431\u0435, \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u043c \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0435\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 19.95pt; text-align: justify;\"><span>\u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u044f\u043a\u0456 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u0442\u0430\u043c\u0443, \u043a\u0430\u0433\u043e \u0451\u043d \u043b\u044e\u0431\u0456\u0446\u044c. \u0411\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u0447\u0430\u043a\u0430\u0446\u044c \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b \u0437\u0430 \u0441\u0430\u043c\u0443 \u043b\u044e\u0431\u043e\u045e. \u041b\u044e\u0431\u043e\u045e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430, \u0431\u043e \u0411\u043e\u0433 \u2013 \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u043e\u045e. \u041f\u0430\u0431\u043e\u0436\u043d\u0430\u044f \u0456 \u0447\u044b\u0441\u0442\u0430\u044f \u0434\u0443\u0448\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043c\u0430\u0435 \u0411\u043e\u0433\u0430, \u0448\u0442\u043e \u043f\u0430-\u0437\u0430 \u0406\u043c \u0443\u0436\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0435. \u0422\u0430\u043c\u0443 \u0432\u0435\u043b\u044c\u043c\u0456 \u0441\u043b\u0443\u0448\u043d\u0430 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0414\u0437\u0435 \u0441\u043a\u0430\u0440\u0431 \u0442\u0432\u043e\u0439, \u0442\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0456 \u0441\u044d\u0440\u0446\u0430 \u0442\u0432\u0430\u0451\u00bb (\u041c\u0446 6, 21). \u0427\u044b\u043c \u0436\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u043a\u0430\u0440\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437\u0431\u0456\u0440\u0430\u043d\u043d\u0435\u043c \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e \u0456 \u0441\u0443\u043a\u0443\u043f\u043d\u0430\u0441\u0446\u044e \u044f\u0433\u043e \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e? \u00ab\u0428\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u0441\u0435\u0435, \u0442\u043e\u0435 \u0456 \u043f\u0430\u0436\u043d\u0435\u00bb (\u0413\u0430\u043b 6, 7). \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u0446\u044b \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u044f\u043c\u0443. \u0406 \u0448\u0442\u043e \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0437 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044e, \u0434\u0430 \u0442\u0430\u0433\u043e \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u044f \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0456 \u0441\u044d\u0440\u0446\u0430. \u0410\u0434\u043d\u0430\u043a, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0451\u0441\u0446\u044c \u0448\u043c\u0430\u0442 \u0432\u0456\u0434\u0430\u045e \u0431\u0430\u0433\u0430\u0446\u0446\u044f \u0456 \u0440\u043e\u0437\u043d\u044b\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0442\u0430\u043c\u0443 \u043a\u043e\u0436\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043c\u0430\u0435 \u0441\u043a\u0430\u0440\u0431, \u044f\u043a\u0456 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u044f\u0433\u043e \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u043c. \u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u0434\u043c\u0435\u0442\u0430\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0437\u044f\u043c\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b, \u0442\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u0456\u043c\u0456 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430, \u043d\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c\u0456, \u0430\u043b\u0435 \u0445\u0443\u0442\u0447\u044d\u0439 \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 19.95pt; text-align: justify;\"><span>\u0422\u043e\u0439, \u043a\u0430\u0433\u043e \u0432\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0433\u0430\u0440\u044b, \u0430 \u043d\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0445\u0442\u043e \u043d\u0435 \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0440\u0430\u043c\u0456\u043d\u0430\u0435, \u0430\u043b\u0435 \u0448\u0442\u043e \u0442\u0440\u044b\u0432\u0430\u0435 \u0432\u0435\u0447\u043d\u0430, \u0441\u0432\u0430\u0435 \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u044b\u044f \u0441\u043a\u0430\u0440\u0431\u044b \u0431\u0430\u0447\u044b\u0446\u044c \u0443 \u0442\u044b\u043c, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0440\u043e\u043a: \u00ab\u041f\u0440\u044b\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u0448 \u0441\u043a\u0430\u0440\u0431 \u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0432\u0435\u0434\u044b \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430: \u0432\u043e\u0441\u044c \u0441\u043a\u0430\u0440\u0431\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456\u00bb (\u043f\u0430\u0440. \u0406\u0441 33, 6). \u041f\u0440\u0430\u0437 \u0456\u0445 \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456 \u043d\u0430\u0432\u0430\u0442 \u0437\u044f\u043c\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u044f\u0446\u0446\u0430 \u045e \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u0432\u0435\u0447\u043d\u044b\u044f. \u041c\u043d\u043e\u0433\u0456\u044f \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c, \u044f\u043a\u043e\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0446\u0456 \u0456\u043d\u0448\u044b\u043c \u0447\u044b\u043d\u0430\u043c, \u0434\u043b\u044f \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u041a\u0430\u043b\u0456 \u0434\u0437\u0435\u043b\u044f\u0446\u0446\u0430 \u0442\u044b\u043c, \u0448\u0442\u043e \u043c\u0430\u044e\u0446\u044c \u0437 \u043b\u0456\u0448\u043a\u0430\u043c, \u0437\u0431\u0456\u0440\u0430\u044e\u0446\u044c \u0441\u0430\u0431\u0435 \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b; \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0430\u0434\u0434\u0430\u043b\u0456 \u044f\u043a \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443, \u0443\u0436\u043e \u043d\u0435 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0435 \u043d\u0456\u044f\u043a\u0430\u044f \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430. \u0422\u0430\u043c\u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u043a\u0430\u0431 \u0456\u0445\u043d\u044f\u0435 \u0441\u044d\u0440\u0446\u0430 \u0431\u044b\u043b\u043e \u0442\u0430\u043c, \u0434\u0437\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0456\u0445\u043d\u0456 \u0441\u043a\u0430\u0440\u0431. \u0411\u043e \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u045e \u043f\u0430\u043c\u043d\u0430\u0436\u044d\u043d\u043d\u0456 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a\u0456\u0445 \u0431\u0430\u0433\u0430\u0446\u0446\u044f\u045e, \u0431\u043e \u043d\u044f\u043c\u0430 \u0441\u0442\u0440\u0430\u0445\u0443, \u0448\u0442\u043e \u044f\u043d\u044b \u043f\u0440\u0430\u043f\u0430\u0434\u0443\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0413\u0430\u043b 6, 9-10\u0430. 7b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0435 \u0441\u043f\u044b\u043d\u044f\u0439\u043c\u0430\u0441\u044f \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0431\u043e \u045e \u0441\u0432\u043e\u0439 \u0447\u0430\u0441 \u0456 \u0436\u0430\u0446\u044c \u0431\u0443\u0434\u0437\u0435\u043c, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0430\u0441\u043b\u0430\u0431\u043d\u0435\u043c. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0414\u044b\u043a \u0432\u043e\u0441\u044c, \u043f\u0430\u043a\u0443\u043b\u044c \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0447\u0430\u0441, \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0428\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u0441\u0435\u0435, \u0442\u043e\u0435 \u0456 \u043f\u0430\u0436\u043d\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0414\u044b\u043a \u0432\u043e\u0441\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"343","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432. \u042f\u043d\u0430\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 35, 8-9: CCL 36, 321-323)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u0448 \u0434\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u0443\u0431\u0430\u0447\u044b\u0448 \u0441\u0432\u044f\u0442\u043b\u043e&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0456 \u0437 \u043d\u044f\u0432\u0435\u0440\u0443\u044e\u0447\u044b\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u043c\u044b, \u0445\u0440\u044b\u0441\u0446\u0456\u043d\u0435, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0441\u0432\u044f\u0442\u043b\u043e\u043c. \u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: \u00ab\u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0432\u044b \u0431\u044b\u043b\u0456 \u0446\u0435\u043c\u0440\u0430\u0439, \u0430 \u0446\u044f\u043f\u0435\u0440 \u0432\u044b \u0441\u0432\u044f\u0442\u043b\u043e \u045e \u041f\u0430\u043d\u0443. \u041f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435, \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u0441\u0432\u044f\u0442\u043b\u0430\u00bb (\u042d\u0444 5, 8). \u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043a\u0430\u0436\u0430: \u00ab\u041d\u043e\u0447 \u043c\u0456\u043d\u0443\u043b\u0430, \u0456 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u045e\u0441\u044f \u0434\u0437\u0435\u043d\u044c. \u0422\u0430\u043c\u0443 \u0430\u0434\u043a\u0456\u043d\u0435\u043c \u0443\u0447\u044b\u043d\u043a\u0456 \u0446\u0435\u043c\u0440\u044b \u0456 \u0430\u043f\u0440\u0430\u043d\u0435\u043c\u0441\u044f \u045e \u0437\u0431\u0440\u043e\u044e \u0441\u0432\u044f\u0442\u043b\u0430. \u042f\u043a \u0443 \u0434\u0437\u0435\u043d\u044c, \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u0441\u0442\u043e\u0439\u043d\u0430\u00bb (\u0420\u044b\u043c 13, 12-13).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u0443 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0456 \u0441\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u0456\u043c\u043a\u043d\u0435\u043c\u0441\u044f, \u043d\u0430\u0432\u0430\u0442 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u0443 \u044f\u043a\u0456\u043c \u043c\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c\u0441\u044f, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u044f\u0448\u0447\u044d \u043d\u043e\u0447\u0447\u0443. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0432\u043e\u0441\u044c \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430. \u0401\u043d \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430 \u0434\u0430\u0439\u0448\u043e\u045e \u0430\u0434 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0439 \u0412\u0435\u043b\u0456\u0447\u044b \u0442\u0430\u043a\u0456 \u0433\u043e\u043b\u0430\u0441: \u00ab\u0413\u044d\u0442\u0430 \u041c\u043e\u0439 \u0421\u044b\u043d \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u044f\u043a\u043e\u0433\u0430 \u042f \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e\u00bb. \u0406 \u043c\u044b \u0447\u0443\u043b\u0456, \u044f\u043a \u0433\u044d\u0442\u044b \u0433\u043e\u043b\u0430\u0441 \u0434\u0430\u043d\u043e\u0441\u0456\u045e\u0441\u044f \u0437 \u043d\u0435\u0431\u0430, \u043a\u0430\u043b\u0456 \u0431\u044b\u043b\u0456 \u0437 \u0406\u043c \u043d\u0430 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0440\u044b\u00bb (2 \u041f 1, 17-18). \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u0442\u0430\u043c \u0456 \u043d\u0435 \u0447\u0443\u043b\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0433\u043e\u043b\u0430\u0441\u0443 \u0437 \u043d\u0435\u0431\u0430, \u0442\u0430\u043c\u0443 \u043d\u0430\u043c \u0441\u0432. \u041f\u0451\u0442\u0440 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0436\u0430: \u00ab\u0423 \u043d\u0430\u0441 \u0451\u0441\u0446\u044c \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u0435, \u043f\u0440\u0430\u0440\u043e\u0446\u043a\u0430\u0435 \u0441\u043b\u043e\u0432\u0430. \u0406 \u0432\u044b \u0434\u043e\u0431\u0440\u0430 \u0437\u0440\u043e\u0431\u0456\u0446\u0435, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u043f\u0440\u044b \u0456\u043c, \u044f\u043a \u043f\u0440\u044b \u043b\u044f\u043c\u043f\u0435, \u0448\u0442\u043e \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u0443 \u0446\u0451\u043c\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u0447\u043d\u0435 \u0441\u0432\u0456\u0442\u0430\u0446\u044c \u0434\u0437\u0435\u043d\u044c \u0456 \u0437\u0430\u0440\u0430\u043d\u0456\u0446\u0430 \u043d\u0435 \u045e\u0437\u044b\u0434\u0437\u0435 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445\u00bb (2 \u041f 1, 19).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043d\u0430\u0448 \u041f\u0430\u043d, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u00ab\u0456 \u0430\u0441\u0432\u0435\u0442\u043b\u0456\u0446\u044c, \u2013 \u044f\u043a \u043a\u0430\u0436\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b, \u2013 \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u0435 \u045e \u0446\u0435\u043c\u0440\u044b, \u0456 \u0432\u044b\u044f\u0432\u0456\u0446\u044c \u043d\u0430\u043c\u0435\u0440\u044b \u0441\u044d\u0440\u0446\u0430\u045e, \u0442\u0430\u0434\u044b \u043a\u043e\u0436\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u043f\u0430\u0445\u0432\u0430\u043b\u0443 \u0430\u0434 \u0411\u043e\u0433\u0430\u00bb (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 4, 5). \u0423 \u0437\u0437\u044f\u043d\u043d\u0456 \u0442\u0430\u043a\u043e\u0433\u0430 \u0441\u0432\u0435\u0442\u043b\u0430\u0433\u0430 \u0434\u043d\u044f \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u044f \u043f\u0430\u0445\u043e\u0434\u043d\u0456; \u043c\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0447\u044b\u0442\u0430\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430\u045e \u0456 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0446\u044c \u041f\u0456\u0441\u0430\u043d\u043d\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0448\u0443\u043a\u0430\u0446\u044c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u042f\u043d\u0430, \u043d\u0430\u0432\u0430\u0442 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456. \u0411\u043e \u045e\u0441\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0456, \u0448\u0442\u043e \u0441\u0432\u0435\u0446\u044f\u0446\u044c, \u044f\u043a \u043b\u044f\u043c\u043f\u044b \u043d\u043e\u0447\u0447\u0443, \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u045e \u0446\u0435\u043c\u0440\u044b, \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u0430, \u0431\u043e \u043d\u0456 \u043c\u044b \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u0442\u0430\u043a\u043e\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u043d\u0456 \u0433\u044d\u0442\u044b\u044f \u0441\u0432\u044f\u0442\u044b\u044f \u043c\u0443\u0436\u044b, \u044f\u043a\u0456\u044f \u043d\u0430\u043c \u0456\u0445 \u043f\u0435\u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456, \u0431\u043e \u044f\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0430\u0447\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u043c\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0456 \u044f\u0441\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e. \u0410 \u0442\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0433\u044d\u0442\u0430\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456, \u0448\u0442\u043e \u043c\u044b \u045e\u0431\u0430\u0447\u044b\u043c? \u0428\u0442\u043e \u0442\u0430\u0434\u044b \u0441\u0442\u0430\u043d\u0435 \u0435\u0436\u0430\u044e \u0434\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0440\u043e\u0437\u0443\u043c\u0443? \u0428\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u044b\u043c \u0432\u0430\u0447\u0430\u043c? \u0410\u0434\u043a\u0443\u043b\u044c \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u044f\u043a\u043e\u0439 \u00ab\u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430, \u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430, \u0456 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0441\u044d\u0440\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u00bb? \u0428\u0442\u043e \u043c\u044b \u045e\u0431\u0430\u0447\u044b\u043c?&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u043b\u044e\u0431\u0456\u0446\u0435 \u0441\u0430 \u043c\u043d\u043e\u044e, \u0431\u044f\u0436\u044b\u0446\u0435 \u0441\u0430 \u043c\u043d\u043e\u044e \u045e \u0432\u0435\u0440\u044b; \u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u044b; \u0431\u0443\u0434\u0437\u0435\u043c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u044b; \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u0448\u0442\u043e \u0442\u0443\u0442 \u043c\u044b \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u044b. \u0428\u0442\u043e \u0436 \u043c\u044b \u0442\u0430\u0434\u044b \u045e\u0431\u0430\u0447\u044b\u043c? \u041d\u044f\u0445\u0430\u0439 \u0430\u0434\u043a\u0430\u0436\u0430 \u0432\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435: \u00ab\u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430, \u0456 \u0421\u043b\u043e\u0432\u0430 \u0431\u044b\u043b\u043e \u045e \u0411\u043e\u0433\u0430, \u0456 \u0411\u043e\u0433\u0430\u043c \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430\u00bb (\u042f\u043d 1, 1). \u0412\u043e\u0441\u044c \u0442\u044b \u0441\u0442\u0430\u043d\u0435\u0448 \u043b\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u0437 \u044f\u043a\u043e\u0439 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u043a\u0440\u043e\u043f\u0435\u043b\u044c. \u0422\u044b \u045e\u0431\u0430\u0447\u044b\u0448 \u0430\u0434\u043a\u0440\u044b\u0442\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u044f\u043a\u043e\u0433\u0430 \u0430\u0434\u0437\u0456\u043d \u043f\u0440\u0430\u043c\u0435\u043d\u044c \u043f\u0440\u0430\u0437 \u0437\u0430\u0432\u0435\u0441\u044b \u0456 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b \u043f\u0440\u0430\u0431\u0456\u045e\u0441\u044f \u0434\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u0448\u0442\u043e \u0437\u0430\u043d\u0443\u0440\u044b\u043b\u0430\u0441\u044f \u045e \u0437\u043c\u0440\u043e\u043a. \u041a\u0430\u0431 \u0431\u0430\u0447\u044b\u0446\u044c \u044f\u0433\u043e \u0456 \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c, \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b. \u00ab\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u2013 \u043f\u0456\u0448\u0430 \u0441\u0432. \u042f\u043d, \u2013 \u0446\u044f\u043f\u0435\u0440 \u043c\u044b \u0434\u0437\u0435\u0446\u0456 \u0411\u043e\u0436\u044b\u044f, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u043d\u0435 \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f, \u0447\u044b\u043c \u0431\u0443\u0434\u0437\u0435\u043c. \u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0401\u043d \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u0446\u0430, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u043c \u042f\u0433\u043e \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c\u00bb (1 \u042f\u043d 3, 2).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u0447\u0443\u0432\u0430\u044e, \u0448\u0442\u043e \u0432\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u043c\u043d\u043e\u044e \u045e\u0437\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0432\u044b\u0448\u044b\u043d\u044f\u045e. \u0422\u044b\u043c \u043d\u0435 \u043c\u0435\u043d\u0448, \u00ab\u0442\u043b\u0435\u043d\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0435 \u0434\u0443\u0448\u0443, \u0430 \u0437\u044f\u043c\u043d\u044b \u0448\u0430\u0446\u0451\u0440 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0432\u0430\u0435 \u043f\u043e\u045e\u043d\u044b \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u045e \u0440\u043e\u0437\u0443\u043c\u00bb (\u041c\u0434\u0440 9, 15). \u041f\u0440\u0430\u0437 \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u0430\u0434\u043a\u043b\u0430\u0434\u0443 \u041a\u043d\u0456\u0433\u0443, \u0430 \u0432\u044b \u0440\u0430\u0437\u044b\u0434\u0437\u0435\u0446\u0435\u0441\u044f, \u043a\u043e\u0436\u043d\u044b \u045e \u0441\u0432\u043e\u0439 \u0434\u043e\u043c. \u041d\u0430\u043c \u0431\u044b\u043b\u043e \u0434\u043e\u0431\u0440\u0430 \u045e \u0441\u0432\u044f\u0442\u043b\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0433\u0430 \u0421\u0432\u044f\u0442\u043b\u0430, \u043d\u0430\u043c \u0434\u043e\u0431\u0440\u0430 \u0431\u044b\u043b\u043e \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0406\u043c \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430 \u043c\u044b \u0440\u0430\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u043c\u0441\u044f, \u0430\u0434\u0434\u0430\u043b\u044f\u0435\u043c\u0441\u044f \u0430\u0434\u0437\u0456\u043d \u0430\u0434 \u0430\u0434\u043d\u0430\u0433\u043e, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u043c \u043d\u0435 \u0430\u0434\u0434\u0430\u043b\u0456\u0446\u0446\u0430 \u0430\u0434 \u042f\u0433\u043e.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0410\u043f 22, 5. 4\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406 \u043d\u043e\u0447\u044b \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u0435\u0446\u044c \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u043d\u0456 \u045e \u0441\u0432\u044f\u0442\u043b\u0435 \u043b\u044f\u043c\u043f\u044b, \u043d\u0456 \u045e \u0441\u0432\u044f\u0442\u043b\u0435 \u0441\u043e\u043d\u0446\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u041f\u0430\u043d \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u0441\u0432\u044f\u0446\u0456\u0446\u044c \u043d\u0430\u0434 \u0456\u043c\u0456; \u0456 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423\u0431\u0430\u0447\u0430\u0446\u044c \u042f\u0433\u043e\u043d\u0430\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u0430 \u042f\u0433\u043e\u043d\u0430\u0435 \u0456\u043c\u044f \u0431\u0443\u0434\u0437\u0435 \u043d\u0430 \u0456\u0445 \u0447\u043e\u043b\u0430\u0445. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e \u041f\u0430\u043d.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"344","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f, \u044f\u043a\u0430\u044f \u043f\u0440\u044b\u043f\u0456\u0441\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0432. \u041c\u0430\u043a\u0430\u0440\u044b\u044e, \u0431\u0456\u0441\u043a\u0443\u043f\u0443<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 28: PG 34, 710-711)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0413\u043e\u0440\u0430 \u0434\u0443\u0448\u044b, \u0443 \u044f\u043a\u043e\u0439 \u043d\u0435 \u0436\u044b\u0432\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0411\u043e\u0433, \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u043d\u044b \u043d\u0430 \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u0430\u0434\u0434\u0430\u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u043d\u0430 \u0437\u0434\u0430\u0431\u044b\u0447\u0443 \u0432\u043e\u0440\u0430\u0433\u0430\u043c, \u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u043d\u0430\u0434 \u0456\u043c\u0456 \u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0456, \u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u0430\u044e\u0447\u044b \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u044b \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u044b, \u0442\u0430\u043a \u0456 \u0440\u0430\u0437\u0433\u043d\u0435\u0432\u0430\u043d\u044b \u043d\u0430 \u0434\u0443\u0448\u0443 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043f\u0430\u0440\u0443\u0448\u044d\u043d\u043d\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e, \u0401\u043d \u0430\u0434\u0434\u0430\u0435 \u044f\u0435 \u045e \u0440\u0443\u043a\u0456 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u045e, \u044f\u043a\u0456\u044f \u0441\u0445\u0456\u043b\u0456\u045e\u0448\u044b \u0434\u0430 \u0437\u043b\u0430, \u043f\u0443\u0441\u0442\u043e\u0448\u0430\u0446\u044c \u044f\u0435 \u0434\u0430\u0448\u0447\u044d\u043d\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a \u0456 \u0434\u043e\u043c, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0436\u044b\u0432\u0435 \u045e \u0456\u043c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440, \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0437\u043c\u0440\u043e\u0447\u043d\u044b\u043c, \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u043d\u044b\u043c \u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b\u043c, \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u0431\u0440\u0443\u0434\u0430\u043c \u0456 \u043f\u044b\u043b\u0430\u043c, \u0442\u0430\u043a \u0456 \u0434\u0443\u0448\u0430, \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u0430\u044f \u041f\u0430\u043d\u0430\u043c, \u044f\u043a\u0456 \u0431\u044b\u045e \u0443 \u0451\u0439 \u0437 \u0445\u043e\u0440\u0430\u043c\u0456 \u0430\u043d\u0451\u043b\u0430\u045e, \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u0446\u0435\u043c\u0440\u0430\u044e \u0433\u0440\u0430\u0445\u0443, \u0431\u0440\u0443\u0434\u0430\u043c \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0431\u0440\u044b\u0434\u043e\u0442\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u043e\u0440\u0430 \u0434\u0430\u0440\u043e\u0437\u0435, \u043f\u0430 \u044f\u043a\u043e\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u043d\u0435 \u0447\u0443\u0442\u043d\u044b \u043d\u0430 \u0451\u0439 \u0433\u043e\u043b\u0430\u0441 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0431\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u044f\u043d\u0430 \u0441\u0445\u043e\u0432\u0430\u043d\u043a\u0430\u0439 \u0434\u043b\u044f \u0434\u0437\u0456\u043a\u0456\u0445 \u0437\u0432\u044f\u0440\u043e\u045e. \u0413\u043e\u0440\u0430 \u0434\u0443\u0448\u044b, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u043d\u0435 \u043f\u0440\u0430\u0433\u0443\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0430 \u0451\u0439, \u043a\u0430\u043b\u0456 \u042f\u0433\u043e \u0433\u043e\u043b\u0430\u0441 \u043d\u0435 \u0430\u0434\u0433\u0430\u043d\u044f\u0435 \u0437\u043b\u044b\u0445 \u043f\u0430\u0447\u0432\u0430\u0440\u0430\u045e \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0440\u0430\u0437\u0431\u044d\u0448\u0447\u0430\u043d\u0430\u0441\u0446\u0456 \u0456 \u0445\u0456\u0442\u0440\u0430\u0441\u0446\u0456! \u0413\u043e\u0440\u0430 \u0434\u043e\u043c\u0443, \u043a\u0430\u043b\u0456 \u045e \u0456\u043c \u043d\u0435 \u0436\u044b\u0432\u0435 \u045e\u043b\u0430\u0434\u0430\u043b\u044c\u043d\u0456\u043a! \u0413\u043e\u0440\u0430 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0441\u0442\u0430\u043d\u0435 \u0437\u0435\u043c\u043b\u044f\u0440\u043e\u0431\u0430, \u044f\u043a\u0456 \u0434\u0430\u0433\u043b\u044f\u0434\u0430\u0435 \u044f\u0435! \u0413\u043e\u0440\u0430 \u0441\u0442\u0430\u0442\u043a\u0443, \u043a\u0430\u043b\u0456 \u045e \u044f\u0433\u043e \u043d\u044f\u043c\u0430 \u0441\u0442\u044b\u0440\u043d\u0430\u0432\u043e\u0433\u0430, \u0431\u043e, \u043a\u0430\u043b\u0456 \u043a\u0456\u0434\u0430\u044e\u0446\u044c \u044f\u0433\u043e \u0445\u0432\u0430\u043b\u0456 \u0456 \u0431\u0443\u0440\u044b, \u0451\u043d \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0437\u0430\u0433\u0456\u043d\u0435. \u0413\u043e\u0440\u0430 \u0434\u0443\u0448\u044b, \u043a\u0430\u043b\u0456 \u044f\u043d\u0430 \u043d\u0435 \u043c\u0430\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0421\u0442\u044b\u0440\u043d\u0430\u0432\u043e\u0433\u0430, \u0425\u0440\u044b\u0441\u0442\u0430! \u0410\u0445\u043e\u043f\u043b\u0435\u043d\u0430\u044f \u0446\u0435\u043c\u0440\u0430\u044e \u045e\u0441\u043f\u0435\u043d\u0435\u043d\u0430\u0433\u0430 \u043c\u043e\u0440\u0430, \u043a\u0430\u043b\u0456 \u043a\u0456\u0434\u0430\u044e\u0446\u044c \u044f\u0435 \u0445\u0432\u0430\u043b\u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0443\u0441\u0442\u0440\u0430\u0441\u0430\u044e\u0446\u044c \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u044f \u0434\u0443\u0445\u0456 \u043d\u0456\u0431\u044b \u0433\u0432\u0430\u043b\u0442\u043e\u045e\u043d\u0430\u0439 \u0431\u0443\u0440\u0430\u0439, \u044f\u043d\u0430 \u045e\u0440\u044d\u0448\u0446\u0435 \u0437\u0443\u0441\u0456\u043c \u043f\u0440\u0430\u043f\u0430\u0434\u0437\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u043e\u0440\u0430 \u0434\u0443\u0448\u044b, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e \u0451\u0439 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0431 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u044f\u0435 \u0434\u0430\u0433\u043b\u044f\u0434\u0430\u045e, \u043a\u0430\u0431 \u044f\u043d\u0430 \u043c\u0430\u0433\u043b\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0441\u043f\u0435\u043b\u044b\u044f \u043f\u043b\u0430\u0434\u044b \u0434\u0443\u0445\u0430, \u0431\u043e \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u0430\u044f, \u043f\u043e\u045e\u043d\u0430\u044f \u0446\u044f\u0440\u043d\u0456\u043d\u044b \u0456 \u043f\u0443\u0441\u0442\u0430\u0437\u0435\u043b\u043b\u044f, \u0437\u0430\u043c\u0435\u0441\u0442 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u043b\u0451\u043d, \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u043b\u0435\u043d\u0430\u044f \u0456 \u0437\u043d\u0456\u043a\u043d\u0435. \u0413\u043e\u0440\u0430 \u0434\u0443\u0448\u044b, \u0443 \u044f\u043a\u043e\u0439 \u043d\u0435 \u0436\u044b\u0432\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441! \u041f\u0430\u043a\u0456\u043d\u0443\u0442\u0430\u044f, \u044f\u043d\u0430 \u0434\u0430\u0435 \u043d\u0435\u043f\u0440\u044b\u0435\u043c\u043d\u044b \u043f\u0430\u0445 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043f\u0440\u044b\u0441\u0442\u0430\u043d\u0456\u0448\u0447\u0430\u043c \u0437\u0430\u0433\u0430\u043d\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0437\u0435\u043c\u043b\u044f\u0440\u043e\u0431, \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u043f\u0440\u0430\u0446\u0443, \u0431\u044f\u0440\u044d \u0437 \u0441\u0430\u0431\u043e\u044e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u044f \u043f\u0440\u044b\u043b\u0430\u0434\u044b \u0456 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443, \u0442\u0430\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041a\u0430\u0440\u043e\u043b\u044c, \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u0437\u0435\u043c\u043b\u044f\u0440\u043e\u0431, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0434\u0430 \u0441\u043f\u0443\u0441\u0442\u043e\u0448\u0430\u043d\u0430\u0433\u0430 \u0437\u0430\u0433\u0430\u043d\u0430\u043c\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430, \u043f\u0440\u044b\u043d\u044f\u045e \u0446\u0435\u043b\u0430, \u0443\u0437\u044f\u045e \u043a\u0440\u044b\u0436 \u043d\u0456\u0431\u044b \u043f\u0440\u044b\u043b\u0430\u0434\u0443 \u0456 \u0430\u043f\u0440\u0430\u0446\u043e\u045e\u0432\u0430\u045e \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u0443\u044e \u0434\u0443\u0448\u0443; \u0432\u044b\u0440\u044b\u0432\u0430\u045e \u0437 \u044f\u0435 \u0446\u044f\u0440\u043d\u0456\u043d\u0443 \u0456 \u043f\u0443\u0441\u0442\u0430\u0437\u0435\u043b\u043b\u0435 \u0437\u043b\u044b\u0445 \u0434\u0443\u0445\u0430\u045e, \u0432\u044b\u043a\u0430\u0440\u0430\u043d\u044f\u045e \u043a\u0430\u043b\u0430\u0441\u043e\u045e\u043d\u0456\u043a \u0437\u043b\u0430 \u0456 \u0441\u043f\u0430\u043b\u044c\u0432\u0430\u045e \u0443\u0441\u0451 \u0431\u044b\u043b\u043b\u0451 \u043d\u044f\u043f\u0440\u0430\u045e\u0434\u044b. \u0422\u0430\u043a, \u043f\u0440\u0430\u0446\u0443\u044e\u0447\u044b \u0434\u0440\u044d\u0432\u0430\u043c \u043a\u0440\u044b\u0436\u0430, \u0401\u043d \u0437\u0430\u043a\u043b\u0430\u045e \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0441\u0430\u0434 \u0414\u0443\u0445\u0430, \u0442\u0430\u043a\u0456 \u0441\u0430\u0434, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0411\u043e\u0433\u0443 \u044f\u043a \u0441\u0432\u0430\u0439\u043c\u0443 \u041f\u0430\u043d\u0443 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0433\u0430\u0442\u0443\u043d\u043a\u0456 \u0441\u0430\u043b\u043e\u0434\u043a\u0456\u0445 \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u0445 \u043f\u043b\u0430\u0434\u043e\u045e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042f\u043d 15, 1. 5\u0430. 9\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u2013 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u044f \u043b\u0430\u0437\u0430,<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u0432\u044b \u2013 \u0433\u0430\u043b\u0456\u043d\u044b. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0425\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u045e\u0432\u0430 \u041c\u043d\u0435, \u0430 \u042f \u045e \u0456\u043c, <\/span><span style=\"color: #ff0000;\">\/ <\/span><span>\u0442\u043e\u0439 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0431\u0430\u0433\u0430\u0442\u044b \u043f\u043b\u0451\u043d.&nbsp;<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f\u043a \u041c\u044f\u043d\u0435 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0410\u0439\u0446\u0435\u0446, \u0442\u0430\u043a \u0456 \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0425\u0442\u043e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"345","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u0441\u0432. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041c\u0430\u0446\u0432\u0435\u044f\u00bb \u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 33, 1. 2: PG 57, 389-390)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456 \u2013 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043c, \u043a\u0430\u043b\u0456 \u0432\u0430\u045e\u043a\u0430\u043c\u0456 \u2013 \u043f\u0430\u0446\u0435\u0440\u043f\u0456\u043c \u043f\u0430\u0440\u0430\u0437\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a \u0434\u043e\u045e\u0433\u0430 \u043c\u044b \u0437\u0430\u0441\u0442\u0430\u0451\u043c\u0441\u044f \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456, \u0442\u0430\u043a \u0434\u043e\u045e\u0433\u0430 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435\u043c. \u0410\u043a\u0440\u0443\u0436\u0430\u043d\u044b\u044f \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u0430\u0439 \u0433\u0440\u0430\u043c\u0430\u0434\u043e\u0439 \u0432\u0430\u045e\u043a\u043e\u045e, \u043c\u044b \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u044b\u044f. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0441\u0430\u043c\u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u043c\u0441\u044f \u0432\u0430\u045e\u043a\u0430\u043c\u0456, \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u044e\u0446\u044c \u043d\u0430\u0441, \u0431\u043e \u043c\u044b \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456 \u0414\u043e\u0431\u0440\u0430\u0433\u0430 \u041f\u0430\u0441\u0442\u044b\u0440\u0430. \u0401\u043d \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u0432\u0430\u045e\u043a\u043e\u045e, \u0430\u043b\u0435 \u0430\u0432\u0435\u0447\u0430\u043a. \u0422\u0430\u043c\u0443 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0446\u044f\u0431\u0435 \u0456 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u0432\u0430\u044e \u043c\u043e\u0446 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0442\u044b \u043d\u0435 \u0447\u0430\u043a\u0430\u0435\u0448.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0456\u0431\u044b \u0445\u0430\u0446\u0435\u045e \u0441\u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f, \u043a\u0430\u043b\u0456 \u042f \u043f\u0430\u0441\u044b\u043b\u0430\u044e \u0432\u0430\u0441 \u0434\u0430 \u0432\u0430\u045e\u043a\u043e\u045e, \u043f\u0430\u0432\u043e\u0434\u0437\u044c\u0446\u0435 \u0441\u044f\u0431\u0435 \u044f\u043a \u0430\u0432\u0435\u0447\u043a\u0456 \u0456 \u044f\u043a \u0433\u0430\u043b\u0443\u0431\u044b. \u042f \u043c\u043e\u0433 \u0431\u044b \u0432\u044b\u0440\u0430\u0448\u044b\u0446\u044c \u0456\u043d\u0430\u043a\u0448 \u0456 \u043d\u0435 \u043f\u0430\u0441\u044b\u043b\u0430\u0446\u044c \u0432\u0430\u0441 \u043d\u0430 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0443. \u042f \u043c\u043e\u0433 \u0431\u044b \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0432\u0430\u0441 \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456, \u0441\u043b\u0430\u0431\u0435\u0439\u0448\u044b\u043c\u0456 \u0437\u0430 \u0432\u0430\u045e\u043a\u043e\u045e, \u0430\u043b\u0435 \u0431\u043e\u043b\u044c\u0448 \u0441\u0442\u0440\u0430\u0448\u043d\u044b\u043c\u0456 \u0437\u0430 \u043b\u044c\u0432\u043e\u045e. \u0410\u043b\u0435 \u0442\u0430\u043a \u0442\u0440\u044d\u0431\u0430. \u0423 \u0433\u044d\u0442\u044b\u043c \u0432\u044b\u044f\u0432\u0456\u0446\u0446\u0430 \u0432\u0430\u0448\u0430\u044f \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044c \u0456 \u045e\u0441\u043b\u0430\u0432\u0456\u0446\u0446\u0430 \u043c\u0430\u044f \u043c\u043e\u0446\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u043d \u0442\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0432. \u041f\u0430\u045e\u043b\u0443: \u00ab\u0425\u043e\u043f\u0456\u0446\u044c \u0442\u0430\u0431\u0435 \u041c\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456, \u0431\u043e \u043c\u043e\u0446 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456\u00bb (2 \u041a\u0430\u0440 12, 9). \u00ab\u042f \u0442\u0430\u043a \u0432\u044b\u0440\u0430\u0448\u044b\u045e, \u2013 \u043d\u0456\u0431\u044b \u043a\u0430\u0436\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u2013 \u043a\u0430\u0431 \u0432\u044b \u0431\u044b\u043b\u0456 \u0442\u0430\u043a\u0456\u043c\u0456\u00bb. \u041a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430: \u00ab\u042f \u043f\u0430\u0441\u044b\u043b\u0430\u044e \u0432\u0430\u0441, \u044f\u043a \u044f\u0433\u043d\u044f\u0442 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u045e\u043a\u043e\u045e\u00bb (\u041b\u043a 10, 3), \u0442\u043e \u043d\u0456\u0431\u044b \u0434\u0430\u0434\u0430\u0435: \u00ab\u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f, \u042f \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u0434\u044b \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430 \u0432\u0430\u0441 \u043d\u0456\u044f\u043a\u0456 \u0432\u043e\u0440\u0430\u0433\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u0441\u0442\u0430\u043b\u0456 \u0431\u044f\u0437\u0434\u0437\u0435\u0439\u043d\u044b\u043c\u0456, \u0456 \u043a\u0430\u0431 \u043d\u0435 \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u045e\u0441\u0451 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0446\u0435 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u0434\u0430\u0440\u043c\u0430, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0446\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0431\u0435\u0437 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e, \u0434\u0430\u0434\u0430\u0435: \u00ab\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u044f, \u044f\u043a \u0437\u043c\u0435\u0456, \u0456 \u043f\u0440\u043e\u0441\u0442\u044b\u044f, \u044f\u043a \u0433\u0430\u043b\u0443\u0431\u044b\u00bb (\u041c\u0446 10, 16). \u0406\u043d\u0448\u044b\u044f \u0437\u0430\u043f\u044b\u0442\u0430\u044e\u0446\u0446\u0430: \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u043d\u0430\u0448\u0430\u044f \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0442\u0430\u043a\u043e\u0439 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a? \u042f\u043a \u0436\u0430 \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u043d\u0430\u0441 \u043a\u0456\u0434\u0430\u044e\u0446\u044c \u0440\u043e\u0437\u043d\u044b\u044f \u0445\u0432\u0430\u043b\u0456? \u0428\u0442\u043e \u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u0430\u044f \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u044f \u0430\u0432\u0435\u0447\u043a\u0430, \u0430\u043a\u0440\u0443\u0436\u0430\u043d\u0430\u044f \u0441\u0442\u0430\u044f\u0439 \u0432\u0430\u045e\u043a\u043e\u045e? \u042f\u043a \u0434\u0430\u043f\u0430\u043c\u043e\u0436\u0430 \u0441\u0430\u043c\u0430\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u0430 \u0433\u043e\u043b\u0443\u0431\u0430, \u043a\u0430\u043b\u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0430\u043a\u0440\u0443\u0436\u0430\u043d\u044b \u043c\u043d\u043e\u0441\u0442\u0432\u0430\u043c \u0433\u0440\u0443\u0433\u0430\u043d\u043e\u045e? \u0411\u0435\u0437 \u043f\u0430\u0442\u0440\u044d\u0431\u044b, \u043a\u0430\u043b\u0456 \u043c\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u0430\u043b\u0435 \u043a\u0430\u043b\u0456 \u0433\u0430\u0432\u043e\u0440\u043a\u0430 \u0456\u0434\u0437\u0435 \u043f\u0440\u0430 \u0432\u0430\u0441, \u0442\u043e \u0433\u044d\u0442\u0430 \u0434\u0430\u0441\u0446\u044c \u0432\u0435\u043b\u044c\u043c\u0456 \u0448\u043c\u0430\u0442.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u043c, \u044f\u043a\u0456 \u0432\u0456\u0434 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0430\u0441\u0446\u0456 \u0442\u0443\u0442 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0446\u0430. \u0420\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0437\u043c\u044f\u0456, \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u042f\u043a \u0437\u043c\u044f\u044f \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u045e\u0441\u0451, \u043d\u0430\u0432\u0430\u0442 \u0447\u0430\u0441\u0442\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0433\u0430\u043b\u0430\u0432\u0443, \u0442\u0430\u043a \u0456 \u0442\u044b, \u2013 \u043a\u0430\u0436\u0430 \u0401\u043d, \u2013 \u0437\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435\u043c \u0432\u0435\u0440\u044b \u043f\u0430\u043a\u0456\u043d\u044c \u0443\u0441\u0451: \u0431\u0430\u0433\u0430\u0446\u0446\u0435, \u0446\u0435\u043b\u0430, \u0430 \u043d\u0430\u0432\u0430\u0442 \u0436\u044b\u0446\u0446\u0451. \u0412\u0435\u0440\u0430 \u2013 \u0433\u044d\u0442\u0430 \u0433\u0430\u043b\u0430\u0432\u0430 \u0456 \u043a\u043e\u0440\u0430\u043d\u044c. \u041a\u0430\u043b\u0456 \u045e\u0440\u0430\u0442\u0443\u0435\u0448 \u0432\u0435\u0440\u0443, \u0442\u043e \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0443\u0441\u0451 \u0456\u043d\u0448\u0430\u0435 \u0437\u0433\u0443\u0431\u0456\u0448, \u0442\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0442\u0430\u0431\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u043c\u043d\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u043d\u0435 \u0440\u0430\u0456\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u044b\u0446\u044c \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0456 \u0446\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u043c\u0456, \u0430\u043b\u0435 \u0456 \u0430\u0434\u043d\u044b\u043c\u0456, \u0456 \u0434\u0440\u0443\u0433\u0456\u043c\u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430, \u043a\u0430\u0431 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u0446\u043d\u043e\u0442\u0430\u044e. \u041d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0437\u043c\u044f\u0456, \u043a\u0430\u0431 \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0443\u0446\u044c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u0445 \u0440\u0430\u043d\u0430\u045e. \u041d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u0430 \u0433\u043e\u043b\u0443\u0431\u0430, \u043a\u0430\u0431 \u043d\u0435 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u043f\u043e\u043c\u0441\u0446\u0456\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0430\u0441 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u045e, \u0456 \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u0434\u0443\u043c\u0432\u0430\u0435 \u043f\u0430\u0441\u0442\u043a\u0456. \u041d\u0435\u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0434\u0443\u043c\u0430\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u044b\u044f \u043f\u0430\u0440\u0430\u0434\u044b \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c. \u041f\u0430\u043d \u0432\u0435\u0434\u0430\u0435 \u043b\u0435\u043f\u0448, \u0447\u044b\u043c \u0445\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0456\u043d\u0448\u044b, \u044f\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u0430. \u0412\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u043d\u0430\u0441\u0456\u043b\u043b\u044f \u043d\u0435\u043b\u044c\u0433\u0430 \u0441\u043f\u044b\u043d\u0456\u0446\u044c \u043d\u0430\u0441\u0456\u043b\u043b\u0435\u043c, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0446 10, 16; \u042f\u043d 12, 36\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u043e\u0441\u044c \u042f \u043f\u0430\u0441\u044b\u043b\u0430\u044e \u0432\u0430\u0441, \u044f\u043a \u0430\u0432\u0435\u0447\u0430\u043a \u043f\u0430\u043c\u0456\u0436 \u0432\u0430\u045e\u043a\u043e\u045e, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u044f, \u044f\u043a \u0437\u043c\u0435\u0456, \u0456 \u043f\u0440\u043e\u0441\u0442\u044b\u044f, \u044f\u043a \u0433\u0430\u043b\u0443\u0431\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0430\u043a\u0443\u043b\u044c \u043c\u0430\u0435\u0446\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0432\u0435\u0440\u0446\u0435 \u045e \u0441\u0432\u044f\u0442\u043b\u043e, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0441\u0432\u044f\u0442\u043b\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u044c\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"346","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u041f\u0440\u0430 \u0441\u043c\u0435\u0440\u0446\u044c\u00bb \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 18. 24. 26: CSEL 3, 308. 312-314)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b\u044f \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443 \u0441\u043c\u0435\u0440\u0446\u0456, \u043f\u0430\u0434\u0443\u043c\u0430\u0435\u043c \u043f\u0440\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u0448\u0442\u043e \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u043d\u0435 \u0441\u0432\u0430\u044e \u0432\u043e\u043b\u044e, \u0430\u043b\u0435 \u0411\u043e\u0433\u0430, \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0440\u0430\u0456\u0446\u044c \u043d\u0430\u043c \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0430\u0431 \u0433\u044d\u0442\u044b\u043c \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430. \u042f\u043a \u0436\u0430 \u0433\u044d\u0442\u0430 \u043d\u0435\u043b\u0430\u0433\u0456\u0447\u043d\u0430 \u0456 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430, \u0448\u0442\u043e \u043c\u044b, \u0445\u043e\u0446\u044c \u0456 \u0441\u0430\u043c\u0456 \u043f\u0440\u043e\u0441\u0456\u043c \u0430\u0431 \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0456 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456, \u043d\u0435 \u0445\u043e\u0447\u0430\u043c \u0430\u0434\u0440\u0430\u0437\u0443 \u0437\u0433\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u042f\u0433\u043e \u0437\u0430\u0433\u0430\u0434\u0430\u043c, \u043a\u0430\u043b\u0456 \u0401\u043d \u043a\u0430\u0436\u0430 \u0456 \u043a\u043b\u0456\u0447\u0430 \u043d\u0430\u0441 \u0430\u0434\u044b\u0441\u0446\u0456 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0421\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0435\u043c\u0441\u044f, \u0431\u0430\u0440\u043e\u043d\u0456\u043c\u0441\u044f \u0456, \u044f\u043a \u0443\u043f\u0430\u0440\u0442\u044b\u0445 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e, \u043d\u0430\u0441, \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u0456 \u0437 \u0436\u0430\u043b\u0435\u043c, \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u041f\u0430\u043d\u0430. \u041c\u044b \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u043c \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0437\u043c\u0443\u0448\u0430\u043d\u044b\u044f \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0441\u0446\u044e, \u0430 \u043d\u0435 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b\u044f \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044e. \u0410 \u0432\u0435\u0447\u043d\u0430\u0439 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b \u0447\u0430\u043a\u0430\u0435\u043c \u0430\u0434 \u0442\u0430\u0433\u043e, \u0434\u0430 \u043a\u0430\u0433\u043e \u0442\u0430\u043a \u043d\u0435\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0456\u0434\u0437\u0451\u043c. \u0427\u0430\u043c\u0443 \u0436 \u0442\u0430\u0434\u044b \u043f\u0440\u043e\u0441\u0456\u043c \u0456 \u0432\u044b\u043c\u043e\u043b\u044c\u0432\u0430\u0435\u043c, \u043a\u0430\u0431 \u043f\u0440\u044b\u0439\u0448\u043b\u043e \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u043a\u0430\u043b\u0456 \u0440\u0430\u0441\u043a\u043e\u0448\u0430\u0439 \u0434\u043b\u044f \u043d\u0430\u0441 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u044f\u043c\u043d\u0430\u044f \u043d\u044f\u0432\u043e\u043b\u044f? \u0427\u0430\u043c\u0443 \u045e \u0447\u0430\u0441\u0442\u044b\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445 \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u0445\u0443\u0442\u0447\u044d\u0439 \u043d\u0430\u0441\u0442\u0430\u045e \u0434\u0437\u0435\u043d\u044c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u043a\u0430\u043b\u0456 \u043d\u0430\u0448\u044b\u043c \u0433\u0430\u0440\u0430\u0447\u044b\u043c \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0445\u0443\u0442\u0447\u044d\u0439 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0434\u2019\u044f\u0431\u043b\u0443 \u0442\u0443\u0442, \u0430 \u043d\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043d\u043d\u0435 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0441\u0432\u0435\u0442 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430, \u0447\u0430\u043c\u0443 \u0442\u044b \u043b\u044e\u0431\u0456\u0448 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0446\u044f\u0431\u0435 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c, \u0430 \u043d\u0435 \u0456\u0434\u0437\u0435\u0448 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u044f\u043a\u0456 \u0446\u044f\u0431\u0435 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0456 \u0430\u0434\u043a\u0443\u043f\u0456\u045e. \u0423 \u0441\u0432\u0430\u0456\u043c \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u0441\u0432. \u042f\u043d \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043d\u0430\u0441 \u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435, \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u043b\u044e\u0431\u0456\u043b\u0456 \u0441\u0432\u0435\u0442, \u0456\u0434\u0443\u0447\u044b \u0437\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u043c\u0456 \u0446\u0435\u043b\u0430. \u00ab\u041d\u0435 \u043b\u044e\u0431\u0456\u0446\u0435, \u2013 \u043a\u0430\u0436\u0430 \u0451\u043d, \u2013 \u0441\u0432\u0435\u0442\u0443, \u043d\u0456 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0441\u0432\u0435\u0446\u0435. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0432\u0435\u0442, \u0443 \u0442\u044b\u043c \u043d\u044f\u043c\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u0410\u0439\u0446\u0430. \u0411\u043e \u045e\u0441\u0451, \u0448\u0442\u043e \u045e \u0441\u0432\u0435\u0446\u0435: \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0446\u0435\u043b\u0430, \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0432\u0430\u0447\u044d\u0439 \u0456 \u0436\u044b\u0446\u0446\u0451\u0432\u0430\u044f \u043f\u044b\u0445\u0430 \u2013 \u043d\u0435 \u0430\u0434 \u0410\u0439\u0446\u0430, \u0430\u043b\u0435 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0406 \u0441\u0432\u0435\u0442 \u043c\u0456\u043d\u0430\u0435, \u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u044f\u0433\u043e\u043d\u0430\u044f, \u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0411\u043e\u0436\u0443\u044e \u0432\u043e\u043b\u044e, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u0432\u0435\u0447\u043d\u0430\u00bb (1 \u042f\u043d 2, 15-17). \u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b! \u0411\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u0441\u043f\u0430\u045e\u043d\u044f\u0446\u044c \u0411\u043e\u0436\u0443\u044e \u0432\u043e\u043b\u044e \u0437 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u0439 \u0432\u0435\u0440\u0430\u044e, \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0439 \u0446\u043d\u043e\u0442\u0430\u044e. \u041f\u0430\u0437\u0431\u044b\u045e\u0448\u044b\u0441\u044f \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043f\u0440\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u043f\u0430\u0441\u043b\u044f \u043d\u0430\u0434\u044b\u0434\u0437\u0435. \u0422\u0430\u043a \u043f\u0430\u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u0442\u043e\u0435, \u0443 \u0448\u0442\u043e \u043c\u044b \u0432\u0435\u0440\u044b\u043c, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0456\u0441\u043d\u0443\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u043c \u0442\u0440\u044d\u0431\u0430, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0432\u0435\u0434\u0430\u0446\u044c \u0456 \u0447\u0430\u0441\u0442\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0430\u0434 \u0442\u044b\u043c, \u0448\u0442\u043e \u043c\u044b \u0432\u044b\u0440\u0430\u043a\u043b\u0456\u0441\u044f \u0441\u0432\u0435\u0442\u0443, \u0448\u0442\u043e \u0436\u044b\u0432\u0451\u043c \u0442\u0443\u0442 \u0447\u0430\u0441\u043e\u0432\u0430 \u044f\u043a \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u044b \u0456 \u0433\u043e\u0441\u0446\u0456. \u041f\u0440\u044b\u043c\u0435\u043c \u0436\u0430 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c, \u044f\u043a\u0456 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0435 \u0436\u044b\u043b\u043b\u0451, \u0432\u044b\u0440\u0432\u0435 \u043d\u0430\u0441 \u0441\u0430 \u0441\u0432\u0435\u0442\u0443, \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u0430\u0434 \u044f\u0433\u043e \u043f\u0443\u0442\u0430\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0435\u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u043c\u0443 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0443 \u0456 \u0448\u0447\u0430\u0441\u0446\u044e. \u042f\u043a\u0456 \u0436 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u045e \u0430\u0439\u0447\u044b\u043d\u0443? \u0410 \u043d\u0430\u0448\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u0430\u0439 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435\u0431\u0430. \u0422\u0430\u043c \u0447\u0430\u043a\u0430\u0435 \u043d\u0430\u0441 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043c\u044b \u043b\u044e\u0431\u0456\u043c: \u0431\u0430\u0446\u044c\u043a\u0456, \u0440\u043e\u0434\u043d\u044b\u044f, \u0434\u0437\u0435\u0446\u0456, \u044f\u043a\u0456\u044f, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u045e\u0436\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0437\u0430\u043a\u043b\u0430\u043f\u043e\u0447\u0430\u043d\u044b\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0448\u044b\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c. \u042f\u043a\u0430\u044f \u0436 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0434\u043b\u044f \u0456\u0445 \u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0441\u0443\u0441\u0442\u0440\u044d\u0446\u0446\u0430 \u0456 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e! \u042f\u043a\u043e\u0435 \u0436 \u0433\u044d\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u045e \u041d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u0441\u043c\u0435\u0440\u0446\u0456, \u044f\u043a\u043e\u0435 \u0436 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u0456 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u0436\u044b\u0446\u044c \u0432\u0435\u0447\u043d\u0430!<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c \u0441\u043b\u0430\u045e\u043d\u044b \u0445\u043e\u0440 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0445\u043e\u0440 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0442\u0430\u043c \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u0430\u044f \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e, \u0443\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u043d\u044b\u0445 \u0445\u0432\u0430\u043b\u043e\u044e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456 \u045e \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456. \u0422\u0430\u043c \u043b\u0456\u043a\u0443\u044e\u0447\u044b\u044f \u0434\u0437\u0435\u0432\u044b, \u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0446\u0435\u043b\u0430 \u043c\u043e\u0446\u0430\u044e \u045e\u0441\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f; \u0442\u0430\u043c \u0430\u0434\u043e\u0440\u0430\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u0446\u044b, \u044f\u043a\u0456\u044f \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u0456 \u045e\u0447\u044b\u043d\u043a\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u0431\u043e \u0434\u0430\u0432\u0430\u043b\u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u043c \u0435\u0436\u0443 \u0456 \u0430\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u0456\u043d\u0448\u0443\u044e \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443. \u042f\u043d\u044b, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u041f\u0430\u043d\u0430, \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u043b\u0456 \u0441\u0432\u0430\u044e \u0437\u044f\u043c\u043d\u0443\u044e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0441\u043a\u0430\u0440\u0431\u0430\u045e. \u0421\u043f\u044f\u0448\u0430\u0439\u043c\u0430\u0441\u044f \u0434\u0430 \u0456\u0445, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0437 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0430\u0434\u0434\u0430\u043d\u043d\u0435\u043c. \u041d\u044f\u0445\u0430\u0439 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433 \u0433\u044d\u0442\u044b\u044f \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u043c\u043a\u0456, \u043d\u044f\u0445\u0430\u0439 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0433\u043b\u044f\u043d\u0435 \u043d\u0430 \u0433\u044d\u0442\u0430\u0435 \u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u0440\u043e\u0437\u0443\u043c\u0443 \u0456 \u0432\u0435\u0440\u044b, \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0441 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u045e\u044e, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u043e\u0440\u0430\u0447\u0430 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0447\u0430\u043a\u0430\u0446\u044c \u042f\u0433\u043e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0424\u043b\u043f 3, 20-21\u0430; \u041a\u043b\u0441 3, 4\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0430\u0448\u0430 \u0430\u0439\u0447\u044b\u043d\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445, \u0430\u0434\u043a\u0443\u043b\u044c \u043c\u044b \u0447\u0430\u043a\u0430\u0435\u043c \u0417\u0431\u0430\u045e\u0446\u0443, \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u043d\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u043b\u0456 \u0436 \u0437\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435, \u0442\u0430\u0434\u044b \u0456 \u0432\u044b \u0437\u2019\u044f\u0432\u0456\u0446\u0435\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443 \u0445\u0432\u0430\u043b\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u042f\u043a\u0456 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"347","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 256, 1. 2. 3: PL 38, 1191-1193)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u00ab\u0410\u043b\u043b\u0435\u043b\u044e\u044f\u00bb \u0434\u043e\u0431\u0440\u0430\u043c\u0443 \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u0432\u044b\u0431\u0430\u045e\u043b\u044f\u0435 \u043d\u0430\u0441 \u0430\u0434 \u0437\u043b\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0443\u0442, \u0441\u044f\u0440\u043e\u0434 \u0442\u0443\u0440\u0431\u043e\u0442\u0430\u045e, \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u00ab\u0410\u043b\u043b\u0435\u043b\u044e\u044f\u00bb, \u043a\u0430\u0431 \u0442\u0430\u043c, \u0443 \u0441\u043f\u0430\u043a\u043e\u0456 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430. \u0427\u0430\u043c\u0443 \u0442\u0443\u0442, \u0441\u044f\u0440\u043e\u0434 \u0442\u0443\u0440\u0431\u043e\u0442\u0430\u045e? \u0422\u044b \u0445\u043e\u0447\u0430\u0448, \u043a\u0430\u0431 \u044f \u043d\u0435\u043f\u0430\u043a\u043e\u0456\u045e\u0441\u044f, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u0447\u044b\u0442\u0430\u0446\u044c: \u00ab\u0416\u044b\u0446\u0446\u0451 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u2013 \u0433\u044d\u0442\u0430 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435\u00bb (\u043f\u0430\u0440. \u0401\u045e 7, 1)? \u0422\u044b \u0445\u043e\u0447\u0430\u0448, \u043a\u0430\u0431 \u044f \u0442\u0443\u0440\u0431\u0430\u0432\u0430\u045e\u0441\u044f, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u044e \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u044f \u0434\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u044b: \u00ab\u0427\u0443\u0432\u0430\u0439\u0446\u0435 \u0456 \u043c\u0430\u043b\u0456\u0446\u0435\u0441\u044f, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u0446\u0446\u0430 \u0441\u043f\u0430\u043a\u0443\u0441\u0435\u00bb (\u041c\u0446 26,&nbsp; 41)? \u0422\u044b \u043d\u0435 \u0445\u043e\u0447\u0430\u0448, \u043a\u0430\u0431 \u044f \u0441\u0443\u043c\u0430\u0432\u0430\u045e, \u0448\u0442\u043e \u0442\u0443\u0442 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043f\u0430\u043a\u0443\u0441\u0430\u045e \u0456 \u0448\u0442\u043e \u0441\u0430\u043c\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043d\u0430\u043c \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u0446\u044c: \u00ab\u0410\u0434\u043f\u0443\u0441\u0446\u0456 \u043d\u0430\u043c \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u043d\u0430\u0448\u044b, \u044f\u043a \u0456 \u043c\u044b \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0435\u043c \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b\u043c \u043d\u0430\u0448\u044b\u043c\u00bb (\u041c\u0446 6, 12)? \u041c\u044b \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u045e\u0437\u043d\u043e\u0441\u0456\u043c \u043f\u0440\u043e\u0441\u044c\u0431\u044b, \u0431\u043e \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u043c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u044f. \u0422\u044b \u0445\u043e\u0447\u0430\u0448, \u043a\u0430\u0431 \u044f \u0431\u044b\u045e \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b \u0442\u0443\u0442, \u0434\u0437\u0435 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u043f\u0440\u043e\u0441\u044f\u0446\u044c \u0430\u0431 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0456 \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u043f\u0440\u043e\u0441\u044f\u0446\u044c \u0430\u0431 \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u043f\u0440\u044b \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430\u0445? \u041a\u0430\u043b\u0456 \u044f, \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u043c\u0456\u043d\u0443\u043b\u044b\u044f \u0433\u0440\u0430\u0445\u0456, \u043a\u0430\u0436\u0443: \u00ab\u0410\u0434\u043f\u0443\u0441\u0446\u0456 \u043d\u0430\u043c \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u043d\u0430\u0448\u044b, \u044f\u043a \u0456 \u043c\u044b \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0435\u043c \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b\u043c \u043d\u0430\u0448\u044b\u043c\u00bb, \u0442\u0443\u0442 \u0436\u0430 \u0434\u0430\u0434\u0430\u044e, \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u0443\u044e \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0443: \u00ab\u0406 \u043d\u0435 \u045e\u0432\u043e\u0434\u0437\u044c \u043d\u0430\u0441 \u0443 \u0441\u043f\u0430\u043a\u0443\u0441\u0443\u00bb (\u041c\u0446 6, 13). \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434, \u044f\u043a \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0443 \u0431\u044f\u0441\u043f\u0435\u0446\u044b, \u043a\u0430\u043b\u0456 \u043a\u043b\u0456\u0447\u0430 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u043c\u043d\u043e\u044e: \u00ab\u0417\u0431\u0430\u045e \u043d\u0430\u0441 \u0430\u0434 \u0437\u043b\u043e\u0433\u0430\u00bb (\u041c\u0446 6, 13)? \u0410\u0434\u043d\u0430\u043a \u0436\u0430, \u0431\u0440\u0430\u0442\u044b, \u043d\u0430\u0432\u0430\u0442 \u0443 \u0433\u044d\u0442\u044b\u043c \u0446\u044f\u0436\u043a\u0456\u043c \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0448\u0447\u044b \u043c\u044b \u0441\u043f\u044f\u0432\u0430\u0435\u043c \u00ab\u0410\u043b\u043b\u0435\u043b\u044e\u044f\u00bb \u0434\u043e\u0431\u0440\u0430\u043c\u0443 \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u0432\u044b\u0431\u0430\u045e\u043b\u044f\u0435 \u043d\u0430\u0441 \u0430\u0434 \u0437\u043b\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u0443\u0442, \u0441\u044f\u0440\u043e\u0434 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a \u0456 \u0441\u043f\u0430\u043a\u0443\u0441\u0430\u045e, \u043c\u044b \u045e\u0441\u0435 \u0441\u043f\u044f\u0432\u0430\u0435\u043c \u00ab\u0410\u043b\u043b\u0435\u043b\u044e\u044f\u00bb. \u00ab\u0411\u043e\u0433, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0432\u0435\u0440\u043d\u044b\u043c, \u2013 \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, \u2013 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u0432\u0430\u0441 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043c\u0430\u0435\u0446\u0435 \u0441\u0456\u043b\u044b\u00bb (1 \u041a\u0430\u0440 10, 13). \u0422\u0430\u043c\u0443 \u0456 \u0442\u0443\u0442 \u043c\u044b \u0441\u043f\u044f\u0432\u0430\u0435\u043c \u00ab\u0410\u043b\u043b\u0435\u043b\u044e\u044f\u00bb. \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b, \u0430\u043b\u0435 \u0411\u043e\u0433 \u0432\u0435\u0440\u043d\u044b. \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u0411\u043e\u0433 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0432\u0430\u0441 \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u0446\u044c\u00bb, \u0430\u043b\u0435: \u00ab\u0411\u043e\u0433 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u0432\u0430\u0441 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043c\u0430\u0435\u0446\u0435 \u0441\u0456\u043b\u044b, \u0430\u043b\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0434\u0430\u0441\u0446\u044c \u0456 \u0432\u044b\u0439\u0441\u0446\u0435, \u043a\u0430\u0431 \u0432\u044b \u043c\u0430\u0433\u043b\u0456 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0446\u044c\u00bb (1 \u041a\u0430\u0440 10, 13). \u0422\u044b \u0437\u0432\u0435\u0434\u0432\u0430\u0435\u0448 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435; \u0411\u043e\u0433 \u043f\u0430\u043a\u0430\u0436\u0430 \u0432\u044b\u0439\u0441\u0446\u0435, \u043a\u0430\u0431 \u0442\u044b \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u045e, \u0434\u044b \u045e\u0447\u044b\u043d\u0456\u0446\u044c, \u043a\u0430\u0431 \u0442\u044b \u044f\u043a \u043d\u0430\u0447\u044b\u043d\u043d\u0435 \u0431\u044b\u045e \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u043d\u044b \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435\u043c. \u041a\u0430\u043b\u0456 \u0442\u0440\u0430\u043f\u0456\u0448 \u0443 \u0441\u043f\u0430\u043a\u0443\u0441\u0443, \u0434\u0443\u043c\u0430\u0439 \u043f\u0440\u0430 \u0442\u043e\u0435, \u044f\u043a \u0432\u044b\u0439\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0432\u0435\u0440\u043d\u044b\u043c: \u00ab\u041f\u0430\u043d \u0431\u0443\u0434\u0437\u0435 \u0441\u0446\u0435\u0440\u0430\u0433\u0447\u044b \u0432\u044b\u0439\u0441\u0446\u0435 \u0442\u0432\u0430\u0451 \u0456 \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435\u00bb (\u041f\u0441 121 [120], 7-8).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0436 \u043d\u0430\u0448\u0430\u0435 \u0446\u0435\u043b\u0430 \u0441\u0442\u0430\u043d\u0435 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0456 \u043d\u044f\u0431\u0430\u0447\u043d\u044b\u043c, \u0442\u0430\u0434\u044b \u0441\u043f\u044b\u043d\u0456\u0446\u0446\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u044f \u0441\u043f\u0430\u043a\u0443\u0441\u0430, \u0431\u043e \u00ab\u0446\u0435\u043b\u0430 \u043c\u0451\u0440\u0442\u0432\u0430\u0435\u00bb. \u0427\u0430\u043c\u0443? \u00ab\u0417-\u0437\u0430 \u0433\u0440\u0430\u0445\u0443\u00bb. \u0410 \u00ab\u0414\u0443\u0445 \u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451\u00bb. \u042f\u043a? \u00ab\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044e\u00bb (\u0420\u044b\u043c 8, 10). \u0414\u044b\u043a \u043c\u044b \u043f\u0430\u043a\u0456\u043d\u0435\u043c \u043c\u0451\u0440\u0442\u0432\u0430\u0435 \u0446\u0435\u043b\u0430? \u041d\u0435, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0434\u0430\u043b\u0435\u0439: \u00ab\u041a\u0430\u043b\u0456 \u0436 \u0414\u0443\u0445 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0415\u0437\u0443\u0441\u0430, \u0436\u044b\u0432\u0435 \u045e \u0432\u0430\u0441, \u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0436\u044b\u0432\u0456\u0446\u044c \u0456 \u0432\u0430\u0448\u044b\u044f \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u044f \u0446\u0435\u043b\u044b \u0414\u0443\u0445\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0443 \u0432\u0430\u0441\u00bb (\u0420\u044b\u043c 8, 11). \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043d\u0430\u0448\u0430\u0435 \u0446\u0435\u043b\u0430, \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0437\u044f\u043c\u043d\u043e\u0435, \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0442\u0430\u0434\u044b \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a\u043e\u0435 \u0436 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0435 \u0442\u043e\u0435 \u00ab\u0410\u043b\u043b\u0435\u043b\u044e\u044f\u00bb! \u00ab\u0410\u043b\u043b\u0435\u043b\u044e\u044f\u00bb \u0431\u044f\u0441\u043f\u0435\u043a\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e, \u0434\u0437\u0435 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f, \u0434\u0437\u0435 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443 \u045e \u0441\u044f\u0431\u0440\u0430\u0445. \u0422\u0430\u043c \u0456 \u0442\u0443\u0442 \u0433\u0443\u0447\u044b\u0446\u044c \u0411\u043e\u0436\u0430\u044f \u0445\u0432\u0430\u043b\u0430. \u0410\u0434\u043d\u0430\u043a \u0442\u0443\u0442 \u0441\u044f\u0440\u043e\u0434 \u0442\u0443\u0440\u0431\u043e\u0442\u0430\u045e, \u0442\u0430\u043c \u0443 \u0441\u043f\u0430\u043a\u043e\u0456; \u0442\u0443\u0442 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u044f\u0435 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043c\u0435\u0440\u0446\u0456, \u0442\u0430\u043c \u0442\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u0432\u0435\u0447\u043d\u0430; \u0442\u0443\u0442 \u0443 \u043d\u0430\u0434\u0437\u0435\u0456, \u0442\u0430\u043c \u0443 \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0456; \u0442\u0443\u0442 \u0443 \u0434\u0430\u0440\u043e\u0437\u0435, \u0442\u0430\u043c \u0443 \u0430\u0439\u0447\u044b\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u044f\u0432\u0430\u0446\u044c, \u0431\u0440\u0430\u0442\u044b, \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0433\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443, \u0430\u043b\u0435 \u0434\u043b\u044f \u043f\u0430\u043b\u0451\u0433\u043a\u0456 \u045e \u043f\u0440\u0430\u0446\u044b. \u042f\u043a \u0437\u0430\u0437\u0432\u044b\u0447\u0430\u0439 \u0440\u0430\u0431\u0456\u043b\u0456 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0456, \u0441\u043f\u044f\u0432\u0430\u0439, \u0430\u043b\u0435 \u0456\u0434\u0437\u0456 \u043d\u0430\u043f\u0435\u0440\u0430\u0434, \u0441\u043f\u0430\u0442\u0430\u043b\u044f\u0439 \u0441\u043f\u0435\u0432\u0430\u043c \u0441\u0442\u043e\u043c\u0443, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0440\u044b\u043a\u0440\u044b\u0432\u0430\u0439 \u043b\u044f\u043d\u043e\u0442\u044b; \u0441\u043f\u044f\u0432\u0430\u0439 \u0434\u044b \u0456\u0434\u0437\u0456. \u0428\u0442\u043e \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u00ab\u0456\u0434\u0437\u0456\u00bb? \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0439, \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0439 \u0443 \u0434\u043e\u0431\u0440\u044b\u043c! \u0411\u043e \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0456\u044f, \u2013 \u044f\u043a \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u2013 \u044f\u043a\u0456\u044f \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u044e\u0446\u044c \u0443 \u0434\u0440\u044d\u043d\u043d\u044b\u043c. \u041a\u0430\u043b\u0456 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0435\u0448, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0456\u0434\u0437\u0435\u0448; \u0430\u043b\u0435 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0439 \u0443 \u0434\u043e\u0431\u0440\u044b\u043c, \u0443 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0432\u0435\u0440\u044b, \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0439 \u0443 \u0434\u043e\u0431\u0440\u044b\u0445 \u0437\u0432\u044b\u0447\u0430\u044f\u0445; \u0441\u043f\u044f\u0432\u0430\u0439 \u0434\u044b \u0456\u0434\u0437\u0456.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0410\u043f 21, 21; \u0422\u043e\u0431 13, 17. 18. 11\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u043b\u043e\u0448\u0447\u044b \u0442\u0432\u0430\u0435, \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0431\u0443\u0434\u0443\u0446\u044c \u0437 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0437\u043e\u043b\u0430\u0442\u0430, \u0456 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0431\u0443\u0434\u0443\u0446\u044c \u0443 \u0442\u0430\u0431\u0435 \u0441\u043f\u0435\u045e \u0440\u0430\u0434\u0430\u0441\u0446\u0456. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041d\u0430 \u045e\u0441\u0456\u0445 \u0432\u0443\u043b\u0456\u0446\u0430\u0445 \u0442\u0432\u0430\u0456\u0445 \u0430\u0434\u0443\u0441\u044e\u043b\u044c \u0431\u0443\u0434\u0437\u0435 \u0433\u0443\u0447\u0430\u0446\u044c: \u0410\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0422\u044b \u0437\u0430\u0437\u0437\u044f\u0435\u0448 \u044f\u0441\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0456 \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041d\u0430 \u045e\u0441\u0456\u0445.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"411","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0442\u044d\u0445\u0435\u0437\u0430 \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cat. 15, 1-3: PG 33, 870-874)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0414\u0432\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0425\u0440\u044b\u0441\u0442\u0430: \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u0435, \u0430\u043b\u0435 \u0456 \u0434\u0440\u0443\u0433\u043e\u0435, \u043d\u0430\u0448\u043c\u0430\u0442 \u0446\u0443\u0434\u043e\u045e\u043d\u0435\u0439\u0448\u0430\u0435 \u0430\u0434 \u043f\u0435\u0440\u0448\u0430\u0433\u0430. \u0411\u043e \u043f\u0435\u0440\u0448\u0430\u0435 \u043f\u0435\u0440\u0430\u0432\u0430\u0436\u043d\u0430 \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043b\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435, \u0430 \u0434\u0440\u0443\u0433\u043e\u0435 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0434\u044b\u044f\u0434\u044d\u043c\u0443 \u0411\u043e\u0436\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0448\u043c\u0430\u0442 \u0447\u0430\u0433\u043e \u0434\u0432\u0430\u044f\u043a\u0430\u0433\u0430 \u0451\u0441\u0446\u044c \u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0414\u0432\u0430\u044f\u043a\u0430\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435: \u0430\u0434\u043d\u043e \u0430\u0434 \u0411\u043e\u0433\u0430 \u043f\u0435\u0440\u0430\u0434 \u0432\u044f\u043a\u0430\u043c\u0456, \u0434\u0440\u0443\u0433\u043e\u0435 &ndash; \u0430\u0434 \u041f\u0430\u043d\u043d\u044b \u043d\u0430\u043f\u0440\u044b\u043a\u0430\u043d\u0446\u044b \u0432\u044f\u043a\u043e\u045e. \u0414\u0432\u0430\u044f\u043a\u0430\u0435 \u0456 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u042f\u0433\u043e\u043d\u0430\u0435: \u0430\u0434\u043d\u043e \u043d\u0435\u0437\u0430\u045e\u0432\u0430\u0436\u0430\u043b\u044c\u043d\u0430\u0435, \u043d\u0456\u0431\u044b \u0440\u0430\u0441\u044b \u043d\u0430 \u0440\u0443\u043d\u043e, \u0430 \u0434\u0440\u0443\u0433\u043e\u0435, \u044f\u043a\u043e\u0435 \u043d\u0430\u0441\u0442\u0430\u043d\u0435, \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0447\u0430\u0441 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u042f\u0433\u043e \u0441\u043f\u0430\u0432\u0456\u043b\u0456 \u045e \u043f\u044f\u043b\u044e\u0448\u043a\u0456 \u0456 \u043f\u0430\u043a\u043b\u0430\u043b\u0456 \u045e \u0436\u043e\u043b\u0430\u0431\u0435. \u041f\u0430\u0434\u0447\u0430\u0441 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 &ndash; \u0401\u043d \u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u0441\u0432\u044f\u0442\u043b\u043e, \u043d\u0456\u0431\u044b \u045e \u0448\u0430\u0442\u044b. \u041f\u0430\u0434\u0447\u0430\u0441 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0401\u043d \u0442\u0440\u044b\u043c\u0430\u045e \u043a\u0440\u044b\u0436, \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e\u0448\u044b \u0433\u0430\u043d\u044c\u0431\u0430\u044e; \u043f\u0430\u0434\u0447\u0430\u0441 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 &ndash; \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u045e \u0430\u0442\u0430\u0447\u044d\u043d\u043d\u0456 \u0430\u043d\u0451\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u0432\u043e\u0439\u0441\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u044b \u043d\u0435 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u044c\u0432\u0430\u0435\u043c\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0448\u044b\u043c \u043f\u0440\u044b\u0439\u0441\u0446\u0435\u043c, \u0430\u043b\u0435 \u0447\u0430\u043a\u0430\u0435\u043c \u0434\u0440\u0443\u0433\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u045e \u0447\u0430\u0441 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u043c\u044b \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b, \u044f\u043a\u0456 \u0456\u0434\u0437\u0435 \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430&raquo; (\u041c\u0446 21, 9), \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u0437\u043d\u043e\u045e \u0441\u043a\u0430\u0436\u0430\u043c \u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u0434\u0440\u0443\u0433\u043e\u0433\u0430, \u043a\u0430\u0431, \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u041f\u0430\u043d\u0443 \u0440\u0430\u0437\u0430\u043c \u0437 \u0430\u043d\u0451\u043b\u0430\u043c\u0456, \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u042f\u043c\u0443 \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u0446\u044c: &laquo;\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b, \u044f\u043a\u0456 \u0456\u0434\u0437\u0435 \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430&raquo; (\u041c\u0446 21, 9).<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0431\u0430\u045e\u0446\u0430 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u042f\u0433\u043e \u0437\u043d\u043e\u045e \u0441\u0443\u0434\u0437\u0456\u043b\u0456, \u0430\u043b\u0435 \u043a\u0430\u0431 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u043d\u0430 \u0441\u0443\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430 \u0441\u0443\u0434 \u042f\u0433\u043e. \u041f\u0430\u0434\u0447\u0430\u0441 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0441\u0443\u0434\u0430 \u0401\u043d \u043c\u0430\u045e\u0447\u0430\u045e, \u0430\u043b\u0435 \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u044b\u0433\u0430\u0434\u0430\u0435 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u043c, \u044f\u043a\u0456\u044f \u0430\u0434\u0432\u0430\u0436\u044b\u043b\u0456\u0441\u044f \u0430\u0434\u0434\u0430\u0446\u044c \u042f\u0433\u043e \u043d\u0430 \u0436\u0443\u0434\u0430\u0441\u043d\u0430\u0435 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u043d\u0435, \u0456 \u0441\u043a\u0430\u0436\u0430: &laquo;\u0422\u044b \u045e\u0447\u044b\u043d\u0456\u045e \u0433\u044d\u0442\u0430, \u0430 \u042f \u043c\u0430\u045e\u0447\u0430\u045e&raquo; (\u043f\u0430\u0440. \u041f\u0441 39 [38], 10).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u0446\u0446\u0430 \u043b\u044e\u0431\u043e\u045e\u044e, \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0447\u044b \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430 \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b \u043b\u044e\u0434\u0437\u0435\u0439. \u0410 \u045e \u0447\u0430\u0441 \u043f\u0430\u045e\u0442\u043e\u0440\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u044f\u043d\u044b \u043d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u0430 \u0430\u0434 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u043e\u0432\u0430 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0443\u044e\u0446\u0446\u0430 \u042f\u0433\u043e\u043d\u0430\u0439 \u0443\u043b\u0430\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u0430\u0431\u043e\u0434\u0432\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u043a \u041c\u0430\u043b\u0430\u0445\u0456\u044f: &laquo;\u0406 \u043d\u0435\u0447\u0430\u043a\u0430\u043d\u0430 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u045e \u0441\u0432\u0430\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u041f\u0430\u043d, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u0448\u0443\u043a\u0430\u0435\u0446\u0435&raquo; (\u041c\u0430\u043b 3, 1). \u0413\u044d\u0442\u0430 &ndash; \u043f\u0435\u0440\u0448\u0430\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0434\u0430\u043b\u0435\u0439 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435 \u043f\u0440\u0430 \u0434\u0440\u0443\u0433\u043e\u0435: &laquo;\u0412\u043e\u0441\u044c \u0430\u043d\u0451\u043b \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u0447\u0430\u043a\u0430\u0435\u0446\u0435... \u0412\u043e\u0441\u044c \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u041f\u0430\u043d \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b. \u0406 \u0445\u0442\u043e \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0434\u0437\u0435\u043d\u044c \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f, \u0456 \u0445\u0442\u043e \u045e\u0441\u0442\u0430\u0456\u0446\u044c, \u043a\u0430\u043b\u0456 \u0401\u043d \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430? \u0411\u043e \u0401\u043d \u044f\u043a \u0430\u0433\u043e\u043d\u044c \u043f\u043b\u0430\u0432\u0456\u043b\u044c\u0448\u0447\u044b\u043a\u0430, \u0456 \u044f\u043a \u043b\u0443\u0433, \u0448\u0442\u043e \u0430\u0447\u044b\u0448\u0447\u0430\u0435. \u0406 \u0441\u044f\u0434\u0437\u0435, \u044f\u043a \u043f\u043b\u0430\u0432\u0456\u043b\u044c\u0448\u0447\u044b\u043a \u0456 \u044f\u043a \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u0441\u0440\u044d\u0431\u0440\u0430&raquo; (\u041c\u0430\u043b 3, 1-3).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u044f \u0436 \u0434\u0432\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u043c\u0430\u0435 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u041f\u0430\u0432\u0435\u043b, \u043a\u0430\u043b\u0456 \u043f\u0456\u0448\u0430 \u0426\u0456\u0442\u0443 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b: &laquo;\u0417&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043b\u0430\u0441\u043a\u0430 \u0411\u043e\u0436\u0430\u044f, \u0437\u0431\u0430\u045e\u0447\u0430\u044f \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0430\u044f \u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441, \u043a\u0430\u0431 \u043c\u044b, \u0430\u0434\u0440\u043e\u043a\u0448\u044b\u0441\u044f \u0430\u0434 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0441\u0432\u0435\u0442\u0443, \u0436\u044b\u043b\u0456 \u045e \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456\u043c \u0436\u044b\u0446\u0446\u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430, \u0447\u0430\u043a\u0430\u044e\u0447\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0456 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0445\u0432\u0430\u043b\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430&raquo; (\u0426\u0456\u0442 2, 11-13). \u042f\u043a \u0431\u0430\u0447\u043d\u0430, \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0434\u0432\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u0456. \u0417\u0430 \u043f\u0435\u0440\u0448\u0430\u0435 \u0434\u0437\u044f\u043a\u0443\u0435, \u0430 \u0434\u0440\u0443\u0433\u043e\u0435 &ndash; \u0442\u043e\u0435, \u044f\u043a\u043e\u0433\u0430 \u0447\u0430\u043a\u0430\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u045e \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u044b\u043c \u043d\u0430\u043c \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0456 \u0432\u0435\u0440\u044b \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430, \u0448\u0442\u043e \u043c\u044b \u0432\u0435\u0440\u044b\u043c \u0443 \u0442\u0430\u0433\u043e, \u044f\u043a\u0456 \u045e\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430, \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0410\u0439\u0446\u0430 \u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u045e \u0441\u043b\u0430\u0432\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0436\u044b\u0432\u044b\u0445 \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445; \u042f\u0433\u043e\u043d\u0430\u043c\u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u043d\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u043d\u0430\u0448 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e. \u0410\u043b\u0435 \u045e \u0430\u043f\u043e\u0448\u043d\u0456 \u0434\u0437\u0435\u043d\u044c \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0441\u0430 \u0441\u043b\u0430\u0432\u0430\u044e \u043f\u0430\u0434 \u043a\u0430\u043d\u0435\u0446 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0411\u043e \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0437\u0430\u0432\u044f\u0440\u0448\u044d\u043d\u043d\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0456 \u0433\u044d\u0442\u044b \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0441\u0432\u0435\u0442 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041f\u0441 49 (48), 3; 80 (79), 2; 24 (23), 7. 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0437\u0456\u0440\u0430\u044e\u0447\u044b \u0437\u0434\u0430\u043b\u0451\u043a, \u0432\u043e\u0441\u044c \u0431\u0430\u0447\u0443 \u042f \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0432\u043e\u0431\u043b\u0430\u043a\u0430, \u0448\u0442\u043e \u0430\u0445\u0456\u043d\u0430\u0435 \u045e\u0441\u044e \u0437\u044f\u043c\u043b\u044e. <span style=\"color: #ff0000;\">*<\/span> \u0412\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u042f\u043c\u0443 \u0456 \u043a\u0430\u0436\u044b\u0446\u0435: <span style=\"color: #ff0000;\">*<\/span> \u0410\u0431\u0432\u044f\u0441\u0446\u0456 \u043d\u0430\u043c, \u0446\u0456 \u0433\u044d\u0442\u0430 \u0422\u044b,<span style=\"color: #ff0000;\"> *<\/span> \u044f\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u0435 \u0437\u044f\u043c\u043d\u044b\u044f \u0436\u044b\u0445\u0430\u0440\u044b \u0456 \u0441\u044b\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f, \u0440\u0430\u0437\u0430\u043c \u0431\u0435\u0434\u043d\u044b\u044f \u0456 \u0431\u0430\u0433\u0430\u0442\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u042f\u043c\u0443 \u0456 \u043a\u0430\u0436\u044b\u0446\u0435:<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043a\u0456 \u043f\u0430\u043d\u0443\u0435\u0448 \u043d\u0430\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c, \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u0439\u0441\u044f, \u044f\u043a\u0456 \u0432\u044f\u0434\u0437\u0435\u0448 \u042e\u0437\u0430\u0444\u0430\u0432\u044b\u0445 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u045e, \u0431\u044b\u0446\u0446\u0430\u043c \u0430\u0432\u0435\u0447\u0430\u043a.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0431\u0432\u044f\u0441\u0446\u0456 \u043d\u0430\u043c, \u0446\u0456 \u0433\u044d\u0442\u0430 \u0422\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0434\u0447\u044b\u043d\u0456\u0446\u0435 \u0432\u0430\u0448\u044b\u044f \u0432\u0430\u0440\u043e\u0442\u044b, \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456, \u0456 \u043f\u0430\u0434\u044b\u043c\u0456\u0446\u0435 \u0430\u0434\u0432\u0435\u0447\u043d\u044b\u044f \u0431\u0440\u0430\u043c\u044b, \u0456 \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0441\u043b\u0430\u0432\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0437\u0456\u0440\u0430\u044e\u0447\u044b \u0437\u0434\u0430\u043b\u0451\u043a \u041f\u0430\u0437\u0456\u0440\u0430\u044e\u0447\u044b \u0437\u0434\u0430\u043b\u0451\u043a, \u0432\u043e\u0441\u044c \u0431\u0430\u0447\u0443 \u042f \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0432\u043e\u0431\u043b\u0430\u043a\u0430, \u0448\u0442\u043e \u0430\u0445\u0456\u043d\u0430\u0435 \u045e\u0441\u044e \u0437\u044f\u043c\u043b\u044e. <span style=\"color: #ff0000;\">*<\/span> \u0412\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u042f\u043c\u0443 \u0456 \u043a\u0430\u0436\u044b\u0446\u0435: <span style=\"color: #ff0000;\">*<\/span> \u0410\u0431\u0432\u044f\u0441\u0446\u0456 \u043d\u0430\u043c, \u0446\u0456 \u0433\u044d\u0442\u0430 \u0422\u044b, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"412","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0456 \u043b\u0456\u0441\u0442 \u0441\u0432. \u041a\u0430\u0440\u0430\u043b\u044f \u0411\u0430\u0440\u0430\u043c\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Acta Ecclesiae Mediolanensis, t. 2, Lugduni, 1683, 916-917)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u044b\u044f\u0434 \u0410\u0434\u0432\u044d\u043d\u0442\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f! \u041d\u0430\u0441\u0442\u0430\u045e \u0442\u0430\u043a\u0456 \u0441\u0432\u044f\u0442\u043e\u0447\u043d\u044b \u0456 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u044b, \u044f\u043a \u043a\u0430\u0436\u0430 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u043f\u0440\u044b\u0435\u043c\u043d\u044b \u0447\u0430\u0441, \u0434\u0437\u0435\u043d\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435\u043a\u0430\u043b\u0456 \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u044b\u044f \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0456 \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u043f\u0440\u0430\u0433\u043d\u0430 \u0447\u0430\u043a\u0430\u043b\u0456 \u0437 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c\u0456 \u0456 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u043c\u0456, \u044f\u043a\u043e\u0433\u0430 \u0434\u0430\u0447\u0430\u043a\u0430\u045e\u0441\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0421\u0456\u043c\u044f\u043e\u043d, \u0456 \u044f\u043a\u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0442\u0430\u043a \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430 \u0441\u0432\u044f\u0442\u043a\u0443\u0435 \u041a\u0430\u0441\u0446\u0451\u043b. \u0413\u044d\u0442\u0430\u043a \u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u044f\u0433\u043e \u0437 \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u043c\u0456 \u0434\u0443\u043c\u043a\u0430\u043c\u0456 \u0456 \u043f\u0430\u0445\u0432\u0430\u043b\u043e\u044e, \u0437 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u044e \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u043c\u0443 \u0410\u0439\u0446\u0443 \u0437\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u0443\u044e \u0434\u0430 \u043d\u0430\u0441 \u0443 \u0433\u044d\u0442\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u045e \u0447\u0430\u0441 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u0443 \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u043d\u0430\u0441, \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e, \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u043d\u0430\u0441\u0456\u043b\u043b\u044f \u045e\u043b\u0430\u0434\u044b \u0434&rsquo;\u044f\u0431\u043b\u0430, \u0437\u0430\u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0456 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u043d\u0430\u0441 \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0433\u0430\u0441\u0446\u0456\u043d\u044b, \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u0443, \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u043c, \u043f\u0440\u044b\u0448\u0447\u0430\u043f\u0456\u0446\u044c \u043d\u0430\u043c \u0437\u0430\u0447\u0430\u0442\u043a\u0456 \u0446\u043d\u043e\u0442\u0430\u045e, \u0448\u0447\u043e\u0434\u0440\u0430 \u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430\u0441 \u0441\u043a\u0430\u0440\u0431\u0430\u043c\u0456 \u0441\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456 \u0456, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u0443\u0441\u044b\u043d\u0430\u0432\u0456\u045e \u043d\u0430\u0441 \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c\u0456 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0433\u044d\u0442\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0433\u043e\u0434\u0430, \u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435, \u043a\u0430\u0431 \u043c\u044b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u043b\u0456 \u045e \u0441\u0430\u0431\u0435 \u045e\u0441\u043f\u0430\u043c\u0456\u043d \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u0430\u0439 \u0434\u0430 \u043d\u0430\u0441. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u043b\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u0436\u044b\u045e \u0443 \u0447\u0430\u0441 \u0417\u0431\u0430\u045e\u0446\u044b, \u0430\u043b\u0435 \u0456 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u042f\u0433\u043e \u0441\u0456\u043b\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u043f\u0435\u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u043d\u0430\u043c, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u044f\u0442\u0443\u044e \u0432\u0435\u0440\u0443 \u0456 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u044b \u043c\u044b \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0440\u044b\u043c\u0430\u0435\u043c \u043b\u0430\u0441\u043a\u0443, \u044f\u043a\u0443\u044e \u0401\u043d \u0443\u0434\u0437\u044f\u043b\u0456\u045e \u043d\u0430\u043c, \u0456 \u0437 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044e \u043a\u0456\u0440\u0443\u0435\u043c\u0441\u044f \u0451\u044e \u045e \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0441\u0446\u0451\u043b \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u043d\u0430\u0441 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0441\u0432\u0435\u0442 \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c \u0446\u0435\u043b\u0435, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u043a\u043e\u0436\u043d\u0443\u044e \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u0456 \u043c\u043e\u043c\u0430\u043d\u0442 \u0433\u0430\u0442\u043e\u0432\u044b \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u043d\u0430\u0441 \u0437\u043d\u043e\u045e, \u043a\u0430\u0431 \u0434\u0443\u0445\u043e\u045e\u043d\u0430 \u043f\u0430\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u0448\u0430\u0445 \u0437 \u043f\u0430\u045e\u043d\u0430\u0442\u043e\u044e \u043b\u0430\u0441\u043a\u0456, \u043a\u0430\u043b\u0456 \u043c\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u0437 \u043d\u0430\u0433\u043e\u0434\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0435\u0440\u044b\u044f\u0434\u0443 \u041a\u0430\u0441\u0446\u0451\u043b \u0437 \u0433\u0430\u0440\u0430\u0447\u0430\u0439 \u043c\u0430\u0442\u0447\u044b\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0430\u0431 \u043d\u0430\u0448\u044b\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0433\u0456\u043c\u043d\u0430\u043c\u0456, \u043f\u0435\u0441\u043d\u044f\u043c\u0456, \u0456\u043d\u0448\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u043c\u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0456 \u0430\u0431\u0440\u0430\u0434\u0430\u043c\u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u0435 \u043d\u0430\u0441, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u0433\u044d\u0442\u0430\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430 \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e \u0456 \u045e\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u0446\u0446\u0430 \u044f\u0433\u043e \u043f\u043b\u0451\u043d\u0430\u043c. \u0422\u0430\u043c\u0443 \u043d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u0446\u0430 \u0434\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430 \u0442\u0430\u043a \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430, \u043d\u0456\u0431\u044b \u0401\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u045e \u0441\u0432\u0435\u0442 \u0443\u0436\u043e \u0446\u044f\u043f\u0435\u0440. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430\u043c\u0443 \u0432\u0443\u0447\u044b\u043b\u0456 \u043d\u0430\u0441 \u044f\u043a \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0442\u0430\u043a \u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c\u0456 \u0441\u0430 \u0421\u0442\u0430\u0440\u043e\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0430\u0439\u0446\u044b, \u043a\u0430\u0431 \u043c\u044b \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043b\u0456 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0401\u044d\u043b 2, 15; \u0406\u0441 62, 11; \u0415\u0440 4, 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0440\u0443\u0431\u0456\u0446\u0435 \u045e \u0440\u043e\u0433 \u043d\u0430 \u0421\u0456\u0451\u043d\u0435, \u043a\u043b\u0456\u0447\u0446\u0435 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u0446\u0435 \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0456 \u043a\u0430\u0436\u044b\u0446\u0435: <span style=\"color: #ff0000;\">*<\/span> \u0412\u043e\u0441\u044c \u0411\u043e\u0433, \u043d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u0446\u0435 \u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0439\u0446\u0435 \u043f\u0430\u0447\u0443\u0442\u0430\u0435; \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u0435 \u0456 \u043a\u043b\u0456\u0447\u0446\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0411\u043e\u0433, \u043d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_2_ID":"413","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0437\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Or. 45, 9, 22. 26. 28: PG 36, 634-635. 654. 658-659. 662)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041e \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u0437\u0430\u043c\u0435\u043d\u0430!<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043c \u0421\u044b\u043d \u0411\u043e\u0436\u044b &ndash; \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b, \u043d\u044f\u0431\u0430\u0447\u043d\u044b, \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u044b, \u0431\u0435\u0441\u0446\u044f\u043b\u0435\u0441\u043d\u044b, \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0421\u0432\u044f\u0442\u043b\u043e \u0430\u0434 \u0421\u0432\u044f\u0442\u043b\u0430, \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456, \u0430\u0434\u0431\u0456\u0442\u0430\u043a \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437\u0430, \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u044f \u043f\u044f\u0447\u0430\u0446\u044c, \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0432\u0430 \u045e\u0441\u0456\u043c \u0432\u043e\u0431\u0440\u0430\u0437, \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u044f \u043c\u044d\u0442\u0430 \u0410\u0439\u0446\u0430 \u0456 \u042f\u0433\u043e\u043d\u044b \u0441\u044d\u043d\u0441 &ndash; \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u042f\u0433\u043e\u043d\u044b\u043c \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c. \u041f\u0440\u044b\u043c\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0446\u0435\u043b\u0430 \u0434\u0437\u0435\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u0434\u0437\u0435\u043b\u044f \u043c\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u0437\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0437 \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0439 \u0434\u0443\u0448\u043e\u044e, \u043a\u0430\u0431 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u045e\u0441\u0451 \u043b\u044e\u0434\u0441\u043a\u043e\u0435, \u0430\u043a\u0440\u0430\u043c\u044f \u0433\u0440\u0430\u0445\u0443. \u0401\u043d \u0431\u044b\u045e \u0437\u0430\u0447\u0430\u0442\u044b \u0430\u0434 \u0414\u0437\u0435\u0432\u044b, \u044f\u043a\u0443\u044e \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u045e\u0436\u043e \u0430\u0447\u044b\u0441\u0446\u0456\u045e \u0443 \u0446\u0435\u043b\u0435 \u0456 \u0434\u0443\u0445\u0443, \u0431\u043e \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u045e\u0448\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0443 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430. \u041d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u044f\u043a \u0411\u043e\u0433 \u0443 \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u0439 \u0406\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0437&rsquo;\u044f\u0434\u043d\u0430\u045e\u0448\u044b \u045e \u0441\u0430\u0431\u0435 \u0434\u0437\u0432\u0435 \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u043d\u044b\u044f \u043d\u0430\u0442\u0443\u0440\u044b &ndash; \u0446\u044f\u043b\u0435\u0441\u043d\u0443\u044e \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e. \u0410\u0434\u043d\u0430 \u0437 \u0456\u0445 \u043d\u0430\u0434\u0430\u043b\u0430 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044c, \u0430 \u0434\u0440\u0443\u0433\u0430\u044f \u043f\u0440\u044b\u043d\u044f\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u044f\u043a\u0456 \u045e\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u0435 \u0456\u043d\u0448\u044b\u0445, \u0441\u0442\u0430\u045e \u0431\u0435\u0434\u043d\u044b\u043c. \u0401\u043d \u043f\u0440\u044b&shy;\u043d\u044f\u045e \u0443\u0431\u043e\u0441\u0442\u0432\u0430 \u043c\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u044f \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0431\u043e\u0441\u0442\u0432\u0430. \u0422\u043e\u0439, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u0430\u0431\u043b\u044f\u0435 \u043f\u0430\u045e\u043d\u0430\u0442\u0443, \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435, \u043d\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441 \u043f\u0430\u0437\u0431\u044b\u045e\u0448\u044b\u0441\u044f \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b, \u043a\u0430\u0431 \u044f \u0441\u0442\u0430\u045e \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u042f\u0433\u043e\u043d\u0430\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043c\u0443 \u0436 \u0442\u0430\u043a\u043e\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0434\u0430\u0431\u0440\u044b\u043d\u0456? \u0427\u0430\u043c\u0443 \u0442\u0430\u043a\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0434\u0437\u0435\u043b\u044f \u043c\u044f\u043d\u0435? \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0456 \u044f \u043f\u0440\u044b\u043d\u044f\u045e \u0411\u043e\u0436\u044b \u0432\u043e\u0431\u0440\u0430\u0437, \u0430\u043b\u0435 \u043d\u0435 \u0437\u0431\u044f\u0440\u043e\u0433 \u044f\u0433\u043e. \u0401\u043d \u0436\u0430 \u043f\u0440\u044b\u043c\u0430\u0435 \u043c\u0430\u0451 \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u0432\u043e\u0431\u0440\u0430\u0437\u0443 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0430 \u0446\u0435\u043b\u0443 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c. \u0401\u043d \u0443\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0456\u0432\u0430\u0435 \u0437 \u043d\u0430\u043c\u0456 \u043d\u043e\u0432\u0443\u044e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c, \u043d\u0430\u0448\u043c\u0430\u0442 \u0431\u043e\u043b\u044c\u0448 \u0446\u0443\u0434\u043e\u045e\u043d\u0443\u044e, \u0447\u044b\u043c \u043f\u0435\u0440\u0448\u0430\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043b\u0435\u0436\u0430\u043b\u0430, \u043a\u0430\u0431 \u0411\u043e\u0433, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443, \u0434\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u0456, \u0441\u0432\u0430\u0451\u0439 \u043c\u043e\u0446\u0430\u044e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0448\u044b \u0442\u044b\u0440\u0430\u043d\u0430, \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441, \u043f\u0440\u044b\u0432\u0451\u045e\u0448\u044b \u0434\u0430 \u0441\u044f\u0431\u0435 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0433\u044d\u0442\u0430 \u0434\u0437\u0435\u043b\u044f \u0441\u043b\u0430\u0432\u044b \u0410\u0439\u0446\u0430, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u045e\u0448\u044b\u0441\u044f \u042f\u043c\u0443, \u044f\u043a \u0431\u0430\u0447\u043d\u0430, \u0432\u0430 \u045e\u0441\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b \u0434\u043e\u0431\u0440\u044b \u041f\u0430\u0441\u0442\u044b\u0440 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0437\u0430\u0433\u0443\u0431\u043b\u0435\u043d\u0430\u0439 \u0430\u0432\u0435\u0447\u043a\u0456, \u0430\u0434\u0434\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0437\u0430 \u0430\u0432\u0435\u0447\u0430\u043a. \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0433\u043e\u0440 \u0456 \u043f\u0430\u0433\u043e\u0440\u043a\u0430\u045e, \u043d\u0430 \u044f\u043a\u0456\u0445 \u0442\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u045e \u0430\u0445\u0432\u044f\u0440\u044b. \u0417\u043d\u0430\u0439\u0448\u043e\u045e \u0437\u0430\u0433\u0443\u0431\u043b\u0435\u043d\u0443\u044e \u0430\u0432\u0435\u0447\u043a\u0443, \u0443\u0437\u044f\u045e \u044f\u0435 \u043d\u0430 \u0442\u044b\u044f \u0440\u0443\u043a\u0456, \u044f\u043a\u0456\u044f \u043d\u0435\u0441\u043b\u0456 \u0434\u0440\u044d\u0432\u0430 \u043a\u0440\u044b\u0436\u0430, \u043f\u0440\u044b\u043d\u044f\u045e \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0431\u044b\u045e \u0441\u0432\u0435\u0442\u0430\u0447\u0430\u043c, \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u0433\u044d\u0442\u0430\u0435 \u043d\u0430\u0439\u044f\u0441\u043d\u0435\u0439\u0448\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e. \u041f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431\u044b\u045e \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0421\u043b\u043e\u0432\u0430, \u043f\u0430\u0441\u043b\u044f \u0434\u0440\u0443\u0436\u043a\u0456 \u0416\u0430\u043d\u0456\u0445\u0430 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0441\u0430\u043c \u041c\u0430\u043b\u0430\u0434\u044b, \u044f\u043a\u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u043d\u0430\u0440\u043e\u0434 \u0456 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0435 \u0430\u0447\u044b\u0441\u0446\u0456\u045e \u044f\u0433\u043e \u0432\u0430\u0434\u043e\u044e \u0434\u043b\u044f \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u0436\u044b\u0446\u044c, \u043d\u0430\u043c \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b \u0431\u044b\u045e \u0411\u043e\u0433, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u044f\u045e \u0446\u0435\u043b\u0430 \u0456 \u043f\u0430\u043c\u0451\u0440. \u041c\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c, \u043a\u0430\u0431 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u0446\u0430; \u0440\u0430\u0437\u0430\u043c \u043f\u0430\u045e\u0441\u0442\u0430\u043b\u0456 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0440\u0430\u0437\u0430\u043c \u043f\u0430\u043c\u0435\u0440\u043b\u0456; \u0440\u0430\u0437\u0430\u043c \u0443\u0441\u043b\u0430\u0432\u0456\u043b\u0456\u0441\u044f, \u0431\u043e \u0440\u0430\u0437\u0430\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0430\u043b 4, 4-5; \u042d\u0444 2, 4; \u0420\u044b\u043c 8, 3<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0443\u0436\u043e \u043d\u0430\u0434\u044b\u0448\u043b\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0447\u0430\u0441\u0443, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0437 \u0414\u0437\u0435\u0432\u044b, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0437\u0430\u043a\u043e\u043d\u0443, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u045e \u0437\u0430\u043a\u043e\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0451\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u043e\u044e \u0411\u043e\u0433 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u0401\u043d \u043f\u0430\u0441\u043b\u0430\u045e \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0433\u0440\u044d\u0448\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u045e \u0437\u0430\u043a\u043e\u043d\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"414","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 5 in Adventu Domini, 1-3: <\/span><br \/><span style=\"color: #ff0000;\">Opera omnia, Edit. cisterc. 4 [1966], 188-190)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u043d\u0430\u0441 \u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 <\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u041f\u0430\u043d\u0430 \u043f\u0430\u0442\u0440\u043e\u0439\u043d\u0430\u0435. \u0422\u0440\u044d\u0446\u044f\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 &ndash; \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u0445. \u0422\u044b\u044f \u0434\u0432\u0430 \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u044b\u044f, \u0430 \u0433\u044d\u0442\u0430\u0435 \u043d\u0435. \u041f\u0430\u0434\u0447\u0430\u0441 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u0415\u0437\u0443\u0441 \u0431\u044b\u045e \u0431\u0430\u0447\u043d\u044b \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u043a\u0430\u043b\u0456, \u044f\u043a \u0441\u0430\u043c \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c, \u0443\u0431\u0430\u0447\u044b\u043b\u0456 \u042f\u0433\u043e \u0456 \u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u043b\u0456. \u041f\u0430\u0434\u0447\u0430\u0441 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f &laquo;\u043a\u043e\u0436\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430&raquo; (\u041b\u043a 3, 6), \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043f\u0440\u0430\u0431\u0456\u043b\u0456 (\u043f\u0430\u0440. \u042f\u043d 19, 37). \u0421\u044f\u0440\u044d\u0434\u043d\u044f\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 &ndash; \u0442\u0430\u0435\u043c\u043d\u0430\u0435, \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u044f \u0431\u0430\u0447\u0430\u0446\u044c \u042f\u0433\u043e \u045e \u0441\u0430\u0431\u0435, \u0456 \u0437\u0431\u0430\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0434\u0443\u0448\u044b \u0456\u0445\u043d\u0456\u044f. \u0410 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043f\u0430\u0434\u0447\u0430\u0441 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0446\u0435\u043b\u0435 \u0456 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456, \u043f\u0430\u0434\u0447\u0430\u0441 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u044f\u0440\u044d\u0434\u043d\u044f\u0433\u0430 &ndash; \u0443 \u0441\u0456\u043b\u0435 \u0456 \u0434\u0443\u0445\u0443, \u0430 \u043f\u0430\u0434\u0447\u0430\u0441 \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430 &ndash; \u0443 \u0441\u043b\u0430\u0432\u0435 \u0456 \u0432\u0435\u043b\u0456\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u0435 \u0441\u044f\u0440\u044d\u0434\u043d\u044f\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 &ndash; \u0448\u043b\u044f\u0445, \u044f\u043a\u0456 \u0432\u044f\u0434\u0437\u0435 \u0430\u0434 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0434\u0430 \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430: \u0443 \u043f\u0435\u0440\u0448\u044b\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0431\u044b\u045e \u043d\u0430\u0448\u044b\u043c \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435\u043c, \u0443 \u0430\u043f\u043e\u0448\u043d\u0456\u043c \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u044f\u043a \u043d\u0430\u0448\u0430 \u0436\u044b\u0446\u0446\u0451, \u0430 \u045e \u0433\u044d\u0442\u044b\u043c &ndash; \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a \u0456 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435, \u043a\u0430\u0431 \u043d\u0435\u043a\u0430\u043c\u0443 \u0432\u044b\u043f\u0430\u0434\u043a\u0430\u043c \u043d\u0435 \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0435 \u043f\u0440\u0430 \u0441\u044f\u0440\u044d\u0434\u043d\u044f\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 &ndash; \u0433\u044d\u0442\u0430 \u0432\u044b\u0434\u0443\u043c\u043a\u0430, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u041f\u0430\u043d\u0430. &laquo;\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u041c\u044f\u043d\u0435, &ndash; \u043a\u0430\u0436\u0430, &ndash; \u0442\u043e\u0439 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u041c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b, \u0456 \u0410\u0439\u0446\u0435\u0446 \u041c\u043e\u0439 \u043f\u0430\u043b\u044e\u0431\u0456\u0446\u044c \u044f\u0433\u043e, \u0456 \u043c\u044b \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u044f\u0433\u043e&raquo; (\u043f\u0430\u0440. \u042f\u043d 14, 23). \u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u044f \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u045e: &laquo;\u0425\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u0411\u043e\u0433\u0430, \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e&raquo; (\u043f\u0430\u0440. \u0421\u0456\u0440 15, 1); \u0430\u043b\u0435 \u043b\u0456\u0447\u0443, \u0448\u0442\u043e \u0442\u0440\u043e\u0445\u0456 \u0431\u043e\u043b\u044c\u0448 \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u043f\u0440\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0456 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u044b. \u0414\u0437\u0435 \u0436 \u0456\u0445 \u0442\u0440\u044d\u0431\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c? \u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0448\u0442\u043e \u045e \u0441\u044d\u0440\u0446\u044b, \u044f\u043a \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0440\u043e\u043a: &laquo;\u0423 \u0441\u044d\u0440\u0446\u044b \u043c\u0430\u0456\u043c \u044f \u0441\u0445\u0430\u0432\u0430\u045e \u0422\u0432\u0430\u0451 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e&raquo; (\u041f\u0441 119 [118], 11).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435: &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0442\u044b\u044f, \u0445\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0433\u044d\u0442\u0430&raquo;. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u044f\u043d\u043e \u043f\u0440\u0430&shy;\u043d\u0456\u043a\u043d\u0435 \u045e \u0433\u043b\u044b\u0431 \u0442\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b; \u043d\u044f\u0445\u0430\u0439 \u043f\u044f\u0440\u043e\u0439\u0434\u0437\u0435 \u045e \u0442\u0432\u0430\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0456 \u0456 \u0437\u0432\u044b\u0447\u0430\u0456. \u0421\u043f\u0430\u0436\u044b\u0432\u0430\u0439 \u0434\u0430\u0431\u0440\u043e, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0443\u0441\u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u045e \u0440\u0430\u0441\u043a\u043e\u0448\u044b \u0434\u0443\u0448\u0430 \u0442\u0432\u0430\u044f. \u041d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0439\u0441\u044f \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0441\u0432\u043e\u0439 \u0445\u043b\u0435\u0431, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043a\u0430\u043c\u044f\u043d\u0435\u0435 \u0442\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u0430\u043b\u0435 \u0442\u043b\u0443\u0448\u0447\u0430\u043c \u0456 \u0442\u0443\u043a\u0430\u043c \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0442\u0432\u0430\u044f \u0434\u0443\u0448\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0442\u0430\u043a \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u044f\u043d\u043e, \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0446\u044f\u0431\u0435 \u0437\u0430\u0445\u0430\u0432\u0430\u0435. \u0414\u0430 \u0446\u044f\u0431\u0435 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0421\u044b\u043d \u0437 \u0410\u0439\u0446\u043e\u043c, \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0432\u044f\u043b\u0456\u043a\u0456 \u041f\u0440\u0430\u0440\u043e\u043a, \u044f\u043a\u0456 \u0430\u0434\u043d\u043e\u0432\u0456\u0446\u044c \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0456 \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0443\u0441\u0451 \u043d\u043e\u0432\u044b\u043c. \u0411\u043e \u0433\u044d\u0442\u0430\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u045e\u0447\u044b\u043d\u0456\u0446\u044c, \u0448\u0442\u043e, &laquo;\u044f\u043a \u043d\u0430\u0441\u0456\u043b\u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u0437\u044f\u043c\u043d\u043e\u0433\u0430, \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u0456\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430&raquo; (1 \u041a\u0430\u0440 15, 49). \u042f\u043a \u0433\u0440\u044d\u0445 \u0410\u0434\u0430\u043c\u0430 \u0430\u0445\u0430\u043f\u0456\u045e \u0443\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u0437\u0430\u0432\u0430\u043b\u043e\u0434\u0430\u045e \u0456\u043c, \u0442\u0430\u043a \u0443\u0441\u0456\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u044f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e, \u0430\u0434\u043a\u0443\u043f\u0456\u045e, \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041f\u0441 29 (28), 11; \u0406\u0441 40, 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u041f\u0430\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u0441\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u045e \u0431\u043b\u044f\u0441\u043a\u0443, \u0456 \u043c\u043e\u0446 \u042f\u0433\u043e\u043d\u0430\u044f \u0437 \u0406\u043c,<span style=\"color: #ff0000;\"> *<\/span> \u043a\u0430\u0431 \u043d\u0430\u0432\u0435\u0434\u0430\u0446\u044c \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0443 \u0441\u043f\u0430\u043a\u043e\u0456 \u0456 \u0430\u0434\u0430\u0440\u044b\u0446\u044c \u044f\u0433\u043e \u0432\u0435\u0447\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0441\u044c \u041f\u0430\u043d \u043d\u0430\u0448 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0437 \u043c\u043e\u0446\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u043d\u0430\u0432\u0435\u0434\u0430\u0446\u044c \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u0443 \u0441\u043f\u0430\u043a\u043e\u0456 \u0456 \u0430\u0434\u0430\u0440\u044b\u0446\u044c \u044f\u0433\u043e \u0432\u0435\u0447\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"415","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0414\u044b\u044f\u0442\u044d\u0441\u0430\u0440\u043e\u043d\u0443&raquo; \u0441\u0432. \u042d\u0444\u0440\u044d\u043c\u0430, \u0434\u044b\u044f\u043a\u0430\u043d\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 18, 15-17: SCh 121, 325-328)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0427\u0443\u0432\u0430\u0439\u0446\u0435: \u041f\u0430\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0437\u043d\u043e\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u0443\u0441\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u0430\u0434 \u043f\u044b\u0442\u0430\u043d\u043d\u044f\u045e \u043d\u0430\u043a\u043e\u043d\u0442 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u044f, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0440\u0430 \u0433\u044d\u0442\u0443\u044e \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043d\u0456\u0445\u0442\u043e, \u043d\u0456 \u0430\u043d\u0451\u043b\u044b, \u043d\u0456 \u0421\u044b\u043d (\u043f\u0430\u0440. \u041c\u0446 24, 36). \u041d\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u0430\u043c \u0432\u0435\u0434\u0430\u0446\u044c \u043d\u0456 \u0447\u0430\u0441\u0443, \u043d\u0456 \u0445\u0432\u0456\u043b\u0456\u043d\u044b&raquo; (\u0414\u0437 1, 7). \u0401\u043d \u0443\u043a\u0440\u044b\u045e \u0433\u044d\u0442\u0430, \u043a\u0430\u0431 \u043c\u044b \u0447\u0443\u0432\u0430\u043b\u0456 \u0456 \u043a\u043e\u0436\u043d\u044b \u0437 \u043d\u0430\u0441 \u043b\u0456\u0447\u044b\u045e, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043c\u043e\u0436\u0430 \u043d\u0430\u0441\u0442\u0430\u0446\u044c \u044f\u0448\u0447\u044d \u043f\u0440\u044b \u044f\u0433\u043e\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456. \u041a\u0430\u043b\u0456 \u0431 \u0415\u0437\u0443\u0441 \u0430\u0434\u043a\u0440\u044b\u045e \u0447\u0430\u0441 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u044f, \u044f\u043d\u043e \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0430 \u0431 \u0441\u0432\u043e\u0439 \u0441\u043c\u0430\u043a, \u0430 \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u0432\u044f\u043a\u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0447\u0430\u043a\u0430\u043b\u0456 \u0431 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u041f\u0430\u043d\u0430. \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u0430\u043b\u0435 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e, \u043a\u0430\u043b\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u044b\u0439\u0441\u0446\u0456, \u0442\u0430\u043c\u0443 \u045e\u0441\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456 \u0456 \u0432\u044f\u043a\u0456 \u043f\u0440\u0430\u0433\u043d\u0430 \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u041f\u0430\u043d \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0437\u043d\u0430\u043a\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u044f, \u0430\u0434\u043d\u0430\u043a \u043d\u0430 \u0456\u0445 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0435 \u043d\u0435\u043b\u044c\u0433\u0430 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0430\u043a\u0440\u044d\u0441\u043b\u0456\u0446\u044c \u043d\u0435\u0439\u043a\u0430\u0433\u0430 \u0442\u044d\u0440\u043c\u0456\u043d\u0443. \u0413\u044d\u0442\u044b\u044f \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0437\u043d\u0430\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0456 \u043c\u0456\u043d\u0430\u043b\u0456, \u0456 \u0431\u043e\u043b\u044c\u0448 \u0442\u0430\u0433\u043e, \u0456\u0445 \u043c\u043e\u0436\u043d\u0430 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c. \u0411\u043e \u0430\u043f\u043e\u0448\u043d\u044f\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u041f\u0430\u043d\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u043f\u0435\u0440\u0448\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0447\u0430\u043a\u0430\u043b\u0456 \u042f\u0433\u043e \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0456 \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456, \u043c\u044f\u0440\u043a\u0443\u044e\u0447\u044b, \u0448\u0442\u043e \u0401\u043d \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u0456\u0445\u043d\u0456\u044f \u0434\u043d\u0456. \u0422\u0430\u043a \u0456 \u0441\u0451\u043d\u043d\u044f \u043a\u043e\u0436\u043d\u044b \u0437 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u0436\u0430\u0434\u0430\u0435 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u042f\u0433\u043e \u045e \u0441\u0432\u043e\u0439 \u0447\u0430\u0441, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u043d \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u045e \u0432\u044f\u0434\u043e\u043c\u044b\u043c \u0434\u0437\u0435\u043d\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u044f. \u0410 \u0433\u044d\u0442\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u043b\u0456\u0447\u044b\u045e, \u0448\u0442\u043e \u0401\u043d, \u0443 \u043c\u043e\u0446\u044b \u0456 \u045e\u043b\u0430\u0434\u0437\u0435 \u044f\u043a\u043e\u0433\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u043b\u0456\u0447\u0431\u044b \u0456 \u0447\u0430\u0441\u044b, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b \u043b\u0451\u0441\u0443 \u0456 \u0433\u0430\u0434\u0437\u0456\u043d\u0435. \u0425\u0456\u0431\u0430 \u0401\u043d \u043c\u043e\u0436\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u0446\u044c \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u0430\u043c \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e, \u043a\u0430\u043b\u0456 \u0401\u043d \u0430\u043f\u0456\u0441\u0430\u045e \u0437\u043d\u0430\u043a\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u044f? \u041f\u0430\u043d \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u045e \u0437\u043d\u0430\u043a\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u0442\u0430\u043a\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u043a\u0430\u0431 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f \u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0443\u0441\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456 \u0456 \u0432\u044f\u043a\u0456 \u043b\u0456\u0447\u044b\u043b\u0456, \u0448\u0442\u043e \u042f\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0430\u0434\u0431\u0443\u0434\u0437\u0435\u0446\u0446\u0430 \u045e \u0456\u0445 \u0447\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0443\u0432\u0430\u0439\u0446\u0435, \u0431\u043e, \u043a\u0430\u043b\u0456 \u0446\u0435\u043b\u0430 \u0441\u043f\u0456\u0446\u044c, \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430\u0448\u0430 \u043d\u0430\u0442\u0443\u0440\u0430 \u0456 \u043c\u044b \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435\u043c \u043d\u0435 \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456, \u0430\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u0442\u0443\u0440\u044b. \u0406 \u043a\u0430\u043b\u0456 \u0434\u0443\u0448\u0430 \u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043d\u0430 \u0433\u043b\u044b\u0431\u043e\u043a\u0456\u043c \u0441\u043d\u043e\u043c &ndash; \u043c\u0430\u043b\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u044e \u0430\u0431\u043e \u0441\u043c\u0443\u0442\u043a\u0430\u043c, &ndash; \u0442\u0430\u0434\u044b \u043d\u0430\u0434 \u0451\u044e \u043f\u0430\u043d\u0443\u0435 \u0432\u043e\u0440\u0430\u0433 \u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u044f\u0435 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u044f\u043d\u0430 \u043d\u0435 \u0445\u043e\u0447\u0430. \u041d\u0430\u0434 \u043d\u0430\u0442\u0443\u0440\u0430\u0439 \u043f\u0430\u043d\u0443\u0435 \u0433\u0432\u0430\u043b\u0442, \u0430 \u043d\u0430\u0434 \u0434\u0443\u0448\u043e\u044e &ndash; \u0432\u043e\u0440\u0430\u0433.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0447\u0443\u0439\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u041f\u0430\u043d, \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u0430 \u0430\u0431\u0435\u0434\u0437\u0432\u044e\u043c \u0447\u0430\u0441\u0442\u043a\u0430\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0426\u0435\u043b\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u0435\u0440\u0430\u0433\u0447\u044b\u0441\u044f \u0441\u0430\u043d\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430 \u0434\u0443\u0448\u0430 &ndash; \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u0430\u0441\u0446\u0456 \u0456 \u0431\u0430\u044f\u0437\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043a \u0456 \u043a\u0430\u0436\u0430 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435: &laquo;\u041f\u0440\u0430\u0447\u043d\u0456\u0446\u0435\u0441\u044f, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 15, 34), \u0456: &laquo;\u042f \u043f\u0430\u045e\u0441\u0442\u0430\u045e \u0456 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0437 \u0422\u0430\u0431\u043e\u044e&raquo; (\u043f\u0430\u0440. \u041f\u0441 139 [138], 18), \u0456 \u044f\u0448\u0447\u044d: &laquo;\u041d\u0435 \u0433\u0443\u0431\u043b\u044f\u0439\u0446\u0435 \u0430\u0434\u0432\u0430\u0433\u0456&raquo;. &laquo;\u0422\u0430\u043c\u0443, \u043c\u0430\u044e\u0447\u044b \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435, \u043d\u0435 \u0433\u0443\u0431\u043b\u044f\u0435\u043c \u0430\u0434\u0432\u0430\u0433\u0456&raquo; (\u043f\u0430\u0440. 2 \u041a\u0430\u0440 4, 1).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 55, 3-4; \u0414\u0437 28, 28<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430\u043c \u0432\u0430\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0432\u0435\u0447\u043d\u044b &ndash; \u043d\u044f\u0437\u043c\u0435\u043d\u043d\u044b\u044f \u043b\u0430\u0441\u043a\u0456 \u0434\u043b\u044f \u0414\u0430\u0432\u0456\u0434\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0412\u043e\u0441\u044c \u044f \u045e\u0447\u044b\u043d\u0456\u045e \u044f\u0433\u043e \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0441\u0432\u0435\u0434\u043a\u0430\u043c, \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u043b\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u0430 \u0433\u044d\u0442\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0456 \u043f\u0430\u0447\u0443\u044e\u0446\u044c \u044f\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u044f \u045e\u0447\u044b\u043d\u0456\u045e \u044f\u0433\u043e \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0441\u0432\u0435\u0434\u043a\u0430\u043c, \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"416","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041f\u0440\u0430\u0441\u043b\u043e\u0433\u0456\u0456&raquo; \u0441\u0432. \u0410\u043d\u0437\u044d\u043b\u044c\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 1: Opera omnia, Edit. Schmitt, Seccovii, 1938, 1, 97-100)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0416\u0430\u0434\u0430\u043d\u043d\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043f\u0440\u0430 \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0440\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430, \u0430\u0434\u0430\u0440\u0432\u0456\u0441\u044f \u043d\u0430 \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u0430\u0434 \u0441\u0432\u0430\u0456\u0445 \u0437\u0430\u043d\u044f\u0442\u043a\u0430\u045e, \u0441\u0445\u0430\u0432\u0430\u0439\u0441\u044f \u043d\u0430 \u043c\u043e\u043c\u0430\u043d\u0442 \u0430\u0434 \u043c\u0456\u0442\u0443\u0441\u043d\u0456 \u0441\u0432\u0430\u0456\u0445 \u0434\u0443\u043c\u0430\u043a. \u0410\u0434\u043a\u0456\u043d\u044c \u0446\u044f\u043f\u0435\u0440 \u0446\u044f\u0436\u043a\u0456\u044f \u043a\u043b\u043e\u043f\u0430\u0442\u044b, \u043f\u0430\u043a\u0456\u043d\u044c \u0441\u0432\u0430\u0435 \u043f\u0430\u043a\u0443\u0442\u043b\u0456\u0432\u044b\u044f \u0442\u0443\u0440\u0431\u043e\u0442\u044b. \u0417\u0432\u044f\u0440\u043d\u0456\u0441\u044f \u0445\u043e\u0446\u044c \u0442\u0440\u043e\u0445\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u043f\u044d\u045e\u043d\u044b \u0447\u0430\u0441 \u0430\u0434\u043f\u0430\u0447\u043d\u0456 \u045e \u0406\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0432\u0430\u0439\u0434\u0437\u0456 \u045e \u043f\u0430\u043a\u043e\u0439 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u0432\u044b\u0434\u0430\u043b\u0456 \u045e\u0441\u0451, \u0430\u043a\u0440\u0430\u043c\u044f \u0411\u043e\u0433\u0430 \u0456 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0434\u0430 \u042f\u0433\u043e \u0432\u044f\u0434\u0437\u0435. \u0417\u0430\u0447\u044b\u043d\u0456 \u0434\u0437\u0432\u0435\u0440\u044b \u0456 \u0448\u0443\u043a\u0430\u0439 \u042f\u0433\u043e. \u0421\u043a\u0430\u0436\u044b \u0446\u044f\u043f\u0435\u0440, \u0443\u0441\u0451 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u0441\u043a\u0430\u0436\u044b \u0446\u044f\u043f\u0435\u0440 \u0411\u043e\u0433\u0443: &laquo;\u042f \u0448\u0443\u043a\u0430\u044e \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0422\u0432\u0430\u0439\u0433\u043e, &ldquo;\u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0422\u0432\u0430\u0439\u0433\u043e, \u041f\u0430\u043d\u0435, \u044f \u0448\u0443\u043a\u0430\u044e&rdquo;&raquo; (\u041f\u0441 27 [26], 8).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043e\u0439 \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u043d\u0430\u0432\u0443\u0447\u044b \u0446\u044f\u043f\u0435\u0440 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u0434\u0437\u0435 \u0456 \u044f\u043a \u0426\u044f\u0431\u0435 \u0448\u0443\u043a\u0430\u0446\u044c, \u0434\u0437\u0435 \u0456 \u044f\u043a \u0426\u044f\u0431\u0435 \u0437\u043d\u0430\u0439\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u043a\u0430\u043b\u0456 \u0426\u044f\u0431\u0435 \u043d\u044f\u043c\u0430 \u0442\u0443\u0442, \u0442\u043e \u0434\u0437\u0435 \u043c\u043d\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u0426\u044f\u0431\u0435? \u041a\u0430\u043b\u0456 \u0422\u044b \u045e\u0441\u044e\u0434\u044b\u0456\u0441\u043d\u044b, \u0447\u0430\u043c\u0443 \u043d\u0435 \u0431\u0430\u0447\u0443 \u044f \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0422\u0432\u0430\u0451\u0439? \u0410\u043b\u0435 \u0422\u044b, \u043d\u0430\u043f\u044d\u045e\u043d\u0430, \u0436\u044b\u0432\u0435\u0448 \u045e \u043d\u0435\u0434\u0430\u0441\u044f\u0436\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u0435. \u0406 \u0434\u0437\u0435 \u0436 \u0433\u044d\u0442\u0430\u0435 \u043d\u0435\u0434\u0430\u0441\u044f\u0436\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u044f\u043a \u043c\u043d\u0435 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u044f\u0433\u043e? \u0406 \u0445\u0442\u043e \u043f\u0430\u0432\u044f\u0434\u0437\u0435 \u043c\u044f\u043d\u0435, \u0445\u0442\u043e \u045e\u0432\u044f\u0434\u0437\u0435 \u043c\u044f\u043d\u0435 \u045e \u044f\u0433\u043e, \u043a\u0430\u0431 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0426\u044f\u0431\u0435 \u045e \u0456\u043c? \u0406 \u045e\u0440\u044d\u0448\u0446\u0435, \u0443 \u044f\u043a\u0456\u0445 \u0440\u044b\u0441\u0430\u0445 \u044f \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u044e \u0422\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430? \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430 \u043c\u043e\u0439, \u044f \u043d\u0456\u043a\u043e\u043b\u0456 \u0426\u044f\u0431\u0435 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e \u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u044e \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0436 \u0437\u0440\u043e\u0431\u0456\u0446\u044c, \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u041f\u0430\u043d\u0435, \u0448\u0442\u043e \u0436 \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u044b \u0422\u0432\u043e\u0439 \u0432\u044b\u0433\u043d\u0430\u043d\u0435\u0446, \u044f\u043a\u0456 \u0442\u0430\u043a \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u0426\u044f\u0431\u0435? \u0428\u0442\u043e \u0436 \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0422\u0432\u043e\u0439 \u0441\u043b\u0443\u0433\u0430, \u0437\u043d\u044f\u043c\u043e\u0436\u0430\u043d\u044b \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430 \u0426\u044f\u0431\u0435, \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b \u0430\u0434 \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430? \u0401\u043d \u043d\u0430\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0426\u044f\u0431\u0435, \u0430\u043b\u0435 \u0422\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0442\u0430\u043a \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u044f\u0433\u043e. \u0401\u043d \u043f\u0440\u0430\u0433\u043d\u0435 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u0446\u0446\u0430 \u0434\u0430 \u0426\u044f\u0431\u0435, \u0430\u043b\u0435 \u043d\u0435\u0434\u0430\u0441\u044f\u0436\u043d\u0430\u0435 \u0436\u044b\u043b\u043b\u0451 \u0422\u0432\u0430\u0451. \u0401\u043d \u0436\u0430\u0434\u0430\u0435 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0426\u044f\u0431\u0435, \u0430\u043b\u0435 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 \u0422\u0432\u0430\u0439\u0433\u043e. \u0406\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0430\u0434\u0448\u0443\u043a\u0430\u0446\u044c \u0426\u044f\u0431\u0435, \u0430\u043b\u0435 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0422\u044b &ndash; \u0411\u043e\u0433 \u043c\u043e\u0439 \u0456 \u041f\u0430\u043d \u043c\u043e\u0439, \u0430 \u044f \u0426\u044f\u0431\u0435 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e. \u0422\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0456 \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u043c\u044f\u043d\u0435, \u0422\u044b \u0430\u0434\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435 \u045e\u0441\u0456\u043c \u043c\u0430\u0456\u043c \u0434\u0430\u0431\u0440\u043e\u043c, \u0430 \u044f \u043d\u0435 \u0432\u0435\u0434\u0430\u044e \u0426\u044f\u0431\u0435. \u042f \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b, \u043a\u0430\u0431 \u0426\u044f\u0431\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u044f \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u0430\u0433\u043e, \u0434\u043b\u044f \u0447\u0430\u0433\u043e \u0431\u044b\u045e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0434\u0430\u043a\u0443\u043b\u044c, \u041f\u0430\u043d\u0435, \u0434\u0430\u043a\u0443\u043b\u044c, \u041f\u0430\u043d\u0435, \u0422\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0437\u0430\u0431\u044b\u0432\u0430\u0446\u0446\u0430 \u043f\u0440\u0430 \u043d\u0430\u0441, \u0434\u0430\u043a\u0443\u043b\u044c \u0431\u0443\u0434\u0437\u0435\u0448 \u0430\u0434\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u0446\u044c \u0430\u0434 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430? \u041a\u0430\u043b\u0456 \u0422\u044b \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0448 \u0456 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0435\u0448 \u043d\u0430\u0441? \u041a\u0430\u043b\u0456 \u0430\u0441\u0432\u0435\u0442\u043b\u0456\u0448 \u043d\u0430\u0448\u044b \u0432\u043e\u0447\u044b \u0456 \u043f\u0430\u043a\u0430\u0436\u0430\u0448 \u043d\u0430\u043c \u0441\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430? \u041a\u0430\u043b\u0456 \u0422\u044b \u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f \u0434\u0430 \u043d\u0430\u0441?<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u041f\u0430\u043d\u0435, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439, \u0430\u0441\u0432\u044f\u0442\u043b\u0456 \u043d\u0430\u0441, \u043f\u0430\u043a\u0430\u0436\u044b\u0441\u044f \u043d\u0430\u043c. \u0412\u044f\u0440\u043d\u0456\u0441\u044f \u0434\u0430 \u043d\u0430\u0441, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e \u043d\u0430\u043c \u0434\u043e\u0431\u0440\u0430, \u0431\u043e \u043d\u0430\u043c \u0442\u0430\u043a \u0434\u0440\u044d\u043d\u043d\u0430 \u0431\u0435\u0437 \u0426\u044f\u0431\u0435. \u0421\u043f\u0430\u0433\u0430\u0434\u0430\u0439 \u043d\u0430\u0448\u044b\u043c \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u043c \u0456 \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u044f\u043c, \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u043c \u0434\u0430 \u0426\u044f\u0431\u0435: \u043c\u044b \u0431\u0435\u0437 \u0426\u044f\u0431\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0432\u0443\u0447\u044b \u043c\u044f\u043d\u0435, \u044f\u043a \u0426\u044f\u0431\u0435 \u0448\u0443\u043a\u0430\u0446\u044c, \u0456 \u0430\u0434\u043a\u0440\u044b\u0439\u0441\u044f \u043c\u043d\u0435, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u043d\u0443 \u0448\u0443\u043a\u0430\u0446\u044c \u0426\u044f\u0431\u0435. \u0411\u043e \u044f \u043d\u0435 \u043c\u0430\u0433\u0443 \u0448\u0443\u043a\u0430\u0446\u044c \u0426\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043d\u0430\u0432\u0443\u0447\u044b\u0448, \u0456 \u043d\u0435 \u043c\u0430\u0433\u0443 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0426\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u0422\u044b \u043d\u0435 \u0430\u0431&rsquo;\u044f\u0432\u0456\u0448\u0441\u044f. \u0417 \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u0431\u0443\u0434\u0443 \u0448\u0443\u043a\u0430\u0446\u044c \u0426\u044f\u0431\u0435, \u0430 \u045e \u043f\u043e\u0448\u0443\u043a\u0443 \u0441\u0432\u0430\u0456\u043c \u0436\u0430\u0434\u0430\u0446\u044c. \u041d\u044f\u0445\u0430\u0439, \u043b\u044e\u0431\u044f\u0447\u044b, \u0437\u043d\u0430\u0439\u0434\u0443, \u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0447\u044b, \u0431\u0443\u0434\u0443 \u043b\u044e\u0431\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 80 (79), 19. 20; 106 (105), 4<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b \u043d\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u043c\u0441\u044f \u0430\u0434 \u0426\u044f\u0431\u0435, \u0430\u0436\u044b\u0432\u0456 \u043d\u0430\u0441, \u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0456\u043c\u044f \u0422\u0432\u0430\u0451. <span style=\"color: #ff0000;\">*<\/span> \u041d\u044f\u0445\u0430\u0439 \u0422\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0437\u0430\u0437\u0437\u044f\u0435 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043c\u044f\u0442\u0430\u0439 \u043f\u0440\u0430 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u0443 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443. \u041d\u0430\u0432\u0435\u0434\u0430\u0439 \u043d\u0430\u0441 \u0443 \u0422\u0432\u0430\u0456\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0422\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0437\u0430\u0437\u0437\u044f\u0435 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"417","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456&raquo; \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 13 et 15: CSEL 3, 406-408)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0451\u043c\u0441\u044f \u043d\u0430 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0431\u0430\u0447\u044b\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0425\u0442\u043e \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0435 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430, \u0431\u0443\u0434\u0437\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b&raquo; (\u041c\u0446 10, 22; 24, 13), &ndash; \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0437\u0431\u0430\u045e\u0447\u044b \u043d\u0430\u043a\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0456 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430. \u0406 \u044f\u0448\u0447\u044d: &laquo;\u041a\u0430\u043b\u0456 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0441\u043b\u043e\u0432\u0435 \u041c\u0430\u0456\u043c, \u0442\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0432\u0443\u0447\u043d\u044f\u043c\u0456 \u041c\u0430\u0456\u043c\u0456 \u0456 \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435 \u043f\u0440\u0430\u045e\u0434\u0443, \u0430 \u043f\u0440\u0430\u045e\u0434\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u0432\u0430\u0441&raquo; (\u042f\u043d 8, 31-32).<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0440\u0430\u0433\u0456\u044f \u0431\u0440\u0430\u0442\u044b, \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0456 \u0442\u0440\u044b\u0432\u0430\u0446\u044c, \u043a\u0430\u0431, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u043f\u0440\u0430\u045e\u0434\u0443 \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u0443, \u043c\u044b \u0437\u043c\u0430\u0433\u043b\u0456 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u044b. \u0422\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435, \u0443\u0436\u043e \u0441\u0430\u043c\u043e \u043f\u0430 \u0441\u0430\u0431\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043d\u0430\u0434\u0437\u0435\u044e \u0456 \u0432\u0435\u0440\u0443, \u0430\u043b\u0435, \u043a\u0430\u0431 \u043d\u0430\u0434\u0437\u0435\u044f \u0456 \u0432\u0435\u0440\u0430 \u043c\u0430\u0433\u043b\u0456 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u043f\u043b\u0451\u043d, \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043d\u0435 \u0456\u043c\u043a\u043d\u0451\u043c\u0441\u044f \u0434\u0430 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0439 \u0441\u043b\u0430\u0432\u044b, \u0430\u043b\u0435 \u0434\u0430 \u0431\u0443\u0434\u0443\u0447\u0430\u0439, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430, \u044f\u043a\u0456 \u043f\u0430\u0432\u0443\u0447\u0430\u0435: &laquo;\u041c\u044b \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u043d\u0430\u0434\u0437\u0435\u044f\u0439. \u0410 \u043d\u0430\u0434\u0437\u0435\u044f, \u043a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u0431\u0430\u0447\u044b\u0446\u044c, \u043d\u0435 \u0451\u0441\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044f\u0439. \u0411\u043e, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c, \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u044f\u043c\u0443 \u044f\u0448\u0447\u044d \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430? \u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u0441\u043f\u0430\u0434\u0437\u044f\u0451\u043c\u0441\u044f \u043d\u0430 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0431\u0430\u0447\u044b\u043c, \u0442\u0430\u0434\u044b \u0447\u0430\u043a\u0430\u0435\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430&raquo; (\u0420\u044b\u043c 8, 24-25). \u0427\u0430\u043a\u0430\u043d\u043d\u0435 \u0456 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u044f, \u043a\u0430\u0431 \u043c\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u0442\u043e\u0435, \u0434\u0430 \u0447\u0430\u0433\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0442\u043e\u0435, \u043d\u0430 \u0448\u0442\u043e \u045e\u0441\u043a\u043b\u0430\u0434\u0430\u0435\u043c \u043d\u0430\u0434\u0437\u0435\u044e \u0456 \u045e \u0448\u0442\u043e \u0432\u0435\u0440\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0442\u043e\u0439 \u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u0434\u0430 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0437\u0431\u0456\u0440\u0430\u0435 \u0441\u0430\u0431\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0441\u043a\u0430\u0440\u0431\u044b. \u0421\u0432. \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430 \u0456\u043c, \u043f\u0430\u0432\u0443\u0447\u0430\u044e\u0447\u044b: &laquo;\u041f\u0430\u043a\u0443\u043b\u044c \u0451\u0441\u0446\u044c \u0447\u0430\u0441, \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u0434\u043b\u044f \u045e\u0441\u0456\u0445, \u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 &ndash; \u0434\u043b\u044f \u0440\u043e\u0434\u043d\u044b\u0445 \u043f\u0430 \u0432\u0435\u0440\u044b. \u0411\u0443\u0434\u0437\u0435\u043c \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430 \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0431\u043e \u045e \u0441\u0432\u043e\u0439 \u0447\u0430\u0441 \u043f\u0430\u0436\u043d\u0435\u043c&raquo; (\u0413\u0430\u043b 6, 10. 9).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043f\u0435\u0440\u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0435 \u043d\u0430\u0441, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0440\u0430\u0437 \u043d\u0435\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u045e \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u043a\u0430\u0431 \u0441\u043f\u0430\u043a\u0443\u0441\u0430 \u043d\u0435 \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0456 \u043d\u0435 \u0437\u0432\u044f\u043b\u0430 \u044f\u0433\u043e \u0441\u0430 \u0448\u043b\u044f\u0445\u0443 \u0434\u0430 \u0445\u0432\u0430\u043b\u044b \u0456 \u0441\u043b\u0430\u0432\u044b, \u043a\u0430\u0431 \u0451\u043d \u043d\u0435 \u0437\u043c\u0430\u0440\u043d\u0430\u0432\u0430\u045e \u043c\u0456\u043d\u0443\u043b\u044b\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u0456, \u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0435 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u043a\u0430\u043b\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u043f\u0440\u0430 \u043b\u044e\u0431\u043e\u045e, \u0451\u043d \u0434\u0430\u043b\u0443\u0447\u0430\u0435 \u0434\u0430 \u044f\u0435 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041b\u044e\u0431\u043e\u045e \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u044f, \u043b\u044e\u0431\u043e\u045e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u044f, \u043b\u044e\u0431\u043e\u045e \u043d\u0435 \u0437\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u0446\u0456\u0446\u044c, \u043d\u0435 \u0433\u043d\u044f\u0432\u0456\u0446\u0446\u0430, \u043d\u0435 \u0437\u043b\u0443\u0435\u0446\u0446\u0430, \u043d\u0435 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0435 \u0437\u043b\u043e\u0433\u0430, \u0443\u0441\u0451 \u043b\u044e\u0431\u0456\u0446\u044c, \u0443\u0441\u044f\u043c\u0443 \u0432\u0435\u0440\u044b\u0446\u044c, \u043d\u0430 \u045e\u0441\u0451 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430, \u0443\u0441\u0451 \u0437\u043d\u043e\u0441\u0456\u0446\u044c&raquo; (1 \u041a\u0430\u0440 13, 4-5). \u0413\u044d\u0442\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0451\u043d \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u0448\u0442\u043e \u043b\u044e\u0431\u043e\u045e \u043c\u043e\u0436\u0430 \u0446\u0432\u0451\u0440\u0434\u0430 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443\u0441\u0451, \u0431\u043e \u045e\u043c\u0435\u0435 \u0441\u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0443\u0441\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430: &laquo;\u0426\u044f\u0440\u043f\u0456\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0441\u0442\u0430\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e&raquo; (\u042d\u0444 4, 2b-3). \u0422\u0430\u043a \u0451\u043d \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u045e, \u0448\u0442\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u043d\u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u043d\u0456 \u0441\u043f\u0430\u043a\u043e\u044e, \u043a\u0430\u043b\u0456 \u0431\u0440\u0430\u0442\u044b \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u044e \u043b\u044e\u0431\u043e\u045e\u044e, \u043a\u0430\u043b\u0456 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u044f\u043d\u044b \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0431\u0435\u0440\u0430\u0433\u0430\u0446\u044c \u0437\u0433\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u0431 2, 3; \u0413\u0431\u0440 10, 37<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0456 \u043d\u0435 \u0430\u0448\u0443\u043a\u0430\u0435. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0431\u0443\u0434\u0437\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0446\u044c, \u0447\u0430\u043a\u0430\u0439, \u0431\u043e \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u043e\u0432\u0430, \u043d\u0435 \u0441\u043f\u043e\u0437\u043d\u0456\u0446\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u0448\u0447\u044d \u043a\u0440\u044b\u0445\u0443 &ndash; \u0456 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u044b\u0439\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0431\u0443\u0434\u0437\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0446\u044c, \u0447\u0430\u043a\u0430\u0439, \u0431\u043e \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u043e\u0432\u0430, \u043d\u0435 \u0441\u043f\u043e\u0437\u043d\u0456\u0446\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"421","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430\u045e \u0406\u0441\u0430\u0456&raquo; \u042d\u045e\u0437\u044d\u0431\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0426\u044d\u0437\u0430\u0440\u044d\u0456<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 40: PG 24, 366-367)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0413\u043e\u043b\u0430\u0441 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u043b\u0456\u0447\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0413\u043e\u043b\u0430\u0441 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u043b\u0456\u0447\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456: \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439\u0446\u0435 \u0434\u0430\u0440\u043e\u0433\u0443 \u041f\u0430\u043d\u0443, \u0440\u0430\u045e\u043d\u0430\u0439\u0446\u0435 \u045e \u0441\u0442\u044d\u043f\u0435 \u0448\u043b\u044f\u0445 \u043d\u0430\u0448\u0430\u043c\u0443 \u0411\u043e\u0433\u0443&raquo; (\u0406\u0441 40, 3). \u0406\u0441\u0430\u044f \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u0430\u0435 \u045e \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0431\u044b\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0430 \u043d\u0435 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435. \u0410 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u0448\u0442\u043e \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0447\u0430\u0441, \u043a\u0430\u043b\u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0441\u043b\u0430\u0432\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0411\u043e\u0436\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u0435 \u043a\u043e\u0436\u043d\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u045e \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0456, \u043a\u0430\u043b\u0456 \u042f\u043d \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044c \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u045e \u0437\u0431\u0430\u045e\u0447\u0430\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0411\u043e\u0433\u0430 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u042f\u0440\u0434\u0430\u043d\u0430, \u0434\u0437\u0435 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0411\u043e\u0436\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0411\u043e \u0442\u0430\u0434\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u045e\u0441\u0456\u043c \u0443 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u0435, \u043a\u0430\u043b\u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0445\u0440\u043e\u0441\u0442\u0443 \u0430\u0434\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u0441\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u045e \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0433\u043e\u043b\u0443\u0431\u0430, \u0441\u043f\u0430\u0447\u044b\u045e \u043d\u0430 \u0406\u043c. \u041f\u0430\u0441\u043b\u044f \u0437\u0430\u0433\u0443\u0447\u0430\u045e \u0433\u043e\u043b\u0430\u0441 \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u045e \u043f\u0440\u0430 \u0421\u044b\u043d\u0430: &laquo;\u0413\u044d\u0442\u0430 \u0421\u044b\u043d \u041c\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u042f\u0433\u043e \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435&raquo; (\u041c\u0446 17, 5).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u043a \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u044e, \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443 \u043d\u0435\u043f\u0440\u0430\u0445\u043e\u0434\u043d\u0443\u044e \u0456 \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u0443\u044e. \u0423\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430, \u0430 \u045e\u0441\u0435 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0456 \u0411\u043e\u0436\u044b\u044f \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0434\u0430 \u0456\u0445. \u0422\u0430\u043c\u0443 \u0433\u043e\u043b\u0430\u0441 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u0448\u043b\u044f\u0445 \u0411\u043e\u0436\u0430\u043c\u0443 \u0421\u043b\u043e\u0432\u0443 \u0456 \u0432\u044b\u0440\u0430\u045e\u043d\u0430\u0446\u044c \u043d\u0435\u043f\u0440\u0430\u0445\u043e\u0434\u043d\u0430\u0435 \u0431\u0435\u0437\u0434\u0430\u0440\u043e\u0436\u0436\u0430, \u043a\u0430\u0431 \u0411\u043e\u0433 \u043d\u0430\u0448, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b, \u043c\u043e\u0433 \u0456\u043c \u043a\u0440\u043e\u0447\u044b\u0446\u044c. &laquo;\u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439\u0446\u0435 \u0434\u0430\u0440\u043e\u0433\u0443 \u041f\u0430\u043d\u0443&raquo; (\u043f\u0430\u0440. \u041c\u0430\u043b 3, 1) &ndash; \u0433\u044d\u0442\u0430 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0430\u044f \u043f\u0440\u043e\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0456 \u043d\u043e\u0432\u0430\u0435 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u0430\u0433\u043d\u0435 \u0434\u0430\u043d\u0435\u0441\u0446\u0456 \u0434\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u0430\u0432\u0456\u043d\u0443 \u043f\u0440\u0430 \u0411\u043e\u0436\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0423\u0437\u044b\u0434\u0437\u0456 \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u0443\u044e \u0433\u0430\u0440\u0443, \u0421\u0456\u0451\u043d\u0435, \u044f\u043a\u0456 \u043d\u044f\u0441\u0435\u0448 \u0434\u043e\u0431\u0440\u044b\u044f \u0432\u0435\u0441\u0442\u043a\u0456. \u0417\u0440\u0430\u0431\u0456 \u043c\u043e\u0446\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441 \u0441\u0432\u043e\u0439, \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435, \u044f\u043a\u0456 \u043d\u044f\u0441\u0435\u0448 \u0434\u043e\u0431\u0440\u044b\u044f \u0432\u0435\u0441\u0442\u043a\u0456&raquo; (\u0406\u0441 40, 9). \u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u043f\u0430\u0441\u0443\u044e\u0446\u044c \u0434\u0430 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u0445. \u042f\u043d\u044b \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0437\u0433\u0430\u0434\u0432\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u0434\u0430\u0431\u0440\u0430\u0432\u0435\u0441\u043d\u0456\u043a\u0430\u045e \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0411\u043e\u0433\u0430 \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439 \u043f\u0430\u0441\u043b\u044f \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0442\u0430\u0433\u043e, \u0447\u044b\u0439 \u0433\u043e\u043b\u0430\u0441 \u043a\u043b\u0456\u0447\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456. \u0422\u0430\u043c\u0443 \u0441\u043b\u0443\u0448\u043d\u0430 \u0437\u0430 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430\u043c \u043f\u0440\u0430 \u042f\u043d\u0430 \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044f \u0456\u0434\u0437\u0435 \u0437\u0433\u0430\u0434\u043a\u0430 \u043f\u0440\u0430 \u0434\u0430\u0431\u0440\u0430\u0432\u0435\u0441\u043d\u0456\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0436 \u0433\u044d\u0442\u0430 \u0442\u0430\u0434\u044b \u0437\u0430 \u0421\u0456\u0451\u043d? \u041d\u0430\u043f\u044d\u045e\u043d\u0430 \u0442\u043e\u0439, \u044f\u043a\u0456 \u0440\u0430\u043d\u0435\u0439 \u043d\u0430\u0437\u044b\u0432\u0430\u045e\u0441\u044f \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430\u043c. \u0411\u043e \u0456 \u0441\u0430\u043c \u0451\u043d \u0431\u044b\u045e \u0433\u0430\u0440\u043e\u0439, \u044f\u043a \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u041f\u0456\u0441\u0430\u043d\u043d\u0435: &laquo;\u0413\u0430\u0440\u0430 \u0421\u0456\u0451\u043d \u0442\u0430\u043c, \u0434\u0437\u0435 \u0442\u044b \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f&raquo; (\u041f\u0441 74 [73], 2), \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u0412\u044b \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u0434\u0430 \u0433\u0430\u0440\u044b \u0421\u0456\u0451\u043d&raquo; (\u0413\u0431\u0440 12, 22). \u0410 \u043c\u043e\u0436\u0430, \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0430\u0431\u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u0445 \u0437 \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443?<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u044b \u0456 \u0451\u0441\u0446\u044c \u0421\u0456\u0451\u043d\u0430\u043c \u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430\u043c, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0435 \u0456 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b \u0432\u044b\u0441\u043e\u043a\u0430 \u043d\u0430 \u0441\u0430\u043c\u043e\u0439 \u0433\u0430\u0440\u044b \u0411\u043e\u0436\u0430\u0439 &ndash; \u043d\u0430 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u0421\u043b\u043e\u0432\u0435 \u042f\u0433\u043e\u043d\u044b\u043c. \u0413\u044d\u0442\u0430 \u0456\u043c \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u043f\u0430\u0441\u043b\u044f \u045e\u0437\u044b\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u044f \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u0443\u044e \u0433\u0430\u0440\u0443. \u0425\u0442\u043e \u0436 \u0442\u0430\u0434\u044b \u0434\u0430\u0431\u0440\u0430\u0432\u0435\u0441\u043d\u0456\u043a, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e? \u0428\u0442\u043e \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0414\u043e\u0431\u0440\u0443\u044e \u041d\u0430\u0432\u0456\u043d\u0443? \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0443\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c, \u0430 \u043f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451 \u0433\u0430\u0440\u0430\u0434\u0430\u043c \u042e\u0434\u044b, \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041c\u0446 11, 11. 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a \u041f\u0430\u043d\u0430 \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043f\u0440\u0430 \u044f\u043a\u043e\u0433\u0430 \u0401\u043d \u0441\u0430\u043c \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c: <span style=\"color: #ff0000;\">*<\/span> \u0421\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u0445 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456 \u043d\u0435 \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0431\u043e\u043b\u044c\u0448\u044b \u0437\u0430 \u042f\u043d\u0430 \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u0440\u043e\u043a \u0456 \u043d\u0430\u0432\u0430\u0442 \u0431\u043e\u043b\u044c\u0448\u044b \u0437\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430, \u043f\u0440\u0430 \u044f\u043a\u043e\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u0430 \u043a\u0430\u0436\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u0445 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456 \u043d\u0435 \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0431\u043e\u043b\u044c\u0448\u044b \u0437\u0430 \u042f\u043d\u0430 \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"422","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0423\u0437\u044b\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435 \u043d\u0430 \u0433\u0430\u0440\u0443 \u041a\u0430\u0440\u043c\u044d\u043b\u044c&raquo; \u0441\u0432. \u042f\u043d\u0430 \u0430\u0434 \u041a\u0440\u044b\u0436\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 2, cap. 22)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0411\u043e\u0433 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0413\u0430\u043b\u043e\u045e\u043d\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439, \u043f\u0430 \u044f\u043a\u043e\u0439 \u0443 \u0441\u0442\u0430\u0440\u044b\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0446\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u043b\u0430\u0441\u044f \u043f\u044b\u0442\u0430\u0446\u0446\u0430 \u045e \u0411\u043e\u0433\u0430 \u0456 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0443 \u042f\u0433\u043e \u0432\u0456\u0437\u0456\u0439 \u0456 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f\u045e, \u0431\u044b\u043b\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u0430\u0434\u044b \u0432\u0435\u0440\u0430 \u044f\u0448\u0447\u044d \u043d\u0435 \u0431\u044b\u043b\u0430 \u0433\u0440\u0443\u043d\u0442\u043e\u045e\u043d\u0430 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u0430\u044f, \u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u044f\u0448\u0447\u044d \u043d\u0435 \u0431\u044b\u043b\u043e \u045e\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u0430. \u0422\u0430\u043c\u0443 \u0456 \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u043f\u044b\u0442\u0430\u0446\u0446\u0430 \u043f\u0440\u0430 \u045e\u0441\u0451 \u045e \u0411\u043e\u0433\u0430. \u0401\u043d \u0436\u0430 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0434\u0430 \u0456\u0445 \u0446\u0456 \u045e \u0441\u043b\u043e\u0432\u0430\u0445, \u0446\u0456 \u045e \u0432\u0456\u0437\u0456\u044f\u0445 \u0456 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f\u0445, \u0446\u0456 \u045e \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u0445 \u0456 \u0430\u043b\u0435\u0433\u043e\u0440\u044b\u044f\u0445, \u0446\u0456, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u0443 \u0440\u043e\u0437\u043d\u044b\u0445 \u0437\u043d\u0430\u043a\u0430\u0445. \u0410 \u045e\u0441\u0451, \u043f\u0440\u0430\u0437 \u0448\u0442\u043e \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e \u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e, \u0448\u0442\u043e \u0430\u0431&rsquo;\u044f\u045e\u043b\u044f\u045e, \u0431\u044b\u043b\u043e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u044e \u043d\u0430\u0448\u0430\u0439 \u0441\u0432\u044f\u0442\u043e\u0439 \u0432\u0435\u0440\u044b \u0430\u0431\u043e \u0442\u044b\u043c, \u0448\u0442\u043e \u044f\u0435 \u0434\u0430\u0442\u044b\u0447\u044b\u043b\u0430 \u0446\u0456 \u0434\u0430 \u044f\u0435 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0446\u044f\u043f\u0435\u0440, \u043a\u0430\u043b\u0456 \u0432\u0435\u0440\u0430 \u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u043a\u0430\u0440\u0430\u043d\u0456\u043b\u0430\u0441\u044f \u0456 \u0431\u044b\u043b\u043e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u045e \u0447\u0430\u0441 \u043b\u0430\u0441\u043a\u0456, \u043d\u044f\u043c\u0430 \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u043f\u044b\u0442\u0430\u0446\u0446\u0430 \u045e \u0411\u043e\u0433\u0430 \u044f\u043a \u0440\u0430\u043d\u0435\u0439, \u0430 \u042f\u043c\u0443 &ndash; \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0434\u0430 \u043d\u0430\u0441, \u044f\u043a \u0442\u0430\u0434\u044b. \u0410\u0434 \u043c\u043e\u043c\u0430\u043d\u0442\u0443, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0434\u0430\u045e \u043d\u0430\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u042f\u0433\u043e \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0456 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u044b\u043c \u0421\u043b\u043e\u0432\u0430\u043c, \u0401\u043d \u0443\u0441\u0451 \u0441\u043a\u0430\u0437\u0430\u045e \u0430\u0434\u0440\u0430\u0437\u0443 \u045e \u0433\u044d\u0442\u044b\u043c \u0430\u0434\u043d\u044b\u043c \u0441\u0432\u0430\u0456\u043c \u0421\u043b\u043e\u0432\u0435 \u0456 \u043d\u0435 \u043c\u0430\u0435 \u0431\u043e\u043b\u044c\u0448 \u043d\u0456\u0447\u043e\u0433\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0433\u044d\u0442\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u0441\u044d\u043d\u0441 \u0442\u0430\u0433\u043e \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f, \u044f\u043a\u0456\u043c \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0456\u043c\u043a\u043d\u0443\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u0446\u044c \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b \u0430\u0434\u044b\u0448\u043b\u0456 \u0430\u0434 \u0434\u0430\u045e\u043d\u0456\u0445, \u0441\u0442\u0430\u0440\u0430\u0437\u0430\u043f\u0430\u0432\u0435\u0442\u043d\u044b\u0445 \u0430\u0434\u043d\u043e\u0441\u0456\u043d\u0430\u045e \u0456 \u0430\u0431\u044b\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u044f \u0437 \u0411\u043e\u0433\u0430\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u043a\u043e\u043d\u0443 \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u0437\u0432\u044f\u0440\u043d\u0443\u043b\u0456 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430 \u0425\u0440\u044b\u0441\u0442\u0430: &laquo;\u0428\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e \u0456 \u043f\u0430-\u0440\u043e\u0437\u043d\u0430\u043c\u0443 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0411\u043e\u0433 \u0434\u0430 \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0443 \u0433\u044d\u0442\u044b\u044f \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u0421\u044b\u043d\u0430&raquo; (\u0413\u0431\u0440 1, 1). \u0413\u044d\u0442\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0434\u0430\u0435 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u044f\u043a \u0448\u043c\u0430\u0442 \u0411\u043e\u0433 \u0432\u044b\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u0421\u043b\u043e\u0432\u0430, \u0442\u0430\u043c\u0443 \u0431\u043e\u043b\u044c\u0448 \u0443\u0436\u043e \u043d\u044f\u043c\u0430 \u0447\u0430\u0433\u043e \u0436\u0430\u0434\u0430\u0446\u044c. \u0422\u043e\u0435, \u0448\u0442\u043e \u0440\u0430\u043d\u0435\u0439 \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430 \u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c, \u0443\u0436\u043e \u0446\u0430\u043b\u043a\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u045e, \u0434\u0430\u044e\u0447\u044b \u043d\u0430\u043c \u0443\u0441\u0451 &ndash; \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430 \u043d\u0435\u0448\u0442\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430, \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0443 \u042f\u0433\u043e \u043d\u0435\u0439\u043a\u0430\u0439 \u0432\u0456\u0437\u0456\u0456 \u0446\u0456 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f, \u043c\u043e\u0436\u0430 \u0430\u0431\u0440\u0430\u0437\u0456\u0446\u044c \u042f\u0433\u043e, \u043a\u0430\u043b\u0456, \u043d\u0435 \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u0456\u0445 \u0432\u0430\u0447\u044d\u0439 \u0446\u0430\u043b\u043a\u0430\u043c \u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u043d\u0435\u0447\u0430\u0433\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u043f\u0430-\u0437\u0430 \u0406\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u043c\u043e\u0433 \u0431\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u043a\u043e\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443: &laquo;\u0413\u044d\u0442\u0430 \u0421\u044b\u043d \u041c\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u044f\u043a\u043e\u0433\u0430 \u042f \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e. \u042f\u0433\u043e \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435&raquo; (\u041c\u0446 17, 5). \u042f \u045e\u0436\u043e \u045e\u0441\u0451 \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u0421\u043b\u043e\u0432\u0430: \u0441\u043a\u0456\u0440\u0443\u0439 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u043d\u0430 \u042f\u0433\u043e \u0430\u0434\u043d\u0430\u0433\u043e, \u0431\u043e \u045e \u0406\u043c \u042f \u0442\u0430\u0431\u0435 \u045e\u0436\u043e \u045e\u0441\u0451 \u0441\u043a\u0430\u0437\u0430\u045e \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e. \u0422\u044b \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u0443 \u0406\u043c \u043d\u0430\u0448\u043c\u0430\u0442 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043c\u043e\u0436\u0430\u0448 \u043f\u0430\u0436\u0430\u0434\u0430\u0446\u044c \u0446\u0456 \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0414\u0443\u0445\u0430\u043c \u042f \u045e\u0436\u043e \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u042f\u0433\u043e \u043d\u0430 \u0433\u0430\u0440\u044b \u0422\u0430\u0431\u043e\u0440 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0413\u044d\u0442\u0430 \u0421\u044b\u043d \u041c\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u044f\u043a\u043e\u0433\u0430 \u042f \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e. \u042f\u0433\u043e \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435&raquo; (\u041c\u0446 17, 5). \u0422\u0430\u0431\u0435 \u043d\u044f\u043c\u0430 \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u0448\u0443\u043a\u0430\u0446\u044c \u043d\u043e\u0432\u044b\u0445 \u0432\u0443\u0447\u044d\u043d\u043d\u044f\u045e \u0456 \u043d\u043e\u0432\u044b\u0445 \u0430\u0434\u043a\u0430\u0437\u0430\u045e. \u0411\u043e \u043a\u0430\u043b\u0456 \u042f \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0440\u0430\u043d\u0435\u0439, \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430. \u041a\u0430\u043b\u0456 \u0436 \u043d\u0435\u0448\u0442\u0430 \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u043b\u0456\u0441\u044f \u0430\u0434 \u041c\u044f\u043d\u0435, \u0442\u043e \u0440\u0430\u0431\u0456\u043b\u0456 \u0433\u044d\u0442\u0430 \u045e \u043f\u043e\u0448\u0443\u043a\u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u043d\u0430 \u042f\u0433\u043e. \u0411\u043e \u045e \u0406\u043c \u043c\u043e\u0436\u043d\u0430 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u045e\u0441\u0451 \u0434\u0430\u0431\u0440\u043e, \u044f\u043a \u0446\u044f\u043f\u0435\u0440 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0433\u044d\u0442\u0430 \u045e\u0441\u0451 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442\u0430\u045e \u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0456\u0445 4, 2; \u042f\u043d 4, 25<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043f\u0435\u0448\u043d\u0430 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u0441\u043a\u0430\u0436\u0443\u0446\u044c: \u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u043f\u0430\u0434\u044b\u043c\u0435\u043c\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u0443 \u041f\u0430\u043d\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0441\u0432\u0430\u0456\u043c \u0448\u043b\u044f\u0445\u0430\u043c, \u0456 \u043c\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0441\u0446\u0435\u0436\u043a\u0430\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u0439\u0434\u0437\u0435 \u041c\u0435\u0441\u0456\u044f, \u044f\u043a\u0456 \u0437\u0430\u0432\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u041a\u0430\u043b\u0456 \u0401\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u043c \u0443\u0441\u0451.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0441\u0432\u0430\u0456\u043c \u0448\u043b\u044f\u0445\u0430\u043c, \u0456 \u043c\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0441\u0446\u0435\u0436\u043a\u0430\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"423","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0430\u0433\u043c\u0430\u0442\u044b\u0447\u043d\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u0430\u0431 \u041a\u0430\u0441\u0446\u0451\u043b\u0435 &laquo;Lumen gentium&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(N. 48)<\/span><br \/><em><span style=\"color: #ff0000;\">\u042d\u0441\u0445\u0430\u0442\u0430\u043b\u0430\u0433\u0456\u0447\u043d\u044b \u0445\u0430\u0440\u0430\u043a\u0442\u0430\u0440 \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0443\u044e\u0447\u0430\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0441\u0446\u0451\u043b, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435 \u043c\u044b \u045e\u0441\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0456 \u045e \u044f\u043a\u0456\u043c, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u0446\u044b, \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u0435\u043c \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c, \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u0435, \u043a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0447\u0430\u0441 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0441\u044f\u0433\u043e \u0456 \u043a\u0430\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442, \u044f\u043a\u0456 \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u0437\u0432\u044f\u0437\u0430\u043d\u044b \u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0456 \u043f\u0440\u0430\u0437 \u044f\u0433\u043e \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u043c\u044d\u0442\u044b, \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0430\u0434\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0443\u0437\u043d\u044f\u0442\u044b \u043d\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u0439, \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443\u045e \u0434\u0430 \u0441\u044f\u0431\u0435 \u045e\u0441\u0456\u0445; \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u0448\u044b, \u0401\u043d \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430 \u0432\u0443\u0447\u043d\u044f\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u0430\u0433\u0430 \u0414\u0443\u0445\u0430 \u0456 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b, \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u0430\u0439 \u043f\u0440\u044b\u043b\u0430\u0434\u0430\u0439 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f; \u0441\u0435\u0434\u0437\u044f\u0447\u044b \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0410\u0439\u0446\u0430, \u0401\u043d \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e \u0441\u0432\u0435\u0446\u0435, \u043a\u0430\u0431 \u0432\u0435\u0441\u0446\u0456 \u043b\u044e\u0434\u0437\u0435\u0439 \u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0456 \u043f\u0440\u0430\u0437 \u044f\u0433\u043e \u043c\u0430\u0446\u043d\u0435\u0439 \u044f\u0434\u043d\u0430\u0446\u044c \u0456\u0445 \u0437 \u0441\u0430\u0431\u043e\u0439 \u0456, \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0456\u0445 \u0441\u0432\u0430\u0456\u043c \u0426\u0435\u043b\u0430\u043c \u0456 \u041a\u0440\u044b\u0432\u0451\u044e, \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f \u045e \u0441\u043b\u0430\u0432\u0435. \u0417\u043d\u0430\u0447\u044b\u0446\u044c, \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u044f\u043a\u043e\u0433\u0430 \u0447\u0430\u043a\u0430\u0435\u043c, \u0443\u0436\u043e \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u043b\u043e\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0440\u0430\u0437\u0432\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u0443 \u044f\u043a\u0456\u043c \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u043f\u0440\u0430 \u0441\u044d\u043d\u0441 \u043d\u0430\u0448\u0430\u0433\u0430 \u0447\u0430\u0441\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u0434\u0430\u0432\u043e\u0434\u0437\u044f\u0447\u044b \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u045e \u0441\u0432\u0435\u0446\u0435 \u0441\u043f\u0440\u0430\u0432\u0443, \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0443\u044e \u043d\u0430\u043c \u0410\u0439\u0446\u043e\u043c, \u0456 \u043f\u0440\u0430\u0446\u0443\u044e\u0447\u044b \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0436\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u043d\u0430\u0441 \u043a\u0430\u043d\u0435\u0446 \u0432\u044f\u043a\u043e\u045e, \u0456 \u043d\u0435\u0437\u0432\u0430\u0440\u043e\u0442\u043d\u0430 \u045e\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u0430 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u0432\u0435\u0442\u0443, \u044f\u043a\u043e\u0435 \u043f\u044d\u045e\u043d\u044b\u043c \u0440\u044d\u0430\u043b\u044c\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0440\u0430\u0434\u0447\u0443\u0432\u0430\u0435\u0446\u0446\u0430 \u045e\u0436\u043e \u045e \u0433\u044d\u0442\u044b \u0447\u0430\u0441, \u0431\u043e \u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439, \u0445\u043e\u0446\u044c \u044f\u0448\u0447\u044d \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044e. \u0410\u0434\u043d\u0430\u043a \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u045e\u0437\u043d\u0456\u043a\u043d\u0443\u0446\u044c \u043d\u043e\u0432\u044b\u044f \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u043d\u043e\u0432\u0430\u044f \u0437\u044f\u043c\u043b\u044f, \u0443 \u044f\u043a\u0456\u0445 \u0436\u044b\u0432\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0443\u044e\u0447\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0441\u0432\u0430\u0456\u0445 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u0445 \u0456 \u0456\u043d\u0441\u0442\u044b\u0442\u0443\u0442\u0430\u0445, \u044f\u043a\u0456\u044f \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0433\u0430 \u0432\u0435\u043a\u0443, \u043c\u0430\u0435 \u0432\u044b\u0433\u043b\u044f\u0434 \u043f\u0440\u0430\u043c\u0456\u043d\u0430\u044e\u0447\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0456 \u0436\u044b\u0432\u0435 \u0441\u044f\u0440\u043e\u0434 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e, \u044f\u043a\u0456\u044f \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0441\u0442\u043e\u0433\u043d\u0443\u0446\u044c, \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u0430\u0440\u0430\u0434\u0437\u0456\u0445\u0430, \u0456 \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0441\u044b\u043d\u043e\u045e \u0411\u043e\u0436\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0424\u043b\u043f 3, 20-21; \u0426\u0456\u0442 2, 12<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b \u0447\u0430\u043a\u0430\u0435\u043c \u0417\u0431\u0430\u045e\u0446\u0443, \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u045e \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0443\u0434\u0437\u0435\u043c \u0436\u044b\u0446\u044c \u0443 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456\u043c \u0436\u044b\u0446\u0446\u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430, \u0447\u0430\u043a\u0430\u044e\u0447\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0456 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0445\u0432\u0430\u043b\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u045e \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"424","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(In ps. 109, 1-3: \u0421\u0421L 40, 1601-1603)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0411\u043e\u0433 \u0434\u0430\u0435 \u043d\u0430\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435 <\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0447\u0430\u0441 \u0434\u043b\u044f \u0441\u0432\u0430\u0456\u0445 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0447\u0430\u0441 \u0434\u043b\u044f \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0430\u0431\u044f\u0446\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u0441\u0430\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f \u0431\u044b\u045e \u0447\u0430\u0441 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0430\u0436\u043d\u043e \u0434\u0430 \u042f\u043d\u0430 \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044f. \u0410 \u043f\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b \u0430\u0434 \u044f\u0433\u043e \u0456 \u0434\u0430\u043b\u0435\u0439 \u0430\u0436 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 &ndash; \u0447\u0430\u0441 \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0430\u0431\u044f\u0446\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u0440\u043d\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u044f\u0431\u0435 \u043d\u0430\u0448\u044b\u043c \u0434\u0430\u045e\u0436\u043d\u0456\u043a\u043e\u043c, \u043d\u0435 \u045e\u0437\u044f\u045e \u043d\u0456\u0447\u043e\u0433\u0430 \u0430\u0434 \u043d\u0430\u0441, \u0430\u043b\u0435 \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u043d\u0430\u043c \u0442\u0430\u043a \u0448\u043c\u0430\u0442. \u0406 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0437\u0430\u0431\u0430\u0432\u044f\u0437\u0430\u0446\u0446\u0430 \u043f\u0456\u0441\u044c\u043c\u043e\u0432\u0430, \u043d\u0456\u0431\u044b\u0442\u0430 \u0440\u043e\u0431\u044f\u0447\u044b \u0434\u043b\u044f \u043d\u0430\u0441 \u0440\u0430\u0441\u043f\u0456\u0441\u043a\u0443 \u045e \u0441\u0432\u0430\u0456\u0445 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u0445, \u043a\u0430\u0431, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u043d\u0435 \u0441\u043f\u0430\u045e\u043d\u044f\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435, \u043c\u044b \u0437\u043c\u0430\u0433\u043b\u0456 \u043f\u0440\u0430\u0432\u0435\u0440\u044b\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u0433\u0430 \u043f\u0430\u0440\u0430\u0434\u0430\u043a \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u045e. \u0422\u0430\u043a, \u0447\u0430\u0441 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0431\u044b\u045e, \u044f\u043a \u043c\u044b \u045e\u0436\u043e \u0447\u0430\u0441\u0442\u0430 \u043a\u0430\u0437\u0430\u043b\u0456, \u0447\u0430\u0441\u0430\u043c, \u043a\u0430\u043b\u0456 \u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u043d\u0430\u043c \u0432\u0435\u0447\u043d\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0448\u0447\u0430\u0441\u043d\u0430\u0435 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0437 \u0430\u043d\u0451\u043b\u0430\u043c\u0456, \u043d\u0435\u045e\u0432\u044f\u0434\u0430\u043b\u044c\u043d\u0443\u044e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443, \u0432\u0435\u0447\u043d\u0443\u044e \u0441\u043b\u0430\u0432\u0443, \u0441\u043b\u043e\u0434\u044b\u0447 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0434\u043e\u043c \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439 \u0443 \u043d\u044f\u0431\u0451\u0441\u0430\u0445, \u0430 \u043f\u0430\u0441\u043b\u044f \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 &ndash; \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e. \u0413\u044d\u0442\u0430 \u042f\u0433\u043e \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u043d\u0430\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u045e\u0441\u0435 \u043d\u0430\u0448\u044b \u043d\u0430\u043c\u0435\u0440\u044b: \u043a\u0430\u043b\u0456 \u043c\u044b \u0434\u043e\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u044f\u0433\u043e, \u043d\u0430\u043c \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430, \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430. \u0410\u043b\u0435, \u0434\u0430\u044e\u0447\u044b \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456 \u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u0456\u0445 \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435, \u0411\u043e\u0433 \u043d\u0435 \u045e\u0442\u043e\u0456\u045e, \u0443 \u044f\u043a\u0456\u043c \u043f\u0430\u0440\u0430\u0434\u043a\u0443 \u0434\u043e\u0439\u0434\u0437\u0435 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u045e \u043a\u0430\u043d\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0443 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044c, \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c &ndash; \u0431\u0435\u0441\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u0433\u0440\u044d\u0448\u043d\u044b\u043c &ndash; \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435, \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043d\u044b\u043c &ndash; \u0443\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a, \u0431\u0440\u0430\u0442\u044b, \u043b\u044e\u0434\u0437\u044f\u043c \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u043d\u0435\u0432\u0435\u0440\u0430\u0433\u043e\u0434\u043d\u044b\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0431\u044f\u0446\u0430\u045e \u0411\u043e\u0433: \u043a\u0430\u0431 \u0437 \u0433\u044d\u0442\u0430\u0439 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456, \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456, \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430\u0441\u0446\u0456, \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456, \u043f\u044b\u043b\u0443 \u0456 \u043f\u043e\u043f\u0435\u043b\u0443 \u043b\u044e\u0434\u0437\u0456 \u0441\u0442\u0430\u043b\u0456 \u0440\u043e\u045e\u043d\u044b\u043c\u0456 \u0430\u043d\u0451\u043b\u0430\u043c \u0411\u043e\u0436\u044b\u043c. \u0422\u0430\u043c\u0443 \u0401\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u043a\u0430\u0431 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456, \u0430\u043b\u0435 \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u041f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456. \u0406 \u043d\u0435 \u044f\u043a\u043e\u0433\u0430-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430, \u0430\u043d\u0451\u043b\u0430 \u0446\u0456 \u0430\u0440\u0445\u0430\u043d\u0451\u043b\u0430, \u0430\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0441\u0430\u043c\u043e\u0433\u0430 \u0421\u044b\u043d\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0430\u043c \u0456 \u0434\u0430\u0446\u044c \u0448\u043b\u044f\u0445, \u043f\u0430 \u044f\u043a\u0456\u043c \u0411\u043e\u0433 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u043d\u0430\u0441 \u0434\u0430 \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0439 \u043c\u044d\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433\u0443 \u0431\u044b\u043b\u043e \u0437\u0430\u043c\u0430\u043b\u0430, \u043a\u0430\u0431 \u042f\u0433\u043e \u0421\u044b\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0433\u044d\u0442\u044b \u0448\u043b\u044f\u0445, \u0442\u0430\u043c\u0443 \u042f\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u0430 \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0433\u044d\u0442\u044b\u043c \u0448\u043b\u044f\u0445\u0430\u043c, \u043a\u0430\u0431 \u0442\u044b \u0456\u0448\u043e\u045e \u043f\u0430 \u0456\u043c, \u0430 \u0401\u043d \u0442\u0430\u0431\u043e\u0439 \u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0456 \u0432\u0451\u045e \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0437 \u0441\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u0430\u0434\u0437\u0456\u043d\u044b \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443 \u0456 \u043f\u0440\u0430\u0437 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u045e, \u0441\u0442\u0430\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u043f\u0430\u043c\u0435\u0440\u0446\u0456, \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c, \u0443\u0437\u044b\u0441\u0446\u0456 \u043d\u0430 \u043d\u0435\u0431\u0430, \u0441\u0435\u0441\u0446\u0456 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0410\u0439\u0446\u0430 \u0456 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0441\u0432\u0430\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456. \u0410\u043b\u0435 \u043f\u0430\u0441\u043b\u044f \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u044f \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u045e \u0401\u043d \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u044f\u0448\u0447\u044d \u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430, \u043a\u0430\u0431 \u0441\u043f\u0430\u0433\u043d\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0434\u0437\u044f\u043b\u0456\u045e, \u043a\u0430\u0431 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u045e \u0433\u043d\u0435\u045e, \u0430\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440&shy;\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430\u043c \u0442\u044b\u043c, \u0447\u044b\u043c \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u045e, \u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c &ndash; \u0442\u044b\u043c, \u0448\u0442\u043e \u0430\u0431\u044f\u0446\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u043c\u0443\u0441\u0456\u043b\u0430 \u0431\u044b\u0446\u044c \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u0430 \u0456 \u0437\u0430\u0433\u0430\u0434\u0437\u044f \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430 \u043f\u0435\u0440\u0430\u0434 \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435\u043c, \u043a\u0430\u0431 \u0430\u0434 \u0440\u0430\u043f\u0442\u043e\u045e\u043d\u0430\u0433\u0430 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0443 \u043d\u0435 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u043b\u0456\u0441\u044f, \u0430\u043b\u0435 \u0447\u0430\u043a\u0430\u043b\u0456 \u0442\u0430\u0433\u043e, \u0443 \u0448\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0456\u0445 7, 19; \u0414\u0437 10, 43<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u0437\u043d\u043e\u045e \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0441\u0430\u0442\u0440\u044d \u043d\u0430\u0448\u044b\u044f \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u0456 \u043a\u0456\u043d\u0435 \u045e \u043c\u0430\u0440\u0441\u043a\u0456\u044f \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u045e\u0441\u0435 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u0430 \u042f\u0433\u043e \u045e\u0441\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e \u043f\u0440\u0430\u0437 \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0430\u0442\u0440\u044d \u043d\u0430\u0448\u044b\u044f \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456 \u0456 \u043a\u0456\u043d\u0435 \u045e \u043c\u0430\u0440\u0441\u043a\u0456\u044f \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u045e\u0441\u0435 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"425","GCH_CH_2_Text":"\r\n<p><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u0425\u0440\u044b\u0437\u0430\u043b\u043e\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 147: PL 52, 594-595)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041b\u044e\u0431\u043e\u045e \u0436\u0430\u0434\u0430\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0430\u0447\u0443\u0447\u044b, \u0448\u0442\u043e \u0441\u0432\u0435\u0442 \u0434\u0440\u044b\u0436\u044b\u0446\u044c \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443, \u0411\u043e\u0433 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435, \u043a\u0430\u0431 \u0437 \u043b\u044e\u0431\u043e\u045e\u044e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u044f\u0433\u043e \u0434\u0430 \u0441\u044f\u0431\u0435, \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u0446\u044c \u043b\u0430\u0441\u043a\u0430\u0439, \u0443\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043b\u044e\u0431\u043e\u045e\u044e \u0456 \u043f\u0440\u044b\u0432\u044f\u0437\u0430\u0446\u044c \u043f\u0430\u0447\u0443\u0446\u0446\u0451\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0401\u043d \u0430\u0431\u043c\u044b\u0432\u0430\u0435 \u0441\u043a\u0430\u043c\u044f\u043d\u0435\u043b\u0443\u044e \u045e \u0433\u0440\u0430\u0445\u0430\u0445 \u0437\u044f\u043c\u043b\u044e \u043f\u0430\u0442\u043e\u043f\u0430\u043c, \u0430 \u041d\u043e\u044f \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0431\u0430\u0446\u044c\u043a\u0430\u043c \u043d\u043e\u0432\u0430\u0433\u0430 \u0432\u0435\u043a\u0443, \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u044f\u0433\u043e \u0437 \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430\u0439 \u043f\u0440\u0430\u043c\u043e\u0432\u0430\u0439 \u0456 \u0433\u043b\u044b\u0431\u043e\u043a\u0456\u043c \u0434\u0430\u0432\u0435\u0440\u0430\u043c, \u043b\u0430\u0433\u043e\u0434\u043d\u0430 \u043f\u0430\u0432\u0443\u0447\u0430\u0435 \u044f\u0433\u043e \u043d\u0430\u043a\u043e\u043d\u0442 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456\u0445 \u0441\u043f\u0440\u0430\u045e \u0456 \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u0435 \u043d\u0430\u043a\u043e\u043d\u0442 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u0456. \u0411\u043e\u0433 \u043d\u0435 \u0437\u0430\u0433\u0430\u0434\u0430\u045e, \u0430\u043b\u0435 \u045e \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u0446\u0442\u0432\u0435 \u0437 \u041d\u043e\u0435\u043c \u0437\u043c\u044f\u0441\u0446\u0456\u045e \u0443 \u043a\u0430\u045e\u0447\u044d\u0433\u0443 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443, \u043a\u0430\u0431 \u043b\u044e\u0431\u043e\u045e \u0433\u044d\u0442\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0430 \u0441\u0442\u0440\u0430\u0445 \u043d\u044f\u0432\u043e\u043b\u0456, \u0456 \u043a\u0430\u0431 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0433\u044d\u0442\u0430\u0439 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u0430 \u0430\u0433\u0443\u043b\u044c\u043d\u044b\u043c \u0432\u044b\u0441\u0456\u043b\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0411\u043e\u0433 \u043a\u043b\u0456\u0447\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u0430\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u043d\u0430\u0434\u0430\u0435 \u044f\u043c\u0443 \u0456\u043c\u044f, \u0440\u043e\u0431\u0456\u0446\u044c \u044f\u0433\u043e \u0430\u0439\u0446\u043e\u043c \u0432\u0435\u0440\u044b, \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u0435 \u044f\u043c\u0443 \u045e \u0448\u043b\u044f\u0445\u0443, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u043c\u0456\u0436 \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u045e, \u0443\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u0435 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u044e, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430\u043c\u0456, \u0437\u0430\u0431\u0430\u0432\u044f\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u043c\u0456, \u0440\u0430\u0442\u0443\u0435 \u0430\u0434 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0456, \u0446\u0435\u0448\u044b\u0446\u044c \u044f\u0433\u043e \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u043d\u043d\u0435\u043c, \u0446\u0443\u0434\u043e\u045e\u043d\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0436\u0432\u0430\u0435 \u043d\u0435\u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u044b\u043c \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u043c. \u041f\u0430\u043d \u0430\u0434\u0430\u0440\u044b\u045e \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u0442\u0430\u043a\u0456\u043c\u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456, \u043a\u0430\u0431 \u0451\u043d, \u043f\u0440\u044b\u0432\u0430\u0431\u043b\u0435\u043d\u044b \u0442\u0430\u043a\u043e\u044e \u0441\u043b\u043e\u0434\u044b\u0447\u0447\u0443 \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u043b\u044e\u0431\u0456\u0446\u044c, \u0430 \u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430 \u0411\u043e\u0433\u0430, \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u042f\u043c\u0443 \u0437 \u043b\u044e\u0431\u043e\u045e\u044e, \u0430 \u043d\u0435 \u0441\u0430 \u0441\u0442\u0440\u0430\u0445\u0430\u043c.&nbsp;<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0411\u043e\u0433 \u0441\u0443\u0446\u044f\u0448\u0430\u0435 \u045e \u0441\u043d\u0430\u0445 \u042f\u043a\u0443\u0431\u0430 \u043f\u0430\u0434\u0447\u0430\u0441 \u044f\u0433\u043e\u043d\u044b\u0445 \u0443\u0446\u0451\u043a\u0430\u045e. \u041a\u0430\u043b\u0456 \u0442\u043e\u0439 \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430, \u043a\u043b\u0456\u0447\u0430 \u044f\u0433\u043e \u0434\u0430 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u044b \u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0456\u043c \u0443 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u043a\u0430\u0431 \u0451\u043d \u043b\u044e\u0431\u0456\u045e \u0410\u0439\u0446\u0430, \u0437 \u044f\u043a\u0456\u043c \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f, \u0430 \u043d\u0435 \u0431\u0430\u044f\u045e\u0441\u044f \u042f\u0433\u043e.&nbsp;<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0411\u043e\u0433 \u043a\u043b\u0456\u0447\u0430 \u041c\u0430\u0439\u0441\u0435\u044f \u0431\u0430\u0446\u044c\u043a\u043e\u045e\u0441\u043a\u0456\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0437 \u0456\u043c \u0437 \u0431\u0430\u0446\u044c\u043a\u043e\u045e\u0441\u043a\u0430\u044e \u043b\u044e\u0431\u043e\u045e\u044e, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u044e\u0447\u044b \u044f\u0433\u043e \u0441\u0442\u0430\u0446\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u0435\u043b\u0435\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451, \u0448\u0442\u043e \u043c\u044b \u0437\u0433\u0430\u0434\u0430\u043b\u0456, \u0437\u0430\u043f\u0430\u043b\u0456\u043b\u0430 \u045e \u043b\u044e\u0434\u0441\u043a\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445 \u043f\u043e\u043b\u044b\u043c\u044f \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430. \u041f\u0430\u0447\u0443\u0446\u0446\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u0430\u043f&rsquo;\u044f\u043d\u0435\u043d\u043d\u0435 \u0430\u0434 \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u0434\u043b\u044f \u0456\u0445 \u043d\u0456\u0431\u044b \u0440\u0430\u043d\u0430\u0439 \u0434\u0443\u0448\u044b, \u0456 \u0442\u0430\u043c\u0443 \u043b\u044e\u0434\u0437\u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0436\u0430 \u0430\u0431\u043c\u0435\u0436\u0430\u0432\u0430\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u043f\u043e\u0437\u0456\u0440\u043a \u043c\u043e\u0436\u0430 \u0430\u0445\u0430\u043f\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435 \u0437\u043c\u0435\u0441\u0446\u0456\u0446\u044c \u0441\u0443\u0441\u0432\u0435\u0442? \u0410\u043b\u0435 \u0437\u0430\u043a\u043e\u043d \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c, \u0448\u0442\u043e \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c. \u041b\u044e\u0431\u043e\u045e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043d\u0430 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u0430 \u0440\u0430\u0437\u043b\u0456\u043a\u0443 \u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043c\u0435\u0440\u044b. \u041b\u044e\u0431\u043e\u045e \u043d\u0435 \u0441\u043f\u044b\u043d\u044f\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u044b\u043c \u0456 \u043d\u0435 \u0441\u043b\u0430\u0431\u043d\u0435 \u043f\u0435\u0440\u0430\u0434 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0431\u043e\u045e, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u0436\u0430\u0434\u0430\u043d\u0430\u0433\u0430, \u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c, \u0456 \u0442\u0430\u043c\u0443 \u0451\u043d \u0456\u0434\u0437\u0435 \u0442\u0443\u0434\u044b, \u043a\u0443\u0434\u044b \u0432\u044f\u0434\u0437\u0435 \u044f\u0433\u043e \u043b\u044e\u0431\u043e\u045e, \u0430 \u043d\u0435 \u0442\u0443\u0434\u044b, \u043a\u0443\u0434\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d. \u041b\u044e\u0431\u043e\u045e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u0440\u0430\u0437\u0433\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u0430\u0433\u043d\u0451\u043c, \u043f\u043e\u043b\u044b\u043c\u044f \u044f\u043a\u043e\u0433\u0430 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0447\u044b\u043c \u044f\u0448\u0447\u044d \u043d\u0435 \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u043b\u0430. \u0428\u0442\u043e \u0436 \u044f\u0448\u0447\u044d \u0434\u0430\u0434\u0430\u0446\u044c?&nbsp;<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0431\u043e\u045e \u043d\u0435 \u043c\u043e\u0436\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c. \u0422\u0430\u043c\u0443 \u0441\u0432\u044f\u0442\u044b\u044f \u043b\u0456\u0447\u044b\u043b\u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0432\u0430\u0440\u0442\u044b\u043c \u0443\u0441\u0435 \u0441\u0432\u0430\u0435 \u0437\u0430\u0441\u043b\u0443\u0433\u0456, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456 \u041f\u0430\u043d\u0430.&nbsp;<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0430\u044f \u043f\u0440\u0430\u0433\u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430, \u0445\u043e\u0446\u044c \u0456 \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u0435, \u0430\u0434\u043d\u0430\u043a \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430.&nbsp;<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u041c\u0430\u0439\u0441\u0435\u0439 \u0430\u0434\u0432\u0430\u0436\u044b\u045e\u0441\u044f \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u041a\u0430\u043b\u0456 \u044f \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u043b\u0430\u0441\u043a\u0443 \u045e \u0432\u0430\u0447\u0430\u0445 \u0422\u0432\u0430\u0456\u0445, \u043f\u0430\u043a\u0430\u0436\u044b \u043c\u043d\u0435 \u0422\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430&raquo; (\u043f\u0430\u0440. \u0417\u044b\u0445 33, 13).&nbsp;<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u044f\u0448\u0447\u044d \u0456\u043d\u0448\u044b \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u043a\u0430\u0436\u044b \u0441\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430&raquo; (\u043f\u0430\u0440. \u041f\u0441 80 [79], 4). \u041d\u0430\u0440\u044d\u0448\u0446\u0435 \u0456 \u0441\u0430\u043c\u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456, \u0445\u043e\u0446\u044c \u0456 \u043f\u0430\u043c\u044b\u043b\u043a\u043e\u0432\u0430, \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0440\u0430\u0431\u0456\u043b\u0456 \u0456\u0434\u0430\u043b\u0430\u045e, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u0442\u043e\u0435, \u0447\u0430\u043c\u0443 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f.<\/p>\r\n<p><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 66, 13; 1 \u0412\u0430\u043b 11, 36; \u0406\u0441 66, 14; 46, 13<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u043c\u0430\u0446\u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0435 \u0441\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u0442\u0430\u043a \u042f \u0441\u0443\u0446\u0435\u0448\u0443 \u0432\u0430\u0441, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u0406 \u0437 \u0433\u043e\u0440\u0430\u0434\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u044f\u043a\u0456 \u042f \u0432\u044b\u0431\u0440\u0430\u045e, \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u0432\u0430\u0441 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430.<span style=\"color: #ff0000;\"> *<\/span> \u0406 \u045e\u0431\u0430\u0447\u044b\u0446\u0435 \u044f\u0435, \u0456 \u045e\u0437\u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0432\u0430\u0448\u0430 \u0441\u044d\u0440\u0446\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430 \u0421\u0456\u0451\u043d\u0435 \u042f \u0434\u0430\u043c \u0441\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435 &ndash; \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u045e\u0431\u0430\u0447\u044b\u0446\u0435 \u044f\u0435, \u0456 \u045e\u0437\u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0432\u0430\u0448\u0430 \u0441\u044d\u0440\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"426","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u044f\u045e&raquo; \u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 5, 19, 1; 20, 2; 21, 1: SCh 153, 248-250. 260-264)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0415\u0432\u0430 \u0456 \u041c\u0430\u0440\u044b\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0441\u0432\u0430\u0451\u0439 \u0443\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u0456, \u0456 \u044f\u043d\u0430 \u043d\u0430\u0441\u0456\u043b\u0430 \u042f\u0433\u043e, \u0445\u043e\u0446\u044c \u0401\u043d \u0441\u0430\u043c \u0431\u044b\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u044f\u0435 \u043d\u043e\u0441\u0456\u0446\u044c. \u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c, \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u0443\u044e \u043d\u0430 \u0434\u0440\u044d\u0432\u0435 \u043a\u0440\u044b\u0436\u0430, \u041f\u0430\u043d \u0432\u044b\u043f\u0440\u0430\u0432\u0456\u045e \u0434\u0430\u045e\u043d\u044e\u044e \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c, \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u0443\u044e \u043a\u0430\u043b\u044f \u0434\u0440\u044d\u0432\u0430 \u045e \u0440\u0430\u0456. \u041f\u0440\u0430\u0437 \u0442\u0443\u044e \u043f\u0440\u0430\u045e\u0434\u0443, \u044f\u043a\u0443\u044e \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0431\u0440\u0430 \u0430\u043d\u0451\u043b \u0437\u0432\u0435\u0441\u0442\u0430\u0432\u0430\u045e \u0443\u0436\u043e \u0437\u0430\u0440\u0443\u0447\u0430\u043d\u0430\u0439 \u0414\u0437\u0435\u0432\u0435 \u041c\u0430\u0440\u044b\u0456, \u041f\u0430\u043d \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u045e \u0442\u043e\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430, \u044f\u043a\u043e\u043c\u0443 \u0434\u0437\u0435\u043b\u044f \u0437\u043b\u0430 \u043f\u0430\u0434\u0434\u0430\u043b\u0430\u0441\u044f \u0415\u0432\u0430, \u044f\u043a\u0430\u044f \u0431\u044b\u043b\u0430 \u0434\u0437\u0435\u0432\u0430\u0439, \u0443\u0436\u043e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430\u0439 \u0434\u043b\u044f \u043c\u0443\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0432\u0430 \u0431\u044b\u043b\u0430 \u0437\u0432\u0435\u0434\u0437\u0435\u043d\u0430 \u043c\u043e\u0432\u0430\u0439 \u0430\u043d\u0451\u043b\u0430, \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u043b\u0430\u0441\u044f \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u043f\u0430\u0439\u0448\u043b\u0430 \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u042f\u0433\u043e\u043d\u0430\u043c\u0443 \u0441\u043b\u043e\u0432\u0443. \u041c\u0430\u0440\u044b\u0456 \u0436 \u0431\u044b\u043b\u043e \u0437\u0432\u0435\u0441\u0442\u0430\u0432\u0430\u043d\u0430 \u043f\u0440\u0430\u0437 \u043c\u043e\u0432\u0443 \u0430\u043d\u0451\u043b\u0430, \u0456 \u044f\u043d\u0430 \u0437\u0430\u0447\u0430\u043b\u0430 \u0411\u043e\u0433\u0430, \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u044f \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u0443. \u041f\u0435\u0440\u0448\u0430\u044f \u0431\u044b\u043b\u0430 \u0441\u0445\u0456\u043b\u0435\u043d\u0430 \u0434\u0430 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u0411\u043e\u0433\u0443, \u0430 \u0434\u0440\u0443\u0433\u0430\u044f &ndash; \u0434\u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u042f\u043c\u0443. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0414\u0437\u0435\u0432\u0430 \u041c\u0430\u0440\u044b\u044f \u0441\u0442\u0430\u043b\u0430 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0430\u0439 \u0434\u0437\u0435\u0432\u044b \u0415\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u0431\u0440\u0430\u045e\u0448\u044b \u045e \u0441\u0430\u0431\u0435 \u045e\u0441\u0451, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0442\u0430\u045e \u043d\u0430\u0447\u0430\u043b\u0435 \u045e\u0441\u044f\u0433\u043e \u0456 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0432\u0430\u0439\u043d\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0432\u043e\u0440\u0430\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0456 \u0440\u0430\u0437\u0431\u0456\u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0440\u0430\u0437 \u0410\u0434\u0430\u043c\u0430 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u045e\u0437\u044f\u045e \u043d\u0430\u0441 \u0443 \u043d\u044f\u0432\u043e\u043b\u044e, \u0456 \u0440\u0430\u0441\u0442\u0440\u0443\u0448\u0447\u044b\u045e \u044f\u043c\u0443 \u0433\u0430\u043b\u0430\u0432\u0443. \u0413\u044d\u0442\u0430\u043a \u0456 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u043a\u043d\u0456\u0437\u0435 \u0411\u044b\u0446\u0446\u044f, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0441\u043a\u0430\u0437\u0430\u045e \u0437\u043c\u0435\u044e: &laquo;\u0423\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0432\u0430\u0440\u043e\u0436\u0430\u0441\u0446\u044c \u043f\u0430\u043c\u0456\u0436 \u0442\u0430\u0431\u043e\u044e \u0456 \u043f\u0430\u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u044e, \u0456 \u043f\u0430\u043c\u0456\u0436 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0456 \u043f\u0430\u043c\u0456\u0436 \u044f\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430\u043c. \u0401\u043d \u0440\u0430\u0441\u0442\u0440\u0443\u0448\u0447\u044b\u0446\u044c \u0442\u0430\u0431\u0435 \u0433\u0430\u043b\u0430\u0432\u0443, \u0430 \u0442\u044b \u0440\u0430\u0441\u0442\u0440\u0443\u0448\u0447\u044b\u0448 \u044f\u0433\u043e \u043f\u044f\u0442\u0443&raquo; (\u043f\u0430\u0440. \u0411\u044b\u0446 3, 15).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u0430, \u0448\u0442\u043e \u0437 \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u0414\u0437\u0435\u0432\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u043d\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0410\u0434\u0430\u043c\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0440\u0430\u0441\u0442\u0440\u0443\u0448\u0447\u044b\u0446\u044c \u0433\u0430\u043b\u0430\u0432\u0443 \u0437\u043c\u0435\u044f. \u0406 \u0433\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u0442\u043e\u0439 \u043d\u0430\u0448\u0447\u0430\u0434\u0430\u043a, \u043f\u0440\u0430 \u044f\u043a\u043e\u0433\u0430 \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0443 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u0434\u0430 \u0413\u0430\u043b\u0430\u0442\u0430\u045e: &laquo;\u0417\u0430\u043a\u043e\u043d \u0431\u044b\u045e \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430\u045e, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043d\u0430\u0448\u0447\u0430\u0434\u0430\u043a, \u044f\u043a\u043e\u043c\u0443 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435&raquo; (\u043f\u0430\u0440. \u0413\u0430\u043b 3, 19).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u043b\u044c\u0448 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0433\u044d\u0442\u0430 \u045e \u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041a\u0430\u043b\u0456 \u043d\u0430\u0434\u044b\u0448\u043b\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0447\u0430\u0441\u0443, \u043f\u0430\u0441\u043b\u0430\u045e \u0411\u043e\u0433 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d\u044b&raquo; (\u0413\u0430\u043b 4, 4). \u0412\u043e\u0440\u0430\u0433 \u043d\u0435 \u0431\u044b\u045e \u0431\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043d\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u043a\u0430\u043b\u0456 \u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u044f\u0433\u043e \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430, \u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u0431\u043e \u045e \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0432\u043e\u0440\u0430\u0433 \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u045e \u043d\u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u043f\u0440\u0430\u0437 \u0436\u0430\u043d\u0447\u044b\u043d\u0443, \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e\u0448\u044b \u0441\u044f\u0431\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u041f\u0430\u043d \u0456 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0421\u044b\u043d\u0430\u043c \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c, \u0437\u043c\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u045e \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435 \u0442\u0430\u0433\u043e \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0437 \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u0430 \u0430\u0434 \u044f\u0435 &ndash; \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430. \u042f\u043a \u043f\u0440\u0430\u0437 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043d\u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u043d\u0430\u0448 \u0440\u043e\u0434 \u0441\u044b\u0448\u043e\u045e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u0442\u0430\u043a \u0437\u043d\u043e\u045e \u043f\u0440\u0430\u0437 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043c\u044b \u045e\u0437\u044b\u0434\u0437\u0435\u043c \u0434\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041b\u043a 1, 26. 27. 30. 31. 32<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u0430\u043d\u0451\u043b\u0430 \u0413\u0430\u0431\u0440\u044b\u044d\u043b\u044f \u0434\u0430 \u0414\u0437\u0435\u0432\u044b, \u0437\u0430\u0440\u0443\u0447\u0430\u043d\u0430\u0439 \u0437 \u043c\u0443\u0436\u0430\u043c \u043f\u0430 \u0456\u043c\u0435\u043d\u0456 \u042e\u0437\u0430\u0444, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u0451\u0439 \u0441\u043b\u043e\u0432\u0430; <span style=\"color: #ff0000;\">\/<\/span> \u0456 \u0437\u0431\u044f\u043d\u0442\u044d\u0436\u044b\u043b\u0430\u0441\u044f \u0414\u0437\u0435\u0432\u0430 \u0430\u0434 \u0441\u0432\u044f\u0442\u043b\u0430. <span style=\"color: #ff0000;\">\/<\/span> \u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u041c\u0430\u0440\u044b\u044f, <span style=\"color: #ff0000;\">\/<\/span> \u0431\u043e \u0422\u044b \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u043b\u0430\u0441\u043a\u0443 \u045e \u041f\u0430\u043d\u0430.<span style=\"color: #ff0000;\"> *<\/span> \u0412\u043e\u0441\u044c \u0437\u0430\u0447\u043d\u0435\u0448 \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0421\u044b\u043d\u0430, <span style=\"color: #ff0000;\">\/<\/span> \u0456 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u042f\u0433\u043e \u0421\u044b\u043d\u0430\u043c \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0411\u043e\u0433 \u0434\u0430\u0441\u0446\u044c \u042f\u043c\u0443 \u0442\u0440\u043e\u043d \u0414\u0430\u0432\u0456\u0434\u0430, \u0431\u0430\u0446\u044c\u043a\u0456 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0434 \u0434\u043e\u043c\u0430\u043c \u042f\u043a\u0443\u0431\u0430 \u0432\u0435\u0447\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0437\u0430\u0447\u043d\u0435\u0448 \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0421\u044b\u043d\u0430, <span style=\"color: #ff0000;\">\/<\/span> \u0456 \u043d\u0430\u0437\u0430\u0432\u0443\u0446\u044c \u042f\u0433\u043e \u0421\u044b\u043d\u0430\u043c \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"427","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0431\u043b. \u0406\u0441\u0430\u0430\u043a\u0430, \u0430\u0431\u0430\u0442\u0430 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u0430 \u0421\u0442\u044d\u043b\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 51: PL 194, 1862-1863. 1865)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u0430\u0440\u044b\u044f \u0456 \u041a\u0430\u0441\u0446\u0451\u043b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044b\u043d \u0411\u043e\u0436\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u0441\u044f\u0440\u043e\u0434 \u043c\u043d\u043e\u0433\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e. \u0411\u0443\u0434\u0443\u0447\u044b \u043f\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0430\u0434\u0437\u0456\u043d\u044b\u043c, \u0401\u043d \u043b\u0430\u0441\u043a\u0430\u044e \u0437&rsquo;\u044f\u0434\u043d\u0430\u045e \u0437 \u0441\u0430\u0431\u043e\u044e \u043c\u043d\u043e\u0433\u0456\u0445, \u044f\u043a\u0456\u044f \u0441\u043a\u043b\u0430\u0434\u0430\u044e\u0446\u044c \u0437 \u0406\u043c \u0430\u0434\u043d\u043e. \u0422\u044b\u043c, \u0445\u0442\u043e \u042f\u0433\u043e \u043f\u0440\u044b\u043c\u0430\u0435, &laquo;\u0434\u0430\u045e \u0443\u043b\u0430\u0434\u0443 \u0441\u0442\u0430\u0446\u044c \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456&raquo; (\u042f\u043d 1, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u045e\u0448\u044b \u0421\u044b\u043d\u0430\u043c \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c, \u0401\u043d \u043c\u043d\u043e\u0433\u0456\u0445 \u0443\u0447\u044b\u043d\u0456\u045e \u0441\u044b\u043d\u0430\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456. \u0411\u043e \u043c\u043d\u043e\u0433\u0456\u0445 \u0437&rsquo;\u044f\u0434\u043d\u0430\u045e \u0437 \u0441\u0430\u0431\u043e\u044e \u044f\u043a \u0430\u0434\u0437\u0456\u043d\u044b \u045e \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u045e\u043b\u0430\u0434\u0437\u0435. \u0425\u043e\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0448\u043c\u0430\u0442, \u0430\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0430\u0434 \u0411\u043e\u0433\u0430 \u044f\u043d\u044b &ndash; \u0430\u0434\u043d\u043e \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u0437\u0456\u043d, \u0446\u044d\u043b\u044b \u0456 \u0430\u0434\u0437\u0456\u043d\u044b, \u0433\u0430\u043b\u0430\u0432\u0430 \u0456 \u0446\u0435\u043b\u0430. \u0410\u0434\u0437\u0456\u043d\u044b \u0421\u044b\u043d \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445 \u0456 \u0430\u0434\u0437\u0456\u043d\u0430\u0439 \u041c\u0430\u0446\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0425\u043e\u0446\u044c \u0451\u0441\u0446\u044c \u0448\u043c\u0430\u0442 \u0441\u044b\u043d\u043e\u045e, \u0430\u043b\u0435 \u0421\u044b\u043d \u0430\u0434\u0437\u0456\u043d. \u0411\u043e \u0442\u0430\u043a \u044f\u043a \u0433\u0430\u043b\u0430\u0432\u0430 \u0456 \u0446\u0435\u043b\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0430\u0434\u0437\u0456\u043d \u0421\u044b\u043d \u0456 \u043c\u043d\u043e\u0433\u0456\u044f \u0441\u044b\u043d\u044b, \u0442\u0430\u043a \u041c\u0430\u0440\u044b\u044f \u0456 \u041a\u0430\u0441\u0446\u0451\u043b &ndash; \u0430\u0434\u043d\u0430 \u041c\u0430\u0446\u0456 \u0456 \u043c\u043d\u043e\u0433\u0456\u044f, \u0430\u0434\u043d\u0430 \u0414\u0437\u0435\u0432\u0430 \u0456 \u043c\u043d\u043e\u0433\u0456\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u0435\u0434\u0437\u0432\u0435 \u041c\u0430\u0446\u0456 &ndash; \u041c\u0430\u0440\u044b\u044f \u0456 \u041a\u0430\u0441\u0446\u0451\u043b, \u0430\u0431\u0435\u0434\u0437\u0432\u0435 &ndash; \u0414\u0437\u0435\u0432\u044b; \u0430\u0431\u0435\u0434\u0437\u0432\u0435 \u0431\u0435\u0437 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0437\u0430\u0447\u0430\u043b\u0456 \u0430\u0434 \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0414\u0443\u0445\u0430; \u0430\u0431\u0435\u0434\u0437\u0432\u0435 \u0431\u0435\u0437 \u0433\u0440\u0430\u0445\u0443 \u0434\u0430\u044e\u0446\u044c \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u045e \u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443. \u041c\u0430\u0440\u044b\u044f \u0431\u0435\u0437 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0434\u043b\u044f \u0446\u0435\u043b\u0430 \u0413\u0430\u043b\u0430\u0432\u0443, \u041a\u0430\u0441\u0446\u0451\u043b \u043f\u0440\u0430\u0437 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u0434\u043b\u044f \u0413\u0430\u043b\u0430\u0432\u044b \u0446\u0435\u043b\u0430. \u0422\u0430\u043a, \u0430\u0431\u0435\u0434\u0437\u0432\u0435 &ndash; \u0433\u044d\u0442\u0430 \u041c\u0430\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u043b\u0435 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u044f \u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u045e\u0441\u044f\u0433\u043e \u0430\u0434\u043d\u0430 \u0431\u0435\u0437 \u0430\u0434\u043d\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0456 \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0443\u0432\u043e\u0433\u0443\u043b\u0435 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u044f\u043a \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0446\u0456, \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0430\u0441\u043e\u0431\u043d\u0430 \u0456 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456; \u0448\u0442\u043e \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0430\u0441\u043e\u0431\u043d\u0430 \u0434\u0430 \u041c\u0430\u0440\u044b\u0456 \u044f\u043a \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0446\u0456, \u0442\u043e\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0456 \u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u044f\u043a \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0446\u0456 \u045e\u0432\u043e\u0433\u0443\u043b\u0435. \u0406 \u043a\u0430\u043b\u0456 \u0433\u0430\u0432\u043e\u0440\u043a\u0430 \u0432\u044f\u0434\u0437\u0435\u0446\u0446\u0430 \u043f\u0440\u0430 \u0430\u0434\u043d\u0443, \u0430\u043c\u0430\u043b\u044c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0446\u0446\u0430 \u0456 \u0434\u0440\u0443\u0433\u0430\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043a\u043e\u0436\u043d\u0430\u044f \u0432\u0435\u0440\u043d\u0430\u044f \u0434\u0443\u0448\u0430 \u043c\u043e\u0436\u0430 \u043d\u0435\u0439\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0443\u0432\u0430\u0441\u0430\u0431\u043b\u044f\u0446\u044c \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0443 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u043b\u043e\u0432\u0430, \u041c\u0430\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u0434\u0430\u0447\u043a\u0443 \u0456 \u0441\u044f\u0441\u0442\u0440\u0443, \u0434\u0437\u0435\u0432\u0443 \u0456 \u0446\u044f\u0436\u0430\u0440\u043d\u0443\u044e. \u0422\u0430\u043c\u0443 \u0441\u0430\u043c\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0430\u044f, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0421\u043b\u043e\u0432\u0430 \u0410\u0439\u0446\u0430, \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0442\u0430\u043a \u0443\u0432\u043e\u0433\u0443\u043b\u0435 \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043f\u0440\u0430 \u041c\u0430\u0440\u044b\u044e \u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430 \u0432\u0435\u0440\u043d\u0443\u044e \u0434\u0443\u0448\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0441\u044e\u043b\u044c \u0456 \u0432\u044b\u043d\u0456\u043a\u0430\u0435: &laquo;\u042f \u043f\u0430\u0441\u044f\u043b\u044e\u0441\u044f \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0435 \u041f\u0430\u043d\u0430&raquo; (\u043f\u0430\u0440. \u0421\u0456\u0440 24, 12). \u0411\u043e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430 \u041f\u0430\u043d\u0430 &ndash; \u0433\u044d\u0442\u0430 \u045e\u0432\u043e\u0433\u0443\u043b\u0435 \u041a\u0430\u0441\u0446\u0451\u043b, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 &ndash; \u041c\u0430\u0440\u044b\u044f, \u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u043e\u0436\u043d\u0430\u044f \u0432\u0435\u0440\u043d\u0430\u044f \u0434\u0443\u0448\u0430. \u0423 \u0448\u0430\u0442\u0440\u044b \u045e\u043b\u043e\u043d\u043d\u044f \u041c\u0430\u0440\u044b\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u043d\u0430 \u0434\u0437\u0435\u0432\u044f\u0446\u044c \u043c\u0435\u0441\u044f\u0446\u0430\u045e; \u0443 \u0448\u0430\u0442\u0440\u044b \u0432\u0435\u0440\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430 &ndash; \u0430\u0436 \u0434\u0430 \u0441\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u044f \u0432\u0435\u043a\u0443; \u0430 \u045e \u0432\u0435\u0440\u043d\u0430\u0439 \u0434\u0443\u0448\u044b, \u044f\u043a\u0430\u044f \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0456 \u043b\u044e\u0431\u0456\u0446\u044c, \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u0435\u0432 26, 11-12; 2 \u041a\u0430\u0440 6, 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044e \u0441\u0432\u043e\u0439 \u0448\u0430\u0446\u0451\u0440 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043c\u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0446\u044c \u043c\u0430\u044f \u0434\u0443\u0448\u0430. <span style=\"color: #ff0000;\">*<\/span> \u042f \u0431\u0443\u0434\u0443 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0456 \u0431\u0443\u0434\u0443 \u0432\u0430\u0448\u044b\u043c \u0411\u043e\u0433\u0430\u043c, \u0456 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0431\u0443\u0434\u0443 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0456 \u0431\u0443\u0434\u0443 \u0432\u0430\u0448\u044b\u043c \u0411\u043e\u0433\u0430\u043c, \u0456 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"431","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 293, 3: PL 38, 1328-1329)<\/span><br \/><em><span style=\"color: #ff0000;\">\u042f\u043d &ndash; \u0433\u044d\u0442\u0430 \u0433\u043e\u043b\u0430\u0441, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0421\u043b\u043e\u0432\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d &ndash; \u0433\u044d\u0442\u0430 \u0433\u043e\u043b\u0430\u0441, \u0430\u043b\u0435 &laquo;\u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430&raquo; (\u042f\u043d 1, 1) &ndash; \u041f\u0430\u043d. \u042f\u043d \u0431\u044b\u045e \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u043d\u0430 \u043f\u044d\u045e\u043d\u044b \u0447\u0430\u0441, \u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0430\u0434\u0432\u0435\u0447\u043d\u044b\u043c \u0421\u043b\u043e\u0432\u0430\u043c, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0437\u0430\u0431\u044f\u0440\u044d\u0448 \u0441\u043b\u043e\u0432\u0430, \u0447\u044b\u043c \u0431\u0443\u0434\u0437\u0435 \u0433\u043e\u043b\u0430\u0441? \u0411\u0443\u0434\u0437\u0435 \u043f\u0443\u0441\u0442\u044b\u043c \u0433\u0443\u043a\u0430\u043c, \u044f\u043a\u0456 \u043d\u0435 \u043c\u0430\u0435 \u0441\u044d\u043d\u0441\u0443. \u0413\u043e\u043b\u0430\u0441 \u0431\u0435\u0437 \u0441\u043b\u043e\u0432\u0430 \u0433\u0443\u0447\u044b\u0446\u044c \u0443 \u0432\u0443\u0448\u0430\u0445, \u0430\u043b\u0435 \u043d\u0435 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u043c, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430? \u041a\u0430\u043b\u0456 \u044f \u0434\u0443\u043c\u0430\u044e \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0433\u0430\u0432\u0430\u0440\u0443, \u0441\u043b\u043e\u0432\u0430 \u045e\u0436\u043e \u0451\u0441\u0446\u044c \u0443 \u043c\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b, \u0430\u043b\u0435 \u043a\u0430\u043b\u0456 \u044f \u0445\u0430\u0447\u0443 \u043d\u0435\u0448\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u0431\u0435, \u0456\u043c\u043a\u043d\u0443\u0441\u044f, \u043a\u0430\u0431 \u0443 \u0442\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u0431\u044b\u043b\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0436\u043e \u0451\u0441\u0446\u044c \u0443 \u043c\u0430\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0443\u043a\u0430\u044e\u0447\u044b \u0441\u043f\u043e\u0441\u0430\u0431\u0443 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u0442\u0430\u0431\u0435 \u0456 \u045e\u043a\u043b\u0430\u0441\u0446\u0456 \u045e \u0442\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0436\u043e \u0451\u0441\u0446\u044c \u0443 \u043c\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b, \u044f \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u044e \u0433\u043e\u043b\u0430\u0441 \u0456 \u0433\u0430\u0432\u0430\u0440\u0443 \u0442\u0430\u0431\u0435. \u0413\u0443\u0447\u0430\u043d\u043d\u0435 \u0433\u043e\u043b\u0430\u0441\u0443 \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u0434\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0441\u043b\u043e\u0432\u0430. \u0406 \u043a\u0430\u043b\u0456 \u0433\u0443\u0447\u0430\u043d\u043d\u0435 \u0433\u043e\u043b\u0430\u0441\u0443 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0442\u0430\u0431\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 \u0441\u043b\u043e\u0432\u0430, \u0441\u0430\u043c \u0433\u0443\u043a \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0430 \u0441\u043b\u043e\u0432\u0430, \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u0430\u0435 \u0433\u0443\u043a\u0430\u043c, \u0443\u0436\u043e \u0451\u0441\u0446\u044c \u0443 \u0442\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u043c\u0430\u0439\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043c\u043e\u0436\u0430 \u0442\u0430\u0431\u0435 \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u0433\u0443\u043a, \u043f\u0435\u0440\u0430\u0434\u0430\u045e\u0448\u044b \u0442\u0430\u0431\u0435 \u0441\u043b\u043e\u0432\u0430, \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0441\u0430\u043c \u043f\u0440\u0430\u0437 \u0441\u044f\u0431\u0435: &laquo;\u042f\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c, \u0430 \u043c\u043d\u0435 \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u0446\u0446\u0430 \u043c\u0435\u043d\u0448\u044b\u043c?&raquo; (\u042f\u043d 3, 30) \u0413\u0443\u0447\u0430\u043d\u043d\u0435 \u0433\u043e\u043b\u0430\u0441\u0443 \u0432\u044b\u043a\u0430\u043d\u0430\u043b\u0430 \u0441\u0432\u0430\u0451 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0456 \u0430\u0434\u044b\u0448\u043b\u043e, \u044f\u043a \u0431\u044b \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0412\u043e\u0441\u044c \u0433\u044d\u0442\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043c\u0430\u044f \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f&raquo; (\u042f\u043d 3, 29). \u0411\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u0430, \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435\u043c \u0441\u043b\u043e\u0432\u0430, \u0437\u0430\u0447\u0430\u0442\u0430\u0433\u0430 \u045e \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043c\u043e\u0436\u0430 \u0434\u0443\u043c\u0430\u0435\u0448, \u0448\u0442\u043e \u0433\u043e\u043b\u0430\u0441 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0430 \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430? \u0414\u0437\u0435 \u0446\u044f\u043f\u0435\u0440 \u0445\u0440\u043e\u0441\u0442 \u042f\u043d\u0430? \u042f\u043d \u0443\u0434\u0437\u044f\u043b\u0456\u045e \u044f\u0433\u043e \u0456 \u0430\u0434\u044b\u0448\u043e\u045e, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0445\u0440\u043e\u0441\u0442 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b. \u0423\u0441\u0435 \u043c\u044b \u0432\u0435\u0440\u044b\u043c \u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u043f\u0430\u0434\u0437\u044f\u0451\u043c\u0441\u044f \u043d\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 &ndash; \u0433\u044d\u0442\u0430 \u043d\u0430\u043c \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u045e \u0433\u043e\u043b\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u0436\u043a\u0430 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0446\u044c \u0441\u043b\u043e\u0432\u0430 \u0430\u0434 \u0433\u043e\u043b\u0430\u0441\u0443, \u0442\u0430\u043c\u0443 \u0456 \u0441\u0430\u043c\u043e\u0433\u0430 \u042f\u043d\u0430 \u043b\u0456\u0447\u044b\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u0413\u043e\u043b\u0430\u0441 \u043f\u0430\u043b\u0456\u0447\u044b\u043b\u0456 \u0441\u043b\u043e\u0432\u0430\u043c, \u0430\u043b\u0435 \u0433\u043e\u043b\u0430\u0441 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u043f\u0440\u0430 \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u043b\u043e\u0432\u0443. \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u043d\u0435 \u041c\u0435\u0441\u0456\u044f, \u0456 \u043d\u0435 \u0406\u043b\u043b\u044f, \u0456 \u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u043a&raquo;. \u0422\u0430\u0434\u044b \u045e \u044f\u0433\u043e \u0441\u043f\u044b\u0442\u0430\u043b\u0456\u0441\u044f \u045e \u0430\u0434\u043a\u0430\u0437: &laquo;\u0414\u044b\u043a \u0445\u0442\u043e \u0436 \u0442\u044b?&raquo; \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u0433\u043e\u043b\u0430\u0441 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u043b\u0456\u0447\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456: &ldquo;\u0420\u0430\u045e\u043d\u044f\u0439\u0446\u0435 \u0434\u0430\u0440\u043e\u0433\u0443 \u041f\u0430\u043d\u0443&rdquo;&raquo;. \u0413\u043e\u043b\u0430\u0441 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u043b\u0456\u0447\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456 (\u043f\u0430\u0440. \u042f\u043d 1, 20-23), \u0433\u043e\u043b\u0430\u0441, \u044f\u043a\u0456 \u0440\u0430\u0437\u0440\u044b\u0432\u0430\u0435 \u0446\u0456\u0448\u044b\u043d\u044e. &laquo;\u0420\u0430\u045e\u043d\u044f\u0439\u0446\u0435 \u0434\u0430\u0440\u043e\u0433\u0443 \u041f\u0430\u043d\u0443&raquo; &ndash; \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u044f \u0433\u0443\u0447\u0443 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u041f\u0430\u043d\u0430 \u045e \u0432\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b, \u0430\u043b\u0435 \u0401\u043d \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0435 \u042f\u043c\u0443 \u0434\u0430\u0440\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0436 \u0437\u043d\u0430\u0447\u044b\u0446\u044c &laquo;\u0440\u0430\u045e\u043d\u044f\u0439\u0446\u0435 \u0434\u0430\u0440\u043e\u0433\u0443&raquo;, \u044f\u043a \u043d\u0435 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430? \u0428\u0442\u043e \u0436 \u0437\u043d\u0430\u0447\u044b\u0446\u044c &laquo;\u0440\u0430\u045e\u043d\u044f\u0439\u0446\u0435 \u0434\u0430\u0440\u043e\u0433\u0443&raquo;, \u044f\u043a \u043d\u0435 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c? \u0410\u0434 \u0441\u0430\u043c\u043e\u0433\u0430 \u042f\u043d\u0430 \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044f \u0432\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u043f\u0430\u043a\u043e\u0440\u044b. \u042f\u0433\u043e \u043b\u0456\u0447\u044b\u043b\u0456 \u041c\u0435\u0441\u0456\u044f\u0439, \u0430\u043b\u0435 \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u044b\u043c, \u043a\u0456\u043c \u044f\u0433\u043e \u043b\u0456\u0447\u0430\u0446\u044c, \u0456 \u043d\u0435 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u045e \u043f\u0430\u043c\u044b\u043b\u043a\u0443 \u0456\u043d\u0448\u044b\u0445 \u0434\u043b\u044f \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u044d\u043d\u043d\u044f \u0441\u0432\u0430\u0451\u0439 \u0432\u0430\u0436\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0431 \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u0425\u0440\u044b\u0441\u0442\u0443\u0441&raquo;, \u044f\u043a \u0431\u044b \u043b\u0451\u0433\u043a\u0430 \u044f\u043c\u0443 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456, \u0431\u043e \u045e \u0433\u044d\u0442\u0430 \u0432\u0435\u0440\u044b\u043b\u0456 \u044f\u0448\u0447\u044d \u0434\u0430 \u0442\u0430\u0433\u043e, \u044f\u043a \u0451\u043d \u0430\u0434\u043c\u043e\u0432\u0456\u045e\u0441\u044f, \u043a\u0430\u0436\u0443\u0447\u044b, \u043a\u0456\u043c \u0451\u0441\u0446\u044c, \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e\u0441\u044f \u0456 \u043d\u0435 \u0440\u0430\u045e\u043d\u0430\u045e\u0441\u044f \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. <br \/>\u042f\u043d \u0431\u0430\u0447\u044b\u045e, \u0430\u0434\u043a\u0443\u043b\u044c \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0401\u043d \u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u0448\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0432\u0435\u0442\u0430\u0447\u0430\u043c, \u0456 \u0431\u0430\u044f\u045e\u0441\u044f, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0433\u0430\u0441\u0456\u0446\u044c \u044f\u0433\u043e \u043f\u043e\u0434\u044b\u0445\u0430\u043c \u043f\u044b\u0445\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042f\u043d 3, 30; 1, 27; \u041c\u043a 1, 8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c, \u0430 \u043c\u043d\u0435 \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u0446\u0446\u0430 \u043c\u0435\u043d\u0448\u044b\u043c. \u0422\u043e\u0439, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u0437\u0430 \u043c\u043d\u043e\u044e, \u0431\u044b\u045e \u0440\u0430\u043d\u0435\u0439 \u0437\u0430 \u043c\u044f\u043d\u0435.<span style=\"color: #ff0000;\"> *<\/span> \u042f \u043d\u0435 \u0432\u0430\u0440\u0442\u044b \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u0446\u044c \u042f\u043c\u0443 \u0441\u0430\u043d\u0434\u0430\u043b\u044f\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0445\u0440\u044b\u0441\u0446\u0456\u045e \u0432\u0430\u0441 \u0432\u0430\u0434\u043e\u044e, \u0430 \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c \u0432\u0430\u0441 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043d\u0435 \u0432\u0430\u0440\u0442\u044b \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u0446\u044c \u042f\u043c\u0443 \u0441\u0430\u043d\u0434\u0430\u043b\u044f\u045e.<\/p>\r\n"}, {"GCH_CH_2_ID":"432","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430&raquo; \u0412\u0456\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u0430, \u0430\u0431\u0430\u0442\u0430 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u0430 \u0441\u0432. \u0422\u044d\u0430\u0434\u043e\u0440\u044b\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 9-11: SCh 61, 90-96)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0401\u043d \u043f\u0435\u0440\u0448\u044b\u043c \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u043b\u044c\u043a\u0456 \u0422\u044b \u0451\u0441\u0446\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0411\u043e\u0433\u0430\u043c, \u0430 \u0422\u0432\u0430\u0451 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456 &ndash; \u0433\u044d\u0442\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435. \u0410 \u043d\u0430\u0448\u0430\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0422\u0430\u0431\u0435 &ndash; \u0433\u044d\u0442\u0430 \u043d\u0435 \u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u044f\u043a \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0435 \u0430\u0434 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u041f\u0430\u043d\u0435, \u0430\u0434 \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0447\u044b\u043c \u0451\u0441\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0422\u0432\u0430\u0451 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0443 \u0422\u0432\u0430\u0439\u0433\u043e, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u044b\u043c, \u0448\u0442\u043e \u0422\u044b \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u043d\u0430\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u0426\u044f\u0431\u0435, \u0456 \u0442\u044b\u043c, \u0448\u0442\u043e \u0422\u044b \u043b\u044e\u0431\u0456\u0448 \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u041f\u0430\u043d\u0435, \u0421\u044b\u043d\u0430 \u043f\u0440\u0430\u0432\u0456\u0446\u044b \u0441\u0432\u0430\u0451\u0439, \u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u043e\u0433\u0430 \u0422\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0422\u044b \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043d\u0430\u0437\u0432\u0430\u0446\u044c \u0415\u0437\u0443\u0441\u0430\u043c, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0417\u0431\u0430\u045e\u0446\u0430\u043c, &laquo;\u0431\u043e \u0401\u043d \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439 \u0430\u0434 \u044f\u0433\u043e\u043d\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e&raquo; (\u041c\u0446 1, 21), \u0456 &laquo;\u043d\u044f\u043c\u0430 \u043d\u0456 \u045e \u043a\u0456\u043c \u0456\u043d\u0448\u044b\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f&raquo; (\u0414\u0437 4, 12). \u0415\u0437\u0443\u0441 \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u043d\u0430\u0441 \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e, \u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0448\u044b\u043c \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0430\u0436\u043d\u043e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b, \u0430 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u045e \u043d\u0430\u0441 \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e, \u0431\u043e \u0401\u043d \u043f\u0435\u0440\u0448\u044b \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0442\u0430\u043a \u0451\u0441\u0446\u044c: \u0422\u044b \u043f\u0435\u0440\u0448\u044b\u043c \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u043a\u0430\u0431 \u043c\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0426\u044f\u0431\u0435. \u0406 \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0422\u0430\u0431\u0435 \u043d\u0435\u0441\u0442\u0430\u0432\u0430\u043b\u0430 \u043d\u0430\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0430 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0431\u0435\u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0426\u044f\u0431\u0435 \u043c\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0441\u0442\u0430\u0446\u044c \u0442\u044b\u043c, \u0434\u043b\u044f \u0447\u0430\u0433\u043e \u0422\u044b \u043d\u0430\u0441 \u0441\u0442\u0432\u0430\u0440\u044b\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0448\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e \u0456 &laquo;\u043f\u0430-\u0440\u043e\u0437\u043d\u0430\u043c\u0443 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0411\u043e\u0433 \u0434\u0430 \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0430 \u045e \u0433\u044d\u0442\u044b\u044f \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u0421\u044b\u043d\u0430&raquo; (\u0413\u0431\u0440 1, 1) &ndash; \u0441\u0432\u0430\u0451 \u0421\u043b\u043e\u0432\u0430. &laquo;\u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u0431\u044b\u043b\u0456 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u043d\u044f\u0431\u0451\u0441\u044b, \u0430 \u045e\u0441\u044f\u043a\u0430\u044f \u0456\u0445 \u043c\u043e\u0446 &ndash; \u0434\u044b\u0445\u0430\u043d\u043d\u0435\u043c \u0432\u0443\u0441\u043d\u0430\u045e \u042f\u0433\u043e\u043d\u044b\u0445&raquo; (\u041f\u0441 33 [32], 6).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0432\u0430\u044f \u043f\u0440\u0430\u043c\u043e\u0432\u0430 \u043f\u0440\u0430\u0437 \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0431\u044b\u043b\u0430 \u043d\u0456 \u0447\u044b\u043c \u0456\u043d\u0448\u044b\u043c, \u044f\u043a \u044f\u0441\u043d\u044b\u043c, \u043d\u0456\u0431\u044b \u0441\u043e\u043d\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u0442\u0430\u0433\u043e, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0446\u043d\u0430 \u0422\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441. \u0422\u044b \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u043d\u0430\u0432\u0430\u0442 \u0443\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u0430\u043b\u0435 \u0430\u0434\u0434\u0430\u045e \u042f\u0433\u043e \u0437\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441. \u0406 \u0401\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0437\u0430 \u043d\u0430\u0441 (\u043f\u0430\u0440. \u0420\u044b\u043c 8, 32. 37).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0431\u044b\u045e \u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043d\u044b \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0439 \u0446\u0456\u0448\u0430\u0439, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0439 \u0430\u0431\u043b\u0443\u0434\u0430\u0439, \u0422\u0432\u0430\u0451 \u0421\u043b\u043e\u0432\u0430, \u0437\u0432\u0435\u0440\u043d\u0443\u0442\u0430\u0435 \u0434\u0430 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u0433\u044d\u0442\u0430\u0435 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0441\u044b\u0448\u043b\u043e \u0437 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0433\u0430 \u043f\u0430\u0441\u0430\u0434\u0443 \u044f\u043a \u0433\u0440\u043e\u0437\u043d\u044b \u0432\u0430\u044f\u0440 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u043c\u0456\u043b\u044b \u0434\u0430\u045e\u0446\u0430 \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0448\u0442\u043e \u0431 \u0401\u043d \u043d\u0456 \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0431 \u043d\u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0430\u0436 \u0434\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f \u0437\u043d\u044f\u0432\u0430\u0433, \u043f\u043b\u044f\u045e\u043a\u043e\u045e \u0456 \u043f\u043e\u045e\u0445\u0430\u045e, \u0430\u0436\u043d\u043e \u0434\u0430 \u043a\u0440\u044b\u0436\u0430 \u0456 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u044f &ndash; \u0443\u0441\u0451 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u043d\u0456 \u0447\u044b\u043c \u0456\u043d\u0448\u044b\u043c, \u044f\u043a \u0422\u0432\u0430\u0456\u043c \u0421\u043b\u043e\u0432\u0430\u043c \u0434\u0430 \u043d\u0430\u0441, \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u044b\u043c \u0443 \u0421\u044b\u043d\u0435. \u041f\u0440\u0430\u0437 \u0422\u0432\u0430\u044e \u043b\u044e\u0431\u043e\u045e \u042f\u043d\u043e \u0430\u0431\u0443\u0434\u0436\u0430\u043b\u0430 \u0456 \u0440\u0430\u0441\u043f\u0430\u043b\u044c\u0432\u0430\u043b\u0430 \u043d\u0430\u0448\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430, \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0434\u0443\u0448, \u0422\u044b \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u045e \u0434\u0443\u0448\u0430\u0445 \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u0433\u044d\u0442\u0430\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0451 \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0437\u043d\u0456\u043a\u043d\u0443\u0446\u044c \u043f\u0430\u0434 \u043f\u0440\u044b\u043c\u0443\u0441\u0430\u043c, \u044f\u0433\u043e \u043c\u043e\u0436\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0431\u0443&shy;\u0434\u0437\u0456\u0446\u044c. \u0411\u043e \u0442\u0430\u043c, \u0434\u0437\u0435 \u0451\u0441\u0446\u044c \u043f\u0440\u044b\u043c\u0443\u0441, \u043d\u044f\u043c\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u044b, \u0430 \u0434\u0437\u0435 \u043d\u044f\u043c\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u044b, \u043d\u044f\u043c\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0422\u044b \u0437\u0430\u0445\u0430\u0446\u0435\u045e, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u0426\u044f\u0431\u0435. \u041c\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0431 \u0437\u0431\u0430\u0432\u0456\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u0426\u044f\u0431\u0435, \u043d\u0435 \u0437\u043c\u0430\u0433\u043b\u0456 \u0431 \u043f\u0430\u043b\u044e\u0431\u0456\u0446\u044c \u0426\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u0431 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0422\u0430\u0431\u043e\u0439. \u0422\u0430\u043c\u0443, \u041f\u0430\u043d\u0435, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0422\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0456 \u043c\u044b \u043a\u0430\u0436\u0430\u043c: &laquo;\u0422\u044b \u043f\u0435\u0440\u0448\u044b\u043c \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u043f\u0435\u0440\u0448\u044b \u043b\u044e\u0431\u0456\u0448 \u0443\u0441\u0456\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0426\u044f\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0436 \u043b\u044e\u0431\u0456\u043c \u0426\u044f\u0431\u0435 \u043b\u044e\u0431\u043e\u045e\u044e, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0439 \u0422\u0430\u0431\u043e\u044e. \u0410 \u0422\u0432\u0430\u044f \u043b\u044e\u0431\u043e\u045e &ndash; \u0433\u044d\u0442\u0430 \u0422\u0432\u0430\u044f \u0434\u0430\u0431\u0440\u044b\u043d\u044f, \u043e \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0435 \u0434\u0430\u0431\u0440\u043e \u0456 \u0432\u044f\u0440\u0448\u044b\u043d\u044f \u0434\u0430\u0431\u0440\u044b\u043d\u0456, \u0456 \u0421\u0432\u044f\u0442\u044b \u0414\u0443\u0445 \u0422\u0432\u043e\u0439, \u044f\u043a\u0456 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430 \u0456 \u044f\u043a\u0456 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u043b\u0443\u043d\u0430\u045e \u043d\u0430\u0434 \u0432\u0430\u0434\u043e\u044e, \u043d\u0430\u0434 \u043d\u044f\u0441\u0442\u0430\u043b\u044b\u043c\u0456 \u0440\u043e\u0437\u0443\u043c\u0430\u043c\u0456 \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445, \u0434\u0430\u044e\u0447\u044b \u0441\u044f\u0431\u0435 \u045e\u0441\u0456\u043c \u0456 \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u044e\u0447\u044b \u0434\u0430 \u0441\u044f\u0431\u0435 \u045e\u0441\u0456\u0445, \u0434\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u0456\u043c \u0434\u044b\u0445\u0430\u043d\u043d\u0435\u043c \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0435, \u0430\u0434\u0445\u0456\u043b\u044f\u044e\u0447\u044b \u0448\u043a\u043e\u0434\u043d\u0430\u0435 \u0456 \u0430\u0434\u043e\u0440\u0432\u0430\u044e\u0447\u044b \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c, \u044f\u0434\u043d\u0430\u044e\u0447\u044b \u0411\u043e\u0433\u0430 \u0437 \u043d\u0430\u043c\u0456 \u0456 \u043d\u0430\u0441 \u0437 \u0411\u043e\u0433\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 54, 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u041c\u0430\u044f \u043d\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u044c \u0430\u0434 \u0446\u044f\u0431\u0435, \u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0441\u043f\u0430\u043a\u043e\u044e \u041c\u0430\u0439\u0433\u043e \u043d\u0435 \u043f\u0430\u0445\u0456\u0441\u043d\u0435\u0446\u0446\u0430.<span style=\"color: #ff0000;\"> *<\/span> \u0423\u0441\u0435 \u0441\u044b\u043d\u044b \u0442\u0432\u0430\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0430, \u0456 \u043f\u043e\u0441\u043f\u0435\u0445 \u0441\u044b\u043d\u043e\u045e \u0442\u0432\u0430\u0456\u0445 \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u043b\u0456\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f &ndash; \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u044f\u043a\u0456 \u0432\u0443\u0447\u044b\u0446\u044c \u0446\u044f\u0431\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0435, \u044f\u043a\u0456 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435 \u0446\u044f\u0431\u0435 \u043d\u0430 \u0448\u043b\u044f\u0445, \u044f\u043a\u0456\u043c \u0442\u0440\u044d\u0431\u0430 \u0456\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0435 \u0441\u044b\u043d\u044b \u0442\u0432\u0430\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0430, \u0456 \u043f\u043e\u0441\u043f\u0435\u0445 \u0441\u044b\u043d\u043e\u045e \u0442\u0432\u0430\u0456\u0445 \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u043b\u0456\u043a\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"433","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 &laquo;\u041f\u0440\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430&raquo;<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 2, cap. 2-3)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u043e\u0440\u0430 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043d\u0430\u0434\u0442\u0430 \u0437\u0432\u0430\u0436\u0430\u0439 \u043d\u0430 \u0442\u043e\u0435, \u0445\u0442\u043e \u0437\u0430 \u0446\u044f\u0431\u0435 \u0446\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u0430\u043b\u0435 \u0442\u0430\u043a \u0440\u0430\u0431\u0456 \u0456 \u0430\u0431 \u0442\u044b\u043c \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0441\u044f, \u043a\u0430\u0431 \u0411\u043e\u0433 \u0431\u044b\u045e \u0437 \u0442\u0430\u0431\u043e\u044e \u0432\u0430 \u045e\u0441\u0456\u043c, \u0448\u0442\u043e \u0442\u044b \u0440\u043e\u0431\u0456\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439 \u0434\u043e\u0431\u0440\u0430\u0435 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435 &ndash; \u0456 \u0411\u043e\u0433 \u0446\u044f\u0431\u0435 \u0430\u0431\u0430\u0440\u043e\u043d\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0442\u0430\u043c\u0443, \u043a\u0430\u0433\u043e \u0411\u043e\u0433 \u0437\u0430\u0445\u043e\u0447\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0446\u044c, \u043d\u0456\u044f\u043a\u0430\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u043d\u0435 \u0437\u0434\u043e\u043b\u0435\u0435 \u043d\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c. \u041a\u0430\u043b\u0456 \u0442\u044b \u045e\u043c\u0435\u0435\u0448 \u043c\u0430\u045e\u0447\u0430\u0446\u044c \u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c, \u0442\u043e, \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0443\u0431\u0430\u0447\u044b\u0448 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u041f\u0430\u043d\u0430. \u0401\u043d \u0432\u0435\u0434\u0430\u0435 \u0447\u0430\u0441 \u0456 \u0441\u043f\u043e\u0441\u0430\u0431 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u0446\u044f\u0431\u0435. \u0422\u0430\u043c\u0443 \u0422\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0434\u0430\u0432\u0435\u0440\u044b\u0446\u0446\u0430 \u042f\u043c\u0443. \u0410\u0434 \u0411\u043e\u0433\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430 \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u0430\u0434 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0441\u043e\u0440\u0430\u043c\u0443. \u0427\u0430\u0441\u0442\u0430 \u0432\u0435\u043b\u044c\u043c\u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0448\u0443\u044e \u043f\u0430\u043a\u043e\u0440\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u0456\u043d\u0448\u044b\u044f \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u043d\u0430\u0448\u044b \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u044b \u0456 \u0432\u044b\u043a\u0440\u044b\u0432\u0430\u044e\u0446\u044c \u0456\u0445. \u041a\u0430\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u0435 \u0441\u044f\u0431\u0435 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0456\u0445 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0430\u045e, \u0442\u0430\u0434\u044b \u0451\u043d \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u0456\u043d\u0448\u044b\u043c \u0456 \u043b\u044f\u0433\u0447\u044d\u0439 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u044c\u0432\u0430\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u043b\u0443\u0435\u0446\u0446\u0430 \u043d\u0430 \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u0440\u043d\u0430\u0433\u0430 \u0411\u043e\u0433 \u0430\u0431\u0430\u0440\u043e\u043d\u0456\u0446\u044c \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c, \u0401\u043d \u043b\u044e\u0431\u0456\u0446\u044c \u043f\u0430\u043a\u043e\u0440\u043d\u0430\u0433\u0430 \u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0435 \u044f\u0433\u043e. \u0401\u043d \u0441\u0445\u0456\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0430 \u043f\u0430\u043a\u043e\u0440\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u044f\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0439 \u0456 \u043f\u0430\u0441\u043b\u044f \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u044f \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0430 \u0441\u043b\u0430\u0432\u044b. \u041f\u0430\u043a\u043e\u0440\u043d\u0430\u043c\u0443 \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0441\u0432\u0430\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u0432\u0430\u0431\u0456\u0446\u044c \u0456 \u0437\u0430\u043f\u0440\u0430\u0448\u0430\u0435 \u044f\u0433\u043e \u0434\u0430 \u0441\u044f\u0431\u0435. \u041f\u0430\u043a\u043e\u0440\u043d\u0430\u043c\u0443, \u044f\u043a\u0456 \u0437\u0432\u0435\u0434\u0430\u045e \u0441\u043e\u0440\u0430\u043c, \u043b\u044f\u0433\u0447\u044d\u0439 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0441\u043f\u0430\u043a\u043e\u0439, \u0431\u043e \u0451\u043d \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0411\u043e\u0433\u0430, \u0430 \u043d\u0435 \u043d\u0430 \u0441\u0432\u0435\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043b\u0456\u0447\u044b, \u0448\u0442\u043e \u045e \u043d\u0435\u0447\u044b\u043c \u0442\u044b \u043f\u0430\u0439\u0448\u043e\u045e \u043d\u0430\u043f\u0435\u0440\u0430\u0434, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u0435\u0448 \u0441\u044f\u0431\u0435 \u043d\u0456\u0436\u044d\u0439\u0448\u044b\u043c \u0437\u0430 \u045e\u0441\u0456\u0445. \u041f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0441\u043f\u0430\u043a\u043e\u0439, \u0456 \u0442\u0430\u0434\u044b \u0437\u043c\u043e\u0436\u0430\u0448 \u0441\u0443\u043f\u0430\u043a\u043e\u0456\u0446\u044c \u0456\u043d\u0448\u044b\u0445. \u0427\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0441\u043f\u0430\u043a\u043e\u0435\u043c, \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u044b\u0441\u043d\u044b, \u0447\u044b\u043c \u0432\u0443\u0447\u043e\u043d\u044b. \u0427\u0430\u043b\u0430\u0432\u0435\u043a, \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u0441\u0442\u0440\u0430\u0441&shy;\u0446\u044e, \u043d\u0430\u0432\u0430\u0442 \u0434\u0430\u0431\u0440\u043e \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0430\u0435 \u045e \u0437\u043b\u043e \u0456 \u0437 \u043b\u0451\u0433\u043a\u0430\u0441\u0446\u044e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0434\u0440\u044d\u043d\u043d\u0430\u0435. \u0410 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u043f\u0430\u043a\u043e\u044e \u045e\u0441\u0451 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0430\u0435 \u045e \u0434\u0430\u0431\u0440\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0441\u043f\u0430\u043a\u043e\u0456, \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u043f\u0430\u0434\u0430\u0437\u0440\u0430\u0435. \u0410 \u043d\u0435\u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0435\u043d\u0430\u0433\u0430 \u0456 \u045e\u0441\u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043d\u0430\u0433\u0430 \u0440\u0430\u0437\u0434\u0437\u0456\u0440\u0430\u044e\u0446\u044c \u0440\u043e\u0437\u043d\u044b\u044f \u043f\u0430\u0434\u0430\u0437\u0440\u044d\u043d\u043d\u0456: \u0451\u043d \u0456 \u0441\u0430\u043c \u043d\u0435 \u043c\u0430\u0435 \u0441\u043f\u0430\u043a\u043e\u044e, \u0456 \u043d\u0435 \u0434\u0430\u0435 \u0441\u043f\u0430\u043a\u043e\u044e \u0456\u043d\u0448\u044b\u043c. \u0427\u0430\u0441\u0442\u0430 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e, \u0456 \u043d\u0435 \u0440\u043e\u0431\u0456\u0446\u044c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u044f\u043c\u0443 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0432\u044b\u043f\u0430\u0434\u0430\u043b\u0430 \u0431 \u0440\u0430\u0431\u0456\u0446\u044c. \u0401\u043d \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0430\u0434 \u0442\u044b\u043c, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u043b\u0456 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0456\u043d\u0448\u044b\u044f, \u0456 \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0441\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0441\u044f \u043f\u0440\u0430 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0456 \u0442\u0430\u0434\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0437\u043c\u043e\u0436\u0430\u0448 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u0456 \u043f\u0440\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430. \u0422\u044b \u0434\u043e\u0431\u0440\u0430 \u045e\u043c\u0435\u0435\u0448 \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0435 \u045e\u0447\u044b\u043d\u043a\u0456 \u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0446\u044c \u0456\u0445, \u0430 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044f\u045e \u0430\u0434 \u0456\u043d\u0448\u044b\u0445 \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u043d\u0435 \u0445\u043e\u0447\u0430\u0448. \u0411\u043e\u043b\u044c\u0448 \u0441\u043b\u0443\u0448\u043d\u0430 \u0431\u044b\u043b\u043e \u0431 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u0446\u044c \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0456 \u0434\u0430\u0440\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0439\u043c\u0443 \u0431\u0440\u0430\u0442\u0443. \u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448, \u043a\u0430\u0431 \u0446\u044f\u0431\u0435 \u0446\u044f\u0440\u043f\u0435\u043b\u0456, \u0446\u044f\u0440\u043f\u0456 \u0456 \u0441\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 25 (24), 9-10; \u0417\u0430\u0445 7, 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u043a\u0456\u0440\u0443\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u044b\u043c\u0456 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u0435 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u0445 \u0448\u043b\u044f\u0445\u0430\u043c \u0441\u0432\u0430\u0456\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0423\u0441\u0435 \u0441\u0446\u0435\u0436\u043a\u0456 \u041f\u0430\u043d\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u043b\u044f \u0442\u044b\u0445, <span style=\"color: #ff0000;\">\/<\/span> \u0445\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0456 \u043d\u0430\u043a\u0430\u0437\u044b \u042f\u0433\u043e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b\u043d\u043e\u0441\u044c\u0446\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u043f\u0440\u044b\u0441\u0443\u0434\u044b, \u0456 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0439\u0446\u0435 \u045e\u0441\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e \u0441\u0432\u0430\u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0435 \u0441\u0446\u0435\u0436\u043a\u0456 \u041f\u0430\u043d\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u043b\u044f \u0442\u044b\u0445, <span style=\"color: #ff0000;\">\/<\/span> \u0445\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0456 \u043d\u0430\u043a\u0430\u0437\u044b \u042f\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"434","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u044f\u045e&raquo; \u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 4, 20, 4-5: SCh 100, 634-640)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043f\u0440\u044b\u0439\u0441\u0446\u044e \u0425\u0440\u044b\u0441\u0442\u0430 \u043b\u044e\u0434\u0437\u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0437\u0456\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0421\u043b\u043e\u0432\u0430 \u0456 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0443\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0456 \u045e\u043b\u0430\u0434\u043a\u0430\u0432\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u043c \u042f\u0433\u043e \u0421\u043b\u043e\u0432\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0448 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u045e \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0447\u0430\u0441\u044b \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u0430\u0431 \u0437\u043b\u0443\u0447\u044b\u0446\u044c \u043a\u0430\u043d\u0435\u0446 \u0437 \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0437 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043f\u0440\u0430\u0440\u043e\u043a\u0456, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u043f\u0440\u0430\u0440\u043e\u0446\u043a\u0456 \u0434\u0430\u0440 \u0430\u0434 \u0442\u0430\u0433\u043e \u0441\u0430\u043c\u0430\u0433\u0430 \u0421\u043b\u043e\u0432\u0430, \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u042f\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u045e \u0446\u0435\u043b\u0435. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0456 \u0430\u0434\u0431\u044b\u043b\u043e\u0441\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f \u0410\u0439\u0446\u0430 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u0456 \u0437\u043b\u0443\u0447\u044d\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0430, \u0448\u0442\u043e \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u0431\u0430\u0447\u043d\u044b \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0456\u043c\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0406 \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u0456 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u0446\u0446\u0430 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u0437\u0431\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u044f\u0433\u043e, \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0447\u044b\u0441\u044f \u0431\u0430\u0447\u043d\u044b\u043c \u0434\u043b\u044f \u044f\u0433\u043e \u0456 &laquo;\u0432\u044b\u0437\u0432\u0430\u043b\u044f\u044e\u0447\u044b \u043d\u0430\u0441 \u0430\u0434 \u0440\u0443\u043a \u0443\u0441\u0456\u0445, \u0445\u0442\u043e \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0441&raquo; (\u043f\u0430\u0440. \u041b\u043a 1, 71), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0434\u0443\u0445\u0443 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430, \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u044e\u0447\u044b \u043d\u0430\u0441 &laquo;\u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u043d\u0430\u0448\u044b&raquo; (\u043f\u0430\u0440. \u041b\u043a 1, 74-75), \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u043c\u043e\u0433 \u0456\u0441\u0446\u0456 \u0434\u0430 \u0441\u043b\u0430\u0432\u044b \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u044b \u043f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043b\u044e\u0434\u0437\u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0411\u043e\u0433\u0430, \u044f\u043a \u041f\u0430\u043d \u0456 \u043a\u0430\u0436\u0430: &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0447\u044b\u0441\u0442\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c, \u0431\u043e \u044f\u043d\u044b \u0411\u043e\u0433\u0430 \u045e\u0431\u0430\u0447\u0430\u0446\u044c&raquo; (\u041c\u0446 5, 8).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430 \u045e \u042f\u0433\u043e \u0432\u0435\u043b\u0456\u0447\u044b \u0456 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u0435 \u0456 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0436\u044b\u0432\u044b\u043c (\u043f\u0430\u0440. \u0417\u044b\u0445 33, 20), \u0431\u043e \u0410\u0439\u0446\u0435\u0446 \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u044b. \u0410\u043b\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456 \u0456 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0401\u043d \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0433\u044d\u0442\u0430, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u042f\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u044c, \u044f\u043a \u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456: &laquo;\u0428\u0442\u043e \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u045e \u043b\u044e\u0434\u0437\u0435\u0439, \u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u045e \u0411\u043e\u0433\u0430&raquo; (\u041b\u043a 18, 27).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456 \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0441\u0430\u043c \u043d\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u0435 \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u0441\u044f\u0431\u0435 \u043b\u044e\u0434\u0437\u044f\u043c, \u044f\u043a\u0456\u043c \u0437\u0430\u0445\u043e\u0447\u0430, \u043a\u0430\u043b\u0456 \u0437\u0430\u0445\u043e\u0447\u0430 \u0456 \u044f\u043a \u0437\u0430\u0445\u043e\u0447\u0430. \u0411\u043e\u0433 \u043c\u043e\u0436\u0430 \u045e\u0441\u0451: \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u042f\u0433\u043e \u0431\u0430\u0447\u044b\u043b\u0456 \u045e \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430\u0445 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0414\u0443\u0445\u0430. \u042f\u0433\u043e \u0431\u0430\u0447\u044b\u043b\u0456 \u045e \u0421\u044b\u043d\u0435 \u043f\u0440\u0430\u0437 \u0443\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u042f\u0433\u043e \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u041d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u043f\u0440\u0430\u0437 \u0430\u0439\u0446\u043e\u045e\u0441\u0442\u0432\u0430. \u0414\u0443\u0445 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u043e\u045e\u0432\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u043b\u044f \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0421\u044b\u043d \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u044f\u0433\u043e \u0434\u0430 \u0410\u0439\u0446\u0430, \u0430 \u0410\u0439\u0446\u0435\u0446 \u0434\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456 \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u043a\u043e\u0436\u043d\u0430\u043c\u0443, \u0445\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u045e \u0441\u0432\u044f\u0442\u043b\u0435 \u0456 \u0431\u0430\u0447\u0430\u0446\u044c \u044f\u0433\u043e \u044f\u0441\u043d\u0430\u0441\u0446\u044c, \u0442\u0430\u043a \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430, \u0431\u0443\u0434\u0443\u0446\u044c \u0443 \u0411\u043e\u0433\u0443, \u0441\u0443\u0437\u0456\u0440\u0430\u044e\u0447\u044b \u042f\u0433\u043e \u044f\u0441\u043d\u0430\u0441\u0446\u044c. \u0410 \u044f\u0441\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0430\u044f \u0430\u0436\u044b\u045e\u043b\u044f\u0435, \u0442\u0430\u043c\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0442\u044b\u044f, \u0445\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0440\u0433 18, 18; \u041b\u043a 20, 9; \u043f\u0430\u0440. \u042f\u043d 6, 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0456\u043c \u043f\u0440\u0430\u0440\u043e\u043a\u0430, \u0456 \u045e\u043a\u043b\u0430\u0434\u0443 \u041c\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u045e \u0432\u0443\u0441\u043d\u044b \u044f\u0433\u043e\u043d\u044b\u044f, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0437\u0430\u0446\u044c \u0456\u043c \u0443\u0441\u0451, \u0448\u0442\u043e \u042f \u0437\u0430\u0433\u0430\u0434\u0430\u044e \u044f\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u043f\u0430\u0448\u043b\u044e \u0434\u0430 \u0456\u0445 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430. \u0401\u043d \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u0430\u0440\u043e\u043a, \u044f\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u045e \u0441\u0432\u0435\u0442.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0437\u0430\u0446\u044c \u0456\u043c \u0443\u0441\u0451, \u0448\u0442\u043e \u042f \u0437\u0430\u0433\u0430\u0434\u0430\u044e \u044f\u043c\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"435","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0430\u0433\u043c\u0430\u0442\u044b\u0447\u043d\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u0411\u043e\u0436\u0430\u0435 \u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 &laquo;Dei Verbum&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 3-4)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u043f\u0430\u045e\u043d\u044f\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435<\/span> <\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0421\u043b\u043e\u0432\u0430 \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u0430\u0435 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435, \u0434\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0443 \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0441\u044f\u0431\u0435 \u045e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u0445 \u0456, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u0448\u043b\u044f\u0445 \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0401\u043d \u0443\u0436\u043e \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e \u0441\u044f\u0431\u0435 \u043f\u0440\u0430\u0431\u0430\u0446\u044c\u043a\u0430\u043c. \u041f\u0430\u0441\u043b\u044f \u0456\u0445 \u0433\u0440\u044d\u0445\u0430\u043f\u0430\u0434\u0437\u0435\u043d\u043d\u044f \u0411\u043e\u0433, \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e\u0448\u044b \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435, \u0430\u0431\u0443\u0434\u0437\u0456\u045e \u0443 \u0456\u0445 \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0440\u043e\u0434, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e\u0441\u0456\u043c, \u0445\u0442\u043e \u0437 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u045e \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0448\u0443\u043a\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0423 \u0441\u0432\u043e\u0439 \u0447\u0430\u0441 \u0401\u043d \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u043a\u0430\u0431 \u0432\u044b\u0432\u0435\u0441\u0446\u0456 \u0430\u0434 \u044f\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0456 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u043f\u0430\u0441\u043b\u044f \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0430\u045e \u043f\u0440\u0430\u0437 \u041c\u0430\u0439\u0441\u0435\u044f \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u044f\u043a \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430, \u043f\u0440\u0430\u0434\u0431\u0430\u0447\u043b\u0456\u0432\u0430\u0433\u0430 \u0410\u0439\u0446\u0430 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0421\u0443\u0434\u0434\u0437\u044e, \u0447\u0430\u043a\u0430\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u0443, \u0456 \u0442\u0430\u043a \u0446\u044f\u0433\u0430\u043c \u0432\u044f\u043a\u043e\u045e \u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0434\u0430\u0440\u043e\u0433\u0443 \u0434\u043b\u044f \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e \u044f\u043a \u0411\u043e\u0433 \u0448\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e \u0456 \u043f\u0430-\u0440\u043e\u0437\u043d\u0430\u043c\u0443 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, &laquo;\u0443 \u0433\u044d\u0442\u044b\u044f \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u0421\u044b\u043d\u0430&raquo; (\u0413\u0431\u0440 1, 1-2). \u041f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u0435 \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u0430\u0431 \u0401\u043d \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c \u0411\u043e\u0436\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b. \u0422\u0430\u043c\u0443 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u044f\u043a \u0443\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0456 &laquo;\u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439&raquo;, &laquo;\u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0411\u043e\u0436\u044b\u044f \u0441\u043b\u043e\u0432\u044b&raquo; (\u042f\u043d 3, 34) \u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u0441\u043f\u0440\u0430\u0432\u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u044f\u043a\u0443\u044e \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u042f\u043c\u0443 \u0410\u0439\u0446\u0435\u0446. \u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0431\u0430\u0447\u0430\u0447\u044b \u044f\u043a\u043e\u0433\u0430 \u043c\u043e\u0436\u043d\u0430 \u0431\u0430\u0447\u044b\u0446\u044c \u0456 \u0410\u0439\u0446\u0430, \u0443\u0441\u0451\u0439 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044e \u0456 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435\u043c, \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456, \u0437\u043d\u0430\u043a\u0430\u043c\u0456 \u0456 \u0446\u0443\u0434\u0430\u043c\u0456, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u044e \u0456 \u0441\u043b\u0430\u045e\u043d\u044b\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435\u043c, \u043f\u0430\u0441\u043b\u0430\u045e\u0448\u044b, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u0414\u0443\u0445\u0430 \u043f\u0440\u0430\u045e\u0434\u044b, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0435 \u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0431\u043e\u0441\u043a\u0456\u043c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0437 \u043d\u0430\u043c\u0456, \u043a\u0430\u0431 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043d\u0430\u0441 \u0441\u0430 \u0437\u043c\u0440\u043e\u043a\u0443 \u0433\u0440\u0430\u0445\u0443 \u0456 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u0446\u044c \u0434\u043b\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u044f \u044d\u043a\u0430\u043d\u043e\u043c\u0456\u044f \u044f\u043a \u043d\u043e\u0432\u044b \u0456 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0440\u0430\u043c\u0456\u043d\u0435 \u0456 \u043f\u0435\u0440\u0430\u0434 \u0441\u043b\u0430\u045e\u043d\u044b\u043c \u043f\u0440\u044b\u0439\u0441\u0446\u0435\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u0436\u043e \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0447\u0430\u043a\u0430\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u043d\u043e\u0432\u0430\u0433\u0430 \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u0430\u0433\u0430 \u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 30, 20-21; \u0414\u0440\u0433 18, 15<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0447\u044b \u0442\u0432\u0430\u0435 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0432\u0443\u0448\u044b \u0442\u0432\u0430\u0435 \u043f\u0430\u0447\u0443\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u0430, \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0435 \u0437\u0430 \u0442\u0430\u0431\u043e\u044e: \u0413\u044d\u0442\u0430 \u0434\u0430\u0440\u043e\u0433\u0430, \u0456\u0434\u0437\u0456 \u043f\u0430 \u0451\u0439. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0437 \u0431\u0440\u0430\u0442\u043e\u045e \u0442\u0432\u0430\u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0432\u0443\u0448\u044b \u0442\u0432\u0430\u0435 \u043f\u0430\u0447\u0443\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u0430, \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0435 \u0437\u0430 \u0442\u0430\u0431\u043e\u044e: \u0413\u044d\u0442\u0430 \u0434\u0430\u0440\u043e\u0433\u0430, \u0456\u0434\u0437\u0456 \u043f\u0430 \u0451\u0439.<\/p>\r\n"}, {"GCH_CH_2_ID":"436","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(In ps. 37, 13-14: CCL 38, 391-392)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0421\u0430\u043c\u043e \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0451\u0441\u0446\u044c \u0422\u0432\u0430\u0451\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0415\u043d\u0447\u0443, \u0431\u043e \u0441\u0442\u043e\u0433\u043d\u0435 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 (\u043f\u0430\u0440. \u041f\u0441 38 [39], 9). \u0411\u044b\u0432\u0430\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u0441\u0442\u043e\u0433\u043d, \u044f\u043a\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u0447\u0443\u0435. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0441\u044d\u0440\u0446\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u0430 \u0434\u0443\u043c\u043a\u0430\u043c\u0456 \u0430\u0431 \u043d\u0435\u0447\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u044b\u043c, \u0448\u0442\u043e \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0430\u044f \u0440\u0430\u043d\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0433\u043e\u043b\u0430\u0441, \u0442\u0430\u0434\u044b \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u043f\u0440\u044b\u0447\u044b\u043d\u044b. \u0406 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0441\u043b\u0443\u0445\u0430\u0435, \u0441\u043a\u0430\u0436\u0430 \u0441\u0430\u0431\u0435: \u043c\u043e\u0436\u0430 \u0451\u043d \u0441\u0442\u043e\u0433\u043d\u0435 \u0437&shy;\u0437\u0430 \u043d\u0435\u0447\u0430\u0433\u0430, \u043c\u043e\u0436\u0430 \u044f\u043c\u0443 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0448\u0442\u043e\u0441\u044c\u0446\u0456. \u0425\u0442\u043e \u0436 \u0433\u044d\u0442\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u043e\u0439, \u0443 \u043a\u0430\u0433\u043e \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0456 \u043f\u0440\u044b \u043a\u0456\u043c \u0441\u0442\u043e\u0433\u043d\u0435? \u041a\u0430\u043b\u0456 \u043b\u044e\u0434\u0437\u0456 \u0447\u0443\u044e\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u0441\u0442\u043e\u0433\u043d\u044b, \u0447\u0430\u0441\u0446\u0435\u0439 \u044f\u043d\u044b \u0447\u0443\u044e\u0446\u044c \u0441\u0442\u043e\u0433\u043d\u044b \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u043d\u0435 \u0447\u0443\u044e\u0446\u044c \u0441\u0430\u043c\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u0441\u0442\u043e\u0433\u043d\u0435 \u0430\u0434 \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430\u0439 \u0440\u0430\u043d\u044b, \u0442\u0430\u043c\u0443 \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442 \u043a\u0430\u0436\u0430: &laquo;\u042f \u0435\u043d\u0447\u0443, \u0431\u043e \u0441\u0442\u043e\u0433\u043d\u0435 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0436 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0435, \u0430\u0434\u043a\u0443\u043b\u044c \u0441\u0442\u043e\u0433\u043d\u044b? \u041f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442 \u0434\u0430\u0434\u0430\u0435: &laquo;\u041f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e \u045e\u0441\u0451 \u043c\u0430\u0451 \u0436\u0430\u0434\u0430\u043d\u043d\u0435&raquo; (\u043f\u0430\u0440. \u041f\u0441 38 [37], 10). \u041d\u0435 \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u044f\u043a\u0456\u044f \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0431\u0430\u0447\u044b\u0446\u044c \u0441\u044d\u0440\u0446\u0430, \u0430\u043b\u0435 &laquo;\u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e \u045e\u0441\u0451 \u043c\u0430\u0451 \u0436\u0430\u0434\u0430\u043d\u043d\u0435&raquo;. \u041a\u0430\u043b\u0456 \u0422\u0432\u0430\u0451 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c, \u0442\u043e \u0456 \u0410\u0439\u0446\u0435\u0446, \u044f\u043a\u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u043f\u0430\u0442\u0430\u0435\u043c\u043d\u0430\u0435, \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u0422\u0430\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043c\u043e \u0442\u0432\u0430\u0451 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 &ndash; \u0433\u044d\u0442\u0430 \u0442\u0432\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430; \u0456 \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435\u0446\u0446\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435\u0446\u0446\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0430. \u041d\u0435 \u0434\u0430\u0440\u043c\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u041d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u0430\u043b\u0456\u0446\u0435\u0441\u044f&raquo; (1 \u0422\u044d\u0441 5, 17). \u0425\u0456\u0431\u0430 \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e &laquo;\u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u0430\u043b\u0456\u0446\u0435\u0441\u044f&raquo; \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0437\u0433\u0456\u043d\u0430\u0435\u043c \u043a\u0430\u043b\u0435\u043d\u0456, \u0441\u0445\u0456\u043b\u044f\u0435\u043c\u0441\u044f \u045e \u043f\u0430\u043a\u043b\u043e\u043d\u0435 \u0430\u0431\u043e \u045e\u0437\u043d\u043e\u0441\u0456\u043c \u0440\u0443\u043a\u0456? \u041a\u0430\u043b\u0456 \u0436 \u043c\u044b \u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u0442\u0430\u043a \u043c\u043e\u043b\u0456\u043c\u0441\u044f, \u0442\u043e, \u0434\u0443\u043c\u0430\u044e, \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0406\u0441\u043d\u0443\u0435 \u0456\u043d\u0448\u0430\u044f, \u0443\u043d\u0443\u0442\u0440\u0430\u043d\u0430\u044f \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c. \u0428\u0442\u043e \u0431 \u0442\u044b \u043d\u0456 \u0440\u0430\u0431\u0456\u045e, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0433\u043d\u0435\u0448 \u0442\u0430\u0433\u043e \u0448\u0430\u0431\u0430\u0442\u0443, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a \u0443 \u0411\u043e\u0433\u0443, \u0442\u044b \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0435\u0448 \u043c\u0430\u043b\u0456\u0446\u0446\u0430. \u041a\u0430\u043b\u0456 \u043d\u0435 \u0445\u043e\u0447\u0430\u0448 \u0441\u043f\u044b\u043d\u044f\u0446\u044c \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u043d\u0435 \u0441\u043f\u044b\u043d\u044f\u0439 \u0436\u0430\u0434\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0432\u0430\u0451 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0456 \u0451\u0441\u0446\u044c \u0442\u0432\u0430\u0456\u043c \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c. \u0422\u044b \u0437\u0430\u043c\u043e\u045e\u043a\u043d\u0435\u0448, \u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043d\u0435\u0448 \u043b\u044e\u0431\u0456\u0446\u044c. \u0425\u0442\u043e \u0437\u0430\u043c\u043e\u045e\u043a? \u0422\u044b\u044f, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0417-\u0437\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0430\u0448\u044b\u0440\u044b\u0446\u0446\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u043b\u044e\u0431\u043e\u045e \u043c\u043d\u043e\u0433\u0456\u0445 \u0430\u0441\u0442\u044b\u043d\u0435&raquo; (\u041c\u0446 24, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0430\u043b\u043e\u0434\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e &ndash; \u0433\u044d\u0442\u0430 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435 \u0441\u044d\u0440\u0446\u0430. \u0413\u0430\u0440\u0430\u0447\u0430\u044f \u043b\u044e\u0431\u043e\u045e &ndash; \u0433\u044d\u0442\u0430 \u043a\u0440\u044b\u043a \u0441\u044d\u0440\u0446\u0430. \u041a\u0430\u043b\u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0442\u0440\u044b\u0432\u0430\u0435 \u043b\u044e\u0431\u043e\u045e, \u0442\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043a\u0440\u044b\u0447\u044b\u0448. \u041a\u0430\u043b\u0456 \u0442\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043a\u0440\u044b\u0447\u044b\u0448, \u0442\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0436\u0430\u0434\u0430\u0435\u0448. \u041a\u0430\u043b\u0456 \u0442\u044b \u0436\u0430\u0434\u0430\u0435\u0448, \u0442\u044b \u0434\u0443\u043c\u0430\u0435\u0448 \u043f\u0440\u0430 \u0441\u043f\u0430\u043a\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e \u045e\u0441\u0451 \u043c\u0430\u0451 \u0436\u0430\u0434\u0430\u043d\u043d\u0435&raquo; (\u041f\u0441 38 [37], 10). \u041a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0441\u0430\u043c\u043e \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u0434\u044b\u043a \u0446\u0456 \u043c\u043e\u0436\u0430 \u043d\u0435 \u0431\u044b\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0441\u0442\u043e\u0433\u043d? \u041d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0456\u043d\u0430\u043a\u0448, \u0431\u043e \u0441\u0442\u043e\u0433\u043d \u0451\u0441\u0446\u044c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0434\u0430\u043b\u0435\u0439: &laquo;\u0421\u0442\u043e\u0433\u043d \u043c\u043e\u0439 \u043d\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u0430\u0434 \u0426\u044f\u0431\u0435&raquo; (\u041f\u0441 38 [37], 10). \u0410\u0434 \u0426\u044f\u0431\u0435 \u043d\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u044b, \u0430\u043b\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0430\u0434 \u043c\u043d\u043e\u0433\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u0427\u0430\u0441\u0430\u043c \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u0441\u043b\u0443\u0433\u0430 \u0411\u043e\u0436\u044b \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c: &laquo;\u0421\u0442\u043e\u0433\u043d \u043c\u043e\u0439 \u043d\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u0430\u0434 \u0426\u044f\u0431\u0435&raquo;. \u0410 \u0447\u0430\u0441\u0430\u043c, \u0448\u0442\u043e \u0433\u044d\u0442\u044b \u0441\u043b\u0443\u0433\u0430 \u0411\u043e\u0436\u044b \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430. \u0425\u0456\u0431\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u0430 \u0433\u044d\u0442\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u045e \u0441\u044d\u0440\u0446\u044b? \u041a\u0430\u043b\u0456 \u0436 \u0451\u0441\u0446\u044c \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u0451\u0441\u0446\u044c \u0456 \u0441\u0442\u043e\u0433\u043d, \u0431\u043e \u043d\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0451\u043d \u0434\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u043b\u044e\u0434\u0441\u043a\u0456\u0445 \u0432\u0443\u0448\u044d\u0439, \u0430\u043b\u0435 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0432\u0443\u0448\u044d\u0439 \u0411\u043e\u0436\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0416\u044b\u0432\u0443\u0447\u044b \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0456 \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0443\u044e\u0447\u044b \u0434\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0410\u0439\u0447\u044b\u043d\u044b, \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u0435\u043c, \u043a\u0430\u0431 \u0430\u0431\u0443\u0434\u0437\u0456\u0446\u044c \u0436\u0430\u0434\u0430\u043d\u043d\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0422\u043e\u0439, \u0445\u0442\u043e \u0436\u0430\u0434\u0430\u0435, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u043c\u0430\u045e\u0447\u044b\u0446\u044c \u044f\u0437\u044b\u043a, \u0441\u043f\u044f\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u0430\u043c. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u0436\u0430\u0434\u0430\u0435, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u043a\u0440\u044b\u0447\u0430\u0446\u044c \u0443 \u043b\u044e\u0434\u0441\u043a\u0456\u044f \u0432\u0443\u0448\u044b, \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u043d\u044f\u043c\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u043e\u0439, \u0445\u0442\u043e \u0436\u0430\u0434\u0430\u0435, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u043c\u0430\u045e\u0447\u044b\u0446\u044c \u044f\u0437\u044b\u043a, \u0441\u043f\u044f\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"442","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 31, 2-3: PL 54, 791-793)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0421\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u043d\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u043c\u0430 \u043d\u0456\u044f\u043a\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0446\u044c, \u0448\u0442\u043e \u043d\u0430\u0448 \u041f\u0430\u043d, \u0421\u044b\u043d \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0439 \u041f\u0430\u043d\u043d\u044b \u041c\u0430\u0440\u044b\u0456 &ndash; \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0432\u0435\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u0401\u043d \u0442\u0430\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456\u043c \u042f\u0433\u043e \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0446\u0432\u0435\u0439 \u043d\u0430\u043f\u0456\u0441\u0430\u045e: &laquo;\u041a\u043d\u0456\u0433\u0430 \u0440\u0430\u0434\u0430\u0432\u043e\u0434\u0443 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u044b\u043d\u0430 \u0414\u0430\u0432\u0456\u0434\u0430, \u0441\u044b\u043d\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430&raquo; (\u041c\u0446 1, 1). \u0401\u043d \u043f\u0430\u0434\u0430\u0435 \u043f\u0430 \u043f\u0430\u0440\u0430\u0434\u043a\u0443 \u042f\u0433\u043e \u043b\u044e\u0434\u0441\u043a\u0456\u044f \u043a\u0430\u0440\u0430\u043d\u0456, \u043a\u0430\u0431 \u043f\u0440\u0430\u0441\u0430\u0447\u044b\u0446\u044c \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435 \u0430\u0436 \u0434\u0430 \u042e\u0437\u0430\u0444\u0430, \u0437 \u044f\u043a\u0456\u043c \u0431\u044b\u043b\u0430 \u0437\u0430\u0440\u0443\u0447\u0430\u043d\u0430 \u041c\u0430\u0446\u0456 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u041b\u0443\u043a\u0430, \u043f\u0435\u0440\u0430\u043b\u0456\u0447\u0432\u0430\u044e\u0447\u044b \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u044f \u045e \u0430\u0434\u0432\u0430\u0440\u043e\u0442\u043d\u044b\u043c \u043f\u0430\u0440\u0430\u0434\u043a\u0443, \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0441\u0430\u043c\u043e\u0433\u0430 \u043f\u0435\u0440\u0448\u044b\u043d\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0440\u043e\u0434\u0443, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u043f\u0435\u0440\u0448\u044b \u0410\u0434\u0430\u043c \u0456 \u0430\u043f\u043e\u0448\u043d\u0456 \u0410\u0434\u0430\u043c \u043c\u0430\u044e\u0446\u044c \u0442\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u043c\u0430\u0433\u043b\u0430 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u044f \u0456 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044f \u043b\u044e\u0434\u0437\u0435\u0439 \u0442\u0430\u043a, \u044f\u043a \u0437&rsquo;\u044f\u045e\u043b\u044f\u043b\u0430\u0441\u044f \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0430\u043c \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u0443 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439 \u043f\u043e\u0441\u0442\u0430\u0446\u0456, \u043a\u0430\u043b\u0456 \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u0437 \u042f\u043a\u0443\u0431\u0430\u043c, \u043a\u0430\u043b\u0456 \u0432\u0451\u045e \u0440\u0430\u0437\u043c\u043e\u0432\u0443, \u0446\u0456 \u043a\u0430\u043b\u0456 \u043d\u0435 \u0430\u0434\u043c\u043e\u0432\u0456\u045e\u0441\u044f \u0430\u0434 \u0433\u0430\u0441\u0446\u0456\u043d\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u044f, \u0446\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u043b\u0456 \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u045e \u043f\u0440\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043d\u0430\u0439 \u0435\u0436\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f \u0432\u043e\u0431\u0440\u0430\u0437\u044b \u045e\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u043d\u0430 \u0442\u0430\u0433\u043e \u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0447\u044b\u044f \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0441\u0446\u044c, \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430\u044f \u043c\u0456\u0441\u0442\u044b\u0447\u043d\u044b\u043c\u0456 \u0437\u043d\u0430\u043a\u0430\u043c\u0456, \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u0430 \u0432\u044b\u0432\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0434\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u043d\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f, \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u043f\u0435\u0440\u0430\u0434 \u0432\u0435\u0447\u043d\u044b\u043c\u0456 \u0447\u0430\u0441\u0430\u043c\u0456, \u043d\u0435 \u0431\u044b\u045e \u044f\u0448\u0447\u044d \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u043d\u0456\u044f\u043a\u0456\u043c\u0456 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c\u0456, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u0414\u0437\u0435\u0432\u0443, \u0430 \u043c\u043e\u0446 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u043d\u0435 \u0430\u0445\u0456\u043d\u0443\u043b\u0430 \u042f\u0435. \u0423 \u043d\u0435\u043a\u0440\u0430\u043d\u0443\u0442\u044b\u043c \u0443\u043b\u043e\u043d\u043d\u0456 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0430 \u0441\u0430\u0431\u0435 \u0434\u043e\u043c, \u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c, \u0430 \u0432\u043e\u0431\u0440\u0430\u0437 \u0411\u043e\u0433\u0430 \u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u0441\u043b\u0443\u0433\u0456 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043b\u0456\u0441\u044f \u045e \u0430\u0434\u043d\u043e\u0439 \u0430\u0441\u043e\u0431\u0435. \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0447\u0430\u0441\u043e\u045e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u045e \u0447\u0430\u0441\u0435, \u0456 \u0442\u043e\u0439, \u043f\u0440\u0430\u0437 \u043a\u0430\u0433\u043e \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u045e\u0441\u0451, \u0441\u0430\u043c \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u043f\u0430\u043c\u0456\u0436 \u0443\u0441\u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0431 \u043d\u043e\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u043d\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 (\u043f\u0430\u0440. \u0420\u044b\u043c 8, 3), \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430\u0448\u0443 \u0441\u0442\u0430\u0440\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443 \u0456 \u044f\u043a \u0430\u0434\u0437\u0456\u043d\u0430\u0441\u0443\u0442\u043d\u044b \u0437 \u0410\u0439\u0446\u043e\u043c \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0441\u0442\u0430\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434\u0437\u0456\u043d\u0430\u0441\u0443\u0442\u043d\u044b\u043c \u0437 \u041c\u0430\u0446\u0456 \u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043d\u0430 \u0441\u044f\u0431\u0435 \u043d\u0430\u0448\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443 \u044f\u043a \u0430\u0434\u0437\u0456\u043d\u044b \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b \u0430\u0434 \u0433\u0440\u0430\u0445\u0443, \u0442\u0430\u0434\u044b \u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u045e \u043d\u044f\u0432\u043e\u043b\u0456 \u0434&rsquo;\u044f\u0431\u043b\u0430. \u0410 \u043c\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0431 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0439 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430\u0439, \u043a\u0430\u043b\u0456 \u0431 \u044f\u043d\u0430 \u043d\u0435 \u0431\u044b\u043b\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u0430 \u043f\u0430-\u0437\u0430 \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u043c\u0443 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0434\u043b\u044f \u043d\u0430\u0441 \u0437\u0430\u0437\u0437\u044f\u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0441\u0430\u043c\u043e\u0433\u0430 \u0414\u0443\u0445\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0431\u044b\u045e \u0437\u0430\u0447\u0430\u0442\u044b \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f, \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456\u0441\u044f \u0437\u043d\u043e\u045e \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e: &laquo;\u0425\u0442\u043e \u043d\u0435 \u0430\u0434 \u043a\u0440\u044b\u0432\u0456, \u0456 \u043d\u0435 \u0430\u0434 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u0446\u0435\u043b\u0430, \u0456 \u043d\u0435 \u0430\u0434 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u043c\u0443\u0436\u0430, \u0430\u043b\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f&raquo; (\u042f\u043d 1, 13).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 11, 10; \u041b\u043a 1, 32<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u043f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u0415\u0441\u044d\u044f \u0441\u044b\u0434\u0437\u0435 \u0434\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u044f\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u0430\u043b\u0456\u0446\u0446\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0431\u0443\u0434\u0437\u0435 \u0441\u043b\u0430\u045e\u043d\u044b\u043c \u044f\u0433\u043e \u0456\u043c\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u0434\u0430\u0441\u0446\u044c \u044f\u043c\u0443 \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0440\u043e\u043d \u0414\u0430\u0432\u0456\u0434\u0430, \u0431\u0430\u0446\u044c\u043a\u0456 \u044f\u0433\u043e\u043d\u0430\u0433\u0430. \u0406 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0434 \u0434\u043e\u043c\u0430\u043c \u042f\u043a\u0443\u0431\u0430 \u0432\u0435\u0447\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0431\u0443\u0434\u0437\u0435 \u0441\u043b\u0430\u045e\u043d\u044b\u043c \u044f\u0433\u043e \u0456\u043c\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"443","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0434\u0430 \u0414\u044b\u044f\u0433\u043d\u044d\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 8, 5 &ndash; 9, 5: Funk 1, 325-327)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0411\u043e\u0433 \u0432\u044b\u044f\u0432\u0456\u045e \u043b\u044e\u0431\u043e\u045e \u043f\u0440\u0430\u0437 \u0421\u044b\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0456\u0445\u0442\u043e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e \u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u045e \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 \u0401\u043d \u0441\u0430\u043c \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0441\u044f\u0431\u0435. \u0410 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0441\u044f\u0431\u0435 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u043c\u043e\u0436\u043d\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433, \u041f\u0430\u043d \u0456 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0443\u0441\u044f\u0433\u043e, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0443\u0441\u0451 \u0456 \u045e\u043b\u0430\u0434\u043a\u0430\u0432\u0430\u045e, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043b\u044e\u0434\u0437\u0435\u0439, \u0430\u043b\u0435 \u0456 \u0431\u044b\u045e \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b \u0434\u0430 \u0456\u0445. \u0401\u043d \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u045e \u0442\u0430\u043a\u0456, \u0456 \u0451\u0441\u0446\u044c, \u0456 \u0431\u0443\u0434\u0437\u0435, \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u0456 \u0434\u043e\u0431\u0440\u044b, \u043d\u0435 \u0430\u0445\u0432\u043e\u0447\u044b \u0434\u0430 \u0433\u043d\u0435\u0432\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b, \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u0437\u0456\u043d \u0401\u043d \u0434\u043e\u0431\u0440\u044b. \u0417\u0430\u0434\u0443\u043c\u0430\u045e\u0448\u044b \u0432\u044f\u043b\u0456\u043a\u0456 \u0456 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b \u043d\u0430\u043c\u0435\u0440, \u0401\u043d \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u045e\u0441\u044f \u0456\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0421\u044b\u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u0443\u043b\u044c \u0442\u0440\u044b\u043c\u0430\u045e \u0443 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u045e \u0441\u0432\u043e\u0439 \u043c\u0443\u0434\u0440\u044b \u043d\u0430\u043c\u0435\u0440, \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u0401\u043d \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u045e \u043d\u0430\u0441 \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0431\u0435\u0437 \u0430\u043f\u0435\u043a\u0456. \u0410\u043b\u0435 \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u043f\u0440\u0430\u0437 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0430\u0434\u043a\u0440\u044b\u045e \u0456 \u043f\u0440\u0430\u044f\u0441\u043d\u0456\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u0443\u0441\u0451 \u0440\u0430\u0437\u0430\u043c: \u0456 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u042f\u0433\u043e \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u043c\u0456, \u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u042f\u0433\u043e, \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c. \u0425\u0442\u043e \u0437 \u043d\u0430\u0441 \u043a\u0430\u043b\u0456 \u0447\u0430\u043a\u0430\u045e \u0447\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u045e\u043b\u0430\u0434\u043a\u0430\u0432\u0430\u045e\u0448\u044b \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0421\u044b\u043d\u0430\u043c, \u0401\u043d \u0430\u0436 \u0434\u0430 \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430 \u0447\u0430\u0441\u0443 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u045e \u043d\u0430\u043c, \u0437\u0432\u0435\u0434\u0437\u0435\u043d\u044b\u043c \u0441\u0430 \u0441\u043b\u0443\u0448\u043d\u0430\u0433\u0430 \u0448\u043b\u044f\u0445\u0443 \u0431\u044f\u0437\u043b\u0430\u0434\u0434\u0437\u0435\u043c \u0441\u0442\u0440\u0430\u0441\u0446\u0435\u0439, \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u0433\u043d\u0430\u0441\u0446\u0456, \u0436\u044b\u0446\u044c \u043f\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u0432\u043e\u043b\u0456. \u0401\u043d \u043d\u0456 \u045e \u044f\u043a\u0456\u043c \u0440\u0430\u0437\u0435 \u043d\u0435 \u0446\u0435\u0448\u044b\u045e\u0441\u044f \u0437 \u043d\u0430\u0448\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e, \u0430\u043b\u0435 \u0446\u044f\u0440\u043f\u0435\u045e \u0456\u0445. \u0401\u043d \u043d\u0435 \u045e\u0445\u0432\u0430\u043b\u044f\u045e \u0442\u0430\u043a\u043e\u0433\u0430 \u0434\u043e\u045e\u0433\u0430\u0433\u0430 \u0447\u0430\u0441\u0443 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f, \u0430\u043b\u0435 \u0441\u0442\u0432\u0430\u0440\u0430\u045e \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456 \u0447\u0430\u0441 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0423 \u0442\u043e\u0439 \u0447\u0430\u0441 \u043d\u0430\u0448\u044b \u0441\u043f\u0440\u0430\u0432\u044b \u0434\u0430\u043a\u0430\u0437\u0430\u043b\u0456, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u0432\u0430\u0440\u0442\u044b\u044f \u0436\u044b\u0446\u0446\u044f, \u0430\u043b\u0435 \u0446\u044f\u043f\u0435\u0440 \u0411\u043e\u0436\u0430\u044f \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c \u0434\u0430\u043b\u0430 \u043d\u0430\u043c \u044f\u0433\u043e. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0448\u0430 \u043f\u0440\u0430\u0432\u0456\u043d\u0430 \u0431\u044b\u043b\u0430 \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430\u0439, \u043c\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0441\u0430\u043c\u0430\u0441\u0442\u043e\u0439\u043d\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0430\u043b\u0435 \u0411\u043e\u0436\u0430\u044f \u043c\u043e\u0446 \u0434\u0430\u043b\u0430 \u043d\u0430\u043c \u0433\u044d\u0442\u0443 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u043d\u0430\u0448\u0430\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0430 \u043c\u044f\u0436\u044b, \u0441\u0442\u0430\u043b\u0430 \u0446\u0430\u043b\u043a\u0430\u043c \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u044b\u043c, \u0448\u0442\u043e \u045e \u0430\u0434\u043f\u043b\u0430\u0442\u0443 \u0437\u0430 \u0433\u044d\u0442\u0430 \u043d\u0430\u0441 \u0447\u0430\u043a\u0430\u0435 \u043a\u0430\u0440\u0430 \u0441\u043c\u0435\u0440\u0446\u0456. \u0406 \u0442\u0430\u0434\u044b \u043d\u0430\u0434\u044b\u0448\u043e\u045e \u0447\u0430\u0441, \u044f\u043a\u0456 \u0411\u043e\u0433 \u043f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0440\u0430\u044f\u0432\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c \u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c (\u043e, \u0431\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0433\u0430 \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430!). \u0401\u043d \u043d\u0435 \u045e\u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u045e \u043d\u0430\u0441, \u0456 \u043d\u0435 \u0430\u0434\u043a\u0456\u043d\u0443\u045e, \u0456 \u043d\u0435 \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u045e \u043d\u0430\u043c, \u0430 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0437\u043d\u043e\u0441\u0456\u045e \u0456 \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u043d\u0430\u0441. \u041f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e\u0448\u044b, \u0401\u043d \u0443\u0437\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456, \u0430\u0434\u0434\u0430\u045e \u0443\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u044f\u043a \u043f\u043b\u0430\u0442\u0443 \u0437\u0430 \u043d\u0430\u0448\u0430\u0435 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435, \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0437\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044b\u0445, \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0437\u043b\u0430 \u0437\u0430 \u0437\u043b\u044b\u0445, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0437\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445, \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0437\u0430 \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c&shy;\u043d\u044b\u0445, \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0437\u0430 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u0445. \u0411\u043e \u0448\u0442\u043e \u044f\u0448\u0447\u044d \u043c\u0430\u0433\u043b\u043e \u0437\u0430\u043a\u0440\u044b\u0446\u044c \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456, \u044f\u043a \u043d\u0435 \u042f\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c? \u0423 \u043a\u0456\u043c \u0456\u043d\u0448\u044b\u043c \u043c\u044b, \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f \u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u044f, \u043c\u043e\u0436\u0430\u043c \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435, \u044f\u043a \u043d\u0435 \u045e \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0421\u044b\u043d\u0435 \u0411\u043e\u0436\u044b\u043c?<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0430\u0431\u043c\u0435\u043d, \u044f\u043a\u0430\u044f \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u043d\u0435\u0447\u0430\u043a\u0430\u043d\u0430\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430! \u0411\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u043c\u043d\u043e\u0433\u0456\u0445 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u0430\u0434\u0437\u0456\u043d \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0456\u043a, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435 \u043c\u043d\u043e\u0433\u0456\u0445 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445!<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0437 4, 12; \u0406\u0441 9, 6<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043d\u044f\u043c\u0430 \u043d\u0456 \u045e \u043a\u0456\u043c \u0456\u043d\u0448\u044b\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u0456\u043c\u044f \u043f\u0430\u0434 \u043d\u0435\u0431\u0430\u043c, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u043b\u044e\u0434\u0437\u044f\u043c, \u0443 \u044f\u043a\u0456\u043c \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u0434\u0430\u0434\u0443\u0446\u044c \u0456\u043c\u044f \u042f\u043c\u0443: \u0426\u0443\u0434\u043e\u045e\u043d\u044b \u0414\u0430\u0440\u0430\u0434\u0447\u044b\u043a, \u0411\u043e\u0433 \u041c\u043e\u0446\u043d\u044b, \u0421\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b \u0410\u0439\u0446\u0435\u0446, \u041a\u043d\u044f\u0437\u044c \u0421\u043f\u0430\u043a\u043e\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u0456\u043c\u044f \u043f\u0430\u0434 \u043d\u0435\u0431\u0430\u043c, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u043b\u044e\u0434\u0437\u044f\u043c, \u0443 \u044f\u043a\u0456\u043c \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"444","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u044f\u045e&raquo; \u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 3, 20, 2-3: SCh 34, 342-344)<\/span><br \/><em><span style=\"color: #ff0000;\">\u042d\u043a\u0430\u043d\u043e\u043c\u0456\u044f \u0437\u0431\u0430\u045e\u0447\u0430\u0433\u0430 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u0430\u0432\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 &ndash; \u0411\u043e\u0433, \u0430\u043b\u0435 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u0411\u043e\u0433\u0430, \u0443\u0441\u044f \u042f\u0433\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u043c\u043e\u0446 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043b\u0435\u043a\u0430\u0440 \u043f\u0440\u0430\u0432\u044f\u0440\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0445\u0432\u0430\u0440\u044d\u0435, \u0442\u0430\u043a \u0411\u043e\u0433 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u043b\u044e\u0434\u0437\u044f\u0445. \u0422\u0430\u043c\u0443 \u0456 \u043a\u0430\u0436\u0430 \u041f\u0430\u0432\u0435\u043b: &laquo;\u0411\u043e\u0433 \u0437\u0430\u043c\u043a\u043d\u0443\u045e \u0443\u0441\u0456\u0445 \u0443 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u0443\u0441\u0456\u0445 \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u0446\u044c&raquo; (\u043f\u0430\u0440. \u0420\u044b\u043c 11, 32). \u041f\u0430\u0432\u0435\u043b \u043c\u0435\u045e \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0443 \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c. \u041f\u043e\u0442\u044b\u043c \u0451\u043d \u0437\u0432\u0435\u0434\u0430\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u043f\u0440\u0430\u0437 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0442\u043e\u0435 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0441\u0442\u0430\u043b\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u044b\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0425\u0440\u044b\u0441\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u044b \u0436 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u0435 \u0431\u0435\u0437 \u043c\u0430\u0440\u043d\u0430\u0439 \u043f\u044b\u0445\u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0443\u044e \u0441\u043b\u0430\u0432\u0443 \u045e\u0441\u044f\u0433\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0433\u0430 \u0456 \u0441\u0430\u043c\u043e\u0433\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f (\u0430 \u0433\u044d\u0442\u0430 \u043d\u0430\u0439\u043c\u0430\u0433\u0443\u0442\u043d\u0435\u0439\u0448\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u045e\u0441\u0451 \u043d\u0430\u0434\u0437\u044f\u043b\u044f\u0435 \u0431\u044b\u0446\u0446\u0451\u043c), \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0456 \u045e\u0434\u0437\u044f\u0447\u043d\u044b\u043c \u042f\u043c\u0443, \u0451\u043d \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0441\u043b\u0430\u0432\u0443, \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u044e\u0447\u044b \u045e \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0435 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0415\u0437\u0443\u0441 \u0441\u0442\u0430\u045e &laquo;\u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430&raquo;, \u043a\u0430\u0431 \u0430\u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0433\u0440\u044d\u0445 \u0456 \u0432\u044b\u043a\u0456\u043d\u0443\u0446\u044c \u044f\u0433\u043e, \u044f\u043a \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u0430\u0433\u0430, \u0437 \u0446\u0435\u043b\u0430; \u043a\u0430\u0431 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0441\u0442\u0430\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u042f\u043c\u0443 (\u043f\u0430\u0440. \u0420\u044b\u043c 8, 3), \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0430, \u0434\u0430\u044e\u0447\u044b \u044f\u043c\u0443 \u0430\u0439\u0446\u043e\u045e\u0441\u043a\u0443\u044e \u045e\u043b\u0430\u0434\u0443, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u0431\u0430\u0447\u044b\u045e \u0411\u043e\u0433\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u044e\u0447\u044b \u044f\u043c\u0443 \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u043d\u0443\u0446\u044c \u0410\u0439\u0446\u0430. \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0456 \u0441\u0442\u0430\u043b\u0430 \u0421\u044b\u043d\u0430\u043c \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c, \u043a\u0430\u0431 \u043f\u0440\u044b\u0437\u0432\u044b\u0447\u0430\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u045e\u0441\u043f\u0440\u044b\u043c\u0430\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u043f\u0440\u044b&shy;\u0437\u0432\u044b\u0447\u0430\u0456\u0446\u044c \u0411\u043e\u0433\u0430 \u0436\u044b\u0446\u044c \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0442\u0430\u0433\u043e, \u044f\u043a \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e \u0410\u0439\u0446\u0435\u0446.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u0430\u043c \u041f\u0430\u043d \u0434\u0430\u045e \u044f\u043a &laquo;\u0437\u043d\u0430\u043a&raquo; \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0451\u0441\u0446\u044c \u042d\u043c\u043c\u0430\u043d\u0443\u044d\u043b\u0435\u043c, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u043c \u0430\u0434 \u0414\u0437\u0435\u0432\u044b. \u0421\u0430\u043c \u041f\u0430\u043d \u0431\u044b\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u0431\u0430\u045e\u043b\u044f\u045e \u043b\u044e\u0434\u0437\u0435\u0439, \u0431\u043e \u044f\u043d\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0437\u0431\u0430\u0432\u0456\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u0456\u043b\u0430\u043c\u0456. \u0406 \u0442\u0430\u043c\u0443 \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430, \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e\u0447\u044b \u043b\u044e\u0434\u0441\u043a\u043e\u0435 \u0431\u044f\u0441\u0441\u0456\u043b\u043b\u0435: &laquo;\u0412\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u043d\u0435 \u0436\u044b\u0432\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0443 \u0446\u0435\u043b\u0435 \u043c\u0430\u0456\u043c, \u0434\u043e\u0431\u0440\u0430\u0435&raquo; (\u0420\u044b\u043c 7, 18), \u043c\u0430\u044e\u0447\u044b \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435 \u0430\u0434 \u043d\u0430\u0441, \u0430\u043b\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0406 \u044f\u0448\u0447\u044d: &laquo;\u041d\u044f\u0448\u0447\u0430\u0441\u043d\u044b \u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u0425\u0442\u043e \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043c\u044f\u043d\u0435 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u0456?&raquo; (\u0420\u044b\u043c 7, 24). \u0410 \u043f\u0430\u0441\u043b\u044f \u045e\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u0435\u043b\u044f: &laquo;\u041b\u0430\u0441\u043a\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430&raquo; (\u043f\u0430\u0440. \u0420\u044b\u043c 7, 25).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435 \u0436 \u043a\u0430\u0436\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0406\u0441\u0430\u044f: &laquo;\u0423\u043c\u0430\u0446\u0443\u0439\u0446\u0435 \u0441\u043b\u0430\u0431\u044b\u044f \u0440\u0443\u043a\u0456, \u0443\u0437\u043c\u0430\u0446\u043d\u0456\u0446\u0435 \u0434\u0440\u044b\u0436\u0430\u0447\u044b\u044f \u043a\u0430\u043b\u0435\u043d\u0456. \u0421\u043a\u0430\u0436\u044b\u0446\u0435 \u043c\u0430\u043b\u0430\u0434\u0443\u0448\u043d\u044b\u043c: &ldquo;\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0430\u0434\u0432\u0430\u0436\u043d\u044b\u043c\u0456, \u043d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f! \u0412\u043e\u0441\u044c \u0411\u043e\u0433 \u0432\u0430\u0448, \u043f\u043e\u043c\u0441\u0442\u0430 \u043f\u0440\u044b\u0439\u0434\u0437\u0435; \u0430\u0434\u043f\u043b\u0430\u0442\u0430 \u0411\u043e\u0436\u0430\u044f. \u0401\u043d \u0441\u0430\u043c \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0432\u0430\u0441&rdquo;&raquo; (\u043f\u0430\u0440. \u0406\u0441 35, 4). \u0411\u043e \u043d\u0435 \u043f\u0440\u0430\u0437 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0437 \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0431\u0430\u0432\u0456\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0415\u0440 31, 10; 4, 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u043d\u0430\u0440\u043e\u0434\u044b, \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u0446\u0435 \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456 <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043d\u0430 \u0434\u0430\u043b\u0451\u043a\u0456\u0445 \u0430\u0441\u0442\u0440\u0430\u0432\u0430\u0445 \u043a\u0430\u0436\u044b\u0446\u0435: \u0417\u0431\u0430\u045e\u0446\u0430 \u043d\u0430\u0448 \u043f\u0440\u044b\u0439\u0434\u0437\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u0446\u0435 \u0456 \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u043a\u0430\u0436\u044b\u0446\u0435 \u0456 \u043a\u0440\u044b\u0447\u044b\u0446\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043d\u0430 \u0434\u0430\u043b\u0451\u043a\u0456\u0445 \u0430\u0441\u0442\u0440\u0430\u0432\u0430\u0445 \u043a\u0430\u0436\u044b\u0446\u0435: \u0417\u0431\u0430\u045e\u0446\u0430 \u043d\u0430\u0448 \u043f\u0440\u044b\u0439\u0434\u0437\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"445","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u045e \u0433\u043e\u043d\u0430\u0440 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456&raquo; \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 4, 8-9: Opera omnia, \u0415dit. Cisterc. 4 [1966], 53-54)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0423\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0447\u0430\u043a\u0430\u0435 \u0430\u0434\u043a\u0430\u0437\u0443 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0430\u0447\u0443\u043b\u0430, \u0414\u0437\u0435\u0432\u0430, \u0448\u0442\u043e \u0437\u0430\u0447\u043d\u0435\u0448 \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0421\u044b\u043d\u0430. \u0422\u044b \u043f\u0430\u0447\u0443\u043b\u0430, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u0446\u0430 \u043d\u0435 \u043f\u0440\u0430\u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u0410\u043d\u0451\u043b \u0447\u0430\u043a\u0430\u0435 \u0430\u0434\u043a\u0430\u0437\u0443, \u0431\u043e \u043d\u0430\u0441\u0442\u0430\u045e \u0447\u0430\u0441 \u044f\u043c\u0443 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u044f\u0433\u043e. \u041e \u041f\u0430\u043d\u0456, \u0441\u043b\u043e\u0432\u0430 \u043b\u0456\u0442\u0430\u0441\u0446\u0456 \u0447\u0430\u043a\u0430\u0435\u043c \u0456 \u043c\u044b, \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u044f \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u044f \u043f\u0440\u044b\u0441\u0443\u0434\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0422\u0430\u0431\u0435 \u043f\u0440\u0430\u043f\u0430\u043d\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0446\u0430\u043d\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430. \u041a\u0430\u043b\u0456 \u0422\u044b \u0437\u0433\u043e\u0434\u0437\u0456\u0448\u0441\u044f, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0430\u0434\u0440\u0430\u0437\u0443 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b. \u0423\u0441\u0435 \u043c\u044b \u0431\u044b\u043b\u0456 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b\u043c \u0411\u043e\u0436\u044b\u043c \u0421\u043b\u043e\u0432\u0430\u043c, \u0456 \u0432\u043e\u0441\u044c, \u043f\u0430\u043c\u0456\u0440\u0430\u0435\u043c. \u0410 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0432\u0430\u0439\u043c\u0443 \u043a\u0430\u0440\u043e\u0442\u043a\u0430\u043c\u0443 \u0430\u0434\u043a\u0430\u0437\u0443 \u043d\u0430\u043c \u043d\u0430\u043a\u0430\u043d\u0430\u0432\u0430\u043d\u0430 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u0446\u0430 \u0456 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431 \u0433\u044d\u0442\u044b\u043c \u0426\u044f\u0431\u0435 \u043c\u043e\u043b\u0456\u0446\u044c, \u043e \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u0430\u044f \u0414\u0437\u0435\u0432\u0430, \u0432\u0430\u0440\u0442\u044b \u0441\u043b\u0451\u0437 \u0410\u0434\u0430\u043c, \u0432\u044b\u0433\u043d\u0430\u043d\u044b \u0437 \u0440\u0430\u044e, \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u043c\u0456 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u043c\u0456, \u0430\u0431 \u0433\u044d\u0442\u044b\u043c \u043c\u043e\u043b\u0456\u0446\u044c \u0410\u0431\u0440\u0430\u0433\u0430\u043c, \u0430\u0431 \u0433\u044d\u0442\u044b\u043c \u043c\u043e\u043b\u0456\u0446\u044c \u0414\u0430\u0432\u0456\u0434. \u0413\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u044f\u0442\u044b\u044f \u0430\u0439\u0446\u044b, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0422\u0432\u0430\u0435 \u0430\u0439\u0446\u044b, \u044f\u043a\u0456\u044f \u0456 \u0441\u0430\u043c\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u045e \u043a\u0440\u0430\u0456\u043d\u0435 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0446\u0435\u043d\u044e. \u0413\u044d\u0442\u0430\u0433\u0430 \u0447\u0430\u043a\u0430\u0435 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442, \u0440\u0430\u0441\u043f\u0430\u0441\u0446\u0451\u0440\u0448\u044b\u0441\u044f \u043a\u0430\u043b\u044f \u0422\u0432\u0430\u0456\u0445 \u043a\u0430\u043b\u0435\u043d\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043b\u0443\u0448\u043d\u0430, \u0431\u043e \u0430\u0434 \u0422\u0432\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u0445, \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u0445, \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b\u0445 \u0456, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u0441\u044b\u043d\u043e\u045e \u0410\u0434\u0430\u043c\u0430, \u0443\u0441\u044f\u0433\u043e \u0422\u0432\u0430\u0439\u0433\u043e \u0440\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041e, \u0414\u0437\u0435\u0432\u0430, \u043f\u0430\u0441\u043f\u044f\u0448\u0430\u0439\u0441\u044f \u0434\u0430\u0446\u044c \u0430\u0434\u043a\u0430\u0437. \u0425\u0443\u0442\u0447\u044d\u0439 \u0430\u0434\u043a\u0430\u0436\u044b \u0430\u043d\u0451\u043b\u0443, \u0430 \u043f\u0440\u0430\u0437 \u0430\u043d\u0451\u043b\u0430 &ndash; \u041f\u0430\u043d\u0443. \u0410\u0434\u043a\u0430\u0436\u044b \u0441\u043b\u043e\u0432\u0430\u043c \u0456 \u043f\u0440\u044b\u043c\u0456 \u0421\u043b\u043e\u0432\u0430. \u0421\u043a\u0430\u0436\u044b \u0441\u0432\u0430\u0451 \u0441\u043b\u043e\u0432\u0430, \u0430 \u043f\u0440\u044b\u043c\u0456 \u0411\u043e\u0436\u0430\u0435. \u0412\u044b\u043c\u0430\u0432\u0456 \u0447\u0430\u0441\u043e\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0439 \u0412\u0435\u0447\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043c\u0443 \u0422\u044b \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0448? \u0427\u0430\u043c\u0443 \u0431\u044f\u043d\u0442\u044d\u0436\u044b\u0448\u0441\u044f? \u041f\u0430\u0432\u0435\u0440, \u0437\u0433\u0430\u0434\u0437\u0456\u0441\u044f \u0456 \u043f\u0440\u044b\u043c\u0456. \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u043a\u043e\u0440\u0430 \u0437\u0434\u0430\u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0432\u0430\u0433\u0443, \u0430 \u0441\u0430\u0440\u0430\u043c\u043b\u0456\u0432\u0430\u0441\u0446\u044c &ndash; \u0434\u0430\u0432\u0435\u0440. \u0425\u043e\u0446\u044c \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u0432\u044b\u043f\u0430\u0434\u0430\u0435, \u043a\u0430\u0431 \u0446\u044f\u043f\u0435\u0440 \u0443 \u0441\u0432\u0430\u0451\u0439 \u0434\u0437\u044f\u0432\u043e\u0447\u0430\u0439 \u043f\u0440\u0430\u0441\u0442\u0430\u0446\u0435 \u0422\u044b \u0433\u0443\u0431\u043b\u044f\u043b\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0430\u0434\u043d\u0430\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0430\u0434\u043d\u043e\u0439 \u0433\u044d\u0442\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u043d\u0435 \u0431\u043e\u0439\u0441\u044f, \u043e \u043c\u0443\u0434\u0440\u0430\u044f \u0414\u0437\u0435\u0432\u0430, \u043d\u0435 \u0431\u043e\u0439\u0441\u044f \u0434\u0437\u0451\u0440\u0437\u043a\u0430\u0441\u0446\u0456, \u0431\u043e \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0441\u0430\u0440\u0430\u043c\u043b\u0456\u0432\u0430\u0435 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435 \u0456 \u0434\u043e\u0431\u0440\u0430\u0435, \u0430\u0434\u043d\u0430\u043a \u0446\u044f\u043f\u0435\u0440 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0441\u043b\u043e\u0432\u0430 \u043b\u0456\u0442\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043a\u0440\u044b\u0439, \u043e \u0448\u0447\u0430\u0441\u043d\u0430\u044f \u0414\u0437\u0435\u0432\u0430, \u0441\u044d\u0440\u0446\u0430 \u0434\u043b\u044f \u0432\u0435\u0440\u044b, \u0432\u0443\u0441\u043d\u044b \u0434\u043b\u044f \u0437\u0433\u043e\u0434\u044b, \u0443\u043b\u043e\u043d\u043d\u0435 \u0434\u043b\u044f \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f. \u0412\u043e\u0441\u044c, \u043f\u0430\u0436\u0430\u0434\u0430\u043d\u044b \u045e\u0441\u0456\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456 \u0441\u0442\u0443\u043a\u0430\u0435 \u0437\u0432\u043e\u043d\u043a\u0443 \u045e \u0434\u0437\u0432\u0435\u0440\u044b. \u041e, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0422\u0432\u0430\u044e \u043d\u044f\u0441\u043f\u0435\u0448\u043d\u0430\u0441\u0446\u044c \u0401\u043d \u043f\u0440\u043e\u0439\u0434\u0437\u0435 \u043c\u0456\u043c\u0430, \u0422\u044b \u0437\u043d\u043e\u045e \u0431\u0443\u0434\u0437\u0435\u0448 \u0448\u0443\u043a\u0430\u0446\u044c \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0442\u0430\u043a \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0430 \u0422\u0432\u0430\u044f \u0434\u0443\u0448\u0430! \u041f\u0430\u0434\u044b\u043c\u0456\u0441\u044f, \u0431\u044f\u0436\u044b \u0456 \u0430\u0434\u043a\u0440\u044b\u0439! \u041f\u0430\u0434\u044b\u043c\u0456\u0441\u044f \u0437 \u0432\u0435\u0440\u0430\u0439, \u0431\u044f\u0436\u044b \u0437 \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044e \u0456 \u0430\u0434\u043a\u0440\u044b\u0439 \u0441\u0430 \u0437\u0433\u043e\u0434\u0430\u0439. \u041c\u0430\u0440\u044b\u044f \u043a\u0430\u0436\u0430: &laquo;\u0412\u043e\u0441\u044c \u044f, \u0441\u043b\u0443\u0433\u0430 \u041f\u0430\u043d\u0430. \u041d\u044f\u0445\u0430\u0439 \u043c\u043d\u0435 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u043e\u0432\u0430&raquo; (\u041b\u043a 1, 38).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041b\u043a 1, 31. 42<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430, \u0414\u0437\u0435\u0432\u0430 \u041c\u0430\u0440\u044b\u044f, \u044f\u043a\u043e\u0435 \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0422\u0430\u0431\u0435 \u0430\u043d\u0451\u043b\u0430\u043c \u0430\u0434 \u041f\u0430\u043d\u0430. \u0422\u044b \u0437\u0430\u0447\u043d\u0435\u0448 \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0411\u043e\u0433\u0430 \u0456 \u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0439 \u0431\u0443\u0434\u0437\u0435\u0448 \u043d\u0430\u0437\u0432\u0430\u043d\u0430 \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0421\u044b\u043d\u0430 \u0456 \u043d\u0435 \u043f\u0430\u0440\u0443\u0448\u044b\u0448 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430. \u0422\u044b \u0437\u0430\u0446\u044f\u0436\u0430\u0440\u044b\u0448 \u0456 \u0441\u0442\u0430\u043d\u0435\u0448 \u043d\u0430\u0432\u0435\u043a\u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u044e \u041c\u0430\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0439 \u0431\u0443\u0434\u0437\u0435\u0448 \u043d\u0430\u0437\u0432\u0430\u043d\u0430 \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"446","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041b\u0443\u043a\u0456&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 2, 19. 22-23. 26-27: CCL 14, 39-42)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0414\u0437\u0435\u0432\u0430 \u041c\u0430\u0440\u044b\u044f \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u0435 \u0410\u043b\u044c\u0436\u0431\u0435\u0442\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0432\u0435\u0440\u0443 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0443\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e, \u0430\u043d\u0451\u043b \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u045e \u043f\u0430\u0434\u0447\u0430\u0441 \u0437\u0432\u0435\u0441\u0442\u0430\u0432\u0430\u043d\u043d\u044f \u0414\u0437\u0435\u0432\u0435 \u041c\u0430\u0440\u044b\u0456, \u0448\u0442\u043e \u0441\u0442\u0430\u0440\u0430\u044f \u0456 \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0437\u0430\u0447\u0430\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u041c\u0430\u0440\u044b\u044f \u043f\u0430\u0447\u0443\u043b\u0430 \u0433\u044d\u0442\u0430, \u044f\u043d\u0430 \u043d\u0435 \u0437\u043d\u044f\u0432\u0435\u0440\u044b\u043b\u0430\u0441\u044f \u045e \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0435, \u043d\u0435 \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0430 \u0434\u0430\u0432\u0435\u0440\u0443 \u0434\u0430 \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0433\u0430 \u0456 \u043d\u0435 \u0437\u0430\u0441\u0443\u043c\u043d\u044f\u0432\u0430\u043b\u0430\u0441\u044f, \u0430\u043b\u0435 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044e, \u043f\u0430\u0431\u043e\u0436\u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0456 \u0430\u0434 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u043f\u0430\u0441\u043f\u0435\u0448\u043b\u0456\u0432\u0430 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u045e \u0433\u043e\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u043a\u0443\u0434\u044b \u045e\u0436\u043e \u0431\u044b\u043b\u043e \u0441\u043f\u044f\u0448\u0430\u0446\u0446\u0430 \u043f\u043e\u045e\u043d\u0430\u0439 \u0411\u043e\u0433\u0430 \u041c\u0430\u0440\u044b\u0456, \u044f\u043a \u043d\u0435 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u0456? \u041b\u0430\u0441\u043a\u0430 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043d\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0446\u044c. \u0410\u0434\u0440\u0430\u0437\u0443 \u0436 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u0446\u0430 \u0434\u0430\u0431\u0440\u043e\u0442\u044b, \u044f\u043a\u0456\u044f \u043d\u044f\u0441\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u041c\u0430\u0440\u044b\u0456 \u0456 \u0411\u043e\u0436\u0430\u044f \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c. &laquo;\u041a\u0430\u043b\u0456 \u0410\u043b\u044c\u0436\u0431\u0435\u0442\u0430 \u043f\u0430\u0447\u0443\u043b\u0430 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435 \u041c\u0430\u0440\u044b\u0456, \u0443\u0437\u0432\u0430\u0440\u0443\u0445\u043d\u0443\u043b\u0430\u0441\u044f \u0434\u0437\u0456\u0446\u044f\u0442\u043a\u0430 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u044f\u0435, \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0410\u043b\u044c\u0436\u0431\u0435\u0442\u0430 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c&raquo; (\u043f\u0430\u0440. \u041b\u043a 1, 41).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0430\u0434\u0440\u043e\u0437\u043d\u0435\u043d\u043d\u0435 \u0456 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0430\u0441\u043e\u0431\u043d\u044b\u0445 \u0441\u043b\u043e\u045e. \u0410\u043b\u044c\u0436\u0431\u0435\u0442\u0430 \u043f\u0435\u0440\u0448\u0430\u044f \u043f\u0430\u0447\u0443\u043b\u0430 \u0441\u043b\u043e\u0432\u0430, \u0430\u043b\u0435 \u042f\u043d \u043f\u0435\u0440\u0448\u044b \u0430\u0434\u0447\u0443\u045e \u043b\u0430\u0441\u043a\u0443. \u042f\u043d\u0430 \u043f\u0430\u0447\u0443\u043b\u0430 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c, \u0451\u043d \u0443\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f &ndash; \u0442\u0430\u044f\u043c\u043d\u0456\u0447\u044b\u043c. \u042f\u043d\u0430 \u0430\u0434\u0447\u0443\u043b\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u041c\u0430\u0440\u044b\u0456, \u0451\u043d &ndash; \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u041f\u0430\u043d\u0430, \u0436\u0430\u043d\u0447\u044b\u043d\u0430 &ndash; \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u0456 \u0434\u0437\u0456\u0446\u044f &ndash; \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0414\u0437\u0456\u0446\u044f\u0446\u0456. \u0417\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u044b \u0446\u0443\u0434: \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u0433\u0430\u0432\u043e\u0440\u0430\u0446\u044c \u043f\u0440\u0430 \u043b\u0430\u0441\u043a\u0443, \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u044b \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0446\u044c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u043b\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u0441\u0430\u043c\u0456\u0445 \u043c\u0430\u0446\u0456, \u043c\u0430\u0446\u0456 \u043f\u0440\u0430\u0440\u043e\u0447\u0430\u0446\u044c, \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u044f \u0434\u0437\u0435\u0446\u044c\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0434\u0437\u0456\u0446\u044f\u0442\u043a\u0430, \u0430 \u043c\u0430\u0446\u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c. \u041c\u0430\u0446\u0456 \u043d\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0406\u043c \u0440\u0430\u043d\u0435\u0439 \u0437\u0430 \u0441\u044b\u043d\u0430, \u0430\u043b\u0435 \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u0441\u044b\u043d \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0456 \u043c\u0430\u0446\u0456. \u0423\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u042f\u043d, \u0443\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0456 \u0434\u0443\u0445 \u041c\u0430\u0440\u044b\u0456. \u041a\u0430\u043b\u0456 \u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u042f\u043d, \u0410\u043b\u044c\u0436\u0431\u0435\u0442\u0430 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c. \u0410\u0434\u043d\u0430\u043a \u043c\u044b \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u041c\u0430\u0440\u044b\u044f \u0442\u0430\u0434\u044b \u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u043d\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0448\u044b\u0441\u044f \u0414\u0443\u0445\u0430\u043c, \u0431\u043e \u041d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u044b \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u0430 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u045e \u0443 \u041c\u0430\u0446\u0456. \u0410\u043b\u044c\u0436\u0431\u0435\u0442\u0430 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0414\u0443\u0445\u0430\u043c \u043f\u0430\u0441\u043b\u044f \u0437\u0430\u0447\u0430\u0446\u0446\u044f, \u0430 \u041c\u0430\u0440\u044b\u044f &ndash; \u043f\u0435\u0440\u0430\u0434 \u0437\u0430\u0447\u0430\u0446\u0446\u0435\u043c. &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f, &ndash; \u043a\u0430\u0436\u0430 \u0401\u0439 \u0410\u043b\u044c\u0436\u0431\u0435\u0442\u0430, &ndash; \u0431\u043e \u0422\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0430&raquo; (\u043f\u0430\u0440. \u041b\u043a 1, 45).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0456 \u0432\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u0431\u043e \u043f\u0430\u0447\u0443\u043b\u0456 \u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456. \u041a\u043e\u0436\u043d\u0430\u044f \u0434\u0443\u0448\u0430, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c, \u0437\u0430\u0447\u044b\u043d\u0430\u0435 \u0456 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u042f\u0433\u043e\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0443 \u043a\u043e\u0436\u043d\u044b\u043c \u0431\u0443\u0434\u0437\u0435 \u0434\u0443\u0448\u0430 \u041c\u0430\u0440\u044b\u0456, \u043a\u0430\u0431 \u0432\u0435\u043b\u0456\u0447\u0430\u0446\u044c \u041f\u0430\u043d\u0430. \u041d\u044f\u0445\u0430\u0439 \u0443 \u043a\u043e\u0436\u043d\u044b\u043c \u0431\u0443\u0434\u0437\u0435 \u0434\u0443\u0445 \u041c\u0430\u0440\u044b\u0456, \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0411\u043e\u0433\u0443. \u041a\u0430\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430 \u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0451\u0441\u0446\u044c \u0430\u0434\u043d\u0430 \u041c\u0430\u0446\u0456, \u0442\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0433\u044d\u0442\u0430 \u043f\u043b\u043e\u0434 \u0443\u0441\u0456\u0445. \u0411\u043e \u043a\u043e\u0436\u043d\u0430\u044f \u0434\u0443\u0448\u0430 \u043f\u0440\u044b\u043c\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u0430 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u044f \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u044f \u0430\u0434 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0430\u045e, \u043a\u0430\u043b\u0456 \u0437 \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u0430\u0439 \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0447\u044b\u0441\u0446\u0456\u043d\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043a\u043e\u0436\u043d\u0430\u044f \u0434\u0443\u0448\u0430, \u044f\u043a\u0430\u044f \u0437\u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0442\u0430\u043a\u043e\u0439, \u0432\u0435\u043b\u0456\u0447\u0430\u0435 \u041f\u0430\u043d\u0430 \u0442\u0430\u043a, \u044f\u043a \u0434\u0443\u0448\u0430 \u041c\u0430\u0440\u044b\u0456 \u0432\u0435\u043b\u0456\u0447\u0430\u043b\u0430 \u041f\u0430\u043d\u0430 \u0456 \u044f\u043a \u042f\u0435 \u0434\u0443\u0445 \u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u045e \u0411\u043e\u0433\u0443, \u0417\u0431\u0430\u045e\u0446\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0447\u044b\u0442\u0430\u0435\u043c \u0443 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b: &laquo;\u0423\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0439 \u041f\u0430\u043d\u0430 \u0441\u0430 \u043c\u043d\u043e\u0439&raquo; (\u043f\u0430\u0440. \u041f\u0441 34 [33], 4). \u041f\u0430\u043d \u0443\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043b\u044e\u0434\u0441\u043a\u043e\u0435 \u0441\u043b\u043e\u0432\u0430 \u043c\u043e\u0436\u0430 \u043d\u0435\u0448\u0442\u0430 \u0434\u0430\u0434\u0430\u0446\u044c \u0434\u0430 \u0432\u0435\u043b\u0456\u0447\u044b \u041f\u0430\u043d\u0430, \u0430\u043b\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0401\u043d \u0443\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u043d\u0430\u0441. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0433\u044d\u0442\u0430 \u0432\u043e\u0431\u0440\u0430\u0437 \u0411\u043e\u0436\u044b, \u0456 \u0442\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0434\u0443\u0448\u0430 \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u043d\u0435\u0448\u0442\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0435 \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0435, \u044f\u043d\u0430 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435 \u0442\u043e\u0439 \u0432\u043e\u0431\u0440\u0430\u0437 \u0411\u043e\u0436\u044b, \u043d\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u044f\u043a\u043e\u0433\u0430 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430. \u0410 \u043a\u0430\u043b\u0456 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435 \u044f\u0433\u043e, \u043f\u0440\u0430\u0437 \u043f\u044d\u045e\u043d\u044b \u0443\u0434\u0437\u0435\u043b \u0443 \u0432\u0435\u043b\u0456\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u0443\u0437\u0432\u044b\u0448\u0430\u0435\u0446\u0446\u0430 \u0456 \u0441\u0430\u043c\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 1, 45. 46; \u041f\u0441 66 (65), 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0430, \u0448\u0442\u043e \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0435 \u0401\u0439 \u041f\u0430\u043d\u0430\u043c. \u0406 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u041c\u0430\u0440\u044b\u044f: <span style=\"color: #ff0000;\">*<\/span> \u0412\u0435\u043b\u0456\u0447\u0430\u0435 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u0456 \u0440\u0430\u0441\u043a\u0430\u0436\u0443, \u044f\u043a\u0456\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0411\u043e\u0433 \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u043b\u044f \u043c\u0430\u0451\u0439 \u0434\u0443\u0448\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0435\u043b\u0456\u0447\u0430\u0435 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"447","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041b\u0443\u043a\u0456&raquo; \u0441\u0432. \u0411\u044d\u0434\u044b \u0412\u044f\u043b\u0435\u0431\u043d\u0430\u0433\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 1, 46-55: CCL 120, 37-39)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u0435\u043b\u0456\u0447\u0430\u0435 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u041f\u0430\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u041c\u0430\u0440\u044b\u044f: &laquo;\u0412\u0435\u043b\u0456\u0447\u0430\u0435 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u041f\u0430\u043d\u0430, \u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0434\u0443\u0445 \u043c\u043e\u0439 \u0443 \u0411\u043e\u0433\u0443, \u043c\u0430\u0456\u043c \u0417\u0431\u0430\u045e\u0446\u0443&raquo; (\u041b\u043a 1, 46).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0440\u044b\u044f \u0441\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u041f\u0430\u043d \u0443\u0437\u0432\u044f\u043b\u0456\u0447\u044b\u045e \u041c\u044f\u043d\u0435 \u0442\u0430\u043a\u0456\u043c \u043d\u0435\u0447\u0443\u0432\u0430\u043d\u044b\u043c \u0434\u0430\u0440\u0430\u043c, \u044f\u043a\u0456 \u043d\u0435\u043b\u044c\u0433\u0430 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0456\u044f\u043a\u0456\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0456 \u043b\u0435\u0434\u0437\u044c\u0432\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0436\u043d\u0430 \u045e\u0445\u0430\u043f\u0456\u0446\u044c \u043d\u0430\u0439\u0433\u043b\u044b\u0431\u0435\u0439\u0448\u044b\u043c\u0456 \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u043c\u0456 \u0441\u044d\u0440\u0446\u0430. \u0422\u0430\u043c\u0443 \u045e\u0441\u0435 \u0441\u0456\u043b\u044b \u0434\u0443\u0448\u044b \u042f \u0430\u0445\u0432\u044f\u0440\u0443\u044e \u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0439 \u043f\u0430\u0434\u0437\u044f\u043a\u0456, \u0443\u0441\u0451 \u0430\u0445\u0432\u044f\u0440\u0443\u044e \u043d\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0432\u0435\u043b\u0456\u0447 \u0442\u0430\u0433\u043e, \u043a\u0430\u043c\u0443 \u043d\u044f\u043c\u0430 \u043a\u0430\u043d\u0446\u0430. \u0423\u0441\u0451, \u0447\u044b\u043c \u0436\u044b\u0432\u0443, \u0448\u0442\u043e \u0430\u0434\u0447\u0443\u0432\u0430\u044e \u0456 \u0431\u0430\u0447\u0443, \u044f \u045e\u0434\u0437\u044f\u0447\u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0443\u044e, \u0431\u043e \u043c\u043e\u0439 \u0434\u0443\u0445 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0432\u0435\u0447\u043d\u0430\u0439 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456 \u0442\u0430\u0433\u043e \u0441\u0430\u043c\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0417\u0431\u0430\u045e\u0446\u044b, \u0437\u0430\u0447\u0430\u0446\u0446\u0435\u043c \u0443 \u0447\u0430\u0441\u0435 \u044f\u043a\u043e\u0433\u0430 \u0431\u044b\u043b\u043e \u0430\u043f\u043b\u043e\u0434\u043d\u0435\u043d\u0430 \u043c\u0430\u0451 \u0446\u0435\u043b\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0411\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u043c\u043d\u0435 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u0430 \u0456\u043c\u044f \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0435&raquo; (\u043f\u0430\u0440. \u041b\u043a 1, 49).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0430\u0434\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u0434\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0435\u0441\u043d\u0456, \u0434\u0437\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0412\u0435\u043b\u0456\u0447\u0430\u0435 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u041f\u0430\u043d\u0430&raquo;. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043d\u0430 \u0442\u0430\u044f \u0434\u0443\u0448\u0430, \u044f\u043a\u043e\u0439 \u041f\u0430\u043d \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u045e\u0447\u044b\u043d\u0456\u045e \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u043c\u043e\u0436\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0445\u0432\u0430\u043b\u044b \u0456, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u044e\u0447\u044b \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f \u0456 \u0433\u044d\u0442\u0430\u0439 \u0437\u0430\u0434\u0443\u043c\u044b, \u043a\u0430\u0437\u0430\u0446\u044c \u0456\u043c: &laquo;\u0423\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0439 \u041f\u0430\u043d\u0430 \u0441\u0430 \u043c\u043d\u043e\u0439, \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0437\u0432\u044b\u0448\u0430\u0446\u044c \u0456\u043c\u044f \u042f\u0433\u043e \u0440\u0430\u0437\u0430\u043c&raquo; (\u043f\u0430\u0440. \u041f\u0441 34 [33], 4).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u0437\u0430\u0445\u043e\u0447\u0430 \u045e\u0441\u0456\u043c\u0456 \u0441\u0456\u043b\u0430\u043c\u0456 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0446\u044c \u041f\u0430\u043d\u0430 \u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u0446\u044c \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435, &laquo;\u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u044b\u043c \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u041d\u044f\u0431\u0435\u0441\u043d\u044b\u043c&raquo; (\u041c\u0446 5, 19). \u0406\u043c\u044f \u0436 \u0411\u043e\u0436\u0430\u0435 \u0441\u0432\u044f\u0442\u043e\u0435, \u0431\u043e \u042f\u0433\u043e \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u044f\u043d\u0430 \u043d\u0435 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u043d\u0456 \u0437 \u0447\u044b\u043c, \u0448\u0442\u043e \u0401\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0440\u044b\u043d\u044f\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u0441\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c&raquo; (\u041b\u043a 1, 54).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0440\u044b\u044f \u043f\u0440\u044b\u0433\u043e\u0436\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u043b\u0443\u0433\u043e\u044e \u041f\u0430\u043d\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044c. \u041f\u0430\u043d \u0432\u044b\u0431\u0440\u0430\u045e \u044f\u0433\u043e, \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0433\u0430 \u0456 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430\u0433\u0430, \u0434\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u044f\u043a \u043a\u0430\u0436\u0430 \u041e\u0441\u0456\u044f: &laquo;\u0406\u0437\u0440\u0430\u044d\u043b\u044c &ndash; \u0441\u043b\u0443\u0433\u0430 \u041c\u043e\u0439, \u044f\u0433\u043e \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u042f&raquo; (\u043f\u0430\u0440. \u041e\u0441 11, 1).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u0446\u0446\u0430, \u043d\u0435 \u043c\u043e\u0436\u0430 \u043d\u0456 \u0437\u0431\u0430\u0432\u0456\u0446\u0446\u0430, \u043d\u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c: &laquo;\u0412\u043e\u0441\u044c \u0411\u043e\u0433 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u043c\u043d\u0435, \u041f\u0430\u043d \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043c\u0430\u0451 \u0436\u044b\u0446\u0446\u0451&raquo; (\u041f\u0441 54 [53], 6). \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u0446\u044c \u0441\u044f\u0431\u0435, \u044f\u043a \u0434\u0437\u0456\u0446\u044f, \u0442\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448\u044b\u043c \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u0411\u043e\u0436\u044b\u043c (\u043f\u0430\u0440. \u041c\u0446 18, 4).<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u042f\u043a \u0430\u0431\u044f\u0446\u0430\u045e \u0431\u0430\u0446\u044c\u043a\u0430\u043c \u043d\u0430\u0448\u044b\u043c, \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443 \u0456 \u044f\u0433\u043e \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0443 \u043d\u0430\u0432\u0435\u043a\u0456&raquo; (\u041b\u043a 1, 55).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0443\u0442 \u043c\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u043d\u0435 \u0444\u0456\u0437\u0456\u0447\u043d\u0430\u0435, \u0430\u043b\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u044f \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0456, \u0430\u043b\u0435 \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0439\u0448\u043e\u045e \u0441\u043b\u044f\u0434\u0430\u043c\u0456 \u044f\u0433\u043e\u043d\u0430\u0439 \u0432\u0435\u0440\u044b \u043d\u0435\u0437\u0430\u043b\u0435\u0436\u043d\u0430 \u0430\u0434 \u043d\u0430\u044f\u045e\u043d\u0430\u0441\u0446\u0456 \u0430\u0431\u043e \u0430\u0434\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f. \u0411\u043e \u0456 \u0441\u0430\u043c \u0410\u0431\u0440\u0430\u0433\u0430\u043c, \u044f\u0448\u0447\u044d \u043d\u0435 \u0431\u0443\u0434\u0443\u0447\u044b \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u043c, \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u0456 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u0430 \u044f\u043c\u0443 \u044f\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0441\u0446\u0435 \u0417\u0431\u0430\u045e\u0446\u044b \u0431\u044b\u043b\u043e \u043d\u0430\u0432\u0435\u043a\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443 \u0456 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u043c \u044f\u0433\u043e\u043d\u044b\u043c, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0441\u044b\u043d\u0430\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f, \u044f\u043a\u0456\u043c \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0436 \u0432\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u044f, \u0442\u043e \u0432\u044b \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u0456, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f, \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b&raquo; (\u0413\u0430\u043b 3, 29).<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043e\u0431\u0440\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u043c\u0430\u0446\u0456 \u041f\u0430\u043d\u0430 \u0456 \u042f\u043d\u0430 \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044f \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0431\u043e \u044f\u043a \u0433\u0440\u044d\u0445 \u043f\u0430\u0447\u0430\u045e\u0441\u044f \u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u045e, \u0442\u0430\u043a \u0456 \u0434\u0430\u0431\u0440\u043e \u043f\u0430\u0447\u0430\u043b\u043e\u0441\u044f \u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d. \u042f\u043a \u043f\u0440\u0430\u0437 \u043f\u0430\u0434\u043c\u0430\u043d \u0430\u0434\u043d\u043e\u0439 \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u0436\u044b\u0446\u0446\u0451 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430, \u0442\u0430\u043a \u0446\u044f\u043f\u0435\u0440 \u0436\u044b\u0446\u0446\u0451 \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u0435\u0442\u0443, \u043f\u0440\u0430 \u0448\u0442\u043e \u0441\u043f\u044f\u0448\u0430\u044e\u0446\u0446\u0430 \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u0434\u0437\u0432\u0435 \u0436\u0430\u043d\u0447\u044b\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 1, 48-50<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0426\u044f\u043f\u0435\u0440 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u043c\u044f\u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0441\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u043c\u043d\u0435 \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u0430 \u0456\u043c\u044f \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u042f\u0433\u043e \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u045e \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u0434 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u042f\u0433\u043e \u0431\u0430\u0456\u0446\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u043c\u043d\u0435 \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u0430 \u0456\u043c\u044f \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"448","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u0456 \u041d\u0430\u044d\u0442\u0430&raquo; \u0441\u0432. \u0413\u0456\u043f\u0430\u043b\u0456\u0442\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 9-12, PG 10, 815-819)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u0451\u0441\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433, \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u0451\u043c \u043d\u0456 \u0437 \u0447\u0430\u0433\u043e \u0456\u043d\u0448\u0430\u0433\u0430, \u044f\u043a \u0441\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u045e\u0441\u0451, \u0448\u0442\u043e \u044f\u043d\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u0435\u0434\u0430\u0446\u044c, \u0430 \u045e\u0441\u0451, \u0447\u0430\u043c\u0443 \u0432\u0443\u0447\u044b\u0446\u044c, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c. \u041c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0410\u0439\u0446\u0430 \u0442\u0430\u043a, \u044f\u043a \u0401\u043d \u0433\u044d\u0442\u0430\u0433\u0430 \u0445\u043e\u0447\u0430. \u041c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0421\u044b\u043d\u0430, \u044f\u043a \u0433\u044d\u0442\u0430\u0433\u0430 \u0445\u043e\u0447\u0430 \u0410\u0439\u0446\u0435\u0446. \u042f\u043a \u0401\u043d \u0445\u043e\u0447\u0430 \u0434\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0442\u0430\u043a \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u042f\u0433\u043e \u043f\u0440\u044b\u043c\u0430\u0446\u044c. \u041d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u0432\u043e\u043b\u0456, \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043b\u0430\u0441\u043d\u044b\u0445 \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u045e \u0456 \u043d\u0435 \u0441\u043a\u0430\u0436\u0430\u044e\u0447\u044b \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0411\u043e\u0433\u0430\u043c. \u0410\u043b\u0435 \u044f\u043a \u0401\u043d \u0441\u0430\u043c \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0442\u0430\u043a \u043c\u044b \u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u0431\u044b\u045e \u0430\u0434\u0437\u0456\u043d\u044b, \u0430\u043a\u0440\u0430\u043c\u044f \u042f\u0433\u043e \u045e \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0430, \u0456 \u0401\u043d \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0441\u0442\u0432\u0430\u0440\u044b\u0446\u044c \u0441\u0432\u0435\u0442. \u0406 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0441\u0432\u0435\u0442 \u0434\u0443\u043c\u043a\u0430\u0439, \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u0456 \u0441\u043b\u043e\u0432\u0430\u043c. \u0406 \u0441\u0432\u0435\u0442 \u0430\u0434\u0440\u0430\u0437\u0443 \u045e\u0437\u043d\u0456\u043a, \u044f\u043a \u0401\u043d \u0445\u0430\u0446\u0435\u045e, \u0456 \u044f\u043a \u044f\u0433\u043e \u045e\u043b\u0430\u0434\u043a\u0430\u0432\u0430\u045e. \u0414\u043b\u044f \u043d\u0430\u0441 \u0436\u0430 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0432\u0435\u0434\u0430\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u0442\u0430\u043a\u043e\u0433\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430, \u044f\u043a \u0411\u043e\u0433. \u041d\u0435 \u0431\u044b\u043b\u043e \u043d\u0456\u0447\u043e\u0433\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u042f\u0433\u043e. \u0401\u043d \u0430\u0434\u0437\u0456\u043d \u0431\u044b\u045e \u0443\u0441\u0456\u043c. \u0401\u043d \u0431\u044b\u045e \u0440\u043e\u0437\u0443\u043c\u0430\u043c, \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e, \u0443\u043b\u0430\u0434\u0430\u044e, \u0440\u0430\u0434\u0430\u044e. \u0423\u0441\u0451 \u0431\u044b\u043b\u043e \u045e \u0406\u043c, \u0456 \u0401\u043d \u0431\u044b\u045e \u0443\u0441\u0456\u043c. \u041a\u0430\u043b\u0456 \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0456 \u044f\u043a \u0437\u0430\u0445\u0430\u0446\u0435\u045e, \u0401\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0443 \u0447\u0430\u0441\u044b, \u044f\u043a\u0456\u044f \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0441\u0430\u043c, \u0441\u0432\u0430\u0451 \u0421\u043b\u043e\u0432\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u043c\u0435\u045e \u0443 \u0441\u0430\u0431\u0435, \u0431\u044b\u043b\u043e \u043d\u044f\u0431\u0430\u0447\u043d\u044b\u043c \u0434\u043b\u044f \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0401\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u042f\u0433\u043e \u0431\u0430\u0447\u043d\u044b\u043c, \u043f\u0430\u0441\u044b\u043b\u0430\u044e\u0447\u044b \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441. \u041d\u0430\u0440\u0430\u0434\u0436\u0430\u044e\u0447\u044b \u0421\u0432\u044f\u0442\u043b\u043e \u0430\u0434 \u0421\u0432\u044f\u0442\u043b\u0430, \u0401\u043d \u0434\u0430\u045e \u0441\u0430\u043c\u043e\u043c\u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044e \u041f\u0430\u043d\u0430, \u0441\u0432\u0430\u044e \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c. \u0406 \u0442\u0430\u0433\u043e, \u044f\u043a\u0456 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u045e \u0431\u0430\u0447\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u042f\u043c\u0443, \u0430\u043b\u0435 \u043d\u044f\u0431\u0430\u0447\u043d\u044b \u0441\u0432\u0435\u0442\u0443, \u0411\u043e\u0433 \u0443\u0447\u044b\u043d\u0456\u045e \u0431\u0430\u0447\u043d\u044b\u043c, \u043a\u0430\u0431 \u0441\u0432\u0435\u0442 \u0437\u043c\u043e\u0433 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u0446\u0430, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u042f\u0433\u043e \u0437&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0431\u044b\u045e \u0440\u043e\u0437\u0443\u043c \u0411\u043e\u0436\u044b, \u044f\u043a\u0456, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u045e \u0441\u0432\u0435\u0442, \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0441\u043b\u0443\u0433\u0456 \u0411\u043e\u0436\u0430\u0433\u0430. \u0423\u0441\u0451 \u0436 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430 \u0406\u043c, \u0430 \u0441\u0430\u043c \u0401\u043d \u0430\u0434\u0437\u0456\u043d \u0430\u0434 \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0434\u0430\u045e \u0437\u0430\u043a\u043e\u043d \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u044e\u0447\u044b \u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043a\u0430\u0431, \u043f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0435 \u0430\u0439\u0446\u043e\u045e\u0441\u043a\u0430\u0439 \u043c\u043e\u0446\u044b, \u044f\u043d\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0437\u0430\u0434\u0443\u043c\u0443 \u0456 \u0432\u043e\u043b\u044e \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0421\u043b\u043e\u0432\u0430, \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432\u044f\u0442\u044b \u042f\u043d. \u0401\u043d \u0441\u0446\u0456\u0441\u043b\u0430 \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0442\u043e\u0435 \u0421\u043b\u043e\u0432\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u045e\u0441\u0451. \u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430: &laquo;\u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430, \u0456 \u0421\u043b\u043e\u0432\u0430 \u0431\u044b\u043b\u043e \u045e \u0411\u043e\u0433\u0430, \u0456 \u0411\u043e\u0433\u0430\u043c \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430. \u0423\u0441\u0451 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u0456 \u0431\u0435\u0437 \u042f\u0433\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0441\u0442\u0430\u043b\u0430\u0441\u044f&raquo; (\u042f\u043d 1, 1. 3). \u0406 \u043d\u0456\u0436\u044d\u0439 \u0434\u0430\u0434\u0430\u0435: &laquo;\u0423 \u0441\u0432\u0435\u0446\u0435 \u0431\u044b\u043b\u043e, \u0456 \u0441\u0432\u0435\u0442 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0441\u0442\u0430\u045e\u0441\u044f, \u0456 \u0441\u0432\u0435\u0442 \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e \u042f\u0433\u043e. \u041f\u0440\u044b\u0439\u0448\u043b\u043e \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0456 \u0441\u0432\u0430\u0435 \u042f\u0433\u043e \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456&raquo; (\u043f\u0430\u0440. \u042f\u043d 1, 10-11).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 9, 5. 6. 7; \u041b\u043a 1, 32; \u042f\u043d 1, 4<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0437\u0456\u0446\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u043c, \u0456 \u0434\u0430\u0434\u0443\u0446\u044c \u0456\u043c\u044f \u042f\u043c\u0443 \u0411\u043e\u0433 \u041c\u043e\u0446\u043d\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0441\u044f\u0434\u0437\u0435 \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u0414\u0430\u0432\u0456\u0434\u0430, \u0430\u0439\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c. \u0406 \u042f\u0433\u043e \u045e\u043b\u0430\u0434\u0430 \u043d\u0430 \u043f\u043b\u044f\u0447\u0430\u0445 \u042f\u0433\u043e\u043d\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u0406\u043c \u0431\u044b\u043b\u043e \u0436\u044b\u0446\u0446\u0451, \u0456 \u0436\u044b\u0446\u0446\u0451 \u0431\u044b\u043b\u043e \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u043b\u044e\u0434\u0437\u0435\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0441\u044f\u0434\u0437\u0435 \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u0414\u0430\u0432\u0456\u0434\u0430, \u0430\u0439\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c. \u0406 \u042f\u0433\u043e \u045e\u043b\u0430\u0434\u0430 \u043d\u0430 \u043f\u043b\u044f\u0447\u0430\u0445 \u042f\u0433\u043e\u043d\u044b\u0445.<\/p>\r\n"}, {"GCH_CH_2_ID":"449","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 185: PL 38, 997-999)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u045e\u0434\u0430 \u0432\u044b\u0440\u0430\u0441\u043b\u0430 \u0437 \u0437\u044f\u043c\u043b\u0456, <\/span><\/em><em><span style=\"color: #ff0000;\">\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0430 \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u0443\u0434\u0437\u0456\u0441\u044f, \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430: \u0434\u0437\u0435\u043b\u044f \u0426\u044f\u0431\u0435 \u0411\u043e\u0433 \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c. &laquo;\u041f\u0440\u0430\u0447\u043d\u0456\u0441\u044f, \u044f\u043a\u0456 \u0441\u043f\u0456\u0448, \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0456 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0441\u0432\u0435\u0442\u043b\u0456\u0446\u044c \u0446\u044f\u0431\u0435&raquo; (\u042d\u0444 5, 14). \u042f \u0437\u043d\u043e\u045e \u043a\u0430\u0436\u0443: &laquo;\u0414\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435 \u0411\u043e\u0433 \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0430\u043c\u0451\u0440 \u0431\u044b \u043d\u0430\u0432\u0435\u043a\u0456, \u043a\u0430\u043b\u0456 \u0431 \u0401\u043d \u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u045e \u0447\u0430\u0441\u0435. \u0422\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u0431 \u043d\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e\u0441\u044f \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u043a\u0430\u043b\u0456 \u0431 \u0401\u043d \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u045e \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430. \u0422\u0430\u0431\u043e\u0439 \u0437\u0430\u0432\u0430\u043b\u043e\u0434\u0430\u043b\u0430 \u0431 \u0432\u0435\u0447\u043d\u0430\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u0433\u044d\u0442\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u0422\u044b \u043d\u0435 \u0430\u0436\u044b\u045e \u0431\u044b, \u043a\u0430\u043b\u0456 \u0431 \u0401\u043d \u043d\u0435 \u0437\u0433\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c, \u043f\u0430\u0434\u043e\u0431\u043d\u0443\u044e \u0434\u0430 \u0442\u0432\u0430\u0451\u0439. \u0422\u044b \u0431 \u0430\u0441\u043b\u0430\u0431, \u043a\u0430\u043b\u0456 \u0431 \u0401\u043d \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443. \u0422\u044b \u0431 \u0437\u0430\u0433\u0456\u043d\u0443\u045e, \u043a\u0430\u043b\u0456 \u0431 \u0401\u043d \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u0435\u043c \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434\u044b\u0445\u043e\u0434 \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f. \u0411\u0443\u0434\u0437\u0435\u043c \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u043e\u0447\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0456 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0456 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0434\u043d\u044f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0433\u044d\u0442\u044b \u043d\u0430\u0448 \u0447\u0430\u0441\u043e\u0432\u044b \u0456 \u0442\u0430\u043a\u0456 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0434\u0437\u0435\u043d\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0456 \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435\u043c, \u0456 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435\u043c, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0425\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 1, 30-31).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u045e\u0434\u0430 \u0432\u044b\u0440\u0430\u0441\u043b\u0430 \u0437 \u0437\u044f\u043c\u043b\u0456 (\u043f\u0430\u0440. \u041f\u0441 85 [84], 12). \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f &ndash; \u043f\u0440\u0430\u045e\u0434\u0430&raquo; (\u043f\u0430\u0440. \u042f\u043d 14, 6), &ndash; \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0414\u0437\u0435\u0432\u044b. &laquo;\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0430 \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e&raquo; (\u043f\u0430\u0440. \u041f\u0441 85 [84], 12), \u0431\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u041d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435 \u043d\u0435 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u045e\u0434\u0430 \u0432\u044b\u0440\u0430\u0441\u043b\u0430 \u0437 \u0437\u044f\u043c\u043b\u0456, \u0431\u043e &laquo;\u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c&raquo; (\u042f\u043d 1, 14). \u0406 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0430 \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e, \u0431\u043e &laquo;\u043a\u043e\u0436\u043d\u044b \u0434\u043e\u0431\u0440\u044b \u0456 \u045e\u0441\u044f\u043a\u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0434\u0430\u0440 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043d\u0435\u0431\u0430&raquo; (\u042f\u043a 1, 17).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u045e\u0434\u0430 \u0432\u044b\u0440\u0430\u0441\u043b\u0430 \u0437 \u0437\u044f\u043c\u043b\u0456, \u0446\u0435\u043b\u0430 &ndash; \u0437 \u041c\u0430\u0440\u044b\u0456. \u0406 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0430 \u0437 \u043d\u0435\u0431\u0430, \u0431\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0456\u0447\u043e\u0433\u0430 \u045e\u0437\u044f\u0446\u044c, \u043a\u0430\u043b\u0456 \u044f\u043c\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0437 \u043d\u0435\u0431\u0430 (\u043f\u0430\u0440. \u042f\u043d 3, 27).<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0410\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u044b, \u043c\u044b \u043c\u0430\u0435\u043c \u0441\u043f\u0430\u043a\u043e\u0439 \u0437 \u0411\u043e\u0433\u0430\u043c&raquo; (\u0420\u044b\u043c 5, 1), \u0431\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u043f\u0430\u0446\u0430\u043b\u0443\u044e\u0446\u0446\u0430 (\u043f\u0430\u0440. \u041f\u0441 85 [84],11) \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u043e \u041f\u0440\u0430\u045e\u0434\u0430 \u0432\u044b\u0440\u0430\u0441\u043b\u0430 \u0437 \u0437\u044f\u043c\u043b\u0456 (\u043f\u0430\u0440. \u041f\u0441 85 [84], 12). \u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u0430 \u0442\u043e\u0439 \u043b\u0430\u0441\u043a\u0456, \u0443 \u044f\u043a\u043e\u0439 \u0442\u0440\u044b\u0432\u0430\u0435\u043c; \u0456 \u043c\u044b \u0433\u0430\u043d\u0430\u0440\u044b\u043c\u0441\u044f \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u043d\u0430 \u0441\u043b\u0430\u0432\u0443 \u0411\u043e\u0436\u0443\u044e (\u043f\u0430\u0440. \u0420\u044b\u043c 5, 2). \u041d\u0435 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u043d\u0430 \u0441\u043b\u0430\u0432\u0443 \u043d\u0430\u0448\u0443, \u0430\u043b\u0435 \u043d\u0430 \u0441\u043b\u0430\u0432\u0443 \u0411\u043e\u0436\u0443\u044e, \u0431\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0435 \u0430\u0434 \u043d\u0430\u0441 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0430\u043b\u0435 \u043f\u0430\u0433\u043b\u044f\u0434\u0430\u0435 \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e. \u0422\u0430\u043c\u0443, \u0445\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0435 \u0441\u0430\u0431\u043e\u044e, \u0430\u043b\u0435 \u041f\u0430\u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0456 \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u043c\u0443 \u0437 \u0414\u0437\u0435\u0432\u044b \u041f\u0430\u043d\u0443 \u0430\u043d\u0451\u043b\u044b \u0441\u043f\u044f\u0432\u0430\u044e\u0446\u044c \u043f\u0435\u0441\u043d\u044e \u0445\u0432\u0430\u043b\u044b: &laquo;\u0425\u0432\u0430\u043b\u0430 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445 \u0411\u043e\u0433\u0443, \u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456&raquo; (\u043f\u0430\u0440. \u041b\u043a 2, 14).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0430\u0434\u043a\u0443\u043b\u044c \u0436\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0441\u043f\u0430\u043a\u043e\u0439, \u044f\u043a \u043d\u0435 \u0437 \u042f\u0433\u043e, \u0448\u0442\u043e \u043f\u0440\u0430\u045e\u0434\u0430 \u0432\u044b\u0440\u0430\u0441\u043b\u0430 \u0437 \u0437\u044f\u043c\u043b\u0456, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0446\u0435\u043b\u0430? \u0401\u043d &ndash; \u043d\u0430\u0448 \u0441\u043f\u0430\u043a\u043e\u0439, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0430\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435 \u0430\u0434\u0437\u0456\u043d\u044b\u043c (\u043f\u0430\u0440. \u042d\u0444 2, 14), \u043a\u0430\u0431 \u043c\u044b \u0431\u044b\u043b\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456, \u0437\u043b\u0443\u0447\u0430\u043d\u044b\u044f \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0439 \u043f\u043e\u0432\u044f\u0437\u0437\u044e \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u0439 \u043b\u0430\u0441\u0446\u044b, \u043a\u0430\u0431 \u043d\u0430\u0448\u0430 \u0441\u043b\u0430\u0432\u0430 \u0431\u044b\u043b\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f, \u043a\u0430\u043b\u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0435 \u0441\u0430\u0431\u043e\u044e, \u0430\u043b\u0435 \u041f\u0430\u043d\u0430\u043c. \u0422\u0430\u043c\u0443 \u0456 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0422\u044b \u043c\u0430\u044f \u0441\u043b\u0430\u0432\u0430, \u0422\u044b \u0433\u0430\u043b\u0430\u0432\u0443 \u043c\u0430\u044e \u045e\u0437\u0434\u044b\u043c\u0430\u0435\u0448&raquo; (\u041f\u0441 3, 4). \u0411\u043e \u0448\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0437\u0430 \u043b\u0430\u0441\u043a\u0443 \u0411\u043e\u0436\u0443\u044e \u043c\u0430\u0433\u043b\u043e \u0431\u044b\u0446\u044c \u043d\u0430\u043c \u0434\u0430\u0434\u0437\u0435\u043d\u0430? \u0411\u043e\u0433, \u043c\u0430\u044e\u0447\u044b \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u0443\u0447\u044b\u043d\u0456\u045e \u042f\u0433\u043e \u0421\u044b\u043d\u0430\u043c \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c, \u0456 \u0433\u044d\u0442\u0430\u043a \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0443\u043a\u0430\u0439 \u0437\u0430\u0441\u043b\u0443\u0433\u0456, \u0448\u0443\u043a\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b, \u0448\u0443\u043a\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u0446\u0456 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u0448\u0442\u043e\u0441\u044c\u0446\u0456, \u0430\u043a\u0440\u0430\u043c\u044f \u043b\u0430\u0441\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 11, 1. 5. 2<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b\u0439\u0434\u0437\u0435 \u043f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u0437 \u043f\u043d\u044f \u0415\u0441\u044d\u0435\u0432\u0430\u0433\u0430, \u0456 \u0430\u0442\u043e\u0436\u044b\u043b\u0430\u043a \u0437 \u043a\u043e\u0440\u0430\u043d\u044f \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u043f\u043b\u043e\u0434. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u043e\u044f\u0441\u0430\u043c \u043d\u0430 \u0431\u0451\u0434\u0440\u0430\u0445 \u042f\u0433\u043e, \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c &ndash; \u043f\u043e\u044f\u0441\u0430\u043c \u043d\u0430 \u0441\u0446\u0451\u0433\u043d\u0430\u0445 \u042f\u0433\u043e\u043d\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u0441\u043f\u0430\u0447\u043d\u0435 \u043d\u0430 \u0456\u043c \u0414\u0443\u0445 \u041f\u0430\u043d\u0430, \u0434\u0443\u0445 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f, \u0434\u0443\u0445 \u043f\u0430\u0440\u0430\u0434\u044b \u0456 \u043c\u043e\u0446\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u043e\u044f\u0441\u0430\u043c \u043d\u0430 \u0431\u0451\u0434\u0440\u0430\u0445 \u042f\u0433\u043e, \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c &ndash; \u043f\u043e\u044f\u0441\u0430\u043c \u043d\u0430 \u0441\u0446\u0451\u0433\u043d\u0430\u0445 \u042f\u0433\u043e\u043d\u044b\u0445.<\/p>\r\n"}, {"GCH_CH_2_ID":"450","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 1 in Nativitate Domini, 1-3: PL 54, 190-193)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041e, \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d, \u043f\u0440\u044b\u0437\u043d\u0430\u0439 \u0441\u0432\u0430\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c!<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430: \u0441\u0451\u043d\u043d\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u043d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430. \u0411\u043e \u043d\u044f\u043c\u0430 \u043c\u0435\u0441\u0446\u0430 \u043d\u0430 \u0441\u043c\u0443\u0442\u0430\u043a \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0436\u044b\u0446\u0446\u0451, \u044f\u043a\u043e\u0435, \u0437\u043d\u0456\u0448\u0447\u044b\u045e\u0448\u044b \u0441\u0442\u0440\u0430\u0445 \u043f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u043d\u0430\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0433\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u0430\u0431\u043c\u0456\u043d\u0435, \u0451\u0441\u0446\u044c \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u044f \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u0456: \u043d\u0430\u0448 \u041f\u0430\u043d, \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430 \u0433\u0440\u0430\u0445\u0443 \u0456 \u0441\u043c\u0435\u0440\u0446\u0456, \u0445\u043e\u0446\u044c \u0456 \u043d\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0456\u043a\u043e\u0433\u0430, \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0433\u0430 \u0430\u0434 \u0432\u0456\u043d\u044b, \u0430\u0434\u043d\u0430\u043a \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u0443\u0441\u0456\u0445. \u041d\u044f\u0445\u0430\u0439 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u044b, \u0431\u043e \u0451\u043d \u0431\u043b\u0456\u0437\u043a\u0456 \u0434\u0430 \u0432\u044f\u043d\u043a\u0430 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456. \u041d\u044f\u0445\u0430\u0439 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a, \u0431\u043e \u044f\u043c\u0443 \u0434\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435. \u041d\u044f\u0445\u0430\u0439 \u0430\u0431\u0443\u0434\u0437\u0456\u0446\u0446\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a, \u0431\u043e \u044f\u0433\u043e \u043a\u043b\u0456\u0447\u0443\u0446\u044c \u0434\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0447\u0430\u0441\u0443, \u044f\u043a\u0443\u044e \u043f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u044b\u043b\u0430 \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u0430\u044f \u0432\u0435\u043b\u0456\u0447 \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u043c\u0435\u0440\u0443, \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u043f\u0440\u044b\u043d\u044f\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443, \u043a\u0430\u0431 \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u0446\u044c \u044f\u0435 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0410\u0439\u0446\u043e\u043c \u0456 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0447\u044b \u0434&rsquo;\u044f\u0431\u043b\u0430, \u044f\u043a\u0456 \u044f\u0435 \u0437\u043d\u044f\u0432\u043e\u043b\u0456\u045e \u0456 \u043f\u0440\u044b\u043d\u0451\u0441 \u0441\u043c\u0435\u0440\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043d\u0451\u043b\u044b \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u043f\u0440\u044b \u041d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0456 \u041f\u0430\u043d\u0430: &laquo;\u0425\u0432\u0430\u043b\u0430 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445 \u0411\u043e\u0433\u0443, \u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456&raquo; (\u041b\u043a 2, 14). \u0410\u043d\u0451\u043b\u044b \u0431\u0430\u0447\u0430\u0446\u044c, \u044f\u043a \u0437 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0437\u044f\u043c\u043b\u0456 \u0431\u0443\u0434\u0443\u0435\u0446\u0446\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c. \u041a\u0430\u043b\u0456 \u0442\u0430\u043a \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u0430\u043d\u0451\u043b\u044b \u045e \u043d\u0435\u0431\u0435, \u0442\u043e \u044f\u043a \u0436\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u043b\u044e\u0434\u0437\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0433\u044d\u0442\u0430\u0439 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043f\u0430\u0434\u0437\u044f\u043a\u0443\u0435\u043c \u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0421\u044b\u043d\u0430 \u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c, \u044f\u043a\u0456 \u045e \u0441\u0432\u0430\u0451\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u0437\u043c\u0456\u043b\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456. \u0406 \u0445\u043e\u0446\u044c \u043c\u044b \u0431\u044b\u043b\u0456 \u043c\u0451\u0440\u0442\u0432\u044b\u044f \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0433\u0440\u0430\u0445\u0443, \u0411\u043e\u0433 \u0430\u0436\u044b&shy;\u0432\u0456\u045e \u043d\u0430\u0441 \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c (\u043f\u0430\u0440. \u042d\u0444 2, 5), \u043a\u0430\u0431 \u043c\u044b \u0441\u0442\u0430\u043b\u0456 \u045e \u0456\u043c \u043d\u043e\u0432\u044b\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0430\u0434\u043a\u0456\u043d\u0435\u043c &laquo;\u0440\u0430\u043d\u0435\u0439\u0448\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430&raquo; (\u042d\u0444 4, 22), \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u045e\u0434\u0437\u0435\u043b \u0443 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c, \u0430\u0434\u0440\u0430\u0447\u044d\u043c\u0441\u044f \u0430\u0434 \u0441\u043f\u0440\u0430\u0432\u0430\u045e \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0437\u043d\u0430\u0439, \u043e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d, \u0441\u0432\u0430\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0456, \u0441\u0442\u0430\u045e\u0448\u044b \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0411\u043e\u0436\u0430\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456, \u043f\u0430\u0447\u0432\u0430\u0440\u043d\u044b\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u043c\u0456 \u043d\u0435 \u0432\u044f\u0440\u0442\u0430\u0439\u0441\u044f \u0434\u0430 \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0439 \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0430\u0441\u0446\u0456. \u041f\u0430\u043c\u044f\u0442\u0430\u0439, \u0447\u0430\u0441\u0442\u043a\u0430\u0439 \u0447\u044b\u0451\u0439 \u0413\u0430\u043b\u0430\u0432\u044b \u0456 \u0447\u044b\u0439\u0433\u043e \u0446\u0435\u043b\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0448\u0441\u044f. \u041f\u0440\u044b\u0433\u0430\u0434\u0430\u0439, \u0448\u0442\u043e \u0446\u044f\u0431\u0435 \u0432\u044b\u0440\u0432\u0430\u043b\u0456 \u0437 \u0443\u043b\u0430\u0434\u044b \u0446\u0435\u043c\u0440\u044b \u0456 \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u043b\u0456 \u045e \u0441\u0432\u044f\u0442\u043b\u043e \u0411\u043e\u0436\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0445\u0440\u043e\u0441\u0442\u0443 \u0442\u044b \u0441\u0442\u0430\u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u044e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0442\u0430\u043c\u0443 \u043d\u0435 \u0432\u044b\u0433\u0430\u043d\u044f\u0439 \u0437 \u0441\u044f\u0431\u0435 \u0442\u0430\u043a\u043e\u0433\u0430 \u0436\u044b\u0445\u0430\u0440\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0431\u043b\u0430\u0433\u0456\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0456 \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u0432\u0430\u0439\u0441\u044f \u0437\u043d\u043e\u045e \u043d\u044f\u0432\u043e\u043b\u0456 \u0434&rsquo;\u044f\u0431\u043b\u0430. \u0411\u043e \u0432\u043e\u0434\u043a\u0443\u043f \u0437\u0430 \u0446\u044f\u0431\u0435 &ndash; \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430 \u041a\u0440\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0451\u043d\u043d\u044f \u0434\u043b\u044f \u043d\u0430\u0441 \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0441\u044b\u0448\u043e\u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0441\u043f\u0430\u043a\u043e\u0439. <span style=\"color: #ff0000;\">*<\/span> \u0421\u0451\u043d\u043d\u044f \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0437\u0430\u0441\u0430\u0447\u044b\u043b\u0456\u0441\u044f \u043c\u0451\u0434\u0430\u043c \u043d\u044f\u0431\u0451\u0441\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u0451\u043d\u043d\u044f \u0437\u0430\u044f\u0441\u043d\u0435\u045e \u0434\u0437\u0435\u043d\u044c \u043d\u043e\u0432\u0430\u0433\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443, \u0434\u0437\u0435\u043d\u044c \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0451\u043d\u043d\u044f \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0437\u0430\u0441\u0430\u0447\u044b\u043b\u0456\u0441\u044f \u043c\u0451\u0434\u0430\u043c \u043d\u044f\u0431\u0451\u0441\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"451","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0440\u0430\u043c\u043e\u0432\u0430 \u043f\u0430\u043f\u044b \u041f\u0430\u045e\u043b\u0430 VI<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Allo\u0441utio habita Nazareth 5 ianuarii 1964)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041d\u0430\u0437\u0430\u0440\u044d\u0442\u0430\u043d\u0441\u043a\u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0437\u0430\u0440\u044d\u0442\u0430\u043d\u0441\u043a\u0456 \u0434\u043e\u043c &ndash; \u0433\u044d\u0442\u0430 \u0448\u043a\u043e\u043b\u0430, \u0443 \u044f\u043a\u043e\u0439 \u043c\u044b \u043f\u0430\u0447\u044b\u043d\u0430\u0435\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0415\u0437\u0443\u0441\u0430. \u0413\u044d\u0442\u0430 \u0448\u043a\u043e\u043b\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0443\u0442 \u043c\u044b \u045e\u043f\u0435\u0440\u0448\u044b\u043d\u044e \u0432\u0443\u0447\u044b\u043c\u0441\u044f \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c, \u0441\u043b\u0443\u0445\u0430\u0446\u044c, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u0456 \u0433\u043b\u044b\u0431\u0435\u0439 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0446\u044c \u0443 \u0442\u043e\u0435, \u044f\u043a\u0430\u044f \u0432\u044b\u0441\u043e\u043a\u0430\u044f \u0456 \u045e\u0442\u043e\u0435\u043d\u0430\u044f \u0441\u0456\u043b\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u043d\u0430\u0439\u043f\u0440\u0430\u0441\u0446\u0435\u0439\u0448\u044b\u043c, \u043d\u0430\u0439\u043f\u0430\u043a\u043e\u0440\u043d\u0435\u0439\u0448\u044b\u043c \u0456 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u043d\u0430\u0439\u043f\u0440\u044b\u0433\u0430\u0436\u044d\u0439\u0448\u044b\u043c \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430. \u0410\u043b\u0435, \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043c\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u043e\u0432\u0430 \u0432\u0443\u0447\u044b\u043c\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0443\u0442 \u043c\u044b \u0431\u0430\u0447\u044b\u043c \u0442\u043e\u0439 \u043b\u0430\u0434 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u043d\u0430\u043c \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430, \u043a\u0456\u043c \u0431\u044b\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0410\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0442\u0443\u0442 \u043c\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u043c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0430\u0434 \u0443\u0441\u0456\u043c, \u0448\u0442\u043e \u0434\u0430\u0442\u044b\u0447\u044b\u043b\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441: \u043d\u0430\u0434 \u043c\u0435\u0441\u0446\u0430\u043c, \u0447\u0430\u0441\u0430\u043c, \u0437\u0432\u044b\u0447\u0430\u044f\u043c\u0456, \u043c\u043e\u0432\u0430\u0439, \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0430\u0431\u0440\u0430\u0434\u0430\u043c\u0456 \u0456, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u0443\u0441\u0456\u043c, \u0447\u044b\u043c \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u045e\u0441\u044f \u0415\u0437\u0443\u0441, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0441\u0432\u0435\u0442\u0443. \u0422\u0443\u0442 \u0443\u0441\u0451 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0434\u0430 \u043d\u0430\u0441 \u0456 \u043c\u0430\u0435 \u0441\u0432\u0430\u0451 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u045e \u0433\u044d\u0442\u0430\u0439 \u0448\u043a\u043e\u043b\u0435 \u043c\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u043c, \u0447\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u0434\u044b\u0441\u0446\u044b\u043f\u043b\u0456\u043d\u0443, \u043a\u0430\u043b\u0456 \u0436\u0430\u0434\u0430\u0435\u043c \u0456\u0441\u0446\u0456 \u0437\u0430 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u043c \u0432\u0443\u0447\u044d\u043d\u043d\u0435\u043c \u0456 \u0431\u044b\u0446\u044c \u0432\u0443\u0447\u043d\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041e, \u044f\u043a \u0431\u044b \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043c\u044b \u0445\u0430\u0446\u0435\u043b\u0456 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0434\u0437\u044f\u0446\u0456\u043d\u0441\u0442\u0432\u0430 \u0456 \u0437\u043d\u043e\u045e \u0434\u0430\u0432\u0435\u0440\u044b\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u0439 \u043f\u0430\u043a\u043e\u0440\u043d\u0430\u0439 \u0456 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0443\u0437\u0432\u044b\u0448\u0430\u043d\u0430\u0439 \u0448\u043a\u043e\u043b\u0435 \u041d\u0430\u0437\u0430\u0440\u044d\u0442\u0430. \u042f\u043a \u0433\u043e\u0440\u0430\u0447\u0430 \u043c\u044b \u0436\u0430\u0434\u0430\u043b\u0456 \u0431 \u0430\u0434\u0434\u0430\u0446\u0446\u0430 \u043d\u0430\u0448\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u044e \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0448\u043a\u043e\u043b\u0435 \u0436\u044b\u0446\u0446\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041c\u0430\u0440\u044b\u0456, \u043a\u0430\u0431 \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u044b\u0445 \u043f\u0440\u0430\u045e\u0434\u0430\u045e!<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043c\u044b \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043c \u0441\u044e\u0434\u044b, \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u044b, \u0456 \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0456\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u0434\u043e\u043c\u0435 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0435 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u0435, \u043d\u0430\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430\u0435 \u0434\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f. \u0410\u0434\u043d\u0430\u043a \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u0435\u0448\u043d\u0430 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434\u0441\u044e\u043b\u044c, \u043f\u0430\u043a\u0443\u043b\u044c, \u043f\u0430 \u043a\u0440\u044b\u0441\u0435, \u043d\u0435 \u0437\u0430\u0441\u0432\u043e\u0456\u043c \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u043a\u0430\u0440\u043e\u0442\u043a\u0456\u0445 \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u045e \u043d\u0430\u0437\u0430\u0440\u044d\u0442\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0434\u043e\u043c\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0448\u0430\u0435, \u0447\u0430\u043c\u0443 \u0451\u043d \u043d\u0430\u0441 \u0432\u0443\u0447\u044b\u0446\u044c, &ndash; \u0433\u044d\u0442\u0430 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435. \u041d\u044f\u0445\u0430\u0439 \u0430\u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441 \u043d\u0430\u0439\u0433\u043b\u044b\u0431\u0435\u0439\u0448\u0430\u044f \u043f\u0430\u0448\u0430\u043d\u0430 \u0434\u0430 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u044f. \u0413\u044d\u0442\u0430\u044f \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u043f\u0430\u0441\u0442\u0430\u0432\u0430 \u0434\u0443\u0445\u0443 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u045e \u043d\u0430\u0448\u044b\u043c \u043d\u0435\u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b\u043c \u0441\u0432\u0435\u0446\u0435 \u0456 \u043d\u0430\u0434\u0437\u0432\u044b\u0447\u0430\u0439 \u0431\u0443\u0440\u043b\u0456\u0432\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u043a\u0430\u043b\u0456 \u043d\u0430\u0441 \u0430\u043a\u0440\u0443\u0436\u0430\u0435 \u043b\u044f\u043c\u0430\u043d\u0442, \u0448\u0443\u043c \u0456 \u043a\u0440\u044b\u043a. \u041e, \u043d\u0430\u0437\u0430\u0440\u044d\u0442\u0430\u043d\u0441\u043a\u0430\u0435 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435, \u043d\u0430\u0432\u0443\u0447\u044b \u043d\u0430\u0441 \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0446\u0446\u0430 \u045e \u0434\u043e\u0431\u0440\u044b\u0445 \u0434\u0443\u043c\u043a\u0430\u0445, \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0446\u0446\u0430 \u0434\u0430 \u0433\u043b\u044b\u0431\u0456\u043d\u044f\u045e \u0434\u0443\u0445\u0443 \u0456 \u0437 \u0433\u0430\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044e \u0432\u0435\u0440\u043d\u0430 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0442\u0430\u0435\u043c\u043d\u044b\u044f \u0411\u043e\u0436\u044b\u044f \u043f\u0430\u0440\u0430\u0434\u044b \u0456 \u043d\u0430\u043a\u0430\u0437\u044b \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u0445 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u045e. \u041d\u0430\u0432\u0443\u0447\u044b \u043d\u0430\u0441 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u0430\u0436\u043d\u044b\u044f \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u043e\u045e\u043a\u0430, \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0435, \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u044b \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u043b\u0430\u0434 \u0436\u044b\u0446\u0446\u044f, \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u044f\u043a\u0443\u044e \u0447\u0443\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0442\u0443\u0442 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0443\u0440\u043e\u043a \u0441\u044f\u043c\u0435\u0439\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u041d\u044f\u0445\u0430\u0439 \u041d\u0430\u0437\u0430\u0440\u044d\u0442 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0442\u0430\u043c\u0443, \u0447\u044b\u043c \u0451\u0441\u0446\u044c \u0441\u044f\u043c&rsquo;\u044f, \u0447\u044b\u043c \u0451\u0441\u0446\u044c \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0443 \u0451\u0439, \u044f\u0435 \u0441\u0443\u0440\u043e\u0432\u0430\u044f \u0456 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u044f \u043a\u0440\u0430\u0441\u0430, \u044f\u0435 \u0441\u0432\u044f\u0442\u044b \u0456 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u044b \u0445\u0430\u0440\u0430\u043a\u0442\u0430\u0440. \u041d\u044f\u0445\u0430\u0439 \u044f\u043d\u0430 \u043f\u0430\u043a\u0430\u0436\u0430 \u043d\u0430\u043c, \u044f\u043a\u0456\u043c \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u043c \u0431\u044b\u0432\u0430\u0435 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u045e \u0441\u044f\u043c&rsquo;\u0456, \u044f\u043a\u0443\u044e \u043d\u0456\u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0430\u043c\u044f\u043d\u0456\u0446\u044c. \u041d\u044f\u0445\u0430\u0439 \u0451\u043d \u043f\u0430\u043a\u0430\u0436\u0430 \u043d\u0430\u043c \u043f\u0435\u0440\u0448\u0430\u0447\u0430\u0440\u0433\u043e\u0432\u0430\u0435 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0441\u044f\u043c&rsquo;\u0456 \u045e \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u0442\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0442\u0443\u0442 \u043c\u044b \u0437\u0430\u0441\u0432\u043e\u0439\u0432\u0430\u0435\u043c \u0443\u0440\u043e\u043a \u043f\u0440\u0430\u0446\u044b. \u041e, \u043d\u0430\u0437\u0430\u0440\u044d\u0442\u0430\u043d\u0441\u043a\u0430\u0435 \u0436\u044b\u0442\u043b\u043e, \u0434\u043e\u043c \u0421\u044b\u043d\u0430 \u0440\u0430\u043c\u0435\u0441\u043d\u0456\u043a\u0430, \u0442\u0443\u0442 \u043c\u044b \u043f\u0440\u0430\u0433\u043d\u0435\u043c \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0439\u043c\u0430\u0433\u0443\u0442\u043d\u0435\u0439\u0448\u044b \u0456 \u0441\u0443\u0440\u043e\u0432\u044b, \u0430\u043b\u0435 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u0447\u044b \u0437\u0430\u043a\u043e\u043d \u043b\u044e\u0434\u0441\u043a\u043e\u0439 \u043f\u0440\u0430\u0446\u044b. \u0422\u0443\u0442 \u043c\u044b \u043f\u0440\u0430\u0433\u043d\u0435\u043c \u0442\u0430\u043a \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u043f\u0440\u0430\u0446\u044b, \u043a\u0430\u0431 \u044f\u0435 \u045e\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u043b\u0456 \u045e\u0441\u0435. \u0423 \u0433\u044d\u0442\u044b\u043c \u0434\u043e\u043c\u0435 \u043c\u044b \u0445\u043e\u0447\u0430\u043c \u043d\u0430\u0433\u0430\u0434\u0430\u0446\u044c, \u0448\u0442\u043e \u043f\u0440\u0430\u0446\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043d\u0435 \u0441\u0430\u043c\u0430\u043c\u044d\u0442\u0430. \u042f\u0435 \u0441\u0432\u0430\u0431\u043e\u0434\u0430 \u0456 \u0432\u044b\u0431\u0456\u0442\u043d\u0430\u0441\u0446\u044c \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u0442\u0430\u043a \u0437\u0432\u0430\u043d\u0430\u0439 \u044d\u043a\u0430\u043d\u0430\u043c\u0456\u0447\u043d\u0430\u0439 \u0432\u0430\u0436\u043d\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0456 \u0437 \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b\u0445 \u043c\u044d\u0442\u0430\u045e, \u044f\u043a\u0456\u043c \u044f\u043d\u0430 \u0441\u043b\u0443\u0436\u044b\u0446\u044c. \u0410\u0434\u0441\u044e\u043b\u044c, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u043c\u044b \u0445\u0430\u0446\u0435\u043b\u0456 \u0431 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u0446\u044c \u043f\u0440\u0430\u0446\u043e\u045e\u043d\u044b\u0445 \u0443\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443 \u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0456\u043c \u0432\u044f\u043b\u0456\u043a\u0456 \u045e\u0437\u043e\u0440, \u0456\u0445 \u0411\u043e\u0436\u0430\u0433\u0430 \u0411\u0440\u0430\u0442\u0430, \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445, \u0448\u0442\u043e \u0456\u0445 \u0434\u0430\u0442\u044b\u0447\u0430\u0446\u044c, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 13, 11; \u042d\u0444 5, 19; \u041a\u043b\u0441 3, 23<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456, \u0441\u0443\u0446\u044f\u0448\u0430\u0439\u0446\u0435\u0441\u044f, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430\u043c\u0456, \u0436\u044b\u0432\u0456\u0446\u0435 \u045e \u0441\u043f\u0430\u043a\u043e\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0441\u043f\u044f\u0432\u0430\u044e\u0447\u044b \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u041f\u0430\u043d\u0430 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u0451, \u0448\u0442\u043e \u0431 \u0432\u044b \u043d\u0435 \u0440\u0430\u0431\u0456\u043b\u0456, \u0440\u0430\u0431\u0456\u0446\u0435 \u0430\u0434 \u0434\u0443\u0448\u044b, \u044f\u043a \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u0430 \u043d\u0435 \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043f\u044f\u0432\u0430\u044e\u0447\u044b \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u041f\u0430\u043d\u0430 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445.<\/p>\r\n"}, {"GCH_CH_2_ID":"455","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 1 in Epiphania Domini, 1-2: PL 133, 141-143)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0423 \u043f\u0430\u045e\u043d\u0430\u0446\u0435 \u0447\u0430\u0441\u0443 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0456 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0434\u0430\u0431\u0440\u044b\u043d\u044f \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430, \u0417\u0431\u0430\u045e\u0446\u044b \u043d\u0430\u0448\u0430\u0433\u0430 (\u043f\u0430\u0440. \u0426\u0456\u0442 2, 11). \u0414\u0437\u044f\u043a\u0443\u0435\u043c \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u0442\u0430\u043a \u0433\u043e\u0440\u0430\u0447\u0430 \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u0435 \u043d\u0430\u0441 \u0443 \u0433\u044d\u0442\u044b\u043c \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u044b, \u0443 \u0433\u044d\u0442\u044b\u043c \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456, \u0443 \u0433\u044d\u0442\u0430\u0439 \u043d\u044f\u0434\u043e\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0448 \u0447\u044b\u043c \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c, \u043c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456 \u0434\u0430\u0431\u0440\u044b\u043d\u0456. \u0410\u0434\u043d\u0430\u043a \u044f\u043d\u0430 \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0448\u0430\u0439, \u0431\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0430 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443. \u0410\u043b\u0435 \u0430\u0434\u043a\u0443\u043b\u044c \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0432\u0435\u0434\u0430\u0446\u044c, \u0448\u0442\u043e \u044f\u043d\u0430 \u0442\u0430\u043a\u0430\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f? \u0425\u043e\u0446\u044c \u044f\u0435 \u0430\u0431\u044f\u0446\u0430\u043b\u0456, \u0430\u043b\u0435 \u044f\u0435 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u045e, \u0442\u0430\u043c\u0443 \u043c\u043d\u043e\u0433\u0456\u044f \u0456 \u043d\u0435 \u0432\u0435\u0440\u044b\u043b\u0456. \u0411\u043e \u0448\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e \u0456 \u043f\u0430-\u0440\u043e\u0437\u043d\u0430\u043c\u0443 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0411\u043e\u0433 \u0434\u0430 \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e (\u043f\u0430\u0440. \u0413\u0431\u0440 1, 1). \u0401\u043d \u043a\u0430\u0436\u0430: &laquo;\u042f \u0432\u0435\u0434\u0430\u044e \u0437\u0430\u0434\u0443\u043c\u044b \u0441\u043f\u0430\u043a\u043e\u044e, \u0430 \u043d\u0435 \u0433\u043e\u0440\u0430&raquo; (\u043f\u0430\u0440. \u0415\u0440 29, 11). \u0428\u0442\u043e \u0436 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0430\u0434\u0447\u0443\u0432\u0430\u045e \u0433\u043e\u0440\u0430 \u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u045e \u0441\u043f\u0430\u043a\u043e\u044e? \u041a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u0421\u043f\u0430\u043a\u043e\u0439, \u0441\u043f\u0430\u043a\u043e\u0439, \u0430 \u0441\u043f\u0430\u043a\u043e\u044e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435?&raquo; \u0417 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0430\u043d\u0451\u043b\u044b \u0441\u043f\u0430\u043a\u043e\u044e \u0433\u043e\u0440\u043a\u0430 \u043f\u043b\u0430\u0447\u0443\u0446\u044c (\u043f\u0430\u0440. \u0406\u0441 33, 7), \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0430\u043d\u0435, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u0447\u0443\u043b\u0456?&raquo; (\u043f\u0430\u0440. \u0406\u0441 53, 1).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043d\u044f\u0445\u0430\u0439 \u0446\u044f\u043f\u0435\u0440 \u043b\u044e\u0434\u0437\u0456 \u043f\u0430\u0432\u0435\u0440\u0430\u0446\u044c \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0431\u0430\u0447\u0430\u0446\u044c, \u0431\u043e \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0456 \u041f\u0430\u043d\u0430 \u0433\u043e\u0434\u043d\u044b\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0434\u0430\u0432\u0435\u0440\u0443 (\u043f\u0430\u0440. \u041f\u0441 93 [92], 5). \u041a\u0430\u0431 \u0431\u0430\u0447\u044b\u043b\u0430 \u043d\u0430\u0432\u0430\u0442 \u0441\u0442\u043e\u043c\u043b\u0435\u043d\u0430\u0435 \u0432\u043e\u043a\u0430, \u0448\u0442\u043e \u0401\u043d \u0441\u043e\u043d\u0446\u0443 \u0440\u0430\u0437\u0431\u0456\u045e \u0441\u0432\u043e\u0439 \u0448\u0430\u0446\u0451\u0440 (\u043f\u0430\u0440. \u041f\u0441 19 [18], 6).<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u043e\u0441\u044c \u0441\u043f\u0430\u043a\u043e\u0439. \u041d\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u044b, \u0430\u043b\u0435 \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u044b, \u043d\u0435 \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u043d\u044b, \u0430\u043b\u0435 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b, \u043d\u0435 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u044b, \u0430\u043b\u0435 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u044b. \u0412\u043e\u0441\u044c \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u043d\u0456\u0431\u044b \u043c\u0435\u0445, \u043f\u043e\u045e\u043d\u044b \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456; \u043d\u0456\u0431\u044b \u043c\u0435\u0445, \u043a\u0430\u043b\u0456 \u0442\u0430\u043a \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u044f\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u0440\u0432\u0430\u0446\u0446\u0430 \u0430\u0434 \u043c\u0443\u043a\u0456, \u043a\u0430\u0431 \u043f\u0440\u0430\u043b\u0456\u043b\u0430\u0441\u044f \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u044f \u045e \u0456\u043c \u0446\u0430\u043d\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430; \u043c\u0435\u0445 \u0445\u043e\u0446\u044c \u0456 \u043c\u0430\u043b\u044b, \u0430\u043b\u0435 \u043f\u043e\u045e\u043d\u044b. \u0411\u043e \u0414\u0437\u0456\u0446\u044f \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043d\u0430\u043c (\u043f\u0430\u0440. \u0406\u0441 9, 5), \u0430\u043b\u0435 \u045e \u0456\u043c &laquo;\u0436\u044b\u0432\u0435 \u045e\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456&raquo; (\u041a\u043b\u0441 2, 9). \u041f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0447\u0430\u0441\u0443, \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0456 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456. \u042f\u043d\u0430 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u045e \u0446\u0435\u043b\u0435 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u043c, \u043a\u0430\u0431 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u0430\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456 \u045e \u0406\u043c \u0431\u044b\u043b\u0430 \u043f\u0440\u044b\u0437\u043d\u0430\u043d\u0430 \u0456 \u0434\u0430\u0431\u0440\u044b\u043d\u044f. \u0411\u043e \u0442\u0430\u043c, \u0434\u0437\u0435 \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0411\u043e\u0436\u0430\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c, \u0434\u0430\u0431\u0440\u044b\u043d\u044f \u045e\u0436\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430. \u0423 \u0447\u044b\u043c \u0436\u0430 \u043c\u043e\u0436\u043d\u0430 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430\u044f\u0432\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c, \u044f\u043a \u043d\u0435 \u045e \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u0456 \u043c\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430? \u042f \u043a\u0430\u0436\u0443 \u043c\u0430\u0439\u0433\u043e, \u0430 \u043d\u0435 \u0446\u0435\u043b\u0430 \u0410\u0434\u0430\u043c\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u0435 \u0442\u0430\u043a\u043e\u0433\u0430 \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u0451\u043d \u043c\u0435\u045e \u0434\u0430 \u0433\u0440\u0430\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043d\u0435\u0448\u0442\u0430 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430 \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0447\u044b\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430\u0448\u0443\u044e \u043d\u044f\u0434\u043e\u043b\u044e? \u0426\u0456 \u0451\u0441\u0446\u044c \u043d\u0435\u0448\u0442\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u043e\u045e\u043d\u0430\u0435 \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a \u0442\u043e\u0435, \u0448\u0442\u043e \u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u043b\u0430\u0441\u044f? \u041f\u0430\u043d\u0435, \u0447\u044b\u043c \u0451\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0448\u0442\u043e \u0422\u044b \u043b\u0456\u0447\u044b\u0448\u0441\u044f \u0437 \u0456\u043c \u0430\u0431\u043e \u0441\u0445\u0456\u043b\u044f\u0435\u0448 \u0434\u0430 \u044f\u0433\u043e \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430? (\u043f\u0430\u0440. \u041f\u0441 8, 5; \u0413\u0431\u0440 2, 6). \u041d\u044f\u0445\u0430\u0439 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0411\u043e\u0436\u044b \u043a\u043b\u043e\u043f\u0430\u0442 \u0430\u0431 \u0456\u043c. \u041d\u044f\u0445\u0430\u0439 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0430\u0432\u0435\u0434\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u0411\u043e\u0433 \u0434\u0443\u043c\u0430\u0435 \u043f\u0440\u0430 \u044f\u0433\u043e \u0456 \u0448\u0442\u043e \u0430\u0434\u0447\u0443\u0432\u0430\u0435. \u041d\u0435 \u043a\u0430\u0436\u044b, \u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0448\u0442\u043e \u0442\u044b \u0446\u0435\u0440\u043f\u0456\u0448, \u0430\u043b\u0435 \u0441\u043f\u044b\u0442\u0430\u0439\u0441\u044f, \u0448\u0442\u043e \u0446\u044f\u0440\u043f\u0435\u045e \u0401\u043d. \u0417 \u0442\u0430\u0433\u043e, \u0447\u044b\u043c \u0401\u043d \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u0446\u044f\u0431\u0435, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0439, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u0434\u043b\u044f \u042f\u0433\u043e \u0434\u0430\u0440\u0430\u0433\u0456. \u0422\u0430\u0434\u044b \u042f\u0433\u043e\u043d\u0430\u044f \u0434\u0430\u0431\u0440\u044b\u043d\u044f \u0430\u0434\u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u0442\u0430\u0431\u0435 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e\u043d\u0443\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c. \u0411\u043e \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435 \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u0437\u0432\u044b\u0441\u0456\u045e\u0441\u044f \u045e \u0434\u0430\u0431\u0440\u044b\u043d\u0456; \u0456 \u0447\u044b\u043c \u043c\u0435\u043d\u0448 \u0432\u0430\u0440\u0442\u044b\u043c \u0441\u0442\u0430\u045e \u0434\u0437\u0435\u043b\u044f \u043c\u044f\u043d\u0435, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0401\u043d \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b. \u0410\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f, \u044f\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u0434\u0430\u0431\u0440\u044b\u043d\u044f \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430, \u0417\u0431\u0430\u045e\u0446\u044b \u043d\u0430\u0448\u0430\u0433\u0430 (\u043f\u0430\u0440. \u0426\u0456\u0442 3, 4). \u0413\u044d\u0442\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0456 \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430\u044f \u0434\u0430\u0431\u0440\u044b\u043d\u044f \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430! \u0406 \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u043b\u0443\u0447\u044b\u045e \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0435 \u0456\u043c\u044f, \u0434\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u0434\u043e\u043a\u0430\u0437 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 1, 5; \u0420\u044b\u043c 8, 29<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u043f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, <span style=\"color: #ff0000;\">*<\/span> \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456, \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u0433\u043e \u0401\u043d \u043d\u0430\u043f\u0435\u0440\u0430\u0434 \u043f\u0430\u0437\u043d\u0430\u045e, \u0442\u0430\u0433\u043e \u0456 \u043f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0431\u044b\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456, \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"456","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0410\u0431\u0432\u044f\u0440\u0436\u044d\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u0435\u0440\u0430\u0441\u044f\u045e&raquo; \u0441\u0432. \u0413\u0456\u043f\u0430\u043b\u0456\u0442\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 10, 33-34: PG 16, 3452-3453)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0426\u0435\u043b\u0430\u043c, \u0430\u0431\u0430\u0433\u0430\u045e\u043b\u044f\u0435 \u043d\u0430\u0441<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043d\u0435 \u043c\u0430\u0435\u043c \u0434\u0430\u0432\u0435\u0440\u0443 \u0434\u0430 \u043f\u0443\u0441\u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e, \u043d\u0435 \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0435\u043c\u0441\u044f \u0440\u0430\u043f\u0442\u043e\u045e\u043d\u044b\u043c\u0456 \u043f\u0430\u0440\u044b\u0432\u0430\u043c\u0456 \u0441\u044d\u0440\u0446\u0430, \u043d\u0435 \u0437\u0430\u0447\u0430\u0440\u043e\u045e\u0432\u0430\u0435\u043c\u0441\u044f \u043f\u0440\u044b\u0432\u0430\u0431\u043d\u0430\u0441\u0446\u044e \u043a\u0440\u0430\u0441\u0430\u043c\u043e\u045e\u043d\u044b\u0445 \u043f\u0440\u0430\u043c\u043e\u0432\u0430\u045e, \u0430\u0434\u043d\u0430\u043a \u043c\u044b \u043d\u0435 \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0432\u0435\u0440\u044b\u0446\u044c \u0441\u043b\u043e\u0432\u0430\u043c, \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u043c \u0411\u043e\u0436\u0430\u044e \u0441\u0456\u043b\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0411\u043e\u0433 \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u0421\u043b\u043e\u0432\u0443, \u0430 \u0441\u0430\u043c\u043e \u0421\u043b\u043e\u0432\u0430 \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0430 \u0456\u0445 \u0456 \u0430\u0434\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u043b\u0430 \u043b\u044e\u0434\u0437\u0435\u0439 \u0430\u0434 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456. \u042f\u043d\u043e \u043d\u0435 \u0437\u043d\u044f\u0432\u043e\u043b\u044c\u0432\u0430\u043b\u0430 \u0456\u0445 \u043f\u0440\u044b\u043c\u0443\u0441\u0430\u043c \u0456 \u0433\u0432\u0430\u043b\u0442\u0430\u043c, \u0430\u043b\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u0456\u0445 \u0443 \u0441\u0432\u0430\u0431\u043e\u0434\u0437\u0435 \u0456 \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u045e \u043a\u0430\u043d\u0446\u044b \u0447\u0430\u0441\u043e\u045e \u043f\u0430\u0441\u043b\u0430\u045e \u0410\u0439\u0446\u0435\u0446, \u044f\u043a\u0456 \u045e\u0436\u043e \u043d\u0435 \u0445\u0430\u0446\u0435\u045e, \u043a\u0430\u0431 \u044f\u0433\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0430\u0431\u043e \u0431\u0430\u0447\u044b\u043b\u0456 \u045e \u0446\u044c\u043c\u044f\u043d\u044b\u0445 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u044f\u0445. \u0401\u043d \u043f\u0430\u0436\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u0421\u043b\u043e\u0432\u0430 \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430 \u0456 \u0441\u0432\u0435\u0442, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u042f\u0433\u043e, \u0437\u0431\u0430\u0432\u0456\u045e\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0433\u044d\u0442\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u043f\u0440\u044b\u043d\u044f\u043b\u043e \u0446\u0435\u043b\u0430 \u0430\u0434 \u0414\u0437\u0435\u0432\u044b \u0456 \u043d\u0430\u0441\u0456\u043b\u0430 \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0437\u0435\u043b\u044f \u045e\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u043d\u043e\u0432\u0430\u0433\u0430. \u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u042f\u043d\u043e \u0441\u0442\u0430\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0442\u0430\u043a\u043e\u0439 \u0436\u0430 \u043d\u0430\u0442\u0443\u0440\u044b, \u044f\u043a \u0456 \u043c\u044b. \u0411\u043e \u0456\u043d\u0430\u043a\u0448 \u0401\u043d \u0434\u0430\u0440\u044d\u043c\u043d\u0430 \u0431 \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u045e \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u044f\u043a \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430. \u041a\u0430\u043b\u0456 \u0431 \u0442\u043e\u0439 \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u043c\u0435\u045e \u0456\u043d\u0448\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443, \u044f\u043a \u0431\u044b \u0401\u043d \u043c\u043e\u0433 \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u043c\u043d\u0435, \u0441\u043b\u0430\u0431\u043e\u043c\u0443 \u0430\u0434 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f, \u0431\u044b\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u042f\u0433\u043e, \u0431\u044b\u0446\u044c \u0434\u043e\u0431\u0440\u044b\u043c \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c, \u044f\u043a \u0401\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u043c\u044b \u043d\u0435 \u043f\u0430\u043b\u0456\u0447\u044b\u043b\u0456, \u0448\u0442\u043e \u0401\u043d \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u043d\u0430\u0441, \u0415\u0437\u0443\u0441 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e, \u0430\u0434\u0447\u0443\u0432\u0430\u045e \u0433\u043e\u043b\u0430\u0434 \u0456 \u0441\u043c\u0430\u0433\u0443, \u0441\u043f\u0430\u045e, \u043d\u0435 \u043f\u0430\u0433\u0440\u044d\u0431\u0430\u0432\u0430\u045e \u043c\u0443\u043a\u0430\u0439, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u045e\u0441\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435. \u041f\u0440\u0430\u0437 \u0443\u0441\u0451 \u0433\u044d\u0442\u0430 \u0401\u043d \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u043f\u0440\u0430\u0439\u0448\u043e\u045e \u043f\u0435\u0440\u0448\u044b, \u043a\u0430\u0431 \u0442\u044b \u043d\u0435 \u0433\u0443\u0431\u043b\u044f\u045e \u0434\u0443\u0445\u0443 \u0456, \u043f\u0440\u044b\u0437\u043d\u0430\u045e\u0448\u044b \u045e \u0441\u0430\u0431\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0447\u0430\u043a\u0430\u045e \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0443 \u0415\u0437\u0443\u0441\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u044b, \u044f\u043a\u0456 \u0436\u044b\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0442\u043e \u0440\u0430\u0437\u0430\u043c \u0437 \u0434\u0443\u0448\u043e\u044e \u0437\u0434\u0430\u0431\u0443\u0434\u0437\u0435\u0448 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435 \u0456 \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0422\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0411\u043e\u0433\u0430 \u0456 \u0441\u0443\u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0435 \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u044e\u0447\u044b \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u043c \u0446\u0456 \u0445\u0432\u0430\u0440\u043e\u0431\u0430\u043c, \u0431\u043e \u0441\u0442\u0430\u043d\u0435\u0448 \u044f\u043a \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u0431\u043b\u0430\u0433\u043e\u0435, \u0448\u0442\u043e \u0442\u044b \u0441\u0446\u044f\u0440\u043f\u0435\u045e, \u043a\u0430\u043b\u0456 \u0431\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0411\u043e\u0433\u0430\u043c, \u0431\u043e \u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u0410 \u045e\u0441\u0451, \u0448\u0442\u043e \u0411\u043e\u0436\u0430\u0435, \u0411\u043e\u0433 \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u0434\u0430\u0446\u044c \u0442\u0430\u0431\u0435, \u043a\u0430\u043b\u0456 \u0441\u0442\u0430\u043d\u0435\u0448 \u0411\u043e\u0436\u044b\u043c \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c. \u0410 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043f\u0430\u0437\u043d\u0430\u0439 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u043f\u0440\u044b\u0437\u043d\u0430\u044e\u0447\u044b \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0446\u044f\u0431\u0435 \u045e\u0447\u044b\u043d\u0456\u045e. \u0411\u043e \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0456 \u0431\u044b\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u043d\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u0430\u0435 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0431\u044b\u045e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u0435 \u0441\u043f\u0440\u0430\u0447\u0430\u0439\u0446\u0435\u0441\u044f \u0430\u0434\u0437\u0456\u043d \u0437 \u0430\u0434\u043d\u044b\u043c, \u0430\u043b\u0435 \u0431\u0435\u0437 \u0432\u0430\u0433\u0430\u043d\u043d\u044f\u045e \u0430\u0434\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0448\u043b\u044f\u0445\u0443. \u0411\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c \u043d\u0430\u0434 \u0443\u0441\u0456\u043c. \u0401\u043d \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0430\u0431\u043c\u044b\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u0437 \u0433\u0440\u0430\u0445\u0443, \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u045e\u0448\u044b \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u045e \u043d\u043e\u0432\u0430\u0433\u0430. \u0401\u043d \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043d\u0430\u0437\u0432\u0430\u045e \u044f\u0433\u043e \u0441\u0432\u0430\u0456\u043c \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u043e\u0439 \u0432\u043e\u0431\u0440\u0430\u0437 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0443\u044e \u043c\u0435\u045e \u0434\u0430 \u0446\u044f\u0431\u0435. \u041a\u0430\u043b\u0456 \u0442\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u0448\u0441\u044f \u042f\u0433\u043e \u0432\u0430\u0436\u043d\u044b\u0445 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0456 \u0441\u0442\u0430\u043d\u0435\u0448 \u0434\u043e\u0431\u0440\u044b\u043c, \u0442\u043e \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u0448\u0441\u044f \u0434\u0430 \u042f\u0433\u043e, \u0456 \u0401\u043d \u0446\u044f\u0431\u0435 \u045e\u0448\u0430\u043d\u0443\u0435. \u0428\u0447\u043e\u0434\u0440\u044b \u0451\u0441\u0446\u044c \u0411\u043e\u0433, \u044f\u043a\u0456 \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0451\u0439 \u0445\u0432\u0430\u043b\u044b \u045e\u0447\u044b\u043d\u0456\u045e \u0446\u044f\u0431\u0435 \u043f\u043e\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 1, 14; \u043f\u0430\u0440. \u0411\u0430\u0440 3, 38<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u043c\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u043b\u0430\u0432\u0443 \u042f\u0433\u043e\u043d\u0443\u044e, \u0441\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u043c\u0430\u0435 \u0430\u0434 \u0410\u0439\u0446\u0430 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b, \u043f\u043e\u045e\u043d\u044b \u043b\u0430\u0441\u043a\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u043c\u0456\u0436 \u043b\u044e\u0434\u0437\u0435\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u043b\u0430\u0432\u0443 \u042f\u0433\u043e\u043d\u0443\u044e, \u0441\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u043c\u0430\u0435 \u0430\u0434 \u0410\u0439\u0446\u0430 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b, \u043f\u043e\u045e\u043d\u044b \u043b\u0430\u0441\u043a\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"457","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 6 in Nativitate Domini, 2-3, 5: PL 54, 213-216)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0441\u043f\u0430\u043a\u043e\u044e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u0446\u0456\u043d\u0441\u0442\u0432\u0430, \u044f\u043a\u0456\u043c \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u043b\u0430 \u0432\u0435\u043b\u0456\u0447 \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0437 \u0446\u044f\u0433\u0430\u043c \u0433\u0430\u0434\u043e\u045e \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u043e \u0434\u0430 \u043f\u043e\u045e\u043d\u0430\u0439 \u043c\u0443\u0436\u0447\u044b\u043d\u0441\u043a\u0430\u0439 \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u0456 \u0456, \u043f\u0430\u0441\u043b\u044f \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u0442\u0440\u044b\u0443\u043c\u0444\u0443 \u043c\u0443\u043a\u0456 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f, \u043f\u0440\u0430\u043c\u0456\u043d\u0443\u043b\u0456 \u045e\u0441e \u043c\u043e\u043c\u0430\u043d\u0442\u044b \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u0433\u0430 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u044f. \u0410\u0434\u043d\u0430\u043a \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u044f \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0415\u0437\u0443\u0441\u0430 \u0430\u0434 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456 \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435 \u045e \u043d\u0430\u0441 \u0437\u0430\u0447\u0430\u0442\u043a\u0456 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456. \u0406 \u043a\u0430\u043b\u0456 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u043c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b, \u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u043c\u044b \u0441\u0432\u044f\u0442\u043a\u0443\u0435\u043c \u043d\u0430\u0448\u0430\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0434\u0430 \u043d\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0441\u0446\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0432\u044b\u0442\u043e\u043a \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0413\u0430\u043b\u0430\u0432\u044b &ndash; \u0433\u044d\u0442\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0430\u0434\u043c\u0435\u0442\u043d\u0443\u044e \u0440\u043e\u043b\u044e, \u0456 \u045e\u0441\u0435 \u0434\u0437\u0435\u0446\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e\u0446\u0446\u0430 \u045e \u0440\u043e\u0437\u043d\u044b\u044f \u0447\u0430\u0441\u044b. \u0410\u043b\u0435 \u044f\u043a \u0443\u0441\u0435 \u0432\u0435\u0440\u043d\u0456\u043a\u0456 \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0445\u0440\u043e\u0441\u0442\u0443, \u0431\u043e \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u044f\u043d\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0432\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0456 \u0456 \u045e\u0437\u043d\u0435\u0441\u0435\u043d\u044b \u0432\u0430 \u045e\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u0456 \u0434\u0430 \u043f\u0440\u0430\u0432\u0456\u0446\u044b \u0410\u0439\u0446\u0430, \u0442\u0430\u043a \u0456 \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u044f\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u0433\u044d\u0442\u044b\u043c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b \u0437 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e, \u0445\u0442\u043e \u045e \u043b\u044e\u0431\u043e\u0439 \u0447\u0430\u0441\u0442\u0446\u044b \u0441\u0432\u0435\u0442\u0443 \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0430\u0434\u0440\u044d\u0437\u0430\u045e\u0448\u044b \u0434\u0430\u0440\u043e\u0433\u0443 \u043d\u0430\u0437\u0430\u0434, \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043d\u043e\u0432\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c. \u0401\u043d \u0443\u0436\u043e \u043d\u0435 \u043b\u0456\u0447\u044b\u0446\u0446\u0430 \u0441\u044f\u0440\u043e\u0434 \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u045e \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0433\u0430 \u0431\u0430\u0446\u044c\u043a\u0456, \u0430\u043b\u0435 \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0430\u045e \u0417\u0431\u0430\u045e\u0446\u044b, \u044f\u043a\u0456 \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u0441\u0442\u0430\u045e \u0421\u044b\u043d\u0430\u043c \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c, \u043a\u0430\u0431 \u043c\u044b \u0437\u043c\u0430\u0433\u043b\u0456 \u0441\u0442\u0430\u0446\u044c \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0431 \u0401\u043d \u043d\u0435 \u0441\u044b\u0448\u043e\u045e \u0434\u0430 \u043d\u0430\u0441 \u0443 \u0433\u044d\u0442\u044b\u043c \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0456, \u043d\u0456\u0445\u0442\u043e \u0431 \u043d\u0435 \u0434\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u042f\u0433\u043e \u043d\u0456 \u0437\u0430 \u044f\u043a\u0456\u044f \u0441\u0432\u0430\u0435 \u0437\u0430\u0441\u043b\u0443\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u0430\u043c\u0430 \u0432\u0435\u043b\u0456\u0447 \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u043d\u0430\u043c \u0434\u0430\u0440\u0443 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u043d\u0430\u0441 \u043f\u0430\u0448\u0430\u043d\u044b, \u0433\u043e\u0434\u043d\u0430\u0439 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b. \u0406 \u0442\u0430\u043c\u0443, \u044f\u043a \u0432\u0443\u0447\u044b\u0446\u044c \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043d\u0435 \u0434\u0443\u0445\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0430\u043b\u0435 \u0414\u0443\u0445\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u043c\u044b \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f, \u0448\u0442\u043e \u043d\u0430\u043c \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0411\u043e\u0433\u0430\u043c (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 2, 12). \u041f\u0430\u0431\u043e\u0436\u043d\u0430 \u045e\u0448\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u043c\u043e\u0436\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0401\u043d \u0441\u0430\u043c \u0443\u0434\u0437\u044f\u043b\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0436 \u0443 \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u044b \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u0456 \u041f\u0430\u043d\u0430 \u043f\u0430\u0434\u044b\u0445\u043e&not;\u0434\u0437\u0456\u0446\u044c \u0434\u043b\u044f \u045e\u0448\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0441\u0432\u044f\u0442\u0430 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0439, \u044f\u043a\u0456 \u043f\u0435\u0440\u0448\u044b\u043c \u0441\u043f\u0435\u0432\u0430\u043c \u0430\u043d\u0451\u043b\u0430\u045e \u0431\u044b\u045e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u044b \u043f\u0440\u044b \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0456 \u041f\u0430\u043d\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u043a\u043e\u0439 \u0451\u0441\u0446\u044c \u0442\u044b\u043c, \u0448\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445, \u0436\u044b\u0432\u0456\u0446\u044c \u043b\u044e\u0431\u043e\u045e \u0456 \u0441\u0442\u0432\u0430\u0440\u0430\u0435 \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430, \u0433\u044d\u0442\u0430 \u0441\u043f\u0430\u0447\u044b\u043d\u0430\u043a \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u0445 \u0456 \u0436\u044b\u043b\u043b\u0451 \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u0433\u043e \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u043d\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u043b\u044e\u0434\u0437\u0456 \u0430\u0434\u0440\u044b\u0432\u0430\u044e\u0446\u0446\u0430 \u0430\u0434 \u0441\u0432\u0435\u0442\u0443 \u0456 \u0437\u043b\u0443\u0447\u0430\u044e\u0446\u0446\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0456 \u0430\u0434 \u043a\u0440\u044b\u0432\u0456, \u043d\u0456 \u0430\u0434 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u0446\u0435\u043b\u0430, \u043d\u0456 \u0430\u0434 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u043c\u0443\u0436\u0430, \u0430\u043b\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f (\u043f\u0430\u0440. \u042f\u043d 1, 13), \u043d\u044f\u0445\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u0443\u044e\u0446\u044c \u0410\u0439\u0446\u0443 \u0437\u0433\u043e\u0434\u0443 \u0434\u0437\u044f\u0446\u0435\u0439, \u044f\u043a\u0456\u044f \u045e\u0441\u0442\u0430\u043b\u0451\u045e\u0432\u0430\u044e\u0446\u044c \u0441\u043f\u0430\u043a\u043e\u0439. \u0406 \u043d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435 \u045e\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u044f \u0447\u0430\u0441\u0442\u043a\u0456 \u0446\u0435\u043b\u0430 \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u0434\u0430 \u041f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u043d\u043e\u0432\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f. \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u043d\u0435 \u0441\u0432\u0430\u044e \u0432\u043e\u043b\u044e, \u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u042f\u0433\u043e \u043f\u0430\u0441\u043b\u0430\u045e. \u041a\u0430\u043b\u0456 \u043b\u0430\u0441\u043a\u0430 \u0410\u0439\u0446\u0430 \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u043d\u0430\u0441 \u0443 \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b, \u043c\u044b \u043d\u0435 \u0441\u0432\u0430\u0440\u044b\u043b\u0456\u0441\u044f \u0456 \u043d\u0435 \u0441\u043f\u0440\u0430\u0447\u0430\u043b\u0456\u0441\u044f, \u0430\u043b\u0435 \u0430\u0434\u043d\u043e \u0430\u0434\u0447\u0443\u0432\u0430\u043b\u0456 \u0456 \u0430\u0434\u043d\u043e \u043b\u044e\u0431\u0456\u043b\u0456. \u0422\u044b\u044f, \u0445\u0442\u043e \u0431\u044b\u045e \u043f\u0435\u0440\u0430\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0430\u0434\u043d\u0430\u0433\u043e \u0432\u043e\u0431\u0440\u0430\u0437\u0430, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043c\u0435\u0446\u044c \u0430\u0434\u043d\u0443 \u0434\u0443\u0448\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0441\u043f\u0430\u043a\u043e\u044e, \u0431\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: \u0401\u043d &ndash; \u043d\u0430\u0448 \u0441\u043f\u0430\u043a\u043e\u0439, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0430\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435 \u0430\u0434\u0437\u0456\u043d\u044b\u043c (\u043f\u0430\u0440. \u042d\u0444 2, 14); \u0431\u043e \u0446\u0456 \u044e\u0434\u044d\u0439, \u0446\u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u043a, &laquo;\u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u043c\u044b \u043c\u0430\u0435\u043c \u0434\u043e\u0441\u0442\u0443\u043f \u0443 \u0430\u0434\u043d\u044b\u043c \u0414\u0443\u0445\u0443 \u0434\u0430 \u0410\u0439\u0446\u0430&raquo; (\u042d\u0444 2, 18).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 2, 13-14. 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b, \u044f\u043a\u0456\u044f \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0431\u044b\u043b\u0456 \u0434\u0430\u043b\u0451\u043a\u0430, \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0431\u043b\u0456\u0437\u043a\u0456\u043c\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043a\u0440\u044b\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u0401\u043d &ndash; \u043d\u0430\u0448 \u0441\u043f\u0430\u043a\u043e\u0439, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0430\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435 \u0430\u0434\u0437\u0456\u043d\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b, \u0401\u043d \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0441\u043f\u0430\u043a\u043e\u0439 \u0432\u0430\u043c, \u044f\u043a\u0456\u044f \u0434\u0430\u043b\u0451\u043a\u0430, \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0442\u044b\u043c, \u044f\u043a\u0456\u044f \u0431\u043b\u0456\u0437\u043a\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0401\u043d &ndash; \u043d\u0430\u0448 \u0441\u043f\u0430\u043a\u043e\u0439, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0430\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435 \u0430\u0434\u0437\u0456\u043d\u044b\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"458","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. ad Epictetum, 5-9: PG 26, 1058. 1062-1066)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0421\u043b\u043e\u0432\u0430 \u043f\u0440\u044b\u043d\u044f\u043b\u043e \u0446\u0435\u043b\u0430 \u0430\u0434 \u041c\u0430\u0440\u044b\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u043e\u0432\u0430 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0443 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u044f\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u0442\u0430\u043c\u0443 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u043e \u0432\u0430 \u045e\u0441\u0456\u043c \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u0446\u0446\u0430 \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e (\u043f\u0430\u0440. \u0413\u0431\u0440 2, 16-17) \u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0446\u0435\u043b\u0430, \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0431\u044b\u043b\u0430 \u041c\u0430\u0440\u044b\u044f, \u043a\u0430\u0431 \u0415\u0437\u0443\u0441 \u043f\u0440\u044b\u043d\u044f\u045e \u0430\u0434 \u042f\u0435 \u0446\u0435\u043b\u0430 \u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u044f\u0433\u043e \u0437\u0430 \u043d\u0430\u0441 \u044f\u043a \u0441\u0432\u0430\u0451 \u045e\u043b\u0430\u0441\u043d\u0430\u0435. \u0422\u0430\u043c\u0443, \u0437\u0433\u0430\u0434\u0432\u0430\u044e\u0447\u044b \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u043d\u044b, \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0421\u043f\u0430\u0432\u0456\u043b\u0430 \u042f\u0433\u043e&raquo; (\u041b\u043a 2, 7). \u0422\u0430\u043c\u0443 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c\u0456 \u0431\u044b\u043b\u0456 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0433\u0440\u0443\u0434\u0437\u0456, \u044f\u043a\u0456\u044f \u042f\u0433\u043e \u043a\u0430\u0440\u043c\u0456\u043b\u0456. \u0410 \u043a\u0430\u043b\u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430, \u042f\u0433\u043e \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u041f\u0430\u043d\u0443 \u045e \u0430\u0445\u0432\u044f\u0440\u0443. \u0406 \u0413\u0430\u0431\u0440\u044b\u044d\u043b\u044c \u0430\u0441\u0446\u044f\u0440\u043e\u0436\u043d\u0430 \u0456 \u043c\u0443\u0434\u0440\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0401\u0439. \u0401\u043d \u043d\u0435 \u043a\u0430\u0436\u0430 &laquo;\u045e \u0422\u0430\u0431\u0435 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430&raquo;, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0430\u0434\u0443\u043c\u0430\u043b\u0430, \u0448\u0442\u043e \u045e \u044f\u0435 \u0437\u0432\u043e\u043d\u043a\u0443 \u045e\u0432\u0430\u0439\u0448\u043b\u043e \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u043a\u0430\u0436\u0430 &laquo;\u0430\u0434 \u0426\u044f\u0431\u0435&raquo; (\u043f\u0430\u0440. \u041b\u043a 1, 35), \u043a\u0430\u0431 \u0432\u0435\u0440\u044b\u043b\u0456, \u0448\u0442\u043e \u041d\u0435\u043c\u0430\u045e\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0430\u0434 \u042f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u043e\u0432\u0430 \u043f\u0440\u044b\u043d\u044f\u043b\u043e \u043d\u0430\u0448\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443, \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u044f\u0435 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0456 \u0434\u0430\u0448\u0447\u044d\u043d\u0442\u0443 \u0437\u043d\u0456\u0448\u0447\u044b\u043b\u0430, \u0430 \u043d\u0430\u0441 \u0437\u0440\u0430\u0431\u0456\u043b\u0430 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0441\u0432\u0430\u0451\u0439 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456. \u0417 \u0433\u044d\u0442\u0430\u0439 \u043d\u0430\u0433\u043e\u0434\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: &laquo;\u0422\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e, \u043a\u0430\u0431 \u0433\u044d\u0442\u0430\u0435 \u0442\u043b\u0435\u043d\u043d\u0430\u0435 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0430\u0441\u044f \u045e \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c, \u0430 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435 &ndash; \u0443 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 15, 53).<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0433\u044d\u0442\u0430 \u043d\u0456 \u045e \u044f\u043a\u0456\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u043d\u0435 \u0431\u044b\u043b\u043e \u0432\u044b\u0434\u0443\u043c\u043a\u0430\u0439, \u044f\u043a \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u043b\u0456\u0447\u0430\u0446\u044c. \u041a\u0430\u043b\u0456 \u0417\u0431\u0430\u045e\u0446\u0430 \u0441\u0442\u0430\u045e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0442\u0430\u0434\u044b \u0431\u044b\u043b\u043e \u0437\u0434\u0430\u0431\u044b\u0442\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u041d\u0430\u0448\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 &ndash; \u0433\u044d\u0442\u0430 \u043d\u0435 \u0432\u044b\u0434\u0443\u043c\u043a\u0430, \u044f\u043d\u043e \u043d\u0435 \u0430\u0431\u043c\u044f\u0436\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u0435\u043b\u0430\u043c. \u0413\u044d\u0442\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u0430, \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u045e \u0441\u0430\u043c\u0456\u043c \u0421\u043b\u043e\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0435 \u0437 \u041c\u0430\u0440\u044b\u0456 \u043c\u0435\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443, \u043f\u0440\u0430 \u0448\u0442\u043e \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0431\u044b\u043b\u043e \u0456 \u0446\u0435\u043b\u0430 \u041f\u0430\u043d\u0430. \u041f\u0430\u045e\u0442\u0430\u0440\u0430\u044e, \u0431\u044b\u043b\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0442\u0430\u043a\u0456\u043c \u0436\u0430, \u044f\u043a \u043d\u0430\u0448\u0430\u0435. \u0411\u043e \u041c\u0430\u0440\u044b\u044f &ndash; \u0433\u044d\u0442\u0430 \u043d\u0430\u0448\u0430 \u0441\u044f\u0441\u0442\u0440\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e\u0441\u0435 \u043c\u044b \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043c \u0430\u0434 \u0410\u0434\u0430\u043c\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043a\u0430\u0437\u0430\u043d\u0430\u0435 \u042f\u043d\u0430\u043c: &laquo;\u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c&raquo; (\u042f\u043d 1, 14) \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435, \u0448\u0442\u043e \u043c\u043e\u0436\u043d\u0430 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c \u0443 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445. \u0410 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u0443 \u041f\u0430\u045e\u043b\u0430 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0442\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0430\u043c&raquo; (\u043f\u0430\u0440. \u0413\u0430\u043b 3, 13). \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0446\u0435\u043b\u0430 \u0430\u0434 \u0433\u044d\u0442\u0430\u0439 \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0439 \u0441\u0443\u0432\u044f\u0437\u0456 \u0441\u0430 \u0421\u043b\u043e\u0432\u0430\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0432\u044f\u043b\u0456\u043a\u0456 \u0441\u043a\u0430\u0440\u0431: \u0441\u0430 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0441\u0442\u0430\u043b\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c; \u0437 \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u0430\u0433\u0430 \u0441\u0442\u0430\u043b\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c; \u0431\u044b\u043b\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430 \u0437 \u0437\u044f\u043c\u043b\u0456, \u0430 \u043f\u0440\u0430\u043d\u0456\u043a\u043b\u0430 \u045e \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0431\u0440\u0430\u043c\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0441\u0432\u0430\u044e \u0447\u0430\u0440\u0433\u0443 \u0422\u0440\u043e\u0439\u0446\u0430, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0421\u043b\u043e\u0432\u0430 \u043f\u0440\u044b\u043c\u0430\u0435 \u0446\u0435\u043b\u0430 \u0430\u0434 \u041c\u0430\u0440\u044b\u0456, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0422\u0440\u043e\u0439\u0446\u0430\u0439 \u0456 \u043d\u0435 \u0437\u0432\u0435\u0434\u0432\u0430\u0435 \u043d\u0456 \u045e\u0437\u0431\u0430\u0433\u0430\u0447\u044d\u043d\u043d\u044f, \u043d\u0456 \u0437\u043c\u044f\u043d\u0448\u044d\u043d\u043d\u044f, \u0430\u043b\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f. \u0406 \u045e \u0422\u0440\u043e\u0439\u0446\u044b \u043c\u044b \u0432\u044b\u0437\u043d\u0430\u0451\u043c \u0430\u0434\u0437\u0456\u043d\u0430\u0435 \u0411\u043e\u0441\u0442\u0432\u0430, \u0456 \u0442\u0430\u043a \u043c\u044b \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0435\u043c \u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0430\u0434\u043d\u0430\u0433\u043e \u0411\u043e\u0433\u0430, \u0410\u0439\u0446\u0430 \u0421\u043b\u043e\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041b\u043a 1, 42<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0432\u044f\u0442\u0430\u044f \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u044f \u0414\u0437\u0435\u0432\u0430, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u044f\u043a\u0456\u043c\u0456 \u043f\u0430\u0445\u0432\u0430\u043b\u0430\u043c\u0456 \u0426\u044f\u0431\u0435 \u0441\u043b\u0430\u0432\u0456\u0446\u044c, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0437\u043c\u044f\u0441\u0446\u0456\u0446\u044c \u043d\u044f\u0431\u0451\u0441\u044b, \u0422\u044b \u043d\u0430\u0441\u0456\u043b\u0430 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0422\u044b \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043f\u043b\u043e\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0437\u043c\u044f\u0441\u0446\u0456\u0446\u044c \u043d\u044f\u0431\u0451\u0441\u044b, \u0422\u044b \u043d\u0430\u0441\u0456\u043b\u0430 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"460","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 &laquo;\u041f\u0440\u0430 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430&raquo; \u0441\u0432. \u0411\u0430\u0437\u044b\u043b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 26. nn. 61. 64: PG 32, 179-182. 186)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u043d \u0430\u0436\u044b\u045e\u043b\u044f\u0435 \u045e \u0414\u0443\u0445\u0443 \u0441\u0432\u0430\u0451 \u041c\u0456\u0441\u0442\u044b\u0447\u043d\u0430\u0435 \u0446\u0435\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u045e\u0436\u043e \u043d\u0435 \u0436\u044b\u0432\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u0430\u0432\u0435\u0446\u0446\u0430 \u0434\u0437\u0456\u0446\u0435\u043c \u0411\u043e\u0436\u044b\u043c \u0456 \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u045e\u0441\u044f \u0434\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u0442\u0430\u0433\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c. \u042f\u043a \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0431\u0430\u0447\u044b\u0446\u044c \u0451\u0441\u0446\u044c \u0443 \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u043c \u0432\u043e\u043a\u0443, \u0442\u0430\u043a \u0456 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u045e \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u0430\u0439 \u0434\u0443\u0448\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0441\u043b\u043e\u0432\u0430 \u0451\u0441\u0446\u044c \u0443 \u0434\u0443\u0448\u044b, \u043a\u0430\u043b\u0456 \u043d\u0430\u0434 \u0456\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u043b\u0456 \u044f\u0433\u043e \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0432\u0443\u0441\u043d\u044b, \u0442\u0430\u043a \u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u043a\u0430\u043b\u0456 \u0434\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u043c\u0443 \u0434\u0443\u0445\u0443 \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u043d\u0430\u0448\u044b\u0445: &laquo;\u0410\u0431\u0431\u0430, \u041e\u0439\u0447\u0430&raquo; (\u0413\u0430\u043b 4, 6), \u0430\u0431\u043e \u043a\u0430\u043b\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0437\u0430 \u043d\u0430\u0441, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u041d\u0435 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u0430 \u0414\u0443\u0445 \u0410\u0439\u0446\u0430 \u0432\u0430\u0448\u0430\u0433\u0430 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u045e \u0432\u0430\u0441&raquo; (\u043f\u0430\u0440. \u041c\u0446 10, 22).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0440\u0430\u0437\u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u044f \u0440\u043e\u0437\u043d\u044b\u0445 \u0434\u0430\u0440\u043e\u045e, \u043c\u043e\u0436\u043d\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0430\u0434\u0437\u0456\u043d \u0414\u0443\u0445 \u0443 \u0440\u043e\u0437\u043d\u044b\u0445 \u0447\u0430\u0441\u0442\u043a\u0430\u0445 \u0446\u0435\u043b\u0430. \u0411\u043e \u045e\u0441\u0435 \u043c\u044b \u0447\u0430\u0441\u0442\u043a\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u0430\u043b\u0435 \u0437 \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456 \u043d\u0430\u043c \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0440\u043e\u0437\u043d\u044b\u044f \u0434\u0430\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0432\u043e\u043a\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0440\u0443\u0446\u044d: &laquo;\u0422\u044b \u043c\u043d\u0435 \u043d\u0435 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430&raquo;, \u0446i \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0433\u0430\u043b\u0430\u0432\u0430 &ndash; \u043d\u0430\u0433\u0430\u043c: &laquo;\u0412\u044b \u043c\u043d\u0435 \u043d\u0435 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u044f&raquo; (1 \u041a\u0430\u0440 12, 21). \u0410\u043b\u0435 \u045e\u0441\u0435 \u0440\u0430\u0437\u0430\u043c \u0441\u043a\u043b\u0430\u0434\u0430\u044e\u0446\u044c \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430 \u045e \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u044c \u0443\u0437\u0430\u0435\u043c\u043d\u0443\u044e \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u0445 \u0434\u0430\u0440\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u0440\u0430\u0437\u043c\u044f\u0441\u0446\u0456\u045e \u043a\u043e\u0436\u043d\u0443\u044e \u0447\u0430\u0441\u0442\u043a\u0443 \u0446\u0435\u043b\u0430 \u0442\u0430\u043a, \u044f\u043a \u0445\u0430\u0446\u0435\u045e. \u0406 \u045e\u0441\u0435 \u0447\u0430\u0441\u0442\u043a\u0456 \u045e\u0437\u0430\u0435\u043c\u043d\u0430 \u043a\u043b\u0430\u043f\u043e\u0446\u044f\u0446\u0446\u0430 \u0430\u0434\u043d\u0430 \u0430\u0431 \u0430\u0434\u043d\u043e\u0439, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u0430\u0439 \u0456\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0432\u0430 \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u0406 \u0442\u0430\u043c\u0443, &laquo;\u043a\u0430\u043bi \u0446\u0435\u0440\u043fi\u0446\u044c \u0430\u0434\u043d\u0430 \u0447\u0430\u0441\u0442\u043a\u0430, \u0446\u0435\u0440\u043f\u044f\u0446\u044c \u0437 \u0451\u0439 \u0443\u0441\u0435 \u0447\u0430\u0441\u0442\u043a\u0456; \u043a\u0430\u043bi \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434\u043d\u0430 \u0447\u0430\u0441\u0442\u043a\u0430, \u0437 \u0451\u0439 \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u045e\u0441\u0435 \u0447\u0430\u0441\u0442\u043a\u0456&raquo; (1 \u041a\u0430\u0440 12, 26).<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u043d\u043e\u045e \u0436\u0430, \u044f\u043a \u0447\u0430\u0441\u0442\u043a\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u045e \u0446\u044d\u043b\u044b\u043c, \u0442\u0430\u043a \u0456 \u043a\u043e\u0436\u043d\u044b \u0437 \u043d\u0430\u0441 &ndash; \u0443 \u0414\u0443\u0445\u0443, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u045e\u0441\u0435 \u043c\u044b \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u044f \u045e \u0430\u0434\u043d\u044b\u043c \u0446\u0435\u043b\u0435 \u0434\u043b\u044f \u0430\u0434\u043d\u0430\u0433\u043e \u0414\u0443\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0443 \u0421\u044b\u043d\u0443 \u0431\u0430\u0447\u043d\u044b \u0410\u0439\u0446\u0435\u0446, \u0442\u0430\u043a \u0421\u044b\u043d \u0431\u0430\u0447\u043d\u044b \u045e \u0414\u0443\u0445\u0443. \u0422\u0430\u043c\u0443 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u0435 \u045e \u0414\u0443\u0445\u0443 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u0440\u043e\u0437\u0443\u043c\u0443 \u043d\u0456\u0431\u044b \u0432\u044b\u0439\u0448\u043b\u0430 \u043d\u0430 \u0441\u0432\u044f\u0442\u043b\u043e, \u044f\u043a \u043c\u043e\u0436\u043d\u0430 \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430 \u0441\u0430 \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0433\u0430 \u0441\u0430\u043c\u0430\u0440\u0430\u043d\u0446\u044b. \u0411\u043e \u043a\u0430\u043b\u0456 \u044f\u043d\u0430, \u043f\u0430\u0434\u043c\u0430\u043d\u0443\u0442\u0430\u044f \u043c\u044f\u0441\u0446\u043e\u0432\u044b\u043c \u0437\u0432\u044b\u0447\u0430\u0435\u043c, \u043b\u0456\u0447\u044b\u043b\u0430, \u0448\u0442\u043e \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u0435 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u043f\u044d\u045e\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u041f\u0430\u043d \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u044f\u0435, \u043a\u0430\u0436\u0443\u0447\u044b, \u0448\u0442\u043e \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u0442\u0440\u044d\u0431\u0430 \u045e \u0414\u0443\u0445\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435 (\u043f\u0430\u0440. \u042f\u043d 4, 23). \u0411\u044f\u0441\u0441\u043f\u0440\u044d\u0447\u043d\u0430, \u043f\u0440\u0430\u045e\u0434\u0430\u0439 \u0401\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u045e \u0441\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u044f\u043a \u043c\u044b \u0433\u0430\u0432\u043e\u0440\u044b\u043c \u043f\u0440\u0430 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u0435 \u045e \u0421\u044b\u043d\u0443 \u044f\u043a \u0432\u043e\u0431\u0440\u0430\u0437\u0435 \u0411\u043e\u0433\u0430 \u0456 \u0410\u0439\u0446\u0430, \u0442\u0430\u043a \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u0435 \u045e \u0414\u0443\u0445\u0443 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u0435 \u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u0430\u0434\u0431\u0456\u0442\u0430\u043a \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456 \u041f\u0430\u043d\u0430.<br \/>\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u044f \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u043c\u044b \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430 \u0431\u0430\u0447\u044b\u043c \u0431\u043b\u044f\u0441\u043a \u0411\u043e\u0436\u0430\u0439 \u0441\u043b\u0430\u0432\u044b. \u041f\u0440\u0430\u0437 \u0430\u0434\u0431\u0456\u0442\u0430\u043a \u043c\u044b \u045e\u0437\u0432\u044b\u0448\u0430\u0435\u043c\u0441\u044f \u0434\u0430 \u0410\u0439\u0446\u0430, \u044f\u043a\u043e\u043c\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434\u0431\u0456\u0442\u0430\u043a \u0456 \u0440\u043e\u045e\u043d\u0430\u044f \u042f\u043c\u0443 \u043f\u044f\u0447\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 2, 12. 10; \u042d\u0444 3, 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b \u0436 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043d\u0435 \u0434\u0443\u0445\u0430 \u0441\u0432\u0435\u0442\u0443, \u0430\u043b\u0435 \u0414\u0443\u0445\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043c \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u0430 \u0411\u043e\u0433\u0430\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0414\u0443\u0445 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0432\u0430 \u045e\u0441\u0451, \u043d\u0430\u0432\u0430\u0442 \u0443 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0411\u043e\u0436\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u043e\u0435, \u0448\u0442\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0441\u044b\u043d\u0430\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c \u0443 \u043c\u0456\u043d\u0443\u043b\u044b\u0445 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u0445, \u0446\u044f\u043f\u0435\u0440 \u0430\u0434\u043a\u0440\u044b\u043b\u0430\u0441\u044f \u0441\u0432\u044f\u0442\u044b\u043c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u043c \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0443\u0445 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0432\u0430 \u045e\u0441\u0451, \u043d\u0430\u0432\u0430\u0442 \u0443 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0411\u043e\u0436\u044b\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"461","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u0434\u0430 \u0441\u0432. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 17, 7-9: CCL 36, 174-175)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0414\u0437\u0432\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u043b\u044e\u0431\u043e\u0432\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043c \u041f\u0430\u043d, \u043f\u043e\u045e\u043d\u044b \u043b\u044e\u0431\u043e\u0432\u0456 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a \u043b\u044e\u0431\u043e\u0432\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0441\u043b\u043e\u0432\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 (\u043f\u0430\u0440. \u0420\u044b\u043c 9, 28), \u044f\u043a \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u0430 \u043f\u0440\u0430 \u042f\u0433\u043e, \u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0437\u0430\u043a\u043e\u043d \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u0433\u0440\u0443\u043d\u0442\u0443\u044e\u0446\u0446\u0430 \u043d\u0430 \u0434\u0437\u0432\u044e\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u0445 \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u043c\u043d\u043e\u044e, \u0431\u0440\u0430\u0442\u044b, \u0443 \u0447\u044b\u043c \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0433\u044d\u0442\u044b\u0445 \u0434\u0437\u0432\u044e\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e. \u042f\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u0434\u043e\u0431\u0440\u0430 \u0432\u044f\u0434\u043e\u043c\u044b\u044f \u0432\u0430\u043c \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b\u0433\u0430\u0434\u0432\u0430\u0446\u0446\u0430, \u0430\u043b\u0435 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0437\u043d\u0456\u043a\u0430\u0446\u044c \u0437 \u0432\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e. \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043d\u0430\u0434 \u0442\u044b\u043c, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430: &laquo;\u041b\u044e\u0431\u0456 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u045e\u0441\u0456\u043c \u0441\u044d\u0440&shy;\u0446\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u0439 \u0442\u0432\u0430\u0451\u0439, \u0456 \u045e\u0441\u0456\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u0442\u0432\u0430\u0456\u043c; \u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435&raquo; (\u043f\u0430\u0440. \u041c\u0446 22, 37. 39).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0442\u0440\u044d\u0431\u0430 \u0434\u0443\u043c\u0430\u0446\u044c, \u043d\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c, \u0433\u044d\u0442\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c, \u0433\u044d\u0442\u0430 \u0440\u0430\u0431\u0456\u0446\u044c, \u0433\u044d\u0442\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c. \u041b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0435\u0440\u0448\u0430\u0435 \u045e \u043f\u0430\u0440\u0430\u0434\u043a\u0443 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e, \u0430 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 &ndash; \u043f\u0435\u0440\u0448\u0430\u0435 \u045e \u043f\u0430\u0440\u0430\u0434\u043a\u0443 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f. \u0411\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u044f\u0440\u043e\u0434 \u0433\u044d\u0442\u044b\u0445 \u0434\u0437\u0432\u044e\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e \u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u043d\u0430\u043a\u0430\u0437 \u043b\u044e\u0431\u043e\u0432\u0456, \u043d\u0435 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u0441\u043f\u044f\u0440\u0448\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0430 \u043f\u043e\u0442\u044b\u043c \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 \u0441\u043f\u044f\u0440\u0448\u0430 \u0411\u043e\u0433\u0430, \u0430 \u043f\u043e\u0442\u044b\u043c \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u043d\u0435 \u0431\u0430\u0447\u044b\u0448 \u0411\u043e\u0433\u0430, \u0442\u043e \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0448\u0441\u044f \u0433\u043e\u0434\u043d\u044b\u043c \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u042f\u0433\u043e. \u041a\u0430&shy;\u043b\u0456 \u043b\u044e\u0431\u0456\u0448 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0442\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u0447\u044b\u0441\u0442\u044b\u043c\u0456, \u043a\u0430\u0431 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430, \u044f\u043a \u0433\u044d\u0442\u0430 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043a\u0430\u0436\u0430 \u042f\u043d: &laquo;\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a\u043e\u0433\u0430 \u0431\u0430\u0447\u044b\u0446\u044c, \u043d\u0435 \u043c\u043e\u0436\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c?&raquo; (\u043f\u0430\u0440. 1 \u042f\u043d 4, 20).<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c, \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0442\u0430\u0431\u0435: \u043b\u044e\u0431\u0456 \u0411\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u0442\u044b \u043f\u0430\u043f\u0440\u043e\u0441\u0456\u0448 \u043c\u044f\u043d\u0435 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043b\u044e\u0431\u0456\u0446\u044c, \u044f \u0430\u0434\u043a\u0430\u0436\u0443 \u043d\u0456\u0447\u044b\u043c \u0456\u043d\u0448\u044b\u043c, \u044f\u043a \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u042f\u043d\u0430: &laquo;\u0411\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e&raquo; (\u043f\u0430\u0440. \u042f\u043d 1, 18). \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u0431 \u0442\u044b \u043d\u0435 \u043b\u0456\u0447\u044b\u045e \u0441\u044f\u0431\u0435 \u0446\u0430\u043b\u043a\u0430\u043c \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u043c \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430, \u042f\u043d \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c: &laquo;\u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u043b\u044e\u0431\u043e\u045e, \u0456 \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u045e \u0411\u043e\u0433\u0443, \u0456 \u0411\u043e\u0433 \u0443 \u0456\u043c&raquo; (1 \u042f\u043d 4, 16). \u0422\u0430\u043c\u0443 \u043b\u044e\u0431\u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0456 \u043f\u0440\u044b\u0433\u043b\u044f\u0434\u0430\u0439\u0441\u044f, \u0430\u0434\u043a\u0443\u043b\u044c \u0443 \u0442\u0430\u0431\u0435 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0456 \u0442\u0430\u043c \u0443\u0431\u0430\u0447\u044b\u0448 \u0411\u043e\u0433\u0430, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0430\u0447\u043d\u0456 \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430. \u0414\u0437\u044f\u043b\u0456\u0441\u044f \u0437 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u043c \u0445\u043b\u0435\u0431\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u043f\u0443\u0441\u043a\u0430\u0439 \u0443 \u0434\u043e\u043c \u0431\u0435\u0434\u043d\u044b\u0445 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0430\u045e. \u041a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0448 \u0433\u043e\u043b\u0430\u0433\u0430, \u0430\u043f\u0440\u0430\u043d\u0456 \u044f\u0433\u043e \u0456 \u0430\u0434 \u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u0445\u0430\u0432\u0430\u0439\u0441\u044f (\u043f\u0430\u0440. \u0406\u0441 58, 7).<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u0433\u043e \u0442\u044b \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u0448, \u0440\u043e\u0431\u044f\u0447\u044b \u0433\u044d\u0442\u0430? &laquo;\u0422\u0430\u0434\u044b \u0437\u0430\u0437\u0437\u044f\u0435, \u044f\u043a \u0437\u043e\u043b\u0430\u043a, \u0441\u0432\u044f\u0442\u043b\u043e \u0442\u0432\u0430\u0451&raquo; (\u0406\u0441 58, 8). \u0421\u0432\u044f\u0442\u043b\u043e \u0442\u0432\u0430\u0451 &ndash; \u0433\u044d\u0442\u0430 \u0411\u043e\u0433. \u042f\u043a \u0437\u043e\u043b\u0430\u043a, \u0431\u043e \u0437\u0430\u0437\u0437\u044f\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u043f\u0430\u0441\u043b\u044f \u043d\u043e\u0447\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0431\u043e \u044f\u043d\u043e \u043d\u0435 \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u043d\u0435 \u0437\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0442\u0440\u044b\u0432\u0430\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0431\u044f\u0447\u044b \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0456 \u043a\u043b\u0430\u043f\u043e\u0446\u044f\u0447\u044b\u0441\u044f \u0430\u0431 \u0456\u043c, \u0442\u044b \u045e \u0434\u0430\u0440\u043e\u0437\u0435. \u041a\u0443\u0434\u044b \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u0432\u0430\u044f \u0434\u0430\u0440\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0434\u0430 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430, \u0434\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u0443\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u0443\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u0439 \u0456 \u045e\u0441\u0456\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c? \u0411\u043e \u043c\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u0434\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u041f\u0430\u043d\u0430, \u0430\u043b\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u043c\u0456 \u0451\u0441\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u0456. \u0422\u0430\u043c\u0443 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u0442\u0430\u0433\u043e, \u0437 \u043a\u0456\u043c \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u0435\u0448, \u043a\u0430\u0431 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0437 \u043a\u0456\u043c \u0442\u044b \u0436\u0430\u0434\u0430\u0435\u0448 \u0431\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 4, 10-11. 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0442\u0430\u043a \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u0434\u044b\u043a \u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456, \u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0443\u044e \u043c\u0430\u0435 \u0434\u0430 \u043d\u0430\u0441 \u0411\u043e\u0433.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0442\u0430\u043a \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u0434\u044b\u043a \u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"462","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u044f\u0446\u044c\u0441\u043e\u0442 \u0440\u0430\u0437\u0434\u0437\u0435\u043b\u0430\u045e \u0441\u0432. \u041c\u0430\u043a\u0441\u0456\u043c\u0430 \u0412\u044b\u0437\u043d\u0430\u045e\u0446\u044b, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Centuria 1, 8-13: PG 90, 1182-1186)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0417\u0430\u045e\u0441\u0451\u0434\u044b \u043d\u043e\u0432\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u045e \u0446\u0435\u043b\u0435 (\u0433\u044d\u0442\u0430 \u0456 \u0451\u0441\u0446\u044c \u042f\u0433\u043e \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430), \u0430\u0434\u043d\u0430\u043a \u044f\u043d\u043e \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437 \u0430\u0445\u0432\u043e\u0442\u0430\u044e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u045e \u0434\u0443\u0445\u0443 \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u0430\u0434\u0430\u0435. \u0423 \u0456\u0445 \u044f\u043d\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0434\u0437\u0456\u0446\u044f\u0442\u043a\u0430\u043c \u0456 \u043d\u0430\u0431\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u0441\u0456\u043b\u0430\u045e. \u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0432\u0435\u0434\u0430\u0435, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0434\u043e\u043b\u044c\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u042f\u0433\u043e, \u0456 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u044f\u043c\u0443. \u042f\u043d\u043e \u043d\u0435 \u0430\u0431\u043c\u044f\u0436\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u043d\u0430 \u0446\u0456 \u0441\u043a\u0432\u0430\u043f\u043d\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u043b\u0456\u0447\u044b, \u0430\u043b\u0435 \u044f\u043a \u0431\u044b \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0435, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0456 \u044f\u043a \u042f\u0433\u043e \u043c\u043e\u0433\u0443\u0446\u044c \u0443\u0441\u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u0430\u0434\u0430\u0435. \u0406 \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u045e\u0437\u043d\u0451\u0441\u043b\u0430\u0441\u0446\u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u042f\u043d\u043e \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043d\u0435\u0434\u0430\u0441\u044f\u0436\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0411\u043e\u0436\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043c\u0443\u0434\u0440\u0430 \u043d\u0430\u0434 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435\u043c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u043a\u0430\u0436\u0430: &laquo;\u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u045e\u0447\u043e\u0440\u0430, \u0456 \u0441\u0451\u043d\u043d\u044f, \u0456 \u043d\u0430\u0432\u0435\u043a\u0456&raquo; (\u0413\u0431\u0440 13, 8). \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0451\u043d, \u0431\u044f\u0441\u0441\u043f\u0440\u044d\u0447\u043d\u0430, \u043c\u0430\u0435 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043d\u043e\u0432\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443, \u044f\u043a\u0430\u044f \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0441\u0442\u0430\u0440\u044d\u0435 \u045e \u0440\u0430\u043c\u043a\u0430\u0445 \u043d\u0435\u0439\u043a\u0430\u0433\u0430 \u043b\u044e\u0434\u0441\u043a\u043e\u0433\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0411\u043e\u0433 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430. \u041f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0446\u0435\u043b\u0430, \u043c\u0443\u0434\u0440\u0430 \u043d\u0430\u0434\u0437\u0435\u043b\u0435\u043d\u0430\u0435 \u0434\u0443\u0448\u043e\u044e, \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u0430\u043c \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0440\u044d\u0447\u044b \u0437 \u043d\u0456\u0447\u043e\u0433\u0430. \u0422\u044b\u043c \u0447\u0430\u0441\u0430\u043c \u043d\u0430 \u045e\u0441\u0445\u043e\u0434\u0437\u0435 \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u044f\u0440\u043a\u0430\u044f \u0437\u043e\u0440\u043a\u0430, \u044f\u043a\u0430\u044f \u0432\u044f\u0434\u0437\u0435 \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e \u0434\u0430 \u043c\u0435\u0441\u0446\u0430, \u0434\u0437\u0435 \u043b\u044f\u0436\u044b\u0446\u044c \u0443\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u0421\u043b\u043e\u0432\u0430, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u0421\u043b\u043e\u0432\u0430, \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u0430\u0435 \u045e \u0437\u0430\u043a\u043e\u043d\u0435 \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u0445, \u0442\u0430\u044f\u043c\u043d\u0456\u0447\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u0435 \u043b\u044e\u0434\u0441\u043a\u043e\u0435 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0456 \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b \u0434\u0430 \u043d\u0430\u0439\u044f\u0440\u0447\u044d\u0439\u0448\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0441\u043b\u043e\u0432\u0430 \u0437\u0430\u043a\u043e\u043d\u0443 \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u044f\u043a\u043e\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0446\u0446\u0430 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0434\u0443\u0445\u0430\u043c \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0432\u044f\u0434\u0437\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u0437\u043e\u0440\u043a\u0430, \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u043f\u043b\u0430\u043d\u0443 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0441\u0456\u043b\u0430\u044e \u043b\u0430\u0441\u043a\u0456 \u0434\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0433\u0430 \u0421\u043b\u043e\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0411\u043e\u0433 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u043d\u0435 \u0437\u043c\u044f\u043d\u044f\u044e\u0447\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u043b\u044e\u0434\u0441\u043a\u043e\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0437\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435\u043c \u0430\u0434\u043d\u0430\u0433\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u0440\u044d\u0445\u0443 (\u044f\u043a\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u0431\u044b\u045e \u0443\u043b\u0430\u0441\u0446\u0456\u0432\u044b \u043d\u0430\u0442\u0443\u0440\u044b). \u041a\u0456\u043d\u0443\u045e\u0448\u044b \u0446\u0435\u043b\u0430 \u044f\u043a \u043d\u0430\u0436\u044b\u0432\u0443 \u0434\u043b\u044f \u043d\u0435\u043d\u0430\u0436\u044d\u0440\u043d\u0430\u0433\u0430 \u0437\u043c\u0435\u044f, \u0448\u0442\u043e \u0437 \u0430\u0434\u043a\u0440\u044b\u0442\u0430\u0439 \u043f\u0430\u0448\u0447\u0430\u0439 \u043f\u0440\u0430\u0433\u043d\u0443\u045e \u0437\u0434\u0430\u0431\u044b\u0447\u044b, \u0421\u043b\u043e\u0432\u0430 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u044f\u0433\u043e \u043d\u0430 \u0431\u043e\u0439. \u041a\u0430\u043b\u0456 \u0437\u043c\u0435\u0439 \u0437\u0434\u0430\u0431\u044b\u045e \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u043e \u0441\u0442\u0430\u0446\u044c \u0434\u043b\u044f \u044f\u0433\u043e \u0430\u0442\u0440\u0443\u0442\u0430\u0439, \u0442\u043e \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u044f \u045e \u0446\u0435\u043b\u0435 \u0411\u043e\u0436\u0430\u044f \u043c\u043e\u0446 \u0434\u0430\u0448\u0447\u044d\u043d\u0442\u0443 \u0437\u043d\u0456\u0448\u0447\u044b\u043b\u0430 \u044f\u0433\u043e. \u0410 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0433\u044d\u0442\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u043f\u0440\u0430\u0437 \u0442\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u0411\u043e\u0436\u0443\u044e \u043c\u043e\u0446 \u0432\u044f\u0440\u0442\u0430\u044e\u0447\u044b \u044f\u0435 \u0434\u0430 \u043f\u0435\u0440\u0448\u0430\u043f\u0430\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0439 \u043b\u0430\u0441\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0437\u043c\u0435\u0439 \u043f\u0443\u0441\u0446\u0456\u045e \u0443 \u0434\u0440\u044d\u0432\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u044e \u0430\u0442\u0440\u0443\u0442\u0443 \u0456 \u0437\u0430\u0440\u0430\u0437\u0456\u045e \u0451\u0439 \u043d\u0430\u0442\u0443\u0440\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0434\u0430\u045e\u0448\u044b \u044f\u043c\u0443 \u043f\u0430&not;\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044c \u0430\u0442\u0440\u0443\u0442\u044b, \u0442\u0430\u043a \u0441\u0430\u043c, \u043d\u0430\u043c\u0435\u0440\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u0446\u044c \u0446\u0435\u043b\u0430 \u041f\u0430\u043d\u0430, \u0431\u044b\u045e \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u044b \u0456 \u0437\u043d\u044f\u0432\u0435\u0447\u0430\u043d\u044b \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u0430\u0439 \u0443 \u0456\u043c \u0411\u043e\u0436\u0430\u0439 \u043c\u043e\u0446\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044f\u043b\u0456\u043a\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u0439. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u045e \u0441\u0432\u0430\u0451\u0439 \u0430\u0441\u043e\u0431\u0435 \u0441\u0443\u0442\u043d\u0430\u0441\u043d\u0430 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u045e \u0446\u0435\u043b\u0435, \u043c\u043e\u0436\u0430 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0456 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0430\u0441\u043e\u0431\u0435 \u0441\u0443\u0442\u043d\u0430\u0441\u043d\u0430 \u0446\u0430\u043b\u043a\u0430\u043c \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0410\u0439\u0446\u0443? \u042f\u043a \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430 \u0441\u0432\u0430\u0451\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0446\u0430\u043b\u043a\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0430\u043c, \u043c\u043e\u0436\u0430 \u0446\u0430\u043b\u043a\u0430\u043c \u0441\u0442\u0430\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u043f\u0430 \u043d\u0430\u0442\u0443\u0440\u044b? \u042f\u043a \u043f\u0440\u044b \u0433\u044d\u0442\u044b\u043c \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430 \u043d\u0435 \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0430 \u043d\u0456\u0447\u043e\u0433\u0430: \u043d\u0456 \u0411\u043e\u0436\u0430\u044f, \u0443 \u044f\u043a\u043e\u0439 \u0401\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u043d\u0456 \u043d\u0430\u0448\u0430, \u0443 \u044f\u043a\u043e\u0439 \u0401\u043d \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c?<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u043c\u043e\u0436\u0430 \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u043d\u0443\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u0440\u0430, \u044f\u043a\u0430\u044f, \u043a\u0430\u043d\u0435\u0448\u043d\u0435, \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044e \u0456 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0430\u0439 \u0442\u044b\u0445 \u0440\u044d\u0447\u0430\u045e, \u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u043d\u043d\u0435 \u0456 \u0440\u0430\u0446\u044b\u044f\u043d\u0430\u043b\u044c\u043d\u0430\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 1, 14. 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u043c\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u043b\u0430\u0432\u0443 \u042f\u0433\u043e\u043d\u0443\u044e, \u0441\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u043c\u0430\u0435 \u0430\u0434 \u0410\u0439\u0446\u0430 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b, \u043f\u043e\u045e\u043d\u044b \u043b\u0430\u0441\u043a\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430, \u0456 \u0421\u043b\u043e\u0432\u0430 \u0431\u044b\u043b\u043e \u045e \u0411\u043e\u0433\u0430, \u0456 \u0411\u043e\u0433\u0430\u043c \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u043b\u0430\u0432\u0443 \u042f\u0433\u043e\u043d\u0443\u044e, \u0441\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u043c\u0430\u0435 \u0430\u0434 \u0410\u0439\u0446\u0430 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b, \u043f\u043e\u045e\u043d\u044b \u043b\u0430\u0441\u043a\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"463","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 194, 3-4: PL 38, 1016-1017)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u044b \u043d\u0430\u0441\u044b\u0446\u0456\u043c\u0441\u044f \u0431\u0430\u0447\u0430\u043d\u043d\u0435\u043c \u0421\u043b\u043e\u0432\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u043c\u043e\u0436\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0443\u0441\u0435 \u0441\u043a\u0430\u0440\u0431\u044b \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0432\u0435\u0434\u0430\u045e, \u0443\u043a\u0440\u044b\u0442\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0456 \u0441\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0432\u0430 \u045e\u0431\u043e\u0441\u0442\u0432\u0435 \u0446\u0435\u043b\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430? \u0411\u043e \u0401\u043d, \u0445\u043e\u0446\u044c \u0431\u044b\u045e \u0431\u0430\u0433\u0430\u0442\u044b, \u0441\u0442\u0430\u045e \u0431\u0435\u0434\u043d\u044b\u043c \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441, \u043a\u0430\u0431 \u0432\u044b \u045e\u0437\u0431\u0430\u0433\u0430\u0446\u0456\u043b\u0456\u0441\u044f \u042f\u0433\u043e\u043d\u044b\u043c \u0443\u0431\u043e\u0441\u0442\u0432\u0430\u043c (\u043f\u0430\u0440. 2 \u041a\u0430\u0440 8, 9). \u041f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u045e\u0448\u044b \u0441\u043c\u0435\u0440\u0446\u044c, \u0401\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0441\u044f\u0431\u0435 \u0432\u0430 \u045e\u0431\u043e\u0441\u0442\u0432\u0435. \u041d\u0435 \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0430\u0433\u0430\u0446\u0446\u044f, \u0430\u043b\u0435 \u0430\u0434\u043a\u043b\u0430\u045e \u044f\u0433\u043e \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0430\u044f \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u044f \u0432\u0435\u043b\u0456\u0447 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u042f\u0433\u043e\u043d\u0430\u0439, \u044f\u043a\u0443\u044e \u0401\u043d \u0441\u0445\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u042f\u0433\u043e, \u044f\u043a\u0443\u044e \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430 \u0432\u0435\u0434\u0430\u0435\u043c, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435. \u041a\u0430\u0431 \u043c\u044b \u0430\u043a\u0430\u0437\u0430\u043b\u0456\u0441\u044f \u0437\u0434\u0430\u0442\u043d\u044b\u043c\u0456 \u045e\u0441\u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0433\u044d\u0442\u0430, \u0411\u043e\u0436\u044b \u0421\u044b\u043d, \u0431\u0443\u0434\u0443\u0447\u044b \u0440\u043e\u045e\u043d\u044b\u043c \u0410\u0439\u0446\u0443 \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0411\u043e\u0436\u0430\u0439 \u0456 \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u043d\u0430\u0441 \u0443 \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0441\u043b\u0443\u0433\u0456, \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435 \u043d\u0430\u0441 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0433\u0430. \u0421\u0442\u0430\u045e\u0448\u044b\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u0440\u043e\u0431\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u0441\u044b\u043d\u043e\u045e \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c&shy;\u043c\u0456. \u041d\u0430\u0441\u044b\u0446\u0456\u045e\u0448\u044b \u0441\u043b\u0443\u0433\u0430\u045e \u043f\u0440\u0430\u0437 \u0431\u0430\u0447\u043d\u0443\u044e \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456, \u0401\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0456\u0445 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u044f\u043d\u044b \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041c\u044b \u0434\u0437\u0435\u0446\u0456 \u0411\u043e\u0436\u044b\u044f, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u043d\u0435 \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f, \u0447\u044b\u043c \u0431\u0443\u0434\u0437\u0435\u043c. \u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0401\u043d \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u043c \u042f\u0433\u043e \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c&raquo; (1 \u042f\u043d 3, 2). \u0413\u044d\u0442\u044b\u044f \u0441\u043a\u0430\u0440\u0431\u044b \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0432\u0435\u0434\u0430\u045e, \u0433\u044d\u0442\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 &ndash; \u043d\u0435 \u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u044f\u043a \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u0441 \u0437\u0430\u0434\u0430\u0432\u0430\u043b\u044c\u043d\u044f\u0435. \u0410 \u0433\u044d\u0442\u0430\u044f \u0432\u0435\u043b\u0456\u0447 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 &ndash; \u043d\u0435 \u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u044f\u043a \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u0441 \u043d\u0430\u0441\u044b\u0447\u0430\u0435. &laquo;\u041f\u0430\u043a\u0430\u0436\u044b \u043d\u0430\u043c \u0410\u0439\u0446\u0430 \u0456 \u0445\u043e\u043f\u0456\u0446\u044c \u043d\u0430\u043c&raquo; (\u042f\u043d 14, 8).<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e \u043f\u044d\u045e\u043d\u044b\u043c \u043f\u0441\u0430\u043b\u044c\u043c\u0435 \u043d\u0435\u0445\u0442\u0430 \u0430\u0434 \u043d\u0430\u0448\u0430\u0433\u0430 \u0456\u043c\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u042f\u043c\u0443: &laquo;\u042f \u043d\u0430\u0441\u044b\u0447\u0443\u0441\u044f, \u043a\u0430\u043b\u0456 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u0430 \u0422\u0432\u0430\u044f&raquo; (\u043f\u0430\u0440. \u041f\u0441 17 [16], 15). \u0421\u044b\u043d \u0456 \u0410\u0439\u0446\u0435\u0446 &ndash; \u0433\u044d\u0442\u0430 \u0430\u0434\u043d\u043e: \u0445\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c \u0421\u044b\u043d\u0430, \u0431\u0430\u0447\u044b\u0446\u044c \u0456 \u0410\u0439\u0446\u0430. \u0422\u0430\u043c\u0443 &laquo;\u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0441\u0430\u043c \u0451\u0441\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u043c \u0445\u0432\u0430&shy;\u043b\u044b&raquo; (\u041f\u0441 24 [23], 10). \u041d\u0430\u0432\u044f\u0440\u0442\u0430\u044e\u0447\u044b \u043d\u0430\u0441, \u0401\u043d \u043f\u0430\u043a\u0430\u0436\u0430 \u043d\u0430\u043c \u0441\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b, \u0456 \u043d\u0430\u0441\u044b\u0446\u0456\u043c\u0441\u044f, \u0456 \u0445\u043e\u043f\u0456\u0446\u044c \u043d\u0430\u043c. \u041f\u0430\u043a\u0443\u043b\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u0401\u043d \u043d\u0435 \u043f\u0430\u043a\u0430\u0436\u0430 \u043d\u0430\u043c \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u043d\u0430\u043c \u0445\u043e\u043f\u0456\u0446\u044c, \u043f\u0430\u043a\u0443\u043b\u044c \u043c\u044b \u043d\u0435 \u043d\u0430\u043f&rsquo;\u0435\u043c\u0441\u044f \u0437 \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0436\u044b\u0446\u0446\u044f \u0456 \u043d\u0435 \u043d\u0430\u0441\u044b\u0446\u0456\u043c\u0441\u044f, \u043f\u0430\u043a\u0443\u043b\u044c \u0432\u0430\u043d\u0434\u0440\u0443\u0435\u043c \u0448\u043b\u044f\u0445\u0430\u043c\u0456 \u0432\u0435\u0440\u044b \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u042f\u0433\u043e, \u043f\u0430\u043a\u0443\u043b\u044c \u0441\u0430\u0441\u043c\u044f\u0433\u043b\u0430 \u043f\u0440\u0430\u0433\u043d\u0435\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0437\u0433\u0430\u0440\u0430\u0435\u043c \u0430\u0434 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0433\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u043a\u0440\u0430\u0441\u0443 \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0411\u043e\u0436\u0430\u0439 &ndash; \u043c\u044b \u0437 \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044e \u0441\u0432\u044f\u0442\u043a\u0443\u0435\u043c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0441\u043b\u0443\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u0443\u043b\u044c \u043c\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043f\u0440\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0437\u0430\u0440\u0430\u043d\u043a\u0430\u0439 \u0437 \u0410\u0439\u0446\u0430, \u0442\u043e \u0441\u043a\u0456\u0440\u0443\u0435\u043c\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u045e\u043d\u0430\u0447\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0414\u0437\u0435\u0432\u044b. \u041c\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u043c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0430\u043a\u0443\u043b\u044c \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u0441\u043e\u043d\u0446\u0430, \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435 (\u043f\u0430\u0440. \u041f\u0441 72 [71], 17), \u043c\u044b \u0432\u044b\u0437\u043d\u0430\u0451\u043c, \u0448\u0442\u043e \u042f\u0433\u043e \u0448\u0430\u0446\u0451\u0440 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b \u043d\u0430 \u0441\u043e\u043d\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u0443\u043b\u044c \u043c\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0431\u0430\u0447\u044b\u0446\u044c \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0441\u0432\u0430\u0456\u043c \u0410\u0439\u0446\u0443, \u0442\u0430\u043c\u0443 \u043f\u0440\u044b\u0433\u0430\u0434\u0432\u0430\u0435\u043c \u0416\u0430\u043d\u0456\u0445\u0430, \u044f\u043a\u0456 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0430 \u0448\u043b\u044e\u0431\u043d\u0430\u0433\u0430 \u043f\u0430\u043a\u043e\u044f (\u043f\u0430\u0440. \u041f\u0441 19 [18], 6). \u041f\u0430\u043a\u0443\u043b\u044c \u043c\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0456\u0446\u044c \u0434\u0430 \u0433\u0430\u0441\u0446\u0456\u043d\u044b \u0410\u0439\u0446\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0442\u0430\u043c\u0443 \u043f\u0440\u044b\u0437\u043d\u0430\u0435\u043c \u044f\u0441\u043b\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 1, 2; 5, 20<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0416\u044b\u0446\u0446\u0451 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f, \u0456 \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456, \u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u043c, \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0432\u0430\u043c \u0433\u044d\u0442\u0430\u0435 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u045e \u0410\u0439\u0446\u0430 \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u043c. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430. \u041c\u044b &ndash; \u0443 \u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c, \u0443 \u0421\u044b\u043d\u0435 \u042f\u0433\u043e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435. \u0401\u043d &ndash; \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u0411\u043e\u0433 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u045e \u0410\u0439\u0446\u0430 \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"465","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 13 de Tempore: PL 39, 1097-1098)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0411\u043e\u0433 \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0442\u0430\u045e \u0411\u043e\u0433\u0430\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u043d\u0430\u0448 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0443\u0441\u044f\u0433\u043e, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0448\u044b\u0441\u044f \u0441\u0451\u043d\u043d\u044f \u0430\u0434 \u041c\u0430\u0446\u0456, \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u0417\u0431\u0430\u045e\u0446\u0430\u043c. \u0421\u0451\u043d\u043d\u044f \u0401\u043d \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0434\u043b\u044f \u043d\u0430\u0441 \u0443 \u0447\u0430\u0441\u0435, \u043a\u0430\u0431 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u043d\u0430\u0441 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456 \u0410\u0439\u0446\u0430. \u0411\u043e\u0433 \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0442\u0430\u045e \u0411\u043e\u0433\u0430\u043c. \u041a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043c\u043e\u0433 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0445\u043b\u0435\u0431 \u0430\u043d\u0451\u043b\u0430\u045e, \u041f\u0430\u043d \u0430\u043d\u0451\u043b\u0430\u045e \u0441\u0442\u0430\u045e \u0441\u0451\u043d\u043d\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0441\u043b\u0430\u0432\u0443\u0442\u0430\u0435 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c: &laquo;\u041a\u0440\u0430\u043f\u0456\u0446\u0435, \u043d\u044f\u0431\u0451\u0441\u044b, \u0437 \u0432\u044b\u0448\u044b\u043d\u044f\u045e, \u0456 \u0445\u043c\u0430\u0440\u044b \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u043b\u044c\u044e\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u041d\u044f\u0445\u0430\u0439 \u0430\u0434\u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u0437\u044f\u043c\u043b\u044f \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435&raquo; (\u043f\u0430\u0440. \u0406\u0441 45, 8). \u0422\u0430\u043a \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0441\u0442\u0430\u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e, \u043a\u0430\u0431 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430. \u0411\u043e \u0442\u0430\u043a \u0430\u0434 \u0456\u043c\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u045e \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u0445: &laquo;\u042f \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c, \u044f\u043a \u0437\u0432\u0435\u0434\u0430\u0446\u044c \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435&raquo; (\u043f\u0430\u0440. \u041f\u0441 119 [118], 67). \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u0456 \u0441\u0442\u0430\u045e \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b\u043c; \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0411\u043e\u0433 \u0427\u0430\u043b\u0430\u0432\u0435\u043a, \u043a\u0430\u0431 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u0430\u0433\u0430. \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u043f\u0430\u045e, \u0430\u043b\u0435 \u0411\u043e\u0433 \u0441\u044b\u0448\u043e\u045e \u0434\u0430 \u044f\u0433\u043e. \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u043f\u0430\u045e \u0433\u0430\u043d\u0435\u0431\u043d\u0430, \u0430 \u0411\u043e\u0433 \u0441\u044b\u0448\u043e\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430. \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u043f\u0430\u045e \u043f\u0440\u0430\u0437 \u043f\u044b\u0445\u0443, \u0430 \u0411\u043e\u0433 \u0441\u044b\u0448\u043e\u045e \u0437 \u043b\u0430\u0441\u043a\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0434\u0437\u0456\u0432\u043e\u0441\u044b, \u043e \u0446\u0443\u0434\u044b, \u0431\u0440\u0430\u0442\u044b \u043c\u0430\u0435! \u0423 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0437\u043c\u044f\u043d\u044f\u044e\u0446\u0446\u0430 \u0437\u0430\u043a\u043e\u043d\u044b \u043f\u0440\u044b\u0440\u043e\u0434\u044b: \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0433. \u0414\u0437\u0435\u0432\u0430 \u0437\u0430\u0446\u044f\u0436\u0430\u0440\u0432\u0430\u0435 \u0431\u0435\u0437 \u043c\u0443\u0436\u0430. \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430 \u0440\u043e\u0431\u0456\u0446\u044c \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430\u0439 \u0442\u0443\u044e, \u044f\u043a\u0430\u044f \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u043c\u0443\u0436\u0430. \u042f\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u041c\u0430\u0446\u0456, \u0430\u043b\u0435 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0437\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0414\u0437\u0435\u0432\u0430\u0439. \u042f\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u041c\u0430\u0446\u0456, \u0430\u043b\u0435 \u0437\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439. \u0414\u0437\u0435\u0432\u0430 \u043c\u0430\u0435 \u0421\u044b\u043d\u0430, \u0445\u043e\u0446\u044c \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u043c\u0443\u0436\u0430. \u042f\u043d\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u0430\u044f, \u0430\u043b\u0435 \u043d\u0435 \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u044f. \u0411\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0410\u0434\u0437\u0456\u043d\u044b \u0431\u0435\u0437 \u0433\u0440\u044d\u0445\u0443, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u043d\u0435 \u0430\u0434 \u043c\u0443\u0436\u0447\u044b\u043d\u0441\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0446\u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0430\u0434 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u0434\u0443\u0448\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 4, 14; 1, 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u043c: <span style=\"color: #ff0000;\">*<\/span> \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0441\u043b\u0430\u045e \u0421\u044b\u043d\u0430, \u0417\u0431\u0430\u045e\u0446\u0443 \u0441\u0432\u0435\u0442\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u0431 \u043f\u0440\u0430\u0431\u0430\u0447\u044b\u0446\u044c \u043d\u0430\u043c \u0433\u0440\u0430\u0445\u0456 \u0456 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0441\u043b\u0430\u045e \u0421\u044b\u043d\u0430, \u0417\u0431\u0430\u045e\u0446\u0443 \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"466","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 3 in Epiphania Domini, 1-3. 5; PL 54, 240-244)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0446\u044d\u043b\u0430\u043c\u0443 \u0441\u0432\u0435\u0442\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0432\u0456\u0434 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0439, \u043c\u0430\u044e\u0447\u044b \u043d\u0430\u043c\u0435\u0440 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u045e \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0447\u0430\u0441\u044b \u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0441\u0432\u0435\u0442\u0443, \u044f\u043a\u0456 \u0433\u0456\u043d\u0443\u045e, \u043f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0443 \u0425\u0440\u044b\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u043c\u0443 \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0443 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0431\u044b\u043b\u043e \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u043d\u0430 \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u0430\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u043d\u0435 \u0430\u0434 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0433\u0430 \u043d\u0430\u0441\u0435\u043d\u043d\u044f, \u0430\u043b\u0435 \u0430\u0434 \u043f\u043b\u0451\u043d\u0443 \u0432\u0435\u0440\u044b. \u042f\u043d\u043e \u0431\u044b\u043b\u043e \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u0430\u0435 \u0437 \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u043c\u0456 \u0437\u043e\u0440\u043a\u0430\u043c\u0456, \u043a\u0430\u0431 \u0430\u0434 \u0430\u0439\u0446\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0447\u0430\u043a\u0430\u043b\u0456 \u043d\u0435 \u0437\u044f\u043c\u043d\u044b\u0445, \u0430\u043b\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0436\u0430 \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u0441\u044f\u043c&rsquo;\u0456 \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0430\u045e \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0430 \u0441\u044b\u043d\u044b \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f \u043d\u044f\u0445\u0430\u0439 \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0443 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0435 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0430\u0434 \u044f\u043a\u043e\u0433\u0430 \u0430\u0434\u0440\u0430\u043a\u043b\u0456\u0441\u044f \u0441\u044b\u043d\u044b \u0446\u0435\u043b\u0430. \u041d\u044f\u0445\u0430\u0439 \u0443 \u0430\u0441\u043e\u0431\u0435 \u0442\u0440\u043e\u0445 \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044e \u0441\u0443\u0441\u0432\u0435\u0442\u0443. \u0406 \u043d\u044f\u0445\u0430\u0439 \u0411\u043e\u0433 \u0441\u0442\u0430\u043d\u0435 \u0432\u044f\u0434\u043e\u043c\u044b\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u042e\u0434\u044d\u0456, \u0430\u043b\u0435 \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435, \u043a\u0430\u0431 \u043f\u0430\u045e\u0441\u044e\u043b\u044c \u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u0456 \u0431\u044b\u043b\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0456\u043c\u044f \u042f\u0433\u043e (\u043f\u0430\u0440. \u041f\u0441 76 [75], 2).<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0441\u043f\u0430\u0437\u043d\u0430\u045e\u0448\u044b \u0433\u044d\u0442\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u0430\u0434\u0437\u043d\u0430\u0447\u044b\u043c \u0437 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0434\u0437\u0435\u043d\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u043b\u0451\u043d\u0443 \u0456 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0443, &laquo;\u044f\u043a\u0456, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u0434\u0430 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0435 \u0441\u0432\u044f\u0442\u044b\u0445 \u0443 \u0441\u0432\u044f\u0442\u043b\u0435, \u044f\u043a\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0437&shy;\u043f\u0430\u0434 \u0443\u043b\u0430\u0434\u044b \u0446\u0435\u043c\u0440\u044b \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e&raquo; (\u041a\u043b\u0441 1, 12-13). \u042f\u043a \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u045e \u0406\u0441\u0430\u044f: &laquo;\u041d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0445\u0430\u0434\u0437\u0456\u045e \u0443 \u0446\u0435\u043c\u0440\u044b, \u0443\u0431\u0430\u0447\u044b\u045e \u0441\u0432\u044f\u0442\u043b\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0435; \u043d\u0430\u0434 \u0436\u044b\u0445\u0430\u0440\u0430\u043c\u0456 \u043a\u0440\u0430\u0456\u043d\u044b \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0446\u0435\u043d\u044e \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u0441\u0432\u044f\u0442\u043b\u043e&raquo; (\u043f\u0430\u0440. \u0406\u0441 9, 1). \u041f\u0440\u0430 \u0456\u0445 \u0406\u0441\u0430\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u041f\u0430\u043d\u0443: &laquo;\u041d\u0430\u0440\u043e\u0434, \u044f\u043a\u043e\u0433\u0430 \u0422\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u045e, \u0456 \u043d\u0430\u0440\u043e\u0434\u044b, \u044f\u043a\u0456\u044f \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456 \u0426\u044f\u0431\u0435, \u043f\u0430\u0431\u044f\u0433\u0443\u0446\u044c \u0434\u0430 \u0426\u044f\u0431\u0435&raquo; (\u043f\u0430\u0440. \u0406\u0441 55, 5).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u0440\u0430\u0433\u0430\u043c \u0440\u0430\u0434\u044b \u0431\u044b\u045e \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0434\u0437\u0435\u043d\u044c \u0433\u044d\u0442\u044b (\u043f\u0430\u0440. \u042f\u043d 8, 56). \u0401\u043d \u0443\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u045e, \u0448\u0442\u043e \u0441\u044b\u043d\u044b \u0432\u0435\u0440\u044b \u044f\u0433\u043e\u043d\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u045e \u044f\u0433\u043e \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0435, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u0456 \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0434\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u0432\u0435\u0440\u0443 \u0441\u0442\u0430\u043d\u0435 \u0430\u0439\u0446\u043e\u043c \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u0401\u043d \u0430\u0434\u0434\u0430\u045e \u0445\u0432\u0430\u043b\u0443 \u0411\u043e\u0433\u0443, \u0431\u0443\u0434\u0443\u0447\u044b \u0446\u0430\u043b\u043a\u0430\u043c \u0443\u043f\u044d\u045e\u043d\u0435\u043d\u044b\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u043c\u0430\u0435 \u043c\u043e\u0446 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435 (\u043f\u0430\u0440. \u0420\u044b\u043c 4, 20-21).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0430\u043f\u044f\u0432\u0430\u0435 \u045e \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u0445 \u0414\u0430\u0432\u0456\u0434, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0423\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u044f \u0422\u0430\u0431\u043e\u044e, \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0456 \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0422\u0432\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c, \u041f\u0430\u043d\u0435, \u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0456\u043c\u044f \u0422\u0432\u0430\u0451&raquo; (\u041f\u0441 86 [85], 9). \u0410 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b: &laquo;\u041f\u0430\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0441\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e \u0441\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c&raquo; (\u041f\u0441 98 [97], 2).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043f\u0430\u0447\u0430\u043b\u043e \u0437\u0431\u044b\u0432\u0430\u0446\u0446\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0437\u043e\u0440\u043a\u0430 \u043f\u0440\u044b\u0432\u044f\u043b\u0430 \u0442\u0440\u043e\u0445 \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u0445 \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u0430\u043b\u0451\u043a\u0430\u0433\u0430 \u043a\u0440\u0430\u044e, \u043a\u0430\u0431 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430 \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u0456 \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u043d\u0456\u0446\u0446\u0430 \u042f\u043c\u0443. \u0417\u043e\u0440\u043a\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u043d\u0430\u0441 \u0456\u0441\u0446\u0456 \u0437\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u044f, \u043a\u0430\u0431 \u043c\u044b \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b\u0430\u045e \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0442\u043e\u0439 \u043b\u0430\u0441\u0446\u044b, \u044f\u043a\u0430\u044f \u0437\u0430\u043f\u0440\u0430\u0448\u0430\u0435 \u045e\u0441\u0456\u0445 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0443 \u0433\u044d\u0442\u044b\u043c \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0456 \u045e\u0441\u0435 \u0432\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443, \u043a\u0430\u0431 \u0443 \u0411\u043e\u0436\u044b\u043c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435, \u044f\u043a\u043e\u0435 \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u0430\u0439 \u0432\u0435\u0440\u0430\u0439 \u0456 \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456, \u0432\u044b \u0437\u0437\u044f\u043b\u0456 \u044f\u043a \u0441\u044b\u043d\u044b \u0441\u0432\u044f\u0442\u043b\u0430. \u041f\u0440\u0430\u0437 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0437 \u0411\u043e\u0433\u0430\u043c \u0410\u0439\u0446\u043e\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0417\u0431\u0430\u045e\u0446\u0430 \u0441\u0432\u0435\u0442\u0443, \u044f\u043a\u043e\u0433\u0430 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u0456 \u044f\u043a\u043e\u043c\u0443 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u0430\u043d\u0451\u043b\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0423\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u042f\u0433\u043e \u0437\u043e\u0440\u043a\u0443, \u043c\u0443\u0434\u0440\u0430\u0446\u044b \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0456 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u042f\u043c\u0443 \u0434\u0430\u0440\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0437\u0435\u043d\u044c \u0441\u0432\u044f\u0442\u044b \u0437\u0430\u0437\u0437\u044f\u045e \u043d\u0430\u043c: \u0456\u0434\u0437\u0456\u0446\u0435, \u043d\u0430\u0440\u043e\u0434\u044b, \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u041f\u0430\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u042f\u0433\u043e \u0437\u043e\u0440\u043a\u0443, \u043c\u0443\u0434\u0440\u0430\u0446\u044b \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0456 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u042f\u043c\u0443 \u0434\u0430\u0440\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"467","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u0425\u0440\u044b\u0437\u0430\u043b\u043e\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 160: PL 52, 620-622)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0422\u043e\u0439, \u0445\u0442\u043e \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441, <\/span><\/em><em><span style=\"color: #ff0000;\">\u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u043d\u0435\u0432\u044f\u0434\u043e\u043c\u044b\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u0443 \u0441\u0430\u043c\u043e\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0411\u043e\u0436\u0430\u0433\u0430 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u043b\u0456 \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u044b\u044f \u0430\u0434\u0437\u043d\u0430\u043a\u0456 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456, \u0430\u0434\u043d\u0430\u043a \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u044f \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u0441\u043f\u043e\u0441\u0430\u0431\u0430\u043c\u0456 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0456 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c \u0446\u0435\u043b\u0435, \u043a\u0430\u0431 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u045e \u0441\u043f\u0430\u0432\u0456\u0442\u044b \u0446\u0435\u043c\u0440\u0430\u0439, \u043d\u0435 \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u0442\u0430\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0434\u0430\u0440\u0443, \u044f\u043a\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0456 \u044f\u043a\u0456\u043c \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u045e \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u0445\u0442\u043e \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441, \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u043d\u0435\u0432\u044f\u0434\u043e\u043c\u044b\u043c, \u0456 \u0442\u0430\u043c\u0443 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u0435 \u0441\u0442\u0430\u043b\u0430 \u043d\u0430\u0433\u043e\u0434\u0430\u0439 \u0434\u043b\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043f\u0430\u043c\u044b\u043b\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f \u043c\u0443\u0434\u0440\u0430\u0446\u044b, \u0448\u0443\u043a\u0430\u044e\u0447\u044b \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u045e \u0431\u043b\u044f\u0441\u043a \u0437\u043e\u0440\u0430\u043a, \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u045e \u0436\u043e\u043b\u0430\u0431\u0435 \u041d\u0435\u043c\u0430\u045e\u043b\u044f, \u044f\u043a\u043e\u0435 \u043f\u043b\u0430\u043a\u0430\u043b\u0430. \u0421\u0451\u043d\u043d\u044f \u043c\u0443\u0434\u0440\u0430\u0446\u044b \u0434\u0437\u0456\u0432\u044f\u0446\u0446\u0430, \u043d\u0430 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u0431\u0430\u0447\u0430\u0446\u044c \u0441\u043f\u0430\u0432\u0456\u0442\u0430\u0433\u0430 \u045e \u043f\u044f\u043b\u044e\u0448\u043a\u0456, \u044f\u043a\u0456 \u0434\u043e\u045e\u0433\u0430 \u0431\u044b\u045e \u0434\u043b\u044f \u0456\u0445 \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u045e \u0437\u043e\u0440\u043a\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">C\u0451\u043d\u043d\u044f \u043c\u0443\u0434\u0440\u0430\u0446\u044b \u0431\u044b\u043b\u0456 \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u0433\u043b\u044b\u0431\u043e\u043a\u0456\u043c \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0430\u0434 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u043b\u0456: \u043d\u0435\u0431\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0430 \u0437\u044f\u043c\u043b\u044e \u045e \u043d\u0435\u0431\u0435; \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u045e \u0411\u043e\u0433\u0443, \u0430 \u0411\u043e\u0433\u0430 \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443; \u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u043c\u044f\u0441\u0446\u0456\u0446\u044c \u0446\u044d\u043b\u044b \u0441\u0432\u0435\u0442, \u0443 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0456\u043c \u0446\u0435\u043b\u0435. \u0406 \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0456, \u0442\u043e \u043d\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b, \u044f\u043d\u044b \u043c\u0456\u0441\u0442\u044b\u0447\u043d\u044b\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456 \u0432\u044b\u0437\u043d\u0430\u043b\u0456 \u0441\u0432\u0430\u044e \u0432\u0435\u0440\u0443: \u043a\u0430\u0434\u0437\u0456\u043b\u0430\u043c &ndash; \u0411\u043e\u0433\u0430, \u0437\u043e\u043b\u0430\u0442\u0430\u043c &ndash; \u041a\u0430\u0440\u0430\u043b\u044f, \u0430 \u043c\u0456\u0440\u0430\u043c &ndash; \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u043a \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0430\u043f\u043e\u0448\u043d\u0456\u043c\u0456, \u0441\u0442\u0430\u043b\u0456 \u043f\u0435\u0440\u0448\u044b\u043c\u0456, \u0431\u043e \u0442\u0430\u0434\u044b \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e \u0431\u044b\u043b\u0430 \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u0430 \u0432\u0435\u0440\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0440\u044d\u0447\u044b\u0448\u0447\u0430 \u042f\u0440\u0434\u0430\u043d\u0430, \u043a\u0430\u0431 \u0430\u0431\u043c\u044b\u0446\u044c \u0433\u0440\u0430\u0445\u0456 \u0441\u0432\u0435\u0442\u0443, \u0431\u043e, \u044f\u043a \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u042f\u043d, \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e: &laquo;\u0412\u043e\u0441\u044c \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0431\u044f\u0440\u044d \u043d\u0430 \u0441\u044f\u0431\u0435 \u0433\u0440\u044d\u0445 \u0441\u0432\u0435\u0442\u0443&raquo; (\u042f\u043d 1, 29). \u0421\u0451\u043d\u043d\u044f \u0441\u043b\u0443\u0433\u0430 \u043f\u0440\u044b\u043c\u0430\u0435 \u041f\u0430\u043d\u0430, \u0447\u0430\u043b\u0430\u0432\u0435\u043a &ndash; \u0411\u043e\u0433\u0430, \u042f\u043d &ndash; \u0425\u0440\u044b\u0441\u0442\u0430; \u043f\u0440\u044b\u043c\u0430\u0435, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435, \u0430 \u043d\u0435 \u045e\u0434\u0437\u044f\u043b\u0456\u0446\u044c \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f, \u044f\u043a \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0440\u043e\u043a: &laquo;\u0413\u043e\u043b\u0430\u0441 \u041f\u0430\u043d\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0432\u0430\u0434\u043e\u044e&raquo; (\u043f\u0430\u0440. \u041f\u0441 29 [28], 23). \u0413\u044d\u0442\u044b \u0433\u043e\u043b\u0430\u0441 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e: &laquo;\u0413\u044d\u0442\u0430 \u0421\u044b\u043d \u041c\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u044f\u043a\u043e\u0433\u0430 \u042f \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e&raquo; (\u041c\u0446 3, 17).<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043b\u0443\u043d\u0430\u0435 \u043f\u0430-\u043d\u0430\u0434 \u0432\u0430\u0434\u043e\u044e \u045e \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0433\u043e\u043b\u0443\u0431\u0430. \u042f\u043a \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0433\u043e\u043b\u0443\u0431 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u041d\u043e\u044e, \u0448\u0442\u043e \u0441\u043f\u044b\u043d\u0456\u045e\u0441\u044f \u0441\u0443\u0441\u0432\u0435\u0442\u043d\u044b \u043f\u0430\u0442\u043e\u043f, \u0442\u0430\u043a \u0456 \u0433\u044d\u0442\u044b \u0433\u043e\u043b\u0443\u0431 \u0434\u0430\u0435 \u0437\u043d\u0430\u043a, \u0448\u0442\u043e \u0441\u043f\u044b\u043d\u0456\u043b\u0430\u0441\u044f \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435 \u0441\u0432\u0435\u0442\u0443. \u0406 \u0451\u043d \u043d\u0435 \u043f\u0440\u044b\u043d\u0451\u0441, \u044f\u043a \u041d\u043e\u0435\u045e \u0433\u043e\u043b\u0443\u0431, \u0433\u0430\u043b\u0456\u043d\u043a\u0456 \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u0430\u0439 \u0430\u043b\u0456\u0432\u044b, \u0430\u043b\u0435 \u043f\u0440\u0430\u043b\u0456\u045e \u0443\u0441\u0451 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u043d\u043e\u0432\u0430\u0433\u0430 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u044f \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u043d\u043e\u0432\u0430\u0433\u0430 \u0410\u0434\u0430\u043c\u0430, \u043a\u0430\u0431 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u0430\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c: &laquo;\u0411\u043e\u0433, \u0442\u0432\u043e\u0439 \u0411\u043e\u0433, \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0446\u044f\u0431\u0435 \u0430\u043b\u0435\u0435\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u0448\u0447\u043e\u0434\u0440\u0430, \u0447\u044b\u043c \u0440\u043e\u045e\u043d\u044b\u0445 \u0442\u0430\u0431\u0435&raquo; (\u041f\u0441 45 [44], 8).<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0434\u0430\u045e \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0437\u043d\u0430\u043a\u0430\u043c, \u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u045e \u0432\u0430\u0434\u0443 \u045e \u0432\u0456\u043d\u043e. \u0410\u043b\u0435 \u0432\u0430\u0434\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u0446\u0446\u0430 \u0456 \u045e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u043a\u0440\u044b\u0432\u0456, \u043a\u0430\u0431 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0434\u0430\u045e \u043d\u0430\u043f\u0456\u0446\u0446\u0430 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0432\u0456\u043d\u0430 \u0437 \u043d\u0430\u0447\u044b\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0426\u0435\u043b\u0430 \u0456 \u043a\u0430\u0431 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u0441\u043b\u044b\u043d\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u043f\u0440\u0430\u0440\u043e\u043a\u0430: &laquo;\u042f\u043a\u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u043a\u0435\u043b\u0456\u0445 \u043c\u043e\u0439!&raquo; (\u043f\u0430\u0440. \u041f\u0441 23 [22], 5).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043c\u0443\u0434\u0440\u0430\u0446\u044b \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u0442\u0440\u044b \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u044f \u0434\u0430\u0440\u044b, \u044f\u043a\u0456\u044f \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0456 \u045e \u0441\u0430\u0431\u0435 \u0411\u043e\u0436\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b: <span style=\"color: #ff0000;\">*<\/span> \u0437\u043e\u043b\u0430\u0442\u0430 \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043b\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0443\u044e \u043c\u043e\u0446; \u043a\u0430\u0434\u0437\u0456\u043b\u0430 &ndash; \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u0430 \u043c\u0456\u0440\u0430 &ndash; \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u0443\u0434\u0440\u0430\u0446\u044b \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0456\u0441\u044f \u0417\u0431\u0430\u045e\u0446\u0443, \u0441\u043f\u0430\u0432\u0456\u0442\u0430\u043c\u0443 \u045e \u043f\u044f\u043b\u044e\u0448\u043a\u0456, \u0456 \u0441\u0430 \u0441\u0432\u0430\u0456\u0445 \u0441\u043a\u0430\u0440\u0431\u0430\u045e \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u042f\u043c\u0443 \u043c\u0456\u0441\u0442\u044b\u0447\u043d\u044b\u044f \u0434\u0430\u0440\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u043e\u043b\u0430\u0442\u0430 \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043b\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0443\u044e \u043c\u043e\u0446; \u043a\u0430\u0434\u0437\u0456\u043b\u0430 &ndash; \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u0430 \u043c\u0456\u0440\u0430 &ndash; \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"468","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043d\u0430 \u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u041f\u0430\u043d\u0430, \u044f\u043a\u043e\u0435 \u043f\u0440\u044b\u043f\u0456\u0441\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0432. \u0413\u0456\u043f\u0430\u043b\u0456\u0442\u0443, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 2. 6-8. 10: PG 10, 854. 858-859. 862)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u0430\u0434\u0430 \u0456 \u0414\u0443\u0445<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u042f\u043d\u0430 \u0456 \u043f\u0440\u044b\u043d\u044f\u045e \u0430\u0434 \u044f\u0433\u043e \u0445\u0440\u043e\u0441\u0442. \u041e, \u0433\u043e\u0434\u043d\u0430\u044f \u043d\u0430\u0439\u0432\u044f\u043b\u0456\u043a\u0448\u0430\u0433\u0430 \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0430\u0434\u0437\u0435\u044f! \u0411\u044f\u0441&shy;\u043a\u043e\u043d\u0446\u0443\u044e \u0440\u0430\u043a\u0443, \u044f\u043a\u0430\u044f \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0433\u043e\u0440\u0430\u0434 \u0411\u043e\u0436\u044b, \u0430\u0431\u043c\u044b\u0432\u0430\u0435 \u043c\u0430\u043b\u0430\u044f \u0432\u0430\u0434\u0430. \u041d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u0430\u044f \u0456 \u043d\u0435\u0432\u044b\u0447\u044d\u0440\u043f\u043d\u0430\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430, \u0448\u0442\u043e \u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c, \u0437\u0430\u043d\u0443\u0440\u0430\u0435\u0446\u0446\u0430 \u045e \u043c\u0430\u043b\u0443\u044e \u0456 \u0447\u0430\u0441\u043e\u0432\u0443\u044e \u0432\u0430\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u044e\u0434\u044b\u0456\u0441\u043d\u044b \u0456 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u044b \u043f\u0430\u045e\u0441\u044e\u043b\u044c, \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u044b \u0434\u043b\u044f \u0430\u043d\u0451\u043b\u0430\u045e \u0456 \u043d\u0435\u0434\u0430\u0441\u044f\u0436\u043d\u044b \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0437\u0440\u043e\u043a\u0443 \u0437 \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0430\u0435 \u0434\u0430 \u0445\u0440\u043e\u0441\u0442\u0443. \u0406 \u0440\u0430\u0441\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u042f\u043c\u0443 \u043d\u044f\u0431\u0451\u0441\u044b, \u0456 \u043f\u0430\u0447\u0443\u045e\u0441\u044f \u0433\u043e\u043b\u0430\u0441. \u0406 \u0433\u043e\u043b\u0430\u0441 \u0437 \u043d\u0435\u0431\u0430 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e: &laquo;\u0413\u044d\u0442\u0430 \u0421\u044b\u043d \u041c\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u044f\u043a\u043e\u0433\u0430 \u042f \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e&raquo; (\u041c\u0446 3, 17).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456, \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u043b\u044e\u0431\u043e\u045e, \u0430 \u043d\u0435\u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u043d\u0435\u0434\u0430\u0441\u044f\u0436\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e. \u0413\u044d\u0442\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u044b\u045e \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0441\u044b\u043d\u0430\u043c \u042e\u0437\u0430\u0444\u0430 \u0456 \u0451\u0441\u0446\u044c \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0413\u044d\u0442\u0430 \u0421\u044b\u043d \u041c\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b&raquo;. \u0401\u043d \u0433\u0430\u043b\u043e\u0434\u043d\u044b, \u0430\u043b\u0435 \u0441\u0430\u043c \u043a\u043e\u0440\u043c\u0456\u0446\u044c \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u044f \u0442\u044b\u0441\u044f\u0447\u044b. \u0401\u043d \u043f\u0440\u0430\u0446\u0443\u0435, \u0430\u043b\u0435 \u0441\u0430\u043c \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u043f\u0440\u0430\u0446\u0430\u045e\u043d\u0456\u043a\u043e\u045e. \u042f\u043c\u0443 \u043d\u044f\u043c\u0430 \u0434\u0437\u0435 \u0441\u0445\u0456\u043b\u0456\u0446\u044c \u0433\u0430\u043b\u0430\u0432\u044b, \u0445\u043e\u0446\u044c \u0401\u043d \u0443\u0441\u0451 \u0442\u0440\u044b\u043c\u0430\u0435 \u045e \u0440\u0443\u043a\u0430\u0445. \u0401\u043d \u0446\u0435\u0440\u043f\u0456\u0446\u044c, \u0430\u043b\u0435 \u0441\u0430\u043c \u043b\u0435\u0447\u044b\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456. \u0401\u043d \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u0430\u0431\u043e\u0456, \u0430\u043b\u0435 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u0441\u0432\u0430\u0431\u043e\u0434\u0430\u044e \u0441\u0432\u0435\u0442. \u042f\u043c\u0443 \u043f\u0440\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u0431\u043e\u043a, \u0430\u043b\u0435 \u0401\u043d \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u0435 \u0431\u043e\u043a \u0410\u0434\u0430\u043c\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043f\u0440\u0430\u0448\u0443, \u0443\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435\u0441\u044f \u0434\u0430 \u043c\u044f\u043d\u0435, \u0431\u043e \u044f \u0445\u0430\u0447\u0443 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0436\u044b\u0446\u0446\u044f \u0456 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0430\u0434 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439, \u0437 \u044f\u043a\u043e\u0439 \u0431&rsquo;\u0435 \u0441\u0442\u0440\u0443\u043c\u0435\u043d\u044c \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0439\u0446\u0435\u0446 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0443 \u0441\u0432\u0435\u0442 \u0421\u043b\u043e\u0432\u0430 \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439 \u0430\u0431\u043c\u044b\u0446\u044c \u0456\u0445 \u0432\u0430\u0434\u043e\u044e \u0456 \u0414\u0443\u0445\u0430\u043c, \u0430 \u043a\u0430\u0431 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443 \u0446\u0435\u043b\u0430 \u0456 \u0434\u0443\u0448\u044b, \u0401\u043d \u0443\u0434\u044b\u0445\u043d\u0443\u045e \u0443 \u043d\u0430\u0441 \u0434\u044b\u0445\u0430\u043d\u043d\u0435 \u0436\u044b\u0446\u0446\u044f \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u043d\u0430\u0441 \u0443 \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u044b\u044f \u0434\u0430\u0441\u043f\u0435\u0445\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0442\u0430\u045e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c, \u0451\u043d \u0441\u0442\u0430\u043d\u0435 \u044f\u043a \u0411\u043e\u0433. \u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0432\u0430\u0434\u0443 \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044e \u0456 \u0430\u0431\u043c\u044b\u0446\u0446\u044e \u0451\u043d \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u044f\u043a \u0411\u043e\u0433, \u0442\u043e \u0432\u044f\u0434\u043e\u043c\u0430, \u0448\u0442\u043e \u043f\u0430\u0441\u043b\u044f \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u044f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e, \u044f\u043a \u0432\u044f\u0441\u0442\u0443\u043d: \u043f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0443\u0441\u0435 \u043f\u043b\u044f\u043c\u0451\u043d\u044b \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u0446\u0446\u0430 \u045e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c. \u0413\u044d\u0442\u0430 &ndash; \u0432\u0430\u0434\u0430, \u0437\u043b\u0443\u0447\u0430\u043d\u0430\u044f \u0437 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u044f\u043a\u0430\u044f \u0430\u0440\u0430\u0448\u0430\u0435 \u0440\u0430\u0439 \u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0443\u0440\u0430\u0434\u043b\u0456\u0432\u0430\u0439 \u0437\u044f\u043c\u043b\u044e, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0451\u0439 \u043a\u0432\u0456\u0442\u043d\u0435\u044e\u0446\u044c \u0440\u0430\u0441\u043b\u0456\u043d\u044b, \u0430 \u0436\u044b\u0432\u044b\u044f \u0456\u0441\u0442\u043e\u0442\u044b \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e\u0446\u044c \u0436\u044b\u0446\u0446\u0451. \u041a\u0430\u043b\u0456 \u045e\u0441\u0451 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u0446\u0456\u0441\u043b\u0430, \u0442\u043e \u043f\u0440\u0430\u0437 \u044f\u0435 \u0430\u0436\u044b\u0432\u0430\u0435 \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a; \u0443 \u0451\u0439 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043d\u044f\u045e \u0445\u0440\u043e\u0441\u0442; \u043d\u0430 \u044f\u0435 \u0441\u044b\u0448\u043e\u045e \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u045e \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0433\u043e\u043b\u0443\u0431\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0437 \u0432\u0435\u0440\u0430\u044e \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u043a\u0443\u043f\u0435\u043b\u0456 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f, \u0442\u043e\u0439 \u0432\u044b\u0440\u0430\u043a\u0430\u0435\u0446\u0446\u0430 \u0434&rsquo;\u044f\u0431\u043b\u0430 \u0456 \u0430\u0434\u0434\u0430\u0435 \u0441\u044f\u0431\u0435 \u0425\u0440\u044b\u0441\u0442\u0443; \u0442\u043e\u0439 \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u0435 \u0432\u043e\u0440\u0430\u0433\u0443 \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u0411\u043e\u0433\u0430\u043c; \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434 \u043d\u044f\u0432\u043e\u043b\u0456 \u0456 \u043f\u0440\u044b\u043c\u0430\u0435 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435; \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0445\u0440\u043e\u0441\u0442\u0443 \u044f\u0441\u043d\u044b\u043c, \u044f\u043a \u0441\u043e\u043d\u0446\u0430, \u0437 \u043f\u0440\u043e\u043c\u043d\u044f\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456; \u0456, \u0448\u0442\u043e \u043d\u0430\u0439\u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0430\u0435, \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u044f\u043a \u0434\u0437\u0456\u0446\u044f \u0411\u043e\u0436\u0430\u0435 \u0456 \u0441\u0443\u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u0456 \u043c\u043e\u0446 \u0440\u0430\u0437\u0430\u043c \u0437 \u042f\u0433\u043e \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u044b\u043c \u0456 \u0436\u044b\u0432\u0430\u0442\u0432\u043e\u0440\u043d\u044b\u043c \u0414\u0443\u0445\u0430\u043c, \u0446\u044f\u043f\u0435\u0440 \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0456 \u043d\u0430 \u045e\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 1, 32. 34. 33<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0431\u0430\u0447\u044b\u045e \u0414\u0443\u0445\u0430, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u043d\u0435\u0431\u0430, \u044f\u043a \u0433\u043e\u043b\u0443\u0431, \u0456 \u0441\u043f\u0430\u0447\u044b\u045e \u043d\u0430 \u0406\u043c, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u044f \u0431\u0430\u0447\u044b\u045e \u0456 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e, \u0448\u0442\u043e \u0401\u043d &ndash; \u0421\u044b\u043d \u0411\u043e\u0436\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c \u0432\u0430\u0434\u043e\u044e, \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u041d\u0430\u0434 \u043a\u0456\u043c \u0443\u0431\u0430\u0447\u044b\u0448 \u0414\u0443\u0445\u0430, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0406\u043c, \u0442\u043e\u0439 \u0451\u0441\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u044f \u0431\u0430\u0447\u044b\u045e \u0456 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e, \u0448\u0442\u043e \u0401\u043d &ndash; \u0421\u044b\u043d \u0411\u043e\u0436\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"469","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041f\u0440\u043e\u043a\u043b\u0430, \u043a\u0430\u043d\u0441\u0442\u0430\u043d\u0446\u0456\u043d\u043e\u043f\u0430\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 7 in sancta Theophania, 1-3: PG 65, 758-759)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0410\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0432\u0430\u0434\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0441\u0432\u0435\u0442\u0443 \u0456, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u044e\u0447\u044b \u0431\u044f\u0437\u043b\u0430\u0434\u043d\u044b \u0441\u0432\u0435\u0442, \u0437\u0440\u0430\u0431\u0456\u045e \u044f\u0433\u043e \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044e. \u0401\u043d \u043f\u0440\u044b\u043d\u044f\u045e \u0433\u0440\u044d\u0445 \u0441\u0432\u0435\u0442\u0443 \u0456 \u043f\u0440\u0430\u0433\u043d\u0430\u045e \u0432\u043e\u0440\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0401\u043d \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0432\u043e\u0434\u0430\u045e \u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u043b\u044e\u0434\u0441\u043a\u0456\u044f \u0434\u0443\u0448\u044b. \u0401\u043d \u0441\u043f\u0430\u043b\u0443\u0447\u044b\u045e \u0446\u0443\u0434\u044b \u0437 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u044b\u043c\u0456 \u0446\u0443\u0434\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f \u0437\u044f\u043c\u043b\u044f \u0456 \u043c\u043e\u0440\u0430 \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u043b\u0456 \u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u044e \u043b\u0430\u0441\u043a\u0443 \u041f\u0430\u043d\u0430, \u0430 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0430\u043b\u0435 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u0456 \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0446\u0443\u0434\u0430\u045e, \u0447\u044b\u043c \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u044f\u044f \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043d\u044f\u0434\u0430\u045e\u043d\u0456 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u043d\u0430\u045e \u0417\u0431\u0430\u045e\u0446\u044b \u0437\u044f\u043c\u043b\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0431\u043e \u044f\u043d\u0430 \u043d\u0430\u0441\u0456\u043b\u0430 \u045e \u044f\u0441\u043b\u044f\u0445 \u041f\u0430\u043d\u0430. \u0410 \u045e \u0433\u044d\u0442\u044b \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u0456 \u0434\u0437\u0435\u043d\u044c \u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u041f\u0430\u043d\u0430 \u0437\u0430\u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043b\u0430\u0441\u044f \u0430\u0434 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0432\u0430\u0434\u0430, \u0431\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u042f\u0440\u0434\u0430\u043d\u0430 \u0430\u0441\u0432\u044f\u0447\u0430\u043b\u044c\u043d\u0430\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0447\u0430\u0441 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u044f\u0439 \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u043c\u0456 \u0431\u044b\u043b\u043e \u0431\u0435\u0437\u0434\u0430\u043f\u0430\u043c\u043e\u0436\u043d\u0430\u0435 \u043d\u0435\u043c\u0430\u045e\u043b\u044f, \u044f\u043a\u043e\u0435 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u043b\u0430 \u043d\u0430\u0448\u0443 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c. \u0410 \u043f\u0430\u0434\u0447\u0430\u0441 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0441\u0432\u044f\u0442\u0430 \u0431\u0430\u0447\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0442\u0430\u043b\u044b, \u044f\u043a\u0456 \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u043e\u045e\u0432\u0430\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c \u0442\u0430\u0433\u043e, \u0430\u0434 \u043a\u0430\u0433\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c. \u0422\u0430\u0434\u044b \u041a\u0430\u0440\u043e\u043b\u044c \u0430\u043f\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u045e \u043f\u0443\u0440\u043f\u0443\u0440 \u0446\u0435\u043b\u0430, \u0430 \u0441\u0451\u043d\u043d\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0430\u043a\u0440\u0443\u0436\u044b\u043b\u0430 \u0440\u0430\u043a\u0443 \u0456 \u043d\u0456\u0431\u044b \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0430\u0441\u044f \u045e \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0456\u0434\u0437\u0456\u0446\u0435 \u0436 \u0456 \u045e\u0431\u0430\u0447\u0446\u0435 \u043d\u043e\u0432\u044b\u044f \u0456 \u0434\u0437\u0456\u0432\u043e\u0441\u043d\u044b\u044f \u0446\u0443\u0434\u044b: \u0441\u043e\u043d\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043f\u0440\u044b\u043c\u0430\u0435 \u043a\u0443\u043f\u0435\u043b\u044c \u0443 \u042f\u0440\u0434\u0430\u043d\u0435, \u0430\u0433\u043e\u043d\u044c \u0437\u0430\u043d\u0443\u0440\u0430\u0435\u0446\u0446\u0430 \u045e \u0432\u0430\u0434\u0443, \u0456 \u0411\u043e\u0433\u0430 \u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u0441\u043b\u0443\u0433\u0430&shy;\u0447\u0430\u043b\u0430\u0432\u0435\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f \u043a\u043e\u0436\u043d\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435, \u0441\u043f\u044f\u0432\u0430\u044e\u0447\u044b \u0433\u0456\u043c\u043d\u044b: &laquo;\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b, \u044f\u043a\u0456 \u0456\u0434\u0437\u0435 \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430&raquo; (\u041f\u0441 118 [117], 26). \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0432\u0435\u0441\u044c \u0447\u0430\u0441, \u0431\u043e \u0446\u044f\u043f\u0435\u0440 \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0435 \u043f\u0435\u0440\u0448\u044b \u0440\u0430\u0437.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0445\u0442\u043e \u0436 \u0433\u044d\u0442\u0430? \u041f\u0440\u0430\u0448\u0443 \u0446\u044f\u0431\u0435, \u0441\u043a\u0430\u0436\u044b \u0431\u043e\u043b\u044c\u0448 \u0432\u044b\u0440\u0430\u0437\u043d\u0430, \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0414\u0430\u0432\u0456\u0434\u0437\u0435: &laquo;\u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u0401\u043d \u0434\u0430\u0435 \u043d\u0430\u043c \u0441\u0432\u044f\u0442\u043b\u043e&raquo; (\u041f\u0441 118 [117], 27). \u0406 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u0440\u0430\u0440\u043e\u043a \u0414\u0430\u0432\u0456\u0434 \u043a\u0430\u0436\u0430 \u0433\u044d\u0442\u0430, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b \u0434\u0430\u043b\u0443\u0447\u0430\u0435 \u0434\u0430 \u044f\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u045e \u0441\u0432\u0430\u0451 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435: &laquo;\u0417&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043b\u0430\u0441\u043a\u0430 \u0411\u043e\u0436\u0430\u044f, \u0437\u0431\u0430\u045e\u0447\u0430\u044f \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0430\u044f \u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441&raquo; (\u043f\u0430\u0440. \u0426\u0456\u0442 2, 11). \u041d\u0435 \u0434\u043b\u044f \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456, \u0430 \u0434\u043b\u044f \u045e\u0441\u0456\u0445, \u0431\u043e \u045e\u0441\u0456\u043c, \u044e\u0434\u044d\u044f\u043c \u0446\u0456 \u0433\u0440\u044d\u043a\u0430\u043c, \u043f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442 \u0443\u0434\u0437\u044f\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0445\u0440\u043e\u0441\u0442 \u0434\u0430\u0435 \u045e\u0441\u0456\u043c \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0435 \u0434\u0430\u0431\u0440\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u0436 \u043d\u0430 \u0434\u0437\u0456\u045e\u043d\u044b \u043d\u043e\u0432\u044b \u043f\u0430\u0442\u043e\u043f, \u0431\u043e\u043b\u044c\u0448 \u0432\u044f\u043b\u0456\u043a\u0456 \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u0435\u0439\u0448\u044b \u0437\u0430 \u0442\u043e\u0439, \u0448\u0442\u043e \u0431\u044b\u045e \u0443 \u0447\u0430\u0441\u044b \u041d\u043e\u044f. \u0411\u043e \u0442\u0430\u0434\u044b \u0432\u0430\u0434\u0430 \u043f\u0430\u0442\u043e\u043f\u0443 \u0433\u0443\u0431\u0456\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430, \u0430 \u0446\u044f\u043f\u0435\u0440 \u0432\u0430\u0434\u0430 \u0445\u0440\u043e\u0441\u0442\u0443 \u043c\u043e\u0446\u0430\u044e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431\u044b\u045e \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b, \u043a\u043b\u0456\u0447\u0430 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f. \u0422\u0430\u0434\u044b \u0433\u043e\u043b\u0443\u0431 \u0442\u0440\u044b\u043c\u0430\u045e \u0443 \u0434\u0437\u044e\u0431\u0435 \u0433\u0430\u043b\u0456\u043d\u043a\u0443 \u0430\u043b\u0456\u0432\u044b, \u0448\u0442\u043e \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043b\u0430 \u043f\u0430\u0445\u0443\u0447\u044b \u0432\u043e\u0434\u0430\u0440 \u0425\u0440\u044b\u0441\u0442\u0430. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u045e \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0433\u043e\u043b\u0443\u0431\u0430, \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0433\u0430 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0451\u043d\u043d\u044f \u043d\u0430\u043c \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0421\u0432\u044f\u0442\u043b\u043e \u0430\u0434 \u0421\u0432\u044f\u0442\u043b\u0430, \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u042f\u043d \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u045e \u0443 \u042f\u0440\u0434\u0430\u043d\u0435. <span style=\"color: #ff0000;\">*<\/span> \u041c\u044b \u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0401\u043d \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u0434 \u0406\u043c \u0430\u0434\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u043d\u044f\u0431\u0451\u0441\u044b, \u0456 \u043f\u0430\u0447\u0443\u045e\u0441\u044f \u0433\u043e\u043b\u0430\u0441 \u0410\u0439\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b \u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0401\u043d \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"470","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430&raquo; \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 5, cap. 2: PG 73, 751-754)<\/span><br \/><em><span style=\"color: #ff0000;\">\u042f \u043f\u0440\u0430\u043b\u044c\u044e \u0414\u0443\u0445\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0441\u0443\u0441\u0432\u0435\u0442\u0443 \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u043d\u0430\u0439\u0446\u0443\u0434\u043e\u045e\u043d\u0435\u0439\u0448\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0443\u0441\u0451 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0456 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443 \u0434\u0430 \u043f\u0435\u0440\u0448\u0430\u0441\u043d\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u0443, \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435, \u0448\u0442\u043e \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043d\u0448\u044b\u043c\u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456 \u0434\u0430 \u044f\u0433\u043e \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0441\u0430 \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u044e \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u0431\u043e \u0456\u043d\u0430\u043a\u0448 \u043d\u0435\u043b\u044c\u0433\u0430 \u0431\u044b\u043b\u043e \u045e\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u0446\u044c \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430\u0435 \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0435 \u0432\u0430\u043b\u043e\u0434\u0430\u043d\u043d\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c\u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0411\u043e\u0433 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u0435 \u0447\u0430\u0441 \u0441\u044b\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u044f \u043d\u0430 \u043d\u0430\u0441 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u0434\u0430\u0435 \u043d\u0430\u043a\u043e\u043d\u0442 \u0433\u044d\u0442\u0430\u0433\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0423 \u0442\u044b\u044f \u0434\u043d\u0456, \u0443 \u0434\u043d\u0456 \u0417\u0431\u0430\u045e\u0446\u044b, \u042f \u043f\u0440\u0430\u043b\u044c\u044e \u0414\u0443\u0445\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430 \u043a\u043e\u0436\u043d\u0430\u0435 \u0446\u0435\u043b\u0430&raquo; (\u043f\u0430\u0440. \u0401\u044d\u043b 3, 1).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u045e \u0447\u0430\u0441 \u0442\u0430\u043a\u043e\u0433\u0430 \u0448\u0447\u043e\u0434\u0440\u0430\u0433\u0430 \u0434\u0430\u0440\u0443, \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u045e \u0446\u0435\u043b\u0435, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u044f\u043a \u043a\u0430\u0436\u0430 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435. \u0422\u0430\u0434\u044b \u0411\u043e\u0433 \u0456 \u0410\u0439\u0446\u0435\u0446 \u0437\u043d\u043e\u045e \u043f\u0430\u0441\u043b\u0430\u045e \u0414\u0443\u0445\u0430, \u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u044f\u043a \u043f\u0435\u0440\u0448\u044b\u043d\u0435\u0446 \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u043f\u0440\u044b\u043d\u044f\u045e \u042f\u0433\u043e. \u041f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u042f\u043d \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044c: &laquo;\u042f \u0431\u0430\u0447\u044b\u045e \u0414\u0443\u0445\u0430, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u043d\u0435\u0431\u0430, \u044f\u043a \u0433\u043e\u043b\u0443\u0431, \u0456 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u045e \u043d\u0430 \u0406\u043c&raquo; (\u042f\u043d 1, 32).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0414\u0443\u0445\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0456 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u044f\u0433\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c. \u0425\u043e\u0446\u044c \u0421\u044b\u043d \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0430\u0434 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u0456 \u0431\u044b\u045e \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0437 \u042f\u0433\u043e \u044f\u0448\u0447\u044d \u043f\u0435\u0440\u0430\u0434 \u0443\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u043f\u0435\u0440\u0430\u0434 \u0432\u044f\u043a\u0430\u043c\u0456, \u0430\u0434\u043d\u0430\u043a \u042f\u043c\u0443 \u043d\u0435 \u043a\u0440\u044b\u045e\u0434\u043d\u0430 \u0447\u0443\u0446\u044c, \u044f\u043a \u0411\u043e\u0433 \u0456 \u0410\u0439\u0446\u0435\u0446 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u042f\u0433\u043e, \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u0401\u043d \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c: &laquo;\u0422\u044b \u0421\u044b\u043d \u041c\u043e\u0439, \u042f \u0426\u044f\u0431\u0435 \u0441\u0451\u043d\u043d\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e&raquo; (\u041f\u0441 2, 7).<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043f\u0435\u0440\u0430\u0434 \u0432\u044f\u043a\u0430\u043c\u0456 \u0431\u044b\u045e \u0411\u043e\u0433\u0430\u043c \u0456 \u0431\u044b\u045e \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0430\u0434 \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 \u0411\u043e\u0433 \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u042f\u0433\u043e \u0441\u0451\u043d\u043d\u044f, \u043a\u0430\u0431 \u0443 \u0406\u043c \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043d\u0430\u0441 \u044f\u043a \u0443\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439, \u0431\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u043a\u0430\u043b\u0456 \u0401\u043d \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u0430 \u045e\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430. \u0422\u0430\u043a \u0456 \u0410\u0439\u0446\u0435\u0446, \u0445\u043e\u0446\u044c \u0456 \u043c\u0430\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u0414\u0443\u0445\u0430, \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u0437\u043d\u043e\u045e \u0434\u0430\u0435 \u042f\u0433\u043e \u0421\u044b\u043d\u0443, \u043a\u0430\u0431 \u043c\u044b \u0437\u0434\u0430\u0431\u044b\u043b\u0456 \u045e \u0406\u043c \u0414\u0443\u0445\u0430. \u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0437 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0401\u043d \u0443\u0437\u044f\u045e \u0443\u0434\u0437\u0435\u043b \u0443 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0435 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u044f\u043a \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u045e\u0441\u044f \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u043f\u0440\u044b\u043c\u0430\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043d\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0431\u043e, \u044f\u043a \u043c\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0440\u0430\u043d\u0435\u0439, \u0401\u043d \u0456 \u0442\u0430\u043a \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u042f\u043c\u0443, \u0430 \u045e \u0406\u043c \u0456 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u045e\u0434\u0437\u044f\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u043c. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0432\u0430 \u045e\u0441\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0446\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0401\u043d \u043f\u0440\u044b\u043c\u0430\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043a\u0430\u0431 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0443\u0441\u044e \u043d\u0430\u0442\u0443\u0440\u0443 \u0456 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u044f\u0435 \u0434\u0430 \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u0443. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u043a\u0430\u043b\u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0430 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f\u045e \u041f\u0456\u0441\u0430\u043d\u043d\u044f, \u0442\u043e \u045e\u0431\u0430\u0447\u044b\u043c, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043d\u044f\u045e \u0414\u0443\u0445\u0430 \u043d\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0434\u043b\u044f \u043d\u0430\u0441 \u0443 \u0441\u0430\u0431\u0435 \u0441\u0430\u043c\u0456\u043c. \u0406 \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u0443\u0441\u044f\u043a\u0430\u0435 \u0434\u0430\u0431\u0440\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u043d\u0430\u0441 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0437\u0445 37, 27-28; \u0413\u0431\u0440 8, 8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0431\u0443\u0434\u0443 \u0456\u0445 \u0411\u043e\u0433\u0430\u043c, \u0430 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0434\u0430\u0432\u0435\u0434\u0430\u044e\u0446\u0446\u0430 \u045e\u0441\u0435, \u0448\u0442\u043e \u042f, \u041f\u0430\u043d, \u0430\u0441\u0432\u044f\u0447\u0430\u044e \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u043a\u0430\u043b\u0456 \u041c\u0430\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0431\u0443\u0434\u0437\u0435 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0437\u0430\u043a\u043b\u044e\u0447\u0443 \u0437 \u0434\u043e\u043c\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u0437 \u0434\u043e\u043c\u0430\u043c \u042e\u0434\u044b \u043d\u043e\u0432\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0434\u0430\u0432\u0435\u0434\u0430\u044e\u0446\u0446\u0430 \u045e\u0441\u0435, \u0448\u0442\u043e \u042f, \u041f\u0430\u043d, \u0430\u0441\u0432\u044f\u0447\u0430\u044e \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u043a\u0430\u043b\u0456 \u041c\u0430\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0431\u0443\u0434\u0437\u0435 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"471","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041c\u0430\u043a\u0441\u0456\u043c\u0430 \u0422\u0443\u0440\u044b\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 100, de sancta Epiphania 1, 3: CCL 23, 398-400)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0422\u0430\u044f\u043c\u043d\u0456\u0447\u0430\u044f \u043c\u043e\u0446 \u0445\u0440\u043e\u0441\u0442\u0443 \u041f\u0430\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u0435, \u0448\u0442\u043e \u041f\u0430\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u042f\u0440\u0434\u0430\u043d\u0430 \u0434\u0437\u0435\u043b\u044f \u0445\u0440\u043e\u0441\u0442\u0443 \u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0443 \u0433\u044d\u0442\u0430\u0439 \u0441\u0430\u043c\u0430\u0439 \u0440\u0430\u0446\u044d \u043f\u0430\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0430\u043b\u043a\u0430\u043c \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0448\u0442\u043e \u043f\u0430\u0441\u043b\u044f \u041d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u041f\u0430\u043d\u0430, \u0445\u043e\u0446\u044c \u0456 \u043c\u0456\u043d\u0443\u043b\u0430 \u0448\u043c\u0430\u0442 \u0433\u0430\u0434\u043e\u045e, \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0456\u0441\u0446\u0456 \u0433\u044d\u0442\u0430\u044f \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e, \u043d\u0430 \u043c\u0430\u044e \u0434\u0443\u043c\u043a\u0443, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u043e\u0436\u043d\u0430 \u043d\u0430\u0437\u0432\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u0430\u043c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439, \u0441\u0451\u043d\u043d\u044f \u0430\u0434\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u0445. \u0422\u0430\u0434\u044b \u0401\u043d \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0414\u0437\u0435\u0432\u044b, \u0441\u0451\u043d\u043d\u044f &ndash; \u0437 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b. \u041a\u0430\u043b\u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u041c\u0430\u0446\u0456 \u041c\u0430\u0440\u044b\u044f \u0442\u0443\u043b\u0456\u043b\u0430 \u042f\u0433\u043e \u043d\u0430 \u0433\u0440\u0443\u0434\u0437\u044f\u0445. \u0426\u044f\u043f\u0435\u0440, \u043a\u0430\u043b\u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u0411\u043e\u0433 \u0410\u0439\u0446\u0435\u0446 \u0430\u0431\u043d\u044f\u045e \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0413\u044d\u0442\u0430 \u0421\u044b\u043d \u041c\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u044f\u043a\u043e\u0433\u0430 \u042f \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e. \u042f\u0433\u043e \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435&raquo; (\u041c\u0446 17, 5). \u0422\u0430\u043a, \u041c\u0430\u0446\u0456 \u043f\u044f\u0448\u0447\u043e\u0442\u043d\u0430 \u043f\u0435\u0441\u0446\u0456\u0446\u044c \u041d\u0435\u043c\u0430\u045e\u043b\u044f \u043d\u0430 \u045e\u043b\u043e\u043d\u043d\u0456, \u0410\u0439\u0446\u0435\u0446 \u0436\u0430 \u0437 \u043b\u044e\u0431\u043e\u045e\u044e \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u042f\u0433\u043e \u044f\u043a \u043f\u0440\u0430 \u0421\u044b\u043d\u0430; \u041c\u0430\u0446\u0456, \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u042f\u0433\u043e \u043c\u0443\u0434\u0440\u0430\u0446\u0430\u043c \u0434\u043b\u044f \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u044f, \u0430 \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0434\u043b\u044f \u045e\u0448\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0445\u0440\u043e\u0441\u0442 \u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0430\u0431\u043c\u044b\u0446\u044c \u0432\u0430\u0434\u043e\u0439 \u0441\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043e\u0435 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043e\u0436\u043d\u0430 \u0441\u043f\u044b\u0442\u0430\u0446\u0446\u0430: &laquo;\u0427\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u0432\u044f\u0442\u044b, \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u0446\u0446\u0430?&raquo; \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0436\u0430! \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043c\u0430\u045e \u0445\u0440\u043e\u0441\u0442 \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0441\u0430\u043c\u043e\u043c\u0443 \u0430\u0441\u0432\u044f\u0446\u0456\u0446\u0446\u0430 \u045e \u0432\u0430\u0434\u0437\u0435, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0430\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0441\u0430\u043c\u0443 \u0432\u0430\u0434\u0443 \u0456 \u0441\u0432\u0430\u0456\u043c \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u0435\u043c \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u0442\u0443\u044e \u043f\u043b\u044b\u043d\u044c, \u0434\u0430 \u044f\u043a\u043e\u0439 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f. \u0411\u043e \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0456 \u0451\u0441\u0446\u044c \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0432\u0430\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0417\u0431\u0430\u045e\u0446\u0430 \u0430\u0431\u043c\u044b\u0432\u0430\u0435\u0446\u0446\u0430, \u0443\u0436\u043e \u0442\u0430\u0434\u044b \u0430\u0447\u044b\u0448\u0447\u0430\u0435\u0446\u0446\u0430 \u045e\u0441\u044f \u0432\u0430\u0434\u0430 \u0434\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0445\u0440\u043e\u0441\u0442\u0443 \u0456 \u0430\u0447\u044b\u0448\u0447\u0430\u0435\u0446\u0446\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0448\u0442\u043e \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u043b\u044f, \u043b\u0430\u0441\u043a\u0430\u0439 \u043a\u0443\u043f\u0435\u043b\u0456. \u0422\u0430\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u0447\u0430\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u043a\u0430\u0431 \u044f\u043d\u044b \u0437 \u0434\u0430\u0432\u0435\u0440\u0430\u043c \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430 \u0406\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0440\u0430\u0437\u0443\u043c\u0435\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0442\u0430\u043a: \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u044b \u0441\u043b\u0443\u043f \u0456\u0448\u043e\u045e \u043d\u0430\u043f\u0435\u0440\u0430\u0434\u0437\u0435 \u043f\u0440\u044b \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0437\u0435 \u043f\u0440\u0430\u0437 \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0435 \u043c\u043e\u0440\u0430, \u043a\u0430\u0431 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0430\u0434\u0432\u0430\u0436\u043d\u0430 \u0456\u0448\u043b\u0456 \u043f\u0430 \u0448\u043b\u044f\u0445\u0443; \u0456 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u044b \u0441\u043b\u0443\u043f \u043f\u0435\u0440\u0448\u044b \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e \u043f\u0440\u0430\u0437 \u0432\u0430\u0434\u0443, \u043a\u0430\u0431 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u0441\u0446\u0435\u0436\u043a\u0443 \u0442\u044b\u043c, \u0445\u0442\u043e \u0456\u0448\u043e\u045e \u0437\u0430 \u0456\u043c. \u0413\u044d\u0442\u0430\u044f \u043f\u0430\u0434\u0437\u0435\u044f, \u044f\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043b\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0445\u0440\u043e\u0441\u0442\u0443. \u0423 \u043f\u044d\u045e\u043d\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u0433\u044d\u0442\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u043b\u0430 \u0445\u0440\u043e\u0441\u0442, \u043a\u0430\u043b\u0456 \u0432\u043e\u0431\u043b\u0430\u043a\u0456 \u043f\u0430\u043a\u0440\u044b\u0432\u0430\u043b\u0456 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430 \u0445\u0432\u0430\u043b\u044f \u0456\u0445 \u043d\u0435\u0441\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u0443\u0441\u0451 \u0433\u044d\u0442\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d. \u042f\u043a \u0442\u0430\u0434\u044b \u0401\u043d \u0443 \u0432\u043e\u0433\u043d\u0435\u043d\u044b\u043c \u0441\u043b\u0443\u043f\u0435 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u0447\u0430\u045e \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u0430 \u0448\u043b\u044f\u0445\u0443 \u043f\u0440\u0430\u0437 \u043c\u043e\u0440\u0430, \u0442\u0430\u043a \u0446\u044f\u043f\u0435\u0440 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u0447\u0430\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0430\u043c. \u0421\u043a\u0430\u0436\u0443, \u0448\u0442\u043e \u0442\u043e\u0439 \u0441\u043b\u0443\u043f, \u044f\u043a\u0456 \u0431\u044b\u045e \u0442\u0430\u0434\u044b \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u044b\u0445, \u0441\u0451\u043d\u043d\u044f \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0441\u044d\u0440\u0446\u044b \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e. \u0422\u0430\u0434\u044b \u0451\u043d \u043f\u0440\u0430\u043a\u043b\u0430\u0434\u0432\u0430\u045e \u0441\u0446\u0435\u0436\u043a\u0443 \u045e \u043f\u0430\u0442\u043e\u043a\u0430\u0445 \u0432\u043e\u0434\u0430\u045e, \u0446\u044f\u043f\u0435\u0440 \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0448\u043b\u044f\u0445 \u043f\u0440\u0430\u0437 \u043a\u0443\u043f\u0435\u043b\u044c \u0432\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 1, 29; \u0406\u0441 53, 11<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043d \u0443\u0431\u0430\u0447\u044b\u045e \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u0456 \u0456\u0448\u043e\u045e \u0434\u0430 \u044f\u0433\u043e, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u0412\u043e\u0441\u044c \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0411\u043e\u0436\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0412\u043e\u0441\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u044f\u0440\u044d \u043d\u0430 \u0441\u044f\u0431\u0435 \u0433\u0440\u044d\u0445 \u0441\u0432\u0435\u0442\u0443. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u0435 \u043c\u043d\u043e\u0433\u0456\u0445, \u0456 \u0441\u0430\u043c \u043f\u0430\u043d\u044f\u0441\u0435 \u0456\u0445 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u044f\u0440\u044d \u043d\u0430 \u0441\u044f\u0431\u0435 \u0433\u0440\u044d\u0445 \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"472","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0424\u0430\u045e\u0441\u0442\u0430 \u0420\u044b\u0435\u0437\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 5, de Epiphania 2: PLS 3, 560-562)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u044f\u0441\u0435\u043b\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c \u0431\u044b\u043b\u043e \u0432\u044f\u0441\u0435\u043b\u043b\u0435&raquo; (\u042f\u043d 2, 1). \u0427\u044b\u043c \u0431\u044b\u043b\u043e \u0433\u044d\u0442\u0430 \u0432\u044f\u0441\u0435\u043b\u043b\u0435, \u044f\u043a \u043d\u0435 \u0448\u043b\u044e\u0431\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u043c\u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044e, \u044f\u043a\u043e\u0435 \u045e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0433\u044d\u0442\u0430\u0439 \u043b\u0456\u0447\u0431\u044b \u0441\u0432\u044f\u0442\u043a\u0443\u0435\u0446\u0446\u0430 \u0456 \u045e \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0456 \u0422\u0440\u043e\u0439\u0446\u044b \u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0432\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u043d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c?<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0456\u043d\u0448\u044b\u043c \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u043c \u0430\u043f\u0430\u0432\u044f\u0434\u0430\u043d\u043d\u0456 \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u043c\u0430\u043b\u043e\u0434\u0448\u0430\u0433\u0430 \u0441\u044b\u043d\u0430, \u044f\u043a\u043e\u0435 \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0443\u0435 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0444\u043e\u043d\u0435 \u0441\u043f\u0435\u0432\u0430\u045e, \u043c\u0443\u0437\u044b\u043a\u0456 \u0456 \u0432\u044f\u0441\u0435\u043b\u044c\u043d\u044b\u0445 \u0448\u0430\u0442\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043c\u0430\u043b\u0430\u0434\u044b \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0430 \u0448\u043b\u044e\u0431\u043d\u0430\u0433\u0430 \u043f\u0430\u043a\u043e\u044f (\u043f\u0430\u0440. \u041f\u0441 19 [18], 6), \u0442\u0430\u043a \u041f\u0430\u043d \u0441\u043f\u0443\u0441\u043a\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u043a\u0430\u0431 \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b \u0456, \u0443\u0446\u0435\u043b\u0430\u0432\u0456\u045e\u0448\u044b\u0441\u044f, \u0437\u043b\u0443\u0447\u044b\u0446\u0446\u0430 \u0437 \u0442\u044b\u043c, \u043a\u0430\u043c\u0443 \u043f\u0440\u044b\u043d\u0451\u0441 \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0456 \u043f\u0430\u0441\u0430\u0433: \u0437\u0430\u0434\u0430\u0442\u0430\u043a, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0437\u043b\u0443\u0447\u044b\u045e\u0441\u044f \u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c; \u043f\u0430\u0441\u0430\u0433, \u043a\u0430\u043b\u0456 \u0401\u043d \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b \u0437\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0417\u0430\u0434\u0430\u0442\u0430\u043a \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0443\u0435 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435, \u0430 \u043f\u0430\u0434 \u043f\u0430\u0441\u0430\u0433\u0430\u043c \u043c\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u043c \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u0422\u0430\u043a, \u0433\u044d\u0442\u044b\u044f \u043f\u0430\u0434\u0437\u0435\u0456 \u0431\u044b\u043b\u0456 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0456\u0445 \u0431\u0430\u0447\u044b\u045e, \u0446\u0443\u0434\u0430\u043c\u0456, \u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0440\u0430\u0437\u0443\u043c\u0435\u045e, &ndash; \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u043c\u0456. \u041a\u0430\u043b\u0456 \u0434\u043e\u0431\u0440\u0430 \u043f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u0435\u0446\u0446\u0430, \u0442\u043e \u045e \u0432\u0430\u0434\u0437\u0435 \u043c\u043e\u0436\u043d\u0430 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0445\u0440\u043e\u0441\u0442\u0443 \u0456 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u041f\u0430\u043a\u0443\u043b\u044c \u0430\u0434\u043d\u043e \u0440\u044d\u0447\u044b\u0432\u0430 \u043f\u0440\u0430\u0437 \u0443\u043d\u0443\u0442\u0440\u0430\u043d\u0430\u0435 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0456\u043d\u0448\u044b\u043c, \u043f\u0430\u043a\u0443\u043b\u044c \u0430\u0434\u043d\u043e \u043d\u0456\u0436\u044d\u0439\u0448\u0430\u0435 \u0440\u044d\u0447\u044b\u0432\u0430 \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u043c, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f. \u0412\u0430\u0434\u0430 \u0440\u0430\u043f\u0442\u043e\u045e\u043d\u0430 \u0437\u043c\u044f\u043d\u044f\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u043f\u043e\u0442\u044b\u043c \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u041a\u0430\u043d\u0435 \u0413\u0430\u043b\u0456\u043b\u0435\u0439\u0441\u043a\u0430\u0439 \u0415\u0437\u0443\u0441 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u045e \u0432\u0430\u0434\u0443 \u045e \u0432\u0456\u043d\u043e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0437\u0430\u043a\u043e\u043d \u0430\u0434\u0441\u0442\u0443\u043f\u0430\u0435 \u0456 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043b\u0430\u0441\u043a\u0430; \u0440\u0430\u0441\u0441\u0435\u0439\u0432\u0430\u0435\u0446\u0446\u0430 \u0437\u043c\u0440\u043e\u043a \u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u045e\u0434\u0430; \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435 \u0437\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0437 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c; \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0441\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 \u043d\u043e\u0432\u0430\u043c\u0443. \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: &laquo;\u0414\u0430\u045e\u043d\u044f\u0435 \u043c\u0456\u043d\u0443\u043b\u0430, \u0432\u043e\u0441\u044c \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043d\u043e\u0432\u0430\u0435&raquo; (2 \u041a\u0430\u0440 5, 17). \u0412\u0430\u0434\u044b, \u043d\u0430\u043b\u0456\u0442\u0430\u0439 \u0443 \u0437\u0431\u0430\u043d\u044b, \u043d\u0435 \u0441\u0442\u0430\u043b\u0430 \u043c\u0435\u043d\u0448, \u044f\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u045e \u0442\u043e\u0435, \u0447\u044b\u043c \u043d\u0435 \u0431\u044b\u043b\u0430. \u0422\u0430\u043a \u0456 \u0437\u0430\u043a\u043e\u043d \u043d\u0435 \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u0441\u0456\u043b\u044b \u0437 \u043f\u0440\u044b\u0439\u0441\u0446\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u043b\u0435 \u0441\u0442\u0430\u045e \u044f\u0448\u0447\u044d \u043b\u0435\u043f\u0448\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043d\u0435\u0441\u0442\u0430\u0432\u0430\u043b\u0430 \u0432\u0456\u043d\u0430, \u043f\u0430\u0434\u0430\u043b\u0456 \u0456\u043d\u0448\u0430\u0435 \u0432\u0456\u043d\u043e. \u0412\u0456\u043d\u043e \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0434\u043e\u0431\u0440\u0430\u0435, \u0430\u043b\u0435 \u043d\u043e\u0432\u0430\u0433\u0430 &ndash; \u044f\u0448\u0447\u044d \u043b\u0435\u043f\u0448\u0430\u0435. \u0421\u0442\u0430\u0440\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u044f\u043a\u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u044e\u0434\u044d\u0456, \u0437\u0432\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0434\u0430 \u043b\u0456\u0442\u0430\u0440\u044b, \u0430 \u043d\u043e\u0432\u044b, \u044f\u043a\u0456 \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u043d\u0430\u0441, \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0430\u0435 \u0432\u043e\u0434\u0430\u0440 \u0436\u044b\u0446\u0446\u044f \u045e \u043b\u0430\u0441\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043e\u0431\u0440\u0430\u0435 \u0432\u0456\u043d\u043e, \u0430\u0431\u043e \u0434\u043e\u0431\u0440\u0430\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0437\u0430\u043a\u043e\u043d\u0443 &ndash; \u0433\u044d\u0442\u0430 \u043a\u0430\u043b\u0456 \u0447\u0443\u0435\u0448: &laquo;\u041b\u044e\u0431\u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u044c \u0432\u043e\u0440\u0430\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e&raquo; (\u041c\u0446 5, 43). \u0410 \u043b\u0435\u043f\u0448\u0430\u0435 \u0456 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u0435 \u0432\u0456\u043d\u043e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f &ndash; \u0433\u044d\u0442\u0430, \u043a\u0430\u043b\u0456 \u0447\u0443\u0435\u0448: &laquo;\u0410 \u042f \u043a\u0430\u0436\u0443 \u0432\u0430\u043c: \u043b\u044e\u0431\u0456\u0446\u0435 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0432\u0430\u0448\u044b\u0445 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u0432\u0430\u0441&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0422\u043e\u0431 13, 11. 13-14; \u041b\u043a 13, 29<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u043e\u0440\u0430\u0434 \u0411\u043e\u0436\u044b, \u0442\u044b \u0437\u0430\u0437\u0437\u044f\u0435\u0448 \u044f\u0440\u043a\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c. \u0406 \u045e\u0441\u0435 \u0442\u0432\u0430\u0435 \u043c\u0435\u0436\u044b \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u0442\u0430\u0431\u0435. \u041d\u0430\u0440\u043e\u0434\u044b \u0437\u0434\u0430\u043b\u0451\u043a \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0440\u044b\u043d\u043e\u0441\u044f\u0447\u044b \u0434\u0430\u0440\u044b, \u044f\u043d\u044b \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u041f\u0430\u043d\u0443. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0437 \u0443\u0441\u0445\u043e\u0434\u0443 \u0456 \u0437 \u0437\u0430\u0445\u0430\u0434\u0443, \u0437 \u043f\u043e\u045e\u043d\u0430\u0447\u044b \u0456 \u0437 \u043f\u043e\u045e\u0434\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u044b\u043d\u043e\u0441\u044f\u0447\u044b \u0434\u0430\u0440\u044b, \u044f\u043d\u044b \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u041f\u0430\u043d\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"473","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0437\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 39 in sancta Lumina, 14-16. 20:&nbsp;<\/span><span style=\"color: #ff0000;\">PG 36, 350-351. 354. 358-359)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0425\u0440\u043e\u0441\u0442 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435\u0446\u0446\u0430, \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u043c\u0441\u044f \u0456 \u043c\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043c\u0430\u0435 \u0445\u0440\u043e\u0441\u0442, \u0456 \u043c\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0441\u043f\u0443\u0441\u0446\u0456\u043c\u0441\u044f \u0434\u0430 \u042f\u0440\u0434\u0430\u043d\u0430, \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u043f\u0430\u0434\u043d\u044f\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c, \u0415\u0437\u0443\u0441 \u043f\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u044f\u0433\u043e. \u041c\u0430\u0433\u0447\u044b\u043c\u0430, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u0446\u044c \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044e \u042f\u043d\u0430, \u0430\u0434 \u044f\u043a\u043e\u0433\u0430 \u043f\u0440\u044b\u043c\u0430\u0435 \u0445\u0440\u043e\u0441\u0442, \u0430\u043b\u0435 \u045e \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443, \u043a\u0430\u0431 \u043f\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0443 \u0432\u043e\u0434\u0430\u0445 \u0443\u0432\u0435\u0441\u044c \u0441\u0442\u0430\u0440\u044b \u0440\u043e\u0434 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430. \u0410\u0434\u043d\u0430\u043a \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c, \u044f\u043a \u0430\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u043d\u0430\u0441, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u042f\u0440\u0434\u0430\u043d, \u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u0434\u043b\u044f \u043d\u0430\u0441. \u0406 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0415\u0437\u0443\u0441 \u0431\u044b\u045e \u0414\u0443\u0445\u0430\u043c \u0456 \u0446\u0435\u043b\u0430\u043c, \u0401\u043d \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0414\u0443\u0445\u0430\u043c \u0456 \u0432\u0430\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044c \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430, \u0415\u0437\u0443\u0441 \u043d\u0430\u0441\u0442\u043e\u0439\u0432\u0430\u0435. &laquo;\u0413\u044d\u0442\u0430 \u043c\u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0430\u0434 \u0426\u044f\u0431\u0435 \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u0445\u0440\u043e\u0441\u0442&raquo; (\u043f\u0430\u0440. \u041c\u0446 3, 14), &ndash; \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0441\u0432\u0435\u0442\u0430\u0447 \u0421\u043e\u043d\u0446\u0443; \u0433\u043e\u043b\u0430\u0441 &ndash; \u0421\u043b\u043e\u0432\u0443; \u0441\u044f\u0431\u0440\u0430 &ndash; \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0443; \u0431\u043e\u043b\u044c\u0448\u044b \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u0445 \u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d &ndash; \u041f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u043c\u0443 \u045e\u0441\u044f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f; \u0442\u043e\u0439, \u044f\u043a\u0456 \u045e\u0437\u0432\u0430\u0440\u0443\u0445\u043d\u0443\u045e\u0441\u044f \u045e \u043c\u0430\u0442\u0447\u044b\u043d\u044b\u043c \u0443\u043b\u043e\u043d\u043d\u0456, &ndash; \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u043f\u0440\u044b\u043c\u0430\u045e \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u0435; \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u0447\u0430\u0446\u044c &ndash; \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430. \u0414\u0430 \u0441\u043b\u043e\u0432\u0430\u045e &laquo;\u0433\u044d\u0442\u0430 \u043c\u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0430\u0434 \u0426\u044f\u0431\u0435 \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u0445\u0440\u043e\u0441\u0442&raquo; \u0442\u0440\u044d\u0431\u0430 \u0434\u0430\u0434\u0430\u0446\u044c &laquo;\u0456 \u045e \u0422\u0432\u0430\u0451 \u0456\u043c\u044f&raquo;. \u0411\u043e \u042f\u043d \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u0446\u0446\u0430 \u045e \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0456 \u042f\u043c\u0443, \u044f\u043a \u0456 \u041f\u044f\u0442\u0440\u0443, \u0430\u0431\u043c\u044b\u044e\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u043e\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0432\u0430\u0434\u044b \u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0441\u0430\u0431\u043e\u044e \u045e\u0437\u0434\u044b\u043c\u0430\u0435 \u0441\u0432\u0435\u0442. \u0401\u043d \u0431\u0430\u0447\u044b\u0446\u044c, \u044f\u043a \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u044e\u0446\u0446\u0430 \u043d\u044f\u0431\u0451\u0441\u044b, \u044f\u043a\u0456\u044f \u0410\u0434\u0430\u043c \u0437\u0430\u043a\u0440\u044b\u045e \u0441\u0430\u0431\u0435 \u0456 \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u043c, \u044f\u043a \u0456 \u0440\u0430\u0439 \u0431\u044b\u045e \u0437\u0430\u043a\u0440\u044b\u0442\u044b \u044f\u043c\u0443 \u0432\u043e\u0433\u043d\u0435\u043d\u044b\u043c \u043c\u044f\u0447\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u0445 \u0434\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0431\u043e\u0441\u0442\u0432\u0443, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0440\u043e\u045e\u043d\u0430\u0433\u0430 \u0441\u0430\u0431\u0435. \u0406 \u0447\u0443\u0435\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441 \u0437 \u043d\u0435\u0431\u0430, \u0431\u043e \u0430\u0434\u0442\u0443\u043b\u044c \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0442\u043e\u0439, \u043a\u0430\u043c\u0443 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435. \u0414\u0443\u0445 \u0431\u0430\u0447\u043d\u0430 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0433\u043e\u043b\u0443\u0431\u0430 \u0456 \u0430\u0434\u0434\u0430\u0435 \u043f\u0430\u0448\u0430\u043d\u0443 \u0446\u0435\u043b\u0443, \u0443 \u044f\u043a\u0456\u043c \u043f\u0440\u0430\u0437 \u0430\u0431\u0430\u0433\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0431\u0430\u0447\u043d\u044b\u043c \u0411\u043e\u0433. \u041f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0448\u043c\u0430\u0442 \u0432\u044f\u043a\u043e\u045e \u0442\u0430\u043c\u0443 \u0433\u043e\u043b\u0443\u0431 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0435 \u043f\u0430\u0442\u043e\u043f\u0443.<br \/>\u041c\u044b \u0441\u0451\u043d\u043d\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0448\u0430\u043d\u0443\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b \u0445\u0440\u043e\u0441\u0442 \u0456 \u0433\u043e\u0434\u043d\u0430 \u0430\u0434\u0437\u043d\u0430\u0447\u044b\u043c \u0441\u0432\u044f\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0447\u044b\u0441\u0442\u044b\u043c\u0456 \u0456 \u0430\u0447\u044b\u0448\u0447\u0430\u0439\u0446\u0435\u0441\u044f. \u0411\u043e \u043d\u0456\u0448\u0442\u043e \u043d\u0435 \u0437\u0430\u0434\u0430\u0432\u0430\u043b\u044c\u043d\u044f\u0435 \u0411\u043e\u0433\u0430 \u0442\u0430\u043a, \u044f\u043a \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0435 \u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0434\u0437\u0435\u043b\u044f \u044f\u043a\u043e\u0433\u0430 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0456 \u045e\u0441\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b. \u0421\u0442\u0430\u043d\u044c\u0446\u0435, \u044f\u043a \u0441\u0432\u0435\u0442\u0430\u0447\u044b \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443, \u043f\u044d\u045e\u043d\u0430\u044e \u0436\u044b\u0446\u0446\u0451\u0432\u0430\u044e \u0441\u0456\u043b\u0430\u044e \u0434\u043b\u044f \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456 \u0441\u0432\u0435\u0442\u0430\u0447\u0430\u043c\u0456 \u043f\u0440\u044b \u0442\u044b\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0441\u0432\u0435\u0442\u0430\u0447\u044b, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0443 \u043d\u0435\u0431\u0435, \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0435\u0441\u044f \u043f\u0440\u043e\u043c\u043d\u044f\u043c\u0456 \u0441\u0432\u044f\u0442\u043b\u0430, \u0447\u044b\u0441\u0446\u0435\u0439 \u0456 \u044f\u0441\u043d\u0435\u0439 \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u044f \u0422\u0440\u043e\u0439\u0446\u0430\u044e. \u0417 \u042f\u0435 \u0432\u044b \u0446\u044f\u043f\u0435\u0440 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456, \u0445\u043e\u0446\u044c \u0456 \u043d\u0435 \u0446\u0430\u043b\u043a\u0430\u043c, \u0430\u0434\u0437\u0456\u043d \u043f\u0440\u043e\u043c\u0435\u043d\u044c, \u0448\u0442\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u0431\u043e\u0441\u0442\u0432\u0430, \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u043d\u0430\u0448\u044b\u043c \u041f\u0430\u043d\u0443, \u044f\u043a\u043e\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 114 (113), 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0451\u043d\u043d\u044f \u0430\u0434\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u043d\u044f\u0431\u0451\u0441\u044b, \u0456 \u043c\u043e\u0440\u0430 \u0441\u0442\u0430\u043b\u0430 \u0441\u0430\u043b\u043e\u0434\u043a\u0456\u043c, \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0437\u044f\u043c\u043b\u044f, \u0432\u0435\u0441\u044f\u043b\u044f\u0446\u0446\u0430 \u0433\u043e\u0440\u044b \u0456 \u043f\u0430\u0433\u043e\u0440\u043a\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043d\u044f\u045e \u0443 \u042f\u0440\u0434\u0430\u043d\u0435 \u0445\u0440\u043e\u0441\u0442 \u0430\u0434 \u042f\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0428\u0442\u043e \u0437 \u0442\u0430\u0431\u043e\u044e, \u043c\u043e\u0440\u0430, \u0448\u0442\u043e \u0442\u044b \u045e\u0446\u044f\u043a\u0430\u0435\u0448, \u0456 \u0437 \u0442\u0430\u0431\u043e\u044e, \u042f\u0440\u0434\u0430\u043d\u0435, \u0448\u0442\u043e \u0442\u044b \u043f\u0430\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u043d\u0430\u0437\u0430\u0434?<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043d\u044f\u045e \u0443 \u042f\u0440\u0434\u0430\u043d\u0435 \u0445\u0440\u043e\u0441\u0442 \u0430\u0434 \u042f\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"504","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041b\u0456\u0441\u0442 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&raquo; \u0441\u0432. \u041a\u043b\u0456\u043c\u044d\u043d\u0442\u0430 \u0406, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 7, 4 &ndash; 8, 3; 8, 5 &ndash; 9, 1; 13, 1-4; 19, 2: Funk 1, 71-73. 77-79. 87)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0430\u0439\u0446\u0435\u0441\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u043f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u0456\u043c\u0441\u044f \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 \u0456 \u043f\u0430\u0441\u0442\u0430\u0440\u0430\u0435\u043c\u0441\u044f \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u0430 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u0434\u043b\u044f \u0411\u043e\u0433\u0430, \u042f\u0433\u043e \u0410\u0439\u0446\u0430; \u043f\u0440\u0430\u043b\u0456\u0442\u0430\u044f \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u044f\u043d\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u045e\u0441\u044f\u043c\u0443 \u0441\u0432\u0435\u0442\u0443 \u043b\u0430\u0441\u043a\u0443 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0439\u0434\u0437\u0435\u043c\u0441\u044f \u043f\u0430 \u045e\u0441\u0456\u0445 \u044d\u0442\u0430\u043f\u0430\u0445 \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0456 \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0439\u043c\u0430, \u0448\u0442\u043e \u045e \u043a\u043e\u0436\u043d\u044b\u043c \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456 \u041f\u0430\u043d \u0434\u0430\u0432\u0430\u045e \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0440\u0430\u0441\u043a\u0430\u044f\u0446\u0446\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0445\u0430\u0446\u0435\u045e \u0434\u0430 \u042f\u0433\u043e \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430. \u0412\u0435\u0441\u0442\u0443\u043d\u043e\u043c \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f \u0431\u044b\u045e \u041d\u043e\u0439, \u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u044f\u0433\u043e \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u045e, \u0431\u044b\u043b\u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u044b\u044f. \u0401\u043d\u0430 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e \u0436\u044b\u0445\u0430\u0440\u0430\u043c \u041d\u0456\u043d\u0456\u0432\u044b \u0437\u0433\u0443\u0431\u0443, \u0430\u0434\u043d\u0430\u043a \u044f\u043d\u044b, \u043a\u0430\u044e\u0447\u044b\u0441\u044f \u045e \u0433\u0440\u0430\u0445\u0430\u0445, \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u0456\u043b\u0456 \u0411\u043e\u0433\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c\u0456 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0445\u043e\u0446\u044c \u0431\u044b\u043b\u0456 \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0456 \u0441\u043b\u0443\u0433\u0456 \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u044f \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c. \u041d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0441\u0443\u0441\u0432\u0435\u0442\u0443, \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u044e\u0447\u044b, \u0441\u043a\u0430\u0437\u0430\u045e \u0430\u0431 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0456: &laquo;\u042f \u0436\u044b\u0432\u044b, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. &ndash; \u042f \u0445\u0430\u0447\u0443 \u043d\u0435 \u0441\u043c\u0435\u0440\u0446\u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430, \u0430\u043b\u0435 \u044f\u0433\u043e \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f&raquo;. \u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e \u0401\u043d \u0434\u0430\u0434\u0430\u045e \u0437\u043d\u0430\u043c\u044f\u043d\u0430\u043b\u044c\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b: &laquo;\u0410\u043f\u0430\u043c\u044f\u0442\u0430\u0439\u0441\u044f, \u0434\u043e\u043c\u0435 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0430\u0434 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e. \u0421\u043a\u0430\u0436\u044b \u0441\u044b\u043d\u0430\u043c \u043d\u0430\u0440\u043e\u0434\u0443 \u041c\u0430\u0439\u0433\u043e: \u041a\u0430\u043b\u0456 \u0433\u0440\u0430\u0445\u0456 \u0432\u0430\u0448\u044b\u044f \u0434\u043e\u0439\u0434\u0443\u0446\u044c \u0430\u0434 \u0437\u044f\u043c\u043b\u0456 \u0430\u0436 \u0434\u0430 \u043d\u0435\u0431\u0430, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0447\u044b\u0440\u0432\u0430\u043d\u0435\u0439\u0448\u044b\u043c\u0456 \u0437\u0430 \u043f\u0443\u0440\u043f\u0443\u0440 \u0456 \u0447\u0430\u0440\u043d\u0435\u0439\u0448\u044b\u043c\u0456 \u0437\u0430 \u043c\u0435\u0448\u043a\u0430\u0432\u0456\u043d\u0443, \u0456 \u043a\u0430\u043b\u0456 \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043d\u0430\u0432\u0435\u0440\u043d\u0435\u0446\u0435\u0441\u044f \u0434\u0430 \u041c\u044f\u043d\u0435 \u0456 \u0441\u043a\u0430\u0436\u0430\u0446\u0435: &ldquo;\u041e\u0439\u0447\u0430&rdquo;, &ndash; \u0442\u0430\u0434\u044b \u042f \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u044e\u0441\u044f \u0434\u0430 \u0432\u0430\u0441 \u044f\u043a \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0441\u0432\u044f\u0442\u043e\u0433\u0430&raquo; (\u043f\u0430\u0440. \u042d\u0437\u0445 33, 11; \u041e\u0441 14, 2; \u0406\u0441 1, 18 \u0456 \u0456\u043d\u0448.).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0436\u0430\u0434\u0430\u044e\u0447\u044b, \u043a\u0430\u0431 \u042f\u0433\u043e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0441\u0442\u0430\u043b\u0456 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f, \u0401\u043d \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u045e \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0441\u0432\u0430\u0451\u0439 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0439 \u0432\u043e\u043b\u044f\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u0446\u0446\u0430 \u042f\u0433\u043e \u0432\u0435\u043b\u0456\u0447\u043d\u0430\u0439 \u0456 \u0441\u043b\u0430\u045e\u043d\u0430\u0439 \u0432\u043e\u043b\u0456 \u0456, \u043f\u0430\u043a\u043e\u0440\u043d\u0430 \u043f\u0440\u043e\u0441\u044f\u0447\u044b \u045e \u042f\u0433\u043e \u043b\u0456\u0442\u0430\u0441\u0446\u0456 \u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u043f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u043c\u0430\u0440\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u0441\u0432\u0430\u0440\u043a\u0456 \u0456 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u044c, \u044f\u043a\u0456\u044f \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u044f \u0434\u0443\u0445\u0430\u043c, \u0430\u0434\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u045e\u0441\u044f\u043a\u0443\u044e \u043f\u044b\u0445\u0443 \u0456 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u0430\u0441\u0446\u044c, \u0431\u0435\u0437\u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u044c \u0456 \u0433\u043d\u0435\u045e. \u0411\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430, \u0431\u043e \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b: &laquo;\u041d\u044f\u0445\u0430\u0439 \u043c\u0443\u0434\u0440\u044d\u0446 \u043d\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0441\u0432\u0430\u0451\u0439, \u0434\u044b \u0430\u0441\u0456\u043b\u0430\u043a &ndash; \u0441\u0456\u043b\u0430\u044e \u0441\u0432\u0430\u0451\u0439, \u0431\u0430\u0433\u0430\u0442\u044b &ndash; \u0441\u0432\u0430\u0456\u043c \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c; \u0430\u043b\u0435 \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u041f\u0430\u043d\u0430\u043c, \u0448\u0443\u043a\u0430\u044e\u0447\u044b \u042f\u0433\u043e \u0456 \u043f\u0440\u0430\u045e\u0434\u0443 \u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0447\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430&raquo; (\u043f\u0430\u0440. \u0415\u0440 9, 23-24; 1 \u041a\u0430\u0440 1, 31 \u0456 \u0456\u043d\u0448.). \u0410\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u0456\u044f \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e, \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0447\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u043a: &laquo;\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456, \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0441\u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435; \u043f\u0440\u0430\u0431\u0430\u0447\u0430\u0439\u0446\u0435, \u043a\u0430\u0431 \u0456 \u0432\u0430\u043c \u043f\u0440\u0430\u0431\u0430\u0447\u044b\u043b\u0456; \u044f\u043a \u0432\u044b \u0440\u043e\u0431\u0456\u0446\u0435, \u0442\u0430\u043a \u0456 \u0432\u0430\u043c \u0437\u0440\u043e\u0431\u044f\u0446\u044c; \u044f\u043a \u0432\u044b \u0434\u0430\u044f\u0446\u0435, \u0442\u0430\u043a \u0456 \u0432\u0430\u043c \u0434\u0430\u0434\u0443\u0446\u044c; \u044f\u043a \u0432\u044b \u0441\u0443\u0434\u0437\u0456\u0446\u0435, \u0442\u0430\u043a \u0456 \u0432\u0430\u0441 \u0430\u0441\u0443\u0434\u0437\u044f\u0446\u044c; \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u043b\u0430\u0441\u043a\u0430\u0432\u044b\u044f, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0456 \u0432\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c; \u044f\u043a\u043e\u0439 \u043c\u0435\u0440\u0430\u044e \u043c\u0435\u0440\u0430\u0435\u0446\u0435, \u0442\u0430\u043a\u043e\u044e \u0456 \u0432\u0430\u043c \u0430\u0434\u043c\u0435\u0440\u0430\u0446\u044c&raquo; (\u043f\u0430\u0440. \u041c\u0446 5, 7; 6, 14; 7, 1. 2. 12 \u0456 \u0456\u043d\u0448.).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u043a\u0430\u0437\u0443 \u0456 \u0433\u044d\u0442\u044b\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e, \u043a\u0430\u0431 \u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u0456 \u043f\u043e\u045e\u043d\u044b\u044f \u043f\u0430\u043a\u043e\u0440\u044b \u043c\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0456\u0448\u043b\u0456 \u0437\u0430 \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456. \u0411\u043e \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u044f\u0442\u043e\u0435 \u0441\u043b\u043e\u0432\u0430: &laquo;\u041d\u0430 \u043a\u0430\u0433\u043e \u042f \u043f\u0430\u0433\u043b\u044f\u0434\u0436\u0443, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043d\u0430 \u043f\u0430\u043a\u043e\u0440\u043d\u0430\u0433\u0430 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430\u0433\u0430, \u043d\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0442\u0440\u044b\u043c\u0446\u0456\u0446\u044c \u0430\u0434 \u043c\u0430\u0456\u0445 \u0441\u043b\u043e\u045e?&raquo; (\u043f\u0430\u0440. \u0406\u0441 66, 2).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u0441\u0442\u0430\u045e\u0448\u044b \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u043c\u043d\u043e\u0433\u0456\u0445 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u0445 \u043f\u0430\u0434\u0437\u0435\u0439, \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e \u0441\u043f\u0430\u043a\u043e\u044e, \u044f\u043a\u0456 \u0431\u044b\u045e \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430\u043c \u0437 \u0441\u0430\u043c\u0430\u0433\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0456 \u045e\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u045e\u0433\u043b\u0435\u0434\u0437\u0456\u043c\u0441\u044f \u045e \u0410\u0439\u0446\u0430 \u0456 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u043e\u0446\u043d\u0430 \u043f\u0440\u044b\u043f\u0430\u0434\u0437\u0435\u043c \u0434\u0430 \u042f\u0433\u043e \u0432\u0435\u043b\u0456\u0447\u043d\u044b\u0445 \u0456 \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u044b\u0445 \u0434\u0430\u0440\u043e\u045e \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 55, 7; \u0401\u044d\u043b 2, 13; \u043f\u0430\u0440. \u042d\u0437\u0445 33, 11<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b \u043f\u0430\u043a\u0456\u043d\u0435 \u0441\u0432\u043e\u0439 \u0448\u043b\u044f\u0445, \u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a &ndash; \u0441\u0432\u0430\u0435 \u0437\u0430\u0434\u0443\u043c\u044b. \u041d\u044f\u0445\u0430\u0439 \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u041f\u0430\u043d\u0430, \u0456 \u0401\u043d \u0437\u043b\u0456\u0442\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u0456\u043c, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u043d\u0430\u0448 \u041f\u0430\u043d \u0411\u043e\u0433 \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b, \u0401\u043d \u043d\u0435 \u0433\u043d\u044f\u045e\u043b\u0456\u0432\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u043d\u0435 \u0445\u043e\u0447\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0451\u043d \u043d\u0430\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0456 \u0436\u044b\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u043d\u0430\u0448 \u041f\u0430\u043d \u0411\u043e\u0433 \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b, \u0401\u043d \u043d\u0435 \u0433\u043d\u044f\u045e\u043b\u0456\u0432\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"505","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 6 de Quadragesima, 1-2: PL 54, 285-287)<\/span><br \/><span style=\"color: #ff0000;\">\u0420\u044d\u043b\u0456\u0433\u0456\u0439\u043d\u0430\u0435 \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u0435 \u043f\u0440\u0430\u0437 \u043f\u043e\u0441\u0442 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0437\u044f\u043c\u043b\u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u043e\u045e\u043d\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u041f\u0430\u043d\u0430 (\u043f\u0430\u0440. \u041f\u0441 34 [33], 5), \u0456 \u0441\u0430\u043c\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0440\u044d\u0447\u0430\u045e \u0432\u0443\u0447\u044b\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0432\u0435\u0440\u043d\u0456\u043a\u0430, \u044f\u043a \u0443\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u044f\u043c\u043b\u044f \u0456 \u043d\u0435\u0431\u0430, \u043c\u043e\u0440\u0430 \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u045e \u0456\u0445, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u0434\u0430\u0431\u0440\u044b\u043d\u044e \u0456 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f, \u0430 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0441\u043b\u0443\u0436\u0431\u043e\u0432\u044b\u0445 \u0441\u0442\u044b\u0445\u0456\u0439 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0437\u0430\u0441\u043b\u0443\u0436\u0430\u043d\u0430\u0439 \u043f\u0430\u0434\u0437\u044f\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0437\u0432\u044f\u0440\u043d\u0443\u0446\u044c \u0443\u0432\u0430\u0433\u0443 \u043d\u0430 \u0442\u044b\u044f \u0434\u043d\u0456, \u0448\u0442\u043e \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0430\u0434\u0437\u043d\u0430\u0447\u044b\u043b\u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u043d\u0435\u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0430 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u0447\u0430\u044e\u0446\u044c \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u043c\u0443 \u0441\u0432\u044f\u0442\u0443, \u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u043c\u0456 \u0431\u043e\u043b\u044c\u0448 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u044d\u043d\u0441 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u043e\u045e\u043a\u0456 \u0434\u0430 \u0440\u044d\u043b\u0456\u0433\u0456\u0439\u043d\u0430\u0433\u0430 \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043b\u0430\u0441\u0446\u0456\u0432\u0430\u0441\u0446\u044e \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u0432\u044f\u0442\u0430\u045e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435\u043c \u0433\u0440\u0430\u0445\u043e\u045e, \u044f\u043a\u043e\u0435 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430\u043d\u043e\u0432\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442, \u0430\u043b\u0435 \u0456 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u045e\u0436\u043e \u0434\u0430\u045e\u043d\u043e \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u043b\u0456\u043a \u0443\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u0433\u044d\u0442\u0430\u044f \u043a\u0443\u043f\u0435\u043b\u044c \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0440\u043e\u0431\u0456\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u043e\u0432\u044b\u043c\u0456, \u0430\u0434\u043d\u0430\u043a \u0443\u0441\u0456\u043c \u043d\u0430\u043c \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0442\u0440\u044d\u0431\u0430 \u0430\u0447\u044b\u0448\u0447\u0430\u0446\u0446\u0430 \u0430\u0434 \u0456\u0440\u0436\u044b \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456. \u0414\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0435\u043d\u043d\u0435 \u043d\u0435 \u043c\u0430\u0435 \u043c\u0435\u0436\u0430\u045e, \u0442\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430, \u043a\u0430\u0431 \u0443 \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0431\u044b\u045e \u0443 \u0441\u0442\u0430\u0440\u044b\u0445 \u0433\u0440\u0430\u0445\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0445\u043e\u0446\u044c \u043c\u044b \u045e\u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0436\u044b\u0446\u044c \u043f\u0430-\u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0443, \u0446\u044f\u043f\u0435\u0440 \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u0431\u043e\u043b\u044c\u0448 \u0440\u0443\u043f\u043b\u0456\u0432\u0430 \u0456 \u0430\u0434\u0434\u0430\u043d\u0430, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456 \u0437\u0432\u044b\u0447\u0430\u0439 \u0441\u0430\u0440\u0430\u043a\u0430\u0434\u0437\u0451\u043d\u043d\u0430\u0433\u0430 \u043f\u043e\u0441\u0442\u0443 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0430\u0431\u043c\u0435\u0436\u0430\u0432\u0430\u043d\u043d\u0435 \u045e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043d\u043d\u0456 \u0435\u0436\u044b, \u0430\u043b\u0435 \u045e \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443 \u043f\u0440\u0430\u0437 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0443 \u0437 \u0437\u0430\u0433\u0430\u043d\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u043b\u044c\u043c\u0456 \u043a\u0430\u0440\u044b\u0441\u043d\u0430, \u043a\u0430\u043b\u0456 \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0456 \u043d\u0430\u043b\u0435\u0436\u043d\u044b\u043c\u0456 \u043f\u0430\u0441\u0442\u0430\u043c\u0456 \u0441\u043f\u0430\u043b\u0443\u0447\u0430\u044e\u0446\u0446\u0430 \u045e\u0447\u044b\u043d\u043a\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u044f\u043a\u0456\u044f \u0432\u044b\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u045e \u0440\u043e\u0437\u043d\u044b\u0445 \u043f\u0430\u0445\u0432\u0430\u043b\u044c\u043d\u044b\u0445 \u0434\u0437\u0435\u044f\u043d\u043d\u044f\u0445, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0432\u0435\u0440\u043d\u0456\u043a\u0456 \u043c\u0430\u0433\u043b\u0456 \u0430\u0434\u0447\u0443\u0446\u044c \u0441\u044f\u0431\u0435 \u0440\u043e\u045e\u043d\u044b\u043c\u0456, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0440\u043e\u0437\u043d\u044b\u044f \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0431\u043e\u045e, \u044f\u043a\u0443\u044e \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0446\u044c \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u0446\u0430 \u043d\u0456\u044f\u043a\u0456\u043c\u0456 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u043c\u0456, \u043a\u0430\u0431 \u043d\u0435 \u0437\u043d\u0456\u043a\u0430\u043b\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u043c\u0443. \u041a\u0430\u043b\u0456 \u0430\u043d\u0451\u043b\u044b \u043a\u0430\u0436\u0443\u0446\u044c: &laquo;\u0425\u0432\u0430\u043b\u0430 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445 \u0411\u043e\u0433\u0443, \u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456&raquo; (\u041b\u043a 2, 14), &ndash; \u0433\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0437 \u043b\u044e\u0431\u043e\u045e\u044e \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u0435 \u043b\u044e\u0434\u0437\u044f\u043c, \u044f\u043a\u0456\u044f \u043c\u0430\u044e\u0446\u044c \u0440\u043e\u0437\u043d\u044b\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0446\u043d\u043e\u0446\u0435 \u0441\u043f\u0430\u0433\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0434\u0430\u0440\u0443 \u0441\u043f\u0430\u043a\u043e\u044e, \u044f\u043a\u0456 \u045e\u0434\u0437\u044f\u043b\u044f\u0435\u0446\u0446\u0430 \u044f\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0440\u0430\u0432\u044b \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u044f, \u0448\u0442\u043e \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u044e\u0446\u044c \u0443\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0443\u0447\u044b\u043d\u043a\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u0430\u0433\u0430\u0442\u044b\u044f \u0456 \u0437\u0430\u043c\u043e\u0436\u043d\u044b\u044f, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u044f\u0440\u044d\u0434\u043d\u044f\u0433\u0430 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u0443 \u0456 \u0431\u0435\u0434\u043d\u044b\u044f \u043c\u0430\u044e\u0446\u044c \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0446\u044c \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u043c. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u044f\u043d\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u045e \u0441\u0432\u0430\u0456\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0432\u044b\u0441\u0456\u043b\u043a\u0443, \u0445\u043e\u0446\u044c \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0431\u044b\u0446\u044c \u0440\u043e\u045e\u043d\u044b\u043c\u0456 \u045e \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 2 \u041a\u0430\u0440 6, 4<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0435\u0440\u044b\u044f\u0434 \u043f\u043e\u0441\u0442\u0443 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u043c \u0431\u0440\u0430\u043c\u044b \u0440\u0430\u044e; \u0440\u0430\u0441\u043f\u0430\u0447\u043d\u0435\u043c \u044f\u0433\u043e \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439 \u0456 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u0439, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0443 \u0434\u0437\u0435\u043d\u044c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u043c\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0445\u0432\u0430\u043b\u0443 \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0430 \u045e\u0441\u0456\u043c \u043c\u044b \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435\u043c \u0441\u044f\u0431\u0435 \u044f\u043a \u0441\u043b\u0443\u0433\u0430\u045e \u0411\u043e\u0436\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0443 \u0434\u0437\u0435\u043d\u044c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u043c\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0445\u0432\u0430\u043b\u0443 \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"506","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Supp., Hom. 6 De precatione: PG 64, 462-466)<\/span><br \/><span style=\"color: #ff0000;\">\u041c\u0430\u043b\u0456\u0442\u0432\u0430 &ndash; \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u0443\u0448\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u0456 \u0440\u0430\u0437\u043c\u043e\u0432\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c &ndash; \u0433\u044d\u0442\u0430 \u043d\u0430\u0439\u0432\u044f\u043b\u0456\u043a\u0448\u0430\u0435 \u0434\u0430\u0431\u0440\u043e, \u0431\u043e \u0433\u044d\u0442\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0437 \u0411\u043e\u0433\u0430\u043c. \u042f\u043a \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u044f \u0432\u043e\u0447\u044b, \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0441\u0432\u044f\u0442\u043b\u043e, \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u044e\u0446\u0446\u0430, \u0442\u0430\u043a \u0456 \u0434\u0443\u0445, \u0437\u0430\u0433\u043b\u044b\u0431\u043b\u0435\u043d\u044b \u045e \u0411\u043e\u0433\u0443, \u0437\u0432\u0435\u0434\u0432\u0430\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u0435\u043d\u043d\u0435 \u042f\u0433\u043e\u043d\u044b\u043c \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c. \u0422\u0443\u0442 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u043f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u044f\u043a\u0430\u044f \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u0432\u044b\u0447\u043a\u0430\u0439, \u0430\u043b\u0435 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0434\u0443\u0448\u044b; \u043f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u044f\u043a\u0430\u044f \u043d\u0435 \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0430\u043a\u0440\u044d\u0441\u043b\u0435\u043d\u044b\u044f \u0433\u0430\u0434\u0437\u0456\u043d\u044b, \u0430\u043b\u0435 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435\u0446\u0446\u0430 \u045e\u0434\u0437\u0435\u043d\u044c \u0456 \u045e\u043d\u0430\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448 \u0434\u0443\u0445 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0437\u0432\u0435\u0440\u043d\u0443\u0442\u044b \u0434\u0430 \u0411\u043e\u0433\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u043c\u0430\u043b\u0456\u0442\u043e\u045e\u043d\u0430\u0433\u0430 \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0436\u0430\u043d\u043d\u044f, \u0430\u043b\u0435 \u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043c\u044b \u0437\u0430\u043d\u044f\u0442\u044b\u044f \u044f\u043a\u0456\u043c\u0456-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u043c\u0456, \u0430\u043f\u0435\u043a\u0430\u0439 \u043d\u0430\u0434 \u0431\u0435\u0434\u043d\u044b\u043c\u0456, \u0456\u043d\u0448\u044b\u043c\u0456 \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u043c\u0456 \u0446\u0456 \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c\u0456 \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u043d\u044b\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456. \u0422\u0430\u0434\u044b \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u043c\u043a\u0456 \u0456 \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0441\u043f\u0430\u043b\u0443\u0447\u0430\u0446\u0446\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c, \u043a\u0430\u0431 \u0442\u043e\u0435, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u043c, \u0431\u044b\u043b\u043e \u043f\u0440\u044b\u043f\u0440\u0430\u045e\u043b\u0435\u043d\u0430 \u0441\u043e\u043b\u043b\u044e \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u043c\u0430\u0433\u043b\u043e \u0431 \u0441\u0442\u0430\u0446\u044c \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u043c \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0430\u043c \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u0441\u0443\u0441\u0432\u0435\u0442\u0443. \u041a\u0430\u043b\u0456 \u043c\u044b \u045e\u0434\u0437\u0435\u043b\u0456\u043c \u0442\u0430\u043a\u043e\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0448\u043c\u0430\u0442 \u0447\u0430\u0441\u0443, \u0442\u043e \u045e\u0441\u0451 \u0436\u044b\u0446\u0446\u0451 \u0431\u0443\u0434\u0437\u0435\u043c \u0447\u044d\u0440\u043f\u0430\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0430\u044f \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u043b\u0456\u0442\u0432\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u0443\u0448\u044b, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430. \u042f\u043d\u0430 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0430 \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456. \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0434\u0443\u0445, \u0443\u0437\u043d\u0435\u0441\u0435\u043d\u044b \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439, \u0434\u0430\u0441\u044f\u0433\u0430\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0432\u044b\u0448\u044b\u043d\u0456 \u0456 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u0411\u043e\u0433\u0430 \u045e \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b\u0445 \u0430\u0431\u0434\u044b\u043c\u043a\u0430\u0445, \u043f\u0440\u0430\u0433\u043d\u0443\u0447\u044b \u0431\u043e\u0441\u043a\u0430\u0433\u0430 \u043c\u0430\u043b\u0430\u043a\u0430, \u044f\u043a \u0434\u0437\u0456\u0446\u044f, \u0448\u0442\u043e \u043a\u043b\u0456\u0447\u0430 \u043f\u043b\u0430\u0447\u0430\u043c \u0441\u0432\u0430\u044e \u043c\u0430\u0446\u0456; \u0451\u043d \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u0435 \u0441\u0432\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0434\u0430\u0440\u044b \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0430 \u043b\u0435\u043f\u0448\u044b\u044f \u0437\u0430 \u045e\u0441\u044f\u043a\u0443\u044e \u0431\u0430\u0447\u043d\u0443\u044e \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u043b\u0456\u0442\u0432\u0430, \u044f\u043a \u0433\u043e\u0434\u043d\u0430\u044f \u043f\u0430\u0448\u0430\u043d\u044b \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u0440\u0430\u0434\u0443\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0434\u0443\u0445 \u0456 \u0437\u0430\u0441\u043f\u0430\u043a\u043e\u0439\u0432\u0430\u0435 \u044f\u0433\u043e \u045e\u0437\u0440\u0443\u0448\u044d\u043d\u043d\u0456. \u0410\u0434\u043d\u0430\u043a \u043d\u0435 \u0434\u0443\u043c\u0430\u0439, \u0448\u0442\u043e \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u043a\u0430\u0436\u0443, \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u043b\u043e\u0432\u0430\u0445. \u041c\u0430\u043b\u0456\u0442\u0432\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430\u0435 \u0434\u0430 \u0411\u043e\u0433\u0430; \u0433\u044d\u0442\u0430 \u043d\u0435\u0432\u044b\u043c\u043e\u045e\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e, \u0448\u0442\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0435 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u043d\u0430 \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0439, \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u041c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u0430\u0431 \u0447\u044b\u043c \u0442\u0440\u044d\u0431\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u0430\u043b\u0435 \u0441\u0430\u043c \u0414\u0443\u0445 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441 \u0441\u0442\u0430\u0433\u043d\u0430\u043d\u043d\u044f\u043c\u0456 \u043d\u0435\u0432\u044b\u043c\u043e\u045e\u043d\u044b\u043c\u0456&raquo; (\u043f\u0430\u0440. \u0420\u044b\u043c 8, 26b).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u043d\u0435\u043a\u0430\u0433\u0430 \u0442\u0430\u043a\u043e\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439, \u0442\u043e\u0439 \u043c\u0430\u0435 \u043d\u0435\u0430\u0434&rsquo;\u0435\u043c\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a, \u044f\u043a\u0456 \u043d\u0430\u0441\u044b\u0447\u0430\u0435 \u0434\u0443\u0448\u0443. \u0425\u0442\u043e \u044f\u0433\u043e \u043f\u0430\u043a\u0430\u0448\u0442\u0443\u0435, \u0442\u0430\u0433\u043e \u041f\u0430\u043d \u0437\u0430\u043f\u0430\u043b\u0456\u0446\u044c \u0432\u0435\u0447\u043d\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c, \u044f\u043a \u0441\u0430\u043c\u044b\u043c \u0433\u0430\u0440\u0430\u0447\u044b\u043c \u0430\u0433\u043d\u0451\u043c, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043b\u0456\u0446\u044c \u044f\u0433\u043e \u0434\u0443\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0447\u044b \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0441\u0430 \u0448\u0447\u044b\u0440\u0430\u0441\u0446\u044e, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0439 \u0441\u0432\u043e\u0439 \u0434\u043e\u043c \u0443\u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u044e \u0456 \u043f\u0430\u043a\u043e\u0440\u0430\u0439, \u0440\u0430\u0431\u0456, \u043a\u0430\u0431 \u0451\u043d \u0437\u0430\u0437\u0437\u044f\u045e \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u042f\u043a \u0437\u043e\u043b\u0430\u0442\u0430\u043c, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0439 \u044f\u0433\u043e \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456, \u0430 \u0437\u0430\u043c\u0435\u0441\u0442 \u043c\u0443\u0440\u043e\u045e \u0456 \u043a\u0430\u043c\u044f\u043d\u0451\u045e \u0430\u0437\u0434\u0430\u0431\u043b\u044f\u0439 \u0432\u0435\u0440\u0430\u0439 \u0456 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u044e. \u0410\u043a\u0440\u0430\u043c\u044f \u045e\u0441\u044f\u0433\u043e \u0433\u044d\u0442\u0430\u0433\u0430, \u043d\u044f\u0445\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u044f\u043a \u0432\u044f\u043d\u0435\u0446 \u0431\u0443\u0434\u043e\u045e\u043b\u0456 \u0434\u043e\u043c\u0443, \u044f\u043a\u0456 \u0442\u044b \u0440\u044b\u0445\u0442\u0443\u0435\u0448 \u0434\u043b\u044f \u041f\u0430\u043d\u0430. \u0423 \u0433\u044d\u0442\u044b\u043c \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u043c \u0434\u043e\u043c\u0435 \u0442\u044b \u043f\u0440\u044b\u043c\u0435\u0448 \u041f\u0430\u043d\u0430, \u0432\u043e\u0431\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0442\u044b \u045e\u0436\u043e \u043c\u0430\u0435\u0448 \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u0433\u043e \u043b\u0430\u0441\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u043b 5, 20. 21a; \u041c\u0446 8, 25b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0427\u0430\u043c\u0443 \u0422\u044b \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0431\u044b\u045e\u0441\u044f \u043f\u0440\u0430 \u043d\u0430\u0441, \u0447\u0430\u043c\u0443 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0430\u0441 \u043d\u0430 \u0434\u043e\u045e\u0433\u0456\u044f \u0434\u043d\u0456? <span style=\"color: #ff0000;\">*<\/span> \u0412\u044f\u0440\u043d\u0456 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u0456 \u043c\u044b \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u0426\u044f\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d\u0435, \u0440\u0430\u0442\u0443\u0439, \u0431\u043e \u043c\u044b \u0433\u0456\u043d\u0435\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044f\u0440\u043d\u0456 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u0456 \u043c\u044b \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u0426\u044f\u0431\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"507","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u044f\u045e&raquo; \u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 4, 13, 4 &ndash; 14, 1: SC 100, 534-540)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448 \u041f\u0430\u043d, \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435, \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u045e \u043b\u044e\u0434\u0437\u0435\u0439 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0410\u0439\u0446\u0443, \u0430 \u043f\u0430\u0441\u043b\u044f \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u044b\u045e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b \u042f\u043c\u0443, \u044f\u043a \u0441\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u043c: &laquo;\u042f \u045e\u0436\u043e \u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u044e \u0432\u0430\u0441 \u0441\u043b\u0443\u0433\u0430\u043c\u0456, \u0431\u043e \u0441\u043b\u0443\u0433\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u044c \u044f\u0433\u043e\u043d\u044b \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440. \u042f \u0436 \u043d\u0430\u0437\u0432\u0430\u045e \u0432\u0430\u0441 \u0441\u044f\u0431\u0440\u0430\u043c\u0456, \u0431\u043e \u045e\u0441\u0451, \u0448\u0442\u043e \u0447\u0443\u045e \u0430\u0434 \u0410\u0439\u0446\u0430 \u041c\u0430\u0439\u0433\u043e, \u042f \u0441\u043a\u0430\u0437\u0430\u045e \u0432\u0430\u043c&raquo; (\u042f\u043d 15, 15). \u0421\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044e \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u0433\u043e \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0410\u0434\u0430\u043c\u0430 \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e \u043a\u0430\u043c\u0443 \u045e\u0434\u0437\u044f\u043b\u0456\u0446\u044c \u0441\u0432\u0430\u0435 \u0434\u0430\u0440\u044b. \u0411\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430 \u0410\u0434\u0430\u043c\u0430, \u0430\u043b\u0435 \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0421\u043b\u043e\u0432\u0430 \u045e\u0436\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0439\u0446\u0430, \u0437\u0430\u0441\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u045e \u0406\u043c, \u0456 \u0441\u0430\u043c\u043e \u0437\u0432\u0435\u0434\u0432\u0430\u043b\u0430 \u0445\u0432\u0430\u043b\u0443 \u0430\u0434 \u0410\u0439\u0446\u0430, \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u043c: &laquo;\u041e\u0439\u0447\u0430, \u0443\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435 \u045e \u0441\u0430\u0431\u0435 \u0445\u0432\u0430\u043b\u043e\u044e, \u044f\u043a\u0443\u044e \u043c\u0435\u045e \u042f \u045e \u0426\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0441\u0432\u0435\u0442\u0443&raquo; (\u042f\u043d 17, 5).<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u043c\u0443\u0448\u0430\u044e\u0447\u044b \u043d\u0430\u0441 \u0456\u0441\u0446\u0456 \u0437\u0430 \u0406\u043c, \u0411\u043e\u0433 \u043d\u0435 \u043c\u0430\u0435 \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u045e \u043d\u0430\u0448\u0430\u0439 \u043f\u0430\u0441\u043b\u0443\u0437\u0435. \u0401\u043d \u0442\u043e\u043b\u044c\u043a\u0456 \u0445\u043e\u0447\u0430 \u043d\u0430\u0441 \u0437\u0431\u0430\u0432\u0456\u0446\u044c. \u0411\u043e \u0456\u0441\u0446\u0456 \u0437\u0430 \u0417\u0431\u0430\u045e\u0446\u0430\u043c &ndash; \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456, \u0430 \u0456\u0441\u0446\u0456 \u0437\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c &ndash; \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0441\u0432\u044f\u0442\u043b\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f, \u0445\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0441\u0432\u044f\u0442\u043b\u0435, \u043d\u0435 \u0441\u0430\u043c\u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u044e\u0446\u044c, \u0430\u043b\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u044e\u0446\u0446\u0430 \u0456 \u0430\u043f\u0440\u0430\u043c\u0435\u043d\u044c\u0432\u0430\u044e\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c. \u042f\u043d\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0434\u0430\u0434\u0430\u044e\u0446\u044c \u0434\u0430 \u044f\u0433\u043e, \u0430\u043b\u0435, \u043f\u0440\u0430\u0441\u044f\u043a\u043d\u0443\u0442\u044b\u044f \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0441\u0430\u043c\u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0456 \u0437 \u043d\u0430\u0448\u044b\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435\u043c \u0411\u043e\u0433\u0443, \u044f\u043a\u043e\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u042f\u043c\u0443 \u043d\u0435 \u0434\u0430\u0434\u0430\u0435 \u0456 \u044f\u043a\u043e\u0433\u0430 \u0401\u043d \u0430\u0434 \u043d\u0430\u0441 \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435. \u0410\u0434\u043d\u0430\u043a \u0442\u044b\u043c, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u0437\u0430 \u0411\u043e\u0433\u0430\u043c \u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u042f\u043c\u0443, \u0401\u043d \u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c \u0456 \u0432\u0435\u0447\u043d\u0443\u044e \u0441\u043b\u0430\u0432\u0443. \u0401\u043d \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0436\u0432\u0430\u0435 \u0456\u0445 \u0441\u0432\u0430\u0456\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u044f\u043d\u044b \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u042f\u043c\u0443 \u0456 \u0456\u0434\u0443\u0446\u044c \u0437\u0430 \u0406\u043c; \u0441\u0430\u043c \u043d\u0456\u0447\u043e\u0433\u0430 \u0430\u0434 \u0456\u0445 \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0435, \u0431\u043e \u0401\u043d \u0431\u0430\u0433\u0430\u0442\u044b, \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0401\u043d \u0447\u0430\u043a\u0430\u0435 \u0430\u0434 \u043b\u044e\u0434\u0437\u0435\u0439 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f, \u0442\u043e \u0440\u043e\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e, \u0431\u0443\u0434\u0443\u0447\u044b \u0434\u043e\u0431\u0440\u044b\u043c \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c, \u0436\u0430\u0434\u0430\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0441\u0432\u0430\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u0442\u044b\u043c, \u0445\u0442\u043e \u042f\u043c\u0443 \u0441\u043b\u0443\u0436\u044b\u0446\u044c. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433 \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0437 \u0411\u043e\u0433\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u0430\u0432\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u044b\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 \u0411\u043e\u0433\u0443. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u043c: &laquo;\u041d\u0435 \u0432\u044b \u041c\u044f\u043d\u0435 \u0432\u044b\u0431\u0440\u0430\u043b\u0456, \u0430\u043b\u0435 \u042f \u0432\u044b\u0431\u0440\u0430\u045e \u0432\u0430\u0441&raquo; (\u042f\u043d 15, 16), \u043c\u0430\u044e\u0447\u044b \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435 \u044f\u043d\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u042f\u0433\u043e, \u0456\u0434\u0443\u0447\u044b \u0437\u0430 \u0406\u043c, \u0430\u043b\u0435 \u0441\u0430\u043c\u0456 \u0437\u0432\u0435\u0434\u0432\u0430\u044e\u0446\u044c \u0441\u043b\u0430\u0432\u0443 \u0430\u0434 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u043a\u0430\u043b\u0456 \u0456\u0434\u0443\u0446\u044c \u0437\u0430 \u0406\u043c. \u0422\u0430\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0425\u0430\u0447\u0443, \u043a\u0430\u0431 \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u0422\u044b \u0434\u0430\u045e \u041c\u043d\u0435, \u0431\u044b\u043b\u0456 \u0441\u0430 \u041c\u043d\u043e\u044e \u0442\u0430\u043c, \u0434\u0437\u0435 \u042f \u0451\u0441\u0446\u044c, \u043a\u0430\u0431 \u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u043b\u0430\u0432\u0443 \u041c\u0430\u044e&raquo; (\u043f\u0430\u0440. \u042f\u043d 17, 24).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0414\u0440\u0433 10, 12; \u041c\u0446 22, 38<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0446\u044f\u0431\u0435, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0442\u044b \u0431\u0430\u044f\u045e\u0441\u044f \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0445\u0430\u0434\u0437\u0456\u045e \u0448\u043b\u044f\u0445\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0456 \u043b\u044e\u0431\u0456\u045e \u042f\u0433\u043e; \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u045e \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u0442\u0432\u0430\u0439\u043c\u0443 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u0439 \u0441\u0432\u0430\u0451\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u044d\u0442\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0456 \u043f\u0435\u0440\u0448\u0430\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0442\u044b \u0431\u0430\u044f\u045e\u0441\u044f \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0445\u0430\u0434\u0437\u0456\u045e \u0448\u043b\u044f\u0445\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0456 \u043b\u044e\u0431\u0456\u045e \u042f\u0433\u043e; \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u045e \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u0442\u0432\u0430\u0439\u043c\u0443 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u0439 \u0441\u0432\u0430\u0451\u0439.<\/p>\r\n"}, {"GCH_CH_2_ID":"511","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps. 60, 2-3: CCL 39, 766)<\/span><br \/><span style=\"color: #ff0000;\">\u0423 \u0425\u0440\u044b\u0441\u0446\u0435 \u043c\u044b \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435, \u0443 \u0406\u043c \u043c\u044b \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0456 \u0434&rsquo;\u044f\u0431\u043b\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0430\u0447\u0443\u0439, \u0411\u043e\u0436\u0430, \u043c\u0430\u044e \u043f\u0440\u043e\u0441\u044c\u0431\u0443, \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u0439\u0441\u044f \u0434\u0430 \u043c\u0430\u0451\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b&raquo; (\u041f\u0441 61 [60], 1). \u0425\u0442\u043e \u0433\u044d\u0442\u0430 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c? \u041d\u0456\u0431\u044b \u043d\u0435\u0445\u0442\u0430 \u0430\u0434\u0437\u0456\u043d. \u0410\u0434\u043d\u0430\u043a \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u0446\u0456 \u0451\u043d \u0430\u0434\u0437\u0456\u043d: &laquo;\u0417 \u043a\u0440\u0430\u0451\u045e \u0437\u044f\u043c\u043b\u0456 \u044f \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u044e \u0434\u0430 \u0426\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u0437\u043d\u0435\u043c\u0430\u0433\u0430\u0435 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430&raquo; (\u041f\u0441 61 [60], 2). \u0422\u0430\u043c\u0443 \u045e\u0436\u043e \u043d\u0435 \u0430\u0434\u0437\u0456\u043d; \u0430 \u043a\u0430\u043b\u0456 \u0430\u0434\u0437\u0456\u043d, \u0434\u044b\u043a \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u0437\u0456\u043d, \u0430 \u043c\u044b \u045e\u0441\u0435 &ndash; \u042f\u0433\u043e\u043d\u044b\u044f \u0447\u0430\u0441\u0442\u043a\u0456. \u0411\u043e \u0448\u0442\u043e \u0437\u0430 \u0430\u0434\u0437\u0456\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043a\u0440\u044b\u0447\u044b\u0446\u044c \u0437 \u043a\u0440\u0430\u0451\u045e \u0437\u044f\u043c\u043b\u0456? \u0417 \u0433\u044d\u0442\u044b\u0445 \u043a\u0440\u0430\u0451\u045e \u043a\u0440\u044b\u0447\u044b\u0446\u044c \u043d\u0435 \u0445\u0442\u043e \u0456\u043d\u0448\u044b, \u044f\u043a \u0442\u0430\u044f \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430, \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0441\u0430\u043c\u043e\u043c\u0443 \u0421\u044b\u043d\u0443: &laquo;\u041f\u0440\u0430\u0441\u0456 \u045e \u041c\u044f\u043d\u0435, \u0456 \u0434\u0430\u043c \u043d\u0430\u0440\u043e\u0434\u044b \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0422\u0430\u0431\u0435 \u0456 \u043c\u0435\u0436\u044b \u0437\u044f\u043c\u043b\u0456 \u0432\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0435 \u0422\u0432\u0430\u0451&raquo; (\u041f\u0441 2, 8).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0433\u044d\u0442\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430, \u0433\u044d\u0442\u0430\u044f \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430, \u0433\u044d\u0442\u0430 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u0430\u0434\u0437\u0456\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b \u041a\u0430\u0441\u0446\u0451\u043b; \u0442\u0430\u044f \u0435\u0434\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u043e\u0439 \u043c\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f, \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0435 \u0437 \u043a\u0440\u0430\u0451\u045e \u0437\u044f\u043c\u043b\u0456. \u0410\u0431 \u0447\u044b\u043c \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0435? \u0410\u0431 \u0442\u044b\u043c, \u0448\u0442\u043e \u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0432\u044b\u0448\u044d\u0439: &laquo;\u041f\u0430\u0447\u0443\u0439, \u0411\u043e\u0436\u0430, \u043c\u0430\u044e \u043f\u0440\u043e\u0441\u044c\u0431\u0443, \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u0439\u0441\u044f \u0434\u0430 \u043c\u0430\u0451\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b; \u0437 \u043a\u0440\u0430\u0451\u045e \u0437\u044f\u043c\u043b\u0456 \u044f \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u044e \u0434\u0430 \u0426\u044f\u0431\u0435&raquo;. \u0410\u0431 \u0433\u044d\u0442\u044b\u043c \u044f \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u0426\u044f\u0431\u0435 \u0437 \u043a\u0440\u0430\u0451\u045e \u0437\u044f\u043c\u043b\u0456, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0430\u0434\u0443\u0441\u044e\u043b\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0447\u0430\u043c\u0443 \u044f \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u045e \u0430\u0431 \u0433\u044d\u0442\u044b\u043c? \u0411\u043e \u0437\u043d\u0435\u043c\u0430\u0433\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u043c\u0430\u0451. \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u043e\u0435 \u045e\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u045e\u0441\u0435 \u043b\u044e\u0434\u0437\u0456, \u043d\u0435 \u0437\u0432\u0435\u0434\u0432\u0430\u0435 \u0441\u043b\u0430\u0432\u0443, \u0430\u043b\u0435 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448\u0430 \u0436\u044b\u0446\u0446\u0451 \u045e \u0433\u044d\u0442\u0430\u0439 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u0446\u044b \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0431\u0435\u0437 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456 \u043c\u044b \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435\u043c\u0441\u044f. \u0422\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e, \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0441\u044f\u0431\u0435. \u041d\u0456\u0445\u0442\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0432\u044f\u043d\u043a\u0430 \u0441\u043b\u0430\u0432\u044b \u0431\u0435\u0437 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456. \u041f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435 \u0436 \u043f\u0440\u0430\u0437 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435, \u0430 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u043c\u043e\u0436\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0430\u043f\u044b\u043d\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u043c\u0456 \u0456 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u043b\u0456\u0447\u0430 \u0437 \u043a\u0440\u0430\u0451\u045e \u0437\u044f\u043c\u043b\u0456, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437\u043d\u0435\u043c\u0430\u0433\u0430\u0435 \u0441\u044d\u0440\u0446\u0430; \u0430\u0434\u043d\u0430\u043a \u0451\u043d \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b, \u0431\u043e \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u045e\u0442\u0432\u0430\u0440\u0430\u0435\u043c \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430, \u0401\u043d \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u0446\u044c \u043d\u0430 \u045e\u0437\u043e\u0440 \u0442\u0430\u0433\u043e \u0446\u0435\u043b\u0430, \u0443 \u044f\u043a\u0456\u043c \u043f\u0430\u043c\u0451\u0440, \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u0443\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u0442\u0443\u0434\u044b, \u043a\u0443\u0434\u044b \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0413\u0430\u043b\u0430\u0432\u0430, \u043c\u0435\u043b\u0456 \u043d\u0430\u0434\u0437\u0435\u044e \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u0446\u044c \u0456 \u0456\u043d\u0448\u044b\u044f \u0447\u0430\u0441\u0442\u043a\u0456 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u045e \u043d\u0430\u0441 \u0443 \u0441\u0430\u0431\u0435, \u043a\u0430\u043b\u0456 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0441\u0430\u0442\u0430\u043d\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u0441\u044f\u0431\u0435. \u041c\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u0442\u043e \u0447\u044b\u0442\u0430\u043b\u0456 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0432\u0435\u0434\u0432\u0430\u045e \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456. \u0422\u0430\u043a, \u0425\u0440\u044b\u0441\u0442\u0430 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u045e \u0434&rsquo;\u044f\u0431\u0430\u043b. \u0423 \u0425\u0440\u044b\u0441\u0446\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u045e\u0441\u044f \u0456 \u0442\u044b, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u0443\u0437\u044f\u045e \u0430\u0434 \u0446\u044f\u0431\u0435 \u0446\u0435\u043b\u0430, \u0430 \u0442\u0430\u0431\u0435 \u0434\u0430\u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435; \u0430\u0434 \u0446\u044f\u0431\u0435 \u0401\u043d \u0443\u0437\u044f\u045e \u0441\u043c\u0435\u0440\u0446\u044c, \u0430 \u0442\u0430\u0431\u0435 \u0434\u0430\u045e \u0436\u044b\u0446\u0446\u0451; \u0430\u0434 \u0446\u044f\u0431\u0435 \u0437\u0430\u0431\u0440\u0430\u045e \u0437\u043d\u044f\u0432\u0430\u0433\u0456, \u0430 \u0442\u0430\u0431\u0435 \u0434\u0430\u045e \u0433\u043e\u043d\u0430\u0440; \u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0430\u0434 \u0446\u044f\u0431\u0435 \u045e\u0437\u044f\u045e \u0441\u043f\u0430\u043a\u0443\u0441\u0443, \u0430 \u0442\u0430\u0431\u0435 \u0434\u0430\u045e \u0441\u0432\u0430\u044e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043c\u044b \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e \u0406\u043c \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435, \u0442\u043e \u045e \u0406\u043c \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0456 \u0456 \u0434&rsquo;\u044f\u0431\u043b\u0430. \u0411\u0430\u0447\u044b\u0448, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0430 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u043b\u0456, \u0430 \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435\u0448, \u0448\u0442\u043e \u0401\u043d \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443? \u041f\u0440\u044b\u0437\u043d\u0430\u0439, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0446\u044f\u0431\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0443 \u0406\u043c \u0456 \u0448\u0442\u043e \u045e \u0406\u043c \u0442\u044b \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435\u0448. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043c\u043e\u0433 \u0431\u044b \u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0434&rsquo;\u044f\u0431\u043b\u0430 \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0441\u044f\u0431\u0435, \u0430\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u045e \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f, \u0401\u043d \u043d\u0435 \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u0431\u044b \u0446\u044f\u0431\u0435, \u044f\u043a \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0446\u044c \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0415\u0440 1, 19; 39, 18<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0437 \u0442\u0430\u0431\u043e\u044e, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443\u0446\u044c \u0446\u044f\u0431\u0435, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u042f \u0437 \u0442\u0430\u0431\u043e\u044e, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u043a\u0430\u0431 \u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0446\u044f\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0435\u0448 \u0430\u0434 \u043c\u044f\u0447\u0430, \u0430\u043b\u0435 \u0422\u0432\u0430\u044f \u0434\u0443\u0448\u0430 \u0441\u0442\u0430\u043d\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0432\u044b\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u042f \u0437 \u0442\u0430\u0431\u043e\u044e, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u043a\u0430\u0431 \u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0446\u044f\u0431\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"512","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0437\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 14, De pauperum amore, 23-25: PG 35, 887-890)<\/span><br \/><span style=\"color: #ff0000;\">\u0411\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0446\u044c \u0430\u0434\u043d\u043e \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0434\u0443\u043c\u0430\u0439\u0441\u044f, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0447\u0430\u043c\u0443 \u0442\u044b \u0456\u0441\u043d\u0443\u0435\u0448 \u0456 \u0434\u044b\u0445\u0430\u0435\u0448, \u0434\u0443\u043c\u0430\u0435\u0448 \u0456 \u043c\u0430\u0435\u0448 \u0440\u043e\u0437\u0443\u043c, \u0430 \u045e \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443, \u0441\u043f\u0430\u0437\u043d\u0430e\u0448 \u0411\u043e\u0433\u0430, \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0448\u0441\u044f \u043d\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u043d\u0430 \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u0435 \u0441\u043b\u0430\u0432\u044b, \u044f\u043a\u0443\u044e \u0446\u044f\u043f\u0435\u0440 \u0431\u0430\u0447\u044b\u0448 \u043d\u0456\u0431\u044b \u045e \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0443 \u0456 \u0437\u0430\u0433\u0430\u0434\u043a\u0430\u0432\u0430, \u0430 \u043f\u043e\u0442\u044b\u043c \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u044f\u0435 \u0431\u043e\u043b\u044c\u0448 \u044f\u0441\u043d\u0430 \u0456 \u0432\u044b\u0440\u0430\u0437\u043d\u0430, \u0431\u043e \u0442\u044b \u0441\u0442\u0430\u045e \u0434\u0437\u0456\u0446\u0435\u043c \u0411\u043e\u0436\u044b\u043c, \u0441\u0443\u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 &ndash; \u043d\u0430\u0432\u0430\u0436\u0443\u0441\u044f \u0441\u043a\u0430\u0437\u0430\u0446\u044c &ndash; \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u043e\u0433\u0430\u043c? \u0410\u0434\u043a\u0443\u043b\u044c \u0442\u044b \u045e\u0441\u0451 \u0433\u044d\u0442\u0430\u0435 \u043c\u0430\u0435\u0448 \u0456 \u0430\u0434 \u043a\u0430\u0433\u043e?<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u045e\u0436\u043e \u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u0433\u044d\u0442\u044b\u044f \u043c\u0430\u043b\u044b\u044f \u0456 \u0431\u0430\u0447\u043d\u044b\u044f \u0440\u044d\u0447\u044b, \u0442\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0447\u044b\u0439\u043c\u0443 \u0434\u0430\u0440\u0443 \u0456 \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u043d\u0430\u0441\u0446\u0456 \u0442\u044b \u043c\u043e\u0436\u0430\u0448 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u043a\u0440\u0430\u0441\u0443 \u043d\u0435\u0431\u0430, \u0431\u0435\u0433 \u0441\u043e\u043d\u0446\u0430, \u0442\u0432\u0430\u0440 \u043c\u0435\u0441\u044f\u0446\u0430, \u0431\u0435\u0437\u043b\u0456\u0447 \u0437\u043e\u0440\u0430\u043a, \u0430 \u0432\u0430 \u045e\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c, \u044f\u043a \u0443 \u043c\u0443\u0437\u044b\u0446\u044b, \u0441\u0443\u0433\u0443\u0447\u043d\u0430\u0441\u0446\u044c \u0456 \u0433\u0430\u0440\u043c\u043e\u043d\u0456\u044e?<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u0434\u043e\u0436\u0434\u0436, \u0437\u0435\u043c\u043b\u044f\u0440\u043e\u0431\u0441\u0442\u0432\u0430, \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a, \u0440\u0430\u043c\u0451\u0441\u0442\u0432\u044b, \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043a\u0443, \u0437\u0430\u043a\u043e\u043d\u044b, \u0434\u0437\u044f\u0440\u0436\u0430\u0432\u044b, \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430\u0435 \u0456 \u043f\u043e\u045e\u043d\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456 \u0436\u044b\u0446\u0446\u0451, \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430 \u0456 \u0431\u043b\u0456\u0437\u043a\u0430\u0441\u0446\u044c \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0437\u043b\u0443\u0447\u0430\u043d\u044b \u0437 \u0442\u0430\u0431\u043e\u044e \u0441\u0432\u0430\u044f\u0446\u0442\u0432\u0430\u043c?<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043a\u0443\u043b\u044c \u043c\u0430\u0435\u0448 \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0434\u043d\u044b \u0436\u044b\u0432\u0451\u043b\u044b \u043f\u0440\u044b\u0440\u0443\u0447\u0430\u043d\u044b\u044f \u0456 \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u0442\u0430\u0431\u0435, \u0430 \u0456\u043d\u0448\u044b\u044f \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0442\u0430\u0431\u0435 \u043d\u0430 \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a?<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0446\u044f\u0431\u0435 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043e\u043c \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u043c \u0443\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456?<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e &ndash; \u043d\u0430\u0432\u0430\u0442 \u043d\u0435\u043b\u044c\u0433\u0430 \u043f\u0435\u0440\u0430\u043b\u0456\u0447\u044b\u0446\u044c \u043f\u0430\u0434\u0440\u0430\u0431\u044f\u0437\u043d\u0430 &ndash; \u0430\u0434\u0430\u0440\u044b\u045e \u0446\u044f\u0431\u0435 \u045e\u0441\u0456\u043c, \u0447\u044b\u043c \u0442\u044b \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u0435\u0448 \u0456\u043d\u0448\u044b\u0445 \u0436\u044b\u0432\u044b\u0445 \u0456\u0441\u0442\u043e\u0442\u0430\u045e?<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0456\u0431\u0430 \u0436 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0411\u043e\u0433, \u044f\u043a\u0456 \u045e\u0437\u0430\u043c\u0435\u043d \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0456 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0451 \u0436\u0430\u0434\u0430\u0435 \u0430\u0434 \u0446\u044f\u0431\u0435 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456? \u0426\u0456 \u043d\u0430\u043c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u043e\u0440\u0430\u043c\u043d\u0430, \u0448\u0442\u043e \u0437\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0435 \u0456 \u0437\u0430 \u0442\u043e\u0435, \u043d\u0430 \u0448\u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0451\u043c\u0441\u044f, \u043c\u044b \u043d\u0435 \u0437\u0434\u043e\u043b\u0435\u043b\u0456 \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u042f\u043c\u0443 \u0442\u044b\u043c \u0430\u0434\u043d\u044b\u043c, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044e? \u041a\u0430\u043b\u0456 \u0401\u043d, \u0445\u043e\u0446\u044c \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c \u0456 \u041f\u0430\u043d\u0430\u043c, \u043d\u0435 \u0441\u0430\u0440\u043e\u043c\u0435\u0435\u0446\u0446\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u043d\u0430\u0448\u044b\u043c \u0410\u0439\u0446\u043e\u043c, \u0442\u043e \u0445\u0456\u0431\u0430 \u043c\u044b \u0430\u0434\u043c\u043e\u0432\u0456\u043c\u0441\u044f \u0430\u0434 \u0442\u044b\u0445, \u0437 \u043a\u0456\u043c \u043d\u0430\u0441 \u044f\u0434\u043d\u0430\u0435 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0435 \u0441\u0432\u0430\u044f\u0446\u0442\u0432\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0456\u043a\u043e\u043b\u0456, \u043c\u0430\u0435 \u0431\u0440\u0430\u0442\u044b \u0456 \u0441\u044f\u0431\u0440\u044b, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u043c \u0436\u0430 \u0441\u0430\u0431\u0435 \u0434\u0440\u044d\u043d\u043d\u0430 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u0446\u0430 \u0440\u044d\u0447\u0430\u043c\u0456, \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u043c\u0456 \u043d\u0430\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u043c\u0443 \u0434\u0430\u0440\u0443. \u0423 \u0430\u0434\u0432\u0430\u0440\u043e\u0442\u043d\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0431 \u043f\u0430\u0447\u0443\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u041f\u044f\u0442\u0440\u0430, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430: &laquo;\u041f\u0430\u0441\u0430\u0440\u043e\u043c\u0446\u0435\u0441\u044f \u0432\u044b, \u0448\u0442\u043e \u0437\u0430\u0431\u0456\u0440\u0430\u0435\u0446\u0435 \u0441\u0430\u0431\u0435 \u0447\u0443\u0436\u043e\u0435, \u0456 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0439\u0446\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430, \u0442\u0430\u0434\u044b \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0431\u0435\u0434\u043d\u044b\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0440\u0443\u043f\u0456\u0446\u0446\u0430 \u0430\u0431 \u043d\u0430\u043a\u0430\u043f\u043b\u0435\u043d\u043d\u0456 \u0433\u0440\u043e\u0448\u0430\u0439 \u0443 \u0442\u043e\u0439 \u0447\u0430\u0441, \u044f\u043a \u0456\u043d\u0448\u044b\u044f \u0446\u0435\u0440\u043f\u044f\u0446\u044c \u043d\u044f\u0441\u0442\u0430\u0447\u0443, \u0431\u043e \u0442\u0430\u0434\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043f\u0440\u0430\u0440\u043e\u043a \u0410\u043c\u043e\u0441 \u043c\u043e\u0433 \u0431\u044b \u0434\u0430\u043a\u0430\u0440\u0430\u0446\u044c \u043d\u0430\u0441 \u0440\u044d\u0437\u043a\u0456\u043c\u0456 \u0456 \u043f\u0430\u0433\u0440\u043e\u0437\u043b\u0456\u0432\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: &laquo;\u0421\u0446\u0435\u0440\u0430\u0436\u044b\u0446\u0435\u0441\u044f \u0432\u044b, \u0448\u0442\u043e \u043a\u0430\u0436\u0430\u0446\u0435: \u041a\u0430\u043b\u0456 \u0436 \u043c\u0456\u043d\u0435 \u0447\u0430\u0441 \u043c\u0430\u043b\u0430\u0434\u0437\u0456\u043a\u0430, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u043f\u0440\u0430\u0434\u0430\u0432\u0430\u0446\u044c \u0445\u043b\u0435\u0431, \u0456 \u0448\u0430\u0431\u0430\u0442, \u043a\u0430\u0431 \u043c\u0430\u0433\u043b\u0456 \u0430\u0434\u0447\u044b\u043d\u0456\u0446\u044c \u0437\u0430\u0441\u0435\u043a\u0456&raquo; (\u043f\u0430\u0440. \u0410\u043c 8, 5).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0456 \u0433\u0430\u043b\u043e\u045e\u043d\u044b \u0437\u0430\u043a\u043e\u043d \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0435 \u0434\u043e\u0436\u0434\u0436 \u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e \u0456 \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u0435 \u0441\u043e\u043d\u0446\u0430 \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u043b\u044f \u045e\u0441\u0456\u0445. \u0401\u043d \u0440\u0430\u0441\u043f\u0430\u0441\u0446\u0456\u0440\u0430\u0435 \u0448\u044b\u0440\u043e\u043a\u0456\u044f \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u044b \u0437\u044f\u043c\u043b\u0456, \u043b\u044f\u0441\u044b \u0456 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0456 \u0441\u0442\u0440\u0443\u043c\u044f\u043d\u0456 \u0434\u043b\u044f \u045e\u0441\u044f\u043a\u0430\u0433\u0430 \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f. \u041f\u0442\u0443\u0448\u043a\u0430\u043c \u0401\u043d \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043f\u0430\u0432\u0435\u0442\u0440\u0430, \u0432\u0430\u0434\u0443 &ndash; \u0442\u044b\u043c, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0432\u0430\u0434\u0437\u0435, \u0456 \u045e\u0441\u0456\u043c \u0448\u0447\u043e\u0434\u0440\u0430 \u0434\u0430\u0435 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0435 \u0434\u043b\u044f \u0436\u044b\u0446\u0446\u044f, \u043d\u0435 \u0430\u0431\u043c\u044f\u0436\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0456\u0447\u044b\u0451\u0439 \u0443\u043b\u0430\u0434\u0430\u0439 \u0456 \u043d\u0435 \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u044f\u044e\u0447\u044b \u043c\u0435\u0436\u0430\u043c\u0456. \u0410\u043b\u0435, \u043a\u0430\u0431 \u0432\u044b\u044f\u0432\u0456\u0446\u044c \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0456 \u0440\u043e\u045e\u043d\u0430\u0441\u0446\u044e \u0434\u0430\u0440\u0443 \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0446\u044c \u0440\u043e\u045e\u043d\u0430\u0441\u0446\u044c \u043f\u0440\u044b\u0440\u043e\u0434\u044b, \u0401\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u0430\u043a, \u0448\u0442\u043e \u0433\u044d\u0442\u044b\u044f \u0434\u0430\u0440\u044b \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u044b\u044f \u0456 \u0448\u0447\u043e\u0434\u0440\u044b\u044f \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0456 \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041b\u043a 6, 35; \u041c\u0446 5, 45; \u041b\u043a 6, 36<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041b\u044e\u0431\u0456\u0446\u0435 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0432\u0430\u0448\u044b\u0445 \u0456 \u0447\u044b\u043d\u0456\u0446\u0435 \u0434\u0430\u0431\u0440\u043e, \u043f\u0430\u0437\u044b\u0447\u0430\u0439\u0446\u0435, \u043d\u0435 \u0447\u0430\u043a\u0430\u044e\u0447\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u045e\u0437\u0430\u043c\u0435\u043d, &ndash; \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u044b\u043d\u0430\u043c\u0456 \u0410\u0439\u0446\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u0456 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0441\u043e\u043d\u0446\u0443 \u0441\u0432\u0430\u0439\u043c\u0443 \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0434 \u0434\u0440\u044d\u043d\u043d\u044b\u043c\u0456 \u0456 \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u0456 \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u0434\u043e\u0436\u0434\u0436 \u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456, \u044f\u043a \u0410\u0439\u0446\u0435\u0446 \u0432\u0430\u0448 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0441\u043e\u043d\u0446\u0443 \u0441\u0432\u0430\u0439\u043c\u0443 \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0434 \u0434\u0440\u044d\u043d\u043d\u044b\u043c\u0456 \u0456 \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u0456 \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u0434\u043e\u0436\u0434\u0436 \u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445.<\/p>\r\n"}, {"GCH_CH_2_ID":"513","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u041f\u0430\u043d\u0441\u043a\u0443\u044e&raquo; \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 1-3: CSEL 3, 167-168)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0442\u043e \u0434\u0430\u045e \u0436\u044b\u0446\u0446\u0451, \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u044f \u043d\u0430\u043a\u0430\u0437\u044b &ndash; \u0433\u044d\u0442\u0430 \u043d\u0435 \u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u044f\u043a \u0411\u043e\u0436\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435, \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a \u043f\u0430\u0434 \u0431\u0443\u0434\u043e\u045e\u043b\u044f\u0439 \u043d\u0430\u0434\u0437\u0435\u0456; \u043f\u0430\u0434\u043f\u043e\u0440\u0430, \u044f\u043a\u0430\u044f \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0432\u0435\u0440\u0443; \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a, \u044f\u043a\u0456 \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u0430; \u0441\u0442\u044b\u0440\u043d\u043e, \u044f\u043a\u043e\u0435 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0448\u043b\u044f\u0445, \u0456 \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u0435, \u043a\u0430\u0431 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0423\u0441\u0451 \u0433\u044d\u0442\u0430, \u043a\u0456\u0440\u0443\u044e\u0447\u044b \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043f\u0430\u0434\u0430\u0442\u043b\u0456\u0432\u044b\u043c\u0456 \u0441\u044d\u0440\u0446\u0430\u043c\u0456 \u0432\u0435\u0440\u043d\u044b\u0445, \u0432\u044f\u0434\u0437\u0435 \u0456\u0445 \u0434\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0448\u043c\u0430\u0442 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e &ndash; \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0456 \u0445\u0430\u0446\u0435\u045e, \u043a\u0430\u0431 \u042f\u0433\u043e \u043f\u0430\u0447\u0443\u043b\u0456. \u0410\u0434\u043d\u0430\u043a, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0442\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0421\u044b\u043d \u0411\u043e\u0436\u044b. \u0401\u043d \u0443\u043b\u0430\u0441\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u0411\u043e\u0433\u0430, \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u044b\u044f \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c; \u0456 \u045e\u0436\u043e \u043d\u0435 \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u0448\u043b\u044f\u0445 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u044b\u0439\u0441\u0446\u0456, \u0430\u043b\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0430\u043c; \u0443\u043a\u0430\u0437\u0432\u0430\u0435 \u0456 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0448\u043b\u044f\u0445 \u043d\u0430\u043c, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u044b\u043c\u0456 \u0456 \u0431\u0435\u0441\u043a\u043b\u0430\u043f\u043e\u0442\u043d\u0430 \u0436\u044b\u043b\u0456, \u043a\u0430\u0431 \u0446\u044f\u043f\u0435\u0440, \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u044f \u0437\u0437\u044f\u043d\u043d\u0435\u043c \u043b\u0430\u0441\u043a\u0456, \u043c\u044b \u0442\u0440\u044b\u043c\u0430\u043b\u0456\u0441\u044f \u0448\u043b\u044f\u0445\u0443 \u0436\u044b\u0446\u0446\u044f, \u043d\u0430 \u044f\u043a\u0456\u043c \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u043c \u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044f\u0440\u043e\u0434 \u043c\u043d\u043e\u0433\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0437\u0431\u0430\u045e\u0447\u044b\u0445 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0456 \u0411\u043e\u0441\u043a\u0456\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e, \u0443 \u044f\u043a\u0456\u0445 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043a\u043b\u043e\u043f\u0430\u0442 \u0430\u0431 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u045e\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430, \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043f\u043e\u0441\u0430\u0431 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u043d\u0430\u0441, \u0430\u0431 \u0447\u044b\u043c \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0441\u0456\u0446\u044c. \u0422\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u045e \u043d\u0430\u043c \u0436\u044b\u0446\u0446\u0451, \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u043d\u0430\u0441 \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0435. \u0401\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430 \u0441\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044e, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u0430\u0434\u0430\u0440\u044b\u045e \u043d\u0430\u0441 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456, \u043a\u0430\u0431 \u043c\u044b, \u0443\u0437\u043d\u043e\u0441\u044f\u0447\u044b \u0434\u0430 \u0410\u0439\u0446\u0430 \u043c\u0430\u043b\u0456\u0442\u043e\u045e\u043d\u044b\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b, \u0431\u044b\u043b\u0456 \u0445\u0443\u0442\u0447\u044d\u0439 \u043f\u0430\u0447\u0443\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0433\u0430\u0434\u0437\u0456\u043d\u0430, \u043a\u0430\u043b\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u044f \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u044b \u0410\u0439\u0446\u0430 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u042f\u043c\u0443 \u045e \u0434\u0443\u0445\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u0422\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u0440\u0430\u043d\u0435\u0439 \u0430\u0431\u044f\u0446\u0430\u045e, \u0446\u044f\u043f\u0435\u0440 \u0432\u044b\u043a\u0430\u043d\u0430\u045e; \u0431\u043e \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437 \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0456 \u043f\u0440\u0430\u045e\u0434\u0443, \u043a\u0430\u0431 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043c\u0430\u0433\u043b\u0456 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u0456 \u045e \u0434\u0443\u0445\u0443 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u0411\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0430\u044f \u0436 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0431\u043e\u043b\u044c\u0448 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u044f, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u0430\u044f, \u044f\u043a\u0443\u044e \u043d\u0430\u043c \u0434\u0430\u045e \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441? \u0413\u044d\u0442\u0430 \u0401\u043d \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430! \u042f\u043a\u0430\u044f \u0436 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0431\u043e\u043b\u044c\u0448 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f, \u0447\u044b\u043c \u0442\u0430\u044f, \u0448\u0442\u043e \u0432\u044b\u0439\u0448\u043b\u0430 \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u0441\u0430\u043c\u043e\u0433\u0430 \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430? \u0411\u043e \u0401\u043d &ndash; \u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u045e\u0434\u0430! \u041c\u0430\u043b\u0456\u0446\u0446\u0430 \u0456\u043d\u0430\u043a\u0448, \u0447\u044b\u043c \u0432\u0443\u0447\u044b\u045e \u043d\u0430\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0431\u044b\u043b\u043e \u0431 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435\u043c, \u0430\u043b\u0435 \u0456 \u0433\u0440\u0430\u0445\u043e\u043c, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0442\u044b\u043c, \u0448\u0442\u043e \u0401\u043d \u0441\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0412\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u043d\u0430\u043a\u0430\u0437 \u0411\u043e\u0436\u044b, \u043a\u0430\u0431 \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0432\u0430\u0448\u0430\u0439 \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u0456&raquo; (\u043f\u0430\u0440. \u041c\u043a 7, 9).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u044f\u043a \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u043d\u0430\u0441 \u0411\u043e\u0433, \u043d\u0430\u0448 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a. \u0422\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b \u043d\u0430\u0448\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u043a\u0430\u0439 \u0456 \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0439, \u043a\u0430\u043b\u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0443 \u0411\u043e\u0433\u0430 \u042f\u0433\u043e\u043d\u044b\u0445 \u0434\u0430\u0440\u043e\u045e \u0456 \u043a\u0430\u043b\u0456 \u0434\u0430 \u0411\u043e\u0436\u044b\u0445 \u0432\u0443\u0448\u044d\u0439 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0441\u0430\u043c\u043e\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0437\u043d\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u045e \u043d\u0430\u0448\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0441\u044d\u0440\u0446\u044b, \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u045e\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0437 \u0437\u043d\u0435\u0448\u043d\u0456 \u0433\u043e\u043b\u0430\u0441. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u043d\u0430\u0448 \u0430\u0431\u0430\u0440\u043e\u043d\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0410\u0439\u0446\u043e\u043c, \u0442\u043e \u043c\u044b, \u043a\u0430\u043b\u0456 \u0433\u0440\u0430\u0448\u044b\u043c \u0456 \u043f\u0440\u043e\u0441\u0456\u043c \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0456\u043d\u044b, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0434\u0430 \u042f\u0433\u043e \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456. \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0430\u0431 \u0447\u044b\u043c \u0431\u044b \u043c\u044b \u043d\u0456 \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u0410\u0439\u0446\u0430 \u045e \u042f\u0433\u043e \u0456\u043c\u044f, \u0443\u0441\u0451 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c. \u0422\u0430\u043c\u0443 \u043d\u0430\u0448\u044b\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u043f\u043b\u0451\u043d\u043d\u044b\u043c\u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456, \u043f\u0440\u043e\u0441\u044f\u0447\u044b \u0410\u0439\u0446\u0430 \u045e \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u042f\u0433\u043e \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 16, 24; 14, 13<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0432\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u045e \u0456\u043c\u044f \u041c\u0430\u0451. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0440\u0430\u0441\u0456\u0446\u0435 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435, \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u044f \u0431\u044b\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u043e\u0435, \u0430\u0431 \u0447\u044b\u043c \u043f\u0430\u043f\u0440\u043e\u0441\u0456\u0446\u0435 \u0410\u0439\u0446\u0430 \u045e \u0456\u043c\u044f \u041c\u0430\u0451, \u042f \u0437\u0440\u0430\u0431\u043b\u044e, \u043a\u0430\u0431 \u0410\u0439\u0446\u0435\u0446 \u0443\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u045e \u0421\u044b\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u0441\u0456\u0446\u0435 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435, \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u044f \u0431\u044b\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u0439.<\/p>\r\n"}, {"GCH_CH_2_ID":"514","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0414\u043e\u043a\u0430\u0437\u044b&raquo; \u0410\u0444\u0440\u0430\u0430\u0442\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Dem. 11, De circum\u0441\u0456sione, 11-12: PS 1, 498-503)<\/span><br \/><span style=\"color: #ff0000;\">\u0410\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u044d\u0440\u0446\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u043a\u043e\u043d \u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0431\u044b\u043b\u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u0437\u043c\u0435\u043d\u0435\u043d\u044b\u044f. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0411\u043e\u0433 \u0437\u043c\u044f\u043d\u0456\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u0410\u0434\u0430\u043c\u0430\u043c \u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u041d\u043e\u0435\u043c. \u041d\u0430\u0441\u0442\u0443\u043f\u043d\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0401\u043d \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430\u043c, \u044f\u043a\u0456 \u0437\u043c\u044f\u043d\u0456\u045e, \u043a\u0430\u0431 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u0446\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u043e\u0432\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0437 \u041c\u0430\u0439\u0441\u0435\u0435\u043c \u043d\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u045e\u0441\u044f, \u0411\u043e\u0433 \u0434\u0430\u045e \u0430\u043f\u043e\u0448\u043d\u044f\u043c\u0443 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044e \u0456\u043d\u0448\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u044f\u043a\u0456 \u045e\u0436\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u043c\u044f\u043d\u0456\u0446\u044c. \u0410\u0434\u0430\u043c\u0443 \u0411\u043e\u0433 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u043d\u0435 \u043a\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044c \u043f\u043b\u0430\u0434\u043e\u045e \u0434\u0440\u044d\u0432\u0430 \u0436\u044b\u0446\u0446\u044f, \u0430 \u0434\u043b\u044f \u041d\u043e\u044f \u0434\u0430\u045e \u0437\u043d\u0430\u043a \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u045e \u0434\u0443\u0437\u0435 \u0432\u044f\u0441\u0451\u043b\u043a\u0456. \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0443, \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u043c\u0443 \u0440\u0430\u043d\u0435\u0439 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u0433\u043e\u043d\u0430\u0439 \u0432\u0435\u0440\u044b, \u0411\u043e\u0433 \u0434\u0430\u045e \u043f\u0430\u0437\u043d\u0435\u0439 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435 \u044f\u043a \u0437\u043d\u0430\u043a \u0456 \u043f\u044f\u0447\u0430\u0446\u044c \u0434\u043b\u044f \u044f\u0433\u043e \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0430\u045e. \u041c\u0430\u0439\u0441\u0435\u0439 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u0435 \u044f\u0433\u043d\u044f \u044f\u043a \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0440\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u044b \u0440\u043e\u0437\u043d\u0456\u043b\u0456\u0441\u044f \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u044e. \u041a\u0430\u043b\u0456 \u0433\u0430\u0432\u043e\u0440\u043a\u0430 \u0456\u0434\u0437\u0435 \u043f\u0440\u0430 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435, \u0442\u043e \u0434\u0430\u045e\u0446\u0430 \u0433\u044d\u0442\u044b\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0430\u045e \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043a\u043e\u0435 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435, \u043f\u0440\u0430 \u044f\u043a\u043e\u0435 \u043a\u0430\u0436\u0430 \u0415\u0440\u0430\u043c\u0456\u044f: &laquo;\u0417\u0440\u0430\u0431\u0456\u0446\u0435 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435 \u0432\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e&raquo; (\u0415\u0440 4, 4). \u041a\u0430\u043b\u0456 \u0431\u044b\u045e \u043f\u0440\u0430\u0432\u0430\u043c\u043e\u0446\u043d\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u044f\u043a\u0456 \u0411\u043e\u0433 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0437 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430\u043c, \u0442\u043e \u043f\u0440\u0430\u0432\u0430\u043c\u043e\u0446\u043d\u044b \u0456 \u0433\u043e\u0434\u043d\u044b \u0432\u0435\u0440\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u043e\u0439 \u0434\u0440\u0443\u0433\u0456, \u044f\u043a\u0456 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f \u0441\u044d\u0440\u0446\u0430; \u0442\u0430\u043c\u0443 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435\u043b\u044c\u0433\u0430 \u0431\u0443\u0434\u0437\u0435 \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0456\u0432\u0430\u0446\u044c \u0417\u0430\u043a\u043e\u043d, \u044f\u043a\u0456 \u0431\u044f\u0440\u044d \u043f\u0430\u0447\u0430\u043a \u0430\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430-\u0437\u0430 \u0437\u0430\u043a\u043e\u043d\u0430\u043c, \u0446\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0417\u0430\u043a\u043e\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0434 \u0411\u043e\u0433\u0430 \u0417\u0430\u043a\u043e\u043d \u0437 \u0443\u0441\u0456\u043c\u0456 \u044f\u0433\u043e \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u043d\u044f\u043c\u0456 \u0456 \u043d\u0430\u043a\u0430\u0437\u0430\u043c\u0456. \u0410\u043b\u0435 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f\u0433\u043e \u043d\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456, \u0411\u043e\u0433 \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u045e \u0456 \u0441\u0430\u043c \u0417\u0430\u043a\u043e\u043d, \u0456 \u044f\u0433\u043e \u043d\u0430\u043a\u0430\u0437\u044b. \u0410\u0434\u043d\u0430\u043a \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u0446\u044c \u043d\u043e\u0432\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u044f\u043a\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e \u0441\u043b\u043e\u045e \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0446\u0446\u0430 \u0430\u0434 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u044f\u0433\u0430, \u0445\u043e\u0446\u044c \u0441\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c \u0430\u0431\u043e\u0434\u0432\u0443\u0445 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0401\u043d \u0441\u0430\u043c. \u0410 \u0432\u043e\u0441\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u044f\u043a\u0456 \u0401\u043d \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0434\u0430\u0446\u044c: &laquo;\u0423\u0441\u0435, \u0430\u0434 \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0430\u0433\u0430 \u0434\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0433\u0430 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445, \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u041c\u044f\u043d\u0435&raquo;. \u0423 \u0433\u044d\u0442\u044b\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0446\u0435 \u0431\u043e\u043b\u044c\u0448 \u0443\u0436\u043e \u043d\u044f\u043c\u0430 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f \u0446\u0435\u043b\u0430 \u044f\u043a \u0437\u043d\u0430\u043a\u0443 \u043f\u0440\u044b\u043d\u0430\u043b\u0435\u0436\u043d\u0430\u0441\u0446\u0456 \u0434\u0430 \u043d\u0430\u0440\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043c\u044b \u0446\u0432\u0451\u0440\u0434\u0430 \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u0443\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0456\u0432\u0430\u045e \u0437\u0430\u043a\u043e\u043d\u044b \u0446\u044f\u0433\u0430\u043c \u043c\u043d\u043e\u0433\u0456\u0445 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u045e \u0456 \u0448\u0442\u043e \u0433\u044d\u0442\u044b\u044f \u0437\u0430\u043a\u043e\u043d\u044b \u0431\u044b\u043b\u0456 \u0432\u0430 \u045e\u0436\u044b\u0442\u043a\u0443 \u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u043a\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u0445\u0430\u0446\u0435\u045e. \u041f\u043e\u0442\u044b\u043c \u044f\u043d\u044b \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0456\u0441\u044f \u0441\u0430\u0441\u0442\u0430\u0440\u044d\u043b\u044b\u043c\u0456, \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430, \u044f\u043a\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c, \u0448\u0442\u043e &laquo;\u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0430 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u045e \u0440\u043e\u0437\u043d\u044b\u044f \u0447\u0430\u0441\u044b \u0456 \u045e \u0440\u043e\u0437\u043d\u044b\u0445 \u0444\u043e\u0440\u043c\u0430\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448 \u0411\u043e\u0433 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b, \u0430 \u042f\u0433\u043e \u043d\u0430\u043a\u0430\u0437\u044b \u0433\u043e\u0434\u043d\u044b\u044f \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0432\u0435\u0440\u044b. \u0422\u0430\u043c\u0443 \u043a\u043e\u0436\u043d\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0443 \u0441\u0432\u043e\u0439 \u0447\u0430\u0441 \u0431\u044b\u045e \u043f\u0440\u0430\u0432\u0430\u043c\u043e\u0446\u043d\u044b\u043c, \u0441\u043b\u0443\u0448\u043d\u044b\u043c \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c, \u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u043c\u0430\u0435 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043f\u0430\u045e\u0442\u043e\u0440\u043d\u0430\u0435 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435 \u045e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u042f\u0440\u0434\u0430\u043d\u0435 &ndash; \u0443 \u0445\u0440\u043e\u0441\u0446\u0435 \u0456 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0456 \u0433\u0440\u0430\u0445\u043e\u045e (\u043f\u0430\u0440. \u0413\u0431\u0440 4, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441, \u0441\u044b\u043d \u041d\u0443\u043d\u0430, \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437 \u0430\u0431\u0440\u0430\u0437\u0430\u045e \u043d\u0430\u0440\u043e\u0434 \u043a\u0430\u043c\u0435\u043d\u043d\u044b\u043c \u043d\u0430\u0436\u043e\u043c, \u043a\u0430\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0433\u044d\u0442\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e \u043f\u0440\u0430\u0437 \u042f\u0440\u0434\u0430\u043d. \u0415\u0437\u0443\u0441, \u043d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435 \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437 \u043f\u0440\u0430\u0437 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u044d\u0440\u0446\u0430 \u0442\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u045e \u042f\u0433\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u0456 \u0431\u044b\u043b\u0456 \u0430\u0431\u043c\u044b\u0442\u044b\u044f \u043f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442. \u042f\u043d\u044b \u0431\u044b\u043b\u0456 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u044f &laquo;\u043c\u044f\u0447\u043e\u043c, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u0430, \u0448\u0442\u043e \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e\u0433\u043b\u044b\u0431&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441, \u0441\u044b\u043d \u041d\u0443\u043d\u0430, \u043f\u0440\u044b\u0432\u0451\u045e \u043d\u0430\u0440\u043e\u0434 \u0443 \u0430\u0431\u044f\u0446\u0430\u043d\u0443\u044e \u0437\u044f\u043c\u043b\u044e; \u0430 \u0415\u0437\u0443\u0441, \u043d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430, \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u0437\u044f\u043c\u043b\u044e \u0436\u044b\u0446\u0446\u044f \u045e\u0441\u0456\u043c, \u0445\u0442\u043e \u043f\u044f\u0440\u043e\u0439\u0434\u0437\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u042f\u0440\u0434\u0430\u043d \u0456 \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c, \u0430\u0431\u0440\u0430\u0437\u0430\u044e\u0447\u044b \u045e\u043b\u0430\u0441\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u0442\u044b\u044f, \u0445\u0442\u043e \u043c\u0430\u0435 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0430\u0434\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0432\u0430\u0434\u044b \u043f\u0430\u045e\u0442\u043e\u0440\u043d\u0430\u0433\u0430 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u044f. \u042f\u043d\u044b \u045e\u0432\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430\u043c, \u0432\u0435\u0440\u043d\u044b\u043c \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u0456 \u0430\u0439\u0446\u043e\u043c \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f\u0433\u043e \u0432\u0435\u0440\u0430 \u0431\u044b\u043b\u0430 \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u0430 \u044f\u043c\u0443 \u044f\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0431\u0440 8, 8b. 10b; \u043f\u0430\u0440. 2 \u041a\u0430\u0440 3, 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0437 \u0434\u043e\u043c\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u043e\u0432\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442. \u042f \u045e\u043a\u043b\u0430\u0434\u0443 \u0437\u0430\u043a\u043e\u043d\u044b \u041c\u0430\u0435 \u045e \u0440\u043e\u0437\u0443\u043c \u0456\u0445\u043d\u0456. <span style=\"color: #ff0000;\">*<\/span> \u041d\u0430 \u0441\u044d\u0440\u0446\u0430\u0445 \u0456\u0445\u043d\u0456\u0445 \u043d\u0430\u043f\u0456\u0448\u0443 \u043d\u0435 \u0430\u0442\u0440\u0430\u043c\u0430\u043d\u0442\u0430\u043c, \u0430\u043b\u0435 \u0414\u0443\u0445\u0430\u043c \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0430\u043c \u0441\u0432\u043e\u0439 \u0437\u0430\u043a\u043e\u043d \u0456\u043c \u043d\u0435 \u043d\u0430 \u043a\u0430\u043c\u0435\u043d\u043d\u044b\u0445 \u0442\u0430\u0431\u043b\u0456\u0446\u0430\u0445, \u0430\u043b\u0435 \u043d\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u0445 \u0442\u0430\u0431\u043b\u0456\u0446\u0430\u0445 \u0441\u044d\u0440\u0446\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430 \u0441\u044d\u0440\u0446\u0430\u0445 \u0456\u0445\u043d\u0456\u0445 \u043d\u0430\u043f\u0456\u0448\u0443 \u043d\u0435 \u0430\u0442\u0440\u0430\u043c\u0430\u043d\u0442\u0430\u043c, \u0430\u043b\u0435 \u0414\u0443\u0445\u0430\u043c \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"515","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u0410\u0441\u0442\u044d\u0440\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0410\u043c\u0430\u0437\u0456\u0456<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 13: PG 40, 355-358. 362)<\/span><br \/><span style=\"color: #ff0000;\">\u0411\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0442\u0430\u043a, \u044f\u043a \u043f\u0430\u0441\u0432\u0456\u045e \u041f\u0430\u043d<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0432\u044b \u0436\u0430\u0434\u0430\u0435\u0446\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u041f\u0430\u043d\u0430, \u043d\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u044f\u043a\u043e\u0433\u0430 \u0431\u044b\u043b\u0456 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u044f, \u0456\u0434\u0437\u0456\u0446\u0435 \u0437\u0430 \u042f\u0433\u043e \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c. \u0412\u044b, \u044f\u043a\u0456\u044f \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0435\u0441\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456 \u0456 \u043f\u0440\u0430\u0437 \u0441\u0430\u043c\u043e \u0456\u043c\u044f \u0432\u044b\u0437\u043d\u0430\u0435\u0446\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0439\u0446\u0435 \u042f\u0433\u043e \u043b\u044e\u0431\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u042f\u0433\u043e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456. \u0401\u043d, \u044f\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439 \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0430\u0441\u043b\u0430\u045e \u042f\u043d\u0430, \u0432\u0435\u0441\u0442\u0443\u043d\u0430 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f \u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430, \u0430 \u0434\u0430 \u042f\u043d\u0430 &ndash; \u0443\u0441\u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u043b\u044e\u0434\u0437\u0435\u0439 \u0430\u043f\u0430\u043c\u044f\u0442\u0430\u0446\u0446\u0430 \u0456 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u043d\u0430 \u0441\u043b\u0443\u0448\u043d\u044b \u0448\u043b\u044f\u0445, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043b\u0435\u043f\u0448\u044b \u043f\u043b\u0451\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b, \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0443\u043b\u0430\u0441\u043d\u044b\u043c\u0456 \u0432\u0443\u0441\u043d\u0430\u043c\u0456: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435, \u0443\u0441\u0435 \u0441\u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0456 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0430\u043d\u044b\u044f, \u0456 \u042f \u0441\u0443\u043f\u0430\u043a\u043e\u044e \u0432\u0430\u0441&raquo; (\u041c\u0446 11, 28). \u0410 \u044f\u043a \u0401\u043d \u043f\u0440\u044b\u043d\u044f\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u045e \u042f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0441? \u0401\u043d \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0434\u0430\u045e \u0456\u043c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u0445\u0443\u0442\u043a\u0430, \u0443\u043c\u043e\u043c\u0430\u043d\u0442 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0456\u0445 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0456\u0445 \u043d\u0435\u043f\u0430\u043a\u043e\u0456\u043b\u0430. \u0421\u043b\u043e\u0432\u0430 \u0430\u0441\u0432\u044f\u0446\u0456\u043b\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430 \u0414\u0443\u0445 \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0456\u0445; \u0441\u0442\u0430\u0440\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u044b\u045e \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b \u045e \u0432\u0430\u0434\u0437\u0435 \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u044f\u043a \u043d\u043e\u0432\u044b, \u043a\u0432\u0456\u0442\u043d\u0435\u044e\u0447\u044b \u043b\u0430\u0441\u043a\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435? \u0422\u043e\u0439, \u0445\u0442\u043e \u0431\u044b\u045e \u0432\u043e\u0440\u0430\u0433\u0430\u043c, \u0441\u0442\u0430\u045e \u0441\u044f\u0431\u0440\u0430\u043c; \u0445\u0442\u043e \u0431\u044b\u045e \u0447\u0443\u0436\u044b\u043c, \u0441\u0442\u0430\u045e \u0441\u044b\u043d\u0430\u043c; \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b, \u0441\u0442\u0430\u045e \u0441\u0432\u044f\u0442\u044b\u043c \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0442\u0430\u043a\u0456 \u043f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0456 \u043a\u043b\u043e\u043f\u0430\u0442, \u044f\u043a\u0456 \u043c\u0435\u045e \u041f\u0430\u043d. \u0411\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0430\u0434 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435\u043c. \u0422\u0430\u043c, \u044f\u043a \u0443 \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0443, \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u0431\u0430\u0447\u044b\u0446\u044c \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0434\u0430\u0431\u0440\u044b\u043d\u0456, \u044f\u043a\u0456\u043c \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u0443\u0447\u044b\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u0445 \u0456 \u0430\u043b\u0435\u0433\u043e\u0440\u044b\u044f\u0445 \u044f \u0431\u0430\u0447\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043f\u0430\u0441\u0442\u044b\u0440\u0430 \u0430\u0432\u0435\u0447\u0430\u043a. \u041a\u0430\u043b\u0456 \u0430\u0434\u043d\u0430 \u0437 \u0456\u0445 \u043f\u0430\u043a\u0456\u043d\u0435 \u0441\u0442\u0430\u0442\u0430\u043a \u0456, \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u045e\u0448\u044b, \u0442\u0443\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430 \u043d\u0435\u0432\u044f\u0434\u043e\u043c\u044b\u0445 \u043c\u044f\u0441\u0446\u0456\u043d\u0430\u0445, \u0401\u043d \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u043f\u0430\u0440\u0430\u0434\u0430\u043a, \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430 \u043f\u0430\u0441\u0432\u0456\u0446\u0446\u0430, \u0430\u043b\u0435 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u043f\u043e\u0448\u0443\u043a\u0456 \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u0430\u0439, \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u043f\u0440\u0430\u0437 \u0434\u0430\u043b\u0456\u043d\u044b \u0456 \u045e\u0437\u0433\u043e\u0440\u043a\u0456, \u043f\u0440\u0430\u0431\u0456\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u043f\u0440\u0430\u0437 \u0441\u0442\u0440\u043e\u043c\u043a\u0456\u044f \u0433\u043e\u0440\u044b \u0456 \u0441\u0430\u043c\u043e\u0442\u043d\u044b\u044f \u043f\u0443\u0441\u0442\u044b\u043d\u0456; \u0456 \u0442\u0430\u043a \u0434\u043e\u045e\u0433\u0430 \u0448\u0443\u043a\u0430\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u043d\u043e\u0439\u0434\u0437\u0435\u043d\u0443\u044e \u0401\u043d \u043d\u0435 \u0431&rsquo;\u0435 \u0456 \u043d\u0435 \u043f\u0430\u0434\u0433\u0430\u043d\u044f\u0435 \u043d\u0435\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0434\u0430 \u0441\u0442\u0430\u0442\u043a\u0443, \u0430\u043b\u0435 \u0431\u044f\u0440\u044d \u043d\u0430 \u0441\u0432\u0430\u0435 \u0440\u0443\u043a\u0456 \u0456 \u0430\u0431\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0451\u0439 \u043f\u044f\u0448\u0447\u043e\u0442\u043d\u0430; \u043d\u044f\u0441\u0435 \u044f\u0435 \u0434\u0430 \u0441\u0442\u0430\u0442\u043a\u0443, \u0431\u043e\u043b\u044c\u0448 \u0440\u0430\u0434\u0443\u044e\u0447\u044b\u0441\u044f \u0430\u0434\u043d\u043e\u0439 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u043d\u0430\u0439, \u0447\u044b\u043c \u043c\u043d\u043e\u0441\u0442\u0432\u0443 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u0445. \u041f\u0430\u0434\u0443\u043c\u0430\u0435\u043c \u043d\u0430\u0434 \u0442\u044b\u043c, \u0448\u0442\u043e \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0456 \u0437\u0430\u0442\u043e\u0435\u043d\u0430 \u045e \u043f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u0456. \u0410\u0432\u0435\u0447\u043a\u0430 \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0430\u0432\u0435\u0447\u043a\u0443, \u0430 \u043f\u0430\u0441\u0442\u044b\u0440 &ndash; \u043f\u0430\u0441\u0442\u044b\u0440\u0430, \u0430\u043b\u0435 \u043d\u0435\u0448\u0442\u0430 \u0456\u043d\u0448\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u044f \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u044b \u043c\u0430\u044e\u0446\u044c \u0441\u0432\u044f\u0442\u044b \u0437\u043c\u0435\u0441\u0442. \u042f\u043d\u044b \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u043c, \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u043b\u0456\u0447\u044b\u043b\u0456 \u043b\u044e\u0434\u0437\u0435\u0439 \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u044b\u043c\u0456 \u0456 \u0431\u0435\u0437\u043d\u0430\u0434\u0437\u0435\u0439\u043d\u044b\u043c\u0456, \u043a\u0430\u0431 \u043d\u0435 \u0456\u0433\u043d\u0430\u0440\u0430\u0432\u0430\u043b\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u043f\u044b\u043d\u0443\u045e\u0441\u044f \u045e \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b, \u0456 \u043a\u0430\u0431 \u043d\u0435 \u043b\u0435\u043d\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0447\u044b \u0456\u043c. \u0423\u0441\u0456\u0445, \u0445\u0442\u043e \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u045e \u0456 \u0430\u0434\u044b\u0448\u043e\u045e \u0430\u0434 \u0441\u043b\u0443\u0448\u043d\u044b\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0446\u044c \u043d\u0430 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0448\u043b\u044f\u0445 \u0456 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0456\u0445 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044e, \u0434\u0430\u043b\u0443\u0447\u0430\u044e\u0447\u044b \u0456\u0445 \u0434\u0430 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0436\u044b\u0432\u0443\u0446\u044c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0430 \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0417\u0430\u0445 7, 9; \u041c\u0446 6, 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b\u043d\u043e\u0441\u044c\u0446\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u043f\u0440\u044b\u0441\u0443\u0434\u044b.<span style=\"color: #ff0000;\"> *<\/span> \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u044f \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0434\u0430\u0440\u0430\u0432\u0430\u0446\u044c \u043b\u044e\u0434\u0437\u044f\u043c \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u0456\u0445\u043d\u0456\u044f, \u0442\u043e \u0410\u0439\u0446\u0435\u0446 \u0432\u0430\u0448 \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0434\u0430\u0440\u0443\u0435 \u0456 \u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u044f \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"516","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041b\u044e\u0441\u0442\u044d\u0440\u043a\u0430 \u043b\u044e\u0431\u043e\u0432\u0456&raquo; \u0431\u043b. \u042d\u043b\u044c\u0440\u044d\u0434\u0430, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 3, 5: PL 195, 582)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 <\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0431\u043e\u045e \u0434\u0430 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u045e &ndash; \u0433\u044d\u0442\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u044f \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0456 \u043d\u0456\u0448\u0442\u043e \u043d\u0430\u0441 \u0442\u0430\u043a \u043d\u0435 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0430\u0435 \u0434\u0430 \u044f\u0435, \u044f\u043a \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0435 \u043d\u0430\u0434 \u0442\u043e\u0439 \u0434\u0437\u0456\u045e\u043d\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0425\u0440\u044b\u0441\u0442\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 &laquo;\u043d\u0430\u0439\u043f\u0440\u044b\u0433\u0430\u0436\u044d\u0439\u0448\u044b \u0437 \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445&raquo; (\u041f\u0441 45 [44], 3) \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u045e \u0441\u0432\u043e\u0439 \u043f\u043e\u045e\u043d\u044b \u043a\u0440\u0430\u0441\u044b \u0442\u0432\u0430\u0440 \u043f\u0430\u0434 \u043f\u043b\u044f\u045e\u043a\u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445; \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044b\u043c \u0437\u0430\u0441\u043b\u0430\u043d\u0456\u0446\u044c \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b, \u043f\u043e\u0437\u0456\u0440\u043a \u044f\u043a\u0456\u0445 \u043a\u0456\u0440\u0443\u0435 \u045e\u0441\u0456\u043c; \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u045e \u0434\u043b\u044f \u0431\u0456\u0447\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u0435 \u0431\u0430\u043a\u0456; \u043d\u0430 \u0441\u0432\u0430\u044e \u0433\u0430\u043b\u0430\u0432\u0443, \u044f\u043a\u0430\u044f \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u0435 \u0434\u0440\u044b\u0436\u044d\u0446\u044c \u0443\u043b\u0430\u0434\u044b \u0456 \u043d\u0430\u0440\u043e\u0434\u044b, \u0443\u0441\u043a\u043b\u0430\u045e \u043a\u0430\u043b\u044e\u0447\u044b\u044f \u0446\u0435\u0440\u043d\u0456; \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0430\u0441\u0443\u0434\u0437\u0456\u045e \u043d\u0430 \u0437\u043d\u044f\u0432\u0430\u0433\u0456 \u0456 \u0433\u0430\u043d\u044c\u0431\u0430\u0432\u0430\u043d\u043d\u0435, \u0430 \u043f\u043e\u0442\u044b\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u045e \u043a\u0440\u044b\u0436, \u0446\u0432\u0456\u043a\u0456, \u0434\u0437\u0456\u0434\u0443, \u0436\u043e\u045e\u0446\u044c \u0456 \u0432\u043e\u0446\u0430\u0442, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0432\u0430 \u045e\u0441\u0456\u043c \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u043f\u0430\u043a\u043e\u0440\u0443 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u044f\u043a \u044f\u0433\u043d\u044f, \u042f\u0433\u043e \u043f\u0430\u0432\u044f\u043b\u0456 \u043d\u0430 \u0437\u0430\u0431\u043e\u0439; \u0456 \u044f\u043a \u0430\u0432\u0435\u0447\u043a\u0430 \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0441\u0442\u0440\u044b\u0436\u044d \u044f\u0435, \u0401\u043d \u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u045e \u0432\u0443\u0441\u043d\u0430\u045e \u0441\u0432\u0430\u0456\u0445 (\u043f\u0430\u0440. \u0406\u0441 53, 7).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0447\u0443\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0433\u043e\u043b\u0430\u0441, \u043f\u043e\u045e\u043d\u044b \u0441\u043b\u043e\u0434\u044b\u0447\u044b, \u043f\u043e\u045e\u043d\u044b \u043b\u044e\u0431\u043e\u0432\u0456, \u043f\u043e\u045e\u043d\u044b \u043d\u044f\u0437\u043c\u0435\u043d\u043d\u0430\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u044e: &laquo;\u041e\u0439\u0447\u0430, \u043f\u0440\u0430\u0431\u0430\u0447 \u0456\u043c&raquo;, \u0430\u0434\u0440\u0430\u0437\u0443 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u044b\u043c \u043f\u0430\u0447\u0443\u0446\u0446\u0451\u043c \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e. &laquo;\u041e\u0439\u0447\u0430, &ndash; \u0441\u043a\u0430\u0437\u0430\u045e \u0415\u0437\u0443\u0441, &ndash; \u043f\u0440\u0430\u0431\u0430\u0447 \u0456\u043c&raquo; (\u041b\u043a 23, 34). \u0426\u0456 \u043c\u043e\u0436\u043d\u0430 \u0434\u0430\u0434\u0430\u0446\u044c \u044f\u0448\u0447\u044d \u043d\u0435\u0448\u0442\u0430 \u0434\u0430 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456 \u0433\u044d\u0442\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u0401\u043d \u0434\u0430\u0434\u0430\u045e. \u042f\u043c\u0443 \u0431\u044b\u043b\u043e \u043d\u0435\u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u0401\u043d \u0445\u0430\u0446\u0435\u045e \u044f\u0448\u0447\u044d \u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u044b\u0446\u044c: &laquo;\u041e\u0439\u0447\u0430, \u043f\u0440\u0430\u0431\u0430\u0447 \u0456\u043c, \u0431\u043e \u044f\u043d\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0440\u043e\u0431\u044f\u0446\u044c&raquo;. \u042f\u043d\u044b \u0447\u044b\u043d\u044f\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0456 \u0433\u0440\u044d\u0445, \u0430\u043b\u0435 \u043c\u0430\u043b\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0446\u044c, \u0442\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: &laquo;\u041e\u0439\u0447\u0430, \u043f\u0440\u0430\u0431\u0430\u0447 \u0456\u043c&raquo;. \u042f\u043d\u044b \u045e\u043a\u0440\u044b\u0436\u043e\u045e\u0432\u0430\u044e\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u043a\u0430\u0433\u043e, \u0431\u043e, &laquo;\u043a\u0430\u043b\u0456 \u0431 \u0432\u0435\u0434\u0430\u043b\u0456, \u043d\u0456\u043a\u043e\u043b\u0456 \u0431 \u043d\u0435 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043b\u0456 \u041f\u0430\u043d\u0430 \u0445\u0432\u0430\u043b\u044b&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 2, 8). \u0422\u0430\u043c\u0443 \u0433\u0443\u0447\u044b\u0446\u044c: &laquo;\u041e\u0439\u0447\u0430, \u043f\u0440\u0430\u0431\u0430\u0447 \u0456\u043c&raquo;. \u042f\u043d\u044b \u043b\u0456\u0447\u0430\u0446\u044c \u0415\u0437\u0443\u0441\u0430 \u043f\u0430\u0440\u0443\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0417\u0430\u043a\u043e\u043d\u0443; \u043b\u0456\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u0401\u043d \u043f\u0440\u044b\u0441\u0432\u043e\u0456\u045e \u0441\u0430\u0431\u0435 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044c; \u043b\u0456\u0447\u0430\u0446\u044c \u042f\u0433\u043e \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u043d\u0430\u0440\u043e\u0434\u0443. \u0415\u0437\u0443\u0441 \u0441\u0445\u0430\u0432\u0430\u045e \u0430\u0434 \u0456\u0445 \u0441\u0432\u0430\u0451 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u0456 \u044f\u043d\u044b \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u042f\u0433\u043e\u043d\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b, \u0442\u0430\u043c\u0443 &laquo;\u041e\u0439\u0447\u0430, \u043f\u0440\u0430\u0431\u0430\u0447 \u0456\u043c, \u0431\u043e \u044f\u043d\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0440\u043e\u0431\u044f\u0446\u044c&raquo; (\u041b\u043a 23, 34).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0445\u043e\u0447\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u0451\u043d \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u043d\u0456\u044f\u043a\u0430\u0439 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439 \u043f\u0430\u0446\u0435\u0445\u0430\u0439. \u0410 \u043a\u0430\u0431 \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439 \u043f\u0430\u0436\u0430\u0434\u043bi\u0432\u0430\u0441\u0446\u0456, \u0451\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0443\u0441\u0435 \u0441\u0432\u0430\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0456 \u0434\u0430 \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u041f\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0446\u0435\u043b\u0430. \u0410\u043b\u0435, \u043a\u0430\u0431 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0439 \u0430\u0441\u0430\u043b\u043e\u0434\u044b \u0430\u0434 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0442\u0440\u044d\u0431\u0430 \u0430\u0445\u0430\u043f\u0456\u0446\u044c \u0430\u0431\u0434\u044b\u043c\u043a\u0430\u043c\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u043e\u0440\u0430\u0433\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u0431 \u0433\u044d\u0442\u044b \u0431\u043e\u0441\u043a\u0456 \u0430\u0433\u043e\u043d\u044c \u043d\u0435 \u0430\u0441\u0442\u044b\u045e \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0442\u0440\u044d\u0431\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u0435\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u0440\u043e\u0437\u0443\u043c\u0443 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0443\u044e \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 53, 12b; \u041b\u043a 23, 34<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0456 \u0431\u044b\u045e \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u044b \u0434\u0430 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0441\u0430\u043c \u043f\u0430\u043d\u0451\u0441 \u0433\u0440\u0430\u0445\u0456 \u043c\u043d\u043e\u0433\u0456\u0445 \u0456 \u0441\u0442\u0430\u045e \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430\u043c \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0415\u0437\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e: \u041e\u0439\u0447\u0430, \u043f\u0440\u0430\u0431\u0430\u0447 \u0456\u043c, \u0431\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0440\u043e\u0431\u044f\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0441\u0430\u043c \u043f\u0430\u043d\u0451\u0441 \u0433\u0440\u0430\u0445\u0456 \u043c\u043d\u043e\u0433\u0456\u0445 \u0456 \u0441\u0442\u0430\u045e \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430\u043c \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e.<\/p>\r\n"}, {"GCH_CH_2_ID":"517","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u043c \u0441\u0432\u0435\u0446\u0435 &laquo;Gaudium et spes&raquo;\u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 9-10)<\/span><br \/><span style=\"color: #ff0000;\">\u0424\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u044f \u043f\u044b\u0442\u0430\u043d\u043d\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f\u0448\u043d\u0456 \u0441\u0432\u0435\u0442 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u043c \u0456 \u0441\u043b\u0430\u0431\u044b\u043c, \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c \u0434\u0430 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u0433\u0430 \u0456 \u043d\u0430\u0439\u0433\u043e\u0440\u0448\u0430\u0433\u0430, \u0443 \u0442\u043e\u0439 \u0447\u0430\u0441 \u044f\u043a \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0440\u0430\u0441\u043f\u0430\u0441\u0446\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u0448\u043b\u044f\u0445 \u0434\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u044b \u0456 \u043d\u044f\u0432\u043e\u043b\u0456, \u0434\u0430 \u043f\u0440\u0430\u0433\u0440\u044d\u0441\u0443 \u0456 \u0440\u044d\u0433\u0440\u044d\u0441\u0443, \u0434\u0430 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u0442\u0432\u0430 \u0456 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u0456. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u0447\u044b\u043d\u0430\u0435 \u045e\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u0446\u044c, \u0448\u0442\u043e \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043d\u044b \u043d\u0430\u043b\u0435\u0436\u043d\u0430 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0441\u0456\u043b\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0441\u0430\u043c \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0456 \u044f\u043a\u0456\u044f \u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0446\u044c \u044f\u0433\u043e \u0430\u0431\u043e \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u044f\u043c\u0443. \u0422\u0430\u043c\u0443 \u0451\u043d \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0441\u0430\u0431\u043e\u0439 \u043f\u044b\u0442\u0430\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0441\u0430\u043c\u0440\u044d\u0447, \u0440\u0430\u0437\u043b\u0430\u0434, \u0430\u0434 \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u043a\u0443\u0442\u0443\u0435 \u0441\u0443\u0447\u0430\u0441\u043d\u044b \u0441\u0432\u0435\u0442, \u0437\u0432\u044f\u0437\u0430\u043d\u044b \u0437 \u0431\u043e\u043b\u044c\u0448 \u0433\u043b\u044b\u0431\u043e\u043a\u0456\u043c \u0440\u0430\u0437\u043b\u0430\u0434\u0430\u043c, \u044f\u043a\u0456 \u043a\u0430\u0440\u0430\u043d\u0456\u0446\u0446\u0430 \u045e \u0441\u044d\u0440\u0446\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0423 \u0441\u0430\u043c\u0456\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0437\u043c\u0430\u0433\u0430\u044e\u0446\u0446\u0430 \u0440\u043e\u0437\u043d\u044b\u044f \u0441\u0442\u044b\u0445\u0456\u0456. \u0417 \u0430\u0434\u043d\u0430\u0433\u043e \u0431\u043e\u043a\u0443, \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c, \u0451\u043d \u0437\u0430\u0437\u043d\u0430\u0435 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0430\u0431\u043c\u0435\u0436\u0430\u0432\u0430\u043d\u043d\u0456, \u0430 \u0437 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0431\u043e\u043a\u0443, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c \u0443 \u0441\u0432\u0430\u0456\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u0445 \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u043c \u0434\u0430 \u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u041f\u0440\u044b\u0432\u0430\u0431\u043b\u0435\u043d\u044b \u043c\u043d\u043e\u0433\u0456\u043c\u0456 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044f\u043c\u0456, \u0451\u043d \u0443\u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u0432\u044b\u043c\u0443\u0448\u0430\u043d\u044b \u0432\u044b\u0431\u0456\u0440\u0430\u0446\u044c \u043f\u0430\u043c\u0456\u0436 \u0456\u043c\u0456 \u0456 \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u0446\u0446\u0430 \u0430\u0434 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445 \u0437 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u043c \u043d\u0435 \u043c\u0435\u043d\u0448, \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u043b\u0430\u0431\u044b\u043c \u0456 \u0433\u0440\u044d\u0448\u043d\u044b\u043c, \u0451\u043d \u043d\u044f\u0440\u044d\u0434\u043a\u0430 \u0440\u043e\u0431\u0456\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0445\u043e\u0447\u0430, \u0456 \u043d\u0435 \u0440\u043e\u0431\u0456\u0446\u044c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u0437\u0440\u0430\u0431\u0456\u0446\u044c. \u0422\u0430\u043c\u0443 \u0451\u043d \u043f\u0430\u043a\u0443\u0442\u0443\u0435 \u0430\u0434 \u0443\u043d\u0443\u0442\u0440\u0430\u043d\u0430\u0433\u0430 \u0440\u0430\u0437\u043b\u0430\u0434\u0443, \u044f\u043ai \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u044f\u0437\u0433\u043e\u0434\u044b \u045e \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u0442\u0432\u0435. \u0412\u0435\u043b\u044c\u043c\u0456 \u043c\u043d\u043e\u0433\u0456\u044f \u043b\u044e\u0434\u0437\u0456, \u0436\u044b\u0446\u0446\u0451 \u044f\u043a\u0456\u0445 \u0437\u0430\u0440\u0430\u0436\u0430\u043d\u0430 \u043f\u0440\u0430\u043a\u0442\u044b\u0447\u043d\u044b\u043c \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u0456\u0437\u043c\u0430\u043c, \u043d\u0435 \u0445\u043e\u0447\u0443\u0446\u044c \u044f\u0441\u043d\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0434\u0440\u0430\u043c\u0430\u0442\u044b\u0437\u043c \u0442\u0430\u043a\u043e\u0439 \u0441\u0456\u0442\u0443\u0430\u0446\u044b\u0456, \u0430 \u043b\u044e\u0434\u0437\u044f\u043c, \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u0433\u0430\u043b\u0435\u0447\u0430\u0439, \u0441\u043a\u043b\u0430\u0434\u0430\u043d\u0430 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c. \u041c\u043d\u043e\u0433\u0456\u044f \u043b\u0456\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0443 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u0445 \u043f\u0440\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043d\u044b\u0445 \u0456\u043c \u0442\u043b\u0443\u043c\u0430\u0447\u044d\u043d\u043d\u044f\u0445 \u0441\u0432\u0435\u0442\u0443. \u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0456 \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0440\u043e\u0434\u0443 \u044f\u0433\u043e \u045e\u043b\u0430\u0441\u043d\u044b\u043c\u0456 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u043c\u0456. \u042f\u043d\u044b \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b\u044f, \u0448\u0442\u043e \u0431\u0443\u0434\u0443\u0447\u0430\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u0439 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0443\u0441\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430. \u0425\u0430\u043f\u0430\u0435 \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0440\u0430\u0441\u0447\u0430\u0440\u0430\u0432\u0430\u045e\u0441\u044f \u045e \u0441\u044d\u043d\u0441\u0435 \u0436\u044b\u0446\u0446\u044f, \u0430 \u0442\u0430\u043c\u0443 \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u0441\u043c\u0435\u043b\u0430\u0441\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u0456\u0447\u044b\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u043c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u044f \u0456 \u0441\u043f\u0440\u0430\u0431\u0443\u0435 \u043d\u0430\u0434\u0430\u0446\u044c \u044f\u043c\u0443 \u045e\u0441\u044e \u043f\u0430\u045e\u043d\u0430\u0442\u0443 \u0441\u044d\u043d\u0441\u0443, \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430 \u0441\u0432\u043e\u0439 \u0440\u043e\u0437\u0443\u043c. \u0422\u044b\u043c \u043d\u0435 \u043c\u0435\u043d\u0448, \u0443 \u0441\u0443\u0432\u044f\u0437\u0456 \u0437 \u0441\u0443\u0447\u0430\u0441\u043d\u0430\u0439 \u044d\u0432\u0430\u043b\u044e\u0446\u044b\u044f\u0439 \u0441\u0432\u0435\u0442\u0443 \u0437 \u043a\u043e\u0436\u043d\u044b\u043c \u0434\u043d\u0451\u043c \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u045e\u0441\u0451 \u0431\u043e\u043b\u044c\u0448 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0430\u0434\u0430\u0435 \u0441\u0430\u043c\u044b\u044f \u0433\u043b\u044b\u0431\u043e\u043a\u0456\u044f \u043f\u044b\u0442\u0430\u043d\u043d\u0456 \u0430\u0431\u043e \u0437 \u043d\u043e\u0432\u0430\u0439 \u0432\u0430\u0441\u0442\u0440\u044b\u043d\u0451\u0439 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435: \u0447\u044b\u043c \u0451\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0441\u044d\u043d\u0441 \u043c\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435, \u0437\u043b\u043e, \u0441\u043c\u0435\u0440\u0446\u044c, \u044f\u043a\u0456\u044f \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0456\u0441\u043d\u0443\u044e\u0446\u044c, \u0445\u043e\u0446\u044c \u0430\u0434\u0431\u044b\u045e\u0441\u044f \u0442\u0430\u043a\u0456 \u043f\u0440\u0430\u0433\u0440\u044d\u0441? \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0433\u044d\u0442\u044b\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456, \u043d\u0430\u0431\u044b\u0442\u044b\u044f \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0446\u0430\u043d\u043e\u044e? \u0428\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043c\u043e\u0436\u0430 \u0434\u0430\u0446\u044c \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u0442\u0432\u0443, \u0430 \u0447\u0430\u0433\u043e \u043c\u043e\u0436\u0430 \u0430\u0434 \u044f\u0433\u043e \u0447\u0430\u043a\u0430\u0446\u044c? \u0428\u0442\u043e \u0430\u0434\u0431\u0443\u0434\u0437\u0435\u0446\u0446\u0430 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0436\u044b\u0446\u0446\u044f?<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0441\u0446\u0451\u043b \u0432\u0435\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0456\u0445 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u043c\u043e\u0436\u0430 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u0434\u0430\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u0441\u0456\u043b\u044b, \u043a\u0430\u0431 \u0451\u043d \u0437\u0434\u043e\u043b\u0435\u045e \u0430\u0434\u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0430 \u0441\u0432\u0430\u0451 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435. \u041a\u0430\u0441\u0446\u0451\u043b \u0432\u0435\u0440\u044b\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u043b\u044e\u0434\u0437\u044f\u043c \u043d\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u0456\u043c\u0435\u043d\u0456 \u043f\u0430\u0434 \u043d\u0435\u0431\u0430\u043c, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0435 \u044f\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u043b\u0456 \u0431 \u0437\u0431\u0430\u0432\u0456\u0446\u0446\u0430. \u041f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u041a\u0430\u0441\u0446\u0451\u043b \u0432\u0435\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u043a\u043b\u044e\u0447, \u0446\u044d\u043d\u0442\u0440 \u0456 \u043a\u0430\u043d\u0435\u0446 \u0443\u0441\u0451\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u044f\u0433\u043e \u041f\u0430\u043d\u0443 \u0456 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0443. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u041a\u0430\u0441\u0446\u0451\u043b \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435, \u0448\u0442\u043e \u045e \u0430\u0441\u043d\u043e\u0432\u0435 \u045e\u0441\u0456\u0445 \u0437\u043c\u0435\u043d \u043b\u044f\u0436\u044b\u0446\u044c \u0448\u043c\u0430\u0442 \u043d\u044f\u0437\u043c\u0435\u043d\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u0430\u044e\u0446\u044c \u0441\u0432\u043e\u0439 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u044b \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u044f\u043a\u0456 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u045e\u0447\u043e\u0440\u0430, \u0441\u0451\u043d\u043d\u044f \u0456 \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 15, 55-56a. 57; \u041f\u043b 3, 25<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> C\u043c\u0435\u0440\u0446\u044c, \u0434\u0437\u0435 \u0442\u0432\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430? \u0421\u043c\u0435\u0440\u0446\u044c, \u0434\u0437\u0435 \u0442\u0432\u0430\u0451 \u0434\u0436\u0430\u043b\u0430? \u0414\u0436\u0430\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 &ndash; \u0433\u0440\u044d\u0445. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e\u0433\u0443 &ndash; \u043f\u0430\u0434\u0437\u044f\u043a\u0430, \u0431\u043e \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0434\u043e\u0431\u0440\u044b \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430; \u0434\u0430 \u0434\u0443\u0448\u044b, \u0448\u0442\u043e \u042f\u0433\u043e \u0448\u0443\u043a\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433\u0443 &ndash; \u043f\u0430\u0434\u0437\u044f\u043a\u0430, \u0431\u043e \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"521","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 51, 3-4. 8: PL 54, 310-311. 313)<\/span><br \/><span style=\"color: #ff0000;\">\u0417\u0430\u043a\u043e\u043d \u0431\u044b\u045e \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043f\u0440\u0430\u0437 \u041c\u0430\u0439\u0441\u0435\u044f, \u0430 \u043b\u0430\u0441\u043a\u0430 \u0456 \u043f\u0440\u0430\u045e\u0434\u0430 \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0430\u0434\u043a\u0440\u044b\u045e \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c\u0456 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456 \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443 \u0456 \u0442\u0443\u044e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0443\u044e \u0437 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u043c\u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u0443\u044e \u0444\u043e\u0440\u043c\u0443 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u0442\u0430\u043a\u0456\u043c \u0431\u043b\u044f\u0441\u043a\u0430\u043c, \u0448\u0442\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u042f\u0433\u043e\u043d\u0430\u0435 \u0441\u0442\u0430\u043b\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u0431\u043b\u044f\u0441\u043a\u0443 \u0441\u043e\u043d\u0446\u0430, \u0430 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0430 \u0441\u0442\u0430\u043b\u0430 \u044f\u043a \u0441\u043d\u0435\u0436\u043d\u0430\u044f \u0431\u0435\u043b\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u0435 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0435\u043d\u043d\u0435, \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u043c\u0435\u043b\u0430 \u043d\u0430 \u043c\u044d\u0446\u0435 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u0441\u043f\u0430\u043a\u0443\u0441\u0443 \u043a\u0440\u044b\u0436\u0430 \u0456 \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435 \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u0439 \u043c\u0443\u043a\u0456 \u043d\u0435 \u0437\u0430\u0446\u044c\u043c\u0456\u043b\u0430 \u0432\u0435\u0440\u044b \u0442\u044b\u043c, \u043a\u0430\u043c\u0443 \u0431\u044b\u043b\u0430 \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0432\u0435\u043b\u0456\u0447 \u0443\u043a\u0440\u044b\u0442\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0442\u0430\u043a\u043e\u0439 \u0436\u0430 \u0430\u0431\u0430\u0447\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0431\u044b\u043b\u0430 \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u0430\u044f \u043d\u0430\u0434\u0437\u0435\u044f \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043a\u0430\u0431 \u0443\u0441\u0451 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430 \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0430\u0441\u044f, \u044f\u043a\u043e\u0439 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0430\u0439 \u044f\u043d\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0430\u0434\u043e\u0440\u0430\u043d\u0430, \u0456 \u043a\u0430\u0431 \u0443\u0441\u0435 \u044f\u0433\u043e \u0447\u0430\u0441\u0442\u043a\u0456 \u043c\u0430\u0433\u043b\u0456 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u045e\u0434\u0437\u0435\u043b \u0443 \u0445\u0432\u0430\u043b\u0435, \u044f\u043a\u0430\u044f \u043d\u0430\u0439\u043f\u0435\u0440\u0448 \u0430\u0437\u0434\u043e\u0431\u0456\u043b\u0430 \u0413\u0430\u043b\u0430\u0432\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0430\u043c \u041f\u0430\u043d, \u043a\u0430\u043b\u0456 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u043f\u0440\u0430 \u0441\u0432\u0430\u0451 \u0432\u0435\u043b\u0456\u0447\u043d\u0430\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435: &laquo;\u0422\u0430\u0434\u044b \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0456 \u0437\u0430\u0437\u0437\u044f\u044e\u0446\u044c, \u044f\u043a \u0441\u043e\u043d\u0446\u0430, \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u0456\u0445 \u0410\u0439\u0446\u0430&raquo; (\u041c\u0446 13, 43). \u0422\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0456 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0414\u0443\u043c\u0430\u044e, \u0448\u0442\u043e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0433\u0430 \u0447\u0430\u0441\u0443 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f \u0442\u043e\u0439 \u0441\u043b\u0430\u0432\u044b, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0432\u044b\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441&raquo; (\u0420\u044b\u043c 8, 18). \u0406 \u0437\u043d\u043e\u045e: &laquo;\u0412\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0456 \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u0411\u043e\u0433\u0443. \u041a\u0430\u043b\u0456 \u0436 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435, \u0442\u0430\u0434\u044b \u0456 \u0432\u044b \u0437&rsquo;\u044f\u0432\u0456\u0446\u0435\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443 \u0445\u0432\u0430\u043b\u0435&raquo; (\u041a\u043b\u0441 3, 3. 4).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0443 \u0432\u0435\u0440\u044b \u0456 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u0446\u044c \u0456\u0445 \u0434\u0430 \u045e\u0441\u0456\u0445 \u0432\u0435\u0434\u0430\u045e, \u0443 \u0433\u044d\u0442\u044b\u043c \u0446\u0443\u0434\u0437\u0435 \u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u044f\u0448\u0447\u044d \u0430\u0434\u043d\u043e \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0406\u043b\u043b\u044f, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0417\u0430\u043a\u043e\u043d \u0456 \u041f\u0440\u0430\u0440\u043e\u043a\u0456, \u0437&rsquo;\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u0456 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u043b\u0456 \u0437 \u041f\u0430\u043d\u0430\u043c, \u043a\u0430\u0431 \u044f\u043a \u043c\u0430\u0433\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0435\u0439 \u0443 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0433\u044d\u0442\u044b\u0445 \u043f\u0435\u0446\u044f\u0440\u044b\u0445 \u043c\u0443\u0436\u043e\u045e \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0435: &laquo;\u041a\u0430\u0431 \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0434\u0432\u0443\u0445 \u0446\u0456 \u0442\u0440\u043e\u0445 \u0441\u0432\u0435\u0434\u043a\u0430\u045e \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u043a\u043e\u0436\u043d\u0430\u0435 \u0441\u043b\u043e\u0432\u0430&raquo; (\u041c\u0446 18, 16).<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0442\u0440\u044b\u0432\u0430\u043b\u044b\u043c \u0456 \u043c\u043e\u0446\u043d\u044b\u043c \u0437\u0430 \u0441\u043b\u043e\u0432\u0430, \u0443 \u043f\u0440\u043e\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u044f\u043a\u043e\u0433\u0430 \u0441\u0443\u0433\u0443\u0447\u043d\u0430 \u0433\u0440\u0430\u044e\u0446\u044c \u0442\u0440\u0443\u0431\u044b \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0456 \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0430 \u0437 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u043c \u0432\u0443\u0447\u044d\u043d\u043d\u0435\u043c \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0447\u0430\u044e\u0446\u044c \u0434\u043e\u0432\u0430\u0434\u044b \u0434\u0430\u045e\u043d\u0456\u0445 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f\u045e?<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u0440\u043e\u043d\u043a\u0456 \u0430\u0431\u043e\u0434\u0432\u0443\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0430\u045e \u0441\u0432\u0435\u0434\u0447\u0430\u0446\u044c \u0430\u0434\u043d\u0430 \u0437\u0430 \u0430\u0434\u043d\u0443; \u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u044f \u0437\u043d\u0430\u043a\u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u043f\u0430\u0434 \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u043c \u0442\u0430\u044f\u043c\u043d\u0456\u0447\u0430\u0441\u0446\u0456, \u0431\u043b\u044f\u0441\u043a \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0439 \u0441\u043b\u0430\u0432\u044b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0456 \u044f\u045e\u043d\u0430. \u042f\u043a \u043a\u0430\u0437\u0430\u045e \u0441\u0432. \u042f\u043d: &laquo;\u0417\u0430\u043a\u043e\u043d \u0431\u044b\u045e \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043f\u0440\u0430\u0437 \u041c\u0430\u0439\u0441\u0435\u044f, \u0430 \u043b\u0430\u0441\u043a\u0430 \u0456 \u043f\u0440\u0430\u045e\u0434\u0430 \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430&raquo; (\u042f\u043d 1, 17). \u0423 \u0406\u043c \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435, \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u0430\u0435 \u045e \u043f\u0440\u0430\u0440\u043e\u0446\u043a\u0456\u0445 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u0445; \u0456 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u045e\u0441\u0451 \u0442\u043e\u0435, \u0434\u0430 \u0447\u0430\u0433\u043e \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430\u043a\u0430\u0437\u044b \u041f\u0430\u043d\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0401\u043d \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430, \u0430 \u0441\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0430\u0439 \u0440\u043e\u0431\u0456\u0446\u044c \u043c\u0430\u0433\u0447\u044b\u043c\u044b\u043c \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u0437 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0434\u043c\u0430\u0446\u0443\u0435\u0446\u0446\u0430 \u0432\u0435\u0440\u0430 \u045e\u0441\u0456\u0445, \u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0441\u0430\u0440\u043e\u043c\u0435\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u043a\u0440\u044b\u0436\u0430, \u044f\u043a\u0456\u043c \u0431\u044b\u045e \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b \u0441\u0432\u0435\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0431\u0430\u0456\u0446\u0446\u0430 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u043d\u0435 \u0433\u0443\u0431\u043b\u044f\u0435 \u043d\u0430\u0434\u0437\u0435\u0456 \u043d\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443, \u0431\u043e \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0446\u0443 \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443 \u0456 \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0430 \u0436\u044b\u0446\u0446\u044f. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u045e\u0441\u044e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u0439 \u043d\u044f\u0434\u043e\u043b\u0456, \u043c\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u043f\u0435\u0440\u0430\u043c\u043e\u0433, \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c \u0443\u0441\u0451, \u0448\u0442\u043e \u043d\u0430\u043c \u0430\u0431\u044f\u0446\u0430\u045e, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0442\u0440\u044b\u0432\u0430\u043b\u0430 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0456 \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u043a\u0430\u043b\u0456 \u0446\u0435\u0440\u043f\u0456\u043c \u043d\u044f\u0433\u043e\u0434\u044b, \u0443 \u043d\u0430\u0448\u044b\u0445 \u0432\u0443\u0448\u0430\u0445 \u0437\u0430\u045e\u0436\u0434\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0433\u0443\u0447\u0430\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u0410\u0439\u0446\u0430: &laquo;\u0413\u044d\u0442\u0430 \u0421\u044b\u043d \u041c\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u044f\u043a\u043e\u0433\u0430 \u042f \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e. \u042f\u0433\u043e \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435&raquo; (\u041c\u0446 17, 5).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0431\u0440 12, 22\u0430. 24\u0430. 25; \u041f\u0441 95 (94), 8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u0436 \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u0434\u0430 \u0415\u0437\u0443\u0441\u0430, \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430 \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443. \u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u043d\u0435 \u0430\u0434\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u0439\u0446\u0435\u0441\u044f. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0430\u0437\u0431\u0435\u0433\u043b\u0456 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0434\u044b\u043a \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043c\u044b, \u043a\u0430\u043b\u0456 \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0451\u043d\u043d\u044f \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0437 \u043d\u0435\u0431\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041e, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u0441\u0451\u043d\u043d\u044f \u042f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0441: \u041d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c\u0456 \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0430\u0437\u0431\u0435\u0433\u043b\u0456 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u0430\u0434\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0434\u044b\u043a \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043c\u044b, \u043a\u0430\u043b\u0456 \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0451\u043d\u043d\u044f \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0437 \u043d\u0435\u0431\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"522","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0442\u044d\u0445\u0435\u0437\u0430 \u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cat. 3, 24-27: SC 50, 165-167)<\/span><br \/><span style=\"color: #ff0000;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0413\u0430\u0431\u0440\u044d\u0456 \u0431\u0430\u0447\u044b\u043b\u0456 \u0446\u0443\u0434\u044b, \u0456 \u0442\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0431\u0430\u0447\u044b\u0448, \u0456 \u0431\u043e\u043b\u044c\u0448 \u0432\u0435\u043b\u0456\u0447\u043d\u044b\u044f \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f, \u0447\u044b\u043c \u0433\u0430\u0431\u0440\u044d\u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u0432\u044b\u0439\u0441\u0446\u044f \u0437 \u0415\u0433\u0456\u043f\u0442\u0430. \u0422\u044b \u043d\u0435 \u0431\u0430\u0447\u044b\u045e \u0444\u0430\u0440\u0430\u043e\u043d\u0430 \u0456 \u044f\u0433\u043e \u043f\u0430\u0442\u043e\u043f\u043b\u0435\u043d\u044b\u044f \u0432\u043e\u0439\u0441\u043a\u0456, \u0430\u043b\u0435 \u0431\u0430\u0447\u044b\u045e \u0434&rsquo;\u044f\u0431\u043b\u0430, \u043a\u0456\u043d\u0443\u0442\u0430\u0433\u0430 \u045e \u0432\u0456\u0440 \u0440\u0430\u0437\u0430\u043c \u0437 \u044f\u0433\u043e\u043d\u044b\u043c\u0456 \u0432\u043e\u0439\u0441\u043a\u0430\u043c\u0456. \u0421\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0456 \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0435 \u043c\u043e\u0440\u0430, \u0442\u044b \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e \u0441\u043c\u0435\u0440\u0446\u044c. \u042f\u043d\u044b \u0431\u044b\u043b\u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u0430\u0434 \u0415\u0433\u0456\u043f\u0442\u0430, \u0442\u044b &ndash; \u0430\u0434 \u0434\u044d\u043c\u0430\u043d\u0430\u045e. \u0413\u0430\u0431\u0440\u044d\u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u0440\u0430\u0431\u0441\u043a\u0430\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u043c, \u0442\u044b &ndash; \u043d\u0430\u0448\u043c\u0430\u0442 \u0431\u043e\u043b\u044c\u0448 \u0441\u0443\u043c\u043d\u0430\u0435 \u0440\u0430\u0431\u0441\u0442\u0432\u0430 \u0433\u0440\u0430\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u0445\u043e\u0447\u0430\u0448 \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430, \u0447\u0430\u043c\u0443 \u0442\u044b \u045e\u0448\u0430\u043d\u0430\u0432\u0430\u043d\u044b \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u044b\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456? \u0413\u0430\u0431\u0440\u044d\u0456 \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0442\u0430\u0434\u044b \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u0443\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u0442\u0432\u0430\u0440 \u041c\u0430\u0439\u0441\u0435\u044f, \u044f\u043a\u0456 \u0430\u0434\u043d\u0430\u043a \u0431\u044b\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0456 \u043d\u0430\u043b\u0435\u0436\u0430\u045e \u0434\u0430 \u0456\u0445\u043d\u044f\u0433\u0430 \u0440\u043e\u0434\u0443, \u0430 \u0442\u044b \u0431\u0430\u0447\u044b\u045e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u045e \u0441\u043b\u0430\u0432\u0435 \u042f\u0433\u043e\u043d\u0430\u0439. \u0422\u0430\u043c\u0443 \u041f\u0430\u0432\u0435\u043b \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041c\u044b \u0437 \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u043c \u0442\u0432\u0430\u0440\u0430\u043c \u045e\u0433\u043b\u044f\u0434\u0430\u0435\u043c\u0441\u044f \u045e \u0441\u043b\u0430\u0432\u0443 \u041f\u0430\u043d\u0430&raquo; (\u043f\u0430\u0440. 2 \u041a\u0430\u0440 3, 18).<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0437\u0430\u043c \u0437 \u0433\u0430\u0431\u0440\u044d\u044f\u043c\u0456 \u0456\u0448\u043e\u045e \u0442\u0430\u0434\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430\u0434\u043d\u0430\u043a \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430 \u0401\u043d \u0456\u0434\u0437\u0435 \u0446\u044f\u043f\u0435\u0440 \u0437 \u043d\u0430\u043c\u0456; \u0431\u043e \u0442\u0430\u0434\u044b \u041f\u0430\u043d \u0441\u0443\u043f\u0440\u0430\u0432\u0430\u0434\u0436\u0430\u045e \u0456\u0445 \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443, \u0434\u0430\u0434\u0437\u0435\u043d\u0443\u044e \u041c\u0430\u0439\u0441\u0435\u044e, \u0430 \u0446\u044f\u043f\u0435\u0440 \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u0435 \u043d\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u041c\u0430\u0439\u0441\u0435\u044f, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0430\u0448\u0430\u0439 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456. \u041f\u0430\u0441\u043b\u044f \u0432\u044b\u0439\u0441\u0446\u044f \u0437 \u0415\u0433\u0456\u043f\u0442\u0430 \u044f\u043d\u044b \u0430\u043f\u044b\u043d\u0443\u043b\u0456\u0441\u044f \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0430 \u0446\u044f\u0431\u0435 \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u0447\u0430\u043a\u0430\u0435 \u043d\u0435\u0431\u0430. \u0412\u044b\u0434\u0430\u0442\u043d\u044b\u043c \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u0456 \u045e\u043b\u0430\u0434\u0430\u0440\u043e\u043c \u0434\u043b\u044f \u0456\u0445 \u0431\u044b\u045e \u041c\u0430\u0439\u0441\u0435\u0439, \u0430 \u0434\u043b\u044f \u043d\u0430\u0441 &ndash; \u0456\u043d\u0448\u044b \u041c\u0430\u0439\u0441\u0435\u0439, \u0441\u0430\u043c \u0411\u043e\u0433, \u041f\u0440\u0430\u0432\u0430\u0434\u044b\u0440 \u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u044b\u043c \u0436\u0430 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u045e\u0441\u044f \u041c\u0430\u0439\u0441\u0435\u0439? \u042f\u043a \u043a\u0430\u0436\u0430 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0433\u044d\u0442\u0430 \u0431\u044b\u045e \u0441\u0430\u043c\u044b \u043b\u0430\u0433\u043e\u0434\u043d\u044b \u0437 \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u0436\u044b\u043b\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 (\u043f\u0430\u0440. \u041b\u0456\u0447 12, 3). \u0413\u044d\u0442\u0443\u044e \u0440\u044b\u0441\u0443 \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u0431\u0435\u0441\u043f\u0430\u043c\u044b\u043b\u043a\u043e\u0432\u0430 \u043f\u0440\u044b\u043f\u0456\u0441\u0430\u0446\u044c \u043d\u0430\u0448\u0430\u043c\u0443 \u041c\u0430\u0439\u0441\u0435\u044e, \u0431\u043e \u0401\u043d \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u0430\u0433\u0430 \u0456 \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u0430\u0434\u0437\u0456\u043d\u0430\u0441\u0443\u0442\u043d\u0430\u0433\u0430 \u0437 \u0406\u043c \u0414\u0443\u0445\u0430. \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0437\u043d\u043e\u0441\u0456\u045e \u0440\u0443\u043a\u0456 \u045e \u043d\u0435\u0431\u0430, \u0430\u0434\u043a\u0443\u043b\u044c \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u045e \u043c\u0430\u043d\u043d\u0443 &ndash; \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0430\u043d\u0451\u043b\u0430\u045e; \u0430 \u043d\u0430\u0448 \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0437\u0434\u044b\u043c\u0430\u0435 \u0440\u0443\u043a\u0456 \u0434\u0430 \u043d\u0435\u0431\u0430 \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043d\u0430\u043c \u0432\u0435\u0447\u043d\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a. \u0422\u043e\u0439 \u041c\u0430\u0439\u0441\u0435\u0439 \u0443\u0434\u0430\u0440\u044b\u045e \u0443 \u0441\u043a\u0430\u043b\u0443 \u0456 \u0430\u0434\u043a\u0440\u044b\u045e \u0441\u0442\u0440\u0443\u043c\u0435\u043d\u044c \u0432\u0430\u0434\u044b; \u0433\u044d\u0442\u044b \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0430\u043b\u0442\u0430\u0440\u0430, \u0431&rsquo;\u0435 \u045e \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0441\u0442\u043e\u043b \u0456 \u0432\u044b\u043f\u0443\u0441\u043a\u0430\u0435 \u0437 \u044f\u0433\u043e \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0414\u0443\u0445\u0430. \u0422\u0430\u043c\u0443 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0442\u0430\u043b\u0430 \u0451\u0441\u0446\u044c \u043d\u0456\u0431\u044b \u043a\u0440\u044b\u043d\u0456\u0446\u0430, \u043a\u0430\u0431 \u0430\u0434\u0443\u0441\u044e\u043b\u044c \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456\u0441\u044f \u0441\u0442\u0430\u0442\u043a\u0456 \u0456 \u0430\u0436\u044b\u045e\u043b\u044f\u043b\u0456\u0441\u044f \u044f\u0435 \u0437\u0431\u0430\u045e\u0447\u044b\u043c\u0456 \u0432\u043e\u0434\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e \u043d\u0430\u0441 \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0430\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0456 \u0442\u0430\u043a\u043e\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0436\u044b\u0446\u0446\u044f, \u0430 \u043d\u0430\u0448 \u0441\u0442\u043e\u043b \u043f\u0435\u0440\u0430\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u043c\u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456 \u0456 \u045e\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u0435 \u043d\u0430\u0441 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456, \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0430 \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435\u043c \u043f\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u044f\u0435, \u043a\u0430\u0431 \u0443 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043b\u0430\u0441\u043a\u0443 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u041b\u0430\u0441\u043a\u0430 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0456 \u0437 \u044f\u043a\u0456\u043c \u0410\u0439\u0446\u0443 \u0456 \u0436\u044b\u0432\u0430\u0442\u0432\u043e\u0440\u043d\u0430\u043c\u0443 \u0414\u0443\u0445\u0443 \u0441\u043b\u0430\u0432\u0430, \u043f\u0430\u0448\u0430\u043d\u0430 \u0456 \u045e\u043b\u0430\u0434\u0430 \u0446\u044f\u043f\u0435\u0440, \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u0456 \u043d\u0430 \u0432\u0435\u0447\u043d\u044b\u044f \u0432\u044f\u043a\u0456. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0431\u0440 11, 24-25. 26. 27<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u0439\u0441\u0435\u0439 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0441\u0442\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c, \u0451\u043d \u043d\u0435 \u0445\u0430\u0446\u0435\u045e, \u043a\u0430\u0431 \u044f\u0433\u043e \u043b\u0456\u0447\u044b\u043b\u0456 \u0441\u044b\u043d\u0430\u043c \u0434\u0430\u0447\u043a\u0456 \u0444\u0430\u0440\u0430\u043e\u043d\u0430; \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0411\u043e\u0436\u044b\u043c, \u0430 \u043d\u0435 \u043c\u0435\u0446\u044c \u0430\u0441\u0430\u043b\u043e\u0434\u0443 \u0430\u0434 \u0447\u0430\u0441\u043e\u0432\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0451\u043d \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041b\u0456\u0447\u044b\u045e \u0431\u043e\u043b\u044c\u0448\u044b\u043c \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c, \u0447\u044b\u043c \u0443\u0441\u0435 \u0441\u043a\u0430\u0440\u0431\u044b \u0415\u0433\u0456\u043f\u0442\u0430, \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u043d\u044f\u0432\u0430\u0433\u0456 \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0415\u0433\u0456\u043f\u0435\u0442.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0451\u043d \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u045e\u0441\u044f \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"523","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 140, 4-6: CCL 40, 2028-2029)<\/span><br \/><span style=\"color: #ff0000;\">\u0426\u044f\u0440\u043f\u0435\u043d\u043d\u0435 \u045e\u0441\u044f\u0433\u043e \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0430\u043d\u0435, \u044f \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u0426\u044f\u0431\u0435, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043c\u044f\u043d\u0435&raquo; (\u043f\u0430\u0440. \u041f\u0441 141 [140], 1). \u0423\u0441\u0435 \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u0433\u044d\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c. \u0413\u044d\u0442\u0430 \u043a\u0430\u0436\u0443 \u043d\u0435 \u044f, \u043a\u0430\u0436\u0430 \u045e\u0432\u0435\u0441\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0410\u043b\u0435 \u045e \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u0433\u044d\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0430\u0434 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439 \u0430\u0441\u043e\u0431\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u043e \u043a\u0430\u043b\u0456 \u0431\u044b\u045e \u0451\u044e, \u043c\u0435\u045e \u0446\u0435\u043b\u0430, \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u044f\u043a \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u044f \u0430\u0441\u043e\u0431\u0430 \u043c\u0430\u043b\u0456\u045e \u0410\u0439\u0446\u0430, \u0430 \u0437 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 \u043f\u0430\u0434\u0430\u043b\u0456 \u043a\u0440\u043e\u043f\u043b\u0456 \u043a\u0440\u044b\u0432\u0456. \u0422\u0430\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456: &laquo;\u0415\u0437\u0443\u0441 \u043d\u0430\u043f\u0440\u0443\u0436\u0430\u043d\u0430 \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0456 \u043f\u0430\u0446\u0435\u045e \u043a\u0440\u044b\u0432\u0451\u044e&raquo; (\u043f\u0430\u0440. \u041b\u043a 22, 44). \u0427\u044b\u043c \u0436\u0430 \u0451\u0441\u0446\u044c \u043f\u0440\u0430\u043b\u0456\u0446\u0446\u0451 \u043a\u0440\u044b\u0432\u0456 \u0437 \u0443\u0441\u044f\u0433\u043e \u0446\u0435\u043b\u0430, \u044f\u043a \u043d\u0435 \u043f\u0430\u043a\u0443\u0442\u0430\u043c\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0443\u0441\u044f\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430?<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0414\u0430 \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u045e, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043c\u044f\u043d\u0435, \u043f\u0430\u0447\u0443\u0439 \u043c\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u043a\u0430\u043b\u0456 \u0426\u044f\u0431\u0435 \u043a\u043b\u0456\u0447\u0443&raquo; (\u043f\u0430\u0440. \u041f\u0441 141 [140], 1). \u0414\u0443\u043c\u0430\u0435\u0448, \u0437\u0430\u043a\u043b\u0456\u043a \u0443\u0436\u043e \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u043d\u044b, \u043a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u0448: &laquo;\u042f \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u0426\u044f\u0431\u0435&raquo;. \u0422\u044b \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u045e, \u0430\u043b\u0435 \u043d\u0435 \u043b\u0456\u0447\u044b, \u0448\u0442\u043e \u0442\u044b \u045e \u0431\u044f\u0441\u043f\u0435\u0446\u044b. \u041a\u0430\u043b\u0456 \u0441\u043a\u043e\u043d\u0447\u044b\u043b\u0430\u0441\u044f \u043d\u044f\u0434\u043e\u043b\u044f, \u0441\u043f\u044b\u043d\u0456\u043b\u0456\u0441\u044f \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0456; \u0430\u0434\u043d\u0430\u043a \u043a\u0430\u043b\u0456 \u045e\u0446\u0456\u0441\u043a \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0456 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u0432\u044f\u043a\u043e\u045e, \u0442\u0440\u044d\u0431\u0430 \u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456: &laquo;\u042f \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u0426\u044f\u0431\u0435, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043c\u044f\u043d\u0435&raquo;, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: &laquo;\u041f\u0430\u0447\u0443\u0439 \u043c\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u043a\u0430\u043b\u0456 \u0426\u044f\u0431\u0435 \u043f\u0430\u043a\u043b\u0456\u0447\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041d\u044f\u0445\u0430\u0439 \u043c\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u045e\u0437\u044b\u0434\u0437\u0435 \u0434\u0430 \u0426\u044f\u0431\u0435, \u043d\u0456\u0431\u044b \u043a\u0430\u0434\u0437\u0456\u043b\u0430, \u0430 \u045e\u0437\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u0440\u0443\u043a \u043c\u0430\u0456\u0445 &ndash; \u043d\u0456\u0431\u044b \u0432\u044f\u0447\u044d\u0440\u043d\u044f\u044f \u0430\u0445\u0432\u044f\u0440\u0430&raquo; (\u041f\u0441 141 [140], 2).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d \u043f\u0440\u044b\u0437\u043d\u0430\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u044b \u0432\u044b\u0440\u0430\u0437 \u0442\u0440\u044d\u0431\u0430 \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0430 \u0441\u0430\u043c\u043e\u0439 \u0413\u0430\u043b\u0430\u0432\u044b. \u0411\u043e \u043a\u0430\u043b\u0456 \u0434\u0437\u0435\u043d\u044c \u0445\u0456\u043b\u0456\u045e\u0441\u044f \u0434\u0430 \u0432\u0435\u0447\u0430\u0440\u0430, \u041f\u0430\u043d \u0430\u0434\u0434\u0430\u045e \u0434\u0443\u0448\u0443 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u044f\u0435. \u0401\u043d \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430 \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456. \u0423 \u043d\u0435\u0439\u043a\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u0456 \u043c\u044b \u0431\u044b\u043b\u0456 \u0442\u0430\u043c, \u0431\u043e \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u0432\u0456\u0441\u0435\u043b\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u041f\u0430\u043d \u0443\u0437\u044f\u045e \u0430\u0434 \u043d\u0430\u0441. \u042f\u043a \u0436\u0430 \u0411\u043e\u0433 \u0410\u0439\u0446\u0435\u0446 \u043c\u043e\u0433 \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u044c \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0451\u0441\u0446\u044c \u0437 \u0406\u043c \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0411\u043e\u0433\u0430\u043c? \u0406 \u045e\u0441\u0451 \u0436, \u043f\u0440\u044b\u0431\u0456\u0432\u0430\u044e\u0447\u044b \u043d\u0430\u0448\u0443 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0434\u0430 \u043a\u0440\u044b\u0436\u0430, \u0434\u0437\u0435 &laquo;\u0431\u044b\u043b\u044b \u043d\u0430\u0448 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0437 \u0406\u043c&raquo; (\u0420\u044b\u043c 6, 6), \u044f\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u0401\u043d \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u045e \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430: &laquo;\u0411\u043e\u0436\u0430, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430, \u0447\u0430\u043c\u0443 \u0422\u044b \u043c\u044f\u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e?&raquo; (\u041f\u0441 22 [21], 1).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0432\u0435\u0447\u0430\u0440\u043e\u0432\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043c\u0443\u043a\u0430 \u041f\u0430\u043d\u0430, \u043a\u0440\u044b\u0436 \u041f\u0430\u043d\u0430, \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u0437\u0431\u0430\u045e\u0447\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u044b, \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0443 \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f. \u041f\u0430\u0434\u0447\u0430\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0433\u044d\u0442\u0430\u044f \u0432\u0435\u0447\u0430\u0440\u043e\u0432\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u043b\u0430\u0441\u044f \u045e \u0440\u0430\u043d\u0456\u0448\u043d\u0456 \u0434\u0430\u0440. \u0422\u0430\u043c\u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u043d\u0430\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430\u044f \u0437 \u0432\u0435\u0440\u043d\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430, \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430, \u044f\u043a \u0434\u044b\u043c \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u0430\u0434 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0430\u043b\u0442\u0430\u0440\u0430. \u041d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0433\u0430 \u0437\u0430 \u0432\u043e\u0434\u0430\u0440 \u041f\u0430\u043d\u0430: \u0442\u0430\u043a \u043f\u0430\u0445\u043d\u0443\u0446\u044c \u0443\u0441\u0435, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u044f\u043a \u043a\u0430\u0436\u0443\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430, &laquo;\u0431\u044b\u043b\u044b \u043d\u0430\u0448 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0437 \u0406\u043c \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0433\u0440\u044d\u0448\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u043d\u0430\u043c \u043d\u0435 \u0431\u044b\u0446\u044c \u0443\u0436\u043e \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0433\u0440\u0430\u0445\u0443&raquo; (\u0420\u044b\u043c 6, 6).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0430\u043b 2, 19. 20<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u045e\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u045e\u0436\u043e \u043d\u0435 \u044f \u0436\u044b\u0432\u0443, \u0430 \u0436\u044b\u0432\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0416\u044b\u0432\u0443 \u0432\u0435\u0440\u0430\u044e \u045e \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u044f\u043a\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043c\u044f\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u045e\u0436\u043e \u043d\u0435 \u044f \u0436\u044b\u0432\u0443, \u0430 \u0436\u044b\u0432\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/p>\r\n"}, {"GCH_CH_2_ID":"524","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u044f\u045e&raquo; \u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 4, 14, 2-3; 15, 1: SC 100, 542. 548)<\/span><br \/><span style=\"color: #ff0000;\">\u0412\u043e\u0431\u0440\u0430\u0437\u044b \u0432\u0443\u0447\u044b\u043b\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0433\u0430 \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u0456 \u045e \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 \u042f\u043c\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0411\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043a\u0430\u0431 \u0448\u0447\u043e\u0434\u0440\u0430 \u0430\u0441\u044b\u043f\u0430\u0446\u044c \u044f\u0433\u043e \u0441\u0432\u0430\u0456\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456. \u0412\u044b\u0431\u0440\u0430\u045e \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0430\u045e \u0434\u0437\u0435\u043b\u044f \u0456\u0445\u043d\u044f\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0417\u0430\u0433\u0430\u0434\u0437\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u045e \u043d\u0430\u0440\u043e\u0434, \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0448\u044b \u043d\u0435\u0432\u0443\u043a\u0430 \u0456\u0441\u0446\u0456 \u0437\u0430 \u0411\u043e\u0433\u0430\u043c. \u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0440\u044b\u0437\u0432\u044b\u0447\u0430\u0456\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0435\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0456 \u043c\u0435\u0446\u044c \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0437 \u0411\u043e\u0433\u0430\u043c. \u041d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b \u043d\u0456\u043a\u043e\u0433\u0430, \u0411\u043e\u0433 \u0434\u0430\u043b\u0443\u0447\u0430\u0435 \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e \u0406\u043c \u043f\u0430\u0442\u0440\u044d\u0431\u0443, \u0430 \u0442\u044b\u043c, \u043a\u0430\u0433\u043e \u0401\u043d \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u045e, \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u0435, \u044f\u043a \u0434\u043e\u0439\u043b\u0456\u0434, \u043f\u043b\u0430\u043d \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0414\u043b\u044f \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u044b\u0445 \u0443 \u0415\u0433\u0456\u043f\u0446\u0435 \u0401\u043d \u0441\u0442\u0430\u045e \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c, \u0430 \u0442\u044b\u043c, \u0448\u0442\u043e \u0431\u0443\u043d\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0434\u0430\u045e \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0437\u0430\u043a\u043e\u043d. \u0422\u044b\u043c, \u0445\u0442\u043e \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0434\u043e\u0431\u0440\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u0434\u0430\u0435 \u0433\u043e\u0434\u043d\u0443\u044e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443, \u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0410\u0439\u0446\u0430, \u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u0442\u043b\u0443\u0441\u0442\u0430\u0435 \u0446\u044f\u043b\u044f \u0456 \u0430\u043f\u0440\u0430\u043d\u0430\u0435 \u0456\u0445 \u0443 \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u044f \u0448\u0430\u0442\u044b. \u0413\u044d\u0442\u0430\u043a \u0401\u043d \u0441\u0430\u043c\u044b\u043c\u0456 \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u0441\u043f\u043e\u0441\u0430\u0431\u0430\u043c\u0456 \u0441\u0443\u043b\u0430\u0434\u0436\u0432\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0440\u043e\u0434 \u0434\u043b\u044f \u0441\u0456\u043c\u0444\u043e\u043d\u0456\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u0432. \u042f\u043d \u043a\u0430\u0436\u0430 \u045e \u0410\u043f\u0430\u043a\u0430\u043b\u0456\u043f\u0441\u0456\u0441\u0435: &laquo;\u0413\u043e\u043b\u0430\u0441 \u042f\u0433\u043e \u044f\u043a \u0433\u043e\u043b\u0430\u0441 \u043c\u043d\u043e\u0433\u0456\u0445 \u0432\u043e\u0434\u0430\u045e&raquo; (\u0410\u043f 1, 15). \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0432\u043e\u0434\u044b \u0411\u043e\u0436\u0430\u0433\u0430 \u0414\u0443\u0445\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0410\u0439\u0446\u0435\u0446 \u0431\u0430\u0433\u0430\u0442\u044b \u0456 \u0432\u0435\u043b\u0456\u0447\u043d\u044b. \u0406 \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u043f\u0440\u0430\u0437 \u0443\u0441\u0451 \u0433\u044d\u0442\u0430, \u043d\u0435 \u0448\u043a\u0430\u0434\u0443\u044e\u0447\u044b, \u0443\u0434\u0437\u044f\u043b\u044f\u043b\u0430 \u0441\u0432\u0430\u044e \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u045e\u0441\u044f \u042f\u043c\u0443, \u0456 \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0432\u0430\u043b\u0430 \u0417\u0430\u043a\u043e\u043d, \u044f\u043a\u0456 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u045e \u0456 \u043f\u0430\u0441\u0430\u0432\u0430\u045e \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043d\u0430\u0440\u043e\u0434\u0443 \u0431\u044b\u043b\u0456 \u0417\u0430\u043a\u043e\u043d\u0430\u043c \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u043d\u0456 \u043d\u0430\u043a\u043e\u043d\u0442 \u0443\u0437\u0432\u044f\u0434\u0437\u0435\u043d\u043d\u044f \u0448\u0430\u0442\u0440\u0430, \u0431\u0443\u0434\u043e\u045e\u043b\u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0430\u0431\u0440\u0430\u043d\u043d\u044f \u043b\u0435\u0432\u0456\u0442\u0430\u045e, \u0430\u0445\u0432\u044f\u0440 \u0456 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f\u045e, \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u044f\u045e \u0456 \u0456\u043d\u0448\u044b\u0445 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f\u045e \u043a\u0443\u043b\u044c\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043c \u0411\u043e\u0433 \u043d\u0435 \u043c\u0435\u045e \u043d\u0456 \u045e \u0447\u044b\u043c \u043f\u0430\u0442\u0440\u044d\u0431\u044b, \u0431\u043e \u043d\u0430\u0432\u0430\u0442 \u0434\u0430 \u0442\u0430\u0433\u043e, \u044f\u043a \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u041c\u0430\u0439\u0441\u0435\u0439, \u0401\u043d, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u043e\u045e\u043d\u044b \u045e\u0441\u044f\u043a\u0456\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u043c\u0435\u045e \u0443\u0441\u044f\u043b\u044f\u043a\u0456 \u0441\u0430\u043b\u043e\u0434\u043a\u0456 \u0432\u043e\u0434\u0430\u0440 \u0456 \u045e\u0441\u044f\u043a\u0456 \u0434\u0443\u0445\u043c\u044f\u043d\u044b \u043f\u0430\u0445 \u043a\u0430\u0434\u0437\u0456\u043b\u0430. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0401\u043d \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u045e \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0442\u0430\u043a \u043b\u0451\u0433\u043a\u0430 \u0441\u0445\u0456\u043b\u044f\u045e\u0441\u044f \u0434\u0430 \u0456\u0434\u0430\u043b\u0430\u045e, \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u044f\u043c\u0443 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u043c\u043d\u043e\u0433\u0456\u0445 \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u043d\u044f\u045e \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 \u0411\u043e\u0433\u0443. \u041f\u0440\u0430\u0437 \u0434\u0440\u0443\u0433\u0430\u0441\u043d\u044b\u044f \u0440\u044d\u0447\u044b \u0411\u043e\u0433 \u043a\u043b\u0456\u043a\u0430\u045e \u044f\u0433\u043e \u0434\u0430 \u043f\u0435\u0440\u0448\u0430\u0441\u043d\u044b\u0445, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u0432\u043e\u0431\u0440\u0430\u0437\u044b &ndash; \u0434\u0430 \u043f\u0440\u0430\u045e\u0434\u044b, \u043f\u0440\u0430\u0437 \u0447\u0430\u0441\u043e\u0432\u0430\u0435 &ndash; \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0456 \u043f\u0440\u0430\u0437 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435 &ndash; \u0434\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430, \u044f\u043a \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u041c\u0430\u0439\u0441\u0435\u044e: &laquo;\u0423\u0441\u0451 \u0437\u0440\u043e\u0431\u0456\u0448 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0437\u043e\u0440\u0443, \u044f\u043a\u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u043d\u0430 \u0433\u0430\u0440\u044b&raquo; (\u0417\u044b\u0445 25, 40).<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0441\u0430\u043c \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0441\u0430\u0440\u0430\u043a\u0430 \u0434\u0437\u0451\u043d \u0432\u0443\u0447\u044b\u045e\u0441\u044f \u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443 \u043f\u0430\u043c\u044f\u0446\u0456 \u0441\u043b\u043e\u0432\u044b \u0411\u043e\u0436\u044b\u044f, \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0437\u043d\u0430\u043a\u0456, \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0432\u043e\u0431\u0440\u0430\u0437\u044b \u0456 \u0441\u0456\u043c\u0432\u0430\u043b\u044b \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430, \u044f\u043a \u043a\u0430\u0437\u0430\u045e \u0441\u0432. \u041f\u0430\u0432\u0435\u043b: &laquo;\u0423\u0441\u0435 \u043f\u0456\u043b\u0456 \u0441\u0430 \u0441\u043a\u0430\u043b\u044b, \u0448\u0442\u043e \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u043b\u0430 \u0456\u043c, \u0430 \u0441\u043a\u0430\u043b\u043e\u044e \u0431\u044b\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441&raquo; (1 \u041a\u0430\u0440 10, 4). \u0406 \u0437\u043d\u043e\u045e, \u0437\u0433\u0430\u0434\u0430\u045e\u0448\u044b \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u0417\u0430\u043a\u043e\u043d\u0435, \u0434\u0430\u0434\u0430\u0435: &laquo;\u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0437 \u0456\u043c\u0456 \u044f\u043a \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u044e, \u0431\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u044f \u043d\u0430\u043c, \u044f\u043a\u0456\u043c \u0432\u044b\u043f\u0430\u043b\u0430 \u0436\u044b\u0446\u044c \u0443 \u043a\u0430\u043d\u0446\u044b \u0432\u044f\u043a\u043e\u045e&raquo; (1 \u041a\u0430\u0440 10, 11).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0432\u043e\u0431\u0440\u0430\u0437\u044b \u0432\u0443\u0447\u044b\u043b\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0436\u0430\u0439 \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u0456 \u045e \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 \u042f\u043c\u0443. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0417\u0430\u043a\u043e\u043d \u0431\u044b\u045e \u0434\u043b\u044f \u0456\u0445 \u0456 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u0435\u043c, \u0456 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430\u043c \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u0445 \u0440\u044d\u0447\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0430\u043b 3, 24-25. 23<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0417\u0430\u043a\u043e\u043d \u0431\u044b\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0430\u043c, \u043a\u0430\u0431 \u043c\u044b \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043b\u0456\u0441\u044f \u0432\u0435\u0440\u0430\u044e. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u043b\u0456 \u0436 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0432\u0435\u0440\u0430, \u043c\u044b \u045e\u0436\u043e \u043d\u0435 \u043f\u0430\u0434\u0443\u043b\u0430\u0434\u043d\u044b\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0430 \u043f\u0440\u044b\u0445\u043e\u0434\u0443 \u0432\u0435\u0440\u044b \u043c\u044b \u0431\u044b\u043b\u0456 \u0437\u0430\u043c\u043a\u043d\u0451\u043d\u044b\u044f \u043f\u0430\u0434 \u0432\u0430\u0440\u0442\u0430\u044e \u0417\u0430\u043a\u043e\u043d\u0443, \u0434\u0430 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0432\u0435\u0440\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0436 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0432\u0435\u0440\u0430, \u043c\u044b \u045e\u0436\u043e \u043d\u0435 \u043f\u0430\u0434\u0443\u043b\u0430\u0434\u043d\u044b\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"525","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0413\u0456\u043b\u044f\u0440\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps. 127, 1-3: CSEL 24, 628-630)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u0431\u043e\u044f\u0437\u044c \u0411\u043e\u0436\u0430\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u041f\u0430\u043d\u0430, \u0445\u0442\u043e \u0445\u043e\u0434\u0437\u0456\u0446\u044c \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0448\u043b\u044f\u0445\u0430\u043c\u0456&raquo; (\u041f\u0441 128 [127], 1). \u0417\u0430\u045e\u0436\u0434\u044b, \u043a\u0430\u043b\u0456 \u045e \u0421\u0432\u044f\u0442\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u043f\u0440\u0430 \u0431\u043e\u044f\u0437\u044c \u0411\u043e\u0436\u0443\u044e, \u0442\u0440\u044d\u0431\u0430 \u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0434\u043d\u043e\u0439 \u044f\u0435 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435\u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0434\u043b\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u0432\u0435\u0440\u044b, \u044f\u043d\u0430 \u043c\u0430\u0435 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u043c\u043d\u043e\u0433\u0456\u044f \u0456\u043d\u0448\u044b\u044f \u043f\u0435\u0440\u0430\u0434\u0443\u043c\u043e\u0432\u044b, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u0456\u043c \u043c\u043e\u0436\u043d\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0436\u0430\u0439. \u041c\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u043c \u0433\u044d\u0442\u0430 \u0441\u0430 \u0441\u043b\u043e\u045e \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430 \u045e \u043a\u043d\u0456\u0437\u0435 \u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e: &laquo;\u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0434\u0430 \u0440\u043e\u0437\u0443\u043c\u0443 \u0456 \u0434\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0441\u0446\u0456 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0448\u0443\u043a\u0430\u0446\u044c \u044f\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u0441\u0440\u044d\u0431\u0440\u0430, \u0456 \u0434\u0430\u0448\u0443\u043a\u0432\u0430\u0446\u0446\u0430 \u044f\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u0441\u043a\u0430\u0440\u0431\u0443, \u0442\u0430\u0434\u044b \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0448, \u0448\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0431\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430&raquo; (\u041f\u0440\u044b\u043f 2, 3-5).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u043c, \u043f\u0430 \u044f\u043a\u0456\u0445 \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u043a\u0430\u0445 \u043c\u043e\u0436\u043d\u0430 \u043f\u0430\u0434\u043d\u044f\u0446\u0446\u0430 \u0434\u0430 \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0436\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u044f\u0440\u0448\u0430 \u0442\u0440\u044d\u0431\u0430 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u0434\u0430\u0440\u0443\u0447\u044b\u0446\u044c \u0440\u043e\u0437\u0443\u043c\u0443 \u045e\u0432\u0435\u0441\u044c \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f, \u0430 \u043f\u0430\u0441\u043b\u044f \u0448\u0443\u043a\u0430\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0430\u0434 \u0451\u044e. \u041f\u043e\u0442\u044b\u043c \u0442\u0440\u044d\u0431\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0431\u043e\u044f\u0437\u044c \u0411\u043e\u0436\u0443\u044e. \u041f\u0440\u044b \u0433\u044d\u0442\u044b\u043c \u044f\u0435 \u043d\u0435\u043b\u044c\u0433\u0430 \u0430\u0442\u0430\u044f\u0441\u0430\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0437 \u0430\u0433\u0443\u043b\u044c\u043d\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c \u043f\u0430\u0447\u0443\u0446\u0446\u0451\u043c \u0441\u0442\u0440\u0430\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0440\u0430\u0445 &ndash; \u0433\u044d\u0442\u0430 \u0442\u0440\u0430\u043f\u044f\u0442\u0430\u043d\u043d\u0435 \u043b\u044e\u0434\u0441\u043a\u043e\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456, \u044f\u043a\u0430\u044f \u0431\u0430\u0456\u0446\u0446\u0430 \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u0441\u0430\u0431\u0435 \u043d\u0435 \u0436\u0430\u0434\u0430\u0435. \u0422\u0430\u043a\u0456 \u0440\u043e\u0434 \u0441\u0442\u0440\u0430\u0445\u0443 \u045e\u0437\u043d\u0456\u043a\u0430\u0435 \u0456 \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441 \u0430\u0434 \u0434\u0430\u043a\u043e\u0440\u0430\u045e \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f, \u0430\u0434 \u0437\u0430\u0433\u0430\u0434\u0443 \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430, \u0430\u0434 \u043d\u0430\u043f\u0430\u0434\u0443 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u0433\u0430, \u0430\u0434 \u0445\u0432\u0430\u0440\u043e\u0431\u044b, \u0430\u0434 \u043d\u0430\u043f\u0430\u0434\u0443 \u0434\u0437\u0456\u043a\u0430\u0433\u0430 \u0437\u0432\u0435\u0440\u0430 \u0456 \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0433\u044d\u0442\u0430\u043c\u0443 \u0441\u0442\u0440\u0430\u0445\u0443 \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0432\u0443\u0447\u044b\u0446\u0446\u0430, \u0431\u043e \u0451\u043d \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043d\u0430\u0448\u0430\u0439 \u043f\u0440\u044b\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456. \u041c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u0443\u0447\u044b\u0446\u0446\u0430, \u0447\u0430\u0433\u043e \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0431\u0430\u044f\u0446\u0446\u0430, \u0431\u043e \u0433\u044d\u0442\u044b\u044f \u0440\u044d\u0447\u044b \u0441\u0430\u043c\u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0446\u044c \u043d\u0430\u0441 \u0441\u0442\u0440\u0430\u0445\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0432\u043e\u0441\u044c \u043d\u0430\u043a\u043e\u043d\u0442 \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u0442\u0430\u043a: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0441\u044b\u043d\u044b, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u043c\u044f\u043d\u0435: \u043d\u0430\u0432\u0443\u0447\u0443 \u0432\u0430\u0441 \u0431\u043e\u044f\u0437\u0456 \u041f\u0430\u043d\u0430&raquo; (\u041f\u0441 34 [33], 12). \u0422\u0430\u043c\u0443 \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0436\u0430\u0439 \u0442\u0440\u044d\u0431\u0430 \u0432\u0443\u0447\u044b\u0446\u0446\u0430, \u0431\u043e \u0451\u0439 \u0432\u0443\u0447\u0430\u0446\u0446\u0430. \u042f\u043d\u0430 \u043d\u0435 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435, \u0448\u0442\u043e \u0441\u0442\u0440\u0430\u0445, \u0430\u043b\u0435 \u043d\u0430\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0448\u043b\u044f\u0445\u0430\u043c \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f. \u042f\u043d\u0430 \u043d\u0435 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u043f\u0440\u044b\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0441\u0442\u0440\u0430\u0445\u0443, \u0430\u043b\u0435 \u043d\u0430\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e, \u043f\u0440\u0430\u0437 \u0434\u043e\u0431\u0440\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043b\u044f \u043d\u0430\u0441 \u0436\u0430 \u0431\u043e\u044f\u0437\u044c \u0411\u043e\u0436\u0430\u044f \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u0446\u0430\u043b\u043a\u0430\u043c \u0443 \u043b\u044e\u0431\u043e\u0432\u0456, \u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u044f\u0435 \u043c\u044d\u0442\u0430\u0439. \u0410\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u043d\u0430\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u042f\u0433\u043e \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u0456, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0446\u0446\u0430 \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u0456 \u0432\u0435\u0440\u044b\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u043c. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c \u0436\u0430, \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435: &laquo;\u0410 \u0446\u044f\u043f\u0435\u0440, \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0447\u0430\u0433\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0426\u044f\u0431\u0435 \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0442\u044b \u0431\u0430\u044f\u045e\u0441\u044f \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0445\u0430\u0434\u0437\u0456\u045e \u0448\u043b\u044f\u0445\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0456 \u043b\u044e\u0431\u0456\u045e \u042f\u0433\u043e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u045e \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u0441\u0432\u0430\u0439\u043c\u0443 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u0439 \u0441\u0432\u0430\u0451\u0439, \u043a\u0430\u0431 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u042f\u0433\u043e\u043d\u044b\u044f \u0434\u0437\u0435\u043b\u044f \u0442\u0432\u0430\u0439\u0433\u043e \u0434\u0430\u0431\u0440\u0430?&raquo; (\u0414\u0440\u0433 10, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u0441\u0446\u044c \u0448\u043c\u0430\u0442 \u0448\u043b\u044f\u0445\u043e\u045e \u041f\u0430\u043d\u0430, \u0445\u043e\u0446\u044c \u0401\u043d \u0441\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0448\u043b\u044f\u0445\u0430\u043c. \u0410\u043b\u0435, \u043a\u0430\u043b\u0456 \u0401\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u0434\u0430\u0440\u043e\u0433\u0430\u0439, \u0401\u043d \u0443\u043a\u0430\u0437\u0432\u0430\u0435 \u043f\u0440\u044b\u0447\u044b\u043d\u0443 \u0433\u044d\u0442\u0430\u0439 \u043c\u0435\u0442\u0430\u0444\u0430\u0440\u044b: &laquo;\u042f &ndash; \u0434\u0430\u0440\u043e\u0433\u0430, \u0456 \u043f\u0440\u0430\u045e\u0434\u0430, \u0456 \u0436\u044b\u0446\u0446\u0451. \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0410\u0439\u0446\u0430 \u0456\u043d\u0430\u043a\u0448, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u041c\u044f\u043d\u0435&raquo; (\u042f\u043d 14, 6).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0442\u0440\u044d\u0431\u0430 \u043f\u044b\u0442\u0430\u0446\u0446\u0430 \u043f\u0440\u0430 \u0440\u043e\u0437\u043d\u044b\u044f \u0448\u043b\u044f\u0445\u0456 \u0456 \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u0446\u0446\u0430 \u043d\u0430 \u043c\u043d\u043e\u0433\u0456\u044f \u0437 \u0456\u0445, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u043c\u043d\u043e\u0433\u0456\u0445 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0430\u0434\u0437\u0456\u043d\u044b \u0434\u043e\u0431\u0440\u044b \u0448\u043b\u044f\u0445 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0411\u043e \u0451\u0441\u0446\u044c \u0448\u043b\u044f\u0445\u0456 \u045e \u0417\u0430\u043a\u043e\u043d\u0435, \u0448\u043b\u044f\u0445\u0456 \u045e \u041f\u0440\u0430\u0440\u043e\u043a\u0430\u0445, \u0448\u043b\u044f\u0445\u0456 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f\u0445, \u0448\u043b\u044f\u0445\u0456 \u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u0445, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0456\u043d\u0448\u044b\u0445 \u0442\u0432\u043e\u0440\u0430\u0445 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u045e. \u0406 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u0442\u044b\u044f, \u0445\u0442\u043e \u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0433\u044d\u0442\u044b\u043c\u0456 \u0448\u043b\u044f\u0445\u0430\u043c\u0456 \u0437 \u0431\u043e\u044f\u0437\u0437\u044e \u0411\u043e\u0436\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0456\u0440 2, 19; \u041b\u043a 1, 50<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u041f\u0430\u043d\u0430, \u0448\u0443\u043a\u0430\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0440\u044b\u0435\u043c\u043d\u0430 \u042f\u043c\u0443. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0445\u0442\u043e \u042f\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u044c, \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u042f\u0433\u043e \u0417\u0430\u043a\u043e\u043d\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430 \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u045e \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u0434 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u042f\u0433\u043e \u0431\u0430\u0456\u0446\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041d<\/span>. \u0406 \u0445\u0442\u043e \u042f\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u044c, \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u042f\u0433\u043e \u0417\u0430\u043a\u043e\u043d\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"526","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u044f\u045e&raquo; \u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 4, 16, 2-5: SC 100, 564-572)<\/span><br \/><span style=\"color: #ff0000;\">\u0417\u0430\u043f\u0430\u0432\u0435\u0442 \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043a\u043d\u0456\u0437\u0435 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u041c\u0430\u0439\u0441\u0435\u0439 \u043a\u0430\u0436\u0430 \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u043d\u0430 \u0413\u0430\u0440\u044d\u0431\u0435; \u0401\u043d \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0433\u044d\u0442\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u043d\u0435 \u0437 \u0430\u0439\u0446\u0430\u043c\u0456 \u0432\u0430\u0448\u044b\u043c\u0456, \u0430 \u0437 \u0432\u0430\u043c\u0456&raquo; (\u0414\u0440\u0433 5, 2-3).<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043c\u0443 \u0411\u043e\u0433 \u043d\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0437 \u0430\u0439\u0446\u0430\u043c\u0456? \u0411\u043e &laquo;\u0417\u0430\u043a\u043e\u043d \u0431\u044b\u045e \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u043d\u0435 \u0434\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445&raquo; (1 \u0426\u0456\u043c 1, 9). \u0410\u0439\u0446\u044b \u0436 \u0431\u044b\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c\u0456, \u043c\u0430\u044e\u0447\u044b \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0456 \u0434\u0443\u0448\u0430\u0445 \u043c\u043e\u0446 \u0414\u044d\u043a\u0430\u043b\u043e\u0433\u0443. \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u044f\u043d\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0456\u0445, \u0456 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u043b\u0456 \u045e\u0441\u044f\u043a\u0430\u0439 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u043f\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u0456\u0445 \u0434\u0430\u043a\u043e\u0440\u0430\u043c\u0456, \u0431\u043e \u044f\u043d\u044b \u043c\u0435\u043b\u0456 \u045e \u0441\u0430\u0431\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0417\u0430\u043a\u043e\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u0433\u044d\u0442\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430 \u0430\u0441\u043b\u0430\u0431\u043b\u0456, \u043f\u0430\u0439\u0448\u043b\u0456 \u045e \u0437\u0430\u0431\u044b\u0446\u0446\u0451 \u0456 \u043f\u0430\u0433\u0430\u0441\u043b\u0456 \u045e \u0415\u0433\u0456\u043f\u0446\u0435, \u0411\u043e\u0433 \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0451\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456 \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439 \u0431\u044b\u045e \u0432\u044b\u043c\u0443\u0448\u0430\u043d\u044b \u0430\u0431&rsquo;\u044f\u045e\u043b\u044f\u0446\u044c \u0441\u044f\u0431\u0435 \u0456\u043c \u043f\u0440\u0430\u0437 \u0433\u043e\u043b\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0439 \u043c\u043e\u0446\u0430\u0439 \u0432\u044b\u0432\u0435\u045e \u043d\u0430\u0440\u043e\u0434 \u0437 \u0415\u0433\u0456\u043f\u0442\u0430, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u043d\u043e\u045e \u0441\u0442\u0430\u045e \u0432\u0443\u0447\u043d\u0435\u043c \u0456 \u0440\u0443\u043f\u043b\u0456\u045e\u0446\u0430\u043c \u0411\u043e\u0433\u0430. \u0401\u043d \u043a\u0430\u0440\u0430\u045e \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043b\u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u043e\u0442\u044b\u043c \u043a\u0430\u0440\u043c\u0456\u045e \u043d\u0430\u0440\u043e\u0434 \u043c\u0430\u043d\u043d\u0430\u0439, \u043a\u0430\u0431 \u0451\u043d \u043f\u0440\u044b\u043c\u0430\u045e \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u0435\u0436\u0443, \u0442\u0430\u043a \u044f\u043a \u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u0443 \u043a\u043d\u0456\u0437\u0435 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f: &laquo;\u041a\u0430\u0440\u043c\u0456\u045e \u0446\u044f\u0431\u0435 \u043c\u0430\u043d\u043d\u0430\u044e, \u044f\u043a\u043e\u0439 \u043d\u0435 \u0432\u0435\u0434\u0430\u045e \u0442\u044b \u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456 \u043f\u0440\u043e\u0434\u043a\u0456 \u0442\u0432\u0430\u0435, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u043d\u0435 \u0430\u0434\u043d\u044b\u043c \u0445\u043b\u0435\u0431\u0430\u043c \u0436\u044b\u0432\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0430\u043b\u0435 \u043a\u043e\u0436\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u044f\u043a\u043e\u0435 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u041f\u0430\u043d\u0430&raquo; (\u0414\u0440\u0433 8, 3).<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u045e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u043d\u0430\u0441\u0442\u043e\u0439\u0432\u0430\u045e \u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u0431\u044b\u045e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0456 \u043d\u044f\u0432\u0430\u0440\u0442\u044b\u043c \u0411\u043e\u0433\u0430. \u041f\u0440\u0430\u0437 \u0414\u044d\u043a\u0430\u043b\u043e\u0433 \u0401\u043d \u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430 \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430 \u0437 \u0441\u0430\u0431\u043e\u044e \u0456 \u0434\u0430 \u0437\u0433\u043e\u0434\u044b \u0437 \u0431\u043b\u0456\u0436\u043d\u0456\u043c. \u0413\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u043a\u0430\u0440\u044b\u0441\u043d\u0430 \u0441\u0430\u043c\u043e\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u0443 \u0442\u043e\u0439 \u0447\u0430\u0441 \u044f\u043a \u0411\u043e\u0433\u0443 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430 \u0430\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0432\u043e\u0441\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u043d\u0435\u0441\u0442\u0430\u0432\u0430\u043b\u0430 \u0441\u043b\u0430\u0432\u044b \u0411\u043e\u0436\u0430\u0439, \u044f\u043a\u0443\u044e \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0443. \u0422\u0430\u043c\u0443 \u041c\u0430\u0439\u0441\u0435\u0439 \u0437\u043d\u043e\u045e \u043a\u0430\u0436\u0430 \u043d\u0430\u0440\u043e\u0434\u0443: &laquo;\u0412\u044b\u0431\u0435\u0440\u044b \u0436\u044b\u0446\u0446\u0451, \u043a\u0430\u0431 \u0436\u044b\u045e \u0442\u044b \u0456 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0442\u0432\u0430\u0451, \u043a\u0430\u0431 \u043b\u044e\u0431\u0456\u045e \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0456 \u0441\u043b\u0443\u0445\u0430\u045e\u0441\u044f \u0433\u043e\u043b\u0430\u0441\u0443 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u0456 \u043c\u043e\u0446\u043d\u0430 \u0442\u0440\u044b\u043c\u0430\u045e\u0441\u044f \u042f\u0433\u043e. \u0411\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u0442\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u043b\u0430\u0441\u0446\u044c \u0434\u0437\u0451\u043d \u0442\u0432\u0430\u0456\u0445&raquo; (\u0414\u0440\u0433 30, 19-20).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0411\u043e\u0433 \u0441\u0430\u043c \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0441\u043b\u043e\u0432\u044b \u0414\u044d\u043a\u0430\u043b\u043e\u0433\u0443. \u0406 \u0442\u0430\u043c\u0443 \u044f\u043d\u044b \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0442\u0440\u044b\u0432\u0430\u044e\u0446\u044c \u0456 \u045e \u043d\u0430\u0448 \u0447\u0430\u0441, \u0431\u043e \u043f\u0440\u0430\u0437 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0411\u043e\u0433\u0430 \u044f\u043d\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u043d\u044b\u044f, \u0430\u043b\u0435 \u043f\u0430\u0448\u044b\u0440\u044b\u043b\u0456\u0441\u044f \u0456 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u044b\u043b\u0456\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u043a\u043e\u043d\u0442 \u0431\u044b\u043b\u043e\u0433\u0430 \u0441\u0442\u0430\u043d\u0443 \u043d\u044f\u0432\u043e\u043b\u0456, \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u044f \u041f\u0430\u043d\u0430\u043c \u043f\u0440\u0430\u0437 \u041c\u0430\u0439\u0441\u0435\u044f \u0434\u043b\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0456 \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u044f \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0430\u043c \u041c\u0430\u0439\u0441\u0435\u0439: &laquo;\u041f\u0430\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043c\u043d\u0435 \u045e \u0442\u043e\u0439 \u0447\u0430\u0441 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0430\u043c \u0456 \u0437\u0430\u043a\u043e\u043d\u0430\u043c&raquo; (\u043f\u0430\u0440. \u0414\u0440\u0433 4, 5).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u045e\u0441\u0451, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0434\u043b\u044f \u043d\u044f\u0432\u043e\u043b\u0456 \u0456 \u045e \u044f\u043a\u0430\u0441\u0446\u0456 \u0437\u043d\u0430\u043a\u0443, \u0411\u043e\u0433 \u0430\u0431\u043c\u0435\u0436\u0430\u0432\u0430\u045e \u043d\u043e\u0432\u044b\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0430\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u044b. \u0410 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0443\u043b\u0430\u0441\u0446\u0456\u0432\u044b\u044f \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c \u043b\u044e\u0434\u0437\u044f\u043c \u0456 \u0430\u0433\u0443\u043b\u044c\u043d\u044b\u044f \u0434\u043b\u044f \u045e\u0441\u0456\u0445, \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u044b\u045e \u0456 \u043f\u0430\u0448\u044b\u0440\u044b\u045e. \u041f\u0440\u0430\u0437 \u0443\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0401\u043d \u0434\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0411\u043e\u0433\u0430 \u044f\u043a \u0410\u0439\u0446\u0430, \u043a\u0430\u0431 \u043c\u044b \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u042f\u0433\u043e \u0456 \u0431\u0435\u0437 \u0432\u0430\u0433\u0430\u043d\u043d\u044f\u045e \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430 \u042f\u0433\u043e \u0421\u043b\u043e\u0432\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 <\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u0439\u0441\u0435\u0439, \u0441\u043b\u0443\u0433\u0430 \u0411\u043e\u0436\u044b, \u043f\u0430\u0441\u0446\u0456\u045e\u0441\u044f \u0441\u043e\u0440\u0430\u043a \u0434\u0437\u0451\u043d \u0456 \u043d\u0430\u0447\u044d\u0439, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u0432\u0430\u0440\u0442\u044b\u043c \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0411\u043e\u0436\u044b \u0417\u0430\u043a\u043e\u043d.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u043a\u0430\u043b\u0456 \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u0443 \u0421\u0456\u043d\u0430\u0439 \u0434\u0430 \u041f\u0430\u043d\u0430, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u045e\u0441\u044f \u0442\u0430\u043c \u0441\u043e\u0440\u0430\u043a \u0434\u0437\u0451\u043d \u0456 \u0441\u043e\u0440\u0430\u043a \u043d\u0430\u0447\u044d\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u0432\u0430\u0440\u0442\u044b\u043c \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0411\u043e\u0436\u044b \u0417\u0430\u043a\u043e\u043d.<\/p>\r\n"}, {"GCH_CH_2_ID":"527","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0423\u0446\u0451\u043a\u0456 \u0430\u0434 \u0441\u0432\u0435\u0442\u0443&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 6, 36; 7, 44; 8, 45; 9, 52: CSEL 32, 192. 198-199. 204)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u043f\u0430\u0434\u0437\u0435\u043c \u0434\u0430 \u0411\u043e\u0433\u0430, \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435 \u0441\u044d\u0440\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0442\u0430\u043c \u0456 \u044f\u0433\u043e \u0441\u043a\u0430\u0440\u0431, \u0442\u0430\u043c\u0443 \u0456 \u0411\u043e\u0433 \u0437\u0430\u0437\u0432\u044b\u0447\u0430\u0439 \u043d\u0435 \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0430\u0446\u044c \u0434\u0430\u0431\u0440\u043e \u0442\u044b\u043c, \u0445\u0442\u043e \u042f\u0433\u043e \u043f\u0440\u043e\u0441\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u043d \u0434\u043e\u0431\u0440\u044b, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430, \u0437 \u0443\u0441\u0451\u0439 \u0441\u0456\u043b\u044b \u043f\u0440\u044b\u043f\u0430\u0434\u0437\u0435\u043c \u0434\u0430 \u042f\u0433\u043e \u045e\u0441\u0451\u0439 \u043d\u0430\u0448\u0430\u0439 \u0434\u0443\u0448\u043e\u0439 \u0456 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u043a\u0430\u0431 \u0430\u043f\u044b\u043d\u0443\u0446\u0446\u0430 \u045e \u042f\u0433\u043e\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u0435, \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0441\u043b\u0430\u0432\u0443 \u042f\u0433\u043e \u0456 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0430\u0441\u0430\u043b\u043e\u0434\u0430\u0439. \u0414\u044b\u043a \u0443\u0437\u043d\u044f\u0441\u0435\u043c \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0414\u0430\u0431\u0440\u0430 \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b, \u0443 \u0406\u043c \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u043c\u0441\u044f \u0456 \u045e \u0406\u043c \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u044b\u0446\u044c, \u0434\u0430 \u042f\u0433\u043e \u043f\u0440\u044b\u043f\u0430\u0434\u0437\u0435\u043c, \u0431\u043e \u042f\u043d\u043e \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043a\u0456 \u0440\u043e\u0437\u0443\u043c \u0456 \u045e\u0441\u044f\u043a\u0456\u044f \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0456, \u0456 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u044b\u043c \u0456 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0435\u043c, \u0430 \u0433\u044d\u0442\u044b \u0441\u043f\u0430\u043a\u043e\u0439 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0456 \u0440\u043e\u0437\u0443\u043c \u0456 \u045e\u0441\u044f\u043a\u0430\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u0435 \u0434\u0430\u0431\u0440\u043e \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0432\u0430 \u045e\u0441\u0451, \u0456 \u043c\u044b \u045e\u0441\u0435 \u045e \u0456\u043c \u0436\u044b\u0432\u0451\u043c \u0456 \u0430\u0434 \u044f\u0433\u043e \u0437\u0430\u043b\u0435\u0436\u044b\u043c. \u042f\u043d\u043e \u0436 \u043d\u0435 \u043c\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0437\u0430 \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0441\u0430\u043c\u043e \u0451\u0441\u0446\u044c \u0431\u043e\u0441\u043a\u0456\u043c. \u0411\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043e\u0431\u0440\u044b\u043c, \u0430\u043a\u0440\u0430\u043c\u044f \u0430\u0434\u043d\u0430\u0433\u043e \u0411\u043e\u0433\u0430, \u0442\u0430\u043c\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u043e\u0431\u0440\u0430\u0435, \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0411\u043e\u0433\u0443, \u0430 \u0448\u0442\u043e \u0431\u043e\u0441\u043a\u0430\u0435 &ndash; \u0434\u043e\u0431\u0440\u0430\u0435. \u0422\u0430\u043c\u0443 \u0456 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u0435\u0448 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e, \u044f\u043d\u044b \u043d\u0430\u0441\u044b\u0447\u0430\u044e\u0446\u0446\u0430 \u0434\u0430\u0431\u0440\u043e\u043c&raquo; (\u041f\u0441 104 [103], 28). \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456, \u0443\u0441\u0451 \u0434\u0430\u0431\u0440\u043e, \u044f\u043a\u043e\u0435 \u043f\u0430 \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u0445 \u043d\u0430\u043c \u0443\u0434\u0437\u044f\u043b\u044f\u0435\u0446\u0446\u0430, \u043d\u0435 \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u043d\u0456\u044f\u043a\u0430\u0439 \u0434\u0430\u043c\u0435\u0448\u043a\u0456 \u0437\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u0435 \u0434\u0430\u0431\u0440\u043e \u0430\u0431\u044f\u0446\u0430\u0435 \u0432\u0435\u0440\u043d\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0411\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u0437\u044f\u043c\u043b\u0456&raquo; (\u0406\u0441 1, 19).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0456 \u043d\u043e\u0441\u0456\u043c \u0441\u043c\u0435\u0440\u0446\u044c \u042f\u0433\u043e\u043d\u0443\u044e \u045e \u043d\u0430\u0448\u044b\u0445 \u0446\u0435\u043b\u0430\u0445, \u043a\u0430\u0431 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0440\u0430\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0441. \u0422\u0430\u043c\u0443 \u045e\u0436\u043e \u043d\u0435 \u0436\u044b\u0432\u0451\u043c \u043d\u0430\u0448\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u0430\u043b\u0435 \u0436\u044b\u0446\u0446\u0451\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u0436\u044b\u0446\u0446\u0451\u043c \u043d\u044f\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u0456, \u0436\u044b\u0446\u0446\u0451\u043c \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456, \u0436\u044b\u0446\u0446\u0451\u043c \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u044b \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u0446\u043d\u043e\u0442\u0430\u045e. \u0420\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u043c\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456, \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u044b\u0446\u044c, \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443\u0437\u044b\u0434\u0437\u0435\u043c \u043d\u0430 \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u0437\u043c\u0435\u0439 \u043d\u0435 \u0437\u043c\u043e\u0433 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043d\u0430\u0448\u0443 \u043f\u044f\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0446\u044f\u0447\u043e\u043c \u0430\u0434\u0441\u044e\u043b\u044c! \u0422\u044b \u043c\u043e\u0436\u0430\u0448 \u0443\u0446\u044f\u0447\u044b \u0434\u0443\u0445\u0430\u043c, \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448\u0441\u044f \u0446\u0435\u043b\u0430\u043c. \u041c\u043e\u0436\u0430\u0448 \u0431\u044b\u0446\u044c \u0442\u0443\u0442 \u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0430, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0432\u0430\u044f \u0434\u0443\u0448\u0430 \u043f\u0440\u044b\u043f\u0430\u0434\u0437\u0435 \u0434\u0430 \u042f\u0433\u043e, \u043a\u0430\u043b\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f\u043c\u0456 \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u0437\u0430 \u0406\u043c, \u043a\u0430\u043b\u0456 \u0432\u0435\u0440\u0430\u044e, \u0430 \u043d\u0435 \u0434\u043b\u044f \u0432\u044b\u0433\u043b\u044f\u0434\u0443, \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u043f\u0430 \u042f\u0433\u043e\u043d\u044b\u0445 \u0448\u043b\u044f\u0445\u0430\u0445, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0448\u0443\u043a\u0430\u0446\u044c \u043f\u0440\u044b\u0442\u0443\u043b\u043a\u0443 \u045e \u0442\u044b\u043c, \u043a\u0430\u043c\u0443 \u0414\u0430\u0432\u0456\u0434 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0414\u0430 \u0426\u044f\u0431\u0435 \u045e\u0446\u044f\u043a\u0430\u044e \u0456 \u043d\u0435 \u0440\u0430\u0441\u0447\u0430\u0440\u0443\u044e\u0441\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448\u0430 \u043f\u0440\u044b\u0431\u0435\u0436\u044b\u0448\u0447\u0430 &ndash; \u0443 \u0411\u043e\u0433\u0443, \u0430 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433 \u0443 \u043d\u0435\u0431\u0435 \u0456 \u043f\u0430-\u043d\u0430\u0434 \u043d\u044f\u0431\u0451\u0441\u0430\u043c\u0456, \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u045e\u0446\u044f\u043a\u0430\u0446\u044c \u0430\u0434\u0441\u044e\u043b\u044c \u0442\u0443\u0434\u044b, \u0434\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u0439, \u0434\u0437\u0435 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a \u0430\u0434 \u043f\u0440\u0430\u0446\u044b, \u0434\u0437\u0435 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0433\u0430\u0441\u0446\u044f\u0432\u0430\u0446\u044c \u043d\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0448\u0430\u0431\u0430\u0446\u0435, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439: &laquo;\u0428\u0430\u0431\u0430\u0442\u044b \u0437\u044f\u043c\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u043c \u043d\u0430 \u0441\u043f\u0430\u0436\u044b\u0432\u0443&raquo; (\u041b\u0435\u0432 25, 6). \u0421\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c \u0443 \u0411\u043e\u0433\u0443 \u0456 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u042f\u0433\u043e\u043d\u0443\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u0433\u0430\u0441\u0446\u0456\u043d\u0430, \u043f\u043e\u045e\u043d\u0430\u044f \u0430\u0441\u0430\u043b\u043e\u0434\u044b \u0456 \u0441\u043f\u0430\u043a\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0446\u044f\u0447\u043e\u043c, \u044f\u043a \u043b\u0430\u043d\u0456, \u0434\u0430 \u043a\u0440\u044b\u043d\u0456\u0446 \u0432\u0430\u0434\u044b. \u042f\u043a \u0441\u043c\u0430\u0433\u043d\u0443\u045e \u0414\u0430\u0432\u0456\u0434, \u043d\u044f\u0445\u0430\u0439 \u0441\u043c\u0430\u0433\u043d\u0435 \u0456 \u043d\u0430\u0448\u0430 \u0434\u0443\u0448\u0430. \u0410 \u0445\u0442\u043e \u0436 \u0433\u044d\u0442\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430? \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u0430\u0436\u0430: &laquo;\u0423 \u0422\u0430\u0431\u0435 &ndash; \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f&raquo; (\u041f\u0441 36 [35], 10). \u0414\u0430 \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u043d\u044f\u0445\u0430\u0439 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u043c\u0430\u044f \u0434\u0443\u0448\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0436 \u044f \u043f\u0440\u044b\u0439\u0434\u0443 \u0456 \u0437&rsquo;\u044f\u045e\u043b\u044e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0422\u0432\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c?&raquo; (\u043f\u0430\u0440. \u041f\u0441 42 [41], 3). \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0451\u0441\u0446\u044c \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 22, 37-38; \u043f\u0430\u0440. \u0414\u0440\u0433 10, 12<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041b\u044e\u0431\u0456 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u0439 \u0442\u0432\u0430\u0451\u0439, \u0456 \u045e\u0441\u0456\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u0442\u0432\u0430\u0456\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0413\u044d\u0442\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0456 \u043f\u0435\u0440\u0448\u0430\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0427\u0430\u0433\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0446\u044f\u0431\u0435 \u041f\u0430\u043d, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0442\u044b \u0431\u0430\u044f\u045e\u0441\u044f \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0456 \u043b\u044e\u0431\u0456\u045e \u042f\u0433\u043e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u045e \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u0442\u0432\u0430\u0439\u043c\u0443 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0442\u0432\u0430\u0456\u043c \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u0439 \u0442\u0432\u0430\u0451\u0439?<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0456 \u043f\u0435\u0440\u0448\u0430\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c.<\/p>\r\n"}, {"GCH_CH_2_ID":"531","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 15, 10-12. 16-17: CCL 36, 154-156)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0437 \u0421\u0430\u043c\u0430\u0440\u044b\u0456 \u0437\u0430\u0447\u0430\u0440\u043f\u043d\u0443\u0446\u044c \u0432\u0430\u0434\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0440\u044b\u0439\u0448\u043b\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u0430&raquo; (\u042f\u043d 4, 7). \u0412\u043e\u0431\u0440\u0430\u0437 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u0448\u0447\u044d \u043d\u0435 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u0430\u0433\u0430, \u0430\u043b\u0435 \u045e\u0436\u043e \u0431\u043b\u0456\u0437\u043a\u0430\u0433\u0430 \u0434\u0430 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044f. \u041f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0456\u0434\u0437\u0435 \u043c\u043e\u0432\u0430 \u045e \u043f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u0456. \u041f\u0440\u044b\u0439\u0448\u043b\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u0435 \u042f\u0433\u043e, \u0430 \u0401\u043d \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0437 \u0451\u0439. \u0414\u044b\u043a \u043f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u0456\u043c\u0441\u044f, \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u0456 \u0447\u0430\u043c\u0443 &laquo;\u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0437 \u0421\u0430\u043c\u0430\u0440\u044b\u0456 \u0437\u0430\u0447\u0430\u0440\u043f\u043d\u0443\u0446\u044c \u0432\u0430\u0434\u044b&raquo; (\u042f\u043d 4, 7). \u0421\u0430\u043c\u0430\u0440\u0430\u043d\u0435 \u043d\u0435 \u043c\u0435\u043b\u0456 \u0437\u043d\u043e\u0441\u0456\u043d \u0437 \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u044b\u043b\u0456 \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u043c\u0456. \u0422\u043e\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0437 \u0447\u0443\u0436\u043e\u0433\u0430 \u043a\u0440\u0430\u044e, \u043c\u0430\u0435 \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0447\u043d\u0430\u0435 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435, \u0431\u043e \u044f\u043d\u0430 \u045e\u0432\u0430\u0441\u0430\u0431\u043b\u044f\u043b\u0430 \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0430\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u044f\u043a \u0447\u0443\u0436\u044b \u043d\u0430\u0440\u043e\u0434\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0430\u0447\u0443\u0435\u043c \u044f\u0435 \u045e \u043d\u0430\u0441 \u0441\u0430\u043c\u0456\u0445, \u0443\u0431\u0430\u0447\u044b\u043c \u0443 \u0451\u0439 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435. \u041f\u0430\u0434\u0437\u044f\u043a\u0443\u0435\u043c \u0443 \u0451\u0439 \u0411\u043e\u0433\u0443 \u0437\u0430 \u043d\u0430\u0441. \u042f\u043d\u0430 \u0431\u044b\u043b\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c, \u0430 \u043d\u0435 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044e, \u0431\u043e \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u0447\u0430\u043b\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0443 \u0456 \u0441\u0430\u043c\u0430 \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u0430\u045e\u0434\u0430\u0439. \u042f\u043d\u0430 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0430 \u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e \u044f\u0435 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0434\u043b\u044f \u043d\u0430\u0441. \u042f\u043d\u0430 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0437\u0430\u0447\u0430\u0440\u043f\u043d\u0443\u0446\u044c \u0432\u0430\u0434\u044b. \u041f\u0440\u043e\u0441\u0442\u0430 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0437\u0430\u0447\u0430\u0440\u043f\u043d\u0443\u0446\u044c \u0432\u0430\u0434\u044b, \u044f\u043a \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u0440\u043e\u0431\u044f\u0446\u044c \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u0446\u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u043a\u0430\u0436\u0430 \u0451\u0439: &laquo;\u0414\u0430\u0439 \u041c\u043d\u0435 \u043f\u0456\u0446\u044c&raquo;. \u0412\u0443\u0447\u043d\u0456 \u0436 \u042f\u0433\u043e\u043d\u044b\u044f \u0430\u0434\u044b\u0448\u043b\u0456 \u045e \u0433\u043e\u0440\u0430\u0434 \u043a\u0443\u043f\u0456\u0446\u044c \u0435\u0436\u044b. \u0416\u0430\u043d\u0447\u044b\u043d\u0430 \u0441\u0430\u043c\u0430\u0440\u0430\u043d\u043a\u0430 \u043a\u0430\u0436\u0430 \u042f\u043c\u0443: &laquo;\u042f\u043a \u0422\u044b, \u044e\u0434\u044d\u0439, \u043f\u0440\u043e\u0441\u0456\u0448 \u043f\u0456\u0446\u044c \u0443 \u043c\u044f\u043d\u0435, \u0441\u0430\u043c\u0430\u0440\u0430\u043d\u043a\u0456? \u0411\u043e \u044e\u0434\u044d\u0456 \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u0437\u043d\u043e\u0441\u0456\u043d \u0437 \u0441\u0430\u043c\u0430\u0440\u0430\u043d\u0430\u043c\u0456&raquo; (\u042f\u043d 4, 7-9).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0430\u0447\u044b\u0446\u0435 \u0456\u043d\u0448\u0430\u0437\u0435\u043c\u0446\u0430\u045e? \u0413\u0430\u0431\u0440\u044d\u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0456\u0445\u043d\u0456\u043c \u043f\u043e\u0441\u0443\u0434\u0430\u043c. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u043d\u0435\u0441\u043b\u0430 \u0437 \u0441\u0430\u0431\u043e\u044e \u0437\u0431\u0430\u043d, \u043a\u0430\u0431 \u0447\u044d\u0440\u043f\u0430\u0446\u044c \u0432\u0430\u0434\u0443, \u0437\u0434\u0437\u0456\u0432\u0456\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u044e\u0434\u044d\u0439 \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u045e \u0443 \u044f\u0435 \u043f\u0456\u0446\u044c. \u042e\u0434\u044d\u0456 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u043d\u0435 \u0440\u0430\u0431\u0456\u043b\u0456 \u0433\u044d\u0442\u0430\u0433\u0430. \u0410 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u0430\u0441\u0456\u045e \u043f\u0456\u0446\u044c, \u0430\u0434\u0447\u0443\u0432\u0430\u045e \u0441\u043c\u0430\u0433\u0443 \u0432\u0435\u0440\u044b \u0441\u0430\u043c\u043e\u0439 \u0436\u0430\u043d\u0447\u044b\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0445\u0442\u043e \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0443 \u044f\u0435 \u043f\u0456\u0446\u044c: &laquo;\u0415\u0437\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u0439 \u0443 \u0430\u0434\u043a\u0430\u0437: \u041a\u0430\u043b\u0456 \u0431 \u0442\u044b \u0432\u0435\u0434\u0430\u043b\u0430 \u0434\u0430\u0440 \u0411\u043e\u0436\u044b \u0456 \u0445\u0442\u043e \u043a\u0430\u0436\u0430 \u0442\u0430\u0431\u0435: &ldquo;\u0414\u0430\u0439 \u043c\u043d\u0435 \u043f\u0456\u0446\u044c&rdquo;, \u0442\u043e \u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u0431 \u0443 \u042f\u0433\u043e, \u0456 \u0401\u043d \u0431\u044b \u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b&raquo; (\u042f\u043d 4, 10).<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u043f\u0456\u0446\u044c \u0456 \u0430\u0431\u044f\u0446\u0430\u0435 \u043d\u0430\u043f\u0430\u0456\u0446\u044c. \u0401\u043d \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u044f\u043a \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u044b\u043d\u044f\u0446\u044c, \u0456 \u043c\u0430\u0435 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u044b \u0437\u0430\u043f\u0430\u0441 \u044f\u043a \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u044c. &laquo;\u041a\u0430\u043b\u0456 \u0431 \u0442\u044b \u0432\u0435\u0434\u0430\u043b\u0430, &ndash; \u043a\u0430\u0436\u0430, &ndash; \u0434\u0430\u0440 \u0411\u043e\u0436\u044b&raquo;. \u0414\u0430\u0440 \u0411\u043e\u0436\u044b &ndash; \u0433\u044d\u0442\u0430 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b. \u0410\u0434\u043d\u0430\u043a, \u043f\u0430\u043a\u0443\u043b\u044c \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0437 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u0439 \u0437\u0430\u0433\u0430\u0434\u043a\u0430\u0432\u0430 \u0456 \u043f\u0430\u0432\u043e\u043b\u0456 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e \u044f\u0435 \u0441\u044d\u0440\u0446\u0430. \u041c\u0430\u0433\u0447\u044b\u043c\u0430, \u0401\u043d \u0443\u0436\u043e \u0432\u0443\u0447\u044b\u0446\u044c \u044f\u0435. \u0411\u043e \u0448\u0442\u043e \u0441\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u0430\u0435 \u0456 \u043c\u0456\u043b\u0435\u0439\u0448\u0430\u0435 \u0437\u0430 \u0433\u044d\u0442\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0431 \u0442\u044b \u0432\u0435\u0434\u0430\u043b\u0430 \u0434\u0430\u0440 \u0411\u043e\u0436\u044b \u0456 \u0445\u0442\u043e \u043a\u0430\u0436\u0430 \u0442\u0430\u0431\u0435 &ldquo;\u0434\u0430\u0439 \u041c\u043d\u0435 \u043f\u0456\u0446\u044c&rdquo;, \u0442\u043e \u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u0431 \u0443 \u042f\u0433\u043e, \u0456 \u0401\u043d \u0431\u044b \u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u043e\u0439 \u0436\u0430 \u0432\u0430\u0434\u044b \u0401\u043d \u0434\u0430\u045e \u0431\u044b, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u043e\u0439, \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0423 \u0422\u0430\u0431\u0435 &ndash; \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f&raquo; (\u041f\u0441 36 [35], 10), \u0456 \u044f\u043a\u043e\u0439 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e &laquo;\u043d\u0430\u0441\u044b\u0447\u0430\u0435\u0446\u0446\u0430 \u0442\u0443\u043a\u0430\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443&raquo; (\u041f\u0441 36 [35], 9)?<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u0430\u0431\u044f\u0446\u0430\u045e \u043d\u0430\u0442\u0430\u043b\u0456\u0446\u044c \u0456 \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u044c \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0430\u043b\u0435 \u044f\u043d\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u044f\u0448\u0447\u044d \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430. \u0410\u0434\u043d\u0430\u043a, \u0448\u0442\u043e \u044f\u043d\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430, \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0447\u044b? \u0416\u0430\u043d\u0447\u044b\u043d\u0430 \u043a\u0430\u0436\u0430 \u042f\u043c\u0443: &laquo;\u0414\u0430\u0439 \u043c\u043d\u0435 \u0433\u044d\u0442\u0430\u0439 \u0432\u0430\u0434\u044b, \u043a\u0430\u0431 \u044f \u043d\u0435 \u043c\u0435\u043b\u0430 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430\u0433\u0456 \u0456 \u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0441\u044e\u0434\u044b \u0447\u044d\u0440\u043f\u0430\u0446\u044c&raquo; (\u042f\u043d 4, 15). \u041d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0437\u043c\u0443\u0448\u0430\u043b\u0430 \u044f\u0435 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c, \u0430 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u043b\u0430 \u044f\u0435 \u0430\u0434 \u043f\u0440\u0430\u0446\u044b. \u041d\u044f\u0445\u0430\u0439 \u0431\u044b \u044f\u043d\u0430 \u043f\u0430\u0447\u0443\u043b\u0430: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435, \u0443\u0441\u0435 \u0441\u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0456 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0430\u043d\u044b\u044f, \u0456 \u042f \u0441\u0443\u043f\u0430\u043a\u043e\u044e \u0432\u0430\u0441&raquo; (\u041c\u0446 11, 28). \u0423\u043b\u0430\u0441\u043d\u0430 \u0433\u044d\u0442\u0430 \u0451\u0439 \u043a\u0430\u0437\u0430\u045e \u0415\u0437\u0443\u0441: \u043a\u0430\u0431 \u044f\u043d\u0430 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043b\u0430. \u0410\u043b\u0435 \u044f\u043d\u0430 \u044f\u0448\u0447\u044d \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430 \u0433\u044d\u0442\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042f\u043d 7, 37-39; 4, 13<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0437\u0443\u0441 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e: \u0425\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435 \u0456 \u043f&rsquo;\u0435. \u0425\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u041c\u044f\u043d\u0435, \u0443 \u0442\u0430\u0433\u043e \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u043f\u0430\u0446\u044f\u043a\u0443\u0446\u044c \u0440\u044d\u043a\u0456 \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0413\u044d\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u043d \u043f\u0440\u0430 \u0414\u0443\u0445\u0430, \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u043b\u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0443 \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u043f\u0456\u0446\u044c \u0432\u0430\u0434\u0443, \u044f\u043a\u0443\u044e \u042f \u0434\u0430\u043c \u044f\u043c\u0443, \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u0435 \u0441\u043c\u0430\u0433\u0456 \u043d\u0430\u0432\u0435\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u043d \u043f\u0440\u0430 \u0414\u0443\u0445\u0430, \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u043b\u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0443 \u042f\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"532","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u0411\u0430\u0437\u044b\u043b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 20, De humilitate, 3: PG 31, 530-531)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041d\u044f\u0445\u0430\u0439 \u043c\u0443\u0434\u0440\u044d\u0446 \u043d\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0441\u0432\u0430\u0451\u0439, \u043c\u043e\u0446\u043d\u044b \u0445\u0430\u0439 \u043d\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0441\u0432\u0430\u0451\u044e \u0441\u0456\u043b\u0430\u0439, \u0430 \u0431\u0430\u0433\u0430\u0442\u044b \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c&raquo; (\u043f\u0430\u0440. \u0415\u0440 9, 22-23).<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0447\u044b\u043c \u0436\u0430 \u043f\u0430-\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0456 \u045e \u0447\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0456? \u0411\u043e\u0433 \u043a\u0430\u0436\u0430: &laquo;\u041d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0442\u044b\u043c, \u0448\u0442\u043e \u043f\u0430\u0437\u043d\u0430\u0435 \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435, \u0448\u0442\u043e \u042f \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0437\u043d\u0451\u0441\u043b\u0430\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u0433\u043e \u0445\u0432\u0430\u043b\u0430 \u0456 \u0432\u0435\u043b\u0456\u0447 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u044e\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c, \u0448\u0442\u043e \u043d\u0430\u0441\u0430\u043c\u0440\u044d\u0447 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u043c, \u043a\u0430\u0431 \u043f\u0440\u044b\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u0446\u0430 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0456 \u0448\u0443\u043a\u0430\u0446\u044c \u0441\u043b\u0430\u0432\u044b \u045e \u041f\u0430\u043d\u0430 \u0445\u0432\u0430\u043b\u044b. \u041f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043a\u0430\u0436\u0443\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430: &laquo;\u0425\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443&raquo;, \u0431\u043e, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0442\u0430\u0433\u043e \u0436 \u0441\u0432. \u041f\u0430\u045e\u043b\u0430, &laquo;\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0430\u0434 \u0411\u043e\u0433\u0430, \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0456 \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435\u043c, \u0456 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435\u043c, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u0425\u0442\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443&raquo; (1 \u041a\u0430\u0440 1, 31).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0456 \u0451\u0441\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f \u0456 \u043f\u043e\u045e\u043d\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u045e \u0411\u043e\u0433\u0443, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043d\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044e, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0451\u043d \u043d\u0430\u0441\u0430\u043c\u0440\u044d\u0447 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u0440\u0430\u0439 \u0443 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043b\u0430\u0441\u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0456 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, \u044f\u043a\u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044e \u0456 \u0448\u0443\u043a\u0430\u0435 \u0442\u043e\u0439, \u044f\u043a\u0443\u044e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430: \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044e \u0430\u0434 \u0411\u043e\u0433\u0430, \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044e \u0430\u0434 \u0432\u0435\u0440\u044b. \u0422\u0430\u043a \u0451\u043d \u043f\u0430\u0437\u043d\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043c\u043e\u0446 \u042f\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f, \u0431\u044f\u0440\u044d \u045e\u0434\u0437\u0435\u043b \u0443 \u042f\u0433\u043e \u043f\u0430\u043a\u0443\u0442\u0430\u0445, \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u045e\u0448\u044b\u0441\u044f \u0434\u0430 \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u0456, \u043a\u0430\u0431 \u0445\u043e\u0446\u044c \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0442\u0443\u0442 \u0437\u043d\u0456\u043a\u0430\u0435 \u045e\u0441\u044f \u043d\u0430\u0434\u0437\u044c\u043c\u0443\u0442\u0430\u0441\u0446\u044c \u043f\u044b\u0445\u0456. \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430, \u0442\u0430\u0431\u0435 \u043d\u044f\u043c\u0430 \u0447\u044b\u043c \u043f\u0430\u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430. \u0422\u0432\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u0456 \u043d\u0430\u0434\u0437\u0435\u044f \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u044e\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u0443\u0442\u0430\u0439\u043c\u043e\u045e\u0432\u0430\u0446\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u0442\u0432\u0430\u0451, \u0456 \u0448\u0443\u043a\u0430\u0446\u044c \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435. \u041c\u044b \u043c\u0430\u0435\u043c \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u045e\u0436\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c\u0441\u044f \u045e \u0456\u043c, \u0436\u044b\u0432\u0443\u0447\u044b \u0446\u0430\u043b\u043a\u0430\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u0430\u0441\u0446\u044b \u0456 \u0434\u0430\u0440\u0443 \u0411\u043e\u0436\u0430\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0413\u044d\u0442\u0430 \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0443 \u0432\u0430\u0441 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0456 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f&raquo; (\u0424\u043b\u043f 2, 13). \u0411\u043e\u0433 \u0430\u0431&rsquo;\u044f\u045e\u043b\u044f\u0435 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u044e, \u044f\u043a\u0443\u044e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0439 \u0445\u0432\u0430\u043b\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u0434\u0430\u0435 \u043d\u0430\u043c \u0441\u0456\u043b\u044b \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c \u0443 \u043f\u0440\u0430\u0446\u044b. &laquo;\u042f \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0456\u0445 \u0443\u0441\u0456\u0445, &ndash; \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, &ndash; \u0434\u044b \u0456 \u043d\u0435 \u044f, \u0430 \u043b\u0430\u0441\u043a\u0430 \u0411\u043e\u0436\u0430\u044f, \u0448\u0442\u043e \u0441\u0430 \u043c\u043d\u043e\u044e&raquo; (1 \u041a\u0430\u0440 15, 10).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u0440\u0430\u0442\u0443\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0430\u0434 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0456 \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u0443\u0441\u044f\u043a\u0430\u0439 \u043b\u044e\u0434\u0441\u043a\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456. \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: &laquo;\u0421\u0430\u043c\u0456 \u045e \u0441\u0430\u0431\u0435 \u043c\u044b \u043c\u0435\u043b\u0456 \u043f\u0440\u044b\u0441\u0443\u0434 \u0441\u043c\u0435\u0440\u0446\u0456, \u043a\u0430\u0431 \u0443\u0441\u043a\u043b\u0430\u0434\u0430\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0435 \u043d\u0430 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u0430 \u043d\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u0430\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. \u0401\u043d \u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u043d\u0430\u0441 \u0456 \u0440\u0430\u0442\u0443\u0435 \u0430\u0434 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043f\u0430\u0433\u0440\u043e\u0437\u044b \u0441\u043c\u0435\u0440\u0446\u0456. \u041d\u0430 \u042f\u0433\u043e \u043c\u044b \u045e\u0441\u043a\u043b\u0430\u0434\u0430\u0435\u043c \u043d\u0430\u0434\u0437\u0435\u044e, \u0448\u0442\u043e \u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0441&raquo; (2 \u041a\u0430\u0440 1, 10).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0434\u0440 15, 3; \u042f\u043d 17. 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0436\u0430, \u0432\u0435\u0434\u0430\u0446\u044c \u0426\u044f\u0431\u0435 &ndash; \u0433\u044d\u0442\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. <span style=\"color: #ff0000;\">*<\/span> \u0423 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456 \u0422\u0432\u0430\u0451\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043c\u043e\u0446\u044b \u043a\u0430\u0440\u0430\u043d\u0456\u0446\u0446\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0426\u044f\u0431\u0435, \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456 \u0422\u0432\u0430\u0451\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043c\u043e\u0446\u044b \u043a\u0430\u0440\u0430\u043d\u0456\u0446\u0446\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_2_ID":"533","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u0425\u0440\u044b\u0437\u0430\u043b\u043e\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 43: PL 52, 320. 322)<\/span><br \/><span style=\"color: #ff0000;\">\u0422\u043e\u0435, \u0448\u0442\u043e \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u0435 \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u0434\u0430\u0441\u044f\u0433\u0430\u0435 \u043f\u043e\u0441\u0442, \u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u0451\u0441\u0446\u044c \u0442\u0440\u044b \u0440\u044d\u0447\u044b, \u043d\u0430 \u044f\u043a\u0456\u0445 \u0433\u0440\u0443\u043d\u0442\u0443\u0435\u0446\u0446\u0430 \u0432\u0435\u0440\u0430, \u043d\u0430 \u044f\u043a\u0456\u044f \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c, \u0442\u0440\u044b\u0432\u0430\u0435 \u0446\u043d\u043e\u0442\u0430: \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u043f\u043e\u0441\u0442 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u0422\u043e\u0435, \u0448\u0442\u043e \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u0435 \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u0434\u0430\u0441\u044f\u0433\u0430\u0435 \u043f\u043e\u0441\u0442, \u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435. \u041c\u0430\u043b\u0456\u0442\u0432\u0430, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u043e\u0441\u0442 &ndash; \u0432\u043e\u0441\u044c \u0442\u0440\u044b \u0440\u044d\u0447\u044b, \u044f\u043a\u0456\u044f \u0434\u0430\u044e\u0446\u044c \u0430\u0434\u043d\u0430 \u0430\u0434\u043d\u043e\u0439 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u0448\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u044b &ndash; \u0433\u044d\u0442\u0430 \u043f\u043e\u0441\u0442, \u0430 \u0436\u044b\u0446\u0446\u0451 \u043f\u043e\u0441\u0442\u0443 &ndash; \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u0456\u0445 \u043d\u0435 \u0440\u0430\u0437\u0440\u044b\u0432\u0430\u0435, \u0431\u043e \u0456\u0445 \u043d\u0435\u043b\u044c\u0433\u0430 \u0430\u0434\u0434\u0437\u044f\u043b\u0456\u0446\u044c. \u0425\u0442\u043e \u043c\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043d\u0443 \u0437 \u0456\u0445 \u0430\u0431\u043e \u043d\u0435 \u043c\u0430\u0435 \u045e\u0441\u044f\u0433\u043e \u0440\u0430\u0437\u0430\u043c, \u0442\u043e\u0439 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043c\u0430\u0435. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0445\u0442\u043e \u043c\u043e\u043b\u0456\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u043f\u043e\u0441\u0446\u0456\u0446\u044c, \u0430 \u0445\u0442\u043e \u043f\u043e\u0441\u0446\u0456\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u0432\u044b\u0441\u043b\u0443\u0445\u043e\u045e\u0432\u0430\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u045e \u043f\u0440\u043e\u0441\u044c\u0431\u0435 \u0441\u0432\u0430\u0451\u0439 \u0445\u043e\u0447\u0430 \u0431\u044b\u0446\u044c \u043f\u0430\u0447\u0443\u0442\u044b\u043c. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0451\u043d \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0432\u0443\u0448\u044b \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u0456\u0445 \u043d\u0430 \u0433\u043e\u043b\u0430\u0441 \u043f\u0440\u0430\u0448\u044d\u043d\u043d\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u043e\u0441\u0446\u0456\u0446\u044c, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u043f\u043e\u0441\u0442. \u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435 \u0433\u0430\u043b\u043e\u0434\u043d\u0430\u0433\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u0411\u043e\u0433 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u045e \u0456 \u044f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0434. \u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u0425\u0442\u043e \u0448\u0443\u043a\u0430\u0435 \u0437\u044b\u0447\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043d\u044f\u0445\u0430\u0439 \u0441\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0437\u044b\u0447\u043b\u0456\u0432\u044b. \u0425\u0442\u043e \u0445\u043e\u0447\u0430 \u043d\u0435\u0448\u0442\u0430 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u0430\u043c \u0434\u0430\u0432\u0430\u0446\u044c. \u041d\u044f\u0433\u043e\u0434\u043d\u0430 \u0436 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0442\u0430\u0433\u043e, \u0443 \u0447\u044b\u043c \u0441\u0430\u043c \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u0435\u0448 \u0456\u043d\u0448\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430, \u043d\u044f\u0445\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0441\u0442\u0430\u043d\u0435 \u0442\u0432\u0430\u0456\u043c \u043f\u0440\u0430\u0432\u0456\u043b\u0430\u043c. \u0422\u0430\u0434\u044b \u0456 \u0442\u044b \u0432\u0435\u043b\u044c\u043c\u0456 \u0445\u0443\u0442\u043a\u0430 \u0456 \u0442\u0430\u043a, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0445\u043e\u0447\u0430\u0448, \u0437\u0432\u0435\u0434\u0430\u0435\u0448 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u0411\u0443\u0434\u0437\u044c \u0436\u0430 \u0456 \u0441\u0430\u043c \u0442\u0430\u043a\u0456\u043c \u0436\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c \u0434\u0430 \u0456\u043d\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u043e\u0441\u0442 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0448\u0430\u0439 \u0430\u0434\u0437\u0456\u043d\u0430\u0439 \u0430\u0431\u0430\u0440\u043e\u043d\u0430\u0439 \u0443 \u0411\u043e\u0433\u0430, \u043d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0448\u0430 \u0430\u0434\u0437\u0456\u043d\u0430\u0435 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430, \u0430\u0434\u0437\u0456\u043d\u0430\u044f \u0456 \u0442\u0440\u043e\u0445\u0441\u0443\u0442\u043d\u0430\u0441\u043d\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0437\u0430 \u043d\u0430\u0441. <br \/>\u0422\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0433\u0430\u0440\u0434\u0443, \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0442\u0430\u0440\u0430\u0446\u0446\u0430 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u043f\u0440\u0430\u0437 \u043f\u043e\u0441\u0442. \u0410\u0445\u0432\u044f\u0440\u0443\u0435\u043c \u043f\u0440\u0430\u0437 \u043f\u043e\u0441\u0442 \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0443 \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u0432\u0430\u0440\u0442\u0430\u0433\u0430, \u044f\u043a \u0433\u044d\u0442\u0430 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u043f\u0440\u0430\u0440\u043e\u043a, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0410\u0445\u0432\u044f\u0440\u0430 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 &ndash; \u0434\u0443\u0445 \u043f\u0430\u043a\u043e\u0440\u043d\u044b, \u0441\u044d\u0440\u0446\u0430\u043c \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0456 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u044b\u043c \u0422\u044b, \u0411\u043e\u0436\u0430, \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435\u0448&raquo; (\u041f\u0441 51 [50], 19).<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430, \u0430\u0445\u0432\u044f\u0440\u0443\u0439 \u0411\u043e\u0433\u0443 \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443 \u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0456 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0434\u0430\u0440 \u043f\u043e\u0441\u0442\u0443, \u043a\u0430\u0431 \u0451\u043d \u0441\u0442\u0430\u045e \u0447\u044b\u0441\u0442\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u0430\u0439, \u0441\u0432\u044f\u0442\u044b\u043c \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435\u043c \u0456 \u0436\u044b\u0432\u043e\u0439 \u0430\u0445\u0432\u044f\u0440\u0430\u0439, \u044f\u043a\u0430\u044f \u0456 \u045e \u0446\u044f\u0431\u0435 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430, \u0456 \u0430\u0434\u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0411\u043e\u0433\u0443. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0430\u0434\u043c\u043e\u0432\u0456\u0446\u044c \u0411\u043e\u0433\u0443 \u045e \u0433\u044d\u0442\u044b\u043c \u0434\u0430\u0440\u044b, \u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u044b, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u043d\u0435 \u043c\u0435\u0446\u044c \u0441\u044f\u0431\u0435 \u044f\u043a \u0434\u0430\u0440 \u0434\u043b\u044f \u0430\u0445\u0432\u044f\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u0431 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0456 \u043f\u043e\u0441\u0442 \u0431\u044b\u043b\u0456 \u043f\u0440\u044b\u043d\u044f\u0442\u044b\u044f, \u0456\u0445 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u041f\u043e\u0441\u0442 \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u043f\u043b\u0451\u043d\u0443, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0440\u043e\u0448\u0430\u043d\u044b \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e. \u0417\u0430\u0441\u0443\u0445\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u0437\u0430\u0441\u0443\u0445\u0443 \u043f\u043e\u0441\u0442\u0443. \u042f\u043a \u0434\u043e\u0436\u0434\u0436 \u0434\u043b\u044f \u0437\u044f\u043c\u043b\u0456, \u0442\u0430\u043a \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u043b\u044f \u043f\u043e\u0441\u0442\u0443. \u041f\u043e\u0441\u0442 \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u044f\u0433\u043e, \u0432\u044b\u043a\u0430\u0440\u0430\u043d\u044f\u0435 \u0437\u0430\u0433\u0430\u043d\u044b, \u0441\u0435\u0435 \u0446\u043d\u043e\u0442\u044b. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u043d\u0435\u0441\u0442\u0430\u0432\u0430\u0446\u044c \u043f\u0430\u0442\u043e\u043a\u0430\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u043e\u0441\u0446\u0456\u0446\u044c, \u043d\u0435 \u0437\u0431\u044f\u0440\u044d \u043f\u043b\u0430\u0434\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043f\u043e\u0441\u0446\u0456\u0448, \u043f\u0430\u043c\u044f\u0442\u0430\u0439, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043f\u043e\u0441\u0446\u0456\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0434\u044b\u043a \u043f\u043e\u0441\u0446\u0456\u0446\u044c \u0456 \u0442\u0432\u0430\u044f \u0440\u0430\u043b\u043b\u044f. \u0410 \u043a\u0430\u043b\u0456 \u0442\u044b \u0448\u0447\u043e\u0434\u0440\u044b \u043d\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0451\u044e \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0456 \u0442\u0432\u043e\u0439 \u0441\u0432\u0456\u0440\u0430\u043d. \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430, \u0433\u043b\u044f\u0434\u0437\u0456, \u043a\u0430\u0431 \u0442\u044b \u043d\u0435 \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u043f\u0440\u0430\u0437 \u0430\u0448\u0447\u0430\u0434\u043d\u0430\u0441\u0446\u044c, \u0430\u043b\u0435 \u043d\u0430\u0437\u0430\u043f\u0430\u0448\u0432\u0430\u0439, \u0440\u0430\u0437\u0434\u0430\u044e\u0447\u044b \u0456\u043d\u0448\u044b\u043c. \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430, \u0434\u0430\u044e\u0447\u044b \u045e\u0431\u043e\u0433\u0430\u043c\u0443, \u0434\u0430\u0432\u0430\u0439 \u044f\u043a \u0441\u0430\u043c\u043e\u043c\u0443 \u0441\u0430\u0431\u0435, \u0431\u043e \u0447\u0430\u0433\u043e \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435\u0448 \u0456\u043d\u0448\u0430\u043c\u0443, \u0442\u0430\u0433\u043e \u0456 \u0441\u0430\u043c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u043c\u0435\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0422\u0431 12, 8\u0430. 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u043e\u0431\u0440\u0430\u0439 \u0451\u0441\u0446\u044c \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0437 \u043f\u043e\u0441\u0442\u0430\u043c \u0456 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0430 \u0441\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e. <span style=\"color: #ff0000;\">*<\/span> \u042f\u043d\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b\u044f, \u0445\u0442\u043e \u0434\u0430\u0435 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443, \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0441\u044b\u0447\u0430\u043d\u044b \u0436\u044b\u0446\u0446\u0451\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043d\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"534","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 &laquo;\u0414\u0430 \u0410\u045e\u0442\u043e\u043b\u0456\u043a\u0430&raquo; \u0441\u0432. \u0422\u044d\u0430\u0444\u0456\u043b\u0430 \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 1, 2. 7: PG 6, 1026-1027, 1035)<\/span><br \/><span style=\"color: #ff0000;\">\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0447\u044b\u0441\u0442\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c, \u0431\u043e \u044f\u043d\u044b \u0411\u043e\u0433\u0430 \u045e\u0431\u0430\u0447\u0430\u0446\u044c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u043a\u0430\u0436\u0430\u0448: \u043f\u0430\u043a\u0430\u0436\u044b \u043c\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, &ndash; \u044f \u0430\u0434\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435: \u043f\u0430\u043a\u0430\u0436\u044b \u043c\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0456 \u044f \u043f\u0430\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u043f\u0430\u043a\u0430\u0436\u044b, \u0446\u0456 \u0432\u043e\u0447\u044b \u0442\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u044f \u0431\u0430\u0447\u044b\u0446\u044c, \u0430 \u0432\u0443\u0448\u044b \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u044f \u0447\u0443\u0446\u044c?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f, \u0445\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c \u0432\u0430\u0447\u044b\u043c\u0430 \u0446\u0435\u043b\u0430, \u0443\u0441\u043f\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u0437\u044f\u043c\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0456 \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0456\u043c \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u044e: \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u0446\u0435\u043c\u0440\u0443, \u0431\u0435\u043b\u0430\u0435 \u0456 \u0447\u043e\u0440\u043d\u0430\u0435, \u0430\u0433\u0456\u0434\u043d\u0430\u0435 \u0456 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0435, \u0433\u0430\u0440\u043c\u0430\u043d\u0456\u0447\u043d\u0430\u0435 \u0456 \u0431\u044f\u0437\u043b\u0430\u0434\u043d\u0430\u0435, \u0441\u0443\u0432\u044b\u043c\u0435\u0440\u043d\u0430\u0435 \u0456 \u043d\u0435\u0441\u0443\u0432\u044b\u043c\u0435\u0440\u043d\u0430\u0435, \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0447\u0430\u0441\u0442\u0430\u043a \u0456 \u043d\u0435\u0434\u0430\u0445\u043e\u043f. \u0413\u044d\u0442\u0430 \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0456 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e\u0441\u043f\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0441\u043b\u044b\u0445: \u0440\u044d\u0437\u043a\u0456\u044f \u0456 \u0433\u0440\u0443\u0431\u044b\u044f \u0430\u0431\u043e \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u044f \u0433\u0443\u043a\u0456. \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0432\u0443\u0448\u0430\u043c\u0456 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0432\u0430\u0447\u044b\u043c\u0430 \u0434\u0443\u0448\u044b, \u043a\u0430\u0431 \u044f\u043d\u044b \u043c\u0430\u0433\u043b\u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u0431\u0430\u0447\u043d\u044b \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u0433\u043e \u043c\u043e\u0436\u0430 \u0431\u0430\u0447\u044b\u0446\u044c, \u0443 \u043a\u0430\u0433\u043e \u0430\u0434\u043a\u0440\u044b\u0442\u044b \u0432\u043e\u0447\u044b \u0434\u0443\u0448\u044b. \u0425\u043e\u0446\u044c \u0432\u0430 \u045e\u0441\u0456\u0445 \u0451\u0441\u0446\u044c \u0432\u043e\u0447\u044b, \u0443 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445 \u044f\u043d\u044b \u0437\u0430\u0446\u044c\u043c\u0451\u043d\u044b\u044f \u0437\u043c\u0440\u043e\u043a\u0430\u043c \u0456 \u043d\u0435 \u0431\u0430\u0447\u0430\u0446\u044c \u0441\u043e\u043d\u0435\u0447\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430. \u041a\u0430\u043b\u0456 \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u044b \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c, \u0433\u044d\u0442\u0430 \u043d\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u0441\u043e\u043d\u0446\u0430 \u043d\u0435 \u0441\u0432\u0435\u0446\u0456\u0446\u044c, \u0430\u043b\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0451\u043d \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u043d\u0430 \u0441\u043b\u0435\u043f\u0430\u0442\u0443. \u0422\u0430\u043a \u0456 \u0432\u043e\u0447\u044b \u0442\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u0437\u0430\u0446\u044c\u043c\u0451\u043d\u044b\u044f \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u0442\u0432\u0430\u0456\u0445 \u0434\u0440\u044d\u043d\u043d\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u0434\u0443\u0448\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0447\u044b\u0441\u0442\u0430\u0439, \u044f\u043a \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u0430\u0435 \u043b\u044e\u0441\u0442\u0440\u0430. \u041a\u0430\u043b\u0456 \u044f\u043d\u043e \u043f\u0430\u043a\u0440\u044b\u043b\u0430\u0441\u044f \u0440\u0436\u043e\u0439, \u0443 \u0456\u043c \u043d\u0435\u043b\u044c\u0433\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0442\u0432\u0430\u0440\u0443. \u0422\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u043b\u0456 \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0431\u0443\u0434\u0437\u0435 \u0433\u0440\u044d\u0445, \u0451\u043d \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448, \u043c\u043e\u0436\u0430\u0448 \u0431\u044b\u0446\u044c \u0430\u0437\u0434\u0430\u0440\u043e\u045e\u043b\u0435\u043d\u044b\u043c: \u0434\u0430\u0432\u0435\u0440\u0441\u044f \u041b\u0435\u043a\u0430\u0440\u0443, \u0456 \u0401\u043d \u0432\u044b\u043b\u0435\u0447\u044b\u0446\u044c \u0432\u043e\u0447\u044b \u0442\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u0456 \u0441\u044d\u0440\u0446\u0430. \u0425\u0442\u043e \u0433\u044d\u0442\u044b \u041b\u0435\u043a\u0430\u0440? \u0411\u043e\u0433, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0441\u043b\u043e\u0432\u0430 \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043b\u0435\u0447\u044b\u0446\u044c \u0456 \u0430\u0436\u044b\u045e\u043b\u044f\u0435. \u0421\u043b\u043e\u0432\u0430\u043c \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0411\u043e\u0433 \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u045e \u0443\u0441\u0451, \u0431\u043e &laquo;\u0441\u043b\u043e\u0432\u0430\u043c \u041f\u0430\u043d\u0430 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u043d\u044f\u0431\u0451\u0441\u044b, \u0434\u044b\u0445\u0430\u043d\u043d\u0435\u043c \u042f\u0433\u043e \u0432\u0443\u0441\u043d\u0430\u045e &ndash; \u0443\u0441\u044f \u0456\u0445\u043d\u044f\u044f \u043c\u043e\u0446&raquo; (\u041f\u0441 33 [32], 6). \u042f\u0433\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0432\u044b\u0448\u044d\u0439\u0448\u0430\u044f \u0437\u0430 \u045e\u0441\u0451. \u0417 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0411\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0437\u044f\u043c\u043b\u044e \u0456 \u043d\u044f\u0431\u0451\u0441\u044b. \u042f\u0433\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0430\u0434\u043a\u0440\u044b\u043b\u0430 \u0431\u0435\u0437\u0434\u0430\u043d\u044c \u0456 \u0445\u043c\u0430\u0440\u044b \u043f\u0440\u0430\u043b\u0456\u043b\u0456 \u0440\u0430\u0441\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0448 \u0433\u044d\u0442\u0430, \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430, \u0456 \u0436\u044b\u0432\u0435\u0448 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430, \u0441\u0432\u044f\u0442\u0430 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u0442\u044b \u043c\u043e\u0436\u0430\u0448 \u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430. \u0410\u043b\u0435 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u045e \u0442\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u0432\u0435\u0440\u0430 \u0456 \u0431\u043e\u044f\u0437\u044c \u0411\u043e\u0436\u0430\u044f. \u0422\u0430\u0434\u044b \u0433\u044d\u0442\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0448. \u041a\u0430\u043b\u0456 \u0437\u0434\u044b\u043c\u0435\u0448 \u0437 \u0441\u044f\u0431\u0435 \u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c \u0456 \u0430\u043f\u0440\u0430\u043d\u0435\u0448\u0441\u044f \u045e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u0442\u0430\u0434\u044b \u045e\u0431\u0430\u0447\u044b\u0448 \u0411\u043e\u0433\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0442\u0432\u0430\u0456\u0445 \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u045e. \u0411\u043e\u0433 \u0430\u0431\u0443\u0434\u0437\u0456\u0446\u044c \u0442\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u0437 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0439 \u0434\u0443\u0448\u043e\u044e, \u0456 \u0442\u0430\u0434\u044b, \u0441\u0442\u0430\u045e\u0448\u044b \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c, \u0442\u044b \u045e\u0431\u0430\u0447\u044b\u0448 \u041d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430, \u043a\u0430\u043b\u0456 \u0446\u044f\u043f\u0435\u0440 \u042f\u043c\u0443 \u043f\u0430\u0432\u0435\u0440\u044b\u0448.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 2 \u041a\u0430\u0440 6, 2. 4. 5. 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440 \u0447\u0430\u0441 \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b, \u0432\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440 \u0434\u0437\u0435\u043d\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f: \u0434\u044b\u043a \u043f\u0440\u0430\u044f\u0432\u0456\u043c \u0441\u044f\u0431\u0435 \u045e \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u045e \u043f\u043e\u0441\u0446\u0435, <span style=\"color: #ff0000;\">*<\/span> \u0441\u0430 \u0437\u0431\u0440\u043e\u044f\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043c\u043e\u0446\u044b \u0411\u043e\u0436\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0430 \u045e\u0441\u0456\u043c \u0431\u0443\u0434\u0437\u0435\u043c \u044f\u043a \u0441\u043b\u0443\u0433\u0456 \u0411\u043e\u0436\u044b\u044f: \u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u045e \u043f\u043e\u0441\u0446\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0430 \u0437\u0431\u0440\u043e\u044f\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043c\u043e\u0446\u044b \u0411\u043e\u0436\u0430\u0439.<\/p>\r\n"}, {"GCH_CH_2_ID":"535","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443&raquo; \u0422\u044d\u0440\u0442\u0443\u043b\u0456\u044f\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 28-29: CCL 1, 273-274)<\/span><br \/><span style=\"color: #ff0000;\">\u0414\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u043b\u0456\u0442\u0432\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430, \u044f\u043a\u0430\u044f \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u043b\u0430 \u043a\u043e\u043b\u0456\u0448\u043d\u0456\u044f \u0430\u0445\u0432\u044f\u0440\u0430\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0456. &laquo;\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u041c\u043d\u0435 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u0432\u0430\u0448\u044b? &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. &ndash; \u042f \u0441\u044b\u0442\u044b \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f\u043c\u0456 \u0431\u0430\u0440\u0430\u043d\u043e\u045e \u0456 \u0442\u0443\u043a\u0430\u043c \u0430\u0434\u043a\u043e\u0440\u043c\u043b\u0435\u043d\u044b\u0445 \u0436\u044b\u0432\u0451\u043b. \u042f \u043d\u0435 \u0445\u0430\u0447\u0443 \u043a\u0440\u044b\u0432\u0456 \u0446\u044f\u043b\u044f\u0442, \u044f\u0433\u043d\u044f\u0442 \u0456 \u043a\u0430\u0437\u043b\u043e\u045e&raquo; (\u0406\u0441 1, 11). &laquo;\u041a\u0430\u043b\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0435\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u041c\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c, \u0445\u0442\u043e \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0430\u0434 \u0432\u0430\u0441?&raquo; (\u043f\u0430\u0440. \u0406\u0441 1, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0448\u0443\u043a\u0430\u045e \u0411\u043e\u0433, \u043a\u0430\u0436\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435. &laquo;\u041d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0433\u0430\u0434\u0437\u0456\u043d\u0430, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u0456 \u0446\u044f\u043f\u0435\u0440 \u0443\u0436\u043e \u0451\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u0410\u0439\u0446\u0443 \u045e \u0414\u0443\u0445\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u0406 \u0442\u0430\u043a\u0456\u0445 \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0430\u045e \u0448\u0443\u043a\u0430\u0435 \u0441\u0430\u0431\u0435 \u0410\u0439\u0446\u0435\u0446. \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0414\u0443\u0445\u0430\u043c, \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u0446\u0446\u0430 \u042f\u043c\u0443, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u045e \u0414\u0443\u0445\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435&raquo; (\u042f\u043d 4, 23-24).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u044b \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0441\u0432\u044f\u0442\u0430\u0440\u044b, \u044f\u043a\u0456\u044f, \u043c\u043e\u043b\u044f\u0447\u044b\u0441\u044f \u045e \u0434\u0443\u0445\u0443, \u0430\u0445\u0432\u044f\u0440\u0443\u0435\u043c \u0443 \u0434\u0443\u0445\u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u044f\u043a \u043f\u0440\u044b\u0435\u043c\u043d\u0443\u044e \u0456 \u043d\u0430\u043b\u0435\u0436\u043d\u0443\u044e \u0411\u043e\u0433\u0443 \u0430\u0445\u0432\u044f\u0440\u0443, \u044f\u043a\u043e\u0439 \u0401\u043d \u0441\u0430\u043c \u0448\u0443\u043a\u0430\u045e \u0456 \u044f\u043a\u0443\u044e \u0437\u044b\u0447\u044b\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0443\u044e \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u045e \u0431\u0430\u0433\u0430\u0442\u044b\u043c \u0441\u0443\u043f\u0440\u0430\u0432\u0430\u0434\u0436\u044d\u043d\u043d\u0456 \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u0441\u044f\u0440\u043e\u0434 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e \u0456 \u0433\u0456\u043c\u043d\u0430\u045e \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0430\u043b\u0442\u0430\u0440\u0430. \u042f\u043d\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0448\u0447\u044b\u0440\u0430\u0439, \u043d\u0430\u0441\u044b\u0447\u0430\u043d\u0430\u0439 \u0432\u0435\u0440\u0430\u0439, \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u0430\u0439 \u043f\u0440\u0430\u045e\u0434\u0430\u0439; \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u0456; \u0447\u044b\u0441\u0442\u0430\u0439 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0456 \u045e\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e. \u041c\u0430\u043b\u0456\u0442\u0432\u0430\u0439, \u044f\u043a\u0430\u044f \u043c\u043e\u0436\u0430 \u0432\u044b\u043f\u0440\u0430\u0441\u0456\u0446\u044c \u043d\u0430\u043c \u0430\u0434 \u0411\u043e\u0433\u0430 \u045e\u0441\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0456\u0431\u0430 \u043c\u043e\u0436\u0430 \u0411\u043e\u0433 \u0430\u0434\u043c\u043e\u0432\u0456\u0446\u044c \u0443 \u043d\u0435\u0447\u044b\u043c \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u044f\u043a\u0430\u044f \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u045e \u0434\u0443\u0445\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435? \u041c\u044b \u0447\u044b\u0442\u0430\u0435\u043c, \u0447\u0443\u0435\u043c \u0456 \u0432\u0435\u0440\u044b\u043c, \u044f\u043a\u0456\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0456 \u044f\u0435 \u0434\u0437\u0435\u0439\u0441\u043d\u0430\u0441\u0446\u0456!<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0432\u0430\u0442 \u0441\u0442\u0430\u0440\u0430\u0437\u0430\u043f\u0430\u0432\u0435\u0442\u043d\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u043b\u0430 \u0430\u0434 \u0430\u0433\u043d\u044e, \u0434\u0437\u0456\u043a\u0456\u0445 \u0437\u0432\u044f\u0440\u043e\u045e \u0456 \u0433\u043e\u043b\u0430\u0434\u0443, \u0445\u043e\u0446\u044c \u043d\u0435 \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0430\u0431\u044b\u043b\u0430 \u0441\u0432\u0430\u044e \u0444\u043e\u0440\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0431\u043e\u043b\u044c\u0448\u044b\u044f \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b! \u042f\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0430\u043d\u0451\u043b\u0430 \u0440\u0430\u0441\u044b \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0430\u0433\u043d\u044e, \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u043f\u0430\u0448\u0447\u044b \u043b\u044c\u0432\u0430\u043c, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0437\u0433\u0430\u043b\u0430\u0434\u0430\u043b\u044b\u043c \u0435\u0436\u0443 \u0430\u0434 \u0432\u044f\u0441\u043a\u043e\u045e\u0446\u0430\u045e \u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u044f\u0435 \u043f\u0440\u0430\u0437 \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u0443\u044e \u043b\u0430\u0441\u043a\u0443 \u0430\u0434 \u043f\u0430\u0447\u0443\u0446\u0446\u044f \u0431\u043e\u043b\u044e, \u0430\u043b\u0435 \u044f\u043d\u0430 \u0434\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u0432\u0435\u0434\u0432\u0430\u0435 \u043c\u0443\u043a\u0456, \u043f\u0430\u043a\u0443\u0442\u044b \u0456 \u0431\u043e\u043b\u044c; \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435 \u043b\u0430\u0441\u043a\u0443 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u0432\u0435\u0440\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0430\u043f\u0443\u0441\u043a\u0430\u0435 \u0411\u043e\u0433, \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0448\u0442\u043e \u044f\u043d\u0430 \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0443 \u0456\u043c\u044f \u0411\u043e\u0436\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u043d\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0456, \u0440\u0430\u0437\u0433\u0430\u043d\u044f\u043b\u0430 \u0432\u0430\u0440\u043e\u0436\u044b\u044f \u0432\u043e\u0439\u0441\u043a\u0456 \u0456 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0430 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b \u0434\u043e\u0436\u0434\u0436. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u045e\u0445\u0456\u043b\u044f\u0435 \u045e\u0441\u044f\u043a\u0456 \u0433\u043d\u0435\u045e \u0411\u043e\u0436\u044b, \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430 \u0440\u0443\u043f\u0456\u0446\u0446\u0430 \u0430\u0431 \u0432\u043e\u0440\u0430\u0433\u0430\u0445 \u0456 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u044f\u045e. \u0425\u0456\u0431\u0430 \u0434\u0437\u0456\u045e\u043d\u0430, \u0448\u0442\u043e \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u044f\u043a\u0430\u044f \u043c\u0430\u0433\u043b\u0430 \u043d\u0430\u0432\u0435\u0441\u0446\u0456 \u0430\u0433\u043e\u043d\u044c, \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u044f \u0432\u044b\u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0434\u043e\u0436\u0434\u0436 \u0437 \u043d\u0435\u0431\u0430? \u0422\u043e\u043b\u044c\u043a\u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0451\u0441\u0446\u044c \u0442\u044b\u043c, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0435 \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0445\u0430\u0446\u0435\u045e, \u043a\u0430\u0431 \u043f\u0440\u044b \u044f\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u043d\u0435 \u0440\u0430\u0431\u0456\u043b\u0430\u0441\u044f \u043d\u0456\u0447\u043e\u0433\u0430 \u0437\u043b\u043e\u0433\u0430, \u0456 \u0442\u0430\u043c\u0443 \u0434\u0430\u045e \u0451\u0439 \u0443\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u043d\u0443\u044e \u043c\u043e\u0446.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u044f\u043d\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u0456\u043d\u0448\u0430\u0433\u0430, \u044f\u043a \u0432\u044f\u0440\u0442\u0430\u0446\u044c \u0434\u0443\u0448\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0441\u0430 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0448\u043b\u044f\u0445\u0443, \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0446\u044c \u0441\u043b\u0430\u0431\u044b\u0445, \u043b\u044f\u0447\u044b\u0446\u044c \u0445\u0432\u043e\u0440\u044b\u0445, \u0432\u044b\u0433\u0430\u043d\u044f\u0446\u044c \u0437\u043b\u044b\u0445 \u0434\u0443\u0445\u0430\u045e, \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0446\u044c \u0437\u0430\u0441\u043e\u0432\u044b \u0432\u044f\u0437\u043d\u0456\u0446\u044b \u0456 \u0440\u0430\u0437\u0440\u044b\u0432\u0430\u0446\u044c \u043a\u0430\u0439\u0434\u0430\u043d\u044b \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u044b\u0445. \u042f\u043d\u0430 \u0436 \u0430\u0431\u043c\u044b\u0432\u0430\u0435 \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e, \u0430\u0434\u0433\u0430\u043d\u044f\u0435 \u0441\u043f\u0430\u043a\u0443\u0441\u044b, \u0433\u0430\u0441\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434, \u0441\u0443\u0446\u044f\u0448\u0430\u0435 \u0433\u0430\u0440\u043e\u0442\u043d\u044b\u0445, \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u0435 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u044b\u0445, \u0441\u0443\u043f\u0440\u0430\u0432\u0430\u0434\u0436\u0430\u0435 \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0430\u045e, \u0441\u0443\u043d\u0456\u043c\u0430\u0435 \u0432\u043e\u0434\u043d\u044b\u044f \u043f\u0430\u0442\u043e\u043a\u0456, \u043f\u0430\u0440\u0430\u043b\u0456\u0437\u0443\u0435 \u0437\u043b\u043e\u0434\u0437\u0435\u044f\u045e, \u043a\u043e\u0440\u043c\u0456\u0446\u044c \u0443\u0431\u043e\u0433\u0456\u0445, \u043a\u0456\u0440\u0443\u0435 \u0431\u0430\u0433\u0430\u0442\u044b\u043c\u0456, \u043f\u0430\u0434\u044b\u043c\u0430\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u045e\u043f\u0430\u045e; \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u043c\u043e\u0436\u0430 \u045e\u043f\u0430\u0441\u0446\u0456; \u0456 \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u0442\u0430\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043e\u043b\u044f\u0446\u0446\u0430 \u045e\u0441\u0435 \u0430\u043d\u0451\u043b\u044b, \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0441\u0432\u043e\u0439\u0441\u043a\u0430\u044f \u0436\u044b\u0432\u0451\u043b\u0430 \u0456 \u0434\u0437\u0456\u043a\u0456\u044f \u0437\u0432\u044f\u0440\u044b; \u044f\u043d\u044b \u0437\u0433\u0456\u043d\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0435 \u043a\u0430\u043b\u0435\u043d\u0456 \u0456, \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0441\u0430 \u0441\u0432\u0430\u0456\u0445 \u0437\u0430\u0433\u043e\u043d\u0430\u045e \u0456 \u043d\u043e\u0440\u0430\u045e, \u043d\u0435 \u043f\u0430\u0433\u043b\u044f\u0434\u0430\u044e\u0446\u044c \u043c\u043e\u045e\u0447\u043a\u0456 \u045e \u043d\u0435\u0431\u0430, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u043e\u043b\u044f\u0446\u0446\u0430 \u043d\u0430 \u0441\u0432\u043e\u0439 \u043b\u0430\u0434. \u041d\u0430\u0432\u0430\u0442 \u043f\u0442\u0443\u0448\u043a\u0456, \u043f\u0440\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b\u0441\u044f, \u0443\u0437\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u045e \u043d\u0435\u0431\u0430 \u0456, \u0440\u0430\u0441\u043f\u0430\u0441\u0446\u0456\u0440\u0430\u044e\u0447\u044b \u043a\u0440\u044b\u043b\u044b, \u044f\u043a \u043a\u0440\u044b\u0436, \u043a\u0430\u0436\u0443\u0446\u044c \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0436 \u043c\u043e\u0436\u043d\u0430 \u044f\u0448\u0447\u044d \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u043c\u0430\u043b\u0456\u0442\u0432\u044b? \u041c\u0430\u043b\u0456\u045e\u0441\u044f \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c \u041f\u0430\u043d, \u042f\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0445\u0432\u0430\u043b\u0430 \u0456 \u043c\u043e\u0446 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 4, 23-24<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u0410\u0439\u0446\u0443 \u045e \u0414\u0443\u0445\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0442\u0430\u043a\u0456\u0445 \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0430\u045e \u0448\u0443\u043a\u0430\u0435 \u0441\u0430\u0431\u0435 \u0410\u0439\u0446\u0435\u0446. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0414\u0443\u0445\u0430\u043c, \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u0446\u0446\u0430 \u042f\u043c\u0443, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u045e \u0414\u0443\u0445\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0442\u0430\u043a\u0456\u0445 \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0430\u045e \u0448\u0443\u043a\u0430\u0435 \u0441\u0430\u0431\u0435 \u0410\u0439\u0446\u0435\u0446.<\/p>\r\n"}, {"GCH_CH_2_ID":"536","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0401\u0432\u0430&raquo; \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 13, 21-23: PL 75, 1028-1029)<\/span><br \/><span style=\"color: #ff0000;\">\u0422\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0401\u045e, \u0443\u0432\u0430\u0441\u0430\u0431\u043b\u0435\u043d\u043d\u0435 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u044f\u0433\u043e \u0446\u0435\u043b\u0430 \u0430\u0431\u043e \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u044f\u0433\u043e \u0413\u0430\u043b\u0430\u0432\u044b; \u0430 \u043a\u0430\u043b\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u043f\u0440\u0430 \u044f\u0433\u043e \u0447\u0430\u0441\u0442\u043a\u0456, \u0430\u0434\u0440\u0430\u0437\u0443 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430 \u0441\u043b\u043e\u045e \u0413\u0430\u043b\u0430\u0432\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0422\u0430\u043c\u0443 \u0447\u044b\u0442\u0430\u0435\u043c: &laquo;\u042f \u0446\u044f\u0440\u043f\u0435\u045e \u0433\u044d\u0442\u0430, \u0445\u043e\u0446\u044c \u043d\u0435 \u0431\u044b\u043b\u043e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u043d\u0430 \u0440\u0443\u0446\u044d \u043c\u0430\u0451\u0439, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0447\u044b\u0441\u0442\u044b\u043c\u0456 \u0431\u044b\u043b\u0456 \u043c\u0430\u0435 \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0434\u0430 \u0411\u043e\u0433\u0430&raquo; (\u043f\u0430\u0440. \u0401\u045e 16, 17).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0435\u0437 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u0440\u0443\u043a\u0430\u0445 \u043f\u0430\u043a\u0443\u0442\u0430\u0432\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u045e \u0456 \u045e \u043a\u0430\u0433\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u0443 \u043d\u0430 \u0432\u0443\u0441\u043d\u0430\u0445 \u042f\u0433\u043e\u043d\u044b\u0445, \u0430\u0434\u043d\u0430\u043a \u0441\u0446\u044f\u0440\u043f\u0435\u045e \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0441\u0435 \u043c\u0443\u043a\u0456 \u043a\u0440\u044b\u0436\u0430. \u0401\u043d \u0430\u0434\u0437\u0456\u043d \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0456\u043d\u0448\u044b\u043c\u0456 \u045e\u0437\u043d\u043e\u0441\u0456\u045e \u0434\u0430 \u0411\u043e\u0433\u0430 \u0447\u044b\u0441\u0442\u044b\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0456 \u045e \u0447\u0430\u0441 \u043c\u0443\u043a\u0456 \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0437\u0430 \u0441\u0432\u0430\u0456\u0445 \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u044f\u045e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041e\u0439\u0447\u0430, \u043f\u0440\u0430\u0431\u0430\u0447 \u0456\u043c, \u0431\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0440\u043e\u0431\u044f\u0446\u044c&raquo; (\u041b\u043a 23, 34).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u0448\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u0447\u044b\u0441\u0442\u0430\u0435 \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0446\u0456 \u043f\u0430\u0434\u0443\u043c\u0430\u0446\u044c \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0440\u0430 \u043f\u0440\u043e\u0441\u044c\u0431\u0443 \u0430\u0431 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u0447\u044b\u043d\u044f\u0435 \u043d\u0430\u043c \u0431\u043e\u043b\u044c? \u0422\u0430\u043c\u0443 \u043a\u0440\u043e\u045e \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b, \u044f\u043a\u0443\u044e \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u043b\u0456 \u0440\u0430\u0437&rsquo;\u044e\u0448\u0430\u043d\u044b\u044f \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0456, \u043f\u0430\u0441\u043b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0456\u0446\u044c \u0432\u0435\u0440\u043d\u0456\u043a\u0456 \u0456 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u044f\u043a \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u0433\u044d\u0442\u0443\u044e \u043a\u0440\u043e\u045e \u0434\u0430\u0440\u044d\u0447\u044b \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0417\u044f\u043c\u043b\u044f, \u043d\u0435 \u0445\u0430\u0432\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 \u043c\u0430\u0451\u0439 \u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430 \u0442\u0430\u0431\u0435 \u043c\u0435\u0441\u0446\u0430, \u0434\u0437\u0435 \u043c\u043e\u0433 \u0431\u044b \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u043a\u0440\u044b\u043a \u043c\u043e\u0439&raquo; (\u0401\u045e 16, 18). \u0413\u0440\u044d\u0448\u043d\u0430\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0422\u044b \u043f\u044b\u043b \u0456 \u045e \u043f\u044b\u043b \u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f&raquo; (\u043f\u0430\u0440. \u0411\u044b\u0446 3, 19).<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u044f\u043c\u043b\u044f \u043d\u0435 \u0445\u0430\u0432\u0430\u0435 \u043a\u0440\u044b\u0432\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043a\u043e\u0436\u043d\u044b \u0433\u0440\u044d\u0448\u043d\u0456\u043a, \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u044e\u0447\u044b \u0446\u0430\u043d\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f, \u0432\u044b\u0437\u043d\u0430\u0435 \u0456 \u0441\u043b\u0430\u0432\u0456\u0446\u044c \u044f\u0435, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0437 \u0443\u0441\u044f\u0435 \u0441\u0456\u043b\u044b \u0441\u0432\u0430\u0456\u043c \u0431\u043b\u0456\u0436\u043d\u0456\u043c.<br \/>\u0417\u044f\u043c\u043b\u044f \u043d\u0435 \u0445\u0430\u0432\u0430\u0435 \u043a\u0440\u044b\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0443\u0436\u043e \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0432\u0430 \u045e\u0441\u0456\u0445 \u0447\u0430\u0441\u0442\u043a\u0430\u0445 \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0440\u044d\u0431\u0430 \u0437\u0432\u044f\u0440\u043d\u0443\u0446\u044c \u0443\u0432\u0430\u0433\u0443 \u043d\u0430 \u0441\u043b\u043e\u0432\u044b: &laquo;\u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430 \u0442\u0430\u0431\u0435 \u043c\u0435\u0441\u0446\u0430, \u0434\u0437\u0435 \u043c\u043e\u0433 \u0431\u044b \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u043c\u043e\u0439 \u043a\u0440\u044b\u043a&raquo;. \u0421\u0430\u043c\u0430 \u043a\u0440\u043e\u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u044f\u043a\u0443\u044e \u043c\u044b \u043f&rsquo;\u0451\u043c, &ndash; \u0433\u044d\u0442\u0430 \u043a\u0440\u044b\u043a \u043d\u0430\u0448\u0430\u0433\u0430 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f. \u0422\u0430\u043c\u0443 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430: &laquo;\u0412\u044b \u0436 \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u0434\u0430 \u0430\u043a\u0440\u0430\u043f\u043b\u0435\u043d\u043d\u044f \u043a\u0440\u044b\u0432\u0451\u044e, \u044f\u043a\u0430\u044f \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u043c\u0430\u0446\u043d\u0435\u0439, \u0447\u044b\u043c \u043a\u0440\u043e\u045e \u0410\u0431\u044d\u043b\u044f&raquo; (\u0413\u0431\u0440 12, 24). \u0410 \u043f\u0440\u0430 \u043a\u0440\u043e\u045e \u0410\u0431\u044d\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0413\u043e\u043b\u0430\u0441 \u043a\u0440\u044b\u0432\u0456 \u0442\u0432\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0442\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435 \u0437 \u0437\u044f\u043c\u043b\u0456&raquo; (\u0411\u044b\u0446 4, 10).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u043a\u0440\u043e\u045e \u0415\u0437\u0443\u0441\u0430 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u043c\u0430\u0446\u043d\u0435\u0439, \u0447\u044b\u043c \u043a\u0440\u043e\u045e \u0410\u0431\u044d\u043b\u044f, \u0431\u043e \u043a\u0440\u043e\u045e \u0410\u0431\u044d\u043b\u044f \u0434\u0430\u043c\u0430\u0433\u0430\u043b\u0430\u0441\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u0431\u0440\u0430\u0442\u0430\u0437\u0430\u0431\u043e\u0439\u0446\u044b, \u0430 \u043a\u0440\u043e\u045e \u041f\u0430\u043d\u0430 \u0432\u044b\u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u0436\u044b\u0446\u0446\u0451 \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u044f\u043c. \u0422\u0430\u043c\u0443, \u043a\u0430\u0431 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u043c\u0443\u043a\u0456 \u041f\u0430\u043d\u0430 \u043d\u0435 \u0431\u044b\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0435\u0440\u0430\u0439\u043c\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435\u043c, \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0456\u043d\u0448\u044b\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435\u043c \u0441\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0440\u044b\u043a \u0425\u0440\u044b\u0441\u0442\u0430 \u043c\u0430\u0435 \u0434\u0437\u0435 \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u043d\u0430\u0448 \u044f\u0437\u044b\u043a \u043c\u0430\u045e\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0442\u043e\u0435, \u0443 \u0448\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0430 \u043d\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430. \u0410\u043b\u0435, \u043a\u0430\u0431 \u042f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0441 \u043d\u0435 \u0431\u044b\u045e \u043f\u0440\u044b\u0433\u043b\u0443\u0448\u0430\u043d\u044b \u045e \u043d\u0430\u0441, \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u043f\u0430-\u0441\u0432\u043e\u0439\u043c\u0443 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0431\u043b\u0456\u0436\u043d\u044f\u043c\u0443 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u045e\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0411\u044b\u0446 4, 10. 11; \u0413\u0431\u0440 12, 24<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u043a\u0440\u043e\u045e \u0421\u044b\u043d\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0431\u0440\u0430\u0442\u0430 \u0437 \u0437\u044f\u043c\u043b\u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435 \u0434\u0430 \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0437\u044f\u043c\u043b\u044f, \u044f\u043a\u0430\u044f \u043d\u0430\u0441\u044b\u0446\u0456\u043b\u0430\u0441\u044f \u043a\u0440\u044b\u0432\u0451\u0439 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u043a\u0440\u0430\u043f\u043b\u0435\u043d\u043d\u0435 \u042f\u0433\u043e\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u043c\u0430\u0446\u043d\u0435\u0439, \u0447\u044b\u043c \u043a\u0440\u043e\u045e \u0410\u0431\u044d\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0437\u044f\u043c\u043b\u044f, \u044f\u043a\u0430\u044f \u043d\u0430\u0441\u044b\u0446\u0456\u043b\u0430\u0441\u044f \u043a\u0440\u044b\u0432\u0451\u0439 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"537","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0437\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 14, De pauperum amore, 38. 40: PG 35, 907. 910)<\/span><br \/><span style=\"color: #ff0000;\">\u041c\u044b \u0441\u043b\u0443\u0436\u044b\u043c \u0425\u0440\u044b\u0441\u0442\u0443 \u0432\u0430 \u045e\u0431\u043e\u0433\u0456\u0445<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u044f, \u0431\u043e \u044f\u043d\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c&raquo; (\u041c\u0446 5, 7). \u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u0430\u043f\u043e\u0448\u043d\u044f\u044f \u0441\u044f\u0440\u043e\u0434 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u045e. \u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0447\u044b\u0442\u0430\u0435\u043c: &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b, \u0445\u0442\u043e \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u0430\u0431 \u0431\u0435\u0434\u043d\u044b\u043c \u0456 \u045e\u0431\u043e\u0433\u0456\u043c&raquo; (\u043f\u0430\u0440. \u041f\u0441 41 [40], 2). \u0406 \u044f\u0448\u0447\u044d: &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0456 \u043f\u0430\u0437\u044b\u0447\u0430\u0435&raquo; (\u041f\u0441 112 [111], 5). \u041d\u0430\u0440\u044d\u0448\u0446\u0435: &laquo;\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0446\u044d\u043b\u044b \u0434\u0437\u0435\u043d\u044c \u043b\u0456\u0442\u0443\u0435\u0446\u0446\u0430 \u0456 \u0434\u0430\u0435 \u045e \u043f\u0430\u0437\u044b\u043a\u0443&raquo; (\u043f\u0430\u0440. \u041f\u0441 37 [36], 26). \u0412\u043e\u0437\u044c\u043c\u0435\u043c \u0436\u0430 \u0433\u044d\u0442\u0430\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u0441 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u044c \u0441\u043f\u0430\u0433\u0430\u0434\u043b\u0456\u0432\u044b\u043c\u0456, \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u044b\u0447\u043b\u0456\u0432\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0432\u0430\u0442 \u043d\u043e\u0447 \u043d\u0435 \u043f\u0435\u0440\u0430\u043f\u044b\u043d\u044f\u0435 \u0442\u0432\u0430\u0456\u0445 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e! \u041d\u0435 \u043a\u0430\u0436\u044b: &laquo;\u0406\u0434\u0437\u0456, \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u0448 \u0437\u0430\u045e\u0442\u0440\u0430, \u0456 \u044f \u0434\u0430\u043c \u0442\u0430\u0431\u0435&raquo;. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0448\u0442\u043e \u043d\u0435 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043f\u0430\u043c\u0456\u0436 \u0442\u0432\u0430\u0456\u043c \u043d\u0430\u043c\u0435\u0440\u0430\u043c \u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u043c. \u0411\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430 \u043d\u0435 \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u043c\u0430\u0440\u0443\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u043b\u0456\u0441\u044f \u0437 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u043c \u0441\u0432\u0430\u0456\u043c \u0445\u043b\u0435\u0431\u0430\u043c, \u0430 \u045e\u0431\u043e\u0433\u0456\u0445 \u0456 \u0431\u044f\u0437\u0434\u043e\u043c\u043d\u044b\u0445 \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u044c \u0443 \u0441\u0432\u043e\u0439 \u0434\u043e\u043c (\u043f\u0430\u0440. \u0406\u0441 58, 7). \u0420\u0430\u0431\u0456 \u0433\u044d\u0442\u0430 \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u0456 \u0430\u0445\u0432\u043e\u0442\u043d\u0430. \u0421\u0432. \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430: &laquo;\u0425\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u045e\u0447\u044b\u043d\u043a\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u043d\u044f\u0445\u0430\u0439 \u0440\u043e\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e&raquo; (\u043f\u0430\u0440. \u0420\u044b\u043c 12, 8). \u0422\u0432\u043e\u0439 \u0434\u043e\u0431\u0440\u044b \u045e\u0447\u044b\u043d\u0430\u043a \u0431\u0443\u0434\u0437\u0435 \u045e\u0434\u0432\u0430\u044f \u043b\u0435\u043f\u0448\u044b, \u043a\u0430\u043b\u0456 \u0437\u0440\u043e\u0431\u0456\u0448 \u044f\u0433\u043e \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0456 \u0445\u0443\u0442\u043a\u0430. \u0410 \u0442\u043e\u0435, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u0448 \u0441\u0430 \u0441\u043c\u0443\u0442\u043a\u0430\u043c \u0456 \u0437 \u043f\u0440\u044b\u043c\u0443\u0441\u0443, &ndash; \u043d\u0435\u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435 \u0456 \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0440\u044d\u0431\u0430 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430, \u0430 \u043d\u0435 \u0441\u043c\u0443\u0442\u043a\u0430\u0432\u0430\u0446\u044c, \u043a\u0430\u043b\u0456 \u043c\u044b \u0440\u043e\u0431\u0456\u043c \u0434\u0430\u0431\u0440\u043e. &laquo;\u041a\u0430\u043b\u0456 \u0442\u044b \u043f\u0440\u044b\u0431\u044f\u0440\u044d\u0448 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b \u0456 \u043f\u0435\u0440\u0430\u0441\u0443\u0434\u044b, &ndash; \u043a\u0430\u0436\u0430 \u0406\u0441\u0430\u044f, &ndash; \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0445\u0446\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u0434\u0430\u0437\u0440\u043e\u043d\u0430\u0441\u0446\u044c, \u0432\u0430\u0433\u0430\u043d\u043d\u0456 \u0456 \u043d\u0430\u0440\u0430\u043a\u0430\u043d\u043d\u0456, \u0448\u0442\u043e \u0442\u0430\u0434\u044b \u0430\u0434\u0431\u0443\u0434\u0437\u0435\u0446\u0446\u0430?&raquo; \u0412\u044f\u043b\u0456\u043a\u0430\u044f \u0456 \u0432\u0430\u0440\u0442\u0430\u044f \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0441\u043f\u0440\u0430\u0432\u0430! \u042f\u043a\u0430\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0437\u0430 \u0433\u044d\u0442\u0430! &laquo;\u0422\u0430\u0434\u044b \u0437\u0430\u0437\u0437\u044f\u0435, \u044f\u043a \u0437\u043e\u043b\u0430\u043a, \u0441\u0432\u044f\u0442\u043b\u043e \u0442\u0432\u0430\u0451, \u0456 \u0445\u0443\u0442\u043a\u0430 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0442\u0432\u0430\u0451 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u0435&raquo; (\u0406\u0441 58, 8). \u0425\u0442\u043e \u0436 \u043d\u0435 \u0447\u0430\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u0430 \u0456 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u044f?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u043d\u0430 \u0432\u0430\u0448\u0443 \u0434\u0443\u043c\u043a\u0443, \u0441\u043b\u0443\u0433\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b, \u0431\u0440\u0430\u0442\u044b \u0456 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b, \u043c\u044f\u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0445\u043e\u0446\u044c \u043a\u0440\u044b\u0445\u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0446\u044c, \u0442\u0430\u0434\u044b \u0431\u0443\u0434\u0437\u0435\u043c, \u043f\u0430\u043a\u0443\u043b\u044c \u043c\u043e\u0436\u043d\u0430, \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u043f\u0435\u043a\u0430\u0432\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0440\u043c\u0456\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u044b\u0442\u0443\u043b\u044f\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430. \u0423\u0448\u0430\u043d\u0443\u0435\u043c \u042f\u0433\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u0430\u0441\u0446\u0456\u043d\u043d\u0430\u0441\u0446\u044e, \u044f\u043a \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f, \u0446\u0456 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435\u043c, \u044f\u043a \u041c\u0430\u0440\u044b\u044f, \u043d\u0435 \u043c\u0430\u0433\u0456\u043b\u0430\u0439, \u044f\u043a \u042e\u0437\u0430\u0444 \u0437 \u0410\u0440\u044b\u043c\u0430\u0442\u044d\u0456, \u0456 \u043d\u0435 \u0442\u044b\u043c, \u0448\u0442\u043e \u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u0437 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435\u043c, \u044f\u043a \u0442\u043e\u0439 \u041d\u0456\u043a\u0430\u0434\u044d\u043c, \u044f\u043a\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u043f\u0430\u043b\u043e\u0432\u0443 \u043b\u044e\u0431\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0456, \u0443\u0440\u044d\u0448\u0446\u0435, \u0437\u043e\u043b\u0430\u0442\u0430\u043c, \u043a\u0430\u0434\u0437\u0456\u043b\u0430\u043c \u0456 \u043c\u0456\u0440\u0430\u043c, \u044f\u043a \u0433\u044d\u0442\u0430 \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u043c\u0443\u0434\u0440\u0430\u0446\u044b \u0434\u0430 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043c\u044b \u0437\u0433\u0430\u0434\u0430\u043b\u0456, \u0431\u043e \u041f\u0430\u043d \u0441\u0443\u0441\u0432\u0435\u0442\u0443 \u0445\u043e\u0447\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u0430 \u043d\u0435 \u0430\u0445\u0432\u044f\u0440\u044b, \u0431\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043a\u0430\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0442\u043b\u0443\u0441\u0442\u044b\u0445 \u044f\u0433\u043d\u044f\u0442. \u0422\u0430\u043a\u0443\u044e \u0446\u0443\u0434\u043e\u045e\u043d\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u043f\u0440\u0430\u044f\u0432\u0456\u043c \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0432\u0430 \u045e\u0431\u043e\u0433\u0456\u0445, \u044f\u043a\u0456\u044f \u0441\u0451\u043d\u043d\u044f \u043b\u044f\u0436\u0430\u0446\u044c \u0440\u0430\u0441\u043f\u043b\u0430\u0441\u0442\u0430\u043d\u044b\u043c\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b, \u043a\u0430\u043b\u0456 \u043c\u044b \u0441\u044b\u0434\u0437\u0435\u043c \u0430\u0434\u0441\u044e\u043b\u044c, \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043d\u0430\u0441 \u0443 \u0432\u0435\u0447\u043d\u044b\u044f \u0448\u0430\u0442\u0440\u044b \u045e \u0441\u0430\u043c\u0456\u043c \u0425\u0440\u044b\u0441\u0446\u0435, \u043d\u0430\u0448\u044b\u043c \u041f\u0430\u043d\u0443, \u044f\u043a\u043e\u043c\u0443 \u043d\u0430\u0432\u0435\u043a\u0456 \u0445\u0432\u0430\u043b\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 25, 35. 40; \u042f\u043d 15, 12<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0431\u044b\u045e \u0433\u0430\u043b\u043e\u0434\u043d\u044b, \u0456 \u0432\u044b \u0434\u0430\u043b\u0456 \u041c\u043d\u0435 \u0435\u0441\u0446\u0456; \u043f\u0440\u0430\u0433\u043d\u0443\u045e, \u0456 \u0432\u044b \u043d\u0430\u043f\u0430\u0456\u043b\u0456 \u041c\u044f\u043d\u0435; \u0431\u044b\u045e \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u044b\u043c, \u0456 \u0432\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u041c\u044f\u043d\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043a\u0430\u0436\u0443 \u0432\u0430\u043c: \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0430\u0434\u043d\u0430\u043c\u0443 \u0437 \u0433\u044d\u0442\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u041c\u0430\u0456\u0445 \u043c\u0435\u043d\u0448\u044b\u0445, \u0432\u044b \u041c\u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0441\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u041c\u0430\u044f, \u043a\u0430\u0431 \u0432\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043a\u0430\u0436\u0443 \u0432\u0430\u043c: \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0430\u0434\u043d\u0430\u043c\u0443 \u0437 \u0433\u044d\u0442\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u041c\u0430\u0456\u0445 \u043c\u0435\u043d\u0448\u044b\u0445, \u0432\u044b \u041c\u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"541","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 34, 8-9: CCL 36, 315-316)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0448\u043b\u044f\u0445 \u0434\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u0436\u044b\u0446\u0446\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0441\u0446\u0456\u0441\u043b\u0430 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f &ndash; \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0442\u0443. \u0425\u0442\u043e \u0456\u0434\u0437\u0435 \u0437\u0430 \u041c\u043d\u043e\u044e, \u0442\u043e\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0446\u0435\u043c\u0440\u044b, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u0436\u044b\u0446\u0446\u044f&raquo; (\u042f\u043d 8, 12). \u0410\u0434\u043d\u043e \u045e \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u043a\u0430\u0437\u0430\u043c, \u0434\u0440\u0443\u0433\u043e\u0435 &ndash; \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435\u043c. \u0414\u044b\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u0436\u0430\u0434\u0430\u043b\u0456 \u0431\u0435\u0441\u0441\u0430\u0440\u043e\u043c\u043d\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0430\u0431\u044f\u0446\u0430\u045e, \u0456 \u043a\u0430\u0431 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u043c \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u0441\u0443\u0434\u0437\u0435: &laquo;\u0426\u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0442\u044b \u0442\u043e\u0435, \u0448\u0442\u043e \u042f \u0437\u0430\u0433\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u0447\u0430\u043a\u0430\u0446\u044c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u042f \u0430\u0431\u044f\u0446\u0430\u045e?&raquo; \u0428\u0442\u043e \u0436 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d, \u043d\u0430\u0448 \u0411\u043e\u0436\u0430? \u0401\u043d \u043a\u0430\u0436\u0430 \u0442\u0430\u0431\u0435: &laquo;\u0406\u0434\u0437\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e&raquo;. \u0422\u044b \u043f\u0440\u0430\u0441\u0456\u045e \u043f\u0430\u0440\u0430\u0434\u044b \u043d\u0430\u043a\u043e\u043d\u0442 \u0436\u044b\u0446\u0446\u044f? \u042f\u043a\u043e\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a \u043d\u0435 \u0442\u0430\u0433\u043e, \u043f\u0440\u0430 \u044f\u043a\u043e\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0423 \u0422\u0430\u0431\u0435 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f&raquo; (\u041f\u0441 36 [35], 10).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0430\u0434\u0440\u0430\u0437\u0443 \u0432\u043e\u0437\u044c\u043c\u0435\u043c\u0441\u044f \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u0443 \u0456 \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0437\u0430 \u041f\u0430\u043d\u0430\u043c, \u0440\u0430\u0437\u0430\u0440\u0432\u0435\u043c \u043a\u0430\u0439\u0434\u0430\u043d\u044b, \u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u044e\u0446\u044c \u043d\u0430\u043c \u0456\u0441\u0446\u0456 \u0437\u0430 \u0406\u043c. \u0410 \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u0446\u044c \u0432\u0443\u0437\u043b\u044b \u0433\u044d\u0442\u044b\u0445 \u043f\u0443\u0442\u0430\u045e \u043c\u043e\u0436\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0442\u0430\u0433\u043e, \u043a\u0430\u043c\u0443 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0422\u044b \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u045e \u043c\u0430\u0435 \u043a\u0430\u0439\u0434\u0430\u043d\u044b&raquo; (\u041f\u0441 116 [115], 16). \u041f\u0440\u0430 \u042f\u0433\u043e \u043a\u0430\u0436\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b \u043f\u0441\u0430\u043b\u044c\u043c: &laquo;\u041f\u0430\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435 \u0432\u044f\u0437\u043d\u044f\u045e, \u041f\u0430\u043d \u0443\u0437\u043d\u0456\u043c\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u044b\u0445&raquo; (\u043f\u0430\u0440. \u041f\u0441 146 [145], 7. 8).<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430 \u0447\u044b\u043c \u0436\u0430 \u0456\u0434\u0443\u0446\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b\u044f \u0456 \u045e\u0437\u043d\u044f\u0442\u044b\u044f, \u044f\u043a \u043d\u0435 \u0437\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0430\u0434 \u044f\u043a\u043e\u0433\u043e \u043f\u0430\u0447\u0443\u043b\u0456: &laquo;\u042f &ndash; \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0442\u0443. \u0425\u0442\u043e \u0456\u0434\u0437\u0435 \u0437\u0430 \u041c\u043d\u043e\u044e, \u0442\u043e\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0446\u0435\u043c\u0440\u044b, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u0436\u044b\u0446\u0446\u044f&raquo; (\u042f\u043d 8, 12). \u0422\u0430\u043a, \u041f\u0430\u043d \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0441\u043b\u044f\u043f\u044b\u0445, \u0442\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u043c \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u0446\u044c \u043d\u0430\u0441, \u043c\u0430\u044e\u0447\u044b\u0445 \u0432\u0435\u0440\u0443 \u044f\u043a \u043c\u0430\u0437\u044c \u0434\u043b\u044f \u0432\u0430\u0447\u044d\u0439. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0415\u0437\u0443\u0441 \u0437\u043c\u044f\u0448\u0430\u045e \u0441\u0432\u0430\u044e \u0441\u043b\u0456\u043d\u0443 \u0437 \u0437\u044f\u043c\u043b\u0451\u044e, \u0430 \u043f\u043e\u0442\u044b\u043c \u043f\u0430\u043c\u0430\u0437\u0430\u045e \u0451\u044e \u0432\u043e\u0447\u044b \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u0430\u0433\u0430 \u0430\u0434 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f. \u041c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456\u0441\u044f \u0437 \u0410\u0434\u0430\u043c\u0430 \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u044b\u043c\u0456 \u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u043c \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430. \u0401\u043d \u0437\u043c\u044f\u0448\u0430\u045e \u0441\u043b\u0456\u043d\u0443 \u0437 \u0437\u044f\u043c\u043b\u0451\u044e: &laquo;\u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u043c\u0456&raquo; (\u042f\u043d 1, 14). \u0401\u043d \u0437\u043c\u044f\u0448\u0430\u045e \u0441\u043b\u0456\u043d\u0443 \u0437 \u0437\u044f\u043c\u043b\u0451\u044e, \u0442\u0430\u043c\u0443 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0412\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0432\u044b\u0440\u0430\u0441\u0446\u0435 \u0437 \u0437\u044f\u043c\u043b\u0456&raquo; (\u041f\u0441 85 [84], 12), \u0430 \u0441\u0430\u043c \u0401\u043d \u043a\u0430\u0436\u0430: &laquo;\u042f &ndash; \u0434\u0430\u0440\u043e\u0433\u0430, \u0456 \u043f\u0440\u0430\u045e\u0434\u0430, \u0456 \u0436\u044b\u0446\u0446\u0451&raquo; (\u042f\u043d 14, 6).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0434\u043e\u0441\u0442\u0430\u043b\u044c \u043d\u0430\u0441\u044b\u0447\u0430\u0446\u0446\u0430 \u043f\u0440\u0430\u045e\u0434\u0430\u044e, \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u043c \u044f\u0435 \u0442\u0432\u0430\u0440\u0430\u043c \u0443 \u0442\u0432\u0430\u0440, \u0431\u043e \u0456 \u0433\u044d\u0442\u0430 \u043d\u0430\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u0430. \u0425\u0442\u043e \u0430\u0434\u0432\u0430\u0436\u044b\u0446\u0446\u0430 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0411\u043e\u0433 \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0431\u044b \u0430\u0431\u044f\u0446\u0430\u0446\u044c \u0446\u0456 \u0434\u0430\u0446\u044c?<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0431\u0430\u0447\u044b\u043c \u0442\u0432\u0430\u0440\u0430\u043c \u0443 \u0442\u0432\u0430\u0440. \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: &laquo;\u0426\u044f\u043f\u0435\u0440 \u0431\u0430\u0447\u0443 \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u0440\u0430\u0437 \u0448\u043a\u043b\u043e, \u0446\u044c\u043c\u044f\u043d\u0430, \u0430 \u0442\u0430\u0434\u044b &ndash; \u0442\u0432\u0430\u0440\u0430\u043c \u0443 \u0442\u0432\u0430\u0440&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 13, 12). \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u042f\u043d \u043f\u0456\u0448\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0456: &laquo;\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0446\u044f\u043f\u0435\u0440 \u043c\u044b \u0434\u0437\u0435\u0446\u0456 \u0411\u043e\u0436\u044b\u044f, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u043d\u0435 \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f, \u0447\u044b\u043c \u0431\u0443\u0434\u0437\u0435\u043c. \u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0401\u043d \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430, \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u043c \u042f\u0433\u043e \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c&raquo; (1 \u042f\u043d 3, 2). \u0413\u044d\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043b\u044e\u0431\u0456\u0448, \u0456\u0434\u0437\u0456. \u0422\u044b \u0441\u043a\u0430\u0436\u0430\u0448: &laquo;\u041b\u044e\u0431\u043b\u044e, \u0430\u043b\u0435 \u043a\u0443\u0434\u044b \u0456\u0441\u0446\u0456?&raquo; \u041a\u0430\u043b\u0456 \u0431 \u041f\u0430\u043d \u0411\u043e\u0433 \u0442\u0432\u043e\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u0431\u0435: &laquo;\u042f &ndash; \u043f\u0440\u0430\u045e\u0434\u0430 \u0456 \u0436\u044b\u0446\u0446\u0451&raquo;, \u0442\u043e, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u0447\u044b \u0436\u044b\u0446\u0446\u044f, \u0442\u044b \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0448\u0443\u043a\u0430\u045e \u0431\u044b \u0448\u043b\u044f\u0445\u0443 \u0434\u0430 \u0456\u0445 \u0456 \u043a\u0430\u0437\u0430\u045e \u0431\u044b \u0441\u0430\u0431\u0435: &laquo;\u041f\u0440\u0430\u045e\u0434\u0430 &ndash; \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430, \u0436\u044b\u0446\u0446\u0451 &ndash; \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u0430\u0433\u043b\u0430 \u0434\u0430\u0431\u0440\u0430\u0446\u0446\u0430 \u0434\u0430 \u0456\u0445 \u043c\u0430\u044f \u0434\u0443\u0448\u0430!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0443\u043a\u0430\u0435\u0448 \u0434\u0430\u0440\u043e\u0433\u0456? \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043a\u0430\u0436\u0430: &laquo;\u042f &ndash; \u0434\u0430\u0440\u043e\u0433\u0430&raquo;. \u041f\u0435\u0440\u0448 \u0447\u044b\u043c \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u0431\u0435, \u043a\u0443\u0434\u044b \u0456\u0441\u0446\u0456, \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e, \u044f\u043a\u0456\u043c \u0448\u043b\u044f\u0445\u0430\u043c: &laquo;\u042f &ndash; \u0434\u0430\u0440\u043e\u0433\u0430&raquo;. \u0414\u0430\u0440\u043e\u0433\u0430 \u043a\u0443\u0434\u044b? \u0414\u0430 \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u0436\u044b\u0446\u0446\u044f. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u043a\u0430\u0437\u0430\u045e, \u044f\u043a \u0456\u0441\u0446\u0456, \u043f\u043e\u0442\u044b\u043c &ndash; \u043d\u0430\u0432\u043e\u0448\u0442\u0430. &laquo;\u042f &ndash; \u0434\u0430\u0440\u043e\u0433\u0430, \u042f &ndash; \u043f\u0440\u0430\u045e\u0434\u0430, \u042f &ndash; \u0436\u044b\u0446\u0446\u0451&raquo;. \u0417\u0430\u0441\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u045e \u0410\u0439\u0446\u0430, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0451\u0441\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0430\u0439 \u0456 \u0436\u044b\u0446\u0446\u0451\u043c. \u0410\u043f\u0440\u0430\u043d\u0430\u044e\u0447\u044b\u0441\u044f \u045e \u0446\u0435\u043b\u0430, \u0401\u043d \u0441\u0442\u0430\u045e \u0434\u0430\u0440\u043e\u0433\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0431\u044b\u043b\u043e \u0442\u0430\u0431\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0428\u0443\u043a\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0456, \u043a\u0430\u0431 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u0436\u044b\u0446\u0446\u044f&raquo;. \u041d\u0435 \u0431\u044b\u043b\u043e \u0442\u0430\u0431\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0423\u0441\u0442\u0430\u043d\u044c, \u0433\u0443\u043b\u044c\u0442\u0430\u0439&raquo;. \u0414\u0430\u0440\u043e\u0433\u0430 \u0441\u0430\u043c\u0430 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0434\u0430 \u0446\u044f\u0431\u0435 \u0456 \u0430\u0431\u0443\u0434\u0437\u0456\u043b\u0430 \u0446\u044f\u0431\u0435 \u0430\u0434 \u0441\u043d\u0443, \u043a\u0430\u043b\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0430\u0431\u0443\u0434\u0437\u0456\u043b\u0430. \u0423\u0441\u0442\u0430\u043d\u044c \u0456 \u0456\u0434\u0437\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0433\u0447\u044b\u043c\u0430, \u0442\u044b \u0441\u043f\u0440\u0430\u0431\u0443\u0435\u0448 \u043d\u0430\u0432\u0430\u0442 \u0445\u0430\u0434\u0437\u0456\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u043c\u043e\u0436\u0430\u0448, \u0431\u043e \u0442\u0430\u0431\u0435 \u0431\u0430\u043b\u044f\u0446\u044c \u043d\u043e\u0433\u0456. \u0427\u0430\u043c\u0443 \u0431\u0430\u043b\u044f\u0446\u044c \u043d\u043e\u0433\u0456? \u041c\u043e\u0436\u0430, \u043f\u0430\u0434\u0443\u043b\u0430\u0434\u043d\u044b\u044f \u0445\u0446\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043d\u044b \u0431\u0435\u0433\u043b\u0456 \u043f\u0440\u0430\u0437 \u0446\u0435\u0440\u043d\u0456? \u0410\u043b\u0435 \u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0430\u0437\u0434\u0430\u0440\u0430\u0432\u0456\u043b\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u044b\u0445. \u0421\u043a\u0430\u0436\u0430\u0448: &laquo;\u0412\u043e\u0441\u044c, \u043c\u0430\u0435 \u043d\u043e\u0433\u0456 \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u044f, \u0430\u043b\u0435 \u044f \u043d\u0435 \u0431\u0430\u0447\u0443 \u0441\u0430\u043c\u043e\u0439 \u0434\u0430\u0440\u043e\u0433\u0456&raquo;. \u0410\u043b\u0435 \u0415\u0437\u0443\u0441 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u0456 \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 119 (118), 104b.105; \u042f\u043d 6, 68<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u045e \u0443\u0441\u044f\u043a\u0456 \u0448\u043b\u044f\u0445 \u0456\u043b\u0436\u044b\u0432\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0432\u0430\u0451 \u0441\u043b\u043e\u0432\u0430 &ndash; \u0441\u0432\u0435\u0442\u0430\u0447 \u0434\u043b\u044f \u043c\u0430\u0451\u0439 \u043d\u0430\u0433\u0456 \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u043d\u0430 \u043c\u0430\u0451\u0439 \u0441\u0446\u0435\u0436\u0446\u044b. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d\u0435, \u0434\u0430 \u043a\u0430\u0433\u043e \u043c\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u043c? \u0422\u044b \u043c\u0430\u0435\u0448 \u0441\u043b\u043e\u0432\u044b \u0436\u044b\u0446\u0446\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0432\u0430\u0451 \u0441\u043b\u043e\u0432\u0430 &ndash; \u0441\u0432\u0435\u0442\u0430\u0447 \u0434\u043b\u044f \u043c\u0430\u0451\u0439 \u043d\u0430\u0433\u0456 \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u043d\u0430 \u043c\u0430\u0451\u0439 \u0441\u0446\u0435\u0436\u0446\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"542","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u041b\u0435\u0432\u0456\u0442\u0430&raquo; \u0410\u0440\u044b\u0433\u0435\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 9, 5. 10: PG 12, 515. 523)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u043d\u0430\u0448 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440 \u0456 \u043d\u0430\u0448\u0430 \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0437\u0456\u043d \u0440\u0430\u0437 \u0443 \u0433\u043e\u0434 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440, \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u043d\u0430\u0440\u043e\u0434, \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0443 \u0442\u043e\u0435 \u043c\u0435\u0441\u0446\u0430, \u0434\u0437\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0432\u0435\u043a\u0430 \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f, \u0430 \u043d\u0430\u0434 \u0456\u043c &ndash; \u0445\u0435\u0440\u0443\u0431\u0456\u043c\u044b; \u0434\u0437\u0435 \u0431\u044b\u045e \u043a\u0430\u045e\u0447\u044d\u0433 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u0456 \u0430\u043b\u0442\u0430\u0440 \u043a\u0430\u0434\u0436\u044d\u043d\u043d\u044f, \u043a\u0443\u0434\u044b \u043d\u0435\u043b\u044c\u0433\u0430 \u0431\u044b\u043b\u043e \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0456\u043a\u043e\u043c\u0443, \u0430\u043a\u0440\u0430\u043c\u044f \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043f\u0430\u0434\u0443\u043c\u0430\u044e \u043f\u0440\u0430 \u043c\u0430\u0439\u0433\u043e \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0430 &ndash; \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0446\u0435\u043b\u0430, \u0431\u044b\u045e \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0446\u044d\u043b\u044b \u0433\u043e\u0434, \u0442\u043e\u0439 \u0433\u043e\u0434, \u043f\u0440\u0430 \u044f\u043a\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u043d \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u043c\u044f\u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443 \u045e\u0431\u043e\u0433\u0456\u043c, \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u0446\u044c \u0433\u043e\u0434 \u043b\u0430\u0441\u043a\u0456 \u041f\u0430\u043d\u0430 \u0456 \u0434\u0437\u0435\u043d\u044c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u044f&raquo; (\u043f\u0430\u0440. \u041b\u043a 4, 18-19), \u0431\u0430\u0447\u0443, \u044f\u043a \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437 \u0443 \u0433\u044d\u0442\u044b \u0433\u043e\u0434, \u0443 \u0434\u0437\u0435\u043d\u044c \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f, \u0401\u043d \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e\u0448\u044b \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435, \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e \u043d\u0435\u0431\u0430 \u0456 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0410\u0439\u0446\u0430, \u043a\u0430\u0431 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u044b\u043c \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u0456 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u042f\u0433\u043e \u0437\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u045e \u042f\u0433\u043e \u0432\u0435\u0440\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b \u042f\u043d, \u0432\u0435\u0434\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u0442\u043e\u0435 \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435, \u0430\u0431 \u044f\u043a\u0456\u043c \u0415\u0437\u0443\u0441 \u043f\u0440\u0430\u0441\u0456\u045e \u0410\u0439\u0446\u0430, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0414\u0437\u0435\u0446\u0456 \u043c\u0430\u0435, \u0433\u044d\u0442\u0430 \u043f\u0456\u0448\u0443 \u0432\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u043b\u0456. \u041a\u0430\u043b\u0456 \u0436 \u0445\u0442\u043e \u0437\u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u0442\u043e \u043c\u044b \u043c\u0430\u0435\u043c \u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430 \u043f\u0435\u0440\u0430\u0434 \u0410\u0439\u0446\u043e\u043c, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430. \u0401\u043d \u0451\u0441\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456, \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430 \u043d\u0430\u0448\u044b\u044f, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443&raquo; (1 \u042f\u043d 2, 1-2).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0456 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0437\u0433\u0430\u0434\u0432\u0430\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435, \u043a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430: &laquo;\u042f\u0433\u043e \u0411\u043e\u0433 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0443 \u043c\u043e\u0446\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443&raquo; (\u043f\u0430\u0440. \u0420\u044b\u043c 3, 25). \u0422\u0430\u043c\u0443 &laquo;\u0434\u0437\u0435\u043d\u044c \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f&raquo; \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u0434\u0430 \u0441\u0430\u043c\u0430\u0433\u0430 \u043a\u0430\u043d\u0446\u0430 \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u043a\u0430\u0436\u0430: &laquo;\u0410\u0430\u0440\u043e\u043d \u043d\u0430\u0441\u044b\u043f\u0435 \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u043d\u0430 \u0430\u0433\u043e\u043d\u044c \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430, \u0456 \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u0430\u0434 \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u043f\u0430\u043a\u0440\u044b\u0435 \u0432\u0435\u043a\u0430 \u043d\u0430\u0434 \u043a\u0430\u045e\u0447\u044d\u0433\u0430\u043c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f, \u043a\u0430\u0431 \u044f\u043c\u0443 \u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456. \u0406 \u0432\u043e\u0437\u044c\u043c\u0435 \u043a\u0440\u043e\u045e \u0446\u044f\u043b\u044c\u0446\u0430, \u0456 \u043f\u0430\u043a\u0440\u0430\u043f\u0456\u0446\u044c \u043f\u0430\u043b\u044c\u0446\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0441\u043f\u0435\u0440\u0430\u0434\u0443 \u043d\u0430\u0434 \u0432\u0435\u043a\u0430\u043c \u0437 \u0443\u0441\u0445\u043e\u0434\u0443&raquo; (\u043f\u0430\u0440. \u041b\u0435\u0432 16, 12-14).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0443 \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u0430\u0441\u0446\u0456 \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u043b\u0430\u0441\u044f \u0411\u043e\u0436\u0430\u0435 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435 \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439. \u0410\u043b\u0435 \u0442\u044b, \u043f\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u044f\u043a \u0434\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u044f\u043a\u0456 \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u0439 \u0437\u0440\u0430\u0431\u0456\u045e \u0411\u043e\u0433\u0430 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u044b\u043c \u0434\u0430 \u0446\u044f\u0431\u0435 \u0456 \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u045e \u0446\u044f\u0431\u0435 \u0437 \u0410\u0439\u0446\u043e\u043c, \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0439\u0441\u044f \u045e \u043a\u0440\u044b\u0432\u0456 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u043d\u0430\u0432\u0443\u0447\u044b\u0441\u044f \u0445\u0443\u0442\u0447\u044d\u0439 \u043a\u0440\u044b\u0432\u0456 \u0441\u043b\u043e\u0432\u0430 \u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u0430\u0436\u0430 \u0442\u0430\u0431\u0435: &laquo;\u0413\u044d\u0442\u0430 \u041a\u0440\u043e\u045e \u041c\u0430\u044f, \u044f\u043a\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u043b\u0456\u0442\u0430 \u0437\u0430 \u043c\u043d\u043e\u0433\u0456\u0445 \u0434\u0437\u0435\u043b\u044f \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u044f \u0433\u0440\u0430\u0445\u043e\u045e&raquo; (\u043f\u0430\u0440. \u041c\u0446 26, 28).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439 \u0431\u0435\u0437 \u0443\u0432\u0430\u0433\u0456 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0410\u0430\u0440\u043e\u043d \u043a\u0440\u044b\u0432\u0451\u044e \u043f\u0430\u043a\u0440\u0430\u043f\u0456\u045e \u0432\u0435\u043a\u0430 \u0437 \u0443\u0441\u0445\u043e\u0434\u0443. \u0423\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435 \u0437 \u0443\u0441\u0445\u043e\u0434\u0443, \u0431\u043e \u0430\u0434\u0442\u0443\u043b\u044c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041c\u0443\u0436, \u0456\u043c\u044f \u044f\u043a\u043e\u0433\u0430 \u0423\u0441\u0445\u043e\u0434, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u043c \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0430\u0435 \u0446\u044f\u0431\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u045e\u0441\u0445\u043e\u0434, \u0430\u0434\u043a\u0443\u043b\u044c \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u045e\u0437\u044b\u0434\u0437\u0435 \u0421\u043e\u043d\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456; \u0430\u0434\u043a\u0443\u043b\u044c \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u043e, \u043a\u0430\u0431 \u0442\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0445\u0430\u0434\u0437\u0456\u045e \u0443 \u0437\u043c\u0440\u043e\u043a\u0443 \u0456 \u043a\u0430\u0431 \u0430\u043f\u043e\u0448\u043d\u0456 \u0434\u0437\u0435\u043d\u044c \u043d\u0435 \u0437\u0430\u0441\u043f\u0435\u045e \u0446\u044f\u0431\u0435 \u045e \u0446\u0435\u043c\u0440\u044b; \u043a\u0430\u0431 \u0443 \u0446\u044f\u0431\u0435 \u043d\u0435 \u0437\u0430\u043a\u0440\u0430\u043b\u0430\u0441\u044f \u043d\u043e\u0447 \u0456 \u0456\u043c\u0433\u043b\u0430, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0442\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0436\u044b\u045e \u0443 \u0441\u0432\u044f\u0442\u043b\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456; \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u0435\u045e \u0443 \u0441\u0430\u0431\u0435 \u0434\u0437\u0435\u043d\u044c \u0432\u0435\u0440\u044b \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u0441\u0432\u044f\u0442\u043b\u043e \u0432\u0435\u0440\u044b \u0456 \u0441\u043f\u0430\u043a\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0431\u0440 6, 20; 7, 2. 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0448 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a \u0415\u0437\u0443\u0441, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b \u0411\u0430\u0440\u0430\u043d\u0430\u043a, \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0437\u0430 \u0437\u0430\u0441\u043b\u043e\u043d\u0443; <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u043d\u0430\u0432\u0435\u043a\u0456 \u0441\u0442\u0430\u045e \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0441\u044c \u043a\u0430\u0440\u043e\u043b\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0456 \u042f\u0433\u043e\u043d\u0430\u043c\u0443 \u0440\u043e\u0434\u0443 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u043d\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u043d\u0430\u0432\u0435\u043a\u0456 \u0441\u0442\u0430\u045e \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"543","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 10 in Quadragesima, 3-5: PL 54, 299-301)<\/span><br \/><span style=\"color: #ff0000;\">\u0414\u0430\u0431\u0440\u043e \u043b\u044e\u0431\u043e\u0432\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0441\u0432\u044f\u0442\u044b\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430 \u041f\u0430\u043d \u043a\u0430\u0436\u0430: &laquo;\u041f\u0430 \u0433\u044d\u0442\u044b\u043c \u0443\u0441\u0435 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0432\u044b \u041c\u0430\u0435 \u0432\u0443\u0447\u043d\u0456, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043c\u0435\u0446\u044c \u043b\u044e\u0431\u043e\u045e \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e&raquo; (\u042f\u043d 13, 35). \u0423 \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u0442\u0430\u0433\u043e \u0436 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u0447\u044b\u0442\u0430\u0435\u043c: &laquo;\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0431\u0443\u0434\u0437\u0435\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u0431\u043e \u043b\u044e\u0431\u043e\u045e \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u0432\u0435\u0434\u0430\u0435 \u0411\u043e\u0433\u0430. \u0425\u0442\u043e \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c, \u0442\u043e\u0439 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0411\u043e\u0433\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u043b\u044e\u0431\u043e\u045e&raquo; (1 \u042f\u043d 4, 7-8).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0440\u043e\u0437\u0443\u043c\u044b \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0446\u044c \u043d\u0430\u0434 \u0441\u0430\u0431\u043e\u044e \u0456 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0430 \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c \u0433\u043b\u044b\u0431\u043e\u043a\u0456\u044f \u043f\u0430\u0447\u0443\u0446\u0446\u0456 \u0441\u0432\u0430\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u045e, \u0430 \u043a\u0430\u043b\u0456 \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u0441\u0432\u0430\u0456\u043c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0456 \u0445\u043e\u0446\u044c \u043d\u0435\u0439\u043a\u0456\u044f \u043f\u043b\u0430\u0434\u044b \u043b\u044e\u0431\u043e\u0432\u0456, \u043c\u043e\u0433\u0443\u0446\u044c \u043d\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430, \u0448\u0442\u043e \u043c\u0430\u044e\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u0411\u043e\u0433\u0430. \u041a\u0430\u0431 \u0437 \u043a\u043e\u0436\u043d\u044b\u043c \u0440\u0430\u0437\u0430\u043c \u0443\u0441\u0451 \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0446\u0446\u0430 \u0434\u043b\u044f \u0442\u0430\u043a\u043e\u0433\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0413\u043e\u0441\u0446\u044f, \u044f\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0447\u0430\u0441\u0446\u0435\u0439 \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u0446\u044c \u0443\u0447\u044b\u043d\u043a\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0411\u043e\u0433 &ndash; \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u043e\u045e, \u0442\u043e \u044f\u043d\u0430 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u043c\u0435\u0446\u044c \u043d\u0456\u044f\u043a\u0456\u0445 \u043c\u0435\u0436\u0430\u045e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0441\u043a\u0430\u0441\u0446\u0456 \u043d\u0435\u043b\u044c\u0433\u0430 \u0437\u0430\u043c\u043a\u043d\u0443\u0446\u044c \u043d\u0456\u044f\u043a\u0456\u043c\u0456 \u043c\u0435\u0436\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043a\u043e\u0436\u043d\u044b \u0447\u0430\u0441 \u043f\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u043b\u044f \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u045e\u0447\u044b\u043d\u043a\u0430\u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0430\u0434\u043d\u0430\u043a \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456\u044f \u0434\u043d\u0456 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u0441 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430. \u0425\u0442\u043e \u0445\u043e\u0447\u0430 \u0441\u0443\u0441\u0442\u0440\u044d\u0446\u044c \u041f\u0430\u0441\u0445\u0443 \u041f\u0430\u043d\u0430 \u045e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u0430, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0443 \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u044b \u0434\u0430\u0440 \u043b\u0430\u0441\u043a\u0456, \u0431\u043e \u0451\u043d \u0437\u043c\u044f\u0448\u0447\u0430\u0435 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u044f \u0446\u043d\u043e\u0442\u044b \u0456 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0433\u0440\u0430\u0445\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0431\u0456\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u043d\u0430\u0439\u0432\u044f\u043b\u0456\u043a\u0448\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443, \u043a\u0430\u043b\u0456 \u043a\u0440\u043e\u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0434\u043a\u0443\u043f\u0456\u043b\u0430 \u043d\u0430\u0448\u044b \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0456, \u043d\u0430\u0439\u043f\u0435\u0440\u0448 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0435\u043c \u0430\u0445\u0432\u044f\u0440\u044b \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0456, \u044f\u043a \u0441\u0430\u043c\u0456 \u0437\u0432\u0435\u0434\u0430\u043b\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0443\u044e \u0434\u0430\u0431\u0440\u044b\u043d\u044e \u0411\u043e\u0433\u0430, \u0431\u0443\u0434\u0437\u0435\u043c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u044f \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430\u0441 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0448\u0430 \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u044c \u0434\u0430 \u045e\u0431\u043e\u0433\u0456\u0445 \u0456 \u0446\u0435\u0440\u043f\u044f\u0447\u044b\u0445 \u043d\u0430 \u0440\u043e\u0437\u043d\u044b\u044f \u0445\u0432\u0430\u0440\u043e\u0431\u044b \u0432\u044b\u044f\u0432\u0456\u0446\u0446\u0430 \u0437 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u0430\u044e \u043c\u043e\u0446\u0430\u0439, \u043a\u0430\u0431 \u0433\u0430\u043b\u0430\u0441\u044b \u043c\u043d\u043e\u0433\u0456\u0445 \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u043b\u0456 \u0411\u043e\u0433\u0443 \u0456 \u043a\u0430\u0431 \u043d\u0430\u0448 \u043f\u043e\u0441\u0442 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u0430\u043b\u0430\u0434\u0430\u0435. \u041d\u0456\u044f\u043a\u0430\u044f \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u0442\u0430\u043a \u043d\u0435 \u0446\u0435\u0448\u044b\u0446\u044c \u0411\u043e\u0433\u0430, \u044f\u043a \u043a\u043b\u043e\u043f\u0430\u0442 \u043f\u0440\u0430 \u0431\u0435\u0434\u043d\u044b\u0445. \u0422\u0430\u043c, \u0434\u0437\u0435 \u0411\u043e\u0433 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u043a\u043b\u043e\u043f\u0430\u0442, \u0401\u043d \u0431\u0430\u0447\u044b\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0431\u0430\u044f\u0446\u0446\u0430, \u0448\u0442\u043e \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0432\u044b\u0434\u0430\u0442\u043a\u0456 \u0437\u043c\u0435\u043d\u0448\u0430\u0446\u044c \u043d\u0430\u0448\u0443\u044e \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u044c, \u0431\u043e \u0441\u0430\u043c\u0430 \u0437\u044b\u0447\u043b\u0456\u0432\u0430\u0441\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044c, \u0430 \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u0456 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043d\u0435\u0441\u0442\u0430\u0432\u0430\u0446\u044c \u0441\u0440\u043e\u0434\u043a\u0430\u045e \u0442\u0430\u043c, \u0434\u0437\u0435 \u043a\u043e\u0440\u043c\u0456\u0446\u044c \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0456 \u0434\u0437\u0435 \u043a\u043e\u0440\u043c\u044f\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430. \u0423 \u043a\u043e\u0436\u043d\u0443\u044e \u0442\u0430\u043a\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443 \u045e\u043c\u0435\u0448\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u044f \u0440\u0443\u043a\u0430, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435 \u0445\u043b\u0435\u0431, \u043b\u0430\u043c\u0430\u044e\u0447\u044b \u044f\u0433\u043e, \u0456 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435, \u0440\u0430\u0437\u0434\u0430\u044e\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u0435 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443, \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b \u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u044b, \u0431\u043e \u0442\u0430\u0434\u044b \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u043d\u0430\u0439\u0432\u044f\u043b\u0456\u043a\u0448\u0443\u044e \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u043d\u0430\u0439\u043c\u0435\u043d\u0448 \u0441\u0430\u0431\u0435 \u043f\u0430\u043a\u0456\u043d\u0435, \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b: &laquo;\u0422\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u0435 \u0441\u0435\u0439\u0431\u0456\u0442\u0443 \u043d\u0430\u0441\u0435\u043d\u043d\u0435 \u0456 \u0445\u043b\u0435\u0431 \u043d\u0430 \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a, \u0434\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u044c \u0432\u0430\u0448\u0430\u0435 \u043d\u0430\u0441\u0435\u043d\u043d\u0435, \u0456 \u045e\u0437\u0440\u0430\u0441\u0446\u0456\u0446\u044c \u043f\u043b\u0451\u043d \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0432\u0430\u0448\u0430\u0439&raquo; (2 \u041a\u0430\u0440 9, 10) \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u043d\u0430\u0448\u044b\u043c \u041f\u0430\u043d\u0443, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 6, 38; \u041a\u043b\u0441 3, 13b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430\u0432\u0430\u0439\u0446\u0435, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u0430\u043c: <span style=\"color: #ff0000;\">*<\/span> \u043c\u0435\u0440\u0443 \u0434\u043e\u0431\u0440\u0443\u044e, \u0443\u0446\u0456\u0441\u043d\u0443\u0442\u0443\u044e, \u0443\u0442\u0440\u044d\u0441\u0435\u043d\u0443\u044e \u0456 \u0437 \u0432\u0435\u0440\u0445\u0430\u043c \u0430\u0434\u0441\u044b\u043f\u043b\u044e\u0446\u044c \u0443 \u043f\u0430\u0434\u043e\u043b \u0432\u0430\u0448. \u0411\u043e \u044f\u043a\u043e\u044e \u043c\u0435\u0440\u0430\u044e \u043c\u0435\u0440\u0430\u0435\u0446\u0435, \u0442\u0430\u043a\u043e\u0439 \u0456 \u0432\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043c\u0435\u0440\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043a \u041f\u0430\u043d \u0434\u0430\u045e \u0432\u0430\u043c, \u0442\u0430\u043a \u0456 \u0432\u044b \u0434\u0430\u0432\u0430\u0439\u0446\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0435\u0440\u0443 \u0434\u043e\u0431\u0440\u0443\u044e, \u0443\u0446\u0456\u0441\u043d\u0443\u0442\u0443\u044e, \u0443\u0442\u0440\u044d\u0441\u0435\u043d\u0443\u044e \u0456 \u0437 \u0432\u0435\u0440\u0445\u0430\u043c \u0430\u0434\u0441\u044b\u043f\u043b\u044e\u0446\u044c \u0443 \u043f\u0430\u0434\u043e\u043b \u0432\u0430\u0448. \u0411\u043e \u044f\u043a\u043e\u044e \u043c\u0435\u0440\u0430\u044e \u043c\u0435\u0440\u0430\u0435\u0446\u0435, \u0442\u0430\u043a\u043e\u0439 \u0456 \u0432\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043c\u0435\u0440\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"544","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041c\u0430\u043a\u0441\u0456\u043c\u0430 \u0412\u044b\u0437\u043d\u0430\u045e\u0446\u044b, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 11: PG 91, 454-455)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u043d \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0434\u044b \u0442\u044b\u0445, \u0445\u0442\u043e \u043a\u0430\u0435\u0446\u0446\u0430 <\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u0441\u0442\u0443\u043d\u044b \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u045e\u0441\u0435 \u0441\u043b\u0443\u0433\u0456 \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u044f\u043a\u0456\u044f \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437\u043e\u045e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0430\u0436 \u0434\u0430 \u043d\u0430\u0448\u044b\u0445 \u0447\u0430\u0441\u043e\u045e \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u043b\u0456 \u043d\u0430\u043c \u0437\u0431\u0430\u045e\u0447\u0443\u044e \u0432\u043e\u043b\u044e \u0411\u043e\u0433\u0430, \u043a\u0430\u0436\u0443\u0446\u044c, \u0448\u0442\u043e \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u0430\u0433\u0430 \u0456 \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0433\u0430 \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u0434\u0430 \u042f\u0433\u043e \u043b\u044e\u0434\u0437\u0435\u0439, \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u043d\u0430\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0433\u044d\u0442\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0431\u043e\u0441\u043a\u0456\u043c \u0441\u043f\u043e\u0441\u0430\u0431\u0430\u043c, \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0410\u0439\u0446\u0430 (\u0437\u0440\u044d\u0448\u0442\u044b, \u043f\u0435\u0440\u0448\u0430\u0435 \u0456 \u0430\u0434\u0437\u0456\u043d\u0430\u0435 \u043f\u043e\u045e\u043d\u0430\u0435 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456) \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u043b\u0430 \u0441\u044f\u0431\u0435, \u0441\u0445\u0456\u043b\u0456\u045e\u0448\u044b\u0441\u044f \u0434\u0430 \u043d\u0430\u0441, \u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u043b\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0446\u0435\u043b\u0430 \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441. \u041a\u0430\u0431 \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u0446\u044c \u043d\u0430\u0441 \u0437 \u0410\u0439\u0446\u043e\u043c, \u0433\u044d\u0442\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430, \u0441\u0446\u044f\u0440\u043f\u0435\u043b\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u043b\u0456 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043c\u044b, \u043a\u0430\u043b\u0456 \u044f\u0448\u0447\u044d \u0431\u044b\u043b\u0456 \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456 \u0456 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u043c\u0456 \u0410\u0439\u0446\u0430. \u0425\u043e\u0446\u044c \u043c\u044b \u0441\u0442\u0430\u043b\u0456 \u0430\u0434\u0447\u0443\u0436\u0430\u043d\u044b\u043c\u0456 \u0430\u0434 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0421\u043b\u043e\u0432\u0430 \u0437\u043d\u043e\u045e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u043d\u0430\u0441 \u0434\u0430 \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u044f\u0447\u044b\u043b\u0430 \u043c\u043e\u0446\u0430\u044e \u0441\u0432\u0430\u0456\u0445 \u0446\u0443\u0434\u0430\u045e \u043d\u0430\u0448\u044b\u044f \u0445\u0432\u0430\u0440\u043e\u0431\u044b, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u044b\u043d\u044f\u043b\u043e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u043d\u0430\u0448\u044b\u0445 \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435\u043c. \u0411\u0443\u0434\u0443\u0447\u044b \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u043c \u0443\u0441\u044f\u043a\u0430\u0439 \u0432\u0456\u043d\u044b, \u042f\u043d\u043e \u0437\u0430\u043f\u043b\u0430\u0446\u0456\u043b\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b, \u043d\u0430\u0448 \u0434\u043e\u045e\u0433, \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e\u0448\u044b \u043d\u0430\u0441 \u0430\u0434 \u043c\u043d\u043e\u0433\u0456\u0445 \u0436\u0443\u0434\u0430\u0441\u043d\u044b\u0445 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f\u045e. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u042f\u043d\u043e \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u043c\u0456 \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u044f\u043c\u0456 \u043f\u0430\u0440\u0430\u0456\u043b\u0430 \u043d\u0430\u043c, \u044f\u043a \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u0446\u0446\u0430 \u0434\u0430 \u042f\u0433\u043e \u043f\u0440\u0430\u0437 \u0433\u043b\u044b\u0431\u043e\u043a\u0443\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0456\u043d\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0415\u0437\u0443\u0441 \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u045e: &laquo;\u042f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0434\u0430 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f \u043d\u0435 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e, \u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e&raquo; (\u041b\u043a 5, 32). \u0410 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: &laquo;\u041d\u0435 \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u043c \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b \u043b\u0435\u043a\u0430\u0440, \u0430 \u0445\u0432\u043e\u0440\u044b\u043c&raquo; (\u041c\u0446 9, 12). \u0422\u0430\u043a\u0456\u043c \u0436\u0430 \u0447\u044b\u043d\u0430\u043c \u0415\u0437\u0443\u0441 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0448\u0443\u043a\u0430\u0446\u044c \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u0443\u044e \u0430\u0432\u0435\u0447\u043a\u0443. \u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0401\u043d \u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0434\u0430 \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u0422\u0430\u043a\u0456\u043c \u0436\u0430 \u0447\u044b\u043d\u0430\u043c \u043f\u0440\u0430\u0437 \u043f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044c \u043f\u0440\u0430 \u0434\u0440\u0430\u0445\u043c\u0443 \u0401\u043d \u044f\u0441\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437, \u044f\u043a\u0456 \u0431\u044b\u045e \u043f\u0430\u043a\u0440\u044b\u0442\u044b \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0430\u0433\u0456\u0434\u043d\u044b\u043c \u0431\u0440\u0443\u0434\u0430\u043c \u0433\u0440\u0430\u0445\u043e\u045e. \u041d\u0430\u0440\u044d\u0448\u0446\u0435: &laquo;\u041a\u0430\u0436\u0443 \u0432\u0430\u043c, \u0448\u0442\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u0445 \u0431\u043e\u043b\u044c\u0448 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430, \u044f\u043a\u0456 \u043f\u0430\u043a\u0430\u044f\u045e\u0441\u044f&raquo; (\u041b\u043a 15, 7).<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0433\u0430\u0434\u0430\u0435\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u0443\u044e \u043f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044c \u043f\u0440\u0430 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0430, \u044f\u043a\u0456 \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u045e \u0443 \u0440\u0443\u043a\u0456 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e, \u0431\u044b\u045e \u0434\u0430\u0448\u0447\u044d\u043d\u0442\u0443 \u0430\u0431\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u044b, \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u044b \u0456 \u043a\u0456\u043d\u0443\u0442\u044b \u043d\u0430\u043f\u0430\u045e\u0436\u044b\u0432\u044b. \u0414\u043e\u0431\u0440\u044b \u0441\u0430\u043c\u0430\u0440\u0430\u043d\u0456\u043d \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u044f\u0433\u043e \u0430\u043b\u0435\u0435\u043c \u0456 \u0432\u0456\u043d\u043e\u043c \u0456, \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u045e\u0448\u044b \u043d\u0430 \u0441\u0432\u0430\u044e \u0436\u044b\u0432\u0451\u043b\u0443, \u0430\u0434\u0432\u0451\u0437 \u044f\u0433\u043e \u045e \u043a\u0430\u0440\u0447\u043c\u0443, \u0456 \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u044b\u045e \u044f\u043c\u0443 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0443\u044e \u0430\u043f\u0435\u043a\u0443, \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e\u0448\u044b \u043f\u0440\u044b \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0456 \u043f\u0430\u043a\u0440\u044b\u0446\u044c \u0434\u0430\u0434\u0430\u0442\u043a\u043e\u0432\u044b\u044f \u0432\u044b\u0434\u0430\u0442\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0456 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u044b \u0430\u0439\u0446\u0435\u0446 \u0441\u0445\u0456\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u043c\u0430\u0440\u043d\u0430\u0442\u0440\u0430\u045e\u043d\u044b\u043c \u0441\u044b\u043d\u0430\u043c. \u0401\u043d \u0430\u0431\u0434\u044b\u043c\u0430\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u045e \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0456 \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u044f\u0433\u043e, \u0456 \u0437\u043d\u043e\u045e \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0435 \u044f\u0433\u043e \u0430\u0439\u0446\u043e\u045e\u0441\u043a\u0430\u0439 \u0441\u043b\u0430\u0432\u0430\u0439, \u043d\u0435 \u0437\u0433\u0430\u0434\u0432\u0430\u044e\u0447\u044b \u043d\u0456\u044f\u043a\u0456\u0445 \u0440\u0430\u043d\u0435\u0439\u0448\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e \u0456 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0433\u044d\u0442\u0430\u0439 \u0436\u0430 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0414\u043e\u0431\u0440\u044b \u041f\u0430\u0441\u0442\u044b\u0440 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u043a\u0443, \u044f\u043a\u0430\u044f \u0430\u0434\u0431\u0456\u043b\u0430\u0441\u044f \u0430\u0434 \u0411\u043e\u0436\u0430\u0433\u0430 \u0441\u0442\u0430\u0442\u043a\u0443 \u0456 \u0431\u043b\u0443\u043a\u0430\u043b\u0430 \u043f\u0430 \u0433\u0430\u0440\u0430\u0445 \u0456 \u045e\u0437\u0433\u043e\u0440\u043a\u0430\u0445. \u0401\u043d \u043d\u0435 \u043f\u0430\u0434\u0433\u0430\u043d\u044f\u0435 \u044f\u0435 \u0456 \u043d\u0435 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0435, \u0430\u043b\u0435, \u043d\u0435 \u0448\u043a\u0430\u0434\u0443\u044e\u0447\u044b \u0432\u044b\u0441\u0456\u043b\u043a\u0443, \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u0430 \u0437\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u044f\u0435 \u045e \u0430\u045e\u0447\u0430\u0440\u043d\u044e, \u0430\u043b\u0435 \u0431\u044f\u0440\u044d \u043d\u0430 \u0440\u0443\u043a\u0456 \u0456 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u0432\u044f\u0440\u0442\u0430\u0435 \u044f\u0435 \u0434\u0430 \u0440\u044d\u0448\u0442\u044b \u0441\u0442\u0430\u0442\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u045e: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435, \u0443\u0441\u0435 \u0441\u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0456 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0430\u043d\u044b\u044f, \u0456 \u042f \u0441\u0443\u043f\u0430\u043a\u043e\u044e \u0432\u0430\u0441&raquo; (\u041c\u0446 11, 28). \u0406 \u0434\u0430\u043b\u0435\u0439: &laquo;\u0412\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u044f\u0440\u043c\u043e \u041c\u0430\u0451 \u043d\u0430 \u0441\u044f\u0431\u0435&raquo; (\u041c\u0446 11, 29), \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0447\u044b \u044f\u0440\u043c\u043e\u043c \u0441\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0446\u0456 \u0436\u044b\u0446\u0446\u0451, \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u0430\u0435 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u043c\u0456 \u043f\u0440\u044b\u043d\u0446\u044b\u043f\u0430\u043c\u0456. \u0410 \u0446\u044f\u0436\u0430\u0440 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f, \u044f\u043a\u0456 \u043c\u043e\u0436\u0430 \u0437\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0446\u044f\u0436\u043a\u0456\u043c, \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u043b\u0451\u0433\u043ai\u043c: &laquo;\u0411\u043e \u044f\u0440\u043c\u043e \u041c\u0430\u0451 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435, \u0456 \u0446\u044f\u0436\u0430\u0440 \u041c\u043e\u0439 \u043b\u0451\u0433\u043a\u0456&raquo; (\u041c\u0446 11, 30).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0432\u0443\u0447\u0430\u044e\u0447\u044b \u043d\u0430\u043a\u043e\u043d\u0442 \u0411\u043e\u0436\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0434\u0430\u0431\u0440\u044b\u043d\u0456, \u0437\u0433\u0430\u0434\u0432\u0430\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456, \u044f\u043a \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0410\u0439\u0446\u0435\u0446 \u0432\u0430\u0448 \u041d\u044f\u0431\u0435\u0441\u043d\u044b&raquo; (\u043f\u0430\u0440. \u041b\u043a 6, 37). \u0406 \u0434\u0430\u043b\u0435\u0439: &laquo;\u041f\u0440\u0430\u0431\u0430\u0447\u0430\u0439\u0446\u0435, \u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u0430\u0446\u044c \u0432\u0430\u043c&raquo; (\u041b\u043a 6, 37), \u0456 \u043d\u0430\u0440\u044d\u0448\u0446\u0435: &laquo;\u0423\u0441\u0451, \u0448\u0442\u043e \u0445\u043e\u0447\u0430\u0446\u0435, \u043a\u0430\u0431 \u0440\u0430\u0431\u0456\u043b\u0456 \u0432\u0430\u043c \u043b\u044e\u0434\u0437\u0456, \u0456 \u0432\u044b \u0456\u043c \u0440\u0430\u0431\u0456\u0446\u0435&raquo; (\u041c\u0446 7, 12).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042d\u0437\u0445 33, 11; \u041f\u0441 94 (93), 19<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u045e\u0441\u0445\u0432\u0430\u043b\u044f\u0432\u0430\u045e\u0441\u044f \u0431, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0432\u0435\u0434\u0430\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0422\u0432\u0430\u0451\u0439, \u041f\u0430\u043d\u0435. \u0410\u043b\u0435 \u0422\u044b \u0441\u043a\u0430\u0437\u0430\u045e: \u0425\u0430\u0447\u0443 \u043d\u0435 \u0441\u043c\u0435\u0440\u0446\u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0451\u043d \u043d\u0430\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0456 \u0436\u044b\u045e. <span style=\"color: #ff0000;\">*<\/span> \u0422\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f \u043a\u0430\u043d\u0430\u0430\u043d\u0446\u0430 \u0456 \u043c\u044b\u0442\u043d\u0456\u043a\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0442\u0440\u044b\u0432\u043e\u0433\u0430 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u0422\u0432\u0430\u0451 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u0435 \u043c\u0430\u044e \u0434\u0443\u0448\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f \u043a\u0430\u043d\u0430\u0430\u043d\u0446\u0430 \u0456 \u043c\u044b\u0442\u043d\u0456\u043a\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"545","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 15, De passione Domini, 3-4: PL 54, 366-367)<\/span><br \/><span style=\"color: #ff0000;\">\u0420\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043c\u0443\u043a\u0443 \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u0445\u0442\u043e \u043f\u0430-\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435 \u043c\u0443\u043a\u0443 \u041f\u0430\u043d\u0430, \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u043a \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0432\u0430\u0447\u044b\u043c\u0430 \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u0431 \u043f\u0440\u044b\u0437\u043d\u0430\u0446\u044c \u0441\u0432\u0430\u0456\u043c \u042f\u0433\u043e\u043d\u0430\u0435 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u0434\u0440\u044b\u0436\u044b\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f \u0437\u044f\u043c\u043d\u043e\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u0440\u0430\u0437\u0430\u0440\u0432\u0443\u0446\u0446\u0430 \u0441\u043a\u0430\u043b\u044b \u043d\u044f\u0432\u0435\u0440\u043d\u044b\u0445 \u0434\u0443\u0448 \u0456 \u043d\u044f\u0445\u0430\u0439 \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0432\u0430\u043b\u0430 \u043d\u0430\u0434\u043c\u0430\u0433\u0456\u043b\u043b\u0435 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456, \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u0443\u0446\u044c, \u0441\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u043d\u0430\u0441\u044b\u043f \u0433\u0440\u0430\u0445\u043e\u045e. \u041d\u044f\u0445\u0430\u0439 \u0446\u044f\u043f\u0435\u0440 \u0437&rsquo;\u044f\u0432\u044f\u0446\u0446\u0430 \u045e \u0441\u0432\u044f\u0442\u044b\u043c \u0433\u043e\u0440\u0430\u0434\u0437\u0435, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443 \u0411\u043e\u0436\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u0437\u043d\u0430\u043a\u0456 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f, \u043a\u0430\u0431 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0430\u0434\u0431\u044b\u0446\u0446\u0430 \u0437 \u0446\u0435\u043b\u0430\u043c\u0456, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u0446\u044f\u043f\u0435\u0440 \u0443 \u0441\u044d\u0440\u0446\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0456\u043a\u043e\u043c\u0443 \u0441\u0430 \u0441\u043b\u0430\u0431\u044b\u0445 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043c\u043e\u045e\u043b\u0435\u043d\u0430 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u043f\u0435\u0440\u0430\u043c\u043e\u0437\u0435 \u043a\u0440\u044b\u0436\u0430, \u043d\u044f\u043c\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0456\u043a\u043e\u0433\u0430, \u043a\u0430\u0433\u043e \u0431 \u043d\u0435 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041a\u0430\u043b\u0456 \u044f\u043d\u0430 \u0431\u044b\u043b\u0430 \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0439 \u043c\u043d\u043e\u0433\u0456\u043c \u042f\u0433\u043e \u043b\u044e\u0442\u044b\u043c \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0430\u043c, \u0434\u044b\u043a \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u043f\u0430\u043c\u043e\u0436\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0434\u0430 \u042f\u0433\u043e \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u044b\u043b\u043e \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435, \u0441\u0442\u0430\u043b\u0430 \u043c\u0435\u043d\u0448 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u045e, \u0430 \u0442\u043e\u0439 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u044b \u043c\u0435\u0447, \u044f\u043a\u0456 \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u045e \u0434\u043e\u0441\u0442\u0443\u043f \u0443 \u043a\u0440\u0430\u0456\u043d\u0443 \u0436\u044b\u0446\u0446\u044f, \u0431\u044b\u045e \u043f\u0430\u0433\u0430\u0448\u0430\u043d\u044b \u0441\u0432\u044f\u0442\u043e\u044e \u043a\u0440\u044b\u0432\u0451\u044e \u0425\u0440\u044b\u0441\u0442\u0430. \u0417 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430 \u0440\u0430\u0441\u0441\u0435\u044f\u045e\u0441\u044f \u0437\u043c\u0440\u043e\u043a \u0434\u0430\u045e\u043d\u044f\u0439 \u043d\u043e\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456 \u043d\u0430\u0440\u043e\u0434 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0437\u0430\u043f\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u0434\u0430 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u0440\u0430\u0439\u0441\u043a\u0456\u043c \u0431\u0430\u0433\u0430\u0446\u0446\u0456, \u0430 \u045e\u0441\u0435 \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f \u043c\u043e\u0433\u0443\u0446\u044c \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0441\u0442\u0440\u0430\u0447\u0430\u043d\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u044b, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435\u0445\u0442\u0430 \u0441\u0430\u043c \u043d\u0435 \u0437\u0430\u043a\u0440\u044b\u0435 \u0441\u0430\u0431\u0435 \u0448\u043b\u044f\u0445, \u044f\u043a\u0456 \u043c\u043e\u0436\u0430 \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u043d\u0430\u0432\u0430\u0442 \u0432\u0435\u0440\u0430 \u0437\u043b\u043e\u0434\u0437\u0435\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u043d\u0435 \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u044e\u0446\u044c \u043d\u0430\u0441 \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430 \u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u044e\u0446\u044c \u043d\u0430\u043c \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0441\u0442\u0430\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f. \u0401\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0456 \u0441\u0446\u044f\u0440\u043f\u0435\u045e \u0443\u0441\u0451 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043a\u0430\u0431 \u043c\u043e\u0446, \u044f\u043a\u0443\u044e \u043c\u0430\u0435 \u0413\u0430\u043b\u0430\u0432\u0430, \u043f\u0435\u0440\u0430\u0434\u0430\u043b\u0430\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0446\u0435\u043b\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0456\u0431\u0430 \u0436 \u0442\u043e\u0435 \u0432\u044f\u0434\u043e\u043c\u0430\u0435 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u0435 \u0411\u043e\u0433\u0430\u043c \u043d\u0430\u0448\u0430\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 &laquo;\u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u043c\u0456&raquo; (\u042f\u043d 1, 14), \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u043b\u0430, \u0437\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435\u043c \u043d\u044f\u0432\u0435\u0440\u043d\u044b\u0445, \u0445\u043e\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0411\u043e\u0436\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456? \u0425\u0442\u043e \u0436 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u043c\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0430\u043c \u043f\u0440\u044b\u043c\u0430\u0435 \u044f\u0433\u043e; \u0456 \u0430\u0434\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0430\u0434 \u0442\u0430\u0433\u043e \u0436 \u0414\u0443\u0445\u0430, \u0430\u0434 \u044f\u043a\u043e\u0433\u0430 \u0431\u044b\u045e \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0415\u0437\u0443\u0441? \u0425\u0442\u043e \u0436 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0443 \u0406\u043c \u0441\u0432\u0430\u0435 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456? \u0425\u0442\u043e \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u0435 \u0435\u0436\u044b, \u0441\u043e\u043d, \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u0430\u0441\u0446\u044c \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u043c\u0456, \u0441\u043b\u0451\u0437\u044b \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u044f \u0431\u044b\u043b\u0456 \u045e \u0406\u043c \u043f\u0440\u0430\u044f\u0432\u0430\u043c\u0456 \u043d\u0430\u0448\u0430\u0439 \u0441\u043b\u0430\u0431\u043e\u0439 \u043d\u0430\u0442\u0443\u0440\u044b?<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u0432\u044b\u043b\u0435\u0447\u044b\u0446\u044c \u044f\u0435 \u0430\u0434 \u0441\u0442\u0430\u0440\u044b\u0445 \u0440\u0430\u043d \u0456 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u0430\u0434 \u0431\u0440\u0443\u0434\u0443 \u0433\u0440\u0430\u0445\u0443, \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u0441\u0442\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0421\u044b\u043d\u0430\u043c \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c, \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u0446\u044c \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u043c \u043d\u0456\u0447\u043e\u0433\u0430 \u0437 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0456 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u043d\u0430\u0448\u0430\u0435 \u043c\u0451\u0440\u0442\u0432\u0430\u0435 \u0446\u0435\u043b\u0430 \u043b\u044f\u0436\u0430\u043b\u0430 \u045e \u043c\u0430\u0433\u0456\u043b\u0435, \u0430 \u043d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0430, \u043a\u0430\u0431 \u043f\u0430\u0434\u043d\u044f\u0446\u0446\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u044f\u043a\u0456\u044f \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0432\u044b\u0441\u0456 \u0456 \u0441\u0435\u0441\u0446\u0456 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0410\u0439\u0446\u0430. \u041a\u0430\u043b\u0456 \u043c\u044b \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0448\u043b\u044f\u0445\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u0445 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0456 \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0430\u0440\u043e\u043c\u0435\u0446\u0446\u0430 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0443 \u043f\u0430\u043a\u043e\u0440\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0442\u0430\u0434\u044b \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0437\u043d\u044f\u0441\u0451\u043c\u0441\u044f \u0434\u0430 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u042f\u0433\u043e\u043d\u0430\u0439 \u0445\u0432\u0430\u043b\u0435. \u0401\u043d \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0431\u044f\u0446\u0430\u045e: &laquo;\u041a\u043e\u0436\u043d\u0430\u0433\u0430, \u0445\u0442\u043e \u0432\u044b\u0437\u043d\u0430\u0435 \u041c\u044f\u043d\u0435 \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u0456 \u042f \u043f\u0440\u044b\u0437\u043d\u0430\u044e \u043f\u0435\u0440\u0430\u0434 \u0410\u0439\u0446\u043e\u043c \u041c\u0430\u0456\u043c, \u044f\u043a\u0456 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445&raquo; (\u041c\u0446 10, 32).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 1, 18. 23<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u0456\u043d\u0435, \u0441\u043b\u043e\u0432\u0430 \u0430\u0431 \u043a\u0440\u044b\u0436\u044b &ndash; \u0433\u044d\u0442\u0430 \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0430\u043b\u0435 \u0434\u043b\u044f \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u0437\u0431\u0430\u045e\u043b\u044f\u0435\u043c\u0441\u044f, &ndash; \u0433\u044d\u0442\u0430 \u043c\u043e\u0446 \u0411\u043e\u0436\u0430\u044f. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u044b \u0436 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u0434\u043b\u044f \u044e\u0434\u044d\u044f\u045e &ndash; \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u045e\u043f\u0430\u0434\u043a\u0443, \u0434\u043b\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e &ndash; \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043b\u0435 \u0434\u043b\u044f \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u0437\u0431\u0430\u045e\u043b\u044f\u0435\u043c\u0441\u044f, &ndash; \u0433\u044d\u0442\u0430 \u043c\u043e\u0446 \u0411\u043e\u0436\u0430\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"546","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435&raquo; \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 5, 1-2; PG 26, 1379-1380)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0430\u0431&rsquo;\u044f\u0434\u043d\u043e\u045e\u0432\u0430\u0435 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b\u0445 \u043f\u0430 \u0441\u0432\u0435\u0446\u0435 \u043f\u0440\u0430\u0437 \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430 \u0432\u0435\u0440\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b \u043c\u0430\u0435, \u0446\u0443\u0434\u043e\u045e\u043d\u0430 \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0430\u0434\u043d\u0430\u0433\u043e \u0441\u0432\u044f\u0442\u0430 \u0434\u0430 \u0456\u043d\u0448\u0430\u0433\u0430, \u0456\u0441\u0446\u0456 \u0430\u0434 \u0430\u0434\u043d\u043e\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0434\u0430 \u0456\u043d\u0448\u0430\u0439 \u0456 \u0430\u0434 \u0430\u0434\u043d\u043e\u0439 \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0434\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0439. \u041d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u0447\u0430\u0441, \u044f\u043a\u0456 \u043d\u044f\u0441\u0435 \u043d\u0430\u043c \u043d\u043e\u0432\u044b \u043f\u0430\u0447\u0430\u0442\u0430\u043a, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0439 \u041f\u0430\u0441\u0445\u0456, \u0443 \u044f\u043a\u043e\u0439 \u041f\u0430\u043d \u0431\u044b\u045e \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u044b \u045e \u0430\u0445\u0432\u044f\u0440\u0443. \u041c\u044b \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435\u043c \u0433\u044d\u0442\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u044f\u043a \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0436\u044b\u0446\u0446\u044f \u0456 \u0446\u0435\u0448\u044b\u043c \u043d\u0430\u0448\u0443 \u0434\u0443\u0448\u0443 \u042f\u0433\u043e\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e, \u0431\u044b\u0446\u0446\u0430\u043c \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439. \u0422\u044b\u043c \u043d\u0435 \u043c\u0435\u043d\u0448, \u043c\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0434\u0447\u0443\u0432\u0430\u0435\u043c \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0435, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u043b\u0430\u0435\u043c. \u0410\u043b\u0435 \u0401\u043d \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u0441\u044f\u0440\u043e\u0434 \u0441\u0430\u0441\u043c\u0430\u0433\u043b\u044b\u0445 \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0447\u043d\u0430\u0433\u0430 \u0434\u043d\u044f \u0442\u044b\u0445, \u0443 \u043a\u0430\u0433\u043e \u043f\u0435\u0440\u0430\u0441\u043e\u0445\u043b\u0430 \u043d\u0443\u0442\u0440\u043e, \u044f\u043a, \u0437\u0440\u044d\u0448\u0442\u044b, \u0456 \u043a\u0430\u0436\u0443\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u0417\u0431\u0430\u045e\u0446\u044b: &laquo;\u0425\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435 \u0456 \u043f&rsquo;\u0435&raquo; (\u042f\u043d 7, 37).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0456\u0434\u0443\u0446\u044c \u0434\u0430 \u042f\u0433\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0442\u0440\u044d\u0431\u0430 \u043d\u0430\u0442\u0430\u043b\u0456\u0446\u044c \u043f\u0440\u0430\u0433\u0443. \u0417\u0430\u045e\u0441\u0451\u0434\u044b, \u043a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u043f\u0440\u043e\u0441\u0456\u0446\u044c, \u0417\u0431\u0430\u045e\u0446\u0430 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u043f\u0430\u0434\u044b\u0441\u0446\u0456 \u0434\u0430 \u042f\u0433\u043e. \u041b\u0430\u0441\u043a\u0430 \u0432\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b\u0445 \u0441\u0432\u044f\u0442\u0430\u045e \u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u0430\u0434\u043d\u044b\u043c \u043f\u0435\u0440\u044b\u044f\u0434\u0430\u043c, \u0430\u043b\u0435 \u044f\u0435 \u044f\u0441\u043a\u0440\u0430\u0432\u044b\u044f \u043f\u0440\u043e\u043c\u043d\u0456 \u043d\u0435 \u0437\u0432\u0435\u0434\u0432\u0430\u044e\u0446\u044c \u0437\u0430\u0445\u0430\u0434\u0443 \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u0446\u044c \u0440\u043e\u0437\u0443\u043c \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0440\u0430\u0433\u043d\u0435. \u0413\u044d\u0442\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0432\u0430\u043b\u043e\u0434\u0430\u0435 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u044e \u043c\u043e\u0446\u0430\u0439 \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u043e\u0441\u0456\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b \u0440\u043e\u0437\u0443\u043c \u0456 \u0441\u0445\u0456\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u0411\u043e\u0436\u044b\u043c\u0456 \u043a\u043d\u0456\u0433\u0430\u043c\u0456 \u045e\u0434\u0437\u0435\u043d\u044c \u0456 \u045e\u043d\u0430\u0447\u044b. \u0422\u0430\u043a\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u044c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c\u0456, \u044f\u043a \u0447\u044b\u0442\u0430\u0435\u043c \u0443 \u043f\u0441\u0430\u043b\u044c\u043c\u0435: &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043d\u0435 \u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0430 \u043f\u0430\u0440\u0430\u0434\u0430\u0439 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445 \u0456 \u043d\u0435 \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0448\u043b\u044f\u0445 \u0433\u0440\u044d\u0448\u043d\u044b\u0445, \u0456 \u043c\u0456\u0436 \u043d\u0430\u0441\u043c\u0435\u0448\u043d\u0456\u043a\u0430\u045e \u043d\u0435 \u0437\u0430\u0441\u044f\u0434\u0430\u0435; \u0430\u043b\u0435 \u045e \u0437\u0430\u043a\u043e\u043d\u0435 \u041f\u0430\u043d\u0430 \u044f\u0433\u043e \u0430\u0441\u0430\u043b\u043e\u0434\u0430, \u043d\u0430\u0434 \u0456\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435 \u0451\u043d \u0443\u0434\u0437\u0435\u043d\u044c \u0456 \u045e\u043d\u0430\u0447\u044b&raquo; (\u041f\u0441 1, 1-2).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u043c\u0430\u0435, \u0411\u043e\u0433, \u044f\u043a\u0456 \u043d\u0430\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u0433\u044d\u0442\u0430\u0435 \u0441\u0432\u044f\u0442\u0430, \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u043d\u0430\u043c \u044f\u0433\u043e \u0448\u0442\u043e\u0433\u043e\u0434 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0446\u044c. \u0422\u043e\u0439, \u0445\u0442\u043e \u0430\u0434\u0434\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0436 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u043d\u0430\u0441 \u0441\u0432\u044f\u0442\u0430\u043c, \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u043c \u0443 \u0433\u0430\u0434\u0430\u0432\u044b \u0446\u044b\u043a\u043b. \u0413\u044d\u0442\u0430\u0435 \u0441\u0432\u044f\u0442\u0430 \u043a\u0456\u0440\u0443\u0435 \u043d\u0430\u043c\u0456 \u0441\u044f\u0440\u043e\u0434 \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u045e \u0441\u0432\u0435\u0442\u0443, \u044f\u043a\u0456\u044f \u0432\u044b\u043f\u0430\u0434\u0430\u044e\u0446\u044c \u043d\u0430\u043c, \u0430 \u0411\u043e\u0433 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u045e \u043d\u0430\u0441 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043d\u0435\u0430\u0434\u0440\u044b\u045e\u043d\u0443\u044e \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u0430. \u0401\u043d \u0430\u0431&rsquo;\u044f\u0434\u043d\u043e\u045e\u0432\u0430\u0435 \u043d\u0430\u0441 \u0443 \u0430\u0434\u043d\u0443 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0434\u0443\u0445\u043e\u045e\u043d\u0430 \u0437\u043b\u0443\u0447\u0430\u0435 \u045e\u0441\u0456\u0445 \u0440\u0430\u0441\u043a\u0456\u0434\u0430\u043d\u044b\u0445 \u043f\u0430 \u0446\u044d\u043b\u044b\u043c \u0441\u0432\u0435\u0446\u0435. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u0401\u043d \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u043d\u0430\u043c \u0440\u0430\u0437\u0430\u043c \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0456 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u043f\u0430\u0434\u0437\u044f\u043a\u0443, \u0448\u0442\u043e \u0456 \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0430 \u0441\u0432\u044f\u0442\u044b. \u0413\u044d\u0442\u0430 \u0446\u0443\u0434 \u042f\u0433\u043e\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u0401\u043d \u0441\u0430\u043c \u0437\u0431\u0456\u0440\u0430\u0435 \u043d\u0430 \u0432\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u0430 \u0456 \u0430\u0431&rsquo;\u044f\u0434\u043d\u043e\u045e\u0432\u0430\u0435 \u045e \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0421\u0430\u0444 3, 8. 9; \u042f\u043d 12, 32<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0427\u0430\u043a\u0430\u0439 \u041c\u044f\u043d\u0435, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u0443 \u0434\u0437\u0435\u043d\u044c \u041c\u0430\u0439\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0442\u0430\u0434\u044b \u042f \u0432\u044f\u0440\u043d\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0432\u0443\u0441\u043d\u044b \u0447\u044b\u0441\u0442\u044b\u044f, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0456 \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u042f\u043c\u0443 \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u045e\u0437\u043d\u044f\u0442\u044b \u043d\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u044e, \u042f \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443 \u045e\u0441\u0456\u0445 \u0434\u0430 \u0441\u044f\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0442\u0430\u0434\u044b \u042f \u0432\u044f\u0440\u043d\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0432\u0443\u0441\u043d\u044b \u0447\u044b\u0441\u0442\u044b\u044f, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0456\u043c\u044f \u041f\u0430\u043d\u0430 \u0456 \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u042f\u043c\u0443 \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"547","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u043c \u0441\u0432\u0435\u0446\u0435 &laquo;Gaudium et spes&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 37-38)<\/span><br \/><span style=\"color: #ff0000;\">\u0423\u0441\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b \u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u0439<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0437 \u044f\u043a\u0456\u043c \u0437\u0433\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0434\u043e\u0441\u0432\u0435\u0434 \u0432\u044f\u043a\u043e\u045e, \u0432\u0443\u0447\u044b\u0446\u044c \u043b\u044e\u0434\u0441\u043a\u0443\u044e \u0441\u044f\u043c&rsquo;\u044e, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u043f\u0440\u0430\u0433\u0440\u044d\u0441, \u044f\u043a\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0434\u0430\u0431\u0440\u043e\u043c \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0443 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0437\u0432\u044f\u0437\u0430\u043d\u044b \u0437 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435\u043c, \u0431\u043e, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u043d\u0430 \u0456\u0435\u0440\u0430\u0440\u0445\u0456\u044f \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044f\u045e, \u0430 \u0434\u0430\u0431\u0440\u043e \u0437\u043c\u044f\u0448\u0430\u043d\u0430\u0435 \u0441\u0430 \u0437\u043b\u043e\u043c, \u0430\u0441\u043e\u0431\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0456 \u0456\u0445 \u0433\u0440\u0443\u043f\u044b \u0434\u0431\u0430\u044e\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u045e\u043b\u0430\u0441\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u0430 \u043d\u0435 \u043f\u0440\u0430 \u0456\u043d\u0448\u044b\u0445. \u0423 \u0432\u044b\u043d\u0456\u043a\u0443 \u0441\u0432\u0435\u0442 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0435 \u0431\u044b\u0446\u044c \u043c\u0435\u0441\u0446\u0430\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u0442\u0432\u0430, \u0443 \u0442\u043e\u0439 \u0447\u0430\u0441 \u044f\u043a \u043f\u0430\u0432\u0435\u043b\u0456\u0447\u044d\u043d\u043d\u0435 \u043b\u044e\u0434\u0441\u043a\u043e\u0433\u0430 \u043f\u0430\u0442\u044d\u043d\u0446\u044b\u044f\u043b\u0443 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0435 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435\u043c \u0441\u0430\u043c\u043e\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u043c\u0443 \u0440\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u0437\u0430\u0434\u0430\u0435 \u043f\u044b\u0442\u0430\u043d\u043d\u0435, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043c\u043e\u0436\u043d\u0430 \u0430\u0434\u043e\u043b\u0435\u0446\u044c \u0433\u044d\u0442\u0430\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435, \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u045e\u0441\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u0456, \u044f\u043a\u0456\u043c \u0448\u0442\u043e\u0434\u043d\u044f \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0435 \u043f\u044b\u0445\u0430 \u0456 \u0431\u044f\u0437\u043b\u0430\u0434\u043d\u044b \u044d\u0433\u0430\u0456\u0437\u043c, \u0442\u0440\u044d\u0431\u0430 \u0430\u0447\u044b\u0448\u0447\u0430\u0446\u044c \u0456 \u0434\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u043a\u0440\u044b\u0436 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u042f\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435. \u0427\u0430\u043b\u0430\u0432\u0435\u043a, \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0456 \u045e\u0447\u044b\u043d\u0435\u043d\u044b \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u044e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043d\u043e\u0432\u044b\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c, \u043c\u043e\u0436\u0430 \u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0430\u043c\u0456 \u0440\u044d\u0447\u044b, \u0431\u043e \u044f\u043d\u044b \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c. \u0401\u043d \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0456\u0445 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u0431\u0430\u0447\u044b\u0446\u044c, \u044f\u043a \u044f\u043d\u044b \u0432\u044b\u043f\u043b\u044b\u0432\u0430\u044e\u0446\u044c \u0437 \u0440\u0443\u043a\u0456 \u0411\u043e\u0436\u0430\u0439, \u0456 \u0442\u0430\u043c\u0443 \u0448\u0430\u043d\u0443\u0435 \u0456\u0445. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0437\u0430 \u0456\u0445 \u0414\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u0446\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0436\u044b\u0432\u0430\u044e\u0447\u044b \u0456 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0456\u0445 \u0443 \u0434\u0443\u0445\u0443 \u045e\u0431\u043e\u0441\u0442\u0432\u0430 \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u044b, \u0451\u043d \u0434\u0430\u0441\u044f\u0433\u0430\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u043d\u0430\u0434 \u0441\u0432\u0435\u0442\u0430\u043c, \u043d\u0456\u0431\u044b \u043d\u0435 \u043c\u0430\u044e\u0447\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u0456 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u043c\u0430\u044e\u0447\u044b \u045e\u0441\u0451. &laquo;\u0423\u0441\u0451 \u0432\u0430\u0448\u0430\u0435, \u0432\u044b \u0436 &mdash; \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &mdash; \u0411\u043e\u0433\u0430&raquo; (1 \u041a\u0430\u0440 3, 22-23).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u045e\u0441\u0451, \u0441\u0430\u043c\u043e \u0441\u0442\u0430\u043b\u0430 \u0446\u0435\u043b\u0430\u043c \u0456, \u0436\u044b\u0432\u0443\u0447\u044b \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043b\u044e\u0434\u0437\u0435\u0439, \u0443\u0432\u0430\u0439\u0448\u043b\u043e \u045e \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u044e \u0441\u0432\u0435\u0442\u0443 \u044f\u043a \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u043b\u0430 \u044f\u0435 \u045e \u0441\u0430\u0431\u0435 \u0456 \u043f\u0430\u0434\u0441\u0443\u043c\u0430\u0432\u0430\u043b\u0430. \u042f\u043d\u043e \u0430\u0431&rsquo;\u044f\u045e\u043b\u044f\u0435 \u043d\u0430\u043c, \u0448\u0442\u043e &laquo;\u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u043b\u044e\u0431\u043e\u045e&raquo; (1 \u042f\u043d 4, 8), \u0456 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0432\u0443\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0430\u0441\u043d\u043e\u045e\u043d\u044b\u043c \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456, \u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0456 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u043e\u0432\u0430\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u043b\u044e\u0431\u043e\u0432\u0456. \u0410 \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0437\u0430\u043f\u044d\u045e\u043d\u0456\u0432\u0430\u0435, \u0448\u0442\u043e \u0448\u043b\u044f\u0445 \u043b\u044e\u0431\u043e\u0432\u0456 \u0430\u0434\u043a\u0440\u044b\u0442\u044b \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0448\u0442\u043e \u0441\u043f\u0440\u043e\u0431\u0430 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0435 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u0442\u0432\u0430 \u043d\u0435 \u0434\u0430\u0440\u044d\u043c\u043d\u0430\u044f. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u043d\u0430\u0432\u0443\u0447\u0430\u0435, \u043a\u0430\u0431 \u043c\u044b \u0448\u0443\u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445, \u0430\u043b\u0435 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0456 \u045e \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u0445 \u0436\u044b\u0446\u0446\u0451\u0432\u044b\u0445 \u0430\u0431\u0441\u0442\u0430\u0432\u0456\u043d\u0430\u0445. \u0426\u0435\u0440\u043f\u044f\u0447\u044b \u0437\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441, \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e, \u0441\u043c\u0435\u0440\u0446\u044c, \u0401\u043d \u0441\u0432\u0430\u0456\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0432\u0443\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435\u0441\u0446\u0456 \u043a\u0440\u044b\u0436, \u044f\u043a\u0456 \u0446\u0435\u043b\u0430 \u0456 \u0441\u0432\u0435\u0442 \u0443\u0441\u043a\u043b\u0430\u0434\u0430\u044e\u0446\u044c \u043d\u0430 \u043f\u043b\u0435\u0447\u044b \u0442\u044b\u0445, \u0445\u0442\u043e \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0441\u0442\u0430\u045e \u041f\u0430\u043d\u0430\u043c, \u044f\u043a\u043e\u043c\u0443 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u045e\u0441\u044f\u043a\u0430\u044f \u045e\u043b\u0430\u0434\u0430 \u043d\u0430 \u043d\u0435\u0431\u0435 \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0401\u043d \u0443\u0436\u043e \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445 \u043c\u043e\u0446\u0430\u0439 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0431\u0443\u0434\u0436\u0430\u044e\u0447\u044b \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0435 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0432\u0435\u043a\u0443, \u0430\u043b\u0435 \u0433\u044d\u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u0430\u0436\u044b\u045e\u043b\u044f\u044e\u0447\u044b, \u0430\u0447\u044b\u0448\u0447\u0430\u044e\u0447\u044b \u0456 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0442\u044b\u044f \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b\u044f \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0456, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u0456\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u0441\u044f\u043c&rsquo;\u044f \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0431\u043e\u043b\u044c\u0448 \u0433\u0443\u043c\u0430\u043d\u043d\u044b\u043c \u0456 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u0430\u0439 \u043c\u044d\u0446\u0435 \u045e\u0441\u044e \u0437\u044f\u043c\u043b\u044e. \u0414\u0430\u0440\u044b \u0414\u0443\u0445\u0430 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u044f: \u0430\u0434\u043d\u044b\u0445 \u0401\u043d \u043a\u043b\u0456\u0447\u0430 \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0435 \u043d\u0435\u0431\u0430 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u0436\u044b\u0432\u044b\u043c \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0441\u044f\u043c&rsquo;\u0456, \u0456\u043d\u0448\u044b\u0445 &mdash; \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0437\u044f\u043c\u043d\u043e\u043c\u0443 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044e \u043b\u044e\u0434\u0437\u044f\u043c \u0456 \u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435\u043c \u0433\u043b\u0435\u0431\u0443 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0410\u0434\u043d\u0430\u043a \u0401\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435 \u045e\u0441\u0456\u0445, \u043a\u0430\u0431, \u0430\u0434\u043c\u043e\u0432\u0456\u045e\u0448\u044b\u0441\u044f \u0430\u0434 \u044d\u0433\u0430\u0456\u0437\u043c\u0443 \u0456 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u045e\u0448\u044b \u045e\u0441\u0435 \u0441\u0432\u0430\u0435 \u0437\u044f\u043c\u043d\u044b\u044f \u0441\u0456\u043b\u044b \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043b\u044e\u0434\u0437\u0456 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u043b\u0456 \u0441\u0430\u043c\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u0441\u0442\u0430\u043d\u0435 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0439 \u0411\u043e\u0433\u0443 \u0430\u0445\u0432\u044f\u0440\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 5, 15; \u0420\u044b\u043c 4, 25<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0456\u0445, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u0432\u0435, \u0443\u0436\u043e \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0441\u044f\u0431\u0435 \u0436\u044b\u043b\u0456, \u0430 \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u0456\u0445 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u044b\u045e \u0432\u044b\u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0448\u0430\u043d\u044b \u0434\u0437\u0435\u043b\u044f \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u0432\u0435, \u0443\u0436\u043e \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0441\u044f\u0431\u0435 \u0436\u044b\u043b\u0456, \u0430 \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u0456\u0445 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441.<\/p>\r\n"}, {"GCH_CH_2_ID":"551","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435&raquo; \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 14, 1-2: PG 26, 1419-1420)<\/span><br \/><span style=\"color: #ff0000;\">\u0410\u0434\u0437\u043d\u0430\u0447\u044b\u043c \u043d\u0430\u0431\u043b\u0456\u0436\u044d\u043d\u043d\u0435 \u0441\u0432\u044f\u0442\u0430 \u041f\u0430\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0430\u043b\u0435 \u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043b\u0456\u0437\u043a\u0430\u0435 \u0434\u0430 \u043d\u0430\u0441 \u0442\u043e\u0435 \u0421\u043b\u043e\u0432\u0430 &ndash; \u043d\u0430\u0448 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e \u0443\u0441\u0456\u043c \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441 \u0456 \u0430\u0431\u044f\u0446\u0430\u0435 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0446\u0446\u0430 \u0437 \u043d\u0430\u043c\u0456. \u0422\u0430\u043c\u0443 \u0401\u043d \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0435: &laquo;\u0412\u043e\u0441\u044c \u042f \u0437 \u0432\u0430\u043c\u0456 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0430\u0436 \u0434\u0430 \u0441\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u044f \u0432\u0435\u043a\u0443&raquo; (\u041c\u0446 28, 20). \u0401\u043d \u0441\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u0441\u0442\u044b\u0440 \u0456 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0421\u0432\u044f\u0442\u0430\u0440, \u0434\u0430\u0440\u043e\u0433\u0430 \u0456 \u0431\u0440\u0430\u043c\u0430, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0441\u0442\u0430\u045e\u0448\u044b \u045e\u0441\u0456\u043c \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441, \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043d\u0430\u043c \u044f\u043a \u0441\u0432\u044f\u0442\u0430 \u0456 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c, \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u0410\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u041f\u0430\u0441\u0445\u0430 \u043d\u0430\u0448\u0430\u044f, \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b \u0437\u0430 \u043d\u0430\u0441&raquo; (1 \u041a\u0430\u0440 5, 7). \u0426\u044f\u043f\u0435\u0440 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u044b \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442\u0430: &laquo;\u0420\u0430\u0434\u0430\u0441\u0446\u044c \u043c\u0430\u044f, \u0443\u0440\u0430\u0442\u0443\u0439 \u043c\u044f\u043d\u0435 \u0430\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u043c\u044f\u043d\u0435 \u0430\u043a\u0440\u0443\u0436\u044b\u045e&raquo; (\u043f\u0430\u0440. \u041f\u0441 32 [31], 7). \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u044b\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u045e\u0441\u044f\u043a\u0430\u0435 \u0437\u043b\u043e. \u041a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u043c\u043e\u0433 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0442\u0430\u043a\u043e\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0451\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043c\u0435\u0446\u044c \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u044f \u0437\u0432\u044b\u0447\u0430\u0456 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u0443 \u0441\u043f\u0430\u043a\u043e\u0456 \u0430\u0431 \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0436\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0456 \u0441\u0432\u044f\u0442\u044b\u044f \u043f\u0430\u0434\u0447\u0430\u0441 \u0443\u0441\u044f\u0433\u043e \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f \u0446\u0435\u0448\u044b\u043b\u0456\u0441\u044f, \u044f\u043a \u043d\u0430 \u0441\u0432\u044f\u0446\u0435. \u0410\u0434\u0437\u0456\u043d \u0437 \u0456\u0445, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0414\u0430\u0432\u0456\u0434, \u043f\u0430\u0434\u044b\u043c\u0430\u045e\u0441\u044f \u045e\u043d\u0430\u0447\u044b \u043d\u0435 \u0440\u0430\u0437, \u0430 \u0441\u0435\u043c \u0440\u0430\u0437\u043e\u045e, \u043a\u0430\u0431 \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u044f\u0446\u044c \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c\u0456 \u0411\u043e\u0433\u0430. \u0414\u0440\u0443\u0433\u0456, \u0432\u044f\u043b\u0456\u043a\u0456 \u041c\u0430\u0439\u0441\u0435\u0439, \u0446\u0435\u0448\u044b\u045e\u0441\u044f, \u0441\u043f\u044f\u0432\u0430\u044e\u0447\u044b \u0433\u0456\u043c\u043d\u044b \u0456 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u044b\u044f \u043f\u0435\u0441\u043d\u0456 \u0430\u0431 \u043f\u0435\u0440\u0430\u043c\u043e\u0437\u0435 \u043d\u0430\u0434 \u0444\u0430\u0440\u0430\u043e\u043d\u0430\u043c \u0456 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456, \u0445\u0442\u043e \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u045e \u0433\u0430\u0431\u0440\u044d\u044f\u045e. \u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0456\u043d\u0448\u044b\u044f \u0437 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u0441\u0432\u044f\u0442\u044b \u043a\u0443\u043b\u044c\u0442. \u0412\u044f\u043b\u0456\u043a\u0456 \u0421\u0430\u043c\u0443\u044d\u043b\u044c \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0406\u043b\u043b\u044f, \u044f\u043a\u0456\u044f \u0437\u0430 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u0443, \u0446\u044f\u043f\u0435\u0440 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u0443 \u043d\u0435\u0431\u0435 \u0441\u0432\u044f\u0442\u0430, \u0440\u0430\u0434\u0443\u044e\u0447\u044b\u0441\u044f \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u045e\u043d\u044f\u0439 \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0446\u044b \u045e \u0446\u0435\u043d\u0456, \u0456 \u045e\u0436\u043e \u043c\u043e\u0433\u0443\u0446\u044c \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0443 \u0430\u0434 \u0432\u043e\u0431\u0440\u0430\u0437\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043d\u0430 \u044f\u043a\u0456\u044f \u0448\u043b\u044f\u0445\u0456 \u0441\u0442\u0430\u043d\u0435\u043c \u043c\u044b, \u044f\u043a\u0456\u044f \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u043c \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c? \u041a\u0430\u0433\u043e \u043c\u044b \u0432\u043e\u0437\u044c\u043c\u0435\u043c \u0441\u0430\u0431\u0435 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c, \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u044e\u0447\u044b\u0441\u044f \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u0430? \u041d\u0430\u043f\u044d\u045e\u043d\u0430, \u043c\u0430\u0435 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0432\u044b \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u043c\u043d\u043e\u044e \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0435 \u043d\u0430\u0448\u044b\u043c \u041f\u0430\u043d\u0430\u043c, \u0415\u0437\u0443\u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430: &laquo;\u042f &ndash; \u0434\u0430\u0440\u043e\u0433\u0430&raquo; (\u042f\u043d 14, 6). \u0401\u043d \u0442\u043e\u0439, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u0441\u0432. \u042f\u043d \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044c \u043a\u0430\u0436\u0430: &laquo;\u0411\u044f\u0440\u044d \u043d\u0430 \u0441\u044f\u0431\u0435 \u0433\u0440\u044d\u0445 \u0441\u0432\u0435\u0442\u0443&raquo; (\u042f\u043d 1, 29). \u0401\u043d \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b, \u044f\u043a \u043a\u0430\u0436\u0430 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043f\u0440\u0430\u0440\u043e\u043a \u0415\u0440\u0430\u043c\u0456\u044f: &laquo;\u0421\u0442\u043e\u0439\u0446\u0435 \u043d\u0430 \u0434\u0430\u0440\u043e\u0433\u0430\u0445 \u0456 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435; \u0441\u043f\u044b\u0442\u0430\u0439\u0446\u0435\u0441\u044f, \u044f\u043a\u0430\u044f \u0434\u0430\u0440\u043e\u0433\u0430 \u0434\u043e\u0431\u0440\u0430\u044f, \u0456 \u043d\u0430 \u0451\u0439 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u0432\u044b\u043f\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0434\u0443\u0448 \u0432\u0430\u0448\u044b\u0445&raquo; (\u043f\u0430\u0440. \u0415\u0440 6, 16).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u043a\u0440\u043e\u045e \u043a\u0430\u0437\u043b\u043e\u045e \u0456 \u043f\u043e\u043f\u0435\u043b \u0446\u044f\u043b\u044f\u0446\u0456, \u0440\u0430\u0441\u0441\u044b\u043f\u0430\u043d\u044b \u043d\u0430\u0434 \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c\u0456, \u043c\u0430\u0433\u043b\u0456 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u0446\u0435\u043b\u0430. \u0410 \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u0430\u0437 \u0448\u0447\u043e\u0434\u0440\u0443\u044e \u043b\u0430\u0441\u043a\u0443 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u043b\u043e\u0432\u0430 \u043c\u043e\u0436\u0430 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u0446\u0430 \u043a\u043e\u0436\u043d\u044b. \u041a\u0430\u043b\u0456 \u043c\u044b \u0440\u0430\u0437\u0430\u043c \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0437\u0430 I\u043c, \u0442\u043e \u043d\u0430\u043c \u0443\u0436\u043e \u0442\u0443\u0442 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0435\u043d\u0430 \u0430\u0434\u0447\u0443\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u0431\u0440\u0430\u043c\u0430\u0445 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430. \u0421\u0432\u044f\u0442\u044b\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b, \u044f\u043a\u0456\u044f \u0456\u0448\u043b\u0456 \u0437\u0430 \u0417\u0431\u0430\u045e\u0446\u0430\u043c \u044f\u043a \u0437\u0430 \u041f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c, \u0431\u044b\u043b\u0456 \u0456 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0437\u0430\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u0433\u044d\u0442\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u0431\u043e \u044f\u043d\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0412\u043e\u0441\u044c \u043c\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u045e\u0441\u0451 \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430 \u0422\u0430\u0431\u043e\u044e&raquo; (\u041c\u0446 19, 27). \u0414\u044b\u043a \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0456 \u043c\u044b \u0437\u0430 \u041f\u0430\u043d\u0430\u043c \u0456 \u0430\u0434\u0437\u043d\u0430\u0447\u044b\u043c \u0441\u0432\u044f\u0442\u0430 \u041f\u0430\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0430\u043b\u0435 \u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0431\u0440 6, 20; \u042f\u043d 1, 29<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0437\u0430 \u043d\u0430\u0441 \u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445 \u0415\u0437\u0443\u0441, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b \u0411\u0430\u0440\u0430\u043d\u0430\u043a, <span style=\"color: #ff0000;\">*<\/span> \u043d\u0430\u0432\u0435\u043a\u0456 \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0441\u044c \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0431\u044f\u0440\u044d \u043d\u0430 \u0441\u044f\u0431\u0435 \u0433\u0440\u044d\u0445 \u0441\u0432\u0435\u0442\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0432\u0435\u043a\u0456 \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u043d\u0430 \u045e\u0437\u043e\u0440 \u041c\u044d\u043b\u044c\u0445\u0456\u0437\u044d\u0434\u044d\u043a\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"552","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u042f\u043d\u0430 \u0424\u0456\u0448\u0430\u0440\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps. 129: Opera omnia, edit. 1579, p. 1610)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0430\u043b\u0456 \u0431 \u0445\u0442\u043e \u0437\u0433\u0440\u0430\u0448\u044b\u045e, \u0442\u043e \u043c\u0430\u0435 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430 \u043f\u0435\u0440\u0430\u0434 \u0410\u0439\u0446\u043e\u043c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u043d\u0430\u0448 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440, \u0430 \u042f\u0433\u043e \u043d\u0430\u0439\u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u0430\u0435 \u0446\u0435\u043b\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043d\u0430\u0448\u0430 \u0430\u0445\u0432\u044f\u0440\u0430, \u044f\u043a\u0443\u044e \u0401\u043d \u043f\u0440\u044b\u043d\u0451\u0441 \u043d\u0430 \u0430\u043b\u0442\u0430\u0440\u044b \u043a\u0440\u044b\u0436\u0430 \u0437\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0440\u043e\u045e, \u043f\u0440\u0430\u043b\u0456\u0442\u0430\u044f \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f, \u043d\u0435 \u0431\u044b\u043b\u0430 \u043a\u0440\u043e\u045e\u044e \u0446\u044f\u043b\u044f\u0442 \u0446\u0456 \u043a\u0430\u0437\u043b\u043e\u045e (\u044f\u043a \u0443 \u0441\u0442\u0430\u0440\u044b\u043c \u0417\u0430\u043a\u043e\u043d\u0435), \u0430\u043b\u0435 \u0441\u0430\u043c\u0430\u0433\u0430 \u043d\u044f\u0432\u0456\u043d\u043d\u0430\u0433\u0430 \u0411\u0430\u0440\u0430\u043d\u043a\u0430 &ndash; \u0425\u0440\u044b\u0441\u0442\u0430 \u0415\u0437\u0443\u0441\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u044b\u043d\u044f, \u0443 \u044f\u043a\u043e\u0439 \u043d\u0430\u0448 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0421\u0432\u044f\u0442\u0430\u0440 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u045e \u0430\u0445\u0432\u044f\u0440\u0443, \u043d\u0435 \u0431\u044b\u043b\u0430 \u0440\u0443\u043a\u0430\u0442\u0432\u043e\u0440\u043d\u0430\u0439, \u0430\u043b\u0435 \u045e\u0437\u0432\u044f\u043b\u0430 \u044f\u0435 \u0411\u043e\u0436\u0430\u044f \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u0430\u043b\u0456\u045e \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c \u0441\u0432\u0435\u0442\u0430\u043c, \u044f\u043a\u0456 \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439, \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u0430\u0439 \u0440\u0443\u043a\u043e\u0439 \u0411\u043e\u0436\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u043c\u0430\u0435 \u0434\u0437\u0432\u0435 \u0447\u0430\u0441\u0442\u043a\u0456: \u043f\u0435\u0440\u0448\u0430\u044f &ndash; \u0433\u044d\u0442\u0430 \u0437\u044f\u043c\u043b\u044f, \u044f\u043a\u0443\u044e \u043c\u044b \u043d\u0430\u0441\u044f\u043b\u044f\u0435\u043c; \u0434\u0440\u0443\u0433\u0430\u044f \u044f\u0448\u0447\u044d \u043d\u0435\u0432\u044f\u0434\u043e\u043c\u0430\u044f \u043d\u0430\u043c, \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0448\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043d\u0451\u0441 \u0442\u0443\u0442, \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u043d\u044f\u045e \u0441\u0430\u043c\u0443\u044e \u0436\u043e\u0440\u0441\u0442\u043a\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c. \u0414\u0440\u0443\u0433\u0443\u044e \u0436 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456, \u0430\u043f\u0440\u0430\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u045e \u043d\u043e\u0432\u044b\u044f \u0448\u0430\u0442\u044b \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456, \u043f\u0440\u0430\u0437 \u0443\u043b\u0430\u0441\u043d\u0443\u044e \u043a\u0440\u043e\u045e \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443 \u043d\u0435\u0431\u0430. \u0422\u0430\u043c \u0401\u043d \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u044e \u043d\u0430\u0439\u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u0443\u044e \u043a\u0440\u043e\u045e, \u044f\u043a\u0443\u044e \u0441\u0435\u043c \u0440\u0430\u0437\u043e\u045e \u043f\u0440\u0430\u043b\u0456\u045e \u0437\u0430 \u045e\u0441\u0456\u0445 \u0433\u0440\u044d\u0448\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u0456\u043b\u0430\u044f \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u044f \u0411\u043e\u0433\u0443 \u0430\u0445\u0432\u044f\u0440\u0430, \u0448\u0442\u043e \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u044f\u0435, \u043d\u0435 \u0437\u043c\u043e\u0433 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430 \u0456\u043d\u0448\u0430\u0433\u0430, \u044f\u043a, \u0430\u0434\u0440\u0430\u0437\u0443 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e\u0448\u044b \u043d\u0430\u0441, \u0443\u0434\u0437\u044f\u043b\u0456\u0446\u044c \u0443\u0441\u0456\u043c, \u0445\u0442\u043e \u043a\u0430\u0435\u0446\u0446\u0430, \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0435 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0432\u0435\u0447\u043d\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430. \u042f\u043d\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u0442\u043e\u0433\u043e\u0434 (\u044f\u043a \u0440\u0430\u0431\u0456\u043b\u0430\u0441\u044f \u045e \u044e\u0434\u044d\u044f\u045e), \u0430\u043b\u0435 \u0456 \u0448\u0442\u043e\u0434\u043d\u044f \u0434\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f, \u0430 \u043d\u0430\u0432\u0430\u0442 \u0443 \u043a\u043e\u0436\u043d\u0443\u044e \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u0456 \u043c\u043e\u043c\u0430\u043d\u0442, \u043a\u0430\u0431 \u043c\u044b \u043c\u0435\u043b\u0456 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435. \u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043f\u0456\u0448\u0430, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &laquo;\u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445, \u0437\u0434\u0430\u0431\u044b\u045e\u0448\u044b \u0432\u0435\u0447\u043d\u0430\u0435 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435&raquo; (\u0413\u0431\u0440 9, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0433\u044d\u0442\u0430\u0439 \u0441\u0432\u044f\u0442\u043e\u0439 \u0456 \u0432\u0435\u0447\u043d\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u045e\u0441\u0435, \u0445\u0442\u043e \u0437 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0441\u043a\u0440\u0443\u0445\u0430\u0439 \u043a\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0456\u0445 \u0433\u0440\u0430\u0445\u0430\u0445, \u0446\u0432\u0451\u0440\u0434\u0430 \u0456 \u0440\u0430\u0448\u0443\u0447\u0430 \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e\u0448\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0432\u044f\u0440\u0442\u0430\u0446\u0446\u0430 \u0434\u0430 \u0440\u0430\u043d\u0435\u0439\u0448\u044b\u0445 \u0437\u0430\u0433\u0430\u043d\u0430\u045e, \u0430\u043b\u0435 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0446\u0446\u0430 \u045e \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u044b\u0445 \u0437\u0432\u044b\u0447\u0430\u044f\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432. \u042f\u043d \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0433\u044d\u0442\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: &laquo;\u0414\u0437\u0435\u0446\u0456 \u043c\u0430\u0435, \u0433\u044d\u0442\u0430 \u043f\u0456\u0448\u0443 \u0432\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u043b\u0456. \u041a\u0430\u043b\u0456 \u0436 \u0445\u0442\u043e \u0437\u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u0442\u043e \u043c\u044b \u043c\u0430\u0435\u043c \u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430 \u043f\u0435\u0440\u0430\u0434 \u0410\u0439\u0446\u043e\u043c, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430. \u0401\u043d \u0451\u0441\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456, \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430 \u043d\u0430\u0448\u044b\u044f, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443&raquo; (1 \u042f\u043d 2, 1-2).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 5, 10. 8b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0443\u0447\u044b \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456, \u043c\u044b \u043f\u0430\u044f\u0434\u043d\u0430\u043b\u0456\u0441\u044f \u0437 \u0411\u043e\u0433\u0430\u043c \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c \u042f\u0433\u043e \u0421\u044b\u043d\u0430.<span style=\"color: #ff0000;\"> *<\/span> \u0410 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u043c\u044b \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0437\u0431\u0430\u0432\u0456\u043c\u0441\u044f \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0436\u044b\u0446\u0446\u0451. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u043c\u044b \u0431\u044b\u043b\u0456 \u044f\u0448\u0447\u044d \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u043c\u0456, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u043d\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u043c\u044b \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0437\u0431\u0430\u0432\u0456\u043c\u0441\u044f \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n"}, {"GCH_CH_2_ID":"553","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 8 de passione Domini, 6-8: PL 54, 340-342)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0440\u044b\u0436 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b &ndash; \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u045e\u0441\u0456\u0445 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u045e \u0456 \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u045e\u0441\u0456\u0445 \u043b\u0430\u0441\u043a\u0430\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c, \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b \u0414\u0443\u0445\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u044b, \u043f\u0440\u044b\u043c\u0435 \u0447\u044b\u0441\u0442\u044b\u043c \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u043b\u0430\u0432\u0443 \u041a\u0440\u044b\u0436\u0430, \u044f\u043a\u0430\u044f \u0437\u0437\u044f\u0435 \u043d\u0430 \u043d\u0435\u0431\u0435 \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0423\u043d\u0443\u0442\u0440\u0430\u043d\u044b\u043c \u0437\u0440\u043e\u043a\u0430\u043c \u043d\u044f\u0445\u0430\u0439 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u041f\u0430\u043d \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u043d\u0430\u043f\u044f\u0440\u044d\u0434\u0430\u0434\u043d\u0456 \u0441\u0432\u0430\u0451\u0439 \u043c\u0443\u043a\u0456: &laquo;\u041d\u0430\u0441\u0442\u0430\u043b\u0430 \u0433\u0430\u0434\u0437\u0456\u043d\u0430, \u043a\u0430\u0431 \u0431\u044b\u045e \u0443\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b&raquo; (\u042f\u043d 12, 23). \u0406 \u0434\u0430\u043b\u0435\u0439: &laquo;\u0426\u044f\u043f\u0435\u0440 \u0443\u0441\u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043d\u0430 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f; \u0456 \u0448\u0442\u043e \u041c\u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u0446\u044c? \u041e\u0439\u0447\u0430, \u0437\u0430\u0445\u0430\u0432\u0430\u0439 \u041c\u044f\u043d\u0435 \u0430\u0434 \u0433\u044d\u0442\u0430\u0439 \u0433\u0430\u0434\u0437\u0456\u043d\u044b. \u0410\u043b\u0435 \u0436 \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0439 \u0433\u0430\u0434\u0437\u0456\u043d\u044b \u042f \u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e. \u041e\u0439\u0447\u0430, \u0443\u0441\u043b\u0430\u045e \u0456\u043c\u044f \u0441\u0432\u0430\u0451!&raquo; \u0406 \u043f\u0430\u0447\u0443\u045e\u0441\u044f \u0437 \u043d\u0435\u0431\u0430 \u0433\u043e\u043b\u0430\u0441: &laquo;\u0423\u0441\u043b\u0430\u0432\u0456\u045e \u0456 \u045e\u0441\u043b\u0430\u045e\u043b\u044e \u0437\u043d\u043e\u045e&rdquo;&raquo; (\u042f\u043d 12, 27-28). \u0410 \u0415\u0437\u0443\u0441 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0435 \u0434\u0437\u0435\u043b\u044f \u041c\u044f\u043d\u0435 \u0431\u044b\u045e \u0433\u044d\u0442\u044b \u0433\u043e\u043b\u0430\u0441, \u0430\u043b\u0435 \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441. \u0426\u044f\u043f\u0435\u0440 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0443\u0434 \u043d\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0442\u0430\u043c; \u0446\u044f\u043f\u0435\u0440 \u043a\u043d\u044f\u0437\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u043a\u0456\u043d\u0443\u0442\u044b \u0432\u043e\u043d. \u0406 \u042f, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u045e\u0437\u043d\u044f\u0442\u044b \u043d\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u044e, \u0443\u0441\u0456\u0445 \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443 \u0434\u0430 \u0441\u044f\u0431\u0435&raquo; (\u042f\u043d 12, 30-32).<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u043c\u043e\u0446 \u043a\u0440\u044b\u0436\u0430! \u041e \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u044f \u0441\u043b\u0430\u0432\u0430 \u043c\u0443\u043a\u0456, \u0443 \u044f\u043a\u043e\u0439 \u0451\u0441\u0446\u044c \u0456 \u0442\u0440\u044b\u0431\u0443\u043d\u0430\u043b \u041f\u0430\u043d\u0430, \u0456 \u0441\u0443\u0434 \u043d\u0430\u0434 \u0441\u0432\u0435\u0442\u0430\u043c, \u0456 \u043c\u043e\u0446 \u0423\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430!<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0422\u044b \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443\u045e \u0443\u0441\u0451 \u0434\u0430 \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u0442\u043e\u0435, \u0448\u0442\u043e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0430\u0434\u0431\u044b\u0432\u0430\u043b\u0430\u0441\u044f \u045e \u044e\u0434\u044d\u0439\u0441\u043a\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0443\u0442\u043e\u0435\u043d\u0430\u0435 \u045e \u0437\u043d\u0430\u043a\u0430\u0445, \u0446\u044f\u043f\u0435\u0440 \u0437\u043c\u0430\u0433\u043b\u0430 \u045e\u0448\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0443 \u043f\u043e\u045e\u043d\u0430\u0439 \u0456 \u0430\u0434\u043a\u0440\u044b\u0442\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f \u045e \u043d\u0430\u0441 \u0451\u0441\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0441\u043b\u0430\u045e\u043d\u044b \u0441\u0442\u0430\u043d \u043b\u0435\u0432\u0456\u0442\u0430\u045e, \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e, \u0431\u043e\u043b\u044c\u0448 \u0441\u0432\u044f\u0442\u043e\u0435 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043a\u0440\u044b\u0436 \u0422\u0432\u043e\u0439 &ndash; \u0433\u044d\u0442\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u045e\u0441\u0456\u0445 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u045e \u0456 \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u045e\u0441\u0456\u0445 \u043b\u0430\u0441\u043a\u0430\u045e. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043c\u0443 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u043c \u0434\u0430\u0435\u0446\u0446\u0430 \u043c\u043e\u0446 \u0443 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456, \u0441\u043b\u0430\u0432\u0430 &ndash; \u0443 \u0433\u0430\u043d\u044c\u0431\u0435, \u0436\u044b\u0446\u0446\u0451 &ndash; \u0443 \u0441\u043c\u0435\u0440\u0446\u0456. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430, \u043a\u0430\u043b\u0456 \u0441\u043f\u044b\u043d\u0456\u043b\u0430\u0441\u044f \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0441\u0442\u0430\u0440\u044b\u0445 \u0430\u0445\u0432\u044f\u0440\u0430\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f\u045e, \u0443\u0441\u0435 \u0432\u0456\u0434\u044b \u0430\u0445\u0432\u044f\u0440 \u0437\u0430\u043c\u044f\u043d\u044f\u0435 \u0430\u0434\u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430 \u0456 \u043a\u0440\u044b\u0432\u0456, \u0431\u043e \u0422\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b &laquo;\u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0433\u0440\u0430\u0445\u0456 \u0441\u0432\u0435\u0442\u0443&raquo; (\u043f\u0430\u0440. \u042f\u043d 1, 29). \u0422\u044b \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0448 \u0443 \u0441\u0430\u0431\u0435 \u045e\u0441\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u043a\u0430\u0431 \u0430\u0434\u043d\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u045e\u0442\u0432\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0437 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a \u0430\u0434\u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0430 \u0451\u0441\u0446\u044c \u0437\u0430\u043c\u0435\u0441\u0442 \u0443\u0441\u0456\u0445 \u0456\u043d\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0440\u044b\u0437\u043d\u0430\u0435\u043c, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b, \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0413\u043e\u0434\u043d\u0430\u0435 \u0432\u0435\u0440\u044b \u0441\u043b\u043e\u0432\u0430 \u0456 \u0432\u0430\u0440\u0442\u0430\u0435 \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u044f, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0441\u0432\u0435\u0442, \u043a\u0430\u0431 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e&raquo; (1 \u0426\u0456\u043c 1, 15).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u043d\u0430\u0441 \u0432\u0430\u0440\u0442\u0430\u044f \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u0430\u0433\u0430 \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u044f, \u0431\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u0445 \u0446\u0456 \u0437\u0430 \u0441\u0432\u044f\u0442\u044b\u0445, \u0430\u043b\u0435 \u0437\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044b\u0445 \u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430 \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0432\u0430\u0441\u0442\u0440\u044b\u044f \u0441\u043c\u0435\u0440\u0446\u0456, \u044f\u043d\u0430, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0448\u044b\u0441\u044f, \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u0430\u0434 \u043d\u0430\u0441 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u0430\u0433\u043b\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0437\u0430 \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u0443\u0436\u043e \u0434\u0430\u045e\u043d\u043e \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u045e \u043d\u0430\u0448\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456 \u043c\u043e\u0446\u0430\u044e \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u0456, \u043a\u0430\u0436\u0443\u0447\u044b \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u041e\u0441\u0456\u044e: &laquo;\u0421\u043c\u0435\u0440\u0446\u044c, \u044f \u0441\u0442\u0430\u043d\u0443 \u0442\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u044e; \u0431\u0443\u0434\u0443 \u0442\u0432\u0430\u0451\u0439 \u043f\u0430\u0440\u0430\u0437\u0430\u044e, \u0430\u0434\u0445\u043b\u0430\u043d\u044c&raquo;. \u041f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b, \u0401\u043d \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u045e\u0441\u044f \u0437\u0430\u043a\u043e\u043d\u0443 \u0441\u043c\u0435\u0440\u0446\u0456, \u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0430\u044e\u0447\u044b, \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u045e \u044f\u0433\u043e. \u0422\u0430\u043a \u0415\u0437\u0443\u0441 \u043f\u0435\u0440\u0430\u0440\u0432\u0430\u045e \u0430\u0434\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u0456, \u043a\u0430\u0431 \u0437 \u0432\u0435\u0447\u043d\u0430\u0439 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u0446\u044c \u044f\u0435 \u045e \u0447\u0430\u0441\u043e\u0432\u0443\u044e. &laquo;\u0411\u043e \u044f\u043a \u0443 \u0410\u0434\u0430\u043c\u0435 \u045e\u0441\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0446\u044c, \u0442\u0430\u043a \u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u045e\u0441\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b&raquo; (1 \u041a\u0430\u0440 15, 22).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 2, 14-15; \u042f\u043d 8, 28<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0446\u0451\u0440 \u0437\u0430\u043f\u0456\u0441 \u043d\u0430\u0448\u044b\u0445 \u0434\u0430\u045e\u0433\u043e\u045e, \u044f\u043a\u0456 \u0431\u044b\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441, \u0456 \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u045e \u044f\u0433\u043e, \u043f\u0440\u044b\u0431\u0456\u045e\u0448\u044b \u0434\u0430 \u043a\u0440\u044b\u0436\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0420\u0430\u0437\u0437\u0431\u0440\u043e\u0456\u045e \u041f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0456 \u0456 \u0423\u043b\u0430\u0434\u044b, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u043d\u0430\u0434 \u0456\u043c\u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u045e\u0437\u043d\u0456\u043c\u0435\u0446\u0435 \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430, \u0442\u0430\u0434\u044b \u0434\u0430\u0432\u0435\u0434\u0430\u0435\u0446\u0435\u0441\u044f, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u042f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u0437\u0437\u0431\u0440\u043e\u0456\u045e \u041f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0456 \u0456 \u0423\u043b\u0430\u0434\u044b, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u043d\u0430\u0434 \u0456\u043c\u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"554","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps. 85, 1: CCL 39, 1176-1177)<\/span><br \/><span style=\"color: #ff0000;\">\u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441, \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441, \u0456 \u043c\u044b \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0434\u0430 \u042f\u0433\u043e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u043d\u0435 \u043c\u043e\u0433 \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0431\u043e\u043b\u044c\u0448\u044b\u043c \u0434\u0430\u0440\u0430\u043c, \u0447\u044b\u043c \u0441\u0432\u0430\u0451 \u0421\u043b\u043e\u0432\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0435 \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u045e \u0443\u0441\u0451 \u0456 \u044f\u043a\u043e\u0435 \u0437\u0440\u0430\u0431\u0456\u045e \u0413\u0430\u043b\u0430\u0432\u043e\u044e \u043d\u0430\u0434 \u0443\u0441\u0456\u043c, \u0430 \u0456\u0445 \u0441\u0430\u043c\u0456\u0445 \u0434\u0430\u043f\u0430\u0441\u0430\u0432\u0430\u045e \u0434\u0430 \u044f\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u0447\u0430\u0441\u0442\u043a\u0456 \u0446\u0435\u043b\u0430. \u0422\u0430\u043a \u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430 \u0421\u044b\u043d\u0430\u043c \u0411\u043e\u0436\u044b\u043c \u0456 \u0421\u044b\u043d\u0430\u043c \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c, \u0430\u0434\u043d\u044b\u043c \u0411\u043e\u0433\u0430\u043c \u0437 \u0410\u0439\u0446\u043e\u043c, \u0430\u0434\u043d\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456. \u041a\u0430\u043b\u0456 \u043c\u044b \u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445 \u0433\u0430\u0432\u043e\u0440\u044b\u043c \u0437 \u0411\u043e\u0433\u0430\u043c, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0430\u0434\u0434\u0437\u044f\u043b\u044f\u0446\u044c \u0430\u0434 \u042f\u0433\u043e \u0421\u044b\u043d\u0430, \u0430 \u043a\u0430\u043b\u0456 \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0446\u0435\u043b\u0430 \u0421\u044b\u043d\u0430, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0430\u0434\u0434\u0437\u044f\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0413\u0430\u043b\u0430\u0432\u044b, \u043a\u0430\u0431 \u0431\u044b\u045e \u0430\u0434\u0437\u0456\u043d \u0417\u0431\u0430\u045e\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430, \u041f\u0430\u043d \u043d\u0430\u0448 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0421\u044b\u043d \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441, \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441, \u0456 \u043c\u044b \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0434\u0430 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441 \u044f\u043a \u043d\u0430\u0448 \u0421\u0432\u044f\u0442\u0430\u0440; \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441 \u044f\u043a \u043d\u0430\u0448\u0430 \u0413\u0430\u043b\u0430\u0432\u0430, \u0430 \u043c\u044b \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0434\u0430 \u042f\u0433\u043e \u044f\u043a \u0434\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0430\u0447\u0443\u0435\u043c \u0443 \u0406\u043c \u0433\u0430\u043b\u0430\u0441\u044b \u043d\u0430\u0448\u044b \u0456 \u0433\u043e\u043b\u0430\u0441 \u042f\u0433\u043e\u043d\u044b \u045e \u043d\u0430\u0441. \u041a\u0430\u043b\u0456 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u043f\u0440\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u045e \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430\u0445, \u0448\u0442\u043e \u0434\u0430\u0442\u044b\u0447\u044b\u043b\u0430 \u0431 \u043f\u044d\u045e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u044f, \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0442\u043e \u0431\u0435\u0437 \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u044f\u045e \u043f\u0440\u044b\u043f\u0456\u0448\u0430\u043c \u0433\u044d\u0442\u0430 \u042f\u043c\u0443, \u0431\u043e \u0401\u043d \u0431\u0435\u0437 \u0432\u0430\u0433\u0430\u043d\u043d\u044f\u045e \u0437\u043b\u0443\u0447\u044b\u045e\u0441\u044f \u0437 \u043d\u0430\u043c\u0456. \u0413\u044d\u0442\u0430 \u0436 \u042f\u043c\u0443 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0443\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u0431\u043e \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u045e\u0437\u043d\u0456\u043a\u043b\u0430 \u045e\u0441\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u045e\u0433\u043b\u044f\u0434\u0430\u0446\u0446\u0430 \u045e \u042f\u0433\u043e\u043d\u0443\u044e \u0432\u0435\u043b\u0456\u0447 \u0456 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u0447\u0443\u0435\u043c: &laquo;\u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430, \u0456 \u0421\u043b\u043e\u0432\u0430 \u0431\u044b\u043b\u043e \u045e \u0411\u043e\u0433\u0430, \u0456 \u0411\u043e\u0433\u0430\u043c \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430. \u042f\u043d\u043e \u0431\u044b\u043b\u043e \u045e \u0411\u043e\u0433\u0430 \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443. \u0423\u0441\u0451 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u0456 \u0431\u0435\u0437 \u042f\u0433\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0441\u0442\u0430\u043b\u0430\u0441\u044f&raquo; (\u042f\u043d 1, 1-3). \u0423\u0433\u043b\u044f\u0434\u0430\u044e\u0447\u044b\u0441\u044f \u045e \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044c \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u044f\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u0435 \u0441\u0430\u043c\u0430\u0435 \u0432\u044b\u0441\u043e\u043a\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u044f\u043a \u0443 \u0456\u043d\u0448\u044b\u0445 \u0447\u0430\u0441\u0442\u043a\u0430\u0445 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f \u0401\u043d \u0443\u0437\u0434\u044b\u0445\u0430\u0435, \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0456 \u0434\u0437\u044f\u043a\u0443\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0432\u0430\u0433\u0430\u0435\u043c\u0441\u044f \u043f\u0440\u044b\u043f\u0456\u0441\u0430\u0446\u044c \u042f\u043c\u0443 \u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043d\u0430\u0448\u0430 \u0434\u0443\u043c\u043a\u0430 \u043b\u044f\u043d\u0443\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0439\u0441\u0446\u0456 \u0430\u0434 \u043d\u044f\u0434\u0430\u045e\u043d\u044f\u0433\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f \u043d\u0430\u0434 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044e \u0425\u0440\u044b\u0441\u0442\u0430 \u0434\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u044f. \u0411\u044b\u0446\u0446\u0430\u043c \u0433\u044d\u0442\u0430 \u043c\u0430\u0433\u043b\u043e \u043f\u0440\u044b\u0447\u044b\u043d\u0456\u0446\u044c \u042f\u043c\u0443 \u043a\u0440\u044b\u045e\u0434\u0443, \u043a\u0430\u043b\u0456 \u0431 \u043c\u044b \u043f\u0440\u044b\u0437\u043d\u0430\u043b\u0456, \u0448\u0442\u043e \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u043b\u0456 \u043d\u0430\u0448\u044b\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u044f\u043a \u0434\u0430 \u0411\u043e\u0433\u0430. \u0427\u0430\u0441\u0442\u0430 \u043c\u044b \u0432\u0430\u0433\u0430\u0435\u043c\u0441\u044f \u0456 \u0441\u043f\u0440\u0430\u0431\u0443\u0435\u043c \u0437\u043c\u044f\u043d\u0456\u0446\u044c \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0442\u044b\u0445 \u0441\u043b\u043e\u045e. \u0410\u043b\u0435 \u045e \u0421\u0432\u044f\u0442\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0456 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0446\u0430 \u043d\u0456\u0447\u043e\u0433\u0430, \u0448\u0442\u043e \u0431 \u043d\u0435 \u0434\u0430\u0442\u044b\u0447\u044b\u043b\u0430 \u042f\u0433\u043e, \u0456 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435\u043b\u044c\u0433\u0430 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0430\u0431\u0443\u0434\u0437\u0456\u043c\u0441\u044f \u0456 \u043f\u0440\u0430\u0447\u043d\u0435\u043c\u0441\u044f \u045e \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u0440\u044b, \u043a\u0430\u0431 \u043f\u0430\u0431\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0442\u043e\u0439, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u043c\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u0442\u043e \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043b\u0456 \u044f\u043a \u043f\u0440\u0430 \u0411\u043e\u0433\u0430, \u043f\u0440\u044b\u043d\u044f\u045e \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456. \u0421\u0442\u0430\u045e\u0448\u044b \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u0437\u0440\u0430\u0431\u0456\u045e\u0448\u044b\u0441\u044f \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0401\u043d \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 (\u043f\u0430\u0440. \u0424\u043b\u043f 2, 7-8). \u041f\u0440\u044b\u0431\u0456\u0442\u044b \u0434\u0430 \u043a\u0440\u044b\u0436\u0430, \u0401\u043d \u043f\u0440\u044b\u043d\u044f\u045e, \u0431\u044b\u0446\u0446\u0430\u043c \u0441\u0432\u0430\u0435, \u0441\u043b\u043e\u0432\u044b \u043f\u0441\u0430\u043b\u044c\u043c\u0430, \u043a\u0430\u043b\u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u045e: &laquo;\u0411\u043e\u0436\u0430 \u043c\u043e\u0439, \u0411\u043e\u0436\u0430 \u043c\u043e\u0439, \u0447\u0430\u043c\u0443 \u0422\u044b \u041c\u044f\u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e?&raquo; (\u041f\u0441 22 [21], 1).<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043c\u043e\u043b\u044f\u0446\u0446\u0430 \u044f\u043a \u0434\u0430 \u0411\u043e\u0433\u0430, \u0430 \u0441\u0430\u043c \u0401\u043d \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u044f\u043a \u0441\u043b\u0443\u0433\u0430. \u0422\u0430\u043c \u0401\u043d \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c, \u0442\u0443\u0442 &ndash; \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435. \u041f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u043d\u044f\u0437\u043c\u0435\u043d\u043d\u044b\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0437\u043c\u044f\u043d\u0456\u0446\u044c, \u0401\u043d \u0440\u043e\u0431\u0456\u0446\u044c \u043d\u0430\u0441 \u0437 \u0441\u0430\u0431\u043e\u044e \u0430\u0434\u043d\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0413\u0430\u043b\u0430\u0432\u043e\u044e \u0456 \u0446\u0435\u043b\u0430\u043c. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0434\u0430 \u042f\u0433\u043e, \u043f\u0440\u0430\u0437 \u042f\u0433\u043e, \u0443 \u0406\u043c. \u041c\u044b \u0433\u0430\u0432\u043e\u0440\u044b\u043c \u0437 \u0406\u043c, \u0430 \u0401\u043d \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u0435 \u0437 \u043d\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 16, 24. 23<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0432\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u045e \u0456\u043c\u044f \u041c\u0430\u0451. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0440\u0430\u0441\u0456\u0446\u0435 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435, \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u044f \u0431\u044b\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043a\u0430\u0436\u0443 \u0432\u0430\u043c: \u043a\u0430\u043b\u0456 \u0447\u0430\u0433\u043e \u045e \u0456\u043c\u044f \u041c\u0430\u0451 \u043f\u0430\u043f\u0440\u043e\u0441\u0456\u0446\u0435 \u045e \u0410\u0439\u0446\u0430, \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u0441\u0456\u0446\u0435 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435, \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u044f \u0431\u044b\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u0439.<\/p>\r\n"}, {"GCH_CH_2_ID":"555","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0430\u0433\u043c\u0430\u0442\u044b\u0447\u043d\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b &laquo;Lumen Gentium&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(N. 9)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0430\u0441\u0446\u0451\u043b &ndash; \u0433\u044d\u0442\u0430 \u0431\u0430\u0447\u043d\u044b \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0437\u0431\u0430\u045e\u0447\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0412\u043e\u0441\u044c \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0434\u043d\u0456, &mdash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &mdash; \u043a\u0430\u043b\u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0437 \u0434\u043e\u043c\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043d\u043e\u0432\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 &lt;&hellip;&gt; \u0423\u043a\u043b\u0430\u0434\u0443 \u0437\u0430\u043a\u043e\u043d \u041c\u043e\u0439 \u0443 \u043d\u0443\u0442\u0440\u043e \u0456\u0445\u043d\u044f\u0435 \u0456 \u043d\u0430\u043f\u0456\u0448\u0443 \u044f\u0433\u043e \u043d\u0430 \u0456\u0445\u043d\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445, \u0456 \u0431\u0443\u0434\u0443 \u0456\u043c \u0411\u043e\u0433\u0430\u043c, \u0430 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u041c\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c&hellip; \u0411\u043e \u045e\u0441\u0435, \u0430\u0434 \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0430\u0433\u0430 \u0434\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0433\u0430 \u0437 \u0456\u0445, \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u041c\u044f\u043d\u0435&raquo; (\u0415\u0440 31, 31-34). \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0433\u044d\u0442\u044b \u043d\u043e\u0432\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043d\u043e\u0432\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0443 \u0441\u0432\u0430\u0451\u0439 \u041a\u0440\u044b\u0432\u0456 (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 11, 25), \u0441\u0442\u0432\u0430\u0440\u0430\u044e\u0447\u044b \u0437 \u044e\u0434\u044d\u044f\u045e \u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u043d\u043e\u0432\u044b \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0414\u0443\u0445\u0443 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0437\u0440\u0430\u0441\u0446\u0456\u0441\u044f \u045e \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430 \u0456 \u0431\u044b\u0446\u044c \u043d\u043e\u0432\u044b\u043c \u0411\u043e\u0436\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u0411\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u043d\u0435 \u0437 \u0442\u043b\u0435\u043d\u043d\u0430\u0433\u0430 \u043d\u0430\u0441\u0435\u043d\u043d\u044f, \u0430 \u0437 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u0437 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430 (\u043f\u0430\u0440. 1 \u041f 1, 23), \u043d\u0435 \u0437 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0437 \u0432\u0430\u0434\u044b \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 (\u043f\u0430\u0440. \u042f\u043d 3, 5-6), \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u043d\u0430\u0440\u044d\u0448\u0446\u0435 \u044f\u043a &laquo;\u0432\u044b\u0431\u0440\u0430\u043d\u044b \u0440\u043e\u0434, \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b, \u043b\u044e\u0434, \u0443\u0437\u044f\u0442\u044b \u0411\u043e\u0433\u0430\u043c \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c&hellip; \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u0435 \u043d\u0430\u0440\u043e\u0434, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043d\u0430\u0440\u043e\u0434 \u0411\u043e\u0436\u044b&raquo; (1 \u041f 2, 9-10).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u0430\u043b\u0430\u0432\u043e\u0439 \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u0435\u0441\u0456\u044f\u043d\u0441\u043a\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, &laquo;\u044f\u043a\u0456 \u0431\u044b\u045e \u0432\u044b\u0434\u0430\u043d\u044b \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0448\u0430\u043d\u044b \u0434\u0437\u0435\u043b\u044f \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430&raquo; (\u0420\u044b\u043c 4, 25), \u0430 \u0446\u044f\u043f\u0435\u0440, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0456\u043c\u044f \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0435 \u0456\u043c\u044f, \u0401\u043d \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0441\u043b\u0430\u0432\u0435 \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u0445. \u0413\u044d\u0442\u044b \u043d\u0430\u0440\u043e\u0434 \u043c\u0430\u0435 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u0443 \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445, \u0443 \u0441\u044d\u0440\u0446\u0430\u0445 \u044f\u043a\u0456\u0445 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0436\u044b\u0432\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456. \u042f\u0433\u043e \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u0441\u0442\u0430\u043b\u0430 \u043d\u043e\u0432\u0430\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c: \u043b\u044e\u0431\u0456\u0446\u044c, \u044f\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 (\u043f\u0430\u0440. \u042f\u043d 13, 34). \u0423\u0440\u044d\u0448\u0446\u0435, \u044f\u0433\u043e \u043c\u044d\u0442\u0430 &mdash; \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u0442\u0430\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0441\u0430\u043c\u0456\u043c \u0411\u043e\u0433\u0430\u043c, \u044f\u043a\u043e\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u043f\u0430\u0448\u044b\u0440\u0430\u0446\u0446\u0430 \u0434\u0430\u043b\u0435\u0439, \u043f\u0430\u043a\u0443\u043b\u044c \u0443 \u043a\u0430\u043d\u0446\u044b \u0432\u044f\u043a\u043e\u045e \u044f\u043d\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0406\u043c \u0441\u043f\u043e\u045e\u043d\u0435\u043d\u0430, \u043a\u0430\u043b\u0456 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &mdash; \u0436\u044b\u0446\u0446\u0451 \u043d\u0430\u0448\u0430 (\u043f\u0430\u0440. \u041a\u043b\u0441 3, 4), \u0430 &laquo;\u0441\u0430\u043c\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437 \u043d\u044f\u0432\u043e\u043b\u0456 \u0442\u043b\u0435\u043d\u043d\u044f \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0431\u043e\u0434\u044b \u0445\u0432\u0430\u043b\u044b \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445&raquo; (\u0420\u044b\u043c 8, 21). \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0442\u043e\u0439 \u043c\u0435\u0441\u0456\u044f\u043d\u0441\u043a\u0456 \u043d\u0430\u0440\u043e\u0434, \u0445\u043e\u0446\u044c \u0456 \u043d\u0435 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u0446\u044f\u043f\u0435\u0440 \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430 \u0447\u0430\u0441\u0442\u0430 \u043d\u0430\u0432\u0430\u0442 \u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u043c\u0430\u043b\u043e\u0439 \u0433\u0440\u0443\u043f\u0430\u0439, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434\u043d\u0430\u043a \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u043c \u0437\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u043d\u0430\u0434\u0437\u0435\u0456 \u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u045e\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430. \u0423\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0434\u043b\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0436\u044b\u0446\u0446\u044f, \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u044b, \u0451\u043d \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0406\u043c \u044f\u043a \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0441\u0456\u0445 \u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0434\u0430 \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443 \u044f\u043a \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0442\u0443 \u0456 \u0441\u043e\u043b\u044c \u0437\u044f\u043c\u043b\u0456 (\u043f\u0430\u0440. \u041c\u0446 5, 13-16).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u044f\u043a \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u044f\u043a\u0456 \u0432\u0430\u043d\u0434\u0440\u0430\u0432\u0430\u045e \u043f\u0440\u0430\u0437 \u043f\u0443\u0441\u0442\u044b\u043d\u044e, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430 \u045e\u0436\u043e \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0411\u043e\u0436\u044b\u043c (\u041d\u043c 13, 1; \u043f\u0430\u0440. \u041b\u0456\u0447 20, 4; \u0414\u0440\u0433 23, 1 \u0456 \u043d\u0430\u0441\u0442.), \u0442\u0430\u043a \u0456 \u043d\u043e\u0432\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u044f\u043a\u0456, \u0436\u044b\u0432\u0443\u0447\u044b \u045e \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456\u043c \u0432\u0435\u043a\u0443, \u0448\u0443\u043a\u0430\u0435 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430 (\u043f\u0430\u0440. \u0413\u0431\u0440 13, 14), \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c (\u043f\u0430\u0440. \u041c\u0446 16, 18), \u0431\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0430\u0431\u044b\u045e \u044f\u0433\u043e \u0446\u0430\u043d\u043e\u044e \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 (\u043f\u0430\u0440. \u0414\u0437 20, 28), \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0441\u0432\u0430\u0456\u043c \u0414\u0443\u0445\u0430\u043c \u0456 \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u044b\u045e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u043c\u0456 \u0441\u0440\u043e\u0434\u043a\u0430\u043c\u0456 \u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0456 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u043a\u0430\u0433\u0430 \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430. \u0411\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0437 \u0432\u0435\u0440\u0430\u0439 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u0417\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u044c\u043d\u0456\u043a\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u041a\u0430\u0441\u0446\u0451\u043b, \u043a\u0430\u0431 \u0431\u044b\u045e \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0456 \u0434\u043b\u044f \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0431\u0430\u0447\u043d\u044b\u043c \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043c \u0442\u043e\u0439 \u0437\u0431\u0430\u045e\u0447\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 2, 9. 10; \u041f\u0441 33 (32), 12<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b &ndash; \u043d\u0430\u0440\u043e\u0434, \u0443\u0437\u044f\u0442\u044b \u0411\u043e\u0433\u0430\u043c \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u0435 \u043d\u0430\u0440\u043e\u0434, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043d\u0430\u0440\u043e\u0434 \u0411\u043e\u0436\u044b; \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0432\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u043d\u0430\u0440\u043e\u0434, \u0411\u043e\u0433\u0430\u043c \u044f\u043a\u043e\u0433\u0430 \u0451\u0441\u0446\u044c \u041f\u0430\u043d; \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0401\u043d \u0432\u044b\u0431\u0440\u0430\u045e \u0441\u0430\u0431\u0435 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u0435 \u043d\u0430\u0440\u043e\u0434, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043d\u0430\u0440\u043e\u0434 \u0411\u043e\u0436\u044b; \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0432\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"556","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0432\u0435\u0440\u0443 \u0434\u0430 \u041f\u044f\u0442\u0440\u0430&raquo; \u0441\u0432. \u0424\u0443\u043b\u044c\u0433\u0435\u043d\u0442\u044b\u044f \u0420\u0443\u0441\u043f\u0435\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 22, 62: CCL 91\u0410, 726. 750-751)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u043d\u0451\u0441 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0437\u0430 \u043d\u0430\u0441<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0456 \u0430\u0445\u0432\u044f\u0440\u043d\u044b\u0445 \u0436\u044b\u0432\u0451\u043b, \u044f\u043a\u0456\u044f \u0441\u0430\u043c\u0430 \u0421\u0432\u044f\u0442\u0430\u044f \u0422\u0440\u043e\u0439\u0446\u0430, \u0430\u0434\u0437\u0456\u043d\u044b \u0411\u043e\u0433 \u043d\u043e\u0432\u0430\u0433\u0430 \u0456 \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u043b\u0430 \u0430\u0434 \u043d\u0430\u0448\u044b\u0445 \u043f\u0440\u043e\u0434\u043a\u0430\u045e, \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043b\u0456 \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u044b \u0434\u0430\u0440 \u0442\u043e\u0439 \u0430\u0445\u0432\u044f\u0440\u044b, \u0443 \u044f\u043a\u0456\u043c \u0430\u0434\u0437\u0456\u043d \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0441\u044f\u0431\u0435 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0437\u0430 \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f \u0401\u043d &laquo;\u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043d\u0430\u0441 \u044f\u043a \u0434\u0430\u0440 \u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u0411\u043e\u0433\u0443 \u043d\u0430 \u043f\u0440\u044b\u0435\u043c\u043d\u044b \u0432\u043e\u0434\u0430\u0440&raquo; (\u042d\u0444 5, 2). \u0401\u043d \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0411\u043e\u0433 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440, \u044f\u043a\u0456 \u043d\u0435 \u043f\u0440\u0430\u0437 \u043a\u0440\u043e\u045e \u0431\u044b\u043a\u043e\u045e \u0446\u0456 \u043a\u0430\u0437\u043b\u043e\u045e, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0443\u043b\u0430\u0441\u043d\u0443\u044e \u043a\u0440\u043e\u045e \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441 \u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445. \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0433\u044d\u0442\u0430 \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0447\u043d\u0430 \u0440\u0430\u0431\u0456\u045e \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440, \u044f\u043a\u0456 \u0448\u0442\u043e\u0433\u043e\u0434 \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0437 \u0430\u0445\u0432\u044f\u0440\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u045e \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0432\u0430\u0432\u0430\u045e \u0443 \u0441\u0430\u0431\u0435 \u0430\u0434\u043d\u044b\u043c \u0443\u0441\u0451, \u0448\u0442\u043e, \u044f\u043a \u0432\u0435\u0434\u0430\u045e, \u0431\u044b\u043b\u043e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0434\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0401\u043d \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0441\u0432\u044f\u0442\u0430\u0440 \u0456 \u0430\u0445\u0432\u044f\u0440\u0430, \u0411\u043e\u0433 \u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u044f: \u0430\u0445\u0432\u044f\u0440\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u043c\u044b \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u043b\u0456\u0441\u044f \u0437 \u0411\u043e\u0433\u0430\u043c; \u0441\u0432\u044f\u0442\u044b\u043d\u044f, \u0443 \u044f\u043a\u043e\u0439 \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u043b\u0456\u0441\u044f, \u0456 \u0411\u043e\u0433, \u0437 \u044f\u043a\u0456\u043c \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u043b\u0456\u0441\u044f. \u0422\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u0430\u0434\u0437\u0456\u043d &ndash; \u0433\u044d\u0442\u0430 \u0456 \u0441\u0432\u044f\u0442\u0430\u0440, \u0456 \u0430\u0445\u0432\u044f\u0440\u0430, \u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u044f, \u0431\u043e \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 &ndash; \u0411\u043e\u0433 \u0443 \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0441\u043b\u0443\u0433\u0456. \u0410\u0434\u043d\u0430\u043a \u0401\u043d \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0430\u043c \u043d\u0435 \u0430\u0434\u0437\u0456\u043d, \u0430\u043b\u0435 \u0451\u0441\u0446\u044c \u0406\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0446\u0432\u0451\u0440\u0434\u0430 \u0432\u0435\u0440 \u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0439\u0441\u044f, \u0448\u0442\u043e \u0441\u0430\u043c\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430, \u0441\u0442\u0430\u045e\u0448\u044b \u0446\u0435\u043b\u0430\u043c, \u043f\u0440\u044b\u043d\u044f\u0441\u043b\u043e \u0441\u044f\u0431\u0435 \u0411\u043e\u0433\u0443 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0437\u0430 \u043d\u0430\u0441, \u044f\u043a \u043f\u0440\u044b\u0435\u043c\u043d\u044b \u0432\u043e\u0434\u0430\u0440. \u0423 \u0447\u0430\u0441 \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443 \u042f\u043c\u0443 \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0456 \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0436\u044b\u0432\u0451\u043b. \u0410 \u0446\u044f\u043f\u0435\u0440, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443 \u0447\u0430\u0441 \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u042f\u043c\u0443 \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0437 \u044f\u043a\u0456\u043c\u0456 \u0401\u043d \u043f\u0430\u0434\u0437\u044f\u043b\u044f\u0435 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044c, \u0441\u0432\u044f\u0442\u044b \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0432\u0435\u0440\u044b \u0456 \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0430\u0445\u0432\u044f\u0440\u044b \u0445\u043b\u0435\u0431\u0430 \u0456 \u0432\u0456\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u0430\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0456 \u0436\u044b\u0432\u0451\u043b \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043b\u0456 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u043e\u0435 \u0401\u043d, \u0431\u0443\u0434\u0443\u0447\u044b \u0431\u044f\u0437\u0433\u0440\u044d\u0448\u043d\u044b\u043c, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0430\u0434\u0434\u0430\u0446\u044c \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456, \u0456 \u043a\u0440\u043e\u045e, \u044f\u043a\u0443\u044e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043f\u0440\u0430\u043b\u0456\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u044f \u043d\u0430\u0448\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e. \u0423 \u0433\u044d\u0442\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u044b \u0451\u0441\u0446\u044c \u0456 \u043f\u0430\u0434\u0437\u044f\u043a\u0430, \u0456 \u043d\u0430\u043f\u0430\u043c\u0456\u043d \u043f\u0440\u0430 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u043e\u0435 \u0430\u0434\u0434\u0430\u045e \u0437\u0430 \u043d\u0430\u0441, \u0456 \u043f\u0440\u0430 \u043a\u0440\u043e\u045e, \u044f\u043a\u0443\u044e \u0442\u043e\u0439 \u0436\u0430 \u0411\u043e\u0433 \u043f\u0440\u0430\u043b\u0456\u045e \u0437\u0430 \u043d\u0430\u0441. \u041a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0443 \u0414\u0437\u0435\u044f\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e: &laquo;\u041f\u0456\u043b\u044c\u043d\u0443\u0439\u0446\u0435 \u0441\u044f\u0431\u0435 \u0456 \u045e\u0432\u0435\u0441\u044c \u0441\u0442\u0430\u0442\u0430\u043a, \u0443 \u044f\u043a\u0456\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0432\u0430\u0441 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c\u0456, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u0432\u0456\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0401\u043d \u043f\u0440\u044b\u0434\u0431\u0430\u045e \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u0439&raquo; (\u0414\u0437 20, 28).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0443 \u0441\u0442\u0430\u0440\u0430\u0437\u0430\u043f\u0430\u0432\u0435\u0442\u043d\u044b\u0445 \u0430\u0445\u0432\u044f\u0440\u0430\u0445 \u0432\u043e\u0431\u0440\u0430\u0437\u043d\u0430 \u0432\u044b\u044f\u045e\u043b\u044f\u043b\u0430\u0441\u044f \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u043e \u043d\u0430\u043c \u0431\u044b\u0446\u044c \u0434\u0430\u0434\u0437\u0435\u043d\u0430. \u0410 \u045e \u0433\u044d\u0442\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u044b \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0431\u0430\u0447\u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u045e\u0436\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u043f\u0440\u0430\u0434\u0432\u044f\u0448\u0447\u0430\u043b\u0456, \u0448\u0442\u043e \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0431\u0456\u0442\u044b \u0437\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445. \u0410 \u0433\u044d\u0442\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u043d\u0430\u043c, \u0448\u0442\u043e \u0401\u043d \u0437\u0430\u0431\u0456\u0442\u044b \u0437\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445, \u044f\u043a \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0430\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u041a\u0430\u043b\u0456 \u043c\u044b \u0431\u044b\u043b\u0456 \u044f\u0448\u0447\u044d \u0441\u043b\u0430\u0431\u044b\u043c\u0456, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0447\u0430\u0441 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445&raquo; (\u0420\u044b\u043c 5, 6), \u0456 \u0434\u0430\u043b\u0435\u0439: &laquo;\u0411\u0443\u0434\u0443\u0447\u044b \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456, \u043c\u044b \u043f\u0430\u044f\u0434\u043d\u0430\u043b\u0456\u0441\u044f \u0437 \u0411\u043e\u0433\u0430\u043c \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c \u042f\u0433\u043e \u0421\u044b\u043d\u0430&raquo; (\u0420\u044b\u043c 5, 10).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041a\u043b\u0441 1, 21-22; \u0420\u044b\u043c 3, 25\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0431\u044b\u043b\u0456 \u0430\u0434\u0447\u0443\u0436\u0430\u043d\u044b\u044f \u0456 \u0432\u0430\u0440\u043e\u0436\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u044f \u0456 \u0441\u0432\u0430\u0456\u0445 \u0431\u043b\u0430\u0433\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u045e, \u0430\u043b\u0435 \u0446\u044f\u043f\u0435\u0440 \u0411\u043e\u0433 \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u045e \u0432\u0430\u0441 \u0443 \u0446\u0435\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e\u043d\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c,<span style=\"color: #ff0000;\"> *<\/span> \u043a\u0430\u0431 \u0432\u044b \u0431\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u0456 \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u0433\u043e \u0411\u043e\u0433 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0443 \u043c\u043e\u0446\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0432\u044b \u0431\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u0456 \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"557","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0437\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 45, 23-24: PG 36, 654-655)<\/span><br \/><span style=\"color: #ff0000;\">\u041c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u041f\u0430\u0441\u0445\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u041f\u0430\u0441\u0445\u0456 \u0446\u044f\u043f\u0435\u0440 \u044f\u0448\u0447\u044d \u0432\u043e\u0431\u0440\u0430\u0437\u043d\u0430, \u0445\u043e\u0446\u044c \u0456 \u0431\u043e\u043b\u044c\u0448 \u0432\u044b\u0440\u0430\u0437\u043d\u0430, \u0447\u044b\u043c \u0443 \u0441\u0442\u0430\u0440\u044b\u043c \u0437\u0430\u043a\u043e\u043d\u0435 (\u043d\u0435 \u043f\u0430\u0431\u0430\u044e\u0441\u044f \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u0441\u0442\u0430\u0440\u0430\u0437\u0430\u043f\u0430\u0432\u0435\u0442\u043d\u0430\u044f \u041f\u0430\u0441\u0445\u0430 \u0431\u044b\u043b\u0430 \u0431\u043e\u043b\u044c\u0448 \u0446\u044c\u043c\u044f\u043d\u044b\u043c \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c, \u0447\u044b\u043c \u0432\u043e\u0431\u0440\u0430\u0437\u043d\u0430\u044f \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c). \u0410\u0434\u043d\u0430\u043a \u043a\u0440\u044b\u0445\u0443 \u043f\u0430\u0437\u043d\u0435\u0439 \u043c\u044b \u043f\u0430\u0447\u043d\u0451\u043c \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u044f\u0435 \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u0456 \u0447\u044b\u0441\u0442\u0430, \u0430 \u045e\u043b\u0430\u0441\u043d\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0421\u043b\u043e\u0432\u0430 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u044f\u0435 \u045e \u043d\u043e\u0432\u0430\u0439 \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u043c\u0456 \u045e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u0410\u0439\u0446\u0430, \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u044e\u0447\u044b \u0456 \u0432\u044b\u044f\u045e\u043b\u044f\u044e\u0447\u044b \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u043b\u0430\u0441\u044f \u0446\u0430\u043b\u043a\u0430\u043c. \u0422\u043e\u0435, \u0448\u0442\u043e \u0441\u0451\u043d\u043d\u044f \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0446\u0430, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043d\u043e\u0432\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u044f\u043a\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u0433\u044d\u0442\u0430\u044f \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u044f \u0433\u0430\u0441\u0446\u0456\u043d\u0430, \u0430 \u042f\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u0456 \u045e\u0434\u0437\u044f\u043b\u044f\u0446\u044c \u0441\u0432\u0430\u0456\u043c \u0432\u0443\u0447\u043d\u044f\u043c \u0433\u044d\u0442\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435. \u0412\u0443\u0447\u044d\u043d\u043d\u0435 \u0433\u044d\u0442\u0430\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0430\u043c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0430\u043c \u0436\u044b\u0432\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0441\u0442\u0430\u043d\u0435\u043c \u0436\u0430 \u0456 \u043c\u044b \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0417\u0430\u043a\u043e\u043d\u0443, \u0430\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0430\u0439 \u043f\u0440\u0430\u045e\u0434\u044b, \u0430 \u043d\u0435 \u043b\u0456\u0442\u0430\u0440\u044b; \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430, \u0430 \u043d\u0435 \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430; \u0432\u0435\u0447\u043d\u0430, \u0430 \u043d\u0435 \u0447\u0430\u0441\u043e\u0432\u0430. \u041f\u0430\u0431\u0443\u0434\u0443\u0435\u043c \u0441\u0430\u0431\u0435 \u0441\u0442\u0430\u043b\u0456\u0446\u0443, \u0430\u043b\u0435 \u043d\u0435 \u0437\u044f\u043c\u043d\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0433\u043e\u0440\u0430\u0434. \u041d\u0435 \u0442\u0443\u044e, \u0448\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u0434\u0440\u0430\u0442\u0443\u044e\u0446\u044c \u0436\u0430\u045e\u043d\u0435\u0440\u044b, \u0430\u043b\u0435 \u0442\u0443\u044e, \u0448\u0442\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0430\u043d\u0451\u043b\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0430\u0445\u0432\u044f\u0440\u043e\u045e\u0432\u0430\u0446\u044c \u043c\u0430\u043b\u0430\u0434\u044b\u0445 \u0446\u044f\u043b\u044f\u0442 \u0456 \u044f\u0433\u043d\u044f\u0442, \u0448\u0442\u043e \u043c\u0430\u044e\u0446\u044c \u0440\u043e\u0433\u0456 \u0456 \u043a\u0430\u043f\u044b\u0442\u044b, \u044f\u043a\u0456\u044f \u043f\u0430 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0447\u0430\u0441\u0442\u0446\u044b \u043c\u0451\u0440\u0442\u0432\u044b\u044f \u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u044f \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u045e, \u0430\u043b\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c\u0456 \u0445\u043e\u0440\u0430\u043c\u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0451\u043c \u0411\u043e\u0433\u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u0445\u0432\u0430\u043b\u044b \u043d\u0430 \u0430\u043b\u0442\u0430\u0440\u044b \u045e \u043d\u0435\u0431\u0435. \u0423\u0432\u043e\u0439\u0434\u0437\u0435\u043c \u0437\u0430 \u043f\u0435\u0440\u0448\u0443\u044e \u0437\u0430\u0441\u043b\u043e\u043d\u0443, \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u043c\u0441\u044f \u0434\u0430 \u0434\u0440\u0443\u0433\u043e\u0439 \u0456 \u0437\u0430\u0437\u0456\u0440\u043d\u0435\u043c \u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043a\u0430\u0436\u0443 \u043d\u0430\u0432\u0430\u0442 \u0431\u043e\u043b\u044c\u0448: \u0430\u0445\u0432\u044f\u0440\u0443\u0435\u043c \u0411\u043e\u0433\u0443 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0431\u0443\u0434\u0437\u0435\u043c \u0448\u0442\u043e\u0434\u043d\u044f \u0430\u0445\u0432\u044f\u0440\u043e\u045e\u0432\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0456 \u045e\u0441\u0435 \u0441\u0432\u0430\u0435 \u043f\u0430\u0447\u044b\u043d\u0430\u043d\u043d\u0456. \u0411\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u0443\u0441\u0451 \u0434\u0437\u0435\u043b\u044f \u0421\u043b\u043e\u0432\u0430 \u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u043a\u0443\u0442\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u043c\u0443\u043a\u0443, \u043f\u0440\u0430\u0437 \u043a\u0440\u043e\u045e \u0443\u0448\u0430\u043d\u0443\u0435\u043c \u041a\u0440\u043e\u045e, \u0437 \u0433\u0430\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044e \u045e\u0437\u044b\u0434\u0437\u0435\u043c \u043d\u0430 \u043a\u0440\u044b\u0436.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u044b \u0421\u044b\u043c\u043e\u043d \u041a\u0456\u0440\u044b\u043d\u044d\u0435\u0446, \u0432\u0430\u0437\u044c\u043c\u0456 \u043a\u0440\u044b\u0436 \u0456 \u0456\u0434\u0437\u0456 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u044b, \u044f\u043a \u0437\u043b\u043e\u0434\u0437\u0435\u0439, \u043f\u0440\u044b\u0431\u0456\u0442\u044b \u0434\u0430 \u043a\u0440\u044b\u0436\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u043f\u0440\u044b\u0437\u043d\u0430\u0439 \u0443 \u0406\u043c \u0411\u043e\u0433\u0430 \u044f\u043a \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u041a\u0430\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430 \u0442\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456 \u0431\u044b\u045e \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u044b \u0434\u0430 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e, \u0441\u0442\u0430\u043d\u044c \u0434\u0437\u0435\u043b\u044f \u042f\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c. \u041f\u0430\u043a\u043b\u0430\u043d\u044f\u0439\u0441\u044f \u0442\u0430\u043c\u0443, \u043a\u0430\u0433\u043e \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043b\u0456 \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435, \u0456 \u0441\u0430\u043c, \u0431\u0443\u0434\u0443\u0447\u044b \u043d\u0430 \u043a\u0440\u044b\u0436\u044b, \u0430\u0442\u0440\u044b\u043c\u0430\u0439 \u0445\u043e\u0446\u044c \u043d\u0435\u0439\u043a\u0443\u044e \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0437 \u0441\u0430\u043c\u043e\u0439 \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456, \u0446\u0430\u043d\u043e\u044e \u0441\u043c\u0435\u0440\u0446\u0456 \u043d\u0430\u0431\u0443\u0434\u0437\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0443\u0432\u0430\u0439\u0434\u0437\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0415\u0437\u0443\u0441\u0430\u043c \u0443 \u0440\u0430\u0439, \u043a\u0430\u0431 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u044f\u043a\u043e\u0433\u0430 \u0434\u0430\u0431\u0440\u0430 \u0442\u044b \u0441\u044f\u0431\u0435 \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u045e. \u0421\u0443\u0437\u0456\u0440\u0430\u0439 \u042f\u0433\u043e \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c, \u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043d\u0430\u0440\u0430\u043a\u0430\u0435, \u0434\u0430\u0437\u0432\u043e\u043b\u044c \u0437\u0432\u043e\u043d\u043a\u0443 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0437 \u044f\u0433\u043e\u043d\u044b\u043c\u0456 \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u044b \u042e\u0437\u0430\u0444 \u0437 \u0410\u0440\u044b\u043c\u0430\u0442\u044d\u0456, \u043f\u0440\u0430\u0441\u0456 \u0446\u0435\u043b\u0430 \u0415\u0437\u0443\u0441\u0430 \u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u042f\u0433\u043e \u043f\u0440\u044b\u0431\u0456\u045e \u0434\u0430 \u043a\u0440\u044b\u0436\u0430. \u041d\u044f\u0445\u0430\u0439 \u044f\u043d\u043e \u0431\u0443\u0434\u0437\u0435 \u0442\u0432\u0430\u0451\u0439 \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u044b \u041d\u0456\u043a\u0430\u0434\u044d\u043c, \u0442\u043e\u0439 \u043d\u0430\u0447\u043d\u044b \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0456\u043a \u0411\u043e\u0433\u0430, \u043d\u0430\u043c\u0430\u0441\u0446\u0456 \u042f\u0433\u043e \u043f\u0430\u0445\u0430\u0432\u0430\u043b\u044c\u043d\u044b\u043c \u0430\u043b\u0435\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u044b \u041c\u0430\u0440\u044b\u044f, \u0430\u0431\u043e \u0434\u0440\u0443\u0433\u0430\u044f \u041c\u0430\u0440\u044b\u044f, \u0446\u0456 \u0421\u0430\u043b\u0430\u043c\u0435\u044f \u0430\u0431\u043e \u042f\u043d\u0430, \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0439 \u0441\u0432\u0430\u0435 \u0441\u043b\u0451\u0437\u044b \u043d\u0430 \u0437\u043e\u043b\u043a\u0443. \u041f\u0430\u0441\u0442\u0430\u0440\u0430\u0439\u0441\u044f \u043f\u0435\u0440\u0448\u0430\u0439 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u0439 \u0430\u0434\u0441\u0443\u043d\u0443\u0442\u044b \u043a\u0430\u043c\u0435\u043d\u044c, \u0430 \u043c\u043e\u0436\u0430, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u043d\u0451\u043b\u0430\u045e \u0446\u0456 \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u043e\u0433\u0430 \u0415\u0437\u0443\u0441\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0431\u0440 13, 12-13; 12, 4<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0430\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0441\u0432\u0430\u0451\u044e \u043a\u0440\u044b\u0432\u0451\u044e \u043d\u0430\u0440\u043e\u0434, \u0415\u0437\u0443\u0441 \u0446\u044f\u0440\u043f\u0435\u045e \u043c\u0443\u043a\u0443 \u0437\u0430 \u0433\u043e\u0440\u0430\u0434\u0430\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043c\u044b \u0432\u044b\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u042f\u0433\u043e \u0437\u0430 \u043b\u0430\u0433\u0435\u0440, \u043d\u0435\u0441\u0443\u0447\u044b \u042f\u0433\u043e \u0437\u043d\u044f\u0432\u0430\u0433\u0456. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u0437\u043c\u0430\u0433\u0430\u043b\u0456\u0441\u044f \u0430\u0436 \u0434\u0430 \u043a\u0440\u044b\u0432\u0456, \u0432\u0430\u044e\u044e\u0447\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u0440\u0430\u0445\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043c\u044b \u0432\u044b\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u042f\u0433\u043e \u0437\u0430 \u043b\u0430\u0433\u0435\u0440, \u043d\u0435\u0441\u0443\u0447\u044b \u042f\u0433\u043e \u0437\u043d\u044f\u0432\u0430\u0433\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"561","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u043d\u0434\u0440\u044d\u044f \u041a\u0440\u044b\u0446\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 9 in ramos palmarum: PG 97, 990-994)<\/span><br \/><span style=\"color: #ff0000;\">\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430, \u041a\u0430\u0440\u043e\u043b\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0430\u0434\u0437\u0435\u043c\u0446\u0435, \u0440\u0430\u0437\u0430\u043c \u043f\u0430\u0434\u044b\u043c\u0435\u043c\u0441\u044f \u043d\u0430 \u0410\u043b\u0456\u045e\u043d\u0443\u044e \u0433\u0430\u0440\u0443. \u0412\u044b\u0439\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0425\u0440\u044b\u0441\u0442\u0443, \u044f\u043a\u0456 \u0441\u0451\u043d\u043d\u044f \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0437 \u0411\u044d\u0442\u0430\u043d\u0456\u0456 \u0456 \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0441\u043f\u044f\u0448\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0433\u043e\u0434\u043d\u0443\u044e \u043f\u0430\u0448\u0430\u043d\u044b \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0443\u044e \u043c\u0443\u043a\u0443, \u043a\u0430\u0431 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u043f\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u044b\u0448\u043e\u045e \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441, \u043a\u0430\u0431 \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u043b\u044f\u0436\u044b\u043c \u0443 \u043d\u0435\u043c\u0430\u0447\u044b, \u0443\u0437\u0432\u044b\u0441\u0456\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0441\u0430\u0431\u043e\u044e &laquo;\u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u043a\u043d\u044f\u0436\u0430\u043d\u043d\u0435, \u0456 \u045e\u043b\u0430\u0434\u0443, \u0456 \u0441\u0456\u043b\u0443, \u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435, \u0456 \u0437\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0456\u043c\u044f, \u044f\u043a\u043e\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u044c&raquo; (\u042d\u0444 1, 21).<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0435 \u044f\u043a \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u0445\u0432\u0430\u043b\u044e\u0435 \u0441\u043b\u0430\u0432\u0430, \u043f\u0430\u043c\u043f\u0435\u0437\u043d\u0430 \u0456 \u043f\u044b\u0445\u043b\u0456\u0432\u0430. &laquo;\u041d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c \u0456 \u043b\u044f\u043c\u0430\u043d\u0442\u0430\u0432\u0430\u0446\u044c, \u0456 \u043d\u0435 \u043f\u0430\u0447\u0443\u0435 \u043d\u0456\u0445\u0442\u043e \u043d\u0430 \u043f\u043b\u043e\u0448\u0447\u0430\u0445 \u0433\u043e\u043b\u0430\u0441\u0443 \u042f\u0433\u043e&raquo; (\u041c\u0446 12, 19). \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u043b\u0430\u0433\u043e\u0434\u043d\u044b \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b, \u0443 \u043f\u0440\u043e\u0441\u0442\u044b\u043c \u0430\u0434\u0437\u0435\u043d\u043d\u0456, \u0456 \u0441\u0446\u0456\u043f\u043b\u044b \u0431\u0443\u0434\u0437\u0435 \u042f\u0433\u043e \u045e\u0432\u0430\u0445\u043e\u0434.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u043f\u0430\u0431\u044f\u0436\u044b\u043c \u0436\u0430 \u0456 \u043c\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u044f\u043a\u0456 \u0441\u043f\u044f\u0448\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u043c\u0443\u043a\u0443, \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u044b\u0439\u0448\u0430\u045e \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0441\u0441\u0446\u0456\u043b\u0430\u0446\u044c \u043d\u0430 \u0434\u0430\u0440\u043e\u0437\u0435 \u0433\u0430\u043b\u0456\u043d\u043a\u0456 \u043f\u0430\u043b\u044c\u043c\u044b \u0446\u0456 \u0430\u043b\u0456\u0432\u044b, \u0446\u0456 \u0434\u0430\u0440\u0430\u0433\u0456\u044f \u0448\u0430\u0442\u044b, \u0430\u043b\u0435 \u0441\u0430\u043c\u0456, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0436\u0430\u043c, \u0437 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c \u0456 \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u043e\u044e \u0441\u044d\u0440\u0446\u0430 \u0440\u0430\u0441\u0441\u0446\u0435\u043b\u0456\u043c\u0441\u044f, \u043a\u0430\u0431 \u0441\u0443\u0441\u0442\u0440\u044d\u0446\u044c \u0433\u044d\u0442\u0430\u0435 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0443 \u0441\u044f\u0431\u0435 \u0411\u043e\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u0430\u0445\u0430\u043f\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043b\u0430\u0433\u043e\u0434\u043d\u044b, \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u043c\u043e\u0436\u0430 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u043c\u0456 \u0442\u0430\u043a\u0456\u043c \u043b\u0430\u0433\u043e\u0434\u043d\u044b\u043c. \u0401\u043d \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0434 \u0437\u0430\u0445\u0430\u0434\u0430\u043c \u043d\u0430\u0448\u0430\u0439 \u0441\u0430\u043c\u0430\u0439 \u043c\u0456\u0437\u044d\u0440\u043d\u0430\u0439 \u043d\u0456\u0437\u043a\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u043d\u0430\u0441, \u0436\u044b\u0446\u044c \u0437 \u043d\u0430\u043c\u0456 \u0456 \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443\u0446\u044c \u0434\u0430 \u0441\u044f\u0431\u0435 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044f\u0446\u0442\u0432\u0430 \u0437 \u0441\u0430\u0431\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u043f\u0440\u0430\u0437 \u0430\u0445\u0432\u044f\u0440\u0443 \u043d\u0430\u0448\u0430\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0401\u043d &laquo;\u0443\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u044b, \u043d\u044f\u0431\u0451\u0441\u044b \u0430\u0434\u0432\u0435\u0447\u043d\u044b\u044f&raquo; (\u041f\u0441 68 [67], 34), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u044e \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u0445\u0432\u0430\u043b\u044b \u0456 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456, \u0401\u043d \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0430\u0434\u0440\u043e\u043a\u0441\u044f \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0440\u043e\u0434\u0443, \u0430 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u043f\u0430\u0434\u044b\u043c\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443 \u0430\u0434 \u0437\u044f\u043c\u043d\u043e\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u0434\u0430 \u045e\u0441\u0451 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0441\u043b\u0430\u0432\u044b, \u043f\u0430\u043a\u0443\u043b\u044c \u044f\u043d\u0430 \u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u0432\u044b\u0448\u044b\u043d\u044f\u045e \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0440\u0430\u0441\u0441\u0446\u0435\u043b\u0456\u043c \u043f\u0435\u0440\u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u0430 \u043d\u0435 \u0442\u0443\u043d\u0456\u043a\u0456, \u043c\u0451\u0440\u0442\u0432\u044b\u044f \u0433\u0430\u043b\u0456\u043d\u044b \u0456 \u0437\u0440\u044d\u0437\u0430\u043d\u0430\u0435 \u0434\u043b\u044f \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0443 \u043a\u0443\u0441\u0442\u043e\u045e\u0435, \u0448\u0442\u043e \u0441\u0442\u0440\u0430\u0447\u0432\u0430\u0435 \u0441\u0432\u0435\u0436\u0430\u0441\u0446\u044c \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441 \u0446\u0435\u0448\u044b\u0446\u044c \u0437\u0440\u043e\u043a. \u0410\u043f\u0440\u0430\u043d\u0435\u043c\u0441\u044f \u045e \u042f\u0433\u043e \u043b\u0430\u0441\u043a\u0443, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443 \u042f\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u0430. \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0423\u0441\u0435 \u0432\u044b, \u0445\u0442\u043e \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u045e\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0456\u0441\u044f&raquo; (\u043f\u0430\u0440. \u0413\u0430\u043b 3, 27). \u0422\u0430\u043c\u0443 \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043c\u0441\u044f \u043f\u0430\u0434 \u042f\u0433\u043e\u043d\u044b\u044f \u043d\u043e\u0433\u0456 \u044f\u043a \u0440\u0430\u0437\u0430\u0441\u043b\u0430\u043d\u044b\u044f \u0442\u0443\u043d\u0456\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448\u044b \u0433\u0440\u0430\u0445\u0456 \u0431\u044b\u043b\u0456 \u0447\u044b\u0440\u0432\u043e\u043d\u044b\u044f, \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u0443\u0440\u043f\u0443\u0440, \u0430 \u0446\u044f\u043f\u0435\u0440, \u0430\u0431\u043c\u044b\u0442\u044b\u044f \u045e \u0437\u0431\u0430\u045e\u0447\u0430\u0439 \u043a\u0443\u043f\u0435\u043b\u0456 \u0445\u0440\u043e\u0441\u0442\u0443, \u043c\u044b \u0434\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u0441\u043d\u0435\u0436\u043d\u0430 \u0431\u0435\u043b\u0430\u0439 \u0432\u043e\u045e\u043d\u044b, \u0442\u0430\u043c\u0443 \u0430\u0445\u0432\u044f\u0440\u0443\u0435\u043c \u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0443 \u045e\u0436\u043e \u043d\u0435 \u043f\u0430\u043b\u044c\u043c\u043e\u0432\u044b\u044f \u0433\u0430\u043b\u0456\u043d\u043a\u0456, \u0430 \u0432\u044f\u043d\u0435\u0446 \u043d\u0430\u0448\u0430\u0439 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u042f\u0433\u043e \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u0441\u0432\u044f\u0442\u043e\u0439 \u043f\u0435\u0441\u043d\u044f\u0439 \u0440\u0430\u0437\u0430\u043c \u0437 \u0434\u0437\u0435\u0446\u044c\u043c\u0456, \u043c\u0430\u0445\u0430\u044e\u0447\u044b \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c\u0456 \u0433\u0430\u043b\u0456\u043d\u043a\u0430\u043c\u0456: &laquo;\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430, \u041a\u0430\u0440\u043e\u043b\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042f\u043d 12, 12. 13; \u043f\u0430\u0440. \u041c\u0446 21, 8. 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434 \u043f\u0430\u0447\u0443\u045e, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0432\u044b\u0431\u0435\u0433 \u042f\u043c\u0443 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447. \u0412\u044f\u043b\u0456\u0437\u043d\u044b \u043d\u0430\u0442\u043e\u045e\u043f \u0440\u0430\u0441\u0441\u0446\u0456\u043b\u0430\u045e \u043f\u043b\u0430\u0448\u0447\u044b \u043d\u0430 \u0434\u0430\u0440\u043e\u0433\u0430\u0445, \u0456\u043d\u0448\u044b\u044f \u0430\u0431\u0440\u0430\u0437\u0430\u043b\u0456 \u0433\u0430\u043b\u0456\u043d\u043a\u0456 \u0437 \u0434\u0440\u044d\u045e, \u043a\u0456\u0434\u0430\u043b\u0456 \u0456\u0445 \u043d\u0430 \u0434\u0430\u0440\u043e\u0433\u0443 \u0456 \u043a\u0440\u044b\u0447\u0430\u043b\u0456: <span style=\"color: #ff0000;\">*<\/span> \u0413\u0430\u0441\u0430\u043d\u043d\u0430 \u0421\u044b\u043d\u0443 \u0414\u0430\u0432\u0456\u0434\u0430, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u0442\u043e\u045e\u043f\u044b, \u044f\u043a\u0456\u044f \u042f\u0433\u043e \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u043b\u0456 \u0456 \u044f\u043a\u0456\u044f \u0456\u0448\u043b\u0456 \u0437\u0430 \u0406\u043c, \u0433\u0443\u0447\u043d\u0430 \u043a\u0440\u044b\u0447\u0430\u043b\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u0430\u0441\u0430\u043d\u043d\u0430 \u0421\u044b\u043d\u0443 \u0414\u0430\u0432\u0456\u0434\u0430, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"562","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo Guelferbytanus 3: PLS 2, 545-546)<\/span><br \/><span style=\"color: #ff0000;\">\u0411\u0443\u0434\u0437\u0435\u043c \u0456 \u043c\u044b \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043a\u0440\u044b\u0436\u0430\u043c \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0443\u043a\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u043d\u0435 \u043d\u0430 \u0441\u043b\u0430\u0432\u0443 \u0456 \u0448\u043a\u043e\u043b\u0430 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044d\u0440\u0446\u044b \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u043c\u043e\u0433\u0443\u0446\u044c \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u045e\u0441\u044f\u043a\u0443\u044e \u043b\u0430\u0441\u043a\u0443 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0431\u043e \u043d\u0435 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u0439\u0446\u043e\u043c \u0430\u0434\u0437\u0456\u043d\u044b \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0434\u0437\u0435\u043b\u044f \u0456\u0445 \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435, \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0401\u043d \u044f\u0448\u0447\u044d \u0437\u0432\u0435\u0434\u0430\u045e \u0441\u043c\u0435\u0440\u0446\u044c \u0430\u0434 \u0440\u0443\u043a \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u0445 \u0406\u043c \u0436\u0430 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044f\u043b\u0456\u043a\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0411\u043e\u0433 \u0430\u0431\u044f\u0446\u0430\u0435 \u043d\u0430\u043c \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u044e. \u0410\u043b\u0435 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0436\u043e \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u0456 \u0448\u0442\u043e \u043c\u044b \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435\u043c. \u0414\u0437\u0435 \u0431\u044b\u043b\u0456 \u0430\u0431\u043e \u0447\u044b\u043c \u0431\u044b\u043b\u0456 \u043b\u044e\u0434\u0437\u0456, \u043a\u0430\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445? \u0425\u0442\u043e \u0436 \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430, \u0448\u0442\u043e \u0401\u043d \u0434\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u044f\u0442\u044b\u043c, \u043a\u0430\u043b\u0456 \u0434\u0430\u045e \u0456\u043c \u043d\u0430\u0432\u0430\u0442 \u0441\u0432\u0430\u044e \u0441\u043c\u0435\u0440\u0446\u044c? \u0427\u0430\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u043a\u0440\u043e\u0445\u043a\u0430\u0441\u0446\u044c \u0432\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0432\u0435\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u043b\u044e\u0434\u0437\u0456 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0436\u044b\u0446\u044c \u0437 \u0411\u043e\u0433\u0430\u043c?<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043c\u0430\u0435 \u043d\u0435\u0432\u0435\u0440\u0430\u0433\u043e\u0434\u043d\u0430\u0435 \u045e\u0436\u043e \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u043f\u0430\u043c\u0451\u0440 \u0434\u0437\u0435\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0445\u0442\u043e \u0442\u0430\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a \u043d\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u045e \u0421\u043b\u043e\u0432\u0430\u043c, \u0430 \u0421\u043b\u043e\u0432\u0430 \u0431\u044b\u043b\u043e \u045e \u0411\u043e\u0433\u0430, \u0456 \u0411\u043e\u0433\u0430\u043c \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430 (\u043f\u0430\u0440. \u042f\u043d 1, 1)? \u0413\u044d\u0442\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 &laquo;\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u043c\u0456&raquo; (\u042f\u043d 1, 14). \u041a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u043e \u0430\u0434 \u043d\u0430\u0441 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u0441\u0430\u043c\u043e \u045e \u0441\u0430\u0431\u0435 \u043d\u0435 \u043c\u0435\u043b\u0430 \u0431 \u043d\u0456\u0447\u043e\u0433\u0430, \u0448\u0442\u043e \u043c\u0430\u0433\u043b\u043e \u0431 \u043f\u0430\u043c\u0435\u0440\u0446\u0456. \u0422\u0430\u043a \u041d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b \u0437\u043c\u043e\u0433 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0456 \u0442\u0430\u043a \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u044f \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0441\u0432\u0430\u0456\u043c\u0456 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0441\u0442\u0430\u045e \u0441\u043f\u044f\u0440\u0448\u0430 \u0441\u0430\u043c. \u041c\u044b \u043d\u0435 \u0430\u0434 \u0441\u044f\u0431\u0435 \u043c\u0430\u0435\u043c \u0436\u044b\u0446\u0446\u0451, \u0456 \u0401\u043d \u043d\u0435 \u0430\u0434 \u0441\u044f\u0431\u0435 \u043c\u043e\u0433 \u043f\u0430\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0437 \u043d\u0430\u043c\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0434\u0437\u0456\u045e\u043d\u0443\u044e \u0437\u0430\u043c\u0435\u043d\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0433\u0430 \u045e\u0434\u0437\u0435\u043b\u0443: \u043d\u0430\u0448\u044b\u043c \u0431\u044b\u043b\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u0437\u043c\u043e\u0433 \u043f\u0430\u043c\u0435\u0440\u0446\u0456, \u0430 \u042f\u0433\u043e\u043d\u044b\u043c \u0431\u0443\u0434\u0437\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0437\u043c\u043e\u0436\u0430\u043c \u0436\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u0441\u0430\u0440\u043e\u043c\u0435\u0446\u0446\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0430\u043b\u0435 \u045e \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u044f\u0435 \u0456 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0451\u044e. \u041f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u0430\u0434 \u043d\u0430\u0441 \u0441\u043c\u0435\u0440\u0446\u044c, \u044f\u043a\u0443\u044e \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0443 \u043d\u0430\u0441, \u0401\u043d \u0446\u0432\u0451\u0440\u0434\u0430 \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0434\u0430\u0446\u044c \u043d\u0430\u043c \u0443 \u0441\u0430\u0431\u0435 \u0436\u044b\u0446\u0446\u0451, \u044f\u043a\u043e\u0435 \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0434\u0430\u0446\u044c \u0441\u0430\u043c\u0456 \u0441\u0430\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0451\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u043d\u0430\u0441 \u0401\u043d, \u0431\u044f\u0437\u0433\u0440\u044d\u0448\u043d\u044b, \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u0437\u0430 \u043d\u0430\u0441, \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e, \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456. \u0414\u044b\u043a \u044f\u043a \u0436\u0430 \u0401\u043d, \u044f\u043a\u0456 \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0435, \u043d\u0435 \u0434\u0430\u0441\u0446\u044c \u043d\u0430\u043c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456? \u042f\u043a \u0436\u0430 \u043d\u0435 \u0434\u0430\u0441\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0439 \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b \u0441\u0432\u044f\u0442\u044b\u0445, \u043a\u0430\u043b\u0456 \u0441\u0430\u043c, \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u044b, \u043f\u0430\u043d\u0451\u0441 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0437\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u044b\u0445?<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u0432\u044b\u0437\u043d\u0430\u0435\u043c \u0437 \u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043d\u043d\u0435\u043c \u0456 \u043d\u0430\u0432\u0430\u0442 \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u043c, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0431\u044b\u045e \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0437\u0430 \u043d\u0430\u0441. \u0421\u043a\u0430\u0436\u0430\u043c \u0433\u044d\u0442\u0430 \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0443, \u0430\u043b\u0435 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0431\u0435\u0437 \u0441\u043e\u0440\u0430\u043c\u0443, \u0430\u043b\u0435 \u0437 \u0433\u043e\u043d\u0430\u0440\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u045e\u0432\u0430\u0436\u044b\u045e \u0433\u044d\u0442\u0443\u044e \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0443 \u0434\u043b\u044f \u0433\u043e\u043d\u0430\u0440\u0443 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b \u0456 \u043f\u0430\u0440\u0430\u0456\u045e \u0443\u0441\u0456\u043c \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0433\u044d\u0442\u044b\u043c. \u041c\u0430\u044e\u0447\u044b \u0448\u043c\u0430\u0442 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0456 \u0431\u043e\u0441\u043a\u0430\u0433\u0430, \u0448\u0442\u043e \u043c\u043e\u0433 \u0437\u0433\u0430\u0434\u0430\u0446\u044c \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0451\u043d \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0446\u0443\u0434\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456, \u0431\u0443\u0434\u0443\u0447\u044b \u0440\u043e\u045e\u043d\u044b\u043c \u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443, \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0441\u0432\u0435\u0442, \u0430 \u0431\u0443\u0434\u0443\u0447\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0441\u0432\u0435\u0442\u0430\u043c. \u041d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430: &laquo;\u041d\u044f\u0445\u0430\u0439 \u044f \u043d\u0435 \u0431\u0443\u0434\u0443 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0456\u0447\u044b\u043c, \u0430\u043a\u0440\u0430\u043c\u044f \u043a\u0440\u044b\u0436\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430&raquo; (\u0413\u0430\u043b 6, 14).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u043c\u0441\u044f \u0422\u0432\u0430\u0439\u043c\u0443 \u043a\u0440\u044b\u0436\u0443, \u041f\u0430\u043d\u0435; \u0443\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435\u043c \u0422\u0432\u0430\u044e \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0443\u044e \u043c\u0443\u043a\u0443. <span style=\"color: #ff0000;\">*<\/span> \u0417\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u0431\u043e \u0422\u044b \u0437\u0430 \u043d\u0430\u0441 \u0446\u044f\u0440\u043f\u0435\u045e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0433\u0430\u043c, \u044f\u043a\u0456\u0445 \u0422\u044b \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0439\u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u0431\u043e \u0422\u044b \u0437\u0430 \u043d\u0430\u0441 \u0446\u044f\u0440\u043f\u0435\u045e.<\/p>\r\n"}, {"GCH_CH_2_ID":"563","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0432\u043e\u0440 &laquo;\u041f\u0440\u0430 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430&raquo; \u0441\u0432. \u0411\u0430\u0437\u044b\u043b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 15, 35: PG 32, 127-130)<\/span><br \/><span style=\"color: #ff0000;\">\u0410\u0434\u043d\u0430 \u0451\u0441\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c \u0437\u0430 \u0441\u0432\u0435\u0442 \u0456 \u0430\u0434\u043d\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u043b\u0430\u043d \u043d\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u043f\u0430\u0434\u043d\u044f\u0446\u044c \u0437 \u0443\u043f\u0430\u0434\u043a\u0443 \u0456 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u044f\u0433\u043e \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c, \u044f\u043a\u043e\u0435 \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u043f\u0440\u0430\u0437 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c. \u0417 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u0446\u0435\u043b\u0435, \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u044f \u0444\u043e\u0440\u043c\u044b \u042f\u0433\u043e \u0437\u043d\u043e\u0441\u0456\u043d \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u043d\u044f\u0434\u043e\u043b\u044f, \u043a\u0440\u044b\u0436, \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435, \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u043c\u0435\u043b\u0456 \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0440\u0430\u0437 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u0432\u044f\u0440\u043d\u0443\u045e \u0434\u0430\u045e\u043d\u044f\u0435 \u0441\u044b\u043d\u043e\u045e\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043b\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u0445, \u044f\u043a\u0456\u044f \u0401\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e, \u043f\u0430\u043a\u043e\u0440\u0430\u0439 \u0456 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0430\u043b\u0435 \u0456 \u045e \u0441\u043c\u0435\u0440\u0446\u0456 \u042f\u0433\u043e\u043d\u0430\u0439, \u044f\u043a \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, \u043f\u0435\u0440\u0430\u0439\u043c\u0430\u043b\u044c\u043d\u0456\u043a \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430, \u0448\u0442\u043e, \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u044e\u0447\u044b\u0441\u044f \u0434\u0430 \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456, \u043c\u043e\u0436\u043d\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 (\u043f\u0430\u0440. \u0424\u043b\u043f 3, 11).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u044f\u043a \u0436\u0430 \u043d\u0430\u043c \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u0446\u0446\u0430 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u0430? \u041c\u044b \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443 \u0445\u0440\u043e\u0441\u0446\u0435. \u0414\u044b\u043a \u0448\u0442\u043e \u0436 \u0433\u044d\u0442\u0430 \u0437\u0430 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0456 \u044f\u043a\u0456 \u043f\u043b\u0451\u043d \u0442\u0430\u043a\u043e\u0433\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f? \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0442\u0440\u044d\u0431\u0430 \u043f\u0435\u0440\u0430\u0440\u0432\u0430\u0446\u044c \u0445\u0430\u0434\u0443 \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0410\u0434\u043d\u0430\u043a \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c, \u043a\u0430\u043b\u0456, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u045e \u041f\u0430\u043d\u0430, \u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043d\u0430\u043d\u043e\u0432\u0430, \u0431\u043e \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435, \u044f\u043a \u0431\u0430\u0447\u043d\u0430 \u0437 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u043b\u043e\u0432\u0430, &ndash; \u0433\u044d\u0442\u0430 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u043d\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0422\u0430\u043c\u0443 \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u043f\u0430\u0447\u043d\u0435\u0448 \u043d\u043e\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043a\u043b\u0430\u0441\u0446\u0456 \u043a\u0430\u043d\u0435\u0446 \u043c\u0456\u043d\u0443\u043b\u0430\u043c\u0443. \u042f\u043a \u043f\u0430\u0434\u0447\u0430\u0441 \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0446\u0442\u0432\u0430\u045e \u0434\u0430\u0431\u044f\u0433\u0430\u044e\u0446\u044c \u0434\u0430 \u0444\u0456\u043d\u0456\u0448\u0443 \u043d\u0430 \u0441\u0442\u0430\u0434\u044b\u0451\u043d\u0435 \u0456 \u0441\u043f\u044b\u043d\u044f\u044e\u0446\u0446\u0430 \u043d\u0430 \u043c\u043e\u043c\u0430\u043d\u0442, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u043f\u0430\u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u045e \u0430\u0434\u0432\u0430\u0440\u043e\u0442\u043d\u044b\u043c \u043d\u0430\u043f\u0440\u0430\u043c\u043a\u0443, \u0442\u0430\u043a \u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u043c \u0456 \u043f\u0440\u044b \u0437\u043c\u0435\u043d\u0435 \u0436\u044b\u0446\u0446\u044f, \u043a\u0430\u0431 \u043f\u0430\u043c\u0456\u0436 \u0441\u0442\u0430\u0440\u044b\u043c \u0456 \u043d\u043e\u0432\u044b\u043c \u0431\u044b\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u044f\u043a\u0430\u044f \u0437\u0430\u0432\u044f\u0440\u0448\u0430\u0435 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u044f\u0435 \u0456 \u0434\u0430\u0435 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u044f\u043a \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u0441\u044b\u0441\u0446\u0456 \u045e \u0430\u0434\u0445\u043b\u0430\u043d\u044c? \u041d\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0447\u044b \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442. \u0426\u0435\u043b\u044b \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u0445\u0440\u043e\u0441\u0442, \u0437\u0432\u0435\u0434\u0432\u0430\u044e\u0446\u044c \u044f\u043a \u0431\u044b \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u045e \u0432\u0430\u0434\u0437\u0435. \u0422\u0430\u043a\u0456\u043c \u0436\u0430 \u0447\u044b\u043d\u0430\u043c \u0445\u0440\u043e\u0441\u0442 \u0442\u0430\u0435\u043c\u043d\u0430 \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0443\u0435 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u0430\u045e \u0446\u0435\u043b\u0430, \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0430\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u0423 \u0406\u043c \u0432\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u044f \u043d\u0435\u0440\u0443\u043a\u0430\u0442\u0432\u043e\u0440\u043d\u044b\u043c \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435\u043c, \u043a\u0430\u043b\u0456 \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430 \u0437\u043d\u044f\u043b\u043e \u0437 \u0432\u0430\u0441 \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0430\u0441\u0446\u044c \u0446\u0435\u043b\u0430. \u0412\u044b \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u0445\u0440\u043e\u0441\u0446\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c&raquo; (\u041a\u043b\u0441 2, 11). \u0410 \u0445\u0440\u043e\u0441\u0442 \u043f\u044d\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u0434\u0443\u0448\u0443 \u0430\u0434 \u0431\u0440\u0443\u0434\u0443, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u044c \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0446\u0435\u043b\u0430, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0410\u0431\u043c\u044b\u0439 \u043c\u044f\u043d\u0435, &ndash; \u0456 \u0441\u0442\u0430\u043d\u0443 \u0431\u044f\u043b\u0435\u0439\u0448\u044b \u0437\u0430 \u0441\u043d\u0435\u0433&raquo; (\u041f\u0441 51 [50], 9). \u0417 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043c\u044b \u0432\u0435\u0434\u0430\u0435\u043c \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u0437\u0456\u043d \u0445\u0440\u043e\u0441\u0442, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0431\u043e \u0430\u0434\u043d\u0430 \u0451\u0441\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c \u0437\u0430 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0435\u0442\u0443 \u0456 \u0430\u0434\u043d\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0441\u0456\u043c\u0432\u0430\u043b\u0430\u043c \u0447\u0430\u0433\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0445\u0440\u043e\u0441\u0442.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 6, 3. 5. 4\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0435 \u043c\u044b, \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u044f \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0441\u043c\u0435\u0440\u0446\u044c \u042f\u0433\u043e\u043d\u0443\u044e \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u043b\u0456\u0441\u044f. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u043b\u0456 \u043c\u044b \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u0437 \u0406\u043c \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u0441\u043c\u0435\u0440\u0446\u0456 \u042f\u0433\u043e\u043d\u0430\u0439, \u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u044b \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0445\u0440\u044b\u0448\u0447\u044d\u043d\u043d\u0435\u043c \u0443 \u0441\u043c\u0435\u0440\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u043c\u044b \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u0437 \u0406\u043c \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u0441\u043c\u0435\u0440\u0446\u0456 \u042f\u0433\u043e\u043d\u0430\u0439, \u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"564","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 84, 1-2: CCL 36, 536-538)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u045e\u043d\u0430\u0442\u0430 \u043b\u044e\u0431\u043e\u0432\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043f\u0430\u045e\u043d\u0430\u0442\u0443 \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u043e\u0439 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u0433\u043e, \u041f\u0430\u043d \u0430\u043a\u0440\u044d\u0441\u043b\u0456\u045e \u0442\u0430\u043a\u0456\u043c \u0441\u043b\u043e\u0432\u0430\u043c\u0456: &laquo;\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0437\u0430 \u0442\u0443\u044e, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0430\u0434\u0434\u0430\u0435 \u0437\u0430 \u0441\u044f\u0431\u0440\u043e\u045e \u0441\u0432\u0430\u0456\u0445&raquo; (\u042f\u043d 15, 13). \u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u044d\u043d\u043d\u044f \u0441\u0432. \u042f\u043d \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442 \u0440\u043e\u0431\u0456\u0446\u044c \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0443\u044e \u0432\u044b\u0441\u043d\u043e\u0432\u0443 \u045e \u0441\u0432\u0430\u0456\u043c \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456: &laquo;\u042f\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u0434\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451, \u0442\u0430\u043a \u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0431\u0440\u0430\u0442\u043e\u045e&raquo; (\u043f\u0430\u0440. 1 \u042f\u043d 3, 16), \u043b\u044e\u0431\u044f\u0447\u044b \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u0433\u043e \u0442\u0430\u043a, \u044f\u043a \u0401\u043d \u043d\u0430\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e, \u0430\u0434\u0434\u0430\u045e\u0448\u044b \u0437\u0430 \u043d\u0430\u0441 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u043c\u044b \u0447\u044b\u0442\u0430\u0435\u043c \u0433\u044d\u0442\u0430 \u045e \u043a\u043d\u0456\u0437\u0435 \u041f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044f\u045e \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0441\u044f\u0434\u0437\u0435\u0448 \u0437\u0430 \u0441\u0442\u043e\u043b \u0437 \u0443\u043b\u0430\u0434\u0430\u0440\u043e\u043c, \u043f\u0456\u043b\u044c\u043d\u0430 \u0433\u043b\u044f\u0434\u0437\u0456, \u0448\u0442\u043e \u0442\u0430\u0431\u0435 \u0434\u0430\u044e\u0446\u044c, \u0456, \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u044e\u0447\u044b \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e, \u0432\u0435\u0434\u0430\u0439, \u0448\u0442\u043e \u0456 \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0442\u0430\u043a\u043e\u0435 \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u0446\u044c&raquo; (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 23, 1-2). \u0410 \u0448\u0442\u043e \u0436 \u0442\u0430\u043a\u043e\u0435 \u0441\u0442\u043e\u043b \u0443\u043b\u0430\u0434\u0430\u0440\u0430? \u0413\u044d\u0442\u0430 \u0441\u0442\u043e\u043b, \u0437 \u044f\u043a\u043e\u0433\u0430 \u0431\u044f\u0440\u043e\u043c \u0426\u0435\u043b\u0430 \u0456 \u041a\u0440\u043e\u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0430\u0434\u0434\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451. \u0428\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0441\u044f\u0434\u0437\u0435\u0446\u044c \u0437\u0430 \u0433\u044d\u0442\u044b\u043c \u0441\u0442\u0430\u043b\u043e\u043c? \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0437 \u043f\u0430\u043a\u043e\u0440\u0430\u0439 \u043f\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u044f\u0433\u043e. \u0428\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043f\u0456\u043b\u044c\u043d\u0430 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0441\u0442\u0440\u0430\u0432\u044b, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u0432\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e? \u0413\u043e\u0434\u043d\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043f\u0440\u0430 \u0442\u0430\u043a\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043b\u0430\u0441\u043a\u0443. \u0428\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0446\u044c \u0440\u0443\u043a\u0443 \u0456 \u0432\u0435\u0434\u0430\u0446\u044c, \u0448\u0442\u043e \u0434\u0430\u0432\u044f\u0434\u0437\u0435\u0446\u0446\u0430 \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0442\u0430\u043a\u0456\u044f \u0436 \u0441\u0442\u0440\u0430\u0432\u044b? \u042f\u043a \u044f \u045e\u0436\u043e \u0441\u043a\u0430\u0437\u0430\u045e, \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0431\u0440\u0430\u0442\u043e\u045e, \u044f\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u0434\u0430\u045e \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u043d\u0430\u0441. \u0413\u044d\u0442\u0430 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0451\u0442\u0440: &laquo;\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0446\u044f\u0440\u043f\u0435\u045e \u0437\u0430 \u0432\u0430\u0441, \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u0432\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u043a\u0430\u0431 \u0432\u044b \u0456\u0448\u043b\u0456 \u0441\u043b\u0435\u0434\u0430\u043c \u0437\u0430 \u0406\u043c&raquo; (1 \u041f 2, 21). \u0413\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0442\u0430\u043a\u0456\u044f \u0441\u0430\u043c\u044b\u044f \u0441\u0442\u0440\u0430\u0432\u044b. \u0413\u044d\u0442\u0430\u043a \u0440\u0430\u0431\u0456\u043b\u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u043f\u0430\u043b\u0430\u043b\u0456 \u0433\u0430\u0440\u0430\u0447\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e. \u041a\u0430\u043b\u0456 \u043c\u044b \u043d\u0435 \u0434\u0430\u0440\u044d\u043c\u043d\u0430 \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435\u043c \u0456\u0445 \u043f\u0430\u043c\u044f\u0446\u044c, \u0442\u043e, \u043f\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0434\u0430 \u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u045e\u0434\u0437\u0435\u043b \u0443 \u0433\u0430\u0441\u0446\u0456\u043d\u0435, \u044f\u043a\u043e\u0439 \u043d\u0430\u0441\u044b\u0447\u0430\u043b\u0456\u0441\u044f \u0456 \u044f\u043d\u044b, \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043d\u0430 \u045e\u0437\u043e\u0440 \u0456\u0445 \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0437\u0430 \u0441\u0442\u0430\u043b\u043e\u043c \u041f\u0430\u043d\u0430 \u043c\u044b \u043d\u0435 \u0437\u0433\u0430\u0434\u0432\u0430\u0435\u043c \u0456\u0445 \u044f\u043a \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0435 \u045e \u0441\u043f\u0430\u043a\u043e\u0456. \u041c\u044b \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0437\u0430 \u0456\u0445, \u0430 \u044f\u043d\u044b \u043c\u043e\u043b\u044f\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441, \u043a\u0430\u0431 \u043c\u044b \u0431\u044b\u043b\u0456 \u0456\u0445 \u043f\u0430\u0441\u043b\u044f\u0434\u043e\u045e\u043d\u0456\u043a\u0430\u043c\u0456. \u042f\u043d\u044b \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0456 \u043d\u0430\u0439\u0432\u044f\u043b\u0456\u043a\u0448\u0443\u044e, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u045e \u041f\u0430\u043d\u0430, \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u045e\u0434\u0437\u044f\u043b\u0456\u043b\u0456 \u0441\u0432\u0430\u0456\u043c \u0431\u0440\u0430\u0442\u0430\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u0430\u043c\u0456 \u045e\u0437\u044f\u043b\u0456 \u0441\u0430 \u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430, \u0448\u0442\u043e \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u0441\u0442\u0430\u0446\u044c \u0440\u043e\u045e\u043d\u044b\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0443 \u041f\u0430\u043d\u0443, \u043a\u0430\u043b\u0456 \u0434\u043e\u0439\u0434\u0437\u0435\u043c \u0434\u0437\u0435\u043b\u044f \u042f\u0433\u043e \u0434\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u043a\u0430\u0439 \u043a\u0440\u044b\u0432\u0456. \u0401\u043d \u043c\u0435\u045e \u0443\u043b\u0430\u0434\u0443 \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0456 \u043c\u0435\u045e \u0443\u043b\u0430\u0434\u0443 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u044f\u0433\u043e \u043d\u0430\u0437\u0430\u0434. \u0410 \u043c\u044b \u0456 \u043d\u0435 \u0436\u044b\u0432\u0435\u043c \u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u043a\u043e\u043b\u044c\u043a\u0456 \u0431 \u0445\u0430\u0446\u0435\u043b\u0456, \u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u0435\u043c, \u0445\u043e\u0446\u044c \u043d\u0435 \u0445\u043e\u0447\u0430\u043c. \u0401\u043d, \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b, \u0430\u0434\u0440\u0430\u0437\u0443 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0443 \u0441\u0430\u0431\u0435 \u0441\u043c\u0435\u0440\u0446\u044c, \u0430 \u043c\u044b \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435\u043c\u0441\u044f \u0430\u0434 \u043d\u0430\u0448\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456. \u042f\u0433\u043e \u0446\u0435\u043b\u0430 \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u043b\u0430 \u0442\u043b\u0435\u043d\u043d\u044f, \u0430 \u043d\u0430\u0448\u0430 &ndash; \u043f\u0430\u0441\u043b\u044f \u0442\u043b\u0435\u043d\u043d\u044f \u045e \u043a\u0430\u043d\u0446\u044b \u0432\u044f\u043a\u043e\u045e \u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c. \u0401\u043d \u043d\u0435 \u043c\u0435\u045e \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u045e \u043d\u0430\u0448\u0430\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435, \u043a\u0430\u0431 \u043d\u0430\u0441 \u0437\u0431\u0430\u0432\u0456\u0446\u044c, \u0430 \u043c\u044b \u0431\u0435\u0437 \u042f\u0433\u043e \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430. \u0401\u043d \u0441\u0442\u0430\u045e \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0430\u043c \u0434\u043b\u044f \u043d\u0430\u0441, \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u044b\u0445 \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0430\u045e, \u0431\u043e \u043f\u0430-\u0437\u0430 \u0406\u043c \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043c\u0435\u0446\u044c \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0431\u0440\u0430\u0442\u044b \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0446\u044c \u0437\u0430 \u0431\u0440\u0430\u0442\u043e\u045e, \u0430\u0434\u043d\u0430\u043a \u0456\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u043a\u0430\u044f \u043a\u0440\u043e\u045e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u043f\u0440\u0430\u043b\u0456\u0442\u0430\u044f \u0434\u0437\u0435\u043b\u044f \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u044f \u0433\u0440\u0430\u0445\u043e\u045e, \u0448\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u0415\u0437\u0443\u0441. \u0401\u043d \u0443\u0434\u0437\u044f\u043b\u0456\u045e \u043d\u0430\u043c \u0433\u044d\u0442\u0443\u044e \u043b\u0430\u0441\u043a\u0443 \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043c\u044b \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043b\u0456 \u044f\u0435, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0451\u0439. \u041c\u0443\u0447\u0430\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u043b\u0456\u043b\u0456 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0437\u0430 \u0431\u0440\u0430\u0442\u043e\u045e, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u0442\u044b\u044f \u0436 \u0430\u0445\u0432\u044f\u0440\u044b, \u044f\u043a\u0456\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0441\u0430 \u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u043d\u0430. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u0430\u0434\u0434\u0430\u045e\u0448\u044b \u0441\u044f\u0431\u0435 \u0437\u0430 \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 4, 9. 11. 10b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041b\u044e\u0431\u043e\u045e \u0411\u043e\u0433\u0430 \u0434\u0430 \u043d\u0430\u0441 \u0430\u0434\u043a\u0440\u044b\u043b\u0430\u0441\u044f \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u0443 \u0441\u0432\u0435\u0442 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430, \u043a\u0430\u0431 \u043c\u044b \u0436\u044b\u043b\u0456 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0442\u0430\u043a \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u0434\u044b\u043a \u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0442\u0430\u043a \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u0434\u044b\u043a \u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"565","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u044f \u0433\u0430\u043c\u0456\u043b\u0456\u044f&raquo; \u041c\u044d\u043b\u0456\u0442\u043e\u043d\u0430 \u0421\u0430\u0440\u0434\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 65-71: SC 123, 95-101)<\/span><br \/><span style=\"color: #ff0000;\">\u0410\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u043d\u0430\u0441 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u043b\u044f \u0436\u044b\u0446\u0446\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0440\u043e\u043a\u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u0448\u043c\u0430\u0442 \u043f\u0440\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u041f\u0430\u0441\u0445\u0456, \u044f\u043a\u043e\u044e \u0451\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441, &laquo;\u044f\u043a\u043e\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e, \u0430\u043c\u044d\u043d&raquo; (\u0413\u0430\u043b 1, 5 \u0456 \u043d\u0430\u0441\u0442.). \u0401\u043d \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u0437 \u043d\u0435\u0431\u0430 \u0434\u0437\u0435\u043b\u044f \u0446\u0435\u0440\u043f\u044f\u0447\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043f\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u045e \u044f\u0433\u043e \u0446\u0435\u043b\u0430 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0414\u0437\u0435\u0432\u044b \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u0420\u0430\u0437\u0430\u043c \u0437 \u0446\u0435\u043b\u0430\u043c, \u043f\u0430\u0434\u043b\u0435\u0433\u043b\u044b\u043c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044e, \u043f\u0440\u044b\u043d\u044f\u045e \u043f\u0430\u043a\u0443\u0442\u044b \u0446\u0435\u0440\u043f\u044f\u0447\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0456\u0445, \u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0414\u0443\u0445\u0430\u043c \u0437\u0430\u0431\u0456\u045e \u0441\u043c\u0435\u0440\u0446\u044c &ndash; \u0437\u0430\u0431\u043e\u0439\u0446\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u042f\u0433\u043e \u043f\u0430\u0432\u044f\u043b\u0456 \u043d\u0430 \u0437\u0430\u0431\u043e\u0439, \u044f\u043a \u044f\u0433\u043d\u044f, \u0456 \u0437\u0430\u0431\u0456\u043b\u0456, \u044f\u043a \u0430\u0432\u0435\u0447\u043a\u0443, \u0401\u043d \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u043d\u0430\u0441, \u0431\u044b\u0446\u0446\u0430\u043c \u0430\u0434 \u0415\u0433\u0456\u043f\u0442\u0430, \u0430\u0434 \u043a\u0443\u043b\u044c\u0442\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0430\u0434 \u0440\u0430\u0431\u0441\u0442\u0432\u0430 \u0434&rsquo;\u044f\u0431\u043b\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0430\u0434 \u0440\u0443\u043a\u0456 \u0444\u0430\u0440\u0430\u043e\u043d\u0430. \u041f\u0430\u0437\u043d\u0430\u0447\u044b\u045e \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b \u043f\u044f\u0447\u0430\u0442\u043a\u0430\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430, \u0430 \u0447\u0430\u0441\u0442\u043a\u0456 \u0446\u0435\u043b\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 &ndash; \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0441\u0430\u0440\u043e\u043c\u0456\u045e \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0443 \u0440\u043e\u0441\u043f\u0430\u0447\u044b \u0434&rsquo;\u044f\u0431\u043b\u0430, \u044f\u043a \u041c\u0430\u0439\u0441\u0435\u0439 \u0444\u0430\u0440\u0430\u043e\u043d\u0430. \u0401\u043d \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u043a\u0430\u0440\u044b\u045e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u0439, \u044f\u043a \u041c\u0430\u0439\u0441\u0435\u0439 \u0415\u0433\u0456\u043f\u0435\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u0440\u0432\u0430\u045e \u043d\u0430\u0441 \u0437 \u043d\u044f\u0432\u043e\u043b\u0456 \u0434\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u044b, \u0441\u0430 \u0437\u043c\u0440\u043e\u043a\u0443 \u0434\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u0441\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f, \u0437 \u0442\u044b\u0440\u0430\u043d\u0456\u0456 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0430\u0441 \u043d\u043e\u0432\u044b\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0456 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u043d\u0430\u0432\u0435\u043a\u0456. \u0401\u043d &ndash; \u041f\u0430\u0441\u0445\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0442\u043e\u0439, \u0445\u0442\u043e \u045e \u043c\u043d\u043e\u0433\u0456\u0445 \u043c\u043d\u043e\u0433\u0430\u0435 \u0441\u0446\u044f\u0440\u043f\u0435\u045e. \u0401\u043d \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b \u045e \u0410\u0431\u044d\u043b\u0456, \u0443 \u0406\u0441\u0430\u0430\u043a\u0443 \u042f\u043c\u0443 \u0437\u0432\u044f\u0437\u0430\u043b\u0456 \u043d\u043e\u0433\u0456, \u0443 \u042f\u043a\u0443\u0431\u0435 \u0401\u043d \u0432\u0430\u043d\u0434\u0440\u0430\u0432\u0430\u045e, \u0443 \u042e\u0437\u0430\u0444\u0435 \u042f\u0433\u043e \u043f\u0440\u0430\u0434\u0430\u043b\u0456, \u0443 \u041c\u0430\u0439\u0441\u0435\u044e \u042f\u0433\u043e \u043f\u0430\u0434\u043a\u0456\u043d\u0443\u043b\u0456, \u0401\u043d \u0431\u044b\u045e \u0437\u0430\u0440\u044d\u0437\u0430\u043d\u044b \u045e \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u044b\u043c \u044f\u0433\u043d\u044f\u0446\u0456, \u0443 \u0414\u0430\u0432\u0456\u0434\u0437\u0435 \u0437\u0432\u0435\u0434\u0432\u0430\u045e \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434, \u0443 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u0445 \u042f\u0433\u043e \u0437\u043d\u0435\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u044b\u045e \u0443\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0414\u0437\u0435\u0432\u044b, \u0443\u0437\u043d\u0435\u0441\u0435\u043d\u044b \u043d\u0430 \u0434\u0440\u044d\u0432\u0435 \u043a\u0440\u044b\u0436\u0430, \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b \u045e \u0437\u044f\u043c\u043b\u0456 \u0456, \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u0448\u044b \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u043d\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0432\u044b\u0441\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0431\u0435\u0437\u0433\u0430\u043b\u043e\u0441\u044b \u0411\u0430\u0440\u0430\u043d\u0430\u043a, \u0401\u043d \u0437\u0430\u0431\u0456\u0442\u044b \u0430\u0445\u0432\u044f\u0440\u043d\u044b \u0411\u0430\u0440\u0430\u043d\u0430\u043a, \u0401\u043d \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0430\u0434 \u041c\u0430\u0440\u044b\u0456, \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0439 \u0430\u0432\u0435\u0447\u043a\u0456. \u042f\u0433\u043e \u045e\u0437\u044f\u043b\u0456 \u0441\u0430 \u0441\u0442\u0430\u0442\u043a\u0443 \u0456 \u043f\u0430\u0432\u044f\u043b\u0456 \u043d\u0430 \u0437\u0430\u0431\u043e\u0439, \u0430 \u0432\u0435\u0447\u0430\u0440\u0430\u043c \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0456 \u043f\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u045e\u043d\u0430\u0447\u044b. \u042f\u043c\u0443 \u043d\u0435 \u043b\u0430\u043c\u0430\u043b\u0456 \u043a\u0430\u0441\u0446\u0435\u0439 \u043d\u0430 \u0434\u0440\u044d\u0432\u0435 \u043a\u0440\u044b\u0436\u0430, \u0401\u043d \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u045e \u0442\u043b\u0435\u043d\u043d\u044f \u045e \u0437\u044f\u043c\u043b\u0456, \u0430\u043b\u0435 \u045e\u0441\u0442\u0430\u045e \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0432\u044b\u0432\u043e\u0434\u0437\u044f\u0447\u044b \u044f\u0433\u043e \u0437 \u043c\u0430\u0433\u0456\u043b\u044b \u0430\u0434\u0445\u043b\u0430\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 3, 23-25\u0430; \u042f\u043d 1, 29b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0441\u043b\u0430\u0432\u044b \u0411\u043e\u0436\u0430\u0439, \u0430\u043b\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u0435 \u0434\u0430\u0440\u043c\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043b\u0430\u0441\u043a\u0456 \u042f\u0433\u043e\u043d\u0430\u0439, \u043f\u0440\u0430\u0437 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435. <span style=\"color: #ff0000;\">*<\/span> \u042f\u0433\u043e \u0411\u043e\u0433 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0443 \u043c\u043e\u0446\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0441\u044c \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0431\u044f\u0440\u044d \u043d\u0430 \u0441\u044f\u0431\u0435 \u0433\u0440\u044d\u0445 \u0441\u0432\u0435\u0442\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u0433\u043e \u0411\u043e\u0433 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0443 \u043c\u043e\u0446\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"566","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u0442\u044d\u0445\u0435\u0437\u0430&raquo; \u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cat. 3, 13-19: SC 50, 174-177)<\/span><br \/><span style=\"color: #ff0000;\">\u041c\u043e\u0446 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043a\u0440\u044b\u0432\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0447\u0430\u0446\u0435 \u043f\u0430\u0447\u0443\u0446\u044c \u043f\u0440\u0430 \u043c\u043e\u0446 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043a\u0440\u044b\u0432\u0456? \u0422\u0430\u0434\u044b \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0456 \u045e\u0441\u043f\u043e\u043c\u043d\u0456\u043c \u044f\u0435 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0456 \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437, \u0433\u0430\u0440\u0442\u0430\u044e\u0447\u044b \u0441\u0442\u0430\u0440\u043e\u043d\u043a\u0456 \u0421\u0442\u0430\u0440\u043e\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0439\u0441\u0435\u0439 \u043a\u0430\u0436\u0430: &laquo;\u0417\u0430\u0431\u0456\u0446\u0435 \u0430\u0434\u043d\u0430\u0433\u0430\u0434\u043e\u0432\u0430\u0435 \u044f\u0433\u043d\u044f \u0456 \u043f\u0430\u043c\u0430\u0436\u0446\u0435 \u044f\u0433\u043e\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0432\u0443\u0448\u0430\u043a\u0456&raquo; (\u043f\u0430\u0440. \u0417\u044b\u0445 12, 1-14). \u0428\u0442\u043e \u0442\u044b \u043a\u0430\u0436\u0430\u0448, \u041c\u0430\u0439\u0441\u0435\u0439? \u0425\u0456\u0431\u0430 \u043a\u0440\u043e\u045e \u0430\u0432\u0435\u0447\u043a\u0456 \u043c\u043e\u0436\u0430 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430? \u041a\u0430\u043d\u0435\u0447\u043d\u0435, \u043c\u043e\u0436\u0430, \u0430\u043b\u0435 \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043a\u0440\u043e\u045e, \u0430 \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u044f\u043d\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0432\u043e\u0431\u0440\u0430\u0437 \u043a\u0440\u044b\u0432\u0456 \u041f\u0430\u043d\u0430. \u0411\u043e \u0456 \u0446\u044f\u043f\u0435\u0440 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044c \u043d\u0430\u0448\u043c\u0430\u0442 \u0445\u0443\u0442\u0447\u044d\u0439 \u0430\u0434\u0441\u0442\u0443\u043f\u0430\u0435, \u043a\u0430\u043b\u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u0443\u0436\u043e \u043d\u0435 \u0430\u043a\u0440\u043e\u043f\u043b\u0435\u043d\u044b\u044f \u043a\u0440\u044b\u0432\u0451\u044e \u0437\u0430\u0432\u0435\u0441\u044b, \u0430\u043b\u0435 \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u0443\u044e \u043a\u0440\u043e\u045e \u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0430 \u0432\u0443\u0441\u043d\u0430\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e &ndash; \u0437\u0430\u0432\u0435\u0441\u0430\u0445 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u0430\u0439 \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0447\u0430\u0446\u0435 \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430, \u0443 \u0447\u044b\u043c \u044f\u0448\u0447\u044d \u043c\u043e\u0446 \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u044b\u0432\u0456? \u042f \u0445\u0430\u0447\u0443, \u043a\u0430\u0431 \u0432\u044b \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u0435\u043b\u0456\u0441\u044f, \u0437 \u044f\u043a\u043e\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u044f\u043d\u0430 \u0432\u044b\u0446\u044f\u043a\u0430\u0435. \u042f\u043d\u0430 \u0432\u044b\u0446\u044f\u043a\u0430\u0435 \u043d\u0430\u0439\u043f\u0435\u0440\u0448 \u0437 \u0441\u0430\u043c\u043e\u0433\u0430 \u043a\u0440\u044b\u0436\u0430, \u0430 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u044f\u0435 &ndash; \u0431\u043e\u043a \u0425\u0440\u044b\u0441\u0442\u0430. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u043a\u0430\u0436\u0430, \u044f\u043a \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u0401\u043d \u044f\u0448\u0447\u044d \u0432\u0456\u0441\u0435\u045e \u043d\u0430 \u043a\u0440\u044b\u0436\u044b, \u043f\u0430\u0434\u044b\u0448\u043e\u045e \u0436\u0430\u045e\u043d\u0435\u0440 \u0456 \u043f\u0440\u0430\u0431\u0456\u045e \u042f\u043c\u0443 \u0434\u0437\u0456\u0434\u0430\u044e \u0431\u043e\u043a, \u0437 \u044f\u043a\u043e\u0433\u0430 \u0430\u0434\u0440\u0430\u0437\u0443 \u0432\u044b\u0446\u044f\u043a\u043b\u0430 \u0432\u0430\u0434\u0430 \u0456 \u043a\u0440\u043e\u045e. \u0412\u0430\u0434\u0430 \u0431\u044b\u043b\u0430 \u0441\u0456\u043c\u0432\u0430\u043b\u0430\u043c \u0445\u0440\u043e\u0441\u0442\u0443, \u0430 \u043a\u0440\u043e\u045e &ndash; \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0456. \u0416\u0430\u045e\u043d\u0435\u0440 \u043f\u0440\u0430\u0431\u0456\u045e \u0431\u043e\u043a \u0425\u0440\u044b\u0441\u0442\u0443 \u0456 \u0430\u0434\u043a\u0440\u044b\u045e \u0443\u0432\u0430\u0445\u043e\u0434 \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0430 \u044f \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0442\u0430\u043c \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0441\u043a\u0430\u0440\u0431 \u0456 \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e \u0440\u0430\u0434\u0443\u044e\u0441\u044f, \u0430\u0434\u0448\u0443\u043a\u0430\u045e\u0448\u044b \u0442\u0430\u043a\u043e\u0435 \u0432\u044f\u043b\u0456\u0437\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435. \u0422\u0430\u043a \u0430\u0434\u0431\u044b\u043b\u043e\u0441\u044f \u0437 \u0411\u0430\u0440\u0430\u043d\u043a\u0430\u043c: \u044e\u0434\u044d\u0456 \u0437\u0430\u0431\u0456\u043b\u0456 \u044f\u0433\u043e, \u0430 \u044f \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u044e\u0441\u044f \u043f\u043b\u0451\u043d\u0430\u043c \u0433\u044d\u0442\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u043f\u0440\u0430\u0431\u0456\u0442\u0430\u0433\u0430 \u0431\u043e\u043a\u0443 \u0432\u044b\u0446\u044f\u043a\u043b\u0430 \u0432\u0430\u0434\u0430 \u0456 \u043a\u0440\u043e\u045e (\u043f\u0430\u0440. \u042f\u043d 19, 34). \u041d\u0435 \u0445\u0430\u0447\u0443, \u043a\u0430\u0431 \u0432\u044b \u0442\u0430\u043a \u043b\u0451\u0433\u043a\u0430 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u043c\u0456\u043c\u0430 \u0442\u0430\u043a\u0456\u0445 \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0442\u0430\u044f\u043c\u043d\u0456\u0446, \u0442\u0430\u043c\u0443 \u0437\u0430\u043a\u0440\u0430\u043d\u0443 \u0430\u0434\u0437\u0456\u043d \u043c\u0456\u0441\u0442\u044b\u0447\u043d\u044b \u0456 \u045e\u043a\u0440\u044b\u0442\u044b \u0430\u0441\u043f\u0435\u043a\u0442. \u042f \u045e\u0436\u043e \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0432\u0430\u0434\u0430 \u0456 \u043a\u0440\u043e\u045e \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0441\u0456\u043c\u0432\u0430\u043b\u0430\u043c\u0456 \u0445\u0440\u043e\u0441\u0442\u0443 \u0456 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0456. \u0417 \u0433\u044d\u0442\u044b\u0445 \u0434\u0437\u0432\u044e\u0445 \u0442\u0430\u044f\u043c\u043d\u0456\u0446 \u0431\u044f\u0440\u044d \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u043f\u0440\u0430\u0437 \u043a\u0443\u043f\u0435\u043b\u044c \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0456 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442 \u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u044f\u043a\u0456\u044f \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0437 \u0431\u043e\u043a\u0443 \u0425\u0440\u044b\u0441\u0442\u0430. \u0417 \u0431\u043e\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0401\u043d \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a \u0437 \u0431\u043e\u043a\u0443 \u0410\u0434\u0430\u043c\u0430 \u045e\u0437\u043d\u0456\u043a\u043b\u0430 \u044f\u0433\u043e\u043d\u0430\u044f \u0436\u043e\u043d\u043a\u0430 \u0415\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, \u043c\u0430\u044e\u0447\u044b \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0431\u043e\u043a \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041c\u044b \u0437 \u042f\u0433\u043e \u0446\u0435\u043b\u0430 \u0456 \u0437 \u042f\u0433\u043e \u043a\u043e\u0441\u0442\u0430\u043a&raquo; (\u043f\u0430\u0440. \u042d\u0444 5, 3). \u042f\u043a \u0437 \u0431\u043e\u043a\u0443 \u0410\u0434\u0430\u043c\u0430 \u0411\u043e\u0433 \u0443\u0447\u044b\u043d\u0456\u045e \u0436\u0430\u043d\u0447\u044b\u043d\u0443, \u0442\u0430\u043a \u0456 \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u043a\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0434\u0430\u045e \u043d\u0430\u043c \u0432\u0430\u0434\u0443 \u0456 \u043a\u0440\u043e\u045e, \u0437 \u044f\u043a\u0456\u0445 \u043f\u0430\u045e\u0441\u0442\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b. \u0406 \u044f\u043a \u0411\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0415\u0432\u0443 \u0437 \u0431\u043e\u043a\u0443 \u0410\u0434\u0430\u043c\u0430, \u044f\u043a\u0456 \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u0437\u0430\u0441\u043d\u0443\u045e, \u0442\u0430\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u0432\u0430\u0434\u0443 \u0456 \u043a\u0440\u043e\u045e.<br \/>\u0411\u0430\u0447\u044b\u0446\u0435, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0430\u0440\u0443\u0447\u044b\u045e\u0441\u044f \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430\u0439, \u0431\u0430\u0447\u044b\u0446\u0435, \u044f\u043a\u0456\u043c \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0430\u043c \u0401\u043d \u043a\u043e\u0440\u043c\u0456\u0446\u044c \u043d\u0430\u0441? \u042f\u043a \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0434\u0437\u0456\u0446\u044f\u0446\u0456 \u0441\u043f\u044f\u0448\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u043a\u0430\u0440\u043c\u0456\u0446\u044c \u044f\u0433\u043e \u0441\u0432\u0430\u0456\u043c \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0456 \u043a\u0440\u044b\u0432\u0451\u044e, \u0442\u0430\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0430\u0434\u0440\u0430\u0434\u0437\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u041f 1, 18-19; \u042d\u0444 2, 18; 1 \u042f\u043d 1, 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0442\u043b\u0435\u043d\u043d\u044b\u043c \u0441\u0435\u0440\u0430\u0431\u0440\u043e\u043c \u0446\u0456 \u0437\u043e\u043b\u0430\u0442\u0430\u043c \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b \u0432\u044b \u0430\u0434 \u043c\u0430\u0440\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0430\u043b\u0435 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044e \u043a\u0440\u044b\u0432\u0451\u044e \u0425\u0440\u044b\u0441\u0442\u0430 \u044f\u043a \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0433\u0430 \u0456 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0411\u0430\u0440\u0430\u043d\u043a\u0430.<span style=\"color: #ff0000;\"> *<\/span> \u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u043c\u044b \u045e\u0441\u0435 \u043c\u0430\u0435\u043c \u0434\u043e\u0441\u0442\u0443\u043f \u0443 \u0430\u0434\u043d\u044b\u043c \u0414\u0443\u0445\u0443 \u0434\u0430 \u0410\u0439\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0440\u043e\u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u043d\u0430\u0441 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u043c\u044b \u045e\u0441\u0435 \u043c\u0430\u0435\u043c \u0434\u043e\u0441\u0442\u0443\u043f \u0443 \u0430\u0434\u043d\u044b\u043c \u0414\u0443\u0445\u0443 \u0434\u0430 \u0410\u0439\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"567","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0421\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u0430\u044f \u0433\u0430\u043c\u0456\u043b\u0456\u044f \u043d\u0430 \u0421\u0432\u044f\u0442\u0443\u044e \u0456 \u0412\u044f\u043b\u0456\u043a\u0443\u044e \u0441\u0443\u0431\u043e\u0442\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(PG 43, 439. 451. 462-463)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u044b\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 \u045e \u0430\u0434\u0445\u043b\u0430\u043d\u044c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f? \u0421\u0451\u043d\u043d\u044f \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u044f \u0446\u0456\u0448\u0430 \u0430\u0445\u0456\u043d\u0443\u043b\u0430 \u0437\u044f\u043c\u043b\u044e. \u0413\u043b\u044b\u0431\u043e\u043a\u0430\u044f \u0446\u0456\u0448\u0430 \u0456 \u043f\u0443\u0441\u0442\u044d\u0447\u0430. \u0413\u043b\u044b\u0431\u043e\u043a\u0430\u044f \u0446\u0456\u0448\u0430, \u0431\u043e \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0441\u043f\u0456\u0446\u044c. \u0417\u044f\u043c\u043b\u044f \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u043b\u0430\u0441\u044f \u0456 \u0441\u0446\u0456\u0445\u043b\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0437\u0430\u0441\u043d\u0443\u045e \u0443 \u0446\u0435\u043b\u0435 \u0456 \u0430\u0431\u0443\u0434\u0437\u0456\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0434\u0432\u0435\u043a\u0443 \u0441\u043f\u0430\u045e. \u0411\u043e\u0433 \u043f\u0430\u043c\u0451\u0440 \u0443 \u0446\u0435\u043b\u0435 \u0456 \u045e\u0437\u0440\u0443\u0448\u044b\u045e \u0430\u0434\u0445\u043b\u0430\u043d\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0456\u0434\u0437\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u0443\u044e \u0430\u0432\u0435\u0447\u043a\u0443; \u043d\u0430\u0432\u0435\u0434\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u0443 \u0437\u043c\u0440\u043e\u043a\u0443 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0446\u0435\u043d\u044e; \u043a\u0430\u0431 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u0430\u0434 \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430 \u0410\u0434\u0430\u043c\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u0446\u0430\u0439 \u0415\u0432\u0430\u0439 \u0456\u0434\u0437\u0435 \u0456\u0445 \u0411\u043e\u0433 \u0456 \u0421\u044b\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0456\u0434\u0437\u0435 \u0434\u0430 \u0456\u0445, \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u043d\u0443\u044e \u0437\u0431\u0440\u043e\u044e \u043a\u0440\u044b\u0436\u0430. \u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u0430\u0439\u0446\u0435\u0446 \u0410\u0434\u0430\u043c \u0443\u0431\u0430\u0447\u044b\u045e \u042f\u0433\u043e, \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e \u0434\u0430 \u045e\u0441\u0456\u0445, \u0431&rsquo;\u044e\u0447\u044b \u0441\u044f\u0431\u0435 \u045e \u0433\u0440\u0443\u0434\u0437\u0456 \u0430\u0434 \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u044f: &laquo;\u041c\u043e\u0439 \u041f\u0430\u043d \u0437 \u0443\u0441\u0456\u043c\u0456&raquo;. \u0406 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0410\u0434\u0430\u043c\u0443: &laquo;\u0406 \u0437 \u0434\u0443\u0445\u0430\u043c \u0442\u0432\u0430\u0456\u043c&raquo;. \u0423\u0437\u044f\u045e\u0448\u044b \u044f\u0433\u043e \u0437\u0430 \u0440\u0443\u043a\u0443, \u043f\u0430\u0434\u043d\u044f\u045e \u044f\u0433\u043e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0440\u0430\u0447\u043d\u0456\u0441\u044f, \u044f\u043a\u0456 \u0441\u043f\u0456\u0448, \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0456 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0441\u0432\u0435\u0442\u043b\u0456\u0446\u044c \u0446\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u044f\u043a\u0456 \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435 \u0441\u0442\u0430\u045e \u0442\u0432\u0430\u0456\u043c \u0441\u044b\u043d\u0430\u043c. \u0414\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435 \u0456 \u0434\u0437\u0435\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u0430\u0434 \u0446\u044f\u0431\u0435, \u042f \u043a\u0430\u0436\u0443 \u0446\u044f\u043f\u0435\u0440 \u0456 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u044e \u0441\u0432\u0430\u0451\u044e \u045e\u043b\u0430\u0434\u0430\u0439 \u0442\u044b\u043c, \u0448\u0442\u043e \u045e \u043a\u0430\u0439\u0434\u0430\u043d\u0430\u0445: \u0412\u044b\u0439\u0434\u0437\u0456\u0446\u0435; \u0442\u044b\u043c, \u0445\u0442\u043e \u045e \u0446\u0435\u043c\u0440\u044b: \u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u043c \u0437\u0430\u0437\u0437\u044f\u0435 \u0441\u0432\u044f\u0442\u043b\u043e; \u0442\u044b\u043c, \u0445\u0442\u043e \u0441\u043f\u0456\u0446\u044c: \u0423\u0441\u0442\u0430\u043d\u044c\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0431\u0435, \u0410\u0434\u0430\u043c, \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e: \u041f\u0440\u0430\u0447\u043d\u0456\u0441\u044f, \u044f\u043a\u0456 \u0441\u043f\u0456\u0448. \u042f \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0446\u044f\u0431\u0435 \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0442\u044b \u0441\u044f\u0434\u0437\u0435\u045e \u0441\u043a\u0430\u0432\u0430\u043d\u044b \u045e \u0430\u0434\u0445\u043b\u0430\u043d\u0456. \u0423\u0441\u0442\u0430\u043d\u044c \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445: \u042f &ndash; \u0436\u044b\u0446\u0446\u0451 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. \u0423\u0441\u0442\u0430\u043d\u044c, \u0441\u043f\u0440\u0430\u0432\u0430 \u041c\u0430\u0456\u0445 \u0440\u0443\u043a; \u0443\u0441\u0442\u0430\u043d\u044c, \u041c\u043e\u0439 \u0432\u043e\u0431\u0440\u0430\u0437, \u044f\u043a\u0456 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u043d\u0430 \u041c\u0430\u0451 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430. \u0423\u0441\u0442\u0430\u043d\u044c, \u0432\u044b\u0439\u0434\u0437\u0435\u043c \u0430\u0434\u0441\u044e\u043b\u044c, \u0431\u043e \u0442\u044b \u045e\u0432\u0430 \u041c\u043d\u0435, \u0430 \u042f \u045e \u0442\u0430\u0431\u0435, \u043c\u044b \u0430\u0434\u043d\u0430 \u043d\u0435\u043f\u0430\u0434\u0437\u0435\u043b\u044c\u043d\u0430\u044f \u0430\u0441\u043e\u0431\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435 \u042f, \u0442\u0432\u043e\u0439 \u0411\u043e\u0433, \u0441\u0442\u0430\u045e \u0442\u0432\u0430\u0456\u043c \u0441\u044b\u043d\u0430\u043c; \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435 \u042f, \u041f\u0430\u043d, \u043f\u0440\u044b\u043d\u044f\u045e \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456; \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435 \u042f, \u044f\u043a\u0456 \u043f\u0430-\u043d\u0430\u0434 \u043d\u0435\u0431\u0430\u043c, \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e \u0456 \u043f\u0430\u0434 \u0437\u044f\u043c\u043b\u044e; \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435, \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u042f \u0441\u0442\u0430\u045e \u044f\u043a \u0431\u0435\u0437\u0434\u0430\u043f\u0430\u043c\u043e\u0436\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0430\u043b\u0435 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b \u043c\u0456\u0436 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445; \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435, \u044f\u043a\u0456 \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0440\u0430\u0439\u0441\u043a\u0430\u0433\u0430 \u0441\u0430\u0434\u0443, \u042f \u0431\u044b\u045e \u0430\u0434\u0434\u0430\u0434\u0437\u0435\u043d\u044b \u044e\u0434\u044d\u044f\u043c \u0443 \u0430\u043bi\u045e\u043d\u044b\u043c \u0441\u0430\u0434\u0437\u0435 \u0456 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u045e \u0441\u0430\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u041c\u0430\u0451 \u0430\u043f\u043b\u044f\u0432\u0430\u043d\u0430\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u044f\u043a\u043e\u0435 \u042f \u043f\u0440\u044b\u043d\u044f\u045e \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u0442\u0430\u0431\u0435 \u0442\u0432\u043e\u0439 \u043f\u0435\u0440\u0448\u0430\u043f\u0430\u0447\u0430\u0442\u043a\u043e\u0432\u044b \u0434\u0443\u0445. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0441\u043b\u044f\u0434\u044b \u0430\u0434 \u0443\u0434\u0430\u0440\u0430\u045e \u043d\u0430 \u043c\u0430\u0456\u043c \u0442\u0432\u0430\u0440\u044b, \u044f\u043a\u0456\u044f \u042f \u0446\u044f\u0440\u043f\u0435\u045e, \u043a\u0430\u0431 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u041c\u043e\u0439 \u0432\u043e\u0431\u0440\u0430\u0437 \u0443 \u0442\u0432\u0430\u0456\u043c \u0437\u043d\u044f\u0432\u0435\u0447\u0430\u043d\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u043c\u0430\u044e \u0441\u043f\u0456\u043d\u0443, \u0437\u0440\u0430\u043d\u0435\u043d\u0443\u044e \u0431\u0456\u0447\u0430\u0432\u0430\u043d\u043d\u0435\u043c, \u044f\u043a\u043e\u0435 \u042f \u0446\u044f\u0440\u043f\u0435\u045e, \u043a\u0430\u0431 \u0437\u043d\u044f\u0446\u044c \u0446\u044f\u0436\u0430\u0440 \u0442\u0432\u0430\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e, \u0443\u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430 \u0442\u0432\u0430\u044e \u0441\u043f\u0456\u043d\u0443. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u043c\u0430\u0435 \u0440\u0443\u043a\u0456, \u043c\u043e\u0446\u043d\u0430 \u043f\u0440\u044b\u0431\u0456\u0442\u044b\u044f \u0446\u0432\u0456\u043a\u0430\u043c\u0456 \u0434\u0430 \u0434\u0440\u044d\u0432\u0430 \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435, \u044f\u043a\u0456 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u045e \u0441\u0432\u0430\u0435 \u0440\u0443\u043a\u0456 \u0434\u0430 \u0434\u0440\u044d\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0441\u043f\u0430\u0447\u044b\u045e \u043d\u0430 \u043a\u0440\u044b\u0436\u044b, \u0456 \u043c\u0435\u0447 \u043f\u0440\u0430\u0446\u044f\u045e \u041c\u043e\u0439 \u0431\u043e\u043a \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435, \u044f\u043a\u0456 \u0437\u0430\u0441\u043d\u0443\u045e \u0443 \u0440\u0430\u0456 \u0456 \u0437 \u0431\u043e\u043a\u0443 \u044f\u043a\u043e\u0433\u0430 \u0431\u044b\u043b\u0430 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430 \u0415\u0432\u0430. \u041c\u043e\u0439 \u0431\u043e\u043a \u0430\u0437\u0434\u0430\u0440\u0430\u0432\u0456\u045e \u0431\u043e\u043b\u044c \u0442\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u043a\u0443. \u041c\u043e\u0439 \u0441\u043e\u043d \u0430\u0431\u0443\u0434\u0437\u0456\u045e \u0446\u044f\u0431\u0435 \u0430\u0434 \u0441\u043d\u0443 \u0430\u0434\u0445\u043b\u0430\u043d\u0456. \u041c\u043e\u0439 \u043c\u0435\u0447 \u0437\u043b\u0430\u043c\u0430\u045e \u043c\u0435\u0447, \u044f\u043a\u0456 \u0432\u044f\u0440\u0446\u0435\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0442\u0430\u043d\u044c, \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0430\u0434\u0441\u044e\u043b\u044c. \u0412\u043e\u0440\u0430\u0433 \u0432\u044b\u0432\u0435\u045e \u0446\u044f\u0431\u0435 \u0437 \u0440\u0430\u0439\u0441\u043a\u0430\u0439 \u0437\u044f\u043c\u043b\u0456. \u0410 \u042f \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0446\u044f\u0431\u0435 \u045e\u0436\u043e \u043d\u0435 \u045e \u0440\u0430\u0439, \u0430\u043b\u0435 \u043f\u0430\u0441\u0430\u0434\u0436\u0443 \u043d\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0442\u0440\u043e\u043d. \u0422\u0430\u0431\u0435 \u0437\u0430\u0431\u0430\u0440\u043e\u043d\u0435\u043d\u0430 \u0431\u044b\u043b\u043e \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0434\u0430 \u0434\u0440\u044d\u0432\u0430, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0436\u044b\u0446\u0446\u044f, \u0430 \u042f, \u0436\u044b\u0446\u0446\u0451, \u0437\u043b\u0443\u0447\u0430\u044e\u0441\u044f \u0437 \u0442\u0430\u0431\u043e\u0439. \u042f \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0445\u0435\u0440\u0443\u0431\u0456\u043c\u0430\u045e, \u044f\u043a\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u044f\u043a \u0441\u043b\u0443\u0433\u0456, \u0430 \u0446\u044f\u043f\u0435\u0440 \u0437\u0440\u0430\u0431\u043b\u044e, \u043a\u0430\u0431 \u0445\u0435\u0440\u0443\u0431\u0456\u043c\u044b \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u0442\u0430\u0431\u0435 \u044f\u043a \u0411\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0436\u043e \u0433\u0430\u0442\u043e\u0432\u044b \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0442\u0440\u043e\u043d, \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u0441\u043b\u0443\u0433\u0456, \u0430\u0431\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u043d\u0430 \u0432\u044f\u0441\u0435\u043b\u044c\u043d\u0430\u044f \u0437\u0430\u043b\u0430, \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b \u0441\u0442\u0440\u0430\u0432\u044b, \u0430\u0437\u0434\u043e\u0431\u043b\u0435\u043d\u044b \u0432\u0435\u0447\u043d\u044b\u044f \u0448\u0430\u0442\u0440\u044b \u0456 \u0441\u0432\u044f\u0442\u043b\u0456\u0446\u044b, \u0441\u043a\u0430\u0440\u0431\u044b \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e \u0430\u0434\u043a\u0440\u044b\u0442\u044b \u0456 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430\u0435 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u044b\u0448\u043e\u045e \u043d\u0430\u0448 \u041f\u0430\u0441\u0442\u044b\u0440, \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0432\u043e\u0439 \u0432\u0430\u0434\u044b, \u0430 \u043f\u0430\u0434\u0447\u0430\u0441 \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456 \u0437\u0430\u0446\u044c\u043c\u0456\u043b\u0430\u0441\u044f \u0441\u043e\u043d\u0446\u0430; \u0443 \u043f\u0430\u043b\u043e\u043d \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u045e \u0442\u043e\u0439, \u0445\u0442\u043e \u0442\u0440\u044b\u043c\u0430\u045e \u0443 \u043f\u0430\u043b\u043e\u043d\u0435 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0421\u0451\u043d\u043d\u044f \u043d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0431\u0440\u0430\u043c\u044b \u0441\u043c\u0435\u0440\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b\u043b\u0430\u043c\u0430\u045e \u0437\u0430\u0441\u043e\u0432\u044b \u0430\u0434\u0445\u043b\u0430\u043d\u0456 \u0456 \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u045e \u043c\u0430\u0433\u0443\u0446\u0446\u0456 \u0434&rsquo;\u044f\u0431\u043b\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0451\u043d\u043d\u044f \u043d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0431\u0440\u0430\u043c\u044b \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"601","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u0441\u0432. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430&raquo; \u0441\u0432. \u042f\u043d\u0430 \u0417\u0430\u043b\u0430\u0442\u0430\u0432\u0443\u0441\u043d\u0430\u0433\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 19, 1: PG 59, 120-121)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u044b \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u041c\u0435\u0441\u0456\u044e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043d\u0434\u0440\u044d\u0439 \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u045e \u0415\u0437\u0443\u0441\u0430 \u0456 \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f \u043f\u0440\u0430 \u043c\u043d\u043e\u0433\u0430\u0435 \u0430\u0434 \u042f\u0433\u043e, \u0430\u043b\u0435 \u043d\u0435 \u0437\u0430\u0442\u043e\u0456\u045e \u0441\u043a\u0430\u0440\u0431\u0443, \u0430 \u0441\u043f\u0435\u0448\u043d\u0430 \u043f\u0430\u0431\u0435\u0433 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0442\u0430, \u043a\u0430\u0431 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u044f\u0433\u043e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430. \u0417\u0432\u044f\u0440\u043d\u0456 \u045e\u0432\u0430\u0433\u0443 \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u0439\u043c\u0443 \u0431\u0440\u0430\u0442\u0443: &laquo;\u041c\u044b \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u041c\u0435\u0441\u0456\u044e (\u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430)&raquo; (\u042f\u043d 1, 41). \u0411\u0430\u0447\u044b\u0448, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0451\u043d \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0442\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f \u0437\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441? \u0417 \u0430\u0434\u043d\u0430\u0433\u043e \u0431\u043e\u043a\u0443 \u0410\u043d\u0434\u0440\u044d\u0439 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u043c\u043e\u0446, \u0437 \u044f\u043a\u043e\u044e \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e, \u0430 \u0437 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0431\u043e\u043a\u0443 \u0432\u044b\u044f\u045e\u043b\u044f\u0435 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0435 \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0435 \u0441\u0430\u043c\u0456\u0445 \u0432\u0443\u0447&shy;\u043d\u044f\u045e, \u044f\u043a\u0456\u044f \u0448\u0443\u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u045e\u0436\u043e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443. \u0421\u043b\u043e\u0432\u044b \u0410\u043d\u0434\u0440\u044d\u044f \u0441\u043a\u0430\u0437\u0430\u043d\u044b \u0430\u0434 \u0434\u0443\u0448\u044b, \u044f\u043a\u0430\u044f \u0433\u043e\u0440\u0430\u0447\u0430 \u0436\u0430\u0434\u0430\u043b\u0430 \u0437&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u041c\u0435\u0441\u0456\u0456, \u0447\u0430\u043a\u0430\u043b\u0430 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u0437 \u043d\u0435\u0431\u0430, \u0430 \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u0401\u043d \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f, \u043f\u0430\u0441\u043f\u044f\u0448\u0430\u043b\u0430\u0441\u044f \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0456\u043d\u0448\u044b\u043c. \u0421\u043b\u043e\u0432\u044b \u0410\u043d\u0434\u0440\u044d\u044f \u0431\u044b\u043b\u0456 \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u043a\u0430\u0439 \u043f\u0440\u044b&shy;\u0445\u0456\u043b\u044c&not;\u043d\u0430\u0441&shy;\u0446\u0456, \u0441\u0432\u0430\u044f\u0446\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0448\u0447\u044b\u0440\u0430\u0433\u0430 \u043f\u0430\u0447\u0443\u0446\u0446\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u043f\u0440\u0430\u0446\u044f\u0433\u043d\u0443\u0446\u044c \u0440\u0443\u043a\u0443 \u0431\u0440\u0430\u0442\u0430\u043c \u0443 \u0434\u0443\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0432\u044f\u0440\u043d\u0456 \u045e\u0432\u0430\u0433\u0443 \u0456 \u043d\u0430 \u0442\u043e\u0435, \u044f\u043a\u0456 \u043f\u0430\u043a\u043e\u0440\u043b\u0456\u0432\u044b \u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u0430\u0434 \u0441\u0430\u043c\u0430\u0433\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0434\u0443\u0445 \u041f\u044f\u0442\u0440\u0430. \u0401\u043d \u043f\u0440\u044b\u0431\u044f\u0433\u0430\u0435 \u0430\u0434\u0440\u0430\u0437\u0443 \u0431\u0435\u0437 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u043f\u0440\u0430\u043c\u0430\u0440\u0443\u0434\u0436\u0432\u0430\u043d\u043d\u044f. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0406 \u043f\u0440\u044b\u0432\u0451\u045e \u044f\u0433\u043e \u0434\u0430 \u0415\u0437\u0443\u0441\u0430&raquo; (\u042f\u043d 1, 42). \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u0435 \u041f\u044f\u0442\u0440\u0430 \u045e \u0434\u0430\u0432\u0435\u0440\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043c\u0430\u045e\u043b\u044f\u045e, \u0451\u043d, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043d\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b, \u043f\u0440\u044b\u043d\u044f\u045e \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0435. \u041d\u0430\u043f\u044d\u045e\u043d\u0430, \u0431\u0440\u0430\u0442 \u0443\u0441\u0451 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430 \u0456 \u0434\u044d\u0442\u0430\u043b\u0451\u0432\u0430 \u044f\u043c\u0443 \u0440\u0430\u0441\u043f\u0430\u0432\u0451\u045e, \u0431\u043e \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442\u044b \u0448\u043c\u0430\u0442 \u0448\u0442\u043e \u0441\u043a\u0430\u0440\u0430\u0447\u0430\u044e\u0446\u044c, \u0456\u043c\u043a\u043d\u0443\u0447\u044b\u0441\u044f \u0434\u0430 \u0441\u0446\u0456\u0441\u043b\u0430\u0441\u0446\u0456. \u0417\u0440\u044d\u0448\u0442\u044b, \u043d\u0435 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430, \u0448\u0442\u043e \u041f\u0451\u0442\u0440 \u0430\u0434\u0440\u0430\u0437\u0443 \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u0430\u043b\u0435 \u0448\u0442\u043e \u0410\u043d\u0434\u0440\u044d\u0439 \u043f\u0440\u044b\u0432\u0451\u045e \u044f\u0433\u043e \u0434\u0430 \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439 \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f \u043f\u0440\u0430 \u045e\u0441\u0451 \u0441\u0430\u043c. \u0420\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u0431\u044b\u045e \u044f\u0448\u0447\u044d \u0456\u043d\u0448\u044b \u0432\u0443\u0447\u0430\u043d\u044c, \u044f\u043a\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u042f\u043d \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044c \u0433\u0430\u0432\u0430\u0440\u044b\u045e: &laquo;\u0412\u043e\u0441\u044c \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0411\u043e\u0436\u044b&raquo; \u0456: &laquo;\u0412\u043e\u0441\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c&raquo; (\u043f\u0430\u0440. \u042f\u043d 1, 29. 33), \u0442\u043e \u0441\u043f\u0440\u0430\u0432\u0443 \u0432\u044b\u0441\u0432\u044f\u0442\u043b\u0435\u043d\u043d\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0451\u043d \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u0443. \u0413\u044d\u0442\u0430\u043a \u0436\u0430 \u0456 \u0410\u043d\u0434\u0440\u044d\u0439, \u044f\u043a\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u0441\u044f\u0431\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c \u0443\u0441\u0451 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c, \u0430\u043b\u0435 \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0434\u0430 \u0441\u0430\u043c\u043e\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0441\u0432\u044f\u0442\u043b\u0430 \u0431\u0440\u0430\u0442\u0430, \u044f\u043a\u0456, \u0443\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0448\u044b\u0441\u044f, \u0442\u0430\u043a \u043f\u0430\u0441\u043f\u044f\u0448\u0430\u045e\u0441\u044f, \u0448\u0442\u043e \u043d\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u045e \u043d\u0456 \u0445\u0432\u0456\u043b\u0456\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0441\u0432\u044f\u0442\u044b \u0410\u043d\u0434\u0440\u044d\u0439 \u043f\u0430\u0447\u0443\u045e \u0433\u043e\u043b\u0430\u0441 \u041f\u0430\u043d\u0430, \u0451\u043d \u0430\u0434\u0440\u0430\u0437\u0443 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0441\u0435\u0442\u043a\u0456, \u044f\u043a\u0456\u043c\u0456 \u0437\u0430\u0440\u0430\u0431\u043b\u044f\u045e \u0441\u0430\u0431\u0435 \u043d\u0430 \u0436\u044b\u0446\u0446\u0451, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0437\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0434\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0434\u0437\u0435\u043b\u044f \u042f\u0433\u043e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0451\u043d \u0446\u044f\u0440\u043f\u0435\u045e \u043c\u0443\u043a\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043f\u0430\u0439\u0448\u043e\u045e \u0437\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0434\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"602","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041b\u0456\u0441\u0442 \u0434\u0430 \u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f \u041b\u0430\u0451\u043b\u044b&raquo; \u0441\u0432. \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u043a\u0430 \u041a\u0441\u0430\u0432\u044d\u0440\u044b\u044f, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(E vita Francisci Xaver\u0456\u0456, auctore \u041d. Tursellini, <\/span><br \/><span style=\"color: #ff0000;\">Romae, 1956, Lib. 4, epist. 4 [1542] et 5 [1544])<\/span><br \/><em><span style=\"color: #ff0000;\">\u0413\u043e\u0440\u0430 \u043c\u043d\u0435, \u043a\u0430\u043b\u0456 \u044f \u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0430\u0431\u044b\u0448\u043b\u0456 \u0432\u0451\u0441\u043a\u0456 \u043d\u043e\u0432\u0430\u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u0445, \u044f\u043a\u0456\u044f \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u0433\u0430\u0434\u043e\u045e \u0442\u0430\u043c\u0443 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0441\u0432\u044f\u0442\u0443\u044e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0443\u044e \u0432\u0435\u0440\u0443. \u0413\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u043d\u0435 \u0430\u043f\u0440\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u043f\u0430\u0440\u0442\u0443\u0433\u0430\u043b\u044c\u0446\u044b, \u0431\u043e \u044f\u043d\u0430 \u0437\u0443\u0441\u0456\u043c \u043d\u0435\u045e\u0440\u0430\u0434\u043b\u0456\u0432\u0430\u044f \u0456 \u0431\u0435\u0434\u043d\u0430\u044f. \u0410 \u0442\u0443\u0442\u044d\u0439\u0448\u044b\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435, \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u044f \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u044f\u043d\u044b \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435. \u041d\u044f\u043c\u0430 \u043a\u0430\u043c\u0443 \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u043b\u044f \u0456\u0445 \u043d\u0430\u0431\u0430\u0436\u044d\u043d\u0441\u0442\u0432\u0430, \u043d\u044f\u043c\u0430 \u043a\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0456\u0445 \u0421\u0456\u043c\u0432\u0430\u043b\u0443 \u0432\u0435\u0440\u044b, \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u041f\u0430\u043d\u0441\u043a\u0430\u0439 \u0456 \u0410\u043d\u0451\u043b\u044c\u0441\u043a\u0430\u043c\u0443 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u044e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0411\u043e\u0436\u044b\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0447\u0430\u0441\u0443 \u043c\u0430\u0439\u0433\u043e \u043f\u0440\u044b\u0431\u044b\u0446\u0446\u044f \u0441\u044e\u0434\u044b \u044f \u043d\u0435 \u0441\u043f\u044b\u043d\u044f\u045e\u0441\u044f \u043d\u0456 \u043d\u0430 \u0445\u0432\u0456\u043b\u0456\u043d\u0443: \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0430\u0431\u044b\u0448\u043e\u045e \u0432\u0451\u0441\u043a\u0456, \u0443\u0441\u0456\u0445 \u044f\u0448\u0447\u044d \u043d\u0435\u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439 \u0430\u0431\u043c\u044b\u045e \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u0430\u0439 \u0432\u0430\u0434\u043e\u044e. \u0406 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u044f \u0430\u0447\u044b\u0441\u0446\u0456\u045e \u0432\u0435\u043b\u044c\u043c\u0456 \u0448\u043c\u0430\u0442 \u0434\u0437\u044f\u0446\u0435\u0439, \u044f\u043a\u0456\u044f, \u044f\u043a \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430, \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u044e\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0439 \u0440\u0443\u043a\u0456 \u0430\u0434 \u043b\u0435\u0432\u0430\u0439. \u0414\u0437\u0435\u0446\u0456 \u0436 \u043d\u0435 \u0434\u0430\u044e\u0446\u044c \u043c\u043d\u0435 \u043d\u0456 \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u0446\u044c \u0411\u043e\u0436\u044b \u0430\u0444\u0456\u0446\u044b\u0439, \u043d\u0456 \u043f\u0430\u0434&rsquo;\u0435\u0441\u0446\u0456, \u043d\u0456 \u0430\u0434\u043f\u0430\u0447\u044b\u0446\u044c, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043d\u0430\u0432\u0443\u0447\u0443 \u0456\u0445 \u0445\u043e\u0446\u044c \u044f\u043a\u043e\u0439&shy;\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043c\u0430\u043b\u0456\u0442\u0432\u0435. \u0422\u0443\u0442 \u044f \u043f\u0430\u0447\u044b\u043d\u0430\u044e \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0448\u0442\u043e \u0442\u0430\u043a\u0456\u043c \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0456\u0446\u044c \u0442\u0430\u043a\u0456\u044f \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u044f \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u0456 \u0431\u044b\u043b\u043e \u0431 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044e, \u0442\u0430\u043c\u0443 \u044f, \u043f\u0430\u0447\u0430\u045e\u0448\u044b \u0437 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f \u0410\u0439\u0446\u0430, \u0421\u044b\u043d\u0430 \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u0441\u0456\u043c\u0432\u0430\u043b\u0430 \u0432\u0435\u0440\u044b, \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u0456\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c &laquo;\u041e\u0439\u0447\u0430 \u043d\u0430\u0448&raquo; \u0456 &laquo;\u0412\u0456\u0442\u0430\u0439, \u041c\u0430\u0440\u044b\u044f&raquo;. \u042f \u0437\u0432\u044f\u0440\u043d\u0443\u045e \u0443\u0432\u0430\u0433\u0443 \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0437\u0435&shy;\u0446\u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u0442\u0430\u043b\u0435\u043d\u0430\u0432\u0456\u0442\u044b\u044f \u0456, \u043a\u0430\u043b\u0456 \u0431 \u0431\u044b\u043b\u043e \u043a\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0456\u0445 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u043c, \u044f\u043d\u044b \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u0431\u044b\u043b\u0456 \u0431 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u044b\u043c\u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043d\u043e\u0433\u0456\u044f \u045e \u0433\u044d\u0442\u044b\u0445 \u043c\u044f\u0441\u0446\u0456\u043d\u0430\u0445 \u043d\u0435 \u0441\u0442\u0430\u043b\u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u043a\u0430\u043c\u0443 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0456\u0445 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456. \u041c\u043d\u0435 \u0447\u0430\u0441\u0442\u0430 \u0437\u0433\u0430\u0434\u0432\u0430\u0435\u0446\u0446\u0430, \u044f\u043a \u044f \u0430\u0431\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0435\u045e\u0440\u0430\u043f\u0435\u0439\u0441\u043a\u0456\u044f \u0443\u043d\u0456\u0432\u0435\u0440\u0441\u0456\u0442\u044d\u0442\u044b, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043f\u0430\u0440\u044b\u0436\u0441\u043a\u0456, \u0456, \u043d\u0456\u0431\u044b \u0448\u0430\u043b\u0451\u043d\u044b, \u043a\u0440\u044b\u0447\u0430\u045e \u043f\u0430\u045e\u0441\u044e\u043b\u044c \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u043c\u0435\u045e \u0431\u043e\u043b\u044c\u0448 \u0432\u0435\u0434\u0430\u045e, \u0447\u044b\u043c \u043b\u044e\u0431\u043e\u0432\u0456: &laquo;\u0413\u0430\u043d\u044c\u0431\u0430, \u044f\u043a \u0436\u0430 \u0448\u043c\u0430\u0442 \u0434\u0443\u0448 \u0437 \u0432\u0430\u0448\u0430\u0439 \u0432\u0456\u043d\u044b \u0441\u0442\u0440\u0430\u0447\u0430\u043d\u0430 \u0434\u043b\u044f \u043d\u0435\u0431\u0430 \u0456 \u0441\u043a\u0456\u043d\u0443\u0442\u0430 \u045e \u043f\u0435\u043a\u043b\u0430!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0431\u044b \u044f\u043d\u044b \u0442\u0430\u043a \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b, \u044f\u043a \u0434\u0430 \u043d\u0430\u0432\u0443\u043a\u0456, \u043a\u0430\u0431 \u0437\u043c\u0430\u0433\u043b\u0456 \u0434\u0430\u0446\u044c \u0411\u043e\u0433\u0443 \u0440\u0430\u0445\u0443\u043d\u0430\u043a \u0437\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u044f \u0432\u0435\u0434\u044b \u0456 \u0442\u0430\u043b\u0435\u043d\u0442\u044b! \u041d\u044f\u0445\u0430\u0439 \u0431\u044b \u043c\u043d\u043e\u0433\u0456\u044f \u0437 \u0456\u0445, \u0443\u0437\u0440\u0443\u0448\u0430\u043d\u044b\u044f \u0433\u044d\u0442\u0430\u044e \u0434\u0443\u043c\u043a\u0430\u0439, \u0430\u0434\u0434\u0430\u043b\u0456\u0441\u044f \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f\u043c \u043d\u0430\u0434 \u0411\u043e\u0436\u044b\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456 \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0456\u0445 \u0434\u0443\u0448\u044b \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u041f\u0430\u043d. \u041d\u044f\u0445\u0430\u0439 \u0431\u044b \u044f\u043d\u044b \u0430\u0434\u043a\u043b\u0430\u043b\u0456 \u0441\u0432\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0456 \u043b\u044e\u0434\u0441\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u043f\u043e\u045e\u043d\u0430\u0441\u0446\u044e \u0434\u0430\u0432\u0435\u0440\u044b\u043b\u0456\u0441\u044f \u043d\u0430\u043c\u0435\u0440\u0430\u043c \u0456 \u0432\u043e\u043b\u0456 \u0411\u043e\u0433\u0430. \u041d\u044f\u0445\u0430\u0439 \u0431\u044b \u044f\u043d\u044b \u0430\u0434 \u0434\u0443\u0448\u044b \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u043b\u0456: &laquo;\u0413\u044d\u0442\u0430 \u044f, \u041f\u0430\u043d\u0435! \u0428\u0442\u043e \u0422\u044b \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0448 \u043c\u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u044c?&raquo; \u041f\u0430\u0448\u043b\u0456 \u043c\u044f\u043d\u0435, \u043a\u0443\u0434\u044b \u0436\u0430\u0434\u0430\u0435\u0448, \u0445\u043e\u0446\u044c \u0443 \u0441\u0430\u043c\u0443 \u0406\u043d\u0434\u044b\u044e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u041a 10, 2; \u0414\u0417 1, 8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0416\u043d\u0456\u0432\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u0430 \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043c\u0430\u043b\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u043c\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u0435 \u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0436\u043d\u0456\u0432\u0430, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u0430\u045e \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043d\u0430 \u0436\u043d\u0456\u0432\u043e \u0441\u0432\u0430\u0451.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u043c\u0435\u0446\u0435 \u043c\u043e\u0446 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u043d\u0430 \u0432\u0430\u0441 \u0441\u044b\u0434\u0437\u0435, \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u0430\u0456\u043c\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456 \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u0435 \u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0436\u043d\u0456\u0432\u0430, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u0430\u045e \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043d\u0430 \u0436\u043d\u0456\u0432\u043e \u0441\u0432\u0430\u0451.<\/p>\r\n"}, {"GCH_CH_2_ID":"603","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0412\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u0432\u0435\u0440\u044b&raquo; \u0441\u0432. \u042f\u043d\u0430 \u0414\u0430\u043c\u0430\u0441\u043a\u0456\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 1: PG 95, 417-419)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u043d\u0435, \u0422\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043c\u044f\u043d\u0435 \u043d\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0422\u0432\u0430\u0456\u043c \u0432\u0443\u0447\u043d\u044f\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0422\u044b \u0432\u044b\u0432\u0435\u045e \u043c\u044f\u043d\u0435 \u0441\u0430 \u0441\u0446\u0451\u0433\u043d\u0430\u045e \u043c\u0430\u0439\u0433\u043e \u0431\u0430\u0446\u044c\u043a\u0456. \u0422\u044b \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u043c\u0430\u0451\u0439 \u043c\u0430\u0446\u0456. \u0422\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u043c\u044f\u043d\u0435 \u0433\u043e\u043b\u044b\u043c \u0434\u0437\u0456\u0446\u0435\u043c \u043d\u0430 \u0441\u0432\u044f\u0442\u043b\u043e, \u0431\u043e \u0437\u0430\u043a\u043e\u043d\u044b \u043d\u0430&not;\u0448\u0430\u0439 \u043f\u0440\u044b\u0440\u043e\u0434\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u0422\u0432\u0430\u0456\u043c \u043d\u0430\u043a\u0430\u0437\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0422\u044b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u043c\u0430\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0456 \u043c\u0430\u0451 \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u0435. \u0406 \u0433\u044d\u0442\u0430 \u0430\u0434\u0431\u044b\u043b\u043e\u0441\u044f \u043d\u0435 \u0437 \u0432\u043e\u043b\u0456 \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u0446\u0456 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u0446\u044b, \u044f\u043a\u0443\u044e \u043d\u0435\u043b\u044c\u0433\u0430 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0443 \u0441\u043b\u043e\u0432\u0430\u0445. \u0421\u0432\u0430\u0451\u0439 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0430\u0439, \u044f\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0430\u043a\u043e\u043d\u044b \u043d\u0430\u0448\u0430\u0439 \u043f\u0440\u044b\u0440\u043e\u0434\u044b, \u0422\u044b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u043c\u0430\u0451 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435, \u043a\u0430\u0431, \u0443\u0441\u044b\u043d\u0430\u045e\u043b\u044f\u044e\u0447\u044b, \u0432\u044b\u0432\u0435\u0441\u0446\u0456 \u043c\u044f\u043d\u0435 \u043d\u0430 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u0437\u0430\u043b\u0456\u0447\u044b\u0446\u044c \u0434\u0430 \u0432\u0443\u0447\u043d\u044f\u045e \u0422\u0432\u0430\u0439\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043a\u0430\u0440\u043c\u0456\u045e \u043c\u044f\u043d\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u043c\u0430\u043b\u0430\u043a\u043e\u043c, \u043c\u0430\u043b\u0430\u043a\u043e\u043c \u0422\u0432\u0430\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u045e. \u0422\u044b \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0430\u043c \u043c\u043e\u0446\u044b &ndash; \u0426\u0435\u043b\u0430\u043c \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0433\u0430 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u0456 \u043f\u0430\u0456\u045e \u043c\u044f\u043d\u0435 \u0437 \u0411\u043e\u0436\u0430\u0433\u0430 \u043a\u0435\u043b\u0456\u0445\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u042f\u0433\u043e\u043d\u0430\u044e \u0436\u044b\u0432\u0430\u0442\u0432\u043e\u0440\u043d\u0430\u044e \u041a\u0440\u044b\u0432\u0451\u044e, \u044f\u043a\u0443\u044e \u0401\u043d \u043f\u0440\u0430\u043b\u0456\u045e \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0422\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u0437\u0430 \u043d\u0430\u0448\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u0430\u0434\u0434\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0437\u0433\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u043d\u0430 \u0433\u044d\u0442\u0430 \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0456 \u043d\u0435 \u043f\u044f\u0440\u044d\u0447\u044b\u045e. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0401\u043d \u0441\u0430\u043c \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0441\u044f\u0431\u0435 \u043d\u0430 \u0433\u044d\u0442\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u0430\u0435 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u044f\u0433\u043d\u044f. \u0425\u043e\u0446\u044c \u0431\u044b\u045e \u0411\u043e\u0433\u0430\u043c, \u0401\u043d \u0441\u0442\u0430\u045e\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0456 \u0441\u0432\u0430\u0451\u044e \u043b\u044e\u0434\u0441\u043a\u043e\u044e \u0432\u043e\u043b\u044f\u044e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u045e\u0441\u044f, \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c, \u0422\u0430\u0431\u0435, \u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443 \u0441\u0432\u0430\u0439\u043c\u0443, &laquo;\u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u0441\u043c\u0435\u0440\u0446\u0456 \u043a\u0440\u044b\u0436\u043e\u0432\u0430\u0439&raquo; (\u0424\u043b\u043f 2, 8).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u0425\u0440\u044b\u0441\u0442\u044d, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430, \u0422\u044b \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u043c\u044f\u043d\u0435, \u0437\u0430\u0433\u0443\u0431\u043b\u0435\u043d\u0443\u044e \u0430\u0432\u0435\u0447\u043a\u0443, \u043f\u0430\u043d\u0435\u0441\u0446\u0456 \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u043f\u043b\u044f\u0447\u0430\u0445, \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u043c\u044f\u043d\u0435 \u043d\u0430 \u0437\u044f\u043b\u0451\u043d\u044b\u0445 \u043f\u0430\u0448\u0430\u0445 \u0456 \u0436\u044b\u0432\u0456\u0446\u044c \u043c\u044f\u043d\u0435 \u0432\u043e\u0434\u0430\u043c\u0456 \u0441\u043b\u0443\u0448\u043d\u0430\u0433\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f \u0437 \u0440\u0443\u043a \u0422\u0432\u0430\u0456\u0445 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0422\u044b \u0441\u0430\u043c \u0456\u0445 \u043f\u0430\u0441&shy;\u0432\u0456\u0448, \u0437 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443 \u044f\u043d\u044b \u043f\u0430\u0441\u0432\u044f\u0446\u044c \u0422\u0432\u043e\u0439 \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u043d\u0430\u0440\u043e\u0434.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u043f\u0440\u0430\u0437 \u0443\u0441\u043a\u043b\u0430\u0434\u0430\u043d\u043d\u0435 \u0440\u0443\u043a \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0446\u044f\u043f\u0435\u0440 \u0422\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043c\u044f\u043d\u0435 \u043d\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0422\u0432\u0430\u0456\u043c \u0432\u0443\u0447\u043d\u044f\u043c. \u042f \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u044f\u043a\u0456\u043c \u043f\u0440\u043e\u0432\u0456\u0434\u0430\u043c \u0422\u044b \u0433\u044d\u0442\u0430 \u0437\u0440\u0430\u0431\u0456\u045e, \u0430\u0434\u0437\u0456\u043d \u0422\u044b \u0432\u0435\u0434\u0430\u0435\u0448 \u0433\u044d\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a, \u041f\u0430\u043d\u0435, \u0430\u0431\u043b\u0435\u0433\u0447\u044b \u0446\u044f\u0436\u043a\u0443\u044e \u043d\u043e\u0448\u0443 \u043c\u0430\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e, \u044f\u043a\u0456\u043c\u0456 \u044f \u0441\u0443\u0440&rsquo;\u0451\u0437\u043d\u0430 \u0437\u0433\u0440\u0430\u0448\u044b\u045e. \u0410\u0447\u044b\u0441\u0446\u0456 \u043c\u043e\u0439 \u0440\u043e\u0437\u0443\u043c \u0456 \u0441\u044d\u0440\u0446\u0430. \u0412\u044f\u0434\u0437\u0456 \u043c\u044f\u043d\u0435 \u043f\u0430 \u043f\u0440\u043e\u0441\u0442\u0430\u0439 \u0441\u0446\u0435\u0436\u0446\u044b, \u044f\u043a \u043f\u0430\u0445\u043e\u0434\u043d\u044f, \u0448\u0442\u043e \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0448\u043b\u044f\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043a\u0440\u044b\u0439 \u043c\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u0434\u043b\u044f \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0441\u043b\u043e\u0432\u0430, \u043d\u044f\u0445\u0430\u0439 \u043f\u043e\u043b\u044b\u043c\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u043c\u0430\u044e \u043c\u043e\u0432\u0443 \u0432\u044b\u0440\u0430\u0437\u043d\u0430\u0439 \u0456 \u043a\u0440\u0430\u0441\u0430\u043c\u043e\u045e\u043d\u0430\u0439, \u0430 \u0422\u0432\u0430\u044f \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u045e\u0436\u0434\u044b \u043c\u044f\u043d\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u0432\u0456 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435, \u0456 \u0431\u0443\u0434\u0437\u044c \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u043c\u043d\u043e\u044e, \u043a\u0430\u0431 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u043d\u0435 \u0432\u0430\u0433\u0430\u043b\u0430\u0441\u044f \u043d\u0456 \u045e\u043b\u0435\u0432\u0430, \u043d\u0456 \u045e\u043f\u0440\u0430\u0432\u0430, \u0430 \u0422\u0432\u043e\u0439 \u0434\u043e\u0431\u0440\u044b \u0414\u0443\u0445 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u043d\u0430 \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u044b \u0448\u043b\u044f\u0445. \u041d\u044f\u0445\u0430\u0439 \u043c\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044b \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u0436\u044b\u0446\u0446\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b\u044f \u0422\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0442\u044b, \u043e \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u0430\u044f \u0432\u044f\u0440\u0448\u044b\u043d\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0447\u044b\u0441&shy;\u0442\u0430\u0441\u0446\u0456, \u043e \u043d\u0430\u0439\u0432\u044b\u0434\u0430\u0442\u043d\u0435\u0439\u0448\u0430\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u043a\u0456 \u0447\u0430\u043a\u0430\u0435 \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456, \u043e \u043c\u0435\u0441\u0446\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0441\u043f\u0430\u0447\u044b\u043d\u043a\u0443, \u043f\u0440\u044b\u043c\u0456 \u0430\u0434 \u043d\u0430\u0441 \u043d\u0435\u0441\u043a\u0430\u0436\u043e\u043d\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0432\u0435\u0440\u044b. \u041d\u044f\u0445\u0430\u0439 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043c\u0443 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a \u0431\u044b\u043b\u043e \u043d\u0430\u043c \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0410\u0439\u0446\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0430\u043b 2, 6; \u041f\u0441 89 (88), 22<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u043a\u043e\u043d \u043f\u0440\u0430\u045e\u0434\u044b \u0431\u044b\u045e \u0443 \u0432\u0443\u0441\u043d\u0430\u0445 \u044f\u0433\u043e\u043d\u044b\u0445, \u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u043e\u0441\u044f \u045e \u0456\u0445. <span style=\"color: #ff0000;\">*<\/span> \u0423 \u0441\u043f\u0430\u043a\u043e\u0456 \u0456 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0451\u043d \u0456\u0448\u043e\u045e \u0437\u0430 \u041c\u043d\u043e\u044e, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0420\u0443\u043a\u0430 \u043c\u043e\u0446\u044b \u041c\u0430\u0451\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u0437 \u0456\u043c, \u0456 \u043f\u043b\u044f\u0447\u043e \u041c\u0430\u0451 \u044f\u0433\u043e \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0441\u043f\u0430\u043a\u043e\u0456 \u0456 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0451\u043d \u0456\u0448\u043e\u045e \u0437\u0430 \u041c\u043d\u043e\u044e, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/p>\r\n"}, {"GCH_CH_2_ID":"605","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 123, 5: CCL 36, 678-860)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041d\u044f\u0445\u0430\u0439 \u0441\u0456\u043b\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0433\u043e\u0440\u044b\u0447 \u0441\u043c\u0435\u0440\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u041f\u0430\u043d \u043f\u044b\u0442\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u0435\u0434\u0430\u0435. \u0406 \u043f\u044b\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u041f\u044f\u0442\u0440\u0430 \u043d\u0435 \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437, \u0430\u043b\u0435 \u0434\u0432\u0430 \u0456 \u0442\u0440\u044b, \u0446\u0456 \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e \u041f\u0451\u0442\u0440. \u0406 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0436 \u0440\u0430\u0437\u043e\u045e \u0441\u043b\u0443\u0445\u0430\u0435 \u0430\u0434 \u041f\u044f\u0442\u0440\u0430, \u0448\u0442\u043e \u0442\u043e\u0439 \u042f\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u044c, \u0456 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0436 \u0440\u0430\u0437\u043e\u045e \u0434\u0430\u0440\u0443\u0447\u0430\u0435 \u041f\u044f\u0442\u0440\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u042f\u0433\u043e\u043d\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0442\u0440\u043e\u0439\u043d\u0430\u043c\u0443 \u0430\u0434\u0440\u0430\u0447\u044d\u043d\u043d\u044e \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u043f\u0430\u0442\u0440\u043e\u0439\u043d\u0430\u0435 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435, \u043a\u0430\u0431 \u044f\u0437\u044b\u043a \u0430\u043a\u0430\u0437\u0430\u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u0435 \u043c\u0435\u043d\u0448\u0443\u044e \u043f\u0430\u0441\u043b\u0443\u0433\u0443, \u0447\u044b\u043c \u0441\u0442\u0440\u0430\u0445\u0443, \u0456 \u043a\u0430\u0431 \u043d\u0435 \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u043f\u0430\u0433\u0440\u043e\u0437\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0431\u043e\u043b\u044c\u0448 \u0441\u043b\u043e\u0432\u0430\u045e, \u0447\u044b\u043c \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0436\u044b\u0446\u0446\u044f. \u041d\u044f\u0445\u0430\u0439 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0441\u0442\u0430\u0442\u0430\u043a \u041f\u0430\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u044f\u0432\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u043a\u0430\u043b\u0456 \u0430\u0434\u043c\u043e\u0432\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430 \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u0430\u044f\u0432\u0430\u044e \u0441\u0442\u0440\u0430\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u0442\u044b\u0440\u044b \u0430\u0432\u0435\u0447\u0430\u043a \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u0445, \u044f\u043a\u0456\u044f \u0445\u043e\u0447\u0443\u0446\u044c, \u043a\u0430\u0431 \u0442\u044b\u044f \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0456 \u0434\u0430 \u0456\u0445, \u0430 \u043d\u0435 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043b\u044e\u0431\u044f\u0446\u044c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435, \u0430 \u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u043a\u0456\u043c\u0456 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437\u043e\u045e \u043f\u0456\u043b\u044c\u043d\u0430 \u043f\u0435\u0440\u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u0425\u0440\u044b\u0441\u0442\u0430. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043d\u0430\u0440\u0430\u043a\u0430\u0435, \u0448\u0442\u043e \u044f\u043d\u044b \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e, \u0430 \u043d\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u043e\u0432\u044b &laquo;\u0446\u0456 \u043b\u044e\u0431\u0456\u0448 \u041c\u044f\u043d\u0435? \u041f\u0430\u0441\u0456 \u0430\u0432\u0435\u0447\u0430\u043a \u041c\u0430\u0456\u0445&raquo; (\u043f\u0430\u0440. \u042f\u043d 21, 17) \u0430\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0435: \u043a\u0430\u043b\u0456 \u041c\u044f\u043d\u0435 \u043b\u044e\u0431\u0456\u0448, \u0434\u0443\u043c\u0430\u0439 \u043f\u0440\u0430 \u0442\u043e\u0435, \u044f\u043a \u043d\u0435 \u0441\u044f\u0431\u0435 \u043f\u0430\u0441\u0432\u0456\u0446\u044c, \u0430\u043b\u0435 \u041c\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a; \u043f\u0430\u0441\u0456 \u044f\u043a \u041c\u0430\u0456\u0445, \u0430 \u043d\u0435 \u044f\u043a \u0441\u0432\u0430\u0456\u0445; \u0448\u0443\u043a\u0430\u0439 \u0443 \u0456\u0445 \u041c\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b, \u0430 \u043d\u0435 \u0441\u0432\u0430\u0451\u0439; \u041c\u0430\u0439\u0433\u043e \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f, \u0430 \u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e; \u041c\u0430\u0451\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u0430 \u043d\u0435 \u0441\u0432\u0430\u0451\u0439. \u0411\u043e \u0456\u043d\u0430\u043a\u0448 \u0430\u043f\u044b\u043d\u0435\u0448\u0441\u044f \u045e \u043b\u0456\u043a\u0443 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u045e \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0447\u0430\u0441\u044b, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435 \u0456 \u045e\u0441\u0451 \u0456\u043d\u0448\u0430\u0435, \u0448\u0442\u043e \u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u0437 \u0433\u044d\u0442\u044b\u043c \u0441\u0430\u043c\u0430\u043b\u044e\u0431\u0441\u0442\u0432\u0430\u043c &ndash; \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0437\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u0442\u044b\u0440\u044b \u0430\u0432\u0435\u0447\u0430\u043a \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u0445 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u0442\u0430\u043a\u0456\u043c\u0456, \u0430\u043b\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445 \u043d\u0435 \u044f\u043a \u0441\u0432\u0430\u0456\u0445, \u0430\u043b\u0435 \u044f\u043a \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u0442\u044b\u0440\u044b \u0430\u0432\u0435\u0447\u0430\u043a \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u0445 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0441\u0446\u0435\u0440\u0430\u0433\u0447\u044b\u0441\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043d\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e, \u0448\u0442\u043e \u043d\u0435 \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u043d\u0435 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0446\u044c \u0443 \u0441\u0432\u0430\u0456\u0445 \u043c\u044d\u0442\u0430\u0445 \u0442\u044b\u0445, \u0437\u0430 \u043a\u0430\u0433\u043e \u0431\u044b\u043b\u0430 \u043f\u0440\u0430\u043b\u0456\u0442\u0430\u044f \u043a\u0440\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u0442\u044b\u0440\u044b \u0430\u0432\u0435\u0447\u0430\u043a \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u0445 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0441\u043f\u0430&shy;\u043b\u0456\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u0442\u0430\u043a\u043e\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u043f\u043e\u043b\u044b\u043c\u044f \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u044f\u043d\u043e \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u043e \u043d\u0430\u0432\u0430\u0442 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b \u0441\u0442\u0440\u0430\u0445 \u043f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u0431\u043e \u0445\u043e\u0446\u044c \u043c\u044b \u0445\u043e\u0447\u0430\u043c \u0436\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0430\u0434\u043d\u0430\u043a \u043d\u0435 \u0436\u0430\u0434\u0430\u0435\u043c \u043f\u0430\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435, \u044f\u043a\u0430\u044f \u0431 \u043d\u0456 \u0431\u044b\u043b\u0430 \u0433\u043e\u0440\u044b\u0447 \u0441\u043c\u0435\u0440\u0446\u0456, \u043d\u044f\u0445\u0430\u0439 \u044f\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430 \u0441\u0456\u043b\u0430 \u043b\u044e\u0431\u043e\u0432\u0456, \u0437 \u044f\u043a\u043e\u044e \u043b\u044e\u0431\u044f\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e, \u0431\u0443\u0434\u0443\u0447\u044b \u0436\u044b\u0446\u0446\u0451\u043c \u043d\u0430\u0448\u044b\u043c, \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0437\u0430 \u043d\u0430\u0441 \u0441\u043c\u0435\u0440\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0431 \u0433\u043e\u0440\u044b\u0447\u044b \u0441\u043c\u0435\u0440\u0446\u0456 \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u0431\u044b\u043b\u043e \u0446\u0456 \u044f\u043d\u0430 \u0431\u044b\u043b\u0430 \u043c\u0430\u043b\u0430\u044f, \u0442\u043e \u0441\u043b\u0430\u0432\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u043d\u0435 \u0431\u044b\u043b\u0430 \u0431 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439. \u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u0414\u043e\u0431\u0440\u044b \u041f\u0430\u0441\u0442\u044b\u0440, \u044f\u043a\u0456 \u0430\u0434\u0434\u0430\u045e \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0430\u0432\u0435\u0447\u0430\u043a, \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u0430\u0431\u0435 \u0437 \u0441\u0430\u043c\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e, \u0442\u043e \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0434\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0434\u0430 \u043f\u0440\u0430\u043b\u0456\u0446\u0446\u044f \u043a\u0440\u044b\u0432\u0456 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u0440\u0430\u0445\u0443 \u0442\u044b\u044f, \u043a\u0430\u043c\u0443 \u041f\u0430\u043d \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0432\u0443\u0447\u044b\u0446\u044c \u0456 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c?<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u043a\u043b\u0430\u0434 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u044f\u0441\u043a\u0440\u0430\u0432\u0430 \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0435, \u0448\u0442\u043e \u043f\u0430\u0441\u0442\u044b\u0440\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0436\u0430\u0434\u0430\u0446\u044c \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u041f\u0430\u0441\u0442\u044b\u0440\u0430, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0448\u0442\u043e \u043c\u043d\u043e\u0433\u0456\u044f \u0430\u0432\u0435\u0447\u043a\u0456 \u045e\u0436\u043e \u0433\u044d\u0442\u0430\u043a \u0437\u0440\u0430\u0431\u0456\u043b\u0456. \u041f\u0430\u0434 \u0430\u0434\u043d\u044b\u043c \u041f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u0456 \u0431\u0443\u0434\u0443\u0447\u044b \u045e \u0430\u0434\u043d\u044b\u043c \u0441\u0442\u0430\u0442\u043a\u0443, \u0445\u0456\u0431\u0430 \u0456 \u0441\u0430\u043c\u0456 \u043f\u0430\u0441\u0442\u044b\u0440\u044b \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456? \u0401\u043d \u0443\u0441\u0456\u0445 \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u0432\u0430\u0456\u043c\u0456 \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456 \u0456 \u0437\u0430 \u0456\u0445 \u0443\u0441\u0456\u0445 \u0446\u044f\u0440\u043f\u0435\u045e, \u0431\u043e \u0456 \u0441\u0430\u043c \u0441\u0442\u0430\u045e \u0411\u0430\u0440\u0430\u043d\u043a\u0430\u043c, \u043a\u0430\u0431 \u043f\u0430\u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u0430 \u045e\u0441\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0456\u0440 45, 3; \u041f\u0441 78 (77), 70. 71<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u044f\u0433\u043e \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0456 \u0434\u0430\u045e \u044f\u043c\u0443 \u043d\u0430\u043a\u0430\u0437 \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u0441\u0432\u0430\u044e \u0445\u0432\u0430\u043b\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b\u0431\u0440\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0441\u0432\u0430\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u0441\u0432\u0430\u044e \u0445\u0432\u0430\u043b\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"606","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 2, 1-2. 4-5. 7: PL 16 [edit. 1845], 847-881)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041b\u0430\u0441\u043a\u0430\u044e \u0441\u043b\u043e\u0432\u0430\u045e \u0422\u0432\u0430\u0456\u0445 \u0430\u0434\u043e\u0440\u0432\u0430\u0439 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u044b\u043d\u044f\u045e \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0430\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0456, \u0441\u0435\u0434\u0437\u044f\u0447\u044b \u043f\u0440\u044b \u043a\u0430\u0440\u043c\u0435 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u0448 \u043a\u0430\u0440\u0430\u0431\u0435\u043b\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0447\u044d\u043d\u043d\u044f. \u0422\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u0441\u0442\u044b\u0440\u043d\u0430 \u0432\u0435\u0440\u044b, \u043a\u0430\u0431 \u0446\u044f\u0436\u043a\u0456\u044f \u0431\u0443\u0440\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u043d\u0435 \u0437\u0434\u043e\u043b\u0435\u043b\u0456 \u0437\u0431\u0456\u0446\u044c \u0446\u044f\u0431\u0435. \u041c\u043e\u0440\u0430, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0456 \u0448\u044b\u0440\u043e\u043a\u0430\u0435, \u0430\u043b\u0435 \u043d\u0435 \u0431\u043e\u0439\u0441\u044f; \u0431\u043e &laquo;\u0401\u043d \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u045e \u044f\u0433\u043e \u043d\u0430 \u043c\u043e\u0440\u0430\u0445 \u0456 \u043d\u0430 \u0440\u044d\u043a\u0430\u0445 \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u044f\u0433\u043e&raquo; (\u041f\u0441 24 [23], 2).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0447\u0430\u043c\u0443 \u0441\u044f\u0440\u043e\u0434 \u0431\u0443\u0440\u043b\u0456\u0432\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u041a\u0430\u0441\u0446\u0451\u043b \u041f\u0430\u043d\u0430, \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u0441\u043a\u0430\u043b\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430 \u0441\u0442\u0430\u0456\u0446\u044c \u043d\u0430 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u044b\u043c \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443, \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u043d\u0430\u0446\u0456\u0441\u043a \u043b\u044e\u0442\u0430\u0433\u0430 \u043c\u043e\u0440\u0430. \u0423 \u044f\u0433\u043e \u0431&rsquo;\u044e\u0446\u044c \u0445\u0432\u0430\u043b\u0456, \u0430\u043b\u0435 \u0451\u043d \u043d\u0435 \u0445\u0456\u0441\u0442\u0430\u0435\u0446\u0446\u0430, \u0456 \u0445\u043e\u0446\u044c \u0447\u0430\u0441\u0442\u0430 \u0441\u0442\u044b\u0445\u0456\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0437 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0433\u0443\u043b\u0430\u043c \u0443\u0434\u0430\u0440\u0430\u044e\u0446\u044c \u0443 \u044f\u0433\u043e, \u0443 \u0456\u043c \u0451\u0441\u0446\u044c \u0441\u0430\u043c\u044b \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b \u043f\u043e\u0440\u0442 \u0440\u0430\u0442\u0443\u043d\u043a\u0443 &ndash; \u043f\u0440\u044b\u0442\u0443\u043b\u0430\u043a \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0446\u0435\u0440\u043f\u0456\u0446\u044c. \u0406 \u0445\u043e\u0446\u044c \u0451\u043d \u0432\u0430\u043d\u0434\u0440\u0443\u0435 \u043f\u0430 \u043c\u043e\u0440\u044b, \u0451\u043d \u043f\u043b\u044b\u0432\u0435 \u043f\u0430 \u0440\u044d\u043a\u0430\u0445. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u0446\u0456 \u043d\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u044b\u044f \u0440\u044d\u043a\u0456 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0420\u044d\u043a\u0456 \u045e\u0437\u043d\u044f\u043b\u0456 \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441&raquo; (\u043f\u0430\u0440. \u041f\u0441 93 [92], 3). \u0411\u043e \u0451\u0441\u0446\u044c \u0440\u044d\u043a\u0456, \u044f\u043a\u0456\u044f \u043f\u043b\u044b\u0432\u0443\u0446\u044c \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430: \u0456\u0445 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0456 \u0432\u044b\u0442\u043e\u043a\u0456 \u045e \u0414\u0443\u0445\u0443 \u0411\u043e\u0436\u044b\u043c. \u0422\u0430\u043c\u0443 \u0433\u044d\u0442\u044b\u044f \u0440\u044d\u043a\u0456 \u045e\u0437\u0432\u044b\u0448\u0430\u044e\u0446\u044c \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441, \u0431\u043e \u043f\u0435\u0440\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0446\u0446\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u044e \u043b\u0430\u0441\u043a\u0430\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u0441\u0446\u044c \u0456 \u0441\u0442\u0440\u0443\u043c\u0435\u043d\u044c, \u044f\u043a\u0456 \u0446\u044f\u0447\u044d \u0434\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u0441\u0432\u0430\u0456\u0445, \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u0430\u0442\u043e\u043a. \u0401\u0441\u0446\u044c \u0456 \u0441\u0456\u043b\u0430 \u0440\u0430\u043a\u0456, \u044f\u043a\u0430\u044f \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u044c \u043c\u0456\u0440\u043d\u0443\u044e \u0456 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0443\u044e \u0434\u0443\u0448\u0443. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u0437 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u0433\u044d\u0442\u0430\u0439 \u0440\u0430\u043a\u0456, \u044f\u043a \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442 \u042f\u043d, \u044f\u043a \u041f\u0451\u0442\u0440 \u0456 \u041f\u0430\u0432\u0435\u043b, \u0442\u043e\u0439 \u0443\u0437\u0434\u044b\u043c\u0430\u0435 \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441. \u042f\u043a \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0437\u0432\u043e\u043d\u043a\u0456\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0440\u0430\u0437\u043b\u0456\u043b\u0456 \u043f\u0430 \u045e\u0441\u0456\u0445 \u0437\u044f\u043c\u043d\u044b\u0445 \u043c\u0435\u0436\u0430\u0445 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0443\u044e \u043f\u0440\u043e\u043f\u0430\u0432\u0435\u0434\u0437\u044c, \u0442\u0430\u043a \u0451\u043d \u043f\u0430\u0447\u044b\u043d\u0430\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0414\u043e\u0431\u0440\u0443\u044e \u041d\u0430\u0432\u0456\u043d\u0443 \u043f\u0440\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0431\u044f\u0440\u044b \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u043f\u0430\u0447\u0443\u045e\u0441\u044f \u0456 \u0442\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441. \u0417\u0431\u0456\u0440\u0430\u0439 \u0432\u0430\u0434\u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0443\u044e \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u041f\u0430\u043d. \u0417\u0431\u0456\u0440\u0430\u0439 \u0443 \u043c\u043d\u043e\u0433\u0456\u0445 \u043c\u0435\u0441\u0446\u0430\u0445 \u0432\u0430\u0434\u0443, \u044f\u043a\u0443\u044e \u043f\u0440\u0430\u043b\u0456\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u0446\u043a\u0456\u044f \u0445\u043c\u0430\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0437\u0431\u0456\u0440\u0430\u0435 \u0432\u0430\u0434\u0443 \u0437 \u0433\u043e\u0440, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u0435 \u044f\u0435 \u0434\u0430 \u0441\u044f\u0431\u0435 \u0446\u0456 \u0447\u044d\u0440\u043f\u0430\u0435 \u0437 \u043a\u0440\u044b\u043d\u0456\u0446, \u0442\u043e\u0439 \u0456 \u0441\u0430\u043c \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0435 \u0434\u043e\u0436\u0434\u0436, \u0431\u044b\u0446\u0446\u0430\u043c \u0445\u043c\u0430\u0440\u044b. \u0422\u0430\u043c\u0443 \u043d\u0430\u043f\u043e\u045e\u043d\u0456 \u0433\u043b\u044b\u0431\u0456\u043d\u044e \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b, \u043a\u0430\u0431 \u0442\u0432\u0430\u044f \u0437\u044f\u043c\u043b\u044f \u043d\u0430\u0431\u0440\u044b\u043d\u044f\u043b\u0430 \u0456 \u0430\u0440\u0430\u0448\u0430\u043b\u0430\u0441\u044f \u0437 \u0443\u043b\u0430\u0441\u043d\u044b\u0445 \u043a\u0440\u044b\u043d\u0456\u0446.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0448\u043c\u0430\u0442 \u0447\u044b\u0442\u0430\u0435 \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u0435. \u0422\u043e\u0439, \u0445\u0442\u043e \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430, \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0456 \u0456\u043d\u0448\u044b\u0445, \u0442\u0430\u043c\u0443 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c: &laquo;\u041a\u0430\u043b\u0456 \u0445\u043c\u0430\u0440\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u0432\u0430\u0434\u043e\u0439, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u043b\u044c\u044e\u0446\u044c \u0434\u043e\u0436\u0434\u0436 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e&raquo; (\u042d\u043a\u043b 11, 3).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0442\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u043b\u0430\u0434\u043a\u0456\u044f, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u0447\u044b\u0441\u0442\u044b\u044f \u0456 \u044f\u0441\u043d\u044b\u044f, \u043a\u0430\u0431 \u0442\u044b \u043f\u0440\u0430\u043b\u0456\u045e \u0441\u043b\u043e\u0434\u044b\u0447 \u043c\u0430\u0440\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f \u045e \u0432\u0443\u0448\u044b \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0430 \u043b\u0430\u0441\u043a\u0430\u044e \u0441\u043b\u043e\u0432\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0430\u0434\u043e\u0440\u0432\u0430\u0439 \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u0431 \u0451\u043d \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0456\u0448\u043e\u045e \u0442\u0443\u0434\u044b, \u043a\u0443\u0434\u044b \u0442\u044b \u043f\u0430\u0432\u044f\u0434\u0437\u0435\u0448 \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0442\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u043e\u045e\u043d\u044b\u044f \u0440\u043e\u0437\u0443\u043c\u0443. \u0422\u0430&shy;\u043c\u0443 \u0456 \u0421\u0430\u043b\u0430\u043c\u043e\u043d \u043a\u0430\u0436\u0430: &laquo;\u0412\u0443\u0441\u043d\u044b \u043c\u0443\u0434\u0440\u0430\u0446\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0437\u0431\u0440\u043e\u044f \u0440\u043e\u0437\u0443\u043c\u0443&raquo;, \u0456 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0432\u0443\u0441\u043d\u044b \u0442\u0432\u0430\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0441\u044d\u043d\u0441\u0430\u043c&raquo;. \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043d\u044f\u0445\u0430\u0439 \u0442\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u0441\u043d\u044b\u044f, \u0430 \u0456\u0445 \u0441\u044d\u043d\u0441 \u0432\u0456&not;\u0434\u0430&not;\u0432\u043e\u0447\u043d\u044b, \u0442\u0430\u0434\u044b \u0442\u0432\u0430\u0456\u043c \u043f\u0440\u0430\u043c\u043e\u0432\u0430\u043c \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f\u043c \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u044f \u0456\u043d\u0448\u044b\u044f \u0434\u043e\u043a\u0430\u0437\u044b. \u041d\u044f\u0445\u0430\u0439 \u0442\u0432\u0430\u0451 \u0441\u043b\u043e\u0432\u0430 \u0431\u0430\u0440\u043e\u043d\u0456\u0446\u044c \u0441\u0430\u043c\u043e \u0441\u044f\u0431\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u0441\u0432\u0430\u0451\u0439 \u0437\u0431\u0440\u043e\u044f\u0439, \u0456 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0435 \u0442\u0432\u0430\u0451 \u0441\u043b\u043e\u0432\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u043c\u0430\u0440\u043d\u0430 \u0456 \u043d\u0435 \u043f\u0440\u0430\u0433\u0443\u0447\u044b\u0446\u044c \u0431\u0435\u0437 \u0441\u044d\u043d\u0441\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u0426\u0456\u043c 4, 2; \u043f\u0430\u0440. \u0421\u0456\u0440 48, 4. 8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0439 \u0441\u043b\u043e\u0432\u0430, \u0431\u0443\u0434\u0437\u044c \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u044b \u045e \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0456 \u043d\u0435\u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0447\u0430\u0441, \u0430\u0441\u043f\u0440\u044d\u0447\u0432\u0430\u0439, \u043f\u0430\u043f\u0440\u0430\u045e\u043b\u044f\u0439, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0439 <span style=\"color: #ff0000;\">*<\/span> \u0437 \u0443\u0441\u0451\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0442\u043e \u0437\u043c\u043e\u0436\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u0446\u0430 \u044f\u043a \u0442\u044b, \u044f\u043a\u0456 \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u0435\u0448 \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0434\u043b\u044f \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f?<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417 \u0443\u0441\u0451\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044e.<\/p>\r\n"}, {"GCH_CH_2_ID":"607","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0440\u0430\u043c\u043e\u0432\u0430 \u0441\u0432. \u0410\u043d\u0437\u044d\u043b\u044c\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 52: PL 158, 955-956)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041e \u0414\u0437\u0435\u0432\u0430, \u043f\u0440\u0430\u0437 \u0426\u044f\u0431\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0441\u044f \u043f\u0440\u044b\u0440\u043e\u0434\u0430!<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u0431\u0430, \u0437\u043e\u0440\u043a\u0456, \u0437\u044f\u043c\u043b\u044f, \u0440\u044d\u043a\u0456, \u0434\u0437\u0435\u043d\u044c, \u043d\u043e\u0447 \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430 \u0446\u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0443\u043b\u0430\u0434\u0437\u0435, \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430, \u0414\u0437\u0435\u0432\u0430, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0426\u044f\u0431\u0435 \u044f\u043d\u044b \u043f\u044d\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u0441\u0442\u0440\u0430\u0447\u0430\u043d\u0430\u043d\u0430\u0439 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u0456 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043d\u0435\u0432\u044b\u043c\u043e\u045e\u043d\u044b \u0434\u0430\u0440 \u043b\u0430\u0441\u043a\u0456. \u0411\u043e \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0456\u0431\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0430\u0435, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0430 \u043f\u0440\u044b\u0440\u043e\u0434\u0436\u0430\u043d\u0443\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0434\u043b\u044f \u044f\u043a\u043e\u0439 \u0431\u044b\u043b\u043e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430. \u042f\u0433\u043e \u043c\u044d\u0442\u0430\u0439 \u0431\u044b\u043b\u043e \u0441\u043f\u0440\u044b\u044f\u0446\u044c \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044e \u0430\u0431\u043e \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u0411\u043e\u0433\u0430. \u0410\u043b\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u0456 \u045e\u0446\u0456\u0441\u043a\u0430\u043c \u0456 \u043f\u0441\u0430\u0432\u0430\u043b\u0456 \u0437\u043b\u043e\u045e\u0436\u044b\u0432\u0430\u043d\u043d\u0435\u043c \u0442\u044b\u044f, \u0445\u0442\u043e \u0441\u043b\u0443\u0436\u044b\u045e \u0456\u0434\u0430\u043b\u0430\u043c, \u0445\u043e\u0446\u044c \u044f\u043d\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430 \u0434\u043b\u044f \u0456\u0434\u0430\u043b\u0430\u045e. \u0410\u0434\u043d\u0430\u043a \u0446\u044f\u043f\u0435\u0440, \u043a\u0430\u043b\u0456 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u043d\u0456\u0431\u044b \u0430\u0436\u044b\u043b\u043e, \u044f\u043d\u043e \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430, \u0431\u043e \u0456\u043c \u043a\u0456\u0440\u0443\u044e\u0446\u044c \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u044b \u0411\u043e\u0433\u0430, \u0456 \u044f\u043d\u043e \u043c\u043e\u0436\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0456\u043c \u043a\u0430\u0440\u044b\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u043d\u043e\u0432\u0430\u044e \u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044e \u043b\u0430\u0441\u043a\u0430\u044e, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u0447\u0443\u043b\u0430, \u0448\u0442\u043e \u0441\u0430\u043c \u0411\u043e\u0433, \u0441\u0430\u043c \u044f\u0433\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u044f\u0431\u0430\u0447\u043d\u0430 \u043f\u0430\u043d\u0443\u0435 \u043d\u0430\u0434 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0430\u0447\u043d\u0430 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u0441\u044f\u0440\u043e\u0434 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0456, \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0456\u043c, \u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u044f\u0433\u043e. \u0422\u0430\u043a\u043e\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0434\u0430\u0431\u0440\u043e \u045e\u0437\u043d\u0456\u043a\u043b\u0430 \u043f\u0440\u0430\u0437 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043f\u043b\u043e\u0434 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0433\u0430 \u045e\u043b\u043e\u043d\u043d\u044f \u041c\u0430\u0440\u044b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043f\u0430\u045e\u043d\u0430\u0446\u0435 \u0422\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043f\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u044e, \u0431\u043e \u044f\u043d\u043e \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u043b\u0430\u0441\u044f; \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043f\u0430-\u043d\u0430\u0434 \u0441\u0432\u0435\u0442\u0430\u043c, \u0431\u043e \u044f\u043d\u043e \u0430\u0434\u043d\u0430\u0432\u0456\u043b\u0430\u0441\u044f. \u041f\u0440\u0430\u0437 \u0422\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0430\u045e\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u044f\u043a\u043e\u0433\u0430 \u0422\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u045e \u0441\u043b\u0430\u045e\u043d\u044b\u043c \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0435, \u0443\u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f, \u044f\u043a\u0456\u044f \u0430\u0434\u044b&shy;\u0448\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e\u043d\u0430\u0439 \u0437\u044f\u043c\u043d\u043e\u0439 \u0441\u043c\u0435\u0440\u0446\u044e, \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u044e \u0437&shy;\u043f\u0430\u0434 \u043d\u044f\u0432\u043e\u043b\u0456, \u0430 \u0430\u043d\u0451\u043b\u044b \u0446\u0435\u0448\u0430\u0446\u0446\u0430 \u0437 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u043c\u0430\u043b\u044c \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u043d\u0430\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430\u044f \u043b\u0430\u0441\u043a\u0430\u044e \u0456 \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430\u044f \u0451\u0439, \u0443\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0430\u0436\u044b\u0432\u0430\u0435, \u0430\u043a\u0440\u043e\u043f\u043b\u0435\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c \u0422\u0432\u0430\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b! \u041e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f, \u043f\u0430-\u043d\u0430\u0434 \u043c\u0435\u0440\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0414\u0437\u0435\u0432\u0430, \u043f\u0440\u0430\u0437 \u0422\u0432\u0430\u0451 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u045e\u0441\u044f \u043f\u0440\u044b\u0440\u043e\u0434\u0430, \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c, \u0430\u043b\u0435 \u0456 \u0441\u0430\u043c \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c!<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u0430\u0434\u0434\u0430\u045e \u041c\u0430\u0440\u044b\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430, \u0440\u043e\u045e\u043d\u0430\u0433\u0430 \u0441\u0430\u0431\u0435, \u044f\u043a\u043e\u0433\u0430 \u043b\u044e\u0431\u0456\u045e, \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435. \u0406 \u0437 \u041c\u0430\u0440\u044b\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0421\u044b\u043d\u0430, \u043d\u0435 \u0456\u043d\u0448\u0430\u0433\u0430, \u0430\u043b\u0435 \u0442\u0430\u043a\u043e\u0433\u0430 \u0441\u0430\u043c\u0430\u0433\u0430, \u043a\u0430\u0431 \u043f\u0430 \u043d\u0430\u0442\u0443\u0440\u044b \u0401\u043d \u0431\u044b\u045e \u0430\u0434\u043d\u044b\u043c \u0456 \u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u0421\u044b\u043d\u0430\u043c \u0411\u043e\u0433\u0430 \u0456 \u0421\u044b\u043d\u0430\u043c \u041c\u0430\u0440\u044b\u0456. \u0423\u0441\u044f \u043f\u0440\u044b\u0440\u043e\u0434\u0430 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430 \u0411\u043e\u0433\u0430\u043c, \u0430 \u0411\u043e\u0433 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u041c\u0430\u0440\u044b\u0456. \u0411\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0451, \u0430 \u041c\u0430\u0440\u044b\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0411\u043e\u0433\u0430. \u0411\u043e\u0433, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0443\u0441\u0451, \u0441\u0430\u043c \u0443\u0447\u044b\u043d\u0456\u045e \u0441\u044f\u0431\u0435 \u0437 \u041c\u0430\u0440\u044b\u0456; \u0456 \u0442\u0430\u043a \u0443\u0441\u0451, \u0448\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e, \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0430\u043d\u043e\u0432\u0430. \u0422\u043e\u0439, \u0445\u0442\u043e \u0437\u043c\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u0446\u044c \u0443\u0441\u0451 \u0437 \u043d\u0456\u0447\u043e\u0433\u0430, \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0446\u044c \u043f\u0430\u0448\u043a\u043e\u0434\u0436\u0430\u043d\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0431\u0435\u0437 \u041c\u0430\u0440\u044b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0411\u043e\u0433 &ndash; \u0433\u044d\u0442\u0430 \u0410\u0439\u0446\u0435\u0446 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0430 \u041c\u0430\u0440\u044b\u044f &ndash; \u041c\u0430\u0446\u0456 \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0411\u043e\u0433 &ndash; \u0433\u044d\u0442\u0430 \u0410\u0439\u0446\u0435\u0446 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u045e\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0430 \u041c\u0430\u0440\u044b\u044f &ndash; \u041c\u0430\u0446\u0456 \u045e\u0441\u044f\u043a\u0430\u0433\u0430 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u0442\u0430\u0433\u043e, \u043f\u0440\u0430\u0437 \u043a\u0430\u0433\u043e \u045e\u0441\u0451 \u0441\u0442\u0430\u043b\u0430 \u0456\u0441\u043d\u0430\u0432\u0430\u0446\u044c, \u0430 \u041c\u0430\u0440\u044b\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0442\u0430\u0433\u043e, \u043f\u0440\u0430\u0437 \u043a\u0430\u0433\u043e \u045e\u0441\u0451 \u0441\u0442\u0430\u043b\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u043c. \u0411\u043e\u0433 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u0442\u0430\u0433\u043e, \u0431\u0435\u0437 \u043a\u0430\u0433\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u0431 \u0437\u0443\u0441\u0456\u043c \u043d\u0456\u0447\u043e\u0433\u0430, \u0430 \u041c\u0430\u0440\u044b\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0442\u0430\u0433\u043e, \u0431\u0435\u0437 \u043a\u0430\u0433\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u0431 \u0434\u043e\u0431\u0440\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041e, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u041f\u0430\u043d \u0437 \u0422\u0430\u0431\u043e\u044e, \u044f\u043a\u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u0443\u0441\u044f \u043d\u0430\u0442\u0443\u0440\u0430 \u0456 \u0401\u043d \u0441\u0430\u043c \u0431\u044b\u043b\u0456 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u0434\u0437\u044f\u0447\u043d\u044b\u044f \u0422\u0430\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 34 (33), 4; 86 (85), 13; \u041b\u043a 1, 48<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0435\u043b\u0456\u0447\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0430 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u043c\u043d\u043e\u044e, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430 \u0434\u0430 \u043c\u044f\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0426\u044f\u043f\u0435\u0440 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u041c\u044f\u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0441\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430 \u0434\u0430 \u043c\u044f\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"608","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0424\u0430\u0443\u0441\u0442\u0430&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 20, 21: CSEL 25, 562-563)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u044b \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435\u043c \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e <\/span><\/em><em><span style=\"color: #ff0000;\">\u0443 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u0456 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456 \u043d\u0430\u0440\u043e\u0434 \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430 \u0448\u0430\u043d\u0443\u0435 \u043f\u0430\u043c\u044f\u0446\u044c \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e. \u041d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u044f\u0433\u043e \u0434\u0430 \u0431\u043e\u043b\u044c\u0448\u0430\u0433\u0430 \u0456\u0445 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0456 \u0434\u0430 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u0456\u0445\u043d\u0456\u0445 \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u0445, \u0430\u0434\u043d\u0430\u043a \u0442\u0430\u043a, \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u045e\u0437\u0432\u043e\u0434\u0437\u0456\u043b\u0456 \u0430\u043b\u0442\u0430\u0440\u044b \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u043c\u0443 \u0437 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e, \u043d\u0430\u0432\u0430\u0442 \u0443 \u043f\u044f\u043c\u044f\u0446\u044c \u043f\u0440\u0430 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0446\u0456 \u043a\u0430\u0437\u0430\u045e \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0441\u0430 \u0441\u043b\u0443\u0436\u044b\u0446\u0435\u043b\u044f\u045e, \u0441\u0442\u043e\u044f\u0447\u044b \u043f\u0440\u044b \u0430\u043b\u0442\u0430\u0440\u044b \u045e \u043c\u0435\u0441\u0446\u0430\u0445, \u0434\u0437\u0435 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u044e\u0446\u044c \u0446\u0435\u043b\u044b \u0441\u0432\u044f\u0442\u044b\u0445: &laquo;\u0422\u0430\u0431\u0435 \u0430\u0445\u0432\u044f\u0440\u0443\u0435\u043c, \u041f\u0451\u0442\u0440\u0430, \u0430\u0431\u043e \u041f\u0430\u045e\u043b\u0435, \u0430\u0431\u043e \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0435?&raquo; \u0410\u0434\u043d\u0430\u043a \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u045e \u0430\u0445\u0432\u044f\u0440\u0443, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u045e\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u045e \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e. \u0411\u043e\u0433 \u0443\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u045e \u0456\u0445 \u043f\u0430\u043c\u044f\u0442\u043d\u044b\u044f \u043c\u044f\u0441\u0446\u0456\u043d\u044b, \u043a\u0430\u0431 \u044f\u043d\u044b \u0430\u0431\u0443\u0434\u0437\u0456\u043b\u0456 \u045e \u043d\u0430\u0441 \u0433\u043b\u044b\u0431\u0435\u0439\u0448\u0430\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0451 \u0456 \u0436\u044b\u0432\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043c\u043e\u0436\u0430\u043c \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c, \u0456 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0437 \u0447\u044b\u0451\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u043c\u043e\u0436\u0430\u043c \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u044b \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0435\u043c \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0437 \u043f\u0430\u0448\u0430\u043d\u0430\u044e \u0456 \u043b\u044e\u0431\u043e\u045e\u044e, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0443 \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u045e\u0448\u0430-\u043d\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0411\u043e\u0436\u044b\u044f, \u0441\u044d\u0440\u0446\u044b \u044f\u043a\u0456\u0445, \u044f\u043a \u043c\u044b \u0430\u0434\u0447\u0443\u0432\u0430\u0435\u043c, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b \u0434\u0430 \u0442\u0430\u043a\u043e\u0439 \u043c\u0443\u043a\u0456 \u0437\u0430 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0443\u044e \u043f\u0440\u0430\u045e\u0434\u0443. \u0410\u0434\u043d\u0430\u043a \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u043c, \u044f\u043a\u0456\u044f, \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0448\u044b \u045e\u0441\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456, \u0443\u0436\u043e \u0446\u0435\u0448\u0430\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430\u0439 \u0443 \u0448\u0447\u0430\u0441\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0431\u043e\u0436\u043d\u0430 \u0430\u0434\u0434\u0430\u0435\u043c \u0445\u0432\u0430\u043b\u0443, \u0447\u044b\u043c \u0442\u044b\u043c, \u0445\u0442\u043e \u044f\u0448\u0447\u044d \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u043c\u0441\u044f \u043c\u044b \u0430\u0434\u043d\u0430\u043c\u0443 \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433\u0443, \u0456 \u0433\u044d\u0442\u044b \u043a\u0443\u043b\u044c\u0442 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u044f \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u042f\u043c\u0443, \u0456 \u043c\u044b \u0442\u0430\u043a \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0432\u0443\u0447\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u0433\u044d\u0442\u044b \u043a\u0443\u043b\u044c\u0442 \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u043d\u043d\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u0442\u043e \u0456\u0434\u0430\u043b\u0430\u043f\u0430\u043a\u043b\u043e\u043d\u0441\u0442\u0432\u0430\u043c \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u0430\u0445\u0432\u044f\u0440\u044b \u0456\u0434\u0430\u043b\u0430\u043c. \u041c\u044b \u043d\u0456 \u045e \u044f\u043a\u0456\u043c \u0440\u0430\u0437\u0435 \u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043c \u0442\u0430\u043a\u0456\u0445 \u0430\u0445\u0432\u044f\u0440\u0430\u045e \u0456 \u043d\u0435 \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u043c \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0456\u0445 \u044f\u043a\u043e\u043c\u0443\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0443, \u0434\u0443\u0448\u044b \u044f\u043a\u043e\u0433\u0430&not;\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0430\u0431\u043e \u044f\u043a\u043e\u043c\u0443-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0430\u043d\u0451\u043b\u0443. \u0406 \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u0445\u0442\u043e \u043f\u0430\u0434\u0434\u0430\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u0439 \u043f\u0430\u043c\u044b\u043b\u0446\u044b, \u0434\u0430\u043a\u0430\u0440\u0430\u0435 \u0437\u0434\u0430\u0440\u043e\u0432\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435, \u043a\u0430\u0431 \u0451\u043d \u0432\u044b\u043f\u0440\u0430\u0432\u0456\u045e\u0441\u044f \u0456 \u043a\u0430\u0431 \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u045e\u0441\u044f \u0433\u044d\u0442\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u0456 \u0441\u0432\u044f\u0442\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u043d\u0435 \u0436\u0430\u0434\u0430\u044e\u0446\u044c \u0441\u0430\u0431\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e, \u044f\u043a \u0432\u044f\u0434\u043e\u043c\u0430, \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0443. \u0413\u044d\u0442\u0430 \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0437\u0435 \u041f\u0430\u045e\u043b\u0430 \u0456 \u0411\u0430\u0440\u043d\u0430\u0431\u044b. \u041b\u0456\u043a\u0430\u043e\u043d\u0446\u044b, \u0443\u0437\u0440\u0443\u0448\u0430\u043d\u044b\u044f \u0446\u0443\u0434\u0430\u043c\u0456, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u044b\u043c\u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u0437\u0430\u0445\u0430\u0446\u0435\u043b\u0456 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0456\u043c \u0430\u0445\u0432\u044f\u0440\u044b \u044f\u043a \u0431\u0430\u0433\u0430\u043c. \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u043b\u0456 \u0441\u0432\u0430\u0435 \u0448\u0430\u0442\u044b \u0456, \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u044f\u043d\u044b \u043d\u0435 \u0431\u0430\u0433\u0456, \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u0456\u043b\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0430\u0431\u0435 \u0430\u0445\u0432\u044f\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0430\u0434\u043d\u043e \u0451\u0441\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u043c\u0443 \u0432\u0443\u0447\u044b\u043c, \u0430 \u0456\u043d\u0448\u0430\u0435 &ndash; \u0442\u043e\u0435, \u0448\u0442\u043e \u0446\u0435\u0440\u043f\u0456\u043c. \u0410\u0434\u043d\u043e &ndash; \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0437\u0430\u0433\u0430\u0434\u0430\u0446\u044c, \u0430 \u0456\u043d\u0448\u0430\u0435 &ndash; \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u043d\u0430 \u0432\u044b\u043f\u0440\u0430\u0432\u0456\u0446\u044c. \u0406 \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0432\u044b\u043f\u0440\u0430\u0432\u0456\u043c, \u043c\u044b \u0432\u044b\u043c\u0443\u0448\u0430\u043d\u044b \u0433\u044d\u0442\u0430 \u0446\u044f\u0440\u043f\u0435\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 116 (115), 15; 34 (33), 21; \u043f\u0430\u0440. \u042e\u0434\u0442 10, 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u0445. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0441\u0446\u0435\u0440\u0430\u0436\u044d \u045e\u0441\u0435 \u0456\u0445\u043d\u0456\u044f \u043a\u043e\u0441\u0442\u043a\u0456, \u043d\u0435 \u0437\u043b\u0430\u043c\u0430\u0435\u0446\u0446\u0430 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u044f \u0437 \u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u0448\u0430\u0442\u044b \u0430\u0441\u0430\u043b\u043e\u0434\u044b \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u0456\u0445 \u041f\u0430\u043d.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0441\u0446\u0435\u0440\u0430\u0436\u044d \u045e\u0441\u0435 \u0456\u0445\u043d\u0456\u044f \u043a\u043e\u0441\u0442\u043a\u0456, \u043d\u0435 \u0437\u043b\u0430\u043c\u0430\u0435\u0446\u0446\u0430 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u044f \u0437 \u0456\u0445.<\/p>\r\n"}, {"GCH_CH_2_ID":"609","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 &laquo;\u041f\u0440\u0430 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 12, 68. 74-75; 13, 77-78: PL 16 <\/span><br \/><span style=\"color: #ff0000;\">[edit. 1845], 281. 283. 285-286)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0411\u043b\u044f\u0441\u043a\u0430\u043c \u0440\u043e\u0437\u0443\u043c\u0443 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435\u0448 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0430\u0434\u0437\u0456\u043d\u0430\u044f \u0437 \u043d\u0430\u0440\u043e\u0434\u0443, \u0430\u0434\u0437\u0456\u043d\u0430\u044f \u0437 \u043b\u044e\u0434\u0443, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0442\u044b \u0430\u0434\u0437\u0456\u043d\u0430\u044f \u043c\u0456\u0436 \u0434\u0437\u0435\u0432\u0430\u045e, \u044f\u043a\u0430\u044f \u0431\u043b\u044f\u0441\u043a\u0430\u043c \u0440\u043e\u0437\u0443\u043c\u0443 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435\u0448 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0442\u044b \u044f\u0448\u0447\u044d \u0431\u043b\u0456\u0436\u044d\u0439 \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u0435\u0448\u0441\u044f \u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u041a\u0430\u043b\u0456 \u0442\u044b \u045e\u043d\u0430\u0447\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0448\u0441\u044f \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u043b\u043e\u0436\u044b, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439 \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u045e \u043a\u043e\u0436\u043d\u044b \u043c\u043e\u043c\u0430\u043d\u0442 \u0447\u0430\u043a\u0430\u0439 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u043e\u044e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0446\u044f\u0431\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u045e, \u0442\u0430\u043a\u043e\u044e \u0401\u043d \u0432\u044b&not;\u0431\u0440\u0430\u045e \u0446\u044f\u0431\u0435. \u0422\u0430\u043a, \u0401\u043d \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u0440\u0430\u0441\u0447\u044b\u043d\u0435\u043d\u044b\u044f \u0434\u0437\u0432\u0435\u0440\u044b, \u0431\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0430\u0434\u043c\u0430\u043d\u0443\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u043f\u0440\u044b\u0439\u0441\u0446\u0456. \u0414\u044b\u043a \u0430\u0431\u0434\u044b\u043c\u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0448\u0443\u043a\u0430\u043b\u0430; \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0441\u044f \u0434\u0430 \u042f\u0433\u043e, \u0456 \u043f\u0440\u0430\u0441\u0432\u044f\u0442\u043b\u0456\u0448\u0441\u044f; \u0442\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u042f\u0433\u043e \u0456 \u043f\u0440\u0430\u0441\u0456 \u043d\u0435 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0445\u0443\u0442\u043a\u0430, \u0443\u043f\u0440\u043e\u0448\u0432\u0430\u0439 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430. \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0436\u044b\u0432\u043e\u0435, \u0431\u0443\u0434\u0443\u0447\u044b \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u044b\u043c, \u044f\u0433\u043e \u043d\u0435 \u0441\u0445\u043e\u043f\u0456\u0448 \u0456, \u0431\u0443\u0434\u0443\u0447\u044b \u043d\u044f\u0434\u0431\u0430\u0439\u043d\u044b\u043c, \u043d\u0435 \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448. \u041d\u044f\u0445\u0430\u0439 \u0442\u0432\u0430\u044f \u0434\u0443\u0448\u0430 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0443\u0435\u0446\u0446\u0430 \u042f\u0433\u043e\u043d\u0430\u043c\u0443 \u0441\u043b\u043e\u0432\u0443, \u043d\u044f\u0445\u0430\u0439 \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430 \u0456\u0434\u0437\u0435 \u043f\u0430 \u0441\u043b\u044f\u0434\u0430\u0445 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f, \u0431\u043e \u044f\u043d\u043e \u043c\u043e\u0436\u0430 \u0445\u0443\u0442\u043a\u0430 \u043c\u0456\u043d\u0443\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0440\u044d\u0448\u0442\u044b, \u0448\u0442\u043e \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430? &laquo;\u042f \u0448\u0443\u043a\u0430\u043b\u0430 \u044f\u0433\u043e \u0456 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0430; \u044f \u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u044f\u0433\u043e, \u0430 \u0451\u043d \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435&raquo; (\u043f\u0430\u0440. \u041f\u043f 5, 6). \u041d\u0435 \u0434\u0443\u043c\u0430\u0439, \u0448\u0442\u043e \u0442\u044b, \u044f\u043a\u0430\u044f \u043a\u043b\u0456\u043a\u0430\u043b\u0430, \u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u0456 \u0440\u0430\u0441\u0447\u044b\u043d\u044f\u043b\u0430, \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0430 \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430, \u0430 \u0401\u043d \u0430\u0434\u044b\u0448\u043e\u045e. \u0401\u043d \u0447\u0430\u0441\u0442\u0430 \u043d\u0430\u0441 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435. \u0414\u0430\u0440\u044d\u0447\u044b, \u0448\u0442\u043e \u0401\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0443 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456 \u043d\u0430\u0442\u043e\u045e\u043f\u0443, \u044f\u043a\u0456 \u043f\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e \u043d\u0435 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c? &laquo;\u0406 \u0456\u043d\u0448\u044b\u043c \u0433\u0430\u0440\u0430\u0434\u0430\u043c \u041c\u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0414\u043e\u0431\u0440\u0443\u044e \u041d\u0430\u0432\u0456\u043d\u0443, \u0431\u043e \u042f \u0434\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u044b&raquo; (\u043f\u0430\u0440. \u041b\u043a 4, 43). \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0442\u0430\u0431\u0435 \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u0401\u043d \u0430\u0434\u044b\u0448\u043e\u045e, \u0432\u044b\u0439\u0434\u0437\u0456 \u0456 \u0448\u0443\u043a\u0430\u0439 \u042f\u0433\u043e \u0437\u043d\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0445\u0442\u043e \u0436 \u0456\u043d\u0448\u044b, \u044f\u043a \u043d\u0435 \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0446\u044f\u0431\u0435, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430? \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0451\u043d \u0443\u0436\u043e \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u0446\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u0422\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0448 \u0442\u043e\u0435, \u0448\u0442\u043e \u0447\u044b\u0442\u0430\u0435\u0448: &laquo;\u0406 \u043b\u0435\u0434\u0437\u044c\u0432\u0435 \u0430\u0434\u044b\u0448\u043b\u0430 \u0430\u0434 \u0456\u0445, \u044f \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043c\u0430\u044f \u0434\u0443\u0448\u0430 \u043a\u0430\u0445\u0430\u0435. \u042f \u0441\u0445\u0430\u043f\u0456\u043b\u0430 \u044f\u0433\u043e \u0456 \u043d\u0435 \u0430\u0434\u043f\u0443\u0448\u0447\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0447\u044b\u043c \u0436\u0430 \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430? \u042f\u0433\u043e \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0448 \u0456 \u043f\u0440\u044b\u0432\u044f\u0436\u0430\u0448 \u043d\u0435 \u043f\u0443\u0442\u0430\u043c\u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043d\u0435 \u0432\u0443\u0437\u043b\u0430\u043c\u0456 \u0432\u044f\u0440\u043e\u0432\u0430\u043a, \u0430\u043b\u0435 \u043f\u043e\u0432\u044f\u0437\u0437\u044e \u043b\u044e\u0431\u043e\u0432\u0456, \u0432\u0443\u0437\u0430\u043c\u0456 \u0440\u043e\u0437\u0443\u043c\u0443 \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u043f\u0430\u0447\u0443\u0446\u0446\u0451\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0456 \u0442\u044b \u0445\u043e\u0447\u0430\u0448 \u0443\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u0448\u0443\u043a\u0430\u0439 \u042f\u0433\u043e \u0456 \u043d\u0435 \u0431\u043e\u0439\u0441\u044f \u043a\u0430\u0440\u0430\u045e; \u0431\u043e \u0447\u0430\u0441\u0442\u0430 \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f\u045e, \u0443 \u0440\u0443\u043a\u0430\u0445 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0430\u045e \u043c\u043e\u0436\u043d\u0430 \u043b\u044f\u0433\u0447\u044d\u0439 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0406 \u043b\u0435\u0434\u0437\u044c\u0432\u0435 \u0430\u0434\u044b\u0448\u043b\u0430 \u0430\u0434 \u0456\u0445&raquo;. \u0411\u043e \u043f\u0440\u0430\u0437 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441 \u0456 \u043c\u043e\u043c\u0430\u043d\u0442, \u044f\u043a \u043f\u0440\u043e\u0439\u0434\u0437\u0435\u0448 \u043f\u0440\u0430\u0437 \u0440\u0443\u043a\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0430\u045e \u0456 \u043d\u0435 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0443\u0435\u0448\u0441\u044f \u045e\u043b\u0430\u0434\u0430\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u044b\u0439\u0434\u0437\u0435 \u0442\u0430\u0431\u0435 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447, \u043a\u0430\u0431 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u0446\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u044f, \u0445\u0442\u043e \u0442\u0430\u043a \u0448\u0443\u043a\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u042f\u0433\u043e, \u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u042f \u0441\u0445\u0430\u043f\u0456\u043b\u0430 \u044f\u0433\u043e \u0456 \u043d\u0435 \u0430\u0434\u043f\u0443\u0448\u0447\u0443, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u045e \u0434\u043e\u043c \u043c\u0430\u0451\u0439 \u043c\u0430\u0446\u0456 \u0456 \u045e \u043f\u0430\u043a\u043e\u0439 \u0442\u043e\u0439, \u044f\u043a\u0430\u044f \u043c\u044f\u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430&raquo; (\u043f\u0430\u0440. \u041f\u043f 3, 4). \u0427\u044b\u043c \u0436\u0430 \u0451\u0441\u0446\u044c \u0434\u043e\u043c \u0442\u0432\u0430\u0451\u0439 \u043c\u0430\u0446\u0456 \u0456 \u044f\u0435 \u043f\u0430\u043a\u043e\u0439, \u044f\u043a \u043d\u0435 \u0442\u0430\u0435\u043c\u043d\u0430\u0439 \u0433\u043b\u044b\u0431\u0456\u043d\u0451\u044e \u0442\u0432\u0430\u0451\u0439 \u043d\u0430\u0442\u0443\u0440\u044b?<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0433\u044d\u0442\u044b \u0434\u043e\u043c, \u0442\u0440\u044b\u043c\u0430\u0439 \u0443 \u0447\u044b\u0441\u0446\u0456\u043d\u0456 \u043f\u0430\u043a\u043e\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043e\u043c\u0443. \u0410 \u043a\u0430\u043b\u0456 \u0434\u043e\u043c \u0431\u0443\u0434\u0437\u0435 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b, \u0443\u0437\u043d\u044f\u0441\u0435\u0446\u0446\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0434\u043e\u043c \u044f\u043a \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u043a\u0440\u0430\u0435\u0432\u0443\u0433\u043e\u043b\u044c\u043d\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u0456, \u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0430\u0441\u0435\u043b\u0456\u0446\u0446\u0430 \u045e \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u044f, \u0445\u0442\u043e \u0442\u0430\u043a \u0448\u0443\u043a\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0442\u0430\u043a \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u0430\u044f \u0406\u043c. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0447\u0430\u0441\u0442\u0430 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u0446\u044c \u044f\u0435, \u0431\u043e \u0401\u043d \u0437 \u043d\u0430\u043c\u0456 \u0434\u0430 \u0441\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0435 \u041f\u0430\u043d \u0430\u0434\u0430\u0440\u044b\u045e \u0446\u044f\u0431\u0435 \u043c\u043e\u0446\u0430\u0439. \u0422\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u0411\u043e\u0433\u0430 \u0456 \u045e \u043b\u044e\u0434\u0437\u0435\u0439: \u043f\u0435\u0440\u0430\u0434 \u0443\u043b\u0430\u0434\u0430\u0440\u043e\u043c \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u043b\u0430 \u043c\u0443\u0434\u0440\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u041f\u0430\u043d \u0443\u0441\u0456\u0445 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u044f\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u044d\u0442\u0430 \u0434\u0437\u0435\u0432\u0430, \u044f\u043a\u0430\u044f \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0430 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435 \u041f\u0430&shy;\u043d\u0443 \u0436\u044b\u043b\u043b\u0451 \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u041f\u0430\u043d \u0443\u0441\u0456\u0445 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u044f\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"610","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0414\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u043f\u0435\u0441\u043d\u044f&raquo; \u0441\u0432. \u042f\u043d\u0430 \u0430\u0434 \u041a\u0440\u044b\u0436\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Red. B, str. 36-37, Edit. E. Pacho, S. Juan de la Cruz,<\/span><br \/><span style=\"color: #ff0000;\">Obras completas, Burgos, 1982, pp. 1124-1135)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u0439 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u0441\u0432\u044f\u0442\u044b\u044f \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0456 \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0456 \u0448\u043c\u0430\u0442 \u0442\u0430\u044f\u043c\u043d\u0456\u0446 \u0456 \u0446\u0443\u0434\u0430\u045e, \u0430 \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u044f \u0434\u0443\u0448\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043b\u0456 \u0456\u0445 \u0443 \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u0430\u0434\u043d\u0430\u043a \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0456\u0445 \u0447\u0430\u0441\u0442\u043a\u0443 \u044f\u0448\u0447\u044d \u0442\u0440\u044d\u0431\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0441\u043a\u0440\u044b\u0446\u044c, \u0430\u043b\u0435 \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u043f\u0430\u0433\u043b\u044b\u0431\u043b\u044f\u0446\u0446\u0430 \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0448\u0447\u043e\u0434\u0440\u0430\u0439 \u043a\u0430\u043f\u0430\u043b\u044c\u043d\u0456, \u0443 \u043d\u0435\u0442\u0440\u0430\u0445 \u044f\u043a\u043e\u0439 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0441\u043a\u0430\u0440\u0431\u0430\u045e. \u0406 \u044f\u043a \u0431\u044b \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043d\u0435 \u043a\u0430\u043f\u0430\u045e, \u0443\u0441\u0451 \u0440\u043e\u045e\u043d\u0430 \u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u043d\u0456 \u044f\u0435 \u0434\u043d\u0430, \u043d\u0456 \u043c\u0435\u0436\u0430\u045e. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0442\u043e \u0442\u0443\u0442, \u0442\u043e \u0442\u0430\u043c \u0443 \u043a\u043e\u0436\u043d\u044b\u043c \u0437\u0430\u043a\u0443\u0442\u043a\u0443 \u043c\u043e\u0436\u043d\u0430 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u043d\u043e\u0432\u044b\u044f \u0437\u0430\u043b\u0435\u0436\u044b \u043d\u043e\u0432\u0430\u0433\u0430 \u0431\u0430\u0433\u0430\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430: &laquo;\u0423 \u0456\u043c \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u045e\u0441\u0435 \u0441\u043a\u0430\u0440\u0431\u044b \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f&raquo; (\u041a\u043b\u0441 2, 3). \u0414\u0443\u0448\u0430 \u043c\u043e\u0436\u0430 \u043f\u0440\u0430\u043d\u0456\u043a\u043d\u0443\u0446\u044c \u0443 \u0456\u0445 \u0456 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0456\u0445, \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0439\u0448\u043e\u045e\u0448\u044b \u043f\u0440\u0430\u0437 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0446\u044f\u0436\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b, \u043f\u0440\u0430\u0437 \u0443\u043d\u0443\u0442\u0440\u0430\u043d\u044b\u044f \u0456 \u0432\u043e\u043d\u043a\u0430\u0432\u044b\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456. \u0414\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0441\u043f\u044f\u0440\u0448\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0440\u0430\u0437\u0443\u043c\u043e\u0432\u044b\u044f \u0456 \u043f\u0430\u0447\u0443\u0446\u0446\u0451\u0432\u044b\u044f \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u0456 \u043f\u0440\u0430\u0439\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u0434\u043e\u045e\u0433\u0456\u044f \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430 \u043d\u0430\u043c\u0435\u0440\u0443 \u043f\u0440\u0430\u043d\u0456\u043a\u043d\u0443\u0446\u044c \u0443 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456\u044f \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e, \u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0437\u0430 \u045e\u0441\u0451, \u0447\u0430\u0433\u043e \u043c\u043e\u0436\u043d\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0431\u044b \u043b\u044e\u0434\u0437\u0456, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u043f\u0440\u044b\u0437\u043d\u0430\u043b\u0456, \u0448\u0442\u043e \u043d\u0456\u044f\u043a \u043d\u0435 \u045e\u0434\u0430\u0441\u0446\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0433\u043b\u044b\u0431\u0456\u043d\u044f\u045e \u0431\u0430\u0433\u0430\u0446\u0446\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0439, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0440\u043e\u0439\u0434\u0437\u0435\u0448 \u0441\u043f\u044f\u0440\u0448\u0430 \u043f\u0440\u0430\u0437 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0446\u044f\u0436\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b \u0456 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u043a\u0430\u0431 \u0434\u0443\u0448\u0430 \u0441\u0443\u0446\u0435\u0448\u044b\u043b\u0430\u0441\u044f \u0456 \u043d\u0430\u0442\u0430\u043b\u0456\u043b\u0430 \u0441\u0432\u0430\u0451 \u0436\u0430\u0434\u0430\u043d\u043d\u0435. \u0411\u043e \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u043f\u0430\u0436\u0430\u0434\u0430\u0446\u044c \u0411\u043e\u0436\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0434\u0443\u0448\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0433\u043b\u044b\u0431\u0456\u043d\u044e \u043a\u0440\u044b\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u042d\u0444\u0435\u0441\u0446\u0430\u045e \u043d\u0435 \u0441\u0442\u0430\u043c\u043b\u044f\u0446\u0446\u0430 \u045e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u0456, &laquo;\u0443\u043a\u0430\u0440\u0430\u043d\u0456\u045e\u0448\u044b\u0441\u044f \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e\u0448\u044b\u0441\u044f \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0437 \u0443\u0441\u0456\u043c\u0456 \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0447\u044b\u043c \u0451\u0441\u0446\u044c \u0448\u044b\u0440\u044b\u043d\u044f \u0456 \u0434\u0430\u045e\u0436\u044b\u043d\u044f, \u0456 \u0432\u044b\u0448\u044b\u043d\u044f, \u0456 \u0433\u043b\u044b\u0431\u0456\u043d\u044f, \u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435, \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u045e\u0441\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u043e\u044e \u0411\u043e\u0436\u0430\u0439&raquo; (\u043f\u0430\u0440. \u042d\u0444 3, 17).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u043c\u0430\u0439, \u044f\u043a\u0430\u044f \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0431\u0430\u0433\u0430\u0446\u0446\u044f, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043a\u0440\u044b\u0436, \u0456 \u0433\u044d\u0442\u0430\u044f \u0431\u0440\u0430\u043c\u0430 \u0432\u0443\u0437\u043a\u0430\u044f. \u041c\u043d\u043e\u0433\u0456\u044f \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0430\u043c\u0456\u0445 \u0437\u0430\u0434\u0430\u0432\u0430\u043b\u044c\u043d\u0435\u043d\u043d\u044f\u045e, \u044f\u043a\u0456\u044f \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u0437\u0430 \u0431\u0440\u0430\u043c\u0430\u0439, \u0456 \u0437\u0443\u0441\u0456\u043c \u043d\u044f\u0448\u043c\u0430\u0442 \u043b\u044e\u0434\u0437\u0435\u0439 \u0436\u0430\u0434\u0430\u0435 \u043f\u0440\u0430\u0439\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 2, 9-10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0427\u0430\u0433\u043e \u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430, \u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430, \u0456 \u0448\u0442\u043e \u043d\u0435 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0442\u043e\u0435 \u0411\u043e\u0433 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u043c \u0411\u043e\u0433 \u0430\u0434\u043a\u0440\u044b\u045e \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u043e\u0435 \u0411\u043e\u0433 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"611","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0432\u043e\u0440\u044b \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u041a\u0430\u043d\u0456\u0437\u0456\u044f, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Edit. O. Braunsberger, Petri Canisii Epistulae et Acta, I, <\/span><br \/><span style=\"color: #ff0000;\">Friburgi Brisgoviae, 1896, pp. 53-55)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0422\u044b \u0432\u0435\u0434\u0430\u0435\u0448, \u041f\u0430\u043d\u0435, \u0443 \u044f\u043a\u043e\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u0456 \u043a\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437\u043e\u045e &ndash; <\/span><\/em><br \/><em><span style=\"color: #ff0000;\">\u0443 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0434\u0437\u0435\u043d\u044c &ndash; \u0422\u044b \u0434\u0430\u0440\u0443\u0447\u0430\u045e \u043c\u043d\u0435 \u0413\u0435\u0440\u043c\u0430\u043d\u0456\u044e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u0432. \u041f\u0451\u0442\u0440 \u041a\u0430\u043d\u0456\u0437\u0456\u0439, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u043f\u0440\u044b\u0431\u044b\u045e \u0443 \u0413\u0435\u0440\u043c\u0430\u043d\u0456\u044e, \u044f\u043a\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0440\u0443\u0433\u0456\u043c \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c, \u0451\u043d \u0431\u044b\u045e \u0434\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u044b \u045e \u043d\u0430\u0439\u0433\u043b\u044b\u0431\u0435\u0439\u0448\u044b\u0445 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u0445 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0401\u043d \u0441\u0430\u043c \u0430\u043f\u0456\u0441\u0432\u0430\u0435 \u0433\u044d\u0442\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456:<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0421\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b \u041f\u0430\u0441\u0442\u044b\u0440, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0432\u0430\u0451\u0439 \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u044f \u0437\u043c\u043e\u0433 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0430\u0434 \u0422\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u0443 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0435 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u043f\u043b\u0451\u043d \u043c\u0430\u0451\u0439 \u043f\u0440\u0430\u0446\u044b \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044b\u0432\u0430\u043b\u044b. \u0422\u0430\u043c \u044f \u0430\u0434\u0447\u0443\u045e \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u0456 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0422\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456, \u0448\u0442\u043e \u0431\u044b\u043b\u0430 \u045e\u0434\u0437\u0435\u043b\u0435\u043d\u0430 \u043c\u043d\u0435 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u0433\u044d\u0442\u044b\u0445 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430\u045e. \u0406 \u044f\u043d\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u043b\u0456 \u043c\u044f\u043d\u0435, \u0456 \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u043b\u0456 \u043c\u0430\u044e \u043c\u0456\u0441\u0456\u044e \u045e \u0413\u0435\u0440\u043c\u0430\u043d\u0456\u0456, \u0456, \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u043b\u0456 \u043c\u043d\u0435 \u0441\u0432\u0430\u044e \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u044f\u043a \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0443 \u0413\u0435\u0440\u043c\u0430\u043d\u0456\u0456. \u0422\u044b \u0432\u0435\u0434\u0430\u0435\u0448, \u041f\u0430\u043d\u0435, \u0443 \u044f\u043a\u043e\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u0456 \u043a\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437\u043e\u045e &ndash; \u0443 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0434\u0437\u0435\u043d\u044c &ndash; \u0422\u044b \u0434\u0430\u0440\u0443\u0447\u0430\u045e \u043c\u043d\u0435 \u0413\u0435\u0440\u043c\u0430\u043d\u0456\u044e, \u0434\u0430 \u044f\u043a\u043e\u0439 \u044f \u043f\u0430\u0437\u043d\u0435\u0439 \u0441\u0442\u0430\u045e \u043d\u0435\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430, \u0443 \u044f\u043a\u043e\u0439 \u043f\u0440\u0430\u0433\u043d\u0443\u045e \u0436\u044b\u0446\u044c \u0456 \u043f\u0430\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0422\u044b \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043c\u043d\u0435 \u043f\u0456\u0446\u044c \u0437 \u0432\u044b\u0442\u043e\u043a\u0430\u045e \u0430\u0434\u043a\u0440\u044b\u0442\u0430\u0433\u0430 \u0421\u044d\u0440\u0446\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0433\u0430 \u0426\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u044f, \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0431\u0430\u0447\u044b\u045e, \u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u045e \u0447\u044d\u0440\u043f\u0430\u0446\u044c \u0432\u0430\u0434\u0443 \u043c\u0430\u0439\u0433\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0437 \u0422\u0432\u0430\u0456\u0445 \u043a\u0440\u044b\u043d\u0456\u0446, \u0417\u0431\u0430\u045e\u0446\u0430 \u043c\u043e\u0439. \u042f \u0436 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0436\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u043f\u0430\u0442\u043e\u043a\u0456 \u0432\u0435\u0440\u044b, \u043d\u0430\u0434\u0437\u0435\u0456 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0430\u0434\u0442\u0443\u043b\u044c \u0434\u0430 \u043c\u044f\u043d\u0435. \u042f \u043f\u0440\u0430\u0433\u043d\u0443\u045e \u0443\u0431\u043e\u0441\u0442\u0432\u0430, \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456, \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456. \u041f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u045e, \u043a\u0430\u0431 \u0422\u044b \u0430\u0431\u043c\u044b\u045e \u043c\u044f\u043d\u0435, \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u0456 \u0430\u0437\u0434\u043e\u0431\u0456\u045e. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u044f \u0430\u0434\u0432\u0430\u0436\u044b\u045e\u0441\u044f \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u0446\u0446\u0430 \u0434\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u0430\u0433\u0430 \u0421\u044d\u0440\u0446\u0430 \u0456 \u043d\u0430\u0442\u0430\u043b\u0456\u0446\u044c \u0443 \u0456\u043c \u0441\u0432\u0430\u044e \u0441\u043c\u0430\u0433\u0443, \u0422\u044b \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u043c\u043d\u0435 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443, \u0441\u0430\u0442\u043a\u0430\u043d\u0443\u044e \u0437 \u0442\u0440\u043e\u0445 \u0447\u0430\u0441\u0442\u0430\u043a, \u044f\u043a\u0430\u044f \u043c\u0430\u0433\u043b\u0430 \u0431 \u043f\u0440\u044b\u043a\u0440\u044b\u0446\u044c \u0433\u043e\u043b\u0443\u044e \u0434\u0443\u0448\u0443 \u0456 \u044f\u043a\u0430\u044f \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u043c\u043d\u0435 \u0434\u043b\u044f \u0433\u044d\u0442\u0430\u0439 \u043c\u0456\u0441\u0456\u0456: \u0441\u043f\u0430\u043a\u043e\u0439, \u043b\u044e\u0431\u043e\u045e \u0456 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0410\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u0433\u044d\u0442\u044b\u044f \u0437\u0431\u0430\u045e\u0447\u044b\u044f \u0448\u0430\u0442\u044b, \u044f \u0432\u0435\u0440\u044b\u045e, \u0448\u0442\u043e \u044f \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u0431\u0443\u0434\u0443 \u043c\u0435\u0446\u044c \u043d\u044f\u0441\u0442\u0430\u0447\u044b, \u0430\u043b\u0435 \u045e\u0441\u0435 \u043c\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044b \u043f\u0440\u044b\u0447\u044b\u043d\u044f\u0446\u0446\u0430 \u0434\u0430 \u0422\u0432\u0430\u0451\u0439 \u0445\u0432\u0430\u043b\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 13, 52; \u043f\u0430\u0440. \u041f\u0440\u044b\u043f 14, 33<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u044f\u043b\u044f\u043a\u0456 \u043a\u043d\u0456\u0436\u043d\u0456\u043a, \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b \u043f\u0440\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435, <span style=\"color: #ff0000;\">*<\/span> \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430, \u044f\u043a\u0456 \u0432\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0430 \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u044b \u0441\u0432\u0430\u0451\u0439 \u043d\u043e\u0432\u0430\u0435 \u0456 \u0441\u0442\u0430\u0440\u043e\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u0441\u044d\u0440\u0446\u044b \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0451\u043d \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0443\u0441\u0456\u0445 \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430, \u044f\u043a\u0456 \u0432\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0430 \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u044b \u0441\u0432\u0430\u0451\u0439 \u043d\u043e\u0432\u0430\u0435 \u0456 \u0441\u0442\u0430\u0440\u043e\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"612","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u043f\u0430\u043f\u044b \u041a\u043b\u0456\u043c\u044d\u043d\u0442\u0430 XIII<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(2 febr. 1767: Bullarii romani continuatio, IV, <\/span><br \/><span style=\"color: #ff0000;\">pars II, Pratis 1843, pp. 1314-1316)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0423 \u044f\u0433\u043e \u0441\u044d\u0440\u0446\u044b \u0456 \u043d\u0430 \u044f\u0433\u043e \u0432\u0443\u0441\u043d\u0430\u0445 \u0431\u044b\u045e \u0430\u0434\u0437\u0456\u043d \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0441\u043f\u0440\u044d\u0447\u0432\u0430\u0446\u044c, \u0448\u0442\u043e \u042f\u043d \u041a\u0435\u043d\u0446\u043a\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u0430\u0440\u0442\u044b \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0437\u0430\u043b\u0456\u0447\u0430\u043d\u044b\u043c \u0434\u0430 \u0442\u044b\u0445 \u043d\u044f\u043c\u043d\u043e\u0433\u0456\u0445 \u0432\u044b\u0434\u0430\u0442\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u043b\u0456\u0441\u044f \u0432\u0435\u0440\u0430\u0439 \u0456 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0432\u0430\u0456\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u043d\u0430\u0432\u0443\u0447\u0430\u043b\u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0432\u0435\u0440\u044b \u0456 \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u043b\u0456 \u044f\u0435 \u0430\u0434 \u043d\u0430\u043f\u0430\u0434\u0430\u045e \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a\u0430\u045e. \u0412\u044f\u0434\u043e\u043c\u0430, \u0448\u0442\u043e \u045e \u041a\u0440\u0430\u043a\u0430\u045e\u0441\u043a\u0430\u0439 \u0430\u043a\u0430\u0434\u044d\u043c\u0456\u0456 \u0451\u043d \u043f\u0435\u0440\u0430\u0434\u0430\u0432\u0430\u045e \u0432\u0443\u0447\u044d\u043d\u043d\u0435, \u043f\u0430\u0447\u044d\u0440\u043f\u043d\u0443\u0442\u0430\u0435 \u0437 \u043d\u0430\u0439\u0447\u044b\u0441\u0446\u0435\u0439\u0448\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b. \u0425\u043e\u0446\u044c \u0443 \u0442\u043e\u0439 \u0447\u0430\u0441 \u0443 \u0456\u043d\u0448\u044b\u0445, \u043d\u0435 \u0432\u0435\u043b\u044c\u043c\u0456 \u0434\u0430\u043b\u0451\u043a\u0456\u0445 \u0440\u044d\u0433\u0456\u0451\u043d\u0430\u0445, \u043b\u044e\u0442\u0430\u0432\u0430\u043b\u0456 \u0435\u0440\u0430\u0441\u0456 \u0456 \u0441\u0445\u0456\u0437\u043c\u044b, \u0451\u043d \u043f\u0440\u043e\u043f\u0430\u0432\u0435\u0434\u0434\u0437\u044e \u0437 \u043a\u0430\u0442\u044d\u0434\u0440\u044b \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u043f\u0440\u044b\u0432\u0456\u0432\u0430\u045e \u043d\u0430\u0440\u043e\u0434\u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u043c\u0430\u0440\u0430\u043b\u044c\u043d\u0430\u0439 \u0434\u044b\u0441\u0446\u044b\u043f\u043b\u0456\u043d\u0435, \u0430\u0431 \u044f\u043a\u043e\u0439 \u0441\u0432\u0435\u0434\u0447\u044b\u045e \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u043a\u043e\u0440\u0430\u044e, \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044e, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e, \u0443\u0442\u0430\u0439\u043c\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0446\u0435\u043b\u0430 \u0456 \u0456\u043d\u0448\u044b\u043c\u0456 \u0446\u043d\u043e\u0442\u0430\u043c\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u0456 \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u0446\u0430\u045e\u043d\u0456\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u0451\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0442\u0430\u045e \u0430\u0437\u0434\u043e\u0431\u0430\u044e \u0456 \u043a\u0440\u0430\u0441\u043e\u044e \u0432\u044b\u043a\u043b\u0430\u0434\u0447\u044b\u043a\u0430\u045e \u0433\u044d\u0442\u0430\u0439 \u0410\u043a\u0430\u0434\u044d\u043c\u0456\u0456, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0430 \u0434\u0437\u0456\u0432\u0430 \u043a\u0430\u0440\u044b\u0441\u043d\u044b \u0456 \u0434\u043e\u0431\u0440\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0443\u0441\u0456\u043c, \u0445\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0437\u0430\u0434\u0430\u043d\u043d\u0435, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430 \u0456 \u045e\u0441\u044f\u043b\u044f\u043a \u0456\u043c\u043a\u043d\u0443\u043b\u0456\u0441\u044f \u0440\u0443\u043f\u043d\u0430\u0441\u0446\u044e \u0456 \u043f\u0440\u0430\u0446\u0430\u044e \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u043f\u0440\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u0456\u043d\u0448\u0430\u043c\u0443 \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0437 \u044f\u043a\u043e\u044e \u0451\u043d \u0432\u044b\u043a\u043b\u0430\u0434\u0430\u045e \u0411\u043e\u0436\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435, \u0434\u0430\u043b\u0443\u0447\u0430\u043b\u0430\u0441\u044f \u043f\u0430\u043a\u043e\u0440\u0430. \u0422\u0430\u043c\u0443 \u0451\u043d \u043b\u0456\u0447\u044b\u045e \u0441\u044f\u0431\u0435 \u043d\u0456\u0447\u044b\u043c \u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0441\u0442\u0430\u0432\u0456\u045e \u0441\u044f\u0431\u0435 \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456, \u0445\u043e\u0446\u044c \u0443 \u0432\u0435\u0434\u0430\u0445 \u0451\u043d \u043c\u043e\u0433 \u043b\u0451\u0433\u043a\u0430 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0441\u0446\u0456 \u045e\u0441\u0456\u0445. \u041d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0436\u0430\u0434\u0430\u045e \u043d\u0430\u0432\u0430\u0442, \u043a\u0430\u0431 \u0456\u043c \u0443\u0441\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043b\u0456 \u0456 \u043d\u0430 \u044f\u0433\u043e \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u0437\u0432\u044b\u0441\u043e\u043a\u0443. \u0401\u043d \u0431\u044b\u045e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u0447\u0443\u0436\u0430\u043d\u044b, \u0448\u0442\u043e \u043d\u0435\u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0441\u044f\u0431\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u0456\u043c \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u045e, \u0437\u043d\u043e\u0441\u0456\u045e \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u0433\u043e\u043d\u0430\u0439 \u043f\u0430\u043a\u043e\u0440\u044b \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u043b\u0430 \u0440\u044d\u0434\u043a\u0430\u0441\u043d\u0430\u044f \u0434\u0437\u0456\u0446\u044f\u0447\u0430\u044f \u043f\u0440\u0430\u0441\u0442\u0430\u0442\u0430. \u0422\u0430\u043a, \u0443 \u044f\u0433\u043e\u043d\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u0445 \u0456 \u0441\u043b\u043e\u0432\u0430\u0445 \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u0430\u0433\u0430, \u043d\u0456\u0447\u043e\u0433\u0430 \u0432\u044b\u0434\u0443\u043c\u0430\u043d\u0430\u0433\u0430. \u0428\u0442\u043e \u0431\u044b\u043b\u043e \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u045e \u0441\u044d\u0440\u0446\u044b, \u043f\u0440\u0430 \u0442\u043e\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u045e. \u0406 \u043a\u0430\u043b\u0456 \u043f\u0430\u0434\u0430\u0437\u0440\u0430\u0432\u0430\u045e, \u0448\u0442\u043e \u044f\u0433\u043e\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0445\u043e\u0446\u044c \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f, \u043c\u043e\u0433\u0443\u0446\u044c \u0430\u0431\u0443\u0434\u0437\u0456\u0446\u044c \u0443 \u0456\u043d\u0448\u044b\u0445 \u043a\u0440\u044b\u045e\u0434\u0443, \u0442\u043e \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u043f\u0430\u0434\u044b\u0441\u0446\u0456 \u0434\u0430 \u0430\u043b\u0442\u0430\u0440\u0430, \u043f\u0430\u043a\u043e\u0440\u043d\u0430 \u043f\u0440\u0430\u0441\u0456\u045e \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u044f \u043d\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430 \u0441\u0432\u0430\u044e, \u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u0430 \u0447\u0443\u0436\u0443\u044e \u043f\u0430\u043c\u044b\u043b\u043a\u0443. \u0428\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430, \u043f\u0430\u0441\u043b\u044f \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0443, \u0437 \u0432\u0443\u0447\u044d\u043b\u044c\u043d\u0456 \u0451\u043d \u0430\u0434\u0440\u0430\u0437\u0443 \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u045e\u0441\u044f \u043f\u0440\u043e\u0441\u0442\u0430 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0434\u0437\u0435 \u0434\u043e\u045e\u0433\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u045e \u0456 \u045e\u0437\u043d\u043e\u0441\u0456\u045e \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u045e \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0456. \u0423 \u044f\u0433\u043e \u0441\u044d\u0440\u0446\u044b \u0456 \u043d\u0430 \u044f\u0433\u043e \u0432\u0443\u0441\u043d\u0430\u0445 \u0431\u044b\u045e \u0430\u0434\u0437\u0456\u043d \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 58, 7-8<\/span><br \/>\u041d. \u041a\u0430\u043b\u0456 \u0430\u0434\u0434\u0430\u0441\u0456 \u0433\u0430\u043b\u043e\u0434\u043d\u0430\u043c\u0443 \u0441\u0432\u043e\u0439 \u0445\u043b\u0435\u0431 \u0456 \u0434\u0443\u0448\u0443 \u0433\u0430\u0440\u043e\u0442\u043d\u0456\u043a\u0430 \u043d\u0430\u0441\u044b\u0446\u0456\u0448, <span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u0434\u044b \u0437\u0430\u0437\u0437\u044f\u0435, \u044f\u043a \u0441\u0432\u0456\u0442\u0430\u043d\u0430\u043a, \u0442\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e, \u0456 \u0442\u0432\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0448 \u0433\u043e\u043b\u0430\u0433\u0430, \u0430\u043f\u0440\u0430\u043d\u0456 \u044f\u0433\u043e, \u0456 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437 \u0442\u0430\u0431\u043e\u0439 \u0430\u0434\u043d\u0430\u0433\u043e \u0446\u0435\u043b\u0430, \u043d\u0435 \u045e\u043a\u0440\u044b\u0432\u0430\u0439\u0441\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u0434\u044b \u0437\u0430\u0437\u0437\u044f\u0435, \u044f\u043a \u0441\u0432\u0456\u0442\u0430\u043d\u0430\u043a, \u0442\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e, \u0456 \u0442\u0432\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e.<\/p>\r\n"}, {"GCH_CH_2_ID":"613","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0424\u0443\u043b\u044c\u0433\u0435\u043d\u0442\u044b\u044f \u0420\u0443\u0441\u043f\u0435\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 3, 1-3. 5-6: CCL 91 A, 905-909)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0417\u0431\u0440\u043e\u044f \u043b\u044e\u0431\u043e\u0432\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0447\u043e\u0440\u0430 \u043c\u044b \u0430\u0434\u0437\u043d\u0430\u0447\u044b\u043b\u0456 \u0437\u044f\u043c\u043d\u043e\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430; \u0441\u0451\u043d\u043d\u044f \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u043c \u0442\u0440\u044b\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0443\u044e \u043c\u0443\u043a\u0443 \u0436\u0430\u045e\u043d\u0435\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0447\u043e\u0440\u0430 \u043d\u0430\u0448 \u0412\u0430\u043b\u0430\u0434\u0430\u0440, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u0448\u0430\u0442\u044b \u0446\u0435\u043b\u0430, \u043d\u0430\u0432\u0435\u0434\u0430\u045e \u0441\u0432\u0435\u0442, \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0437 \u043f\u0430\u043b\u0430\u0446\u0443 \u0434\u0437\u044f\u0432\u043e\u0447\u0430\u0433\u0430 \u045e\u043b\u043e\u043d\u043d\u044f. \u0421\u0451\u043d\u043d\u044f \u0436\u0430\u045e\u043d\u0435\u0440, \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0437 \u0448\u0430\u0442\u0440\u0430 \u0446\u0435\u043b\u0430, \u044f\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430 \u0430\u0434\u044b\u0448\u043e\u045e \u0443 \u043d\u0435\u0431\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u043d\u0430\u0448 \u0412\u0430\u043b\u0430\u0434\u0430\u0440 &ndash; \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b, \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441 \u045e \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0456, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437 \u043f\u0443\u0441\u0442\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456. \u0401\u043d \u043f\u0440\u044b\u043d\u0451\u0441 \u0441\u0432\u0430\u0456\u043c \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0456 \u0434\u0430\u0440, \u044f\u043a\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u0447\u043e\u0434\u0440\u0430 \u0456\u0445 \u0443\u0437\u0431\u0430\u0433\u0430\u0446\u0456\u045e, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0437\u0431\u0440\u043e\u0456\u045e \u0434\u0430 \u043d\u0435\u043f\u0435\u0440\u0430\u043c\u043e\u0436\u043d\u0430\u0433\u0430 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f. \u0401\u043d \u043f\u0440\u044b\u043d\u0451\u0441 \u0434\u0430\u0440 \u043b\u044e\u0431\u043e\u0432\u0456, \u043a\u0430\u0431 \u044f\u043d\u0430 \u043f\u0440\u044b\u0432\u044f\u043b\u0430 \u043b\u044e\u0434\u0437\u0435\u0439 \u0434\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0437 \u0411\u043e\u0433\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u0451\u0441, \u0440\u0430\u0437\u0434\u0430\u045e, \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0441\u0430\u0431\u0435 \u043d\u0456\u0447\u043e\u0433\u0430, \u0430\u043b\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0443\u0437\u0431\u0430\u0433\u0430\u0446\u0456\u045e \u0441\u0432\u0430\u0456\u0445 \u0443\u0431\u043e\u0433\u0456\u0445 \u0432\u0435\u0440\u043d\u044b\u0445 \u0456 \u0441\u0430\u043c \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u043f\u043e\u045e\u043d\u044b\u043c \u043d\u0435\u0432\u044b\u0447\u0430\u0440\u043f\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u043a\u0430\u0440\u0431\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u044f \u0436 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0430\u044f \u043f\u0440\u044b\u0432\u044f\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437 \u043d\u0435\u0431\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0443\u0437\u043d\u044f\u043b\u0430 \u0421\u0442\u044d\u0444\u0430\u043d\u0430 \u0437 \u0437\u044f\u043c\u043b\u0456 \u045e \u043d\u0435\u0431\u0430. \u0422\u0430\u044f \u0436 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0430\u044f \u0440\u0430\u043d\u0435\u0439 \u043f\u0440\u0430\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0432\u0430 \u0423\u043b\u0430\u0434\u0430\u0440\u044b, \u043f\u0430\u0441\u043b\u044f \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u045e \u0436\u0430\u045e\u043d\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u044d\u0444\u0430\u043d, \u043a\u0430\u0431 \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0432\u044f\u043d\u043e\u043a \u0434\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0456\u043c\u044f, \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u045e \u043b\u044e\u0431\u043e\u045e \u044f\u043a \u0437\u0431\u0440\u043e\u044e \u0456 \u045e\u0441\u044e\u0434\u044b \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u045e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0451\u0439. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u044e\u0431\u043e\u0432\u0456 \u0451\u043d \u043d\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u045e \u043f\u0435\u0440\u0430\u0434 \u0440\u0430\u0437&rsquo;\u044e\u0448\u0430\u043d\u044b\u043c\u0456 \u044e\u0434\u044d\u044f\u043c\u0456, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0451\u043d \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u0433\u043e \u043a\u0430\u043c\u0435\u043d\u0430\u0432\u0430\u045e. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u044e\u0431\u043e\u0432\u0456 \u0451\u043d \u0441\u043f\u0440\u0430\u0447\u0430\u045e\u0441\u044f \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u043f\u0430\u043c\u044b\u043b\u044f\u045e\u0441\u044f, \u043a\u0430\u0431 \u0432\u044b\u043f\u0440\u0430\u0432\u0456\u0446\u044c \u0456\u0445. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u044e\u0431\u043e\u0432\u0456 \u0451\u043d \u043c\u0430\u043b\u0456\u045e\u0441\u044f, \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u044f\u0433\u043e \u043a\u0430\u043c\u0435\u043d\u0430\u0432\u0430\u045e, \u043d\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0441\u0456\u043b\u044b \u043b\u044e\u0431\u043e\u0432\u0456 \u0451\u043d \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u043b\u044e\u0442\u0430\u0441\u0446\u044c \u0421\u0430\u045e\u043b\u0430 \u0456 \u0437\u0434\u0430\u0431\u044b\u045e \u044f\u043a \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u044f\u0433\u043e. \u0413\u044d\u0442\u0430\u044f \u0436 \u0441\u0432\u044f\u0442\u0430\u044f \u0456 \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0436\u0430\u0434\u0430\u043b\u0430 \u043d\u0430\u0431\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u043d\u0430\u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440 \u0441\u0430 \u0421\u0442\u044d\u0444\u0430\u043d\u0430\u043c \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u041f\u0430\u0432\u0435\u043b, \u0441\u0430 \u0421\u0442\u044d\u0444\u0430\u043d\u0430\u043c \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u044f\u0441\u043d\u0430\u0441\u0446\u044e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439, \u0441\u0430 \u0421\u0442\u044d\u0444\u0430\u043d\u0430\u043c \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430, \u0441\u0430 \u0421\u0442\u044d\u0444\u0430\u043d\u0430\u043c \u043f\u0430\u043d\u0443\u0435. \u0411\u043e \u043a\u0443\u0434\u044b \u0441\u043f\u044f\u0440\u0448\u0430 \u043f\u0430\u0439\u0448\u043e\u045e \u0421\u0442\u044d\u0444\u0430\u043d, \u0437\u0430\u0431\u0456\u0442\u044b \u043a\u0430\u043c\u044f\u043d\u044f\u043c\u0456 \u041f\u0430\u045e\u043b\u0430, \u0442\u0443\u0434\u044b \u043f\u0430\u0439\u0448\u043e\u045e \u0437\u0430 \u0456\u043c \u0456 \u041f\u0430\u0432\u0435\u043b, \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u043d\u044b \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c\u0456 \u0421\u0442\u044d\u0444\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u043c\u0430\u0435 \u0431\u0440\u0430\u0442\u044b. \u041f\u0430\u0432\u0435\u043b \u043d\u0435 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u0431\u0456\u045e \u0421\u0442\u044d\u0444\u0430\u043d\u0430, \u0430 \u0421\u0442\u044d\u0444\u0430\u043d \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u041f\u0430\u0432\u0435\u043b \u0441\u0442\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u043c \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c, \u0431\u043e \u043b\u044e\u0431\u043e\u045e \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0430\u0431\u043e\u0434\u0432\u0443\u0445. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u043b\u044e\u0431\u043e\u045e \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0430 \u045e \u0421\u0442\u044d\u0444\u0430\u043d\u0435 \u043b\u044e\u0442\u0430\u0441\u0446\u044c \u044e\u0434\u044d\u044f\u045e, \u043b\u044e\u0431\u043e\u045e \u0443 \u041f\u0430\u045e\u043b\u0435 \u043f\u0430\u043a\u0440\u044b\u043b\u0430 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0433\u0440\u0430\u0445\u043e\u045e, \u043b\u044e\u0431\u043e\u045e \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430 \u0437\u0440\u0430\u0431\u0456\u043b\u0430 \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u0430\u0431\u043e\u0434\u0432\u0443\u0445 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0431\u043e\u045e &ndash; \u0433\u044d\u0442\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0456 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0443\u0441\u0456\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u0432\u044b\u0434\u0430\u0442\u043d\u0430\u044f \u0430\u0431\u0430\u0440\u043e\u043d\u0430, \u0434\u0430\u0440\u043e\u0433\u0430, \u0448\u0442\u043e \u0432\u044f\u0434\u0437\u0435 \u045e \u043d\u0435\u0431\u0430. \u0425\u0442\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u0446\u044c \u0456 \u0431\u0430\u044f\u0446\u0446\u0430. \u042f\u043d\u0430 \u0441\u0430\u043c\u0430 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435, \u0441\u0430\u043c\u0430 \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0435, \u0441\u0430\u043c\u0430 \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u0446\u044c.<br \/>\u0411\u0440\u0430\u0442\u044b, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043b\u0435\u0441\u0432\u0456\u0446\u0443 \u043b\u044e\u0431\u043e\u0432\u0456, \u043f\u0430 \u044f\u043a\u043e\u0439 \u043a\u043e\u0436\u043d\u044b \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d \u043c\u043e\u0436\u0430 \u043f\u0430\u0434\u043d\u044f\u0446\u0446\u0430 \u045e \u043d\u0435\u0431\u0430, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u043c\u0443\u0436\u043d\u0430 \u0447\u044b\u0441\u0442\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0439\u0446\u0435 \u044f\u0435 \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e \u0456 \u043f\u0430\u0434\u044b\u043c\u0430\u0439\u0446\u0435\u0441\u044f, \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u044e\u0447\u044b \u045e \u0451\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0447\u043e\u0440\u0430 \u041f\u0430\u043d \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u0421\u0442\u044d\u0444\u0430\u043d \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445. \u041f\u0430\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0441\u0432\u0435\u0442, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0421\u0442\u044d\u0444\u0430\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0447\u043e\u0440\u0430 \u043d\u0430\u0448 \u0412\u0430\u043b\u0430\u0434\u0430\u0440, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u0448\u0430\u0442\u044b \u0446\u0435\u043b\u0430, \u043d\u0430\u0432\u0435\u0434\u0430\u045e \u0441\u0432\u0435\u0442, \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0437 \u043f\u0430\u043b\u0430\u0446\u0443 \u0434\u0437\u044f\u0432\u043e\u0447\u0430\u0433\u0430 \u045e\u043b\u043e\u043d\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0421\u0442\u044d\u0444\u0430\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"614","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0441\u0432. \u042f\u043d\u0430&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 1, 1. 3: PL 35, 1978. 1980)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0416\u044b\u0446\u0446\u0451 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u0446\u0435\u043b\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0422\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0448\u0442\u043e \u043c\u044b \u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u0421\u043b\u043e\u0432\u0430 \u0436\u044b\u0446\u0446\u044f, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u043b\u0456 \u043d\u0430 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b, \u043d\u0430 \u0448\u0442\u043e \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u0456 \u0434\u0430 \u0447\u0430\u0433\u043e \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u043b\u0456\u0441\u044f \u043d\u0430\u0448\u044b\u044f \u0440\u0443\u043a\u0456&raquo; (1 \u042f\u043d 1, 1). \u042f\u043a \u0436\u0430 \u043c\u043e\u0436\u043d\u0430 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u0440\u0443\u043a\u0430\u043c\u0456 \u0434\u0430 \u0421\u043b\u043e\u0432\u0430? \u0422\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u043c\u0456 (\u043f\u0430\u0440. \u042f\u043d 1, 14).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u0435 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u0421\u043b\u043e\u0432\u0430, \u043a\u0430\u0431 \u0434\u0430 \u042f\u0433\u043e \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u0440\u0443\u043a\u0430\u043c\u0456, \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c \u0437 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456. \u0410\u043b\u0435 \u043d\u0435 \u0442\u0430\u0434\u044b \u043f\u0430\u0447\u0430\u043b\u043e \u0431\u044b\u0446\u044c \u0421\u043b\u043e\u0432\u0430\u043c, \u0431\u043e \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430, \u0448\u0442\u043e &laquo;\u0431\u044b\u043b\u043e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443&raquo;. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0446\u0456 \u043d\u0435 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u042f\u043d\u0430\u0432\u0430 \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u044f\u0433\u043e\u043d\u044b\u043c \u0436\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435\u043c, \u044f\u043a\u043e\u0435 \u0432\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u0442\u043e \u0447\u0443\u043b\u0456. &laquo;\u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430, \u0456 \u0421\u043b\u043e\u0432\u0430 \u0431\u044b\u043b\u043e \u045e \u0411\u043e\u0433\u0430&raquo; (\u042f\u043d 1, 1).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0433\u0447\u044b\u043c\u0430, \u0443 \u043d\u0435\u043a\u0430\u0433\u0430 \u0441\u043a\u043b\u0430\u0434\u0437\u0435\u0446\u0446\u0430 \u045e\u0440\u0430\u0436\u0430\u043d\u043d\u0435, \u0448\u0442\u043e \u0421\u043b\u043e\u0432\u0430 \u0436\u044b\u0446\u0446\u044f \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0430\u043e\u0433\u0443\u043b, \u0430 \u043d\u0435 \u0434\u0430 \u0441\u0430\u043c\u043e\u0433\u0430 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u043c\u043e\u0436\u043d\u0430 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u0440\u0443\u043a\u0430\u043c\u0456. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0448\u0442\u043e \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u0434\u0430\u043b\u0435\u0439: &laquo;\u0416\u044b\u0446\u0446\u0451 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f&raquo; (1 \u042f\u043d 1, 2). \u0422\u0430\u043c\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0433\u044d\u0442\u0430 \u0421\u043b\u043e\u0432\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u044f\u043d\u043e \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f? \u042f\u043d\u043e \u0431\u044b\u043b\u043e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0430\u043b\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u0431\u0430\u0447\u043d\u0430\u0435 \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439, \u0430\u0434\u043d\u0430\u043a \u044f\u043d\u043e \u0431\u044b\u043b\u043e \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u0430 \u0430\u043d\u0451\u043b\u0430\u043c, \u044f\u043a\u0456\u044f \u0431\u0430\u0447\u044b\u043b\u0456 \u044f\u0433\u043e \u0456 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043b\u0456 \u044f\u043a \u0441\u0432\u043e\u0439 \u0445\u043b\u0435\u0431. \u0410\u043b\u0435 \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435? &laquo;\u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u045e \u0445\u043b\u0435\u0431 \u0430\u043d\u0451\u043b\u0430\u045e&raquo; (\u041f\u0441 78 [77], 25).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0416\u044b\u0446\u0446\u0451 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u0446\u0435\u043b\u0435; \u044f\u043d\u043e \u0441\u0442\u0430\u043b\u0430 \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u044b\u043c, \u043a\u0430\u0431 \u0440\u044d\u0447\u044b, \u044f\u043a\u0456\u044f \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u044d\u0440\u0446\u0430\u043c, \u0430\u0434\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0430\u0447\u0430\u043c, \u0456 \u0430\u0437\u0434\u0430\u0440\u0430\u0432\u0456\u043b\u0456 \u0441\u044d\u0440\u0446\u044b. \u0411\u043e \u0421\u043b\u043e\u0432\u0430 \u043c\u043e\u0436\u043d\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u044d\u0440\u0446\u0430\u043c, \u0430 \u0446\u0435\u043b\u0430 \u043c\u043e\u0436\u043d\u0430 \u0431\u0430\u0447\u044b\u0446\u044c \u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430. \u0406 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0421\u043b\u043e\u0432\u0430: \u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c, \u044f\u043a\u043e\u0435 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0431\u0430\u0447\u044b\u0446\u044c, \u0456 \u0441\u044d\u0440\u0446\u0430 \u0431\u044b\u043b\u043e \u0430\u0437\u0434\u0430\u0440\u043e\u045e\u043b\u0435\u043d\u0430 \u045e \u043d\u0430\u0441, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u0421\u043b\u043e\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d \u043a\u0430\u0436\u0430: &laquo;\u041c\u044b \u0441\u0432\u0435\u0434\u0447\u044b\u043c \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0432\u0430\u043c \u0433\u044d\u0442\u0430\u0435 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u045e \u0410\u0439\u0446\u0430 \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u043c&raquo; (\u043f\u0430\u0440. 1 \u042f\u043d 1, 2), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043f\u0430\u043c\u0456\u0436 \u043d\u0430\u0441, \u0430 \u043a\u0430\u0436\u0443\u0447\u044b \u0431\u043e\u043b\u044c\u0448 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0422\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0456 \u0447\u0443\u043b\u0456, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0456 \u0432\u0430\u043c&raquo; (1 \u042f\u043d 1, 3). \u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u0430 \u043b\u044e\u0431\u043e\u045e \u0434\u043e\u0431\u0440\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435: &laquo;\u0422\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0456 \u0447\u0443\u043b\u0456, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0456 \u0432\u0430\u043c&raquo;. \u042f\u043d\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u0430\u043c\u043e\u0433\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u045e \u0443 \u0446\u0435\u043b\u0435, \u0456 \u0447\u0443\u043b\u0456 \u0441\u043b\u043e\u0432\u044b \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u041f\u0430\u043d\u0430, \u0456 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u043b\u0456 \u043d\u0430\u043c. \u0410 \u043c\u044b \u043f\u0430\u0447\u0443\u043b\u0456, \u0430\u043b\u0435 \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u043c\u044b \u043c\u0435\u043d\u0448 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u0430\u0447\u044b\u045e \u0456 \u0447\u0443\u045e? \u041d\u0430 \u0433\u044d\u0442\u0430\u0435 \u043f\u044b\u0442\u0430\u043d\u043d\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435: &laquo;\u041a\u0430\u0431 \u0456 \u0432\u044b \u043c\u0435\u043b\u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0437 \u043d\u0430\u043c\u0456&raquo; (1 \u042f\u043d 1, 3). \u042f\u043d\u044b \u0431\u0430\u0447\u044b\u043b\u0456, \u043c\u044b \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456, \u0430\u0434\u043d\u0430\u043a \u043c\u044b \u043c\u0430\u0435\u043c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0437 \u0456\u043c\u0456, \u0431\u043e \u0442\u0440\u044b\u043c\u0430\u0435\u043c\u0441\u044f \u0430\u0434\u043d\u043e\u0439 \u0432\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0410 \u043d\u0430\u0448\u0430\u044f \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0451\u0441\u0446\u044c \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0421\u044b\u043d\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u043c, \u0415\u0437\u0443\u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u0413\u044d\u0442\u0430 \u043f\u0456\u0448\u0430\u043c \u043c\u044b, &ndash; \u0434\u0430\u0434\u0430\u0435 \u042f\u043d, &ndash; \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u044f \u0431\u044b\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u0439&raquo; (\u043f\u0430\u0440. 1 \u042f\u043d 1, 3-4). \u0401\u043d \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u043f\u0430\u045e\u043d\u0430\u0442\u0443 \u0433\u044d\u0442\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u045e \u0442\u043e\u0439 \u0441\u0430\u043c\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u0443 \u0442\u043e\u0439 \u0441\u0430\u043c\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0443 \u0442\u043e\u0439 \u0441\u0430\u043c\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u042f\u043d, \u044f\u043a\u0456 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u045e \u043d\u0430 \u0433\u0440\u0443\u0434\u0437\u044f\u0445 \u041f\u0430\u043d\u0430 \u043f\u0430\u0434\u0447\u0430\u0441 \u0432\u044f\u0447\u044d\u0440\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0430\u043f\u043e\u0441\u0442\u0430\u043b, \u044f\u043a\u043e\u043c\u0443 \u0430\u0434\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u043d\u0430\u0442\u0430\u043b\u0456\u045e\u0441\u044f \u043f\u0430\u0442\u043e\u043a\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0437 \u0441\u0430\u043c\u043e\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0441\u044d\u0440\u0446\u0430 \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0430\u043f\u043e\u0441\u0442\u0430\u043b, \u044f\u043a\u043e\u043c\u0443 \u0430\u0434\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"615","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041a\u0432\u043e\u0434\u0432\u0443\u043b\u044c\u0442\u0434\u044d\u0443\u0441\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 2 de Symbolo: PL 40, 655)<\/span><br \/><em><span style=\"color: #ff0000;\">\u042f\u043d\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u0433\u0430\u0432\u043e\u0440\u0430\u0446\u044c, \u0430\u043b\u0435 \u045e\u0436\u043e \u0432\u044b\u0437\u043d\u0430\u044e\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044f\u043b\u0456\u043a\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u044f\u043a \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0430\u0435 \u041d\u0435\u043c\u0430\u045e\u043b\u044f. \u0417\u043e\u0440\u043a\u0430 \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0434\u0430\u043b\u0451\u043a \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e. \u042f\u043d\u044b \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u044f\u0448\u0447\u044d \u043b\u044f\u0436\u044b\u0446\u044c \u0443 \u044f\u0441\u043b\u044f\u0445, \u0430\u043b\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u043d\u0435\u0431\u0435 \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u041a\u0430\u043b\u0456 \u043c\u0443\u0434\u0440\u0430\u0446\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440, \u0406\u0440\u0430\u0434 \u0445\u0432\u0430\u043b\u044e\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u043c\u043e\u0436\u0430 \u0441\u0442\u0440\u0430\u0446\u0456\u0446\u044c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0456 \u0445\u043e\u0447\u0430 \u0437\u0430\u0431\u0456\u0446\u044c \u0442\u0430\u0433\u043e, \u0443 \u043a\u0430\u0433\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e\u0448\u044b, \u043c\u043e\u0433 \u0431\u044b \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u0456 \u045e \u0437\u044f\u043c\u043d\u044b\u043c, \u0456 \u045e \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u044b\u043c \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u0433\u043e \u0442\u044b \u0431\u0430\u0456\u0448\u0441\u044f, \u0406\u0440\u0430\u0434, \u043a\u0430\u043b\u0456 \u0447\u0443\u0435\u0448, \u0448\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0412\u0430\u043b\u0430\u0434\u0430\u0440? \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0435 \u0430\u0434\u0445\u0456\u043b\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u0430\u0434 \u0443\u043b\u0430\u0434\u044b, \u0430\u043b\u0435 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0447\u044b \u0434&rsquo;\u044f\u0431\u043b\u0430. \u0410\u043b\u0435 \u0442\u044b, \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u0433\u0430, \u0445\u0432\u0430\u043b\u044e\u0435\u0448\u0441\u044f \u0456 \u0448\u0430\u043b\u0435\u0435\u0448. \u041a\u0430\u0431 \u0437\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0448\u0443\u043a\u0430\u0435\u0448, \u0442\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0448\u0441\u044f \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c \u0437\u0430\u0431\u043e\u0439\u0446\u0430\u043c \u043c\u043d\u043e\u0433\u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u0431\u0435 \u043d\u0435 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043d\u0456 \u0433\u0430\u043b\u0430\u0448\u044d\u043d\u043d\u0435 \u043b\u044e\u0431\u044f\u0447\u044b\u0445 \u043c\u0430\u0446\u0456, \u043d\u0456 \u0430\u0439\u0446\u043e\u045e, \u0448\u0442\u043e \u0430\u043f\u043b\u0430\u043a\u0432\u0430\u044e\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0437\u044f\u0446\u0435\u0439, \u043d\u0456 \u0435\u043d\u043a\u0456 \u0456 \u043f\u043b\u0430\u0447 \u041d\u0435\u043c\u0430\u045e\u043b\u044f\u0442. \u0421\u0442\u0440\u0430\u0445, \u044f\u043a\u0456 \u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u0446\u044f\u0431\u0435 \u045e \u0441\u044d\u0440\u0446\u044b, \u043f\u0430\u0434\u0448\u0442\u0443\u0440\u0445\u043e\u045e\u0432\u0430\u0435 \u0446\u044f\u0431\u0435 \u0437\u0430\u0431\u0456\u0432\u0430\u0446\u044c \u0434\u0437\u044f\u0446\u0435\u0439. \u0422\u044b \u0434\u0443\u043c\u0430\u0435\u0448, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0441\u043f\u043e\u045e\u043d\u0456\u0448 \u0437\u0430\u0434\u0443\u043c\u0430\u043d\u0430\u0435, \u0442\u043e \u0437\u043c\u043e\u0436\u0430\u0448 \u0434\u043e\u045e\u0433\u0430 \u0436\u044b\u0446\u044c, \u0445\u043e\u0446\u044c \u0456\u043c\u043a\u043d\u0435\u0448\u0441\u044f \u0437\u0430\u0431\u0456\u0446\u044c \u0441\u0430\u043c\u043e \u0416\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0401\u043d, \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u043b\u0430\u0441\u043a\u0456, \u0442\u0430\u043a\u0456 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0456 \u0456 \u0442\u0430\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0456, \u043b\u044f\u0436\u044b\u0446\u044c \u0443 \u044f\u0441\u043b\u044f\u0445 \u0456 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0435 \u0442\u0432\u0430\u0439\u043c\u0443 \u0442\u0440\u043e\u043d\u0443. \u0425\u043e\u0446\u044c \u0442\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0448, \u0430\u043b\u0435 \u0401\u043d \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u043f\u0440\u0430\u0437 \u0446\u044f\u0431\u0435 \u0441\u0432\u0430\u0435 \u043f\u043b\u0430\u043d\u044b \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435 \u0434\u0443\u0448\u044b \u0437 \u043d\u044f\u0432\u043e\u043b\u0456 \u0434&rsquo;\u044f\u0431\u043b\u0430. \u0401\u043d \u043f\u0440\u044b\u043c\u0430\u0435 \u0434\u0437\u044f\u0446\u0435\u0439 \u0432\u043e\u0440\u0430\u0433\u0430 \u045e \u043b\u0456\u043a \u0443\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u044b \u043d\u0435\u0441\u0432\u044f\u0434\u043e\u043c\u0430 \u0433\u0456\u043d\u0443\u0446\u044c \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u0430\u0446\u044c\u043a\u0456 \u0430\u043f\u043b\u0430\u043a\u0432\u0430\u044e\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e. \u0410 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0440\u043e\u0431\u0456\u0446\u044c \u0441\u0432\u0430\u0456\u043c\u0456 \u043a\u0440\u0430\u0441\u0430\u043c\u043e\u045e\u043d\u044b\u043c\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u0448\u0447\u044d \u043d\u0435 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c. \u0412\u043e\u0441\u044c \u044f\u043a \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0442\u0430\u043a \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c. \u0412\u043e\u0441\u044c \u0443\u0436\u043e \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435 \u0412\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u0435\u043b\u044c, \u0456 \u0434\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0417\u0431\u0430\u045e\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0442\u044b, \u0406\u0440\u0430\u0434, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u0433\u0430, \u0445\u0432\u0430\u043b\u044e\u0435\u0448\u0441\u044f \u0456 \u0448\u0430\u043b\u0435\u0435\u0448. \u0423 \u0442\u043e\u0439 \u0447\u0430\u0441, \u044f\u043a \u043b\u044e\u0442\u0443\u0435\u0448 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u041d\u0435\u043c\u0430\u045e\u043b\u044f\u0446\u0456, \u0442\u044b \u045e\u0436\u043e \u043d\u0435\u0441\u0432\u044f\u0434\u043e\u043c\u0430 \u0430\u0434\u0434\u0430\u0435\u0448 \u044f\u043c\u0443 \u043f\u0430\u0448\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0432\u044f\u043b\u0456\u043a\u0456 \u0434\u0430\u0440 \u043b\u0430\u0441\u043a\u0456! \u0417\u0430 \u044f\u043a\u0456\u044f \u0436 \u0437\u0430\u0441\u043b\u0443\u0433\u0456 \u041d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u0430\u043c \u043d\u0430\u043a\u0430\u043d\u0430\u0432\u0430\u043d\u0430 \u0442\u0430\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430? \u042f\u043d\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u0433\u0430\u0432\u043e\u0440\u0430\u0446\u044c, \u0430\u043b\u0435 \u0432\u044b\u0437\u043d\u0430\u044e\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430. \u042f\u043d\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0430\u0434\u043d\u044f\u0446\u0446\u0430 \u043d\u0430 \u0431\u0456\u0442\u0432\u0443, \u0430 \u045e\u0436\u043e \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0432\u044f\u043d\u043e\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u043f 5, 14; 4, 10; 7, 11<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0456\u0441\u044f \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0456\u0434\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u0435 \u0432\u044f\u043d\u043a\u0456 \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u045e\u043f\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c \u043d\u0430 \u0441\u0432\u0430\u0435 \u0442\u0432\u0430\u0440\u044b, \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u043b\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0456\u0434\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u0435 \u0432\u044f\u043d\u043a\u0456 \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"616","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0422\u043e\u043c\u0430\u0441\u0430 \u0411\u044d\u043a\u0435\u0442\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 74: PL 190, 533-536)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u044f\u043d\u043e\u043a \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, <\/span><\/em><em><span style=\"color: #ff0000;\">\u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043c\u044b \u0441\u0442\u0430\u0440\u0430\u0435\u043c\u0441\u044f \u0431\u044b\u0446\u044c \u0442\u044b\u043c\u0456, \u043a\u0456\u043c \u043d\u0430\u0437\u0432\u0430\u043d\u044b\u044f &ndash; \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c\u0456 \u0456 \u043f\u0430\u043d\u0442\u044b\u0444\u0456\u043a\u0430\u043c\u0456, &ndash; \u0456 \u0445\u043e\u0447\u0430\u043c \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430 \u043f\u0440\u0430 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u0456\u043c\u0435\u043d\u0456, \u043d\u0430\u043c \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043f\u0440\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0410\u0439\u0446\u0435\u0446 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0421\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u043d\u0430\u0432\u0435\u043a\u0456, \u0456 \u0456\u0441\u0446\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0441\u043b\u044f\u0434\u0430\u043c\u0456. \u0401\u043d \u043f\u0440\u044b\u043d\u0451\u0441 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0410\u0439\u0446\u0443 \u043d\u0430 \u0430\u043b\u0442\u0430\u0440\u044b \u043a\u0440\u044b\u0436\u0430 \u0456 \u0437 \u0432\u044b\u0448\u044b\u043d\u0456 \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043d\u0430\u0437\u0456\u0440\u0430\u0435 \u0437\u0430 \u043d\u0430\u0448\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0456 \u043d\u0430\u043c\u0435\u0440\u0430\u043c\u0456, \u043a\u0430\u0431 \u0443 \u043a\u0430\u043d\u0446\u044b \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043f\u0440\u0430\u0432\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u042f\u0433\u043e\u043d\u044b\u0445 \u0444\u0443\u043d\u043a\u0446\u044b\u0439 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0441\u043b\u0430\u045e\u043d\u0430\u0435 \u0456\u043c\u044f \u0456 \u0433\u043e\u043d\u0430\u0440 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0436\u044b\u043d\u0430\u0435\u043c \u0447\u0430\u0441\u043e\u0432\u044b \u043f\u043b\u0451\u043d \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043f\u0440\u0430\u0446\u044b. \u0423 \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u043c\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u043f\u0430\u0441\u043b\u044f\u0434\u043e\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456\u0445 \u043c\u0443\u0436\u043e\u045e \u043d\u0430 \u0456\u0445 \u043f\u0430\u0441\u0430\u0434\u0430\u0445, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0431\u044b\u043b\u0430 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u045e\u043b\u0430\u0434\u0430 \u0433\u0440\u0430\u0445\u0443 \u0456 \u0441\u043c\u0435\u0440\u0446\u0456, \u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u0456 \u043f\u043e\u0441\u0442\u0443\u043f\u0443 \u045e \u0446\u043d\u043e\u0442\u0430\u0445 \u0431\u0443\u0434\u044b\u043d\u0430\u043a \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b \u045e\u043a\u0430\u0440\u0430\u043d\u044f\u045e\u0441\u044f \u0456 \u0440\u0430\u0437\u0440\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u044f\u043a \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0430\u044f. \u041f\u0430\u0434\u0447\u0430\u0441 \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f \u043c\u044b \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u043b\u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u0430, \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u0430 \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u043f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0456 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u0446\u043a\u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0456 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u0432\u044b\u0437\u043d\u0430\u0451\u043c \u0433\u044d\u0442\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456. \u0410\u043b\u0435 \u0433\u0430\u043b\u043e\u045e\u043d\u0430\u0435, \u043a\u0430\u0431 \u0433\u044d\u0442\u0430\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u044f \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u043b\u0430\u0441\u044f \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u0441\u043f\u0440\u0430\u0432\u044b! \u0416\u043d\u0456\u0432\u043e, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u0456 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u044f\u0433\u043e \u0456 \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u0446\u044c \u0443 \u0436\u044b\u0442\u043d\u0456\u0446\u044b \u041f\u0430\u043d\u0430, \u043d\u0435 \u0445\u043e\u043f\u0456\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u0430\u0431\u043e \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0436 \u0441\u0443\u043c\u043d\u044f\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u0440\u044b\u043c\u0441\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b &ndash; \u0433\u044d\u0442\u0430 \u0433\u0430\u043b\u0430\u0432\u0430 \u045e\u0441\u0456\u0445 \u043a\u0430\u0441\u0446\u0451\u043b\u0430\u045e \u0456 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0430\u0433\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f? \u0425\u0442\u043e \u0436 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u043a\u043b\u044e\u0447\u044b \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u044b \u041f\u044f\u0442\u0440\u0443? \u0426\u0456 \u045e\u0441\u044f \u0431\u0443\u0434\u043e\u0432\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043d\u0435 \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0432\u0435\u0440\u0443 \u0456 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u041f\u044f\u0442\u0440\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u043c\u044b \u045e\u0441\u0435 \u043d\u0435 \u0441\u0442\u0430\u043d\u0435\u043c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u044b \u0456 \u045e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456 \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e \u0448\u043c\u0430\u0442 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u0435\u0435, \u0448\u043c\u0430\u0442 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u043b\u0456\u0432\u0430\u0435, \u0431\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0435 \u0441\u043b\u043e\u0432\u0430 \u0456 \u044f\u0433\u043e \u043f\u0430\u0448\u044b\u0440\u044d\u043d\u043d\u0435 \u043c\u0456\u0436 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u0425\u043e\u0446\u044c \u0434\u0430\u045e\u043d\u0456 \u043d\u0430\u0440\u043e\u0434 \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u043c\u0435\u045e \u0430\u0434\u0437\u0456\u043d \u0430\u043b\u0442\u0430\u0440, \u0451\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043c\u0435\u0446\u044c \u0448\u043c\u0430\u0442 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u045e. \u0410 \u0448\u0442\u043e \u045e\u0436\u043e \u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u0441\u0445\u043e\u0434 \u0456 \u043d\u0430\u043f\u043b\u044b\u045e \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a\u0456\u043c \u043d\u0435 \u0445\u043e\u043f\u0456\u0446\u044c \u041b\u0456\u0431\u0430\u043d\u0430 \u0434\u043b\u044f \u0430\u0445\u0432\u044f\u0440\u043d\u0430\u0433\u0430 \u0430\u0433\u043d\u044e, \u0430 \u0434\u043b\u044f \u045e\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u043d\u0435 \u0445\u043e\u043f\u0456\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0436\u044b\u0432\u0451\u043b \u041b\u0456\u0431\u0430\u043d\u0430, \u0430\u043b\u0435 \u0456 \u0446\u044d\u043b\u0430\u0439 \u042e\u0434\u044d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0445\u0442\u043e \u0431 \u043d\u0456 \u043f\u0430\u043b\u0456\u0432\u0430\u045e \u0456 \u043d\u0456 \u0441\u0435\u044f\u045e, \u0411\u043e\u0433 \u0434\u0430\u0435 \u0440\u043e\u0441\u0442 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u0435\u0435 \u045e \u0432\u0435\u0440\u044b \u041f\u044f\u0442\u0440\u0430 \u0456 \u0445\u0442\u043e \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u043b\u0443\u0448\u043d\u0430, \u0448\u0442\u043e \u0434\u0430 \u041f\u044f\u0442\u0440\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u043d\u0430\u0439\u0432\u044f\u043b\u0456\u043a\u0448\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0456\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0430\u0446\u0446\u0430 \u0420\u044b\u043c\u0441\u043a\u0456\u043c \u041f\u0430\u043d\u0442\u044b\u0444\u0456\u043a\u0430\u043c, \u0430 \u0441\u043b\u0443\u0436\u044b\u0446\u0435\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430-\u041c\u0430\u0446\u0456 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b \u044f\u043c\u0443, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0440\u0443\u043f\u043b\u0456\u0432\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0443\u044e \u0456\u043c \u0443\u043b\u0430\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u044f\u043a \u0431\u044b\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u044f \u0430\u0439\u0446\u044b \u043d\u0430\u0448\u044b\u044f, \u044f\u043a \u0456 \u045e \u044f\u043a\u0456\u043c \u0443\u0446\u0456\u0441\u043a\u0443 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u045e \u0456 \u043f\u0430\u0448\u044b\u0440\u0430\u045e\u0441\u044f \u041a\u0430\u0441\u0446\u0451\u043b; \u0437 \u044f\u043a\u0456\u0445 \u0431\u0443\u0440\u0430\u045e \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u041f\u044f\u0442\u0440\u043e\u0432\u044b \u043a\u0430\u0440\u0430\u0431\u0435\u043b\u044c, \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u043c \u044f\u043a\u043e\u0433\u0430 \u0431\u044b\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441; \u044f\u043a \u0434\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u0432\u044f\u043d\u043a\u0430 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456 \u0442\u044b\u044f, \u0447\u044b\u044f \u0432\u0435\u0440\u0430 \u0432\u0430 \u045e\u0446\u0456\u0441\u043a\u0443 \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u044f\u0441\u043d\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0448\u044d\u0440\u0430\u0433\u0456 \u045e\u0441\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445 \u043a\u0440\u043e\u0447\u0430\u0446\u044c \u043d\u0430\u043f\u0435\u0440\u0430\u0434, \u043a\u0430\u0431 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u045e\u0434\u0430\u0439, \u0448\u0442\u043e \u0432\u044f\u043d\u043e\u043a \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 (\u043f\u0430\u0440. 2 \u0426\u0456\u043c 2, 5).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u043a\u0430\u0440\u0430\u043d\u0443\u0435 \u0446\u044f\u0431\u0435 \u0432\u044f\u043d\u043a\u043e\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0443 \u0448\u0430\u0442\u044b \u0445\u0432\u0430\u043b\u044b \u0441\u0432\u0430\u0451\u0439 \u0430\u043f\u0440\u0430\u043d\u0435 \u0446\u044f\u0431\u0435 \u0411\u043e\u0433, \u0421\u0432\u044f\u0442\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u045e \u0434\u043e\u0431\u0440\u0430\u0439 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435 \u0456 \u0437\u0430\u0432\u044f\u0440\u0448\u044b\u045e \u0441\u0432\u043e\u0439 \u0431\u0435\u0433, \u0442\u0430\u0431\u0435 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0448\u0430\u0442\u044b \u0445\u0432\u0430\u043b\u044b \u0441\u0432\u0430\u0451\u0439 \u0430\u043f\u0440\u0430\u043d\u0435 \u0446\u044f\u0431\u0435 \u0411\u043e\u0433, \u0421\u0432\u044f\u0442\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"617","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0456\u0441\u0442\u043e\u0440\u044b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u042d\u045e\u0437\u044d\u0431\u0456\u044f \u0426\u044d\u0437\u0430\u0440\u044d\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 10, 1-3: PG 20, 842-847)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0421\u043f\u0430\u043a\u043e\u0439 \u0443 \u0447\u0430\u0441\u044b \u041a\u0430\u043d\u0441\u0442\u0430\u043d\u0446\u0456\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430 \u045e\u0441\u0451 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0441\u043b\u0430\u0432\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0443 \u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443 \u0441\u0443\u0441\u0432\u0435\u0442\u0443, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u044f\u043a \u043f\u0430\u0434\u0437\u044f\u043a\u0430 \u0417\u0431\u0430\u045e\u0446\u044b \u0456 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044e \u0434\u0443\u0448 \u043d\u0430\u0448\u044b\u0445 \u0415\u0437\u0443\u0441\u0443 \u0425\u0440\u044b\u0441\u0442\u0443, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u043c\u044b \u043c\u043e\u043b\u0456\u043c\u0441\u044f, \u043a\u0430\u0431 \u043c\u043e\u0446\u043d\u044b \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u044b \u0441\u043f\u0430\u043a\u043e\u0439 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0430\u0440\u0443\u0448\u0430\u043b\u0456 \u043d\u0456 \u0432\u043e\u043d\u043a\u0430\u0432\u044b\u044f \u0440\u044d\u0447\u044b, \u043d\u0456 \u043f\u0440\u044b\u043a\u0440\u044b\u044f \u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043d\u043d\u0456 \u0434\u0443\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0436\u043e \u043d\u0430\u0441\u0442\u0430\u045e \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b \u0456 \u044f\u0441\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u043d\u0435 \u0430\u0437\u043c\u0440\u043e\u0447\u0430\u043d\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0456\u044f\u043a\u0430\u044e \u0445\u043c\u0430\u0440\u0430\u0439. \u0401\u043d \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b\u044f \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456, \u0431\u043b\u044f\u0441\u043a\u0430\u043c \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430. \u0406 \u043d\u0430\u0432\u0430\u0442 \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u043d\u0430\u0448\u0430\u0439 \u0440\u044d\u043b\u0456\u0433\u0456\u0439\u043d\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 \u0456 \u043d\u0435 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u043c\u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456, \u0442\u043e \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043d\u0435\u0439\u043a\u0443\u044e, \u0445\u043e\u0446\u044c \u0456 \u043c\u0430\u043b\u0443\u044e, \u0447\u0430\u0441\u0442\u043a\u0443 \u0442\u0430\u0433\u043e, \u0447\u044b\u043c \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u044b\u045e \u043d\u0430\u0441 \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u045e \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u045e\u0441\u044e \u043d\u0430\u0434\u0437\u0435\u044e \u045e\u0441\u043a\u043b\u0430\u043b\u0456 \u043d\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u044b\u043b\u0430 \u043d\u0435\u0439\u043a\u0430\u044f \u043d\u0435\u0432\u0435\u0440\u0430\u0433\u043e\u0434\u043d\u0430\u044f \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044c, \u0456 \u0431\u043e\u0441\u043a\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0437\u0437\u044f\u043b\u0430 \u043d\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u044b \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u043a\u0430\u043b\u0456 \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456, \u044f\u043a \u0443\u0441\u0435 \u043c\u0435\u0441\u0446\u044b, \u044f\u043a\u0456\u044f \u044f\u0448\u0447\u044d \u043d\u044f\u0434\u0430\u045e\u043d\u0430 \u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043b\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0442\u044b\u0440\u0430\u043d\u0430\u045e, \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u043b\u0456\u0441\u044f \u043f\u0430\u0441\u043b\u044f \u043f\u0440\u0430\u0446\u044f\u0433\u043b\u0430\u0433\u0430 \u0456 \u0437\u0433\u0443\u0431\u043d\u0430\u0433\u0430 \u0441\u043f\u0443\u0441\u0442\u0430\u0448\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u044b\u043d\u0456 \u0437\u043d\u043e\u045e \u0443\u0437\u0432\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u0430\u0434 \u0437\u044f\u043c\u043b\u0456 \u0434\u0430 \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0439 \u0432\u044b\u0448\u044b\u043d\u0456 \u0456 \u0432\u044b\u043b\u0443\u0447\u0430\u044e\u0446\u0446\u0430 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u0430\u044e \u043a\u0440\u0430\u0441\u043e\u0439 \u0456 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044e, \u0447\u044b\u043c \u0442\u044b\u044f, \u0448\u0442\u043e \u0431\u044b\u043b\u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b \u0440\u0430\u043d\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u044b\u043c \u0456 \u0436\u0430\u0434\u0430\u043d\u044b\u043c \u0432\u0456\u0434\u043e\u0432\u0456\u0448\u0447\u0430\u043c: \u0443 \u0440\u043e\u0437\u043d\u044b\u0445 \u0433\u0430\u0440\u0430\u0434\u0430\u0445 \u0441\u0432\u044f\u0442\u044b \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f \u043d\u044f\u0434\u0430\u045e\u043d\u0430 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b\u0445 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u045e \u0456 \u0430\u0440\u0430\u0442\u043e\u0440\u044b\u044f\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0445\u043e\u0434\u044b \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e, \u043f\u0440\u044b\u0431\u044b\u0446\u0446\u0451 \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0430\u045e \u0437 \u0434\u0430\u043b\u0451\u043a\u0456\u0445 \u043a\u0440\u0430\u0451\u045e. \u0423\u0437\u0430\u0435\u043c\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u043f\u0430\u043c\u0456\u0436 \u0432\u0435\u0440\u043d\u044b\u043c\u0456 \u0456 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043b\u0443\u0447\u044b\u043b\u0430 \u0447\u0430\u0441\u0442\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 \u045e \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u0443\u044e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430, \u044f\u043a\u0456 \u045e \u0442\u0430\u044f\u043c\u043d\u0456\u0447\u044b\u0445 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u0445 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u043e \u0437\u0434\u0430\u0440\u044b\u0446\u0446\u0430: \u043a\u043e\u0441\u0442\u043a\u0430 \u0437\u0431\u043b\u0456\u0436\u0430\u043b\u0430\u0441\u044f \u0434\u0430 \u043a\u043e\u0441\u0442\u043a\u0456, \u0456 \u0441\u0443\u0441\u0442\u0430\u045e \u0434\u0430 \u0441\u0443\u0441\u0442\u0430\u0432\u0430 (\u043f\u0430\u0440. \u042d\u0437\u0445 37, 7). \u0406 \u0441\u043f\u0430\u045e\u043d\u044f\u043b\u0430\u0441\u044f \u045e\u0441\u0451 \u0456\u043d\u0448\u0430\u0435, \u0448\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0430 \u0433\u044d\u0442\u0430\u0435 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u043f\u0430\u0434 \u0442\u0430\u044f\u043c\u043d\u0456\u0447\u044b\u043c \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u043c \u0441\u043b\u043e\u0432\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u0447\u0430\u0441\u0442\u043a\u0456 \u0446\u0435\u043b\u0430 \u043f\u0440\u0430\u0446\u0456\u043d\u0430\u043b\u0430 \u0430\u0434\u0437\u0456\u043d\u0430\u044f \u043c\u043e\u0446 \u0411\u043e\u0436\u0430\u0433\u0430 \u0414\u0443\u0445\u0430, \u0432\u0430 \u045e\u0441\u0456\u0445 \u0431\u044b\u043b\u0430 \u0430\u0434\u043d\u0430 \u0434\u0443\u0448\u0430, \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u044b \u045e\u0437\u0434\u044b\u043c \u0432\u0435\u0440\u044b, \u0441\u0443\u0433\u0443\u0447\u043d\u0430\u0441\u0446\u044c \u0443\u0441\u0456\u0445, \u0445\u0442\u043e \u0441\u043b\u0430\u0432\u0456\u045e \u0433\u0456\u043c\u043d\u0430\u043c\u0456 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456 \u0431\u044b\u043b\u0456 \u0431\u0456\u0441\u043a\u0443\u043f\u0441\u043a\u0456\u044f \u0446\u044b\u0440\u044b\u043c\u043e\u043d\u0456\u0456, \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0456\u044f \u0430\u0431\u0440\u0430\u0434\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456\u0441\u044f \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430, \u0430\u0431\u0440\u0430\u0434\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0431\u044b\u043b\u0456 \u0432\u0435\u043b\u0456\u0447\u043d\u044b\u044f \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f. \u0417 \u0430\u0434\u043d\u0430\u0433\u043e \u0431\u043e\u043a\u0443 \u0441\u043f\u0435\u045e \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e \u0456 \u0441\u043b\u0443\u0445\u0430\u043d\u043d\u0435 \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e \u041f\u0456\u0441\u0430\u043d\u043d\u044f, \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u043d\u0430\u043c \u043f\u0430\u0434 \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0435\u043c, \u0437 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 &ndash; \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u0435 \u045e\u043a\u0440\u044b\u0442\u044b\u0445 \u0411\u043e\u0436\u044b\u0445 \u0442\u0430\u044f\u043c\u043d\u0456\u0446; \u0443\u0441\u0451 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0437\u043d\u0430\u043a\u0430\u043c \u043c\u0456\u0441\u0442\u044b\u0447\u043d\u044b\u0445 \u0441\u0456\u043c\u0432\u0430\u043b\u0430\u045e \u0437\u0431\u0430\u045e\u0447\u0430\u0439 \u043c\u0443\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0430\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u043b\u044e\u0434\u0437\u0435\u0439 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u045e\u0437\u0440\u043e\u0441\u0442\u0443, \u043c\u0443\u0436\u0447\u044b\u043d \u0456 \u0436\u0430\u043d\u0447\u044b\u043d, \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c\u0456 \u0456 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u044e \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u0437 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0434\u0443\u0445\u0430 \u0411\u043e\u0433\u0443 &ndash; \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044e \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 3, 15; \u0413\u0430\u043b 3, 28; \u041f\u0441 149, 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445 \u0441\u043f\u0430\u043a\u043e\u0439 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u045e \u0430\u0434\u043d\u044b\u043c \u0446\u0435\u043b\u0435. \u0406 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u045e\u0434\u0437\u044f\u0447\u043d\u044b\u043c\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u045e\u0441\u0435 \u0432\u044b \u0430\u0434\u043d\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0443 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e, \u0445\u0432\u0430\u043b\u0430 \u042f\u043c\u0443 \u043d\u0430 \u0441\u0445\u043e\u0434\u0437\u0435 \u0441\u0432\u044f\u0442\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u045e\u0441\u0435 \u0432\u044b \u0430\u0434\u043d\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"618","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u041d\u0430\u0437\u0456\u044f\u043d\u0437\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 43, in laudem Basilii Magni, <\/span><br \/><span style=\"color: #ff0000;\">15. 16-17. 19-21: PG 36, 514-523)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e\u0439 \u0434\u0443\u0448\u043e\u044e \u045e \u0434\u0432\u0443\u0445 \u0446\u0435\u043b\u0430\u0445<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0444\u0456\u043d\u044b \u0437\u043b\u0443\u0447\u044b\u043b\u0456 \u043d\u0430\u0441, \u043d\u0456\u0431\u044b \u043f\u043b\u044b\u043d\u044c \u043f\u044d\u045e\u043d\u0430\u0439 \u0440\u0430\u043a\u0456, \u0445\u043e\u0446\u044c \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0442\u043e\u0439 \u0441\u0430\u043c\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u044b \u043c\u044b, \u043f\u0440\u0430\u0433\u043d\u044b\u044f \u0432\u0435\u0434\u0430\u045e, \u0440\u0430\u0437\u044b\u0448\u043b\u0456\u0441\u044f \u045e \u0440\u043e\u0437\u043d\u044b\u044f \u043a\u0440\u0430\u0456, \u0456 \u0437\u043d\u043e\u045e \u0441\u044b\u0448\u043b\u0456\u0441\u044f, \u044f\u043a \u043f\u0430 \u0434\u0430\u043c\u043e\u0432\u0435, \u0431\u043e \u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0430\u043c \u0441\u0442\u0430\u0432\u0456\u045e\u0441\u044f \u0434\u0430 \u043c\u0430\u0439\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0411\u0430\u0437\u044b\u043b\u044f \u0437 \u043f\u0430\u0448\u0430\u043d\u0430\u044e, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u0430\u0447\u044b\u045e \u0432\u0430\u0436\u043a\u0430\u0441\u0446\u044c \u044f\u0433\u043e\u043d\u044b\u0445 \u0437\u0432\u044b\u0447\u0430\u044f\u045e, \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u044c \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0443 \u0441\u043b\u043e\u0432\u0430\u0445, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u045e \u0456\u043d\u0448\u044b\u0445, \u0445\u0442\u043e \u044f\u0433\u043e \u044f\u0448\u0447\u044d \u043d\u0435 \u0432\u0435\u0434\u0430\u045e, \u0440\u0430\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430. \u0411\u043e \u045e \u043c\u043d\u043e\u0433\u0456\u0445, \u0445\u0442\u043e \u045e\u0436\u043e \u0440\u0430\u043d\u0435\u0439 \u0447\u0443\u045e \u043f\u0440\u0430 \u044f\u0433\u043e \u0437 \u043f\u0430\u0433\u0430\u043b\u043e\u0441\u043a\u0456 \u0446\u0456 \u043d\u0430 \u0441\u0432\u0430\u0435 \u0432\u0443\u0448\u044b, \u0451\u043d \u0430\u0434\u0440\u0430\u0437\u0443 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u045e \u043f\u0430\u0432\u0430\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043a\u0443\u043b\u044c \u0442\u0430\u043a\u043e\u0435 \u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435? \u0401\u043d \u0445\u0456\u0431\u0430 \u0430\u0434\u0437\u0456\u043d \u0441\u044f\u0440\u043e\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u044f\u0437\u0434\u0436\u0430\u045e \u0443 \u0410\u0444\u0456\u043d\u044b \u043d\u0430 \u0432\u0443\u0447\u043e\u0431\u0443, \u0431\u044b\u045e \u0437\u0432\u043e\u043b\u044c\u043d\u0435\u043d\u044b \u0430\u0434 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430 \u043f\u0430\u0440\u0430\u0434\u043a\u0443, \u0431\u043e \u043f\u0430\u043b\u0456\u0447\u044b\u043b\u0456, \u0448\u0442\u043e \u044f\u043c\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u043f\u0430\u0448\u0430\u043d\u0430, \u0447\u044b\u043c \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u043c\u0443 \u043d\u0430\u0432\u0456\u0446\u044b\u044e. \u0413\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430, \u0430\u0434\u043a\u0443\u043b\u044c \u0437\u0430\u043f\u0430\u043b\u0456\u043b\u0430\u0441\u044f \u0456\u0441\u043a\u0430\u0440\u043a\u0430 \u043d\u0430\u0448\u044b\u0445 \u0431\u043b\u0456\u0437\u043a\u0456\u0445 \u0430\u0434\u043d\u043e\u0441\u0456\u043d. \u0422\u0430\u043a \u043c\u044b \u043f\u0440\u0430\u043d\u0456\u043a\u043b\u0456\u0441\u044f \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0437 \u0446\u044f\u0433\u0430\u043c \u0447\u0430\u0441\u0443 \u043c\u044b \u0432\u044b\u0437\u043d\u0430\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443 \u043d\u0430\u0448\u0430 \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456, \u0448\u0442\u043e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 &ndash; \u0433\u044d\u0442\u0430 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043c\u044b \u0430\u0431\u043e\u0434\u0432\u0430 \u0448\u0443\u043a\u0430\u043b\u0456, \u0442\u0430\u0434\u044b \u043c\u044b \u0430\u0431\u043e\u0434\u0432\u0430 \u0441\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u045e\u0441\u0456\u043c: \u0436\u044b\u043b\u0456 \u043f\u0430\u0434 \u0430\u0434\u043d\u044b\u043c \u0434\u0430\u0445\u0430\u043c, \u0434\u0437\u044f\u043b\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0441\u0442\u043e\u043b \u0456 \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u044b\u044f, \u043c\u044b \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u043d\u0430 \u0430\u0434\u043d\u043e \u0456 \u0442\u043e\u0435 \u0436, \u0437 \u043a\u043e\u0436\u043d\u044b\u043c \u0434\u043d\u0451\u043c \u0443\u0441\u0451 \u0433\u0430\u0440\u0430\u0447\u044d\u0439 \u0456 \u043c\u0430\u0446\u043d\u0435\u0439 \u043f\u0440\u044b\u0432\u044f\u0437\u0432\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u043d\u0430\u0448\u0430\u0439 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0439 \u043c\u044d\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043c\u0456 \u043a\u0456\u0440\u0430\u0432\u0430\u043b\u0430 \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430\u0435 \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0435 \u0434\u0430 \u0440\u044d\u0447\u044b, \u044f\u043a\u0430\u044f \u0441\u044f\u0440\u043e\u0434 \u0456\u043d\u0448\u044b\u0445 \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u044c, \u043a\u0440\u0430\u0441\u0430\u043c\u043e\u045e\u0441\u0442\u0432\u0430. \u0410\u0434\u043d\u0430\u043a \u0443 \u043d\u0430\u0441 \u043d\u0435 \u0431\u044b\u043b\u043e \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456, \u0445\u043e\u0446\u044c \u043c\u044b \u0446\u0430\u043d\u0456\u043b\u0456 \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0446\u0442\u0432\u0430. \u0406 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435 \u043d\u0435 \u0437\u0430 \u0442\u043e\u0435, \u0445\u0442\u043e \u0437\u0434\u0430\u0431\u0443\u0434\u0437\u0435 \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u043e, \u0430\u043b\u0435 \u0445\u0442\u043e \u0441\u0430\u0441\u0442\u0443\u043f\u0456\u0446\u044c, \u0431\u043e \u043a\u043e\u0436\u043d\u044b \u043b\u0456\u0447\u044b\u045e \u0441\u043b\u0430\u0432\u0443 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0441\u0432\u0430\u0451\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u043c\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e\u0439 \u0434\u0443\u0448\u043e\u044e \u045e \u0434\u0432\u0443\u0445 \u0446\u0435\u043b\u0430\u0445. \u0425\u043e\u0446\u044c \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0432\u0435\u0440\u044b\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u045e\u0441\u0451 \u0437\u043c\u044f\u0448\u0447\u0430\u0435\u0446\u0446\u0430 \u0432\u0430 \u045e\u0441\u0456\u043c, \u0430\u043b\u0435 \u043d\u0430\u043c, \u0430\u0434\u043d\u0430\u043a, \u043c\u043e\u0436\u043d\u0430 \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u043c\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0443 \u0430\u0434\u043d\u044b\u043c \u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u0440\u044b \u0430\u0434\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043d\u0430\u0441 \u0431\u044b\u043b\u0430 \u0430\u0434\u0437\u0456\u043d\u0430\u044f \u043c\u044d\u0442\u0430 \u0456 \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0435: \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u0446\u044c \u0446\u043d\u043e\u0442\u0443, \u0436\u044b\u0446\u044c \u0434\u043b\u044f \u0431\u0443\u0434\u0443\u0447\u044b\u0445 \u043d\u0430\u0434\u0437\u0435\u044f\u045e \u0456 \u0430\u0434\u0430\u0440\u0432\u0430\u0446\u0446\u0430 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0440\u0430\u043d\u0435\u0439, \u0447\u044b\u043c \u043f\u0430\u043a\u0456\u043d\u0435\u043c \u044f\u0433\u043e. \u041c\u044b \u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430 \u0433\u044d\u0442\u0443\u044e \u043c\u044d\u0442\u0443 \u0456 \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u043b\u0456 \u0434\u0430 \u044f\u0435 \u0436\u044b\u0446\u0446\u0451 \u0456 \u045e\u0441\u0435 \u045e\u0447\u044b\u043d\u043a\u0456, \u0456\u0434\u0443\u0447\u044b \u043f\u0430\u0434 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0411\u043e\u0436\u044b\u0445 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0456 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u045e\u0437\u0430\u0435\u043c\u043d\u0430 \u045e \u0446\u043d\u043e\u0442\u0430\u0445. \u0406 \u0445\u043e\u0446\u044c \u0433\u044d\u0442\u0430 \u043c\u043e\u0436\u0430 \u0433\u0443\u0447\u0430\u0446\u044c \u0437\u0430\u043d\u0430\u0434\u0442\u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u0430, \u043c\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u043b\u044f \u0430\u0434\u043d\u0430\u0433\u043e \u043d\u043e\u0440\u043c\u0430\u0439 \u0456 \u045e\u0437\u043e\u0440\u0430\u043c, \u0448\u0442\u043e \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u043b\u0430 \u043d\u0430\u043c \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0446\u044c \u0434\u043e\u0431\u0440\u0430\u0435 \u0430\u0434 \u0437\u043b\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0445\u043e\u0446\u044c \u0456\u043d\u0448\u044b\u044f \u043c\u0430\u044e\u0446\u044c \u0440\u043e\u0437\u043d\u044b\u044f \u0456\u043c\u0451\u043d\u044b: \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u045e \u0430\u0434 \u0431\u0430\u0446\u044c\u043a\u043e\u045e, \u0445\u0442\u043e \u0441\u0430\u043c \u043d\u0430\u0431\u044b\u045e \u0456\u0445 \u0441\u0430\u0431\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0436\u044b\u0446\u0446\u0451\u0432\u044b\u043c \u0437\u0430\u043d\u044f\u0442\u043a\u0430\u043c \u0446\u0456 \u0437\u0432\u044b\u0447\u0430\u044f\u043c, \u0430 \u0434\u043b\u044f \u043d\u0430\u0441, \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0431\u044b\u043b\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0430\u0439 \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0433\u043e\u043d\u0430\u0440\u0430\u043c \u0431\u044b\u0446\u044c \u0456 \u0437\u0432\u0430\u0446\u0446\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0430\u043d 2, 21&not;22; 1 \u041a\u0430\u0440 12, 11<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u0434\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043c\u0443\u0434\u0440\u044b\u043c \u0456 \u0432\u0435\u0434\u044b \u0442\u044b\u043c, \u0445\u0442\u043e \u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0433\u043b\u044b\u0431\u0456\u043d\u0456, \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u0451\u0441\u0446\u044c \u0443 \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u0430\u0434\u0437\u0456\u043d \u0456 \u0442\u043e\u0439 \u0436\u0430 \u0414\u0443\u0445, \u044f\u043a\u0456 \u045e\u0434\u0437\u044f\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u043f\u0430\u0430\u0441\u043e\u0431\u043a\u0443, \u044f\u043a \u0436\u0430\u0434\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0433\u043b\u044b\u0431\u0456\u043d\u0456, \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u0451\u0441\u0446\u044c \u0443 \u042f\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"619","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0420\u0430\u0439\u043c\u0443\u043d\u0434\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Monumenta Ord. Praed. Hist. 6, 2, Romae 1901, pp. 84-85)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041d\u044f\u0445\u0430\u0439 \u0411\u043e\u0433 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e \u0430\u0434\u043e\u0440\u044b\u0446\u044c \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u0432\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a \u043f\u0440\u0430\u045e\u0434\u044b, \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b, \u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0443\u045e, \u0430\u043b\u0435 \u0441\u043b\u0443\u0448\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u045e\u0441\u0435, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0436\u044b\u0446\u044c \u043f\u0430\u0431\u043e\u0436\u043d\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0437\u0432\u0435\u0434\u0430\u0435 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434. \u041c\u044f\u0440\u043a\u0443\u044e, \u0448\u0442\u043e \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0440\u0430\u0432\u0456\u043b\u0430 \u043d\u044f\u043c\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u044f, \u0445\u0456\u0431\u0430 \u043d\u0435\u0445\u0442\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u044f\u043a &laquo;\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430 \u0436\u044b\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435&raquo; \u0430\u0431\u043e \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u0435 \u0433\u044d\u0442\u044b\u044f \u043d\u0430\u043a\u0430\u0437\u044b (\u043f\u0430\u0440. \u0426\u0456\u0442 2, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0437\u0434\u0430\u0440\u044b\u0446\u0446\u0430 \u0432\u0430\u043c \u0430\u043f\u044b\u043d\u0443\u0446\u0446\u0430 \u045e \u043b\u0456\u043a\u0443 \u0442\u044b\u0445, \u0447\u044b\u0435 \u0434\u0430\u043c\u044b \u043c\u0456\u0440\u043d\u044b\u044f, \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b\u044f \u0456 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b\u044f, \u0443 \u0442\u043e\u0439 \u0447\u0430\u0441 \u044f\u043a \u043d\u044f\u043c\u0430 \u043d\u0430\u0434 \u0456\u043c\u0456 \u0436\u0430\u0437\u043b\u0430 \u041f\u0430\u043d\u0430: \u044f\u043d\u044b \u0432\u044f\u0434\u0443\u0446\u044c \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u045e \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0446\u0435, \u0430\u043b\u0435 \u045e \u0430\u0434\u0437\u0456\u043d \u043c\u043e\u043c\u0430\u043d\u0442 \u0441\u044b\u0434\u0443\u0446\u044c \u0434\u0430 \u0430\u0434\u0445\u043b\u0430\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u043f\u0440\u044b\u043d\u044f\u0442\u044b\u044f \u0411\u043e\u0433\u0430\u043c \u0456 \u043c\u0456\u043b\u044b\u044f \u042f\u043c\u0443, \u0432\u0430\u0448\u0430 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435 \u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0432\u0430\u0448\u0430 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0430\u0447\u044b\u0441\u0446\u0456\u043b\u0430\u0441\u044f \u043f\u0440\u0430\u0437 \u0447\u0430\u0441\u0442\u044b\u044f \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456 \u0434\u0430 \u043a\u0440\u044b\u0448\u0442\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f. \u041d\u0430\u0432\u0430\u0442 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043f\u0430\u0434\u044b\u043c\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u0432\u0430\u043c\u0456 \u0434\u0432\u043e\u0439\u0447\u044b \u0446\u0456 \u0442\u0440\u043e\u0439\u0447\u044b \u043c\u0435\u0447, \u0433\u044d\u0442\u0430 \u045e\u0441\u0451 \u0442\u0440\u044d\u0431\u0430 \u043b\u0456\u0447\u044b\u0446\u044c \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0430\u044e \u0434\u043b\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u0434\u043e\u043a\u0430\u0437\u0430\u043c \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0432\u043e\u043d\u043a\u0443 \u0434\u0432\u0443\u0445\u0431\u0430\u043a\u043e\u0432\u0430\u0433\u0430 \u043c\u044f\u0447\u0430 &ndash; \u0432\u0430\u0441\u0442\u0440\u044b\u0451 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e, \u0430 \u045e\u043d\u0443\u0442\u0440\u044b &ndash; \u0441\u0442\u0440\u0430\u0445. \u0423\u043d\u0443\u0442\u0440\u044b \u0451\u043d \u0443\u0434\u0430\u0440\u0430\u0435 \u0434\u0432\u043e\u0439\u0447\u044b \u0456 \u0442\u0440\u043e\u0439\u0447\u044b, \u043a\u0430\u043b\u0456 \u0445\u0456\u0442\u0440\u044b \u0434\u0443\u0445 \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u0430\u043c \u0456 \u043b\u0456\u0441\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u043d\u0435\u043f\u0430\u043a\u043e\u0456\u0446\u044c \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0441\u044d\u0440\u0446\u0430. \u0406 \u0442\u0430\u043a\u0443\u044e \u0432\u0430\u0439\u043d\u0443 \u0432\u044b \u045e\u0436\u043e \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u045e\u0434\u043e\u0441\u0442\u0430\u043b\u044c, \u0456\u043d\u0430\u043a\u0448 \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0431 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0442\u043e\u0439 \u043a\u0440\u0430\u0441\u044b \u043c\u0456\u0440\u0443 \u0456 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0430\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b \u043c\u0435\u0447 \u0437\u0432\u043e\u043d\u043a\u0443 \u045e\u0434\u0430\u0440\u0430\u0435 \u0434\u0432\u043e\u0439\u0447\u044b \u0456 \u0442\u0440\u043e\u0439\u0447\u044b, \u043a\u0430\u043b\u0456 \u045e \u0441\u0430\u043c\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u043f\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u0431\u0435\u0441\u043f\u0430\u0434\u0441\u0442\u0430\u045e\u043d\u044b \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u0445 \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u044f\u045e. \u0422\u0430\u0434\u044b \u0440\u0430\u043d\u044b \u0433\u043b\u044b\u0431\u0435\u0439\u0448\u044b\u044f, \u0431\u043e \u044f\u043d\u044b \u043d\u0430\u043d\u0435\u0441\u0435\u043d\u044b \u0441\u044f\u0431\u0440\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0442\u043e\u0439 \u0436\u0430\u0434\u0430\u043d\u044b \u0456 \u0448\u0447\u0430\u0441\u043d\u044b \u043a\u0440\u044b\u0436 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b, \u044f\u043a\u0456 \u0410\u043d\u0434\u0440\u044d\u0439 \u043c\u0443\u0436\u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u045e \u0437 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c, \u0430 \u041f\u0430\u0432\u0435\u043b, \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0435 \u043d\u0430\u0447\u044b\u043d\u043d\u0435, \u043a\u0430\u0436\u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u0432\u0435\u0440\u044b \u0456 \u044f\u0435 \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u044c\u043d\u0456\u043a\u0430, \u044f\u043a\u0456 \u0431\u0435\u0437 \u043d\u0456\u044f\u043a\u0430\u0439 \u0432\u0456\u043d\u044b \u043f\u0430\u0446\u044f\u0440\u043f\u0435\u045e \u0430\u0434 \u0441\u0432\u0430\u0456\u0445 \u0456 \u0430\u043f\u044b\u043d\u0443\u045e\u0441\u044f \u045e \u043b\u0456\u043a\u0443 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u045e. \u041f&rsquo;\u044e\u0447\u044b \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u043a\u0435\u043b\u0456\u0445 \u0415\u0437\u0443\u0441\u0430, \u0434\u0437\u044f\u043a\u0443\u0439\u0446\u0435 \u041f\u0430\u043d\u0443, \u0448\u0447\u043e\u0434\u0440\u0430\u043c\u0443 \u0434\u0430\u045e\u0446\u0443 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0441\u0430\u043c \u0411\u043e\u0433 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e \u043d\u044f\u0445\u0430\u0439 \u0430\u0434\u043e\u0440\u044b\u0446\u044c \u0432\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u0456 \u043f\u0440\u044b\u0441\u043f\u0435\u0448\u044b\u0446\u044c \u0432\u0430\u0448 \u0448\u043b\u044f\u0445, \u0437\u0430\u043a\u0440\u044b\u0435 \u0432\u0430\u0441 \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0430\u0434 \u043b\u044e\u0434\u0441\u043a\u043e\u0433\u0430 \u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043d\u043d\u044f, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0456 \u043d\u0435 \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u0446\u044c \u0442\u0430\u043c, \u0434\u0437\u0435 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0432\u0435\u0447\u043d\u0430 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u043f\u043e\u045e\u043d\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u0443 \u0448\u0430\u0442\u0440\u0430\u0445 \u0434\u0430\u0432\u0435\u0440\u0443 \u0456 \u045e \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u044b\u043c \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u043e\u043c\u043d\u044f\u043c\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u0443\u0447\u044d\u043d\u043d\u044f \u0401\u043d \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0435\u045e \u0443 \u0437\u043c\u0440\u043e\u043a\u0443. <span style=\"color: #ff0000;\">*<\/span> \u0413\u0430\u0440\u0430\u0447\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0437\u043d\u044f\u0432\u043e\u043b\u0456\u043b\u0430 \u043d\u044f\u0441\u0442\u0430\u0447\u0430 \u0456 \u0437\u0431\u0440\u043e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u0430\u0434\u0432\u0451\u045e \u0437\u0433\u0443\u0431\u043b\u0435\u043d\u044b\u0445 \u0441\u0430 \u0448\u043b\u044f\u0445\u0443 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0456 \u0430\u0434 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u0443\u0431\u043e\u0433\u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u0430\u0440\u0430\u0447\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0437\u043d\u044f\u0432\u043e\u043b\u0456\u043b\u0430 \u043d\u044f\u0441\u0442\u0430\u0447\u0430 \u0456 \u0437\u0431\u0440\u043e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"620","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0421\u0432\u044f\u0442\u0443\u044e \u0422\u0440\u043e\u0439\u0446\u0443&raquo; \u0441\u0432. \u0413\u0456\u043b\u044f\u0440\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 1, 37-38: PL 10, 48-49)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0410\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u0426\u044f\u0431\u0435, \u0441\u043b\u0443\u0436\u0443 \u0422\u0430\u0431\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0440\u0430\u0437\u0443\u043c\u0435\u044e, \u0411\u043e\u0436\u0430, \u041e\u0439\u0447\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u0448\u0442\u043e \u0433\u0430\u043b\u043e\u045e\u043d\u0430\u0435 \u0437\u0430\u0434\u0430\u043d\u043d\u0435 \u043c\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f \u0456 \u043c\u043e\u0439 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u0430\u0435 \u043c\u0430\u0451 \u0441\u043b\u043e\u0432\u0430 \u0456 \u043a\u043e\u0436\u043d\u0430\u044f \u043c\u0430\u044f \u0434\u0443\u043c\u043a\u0430 \u0431\u044b\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0440 \u043c\u043e\u0432\u044b, \u044f\u043a\u0456 \u044f \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0434 \u0426\u044f\u0431\u0435, \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u043c\u043d\u0435 \u043d\u0456\u044f\u043a\u0430\u0439 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b \u0437\u0430 \u0442\u0443\u044e, \u043a\u0430\u0431, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u0426\u044f\u0431\u0435, \u0441\u043b\u0443\u0436\u044b\u045e \u0422\u0430\u0431\u0435 \u0456 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u045e \u043d\u0435\u0434\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u0430\u043c\u0443 \u0441\u0432\u0435\u0442\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0435\u0440\u044d\u0442\u044b\u043a\u0430\u043c, \u044f\u043a\u0456\u044f \u0430\u0441\u043f\u0440\u044d\u0447\u0432\u0430\u044e\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0422\u044b &minus; \u0410\u0439\u0446\u0435\u0446 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u044f \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c, \u0430\u0434\u043d\u0430\u043a, \u043c\u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0426\u044f\u0431\u0435 \u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u043a\u0430\u0431 \u0443 \u0441\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0422\u044b \u045e\u0434\u0437\u044f\u043b\u0456\u045e \u043c\u043d\u0435 \u0441\u0432\u0430\u044e \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443. \u041d\u0430\u0448\u0430\u044f \u0432\u0435\u0440\u0430 \u0456 \u043d\u0430\u0448\u0430\u0435 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0426\u044f\u0431\u0435 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u044f \u0434\u0430 \u0426\u044f\u0431\u0435 \u044f\u043a \u0440\u0430\u0441\u043a\u0440\u044b\u0442\u044b \u0432\u0435\u0442\u0440\u0430\u0437\u044c. \u041d\u0430\u043f\u043e\u045e\u043d\u0456 \u044f\u0433\u043e \u0442\u0445\u043d\u0435\u043d\u043d\u0435\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043a\u0430\u0431 \u0432\u0451\u045e \u043d\u0430\u0441 \u0434\u0430\u043b\u0435\u0439 \u0448\u043b\u044f\u0445\u0430\u043c\u0456 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u0442\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b. \u0411\u043e \u0432\u0435\u0440\u043d\u044b\u043c \u0451\u0441\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u043c: &laquo;\u041f\u0440\u0430\u0441\u0456\u0446\u0435, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0432\u0430\u043c; \u0448\u0443\u043a\u0430\u0439\u0446\u0435, \u0456 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435; \u0441\u0442\u0443\u043a\u0430\u0439\u0446\u0435, \u0456 \u0430\u0434\u0447\u044b\u043d\u044f\u0446\u044c \u0432\u0430\u043c&raquo; (\u041c\u0446 7, 7).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b, \u043c\u0430\u043b\u0430\u0434\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u044b\u044f, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0445\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0448\u044b\u044f \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u044b, \u0430\u043b\u0435 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0456 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u0422\u0432\u0430\u0456\u0445 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0437\u0451\u043c \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u045e\u0441\u0435 \u0441\u0456\u043b\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0430\u0431\u043c\u0435\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0440\u043e\u0437\u0443\u043c\u0443. \u0410\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0422\u044b \u043c\u043e\u0436\u0430\u0448 \u0434\u0430\u0446\u044c \u043d\u0430\u043c \u0442\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c, \u0456 \u0432\u044b\u0439\u0441\u0446\u0456 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0448\u0443\u043a\u0430\u0435, \u0456 \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u0442\u0443\u043a\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430 \u043f\u0440\u044b\u0440\u043e\u0434\u0437\u0435 \u043c\u044b \u0442\u0430\u043a\u0456\u044f \u043c\u0430\u0440\u0443\u0434\u043d\u044b\u044f \u0456 \u043b\u044f\u043d\u0456\u0432\u044b\u044f, \u0430 \u043d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0431\u043c\u0435\u0436\u0430\u0432\u0430\u043d\u044b \u0456 \u043d\u044f\u0441\u043a\u043e\u0440\u044b \u0434\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u0435 \u043d\u0430\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0426\u044f\u0431\u0435. \u0410\u0434\u043d\u0430\u043a \u043d\u0430\u0448\u0430\u0435 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0435 \u0441\u043f\u0430\u0441\u0446\u0456\u0436\u044d\u043d\u043d\u0435 \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u0443\u0447\u044d\u043d\u043d\u044f \u0434\u0430\u0435 \u043d\u0430\u043c \u0430\u0434\u0447\u0443\u0432\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0432\u0435\u0434\u0430\u043d\u043d\u044f, \u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0432\u0435\u0440\u044b \u043f\u0430\u0448\u044b\u0440\u0430\u0435 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u044f \u043c\u0435\u0436\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0440\u043e\u0437\u0443\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u043c\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u0422\u044b \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0448 \u043d\u0430\u043c \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u044b\u044f \u043d\u044f\u0441\u043c\u0435\u043b\u044b\u044f \u043a\u0440\u043e\u043a\u0456 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u0442\u0430\u0439 \u043d\u0430\u043c\u0456 \u043f\u0440\u0430\u0446\u044b \u0456 \u043f\u0430 \u043c\u0435\u0440\u044b \u0456\u0445 \u0441\u0442\u0430\u043b\u0435\u043d\u043d\u044f \u0431\u0443\u0434\u0437\u0435\u0448 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0456 \u0434\u0430\u0441\u0456 \u043d\u0430\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b. \u041a\u0430\u0431 \u043c\u044b \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456 \u043d\u0435 \u0456\u043d\u0430\u043a\u0448, \u044f\u043a \u044f\u043d\u044b, \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u044f \u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u044b, \u0456 \u045e \u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0456 \u0430\u0434\u043d\u043e\u0441\u0456\u043b\u0456 \u0456\u0445 \u0437\u043c\u0435\u0441\u0442 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043a\u0430\u0437\u0430\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u0411\u043e\u0436\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u044f \u0456\u043c: \u043f\u0440\u0430 \u0426\u044f\u0431\u0435, \u0432\u0435\u0447\u043d\u044b \u0411\u043e\u0436\u0430, \u044f\u043a\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0448\u0441\u044f \u0410\u0439\u0446\u043e\u043c \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430, \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430; \u043f\u0440\u0430 \u0426\u044f\u0431\u0435, \u044f\u043a\u0456 \u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b, \u0456 \u043f\u0440\u0430 \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0437 \u0426\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0432\u044f\u043a\u0430\u043c\u0456, \u0430 \u043d\u0435 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0456\u043d\u0448\u044b\u043c \u0411\u043e\u0433\u0430\u043c \u0430\u043f\u0440\u043e\u0447 \u0426\u044f\u0431\u0435, \u0456 \u043d\u0435 \u0456\u043d\u0448\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u043c, \u0431\u043e \u0422\u044b &minus; \u0430\u0434\u0437\u0456\u043d\u044b \u0411\u043e\u0433; \u0401\u043d &ndash; \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0411\u043e\u0433, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0437 \u0426\u044f\u0431\u0435, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0430\u0440\u044b \u043d\u0430\u0441 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u043c\u043e\u0432\u0430\u0439, \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f, \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0432\u0435\u0440\u0430\u0439, \u043a\u0430\u0431 \u043c\u044b \u0432\u044b\u043c\u0430\u045e\u043b\u044f\u043b\u0456 \u0442\u043e\u0435, \u0443 \u0448\u0442\u043e \u0432\u0435\u0440\u044b\u043c. \u0414\u0430\u0437\u0432\u043e\u043b\u044c \u043d\u0430\u043c \u043f\u0435\u0440\u0430\u0434 \u0456\u043d\u0448\u0430\u0432\u0435\u0440\u0446\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u043f\u0430\u045e\u0441\u0442\u0430\u044e\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0426\u044f\u0431\u0435, \u043f\u0430-\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0426\u044f\u0431\u0435, \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0410\u0439\u0446\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043d\u0430\u0432\u0443\u043a\u0430\u044e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e. \u0411\u043e \u0445\u043e\u0446\u044c \u0422\u044b \u0430\u0434\u0437\u0456\u043d\u044b, \u0430\u043b\u0435 \u043d\u0435 \u0441\u0430\u043c\u043e\u0442\u043d\u044b, \u0430 \u0422\u0432\u043e\u0439 \u0421\u044b\u043d \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b, \u044f\u043a\u0456 \u045e \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0435 \u0437 \u0422\u0430\u0431\u043e\u044e, \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u044f\u043a\u0456\u043c\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u044b\u043c \u0411\u043e\u0433\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 4, 2b-3\u0430. 6\u0441. 15<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u043e\u0436\u043d\u044b \u0434\u0443\u0445, \u044f\u043a\u0456 \u0432\u044b\u0437\u043d\u0430\u0435, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0446\u0435\u043b\u0435, \u0451\u0441\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430, \u0456 \u043a\u043e\u0436\u043d\u044b \u0434\u0443\u0445, \u044f\u043a\u0456 \u043d\u0435 \u0432\u044b\u0437\u043d\u0430\u0435 \u0415\u0437\u0443\u0441\u0430, \u0442\u043e\u0439 \u043d\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430 \u0433\u044d\u0442\u044b\u043c \u0456 \u043f\u0430\u0437\u043d\u0430\u0451\u043c \u0434\u0443\u0445\u0430 \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u0434\u0443\u0445\u0430 \u0444\u0430\u043b\u044c\u0448\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0442\u043e \u0432\u044b\u0437\u043d\u0430\u0435, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 &ndash; \u0421\u044b\u043d \u0411\u043e\u0436\u044b, \u0443 \u0442\u044b\u043c \u0436\u044b\u0432\u0435 \u0411\u043e\u0433, \u0430 \u0451\u043d \u0443 \u0411\u043e\u0433\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430 \u0433\u044d\u0442\u044b\u043c \u0456 \u043f\u0430\u0437\u043d\u0430\u0451\u043c \u0434\u0443\u0445\u0430 \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u0434\u0443\u0445\u0430 \u0444\u0430\u043b\u044c\u0448\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"621","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0416\u044b\u0446\u0446\u0451 \u0441\u0432. \u0410\u043d\u0442\u043e\u043d\u0456\u044f&raquo;, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u0435 \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u0435\u043c, \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 2-4: PG 26, 842-846)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0410\u043d\u0442\u043e\u043d\u0456\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u0410\u043d\u0442\u043e\u043d\u0456\u0439 \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u043b\u043e\u0434\u0448\u0430\u0439 \u0441\u044f\u0441\u0442\u0440\u043e\u0439. \u041c\u0430\u044e\u0447\u044b \u043d\u0430 \u0442\u043e\u0439 \u0447\u0430\u0441 \u0432\u0430\u0441\u0435\u043c\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0446\u0456 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e, \u0437\u0430\u0439\u043c\u0430\u045e\u0441\u044f \u0434\u043e\u043c\u0430\u043c \u0456 \u0430\u043f\u0435\u043a\u0430\u0432\u0430\u045e\u0441\u044f \u0441\u044f\u0441\u0442\u0440\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043d\u0435 \u043c\u0456\u043d\u0443\u043b\u0430 \u044f\u0448\u0447\u044d \u0456 \u0448\u0430\u0441\u0446\u0456 \u043c\u0435\u0441\u044f\u0446\u0430\u045e \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u0431\u0430\u0446\u044c\u043a\u043e\u045e, \u0456\u0448\u043e\u045e \u044f\u043a \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u045e \u043a\u0430\u0441\u0446\u0451\u043b \u0443 \u0433\u043b\u044b\u0431\u043e\u043a\u0456\u043c \u0440\u043e\u0437\u0434\u0443\u043c\u0435. \u0420\u0430\u0437\u0432\u0430\u0436\u0430\u045e, \u0447\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u045e\u0441\u0451, \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430 \u0417\u0431\u0430\u045e\u0446\u0430\u043c, \u0456 \u043a\u0456\u043c \u0431\u044b\u043b\u0456 \u0442\u044b\u044f \u043b\u044e\u0434\u0437\u0456, \u044f\u043a\u0456\u044f, \u044f\u043a \u043f\u0430\u0434\u0430\u044e\u0446\u044c \u0414\u0437\u0435\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043f\u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456 \u0441\u0432\u0430\u0435 \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u0456 \u043a\u043b\u0430\u043b\u0456 \u043a\u0430\u043b\u044f \u043d\u043e\u0433 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0433\u0440\u043e\u0448\u044b, \u043a\u0430\u0431 \u0442\u044b\u044f \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u043b\u0456 \u0456\u0445 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u043c. \u0417\u0430\u0434\u0443\u043c\u0432\u0430\u045e\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u044f\u043a\u0430\u044f \u0456 \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0431\u044b\u043b\u0430 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430 \u0456\u043c \u0443 \u043d\u0435\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u0430\u043a\u0456\u0445 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f\u0445 \u0451\u043d \u0434\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u043a\u0430\u043b\u0456 \u0442\u0430\u043c \u0447\u044b\u0442\u0430\u043b\u0456 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0456 \u043f\u0430\u0447\u0443\u045e \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0431\u0430\u0433\u0430\u0442\u0430\u043c\u0443 \u044e\u043d\u0430\u043a\u0443: &laquo;\u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448 \u0431\u044b\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u0456\u0434\u0437\u0456, \u043f\u0440\u0430\u0434\u0430\u0439 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u044e \u0456 \u0440\u0430\u0437\u0434\u0430\u0439 \u0443\u0431\u043e\u0433\u0456\u043c, \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u043c\u0435\u0446\u044c \u0441\u043a\u0430\u0440\u0431 \u0443 \u043d\u044f\u0431\u0451\u0441\u0430\u0445; \u043f\u0430\u0441\u043b\u044f \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044c \u0456 \u0456\u0434\u0437\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e&raquo; (\u041c\u0446 19, 21).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043d\u0442\u043e\u043d\u0456\u044e \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u043d\u0456\u0431\u044b \u0441\u0430\u043c \u0411\u043e\u0433 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u044f\u043a \u0431\u044b \u0433\u044d\u0442\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430 \u0434\u043b\u044f \u044f\u0433\u043e. \u0410\u0434\u0440\u0430\u0437\u0443 \u0436 \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u043a\u0430\u0441\u0446\u0451\u043b\u0430 \u0456 \u0440\u0430\u0437\u0434\u0430\u045e \u0436\u044b\u0445\u0430\u0440\u0430\u043c \u0432\u0451\u0441\u043a\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u0443\u044e \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0430\u0434 \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u0437\u044f\u043c\u043b\u044e, \u043a\u0430\u0431 \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u0431\u044b\u043b\u0430 \u0434\u043b\u044f \u044f\u0433\u043e \u0456 \u044f\u0433\u043e \u0441\u044f\u0441\u0442\u0440\u044b \u0446\u044f\u0436\u0430\u0440\u0430\u043c. \u041f\u0440\u0430\u0434\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0456\u043d\u0448\u044b\u044f \u0440\u043e\u0437\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b, \u0430 \u0433\u0440\u043e\u0448\u044b \u0440\u0430\u0437\u0434\u0430\u045e \u0431\u0435\u0434\u043d\u044b\u043c. \u0422\u043e\u043b\u044c\u043a\u0456 \u043d\u0435\u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0456\u0445 \u0447\u0430\u0441\u0442\u043a\u0443 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0434\u0437\u0435\u043b\u044f \u0441\u044f\u0441\u0442\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u043d\u043e\u045e \u043f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b \u045e \u043a\u0430\u0441\u0446\u0451\u043b, \u043f\u0430\u0447\u0443\u045e \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430 \u0437 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f: &laquo;\u041d\u0435 \u0442\u0443\u0440\u0431\u0443\u0439\u0446\u0435\u0441\u044f \u0430\u0431 \u0437\u0430\u045e\u0442\u0440\u0430\u0448\u043d\u0456\u043c \u0434\u043d\u0456&raquo; (\u041c\u0446 6, 34). \u0401\u043d \u043d\u0435 \u043c\u043e\u0433 \u0456\u0445 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u0430, \u0442\u0430\u043c\u0443 \u0430\u0434\u0440\u0430\u0437\u0443 \u0436, \u0432\u044b\u0439\u0448\u0430\u045e\u0448\u044b, \u0440\u0430\u0437\u0434\u0430\u045e \u0431\u0435\u0434\u043d\u044b\u043c \u0456 \u0430\u043f\u043e\u0448\u043d\u044e\u044e \u0447\u0430\u0441\u0442\u043a\u0443. \u0421\u044f\u0441\u0442\u0440\u0443 \u0430\u0434\u0434\u0430\u045e \u043d\u0430 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0456 \u0432\u0443\u0447\u043e\u0431\u0443 \u0432\u044f\u0434\u043e\u043c\u044b\u043c \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044e \u0434\u0437\u0435\u0432\u0430\u043c. \u0421\u0430\u043c \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u045e \u0441\u044f\u0431\u0435 \u0430\u0441\u043a\u0435\u0442\u044b\u0447\u043d\u0430\u043c\u0443 \u0436\u044b\u0446\u0446\u044e, \u0436\u044b\u0432\u0443\u0447\u044b \u043d\u0435\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0430. \u0423 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u044b\u043c \u0447\u0443\u0432\u0430\u043d\u043d\u0456 \u043d\u0430\u0434 \u0441\u0430\u0431\u043e\u044e \u0432\u0451\u045e \u0436\u044b\u0446\u0446\u0451, \u043f\u043e\u045e\u043d\u0430\u0435 \u0432\u044b\u0440\u0430\u0447\u044d\u043d\u043d\u044f\u045e. \u041f\u0440\u0430\u0446\u0430\u0432\u0430\u045e \u0443\u043b\u0430\u0441\u043d\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456, \u0431\u043e \u043f\u0430\u0447\u0443\u045e: &laquo;\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0435 \u0445\u043e\u0447\u0430 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u0456 \u043d\u0435 \u0435\u0441\u0446\u044c&raquo; (2 \u0422\u044d\u0441 3,10). \u0410\u0442\u0440\u044b\u043c\u0430\u043d\u0443\u044e \u0437\u0430 \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u0446\u0443 \u043f\u043b\u0430\u0442\u0443 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u045e \u043d\u0430 \u0441\u0432\u0430\u0451 \u045e\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0435 \u0456 \u0434\u043b\u044f \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u0430\u043b\u0456\u045e\u0441\u044f, \u0431\u043e \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 (\u043f\u0430\u0440. 1 \u0422\u044d\u0441 5, 17). \u0427\u044b\u0442\u0430\u045e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u0432\u0430\u0436\u043b\u0456\u0432\u0430, \u0448\u0442\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u043f\u0430-\u0437\u0430 \u044f\u0433\u043e \u045e\u0432\u0430\u0433\u0430\u0439, \u0430\u043b\u0435 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0437\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u045e \u0443\u0441\u0451. \u0417 \u0447\u0430\u0441\u0430\u043c \u043f\u0430\u043c\u044f\u0446\u044c \u043c\u0430\u0433\u043b\u0430 \u0437\u0430\u043c\u044f\u043d\u0456\u0446\u044c \u044f\u043c\u0443 \u043a\u043d\u0456\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u0436\u044b\u0445\u0430\u0440\u044b \u0432\u0451\u0441\u043a\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456, \u0437 \u044f\u043a\u0456\u043c\u0456 \u0451\u043d \u0447\u0430\u0441\u0442\u0430 \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u045e\u0441\u044f, \u0431\u0430\u0447\u0443\u0447\u044b \u044f\u0433\u043e \u0441\u043f\u043e\u0441\u0430\u0431 \u0436\u044b\u0446\u0446\u044f, \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u0441\u044f\u0431\u0440\u0430\u043c \u0411\u043e\u0433\u0430; \u0430\u0434\u043d\u044b\u044f \u043b\u044e\u0431\u0456\u043b\u0456 \u044f\u0433\u043e \u044f\u043a \u0441\u044b\u043d\u0430, \u0434\u0440\u0443\u0433\u0456\u044f &ndash; \u044f\u043a \u0431\u0440\u0430\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 19, 21; \u043f\u0430\u0440. \u041b\u043a 14, 33b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448 \u0431\u044b\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u0456\u0434\u0437\u0456, \u043f\u0440\u0430\u0434\u0430\u0439 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u044e \u0456 \u0440\u0430\u0437\u0434\u0430\u0439 \u0443\u0431\u043e\u0433\u0456\u043c, \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u043c\u0435\u0446\u044c \u0441\u043a\u0430\u0440\u0431 \u0443 \u043d\u044f\u0431\u0451\u0441\u0430\u0445; <span style=\"color: #ff0000;\">*<\/span> \u043f\u0430\u0441\u043b\u044f \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044c \u0456 \u0456\u0434\u0437\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435\u0448 \u0443\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u043c\u0430\u0435\u0448, \u043d\u0435 \u043c\u043e\u0436\u0430\u0448 \u0431\u044b\u0446\u044c \u041c\u0430\u0456\u043c \u0432\u0443\u0447\u043d\u0435\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0441\u043b\u044f \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044c \u0456 \u0456\u0434\u0437\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e.<\/p>\r\n"}, {"GCH_CH_2_ID":"622","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430, \u0456 \u0420\u044b\u043c\u0441\u043a\u0430\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043f\u0440\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0441\u0432. \u0424\u0430\u0431\u0456\u044f\u043d\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 9, 1 i 8, 2-3: CSEL 3, 488-489, 487-488)<\/span><br \/><span style=\"color: #ff0000;\">\u0424\u0430\u0431\u0456\u044f\u043d \u0434\u043b\u044f \u043d\u0430\u0441 &ndash; \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0432\u0435\u0440\u044b \u0456 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0443 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u043b\u0456 \u043f\u0440\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0430\u043f\u044b \u0424\u0430\u0431\u0456\u044f\u043d\u0430, \u0451\u043d \u0432\u044b\u0441\u043b\u0430\u045e \u0434\u0430 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e \u0456 \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u045e \u0420\u044b\u043c\u0430 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b \u043b\u0456\u0441\u0442:<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041a\u0430\u043b\u0456 \u0440\u0430\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441 \u0432\u0435\u0441\u0442\u043a\u0430 \u043f\u0440\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u043c\u0430\u0439\u0433\u043e \u0437\u043d\u0430\u043a\u0430\u043c\u0456\u0442\u0430\u0433\u0430 \u0441\u0430\u0431\u0440\u0430\u0442\u0430 \u0456 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0456 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u0456 \u0440\u043e\u0437\u043d\u044b\u044f, \u044f \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0434 \u0432\u0430\u0441 \u043b\u0456\u0441\u0442, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u043c\u043d\u0435 \u0441\u0443\u0431\u0434\u044b\u044f\u043a\u0430\u043d \u041a\u0440\u0430\u043c\u0435\u043d\u0446\u044b\u0439. \u0422\u0430\u0434\u044b \u044f \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0434\u0440\u0430\u0431\u044f\u0437\u043d\u0430 \u043f\u0440\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0424\u0430\u0431\u0456\u044f\u043d\u0430 \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f, \u0448\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0431\u044b\u043b\u043e \u0437\u0430\u043a\u043e\u043d\u0447\u0430\u043d\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u043e\u045e\u043d\u044b \u045e\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u044f\u0433\u043e \u043f\u0430\u043c\u044f\u0446\u044c \u0432\u044b \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435\u0446\u0435 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u044b\u043c \u0456 \u0437\u0433\u043e\u0434\u043d\u044b\u043c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c. \u0411\u043e \u044f \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f, \u0448\u0442\u043e \u0432\u044b \u0440\u043e\u0431\u0456\u0446\u0435 \u0434\u043b\u044f \u045e\u0432\u0435\u043a\u0430\u0432\u0435\u0447\u0432\u0430\u043d\u043d\u044f \u0432\u0430\u0448\u0430\u0433\u0430 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430, \u044f\u043a\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 &minus; \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0432\u0435\u0440\u044b \u0456 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430 \u0437\u0433\u0443\u0431\u043d\u0430\u0435 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u044b \u044f\u043c\u0443, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u044b\u043c \u0456 \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c \u0451\u0441\u0446\u044c \u0442\u043e\u0435, \u043a\u0430\u043b\u0456 \u0431\u0456\u0441\u043a\u0443\u043f \u0434\u043b\u044f \u0441\u0432\u0430\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u043c\u043e\u0446\u043d\u0430\u0439 \u0432\u0435\u0440\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0434\u0430\u0435\u0446\u0446\u0430, \u044f\u0448\u0447\u044d \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c, \u044f\u043a \u0420\u044b\u043c\u0441\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0437\u0433\u0430\u0434\u0430\u043d\u044b \u043b\u0456\u0441\u0442, \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u043a\u0443 \u0451\u043d \u0432\u044b\u0441\u043b\u0430\u045e \u0443 \u041a\u0430\u0440\u0444\u0430\u0433\u0435\u043d \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0439 \u0432\u0435\u0440\u044b \u0441\u044f\u0440\u043e\u0434 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443:<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041a\u0430\u0441\u0446\u0451\u043b \u043c\u043e\u0446\u043d\u0430 \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0432\u0435\u0440\u044b, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u043b\u0456 \u0446\u0456 \u0442\u043e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0431\u043e\u044f\u0437\u0456, \u0446\u0456 \u0442\u043e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0437\u0430\u0439\u043c\u0430\u043d\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0448\u0447\u0430, \u0446\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437-\u0437\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456. \u0410\u0434\u043d\u0430\u043a \u043c\u044b \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435\u043c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0430\u0441, \u0430\u043b\u0435 \u044f\u043a \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u043b\u0456, \u0442\u0430\u043a \u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u0435\u043c \u0456\u043c, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0430\u043a\u0430\u044f\u043b\u0456\u0441\u044f. \u0411\u044b\u0446\u044c \u043c\u043e\u0436\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u0430\u0435 \u043c\u043e\u0446 \u0443\u0434\u0437\u044f\u043b\u0456\u0446\u044c \u044f\u0433\u043e. \u0411\u0430\u0456\u043c\u0441\u044f, \u0430\u0434\u043d\u0430\u043a, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043c\u044b \u0456\u0445 \u043f\u0430\u043a\u0456\u043d\u0435\u043c, \u0442\u043e \u044f\u043d\u044b \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u044f\u0448\u0447\u044d \u0433\u043e\u0440\u0448\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0430\u0447\u044b\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u0456 \u0432\u044b \u0442\u0430\u043a \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0431\u0456\u0446\u044c, \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u045e\u043f\u0430\u045e, \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0430\u0448\u0430\u043c\u0443 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u044e; \u043a\u0430\u0431 \u044f\u043d\u044b, \u043a\u0430\u043b\u0456 \u0437\u043d\u043e\u045e \u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430, \u043c\u0430\u0433\u043b\u0456 \u043f\u0440\u0430\u0437 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u0432\u0435\u0440\u044b \u043d\u0430\u043f\u0440\u0430\u0432\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u043f\u0435\u0440\u0448\u0443\u044e \u043f\u0430\u043c\u044b\u043b\u043a\u0443. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0432\u044b \u043c\u0430\u0435\u0446\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u044f \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0456, \u044f\u043a\u0456\u044f \u0434\u0430\u0442\u044b\u0447\u0430\u0446\u044c \u0456 \u043d\u0430\u0441: \u0442\u0440\u044d\u0431\u0430 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0447\u044b \u0442\u044b\u043c, \u0445\u0442\u043e \u0442\u0440\u0430\u043f\u0456\u045e \u0443 \u0441\u043f\u0430\u043a\u0443\u0441\u0443 \u0456 \u043d\u044f\u0441\u0442\u0430\u043b\u044b, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u044f\u043b\u0456\u0441\u044f \u0456 \u0437\u043d\u043e\u045e \u0456\u043c\u043a\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0434\u043e\u0432\u044b \u0456 \u045e\u0431\u043e\u0433\u0456\u044f \u0431\u0435\u0437 \u0441\u0440\u043e\u0434\u043a\u0430\u045e \u043d\u0430 \u045e\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u044f\u0437\u043d\u0456 \u0456 \u0432\u044b\u0433\u043d\u0430\u043d\u0446\u044b, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u043e\u0432\u0430 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0456\u043c \u0434\u0430\u043f\u0430\u043c\u043e\u0436\u0430. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0442\u044d\u0445\u0443\u043c\u044d\u043d\u044b, \u044f\u043a\u0456\u044f \u0445\u0432\u0430\u0440\u044d\u044e\u0446\u044c, \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u043c\u0456, \u0430\u043b\u0435 \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u0456\u0445 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0456\u0442\u0430\u044e\u0446\u044c \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u044f\u043a\u0456\u044f \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u044b, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u044b \u0456 \u045e\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a\u0456 \u0430\u0442\u0430\u0447\u0430\u0435 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u044b\u043c \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u043c \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u0456\u043c\u044f \u041f\u0430\u043d\u0430. \u041c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u043b\u0456 \u043f\u0440\u0430 \u043d\u0430\u0441&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 \u0424\u043b\u043f 1, 23b; 3, 8b; 1, 21; 2, 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u044e \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0456 \u0431\u044b\u0446\u044c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c; \u0434\u0437\u0435\u043b\u044f \u042f\u0433\u043e \u044f \u045e\u0441\u0451 \u0441\u0442\u0440\u0430\u0446\u0456\u045e \u0456 \u043b\u0456\u0447\u0443 \u0441\u043c\u0435\u0446\u0446\u0435\u043c, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0431\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0436\u044b\u0446\u0446\u0451 &ndash; \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u0441\u043c\u0435\u0440\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u0432\u044b\u0433\u0430\u0434\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0456 \u043f\u0440\u0430\u043b\u044c\u044e\u0441\u044f \u044f\u043a \u0430\u0445\u0432\u044f\u0440\u0430 \u043d\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0432\u0435\u0440\u044b \u0432\u0430\u0448\u0430\u0439, \u0442\u043e \u0440\u0430\u0434\u0443\u044e\u0441\u044f \u0456 \u0446\u0435\u0448\u0443\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0443\u0441\u0456\u043c\u0456 \u0432\u0430\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0436\u044b\u0446\u0446\u0451 &ndash; \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u0441\u043c\u0435\u0440\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u0432\u044b\u0433\u0430\u0434\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"623","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 118 \u043f\u0441\u0430\u043b\u044c\u043c\u0430&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 20, 43-45. 48; CSEL 62, 466-468)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u0435\u0440\u043d\u044b \u0441\u0432\u0435\u0434\u043a\u0430 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u0430\u0439\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u043c\u043d\u043e\u0433\u0456\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u043a\u0430\u0431 \u0443\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430&raquo; (\u0414\u0437 14, 22). \u041a\u0430\u043b\u0456 \u0448\u043c\u0430\u0442 \u0451\u0441\u0446\u044c \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443, \u0442\u043e \u0448\u043c\u0430\u0442 \u0451\u0441\u0446\u044c \u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e, \u0430 \u0434\u0437\u0435 \u0448\u043c\u0430\u0442 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434, \u0442\u0430\u043c \u0456 \u0448\u043c\u0430\u0442 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e. \u041a\u0430\u0440\u044b\u0441\u043d\u0430 \u0434\u043b\u044f \u0446\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u0448\u043c\u0430\u0442 \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u044f\u045e, \u0431\u043e \u0441\u044f\u0440\u043e\u0434 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u0445 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u045e \u043b\u044f\u0433\u0447\u044d\u0439 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0432\u044f\u043d\u0435\u0446 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0437\u044c\u043c\u0435\u043c \u0437\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0441\u0432. \u0421\u0435\u0431\u0430\u0441\u0446\u044c\u044f\u043d\u0430, \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430, \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u043d\u044b \u044f\u043a\u043e\u0433\u0430 \u0434\u043b\u044f \u043d\u0435\u0431\u0430 \u043c\u044b \u0441\u0451\u043d\u043d\u044f \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0451\u043d \u0443 \u041c\u0456\u043b\u0430\u043d\u0435. \u041c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0442\u0430\u043c \u0441\u043f\u044b\u043d\u0456\u045e\u0441\u044f \u045e\u0436\u043e \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434 \u0430\u043b\u044c\u0431\u043e \u044f\u0448\u0447\u044d \u043d\u0435 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u045e\u0441\u044f, \u0430\u043b\u044c\u0431\u043e \u043d\u0435 \u0431\u044b\u045e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u043f\u0442\u043e\u045e\u043d\u044b\u043c. \u0423 \u043b\u044e\u0431\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u0421\u0435\u0431\u0430\u0441\u0446\u044c\u044f\u043d \u0441\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u045e, \u0448\u0442\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u0442\u0443\u0442 \u043d\u0456\u044f\u043a\u0430\u0439 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u044b \u0430\u043b\u044c\u0431\u043e \u044f\u043d\u0430 \u045e\u0436\u043e \u0441\u043f\u044b\u043d\u044f\u043b\u0430\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0451\u043d \u0432\u044b\u0440\u0443\u0448\u044b\u045e \u0443 \u0420\u044b\u043c, \u0434\u0437\u0435 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u045e \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u0456 \u0432\u0435\u0440\u044b \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u043b\u0456\u0441\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0433\u0430\u043d\u0435\u043d\u043d\u0456. \u0422\u0443\u0442 \u0436\u0430 \u0451\u043d \u0431\u044b\u045e \u0437\u0430\u043c\u0443\u0447\u0430\u043d\u044b, \u0442\u0443\u0442 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0432\u044f\u043d\u043e\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456. \u0422\u0443\u0442, \u043a\u0443\u0434\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u044f\u043a \u0447\u0443\u0436\u044b, \u0451\u043d \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0436\u044b\u043b\u043b\u0451 \u0432\u0435\u0447\u043d\u0430\u0439 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456. \u041a\u0430\u043b\u0456 \u0431 \u0431\u044b\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u0437\u0456\u043d \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u044c, \u0421\u0435\u0431\u0430\u0441\u0446\u044c\u044f\u043d \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0431\u044b \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0432\u044f\u043d\u043a\u0430 \u044f\u043a \u043c\u0443\u0447\u0430\u043d\u0456\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0437\u043b\u043e \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u044f\u043c\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u0430\u0447\u043d\u044b, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u043c\u044b \u043d\u0435 \u0431\u0430\u0447\u044b\u043c. \u0406 \u0433\u044d\u0442\u044b\u0445 \u043d\u0430\u043c\u043d\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0430\u0434\u0437\u0456\u043d \u0433\u0430\u043b\u043e\u045e\u043d\u044b \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u044c \u0432\u044b\u0434\u0430\u045e \u0448\u043c\u0430\u0442 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043d\u0430 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434, \u0430 \u045e \u043a\u0430\u043d\u043a\u0440\u044d\u0442\u043d\u044b\u0445 \u0433\u0430\u0440\u0430\u0434\u0430\u0445 \u0446\u0456 \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u044f\u0445 \u0431\u044b\u043b\u0456 \u0441\u0432\u0430\u0435 \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u0456, \u0442\u0430\u043a \u0456 \u0441\u0430\u0442\u0430\u043d\u0430 \u0432\u044b\u0441\u044b\u043b\u0430\u0435 \u0441\u0432\u0430\u0456\u0445 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e, \u0456 \u044f\u043d\u044b \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u043d\u0435\u0448\u043d\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434, \u0430\u043b\u0435 \u0456 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u044b, \u0443 \u0434\u0443\u0448\u0430\u0445 \u0430\u0441\u043e\u0431\u043d\u044b\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u0442\u0430\u043a\u0456\u044f \u0433\u0430\u043d\u0435\u043d\u043d\u0456 \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u0423\u0441\u0435, \u0445\u0442\u043e \u0436\u0430\u0434\u0430\u0435 \u0436\u044b\u0446\u044c \u043f\u0430\u0431\u043e\u0436\u043d\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c&raquo; (2 \u0426\u0456\u043c 3, 12). \u0423\u0441\u0435, &ndash; \u043a\u0430\u0436\u0430, &ndash; \u0431\u0435\u0437 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u044f. \u0425\u0442\u043e \u0436 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435\u043c, \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c \u041f\u0430\u043d \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434 \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0436\u0430 \u0448\u043c\u0430\u0442 \u0451\u0441\u0446\u044c \u0443 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430\u0441\u0446\u0456 \u045e\u043a\u0440\u044b\u0442\u044b\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0432\u044b\u0437\u043d\u0430\u044e\u0446\u044c \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u045e \u043f\u0440\u0430 \u0442\u0430\u043a\u043e\u0435 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u043e \u043a\u0430\u0437\u0430\u045e: &laquo;\u0425\u0432\u0430\u043b\u0430 \u043d\u0430\u0448\u0430\u044f &ndash; \u0433\u044d\u0442\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430&raquo; (2 \u041a\u0430\u0440 1, 12).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0441\u0432\u044f\u0442\u044b, \u044f\u043a\u0456 \u0434\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456 \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u0437\u0430 \u0411\u043e\u0436\u044b \u0437\u0430\u043a\u043e\u043d \u0456 \u043d\u0435 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f \u043f\u0430\u0433\u0440\u043e\u0437\u0430\u045e \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u044f\u045e,<span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0431\u044b\u045e \u044f\u0433\u043e\u043d\u0430\u0439 \u0441\u0456\u043b\u0430\u044e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u0437\u044f\u043c\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u0456 \u0434\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0431\u044b\u045e \u044f\u0433\u043e\u043d\u0430\u0439 \u0441\u0456\u043b\u0430\u044e.<\/p>\r\n"}, {"GCH_CH_2_ID":"624","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u043f\u0430\u043d\u043d\u0430\u045e&raquo; \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 1, cap. 2. 5. 7-9: PL 16 [edit. 1845], 189-191)<\/span><br \/><span style=\"color: #ff0000;\">\u0423 \u0442\u0430\u043a\u0456\u043c \u043c\u0430\u043b\u0430\u0434\u044b\u043c \u0443\u0437\u0440\u043e\u0441\u0446\u0435 \u043f\u0430\u0441\u0442\u0430\u043b\u0435\u043b\u0430 \u0434\u043b\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0441\u0451\u043d\u043d\u044f \u045e\u0441\u043f\u0430\u043c\u0456\u043d \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u043d\u0430\u045e \u0434\u043b\u044f \u043d\u0435\u0431\u0430 \u043f\u0430\u043d\u043d\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u044f\u0435 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c. \u0412\u043e\u0441\u044c \u0434\u0437\u0435\u043d\u044c \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u043d\u0430\u045e \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u044b. \u0421\u0451\u043d\u043d\u044f \u045e\u0441\u043f\u0430\u043c\u0456\u043d \u0441\u0432. \u0410\u0433\u043d\u0435\u0448\u043a\u0456. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u0456, \u044f\u043d\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u0430 \u045e \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e. \u0428\u0442\u043e \u0436 \u0433\u044d\u0442\u0430 \u0437\u0430 \u0433\u0430\u043d\u0435\u0431\u043d\u0430\u044f \u0436\u043e\u0440\u0441\u0442\u043a\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u043b\u0430 \u0442\u0430\u043a\u043e\u0433\u0430 \u043c\u0430\u043b\u0430\u0434\u043e\u0433\u0430 \u0436\u044b\u0446\u0446\u044f? \u0410\u043b\u0435 \u0456 \u0448\u0442\u043e \u0436 \u0433\u044d\u0442\u0430 \u0437\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043c\u043e\u0446 \u0432\u0435\u0440\u044b, \u044f\u043a\u0430\u044f \u043d\u0430\u0432\u0430\u0442 \u0443 \u0442\u0430\u043a\u043e\u0439 \u043c\u0430\u043b\u043e\u0439 \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u0435 \u0434\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435?<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0443\u0432\u043e\u0433\u0443\u043b\u0435 \u043c\u0430\u0433\u043b\u043e \u0431\u044b\u0446\u044c \u043c\u0435\u0441\u0446\u0430 \u043d\u0430 \u0440\u0430\u043d\u0443 \u045e \u0442\u0430\u043a\u0456\u043c \u043c\u0430\u043b\u044b\u043c \u0446\u0435\u043b\u0435? \u041d\u0435 \u0431\u044b\u043b\u043e \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u045e\u0434\u0430\u0440\u0443 \u0436\u0430\u043b\u0435\u0437\u0430\u043c, \u0430\u043b\u0435 \u0431\u044b\u043b\u043e \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456 \u0436\u0430\u043b\u0435\u0437\u0430. \u0414\u0437\u044f\u045e\u0447\u0430\u0442\u044b \u044f\u0435 \u045e\u0437\u0440\u043e\u0441\u0442\u0443 \u0431\u0430\u044f\u0446\u0446\u0430 \u043d\u0430\u0432\u0430\u0442 \u0441\u0443\u0440\u043e\u0432\u0430\u0433\u0430 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u0442\u0432\u0430\u0440\u0443 \u0441\u0432\u0430\u0456\u0445 \u0431\u0430\u0446\u044c\u043a\u043e\u045e, \u0430 \u043a\u0430\u043b\u0456 \u045e\u043a\u043e\u043b\u0456\u0446\u044c \u0456\u0445 \u0456\u0433\u043e\u043b\u043a\u0430, \u043f\u043b\u0430\u0447\u0443\u0446\u044c, \u043d\u0456\u0431\u044b \u043c\u043e\u0446\u043d\u0430 \u043f\u0430\u0440\u0430\u043d\u0456\u043b\u0456\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u0436 \u0441\u0442\u0430\u0456\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u043a\u0440\u044b\u0432\u0430\u0432\u044b\u0445 \u043a\u0430\u0442\u0430\u045e \u0430\u0434\u0432\u0430\u0436\u043d\u0430. \u041d\u0430 \u0433\u0443\u043a \u0436\u0430\u0445\u043b\u0456\u0432\u044b\u0445 \u043a\u0430\u0439\u0434\u0430\u043d\u0430\u045e \u0441\u0442\u0430\u0456\u0446\u044c \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430. \u0423\u0441\u0451 \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u0430\u0434\u0434\u0430\u0435 \u043f\u0430\u0434 \u0443\u0434\u0430\u0440\u044b \u0436\u043e\u0440\u0441\u0442\u043a\u0430\u0433\u0430 \u043c\u0443\u0447\u044b\u0446\u0435\u043b\u044f. \u042f\u0448\u0447\u044d \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0441\u043c\u0435\u0440\u0446\u044c, \u0430\u043b\u0435 \u045e\u0436\u043e \u0433\u0430\u0442\u043e\u0432\u0430\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u044f\u0435. \u041f\u0440\u044b\u0446\u044f\u0433\u043d\u0443\u0442\u0430\u044f \u043d\u0430\u0441\u0456\u043b\u0443 \u0434\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430, \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u043b\u0430\u044e\u0447\u0430\u0433\u0430 \u0432\u043e\u0433\u043d\u0456\u0448\u0447\u0430 \u044f\u043d\u0430 \u0432\u044b\u0446\u044f\u0433\u0432\u0430\u0435 \u0440\u0443\u043a\u0456 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u0430\u0442\u0430\u0446\u043a\u0430\u0433\u0430 \u043f\u043e\u043b\u044b\u043c\u044f \u0440\u043e\u0431\u0456\u0446\u044c \u0437\u043d\u0430\u043a \u0425\u0440\u044b\u0441\u0442\u0430-\u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u044b. \u0423\u043a\u043b\u0430\u0434\u0430\u0435 \u0441\u0432\u0430\u044e \u0448\u044b\u044e \u0456 \u0440\u0443\u043a\u0456 \u045e \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u044f \u043a\u0430\u0439\u0434\u0430\u043d\u044b, \u0430\u043b\u0435 \u044f\u043d\u044b \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0437\u0430\u0446\u0456\u0441\u043d\u0443\u0446\u044c \u0442\u0430\u043a\u0456\u0445 \u0434\u0440\u043e\u0431\u043d\u044b\u0445 \u0447\u0430\u0441\u0442\u0430\u043a \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u0436 \u0433\u044d\u0442\u0430 \u043d\u043e\u0432\u044b \u0432\u0456\u0434 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430? \u042f\u0448\u0447\u044d \u043d\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0437\u0434\u0437\u0435\u043a\u0430\u045e, \u0430\u043b\u0435 \u045e\u0436\u043e \u0441\u0442\u0430\u043b\u0430\u044f \u0434\u043b\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456. \u041d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u043c\u0430\u043b\u0430\u0434\u044b \u045e\u0437\u0440\u043e\u0441\u0442 \u0441\u0442\u0430\u043b\u0430 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u0446\u0430\u0439 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0442\u0430\u043a \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0456\u0448\u043b\u0430 \u0431 \u0443 \u0434\u0437\u0435\u043d\u044c \u0448\u043b\u044e\u0431\u0443 \u0434\u0430 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430, \u044f\u043a \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0456 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456\u0448\u043b\u0430 \u043d\u0430 \u043c\u0435\u0441\u0446\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f. \u0410\u0437\u0434\u043e\u0431\u0430\u0439 \u044f\u0435 \u0433\u0430\u043b\u0430\u0432\u044b \u0431\u044b\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u043d\u0435 \u045e\u043c\u0435\u043b\u0430 \u0437\u0430\u043a\u043e\u043b\u0430\u0442\u044b\u044f \u0432\u0430\u043b\u0430\u0441\u044b; \u044f\u043d\u0430 \u0431\u044b\u043b\u0430 \u045e\u0432\u0435\u043d\u0447\u0430\u043d\u0430\u044f \u0446\u043d\u043e\u0442\u0430\u043c\u0456, \u0430 \u043d\u0435 \u043a\u0432\u0435\u0442\u043a\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u043f\u043b\u0430\u0447\u0443\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u044f\u043d\u0430. \u041c\u043d\u043e\u0433\u0456\u044f \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u044e\u0446\u0446\u0430, \u0448\u0442\u043e \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u0430 \u0437 \u0442\u0430\u043a\u043e\u0439 \u043b\u0451\u0433\u043a\u0430\u0441\u0446\u044e \u0440\u0430\u0437\u0432\u0456\u0442\u0432\u0430\u0435\u0446\u0446\u0430 \u0437 \u0436\u044b\u0446\u0446\u0451\u043c, \u044f\u043a\u043e\u0433\u0430 \u044f\u0448\u0447\u044d \u043d\u0435 \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u043b\u0430. \u0410\u0434\u0434\u0430\u0435 \u044f\u0433\u043e, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u045e\u0436\u043e \u0434\u0430\u0439\u0448\u043b\u0430 \u0434\u0430 \u044f\u0433\u043e \u043a\u0430\u043d\u0446\u0430. \u0417\u0434\u0437\u0456\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u045e\u0441\u0435, \u0448\u0442\u043e \u044f\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u0441\u0432\u0435\u0434\u043a\u0430\u044e \u0441\u0430\u043c\u043e\u0433\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043c\u0430\u043b\u0430\u0434\u043e\u0433\u0430 \u045e\u0437\u0440\u043e\u0441\u0442\u0443 \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u0431 \u043d\u0430\u0432\u0430\u0442 \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0443 \u0441\u0443\u0434\u0437\u0435. \u0423\u0447\u044b\u043d\u0456\u043b\u0430 \u0442\u0430\u043a, \u0448\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u0435\u0439, \u043a\u0430\u043b\u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0430 \u043f\u0440\u0430 \u0411\u043e\u0433\u0430, \u0445\u043e\u0446\u044c \u043d\u0435 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u0431 \u0435\u0439, \u043a\u0430\u043b\u0456 \u0431 \u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0430 \u043f\u0440\u0430 \u043b\u044e\u0434\u0437\u0435\u0439. \u0428\u0442\u043e \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0430-\u0437\u0430 \u043f\u0440\u044b\u0440\u043e\u0434\u0443, \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u043f\u0440\u044b\u0440\u043e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u043b\u044c\u043a\u0456 \u0436 \u043f\u0430\u0433\u0440\u043e\u0437\u0430\u045e \u0431\u044b\u043b\u043e \u0437 \u0431\u043e\u043a\u0443 \u043a\u0430\u0442\u0430, \u043a\u0430\u0431 \u044f\u0435 \u0437\u0430\u043f\u0430\u043b\u043e\u0445\u0430\u0446\u044c! \u041a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0456\u043b\u0436\u044b\u0432\u044b\u0445 \u043f\u0430\u0445\u0432\u0430\u043b, \u043a\u0430\u0431 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u0446\u044c \u044f\u0435! \u041a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u045e \u0434\u0430\u0432\u0430\u043b\u0456 \u043c\u043d\u043e\u0433\u0456\u044f, \u0445\u0442\u043e \u0456\u043c\u043a\u043d\u0443\u045e\u0441\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u044f\u0435 \u0440\u0443\u043a\u0443! \u042f\u043d\u0430 \u0436: &laquo;\u0411\u044b\u043b\u043e \u0431 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0434\u043b\u044f \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430 \u0447\u0430\u043a\u0430\u0446\u044c \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0433\u0430. \u041c\u0430\u0456\u043c \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u0451\u0441\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0435\u0440\u0448\u044b\u043c \u043c\u044f\u043d\u0435 \u0432\u044b\u0431\u0440\u0430\u045e. \u0427\u0430\u0433\u043e \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0448, \u043c\u0443\u0447\u044b\u0446\u0435\u043b\u044c? \u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u043c\u0456\u0440\u0430\u0435 \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u043b\u044e\u0431\u044f\u0446\u044c \u0432\u0430\u0447\u044b\u043c\u0430 \u0446\u0435\u043b\u0430. \u0422\u0430\u043a\u043e\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0443&raquo;. \u0423\u0441\u0442\u0430\u043b\u0430, \u043f\u0430\u043c\u0430\u043b\u0456\u043b\u0430\u0441\u044f, \u043f\u0430\u043a\u043b\u0430\u043b\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u043f\u0430\u0434 \u043c\u0435\u0447.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0442\u0430\u0434\u044b \u0442\u044b \u043c\u043e\u0433 \u0431\u044b \u045e\u0431\u0430\u0447\u044b\u0446\u044c, \u044f\u043a \u0437\u0430\u0434\u0440\u044b\u0436\u044d\u045e \u043a\u0430\u0442, \u043d\u0456\u0431\u044b \u0433\u044d\u0442\u0430 \u0451\u043d \u0441\u0430\u043c \u0431\u044b\u045e \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b. \u0417\u0430\u0442\u0440\u0430\u0441\u043b\u0430\u0441\u044f \u0440\u0443\u043a\u0430 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0430, \u0437\u0431\u044f\u043b\u0435\u043b\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u0447\u0443\u0436\u0443\u044e \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0443, \u0442\u0430\u0434\u044b \u044f\u043a \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u0430 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430 \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0430 \u043d\u0430 \u0441\u0432\u0430\u044e. \u0412\u043e\u0441\u044c \u0436\u0430 \u045e \u0430\u0434\u043d\u043e\u0439 \u0430\u0445\u0432\u044f\u0440\u044b \u0431\u0430\u0447\u044b\u0446\u0435 \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435: \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0456 \u0432\u0435\u0440\u044b. \u0417\u0430\u0445\u0430\u0432\u0430\u043b\u0430 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u0437\u043d\u0430\u0447\u044b\u043c \u0434\u0437\u0435\u043d\u044c \u0441\u0432\u044f\u0442\u043e\u0439 \u0410\u0433\u043d\u0435\u0448\u043a\u0456, \u0443\u0441\u043f\u043e\u043c\u043d\u0456\u043c \u044f\u0435 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u043c\u0435\u0440\u043b\u0430 \u045e \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456, \u0430\u043b\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043d\u0430 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0430 \u0441\u0430\u043c\u043e\u0433\u0430 \u0414\u0430\u045e\u0446\u0443 \u0436\u044b\u0446\u0446\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043c\u0435\u0440\u043b\u0430 \u045e \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456, \u0430\u043b\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n"}, {"GCH_CH_2_ID":"625","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 276, 1-2: PL 38, 1256)<\/span><br \/><span style=\"color: #ff0000;\">\u0412\u0456\u043d\u0446\u044d\u043d\u0442 \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0443 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0441\u0432\u0435\u0442<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0412\u0430\u043c \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u0430\u043b\u0435 \u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u0430 \u042f\u0433\u043e&raquo; (\u0424\u043b\u043f 1, 29), &minus; \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u044f\u043a\u0430\u043d \u0412\u0456\u043d\u0446\u044d\u043d\u0442 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435. \u0410\u0442\u0440\u044b\u043c\u0430\u045e \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u045e. \u042f\u043a \u0436\u0430 \u043c\u043e\u0433 \u0431\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u045e? \u0417\u0430\u0445\u0430\u0432\u0430\u045e \u0432\u0435\u0440\u0443 \u043f\u0430\u0434\u0447\u0430\u0441 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f, \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c \u043f\u0430\u0434\u0447\u0430\u0441 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0434\u0432\u0430\u0436\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c, \u0441\u043f\u0430\u0434\u0437\u0435\u044e\u0447\u044b\u0441\u044f \u043d\u0430 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u0441\u0432\u0430\u044e \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u0430\u0434\u0447\u0443\u0435 \u0441\u043f\u0430\u043a\u0443\u0441\u0443. \u0411\u043e \u0430\u0434 \u0411\u043e\u0433\u0430 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u0440\u0430\u0437\u0443\u043c\u043d\u0430 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0430\u0434 \u042f\u0433\u043e \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u043c\u0443\u0436\u043d\u0430 \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0437\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0433\u0430\u0434\u0430\u0439\u0446\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u043d\u0430\u043f\u0430\u043c\u0456\u043d \u0441\u0432\u0430\u0456\u043c \u0432\u0443\u0447\u043d\u044f\u043c. \u0423\u0441\u043f\u043e\u043c\u043d\u0456\u0446\u0435, \u044f\u043a \u041a\u0430\u0440\u043e\u043b\u044c \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0443\u0437\u0431\u0440\u043e\u0439\u0432\u0430\u0435 \u0441\u0432\u0430\u0456\u0445 \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u045e \u0443 \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u0437\u0431\u0440\u043e\u044e, \u044f\u043a \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0443, \u044f\u043a \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0456 \u0430\u0431\u044f\u0446\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443. \u041a\u0430\u043b\u0456 \u0436 \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0432\u0443\u0447\u043d\u044f\u043c: &laquo;\u0423 \u0441\u0432\u0435\u0446\u0435 \u0437\u0432\u0435\u0434\u0430\u0435\u0446\u0435 \u045e\u0446\u0456\u0441\u043a&raquo;, \u0442\u043e \u0430\u0434\u0440\u0430\u0437\u0443 \u0434\u0430\u0434\u0430\u045e: &laquo;\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0430\u0434\u0432\u0430\u0436\u043d\u044b\u043c\u0456: \u042f \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0441\u0432\u0435\u0442&raquo; (\u042f\u043d 16, 33).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e \u0447\u0430\u043c\u0443 \u0436 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u0446\u0446\u0430, \u0434\u0430\u0440\u0430\u0433\u0456\u044f \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u0441\u0432. \u0412\u0456\u043d\u0446\u044d\u043d\u0442 \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0443 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0441\u0432\u0435\u0442? \u0411\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0423 \u0441\u0432\u0435\u0446\u0435 \u0437\u0432\u0435\u0434\u0430\u0435\u0446\u0435 \u045e\u0446\u0456\u0441\u043a&raquo;. \u0421\u0432\u0435\u0442 \u0437\u043d\u0456\u0448\u0447\u0430\u0435, \u0430\u043b\u0435 \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c; \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430. \u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0432\u044b\u0441\u044b\u043b\u0430\u0435 \u0434\u0432\u0430 \u0432\u043e\u0439\u0441\u043a\u0456: \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u043f\u0430\u0434\u043c\u0430\u043d\u0443\u0446\u044c; \u0441\u0442\u0440\u0430\u0445, \u043a\u0430\u0431 \u0437\u043d\u0435\u0430\u0445\u0432\u043e\u0446\u0456\u0446\u044c. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043f\u0430\u0440\u0430\u043b\u0456\u0437\u0443\u0435 \u043d\u0430\u0441 \u0448\u0443\u043a\u0430\u043d\u043d\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456 \u0456 \u043d\u0435 \u043f\u0443\u0436\u0430\u0435 \u0447\u0443\u0436\u0430\u044f \u0436\u043e\u0440\u0441\u0442\u043a\u0430\u0441\u0446\u044c, \u0456 \u0442\u0430\u043a \u043c\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043c \u0441\u0432\u0435\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0430\u0434\u043d\u044b\u043c \u0456 \u045e \u0434\u0440\u0443\u0433\u0456\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435, \u0442\u0430\u043c\u0443 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d \u043d\u0435 \u0441\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u045e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435. \u041a\u0430\u043b\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c, \u0443\u0441\u0451 \u043f\u0430\u0447\u044b\u043d\u0430\u0435 \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0446\u044c \u043d\u0435\u043f\u0440\u0430\u045e\u0434\u0430\u043f\u0430\u0434\u043e\u0431\u043d\u0430, \u0430 \u043a\u0430\u043b\u0456 \u0411\u043e\u0436\u0443\u044e \u043c\u043e\u0446, \u0442\u043e \u045e\u0441\u0451 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0435\u043b\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430 \u0431\u044b\u043b\u043e \u0430\u0434\u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043d\u0430 \u043d\u0435\u0447\u0443\u0432\u0430\u043d\u044b\u044f \u0437\u0434\u0437\u0435\u043a\u0456. \u041d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u044f \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u044f\u0433\u043e \u0433\u043e\u043b\u0430\u0441\u0435. \u0412\u044f\u043b\u0456\u043a\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u045e\u0441\u0435 \u044f\u0433\u043e\u043d\u044b\u044f \u0447\u043b\u0435\u043d\u044b, \u0430\u043b\u0435 \u0442\u0430\u043a\u0456 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b \u0441\u043f\u0430\u043a\u043e\u0439 \u0431\u044b\u045e \u0443 \u044f\u0433\u043e\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0435, \u0448\u0442\u043e \u045e \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u0456 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0434\u0443\u043c\u0430\u0446\u044c, \u0448\u0442\u043e \u043f\u0430\u0434\u0447\u0430\u0441 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0412\u0456\u043d\u0446\u044d\u043d\u0442\u0430 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u044b, \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u044b \u0446\u044f\u0440\u043f\u0435\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0442\u0430\u043a \u0431\u044b\u043b\u043e \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u043c\u0430\u0435 \u0431\u0440\u0430\u0442\u044b, \u0442\u0430\u043a \u0431\u044b\u043b\u043e. \u0425\u0442\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u044b \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e. \u0411\u043e \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0431\u044f\u0446\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0441\u0432\u0435\u0434\u043a\u0430\u043c, \u043a\u0430\u043b\u0456 \u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0456\u0445 \u0434\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u0445 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e. \u0412\u043e\u0441\u044c \u0448\u0442\u043e \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0435 \u0442\u0443\u0440\u0431\u0443\u0439\u0446\u0435\u0441\u044f, \u044f\u043a \u0430\u0431\u043e \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0431\u043e \u043d\u0435 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u0430 \u0414\u0443\u0445 \u0410\u0439\u0446\u0430 \u0432\u0430\u0448\u0430\u0433\u0430 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u045e \u0432\u0430\u0441&raquo; (\u041c\u0446 10, 19-20).<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0435\u043b\u0430 \u0431\u044b\u043b\u043e \u0430\u0434\u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u043c, \u0430 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0414\u0443\u0445. \u041a\u0430\u043b\u0456 \u0436 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0414\u0443\u0445, \u0442\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043b\u0430\u0431\u0435\u043b\u0430 \u0437\u043b\u043e\u0441\u0446\u044c, \u0430\u043b\u0435 \u0456 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u043d\u0430\u0431\u044b\u0432\u0430\u043b\u0430 \u043c\u043e\u0446.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0401\u045e 23, 10. 11; \u0424\u043b\u043f 3, 8. 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u044f\u043a \u0437\u043e\u043b\u0430\u0442\u0430, \u0448\u0442\u043e \u0430\u0447\u044b\u0448\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0430\u0433\u043d\u0456; \u043d\u043e\u0433\u0456 \u043c\u0430\u0435 \u0456\u0434\u0443\u0446\u044c \u0437\u0430 \u0406\u043c; <span style=\"color: #ff0000;\">*<\/span> \u0442\u0440\u044b\u043c\u0430\u044e\u0441\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0448\u043b\u044f\u0445\u0443 \u0456 \u043d\u0435 \u0437\u0431\u043e\u0447\u0432\u0430\u044e \u0437 \u044f\u0433\u043e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u0451 \u043b\u0456\u0447\u0443 \u0441\u0442\u0440\u0430\u0442\u0430\u044e \u0434\u0437\u0435\u043b\u044f \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u042f\u0433\u043e\u043d\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0440\u044b\u043c\u0430\u044e\u0441\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0448\u043b\u044f\u0445\u0443 \u0456 \u043d\u0435 \u0437\u0431\u043e\u0447\u0432\u0430\u044e \u0437 \u044f\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"626","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0423\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0434\u0430 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f&raquo; \u0441\u0432. \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u043a\u0430 \u0421\u0430\u043b\u044c\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Pars 1, cap. 3)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u044f \u0456 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430\u044f <\/span><br \/><span style=\"color: #ff0000;\">\u0432\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f\u0445 \u0456 \u0441\u0442\u0430\u043d\u0430\u0445<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433, \u0441\u0442\u0432\u0430\u0440\u0430\u044e\u0447\u044b \u0441\u0432\u0435\u0442, \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0440\u0430\u0441\u043b\u0456\u043d\u0430\u043c \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u043b\u043e\u0434 &laquo;\u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0440\u043e\u0434\u0443&raquo; (\u0411\u044b\u0446 1, 11). \u0422\u043e\u0435 \u0436 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c, \u0436\u044b\u0432\u044b\u043c \u0440\u0430\u0441\u043b\u0456\u043d\u0430\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u043f\u043b\u0451\u043d \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430 \u0441\u0442\u0430\u043d\u0443 \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0440\u0430\u0437\u0432\u0456\u0432\u0430\u0446\u044c, \u0445\u043e\u0446\u044c \u0456 \u043f\u0430-\u0440\u043e\u0437\u043d\u0430\u043c\u0443, \u0441\u0432\u0430\u044e \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c: \u0456\u043d\u0430\u043a\u0448 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u0443, \u0456\u043d\u0430\u043a\u0448 \u0440\u0430\u043c\u0435\u0441\u043d\u0456\u043a \u0430\u0431\u043e \u0441\u043b\u0443\u0433\u0430, \u0456\u043d\u0430\u043a\u0448 \u043a\u043d\u044f\u0437\u044c, \u0443\u0434\u0430\u0432\u0430, \u043f\u0430\u043d\u043d\u0430 \u0430\u0431\u043e \u0436\u043e\u043d\u043a\u0430. \u0406 \u0433\u044d\u0442\u0430 \u043d\u0430\u0432\u0430\u0442 \u043d\u0435 \u045e\u0441\u0451. \u042f\u0448\u0447\u044d \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0440\u0430\u0437\u0432\u0456\u0432\u0430\u045e \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u0441\u0456\u043b\u0430\u043c, \u0437\u0430\u043d\u044f\u0442\u043a\u0430\u043c \u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043a\u0430\u0436\u044b \u043c\u043d\u0435, \u043f\u0440\u0430\u0448\u0443, \u0424\u0456\u043b\u0430\u0442\u044d\u044f, \u0446\u0456 \u0431\u044b\u043b\u043e \u0431 \u0434\u043e\u0431\u0440\u0430, \u043a\u0430\u043b\u0456 \u0431 \u0431\u0456\u0441\u043a\u0443\u043f \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0436\u044b\u0446\u044c \u0443 \u0441\u0430\u043c\u043e\u0446\u0435 \u044f\u043a \u043a\u0430\u0440\u0442\u0443\u0437\u0456\u044f\u043d\u0446\u044b, \u043a\u0430\u043b\u0456 \u0431 \u0436\u0430\u043d\u0430\u0442\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u043d\u0435 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u043a\u0430\u043f\u0443\u0446\u044b\u043d\u0430\u045e \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u043b\u0456\u0441\u044f \u043f\u0440\u0430 \u043f\u0430\u0432\u0435\u043b\u0456\u0447\u044d\u043d\u043d\u0435 \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u043a\u0430\u043b\u0456 \u0431 \u0440\u0430\u043c\u0435\u0441\u043d\u0456\u043a \u0443\u0432\u0435\u0441\u044c \u0434\u0437\u0435\u043d\u044c \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u0456\u045e \u0443 \u043a\u0430\u0441\u0446\u0451\u043b\u0435 \u044f\u043a \u0437\u0430\u043a\u043e\u043d\u043d\u0456\u043a, \u0430 \u0437\u0430\u043a\u043e\u043d\u043d\u0456\u043a \u0437\u0430\u0439\u043c\u0430\u045e\u0441\u044f \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u043c\u0456 \u0441\u0443\u0441\u0442\u0440\u044d\u0447\u0430\u043c\u0456 \u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456, \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043d\u044b \u0441\u043f\u044f\u0448\u0430\u0446\u0446\u0430 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u0456\u0445, \u043d\u0430\u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0431\u0456\u0441\u043a\u0443\u043f? \u0426\u0456 \u0436 \u0442\u0430\u043a\u0430\u044f \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u0431\u044b\u043b\u0430 \u0431 \u0441\u043c\u0435\u0448\u043d\u0430\u0439, \u043d\u0435\u045e\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430\u0439 \u0456 \u043d\u044f\u0437\u043d\u043e\u0441\u043d\u0430\u0439? \u0410\u043b\u0435 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0442\u0430\u043a\u0456\u044f \u043f\u0430\u043c\u044b\u043b\u043a\u0456 \u0456 \u043d\u0435\u043f\u0430\u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0456 \u0437\u0434\u0430\u0440\u0430\u044e\u0446\u0446\u0430 \u0432\u0435\u043b\u044c\u043c\u0456 \u0447\u0430\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0436\u0430 \u043d\u0435, \u043c\u0430\u044f \u0424\u0456\u043b\u0430\u0442\u044d\u044f: \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u044f\u043d\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u044f \u0456 \u0448\u0447\u044b\u0440\u0430\u044f, \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0440\u0443\u0439\u043d\u0443\u0435, \u0430\u043b\u0435 \u045e\u0441\u0451 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435 \u0456 \u0434\u0430\u043f\u0430\u045e\u043d\u044f\u0435. \u041a\u0430\u043b\u0456 \u0436 \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u0435 \u0456 \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u043c\u0443 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044e \u0430\u0431\u043e \u0441\u0442\u0430\u043d\u0443, \u0431\u044f\u0441\u0441\u043f\u0440\u044d\u0447\u043d\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0447\u0430\u043b\u0430 \u0442\u0430\u043a \u0437\u0431\u0456\u0440\u0430\u0435 \u043c\u0451\u0434 \u0437 \u043a\u0432\u0435\u0442\u0430\u043a, \u0448\u0442\u043e \u043d\u0435 \u0440\u043e\u0431\u0456\u0446\u044c \u0456\u043c \u043d\u0456\u044f\u043a\u0430\u0439 \u0448\u043a\u043e\u0434\u044b. \u042f\u043d\u0430 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0456\u0445 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u044b\u043c\u0456 \u0456 \u0441\u0432\u0435\u0436\u044b\u043c\u0456, \u0442\u0430\u043a \u044f\u043a \u0456\u0445 \u0437\u0430\u0441\u0442\u0430\u043b\u0430. \u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u044f \u0436 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0440\u043e\u0431\u0456\u0446\u044c \u0431\u043e\u043b\u044c\u0448: \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u0435 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u043c\u0443 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044e, \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u043c\u0443 \u0437\u0430\u043d\u044f\u0442\u043a\u0443, \u0430\u043b\u0435 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0443\u0441\u0451 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435 \u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u044f\u043a \u0448\u043b\u044f\u0445\u0435\u0442\u043d\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456, \u0443\u043a\u0456\u043d\u0443\u0442\u044b\u044f \u045e \u043c\u0451\u0434, \u043d\u0430\u0431\u044b\u0432\u0430\u044e\u0446\u044c \u0431\u043e\u043b\u044c\u0448\u044b \u0431\u043b\u044f\u0441\u043a, \u044f\u0441\u043d\u0435\u044e\u0447\u044b \u0441\u0432\u0430\u0456\u043c\u0456 \u043a\u043e\u043b\u0435\u0440\u0430\u043c\u0456, \u0442\u0430\u043a \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u0456 \u043c\u0430\u0435 \u0431\u043e\u043b\u044c\u0448\u044b \u043f\u043b\u0451\u043d, \u043a\u0430\u043b\u0456 \u0441\u043f\u0430\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0437 \u0456\u043c \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c. \u041f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0441\u043f\u0440\u044b\u044f\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043a\u0456\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0441\u044f\u043c&rsquo;\u0451\u0439 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u0441\u043f\u0430\u043a\u043e\u0435\u043c, \u0448\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u0448\u0447\u044b\u0440\u0430\u0439 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043b\u044e\u0431\u043e\u045e \u0441\u0443\u0436\u044d\u043d\u0446\u0430\u045e, \u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0443\u043b\u0430\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u043f\u043e\u045e\u043d\u0430\u0439, \u0448\u0442\u043e \u045e\u0441\u0435 \u0456\u043d\u0448\u044b\u044f \u0437\u0430\u043d\u044f\u0442\u043a\u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u043c\u0456, \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u0432\u0430\u0431\u043d\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0430\u043c\u044b\u043b\u043a\u0430\u0439, \u0430 \u043d\u0430\u0432\u0430\u0442 \u0435\u0440\u0430\u0441\u0441\u044e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0437 \u0432\u0430\u0439\u0441\u043a\u043e\u0432\u044b\u0445 \u043a\u0430\u0437\u0430\u0440\u043c, \u0437 \u0440\u0430\u043c\u0435\u0441\u043d\u0456\u0446\u043a\u0456\u0445 \u043c\u0430\u0439\u0441\u0442\u044d\u0440\u043d\u044f\u045e, \u0437 \u043a\u043d\u044f\u0441\u043a\u0456\u0445 \u043f\u0430\u043b\u0430\u0446\u0430\u045e, \u0437 \u0436\u044b\u043b\u043b\u044f \u0441\u0443\u0436\u044d\u043d\u0446\u0430\u045e. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0434\u0430\u0440\u0430\u0433\u0430\u044f \u0424\u0456\u043b\u0430\u0442\u044d\u044f, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0447\u044b\u0441\u0442\u0430 \u043a\u0430\u043d\u0442\u044d\u043c\u043f\u043b\u044f\u0446\u044b\u0439\u043d\u0430\u0435, \u043c\u0430\u043d\u0430\u0441\u043a\u0430\u0435 \u0456 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u043d\u0430\u0435 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0440\u044d\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043d\u0430 \u043f\u0440\u044b \u0442\u0430\u043a\u0456\u0445 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u0445 \u0456 \u0437\u0430\u043d\u044f\u0442\u043a\u0430\u0445. \u0410\u0434\u043d\u0430\u043a \u0430\u043f\u0440\u043e\u0447 \u0433\u044d\u0442\u044b\u0445 \u0442\u0440\u043e\u0445 \u0432\u0456\u0434\u0430\u045e \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0456\u0441\u043d\u0443\u0435 \u0448\u043c\u0430\u0442 \u0456\u043d\u0448\u044b\u0445, \u044f\u043a\u0456\u044f \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u044f \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u0446\u044c \u0441\u0432\u0435\u0446\u043a\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435 \u0431 \u043c\u044b \u043d\u0456 \u0431\u044b\u043b\u0456, \u0443\u0441\u044e\u0434\u044b \u043c\u043e\u0436\u0430\u043c \u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 4, 32 &ndash; 5, 1; \u041c\u0446 11, 29\u0430b<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u0436 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e \u043b\u0430\u0433\u043e\u0434\u043d\u044b\u043c\u0456, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456, \u0434\u0430\u0440\u0443\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443, \u044f\u043a \u0456 \u0411\u043e\u0433 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0434\u0430\u0440\u0430\u0432\u0430\u045e \u0432\u0430\u043c. <span style=\"color: #ff0000;\">*<\/span> \u041d\u0430\u0441\u043b\u0435\u0434\u0443\u0439\u0446\u0435 \u0411\u043e\u0433\u0430 \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u044f\u0440\u043c\u043e \u041c\u0430\u0451 \u043d\u0430 \u0441\u044f\u0431\u0435 \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0435\u0441\u044f \u0430\u0434 \u041c\u044f\u043d\u0435, \u0431\u043e \u042f \u0446\u0456\u0445\u0456 \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u0441\u044d\u0440\u0446\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0441\u043b\u0435\u0434\u0443\u0439\u0446\u0435 \u0411\u043e\u0433\u0430 \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"627","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 2 de laudibus sancti Pauli: PG 50, 477-480)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u0432\u0435\u043b \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u045e \u0443\u0441\u0435 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u0456 \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0456\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0434\u0430 \u044f\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u0437 \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u0430\u0439\u043b\u0435\u043f\u0448 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430\u043c \u0441\u0432. \u041f\u0430\u0432\u0435\u043b.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0437 \u043a\u043e\u0436\u043d\u044b\u043c \u0434\u043d\u0451\u043c \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b, \u0437 \u043a\u043e\u0436\u043d\u044b\u043c \u0434\u043d\u0451\u043c \u0431\u043e\u043b\u044c\u0448 \u0440\u0443\u043f\u043b\u0456\u0432\u044b. \u0423\u0441\u0446\u044f\u0436 \u0437 \u043d\u043e\u0432\u044b\u043c \u0437\u0430\u043f\u0430\u043b\u0430\u043c \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0437 \u043f\u0430\u0433\u0440\u043e\u0437\u0430\u043c\u0456 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a. \u0412\u044b\u0440\u0430\u0437\u043d\u0430 \u0441\u0430\u043c \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430: &laquo;\u0417\u0430\u0431\u044b\u0432\u0430\u044e \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430 \u043c\u043d\u043e\u044e, \u0456 \u0441\u044f\u0433\u0430\u044e \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043d\u0430\u043f\u0435\u0440\u0430\u0434\u0437\u0435&raquo; (\u0424\u043b\u043f 3, 13).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0447\u0430\u043a\u0430\u045e \u0431\u043b\u0456\u0437\u043a\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0431\u0440\u0430\u0442\u043e\u045e \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c: &laquo;\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0432\u044b \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0456 \u0446\u0435\u0448\u0446\u0435\u0441\u044f \u0441\u0430 \u043c\u043d\u043e\u044e&raquo; (\u0424\u043b\u043f 2, 18). \u0421\u0442\u0430\u044e\u0447\u044b \u043f\u0435\u0440\u0430\u0434 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430\u043c\u0456, \u0437\u043d\u044f\u0432\u0430\u0433\u0430\u043c\u0456 \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u043c\u0456 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u044f\u043c\u0456, \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0456\u043c \u0456 \u043f\u0456\u0448\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u043c: &laquo;\u0423\u043f\u0430\u0434\u0430\u0431\u0430\u045e \u044f \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c, \u043f\u0430\u0433\u0430\u0440\u0434\u0443, \u043d\u044f\u0441\u0442\u0430\u0447\u044b, \u0433\u0430\u043d\u0435\u043d\u043d\u0456&raquo; (2 \u041a\u0430\u0440 12, 10). \u041d\u0430\u0437\u044b\u0432\u0430\u0435 \u0456\u0445 \u0437\u0431\u0440\u043e\u044f\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435, \u0448\u0442\u043e \u0430\u0434\u0441\u044e\u043b\u044c \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u044f\u0433\u043e \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u044b\u044f \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043b\u044f \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0451\u043d \u043d\u0435\u0434\u0430\u0441\u044f\u0433\u0430\u043b\u044c\u043d\u044b. \u0417 \u0443\u0441\u0456\u0445 \u0456\u0445\u043d\u0456\u0445 \u043f\u0430\u0441\u0442\u0430\u043a \u0451\u043d \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430\u043c. \u0410\u0434\u0443\u0441\u044e\u043b\u044c \u0437 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a \u0431\u0435\u0434\u0441\u0442\u0432\u0430\u045e, \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0437\u043b\u0430\u0441\u043b\u043e\u045e\u044f \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u044f\u043a \u0431\u044b \u0442\u0440\u044b\u0443\u043c\u0444 \u0456 \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0440\u0430\u0437 \u0437\u0430 \u0440\u0430\u0437\u0430\u043c \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0437\u043d\u0430\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456. \u0401\u043d \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u043c\u0443 \u0456 \u0434\u0437\u044f\u043a\u0443\u0435 \u0411\u043e\u0433\u0443: &laquo;\u0414\u0437\u044f\u043a\u0443\u0435\u043c \u0411\u043e\u0433\u0443, \u0448\u0442\u043e \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u0430\u0435 \u043d\u0430\u043c \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443&raquo; (2 \u041a\u0430\u0440 2, 14).<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430\u0433\u043d\u0443\u045e \u043f\u0430\u0433\u0430\u0440\u0434\u044b \u0456 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u044f\u045e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u0447\u044b\u043c \u043c\u044b \u043f\u0430\u0445\u0432\u0430\u043b\u044b. \u0421\u043c\u0435\u0440\u0446\u0456 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043c\u044b \u0436\u044b\u0446\u0446\u044f; \u0431\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043c\u044b \u0431\u0430\u0433\u0430\u0446\u0446\u044f, \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430\u0446\u044b, \u0447\u044b\u043c \u0445\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443. \u0410\u0434\u043d\u0430\u0433\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u045e, \u0430\u0434\u043d\u0430\u0433\u043e \u0431\u0430\u044f\u045e\u0441\u044f &minus; \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u044c \u0411\u043e\u0433\u0430. \u041f\u0430-\u0437\u0430 \u0433\u044d\u0442\u044b\u043c \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448. \u0422\u0430\u043c\u0443 \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u045e, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043a\u0430\u0431 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u0411\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0435\u0448\u044b\u045e\u0441\u044f \u043b\u044e\u0431\u043e\u045e\u044e \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0434\u0430\u0440\u0430\u043c. \u041c\u0430\u044e\u0447\u044b \u044f\u0435, \u043b\u0456\u0447\u044b\u045e \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u044b\u043c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c \u0437 \u043b\u044e\u0434\u0437\u0435\u0439. \u0411\u0435\u0437 \u044f\u0435 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0431\u044b\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u045e \u0456 \u043a\u043d\u044f\u0437\u0451\u045e. \u0420\u0430\u0437\u0430\u043c \u0437 \u0451\u0439 \u0436\u0430\u0434\u0430\u045e \u0431\u043e\u043b\u044c\u0448 \u0431\u044b\u0446\u044c \u0430\u043f\u043e\u0448\u043d\u0456\u043c, \u0430 \u043d\u0430\u0432\u0430\u0442 \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b\u043c, \u0447\u044b\u043c \u0431\u0435\u0437 \u044f\u0435 \u0441\u044f\u0440\u043e\u0434 \u0431\u0430\u0433\u0430\u0446\u0435\u044f\u045e \u0456 \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u044b\u043b\u043e \u0434\u043b\u044f \u044f\u0433\u043e \u043f\u0430\u043a\u0443\u0442\u0430\u044e &minus; \u0437\u0433\u0443\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u043b\u044e\u0431\u043e\u045e. \u0413\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0434\u043b\u044f \u044f\u0433\u043e \u0433\u0456\u0435\u043d\u0430\u0439, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435\u043c, \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u044b\u043c \u0456 \u043d\u044f\u0437\u043d\u043e\u0441\u043d\u044b\u043c \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435\u043c. \u041d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u043c\u0435\u0446\u044c \u044f\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u043b\u0430 \u0436\u044b\u0446\u0446\u0451, \u0443\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442, \u0448\u0447\u0430\u0441\u0446\u0435 \u0430\u043d\u0451\u043b\u0430\u045e, \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u0456\u044f \u0456 \u0431\u0443\u0434\u0443\u0447\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b, \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456 \u0456 \u045e\u0432\u043e\u0433\u0443\u043b\u0435 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0435 \u0434\u0430\u0431\u0440\u043e. \u0423\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u043d\u0435 \u043c\u0435\u043b\u0430 \u0441\u0443\u0432\u044f\u0437\u0456 \u0437 \u043b\u044e\u0431\u043e\u045e\u044e \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0435 \u043b\u0456\u0447\u044b\u045e \u043d\u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u043c, \u043d\u0456 \u043f\u0440\u044b\u043a\u0440\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0456\u043c, \u0448\u0442\u043e \u0437\u044f\u043c\u043d\u043e\u0435, \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u045e \u044f\u043a \u0433\u043d\u0456\u043b\u043e\u0439 \u0442\u0440\u0430\u0432\u043e\u0439. \u041d\u0430\u0432\u0430\u0442 \u0442\u044b\u0440\u0430\u043d\u044b \u0456 \u0440\u0430\u0437&rsquo;\u044e\u0448\u0430\u043d\u044b \u043d\u0430\u0442\u043e\u045e\u043f &minus; \u0433\u044d\u0442\u0430 \u045e \u044f\u0433\u043e \u0432\u0430\u0447\u0430\u0445 \u043d\u0430\u0434\u0430\u0435\u0434\u043b\u0456\u0432\u044b\u044f \u0430\u0432\u0430\u0434\u043d\u0456. \u0414\u0437\u0456\u0446\u044f\u0447\u0430\u0439 \u0437\u0430\u0431\u0430\u0432\u0430\u0439 \u043b\u0456\u0447\u044b\u045e \u0441\u043c\u0435\u0440\u0446\u044c, \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0456 \u0456 \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0433 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u0426\u0456\u043c 1, 13b-14; 1 \u041a\u0430\u0440 15, 9b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0431\u044b\u045e \u043f\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430 \u045e \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0456 \u0456 \u0431\u044f\u0437\u0432\u0435\u0440&rsquo;\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u043b\u0430\u0441\u043a\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0448\u0447\u043e\u0434\u0440\u0430 \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u043c\u044f\u043d\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0435\u0440\u0430\u044e \u0456 \u043b\u044e\u0431\u043e\u045e\u044e, \u044f\u043a\u0430\u044f \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u043d\u0435 \u0432\u0430\u0440\u0442\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u0446\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b \u0411\u043e\u0436\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043b\u0430\u0441\u043a\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0448\u0447\u043e\u0434\u0440\u0430 \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u043c\u044f\u043d\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0435\u0440\u0430\u044e \u0456 \u043b\u044e\u0431\u043e\u045e\u044e, \u044f\u043a\u0430\u044f \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"628","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 2 de laudibus sancti Pauli: PG 50, 480-484)<\/span><br \/><span style=\"color: #ff0000;\">\u0417\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u0434\u043e\u0431\u0440\u044b\u043c \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435\u043c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u0431\u044b\u045e \u0443 \u0432\u044f\u0437\u043d\u0456\u0446\u044b, \u041f\u0430\u0432\u0435\u043b \u0430\u0434\u0447\u0443\u0432\u0430\u045e \u0441\u044f\u0431\u0435 \u044f\u043a \u0443 \u043d\u0435\u0431\u0435. \u0423\u0434\u0430\u0440\u044b \u0456 \u0440\u0430\u043d\u044b \u043f\u0440\u044b\u043c\u0430\u045e \u0430\u0445\u0432\u043e\u0442\u043d\u0435\u0439, \u0447\u044b\u043c \u0456\u043d\u0448\u044b\u044f \u0430\u0434\u0437\u043d\u0430\u043a\u0456. \u0426\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0446\u0430\u043d\u0456\u045e \u043d\u0435 \u043c\u0435\u043d\u0448 \u0437\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b, \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u043b\u0456\u0447\u044b\u045e \u0456\u0445 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430\u0439 \u0456 \u0442\u0430\u043c\u0443 \u043d\u0430\u0437\u044b\u0432\u0430\u045e \u0456\u0445 \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0439. \u0423\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u043c, \u0443 \u0447\u044b\u043c \u0441\u044d\u043d\u0441 \u0433\u044d\u0442\u0430\u0433\u0430. \u041d\u0430\u043f\u044d\u045e\u043d\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430\u0439 \u0431\u044b\u043b\u043e &laquo;\u0431\u044b\u0446\u044c \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u043d\u044b\u043c \u0456 \u0431\u044b\u0446\u044c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c&raquo; (\u043f\u0430\u0440. \u0424\u043b\u043f 1, 23), \u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u0446\u0435\u043b\u0435 &minus; \u0433\u044d\u0442\u0430 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0430. \u0410\u0434\u043d\u0430\u043a \u0434\u0437\u0435\u043b\u044f \u043b\u044e\u0431\u043e\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0434\u043a\u0456\u0434\u0432\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430. \u0413\u044d\u0442\u0430 \u043b\u0456\u0447\u044b\u0446\u044c \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u044b\u0446\u044c \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u043b\u0430 \u0434\u043b\u044f \u044f\u0433\u043e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0443 \u0456 \u043f\u0440\u0430\u0446\u0443, \u0430 \u043d\u0430\u0432\u0430\u0442 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0443 \u0456 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0443\u044e \u043f\u0440\u0430\u0446\u0443. \u0411\u044b\u0446\u044c \u0436\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c &minus; \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430. \u0410\u0434\u043d\u0430\u043a \u041f\u0430\u0432\u0435\u043b \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0432\u044b\u0431\u0440\u0430\u0446\u044c \u043f\u0435\u0440\u0448\u0430\u0435, \u0430 \u043d\u0435 \u0434\u0440\u0443\u0433\u043e\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e\u0441\u044c\u0446\u0456 \u043c\u043e\u0433 \u0431\u044b \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0434\u043b\u044f \u044f\u0433\u043e \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u043c \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u043b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430. \u0406 \u044f \u0442\u0430\u043a \u0434\u0443\u043c\u0430\u044e. \u0411\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u043b\u044f \u043d\u0430\u0441 \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u0441\u0443\u043c\u0443, \u0434\u043b\u044f \u044f\u0433\u043e \u0431\u044b\u043b\u043e \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456. \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0436 \u043f\u0435\u0440\u0430\u043b\u0456\u0447\u0432\u0430\u0446\u044c \u043f\u0430\u0430\u0441\u043e\u0431\u043d\u044b\u044f \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0456 \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456! \u0401\u043d \u0436\u0430 \u0436\u044b\u045e \u0441\u044f\u0440\u043e\u0434 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u0433\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0437\u043d\u0435\u043c\u0430\u0433\u0430\u0435, \u0446\u0456 \u044f \u043d\u0435 \u0437\u043d\u0435\u043c\u0430\u0433\u0430\u044e? \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0437\u0430\u0437\u043d\u0430\u0435 \u0437\u0433\u0430\u0440\u0448\u044d\u043d\u043d\u0435, \u0446\u0456 \u044f \u043d\u0435 \u043f\u0430\u043a\u0443\u0442\u0443\u044e?&raquo; (2 \u041a\u0430\u0440 11, 29).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u043a\u0430\u0431 \u0432\u044b \u0442\u0430\u043a\u0456\u043c \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u043b\u0456\u0441\u044f, \u0430\u043b\u0435 \u0456 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043b\u0456. \u0422\u0430\u043a \u043c\u044b \u0437\u043c\u043e\u0436\u0430\u043c \u043c\u0435\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u044f\u0433\u043e\u043d\u0430\u0439 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0435. \u0410 \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u045e\u0441\u044f \u0431, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0442\u0430\u043a\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443, \u043d\u0456\u0431\u044b \u043c\u0435\u045e \u0437\u0430\u0441\u043b\u0443\u0433\u0456 \u041f\u0430\u045e\u043b\u0430, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435 \u044f\u0433\u043e \u0441\u043b\u043e\u0432\u044b: &laquo;\u0423 \u0434\u043e\u0431\u0440\u0430\u0439 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435 \u044f \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f, \u0431\u0435\u0433 \u0441\u043a\u043e\u043d\u0447\u044b\u045e, \u0432\u0435\u0440\u0443 \u0437\u0430\u0445\u0430\u0432\u0430\u045e. \u041d\u0430\u0440\u044d\u0448\u0446\u0435 \u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043a\u0456 \u0434\u0430\u0441\u0446\u044c \u043c\u043d\u0435 \u041f\u0430\u043d, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0421\u0443\u0434\u0434\u0437\u044f, \u0443 \u0434\u0437\u0435\u043d\u044c \u0442\u043e\u0439. \u0406 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u043d\u0435, \u0430\u043b\u0435 \u045e\u0441\u0456\u043c, \u0445\u0442\u043e \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u042f\u0433\u043e \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435&raquo; (2 \u0426\u0456\u043c 4, 7-8). \u0411\u0430\u0447\u044b\u0448, \u0448\u0442\u043e \u0451\u043d \u0443\u0441\u0456\u0445 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u0434\u0430 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u0442\u043e\u0439 \u0441\u0430\u043c\u0430\u0439 \u0445\u0432\u0430\u043b\u0435. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u043c \u0443\u0441\u0456\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u0430 \u0442\u0430\u044f \u0441\u0430\u043c\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430, \u043f\u0430\u0441\u0442\u0430\u0440\u0430\u0435\u043c\u0441\u044f \u0433\u043e\u0434\u043d\u0430 \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0446\u044c \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u0431\u0430\u0447\u044b\u0446\u044c \u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u043b\u0456\u0447 \u0456 \u045e\u0437\u043d\u0451\u0441\u043b\u0430\u0441\u0446\u044c \u0446\u043d\u043e\u0442\u0430\u045e, \u0433\u0430\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044c \u0456 \u043c\u043e\u0446 \u0434\u0443\u0445\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u0456\u043c \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u045e \u043d\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0435 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u0430\u043b\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u0430\u0431 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u043f\u0440\u0430\u0437 \u044f\u043a\u0443\u044e \u0451\u043d \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0456\u043c \u0441\u0430\u043c\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u044f\u043a \u0456 \u043c\u044b. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u0435\u043b\u044c\u043c\u0456 \u0446\u044f\u0436\u043a\u043e\u0435, \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u043b\u0451\u0433\u043a\u0456\u043c \u0456 \u043d\u0435\u0441\u043a\u043b\u0430\u0434\u0430\u043d\u044b\u043c, \u0430 \u043f\u0440\u0430\u0446\u0443\u044e\u0447\u044b \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441, \u043d\u0430\u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u044b \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b \u0432\u044f\u043d\u0435\u0446 \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u043e\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0445\u0432\u0430\u043b\u0430 \u0456 \u043c\u043e\u0446 \u0446\u044f\u043f\u0435\u0440 \u0456 \u043d\u0430\u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u0426\u0456\u043c 6, 11-12\u0430; \u0426\u0456\u0442 2, 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b, \u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0411\u043e\u0436\u044b, \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0439 \u043f\u0430\u043c\u044b\u043b\u0430\u043a, \u0456\u043c\u043a\u043d\u0456\u0441\u044f \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0432\u0435\u0440\u044b, \u043b\u044e\u0431\u043e\u0432\u0456, \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0417\u043c\u0430\u0433\u0430\u0439\u0441\u044f \u0434\u043e\u0431\u0440\u044b\u043c \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435\u043c \u0432\u0435\u0440\u044b, \u0442\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u0436\u044b \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u0437\u0434\u0430\u0440\u043e\u0432\u0430\u043c\u0443 \u0432\u0443\u0447\u044d\u043d\u043d\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u043c\u0430\u0433\u0430\u0439\u0441\u044f \u0434\u043e\u0431\u0440\u044b\u043c \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435\u043c \u0432\u0435\u0440\u044b, \u0442\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"629","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0414\u0443\u0445\u043e\u045e\u043d\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442&raquo; \u0441\u0432. \u0410\u043d\u0436\u044d\u043b\u044b \u041c\u044d\u0440\u044b\u0447\u044b, \u043f\u0430\u043d\u043d\u044b<\/p>\r\n<p style=\"text-align: center;\"><em><span style=\"color: #ff0000;\">\u0423\u0441\u0456\u043c \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u043b\u0430 \u0437 \u0434\u0430\u0431\u0440\u044b\u043d\u0451\u0439<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u043c\u0430\u0446\u0456 \u0456 \u0441\u0451\u0441\u0442\u0440\u044b \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435, \u0441\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0437 \u0411\u043e\u0436\u0430\u044e \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u043d\u044f, \u0448\u0442\u043e \u0430\u0434\u0437\u0456\u043d\u0430\u0439 \u043c\u044d\u0442\u0430\u044e \u0432\u0430\u0448\u044b\u0445 \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u045e \u0456 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0434\u0443\u0448, \u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0442\u0440\u044b\u043c\u0430\u0439\u0446\u0435\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u044f \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0447\u0430\u044f \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0433\u0440\u0443\u043d\u0442\u0443\u0435\u0446\u0446\u0430 \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0432\u044b\u0440\u0430\u0441\u0442\u0430\u0435 \u0437 \u044f\u0435, \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0437\u0431\u0430\u045e\u0447\u044b\u044f \u0456 \u0434\u043e\u0431\u0440\u044b\u044f \u043f\u043b\u0430\u0434\u044b. \u0411\u043e \u0417\u0431\u0430\u045e\u0446\u0430 \u043d\u0430\u0448 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0435 \u043c\u043e\u0436\u0430 \u0434\u043e\u0431\u0440\u0430\u0435 \u0434\u0440\u044d\u0432\u0430 \u0440\u0430\u0434\u0437\u0456\u0446\u044c \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u043f\u043b\u0430\u0434\u044b&raquo; (\u041c\u0446 7, 18).<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0434\u043e\u0431\u0440\u0430\u0435 \u0434\u0440\u044d\u0432\u0430, &ndash; \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434\u043e\u0431\u0440\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0434\u0443\u0445, \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b \u043b\u044e\u0431\u043e\u045e\u044e, &ndash; \u043c\u043e\u0436\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043e\u0431\u0440\u044b\u044f \u0456 \u0441\u0432\u044f\u0442\u044b\u044f \u0447\u044b\u043d\u044b. \u0422\u0430\u043c\u0443 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d \u043a\u0430\u0437\u0430\u045e: &laquo;\u041b\u044e\u0431\u0456 \u0456 \u0440\u0430\u0431\u0456, \u0448\u0442\u043e \u0445\u043e\u0447\u0430\u0448&raquo;, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c: \u043c\u0430\u0439 \u043b\u044e\u0431\u043e\u045e \u0456 \u0434\u0430\u0431\u0440\u044b\u043d\u044e, \u0456 \u043c\u043e\u0436\u0430\u0448 \u0440\u0430\u0431\u0456\u0446\u044c, \u0448\u0442\u043e \u0445\u043e\u0447\u0430\u0448. \u0413\u044d\u0442\u044b\u043c \u043d\u0456\u0431\u044b \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u043a\u0430\u0437\u0430\u045e: &laquo;\u041b\u044e\u0431\u043e\u045e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0433\u0440\u0430\u0448\u044b\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0435\u0441\u044f \u043f\u0440\u0430 \u043a\u043e\u0436\u043d\u0443\u044e \u0432\u0430\u0448\u0443\u044e \u0434\u0430\u0447\u043a\u0443 \u0456 \u043c\u0430\u0439\u0446\u0435 \u0456\u0445 \u0431\u044b\u0446\u0446\u0430\u043c \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u0445 \u0443 \u0441\u044d\u0440\u0446\u044b. \u041d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430 \u0456\u043c\u0435\u043d\u0456, \u0430\u043b\u0435 \u045e \u0456\u0445 \u0430\u0431\u0441\u0442\u0430\u0432\u0456\u043d\u0430\u0445 \u0456 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044f\u0445. \u0413\u044d\u0442\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u0446\u044f\u0436\u043a\u0456\u043c, \u043a\u0430\u043b\u0456 \u0430\u0442\u0443\u043b\u0456\u0446\u0435 \u0456\u0445 \u0436\u044b\u0432\u043e\u0439 \u043b\u044e\u0431\u043e\u045e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u043e\u0434\u043d\u044b\u044f \u043c\u0430\u0446\u0456 \u043b\u044e\u0431\u044f\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u0435 \u0441\u0432\u0430\u0451 \u0434\u0437\u0456\u0446\u044f, \u043d\u0456 \u043f\u0440\u0430 \u043a\u043e\u0433\u0430 \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u044e\u0446\u044c, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u043c\u0430\u044e\u0446\u044c \u0456\u0445 \u0448\u043c\u0430\u0442. \u041f\u0440\u044b\u0447\u044b\u043d\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u045e \u043b\u044e\u0431\u043e\u0432\u0456. \u0417\u0434\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u0432\u0430\u0442, \u0448\u0442\u043e \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043c\u0430\u044e\u0446\u044c \u0434\u0437\u044f\u0446\u0435\u0439, \u0442\u044b\u043c \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u0439 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0456\u0445\u043d\u044f\u044f \u043b\u044e\u0431\u043e\u045e \u0456 \u043a\u043b\u043e\u043f\u0430\u0442 \u043a\u0430\u043d\u043a\u0440\u044d\u0442\u043d\u0430 \u043f\u0440\u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0431\u043e\u043b\u044c\u0448 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u043c\u0430\u0446\u0456 \u043c\u043e\u0433\u0443\u0446\u044c \u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a, \u0431\u043e \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u044f \u0437\u0430 \u043f\u043e\u0432\u044f\u0437\u0456 \u043a\u0440\u044b\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0440\u0430\u0433\u0456\u044f \u043c\u0430\u0446\u0456, \u043a\u0430\u043b\u0456 \u0432\u044b \u043b\u044e\u0431\u0456\u0446\u0435 \u0432\u0430\u0448\u044b\u0445 \u0434\u0430\u0447\u043e\u043a \u0436\u044b\u0432\u043e\u0439 \u0456 \u0448\u0447\u044b\u0440\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e, \u0442\u043e \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u043c\u0435\u043b\u0456 \u0456\u0445 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445 \u0456 \u043f\u0430\u043c\u044f\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u0441\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u0430\u0445\u0430\u043f\u0456\u0446\u044c \u0456\u0445 \u043b\u044e\u0431\u043e\u045e\u044e, \u0441\u0446\u0456\u043f\u043b\u0430\u0441\u0446\u044e \u0456 \u0434\u0430\u0431\u0440\u044b\u043d\u0451\u0439. \u041d\u0435 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u044b\u043c\u0456 \u0430\u0431\u043e \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c\u0456. \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0434\u043b\u044f \u045e\u0441\u0456\u0445, \u044f\u043a \u0456 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c, \u043b\u0430\u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430: &laquo;\u041d\u0430\u0432\u0443\u0447\u044b\u0446\u0435\u0441\u044f \u0430\u0434 \u041c\u044f\u043d\u0435, \u0431\u043e \u042f \u0446\u0456\u0445\u0456 \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u0441\u044d\u0440\u0446\u0430\u043c&raquo; (\u041c\u0446 11, 29). \u0422\u0430\u043a \u0432\u044b \u0441\u0442\u0430\u043d\u0435\u0446\u0435 \u043f\u0430\u0441\u043b\u044f\u0434\u043e\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u0411\u043e\u0433\u0430, \u043f\u0440\u0430 \u044f\u043a\u043e\u0433\u0430 \u0447\u044b\u0442\u0430\u0435\u043c: &laquo;\u0417 \u0434\u0430\u0431\u0440\u044b\u043d\u0451\u044e \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u045e\u0441\u0456\u043c&raquo; (\u041c\u0434\u0440 8, 1). \u0406 \u0437\u043d\u043e\u045e \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u043a\u0430\u0436\u0430: &laquo;\u042f\u0440\u043c\u043e \u041c\u0430\u0451 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435, \u0456 \u0446\u044f\u0436\u0430\u0440 \u041c\u043e\u0439 \u043b\u0451\u0433\u043a\u0456&raquo; (\u041c\u0446 11, 30).<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u043a\u0430\u0437\u0432\u0430\u0439\u0446\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u0434\u0430\u0431\u0440\u044b\u043d\u044e \u045e\u0441\u0456\u043c \u0456 \u0441\u0446\u0435\u0440\u0430\u0436\u044b\u0446\u0435\u0441\u044f, \u043a\u0430\u0431 \u0432\u0430\u0448\u044b\u044f \u043d\u0430\u043a\u0430\u0437\u044b \u043d\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u0437 \u043f\u0440\u044b\u043c\u0443\u0441\u0443. \u0411\u043e\u0433 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0434\u0430\u045e \u0432\u043e\u043b\u044c\u043d\u0443\u044e \u0432\u043e\u043b\u044e \u0456 \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u0437\u043c\u0443\u0448\u0430\u0435, \u0430\u043b\u0435 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435, \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0435. \u0427\u0430\u0441\u0430\u043c \u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u043f\u0440\u0430\u044f\u0432\u0456\u0446\u044c \u043f\u044d\u045e\u043d\u0443\u044e \u0441\u0443\u0440\u043e\u0432\u0430\u0441\u0446\u044c, \u0430\u043b\u0435 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c, \u0437 \u0443\u0432\u0430\u0433\u0430\u0439 \u043d\u0430 \u0430\u043a\u0430\u043b\u0456\u0447\u043d\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u043a\u0430\u043d\u043a\u0440\u044d\u0442\u043d\u0430\u0439 \u0430\u0441\u043e\u0431\u044b. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0442\u0443\u0442 \u043d\u0430\u043c\u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u043b\u044e\u0431\u043e\u045e \u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0434\u0443\u0448.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 5, 8b-9; \u041c\u0446 5, 14\u0430. 16\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u0441\u0432\u044f\u0442\u043b\u043e \u045e \u041f\u0430\u043d\u0443: \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435, \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u0441\u0432\u044f\u0442\u043b\u0430. <span style=\"color: #ff0000;\">*<\/span> \u041f\u043b\u043e\u0434 \u0441\u0432\u044f\u0442\u043b\u0430 \u0451\u0441\u0446\u044c \u0432\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b &ndash; \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0442\u0443. \u041d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u043b\u043e \u0432\u0430\u0448\u0430 \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u043b\u043e\u0434 \u0441\u0432\u044f\u0442\u043b\u0430 \u0451\u0441\u0446\u044c \u0432\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"630","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0414\u0443\u0445\u043e\u045e\u043d\u044b \u0434\u0437\u0451\u043d\u043d\u0456\u043a&raquo; \u0431\u043b. \u042e\u0440\u044b\u044f \u041c\u0430\u0442\u0443\u043b\u0435\u0432\u0456\u0447\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(\u0427\u0430\u0441\u0442\u043a\u0430 \u0406: \u041f\u0435\u0446\u044f\u0440\u0431\u0443\u0440\u0433 1910-1911)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0414\u043b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c, \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0446\u044f\u0436\u0430\u0440\u044b \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044d\u0432\u0456\u0437\u0430\u043c \u043c\u0430\u0456\u043c \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u043e\u0432\u044b: \u0432\u0430 \u045e\u0441\u0456\u043c \u0448\u0443\u043a\u0430\u0446\u044c \u0411\u043e\u0433\u0430, \u0443\u0441\u0451 \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0445\u0432\u0430\u043b\u044b \u0411\u043e\u0436\u0430\u0439, \u0443\u0441\u0451 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0446\u044c \u0411\u043e\u0436\u044b\u043c \u0434\u0443\u0445\u0430\u043c. \u0411\u043e\u0433 \u0456 \u042f\u0433\u043e\u043d\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u043d\u044f\u0445\u0430\u0439 \u0441\u0442\u0430\u043d\u0435 \u0441\u0442\u0440\u044b\u0436\u043d\u0435\u043c \u0443\u0441\u044f\u0433\u043e \u043c\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f, \u0432\u043e\u0441\u0441\u044e, \u0432\u0430\u043a\u043e\u043b \u044f\u043a\u043e\u0439 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043a\u0440\u0443\u0436\u044b\u0446\u044c \u0443\u0441\u0435 \u043c\u0430\u0435 \u0434\u0443\u043c\u043a\u0456, \u043f\u0430\u0447\u0443\u0446\u0446\u0456, \u0436\u0430\u0434\u0430\u043d\u043d\u0456 i \u045e\u0447\u044b\u043d\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0430\u043b\u0443\u044e \u0440\u0443\u043a\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u041f\u0440\u043e\u0432\u0456\u0434\u0443 \u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0434\u0434\u0430\u044e\u0441\u044f \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435. \u0412\u044f\u0434\u0437\u0456 \u043c\u044f\u043d\u0435, \u041e\u0439\u0447\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b, \u0440\u0430\u0431\u0456 \u0441\u0430 \u043c\u043d\u043e\u044e \u0442\u043e\u0435, \u0448\u0442\u043e \u0422\u0430\u0431\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430. \u0426\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0448\u043b\u044f\u0445\u0430\u043c \u0422\u044b \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0432\u0435\u0441\u0446\u0456 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435, \u0430\u043b\u0435 \u0445\u0442\u043e \u0436 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0422\u0432\u0430\u0435 \u0434\u0430\u0440\u043e\u0433\u0456 \u0456 \u043d\u0430\u043c\u0435\u0440\u044b? \u0412\u043e\u0441\u044c \u044f, \u0441\u043b\u0443\u0433\u0430 \u0422\u0432\u043e\u0439, \u043f\u0430\u0448\u043b\u0456 \u043c\u044f\u043d\u0435, \u043a\u0443\u0434\u044b \u0445\u043e\u0447\u0430\u0448. \u041a\u0456\u0434\u0430\u044e\u0441\u044f, \u044f\u043a \u0434\u0437\u0456\u0446\u044f, \u0443 \u0422\u0432\u0430\u0435 \u0430\u0431\u0434\u044b\u043c\u043a\u0456, \u043d\u044f\u0441\u0456 \u043c\u044f\u043d\u0435! \u0422\u0430\u0431\u0435 \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0432\u0435\u0441\u0446\u0456 \u043c\u044f\u043d\u0435 \u0448\u043b\u044f\u0445\u0430\u043c \u043d\u044f\u0433\u043e\u0434\u0430\u045e, \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e. \u042f \u045e\u0434\u0437\u044f\u0447\u043d\u044b \u0422\u0430\u0431\u0435 \u0437\u0430 \u0433\u044d\u0442\u0430, \u0432\u0435\u043b\u044c\u043c\u0456 \u045e\u0434\u0437\u044f\u0447\u043d\u044b! \u0421\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0456\u0434\u0443\u0447\u044b \u0433\u044d\u0442\u044b\u043c \u0448\u043b\u044f\u0445\u0430\u043c, \u043d\u0435 \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u044e, \u0431\u043e \u0433\u044d\u0442\u0430 \u0448\u043b\u044f\u0445, \u044f\u043a\u0456\u043c \u0456\u0448\u043e\u045e \u043c\u043e\u0439 \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u044b \u0417\u0431\u0430\u045e\u0446\u0430, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u044f \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448 \u0432\u044b\u0440\u0430\u043a\u0430\u045e\u0441\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, a \u0426\u044f\u0431\u0435 \u043b\u044e\u0431\u0456\u045e \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448. \u0410\u0434\u0430\u0440\u044b \u043c\u044f\u043d\u0435 \u0430\u0434\u0432\u0430\u0433\u0430\u0439 \u0456 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044e, \u043a\u0430\u0431 \u0434\u0437\u0435\u043b\u044f \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u0456\u043c\u044f i \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0431\u0440\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u044f \u043d\u0435 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f \u043d\u0456\u044f\u043a\u0456\u0445 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u045e, \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u045e \u0456 \u043d\u0435 \u0430\u043f\u0443\u0441\u0446\u0456\u045e \u0440\u0443\u043a; \u043a\u0430\u0431 \u0456\u0448\u043e\u045e \u0430\u0434\u0432\u0430\u0436\u043d\u0430, \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0443\u0441\u044e\u0434\u044b, \u0434\u0437\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0436\u043d\u0430 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0434\u043b\u044f \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u0436 \u043c\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0456\u0441\u0446\u0456 \u0442\u0443\u0434\u044b, \u0434\u0437\u0435 \u043c\u043e\u0436\u043d\u0430 \u044f\u043a \u043c\u0430\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0434\u043b\u044f \u0411\u043e\u0433\u0430, \u0434\u0437\u0435 \u043c\u043e\u0436\u043d\u0430 \u044f\u043a \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0434\u0443\u0448, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0442\u0443\u0434\u044b, \u0434\u0437\u0435 \u0456\u0441\u043d\u0443\u0435 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0431\u044f\u0437\u0431\u043e\u0436\u0436\u0430, \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u044c, \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u0430\u0441\u0446\u044c \u0443 \u0432\u0435\u0440\u044b, \u0430\u0434\u044b\u0445\u043e\u0434 \u0430\u0434 \u041a\u0430\u0441\u0446\u0451\u043b\u0430? \u0426\u0456 \u0436 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043c\u044b \u043d\u0430\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u045e\u0441\u044e\u0434\u044b \u0442\u0440\u0430\u043f\u0456\u0446\u044c, \u043f\u0440\u0430\u0446\u0456\u0441\u043d\u0443\u0446\u0446\u0430, \u0434\u0437\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0436\u043d\u0430 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430? \u041a\u0430\u043b\u0456 \u0430\u0434\u043d\u044b\u044f \u0434\u0437\u0432\u0435\u0440\u044b \u0437\u0430\u043c\u043a\u043d\u0451\u043d\u044b\u044f, \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0431\u0456\u0432\u0430\u0446\u044c \u0441\u0430\u0431\u0435 \u0456\u043d\u0448\u044b\u044f, \u043a\u0430\u0431 \u043f\u0443\u0441\u0446\u0456\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u044b \u041a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u043c\u0430\u044f \u043b\u044e\u0431\u043e\u045e! \u041a\u0430\u043b\u0456 \u0431 \u044f \u0437\u0430\u0431\u044b\u045e \u043f\u0440\u0430 \u0446\u044f\u0431\u0435, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0431\u044b\u0442\u0430\u044f \u043c\u0430\u044f \u043f\u0440\u0430\u0432\u0456\u0446\u0430. \u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u043b\u0456\u043f\u043d\u0435 \u0434\u0430 \u043f\u0430\u0434\u043d\u044f\u0431\u0435\u043d\u043d\u044f \u044f\u0437\u044b\u043a \u043c\u043e\u0439, \u043a\u0430\u043b\u0456 \u044f \u043d\u0435 \u0431\u0443\u0434\u0443 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0446\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0443 \u043b\u0456\u0447\u044b\u0446\u044c \u0446\u044f\u0431\u0435 \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u0430\u0439 \u043c\u0430\u0451\u0439 \u041c\u0430\u0446\u0456, \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043c\u0430\u0451\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e. \u041d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u044b \u0437\u0430\u043a\u043b\u0456\u043a \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u044b\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043c \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430. \u041a\u0430\u043b\u0456 \u044f \u043c\u0430\u0433\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u044c, \u0442\u043e \u0434\u0430\u0439, \u041f\u0430\u043d\u0435, \u043a\u0430\u0431 \u0443 \u0422\u0432\u0430\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u044f \u0431\u044b\u045e \u0430\u043d\u0443\u0447\u0430\u0439, \u044f\u043a\u0430\u044f \u045e\u0441\u0451 \u0432\u044b\u0446\u0456\u0440\u0430\u0435 \u0456 \u044f\u043a\u0443\u044e \u043f\u0430\u0441\u043b\u044f \u0432\u044b\u043a\u0456\u0434\u0432\u0430\u044e\u0446\u044c \u043a\u0443\u0434\u044b\u0441\u044c\u0446\u0456 \u045e \u0441\u0430\u043c\u044b \u0446\u0451\u043c\u043d\u044b, \u0434\u0430\u043b\u0451\u043a\u0456 \u043a\u0443\u0442. \u041d\u044f\u0445\u0430\u0439 \u0456 \u043c\u044f\u043d\u0435 \u0442\u0430\u043a \u0432\u044b\u043d\u0456\u0448\u0447\u0430\u0446\u044c \u0456 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u044e\u0446\u044c, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0422\u0432\u0430\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u0430\u0434\u0437\u0456\u043d \u043a\u0443\u0442\u043e\u0447\u0430\u043a \u0431\u044b\u045e \u043b\u0435\u043f\u0448 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0422\u0432\u0430\u0456\u043c \u0434\u043e\u043c\u0435 \u0431\u044b\u043b\u043e \u0447\u044b\u0441\u0446\u0435\u0439 \u0456 \u0430\u0445\u0430\u0439\u043d\u0435\u0439. \u041d\u044f\u0445\u0430\u0439 \u043c\u044f\u043d\u0435 \u043f\u043e\u0442\u044b\u043c \u043a\u0456\u043d\u0443\u0446\u044c \u0434\u0437\u0435-\u043d\u0435\u0431\u0443\u0434\u0437\u044c, \u044f\u043a \u0433\u044d\u0442\u0443\u044e \u0431\u0440\u0443\u0434\u043d\u0443\u044e, \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0443\u044e \u0430\u043d\u0443\u0447\u0443. \u0423\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u044f \u0431\u044b\u045e \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043d\u044b, \u0437\u043d\u043e\u0448\u0430\u043d\u044b, \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u043b\u0430 \u0456 \u043f\u0430\u0448\u044b\u0440\u0430\u043b\u0430\u0441\u044f \u0422\u0432\u0430\u044f \u0445\u0432\u0430\u043b\u0430, \u043a\u0430\u0431 \u044f \u043f\u0440\u044b\u0447\u044b\u043d\u0456\u045e\u0441\u044f \u0434\u0430 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u044f \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0414\u0430\u0437\u0432\u043e\u043b\u044c \u043c\u043d\u0435, \u043a\u0430\u0431 \u044f \u043c\u043e\u0433 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0434\u043b\u044f \u0426\u044f\u0431\u0435 \u0456 \u0422\u0432\u0430\u0439\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0456 \u044f\u0433\u043e \u0431\u0430\u0447\u043d\u0430\u0439 \u0433\u0430\u043b\u0430\u0432\u044b &ndash; \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0439, \u0411\u043e\u0436\u0430, \u043a\u0430\u0431 \u043c\u044b \u0431\u044b\u043b\u0456 \u0437\u0430\u0445\u043e\u043f\u043b\u0435\u043d\u044b\u044f \u0433\u044d\u0442\u0430\u0439 \u0430\u0434\u0437\u0456\u043d\u0430\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0456\u0434\u044d\u044f\u0439: \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0434\u043b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u043d\u044f\u0433\u043e\u0434\u044b \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u0442\u0430\u043a \u0434\u0431\u0430\u0446\u044c \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043a\u0430\u0431 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u043a\u043b\u043e\u043f\u0430\u0442\u044b \u0456 \u0440\u0430\u043d\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0431\u044b\u043b\u0456 \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u043c\u0456, \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u043c\u0456 i \u0440\u0430\u043d\u0430\u043c\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430; \u043a\u0430\u0431 \u043c\u044b, \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u044b\u044f \u0433\u044d\u0442\u044b\u043c \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c, \u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u043c\u0435\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430 \u0442\u0443\u0442, \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0448\u0443\u043a\u0430\u043b\u0456, \u043d\u0435 \u0447\u0430\u043a\u0430\u043b\u0456 \u043d\u0456\u044f\u043a\u0430\u0439 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u043b\u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0411\u043e\u0433\u0443 \u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0443, \u0437\u043d\u0430\u0441\u0456\u0446\u0446\u0430 \u0431\u0435\u0437 \u0440\u044d\u0448\u0442\u044b \u045e \u043f\u0440\u0430\u0446\u044b, \u0443\u0446\u0456\u0441\u043a\u0443 i \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0434\u043b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u041a\u0430\u0431 \u043c\u044b \u043c\u0435\u043b\u0456 \u0442\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430 \u043d\u0456\u044f\u043a\u0456\u0445 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434 \u0437 \u0431\u043e\u043a\u0443 \u0441\u0432\u0435\u0442\u0443 i \u044f\u0433\u043e \u043c\u043e\u0446\u044b, \u043d\u0435 \u043f\u0430\u0434\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u043d\u0456\u044f\u043a\u0430\u0439 \u0431\u043e\u044f\u0437\u0456, \u0430\u043b\u0435 \u0430\u0434\u0432\u0430\u0436\u043d\u0430 \u0456\u0441\u0446\u0456 \u043d\u0430 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435 i \u043f\u0440\u0430\u0446\u0443 \u0434\u043b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0442\u0430\u043c, \u0434\u0437\u0435 \u0441\u0432\u0435\u0446\u043a\u0430\u044f \u045e\u043b\u0430\u0434\u0430 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u041a\u0430\u0441\u0446\u0451\u043b i \u043c\u0430\u043d\u0430\u0441\u043a\u0456\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u0434\u0437\u0435 \u0430\u0440\u0433\u0430\u043d\u0456\u0437\u0430\u0446\u044b\u0456 i \u043a\u0430\u0441\u0446\u0451\u043b\u044c\u043d\u044b\u044f \u0456\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0443\u0446\u0456\u0441\u043a. \u041a\u0430\u0431 \u043c\u044b \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043d\u0430\u0433\u043e: \u043f\u0430\u043c\u0435\u0440\u0446\u0456, \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u045e\u0448\u044b \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f, \u043d\u044f\u0433\u043e\u0434\u0430\u045e i \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u045e \u0434\u0437\u0435\u043b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0434\u0443\u0448, \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u0448\u044b\u0440\u044d\u043d\u043d\u044f \u0445\u0432\u0430\u043b\u044b \u0411\u043e\u0436\u0430\u0439. \u041a\u0430\u0431 \u043c\u044b \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u043c\u043a\u0456, \u0436\u0430\u0434\u0430\u043d\u043d\u0456 i \u043d\u0430\u043c\u0435\u0440\u044b \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0443\u0441\u044e\u0434\u044b \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u0443\u0441\u0451 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0446\u044c \u042f\u0433\u043e \u0434\u0443\u0445\u0430\u043c, \u0443\u0441\u044e\u0434\u044b \u045e\u0437\u0432\u044b\u0448\u0430\u0446\u044c \u0456\u043c\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u043a\u0443\u044e \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435, \u0437\u0430 \u045e\u0434\u0437\u0435\u043b\u0435\u043d\u0430\u0435 \u043c\u043d\u0435 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0451 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0411\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0433\u0430 \u0417\u0430\u0447\u0430\u0446\u0446\u044f \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u041f\u0430\u043d\u043d\u044b \u041c\u0430\u0440\u044b\u0456. \u042f\u043a \u0436\u0430 \u0441\u043e\u043b\u0430\u0434\u043a\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u0443\u043f\u0430\u045e\u0448\u044b \u0434\u0430 \u042f\u0435 \u043d\u043e\u0433 i \u043f\u0430\u0442\u0430\u043d\u0430\u0446\u044c \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435. \u0414\u0443\u0448\u0430 \u043d\u0456\u0431\u044b \u043c\u043b\u0435\u0435, \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u0430\u044f \u0441\u0430\u043c\u044b\u043c\u0456 \u0441\u0430\u043b\u043e\u0434\u043a\u0456\u043c\u0456 \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u043c\u0456, \u0446\u0435\u043b\u0430 \u0436 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0434\u0437\u0456\u045e\u043d\u0430\u0435, \u043d\u0435\u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430\u0435 i \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0435 \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0435. \u0410\u043c\u0430\u043b\u044c \u0442\u043e\u0435 \u0436 \u0441\u0430\u043c\u0430\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u044e, \u043a\u0430\u043b\u0456 \u0422\u0432\u043e\u0439 \u043a\u0440\u044b\u0436 \u0441\u0432\u044f\u0442\u044b \u043f\u0440\u044b\u0446\u0456\u0441\u043a\u0430\u044e \u0434\u0430 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0433\u0440\u0443\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 1, 18-19<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0413\u0430\u043b\u0430\u0432\u0430 \u0446\u0435\u043b\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0401\u043d &ndash; \u043f\u0430\u0447\u0430\u0442\u0430\u043a, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u0431 \u0432\u0430 \u045e\u0441\u0456\u043c \u0401\u043d \u043c\u0435\u045e \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u043e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0411\u043e\u0433\u0443, \u043a\u0430\u0431 \u0443 \u0406\u043c \u0436\u044b\u043b\u0430 \u045e\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0432\u0430 \u045e\u0441\u0456\u043c \u0401\u043d \u043c\u0435\u045e \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"631","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0420\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0456&raquo; \u0441\u0432. \u0422\u0430\u043c\u0430\u0448\u0430 \u0410\u043a\u0432\u0456\u043d\u0441\u043a\u0430\u0433\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Collatio 6 super Credo in Deum)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0440\u044b\u0436 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u0446\u043d\u043e\u0442\u0430\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0439 \u0431\u044b\u043b\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u041c\u0443\u043a\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430? \u0411\u0435\u0437\u0443\u043c\u043e\u045e\u043d\u0430 \u0456 \u0434\u0432\u043e\u0439\u0447\u044b \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u044f: \u044f\u043a \u043b\u0435\u043a \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u0440\u0430\u0445\u0443 \u0456 \u044f\u043a \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0443\u043a\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u043b\u0435\u043a\u0430\u043c, \u0431\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0451\u0439 \u043c\u044b \u043c\u0430\u0435\u043c \u0440\u0430\u0442\u0443\u043d\u0430\u043a \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430, \u044f\u043a\u043e\u043c\u0443 \u043f\u0430\u0434\u0434\u0430\u0435\u043c\u0441\u044f \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0430\u0448\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044f\u043b\u0456\u043a\u0430\u0439 \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u041c\u0443\u043a\u0456 \u044f\u043a \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0443. \u042f\u043d\u0430 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0432\u0435\u0441\u0446\u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0430\u0434\u043a\u0456\u043d\u0443\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u043a\u0456\u043d\u0443\u045e \u043d\u0430 \u043a\u0440\u044b\u0436\u044b, \u0456 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0434\u0430 \u0447\u0430\u0433\u043e \u0456\u043c\u043a\u043d\u0443\u045e\u0441\u044f \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u041a\u0440\u044b\u0436 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u043a\u043e\u0436\u043d\u0430\u0439 \u0431\u0435\u0437 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u044f \u0446\u043d\u043e\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0443\u043a\u0430\u0435\u0448 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0443 \u043b\u044e\u0431\u043e\u0432\u0456: &laquo;\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0437\u0430 \u0442\u0443\u044e, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0430\u0434\u0434\u0430\u0435 \u0437\u0430 \u0441\u044f\u0431\u0440\u043e\u045e \u0441\u0432\u0430\u0456\u0445&raquo; (\u042f\u043d 15, 13). \u0413\u044d\u0442\u0430 \u0437\u0440\u0430\u0431\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u0430\u0434\u0434\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451, \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0434\u043b\u044f \u043d\u0430\u0441 \u0437\u0430\u0446\u044f\u0436\u043a\u0456\u043c \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u044f\u043a\u0456\u044f-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456 \u0434\u0437\u0435\u043b\u044f \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0443\u043a\u0430\u0435\u0448 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456? \u041d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b. \u0426\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0437 \u0434\u0437\u0432\u044e\u0445 \u043f\u0440\u044b\u0447\u044b\u043d: \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0437\u043b\u043e \u0446\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u043b\u0456 \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0442\u0430\u043a\u043e\u0435 \u0437\u043b\u043e, \u044f\u043a\u043e\u0433\u0430 \u043c\u043e\u0433 \u0431\u044b \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0443\u0446\u044c, \u0430\u043b\u0435 \u043d\u0435 \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430 \u0440\u0430\u0431\u0456\u0446\u044c. \u041d\u0430 \u043a\u0440\u044b\u0436\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0434\u0430\u045e \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0456 \u0430\u0434\u043d\u0430\u0433\u043e, \u0456 \u0434\u0440\u0443\u0433\u043e\u0433\u0430. \u0411\u043e &laquo;\u043a\u0430\u043b\u0456 \u0446\u044f\u0440\u043f\u0435\u045e, \u043d\u0435 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u045e&raquo; (1 \u041f 2, 23), \u044f\u043a \u0430\u0432\u0435\u0447\u043a\u0430, \u044f\u043a\u0443\u044e \u0432\u044f\u0434\u0443\u0446\u044c \u043d\u0430 \u0437\u0430\u0440\u044d\u0437, \u0442\u0430\u043a \u0456 \u0401\u043d \u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u045e \u0432\u0443\u0441\u043d\u0430\u045e \u0441\u0432\u0430\u0456\u0445 (\u043f\u0430\u0440. \u0414\u0437 8, 32). \u0412\u044f\u043b\u0456\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b: &laquo;\u0411\u0443\u0434\u0437\u0435\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0431\u0435\u0433\u0447\u044b \u045e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u043c \u0434\u043b\u044f \u043d\u0430\u0441 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u043f\u0430\u0447\u044b\u043d\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0456 \u0437\u0430\u0432\u044f\u0440\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0432\u0435\u0440\u044b. \u0417\u0430\u043c\u0435\u0441\u0442 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c, \u0401\u043d, \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430 \u0433\u0430\u043d\u044c\u0431\u0443, \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u043a\u0440\u044b\u0436&raquo; (\u0413\u0431\u0440 12, 2).<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0443\u043a\u0430\u0435\u0448 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0443 \u043f\u0430\u043a\u043e\u0440\u044b? \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430. \u0411\u043e\u0433 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0431\u044b\u0446\u044c \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b\u043c \u041f\u043e\u043d\u0446\u0456\u0435\u043c \u041f\u0456\u043b\u0430\u0442\u0430\u043c \u0456 \u043f\u0430\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0443\u043a\u0430\u0435\u0448 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456? \u041d\u0430\u0441\u043b\u0435\u0434\u0443\u0439 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0442\u0430\u045e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0410\u0439\u0446\u0443 \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456: &laquo;\u041f\u0440\u0430\u0437 \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043c\u043d\u043e\u0433\u0456\u044f \u0441\u0442\u0430\u043b\u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u043c\u0456, \u0442\u0430\u043a \u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u043c\u043d\u043e\u0433\u0456\u044f \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c\u0456&raquo; (\u0420\u044b\u043c 5, 19).<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0443\u043a\u0430\u0435\u0448 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0443 \u043f\u0430\u0433\u0430\u0440\u0434\u044b \u0437\u044f\u043c\u043d\u044b\u043c? \u0406\u0434\u0437\u0456 \u0437\u0430 \u0442\u044b\u043c, &laquo;\u0443 \u044f\u043a\u0456\u043c \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u045e\u0441\u0435 \u0441\u043a\u0430\u0440\u0431\u044b \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f&raquo; (\u041a\u043b\u0441 2, 3), \u044f\u043a\u0456 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u0441\u0442\u0430\u045e \u043d\u0430\u0433\u0456\u043c, \u0432\u044b\u0441\u043c\u0435\u044f\u043d\u044b\u043c, \u043f\u0440\u0430\u0431\u0456\u0442\u044b\u043c, \u0443\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u043d\u044b \u0446\u0435\u0440\u043d\u0435\u043c \u0456 \u045e\u0440\u044d\u0448\u0446\u0435 \u043d\u0430\u043f\u043e\u0435\u043d\u044b \u0432\u043e\u0446\u0430\u0442\u0430\u043c \u0456 \u0436\u043e\u045e\u0446\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u0435 \u043f\u0440\u044b\u0432\u044f\u0437\u0432\u0430\u0439\u0441\u044f \u0434\u0430 \u0448\u0430\u0442\u0430\u045e \u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u044f, \u0431\u043e &laquo;\u043f\u0430\u0434\u0437\u044f\u043b\u0456\u043b\u0456 \u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u044e \u043c\u0430\u044e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443&raquo; (\u042f\u043d 19, 24), \u043d\u0456 \u0434\u0430 \u043f\u0430\u0445\u0432\u0430\u043b\u044c\u0431\u044b, \u0431\u043e \u0441\u0442\u0430\u045e \u043f\u0440\u0430\u0434\u043c\u0435\u0442\u0430\u043c \u043d\u0430\u0441\u043c\u0435\u0448\u0430\u043a \u0456 \u0431\u0456\u0447\u0430\u0432\u0430\u043d\u043d\u044f, \u043d\u0456 \u0434\u0430 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456, \u0431\u043e, \u0441\u043f\u043b\u0451\u045e\u0448\u044b \u0446\u044f\u0440\u043d\u043e\u0432\u044b \u0432\u044f\u043d\u043e\u043a, \u0443\u0441\u043a\u043b\u0430\u043b\u0456 \u043d\u0430 \u043c\u0430\u044e \u0433\u0430\u043b\u0430\u0432\u0443 (\u043f\u0430\u0440. \u041c\u043a 15, 17), \u043d\u0456 \u0434\u0430 \u0440\u0430\u0441\u043a\u043e\u0448\u044b, \u0431\u043e &laquo;\u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u045e, \u043f\u0430\u0456\u043b\u0456 \u043c\u044f\u043d\u0435 \u0432\u043e\u0446\u0430\u0442\u0430\u043c&raquo; (\u041f\u0441 69 [68], 22).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0434\u0440 7, 7-8; 9, 17<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043c\u0430\u043b\u0456\u045e\u0441\u044f &ndash; \u0456 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043c\u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435; \u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e &ndash; \u0456 \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u043c\u044f\u043d\u0435 \u0434\u0443\u0445 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456. <span style=\"color: #ff0000;\">*<\/span> \u042f \u0430\u0434\u0434\u0430\u045e \u0451\u0439 \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0443 \u043d\u0430\u0434 \u0441\u043a\u0456\u043f\u0435\u0442\u0440\u0430\u043c\u0456 \u0456 \u0442\u0440\u043e\u043d\u0430\u043c\u0456, \u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u044f \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u043d\u0456\u0447\u044b\u043c \u0443 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0456 \u0437 \u0451\u044e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0442\u043e \u0431 \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u0422\u0432\u043e\u0439 \u043d\u0430\u043c\u0435\u0440, \u043a\u0430\u043b\u0456 \u0431 \u0422\u044b \u043d\u0435 \u0434\u0430\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u043d\u0435 \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0437\u0432\u044b\u0448?<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0430\u0434\u0434\u0430\u045e \u0451\u0439 \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0443 \u043d\u0430\u0434 \u0441\u043a\u0456\u043f\u0435\u0442\u0440\u0430\u043c\u0456 \u0456 \u0442\u0440\u043e\u043d\u0430\u043c\u0456, \u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u044f \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u043d\u0456\u0447\u044b\u043c \u0443 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0456 \u0437 \u0451\u044e.<\/p>\r\n"}, {"GCH_CH_2_ID":"633","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u042f\u043d\u0430 \u0411\u043e\u0441\u043a\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epistolario, Torino 1959, 4, 201-203)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0417\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e \u0437 \u043b\u044e\u0431\u043e\u045e\u044e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u0430\u0433\u043d\u0435\u043c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430 \u0434\u043b\u044f \u043d\u0430\u0448\u044b\u0445 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u0446\u0430\u045e \u0456 \u0445\u043e\u0447\u0430\u043c \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u0456\u0445 \u0434\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u045e, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u045e \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0430\u0440\u0430\u0433\u0456\u043c \u043d\u0430\u0448\u044b\u043c \u0445\u043b\u043e\u043f\u0446\u0430\u043c \u043c\u044b \u0437\u0430\u043c\u044f\u043d\u044f\u0435\u043c \u0431\u0430\u0446\u044c\u043a\u043e\u045e. \u0414\u043b\u044f \u0456\u0445 \u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e \u0437 \u043b\u044e\u0431\u043e\u045e\u044e, \u0434\u043b\u044f \u0456\u0445 \u044f \u0432\u0443\u0447\u044b\u045e\u0441\u044f, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u045e \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0443\u044e \u043f\u0430\u0441\u043b\u0443\u0433\u0443, \u0434\u044b \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f, \u0430\u043b\u0435 \u0456 \u045e\u0441\u044f \u0421\u0430\u043b\u0435\u0437\u0456\u044f\u043d\u0441\u043a\u0430\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0440\u0430\u0437\u043e\u045e, \u0441\u044b\u043d\u044b \u043c\u0430\u0435, \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u045e\u0433\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0442\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0448\u0442\u043e \u043b\u044f\u0433\u0447\u044d\u0439 \u0433\u043d\u0435\u0432\u0430\u0446\u0446\u0430, \u0447\u044b\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0437\u043d\u043e\u0441\u0456\u0446\u044c, \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0446\u044c, \u0447\u044b\u043c \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0446\u044c, \u0430 \u043d\u0430\u0432\u0430\u0442 \u043b\u044f\u0433\u0447\u044d\u0439 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0430\u0448\u0430\u0439 \u043d\u0435\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u044b\u0445\u0456 \u043f\u0430\u043a\u0430\u0440\u0430\u0446\u044c \u0443\u043f\u0430\u0440\u0442\u0430\u0433\u0430, \u0447\u044b\u043c \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0446\u044c \u044f\u0433\u043e \u0437 \u0434\u0430\u0431\u0440\u044b\u043d\u0451\u0439 \u0456 \u043f\u0430-\u0441\u044f\u0431\u0440\u043e\u045e\u0441\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0440\u0430\u044e \u0432\u0430\u043c \u043b\u044e\u0431\u043e\u045e \u0441\u0432. \u041f\u0430\u045e\u043b\u0430, \u044f\u043a\u0443\u044e \u0451\u043d \u0441\u0432\u0435\u0434\u0447\u044b\u045e \u0434\u0430 \u043d\u0435\u0430\u0444\u0456\u0442\u0430\u045e. \u0427\u0430\u0441\u0442\u0430 \u044f\u043d\u0430 \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u043b\u0430 \u044f\u0433\u043e \u0434\u0430 \u0441\u043b\u0451\u0437 \u0456 \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u043a\u0430\u043b\u0456 \u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u044f\u043d\u044b \u0442\u0430\u043a\u0456\u044f \u043d\u044f\u043a\u0435\u043c\u043b\u0456\u0432\u044b\u044f \u0456 \u043d\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u043d\u0430 \u044f\u0433\u043e \u043b\u044e\u0431\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u043a\u0430\u0431 \u0432\u0430\u0441 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0446\u0456\u045e \u0443 \u0442\u044b\u043c, \u0448\u0442\u043e \u0432\u044b \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435\u0446\u0435 \u045e \u0433\u043d\u0435\u0432\u0435. \u041d\u044f\u043b\u0451\u0433\u043a\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0441\u043f\u0430\u043a\u043e\u0439 \u0443 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0456, \u0430\u043b\u0435 \u0436 \u0451\u043d \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435\u043c, \u043a\u0430\u0431 \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u045e\u043b\u0430\u0434\u0443 \u0446\u0456 \u0434\u0430\u0446\u044c \u0441\u0432\u0430\u0431\u043e\u0434\u0443 \u0433\u043d\u0435\u0432\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u0445, \u043d\u0430\u0434 \u043a\u0456\u043c \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u043c \u044f\u043a\u0443\u044e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0443\u043b\u0430\u0434\u0443, \u0431\u0443\u0434\u0437\u0435\u043c \u043b\u0456\u0447\u044b\u0446\u044c \u0441\u044b\u043d\u0430\u043c\u0456. \u0421\u0442\u0430\u043d\u0435\u043c \u0436\u0430 \u0456\u0445\u043d\u0456\u043c\u0456 \u0441\u043b\u0443\u0433\u0430\u043c\u0456, \u044f\u043a \u0415\u0437\u0443\u0441, \u044f\u043a\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0441\u043b\u0443\u0436\u044b\u0446\u044c, \u0430 \u043d\u0435 \u043a\u0430\u0431 \u042f\u043c\u0443 \u0441\u043b\u0443\u0436\u044b\u043b\u0456. \u041d\u044f\u0445\u0430\u0439 \u0441\u0430\u0440\u043e\u043c\u0456\u0446\u044c \u043d\u0430\u0441 \u0445\u043e\u0446\u044c \u0431\u044b \u043d\u0430\u0432\u0430\u0442 \u0432\u044b\u0433\u043b\u044f\u0434 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f. \u041d\u0456 \u043d\u0430\u0434 \u043a\u0456\u043c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c, \u0445\u0456\u0431\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043b\u0435\u043f\u0448 \u0441\u043b\u0443\u0436\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u045e \u0415\u0437\u0443\u0441 \u0437 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456: \u0446\u044f\u0440\u043f\u0435\u045e \u0456\u0445 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435, \u043d\u0435\u0434\u0430\u0445\u043e\u043f \u0432\u0435\u0434\u0430\u045e, \u0430 \u043d\u0430\u0432\u0430\u0442 \u043d\u0435\u0434\u0430\u0445\u043e\u043f \u0432\u0435\u0440\u044b. \u0421\u043f\u0430\u0433\u0430\u0434\u0443 \u0456 \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0443\u044e \u0434\u0430\u0431\u0440\u044b\u043d\u044e \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u045e \u0434\u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e, \u0442\u0430\u043a \u0448\u0442\u043e \u045e \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445 \u0433\u044d\u0442\u0430 \u0430\u0431\u0443\u0434\u0436\u0430\u043b\u0430 \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u0435, \u0443 \u0456\u043d\u0448\u044b\u0445 \u0437\u0433\u0430\u0440\u0448\u044d\u043d\u043d\u0435, \u0430 \u045e \u043c\u043d\u043e\u0433\u0456\u0445 \u043d\u0430\u0434\u0437\u0435\u044e \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0411\u043e\u0436\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u0422\u043e\u0435 \u0436 \u0401\u043d \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0456 \u043d\u0430\u043c, \u043a\u0430\u0431 \u043c\u044b \u0431\u044b\u043b\u0456 \u0446\u0456\u0445\u0456\u044f \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u044b &ndash; \u043d\u0430\u0448\u044b\u044f \u0434\u0437\u0435\u0446\u0456. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0432\u044b\u043f\u0440\u0430\u045e\u043b\u044f\u0435\u043c \u0456\u0445\u043d\u0456\u044f \u043f\u0430\u043c\u044b\u043b\u043a\u0456, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u0437\u0431\u044b\u0446\u0446\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443, \u0430\u043b\u044c\u0431\u043e \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0446\u044c \u0442\u0430\u043a, \u043d\u0456\u0431\u044b \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u043b\u0456\u043a\u0432\u0456\u0434\u0430\u0432\u0430\u043b\u0456 \u0456\u0445.<br \/>\u041d\u0456\u044f\u043a\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443, \u043d\u0456\u044f\u043a\u0430\u0439 \u043f\u0430\u0433\u0430\u0440\u0434\u044b, \u043d\u0456\u044f\u043a\u0430\u0439 \u043a\u0440\u044b\u045e\u0434\u044b. \u041d\u0430 \u0433\u044d\u0442\u044b \u0447\u0430\u0441 \u043c\u0430\u0439\u0446\u0435 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u044b &ndash; \u043d\u0430\u0434\u0437\u0435\u044e, \u044f\u043a \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0439\u0446\u0430\u043c, \u044f\u043a\u0456\u044f \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0432\u044b\u043f\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0433\u0430 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0446\u044f\u0436\u043a\u0456\u0445 \u0432\u044b\u043f\u0430\u0434\u043a\u0430\u0445 \u0442\u0440\u044d\u0431\u0430 \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u043a\u043e\u0440\u043d\u0430 \u0456 \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u0447\u044b\u043c \u0432\u044b\u043b\u0456\u0432\u0430\u0446\u044c \u043f\u0430\u0442\u043e\u043a \u0441\u043b\u043e\u045e, \u044f\u043a\u0456\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0431\u0440\u0430\u0436\u0430\u044e\u0446\u044c \u0441\u043b\u0443\u0445\u0430\u0447\u043e\u045e, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u043a 10, 13-14; \u041c\u0446 18, 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u0434\u0430 \u0415\u0437\u0443\u0441\u0430 \u0434\u0437\u044f\u0446\u0435\u0439, \u043a\u0430\u0431 \u0401\u043d \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0456\u0445. \u0410\u043b\u0435 \u0432\u0443\u0447\u043d\u0456 \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u043b\u0456 \u0456\u043c. \u0423\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u0433\u044d\u0442\u0430, \u0415\u0437\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: <span style=\"color: #ff0000;\">*<\/span> \u0414\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u0434\u0437\u0435\u0446\u044f\u043c \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u041c\u044f\u043d\u0435, \u043d\u0435 \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0439\u0446\u0435 \u0456\u043c, \u0431\u043e \u0442\u0430\u043a\u0456\u043c \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u0430\u0434\u043d\u043e \u0442\u0430\u043a\u043e\u0435 \u0434\u0437\u0456\u0446\u044f \u045e \u0456\u043c\u044f \u041c\u0430\u0451, \u0442\u043e\u0439 \u041c\u044f\u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u0434\u0437\u0435\u0446\u044f\u043c \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u041c\u044f\u043d\u0435, \u043d\u0435 \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0439\u0446\u0435 \u0456\u043c, \u0431\u043e \u0442\u0430\u043a\u0456\u043c \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"634","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0421\u0430\u0444\u043e\u043d\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Orat. 3, de Hypapante, 6. 7: PG 87, 3, 3291-3293)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u043c\u0435\u043c \u044f\u0441\u043d\u0430\u0435 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u043e\u0439\u0434\u0437\u0435\u043c \u0443\u0441\u0435 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0425\u0440\u044b\u0441\u0442\u0443. \u041f\u043e\u0439\u0434\u0437\u0435\u043c \u0437 \u0430\u0445\u0432\u043e\u0447\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u0441\u043b\u0430\u0432\u044f\u0447\u044b \u042f\u0433\u043e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0437\u0434\u0430\u0440\u044b\u0446\u0446\u0430, \u0448\u0442\u043e \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u0456, \u043d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u043d\u044f\u0441\u0435 \u0437\u0430\u043f\u0430\u043b\u0435\u043d\u0443\u044e \u0441\u0432\u0435\u0447\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043b\u044f\u0441\u043a \u043f\u0430\u043b\u0430\u044e\u0447\u044b\u0445 \u0441\u0432\u0435\u0447\u0430\u043a \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043d\u0430\u0439\u043f\u0435\u0440\u0448 \u0411\u043e\u0436\u0443\u044e \u0445\u0432\u0430\u043b\u0443 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u045e\u0441\u0451 \u044f\u0441\u043d\u0435\u0435 \u0437 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443, \u043a\u0430\u043b\u0456 \u0431\u043b\u044f\u0441\u043a \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430 \u0440\u0430\u0437\u0430\u0433\u043d\u0430\u045e \u0437\u043b\u0443\u044e \u0446\u0435\u043c\u0440\u0443. \u0410\u0437\u043d\u0430\u0447\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0441\u0430 \u0441\u0432\u0435\u0442\u043b\u0430\u0439 \u0434\u0443\u0448\u043e\u0439 \u0432\u044b\u0439\u0441\u0446\u0456 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0425\u0440\u044b\u0441\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0430, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u044f \u0414\u0437\u0435\u0432\u0430, \u043d\u0430\u0441\u0456\u043b\u0430 \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u0440\u0443\u043a\u0430\u0445 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0421\u0432\u044f\u0442\u043b\u043e, \u0456\u0434\u0443\u0447\u044b \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u045e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0446\u0435\u043d\u0456, \u0442\u0430\u043a \u0456 \u043c\u044b, \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u044f \u042f\u0433\u043e \u043f\u0440\u043e\u043c\u043d\u044f\u043c\u0456 \u0456 \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u045e \u0440\u0443\u043a\u0430\u0445 \u0431\u0430\u0447\u043d\u0430\u0435 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043f\u043e\u043b\u044b\u043c\u044f, \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u044f\u0448\u0430\u0446\u0446\u0430 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c \u0421\u0432\u044f\u0442\u043b\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u043b\u043e \u043f\u0440\u044b\u0439\u0448\u043b\u043e \u045e \u0441\u0432\u0435\u0442 (\u043f\u0430\u0440. \u042f\u043d 1, 9) \u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u043b\u0430 \u044f\u0433\u043e, \u0431\u043e \u0451\u043d \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u045e\u0441\u044f \u045e \u0437\u043c\u0440\u043e\u043a\u0443. &laquo;\u041d\u0430\u0432\u0435\u0434\u0430\u045e \u043d\u0430\u0441 \u0423\u0441\u0445\u043e\u0434 \u0437 \u0432\u044b\u0448\u044b\u043d\u0456&raquo; (\u041b\u043a 1, 78) \u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u045e \u0443 \u0446\u0435\u043c\u0440\u044b. \u0413\u044d\u0442\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u043d\u0430\u0441. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443 \u043c\u044b \u0456\u0434\u0437\u0435\u043c, \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u0437\u0430\u043f\u0430\u043b\u0435\u043d\u044b\u044f \u043f\u0430\u0445\u043e\u0434\u043d\u0456, \u0442\u0430\u043c\u0443 \u0431\u044f\u0436\u044b\u043c, \u043d\u0435\u0441\u0443\u0447\u044b \u0441\u0432\u044f\u0442\u043b\u043e. \u0413\u044d\u0442\u044b\u043c \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u043c, \u0448\u0442\u043e \u0437\u0430\u044f\u0441\u043d\u0435\u043b\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u0421\u0432\u044f\u0442\u043b\u043e. \u041f\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430 \u0431\u043b\u044f\u0441\u043a, \u044f\u043a\u0456 \u043c\u044b \u0441\u0430\u043c\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0434 \u042f\u0433\u043e. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0456\u0441\u0446\u0456 \u045e\u0441\u0435 \u0440\u0430\u0437\u0430\u043c, \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u044f\u0448\u0430\u0446\u0446\u0430 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0411\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0437&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0421\u0432\u044f\u0442\u043b\u043e, &laquo;\u044f\u043a\u043e\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0441\u0432\u0435\u0442&raquo; (\u042f\u043d 1, 9). \u041d\u0430\u043f\u043e\u045e\u043d\u0456\u043c\u0441\u044f \u0456\u043c, \u0431\u0440\u0430\u0442\u044b, \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0441\u0435 \u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u0437 \u043d\u0430\u0441 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0421\u0432\u044f\u0442\u043b\u0430. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e, \u0445\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u044f\u0433\u043e, \u043d\u0435 \u0442\u0440\u044b\u0432\u0430\u0435 \u0431\u043e\u043b\u044c\u0448 \u0443 \u0446\u0435\u043c\u0440\u044b. \u041f\u043e\u0439\u0434\u0437\u0435\u043c \u0443\u0441\u0435, \u0437\u0437\u044f\u044e\u0447\u044b, \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0443\u0441\u0435 \u0440\u0430\u0437\u0430\u043c \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u044f \u0456 \u043f\u0440\u044b\u043c\u0435\u043c \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0442\u0430\u0440\u0446\u0430\u043c \u0421\u0456\u043c\u044f\u043e\u043d\u0430\u043c \u044f\u0441\u043d\u0430\u0435 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0421\u0432\u044f\u0442\u043b\u043e. \u0420\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0456 \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0443, \u0410\u0439\u0446\u0443 \u0421\u0432\u044f\u0442\u043b\u0430, \u044f\u043a\u0456 \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0421\u0432\u044f\u0442\u043b\u043e, \u0440\u0430\u0441\u0441\u0435\u044f\u045e \u0446\u0435\u043c\u0440\u0443 \u0456 \u043d\u0430\u0441 \u0443\u0441\u0456\u0445 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0437\u0437\u044f\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0411\u043e\u0436\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0411\u043e\u0433 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u043d\u043e\u0432\u0430\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0434\u043b\u044f \u043d\u0430\u0441. \u041c\u044b \u045e\u0431\u0430\u0447\u044b\u043b\u0456, \u0456 \u0430\u0434\u0440\u0430\u0437\u0443 \u0431\u044b\u043b\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b\u044f \u0437 \u0434\u0430\u045e\u043d\u0435\u0439\u0448\u0430\u0433\u0430 \u0437\u043c\u0440\u043e\u043a\u0443 \u0433\u0440\u0430\u0445\u0443, \u0442\u0430\u043a \u044f\u043a \u0421\u0456\u043c\u044f\u043e\u043d \u0431\u044b\u045e \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b \u0437 \u043f\u0443\u0442\u0430\u045e \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u045e \u0432\u0435\u0440\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u043d\u0430\u0441 \u0437 \u0411\u044d\u0442\u043b\u0435\u0435\u043c\u0430, \u0437 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0441\u0442\u0430\u043b\u0456 \u0411\u043e\u0436\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0431\u043e \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c, \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u043c \u043d\u0430\u043c \u0430\u0434 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430. \u041d\u0430 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u043c\u044b \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c. \u0426\u044f\u043f\u0435\u0440, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0411\u043e\u0433\u0430, \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0433\u0430 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441, \u0456 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u042f\u0433\u043e \u045e \u0434\u0443\u0445\u0443 \u043d\u0430 \u0440\u0443\u043a\u0456, \u043c\u044b \u0441\u0442\u0430\u043b\u0456 \u043d\u043e\u0432\u044b\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u0435\u043c. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e\u0433\u0430\u0434\u043e\u0432\u0430\u0439 \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044e \u0431\u0443\u0434\u0437\u0435\u043c \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u043c\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0437\u0430\u0431\u044b\u043b\u0456 \u043f\u0440\u0430 \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0437\u0445 43, 4. 5; \u043f\u0430\u0440. \u041b\u043a 2, 22<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0435\u043b\u0456\u0447 \u041f\u0430\u043d\u0430 \u045e\u0432\u0430\u0439\u0448\u043b\u0430 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u043f\u0440\u0430\u0437 \u0443\u0441\u0445\u043e\u0434\u043d\u044e\u044e \u0431\u0440\u0430\u043c\u0443.<span style=\"color: #ff0000;\"> *<\/span> \u0406 \u0432\u043e\u0441\u044c \u0434\u043e\u043c \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0441\u043b\u0430\u0432\u0430\u044e \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0430\u0446\u044c\u043a\u0456 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u0414\u0437\u0456\u0446\u044f \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0432\u043e\u0441\u044c \u0434\u043e\u043c \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0441\u043b\u0430\u0432\u0430\u044e \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"635","GCH_CH_2_Text":"\r\n<p><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo Guelferbytanus 32, De ordinatione episcopi: PLS 2, 639-640)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0426\u044f\u0440\u043f\u0456 \u0437\u0430 \u043c\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043a\u0430\u0431 \u042f\u043c\u0443 \u0441\u043b\u0443\u0436\u044b\u043b\u0456, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0456 \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0434\u043b\u044f \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u043c\u043d\u043e\u0433\u0456\u0445&raquo; (\u041c\u0446 20, 28). \u0412\u043e\u0441\u044c \u044f\u043a \u0441\u043b\u0443\u0436\u044b\u045e \u041f\u0430\u043d, \u0432\u043e\u0441\u044c \u044f\u043a\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u0401\u043d \u0445\u043e\u0447\u0430 \u0431\u0430\u0447\u044b\u0446\u044c \u0443 \u043d\u0430\u0441. \u0410\u0434\u0434\u0430\u0435 &laquo;\u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0434\u043b\u044f \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u043c\u043d\u043e\u0433\u0456\u0445&raquo;: \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u043d\u0430\u0448\u0430\u0435 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0437 \u043d\u0430\u0441 \u043c\u043e\u0436\u0430 \u043a\u0430\u0433\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c? \u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u043a\u0440\u043e\u045e, \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u043c\u044b \u0431\u044b\u043b\u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456. \u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435 \u043c\u044b \u043f\u0430\u045e\u0441\u0442\u0430\u043b\u0456. \u0410\u0434\u043d\u0430\u043a \u0456 \u043c\u044b \u043c\u0430\u0435\u043c \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u043f\u0440\u044b\u0447\u044b\u043d\u044f\u0446\u0446\u0430 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456\u043d\u0448\u044b\u0445, \u0431\u043e \u043c\u044b \u0447\u043b\u0435\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u0401\u043d &ndash; \u0413\u0430\u043b\u0430\u0432\u0430, \u0430 \u043c\u044b &ndash; \u042f\u0433\u043e \u0447\u043b\u0435\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b \u042f\u043d \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u043d\u0430\u0441 \u0443 \u0441\u0432\u0430\u0456\u043c \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0425\u0442\u043e \u0445\u043e\u0447\u0430 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0431\u044b\u0446\u044c \u043f\u0435\u0440\u0448\u044b\u043c, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u0448\u044b\u043c \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c. \u0411\u043e \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043a\u0430\u0431 \u042f\u043c\u0443 \u0441\u043b\u0443\u0436\u044b\u043b\u0456, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0456 \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0434\u043b\u044f \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u043c\u043d\u043e\u0433\u0456\u0445&raquo; (\u041c\u0446 20, 27-28). \u0417\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u043d\u0430\u0441 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043a\u0430\u0436\u0430: &laquo;\u0401\u043d \u0430\u0434\u0434\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451. \u0406 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0431\u0440\u0430\u0442\u043e\u045e&raquo; (1 \u042f\u043d 3, 16).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u041f\u0430\u043d \u043f\u0430\u0441\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u041f\u044f\u0442\u0440\u0443: &laquo;&ldquo;\u0421\u044b\u043c\u043e\u043d\u0435, \u0446\u0456 \u043b\u044e\u0431\u0456\u0448 \u0442\u044b \u041c\u044f\u043d\u0435?&rdquo; \u0422\u043e\u0439 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u042f\u043c\u0443: &ldquo;\u0422\u0430\u043a, \u041f\u0430\u043d\u0435, \u0422\u044b \u0432\u0435\u0434\u0430\u0435\u0448, \u0448\u0442\u043e \u044f \u043b\u044e\u0431\u043b\u044e \u0426\u044f\u0431\u0435&rdquo;&raquo; (\u042f\u043d 21, 15). \u0422\u0440\u044b \u0440\u0430\u0437\u044b \u0437\u0430\u0434\u0430\u0432\u0430\u045e \u0433\u044d\u0442\u0430\u0435 \u043f\u044b\u0442\u0430\u043d\u043d\u0435, \u041f\u0451\u0442\u0440 \u0442\u0440\u044b \u0440\u0430\u0437\u044b \u0442\u0430\u043a \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e. \u0417\u0430 \u043a\u043e\u0436\u043d\u044b\u043c \u0440\u0430\u0437\u0430\u043c \u041f\u0430\u043d \u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u0441\u0456 \u0430\u0432\u0435\u0447\u0430\u043a \u041c\u0430\u0456\u0445&raquo; (\u042f\u043d 21, 16).<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u0448, \u0448\u0442\u043e \u043b\u044e\u0431\u0456\u0448 \u041c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0456 \u043a\u043b\u043e\u043f\u0430\u0442 \u0430\u0431 \u0430\u0432\u0435\u0447\u043a\u0430\u0445? \u0428\u0442\u043e \u043c\u043e\u0436\u0430\u0448 \u0434\u0430\u0446\u044c \u041c\u043d\u0435, \u043b\u044e\u0431\u044f\u0447\u044b \u041c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u0456 \u0442\u0430\u043a \u0430\u0434 \u041c\u044f\u043d\u0435 \u0447\u0430\u043a\u0430\u0435\u0448 \u0443\u0441\u044f\u0433\u043e? \u0412\u043e\u0441\u044c \u0436\u0430 \u043c\u0430\u0435\u0448 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0434\u043b\u044f \u041c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u043b\u044e\u0431\u0456\u0448 \u041c\u044f\u043d\u0435: \u043f\u0430\u0441\u0456 \u0430\u0432\u0435\u0447\u0430\u043a \u041c\u0430\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0448\u044b, \u0434\u0440\u0443\u0433\u0456 \u0456 \u0442\u0440\u044d\u0446\u0456 \u0440\u0430\u0437: &laquo;\u041b\u044e\u0431\u0456\u0448 \u041c\u044f\u043d\u0435? \u041b\u044e\u0431\u043b\u044e. \u041f\u0430\u0441\u0456 \u0430\u0432\u0435\u0447\u0430\u043a \u041c\u0430\u0456\u0445&raquo;. \u0422\u0440\u043e\u0439\u0447\u044b \u0432\u044b\u0440\u0430\u043a\u0441\u044f \u0437-\u0437\u0430 \u0441\u0442\u0440\u0430\u0445\u0443, \u0442\u0440\u043e\u0439\u0447\u044b \u0432\u044b\u0437\u043d\u0430\u045e \u0437 \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u0440\u043e\u0439\u0447\u044b \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u041f\u044f\u0442\u0440\u0443 \u0441\u0432\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a, \u0430 \u0442\u043e\u0439 \u0442\u0440\u044b \u0440\u0430\u0437\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u045e, \u0432\u044b\u0437\u043d\u0430\u044e\u0447\u044b \u043b\u044e\u0431\u043e\u045e, \u0430\u0441\u0443\u0434\u0437\u0456\u045e \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u043c\u0430\u043b\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u044c, \u0456 \u0434\u0430\u0434\u0430\u045e: &laquo;\u041a\u0430\u043b\u0456 \u0442\u044b \u0431\u044b\u045e \u043c\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u044b, \u0442\u043e \u043f\u0430\u0434\u043f\u044f\u0440\u0430\u0437\u0432\u0430\u045e\u0441\u044f \u0441\u0430\u043c \u0456 \u0445\u0430\u0434\u0437\u0456\u045e, \u043a\u0443\u0434\u044b \u0445\u0430\u0446\u0435\u045e. \u041a\u0430\u043b\u0456 \u0436 \u0441\u0430\u0441\u0442\u0430\u0440\u044d\u0435\u0448, \u0442\u043e \u0432\u044b\u0446\u044f\u0433\u043d\u0435\u0448 \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435 \u0456 \u0456\u043d\u0448\u044b \u043f\u0430\u0434\u043f\u044f\u0440\u0430\u0436\u0430 \u0446\u044f\u0431\u0435, \u0456 \u043f\u0430\u0432\u044f\u0434\u0437\u0435, \u043a\u0443\u0434\u044b \u043d\u0435 \u0445\u043e\u0447\u0430\u0448. \u0410 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0442\u0430\u043a, \u043a\u0430\u0431 \u0437\u0430\u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u044f\u043a\u043e\u0439 \u0441\u043c\u0435\u0440\u0446\u044e \u0442\u043e\u0439 \u0443\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0411\u043e\u0433\u0430&raquo; (\u042f\u043d 21, 18). \u0410\u0431\u044f\u0446\u0430\u045e \u044f\u043c\u0443 \u044f\u0433\u043e \u043a\u0440\u044b\u0436, \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u044f\u0433\u043e\u043d\u0443\u044e \u043c\u0443\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u041f\u0430\u043d \u043a\u0430\u0436\u0430: &laquo;\u041f\u0430\u0441\u0456 \u0430\u0432\u0435\u0447\u0430\u043a \u041c\u0430\u0456\u0445&raquo; (\u042f\u043d 21, 16), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0446\u044f\u0440\u043f\u0456 \u0437\u0430 \u041c\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0424\u043b\u043f 1, 20b; \u041f\u0441 69 (68), 21\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u0431\u0443\u0434\u0443 \u0430\u0441\u0430\u0440\u043e\u043c\u043b\u0435\u043d\u044b, <span style=\"color: #ff0000;\">*<\/span> \u0443\u0437\u0432\u044f\u043b\u0456\u0447\u0430\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443 \u0446\u0435\u043b\u0435 \u043c\u0430\u0456\u043c: \u0446\u0456 \u043f\u0440\u0430\u0437 \u0436\u044b\u0446\u0446\u0451, \u0446\u0456 \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0427\u0430\u043a\u0430\u045e \u044f \u0441\u043f\u0430\u0433\u0430\u0434\u044b, \u0430\u043b\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u044f\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0437\u0432\u044f\u043b\u0456\u0447\u0430\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443 \u0446\u0435\u043b\u0435 \u043c\u0430\u0456\u043c: \u0446\u0456 \u043f\u0440\u0430\u0437 \u0436\u044b\u0446\u0446\u0451, \u0446\u0456 \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_2_ID":"636","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u044d\u043a\u0440\u044d\u0442 \u043f\u0440\u0430 \u043c\u0456\u0441\u0456\u0439\u043d\u0443\u044e \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0430 <br \/>&laquo;Ad gentes&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 23-24)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0422\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0442\u0440\u044d\u0431\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0440\u0430\u0441\u043f\u0430\u045e\u0441\u044e\u0434\u0436\u0432\u0430\u043d\u043d\u044f \u0432\u0435\u0440\u044b \u043c\u0430\u0435 \u043a\u043e\u0436\u043d\u044b \u0432\u0443\u0447\u0430\u043d\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0434\u043d\u0430\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043a\u043b\u0456\u0447\u0430 \u0437 \u043b\u0456\u043a\u0443 \u0432\u0443\u0447\u043d\u044f\u045e \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0441\u0430\u043c \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0437 \u0406\u043c i \u043a\u0430\u0431 \u043f\u0430\u0441\u044b\u043b\u0430\u0446\u044c \u0456\u0445 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u042f\u0433\u043e \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e\u0434\u0437\u044f\u043b\u044f\u0435 \u0445\u0430\u0440\u044b\u0437\u043c\u044b, \u044f\u043a \u0445\u043e\u0447\u0430, \u0434\u0437\u0435\u043b\u044f \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430, \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0440\u043e\u0437\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u043c\u0456\u0441\u0456\u0439\u043d\u044b\u044f \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0456 \u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043a\u043b\u0456\u0447\u0430 \u0434\u0430 \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u045e\u0441\u0442\u0430\u043d\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0437\u0430\u0446\u044b\u0456, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0443\u0441\u044f\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443, \u043f\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u044f\u043a \u0441\u0432\u0430\u0451 \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430\u0435 \u0437\u0430\u0434\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0435\u0446\u044b\u044f\u043b\u044c\u043d\u044b\u043c \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435\u043c \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0442\u044b\u044f, \u0445\u0442\u043e \u0430\u0434\u043e\u0440\u0430\u043d\u044b \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u043c\u0456 \u043f\u0440\u044b\u0440\u043e\u0434\u043d\u044b\u043c\u0456 \u0440\u044b\u0441\u0430\u043c\u0456, \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044f\u043c\u0456 i \u0442\u0430\u043b\u0435\u043d\u0442\u0430\u043c\u0456 \u0456 \u0433\u0430\u0442\u043e\u0432\u044b \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u0446\u044c \u043c\u0456\u0441\u0456\u0439\u043d\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443 &mdash; \u0446\u0456 \u0433\u044d\u0442\u0430 \u043c\u044f\u0441\u0446\u043e\u0432\u044b\u044f \u0436\u044b\u0445\u0430\u0440\u044b, \u0446\u0456 \u0447\u0443\u0436\u0430\u0437\u0435\u043c\u0446\u044b: \u0441\u0432\u044f\u0442\u0430\u0440\u044b, \u043a\u0430\u043d\u0441\u044d\u043a\u0440\u0430\u0432\u0430\u043d\u044b\u044f \u0430\u0441\u043e\u0431\u044b i \u0441\u0432\u0435\u0446\u043a\u0456\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u0430\u043d\u044b\u044f \u043f\u0440\u0430\u0432\u0430\u043c\u043e\u0446\u043d\u0430\u0439 \u0443\u043b\u0430\u0434\u0430\u0439, \u044f\u043d\u044b \u0437 \u0432\u0435\u0440\u0430\u0439 i \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044e \u0456\u0434\u0443\u0446\u044c \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u043c\u0456 \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044b, \u0434\u0430 \u044f\u043a\u043e\u0439 \u0431\u044b\u043b\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u044f\u043a \u0441\u043b\u0443\u0433\u0456 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, &laquo;\u043a\u0430\u0431 \u0433\u044d\u0442\u0430\u0435 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u0430\u0435 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0431\u044b\u043b\u043e \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u0435&raquo; (\u0420\u044b\u043c 15, 16).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0411\u043e\u0433 \u043a\u043b\u0456\u0447\u0430, \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u043a\u0430\u0431, \u043d\u0435 \u0440\u0430\u044f\u0447\u044b\u0441\u044f \u0437 \u0446\u0435\u043b\u0430\u043c i \u043a\u0440\u044b\u0432\u0451\u044e, \u0443\u0441\u044f\u0433\u043e \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f. \u0422\u0430\u043a\u0456 \u0430\u0434\u043a\u0430\u0437 \u043c\u043e\u0436\u043d\u0430 \u0434\u0430\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0434 \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0435\u043c i \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0431\u043e \u043c\u0456\u0441\u0456\u044f\u043d\u0435\u0440 \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0436\u044b\u0446\u0446\u0451 i \u043c\u0456\u0441\u0456\u044e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e &laquo;\u0432\u044b\u0440\u0430\u043a\u0441\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456&raquo; (\u0424\u043b\u043f 2, 7). \u0422\u0430\u043c\u0443 \u0451\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0433\u0430\u0442\u043e\u0432\u044b\u043c \u043f\u0440\u0430\u0437 \u0443\u0441\u0451 \u0436\u044b\u0446\u0446\u0451 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0441\u0432\u0430\u0456\u043c \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0456, \u0432\u044b\u0440\u0430\u043a\u0430\u044e\u0447\u044b\u0441\u044f \u0441\u044f\u0431\u0435 i \u045e\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0447\u0430\u0441\u0443 \u043c\u0435\u045e, \u043a\u0430\u0431 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0441\u0442\u0430\u0446\u044c \u0443\u0441\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043d\u044f\u0445\u0430\u0439 \u0441\u043c\u0435\u043b\u0430 \u045e\u043a\u0430\u0437\u0432\u0430\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0456\u043c\u044f \u044f\u043a\u043e\u0433\u0430 \u0441\u043f\u0430\u045e\u043d\u044f\u0435 \u043c\u0456\u0441\u0456\u044e \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456\u043a\u0430, \u043d\u044f\u0445\u0430\u0439 \u0443 \u0406\u043c \u043c\u0430\u0435 \u0430\u0434\u0432\u0430\u0433\u0443 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u044f\u043a \u043f\u0430\u0432\u0456\u043d\u0435\u043d, \u043d\u0435 \u0441\u0430\u0440\u043e\u043c\u0435\u044e\u0447\u044b\u0441\u044f \u0441\u043f\u0430\u043a\u0443\u0441\u044b \u043a\u0440\u044b\u0436\u0430. \u0406\u0434\u0443\u0447\u044b \u0441\u043b\u0435\u0434\u0430\u043c \u0437\u0430 \u0441\u0432\u0430\u0456\u043c \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c, \u044f\u043a\u0456 \u0431\u044b\u045e \u0446\u0456\u0445\u0456 i \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u0441\u044d\u0440\u0446\u0430\u043c, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u0448\u0442\u043e \u044f\u0440\u043c\u043e \u042f\u0433\u043e \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u0435, a \u0446\u044f\u0436\u0430\u0440 \u043b\u0451\u0433\u043a\u0456. \u041d\u044f\u0445\u0430\u0439 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u041f\u0430\u043d\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u044e, \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e, \u0448\u0447\u044b\u0440\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e, a \u043a\u0430\u043b\u0456 \u045e\u0437\u043d\u0456\u043a\u043d\u0435 \u043f\u0430\u0442\u0440\u044d\u0431\u0430, \u043d\u0430\u0432\u0430\u0442 \u043f\u0440\u0430\u043b\u0456\u0446\u0446\u0451\u043c \u043a\u0440\u044b\u0432\u0456. \u041d\u044f\u0445\u0430\u0439 \u0441\u0456\u043b\u0443 \u0456 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044c \u0451\u043d \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u0435 \u045e \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0441\u044f\u0440\u043e\u0434 \u043c\u043d\u043e\u0433\u0456\u0445 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u043c\u0456 i \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u045e\u0431\u043e\u0441\u0442\u0432\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0443\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c. \u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b, \u0448\u0442\u043e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c &mdash; \u0433\u044d\u0442\u0430 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u044f \u0446\u043d\u043e\u0442\u0430 \u0441\u043b\u0443\u0433\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0440\u043e\u0434.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 9, 16. 22b<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u044f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0442\u043e \u043c\u043d\u0435 \u043d\u044f\u043c\u0430 \u0447\u044b\u043c \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430, \u0431\u043e \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0433\u044d\u0442\u044b \u045e\u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430 \u043c\u044f\u043d\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0413\u043e\u0440\u0430 \u043c\u043d\u0435, \u043a\u0430\u043b\u0456 \u044f \u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u043b\u044f \u045e\u0441\u0456\u0445 \u044f \u0441\u0442\u0430\u045e \u0443\u0441\u0456\u043c, \u043a\u0430\u0431 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u043e\u0440\u0430 \u043c\u043d\u0435, \u043a\u0430\u043b\u0456 \u044f \u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"637","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0441\u0432. \u0410\u0433\u0430\u0442\u0443&raquo; \u0441\u0432. \u041c\u044f\u0442\u043e\u0434\u0430 \u0421\u0456\u0446\u044b\u043b\u0456\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Analecta Bollandiana 68, 76-78)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0414\u0430\u0434\u0437\u0435\u043d\u0430\u044f \u0411\u043e\u0433\u0430\u043c, \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0434\u0430\u0431\u0440\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u043c\u044b \u0441\u0430\u0431\u0440\u0430\u043b\u0456c\u044f \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0434\u0437\u0435\u043b\u044f \u0448\u0442\u043e\u0433\u0430\u0434\u043e\u0432\u0430\u0433\u0430 \u045e\u0448\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0432\u044f\u0442\u043e\u0439 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u044b. \u042f\u043a \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u043c\u0430\u0435 \u0441\u043b\u0443\u0445\u0430\u0447\u044b, \u0433\u044d\u0442\u0430\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0430 \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u0430\u0441\u0446\u0456 \u0430\u0434\u043d\u0430 \u0437 \u043f\u0435\u0440\u0448\u044b\u0445 \u0437\u043c\u0430\u0433\u0430\u043b\u0430\u0441\u044f \u045e \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0439 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u044f\u043d\u0430 \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0451\u043d\u043d\u044f \u0456 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435 \u045e \u043d\u0430\u0448\u044b \u0434\u043d\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u044b\u043c \u0446\u0443\u0434\u0430\u043c, \u044f\u043a\u0456\u044f \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u045e\u043a\u0430\u0440\u0430\u043d\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u044e\u0446\u044c \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u043f\u0430\u043d\u043d\u0430, \u0431\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0430\u0434 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u043b\u043e\u0432\u0430 (\u044f\u043a\u0456 \u045e \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u0441\u043c\u0435\u0440\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0434\u0437\u0435\u043b\u044f \u043c\u044f\u043d\u0435), \u0430\u0434 \u043d\u0435\u043f\u0430\u0434\u0437\u0435\u043b\u044c\u043d\u0430\u0433\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c \u0421\u044b\u043d\u0430, \u044f\u043a \u043a\u0430\u0436\u0430 \u042f\u043d \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442: &laquo;\u0422\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u045e \u042f\u0433\u043e, \u0434\u0430\u043b\u043e \u045e\u043b\u0430\u0434\u0443 \u0441\u0442\u0430\u0446\u044c \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456&raquo; (\u042f\u043d 1, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0436\u0443\u0447\u044b \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0441\u0432. \u041f\u0430\u045e\u043b\u0430, \u0441\u0432. \u0410\u0433\u0430\u0442\u0443, \u044f\u043a\u0430\u044f \u0437\u0430\u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u043d\u0430\u0441 \u043d\u0430 \u043f\u0430\u0431\u043e\u0436\u043d\u0443\u044e \u0433\u0430\u0441\u0446\u0456\u043d\u0443, \u043c\u043e\u0436\u043d\u0430 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u0446\u044c \u0437 \u043f\u0430\u043d\u043d\u0430\u0439, \u0437\u0430\u0440\u0443\u0447\u0430\u043d\u0430\u0439 \u0437 \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u043c\u0443\u0436\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u0434\u0437\u0435\u0432\u0430, \u044f\u043a\u0430\u044f \u0430\u0437\u0434\u043e\u0431\u0456\u043b\u0430 \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u0447\u044b\u0440\u0432\u0430\u043d\u043d\u044e \u043a\u0440\u044b\u0432\u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u0411\u0430\u0440\u0430\u043d\u043a\u0430 \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u0441\u0432\u043e\u0439 \u0434\u0443\u0445 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u042f\u0433\u043e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430. \u0428\u0430\u0442\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u0441\u0432\u044f\u0442\u043e\u0439 \u043d\u043e\u0441\u0456\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435\u043f\u0430\u0437\u0431\u044b\u045e\u043d\u044b\u044f \u0441\u043b\u044f\u0434\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043a\u0440\u044b\u0432\u0456, \u043d\u0430\u0431\u044b\u0442\u044b\u044f \u044f\u0448\u0447\u044d \u0440\u0430\u043d\u0435\u0439, \u0430\u043b\u0435 \u0456 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u0431\u0443\u0434\u0443\u0447\u044b\u044f \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456 \u043a\u0440\u0430\u0441\u0430\u043c\u043e\u045e\u043d\u0430\u0441\u0446\u044e \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430, \u0434\u0430\u044e\u0447\u044b \u0456\u043c \u043d\u0435\u0432\u044b\u0447\u0430\u0440\u043f\u0430\u043b\u044c\u043d\u0443\u044e \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0434\u043e\u0431\u0440\u0430\u044f, \u0431\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u043b\u0430\u0441\u044f \u0447\u0430\u0441\u0442\u043a\u0430\u044e \u0411\u043e\u0433\u0430, \u0431\u044b\u043b\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u044f \u0441\u0432\u0430\u0439\u043c\u0443 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0443 \u0411\u043e\u0433\u0430\u043c, \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430. \u0411\u044b\u043b\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u044f \u0456 \u043d\u0430\u043c, \u043a\u0430\u0431 \u043c\u044b \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u043b\u0456 \u045e \u0442\u044b\u043c \u0434\u0430\u0431\u0440\u044b, \u044f\u043a\u043e\u0435 \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0443\u0435 \u044f\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0435 \u0456\u043c\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430, \u0447\u044b\u043c \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0435 \u0414\u0430\u0431\u0440\u043e? \u0406 \u0446\u0456 \u043c\u043e\u0436\u043d\u0430 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u043d\u0435\u0448\u0442\u0430 \u0431\u043e\u043b\u044c\u0448 \u0433\u043e\u0434\u043d\u0430\u0435 \u043f\u0430\u0445\u0432\u0430\u043b\u044b, \u044f\u043a \u043d\u0435 \u0410\u0433\u0430\u0442\u0443?<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0431\u0440\u044b\u043d\u044f \u0410\u0433\u0430\u0442\u044b \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u044f\u0435 \u0456\u043c\u0435\u043d\u0456 \u0456 \u0441\u0430\u043c\u043e\u0439 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u0456, \u0431\u043e \u044f\u043d\u0430 \u043d\u043e\u0441\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u0456\u043c\u044f, \u044f\u043a\u043e\u0435 \u0441\u0432\u0435\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u044f\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b. \u0410\u0433\u0430\u0442\u0430 \u043d\u0430\u0432\u0430\u0442 \u0441\u0432\u0430\u0456\u043c \u0456\u043c\u0435\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043d\u0430\u0441 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0437\u0432\u044f\u0440\u0442\u0430\u0446\u0446\u0430 \u0434\u0430 \u044f\u0435. \u0421\u0432\u0430\u0456\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0432\u0443\u0447\u044b\u0446\u044c \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u0430\u0431, \u043d\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u044f\u0447\u044b, \u0441\u043f\u044f\u0448\u0430\u043b\u0456\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0451\u0439 \u0434\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u043c\u043d\u0435 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0432\u0435\u0440\u0443 \u045e \u042f\u0433\u043e. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u043c\u044f\u043d\u0435 \u0430\u0437\u0434\u0430\u0440\u0430\u0432\u0456\u045e \u0456 \u0441\u0443\u0446\u0435\u0448\u044b\u045e. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b \u041f\u0430\u043d \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430 \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0443\u044e \u0441\u043b\u0443\u0433\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u043c\u044f\u043d\u0435 \u0430\u0437\u0434\u0430\u0440\u0430\u0432\u0456\u045e \u0456 \u0441\u0443\u0446\u0435\u0448\u044b\u045e.<\/p>\r\n"}, {"GCH_CH_2_ID":"638","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0456\u0441\u0442\u043e\u0440\u044b\u044f \u043f\u0430\u043a\u0443\u0442\u043d\u0456\u0446\u0442\u0432\u0430 \u0441\u0432. \u041f\u0430\u045e\u043b\u0430 \u041c\u0456\u043a\u0456 \u0456 \u043f\u0430\u043f\u043b\u0435\u0447\u043d\u0456\u043a\u0430\u045e&raquo;, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u044f \u0442\u0430\u0433\u0430\u0447\u0430\u0441\u043d\u044b\u043c \u0430\u045e\u0442\u0430\u0440\u0430\u043c<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 14, 109-110: Acta Sanctorum, Febr. 1, 769)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0411\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u0430\u0456\u043c\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u043a\u0440\u044b\u0436\u044b, \u0431\u044b\u043b\u043e \u0434\u0437\u0456\u045e\u043d\u0430 \u0431\u0430\u0447\u044b\u0446\u044c \u0432\u0430 \u045e\u0441\u0456\u0445 \u0442\u0443\u044e \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c, \u0434\u0430 \u044f\u043a\u043e\u0439 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0456 \u0430\u0439\u0446\u0435\u0446 \u041f\u0430\u0441\u0456\u0439 \u0456 \u0430\u0439\u0446\u0435\u0446 \u0420\u0430\u0434\u0440\u044b\u0433\u0435\u0441. \u0410\u0439\u0446\u0435\u0446-\u043a\u0430\u043c\u0456\u0441\u0430\u0440 \u0443\u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u0433\u043b\u044f\u0434\u0437\u0435\u045e \u0443 \u043d\u0435\u0431\u0430. \u0411\u0440\u0430\u0442 \u041c\u0430\u0440\u0446\u0456\u043d \u0441\u043f\u044f\u0432\u0430\u045e \u043f\u0441\u0430\u043b\u044c\u043c\u044b \u043f\u0430\u0434\u0437\u044f\u043a\u0456 \u0437\u0430 \u0411\u043e\u0436\u0443\u044e \u0434\u0430\u0431\u0440\u044b\u043d\u044e, \u0434\u0430 \u044f\u043a\u0456\u0445 \u0434\u0430\u0434\u0430\u0432\u0430\u045e \u0432\u0435\u0440\u0448: &laquo;\u0423 \u0440\u0443\u043a\u0456 \u0422\u0432\u0430\u0435, \u041f\u0430\u043d\u0435&raquo; (\u041f\u0441 31 [30], 6). \u0411\u0440\u0430\u0442 \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u0430\u043a \u0411\u043b\u0430\u043d\u043a \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0433\u0443\u0447\u043d\u0430 \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u045e \u0411\u043e\u0433\u0443. \u0411\u0440\u0430\u0442 \u0413\u0430\u043d\u0437\u0430\u043b\u0435\u0441 \u0433\u0443\u0447\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u041f\u0430\u043d\u0441\u043a\u0443\u044e \u0456 \u0410\u043d\u0451\u043b\u044c\u0441\u043a\u0430\u0435 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0432\u0435\u043b \u041c\u0456\u043a\u0456, \u0431\u0440\u0430\u0442 \u043d\u0430\u0448, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b, \u0448\u0442\u043e \u0437\u0430\u0439\u043c\u0430\u0435 \u0441\u0430\u043c\u0430\u0435 \u0433\u0430\u043d\u0430\u0440\u043e\u0432\u0430\u0435 \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u0435, \u043d\u0430 \u044f\u043a\u043e\u0435 \u043a\u0430\u043b\u0456-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043f\u0430\u0434\u044b\u043c\u0430\u045e\u0441\u044f, \u043d\u0430\u0439\u043f\u0435\u0440\u0448 \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0451\u043d \u044f\u043f\u043e\u043d\u0435\u0446 \u0456 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u0422\u0430\u0432\u0430\u0440\u044b\u0441\u0442\u0432\u0430 \u0415\u0437\u0443\u0441\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u043f\u0430\u043c\u0456\u0440\u0430\u0435 \u0437\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0456 \u0434\u0437\u044f\u043a\u0443\u0435 \u0411\u043e\u0433\u0443 \u0437\u0430 \u0433\u044d\u0442\u0430\u0435 \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u0430\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430. \u041f\u0430\u0441\u043b\u044f \u0434\u0430\u0434\u0430\u045e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b: &laquo;\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f \u0434\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u043e\u043c\u0430\u043d\u0442\u0443, \u0434\u0443\u043c\u0430\u044e, \u0443\u0441\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0446\u044c, \u0448\u0442\u043e \u044f \u043d\u0435 \u0431\u0443\u0434\u0443 \u045e\u0442\u043e\u0439\u0432\u0430\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0443. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u0432\u0430\u043c, \u0448\u0442\u043e \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0456 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u043e\u0439, \u043f\u0430 \u044f\u043a\u043e\u0439 \u0456\u0434\u0443\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435. \u042f\u043d\u0430 \u0432\u0443\u0447\u044b\u0446\u044c \u043c\u044f\u043d\u0435 \u0434\u0430\u0440\u0430\u0432\u0430\u0446\u044c \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u043c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u0456\u043c, \u0445\u0442\u043e \u043c\u044f\u043d\u0435 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u045e, \u0442\u0430\u043c\u0443 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0440\u0430\u0431\u0430\u0447\u0430\u044e \u043a\u0430\u0440\u0430\u043b\u044e \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u043c\u044f\u043d\u0435, \u0456 \u043c\u0430\u043b\u044e\u0441\u044f \u0437\u0430 \u0456\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0430\u0436\u0430\u0434\u0430\u043b\u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0445\u0440\u043e\u0441\u0442&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u043e\u0442\u044b\u043c, \u043f\u0430\u0432\u044f\u0440\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u043f\u0430\u043f\u043b\u0435\u0447\u043d\u0456\u043a\u0430\u045e, \u043f\u0430\u0447\u0430\u045e \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u0446\u044c \u0456\u0445 \u0443 \u0433\u044d\u0442\u0430\u0439 \u0430\u043f\u043e\u0448\u043d\u044f\u0439 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435. \u041d\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u0445 \u0443\u0441\u0456\u0445 \u0431\u044b\u043b\u0430 \u0431\u0430\u0447\u043d\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043d\u0430 \u0442\u0432\u0430\u0440\u044b \u041b\u044e\u0434\u0432\u0456\u043a\u0430. \u041a\u0430\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e \u0434\u0430 \u044f\u0433\u043e, \u0448\u0442\u043e \u0451\u043d \u043d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e \u0440\u0430\u0456, \u0456 \u0442\u043e\u0439 \u043f\u043e\u045e\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0430\u0439 \u0443\u0441\u044f\u0433\u043e \u0446\u0435\u043b\u0430 \u0437\u0432\u044f\u0440\u043d\u0443\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u0432\u043e\u0447\u044b \u045e\u0441\u0456\u0445 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043d\u0442\u043e\u043d\u0456, \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0437\u0431\u043e\u043a\u0443 \u0430\u0434 \u041b\u044e\u0434\u0432\u0456\u043a\u0430, \u043f\u0430\u0434\u043d\u044f\u045e \u0432\u043e\u0447\u044b \u045e \u043d\u0435\u0431\u0430 \u0456, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e\u0448\u044b \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0435 \u0456\u043c\u044f \u0415\u0437\u0443\u0441\u0430 \u0456 \u041c\u0430\u0440\u044b\u0456, \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u045e \u043f\u0441\u0430\u043b\u044c\u043c &laquo;\u0425\u0432\u0430\u043b\u0456\u0446\u0435, \u0441\u043b\u0443\u0433\u0456, \u041f\u0430\u043d\u0430&raquo;, \u044f\u043a\u043e\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u043d\u0430 \u043a\u0430\u0442\u044d\u0445\u0435\u0437\u0435 \u045e \u041d\u0430\u0433\u0430\u0441\u0430\u043a\u0456. \u0422\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043b\u0456 \u0448\u043c\u0430\u0442 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e, \u043a\u0430\u0431 \u0434\u0437\u0435\u0446\u0456 \u0432\u0443\u0447\u044b\u043b\u0456 \u043d\u0430 \u043f\u0430\u043c\u044f\u0446\u044c \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u043f\u0441\u0430\u043b\u044c\u043c\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0406\u043d\u0448\u044b\u044f \u0437 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u043b\u0456: &laquo;\u0415\u0437\u0443\u0441, \u041c\u0430\u0440\u044b\u044f&raquo;. \u041d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043b\u0456 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u044b\u0445 \u0432\u0435\u0441\u0446\u0456 \u0436\u044b\u0446\u0446\u0451, \u0433\u043e\u0434\u043d\u0430\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e; \u0442\u044b\u043c\u0456 \u0446\u0456 \u0456\u043d\u0448\u044b\u043c\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0437\u0435\u044f\u043d\u043d\u044f\u043c\u0456 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u0433\u0430\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0447\u0430\u0442\u044b\u0440\u044b \u043a\u0430\u0442\u044b \u043f\u0430\u0447\u0430\u043b\u0456 \u0432\u044b\u0446\u044f\u0433\u0432\u0430\u0446\u044c \u0437 \u043d\u043e\u0436\u043d\u0430\u045e \u043c\u044f\u0447\u044b (\u044f\u043a\u0456\u044f \u0447\u0430\u0441\u0442\u0430 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u045e \u042f\u043f\u043e\u043d\u0456\u0456), \u043d\u0430 \u0436\u0430\u0445\u043b\u0456\u0432\u044b \u0432\u044b\u0433\u043b\u044f\u0434 \u044f\u043a\u0456\u0445 \u0443\u0441\u0435 \u0432\u0435\u0440\u043d\u044b\u044f \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u043b\u0456: &laquo;\u0415\u0437\u0443\u0441, \u041c\u0430\u0440\u044b\u044f&raquo;, \u0456 \u0433\u044d\u0442\u044b \u0433\u043e\u0434\u043d\u044b \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u043a\u0440\u044b\u043a \u043f\u0440\u0430\u0446\u044f\u045e \u0441\u0430\u043c\u0456 \u043d\u044f\u0431\u0451\u0441\u044b. \u041a\u0430\u0442\u044b \u0430\u0434\u043d\u044b\u043c-\u0434\u0432\u0443\u043c\u0430 \u045e\u0434\u0430\u0440\u0430\u043c\u0456 \u0445\u0443\u0442\u043a\u0430 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u043b\u0456 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0430\u043b 6, 14; \u0424\u043b\u043f 1, 29<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0456\u0447\u044b\u043c, \u0430\u043a\u0440\u0430\u043c\u044f \u043a\u0440\u044b\u0436\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u044f\u043a\u0456\u043c \u043d\u0430\u0448\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u043f\u0440\u0430\u045e\u0434\u0430 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u043c\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0430\u043c \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u0430\u043b\u0435 \u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u0430 \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u043c\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"639","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0413\u0435\u0440\u0430\u043d\u0456\u043c\u0430 \u042d\u043c\u0456\u043b\u0456\u044f\u043d\u0456 \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Venetiis, die 21 iunii 1535)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430 \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0431\u0440\u0430\u0442\u044b \u0456 \u0441\u044b\u043d\u044b \u0422\u0430\u0432\u0430\u0440\u044b\u0441\u0442\u0432\u0430 \u0441\u043b\u0443\u0433\u0430\u045e \u0431\u0435\u0434\u043d\u044b\u0445. \u0412\u0430\u0448 \u0443\u0431\u043e\u0433\u0456 \u0430\u0439\u0446\u0435\u0446 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u0432\u0430\u0441 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u045e \u0432\u0435\u0440\u043d\u044b\u043c \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0433\u0430 \u0437\u0430\u043a\u043e\u043d\u0443, \u044f\u043a \u0456 \u044f \u0441\u0432\u0435\u0434\u0447\u044b\u045e \u043f\u0440\u0430 \u044f\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c \u0456 \u0447\u044b\u043d\u0430\u043c, \u043a\u0430\u043b\u0456 \u0431\u044b\u045e \u0437 \u0432\u0430\u043c\u0456, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u043c\u044f\u043d\u0435 \u041f\u0430\u043d \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u045e \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448\u0430 \u043c\u044d\u0442\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0411\u043e\u0433, \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u045e\u0441\u044f\u043a\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430, \u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b, \u044f\u043a \u0456 \u043a\u0430\u0436\u0430\u043c \u0443 \u043d\u0430\u0448\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430 \u042f\u0433\u043e, \u0430 \u043d\u0435 \u043d\u0430 \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0433\u0430. \u041b\u0430\u0441\u043a\u0430\u0432\u044b \u041f\u0430\u043d \u043d\u0430\u0448, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u044b\u0446\u044c \u0432\u0430\u0448\u0443 \u0432\u0435\u0440\u0443 \u0456 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0432\u0430\u0448\u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 (\u0431\u0435\u0437 \u044f\u043a\u043e\u0439, \u044f\u043a \u043a\u0430\u0436\u0430 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0437\u043c\u043e\u0433 \u0431\u044b \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u0445 \u0446\u0443\u0434\u0430\u045e), \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u044c \u0432\u0430\u0441 \u044f\u043a \u0431\u0435\u0434\u043d\u044b\u0445, \u0441\u043f\u0430\u043a\u0443\u0442\u0430\u0432\u0430\u043d\u044b\u0445, \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u0445, \u0441\u0442\u043e\u043c\u043b\u0435\u043d\u044b\u0445 \u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043d\u044b\u0445 \u0443\u0441\u0456\u043c\u0456. \u0425\u043e\u0446\u044c \u043c\u044f\u043d\u0435 \u0444\u0456\u0437\u0456\u0447\u043d\u0430 \u043d\u044f\u043c\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0430\u043c\u0456, \u044f\u043a \u0432\u0430\u0448 \u0443\u0431\u043e\u0433\u0456 \u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u044b \u0430\u0439\u0446\u0435\u0446 \u044f \u0434\u0443\u0445\u043e\u045e\u043d\u0430 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u044e \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043c\u0443 \u041f\u0430\u043d \u0442\u0430\u043a \u0430\u0431\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0432\u0430\u043c\u0456, \u0432\u0435\u0434\u0430\u0435 \u0401\u043d \u0430\u0434\u0437\u0456\u043d. \u0410\u0434\u043d\u0430\u043a \u043c\u043e\u0436\u043d\u0430 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0442\u0440\u044b \u043f\u0440\u044b\u0447\u044b\u043d\u044b. \u041f\u0430-\u043f\u0435\u0440\u0448\u0430\u0435, \u041f\u0430\u043d \u0445\u043e\u0447\u0430 \u0434\u0430\u043b\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0434\u0430 \u043b\u0456\u043a\u0443 \u0441\u0432\u0430\u0456\u0445 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u043d\u0430 \u042f\u0433\u043e \u0448\u043b\u044f\u0445\u0430\u0445. \u0422\u0430\u043a \u0401\u043d \u043f\u0430\u0441\u0442\u0443\u043f\u0456\u045e \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u044f\u0431\u0440\u0430\u043c\u0456, \u0440\u043e\u0431\u044f\u0447\u044b \u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430-\u0434\u0440\u0443\u0433\u043e\u0435, \u0401\u043d \u043f\u0440\u0430\u0433\u043d\u0435, \u043a\u0430\u0431 \u043c\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430 \u042f\u0433\u043e, \u0430 \u043d\u0435 \u043d\u0430 \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0433\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433, \u044f\u043a \u044f \u0441\u043a\u0430\u0437\u0430\u045e, \u043d\u0435 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u0441\u0432\u0430\u0456\u0445 \u0441\u043f\u0440\u0430\u045e \u0443 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u0430\u0434\u0432\u0430\u0436\u044b\u045e\u0441\u044f \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430 \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c \u0456 \u0434\u0430\u0432\u0435\u0440\u044b\u0446\u0446\u0430 \u042f\u043c\u0443. \u0410 \u0432\u043e\u0441\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u044b\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0432\u0435\u0440\u0430\u0439 \u0456 \u043d\u0430\u0434\u0437\u0435\u044f\u0439, \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u043b\u044e\u0431\u043e\u045e\u044e \u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u045e \u0456\u0445 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0432\u044b \u045e\u0437\u0431\u0440\u043e\u0456\u0446\u0435\u0441\u044f \u0432\u0435\u0440\u0430\u0439 \u0456 \u043d\u0430\u0434\u0437\u0435\u044f\u0439, \u041f\u0430\u043d, \u044f\u043a\u0456 \u045e\u0437\u0432\u044b\u0448\u0430\u0435 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u0445, \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0443 \u0432\u0430\u0441 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0437\u0430\u0431\u0456\u0440\u0430\u044e\u0447\u044b \u043c\u044f\u043d\u0435 \u0446\u0456 \u043a\u0430\u0433\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043b\u044e\u0431\u0430\u0433\u0430 \u0434\u043b\u044f \u0432\u0430\u0441, \u0411\u043e\u0433 \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0432\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0432\u044b\u0431\u0430\u0440\u0430\u043c: \u0441\u0442\u0440\u0430\u0446\u0456\u0446\u044c \u0432\u0435\u0440\u0443 \u0456 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0437\u044f\u043c\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u045e \u0430\u0431\u043e \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u043c\u043e\u0446\u043d\u044b\u043c\u0456 \u045e \u0432\u0435\u0440\u044b \u0456 \u0433\u044d\u0442\u044b\u043c \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u042f\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0442\u0440\u044d\u0446\u044f\u044f \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u0445\u043e\u0447\u0430 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u0432\u0430\u0441, \u044f\u043a \u0437\u043e\u043b\u0430\u0442\u0430 \u045e \u0433\u0430\u0440\u043d\u0456\u043b\u0435. \u0411\u043e \u0430\u0433\u043e\u043d\u044c \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u0435 \u045e\u0441\u044f\u043a\u0456\u044f \u0448\u043b\u0430\u043a\u0456, \u0430 \u0437\u043e\u043b\u0430\u0442\u0430 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0447\u044b\u0441\u0446\u0435\u0439\u0448\u044b\u043c. \u0422\u0430\u043a\u0456\u043c \u0436\u0430 \u0447\u044b\u043d\u0430\u043c \u0411\u043e\u0433 \u0440\u043e\u0431\u0456\u0446\u044c \u0437 \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u043b\u0443\u0433\u043e\u0439, \u044f\u043a\u0456 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u042f\u0433\u043e \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0432\u0430\u0442 \u0443 \u043d\u044f\u0434\u043e\u043b\u0456. \u0411\u043e\u0433 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0442\u0430\u043a\u043e\u0433\u0430 \u0441\u043b\u0443\u0433\u0443 \u0456 \u0437\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0442\u043e\u0439 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0430\u0434\u043f\u043b\u0430\u0447\u0432\u0430\u0435 \u045e \u0441\u0442\u043e \u0440\u0430\u0437\u043e\u045e \u0431\u043e\u043b\u044c\u0448 \u0443 \u0433\u044d\u0442\u044b\u043c \u0432\u0435\u043a\u0443 \u0456 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u0432\u0435\u0447\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0411\u043e\u0433 \u0440\u0430\u0431\u0456\u045e \u0437 \u0443\u0441\u0456\u043c\u0456 \u0441\u0432\u044f\u0442\u044b\u043c\u0456. \u0422\u0430\u043a \u0437\u0440\u0430\u0431\u0456\u045e \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0451\u043d \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u0443 \u0415\u0433\u0456\u043f\u0446\u0435. \u0411\u043e\u0433 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u0432\u0435\u045e \u0430\u0434\u0442\u0443\u043b\u044c \u043d\u0430\u0440\u043e\u0434 \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0441\u044f\u0440\u043e\u0434 \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0446\u0443\u0434\u0430\u045e \u0456 \u043a\u0430\u0440\u043c\u0456\u045e \u043c\u0430\u043d\u043d\u0430\u0439 \u0443 \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u0430\u043b\u0435 \u0456 \u0434\u0430\u045e \u044f\u043c\u0443 \u0430\u0431\u044f\u0446\u0430\u043d\u0443\u044e \u0437\u044f\u043c\u043b\u044e. \u041a\u0430\u043b\u0456 \u0456 \u0432\u044b \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u043c \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0435\u0446\u0435 \u045e \u0432\u0435\u0440\u044b, \u041f\u0430\u043d \u0430\u0434\u043e\u0440\u044b\u0446\u044c \u0432\u0430\u0441 \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u0456 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0430\u043c \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435 \u043d\u0430 \u043f\u044d\u045e\u043d\u044b \u0447\u0430\u0441, \u0430 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043c &ndash; \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b. <br \/> <br \/><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u041f 3, 8. 9; \u0420\u044b\u043c 12, 10-11<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u045e\u0441\u0435 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430\u043c\u0456, \u0447\u0443\u043b\u044b\u043c\u0456, \u043b\u044e\u0431\u044f\u0447\u044b\u043c\u0456 \u0431\u0440\u0430\u0442\u043e\u045e, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b\u043c\u0456, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456; <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u043a\u0430\u0431 \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041b\u044e\u0431\u0456\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0431\u0440\u0430\u0442\u043d\u044f\u044e \u043b\u044e\u0431\u043e\u045e\u044e, \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e \u0432\u0435\u0442\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0443 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u044b\u044f, \u0434\u0443\u0445\u0430\u043c \u043f\u0430\u043b\u044b\u043c\u043d\u0435\u0439\u0446\u0435, \u0441\u043b\u0443\u0436\u044b\u0446\u0435 \u041f\u0430\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u043a\u0430\u0431 \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"640","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 &laquo;\u0414\u044b\u044f\u043b\u043e\u0433\u0430\u045e&raquo; \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 2, 33: PL 66, 194-196)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0417\u043c\u0430\u0433\u043b\u0430 \u0431\u043e\u043b\u044c\u0448 \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0445\u0430\u043b\u044f\u0441\u0442\u044b\u043a\u0430, \u0441\u044f\u0441\u0442\u0440\u0430 \u0441\u0432. \u0411\u044d\u043d\u044d\u0434\u044b\u043a\u0442\u0430, \u0437 \u0441\u0430\u043c\u0430\u0433\u0430 \u0434\u0437\u044f\u0446\u0456\u043d\u0441\u0442\u0432\u0430 \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u045e\u0448\u044b \u0441\u044f\u0431\u0435 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0443, \u0437\u0430\u0437\u0432\u044b\u0447\u0430\u0439 \u0440\u0430\u0437 \u0443 \u0433\u043e\u0434 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u043b\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0442\u0430. \u041c\u0443\u0436 \u0411\u043e\u0436\u044b \u043f\u0440\u044b\u043c\u0430\u045e \u044f\u0435 \u043d\u0435\u0434\u0430\u043b\u0451\u043a\u0430 \u043f\u0430-\u0437\u0430 \u0431\u0440\u0430\u043c\u0430\u043c\u0456 \u0432\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u044f\u0445 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043f\u044d\u045e\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0440\u044b\u0439\u0448\u043b\u0430, \u044f\u043a \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430, \u0430 \u0433\u043e\u0434\u043d\u044b \u043f\u0430\u0448\u0430\u043d\u044b \u0431\u0440\u0430\u0442 \u0432\u044b\u0439\u0448\u0430\u045e \u0434\u0430 \u044f\u0435 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0432\u0443\u0447\u043d\u044f\u043c\u0456. \u0426\u044d\u043b\u044b \u0434\u0437\u0435\u043d\u044c \u044f\u043d\u044b \u043f\u0440\u0430\u0432\u044f\u043b\u0456 \u045e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0411\u043e\u0433\u0430 \u0456 \u0441\u0432\u044f\u0442\u044b\u0445 \u0440\u0430\u0437\u043c\u043e\u0432\u0430\u0445, \u0430 \u043a\u0430\u043b\u0456 \u0441\u0442\u0430\u043b\u0430 \u0432\u0435\u0447\u0430\u0440\u044d\u0446\u044c, \u0440\u0430\u0437\u0430\u043c \u0441\u043f\u0430\u0436\u044b\u043b\u0456 \u0432\u044f\u0447\u044d\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u0430 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0440\u0430\u0437\u043c\u043e\u0432\u0430\u043c\u0456 \u0437\u0430\u0446\u044f\u0433\u043d\u0443\u045e\u0441\u044f \u0447\u0430\u0441, \u0433\u044d\u0442\u0430\u044f \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u0431\u0440\u0430\u0442\u0430: &laquo;\u041f\u0440\u0430\u0448\u0443 \u0446\u044f\u0431\u0435, \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439 \u043c\u044f\u043d\u0435 \u0433\u044d\u0442\u0430\u0439 \u043d\u043e\u0447\u0447\u0443, \u043a\u0430\u0431 \u043c\u044b \u0434\u0430 \u0440\u0430\u043d\u0456\u0446\u044b \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0456 \u0430\u0431 \u0440\u0430\u0434\u0430\u0441\u0446\u044f\u0445 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f&raquo;. \u0410\u0434\u043d\u0430\u043a \u0451\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0421\u044f\u0441\u0442\u0440\u0430, \u043f\u0440\u0430 \u0448\u0442\u043e \u0442\u044b \u043a\u0430\u0436\u0430\u0448? \u041d\u0456 \u045e \u044f\u043a\u0456\u043c \u0440\u0430\u0437\u0435 \u043d\u0435 \u043c\u0430\u0433\u0443 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043f\u0430-\u0437\u0430 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430\u044f \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u043f\u0430\u0447\u0443\u043b\u0430 \u0430\u0434\u043c\u043e\u0432\u0443 \u0431\u0440\u0430\u0442\u0430, \u0430\u0431\u0430\u043f\u0435\u0440\u043b\u0430 \u043d\u0430 \u0441\u0442\u0430\u043b\u0435 \u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b\u044f \u0440\u0443\u043a\u0456 \u0456, \u0441\u0445\u0456\u043b\u0456\u045e\u0448\u044b \u0433\u0430\u043b\u0430\u0432\u0443, \u043f\u0430\u0447\u0430\u043b\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0434\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u045e\u0437\u043d\u044f\u043b\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u0430\u0434 \u0441\u0442\u0430\u043b\u0430, \u0443\u0437\u043d\u044f\u043b\u0430\u0441\u044f \u0442\u0430\u043a\u0430\u044f \u043c\u043e\u0446\u043d\u0430\u044f \u043d\u0430\u0432\u0430\u043b\u044c\u043d\u0456\u0446\u0430, \u0431\u0443\u0440\u0430 \u0456 \u0437\u0430\u043b\u0435\u0432\u0430, \u0448\u0442\u043e \u043d\u0456 \u0432\u044f\u043b\u0435\u0431\u043d\u044b \u0411\u044d\u043d\u044d\u0434\u044b\u043a\u0442, \u043d\u0456 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u044b\u044f \u0437 \u0456\u043c \u0431\u0440\u0430\u0442\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0456 \u043a\u0440\u043e\u043a\u0443 \u0437 \u043c\u0435\u0441\u0446\u0430, \u043d\u0430 \u044f\u043a\u0456\u043c \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b \u043c\u0443\u0436 \u0411\u043e\u0436\u044b \u043f\u0430\u0447\u0430\u045e \u043d\u0430\u0440\u0430\u043a\u0430\u0446\u044c: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0411\u043e\u0433 \u043f\u0440\u0430\u0431\u0430\u0447\u044b\u0446\u044c \u0442\u0430\u0431\u0435, \u0441\u044f\u0441\u0442\u0440\u0430. \u0428\u0442\u043e \u0442\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0430?&raquo; \u042f\u043d\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u042f \u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u0446\u044f\u0431\u0435, \u0430 \u0442\u044b \u043d\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0446\u044c \u043c\u044f\u043d\u0435, \u0442\u0430\u0434\u044b \u044f \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u043c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0456 \u0401\u043d \u043f\u0430\u0447\u0443\u045e \u043c\u044f\u043d\u0435. \u0422\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u0456\u0434\u0437\u0456, \u043a\u0430\u043b\u0456 \u043c\u043e\u0436\u0430\u0448, \u043f\u0430\u043a\u0456\u043d\u044c \u043c\u044f\u043d\u0435 \u0456 \u0432\u044f\u0440\u043d\u0456\u0441\u044f \u045e \u043a\u043b\u044f\u0448\u0442\u0430\u0440&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430, \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u0432\u043e\u043b\u0456 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u0456 \u045e\u0441\u044e \u043d\u043e\u0447 \u043f\u0440\u0430\u0432\u044f\u043b\u0456 \u045e \u0447\u0443\u0432\u0430\u043d\u043d\u0456, \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0441\u044f\u0431\u0435 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0440\u0430\u0437\u043c\u043e\u0432\u0430\u043c\u0456 \u043f\u0440\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0434\u0437\u0456\u045e\u043d\u0430, \u0448\u0442\u043e \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0430 \u044f\u0433\u043e, \u0431\u043e, \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u042f\u043d: &laquo;\u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u043b\u044e\u0431\u043e\u045e&raquo;, \u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0437\u043c\u0430\u0433\u043b\u0430 \u0431\u043e\u043b\u044c\u0448 \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0442\u0440\u044b \u0434\u043d\u0456 \u043c\u0443\u0436 \u0411\u043e\u0436\u044b, \u0441\u0435\u0434\u0437\u044f\u0447\u044b \u045e \u043a\u0435\u043b\u043b\u0456, \u043f\u0430\u0434\u043d\u044f\u045e \u0432\u043e\u0447\u044b \u045e \u043d\u0435\u0431\u0430, \u0443\u0431\u0430\u0447\u044b\u045e, \u0448\u0442\u043e \u0434\u0443\u0448\u0430 \u044f\u0433\u043e\u043d\u0430\u0439 \u0441\u044f\u0441\u0442\u0440\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0430 \u0446\u0435\u043b\u0430 \u0456 \u045e \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0433\u043e\u043b\u0443\u0431\u0430 \u043f\u0430\u043b\u044f\u0446\u0435\u043b\u0430 \u045e \u043d\u0435\u0431\u0430. \u0420\u0430\u0434\u0443\u044e\u0447\u044b\u0441\u044f \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0441\u043b\u0430\u0432\u0435, \u0451\u043d \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u0432\u0430\u045e \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0443 \u0433\u0456\u043c\u043d\u0430\u043c\u0456 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0431\u0440\u0430\u0442\u043e\u045e, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u044f\u0435 \u0446\u0435\u043b\u0430 \u045e \u043a\u043b\u044f\u0448\u0442\u0430\u0440 \u0456 \u043f\u0430\u043a\u043b\u0430\u043b\u0456 \u045e \u0442\u0440\u0443\u043d\u0435, \u044f\u043a\u0443\u044e \u0451\u043d \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u0441\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u043d\u0430\u0432\u0430\u0442 \u043c\u0430\u0433\u0456\u043b\u0430 \u043d\u0435 \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u0456\u043b\u0430 \u0442\u044b\u0445, \u0447\u044b\u0435 \u0441\u044d\u0440\u0446\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0443 \u0411\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 133 (132), 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0431\u0440\u0430\u0442 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u045e \u044f\u0435,<span style=\"color: #ff0000;\"> *<\/span> \u044f\u043d\u0430 \u0431\u043e\u043b\u044c\u0448 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0430\u0434 \u041f\u0430\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043a \u0436\u0430 \u0434\u043e\u0431\u0440\u0430 \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430, \u043a\u0430\u043b\u0456 \u0431\u0440\u0430\u0442\u044b \u0436\u044b\u0432\u0443\u0446\u044c \u0440\u0430\u0437\u0430\u043c!<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043d\u0430 \u0431\u043e\u043b\u044c\u0448 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0430\u0434 \u041f\u0430\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"641","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041c\u0430\u0440\u044b\u0456 \u0411\u044d\u0440\u043d\u0430\u0434\u044d\u0442\u044b \u0421\u0443\u0431\u0456\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. Ad P. Gondrand, a. 1861: \u043f\u0430\u0440. A. Ravier, Les &eacute;crits <\/span><br \/><span style=\"color: #ff0000;\">de sainte Bernadette, Paris 1961, pp. 53-59)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u043d\u043d\u0430 \u0437\u0430\u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0430 \u0441\u0430 \u043c\u043d\u043e\u0439<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043f\u044d\u045e\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u0437\u0431\u0456\u0440\u0430\u044e\u0447\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0434\u0437\u0432\u044e\u043c\u0430 \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0433\u0430\u043b\u043b\u0451 \u043d\u0430 \u0431\u0435\u0440\u0430\u0437\u0435 \u0440\u0430\u043a\u0456 \u0413\u0430\u0432\u044b, \u044f \u043f\u0430\u0447\u0443\u043b\u0430 \u043d\u0435\u0439\u043a\u0456 \u0448\u044d\u043b\u0435\u0441\u0442. \u042f \u043f\u0430\u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u045e \u0431\u043e\u043a \u043b\u0443\u0433\u0430, \u0430\u043b\u0435 \u0434\u0440\u044d\u0432\u044b \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u0432\u0430\u0440\u0443\u0448\u044b\u043b\u0456\u0441\u044f. \u0422\u0430\u0434\u044b \u044f \u043f\u0430\u0434\u043d\u044f\u043b\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0430 \u043d\u0430 \u0433\u0440\u043e\u0442. \u0406 \u045e\u0431\u0430\u0447\u044b\u043b\u0430 \u041f\u0430\u043d\u043d\u0443, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u0443\u044e \u045e \u0431\u0435\u043b\u044b\u044f \u0448\u0430\u0442\u044b. \u042f\u043d\u0430 \u0431\u044b\u043b\u0430 \u045e \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u0430-\u0431\u0435\u043b\u044b\u043c \u0430\u0434\u0437\u0435\u043d\u043d\u0456, \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u043d\u0430\u044f \u0431\u043b\u0430\u043a\u0456\u0442\u043d\u044b\u043c \u043f\u0430\u0441\u0430\u043c, \u0430 \u043d\u0430 \u0430\u0431\u0435\u0434\u0437\u0432\u044e\u0445 \u0441\u0442\u0443\u043f\u043d\u044f\u0445 \u043c\u0435\u043b\u0430 \u0431\u0443\u0440\u0448\u0442\u044b\u043d\u0430\u0432\u044b\u044f \u0440\u0443\u0436\u044b \u0442\u0430\u043a\u043e\u0433\u0430 \u0436 \u043a\u043e\u043b\u0435\u0440\u0443, \u044f\u043a \u042f\u0435 \u0440\u0443\u0436\u0430\u043d\u0435\u0446.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u042f\u0435, \u044f \u043f\u0430\u0446\u0435\u0440\u043b\u0430 \u0432\u043e\u0447\u044b, \u0434\u0443\u043c\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u043c\u043d\u0435 \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u0456 \u0437\u0430\u0441\u0443\u043d\u0443\u043b\u0430 \u0440\u0443\u043a\u0443 \u045e \u043a\u0456\u0448\u044d\u043d\u044e, \u0434\u0437\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u0441\u0432\u043e\u0439 \u0440\u0443\u0436\u0430\u043d\u0435\u0446. \u0425\u0430\u0446\u0435\u043b\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0437\u043d\u0430\u043a \u043a\u0440\u044b\u0436\u0430, \u0430\u043b\u0435 \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u043d\u0430\u0432\u0430\u0442 \u043f\u0430\u0434\u043d\u044f\u0446\u044c \u0440\u0443\u043a\u0456, \u0431\u043e \u044f\u043d\u0430 \u0430\u043f\u0430\u0434\u0430\u043b\u0430. \u041a\u0430\u043b\u0456 \u0436 \u0442\u0430\u044f \u041f\u0430\u043d\u043d\u0430 \u0437\u0440\u0430\u0431\u0456\u043b\u0430 \u0437\u043d\u0430\u043a \u043a\u0440\u044b\u0436\u0430, \u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0445\u043e\u0446\u044c \u0456 \u0434\u0440\u044b\u0433\u043e\u0442\u043a\u0430\u0439 \u0440\u0443\u043a\u043e\u0439, \u043f\u0430\u0441\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043b\u0430 \u0456 \u0442\u0430\u0434\u044b \u0437\u043c\u0430\u0433\u043b\u0430. \u042f \u043f\u0430\u0447\u0430\u043b\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0440\u0443\u0436\u0430\u043d\u0435\u0446, \u0456 \u041f\u0430\u043d\u043d\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0435\u0440\u0430\u0431\u0456\u0440\u0430\u043b\u0430 \u043f\u0430\u0446\u0435\u0440\u043a\u0456 \u0440\u0443\u0436\u0430\u043d\u0446\u0430, \u0430\u0434\u043d\u0430\u043a \u042f\u0435 \u0432\u0443\u0441\u043d\u044b \u043d\u0435 \u0432\u0430\u0440\u0443\u0448\u044b\u043b\u0456\u0441\u044f. \u041a\u0430\u043b\u0456 \u044f \u0441\u043a\u043e\u043d\u0447\u044b\u043b\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0440\u0443\u0436\u0430\u043d\u0435\u0446, \u0431\u0430\u0447\u0430\u043d\u043d\u0435 \u0430\u0434\u0440\u0430\u0437\u0443 \u0437\u043d\u0456\u043a\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u044f \u0441\u043f\u044b\u0442\u0430\u043b\u0430\u0441\u044f \u045e \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u0430\u043a, \u0446\u0456 \u0431\u0430\u0447\u044b\u043b\u0456 \u044f\u043d\u044b \u0448\u0442\u043e\u0441\u044c\u0446\u0456, \u0430\u043b\u0435 \u044f\u043d\u044b \u0437\u0430\u043f\u044f\u0440\u044d\u0447\u044b\u043b\u0456 \u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043f\u044b\u0442\u0430\u043b\u0456\u0441\u044f, \u0448\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u043b\u0430 \u044f. \u042f \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u0456\u043c, \u0448\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u043b\u0430 \u043d\u0435\u0439\u043a\u0443\u044e \u041f\u0430\u043d\u043d\u0443 \u045e \u0431\u0435\u043b\u044b\u0445 \u0448\u0430\u0442\u0430\u0445, \u0430\u043b\u0435 \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0445\u0442\u043e \u042f\u043d\u0430, \u0456 \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u043b\u0430, \u043a\u0430\u0431 \u043d\u0456\u043a\u043e\u043c\u0443 \u043d\u0435 \u043a\u0430\u0437\u0430\u043b\u0456. \u042f\u043d\u044b \u045e\u0433\u0430\u0432\u043e\u0440\u0432\u0430\u043b\u0456 \u043c\u044f\u043d\u0435 \u043d\u0435 \u0432\u044f\u0440\u0442\u0430\u0446\u0446\u0430 \u0442\u0443\u0434\u044b, \u0430\u043b\u0435 \u044f \u043d\u0435 \u0437\u0433\u0430\u0434\u0436\u0430\u043b\u0430\u0441\u044f \u0456, \u0443\u0440\u044d\u0448\u0446\u0435, \u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0442\u0443\u0434\u044b \u045e \u043d\u044f\u0434\u0437\u0435\u043b\u044e, \u0431\u043e \u0430\u0434\u0447\u0443\u0432\u0430\u043b\u0430, \u044f\u043a \u043d\u0435\u0448\u0442\u0430 \u043c\u044f\u043d\u0435 \u0442\u0443\u0434\u044b \u043a\u043b\u0456\u0447\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u044f \u041f\u0430\u043d\u043d\u0430 \u0437\u0430\u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0430 \u0441\u0430 \u043c\u043d\u043e\u0439 \u043d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0440\u0430\u0437 \u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u043c\u043d\u0435, \u043a\u0430\u0431 \u044f \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0441\u044e\u0434\u044b \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u043f\u044f\u0442\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u0434\u0437\u0451\u043d, \u0456 \u044f \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0437\u0433\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f. \u0414\u0430\u0440\u0443\u0447\u044b\u043b\u0430 \u043c\u043d\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0456\u043c \u043f\u0430\u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u0430\u0431 \u043f\u0430\u0431\u0443\u0434\u043e\u0432\u0435 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043a\u0430\u043f\u043b\u0456\u0446\u044b. \u041f\u0430\u0441\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u043c\u043d\u0435 \u043f\u0430\u043f\u0456\u0446\u044c \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u044b. \u041d\u0435 \u045e\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u043d\u0456\u044f\u043a\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u044f \u043f\u0430\u0439\u0448\u043b\u0430 \u0434\u0430 \u0440\u0430\u043a\u0456 \u0413\u0430\u0432\u044b, \u0430\u043b\u0435 \u041f\u0430\u043d\u043d\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u043b\u0430, \u0448\u0442\u043e \u043d\u0435 \u0433\u044d\u0442\u0430 \u043c\u0430\u0435 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0456 \u045e\u043a\u0430\u0437\u0430\u043b\u0430 \u043f\u0430\u043b\u044c\u0446\u0430\u043c \u043d\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0443. \u041a\u0430\u043b\u0456 \u044f \u043f\u0430\u0434\u044b\u0448\u043b\u0430 \u0434\u0430 \u044f\u0435, \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u0442\u0430\u043c \u0442\u043e\u043b\u044c\u043a\u0456 \u043a\u0440\u044b\u0445\u0443 \u0431\u0430\u043b\u043e\u0446\u0456\u0441\u0442\u0430\u0439 \u0432\u0430\u0434\u044b. \u042f \u0430\u0434\u0441\u0443\u043d\u0443\u043b\u0430 \u0440\u0443\u043a\u043e\u0439 \u0442\u0440\u043e\u0445\u0456 \u0433\u043b\u0435\u044e, \u0430\u043b\u0435 \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u0437\u0430\u0447\u0430\u0440\u043f\u043d\u0443\u0446\u044c \u0456 \u0442\u0440\u043e\u0439\u0447\u044b \u0440\u0430\u0431\u0456\u043b\u0430 \u0433\u044d\u0442\u0430\u043a, \u043f\u0430\u043a\u0443\u043b\u044c \u0437\u043c\u0430\u0433\u043b\u0430 \u043f\u0430\u043f\u0456\u0446\u044c. \u041f\u0430\u0441\u043b\u044f \u0431\u0430\u0447\u0430\u043d\u043d\u0435 \u0437\u043d\u0456\u043a\u043b\u0430, \u0456 \u044f \u0430\u0434\u044b\u0448\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0432\u044f\u0440\u0442\u0430\u043b\u0430\u0441\u044f \u0442\u0443\u0434\u044b \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u043f\u044f\u0442\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u0434\u0437\u0451\u043d, \u0456 \u041f\u0430\u043d\u043d\u0430 \u0448\u0442\u043e\u0434\u043d\u044f \u0437&rsquo;\u044f\u045e\u043b\u044f\u043b\u0430\u0441\u044f \u043c\u043d\u0435, \u0430\u043a\u0440\u0430\u043c\u044f \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0430\u043d\u044f\u0434\u0437\u0435\u043b\u043a\u0430 \u0456 \u043f\u044f\u0442\u043d\u0456\u0446\u044b. \u041f\u0430\u043d\u043d\u0430 \u0437\u043d\u043e\u045e \u043a\u0430\u0437\u0430\u043b\u0430, \u043a\u0430\u0431 \u044f \u043f\u0430\u0440\u0430\u0456\u043b\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c \u0442\u0443\u0442 \u043a\u0430\u043f\u043b\u0456\u0446\u0443, \u043a\u0430\u0431 \u043f\u0430\u0439\u0448\u043b\u0430 \u0434\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0456 \u0430\u0431\u043c\u044b\u043b\u0430\u0441\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u0431 \u0443\u0441\u0435 \u043c\u0430\u043b\u0456\u043b\u0456\u0441\u044f \u0430\u0431 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e. \u042f \u0447\u0430\u0441\u0442\u0430 \u043f\u044b\u0442\u0430\u043b\u0430\u0441\u044f \u045e \u042f\u0435, \u0445\u0442\u043e \u042f\u043d\u0430, \u0430\u043b\u0435 \u042f\u043d\u0430 \u043b\u0430\u0433\u043e\u0434\u043d\u0430 \u045e\u0441\u043c\u0456\u0445\u0430\u043b\u0430\u0441\u044f, \u043f\u0430\u043a\u0443\u043b\u044c, \u043f\u0430\u0434\u043d\u044f\u045e\u0448\u044b \u0440\u0443\u043a\u0456 \u0456 \u0432\u043e\u0447\u044b \u0434\u0430 \u043d\u0435\u0431\u0430, \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043b\u0430, \u0448\u0442\u043e \u042f\u043d\u0430 &ndash; \u0411\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u0417\u0430\u0447\u0430\u0446\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0433\u044d\u0442\u044b\u0445 \u043f\u044f\u0442\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u0434\u0437\u0451\u043d \u0434\u0430\u0432\u0435\u0440\u044b\u043b\u0430 \u043c\u043d\u0435 \u0442\u0440\u044b \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u044e\u0447\u044b \u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u0456\u0445 \u043a\u0430\u043c\u0443-\u043d\u0435\u0431\u0443\u0434\u0437\u044c; \u0456 \u044f \u0432\u0435\u0440\u043d\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0430 \u0433\u044d\u0442\u0430 \u0434\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0447\u0430\u0441\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 1, 46b. 49. 48b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0435\u043b\u0456\u0447\u0430\u0435 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u041f\u0430\u043d\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u043c\u043d\u0435 \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u0430 \u0456\u043c\u044f \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0426\u044f\u043f\u0435\u0440 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u041c\u044f\u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0441\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u043c\u043d\u0435 \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u0430 \u0456\u043c\u044f \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"642","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0416\u044b\u0446\u0446\u0451 \u041a\u0430\u043d\u0441\u0442\u0430\u043d\u0446\u0456\u043d\u0430&raquo;, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u0435 \u043d\u0430 \u0441\u043b\u0430\u0432\u044f\u043d\u0441\u043a\u0430\u0439 \u043c\u043e\u0432\u0435<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap.18: Denkschriften der kaiserl. Akademie <\/span><br \/><span style=\"color: #ff0000;\">der Wissenschaften, 19, Wien 1970, p. 246)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u0432\u044f\u043b\u0456\u0447 \u041a\u0430\u0441\u0446\u0451\u043b \u0441\u0432\u043e\u0439 \u0456 \u0437&rsquo;\u044f\u0434\u043d\u0430\u0439 \u0443\u0441\u0456\u0445<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043d\u0441\u0442\u0430\u043d\u0446\u0456\u043d \u041a\u0456\u0440\u044b\u043b, \u0437\u043c\u0443\u0447\u0430\u043d\u044b \u043c\u043d\u043e\u0433\u0456\u043c\u0456 \u043f\u0440\u0430\u0446\u0430\u043c\u0456, \u0437\u0430\u0445\u0432\u0430\u0440\u044d\u045e \u0456, \u043f\u0430\u043a\u0443\u0442\u0443\u044e\u0447\u044b \u0430\u0434 \u0445\u0432\u0430\u0440\u043e\u0431\u044b \u0448\u043c\u0430\u0442 \u0434\u0437\u0451\u043d, \u0443\u0431\u0430\u0447\u044b\u045e \u043f\u044d\u045e\u043d\u0430\u0435 \u0431\u0430\u0447\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0435 \u0456 \u043f\u0430\u0447\u0430\u045e \u0442\u0430\u043a \u0441\u043f\u044f\u0432\u0430\u0446\u044c: &laquo;\u0423\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0434\u0443\u0445 \u043c\u043e\u0439 \u0456 \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u043b\u0456 \u043c\u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043b\u0456: \u041f\u043e\u0439\u0434\u0437\u0435\u043c \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u041f\u0430\u043d\u0430&raquo; (\u043f\u0430\u0440. \u041f\u0441 122 [121], 1).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0451\u043d \u0430\u043f\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u045e \u043c\u0430\u043d\u0430\u0441\u043a\u0430\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0456 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0442\u0430\u043a \u0446\u044d\u043b\u044b \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c, \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u0447\u0430\u0441\u0443 \u044f \u0441\u043b\u0443\u0433\u0430 \u043d\u0435 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0446\u0456 \u043d\u0435\u0439\u043a\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430. \u041c\u044f\u043d\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e, &ndash; \u0456 \u044f \u0441\u0442\u0430\u045e \u0456\u0441\u043d\u0430\u0432\u0430\u0446\u044c, \u0456 \u0431\u0443\u0434\u0443 \u0456\u0441\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d&raquo;. \u0423 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u043c\u0430\u043d\u0430\u0441\u043a\u0430\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435, \u0434\u0430\u0434\u0430\u045e \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u0430 \u0421\u0432\u044f\u0442\u043b\u0430 \u0456 \u045e\u0437\u044f\u045e \u0441\u0430\u0431\u0435 \u0456\u043c\u044f \u041a\u0456\u0440\u044b\u043b. \u0423 \u0433\u044d\u0442\u044b\u043c \u0430\u0434\u0437\u0435\u043d\u043d\u0456 \u043f\u0440\u0430\u0431\u044b\u045e \u0441\u043e\u0440\u0430\u043a \u0434\u0437\u0451\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u0433\u0430\u0434\u0437\u0456\u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u0430\u0434\u044b\u0441\u0446\u0456 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0443\u0437\u043d\u044f\u045e \u0440\u0443\u043a\u0456 \u0456 \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0436\u0443\u0447\u044b \u0441\u0430 \u0441\u043b\u044f\u0437\u044c\u043c\u0456:<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0430\u043d\u0435, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430, \u0422\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0435 \u0430\u043d\u0451\u043b\u044c\u0441\u043a\u0456\u044f \u0432\u043e\u0439\u0441\u043a\u0456 \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0441\u0456\u043b\u044b, \u0440\u0430\u0441\u043f\u0430\u0441\u0446\u0451\u0440 \u043d\u0435\u0431\u0430 \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0437\u044f\u043c\u043b\u044e, \u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0456\u0441\u043d\u0443\u0435, \u0437 \u043d\u0435\u0431\u044b\u0446\u0446\u044f \u043f\u0440\u044b\u0432\u0451\u045e \u0434\u0430 \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u044f. \u0422\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0447\u0443\u0435\u0448 \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0422\u0432\u0430\u044e \u0432\u043e\u043b\u044e, \u0448\u0430\u043d\u0443\u0435 \u0426\u044f\u0431\u0435 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0422\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043c\u0430\u044e \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u0439 \u0443 \u0432\u0435\u0440\u044b \u0422\u0432\u043e\u0439 \u0441\u0442\u0430\u0442\u0430\u043a, \u043d\u0430 \u0447\u0430\u043b\u0435 \u044f\u043a\u043e\u0433\u0430 \u0422\u044b \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043c\u044f\u043d\u0435, \u0422\u0432\u0430\u0439\u0433\u043e \u043d\u044f\u0432\u0430\u0440\u0442\u0430\u0433\u0430 \u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0433\u0430 \u0441\u043b\u0443\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u0437\u0432\u0430\u043b\u0456 \u0456\u0445 \u0430\u0434 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0439 \u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u0446\u043a\u0430\u0439 \u0437\u043b\u0430\u0441\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u044b\u0446\u044c \u043d\u0430 \u0426\u044f\u0431\u0435, \u043f\u0430\u0432\u044f\u043b\u0456\u0447 \u041a\u0430\u0441\u0446\u0451\u043b \u0441\u0432\u043e\u0439 \u0456 \u0437&rsquo;\u044f\u0434\u043d\u0430\u0439 \u0443\u0441\u0456\u0445. \u0423\u0447\u044b\u043d\u0456 \u0456\u0445 \u0441\u0432\u0430\u0456\u043c \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0437\u0433\u043e\u0434\u043d\u044b\u043c \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0456 \u0441\u043b\u0443\u0448\u043d\u0430\u0439 \u0432\u0435\u0440\u044b \u0422\u0432\u0430\u0451\u0439, \u0456 \u045e\u0434\u044b\u0445\u043d\u0456 \u045e \u0456\u0445\u043d\u0456\u044f \u0441\u044d\u0440\u0446\u044b \u0441\u043b\u043e\u0432\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u0443\u0447\u044d\u043d\u043d\u044f. \u0411\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0432\u0430\u0439\u043c\u0443 \u0434\u0430\u0440\u0443 \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0446\u044c \u0434\u0430 \u0434\u043e\u0431\u0440\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u045e \u0456\u043d\u0448\u044b\u0445 \u0456 \u0440\u0430\u0431\u0456\u0446\u044c \u0441\u0430\u043c\u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u0422\u0430\u0431\u0435. \u0422\u044b\u0445, \u043a\u0430\u0433\u043e \u0422\u044b \u043c\u043d\u0435 \u0434\u0430\u045e, \u0432\u044f\u0440\u0442\u0430\u044e \u0422\u0430\u0431\u0435 \u044f\u043a \u0422\u0432\u0430\u0456\u0445; \u043a\u0456\u0440\u0443\u0439 \u0456\u043c\u0456 \u0441\u0432\u0430\u0451\u0439 \u043c\u043e\u0446\u043d\u0430\u044e \u043f\u0440\u0430\u0432\u0456\u0446\u0430\u0439 \u0456 \u0430\u0442\u0443\u043b\u044f\u0439 \u0456\u0445 \u0441\u0432\u0430\u0456\u043c\u0456 \u043a\u0440\u044b\u043b\u0430\u043c\u0456, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0441\u043b\u0430\u0432\u0456\u043b\u0456 \u0456 \u0445\u0432\u0430\u043b\u0456\u043b\u0456 \u0422\u0432\u0430\u0451 \u0456\u043c\u044f &ndash; \u0410\u0439\u0446\u0430, \u0456 \u0421\u044b\u043d\u0430, \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u0410\u043c\u044d\u043d&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0446\u0430\u043b\u0430\u0432\u0430\u045e\u0448\u044b \u045e\u0441\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u043c \u043f\u0430\u0446\u0430\u043b\u0443\u043d\u043a\u0430\u043c, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u043d\u0435 \u0430\u0434\u0434\u0430\u045e \u043d\u0430\u0441 \u043d\u0430 \u0437\u0434\u0430\u0431\u044b\u0447\u0443 \u043d\u044f\u0431\u044f\u0447\u043d\u044b\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u043d\u0430\u0448\u044b\u0445, \u0430\u043b\u0435 \u0432\u044b\u0440\u0432\u0430\u045e \u0437 \u0456\u0445\u043d\u044f\u0439 \u0441\u0435\u0442\u043a\u0456 \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0430\u0434 \u0437\u0433\u0443\u0431\u044b&raquo;. \u0406 \u0442\u0430\u043a \u043d\u0430 \u0441\u043e\u0440\u0430\u043a \u0434\u0440\u0443\u0433\u0456\u043c \u0433\u043e\u0434\u0437\u0435 \u0430\u0434 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0451\u043d \u0441\u043f\u0430\u0447\u044b\u045e \u0443 \u041f\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u041f\u0430\u043f\u0430 \u0437\u0430\u0433\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0433\u0440\u044d\u043a\u0456, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u045e \u0420\u044b\u043c\u0435, \u0456 \u0440\u044b\u043c\u043b\u044f\u043d\u0435 \u0441\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435, \u043d\u0435\u0441\u0443\u0447\u044b \u0441\u0432\u0435\u0447\u043a\u0456 \u0456 \u0441\u043f\u044f\u0432\u0430\u044e\u0447\u044b \u043f\u0435\u0441\u043d\u0456, \u0456 \u045e\u0447\u044b\u043d\u0456\u043b\u0456 \u041a\u0430\u043d\u0441\u0442\u0430\u043d\u0446\u0456\u043d\u0443 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u0441\u0430\u043c\u043e\u043c\u0443 \u041f\u0430\u043f\u0443. \u0406 \u0442\u0430\u043a \u0431\u044b\u043b\u043e \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041f\u0441 89 (88), 20-22\u0430; \u0415\u0440 3, 15<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u045e \u0431\u0430\u0447\u0430\u043d\u043d\u0456 \u0422\u044b \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0456 \u043a\u0430\u0437\u0430\u045e: \u042f \u045e\u0437\u0432\u044b\u0441\u0456\u045e \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0433\u0430 \u0437 \u043d\u0430\u0440\u043e\u0434\u0443, <span style=\"color: #ff0000;\">*<\/span> \u042f \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u044f\u0433\u043e \u041c\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u044b\u043c \u0430\u043b\u0435\u0435\u043c, \u0440\u0443\u043a\u0430 \u043c\u043e\u0446\u044b \u041c\u0430\u0451\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u0437 \u0456\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0434\u0430\u043c \u0432\u0430\u043c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u0456 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0432\u0430\u0441 \u043c\u0443\u0434\u0440\u0430 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430. <span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u044f\u0433\u043e \u041c\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u044b\u043c \u0430\u043b\u0435\u0435\u043c, \u0440\u0443\u043a\u0430 \u043c\u043e\u0446\u044b \u041c\u0430\u0451\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u0437 \u0456\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"643","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0434\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u045e\u0437\u043d\u0456\u043a\u043d\u0435\u043d\u043d\u0435 \u0417\u0430\u043a\u043e\u043d\u0443 \u0421\u043b\u0443\u0433\u0430\u045e \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u041f\u0430\u043d\u043d\u044b \u041c\u0430\u0440\u044b\u0456<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Monumenta Ord. Serv. B. Mariae Virginis, <\/span><br \/><span style=\"color: #ff0000;\">1, 3. 5. 6. 9. 11, pp. 71 ss.)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043c \u0441\u043b\u0430\u045e\u043d\u044b\u0445 \u043c\u0443\u0436\u043e\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u044b\u043b\u043e \u0441\u0435\u043c \u043c\u0443\u0436\u043e\u045e, \u0432\u0430\u0440\u0442\u044b\u0445 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043f\u0430\u0432\u0430\u0433\u0456 \u0456 \u043f\u0430\u0448\u0430\u043d\u044b, \u044f\u043a\u0456\u0445 \u043d\u0430\u0448\u0430 \u041f\u0430\u043d\u043d\u0430 \u0441\u0430\u0431\u0440\u0430\u043b\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0441\u0435\u043c \u0437\u043e\u0440\u0430\u043a. \u0410\u0431&rsquo;\u044f\u0434\u043d\u0430\u045e\u0448\u044b \u0456\u0445 \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u044b, \u042f\u043d\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u0437\u0430\u043a\u043e\u043d \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f \u045e\u0441\u0442\u0443\u043f\u0456\u045e \u0443 \u043d\u0430\u0448 \u0437\u0430\u043a\u043e\u043d, \u043d\u0456\u0445\u0442\u043e \u0437 \u0456\u0445 \u0443\u0436\u043e \u043d\u0435 \u0436\u044b\u045e, \u0430\u043a\u0440\u0430\u043c\u044f \u0430\u0434\u043d\u0430\u0433\u043e \u0431\u0440\u0430\u0442\u0430, \u044f\u043a\u043e\u0433\u0430 \u0437\u0432\u0430\u043b\u0456 \u0410\u043b\u044f\u043a\u0441\u0435\u0435\u043c. \u0421\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u043d\u0430\u0448\u0430\u0439 \u041f\u0430\u043d\u043d\u0435 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u0430\u0434 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456 \u0430\u0436 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0447\u0430\u0441\u0443, \u043a\u0430\u0431 \u0451\u043d \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u043c \u043f\u0440\u0430 \u0432\u044b\u0442\u043e\u043a\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0430\u043a\u043e\u043d\u0443. \u042f\u043a \u044f \u043d\u0430 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u045e\u0441\u044f, \u0436\u044b\u0446\u0446\u0451 \u0437\u0433\u0430\u0434\u0430\u043d\u0430\u0433\u0430 \u0431\u0440\u0430\u0442\u0430 \u0410\u043b\u044f\u043a\u0441\u0435\u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b\u0432\u0430\u0431\u043b\u0456\u0432\u0430\u043b\u0430 \u0441\u0432\u0430\u0456\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c, \u0430\u043b\u0435 \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044e \u044f\u0433\u043e \u0456 \u0431\u0440\u0430\u0442\u043e\u045e \u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0430 \u043f\u0440\u0430 \u0433\u043b\u044b\u0431\u043e\u043a\u0443\u044e \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0406\u0445 \u0436\u044b\u0446\u0446\u0451, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u044f\u043d\u044b \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u043b\u0456\u0441\u044f \u045e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c, \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043b\u0430\u0441\u044f \u0447\u0430\u0442\u044b\u0440\u043c\u0430 \u0430\u043a\u0430\u043b\u0456\u0447\u043d\u0430\u0441\u0446\u044f\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430-\u043f\u0435\u0440\u0448\u0430\u0435, \u0456\u0445 \u0430\u0434\u043d\u043e\u0441\u0456\u043d\u044b \u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0410\u0434\u043d\u044b \u0431\u044b\u043b\u0456 \u043d\u0435\u0436\u0430\u043d\u0430\u0442\u044b\u044f, \u0431\u043e \u0432\u044b\u0440\u0430\u0448\u044b\u043b\u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c. \u0414\u0440\u0443\u0433\u0456\u044f \u045e\u0436\u043e \u0431\u044b\u043b\u0456 \u0436\u0430\u043d\u0430\u0442\u044b\u044f, \u0456\u043d\u0448\u044b\u044f &ndash; \u0443\u0434\u0430\u045e\u0446\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430-\u0434\u0440\u0443\u0433\u043e\u0435, \u0456\u0445 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u043a\u0430\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u044c. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u0444\u0435\u0441\u0456\u0456 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u043a\u0443\u043f\u0446\u0430\u043c\u0456 \u0456 \u0433\u0430\u043d\u0434\u043b\u044f\u0440\u0430\u043c\u0456 \u0437\u044f\u043c\u043d\u044b\u043c \u0434\u0430\u0431\u0440\u043e\u043c. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0443\u044e \u043f\u044f\u0440\u043b\u0456\u043d\u0443, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043d\u0430\u0448 \u0437\u0430\u043a\u043e\u043d, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437\u0434\u0430\u043b\u0456 \u0431\u0435\u0434\u043d\u044b\u043c \u0443\u0441\u0451, \u0448\u0442\u043e \u043c\u0435\u043b\u0456, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u043b\u0456 \u0441\u044f\u0431\u0435 \u0432\u0435\u0440\u043d\u0430\u043c\u0443 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044e \u0411\u043e\u0433\u0443 \u0456 \u041f\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430-\u0442\u0440\u044d\u0446\u044f\u0435, \u0433\u044d\u0442\u0430 \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u044f \u043f\u0430\u0448\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0439 \u041f\u0430\u043d\u043d\u044b. \u0423 \u0424\u043b\u0430\u0440\u044d\u043d\u0446\u044b\u0456 \u0437 \u0432\u0435\u043b\u044c\u043c\u0456 \u0434\u0430\u045e\u043d\u0456\u0445 \u0447\u0430\u0441\u043e\u045e \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0430 \u043f\u044d\u045e\u043d\u0430\u0435 \u0442\u0430\u0432\u0430\u0440\u044b\u0441\u0442\u0432\u0430, \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u0435 \u045e \u0433\u043e\u043d\u0430\u0440 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456. \u0421\u0432\u0430\u0451\u0439 \u0434\u0430\u045e\u043d\u0430\u0441\u0446\u044e \u0456 \u043c\u043d\u043e\u0441\u0442\u0432\u0430\u043c \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u045e, \u043c\u0443\u0436\u0447\u044b\u043d \u0456 \u0436\u0430\u043d\u0447\u044b\u043d, \u044f\u043d\u043e \u0432\u044b\u043b\u0443\u0447\u0430\u043b\u0430\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u0456\u043d\u0448\u044b\u0445 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044f\u045e, \u0442\u0430\u043c\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0443\u044e \u043d\u0430\u0437\u0432\u0443 &laquo;\u0411\u043e\u043b\u044c\u0448\u0430\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u0439 \u041f\u0430\u043d\u043d\u044b&raquo;. \u0414\u0430 \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u044f \u045e \u0433\u044d\u0442\u0430\u0435 \u0442\u0430\u0432\u0430\u0440\u044b\u0441\u0442\u0432\u0430 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0456 \u0437\u0433\u0430\u0434\u0430\u043d\u044b\u044f \u0441\u044f\u043c\u0451\u0440\u0430 \u043c\u0443\u0436\u043e\u045e, \u044f\u043a\u0456\u044f \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u043b\u0456 \u043d\u0430\u0448\u0443\u044e \u041f\u0430\u043d\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430-\u0447\u0430\u0446\u0432\u0451\u0440\u0442\u0430\u0435, \u0456\u0445 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c. \u042f\u043d\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0411\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0451, \u0434\u0430 \u042f\u0433\u043e \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u043b\u0456 \u045e \u043d\u0430\u043b\u0435\u0436\u043d\u044b\u043c \u043f\u0430\u0440\u0430\u0434\u043a\u0443 \u045e\u0441\u0435 \u0441\u0432\u0430\u0435 \u043f\u0430\u0447\u044b\u043d\u0430\u043d\u043d\u0456, \u042f\u043c\u0443 \u0430\u0434\u0434\u0430\u0432\u0430\u043b\u0456 \u043f\u0430\u0448\u0430\u043d\u0443 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0434\u0443\u043c\u043a\u0430\u0445, \u0441\u043b\u043e\u0432\u0430\u0445 \u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0437 \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u044f \u044f\u043d\u044b \u0446\u0432\u0451\u0440\u0434\u0430 \u0432\u044b\u0440\u0430\u0448\u044b\u043b\u0456 \u043f\u0430\u0447\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u045e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u043d\u0430\u0448\u0430 \u041f\u0430\u043d\u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u043b\u0430 \u0456\u043c \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0434\u0430\u043c\u0430\u043c\u0456 \u0456 \u0441\u0435\u043c&rsquo;\u044f\u043c\u0456. \u0421\u0432\u0430\u0456\u0445 \u0431\u043b\u0456\u0437\u043a\u0456\u0445 \u044f\u043d\u044b \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u044b\u043b\u0456 \u045e\u0441\u0456\u043c \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u043c, \u0430 \u0456\u043d\u0448\u0430\u0435 &ndash; \u0440\u0430\u0437\u0434\u0430\u043b\u0456 \u0431\u0435\u0434\u043d\u044b\u043c. \u0423\u0440\u044d\u0448\u0446\u0435, \u044f\u043d\u044b \u0437\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u043c\u0443\u0434\u0440\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d \u0456 \u0430\u0434\u043a\u0440\u044b\u043b\u0456 \u0456\u043c \u0441\u0432\u043e\u0439 \u043d\u0430\u043c\u0435\u0440.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u043e\u0442\u044b\u043c \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u043b\u0456\u0441\u044f \u043d\u0430 \u045e\u0437\u0433\u043e\u0440&rsquo;\u0435 \u0421\u044d\u043d\u0430\u0440\u044b\u0451 \u0456 \u043d\u0430 \u0456\u043c \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0434\u043e\u043c\u0456\u043a, \u0443 \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u0441\u044f\u043b\u0456\u043b\u0456\u0441\u044f. \u0422\u0430\u043c \u043f\u0430\u0447\u0430\u043b\u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0448\u0442\u043e \u044f\u043d\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0456 \u043a\u0430\u0431 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u0456\u043d\u0448\u044b\u0445 \u0456 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u044b\u0446\u044c \u0437\u0430\u043a\u043e\u043d, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u044b \u043d\u0430\u0448\u0430\u0439 \u041f\u0430\u043d\u043d\u0430\u0439 \u043f\u0440\u0430\u0437 \u0456\u0445 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430. \u0417 \u0442\u0430\u043a\u0456\u043c \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0434\u0430 \u0441\u044f\u0431\u0435 \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u043d\u043e\u0432\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0456 \u0442\u0430\u043a \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043b\u0456 \u043d\u0430\u0448 \u0437\u0430\u043a\u043e\u043d. \u0423 \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443 \u0451\u043d \u0431\u044b\u045e \u0443\u0437\u0432\u0435\u0434\u0437\u0435\u043d\u044b \u043d\u0430\u0448\u0430\u0439 \u041f\u0430\u043d\u043d\u0430\u0439, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u043f\u0430\u043a\u043e\u0440\u044b \u043d\u0430\u0448\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e, \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u0456\u0445 \u0437\u0433\u043e\u0434\u0430\u0439, \u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u045e\u0431\u043e\u0441\u0442\u0432\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0437 4, 32; 2, 46b-47a<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0435 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u0431\u044b\u043b\u0456 \u0430\u0434\u0437\u0456\u043d\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0434\u0443\u0448\u043e\u044e, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u045e \u0443\u043b\u0430\u0441\u043d\u044b\u043c \u043d\u0456\u0447\u043e\u0433\u0430 \u0437 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439, \u044f\u043a\u0430\u044f \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u044f\u043c\u0443, \u0430\u043b\u0435 \u045e\u0441\u0451 \u045e \u0456\u0445 \u0431\u044b\u043b\u043e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u0430\u0436\u044b\u0432\u0430\u043b\u0456 \u0435\u0436\u0443 \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u0441\u0442\u0430\u0446\u0435 \u0441\u044d\u0440\u0446\u0430, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u0411\u043e\u0433\u0430 \u0456 \u043c\u0430\u044e\u0447\u044b \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0443\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u045e \u0443\u043b\u0430\u0441\u043d\u044b\u043c \u043d\u0456\u0447\u043e\u0433\u0430 \u0437 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439, \u044f\u043a\u0430\u044f \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u044f\u043c\u0443, \u0430\u043b\u0435 \u045e\u0441\u0451 \u045e \u0456\u0445 \u0431\u044b\u043b\u043e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"644","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u0414\u0430\u043c&rsquo;\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 8, 6: PL 144, 473-476)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0417 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0447\u0430\u043a\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0443\u0442\u043a\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u0442\u044b \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u045e \u043c\u044f\u043d\u0435, \u043a\u0430\u0431 \u044f \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0442\u0430\u0431\u0435 \u045e \u043b\u0456\u0441\u0446\u0435 \u043f\u0430\u0440\u0443 \u0441\u043b\u043e\u045e \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f \u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u044b\u043c\u0456 \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u044f\u043c\u0456 \u0437\u043b\u0430\u0433\u043e\u0434\u0437\u0456\u045e \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u0433\u043e\u0440\u044b\u0447 \u0441\u044f\u0440\u043e\u0434 \u0441\u0442\u043e\u043b\u044c\u043a\u0456\u0445 \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u0442\u0432\u0430\u0439\u0433\u043e \u0434\u0443\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u043a\u0430\u043b\u0456 \u0442\u0432\u043e\u0439 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b \u0440\u043e\u0437\u0443\u043c \u043d\u0435 \u0437\u0430\u0441\u043d\u0443\u045e, \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u043d\u0430\u043f\u0430\u0433\u0430\u0442\u043e\u0432\u0435, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0441\u0430\u043c\u0456 \u0441\u043b\u043e\u0432\u044b \u041f\u0456\u0441\u0430\u043d\u043d\u044f \u0431\u0435\u0437 \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u044f \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0434\u043b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u0411\u043e\u0433 \u0432\u0443\u0447\u044b\u0446\u044c \u0446\u044f\u0431\u0435 \u044f\u043a \u0441\u044b\u043d\u0430. \u0425\u0456\u0431\u0430 \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u043a\u0440\u044b\u0442\u0430: &laquo;\u0421\u044b\u043d\u0435, \u043f\u0430\u0434\u044b\u0434\u0437\u0456 \u0434\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0411\u043e\u0433\u0443, \u0441\u0442\u0430\u043d\u044c \u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u0442\u0440\u0430\u0445\u0443 \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439 \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443 \u0434\u0430 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f?&raquo; (\u043f\u0430\u0440. \u0421\u0456\u0440 2, 1-2).<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435 \u0451\u0441\u0446\u044c \u0441\u0442\u0440\u0430\u0445 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0442\u0430\u043c \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435 \u045e\u0441\u044f\u043a\u0430\u0439 \u043d\u044f\u0434\u043e\u043b\u044f\u0439 \u043d\u0435 \u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u0440\u0430\u0431\u0441\u043a\u0456\u043c \u043a\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435\u043c, \u0430\u043b\u0435 \u0445\u0443\u0442\u0447\u044d\u0439 &ndash; \u0431\u0430\u0446\u044c\u043a\u043e\u045e\u0441\u043a\u0456\u043c \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0456 \u0448\u0447\u0430\u0441\u043d\u044b \u0401\u045e \u043f\u0430\u0434 \u0441\u0442\u043e\u043b\u044c\u043a\u0456\u043c\u0456 \u045e\u0434\u0430\u0440\u0430\u043c\u0456 \u043d\u044f\u0434\u043e\u043b\u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0447\u0430\u045e \u0433\u044d\u0442\u0430, \u0440\u0430\u0441\u0442\u0440\u0443\u0448\u0447\u044b\u0446\u044c \u043c\u044f\u043d\u0435 \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c&raquo;. \u0406 \u0430\u0434\u0440\u0430\u0437\u0443 \u0434\u0430\u0434\u0430\u0432\u0430\u045e: &laquo;\u0406 \u0433\u044d\u0442\u0430 \u043c\u044f\u043d\u0435 \u0441\u0443\u0446\u044f\u0448\u0430\u0435, \u0448\u0442\u043e \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u043f\u0430\u043a\u0443\u0442\u0430\u043c\u0456, \u043d\u0435 \u0448\u043a\u0430\u0434\u0443\u0435 \u043c\u044f\u043d\u0435&raquo; (\u043f\u0430\u0440. \u0401\u045e 6, 10).<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043b\u044f \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0411\u043e\u0433\u0430\u043c \u0441\u0430\u043c\u0430 \u043d\u044f\u0434\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f &ndash; \u0433\u044d\u0442\u0430 \u045e\u0436\u043e \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u045e \u0447\u0430\u0441\u043e\u0432\u044b\u0445 \u043f\u0430\u043a\u0443\u0442\u0430\u0445, \u044f\u043a\u0456\u044f \u044f\u043d\u044b \u0437\u0430\u0437\u043d\u0430\u044e\u0446\u044c, \u0440\u0430\u0441\u0446\u0435 \u0456 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u0434\u0437\u0435\u044f \u043d\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u0435 \u0441\u043b\u0430\u0432\u044b \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u043c\u0435\u0441\u043d\u0456\u043a \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u0431&rsquo;\u0435 \u043c\u0430\u043b\u0430\u0442\u043a\u043e\u043c \u043f\u0430 \u0437\u043e\u043b\u0430\u0446\u0435, \u043a\u0430\u0431 \u043f\u0440\u044b\u0431\u0440\u0430\u0446\u044c \u0437 \u044f\u0433\u043e \u045e\u0441\u044f\u043a\u0456\u044f \u0434\u0430\u043c\u0435\u0448\u043a\u0456, \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0430\u0431\u0447\u044b\u0448\u0447\u0430\u0435 \u044f\u0433\u043e, \u043a\u0430\u0431 \u044f\u0433\u043e \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u043a\u0440\u0430\u0441\u0430 \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u044f\u0440\u0447\u044d\u0439: &laquo;\u042f\u043a \u043f\u0435\u0447 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435 \u0433\u043b\u0456\u043d\u044f\u043d\u044b \u043f\u043e\u0441\u0443\u0434, \u0442\u0430\u043a \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435 \u043d\u044f\u0434\u043e\u043b\u044f\u0439 &ndash; \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439&raquo;. \u0422\u0430\u043c\u0443 \u0441\u0432. \u042f\u043a\u0443\u0431 \u043a\u0430\u0436\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0442\u0440\u0430\u043f\u043b\u044f\u0435\u0446\u0435 \u045e \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u044f \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456, \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u044b\u043c\u0430\u0439\u0446\u0435 \u0433\u044d\u0442\u0430&raquo; (\u042f\u043a 1, 2).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0442\u0443\u0442 \u0437\u0430\u0437\u043d\u0430\u0435 \u0447\u0430\u0441\u043e\u0432\u044b\u044f \u043f\u0430\u043a\u0443\u0442\u044b \u0437\u0430 \u0441\u0432\u0430\u0435 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456, \u0430\u043b\u0435 \u0437\u0430 \u0434\u0430\u0431\u0440\u043e, \u044f\u043a\u043e\u0435 \u045e\u0447\u044b\u043d\u0456\u043b\u0456, \u0456\u0445 \u0447\u0430\u043a\u0430\u0435 \u0432\u0435\u0447\u043d\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u045e \u043d\u0435\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0439\u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u044b \u0456 \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u044b \u0431\u0440\u0430\u0446\u0435, \u043a\u0430\u043b\u0456 \u0446\u044f\u0431\u0435 \u0430\u0431\u043a\u0440\u0443\u0436\u044b\u043b\u0456 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 \u0442\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0448 \u0443\u0434\u0430\u0440\u044b \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f, \u043d\u044f\u0445\u0430\u0439 \u0446\u044f\u0431\u0435 \u043d\u0435 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0430\u0434\u0447\u0430\u0439, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0447\u0443\u0435\u0446\u0446\u0430 \u0430\u0434 \u0446\u044f\u0431\u0435 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u044f \u0441\u043a\u0430\u0440\u0433\u0430, \u043d\u044f\u0445\u0430\u0439 \u0441\u043c\u0443\u0442\u0430\u043a \u0456 \u0442\u0443\u0433\u0430 \u043d\u0435 \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u044e\u0446\u044c \u0446\u044f\u0431\u0435, \u043d\u044f\u0445\u0430\u0439 \u043c\u0430\u043b\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u044f\u0435 \u0446\u044f\u0431\u0435 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0437\u0430\u045e\u0436\u0434\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u043f\u0430\u0433\u043e\u0434\u043b\u0456\u0432\u044b \u0442\u0432\u0430\u0440 \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u044b, \u0430 \u043f\u0430\u0434\u0437\u044f\u043a\u0430 \u043d\u044f\u0445\u0430\u0439 \u0433\u0443\u0447\u044b\u0446\u044c \u0443 \u0442\u0432\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0442\u0440\u044d\u0431\u0430 \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u0411\u043e\u0436\u044b\u044f \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0456, \u044f\u043a\u0456\u044f \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u043e\u0432\u0430 \u043b\u0443\u043f\u0446\u0443\u044e\u0446\u044c \u0441\u0432\u0430\u0456\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0430\u0437\u0431\u0435\u0433\u043b\u0456 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0431\u0456\u0447\u0430\u0432\u0430\u043d\u043d\u044f. \u0411\u043e\u0433 \u0443\u0446\u0456\u0441\u043a\u0430\u0435 \u0456\u0445 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u0434\u043d\u044f\u0446\u044c; \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u0440\u0430\u043d\u0456\u0446\u044c, \u043a\u0430\u0431 \u0430\u0437\u0434\u0430\u0440\u0430\u0432\u0456\u0446\u044c; \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u0435, \u043a\u0430\u0431 \u0443\u0437\u0432\u044b\u0441\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u0442\u044b\u043c\u0456 \u0456 \u0456\u043d\u0448\u044b\u043c\u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f\u043c\u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0441\u044d\u0440\u0446\u0430 \u0456 \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0447\u0430\u043a\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0443\u0442\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0446\u044f\u0431\u0435 \u0432\u044f\u0434\u0437\u0435 \u043d\u0430\u0434\u0437\u0435\u044f, \u043d\u044f\u0445\u0430\u0439 \u043b\u044e\u0431\u043e\u045e \u0440\u0430\u0441\u043f\u0430\u043b\u044c\u0432\u0430\u0435 \u0430\u0433\u043e\u043d\u044c, \u043a\u0430\u0431 \u0434\u0443\u0445 \u0443 \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u0456 \u0437\u0430\u0431\u044b\u045e\u0441\u044f \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0437\u0432\u043e\u043d\u043a\u0443, \u0456 \u045e\u0433\u043b\u044f\u0434\u0430\u045e\u0441\u044f \u0456 \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u045e\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435 \u045e \u0441\u0430\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0421\u0456\u0440 31, 8. 11\u0430. 10cd<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043d\u0435 \u043c\u0430\u0435 \u0432\u0456\u043d\u044b, \u044f\u043a\u0456 \u043d\u0435 \u0433\u043e\u043d\u0456\u0446\u0446\u0430 \u0437\u0430 \u0437\u043e\u043b\u0430\u0442\u0430\u043c \u0456 \u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u0431\u0430\u0433\u0430\u0446\u0446\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0430\u043c\u0443 \u044f\u0433\u043e \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u041f\u0430\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u043c\u043e\u0433 \u0437\u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u0430 \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u045e, \u043c\u043e\u0433 \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e, \u0430 \u043d\u0435 \u045e\u0447\u044b\u043d\u0456\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u044f\u0433\u043e \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u041f\u0430\u043d\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"645","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 4 de Natali ipsius, 2-3: PL 54, 149-151)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041a\u0430\u0441\u0446\u0451\u043b \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0432\u0435\u0440\u044b \u041f\u044f\u0442\u0440\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0437\u0456\u043d \u0442\u043e\u043b\u044c\u043a\u0456 \u041f\u0451\u0442\u0440 \u0431\u044b\u045e \u0430\u0431\u0440\u0430\u043d\u044b \u0437 \u0443\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u043d\u0430 \u0447\u0430\u043b\u0435 \u045e\u0441\u0456\u0445 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0443\u0441\u0456\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u0430\u0439\u0446\u043e\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0425\u043e\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0443 \u0411\u043e\u0436\u0430\u0433\u0430 \u0448\u043c\u0430\u0442 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0456 \u0448\u043c\u0430\u0442 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e, \u0430\u0434\u043d\u0430\u043a \u0443\u0441\u0456\u043c\u0456 \u0456\u043c\u0456, \u0443\u043b\u0430\u0441\u043d\u0430 \u043a\u0430\u0436\u0443\u0447\u044b, \u043a\u0456\u0440\u0443\u0435 \u0441\u0432. \u041f\u0451\u0442\u0440 \u043f\u0430\u0434 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0443\u043b\u0430\u0434\u0430\u044e \u0425\u0440\u044b\u0441\u0442\u0430. \u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0411\u043e\u0433 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0451 \u0432\u0435\u043b\u0456\u0447\u044b \u0434\u0430\u045e \u0433\u044d\u0442\u0430\u043c\u0443 \u043c\u0443\u0436\u0443 \u0432\u044f\u043b\u0456\u043a\u0456 \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u045e\u0434\u0437\u0435\u043b \u0443 \u0441\u0432\u0430\u0451\u0439 \u0443\u043b\u0430\u0434\u0437\u0435. \u0406 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043f\u0440\u0430\u0437 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u0411\u043e\u0433 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u0456\u043d\u0448\u044b\u0445 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e\u0434\u0437\u0435\u043b\u0430\u043c \u0443 \u0433\u044d\u0442\u0430\u0439 \u0443\u043b\u0430\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u0432\u0430 \u045e\u0441\u0456\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0448\u0442\u043e \u043b\u044e\u0434\u0437\u0456 \u043c\u044f\u0440\u043a\u0443\u044e\u0446\u044c \u043f\u0440\u0430 \u042f\u0433\u043e, \u0443\u0441\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430, \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u044e\u0447\u044b \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u0437\u0434\u0430\u0433\u0430\u0434\u043a\u0456 \u043d\u0430\u043a\u043e\u043d\u0442 \u042f\u0433\u043e. \u0410 \u043a\u0430\u043b\u0456 \u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0437\u0430\u043f\u044b\u0442\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430 \u0456\u0445 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0435, \u043f\u0435\u0440\u0448\u044b\u043c \u0432\u044b\u0437\u043d\u0430\u0435 \u041f\u0430\u043d\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u0435\u045e \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u043e \u045e \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432. \u041f\u0451\u0442\u0440 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u044b &ndash; \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0421\u044b\u043d \u0411\u043e\u0433\u0430 \u0416\u044b\u0432\u043e\u0433\u0430&raquo;. \u0415\u0437\u0443\u0441 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u044b, \u0421\u044b\u043c\u043e\u043d\u0435, \u0441\u044b\u043d \u0401\u043d\u044b, \u0431\u043e \u043d\u0435 \u0446\u0435\u043b\u0430 \u0456 \u043a\u0440\u043e\u045e \u0430\u0434\u043a\u0440\u044b\u043b\u0456 \u0442\u0430\u0431\u0435 \u0433\u044d\u0442\u0430, \u0430\u043b\u0435 \u0410\u0439\u0446\u0435\u0446 \u041c\u043e\u0439, \u044f\u043a\u0456 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445&raquo; (\u041c\u0446 16, 16-17). \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0442\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0443\u043b\u0430 \u0446\u044f\u0431\u0435 \u043b\u044e\u0434\u0441\u043a\u043e\u0435 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0435, \u0430\u043b\u0435 \u0410\u0439\u0446\u0435\u0446 \u041c\u043e\u0439 \u0430\u0434\u043a\u0440\u044b\u045e \u0433\u044d\u0442\u0430, \u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0435 \u043f\u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430. \u041d\u0435 \u0446\u0435\u043b\u0430 \u0456 \u043a\u0440\u043e\u045e \u0443\u043a\u0430\u0437\u0430\u043b\u0456 \u041c\u044f\u043d\u0435 \u0442\u0430\u0431\u0435, \u0430\u043b\u0435 \u0442\u043e\u0439, \u0447\u044b\u0456\u043c \u0430\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u0421\u044b\u043d\u0430\u043c \u042f \u0451\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435: &laquo;I \u042f \u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435&raquo;. \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u044f\u043a \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u0431\u0435 \u041c\u0430\u044e \u0432\u0435\u043b\u0456\u0447, \u0442\u0430\u043a \u0456 \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0432\u044f\u0434\u043e\u043c\u0430\u0439 \u0442\u0432\u0430\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0431\u043e &laquo;\u0442\u044b &ndash; \u041f\u0451\u0442\u0440 (\u0441\u043a\u0430\u043b\u0430)&raquo;. \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0445\u043e\u0446\u044c, \u043d\u0430\u0441\u0430\u043c\u0440\u044d\u0447, \u042f \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u044f \u0441\u043a\u0430\u043b\u0430, \u042f &laquo;\u0432\u0443\u0433\u043b\u0430\u0432\u044b \u043a\u0430\u043c\u0435\u043d\u044c, \u044f\u043a\u0456 \u044f\u0434\u043d\u0430\u0435 \u0430\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435&raquo; (\u043f\u0430\u0440. \u042d\u0444 2, 14. 20), \u042f \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a, \u0430\u043f\u0440\u043e\u0447 \u044f\u043a\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0430\u043a\u043b\u0430\u0441\u0446\u0456 \u0456\u043d\u0448\u0430\u0433\u0430, \u0430\u0434\u043d\u0430\u043a \u0442\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043a\u0430\u043b\u0430, \u0431\u043e \u041c\u0430\u044f \u0441\u0456\u043b\u0430 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u041c\u043d\u0435 \u043f\u0440\u0430\u0437 \u0443\u043b\u0430\u0434\u0443, \u043f\u0435\u0440\u0430\u0434\u0430\u043b\u043e\u0441\u044f \u0456 \u0442\u0430\u0431\u0435 \u043f\u0440\u0430\u0437 \u0443\u0434\u0437\u0435\u043b \u0443\u0432\u0430 \u041c\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0406 \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0441\u043a\u0430\u043b\u0435 \u042f \u043f\u0430\u0431\u0443\u0434\u0443\u044e \u041a\u0430\u0441\u0446\u0451\u043b \u041c\u043e\u0439, \u0456 \u0431\u0440\u0430\u043c\u044b \u043f\u044f\u043a\u0435\u043b\u044c\u043d\u044b\u044f \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443\u0446\u044c \u044f\u0433\u043e&raquo; (\u041c\u0446 16, 18). \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u0456 \u045e\u0437\u043d\u044f\u0441\u0443 \u0432\u0435\u0447\u043d\u0443\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0456 \u043d\u0435\u0431\u0430\u0441\u044f\u0436\u043d\u0430\u044f \u0432\u044b\u0448\u044b\u043d\u044f \u041c\u0430\u0439\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0431\u0443\u0434\u0437\u0435 \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u0446\u0446\u0430 \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u0439 \u0432\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f \u043d\u0435 \u0441\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0431\u0440\u0430\u043c\u044b \u043f\u0435\u043a\u043b\u0430, \u043d\u0435 \u0437\u0432\u044f\u0436\u0443\u0446\u044c \u043f\u0443\u0442\u044b \u0441\u043c\u0435\u0440\u0446\u0456, \u0431\u043e \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b &ndash; \u0441\u043b\u043e\u0432\u044b \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u0456\u044f \u045e\u0437\u0434\u044b\u043c\u0430\u044e\u0446\u044c \u0443 \u043d\u0435\u0431\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u044b\u0437\u043d\u0430\u0435 \u0411\u043e\u0433\u0430, \u0456 \u0441\u043a\u0456\u0434\u0430\u044e\u0446\u044c \u0443 \u043f\u0435\u043a\u043b\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u0433\u043e \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0415\u0437\u0443\u0441 \u043a\u0430\u0436\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u043c\u0443 \u041f\u044f\u0442\u0440\u0443: &laquo;\u042f \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u043a\u043b\u044e\u0447\u044b \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430, \u0456 \u0448\u0442\u043e \u0437\u0432\u044f\u0436\u0430\u0448 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0442\u043e\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u045e \u043d\u0435\u0431\u0435, \u0430 \u0448\u0442\u043e \u0440\u0430\u0437\u0432\u044f\u0436\u0430\u0448 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0442\u043e\u0435 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u045e \u043d\u0435\u0431\u0435&raquo; (\u041c\u0446 16, 19).<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u043f\u0440\u0430\u0432\u0430 \u043d\u0430 \u0433\u044d\u0442\u0443\u044e \u045e\u043b\u0430\u0434\u0443 \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430 \u0456\u043d\u0448\u044b\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0430 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0430, \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u0430\u044f \u045e \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445, \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0443\u0441\u0456\u0445 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0410\u0434\u043d\u0430\u043a \u043d\u0435 \u0434\u0430\u0440\u043c\u0430 \u0431\u044b\u043b\u043e \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430 \u0430\u0434\u043d\u0430\u043c\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0443\u0441\u0456\u0445. \u0413\u044d\u0442\u0430\u0439 \u0443\u043b\u0430\u0434\u0430\u0439 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043d\u0430\u0434\u0437\u0435\u043b\u0435\u043d\u044b \u0441\u0432. \u041f\u0451\u0442\u0440, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u041f\u0451\u0442\u0440 \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u0435 \u0441\u0432\u0430\u0451\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e \u045e\u0441\u0456\u0445 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041c\u0446 16, 19<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u044b\u043c\u043e\u043d \u041f\u0451\u0442\u0440, \u042f \u0432\u0435\u0434\u0430\u045e \u0446\u044f\u0431\u0435 \u0434\u0430 \u0442\u0430\u0433\u043e, \u044f\u043a \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e, \u0456 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u043c \u041c\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443. <span style=\"color: #ff0000;\">*<\/span> \u042f \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u043a\u043b\u044e\u0447\u044b \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u0451, \u0448\u0442\u043e \u0437\u0432\u044f\u0436\u0430\u0448 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0442\u043e\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u045e \u043d\u0435\u0431\u0435, \u0430 \u0448\u0442\u043e \u0440\u0430\u0437\u0432\u044f\u0436\u0430\u0448 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0442\u043e\u0435 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u045e \u043d\u0435\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u043a\u043b\u044e\u0447\u044b \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"646","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e \u0421\u043c\u0456\u0440\u043d\u0435 \u043f\u0440\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0441\u0432. \u041f\u0430\u043b\u0456\u043a\u0430\u0440\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(13, 2 &ndash; 15, 3: Funk 1, 297-299)<\/span><br \/><em><span style=\"color: #ff0000;\">\u042f\u043a \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u044f \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430<\/span> <\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0432\u043e\u0433\u043d\u0456\u0448\u0447\u0430 \u0431\u044b\u043b\u043e \u045e\u0436\u043e \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430\u0435, \u041f\u0430\u043a\u043b\u0456\u043a\u0430\u0440\u043f \u0441\u0430\u043c \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u045e \u043f\u043e\u044f\u0441, \u0440\u0430\u0441\u043f\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0456 \u0441\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0437\u043d\u044f\u0446\u044c \u0430\u0431\u0443\u0442\u0430\u043a. \u041d\u0435 \u0437\u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0440\u0430\u043d\u0435\u0439, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u045e\u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u043a\u0430\u043b\u044f \u044f\u0433\u043e \u0431\u044b\u043b\u0456 \u043d\u0430\u0442\u043e\u045e\u043f\u044b \u0432\u0435\u0440\u043d\u044b\u0445, \u0456 \u043a\u043e\u0436\u043d\u044b \u0445\u0430\u0446\u0435\u045e \u043f\u0435\u0440\u0448\u044b\u043c \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u0431\u043e \u0456 \u043f\u0435\u0440\u0430\u0434 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u044f\u0433\u043e \u0448\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u0437\u0430 \u045e\u0441\u044f\u043a\u0430\u0435 \u0434\u0430\u0431\u0440\u043e \u0456 \u0437\u0430 \u044f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0435 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0440\u0430\u0437\u0443 \u0436 \u0430\u0431\u043a\u043b\u0430\u043b\u0456 \u044f\u0433\u043e \u045e\u0441\u0456\u043c\u0456 \u043f\u0440\u044b\u043b\u0430\u0434\u0430\u043c\u0456, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u043c\u0456 \u0434\u043b\u044f \u0432\u043e\u0433\u043d\u0456\u0448\u0447\u0430. \u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u0445\u0430\u0446\u0435\u043b\u0456 \u043f\u0440\u044b\u0431\u0456\u0446\u044c \u044f\u0433\u043e \u0446\u0432\u0456\u043a\u0430\u043c\u0456 \u0434\u0430 \u0434\u0440\u044d\u0432\u0430, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0414\u0430\u0432\u043e\u043b\u044c\u0446\u0435 \u043c\u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0442\u0430\u043a, \u0431\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0430\u0435 \u043c\u043d\u0435 \u0441\u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0430\u0433\u043e\u043d\u044c, \u0434\u0430\u0441\u0446\u044c \u043c\u043d\u0435 \u0456 \u0431\u0435\u0437 \u0432\u0430\u0448\u044b\u0445 \u0446\u0432\u0456\u043a\u043e\u045e \u043d\u0435\u0440\u0443\u0445\u043e\u043c\u0430 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0446\u044c \u043d\u0430 \u0430\u0433\u043d\u0456&raquo;. \u0422\u0430\u0434\u044b \u044f\u0433\u043e \u043d\u0435 \u0441\u0442\u0430\u043b\u0456 \u043f\u0440\u044b\u0431\u0456\u0432\u0430\u0446\u044c, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b\u0432\u044f\u0437\u0430\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0437 \u0437\u0430\u043b\u0430\u043c\u0430\u043d\u044b\u043c\u0456 \u0437\u0430 \u0441\u043f\u0456\u043d\u0430\u0439 \u0456 \u0437\u0432\u044f\u0437\u0430\u043d\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456 \u0451\u043d \u0431\u044b\u045e \u0431\u044b\u0446\u0446\u0430\u043c \u043a\u0430\u0437\u043b\u044f\u043d\u044f, \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0435 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0441\u0442\u0430\u0442\u043a\u0443 \u043d\u0430 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435, \u044f\u043a \u043c\u0456\u043b\u0430\u044f \u0411\u043e\u0433\u0443 \u0430\u0445\u0432\u044f\u0440\u0430. \u0401\u043d \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e \u0443 \u043d\u0435\u0431\u0430 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e:<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u041e\u0439\u0447\u0430 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u043d\u0430\u043c \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0426\u044f\u0431\u0435. \u0411\u043e\u0436\u0430 \u0430\u043d\u0451\u043b\u0430\u045e, \u0456 \u043c\u043e\u0446\u0430\u045e, \u0456 \u045e\u0441\u044f\u043a\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u0456 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u043f\u0435\u0440\u0430\u0434 \u0422\u0432\u0430\u0456\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c. \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e \u0426\u044f\u0431\u0435, \u0431\u043e \u045e \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0456 \u045e \u0433\u044d\u0442\u0443\u044e \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u0422\u044b \u045e\u0434\u0430\u0441\u0442\u043e\u0456\u045e \u043c\u044f\u043d\u0435 \u0434\u0430\u043b\u0443\u0447\u044b\u0446\u0446\u0430 \u0434\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0422\u0432\u0430\u0456\u0445 \u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u043a\u0435\u043b\u0456\u0445\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u041f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430, \u0434\u0437\u0435\u043b\u044f \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u0430 \u045e \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u041d\u044f\u0445\u0430\u0439 \u0441\u044f\u0440\u043e\u0434 \u0422\u0432\u0430\u0456\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u044f \u0441\u0451\u043d\u043d\u044f \u045e\u0437\u044b\u0434\u0443 \u0434\u0430 \u0426\u044f\u0431\u0435 \u044f\u043a \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u044f \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430, \u044f\u043a\u0443\u044e \u0422\u044b \u0440\u0430\u043d\u0435\u0439 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0441\u0430\u0431\u0435, \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0435 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u0456 \u0446\u044f\u043f\u0435\u0440 \u0441\u043f\u043e\u045e\u043d\u0456\u045e, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0411\u043e\u0436\u0430, \u044f\u043a\u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0448 \u043f\u0430\u0434\u043c\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0432\u0435\u043b\u0456\u0447\u0430\u044e \u0426\u044f\u0431\u0435 \u0437\u0430 \u045e\u0441\u0451 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e \u0426\u044f\u0431\u0435 \u0437\u0430 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0422\u0432\u0430\u0439\u0433\u043e, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u043d\u044f\u0445\u0430\u0439 \u0422\u0430\u0431\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0431\u0443\u0434\u0437\u0435 \u0441\u043b\u0430\u0432\u0430 \u0446\u044f\u043f\u0435\u0440 \u0456 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e. \u0410\u043c\u044d\u043d&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0410\u043c\u044d\u043d&raquo; \u0456 \u0441\u043a\u043e\u043d\u0447\u044b\u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u043f\u0430\u0441\u043b\u0443\u0433\u0430\u0447\u044b \u0440\u0430\u0441\u043f\u0430\u043b\u0456\u043b\u0456 \u0432\u043e\u0433\u043d\u0456\u0448\u0447\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0440\u0430\u0437\u0433\u0430\u0440\u044d\u043b\u0430\u0441\u044f \u043f\u043e\u043b\u044b\u043c\u044f, \u043d\u0430\u043c, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f, \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0446\u0443\u0434, \u043a\u0430\u0431 \u0440\u0430\u0441\u043f\u0430\u0432\u0435\u0441\u0446\u0456 \u0456\u043d\u0448\u044b\u043c \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f. \u0410\u0433\u043e\u043d\u044c \u043d\u0430\u0431\u044b\u045e \u0444\u043e\u0440\u043c\u0443 \u043a\u0443\u043f\u0430\u043b\u0430, \u044f\u043a \u043d\u0430\u0434\u0437\u044c\u043c\u0443\u0442\u044b \u0432\u0435\u0442\u0440\u0430\u0437\u044c \u043a\u0430\u0440\u0430\u0431\u043b\u044f, \u0456 \u0430\u0431\u043a\u0440\u0443\u0436\u044b\u045e \u0446\u0435\u043b\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430. \u0410 \u0451\u043d \u0441\u0430\u043c \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u045e \u043d\u0435 \u044f\u043a \u0441\u043f\u0430\u043b\u0435\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u0430 \u044f\u043a \u0445\u043b\u0435\u0431, \u044f\u043a\u0456 \u043f\u044f\u0447\u044d\u0446\u0446\u0430, \u0446\u0456 \u044f\u043a \u0437\u043e\u043b\u0430\u0442\u0430 \u0430\u0431\u043e \u0441\u0440\u044d\u0431\u0440\u0430, \u044f\u043a\u043e\u0435 \u0442\u043e\u043f\u0456\u0446\u0446\u0430 \u045e \u0430\u0433\u043d\u0456. \u0406 \u043c\u044b \u0430\u0434\u0447\u0443\u043b\u0456 \u0442\u0430\u043a\u0456 \u0441\u0430\u043b\u043e\u0434\u043a\u0456 \u0432\u043e\u0434\u0430\u0440, \u0431\u044b\u0446\u0446\u0430\u043c \u0430\u0434 \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u0446\u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u0445 \u0434\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044f\u045e.<br \/> <br \/><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 2, 8-9\u0430. 10\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043d\u0451\u043b\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e \u0421\u043c\u0456\u0440\u043d\u0435 \u043d\u0430\u043f\u0456\u0448\u044b: \u0413\u044d\u0442\u0430 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u041f\u0435\u0440\u0448\u044b \u0456 \u0410\u043f\u043e\u0448\u043d\u0456, \u044f\u043a\u0456 \u0431\u044b\u045e \u043c\u0451\u0440\u0442\u0432\u044b, \u0430\u043b\u0435 \u0430\u0436\u044b\u045e: \u042f \u0432\u0435\u0434\u0430\u044e \u043f\u0440\u0430 \u0442\u0432\u043e\u0439 \u0443\u0446\u0456\u0441\u043a \u0456 \u045e\u0431\u043e\u0441\u0442\u0432\u0430, \u0430\u043b\u0435 \u0442\u044b \u0431\u0430\u0433\u0430\u0442\u044b.<span style=\"color: #ff0000;\"> *<\/span> \u0411\u0443\u0434\u0437\u044c \u0432\u0435\u0440\u043d\u044b \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, &ndash; \u0456 \u042f \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u0432\u044f\u043d\u0435\u0446 \u0436\u044b\u0446\u0446\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0435 \u0431\u043e\u0439\u0441\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u0443\u0441\u0456\u0448 \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u0446\u044c. \u0412\u043e\u0441\u044c \u0434&rsquo;\u044f\u0431\u0430\u043b \u0437\u0431\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u043a\u0456\u043d\u0443\u0446\u044c \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445 \u0437 \u0432\u0430\u0441 \u0443 \u0432\u044f\u0437\u043d\u0456\u0446\u0443, \u043a\u0430\u0431 \u0432\u044b \u0437\u0432\u0435\u0434\u0430\u043b\u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0437\u044c \u0432\u0435\u0440\u043d\u044b \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, &ndash; \u0456 \u042f \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u0432\u044f\u043d\u0435\u0446 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"647","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0416\u044b\u0446\u0446\u0451 \u0441\u0432. \u041a\u0430\u0437\u0456\u043c\u0456\u0440\u0430&raquo;, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u0435 \u0442\u0430\u0433\u0430\u0447\u0430\u0441\u043d\u044b\u043c \u0430\u045e\u0442\u0430\u0440\u0430\u043c<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 2-3: Acta Sanctorum Martii 1, 347-348)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0417\u0431\u0456\u0440\u0430\u045e \u0441\u0432\u043e\u0439 \u0441\u043a\u0430\u0440\u0431 \u0443 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u0445 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0434\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u044f, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u044f \u0456 \u0448\u0447\u044b\u0440\u0430\u044f \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u043e\u0439 \u043f\u0430\u043b\u0430\u045e \u0434\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c, \u0442\u0430\u043a \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u0441\u044d\u0440\u0446\u0430 \u041a\u0430\u0437\u0456\u043c\u0456\u0440\u0430 \u0456 \u0442\u0430\u043a \u0432\u044b\u043b\u0456\u0432\u0430\u043b\u0430\u0441\u044f \u043d\u0430 \u0431\u043b\u0456\u0436\u043d\u0456\u0445 \u0437 \u0441\u0430\u043c\u044b\u0445 \u0433\u043b\u044b\u0431\u0456\u043d\u044c \u044f\u0433\u043e \u0434\u0443\u0448\u044b, \u0448\u0442\u043e \u0434\u043b\u044f \u044f\u0433\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0433\u0430 \u0456 \u0436\u0430\u0434\u0430\u043d\u0430\u0433\u0430, \u0447\u044b\u043c \u0430\u0434\u0434\u0430\u0432\u0430\u0446\u044c \u0443\u0441\u0451 \u0441\u0432\u0430\u0451 \u0456 \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u045e\u0431\u043e\u0433\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u044b\u043c, \u0445\u0432\u043e\u0440\u044b\u043c, \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u043c \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u043b\u044e\u0434\u0437\u044f\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043b\u044f \u045e\u0434\u043e\u0432\u0430\u045e, \u0441\u0456\u0440\u043e\u0442\u0430\u045e, \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u0445 \u0451\u043d \u0431\u044b\u045e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u043f\u0435\u043a\u0443\u043d\u043e\u043c \u0456 \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u0446\u0430\u043c, \u0430\u043b\u0435 \u0431\u0430\u0446\u044c\u043a\u0430\u043c, \u0441\u044b\u043d\u0430\u043c \u0456 \u0431\u0440\u0430\u0442\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0442\u0440\u044b\u043c\u0430\u043b\u0430\u0441\u044f \u0431 \u0432\u0435\u043b\u044c\u043c\u0456 \u0434\u043e\u045e\u0433\u0430\u044f \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u044f, \u043a\u0430\u043b\u0456 \u0431 \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u0430\u043f\u0456\u0441\u0430\u0446\u044c \u0443\u0441\u0435 \u0443\u0447\u044b\u043d\u043a\u0456 \u044f\u0433\u043e \u0433\u0430\u0440\u0430\u0447\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u0436\u043a\u0430 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0456 \u043d\u0430\u0432\u0430\u0442 \u0443\u044f\u0432\u0456\u0446\u044c, \u044f\u043a \u0451\u043d \u043f\u0430\u0432\u0430\u0436\u0430\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u045e \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u043e\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u045e\u0441\u044f, \u044f\u043a\u043e\u0439 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044e \u0434\u0443\u0445\u0430 \u0456 \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u044e \u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u045e \u0442\u044b\u043c \u0443\u0437\u0440\u043e\u0441\u0446\u0435, \u043a\u0430\u043b\u0456 \u043b\u044e\u0434\u0437\u0456 \u043f\u0430 \u0441\u0432\u0430\u0451\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0441\u0445\u0456\u043b\u044c\u043d\u044b\u044f \u0434\u0430 \u0437\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u0440\u0430\u0456\u045e \u0431\u0430\u0446\u044c\u043a\u0443 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u043a\u0456\u0440\u0430\u0432\u0430\u043d\u043d\u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u0442\u0432\u0430\u043c \u0456 \u043f\u0430\u0434\u0434\u0430\u043d\u044b\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456. \u0406 \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u043d\u0435\u0434\u0430\u0433\u043b\u044f\u0434 \u0446\u0456 \u043b\u044e\u0434\u0441\u043a\u0443\u044e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0437\u0434\u0430\u0440\u0430\u043b\u0456\u0441\u044f \u043d\u0435\u0439\u043a\u0456\u044f \u043f\u0430\u043c\u044b\u043b\u043a\u0456, \u0451\u043d \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437 \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u043f\u0430\u0432\u0443\u0447\u0430\u045e \u043a\u0430\u0440\u0430\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0440\u0430\u0432\u0430\u043c\u0456 \u0431\u0435\u0434\u043d\u044b\u0445 \u0456 \u0433\u0430\u0440\u043e\u0442\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0437\u0430\u0439\u043c\u0430\u045e\u0441\u044f \u044f\u043a \u0441\u0432\u0430\u0456\u043c\u0456 \u045e\u043b\u0430\u0441\u043d\u044b\u043c\u0456, \u0437\u0430 \u0448\u0442\u043e \u043d\u0430\u0440\u043e\u0434 \u043d\u0430\u0437\u044b\u0432\u0430\u045e \u044f\u0433\u043e \u0430\u0431\u0430\u0440\u043e\u043d\u0446\u0430\u043c \u0431\u0435\u0434\u043d\u044b\u0445. \u0425\u043e\u0446\u044c \u0431\u044b\u045e \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0456\u0447\u0430\u043c \u0456 \u043c\u0435\u045e \u0437\u043d\u0430\u0442\u043d\u0430\u0435 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u044b\u045e \u0433\u0440\u0443\u0431\u044b\u043c \u0443 \u0430\u0434\u043d\u043e\u0441\u0456\u043d\u0430\u0445 \u0446\u0456 \u0440\u0430\u0437\u043c\u043e\u0432\u0435 \u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u043d\u0456\u0436\u044d\u0439\u0448\u0430\u0433\u0430 \u0456 \u043f\u0440\u043e\u0441\u0442\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u045e\u0441\u0451\u0434\u044b \u0445\u0430\u0446\u0435\u045e \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u0445 \u0456 \u045e\u0431\u043e\u0433\u0456\u0445 \u0434\u0443\u0445\u0430\u043c, \u044f\u043a\u0456\u0445 \u0451\u0441\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435, \u0447\u044b\u043c \u0434\u0430 \u0441\u043b\u0430\u0432\u0443\u0442\u044b\u0445 \u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u0445 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u041d\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u045e \u0432\u044f\u0440\u0448\u044b\u043d\u044f\u045e \u0437\u044f\u043c\u043d\u043e\u0439 \u0443\u043b\u0430\u0434\u044b \u0456 \u043d\u0435 \u0436\u0430\u0434\u0430\u045e \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u0456\u0445 \u0430\u0434 \u0431\u0430\u0446\u044c\u043a\u0456, \u0431\u0430\u044e\u0447\u044b\u0441\u044f, \u043a\u0430\u0431 \u0456\u0433\u043e\u043b\u043a\u0456 \u0431\u0430\u0433\u0430\u0446\u0446\u044f, \u044f\u043a\u0456\u044f \u043d\u0430\u0448 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0430\u0437\u0432\u0430\u045e \u0446\u0435\u0440\u043d\u044f\u043c\u0456, \u043d\u0435 \u043f\u0430\u0440\u0430\u043d\u0456\u043b\u0456 \u0434\u0443\u0445\u0430 \u0456 \u043d\u0435 \u0437\u0430\u0440\u0430\u0437\u0456\u043b\u0456 \u044f\u0433\u043e \u0437\u044f\u043c\u043d\u044b\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u044f\u0433\u043e\u043d\u044b\u044f \u0441\u0432\u0430\u044f\u043a\u0456 \u0456 \u0434\u0430\u0432\u0435\u0440\u0430\u043d\u044b\u044f \u0430\u0441\u043e\u0431\u044b, \u043b\u044e\u0434\u0437\u0456 \u0433\u043e\u0434\u043d\u044b\u044f \u0456 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044b\u044f, \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u044f\u043a\u0456\u0445 \u0436\u044b\u0432\u0443\u0446\u044c \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0456 \u044f\u043a\u0456\u044f \u0431\u043b\u0456\u0437\u043a\u0430 \u044f\u0433\u043e \u0432\u0435\u0434\u0430\u043b\u0456, \u0437\u0433\u043e\u0434\u043d\u0430 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e\u0446\u044c \u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u0451\u043d \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u045e \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f \u0434\u0430 \u0441\u0430\u043c\u0430\u0433\u0430 \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430 \u0434\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0456\u0440 29, 14; 1 \u0426\u0456\u043c 6, 11b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0431\u0456\u0440\u0430\u0439 \u0441\u0432\u043e\u0439 \u0441\u043a\u0430\u0440\u0431 \u0443 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u0445 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0423 \u0433\u044d\u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u0434\u043b\u044f \u0446\u044f\u0431\u0435, \u0447\u044b\u043c \u0443 \u0437\u043e\u043b\u0430\u0446\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0432\u0435\u0440\u044b, \u043b\u044e\u0431\u043e\u0432\u0456, \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0433\u044d\u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u0434\u043b\u044f \u0446\u044f\u0431\u0435, \u0447\u044b\u043c \u0443 \u0437\u043e\u043b\u0430\u0446\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"648","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0410\u043f\u0456\u0441\u0430\u043d\u043d\u0435 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0441\u0432. \u043c\u0443\u0447\u0430\u043d\u0456\u0446 \u0437 \u041a\u0430\u0440\u0444\u0430\u0433\u0435\u043d\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 18, 20-21: edit. Van Beek, Naviomagi, 1936, pp. 42. 46-52)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u0456 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u044f \u0434\u043b\u044f \u0441\u043b\u0430\u0432\u044b \u041f\u0430\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u044f\u0441\u043d\u0435\u045e \u0434\u0437\u0435\u043d\u044c \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u0446, \u0456 \u044f\u043d\u044b \u0432\u044b\u0439\u0448\u043b\u0456 \u0437 \u0432\u044f\u0437\u043d\u0456\u0446\u044b \u045e \u0430\u043c\u0444\u0456\u0442\u044d\u0430\u0442\u0440, \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u043d\u0435\u0431\u0430, \u0433\u043e\u0434\u043d\u0430 \u0456 \u0437 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c, \u0430 \u043a\u0430\u043b\u0456 \u0456 \u0434\u0440\u044b\u0436\u044d\u043b\u0456, \u0434\u044b\u043a \u0430\u0434 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0430 \u043d\u0435 \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0448\u0430\u0439 \u043d\u0430 \u0430\u0440\u044d\u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u045e\u0434\u0430\u0440 \u041f\u044d\u0440\u043f\u044d\u0442\u0443\u044f \u0456 \u045e\u043f\u0430\u043b\u0430 \u043d\u0430\u045e\u0437\u043d\u0456\u0447. \u041f\u0430\u0441\u043b\u044f \u043f\u0430\u0434\u043d\u044f\u043b\u0430\u0441\u044f, \u0430 \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0430, \u0448\u0442\u043e \u0424\u044d\u043b\u0456\u0446\u044b\u0442\u0430 \u043b\u044f\u0436\u044b\u0446\u044c, \u043f\u0430\u0434\u0431\u0435\u0433\u043b\u0430 \u0434\u0430 \u044f\u0435, \u043f\u0430\u0434\u0430\u043b\u0430 \u0440\u0443\u043a\u0443 \u0456 \u043f\u0430\u0434\u043d\u044f\u043b\u0430 \u044f\u0435. \u0410\u0431\u0435\u0434\u0437\u044c\u0432\u0435 \u0440\u0430\u0437\u0430\u043c \u0443\u0441\u0442\u0430\u043b\u0456. \u0422\u0430\u0434\u044b \u0437\u0430\u0446\u044f\u0442\u0430\u0441\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u0443 \u0441\u0443\u043d\u044f\u043b\u0430\u0441\u044f, \u0456 \u0456\u0445 \u0430\u0434\u0432\u044f\u043b\u0456 \u043d\u0430\u0437\u0430\u0434 \u0443 \u0421\u0430\u043d\u0430\u0432\u0456\u0432\u0430\u0440\u044b\u0439\u0441\u043a\u0443\u044e \u0431\u0440\u0430\u043c\u0443. \u0422\u0430\u043c \u041f\u044d\u0440\u043f\u044d\u0442\u0443\u044e \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u045e \u043f\u044d\u045e\u043d\u044b \u043a\u0430\u0442\u044d\u0445\u0443\u043c\u044d\u043d \u043f\u0430 \u0456\u043c\u0435\u043d\u0456 \u0420\u0443\u0441\u0442\u044b\u043a. \u042f\u043d\u0430, \u044f\u043a \u0431\u044b \u043f\u0440\u0430\u0447\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u043f\u0430\u0441\u043b\u044f \u0441\u043d\u0443 (\u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u045e \u044d\u043a\u0441\u0442\u0430\u0442\u044b\u0447\u043d\u044b\u043c \u0434\u0443\u0445\u0443), \u043f\u0430\u0447\u0430\u043b\u0430 \u0430\u0433\u043b\u044f\u0434\u0430\u0446\u0446\u0430 \u0456 \u043d\u0430 \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u0456\u043c \u0441\u043a\u0430\u0437\u0430\u043b\u0430: &laquo;\u041a\u0430\u043b\u0456 \u045e\u0436\u043e \u043d\u0430\u0441 \u043f\u0430\u0432\u044f\u0434\u0443\u044e\u0446\u044c \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u0448\u0430\u043b\u0451\u043d\u0430\u0439 \u043a\u0430\u0440\u043e\u0432\u044b?&raquo; \u0410 \u043a\u0430\u043b\u0456 \u0451\u0439 \u0441\u043a\u0430\u0437\u0430\u043b\u0456, \u0448\u0442\u043e \u044f\u043d\u0430 \u045e\u0436\u043e \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u043d\u0430 \u0430\u0440\u044d\u043d\u0443, \u043d\u0435 \u0432\u0435\u0440\u044b\u043b\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u043b\u0430 \u0441\u043b\u044f\u0434\u044b \u0430\u0434 \u0443\u0434\u0430\u0440\u0430\u045e \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u0456 \u043d\u0430 \u0430\u0434\u0437\u0435\u043d\u043d\u0456. \u0422\u0430\u0434\u044b, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e\u0448\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0442\u0430 \u0456 \u043a\u0430\u0442\u044d\u0445\u0443\u043c\u044d\u043d\u0430 \u0420\u0443\u0441\u0442\u044b\u043a\u0430, \u0437\u0432\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u0434\u0430 \u0456\u0445: &laquo;\u0422\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u045e \u0432\u0435\u0440\u044b \u0456 \u043b\u044e\u0431\u0456\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u0430\u043b\u0435 \u043d\u0435 \u0433\u0443\u0431\u043b\u044f\u0439\u0446\u0435 \u0432\u0435\u0440\u044b \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u043d\u0430\u0448\u044b\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0421\u0430\u0442\u0443\u0440 \u0443 \u0456\u043d\u0448\u0430\u0439 \u0431\u0440\u0430\u043c\u0435 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u045e \u0436\u0430\u045e\u043d\u0435\u0440\u0430 \u041f\u0443\u0434\u044d\u043d\u0442\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u042f\u043a \u044f \u043f\u0440\u0430\u0434\u0447\u0443\u0432\u0430\u045e \u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e, \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u0446\u044f\u0440\u043f\u0435\u045e \u044f\u0448\u0447\u044d \u0430\u0434 \u0434\u0437\u0456\u043a\u0430\u0433\u0430 \u0437\u0432\u0435\u0440\u0430. \u0410\u043b\u0435 \u0446\u044f\u043f\u0435\u0440 \u0431\u0443\u0434\u0437\u044c \u043f\u044d\u045e\u043d\u044b: \u0432\u043e\u0441\u044c \u044f \u0432\u044b\u0445\u043e\u0434\u0436\u0443 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u043b\u0435\u0430\u043f\u0430\u0440\u0434\u0443 \u0456 \u0431\u0443\u0434\u0443 \u0437\u0430\u0431\u0456\u0442\u044b \u0430\u0434\u043d\u044b\u043c \u044f\u0433\u043e\u043d\u044b\u043c \u0443\u0434\u0430\u0440\u0430\u043c&raquo;. \u0406 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u045e \u043a\u0430\u043d\u0446\u044b \u0432\u0456\u0434\u043e\u0432\u0456\u0448\u0447\u0430 \u0431\u044b\u045e \u043a\u0456\u043d\u0443\u0442\u044b \u043f\u0435\u0440\u0430\u0434 \u043b\u0435\u0430\u043f\u0430\u0440\u0434\u0430\u043c. \u0410\u0434 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u045e\u043a\u0443\u0441\u0443 \u0442\u0430\u043a \u0437\u0430\u043b\u0456\u0432\u0430\u045e\u0441\u044f \u043a\u0440\u044b\u0432\u0451\u044e, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0451\u043d \u0432\u044f\u0440\u0442\u0430\u045e\u0441\u044f, \u0434\u0430\u044e\u0447\u044b \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0433\u044d\u0442\u0430\u043c\u0443 \u0434\u0440\u0443\u0433\u043e\u043c\u0443 \u0445\u0440\u043e\u0441\u0442\u0443, \u043d\u0430\u0440\u043e\u0434 \u043a\u0440\u044b\u0447\u0430\u045e: &laquo;\u0417\u0431\u0430\u0432\u0435\u043d\u043d\u0430\u044f \u043a\u0443\u043f\u0435\u043b\u044c, \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u0430\u044f \u043a\u0443\u043f\u0435\u043b\u044c&raquo;. \u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u0431\u044b\u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u044b\u045e \u0442\u0430\u043a \u0430\u0431\u043c\u044b\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u0436\u0430\u045e\u043d\u0435\u0440\u0443 \u041f\u0443\u0434\u044d\u043d\u0442\u0443: &laquo;\u0411\u044b\u0432\u0430\u0439 \u0456 \u043f\u0430\u043c\u044f\u0442\u0430\u0439 \u043f\u0440\u0430 \u0432\u0435\u0440\u0443 \u0456 \u043f\u0440\u0430 \u043c\u044f\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u0448, \u043d\u0435 \u0442\u0443\u0440\u0431\u0443\u0435, \u0430 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0446\u044f\u0431\u0435&raquo;. \u0422\u0430\u0434\u044b \u045e\u0437\u044f\u045e \u043f\u044f\u0440\u0441\u0446\u0451\u043d\u0430\u043a \u0437 \u043f\u0430\u043b\u044c\u0446\u0430 \u0436\u0430\u045e\u043d\u0435\u0440\u0430 \u0456, \u0430\u0431\u043c\u0430\u043a\u043d\u0443\u045e\u0448\u044b \u045e \u043a\u0440\u044b\u0432\u0456, \u044f\u043a\u0430\u044f \u0446\u044f\u043a\u043b\u0430 \u0437 \u044f\u0433\u043e \u0440\u0430\u043d\u044b, \u0430\u0434\u0434\u0430\u045e \u044f\u043c\u0443 \u044f\u043a \u043d\u0430\u043f\u0430\u043c\u0456\u043d, \u0434\u043e\u043a\u0430\u0437 \u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u043b\u0456\u0442\u0430\u0439 \u043f\u0430\u043a\u0443\u0442\u043d\u0456\u0446\u043a\u0430\u0439 \u043a\u0440\u044b\u0432\u0456. \u041f\u0430\u0441\u043b\u044f \u044f\u0433\u043e, \u0443\u0436\u043e \u043d\u0435\u043f\u0440\u044b\u0442\u043e\u043c\u043d\u0430\u0433\u0430, \u043f\u0430\u043a\u043b\u0430\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043d\u0448\u044b\u043c\u0456 \u043d\u0430 \u043c\u0435\u0441\u0446\u044b, \u0434\u0437\u0435 \u0437\u0430\u0437\u0432\u044b\u0447\u0430\u0439 \u0434\u0430\u0431\u0456\u0432\u0430\u043b\u0456 \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0440\u043e\u0434 \u0437\u0430\u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u0456\u0445 \u043d\u0430 \u0430\u0440\u044d\u043d\u0443, \u043a\u0430\u0431 \u043d\u0430 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u045e\u0431\u0430\u0447\u044b\u0446\u044c, \u044f\u043a \u043c\u044f\u0447\u044b \u043f\u0440\u0430\u0446\u0456\u043d\u0430\u044e\u0446\u044c \u0456\u0445 \u0446\u0435\u043b\u044b, \u044f\u043d\u044b \u0441\u0430\u043c\u0456 \u043f\u0430\u0434\u043d\u044f\u043b\u0456\u0441\u044f \u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0442\u0443\u0434\u044b, \u0434\u0437\u0435 \u0456\u0445 \u0445\u0430\u0446\u0435\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0433\u043b\u0435\u0434\u0430\u0447\u044b. \u041f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u044f\u043d\u044b \u0430\u0431\u043d\u044f\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u043a\u0430\u0431 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0432\u0430 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u0456\u043d\u0448\u044b\u044f \u0441\u0442\u0430\u044f\u043b\u0456 \u043d\u0435\u0440\u0443\u0445\u043e\u043c\u0430 \u0456 \u043c\u043e\u045e\u0447\u043a\u0456 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043d\u0430\u043f\u0430\u0434\u044b \u0437\u0432\u044f\u0440\u043e\u045e. \u041f\u0435\u0440\u0448\u044b \u0432\u044b\u0439\u0448\u0430\u045e \u0421\u0430\u0442\u0443\u0440 \u0456, \u044f\u043a \u043f\u0440\u0430\u0434\u0431\u0430\u0447\u044b\u043b\u0430 \u041f\u044d\u0440\u043f\u044d\u0442\u0443\u044f, \u043f\u0435\u0440\u0448\u044b\u043c \u0430\u0434\u0434\u0430\u045e \u0434\u0443\u0445\u0430. \u0426\u044f\u043f\u0435\u0440 \u0451\u043d \u0447\u0430\u043a\u0430\u045e \u041f\u044d\u0440\u043f\u044d\u0442\u0443\u044e. \u0421\u0430\u043c\u0430 \u044f\u043d\u0430, \u0441\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u045e\u0448\u044b \u0431\u043e\u043b\u044e, \u0443\u0441\u043a\u0440\u044b\u043a\u043d\u0443\u043b\u0430 \u0430\u0434 \u0443\u0434\u0430\u0440\u0443 \u045e \u0431\u043e\u043a, \u0430 \u043f\u0430\u0441\u043b\u044f \u0441\u0430\u043c\u0430 \u043f\u0430\u0434\u0432\u044f\u043b\u0430 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u043e\u0440\u043b\u0430 \u043d\u044f\u045e\u043c\u0435\u043b\u0443\u044e \u0440\u0443\u043a\u0443 \u043c\u0430\u043b\u0430\u0434\u043e\u0433\u0430 \u0436\u0430\u045e\u043d\u0435\u0440\u0430. \u041d\u0430\u043f\u044d\u045e\u043d\u0430, \u0442\u0430\u043a\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0456 \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c \u0456\u043d\u0430\u043a\u0448, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430, \u0431\u043e \u0456 \u043d\u044f\u0447\u044b\u0441\u0442\u044b \u0434\u0443\u0445 \u0431\u0430\u044f\u045e\u0441\u044f \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0439\u043c\u0443\u0436\u043d\u0435\u0439\u0448\u044b\u044f \u0456 \u043d\u0430\u0439\u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0435\u0439\u0448\u044b\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456! \u0412\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u0456 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u044f \u0434\u043b\u044f \u0441\u043b\u0430\u0432\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430!<br \/> <br \/><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 8, 34b-35. 37<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430 \u0456 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441. <span style=\"color: #ff0000;\">*<\/span> \u0425\u0442\u043e \u0430\u0434\u043b\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430: \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u0446\u0456 \u043f\u0440\u044b\u0433\u043d\u0451\u0442, \u0446\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434, \u0446\u0456 \u0433\u043e\u043b\u0430\u0434, \u0446\u0456 \u0433\u0430\u043b\u0435\u0447\u0430, \u0446\u0456 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430, \u0446\u0456 \u043c\u0435\u0447?<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u0434 \u0443\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u043f\u043e\u045e\u043d\u0443\u044e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0430\u0434\u043b\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430: \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u0446\u0456 \u043f\u0440\u044b\u0433\u043d\u0451\u0442, \u0446\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434, \u0446\u0456 \u0433\u043e\u043b\u0430\u0434, \u0446\u0456 \u0433\u0430\u043b\u0435\u0447\u0430, \u0446\u0456 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430, \u0446\u0456 \u043c\u0435\u0447?<\/p>\r\n"}, {"GCH_CH_2_ID":"649","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u042f\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0437\u0430\u043a\u043e\u043d\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Archiv. gen. Ord. Hosp., Quaderno: De las cartas..., <\/span><br \/><span style=\"color: #ff0000;\">ffo 23v-24r; 27rv: O. Marcos, Cartas y \u0435scritos de Nuestro <\/span><br \/><span style=\"color: #ff0000;\">Glorioso Padre San Juan de Dios, Madrid, 1935, <\/span><br \/><span style=\"color: #ff0000;\">pp. 18-19; 48-50)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u0435\u0440\u043d\u044b, \u0401\u043d \u043f\u0430\u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u045e\u0441\u0451<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0431 \u043c\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u043b\u0456 \u043f\u0440\u0430 \u0411\u043e\u0436\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0442\u043e \u045e \u043c\u0435\u0440\u0443 \u043d\u0430\u0448\u044b\u0445 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044f\u045e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0456 \u0431 \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0431\u043e \u043a\u0430\u043b\u0456 \u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430 \u043f\u0435\u0440\u0430\u0434\u0430\u0435\u043c \u0431\u0435\u0434\u043d\u044b\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u0441\u0430\u043c \u0443\u0434\u0437\u044f\u043b\u0456\u045e \u043d\u0430\u043c, \u041f\u0430\u043d \u0430\u0431\u044f\u0446\u0430\u0435 \u043d\u0430\u043c \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u0443 \u0441\u0442\u043e \u0440\u0430\u0437\u043e\u045e \u0431\u043e\u043b\u044c\u0448 \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u041d\u044f\u0431\u0435\u0441\u043d\u044b\u043c. \u041e \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u0432\u044b\u0433\u0430\u0434\u0430 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u044c! \u0425\u0442\u043e \u0436 \u043d\u0435 \u0430\u0434\u0434\u0430\u045e \u0431\u044b \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0431\u044b\u0442\u043a\u0443 \u0433\u044d\u0442\u0430\u043c\u0443 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u043c\u0443 \u043a\u0443\u043f\u0446\u0443, \u044f\u043a\u0456 \u0440\u0443\u043f\u0456\u0446\u0446\u0430 \u0430\u0431 \u043d\u0430\u0448\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0456, \u0440\u0430\u0441\u043f\u0430\u0441\u0446\u0451\u0440\u0448\u044b \u0440\u0443\u043a\u0456, \u043f\u0440\u043e\u0441\u0456\u0446\u044c, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u042f\u0433\u043e, \u0430\u043f\u043b\u0430\u043a\u0432\u0430\u043b\u0456 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456 \u0456 \u0437 \u043b\u044e\u0431\u043e\u045e\u044e \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043d\u0430\u043c \u0441\u0430\u043c\u0456\u043c, \u0430 \u043f\u043e\u0442\u044b\u043c \u0431\u043b\u0456\u0436\u043d\u0456\u043c?<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u0431\u043e\u0433\u0456\u0445 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044e\u0434\u044b, \u0448\u0442\u043e \u044f \u0441\u0430\u043c \u0432\u0435\u043b\u044c\u043c\u0456 \u0447\u0430\u0441\u0442\u0430 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u044e\u0441\u044f, \u044f\u043a \u0456\u0445 \u043c\u043e\u0436\u043d\u0430 \u045e\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c. \u0410\u043b\u0435 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0441\u0451 \u043f\u0440\u0430\u0434\u0443\u0433\u043b\u0435\u0434\u0436\u0432\u0430\u0435 \u0456 \u045e\u0441\u0456\u0445 \u043a\u043e\u0440\u043c\u0456\u0446\u044c. \u0428\u043c\u0430\u0442 \u0443\u0431\u043e\u0433\u0456\u0445 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0434\u043e\u043c \u0411\u043e\u0436\u044b, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0433\u043e\u0440\u0430\u0434 \u0413\u0440\u0430\u043d\u0430\u0434\u0430 \u0432\u044f\u043b\u0456\u043a\u0456 \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u0445\u0430\u043b\u043e\u0434\u043d\u044b, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0446\u044f\u043f\u0435\u0440, \u0443 \u0437\u0456\u043c\u043e\u0432\u0443\u044e \u043f\u0430\u0440\u0443. \u0426\u044f\u043f\u0435\u0440 \u0433\u044d\u0442\u044b \u0434\u043e\u043c \u0437\u043c\u044f\u0448\u0447\u0430\u0435 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0441\u0442\u043e \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a: \u0445\u0432\u043e\u0440\u044b\u044f, \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u044f, \u0441\u043b\u0443\u0433\u0456, \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u044b\u044f. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430 \u0430\u0433\u0443\u043b\u044c\u043d\u044b \u0434\u043e\u043c, \u0451\u043d \u043f\u0440\u044b\u043c\u0430\u0435 \u0441\u0430\u043c\u044b\u0445 \u0440\u043e\u0437\u043d\u044b\u0445 \u0445\u0432\u043e\u0440\u044b\u0445 \u0443 \u0440\u043e\u0437\u043d\u044b\u043c \u0441\u0442\u0430\u043d\u0435: \u043f\u0430\u0440\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u043d\u044b\u0445 \u0446\u0430\u043b\u043a\u0430\u043c \u0456 \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430, \u043a\u0430\u043b\u0435\u043a\u0430\u045e, \u043f\u0440\u0430\u043a\u0430\u0436\u043e\u043d\u044b\u0445, \u043d\u044f\u043c\u044b\u0445, \u0437\u0432\u0430\u0440&rsquo;\u044f\u0446\u0435\u043b\u044b\u0445, \u043f\u0430\u043a\u0440\u044b\u0442\u044b\u0445 \u044f\u0437\u0432\u0430\u043c\u0456 \u0456 \u0445\u0432\u043e\u0440\u044b\u0445 \u043d\u0430 \u0441\u0442\u0430\u0440\u044d\u0447\u0443\u044e \u043d\u044f\u043c\u043e\u0433\u043b\u0430\u0441\u0446\u044c, \u0448\u043c\u0430\u0442 \u0434\u0437\u044f\u0446\u0435\u0439 \u0456, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u044b\u0445 \u0456 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0441\u044e\u0434\u044b \u043f\u0440\u044b\u0431\u044b\u0432\u0430\u044e\u0446\u044c. \u0423\u0441\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0430\u0433\u043e\u043d\u044c, \u0432\u0430\u0434\u0443, \u0441\u043e\u043b\u044c \u0456 \u043f\u043e\u0441\u0443\u0434, \u043a\u0430\u0431 \u0437\u0433\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u0441\u0430\u0431\u0435 \u0435\u0436\u044b. \u0410\u0434 \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0446\u0430 \u043f\u043b\u0430\u0442\u044b, \u0430\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u0432\u0430\u0435 \u045e\u0441\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u044f \u043f\u0440\u0430\u0446\u0443\u044e \u0442\u0443\u0442 \u0443 \u0434\u0430\u045e\u0433\u0430\u0445, \u0456 \u0441\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0441\u044f \u0432\u044f\u0437\u043d\u0435\u043c \u0434\u0437\u0435\u043b\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0414\u0430\u045e\u0433\u0456 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u044e\u0446\u044c \u043c\u044f\u043d\u0435, \u0448\u0442\u043e \u0447\u0430\u0441\u0442\u0430 \u044f \u043d\u0435 \u0430\u0434\u0432\u0430\u0436\u0432\u0430\u044e\u0441\u044f \u0437-\u0437\u0430 \u0456\u0445 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0434\u043e\u043c\u0443. \u041a\u0430\u043b\u0456 \u0431\u0430\u0447\u0443, \u044f\u043a \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u0435\u0434\u043d\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0456 \u0431\u043b\u0456\u0437\u043a\u0456\u0445 \u043c\u0430\u0456\u0445 \u043d\u0435\u0432\u044b\u043d\u043e\u0441\u043d\u0430 \u043f\u0430\u043a\u0443\u0442\u0443\u044e\u0446\u044c, \u044f\u043a \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0435 \u0456\u0445 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u044f \u043d\u044f\u0434\u043e\u043b\u044f, \u0430 \u044f \u043d\u0435 \u043c\u0430\u0433\u0443 \u0456\u043c \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0447\u044b, \u043c\u044f\u043d\u0435 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u0433\u043b\u044b\u0431\u043e\u043a\u0456 \u0441\u043c\u0443\u0442\u0430\u043a. \u0410\u043b\u0435 \u044f \u0434\u0430\u0432\u044f\u0440\u0430\u044e \u0425\u0440\u044b\u0441\u0442\u0443, \u0401\u043d \u0432\u0435\u0434\u0430\u0435 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430. \u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0443: \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0434\u0430\u0432\u044f\u0440\u0430\u0435 \u043b\u044e\u0434\u0437\u044f\u043c, \u0430 \u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0443, \u0431\u043e \u0445\u043e\u0447\u0430\u0448 \u0446\u0456 \u043d\u0435 \u0445\u043e\u0447\u0430\u0448, \u043b\u044e\u0434\u0437\u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0446\u044f\u0431\u0435, \u0430\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u0435\u0440\u043d\u044b \u0456 \u043d\u0430\u0434\u0437\u0435\u0439\u043d\u044b, \u0431\u043e \u0401\u043d \u043f\u0430\u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u045e\u0441\u0451. \u0406 \u042f\u043c\u0443 \u043c\u044b \u0434\u0437\u044f\u043a\u0443\u0435\u043c \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 58, 7-8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0437\u044f\u043b\u0456\u0441\u044f \u0437 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u043c \u0445\u043b\u0435\u0431\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u043f\u0443\u0441\u043a\u0430\u0439 \u0443 \u0434\u043e\u043c \u0431\u0435\u0434\u043d\u044b\u0445 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0430\u045e; <span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u0434\u044b \u0437\u0430\u0437\u0437\u044f\u0435, \u044f\u043a \u0437\u043e\u043b\u0430\u043a, \u0441\u0432\u044f\u0442\u043b\u043e \u0442\u0432\u0430\u0451, \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0442\u0432\u0430\u044f \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u043f\u0440\u0430\u043d\u0456 \u0433\u043e\u043b\u0430\u0433\u0430, \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0448, \u0456 \u0430\u0434 \u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u0445\u0430\u0432\u0430\u0439\u0441\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u0434\u044b \u0437\u0430\u0437\u0437\u044f\u0435, \u044f\u043a \u0437\u043e\u043b\u0430\u043a, \u0441\u0432\u044f\u0442\u043b\u043e \u0442\u0432\u0430\u0451, \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0442\u0432\u0430\u044f \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e.<\/p>\r\n"}, {"GCH_CH_2_ID":"650","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0416\u044b\u0446\u0446\u0451 \u0441\u0432. \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u043a\u0456 \u0420\u044b\u043c\u0441\u043a\u0430\u0439&raquo;, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u0435 \u041c\u0430\u0440\u044b\u044f\u0439 \u041c\u0430\u0433\u0434\u0430\u043b\u0435\u043d\u0430\u0439 \u0410\u043d\u0433\u0456\u043b\u044f\u0440\u044b\u044f\u0439, \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0447\u043a\u0430\u0439 \u0410\u0431\u043b\u0430\u0442\u0430\u043a.<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 6-7: Acta Sanctorum Martii 2, *185-*187)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0426\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u043b\u044e\u0431\u043e\u045e \u0441\u0432. \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u043a\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0441\u0432. \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u043a\u0456, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u044f\u0435 \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u0430\u043b\u0435 \u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u044f\u0435 \u0446\u0435\u043b\u0430, \u043f\u0430\u0441\u044b\u043b\u0430\u044e\u0447\u044b \u0448\u043c\u0430\u0442 \u043f\u0440\u0430\u0446\u044f\u0433\u043b\u044b\u0445 \u0456 \u0446\u044f\u0436\u043a\u0456\u0445 \u0445\u0432\u0430\u0440\u043e\u0431\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u044b \u045e\u0436\u043e \u0437\u0433\u0430\u0434\u0432\u0430\u043b\u0456 \u0456 \u044f\u0448\u0447\u044d \u0437\u0433\u0430\u0434\u0430\u0435\u043c. \u0410\u0434\u043d\u0430\u043a \u044f\u043d\u0430 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0440\u0430\u044f\u0432\u0456\u043b\u0430 \u043d\u0435\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0430 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0436\u044d\u0441\u0442\u0443 \u043d\u0435\u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0435\u043d\u0430\u0441\u0446\u0456 \u044f\u043a\u043e\u0439-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043f\u0430\u0441\u043b\u0443\u0433\u0430\u0439, \u043d\u0430\u0432\u0430\u0442 \u043d\u0435\u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430 \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u045e\u0447\u0430\u0441\u043d\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u0445 \u0441\u044b\u043d\u043e\u045e \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u043b\u0430 \u0441\u0442\u043e\u0439\u043a\u0430\u0441\u0446\u044c \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u043a\u0456. \u0421\u0430 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c \u044f\u043d\u0430 \u0434\u0430\u0432\u044f\u0440\u0430\u043b\u0430\u0441\u044f \u0432\u043e\u043b\u0456 \u0411\u043e\u0436\u0430\u0439 \u0456 \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u043b\u0430 \u0437\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u044f\u0435 \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u043b\u0430. \u0417 \u0442\u0430\u043a\u043e\u0439 \u0436\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u044e \u044f\u043d\u0430 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043b\u0430 \u0441\u044f\u0431\u0435 \u045e \u0430\u0434\u043d\u043e\u0441\u0456\u043d\u0430\u0445 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0431\u0433\u0430\u0432\u043e\u0440\u0432\u0430\u045e \u0456 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u045e \u044f\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0441\u0443\u0434\u0436\u0430\u045e \u044f\u0435 \u043b\u0430\u0434 \u0436\u044b\u0446\u0446\u044f. \u041d\u0435 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u043b\u0430 \u043d\u0430\u0432\u0430\u0442 \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0430\u0439 \u043d\u0435\u043f\u0440\u044b\u044f\u0437\u043d\u0430\u0441\u0446\u0456 \u0434\u0430 \u0442\u044b\u0445, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u0432\u0435\u0434\u0430\u043b\u0430, \u0448\u0442\u043e \u043d\u0435\u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u0446\u0430 \u0456 \u0434\u0443\u043c\u0430\u044e\u0446\u044c \u0430\u0431 \u0451\u0439 \u0441\u0430\u043c\u043e\u0439 \u0456 \u044f\u0435 \u0441\u043f\u0440\u0430\u0432\u0430\u0445. \u0410\u0434\u043f\u043b\u0430\u0447\u0432\u0430\u044e\u0447\u044b \u0434\u0430\u0431\u0440\u043e\u043c \u0437\u0430 \u0437\u043b\u043e, \u044f\u043d\u0430 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u0430\u043b\u0456\u043b\u0430\u0441\u044f \u0437\u0430 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u0432\u044b\u0431\u0440\u0430\u045e \u044f\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u044f\u043d\u0430 \u0441\u0430\u043c\u0430 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0441\u0442\u0430\u043b\u0430 \u0441\u0432\u044f\u0442\u043e\u0439, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u044f \u0434\u0430\u0440\u044b \u0411\u043e\u0436\u044b\u044f \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043b\u0430 \u0434\u043b\u044f \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0456 \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430 \u0441\u0432\u0430\u0456\u0445 \u0431\u043b\u0456\u0436\u043d\u0456\u0445. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u0430\u0434\u0430\u0440\u044b\u045e \u044f\u0435 \u0442\u0430\u043a\u043e\u0439 \u0430\u0431\u0430\u044f\u043b\u044c\u043d\u0430\u0441\u0446\u044e, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b, \u043a\u0430\u043c\u0443 \u0437\u0434\u0430\u0440\u0430\u043b\u0430\u0441\u044f \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u0446\u0446\u0430 \u0437 \u0451\u0439, \u0430\u0434\u0447\u0443\u0432\u0430\u045e \u0441\u0430\u043c\u0443\u044e \u0448\u0447\u044b\u0440\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0456 \u043f\u0430\u0448\u0430\u043d\u0443 \u0456 \u0431\u044b\u045e \u043f\u0430\u0434\u0430\u0442\u043b\u0456\u0432\u044b \u043d\u0430 \u043a\u043e\u0436\u043d\u0430\u0435 \u044f\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435. \u0423 \u044f\u0435 \u0441\u043b\u043e\u0432\u0430\u0445 \u0442\u043e\u0456\u043b\u0430\u0441\u044f \u0442\u0430\u043a\u0430\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0411\u043e\u0436\u0430\u044f \u0434\u0437\u0435\u0439\u0441\u043d\u0430\u0441\u0446\u044c, \u0448\u0442\u043e \u0445\u0430\u043f\u0430\u043b\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0430\u0439 \u0440\u0430\u0437\u043c\u043e\u0432\u044b, \u043a\u0430\u0431 \u0441\u0443\u0446\u0435\u0448\u044b\u0446\u044c \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u0445 \u0434\u0443\u0445\u0430\u043c, \u0441\u0443\u0446\u0456\u0448\u044b\u0446\u044c \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u043d\u044b\u0445, \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u0446\u044c \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u045e, \u0441\u0443\u043d\u044f\u0446\u044c \u0437\u0430\u0441\u0442\u0430\u0440\u044d\u043b\u0443\u044e \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0456 \u0432\u0430\u0440\u0430\u0436\u043d\u0435\u0447\u0443, \u0430 \u0447\u0430\u0441\u0442\u0430 \u0456 \u043f\u0440\u0430\u0434\u0443\u0445\u0456\u043b\u0456\u0446\u044c \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0443\u044e \u043f\u043e\u043c\u0441\u0442\u0443. \u0410\u0434\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u044f\u043d\u0430 \u043c\u043e\u0436\u0430 \u0430\u043f\u0430\u043d\u043e\u045e\u0432\u0430\u0446\u044c \u043f\u0430\u0447\u0443\u0446\u0446\u0456 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0446\u044c \u0456\u0445, \u043a\u0443\u0434\u044b \u043f\u0430\u0436\u0430\u0434\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0437 \u0443\u0441\u0456\u0445 \u0431\u0430\u043a\u043e\u045e \u0434\u0430 \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u043a\u0456 \u0441\u043f\u044f\u0448\u0430\u043b\u0456\u0441\u044f \u044f\u043a \u0434\u0430 \u0441\u0430\u043c\u0430\u0433\u0430 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0442\u0443\u043b\u043a\u0443, \u0456 \u043a\u043e\u0436\u043d\u044b \u0432\u044f\u0440\u0442\u0430\u045e\u0441\u044f \u0430\u0434 \u044f\u0435 \u0441\u0443\u0446\u0435\u0448\u0430\u043d\u044b, \u0445\u043e\u0446\u044c \u044f\u043d\u0430 \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0433\u0430\u043d\u0456\u043b\u0430 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u0456 \u0440\u0430\u0448\u0443\u0447\u0430 \u0430\u0441\u0443\u0434\u0436\u0430\u043b\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0411\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u043e\u0439 \u0447\u0430\u0441 \u0443 \u0420\u044b\u043c\u0435 \u043b\u044e\u0442\u0430\u0432\u0430\u043b\u0456 \u0440\u043e\u0437\u043d\u044b\u044f \u0445\u0432\u0430\u0440\u043e\u0431\u044b, \u0447\u0430\u0441\u0442\u0430 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u044f \u0456 \u0437\u0430\u0440\u0430\u0437\u043d\u044b\u044f. \u041f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u044e\u0447\u044b \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430\u0439 \u0437\u0430\u0440\u0430\u0437\u0456\u0446\u0446\u0430, \u0441\u0432\u044f\u0442\u0430\u044f \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0432\u0430\u0433\u0430\u043b\u0430\u0441\u044f \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0446\u044c \u0433\u043b\u044b\u0431\u043e\u043a\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u0445 \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0451\u0439 \u0447\u0443\u043b\u0430\u0441\u0446\u0456, \u044f\u043d\u0430 \u043b\u0451\u0433\u043a\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u0445 \u0456 \u043d\u0430\u0439\u043f\u0435\u0440\u0448 \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u043b\u0430 \u0456\u0445 \u0434\u0430 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f, \u0430 \u043f\u043e\u0442\u044b\u043c \u043a\u043b\u0430\u043f\u0430\u0442\u043b\u0456\u0432\u0430 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u043b\u0430 \u0456 \u0437 \u043b\u044e\u0431\u043e\u045e\u044e \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043b\u0430, \u043a\u0430\u0431 \u043f\u0430\u043a\u043e\u0440\u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0437 \u0440\u0443\u043a\u0456 \u0411\u043e\u0436\u0430\u0439 \u0443\u0441\u0435 \u043d\u044f\u0434\u043e\u043b\u0456 \u0456 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0437\u043d\u043e\u0441\u0456\u043b\u0456 \u0456\u0445 \u0434\u0437\u0435\u043b\u044f \u043b\u044e\u0431\u043e\u0432\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0435\u0440\u0448\u044b \u0442\u0430\u043a \u0448\u043c\u0430\u0442 \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0424\u0440\u0430\u043d\u0446\u0456\u0448\u043a\u0430 \u043d\u0435 \u0430\u0431\u043c\u044f\u0436\u043e\u045e\u0432\u0430\u043b\u0430\u0441\u044f \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u043c \u043f\u0440\u0430 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043c\u0430\u0433\u043b\u0430 \u043f\u0440\u044b\u0442\u0443\u043b\u0456\u0446\u044c \u0443 \u0441\u0432\u0430\u0456\u043c \u0434\u043e\u043c\u0435, \u0430\u043b\u0435 \u0448\u0443\u043a\u0430\u043b\u0430 \u0445\u0432\u043e\u0440\u044b\u0445 \u0443 \u0456\u0445\u043d\u0456\u0445 \u0445\u0430\u0446\u0456\u043d\u0430\u0445 \u0456 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u043a\u0456\u0445 \u0448\u043f\u0456\u0442\u0430\u043b\u044f\u0445. \u0417\u043d\u0430\u0439\u0448\u043e\u045e\u0448\u044b, \u044f\u043d\u0430 \u043f\u0430\u0456\u043b\u0430 \u0445\u0432\u043e\u0440\u044b\u0445, \u043f\u0435\u0440\u0430\u0441\u0446\u0456\u043b\u0430\u043b\u0430 \u0456\u043c \u043b\u043e\u0436\u043a\u0456, \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0432\u0430\u043b\u0430 \u0440\u0430\u043d\u044b. \u0427\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0430\u0433\u0456\u0434\u043d\u044b\u044f \u0456 \u043d\u0435\u0432\u044b\u043d\u043e\u0441\u043d\u044b\u044f \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0434\u043b\u044f \u044f\u0435, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u044f\u043d\u0430 \u0456\u0445 \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0432\u0430\u043b\u0430. \u0410\u0434\u043f\u0440\u0430\u045e\u043b\u044f\u044e\u0447\u044b\u0441\u044f \u045e \u043f\u0440\u044b\u0442\u0443\u043b\u0430\u043a \u043d\u0430 \u0421\u0430\u043d\u0442\u0430-\u041a\u0430\u043c\u043f\u0430, \u0431\u0440\u0430\u043b\u0430 \u0437 \u0441\u0430\u0431\u043e\u044e \u0435\u0436\u0443 \u0456 \u043d\u0430\u0432\u0430\u0442 \u043b\u0430\u0441\u0443\u043d\u043a\u0456, \u043a\u0430\u0431 \u0440\u0430\u0437\u0434\u0430\u0446\u044c \u0456\u0445 \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435. \u0412\u044f\u0440\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0434\u0430\u0434\u043e\u043c\u0443, \u0437\u0430\u0431\u0456\u0440\u0430\u043b\u0430 \u043f\u0430\u0440\u0432\u0430\u043d\u044b\u044f \u043b\u0430\u0445\u043c\u0430\u043d\u044b \u0456 \u0431\u0440\u0443\u0434\u043d\u0430\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0431\u0435\u0434\u043d\u044b\u0445. \u0427\u044b\u0441\u0442\u0430 \u043f\u0430\u043c\u044b\u045e\u0448\u044b \u044f\u0433\u043e \u0456 \u0437\u0430\u0448\u044b\u045e\u0448\u044b, \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0441\u043a\u043b\u0430\u0434\u0430\u043b\u0430, \u0430\u043a\u0440\u0430\u043f\u043b\u044f\u044e\u0447\u044b \u043f\u0430\u0445\u0443\u0447\u0430\u0441\u0446\u044f\u043c\u0456, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0433\u044d\u0442\u0430 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0434\u043b\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043c\u0430\u043b\u044c \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u0434\u043e\u045e, \u0436\u044b\u0432\u0443\u0447\u044b \u045e \u0434\u043e\u043c\u0435 \u043c\u0443\u0436\u0430, \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u043a\u0430 \u0433\u044d\u0442\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0441\u043b\u0443\u0436\u044b\u043b\u0430 \u0445\u0432\u043e\u0440\u044b\u043c \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u045e\u0441\u044f \u045e \u043f\u0440\u044b\u0442\u0443\u043b\u043a\u0430\u0445. \u041d\u0430\u0432\u0435\u0434\u0432\u0430\u043b\u0430 \u0448\u043f\u0456\u0442\u0430\u043b\u044c \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u041f\u0430\u043d\u043d\u044b \u041c\u0430\u0440\u044b\u0456 \u0456 \u0441\u0432. \u0426\u044d\u0446\u044b\u043b\u0456\u0456 \u043d\u0430 \u0434\u0440\u0443\u0433\u0456\u043c \u0431\u0435\u0440\u0430\u0437\u0435 \u0422\u044b\u0431\u0440\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0448\u043f\u0456\u0442\u0430\u043b\u044c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043d\u0430 \u0421\u0430\u043a\u0441\u0456\u0456 \u0456 \u043d\u0430 \u0421\u0430\u043d\u0442\u0430-\u041a\u0430\u043c\u043f\u0430. \u0423 \u0433\u044d\u0442\u044b \u0447\u0430\u0441 \u043f\u0430\u043c\u043e\u0440\u043a\u0443 \u0446\u044f\u0436\u043a\u0430 \u0431\u044b\u043b\u043e \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u0435\u043a\u0430\u0440\u0430\u045e, \u044f\u043a\u0456\u044f \u043b\u044f\u0447\u044b\u043b\u0456 \u0431 \u0446\u0435\u043b\u044b, \u0430\u043b\u0435 \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e, \u044f\u043a\u0456\u044f \u0434\u0430\u043b\u0456 \u0431 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u044f \u043b\u0435\u043a\u0456 \u0434\u043b\u044f \u0434\u0443\u0448\u044b. \u0422\u0430\u043c\u0443 \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u043a\u0430 \u0441\u0430\u043c\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0456 \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u043b\u0430 \u0456\u0445 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u045e\u0436\u043e \u0431\u044b\u045e \u0433\u0430\u0442\u043e\u0432\u044b \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u044b \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f \u0456 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0456. \u041a\u0430\u0431 \u0440\u0430\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u0431\u043e\u043b\u044c\u0448 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430, \u044f\u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u043a\u043e\u0448\u0442\u0430\u043c \u0443\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u044f\u043a\u0456 \u045e \u0437\u0433\u0430\u0434\u0430\u043d\u044b\u0445 \u0448\u043f\u0456\u0442\u0430\u043b\u044f\u0445 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u045e \u0443\u043a\u0430\u0437\u0430\u043d\u044b\u0445 \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u043a\u0430\u0439 \u0445\u0432\u043e\u0440\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0420\u0443\u0442 3, 10\u0430. 11b; \u043f\u0430\u0440. \u042e\u0434\u0442 13, 19\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0442\u044b \u041f\u0430\u043d\u0430\u043c, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0442\u044b \u043c\u0443\u0436\u043d\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0432\u0430\u0451 \u0456\u043c\u044f \u041f\u0430\u043d \u0443\u0437\u0432\u044f\u043b\u0456\u0447\u044b\u0446\u044c, \u0430 \u0441\u043b\u0430\u0432\u0430 \u0442\u0432\u0430\u044f \u043d\u0435 \u0441\u044b\u0434\u0437\u0435 \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u043b\u044e\u0434\u0441\u043a\u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0442\u044b \u043c\u0443\u0436\u043d\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"651","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps. 61, 4: CCL 39, 773-775)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u0443\u0442\u044b \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0433\u0430\u043b\u0430\u0432\u043e\u0439 \u0456 \u0446\u0435\u043b\u0430\u043c. \u0401\u043d \u0417\u0431\u0430\u045e\u0446\u0430 \u0446\u0435\u043b\u0430 \u0456 \u0401\u043d \u0447\u0430\u0441\u0442\u043a\u0456 \u0446\u0435\u043b\u0430 &ndash; \u0456 \u0442\u043e\u0435 \u0456 \u0434\u0440\u0443\u0433\u043e\u0435 \u045e \u0430\u0434\u043d\u044b\u043c \u0446\u0435\u043b\u0435, \u0443 \u0430\u0434\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0435 \u0456 \u045e \u0430\u0434\u043d\u043e\u0439 \u043f\u0430\u043a\u0443\u0446\u0435; \u0430 \u043a\u0430\u043b\u0456 \u043c\u0456\u043d\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0443 \u0430\u0434\u043d\u044b\u043c \u0441\u043f\u0430\u0447\u044b\u043d\u043a\u0443. \u0422\u0430\u043c\u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0456 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u044f\u043d\u044b \u043d\u0435 \u045e \u043a\u0456\u043c \u0456\u043d\u0448\u044b\u043c, \u044f\u043a \u0443 \u0425\u0440\u044b\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u044f\u043a \u0433\u0430\u043b\u0430\u0432\u0443 \u0456 \u0446\u0435\u043b\u0430, \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0406\u043c. \u041a\u0430\u043b\u0456 \u0436 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u043a \u0433\u0430\u043b\u0430\u0432\u0443, \u0442\u043e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435. \u041a\u0430\u043b\u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u0441\u0430\u043c\u0456\u043c \u0425\u0440\u044b\u0441\u0446\u0435, \u0442\u043e, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0443 \u0441\u0430\u043c\u043e\u0439 \u0433\u0430\u043b\u0430\u0432\u0435, \u0442\u0430\u043c\u0443 \u043a\u0430\u0436\u0430 \u043f\u044d\u045e\u043d\u0430\u044f \u0447\u0430\u0441\u0442\u043a\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 \u0441\u0432\u044f\u0442\u044b \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b: &laquo;\u042f\u043a \u043c\u043d\u0435 \u0434\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u043d\u0435\u0434\u0430\u0445\u043e\u043f \u0443 \u043c\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u0430 \u042f\u0433\u043e\u043d\u0430\u0435 \u0446\u0435\u043b\u0430&raquo; (\u043f\u0430\u0440. \u041a\u043b\u0441 1, 24)?<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430, \u044f\u043a\u0456 \u0433\u044d\u0442\u0430 \u0447\u0443\u0435\u0448 \u0456 \u044f\u043a\u0456 \u0446\u044f\u043f\u0435\u0440 \u043d\u0435 \u0447\u0443\u0435\u0448 \u0433\u044d\u0442\u0430\u0433\u0430 (\u043a\u0430\u043b\u0456 \u043d\u0430\u043b\u0435\u0436\u044b\u0448 \u0434\u0430 \u0447\u0430\u0441\u0442\u0430\u043a \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u043e \u045e\u0441\u0451 \u0436 \u0447\u0443\u0435\u0448), \u043a\u0430\u043b\u0456 \u0442\u044b \u043d\u0430\u043b\u0435\u0436\u044b\u0448 \u0434\u0430 \u0447\u0430\u0441\u0442\u0430\u043a \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430, \u0434\u044b\u043a \u0443\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435\u0448 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0430\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u0447\u0430\u0441\u0442\u0430\u043a \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443\u0441\u044f\u0433\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435\u0441\u0442\u0430\u0432\u0430\u043b\u0430 \u043f\u0430\u043a\u0443\u0442\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0434\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0445\u0430\u043f\u0430\u043b\u0430; \u0442\u044b \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435\u0448 \u043c\u0435\u0440\u0443, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0435\u0440\u0430\u043f\u0430\u045e\u043d\u044f\u0435\u0448; \u0431\u0443\u0434\u0437\u0435\u0448 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u043a\u043e\u043b\u044c\u043a\u0456 \u0437 \u0442\u0432\u0430\u0456\u0445 \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0434\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0434\u0430 \u045e\u0441\u0451\u0439 \u043c\u0443\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0446\u044f\u0440\u043f\u0435\u045e \u0443 \u043d\u0430\u0448\u0430\u0439 \u0433\u0430\u043b\u0430\u0432\u0435, \u0456 \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0443 \u0447\u0430\u0441\u0442\u043a\u0430\u0445 \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u045e \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430 \u0433\u044d\u0442\u0430\u0439 \u043d\u0430\u0448\u0430\u0439 \u044f\u043a \u0431\u044b \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0439 \u0434\u0437\u044f\u0440\u0436\u0430\u0432\u044b \u0434\u0430\u0434\u0430\u0435\u043c \u043a\u043e\u0436\u043d\u044b \u043f\u0430 \u043c\u0435\u0440\u044b \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044f\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b, \u0456 \u043f\u0430 \u043c\u0435\u0440\u044b \u043d\u0430\u0448\u044b\u0445 \u0441\u0456\u043b\u0430\u045e \u0443\u043d\u043e\u0441\u0456\u043c \u044f\u043a \u0431\u044b \u0434\u0430\u043d\u0456\u043d\u0443 \u043f\u0430\u043a\u0443\u0442\u0430\u045e. \u041f\u043e\u045e\u043d\u044b \u0440\u0430\u0437\u043b\u0456\u043a \u0437\u0430 \u045e\u0441\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0430\u0434\u0431\u0443\u0434\u0437\u0435\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u043a\u0430\u043d\u0446\u044b \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u0435 \u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u045e\u0441\u0435 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u0446\u044f\u0440\u043f\u0435\u043b\u0456 \u0430\u0434 \u0440\u0443\u043a \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u043f\u0440\u0430\u0434\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u041f\u0430\u043d\u0430, \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u0447\u0430\u0441\u0442\u0430\u043a \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430. \u0410\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u043d\u0435\u043f\u0440\u044b\u043c\u0430\u043b\u044c\u043d\u0430\u044f \u0434\u0443\u043c\u043a\u0430, \u0448\u0442\u043e \u0434\u0430 \u0447\u0430\u0441\u0442\u0430\u043a \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u0430\u045e \u0434\u0430 \u0434\u0437\u044f\u0440\u0436\u0430\u0432\u044b, \u0447\u044b\u0456\u043c \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0451\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u0443\u0441\u044f \u0434\u0437\u044f\u0440\u0436\u0430\u0432\u0430 \u043a\u0430\u0436\u0430 \u0433\u044d\u0442\u0430: \u0430\u0434 \u043a\u0440\u044b\u0432\u0456 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0433\u0430 \u0410\u0431\u044d\u043b\u044f \u0434\u0430 \u043a\u0440\u044b\u0432\u0456 \u0417\u0430\u0445\u0430\u0440\u044b\u0456. \u0410 \u0434\u0430\u043b\u0435\u0439 \u0430\u0434 \u043a\u0440\u044b\u0432\u0456 \u042f\u043d\u0430 \u043f\u0440\u0430\u0437 \u043a\u0440\u043e\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043f\u0440\u0430\u0437 \u043a\u0440\u043e\u045e \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e, \u043f\u0440\u0430\u0437 \u043a\u0440\u043e\u045e \u0432\u0435\u0440\u043d\u044b\u0445 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u0445 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0430\u0434\u043d\u0430 \u0434\u0437\u044f\u0440\u0436\u0430\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 21, 4; 7, 16 (\u0406\u0441 49, 10)<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u0432\u044b\u0442\u0440\u0430 \u043a\u043e\u0436\u043d\u0443\u044e \u0441\u043b\u044f\u0437\u0443 \u0437 \u0432\u0430\u0447\u044d\u0439 \u0456\u0445\u043d\u0456\u0445, \u0456 \u045e\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043d\u0456 \u0441\u043c\u0435\u0440\u0446\u0456, \u043d\u0456 \u0441\u043c\u0443\u0442\u043a\u0443, \u043d\u0456 \u043f\u043b\u0430\u0447\u0443, \u043d\u0456 \u0431\u043e\u043b\u044e, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0435 \u043c\u0456\u043d\u0443\u043b\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u0447\u0443\u0432\u0430\u0446\u044c \u043d\u0456 \u0433\u043e\u043b\u0430\u0434\u0443, \u043d\u0456 \u0441\u043c\u0430\u0433\u0456, \u0456 \u043d\u0435 \u045e\u043f\u0430\u0434\u0437\u0435 \u043d\u0430 \u0456\u0445 \u0441\u043e\u043d\u0446\u0430 \u0456 \u043d\u0456\u044f\u043a\u0430\u044f \u0441\u043f\u0451\u043a\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0435 \u043c\u0456\u043d\u0443\u043b\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"652","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 17 in \u0440salmum Qui habitat, 4, 6:<\/span><br \/><span style=\"color: #ff0000;\">Opera omnia 4, 489-491)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0420\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u0443 \u043d\u044f\u0434\u043e\u043b\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u042f \u0431\u0443\u0434\u0443 \u0437 \u0456\u043c \u0432\u0430 \u045e\u0446\u0456\u0441\u043a\u0443&raquo; (\u041f\u0441 91 [90]), 15), &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d; \u0430 \u044f \u0431\u0443\u0434\u0443 \u0448\u0443\u043a\u0430\u0446\u044c \u0447\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0433\u0430, \u0447\u044b\u043c \u0443\u0446\u0456\u0441\u043a? &laquo;\u041c\u043d\u0435 \u0434\u043e\u0431\u0440\u0430 \u0431\u044b\u0446\u044c \u0431\u043b\u0456\u0437\u043a\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430&raquo; (\u041f\u0441 73 [72], 28) \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 &laquo;\u045e \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u044f \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u0430\u0431\u0435 \u043f\u0440\u044b\u0442\u0443\u043b\u0430\u043a&raquo;, \u0431\u043e \u043a\u0430\u0436\u0430: &laquo;\u042f \u0432\u044b\u0437\u0432\u0430\u043b\u044e \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044e \u044f\u0433\u043e&raquo; (\u041f\u0441 91 [90], 15).<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0431\u0443\u0434\u0443 \u0437 \u0456\u043c \u0432\u0430 \u045e\u0446\u0456\u0441\u043a\u0443. \u041c\u043d\u0435 \u043f\u0440\u044b\u0435\u043c\u043d\u0430 \u0431\u044b\u0446\u044c \u0437 \u0441\u044b\u043d\u0430\u043c\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c\u0456 (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 8, 31). \u042d\u043c\u043c\u0430\u043d\u0443\u044d\u043b\u044c &ndash; &laquo;\u0437 \u043d\u0430\u043c\u0456 \u0411\u043e\u0433&raquo;. \u0401\u043d \u0441\u044b\u0448\u043e\u045e, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0431\u043b\u0456\u0437\u043a\u0430 \u0434\u0430 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u043c, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0437 \u043d\u0430\u043c\u0456 \u045e \u043d\u0430\u0448\u044b\u043c \u0443\u0446\u0456\u0441\u043a\u0443. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0437 \u043d\u0430\u043c\u0456, \u043a\u0430\u043b\u0456 &laquo;\u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0434\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u043d\u0430 \u0430\u0431\u043b\u043e\u043a\u0456 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u041f\u0430\u043d\u0443, \u0456 \u0433\u044d\u0442\u0430\u043a \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0437 \u041f\u0430\u043d\u0430\u043c&raquo; (1 \u0422\u044d\u0441 4, 17). \u0422\u0430\u043a \u0431\u0443\u0434\u0437\u0435, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0441\u0442\u0430\u0440\u0430\u0435\u043c\u0441\u044f, \u043a\u0430\u0431 \u041f\u0430\u043d \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u045e \u0437 \u043d\u0430\u043c\u0456, \u043a\u0430\u0431 \u0431\u044b\u045e \u043d\u0430\u0448\u044b\u043c \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u043a\u0430\u043c, \u044f\u043a\u0456 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0432\u0435\u0440\u043d\u0435 \u043d\u0430\u043c \u0430\u0439\u0447\u044b\u043d\u0443 \u0456, \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0441\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0433\u044d\u0442\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u0430\u0439, \u0430 \u043f\u0430\u043a\u0443\u043b\u044c \u0448\u0442\u043e \u0401\u043d &ndash; \u0434\u0430\u0440\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u043c\u043d\u0435 \u043b\u0435\u043f\u0435\u0439 \u0436\u044b\u0446\u044c \u0432\u0430 \u045e\u0446\u0456\u0441\u043a\u0443, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u0422\u044b \u0431\u044b\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u0447\u044b\u043c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0431\u0435\u0437 \u0426\u044f\u0431\u0435, \u0447\u044b\u043c \u0431\u0430\u043d\u043a\u0435\u0442\u0430\u0432\u0430\u0446\u044c \u0431\u0435\u0437 \u0426\u044f\u0431\u0435, \u0447\u044b\u043c \u043c\u0435\u0446\u044c \u0441\u043b\u0430\u0432\u0443 \u0431\u0435\u0437 \u0426\u044f\u0431\u0435. \u041f\u0430\u043d\u0435, \u043c\u043d\u0435 \u043b\u0435\u043f\u0435\u0439 \u0430\u0431\u0434\u044b\u043c\u0430\u0446\u044c \u0426\u044f\u0431\u0435 \u0432\u0430 \u045e\u0446\u0456\u0441\u043a\u0443, \u043c\u0435\u0446\u044c \u0426\u044f\u0431\u0435 \u0441\u0430 \u043c\u043d\u043e\u0439 \u0443 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u0430\u0439 \u043f\u0435\u0447\u044b, \u0447\u044b\u043c \u0431\u044b\u0446\u044c \u0431\u0435\u0437 \u0426\u044f\u0431\u0435 \u043d\u0430\u0432\u0430\u0442 \u0443 \u043d\u0435\u0431\u0435. \u0411\u043e &laquo;\u0445\u0442\u043e \u045e \u043c\u044f\u043d\u0435 \u0451\u0441\u0446\u044c \u0443 \u043d\u0435\u0431\u0435 \u0456 \u0447\u0430\u0433\u043e \u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u0430\u0433\u043d\u0443\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456&raquo; (\u043f\u0430\u0440. \u041f\u0441 73 [72], 25)? &laquo;\u0417\u043e\u043b\u0430\u0442\u0430 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0443 \u043f\u0435\u0447\u044b, \u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u043c\u0443\u0436\u043e\u045e \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435 \u043d\u044f\u0434\u043e\u043b\u044f&raquo; (\u043f\u0430\u0440. \u0421\u0456\u0440 27, 5). \u0422\u0430\u043c, \u0422\u044b \u0442\u0430\u043c, \u041f\u0430\u043d\u0435, \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456; \u0442\u0430\u043c \u0441\u0442\u0430\u0456\u0448 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0441\u0430\u0431\u0440\u0430\u043d\u044b\u0445 \u0443 \u0422\u0432\u0430\u0451 \u0456\u043c\u044f, \u044f\u043a \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0437 \u0442\u0440\u044b\u043c\u0430 \u0445\u043b\u043e\u043f\u0446\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043c\u0443 \u043c\u044b \u043f\u0430\u043b\u043e\u0445\u0430\u0435\u043c\u0441\u044f, \u0447\u0430\u043c\u0443 \u0432\u0430\u0433\u0430\u0435\u043c\u0441\u044f, \u0447\u0430\u043c\u0443 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0435\u043c \u0433\u044d\u0442\u0430\u0439 \u043f\u0435\u0447\u044b? \u0410\u0433\u043e\u043d\u044c \u043b\u044e\u0442\u0443\u0435, \u0430\u043b\u0435 \u041f\u0430\u043d \u0437 \u043d\u0430\u043c\u0456 \u0432\u0430 \u045e\u0446\u0456\u0441\u043a\u0443. &laquo;\u041a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0437 \u043d\u0430\u043c\u0456, \u0445\u0442\u043e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441&raquo; (\u0420\u044b\u043c 8, 31)? \u041a\u0430\u043b\u0456 \u0401\u043d \u0443\u0440\u0430\u0442\u0443\u0435, \u0446\u0456 \u0437\u043c\u043e\u0436\u0430 \u0445\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0432\u044b\u0440\u0432\u0430\u0446\u044c \u043d\u0430\u0441 \u0437 \u042f\u0433\u043e \u0440\u0443\u043a? \u0423\u0440\u044d\u0448\u0446\u0435, \u043a\u0430\u043b\u0456 \u0401\u043d \u0443\u0441\u043b\u0430\u045e\u043b\u044f\u0435, \u0446\u0456 \u043c\u043e\u0436\u0430 \u0445\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0437\u043d\u044f\u0441\u043b\u0430\u0432\u0456\u0446\u044c? \u041a\u0430\u043b\u0456 \u0401\u043d \u0443\u0441\u043b\u0430\u045e\u043b\u044f\u0435, \u0446\u0456 \u043c\u043e\u0433 \u0431\u044b \u0445\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u0446\u044c?<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0414\u0430\u045e\u0436\u044b\u043d\u0451\u044e \u0434\u0437\u0451\u043d \u044f\u0433\u043e \u043d\u0430\u0441\u044b\u0447\u0443&raquo; (\u041f\u0441 91 [90], 16). \u041d\u0456\u0431\u044b \u043a\u0430\u0436\u0430 \u0432\u044b\u0440\u0430\u0437\u043d\u0435\u0439: &laquo;\u042f \u0432\u0435\u0434\u0430\u044e, \u0447\u0430\u0433\u043e \u0451\u043d \u0436\u0430\u0434\u0430\u0435, \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u044f\u043c\u0443 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430&raquo;. \u042f\u043c\u0443 \u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u043d\u0456 \u0437\u043e\u043b\u0430\u0442\u0430, \u043d\u0456 \u0441\u0440\u044d\u0431\u0440\u0430, \u043d\u0456 \u0430\u0441\u0430\u043b\u043e\u0434\u0430, \u043d\u0456 \u0446\u0456\u043a\u0430\u045e\u043d\u0430\u0441\u0446\u044c \u0430\u0431\u043e \u043d\u0435\u0439\u043a\u0430\u044f \u0437\u044f\u043c\u043d\u0430\u044f \u0441\u043b\u0430\u0432\u0430. \u0401\u043d \u0443\u0441\u0451 \u043b\u0456\u0447\u044b\u0446\u044c \u0441\u0442\u0440\u0430\u0442\u0430\u044e, \u0443\u0441\u0456\u043c \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u0456 \u045e\u0441\u0451 \u043b\u0456\u0447\u044b\u0446\u044c \u0441\u043c\u0435\u0446\u0446\u0435\u043c. \u0401\u043d \u0434\u0430\u0440\u044d\u0448\u0442\u044b \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435 \u0456 \u043d\u0435 \u0445\u043e\u0447\u0430 \u0437\u0430\u0439\u043c\u0430\u0446\u0446\u0430 \u0442\u044b\u043c, \u0448\u0442\u043e, \u044f\u043a \u0432\u0435\u0434\u0430\u0435, \u043d\u0435 \u043c\u043e\u0436\u0430 \u043d\u0430\u0441\u044b\u0446\u0456\u0446\u044c \u044f\u0433\u043e. \u0401\u043d \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0435, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0447\u044b\u0439\u0433\u043e \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0431\u044b\u045e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0456 \u0447\u044b\u044e \u0432\u0435\u043b\u0456\u0447 \u043c\u043e\u0436\u0430 \u0437\u043c\u044f\u0441\u0446\u0456\u0446\u044c \u0443 \u0441\u0430\u0431\u0435, \u0442\u0430\u043c\u0443 \u043d\u0435 \u043f\u0430\u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u044f \u045e \u043c\u0430\u043b\u044b\u043c \u043d\u0430 \u0448\u043a\u043e\u0434\u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, &laquo;\u0434\u0430\u045e\u0436\u044b\u043d\u0451\u044e \u0434\u0437\u0451\u043d \u043d\u0430\u0441\u044b\u0447\u0443 \u0442\u0430\u0433\u043e&raquo;, \u043a\u0430\u0433\u043e \u043c\u043e\u0436\u0430 \u0430\u0436\u044b\u0432\u0456\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e. \u0413\u044d\u0442\u0430\u044f \u0434\u0430\u045e\u0436\u044b\u043d\u044f \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043c\u0435\u0436\u0430\u045e, \u0433\u044d\u0442\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0437\u0430\u0445\u0430\u0434\u0443, \u0433\u044d\u0442\u0430\u0435 \u043d\u0430\u0441\u044b\u0447\u044d\u043d\u043d\u0435 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043f\u0435\u0440\u0430\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0441\u0432\u044f\u0442\u044b, \u044f\u043a\u0456 \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u045e \u0430\u0431\u0430\u0440\u043e\u043d\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0437\u0430\u043a\u043e\u043d\u0443 \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u043d\u0435 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f \u043f\u0430\u0433\u0440\u043e\u0437 \u043d\u044f\u0433\u043e\u0434\u043d\u0456\u043a\u0430\u045e, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0451\u043d \u0441\u0442\u0430\u044f\u045e \u043d\u0430 \u0446\u0432\u0451\u0440\u0434\u0430\u0439 \u0441\u043a\u0430\u043b\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0441\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u0436\u044b\u0446\u0446\u0451\u043c \u0443 \u0441\u0432\u0435\u0446\u0435 \u0456 \u0434\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0451\u043d \u0441\u0442\u0430\u044f\u045e \u043d\u0430 \u0446\u0432\u0451\u0440\u0434\u0430\u0439 \u0441\u043a\u0430\u043b\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"654","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 &ldquo;\u0414\u0437\u0435\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e&rdquo;&raquo; \u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 3, 1. 2. 3: PG 60, 33-36. 38)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u0430\u0436\u044b, \u041f\u0430\u043d\u0435, \u043a\u0430\u0433\u043e \u0422\u044b \u0430\u0431\u0440\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0423 \u0442\u044b\u044f \u0434\u043d\u0456 \u041f\u0451\u0442\u0440 \u0441\u0442\u0430\u045e \u0441\u044f\u0440\u043e\u0434 \u0432\u0443\u0447\u043d\u044f\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e&hellip;&raquo; (\u0414\u0437 1, 15). \u041f\u0451\u0442\u0440, \u044f\u043a\u043e\u043c\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0441\u0442\u0430\u0442\u0430\u043a, \u043f\u0435\u0440\u0448\u044b \u0441\u044f\u0440\u043e\u0434 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0435\u0440\u0448\u044b\u043c \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0437 \u0437\u0430\u043f\u0430\u043b\u0430\u043c: &laquo;\u0411\u0440\u0430\u0442\u044b, \u0442\u0440\u044d\u0431\u0430 \u0432\u044b\u0431\u0440\u0430\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441&raquo; (\u043f\u0430\u0440. \u0414\u0437 1, 21-22). \u041c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0435 \u043d\u0430\u043a\u043e\u043d\u0442 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0442\u0440\u044d\u0431\u0430 \u0432\u044b\u0431\u0440\u0430\u0446\u044c, \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0441\u0430\u0431\u0440\u0430\u043d\u044b\u043c. \u0413\u044d\u0442\u0430\u043a \u0451\u043d \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435 \u043f\u0430\u0448\u0430\u043d\u0443 \u0434\u0430 \u043a\u0430\u043d\u0434\u044b\u0434\u0430\u0442\u0430\u045e \u0456 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0435 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0439 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456, \u044f\u043a\u0430\u044f \u0437\u0430\u0437\u0432\u044b\u0447\u0430\u0439 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0437\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0456\u0431\u0430 \u041f\u0451\u0442\u0440 \u043d\u0435 \u043c\u043e\u0433 \u0441\u0430\u043c \u0432\u044b\u0431\u0440\u0430\u0446\u044c? \u0417\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u043c\u043e\u0433, \u0430\u043b\u0435 \u0451\u043d \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0434\u0430\u043b\u043e\u0441\u044f, \u0448\u0442\u043e \u0434\u0430 \u043d\u0435\u043a\u0430\u0433\u0430 \u0451\u043d \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u044b. &laquo;\u0406 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u0434\u0432\u0430\u0456\u0445: \u042e\u0437\u0430\u0444\u0430, \u044f\u043a\u043e\u0433\u0430 \u0437\u0432\u0430\u043b\u0456 \u0411\u0430\u0440\u0441\u0430\u0431\u0430\u043c, \u0430 \u043f\u0440\u0430\u0437\u044b\u0432\u0430\u043b\u0456 \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c, \u0456 \u041c\u0430\u0446\u0435\u044f&raquo; (\u0414\u0437 1, 23). \u041d\u0435 \u0451\u043d \u0456\u0445 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e, \u0430\u043b\u0435 \u045e\u0441\u0435. \u041f\u0451\u0442\u0440 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u043d\u0451\u0441 \u043f\u0440\u0430\u043f\u0430\u043d\u043e\u0432\u0443, \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u044f\u043d\u0430 \u043d\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u044f\u0433\u043e, \u0430\u043b\u0435 \u0433\u044d\u0442\u0430 \u0434\u0430\u045e\u043d\u043e \u045e\u0436\u043e \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456. \u0422\u0430\u043a \u0451\u043d \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u045e, \u0430 \u043d\u0435 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0430\u0434\u0437\u0456\u043d \u0437 \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u044b\u045e \u0437 \u043d\u0430\u043c\u0456 \u045e\u0432\u0435\u0441\u044c \u0447\u0430\u0441&hellip;&raquo; ( \u043f\u0430\u0440. \u0414\u0437 1, 21). \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u044f\u043a \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u0433\u044d\u0442\u044b\u043c\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456 \u0431\u044b\u043b\u0456 \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u0446\u044b. \u0425\u043e\u0446\u044c \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0441\u044b\u0441\u0446\u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u0430\u0434\u043d\u0430\u043a \u041f\u0451\u0442\u0440 \u0432\u0435\u043b\u044c\u043c\u0456 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u045e\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0417 \u0442\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, &ndash; \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435, &ndash; \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0437 \u043d\u0430\u043c\u0456 \u045e\u0432\u0435\u0441\u044c \u0447\u0430\u0441 \u0430\u0434 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u0434\u0430 \u0430\u0434\u044b\u0445\u043e\u0434\u0443 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430&raquo;. \u0410\u0434\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u044f\u043d\u044b \u0436\u044b\u043b\u0456 \u0437 \u0406\u043c \u0456 \u0431\u044b\u043b\u0456 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u0430 \u0432\u0443\u0447\u043d\u044f\u043c\u0456. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0448\u043c\u0430\u0442 \u0456\u0448\u043b\u043e \u0437\u0430 \u0406\u043c. \u0422\u0430\u043c\u0443 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u044f\u043a \u043a\u0430\u0436\u0430: &laquo;\u0410\u0434\u0437\u0456\u043d \u0437 \u0434\u0432\u0443\u0445, \u044f\u043a\u0456\u044f \u043f\u0430\u0447\u0443\u043b\u0456 \u0430\u0434 \u042f\u043d\u0430 \u0456 \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430 \u0415\u0437\u0443\u0441\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0423\u0432\u0435\u0441\u044c \u0447\u0430\u0441, \u043a\u0430\u043b\u0456 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0437 \u043d\u0430\u043c\u0456 \u041f\u0430\u043d \u0415\u0437\u0443\u0441, \u043f\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b \u0430\u0434 \u042f\u043d\u0430\u0432\u0430\u0433\u0430 \u0445\u0440\u043e\u0441\u0442\u0443&raquo; (\u0414\u0437 1, 21). \u0421\u043b\u0443\u0448\u043d\u0430, \u0431\u043e \u0442\u044b\u0445 \u043f\u0430\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u0430\u0434\u0431\u044b\u0432\u0430\u043b\u0456\u0441\u044f \u0440\u0430\u043d\u0435\u0439, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u045e, \u0430\u043b\u0435 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b\u044f \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0410\u0436 \u0434\u0430 \u0434\u043d\u044f \u042f\u0433\u043e \u045e\u0437\u043d\u044f\u0441\u0435\u043d\u043d\u044f \u0430\u0434 \u043d\u0430\u0441, \u0441\u0442\u0430\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u043c\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u043c \u042f\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f&raquo; (\u0414\u0437 1, 22). \u041d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0421\u0432\u0435\u0434\u043a\u0430\u043c \u0456\u043d\u0448\u044b\u0445 \u0441\u043f\u0440\u0430\u045e&raquo;, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 &laquo;\u0441\u0432\u0435\u0434\u043a\u0430\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f&raquo;. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u0433\u043e\u0434\u043d\u044b\u043c \u0434\u0430\u0432\u0435\u0440\u0443 \u0431\u044b\u045e \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u043e\u0433 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u0422\u043e\u0439, \u044f\u043a\u0456 \u0435\u045e, \u043f\u0456\u045e \u0456 \u0431\u044b\u045e \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b, \u0401\u043d \u0436\u0430 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441&raquo;. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0431\u044b\u0446\u044c \u0441\u0432\u0435\u0434\u043a\u0430\u043c \u043d\u0456 \u043c\u0456\u043d\u0443\u043b\u0430\u0433\u0430, \u043d\u0456 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430, \u043d\u0456 \u0446\u0443\u0434\u0430\u045e, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f. \u0411\u043e \u0442\u044b\u044f \u043f\u0430\u0434\u0437\u0435\u0456 \u0431\u044b\u043b\u0456 \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u044b\u043c\u0456, \u0456 \u045e\u0441\u0435 \u043f\u0440\u0430 \u0456\u0445 \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0456; \u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0430\u0434\u0431\u044b\u043b\u043e\u0441\u044f \u043f\u0430\u0442\u0430\u0435\u043c\u043d\u0430 \u0456 \u0431\u044b\u043b\u043e \u0432\u044f\u0434\u043e\u043c\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u0440\u0430\u0437\u0430\u043c \u043c\u043e\u043b\u044f\u0446\u0446\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0422\u044b, \u041f\u0430\u043d\u0435, \u0432\u0435\u0434\u0430\u0435\u0448 \u0441\u044d\u0440\u0446\u044b \u045e\u0441\u0456\u0445&raquo; (\u0414\u0437 1, 24). \u0422\u044b, \u0430 \u043d\u0435 \u043c\u044b. \u0423 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441 \u043a\u043b\u0456\u0447\u0443\u0446\u044c \u0437\u043d\u0430\u045e\u0446\u0443 \u0441\u044d\u0440\u0446\u0430\u045e, \u0431\u043e \u0401\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0432\u044b\u0431\u0430\u0440, \u0430 \u043d\u0435 \u044f\u043d\u044b. \u0413\u0430\u0432\u0430\u0440\u044b\u043b\u0456 \u0437 \u0442\u0430\u043a\u0456\u043c \u0434\u0430\u0432\u0435\u0440\u0430\u043c, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u0432\u044b\u0431\u0440\u0430\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043d\u0430\u0433\u043e. \u0406 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 &laquo;\u0432\u044b\u0431\u0435\u0440\u044b&raquo;, \u0430\u043b\u0435 &laquo;\u043f\u0430\u043a\u0430\u0436\u044b&raquo; \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e &laquo;\u0422\u044b \u0432\u044b\u0431\u0440\u0430\u045e&raquo;, \u0431\u043e \u0432\u0435\u0434\u0430\u043b\u0456, \u0448\u0442\u043e \u045e\u0441\u0451 \u043f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430 \u0411\u043e\u0433\u0430\u043c. &laquo;\u0406 \u0434\u0430\u043b\u0456 \u0456\u043c \u043b\u0451\u0441\u044b&raquo;. \u042f\u043d\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u043b\u0456\u0447\u044b\u043b\u0456 \u0441\u044f\u0431\u0435 \u0432\u0430\u0440\u0442\u044b\u043c\u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0441\u0430\u043c\u0430\u0441\u0442\u043e\u0439\u043d\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0432\u044b\u0431\u0430\u0440, \u0442\u0430\u043c\u0443 \u0445\u0430\u0446\u0435\u043b\u0456 \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430 \u0437 \u043d\u0435\u0439\u043a\u0430\u0433\u0430 \u0437\u043d\u0430\u043a\u0443.<br \/> <br \/><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0437 1, 24. 25b. 26<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b, \u041f\u0430\u043d\u0435, \u0432\u0435\u0434\u0430\u0435\u0448 \u0441\u044d\u0440\u0446\u044b \u045e\u0441\u0456\u0445.<span style=\"color: #ff0000;\"> *<\/span> \u041f\u0430\u043a\u0430\u0436\u044b, \u043a\u0430\u0433\u043e \u0422\u044b \u0432\u044b\u0431\u0440\u0430\u045e, \u043a\u0430\u0431 \u0451\u043d \u0437\u0430\u043d\u044f\u045e \u043c\u0435\u0441\u0446\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u0442\u0432\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0430\u043b\u0456 \u0456\u043c \u043b\u0451\u0441\u044b, \u0456 \u0432\u044b\u043f\u0430\u045e \u043b\u0451\u0441 \u043d\u0430 \u041c\u0430\u0446\u0435\u044f, \u0456 \u0451\u043d \u0431\u044b\u045e \u0434\u0430\u043b\u0443\u0447\u0430\u043d\u044b \u0434\u0430 \u0430\u0434\u0437\u0456\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043a\u0430\u0436\u044b, \u043a\u0430\u0433\u043e \u0422\u044b \u0432\u044b\u0431\u0440\u0430\u045e, \u043a\u0430\u0431 \u0451\u043d \u0437\u0430\u043d\u044f\u045e \u043c\u0435\u0441\u0446\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u0442\u0432\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"655","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u042d\u043d\u0446\u044b\u043a\u043b\u0456\u043a\u0430 \u043f\u0430\u043f\u044b \u041f\u0456\u044f \u0425\u0406\u0406<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Litt. Enc. Invicti athletae Christi; AAS 49 (1957), 321-331)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0411\u043e\u0433\u0430 \u043b\u044e\u0431\u0456\u045e \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0451 \u0456 \u0448\u0443\u043a\u0430\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u0439 \u0445\u0432\u0430\u043b\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0416\u044b\u0446\u0446\u0451 \u0410\u043d\u0434\u0440\u044d\u044f \u0411\u0430\u0431\u043e\u043b\u0456 \u044f\u0441\u043d\u0435\u043b\u0430 \u0431\u043b\u044f\u0441\u043a\u0430\u043c \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0430\u0439 \u0432\u0435\u0440\u044b, \u043c\u043e\u0446 \u044f\u043a\u043e\u0439, \u043c\u0430\u044e\u0447\u044b \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u045e \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u0446\u044b, \u0440\u0430\u0437\u0432\u0456\u043b\u0430\u0441\u044f \u0456 \u045e\u0437\u0440\u0430\u0441\u043b\u0430 \u0437 \u0446\u044f\u0433\u0430\u043c \u0433\u0430\u0434\u043e\u045e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u0448\u0442\u043e \u0441\u0442\u0430\u043b\u0430 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0439 \u044f\u0433\u043e \u0440\u044b\u0441\u0430\u0439 \u0456 \u0437\u0440\u0430\u0431\u0456\u043b\u0430 \u043c\u0443\u0436\u043d\u044b\u043c \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u044f\u0442\u044b\u043c \u0441\u043b\u043e\u0432\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430: &laquo;\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b&raquo;, \u0432\u044b\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0432\u044b\u0440\u0430\u0437\u043d\u0430. \u0401\u043d \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u045e \u0456 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0440\u044b\u043c\u0430\u045e \u0443\u0441\u0451, \u0447\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u0430\u045e \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0456 \u0448\u0442\u043e \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u045e \u0440\u0430\u0431\u0456\u0446\u044c. \u0423\u0436\u043e \u045e \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u0451\u043d \u0443\u0442\u0430\u0439\u043c\u043e\u045e\u0432\u0430\u045e \u0443 \u0441\u0430\u0431\u0435 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u0441\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u044f\u043a\u0456\u044f \u043f\u0430\u0441\u043b\u044f \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u0430\u0433\u0430 \u045e\u043f\u0430\u0434\u043a\u0443 \u0410\u0434\u0430\u043c\u0430 \u0442\u0430\u043a \u043c\u043e\u0446\u043d\u0430 \u0441\u0430\u0442\u0440\u0430\u0441\u0430\u044e\u0446\u044c \u043d\u0430\u0448\u0443\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443, \u043b\u0451\u0433\u043a\u0430 \u0441\u0445\u0456\u043b\u044f\u044e\u0447\u044b \u044f\u0435 \u0434\u0430 \u043d\u0435\u0434\u0430\u0437\u0432\u043e\u043b\u0435\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u045e; \u0443\u0441\u0456\u043c\u0456 \u0441\u0456\u043b\u0430\u043c\u0456 \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u043c\u0456 \u0441\u0440\u043e\u0434\u043a\u0430\u043c\u0456 \u0432\u044b\u043f\u0440\u0430\u0446\u043e\u045e\u0432\u0430\u045e \u0443 \u0441\u0430\u0431\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456\u044f \u0446\u043d\u043e\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043b\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0431\u043b\u0456\u0436\u043d\u0456\u0445. \u0417 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043c\u0435\u045e \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0430\u0441\u0430\u043b\u043e\u0434\u0443, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u0456\u045e \u0434\u043e\u045e\u0433\u0456\u044f \u0433\u0430\u0434\u0437\u0456\u043d\u044b \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u044d\u0440\u043d\u0430\u043a\u0443\u043b\u044e\u043c\u0430\u043c \u0456 \u043a\u0430\u043b\u0456, \u043f\u0430 \u043c\u0435\u0440\u044b \u0441\u0432\u0430\u0456\u0445 \u0441\u0456\u043b, \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u0443 \u043a\u043e\u0436\u043d\u0430\u0439 \u043d\u044f\u0441\u0442\u0430\u0447\u044b \u0456 \u043f\u0430\u0442\u0440\u044d\u0431\u0435. \u0411\u043e\u0433\u0430 \u043b\u044e\u0431\u0456\u045e \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0451 \u0456, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0430\u0440\u0430\u0434\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0439\u0446\u0430-\u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043b\u044c\u043d\u0456\u043a\u0430, \u0448\u0443\u043a\u0430\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u0439 \u0445\u0432\u0430\u043b\u044b. \u0422\u0430\u043c\u0443 \u043d\u0456\u0447\u043e\u0433\u0430 \u0434\u0437\u0456\u045e\u043d\u0430\u0433\u0430, \u0448\u0442\u043e \u0433\u044d\u0442\u044b \u0437\u043c\u0430\u0433\u0430\u0440 \u0425\u0440\u044b\u0441\u0442\u0430, \u043c\u0430\u044e\u0447\u044b \u0442\u0430\u043a\u0456\u044f \u0440\u044b\u0441\u044b \u0434\u0443\u0445\u0430, \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0440\u0430\u0431\u0456\u045e, \u0456 \u0448\u0442\u043e \u044f\u0433\u043e \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u044f \u043f\u0440\u0430\u0446\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u0442\u0430\u043a\u0456 \u0437\u0431\u0430\u045e\u0447\u044b \u043f\u043b\u0451\u043d. \u041f\u0430\u0437\u043d\u0435\u0439, \u043a\u0430\u043b\u0456 \u0441\u0442\u0430\u045e \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u0443 \u044f\u0433\u043e \u0441\u044d\u0440\u0446\u044b \u0431\u044b\u043b\u043e \u0430\u0434\u043d\u043e \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u043a\u0430\u0431 \u043f\u0430\u0448\u044b\u0440\u0430\u0446\u044c \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0443\u044e \u0432\u0435\u0440\u0443, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0431\u0430\u0433\u0430\u0442\u044b \u043f\u043b\u0451\u043d \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u043a\u0430\u0431 \u043d\u0435 \u0448\u043a\u0430\u0434\u0443\u044e\u0447\u044b \u0441\u044f\u0431\u0435 \u0430\u0434\u0434\u0430\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u044b\u043c \u043c\u0456\u0441\u0456\u044f\u043c, \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u0446\u0442\u0432\u0443 \u0456 \u0456\u043d\u0448\u044b\u043c \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u043c \u0434\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u043f\u0440\u0430\u0432\u0430\u043c. \u0413\u044d\u0442\u044b \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u044b \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0441\u0430\u043c \u0436\u044b\u045e \u0432\u0435\u0440\u0430\u0439, \u0432\u0435\u0440\u0443 \u0440\u0443\u043f\u043b\u0456\u0432\u0430 \u043f\u0430\u0448\u044b\u0440\u0430\u045e \u0456 \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u045e, \u0456 \u0437\u0430 \u0432\u0435\u0440\u0443 \u0430\u0439\u0446\u043e\u045e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0430\u044f \u0432\u0435\u0440\u0430 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u0446\u044f\u0436\u043a\u0456\u044f \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456, \u0442\u0430\u043c\u0443 \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b\u0430\u045e \u0442\u0440\u044d\u0431\u0430 \u044f\u0435 \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0446\u044c, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0456 \u043f\u0430\u0448\u044b\u0440\u0430\u0446\u044c. \u041d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u0441\u043f\u0440\u0430\u0442\u0440\u044d\u0431\u0456\u0446\u0446\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u043c \u0456 \u0430\u0434\u043c\u043e\u0432\u0456\u0446\u0446\u0430 \u0430\u0434 \u0447\u0430\u0441\u043e\u0432\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e. \u041d\u044f\u0432\u0430\u0440\u0442\u0430 \u045e\u0445\u0456\u043b\u044f\u0446\u0446\u0430 \u0430\u0434 \u0456\u0445, \u0431\u043e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u044b\u043c \u0443 \u0441\u0432\u0430\u0451\u0439 \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456 \u0456 \u045e \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u0445. \u0411\u043e\u0433 \u0448\u0447\u043e\u0434\u0440\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0430 \u0433\u044d\u0442\u0430, \u0434\u0430\u044e\u0447\u044b \u0432\u0435\u0447\u043d\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0445\u043e\u0447\u0430\u043c \u0437 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044e \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0434\u0430\u0441\u043a\u043d\u0430\u043b\u0430\u0441\u0446\u0456, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u0435\u0434\u0430\u0446\u044c, \u0448\u0442\u043e \u0456 \u0433\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u0441\u0432\u043e\u0435\u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u043c \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430\u043c. \u0411\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u043b\u0456\u0446\u0446\u0451 \u043a\u0440\u044b\u0432\u0456 \u043c\u044b \u0434\u0430\u0435\u043c \u0411\u043e\u0433\u0443 \u0434\u043e\u043a\u0430\u0437 \u043d\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u044b, \u0430\u043b\u0435 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044e\u0447\u044b \u0441\u043f\u0430\u043a\u0443\u0441\u0430\u043c \u0433\u0440\u0430\u0445\u0443 \u0456 \u0430\u0434\u0434\u0430\u044e\u0447\u044b\u0441\u044f \u0446\u0430\u043b\u043a\u0430\u043c \u0456 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0437&rsquo;\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0448\u044b\u043c \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c \u0456 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u0435\u043c, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u045e \u043d\u0435\u0431\u0435 \u043d\u0430\u0448\u044b\u043c \u0432\u0435\u0447\u043d\u044b\u043c \u0448\u0447\u0430\u0441\u0446\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043e\u0446 \u0434\u0443\u0445\u0443 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0410\u043d\u0434\u0440\u044d\u044f \u0411\u0430\u0431\u043e\u043b\u0456 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c. \u0411\u0443\u0434\u0437\u044c\u043c\u0430 \u044f\u043a \u0451\u043d, \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u043d\u0435\u043f\u0435\u0440\u0430\u043c\u043e\u0436\u043d\u0430\u0439 \u0432\u0435\u0440\u044b, \u0437\u0430\u0445\u0430\u0432\u0430\u0435\u043c \u044f\u0435 \u0456 \u0430\u0431\u0430\u0440\u043e\u043d\u0456\u043c \u0443\u0441\u0456\u043c\u0456 \u0441\u0456\u043b\u0430\u043c\u0456. \u041d\u044f\u0445\u0430\u0439 \u0456 \u043d\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u045e\u0434\u0437\u0435\u043b\u0435\u043d\u0430 \u044f\u0433\u043e \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u044f \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044c, \u0456 \u043d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0456\u0445 \u0441\u0456\u043b\u0430\u045e \u0456 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044f\u045e \u043f\u0440\u044b\u0447\u044b\u043d\u0456\u0446\u0446\u0430 \u0434\u0430 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u044f \u0456 \u043f\u0430\u0448\u044b\u0440\u044d\u043d\u043d\u044f \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0441\u0432\u044f\u0442\u0430\u0440 \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456, &ndash; \u0441\u043a\u0430\u0437\u0430\u045e \u0410\u043d\u0434\u0440\u044d\u0439 \u043a\u0430\u0437\u0430\u043a\u0430\u043c, &ndash; \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u045e \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0430\u0439 \u0432\u0435\u0440\u044b \u0456 \u045e \u0433\u044d\u0442\u0430\u0439 \u0432\u0435\u0440\u044b \u0445\u0430\u0447\u0443 \u043f\u0430\u043c\u0435\u0440\u0446\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u044f \u0432\u0435\u0440\u0430 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u043c\u0430\u044e \u0432\u0435\u0440\u0443, \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u0456 \u045e\u0440\u0430\u0442\u0443\u0435\u0446\u0435 \u0432\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u044f \u0432\u0435\u0440\u0430 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"656","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u042f\u043d\u0430 \u0437 \u0410\u0432\u0456\u043b\u044f, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. ad amicos, 58: Opera omnia, <\/span><br \/><span style=\"color: #ff0000;\">edit. B.A.C. 1, 533-534)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041a\u0430\u0431 \u0436\u044b\u0446\u0446\u0451 \u0415\u0437\u0443\u0441\u0430 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0441<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0411\u043e\u0433 \u0456 \u0410\u0439\u0446\u0435\u0446 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0410\u0439\u0446\u0435\u0446 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0456 \u0411\u043e\u0433 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f, \u044f\u043a\u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0435 \u043d\u0430\u0441 \u0432\u0430 \u045e\u0441\u044f\u043a\u0456\u043c \u0441\u043c\u0443\u0442\u043a\u0443 \u043d\u0430\u0448\u044b\u043c, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0446\u044c \u0443\u0441\u0456\u0445 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u0442\u044b\u043c \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c, \u044f\u043a\u0456\u043c \u0411\u043e\u0433 \u0441\u0443\u0446\u044f\u0448\u0430\u0435 \u043d\u0430\u0441 \u0441\u0430\u043c\u0456\u0445. \u0411\u043e, \u044f\u043a \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u044e\u0446\u0446\u0430 \u045e \u043d\u0430\u0441 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u044f, \u0442\u0430\u043a \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435&raquo; (2 \u041a\u0430\u0440 1, 3-5).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0441\u043b\u043e\u0432\u044b \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430. \u0422\u0440\u043e\u0439\u0447\u044b \u044f\u0433\u043e \u0441\u0435\u043a\u043b\u0456 \u0431\u0456\u0437\u0443\u043d\u0430\u043c\u0456, \u043f\u044f\u0446\u044c \u0440\u0430\u0437\u043e\u045e \u0431\u0456\u043b\u0456, \u0440\u0430\u0437 \u043a\u0430\u043c\u0435\u043d\u0430\u0432\u0430\u043b\u0456 \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u044f\u043a \u043c\u0451\u0440\u0442\u0432\u0430\u0433\u0430. \u0401\u043d \u043f\u0430\u0446\u044f\u0440\u043f\u0435\u045e \u0430\u0434 \u0441\u0430\u043c\u044b\u0445 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u0445 \u043b\u044e\u0434\u0441\u043a\u0456\u0445 \u0433\u0430\u043d\u0435\u043d\u043d\u044f\u045e, \u0437\u0430\u0437\u043d\u0430\u045e \u0443\u0441\u044f\u043a\u0456\u044f \u043a\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0456 \u0456 \u043f\u0430\u043a\u0443\u0442\u044b, \u043d\u0435 \u0440\u0430\u0437 \u0446\u0456 \u0434\u0432\u0430, \u0430\u043b\u0435, \u044f\u043a \u0441\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u045e \u0443 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b: &laquo;\u041c\u044b \u0456\u0434\u0437\u0451\u043c \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0415\u0437\u0443\u0441\u0430, \u043a\u0430\u0431 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0415\u0437\u0443\u0441\u0430 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0441&raquo; (\u043f\u0430\u0440. 2 \u041a\u0430\u0440 4, 11).<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0433\u044d\u0442\u044b\u0445 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u0445 \u0451\u043d \u043d\u0435 \u043d\u0430\u0440\u0430\u043a\u0430\u0435 \u0456 \u043d\u0435 \u0436\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u0440\u043e\u0431\u044f\u0446\u044c \u0441\u043b\u0430\u0431\u044b\u044f \u043b\u044e\u0434\u0437\u0456. \u0401\u043d \u043d\u0435 \u0441\u043c\u0443\u0446\u0456\u0446\u0446\u0430, \u044f\u043a \u0440\u043e\u0431\u044f\u0446\u044c \u0437\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u0430\u0439 \u0456 \u0437\u0430\u0434\u0430\u0432\u0430\u043b\u044c\u043d\u0435\u043d\u043d\u0435\u043c. \u0401\u043d \u043d\u0435 \u045e\u043f\u0440\u043e\u0448\u0432\u0430\u0435 \u0411\u043e\u0433\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u044f\u0433\u043e \u0430\u0434 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u045e, \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u0456\u0445 \u043d\u0435 \u0437\u0432\u0435\u0434\u0430\u045e \u0456 \u0442\u0430\u043c\u0443 \u0456\u0445 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0435. \u0401\u043d \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u0456\u043c\u0456, \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u0456\u0445 \u043d\u0435\u0434\u0430\u0430\u0446\u044d\u043d\u044c\u0432\u0430\u0435. \u0410\u043b\u0435, \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430 \u045e\u0441\u044f\u043a\u0430\u0435 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0456 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u0411\u043e\u0433\u0430 \u045e \u043d\u044f\u0434\u043e\u043b\u0456 \u0456 \u0434\u0437\u044f\u043a\u0443\u0435 \u0414\u0430\u045e\u0446\u0443 \u044f\u043a \u0437\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0451\u043d \u043b\u0456\u0447\u044b\u0446\u044c \u0441\u044f\u0431\u0435 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043c\u043e\u0436\u0430 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0443 \u0433\u043e\u043d\u0430\u0440 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u0433\u0430\u043d\u044c\u0431\u0443, \u043a\u0430\u0431 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u0433\u0430\u043d\u044c\u0431\u044b \u0433\u0440\u0430\u0445\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0431 \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u0446\u044c \u043d\u0430\u0441 \u0441\u0432\u0430\u0456\u043c \u0414\u0443\u0445\u0430\u043c \u0456 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445. \u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0411\u043e\u0433 \u0434\u0430\u045e \u043d\u0430\u043c \u0443 \u0441\u0430\u0431\u0435 \u0456 \u043f\u0440\u0430\u0437 \u0441\u044f\u0431\u0435 \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0456 \u0437\u043d\u0430\u043a \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0435 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b! \u041d\u044f\u0445\u0430\u0439 \u0411\u043e\u0433 \u0440\u0430\u0441\u043f\u043b\u044e\u0448\u0447\u044b\u0446\u044c \u0432\u0430\u0448\u044b\u044f \u0432\u043e\u0447\u044b, \u043a\u0430\u0431 \u0432\u044b \u045e\u0431\u0430\u0447\u044b\u043b\u0456, \u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u045e \u0401\u043d \u0434\u0430\u0435 \u045e \u0442\u044b\u043c, \u0447\u044b\u043c \u0441\u0432\u0435\u0442 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435. \u042f\u043a\u0456 \u0433\u043e\u043d\u0430\u0440 \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0435 \u043d\u0430\u0441 \u0443 \u0433\u0430\u043d\u044c\u0431\u0435, \u043a\u0430\u043b\u0456 \u043c\u044b \u0448\u0443\u043a\u0430\u0435\u043c \u0441\u043b\u0430\u0432\u044b \u0411\u043e\u0436\u0430\u0439! \u042f\u043a\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u0430\u044f \u0434\u043b\u044f \u043d\u0430\u0441 \u0443 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456\u0445 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445! \u042f\u043a\u0456\u044f \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u043a\u0456\u044f, \u043b\u0430\u0441\u043a\u0430\u0432\u044b\u044f \u0456 \u043f\u044f\u0448\u0447\u043e\u0442\u043d\u044b\u044f \u0440\u0443\u043a\u0456 \u0411\u043e\u0433 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435 \u043d\u0430\u043c, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u044b\u0445 \u0443 \u0441\u0432\u0430\u0456\u0445 \u0431\u0456\u0442\u0432\u0430\u0445, \u0448\u0442\u043e, \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0434\u0430\u0434\u0430\u0435 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u0434\u0430 \u045e\u0441\u044f\u043a\u0430\u0433\u0430 \u043c\u0451\u0434\u0443, \u044f\u043a\u0456 \u043c\u043e\u0436\u0430 \u0441\u0443\u043d\u044f\u0446\u044c \u0443\u0441\u0435 \u0433\u043e\u0440\u044b\u0447\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u041a\u0430\u043b\u0456 \u043c\u044b \u043f\u0430\u043a\u0430\u0448\u0442\u0443\u0435\u043c \u0433\u044d\u0442\u0430\u0433\u0430, \u0442\u043e \u0433\u043e\u0440\u0430\u0447\u0430 \u0437\u0430\u043f\u0440\u0430\u0433\u043d\u0435\u043c \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u044f \u0440\u0443\u043a\u0456. \u041a\u043e\u0436\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0436\u0430\u0434\u0430\u043d\u043d\u044f, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0451\u043d \u043d\u0435 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u045e\u0441\u044f\u043a\u0456\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u044b\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u044c \u0432\u0430\u043c \u0430\u0441\u0430\u043b\u043e\u0434\u0443 \u0456 \u0432\u044b \u0445\u043e\u0447\u0430\u0446\u0435 \u0456\u0445 \u0431\u0430\u0447\u044b\u0446\u044c \u0456 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u0456\u043c\u0456, \u0432\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u0434\u0430 \u0456\u0445 \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u0448\u043b\u044f\u0445\u0443, \u044f\u043a \u043f\u0440\u0430\u0437 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435. \u0413\u044d\u0442\u0430 \u0434\u0430\u0440\u043e\u0433\u0430, \u044f\u043a\u043e\u0439 \u043f\u0430\u0439\u0448\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0456 \u045e\u0441\u0435 \u044f\u0433\u043e \u043f\u0430\u0441\u043b\u044f\u0434\u043e\u045e\u043d\u0456\u043a\u0456. \u041f\u0430\u043d \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0434\u0430\u0440\u043e\u0433\u0430 \u0432\u0443\u0437\u043a\u0430\u044f, \u0430\u043b\u0435 \u044f\u043d\u0430 \u0432\u044f\u0434\u0437\u0435 \u043f\u0440\u043e\u0441\u0442\u0430 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f. \u0401\u043d \u0432\u0443\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043c\u044b \u0436\u0430\u0434\u0430\u0435\u043c \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043a\u0440\u043e\u0447\u044b\u0446\u044c \u0448\u043b\u044f\u0445\u0430\u043c, \u044f\u043a\u0456\u043c \u0401\u043d \u0456\u0448\u043e\u045e. \u0411\u043e, \u043a\u0430\u043b\u0456 \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u0456\u0448\u043e\u045e \u0448\u043b\u044f\u0445\u0430\u043c \u0433\u0430\u043d\u044c\u0431\u044b, \u043d\u044f\u0433\u043e\u0436\u0430, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u0441\u044b\u043d\u044b \u0456\u0448\u043b\u0456 \u0448\u043b\u044f\u0445\u0430\u043c \u0433\u043e\u043d\u0430\u0440\u0443, \u0431\u043e &laquo;\u0432\u0443\u0447\u0430\u043d\u044c \u043d\u0435 \u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0437\u0430 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430, \u0456 \u0441\u043b\u0443\u0433\u0430 \u043d\u0435 \u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0437\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0441\u0432\u0430\u0439\u0433\u043e&raquo; (\u041c\u0446 10, 24).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0411\u043e\u0433 \u0443\u0447\u044b\u043d\u0456\u0446\u044c, \u043a\u0430\u0431 \u043d\u0430\u0448 \u0434\u0443\u0445 \u043d\u0456\u0434\u0437\u0435 \u043d\u0435 \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u045e \u0456 \u043d\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0456\u043d\u0448\u0430\u0433\u0430 \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0443 \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u043f\u0440\u0430\u0446\u0430\u0445, \u044f\u043a\u0456\u044f \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u043a\u0440\u044b\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 4, 11. 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b, \u0436\u044b\u0432\u044b\u044f, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0456\u0434\u0437\u0451\u043c \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0415\u0437\u0443\u0441\u0430, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0415\u0437\u0443\u0441\u0430 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0448\u044b\u043c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0446\u0435\u043b\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u043e\u0446\u044c \u0437\u043d\u0435\u0448\u043d\u0456 \u043d\u0430\u0448 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0456 \u0442\u043b\u0435\u0435, \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0437 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u0430\u0431\u043d\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0415\u0437\u0443\u0441\u0430 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0448\u044b\u043c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0446\u0435\u043b\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"657","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u044b\u043d\u0430 \u0421\u0456\u0435\u043d\u0441\u043a\u0430\u0433\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 49, De glorioso Nomine Iesu Christi, cap. 2:<\/span><br \/><span style=\"color: #ff0000;\">Opera omnia, 4, 505-506)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0406\u043c\u044f \u0415\u0437\u0443\u0441\u0430 &ndash; \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0406\u043c\u044f \u0415\u0437\u0443\u0441\u0430 &ndash; \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u044f\u043d\u043e \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0441\u0432\u0430\u0456\u043c \u0437\u0437\u044f\u043d\u043d\u0435\u043c \u044f\u043a \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435, \u0442\u0430\u043a \u0456 \u0441\u043b\u0443\u0445\u0430\u043d\u043d\u0435 \u0441\u043b\u043e\u0432\u0430. \u0410\u0434\u043a\u0443\u043b\u044c \u0436\u0430 \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0440\u0430\u0441\u043f\u0430\u045e\u0441\u044e\u0434\u0436\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u043e\u0435 \u044f\u0440\u043a\u0430\u0435, \u0442\u0430\u043a\u043e\u0435 \u0440\u0430\u043f\u0442\u043e\u045e\u043d\u0430\u0435 \u0456 \u0430\u0441\u043b\u044f\u043f\u043b\u044f\u043b\u044c\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0432\u0435\u0440\u044b, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437 \u043f\u0440\u043e\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0415\u0437\u0443\u0441\u0430? \u0426\u0456 \u043d\u0435 \u043f\u0440\u0430\u0437 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u0432\u043e\u0434\u0430\u0440 \u0433\u044d\u0442\u0430\u0433\u0430 \u0406\u043c\u044f \u0411\u043e\u0433 &laquo;\u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430\u0441 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430&raquo; (\u043f\u0430\u0440. 1 \u041f 2, 9)? \u0422\u0430\u043c\u0443 \u0441\u0432\u044f\u0442\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0441\u043b\u0443\u0448\u043d\u0430 \u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u0435 \u045e\u0431\u0430\u0447\u044b\u045e \u0441\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e: &laquo;\u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0432\u044b \u0431\u044b\u043b\u0456 \u0446\u0435\u043c\u0440\u0430\u0439, \u0430 \u0446\u044f\u043f\u0435\u0440 \u0432\u044b \u0441\u0432\u044f\u0442\u043b\u043e \u045e \u041f\u0430\u043d\u0443. \u041f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435, \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u0441\u0432\u044f\u0442\u043b\u0430&raquo; (\u042d\u0444 5, 8).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0433\u044d\u0442\u0430\u0435 \u0406\u043c\u044f, \u043a\u0430\u0431 \u044f\u043d\u043e \u0441\u0432\u044f\u0446\u0456\u043b\u0430, \u0430 \u043d\u0435 \u0445\u0430\u0432\u0430\u043b\u0430\u0441\u044f. \u0410\u0434\u043d\u0430\u043a \u044f\u0433\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0446\u0456 \u0431\u0440\u0443\u0434\u043d\u044b\u043c\u0456 \u0432\u0443\u0441\u043d\u0430\u043c\u0456, \u0430\u043b\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0443 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u043d\u0430\u0447\u044b\u043d\u043d\u0456 \u0456 \u0432\u044b\u0446\u044f\u0433\u0432\u0430\u0446\u044c \u0430\u0434\u0442\u0443\u043b\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430: &laquo;\u0413\u044d\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a &ndash; \u041c\u0430\u0451 \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0435 \u043d\u0430\u0447\u044b\u043d\u043d\u0435. \u0401\u043d \u0437\u0430\u043d\u044f\u0441\u0435 \u0456\u043c\u044f \u041c\u0430\u0451 \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u043a\u0430\u0440\u0430\u043b\u044f\u043c \u0456 \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f&raquo; (\u043f\u0430\u0440. \u0414\u0437 9, 15). \u041d\u0430\u0437\u044b\u0432\u0430\u0435 &laquo;\u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u043d\u0430\u0447\u044b\u043d\u043d\u0435\u043c&raquo;, \u0443 \u044f\u043a\u0456\u043c \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043d\u0430\u0439\u0441\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u044b \u043d\u0430\u043f\u043e\u0439 \u043d\u0430 \u043f\u0440\u043e\u0434\u0430\u0436, \u043a\u0430\u0431 \u043f\u0435\u0440\u0430\u043b\u0456\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u0456 \u0437\u0437\u044f\u044e\u0447\u044b \u045e \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u043d\u0430\u0447\u044b\u043d\u043d\u0456, \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u045e \u0434\u0430 \u043f\u0456\u0446\u0446\u044f, &laquo;\u043a\u0430\u0431 \u0437\u0430\u043d\u0435\u0441\u0446\u0456, &ndash; \u0434\u0430\u0434\u0430\u0435, &ndash; \u041c\u0430\u0451 \u0456\u043c\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0441\u0430\u0431\u0440\u0430\u045e\u0448\u044b \u045e\u0440\u0430\u0434\u0436\u0430\u0439, \u0437\u0430\u043f\u0430\u043b\u044c\u0432\u0430\u044e\u0446\u044c \u0430\u0433\u043e\u043d\u044c, \u043a\u0430\u0431 \u0451\u043d \u0441\u043f\u0430\u043b\u0456\u045e \u0448\u043a\u043e\u0434\u043d\u0430\u0435 \u043f\u0443\u0441\u0442\u0430\u0437\u0435\u043b\u043b\u0435 \u0456 \u0446\u0435\u0440\u043d\u0435; \u044f\u043a \u043f\u0440\u044b \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0435 \u043f\u0440\u043e\u043c\u043d\u044f\u045e \u0441\u043e\u043d\u0446\u0430, \u044f\u043a\u0456\u044f \u0440\u0430\u0441\u0441\u0435\u0439\u0432\u0430\u044e\u0446\u044c \u0437\u043c\u0440\u043e\u043a, \u0445\u0430\u0432\u0430\u044e\u0446\u0446\u0430 \u0437\u043b\u043e\u0434\u0437\u0435\u0456, \u043d\u0430\u0447\u043d\u044b\u044f \u0431\u0430\u0434\u0437\u044f\u0433\u0456 \u0456 \u045e\u0437\u043b\u043e\u043c\u0448\u0447\u044b\u043a\u0456, \u0442\u0430\u043a \u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0441\u0432\u044f\u0442\u044b \u041f\u0430\u0432\u0435\u043b \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u045e \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u044f\u043a \u0430\u0434 \u0430\u0433\u043b\u0443\u0448\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0433\u0440\u043e\u043c\u0443, \u044f\u043a \u043f\u0430\u0434 \u043d\u0430\u043f\u043e\u0440\u0430\u043c \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0430\u0433\u043d\u044e, \u044f\u043a \u045e \u0430\u0441\u043b\u044f\u043f\u043b\u044f\u043b\u044c\u043d\u044b\u043c \u0437\u0437\u044f\u043d\u043d\u0456 \u0441\u043e\u043d\u0446\u0430, \u0433\u0456\u043d\u0443\u043b\u0430 \u0431\u044f\u0437\u0432\u0435\u0440&rsquo;\u0435, \u0437\u043d\u0456\u043a\u0430\u045e \u0444\u0430\u043b\u044c\u0448, \u0430 \u043f\u0440\u0430\u045e\u0434\u0430 \u0437\u0437\u044f\u043b\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0432\u043e\u0441\u043a, \u0448\u0442\u043e \u0440\u0430\u0441\u0442\u0430\u043f\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u0434 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0430\u0433\u043d\u0451\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043f\u0430\u045e\u0441\u044e\u043b\u044c \u043d\u0451\u0441 \u043f\u0435\u0440\u0430\u0434 \u0441\u0430\u0431\u043e\u044e \u0456\u043c\u044f \u0415\u0437\u0443\u0441\u0430 \u045e \u0441\u043b\u043e\u0432\u0430\u0445, \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f\u0445, \u0446\u0443\u0434\u0430\u0445 \u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u0445. \u0401\u043d &laquo;\u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u045e&raquo; \u0456\u043c\u044f \u0415\u0437\u0443\u0441\u0430 \u0456 &laquo;\u0430\u043f\u044f\u0432\u0430\u045e \u044f\u0433\u043e \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e&raquo; (\u043f\u0430\u0440. \u0421\u0456\u0440 51, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043d\u0451\u0441 \u0433\u044d\u0442\u0430\u0435 \u0456\u043c\u044f \u044f\u043a \u0441\u0432\u044f\u0442\u043b\u043e &laquo;\u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u043a\u0430\u0440\u0430\u043b\u044f\u043c \u0456 \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f&raquo;, \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u044e\u0447\u044b \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u043e\u0447 \u043c\u0456\u043d\u0443\u043b\u0430 \u0456 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u045e\u0441\u044f \u0434\u0437\u0435\u043d\u044c: \u0434\u044b\u043a \u0430\u0434\u043a\u0456\u043d\u0435\u043c \u0443\u0447\u044b\u043d\u043a\u0456 \u0446\u0435\u043c\u0440\u044b \u0456 \u0430\u043f\u0440\u0430\u043d\u0435\u043c\u0441\u044f \u045e \u0437\u0431\u0440\u043e\u044e \u0441\u0432\u044f\u0442\u043b\u0430. \u042f\u043a \u0443 \u0434\u0437\u0435\u043d\u044c, \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u0441\u0442\u043e\u0439\u043d\u0430&raquo; (\u0420\u044b\u043c 13, 12). \u0406 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u045e \u0443\u0441\u0456\u043c \u044f\u0440\u043a\u0443\u044e \u0437\u0430\u043f\u0430\u043b\u0435\u043d\u0443\u044e \u043d\u0430 \u043f\u0430\u0434\u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0443 \u043f\u0430\u0445\u043e\u0434\u043d\u044e, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u045e \u043a\u043e\u0436\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b &laquo;\u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u0442\u043e \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430&raquo; (1 \u041a\u0430\u0440 2, 2).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b, \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430, \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0411\u043e\u0436\u0430, \u0422\u044b \u0432\u0443\u0447\u044b\u045e \u043c\u044f\u043d\u0435 \u0437 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u0456 \u043c\u0430\u0451\u0439, \u0456 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u044f \u0446\u0443\u0434\u044b \u0422\u0432\u0430\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e&raquo; (\u041f\u0441 71 [70]), 17). \u041f\u0440\u0430\u0440\u043e\u043a \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u043d\u0430\u0441 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0443, \u0441\u043b\u0430\u045e\u0446\u0435 \u042f\u0433\u043e\u043d\u0430\u0435 \u0456\u043c\u044f, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u0446\u0435 \u0437 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u042f\u0433\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435&raquo; (\u041f\u0441 96 [95], 2).<br \/> <br \/><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0456\u0440 51, 15ab; \u041f\u0441 9, 3<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0443 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0422\u0432\u0430\u0451 \u0456\u043c\u044f <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0430\u043f\u044f\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0443\u0434\u0443 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0422\u0430\u0431\u0435 \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430, \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0456\u043c\u0435\u043d\u0456 \u0422\u0432\u0430\u0439\u043c\u0443, \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0430\u043f\u044f\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e.<\/p>\r\n"}, {"GCH_CH_2_ID":"658","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u041a\u0443\u0442\u0431\u044d\u0440\u0442\u0430 \u043f\u0440\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0441\u0432. \u0411\u044d\u0434\u044b \u0412\u044f\u043b\u0435\u0431\u043d\u0430\u0433\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 4-6: PL 90, 64-66)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u0433\u043d\u0443 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u0441\u043b\u044f \u0423\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u044f \u041f\u0430\u043d\u0430 \u0441\u0442\u0430\u043d \u0411\u044d\u0434\u044b \u043f\u0430\u0433\u043e\u0440\u0448\u044b\u045e\u0441\u044f \u0456 \u0451\u043d \u043f\u0430\u0447\u0430\u045e \u0446\u044f\u0436\u043a\u0430 \u0434\u044b\u0445\u0430\u0446\u044c, \u0430 \u043d\u043e\u0433\u0456 \u043f\u0430\u0447\u0430\u043b\u0456 \u043a\u0440\u044b\u0445\u0443 \u0430\u0446\u044f\u043a\u0430\u0446\u044c. \u0423\u0432\u0435\u0441\u044c \u0434\u0437\u0435\u043d\u044c \u0451\u043d \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u043d\u0430\u0432\u0443\u0447\u0430\u045e \u0456 \u0434\u044b\u043a\u0442\u0430\u0432\u0430\u045e, \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u043d\u0435\u0439\u043a\u0456 \u043c\u043e\u043c\u0430\u043d\u0442 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0421\u043f\u044f\u0448\u0430\u0439\u0446\u0435\u0441\u044f \u0432\u0443\u0447\u044b\u0446\u0446\u0430, \u0431\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0446\u0456 \u0434\u043e\u045e\u0433\u0430 \u044f\u0448\u0447\u044d \u043f\u0440\u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0441\u044f, \u0446\u0456 \u043d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435 \u0437\u0430\u0431\u044f\u0440\u044d \u043c\u044f\u043d\u0435 \u043c\u043e\u0439 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c&raquo;. \u0410\u043b\u0435 \u043d\u0430\u043c \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u0451\u043d \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0435 \u0447\u0430\u0441 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u043a\u043e\u043d\u0443. \u0406 \u0442\u0430\u043a \u0451\u043d \u043f\u0440\u0430\u0432\u0451\u045e \u0446\u044d\u043b\u0443\u044e \u043d\u043e\u0447, \u0443\u0437\u043d\u043e\u0441\u044f\u0447\u044b \u043f\u0430\u0434\u0437\u044f\u043a\u0443 \u0411\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0433\u0430 \u0434\u043d\u044f, \u0443 \u0441\u0435\u0440\u0430\u0434\u0443, \u0451\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043d\u0430\u043c \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u043f\u0456\u0441\u0430\u0446\u044c \u0434\u0430\u043b\u0435\u0439, \u0448\u0442\u043e \u043c\u044b \u0456 \u0440\u0430\u0431\u0456\u043b\u0456 \u0430\u0436 \u0434\u0430 \u0434\u0437\u0435\u0432\u044f\u0442\u0430\u0439 \u0433\u0430\u0434\u0437\u0456\u043d\u044b. \u0410 \u0434\u0437\u0435\u0432\u044f\u0442\u0430\u0439, \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0437\u0432\u044b\u0447\u0430\u0435\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f, \u043c\u044b \u043f\u0440\u0430\u0432\u044f\u043b\u0456 \u043f\u0440\u0430\u0446\u044d\u0441\u0456\u044e \u0437 \u0440\u044d\u043b\u0456\u043a\u0432\u0456\u044f\u043c\u0456 \u0441\u0432\u044f\u0442\u044b\u0445. \u0410\u0434\u0437\u0456\u043d \u0437 \u043d\u0430\u0441, \u044f\u043a\u0456 \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u0437 \u0456\u043c, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a, \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u044f\u0448\u0447\u044d \u0430\u0434\u043d\u0430\u0433\u043e \u0440\u0430\u0437\u0434\u0437\u0435\u043b\u0430 \u045e \u043a\u043d\u0456\u0437\u0435, \u044f\u043a\u0443\u044e \u0434\u044b\u043a\u0442\u0443\u0435\u0448; \u043c\u043e\u0436\u0430, \u0442\u0430\u0431\u0435 \u0446\u044f\u0436\u043a\u0430 \u0434\u0430\u043b\u0435\u0439 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c?&raquo; \u0411\u044d\u0434\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u041b\u0451\u0433\u043a\u0430, \u0432\u0430\u0437\u044c\u043c\u0456 \u043f\u044f\u0440\u043e, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439\u0441\u044f \u0456 \u0445\u0443\u0442\u043a\u0430 \u043f\u0456\u0448\u044b&raquo;. \u0422\u043e\u0439 \u0442\u0430\u043a \u0456 \u0437\u0440\u0430\u0431\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0442\u0440\u044d\u0446\u044f\u0439 \u0433\u0430\u0434\u0437\u0456\u043d\u0435 \u043f\u0430\u043f\u0430\u045e\u0434\u043d\u0456 \u0451\u043d \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u043c\u044f\u043d\u0435: &laquo;\u0423 \u043c\u044f\u043d\u0435 \u0451\u0441\u0446\u044c \u043f\u044d\u045e\u043d\u044b\u044f \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u044f \u0440\u044d\u0447\u044b \u045e \u043a\u0443\u0444\u044d\u0440\u043a\u0443: \u043f\u0435\u0440\u0430\u0446, \u043d\u0430\u0441\u043e\u045e\u043a\u0456 \u0456 \u0434\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u0434\u043b\u044f \u043a\u0430\u0434\u0437\u0456\u043b\u0430; \u0431\u044f\u0436\u044b \u0445\u0443\u0442\u0447\u044d\u0439 \u0456 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u0434\u0430 \u043c\u044f\u043d\u0435 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e \u043d\u0430\u0448\u0430\u0433\u0430 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u0430, \u0456 \u044f \u0440\u0430\u0437\u0434\u0430\u043c \u0456\u043c \u0433\u044d\u0442\u044b\u044f \u043f\u0430\u0434\u0430\u0440\u0443\u043d\u0430\u0447\u043a\u0456, \u044f\u043a\u0456\u044f \u043c\u043d\u0435 \u0411\u043e\u0433 \u043f\u0430\u0434\u0430\u0440\u0430\u0432\u0430\u045e&raquo;. \u041a\u0430\u043b\u0456 \u0442\u044b\u044f \u043f\u0440\u044b\u0439\u0448\u043b\u0456, \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0456\u0445 \u0456, \u0437\u0430\u043a\u043b\u0456\u043d\u0430\u044e\u0447\u044b \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u043f\u0440\u0430\u0441\u0456\u045e \u0446\u044d\u043b\u0435\u0431\u0440\u0430\u0432\u0430\u0446\u044c \u0437\u0430 \u044f\u0433\u043e \u0406\u043c\u0448\u0443 \u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u0448\u0442\u043e \u044f\u043d\u044b \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u043b\u0456\u0441\u044f \u0456 \u0437\u0430\u043f\u043b\u0430\u043a\u0430\u043b\u0456, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043a\u0430\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u043d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435 \u045e\u0436\u043e \u043d\u0435 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435. \u0410\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f, \u043a\u0430\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0430\u0441\u0442\u0430\u045e \u0447\u0430\u0441 (\u043a\u0430\u043b\u0456 \u0442\u0430\u043a \u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u043c\u0430\u0439\u043c\u0443 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044e), \u043a\u0430\u0431 \u044f \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u044f\u043d\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u045e, \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0437 \u043d\u0456\u0447\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u044f \u044f\u0448\u0447\u044d \u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u045e. \u042f \u043f\u0440\u0430\u0436\u044b\u045e \u0434\u043e\u045e\u0433\u0456 \u0447\u0430\u0441; \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0421\u0443\u0434\u0434\u0437\u044f \u0434\u043e\u0431\u0440\u0430 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u043c\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c, &ldquo;\u043d\u0430\u0441\u0442\u0430\u045e \u0447\u0430\u0441 \u043c\u0430\u0439\u0433\u043e \u0430\u0434\u044b\u0445\u043e\u0434\u0443&rdquo; (2 \u0426\u0456\u043c 4, 6), \u0431\u043e &ldquo;\u043c\u0430\u044e \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0456 \u0431\u044b\u0446\u044c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c&rdquo; (\u0424\u043b\u043f 1, 23); \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u043f\u0440\u0430\u0433\u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u043c\u0430\u0439\u0433\u043e \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430, \u0432\u0430 \u045e\u0441\u0451\u0439 \u042f\u0433\u043e \u043a\u0440\u0430\u0441\u0435&raquo;. \u0421\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0448\u043c\u0430\u0442 \u0456\u043d\u0448\u0430\u0433\u0430 \u0434\u043b\u044f \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0456 \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0432\u0451\u045e \u0434\u0437\u0435\u043d\u044c \u0434\u0430 \u0432\u0435\u0447\u0430\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b, \u0437\u0433\u0430\u0434\u0430\u043d\u044b \u0440\u0430\u043d\u0435\u0439 \u044e\u043d\u0430\u043a \u0412\u0456\u0431\u044d\u0440\u0442 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u0448\u0447\u044d: &laquo;\u0414\u0430\u0440\u0430\u0433\u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a, \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u0441\u043a\u0430\u0437\u0430&raquo;. \u0411\u044d\u0434\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0456\u0448\u044b \u0445\u0443\u0442\u043a\u0430&raquo;. \u041f\u0440\u0430\u0437 \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u044e\u043d\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0426\u044f\u043f\u0435\u0440 \u0441\u043a\u0430\u0437 \u0434\u0430\u043f\u0456\u0441\u0430\u043d\u044b&raquo;. \u0411\u044d\u0434\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u044b \u0434\u043e\u0431\u0440\u0430 \u0441\u043a\u0430\u0437\u0430\u045e: \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f. \u0412\u0430\u0437\u044c\u043c\u0456 \u043c\u0430\u044e \u0433\u0430\u043b\u0430\u0432\u0443 \u045e \u0441\u0432\u0430\u0435 \u0434\u0430\u043b\u043e\u043d\u0456, \u0431\u043e \u044f \u0432\u0435\u043b\u044c\u043c\u0456 \u043b\u044e\u0431\u043b\u044e \u0441\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430\u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0443 \u044f\u043a\u043e\u0439 \u044f \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u043c\u0430\u043b\u0456\u045e\u0441\u044f, \u043a\u0430\u0431 \u044f \u043c\u043e\u0433, \u0441\u0435\u0434\u0437\u044f\u0447\u044b, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u043c\u0430\u0439\u0433\u043e \u0410\u0439\u0446\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u0433\u043e \u043f\u0430\u043a\u043b\u0430\u043b\u0456 \u043d\u0430 \u043f\u0430\u0434\u043b\u043e\u0433\u0443. \u0422\u0430\u043a \u0451\u043d, \u0441\u043f\u044f\u0432\u0430\u044e\u0447\u044b \u043d\u0430 \u043f\u0430\u0434\u043b\u043e\u0437\u0435 \u0441\u0432\u0430\u0451\u0439 \u043a\u0435\u043b\u043b\u0456 &laquo;\u0425\u0432\u0430\u043b\u0430 \u0410\u0439\u0446\u0443 \u0456 \u0421\u044b\u043d\u0443, \u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443&raquo;, \u043a\u0430\u043b\u0456 \u043d\u0430\u0437\u0432\u0430\u045e \u0456\u043c\u044f \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043f\u0430\u043c\u0451\u0440. \u041c\u044b \u0436 \u043d\u0435 \u0441\u0443\u043c\u043d\u044f\u0435\u043c\u0441\u044f \u0456 \u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0437\u0430 \u0441\u0432\u0430\u044e \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0443\u044e \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0411\u043e\u0433\u0430 \u0442\u0443\u0442 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0451\u043d \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u0436\u0430\u0434\u0430\u043d\u044b\u0445 \u0440\u0430\u0434\u0430\u0441\u0446\u044f\u045e \u043d\u0435\u0431\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0451 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u044f \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u0456\u045e \u0443 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u044b, \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0434\u0434\u0430\u044e\u0447\u044b \u0441\u044f\u0431\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044e \u043d\u0430\u0434 \u0421\u0432\u044f\u0442\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0435\u043c, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0437\u0430\u043a\u043e\u043d\u043d\u0443\u044e \u0434\u044b\u0441\u0446\u044b\u043f\u043b\u0456\u043d\u0443, \u0456 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u045e \u0411\u043e\u0433\u0430 \u045e \u043a\u0430\u0441\u0446\u0451\u043b\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u0437 \u0437\u0430\u0434\u0430\u0432\u0430\u043b\u044c\u043d\u0435\u043d\u043d\u0435\u043c \u0432\u0443\u0447\u044b\u045e\u0441\u044f, \u043d\u0430\u0432\u0443\u0447\u0430\u045e \u0456 \u043f\u0456\u0441\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u0430\u0435, \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0443 \u041d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u0437 \u0437\u0430\u0434\u0430\u0432\u0430\u043b\u044c\u043d\u0435\u043d\u043d\u0435\u043c \u0432\u0443\u0447\u044b\u045e\u0441\u044f, \u043d\u0430\u0432\u0443\u0447\u0430\u045e \u0456 \u043f\u0456\u0441\u0430\u045e.<\/p>\r\n"}, {"GCH_CH_2_ID":"659","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f V\u0406\u0406, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 64 extra Registrum: PL 148, 709-710)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041a\u0430\u0441\u0446\u0451\u043b \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b, \u0447\u044b\u0441\u0442\u044b, \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0456 \u0437\u0430\u043a\u043b\u0456\u043d\u0430\u0435\u043c \u0443 \u041f\u0430\u043d\u0443 \u0415\u0437\u0443\u0441\u0435, \u044f\u043a\u0456 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u044e, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u0442\u0430\u0440\u0430\u043b\u0456\u0441\u044f \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0437 \u044f\u043a\u043e\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0456 \u044f\u043a\u0456\u044f \u0433\u0430\u043d\u0435\u043d\u043d\u0456 \u043c\u044b \u0437\u0432\u0435\u0434\u0432\u0430\u0435\u043c \u0430\u0434 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u045e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0432\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0441\u0446\u0451\u043b, \u043d\u0430\u0448\u0430 \u041c\u0430\u0446\u0456, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u043c\u0435\u0440\u0443 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043c\u044f\u043d\u0435, \u0437\u0443\u0441\u0456\u043c \u043d\u044f\u0432\u0430\u0440\u0442\u0430\u0433\u0430, \u043d\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456\u043c \u043f\u0430\u0441\u0430\u0434\u0437\u0435, \u0434\u0430 \u0447\u0430\u0433\u043e \u044f, \u0411\u043e\u0433 \u043c\u043d\u0435 \u0441\u0432\u0435\u0434\u043a\u0430, \u043d\u0435 \u0456\u043c\u043a\u043d\u0443\u045e\u0441\u044f. \u0417 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443 \u044f \u045e\u0441\u0456\u043c\u0456 \u0441\u0456\u043b\u0430\u043c\u0456 \u0440\u0443\u043f\u0456\u045e\u0441\u044f, \u043a\u0430\u0431 \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430 \u0411\u043e\u0436\u0430\u044f, \u043d\u0430\u0448\u0430\u044f \u041c\u0430\u0446\u0456 \u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u043a\u0430, \u0432\u044f\u0440\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0434\u0430 \u043f\u0435\u0440\u0448\u0430\u043f\u0430\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0435 \u043a\u0440\u0430\u0441\u044b, \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c, \u0447\u044b\u0441\u0442\u044b\u043c \u0456 \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456\u043c. \u0410\u043b\u0435, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u043d\u0435 \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0430\u0434\u0432\u0435\u0447\u043d\u0430\u043c\u0443 \u0432\u043e\u0440\u0430\u0433\u0443, \u0451\u043d \u0443\u0437\u0431\u0440\u043e\u0456\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0441 \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u044b\u0441\u043b\u0443\u0436\u043d\u0456\u043a\u0430\u045e, \u043a\u0430\u0431 \u0443\u0441\u0451 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0451\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0430\u043c, \u0430 \u0445\u0443\u0442\u0447\u044d\u0439 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0439 \u0421\u0442\u0430\u043b\u0456\u0446\u044b, \u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u043c\u043e\u0433 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0437 \u0447\u0430\u0441\u043e\u045e \u0456\u043c\u043f\u0435\u0440\u0430\u0442\u0430\u0440\u0430 \u041a\u0430\u043d\u0441\u0442\u0430\u043d\u0446\u0456\u043d\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430. \u0406 \u0433\u044d\u0442\u0430 \u0437\u0443\u0441\u0456\u043c \u043d\u0435 \u0434\u0437\u0456\u045e\u043d\u0430, \u0431\u043e \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0447\u0430\u0441\u0443 \u043c\u0456\u043d\u0430\u0435, \u0442\u044b\u043c \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u0435\u0439 \u0451\u043d \u0441\u0442\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0443\u044e \u0440\u044d\u043b\u0456\u0433\u0456\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0446\u044f\u043f\u0435\u0440, \u043c\u0430\u0435 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0443\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u044f \u0432\u0430\u043c \u0441\u043a\u0430\u0436\u0443. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u0456\u043c\u0435\u043c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430 \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0443\u044e \u0432\u0435\u0440\u0443, \u0442\u043e\u0439 \u0432\u0435\u0434\u0430\u0435 \u0456 \u0432\u0435\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u0441\u0432\u044f\u0442\u044b \u041f\u0451\u0442\u0440, \u0433\u0430\u043b\u043e\u045e\u043d\u044b \u0441\u044f\u0440\u043e\u0434 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, &ndash; \u0433\u044d\u0442\u0430 \u0431\u0430\u0446\u044c\u043a\u0430 \u045e\u0441\u0456\u0445 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e \u0456 \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u0441\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0430\u0441\u0442\u044b\u0440, \u0430 \u0441\u0432\u044f\u0442\u044b \u0420\u044b\u043c\u0441\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b &ndash; \u0433\u044d\u0442\u0430 \u041c\u0430\u0446\u0456 \u0456 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u0446\u0430 \u045e\u0441\u0456\u0445 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u045e \u0433\u044d\u0442\u0430 \u0432\u0435\u0440\u044b\u0446\u0435 \u0456 \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430 \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435\u0441\u044f \u0433\u044d\u0442\u0430\u0433\u0430, \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441 \u0456 \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u044f\u043a \u0432\u0430\u0448 \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u0431\u0440\u0430\u0442 \u0456 \u0432\u0430\u0448 \u043d\u044f\u0432\u0430\u0440\u0442\u044b \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a: \u043f\u0440\u0430\u0437 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439\u0446\u0435 \u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439\u0446\u0435 \u0442\u044b\u043c, \u043a\u0430\u0433\u043e \u044f \u043d\u0430\u0437\u0432\u0430\u045e \u0432\u0430\u0448\u044b\u043c \u0431\u0430\u0446\u044c\u043a\u0430\u043c \u0456 \u043c\u0430\u0446\u0456, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0433\u043d\u0435\u0446\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043f\u0440\u0430\u0437 \u0456\u0445 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e \u0432\u0430\u0448\u044b\u0445, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043b\u0430\u0441\u043a\u0443 \u045e \u0433\u044d\u0442\u044b\u043c \u0456 \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0436\u044b\u0446\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0411\u043e\u0433, \u0430\u0434 \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043a\u0430\u0435 \u0434\u0430\u0431\u0440\u043e, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0432\u0430\u0448 \u0440\u043e\u0437\u0443\u043c \u0456 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430 \u0441\u044f\u0431\u0435 \u0456 \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u0456\u0445, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0432\u0430\u0448\u0443 \u0433\u043b\u044b\u0431\u043e\u043a\u0443\u044e \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044c \u0432\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0432\u0430\u0448\u0430\u0433\u0430 \u0431\u0430\u0446\u044c\u043a\u0443 \u0456 \u043c\u0430\u0446\u0456 \u0432\u0430\u0448\u044b\u043c\u0456 \u0434\u0430\u045e\u0436\u043d\u0456\u043a\u0430\u043c\u0456 \u0456 \u0431\u0435\u0437 \u0441\u043e\u0440\u0430\u043c\u0443 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u0456\u043c\u0456. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0456\u0440 45, 3; \u041f\u0441 78 (77), 70\u0430. 71bc<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u044f\u0433\u043e \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u043a\u0430\u0440\u0430\u043b\u0451\u045e \u0456 \u0434\u0430\u045e \u044f\u043c\u0443 \u043d\u0430\u043a\u0430\u0437\u044b \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u0441\u043b\u0430\u0432\u0443 \u0441\u0432\u0430\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0432\u044b\u0431\u0440\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0441\u0432\u0430\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u0441\u043b\u0430\u0432\u0443 \u0441\u0432\u0430\u044e.<\/p>\r\n"}, {"GCH_CH_2_ID":"660","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0423\u0440\u044b\u045e\u043a\u0456 \u0437 \u0442\u0432\u043e\u0440\u0430\u045e &laquo;\u041f\u0440\u0430 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435&raquo; \u0456 &laquo;\u041f\u0440\u0430 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435&raquo; \u0441\u0432. \u041c\u0430\u0440\u044b\u0456 \u041c\u0430\u0433\u0434\u0430\u043b\u0435\u043d\u044b \u041f\u0430\u0446\u0446\u044b, \u043f\u0430\u043d\u043d\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Mss. III, 186. 264; IV, 716: Opere di S. M. Maddalena <\/span><br \/><span style=\"color: #ff0000;\">de&rsquo; Pazzi, Firenze, 1965, 4, pp. 200. 269; 6, p. 194)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456, \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435, \u0421\u043b\u043e\u0432\u0430, \u0443 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c. \u0422\u044b \u0440\u043e\u0431\u0456\u0448, \u0448\u0442\u043e \u0401\u043d \u0442\u0430\u043a \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0422\u0430\u0431\u043e\u044e \u0434\u0443\u0448\u0443, \u0448\u0442\u043e \u044f\u043d\u0430 \u0437\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c, \u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u0411\u043e\u0433\u0430, \u043a\u0430\u0448\u0442\u0443\u0435 \u0411\u043e\u0433\u0430 \u0456 \u043d\u0456\u0447\u043e\u0433\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u0411\u043e\u0433\u0430, \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u044f\u043a\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0434\u0443\u0448\u0443, \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u043f\u044f\u0447\u0430\u0442\u043a\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 \u0421\u043b\u043e\u0432\u0430, \u0437\u0430\u0431\u0456\u0442\u0430\u0433\u0430 \u0411\u0430\u0440\u0430\u043d\u043a\u0430; \u0433\u044d\u0442\u0430\u044f \u0436 \u043a\u0440\u043e\u045e \u0441\u0445\u0456\u043b\u044f\u0435 \u042f\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u0456, \u0445\u043e\u0446\u044c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0441\u0430\u043c \u0440\u0443\u0445\u0430\u0435\u0446\u0446\u0430 \u0456 \u043f\u0440\u0430\u0433\u043d\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u044e\u0447\u044b \u0414\u0443\u0445, \u0431\u0443\u0434\u0443\u0447\u044b \u0430\u0434\u0437\u0456\u043d\u0430\u0441\u0443\u0442\u043d\u044b\u043c \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0421\u043b\u043e\u0432\u0430\u043c \u0456 \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0437 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0410\u0439\u0446\u0430 \u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0421\u043b\u043e\u0432\u0430, \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0434\u0443\u0448\u0443, \u044f\u043a \u043a\u0440\u044b\u043d\u0456\u0446\u0430, \u044f\u043a\u0430\u044f \u0446\u0430\u043b\u043a\u0430\u043c \u044f\u0435 \u0437\u0430\u043b\u0456\u0432\u0430\u0435. \u041a\u0430\u043b\u0456 \u0437\u043b\u0456\u0432\u0430\u044e\u0446\u0446\u0430 \u0434\u0437\u0432\u0435 \u0440\u0430\u043a\u0456 \u0456 \u043f\u0435\u0440\u0430\u043c\u0435\u0448\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0435 \u043f\u043b\u044b\u043d\u0456, \u0442\u0430\u0434\u044b \u043c\u0435\u043d\u0448\u0430\u044f \u0441\u0442\u0440\u0430\u0447\u0432\u0430\u0435 \u045e\u043b\u0430\u0441\u043d\u0443\u044e \u043d\u0430\u0437\u0432\u0443 \u0456 \u043f\u0440\u044b\u043c\u0430\u0435 \u043d\u0430\u0437\u0432\u0443 \u0431\u043e\u043b\u044c\u0448\u0430\u0439. \u041f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0434\u0443\u0448\u0443, \u043a\u0430\u0431 \u0437 \u0451\u0439 \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u0446\u0446\u0430. \u0422\u0430\u0434\u044b \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0434\u0443\u0448\u0430, \u044f\u043a\u0430\u044f \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u0435\u043d\u0448\u0430\u0439, \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0430 \u0441\u0432\u0430\u044e \u043d\u0430\u0437\u0432\u0443 \u0456 \u0437\u043b\u0456\u043b\u0430\u0441\u044f \u0437 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c. \u0413\u044d\u0442\u0430 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u044f\u043d\u0430 \u0442\u0430\u043a \u0437\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0437 \u0414\u0443\u0445\u0430\u043c, \u0448\u0442\u043e \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043d\u0435\u043f\u0430\u0434\u0437\u0435\u043b\u044c\u043d\u0430\u0439 \u0437 \u0406\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b \u0414\u0443\u0445 &ndash; \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a \u0441\u043a\u0430\u0440\u0431\u0430\u045e, \u0441\u0445\u0430\u0432\u0430\u043d\u044b\u0445 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0410\u0439\u0446\u0430, \u0456 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430 &ndash; \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0434\u0443\u0448\u044b \u0442\u0430\u043a \u043f\u0440\u044b\u0435\u043c\u043d\u0430 \u0456 \u043d\u0435\u0437\u0430\u045e\u0432\u0430\u0436\u0430\u043b\u044c\u043d\u0430, \u0448\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u044f\u043c\u043d\u043e\u0433\u0456\u044f \u0430\u0446\u044d\u043d\u044c\u0432\u0430\u044e\u0446\u044c \u042f\u0433\u043e\u043d\u0443\u044e \u0432\u0435\u043b\u0456\u0447.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u0430\u0451\u0439 \u0432\u0435\u043b\u0456\u0437\u0430\u0440\u043d\u0430\u0441\u0446\u044e \u0456 \u043b\u0451\u0433\u043a\u0430\u0441\u0446\u044e \u0401\u043d \u043c\u043e\u0436\u0430 \u043f\u0440\u0430\u043d\u0456\u043a\u043d\u0443\u0446\u044c \u0432\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0437\u0434\u043e\u043b\u044c\u043d\u0430 \u0456 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u042f\u0433\u043e. \u0423\u0441\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0430\u0447\u0443\u0446\u044c, \u044f\u043a \u0401\u043d \u0447\u0430\u0441\u0442\u0430 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0430\u0431\u043e \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u043c\u0430\u045e\u0447\u044b\u0446\u044c. \u041d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u044b \u0456 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0441\u0430\u043c\u044b \u0440\u0443\u0445\u0430\u0432\u044b, \u0401\u043d \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u043b\u0430\u043c \u043b\u044e\u0431\u043e\u0432\u0456 \u045e\u0441\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u0422\u044b \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u0435\u0448\u0441\u044f \u045e \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u044b\u043c \u0410\u0439\u0446\u0443 \u0456 \u0421\u043b\u043e\u0432\u0435, \u0445\u043e\u0446\u044c \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0448\u0441\u044f \u045e \u0410\u0439\u0446\u0443, \u0456 \u0421\u044b\u043d\u0443, \u0456 \u045e \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435, \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u0445 \u0434\u0443\u0445\u0430\u0445 \u0456 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u0445. \u0422\u044b \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043a\u0440\u044b\u0432\u0456, \u043f\u0440\u0430\u043b\u0456\u0442\u0430\u0439 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u0421\u043b\u043e\u0432\u0430\u043c, \u044f\u043a\u043e\u0435 \u043f\u0440\u0430\u0437 \u043c\u043e\u0446 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0441\u0442\u0430\u043b\u0430 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044e. \u0422\u044b \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0435\u0448 \u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u0445, \u044f\u043a\u0456\u044f \u0442\u0430\u043a \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u0432\u0430\u044e\u0446\u044c \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0443\u0434\u0437\u0435\u043b \u0443 \u0422\u0432\u0430\u0456\u0445 \u0434\u0430\u0440\u0430\u0445 \u0456 \u043f\u0440\u0430\u0437 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u043d\u0430\u0431\u044b\u0446\u044c \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u0430\u0435 \u0422\u0430\u0431\u0435 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430. \u0422\u044b \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0435\u0448 \u0443 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u045e \u0441\u044f\u0431\u0435 \u0434\u0437\u0435\u0439\u0441\u043d\u0430\u0441\u0446\u044c \u043a\u0440\u044b\u0432\u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430 \u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0433\u043e\u0434\u043d\u044b\u043c \u0436\u044b\u043b\u043b\u0451\u043c \u0434\u043b\u044f \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456, \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b. \u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0410\u0439\u0446\u0430 \u0456 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u0430\u0433\u0430 \u0421\u043b\u043e\u0432\u0430. \u0422\u044b, \u0414\u0443\u0445 \u043f\u0440\u0430\u045e\u0434\u044b, \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0441\u0432\u044f\u0442\u044b\u0445, \u0441\u0432\u044f\u0442\u043b\u043e \u045e \u0437\u043c\u0440\u043e\u043a\u0443, \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u045e\u0431\u043e\u0433\u0456\u0445, \u0441\u043a\u0430\u0440\u0431 \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c, \u043d\u0430\u0441\u044b\u0447\u044d\u043d\u043d\u0435 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u0445, \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0430 \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u044b\u0445. \u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0433\u044d\u0442\u0430 \u045e \u0422\u0430\u0431\u0435 \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u044b \u045e\u0441\u044f\u043a\u0456\u044f \u0441\u043a\u0430\u0440\u0431\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456, \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u044f\u043a\u0456, \u0441\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u041c\u0430\u0440\u044b\u044e, \u0443\u0447\u044b\u043d\u0456\u045e, \u0448\u0442\u043e \u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430 \u0446\u0435\u043b\u0430\u043c, \u0456 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456 \u045e \u043d\u0430\u0441 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0401\u0439 \u0422\u044b \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u0456 \u043d\u0430\u0442\u0443\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456, \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u043a\u043e\u0436\u043d\u0430\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0437\u0430\u0434\u0443\u043c\u044b, \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u0445\u043e\u0432\u0456\u0448\u0447\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456 \u0456 \u0437\u0430\u0431\u044f\u0440\u044b \u0430\u0434 \u043d\u0430\u0441 \u0443\u0441\u0451, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u0435 \u0422\u0430\u0431\u0435 \u0437\u0430\u0431\u0440\u0430\u0446\u044c \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 2, 9-10\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430, \u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430, \u0456 \u043d\u0435 \u043c\u0430\u0433\u043b\u043e \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, <span style=\"color: #ff0000;\">*<\/span> \u044f\u043a\u0456\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0440\u044d\u0447\u044b \u0411\u043e\u0433 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u043c \u0436\u0430 \u0411\u043e\u0433 \u0430\u0434\u043a\u0440\u044b\u045e \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0440\u044d\u0447\u044b \u0411\u043e\u0433 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"661","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 171, 1-3. 5: PL 38, 933-935)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0417\u0430\u045e\u0441\u0451\u0434\u044b \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u041f\u0430\u043d\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443, \u0430 \u043d\u0435 \u0433\u044d\u0442\u0430\u043c\u0443 \u0441\u0432\u0435\u0442\u0443. &laquo;\u041a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u0445\u043e\u0447\u0430 \u0431\u044b\u0446\u044c \u0441\u044f\u0431\u0440\u0430\u043c \u0441\u0432\u0435\u0442\u0443, &ndash; \u044f\u043a \u043a\u0430\u0436\u0430 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, &ndash; \u0451\u043d \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0432\u043e\u0440\u0430\u0433\u0430\u043c \u0411\u043e\u0433\u0430&raquo; (\u042f\u043a 4, 4). \u042f\u043a \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0434\u0432\u0443\u043c \u0433\u0430\u0441\u043f\u0430\u0434\u0440\u0430\u043c, \u0442\u0430\u043a \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0441\u0432\u0435\u0442\u0443 \u0456 \u041f\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0443 \u041f\u0430\u043d\u0443, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0441\u043f\u044b\u043d\u0456\u0446\u0446\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0443 \u041f\u0430\u043d\u0443, \u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0433\u044d\u0442\u0430\u043c\u0443 \u0441\u0432\u0435\u0442\u0443 \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u043c\u044f\u043d\u0448\u0430\u0435\u0446\u0446\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0437\u043d\u0456\u043a\u043d\u0435. \u0413\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043d\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e, \u0436\u044b\u0432\u0443\u0447\u044b \u043d\u0430 \u0441\u0432\u0435\u0446\u0435, \u043c\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430, \u0430\u043b\u0435 \u043a\u0430\u0431 \u043c\u044b, \u043d\u0430\u0432\u0430\u0442 \u0431\u0443\u0434\u0443\u0447\u044b \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u0443\u0436\u043e \u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u041f\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u0445\u0442\u0430 \u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u042f \u045e \u0441\u0432\u0435\u0446\u0435, \u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0440\u0430\u0434\u0443\u044e\u0441\u044f \u0442\u0430\u043c, \u0434\u0437\u0435 \u0436\u044b\u0432\u0443&raquo;. \u0414\u044b\u043a \u0448\u0442\u043e \u0436? \u041a\u0430\u043b\u0456 \u043c\u044b \u045e \u0441\u0432\u0435\u0446\u0435, \u0434\u044b\u043a \u0443\u0436\u043e \u043d\u0435 \u045e \u041f\u0430\u043d\u0443? \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c, \u0448\u0442\u043e \u045e \u0414\u0437\u0435\u044f\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430 \u0430\u0442\u044d\u043d\u0446\u0430\u043c \u043f\u0440\u0430 \u0411\u043e\u0433\u0430 \u0456 \u041f\u0430\u043d\u0430, \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430: &laquo;\u0423 \u0406\u043c \u043c\u044b \u0436\u044b\u0432\u0451\u043c, \u0440\u0443\u0445\u0430\u0435\u043c\u0441\u044f \u0456 \u0456\u0441\u043d\u0443\u0451\u043c&raquo; (\u0414\u0437 17, 28). \u0414\u044b\u043a \u0446\u0456 \u0451\u0441\u0446\u044c \u043c\u0435\u0441\u0446\u0430, \u0434\u0437\u0435 \u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0456\u0441\u043d\u0443\u0435 \u043f\u0430\u045e\u0441\u044e\u043b\u044c? \u0426\u0456 \u0436 \u043d\u0456 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0441\u0432\u044f\u0442\u044b \u041f\u0430\u0432\u0435\u043b, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0430\u043d \u0431\u043b\u0456\u0437\u043a\u0430. \u041d\u0456 \u043f\u0440\u0430 \u0448\u0442\u043e \u043d\u0435 \u0442\u0443\u0440\u0431\u0443\u0439\u0446\u0435\u0441\u044f&raquo; (\u0424\u043b\u043f 4, 5-6).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430: \u0442\u043e\u0439, \u0445\u0442\u043e \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u044b, \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0431\u043b\u0456\u0437\u043a\u0456\u043c \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0410 \u0445\u0442\u043e \u0436 \u0442\u043e\u0439 \u0434\u0430\u043b\u0451\u043a\u0456 \u0456 \u0431\u043b\u0456\u0437\u043a\u0456, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0442\u0430\u045e \u0431\u043b\u0456\u0437\u043a\u0456\u043c \u0434\u0430 \u043d\u0430\u0441?<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0432\u0435\u0441\u044c \u043b\u044e\u0434\u0441\u043a\u0456 \u0440\u043e\u0434 &ndash; \u0433\u044d\u0442\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043f\u0430\u045e\u0436\u044b\u0432\u044b \u043b\u044f\u0436\u044b\u0446\u044c \u043f\u0440\u044b \u0434\u0430\u0440\u043e\u0437\u0435, \u043a\u0456\u043d\u0443\u0442\u044b \u0437\u043b\u043e\u0434\u0437\u0435\u044f\u043c\u0456, \u044f\u043a\u043e\u0433\u0430 \u0430\u0431\u043c\u0456\u043d\u0443\u043b\u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u044b \u0456 \u043b\u0435\u0432\u0456\u0442\u044b. \u0410\u043b\u0435 \u0430\u0431 \u0456\u043c \u0430\u0434\u0440\u0430\u0437\u0443 \u0436 \u043f\u0430\u043a\u043b\u0430\u043f\u0430\u0446\u0456\u045e\u0441\u044f \u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u044f\u0433\u043e \u0441\u0430\u043c\u0430\u0440\u0430\u043d\u0456\u043d, \u044f\u043a\u0456 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u043c\u0456\u043c\u0430. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u041f\u0430\u043d \u0431\u044b\u045e \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u043d\u0430\u0441, \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u0445 \u0456 \u0433\u0440\u044d\u0448\u043d\u044b\u0445, \u0401\u043d \u0441\u0430\u043c \u0441\u044b\u0448\u043e\u045e \u0434\u0430 \u043d\u0430\u0441, \u043a\u0430\u0431 \u0442\u043e\u0439 \u0434\u0430\u043b\u0451\u043a\u0456 \u0441\u0442\u0430\u045e \u0431\u043b\u0456\u0437\u043a\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041d\u0435 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0437 \u043d\u0430\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0433\u0440\u0430\u0445\u043e\u045e \u043d\u0430\u0448\u044b\u0445&raquo; (\u041f\u0441 103 [102], 10), \u0431\u043e \u043c\u044b \u042f\u0433\u043e \u0434\u0437\u0435\u0446\u0456. \u0410\u0434\u043a\u0443\u043b\u044c \u0442\u0430\u043a\u0430\u044f \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u0430\u0441\u0446\u044c? \u0422\u0430\u043c\u0443 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u043d\u0430\u0441, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0430\u0434\u043d\u044b\u043c. \u0422\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u043d\u0430\u0441, \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0431\u044b\u0446\u044c \u0430\u0434\u043d\u044b\u043c. \u0410\u0434\u0437\u0456\u043d \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u045e\u0447\u044b\u043d\u0456\u045e \u043c\u043d\u043e\u0433\u0456\u0445 \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456. \u0401\u043d \u043d\u0430\u0431\u044b\u045e \u0441\u0430\u0431\u0435 \u0431\u0440\u0430\u0442\u043e\u045e \u0437\u0430 \u045e\u043b\u0430\u0441\u043d\u0443\u044e \u043a\u0440\u043e\u045e; \u043f\u0440\u044b\u043d\u044f\u045e, \u0445\u043e\u0446\u044c \u0441\u0430\u043c \u0431\u044b\u045e \u0430\u0434\u0440\u044b\u043d\u0443\u0442\u044b; \u043a\u0443\u043f\u0456\u045e, \u0445\u043e\u0446\u044c \u0441\u0430\u043c \u0431\u044b\u045e \u043f\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u044b; \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e, \u0445\u043e\u0446\u044c \u0441\u0430\u043c \u0431\u044b\u045e \u0437\u043d\u044f\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b; \u0430\u0436\u044b\u0432\u0456\u045e, \u0445\u043e\u0446\u044c \u0441\u0430\u043c \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, &laquo;\u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u041f\u0430\u043d\u0443&raquo;, \u0430\u043b\u0435 \u043d\u0435 \u0441\u0432\u0435\u0442\u0443. \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0430 \u043d\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044e; \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u0432\u0435\u0447\u043d\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456, \u0430 \u043d\u0435 \u043a\u0432\u0435\u0446\u0435\u043d\u0456 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456. \u0422\u0430\u043a \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u0430 \u0434\u0437\u0435 \u0431 \u0456 \u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u043d\u0456 \u0431\u044b\u043b\u0456, &laquo;\u041f\u0430\u043d \u0431\u043b\u0456\u0437\u043a\u0430. \u041d\u0456 \u043f\u0440\u0430 \u0448\u0442\u043e \u043d\u0435 \u0442\u0443\u0440\u0431\u0443\u0439\u0446\u0435\u0441\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 13, 11; \u0420\u044b\u043c 15, 13\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0440\u0430\u0442\u044b, \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456, \u0441\u0443\u0446\u044f\u0448\u0430\u0439\u0446\u0435\u0441\u044f, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0430\u0434\u043d\u0430\u0434\u0443\u043c\u0446\u0430\u043c\u0456, \u0436\u044b\u0432\u0456\u0446\u0435 \u045e \u0441\u043f\u0430\u043a\u043e\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0411\u043e\u0433 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e \u0431\u0443\u0434\u0437\u0435 \u0437 \u0432\u0430\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0436\u0430 \u043d\u0430\u0434\u0437\u0435\u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u0443 \u0432\u0435\u0440\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0411\u043e\u0433 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e \u0431\u0443\u0434\u0437\u0435 \u0437 \u0432\u0430\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"662","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 11, 36: MGH 1899, Epistolae, 2, 305-306)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041d\u0430\u0440\u043e\u0434 \u0430\u043d\u0433\u0435\u043b\u044c\u0446\u0430\u045e \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0432\u0435\u0440\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0425\u0432\u0430\u043b\u0430 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445 \u0411\u043e\u0433\u0443, \u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456&raquo; (\u041b\u043a 2, 14), \u0442\u0430\u043c\u0443 \u0448\u0442\u043e, \u043f\u0430\u0434\u0430\u044e\u0447\u044b \u045e \u0437\u044f\u043c\u043b\u044e, \u043f\u0448\u0430\u043d\u0456\u0447\u043d\u0430\u0435 \u0437\u0435\u0440\u043d\u0435, \u0415\u0437\u0443\u0441, \u043f\u0430\u043c\u0456\u0440\u0430\u0435, \u043a\u0430\u0431 \u043d\u0435 \u0430\u0434\u043d\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u043b\u0430 \u045e \u043d\u0435\u0431\u0435. \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0430\u0435 \u043d\u0430\u043c \u0436\u044b\u0446\u0446\u0451, \u042f\u0433\u043e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u043d\u0430\u0441, \u042f\u0433\u043e \u043c\u0443\u043a\u0430 \u0440\u0430\u0442\u0443\u0435 \u043d\u0430\u0441 \u0430\u0434 \u043f\u0430\u043a\u0443\u0442\u0430\u045e, \u042f\u0433\u043e \u043b\u044e\u0431\u043e\u045e \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u043d\u0430\u043c \u0448\u0443\u043a\u0430\u0446\u044c \u0443 \u0411\u0440\u044b\u0442\u0430\u043d\u0456\u0456 \u0431\u0440\u0430\u0442\u043e\u045e, \u044f\u043a\u0456\u0445 \u043c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u0430 \u042f\u0433\u043e \u0434\u0430\u0440 &ndash; \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043c\u044b \u0448\u0443\u043a\u0430\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0437\u0434\u043e\u043b\u0435\u0435 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u0442\u0443\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0435\u0440\u043d\u044b\u0445, \u043a\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434 \u0430\u043d\u0433\u0435\u043b\u044c\u0446\u0430\u045e, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u0430\u0441\u0446\u044b \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u0456 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u043c \u0442\u0432\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0446\u0442\u0432\u0430, \u043f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0437\u043c\u0440\u043e\u043a \u0433\u0440\u0430\u0445\u0443, \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e\u0441\u044f \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0441\u0432\u044f\u0442\u043e\u0439 \u0432\u0435\u0440\u044b. \u0426\u044f\u043f\u0435\u0440 \u0437 \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c \u0451\u043d \u0443\u0436\u043e \u0442\u043e\u043f\u0447\u0430 \u0456\u0434\u0430\u043b\u0430\u045e, \u043f\u0435\u0440\u0430\u0434 \u044f\u043a\u0456\u043c\u0456 \u0440\u0430\u043d\u0435\u0439 \u0442\u0440\u044b\u043c\u0446\u0435\u045e \u0443 \u0434\u0437\u0456\u043a\u0456\u043c \u0441\u0442\u0440\u0430\u0445\u0443. \u0426\u044f\u043f\u0435\u0440 \u0451\u043d \u0437 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u0446\u0446\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0443. \u0426\u044f\u043f\u0435\u0440 \u0451\u043d \u043f\u0440\u044b\u0432\u044f\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e, \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u0433\u0430\u043d\u0435\u0431\u043d\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0433\u0440\u0430\u0445\u0443. \u0426\u044f\u043f\u0435\u0440 \u0411\u043e\u0436\u044b\u044f \u043d\u0430\u043a\u0430\u0437\u044b \u045e\u0437\u0434\u044b\u043c\u0430\u044e\u0446\u044c \u044f\u0433\u043e \u0434\u0443\u0445 \u0456 \u0440\u043e\u0437\u0443\u043c. \u0426\u044f\u043f\u0435\u0440 \u0451\u043d \u0441\u0445\u0456\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0434\u0430 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u0434\u0443\u0445 \u043d\u0435 \u0431\u044b\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0427\u044b\u044f \u0436 \u0433\u044d\u0442\u0430 \u0441\u043f\u0440\u0430\u0432\u0430, \u044f\u043a \u043d\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u0430\u0436\u0430: &laquo;\u0410\u0439\u0446\u0435\u0446 \u041c\u043e\u0439 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c, \u0456 \u042f \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u044e&raquo; (\u042f\u043d 5, 17)?<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u0441\u0432\u0435\u0442 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u043d\u0435 \u0441\u0432\u0430\u0451\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e, \u0430 \u043c\u043e\u0446\u0430\u0439 \u0411\u043e\u0433\u0430, \u0401\u043d \u0432\u044b\u0431\u0440\u0430\u045e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u043f\u0430\u0441\u043b\u0430\u045e \u0443 \u0441\u0432\u0435\u0442, \u043d\u0435\u0430\u0434\u0443\u043a\u0430\u0432\u0430\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u0422\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u0401\u043d \u0440\u043e\u0431\u0456\u0446\u044c \u0456 \u0442\u0443\u0442, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0447\u044b \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0440\u044d\u0447\u044b \u045e \u043d\u0430\u0440\u043e\u0434\u0437\u0435 \u0430\u043d\u0433\u0435\u043b\u044c\u0446\u0430\u045e \u043f\u0440\u0430\u0437 \u0441\u043b\u0430\u0431\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u0410\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u0433\u044d\u0442\u044b \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0434\u0430\u0440, \u0434\u0430\u0440\u0430\u0433\u0456 \u0431\u0440\u0430\u0446\u0435, \u0442\u0440\u044d\u0431\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430, \u0430\u043b\u0435 \u0456 \u043c\u043e\u0446\u043d\u0430 \u0431\u0430\u044f\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0442\u0432\u0430\u0451\u0439 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0411\u043e\u0433 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0446\u0443\u0434\u044b \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0432\u044b\u0431\u0440\u0430\u0446\u044c. \u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u0433\u044d\u0442\u0430\u043c\u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u043c\u0443 \u0434\u0430\u0440\u0443 \u0442\u044b \u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0437 \u0431\u043e\u044f\u0437\u0437\u044e \u0456 \u0431\u0430\u044f\u045e\u0441\u044f \u0437\u0430 \u044f\u0433\u043e \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e. \u0422\u0440\u044d\u0431\u0430 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0432\u043e\u043d\u043a\u0430\u0432\u044b\u044f \u0437\u043d\u0430\u043a\u0456 \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u044e\u0446\u044c \u0434\u0443\u0448\u044b \u0430\u043d\u0433\u0435\u043b\u044c\u0446\u0430\u045e \u0434\u0430 \u043b\u0430\u0441\u043a\u0456. \u0411\u0430\u044f\u0446\u0446\u0430 \u0436 \u0442\u0440\u044d\u0431\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0446\u0443\u0434\u0430\u045e, \u044f\u043a\u0456\u044f \u0430\u0434\u0431\u044b\u0432\u0430\u044e\u0446\u0446\u0430, \u043d\u044f\u0441\u0442\u0430\u043b\u044b \u0434\u0443\u0445 \u043d\u0435 \u045e\u0437\u0432\u044b\u0448\u0430\u045e\u0441\u044f \u0430\u0434 \u0433\u043e\u043d\u0430\u0440\u0443 \u0456 \u043d\u0435 \u045e\u043f\u0430\u045e \u0443 \u0434\u0443\u0448\u044b \u0430\u0434 \u043c\u0430\u0440\u043d\u0430\u0439 \u0437\u043d\u0435\u0448\u043d\u044f\u0439 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0432\u0443\u0447\u043d\u0456, \u043a\u0430\u043b\u0456 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0432\u044f\u0440\u0442\u0430\u043b\u0456\u0441\u044f \u043f\u0430\u0441\u043b\u044f \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u0430\u0439 \u043f\u0440\u043e\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0434\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430: &laquo;\u041f\u0430\u043d\u0435, \u043d\u0430\u0432\u0430\u0442 \u0437\u043b\u044b\u044f \u0434\u0443\u0445\u0456 \u0441\u043b\u0443\u0445\u0430\u044e\u0446\u0446\u0430 \u043d\u0430\u0441 \u0443 \u0456\u043c\u044f \u0422\u0432\u0430\u0451&raquo; (\u041b\u043a 10, 17). \u042f\u043d\u044b \u0430\u0434\u0440\u0430\u0437\u0443 \u043f\u0430\u0447\u0443\u043b\u0456 \u0430\u0434\u043a\u0430\u0437: &laquo;\u041d\u0435 \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0434\u0443\u0445\u0456 \u0441\u043b\u0443\u0445\u0430\u044e\u0446\u0446\u0430 \u0432\u0430\u0441, \u0430 \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0456\u043c\u0451\u043d\u044b \u0432\u0430\u0448\u044b\u044f \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u044b \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445&raquo; (\u041b\u043a 10, 20).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0424\u043b\u043f 3, 17; 4. 9; 1 \u041a\u0430\u0440 1, 10\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0441\u043b\u0435\u0434\u0443\u0439\u0446\u0435 \u043c\u044f\u043d\u0435, \u0431\u0440\u0430\u0442\u044b, \u0456 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0437\u043e\u0440\u0443, \u044f\u043a\u0456 \u043c\u0430\u0435\u0446\u0435 \u045e \u043d\u0430\u0441. <span style=\"color: #ff0000;\">*<\/span> \u0427\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f, \u0456 \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456, \u0456 \u043f\u0430\u0447\u0443\u043b\u0456, \u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u045e\u0432\u0430 \u043c\u043d\u0435, \u0442\u043e\u0435 \u0447\u044b\u043d\u0456\u0446\u0435, \u0456 \u0411\u043e\u0433 \u0441\u043f\u0430\u043a\u043e\u044e \u0431\u0443\u0434\u0437\u0435 \u0437 \u0432\u0430\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u0430\u043a\u043b\u0456\u043a\u0430\u044e \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u0434\u0437\u0435\u043b\u044f \u0456\u043c\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0432\u044b \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0456 \u0430\u0434\u043d\u043e \u0456 \u0442\u043e\u0435 \u0436.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0427\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f, \u0456 \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456, \u0456 \u043f\u0430\u0447\u0443\u043b\u0456, \u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u045e\u0432\u0430 \u043c\u043d\u0435, \u0442\u043e\u0435 \u0447\u044b\u043d\u0456\u0446\u0435, \u0456 \u0411\u043e\u0433 \u0441\u043f\u0430\u043a\u043e\u044e \u0431\u0443\u0434\u0437\u0435 \u0437 \u0432\u0430\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"663","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u0411\u044d\u0434\u044b \u0412\u044f\u043b\u0435\u0431\u043d\u0430\u0433\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 1, 4: CCL 122, 25-26. 30)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u0430\u0440\u044b\u044f \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e \u0401\u0439<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0412\u0435\u043b\u0456\u0447\u0430\u0435 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u041f\u0430\u043d\u0430, \u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0434\u0443\u0445 \u043c\u043e\u0439 \u0443 \u0411\u043e\u0433\u0443, \u043c\u0430\u0456\u043c \u0417\u0431\u0430\u045e\u0446\u0443&raquo; (\u041b\u043a 1, 46). \u0423 \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u041c\u0430\u0440\u044b\u044f \u043d\u0430\u0439\u043f\u0435\u0440\u0448 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u044f \u0434\u0430\u0440\u044b, \u0443\u0434\u0437\u0435\u043b\u0435\u043d\u044b\u044f \u0401\u0439, \u0430 \u043f\u043e\u0442\u044b\u043c \u043f\u0435\u0440\u0430\u043b\u0456\u0447\u0432\u0430\u0435 \u045e\u0441\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u0411\u043e\u0436\u044b\u044f, \u044f\u043a\u0456\u043c\u0456 \u0411\u043e\u0433 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0435 \u043a\u043b\u0430\u043f\u0430\u0442\u043b\u0456\u0432\u0430 \u0430\u0434\u043e\u0440\u0432\u0430\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u041f\u0430\u043d\u0430 \u0434\u0443\u0448\u0430 \u0442\u0430\u043a\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u045e\u0441\u0451\u0439 \u0441\u0432\u0430\u0451\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044e \u0430\u0434\u0434\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044e \u0411\u043e\u0433\u0430 \u0456 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044e \u042f\u043c\u0443; \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u044b\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u0448\u0442\u043e \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435 \u043f\u0440\u0430 \u0411\u043e\u0436\u0443\u044e \u043c\u043e\u0446 \u0456 \u0432\u0435\u043b\u0456\u0447.<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u045e \u0411\u043e\u0433\u0443, \u0417\u0431\u0430\u045e\u0446\u0443 \u0441\u0432\u0430\u0456\u043c, \u0434\u0443\u0445 \u0442\u0430\u043a\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u043e\u0433\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0446\u0435\u0448\u044b\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u0441\u043f\u0430\u043c\u0456\u043d \u043f\u0440\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f, \u0430\u0434 \u044f\u043a\u043e\u0433\u0430 \u0447\u0430\u043a\u0430\u0435 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u043f\u0430\u0441\u0443\u044e\u0446\u044c \u0434\u0430 \u045e\u0441\u0456\u0445 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430\u043b\u0435 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0456\u0445 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044b, \u044f\u043a\u0430\u044f, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043f\u0440\u044b\u0432\u0456\u043b\u0435\u0456 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0439 \u0437\u0430\u0441\u043b\u0443\u0433\u0456, \u043f\u0430\u043b\u0430\u043b\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430 \u0442\u0430\u0433\u043e, \u0447\u044b\u0439\u043c\u0443 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u043c\u0443 \u0437\u0430\u0447\u0430\u0446\u0446\u044e \u0442\u0430\u043a \u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043c\u0430\u0433\u043b\u0430 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0456\u043d\u0448\u044b\u0445 \u0441\u0432\u044f\u0442\u044b\u0445 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0415\u0437\u0443\u0441\u0443 &ndash; \u0441\u0432\u0430\u0439\u043c\u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044e, \u0431\u043e \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u044f \u041a\u0440\u044b\u043d\u0456\u0446\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0447\u0430\u0441\u0435 \u0437 \u042f\u0435 \u0446\u0435\u043b\u0430 \u0456 \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0441\u0442\u0430\u043d\u0435 \u045e \u0430\u0434\u043d\u043e\u0439 \u0456 \u0442\u043e\u0439 \u0436\u0430 \u0430\u0441\u043e\u0431\u0435 \u042f\u0435 \u0421\u044b\u043d\u0430\u043c \u0456 \u041f\u0430\u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0411\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u043c\u043d\u0435 \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u0430 \u0456\u043c\u044f \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0435&raquo;. \u041c\u0430\u0440\u044b\u044f \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0440\u044b\u043f\u0456\u0441\u0432\u0430\u0435 \u0441\u0432\u0430\u0456\u043c \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u043c, \u0430\u043b\u0435 \u045e\u0441\u044e \u0441\u0432\u0430\u044e \u0432\u0435\u043b\u0456\u0447 \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u0434\u0430\u0440\u0430\u043c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e, \u0431\u0443\u0434\u0443\u0447\u044b \u0412\u044f\u043b\u0456\u043a\u0456\u043c \u0456 \u041c\u0430\u0433\u0443\u0442\u043d\u044b\u043c, \u043c\u0430\u0435 \u0437\u0432\u044b\u0447\u0430\u0439 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0430\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u043c\u0430\u043b\u044b\u0445 \u0456 \u0441\u043b\u0430\u0431\u044b\u0445 \u0432\u0435\u0440\u043d\u044b\u0445 \u0443 \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u042f\u043d\u0430 \u0441\u043b\u0443\u0448\u043d\u0430 \u0434\u0430\u0434\u0430\u0435: &laquo;\u0410 \u0456\u043c\u044f \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0435&raquo;, \u043a\u0430\u0431 \u043d\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0441\u043b\u0443\u0445\u0430\u0447\u043e\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u0456\u0445, \u0434\u0430 \u043a\u0430\u0433\u043e \u0434\u043e\u0439\u0434\u0443\u0446\u044c \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u0446\u044c \u0456\u0445 \u043c\u0435\u0446\u044c \u0434\u0430\u0432\u0435\u0440 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0456\u043c\u044f \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u044f\u0433\u043e. \u0422\u0430\u043a \u0456 \u044f\u043d\u044b \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456, \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430: &laquo;\u0406 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u0447\u0430 \u0456\u043c\u044f \u041f\u0430\u043d\u0430, \u0431\u0443\u0434\u0437\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b&raquo; (\u0413\u0430\u043b 3, 5). \u0413\u044d\u0442\u0430 \u0442\u043e\u0435 \u0436 \u0456\u043c\u044f, \u043f\u0440\u0430 \u044f\u043a\u043e\u0435 \u0437\u0433\u0430\u0434\u0432\u0430\u043b\u0430\u0441\u044f \u0432\u044b\u0448\u044d\u0439: &laquo;\u0443\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0434\u0443\u0445 \u043c\u043e\u0439 \u0443 \u0411\u043e\u0433\u0443, \u043c\u0430\u0456\u043c \u0417\u0431\u0430\u045e\u0446\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u045e \u0441\u0432\u044f\u0442\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u045e\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u045e\u0441\u044f \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0434\u043e\u0431\u0440\u044b \u0456 \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u044b \u0437\u0432\u044b\u0447\u0430\u0439 &ndash; \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u045e \u0432\u0435\u0447\u0430\u0440\u043e\u0432\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0445\u0432\u0430\u043b\u044b \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0433\u0456\u043c\u043d \u041c\u0430\u0440\u044b\u0456, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0447\u0430\u0441\u0442\u044b \u045e\u0441\u043f\u0430\u043c\u0456\u043d \u0443\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u041f\u0430\u043d\u0430 \u0440\u0430\u0441\u043f\u0430\u043b\u044c\u0432\u0430\u0446\u044c \u0443 \u0432\u0435\u0440\u043d\u044b\u0445 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0456 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0446\u044c \u0456\u0445 \u0443 \u0446\u043d\u043e\u0442\u0430\u0445 \u0447\u0430\u0441\u0442\u044b\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0435\u043c \u043d\u0430\u0434 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044b. \u0406 \u0432\u0435\u043b\u044c\u043c\u0456 \u043a\u0430\u0440\u044b\u0441\u043d\u0430 \u0431\u044b\u043b\u043e \u0432\u044b\u0440\u0430\u0448\u0430\u043d\u0430 \u0447\u044b\u0442\u0430\u0446\u044c \u0433\u044d\u0442\u044b \u0433\u0456\u043c\u043d \u0443\u0432\u0435\u0447\u0430\u0440\u044b, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c, \u0441\u0442\u043e\u043c\u043b\u0435\u043d\u044b \u0437\u0430 \u045e\u0432\u0435\u0441\u044c \u0434\u0437\u0435\u043d\u044c \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u043c\u0456, \u0437 \u043d\u0430\u0431\u043b\u0456\u0436\u044d\u043d\u043d\u0435\u043c \u0447\u0430\u0441\u0443 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0456\u0445 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u0445 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041b\u043a 1, 45-46; \u041f\u0441 66 (65), 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0430, \u0448\u0442\u043e \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0435 \u0401\u0439 \u041f\u0430\u043d\u0430\u043c. \u0406 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u041c\u0430\u0440\u044b\u044f:<span style=\"color: #ff0000;\"> *<\/span> \u0412\u0435\u043b\u0456\u0447\u0430\u0435 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435 \u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u044f \u0440\u0430\u0441\u043a\u0430\u0436\u0443 \u0432\u0430\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u0443\u0447\u044b\u043d\u0456\u045e \u0434\u043b\u044f \u043c\u0430\u0451\u0439 \u0434\u0443\u0448\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0435\u043b\u0456\u0447\u0430\u0435 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"664","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u0430\u045e\u0440\u044d\u043d\u0446\u0456\u044f \u042e\u0441\u0442\u044b\u043d\u0456\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 8, in festo Purificationis B. M. V.: Opera, 2, Venetiis 1751, 38-39)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u0430\u0440\u044b\u044f \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0430 \u045e\u0441\u0451 \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u044f \u0414\u0437\u0435\u0432\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043b\u0430 \u045e\u0441\u0451, \u0430\u0431 \u0447\u044b\u043c \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0430\u0441\u044f, \u0447\u044b\u0442\u0430\u044e\u0447\u044b, \u0441\u043b\u0443\u0445\u0430\u044e\u0447\u044b \u0456 \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u043b\u0430 \u045e \u0432\u0435\u0440\u044b, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u043b\u0430 \u0441\u0432\u0430\u0435 \u0437\u0430\u0441\u043b\u0443\u0433\u0456, \u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u043d\u0430\u0431\u044b\u0432\u0430\u043b\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u044f\u043a \u0436\u0430 \u043c\u043e\u0446\u043d\u0430 \u0440\u0430\u0437\u0433\u0430\u0440\u0430\u043b\u0430\u0441\u044f \u043f\u043e\u043b\u044b\u043c\u0435\u043c \u043b\u044e\u0431\u043e\u0432\u0456! \u0423 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u044b\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0456 \u043f\u0440\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0441\u0432\u0430\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043b\u0430 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0434\u0430\u0440\u043e\u045e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0443\u0437\u043d\u043e\u0441\u0456\u043b\u0430\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0430 \u043f\u0430\u043a\u043e\u0440\u0443. \u0422\u0430\u043a\u0456\u044f \u043f\u043e\u0441\u0442\u0443\u043f\u044b \u045e \u043b\u0430\u0441\u0446\u044b \u0411\u043e\u0436\u0430\u0439 \u0443\u0437\u043d\u043e\u0441\u044f\u0446\u044c \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0456 \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u044e\u0446\u044c \u0445\u0432\u0430\u043b\u0443. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0414\u0437\u0435\u0432\u044b! \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u043d\u043d\u044e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u044f\u0433\u043e \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u044f\u043c \u042f\u043d\u0430 \u0431\u044b\u043b\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0432\u0430 \u045e\u0441\u0456\u043c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u044f \u0432\u043e\u043b\u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u043b\u043e\u0432\u0430. \u041d\u0435 \u043a\u0456\u0440\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u045e\u043b\u0430\u0441\u043d\u044b\u043c \u0430\u0434\u0447\u0443\u0432\u0430\u043d\u043d\u0435\u043c \u0456 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u0435\u043c, \u0430\u043b\u0435 \u045e \u0437\u043d\u0435\u0448\u043d\u0456\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u043d\u0443\u0442\u0440\u044b \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u043b\u0430 \u042f\u0435 \u0432\u0435\u0440\u044b \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c. \u041d\u0430\u043b\u0435\u0436\u0430\u043b\u0430, \u043a\u0430\u0431 \u0411\u043e\u0436\u0430\u044f \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u044f\u043a \u0436\u044b\u043b\u043b\u0451 \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043b\u0430 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0443\u044e \u0414\u0437\u0435\u0432\u0443 \u044f\u043a \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u043a\u043e\u043d\u0443, \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0441\u044d\u0440\u0446\u0430, \u043f\u0430\u043a\u043e\u0440\u044b \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0439 \u042f\u0435, \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d! \u0423\u0432\u0430\u0439\u0434\u0437\u0456 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u0431 \u0434\u0443\u0445\u043e\u045e\u043d\u0430 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u0446\u0430 \u0456 \u0432\u044b\u043b\u0435\u0447\u044b\u0446\u0446\u0430 \u0430\u0434 \u0445\u0432\u0430\u0440\u043e\u0431\u044b \u0433\u0440\u0430\u0445\u043e\u045e. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c \u0411\u043e\u0433 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u043c\u0430\u0442\u044b\u0432\u044b \u043d\u0430\u0448\u044b\u0445 \u0447\u044b\u043d\u0430\u045e \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043d\u0430 \u0441\u0430\u043c\u044b\u044f \u0447\u044b\u043d\u044b. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u045e \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u0456 \u0456 \u045e \u0434\u0430\u0432\u044f\u0440\u044d\u043d\u043d\u0456 \u0441\u044f\u0431\u0435 \u0411\u043e\u0433\u0443 \u043c\u044b \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u043c \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443 \u0434\u0430 \u042f\u0433\u043e, \u0430\u0431\u043e \u043a\u0430\u043b\u0456 \u0456\u043c\u043a\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0435 \u0446\u043d\u043e\u0442\u0430\u045e \u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e \u0434\u0437\u0435\u043b\u044f \u0431\u043b\u0456\u0436\u043d\u0456\u0445, \u0443\u0441\u0451 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u043c \u0442\u0430\u043a, \u043a\u0430\u0431 \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u043c\u0430\u0442\u044b\u0432\u0430\u043c \u0431\u044b\u043b\u0430 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u0456 \u0451\u0441\u0446\u044c \u0442\u0430\u044f \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u044f \u0411\u043e\u0433\u0443 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430 \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u044f, \u044f\u043a\u0430\u044f \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u043d\u0435 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0443\u0447\u044b\u043d\u0435\u043d\u0430\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0440\u0443\u043a\u043e\u0439, \u0430\u043b\u0435 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0441\u044d\u0440\u0446\u0430, \u043a\u0443\u0434\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041b\u043a 1, 42<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0432\u044f\u0442\u0430\u044f \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u044f \u0414\u0437\u0435\u0432\u0430, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u044f\u043a\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u044f \u0437\u043c\u0430\u0433\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0426\u044f\u0431\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0422\u044b \u043d\u0430\u0441\u0456\u043b\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0443\u043b\u043e\u043d\u043d\u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0430\u0445\u0430\u043f\u0456\u0446\u044c \u043d\u044f\u0431\u0451\u0441\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0422\u044b \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043f\u043b\u043e\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u043d\u0430\u0441\u0456\u043b\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0443\u043b\u043e\u043d\u043d\u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0430\u0445\u0430\u043f\u0456\u0446\u044c \u043d\u044f\u0431\u0451\u0441\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"665","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0456\u0441\u0442\u043e\u0440\u044b\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0441\u0432. \u042e\u0441\u0442\u044b\u043d\u0430 \u0456 \u044f\u0433\u043e \u043f\u0430\u043f\u043b\u0435\u0447\u043d\u0456\u043a\u0430\u045e<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 1-5: \u043f\u0430\u0440. PG 6, 1566-1571)<\/span><br \/><em><span style=\"color: #ff0000;\">\u042f \u043f\u0440\u044b\u043d\u044f\u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u0432\u044f\u0442\u044b\u0445 \u0441\u0445\u0430\u043f\u0456\u043b\u0456, \u0456\u0445 \u043f\u0440\u044b\u0432\u044f\u043b\u0456 \u0434\u0430 \u043f\u0440\u044d\u0444\u0435\u043a\u0442\u0430 \u0420\u044b\u043c\u0430 \u0420\u0443\u0441\u0442\u044b\u043a\u0430. \u041f\u0430\u0441\u043b\u044f \u0456\u0445 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0441\u0443\u0434\u043e\u043c, \u0456 \u043f\u0440\u044d\u0444\u0435\u043a\u0442 \u0420\u0443\u0441\u0442\u044b\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u042e\u0441\u0442\u044b\u043d\u0443: &laquo;\u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0441\u044f \u0431\u0430\u0433\u0430\u043c \u0456 \u043f\u0430\u043a\u0430\u0440\u044b\u0441\u044f \u0456\u043c\u043f\u0435\u0440\u0430\u0442\u0430\u0440\u0430\u043c&raquo;. \u042e\u0441\u0442\u044b\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0430\u0441 \u043d\u0435\u043b\u044c\u0433\u0430 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u0446\u044c \u0456 \u0437\u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0441\u043b\u0443\u0445\u0430\u0435\u043c\u0441\u044f \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0443\u0441\u0442\u044b\u043a \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f\u043a\u043e\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0432\u044b\u0437\u043d\u0430\u0435\u0448?&raquo; \u042e\u0441\u0442\u044b\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u0441\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0443\u0441\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0456, \u0430\u043b\u0435 \u043f\u0440\u044b\u043d\u044f\u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e, \u0445\u043e\u0446\u044c \u044f\u043d\u043e \u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u043c\u043d\u043e\u0433\u0456\u043c, \u0445\u0442\u043e \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u043c\u044b\u043b\u0430\u043a&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044d\u0444\u0435\u043a\u0442 \u0420\u0443\u0441\u0442\u044b\u043a \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f: &laquo;\u0410 \u0433\u044d\u0442\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u0431\u0435, \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b?&raquo; \u042e\u0441\u0442\u044b\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u0430\u043a, \u044f \u0442\u0440\u044b\u043c\u0430\u044e\u0441\u044f \u044f\u0433\u043e \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c \u0434\u0430\u0433\u043c\u0430\u0442\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044d\u0444\u0435\u043a\u0442 \u0420\u0443\u0441\u0442\u044b\u043a \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0430 \u0434\u0430\u0433\u043c\u0430\u0442?&raquo; \u042e\u0441\u0442\u044b\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0428\u0430\u043d\u0443\u0435\u043c \u0411\u043e\u0433\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e, \u043b\u0456\u0447\u044b\u043c, \u0448\u0442\u043e \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0401\u043d \u0430\u0434\u0437\u0456\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0451 \u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c \u0443\u0441\u044f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0456 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0433\u0430. \u0428\u0430\u043d\u0443\u0435\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430. \u041f\u0440\u0430\u0440\u043e\u043a\u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456, \u0448\u0442\u043e \u0401\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0432\u0443\u0447\u043d\u044f\u045e. \u042f \u0442\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0456 \u043d\u044f\u0448\u043c\u0430\u0442 \u043c\u0430\u0433\u0443 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u042f\u0433\u043e \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0443\u044e \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044c, \u0430\u0434\u043d\u0430\u043a \u043f\u0440\u044b\u0437\u043d\u0430\u044e \u043c\u043e\u0446 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430, \u043a\u0430\u043b\u0456 \u0401\u043d \u0431\u044b\u045e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u044b \u044f\u043a \u0421\u044b\u043d \u0411\u043e\u0436\u044b. \u0412\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u043f\u0440\u0430\u0440\u043e\u043a\u0456, \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u044f \u0437 \u043d\u0435\u0431\u0430, \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u042f\u0433\u043e\u043d\u0430\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0443\u0441\u0442\u044b\u043a \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0417\u043d\u0430\u0447\u044b\u0446\u044c, \u0442\u044b \u0445\u0440\u044b\u0441\u0456\u0446\u044f\u043d\u0456\u043d?&raquo; \u042e\u0441\u0442\u044b\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u0430\u043a, \u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044d\u0444\u0435\u043a\u0442 \u0441\u043a\u0430\u0437\u0430\u045e \u042e\u0441\u0442\u044b\u043d\u0443: &laquo;\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439 \u0442\u044b, \u044f\u043a\u0456 \u0431\u044b\u045e \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b \u0456 \u043b\u0456\u0447\u044b\u0448, \u0448\u0442\u043e \u043f\u0430\u0437\u043d\u0430\u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435; \u043a\u0430\u043b\u0456 \u0446\u044f\u0431\u0435 \u0432\u044b\u0441\u0435\u043a\u0443\u0446\u044c \u0456 \u0437\u0430\u0431&rsquo;\u044e\u0446\u044c, \u0434\u0443\u043c\u0430\u0435\u0448, \u0448\u0442\u043e \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u0448\u0441\u044f \u0443 \u043d\u0435\u0431\u0430?&raquo; \u042e\u0441\u0442\u044b\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u041c\u0430\u044e \u043d\u0430\u0434\u0437\u0435\u044e, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u044e, \u0442\u043e \u0430\u0434\u043f\u0440\u0430\u045e\u043b\u044e\u0441\u044f \u045e \u042f\u0433\u043e \u0434\u043e\u043c; \u044f \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0434\u0430 \u0441\u0430\u043c\u0430\u0433\u0430 \u043a\u0430\u043d\u0446\u0430 \u0441\u0432\u0435\u0442\u0443 \u0401\u043d \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u0432\u0430\u044e \u0411\u043e\u0436\u0443\u044e \u043b\u0430\u0441\u043a\u0443 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044d\u0444\u0435\u043a\u0442 \u0420\u0443\u0441\u0442\u044b\u043a \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u044b \u043c\u044f\u0440\u043a\u0443\u0435\u0448, \u0448\u0442\u043e \u043f\u0430\u0434\u044b\u043c\u0435\u0448\u0441\u044f \u045e \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0442\u0430\u043c \u043d\u0435\u0439\u043a\u0443\u044e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443?&raquo; \u042e\u0441\u0442\u044b\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0435 \u043c\u044f\u0440\u043a\u0443\u044e, \u0430\u043b\u0435 \u0446\u0432\u0451\u0440\u0434\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b \u0456 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430 \u0432\u0435\u0434\u0430\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044d\u0444\u0435\u043a\u0442 \u0420\u0443\u0441\u0442\u044b\u043a \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0410\u0434\u043d\u0430\u043a \u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044b, \u044f\u043a\u0443\u044e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0445\u0443\u0442\u043a\u0430 \u0432\u044b\u0440\u0430\u0448\u044b\u0446\u044c. \u0414\u044b\u043a \u0437\u0433\u0430\u0434\u0437\u0456\u0446\u0435\u0441\u044f \u0437 \u0442\u044b\u043c, \u0448\u0442\u043e \u0430\u0434 \u0432\u0430\u0441 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0446\u044c, \u0456 \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u0441\u0456\u0446\u0435 \u0430\u0445\u0432\u044f\u0440\u0443 \u0431\u0430\u0433\u0430\u043c&raquo;. \u042e\u0441\u0442\u044b\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0456\u0445\u0442\u043e, \u043c\u0430\u044e\u0447\u044b \u0437\u0434\u0430\u0440\u043e\u0432\u044b \u0440\u043e\u0437\u0443\u043c, \u043d\u0435 \u0430\u0434\u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0430\u0434 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0434\u0430 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044d\u0444\u0435\u043a\u0442 \u0420\u0443\u0441\u0442\u044b\u043a \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041a\u0430\u043b\u0456 \u043d\u0435 \u0432\u044b\u043a\u0430\u043d\u0430\u0435\u0446\u0435 \u0437\u0430\u0433\u0430\u0434\u0443, \u043c\u044b \u0431\u044f\u0437\u043b\u0456\u0442\u0430\u0441\u043d\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u0435\u043c \u0432\u0430\u0441&raquo;. \u042e\u0441\u0442\u044b\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041c\u044b \u043f\u0440\u0430\u0433\u043d\u0435\u043c \u0431\u044b\u0446\u044c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b\u043c\u0456 \u0437\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0437\u0431\u0430\u0432\u0456\u0446\u0446\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0434\u0430\u0442\u043a\u0430\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0430\u0434 \u0436\u0430\u0445\u043b\u0456\u0432\u044b\u043c \u0443\u0441\u0435\u0430\u0433\u0443\u043b\u044c\u043d\u044b\u043c \u0442\u0440\u044b\u0431\u0443\u043d\u0430\u043b\u0430\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0456 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456: &laquo;\u0417\u0440\u0430\u0431\u0456, \u0448\u0442\u043e \u0445\u043e\u0447\u0430\u0448; \u043c\u044b \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u0456 \u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043c \u0430\u0445\u0432\u044f\u0440\u0430\u045e \u0456\u0434\u0430\u043b\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u043f\u0440\u044d\u0444\u0435\u043a\u0442 \u0420\u0443\u0441\u0442\u044b\u043a \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u043f\u0440\u044b\u0441\u0443\u0434, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u043a\u043e\u043d\u0443, \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u0446\u0446\u0430 \u0437\u0430\u0433\u0430\u0434\u0443 \u0446\u044d\u0437\u0430\u0440\u0430 \u0456 \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0430\u0445\u0432\u044f\u0440\u044b \u0431\u0430\u0433\u0430\u043c, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0430\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435\u043c: \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0430\u0434\u043b\u0443\u043f\u0446\u0430\u0432\u0430\u043d\u044b\u044f, \u0430 \u043f\u043e\u0442\u044b\u043c \u0430\u0431\u0435\u0437\u0433\u0430\u043b\u043e\u045e\u043b\u0435\u043d\u044b\u044f&raquo;. \u0421\u0432\u044f\u0442\u044b\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456 \u0431\u044b\u043b\u0456 \u0437\u0430\u0432\u0435\u0434\u0437\u0435\u043d\u044b\u044f \u043d\u0430 \u043c\u0435\u0441\u0446\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0456 \u0442\u0430\u043c \u0437\u0430\u0431\u0456\u0442\u044b\u044f. \u0422\u0430\u043a \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0434\u0437\u0435\u043b\u044f \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f \u0417\u0431\u0430\u045e\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0414\u0437 20, 21. 24; \u0420\u044b\u043c 1, 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430\u044e\u0447\u044b \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0432\u0435\u0440\u0443 \u045e \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430, \u044f \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0431\u0430\u044e\u0441\u044f; <span style=\"color: #ff0000;\">*<\/span> \u043c\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043d\u0435 \u0432\u0430\u0440\u0442\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430, \u0442\u043e\u043b\u044c\u043a\u0456 \u0431 \u0441\u043a\u043e\u043d\u0447\u044b\u045e \u0431\u0435\u0433 \u0441\u0432\u043e\u0439 \u0456 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u044b\u043d\u044f\u045e, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u043d\u0435 \u0441\u0430\u0440\u043e\u043c\u0435\u044e\u0441\u044f \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u0431\u043e \u0433\u044d\u0442\u0430 \u043c\u043e\u0446 \u0411\u043e\u0436\u0430\u044f, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u044f \u0434\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043a\u043e\u0436\u043d\u0430\u043c\u0443, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c, \u0441\u043f\u044f\u0440\u0448\u0430 \u044e\u0434\u044d\u044e, \u0430 \u043f\u043e\u0442\u044b\u043c \u0456 \u0433\u0440\u044d\u043a\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043d\u0435 \u0432\u0430\u0440\u0442\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430, \u0442\u043e\u043b\u044c\u043a\u0456 \u0431 \u0441\u043a\u043e\u043d\u0447\u044b\u045e \u0431\u0435\u0433 \u0441\u0432\u043e\u0439 \u0456 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u044b\u043d\u044f\u045e, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"666","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0417\u0430\u043a\u043b\u0456\u043a \u0434\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430&raquo; \u0410\u0440\u044b\u0433\u0435\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 41-42: PG 11, 618-619)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u043f\u043b\u0435\u0447\u043d\u0456\u043a\u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u045e \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 &laquo;\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u043c\u044b \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f&raquo;, \u0433. \u0437\u043d. \u0430\u0434 \u0431\u044f\u0437\u0432\u0435\u0440&rsquo;\u044f \u0434\u0430 \u0432\u0435\u0440\u044b, \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u0446\u0446\u0430, \u0448\u0442\u043e \u0441\u0432\u0435\u0442 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0441. \u0411\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f, \u0430\u043b\u0435 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u043c\u0435\u0440\u0446\u0456, \u043d\u0435 \u043c\u043e\u0436\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e, \u0442\u0430\u043a \u0431\u044b \u043c\u043e\u0432\u0456\u0446\u044c, \u0441\u0430 \u0437\u043c\u0440\u043e\u0447\u043d\u0430\u0433\u0430 \u0434\u043e\u043c\u0443 \u0441\u043c\u0435\u0440\u0446\u0456 \u045e \u0441\u0432\u0435\u0442\u043b\u044b \u0434\u043e\u043c \u0436\u044b\u0446\u0446\u044f, \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u0437 \u0436\u044b\u0432\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 &laquo;\u0430\u0434\u0434\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451&raquo;. \u0414\u044b\u043a \u0430\u0434\u0434\u0430\u0434\u0437\u0456\u043c \u044f\u0433\u043e \u0456 \u043c\u044b. \u041d\u0435 \u0441\u043a\u0430\u0436\u0443: \u0437\u0430 \u042f\u0433\u043e, \u0430\u043b\u0435 \u0437\u0430 \u043d\u0430\u0441 \u0441\u0430\u043c\u0456\u0445, \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0435 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0441\u0442\u0430\u045e \u043d\u0430\u0448 \u0447\u0430\u0441, \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435, \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430. \u0421\u0432\u044f\u0442\u044b \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430: &laquo;\u0413\u0430\u043d\u0430\u0440\u044b\u043c\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0446\u0456\u0441\u043a\u0430\u043c, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u045e\u0446\u0456\u0441\u043a \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c, \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c \u0436\u0430 &ndash; \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u0443\u044e \u0446\u043d\u043e\u0442\u0443, \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u0430\u044f \u0446\u043d\u043e\u0442\u0430 \u0436 &ndash; \u043d\u0430\u0434\u0437\u0435\u044e, \u0430 \u043d\u0430\u0434\u0437\u0435\u044f \u043d\u0435 \u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u044c&raquo; (\u0420\u044b\u043c 5, 3-5). \u0423\u0440\u044d\u0448\u0446\u0435, &laquo;\u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u0440\u0430\u0437\u043b\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430&raquo; (\u043f\u0430\u0440. \u0420\u044b\u043c 5, 5).<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u042f\u043a \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u044e\u0446\u0446\u0430 \u045e \u043d\u0430\u0441 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b, \u0442\u0430\u043a \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435&raquo; (2 \u041a\u0430\u0440 1, 5). \u0410 \u0442\u0430\u043c\u0443 \u0437 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0433\u0430\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044e \u043f\u0440\u044b\u043c\u0435\u043c \u043f\u0430\u043a\u0443\u0442\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u043d\u044f\u0445\u0430\u0439 \u044f\u043d\u044b \u043f\u0430\u043c\u043d\u043e\u0436\u0430\u0446\u0446\u0430 \u045e \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u043c\u044b \u043f\u0440\u0430\u0433\u043d\u0435\u043c \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u0430\u0442\u0440\u044b\u043c\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0443\u0441\u0435, \u0445\u0442\u043e \u043f\u043b\u0430\u0447\u0430. \u041c\u0430\u0433\u0447\u044b\u043c\u0430, \u043d\u0435 \u045e\u0441\u0435 \u045e \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456, \u0431\u043e \u043a\u0430\u043b\u0456 \u0431 \u0431\u044b\u043b\u043e \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430\u0435 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435, \u043d\u0435 \u0431\u044b\u043b\u043e \u0431 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u044f\u043a \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u044e\u0446\u0446\u0430 \u045e \u043d\u0430\u0441 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b, \u0442\u0430\u043a \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043f\u043b\u0435\u0447\u043d\u0456\u043a\u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u045e \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0456 \u045e \u0437\u0430\u043b\u0435\u0436\u043d\u0430\u0441\u0446\u0456 \u0430\u0434 \u0442\u0430\u0433\u043e, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043a\u0443\u0442\u0443\u044e\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u0412\u044b \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u0446\u0435\u0441\u044f \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u045e\u0447\u0430 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0432\u044b \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0456 \u043d\u0430\u0448\u044b\u044f \u044f\u043a \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445, \u0442\u0430\u043a \u0456 \u045e \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0456&raquo; (2 \u041a\u0430\u0440 1, 7).<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0448\u0442\u043e \u0411\u043e\u0433 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430: &laquo;\u0423 \u0447\u0430\u0441 \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u042f \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e \u0446\u044f\u0431\u0435 \u0456 \u045e \u0434\u0437\u0435\u043d\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u045e \u0446\u044f\u0431\u0435&raquo; (\u043f\u0430\u0440. \u0406\u0441 49, 8). \u0426\u0456 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0447\u0430\u0441 \u0437\u0430 \u0442\u043e\u0439, \u043a\u0430\u043b\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0430\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0430\u0441 \u043f\u0430\u0432\u044f\u0434\u0443\u0446\u044c \u043f\u0430\u0434 \u0432\u0430\u0440\u0442\u0443 &ndash; \u0430\u043b\u0435 \u043d\u0435 \u044f\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043d\u044b\u0445, \u0430 \u044f\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430\u045e?<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0443\u0447\u0430\u043d\u0456\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0440\u0430\u0437\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u043c\u043e\u0446\u044b \u0456 \u045e\u043b\u0430\u0434\u044b, \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0442\u0440\u044b\u0443\u043c\u0444\u0443\u044e\u0446\u044c, \u043a\u0430\u0431, \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0430\u043f\u043b\u0435\u0447\u043d\u0456\u043a\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u044b\u0445 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e, \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u042f\u0433\u043e \u0441\u043b\u0430\u0432\u0435, \u044f\u043a\u0443\u044e \u0401\u043d \u0437\u0434\u0430\u0431\u044b\u045e \u0443 \u043c\u0443\u0436\u043d\u044b\u0445 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u044f\u043a\u0456 \u0456\u043d\u0448\u044b \u0434\u0437\u0435\u043d\u044c \u043c\u043e\u0433 \u0431\u044b \u0441\u0442\u0430\u0446\u044c \u0434\u043d\u0451\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u044f\u043a \u043d\u0435 \u0442\u043e\u0439, \u043a\u0430\u043b\u0456 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0435 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443?<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441: &laquo;\u041d\u0456\u043a\u043e\u043c\u0443 \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0441\u043f\u0430\u0442\u044b\u043a\u0430\u0446\u0446\u0430, \u043a\u0430\u0431 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u043e\u0441\u044f \u0437\u0430\u0433\u0430\u043d\u044b \u045e \u043d\u0430\u0448\u044b\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456, \u0430 \u0432\u0430 \u045e\u0441\u0456\u043c \u0432\u044b\u044f\u045e\u043b\u044f\u0439\u0446\u0435 \u0441\u044f\u0431\u0435 \u044f\u043a \u0441\u043b\u0443\u0433\u0430\u045e \u0411\u043e\u0436\u044b\u0445: \u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456&raquo; (\u043f\u0430\u0440. 2 \u041a\u0430\u0440 6, 3), &ndash; \u0456 \u043a\u0430\u0436\u044b\u0446\u0435: &laquo;\u0410 \u0446\u044f\u043f\u0435\u0440 \u0447\u0430\u0433\u043e \u043c\u043d\u0435 \u0447\u0430\u043a\u0430\u0446\u044c, \u041f\u0430\u043d\u0435? \u041c\u0430\u044f \u043d\u0430\u0434\u0437\u0435\u044f &ndash; \u0443 \u0422\u0430\u0431\u0435&raquo; (\u043f\u0430\u0440. \u041f\u0441 39 [38], 8).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 6, 12. 14\u0430. 13<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0448\u0430\u044f \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0430 \u043d\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043a\u0440\u044b\u0432\u0456 \u0456 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f\u045e, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0443\u043b\u0430\u0434\u0430\u045e, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043e\u045e \u0446\u0435\u043c\u0440\u044b \u0441\u0432\u0435\u0442\u0443 \u0433\u044d\u0442\u0430\u0433\u0430, \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0434\u0443\u0445\u0430\u045e \u0437\u043b\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0430\u043c\u0443 \u0441\u0442\u0430\u043d\u044c\u0446\u0435, \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u045e\u0448\u044b \u0441\u0446\u0451\u0433\u043d\u044b \u0441\u0432\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0430\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u045e\u0441\u044e \u0437\u0431\u0440\u043e\u044e \u0411\u043e\u0436\u0443\u044e, \u043a\u0430\u0431 \u0432\u044b \u043c\u0430\u0433\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u0443 \u0434\u0437\u0435\u043d\u044c \u043b\u0456\u0445\u0456 \u0456, \u0443\u0441\u0451 \u0430\u0434\u043e\u043b\u0435\u045e\u0448\u044b, \u0432\u044b\u0441\u0442\u0430\u044f\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u0441\u0442\u0430\u043d\u044c\u0446\u0435, \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u045e\u0448\u044b \u0441\u0446\u0451\u0433\u043d\u044b \u0441\u0432\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0430\u044e.<\/p>\r\n"}, {"GCH_CH_2_ID":"667","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0430\u043f\u044b \u041f\u0430\u045e\u043b\u0430 V\u0406<br \/>\u043f\u0430\u0434\u0447\u0430\u0441 \u043a\u0430\u043d\u0430\u043d\u0456\u0437\u0430\u0446\u044b\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0437 \u0423\u0433\u0430\u043d\u0434\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(AAS 56 [1964], 905-906)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0421\u043b\u0430\u0432\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e &ndash; \u0437\u043d\u0430\u043a \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u044f \u0430\u0444\u0440\u044b\u043a\u0430\u043d\u0441\u043a\u0456\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456 \u0434\u0430\u0434\u0430\u044e\u0446\u044c \u0443 \u043a\u043d\u0456\u0433\u0443 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430\u045e, \u044f\u043a\u043e\u0439 \u0451\u0441\u0446\u044c \u041c\u0430\u0440\u0442\u044b\u0440\u0430\u043b\u043e\u0433, \u0441\u0442\u0430\u0440\u043e\u043d\u043a\u0443, \u044f\u043a\u0430\u044f \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u0435 \u043f\u0440\u0430 \u0432\u0435\u043b\u044c\u043c\u0456 \u0441\u0443\u043c\u043d\u044b\u044f \u0456 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0440\u044d\u0447\u044b. \u0413\u044d\u0442\u0430\u044f \u0441\u0442\u0430\u0440\u043e\u043d\u043a\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u0430\u0440\u0442\u0430\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0434\u0430\u0434\u0430\u0446\u044c \u044f\u0435 \u0434\u0430 \u0442\u044b\u0445 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u0445 \u0430\u043f\u0430\u0432\u044f\u0434\u0430\u043d\u043d\u044f\u045e \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u0430\u0439 \u0410\u0444\u0440\u044b\u043a\u0456, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u043c\u044b, \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0437 \u043d\u0430\u0448\u0430\u0439 \u0441\u0446\u0456\u043f\u043b\u0430\u0439 \u0432\u0435\u0440\u0430\u0439, \u0434\u0443\u043c\u0430\u043b\u0456, \u0448\u0442\u043e \u044f\u043d\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u044c \u0441\u0430\u0431\u0435 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0431 \u043c\u043e\u0433 \u043f\u0430\u0434\u0443\u043c\u0430\u0446\u044c, \u0448\u0442\u043e, \u043d\u0430\u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u0434\u0430 \u0442\u044b\u0445 \u0445\u0432\u0430\u043b\u044e\u044e\u0447\u044b\u0445 \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0439 \u0441\u0446\u044b\u043b\u0456\u0442\u0430\u043d\u0441\u043a\u0456\u0445 \u0456 \u043a\u0430\u0440\u0444\u0430\u0433\u0435\u043d\u0441\u043a\u0456\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e, \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e &laquo;\u0441\u043d\u0435\u0436\u043d\u0430\u0433\u0430 \u043a\u043e\u043c\u0443&raquo; \u0437 \u0423\u0442\u044b\u043a\u0456, \u043f\u0440\u0430 \u044f\u043a\u0456\u0445 \u0437\u0433\u0430\u0434\u0432\u0430\u043b\u0456 \u0441\u0432\u044f\u0442\u044b \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d \u0456 \u041f\u0440\u0443\u0434\u044d\u043d\u0442\u044b\u0439, \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0437 \u0415\u0433\u0456\u043f\u0442\u0430, \u0442\u0430\u043a \u043c\u043e\u0446\u043d\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b\u0445 \u042f\u043d\u0430\u043c \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430\u043c, \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0447\u0430\u0441\u043e\u045e \u0432\u0430\u043d\u0434\u0430\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443, \u0448\u0442\u043e \u0434\u0430 \u045e\u0441\u0456\u0445 \u0443 \u043d\u0430\u0448 \u0447\u0430\u0441 \u0434\u0430\u043b\u0443\u0447\u0430\u0446\u0446\u0430 \u043d\u043e\u0432\u044b\u044f \u0430\u043f\u0456\u0441\u0430\u043d\u043d\u0456 \u043d\u0435 \u043c\u0435\u043d\u0448 \u043c\u0443\u0436\u043d\u044b\u0445 \u0456 \u043d\u0435 \u043c\u0435\u043d\u0448 \u0441\u043b\u0430\u045e\u043d\u044b\u0445 \u043f\u0430\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0431 \u043c\u043e\u0433 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u0434\u0430 \u043d\u0430\u0439\u0432\u044b\u0431\u0456\u0442\u043d\u0435\u0439\u0448\u044b\u0445 \u0441\u0432\u044f\u0442\u044b\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0456 \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0430\u045e \u0410\u0444\u0440\u044b\u043a\u0456, \u0442\u0430\u043a\u0456\u0445 \u043d\u0435\u0437\u0430\u0431\u044b\u045e\u043d\u044b\u0445 \u043f\u043e\u0441\u0442\u0430\u0446\u044f\u045e, \u044f\u043a \u041a\u0456\u043f\u0440\u044b\u044f\u043d, \u0424\u044d\u043b\u0456\u0446\u044b\u0442\u0430 \u0456 \u041f\u044d\u0440\u043f\u044d\u0442\u0443\u044f, \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u043c\u0443\u0436 \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d, \u043c\u044b \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0434\u0430\u043b\u0443\u0447\u044b\u043c \u0434\u0430\u0440\u0430\u0433\u0456\u044f \u043d\u0430\u043c \u0456\u043c\u0451\u043d\u044b \u041a\u0430\u0440\u0430\u043b\u044f \u041b\u0443\u0430\u043d\u0433\u0456, \u041c\u0430\u0446\u0435\u044f \u041c\u0443\u043b\u0443\u043c\u0431\u044b \u041a\u0430\u043b\u0435\u043c\u0431\u044b \u0456 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u0456 \u0456\u0445\u043d\u0456\u0445 \u043f\u0430\u043b\u0435\u0447\u043d\u0456\u043a\u0430\u045e. \u0412\u0430\u0440\u0442\u0430 \u0437\u0433\u0430\u0434\u0430\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u0445, \u0430\u043d\u0433\u043b\u0456\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f, \u044f\u043a\u0456\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u0437\u0430 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u044f \u0430\u0444\u0440\u044b\u043a\u0430\u043d\u0441\u043a\u0456\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437\u0430\u043a\u043b\u0430\u0434\u0430\u044e\u0446\u044c \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u044b \u043d\u043e\u0432\u0430\u0439 \u044d\u043f\u043e\u0445\u0456. \u041d\u044f\u0445\u0430\u0439 \u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u043e\u0437\u0443\u043c \u043d\u0435 \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443 \u0456 \u0440\u044d\u043b\u0456\u0433\u0456\u0439\u043d\u044b\u0445 \u043a\u0430\u043d\u0444\u043b\u0456\u043a\u0442\u0430\u045e, \u0430\u043b\u0435 \u0434\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0433\u0430 \u0456 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u043a\u0430\u0433\u0430 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0444\u0440\u044b\u043a\u0430, \u0430\u0440\u043e\u0448\u0430\u043d\u0430\u044f \u043a\u0440\u044b\u0432\u0451\u0439 \u0433\u044d\u0442\u044b\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e, \u043f\u0435\u0440\u0448\u044b\u0445 \u0443 \u0441\u0443\u0447\u0430\u0441\u043d\u0430\u0439 \u044d\u043f\u043e\u0441\u0435 (\u0456, \u0434\u0430\u0439 \u0411\u043e\u0433, \u0430\u043f\u043e\u0448\u043d\u0456\u0445, \u0431\u043e \u0442\u0430\u043a\u0430\u044f \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u0456\u0445 \u0430\u0445\u0432\u044f\u0440\u0430), \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u044f\u043a \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u044f \u0456 \u0441\u0430\u043c\u0430\u0441\u0442\u043e\u0439\u043d\u0430\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u0435 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430, \u0443\u0447\u044b\u043d\u0435\u043d\u0430\u0435 \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0442\u0430\u043a\u043e\u0435 \u0433\u0430\u043d\u0435\u0431\u043d\u0430\u0435, \u0430\u043b\u0435 \u0456 \u0442\u0430\u043a\u043e\u0435 \u0437\u043d\u0430\u0447\u043d\u0430\u0435, \u0448\u0442\u043e \u0434\u0430\u0435 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u044b\u044f \u0456 \u044f\u0441\u043d\u044b\u044f \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u044b \u0434\u043b\u044f \u043c\u0430\u0440\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0444\u0430\u0440\u043c\u0456\u0440\u0430\u0432\u0430\u043d\u043d\u044f \u043d\u043e\u0432\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u044f\u0433\u043e \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u0456, \u0434\u043b\u044f \u044f\u043a \u0431\u044b \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0447\u043d\u0430\u0433\u0430 \u045e\u043a\u0430\u0437\u0430\u043d\u043d\u044f \u0456 \u043f\u0440\u044b\u0441\u043f\u0435\u0448\u0432\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0443 \u0430\u0434 \u043f\u0440\u043e\u0441\u0442\u0430\u0439 \u0456 \u0433\u0440\u0443\u0431\u0430\u0439 \u0434\u0430\u045e\u043d\u044f\u0439 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b, \u044f\u043a\u0430\u044f \u0445\u043e\u0446\u044c \u0456 \u043d\u0435 \u0431\u044b\u043b\u0430 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u0430 \u0432\u044b\u0434\u0430\u0442\u043d\u044b\u0445 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u044f\u043a\u0430\u0441\u0446\u044f\u045e, \u0430\u043b\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0439 \u0456 \u0441\u043b\u0430\u0431\u043e\u0439 \u0437-\u0437\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u0440\u0430\u0431\u0441\u0442\u0432\u0430, \u0434\u0430 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u043a\u0430\u0439 \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b, \u044f\u043a\u0430\u044f \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0446\u0430 \u0434\u0430 \u0431\u0430\u0433\u0430\u0446\u0435\u0439\u0448\u044b\u0445 \u043f\u0440\u0430\u044f\u0432\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0434\u0443\u0445\u0443 \u0456 \u043b\u0435\u043f\u0448\u044b\u0445 \u0443\u043c\u043e\u045e \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u043a\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043a\u0443\u043b\u044c \u043c\u044b \u0431&rsquo;\u0435\u043c\u0441\u044f \u0456 \u0437\u043c\u0430\u0433\u0430\u0435\u043c\u0441\u044f \u045e \u0431\u0456\u0442\u0432\u0435 \u0432\u0435\u0440\u044b, \u0411\u043e\u0433 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u043d\u0430\u0441, \u0433\u043b\u044f\u0434\u0437\u044f\u0446\u044c \u0430\u043d\u0451\u043b\u044b \u042f\u0433\u043e\u043d\u044b\u044f, \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441. <span style=\"color: #ff0000;\">*<\/span> \u042f\u043a\u0456 \u0441\u043b\u0430\u045e\u043d\u044b \u0433\u043e\u043d\u0430\u0440, \u044f\u043a\u043e\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u0437\u0431\u0456\u0440\u0430\u0446\u0446\u0430 \u043f\u0430\u0434 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0411\u043e\u0433\u0430 \u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0432\u044f\u043d\u043e\u043a \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430-\u0421\u0443\u0434\u0434\u0437\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0437\u0431\u0440\u043e\u0456\u043c\u0441\u044f, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u0437 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c, \u0437 \u043f\u043e\u045e\u043d\u0430\u0439 \u0432\u0435\u0440\u0430\u0439 \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0439 \u0446\u043d\u043e\u0442\u0430\u0439 \u0443\u0441\u0456\u043c\u0456 \u0441\u0456\u043b\u0430\u043c\u0456 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456 \u0441\u043b\u0430\u045e\u043d\u044b \u0433\u043e\u043d\u0430\u0440, \u044f\u043a\u043e\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u0437\u0431\u0456\u0440\u0430\u0446\u0446\u0430 \u043f\u0430\u0434 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0411\u043e\u0433\u0430 \u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0432\u044f\u043d\u043e\u043a \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430-\u0421\u0443\u0434\u0434\u0437\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"668","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0411\u0430\u043d\u0456\u0444\u0430\u0446\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 78: MGH, Epistolae, 3, 352. 354)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u0441\u0442\u044b\u0440, \u044f\u043a\u0456 \u0447\u0443\u0439\u043d\u0430 \u0440\u0443\u043f\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0441\u0442\u0430\u0442\u0430\u043a \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0456 \u043a\u0430\u0440\u0430\u0431\u0435\u043b\u044c, \u044f\u043a\u0456 \u043f\u043b\u044b\u0432\u0435 \u043f\u0430 \u043c\u043e\u0440\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0406 \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u044b \u043a\u0430\u0440\u0430\u0431\u0435\u043b\u044c \u043a\u0456\u0434\u0430\u044e\u0446\u044c \u0445\u0432\u0430\u043b\u0456 \u0440\u043e\u0437\u043d\u044b\u0445 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e, \u044f\u0433\u043e \u0442\u0440\u044d\u0431\u0430 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0446\u044c, \u0430\u043b\u0435 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u043a\u043b\u0430\u0434\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c \u0443 \u043f\u0435\u0440\u0448\u044b\u0445 \u0430\u0439\u0446\u043e\u045e: \u041a\u043b\u0456\u043c\u044d\u043d\u0442\u0430, \u041a\u0430\u0440\u043d\u044d\u043b\u0456\u044f \u0456 \u043c\u043d\u043e\u0433\u0456\u0445 \u0456\u043d\u0448\u044b\u0445 \u0443 \u0420\u044b\u043c\u0435, \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430 \u045e \u041a\u0430\u0440\u0444\u0430\u0433\u0435\u043d\u0435, \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u044f \u045e \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u044b\u0456, \u044f\u043a\u0456\u044f \u045e \u043f\u0435\u0440\u044b\u044f\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u0446\u043a\u0456\u0445 \u0456\u043c\u043f\u0435\u0440\u0430\u0442\u0430\u0440\u0430\u045e \u043a\u0456\u0440\u0430\u0432\u0430\u043b\u0456 \u043a\u0430\u0440\u0430\u0431\u043b\u0451\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u042f\u0433\u043e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0439 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430\u0439, \u0433. \u0437\u043d. \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c, \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0447\u044b, \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u044e\u0447\u044b, \u043f\u0440\u0430\u0446\u0443\u044e\u0447\u044b \u0456 \u043f\u0430\u043a\u0443\u0442\u0443\u044e\u0447\u044b \u0430\u0436 \u0434\u0430 \u043f\u0440\u0430\u043b\u0456\u0446\u0446\u044f \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u045e \u043f\u0440\u0430 \u0456\u0445 \u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u0445 \u0434\u0430 \u0456\u0445, \u043c\u043d\u043e\u0439 \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u043b\u0456 \u0441\u0442\u0440\u0430\u0445 \u0456 \u0442\u0440\u044b\u043c\u0446\u0435\u043d\u043d\u0435, \u043c\u044f\u043d\u0435 \u0430\u043c\u0430\u043b\u044c \u0430\u0445\u0430\u043f\u0456\u045e \u0437\u043c\u0440\u043e\u043a \u043c\u0430\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e (\u043f\u0430\u0440. \u041f\u0441 55 [54], 6). \u0406 \u044f \u0432\u0435\u043b\u044c\u043c\u0456 \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0430\u0434\u043d\u043e\u0439\u0447\u044b \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u0435 \u0441\u0442\u044b\u0440\u043d\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0456 \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0431 \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0433\u044d\u0442\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c, \u043a\u0430\u043b\u0456 \u0431 \u0437\u0434\u043e\u043b\u0435\u045e \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u044f \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u044b \u045e \u0410\u0439\u0446\u043e\u045e \u0446\u0456 \u045e \u0421\u0432\u044f\u0442\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043a \u0441\u043a\u043b\u0430\u043b\u0456\u0441\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u0456 \u043d\u0430\u0432\u0430\u0442 \u043f\u0440\u0430\u045e\u0434\u0430 \u043c\u043e\u0436\u0430 \u0441\u0442\u0430\u043c\u0456\u0446\u0446\u0430, \u0430\u0434\u043d\u0430\u043a \u044f\u0435 \u043d\u0435\u043b\u044c\u0433\u0430 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0447\u044b \u0456 \u043f\u0430\u0434\u043c\u0430\u043d\u0443\u0446\u044c, \u043c\u043e\u0439 \u0437\u043c\u0443\u0447\u0430\u043d\u044b \u0440\u043e\u0437\u0443\u043c \u0437\u0430\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0440\u0430\u0437 \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041c\u0430\u0439 \u0434\u0430\u0432\u0435\u0440 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0456 \u043d\u0435 \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u0439\u0441\u044f \u043d\u0430 \u0441\u0432\u0430\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c. \u041d\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0448\u043b\u044f\u0445\u0430\u0445 \u0434\u0443\u043c\u0430\u0439 \u043f\u0440\u0430 \u042f\u0433\u043e, \u0456 \u0401\u043d \u043d\u0430\u043a\u0456\u0440\u0443\u0435 \u043a\u0440\u043e\u043a\u0456 \u0422\u0432\u0430\u0435&raquo; (\u041f\u0440\u044b\u043f 3, 5-6). \u0406 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b: &laquo;\u0406\u043c\u044f \u041f\u0430\u043d\u0430 &ndash; \u043d\u0430\u0439\u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u044f \u0432\u0435\u0436\u0430. \u0423 \u044f\u0435 \u045e\u0446\u044f\u043a\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0456 \u0442\u0430\u043c \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0440\u0430\u0442\u0443\u043d\u0430\u043a&raquo; (\u041f\u0440\u044b\u043f 18, 10).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0435\u043c \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b \u0434\u0430 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0443 \u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u042f\u043c\u0443: &laquo;\u041f\u0430\u043d\u0435, \u0422\u044b \u043d\u0430\u0448\u0430 \u043f\u0440\u044b\u0441\u0442\u0430\u043d\u0456\u0448\u0447\u0430 \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u045e \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435&raquo; (\u041f\u0441 90 [89], 1).<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043c \u0441\u0432\u043e\u0439 \u0434\u0430\u0432\u0435\u0440 \u043d\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u045e\u0441\u043a\u043b\u0430\u045e \u043d\u0430 \u043d\u0430\u0441 \u0446\u044f\u0436\u0430\u0440. \u0422\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043d\u0435\u0441\u0446\u0456 \u0441\u0430\u043c\u0456, \u043f\u0430\u043d\u044f\u0441\u0435\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0442\u044b\u043c, \u0445\u0442\u043e \u043c\u0430\u0435 \u043c\u043e\u0446 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u042f\u0440\u043c\u043e \u041c\u0430\u0451 \u043b\u044e\u0431\u0430\u0435 \u0456 \u0446\u044f\u0436\u0430\u0440 \u041c\u043e\u0439 \u043b\u0451\u0433\u043a\u0456&raquo; (\u041c\u0446 11, 30).<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u043d\u0435\u043c \u043d\u0430 \u0431\u0456\u0442\u0432\u0443 \u045e \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430, \u043a\u0430\u043b\u0456 &laquo;\u0434\u043d\u0456 \u043d\u044f\u0434\u043e\u043b\u0456 \u0456 \u045e\u0446\u0456\u0441\u043a\u0443&raquo; \u043d\u0430\u043f\u0430\u0442\u043a\u0430\u044e\u0446\u044c \u043d\u0430\u0441. \u041a\u0430\u043b\u0456 \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0443, &laquo;\u043f\u0430\u043c\u0440\u044d\u043c \u0437\u0430 \u0441\u0432\u044f\u0442\u044b\u044f \u0437\u0430\u043a\u043e\u043d\u044b \u0430\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445&raquo;, \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456 \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0432\u0435\u0447\u043d\u0443\u044e \u0441\u043f\u0430\u0434\u044b\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u044f\u043a \u043d\u044f\u043c\u044b\u044f \u0441\u0430\u0431\u0430\u043a\u0456, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043c\u0430\u045e\u043a\u043b\u0456\u0432\u044b\u043c\u0456 \u0433\u043b\u0435\u0434\u0430\u0447\u0430\u043c\u0456, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0439\u043c\u0456\u0442\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u045e\u0446\u044f\u043a\u0430\u044e\u0446\u044c \u0430\u0434 \u0432\u0430\u045e\u043a\u0430, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0447\u0443\u0439\u043d\u0430 \u0440\u0443\u043f\u044f\u0446\u0446\u0430 \u0430\u0431 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c \u0441\u0442\u0430\u0442\u043a\u0443, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433 \u0434\u0430\u0441\u0446\u044c \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c, \u0443\u0441\u044e \u0437\u0430\u0434\u0443\u043c\u0443 \u0411\u043e\u0436\u0443\u044e \u0431\u043e\u043b\u044c\u0448\u044b\u043c \u0456 \u043c\u0435\u043d\u0448\u044b\u043c, \u0431\u0430\u0433\u0430\u0442\u044b\u043c \u0456 \u0431\u0435\u0434\u043d\u044b\u043c, \u043b\u044e\u0434\u0437\u044f\u043c \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u0443 \u0456 \u045e\u0437\u0440\u043e\u0441\u0442\u0443, \u0437 \u043d\u0430\u0433\u043e\u0434\u044b \u0456 \u0431\u0435\u0437 \u043d\u0430\u0433\u043e\u0434\u044b &ndash; \u0442\u0430\u043a, \u044f\u043a \u0441\u0432\u044f\u0442\u044b \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u0439 \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0443 \u043a\u043d\u0456\u0437\u0435 &laquo;\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u0439 \u0440\u044d\u0433\u0443\u043b\u044b&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u0422\u044d\u0441 2, 8; \u0413\u0430\u043b 4, 19<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b \u0437 \u0447\u0443\u043b\u0430\u0441\u0446\u0456 \u0434\u0430 \u0432\u0430\u0441 \u043f\u0430\u0436\u0430\u0434\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u0432\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0430\u043b\u0435 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451, <span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0437\u0435\u0446\u0456 \u043c\u0430\u0435, \u044f \u0437\u043d\u043e\u045e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e \u0432\u0430\u0441 \u0443 \u043f\u0430\u043a\u0443\u0442\u0430\u0445, \u043f\u0430\u043a\u0443\u043b\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0441\u0444\u0430\u0440\u043c\u0443\u0435\u0446\u0446\u0430 \u045e \u0432\u0430\u0441<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"669","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0416\u044b\u0446\u0446\u0451 \u0441\u0432. \u041d\u043e\u0440\u0431\u044d\u0440\u0442\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(PL 170, 1262. 1269. 1294. 1295; Litterae Apostolicae ab Innocentio II <\/span><br \/><span style=\"color: #ff0000;\">ad S. Norbertum II non. iun. 1133 sub plumbo datae: Acta Sanctorum, 21, in \u0410ppendice, p. 50)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u044f\u043b\u0456\u043a\u0456 \u0441\u044f\u0440\u043e\u0434 \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0456 \u043c\u0430\u043b\u044b \u0441\u044f\u0440\u043e\u0434 \u0443\u0431\u043e\u0433\u0456\u0445<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u043e\u0440\u0431\u044d\u0440\u0442\u0430 \u0441\u043b\u0443\u0448\u043d\u0430 \u0437\u0430\u043b\u0456\u0447\u0432\u0430\u044e\u0446\u044c \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0430\u043a\u0442\u044b\u045e\u043d\u0430 \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u0456\u045e \u0433\u0440\u044b\u0433\u0430\u0440\u044b\u044f\u043d\u0441\u043a\u0443\u044e \u0440\u044d\u0444\u043e\u0440\u043c\u0443. \u041d\u0430\u0439\u043f\u0435\u0440\u0448 \u0451\u043d \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u045e\u0441\u044f \u0430\u0431 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u0456 \u0434\u0443\u0445\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430, \u0430\u0434\u0434\u0430\u043d\u0430\u0433\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0430\u043c\u0443 \u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u043c\u0443 \u0436\u044b\u0446\u0446\u044e \u045e \u0447\u044b\u0441\u0442\u0430\u0446\u0456 \u0456 \u045e\u0431\u043e\u0441\u0442\u0432\u0435; \u0442\u0430\u043a\u043e\u0433\u0430 \u0434\u0443\u0445\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 &laquo;\u0430\u043f\u0440\u0430\u043d\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u043d\u0435 \u043d\u043e\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430&raquo;, \u0433. \u0437\u043d. \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0443\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c; \u044f\u043a\u043e\u0435 \u0441\u0442\u0430\u0440\u0430\u0435\u0446\u0446\u0430 &laquo;\u0456\u0441\u0446\u0456 \u0437\u0430 \u0421\u0432\u044f\u0442\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0435\u043c \u0456 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u044f\u043a \u0437\u0430 \u0441\u0432\u0430\u0456\u043c \u041f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c&raquo;. \u0421\u0432\u044f\u0442\u044b \u041d\u043e\u0440\u0431\u044d\u0440\u0442 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u0437\u0432\u044f\u0440\u0442\u0430\u045e \u0443\u0432\u0430\u0433\u0443 \u0434\u0443\u0445\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430 \u043d\u0430 \u0442\u0440\u044b \u0440\u044d\u0447\u044b: &laquo;\u0447\u044b\u0441\u0442\u0430\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0430\u043b\u0442\u0430\u0440\u043e\u043c \u0456 \u0431\u043e\u0441\u043a\u0456\u043c \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u043c, \u0432\u044b\u043f\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0430\u043c\u044b\u043b\u0430\u043a \u0456 \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u043d\u043d\u044f\u045e \u0443 \u043a\u0430\u043f\u0456\u0442\u0443\u043b\u0435, \u043a\u043b\u043e\u043f\u0430\u0442 \u0456 \u0433\u0430\u0441\u0446\u0456\u043d\u043d\u0430\u0441\u0446\u044c \u0443 \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0431\u0435\u0434\u043d\u044b\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0434\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e, \u044f\u043a\u0456\u044f \u0437\u0430\u0439\u043c\u0430\u044e\u0446\u044c \u0443 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u044b \u043c\u0435\u0441\u0446\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043d\u0430 \u045e\u0437\u043e\u0440 \u0440\u0430\u043d\u043d\u044f\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0434\u0430\u0434\u0430\u045e \u0442\u0430\u043a\u043e\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0441\u0432\u0435\u0446\u043a\u0456\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e, \u043c\u0443\u0436\u0447\u044b\u043d \u0456 \u0436\u0430\u043d\u0447\u044b\u043d, \u0448\u0442\u043e, \u043d\u0430 \u0434\u0443\u043c\u043a\u0443 \u043c\u043d\u043e\u0433\u0456\u0445, \u0437 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456\u0445 \u0447\u0430\u0441\u043e\u045e \u043d\u0456\u043a\u043e\u043c\u0443 \u043d\u0435 \u045e\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0437\u0430 \u0442\u0430\u043a\u0456 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u043f\u0435\u0440\u044b\u044f\u0434 \u043d\u0430\u0431\u044b\u0446\u044c \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0433\u043d\u044b\u0445 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u043f\u0430\u0441\u043b\u044f\u0434\u043e\u045e\u043d\u0456\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u045e\u0448\u044b \u0430\u0440\u0446\u044b\u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c, \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u0441\u0432\u0430\u0456\u043c \u0431\u0440\u0430\u0442\u0430\u043c \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u0434\u0430 \u0432\u0435\u0440\u044b \u043b\u0443\u0436\u044b\u0446\u043a\u0456\u044f \u0437\u0435\u043c\u043b\u0456. \u0423 \u0441\u0432\u0430\u0451\u0439 \u0434\u044b\u044f\u0446\u044d\u0437\u0456\u0456 \u0441\u0442\u0430\u0440\u0430\u045e\u0441\u044f \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0440\u044d\u0444\u043e\u0440\u043c\u0443 \u0441\u044f\u0440\u043e\u0434 \u0434\u0443\u0445\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u043f\u044f\u0440\u044d\u0447\u0430\u043d\u043d\u0435 \u0456 \u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043d\u043d\u0435 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u0433\u043e \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u044f \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0431\u044b\u043b\u0456 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u044f \u043d\u0430 \u0434\u0430\u0441\u044f\u0433\u0435\u043d\u043d\u0435 \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u0435 \u0437\u0433\u043e\u0434\u044b \u043f\u0430\u043c\u0456\u0436 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0439 \u0421\u0442\u0430\u043b\u0456\u0446\u0430\u0439 \u0456 \u0406\u043c\u043f\u0435\u0440\u044b\u044f\u0439, \u0430\u0434\u043d\u0430\u043a \u043f\u0440\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e \u0432\u044b\u0431\u0430\u0440\u044b \u0441\u043b\u0443\u0433\u0430\u045e \u043d\u0430 \u045e\u043b\u0430\u0441\u043d\u044b\u044f \u043f\u0430\u0441\u0430\u0434\u044b. \u0422\u0430\u043c\u0443 \u043f\u0430\u043f\u0430 \u0406\u043d\u0430\u0446\u044d\u043d\u0442 \u0406\u0406 \u043f\u0456\u0441\u0430\u045e \u044f\u043c\u0443: &laquo;\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u044f \u0421\u0442\u0430\u043b\u0456\u0446\u0430 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0442\u0430\u0431\u0435, \u0430\u0434\u0434\u0430\u043d\u044b \u0441\u044b\u043d\u0435&raquo;, \u0430 \u0456\u043c\u043f\u0435\u0440\u0430\u0442\u0430\u0440 \u0437\u0440\u0430\u0431\u0456\u045e \u044f\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u043a\u0430\u043d\u0446\u043b\u0435\u0440\u0430\u043c \u0434\u0437\u044f\u0440\u0436\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u044b \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0451\u0439 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u0431\u044f\u0441\u0441\u0442\u0440\u0430\u0448\u043d\u0430\u0439 \u0432\u0435\u0440\u044b: &laquo;\u041d\u043e\u0440\u0431\u044d\u0440\u0442, &ndash; \u043a\u0430\u0437\u0430\u043b\u0456, &ndash; \u0432\u044b\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0432\u0435\u0440\u0430\u0439, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0411\u044d\u0440\u043d\u0430\u0440\u0434 \u0437 \u041a\u043b\u0435\u0440\u0432\u043e \u043b\u044e\u0431\u043e\u045e\u044e&raquo;; \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043d\u0430\u0434\u0437\u0432\u044b\u0447\u0430\u0439 \u0432\u0435\u0442\u043b\u0456\u0432\u0430\u043c\u0443 \u0430\u0431\u044b\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u044e \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 &laquo;\u0431\u044b\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0441\u044f\u0440\u043e\u0434 \u0432\u044f\u043b\u0456\u043a\u0456\u0445, \u043c\u0430\u043b\u044b\u043c \u0441\u044f\u0440\u043e\u0434 \u0443\u0431\u043e\u0433\u0456\u0445, \u0432\u0435\u0442\u043b\u0456\u0432\u044b\u043c \u0434\u0430 \u045e\u0441\u0456\u0445&raquo;; \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u043c\u0443 \u043a\u0440\u0430\u0441\u0430\u043c\u043e\u045e\u0441\u0442\u0432\u0443 &laquo;\u043d\u0430\u0441\u0456\u045e \u043f\u0430\u043b\u0430\u044e\u0447\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435, \u044f\u043a\u043e\u0435 \u0441\u043f\u0430\u043b\u044c\u0432\u0430\u043b\u0430 \u0437\u0430\u0433\u0430\u043d\u044b, \u0433\u0430\u0440\u0442\u0430\u0432\u0430\u043b\u0430 \u0446\u043d\u043e\u0442\u044b, \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u043b\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u044f \u0434\u043b\u044f \u044f\u0435 \u0434\u0443\u0448\u044b&raquo;. \u0417\u0430\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u045e \u0411\u043e\u0436\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445, \u0451\u043d \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u045e \u043f\u0440\u0430 \u0456\u0445 \u0456 \u0431\u044f\u0441\u0441\u0442\u0440\u0430\u0448\u043d\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u0426\u0456\u043c 4, 2. 5; \u043f\u0430\u0440. \u0414\u0437 20, 28<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0439 \u0441\u043b\u043e\u0432\u0430, \u0431\u0443\u0434\u0437\u044c \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u044b \u045e \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0456 \u043d\u0435\u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0447\u0430\u0441, \u0430\u0441\u043f\u0440\u044d\u0447\u0432\u0430\u0439, \u043f\u0430\u043f\u0440\u0430\u045e\u043b\u044f\u0439, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0439 \u0437 \u0443\u0441\u0451\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u045e \u043f\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0412\u0430 \u045e\u0441\u0456\u043c \u0431\u0443\u0434\u0437\u044c \u0440\u0443\u043f\u043b\u0456\u0432\u044b, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456 \u0441\u043f\u0440\u0430\u0432\u0443 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430 \u0414\u043e\u0431\u0440\u0430\u0439 \u041d\u0430\u0432\u0456\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0456\u043b\u044c\u043d\u0443\u0439\u0446\u0435 \u0441\u044f\u0431\u0435 \u0456 \u045e\u0432\u0435\u0441\u044c \u0441\u0442\u0430\u0442\u0430\u043a, \u0443 \u044f\u043a\u0456\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0432\u0430\u0441 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c\u0456, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u0432\u0456\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0411\u043e\u0436\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0430 \u045e\u0441\u0456\u043c \u0431\u0443\u0434\u0437\u044c \u0440\u0443\u043f\u043b\u0456\u0432\u044b, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456 \u0441\u043f\u0440\u0430\u0432\u0443 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430 \u0414\u043e\u0431\u0440\u0430\u0439 \u041d\u0430\u0432\u0456\u043d\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"670","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u042d\u0444\u0440\u044d\u043c\u0430, \u0434\u044b\u044f\u043a\u0430\u043d\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 3, De fine et admonitione, 2, 4-5:<\/span><br \/><span style=\"color: #ff0000;\">edit. Lamy, 3, 216-222)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0411\u043e\u0436\u0430\u044f \u044d\u043a\u0430\u043d\u043e\u043c\u0456\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f &ndash; \u0433\u044d\u0442\u0430 \u0432\u043e\u0431\u0440\u0430\u0437 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0440\u0430\u0437\u0433\u0430\u043d\u0456 \u0434\u0437\u0451\u043d\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0426\u044f\u0431\u0435 \u043d\u0430\u0447\u043d\u044b \u0437\u043c\u0440\u043e\u043a \u043d\u0430\u0448\u0430\u0433\u0430 \u0440\u043e\u0437\u0443\u043c\u0443, \u043a\u0430\u0431 \u043d\u0430\u0448 \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b \u0440\u043e\u0437\u0443\u043c \u043c\u043e\u0433 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0422\u0430\u0431\u0435 \u045e \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u0439 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456. \u041f\u0430\u0447\u0430\u0442\u0430\u043a \u0431\u0435\u0433\u0443 \u0441\u043e\u043d\u0446\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u043f\u0440\u0430\u0446\u044b \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u0445; \u0443\u043f\u0440\u044b\u0433\u043e\u0436, \u041f\u0430\u043d\u0435, \u0443 \u043d\u0430\u0448\u044b\u0445 \u0440\u043e\u0437\u0443\u043c\u0430\u0445 \u0441\u0432\u044f\u0442\u043b\u0456\u0446\u044b \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u0434\u043d\u044f, \u044f\u043a\u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043a\u0430\u043d\u0446\u0430. \u0414\u0430\u0439 \u043d\u0430\u043c \u0443 \u043d\u0430\u0441 \u0441\u0430\u043c\u0456\u0445 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f, \u043d\u044f\u0445\u0430\u0439 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0430\u0434\u0446\u044f\u0433\u0432\u0430\u0435 \u043d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c \u0430\u0434 \u0422\u0432\u0430\u0456\u0445 \u0440\u0430\u0434\u0430\u0441\u0446\u044f\u045e. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0440\u0443\u043f\u043b\u0456\u0432\u044b\u043c \u043f\u043e\u0448\u0443\u043a\u0430\u043c \u0426\u044f\u0431\u0435, \u043f\u0430\u0441\u0442\u0430\u045e \u043d\u0430 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u0437\u043d\u0430\u043a \u0442\u0430\u0433\u043e \u0434\u043d\u044f, \u044f\u043a\u0456 \u043d\u0435 \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434 \u0443\u0437\u044b\u0445\u043e\u0434\u0443 \u0446\u0456 \u0431\u0435\u0433\u0443 \u0441\u043e\u043d\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u043c\u044b \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435\u043c \u0426\u044f\u0431\u0435 \u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u0445 \u0456 \u0433\u0430\u0441\u0446\u0456\u043d\u043d\u0430 \u043f\u0440\u044b\u043c\u0430\u0435\u043c \u0443 \u043d\u0430\u0448\u044b\u043c \u0446\u0435\u043b\u0435. \u0423\u0447\u044b\u043d\u0456 \u043d\u0430\u0441 \u0432\u0430\u0440\u0442\u044b\u043c\u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043c\u044b \u0437\u0430\u0437\u043d\u0430\u043b\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435, \u043d\u0430 \u044f\u043a\u043e\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0451\u043c\u0441\u044f. \u041c\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u043c \u0422\u0432\u043e\u0439 \u0441\u043a\u0430\u0440\u0431 \u0443 \u043d\u0430\u0448\u044b\u043c \u0446\u0435\u043b\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u0430\u0441\u0446\u044b \u0445\u0440\u043e\u0441\u0442\u0443; \u043d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u044b \u0436 \u0441\u043a\u0430\u0440\u0431 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0441\u0442\u0430\u043b\u0435 \u0422\u0432\u0430\u0456\u0445 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u045e. \u0414\u0430\u0439 \u043d\u0430\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0422\u0432\u0430\u0451\u044e \u043b\u0430\u0441\u043a\u0430\u0439. \u0417 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0441\u0442\u0430\u043b\u0430 \u043c\u044b \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c, \u041f\u0430\u043d\u0435, \u0422\u0432\u043e\u0439 \u043d\u0430\u043f\u0430\u043c\u0456\u043d, \u043a\u0430\u0431 \u0443 \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0456 \u0451\u043d \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0436\u044b\u0446\u0446\u044f\u0432\u0456\u045e\u0441\u044f \u0434\u043b\u044f \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u0437 \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u043d\u0430\u0432\u0430\u0442 \u0443 \u043d\u0430\u0448\u0430\u0439 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u0422\u0432\u0430\u044f \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u044f \u0432\u043e\u043b\u044f, \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0434\u0430 \u044f\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u0456 \u043c\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0432\u0430\u0451 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u043d\u0435, \u0417\u0431\u0430\u045e\u0446\u0430 \u043d\u0430\u0448, \u0441\u0442\u0430\u043b\u0430 \u043a\u0430\u043d\u0446\u043e\u043c \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0414\u0430\u0439 \u043d\u0430\u043c \u0443\u043a\u0440\u044b\u0436\u043e\u045e\u0432\u0430\u0446\u044c \u0443 \u043d\u0430\u0441 \u043d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c \u0443 \u043f\u0440\u0430\u0434\u0447\u0443\u0432\u0430\u043d\u043d\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0422\u0432\u0430\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435, \u0415\u0437\u0443, \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u043b\u0456\u0446\u044c \u0432\u0435\u043b\u0456\u0447\u0447\u0443 \u043d\u0430\u0448 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0434\u0443\u0445. \u0411\u0430\u0447\u0430\u043d\u043d\u0435 \u0422\u0432\u0430\u0456\u0445 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u045e \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u043d\u0430\u0441 \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0430\u043c, \u0443 \u044f\u043a\u0456\u043c \u043c\u043e\u0436\u043d\u0430 \u043f\u0430\u0431\u0430\u0447\u044b\u0446\u044c \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0432\u0430\u044f \u0411\u043e\u0436\u0430\u044f \u044d\u043a\u0430\u043d\u043e\u043c\u0456\u044f, \u0417\u0431\u0430\u045e\u0446\u0430 \u043d\u0430\u0448, &ndash; \u0433\u044d\u0442\u0430 \u0432\u043e\u0431\u0440\u0430\u0437 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0414\u0430\u0439 \u043d\u0430\u043c \u0436\u044b\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u044f\u0435 \u044f\u043a \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u043b\u044e\u0434\u0437\u044f\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u044f\u0439, \u041f\u0430\u043d\u0435, \u043d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c \u0422\u0432\u0430\u0451\u0439 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0456 \u043d\u0435 \u0430\u0434\u0431\u0456\u0440\u0430\u0439 \u0430\u0434 \u043d\u0430\u0441 \u0422\u0432\u0430\u0451\u0439 \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u0421\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0445\u0430\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u043d\u0430\u0448\u044b\u043c \u0446\u0435\u043b\u0435, \u043f\u0430\u0448\u044b\u0440\u0430\u0435 \u043d\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u044e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c. \u041d\u044f\u0445\u0430\u0439 \u0430\u043a\u0440\u0430\u043f\u043b\u0435\u043d\u043d\u0435 \u0422\u0432\u0430\u0451\u0439 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u043f\u0440\u044b\u0431\u044f\u0440\u044d \u043d\u0430\u0441\u0442\u0443\u043f\u0441\u0442\u0432\u044b \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456 \u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430. \u0414\u0430\u0439 \u043d\u0430\u043c, \u041f\u0430\u043d\u0435, \u0441\u043f\u044f\u0448\u0430\u0446\u0446\u0430 \u0434\u0430 \u043d\u0430\u0448\u0430\u0439 \u0410\u0439\u0447\u044b\u043d\u044b \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u044f\u0435, \u044f\u043a \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u0439 \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0433\u0430\u0440\u044b \u045e \u0422\u0432\u0430\u0456\u043c \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0456\u0440 47, 10-11. 12\u0441d<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434 \u0443\u0441\u044f\u0433\u043e \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0451\u043d \u0430\u043f\u044f\u0432\u0430\u045e \u041f\u0430\u043d\u0430 \u0456 \u043b\u044e\u0431\u0456\u045e \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u044f\u0433\u043e.<span style=\"color: #ff0000;\"> *<\/span> \u041f\u0435\u0440\u0430\u0434 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430\u043c \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u043f\u0435\u045e\u0446\u0430\u045e, \u043a\u0430\u0431 \u0433\u0430\u043b\u0430\u0441\u044b \u0456\u0445 \u0443\u0447\u044b\u043d\u0456\u043b\u0456 \u043c\u0456\u043b\u0430\u0433\u0443\u0447\u043d\u044b\u043c \u0441\u043f\u0435\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u0431 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0430\u0441\u044f \u0456\u043c\u044f \u0441\u0432\u044f\u0442\u043e\u0435 \u041f\u0430\u043d\u0430, \u0456 \u0430\u0434 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u044f \u0433\u0443\u0447\u0430\u043b\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0435\u0440\u0430\u0434 \u0430\u0445\u0432\u044f\u0440\u043d\u0456\u043a\u0430\u043c \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u043f\u0435\u045e\u0446\u0430\u045e, \u043a\u0430\u0431 \u0433\u0430\u043b\u0430\u0441\u044b \u0456\u0445 \u0443\u0447\u044b\u043d\u0456\u043b\u0456 \u043c\u0456\u043b\u0430\u0433\u0443\u0447\u043d\u044b\u043c \u0441\u043f\u0435\u045e.<\/p>\r\n"}, {"GCH_CH_2_ID":"671","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041c\u0430\u0446\u0432\u0435\u044f&raquo; \u0441\u0432. \u0425\u0440\u0430\u043c\u0430\u0442\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 5, 1.3-4: CCL 9, 405-407)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u044b &ndash; \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0442\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0412\u044b \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0442\u0443. \u041d\u0435 \u043c\u043e\u0436\u0430 \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430 \u0433\u043e\u0440\u0430\u0434, \u044f\u043a\u0456 \u0441\u0442\u0430\u0456\u0446\u044c \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0433\u0430\u0440\u044b. \u0406, \u0437\u0430\u043f\u0430\u043b\u0456\u045e\u0448\u044b \u0441\u0432\u0435\u0442\u0430\u0447, \u043d\u0435 \u0441\u0442\u0430\u0432\u044f\u0446\u044c \u044f\u0433\u043e \u043f\u0430\u0434 \u043f\u0430\u0441\u0443\u0434\u0437\u0456\u043d\u0430\u0439, \u0430\u043b\u0435 \u043d\u0430 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0443, \u0456 \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u0443\u0441\u0456\u043c, \u0445\u0442\u043e \u045e \u0434\u043e\u043c\u0435&raquo; (\u041c\u0446 5, 14-15). \u0421\u043e\u043b\u043b\u044e \u0437\u044f\u043c\u043b\u0456 \u041f\u0430\u043d \u043d\u0430\u0437\u0432\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u044f\u043d\u044b \u043f\u0440\u044b\u043f\u0440\u0430\u045e\u043b\u044f\u044e\u0446\u044c, \u0432\u044f\u0440\u0442\u0430\u044e\u0447\u044b \u0441\u0432\u0435\u0436\u0430\u0441\u0446\u044c, \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u044b\u044f \u0434&rsquo;\u044f\u0431\u043b\u0430\u043c \u043b\u044e\u0434\u0441\u043a\u0456\u044f \u0441\u044d\u0440\u0446\u044b. \u041d\u0430\u0437\u044b\u0432\u0430\u0435 \u0456\u0445 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0441\u0432\u0435\u0442\u0443, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u044f\u043d\u044b \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u044f \u0406\u043c \u0441\u0430\u043c\u0456\u043c, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c \u0456 \u0432\u0435\u0447\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c. \u0406 \u0446\u044f\u043f\u0435\u0440 \u044f\u043d\u044b \u0441\u0430\u043c\u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0443 \u0437\u043c\u0440\u043e\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0433\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0401\u043d \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0441\u0432\u0435\u0442\u0443, \u0431\u043e \u043f\u0440\u0430\u0437 \u0456\u0445, \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u0440\u0430\u0437 \u0437\u0456\u0445\u043e\u0442\u043a\u0456\u044f \u043f\u0440\u043e\u043c\u043d\u0456, \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f; \u043a\u0430\u043b\u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044f \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0440\u0430\u045e\u0434\u044b, \u0443 \u043b\u044e\u0434\u0441\u043a\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445 \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0430\u0441\u044f \u0446\u0435\u043c\u0440\u0430 \u043f\u0430\u043c\u044b\u043b\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0456\u0445 \u0456 \u043c\u044b, \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u044f, \u0437 \u0446\u0435\u043c\u0440\u044b \u0441\u0442\u0430\u043b\u0456 \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u044f\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0432\u044b \u0431\u044b\u043b\u0456 \u0446\u0435\u043c\u0440\u0430\u0439, \u0430 \u0446\u044f\u043f\u0435\u0440 \u0432\u044b \u0441\u0432\u044f\u0442\u043b\u043e \u045e \u041f\u0430\u043d\u0443. \u041f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435, \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u0441\u0432\u044f\u0442\u043b\u0430&raquo; (\u042d\u0444 5, 8). \u0406 \u0437\u043d\u043e\u045e: &laquo;\u0412\u044b \u0441\u044b\u043d\u044b \u043d\u0435 \u043d\u043e\u0447\u044b \u0456 \u0437\u043c\u0440\u043e\u043a\u0443, \u0430\u043b\u0435 \u0441\u0432\u044f\u0442\u043b\u0430 \u0456 \u0434\u043d\u044f&raquo; (\u043f\u0430\u0440. 1 \u0422\u044d\u0441 5, 5).<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u0443\u0448\u043d\u0430 \u0456 \u0441\u0432\u044f\u0442\u044b \u042f\u043d \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u0443 \u0441\u0432\u0430\u0456\u043c \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0456: &laquo;\u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0421\u0432\u044f\u0442\u043b\u043e&raquo; (1 \u042f\u043d 1, 5), \u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0411\u043e\u0433\u0443, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0441\u0432\u044f\u0442\u043b\u0435, \u044f\u043a \u0456 \u0401\u043d \u0451\u0441\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u043b\u0435. \u0422\u0430\u043c\u0443, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u0440\u0430\u0434\u0443\u0435\u043c\u0441\u044f \u0441\u0432\u0430\u0439\u043c\u0443 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u044e \u0441\u0430 \u0437\u043c\u0440\u043e\u043a\u0443 \u043f\u0430\u043c\u044b\u043b\u0430\u043a, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0430\u045e\u0436\u0434\u044b \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u0441\u0432\u044f\u0442\u043b\u0430. \u0422\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: &laquo;\u0421\u044f\u0440\u043e\u0434 \u0456\u0445 \u0437\u0437\u044f\u0439\u0446\u0435, \u044f\u043a \u0441\u0432\u0435\u0442\u0430\u0447\u044b \u045e \u0441\u0432\u0435\u0446\u0435, \u0432\u0435\u0440\u043d\u0430 \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b\u0441\u044f \u0441\u043b\u043e\u0432\u0430 \u0436\u044b\u0446\u0446\u044f&raquo; (\u043f\u0430\u0440. \u0424\u043b\u043f 2, 15-16).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043c\u044b \u043d\u0435 \u0437\u0440\u043e\u0431\u0456\u043c \u0433\u044d\u0442\u0430\u0433\u0430, \u0442\u0430\u0434\u044b \u0430\u043a\u0430\u0436\u0430\u0446\u0446\u0430, \u0448\u0442\u043e \u0441\u0432\u0430\u0451\u0439 \u043d\u044f\u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044e, \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u043c \u043c\u044b \u0437\u0430\u0441\u043b\u0430\u043d\u044f\u0435\u043c \u0456 \u0437\u0430\u0446\u044f\u043d\u044f\u0435\u043c \u0442\u0430\u043a\u043e\u0435 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0435 \u0456 \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u043d\u0430 \u0448\u043a\u043e\u0434\u0443 \u043d\u0430\u043c \u0441\u0430\u043c\u0456\u043c \u0456 \u0456\u043d\u0448\u044b\u043c. \u0422\u0430\u043c\u0443 \u043c\u044b \u0456 \u0447\u044b\u0442\u0430\u0435\u043c \u0434\u043e\u0431\u0440\u0430 \u0432\u044f\u0434\u043e\u043c\u0443\u044e \u043f\u0440\u044b\u043f\u0430\u0432\u0435\u0441\u0446\u044c \u043f\u0440\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u0437\u043c\u0430\u0440\u043d\u0430\u0432\u0430\u045e \u0442\u0430\u043b\u0435\u043d\u0442, \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u044f\u043c\u0443 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u044b\u0433\u0430\u0434\u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f: \u0437\u0430\u043c\u0435\u0441\u0442 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0437\u0430\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0430 \u0456\u043c, \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0445\u0430\u0432\u0430\u045e \u0442\u0430\u043b\u0435\u043d\u0442 \u0456 \u043f\u0430\u043d\u0451\u0441 \u0437\u0430 \u0433\u044d\u0442\u0430 \u0437\u0430\u0441\u043b\u0443\u0436\u0430\u043d\u0430\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0442\u043e\u0439 \u044f\u0440\u043a\u0456 \u0441\u0432\u0435\u0442\u0430\u0447, \u0437\u0430\u043f\u0430\u043b\u0435\u043d\u044b \u0434\u043b\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0443 \u043d\u0430\u0441. \u0411\u043e \u043c\u044b \u043c\u0430\u0435\u043c \u0441\u0432\u0435\u0442\u0430\u0447 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u043f\u0440\u0430 \u044f\u043a\u0456\u044f \u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434: &laquo;\u0421\u043b\u043e\u0432\u0430 \u0422\u0432\u0430\u0451 &ndash; \u0441\u0432\u0435\u0442\u0430\u0447 \u0434\u043b\u044f \u043c\u0430\u0451\u0439 \u043d\u0430\u0433\u0456 \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u043b\u044f \u043c\u0430\u0451\u0439 \u0441\u0446\u0435\u0436\u043a\u0456&raquo; (\u043f\u0430\u0440. \u041f\u0441 119 [118], 105). \u041f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043a\u0430\u0436\u0430 \u0456 \u0421\u0430\u043b\u0430\u043c\u043e\u043d: &laquo;\u0411\u043e \u043d\u0430\u043a\u0430\u0437 \u0417\u0430\u043a\u043e\u043d\u0443 &ndash; \u0433\u044d\u0442\u0430 \u0441\u0432\u0435\u0442\u0430\u0447&raquo; (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 6, 23).<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0431\u0430\u0447\u043d\u0430, \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0437\u0430\u0441\u043b\u0430\u043d\u044f\u0446\u044c \u0441\u0432\u0435\u0442\u0430\u0447 \u0417\u0430\u043a\u043e\u043d\u0443 \u0456 \u0432\u0435\u0440\u044b, \u0430\u043b\u0435 \u0434\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043c\u043d\u043e\u0433\u0456\u0445 \u044f\u0433\u043e \u0442\u0440\u044d\u0431\u0430 \u0437\u043c\u044f\u0441\u0446\u0456\u0446\u044c \u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0431\u044b\u0446\u0446\u0430\u043c \u043d\u0430 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0443, \u043a\u0430\u0431 \u043c\u044b \u0441\u0430\u043c\u0456 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0441\u0430\u043c\u043e\u0439 \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u043a\u0430\u0431 \u044f\u043d\u043e \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u043b\u0430 \u045e\u0441\u0456\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0437 11, 23-24<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0411\u0430\u0440\u043d\u0430\u0431\u0430 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0410\u043d\u0442\u044b\u0451\u0445\u0456\u044e \u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439, \u0443\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f,<span style=\"color: #ff0000;\"> *<\/span> \u0431\u043e \u0451\u043d \u0431\u044b\u045e \u043c\u0443\u0436 \u0434\u043e\u0431\u0440\u044b, \u043f\u043e\u045e\u043d\u044b \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u0432\u0435\u0440\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u045e \u0443\u0441\u0456\u0445, \u043a\u0430\u0431 \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0442\u0440\u044b\u0432\u0430\u043b\u0456 \u045e \u041f\u0430\u043d\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0451\u043d \u0431\u044b\u045e \u043c\u0443\u0436 \u0434\u043e\u0431\u0440\u044b, \u043f\u043e\u045e\u043d\u044b \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u0432\u0435\u0440\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"673","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u043d\u0442\u043e\u043d\u0456\u044f \u0437 \u041f\u0430\u0434\u0443\u0456, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(\u0406, 226)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u043e\u0432\u0430 \u043f\u043b\u0451\u043d\u043d\u0430\u044f \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0447\u044b\u043d\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u0445\u0442\u043e \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u043c\u043e\u0432\u0430\u043c\u0456. \u0420\u043e\u0437\u043d\u044b\u044f \u043c\u043e\u0432\u044b &ndash; \u0433\u044d\u0442\u0430 \u0440\u043e\u0437\u043d\u044b\u044f \u0441\u043f\u043e\u0441\u0430\u0431\u044b \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c: \u043f\u0430\u043a\u043e\u0440\u0430, \u0443\u0431\u043e\u0441\u0442\u0432\u0430, \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c. \u041c\u044b \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435\u043c \u0456\u043c\u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0456\u043d\u0448\u044b\u044f \u0431\u0430\u0447\u0430\u0446\u044c \u0456\u0445 \u0443 \u043d\u0430\u0441. \u0410 \u043c\u043e\u0432\u0430 \u043f\u043b\u0451\u043d\u043d\u0430\u044f \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0447\u044b\u043d\u044b. \u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u043c\u043e\u045e\u043a\u043d\u0443\u0446\u044c \u0441\u043b\u043e\u0432\u044b, \u0456 \u043f\u0440\u0430\u043c\u043e\u0432\u044f\u0446\u044c \u0447\u044b\u043d\u044b. \u0423 \u043d\u0430\u0441 \u0436\u0430 \u043f\u043e\u045e\u043d\u0430 \u0441\u043b\u043e\u045e, \u0430\u043b\u0435 \u0447\u044b\u043d\u0430\u045e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0435 \u0441\u0442\u0430\u0435. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430\u043c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435, \u044f\u043a \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e \u0441\u043c\u0430\u043a\u043e\u045e\u043d\u0456\u0446\u044b, \u043d\u0430 \u044f\u043a\u043e\u0439 \u0437\u0430\u043c\u0435\u0441\u0442 \u043f\u043b\u043e\u0434\u0443 \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u0456\u0441\u0446\u0435. &laquo;\u0410\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u043c \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430, &ndash; \u043a\u0430\u0436\u0430 \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u0439, &ndash; \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435&raquo;. \u0414\u0430\u0440\u044d\u043c\u043d\u044b\u043c \u0431\u0443\u0434\u0437\u0435 \u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0417\u0430\u043a\u043e\u043d\u0443 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u043f\u0435\u0440\u0430\u043a\u0440\u044d\u0441\u043b\u0456\u0432\u0430\u0435 \u0442\u043e\u0435, \u0447\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u043b\u0456 \u0442\u0430\u043a, &laquo;\u044f\u043a \u0414\u0443\u0445 \u0434\u0430\u0432\u0430\u045e \u0456\u043c \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c&raquo; (\u0414\u0437 2, 4). \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0442\u0430\u043a, \u044f\u043a \u0434\u044b\u043a\u0442\u0443\u0435 \u044f\u043c\u0443 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u0430 \u043d\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0435 \u044f\u0433\u043e \u0430\u0434\u0447\u0443\u0432\u0430\u043d\u043d\u0435. \u0411\u043e \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0456\u044f, \u0445\u0442\u043e \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f \u0456 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0456\u043d\u0448\u044b\u0445, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b. \u041f\u0440\u0430 \u0442\u0430\u043a\u0456\u0445 \u0456 \u043f\u0440\u0430 \u0456\u043c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u0445 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0415\u0440\u0430\u043c\u0456\u0456: &laquo;\u042f \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u044e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u044b. \u0412\u043e\u0441\u044c \u042f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u0430\u044e\u0446\u044c \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u044b\u044f \u0441\u043d\u044b, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0456\u0445 \u0456 \u0437\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u043c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u043f\u0430\u0434\u043c\u0430\u043d\u0430\u043c \u0456 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u043c\u0456 \u0437\u043d\u0430\u043a\u0430\u043c\u0456. \u042f \u043d\u0435 \u043f\u0430\u0441\u043b\u0430\u045e \u0456\u0445 \u0456 \u043d\u0435 \u0434\u0430\u045e \u0437\u0430\u0433\u0430\u0434\u0430\u045e. \u042f\u043d\u044b \u0432\u0430 \u045e\u0441\u0456\u043c \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u044b\u044f \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0443, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d&raquo; (\u043f\u0430\u0440. \u0415\u0440 23, 30-32).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0442\u044b\u043c, \u0448\u0442\u043e \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043d\u0430\u043c \u043a\u0430\u0437\u0430\u0446\u044c. \u0411\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u042f\u0433\u043e \u0437 \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0456 \u043c\u043e\u0446\u043d\u0430 \u0430\u0431 \u043b\u0430\u0441\u0446\u044b, \u043a\u0430\u0431 \u043c\u044b \u0437\u043c\u0430\u0433\u043b\u0456 \u043d\u0430\u043d\u043e\u0432\u0430 \u0440\u044d\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u0446\u044c \u0434\u0437\u0435\u043d\u044c \u041f\u044f\u0446\u0456\u0434\u0437\u0435\u0441\u044f\u0442\u043d\u0456\u0446\u044b \u043f\u0440\u0430\u0437 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u043f\u044f\u0446\u0456 \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u045e \u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0434\u0437\u0435\u0441\u044f\u0446\u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e. \u0411\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0430\u0431 \u0434\u0430\u0440\u044b \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f, \u0430\u0431 \u043f\u0430\u043b\u044b\u043c\u044f\u043d\u044b\u043c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0456, \u043a\u0430\u0431 \u043c\u044b, \u0442\u0430\u043a \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b\u044f \u0456 \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u044b\u044f, \u043c\u0430\u0433\u043b\u0456 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b\u0445 \u0410\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u045e \u0422\u0440\u043e\u0439\u0446\u044b \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041e\u0441 14, 6b; \u041f\u0441 92 (91), 13; \u0421\u0456\u0440 24, 4\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0437\u0430\u043a\u0432\u0456\u0442\u043d\u0435\u0435, \u044f\u043a \u043b\u0456\u043b\u0435\u044f.<span style=\"color: #ff0000;\"> *<\/span> \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u0446\u0432\u0456\u0441\u0446\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u043d\u0430 \u0441\u0445\u043e\u0434\u0437\u0435 \u0441\u0432\u044f\u0442\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u0446\u0432\u0456\u0441\u0446\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"674","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0416\u044b\u0446\u0446\u0451 \u0441\u0432. \u0420\u0430\u043c\u0443\u0430\u043b\u044c\u0434\u0430&raquo;, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u0435 \u0441\u0432. \u041f\u044f\u0442\u0440\u043e\u043c \u0414\u0430\u043c&rsquo;\u044f\u043d\u0456<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 31 et 69: PL 144, 982-983. 1005-1006)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0430 \u0448\u043b\u044f\u0445\u0443 \u0432\u044b\u0440\u0430\u0447\u044d\u043d\u043d\u044f\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0442\u0440\u043e\u0445 \u0433\u0430\u0434\u043e\u045e \u0420\u0430\u043c\u0443\u0430\u043b\u044c\u0434 \u0436\u044b\u045e \u043d\u0430 \u0442\u044d\u0440\u044b\u0442\u043e\u0440\u044b\u0456 \u0433\u043e\u0440\u0430\u0434\u0430 \u041f\u0430\u0440\u044d\u043d\u0446\u0430. \u0423 \u043f\u0435\u0440\u0448\u044b \u0433\u043e\u0434 \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u045e \u043a\u043b\u044f\u0448\u0442\u0430\u0440 \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0442\u0443\u0434\u044b \u0430\u0431\u0430\u0442\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0431\u0440\u0430\u0442\u0430\u043c\u0456. \u041d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0434\u0432\u0443\u0445 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u0445 \u0433\u0430\u0434\u043e\u045e \u0436\u044b\u045e \u0443 \u0441\u0430\u043c\u043e\u0446\u0435. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0411\u043e\u0436\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u043f\u0440\u044b\u0432\u044f\u043b\u0430 \u044f\u0433\u043e \u0434\u0430 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u044f \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043c\u043e\u0433 \u043f\u0440\u0430\u0434\u0431\u0430\u0447\u044b\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u044f \u0431\u0443\u0434\u0443\u0447\u044b\u044f \u0440\u044d\u0447\u044b, \u0430, \u043c\u0430\u044e\u0447\u044b \u0445\u0443\u0442\u043a\u0456 \u0440\u043e\u0437\u0443\u043c, \u0451\u043d \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u045e \u0441\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0421\u0442\u0430\u0440\u043e\u0433\u0430 \u0456 \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u0430\u0434\u043d\u043e\u0439\u0447\u044b \u0442\u0430\u043a \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u0437\u0430\u043d\u0443\u0440\u0430\u045e\u0441\u044f \u045e \u043a\u0430\u043d\u0442\u044d\u043c\u043f\u043b\u044f\u0446\u044b\u044e \u0411\u043e\u0433\u0430, \u0448\u0442\u043e \u045e\u0437\u0440\u0443\u0448\u0432\u0430\u045e\u0441\u044f \u0434\u0430 \u0441\u043b\u0451\u0437 \u0456 \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0433\u0430 \u043f\u043e\u043b\u044b\u043c\u044f \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u041e \u0415\u0437\u0443 \u043c\u0456\u043b\u044b, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u0430\u0441\u0430\u043b\u043e\u0434\u0430, \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0435 \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0435, \u0440\u0430\u0441\u043a\u043e\u0448\u0430 \u0441\u0432\u044f\u0442\u044b\u0445, \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0430\u043d\u0451\u043b\u0430\u045e!&raquo; \u041d\u0435 \u043c\u043e\u0436\u0430\u043c \u043b\u044e\u0434\u0441\u043a\u043e\u0439 \u043c\u043e\u0432\u0430\u044e \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u0456 \u043a\u0430\u0437\u0430\u045e \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0443\u0434\u044b \u0431 \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0433\u044d\u0442\u044b \u0441\u0432\u044f\u0442\u044b \u043c\u0443\u0436, \u043a\u0430\u0431 \u0434\u0430\u045e\u0436\u044d\u0439 \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u0446\u0430, \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0443 \u043a\u0435\u043b\u043b\u0456 \u043c\u0430\u043b\u0435\u043d\u044c\u043a\u0443\u044e \u043a\u0430\u043f\u043b\u0456\u0446\u0443 \u0437 \u0430\u043b\u0442\u0430\u0440\u043e\u043c, \u0430 \u043f\u0430\u0441\u043b\u044f \u0437\u0430\u043c\u044b\u043a\u0430\u045e\u0441\u044f, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u0443 \u0441\u0430\u043c\u043e\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0432\u0430\u043d\u0434\u0440\u0443\u044e\u0447\u044b \u043f\u0430 \u043c\u043d\u043e\u0433\u0456\u0445 \u0440\u043e\u0437\u043d\u044b\u0445 \u043c\u0435\u0441\u0446\u0430\u0445, \u043a\u0430\u043b\u0456 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u045e \u0431\u043b\u0456\u0437\u043a\u0456 \u043a\u0430\u043d\u0435\u0446 \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f, \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0440\u0430\u043d\u0435\u0439 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u0430 \u045e \u0412\u0430\u043b\u044c \u0434\u0437\u0456 \u041a\u0430\u0441\u0442\u0440\u0430. \u0427\u0430\u043a\u0430\u044e\u0447\u044b \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0443 \u043d\u0430\u0431\u043b\u0456\u0436\u044d\u043d\u043d\u044f \u043c\u043e\u043c\u0430\u043d\u0442\u0443 \u0430\u0434\u044b\u0445\u043e\u0434\u0443 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u0441\u0430\u0431\u0435 \u043a\u0435\u043b\u043b\u044e \u0437 \u043a\u0430\u043f\u043b\u0456\u0446\u0430\u0439, \u043a\u0430\u0431 \u0443 \u0430\u0434\u0430\u0441\u0430\u0431\u043b\u0435\u043d\u043d\u0456 \u043c\u043e\u0433 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435 \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0456 \u0430\u0434\u0430\u0441\u043e\u0431\u043b\u0435\u043d\u0430\u0435 \u043c\u0435\u0441\u0446\u0430, \u0456 \u0451\u043d \u0443\u0436\u043e \u043c\u043e\u0433 \u043f\u0430\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u045e \u0456\u043c, \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0447\u0430\u045e \u0433\u0443\u0431\u043b\u044f\u0446\u044c \u0441\u0456\u043b\u044b \u043d\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0437-\u0437\u0430 \u0445\u0432\u0430\u0440\u043e\u0431\u044b, \u043a\u043e\u043b\u044c\u043a\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0442\u0430\u0440\u0430\u0441\u0446\u0456. \u0410\u0434\u043d\u043e\u0439\u0447\u044b \u0441\u0443\u0440&rsquo;\u0451\u0437\u043d\u0430 \u0441\u0430\u0441\u043b\u0430\u0431\u0435\u045e \u0443 \u0432\u044b\u043d\u0456\u043a\u0443 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430 \u0437\u043d\u044f\u0441\u0456\u043b\u0435\u043d\u043d\u044f. \u041f\u0440\u044b \u0437\u0430\u0445\u0430\u0434\u0437\u0435 \u0441\u043e\u043d\u0446\u0430 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0434\u0432\u0443\u043c \u0441\u0432\u0430\u0456\u043c \u0431\u0440\u0430\u0442\u0430\u043c, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u043f\u0440\u044b \u0456\u043c, \u043a\u0430\u0431 \u044f\u043d\u044b \u0432\u044b\u0439\u0448\u043b\u0456, \u0437\u0430\u0447\u044b\u043d\u0456\u043b\u0456 \u0437\u0430 \u0441\u0430\u0431\u043e\u044e \u0434\u0437\u0432\u0435\u0440\u044b \u043a\u0435\u043b\u043b\u0456 \u0456 \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0437\u0430\u045e\u0442\u0440\u0430 \u043d\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456, \u043a\u0430\u0431 \u0447\u044b\u0442\u0430\u0446\u044c \u042e\u0442\u0440\u0430\u043d\u044c. \u0422\u044b\u044f, \u043d\u0435 \u0441\u043f\u044f\u0448\u0430\u044e\u0447\u044b\u0441\u044f, \u0432\u044b\u0439\u0448\u043b\u0456, \u0437\u0430\u043a\u043b\u0430\u043f\u043e\u0447\u0430\u043d\u044b\u044f \u044f\u0433\u043e \u0441\u0442\u0430\u043d\u0430\u043c. \u0410\u0434\u043d\u0430\u043a, \u0431\u0430\u044e\u0447\u044b\u0441\u044f, \u043a\u0430\u0431 \u0451\u043d \u043d\u0435 \u043f\u0430\u043c\u0451\u0440, \u043d\u0435 \u043f\u0430\u0439\u0448\u043b\u0456 \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c, \u0430\u043b\u0435 \u0441\u0445\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0435\u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u043a\u0435\u043b\u043b\u0456 \u0456 \u0447\u0443\u0432\u0430\u043b\u0456 \u043a\u0430\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0433\u0430 \u0441\u043a\u0430\u0440\u0431\u0443. \u0422\u0430\u043a \u0442\u0440\u044b\u0432\u0430\u043b\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b \u0447\u0430\u0441. \u041a\u0430\u043b\u0456 \u045e\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u043b\u0456\u0441\u044f, \u043d\u0435 \u043f\u0430\u0447\u0443\u043b\u0456 \u043d\u0456\u044f\u043a\u0456\u0445 \u043f\u0440\u044b\u043a\u043c\u0435\u0442 \u0440\u0443\u0445\u0443 \u0446\u0435\u043b\u0430 \u0456 \u0433\u043e\u043b\u0430\u0441\u0443. \u0414\u0430\u0434\u0443\u043c\u0432\u0430\u044e\u0447\u044b\u0441\u044f, \u0448\u0442\u043e \u043c\u0430\u0433\u043b\u043e \u0441\u0442\u0430\u0446\u0446\u0430, \u0430\u0434\u0447\u044b\u043d\u0456\u043b\u0456 \u0434\u0437\u0432\u0435\u0440\u044b \u0456 \u045e\u0432\u0430\u0439\u0448\u043b\u0456 \u045e \u043a\u0435\u043b\u043b\u044e. \u0417\u0430\u043f\u0430\u043b\u0456\u045e\u0448\u044b \u0441\u0432\u044f\u0442\u043b\u043e, \u0443\u0431\u0430\u0447\u044b\u043b\u0456 \u043c\u0451\u0440\u0442\u0432\u0430\u0435 \u0446\u0435\u043b\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u043b\u044f\u0436\u0430\u045e \u043d\u0430\u045e\u0437\u043d\u0456\u0447. \u042f\u0433\u043e \u0434\u0443\u0448\u0430 \u0430\u0434\u044b\u0448\u043b\u0430 \u045e\u0436\u043e \u043d\u0430 \u043d\u0435\u0431\u0430, \u0430 \u0446\u0435\u043b\u0430 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u043b\u0430 \u044f\u043a \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u0430\u044f \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u044f \u043f\u044f\u0440\u043b\u0456\u043d\u0430, \u044f\u043a\u0430\u044f \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u0437 \u043f\u0430\u0448\u0430\u043d\u0430\u044e \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u0430 \u045e \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u0443 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u041a\u0430\u0440\u0430\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0414\u0440\u0433 2, 7; 8, 5b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d, \u044f\u043a\u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u043f\u0440\u0430\u0446\u0443 \u0442\u0432\u0430\u0456\u0445 \u0440\u0443\u043a, \u0430\u043f\u0435\u043a\u0430\u0432\u0430\u045e\u0441\u044f \u0442\u0430\u0431\u043e\u044e \u043f\u0430\u0434\u0447\u0430\u0441 \u0432\u0430\u043d\u0434\u0440\u0430\u0432\u0430\u043d\u043d\u044f \u043f\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043f\u0443\u0441\u0442\u044b\u043d\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0417 \u0442\u0430\u0431\u043e\u044e \u041f\u0430\u043d, \u0442\u0432\u043e\u0439 \u0411\u043e\u0433. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044b\u043d\u0430, \u0442\u0430\u043a \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0435 \u0446\u044f\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417 \u0442\u0430\u0431\u043e\u044e \u041f\u0430\u043d, \u0442\u0432\u043e\u0439 \u0411\u043e\u0433.<\/p>\r\n"}, {"GCH_CH_2_ID":"675","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0410\u043b\u0430\u0456\u0437\u0456\u044f \u0413\u0430\u043d\u0437\u0430\u0433\u0456 \u0434\u0430 \u043c\u0430\u0446\u0456<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Acta Sanctorum, Junii, 5, 878)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u0435\u0447\u043d\u0430 \u0431\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0411\u043e\u0436\u0443\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043c\u0430\u043b\u044e\u0441\u044f \u0430\u0431 \u0442\u044b\u043c, \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u0430\u044f \u043f\u0430\u043d\u0456, \u043a\u0430\u0431 \u043b\u0430\u0441\u043a\u0430 \u0456 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u043b\u0430 \u0442\u0430\u0431\u0435. \u0428\u0442\u043e \u0434\u0430 \u043c\u044f\u043d\u0435, \u0442\u043e \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u045e \u044f \u044f\u0448\u0447\u044d \u045e \u043a\u0440\u0430\u0456\u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u043b\u0456 \u043c\u043d\u0435 \u0442\u0432\u043e\u0439 \u043b\u0456\u0441\u0442. \u0406 \u0432\u043e\u0441\u044c \u0446\u044f\u043f\u0435\u0440 \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u045e\u0441\u0435 \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0456 \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0446\u044c \u0434\u0430 \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u0437\u043c\u0430\u0433\u0447\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0411\u043e\u0433\u0430 \u045e \u043a\u0440\u0430\u0456\u043d\u0435 \u0436\u044b\u0432\u044b\u0445. \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u044f \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u045e\u0441\u044f, \u0448\u0442\u043e \u0433\u044d\u0442\u0430\u0435 \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430 \u044f \u0437\u0430\u043a\u043e\u043d\u0447\u0443 \u0440\u0430\u043d\u0435\u0439. \u041a\u0430\u043b\u0456 \u043b\u044e\u0431\u043e\u045e, &ndash; \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, &ndash; \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u043f\u043b\u0430\u043a\u0430\u0446\u044c \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u043f\u043b\u0430\u0447\u0430, \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430, \u0442\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u0430, \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u0430\u044f \u043c\u0430\u0446\u0456, \u043c\u043e\u0446\u043d\u0430 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0411\u043e\u0433 \u0443 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0456 \u0434\u0437\u0435\u043b\u044f \u0442\u0432\u0430\u0456\u0445 \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u045e \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u043c\u043d\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0443\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435 \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443, \u0448\u0442\u043e \u043c\u0430\u0433\u0443 \u0456\u0445 \u0441\u0442\u0440\u0430\u0446\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0437\u043d\u0430\u044e\u0441\u044f \u0442\u0430\u0431\u0435, \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u0430\u044f \u043f\u0430\u043d\u0456, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b \u0440\u0430\u0437, \u043a\u0430\u043b\u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e \u043f\u0440\u0430 \u0411\u043e\u0436\u0443\u044e \u0434\u0430\u0431\u0440\u044b\u043d\u044e, \u043f\u0440\u0430 \u0433\u044d\u0442\u0430\u0435 \u043d\u0435\u0432\u044b\u0447\u044d\u0440\u043f\u043d\u0430\u0435 \u0456 \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u0435 \u043c\u043e\u0440\u0430, \u043c\u043e\u0439 \u0440\u043e\u0437\u0443\u043c \u0433\u0443\u0431\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430. \u041f\u0435\u0440\u0430\u0434 \u0442\u0430\u043a\u043e\u0439 \u0432\u0435\u043b\u0456\u0447\u0447\u0443 \u0433\u0443\u0431\u043b\u044f\u0435 \u0451\u043d \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u0435, \u0447\u0430\u043c\u0443 \u041f\u0430\u043d \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u043a\u043e\u0439 \u043d\u044f\u0437\u043d\u0430\u0447\u043d\u0430\u0439 \u0456 \u043a\u0430\u0440\u043e\u0442\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b \u0437\u0430\u043f\u0440\u0430\u0448\u0430\u0435 \u043c\u044f\u043d\u0435 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u044e. \u041a\u043b\u0456\u0447\u0430 \u043c\u044f\u043d\u0435 \u0437 \u043d\u0435\u0431\u0430 \u0434\u0430 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f, \u044f\u043a\u043e\u0433\u0430 \u044f \u0442\u0430\u043a \u043d\u044f\u0434\u0431\u0430\u0439\u043d\u0430 \u0448\u0443\u043a\u0430\u045e, \u0456 \u0430\u0431\u044f\u0446\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0437\u0430 \u0441\u043b\u0451\u0437\u044b, \u044f\u043a\u0456\u0445 \u044f \u0442\u0430\u043a \u043c\u0430\u043b\u0430 \u043f\u0440\u0430\u043b\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430, \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u0430\u044f \u043f\u0430\u043d\u0456, \u0456 \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u0439\u0441\u044f, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u044c \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0443\u044e \u0411\u043e\u0436\u0443\u044e \u043b\u044e\u0431\u043e\u045e. \u0406 \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0433\u044d\u0442\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0431 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0431 \u0442\u044b \u0430\u043f\u043b\u0430\u043a\u0432\u0430\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0411\u043e\u0433\u0430 \u0456 \u0441\u0432\u0430\u0456\u043c \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0446\u044c \u0442\u0430\u0431\u0435 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043f\u0440\u044b \u0436\u044b\u0446\u0446\u0456. \u0414\u044b \u0456 \u043d\u0430\u0448\u0430\u0435 \u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0435 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0434\u043e\u045e\u0433\u0456\u043c. \u0423 \u043d\u0435\u0431\u0435 \u045e\u0431\u0430\u0447\u044b\u043c\u0441\u044f \u0456\u0437\u043d\u043e\u045e. \u041d\u0430\u0432\u0435\u043a\u0456 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u0437 \u043d\u0430\u0448\u044b\u043c \u0417\u0431\u0430\u045e\u0446\u0430\u043c, \u0443\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u043d\u044b\u044f \u0448\u0447\u0430\u0441\u0446\u0435\u043c \u0432\u0435\u0447\u043d\u044b\u043c, \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b\u0430\u045e \u0431\u0443\u0434\u0437\u0435\u043c \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u042f\u0433\u043e \u0456 \u0432\u0435\u0447\u043d\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u0411\u043e\u0433 \u0437\u0430\u0431\u0456\u0440\u0430\u0435 \u0430\u0434 \u043d\u0430\u0441 \u0441\u0432\u043e\u0439 \u0434\u0430\u0440 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0437\u043c\u044f\u0441\u0446\u0456\u0446\u044c \u044f\u0433\u043e \u045e \u0431\u043e\u043b\u044c\u0448 \u043d\u0430\u0434\u0437\u0435\u0439\u043d\u044b\u043c \u0456 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u0430 \u043d\u0430\u043c \u0434\u0430\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043c\u044b \u0441\u0430\u043c\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u043f\u0456\u0448\u0443, \u0431\u043e \u0433\u043e\u0440\u0430\u0447\u0430 \u0436\u0430\u0434\u0430\u044e, \u043a\u0430\u0431 \u0442\u044b, \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u0430\u044f \u043f\u0430\u043d\u0456, \u0456 \u045e\u0432\u043e\u0433\u0443\u043b\u0435 \u045e\u0441\u044f \u0441\u044f\u043c&rsquo;\u044f, \u043b\u0456\u0447\u044b\u043b\u0430 \u043c\u0430\u044e \u0441\u043c\u0435\u0440\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u043d\u0430\u0439 \u043f\u0430\u0434\u0437\u0435\u044f\u0439, \u043a\u0430\u0431 \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u043b\u0430 \u043c\u043d\u0435 \u043c\u0430\u0442\u0447\u044b\u043d\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u0456\u0441\u0446\u0456 \u0433\u044d\u0442\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u0439, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0434\u0430\u0439\u0434\u0443 \u0434\u0430 \u043c\u0435\u0441\u0446\u0430, \u0434\u0437\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u045e\u0441\u0435 \u043c\u0430\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u043d\u0456. \u041f\u0456\u0448\u0443 \u0433\u044d\u0442\u0430 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0430\u0445\u0432\u043e\u0442\u0430\u0439, \u0431\u043e \u043d\u0456\u0447\u044b\u043c \u0456\u043d\u0448\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0437\u043c\u0430\u0433\u0443 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0443\u044e \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u0431\u0435 \u044f\u043a \u0441\u044b\u043d \u043c\u0430\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 41 (40), 13; 84 (83), 11bc<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u043c\u044f\u043d\u0435 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0435\u0448, \u041f\u0430\u043d\u0435, \u0437\u0430 \u043c\u0430\u044e \u043d\u044f\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u044c <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0448 \u043c\u044f\u043d\u0435 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0422\u0432\u0430\u0456\u043c \u043d\u0430\u0432\u0435\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041b\u0435\u043f\u0448 \u0431\u0443\u0434\u0443 \u0441\u0442\u0430\u044f\u0446\u044c \u043d\u0430 \u043f\u0430\u0440\u043e\u0437\u0435 \u0434\u043e\u043c\u0443 \u043c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430, \u0447\u044b\u043c \u0436\u044b\u0446\u044c \u0443 \u0448\u0430\u0442\u0440\u0430\u0445 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0448 \u043c\u044f\u043d\u0435 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0422\u0432\u0430\u0456\u043c \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"676","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041f\u0430\u045e\u043b\u0456\u043d\u0430 \u041d\u043e\u043b\u044c\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 3 ad Alypium, 1. 5. 6: CSEL 29, 13-14, 17-18)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0411\u043e\u0433 \u0443\u0441\u044e\u0434\u044b \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043b\u044e\u0431\u043e\u045e \u0456 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0439\u0448\u0430\u043d\u043e\u045e\u043d\u0435\u0439\u0448\u044b, \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u044b \u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u043f\u0430\u043d\u0435! \u0422\u044b \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u043c\u043d\u0435, \u044f\u043a\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0456 \u043f\u0440\u044b\u0432\u044f\u0437\u0430\u043d\u0430\u0441\u0446\u044c \u043c\u0430\u0435\u0448 \u0434\u0430 \u043c\u0430\u0451\u0439 \u0441\u0446\u0456\u043f\u043b\u0430\u0439 \u0430\u0441\u043e\u0431\u044b. \u0412\u043e\u0441\u044c \u044f \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u042e\u043b\u0456\u044f\u043d\u0430, \u044f\u043a\u0456 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0437 \u041a\u0430\u0440\u0444\u0430\u0433\u0435\u043d\u0430, \u043b\u0456\u0441\u0442, \u0443 \u044f\u043a\u0456\u043c \u0442\u0430\u043a \u0448\u043c\u0430\u0442 \u0441\u0432\u044f\u0442\u043b\u0430 \u0442\u0432\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0437\u043d\u0430\u044e \u0442\u0432\u0430\u044e \u043b\u044e\u0431\u043e\u045e, \u0430\u043b\u0435 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u044e \u0434\u0430\u045e\u043d\u043e \u0456\u0441\u043d\u0443\u044e\u0447\u0443\u044e. \u0411\u043e \u043b\u044e\u0431\u043e\u045e \u0433\u044d\u0442\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0430\u0441 \u0432\u044b\u0431\u0440\u0430\u045e \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0430\u0434 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443. \u0423 \u0406\u043c \u043c\u044b \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u043d\u044b\u044f \u044f\u0448\u0447\u044d \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c, \u044f\u043a \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456\u0441\u044f, &laquo;\u0431\u043e \u0401\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u043d\u0430\u0441, \u0430 \u043d\u0435 \u043c\u044b \u0441\u044f\u0431\u0435&raquo; (\u041f 100 [99], 3). \u0401\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0430\u0434\u0431\u044b\u0446\u0446\u0430. \u041f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u0443 \u0432\u044b\u043d\u0456\u043a\u0443 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043d\u0430\u043c\u0435\u0440\u0443 \u0456 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b, \u043c\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u045e \u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0456 \u045e \u0442\u043e\u0439 \u0441\u0430\u043c\u0430\u0439 \u0432\u0435\u0440\u044b \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0430\u044f \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u0435 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c \u044f\u043a \u043c\u044b \u045e\u0431\u0430\u0447\u044b\u043b\u0456\u0441\u044f, \u0443\u0436\u043e \u0437\u043d\u0430\u0439\u0448\u043b\u0456\u0441\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044e \u0414\u0443\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u044b \u0446\u0435\u0448\u044b\u043c\u0441\u044f \u0456 \u0440\u0430\u0434\u0443\u0435\u043c\u0441\u044f \u045e \u041f\u0430\u043d\u0443, \u044f\u043a\u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0442\u043e\u0439 \u0441\u0430\u043c\u044b, \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043b\u044e\u0431\u043e\u045e \u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u0430\u0456\u0445 \u0432\u0435\u0440\u043d\u044b\u0445 \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456. \u0401\u043d \u043f\u0440\u0430\u043b\u0456\u045e \u042f\u0433\u043e \u043d\u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 &laquo;\u043d\u0456\u0431\u044b \u043f\u0430\u0442\u043e\u043a \u0440\u0430\u043a\u0456, \u0448\u0442\u043e \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u044c \u0411\u043e\u0436\u044b \u0433\u043e\u0440\u0430\u0434&raquo;. \u0423 \u0433\u044d\u0442\u044b\u043c \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u044f \u0421\u0442\u0430\u043b\u0456\u0446\u0430 \u0441\u043b\u0443\u0448\u043d\u0430 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0430 \u0446\u044f\u0431\u0435 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c &laquo;\u0441\u044f\u0440\u043e\u0434 \u043a\u043d\u044f\u0437\u0451\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443&raquo; (\u043f\u0430\u0440. \u041f 113 [112], 8). \u0406 \u043d\u0430\u0441, \u0441\u043b\u0430\u0431\u044b\u0445 \u0456 \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u044b\u0445, \u0443\u0437\u043d\u044f\u045e\u0448\u044b \u0437 \u043f\u044b\u043b\u0443 \u0437\u044f\u043c\u043b\u0456, \u043f\u0430\u0436\u0430\u0434\u0430\u043b\u0430 \u0434\u0430\u043b\u0443\u0447\u044b\u0446\u044c \u0434\u0430 \u0432\u0430\u0448\u0430\u0433\u0430 \u043a\u043e\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0440\u0430\u0434\u0443\u0435\u043c\u0441\u044f \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0411\u043e\u0433 \u0434\u0430\u045e \u043d\u0430\u043c \u043c\u0435\u0441\u0446\u0430 \u045e \u0442\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b, \u0448\u0442\u043e \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0443\u0432\u0435\u0441\u0446\u0456 \u043d\u0430\u0441 \u0443 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0442\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u0410\u0431\u0430\u0432\u044f\u0437\u0430\u043d\u044b\u044f \u0442\u0430\u043a\u0456\u043c \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u043c \u0456 \u0432\u0435\u0442\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u043c\u043e\u0446\u043d\u0430 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0435\u043c\u0441\u044f \u043d\u0430 \u0442\u0432\u0430\u044e \u043b\u044e\u0431\u043e\u045e, \u0430 \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u043a\u0443 \u0430\u0431\u044f\u0446\u0430\u0435\u043c \u0433\u043e\u0440\u0430\u0447\u0430 \u0456 \u0448\u0447\u044b\u0440\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0446\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043a\u0430\u0431 \u0442\u044b \u045e\u0441\u0451 \u043f\u0440\u0430 \u043c\u044f\u043d\u0435 \u0432\u0435\u0434\u0430\u045e, \u0437\u043d\u0430\u0439, \u0448\u0442\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0442\u0432\u0430\u0456\u043c \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c \u0437\u0430\u043a\u0430\u043c\u044f\u043d\u0435\u043b\u044b \u0433\u0440\u044d\u0448\u043d\u0456\u043a \u0431\u044b\u045e \u0432\u044b\u0446\u044f\u0433\u043d\u0443\u0442\u044b \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0437 \u0446\u0435\u043c\u0440\u044b \u0456 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0446\u0435\u043d\u044e, \u043a\u0430\u0431 \u0443\u0434\u044b\u0445\u043d\u0443\u0446\u044c \u0436\u044b\u0446\u0446\u0451. \u0422\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u045e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0440\u0443\u043a\u0443 \u0434\u0430 \u043f\u043b\u0443\u0433\u0430 \u0456 \u045e\u0437\u044f\u045e \u043a\u0440\u044b\u0436 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0434\u0430 \u043a\u0430\u043d\u0446\u0430. \u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430 \u0437\u0440\u043e\u0431\u0456\u0448 \u0431\u043e\u043b\u044c\u0448 \u043b\u0451\u0433\u043a\u0456\u043c \u043d\u0430\u0448 \u0446\u044f\u0436\u0430\u0440, \u0442\u0430\u043a\u043e\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u044c \u0437\u0433\u0430\u0434\u0430\u043d\u044b\u044f \u0442\u0432\u0430\u0435 \u0437\u0430\u0441\u043b\u0443\u0433\u0456. \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u044f\u043a\u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0446\u0430\u0432\u0430\u043d\u0430\u0433\u0430, \u0443\u0436\u043e \u043d\u0435 \u043a\u0430\u0436\u0443 &ndash; \u0431\u0440\u0430\u0442\u0430, \u0431\u0443\u0434\u0437\u0435 &laquo;\u0443\u0437\u0432\u044f\u043b\u0456\u0447\u0430\u043d\u044b \u044f\u043a \u0432\u044f\u043b\u0456\u043a\u0456 \u0433\u043e\u0440\u0430\u0434&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043f\u0430\u0441\u043b\u0430\u043b\u0456 \u0442\u0432\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0430\u0434\u0437\u0456\u043d \u0445\u043b\u0435\u0431 \u043d\u0430 \u0437\u043d\u0430\u043a \u0435\u0434\u043d\u0430\u0441\u0446\u0456. \u0421\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0443\u0435 \u0451\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0422\u0440\u043e\u0439\u0446\u044b. \u041f\u0430\u0436\u0430\u0434\u0430\u0439 \u044f\u0433\u043e \u043f\u0440\u044b\u043d\u044f\u0446\u044c, \u044f\u043a \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0421\u0456\u0440 31, 8. 11\u0430. \u043f\u0430\u0440. 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0431\u0430\u0433\u0430\u0447, \u044f\u043a\u0456 \u043d\u0435 \u043c\u0430\u0435 \u0432\u0456\u043d\u044b \u0456 \u044f\u043a\u0456 \u043d\u0435 \u0433\u043e\u043d\u0456\u0446\u0446\u0430 \u0437\u0430 \u0437\u043e\u043b\u0430\u0442\u0430\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0430\u043c\u0443 \u044f\u0433\u043e \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u041f\u0430\u043d\u0443. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u043e\u0433 \u0437\u0433\u0440\u0430\u0448\u044b\u0446\u044c, \u0430 \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u045e, \u043c\u043e\u0433 \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u043e, \u0430 \u043d\u0435 \u045e\u0447\u044b\u043d\u0456\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u044f\u0433\u043e \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u041f\u0430\u043d\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"677","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0422\u043e\u043c\u0430\u0441\u0430 \u041c\u043e\u0440\u0430 \u0434\u0430 \u0434\u0430\u0447\u043a\u0456 \u041c\u0430\u0440\u0433\u0430\u0440\u044b\u0442\u044b, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u044b \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(The English Works of Sir Thomas Mor, London, 1557, p. 1454)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0423\u0441\u044f \u043d\u0430\u0434\u0437\u0435\u044f \u043c\u0430\u044f \u0456 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u043d\u0435 \u043d\u0430 \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u044f \u041c\u0430\u0440\u0433\u0430\u0440\u044b\u0442\u0430, \u044f \u0446\u0430\u043b\u043a\u0430\u043c \u0443\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u044e \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u043c\u0430\u0439\u0433\u043e \u043c\u0456\u043d\u0443\u043b\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0442\u0430\u043c\u0443 \u045e \u043f\u043e\u045e\u043d\u0456 \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u045e \u043d\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u043c\u044f\u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0411\u043e\u0433. \u0410\u0434\u043d\u0430\u043a \u044f \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u044e \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u042f\u0433\u043e \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0443\u044e \u0434\u0430\u0431\u0440\u044b\u043d\u044e, \u0431\u043e \u042f\u0433\u043e \u043b\u0430\u0441\u043a\u0430 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u043b\u0430 \u043c\u044f\u043d\u0435 \u0430\u0436 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c. \u042f\u043d\u0430 \u0434\u0430\u043b\u0430 \u043c\u043d\u0435 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044c \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043b\u0435\u043f\u0448 \u0441\u0442\u0440\u0430\u0442\u0443 \u045e\u0441\u044f\u0433\u043e, \u0447\u044b\u043c \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u0446\u044c \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044e. \u042f\u043d\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0440\u0430\u0456\u043b\u0430 \u043a\u0430\u0440\u0430\u043b\u044e \u0431\u044b\u0446\u044c \u043b\u0430\u0433\u043e\u0434\u043d\u044b\u043c \u0434\u0430 \u043c\u044f\u043d\u0435, \u0448\u0442\u043e \u0430\u0436 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u045e \u043c\u044f\u043d\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u0430\u043a\u0440\u0430\u043c\u044f \u0441\u0432\u0430\u0431\u043e\u0434\u044b (\u0447\u044b\u043c \u0434\u0430\u0440\u044d\u0447\u044b \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u043a\u0430\u0440\u044b\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f \u043c\u0435\u0446\u044c, \u042f\u0433\u043e \u0412\u044f\u043b\u0456\u043a\u0430\u0441\u0446\u044c \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u043c\u043d\u0435 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430 \u0437\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0448\u0447\u043e\u0434\u0440\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b\u044f \u043c\u043d\u0435 \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u0456 \u043f\u0430\u0448\u0430\u043d\u0443). \u0422\u0430\u044f \u0441\u0430\u043c\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0430\u0431\u043e \u0441\u0442\u0440\u044b\u043c\u0430\u0435 \u043a\u0430\u0440\u0430\u043b\u044f, \u043a\u0430\u0431 \u0451\u043d \u043d\u0435 \u0440\u0430\u0431\u0456\u045e \u043c\u043d\u0435 \u0431\u043e\u043b\u044c\u0448 \u043d\u0456\u0447\u043e\u0433\u0430 \u0434\u0440\u044d\u043d\u043d\u0430\u0433\u0430, \u0430\u0431\u043e \u0431\u0443\u0434\u0437\u0435 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0434\u0430\u0434\u0430\u0432\u0430\u0446\u044c \u043c\u043d\u0435 \u0441\u0456\u043b\u044b, \u043a\u0430\u0431 \u044f \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u045e \u0443\u0441\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456, \u043c\u0443\u0436\u043d\u0430 \u0456 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0451 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435, \u0441\u043f\u0430\u043b\u0443\u0447\u0430\u043d\u0430\u0435 \u0437 \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u043a\u0440\u044b\u0432\u0430\u0432\u0430\u0439 \u041c\u0443\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 (\u044f\u043a\u0430\u044f \u045e \u043a\u043e\u0436\u043d\u044b\u043c \u0441\u044d\u043d\u0441\u0435 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u044f \u043c\u0430\u0433\u0443 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u0446\u044c), \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u043b\u0430\u0433\u043e\u0434\u043d\u044b\u043c \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430\u0435 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u045e \u0447\u044b\u0441\u0442\u0446\u044b, \u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u044b\u0446\u044c \u0437\u0430\u0441\u043b\u0443\u0433\u0443 \u043d\u0435\u0431\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0445\u0430\u0447\u0443 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430 \u045e \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0411\u043e\u0433\u0430, \u043c\u0430\u044f \u041c\u0430\u0440\u0433\u0430\u0440\u044b\u0442\u0430, \u0445\u043e\u0446\u044c \u0440\u0430\u0437\u0443\u043c\u0435\u044e \u0441\u0432\u0430\u044e \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c \u0456 \u043d\u044f\u0441\u0442\u0430\u043b\u0430\u0441\u0446\u044c. \u041a\u0430\u043b\u0456 \u0440\u0430\u043f\u0442\u0430\u043c \u0430\u0445\u043e\u043f\u0456\u0446\u044c \u043c\u044f\u043d\u0435 \u0442\u0430\u043a\u043e\u0435 \u0440\u0430\u0441\u0447\u0430\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0456 \u0442\u0440\u044b\u0432\u043e\u0433\u0430, \u0448\u0442\u043e \u0431\u0443\u0434\u0443 \u043d\u0435\u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u044f, \u0442\u0430\u0434\u044b \u0437\u0433\u0430\u0434\u0430\u044e \u0441\u0432. \u041f\u044f\u0442\u0440\u0430, \u044f\u043a\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443 \u0432\u0435\u0440\u044b \u0430\u0434 \u0430\u0434\u043d\u0430\u0433\u043e \u043c\u043e\u0446\u043d\u0430\u0433\u0430 \u043f\u0430\u0432\u0435\u0432\u0443 \u043f\u0430\u0447\u0430\u045e \u0442\u0430\u043d\u0443\u0446\u044c, \u0456 \u045e\u0447\u044b\u043d\u044e \u0442\u0430\u043a, \u044f\u043a \u0451\u043d. \u0411\u0443\u0434\u0443 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430: &laquo;\u041f\u0430\u043d\u0435, \u0440\u0430\u0442\u0443\u0439 \u043c\u044f\u043d\u0435&raquo;. \u0421\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0442\u0430\u0434\u044b, \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u044e\u0447\u044b \u0440\u0443\u043a\u0443, \u0401\u043d \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0435 \u043c\u044f\u043d\u0435 \u0456 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u043c\u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u043d\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c, \u043a\u0430\u0431 \u044f, \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0447\u044b \u0434\u0430\u043b\u0435\u0439 \u041f\u044f\u0442\u0440\u0430, \u0443\u043f\u0430\u045e, \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u045e \u0456 \u043a\u043b\u044f\u045e\u0441\u044f (\u043d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u0443 \u0441\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0430\u0434\u0434\u0430\u043b\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u044f\u043a \u043c\u0430\u0433\u0430 \u0434\u0430\u043b\u0435\u0439 \u0430\u0434 \u043c\u044f\u043d\u0435, \u0430 \u0442\u0430\u043a\u0456 \u045e\u0447\u044b\u043d\u0430\u043a \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u043c\u043d\u0435 \u043b\u0435\u043f\u0448 \u0448\u043a\u043e\u0434\u0443, \u0447\u044b\u043c \u0432\u044b\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435), \u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0437\u0432\u0435\u0440\u043d\u0435 \u0434\u0430 \u043c\u044f\u043d\u0435 \u043f\u043e\u0437\u0456\u0440\u043a, \u043f\u043e\u045e\u043d\u044b \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456, \u0456 \u043f\u0430\u0434\u044b\u043c\u0435 \u043c\u044f\u043d\u0435, \u043a\u0430\u0431 \u043d\u0430\u043d\u043e\u0432\u0430 \u044f \u0432\u044b\u0437\u043d\u0430\u045e \u0441\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456 \u0456 \u0441\u0443\u043f\u0430\u043a\u043e\u0456\u045e \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435. \u0421\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u0437\u043c\u0430\u0433\u0443 \u043c\u0443\u0436\u043d\u0430 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0456 \u0433\u0430\u043d\u044c\u0431\u0443 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0442\u0430\u043a\u043e\u0433\u0430 \u0433\u0440\u0430\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0440\u0430\u0446\u0435\u0439 \u043a\u0430\u0436\u0443\u0447\u044b, \u043c\u0430\u044f \u041c\u0430\u0440\u0433\u0430\u0440\u044b\u0442\u0430, \u044f \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u044b, \u0448\u0442\u043e \u0411\u043e\u0433 \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435 \u043c\u044f\u043d\u0435 \u0431\u0435\u0437 \u043c\u0430\u0451\u0439 \u0432\u0456\u043d\u044b. \u0422\u0430\u043c\u0443 \u0437 \u0443\u0441\u0451\u0439 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0456 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u043d\u0435\u043c \u0446\u0430\u043b\u043a\u0430\u043c \u0434\u0430\u0440\u0443\u0447\u0430\u044e \u0441\u044f\u0431\u0435 \u042f\u043c\u0443. \u0410 \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u043c\u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043c\u0430\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e, \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u045e\u0432\u0430 \u043c\u043d\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u044f \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u042f\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0410\u0434\u043d\u0430\u043a \u043c\u043e\u0446\u043d\u0430 \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f, \u0448\u0442\u043e \u0411\u043e\u0436\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u0435 \u043c\u0430\u044e \u0434\u0443\u0448\u0443 \u0456 \u045e\u0447\u044b\u043d\u0456\u0446\u044c, \u0448\u0442\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0431\u043e\u043b\u044c\u0448 \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0447\u044b\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u0435 \u0442\u0443\u0440\u0431\u0443\u0439\u0441\u044f, \u043c\u0430\u044f \u0434\u0430\u0447\u043a\u0430, \u0456 \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430 \u043f\u0440\u0430 \u043c\u044f\u043d\u0435 \u043d\u0435 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0441\u044f. \u0428\u0442\u043e \u0431 \u043d\u0456 \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0441\u0430 \u043c\u043d\u043e\u0439 \u0434\u0440\u044d\u043d\u043d\u0430\u0433\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u043d\u0430 \u0441\u0430\u043c\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u044f\u043d\u043e \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0443\u0447\u0430\u043d\u0456\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b\u044f \u043d\u0430 \u0437\u0434\u0437\u0435\u043a\u0456, \u0442\u0430\u043a \u043c\u0430\u043b\u0456\u043b\u0456\u0441\u044f: <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0439 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u043a\u0430\u0431 \u043c\u044b \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u043b\u0456 \u0422\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u043b\u044f\u043d\u044c \u043d\u0430 \u0422\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u0456 \u043d\u0430 \u0422\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0439 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u043a\u0430\u0431 \u043c\u044b \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u043b\u0456 \u0422\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"678","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 293, 1-3: PL 38, 1327-1328)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0413\u043e\u043b\u0430\u0441 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u043b\u0456\u0447\u0430 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u042f\u043d\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435 \u0430\u0441\u043e\u0431\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u0430\u043c. \u0406 \u043d\u0435 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u043c \u043c\u044b \u0434\u043d\u044f \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u043d\u0430\u045e \u043d\u0456\u043a\u043e\u0433\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u0445, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u042f\u043d\u0430 \u0456 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430. \u0413\u044d\u0442\u0430 \u043c\u0430\u0435 \u0441\u0432\u043e\u0439 \u0441\u044d\u043d\u0441. \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u045e\u0437\u043d\u0451\u0441\u043b\u0430\u0441\u0446\u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u044f\u0435 \u0446\u0430\u043b\u043a\u0430\u043c \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c, \u0443\u0441\u0451 \u0440\u043e\u045e\u043d\u0430 \u043f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u0456\u043c\u0441\u044f \u0434\u0430 \u044f\u0435 \u0431\u043e\u043b\u044c\u0448 \u043f\u0456\u043b\u044c\u043d\u0430 \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u043d\u044f\u043f\u043b\u043e\u0434\u043d\u0430\u0439, \u044f\u043a\u0430\u044f \u0431\u044b\u043b\u0430 \u045e\u0436\u043e \u045e \u0441\u0430\u0441\u0442\u0430\u0440\u044d\u043b\u044b\u043c \u0443\u0437\u0440\u043e\u0441\u0446\u0435, \u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434 \u043c\u0430\u043b\u0430\u0434\u043e\u0439 \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u044b. \u041f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u042f\u043d\u0430 \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u0435\u0446\u0446\u0430 \u0437 \u0431\u044f\u0437\u0432\u0435\u0440&rsquo;\u0435\u043c, \u0456 \u044f\u0433\u043e \u0431\u0430\u0446\u044c\u043a\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043d\u044f\u043c\u044b\u043c. \u0414\u0437\u0435\u0432\u0430 \u0436 \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0437 \u0432\u0435\u0440\u0430\u044e \u043f\u0440\u044b\u043c\u0430\u0435 \u042f\u0433\u043e \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0435. \u0412\u043e\u0441\u044c \u043c\u044b \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043b\u0456, \u043f\u0440\u0430 \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u0456 \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u044b\u0441\u0432\u044f\u0442\u043b\u044f\u0446\u044c. \u041c\u044b \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0435, \u0431\u043e \u043d\u0430\u043c \u0441\u0430\u043c\u0456\u043c \u043d\u0435 \u0445\u0430\u043f\u0430\u0435 \u0447\u0430\u0441\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u043c\u0435\u043d\u043d\u044f, \u043a\u0430\u0431 \u0446\u0430\u043b\u043a\u0430\u043c \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443. \u041b\u0435\u043f\u0448 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0434\u0430 \u0432\u0430\u0441 \u0431\u0435\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430; \u0442\u043e\u0439, \u0434\u0430 \u043a\u0430\u0433\u043e \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u0432\u0430\u0448\u044b\u044f \u0441\u0432\u044f\u0442\u044b\u044f \u0434\u0443\u043c\u043a\u0456; \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u0432\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u045e \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u0447\u044b\u0451\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439 \u0432\u044b \u0441\u0442\u0430\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d \u043d\u0456\u0431\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u044f\u0436\u043e\u0439 \u0430\u0431\u043e\u0434\u0432\u0443\u0445 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0430\u045e &ndash; \u0421\u0442\u0430\u0440\u043e\u0433\u0430 \u0456 \u041d\u043e\u0432\u0430\u0433\u0430. \u041f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u043d\u0435\u0439\u043a\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u043c\u044f\u0436\u043e\u0439, \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0441\u0430\u043c \u041f\u0430\u043d, \u043a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430: &laquo;\u0417\u0430\u043a\u043e\u043d \u0456 \u041f\u0440\u0430\u0440\u043e\u043a\u0456 \u0431\u044b\u043b\u0456 \u0434\u0430 \u042f\u043d\u0430&raquo; (\u041b\u043a 16, 16). \u042f\u043d \u0443\u044f\u045e\u043b\u044f\u0435 \u0441\u0430\u0431\u043e\u0439 \u0421\u0442\u0430\u0440\u044b \u0417\u0430\u043f\u0430\u0432\u0435\u0442 \u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u041d\u043e\u0432\u044b. \u0423\u0432\u0430\u0441\u0430\u0431\u043b\u044f\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u0442\u0430\u0440\u043e\u0435, \u0442\u0430\u043c\u0443 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u043b\u044e\u0434\u0437\u0435\u0439 \u0443 \u0441\u0442\u0430\u0440\u044b\u043c \u0443\u0437\u0440\u043e\u0441\u0446\u0435. \u0423\u0432\u0430\u0441\u0430\u0431\u043b\u044f\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u043e\u0432\u0430\u0435, \u0442\u0430\u043c\u0443 \u045e\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u0431\u044b\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u0443\u0436\u043e \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u043c\u0430\u0446\u0456. \u0411\u043e \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f, \u044f\u0448\u0447\u044d \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u0446\u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u043f\u0440\u044b\u0439\u0441\u0446\u044e \u0441\u0432\u044f\u0442\u043e\u0439 \u041c\u0430\u0440\u044b\u0456. \u0423\u0436\u043e \u0442\u0430\u0434\u044b \u0431\u044b\u045e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0434\u043b\u044f \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u043c\u0456\u0441\u0456\u0456 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a\u0430; \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f; \u043f\u0430\u043a\u0430\u0437\u0430\u043d\u044b \u044f\u043a \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0431\u0430\u0447\u044b\u045e \u044f\u0433\u043e. \u0413\u044d\u0442\u0430 \u0411\u043e\u0436\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0440\u043e\u0437\u0443\u043c\u0443. \u0423\u0440\u044d\u0448\u0446\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u042f\u043d, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0456\u043c\u044f, \u0434\u0430 \u0431\u0430\u0446\u044c\u043a\u0456 \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u043c\u043e\u0432\u0430. \u0413\u044d\u0442\u044b\u044f \u043f\u0430\u0434\u0437\u0435\u0456 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0445\u0430\u0440\u044b\u044f \u0437\u0430\u043c\u0430\u045e\u043a\u0430\u0435 \u0456 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043d\u044f\u043c\u044b\u043c \u0430\u0436 \u0434\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u042f\u043d\u0430, \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a\u0430 \u041f\u0430\u043d\u0430, \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0441\u043b\u044f \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0434\u0430 \u044f\u0433\u043e \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u043c\u043e\u0432\u0430. \u0428\u0442\u043e \u0436 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435 \u0417\u0430\u0445\u0430\u0440\u044b\u0456, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430\u045e, \u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u0434 \u043f\u0440\u044b\u0439\u0441\u0446\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u0431\u044b\u043b\u0456 \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0437\u0430\u043a\u0440\u044b\u0442\u044b\u044f \u0456 \u0437\u0430\u043c\u043a\u043d\u0451\u043d\u044b\u044f? \u042f\u043d\u044b \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u044e\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u043f\u0440\u044b\u0439\u0441\u0446\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430; \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u044f\u045e\u043d\u044b\u043c\u0456, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u044b. \u0412\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u043c\u043e\u0432\u044b \u0434\u0430 \u0417\u0430\u0445\u0430\u0440\u044b\u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u042f\u043d\u0430 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u043d\u043d\u044e \u0437\u0430\u0441\u043b\u043e\u043d\u044b \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u0441\u043c\u0435\u0440\u0446\u0456 \u0415\u0437\u0443\u0441\u0430. \u041a\u0430\u043b\u0456 \u0431 \u042f\u043d \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u0417\u0430\u0445\u0430\u0440\u044b\u044f \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u0431 \u043d\u044f\u043c\u044b\u043c. \u0412\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u043c\u043e\u0432\u0430, \u0431\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441. \u041a\u0430\u043b\u0456 \u042f\u043d \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u043f\u044b\u0442\u0430\u043b\u0456\u0441\u044f \u045e \u044f\u0433\u043e: &laquo;\u0425\u0442\u043e \u0442\u044b?&raquo; (\u042f\u043d 1, 19), \u0430 \u0451\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u0433\u043e\u043b\u0430\u0441 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u043b\u0456\u0447\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456&raquo; (\u042f\u043d 1, 23). \u042f\u043d \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u0430 \u041f\u0430\u043d &ndash; \u0421\u043b\u043e\u0432\u0430\u043c: &laquo;\u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430&raquo; (\u042f\u043d 1, 1). \u042f\u043d \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u043d\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441; \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0421\u043b\u043e\u0432\u0430\u043c \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0456 \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 1, 76-77<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u0442\u044b, \u0434\u0437\u0456\u0446\u044f\u0442\u043a\u0430, \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0431\u0443\u0434\u0437\u0435\u0448 \u043d\u0430\u0437\u0432\u0430\u043d\u0430,<span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u0448\u043b\u044f\u0445\u0456 \u042f\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u0431 \u0434\u0430\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u0443 \u042f\u0433\u043e\u043d\u0430\u043c\u0443 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0440\u0430\u0437 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u044f\u0433\u043e \u0433\u0440\u0430\u0445\u043e\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u043f\u043e\u0439\u0434\u0437\u0435\u0448 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u0430\u043d\u0430 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u0448\u043b\u044f\u0445\u0456 \u042f\u043c\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"679","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 1: PG 77, 14-18. 27-30)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0410\u0431\u0430\u0440\u043e\u043d\u0446\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u043c\u0430\u0446\u044f\u0440\u044b\u043d\u0441\u0442\u0432\u0430 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0432\u0435\u043b\u044c\u043c\u0456 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u044e\u0441\u044f \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0456\u0441\u043d\u0443\u044e\u0446\u044c \u0442\u0430\u043a\u0456\u044f \u043b\u044e\u0434\u0437\u0456, \u044f\u043a\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u044e\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0443\u044e \u0414\u0437\u0435\u0432\u0443 \u043c\u043e\u0436\u043d\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u0411\u043e\u0436\u0430\u0439 \u041c\u0430\u0446\u0456. \u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u043d\u0430\u0448 \u041f\u0430\u043d, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0430\u043c, \u0447\u0430\u043c\u0443 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u044f \u0414\u0437\u0435\u0432\u0430, \u044f\u043a\u0430\u044f \u042f\u0433\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430, \u043d\u0435 \u043c\u043e\u0436\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u0446\u0430 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0430\u0439? \u0413\u044d\u0442\u0443\u044e \u043f\u0440\u0430\u045e\u0434\u0443 \u043f\u0435\u0440\u0430\u0434\u0430\u044e\u0446\u044c \u043d\u0430\u043c \u0432\u0443\u0447\u043d\u0456 \u041f\u0430\u043d\u0430, \u0445\u043e\u0446\u044c \u043d\u0435 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0442\u0430\u043a\u0456\u043c \u0430\u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435\u043c. \u0413\u044d\u0442\u0430\u043c\u0443 \u0432\u0443\u0447\u044b\u043b\u0456 \u043d\u0430\u0441 \u0441\u0432\u044f\u0442\u044b\u044f \u0410\u0439\u0446\u044b. \u0412\u043e\u0441\u044c \u0436\u0430 \u0441\u043b\u0430\u045e\u043d\u0430\u0439 \u043f\u0430\u043c\u044f\u0446\u0456 \u0430\u0439\u0446\u0435\u0446 \u043d\u0430\u0448 \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u0439 \u0443 \u0442\u0440\u044d\u0446\u044f\u0439 \u043a\u043d\u0456\u0437\u0435 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0446\u044b \u0430\u0431 \u0441\u0432\u044f\u0442\u043e\u0439 \u0456 \u0430\u0434\u0437\u0456\u043d\u0430\u0441\u0443\u0442\u043d\u0430\u0439 \u0422\u0440\u043e\u0439\u0446\u044b \u0448\u043c\u0430\u0442\u0440\u0430\u0437\u043e\u0432\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0443\u044e \u0414\u0437\u0435\u0432\u0443 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0430\u0447\u0443 \u043f\u0440\u044b \u0433\u044d\u0442\u0430\u0439 \u043d\u0430\u0433\u043e\u0434\u0437\u0435 \u043f\u0440\u0430\u0446\u044b\u0442\u0430\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u0441\u043b\u043e\u0432\u044b. \u0412\u043e\u0441\u044c \u044f\u043d\u044b: &laquo;\u0410\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0439 \u0430\u0434\u0437\u043d\u0430\u043a\u0430\u0439 \u041f\u0456\u0441\u0430\u043d\u043d\u044f &ndash; \u044f\u043a \u043c\u044b \u045e\u0436\u043e \u0448\u043c\u0430\u0442\u0440\u0430\u0437\u043e\u0432\u0430 \u0437\u0433\u0430\u0434\u0432\u0430\u043b\u0456 &ndash; \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u0430 \u0417\u0431\u0430\u045e\u0446\u0443 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u043d\u0430 \u0434\u0432\u0430 \u0441\u043f\u043e\u0441\u0430\u0431\u044b: \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u0431\u043e\u043a\u0443, \u0448\u0442\u043e \u0401\u043d &ndash; \u0432\u0435\u0447\u043d\u044b \u0411\u043e\u0433, \u0421\u044b\u043d, \u0421\u043b\u043e\u0432\u0430, \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0410\u0439\u0446\u0430; \u0437 \u0434\u0440\u0443\u0433\u043e\u0433\u0430, \u0448\u0442\u043e \u045e \u0433\u044d\u0442\u044b\u044f \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0447\u0430\u0441\u044b \u0434\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0401\u043d \u043f\u0440\u044b\u043d\u044f\u045e \u0446\u0435\u043b\u0430 \u0437 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044b \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456 \u0456 \u0441\u0442\u0430\u045e\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0440\u044b\u0445\u0443 \u0434\u0430\u043b\u0435\u0439 \u0434\u0430\u0434\u0430\u0435: &laquo;\u0411\u044b\u043b\u043e \u0448\u043c\u0430\u0442 \u0441\u0432\u044f\u0442\u044b\u0445, \u0432\u043e\u043b\u044c\u043d\u044b\u0445 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443: \u0415\u0440\u0430\u043c\u0456\u044f \u0431\u044b\u045e \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u0446\u0456, \u0430 \u042f\u043d \u044f\u0448\u0447\u044d \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435\u043c \u0443\u0437\u0432\u0430\u0440\u0443\u0445\u043d\u0443\u045e\u0441\u044f \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u043d\u0430 \u0433\u043e\u043b\u0430\u0441 \u041c\u0430\u0440\u044b\u0456, \u041c\u0430\u0446\u0456 \u0411\u043e\u0433\u0430&raquo;. \u0413\u044d\u0442\u044b \u0448\u043b\u044f\u0445\u0435\u0442\u043d\u044b \u043c\u0443\u0436 \u0432\u0430 \u045e\u0441\u0456\u043c \u0432\u0430\u0440\u0442\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0434\u0430\u0432\u0435\u0440\u0443 \u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456, \u0431\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0456\u0447\u043e\u0433\u0430, \u0448\u0442\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u0431 \u0437\u0433\u043e\u0434\u043d\u044b\u043c \u0441\u0430 \u0421\u0432\u044f\u0442\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u0430\u0435 \u0411\u043e\u0433\u0430\u043c, \u0432\u0443\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0437&rsquo;\u044f\u0434\u043d\u0430\u043b\u0430\u0441\u044f \u0437 \u0446\u0435\u043b\u0430\u043c, \u0430\u0434\u043e\u0440\u0430\u043d\u044b\u043c \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0439 \u0434\u0443\u0448\u043e\u0439. \u0422\u0430\u043a \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430 \u0441\u0442\u0430\u043b\u0430 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430\u043c \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u043f\u0440\u044b\u043d\u044f\u043b\u043e \u0446\u0435\u043b\u0430 \u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d\u044b; \u0442\u0430\u043c\u0443 \u0441\u0442\u0430\u043b\u0430 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0446\u0435\u043b\u0430 \u0456 \u043a\u0440\u044b\u0432\u0456, \u0448\u0442\u043e \u0430\u0436 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433\u0430\u043c, \u0430\u043b\u0435 \u045e \u0441\u0456\u043b\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u044f, \u0451\u0441\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u043d\u0430\u0441 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u042d\u043c\u043c\u0430\u043d\u0443\u044d\u043b\u044c \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u0434\u0437\u0432\u0435 \u043d\u0430\u0442\u0443\u0440\u044b: \u0411\u043e\u0441\u043a\u0443\u044e \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e. \u0410\u0434\u0437\u0456\u043d \u0451\u0441\u0446\u044c \u041f\u0430\u043d, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430\u0434\u0437\u0456\u043d, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b, \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b \u0421\u044b\u043d \u0411\u043e\u0433\u0430, \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0411\u043e\u0433 \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u041d\u0435 \u0430\u0431\u0430\u0433\u0430\u045e\u043b\u0451\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u0441\u0442\u0430\u045e \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0430\u043b\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u044f\u043a \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b \u0443 \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u041a\u0430\u043b\u0456 \u043d\u0430\u0434\u044b\u0448\u043b\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0447\u0430\u0441\u0443, \u043f\u0430\u0441\u043b\u0430\u045e \u0411\u043e\u0433 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0430\u0434 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0417\u0430\u043a\u043e\u043d\u0443, \u043a\u0430\u0431 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u045e \u0417\u0430\u043a\u043e\u043d\u0443, \u043a\u0430\u0431 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435&raquo; (\u0413\u0430\u043b 4, 4-5).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u0456 \u045e\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430 \u044f\u0433\u043e \u0432\u0443\u0447\u044d\u043d\u043d\u0435\u043c. <span style=\"color: #ff0000;\">*<\/span> \u041d\u044f\u0445\u0430\u0439 \u0451\u043d \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u043d\u0430\u0448\u044b\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u0430\u0440 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0434\u043d\u0451\u043c \u0456 \u043d\u043e\u0447\u0447\u0443 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0430\u0434 \u042f\u0433\u043e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0451\u043d \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u043d\u0430\u0448\u044b\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"680","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u044f\u045e&raquo; \u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 4, 20, 5-7: SCh 100, 640-642. 644-648)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0425\u0432\u0430\u043b\u0430 \u0411\u043e\u0433\u0430 &ndash; \u0436\u044b\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0430 \u0436\u044b\u0446\u0446\u0451 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0431\u0430\u0447\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u043b\u0456\u0447 \u0411\u043e\u0433\u0430 \u0430\u0436\u044b\u045e\u043b\u044f\u0435. \u0422\u043e\u0439, \u0445\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u041d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b, \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u044b \u0456 \u043d\u044f\u0431\u0430\u0447\u043d\u044b \u0411\u043e\u0433 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u043b\u044e\u0434\u0437\u044f\u043c \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0441\u044f\u0431\u0435, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0456 \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u043d\u0443\u0446\u044c \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u042f\u0433\u043e. \u041d\u044f\u043c\u0430 \u0436\u044b\u0446\u0446\u044f \u0431\u0435\u0437 \u0442\u0430\u0433\u043e \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430. \u0411\u043e \u0436\u044b\u0446\u0446\u0451 \u043f\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u0432\u0430 \u045e\u0434\u0437\u0435\u043b\u0435 \u045e \u0411\u043e\u0433\u0443. \u0413\u044d\u0442\u044b \u045e\u0434\u0437\u0435\u043b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0431\u0430\u0447\u0430\u043d\u043d\u0435\u043c \u0411\u043e\u0433\u0430 \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u042f\u0433\u043e \u0434\u0430\u0431\u0440\u044b\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043b\u044e\u0434\u0437\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u0431\u0430\u0447\u0430\u043d\u043d\u044e \u044f\u043d\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c\u0456 \u0456 \u045e\u0437\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430. \u042f\u043a \u0443\u0436\u043e \u043a\u0430\u0437\u0430\u045e \u0440\u0430\u043d\u0435\u0439, \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456, \u0448\u0442\u043e \u0411\u043e\u0433\u0430 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043c\u0430\u0435 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0414\u0443\u0445\u0430 \u0456 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u0447\u0430\u043a\u0430\u0435 \u042f\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u044f. \u0423 \u043a\u043d\u0456\u0437\u0435 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u041c\u0430\u0439\u0441\u0435\u0439 \u043a\u0430\u0436\u0430: &laquo;\u0423 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043c\u044b \u045e\u0431\u0430\u0447\u044b\u043b\u0456, \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430 \u0451\u043d \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u0436\u044b\u0432\u044b\u043c&raquo; (\u043f\u0430\u0440. \u0414\u0440\u0433 5, 24).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u044c \u0443\u0441\u0451 \u0432\u0430 \u045e\u0441\u0456\u043c, \u0443 \u0441\u0432\u0430\u0451\u0439 \u043c\u043e\u0446\u044b \u0456 \u0432\u0435\u043b\u0456\u0447\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u044f\u0431\u0430\u0447\u043d\u044b\u043c \u0456 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b\u043c \u0434\u043b\u044f \u0441\u0432\u0430\u0456\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e. \u0410\u043b\u0435 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435\u0432\u044f\u0434\u043e\u043c\u044b\u043c. \u0411\u043e \u045e\u0441\u0435 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u043f\u0440\u0430\u0437 \u0421\u043b\u043e\u0432\u0430, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433 \u0410\u0439\u0446\u0435\u0446, \u044f\u043a\u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u045e\u0441\u0451 \u0456 \u045e\u0441\u044f\u043c\u0443 \u0434\u0430\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u0435, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456: &laquo;\u0411\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e. \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0410\u0439\u0446\u0430, \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u045e&raquo; (\u042f\u043d 1, 18).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0437 \u0441\u0430\u043c\u0430\u0433\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0421\u044b\u043d \u0430\u0431&rsquo;\u044f\u045e\u043b\u044f\u0435 \u0410\u0439\u0446\u0430, \u0431\u043e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0451\u0441\u0446\u044c \u0437 \u0410\u0439\u0446\u043e\u043c. \u0413\u044d\u0442\u0430 \u0401\u043d \u0434\u0430\u045e \u043b\u044e\u0434\u0437\u044f\u043c \u0443 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441 \u0456 \u0434\u043b\u044f \u0456\u0445 \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u0446\u0456 \u0442\u043e \u043f\u0440\u0430\u0440\u043e\u0446\u043a\u0456\u044f \u0432\u0456\u0437\u0456\u0456, \u0446\u0456 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0430\u0441\u0446\u044c \u0445\u0430\u0440\u044b\u0437\u043c\u0430\u045e, \u0441\u0432\u0430\u0435 \u043f\u0430\u0441\u0430\u0434\u044b, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0410\u0439\u0446\u0430, \u0443\u0441\u0451 \u045e \u0437\u0433\u043e\u0434\u043d\u0430\u0439 \u0433\u0430\u0440\u043c\u043e\u043d\u0456\u0456 \u0456 \u043b\u0430\u0434\u0437\u0435. \u0411\u043e \u0434\u0437\u0435 \u043b\u0430\u0434, \u0442\u0430\u043c \u0456 \u0433\u0430\u0440\u043c\u043e\u043d\u0456\u044f; \u0430 \u0434\u0437\u0435 \u0433\u0430\u0440\u043c\u043e\u043d\u0456\u044f, \u0442\u0430\u043c \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0434\u043b\u044f \u045e\u0441\u044f\u0433\u043e \u0447\u0430\u0441; \u0430 \u0434\u0437\u0435 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441, \u0442\u0430\u043c \u043a\u0430\u0440\u044b\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u043c \u043b\u0430\u0441\u043a \u0410\u0439\u0446\u0430 \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0431\u0440\u0430 \u043b\u044e\u0434\u0437\u0435\u0439. \u0414\u043b\u044f \u0456\u0445 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043f\u0440\u0430\u045e. \u042f\u043d\u043e \u043f\u0430\u043a\u0430\u0437\u0430\u043b\u0430 \u0411\u043e\u0433\u0430 \u043b\u044e\u0434\u0437\u044f\u043c, \u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u043b\u0430 \u0411\u043e\u0433\u0443. \u0417\u0430\u0445\u0430\u0432\u0430\u043b\u0430 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0441\u0446\u044c \u0410\u0439\u0446\u0430, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u0431\u044b\u045e \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u044b \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u043c\u0435\u045e \u043c\u044d\u0442\u0443 \u0441\u0432\u0430\u0456\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e. \u041f\u0430\u043a\u0430\u0437\u0430\u043b\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u0441\u043f\u043e\u0441\u0430\u0431\u0430\u043c\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u044f\u043a \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u0411\u043e\u0433\u0430 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u045e \u0443\u0432\u043e\u0433\u0443\u043b\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u0446\u044c. \u0411\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0436\u044b\u0432\u0435 \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0436\u0430\u0439 \u0445\u0432\u0430\u043b\u044b, \u0430 \u0436\u044b\u0446\u0446\u0451 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0431\u0430\u0447\u0430\u043d\u043d\u0435\u043c \u0411\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u0436 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u045e \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0434\u0430\u043b\u043e \u0436\u044b\u0446\u0446\u0451 \u045e\u0441\u0456\u043c \u0456\u0441\u0442\u043e\u0442\u0430\u043c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0431\u043e\u043b\u044c\u0448 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u045e \u0421\u043b\u043e\u0432\u0435 \u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0442\u044b\u043c, \u0445\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0430\u043b 2, 6; \u041f\u0441 89 (88), 22<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0417\u0430\u043a\u043e\u043d\u0443 \u0431\u044b\u043b\u0430 \u043d\u0430 \u044f\u0433\u043e \u0432\u0443\u0441\u043d\u0430\u0445, \u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u0441\u043b\u043e\u045e \u043d\u0435 \u0432\u044b\u043c\u0430\u0432\u0456\u045e \u044f\u0433\u043e \u044f\u0437\u044b\u043a. <span style=\"color: #ff0000;\">*<\/span> \u0423 \u0441\u043f\u0430\u043a\u043e\u0456 \u0456 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0451\u043d \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0420\u0443\u043a\u0430 \u043c\u043e\u0446\u044b \u041c\u0430\u0451\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u0437 \u0456\u043c, \u0456 \u043f\u043b\u044f\u0447\u043e \u041c\u0430\u0451 \u044f\u0433\u043e \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0441\u043f\u0430\u043a\u043e\u0456 \u0456 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0451\u043d \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<\/p>\r\n"}, {"GCH_CH_2_ID":"681","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 295, 1-2. 4. 7-8: PL 38, 1348-1352)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0413\u044d\u0442\u044b\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456 \u0431\u0430\u0447\u044b\u043b\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u044e\u0446\u044c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f\u0448\u043d\u0456 \u0434\u0437\u0435\u043d\u044c \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0441\u0432\u044f\u0442\u044b\u0445 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u041f\u044f\u0442\u0440\u0430 \u0456 \u041f\u0430\u045e\u043b\u0430. \u041c\u044b \u043d\u0435 \u043a\u0430\u0436\u0430\u043c \u043f\u0440\u0430 \u043c\u0430\u043b\u0430 \u0432\u044f\u0434\u043e\u043c\u044b\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e: &laquo;\u041f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0440\u0430\u0437\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u0456\u0445 \u0441\u043b\u043e\u0432\u044b&raquo; (\u043f\u0430\u0440. \u041f\u0441 19 [18], 5). \u0413\u044d\u0442\u044b\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456 \u043d\u0430 \u045e\u043b\u0430\u0441\u043d\u044b\u044f \u0432\u043e\u0447\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043b\u0456. \u0416\u044b\u043b\u0456 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u043f\u0440\u0430\u045e\u0434\u0443 \u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b \u0437\u0430 \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432. \u041f\u0451\u0442\u0440, \u043f\u0435\u0440\u0448\u044b \u0441\u044f\u0440\u043e\u0434 \u0410\u043f\u043e\u0441\u0442\u043b\u0430\u045e, \u0442\u043e\u0439, \u044f\u043a\u0456 \u0448\u0447\u044b\u0440\u0430 \u043b\u044e\u0431\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u043c\u0435\u045e \u0448\u0447\u0430\u0441\u0446\u0435 \u043f\u0430\u0447\u0443\u0446\u044c \u0441\u043b\u043e\u0432\u044b: &laquo;I \u042f \u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u0442\u044b &ndash; \u041f\u0451\u0442\u0440&raquo; (\u041c\u0446 16, 18). \u0410 \u0440\u0430\u043d\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u0451\u043d: &laquo;\u0422\u044b &ndash; \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0421\u044b\u043d \u0411\u043e\u0433\u0430 \u0416\u044b\u0432\u043e\u0433\u0430&raquo; (\u041c\u0446 16, 16). \u0410 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u044b &ndash; \u041f\u0451\u0442\u0440, \u0441\u043a\u0430\u043b\u0430, \u0456 \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0441\u043a\u0430\u043b\u0435 \u042f \u043f\u0430\u0431\u0443\u0434\u0443\u044e \u041a\u0430\u0441\u0446\u0451\u043b \u041c\u043e\u0439&raquo; (\u041c\u0446 16, 18). \u041d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0441\u043a\u0430\u043b\u0435 \u043f\u0430\u0431\u0443\u0434\u0443\u0435 \u0432\u0435\u0440\u0443, \u044f\u043a\u0443\u044e \u0442\u044b \u0432\u044b\u0437\u043d\u0430\u045e. \u041d\u0430 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0456: &laquo;\u0422\u044b &ndash; \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0421\u044b\u043d \u0411\u043e\u0433\u0430 \u0416\u044b\u0432\u043e\u0433\u0430&raquo;, \u044f\u043a\u043e\u0435 \u0441\u043a\u0430\u0437\u0430\u045e, \u043f\u0430\u0431\u0443\u0434\u0443\u044e \u041a\u0430\u0441\u0446\u0451\u043b \u041c\u043e\u0439. \u0411\u043e \u0442\u044b &ndash; \u0441\u043a\u0430\u043b\u0430. \u0406\u043c\u044f \u041f\u0451\u0442\u0440 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0441\u043b\u043e\u0432\u0430 &laquo;\u0441\u043a\u0430\u043b\u0430&raquo;, \u043d\u0435 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442. \u042f\u043a \u0456\u043c\u044f \u041f\u0451\u0442\u0440 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0441\u043b\u043e\u0432\u0430 &laquo;\u0441\u043a\u0430\u043b\u0430&raquo;, \u0442\u0430\u043a \u0430\u0434 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u043d\u0430\u0437\u0432\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0415\u0437\u0443\u0441 &ndash; \u044f\u043a \u0432\u0435\u0434\u0430\u0435\u0446\u0435 &ndash; \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u043c\u0443\u043a\u0430\u044e \u0432\u044b\u0431\u0440\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u045e \u0456 \u043d\u0430\u0437\u0432\u0430\u045e \u0456\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456. \u0421\u044f\u0440\u043e\u0434 \u0456\u0445 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043d\u0430\u043c\u0443 \u041f\u044f\u0442\u0440\u0443 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043d\u0435 \u0430\u0434\u043d\u043e\u0439\u0447\u044b \u045e\u0432\u0430\u0441\u0430\u0431\u043b\u044f\u0446\u044c \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u0442\u0430\u043c\u0443 \u0456 \u043f\u0430\u0447\u0443\u045e \u0451\u043d \u0441\u043b\u043e\u0432\u044b: &laquo;\u042f \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u043a\u043b\u044e\u0447\u044b \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430&raquo; (\u041c\u0446 16, 19). \u041a\u043b\u044e\u0447\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043d\u0435 \u0430\u0434\u0437\u0456\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0430\u043b\u0435 \u0430\u0434\u0437\u0456\u043d \u0456 \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u044b \u041a\u0430\u0441\u0446\u0451\u043b. \u0412\u0435\u043b\u0456\u0447 \u041f\u044f\u0442\u0440\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u044f\u043c\u0443 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u042f \u0434\u0430\u043c \u0442\u0430\u0431\u0435&raquo;, \u0451\u043d \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u045e \u0430\u0434 \u0456\u043c\u044f \u0430\u0434\u043d\u0430\u0433\u043e \u0456 \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u0430\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0422\u0430\u043c\u0443 \u0432\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043a\u043b\u044e\u0447\u044b \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u045e \u0456\u043d\u0448\u044b\u043c\u0456 \u043c\u0435\u0441\u0446\u044b \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0443\u0441\u0456\u043c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c: &laquo;\u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u041a\u0430\u043c\u0443 \u0430\u0434\u043f\u0443\u0441\u0446\u0456\u0446\u0435 \u0433\u0440\u0430\u0445\u0456, \u0442\u0430\u043c\u0443 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u043f\u0443\u0448\u0447\u0430\u043d\u044b\u044f; \u043d\u0430 \u043a\u0456\u043c \u043f\u0430\u043a\u0456\u043d\u0435\u0446\u0435, \u043d\u0430 \u0442\u044b\u043c \u0437\u0430\u0441\u0442\u0430\u043d\u0443\u0446\u0446\u0430&raquo; (\u042f\u043d 20, 22-23).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043f\u0430\u0441\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u041f\u0430\u043d \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u041f\u044f\u0442\u0440\u0443 \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0441\u0432\u0430\u0435 \u0430\u0432\u0435\u0447\u043a\u0456. \u0421\u044f\u0440\u043e\u0434 \u0432\u0443\u0447\u043d\u044f\u045e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0451\u043d \u0430\u0434\u0437\u0456\u043d \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u045e \u043d\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a \u041f\u0430\u043d\u0430, \u0431\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043a\u0430\u0436\u0430 \u041f\u044f\u0442\u0440\u0443, \u0431\u043e \u041f\u0451\u0442\u0440 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0448\u044b\u043c \u0441\u044f\u0440\u043e\u0434 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0441\u043c\u0443\u0442\u043a\u0443\u0439, \u0410\u043f\u043e\u0441\u0442\u0430\u043b! \u0410\u0434\u043a\u0430\u0436\u044b \u041f\u0430\u043d\u0443 \u0440\u0430\u0437, \u0434\u0440\u0443\u0433\u0456 \u0456 \u0442\u0440\u044d\u0446\u0456. \u041d\u044f\u0445\u0430\u0439 \u0442\u0440\u043e\u0439\u0447\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u043b\u044e\u0431\u043e\u0432\u0456, \u0431\u043e \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430\u044f \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u0430\u0441\u0446\u044c \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043d\u0430\u044f \u0442\u0440\u044b \u0440\u0430\u0437\u044b \u0441\u0442\u0440\u0430\u0445\u0430\u043c. \u0422\u0440\u044b \u0440\u0430\u0437\u044b \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0440\u0430\u0437\u0432\u044f\u0437\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u0440\u044b \u0440\u0430\u0437\u044b \u0437\u0430\u0432\u044f\u0437\u0430\u045e. \u0420\u0430\u0437\u0432\u044f\u0436\u044b \u043b\u044e\u0431\u043e\u045e\u044e, \u0448\u0442\u043e \u0437\u0430\u0432\u044f\u0437\u0430\u045e \u0441\u0442\u0440\u0430\u0445\u0430\u043c. \u0410\u0434\u043d\u0430\u043a \u041f\u0430\u043d \u0442\u0440\u043e\u0439\u0447\u044b \u0434\u0430\u0440\u0443\u0447\u0430\u0435 \u0441\u0432\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u041f\u044f\u0442\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0430\u0434\u0437\u0456\u043d \u0456 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0434\u0437\u0435\u043d\u044c \u043c\u044b \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435\u043c \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0434\u0432\u0443\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e. \u042f\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0442\u0432\u0430\u0440\u0430\u043b\u0456 \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430. \u041f\u0451\u0442\u0440 \u0432\u044b\u0439\u0448\u0430\u045e \u043f\u0435\u0440\u0448\u044b\u043c. \u0417\u0430 \u0456\u043c \u043f\u0430\u0439\u0448\u043e\u045e \u041f\u0430\u0432\u0435\u043b. \u0410\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u043c \u0441\u0451\u043d\u043d\u044f \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u0443\u044e \u0456\u0445 \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e. \u0411\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0456\u0445 \u0432\u0435\u0440\u0443, \u0436\u044b\u0446\u0446\u0451, \u043f\u0440\u0430\u0446\u0443, \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435, \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0456 \u043d\u0430\u0432\u0443\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 1, 76-77<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0432\u044f\u0442\u044b \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b, \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a \u043d\u0430\u0440\u043e\u0434\u0430\u045e,&nbsp;<span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u0431\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u043f\u0430\u0448\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u0430\u0437 \u0446\u044f\u0431\u0435 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043b\u0430\u0441\u043a\u0443 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u0431\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u043f\u0430\u0448\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"682","GCH_CH_2_Text":"\r\n<p><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041b\u0456\u0441\u0442 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&raquo; \u0441\u0432. \u041a\u043b\u0456\u043c\u044d\u043d\u0442\u0430 \u0406, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 5, 1 &ndash; 7, 4: Funk 1, 67-71)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u044b\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0448\u043c\u0430\u0442 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u0456, \u0441\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u0456\u043d\u044c\u043c\u0430 \u0434\u0430\u045e\u043d\u0435\u0439\u0448\u044b\u044f \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u044b \u0456 \u043f\u044f\u0440\u043e\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u0431\u043e\u043b\u044c\u0448 \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u0445 \u043d\u0430\u043c \u0433\u0435\u0440\u043e\u044f\u045e. \u041f\u0440\u044b\u0433\u0430\u0434\u0430\u0439\u043c\u0430 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u044b \u045e\u0436\u043e \u0437 \u043d\u0430\u0448\u044b\u0445 \u0447\u0430\u0441\u043e\u045e. \u0417 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0437\u043b\u043e\u0441\u0446\u0456 \u0456 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u044b\u045e \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0456 \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u043a\u0430\u043b\u043e\u043d\u0430\u0439 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0446\u044f\u0440\u043f\u0435\u043b\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434 \u0456 \u0441\u0443\u0441\u0442\u0440\u044d\u043b\u0456 \u0441\u043c\u0435\u0440\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u043c \u043d\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e. \u041f\u0451\u0442\u0440 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0437\u043b\u043e\u0439 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u0456 \u0437\u043d\u0451\u0441 \u043d\u0435 \u0430\u0434\u043d\u043e, \u043d\u0435 \u0434\u0432\u0430, \u0430\u043b\u0435 \u0448\u043c\u0430\u0442 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e, \u0430 \u043f\u0440\u0430\u0437 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u043a\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0437\u0430\u0441\u043b\u0443\u0436\u0430\u043d\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 \u0445\u0432\u0430\u043b\u044b. \u041f\u0430\u0432\u0435\u043b, \u0441\u043c\u0443\u0442\u043a\u0443\u044e\u0447\u044b \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0437\u0430\u045e\u0437\u044f\u0442\u0430\u0441\u0446\u0456 \u0456 \u0437\u0432\u0430\u0434\u044b, \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0437\u0430 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c. \u0421\u0435\u043c \u0440\u0430\u0437\u043e\u045e \u0431\u044b\u045e \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u044b \u045e \u0442\u0443\u0440\u043c\u0443, \u044f\u0433\u043e \u0432\u044b\u0433\u0430\u043d\u044f\u043b\u0456, \u043a\u0430\u043c\u0435\u043d\u0430\u0432\u0430\u043b\u0456, \u0430\u043b\u0435 \u044f\u043a \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043d\u0430 \u0423\u0441\u0445\u043e\u0434\u0437\u0435 \u0456 \u0417\u0430\u0445\u0430\u0434\u0437\u0435 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u0432\u0435\u0440\u0443 \u0437\u0434\u0430\u0431\u044b\u045e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0441\u043b\u0430\u0432\u0443. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u0443\u0436\u043e \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0430\u0431 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0434\u0430\u0439\u0448\u043e\u045e \u0430\u0436 \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u0417\u0430\u0445\u0430\u0434\u0443, \u0434\u0430\u045e \u0441\u0432\u0430\u0451 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043c\u0456. \u0422\u0430\u043a \u0430\u0434\u044b\u0448\u043e\u045e \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b\u0445, \u0456 \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430 \u0433\u044d\u0442\u044b\u0445 \u043c\u0443\u0436\u043e\u045e, \u044f\u043a\u0456\u044f \u0432\u044f\u043b\u0456 \u0441\u0432\u044f\u0442\u043e\u0435 \u0436\u044b\u0446\u0446\u0451, \u0434\u0430\u043b\u0443\u0447\u044b\u043b\u0430\u0441\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445, \u044f\u043a\u0456\u044f \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0432\u044f\u043b\u0456\u043a\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434 \u0456 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0437\u0434\u0437\u0435\u043a\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u0456, \u0441\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c. \u041f\u0440\u0430\u0437 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u044c \u0436\u0430\u043d\u0447\u044b\u043d\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0441\u0430\u043c\u0430\u0435 \u0436\u043e\u0440\u0441\u0442\u043a\u0430\u0435 \u0433\u0430\u043d\u0435\u043d\u043d\u0435. \u0421\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0441\u0443\u0440\u043e\u0432\u044b\u044f \u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u044f \u0437\u0434\u0437\u0435\u043a\u0456, \u0430\u043b\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u043d\u0430 \u043f\u0440\u0430\u0439\u0448\u043b\u0456 \u0448\u043b\u044f\u0445 \u0432\u0435\u0440\u044b, \u0456 \u0445\u043e\u0446\u044c \u043c\u0435\u043b\u0456 \u0441\u043b\u0430\u0431\u043e\u0435 \u0446\u0435\u043b\u0430, \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0441\u043b\u0430\u045e\u043d\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443. \u041d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0430\u0434\u0430\u0440\u0432\u0430\u043b\u0430 \u0436\u043e\u043d\u0430\u043a \u0430\u0434 \u043c\u0443\u0436\u043e\u045e \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u044e \u043d\u0430\u0448\u0430\u0433\u0430 \u043f\u0440\u0430\u0430\u0439\u0446\u0430 \u0410\u0434\u0430\u043c\u0430: &laquo;\u042f\u043d\u0430 \u043a\u043e\u0441\u0442\u043a\u0430 \u0430\u0434 \u043c\u0430\u0451\u0439 \u043a\u043e\u0441\u0442\u043a\u0456 \u0456 \u0446\u0435\u043b\u0430 \u0430\u0434 \u043c\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430&raquo; (\u043f\u0430\u0440. \u0411\u044b\u0446 2, 23). \u041d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0456 \u043d\u044f\u0437\u0433\u043e\u0434\u0430 \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u043b\u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0433\u0430\u0440\u0430\u0434\u044b \u0456 \u0434\u0430\u0448\u0447\u044d\u043d\u0442\u0443 \u0437\u043d\u0456\u0448\u0447\u044b\u043b\u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u044f \u043d\u0430\u0440\u043e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f! \u041f\u0456\u0448\u0430\u043c \u0433\u044d\u0442\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0432\u0430\u0448\u0430\u0433\u0430 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0456 \u0441\u044f\u0431\u0435 \u043f\u0430\u0432\u0443\u0447\u044b\u0446\u044c. \u0411\u043e \u043c\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c\u0441\u044f \u043d\u0430 \u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0431\u043e\u044e, \u0456 \u043d\u0430\u0441 \u0447\u0430\u043a\u0430\u0435 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u044f \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0430. \u0422\u0430\u043c\u0443 \u043f\u0430\u043a\u0456\u043d\u0435\u043c \u043f\u0443\u0441\u0442\u044b\u044f \u0456 \u043d\u0435\u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u044f \u043a\u043b\u043e\u043f\u0430\u0442\u044b, \u0430 \u0431\u0443\u0434\u0437\u0435\u043c \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0441\u043b\u0430\u045e\u043d\u044b\u0445 \u0456 \u0433\u043e\u0434\u043d\u044b\u0445 \u043f\u0430\u0432\u0430\u0433\u0456 \u045e\u043a\u0430\u0437\u0430\u043d\u043d\u044f\u045e \u043d\u0430\u0448\u0430\u0439 \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u0456. \u0421\u0442\u0430\u0440\u0430\u0439\u043c\u0430\u0441\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0435, \u043c\u0456\u043b\u0430\u0435 \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435 \u045e \u0432\u0430\u0447\u0430\u0445 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f. \u0411\u0443\u0434\u0437\u0435\u043c \u0443\u0433\u043b\u044f\u0434\u0430\u0446\u0446\u0430 \u045e \u043a\u0440\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u0430 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u0434\u043b\u044f \u0410\u0439\u0446\u0430. \u041f\u0440\u0430\u043b\u0456\u0442\u0430\u044f \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u044f\u043d\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u045e\u0441\u044f\u043c\u0443 \u0441\u0432\u0435\u0442\u0443 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u043f 7, 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u0434\u0430\u043b\u0456 \u0446\u0435\u043b\u044b \u0441\u0432\u0430\u0435 \u043d\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0433\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u043c\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0432\u0435\u0447\u043d\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u044d\u0442\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u045e\u0446\u0456\u0441\u043a\u0443 \u0456 \u0430\u0431\u043c\u044b\u045e \u0448\u0430\u0442\u044b \u0441\u0432\u0430\u0435 \u045e \u043a\u0440\u044b\u0432\u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0432\u0435\u0447\u043d\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"684","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 26, 7-9: PL 76, 1201-1202)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u043d \u043c\u043e\u0439 \u0456 \u0411\u043e\u0433 \u043c\u043e\u0439<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0422\u0430\u043c\u0430\u0448, \u0430\u0434\u0437\u0456\u043d \u0437 \u0414\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0456, \u044f\u043a\u043e\u0433\u0430 \u0437\u0432\u0430\u043b\u0456 \u0411\u043b\u0456\u0437\u043d\u044f, \u043d\u0435 \u0431\u044b\u045e \u0437 \u0456\u043c\u0456, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0415\u0437\u0443\u0441&raquo; (\u042f\u043d 20, 24). \u0422\u043e\u043b\u044c\u043a\u0456 \u044f\u0433\u043e \u043d\u0435 \u0431\u044b\u043b\u043e. \u041a\u0430\u043b\u0456 \u0436 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0456 \u043f\u0430\u0447\u0443\u045e, \u0448\u0442\u043e \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f, \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0432\u0435\u0440\u044b\u0446\u044c. \u0422\u0430\u0434\u044b \u041f\u0430\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437\u043d\u043e\u045e \u0456 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0433\u044d\u0442\u0430\u043c\u0443 \u043d\u044f\u0432\u0435\u0440\u0443\u044e\u0447\u0430\u043c\u0443 \u0432\u0443\u0447\u043d\u044e \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u043a\u0443, \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0440\u0443\u043a\u0456 \u0456 \u043f\u0440\u0430\u0437 \u0441\u043b\u044f\u0434\u044b \u0441\u0432\u0430\u0456\u0445 \u0440\u0430\u043d\u0430\u045e \u0432\u044b\u043b\u0435\u0447\u044b\u045e \u0440\u0430\u043d\u0443 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0431\u044f\u0437\u0432\u0435\u0440&rsquo;\u044f. \u0428\u0442\u043e \u0434\u0443\u043c\u0430\u0435\u0446\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b? \u041c\u043e\u0436\u0430 \u043b\u0456\u0447\u044b\u0446\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0432\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u0430. \u0428\u0442\u043e \u0432\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0433\u0430 \u0432\u0443\u0447\u043d\u044f, \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043f\u0430\u0447\u0443\u045e, \u043a\u0430\u043b\u0456 \u043f\u0430\u0447\u0443\u045e, \u0437\u0430\u0441\u0443\u043c\u043d\u044f\u0432\u0430\u045e\u0441\u044f, \u0437 \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0435\u043c \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u045e\u0441\u044f, \u0430, \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0448\u044b\u0441\u044f, \u043f\u0430\u0432\u0435\u0440\u044b\u045e?<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435, \u0433\u044d\u0442\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u0432\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u044b\u043c, \u0430\u043b\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0434\u0437\u0435\u044f\u043d\u043d\u044e \u0411\u043e\u0436\u0430\u0433\u0430 \u041f\u0440\u043e\u0432\u0456\u0434\u0443. \u041f\u0440\u0430\u0437 \u0446\u0443\u0434 \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u044b \u0432\u0443\u0447\u0430\u043d\u044c \u0437 \u043d\u0435\u0434\u0430\u0432\u0435\u0440\u0430\u043c \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u045e\u0441\u044f \u0434\u0430 \u0440\u0430\u043d\u044b \u043d\u0430 \u0446\u0435\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430, \u0442\u0430\u0434\u044b \u0401\u043d \u0432\u044b\u043b\u0435\u0447\u044b\u045e \u043d\u0430\u0441 \u0430\u0434 \u0431\u044f\u0437\u0432\u0435\u0440&rsquo;\u044f. \u0411\u044f\u0437\u0432\u0435\u0440&rsquo;\u0435 \u0436 \u0422\u0430\u043c\u0430\u0448\u0430 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u043b\u043e \u043d\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u044b \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u0432\u0435\u0440\u0430 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e. \u0411\u043e \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0434\u043e\u0442\u044b\u043a \u0437\u043d\u043e\u045e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0432\u0435\u0440\u0443, \u0442\u0430\u0434\u044b \u0456 \u043d\u0430\u0448\u0430 \u0432\u0435\u0440\u0430, \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0448\u044b \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0456, \u0431\u044b\u043b\u0430 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u0430\u044f. \u0422\u0430\u043c\u0443 \u0432\u0443\u0447\u0430\u043d\u044c, \u044f\u043a\u0456 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u045e\u0441\u044f \u0456 \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u045e\u0441\u044f, \u0441\u0442\u0430\u045e \u0441\u0432\u0435\u0434\u043a\u0430\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e: &laquo;\u041f\u0430\u043d \u043c\u043e\u0439 \u0456 \u0411\u043e\u0433 \u043c\u043e\u0439&raquo;. \u0410 \u0415\u0437\u0443\u0441 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: &laquo;\u0422\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u045e \u041c\u044f\u043d\u0435&raquo; (\u042f\u043d 20, 28-29). \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430: &laquo;\u0412\u0435\u0440\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0437\u0430\u0440\u0443\u043a\u0430 \u0442\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u044f\u043a\u0456\u0445 \u0447\u0430\u043a\u0430\u0435\u043c; \u0433\u044d\u0442\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0442\u043e\u0439 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u0456, \u044f\u043a\u043e\u0439 \u043d\u0435 \u0431\u0430\u0447\u044b\u043c&raquo;. \u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435, \u0448\u0442\u043e \u0432\u0435\u0440\u0430 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u043d\u0430\u043c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0443\u0431\u0430\u0447\u044b\u0446\u044c. \u0411\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0430\u0447\u043d\u0430\u0435, \u0443\u0436\u043e \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0434\u043c\u0435\u0442\u0430\u043c \u0432\u0435\u0440\u044b, \u0430\u043b\u0435 \u0432\u0435\u0434\u0430\u045e. \u0427\u0430\u043c\u0443 \u0436 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0422\u0430\u043c\u0430\u0448\u0443, \u044f\u043a\u0456 \u0431\u0430\u0447\u044b\u045e \u0456 \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u045e\u0441\u044f: &laquo;\u0422\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u045e\u0431\u0430\u0447\u044b\u045e \u041c\u044f\u043d\u0435&raquo;. \u0412\u043e\u0441\u044c \u0436\u0430 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0442\u043e\u0439 \u0431\u0430\u0447\u044b\u045e \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0435 \u0437\u0430 \u0442\u043e\u0435, \u0443 \u0448\u0442\u043e \u0432\u0435\u0440\u044b\u045e. \u0421\u043c\u044f\u0440\u043e\u0442\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u0422\u0430\u043c\u0430\u0448 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u043d \u043c\u043e\u0439 \u0456 \u0411\u043e\u0433 \u043c\u043e\u0439&raquo;, \u0451\u043d \u0431\u0430\u0447\u044b\u045e \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u045e \u0433\u044d\u0442\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0432\u044b\u0437\u043d\u0430\u045e \u0411\u043e\u0433\u0430. \u0423\u0431\u0430\u0447\u044b\u045e\u0448\u044b, \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u0431\u043e \u045e\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0432\u044b\u0437\u043d\u0430\u045e \u0411\u043e\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435 \u043c\u043e\u0433 \u0443\u0431\u0430\u0447\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0430\u0441 \u0440\u0430\u0434\u0443\u044e\u0446\u044c: &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u0431\u0430\u0447\u044b\u045e, \u0430 \u043f\u0430\u0432\u0435\u0440\u044b\u045e!&raquo; (\u042f\u043d 20, 28). \u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0430\u0434\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u0434\u0430 \u043d\u0430\u0441, \u0431\u043e \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043c\u044b \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u043f\u0440\u044b\u043c\u0430\u0435\u043c \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0432\u0430\u0447\u044b\u043c\u0430. \u042f\u043d\u044b \u0434\u0430\u0442\u044b\u0447\u0430\u0446\u044c \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430 \u043d\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u0430\u0439 \u0456\u0434\u0443\u0446\u044c \u0443\u0447\u044b\u043d\u043a\u0456. \u0422\u043e\u0439 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u0435\u0440\u044b\u0446\u044c, \u0445\u0442\u043e \u0447\u044b\u043d\u0430\u043c \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u0443 \u0448\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c. \u041f\u0440\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u0435\u0440\u0443 \u0432\u044b\u0437\u043d\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c: &laquo;\u041a\u0430\u0436\u0443\u0446\u044c, \u0448\u0442\u043e \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u0411\u043e\u0433\u0430, \u0430 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u044f\u0440\u044d\u0447\u0430\u0446\u044c&raquo; (\u0426\u0456\u0442 1, 16). \u0410 \u0441\u0432. \u042f\u043a\u0443\u0431 \u0442\u0430\u043a \u043a\u0430\u0436\u0430: &laquo;\u0412\u0435\u0440\u0430 \u043c\u0451\u0440\u0442\u0432\u0430\u044f \u0431\u0435\u0437 \u0443\u0447\u044b\u043d\u043a\u0430\u045e&raquo; (\u042f\u043a 2, 26).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 1, 2. 1. 3\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0416\u044b\u0446\u0446\u0451 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f, \u0456 \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456, \u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u043c, \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0432\u0430\u043c<span style=\"color: #ff0000;\"> *<\/span> \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u045e \u0410\u0439\u0446\u0430 \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u0430 \u0421\u043b\u043e\u0432\u0430 \u0436\u044b\u0446\u0446\u044f, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u043b\u0456 \u043d\u0430 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b, \u043d\u0430 \u0448\u0442\u043e \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u0456 \u0434\u0430 \u0447\u0430\u0433\u043e \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u043b\u0456\u0441\u044f \u043d\u0430\u0448\u044b\u044f \u0440\u0443\u043a\u0456, \u0448\u0442\u043e \u043c\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0456 \u0447\u0443\u043b\u0456, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u045e \u0410\u0439\u0446\u0430 \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"685","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u044b\u043f\u0456\u0441\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0432. \u041f\u044f\u0442\u0440\u0443 \u0425\u0440\u044b\u0437\u0430\u043b\u043e\u0433\u0443, \u0431\u0456\u0441\u043a\u0443\u043f\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(De pace: PL 52, 347-348)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043c\u0456\u0440\u0430\u0442\u0432\u043e\u0440\u0446\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043c\u0456\u0440\u0430\u0442\u0432\u043e\u0440\u0446\u044b, \u0431\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0437\u0432\u0430\u043d\u044b\u044f \u0441\u044b\u043d\u0430\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456&raquo; (\u041c\u0446 5, 9). \u0423 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456\u0445 \u0446\u043d\u043e\u0442\u0430\u0445 \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437 \u0443\u0441\u0456\u043c\u0456 \u0436\u044b\u0432\u0435 \u045e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0456. \u041d\u0435\u043b\u044c\u0433\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u0446\u0430 \u0434\u0437\u0456\u0446\u0435\u043c \u0411\u043e\u0436\u044b\u043c, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0448\u0441\u044f \u043d\u043e\u0441\u044c\u0431\u0456\u0442\u0430\u043c \u0441\u043f\u0430\u043a\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0441\u043f\u0430\u043a\u043e\u0439 \u0440\u043e\u0431\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c \u0456 \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b\u043c. \u0417\u043c\u044f\u043d\u044f\u0435 \u044f\u0433\u043e \u0430\u0434\u043d\u043e\u0441\u0456\u043d\u044b \u0434\u0430 \u0411\u043e\u0433\u0430: \u0441\u0430 \u0441\u043b\u0443\u0433\u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0441\u044b\u043d\u0430\u043c, \u0437 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430 &ndash; \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c. \u0421\u043f\u0430\u043a\u043e\u0439 \u0441\u044f\u0440\u043e\u0434 \u0431\u0440\u0430\u0442\u043e\u045e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u044f\u0439, \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0425\u0440\u044b\u0441\u0442\u0430, \u0443\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u043f\u0440\u044b\u043d\u0446\u044b\u043f\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u0445\u043e\u045e\u043d\u0456\u043a\u0430\u043c \u0437\u0432\u044b\u0447\u0430\u044f\u045e, \u0432\u0430 \u045e\u0441\u0456\u0445 \u0430\u0431\u0441\u0442\u0430\u0432\u0456\u043d\u0430\u0445 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c. \u0421\u043f\u0430\u043a\u043e\u0439 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u0433\u044d\u0442\u0430 \u043b\u0451\u0433\u043a\u0456 \u0456 \u043f\u043b\u0451\u043d\u043d\u044b \u0448\u043b\u044f\u0445 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u045e, \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u0447\u0430\u043a\u0430\u043d\u043d\u044f\u045e. \u0421\u043f\u0430\u043a\u043e\u0439 &ndash; \u0433\u044d\u0442\u0430 \u043c\u0430\u0446\u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u0432\u0443\u0437\u0435\u043b \u0437\u0433\u043e\u0434\u044b, \u0432\u044b\u0440\u0430\u0437\u043d\u0430\u044f \u0440\u044b\u0441\u0430 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430, \u044f\u043a\u043e\u0435 \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0411\u043e\u0433\u0430 \u0430\u0431 \u0443\u0441\u0456\u043c, \u0447\u0430\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0435: \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435. \u0421\u043f\u0430\u043a\u043e\u0439 \u0442\u0440\u044d\u0431\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0437\u0430\u0433\u0430\u0434\u0443, \u0431\u043e \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0421\u043f\u0430\u043a\u043e\u0439 \u043f\u0430\u043a\u0456\u0434\u0430\u044e \u0432\u0430\u043c, \u0441\u043f\u0430\u043a\u043e\u0439 \u041c\u043e\u0439 \u0434\u0430\u044e \u0432\u0430\u043c&raquo; (\u042f\u043d 14, 27). \u0413\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u0401\u043d \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0430\u0441 \u0443 \u0441\u043f\u0430\u043a\u043e\u0456 \u0456 \u045e \u0441\u043f\u0430\u043a\u043e\u0456 \u0445\u043e\u0447\u0430 \u043d\u0430\u0441 \u0437\u0430\u0441\u0442\u0430\u0446\u044c. \u0410\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b, \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0447\u0430\u0441 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f \u0445\u0430\u0446\u0435\u045e \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0432\u0430 \u045e\u0441\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0411\u043e\u0436\u044b\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u043a\u0430\u0437 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043c \u043f\u0430\u043a\u0456\u043d\u0443\u045e: \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0435 &ndash; \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u043a\u0456\u043d\u0443\u045e. \u0423\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u0435 \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u044e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0436\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0430\u0439, \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435 \u044f\u0433\u043e &ndash; \u0441\u043f\u0440\u0430\u0432\u0430\u0439 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f. \u0411\u043e \u044f\u043a \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u043a\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430, \u0442\u0430\u043a \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0441\u0430\u0442\u0430\u043d\u044b. \u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0430\u0434\u043a\u0456\u043d\u0443\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c, \u0431\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0442\u043e\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u0437\u0430\u0431\u043e\u0439\u0446\u0430&raquo; (1 \u042f\u043d 3, 15). \u0411\u0430\u0447\u044b\u0446\u0435, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0447\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u0446\u0430\u043d\u0456\u0446\u044c \u0437\u0433\u043e\u0434\u0443; \u0431\u043e \u044f\u043d\u044b \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e\u0446\u044c \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u043b\u044e\u0431\u043e\u045e. \u0412\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430 &laquo;\u043b\u044e\u0431\u043e\u045e \u0430\u0434 \u0411\u043e\u0433\u0430&raquo; (1 \u042f\u043d 4, 7). \u0423 \u043a\u0456\u043c \u043d\u044f\u043c\u0430 \u043b\u044e\u0431\u043e\u0432\u0456, \u0442\u043e\u0439 \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u0435\u043c \u0436\u0430, \u0431\u0440\u0430\u0442\u044b, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u044f\u043a\u0456\u044f \u0434\u0430\u044e\u0446\u044c \u0436\u044b\u0446\u0446\u0451. \u041d\u044f\u0445\u0430\u0439 \u0442\u0440\u044b\u0432\u0430\u0435 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u043a\u0430\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u0430\u044f \u043f\u043e\u0432\u044f\u0437\u0437\u044e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u044e; \u043d\u044f\u0445\u0430\u0439 \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0437\u0431\u0430\u045e\u0447\u044b\u043c \u0432\u0443\u0437\u043b\u043e\u043c \u0443\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0442\u043e\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0430\u044f \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0433\u0440\u0430\u0445\u043e\u045e. \u0417 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b\u0430\u045e \u0431\u0443\u0434\u0437\u0435\u043c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u043b\u044e\u0431\u043e\u0432\u0456, \u0431\u043e \u044f\u043d\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u0434\u043e\u0431\u0440\u044b\u0445 \u0447\u044b\u043d\u0430\u045e \u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434. \u0421\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u0446\u043d\u043e\u0442\u0430\u045e \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0442\u0440\u044d\u0431\u0430 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u0430\u0431 \u0441\u043f\u0430\u043a\u043e\u0456, \u0431\u043e \u045e \u0441\u043f\u0430\u043a\u043e\u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0451\u0441\u0446\u044c \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0431\u0456\u0446\u0435 \u0441\u043f\u0430\u043a\u043e\u0439, \u0456 \u0451\u043d \u043d\u0430\u0441\u0442\u0430\u043d\u0435. \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430\u0439, \u0430 \u0434\u043b\u044f \u0432\u0430\u0441 \u0440\u0430\u0434\u0430\u0441\u0446\u044e. \u041a\u0430\u0441\u0446\u0451\u043b \u0411\u043e\u0436\u044b, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b \u045e \u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u044f\u043a\u0430\u044f \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0441\u0430 \u0441\u043f\u0430\u043a\u043e\u044e, \u0431\u0443\u0434\u0437\u0435 \u0432\u0435\u0441\u0446\u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0425\u0440\u044b\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 58, 7-8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0437\u044f\u043b\u0456\u0441\u044f \u0437 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u043c \u0445\u043b\u0435\u0431\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u043f\u0443\u0441\u043a\u0430\u0439 \u0443 \u0434\u043e\u043c \u0431\u0435\u0434\u043d\u044b\u0445 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0430\u045e. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0430\u0434\u044b \u0437\u0430\u0437\u0437\u044f\u0435, \u044f\u043a \u0437\u043e\u043b\u0430\u043a, \u0441\u0432\u044f\u0442\u043b\u043e \u0442\u0432\u0430\u0451, \u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0442\u0432\u0430\u044f \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u043f\u0440\u0430\u043d\u0456 \u0433\u043e\u043b\u0430\u0433\u0430, \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u0448, \u0456 \u0430\u0434 \u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u0445\u0430\u0432\u0430\u0439\u0441\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u0434\u044b \u0437\u0430\u0437\u0437\u044f\u0435, \u044f\u043a \u0437\u043e\u043b\u0430\u043a, \u0441\u0432\u044f\u0442\u043b\u043e \u0442\u0432\u0430\u0451, \u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0442\u0432\u0430\u044f \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e.<\/p>\r\n"}, {"GCH_CH_2_ID":"686","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0434\u0430 \u0441\u0430\u0431\u0440\u0430\u0442\u043e\u045e \u0441\u0432. \u0410\u043d\u0442\u043e\u043d\u0456\u044f \u041c\u0430\u0440\u044b\u0456 \u0414\u0437\u0430\u043a\u043a\u0430\u0440\u044b\u044f, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(J. A. Gabutio, Historia Congregationis Clericorum Regularium S. Pauli, 1, 8)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u0443\u0447\u0430\u043d\u044c \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041c\u044b \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430&raquo; (1 \u041a\u0430\u0440 4, 10), &ndash; \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b, \u043d\u0430\u0448 \u0430\u043f\u044f\u043a\u0443\u043d \u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u043d\u0456\u043a, \u043f\u0440\u0430 \u0441\u044f\u0431\u0435, \u043f\u0440\u0430 \u0456\u043d\u0448\u044b\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u043f\u0440\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0432\u044f\u0434\u0437\u0435 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0435 \u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u043c\u0443 \u0456 \u0431\u0430\u044f\u0446\u0446\u0430, \u0431\u043e &laquo;\u0432\u0443\u0447\u0430\u043d\u044c \u043d\u0435 \u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0437\u0430 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430, \u0456 \u0441\u043b\u0443\u0433\u0430 \u043d\u0435 \u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0437\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0441\u0432\u0430\u0439\u0433\u043e&raquo; (\u041c\u0446 10, 24). \u0422\u043e\u0439, \u0445\u0442\u043e \u043d\u0430\u0441 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u0435, \u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0430\u043c \u0441\u0430\u0431\u0435, \u0431\u043e \u043d\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043d\u0430 \u0441\u044f\u0431\u0435 \u0411\u043e\u0436\u044b \u0433\u043d\u0435\u045e. \u041d\u0430\u043c \u0436\u0430 \u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0434\u0430\u0431\u0440\u043e, \u0431\u043e \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435 \u043d\u0430\u0448 \u0432\u044f\u043d\u043e\u043a \u0432\u0435\u0447\u043d\u0430\u0439 \u0445\u0432\u0430\u043b\u044b. \u0422\u0430\u043c\u0443 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u043e\u043b\u044c\u0448 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u0446\u044c \u0456\u043c \u0456 \u0430\u0442\u0430\u0447\u0430\u0446\u044c \u0456\u0445 \u043b\u044e\u0431\u043e\u045e\u044e, \u0447\u044b\u043c \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0446\u044c \u0456\u043c\u0456 \u0456 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u0446\u044c. \u0411\u0435\u0437\u0443\u043c\u043e\u045e\u043d\u0430, \u0442\u0440\u044d\u0431\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0437\u0430 \u0456\u0445, \u0456 \u043d\u0435 \u0434\u0430\u0446\u044c \u0437\u043b\u0443 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0447\u044b \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0437\u043b\u043e \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0446\u044c \u0434\u0430\u0431\u0440\u043e\u043c. \u0422\u0440\u044d\u0431\u0430, \u044f\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u0437\u0431\u0456\u0440\u0430\u0446\u044c \u0456\u043c \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u0433\u0430\u0440\u0430\u0447\u0430\u0435 \u0432\u0443\u0433\u043e\u043b\u043b\u0435 (\u043f\u0430\u0440. \u0420\u044b\u043c 12, 20), \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0446\u044c \u0443\u0447\u044b\u043d\u043a\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u0422\u0430\u043a, \u0431\u0430\u0447\u0443\u0447\u044b \u043d\u0430\u0448\u0443\u044e \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u044f\u043d\u044b \u0437\u043c\u0435\u043d\u044f\u0446\u044c \u0441\u0432\u0430\u0435 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0456 \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u044c \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435 \u045e \u0411\u043e\u0433\u0443. \u0423 \u0441\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0411\u043e\u0433, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u043d\u0430\u0448\u0443\u044e \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u0430\u0441\u0446\u044c, \u0432\u044b\u0431\u0440\u0430\u045e \u043d\u0430\u0441 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u043a\u0430\u0431 \u043c\u044b \u043f\u0440\u0430\u0437 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u042f\u043c\u0443 \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u043b\u0456\u0441\u044f \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u0431\u0430\u0433\u0430\u0442\u044b \u043f\u043b\u0451\u043d \u043b\u044e\u0431\u043e\u0432\u0456, \u043a\u0430\u0431 \u043c\u044b \u0433\u0430\u043d\u0430\u0440\u044b\u043b\u0456\u0441\u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0445\u0432\u0430\u043b\u044b \u0441\u044b\u043d\u043e\u045e \u0411\u043e\u0436\u044b\u0445, \u0430\u043b\u0435 \u0456 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u043d\u0430\u0441 \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u044e\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u0431\u0440\u0430\u0442\u044b \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043d\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0432\u0430\u0448\u0430\u0435 (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 1, 26). \u041a\u0430\u043b\u0456 \u043c\u044b \u045e\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u043c \u043d\u0430\u0434 \u0456\u043c, \u0437 \u043b\u0451\u0433\u043a\u0430\u0441\u0446\u044e \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u043c, \u0447\u0430\u0433\u043e \u044f\u043d\u043e \u0430\u0434 \u043d\u0430\u0441 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0456\u0434\u0437\u0451\u043c, \u0445\u043e\u0446\u044c \u0456 \u0437\u0434\u0430\u043b\u0451\u043a, \u0441\u043b\u044f\u0434\u0430\u043c\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u0456\u043d\u0448\u044b\u0445 \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u0446\u0446\u0430 \u0430\u0434 \u0443\u0434\u0437\u0435\u043b\u0443 \u045e \u0456\u0445 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445: &laquo;\u0411\u0443\u0434\u0437\u0435\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0431\u0435\u0433\u0447\u044b \u045e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u043c \u0434\u043b\u044f \u043d\u0430\u0441 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u043f\u0430\u0447\u044b\u043d\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0456 \u0437\u0430\u0432\u044f\u0440\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0432\u0435\u0440\u044b&raquo; (\u0413\u0431\u0440 12, 1-2).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0436, \u044f\u043a\u0456\u044f \u0432\u044b\u0431\u0440\u0430\u043b\u0456 \u0442\u0430\u043a\u043e\u0433\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u0430\u0432\u0430\u0434\u043d\u0456\u043a\u043e\u043c \u0456 \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0456 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u044f\u0433\u043e, \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0442\u0430\u0440\u0430\u0446\u0446\u0430 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u043f\u0440\u0430 \u044f\u0433\u043e \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0456 \u045e\u0447\u044b\u043d\u043a\u0456. \u0411\u043e \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043a\u0430\u0431 \u043c\u044b, \u043c\u0430\u044e\u0447\u044b \u0442\u0430\u043a\u043e\u0433\u0430 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430, \u0431\u044b\u043b\u0456 \u043b\u044f\u043d\u0456\u0432\u044b\u043c\u0456 \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u043c\u0456 \u0446\u0456 \u0434\u044b\u0437\u0435\u0440\u0442\u044b\u0440\u0430\u043c\u0456, \u0430\u0431\u043e \u043a\u0430\u0431 \u0441\u0442\u0430\u043b\u0456 \u043c\u044b \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0442\u0430\u043a\u043e\u0433\u0430 \u0441\u043b\u0430\u045e\u043d\u0430\u0433\u0430 \u0430\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0414\u0437 20, 21. 24; \u0420\u044b\u043c 1, 16\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430\u044e\u0447\u044b \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0432\u0435\u0440\u0443 \u045e \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430, \u044f \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0431\u0430\u044e\u0441\u044f. <span style=\"color: #ff0000;\">*<\/span> \u041c\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043d\u0435 \u0432\u0430\u0440\u0442\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430. <span style=\"color: #ff0000;\">\/<\/span> \u0422\u043e\u043b\u044c\u043a\u0456 \u0431 \u0441\u043a\u043e\u043d\u0447\u044b\u045e \u0431\u0435\u0433 \u0441\u0432\u043e\u0439 \u0456 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u044b\u043d\u044f\u045e,<span style=\"color: #ff0000;\"> \/<\/span> \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u043d\u0435 \u0441\u0430\u0440\u043e\u043c\u0435\u044e\u0441\u044f \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043d\u0435 \u0432\u0430\u0440\u0442\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430. <span style=\"color: #ff0000;\">\/<\/span> \u0422\u043e\u043b\u044c\u043a\u0456 \u0431 \u0441\u043a\u043e\u043d\u0447\u044b\u045e \u0431\u0435\u0433 \u0441\u0432\u043e\u0439 \u0456 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u044b\u043d\u044f\u045e, <span style=\"color: #ff0000;\">\/<\/span> \u043a\u0430\u0431 \u0434\u0430\u0446\u044c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"688","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u043f\u0430\u043f\u044b \u041f\u0456\u044f \u0425\u0406\u0406 \u0443 \u0434\u0437\u0435\u043d\u044c \u043a\u0430\u043d\u0430\u043d\u0456\u0437\u0430\u0446\u044b\u0456 \u0431\u043b. \u041c\u0430\u0440\u044b\u0456 \u0413\u0430\u0440\u044d\u0446\u0446\u0456<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(\u0410\u0410S 42 [1950], 581-582)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u0435 \u0431\u0443\u0434\u0443 \u0431\u0430\u044f\u0446\u0446\u0430 \u0437\u043b\u0430, \u0431\u043e \u0422\u044b \u0441\u0430 \u043c\u043d\u043e\u044e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u045e\u0441\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0433\u044d\u0442\u0430\u044f \u0431\u0435\u0437\u0430\u0431\u0430\u0440\u043e\u043d\u043d\u0430\u044f \u043f\u0430\u043d\u043d\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u0430 \u0432\u0435\u0441\u0446\u0456 \u043d\u044f\u0440\u043e\u045e\u043d\u0443\u044e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0443. \u041d\u0435\u0447\u0430\u043a\u0430\u043d\u0430 \u045e\u0434\u0430\u0440\u044b\u043b\u0430 \u045e \u044f\u0435 \u0440\u0430\u043f\u0442\u043e\u045e\u043d\u0430\u044f \u0456 \u0441\u043b\u044f\u043f\u0430\u044f \u0431\u0443\u0440\u0430, \u044f\u043a\u0430\u044f \u0445\u0430\u0446\u0435\u043b\u0430 \u0437\u0430\u043f\u043b\u044f\u043c\u0456\u0446\u044c \u0456 \u0437\u043d\u044f\u0432\u0430\u0436\u044b\u0446\u044c \u044f\u0435 \u0430\u043d\u0451\u043b\u044c\u0441\u043a\u0443\u044e \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c. \u0423 \u0433\u044d\u0442\u044b\u043c \u0436\u0430\u0445\u043b\u0456\u0432\u044b\u043c \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456 \u044f\u043d\u0430 \u043c\u0430\u0433\u043b\u0430 \u0431 \u043f\u0430\u045e\u0442\u0430\u0440\u044b\u0446\u044c \u0411\u043e\u0441\u043a\u0430\u043c\u0443 \u0417\u0431\u0430\u045e\u0446\u0443 \u0441\u043b\u043e\u0432\u044b \u0437 \u0432\u0435\u043b\u044c\u043c\u0456 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0439 \u043a\u043d\u0456\u0433\u0456 &laquo;\u041f\u0440\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430&raquo;: &laquo;\u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043c\u044f\u043d\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u0456 \u043c\u0443\u0447\u044b\u0446\u044c \u0440\u043e\u0437\u043d\u044b\u044f \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b, \u043d\u0435 \u0431\u0443\u0434\u0443 \u0431\u0430\u044f\u0446\u0446\u0430 \u0437\u043b\u0430, \u0431\u043e \u0422\u044b \u0441\u0430 \u043c\u043d\u043e\u044e. \u0422\u0432\u0430\u044f \u043b\u0430\u0441\u043a\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043c\u0430\u044f \u043c\u043e\u0446, \u044f\u043a\u0430\u044f \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u0430\u0440\u0430\u0434\u0443 \u0456 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443. \u042f\u043d\u0430 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u044f \u0437\u0430 \u045e\u0441\u0456\u0445 \u0432\u043e\u0440\u0430\u0433\u0430\u045e&raquo;. \u041f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u044f \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043b\u0430\u0441\u043a\u0430\u0439 \u0437 \u043d\u0435\u0431\u0430, \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u0430\u044f \u0456 \u043c\u0443\u0436\u043d\u0430\u044f, \u044f\u043d\u0430 \u0430\u0434\u0434\u0430\u043b\u0430 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451, \u0430\u043b\u0435 \u043d\u0435 \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0430 \u0445\u0432\u0430\u043b\u044b \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0416\u044b\u0446\u0446\u0451 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u043e\u0441\u0442\u0430\u0439 \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u044b, \u044f\u043a\u043e\u0435 \u043c\u044b \u043a\u043e\u0440\u0430\u0442\u043a\u0430 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u0432\u0456\u043b\u0456, \u0433\u043e\u0434\u043d\u0430\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435\u0431\u0430, \u0430\u043b\u0435 \u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043d\u0430 \u044f\u0435 \u0437 \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u0435\u043c \u0456 \u043f\u0430\u0448\u0430\u043d\u0430\u044e \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u043d\u0430\u0448\u044b\u044f \u0441\u0443\u0447\u0430\u0441\u043d\u0456\u043a\u0456. \u041d\u044f\u0445\u0430\u0439 \u0431\u0430\u0446\u044c\u043a\u0456 \u0456 \u043c\u0430\u0446\u0456 \u0432\u0443\u0447\u0430\u0446\u0446\u0430, \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u044b\u0445 \u0456\u043c \u043f\u0440\u0430\u0437 \u0411\u043e\u0433\u0430 \u0434\u0437\u044f\u0446\u0435\u0439 \u0443 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0456 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456; \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u044b\u043d\u0446\u044b\u043f\u0430\u045e \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0430\u0439 \u0432\u0435\u0440\u044b, \u043a\u0430\u0431 \u044f\u043d\u044b, \u043a\u0430\u043b\u0456 \u0430\u043f\u044b\u043d\u0443\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435\u043c, \u0437\u043c\u0430\u0433\u043b\u0456 \u0437 \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0432\u044b\u0439\u0441\u0446\u0456 \u0437 \u044f\u0433\u043e \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430\u043c\u0456, \u043d\u0435\u043f\u0430\u0448\u043a\u043e\u0434\u0436\u0430\u043d\u044b\u043c\u0456 \u0456 \u043d\u0435\u0437\u0430\u043f\u043b\u044f\u043c\u043b\u0435\u043d\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0432\u0443\u0447\u0430\u0446\u0446\u0430 \u0432\u044f\u0441\u0451\u043b\u044b\u044f \u0434\u0437\u0435\u0446\u0456, \u043d\u044f\u0445\u0430\u0439 \u0432\u0443\u0447\u044b\u0446\u0446\u0430 \u0430\u0434\u0432\u0430\u0436\u043d\u0430\u044f \u043c\u043e\u043b\u0430\u0434\u0437\u044c, \u0448\u0442\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u0433\u0430\u043d\u0435\u0431\u043d\u0430 \u043f\u0430\u0434\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u043f\u0440\u044b\u0432\u0430\u0431\u043d\u0430\u0441\u0446\u0456 \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u044b\u0445 \u0437\u0430\u0433\u0430\u043d\u0430\u045e, \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u0445 \u0456 \u043a\u0430\u0440\u043e\u0442\u043a\u0430\u0447\u0430\u0441\u043e\u0432\u044b\u0445 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044f\u045e, \u0430\u043b\u0435 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0443 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0456 \u0432\u044b\u0440\u0430\u0447\u044d\u043d\u043d\u0456, \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430 \u043a\u0440\u043e\u0447\u044b\u0446\u044c \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u045e\u0441\u0435 \u043c\u044b, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0434\u0430 \u0430\u0445\u0432\u044f\u0440\u044b \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430, \u0430\u043b\u0435 \u045e\u0441\u0435 \u043c\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0434\u0430 \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u043d\u043d\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456\u0445 \u0446\u043d\u043e\u0442\u0430\u045e. \u0410\u043b\u0435 \u0446\u043d\u043e\u0442\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0432\u044b\u0441\u0456\u043b\u043a\u0443. \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u043d\u0435 \u0441\u0442\u0430\u0456\u0446\u044c \u043d\u0430 \u0440\u043e\u045e\u043d\u0456 \u0437 \u0433\u0435\u0440\u0430\u0456\u0447\u043d\u0430\u0441\u0446\u044e \u0433\u044d\u0442\u0430\u0439 \u0430\u043d\u0451\u043b\u044c\u0441\u043a\u0430\u0439 \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u044b, \u0430\u0434\u043d\u0430\u043a \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0434\u043e\u045e\u0433\u0430\u0433\u0430, \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0433\u0430 \u0456 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430\u0433\u0430 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u0436\u044b\u0446\u0446\u044f. \u0422\u0430\u043c\u0443 \u043c\u043e\u0436\u043d\u0430 \u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430\u0435 \u0456 \u0434\u043e\u045e\u0433\u0430\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0435 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430. \u0414\u0430 \u044f\u0433\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043d\u0430\u0441 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: &laquo;\u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0456\u043b\u0430\u0439, \u0456 \u0433\u0432\u0430\u043b\u0442\u043e\u045e\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0437\u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u044f\u0433\u043e&raquo; (\u041c\u0446 11, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u043c\u044d\u0442\u044b, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u043b\u0430\u0441\u043a\u0430\u0439 \u0437 \u043d\u0435\u0431\u0430. \u041d\u044f\u0445\u0430\u0439 \u0441\u0432. \u041c\u0430\u0440\u044b\u044f \u0413\u0430\u0440\u044d\u0446\u0446\u0456, \u043f\u0430\u043d\u043d\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0430, \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u044c \u043d\u0430\u0448\u0443\u044e \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044c; \u043d\u044f\u0445\u0430\u0439 \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e, \u0434\u0437\u0435 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0432\u0435\u0447\u043d\u044b\u043c \u0448\u0447\u0430\u0441\u0446\u0435\u043c, \u0432\u044b\u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0443 \u0411\u043e\u0441\u043a\u0430\u0433\u0430 \u0417\u0431\u0430\u0432\u0456\u0446\u0435\u043b\u044f, \u043a\u0430\u0431 \u0443\u0441\u0435 \u043c\u044b, \u043a\u043e\u0436\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0430\u043d\u0443, \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0456 \u0430\u043a\u0442\u044b\u045e\u043d\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u044f\u0435 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u0434.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0430\u044f \u0436 \u0442\u044b \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u044f, \u0434\u0437\u0435\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0422\u044b \u045e\u0434\u0430\u0441\u0442\u043e\u0456\u043b\u0430\u0441\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0437 \u0440\u0443\u043a \u041f\u0430\u043d\u0430 \u0432\u044f\u043d\u043e\u043a \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u043f\u0430\u043b\u044c\u043c\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456 \u0456 \u043d\u0435 \u0430\u0434\u043b\u0443\u0447\u044b\u0446\u044c \u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u045e\u0434\u0430\u0441\u0442\u043e\u0456\u043b\u0430\u0441\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0437 \u0440\u0443\u043a \u041f\u0430\u043d\u0430 \u0432\u044f\u043d\u043e\u043a \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"689","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u043f\u0430\u043f\u044b \u042f\u043d\u0430 \u041f\u0430\u045e\u043b\u0430 \u0406\u0406 \u043f\u0430\u0434\u0447\u0430\u0441 \u043a\u0430\u043d\u0430\u043d\u0456\u0437\u0430\u0446\u044b\u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0437 \u041a\u0456\u0442\u0430\u044f<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(\u0410\u0410S 92 [2000], 849-850)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0440\u043e\u045e \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0441\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0432\u0435\u0440\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0410\u0441\u0432\u044f\u0446\u0456 \u0456\u0445 \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u0421\u043b\u043e\u0432\u0430 \u0422\u0432\u0430\u0451 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u045e\u0434\u0430&raquo; (\u042f\u043d 17, 17). \u0413\u044d\u0442\u044b \u0437\u0430\u043a\u043b\u0456\u043a, \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u044b \u045e \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0443\u044e \u0415\u0437\u0443\u0441 \u0443\u0437\u043d\u043e\u0441\u0456\u045e \u0434\u0430 \u0410\u0439\u0446\u0430 \u043f\u0430\u0434\u0447\u0430\u0441 \u0410\u043f\u043e\u0448\u043d\u044f\u0439 \u0412\u044f\u0447\u044d\u0440\u044b, \u043d\u0456\u0431\u044b \u0433\u0443\u0447\u044b\u0446\u044c \u0437 \u0448\u044d\u0440\u0430\u0433\u0443 \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u0445, \u044f\u043a\u0456\u0445 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u045e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u0445 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u0445 \u0430\u0431\u0443\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u0432\u0430\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435. \u0421\u0451\u043d\u043d\u044f, \u0443 \u0434\u0432\u0443\u0445\u0442\u044b\u0441\u044f\u0447\u043d\u044b\u043c \u0433\u043e\u0434\u0437\u0435 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u043f\u0440\u0430\u0432\u044b \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f, \u0433\u044d\u0442\u044b \u0437\u0430\u043a\u043b\u0456\u043a \u043c\u044b \u043b\u0456\u0447\u044b\u043c \u0441\u0432\u0430\u0456\u043c, \u043c\u0430\u044e\u0447\u044b \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430 \u0414\u0436\u0430\u043e \u0416\u043e\u043d\u0433\u0430 \u0456 \u044f\u0433\u043e \u0441\u0442\u0430\u0434\u0437\u0435\u0432\u044f\u0442\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u043f\u0430\u043f\u043b\u0435\u0447\u043d\u0456\u043a\u0430\u045e, \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0437 \u041a\u0456\u0442\u0430\u044f. \u0411\u043e\u0433 \u0410\u0439\u0446\u0435\u0446 \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0456\u0445 \u0443 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e\u0448\u044b \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u043d\u0430\u0431\u044b\u045e \u0434\u043b\u044f \u042f\u0433\u043e \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b, \u0440\u0430\u0441\u043f\u0430\u0441\u0446\u0451\u0440 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u0441\u0432\u0430\u0435 \u0440\u0443\u043a\u0456, \u043a\u0430\u0431 \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0447\u044b \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u0446\u044c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0441\u0446\u0451\u043b \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u041f\u0430\u043d\u0443 \u043f\u0430\u0434\u0437\u044f\u043a\u0443, \u0431\u043e \u041f\u0430\u043d \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u044f\u0433\u043e \u0456 \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u043d\u0430 \u044f\u0433\u043e \u0441\u0432\u044f\u0442\u043b\u043e \u0440\u0430\u0437\u0430\u043c \u0437 \u0431\u043b\u044f\u0441\u043a\u0430\u043c \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0433\u044d\u0442\u044b\u0445 \u0441\u044b\u043d\u043e\u045e \u0456 \u0434\u0430\u0447\u043e\u043a \u041a\u0456\u0442\u0430\u044f. \u0427\u0430\u0442\u044b\u0440\u043d\u0430\u0446\u0446\u0430\u0446\u0456\u0433\u0430\u0434\u043e\u0432\u0430\u044f \u0434\u0437\u044f\u045e\u0447\u044b\u043d\u043a\u0430 \u0413\u0430\u043d\u043d\u0430 \u0412\u0430\u043d\u0433, \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430 \u043f\u0430\u0433\u0440\u043e\u0437\u044b \u043a\u0430\u0442\u0430, \u044f\u043a\u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u045e \u044f\u0435 \u0432\u044b\u0440\u0430\u0447\u044b\u0441\u044f \u0432\u0435\u0440\u044b \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u043a\u0430\u0437\u0430\u043b\u0430, \u043a\u0430\u043b\u0456 \u0441\u0430 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0451\u0439 \u0430\u0434\u0441\u0435\u043a\u043b\u0456 \u0433\u0430\u043b\u0430\u0432\u0443: &laquo;\u0411\u0440\u0430\u043c\u044b \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u044f \u0434\u043b\u044f \u045e\u0441\u0456\u0445&raquo; \u0456 \u0442\u0440\u043e\u0439\u0447\u044b \u0448\u044d\u043f\u0442\u0430\u043c \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u0415\u0437\u0443\u0441\u0430. \u0425\u0456 \u0413\u0443\u0456\u0437\u0456, \u0432\u0430\u0441\u0435\u043c\u043d\u0430\u0446\u0446\u0430\u0446\u0456\u0433\u0430\u0434\u043e\u0432\u044b \u044e\u043d\u0430\u043a, \u0431\u0435\u0437 \u0441\u0442\u0440\u0430\u0445\u0443 \u043a\u0440\u044b\u043a\u043d\u0443\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u0442\u043e \u0430\u0434\u0441\u0435\u043a \u044f\u043c\u0443 \u043f\u0440\u0430\u0432\u0443\u044e \u0440\u0443\u043a\u0443 \u0456 \u0441\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0437\u043d\u044f\u0446\u044c \u0437 \u044f\u0433\u043e, \u0436\u044b\u0432\u043e\u0433\u0430, \u0441\u043a\u0443\u0440\u0443: &laquo;\u041a\u043e\u0436\u043d\u044b \u043a\u0430\u0432\u0430\u043b\u0430\u043a \u043c\u0430\u0439\u0433\u043e \u0446\u0435\u043b\u0430, \u043a\u043e\u0436\u043d\u0430\u044f \u043a\u0440\u043e\u043f\u043b\u044f \u043c\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0456 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0446\u044c \u0432\u0430\u043c, \u0448\u0442\u043e \u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0442\u0430\u043a\u043e\u0439 \u0436\u0430 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044e \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0434\u0430\u043b\u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0456\u043d\u0448\u044b\u044f \u0432\u043e\u0441\u0435\u043c\u0434\u0437\u0435\u0441\u044f\u0442 \u043f\u044f\u0446\u044c \u043a\u0456\u0442\u0430\u0439\u0446\u0430\u045e, \u043c\u0443\u0436\u0447\u044b\u043d \u0456 \u0436\u0430\u043d\u0447\u044b\u043d \u0440\u043e\u0437\u043d\u0430\u0433\u0430 \u045e\u0437\u0440\u043e\u0441\u0442\u0443 \u0456 \u0440\u043e\u0437\u043d\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u0443: \u0441\u0432\u044f\u0442\u0430\u0440\u044b, \u0437\u0430\u043a\u043e\u043d\u043d\u0456\u043a\u0456 \u0456 \u0441\u0432\u0435\u0446\u043a\u0456\u044f \u0432\u0435\u0440\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0437 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u043b\u0456 \u0441\u0432\u0430\u044e \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0443\u044e \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443 \u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0443. \u0410\u0434\u0431\u044b\u0432\u0430\u043b\u0430\u0441\u044f \u0433\u044d\u0442\u0430 \u045e \u0440\u043e\u0437\u043d\u044b\u044f \u044d\u043f\u043e\u0445\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0441\u043a\u043b\u0430\u0434\u0430\u043d\u044b\u0445 \u0456 \u0446\u044f\u0436\u043a\u0456\u0445 \u0430\u0431\u0441\u0442\u0430\u0432\u0456\u043d\u0430\u0445 \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e \u041a\u0456\u0442\u0430\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u044b\u043c \u0448\u044d\u0440\u0430\u0433\u0443 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0437\u0437\u044f\u044e\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0442\u0440\u044b\u0446\u0446\u0430\u0446\u0456 \u0442\u0440\u043e\u0445 \u043c\u0456\u0441\u0456\u044f\u043d\u0435\u0440\u0430\u045e \u0456 \u043c\u0456\u0441\u0456\u044f\u043d\u0435\u0440\u0430\u043a, \u044f\u043a\u0456\u044f, \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u044e \u0430\u0439\u0447\u044b\u043d\u0443, \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u043b\u0456 \u0446\u044f\u0436\u043a\u0443\u044e \u043f\u0440\u0430\u0446\u0443 \u045e\u0432\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u044f \u045e \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c \u0456 \u043c\u0435\u043d\u0442\u0430\u043b\u0456\u0442\u044d\u0442 \u043a\u0456\u0442\u0430\u0439\u0446\u0430\u045e, \u0430\u0442\u0430\u044f\u0441\u0430\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u0437 \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0441\u0446\u044f\u043c\u0456, \u0437\u0432\u044f\u0437\u0430\u043d\u044b\u043c\u0456 \u0437 \u0433\u044d\u0442\u044b\u043c\u0456 \u043c\u0456\u0441\u0456\u0439\u043d\u044b\u043c\u0456 \u0437\u0435\u043c\u043b\u044f\u043c\u0456, \u043f\u0430\u043b\u0430\u044e\u0447\u044b \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0433\u044d\u0442\u0430\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443. \u0414\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u044f\u0448\u0447\u044d \u0442\u0430\u043c \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u0456\u0445 \u043c\u0430\u0433\u0456\u043b\u044b \u044f\u043a \u0434\u043e\u043a\u0430\u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0433\u044d\u0442\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u044b, \u044f\u043a\u0443\u044e \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456, \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u0456 \u0430\u0434\u0434\u0430\u043b\u0456 \u0451\u0439 \u0443\u0441\u0435 \u0441\u0432\u0430\u0435 \u0441\u0456\u043b\u044b. &laquo;\u041c\u044b \u043d\u0456\u043a\u043e\u043c\u0443 \u043d\u0435 \u043f\u0440\u044b\u0447\u044b\u043d\u0456\u043b\u0456 \u043a\u0440\u044b\u045e\u0434\u044b, &ndash; \u0441\u043a\u0430\u0437\u0430\u045e \u0431\u0456\u0441\u043a\u0443\u043f \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u0430\u043a \u0424\u0430\u0433\u043e\u043b\u044f \u0433\u0443\u0431\u0435\u0440\u043d\u0430\u0442\u0430\u0440\u0443, \u044f\u043a\u0456 \u0437\u0431\u0456\u0440\u0430\u045e\u0441\u044f \u043d\u0430\u043d\u0435\u0441\u0446\u0456 \u044f\u043c\u0443 \u045e\u0434\u0430\u0440 \u0441\u0432\u0430\u0456\u043c \u043c\u044f\u0447\u043e\u043c, &ndash; \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u043c\u044b \u043c\u043d\u043e\u0433\u0456\u043c \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u043b\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 5, 44-45. 48<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041b\u044e\u0431\u0456\u0446\u0435 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0432\u0430\u0448\u044b\u0445 \u0456 \u043c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u0432\u0430\u0441, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0432\u044b \u0441\u044b\u043d\u0430\u043c\u0456 \u0410\u0439\u0446\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u044f\u043a\u0456 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456, \u044f\u043a \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0410\u0439\u0446\u0435\u0446 \u0432\u0430\u0448 \u041d\u044f\u0431\u0435\u0441\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0432\u044b \u0441\u044b\u043d\u0430\u043c\u0456 \u0410\u0439\u0446\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u044f\u043a\u0456 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445.<\/p>\r\n"}, {"GCH_CH_2_ID":"690","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0420\u044d\u0433\u0443\u043b\u0430&raquo; \u0441\u0432. \u0411\u044d\u043d\u044d\u0434\u044b\u043a\u0442\u0430, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Prologus, 4-22; cap. 72, 1-12: CSEL 75, 2-5. 161-163)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0448\u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u044b\u043c \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0448, \u0447\u044b\u043c \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0434\u043e\u0431\u0440\u0430\u0435 \u0437\u0430\u0445\u043e\u0447\u0430\u0448 \u0437\u0440\u0430\u0431\u0456\u0446\u044c, \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0448\u0447\u044b\u0440\u0430 \u043f\u0430\u043c\u0430\u043b\u0456\u0441\u044f, \u043a\u0430\u0431 \u0411\u043e\u0433 \u0441\u0430\u043c \u0433\u044d\u0442\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u044b\u045e, \u0430 \u043c\u044b, \u044f\u043a\u0456\u0445 \u0401\u043d \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0437\u0430\u043b\u0456\u0447\u044b\u0446\u044c \u0434\u0430 \u043b\u0456\u043a\u0443 \u0441\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043b\u0456 \u042f\u0433\u043e \u043d\u0430\u0448\u044b\u043c\u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456. \u041a\u0430\u0440\u044b\u0441\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0434\u0430\u0431\u0440\u043e\u043c, \u044f\u043a\u0456\u043c \u0430\u0434\u0430\u0440\u044b\u045e \u043d\u0430\u0441, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u0446\u044c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u042f\u043c\u0443, \u0431\u043e \u045e \u0430\u0434\u0432\u0430\u0440\u043e\u0442\u043d\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u0401\u043d \u043c\u043e\u0433 \u0431\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u0446\u044c \u043d\u0430\u0441 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b, \u044f\u043a \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u043d\u044b \u0410\u0439\u0446\u0435\u0446 \u0441\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u044f\u043a \u0433\u0440\u043e\u0437\u043d\u044b \u041f\u0430\u043d, \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0436\u0430\u043d\u044b \u043d\u0430\u0448\u0430\u0439 \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u0430\u0441\u0446\u044e, \u0401\u043d \u043c\u043e\u0433 \u0431\u044b \u0430\u0434\u0434\u0430\u0446\u044c \u043d\u0430 \u0432\u0435\u0447\u043d\u0430\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u0441\u043b\u0443\u0433\u0430\u045e, \u0431\u043e \u043c\u044b \u043d\u0435 \u0445\u0430\u0446\u0435\u043b\u0456 \u0456\u0441\u0446\u0456 \u0437\u0430 \u0406\u043c \u0434\u0430 \u0445\u0432\u0430\u043b\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0440\u044d\u0448\u0446\u0435, \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u0435\u043c, \u0431\u043e \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u043d\u0430\u0441 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: &laquo;\u041d\u0430\u0441\u0442\u0430\u043b\u0430 \u045e\u0436\u043e \u043f\u0430\u0440\u0430, \u043a\u0430\u0431 \u0432\u044b \u0430\u0431\u0443\u0434\u0437\u0456\u043b\u0456\u0441\u044f \u0441\u0430 \u0441\u043d\u0443&raquo; (\u0420\u044b\u043c 13, 11). \u0410\u0434\u043a\u0440\u044b\u045e\u0448\u044b \u0432\u043e\u0447\u044b \u043d\u0430 \u0431\u043e\u0441\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0411\u043e\u0436\u044b \u0433\u043e\u043b\u0430\u0441, \u044f\u043a\u0456 \u0448\u0442\u043e\u0434\u043d\u044f \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043d\u0430\u043c, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e\u0447\u044b: &laquo;\u041e, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u0441\u0451\u043d\u043d\u044f \u042f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0441: \u043d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c\u0456 \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f&raquo; (\u041f\u0441 95 [94], 7-8) \u0456 \u044f\u0448\u0447\u044d: &laquo;\u0425\u0442\u043e \u043c\u0430\u0435 \u0432\u0443\u0448\u044b, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0447\u0443\u0435, \u0448\u0442\u043e \u0414\u0443\u0445 \u043a\u0430\u0436\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c&raquo; (\u0410\u043f 2, 11).<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0448\u0442\u043e \u043a\u0430\u0436\u0430? &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0441\u044b\u043d\u044b, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u043c\u044f\u043d\u0435: \u043d\u0430\u0432\u0443\u0447\u0443 \u0432\u0430\u0441 \u0431\u043e\u044f\u0437\u0456 \u041f\u0430\u043d\u0430&raquo; (\u041f\u0441 34 [33], 12). \u0411\u044f\u0436\u044b\u0446\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u043c\u0430\u0435\u0446\u0435 \u0421\u0432\u044f\u0442\u043b\u043e \u0436\u044b\u0446\u0446\u044f, \u043a\u0430\u0431 \u0446\u0435\u043c\u0440\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u043d\u0435 \u0430\u0433\u0430\u0440\u043d\u0443\u043b\u0430 \u0432\u0430\u0441 (\u043f\u0430\u0440. \u042f\u043d 12, 35).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0441\u044f\u0440\u043e\u0434 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0430\u0433\u0430 \u043d\u0430\u0442\u043e\u045e\u043f\u0443, \u044f\u043a\u043e\u043c\u0443 \u043a\u0430\u0436\u0430 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0448\u0443\u043a\u0430\u0435 \u0441\u0432\u0430\u0456\u0445 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u043a\u0430\u045e \u0456 \u044f\u0448\u0447\u044d \u0440\u0430\u0437 \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u0435: &laquo;\u0425\u0442\u043e \u0442\u043e\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u045e \u0436\u044b\u0446\u0446\u0451 \u0456 \u043b\u044e\u0431\u0456\u0446\u044c \u0434\u043e\u045e\u0433\u0456\u044f \u0434\u043d\u0456, \u043a\u0430\u0431 \u0431\u0430\u0447\u044b\u0446\u044c \u0434\u0430\u0431\u0440\u043e?&raquo; (\u041f\u0441 34 [33], 13). \u041a\u0430\u043b\u0456, \u043f\u0430\u0447\u0443\u045e\u0448\u044b \u0433\u044d\u0442\u0430\u0435, \u0430\u0434\u043a\u0430\u0436\u0430\u0448: &laquo;\u042f&raquo;, \u0411\u043e\u0433 \u0441\u043a\u0430\u0436\u0430 \u0442\u0430\u0431\u0435: &laquo;\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0445\u043e\u0447\u0430\u0448 \u043c\u0435\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0441\u0446\u0435\u0440\u0430\u0436\u044b \u044f\u0437\u044b\u043a \u0441\u0432\u043e\u0439 \u0430\u0434 \u0437\u043b\u043e\u0433\u0430 \u0456 \u0432\u0443\u0441\u043d\u044b \u0441\u0432\u0430\u0435 \u0430\u0434 \u0441\u043b\u043e\u0432\u0430\u045e \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u044b\u0445, \u0430\u0434\u0432\u044f\u0440\u043d\u0456\u0441\u044f \u0430\u0434 \u0437\u043b\u0430 \u0456 \u0440\u0430\u0431\u0456 \u0434\u0430\u0431\u0440\u043e, \u0448\u0443\u043a\u0430\u0439 \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0442\u0440\u044b\u043c\u0430\u0439\u0441\u044f \u044f\u0433\u043e (\u043f\u0430\u0440. \u041f\u0441 34 [33], 14-15). \u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u0437\u0440\u043e\u0431\u0456\u0446\u0435, \u043c\u0430\u0435 \u0432\u043e\u0447\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u044f \u043d\u0430 \u0432\u0430\u0441, \u0430 \u0432\u0443\u0448\u044b \u043c\u0430\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u044f \u043d\u0430 \u0432\u0430\u0448\u044b\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b. \u0406 \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u043f\u0430\u043a\u043b\u0456\u0447\u0430\u0446\u0435 \u041c\u044f\u043d\u0435, \u042f \u0430\u0434\u043a\u0430\u0436\u0443: &ldquo;\u0412\u043e\u0441\u044c \u042f&rdquo;&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0436 \u0434\u043b\u044f \u043d\u0430\u0441 \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u0430\u0435, \u0434\u0430\u0440\u0430\u0433\u0456\u044f \u0431\u0440\u0430\u0442\u044b, \u0437\u0430 \u0433\u044d\u0442\u0430\u0435 \u0437\u0430\u043f\u0440\u0430\u0448\u044d\u043d\u043d\u0435? \u0423 \u0441\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456 \u041f\u0430\u043d \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430\u043c \u0434\u0430\u0440\u043e\u0433\u0443 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0430\u0434\u043f\u044f\u0440\u044d\u0436\u0430\u043c \u0441\u0446\u0451\u0433\u043d\u044b \u0432\u0435\u0440\u0430\u0439 \u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0441\u0446\u0435\u0436\u043a\u0430\u043c\u0456 \u041f\u0430\u043d\u0430 \u043f\u0430\u0434 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u043a\u0430\u0431 \u043c\u044b \u0431\u044b\u043b\u0456 \u0433\u043e\u0434\u043d\u044b\u044f \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043d\u0430\u0441 \u0443 \u0441\u0432\u0430\u0451 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u041a\u0430\u043b\u0456 \u043c\u044b \u043f\u0440\u0430\u0433\u043d\u0435\u043c \u043f\u0430\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u0456 \u045e \u0421\u0432\u044f\u0442\u044b\u043d\u0456 \u041f\u0430\u043d\u0430, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u0435\u0433\u0447\u044b \u0434\u0430\u0440\u043e\u0433\u0430\u044e \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u0431\u043e \u0456\u043d\u0430\u043a\u0448 \u0442\u0443\u0434\u044b \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0456\u0441\u043d\u0443\u0435 \u0437\u043b\u0430\u044f \u0456 \u0433\u043e\u0440\u043a\u0430\u044f \u0437\u0430\u045e\u0437\u044f\u0442\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0430\u0434\u0434\u0430\u043b\u044f\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430 \u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u043f\u0435\u043a\u043b\u0430, \u0442\u0430\u043a \u0456\u0441\u043d\u0443\u0435 \u0456 \u0434\u043e\u0431\u0440\u0430\u044f \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0430\u0434\u0434\u0430\u043b\u044f\u0435 \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u041d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u0430\u044f \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435 \u043c\u0430\u043d\u0430\u0445\u0430\u045e, \u043d\u044f\u0445\u0430\u0439 \u0436\u044b\u0432\u0435 \u045e \u0456\u0445 \u0430\u0434\u0434\u0430\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e, \u043a\u0430\u0431 \u0443 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0456 \u0437\u044b\u0447\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u044f\u043d\u044b \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e. \u041d\u044f\u0445\u0430\u0439 \u0441\u0432\u0430\u0435 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u044f \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u0437\u043d\u043e\u0441\u044f\u0446\u044c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430. \u041d\u044f\u0445\u0430\u0439 \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u044e\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043b\u0456\u0447\u044b\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u0431\u043e\u043b\u044c\u0448 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0435 \u0434\u043b\u044f \u0456\u043d\u0448\u0430\u0433\u0430. \u041d\u044f\u0445\u0430\u0439 \u0443\u0437\u0430\u0435\u043c\u043d\u0430 \u0430\u0434\u043e\u0440\u0432\u0430\u044e\u0446\u044c \u0441\u044f\u0431\u0435 \u0447\u044b\u0441\u0442\u0430\u0439 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e. \u041d\u044f\u0445\u0430\u0439 \u0431\u0430\u044f\u0446\u0446\u0430 \u0411\u043e\u0433\u0430 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043b\u044e\u0431\u044f\u0446\u044c \u042f\u0433\u043e. \u041d\u044f\u0445\u0430\u0439 \u043b\u044e\u0431\u044f\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u0430\u0442\u0430 \u0448\u0447\u044b\u0440\u0430\u0439 \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0448\u0442\u043e \u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0456\u0445 \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u044b\u043c \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041d\u044f\u0445\u0430\u0439 \u0401\u043d \u0437\u0430\u0445\u043e\u0447\u0430 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u043d\u0430\u0441 \u0440\u0430\u0437\u0430\u043c \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0432\u044f\u0442\u044b \u0411\u044d\u043d\u044d\u0434\u044b\u043a\u0442, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433\u0443, \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0434\u043e\u043c \u0456 \u0441\u044f\u043c\u0435\u0439\u043d\u044b \u043c\u0430\u0451\u043d\u0442\u0430\u043a \u0456 \u0448\u0443\u043a\u0430\u045e \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u043f\u043e\u045e\u043d\u0430\u0439 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u044b \u0436\u044b\u0446\u0446\u044f. <span style=\"color: #ff0000;\">*<\/span> \u041d\u0430 \u0441\u0430\u043c\u043e\u0446\u0435 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u045e \u0443 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u045e\u0441\u0451\u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0434\u044b\u0448\u043e\u045e, \u043f\u043e\u045e\u043d\u044b \u0432\u0435\u0434\u0430\u045e, \u0445\u043e\u0446\u044c \u043d\u0435 \u043c\u0435\u045e \u0430\u0434\u0443\u043a\u0430\u0446\u044b\u0456; \u0431\u044b\u045e \u043d\u0435\u0432\u0443\u043a\u0430\u043c, \u0430\u043b\u0435 \u043a\u0456\u0440\u0430\u0432\u0430\u043b\u0430 \u0456\u043c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430 \u0441\u0430\u043c\u043e\u0446\u0435 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u045e \u0443 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u045e\u0441\u0451\u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"691","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0421\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u044b \u0436\u044b\u0446\u0446\u044f\u0440\u044b\u0441 \u0441\u0432. \u0413\u0435\u043d\u0440\u044b\u0445\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(MGH, Scriptores 4, 792-799)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041a\u043b\u0430\u043f\u0430\u0446\u0456\u045e\u0441\u044f \u0430\u0431 \u0441\u043f\u0430\u043a\u043e\u0456 \u0456 \u0431\u044f\u0441\u043f\u0435\u0446\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u044f \u043d\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u0433\u044d\u0442\u044b \u0441\u0432\u044f\u0442\u044b \u0441\u043b\u0443\u0433\u0430 \u0411\u043e\u0436\u044b \u043d\u0435 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0456\u045e\u0441\u044f \u0430\u0431\u043c\u0435\u0436\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u044e \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f, \u0430\u043b\u0435 \u0434\u043b\u044f \u0437\u0434\u0430\u0431\u044b\u0446\u0446\u044f \u043a\u0430\u0440\u043e\u043d\u044b \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456 \u0432\u044b\u0431\u0440\u0430\u045e \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u043c\u0443 \u041a\u0430\u0440\u0430\u043b\u044e, \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u044f\u043a\u043e\u043c\u0443 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 &ndash; \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c. \u041f\u0440\u044b\u043a\u043b\u0430\u0434\u0432\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u0448\u044b\u0440\u044d\u043d\u043d\u044f \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0440\u044d\u043b\u0456\u0433\u0456\u0456; \u0430\u0431\u0441\u0442\u0430\u043b\u0451\u045e\u0432\u0430\u045e \u043a\u0430\u0441\u0446\u0451\u043b\u044b \u0456 \u0448\u0447\u043e\u0434\u0440\u0430 \u0456\u0445 \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u045e. \u0423 \u0441\u0432\u0430\u0456\u0445 \u0443\u043b\u0430\u0434\u0430\u043d\u043d\u044f\u0445, \u0443 \u0411\u0430\u043c\u0431\u0435\u0440\u0433\u0443, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u045e \u0431\u0456\u0441\u043a\u0443\u043f\u0441\u0442\u0432\u0430 \u043f\u0430\u0434 \u0442\u044b\u0442\u0443\u043b\u0430\u043c \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u041f\u044f\u0442\u0440\u0430 \u0456 \u041f\u0430\u045e\u043b\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043b\u0430\u045e\u043d\u0430\u0433\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430, \u0441\u0432. \u042e\u0440\u044b\u044f. \u0410\u0441\u043e\u0431\u043d\u0430\u0439 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0430\u044e \u0430\u0434\u0434\u0430\u045e \u044f\u0433\u043e \u043f\u0430\u0434 \u0430\u043f\u0435\u043a\u0443 \u0441\u0432\u044f\u0442\u043e\u043c\u0443 \u0420\u044b\u043c\u0441\u043a\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0445\u0430\u0446\u0435\u045e \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u0432\u0430\u044e \u043f\u0430\u0432\u0430\u0433\u0443 \u0434\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0439 \u0421\u0442\u0430\u043b\u0456\u0446\u044b, \u044f\u043a\u0430\u044f \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0451\u0439 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0437\u0430\u043a\u043e\u043d\u0443, \u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0444\u0443\u043d\u0434\u0430\u0446\u044b\u044e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0442\u0430\u043a\u043e\u0439 \u0441\u043b\u0430\u0432\u0443\u0442\u0430\u0439 \u0430\u043f\u0435\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043a\u0430\u0431 \u0443\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c \u0441\u0442\u0430\u043b\u0430 \u0432\u044f\u0434\u043e\u043c\u0430, \u0437 \u044f\u043a\u043e\u0439 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0431 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u0456, \u0433\u044d\u0442\u044b \u0441\u0432\u044f\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u045e\u0441\u044f \u0430\u0431 \u0441\u043f\u0430\u043a\u043e\u0456 \u0456 \u0431\u044f\u0441\u043f\u0435\u0446\u044b \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u043d\u0430\u043d\u043e\u0432\u0430 \u043a\u0430\u0441\u0446\u0451\u043b\u0430, \u0437\u043c\u044f\u0448\u0447\u0430\u0435\u043c \u0442\u0443\u0442 \u043b\u0456\u0441\u0442, \u044f\u043a\u0456 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435:<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0413\u0435\u043d\u0440\u044b\u0445, \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u0411\u043e\u0436\u0430\u0433\u0430 \u041f\u0440\u043e\u0432\u0456\u0434\u0443, \u043a\u0430\u0440\u043e\u043b\u044c, \u0443\u0441\u0456\u043c \u0434\u0437\u0435\u0446\u044f\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456\u043c \u0456 \u0431\u0443\u0434\u0443\u0447\u044b\u043c. \u0417\u0431\u0430\u045e\u0447\u044b\u044f \u043d\u0430\u043a\u0430\u0437\u044b \u041f\u0456\u0441\u0430\u043d\u043d\u044f \u0432\u0443\u0447\u0430\u0446\u044c \u043d\u0430\u0441 \u0456 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u044e\u0446\u044c, \u043a\u0430\u0431 \u043c\u044b, \u0430\u0434\u0440\u044b\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u0430\u0434 \u0437\u044f\u043c\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e \u0456 \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u0432\u044b\u0433\u043e\u0434\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0456\u043c\u043a\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0456 \u043d\u0435\u043f\u0440\u0430\u043c\u0456\u043d\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0436\u044b\u043b\u043b\u044f \u045e \u043d\u0435\u0431\u0435. \u0411\u043e \u0445\u0432\u0430\u043b\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0447\u0430\u0441\u043e\u0432\u0430\u044f \u0456 \u043c\u0430\u0440\u043d\u0430\u044f, \u043a\u0430\u043b\u0456, \u043c\u0430\u044e\u0447\u044b \u044f\u0435, \u043c\u044b \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u043c \u043f\u0440\u0430 \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c \u0443 \u043d\u0435\u0431\u0435. \u0411\u043e\u0433 \u0443 \u0441\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0440\u043e\u0434\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u043c\u0443 \u043d\u0435\u043c\u0430\u043b\u0443\u044e \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443, \u043a\u0430\u043b\u0456 \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e, \u0448\u0442\u043e \u0437\u044f\u043c\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u043d\u0430\u0441 \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u044f\u0442\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u0434\u0430\u0431\u0440\u044b\u043d\u044e \u041f\u0430\u043d\u0430 \u0456 \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u043c\u044b \u0431\u044b\u043b\u0456 \u045e\u0437\u043d\u0435\u0441\u0435\u043d\u044b\u044f \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u043c\u044b \u043f\u0430\u043b\u0456\u0447\u044b\u043b\u0456 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0448\u044b\u0440\u044b\u0446\u044c \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b\u044f \u043d\u0430\u0448\u044b\u043c\u0456 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u043c\u0456 \u043a\u0430\u0441\u0446\u0451\u043b\u044b, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c \u043d\u043e\u0432\u044b\u044f \u0434\u0437\u0435\u043b\u044f \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0445\u0432\u0430\u043b\u044b \u0411\u043e\u0433\u0430 \u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u0446\u044c \u0456\u0445 \u0434\u0430\u0440\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0431 \u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456 \u043f\u0440\u0430 \u043d\u0430\u0448\u0443\u044e \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0456 \u045e\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044c. \u0422\u0430\u043c\u0443 \u045e\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u0441\u043b\u0443\u0445\u0430\u044e\u0447\u044b \u043d\u0430\u043a\u0430\u0437\u044b \u041f\u0430\u043d\u0430 \u0456 \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u0411\u043e\u0436\u044b\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u043c, \u043c\u044b \u0445\u043e\u0447\u0430\u043c \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u0443 \u043d\u0435\u0431\u0435 \u0441\u043a\u0430\u0440\u0431\u044b, \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u044f \u043d\u0430\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u0456, \u0434\u0437\u0435 \u0437\u043b\u043e\u0434\u0437\u0435\u0456 \u043d\u0435 \u045e\u043b\u0430\u043c\u0432\u0430\u044e\u0446\u0446\u0430 \u0456 \u043d\u0435 \u043a\u0440\u0430\u0434\u0443\u0446\u044c, \u0434\u0437\u0435 \u043d\u0456 \u0440\u0436\u0430, \u043d\u0456 \u043c\u043e\u043b\u044c \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u0435. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0446\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u0442\u0430\u043c \u0441\u0430\u0431\u0440\u0430\u043b\u0456, \u0442\u0430\u0434\u044b \u0437 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0456 \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u043d\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0441\u043a\u0456\u0440\u0443\u0435\u0446\u0446\u0430 \u0434\u0430 \u043d\u0435\u0431\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u0433\u043d\u0435\u043c \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u0446\u044c \u0443\u0441\u0456\u043c \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u043c, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0439 \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0430\u0434 \u043f\u0440\u043e\u0434\u043a\u0430\u045e \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u0456, \u0433\u044d\u0442\u0430\u043a \u0437\u0432\u0430\u043d\u0430\u043c\u0443 \u0411\u0430\u043c\u0431\u0435\u0440\u0433\u0443, \u043c\u044b \u043d\u0430\u0434\u0430\u0451\u043c \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0431\u0456\u0441\u043a\u0443\u043f\u0441\u043a\u0430\u0439 \u0441\u0442\u0430\u043b\u0456\u0446\u044b. \u0416\u0430\u0434\u0430\u0435\u043c, \u043a\u0430\u0431 \u0442\u0430\u043c \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u045e\u0441\u043f\u0430\u043c\u0456\u043d \u043f\u0440\u0430 \u043d\u0430\u0441 \u0441\u0430\u043c\u044b\u0445 \u0456 \u043f\u0440\u0430 \u043d\u0430\u0448\u044b\u044f \u0441\u0435\u043c&rsquo;\u0456 \u0456 \u043a\u0430\u0431 \u0448\u0442\u043e\u0434\u043d\u044f \u0437\u0430 \u045e\u0441\u0456\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u0430\u0441\u044f \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u044f \u0410\u0445\u0432\u044f\u0440\u0430&raquo;.<\/p>\r\n"}, {"GCH_CH_2_ID":"692","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0416\u044b\u0446\u0446\u044f\u0440\u044b\u0441 \u0441\u0432. \u041a\u0430\u043c\u0456\u043b\u0430&raquo;, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u044b \u044f\u0433\u043e \u043f\u0430\u043f\u043b\u0435\u0447\u043d\u0456\u043a\u0430\u043c<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(S. Cicatelli, Vita del P. Camillo de Lellis, Veterbo, 1615)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0421\u043b\u0443\u0436\u044b\u045e \u041f\u0430\u043d\u0443 \u045e \u0431\u0440\u0430\u0442\u0430\u0445<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0441\u043f\u0430\u0447\u043d\u0443 \u0430\u0434 \u0441\u0432\u044f\u0442\u043e\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u044f\u043a \u043a\u043e\u0440\u0430\u043d\u044f \u045e\u0441\u0456\u0445 \u0446\u043d\u043e\u0442\u0430\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u0430\u0433\u0430 \u0434\u0430\u0440\u0443 \u041a\u0430\u043c\u0456\u043b\u0430. \u041d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u0430\u043b\u0435 \u0456 \u043f\u0435\u0440\u0430\u0434 \u0431\u043b\u0456\u0436\u043d\u0456\u043c\u0456, \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0445\u0432\u043e\u0440\u044b\u043c\u0456, \u0451\u043d \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u044b\u045e \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0430\u0433\u043d\u0451\u043c \u0433\u044d\u0442\u0430\u0439 \u0446\u043d\u043e\u0442\u044b, \u0448\u0442\u043e \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c \u0432\u044b\u0433\u043b\u044f\u0434 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u0445 \u0430\u0431\u0443\u0434\u0436\u0430\u045e \u0443 \u044f\u0433\u043e\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u044b \u0436\u0430\u043b\u044c, \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u0435, \u0437\u0430\u0431\u044b\u0446\u0446\u0451 \u0430\u0431 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044f\u0445, \u0437\u0430\u0431\u0430\u0432\u0430\u0445 \u0456 \u0437\u044f\u043c\u043d\u044b\u0445 \u043f\u0440\u044b\u0432\u044f\u0437\u0430\u043d\u0430\u0441\u0446\u044f\u0445. \u041a\u0430\u043b\u0456 \u0451\u043d \u0441\u043b\u0443\u0436\u044b\u045e \u0445\u0432\u043e\u0440\u0430\u043c\u0443, \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u045e \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430\u0439 \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430\u0441\u0446\u0456 \u0456 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u0456 \u0451\u043d \u0446\u0430\u043b\u043a\u0430\u043c \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u045e \u044f\u043c\u0443 \u0441\u044f\u0431\u0435 \u0456 \u0437\u0433\u0430\u0440\u0430\u045e. \u0401\u043d \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u045e \u0431\u044b \u043d\u0430 \u0441\u044f\u0431\u0435 \u0445\u0432\u0430\u0440\u043e\u0431\u044b \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0456\u043d\u0448\u0430\u0435 \u0437\u043b\u043e, \u043a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u043b\u0430\u0433\u043e\u0434\u0437\u0456\u0446\u044c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0456\u043d\u0448\u044b\u0445 \u0456 \u0430\u0434\u0445\u0456\u043b\u0456\u0446\u044c \u0430\u0434 \u0456\u0445 \u043d\u0435\u043c\u0430\u0447.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0436\u044b\u0432\u0430 \u045e\u044f\u045e\u043b\u044f\u045e \u0441\u0430\u0431\u0435 \u045e \u0456\u0445 \u0425\u0440\u044b\u0441\u0442\u0430, \u0448\u0442\u043e \u043d\u0435\u0430\u0434\u043d\u043e\u0439\u0447\u044b, \u043f\u0430\u0434\u0430\u044e\u0447\u044b \u0435\u0436\u0443, \u0437\u0432\u044f\u0440\u0442\u0430\u045e\u0441\u044f \u0434\u0430 \u0456\u0445 \u044f\u043a \u0434\u0430 \u041f\u0430\u043d\u0430, \u0456 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u0448\u0442\u043e \u043f\u0440\u0430\u0441\u0456\u045e \u0456\u0445 \u0430\u0431 \u043b\u0430\u0441\u0446\u044b \u0456 \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u043d\u0456 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e. \u0410\u043a\u0430\u0437\u0432\u0430\u045e \u0456\u043c \u0442\u0430\u043a\u0443\u044e \u043f\u0430\u0432\u0430\u0433\u0443, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u043c\u0443 \u0441\u0432\u0430\u0439\u043c\u0443 \u041f\u0430\u043d\u0443. \u0423 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0439 \u0456\u043d\u0448\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u043d\u0435 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0442\u0430\u043a \u0447\u0430\u0441\u0442\u0430 \u0456 \u0448\u0447\u044b\u0440\u0430, \u044f\u043a \u0443 \u0441\u043f\u0440\u0430\u0432\u0435 \u0441\u0432\u044f\u0442\u043e\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u0433\u043e\u0440\u0430\u0447\u0430 \u043f\u0440\u044b\u0448\u0447\u0430\u043f\u0456\u0446\u044c \u044f\u0435 \u045e \u0441\u044d\u0440\u0446\u044b \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u0441\u0430\u0431\u0440\u0430\u0442\u043e\u045e \u0434\u0430 \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u043d\u043d\u044f \u0433\u044d\u0442\u0430\u0439 \u0432\u0435\u043b\u044c\u043c\u0456 \u0432\u0430\u0436\u043d\u0430\u0439 \u0446\u043d\u043e\u0442\u044b, \u043b\u044e\u0431\u0456\u045e \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u0446\u044c \u0456\u043c \u043f\u043e\u045e\u043d\u044b\u044f \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u0441\u043b\u043e\u0432\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430: &laquo;\u0411\u044b\u045e \u0445\u0432\u043e\u0440\u044b, \u0456 \u0432\u044b \u0430\u0434\u0432\u0435\u0434\u0430\u043b\u0456 \u041c\u044f\u043d\u0435&raquo; (\u041c\u0446 25, 36). \u0417\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u044b\u043b\u0456 \u0432\u044b\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u045e \u044f\u0433\u043e\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u044b. \u0401\u043d \u0442\u0430\u043a \u0447\u0430\u0441\u0442\u0430 \u0432\u044b\u043c\u0430\u045e\u043b\u044f\u045e \u0456\u0445, \u0442\u0430\u043a \u0447\u0430\u0441\u0442\u0430 \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0431\u043e\u045e \u041a\u0430\u043c\u0456\u043b\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0456 \u0448\u044b\u0440\u043e\u043a\u0430\u0439, \u0448\u0442\u043e \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u0441\u0446\u044e \u0456 \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430\u0441\u0446\u044e \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u045e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0445\u0432\u043e\u0440\u044b\u0445 \u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b\u0445, \u0430\u043b\u0435 \u045e\u0432\u043e\u0433\u0443\u043b\u0435 \u045e\u0441\u0456\u0445 \u0443\u0431\u043e\u0433\u0456\u0445 \u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u0445. \u042f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0431\u044b\u043b\u043e \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0451\u0439 \u0434\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u0445, \u0448\u0442\u043e \u0451\u043d \u0447\u0430\u0441\u0442\u0430 \u043b\u044e\u0431\u0456\u045e \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u0446\u044c: &laquo;\u041a\u0430\u043b\u0456 \u0431 \u0443 \u0441\u0432\u0435\u0446\u0435 \u045e\u0432\u043e\u0433\u0443\u043b\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u045e\u0431\u043e\u0433\u0456\u0445, \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u0431 \u043f\u0430\u0441\u0442\u0430\u0440\u0430\u0446\u0446\u0430 \u0456\u0445 \u0437\u043d\u0430\u0439\u0441\u0446\u0456, \u0431\u044b\u0446\u0446\u0430\u043c \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u0437 \u0437\u044f\u043c\u043b\u0456, \u0434\u043b\u044f \u0430\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u044f \u0456\u043c \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u0422\u044d\u0441 5, 14. 15b. 18b; \u0420\u044b\u043c 15, 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u043f\u044f\u043a\u0443\u0439\u0446\u0435\u0441\u044f \u0445\u0432\u043e\u0440\u044b\u043c\u0456, \u0440\u0430\u0431\u0456\u0446\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443 \u0456 \u045e\u0441\u0456\u043c \u0434\u0430\u0431\u0440\u043e, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0442\u0430\u043a\u0430\u044f \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0432\u0430\u0441 \u0432\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u044f \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u043c\u0430\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043d\u044f\u045e \u0432\u0430\u0441 \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u0411\u043e\u0436\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0442\u0430\u043a\u0430\u044f \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0432\u0430\u0441 \u0432\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u044f \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"693","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0432\u043e\u0440 &laquo;\u0428\u043b\u044f\u0445 \u0434\u0443\u0448\u044b \u0434\u0430 \u0411\u043e\u0433\u0430&raquo; \u0441\u0432. \u0411\u043e\u043d\u0430\u0432\u044d\u043d\u0442\u0443\u0440\u044b, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 7, 1. 2. 4. 6: Opera omnia, 5, 312-313)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u0456\u0441\u0442\u044b\u0447\u043d\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0430\u0431&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0434\u0430\u0440\u043e\u0433\u0430 \u0456 \u0431\u0440\u0430\u043c\u0430. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0443\u0437\u044b\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435 \u0456 \u0432\u0430\u043d\u0434\u0440\u0430\u0432\u0430\u043d\u043d\u0435. \u0401\u043d &ndash; \u0430\u043b\u0442\u0430\u0440 \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u043d\u0430 \u0411\u043e\u0436\u044b\u043c \u043a\u0430\u045e\u0447\u044d\u0433\u0443 (\u043f\u0430\u0440. \u0417\u044b\u0445 26, 34) \u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430, \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u044f \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443 (\u043f\u0430\u0440. \u042d\u0444 3, 9). \u0425\u0442\u043e \u0437 \u043f\u043e\u045e\u043d\u044b\u043c \u0430\u0434\u0434\u0430\u043d\u043d\u0435\u043c \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0430\u043b\u0442\u0430\u0440\u0430 \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u044f, \u0445\u0442\u043e \u045e\u0433\u043b\u044f\u0434\u0430\u0435\u0446\u0446\u0430 \u0432\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0437 \u0432\u0435\u0440\u0430\u0439 \u0456 \u043d\u0430\u0434\u0437\u0435\u044f\u0439, \u043b\u044e\u0431\u043e\u045e\u044e \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044e, \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u0435\u043c \u0456 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044e, \u043f\u0430\u0448\u0430\u043d\u0430\u0439, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c, \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0442\u043e\u0439 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u043f\u0435\u0440\u0430\u0436\u044b\u0432\u0430\u0435 \u041f\u0430\u0441\u0445\u0443, \u0430\u0431\u043e \u0456\u043d\u0430\u043a\u0448 \u043f\u0435\u0440\u0430\u0445\u043e\u0434. \u0420\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0435 \u043c\u043e\u0440\u0430, \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u043d\u0430 \u043a\u0456\u0439 \u043a\u0440\u044b\u0436\u0430. \u041f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0415\u0433\u0456\u043f\u0435\u0442, \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u043f\u0443\u0441\u0442\u044b\u043d\u044e, \u0434\u0437\u0435 \u043a\u0430\u0448\u0442\u0443\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0447\u0443\u044e \u043c\u0430\u043d\u043d\u0443; \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0435 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u043c\u0430\u0433\u0456\u043b\u0435 \u044f\u043a \u043f\u0430\u043c\u0435\u0440\u043b\u044b \u0434\u043b\u044f \u0441\u043f\u0440\u0430\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0410\u0434\u043d\u0430\u043a \u0430\u0434\u0447\u0443\u0432\u0430\u0435, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u043d\u0430 \u0433\u044d\u0442\u0430 \u0441\u0442\u0430\u043d \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0430\u0432\u0430\u043d\u043d\u044f, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0441\u0446\u0456 \u0441\u043b\u043e\u0432\u0430\u045e, \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u0445 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0443: &laquo;\u0421\u0451\u043d\u043d\u044f \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u0430 \u041c\u043d\u043e\u044e \u045e \u0440\u0430\u0456&raquo; (\u041b\u043a 23, 43).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u0433\u044d\u0442\u044b \u043f\u0435\u0440\u0430\u0445\u043e\u0434 \u0431\u044b\u045e \u043f\u043e\u045e\u043d\u044b\u043c, \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0443\u0441\u0435 \u0456\u043d\u0442\u044d\u043b\u0435\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u044f \u043f\u043e\u0448\u0443\u043a\u0456, \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u0446\u044c \u0456 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0434\u0430 \u0411\u043e\u0433\u0430 \u043a\u043e\u0436\u043d\u044b \u0440\u0443\u0445 \u0441\u044d\u0440\u0446\u0430. \u0413\u044d\u0442\u0430 \u0456 \u0451\u0441\u0446\u044c \u043c\u0456\u0441\u0442\u044b\u0447\u043d\u0430\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0451, \u044f\u043a\u043e\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u045e \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0434\u0443\u0448\u044b. \u0413\u044d\u0442\u0430\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0445\u0456\u0431\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0433\u044d\u0442\u044b \u0434\u0430\u0440. \u0406 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0435, \u0430 \u043f\u0440\u0430\u0433\u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0430\u0433\u043e\u043d\u044c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0442\u043e\u0439 \u0430\u0433\u043e\u043d\u044c, \u044f\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e. \u0412\u043e\u0441\u044c \u0447\u0430\u043c\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0433\u044d\u0442\u0443\u044e \u043c\u0456\u0441\u0442\u044b\u0447\u043d\u0443\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0430\u0431&rsquo;\u044f\u045e\u043b\u044f\u0435 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448 \u0432\u0435\u0434\u0430\u0446\u044c, \u044f\u043a \u0433\u044d\u0442\u0430 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430, \u0441\u043f\u044b\u0442\u0430\u0439 \u043b\u0430\u0441\u043a\u0443, \u0430 \u043d\u0435 \u0432\u0435\u0434\u044b, \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0435, \u0430 \u043d\u0435 \u0440\u043e\u0437\u0443\u043c, \u0433\u0430\u0440\u0430\u0447\u0443\u044e \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u0430 \u043d\u0435 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u043a\u043d\u0456\u0433\u0456, \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430, \u0430 \u043d\u0435 \u0432\u044b\u043a\u043b\u0430\u0434\u0447\u044b\u043a\u0430, \u0411\u043e\u0433\u0430, \u0430 \u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443, \u0430 \u043d\u0435 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c, \u043d\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0430\u043b\u0435 \u0430\u0433\u043e\u043d\u044c, \u044f\u043a\u0456 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u0434\u0430 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0456 \u0436\u0430\u0440\u0430\u043c \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0439 \u0441\u043b\u043e\u0434\u044b\u0447\u0447\u0443 \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u043a\u0443\u043d\u0430\u0435 \u045e \u0411\u043e\u0433\u0443. \u0413\u044d\u0442\u044b\u043c \u0430\u0433\u043d\u0451\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0433, \u0432\u043e\u0433\u043d\u0456\u0448\u0447\u0430\u043c &ndash; \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c. \u0417\u0430\u043f\u0430\u043b\u0456\u045e \u044f\u0433\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u044f\u043a\u0443\u0447\u044b\u043c \u043f\u043e\u043b\u044b\u043c\u0435\u043c \u0441\u0432\u0430\u0451\u0439 \u041c\u0443\u043a\u0456. \u0422\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439 \u044f\u0433\u043e \u0430\u0434\u0447\u0443\u0432\u0430\u0435, \u0445\u0442\u043e \u043a\u0430\u0436\u0430: &laquo;\u041c\u0430\u044f \u0434\u0443\u0448\u0430 \u0432\u044b\u0431\u0440\u0430\u043b\u0430 \u043a\u0440\u044b\u0436, \u0430 \u043c\u0430\u0435 \u043a\u043e\u0441\u0442\u043a\u0456 &ndash; \u0441\u043c\u0435\u0440\u0446\u044c&raquo; (\u043f\u0430\u0440. \u0401\u045e 7, 15). \u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c, \u0442\u043e\u0439 \u043c\u043e\u0436\u0430 \u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430, \u0431\u043e \u043f\u0440\u0430\u045e\u0434\u0430\u0439 \u0451\u0441\u0446\u044c, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0436\u044b\u0432\u044b\u043c (\u043f\u0430\u0440. \u0417\u044b\u0445 33, 20). \u0422\u0430\u043c\u0443 \u043f\u0430\u043c\u0440\u043e\u043c, \u0443\u0432\u043e\u0439\u0434\u0437\u0435\u043c \u0443 \u0446\u0435\u043c\u0440\u0443, \u0437\u0430\u0433\u0430\u0434\u0430\u0435\u043c \u0437\u043c\u043e\u045e\u043a\u043d\u0443\u0446\u044c \u0442\u0443\u0440\u0431\u043e\u0442\u0430\u043c, \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0456\u043b\u044e\u0437\u0456\u044f\u043c. \u041f\u044f\u0440\u043e\u0439\u0434\u0437\u0435\u043c \u0437 \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c &laquo;\u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0434\u0430 \u0410\u0439\u0446\u0430&raquo;, \u043a\u0430\u0431, \u0443\u0433\u043b\u044f\u0434\u0430\u044e\u0447\u044b\u0441\u044f \u045e \u0410\u0439\u0446\u0430, \u043c\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0424\u0456\u043b\u0456\u043f\u0430\u043c \u043c\u0430\u0433\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u0425\u043e\u043f\u0456\u0446\u044c \u043d\u0430\u043c&raquo; (\u042f\u043d 14, 8). \u041f\u0430\u0447\u0443\u0435\u043c \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432. \u041f\u0430\u045e\u043b\u0430\u043c: &laquo;\u0425\u043e\u043f\u0456\u0446\u044c \u0442\u0430\u0431\u0435 \u041c\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456&raquo; (2 \u041a\u0430\u0440 12, 9), \u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0414\u0430\u0432\u0456\u0434\u0430\u043c \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0439\u043c\u0430: &laquo;\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u041f\u0430\u043d, \u0411\u043e\u0433 \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443 \u0456 \u043d\u0430\u0432\u0435\u043a\u0456. \u0410 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u043d\u044f\u0445\u0430\u0439 \u0441\u043a\u0430\u0436\u0430: &ldquo;\u0410\u043c\u044d\u043d&rdquo;&raquo; (\u041f\u0441 106 [105], 48).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 3, 24; \u0421\u0456\u0440 1, 9\u0430. 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0411\u043e\u0433\u0430, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u045e \u0406\u043c, \u0430 \u0401\u043d \u0443 \u0456\u043c. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u043f\u0430 \u0414\u0443\u0445\u0443, \u044f\u043a\u043e\u0433\u0430 \u0434\u0430\u045e \u043d\u0430\u043c, \u043c\u044b \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u0401\u043d \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0441\u0430\u043c \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0443 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c \u0456 \u043f\u0440\u0430\u043b\u0456\u045e \u044f\u0435 \u043d\u0430 \u045e\u0441\u0435 \u0441\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044b, \u0456 \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u0451\u044e \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043f\u0430 \u0414\u0443\u0445\u0443, \u044f\u043a\u043e\u0433\u0430 \u0434\u0430\u045e \u043d\u0430\u043c, \u043c\u044b \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u0401\u043d \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441.<\/p>\r\n"}, {"GCH_CH_2_ID":"694","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 1 in Nativitate Domini, 2. 3: PL 54, 191-192)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u0430\u0440\u044b\u044f \u043f\u0435\u0440\u0448 \u0437\u0430\u0447\u0430\u043b\u0430 \u045e \u0434\u0443\u0445\u0443, \u0447\u044b\u043c \u0443 \u0446\u0435\u043b\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0433\u0430 \u0440\u043e\u0434\u0443 \u0414\u0430\u0432\u0456\u0434\u0430 \u0431\u044b\u043b\u0430 \u0432\u044b\u0431\u0440\u0430\u043d\u0430 \u0414\u0437\u0435\u0432\u0430. \u041f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430\u044f \u0434\u043b\u044f \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u043c\u0430\u0446\u044f\u0440\u044b\u043d\u0441\u0442\u0432\u0430, \u042f\u043d\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u0430 \u0437\u0430\u0447\u0430\u0446\u044c \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u044c \u0421\u044b\u043d\u0430, \u0411\u043e\u0433\u0430 \u0456 \u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043f\u0435\u0440\u0448 \u0443 \u0434\u0443\u0445\u0443, \u0447\u044b\u043c \u0443 \u0446\u0435\u043b\u0435. \u041a\u0430\u0431, \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u043c\u0435\u0440\u0443, \u042f\u043d\u0430 \u043d\u0435 \u0441\u043f\u0443\u0436\u0430\u043b\u0430\u0441\u044f \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u0437&rsquo;\u044f\u0432\u044b, \u0430\u043d\u0451\u043b \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0443 \u0401\u0439 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b. \u0422\u0430\u044f, \u044f\u043a\u0430\u044f \u045e \u0445\u0443\u0442\u043a\u0456\u043c \u0447\u0430\u0441\u0435 \u043c\u0430\u0435 \u0441\u0442\u0430\u0446\u044c \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0430\u0439, \u0432\u0435\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u042f\u0435 \u0434\u0437\u044f\u0432\u043e\u0447\u0430\u044f \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u043d\u0435 \u0437\u0432\u0435\u0434\u0430\u0435 \u0448\u043a\u043e\u0434\u044b. \u0414\u044b \u0456 \u0447\u0430\u043c\u0443 \u042f\u043d\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u0430 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430 \u045e \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0441\u0446\u0456 \u0437\u0430\u0447\u0430\u0446\u0446\u044f, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448, \u043a\u0430\u043b\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u043d\u043d\u0435, \u0448\u0442\u043e \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u043e\u0446\u044b \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430. \u042f\u0435 \u043c\u043e\u0446\u043d\u0443\u044e \u0432\u0435\u0440\u0443 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u044b \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0446\u0443\u0434: \u0410\u043b\u044c\u0436\u0431\u0435\u0442\u0430 \u043d\u0435\u0447\u0430\u043a\u0430\u043d\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043c\u0430\u0446\u0456. \u0422\u043e\u0439, \u0445\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u043d\u044f\u043f\u043b\u043e\u0434\u043d\u0443\u044e \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0439 \u0437\u0430\u0447\u0430\u0446\u044c, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043c\u043e\u0436\u0430 \u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0433\u044d\u0442\u0430\u0439 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044e \u0456 \u0434\u0437\u0435\u0432\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430, \u0411\u043e\u0433 \u0456 \u0421\u044b\u043d \u0411\u043e\u0436\u044b, \u0442\u043e\u0439, \u044f\u043a\u0456 \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u045e \u0443 \u0411\u043e\u0433\u0430 \u0456 \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u045e\u0441\u0451 \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u0456 \u0431\u0435\u0437 \u044f\u043a\u043e\u0433\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u044f (\u043f\u0430\u0440. \u042f\u043d 1, 1-2), \u0441\u0442\u0430\u045e\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0434\u0437\u0435\u043b\u044f \u0432\u044b\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0430\u0434 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456. \u041f\u0440\u044b\u043d\u044f\u045e \u043d\u0430\u0448\u0443\u044e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c, \u043d\u0435 \u043f\u0430\u0440\u0443\u0448\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u043b\u0456\u0447\u044b. \u0417\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u043a\u0456\u043c \u0431\u044b\u045e, \u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0447\u044b\u0441\u044f \u043a\u0456\u043c \u043d\u0435 \u0431\u044b\u045e, \u0437\u043b\u0443\u0447\u044b\u045e \u043d\u0430\u0442\u0443\u0440\u0443 \u0441\u043b\u0443\u0433\u0456 \u0437 \u043d\u0430\u0442\u0443\u0440\u0430\u0439, \u0440\u043e\u045e\u043d\u0430\u0439 \u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443. \u0410\u0431\u0435\u0434\u0437\u0432\u0435 \u043d\u0430\u0442\u0443\u0440\u044b \u0437&rsquo;\u044f\u0434\u043d\u0430\u045e \u0442\u0430\u043a\u0456\u043c \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c, \u0448\u0442\u043e \u043d\u0456 \u043d\u0456\u0436\u044d\u0439\u0448\u0443\u044e \u043d\u0435 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u0432\u0435\u043b\u0456\u0447, \u0434\u0430 \u044f\u043a\u043e\u0439 \u0431\u044b\u043b\u0430 \u045e\u0437\u043d\u0435\u0441\u0435\u043d\u0430, \u043d\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u044f\u0435 \u045e\u0437\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u043d\u0435 \u0437\u043c\u0435\u043d\u0448\u044b\u043b\u0430 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0430\u0434\u043d\u043e\u0439 \u0430\u0441\u043e\u0431\u0435 \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u044e\u0446\u0446\u0430 \u043d\u044f\u0437\u043c\u0435\u043d\u043d\u044b\u044f \u0440\u044b\u0441\u044b \u0430\u0431\u0435\u0434\u0437\u0432\u044e\u0445 \u043d\u0430\u0442\u0443\u0440: \u0432\u0435\u043b\u0456\u0447 \u043f\u0440\u044b\u043c\u0430\u0435 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c, \u043c\u043e\u0446 &ndash; \u043d\u0435\u043c\u0430\u0447, \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c &ndash; \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c. \u041a\u0430\u0431 \u0437\u0430\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u0434\u043e\u045e\u0433 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430, \u043d\u044f\u0437\u043c\u0435\u043d\u043d\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043b\u0430\u0441\u044f \u0437 \u043d\u0430\u0442\u0443\u0440\u0430\u0439, \u044f\u043a\u0430\u044f \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u0435 \u0437\u043c\u0435\u043d\u0430\u043c: \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0411\u043e\u0441\u0442\u0432\u0430 \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c \u043b\u0443\u0447\u0430\u0446\u0446\u0430 \u045e \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u041f\u0430\u043d\u0430. \u0422\u0430\u043a, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0442\u044b\u043c, \u0447\u0430\u0433\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u043d\u0430\u0448\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0442\u043e\u0439 \u0441\u0430\u043c\u044b &laquo;\u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456&raquo; (1 \u0426\u0456\u043c 2, 5) \u0437\u043c\u043e\u0433 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u044f\u043a\u0443\u044e \u043c\u0435\u045e, \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043d\u0430\u0442\u0443\u0440\u044b \u0411\u043e\u0441\u043a\u0430\u0439. \u0422\u0430\u043c\u0443 \u0441\u043b\u0443\u0448\u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043d\u0435 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u043d\u0456\u044f\u043a\u0430\u0439 \u0448\u043a\u043e\u0434\u044b \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0443, \u0431\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u043d\u0430 \u0441\u0432\u0435\u0442 \u041f\u0440\u0430\u045e\u0434\u044b \u0431\u044b\u043b\u043e \u0430\u0431\u0430\u0440\u043e\u043d\u0430\u0439 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0442\u0430\u043a\u0456\u044f, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0431\u044b\u043b\u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u043d\u044b, \u0433\u043e\u0434\u043d\u044b\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0436\u0430\u0439 \u043c\u043e\u0446\u0430\u044e \u0456 \u0411\u043e\u0436\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e (1 \u041a\u0430\u0440 1, 24). \u041f\u0440\u0430\u0437 \u0456\u0445 \u0401\u043d \u0441\u0442\u0430\u045e \u0440\u043e\u045e\u043d\u044b \u0437 \u043d\u0430\u043c\u0456 \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0441\u0442\u0432\u0430. \u0411\u043e \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0431\u044b\u045e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0411\u043e\u0433\u0430\u043c, \u043d\u0435 \u043c\u043e\u0433 \u0431\u044b \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0447\u044b\u0441\u044f \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u043d\u0435 \u043c\u043e\u0433 \u0431\u044b \u0441\u0442\u0430\u0446\u044c \u0434\u043b\u044f \u043d\u0430\u0441 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0447\u0430\u0441 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u043d\u0430\u045e \u041f\u0430\u043d\u0430 \u0430\u043d\u0451\u043b\u044b \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u0441\u043f\u044f\u0432\u0430\u044e\u0446\u044c: &laquo;\u0425\u0432\u0430\u043b\u0430 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u044f\u0445 \u0411\u043e\u0433\u0443&raquo; \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c &laquo;\u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u043b\u044e\u0434\u0437\u044f\u043c \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456&raquo; ( \u041b\u043a 2, 14). \u0411\u043e \u0431\u0430\u0447\u0430\u0446\u044c, \u044f\u043a \u0437 \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0437\u044f\u043c\u043b\u0456 \u0431\u0443\u0434\u0443\u0435\u0446\u0446\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0442\u0430\u043a\u0456\u043c \u043d\u0435\u0432\u044b\u043c\u043e\u045e\u043d\u044b\u043c \u0441\u043f\u0440\u0430\u0432\u0430\u043c \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0431\u0435\u0434\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456, \u043a\u0430\u043b\u0456 \u0442\u0430\u043a \u043c\u043e\u0446\u043d\u0430 \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u0456\u043c \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0430\u043d\u0451\u043b\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 3, 15; \u0413\u0430\u043b 3, 28; \u041f\u0441 149, 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u043b\u0435\u0436\u043d\u0430 \u045e\u0448\u0430\u043d\u0443\u0435\u043c \u0443\u0441\u043f\u0430\u043c\u0456\u043d \u0441\u043b\u0430\u045e\u043d\u0430\u0439 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456, \u043d\u0430 \u043f\u0430\u043a\u043e\u0440\u0443 \u044f\u043a\u043e\u0439 \u0433\u043b\u044f\u043d\u0443\u045e \u041f\u0430\u043d.<span style=\"color: #ff0000;\"> *<\/span> \u042f\u043d\u0430 \u043f\u0440\u0430\u0437 \u0430\u043d\u0451\u043b\u044c\u0441\u043a\u0430\u0435 \u0437\u0432\u0435\u0441\u0442\u0430\u0432\u0430\u043d\u043d\u0435 \u0437\u0430\u0447\u0430\u043b\u0430 \u0417\u0431\u0430\u045e\u0446\u0443 \u0441\u0432\u0435\u0442\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u043c\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u0433\u044d\u0442\u0443\u044e \u0441\u0432\u044f\u0442\u0443\u044e \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0433\u043e\u0434\u043d\u0430\u0439 \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u044f \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043d\u0430 \u043f\u0440\u0430\u0437 \u0430\u043d\u0451\u043b\u044c\u0441\u043a\u0430\u0435 \u0437\u0432\u0435\u0441\u0442\u0430\u0432\u0430\u043d\u043d\u0435 \u0437\u0430\u0447\u0430\u043b\u0430 \u0417\u0431\u0430\u045e\u0446\u0443 \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"695","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u0425\u0440\u044b\u0437\u0430\u043b\u043e\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 128, 1-3: \u0421\u0421L 24\u0410, 789-791)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u043e\u0441\u044c \u043c\u0443\u0447\u0430\u043d\u0456\u043a \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0456 \u0436\u044b\u0432\u0435<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432. \u0410\u043f\u0430\u043b\u0456\u043d\u0430\u0440\u044b\u0439 \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u045e \u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430\u043c. \u0417\u0433\u043e\u0434\u043d\u0430 \u0437 \u043d\u0430\u043a\u0430\u0437\u0430\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430 \u0430\u0434\u0434\u0430\u045e \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u044f\u0433\u043e \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443 \u0436\u044b\u0446\u0446\u0456 \u0431\u0443\u0434\u0443\u0447\u044b\u043c. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b, \u0445\u0442\u043e \u0442\u0430\u043a \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u045e \u0441\u0432\u043e\u0439 \u0431\u0435\u0433, \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u0432\u0435\u0440\u0443, \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b, \u0448\u0442\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u044f\u043a \u043f\u0435\u0440\u0448\u044b \u0431\u044b\u045e \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u043d\u044b \u043a\u0430\u043b\u044f \u043c\u044d\u0442\u044b \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u043d\u0430 \u044f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u045e\u0441\u044f. \u0406 \u043d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0434\u0443\u043c\u0430\u0435, \u0448\u0442\u043e \u0445\u0442\u043e\u0441\u044c\u0446\u0456, \u043a\u0430\u0433\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u044c &laquo;\u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0430\u043c&raquo;, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043a\u0456\u043c\u0441\u044c\u0446\u0456 \u043c\u0435\u043d\u0448\u044b\u043c \u0437\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430; \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456 \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0456 \u0448\u043c\u0430\u0442\u0440\u0430\u0437\u043e\u0432\u0430 \u0432\u044f\u0434\u0437\u0435 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b: &laquo;\u042f \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u043c\u0456\u0440\u0430\u044e&raquo; (1 \u041a\u0430\u0440 15, 31). \u0413\u044d\u0442\u0430 \u0437\u0430\u043c\u0430\u043b\u0430, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u043a\u0430\u0440\u0430\u043b\u044f \u043c\u043e\u0436\u0430 \u0447\u0430\u0441\u0442\u0430 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0441\u043b\u0430\u045e\u043d\u0443\u044e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043d\u0430\u0434 \u0432\u043e\u0440\u0430\u0433\u0430\u043c\u0456, \u043f\u0430\u043c\u0456\u0440\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437. \u041c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u043c\u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u043d\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c, \u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0411\u043e\u0433\u0443. \u0406 \u044f\u043a \u0441\u043f\u0440\u0430\u0432\u0430\u0439 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0451\u0441\u0446\u044c \u0437\u0430\u0433\u0456\u043d\u0443\u0446\u044c \u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u043a\u0430\u0440\u0430\u043b\u044f \u045e \u0431\u0430\u044f\u0432\u044b\u043c \u0441\u0442\u0440\u043e\u0456, \u0443 \u0441\u0443\u0442\u044b\u0447\u0446\u044b, \u0442\u0430\u043a \u0441\u043f\u0440\u0430\u0432\u0430\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0446\u043d\u043e\u0442\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u043b\u044b\u044f \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0435 \u045e \u0456\u0445 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456. \u0425\u0456\u0442\u0440\u044b \u0432\u043e\u0440\u0430\u0433 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u045e \u0443\u0441\u0435 \u0432\u0456\u0434\u044b \u0441\u0432\u0430\u0451\u0439 \u0437\u0431\u0440\u043e\u0456 \u043d\u0435 \u0434\u043b\u044f \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430, \u0431\u043e \u043d\u0435 \u0430\u0434\u0440\u0430\u0437\u0443 \u0437\u0430\u0431\u0456\u045e, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u044f\u0433\u043e, \u0431\u043e \u043c\u0443\u0447\u0430\u043d\u0456\u043a \u043d\u0435 \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u044f\u043c\u0443 \u0456 \u0430\u0434\u043a\u0456\u043d\u0443\u045e \u0443\u0441\u0435 \u0432\u0430\u0440\u043e\u0436\u044b\u044f \u043d\u0430\u043f\u0430\u0434\u044b, \u044f\u043a\u0456\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0433. \u0412\u043e\u0440\u0430\u0433 \u043d\u0435 \u043c\u043e\u0433 \u043f\u0430\u0445\u0456\u0441\u043d\u0443\u0446\u044c \u043d\u0430\u0434\u0437\u0432\u044b\u0447\u0430\u0439 \u043c\u0443\u0436\u043d\u0430\u0433\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430 \u0456 \u043f\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c \u044f\u0433\u043e \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430\u0441\u0446\u044c. \u041d\u0430\u0439\u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430, \u0431\u0440\u0430\u0442\u044b, \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u0446\u044c, \u043a\u0430\u043b\u0456 \u0431 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430, \u0437\u044f\u043c\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u0434\u0437\u0435\u043b\u044f \u041f\u0430\u043d\u0430, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u044b\u043c \u0451\u0441\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0436\u044b\u0446\u0446\u0451\u043c \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u0446\u044c, \u044f\u043a \u043d\u0430\u0448 \u041f\u0430\u043d, \u0441\u0432\u0435\u0442\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0447\u0430\u043a\u0430\u045e \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430, \u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u043a, \u0441\u043f\u044f\u0448\u0430\u044e\u0447\u044b\u0441\u044f, \u0456\u043c\u043a\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u041f\u0430\u043d\u0430. \u041f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;...\u0441\u043f\u044f\u0448\u0430\u044e\u0447\u044b\u0441\u044f, \u0456\u043c\u043a\u043d\u0443\u045e\u0441\u044f&raquo;, \u0431\u043e \u0433\u044d\u0442\u0430 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u0441\u043b\u043e\u0432\u0430\u043c \u043f\u0440\u0430\u0440\u043e\u043a\u0430: &laquo;\u0423\u0441\u0442\u0430\u043d\u044c, \u0432\u044b\u0439\u0434\u0437\u0456 \u043c\u043d\u0435 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0456 \u0433\u043b\u044f\u043d\u044c&raquo; (\u041f\u0441 59 [58], 5). \u0410\u043b\u0435, \u043a\u0430\u0431 \u0434\u0437\u0435\u043b\u044f \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u043c\u043e\u0433 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u0430\u0440\u043e\u043d\u0446\u0443, \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b\u0430\u045e \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u045e \u0431\u044b \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u0456 \u0434\u043b\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u044b \u0432\u044b\u043c\u0430\u043b\u0456\u0446\u044c \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0456 \u0441\u0430\u0431\u0435 \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u044b\u0446\u044c \u043d\u0430 \u0447\u0430\u0441 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u044b \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0443\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u0437\u043c\u0430\u0433\u0430\u0440\u0430. \u0412\u044b\u0437\u043d\u0430\u045e\u0446\u0430 \u0447\u0430\u0441\u0442\u0430 \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u045e \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u0440\u0430\u043d\u0430\u043c\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u043a\u043e\u0440\u043b\u0456\u0432\u044b\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u0441\u0432\u0435\u0434\u0447\u044b\u045e \u043f\u0440\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f. \u0413\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u045e \u043d\u0435\u0431\u0430, \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0451\u044e \u0456 \u0446\u0435\u043b\u0430\u043c. \u041f\u0435\u0440\u0430\u043c\u043e\u0433, \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u045e \u043c\u044d\u0442\u044b, \u0430\u043b\u0435 \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0434\u0437\u0456\u0446\u044f\u0447\u044b \u0456 \u043d\u0435\u0441\u0432\u044f\u0434\u043e\u043c\u044b \u044f\u0448\u0447\u044d \u045e\u0437\u0440\u043e\u0441\u0442 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0441\u0442\u0440\u044b\u043c\u0430\u045e \u0441\u044f\u0431\u0435 \u0430\u0434 \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430. \u041a\u0430\u0436\u0443 \u043f\u0440\u0430 \u0434\u0437\u0456\u0446\u044f\u0447\u044b \u045e\u0437\u0440\u043e\u0441\u0442, \u0431\u043e \u0451\u043d \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e\u0441\u0451 \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u0435; \u0451\u043d \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u0441\u043b\u044f\u0437\u044c\u043c\u0456, \u0447\u044b\u043c \u043f\u0440\u0430\u0437 \u0443\u0436\u044b\u0432\u0430\u043d\u043d\u0435 \u0444\u0456\u0437\u0456\u0447\u043d\u0430\u0439 \u0441\u0456\u043b\u044b. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0437\u043d\u0435\u0448\u043d\u0456 \u0432\u044b\u0433\u043b\u044f\u0434 \u0456 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0435 \u043c\u043e\u0446\u043d\u044b\u0445 \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u043b\u0451\u0437\u044b \u043c\u0430\u043b\u044b\u0445, \u0431\u043e \u045e \u043f\u0435\u0440\u0448\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u043a\u0440\u044b\u0448\u044b\u0446\u0446\u0430 \u0446\u0435\u043b\u0430, \u0443 \u0434\u0440\u0443\u0433\u0456\u043c &ndash; \u0441\u044d\u0440\u0446\u0430. \u0423 \u043f\u0435\u0440\u0448\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u043c\u043e\u0436\u043d\u0430 \u043a\u0440\u044b\u0445\u0443 \u045e\u0437\u0432\u0430\u0440\u0443\u0445\u043d\u0443\u0446\u044c \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u043d\u0456 \u0440\u043e\u0437\u0443\u043c\u0443, \u0443 \u0434\u0440\u0443\u0433\u0456\u043c \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u043e\u045e\u043d\u0430\u044f \u043f\u0430\u043a\u043e\u0440\u044b \u0434\u0437\u0456\u0446\u044f\u0447\u0430\u044f \u043b\u044e\u0431\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0430 \u0433\u044d\u0442\u0430? \u041f\u0430\u043a\u043b\u0430\u043f\u0430\u0446\u0456\u045e\u0441\u044f \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b-\u041c\u0430\u0446\u0456, \u043a\u0430\u0431 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0430\u0434\u044b\u0441\u0446\u0456 \u0430\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0456\u0441\u043a\u0443\u043f\u0430. \u0412\u043e\u0441\u044c \u0451\u043d \u0436\u044b\u0432\u0435, \u0432\u043e\u0441\u044c \u044f\u043a \u0434\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440 \u0441\u0442\u0430\u0456\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0430\u0442\u043a\u0443 \u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430 \u043d\u0435 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u044f\u0433\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u043f\u044f\u0440\u044d\u0434\u0437\u0456\u045e \u044f\u0433\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430 \u043d\u0435\u0439\u043a\u0456 \u0447\u0430\u0441. \u0410\u043f\u044f\u0440\u044d\u0434\u0437\u0456\u045e \u0443 \u0441\u044d\u043d\u0441\u0435 \u0441\u0442\u0430\u043d\u0443; \u0430 \u043f\u0430-\u0437\u0430 \u0433\u044d\u0442\u044b\u043c \u0451\u043d \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441, \u043f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0442\u0443\u0442 \u043d\u0430 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430. \u0414&rsquo;\u044f\u0431\u0430\u043b \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043d\u044b, \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a \u0441\u043f\u0430\u0447\u044b\u045e \u0443 \u043c\u0430\u0433\u0456\u043b\u0435; \u0456 \u0432\u043e\u0441\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u043a\u0430\u0440\u0430\u043b\u044f \u043f\u0440\u0430\u0433\u043d\u0443\u045e \u0431\u044b\u0446\u044c \u0437\u0430\u0431\u0456\u0442\u044b\u043c, \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0456 \u0436\u044b\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u0426\u0456\u043c 4, 7-8; \u0424\u043b\u043f 1, 21<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0434\u043e\u0431\u0440\u0430\u0439 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435 \u044f \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f, \u0431\u0435\u0433 \u0441\u043a\u043e\u043d\u0447\u044b\u045e, \u0432\u0435\u0440\u0443 \u0437\u0430\u0445\u0430\u0432\u0430\u045e. <span style=\"color: #ff0000;\">*<\/span> \u041d\u0430\u0440\u044d\u0448\u0446\u0435 \u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043a\u0456 \u0434\u0430\u0441\u0446\u044c \u043c\u043d\u0435 \u041f\u0430\u043d, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0421\u0443\u0434\u0434\u0437\u044f, \u0443 \u0434\u0437\u0435\u043d\u044c \u0442\u043e\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u043b\u044f \u043c\u044f\u043d\u0435 \u0436\u044b\u0446\u0446\u0451 &ndash; \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u0441\u043c\u0435\u0440\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u0432\u044b\u0433\u0430\u0434\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0440\u044d\u0448\u0446\u0435 \u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043a\u0456 \u0434\u0430\u0441\u0446\u044c \u043c\u043d\u0435 \u041f\u0430\u043d, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0421\u0443\u0434\u0434\u0437\u044f, \u0443 \u0434\u0437\u0435\u043d\u044c \u0442\u043e\u0439.<\/p>\r\n"}, {"GCH_CH_2_ID":"696","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u0430\u045e\u0440\u044d\u043d\u0446\u0456\u044f \u0437 \u0411\u0440\u044b\u043d\u0434\u044b\u0437\u0456, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo Quadragesimalis 2: Opera omnia 5, 1, nn. 48. 50. 52)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 &ndash; \u0433\u044d\u0442\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043b\u044f \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u0435 \u043c\u044b \u043c\u0430\u0435\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0430\u043d\u0451\u043b\u0430\u043c\u0456 \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c\u0456 \u0434\u0443\u0445\u0430\u043c\u0456, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u043c\u0456 \u044f\u043a \u0456 \u043c\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u043b\u0430\u0441\u043a\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u0410 \u043b\u0430\u0441\u043a\u0456 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u044f\u043c\u0430 \u0431\u0435\u0437 \u0432\u0435\u0440\u044b, \u0431\u043e \u0431\u0435\u0437 \u0432\u0435\u0440\u044b \u043d\u0435\u043b\u044c\u0433\u0430 \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u0411\u043e\u0433\u0443. \u0412\u0435\u0440\u0430 \u0436 \u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0431\u0435\u0437 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u0441\u043b\u043e\u0432\u0430: &laquo;\u0422\u0430\u043c\u0443 \u0432\u0435\u0440\u0430 &ndash; \u0430\u0434 \u043f\u0430\u0447\u0443\u0442\u0430\u0433\u0430, \u0430 \u043f\u0430\u0447\u0443\u0442\u0430\u0435 &ndash; \u043f\u0440\u0430\u0437 \u0441\u043b\u043e\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430&raquo; (\u0420\u044b\u043c 10, 17). \u0422\u0430\u043c\u0443 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0441\u043b\u043e\u0432\u0430 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0434\u043b\u044f \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a \u043f\u0430\u0441\u0435\u045e \u0437\u0435\u0440\u043d\u044f \u0434\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043a\u0430\u0436\u0430: &laquo;\u0412\u044b\u0439\u0448a\u045e \u0441\u0435\u0439\u0431\u0456\u0442 \u0441\u0435\u044f\u0446\u044c&raquo; (\u041b\u043a 8, 5). \u0421\u0435\u0439\u0431\u0456\u0442 \u0432\u044b\u0439\u0448\u0430\u045e \u044f\u043a \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0422\u0430\u043a\u0456\u043c \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u043c \u0431\u044b\u045e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456, \u044f\u043a \u043c\u044b \u0447\u044b\u0442\u0430\u043b\u0456, \u0441\u0430\u043c \u0411\u043e\u0433, \u043a\u0430\u043b\u0456, \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u0437 \u043d\u0435\u0431\u0430, \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u0443\u0441\u044f\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0437\u0430\u043a\u043e\u043d \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0406\u043d\u0448\u044b\u043c \u0440\u0430\u0437\u0430\u043c \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u043c \u0431\u044b\u045e \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043d\u0430 \u043c\u0435\u0441\u0446\u044b \u043f\u043b\u0430\u0447\u0443 \u043f\u0430\u043f\u0440\u0430\u043a\u0430\u045e \u043d\u0430\u0440\u043e\u0434 \u0437\u0430 \u043f\u0430\u0440\u0443\u0448\u044d\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0437\u0430\u043a\u043e\u043d\u0443, \u0430 \u045e\u0441\u0435 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u043f\u0430\u0447\u0443\u045e\u0448\u044b \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0441\u0430 \u0441\u043a\u0440\u0443\u0445\u0430\u044e \u045e \u0441\u044d\u0440\u0446\u044b \u045e\u0437\u043d\u044f\u043b\u0456 \u043f\u043b\u0430\u0447. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u041c\u0430\u0439\u0441\u0435\u0439, \u044f\u043a \u0447\u044b\u0442\u0430\u0435\u043c \u0443 \u043a\u043d\u0456\u0437\u0435 \u0414\u0440\u0443\u0433\u0430\u0437\u0430\u043a\u043e\u043d\u043d\u044f, \u043d\u0430 \u043f\u0430\u043b\u044f\u0445 \u041c\u0430\u0430\u0431\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0443\u0441\u044f\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u0417\u0430\u043a\u043e\u043d \u041f\u0430\u043d\u0430. \u0423\u0440\u044d\u0448\u0446\u0435, \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0411\u043e\u0433 \u0456 \u0427\u0430\u043b\u0430\u0432\u0435\u043a, \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430. \u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0432\u044b\u0441\u043b\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 &ndash; \u0433\u044d\u0442\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0435, \u0430\u043d\u0451\u043b\u044c\u0441\u043a\u0430\u0435, \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0435 \u0456 \u0411\u043e\u0436\u0430\u0435 \u0437\u0430\u0434\u0430\u043d\u043d\u0435. \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u0430\u0433\u0430\u0442\u0430\u0435 \u043d\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0434\u0430\u0431\u0440\u043e, \u0448\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u044f\u043a \u0431\u044b \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u0430\u0439 \u0443\u0441\u0456\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e. \u0417 \u044f\u0433\u043e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0432\u0435\u0440\u0430, \u0437 \u044f\u0433\u043e &ndash; \u043d\u0430\u0434\u0437\u0435\u044f, \u0437 \u044f\u0433\u043e &ndash; \u043b\u044e\u0431\u043e\u045e, \u0437 \u044f\u0433\u043e &ndash; \u0443\u0441\u0435 \u0446\u043d\u043e\u0442\u044b, \u0443\u0441\u0435 \u0434\u0430\u0440\u044b \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0443\u0441\u0435 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u044f \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456, \u0443\u0441\u0435 \u0434\u043e\u0431\u0440\u044b\u044f \u0447\u044b\u043d\u044b, \u0443\u0441\u0435 \u0437\u0430\u0441\u043b\u0443\u0433\u0456 \u0436\u044b\u0446\u0446\u044f, \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u045e: &laquo;\u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u0437 \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u043f\u0430\u0441\u0435\u044f\u043d\u0430\u0435 \u045e \u0432\u0430\u0441 \u0441\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u043c\u043e\u0436\u0430 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0432\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b&raquo; (\u042f\u043a 1, 21).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0440\u043e\u0437\u0443\u043c\u0443 \u0456 \u0430\u0433\u043d\u0451\u043c \u0432\u043e\u043b\u0456, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043c\u043e\u0433 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430. \u0414\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u0430\u0441\u0446\u044b \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0445\u043b\u0435\u0431\u0430\u043c \u0456 \u0432\u0430\u0434\u043e\u0439, \u0430\u043b\u0435 \u0445\u043b\u0435\u0431\u0430\u043c \u0441\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u044b\u043c \u0437\u0430 \u0441\u043e\u0442\u044b \u0437 \u043c\u0451\u0434\u0430\u043c \u0456 \u0432\u0430\u0434\u043e\u044e \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0439 \u0437\u0430 \u0432\u0456\u043d\u043e \u0456 \u043c\u0430\u043b\u0430\u043a\u043e; \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u0434\u0443\u0448\u044b \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u0430\u0439 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u0445 \u0437\u0430\u0441\u043b\u0443\u0433, \u0442\u0430\u043c\u0443 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0437\u043e\u043b\u0430\u0442\u0430\u043c \u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u0435\u043c. \u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0433\u0440\u044d\u0448\u043d\u0430\u0439 \u0437\u0430\u043a\u0430\u043c\u044f\u043d\u0435\u043b\u0430\u0441\u0446\u0456 \u0441\u044d\u0440\u0446\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u043e\u043b\u0430\u0442\u0430\u043c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u0432\u0435\u0442\u0443, \u0446\u0435\u043b\u0430 \u0456 \u0441\u0430\u0442\u0430\u043d\u044b &ndash; \u043c\u044f\u0447\u043e\u043c, \u044f\u043a\u0456 \u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0456 \u0433\u0440\u044d\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0406\u0441 40, 9\u0430\u0441; \u041b\u043a 9, 59\u0430. 60<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0440\u0430\u0431\u0456 \u043c\u043e\u0446\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441 \u0441\u0432\u043e\u0439, \u0421\u0456\u0451\u043d, \u044f\u043a\u0456 \u043d\u044f\u0441\u0435\u0448 \u0434\u043e\u0431\u0440\u044b\u044f \u0432\u0435\u0441\u0442\u043a\u0456; <span style=\"color: #ff0000;\">*<\/span> \u0441\u043a\u0430\u0436\u044b \u041d\u0430\u0440\u044d\u0448\u0446\u0435 \u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043a\u0456 \u0434\u0430\u0441\u0446\u044c \u043c\u043d\u0435 \u041f\u0430\u043d, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0421\u0443\u0434\u0434\u0437\u044f, \u0443 \u0434\u0437\u0435\u043d\u044c \u0442\u043e\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406\u0434\u0437\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0439 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043a\u0430\u0436\u044b \u041d\u0430\u0440\u044d\u0448\u0446\u0435 \u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043a\u0456 \u0434\u0430\u0441\u0446\u044c \u043c\u043d\u0435 \u041f\u0430\u043d, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0421\u0443\u0434\u0434\u0437\u044f, \u0443 \u0434\u0437\u0435\u043d\u044c \u0442\u043e\u0439.<\/p>\r\n"}, {"GCH_CH_2_ID":"697","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 25, 1-2. 4-5: PL 76, 1189-1193)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0413\u043e\u0440\u0430\u0447\u0430 \u043f\u0440\u0430\u0433\u043d\u0443\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0440\u044b\u044f \u041c\u0430\u0433\u0434\u0430\u043b\u0435\u043d\u0430, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0434\u0430 \u0433\u0440\u043e\u0431\u0443, \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u0442\u0430\u043c \u0446\u0435\u043b\u0430 \u041f\u0430\u043d\u0430. \u041f\u0430\u0434\u0443\u043c\u0430\u043b\u0430, \u0448\u0442\u043e \u044f\u0433\u043e \u0437\u0430\u0431\u0440\u0430\u043b\u0456, \u0456 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u043b\u0430 \u0430\u0431 \u0433\u044d\u0442\u044b\u043c \u0432\u0443\u0447\u043d\u044f\u043c. \u0422\u044b\u044f \u043f\u0440\u044b\u0439\u0448\u043b\u0456, \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043b\u0456\u0441\u044f, \u0448\u0442\u043e \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a \u0456 \u0451\u0441\u0446\u044c, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u0456\u043c \u0436\u0430\u043d\u0447\u044b\u043d\u0430. \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0434\u0430\u043b\u0435\u0439 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0456\u0445: &laquo;\u0412\u0443\u0447\u043d\u0456 \u0437\u043d\u043e\u045e \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u0441\u044f\u0431\u0435&raquo; \u0456 \u0434\u0430\u0434\u0430\u0435: &laquo;\u041c\u0430\u0440\u044b\u044f \u0441\u0442\u0430\u044f\u043b\u0430 \u043a\u0430\u043b\u044f \u043c\u0430\u0433\u0456\u043b\u044b \u0456 \u043f\u043b\u0430\u043a\u0430\u043b\u0430&raquo; (\u042f\u043d 20, 10-11).<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u0431\u0430\u0447\u043d\u0430, \u044f\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u043f\u0430\u043b\u0430\u043b\u0430 \u0441\u044d\u0440\u0446\u0430 \u041c\u0430\u0440\u044b\u0456, \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u043f\u0430\u0441\u043b\u044f \u0430\u0434\u044b\u0445\u043e\u0434\u0443 \u0432\u0443\u0447\u043d\u044f\u045e \u043d\u0435 \u043f\u0430\u0439\u0448\u043b\u0430 \u0430\u0434 \u0433\u0440\u043e\u0431\u0443 \u041f\u0430\u043d\u0430. \u041d\u0430\u0434\u0430\u043b\u0435\u0439 \u0448\u0443\u043a\u0430\u043b\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0430. \u0428\u0443\u043a\u0430\u044e\u0447\u044b, \u043f\u043b\u0430\u043a\u0430\u043b\u0430 \u0456, \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u0430\u044f \u043f\u043e\u043b\u044b\u043c\u0435\u043c \u043b\u044e\u0431\u043e\u0432\u0456, \u043c\u043e\u0446\u043d\u0430 \u0441\u0443\u043c\u0430\u0432\u0430\u043b\u0430 \u043f\u0430 \u0442\u044b\u043c, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u0434\u0443\u043c\u0430\u043b\u0430, \u0448\u0442\u043e \u042f\u0433\u043e \u0437\u0430\u0431\u0440\u0430\u043b\u0456. \u0406 \u0432\u043e\u0441\u044c, \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u044f \u045e\u0431\u0430\u0447\u044b\u043b\u0430 \u0442\u0430\u0434\u044b \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u0430\u044f \u0437\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u042f\u0433\u043e \u0448\u0443\u043a\u0430\u0446\u044c. \u0414\u0430\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435\u043c \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0447\u044b\u043d\u0443 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u041f\u0440\u0430\u045e\u0434\u044b: &laquo;\u0422\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0435 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430, \u0431\u0443\u0434\u0437\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b&raquo; (\u041c\u0446 10, 22).<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0443\u043a\u0430\u043b\u0430 \u0456 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0430. \u041f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u0430 \u0448\u0443\u043a\u0430\u0446\u044c \u0434\u0430\u043b\u0435\u0439 \u0456 \u0437\u043d\u0430\u0439\u0448\u043b\u0430; \u0437 \u0447\u0430\u0441\u0430\u043c \u0441\u0443\u043c \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u045e, \u0430 \u043a\u0430\u043b\u0456 \u0441\u0442\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c, \u044f\u043d\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0430 \u043c\u044d\u0442\u044b \u0441\u0432\u0430\u0456\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e. \u0411\u043e \u0441\u0432\u044f\u0442\u044b \u0441\u0443\u043c \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0434\u043c\u0435\u0442\u0443 \u0441\u0432\u0430\u0456\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e. \u041a\u0430\u043b\u0456 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0441\u0443\u043c, \u0433\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0431\u044b\u045e \u0441\u0443\u043c \u043d\u0435\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u0441\u0443\u043c \u043f\u0435\u0440\u0430\u0436\u044b\u0432\u0430\u045e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0437\u0434\u0430\u0431\u044b\u045e \u043f\u0440\u0430\u045e\u0434\u0443. \u0422\u0430\u043c\u0443 \u0414\u0430\u0432\u0456\u0434 \u043a\u0430\u0436\u0430: &laquo;\u0414\u0443\u0448\u0430 \u043c\u0430\u044f \u043f\u0440\u0430\u0433\u043d\u0435 \u0411\u043e\u0433\u0430, \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u044f \u043f\u0430\u0439\u0434\u0443 \u0456 \u0437&rsquo;\u044f\u045e\u043b\u044e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0436\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c?&raquo; (\u041f\u0441 42 [41], 3). \u0410 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u041f\u0435\u0441\u043d\u0456 \u043f\u0435\u0441\u043d\u044f\u045e \u043a\u043b\u0456\u0447\u0430: &laquo;\u042f \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u0430 \u043b\u044e\u0431\u043e\u045e\u044e&raquo; (\u043f\u0430\u0440. \u041f\u043f 4, 9). \u0406 \u043a\u0440\u044b\u0445\u0443 \u0434\u0430\u043b\u0435\u0439: &laquo;\u041c\u043b\u0435\u0435 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f&raquo; (\u043f\u0430\u0440. \u041f\u043f 5, 6).<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0416\u0430\u043d\u0447\u044b\u043d\u0430, \u0447\u0430\u0433\u043e \u0442\u044b \u043f\u043b\u0430\u0447\u0430\u0448? \u041a\u0430\u0433\u043e \u0448\u0443\u043a\u0430\u0435\u0448?&raquo; (\u042f\u043d 20, 15). \u042f\u043d\u0430 \u0447\u0443\u0435 \u043f\u044b\u0442\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043f\u0440\u044b\u0447\u044b\u043d\u0443 \u0431\u043e\u043b\u044e, \u0448\u0442\u043e \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435 \u044f\u0435 \u0441\u0443\u043c, \u044f\u043d\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0456\u043c\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0448\u0443\u043a\u0430\u0435, \u0456 \u044f\u0435 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u042f\u0433\u043e \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0440\u0430\u0437\u0433\u0430\u0440\u0430\u0435\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0436\u0430 \u0451\u0439 \u0415\u0437\u0443\u0441: &laquo;\u041c\u0430\u0440\u044b\u044f!&raquo; (\u042f\u043d 20, 16). \u041a\u0430\u043b\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e: &laquo;\u0416\u0430\u043d\u0447\u044b\u043d\u0430&raquo;, \u043d\u0435 \u0431\u044b\u045e \u043f\u0430\u0437\u043d\u0430\u043d\u044b; \u0446\u044f\u043f\u0435\u0440 \u0436\u0430 \u043a\u043b\u0456\u0447\u0430 \u043f\u0430 \u0456\u043c\u0435\u043d\u0456, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0445\u0430\u0446\u0435\u045e \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u041f\u0430\u0437\u043d\u0430\u0439, \u0445\u0442\u043e \u0446\u044f\u0431\u0435 \u043f\u0430\u0437\u043d\u0430\u045e!&raquo;. \u041c\u0430\u0440\u044b\u044f, \u043d\u0430\u0437\u0432\u0430\u043d\u0430\u044f \u043f\u0430 \u0456\u043c\u0435\u043d\u0456, \u043f\u0430\u0437\u043d\u0430\u0435 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u0456 \u0442\u0443\u0442 \u0436\u0430 \u043a\u0430\u0436\u0430: &laquo;\u0420\u0430\u0431\u0431\u0443\u043d\u0456&raquo;, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c &laquo;\u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a&raquo;; \u0431\u043e \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u0448\u0443\u043a\u0430\u043b\u0430 \u0437\u0432\u043e\u043d\u043a\u0443, \u0432\u0443\u0447\u044b\u045e \u044f\u0435 \u045e \u0434\u0443\u0448\u044b, \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u042f\u0433\u043e \u0448\u0443\u043a\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044f\u0440\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0430\u0434 \u043c\u0430\u0433\u0456\u043b\u044b \u041f\u0430\u043d\u0430, \u041c\u0430\u0440\u044b\u044f \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u0432\u0443\u0447\u043d\u044f\u043c: \u042f \u0431\u0430\u0447\u044b\u043b\u0430 \u041f\u0430\u043d\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u0431\u044b\u043b\u0430 \u0433\u043e\u0434\u043d\u0430\u044f \u0441\u0442\u0430\u0446\u044c \u043f\u0435\u0440\u0448\u044b\u043c \u0432\u0435\u0441\u0442\u0443\u043d\u043e\u043c \u0423\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u043b\u0430\u0447\u0443\u0447\u044b, \u0443\u0431\u0430\u0447\u044b\u043b\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0448\u0443\u043a\u0430\u043b\u0430, \u0456, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u042f\u0433\u043e, \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u043b\u0430 \u0432\u0443\u0447\u043d\u044f\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u0431\u044b\u043b\u0430 \u0433\u043e\u0434\u043d\u0430\u044f \u0441\u0442\u0430\u0446\u044c \u043f\u0435\u0440\u0448\u044b\u043c \u0432\u0435\u0441\u0442\u0443\u043d\u043e\u043c \u0423\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u0430\u0433\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"698","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041c\u0430\u043b\u0456\u0442\u0432\u0430, \u044f\u043a\u0430\u044f \u043f\u0440\u044b\u043f\u0456\u0441\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0432. \u0411\u0440\u044b\u0433\u0456\u0446\u0435<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 2: Revelationum S. Birgittae libri, 2, Romae 1628, pp. 408-410)<\/span><br \/><span style=\"color: #ff0000;\">\u0423\u0437\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u0440\u043e\u0437\u0443\u043c\u0443 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0417\u0431\u0430\u045e\u0446\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u044c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b, \u043c\u043e\u0439 \u041f\u0430\u043d\u0435, \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0440\u0430\u043d\u0435\u0439 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u044e \u0441\u043c\u0435\u0440\u0446\u044c, \u0430 \u043f\u0430\u0434\u0447\u0430\u0441 \u0410\u043f\u043e\u0448\u043d\u044f\u0439 \u0412\u044f\u0447\u044d\u0440\u044b \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u045e \u0445\u043b\u0435\u0431 \u0443 \u0441\u0432\u0430\u0451 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0435 \u0426\u0435\u043b\u0430 \u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u0440\u0430\u0437\u0434\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c \u043d\u0430 \u045e\u0441\u043f\u0430\u043c\u0456\u043d \u0430\u0431 \u0441\u0432\u0430\u0451\u0439 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0439 \u041c\u0443\u0446\u044b; \u0448\u0442\u043e \u0430\u0431\u043c\u044b\u0432\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0456 \u0441\u043b\u0430\u045e\u043d\u044b\u043c\u0456 \u0434\u0430\u043b\u043e\u043d\u044f\u043c\u0456 \u0456\u0445 \u0441\u0442\u0443\u043f\u043d\u0456, \u0422\u044b \u0434\u0430\u045e \u0441\u0430\u043c\u044b \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u043f\u0430\u043a\u043e\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0432\u0430\u043b\u0430 \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435 \u043c\u043e\u0439, \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0442\u0440\u044b\u0432\u043e\u0437\u0435 \u043f\u0435\u0440\u0430\u0434 \u041c\u0443\u043a\u0430\u0439 \u0456 \u0441\u043c\u0435\u0440\u0446\u044e \u0422\u044b \u0430\u0440\u0430\u0441\u0456\u045e \u043a\u0440\u044b\u0432\u0430\u0432\u044b\u043c \u043f\u043e\u0442\u0430\u043c \u0441\u0432\u0430\u0451 \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u0456 \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0433\u044d\u0442\u0430 \u0441\u043f\u043e\u045e\u043d\u0456\u045e \u0437\u0430\u0434\u0443\u043c\u0430\u043d\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443, \u0430\u0431&rsquo;\u044f\u045e\u043b\u044f\u044e\u0447\u044b \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u044c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b, \u043c\u043e\u0439 \u041f\u0430\u043d\u0435, \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u045e \u0430\u0434\u0432\u0435\u0434\u0437\u0435\u043d\u044b \u0434\u0430 \u041a\u0430\u044f\u0444\u044b \u0456 \u045e \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u043a\u043e\u0440\u044b \u0422\u044b, \u0421\u0443\u0434\u0434\u0437\u044f \u045e\u0441\u044f\u0433\u043e, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u045e\u0441\u044f \u0441\u0443\u0434\u0443 \u041f\u0456\u043b\u0430\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0432\u0430\u043b\u0430 \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435 \u043c\u043e\u0439, \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u0437\u0434\u0437\u0435\u043a\u0456, \u0448\u0442\u043e \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b \u045e \u043f\u0443\u0440\u043f\u0443\u0440 \u0431\u044b\u045e \u0443\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u043d\u044b \u0432\u043e\u0441\u0442\u0440\u044b\u043c \u0446\u0435\u0440\u043d\u0435\u043c, \u0448\u0442\u043e \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u045e \u0437\u043d\u044f\u0432\u0430\u0433\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0433\u0430 \u0410\u0431\u043b\u0456\u0447\u0447\u0430, \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u043d\u043d\u0435 \u0432\u0430\u0447\u044d\u0439 \u0422\u0432\u0430\u0456\u0445 \u0456 \u0431\u0456\u0446\u0446\u0451 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456 \u043f\u0430 \u0433\u0430\u043b\u0430\u0432\u0435 \u0456 \u0448\u044b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0432\u0430\u043b\u0430 \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435 \u043c\u043e\u0439, \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0422\u044b \u0434\u0430\u045e \u043f\u0440\u044b\u0432\u044f\u0437\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0434\u0430 \u0441\u043b\u0443\u043f\u0430, \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0431\u0435\u0441\u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430 \u0431\u0456\u0447\u0430\u0432\u0430\u0446\u044c \u0441\u044f\u0431\u0435, \u0432\u0435\u0441\u0446\u0456 \u0441\u044f\u0431\u0435, \u0437\u0430\u043b\u0456\u0442\u0430\u0433\u0430 \u043a\u0440\u044b\u0432\u0451\u044e, \u0448\u0442\u043e \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0441\u0442\u0430\u0446\u044c \u044f\u043a \u043d\u044f\u0432\u0456\u043d\u043d\u044b \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u043f\u0435\u0440\u0430\u0434 \u0441\u0443\u0434\u043e\u043c \u041f\u0456\u043b\u0430\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0432\u0430\u043b\u0430 \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435 \u043c\u043e\u0439, \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u043b\u0456\u0442\u044b \u043a\u0440\u044b\u0432\u0451\u044e, \u0422\u044b \u0431\u044b\u045e \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b \u043d\u0430 \u043a\u0440\u044b\u0436\u043e\u0432\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c, \u0448\u0442\u043e \u045e \u0441\u0442\u0440\u0430\u0448\u043d\u044b\u043c \u043c\u0443\u0447\u044d\u043d\u043d\u0456 \u043d\u0451\u0441 \u043a\u0440\u044b\u0436 \u043d\u0430 \u0441\u0432\u0430\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445 \u043f\u043b\u044f\u0447\u0430\u0445, \u0448\u0442\u043e \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0437\u0430\u0446\u044f\u0433\u043d\u0443\u0446\u044c \u0441\u044f\u0431\u0435 \u045e \u0437\u0434\u0437\u0435\u043a\u0430\u0445 \u043d\u0430 \u043c\u0435\u0441\u0446\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f, \u043a\u0430\u0431 \u0437 \u0426\u044f\u0431\u0435 \u0437\u0434\u0437\u0435\u0440\u043b\u0456 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0456 \u043f\u0440\u044b\u0431\u0456\u043b\u0456 \u0434\u0430 \u043a\u0440\u044b\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u0447\u043d\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435 \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0448\u0442\u043e \u0441\u044f\u0440\u043e\u0434 \u0442\u0430\u043a\u043e\u0433\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u043a\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u044f \u0422\u044b \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e \u0437 \u043b\u044e\u0431\u043e\u045e\u044e \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u0430\u043b\u043e\u0434\u043a\u0456\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430 \u043d\u0430 \u0441\u0432\u0430\u044e \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0443\u044e \u041c\u0430\u0446\u0456, \u044f\u043a\u0430\u044f \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u045e\u0447\u044b\u043d\u0456\u043b\u0430 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443 \u0456 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0439 \u043f\u0440\u0430\u0432\u0456\u043d\u044b, \u0456, \u0441\u0443\u0446\u044f\u0448\u0430\u044e\u0447\u044b \u042f\u0435, \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u042f\u0435 \u0432\u0435\u0440\u043d\u0430\u0439 \u0430\u043f\u0435\u0446\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u0443\u0447\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u044c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u043d\u0430\u0432\u0435\u043a\u0456, \u043c\u043e\u0439 \u041f\u0430\u043d\u0435, \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u0432\u0430\u0442 \u0443 \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430\u045e \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u043c \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435, \u0430\u0431\u044f\u0446\u0430\u044e\u0447\u044b \u045e \u0441\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0445\u0432\u0430\u043b\u0443 \u0440\u0430\u044e \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0443, \u044f\u043a\u0456 \u043d\u0430\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u0447\u043d\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435 \u043c\u043e\u0439, \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u043a\u043e\u0436\u043d\u0443\u044e \u0433\u0430\u0434\u0437\u0456\u043d\u0443, \u043f\u0430\u0434\u0447\u0430\u0441 \u044f\u043a\u043e\u0439 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u0422\u044b \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0430\u043c\u0443\u044e \u0436\u0430\u0445\u043b\u0456\u0432\u0443\u044e \u043c\u0443\u043a\u0443 \u0456 \u043a\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0456. \u0422\u0432\u0430\u0435 \u0440\u0430\u043d\u044b \u0431\u0430\u043b\u044e\u0447\u0430 \u043f\u0440\u0430\u0446\u0456\u043d\u0430\u043b\u0456 \u0422\u0432\u0430\u044e \u0434\u0443\u0448\u0443 \u0456 \u043f\u0440\u0430\u043d\u0456\u0437\u0432\u0430\u043b\u0456 \u0422\u0432\u0430\u0451 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0435 \u0421\u044d\u0440\u0446\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u044f\u043d\u043e \u043d\u0435 \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u043b\u0430\u0441\u044f, \u0456 \u0422\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430 \u0430\u0434\u0434\u0430\u045e \u0434\u0443\u0445\u0430. \u0421\u0445\u0456\u043b\u0456\u045e\u0448\u044b \u0433\u0430\u043b\u0430\u0432\u0443, \u0422\u044b \u0437 \u0443\u0441\u0451\u0439 \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u0441\u0432\u043e\u0439 \u0434\u0443\u0445 \u0443 \u0440\u0443\u043a\u0456 \u0410\u0439\u0446\u0430, \u0456 \u0445\u043e\u043b\u0430\u0434 \u0430\u0445\u0430\u043f\u0456\u045e \u0422\u0432\u0430\u0451 \u043c\u0451\u0440\u0442\u0432\u0430\u0435 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b, \u041f\u0430\u043d\u0435 \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u0432\u0430\u0451\u0439 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0456 \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u044e \u0422\u044b \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0434\u0443\u0448\u044b \u0456 \u0432\u044b\u0432\u0435\u045e \u0456\u0445 \u0437 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u044f \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b, \u041f\u0430\u043d\u0435 \u043c\u043e\u0439, \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u0430\u0431\u0456\u0446\u044c \u0441\u0432\u043e\u0439 \u0431\u043e\u043a \u0456 \u0441\u044d\u0440\u0446\u0430 \u0434\u0437\u0456\u0434\u0430\u044e; \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437 \u0422\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u043a\u0443 \u0432\u044b\u0446\u0435\u043a\u043b\u0456 \u043a\u0440\u043e\u045e \u0456 \u0432\u0430\u0434\u0430, \u043a\u0430\u0431 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0432\u0430\u043b\u0430 \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435 \u043c\u043e\u0439, \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0436\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u0422\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043e\u0435 \u0446\u0435\u043b\u0430, \u0437\u043d\u044f\u0442\u0430\u0435 \u0422\u0432\u0430\u0456\u043c\u0456 \u0441\u044f\u0431\u0440\u0430\u043c\u0456 \u0437 \u043a\u0440\u044b\u0436\u0430, \u0431\u044b\u043b\u043e \u0430\u0434\u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u045e \u0440\u0443\u043a\u0456 \u0422\u0432\u0430\u0451\u0439 \u0431\u0430\u043b\u0435\u0441\u043d\u0430\u0439 \u041c\u0430\u0446\u0456; \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e, \u043a\u0430\u0431 \u042f\u043d\u0430 \u0437\u0430\u0445\u0456\u043d\u0443\u043b\u0430 \u044f\u0433\u043e \u045e \u043f\u0430\u043b\u0430\u0442\u043d\u043e, \u043a\u0430\u0431 \u0422\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u043f\u0430\u043a\u043b\u0430\u043b\u0456 \u045e \u043c\u0430\u0433\u0456\u043b\u0443 \u0456 \u043f\u0440\u044b\u0441\u0442\u0430\u0432\u0456\u043b\u0456 \u0434\u0430 \u044f\u0433\u043e \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u0447\u043d\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435 \u043c\u043e\u0439, \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0422\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u043d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u0441\u0432\u0435\u0434\u043a\u0430\u043c; \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0441\u043b\u044f \u0441\u0430\u0440\u0430\u043a\u0430 \u0434\u0437\u0451\u043d \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u043c\u043d\u043e\u0433\u0456\u0445 \u0443\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430 \u0456 \u0442\u0443\u0434\u044b \u045e \u0445\u0432\u0430\u043b\u0435 \u043f\u0440\u044b\u0432\u0451\u045e \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u045e, \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b\u0445 \u0437 \u0430\u0434\u0445\u043b\u0430\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u0432\u0435\u0447\u043d\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435 \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u0443 \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u045e \u0443 \u0456\u0445 \u0434\u0443\u0448\u0430\u0445 \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0443\u044e \u0411\u043e\u0436\u0443\u044e \u043b\u044e\u0431\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0445\u0432\u0430\u043b\u0430 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0422\u0430\u0431\u0435 \u043d\u0430\u0432\u0435\u043a\u0456, \u041f\u0430\u043d\u0435 \u043c\u043e\u0439, \u0415\u0437\u0443, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0456\u0448 \u043d\u0430 \u0442\u0440\u043e\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0456 \u045e \u0445\u0432\u0430\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0441\u0442\u0432\u0430, \u0436\u044b\u0432\u044b \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u044b\u0445 \u0447\u043b\u0435\u043d\u0430\u0445, \u043f\u0440\u044b\u043d\u044f\u0442\u044b\u0445 \u0430\u0434 \u0446\u0435\u043b\u0430 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0414\u0437\u0435\u0432\u044b. \u0422\u044b \u043f\u0440\u044b\u0431\u0443\u0434\u0437\u0435\u0448 \u0443 \u0434\u0437\u0435\u043d\u044c \u0441\u0443\u0434\u0430, \u043a\u0430\u0431 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0434\u0443\u0448\u044b \u045e\u0441\u0456\u0445 \u0436\u044b\u0432\u044b\u0445 \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435\u0448 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0448 \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u043f 1, 5. 6\u0430; \u042d\u0444 5, 2\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0430\u0434 \u043d\u0430\u0448\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u043d\u0430\u0441 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u0456 \u0410\u0439\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406\u0434\u0437\u0456\u0446\u0435 \u0448\u043b\u044f\u0445\u0430\u043c \u043b\u044e\u0431\u043e\u0432\u0456, \u0431\u043e \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043d\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u045e\u0447\u044b\u043d\u0456\u045e \u043d\u0430\u0441 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u0456 \u0410\u0439\u0446\u0430 \u0441\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"699","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0410\u043c\u043e\u043d\u0456\u044f, \u043f\u0443\u0441\u0442\u044d\u043b\u044c\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 12: PO 10\/6, 1973, 603-607)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041b\u0435\u043a\u0430\u0440\u0430\u043c\u0456 \u0434\u0443\u0448\u0430\u045e \u0431\u044b\u043b\u0456 \u045e\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u044f \u0442\u044b\u044f, \u0445\u0442\u043e \u0431\u044b\u045e \u043d\u0430\u0439\u0431\u043b\u0456\u0436\u044d\u0439 \u0434\u0430 \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u041f\u0430\u043d\u0443, \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b\u044f \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0433\u0440\u0430\u0445\u0443, \u0432\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0434\u0443\u0448\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0411\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u0441\u0430\u043c\u0430 \u043d\u0435 \u0430\u0434\u0434\u0430\u043b\u0456\u0446\u0446\u0430 \u0430\u0434 \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u045e\u0441\u0456\u0445 \u0441\u043f\u0440\u0430\u045e. \u0422\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u043e\u0440\u0430\u0433\u0430, \u043a\u0430\u043b\u0456 \u0430\u0434\u0440\u0430\u0447\u044d\u0446\u0446\u0430 \u0430\u0434 \u0441\u044f\u0431\u0435. \u0410 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u045e\u0448\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u043e\u0440\u0430\u0433\u0430 \u045e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435 \u0456 \u043d\u0435\u0430\u0434\u043d\u0430\u0440\u0430\u0437\u043e\u0432\u0430 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0448\u044b \u044f\u0433\u043e \u045e \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0436\u044b\u043b\u043b\u0451\u043c \u0411\u043e\u0433\u0430 \u0456 \u0430\u0434 \u0441\u0443\u043c\u0443 \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u0448\u0447\u0430\u0441\u0446\u044f. \u041a\u0430\u043b\u0456 \u0436 \u0441\u0430\u043c\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043d\u0430 \u045e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435, \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u044f\u0435 \u0441\u0443\u043c, \u0441\u0442\u043e\u043c\u0430 \u0456 \u0456\u043d\u0448\u044b\u044f \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u043f\u0430\u0447\u0443\u0446\u0446\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430\u0437\u043d\u0430\u0435 \u0456\u043d\u0448\u044b\u044f \u043d\u0435\u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0410\u0439\u0446\u044b \u0432\u044f\u043b\u0456 \u0441\u0430\u043c\u043e\u0442\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u044f\u043a \u043f\u0440\u0430\u0440\u043e\u043a \u0406\u043b\u043b\u044f, \u044f\u043a \u042f\u043d \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044c. \u041d\u0435 \u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c\u0456 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0431\u044b\u043b\u0456 \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430. \u0410\u043b\u0435, \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u044f\u0448\u0447\u044d \u0456 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0440\u0430\u043d\u0435\u0439 \u0434\u043e\u045e\u0433\u0456 \u0447\u0430\u0441 \u0431\u044b\u043b\u0456 \u043d\u0430 \u0441\u0430\u043c\u043e\u0446\u0435 \u0456 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0411\u043e\u0436\u0443\u044e \u043c\u043e\u0446 \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0441\u0430\u043c \u0411\u043e\u0433 \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u045e \u0456\u0445. \u0406 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u045e\u0436\u043e \u0437\u0434\u0430\u0431\u044b\u043b\u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0446\u043d\u043e\u0442\u044b, \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u0456\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0411\u043e\u0436\u044b\u043c\u0456 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u043c\u0456 \u0456 \u043b\u044f\u0447\u044b\u043b\u0456 \u043b\u044e\u0434\u0441\u043a\u0456\u044f \u0445\u0432\u0430\u0440\u043e\u0431\u044b. \u042f\u043d\u044b \u0431\u044b\u043b\u0456 \u043b\u0435\u043a\u0430\u0440\u0430\u043c\u0456 \u0434\u0443\u0448, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u0432\u044b\u043b\u0435\u0447\u044b\u0446\u044c \u0456\u0445 \u0431\u0435\u0437\u0434\u0430\u043f\u0430\u043c\u043e\u0436\u043d\u0430\u0441\u0446\u044c. \u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430, \u0432\u044b\u0440\u0432\u0430\u043d\u044b\u044f \u0437 \u0441\u0430\u043c\u043e\u0442\u044b, \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u044b\u044f \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439. \u0410\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u045e\u0441\u0435 \u0456\u0445\u043d\u0456\u044f \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u044b\u044f \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u0431\u044b\u043b\u0456 \u045e\u0436\u043e \u0432\u044b\u043b\u0435\u0447\u0430\u043d\u044b\u044f. \u0411\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0442\u0430\u043a, \u0448\u0442\u043e \u0434\u0443\u0448\u0430 \u043f\u0430\u0441\u044b\u043b\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439 \u0434\u043b\u044f \u0456\u0445 \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f, \u0443 \u0442\u043e\u0439 \u0447\u0430\u0441 \u044f\u043a \u0441\u0430\u043c\u0430 \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u043d\u0435\u0439\u043a\u0456\u044f \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456. \u041a\u0430\u043b\u0456 \u0436 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0432\u044b\u0440\u0443\u0448\u0430\u044e\u0446\u044c \u0443 \u0434\u0430\u0440\u043e\u0433\u0443, \u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u045e\u0448\u044b \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456, \u0442\u043e \u0456\u0434\u0443\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u044f, \u0430 \u043d\u0435 \u0437 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456. \u0411\u043e\u0433 \u043f\u0440\u0430 \u0442\u0430\u043a\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u043a\u0430\u0436\u0430 \u0437 \u0434\u0430\u043a\u043e\u0440\u0430\u043c: &laquo;\u041d\u0435 \u042f \u0456\u0445 \u043f\u0430\u0441\u043b\u0430\u045e, \u0430\u043b\u0435 \u044f\u043d\u044b \u043f\u0430\u0441\u043f\u044f\u0448\u044b\u043b\u0456 \u0441\u0430\u043c\u0456&raquo;. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u043d\u0430\u0432\u0430\u0442 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b, \u0430 \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0446\u044c \u0434\u0443\u0448\u044b \u0456\u043d\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f \u0436, \u043a\u0430\u0433\u043e \u043f\u0430\u0441\u043b\u0430\u045e \u0411\u043e\u0433, \u043d\u0435\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0446\u044c \u0441\u0430\u043c\u043e\u0442\u0443. \u0411\u043e \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043d\u0430 \u0441\u0430\u043c\u043e\u0446\u0435 \u0437\u0434\u0430\u0431\u044b\u043b\u0456 \u0411\u043e\u0436\u0443\u044e \u043c\u043e\u0446. \u0410\u043b\u0435 \u0442\u0430\u043a\u0456\u043c\u0456 \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0431\u044b\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435\u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044e. \u0414\u0437\u0435\u043b\u044f \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0411\u043e\u0433\u0430: \u044f\u043a \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0437 \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u0401\u043d \u0432\u044b\u043b\u0435\u0447\u044b\u045e \u0443\u0441\u0435 \u043b\u044e\u0434\u0441\u043a\u0456\u044f \u0445\u0432\u0430\u0440\u043e\u0431\u044b \u0456 \u043d\u0435\u043c\u0430\u0447. \u0411\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0401\u043d \u0443\u0437\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u043d\u0430\u0448\u0443\u044e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u043d\u0451\u0441 \u043d\u0430\u0448\u044b\u044f \u0445\u0432\u0430\u0440\u043e\u0431\u044b&raquo; (\u041c\u0446 8, 17). \u0422\u0430\u043c\u0443 \u045e\u0441\u0435 \u0441\u0432\u044f\u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u0456\u0434\u0443\u0446\u044c \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u0430\u0431 \u0432\u044b\u043b\u0435\u0447\u044b\u0446\u044c \u0456\u0445, \u0432\u0430 \u045e\u0441\u0456\u043c \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u0441\u0442\u0430\u0446\u044c \u0443\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 &ndash; \u044f\u043a \u0410\u0439\u0446\u0435\u0446 \u0456 \u0421\u044b\u043d &ndash; \u0441\u0430\u043c\u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u044f \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0432\u0430\u043c \u0441\u0456\u043b\u0443 \u0441\u0430\u043c\u043e\u0442\u044b \u0456 \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u044f\u043d\u0430 \u045e\u0441\u0451 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u0435 \u0456 \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u0430 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u044f \u0411\u043e\u0433\u0443. \u041d\u0430\u043f\u0456\u0441\u0430\u045e \u0432\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u0431\u044b\u043b\u0456 \u043c\u043e\u0446\u043d\u044b\u043c\u0456 \u045e \u0442\u044b\u043c, \u0447\u0430\u043c\u0443 \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0435\u0446\u0435, \u0456 \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u043b\u0456, \u0448\u0442\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0430\u043c\u043e\u0446\u0435 \u045e\u0441\u0435 \u0441\u0432\u044f\u0442\u044b\u044f \u0434\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456. \u0423 \u0456\u0445 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u043e\u0446 \u0411\u043e\u0436\u0430\u044f, \u0456 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0456\u043c \u0431\u044b\u043b\u043e \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u0443\u044e, \u0430 \u042f\u0433\u043e \u043b\u0430\u0441\u043a\u0430 \u0441\u043f\u044b\u043d\u0456\u043b\u0430 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0406 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0456\u0448\u0430 \u0432\u0430\u043c \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u043f\u0440\u0430\u0437 \u0441\u0430\u043c\u043e\u0442\u0443 \u0434\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u0442\u0430\u043a\u043e\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f \u0451\u0441\u0446\u044c \u0448\u043c\u0430\u0442 \u0430\u043d\u0430\u0445\u0430\u0440\u044d\u0442\u0430\u045e, \u044f\u043a\u0456\u044f \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0441\u0430\u043c\u043e\u0446\u0435, \u0431\u043e \u043d\u0435 \u0437\u043c\u0430\u0433\u043b\u0456 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0447\u044b \u0441\u0432\u0430\u044e \u0432\u043e\u043b\u044e. \u0422\u0430\u043c\u0443 \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u0437\u043c\u043e\u0433 \u0430\u0434\u0440\u0430\u0447\u044b\u0441\u044f \u0430\u0434 \u0441\u044f\u0431\u0435 \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u043f\u0440\u044b\u0437\u0432\u044b\u0447\u0430\u0435\u043d\u043d\u0456, \u0448\u0442\u043e \u0432\u044b\u043d\u0456\u043a\u0430\u044e\u0446\u044c \u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u0437\u043c\u043e\u0433 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u045e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435, \u0443\u043f\u0430\u0440\u0442\u0430 \u0436\u044b\u0432\u0443\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439. \u0410 \u043f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0441\u0430\u043c\u043e\u0442\u0443, \u0437\u0430\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0431\u043b\u0456\u0437\u043a\u0456\u043c\u0456, \u0440\u0430\u0434\u0443\u044e\u0447\u044b\u0441\u044f \u0433\u044d\u0442\u0430\u043c\u0443 \u043f\u0440\u0430\u0437 \u0443\u0441\u0451 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0431\u044b\u043b\u0456 \u0433\u043e\u0434\u043d\u044b\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f \u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u045e \u0456\u0445 \u0411\u043e\u0436\u0430\u044f \u043c\u043e\u0446. \u041a\u0430\u043b\u0456 \u0436 \u0430\u0431&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0456\u043c \u0411\u043e\u0436\u0430\u044f \u043c\u043e\u0446, \u0437\u0430\u0441\u0442\u0430\u0435 \u0456\u0445 \u0443 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0456 \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u043c \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044f\u043c, \u0456 \u0437 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u044b\u0441\u0446\u0456 \u043d\u0430 \u0456\u0445. \u0411\u0435\u0437\u0443\u043c\u043e\u045e\u043d\u0430, \u043d\u0456 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0433\u0440\u043e\u0448\u0430\u0439, \u043d\u0456 \u043f\u0443\u0441\u0442\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u0437 \u0431\u043e\u043a\u0443 \u043b\u044e\u0434\u0437\u0435\u0439, \u043d\u0456 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u044f \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u044f \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u0456 \u0437\u0430\u043d\u044f\u0442\u043a\u0456 \u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u044e\u0446\u044c, \u043a\u0430\u0431 \u043c\u043e\u0446 \u0411\u043e\u0436\u0430\u044f \u0441\u044b\u0448\u043b\u0430 \u043d\u0430 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u0436 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043c\u043e\u0446\u043d\u044b\u043c\u0456 \u045e \u0442\u044b\u043c, \u0447\u0430\u043c\u0443 \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0435\u0446\u0435. \u0411\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0441\u0430\u043c\u043e\u0442\u0443, \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0435\u0440\u0430\u0430\u0434\u043e\u043b\u0435\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430 \u043a\u0430\u043b\u0456 \u043f\u0430\u0434\u0434\u0430\u044e\u0446\u0446\u0430 \u0451\u0439, \u043d\u0435 \u045e\u043c\u0435\u044e\u0446\u044c \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0432\u043e\u0440\u0430\u0433\u0430\u043c. \u0412\u044b \u0436 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435\u0446\u0435 \u0441\u0432\u0430\u044e \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0446\u0435\u0448\u044b\u0446\u0435\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044e \u0411\u043e\u0436\u0430\u0439 \u043c\u043e\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0424\u043b\u043f 3, 8\u0430. 10; \u0420\u044b\u043c 6, 8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0451 \u043b\u0456\u0447\u0443 \u0441\u0442\u0440\u0430\u0442\u0430\u044e \u0434\u0437\u0435\u043b\u044f \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u042f\u0433\u043e \u0456 \u043c\u043e\u0446 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0456 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u042f\u0433\u043e\u043d\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0436 \u043c\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0442\u043e \u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0456 \u0436\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435\u043c \u0437 \u0406\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u042f\u0433\u043e \u0456 \u043c\u043e\u0446 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0456 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u042f\u0433\u043e\u043d\u044b\u0445.<\/p>\r\n"}, {"GCH_CH_2_ID":"700","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u043d\u0430 \u0442\u044d\u043c\u0443 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041c\u0430\u0446\u0432\u0435\u044f&raquo; \u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 65, 2-4: PG 58, 619-622)<\/span><br \/><span style=\"color: #ff0000;\">\u0423\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0456 \u043c\u0443\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044b\u043d\u044b \u0417\u044d\u0431\u044d\u0434\u044d\u044f \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0446\u044c \u0430\u0434 \u0417\u0431\u0430\u045e\u0446\u044b: &laquo;\u0414\u0430\u0439 \u043d\u0430\u043c \u0441\u0435\u0441\u0446\u0456 \u0430\u0434\u043d\u0430\u043c\u0443 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447, \u0430 \u0434\u0440\u0443\u0433\u043e\u043c\u0443 \u043b\u0435\u0432\u0430\u0440\u0443\u0447 \u0426\u044f\u0431\u0435&raquo; (\u041c\u043a 10, 37). \u0406 \u0448\u0442\u043e \u043d\u0430 \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441? \u041a\u0430\u0431 \u0432\u044b\u044f\u0432\u0456\u0446\u044c \u043f\u0440\u044b\u0437\u0435\u043c\u043b\u0435\u043d\u0430\u0441\u0446\u044c \u0456\u0445 \u043f\u0440\u043e\u0441\u044c\u0431\u044b, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0431 \u044f\u043d\u044b \u0432\u0435\u0434\u0430\u043b\u0456, \u0430\u0431 \u0447\u044b\u043c \u043f\u0440\u043e\u0441\u044f\u0446\u044c, \u043d\u0456\u043a\u043e\u043b\u0456 \u0431 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0456, \u043a\u0430\u0436\u0430: &laquo;\u041d\u0435 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0430\u0431 \u0447\u044b\u043c \u043f\u0440\u043e\u0441\u0456\u0446\u0435&raquo;, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c: \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u044f\u043a\u0430\u044f \u0433\u044d\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430, \u044f\u043a\u0430\u044f \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0432\u0430\u0442 \u0430\u043d\u0451\u043b\u044c\u0441\u043a\u0456\u044f \u043c\u043e\u0446\u044b. \u0417\u0430\u0442\u044b\u043c \u0434\u0430\u0434\u0430\u0435: &laquo;\u0426\u0456 \u043c\u043e\u0436\u0430\u0446\u0435 \u043f\u0456\u0446\u044c \u043a\u0435\u043b\u0456\u0445, \u044f\u043a\u0456 \u042f \u043f&rsquo;\u044e, \u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0445\u0440\u043e\u0441\u0442, \u044f\u043a\u0456\u043c \u042f \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b?&raquo; (\u041c\u043a 10, 38). \u0420\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u0446\u0435 \u0441\u0430 \u041c\u043d\u043e\u044e \u043f\u0440\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u043f\u0430\u0441\u0430\u0434\u044b \u0456 \u045e\u0448\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0456, \u0430 \u042f \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u044e \u0432\u0430\u043c \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0456 \u0446\u044f\u0436\u0430\u0440\u044b. \u0413\u044d\u0442\u044b \u0447\u0430\u0441 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0447\u0430\u0441\u0430\u043c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434, \u0456 \u043d\u0435 \u0446\u044f\u043f\u0435\u0440 \u0430\u0434\u043a\u0440\u044b\u0435\u0446\u0446\u0430 \u041c\u0430\u044f \u0445\u0432\u0430\u043b\u0430; \u0433\u044d\u0442\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0447\u0430\u0441\u0430\u043c \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430, \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f \u0456 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u044f\u043a \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u0456\u043c \u043f\u044b\u0442\u0430\u043d\u043d\u0435\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u0456\u0445 \u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435. \u041d\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0426\u0456 \u0432\u044b \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c? \u0426\u0456 \u0437\u043c\u043e\u0436\u0430\u0446\u0435 \u043f\u0440\u0430\u043b\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e?&raquo; \u0410\u043b\u0435 \u0448\u0442\u043e \u043a\u0430\u0436\u0430? &laquo;\u0426\u0456 \u043c\u043e\u0436\u0430\u0446\u0435 \u043f\u0456\u0446\u044c \u043a\u0435\u043b\u0456\u0445?&raquo; \u0406 \u043a\u0430\u0431 \u0456\u0445 \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0430\u0445\u0432\u043e\u0447\u044b\u043c\u0456 \u0434\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0437 \u0441\u0430\u0431\u043e\u0439, \u0434\u0430\u0434\u0430\u0435: &laquo;\u044f\u043a\u0456 \u042f \u043f&rsquo;\u044e&raquo;. \u0413\u044d\u0442\u044b \u043a\u0435\u043b\u0456\u0445 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0445\u0440\u043e\u0441\u0442\u0430\u043c, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0441\u0442\u0430\u043d\u0435 \u0451\u043d \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u0435\u043c \u0443\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443. \u0412\u0443\u0447\u043d\u0456 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c: &laquo;\u041c\u043e\u0436\u0430\u043c&raquo;. \u0423 \u0437\u0430\u043f\u0430\u043b\u0435 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u0430\u0434\u0440\u0430\u0437\u0443. \u041d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0446\u044c, \u0448\u0442\u043e \u043a\u0430\u0436\u0443\u0446\u044c, \u0430\u0434\u043d\u0430\u043a \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0415\u0437\u0443\u0441? &laquo;\u041a\u0435\u043b\u0456\u0445, \u044f\u043a\u0456 \u042f \u043f&rsquo;\u044e, \u043f\u0456\u0446\u044c \u0431\u0443\u0434\u0437\u0435\u0446\u0435, \u0456 \u0445\u0440\u043e\u0441\u0442\u0430\u043c, \u044f\u043a\u0456\u043c \u042f \u0445\u0440\u044b\u0448\u0447\u0443\u0441\u044f, \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b&raquo; (\u041c\u043a 10, 39). \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0456\u043c \u0434\u0430\u0431\u0440\u043e\u0442\u044b: \u0441\u0442\u0430\u043d\u0435\u0446\u0435 \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430. \u0412\u0430 \u045e\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0441\u0430 \u041c\u043d\u043e\u044e. &laquo;\u0410\u043b\u0435 \u0434\u0430\u0446\u044c \u0441\u0435\u0441\u0446\u0456 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0446\u0456 \u043b\u0435\u0432\u0430\u0440\u0443\u0447 \u041c\u044f\u043d\u0435 \u043d\u0435 \u0430\u0434 \u041c\u044f\u043d\u0435 \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c, \u0430 \u043a\u0430\u043c\u0443 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430&raquo; (\u041c\u043a 10, 40). \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0456\u0445 \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u0435, \u0443\u0447\u044b\u043d\u0456\u045e \u0448\u043b\u044f\u0445\u0435\u0442\u043d\u044b\u043c \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0456\u0445 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f, \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b \u0432\u044b\u043f\u0440\u0430\u045e\u043b\u044f\u0435 \u0456\u0445 \u043f\u0440\u043e\u0441\u044c\u0431\u0443.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0430\u0447\u0443\u045e\u0448\u044b, \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0432\u0443\u0447\u043d\u044f\u045e \u0430\u0431\u0443\u0440\u044b\u043b\u0456\u0441\u044f \u043d\u0430 \u0434\u0432\u0443\u0445 \u0431\u0440\u0430\u0442\u043e\u045e&raquo; (\u041c\u0446 20, 24). \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f\u0448\u0447\u044d \u044f\u043d\u044b \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u044f. \u042f\u043a \u0433\u044d\u0442\u044b\u044f \u0434\u0432\u043e\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u043b\u0456 \u045e\u0437\u0432\u044b\u0441\u0456\u0446\u0446\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0434\u0437\u0435\u0441\u044f\u0446\u0446\u044e, \u0442\u0430\u043a \u0456 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f \u0437\u0430\u0439\u0437\u0434\u0440\u043e\u0441\u0446\u0456\u043b\u0456 \u0433\u044d\u0442\u044b\u043c \u0434\u0432\u0430\u0456\u043c. \u0410\u043b\u0435, \u044f\u043a \u0443\u0436\u043e \u0441\u043a\u0430\u0437\u0430\u045e, \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u043a\u0456\u043c \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u043f\u0430\u0437\u043d\u0435\u0439, \u0456 \u045e\u0431\u0430\u0447\u044b\u0448 \u0456\u0445 \u0432\u043e\u043b\u044c\u043d\u044b\u043c\u0456 \u0430\u0434 \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044f\u045e. \u042f\u043d, \u0442\u043e\u0439, \u044f\u043a\u0456 \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u0435 \u0437 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u0439, \u0437\u0430\u045e\u0441\u0451\u0434\u044b &ndash; \u044f\u043a \u0440\u0430\u0441\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u0414\u0437\u0435\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e &ndash; \u0441\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u045e \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u0435 \u041f\u044f\u0442\u0440\u0443, \u0446\u0456 \u0442\u043e \u045e \u043f\u0440\u0430\u043c\u043e\u0432\u0435, \u0446\u0456 \u0442\u043e \u045e \u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0446\u0443\u0434\u0430\u045e. \u0410\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u045e \u043f\u043e\u045e\u043d\u044b \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u0434\u0430\u0440\u0432\u0430\u043d\u044b \u0430\u0434 \u0441\u043f\u0440\u0430\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u045e \u0442\u0430\u043a\u043e\u0433\u0430 \u0432\u044b\u0441\u043e\u043a\u0430\u0433\u0430 \u045e\u0437\u0440\u043e\u045e\u043d\u044e \u0446\u043d\u043e\u0442\u0430\u045e, \u0448\u0442\u043e \u045e \u0445\u0443\u0442\u043a\u0456\u043c \u0447\u0430\u0441\u0435 \u043f\u0430\u0441\u0442\u0430\u043b\u0435\u045e \u0434\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 19 (18), 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u044b \u0441\u0432\u0430\u0456\u043c \u0437\u044f\u043c\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0437\u0440\u0430\u0431\u0456\u045e \u043f\u043b\u043e\u0434\u043d\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b. <span style=\"color: #ff0000;\">*<\/span> \u042f\u043d\u044b \u043f\u0456\u043b\u0456 \u0437 \u043a\u0435\u043b\u0456\u0445\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0431\u044b\u043b\u0456 \u042f\u0433\u043e \u0441\u044f\u0431\u0440\u0430\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0440\u0430\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0456\u0445 \u0433\u043e\u043b\u0430\u0441, \u0456 \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u0441\u0443\u0441\u0432\u0435\u0442\u0443 \u0441\u043b\u043e\u0432\u044b \u0456\u0445\u043d\u0456\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043d\u044b \u043f\u0456\u043b\u0456 \u0437 \u043a\u0435\u043b\u0456\u0445\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0431\u044b\u043b\u0456 \u042f\u0433\u043e \u0441\u044f\u0431\u0440\u0430\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"701","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u042f\u043d\u0430 \u0414\u0430\u043c\u0430\u0441\u043a\u0456\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Orat. 6, in Nativitatem B. Mariae V., 2. 4. 5. 6: PG 96, 663. 667. 670)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430 \u0456\u0445\u043d\u0456\u0445 \u043f\u043b\u0430\u0434\u0430\u0445 \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435 \u0456\u0445<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0414\u0437\u0435\u0432\u0430 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u0430\u0434 \u0413\u0430\u043d\u043d\u044b, \u043d\u0430\u0442\u0443\u0440\u0430 \u043d\u0435 \u0430\u0441\u043c\u0435\u043b\u0456\u043b\u0430\u0441\u044f \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u0437\u0456\u0446\u044c \u043b\u0430\u0441\u043a\u0443: \u044f\u043d\u0430 \u0437\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0431\u0435\u0437 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0433\u0430 \u0441\u0430\u0431\u0435 \u043f\u043b\u0451\u043d\u0443, \u043f\u0430\u043a\u0443\u043b\u044c \u043b\u0430\u0441\u043a\u0430 \u043d\u0435 \u0434\u0430\u043b\u0430 \u0441\u0432\u043e\u0439 \u043f\u043b\u0451\u043d. \u0411\u043e \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e, \u043a\u0430\u0431 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u0430\u0439 \u0431\u044b\u043b\u0430 \u0442\u0430\u044f, \u0437 \u044f\u043a\u043e\u0439 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b, \u0443 \u044f\u043a\u0456\u043c &laquo;\u0443\u0441\u0451 \u0442\u0440\u044b\u0432\u0430\u0435&raquo; (\u041a\u043b\u0441 1, 17).<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0441\u0443\u0436\u044d\u043d\u0446\u044b, \u042f\u045e\u0445\u0456\u043c \u0456 \u0413\u0430\u043d\u043d\u0430! \u041f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456 \u045e \u0434\u0430\u045e\u0433\u0443 \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435. \u041f\u0440\u0430\u0437 \u0432\u0430\u0448\u0430\u0435 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430 \u044f\u043d\u043e \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u0441\u0432\u0430\u0439\u043c\u0443 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044e \u043d\u0430\u0439\u0446\u0443\u0434\u043e\u045e\u043d\u0435\u0439\u0448\u044b \u0434\u0430\u0440: \u043d\u0430\u0439\u0447\u044b\u0441\u0446\u0435\u0439\u0448\u0443\u044e \u041c\u0430\u0446\u0456, \u0430\u0434\u0437\u0456\u043d\u0430 \u0433\u043e\u0434\u043d\u0443\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0437\u0440\u0430\u0434\u0443\u0439\u0441\u044f, \u0413\u0430\u043d\u043d\u0430 &laquo;\u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u0430\u044f, \u044f\u043a\u0430\u044f \u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430; \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0439 \u0430\u0434 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0441\u044f, \u044f\u043a\u0430\u044f \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0431\u043e\u043b\u044e \u0440\u043e\u0434\u0430\u045e!&raquo; (\u0406\u0441 54, 1). \u0420\u0430\u0434\u0443\u0439\u0441\u044f, \u042f\u045e\u0445\u0456\u043c, \u0431\u043e \u0437 \u0442\u0432\u0430\u0451\u0439 \u0434\u0430\u0447\u043a\u0456 \u0414\u0437\u0456\u0446\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u043c, \u0421\u044b\u043d \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430\u043c; \u0456 \u043d\u0430\u0437\u0432\u0430\u043b\u0456 \u042f\u0433\u043e \u0412\u0435\u0441\u0442\u0443\u043d\u043e\u043c \u0411\u043e\u0436\u044b\u0445 \u043d\u0430\u043c\u0435\u0440\u0430\u045e, \u0412\u0435\u0441\u0442\u0443\u043d\u043e\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443 \u0456 \u0411\u043e\u0433\u0430\u043c \u043c\u043e\u0446\u043d\u044b\u043c (\u043f\u0430\u0440. \u0406\u0441 9, 6). \u0421\u0430\u043c \u0411\u043e\u0433 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u044b\u043c \u0414\u0437\u0456\u0446\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u042f\u045e\u0445\u0456\u043c \u0456 \u0413\u0430\u043d\u043d\u0430, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u044f \u0441\u0443\u0436\u044d\u043d\u0446\u044b! \u0417 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u043b\u043e\u0434\u0443 \u0432\u044b \u0434\u0430\u0435\u0446\u0435 \u0441\u044f\u0431\u0435 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u041f\u0430\u043d\u0430: &laquo;\u041f\u0430 \u0456\u0445\u043d\u0456\u0445 \u043f\u043b\u0430\u0434\u0430\u0445 \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435 \u0456\u0445&raquo; (\u041c\u0446 7, 16). \u0412\u044b \u0442\u0430\u043a \u0432\u044f\u043b\u0456 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451, \u043a\u0430\u0431 \u044f\u043d\u043e \u0431\u044b\u043b\u043e \u043c\u0456\u043b\u0430\u0435 \u0411\u043e\u0433\u0443 \u0456 \u0433\u043e\u0434\u043d\u0430\u0435 \u0442\u043e\u0439, \u044f\u043a\u0430\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0430\u0434 \u0432\u0430\u0441. \u0421\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u044b\u043c \u0456 \u0447\u044b\u0441\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u0432\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456 \u043f\u044f\u0440\u043b\u0456\u043d\u0443 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430: \u0414\u0437\u0435\u0432\u0443 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435\u043c, \u0414\u0437\u0435\u0432\u0443 \u043f\u0430\u0434\u0447\u0430\u0441 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0456 \u0414\u0437\u0435\u0432\u0443 \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430. \u042f\u043d\u0430 \u0430\u0434\u0437\u0456\u043d\u0430\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0430 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430 \u0434\u0443\u0448\u044b , \u0434\u0443\u0445\u0430 \u0456 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u043d\u0430\u0439\u0447\u044b\u0441\u0446\u0435\u0439\u0448\u044b\u044f \u0441\u0443\u0436\u044d\u043d\u0446\u044b, \u042f\u045e\u0445\u0456\u043c \u0456 \u0413\u0430\u043d\u043d\u0430! \u0417\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0443\u044e \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u043f\u0440\u044b\u0440\u043e\u0434\u044b \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c, \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0411\u043e\u0436\u0443\u044e \u043b\u0430\u0441\u043a\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0442\u0443\u0440\u0443; \u0432\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456 \u043d\u0430 \u0441\u0432\u0435\u0442 \u0442\u0443\u044e, \u044f\u043a\u0430\u044f, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0447\u044b \u043c\u0443\u0436\u0430, \u0441\u0442\u0430\u043b\u0430 \u041c\u0430\u0446\u0456 \u0411\u043e\u0433\u0430. \u0412\u044b, \u0431\u0443\u0434\u0443\u0447\u044b \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u0456 \u0436\u044b\u0432\u0443\u0447\u044b \u045e \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0456 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456 \u043d\u0430 \u0441\u0432\u0435\u0442 \u0414\u0430\u0447\u043a\u0443, \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u0437\u0430 \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a\u0430\u044f \u0446\u044f\u043f\u0435\u0440 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041a\u0430\u0440\u0430\u043b\u0435\u0432\u0430\u0439 \u0410\u043d\u0451\u043b\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u043d\u0430\u0439\u043f\u0440\u044b\u0433\u0430\u0436\u044d\u0439\u0448\u0430\u044f \u0456 \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u0430\u044f \u0414\u0437\u0435\u0432\u0430! \u0414\u0430\u0447\u043a\u0430 \u0410\u0434\u0430\u043c\u0430 \u0456 \u041c\u0430\u0446\u0456 \u0411\u043e\u0433\u0430! \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0431\u0430\u0446\u044c\u043a\u0430 \u0442\u0432\u043e\u0439 \u0456 \u043c\u0430\u0446\u0456! \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0440\u0443\u043a\u0456, \u044f\u043a\u0456\u044f \u043d\u0430\u0441\u0456\u043b\u0456 \u0426\u044f\u0431\u0435! \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0432\u0443\u0441\u043d\u044b \u0422\u0432\u0430\u0456\u0445 \u0431\u0430\u0446\u044c\u043a\u043e\u045e, \u044f\u043a\u0456\u044f \u0446\u0430\u043b\u0430\u0432\u0430\u043b\u0456 \u0426\u044f\u0431\u0435 \u0447\u044b\u0441\u0442\u044b\u043c\u0456 \u043f\u0430\u0446\u0430\u043b\u0443\u043d\u043a\u0430\u043c\u0456, \u043a\u0430\u0431 \u0422\u044b \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0430 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430! &laquo;\u0423\u0441\u043a\u043b\u0456\u043a\u0430\u0439 \u041f\u0430\u043d\u0443, \u0443\u0441\u044f \u0437\u044f\u043c\u043b\u044f, \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u0441\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u0456 \u0433\u0440\u0430\u0439\u0446\u0435&raquo; (\u041f\u0441 98 [97], 4). \u0423\u0437\u0434\u044b\u043c\u0456\u0446\u0435 \u0432\u0430\u0448 \u0433\u043e\u043b\u0430\u0441, \u0440\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u0430 \u043d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041b\u043a 2, 37. 38; 7, 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0441\u0442\u0430\u043c\u0456 \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c\u0456 \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0411\u043e\u0433\u0443 \u045e\u0434\u0437\u0435\u043d\u044c \u0456 \u045e\u043d\u0430\u0447\u044b, <span style=\"color: #ff0000;\">*<\/span> \u0447\u0430\u043a\u0430\u044e\u0447\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u044f \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u0430\u0441\u0456\u043b\u0456 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u043d\u0430\u0432\u0435\u0434\u0430\u045e \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0427\u0430\u043a\u0430\u044e\u0447\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u044f \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"702","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 103, 1-2. 6: PL 38, 613. 615)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u0445\u0442\u043e \u043c\u0435\u045e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0437\u0430\u043f\u0440\u0430\u0441\u0456\u0446\u044c \u041f\u0430\u043d\u0430 \u045e \u0441\u0432\u043e\u0439 \u0434\u043e\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u043e\u0432\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u043c, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043d\u0430 \u043c\u044d\u0442\u0430, \u0434\u0430 \u044f\u043a\u043e\u0439 \u043c\u044b \u0456\u0434\u0437\u0435\u043c \u0441\u044f\u0440\u043e\u0434 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0406\u0434\u0437\u0451\u043c \u044f\u043a \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0456, \u0430 \u043d\u0435 \u0436\u044b\u0445\u0430\u0440\u044b, \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0434\u0430\u0440\u043e\u0437\u0435, \u0430 \u043d\u0435 \u043a\u0430\u043b\u044f \u043c\u044d\u0442\u044b, \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u043d\u0435 \u043c\u0430\u0435. \u0410\u0434\u043d\u0430\u043a \u0456\u0434\u0437\u0435\u043c \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0456 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430, \u043a\u0430\u0431 \u043a\u0430\u043b\u0456-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u043c\u044d\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0440\u0442\u0430 \u0456 \u041c\u0430\u0440\u044b\u044f \u0431\u044b\u043b\u0456 \u0441\u0451\u0441\u0442\u0440\u0430\u043c\u0456. \u042f\u0434\u043d\u0430\u043b\u0430 \u0456\u0445 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0432\u0430\u044f\u0446\u0442\u0432\u0430, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c. \u0410\u0431\u0435\u0434\u0437\u0432\u0435 \u0431\u044b\u043b\u0456 \u0430\u0434\u0434\u0430\u043d\u044b\u044f \u0411\u043e\u0433\u0443, \u0430\u0431\u0435\u0434\u0437\u044c\u0432\u0435 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u041f\u0430\u043d\u0443, \u044f\u043a\u0456 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u045e \u0443 \u0446\u0435\u043b\u0435. \u041c\u0430\u0440\u044b\u044f \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u042f\u0433\u043e \u0442\u0430\u043a, \u044f\u043a \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u043f\u0440\u044b\u043c\u0430\u043b\u0456 \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u044b\u0445. \u0410\u0434\u043d\u0430\u043a \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u0441\u043b\u0443\u0433\u0430 \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u041f\u0430\u043d\u0430, \u0445\u0432\u043e\u0440\u0430\u044f &ndash; \u041b\u0435\u043a\u0430\u0440\u0430, \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 &ndash; \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f. \u0422\u0430\u044f, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u0435\u0436\u0443, \u043f\u0440\u044b\u043d\u044f\u043b\u0430, \u043a\u0430\u0431 \u043f\u0440\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u0435\u0436\u0443 \u0434\u043b\u044f \u0446\u0435\u043b\u0430. \u041f\u0430\u043d \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456 \u0456 \u045e \u0433\u044d\u0442\u0430\u0439 \u043f\u043e\u0441\u0442\u0430\u0446\u0456 &ndash; \u043d\u0435 \u043f\u0430 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456 &ndash; \u043f\u0440\u044b\u043c\u0430\u045e \u043f\u0430\u0441\u0456\u043b\u0430\u043a, \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u043d\u044b \u042f\u043c\u0443 \u0441\u043b\u0443\u0433\u0430\u043c\u0456, \u0431\u043e \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u0435 \u043f\u0430\u0441\u0456\u043b\u043a\u0443 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u044b\u043b\u043e \u043b\u0430\u0441\u043a\u0430\u0439. \u042f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0401\u043d \u0430\u0434\u0447\u0443\u0432\u0430\u045e \u0433\u043e\u043b\u0430\u0434 \u0456 \u0441\u043c\u0430\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0431\u044b\u045e \u043f\u0440\u044b\u043d\u044f\u0442\u044b \u044f\u043a \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u043a, \u044f\u043a\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0441\u0432\u0430\u0456\u0445, \u0456 \u0441\u0432\u0430\u0435 \u042f\u0433\u043e \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456, \u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u045e \u042f\u0433\u043e, \u0434\u0430\u045e \u0443\u043b\u0430\u0434\u0443 \u0441\u0442\u0430\u0446\u044c \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 (\u043f\u0430\u0440. \u042f\u043d 1, 11-12). \u0414\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0431\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0441\u0430\u0431\u043e\u044e \u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0456\u0445 \u0431\u0440\u0430\u0442\u0430\u043c\u0456; \u0432\u044b\u043a\u0443\u043f\u0456\u045e \u0432\u044f\u0437\u043d\u044f\u045e \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0456\u0445 \u0441\u0443\u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c\u0456. \u0410\u043b\u0435 \u043d\u0456\u0445\u0442\u043e \u0437 \u0432\u0430\u0441 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u043a\u0430\u0436\u0430: &laquo;\u042f\u043a\u0456\u044f \u0436 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0442\u044b\u044f, \u0445\u0442\u043e \u043c\u0435\u045e \u0448\u0447\u0430\u0441\u0446\u0435 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0434\u043e\u043c\u0435!&raquo; \u041d\u0435 \u0441\u0443\u043c\u0443\u0439 \u0456 \u043d\u0435 \u043d\u0430\u0440\u0430\u043a\u0430\u0439, \u0448\u0442\u043e \u0436\u044b\u0432\u0435\u0448 \u0443 \u0447\u0430\u0441\u044b, \u043a\u0430\u043b\u0456 \u045e\u0436\u043e \u043d\u0435 \u043c\u043e\u0436\u0430\u0448 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u041f\u0430\u043d\u0430 \u045e \u0446\u0435\u043b\u0435. \u0401\u043d \u043d\u0435 \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0440\u044b\u0432\u0456\u043b\u0435\u044e: &laquo;\u0422\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0430\u0434\u043d\u0430\u043c\u0443 \u0437 \u0433\u044d\u0442\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u041c\u0430\u0456\u0445 \u043c\u0435\u043d\u0448\u044b\u0445, \u0432\u044b \u041c\u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0456&raquo; (\u041c\u0446 25, 40).<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0440\u044d\u0447\u044b, \u041c\u0430\u0440\u0442\u0430, \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435, \u0434\u0430\u0437\u0432\u043e\u043b\u044c, \u0448\u0442\u043e \u0441\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435: \u043f\u0440\u043e\u0441\u0456\u0448 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443 \u044f\u043a \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0437\u0430 \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u0446\u0443. \u0426\u044f\u043f\u0435\u0440 \u0442\u044b \u0437\u0430\u043d\u044f\u0442\u0430\u044f \u043c\u043d\u043e\u0433\u0456\u043c\u0456 \u043f\u0430\u0441\u043b\u0443\u0433\u0430\u043c\u0456 &ndash; \u0445\u043e\u0447\u0430\u0448 \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u044f, \u0445\u043e\u0446\u044c \u0441\u0432\u044f\u0442\u044b\u044f \u0446\u0435\u043b\u044b. \u0410\u043b\u0435 \u0445\u0443\u0442\u043a\u0430 \u043f\u0440\u044b\u0431\u0443\u0434\u0437\u0435\u0448 \u0443\u0436\u043e \u045e \u0430\u0439\u0447\u044b\u043d\u0443. \u0426\u0456 \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0435\u0448 \u0442\u0430\u043c \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0430\u0433\u0430, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u044f\u0433\u043e? \u0426\u0456 \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0435\u0448 \u0433\u0430\u043b\u043e\u0434\u043d\u0430\u0433\u0430, \u043a\u0430\u0431 \u043d\u0430\u043a\u0430\u0440\u043c\u0456\u0446\u044c \u044f\u0433\u043e? \u041f\u0440\u0430\u0433\u043d\u0443\u0447\u0430\u0433\u0430, \u043a\u0430\u0431 \u043d\u0430\u043f\u0430\u0456\u0446\u044c \u044f\u0433\u043e? \u0425\u0432\u043e\u0440\u0430\u0433\u0430, \u043a\u0430\u0431 \u0430\u0434\u0432\u0435\u0434\u0430\u0446\u044c \u044f\u0433\u043e? \u0420\u0430\u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b\u0445, \u043a\u0430\u0431 \u043f\u0430\u044f\u0434\u043d\u0430\u0446\u044c? \u041f\u0430\u043c\u0435\u0440\u043b\u0430\u0433\u0430, \u043a\u0430\u0431 \u043f\u0430\u0445\u0430\u0432\u0430\u0446\u044c?<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0430\u0439\u0447\u044b\u043d\u0435 \u045e\u0436\u043e \u045e\u0441\u044f\u0433\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435. \u0410 \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435? \u0422\u043e\u0435, \u0448\u0442\u043e \u0432\u044b\u0431\u0440\u0430\u043b\u0430 \u041c\u0430\u0440\u044b\u044f: \u0442\u0430\u043c \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u044b\u0447\u0430\u043d\u044b\u044f, \u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0456\u043b\u043a\u0430\u0432\u0430\u0446\u0446\u0430. \u0422\u043e\u0435, \u0448\u0442\u043e \u041c\u0430\u0440\u044b\u044f \u0432\u044b\u0431\u0440\u0430\u043b\u0430 \u0442\u0443\u0442, \u0442\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0456 \u043f\u043e\u045e\u043d\u044b\u043c. \u0422\u0443\u0442, \u0437 \u0437\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0441\u0442\u0430\u043b\u0430 \u044f\u043d\u0430 \u0437\u0431\u0456\u0440\u0430\u043b\u0430 \u043a\u0440\u044b\u0448\u044b\u043d\u043a\u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u0441\u043b\u043e\u0432\u0430. \u0425\u043e\u0447\u0430\u0448 \u0432\u0435\u0434\u0430\u0446\u044c, \u044f\u043a \u0431\u0443\u0434\u0437\u0435 \u045e \u043d\u0435\u0431\u0435? \u0412\u043e\u0441\u044c \u0436\u0430 \u0441\u0430\u043c \u041f\u0430\u043d \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e: &laquo;\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043a\u0430\u0436\u0443 \u0432\u0430\u043c, \u0448\u0442\u043e \u0451\u043d \u043f\u0430\u0434\u043f\u044f\u0440\u0430\u0436\u0430\u0446\u0446\u0430 \u0456 \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u0446\u044c \u0456\u0445 \u0456, \u043f\u0430\u0434\u044b\u0448\u043e\u045e\u0448\u044b, \u043f\u0430\u0447\u043d\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0456\u043c&raquo; (\u041b\u043a 12, 37).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0415\u0437\u0443\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u041b\u0430\u0437\u0430\u0440\u0430, <span style=\"color: #ff0000;\">*<\/span> \u043d\u0430\u043b\u0430\u0434\u0437\u0456\u043b\u0456 \u0433\u0430\u0441\u0446\u0456\u043d\u0443 \u045e \u0411\u044d\u0442\u0430\u043d\u0456\u0456. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410 \u041c\u0430\u0440\u044b\u044f \u045e\u0437\u044f\u043b\u0430 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b \u0430\u043b\u0435\u0439 \u0456 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u043b\u0430 \u043d\u043e\u0433\u0456 \u0415\u0437\u0443\u0441\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0415\u0437\u0443\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u041b\u0430\u0437\u0430\u0440\u0430, <span style=\"color: #ff0000;\">*<\/span> \u043d\u0430\u043b\u0430\u0434\u0437\u0456\u043b\u0456 \u0433\u0430\u0441\u0446\u0456\u043d\u0443 \u045e \u0411\u044d\u0442\u0430\u043d\u0456\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"703","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u0425\u0440\u044b\u0437\u0430\u043b\u043e\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 148: PL 52, 596-598)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0440\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0423\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u0432\u0430 \u0437\u0430\u0447\u0430\u043b\u0430, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0456 \u0437\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0414\u0437\u0435\u0432\u0430\u0439. \u041d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u0440\u044d\u0447\u0447\u0443, \u0430\u043b\u0435 \u0437\u043d\u0430\u043a\u0430\u043c; \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0440\u043e\u0437\u0443\u043c, \u0430\u043b\u0435 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u0411\u043e\u0436\u0430\u0439 \u043c\u043e\u0446\u044b; \u0433\u044d\u0442\u0430 \u043d\u0435 \u0442\u0432\u043e\u0440 \u043d\u0430\u0442\u0443\u0440\u044b, \u0430\u043b\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u044f\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u045e; \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430 \u0447\u044b\u043c\u0441\u044c\u0446\u0456 \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u044b\u043c, \u0430\u043b\u0435 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435\u043c; \u0433\u044d\u0442\u0430 \u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430, \u0430\u043b\u0435 \u0411\u043e\u0436\u0430\u044f. \u041d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u0432\u044b\u043d\u0456\u043a\u0430\u043c \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u043c\u043e\u0446\u044b. \u0411\u044b\u043b\u043e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0456 \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u041d\u0435\u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0437 \u043d\u0435\u043a\u0440\u0430\u043d\u0443\u0442\u0430\u0439 \u0433\u043b\u0456\u043d\u044b, \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u044f\u0433\u043e, \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e\u0447\u044b \u0437 \u0434\u0437\u044f\u0432\u043e\u0447\u0430\u0433\u0430 \u0446\u0435\u043b\u0430. \u0420\u0443\u043a\u0430, \u044f\u043a\u0430\u044f \u043f\u0430\u0436\u0430\u0434\u0430\u043b\u0430 \u045e\u0437\u044f\u0446\u044c \u0433\u043b\u0456\u043d\u0443, \u043a\u0430\u0431 \u043d\u0430\u0441 \u0441\u0442\u0432\u0430\u0440\u044b\u0446\u044c, \u0437\u0430\u0445\u0430\u0446\u0435\u043b\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u043d\u0430\u0441 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c. \u0422\u043e\u0435, \u0448\u0442\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u045e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456, \u0411\u043e\u0433 &ndash; \u0443 \u0446\u0435\u043b\u0435, \u043d\u0435 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u043b\u0430 \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 \u045e\u0437\u0432\u044b\u0441\u0456\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043b\u0430\u0432\u0435\u043a, \u0447\u0430\u043c\u0443 \u0442\u044b \u0433\u0430\u043d\u044c\u0431\u0456\u0448 \u0441\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0442\u0430\u043a \u0432\u044b\u0441\u043e\u043a\u0430 \u0446\u044f\u0431\u0435 \u0446\u044d\u043d\u0456\u0446\u044c? \u0427\u0430\u043c\u0443, \u0443\u0437\u0432\u044b\u0448\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c, \u0442\u0430\u043a \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u0435\u0448? \u0427\u0430\u043c\u0443 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u0448, \u044f\u043a \u0442\u044b \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043d\u0430 \u0441\u0432\u0435\u0446\u0435, \u0430\u043b\u0435 \u043d\u0435 \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0435\u0448\u0441\u044f, \u0434\u0437\u0435\u043b\u044f \u0447\u0430\u0433\u043e \u0442\u044b \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f? \u0425\u0456\u0431\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u0448, \u0448\u0442\u043e \u045e\u0441\u044f \u0431\u0443\u0434\u043e\u045e\u043b\u044f \u0441\u0432\u0435\u0442\u0443 \u0431\u044b\u043b\u0430 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430 \u0434\u043b\u044f \u0446\u044f\u0431\u0435? \u0421\u043f\u0430\u0441\u043b\u0430\u043d\u0430\u0435 \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u045e\u0441\u044e\u0434\u044b \u0440\u0430\u0441\u0441\u0435\u0439\u0432\u0430\u0435 \u0446\u0435\u043c\u0440\u0443; \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435 \u043d\u043e\u0447 \u043c\u0430\u0435 \u043c\u0435\u0436\u044b; \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435 \u0440\u0430\u0437\u043c\u0435\u0440\u0430\u043d\u044b \u0434\u0437\u0435\u043d\u044c; \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435 \u043d\u0435\u0431\u0430 \u0431\u044b\u043b\u043e \u0430\u043f\u0440\u0430\u043c\u0435\u043d\u0435\u043d\u0430 \u0440\u043e\u0437\u043d\u0430\u043a\u0430\u043b\u044f\u0440\u043e\u0432\u044b\u043c \u0431\u043b\u044f\u0441\u043a\u0430\u043c \u0441\u043e\u043d\u0446\u0430, \u043c\u0435\u0441\u044f\u0446\u0430 \u0456 \u0437\u043e\u0440\u0430\u043a; \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435 \u0437\u044f\u043c\u043b\u044f \u0431\u044b\u043b\u0430 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u0430 \u043a\u0432\u0435\u0442\u043a\u0430\u043c\u0456, \u0434\u0440\u044d\u0432\u0430\u043c\u0456 \u0456 \u043f\u043b\u0430\u0434\u0430\u043c\u0456; \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435 \u0431\u044b\u043b\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0441\u0430\u043c\u044b\u0445 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u0445 \u0437\u0432\u044f\u0440\u043e\u045e \u0443 \u043f\u0430\u0432\u0435\u0442\u0440\u044b, \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u045e \u0432\u0430\u0434\u0437\u0435, \u043a\u0430\u0431 \u0441\u0443\u043c\u043d\u0430\u044f \u0441\u0430\u043c\u043e\u0442\u0430 \u043d\u0435 \u043d\u0456\u0448\u0447\u044b\u043b\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u043e\u0432\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u043e\u0441\u044c \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0448\u0443\u043a\u0430\u0435, \u0448\u0442\u043e \u044f\u0448\u0447\u044d \u043c\u043e\u0433 \u0431\u044b \u0434\u0430\u0434\u0430\u0446\u044c \u0434\u0430 \u0442\u0432\u0430\u0451\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456. \u0401\u043d \u0432\u044b\u0446\u0456\u0441\u043d\u0443\u045e \u043d\u0430 \u0442\u0430\u0431\u0435 \u0441\u0432\u0430\u0451 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430, \u043a\u0430\u0431 \u0431\u0430\u0447\u043d\u044b \u0430\u0434\u0431\u0456\u0442\u0430\u043a \u0437\u0440\u0430\u0431\u0456\u045e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u044b\u043c \u0443 \u0441\u0432\u0435\u0446\u0435 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f. \u0401\u043d \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u0442\u0430\u0431\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0456\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0437\u044f\u043c\u043b\u0451\u0439, \u043a\u0430\u0431 \u0442\u0430\u043a\u0430\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043d\u0435\u0440\u0443\u0445\u043e\u043c\u0430\u0441\u0446\u044c, \u044f\u043a\u043e\u0439 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0432\u0435\u0442, \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0431\u0435\u0437 \u043d\u0430\u043c\u0435\u0441\u043d\u0456\u043a\u0430 \u041f\u0430\u043d\u0430. \u0423 \u0441\u0432\u0430\u0451\u0439 \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456, \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u0430\u043c \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0443 \u0442\u0430\u0431\u0435. \u0401\u043d, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0441\u0442\u0430\u0446\u044c \u0431\u0430\u0447\u043d\u044b\u043c \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u043f\u0440\u0430\u0437 \u0441\u0432\u043e\u0439 \u0430\u0434\u0431\u0456\u0442\u0430\u043a, \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u0446\u0430 \u045e \u0456\u043c \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435; \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0441\u0442\u0430\u0446\u044c \u0442\u044b\u043c, \u043a\u0430\u043c\u0443 \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0431\u044b\u0446\u044c \u0441\u0432\u0430\u0456\u043c \u0430\u0434\u0431\u0456\u0442\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u0432\u0435\u0442, \u043a\u0430\u0431 \u0441\u0432\u0430\u0456\u043c \u043f\u0440\u044b\u0439\u0441\u0446\u0435\u043c \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443. \u0421\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0434\u0437\u0456\u0446\u0435\u043c, \u043f\u0440\u044b\u043c\u0430\u0435 \u0435\u0436\u0443, \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u0447\u0430\u0440\u0433\u043e\u0432\u044b\u044f \u043f\u0435\u0440\u044b\u044f\u0434\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043a\u0430\u0431 \u0432\u044b\u043f\u0440\u0430\u0432\u0456\u0446\u044c \u0433\u044d\u0442\u044b \u0430\u0434\u0437\u0456\u043d, \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u044b \u0441\u0442\u0430\u043d, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0441\u0442\u0432\u0430\u0440\u044b\u045e. \u0411\u044f\u0440\u044d \u043d\u0430 \u0441\u044f\u0431\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439 \u0443\u0436\u043e \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043f\u0430\u0434\u0430\u045e; \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c \u043d\u0435\u0431\u0430 \u0440\u043e\u0431\u0456\u0446\u044c \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c \u0437\u044f\u043c\u043b\u0456; \u0430\u0436\u044b\u045e\u043b\u044f\u0435 \u0411\u043e\u0436\u044b\u043c \u0434\u0443\u0445\u0430\u043c \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0430\u0436\u044b\u0432\u0456\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c \u0434\u0443\u0445\u0430\u043c. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435 \u045e\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043a\u0430\u0431 \u0443\u0436\u043e \u043d\u0456\u0447\u043e\u0433\u0430 \u045e \u0456\u043c \u043d\u0435 \u0431\u044b\u043b\u043e \u0430\u0434 \u0433\u0440\u0430\u0445\u0443, \u0441\u043c\u0435\u0440\u0446\u0456, \u0446\u044f\u0436\u0430\u0440\u0443, \u0431\u043e\u043b\u044e \u0456 \u0441\u0432\u0435\u0442\u0443 \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0437 \u0410\u0439\u0446\u043e\u043c \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u041f 2, 4\u0430. 5\u0430; \u041f\u0441 118 (117), 22b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u044b\u0441\u0442\u0443\u043f\u0430\u044e\u0447\u044b \u0434\u0430 \u041f\u0430\u043d\u0430, \u0436\u044b\u0432\u043e\u0433\u0430 \u043a\u0430\u043c\u0435\u043d\u044f, <span style=\"color: #ff0000;\">*<\/span> \u0432\u044b \u0441\u0430\u043c\u0456, \u044f\u043a \u0436\u044b\u0432\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456, \u0431\u0443\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u0434\u043e\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u044d\u0442\u044b \u043a\u0430\u043c\u0435\u043d\u044c \u0441\u0442\u0430\u045e \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u0432\u0443\u0433\u043b\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u0441\u0430\u043c\u0456, \u044f\u043a \u0436\u044b\u0432\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456, \u0431\u0443\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u0434\u043e\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"704","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0414\u0437\u0435\u0456&raquo;, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u041b\u044e\u0434\u0432\u0456\u043a\u0430\u043c \u041a\u0430\u043d\u0441\u0430\u043b\u044c\u0432\u0430 \u043d\u0430 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0435 \u0430\u043f\u0430\u0432\u044f\u0434\u0430\u043d\u043d\u044f\u045e \u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 1, 5-9: Acta Sanctorum Iulii, 7 [1868], 647)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0434\u0443\u0445\u0430\u045e, \u0446\u0456 \u044f\u043d\u044b \u0430\u0434 \u0411\u043e\u0433\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0406\u0433\u043d\u0430\u0446\u044b\u0439 \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u045e\u0441\u044f \u043f\u0443\u0441\u0442\u044b\u043c\u0456 \u0456 \u0441\u0435\u043d\u0442\u044b\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c\u0456 \u0442\u0432\u043e\u0440\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0430\u043f\u0430\u0432\u044f\u0434\u0430\u043b\u0456 \u043f\u0440\u0430 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u044f \u0447\u044b\u043d\u044b \u0437\u043d\u0430\u043a\u0430\u043c\u0456\u0442\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u042f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043f\u0440\u0430\u0432\u0456\u045e\u0441\u044f, \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u045e \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u044f\u043c\u0443 \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u0442\u0430\u043a\u0456\u0445 \u043a\u043d\u0456\u0433, \u043a\u0430\u0431 \u0437\u0430\u043d\u044f\u0446\u044c \u0447\u0430\u0441. \u0410\u043b\u0435 \u045e \u0433\u044d\u0442\u044b\u043c \u0434\u043e\u043c\u0435 \u043d\u0435 \u0431\u044b\u043b\u043e \u0442\u0430\u043a\u0456\u0445 \u043a\u043d\u0456\u0433. \u0422\u0430\u043c\u0443 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u044f\u043c\u0443 &laquo;\u0416\u044b\u0446\u0446\u0451 \u0415\u0437\u0443\u0441\u0430&raquo;, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 &laquo;\u0416\u044b\u0446\u0446\u044f\u0440\u044b\u0441\u044b \u0441\u0432\u044f\u0442\u044b\u0445&raquo;, \u0430\u0431\u0435\u0434\u0437\u044c\u0432\u0435 \u043d\u0430 \u044f\u0433\u043e \u0440\u043e\u0434\u043d\u0430\u0439 \u043c\u043e\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0447\u044b\u0442\u0430\u045e \u0456\u0445 \u0447\u0430\u0441\u0442\u0430 \u0456 \u043d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435 \u044f\u0433\u043e \u043f\u0430\u0447\u0430\u043b\u043e \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0456\u0445 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u045e. \u0427\u0430\u0441\u0430\u043c \u043f\u0430\u0434\u0447\u0430\u0441 \u0447\u044b\u0442\u0430\u043d\u043d\u044f \u0451\u043d \u0443 \u0434\u0443\u043c\u043a\u0430\u0445 \u0437\u0432\u044f\u0440\u0442\u0430\u045e\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0447\u044b\u0442\u0430\u045e \u0440\u0430\u043d\u0435\u0439, \u0434\u0430 \u043c\u0430\u0440\u0430\u045e, \u044f\u043a\u0456\u044f \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430, \u0456 \u0434\u0430 \u043c\u043d\u043e\u0433\u0456\u0445 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u0456\u0436\u0432\u043e\u043b\u0456 \u0437\u0433\u0430\u0434\u0432\u0430\u043b\u0456\u0441\u044f \u044f\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0411\u043e\u0436\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439, \u0437\u0430\u043c\u044f\u043d\u044f\u044e\u0447\u044b \u0442\u044b\u044f \u0434\u0443\u043c\u043a\u0456 \u0456\u043d\u0448\u044b\u043c\u0456, \u0448\u0442\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0437 \u043d\u043e\u0432\u044b\u0445 \u043a\u043d\u0456\u0433. \u041a\u0430\u043b\u0456 \u0447\u044b\u0442\u0430\u045e \u043f\u0440\u0430 \u0436\u044b\u0446\u0446\u0451 \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0441\u0432\u044f\u0442\u044b\u0445, \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u045e\u0441\u044f \u0456 \u043f\u044b\u0442\u0430\u045e \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435: &laquo;\u0410 \u043a\u0430\u043b\u0456 \u0431 \u044f \u043f\u0430\u0447\u0430\u045e \u0442\u0430\u043a \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c, \u044f\u043a \u0441\u0432. \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u0430\u043a \u0446\u0456 \u0441\u0432. \u0414\u0430\u043c\u0456\u043d\u0456\u043a?&raquo; \u0428\u043c\u0430\u0442 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u045e \u043f\u0440\u0430 \u0433\u044d\u0442\u0430. \u0413\u044d\u0442\u044b\u044f \u0434\u0443\u043c\u043a\u0456 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u045e \u0456\u043c \u0434\u0430\u0432\u043e\u043b\u0456 \u0434\u043e\u045e\u0433\u0430, \u0430 \u0437\u0430\u0442\u044b\u043c \u0443 \u0432\u044b\u043d\u0456\u043a\u0443 \u043f\u044d\u045e\u043d\u044b\u0445 \u0430\u043a\u0430\u043b\u0456\u0447\u043d\u0430\u0441\u0446\u044f\u045e \u0437\u0430\u043c\u044f\u043d\u044f\u043b\u0456 \u0456\u0445 \u0437\u043d\u043e\u045e \u043f\u0443\u0441\u0442\u044b\u044f \u0437\u044f\u043c\u043d\u044b\u044f \u043c\u0430\u0440\u044b. \u042f\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u0434\u043e\u045e\u0433\u0456 \u0447\u0430\u0441. \u0422\u0430\u043a\u0430\u044f \u0437\u043c\u0435\u043d\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0434\u0443\u043c\u0430\u043a \u0442\u0440\u044b\u0432\u0430\u043b\u0430 \u045e \u0456\u043c \u0434\u0430\u0432\u043e\u043b\u0456 \u0434\u043e\u045e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u0456\u0436 \u0433\u044d\u0442\u044b\u043c\u0456 \u0434\u0432\u0443\u043c\u0430 \u0432\u0456\u0434\u0430\u043c\u0456 \u0434\u0443\u043c\u0430\u043a \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0430, \u0430\u0434\u043d\u0430\u043a, \u0440\u043e\u0437\u043d\u0456\u0446\u0430. \u041a\u0430\u043b\u0456 \u0451\u043d \u0437\u0430\u0439\u043c\u0430\u045e\u0441\u044f \u0437\u044f\u043c\u043d\u044b\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456, \u0430\u0434\u0447\u0443\u0432\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u0430\u0434 \u0441\u0442\u043e\u043c\u044b \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0432\u0430\u045e, \u0430\u0434\u0447\u0443\u0432\u0430\u045e \u0441\u0443\u043c \u0456 \u043f\u0443\u0441\u0442\u043a\u0443. \u0410 \u043a\u0430\u043b\u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u045e \u043f\u0440\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0441\u043f\u0440\u0430\u045e \u043f\u0430\u043a\u0443\u0442\u044b, \u044f\u043a\u0456\u044f \u0447\u044b\u043d\u0456\u043b\u0456 \u0441\u0432\u044f\u0442\u044b\u044f \u043c\u0443\u0436\u044b, \u0442\u0430\u0434\u044b \u0430\u0434\u0447\u0443\u0432\u0430\u045e \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043f\u0430\u0441\u043b\u044f \u044f\u0433\u043e. \u041d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u0430\u0433\u0430 \u0447\u0430\u0441\u0443 \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u045e \u0433\u044d\u0442\u0430\u0439 \u0440\u043e\u0437\u043d\u0456\u0446\u044b \u0456 \u043d\u0435 \u043d\u0430\u0434\u0430\u0432\u0430\u045e \u0433\u044d\u0442\u0430\u043c\u0443 \u043d\u0456\u044f\u043a\u0430\u0439 \u0443\u0432\u0430\u0433\u0456, \u0430\u0436 \u043f\u0430\u043a\u0443\u043b\u044c \u0430\u0434\u043d\u043e\u0439\u0447\u044b \u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u0432\u043e\u0447\u044b \u044f\u0433\u043e \u0434\u0443\u0448\u044b, \u0456 \u0451\u043d \u043f\u0430\u0447\u0430\u045e \u0437\u0430\u0434\u0443\u043c\u0432\u0430\u0446\u0446\u0430, \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0431\u0430\u0447\u0443\u0447\u044b, \u0448\u0442\u043e \u0430\u0434\u043d\u044b\u044f \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0446\u044c \u044f\u0433\u043e \u0441\u0443\u043c\u0430\u043c, \u0430 \u0434\u0440\u0443\u0433\u0456\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u043e\u0439 \u0431\u044b\u043b\u0430 \u044f\u0433\u043e \u043f\u0435\u0440\u0448\u0430\u044f \u043c\u0435\u0434\u044b\u0442\u0430\u0446\u044b\u044f \u043f\u0440\u0430 \u0411\u043e\u0436\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b. \u041f\u0430\u0437\u043d\u0435\u0439, \u043a\u0430\u043b\u0456 \u0437\u0430\u043d\u044f\u045e\u0441\u044f \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c\u0456 \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u043d\u043d\u044f\u043c\u0456, \u0437\u0430\u0447\u0430\u0440\u043f\u043d\u0443\u045e \u0437 \u0456\u0445 \u043f\u0435\u0440\u0448\u044b\u044f \u0442\u043b\u0443\u043c\u0430\u0447\u044d\u043d\u043d\u0456 \u0434\u043b\u044f \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0434\u0443\u0445\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 4, 11. 8\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435, \u044f\u043a \u0441\u043b\u043e\u0432\u044b \u0411\u043e\u0436\u044b\u044f; \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0441\u043b\u0443\u0436\u044b\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043c\u043e\u0446\u044b, \u044f\u043a\u043e\u044e \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u044f\u0433\u043e \u0411\u043e\u0433, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0432\u0430 \u045e\u0441\u0456\u043c \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u0411\u043e\u0433 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451, \u043c\u0430\u0439\u0446\u0435 \u0448\u0447\u044b\u0440\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0432\u0430 \u045e\u0441\u0456\u043c \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u0411\u043e\u0433 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"705","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0432\u043e\u0440 \u0441\u0432. \u0410\u043b\u044c\u0444\u043e\u043d\u0441\u0430 \u041c\u0430\u0440\u044b\u0456 \u041b\u0456\u0433\u0443\u043e\u0440\u044b, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. De praxi amandi Iesum Christum edit. Latina, Romae, 1909, pp. 9-14)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u044f \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c \u0434\u0443\u0448\u044b \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u0432\u0430 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u043d\u0456 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0414\u0430\u0431\u0440\u0430 \u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f. \u0413\u044d\u0442\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u044f\u0434\u043d\u0430\u0435 \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u045e\u0441\u0435 \u0446\u043d\u043e\u0442\u044b \u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0456\u0431\u0430 \u0411\u043e\u0433 \u043d\u0435 \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435 \u043d\u0430 \u045e\u0441\u044e \u043d\u0430\u0448\u0443\u044e \u043b\u044e\u0431\u043e\u045e? \u0401\u043d \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443 \u043d\u0430\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e. &laquo;\u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430, \u043f\u0430\u0434\u0443\u043c\u0430\u0439, &ndash; \u043a\u0430\u0436\u0430 \u043d\u0430\u043c \u0411\u043e\u0433, &ndash; \u042f \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0446\u044f\u0431\u0435. \u042f\u0448\u0447\u044d \u043d\u0435 \u0431\u044b\u043b\u043e \u0446\u044f\u0431\u0435 \u043d\u0430 \u0441\u0432\u0435\u0446\u0435, \u043d\u0456 \u0441\u0432\u0435\u0442\u0443 \u044f\u0448\u0447\u044d \u043d\u0435 \u0431\u044b\u043b\u043e, \u0430 \u042f \u045e\u0436\u043e \u0442\u0430\u0434\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0446\u044f\u0431\u0435. \u041a\u043e\u043b\u044c\u043a\u0456 \u0456\u0441\u043d\u0443\u044e, \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u044e\u0431\u043b\u044e \u0446\u044f\u0431\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043c\u043e\u0436\u043d\u0430 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u0434\u0430\u0440\u044b, \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0441\u0432\u0430\u0456\u043c\u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u043c\u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430. &laquo;\u0425\u0430\u0447\u0443 \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0442\u044b\u043c\u0456 \u043a\u0430\u0439\u0434\u0430\u043d\u0430\u043c\u0456, \u044f\u043a\u0456\u043c \u044f\u043d\u044b \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0430\u0434\u0434\u0430\u044e\u0446\u0446\u0430 &ndash; \u043a\u0430\u0439\u0434\u0430\u043d\u0430\u043c\u0456 \u043b\u044e\u0431\u043e\u0432\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u043c\u0430\u044e\u0446\u044c \u043d\u0430 \u043c\u044d\u0446\u0435 \u045e\u0441\u0435 \u0434\u0430\u0440\u044b, \u044f\u043a\u0456\u044f \u0411\u043e\u0433 \u0434\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443. \u0401\u043d \u0434\u0430\u045e \u044f\u043c\u0443 \u0434\u0443\u0448\u0443, \u0430\u0434\u043e\u0440\u0430\u043d\u0443\u044e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u043f\u0430\u043c\u044f\u0446\u0446\u044e, \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u0456 \u0432\u043e\u043b\u044c\u043d\u0430\u0439 \u0432\u043e\u043b\u044f\u0439; \u0434\u0430\u045e \u0446\u0435\u043b\u0430 \u0437 \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u043c\u0456; \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0434\u043b\u044f \u044f\u0433\u043e \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e \u0440\u0430\u0437\u0430\u043c \u0437 \u0443\u0441\u0451\u0439 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0430\u0441\u0446\u044e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e. \u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u0440\u0430\u0431\u0456\u045e \u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456 \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043b\u044e\u0431\u0456\u045e \u0411\u043e\u0433\u0430, \u0414\u0430\u045e\u0446\u0443 \u0442\u0430\u043a\u0456\u0445 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u0445 \u0434\u0430\u0440\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0434\u0430\u0446\u044c \u043d\u0430\u043c \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u0445, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u0445 \u0406\u043c \u0434\u0430\u0440\u043e\u045e. \u041a\u0430\u0431 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u043d\u0430\u0448\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u043f\u0430\u0439\u0448\u043e\u045e \u0430\u0436 \u0434\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435. \u0421\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b \u0410\u0439\u0446\u0435\u0446 \u0442\u0430\u043a \u043c\u043e\u0446\u043d\u0430 \u043d\u0430\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e, \u0448\u0442\u043e \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0434\u0430\u045e \u043d\u0430\u043c. \u0428\u0442\u043e \u0436 \u0401\u043d \u0437\u0440\u0430\u0431\u0456\u045e, \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u043d\u0430\u0441 \u0443\u0441\u0456\u0445, \u0437\u0430\u043d\u0443\u0440\u0430\u043d\u044b\u0445 \u0443 \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u0445 \u042f\u0433\u043e \u043b\u0430\u0441\u043a\u0456? \u0423 \u0441\u0432\u0430\u0451\u0439 \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0430 \u043d\u0430\u0432\u0430\u0442 &ndash; \u044f\u043a \u043f\u0456\u0448\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b &ndash; \u0443 \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430\u0439 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u043a\u0430\u0431 \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430 \u043d\u0430\u0441 \u0456 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u043d\u0430\u043c \u0430\u0434\u0430\u0431\u0440\u0430\u043d\u0430\u0435 \u043f\u0440\u0430\u0437 \u0433\u0440\u044d\u0445 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u044e\u0447\u044b \u043d\u0430\u043c \u0421\u044b\u043d\u0430, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e, \u043a\u0430\u0431 \u0437\u0431\u0435\u0440\u0430\u0433\u0447\u044b \u043d\u0430\u0441, \u0434\u0430\u045e \u043d\u0430\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b: \u0434\u0430\u045e \u043b\u0430\u0441\u043a\u0443, \u043b\u044e\u0431\u043e\u045e, \u0448\u0447\u0430\u0441\u0446\u0435 \u0440\u0430\u044e &ndash; \u0430\u043b\u0435 \u045e\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0434\u0430\u0440\u044b \u043c\u0435\u043d\u0448\u044b\u044f \u0437\u0430 \u0434\u0430\u0440 \u0421\u044b\u043d\u0430: &laquo;\u0422\u043e\u0439, \u044f\u043a\u0456 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e, \u0430\u043b\u0435 \u0430\u0434\u0434\u0430\u045e \u042f\u0433\u043e \u0437\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441, \u044f\u043a \u0436\u0430 \u043d\u0435 \u0434\u0430\u0441\u0446\u044c \u043d\u0430\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u044f\u0433\u043e?&raquo; (\u0420\u044b\u043c 8, 32).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 145 (144), 19-20\u0430; 1 \u042f\u043d 3, 9\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0441\u043f\u0430\u045e\u043d\u044f\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u042f\u0433\u043e \u0431\u0430\u0456\u0446\u0446\u0430, \u0447\u0443\u0435 \u0456\u0445\u043d\u0456 \u043a\u0440\u044b\u043a \u0456 \u0440\u0430\u0442\u0443\u0435 \u0456\u0445. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0430\u043d \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0435 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u042f\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0430\u0434 \u0411\u043e\u0433\u0430, \u043d\u0435 \u0447\u044b\u043d\u0456\u0446\u044c \u0433\u0440\u0430\u0445\u0443, \u0431\u043e \u043d\u0430\u0441\u0435\u043d\u043d\u0435 \u042f\u0433\u043e\u043d\u0430\u0435 \u0436\u044b\u0432\u0435 \u045e \u0456\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0435 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u042f\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u044c.<\/p>\r\n"}, {"GCH_CH_2_ID":"706","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u042d\u045e\u0437\u044d\u0431\u0456\u044f \u0412\u044d\u0440\u0447\u044d\u043b\u044c\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 2, 1, 3 &ndash; 2, 3; 10, 1 &ndash; 11, 1: CCL 9, 104-105. 109)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0411\u0435\u0433 \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u045e, \u0432\u0435\u0440\u0443 \u0437\u0430\u0445\u0430\u0432\u0430\u045e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u044f \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u043f\u0440\u0430 \u0432\u0430\u0448\u0430\u0435 \u0434\u043e\u0431\u0440\u0430\u0435 \u0437\u0434\u0430\u0440\u043e\u045e\u0435, \u0447\u0430\u0433\u043e \u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u045e. \u041c\u043d\u0435 \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u044f \u0431\u044b\u045e \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u0435\u043d\u044b \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u044b\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0430\u0434\u043b\u0435\u0433\u043b\u0430\u0441\u0446\u0456, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0410\u0431\u0430\u043a\u0443\u043c, \u044f\u043a\u043e\u0433\u0430 \u0430\u043d\u0451\u043b \u0443\u0437\u043d\u0451\u0441 \u0430\u0436 \u0434\u0430 \u0414\u0430\u043d\u0456\u044d\u043b\u044f. \u041a\u0430\u043b\u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e \u043b\u0456\u0441\u0442\u044b \u0430\u0434 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u0432\u0430\u0441 \u0456 \u0447\u044b\u0442\u0430\u044e \u045e \u0456\u0445 \u043f\u0440\u0430 \u0432\u0430\u0448\u044b\u044f \u0441\u0432\u044f\u0442\u044b\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0456 \u043b\u044e\u0431\u043e\u045e, \u0441\u043b\u0451\u0437\u044b \u0434\u0430\u043b\u0443\u0447\u0430\u044e\u0446\u0446\u0430 \u0434\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u044e\u0446\u044c \u043c\u0430\u0439\u043c\u0443 \u0433\u0430\u0440\u0430\u0447\u0430\u043c\u0443 \u0436\u0430\u0434\u0430\u043d\u043d\u044e \u0447\u044b\u0442\u0430\u0446\u044c. \u0410\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430, \u0431\u043e \u0430\u0431\u043e\u0434\u0432\u0430 \u043f\u0430\u0447\u0443\u0446\u0446\u0456 \u0445\u0430\u0446\u0435\u043b\u0456 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u0446\u0430 \u044f\u043a \u043d\u0430\u0439\u0445\u0443\u0442\u0447\u044d\u0439, \u043a\u0430\u0431 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0443\u043c. \u041d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456\u0445 \u0434\u0437\u0451\u043d \u044f \u0442\u0440\u044b\u0432\u0430\u045e \u0443 \u0442\u0430\u043a\u0456\u043c \u043d\u0430\u0441\u0442\u0440\u043e\u0456. \u042f \u045e\u044f\u045e\u043b\u044f\u045e, \u0448\u0442\u043e \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u044e \u0437 \u0432\u0430\u043c\u0456, \u0437\u0430\u0431\u044b\u0432\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u043d\u044b\u044f \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u0456. \u0410\u0434\u0443\u0441\u044e\u043b\u044c \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u043b\u0430 \u043c\u044f\u043d\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u043b\u0430 \u043c\u043d\u0435 \u043f\u0440\u0430 \u0432\u0430\u0448\u0443\u044e \u043c\u043e\u0446\u043d\u0443\u044e \u0432\u0435\u0440\u0443, \u0432\u0430\u0448\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u0432\u0430\u0448\u0443\u044e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c. \u0421\u044f\u0440\u043e\u0434 \u0441\u0442\u043e\u043b\u044c\u043a\u0456\u0445 \u0456 \u0442\u0430\u043a\u0456\u0445 \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0440\u0430\u0434\u0430\u0441\u0446\u044f\u045e \u043c\u043d\u0435 \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u045e\u0436\u043e \u044f \u043d\u0435 \u043d\u0430 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0456, \u0430\u043b\u0435 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0440\u0430\u0434\u0443\u044e\u0441\u044f, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0432\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u044b, \u0432\u0435\u0441\u044f\u043b\u044e\u0441\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c, \u044f\u043a\u043e\u0435 \u0437 \u0432\u0435\u0440\u044b \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0446\u0435\u0448\u0443\u0441\u044f \u043f\u043b\u0451\u043d\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0432\u044b \u0434\u0430\u0435\u0446\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0430\u043c\u044b\u043c \u0431\u043b\u0456\u0437\u043a\u0456\u043c, \u0430\u043b\u0435 \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0437\u0434\u0430\u043b\u0451\u043a. \u042f\u043a \u0437\u0435\u043c\u043b\u044f\u0440\u043e\u0431 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0434\u043e\u0431\u0440\u0430\u0435 \u0434\u0440\u044d\u0432\u0430, \u044f\u043a\u043e\u0435 \u0437-\u0437\u0430 \u0441\u0432\u0430\u0456\u0445 \u043f\u043b\u0430\u0434\u043e\u045e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437\u0440\u044d\u0437\u0430\u043d\u0430 \u0456 \u0441\u043f\u0430\u043b\u0435\u043d\u0430, \u0442\u0430\u043a \u0456 \u043c\u044b \u0433\u043e\u0440\u0430\u0447\u0430 \u043f\u0440\u0430\u0433\u043d\u0435\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u0435\u043b\u0430\u043c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0432\u0430\u0448\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0456 \u0434\u0443\u0448\u0443 \u0430\u0434\u0434\u0430\u0446\u044c \u0437\u0430 \u0432\u0430\u0448\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043f\u0456\u0441\u0430\u045e \u0433\u044d\u0442\u044b \u043b\u0456\u0441\u0442, \u044f\u043a \u043c\u043e\u0433, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u043e\u0441\u044f\u0447\u044b \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u043d\u0430 \u043d\u0435\u0439\u043a\u0456 \u0447\u0430\u0441 \u0441\u0442\u0440\u044b\u043c\u0430\u045e \u043c\u0430\u0456\u0445 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u0456 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0434\u044b\u044f\u043a\u0430\u043d\u0443 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0432\u0430\u043c \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u043b\u0456\u0441\u0442 \u0437 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u044f\u043c\u0456, \u0447\u044b\u043c \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u043b\u0435\u043d\u043d\u0456 \u043f\u0440\u0430 \u043d\u0430\u0448\u044b\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456. \u0422\u0430\u043c\u0443 \u0432\u0435\u043b\u044c\u043c\u0456 \u0432\u0430\u0441 \u043f\u0440\u0430\u0448\u0443, \u0431\u0435\u0440\u0430\u0436\u044b\u0446\u0435 \u0432\u0435\u0440\u0443 \u0437 \u0443\u0441\u0451\u0439 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0441\u0446\u044e, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0437\u0433\u043e\u0434\u0443, \u0442\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u043f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u0430 \u043d\u0430\u0441, \u043a\u0430\u0431 \u041f\u0430\u043d \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u0441\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b, \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u044b \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456, \u0430 \u043d\u0430\u043c, \u0437\u043c\u0443\u0447\u0430\u043d\u044b\u043c, \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0430\u043c\u0456 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u0448\u0447\u044d \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441 \u0456 \u0437\u0430\u043a\u043b\u0456\u043d\u0430\u044e \u045e \u0411\u043e\u0436\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0437 \u0432\u0430\u0441 \u043f\u0440\u044b\u043d\u044f\u045e \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435, \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u0430\u0435 \u045e \u0433\u044d\u0442\u044b\u043c \u043b\u0456\u0441\u0446\u0435. \u0417\u043c\u0443\u0448\u0430\u043d\u044b \u0430\u0431\u0441\u0442\u0430\u0432\u0456\u043d\u0430\u043c\u0456, \u044f \u043d\u0435 \u043c\u043e\u0433, \u044f\u043a \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430, \u043d\u0430\u043f\u0456\u0441\u0430\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437 \u0432\u0430\u0441 \u0430\u0441\u043e\u0431\u043d\u0430. \u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u044b \u043b\u0456\u0441\u0442 \u043f\u0440\u0430\u0448\u0443 \u045e\u0441\u0456\u0445 \u0432\u0430\u0441, \u043c\u0430\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0430\u0441, \u043c\u0430\u0435 \u0441\u0432\u044f\u0442\u044b\u044f \u0441\u0451\u0441\u0442\u0440\u044b, \u043c\u0430\u0435 \u0441\u044b\u043d\u044b \u0456 \u0434\u043e\u0447\u043a\u0456, \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u043a\u0430\u0431, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0433\u044d\u0442\u0430\u0435 \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u043d\u0435, \u0432\u044b \u0437\u0430\u0445\u0430\u0446\u0435\u043b\u0456 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0430\u0432\u0430\u0433\u0443 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043f\u0430-\u0437\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c, \u0430 \u043d\u0430\u043c \u0430\u043a\u0430\u0437\u0430\u0446\u044c \u043b\u0430\u0441\u043a\u0430\u0432\u0443\u044e \u0437\u044b\u0447\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 12, 35-36; \u041c\u0446 24, 42<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0441\u0446\u0451\u0433\u043d\u044b \u0432\u0430\u0448\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u043d\u044b\u044f \u0456 \u0441\u0432\u0435\u0442\u0430\u0447\u044b \u0437\u0430\u043f\u0430\u043b\u0435\u043d\u044b\u044f. <span style=\"color: #ff0000;\">*<\/span> \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0437 \u0432\u044f\u0441\u0435\u043b\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0430\u043c\u0443 \u0447\u0443\u0432\u0430\u0439\u0446\u0435, \u0431\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0443 \u044f\u043a\u0456 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u0432\u0430\u0448 \u043f\u0440\u044b\u0439\u0434\u0437\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0437 \u0432\u044f\u0441\u0435\u043b\u043b\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"707","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u042e\u043b\u0456\u044f\u043d\u0430 \u042d\u0439\u043c\u0430\u0440\u0434\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(La Pr&eacute;sence r&eacute;elle, vol. 1, Paris 1950, pp. 270-271. 307-308)<\/span><br \/><em><span style=\"color: #ff0000;\">\u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044f &ndash; \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0436\u044b\u0446\u0446\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044f &ndash; \u0433\u044d\u0442\u0430 \u0436\u044b\u0446\u0446\u0451 \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044f \u0434\u0430\u0435 \u0456\u043c \u043f\u0440\u044b\u043d\u0446\u044b\u043f\u044b \u0436\u044b\u0446\u0446\u044f. \u0423\u0441\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0441\u0430\u0431\u0440\u0430\u0446\u0446\u0430 \u0431\u0435\u0437 \u043d\u0456\u044f\u043a\u0430\u0439 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0430\u0446\u044b\u044f\u043d\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0446\u0456 \u043c\u043e\u0432\u044b \u0434\u0437\u0435\u043b\u044f \u0446\u044d\u043b\u0435\u0431\u0440\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0432\u044f\u0442\u044b\u0445 \u0430\u0431\u0440\u0430\u0434\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044f \u0434\u0430\u0435 \u0456\u043c \u0437\u0430\u043a\u043e\u043d \u0436\u044b\u0446\u0446\u044f, \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435 &ndash; \u043b\u044e\u0431\u043e\u045e, \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u044f\u043a\u043e\u0439 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442. \u0422\u0430\u043c\u0443 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u044f\u043d\u0430 \u0441\u0442\u0432\u0430\u0440\u0430\u0435 \u043f\u0430\u043c\u0456\u0436 \u0456\u043c\u0456 \u0430\u0433\u0443\u043b\u044c\u043d\u0443\u044e \u043f\u043e\u0432\u044f\u0437\u044c \u0456 \u043d\u0435\u0439\u043a\u0443\u044e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0443\u044e \u0431\u043b\u0456\u0437\u043a\u0430\u0441\u0446\u044c. \u0423\u0441\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u044e\u0446\u044c \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0425\u043b\u0435\u0431, \u0443\u0441\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0433\u0430\u0441\u0446\u0456\u043d\u044b \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0430\u043c\u0456\u0436 \u0456\u043c\u0456 \u0441\u0442\u0432\u0430\u0440\u0430\u0435 \u0437\u0432\u044b\u0448\u043f\u0440\u044b\u0440\u043e\u0434\u043d\u0443\u044e \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u0442\u0432\u0430. \u0427\u044b\u0442\u0430\u0439\u0446\u0435 \u0414\u0437\u0435\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e. \u042f\u043d\u044b \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u043f\u0435\u0440\u0448\u044b\u0445 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e, \u044f\u043a\u0456\u044f \u043d\u0430\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0437 \u044e\u0434\u0430\u0456\u0437\u043c\u0443 \u0446\u0456 \u0431\u044b\u043b\u0456 \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u043c\u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c\u0456, \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0437 \u0440\u043e\u0437\u043d\u044b\u0445 \u043a\u0440\u0430\u0456\u043d, \u0430\u043b\u0435 \u043c\u0435\u043b\u0456 \u0430\u0434\u043d\u043e \u0441\u044d\u0440\u0446\u0430 \u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u0434\u0443\u0445\u0430. \u0427\u0430\u043c\u0443? \u0411\u043e \u0440\u0443\u043f\u043b\u0456\u0432\u0430 \u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u043d\u0430\u0432\u0443\u043a\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u0456 \u045e \u043b\u0430\u043c\u0430\u043d\u043d\u0456 \u0425\u043b\u0435\u0431\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044f &ndash; \u0433\u044d\u0442\u0430 \u0436\u044b\u0446\u0446\u0451 \u0434\u0443\u0448\u044b \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u044f\u043a \u0441\u043e\u043d\u0446\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0436\u044b\u0446\u0446\u0451\u043c \u0446\u0435\u043b\u0430 \u0456 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456. \u0411\u0435\u0437 \u0441\u043e\u043d\u0446\u0430 \u0437\u044f\u043c\u043b\u044f \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0443\u0440\u0430\u0434\u043b\u0456\u0432\u0430\u0439, \u044f\u043d\u043e \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u044c \u044f\u0435, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0435 \u0456 \u0448\u0447\u043e\u0434\u0440\u0430 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u043f\u043b\u0430\u0434\u0430\u043c\u0456. \u0421\u043e\u043d\u0446\u0430 \u0434\u0430\u0435 \u0446\u0435\u043b\u0443 \u0430\u043a\u0442\u044b\u045e\u043d\u0430\u0441\u0446\u044c, \u0441\u0456\u043b\u0443 \u0456 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c. \u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c \u0433\u044d\u0442\u0430, \u0442\u0430\u043c\u0443 \u043d\u0430\u0441 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u0446\u044c, \u0448\u0442\u043e \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u043b\u0456\u0441\u044f \u0441\u043e\u043d\u0446\u0443 \u044f\u043a \u0431\u043e\u0441\u0442\u0432\u0443 \u0441\u0432\u044f\u0442\u043b\u0430. \u0417\u043e\u0440\u043a\u0430 \u0434\u043d\u044f \u0446\u0430\u043b\u043a\u0430\u043c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u044f \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u043c\u0443 \u0421\u043e\u043d\u0446\u0443, \u0411\u043e\u0436\u0430\u043c\u0443 \u0421\u043b\u043e\u0432\u0443, \u0415\u0437\u0443\u0441\u0443 \u0425\u0440\u044b\u0441\u0442\u0443, \u044f\u043a\u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0448\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0443 \u0433\u044d\u0442\u044b \u0441\u0432\u0435\u0442, \u0456 \u044f\u043a\u0456 \u0441\u0430\u043c \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u043f\u0440\u0430\u0437 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044e, \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0436\u044b\u0446\u0446\u044f, \u0443 \u0434\u0443\u0448\u0430\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0401\u043d \u0444\u0430\u0440\u043c\u0456\u0440\u0443\u0435 \u0441\u0435\u043c&rsquo;\u0456 \u0456 \u043d\u0430\u0440\u043e\u0434\u044b. \u0423 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u0442\u0430\u044f \u0434\u0443\u0448\u0430, \u044f\u043a\u0430\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0433\u044d\u0442\u044b \u0441\u0445\u0430\u0432\u0430\u043d\u044b \u0441\u043a\u0430\u0440\u0431, \u044f\u043a\u0430\u044f \u0441\u043f\u0430\u0442\u0430\u043b\u044f\u0435 \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0435 \u043a\u0430\u043b\u044f \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u0430\u044f \u0447\u0430\u0441\u0442\u0430 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435 \u0433\u044d\u0442\u044b \u0425\u043b\u0435\u0431 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0441\u044f\u043c&rsquo;\u0451\u0439. \u041f\u043e\u0432\u044f\u0437\u0437\u044e \u043f\u0430\u043c\u0456\u0436 \u044f\u0435 \u0447\u043b\u0435\u043d\u0430\u043c\u0456 \u0451\u0441\u0446\u044c \u0415\u0437\u0443\u0441 &ndash; \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044f. \u0401\u043d &ndash; \u0410\u0439\u0446\u0435\u0446, \u044f\u043a\u0456 \u0434\u043b\u044f \u0441\u044f\u043c&rsquo;\u0456 \u0440\u044b\u0445\u0442\u0443\u0435 \u0441\u0442\u043e\u043b. \u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0435 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u0442\u0432\u0430 \u0431\u044b\u043b\u043e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430 \u043f\u0430\u0434\u0447\u0430\u0441 \u0412\u044f\u0447\u044d\u0440\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0430\u0439\u0446\u043e\u045e\u0441\u0442\u0432\u0430\u043c \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0401\u043d \u043d\u0430\u0437\u0432\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e &laquo;\u0441\u044b\u043d\u0430\u043c\u0456&raquo;, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0441\u0432\u0430\u0456\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456, \u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0456\u043c, \u043a\u0430\u0431 \u044f\u043d\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u0401\u043d \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u044f \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0441\u0442\u0430\u043b\u0430 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u045e\u0441\u0435, \u0445\u0442\u043e \u043f\u0440\u044b\u043c\u0430\u0435 \u0442\u0443\u044e \u0441\u0430\u043c\u0443\u044e \u0435\u0436\u0443, \u0456 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0440\u043e\u0431\u0456\u0446\u044c \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u0441\u043d\u043e\u0432\u0443, \u0448\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u044f\u043d\u044b \u0441\u044f\u043c&rsquo;\u044e, \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u0426\u0435\u043b\u0430, \u0431\u043e \u045e\u0441\u0435 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u044e\u0446\u044c \u0443 \u0430\u0434\u043d\u044b\u043c \u0425\u043b\u0435\u0431\u0435, \u044f\u043a\u0456\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0423\u0440\u044d\u0448\u0446\u0435, \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044f \u0434\u0430\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u043c\u043e\u0446 \u0443 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0456 \u0437\u0430\u043a\u043e\u043d\u0443 \u043f\u0430\u0448\u0430\u043d\u044b \u0456 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430. \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0448\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u0456 \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e. \u0422\u0430\u043c\u0443 \u0441\u0430\u043c \u043f\u0440\u044b\u043d\u044f\u045e \u0456\u0445\u043d\u044f\u0435 \u0446\u0435\u043b\u0430: &laquo;\u0422\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0430\u0434\u043d\u0430\u043c\u0443 \u0437 \u0433\u044d\u0442\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u041c\u0430\u0456\u0445 \u043c\u0435\u043d\u0448\u044b\u0445, \u0432\u044b \u041c\u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0456&raquo; (\u041c\u0446 25, 40). \u0401\u043d \u0441\u0430\u043c \u0434\u0430\u0435 \u0441\u044f\u0431\u0435 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u045e \u0441\u0432. \u041a\u0430\u043c\u0443\u043d\u0456\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u041a\u0430\u0440 10, 17; \u042f\u043d 6, 58\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u0437\u0456\u043d \u0451\u0441\u0446\u044c \u0425\u043b\u0435\u0431, \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430 &ndash; \u043c\u044b \u043c\u043d\u043e\u0433\u0456\u044f, \u0431\u043e \u043c\u044b \u045e\u0441\u0435 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u0425\u043b\u0435\u0431\u0430.<span style=\"color: #ff0000;\">*<\/span> \u0413\u044d\u0442\u0430 \u0442\u043e\u0439 \u0425\u043b\u0435\u0431, \u044f\u043a\u0456 \u0441\u044b\u0448\u043e\u045e \u0437 \u043d\u0435\u0431\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u043a\u0430\u0440\u043c\u0456 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u043f\u043b\u0451\u043d\u0430\u043c \u0437 \u0430\u0434\u0431\u043e\u0440\u043d\u0430\u0439 \u043f\u0448\u0430\u043d\u0456\u0446\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u0442\u043e\u0439 \u0425\u043b\u0435\u0431, \u044f\u043a\u0456 \u0441\u044b\u0448\u043e\u045e \u0437 \u043d\u0435\u0431\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"708","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0442\u044d\u0445\u0435\u0437\u0430 \u0441\u0432. \u042f\u043d\u0430 \u041c\u0430\u0440\u044b\u0456 \u0412\u0456\u044f\u043d\u044d\u044f, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cat&eacute;chisme sur la pri&egrave;re: A. Monnin, Esprit du Cur&eacute; d&rsquo;Ars, Paris 1899, pp. 87-89)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0421\u0430\u043b\u043e\u0434\u043a\u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430: \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0456 \u043b\u044e\u0431\u0456\u0446\u044c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435, \u0434\u0437\u0435\u0446\u0456 \u043c\u0430\u0435: \u0441\u043a\u0430\u0440\u0431 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430 &ndash; \u0443 \u043d\u0435\u0431\u0435, \u043d\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0422\u0430\u043c\u0443, \u0434\u0437\u0435 \u0441\u043a\u0430\u0440\u0431 \u0432\u0430\u0448, \u0442\u0443\u0434\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0456 \u0434\u0443\u043c\u043a\u0456 \u0432\u0430\u0448\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043b\u043e\u0434\u043a\u0456\u043c \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u043c \u0456 \u0437\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0456 \u043b\u044e\u0431\u043e\u045e. \u041c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u0456 \u043b\u044e\u0431\u0456\u0446\u0435: \u0432\u043e\u0441\u044c \u0443 \u0447\u044b\u043c \u0448\u0447\u0430\u0441\u0446\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0456\u0447\u044b\u043c \u0456\u043d\u0448\u044b\u043c \u044f\u043a \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u0435\u043c \u0437 \u0411\u043e\u0433\u0430\u043c. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043c\u0430\u0435 \u0447\u044b\u0441\u0442\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b \u0437 \u0411\u043e\u0433\u0430\u043c, \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u0456 \u0441\u043b\u043e\u0434\u044b\u0447, \u044f\u043a\u0456\u044f \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0446\u044c \u044f\u0433\u043e, \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u044f\u043a\u043e\u0435 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u044f\u0433\u043e \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435. \u0423 \u0433\u044d\u0442\u044b\u043c \u0446\u0435\u0441\u043d\u044b\u043c \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u0456 \u0411\u043e\u0433 \u0456 \u0434\u0443\u0448\u0430 \u0431\u044b\u0446\u0446\u0430\u043c \u0440\u0430\u0437\u0430\u043c \u0432\u044b\u043f\u043b\u0430\u045e\u043b\u0435\u043d\u044b\u044f \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u043a\u0430\u0432\u0430\u043b\u043a\u0443 \u0432\u043e\u0441\u043a\u0443, \u044f\u043a\u0456 \u045e\u0436\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u0456\u0446\u044c. \u0413\u044d\u0442\u0430\u0435 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u0441\u0430 \u0441\u043b\u0430\u0431\u044b\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c \u0451\u0441\u0446\u044c \u0447\u044b\u043c\u0441\u044c\u0446\u0456 \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u044b\u043c, \u0451\u0441\u0446\u044c \u0448\u0447\u0430\u0441\u0446\u0435\u043c, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435\u043b\u044c\u0433\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043d\u0435 \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435\u043c \u043d\u0430 \u0434\u0430\u0440 \u043c\u0430\u043b\u0456\u0442\u0432\u044b. \u0410\u043b\u0435 \u0434\u043e\u0431\u0440\u044b \u0411\u043e\u0433 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e, \u043a\u0430\u0431 \u043c\u044b \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u043b\u0456 \u0437 \u0406\u043c. \u041d\u0430\u0448\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u044b\u043c \u0434\u043b\u044f \u042f\u0433\u043e \u043a\u0430\u0434\u0437\u0456\u043b\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u0446\u0456 \u043c\u0430\u0435, \u0432\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u043c\u0430\u043b\u043e\u0435, \u0430\u043b\u0435 \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u043f\u0430\u0448\u044b\u0440\u0430\u0435 \u044f\u0433\u043e \u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c \u0434\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u0411\u043e\u0433\u0430. \u041c\u0430\u043b\u0456\u0442\u0432\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043c\u0430\u043a \u043d\u0435\u0431\u0430, \u0451\u0441\u0446\u044c \u044f\u043a \u0431\u044b \u0441\u044b\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435\u043c \u0434\u0430 \u043d\u0430\u0441 \u0440\u0430\u0439\u0441\u043a\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f. \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u043d\u0430\u0441 \u0441\u043b\u043e\u0434\u044b\u0447\u0447\u0443; \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u0451\u0434\u0430\u043c, \u0448\u0442\u043e \u0441\u043f\u043b\u044b\u0432\u0430\u0435 \u045e \u0434\u0443\u0448\u0443, \u044f\u043a\u0430\u044f \u0447\u044b\u043d\u0456\u0446\u044c \u0443\u0441\u0451 \u0441\u0430\u043b\u043e\u0434\u043a\u0456\u043c. \u0423 \u0445\u0432\u0456\u043b\u0456\u043d\u044b \u0448\u0447\u044b\u0440\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0437\u043d\u0456\u043a\u0430\u044e\u0446\u044c \u044f\u043a \u0441\u043d\u0435\u0433 \u043d\u0430 \u0441\u043e\u043d\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u044b\u0447\u044b\u043d\u044f\u0435\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0447\u0430\u0441 \u043b\u044f\u0446\u0456\u0446\u044c \u0442\u0430\u043a \u0445\u0443\u0442\u043a\u0430 \u0456 \u0442\u0430\u043a \u043f\u0440\u044b\u0435\u043c\u043d\u0430, \u0448\u0442\u043e \u043d\u0430\u0432\u0430\u0442 \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u044f\u0433\u043e \u0445\u0430\u0434\u0430. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u043a\u0430\u043b\u0456 \u044f \u0431\u044b\u045e \u043f\u0440\u043e\u0431\u0430\u0448\u0447\u0430\u043c \u0443 \u0411\u0440\u044d\u0441\u0435, \u0442\u0430\u043a \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u0430\u043c\u0430\u043b\u044c \u0443\u0441\u0435 \u043d\u0430\u0432\u0430\u043a\u043e\u043b\u044c\u043d\u044b\u044f \u043f\u0440\u043e\u0431\u0430\u0448\u0447\u044b \u0437\u0430\u0445\u0432\u0430\u0440\u044d\u043b\u0456. \u0422\u0430\u0434\u044b \u044f \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u043f\u0435\u0448\u0448\u0443 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0430\u0434\u043b\u0435\u0433\u043b\u0430\u0441\u0446\u0456, \u043c\u043e\u043b\u044f\u0447\u044b\u0441\u044f \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430, \u0456 \u0437\u0430\u043f\u044d\u045e\u043d\u0456\u0432\u0430\u044e \u0432\u0430\u0441, \u0448\u0442\u043e \u044f \u043d\u0435 \u043d\u0443\u0434\u0437\u0456\u045e\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u0441\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0456\u0431\u044b \u0440\u044b\u0431\u044b \u045e \u0445\u0432\u0430\u043b\u044f\u0445, \u0446\u0430\u043b\u043a\u0430\u043c \u0437\u0430\u0433\u043b\u044b\u0431\u043b\u0435\u043d\u044b\u044f \u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0443. \u0410\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u043a \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u044f\u043d\u044b \u0430\u0434\u0434\u0430\u043d\u044b\u044f \u0411\u043e\u0433\u0443. \u0423 \u0456\u0445 \u0441\u044d\u0440\u0446\u044b \u043d\u044f\u043c\u0430 \u0440\u0430\u0437\u0434\u0432\u0430\u0435\u043d\u043d\u044f. \u041e, \u044f\u043a \u0436\u0430 \u044f \u043b\u044e\u0431\u043b\u044e \u0433\u044d\u0442\u044b\u044f \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b\u044f \u0434\u0443\u0448\u044b! \u0421\u0432. \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u0430\u043a \u0437 \u0410\u0441\u0456\u0437\u0456 \u0456 \u0441\u0432. \u041a\u0430\u043b\u0435\u0442\u0430 \u0431\u0430\u0447\u044b\u043b\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u043b\u0456 \u0437 \u0406\u043c, \u044f\u043a \u043c\u044b \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u0435\u043c \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043c\u044b, \u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0440\u0430\u0437\u043e\u045e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043c \u0443 \u043a\u0430\u0441\u0446\u0451\u043b \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u044f\u043a \u0441\u044f\u0431\u0435 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0456 \u0430\u0431 \u0447\u044b\u043c \u043f\u0440\u0430\u0441\u0456\u0446\u044c! \u041a\u0430\u043b\u0456 \u0456\u0434\u0437\u0435\u043c \u0434\u0430 \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456, \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0435\u043c, \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u0456\u0434\u0437\u0451\u043c. \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0451\u0441\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0456\u0431\u044b \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0434\u0430 \u041f\u0430\u043d\u0430: &laquo;\u0421\u043a\u0430\u0436\u0443 \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u0441\u043b\u043e\u0432\u0430\u045e, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u0443\u0436\u043e \u0441\u043f\u0430\u043a\u043e\u0439&raquo;. \u042f \u0447\u0430\u0441\u0442\u0430 \u0434\u0443\u043c\u0430\u044e, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043c\u044b \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043c \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u041f\u0430\u043d\u0443, \u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c \u0443\u0441\u0451, \u0447\u0430\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0435\u043c, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0437 \u0436\u044b\u0432\u043e\u0439 \u0432\u0435\u0440\u0430\u044e \u0456 \u0437 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 4, 17; 1 \u041a\u0430\u0440 2, 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0448\u0430\u0435 \u0447\u0430\u0441\u043e\u0432\u0430\u0435 \u043b\u0451\u0433\u043a\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435 <span style=\"color: #ff0000;\">*<\/span> \u0434\u0430\u0435 \u043d\u0430\u043c \u0431\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0427\u0430\u0433\u043e \u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430, \u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430, \u0456 \u0447\u0430\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043d\u0435 \u0437\u0434\u043e\u043b\u0435\u043b\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0442\u043e\u0435 \u0411\u043e\u0433 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430\u0435 \u043d\u0430\u043c \u0431\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"709","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u043f\u0430\u0434\u0447\u0430\u0441 \u042d\u0444\u0435\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443 \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 4: PG 77, 991. 995-996)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044b \u041c\u0430\u0440\u044b\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043b\u044f\u0434\u0436\u0443 \u043d\u0430 \u0441\u0445\u043e\u0434 \u0448\u0430\u043d\u043e\u045e\u043d\u044b\u0445 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0441\u044e\u0434\u044b \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043d\u0430 \u0437\u0430\u043a\u043b\u0456\u043a \u0421\u0432\u044f\u0442\u043e\u0439 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044b, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456. \u0406 \u0445\u043e\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u044f \u0430\u0434\u0447\u0443\u0432\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u0441\u0443\u043c, \u0430\u0434\u043d\u0430\u043a, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u0441\u0430\u0431\u0440\u0430\u043d\u044b\u0445 \u0442\u0443\u0442 \u0441\u0432\u044f\u0442\u044b\u0445 \u0410\u0439\u0446\u043e\u045e, \u043c\u044f\u043d\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u044c. \u0422\u0430\u043a \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0440\u0430\u0434\u0430\u0441\u043d\u0430\u0435 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435 \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442\u044b \u0414\u0430\u0432\u0456\u0434\u0430: &laquo;\u042f\u043a \u0436\u0430 \u0434\u043e\u0431\u0440\u0430 \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430, \u043a\u0430\u043b\u0456 \u0431\u0440\u0430\u0442\u044b \u0436\u044b\u0432\u0443\u0446\u044c \u0440\u0430\u0437\u0430\u043c&raquo; (\u041f\u0441 133 [132], 1).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u044c \u0436\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430, \u0421\u0432\u044f\u0442\u0430\u044f \u0456 \u0422\u0430\u044f\u043c\u043d\u0456\u0447\u0430\u044f \u0422\u0440\u043e\u0439\u0446\u0430, \u044f\u043a\u0430\u044f \u0441\u0430\u0431\u0440\u0430\u043b\u0430 \u043d\u0430\u0441 \u0443 \u0433\u044d\u0442\u044b\u043c \u043a\u0430\u0441\u0446\u0451\u043b\u0435 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044b \u041c\u0430\u0440\u044b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u044c \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u0430, \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0430 \u041c\u0430\u0440\u044b\u044f, \u0434\u0430\u0441\u0442\u043e\u0439\u043d\u0430\u0435 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u043d\u043d\u0435 \u0441\u0432\u0435\u0442\u0443, \u043d\u0435\u043f\u0430\u0433\u0430\u0441\u043d\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u043d\u044f, \u043a\u0430\u0440\u043e\u043d\u0430 \u0434\u0437\u0435\u0432\u0430\u045e, \u0436\u0430\u0437\u043b\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0432\u0435\u0440\u044b, \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f, \u0436\u044b\u043b\u043b\u0451 \u0411\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0433\u0430, \u0414\u0437\u0435\u0432\u0430 \u0456 \u041c\u0430\u0446\u0456, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u0443 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456 &laquo;\u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u043c&raquo; \u043d\u0430\u0437\u0432\u0430\u043d\u044b &laquo;\u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430&raquo; (\u041c\u0446 21, 9).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0443\u0434\u0437\u044c \u043f\u0440\u044b\u0432\u0456\u0442\u0430\u043d\u0430, \u044f\u043a\u0430\u044f \u045e \u0441\u0432\u0430\u0456\u043c \u0434\u0437\u044f\u0432\u043e\u0447\u044b\u043c \u0443\u043b\u043e\u043d\u043d\u0456 \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u0411\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0433\u0430. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u0421\u0432\u044f\u0442\u0430\u044f \u0422\u0440\u043e\u0439\u0446\u0430 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043f\u0430\u0448\u0430\u043d\u0443 \u0456 \u0445\u0432\u0430\u043b\u0443 \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0441\u043b\u0430\u045e\u043d\u044b \u043a\u0440\u044b\u0436 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0445\u0432\u0430\u043b\u0443 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u043d\u044f\u0431\u0451\u0441\u044b, \u0432\u0435\u0441\u044f\u043b\u044f\u0446\u0446\u0430 \u0430\u043d\u0451\u043b\u044b \u0456 \u0430\u0440\u0445\u0430\u043d\u0451\u043b\u044b, \u0437\u043d\u0456\u043a\u0430\u044e\u0446\u044c \u0434\u044d\u043c\u0430\u043d\u044b; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u043b\u044c\u043d\u0456\u043a \u0431\u044b\u045e \u0441\u043a\u0456\u043d\u0443\u0442\u044b \u0437 \u043d\u0435\u0431\u0430; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u0433\u0440\u044d\u0448\u043d\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u045e\u0437\u043d\u044f\u043b\u043e\u0441\u044f \u043d\u0430 \u043d\u0435\u0431\u0430; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u0430\u0435 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c \u0456\u0434\u0430\u043b\u0430\u043f\u0430\u043a\u043b\u043e\u043d\u0441\u0442\u0432\u0430\u043c, \u0434\u0430\u0439\u0448\u043b\u043e \u0434\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u045e\u0434\u044b; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u044f \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0445\u0440\u043e\u0441\u0442, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c &laquo;\u0430\u043b\u0435\u0439 \u0432\u044f\u0441\u0435\u043b\u043b\u044f&raquo;; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u043f\u0430\u045e\u0441\u0442\u0430\u044e\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u044b; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u0434\u0430 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u044f\u0448\u0447\u044d \u0441\u043a\u0430\u0437\u0430\u0446\u044c? \u0412\u043e\u0441\u044c, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0437\u0430\u044f\u0441\u043d\u0435\u043b\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e &laquo;\u0431\u044b\u045e \u0443 \u0446\u0435\u043c\u0440\u044b \u0456 \u045e \u0446\u0435\u043d\u0456 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c&raquo; (\u041b\u043a 1, 79). \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0430\u043c; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0430\u044e\u0446\u044c; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u043f\u0430\u043d\u0443\u044e\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u0456 \u045e \u0456\u043c\u044f \u0421\u0432\u044f\u0442\u043e\u0439 \u0422\u0440\u043e\u0439\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0436 \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u0437\u043c\u043e\u0436\u0430 \u0433\u043e\u0434\u043d\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u043d\u0430\u0439\u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0435\u0439\u0448\u0443\u044e \u041c\u0430\u0440\u044b\u044e? \u042f\u043d\u0430 \u041c\u0430\u0446\u0456 \u0456 \u0414\u0437\u0435\u0432\u0430. \u041d\u0435\u0447\u0443\u0432\u0430\u043d\u0430\u044f \u0440\u044d\u0447! \u0413\u044d\u0442\u044b \u0446\u0443\u0434 \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0435 \u043c\u044f\u043d\u0435. \u0425\u0442\u043e \u0436 \u0447\u0443\u045e \u043a\u0430\u043b\u0456-\u043d\u0435\u0431\u0443\u0434\u0437\u044c, \u043a\u0430\u0431 \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a \u043d\u0435 \u043c\u043e\u0433 \u0443\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u044f\u043a\u0443\u044e \u0441\u0430\u043c \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e? \u041a\u0430\u0433\u043e \u0436 \u0430\u0431\u0440\u0430\u0436\u0430\u0435 \u0432\u044b\u0431\u0430\u0440 \u0441\u043b\u0443\u0433\u0456 \u043d\u0430 \u0441\u0432\u0430\u044e \u043c\u0430\u0446\u0456?<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0447\u0430\u043c\u0443 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u043f\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u0446\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u044e; \u0456 \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0456 \u0448\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c; \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0456 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0446\u044c \u043d\u0435\u043f\u0430\u0434\u0437\u0435\u043b\u044c\u043d\u0443\u044e \u0422\u0440\u043e\u0439\u0446\u0443, \u0445\u0432\u0430\u043b\u044f\u0447\u044b \u041c\u0430\u0440\u044b\u044e, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0414\u0437\u0435\u0432\u0443, \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0411\u043e\u0436\u0443\u044e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u042f\u0435 \u0421\u044b\u043d\u0430 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0433\u0430 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430, \u044f\u043a\u043e\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041b\u043a 1, 48-49<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u0441\u0430 \u041c\u043d\u043e\u044e \u045e\u0441\u0435, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u041f\u0430\u043d\u0430, \u0431\u043e \u0445\u043e\u0446\u044c \u0431\u044b\u043b\u0430 \u0437 \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u044b\u0445, \u0432\u044b\u0431\u0440\u0430\u045e \u041c\u044f\u043d\u0435 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b. <span style=\"color: #ff0000;\">*<\/span> \u041d\u0430\u0441\u0456\u043b\u0430 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0441\u0432\u0430\u0456\u043c \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u041c\u044f\u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0441\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456, \u0431\u043e \u0433\u043b\u044f\u043d\u0443\u045e \u0411\u043e\u0433 \u043d\u0430 \u043f\u0430\u043a\u043e\u0440\u0443 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0443\u0433\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0441\u0456\u043b\u0430 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0441\u0432\u0430\u0456\u043c \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"712","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0412\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u0441\u0432. \u041f\u0430\u0442\u0440\u044b\u043a\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 14-16: PL 53, 808-809)<\/span><br \/><span style=\"color: #ff0000;\">\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043c\u043d\u0435 \u0448\u043c\u0430\u0442 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0430\u0434\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0434\u043b\u044f \u0411\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0441\u0442\u043e\u043c\u043d\u0430 \u0434\u0437\u044f\u043a\u0443\u044e \u043c\u0430\u0439\u043c\u0443 \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u0437\u0430\u0432\u0430\u0445\u0430\u045e \u043c\u044f\u043d\u0435 \u0432\u0435\u0440\u043d\u044b\u043c \u0443 \u0434\u0437\u0435\u043d\u044c \u043c\u0430\u0439\u0433\u043e \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f, \u0442\u0430\u043a \u0448\u0442\u043e \u0441\u0451\u043d\u043d\u044f \u044f \u043c\u0430\u0433\u0443 \u0437 \u0434\u0430\u0432\u0435\u0440\u0430\u043c \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0425\u0440\u044b\u0441\u0442\u0443, \u043c\u0430\u0439\u043c\u0443 \u041f\u0430\u043d\u0443, \u0441\u0432\u0430\u044e \u0434\u0443\u0448\u0443, \u0431\u043e \u0401\u043d \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0439 \u043d\u044f\u0434\u043e\u043b\u0456. \u0422\u0430\u043c\u0443 \u044f \u043a\u0430\u0436\u0443: \u0425\u0442\u043e \u0436 \u044f, \u041f\u0430\u043d\u0435, \u0456 \u044f\u043a\u043e\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u043c\u0430\u0451, \u0448\u0442\u043e \u0422\u044b \u0430\u0434\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435 \u0442\u0430\u043a\u043e\u0439 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044e? \u0421\u0451\u043d\u043d\u044f \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u044f \u043c\u0430\u0433\u0443 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0422\u0432\u0430\u0451 \u0456\u043c\u044f, \u0434\u0437\u0435 \u0431 \u044f \u043d\u0456 \u0430\u043f\u044b\u043d\u0443\u045e\u0441\u044f \u0446\u0456 \u045e \u0448\u0447\u0430\u0441\u0446\u0456, \u0446\u0456 \u045e \u043d\u044f\u0434\u043e\u043b\u0456. \u0428\u0442\u043e \u0431 \u0441\u0430 \u043c\u043d\u043e\u044e \u043d\u0456 \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f, \u0434\u043e\u0431\u0440\u0430\u0435 \u0446\u0456 \u0434\u0440\u044d\u043d\u043d\u0430\u0435, \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430 \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u0433\u044d\u0442\u0430 \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u0446\u0432\u0451\u0440\u0434\u0430 \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e \u0456 \u044f\u043a\u0456 \u0432\u044b\u0441\u043b\u0443\u0445\u043e\u045e\u0432\u0430\u0435 \u043c\u044f\u043d\u0435. \u042f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0446\u0456 \u045e \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456 \u0431\u0443\u0434\u0443 \u0434\u0430\u043f\u0443\u0448\u0447\u0430\u043d\u044b \u0434\u0430 \u0442\u0430\u043a\u043e\u0439 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0439 \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b, \u043a\u0430\u0431 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0442\u044b\u0445, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u041f\u0430\u043d \u0434\u0430\u045e\u043d\u043e \u043f\u0440\u0430\u0434\u0432\u044f\u0441\u0446\u0456\u045e, \u0448\u0442\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 &laquo;\u044f\u043a \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u045e\u0441\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043a\u0443\u043b\u044c \u0436\u0430 \u045e \u043c\u044f\u043d\u0435 \u0433\u044d\u0442\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u044f\u043a\u043e\u0439 \u044f \u043d\u0435 \u043c\u0435\u045e, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0447\u044b \u043d\u0456 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456 \u043c\u0430\u0456\u0445 \u0434\u0437\u0451\u043d, \u043d\u0456 \u041f\u0430\u043d\u0430? \u0410\u0434\u043a\u0443\u043b\u044c \u0436\u0430 \u045e \u043c\u044f\u043d\u0435 \u0442\u0430\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0456 \u0442\u0430\u043a\u0456 \u0437\u0431\u0430\u045e\u0447\u044b \u0434\u0430\u0440 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u042f\u0433\u043e, \u0448\u0442\u043e \u044f \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0440\u0430\u0434\u0437\u0456\u043c\u0443 \u0456 \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u0456 \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u045e\u0441\u044f \u0434\u0430 \u0456\u0440\u043b\u0430\u043d\u0434\u0441\u043a\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0456\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u043f\u0430\u0433\u0430\u0440\u0434\u0443 \u043d\u044f\u0432\u0435\u0440\u043d\u044b\u0445 \u0456 \u0441\u043e\u0440\u0430\u043c \u043c\u0430\u0439\u0433\u043e \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430, \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0433\u0430\u043d\u0435\u043d\u043d\u0456 \u0430\u0436 \u0434\u0430 \u043d\u044f\u0432\u043e\u043b\u0456 \u0456 \u0441\u0442\u0440\u0430\u0442\u044b \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u0441\u0432\u0430\u0431\u043e\u0434\u044b \u0434\u0437\u0435\u043b\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u0456\u043d\u0448\u044b\u0445?<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0430\u043a\u0430\u0436\u0443\u0441\u044f \u0432\u0430\u0440\u0442\u044b\u043c \u0456 \u041f\u0430\u043d \u0434\u0430\u0441\u0446\u044c \u043c\u043d\u0435 \u0433\u044d\u0442\u044b \u0434\u0430\u0440, \u044f \u0433\u0430\u0442\u043e\u0432\u044b \u0431\u0435\u0437 \u0432\u0430\u0433\u0430\u043d\u043d\u044f\u045e \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0430\u0434\u0434\u0430\u0446\u044c \u043d\u0430\u0432\u0430\u0442 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0437\u0430 \u042f\u0433\u043e\u043d\u0430\u0435 \u0456\u043c\u044f. \u0411\u043e \u044f \u045e \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0434\u0430\u045e\u0433\u0443 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u044f\u043a\u0456 \u0430\u0434\u0430\u0440\u044b\u045e \u043c\u044f\u043d\u0435 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0439, \u0448\u0442\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043c\u043d\u0435 \u0448\u043c\u0430\u0442 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0430\u0434\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0443 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0432\u0435\u0440\u044b, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u045e\u0441\u044e\u043b\u044c \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u044b \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0456 \u043d\u044f\u0434\u0430\u045e\u043d\u0430 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0432\u0435\u0440\u044b \u0456 \u044f\u043a\u0456 \u041f\u0430\u043d \u0443\u0437\u044f\u045e \u0437 \u043a\u0440\u0430\u0451\u045e \u0437\u044f\u043c\u043b\u0456, \u044f\u043a \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0430\u0431\u044f\u0446\u0430\u045e \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e: &laquo;\u041f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0434\u0430 \u0426\u044f\u0431\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0437 \u043a\u0440\u0430\u0451\u045e \u0437\u044f\u043c\u043b\u0456 \u0456 \u0441\u043a\u0430\u0436\u0443\u0446\u044c: &ldquo;\u042f\u043a\u0456\u0445 \u0436\u0430 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u0445 \u0456\u0434\u0430\u043b\u0430\u045e \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0456 \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u043e\u0434\u043a\u0456 \u0456 \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u0437 \u0456\u0445 \u043d\u0456\u044f\u043a\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456&rdquo;&raquo; (\u0415\u0440 16, 19). \u0406 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b: &laquo;\u0423\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044e \u0446\u044f\u0431\u0435 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043a\u0430\u0431 \u043c\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0430 \u0430\u0436 \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456&raquo; (\u043f\u0430\u0440. \u0406\u0441 49, 6).<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0430\u0447\u0443 \u0447\u0430\u043a\u0430\u0446\u044c \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0432\u0430\u0435, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456: &laquo;\u041c\u043d\u043e\u0433\u0456\u044f \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0437 \u0443\u0441\u0445\u043e\u0434\u0443 \u0456 \u0437\u0430\u0445\u0430\u0434\u0443 \u0456 \u0441\u044f\u0434\u0443\u0446\u044c \u0437\u0430 \u0441\u0442\u043e\u043b \u0437 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430\u043c, \u0406\u0441\u0430\u0430\u043a\u0430\u043c \u0456 \u042f\u043a\u0443\u0431\u0430\u043c \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u041d\u044f\u0431\u0435\u0441\u043d\u044b\u043c&raquo; (\u041c\u0446 8, 11). \u0406 \u043c\u044b \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b\u044f, \u0448\u0442\u043e \u0432\u0435\u0440\u043d\u0456\u043a\u0456 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0437 \u0443\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 15, 15b-16; 1, 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430\u0434\u0437\u0435\u043d\u0430 \u043c\u043d\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430 \u043b\u0430\u0441\u043a\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u044f \u043c\u0430\u0433\u0443 \u0431\u044b\u0446\u044c \u0441\u043b\u0443\u0433\u043e\u044e \u0425\u0440\u044b\u0441\u0442\u0430 \u0434\u043b\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u0443\u044e \u043f\u0430\u0441\u043b\u0443\u0433\u0443 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0433\u044d\u0442\u0430\u0435 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u0430\u0435 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0431\u044b\u043b\u043e \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043b\u0443\u0436\u0443 \u0410\u0439\u0446\u0443 \u045e \u0434\u0443\u0445\u0443 \u0441\u0432\u0430\u0456\u043c, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0433\u044d\u0442\u0430\u0435<span style=\"text-align: justify;\">\u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u0430\u0435 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0431\u044b\u043b\u043e \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"713","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0442\u044d\u0445\u0435\u0437\u0430 \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Catech. 3, 1-3: PG 33, 426-430)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439\u0446\u0435 \u0447\u044b\u0441\u0442\u044b \u043f\u043e\u0441\u0443\u0434, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041d\u044f\u0445\u0430\u0439 \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u043d\u044f\u0431\u0451\u0441\u044b \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u0437\u044f\u043c\u043b\u044f&raquo; (\u041f\u0441 96 [95]), 11) \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u044b\u045e \u0430\u043a\u0440\u043e\u043f\u043b\u0435\u043d\u044b \u0456\u0441\u043e\u043f\u0430\u043c \u0456 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0456\u0441\u043e\u043f\u0430\u043c \u043c\u043e\u0446\u0430\u044e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u0434\u0447\u0430\u0441 \u0441\u0432\u0430\u0451\u0439 \u043c\u0443\u043a\u0456 \u0431\u044b\u045e \u043d\u0430\u043f\u043e\u0435\u043d\u044b \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0456\u0441\u043e\u043f\u0443 \u0456 \u0442\u0440\u044b\u0441\u0446\u0456\u043d\u044b. \u041d\u044f\u0445\u0430\u0439 \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u043c\u043e\u0446\u044b, \u0430 \u0434\u0443\u0448\u044b, \u044f\u043a\u0456\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u043b\u0443\u0447\u044b\u0446\u0446\u0430 \u0437 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430\u043c, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u044e\u0446\u0446\u0430. \u0411\u043e \u0432\u043e\u0441\u044c \u0433\u0443\u0447\u044b\u0446\u044c &laquo;\u0433\u043e\u043b\u0430\u0441 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u043b\u0456\u0447\u0430 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456: &ldquo;\u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439\u0446\u0435 \u0434\u0430\u0440\u043e\u0433\u0443 \u041f\u0430\u043d\u0443&rdquo;&raquo; (\u041c\u0446 3, 3).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0439\u0446\u0435, \u0441\u044b\u043d\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0441\u0432. \u042f\u043d\u0430, \u044f\u043a\u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: &laquo;\u0420\u0430\u045e\u043d\u044f\u0439\u0446\u0435 \u0434\u0430\u0440\u043e\u0433\u0443 \u041f\u0430\u043d\u0443&raquo; (\u042f\u043d 1, 23). \u041f\u0440\u044b\u0431\u044f\u0440\u044b\u0446\u0435 \u045e\u0441\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b, \u043a\u0430\u0431 \u0432\u044b \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u043f\u0440\u043e\u0441\u0442\u044b\u043c \u0448\u043b\u044f\u0445\u0430\u043c. \u041f\u0440\u0430\u0437 \u0448\u0447\u044b\u0440\u0443\u044e \u0432\u0435\u0440\u0443 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439\u0446\u0435 \u0447\u044b\u0441\u0442\u044b \u043f\u043e\u0441\u0443\u0434, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u041f\u0430\u0447\u043d\u0456\u0446\u0435 \u0430\u0431\u043c\u044b\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0451 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u043f\u0440\u0430\u0437 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0435, \u043a\u0430\u0431 \u0430\u043a\u0430\u0437\u0430\u0446\u0446\u0430 \u0447\u044b\u0441\u0442\u044b\u043c\u0456, \u043a\u0430\u043b\u0456 \u0432\u0430\u0441 \u043f\u0430\u043a\u043b\u0456\u0447\u0443\u0446\u044c \u0443 \u043f\u0430\u043a\u043e\u0439 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a \u043a\u043b\u0456\u0447\u0430 \u045e\u0441\u0456\u0445 \u0431\u0435\u0437 \u0440\u043e\u0437\u043d\u0456\u0446\u044b, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u0448\u0447\u043e\u0434\u0440\u044b \u0456 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u044b \u045e \u0441\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u0446\u044b. \u0401\u043d \u043a\u043b\u0456\u0447\u0430 \u045e\u0441\u0456\u0445 \u0433\u0443\u0447\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u043e\u045e, \u0430 \u043f\u043e\u0442\u044b\u043c \u0441\u0430\u043c \u0432\u044b\u0431\u0456\u0440\u0430\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0432\u044f\u0441\u0435\u043b\u043b\u0435, \u044f\u043a\u043e\u0435 \u045e\u0432\u0430\u0441\u0430\u0431\u043b\u044f\u0435 \u0445\u0440\u043e\u0441\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u043a\u043e\u043c\u0443 \u0437 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0434\u0430\u045e \u0441\u0432\u0430\u0435 \u0456\u043c\u0451\u043d\u044b, \u043d\u0435 \u0437\u0434\u0430\u0440\u044b\u0446\u0446\u0430 \u043f\u0430\u0447\u0443\u0446\u044c: &laquo;\u0421\u044f\u0431\u0440\u0430, \u044f\u043a \u0442\u044b \u045e\u0432\u0430\u0439\u0448\u043e\u045e, \u043d\u0435 \u043c\u0430\u044e\u0447\u044b \u0432\u044f\u0441\u0435\u043b\u044c\u043d\u0430\u0433\u0430 \u0441\u0442\u0440\u043e\u044e&raquo; (\u043f\u0430\u0440. \u041c\u0446 22, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043d\u044f\u0445\u0430\u0439 \u0432\u044b \u045e\u0441\u0435 \u043f\u0430\u0447\u0443\u0435\u0446\u0435: &laquo;\u0414\u043e\u0431\u0440\u0430, \u0441\u043b\u0443\u0433\u0430 \u0434\u043e\u0431\u0440\u044b \u0456 \u0432\u0435\u0440\u043d\u044b, \u0443 \u043c\u0430\u043b\u044b\u043c \u0442\u044b \u0431\u044b\u045e \u0432\u0435\u0440\u043d\u044b, \u043d\u0430\u0434 \u043c\u043d\u043e\u0433\u0456\u043c \u0446\u044f\u0431\u0435 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044e. \u0423\u0432\u0430\u0439\u0434\u0437\u0456 \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0442\u0432\u0430\u0439\u0433\u043e&raquo; (\u041c\u0446 25, 21. 23).<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0432\u044b \u0441\u0442\u0430\u044f\u043b\u0456 \u0437\u0430 \u0431\u0440\u0430\u043c\u0430\u0439. \u041d\u044f\u0445\u0430\u0439 \u0431\u044b \u045e\u0441\u0435 \u0437\u043c\u0430\u0433\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0437\u0430\u0432\u0451\u045e \u043c\u044f\u043d\u0435 \u045e \u0441\u0432\u043e\u0439 \u043f\u0430\u043a\u043e\u0439. \u0423\u0437\u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u045e \u041f\u0430\u043d\u0443, \u0431\u043e \u0401\u043d \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u043c\u044f\u043d\u0435 \u045e \u0448\u0430\u0442\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u043f\u043b\u0430\u0448\u0447\u043e\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0430\u0445\u0456\u043d\u0443\u045e \u043c\u044f\u043d\u0435; \u044f\u043a \u0436\u0430\u043d\u0456\u0445\u0430, \u0443\u0432\u044f\u043d\u0447\u0430\u045e \u043a\u0430\u0440\u043e\u043d\u0430\u0439, \u044f\u043a \u043d\u044f\u0432\u0435\u0441\u0442\u0443, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u045e \u0441\u0432\u0430\u0456\u043c\u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044f\u043c\u0456&raquo; (\u043f\u0430\u0440. \u0406\u0441 61, 10).<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435 \u0432\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b \u0430\u043a\u0430\u0436\u0443\u0446\u0446\u0430 \u0431\u0435\u0437 \u0437\u0430\u0433\u0430\u043d\u0430\u045e, \u0431\u0435\u0437 \u0445\u0456\u0431\u0430\u045e \u0446\u0456 \u0447\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430. \u0406 \u043d\u0435 \u043a\u0430\u0436\u0443, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u0445\u0440\u043e\u0441\u0442\u0430\u043c, \u0431\u043e \u045e\u043b\u0430\u0441\u043d\u0430 \u0434\u043b\u044f \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u044f \u0433\u0440\u0430\u0445\u043e\u045e \u0432\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f. \u0410\u043b\u0435 \u043f\u0430\u0441\u043b\u044f \u045e\u0434\u0437\u044f\u043b\u0435\u043d\u043d\u044f \u0432\u0430\u043c \u0433\u044d\u0442\u0430\u0439 \u043b\u0430\u0441\u043a\u0456 \u043d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0430\u043d\u0430 \u043d\u0456\u044f\u043a\u0456\u043c \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u0435\u043c, \u0430\u043b\u0435 \u043f\u043b\u0451\u043d\u043d\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u0447\u0430\u0435 \u0437 \u0451\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u0433\u044d\u0442\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430, \u0442\u0430\u043c\u0443 \u0432\u0430\u0437\u044c\u043c\u0456\u0446\u0435\u0441\u044f \u0437\u0430 \u044f\u0435 \u0437 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0439 \u0443\u0432\u0430\u0433\u0430\u0439. \u0411\u043e \u043a\u043e\u0436\u043d\u044b \u0437 \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0443 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u0445 \u0432\u043e\u0439\u0441\u043a\u0430\u045e \u0430\u043d\u0451\u043b\u0430\u045e. \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0430\u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043f\u044f\u0447\u0430\u0442\u043a\u0430\u0439 \u0432\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b, \u0431\u043e \u0432\u0430\u0441 \u0442\u0440\u044d\u0431\u0430 \u0432\u044b\u0431\u0440\u0430\u0446\u044c \u0434\u043b\u044f \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u043c\u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443.<br \/>\u0422\u0430\u043c\u0443 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439\u0446\u0435\u0441\u044f \u0456 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0433\u0430\u0442\u043e\u0432\u044b\u044f; \u043d\u0435 \u0430\u043f\u0440\u0430\u043d\u0430\u0439\u0446\u0435\u0441\u044f \u045e \u043f\u044b\u0448\u043d\u044b \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u044b \u0441\u0442\u0440\u043e\u0439, \u0430\u043b\u0435 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0439\u0446\u0435 \u0441\u044f\u0431\u0435 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044e \u0434\u0443\u0448\u044b, \u0448\u0442\u043e \u043c\u0430\u0435 \u0447\u044b\u0441\u0442\u0430\u0435 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0430\u043b 2, 6; \u041f\u0441 89 (88), 22<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u043a\u043e\u043d \u043f\u0440\u0430\u045e\u0434\u044b \u0431\u044b\u045e \u0443 \u0432\u0443\u0441\u043d\u0430\u0445 \u044f\u0433\u043e\u043d\u044b\u0445, \u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u043e\u0441\u044f \u043d\u0430 \u044f\u0433\u043e\u043d\u044b\u043c \u044f\u0437\u044b\u043a\u0443. <span style=\"color: #ff0000;\">*<\/span> \u0423 \u0441\u043f\u0430\u043a\u043e\u0456 \u0456 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0451\u043d \u043f\u0430\u0439\u0448\u043e\u045e \u0441\u0430 \u041c\u043d\u043e\u0439, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0420\u0443\u043a\u0430 \u043c\u043e\u0446\u044b \u041c\u0430\u0451\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u0437 \u0456\u043c, \u0456 \u043f\u043b\u044f\u0447\u043e \u041c\u0430\u0451 \u044f\u0433\u043e \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0441\u043f\u0430\u043a\u043e\u0456&nbsp;<span style=\"text-align: justify;\">\u0456 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0451\u043d \u043f\u0430\u0439\u0448\u043e\u045e \u0441\u0430 \u041c\u043d\u043e\u0439, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d<\/span>.<\/p>\r\n"}, {"GCH_CH_2_ID":"714","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430 \u0421\u0456\u0435\u043d\u0441\u043a\u0430\u0433\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 2, de S. Ioseph: Opera 7, 16. 27-30)<\/span><br \/><span style=\"color: #ff0000;\">\u0412\u0435\u0440\u043d\u044b \u043a\u0430\u0440\u043c\u0456\u0446\u0435\u043b\u044c \u0456 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0433\u0443\u043b\u044c\u043d\u0430\u0435 \u043f\u0440\u0430\u0432\u0456\u043b\u0430 \u043f\u0440\u044b \u045e\u0434\u0437\u044f\u043b\u0435\u043d\u043d\u0456 \u045e\u0441\u044f\u043a\u0456\u0445 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u0445 \u043b\u0430\u0441\u043a\u0430\u045e \u043d\u0435\u0439\u043a\u0430\u043c\u0443 \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u043c\u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044e \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u043a\u0430\u043b\u0456 \u0411\u043e\u0436\u0430\u044f \u043f\u0440\u044b\u0445i\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0432\u044b\u0431\u0456\u0440\u0430\u0435 \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0434\u043b\u044f \u043d\u0435\u0439\u043a\u0430\u0439 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0439 \u043b\u0430\u0441\u043a\u0456 \u0430\u0431\u043e \u0434\u0430 \u043d\u0435\u0439\u043a\u0430\u0433\u0430 \u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u0443, \u043d\u0430\u0434\u0437\u044f\u043b\u044f\u0435 \u044f\u0433\u043e \u045e\u0441\u0456\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u044f \u0433\u044d\u0442\u0430\u0439 \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0439 \u0430\u0441\u043e\u0431\u0435 \u0456, \u0443 \u0434\u0430\u0434\u0430\u0442\u0430\u043a, \u0443\u0441\u0435\u0431\u0430\u043a\u043e\u0432\u0430 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u044e\u0446\u044c \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u043d\u0430 \u0430\u0441\u043e\u0431\u0435 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u042e\u0437\u0430\u0444\u0430, \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0431\u0430\u0446\u044c\u043a\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u043a\u0456 \u0441\u0432\u0435\u0442\u0443 \u0456 \u041f\u0430\u043d\u043d\u044b \u0430\u043d\u0451\u043b\u0430\u045e. \u0421\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b \u0410\u0439\u0446\u0435\u0446 \u0432\u044b\u0431\u0440\u0430\u045e \u044f\u0433\u043e \u044f\u043a \u0432\u0435\u0440\u043d\u0430\u0433\u0430 \u043a\u0430\u0440\u043c\u0456\u0446\u0435\u043b\u044f \u0456 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u0430 \u0441\u0432\u0430\u0456\u0445 \u0433\u0430\u043b\u043e\u045e\u043d\u044b\u0445 \u0441\u043a\u0430\u0440\u0431\u0430\u045e, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0456 \u0441\u0432\u0430\u0451\u0439 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b; \u0456 \u042e\u0437\u0430\u0444 \u0437 \u043d\u0430\u0439\u0432\u044f\u043b\u0456\u043a\u0448\u0430\u0439 \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044e \u0432\u044b\u043a\u0430\u043d\u0430\u045e \u0441\u0432\u043e\u0439 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u043a\u0430\u0436\u0430: &laquo;\u0421\u043b\u0443\u0433\u0430 \u0434\u043e\u0431\u0440\u044b \u0456 \u0432\u0435\u0440\u043d\u044b, \u0443\u0432\u0430\u0439\u0434\u0437\u0456 \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0442\u0432\u0430\u0439\u0433\u043e&raquo; (\u043f\u0430\u0440. \u041c\u0446 25, 21).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u0443\u0430\u0434\u043d\u0435\u0441\u0446\u0456 \u042e\u0437\u0430\u0444\u0430 \u0437 \u0443\u0441\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c, \u0434\u044b\u043a \u0446\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0451\u043d \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u0456 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0456 \u043f\u0430\u0434 \u0430\u043f\u0435\u043a\u0430\u0439 \u044f\u043a\u043e\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0441\u0442\u0443\u043f\u043e\u0432\u0430 \u0456 \u0433\u043e\u0434\u043d\u0430 \u0431\u044b\u045e \u0443\u0432\u0435\u0434\u0437\u0435\u043d\u044b \u045e \u0441\u0432\u0435\u0442? \u041a\u0430\u043b\u0456 \u045e\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0434\u0430\u045e\u0433\u0443 \u043f\u0435\u0440\u0430\u0434 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u041c\u0430\u0440\u044b\u044f\u0439, \u0431\u043e \u043f\u0440\u0430\u0437 \u042f\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0434\u044b\u043a, \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u043f\u0430\u0441\u043b\u044f \u042f\u0435 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0439 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0448\u0430\u043d\u044b \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435 \u042e\u0437\u0430\u0444.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d &ndash; \u0437\u0430\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u0435 \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0443 \u044f\u043a\u0456\u043c \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0430\u045e \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u044b \u043f\u043b\u043e\u0434. \u0417\u043d\u043e\u045e \u0436\u0430, \u0451\u043d \u0430\u0434\u0437\u0456\u043d, \u0445\u0442\u043e \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u0411\u043e\u0436\u0430\u044f \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043b\u0430 \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0448\u0442\u043e \u045e \u043d\u0435\u0431\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0430\u0434\u043c\u043e\u0432\u0456\u045e \u044f\u043c\u0443 \u045e \u0442\u043e\u0439 \u0431\u043b\u0456\u0437\u043a\u0430\u0441\u0446\u0456, \u043f\u0430\u0448\u0430\u043d\u0435 \u0456 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456, \u044f\u043a\u0443\u044e \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u045e \u044f\u043a \u0441\u044b\u043d \u0434\u0430 \u0431\u0430\u0446\u044c\u043a\u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u0441\u0432\u0430\u0439\u0433\u043e \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0430 \u0445\u0443\u0442\u0447\u044d\u0439 \u0434\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0456 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u045e \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0446\u0430\u043b\u043a\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0434\u0430\u0434\u0430\u0435: &laquo;\u0423\u0432\u0430\u0439\u0434\u0437\u0456 \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0442\u0432\u0430\u0439\u0433\u043e&raquo;. \u0425\u043e\u0446\u044c \u043d\u0430\u0441\u0430\u043c\u0440\u044d\u0447 \u0433\u044d\u0442\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430: &laquo;\u0423\u0432\u0430\u0439\u0434\u0437\u0456 \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044c&raquo;, \u043a\u0430\u0431 \u043c\u0456\u0441\u0442\u044b\u0447\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0430\u0434\u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0433\u044d\u0442\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u043d\u0443\u0442\u0440\u044b \u044f\u0433\u043e, \u0430\u043b\u0435 \u044f\u043d\u0430 \u0430\u0431\u043a\u0440\u0443\u0436\u0430\u0435 \u044f\u0433\u043e \u0430\u0434\u0443\u0441\u044e\u043b\u044c \u0456 \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u0445\u0432\u0430\u043b\u044f\u0445 \u0431\u044f\u0437\u0434\u043e\u043d\u043d\u0430\u0433\u0430 \u0430\u043a\u0456\u044f\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0430\u043c\u044f\u0442\u0430\u0439 \u043f\u0440\u0430 \u043d\u0430\u0441, \u0441\u0432\u044f\u0442\u044b \u042e\u0437\u044d\u0444\u0435, \u0456 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0441\u044f \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0456\u043c \u043c\u0430\u043b\u0456\u0442\u043e\u045e\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u0443\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u043c \u0421\u044b\u043d\u0430\u043c. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0447\u044b\u043d\u0456 \u0431\u043e\u043b\u044c\u0448 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u0430\u044e \u0434\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u044e \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0443\u044e \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0443 \u0414\u0437\u0435\u0432\u0443, \u044f\u043a\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u041c\u0430\u0446\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u044b\u044f \u0432\u044f\u043a\u0456. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0421\u0456\u0440 51, 2-3<\/span><br \/>\u041d. \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u043c\u044f\u043d\u0435 \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u0430\u0446\u044c\u043a\u0430\u043c \u043a\u0430\u0440\u0430\u043b\u044f \u0456 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u043e\u043c \u0443\u0441\u044f\u0433\u043e \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0434\u043e\u043c\u0443. <span style=\"color: #ff0000;\">*<\/span> \u0423\u0437\u0432\u044b\u0441\u0456\u045e \u043c\u044f\u043d\u0435, \u043a\u0430\u0431 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b. <span style=\"color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span> \u0410\u043b\u043b\u0435\u043b\u044e\u044f<span style=\"color: #ff0000;\">)<\/span>.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0441\u0442\u0430\u045e \u043c\u0430\u0451\u0439 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0430\u0439 \u0456 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439, \u0401\u043d \u043c\u044f\u043d\u0435 \u0437\u0431\u0430\u0432\u0456\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span>&nbsp;<span style=\"text-align: justify;\">\u0423\u0437\u0432\u044b\u0441\u0456\u045e \u043c\u044f\u043d\u0435, \u043a\u0430\u0431 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b.&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span><span style=\"text-align: justify;\">&nbsp;\u0410\u043b\u043b\u0435\u043b\u044e\u044f<\/span><span style=\"text-align: justify; color: #ff0000;\">)<\/span><span style=\"text-align: justify;\">.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"715","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u044d\u043a\u0440\u044d\u0442 \u043f\u0440\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e \u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0435 &laquo;Christus Dominus&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 12-13. 16)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u0434\u0430 \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0443 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u044f \u043d\u044f\u0445\u0430\u0439 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u043b\u044e\u0434\u0437\u044f\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u043e \u0441\u044f\u0440\u043e\u0434 \u0433\u0430\u043b\u043e\u045e\u043d\u044b\u0445 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u045e \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e \u0433\u044d\u0442\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0448\u044b\u043c. \u041d\u044f\u0445\u0430\u0439 \u0443 \u043c\u043e\u0446\u044b \u0414\u0443\u0445\u0430 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0434\u0430 \u0432\u0435\u0440\u044b \u0446\u0456 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0456\u0445 \u0443 \u0436\u044b\u0432\u043e\u0439 \u0432\u0435\u0440\u044b. \u041d\u044f\u0445\u0430\u0439 \u0442\u043b\u0443\u043c\u0430\u0447\u0430\u0446\u044c \u0456\u043c \u0432\u0430 \u045e\u0441\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0446\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0442\u044b\u044f \u043f\u0440\u0430\u045e\u0434\u044b, \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u044f\u043a\u0456\u0445 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u044b \u0437\u0432\u044b\u0448 \u0448\u043b\u044f\u0445, \u044f\u043a\u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0411\u043e\u0433\u0430, \u0430 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0456 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u043d\u044f\u0445\u0430\u0439 \u0442\u043b\u0443\u043c\u0430\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u0437\u044f\u043c\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u045e\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u043c\u0435\u0440\u0443 \u0411\u043e\u0433\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u044f \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043b\u044e\u0434\u0437\u0435\u0439, \u0430 \u0442\u0430\u043c\u0443 \u043c\u043e\u0433\u0443\u0446\u044c \u0437\u043d\u0430\u0447\u043d\u0430 \u0441\u0430\u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0446\u044c \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0446\u044c \u0442\u0430\u043c\u0443, \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u0441\u0442\u0430\u0432\u0456\u0446\u0446\u0430, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0432\u0443\u0447\u044d\u043d\u043d\u0435\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0430\u0441\u043e\u0431\u044b, \u044f\u0435 \u0441\u0432\u0430\u0431\u043e\u0434\u044b \u0456 \u0441\u0430\u043c\u043e\u0433\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f; \u0434\u0430 \u0441\u044f\u043c&rsquo;\u0456, \u044f\u0435 \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430 \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u0456, \u0434\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0456 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430; \u0434\u0430 \u0446\u044b\u0432\u0456\u043b\u0456\u0437\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u0442\u0432\u0430, \u044f\u0433\u043e \u0437\u0430\u043a\u043e\u043d\u0430\u045e \u0456 \u043f\u0440\u0430\u0444\u0435\u0441\u0456\u0439, \u043f\u0440\u0430\u0446\u044b \u0456 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443, \u043c\u0430\u0441\u0442\u0430\u0446\u0442\u0432\u0430\u045e \u0456 \u0442\u044d\u0445\u043d\u0456\u0447\u043d\u044b\u0445 \u0432\u044b\u043d\u0430\u0445\u043e\u0434\u0441\u0442\u0432\u0430\u045e; \u0434\u0430 \u0431\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u0443 \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e. \u0423\u0440\u044d\u0448\u0446\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u043f\u0430\u043d\u0443\u044e\u0446\u044c \u0441\u043f\u043e\u0441\u0430\u0431\u044b \u0432\u044b\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u043d\u0430\u0439\u0432\u0430\u0436\u043d\u0435\u0439\u0448\u044b\u0445 \u043f\u044b\u0442\u0430\u043d\u043d\u044f\u045e \u043d\u0430\u043a\u043e\u043d\u0442 \u0432\u0430\u043b\u043e\u0434\u0430\u043d\u043d\u044f \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u044b\u043c\u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456, \u0456\u0445 \u043f\u0430\u0432\u0435\u043b\u0456\u0447\u044d\u043d\u043d\u044f \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u0440\u0430\u0437\u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u044f, \u043d\u0430\u043a\u043e\u043d\u0442 \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0432\u0430\u0439\u043d\u044b, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u043a\u0430\u0433\u0430 \u0441\u0443\u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0456\u0441\u043a\u0443\u043f\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u045e \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u043f\u0430\u0442\u0440\u044d\u0431\u0430\u043c\u0456 \u0447\u0430\u0441\u0443, \u043a\u0430\u0431 \u0434\u0430\u0432\u0430\u0446\u044c \u0430\u0434\u043a\u0430\u0437 \u043d\u0430 \u0442\u044b\u044f \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u0431\u043b\u0435\u043c\u044b, \u044f\u043a\u0456\u044f \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u043d\u0435\u043f\u0430\u043a\u043e\u044f\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439. \u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430 \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u044e\u0446\u044c \u0433\u044d\u0442\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435, \u0430\u043b\u0435 \u0456 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u0432\u0443\u0447\u0430\u0446\u044c \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0446\u044c \u0456 \u043f\u0430\u0448\u044b\u0440\u0430\u0446\u044c \u044f\u0433\u043e. \u041d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u043c\u0430\u0442\u0447\u044b\u043d \u043a\u043b\u043e\u043f\u0430\u0442 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043f\u0440\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 &mdash; \u044f\u043a \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e, \u0442\u0430\u043a \u0456 \u043d\u044f\u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445, \u0430\u0442\u0443\u043b\u044f\u044e\u0447\u044b \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u043c \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u043c \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0431\u0435\u0434\u043d\u044b\u0445 \u0456 \u0441\u043b\u0430\u0431\u044b\u0445, \u0434\u0430 \u044f\u043a\u0456\u0445 \u0431\u044b\u043b\u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u044b\u044f \u041f\u0430\u043d\u0430\u043c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0443 \u0430\u0439\u0446\u043e\u045e \u0456 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e \u043d\u044f\u0445\u0430\u0439 \u0431\u0456\u0441\u043a\u0443\u043f\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u0430\u0456\u0445 \u044f\u043a \u0441\u043b\u0443\u0433\u0456, \u044f\u043a \u0434\u043e\u0431\u0440\u044b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b, \u044f\u043a\u0456\u044f \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0456 \u044f\u043a\u0456\u0445 \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u0430\u0432\u0435\u0447\u043a\u0456, \u044f\u043a \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u044f \u0430\u0439\u0446\u044b, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u0432\u044f\u0446\u0446\u0430 \u0434\u0430 \u045e\u0441\u0456\u0445 \u0443 \u0434\u0443\u0445\u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e. \u041d\u044f\u0445\u0430\u0439 \u0437\u0431\u0456\u0440\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u044e \u0430\u045e\u0447\u0430\u0440\u043d\u044e \u0456 \u0434\u0430\u044e\u0446\u044c \u0451\u0439 \u0442\u0430\u043a\u0443\u044e \u0444\u0430\u0440\u043c\u0430\u0446\u044b\u044e, \u043a\u0430\u0431 \u0443\u0441\u0435, \u0443\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u044e\u0447\u044b \u0441\u0432\u0430\u0435 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0456, \u0436\u044b\u043b\u0456 \u0456 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u043b\u0456 \u045e \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0435 \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u043f\u0430\u0441\u043f\u044f\u0445\u043e\u0432\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0433\u044d\u0442\u0430\u0439 \u043c\u044d\u0442\u044b, \u043d\u044f\u0445\u0430\u0439 \u0431\u0456\u0441\u043a\u0443\u043f\u044b, &laquo;\u0433\u0430\u0442\u043e\u0432\u044b\u044f \u0434\u0430 \u043a\u043e\u0436\u043d\u0430\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b&raquo; (2 \u0426\u0456\u043c 2, 21) \u0456 &laquo;\u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u045e\u0441\u0451 \u043d\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445&raquo; (2 \u0426\u0456\u043c 2, 10), \u0441\u0443\u0430\u0434\u043d\u043e\u0441\u044f\u0446\u044c \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0437 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u043c\u0456 \u0447\u0430\u0441\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u041f 5, 2-4; \u0414\u0437 20, 28<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0441\u0432\u0456\u0446\u0435 \u0441\u0442\u0430\u0442\u0430\u043a \u0411\u043e\u0436\u044b \u0456 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0434\u043b\u044f \u044f\u0433\u043e. <span style=\"color: #ff0000;\">*<\/span> \u0410 \u043a\u0430\u043b\u0456 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u041f\u0430\u0441\u0442\u044b\u0440, \u0432\u044b \u0437\u0434\u0430\u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043d\u0435\u045e\u0432\u044f\u0434\u0430\u043b\u044c\u043d\u044b \u0432\u044f\u043d\u043e\u043a \u0441\u043b\u0430\u0432\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0456\u043b\u044c\u043d\u0443\u0439\u0446\u0435 \u0441\u044f\u0431\u0435 \u0456 \u045e\u0432\u0435\u0441\u044c \u0441\u0442\u0430\u0442\u0430\u043a, \u0443 \u044f\u043a\u0456\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0432\u0430\u0441 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c\u0456, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u0432\u0456\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0411\u043e\u0436\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u043a\u0430\u043b\u0456<span style=\"text-align: justify;\">\u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u041f\u0430\u0441\u0442\u044b\u0440, \u0432\u044b \u0437\u0434\u0430\u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043d\u0435\u045e\u0432\u044f\u0434\u0430\u043b\u044c\u043d\u044b \u0432\u044f\u043d\u043e\u043a \u0441\u043b\u0430\u0432\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"716","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 28 ad Flavianum, 3-4: PL 54, 763-767)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u043d\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u043b\u0456\u0447 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0430\u0441\u044f \u045e \u043f\u0430\u043a\u043e\u0440\u0443, \u043c\u043e\u0446 &ndash; \u0443 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c, \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c &ndash; \u0443 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u0430 \u0434\u043b\u044f \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0430\u0434 \u0434\u043e\u045e\u0433\u0443, \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430 \u0437\u043b\u0443\u0447\u044b\u043b\u0430\u0441\u044f \u0437 \u043d\u0430\u0442\u0443\u0440\u0430\u0439, \u043f\u0430\u0434\u043b\u0435\u0433\u043b\u0430\u0439 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u043c, \u043a\u0430\u0431 (\u0448\u0442\u043e \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u043b\u0430 \u043d\u0430\u0448\u0430\u043c\u0443 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0448\u0447\u0443) \u0430\u0434\u0437\u0456\u043d \u0456 \u0442\u043e\u0439 \u0436\u0430 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043c\u043e\u0433 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0456 \u043d\u0435 \u043c\u043e\u0433 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u044f\u043a \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0443 \u043f\u043e\u045e\u043d\u0430\u0439 \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u0411\u043e\u0433, \u043f\u043e\u045e\u043d\u044b \u045e \u0441\u0432\u0430\u0456\u0445 \u0431\u043e\u0441\u043a\u0456\u0445 \u0456 \u045e \u043d\u0430\u0448\u044b\u0445 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u0440\u044b\u0441\u0430\u0445. \u041d\u0430\u0448\u044b\u043c\u0456 \u043c\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c \u0442\u044b\u044f \u0440\u044b\u0441\u044b, \u044f\u043a\u0456\u044f \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0437\u0430\u043a\u043b\u0430\u045e \u0443 \u043d\u0430\u0441 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0456 \u044f\u043a\u0456\u044f \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043d\u044f\u045e \u0434\u043b\u044f \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u0451\u0441 \u043f\u0430\u0434\u043c\u0430\u043d\u0448\u0447\u044b\u043a \u0456 \u043f\u0440\u044b\u043d\u044f\u045e \u0430\u0448\u0443\u043a\u0430\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043d\u0435 \u043c\u0435\u043b\u0430 \u045e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044e \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0441\u043b\u0435\u0434\u0443. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u043d\u0435 \u043c\u0435\u045e \u0443\u0434\u0437\u0435\u043b\u0443 \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044f\u0445, \u0442\u043e \u0456 \u043d\u0435 \u0431\u044b\u045e \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u043d\u0430\u0448\u044b\u0445 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u043d\u044f\u045e \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456 \u0431\u0435\u0437 \u0431\u0440\u0443\u0434\u0443 \u0433\u0440\u0430\u0445\u0443, \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u044e\u0447\u044b \u0442\u043e\u0435, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u043c\u044f\u043d\u0448\u0430\u044e\u0447\u044b \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0431\u043e\u0441\u043a\u0430\u0435: \u0433\u044d\u0442\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435, \u043a\u0430\u043b\u0456 \u043d\u044f\u0431\u0430\u0447\u043d\u044b \u0441\u0442\u0430\u045e \u0431\u0430\u0447\u043d\u044b\u043c, \u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0456 \u0430\u0434\u0437\u0456\u043d\u044b \u041f\u0430\u043d \u0441\u0443\u0441\u0432\u0435\u0442\u0443 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0441\u0442\u0430\u0446\u044c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c, \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u044f\u0432\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u0430 \u043d\u0435 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u045e\u043b\u0430\u0434\u044b. \u0422\u0430\u043a \u0442\u043e\u0439, \u0445\u0442\u043e, \u0431\u0443\u0434\u0443\u0447\u044b \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0411\u043e\u0433\u0430, \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0441\u0430\u043c \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u043f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044b\u043d \u0411\u043e\u0436\u044b \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0433\u044d\u0442\u0443\u044e \u0437\u044f\u043c\u043d\u0443\u044e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c, \u0441\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u043f\u0430\u0441\u0430\u0434\u0443, \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u0410\u0439\u0446\u043e\u045e\u0441\u043a\u0430\u0439 \u0441\u043b\u0430\u0432\u044b; \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u045e \u043d\u043e\u0432\u044b\u043c \u043f\u0430\u0440\u0430\u0434\u043a\u0443 \u0456 \u043f\u0440\u0430\u0437 \u043d\u043e\u0432\u0430\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043d\u043e\u0432\u044b\u043c \u043f\u0430\u0440\u0430\u0434\u043a\u0443, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043d\u044f\u0431\u0430\u0447\u043d\u044b \u045e \u0441\u0432\u0430\u0451\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0401\u043d \u0441\u0442\u0430\u045e \u0431\u0430\u0447\u043d\u044b\u043c \u0443 \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b; \u0431\u0443\u0434\u0443\u0447\u044b \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u044b\u043c, \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0431\u044b\u0446\u044c \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u043d\u0443\u0442\u044b\u043c; \u0442\u0440\u044b\u0432\u0430\u044e\u0447\u044b \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443, \u043f\u0430\u0447\u0430\u045e \u0456\u0441\u043d\u0430\u0432\u0430\u0446\u044c \u0443 \u0447\u0430\u0441\u0435; \u0431\u0443\u0434\u0443\u0447\u044b \u041f\u0430\u043d\u0430\u043c \u0443\u0441\u044f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u043f\u0440\u044b\u043d\u044f\u045e \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456, \u0437\u0430\u0446\u044f\u043d\u0456\u045e\u0448\u044b \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u043b\u0456\u0447\u044b; \u0411\u043e\u0433, \u043d\u0435\u043f\u0430\u0434\u043b\u0435\u0433\u043b\u044b \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u043c, \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u0441\u0442\u0430\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u043f\u0430\u0434\u043b\u0435\u0433\u043b\u044b\u043c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u043c; \u0456, \u0431\u0443\u0434\u0443\u0447\u044b \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u045e\u0441\u044f \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0441\u0430\u043c\u0440\u044d\u0447, \u0442\u043e\u0439, \u0445\u0442\u043e \u0451\u0441\u0446\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0411\u043e\u0433\u0430\u043c, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0456 \u045e \u0433\u044d\u0442\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u043d\u044f\u043c\u0430 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0444\u0430\u043b\u044c\u0448\u0443, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u0443\u0442 \u0441\u0443\u0456\u0441\u043d\u0443\u044e\u0446\u044c \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u043f\u0430\u043a\u043e\u0440\u0430, \u0456 \u0432\u0435\u043b\u0456\u0447 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456.<br \/>\u042f\u043a \u0411\u043e\u0433 \u043d\u0435 \u0437\u043c\u044f\u043d\u044f\u0435\u0446\u0446\u0430, \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u044e\u0447\u044b \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0442\u0430\u043a \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0435 \u0431\u044b\u0446\u044c \u0441\u0430\u0431\u043e\u0439, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u0442\u0430\u043a\u0443\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c. \u041a\u043e\u0436\u043d\u0430\u044f \u0437 \u0433\u044d\u0442\u044b\u0445 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044f\u045e \u0440\u043e\u0431\u0456\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0430\u0434\u043d\u0430 \u0437 \u0430\u0434\u043d\u043e\u0439 \u0442\u043e\u0435, \u0448\u0442\u043e \u0451\u0439 \u0443\u043b\u0430\u0441\u0446\u0456\u0432\u0430. \u0421\u043b\u043e\u0432\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0421\u043b\u043e\u0432\u0443, \u0430 \u0446\u0435\u043b\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0446\u0435\u043b\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0448\u0430\u0435 \u0437 \u0456\u0445 \u0437\u0437\u044f\u0435 \u0446\u0443\u0434\u0430\u043c\u0456, \u0430 \u0434\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u0434\u0434\u0430\u0435\u0446\u0446\u0430 \u043a\u0440\u044b\u045e\u0434\u0430\u043c. \u0406 \u044f\u043a \u0421\u043b\u043e\u0432\u0430 \u043d\u0435 \u0430\u0434\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0432\u0435\u043b\u0456\u0447\u044b \u0410\u0439\u0446\u043e\u045e\u0441\u043a\u0430\u0439 \u0441\u043b\u0430\u0432\u044b, \u0442\u0430\u043a \u0446\u0435\u043b\u0430 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u043d\u0430\u0442\u0443\u0440\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0440\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0432\u0430\u0446\u044c, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0456 \u0442\u043e\u0439 \u0436\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b. \u0411\u043e\u0433, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e &laquo;\u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430, \u0456 \u0421\u043b\u043e\u0432\u0430 \u0431\u044b\u043b\u043e \u045e \u0411\u043e\u0433\u0430, \u0456 \u0411\u043e\u0433\u0430\u043c \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430&raquo; (\u042f\u043d 1, 1); \u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u043a, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e &laquo;\u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u043c\u0456&raquo; (\u042f\u043d 1, 14).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0437\u0435\u0432\u0430 \u041c\u0430\u0440\u044b\u044f, \u043f\u0440\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430, \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u0422\u0430\u0431\u0435 \u0430\u0434 \u041f\u0430\u043d\u0430 \u043f\u0440\u0430\u0437 \u0430\u043d\u0451\u043b\u0430: \u0422\u044b \u0437\u0430\u0447\u043d\u0435\u0448 \u0456 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0411\u043e\u0433\u0430 \u0456 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u0426\u044f\u0431\u0435 \u045e\u0441\u0435 \u0436\u0430\u043d\u0447\u044b\u043d\u044b. <span style=\"color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span> \u0410\u043b\u043b\u0435\u043b\u044e\u044f<span style=\"color: #ff0000;\">)<\/span>.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0448 \u0421\u044b\u043d\u0430, \u0430\u043b\u0435 \u0437\u0430\u0445\u0430\u0432\u0430\u0435\u0448 \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u0430\u0441\u0446\u044c; \u0437\u0430\u0446\u044f\u0436\u0430\u0440\u044b\u0448, \u0430\u043b\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439 \u041c\u0430\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0439<span style=\"text-align: justify;\">\u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u0426\u044f\u0431\u0435 \u045e\u0441\u0435 \u0436\u0430\u043d\u0447\u044b\u043d\u044b.&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span><span style=\"text-align: justify;\">&nbsp;\u0410\u043b\u043b\u0435\u043b\u044e\u044f<\/span><span style=\"text-align: justify; color: #ff0000;\">)<\/span><span style=\"text-align: justify;\">.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"717","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u043a\u0430 \u0437 \u041f\u0430\u043e\u043b\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epistola a. 1486: A. Galuzzi, Origini dell&rsquo;Ordine del Minimi, Romae, 1967, pp. 121-122)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u0430\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0448 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0436\u0432\u0430\u0435 \u0437 \u043d\u0430\u0439\u0432\u044f\u043b\u0456\u043a\u0448\u0430\u0439 \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u044e, \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u0432\u0430\u043c \u0437\u0430 \u0432\u0430\u0448\u0443\u044e \u043f\u0440\u0430\u0446\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0437\u0431\u044f\u0433\u0430\u0439\u0446\u0435 \u0437\u043b\u0430, \u0430\u0434\u0433\u0430\u043d\u044f\u0439\u0446\u0435 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0443. \u0410 \u043c\u044b \u0456 \u045e\u0441\u0435 \u043d\u0430\u0448\u044b \u0431\u0440\u0430\u0442\u044b, \u0445\u043e\u0446\u044c \u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u0456 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0414\u0437\u0435\u0432\u0443 \u041c\u0430\u0440\u044b\u044e \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0446\u044c \u0432\u0430\u0441 \u0443 \u0432\u0430\u0448\u044b\u043c \u043a\u043b\u043e\u043f\u0430\u0446\u0435 \u0430\u0431 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u043c\u043e\u0446\u043d\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u044e, \u043a\u0430\u0431 \u0432\u044b \u043c\u0443\u0434\u0440\u0430 \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0440\u0443\u043f\u0456\u043b\u0456\u0441\u044f \u0430\u0431 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0432\u0430\u0448\u044b\u0445 \u0434\u0443\u0448. \u0421\u043c\u0435\u0440\u0446\u044c \u043f\u044d\u045e\u043d\u0430\u044f, \u0436\u044b\u0446\u0446\u0451 \u043a\u0430\u0440\u043e\u0442\u043a\u0430\u0435 \u0456 \u0437\u043d\u0456\u043a\u0430\u0435, \u044f\u043a \u0434\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0437\u044c\u0446\u0435\u0441\u044f \u043d\u0430 \u043c\u0443\u0446\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u043d\u0430\u0441 \u0441\u044b\u0448\u043e\u045e \u0437 \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c \u043d\u0430\u0441; \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441 \u0401\u043d \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u0443\u0441\u0435 \u043f\u0430\u043a\u0443\u0442\u044b \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u0430 \u0456 \u043d\u0435 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u045e \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f. \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u0442\u0430\u043c\u0443 \u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b\u043c\u0456 \u045e \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043a\u0456\u043d\u044c\u0446\u0435 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0456 \u0432\u0430\u0440\u043e\u0436\u0430\u0441\u0446\u044c; \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0439\u0446\u0435 \u0433\u0440\u0443\u0431\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e, \u0430 \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u045e\u0441\u0451 \u0436 \u0441\u044b\u0434\u0443\u0446\u044c \u0437 \u0432\u0430\u0448\u044b\u0445 \u0432\u0443\u0441\u043d\u0430\u045e \u0456 \u043d\u0430\u043d\u044f\u0441\u0443\u0446\u044c \u0440\u0430\u043d\u044b, \u0434\u044b\u043a \u043d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u044b\u044f \u0432\u0443\u0441\u043d\u044b \u0430\u0434\u0440\u0430\u0437\u0443 \u0436 \u0456\u0445 \u0437\u0430\u043b\u0435\u0447\u0430\u0446\u044c. \u041f\u0440\u0430\u0431\u0430\u0447\u0430\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u044f \u043d\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u043d\u0430\u043d\u0435\u0441\u0435\u043d\u044b\u044f \u043a\u0440\u044b\u045e\u0434\u044b. \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u043f\u0430\u043c\u044f\u0446\u044c \u043f\u0440\u0430 \u043a\u0440\u044b\u045e\u0434\u0443 &ndash; \u0433\u044d\u0442\u0430 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0434\u0430\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435 \u0433\u043d\u0435\u0432\u0443, \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u0443, \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0456\u0440\u0436\u0430\u0432\u0430\u044f \u0441\u0442\u0440\u0430\u043b\u0430, \u0430\u0442\u0440\u0443\u0442\u0430 \u0434\u0443\u0448\u044b, \u043c\u0430\u0440\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u0446\u043d\u043e\u0442\u0430\u045e, \u0447\u0430\u0440\u0432\u044f\u043a \u0434\u0443\u0445\u0443, \u0441\u043e\u0440\u0430\u043c \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0456 \u043f\u0430\u0440\u0443\u0448\u044d\u043d\u043d\u0435 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u045e, \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u0445 \u0434\u0430 \u0411\u043e\u0433\u0430; \u0433\u044d\u0442\u0430 \u0430\u0434\u0447\u0443\u0436\u0430\u043d\u0430\u0441\u0446\u044c \u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456, \u0446\u0432\u0456\u043a, \u0437\u0430\u0431\u0456\u0442\u044b \u045e \u0434\u0443\u0448\u0443, \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0441\u043f\u0456\u0446\u044c, \u0433\u0440\u044d\u0445, \u044f\u043a\u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0456 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u044e\u0431\u0456\u0446\u0435 \u0441\u043f\u0430\u043a\u043e\u0439, \u0441\u0430\u043c\u044b \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b \u0441\u043a\u0430\u0440\u0431, \u044f\u043a\u043e\u0433\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0436\u043d\u0430 \u0445\u0430\u0446\u0435\u0446\u044c. \u0412\u0435\u0434\u0430\u0439\u0446\u0435 \u045e\u0436\u043e, \u0448\u0442\u043e \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456 \u0433\u043d\u044f\u0432\u044f\u0446\u044c \u0411\u043e\u0433\u0430, \u0442\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u043a\u0430\u044f\u0446\u0446\u0430, \u043a\u0430\u0431 \u0432\u0430\u043c \u043f\u0440\u0430\u0431\u0430\u0447\u044b\u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0411\u043e\u0433. \u0422\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0437\u0430\u0442\u043e\u0439\u0432\u0430\u0435\u043c \u044f\u043a \u043b\u044e\u0434\u0437\u0456, \u0432\u044f\u0434\u043e\u043c\u0430\u0435 \u0411\u043e\u0433\u0443; \u0442\u0430\u043c\u0443 \u043d\u0430\u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c. \u0416\u044b\u0432\u0456\u0446\u0435 \u0442\u0430\u043a, \u043a\u0430\u0431 \u0437\u0431\u0456\u0440\u0430\u0446\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u041f\u0430\u043d\u0430 \u0456 \u043a\u0430\u0431 \u0441\u043f\u0430\u043a\u043e\u0439 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u045e \u0437 \u0432\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u041a\u0430\u0440 4, 11. 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b, \u0436\u044b\u0432\u044b\u044f, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0456\u0434\u0437\u0451\u043c \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0415\u0437\u0443\u0441\u0430, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0415\u0437\u0443\u0441\u0430 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0448\u044b\u043c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0446\u0435\u043b\u0435. <span style=\"color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span> \u0410\u043b\u043b\u0435\u043b\u044e\u044f<span style=\"color: #ff0000;\">)<\/span>.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u043e\u0446\u044c \u0437\u043d\u0435\u0448\u043d\u0456 \u043d\u0430\u0448 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0456 \u0442\u043b\u0435\u0435, \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0437 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u0430\u0431\u043d\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0456 \u0436\u044b\u0446\u0446\u0451<span style=\"text-align: justify;\">\u0415\u0437\u0443\u0441\u0430 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0448\u044b\u043c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0446\u0435\u043b\u0435.&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span><span style=\"text-align: justify;\">&nbsp;\u0410\u043b\u043b\u0435\u043b\u044e\u044f<\/span><span style=\"text-align: justify; color: #ff0000;\">)<\/span><span style=\"text-align: justify;\">.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"718","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u043d\u0456\u0433\u0430 \u0412\u044b\u0441\u043b\u043e\u045e\u044f\u045e&raquo; \u0441\u0432. \u0406\u0437\u044b\u0434\u043e\u0440\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 3, 8-10: PL 83, 679-682)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u043d\u0456\u0436\u043d\u0456\u043a, \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b \u043f\u0440\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0430\u0447\u044b\u0448\u0447\u0430\u0435\u043c\u0441\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c\u0456, \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u0435\u043c\u0441\u044f \u0447\u044b\u0442\u0430\u043d\u043d\u0435\u043c. \u041a\u0430\u043b\u0456 \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u0434\u043e\u0431\u0440\u0430\u0435 \u0456 \u0442\u043e\u0435, \u0456 \u0434\u0440\u0443\u0433\u043e\u0435. \u041a\u0430\u043b\u0456 \u043d\u0435, \u043b\u0435\u043f\u0435\u0439 \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u0447\u044b\u043c \u0447\u044b\u0442\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0445\u043e\u0447\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0411\u043e\u0433\u0430\u043c, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0447\u0430\u0441\u0442\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430. \u0411\u043e \u043a\u0430\u043b\u0456 \u043c\u043e\u043b\u0456\u043c\u0441\u044f, \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u0435\u043c \u0437 \u0441\u0430\u043c\u0456\u043c \u0411\u043e\u0433\u0430\u043c, \u0430 \u043a\u0430\u043b\u0456 \u0447\u044b\u0442\u0430\u0435\u043c, \u0411\u043e\u0433 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u0435 \u0437 \u043d\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u044f\u043a\u0456 \u043f\u0440\u0430\u0433\u0440\u044d\u0441 \u043f\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u045e \u0447\u044b\u0442\u0430\u043d\u043d\u0456 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0456. \u0422\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u043f\u0430\u0437\u043d\u0430\u0451\u043c \u0437 \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u043d\u0430\u0433\u0430, \u0430 \u0442\u043e\u0435, \u0447\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f, \u0437\u0430\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435\u043c \u0443 \u043f\u0430\u043c\u044f\u0446\u0456 \u043f\u0440\u0430\u0437 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u044b\u0442\u0430\u043d\u043d\u0435 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u0443\u044e \u043a\u0430\u0440\u044b\u0441\u0446\u044c: \u0440\u0430\u0441\u043f\u0440\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u043f\u0430\u0437\u043d\u0430\u045e\u0447\u044b\u044f \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0440\u043e\u0437\u0443\u043c\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434\u0446\u044f\u0433\u0432\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0430\u0434 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0435\u0442\u0443 \u0434\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b \u0447\u044b\u0442\u0430\u043d\u043d\u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0430 \u0434\u0437\u0432\u0435 \u0440\u044d\u0447\u044b: \u043f\u0430-\u043f\u0435\u0440\u0448\u0430\u0435, \u044f\u043a \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0430 \u043f\u0430-\u0434\u0440\u0443\u0433\u043e\u0435, \u044f\u043a \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u0437 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u044e \u0456 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e. \u0422\u0430\u0434\u044b \u043a\u043e\u0436\u043d\u044b \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u043a\u0440\u044b\u0442\u044b \u043d\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0447\u044b\u0442\u0430\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u043e\u043b\u044c\u0448 \u0437\u0434\u0430\u0442\u043d\u044b \u0434\u043b\u044f \u043f\u0435\u0440\u0430\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0442\u0430\u0433\u043e, \u0447\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u0440\u0430\u043d\u043d\u044b \u0447\u044b\u0442\u0430\u0447 \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u0440\u0443\u043f\u0456\u0446\u0446\u0430 \u0430\u0431 \u0442\u044b\u043c, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u045e, \u0430 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u0430 \u043d\u0430\u0431\u044b\u0446\u044c \u0432\u0435\u0434\u044b. \u0411\u043e \u043c\u0435\u043d\u0448\u0430\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u0437\u0430 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0442\u0430\u0433\u043e, \u0434\u0430 \u0447\u0430\u0433\u043e \u0442\u0440\u044d\u0431\u0430 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430, \u0447\u044b\u043c \u0437\u0430 \u043d\u0435\u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u043d\u0430\u0433\u0430. \u042f\u043a \u0447\u044b\u0442\u0430\u044e\u0447\u044b \u043c\u044b \u0445\u043e\u0447\u0430\u043c \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430 \u043f\u0440\u0430 \u043d\u0435\u0448\u0442\u0430, \u0442\u0430\u043a, \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0448\u044b\u0441\u044f \u043f\u0440\u0430 \u0441\u043b\u0443\u0448\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u043d\u0430\u0433\u0430, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0433\u044d\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0441\u044d\u043d\u0441 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f \u0456\u043d\u0430\u043a\u0448, \u044f\u043a \u043f\u0440\u0430\u0437 \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435, \u0442\u0430\u043a \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u041b\u044e\u0431\u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0456 \u044f\u043d\u0430 \u045e\u0437\u0432\u044b\u0441\u0456\u0446\u044c \u0446\u044f\u0431\u0435; \u044f\u043d\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0446\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u0442\u044b \u0441\u043f\u0430\u0441\u0456\u0446\u0433\u043d\u0435\u0448 \u044f\u0435&raquo; (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 4, 8).<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0447\u044b\u0442\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u041f\u0456\u0441\u0430\u043d\u043d\u044f, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043f\u043b\u0451\u043d\u043d\u044b\u043c \u0431\u0443\u0434\u0437\u0435 \u044f\u0433\u043e \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435; \u044f\u043a \u0456 \u0437\u044f\u043c\u043b\u044f: \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u044f\u0435 \u0430\u043f\u0440\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0446\u044c, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u043b\u0451\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u043c\u0430\u044e\u0446\u044c \u043f\u0440\u044b\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0442\u0430\u043b\u0435\u043d\u0442 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f, \u0430\u043b\u0435 \u043d\u044f\u0434\u0431\u0430\u0439\u043d\u0430 \u0441\u0442\u0430\u0432\u044f\u0446\u0446\u0430 \u0434\u0430 \u0441\u0430\u043c\u043e\u0433\u0430 \u0447\u044b\u0442\u0430\u043d\u043d\u044f, \u0442\u0430\u043c\u0443 \u044f\u043d\u044b \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u044e\u0446\u044c \u0442\u044b\u043c, \u0448\u0442\u043e \u043c\u0430\u0433\u043b\u0456 \u0431 \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430 \u0437 \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u043d\u0430\u0433\u0430. \u0406\u043d\u0448\u044b\u044f \u043c\u0430\u044e\u0446\u044c \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0435 \u0434\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f, \u0430\u043b\u0435 \u0456\u0445 \u0437\u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u043e\u043b\u0435\u043d\u0430\u0441\u0446\u044c \u0440\u043e\u0437\u0443\u043c\u0443; \u0430\u0434\u043d\u0430\u043a \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u043c\u0443 \u0447\u044b\u0442\u0430\u043d\u043d\u044e \u044f\u043d\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u044f \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u043b\u044f\u043d\u043e\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0442\u043e\u0439, \u0445\u0442\u043e \u0440\u0430\u0437\u0443\u043c\u0435\u0435 \u043f\u0430\u0432\u043e\u043b\u044c\u043d\u0430, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u045e \u0437\u0430\u043b\u0435\u0436\u043d\u0430\u0441\u0446\u0456 \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456 \u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b\u0445 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e, \u0442\u0430\u043a \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u045e \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u044f \u0430\u0434 \u0411\u043e\u0433\u0430 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435 \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u0435, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435 \u0434\u0430\u0440\u0430\u043c, \u044f\u043a\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u045e, \u0456 \u0433\u0440\u0430\u0448\u044b\u0446\u044c \u043b\u044f\u043d\u043e\u0442\u0430\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0443\u0447\u044d\u043d\u043d\u0435 \u0431\u0435\u0437 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0456 \u043b\u0430\u0441\u043a\u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0434\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0441\u044d\u0440\u0446\u0430, \u0445\u043e\u0446\u044c \u0456 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e \u0432\u0443\u0448\u044b. \u0425\u043e\u0446\u044c \u044f\u043d\u043e \u0447\u0443\u0435\u0446\u0446\u0430 \u0437\u0432\u043e\u043d\u043a\u0443, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u0439 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456. \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u043f\u0430\u0447\u0443\u0442\u0430\u0435 \u0432\u0443\u0448\u0430\u043c\u0456, \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u043b\u0456 \u0411\u043e\u0436\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0434\u0430\u0435 \u0440\u043e\u0437\u0443\u043c\u0443 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u044b \u0448\u0442\u0443\u0440\u0448\u043e\u043a \u0434\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 13, 52; \u043f\u0430\u0440. \u041f\u0440\u044b\u043f 14, 33<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u044f\u043b\u044f\u043a\u0456 \u043a\u043d\u0456\u0436\u043d\u0456\u043a, \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b \u043f\u0440\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435, <span style=\"color: #ff0000;\">*<\/span> \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430, \u044f\u043a\u0456 \u0432\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0430 \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u044b \u0441\u0432\u0430\u0451\u0439 \u043d\u043e\u0432\u0430\u0435 \u0456 \u0441\u0442\u0430\u0440\u043e\u0435. <span style=\"color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span> \u0410\u043b\u043b\u0435\u043b\u044e\u044f<span style=\"color: #ff0000;\">)<\/span>.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u0441\u044d\u0440\u0446\u044b \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430<span style=\"text-align: justify;\">, \u044f\u043a\u0456 \u0432\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0430 \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u044b \u0441\u0432\u0430\u0451\u0439 \u043d\u043e\u0432\u0430\u0435 \u0456 \u0441\u0442\u0430\u0440\u043e\u0435.&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span><span style=\"text-align: justify;\">&nbsp;\u0410\u043b\u043b\u0435\u043b\u044e\u044f<\/span><span style=\"text-align: justify; color: #ff0000;\">)<\/span><span style=\"text-align: justify;\">.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"719","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451&raquo; \u0441\u0432. \u0412\u0456\u043d\u0446\u044d\u043d\u0442\u0430 \u0424\u044d\u0440\u044d\u0440\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 13: ed. Garganta-Forcada, pp. 513-514)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u043f\u043e\u0441\u0430\u0431 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043f\u0440\u043e\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u0445 \u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u044f\u0445 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0439 \u043f\u0440\u043e\u0441\u0442\u0443\u044e \u043c\u043e\u0432\u0443 \u0456 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0443\u044e \u0433\u0443\u0442\u0430\u0440\u043a\u0443. \u041a\u0430\u043b\u0456 \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u044c \u0442\u0430\u043a\u0456\u044f \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u044b, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0433\u0440\u044d\u0448\u043d\u0456\u043a, \u044f\u043a\u0456 \u043c\u0430\u0435 \u043f\u044d\u045e\u043d\u044b \u0433\u0440\u044d\u0445, \u0431\u044b\u045e \u0443\u0437\u0440\u0443\u0448\u0430\u043d\u044b \u043a\u0430\u0437\u0430\u043d\u043d\u0435\u043c \u0456 \u044f\u043c\u0443 \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u0442\u044b \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0448\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430 \u044f\u0433\u043e. \u0410\u0434\u043d\u0430\u043a \u0440\u0430\u0431\u0456 \u0433\u044d\u0442\u0430 \u0442\u0430\u043a, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e \u0431\u0430\u0447\u043d\u0430, \u0448\u0442\u043e \u0442\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u0432\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043d\u0435 \u0437 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u0430\u0439 \u0446\u0456 \u0430\u0431\u0443\u0440\u0430\u043d\u0430\u0439 \u0434\u0443\u0448\u044b, \u0430\u043b\u0435 \u0437 \u0437\u044b\u0447\u043b\u0456\u0432\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430\u0433\u0430 \u0430\u0439\u0446\u043e\u045e\u0441\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e. \u042f\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0446\u044c \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u0435 \u0431\u0430\u0446\u044c\u043a\u043e\u045e, \u044f\u043a\u0456\u044f \u0448\u043a\u0430\u0434\u0443\u044e\u0446\u044c \u0433\u0440\u044d\u0448\u043d\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439, \u0448\u0442\u043e \u043b\u044f\u0436\u0430\u0446\u044c \u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u044f\u043c\u0435, \u0456 \u0441\u0442\u0430\u0440\u0430\u044e\u0446\u0446\u0430 \u0432\u044b\u0446\u044f\u0433\u043d\u0443\u0446\u044c \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u0456\u0445 \u0430\u0434\u0442\u0443\u043b\u044c. \u042f\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0437\u0430 \u0456\u0445 \u043f\u043e\u0441\u043f\u0435\u0445 \u0456 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043d\u043d\u0435 \u043d\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0443\u044e \u0441\u043b\u0430\u0432\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456 \u0441\u043f\u043e\u0441\u0430\u0431 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u0431\u044b\u045e \u043f\u043b\u0451\u043d\u043d\u044b\u043c \u0434\u043b\u044f \u0441\u043b\u0443\u0445\u0430\u0447\u043e\u045e. \u0410 \u0432\u043e\u0441\u044c \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0446\u043d\u043e\u0442\u044b \u0456 \u0437\u0430\u0433\u0430\u043d\u044b, \u044f\u043a \u043f\u0440\u0430\u0432\u0456\u043b\u0430, \u043c\u0430\u043b\u0430 \u043a\u0440\u0430\u043d\u0430\u0435 \u0441\u043b\u0443\u0445\u0430\u0447\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u043f\u0440\u044b \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0439 \u0448\u0447\u044b\u0440\u0443\u044e \u0437\u044b\u0447\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430 \u0442\u043e\u0435, \u0446\u0456 \u0442\u044b \u043b\u0430\u0433\u043e\u0434\u043d\u0430 \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u0435\u0448 \u043c\u0430\u043b\u0430\u0434\u0443\u0448\u043d\u044b\u0445, \u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u0436\u043e\u0440\u0441\u0442\u043a\u0430 \u0434\u0430\u043a\u0430\u0440\u0430\u0435\u0448 \u0437\u0430\u043a\u0430\u0440\u0430\u043d\u0435\u043b\u044b\u0445 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e. \u0413\u0440\u044d\u0448\u043d\u0456\u043a \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0430\u0434\u0447\u0443\u0432\u0430\u0446\u044c, \u0448\u0442\u043e \u0442\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u0432\u044b\u043d\u0456\u043a\u0430\u044e\u0446\u044c \u0437 \u0447\u044b\u0441\u0442\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u0422\u0430\u043c\u0443 \u0441\u043b\u043e\u0432\u044b, \u0430\u0444\u0430\u0440\u0431\u0430\u0432\u0430\u043d\u044b\u044f \u043b\u044e\u0431\u043e\u045e\u044e \u0456 \u0441\u043b\u043e\u0434\u044b\u0447\u0447\u0443, \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u045e\u0436\u0434\u044b \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u0434\u0430\u043a\u043e\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0441\u0430\u043c \u0442\u044b, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0434\u0443\u0448\u0430\u043c \u0431\u043b\u0456\u0437\u043a\u0456\u0445, \u0441\u043f\u044f\u0440\u0448\u0430 \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0437\u0432\u044f\u0440\u043d\u0456\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u0430 \u043f\u0440\u0430\u0441\u0456 \u045e \u042f\u0433\u043e, \u043a\u0430\u0431 \u0434\u0430\u045e \u0442\u0430\u0431\u0435 \u0442\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u0443 \u044f\u043a\u043e\u0439 \u0437\u043c\u044f\u0448\u0447\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0446\u043d\u043e\u0442\u0430\u045e \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u0442\u044b \u0437\u0434\u043e\u043b\u0435\u0435\u0448 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0445\u043e\u0447\u0430\u0448.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u0426\u0456\u043c 4, 2; \u043f\u0430\u0440. \u0414\u0437 26, 20b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0439 \u0433\u044d\u0442\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0439. <span style=\"color: #ff0000;\">*<\/span> \u0423 \u0447\u0430\u0441 \u0456 \u043d\u0435 \u045e \u0447\u0430\u0441, \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0439, \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0439, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0439 \u0437 \u0443\u0441\u0451\u0439 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0456 \u043f\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435\u043c. <span style=\"color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span> \u0410\u043b\u043b\u0435\u043b\u044e\u044f<span style=\"color: #ff0000;\">)<\/span>.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0434\u0430 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f \u0456 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f \u0434\u0430 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0447\u0430\u0441<span style=\"text-align: justify;\">&nbsp;\u043d\u0435 \u045e \u0447\u0430\u0441, \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0439, \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0439, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0439 \u0437 \u0443\u0441\u0451\u0439 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0456 \u043f\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435\u043c.&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span><span style=\"text-align: justify;\">&nbsp;\u0410\u043b\u043b\u0435\u043b\u044e\u044f<\/span><span style=\"text-align: justify; color: #ff0000;\">)<\/span><span style=\"text-align: justify;\">.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"720","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0420\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0456 \u0441\u0432. \u0416\u0430\u043d\u0430 \u0411\u0430\u0442\u044b\u0441\u0442\u0430 \u0421\u0430\u043b\u044c\u0441\u043a\u0430\u0433\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Meditatio 201)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u044f\u0445\u0430\u0439 \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u043f\u0440\u044b\u0441\u043f\u0435\u0448\u0432\u0430\u0435 \u0432\u0430\u0441<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043d\u0430\u0434 \u0442\u044b\u043c, \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u0448\u0442\u043e \u0411\u043e\u0433 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u045e, \u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u0435\u0446\u0435\u0441\u044f, \u0448\u0442\u043e \u0456 \u0432\u0430\u043c \u041f\u0430\u043d \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435. \u0421\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0432\u0430\u043c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0442\u043e\u0439 \u0436\u0430 \u0441\u0432\u044f\u0442\u044b, \u043a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0440\u043e\u0437\u043d\u044b\u044f \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 \u0456 \u0440\u043e\u0437\u043d\u044b\u044f \u0434\u0437\u0435\u044f\u043d\u043d\u0456, \u0430\u043b\u0435 \u0430\u0434\u0437\u0456\u043d \u0456 \u0442\u043e\u0439 \u0436\u0430 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0433\u044d\u0442\u044b\u0445 \u043f\u0430\u0430\u0441\u043e\u0431\u043d\u044b\u0445 \u0434\u0430\u0440\u0430\u0445 \u0434\u0437\u0435\u043b\u044f \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0431\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0432\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430, \u0448\u0442\u043e \u043b\u0430\u0441\u043a\u0430, \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u044f \u0432\u0430\u043c, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043b\u0430\u0441\u043a\u0430 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u044f \u0434\u0437\u044f\u0446\u0435\u0439, \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0456\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0456 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0456\u0445 \u0443 \u0434\u0443\u0445\u0443 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, &ndash; \u0433\u044d\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0456 \u0434\u0430\u0440 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0434\u0437\u0435\u0446\u0456, \u0430\u0434\u0434\u0430\u0434\u0437\u0435\u043d\u044b\u044f \u045e \u0432\u0430\u0448\u0443 \u0430\u043f\u0435\u043a\u0443, \u0431\u0430\u0447\u0430\u0446\u044c \u0432\u0430 \u045e\u0441\u0456\u043c \u0432\u0430\u0448\u044b\u043c \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0435, \u0448\u0442\u043e \u0432\u044b \u0441\u043b\u0443\u0433\u0456 \u0411\u043e\u0436\u044b\u044f, \u044f\u043a\u0456\u044f \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u0446\u0435 \u0441\u0432\u043e\u0439 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0441\u0430 \u0448\u0447\u044b\u0440\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0441\u0446\u044e. \u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0437 \u0432\u0430\u0448\u044b\u043c \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u043c \u0432\u0430\u0441 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0446\u044f\u0441\u043d\u0435\u0439 \u0437\u043b\u0443\u0447\u0430\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0441\u043b\u0443\u0433\u0456 \u0411\u043e\u0436\u044b\u044f, \u0430\u043b\u0435 \u0456 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, \u044f\u043a\u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u043b\u0456\u0447\u044b\u0446\u044c \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0411\u043e\u0436\u044b\u043c\u0456 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0456 \u0445\u0442\u043e \u043f\u0456\u0448\u0430 \u043b\u0456\u0441\u0442 \u043f\u0430\u0434 \u0434\u044b\u043a\u0442\u043e\u045e\u043a\u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0430\u0442\u0440\u0430\u043c\u0430\u043d\u0442\u0430\u043c, \u0430 \u0414\u0443\u0445\u0430\u043c \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, \u043d\u0435 \u043d\u0430 \u043a\u0430\u043c\u0435\u043d\u043d\u044b\u0445 \u0442\u0430\u0431\u043b\u0456\u0446\u0430\u0445, \u0430 \u043d\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u0445 \u0442\u0430\u0431\u043b\u0456\u0446\u0430\u0445 \u0441\u044d\u0440\u0446\u0430, \u044f\u043a\u0456\u043c\u0456 \u0451\u0441\u0446\u044c \u0434\u0437\u0456\u0446\u044f\u0447\u044b\u044f \u0441\u044d\u0440\u0446\u044b. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u043f\u0440\u044b\u0441\u043f\u0435\u0448\u0432\u0430\u0435 \u0432\u0430\u0441, \u0431\u043e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0456\u0445, \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u0432\u0435, \u0436\u044b\u043b\u0456 \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0441\u044f\u0431\u0435, \u0430 \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437\u0430 \u0456\u0445 \u043f\u0430\u043c\u0451\u0440 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441. \u0422\u0430\u043c\u0443 \u0432\u0443\u0447\u043d\u0456, \u0443\u0437\u0440\u0443\u0448\u0430\u043d\u044b\u044f \u0432\u0430\u0448\u0430\u0439 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0441\u0446\u044e \u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0447\u0443\u0446\u044c, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0432\u0430\u0441 \u043d\u0456\u0431\u044b\u0442\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u0456\u0445 \u0411\u043e\u0433, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0432\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u0446\u0435 \u0441\u0432\u0430\u0451 \u0437\u0430\u0434\u0430\u043d\u043d\u0435 \u045e \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u043a\u0430\u0437\u0430\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0443, \u044f\u043a\u043e\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430 \u044f\u0433\u043e \u043f\u0430\u043b\u0430\u0435\u0446\u0435, \u0456 \u0434\u0430\u043b\u0456 \u0434\u043e\u043a\u0430\u0437 \u0432\u0430\u0448\u0430\u0439 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0441\u0446\u0456. \u0411\u043e \u0432\u044b \u043f\u0440\u0430\u0446\u0443\u0435\u0446\u0435 \u0434\u0437\u0435\u043b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0446\u0435\u043b\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c. \u0422\u0430\u043c\u0443 \u043f\u0430\u043a\u0430\u0436\u044b\u0446\u0435 \u0441\u0432\u0430\u0451\u0439 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0448\u0442\u043e, \u044f\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u041a\u0430\u0441\u0446\u0451\u043b, \u0442\u0430\u043a \u0456 \u0432\u044b \u043b\u044e\u0431\u0456\u0446\u0435 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0411\u043e\u0433 \u0432\u0430\u043c \u0434\u0430\u0440\u0443\u0447\u044b\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f, \u043a\u0430\u0431 \u0434\u0437\u0435\u0446\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u045e\u0432\u0430\u0439\u0448\u043b\u0456 \u045e \u0431\u0443\u0434\u043e\u0432\u0443 \u0433\u044d\u0442\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u0456\u043c\u043a\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0437 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e \u0456 \u045e \u0441\u043b\u0430\u0432\u0435 \u0441\u0442\u0430\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0441\u0443\u0434\u043e\u043c \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0435 \u043c\u0430\u044e\u0447\u044b \u0437\u0430\u0433\u0430\u043d\u044b \u0446\u0456 \u0445\u0456\u0431\u0430\u045e, \u0446\u0456 \u043d\u0435\u0447\u0430\u0433\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430; \u043a\u0430\u0431 \u0443 \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0447\u0430\u0441\u044b \u044f\u043d\u044b \u0430\u043a\u0430\u0437\u0430\u043b\u0456\u0441\u044f \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u043c\u0456 \u0411\u043e\u0436\u0430\u044e \u043b\u0430\u0441\u043a\u0430\u044e, \u044f\u043a\u043e\u044e \u0411\u043e\u0433 \u0430\u0434\u0430\u0440\u044b\u045e \u0456\u0445, \u0434\u0430\u044e\u0447\u044b \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0443 \u045e \u0432\u0443\u0447\u044d\u043d\u043d\u0456, \u0430 \u0432\u0430\u043c &ndash; \u0443 \u0456\u0445 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0456 \u0456 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u0456, \u043a\u0430\u0431 \u0432\u044b \u043c\u0435\u043b\u0456 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u045e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u0411\u043e\u0433\u0430 \u0456 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041c\u043a 10, 13-14. 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u0434\u0430 \u0415\u0437\u0443\u0441\u0430 \u0434\u0437\u044f\u0446\u0435\u0439, \u043a\u0430\u0431 \u0401\u043d \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0456\u0445. \u0412\u0443\u0447\u043d\u0456 \u0436 \u0434\u0430\u043a\u0430\u0440\u0430\u043b\u0456 \u0456\u0445. \u0410 \u0415\u0437\u0443\u0441, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u0433\u044d\u0442\u0430, \u0430\u0431\u0443\u0440\u044b\u045e\u0441\u044f \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: <span style=\"color: #ff0000;\">*<\/span> \u0414\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u0434\u0437\u0435\u0446\u044f\u043c \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u041c\u044f\u043d\u0435, \u043d\u0435 \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0439\u0446\u0435 \u0456\u043c, \u0431\u043e \u0442\u0430\u043a\u0456\u043c \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435. <span style=\"color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span> \u0410\u043b\u043b\u0435\u043b\u044e\u044f<span style=\"color: #ff0000;\">)<\/span>.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406, \u0430\u0431\u0434\u044b\u043c\u0430\u044e\u0447\u044b \u0456\u0445, \u0443\u0441\u043a\u043b\u0430\u0434\u0430\u045e \u043d\u0430 \u0456\u0445 \u0440\u0443\u043a\u0456 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435<span style=\"text-align: justify;\">\u0434\u0437\u0435\u0446\u044f\u043c \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u041c\u044f\u043d\u0435, \u043d\u0435 \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0439\u0446\u0435 \u0456\u043c, \u0431\u043e \u0442\u0430\u043a\u0456\u043c \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0435.&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span><span style=\"text-align: justify;\">&nbsp;\u0410\u043b\u043b\u0435\u043b\u044e\u044f<\/span><span style=\"text-align: justify; color: #ff0000;\">)<\/span><span style=\"text-align: justify;\">.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"721","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 58, 8-9. 11: CSEL 3, 663-666)<\/span><br \/><span style=\"color: #ff0000;\">\u0417\u043c\u0430\u0433\u0430\u044e\u0447\u044b\u0441\u044f \u045e \u0431\u0456\u0442\u0432\u0435 \u0432\u0435\u0440\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u0443\u043b\u044c \u043c\u044b \u0431&rsquo;\u0435\u043c\u0441\u044f \u0456 \u0437\u043c\u0430\u0433\u0430\u0435\u043c\u0441\u044f \u045e \u0431\u0456\u0442\u0432\u0435 \u0432\u0435\u0440\u044b, \u0411\u043e\u0433 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u043d\u0430\u0441, \u0433\u043b\u044f\u0434\u0437\u044f\u0446\u044c \u042f\u0433\u043e\u043d\u044b\u044f \u0430\u043d\u0451\u043b\u044b, \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u042f\u043a\u0456 \u0441\u043b\u0430\u045e\u043d\u044b \u0433\u043e\u043d\u0430\u0440, \u044f\u043a\u043e\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u0437\u0431\u0456\u0440\u0430\u0446\u0446\u0430 \u043f\u0430\u0434 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0411\u043e\u0433\u0430 \u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0432\u044f\u043d\u043e\u043a \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430-\u0421\u0443\u0434\u0434\u0437\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0437\u0431\u0440\u043e\u0456\u043c\u0441\u044f, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0443\u0441\u0456\u043c\u0456 \u0441\u0456\u043b\u0430\u043c\u0456 \u0456 \u0437 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c, \u0437 \u043f\u043e\u045e\u043d\u0430\u0439 \u0432\u0435\u0440\u0430\u0439 \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0439 \u0446\u043d\u043e\u0442\u0430\u0439 \u0432\u044b\u0439\u0434\u0437\u0435\u043c \u043d\u0430 \u0431\u043e\u0439. \u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435 \u0411\u043e\u0436\u044b\u044f \u0432\u043e\u0439\u0441\u043a\u0456 \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0443 \u0441\u0442\u0440\u043e\u0439 \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432. \u041f\u0430\u0432\u0435\u043b \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430\u043c \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u0446\u0430 \u0456 \u0431\u044b\u0446\u044c \u043d\u0430\u043f\u0430\u0433\u0430\u0442\u043e\u0432\u0435: &laquo;\u0422\u0430\u043c\u0443 \u0441\u0442\u0430\u043d\u044c\u0446\u0435, \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0437\u0430\u045e\u0448\u044b \u0441\u0446\u0451\u0433\u043d\u044b \u0441\u0432\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0430\u044e, \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u045e \u043f\u0430\u043d\u0446\u044b\u0440 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0456 \u0430\u0431\u0443\u045e\u0448\u044b \u043d\u043e\u0433\u0456 \u045e \u0433\u0430\u0442\u043e\u0432\u0430\u0441\u0446\u044c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0441\u043f\u0430\u043a\u043e\u0439. \u0410 \u0440\u0430\u0437\u0430\u043c \u0437 \u0443\u0441\u0456\u043c \u0432\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u0448\u0447\u044b\u0442 \u0432\u0435\u0440\u044b, \u044f\u043a\u0456\u043c \u0437\u043c\u043e\u0436\u0430\u0446\u0435 \u043f\u0430\u0433\u0430\u0441\u0456\u0446\u044c \u0443\u0441\u0435 \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u044b\u044f \u0441\u0442\u0440\u044d\u043b\u044b \u0437\u043b\u043e\u0433\u0430. \u0406 \u0448\u043b\u0435\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0432\u0430\u0437\u044c\u043c\u0456\u0446\u0435, \u0456 \u043c\u0435\u0447 \u0434\u0443\u0445\u043e\u045e\u043d\u044b, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435&raquo; (\u042d\u0444 6, 14-17).<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0437\u044c\u043c\u0435\u043c \u0433\u044d\u0442\u0443\u044e \u0437\u0431\u0440\u043e\u044e, \u0430\u043f\u0440\u0430\u043d\u0435\u043c\u0441\u044f \u045e \u0433\u044d\u0442\u044b\u044f \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0434\u0430\u0441\u043f\u0435\u0445\u0456, \u043a\u0430\u0431 \u0443 \u043d\u0430\u0439\u0433\u043e\u0440\u0448\u044b \u0434\u0437\u0435\u043d\u044c \u043c\u044b \u0437\u043c\u0430\u0433\u043b\u0456 \u0430\u0434\u0431\u0456\u0446\u044c \u043f\u0430\u0433\u0440\u043e\u0437\u044b \u0434&rsquo;\u044f\u0431\u043b\u0430 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u044f\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u0440\u0430\u043d\u0435\u043c\u0441\u044f \u045e \u043a\u0456\u0440\u0430\u0441\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0443\u0434\u0437\u0456 \u0431\u044b\u043b\u0456 \u043d\u0430\u0434\u0437\u0435\u0439\u043d\u0430 \u0430\u0431\u0430\u0440\u043e\u043d\u0435\u043d\u044b \u0430\u0434 \u0432\u0430\u0440\u043e\u0436\u044b\u0445 \u0443\u0434\u0430\u0440\u0430\u045e. \u0410\u0431\u0443\u0435\u043c\u0441\u044f \u045e \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0456 \u0437\u0430\u0441\u0446\u0435\u0440\u0430\u0436\u044d\u043c \u043d\u043e\u0433\u0456, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0441\u043c\u0435\u043b\u0430 \u0440\u0430\u0441\u0442\u0440\u0443\u0448\u0447\u044b\u0446\u044c \u0456 \u0440\u0430\u0441\u0442\u0430\u043f\u0442\u0430\u0446\u044c \u0437\u043c\u0435\u044f, \u043d\u0435 \u0431\u0430\u044e\u0447\u044b\u0441\u044f \u044f\u0433\u043e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u0445 \u0443\u043a\u0443\u0441\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043e\u0446\u043d\u0430 \u0441\u0445\u043e\u043f\u0456\u043c\u0441\u044f \u0437\u0430 \u0448\u0447\u044b\u0442 \u0432\u0435\u0440\u044b, \u0430\u0431\u0430\u0440\u043e\u043d\u0430 \u044f\u043a\u043e\u0433\u0430 \u0437\u043c\u043e\u0436\u0430 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0440\u0430\u0441\u043f\u0430\u043b\u0435\u043d\u044b\u044f \u0441\u0442\u0440\u044d\u043b\u044b \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043c \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0448\u043b\u0435\u043c. \u0401\u043d \u043f\u0440\u044b\u043a\u0440\u044b\u0435 \u0432\u0443\u0448\u044b, \u043a\u0430\u0431 \u043d\u0435 \u0447\u0443\u0446\u044c \u0437\u0433\u0443\u0431\u043d\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e; \u043f\u0440\u044b\u043a\u0440\u044b\u0435 \u0432\u043e\u0447\u044b, \u043a\u0430\u0431 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456 \u044f\u043d\u044b \u0430\u0433\u0456\u0434\u043d\u044b\u0445 \u0456\u0434\u0430\u043b\u0430\u045e; \u043f\u0440\u044b\u043a\u0440\u044b\u0435 \u0447\u0430\u043b\u043e, \u043a\u0430\u0431 \u0437\u043d\u0430\u043a \u0411\u043e\u0436\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0435\u043a\u0440\u0430\u043d\u0443\u0442\u044b\u043c; \u043f\u0440\u044b\u043a\u0440\u044b\u0435 \u0440\u043e\u0442, \u043a\u0430\u0431 \u044f\u0437\u044b\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u043d\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0437\u0431\u0440\u043ei\u043c \u043f\u0440\u0430\u0432\u0456\u0446\u0443 \u045e \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u043c\u0435\u0447, \u043a\u0430\u0431 \u044f\u043d\u0430 \u0440\u0430\u0448\u0443\u0447\u0430 \u0430\u0434\u043ai\u043d\u0443\u043b\u0430 \u043d\u044f\u0447\u044b\u0441\u0442\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b \u0456, \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044e, \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u0426\u0435\u043b\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u044f\u0433\u043e, \u0447\u0430\u043a\u0430\u044e\u0447\u044b \u0431\u0443\u0434\u0443\u0447\u0430\u0439 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b &ndash; \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0432\u044f\u043d\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u043d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u0430 \u0437\u0430\u043f\u0430\u0434\u0437\u0435 \u045e \u0432\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b. \u041a\u0430\u043b\u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0442\u0430\u043a \u0434\u0443\u043c\u0430\u0446\u044c \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c, \u0456 \u0440\u0430\u043f\u0442\u0430\u043c \u0434\u0430 \u043d\u0430\u0441 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0437\u0435\u043d\u044c \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443, \u0434\u044b\u043a \u0436\u0430\u045e\u043d\u0435\u0440 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443\u0437\u0431\u0440\u043e\u0435\u043d\u044b \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u043d\u0430\u043a\u0430\u0437\u0430\u043c\u0456 \u0456 \u043f\u0430\u0432\u0443\u0447\u044d\u043d\u043d\u044f\u043c\u0456, \u0431\u044f\u0441\u0441\u0442\u0440\u0430\u0448\u043d\u0430 \u043a\u0456\u043d\u0435\u0446\u0446\u0430 \u045e \u0431\u0456\u0442\u0432\u0443 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0433\u0430\u0442\u043e\u0432\u044b \u0434\u0430 \u0442\u0440\u044b\u0443\u043c\u0444\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0441\u0432\u044f\u0442\u044b, \u044f\u043a\u0456 \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u045e \u0430\u0431\u0430\u0440\u043e\u043d\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0437\u0430\u043a\u043e\u043d\u0443 \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u043d\u0435 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f \u043f\u0430\u0433\u0440\u043e\u0437 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430\u045e. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u0451\u043d \u0441\u0442\u0430\u044f\u045e \u043d\u0430 \u0446\u0432\u0451\u0440\u0434\u0430\u0439 \u0441\u043a\u0430\u043b\u0435. <span style=\"color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span> \u0410\u043b\u043b\u0435\u043b\u044e\u044f<span style=\"color: #ff0000;\">)<\/span>.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0441\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u0436\u044b\u0446\u0446\u0451\u043c \u0443 \u0441\u0432\u0435\u0446\u0435 \u0456 \u0434\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.&nbsp;<\/span> <span style=\"text-align: justify;\">\u0411\u043e \u0451\u043d \u0441\u0442\u0430\u044f\u045e \u043d\u0430 \u0446\u0432\u0451\u0440\u0434\u0430\u0439 \u0441\u043a\u0430\u043b\u0435.&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span><span style=\"text-align: justify;\">&nbsp;\u0410\u043b\u043b\u0435\u043b\u044e\u044f<\/span><span style=\"text-align: justify; color: #ff0000;\">)<\/span><span style=\"text-align: justify;\">.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"722","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041c\u0430\u0440\u0446\u0456\u043d\u0430 \u0406, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 17: PL 87, 203-204)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u043d \u0431\u043b\u0456\u0437\u043a\u0430, \u0447\u0430\u0433\u043e \u043c\u043d\u0435 \u0445\u0432\u0430\u043b\u044f\u0432\u0430\u0446\u0446\u0430?<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u045e\u0441\u0451\u0434\u044b \u0432\u0435\u043b\u044c\u043c\u0456 \u043f\u0440\u0430\u0433\u043d\u0443 \u0441\u0443\u0446\u0435\u0448\u044b\u0446\u044c \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u0443 \u0441\u0432\u0430\u0456\u0445 \u043b\u0456\u0441\u0442\u0430\u0445 \u0456 \u0441\u0443\u043d\u044f\u0446\u044c \u0432\u0430\u0448 \u043a\u043b\u043e\u043f\u0430\u0442 \u043f\u0440\u0430 \u043c\u044f\u043d\u0435, \u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0430\u043c\u0456 \u0456 \u045e\u0441\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u0431\u0440\u0430\u0442\u043e\u045e \u043d\u0430\u0448\u044b\u0445, \u044f\u043a\u0456\u044f \u0430\u043f\u044f\u043a\u0443\u044e\u0446\u0446\u0430 \u043c\u043d\u043e\u044e \u0434\u0437\u0435\u043b\u044f \u041f\u0430\u043d\u0430. \u0412\u043e\u0441\u044c \u043f\u0456\u0448\u0443 \u0432\u0430\u043c \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435\u043f\u0430\u043a\u043e\u0456\u0446\u044c \u043c\u044f\u043d\u0435. \u041a\u0430\u0436\u0443 \u043f\u0440\u0430\u045e\u0434\u0443 \u045e \u0456\u043c\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0434\u0430\u043b\u0435\u043d\u044b \u0430\u0434 \u045e\u0441\u044f\u043a\u0430\u0433\u0430 \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043d\u043d\u044f \u0456 \u0432\u044b\u0433\u043d\u0430\u043d\u044b \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043c\u0430\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e, \u044f \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u043e\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u0440\u044d\u0433\u0456\u0451\u043d\u0435 \u0436\u044b\u0432\u0443\u0446\u044c \u0430\u0434\u043d\u044b \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456, \u0456\u0445\u043d\u0456\u044f \u0437\u0432\u044b\u0447\u0430\u0456 \u043f\u0435\u0440\u0430\u043d\u044f\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0442\u044b\u044f, \u0445\u0442\u043e, \u044f\u043a \u0432\u044f\u0434\u043e\u043c\u0430, \u0442\u0443\u0442 \u0436\u044b\u0432\u0435. \u042f\u043d\u044b \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u043d\u0456\u044f\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u0443\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430 \u0447\u0430\u0441\u0442\u0430 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435 \u043f\u0440\u0430\u0437 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u0435 \u043d\u0430\u0432\u0430\u0442 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0440\u0432\u0430\u0440\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u045e\u0441\u044f \u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u044e\u0441\u044f \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u0430\u0441\u0446\u0456 \u0456 \u043d\u044f\u0447\u0443\u043b\u0430\u0441\u0446\u0456 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0431\u044b\u045e \u0437\u0432\u044f\u0437\u0430\u043d\u044b \u0441\u0430 \u043c\u043d\u043e\u044e, \u043c\u0430\u0456\u0445 \u0441\u044f\u0431\u0440\u043e\u045e \u0456 \u0431\u043b\u0456\u0437\u043a\u0456\u0445. \u042f\u043d\u044b \u0437\u0443\u0441\u0456\u043c \u0437\u0430\u0431\u044b\u043b\u0456\u0441\u044f \u043f\u0440\u0430 \u043c\u0430\u0451 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u0456 \u043d\u0435 \u0445\u043e\u0447\u0443\u0446\u044c \u0432\u0435\u0434\u0430\u0446\u044c, \u0434\u0437\u0435 \u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0443\u0441\u044f, \u0446\u0456 \u044f \u043d\u0430\u043e\u0433\u0443\u043b \u0451\u0441\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0446\u0456 \u043c\u044f\u043d\u0435 \u043d\u044f\u043c\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0456\u0431\u0430 \u0436 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u045e\u0446\u044b \u0456 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0430\u043d\u044b\u044f \u043d\u0435 \u0437\u0440\u043e\u0431\u043b\u0435\u043d\u044b \u0437 \u0430\u0434\u043d\u043e\u0439 \u0433\u043b\u0456\u043d\u044b? \u0425\u0456\u0431\u0430 \u043c\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u0441\u0442\u0430\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u044b\u0431\u0443\u043d\u0430\u043b\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430? \u0406 \u0437 \u044f\u043a\u0456\u043c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435\u043c \u044f \u0441\u0442\u0430\u043d\u0443 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c? \u041c\u043e\u0436\u0430 \u0431\u043e\u044f\u0437\u044c \u0446\u0456 \u0441\u0442\u0440\u0430\u0445 \u0430\u0445\u0430\u043f\u0456\u045e \u0433\u044d\u0442\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0448\u0442\u043e \u044f\u043d\u044b \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u043b\u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0411\u043e\u0436\u044b\u044f \u043d\u0430\u043a\u0430\u0437\u044b? \u0410\u043b\u0435 \u0448\u0442\u043e \u043c\u043e\u0436\u0430 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u0446\u044c \u0442\u0430\u043a\u0456 \u0441\u0442\u0440\u0430\u0445? \u041c\u043e\u0436\u0430, \u0437-\u0437\u0430 \u043c\u0430\u0439\u0433\u043e \u0430\u0434\u043b\u0443\u0447\u044d\u043d\u043d\u044f \u043c\u044f\u043d\u0435 \u0442\u0430\u043a \u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u0437\u043b\u044b\u044f \u0434\u0443\u0445\u0456? \u0410 \u043c\u043e\u0436\u0430, \u044f \u0441\u0442\u0430\u045e \u0442\u0430\u043a\u0456\u043c \u0432\u043e\u0440\u0430\u0433\u0430\u043c \u0434\u043b\u044f \u045e\u0441\u0451\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0456 \u044f\u0435 \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a\u0430\u043c?<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u0411\u043e\u0433, \u044f\u043a\u0456 \u0445\u043e\u0447\u0430 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0456 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u0434\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u045e\u0434\u044b \u045e\u0441\u0456\u0445, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u0437 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u045e\u043c\u0430\u0446\u0443\u0435 \u0456\u0445 \u0441\u044d\u0440\u0446\u044b \u045e \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u0430\u0439 \u0432\u0435\u0440\u044b \u0456 \u0434\u0430\u0441\u0446\u044c \u0441\u0456\u043b\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0435\u0440\u044d\u0442\u044b\u043a\u0430 \u0456 \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430; \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0436 \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u044b\u043c \u0442\u0430\u0433\u043e \u043f\u0430\u0441\u0442\u044b\u0440\u0430, \u044f\u043a\u0456 \u0441\u0451\u043d\u043d\u044f \u045e\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u0432\u0430\u0435 \u041a\u0430\u0441\u0446\u0451\u043b. \u041d\u044f\u0445\u0430\u0439 \u0442\u0430\u043a, \u043d\u0435 \u0430\u0434\u0441\u0442\u0443\u043f\u0430\u044e\u0447\u044b \u043d\u0456 \u045e \u0447\u044b\u043c \u0430\u0434 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043d\u0435 \u0430\u0434\u0445\u0456\u043b\u044f\u044e\u0447\u044b \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u043d\u0430\u0432\u0430\u0442 \u0443 \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u044b\u043c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0456\u0441\u044c\u043c\u043e\u0432\u0430 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0456 \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0430\u043d\u0451\u043b\u0430\u043c\u0456, \u044f\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u043c\u0430\u0451\u0439 \u043f\u0430\u043a\u043e\u0440\u0430\u0439 \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0432\u044f\u043d\u0435\u0446 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0437\u0430 \u0441\u043b\u0443\u0448\u043d\u0443\u044e \u0432\u0435\u0440\u0443 \u0437 \u0440\u0443\u043a\u0456 \u041f\u0430\u043d\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043f\u0440\u0430 \u043c\u0430\u0451 \u043f\u0430\u043a\u043e\u0440\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u0441\u0430\u043c \u041f\u0430\u043d \u043f\u0430\u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u0442\u0430\u043a, \u044f\u043a \u042f\u043c\u0443 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u045e\u0433\u043e\u0434\u043d\u0430, \u0446\u0456 \u045e \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u044b\u0445 \u043d\u044f\u0434\u043e\u043b\u044f\u0445, \u0446\u0456 \u045e \u0445\u0432\u0456\u043b\u0456\u043d\u044b \u043f\u0430\u043b\u0451\u0433\u043a\u0456. \u0411\u043e \u041f\u0430\u043d \u0431\u043b\u0456\u0437\u043a\u0430, \u0447\u0430\u0433\u043e \u043c\u043d\u0435 \u0445\u0432\u0430\u043b\u044f\u0432\u0430\u0446\u0446\u0430? \u042f \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f \u043d\u0430 \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0448\u0442\u043e \u0401\u043d \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u0446\u044c \u0456 \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435 \u043a\u0430\u043d\u0435\u0446 \u043c\u0430\u0439\u043c\u0443 \u043b\u0451\u0441\u0443 \u0442\u0430\u043a, \u044f\u043a \u0437\u0430\u0433\u0430\u0434\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0432\u0456\u0442\u0430\u0439\u0446\u0435 \u0432\u0430\u0448\u044b\u0445 \u0431\u043b\u0456\u0437\u043a\u0456\u0445 \u0456 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u045e \u043c\u0430\u0456\u043c \u043a\u0430\u0439\u0434\u0430\u043d\u0430\u043c. \u041d\u044f\u0445\u0430\u0439 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0411\u043e\u0433 \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0435 \u0432\u0430\u0441 \u0441\u0432\u0430\u0451\u0439 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0439 \u0440\u0443\u043a\u043e\u0439 \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0439 \u0441\u043f\u0430\u043a\u0443\u0441\u044b \u0456 \u0437\u0431\u0430\u045e\u043b\u044f\u0435 \u0434\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u0426\u0456\u043c 4, 7-8\u0430; \u0424\u043b\u043f 3, 8b. 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0434\u043e\u0431\u0440\u0430\u0439 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435 \u044f \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f, \u0431\u0435\u0433 \u0441\u043a\u043e\u043d\u0447\u044b\u045e, \u0432\u0435\u0440\u0443 \u0437\u0430\u0445\u0430\u0432\u0430\u045e; <span style=\"color: #ff0000;\">*<\/span> \u0432\u043e\u0441\u044c \u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. <span style=\"color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span> \u0410\u043b\u043b\u0435\u043b\u044e\u044f<span style=\"color: #ff0000;\">)<\/span>.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u045e\u0441\u0451 \u043b\u0456\u0447\u0443 \u0441\u0442\u0440\u0430\u0442\u0430\u044e \u0434\u0437\u0435\u043b\u044f \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u042f\u0433\u043e\u043d\u044b\u0445, \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u044e\u0447\u044b\u0441\u044f \u0434\u0430 \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c&nbsp;<span style=\"text-align: justify;\">\u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">(\u0412\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b \u043f\u0435\u0440\u044b\u044f\u0434<\/span><span style=\"text-align: justify;\">&nbsp;\u0410\u043b\u043b\u0435\u043b\u044e\u044f<\/span><span style=\"text-align: justify; color: #ff0000;\">)<\/span><span style=\"text-align: justify;\">.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"723","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 &laquo;\u041f\u0440\u0430\u0441\u043b\u043e\u0433\u0456\u0439&raquo; \u0441\u0432. \u0410\u043d\u0437\u044d\u043b\u044c\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 14. 16. 26: Opera omnia,edit. Schmitt, Seccovii, 1938, 1, 111-113. 121-122)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u044f\u0445\u0430\u0439 \u044f \u043f\u0430\u0437\u043d\u0430\u044e \u0426\u044f\u0431\u0435 \u0456 \u043f\u0430\u043b\u044e\u0431\u043b\u044e, \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0422\u0430\u0431\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u0442\u044b, \u043c\u0430\u044f \u0434\u0443\u0448\u0430, \u0442\u043e\u0435, \u0448\u0442\u043e \u0448\u0443\u043a\u0430\u043b\u0430? \u0422\u044b \u0448\u0443\u043a\u0430\u043b\u0430 \u0411\u043e\u0433\u0430, \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0448\u0442\u043e \u0401\u043d &ndash; \u0433\u044d\u0442\u0430 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0437 \u0443\u0441\u044f\u0433\u043e, \u043b\u0435\u043f\u0448\u0430\u0433\u0430 \u0437\u0430 \u042f\u0433\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u0441\u0430\u0431\u0435 \u045e\u044f\u0432\u0456\u0446\u044c; \u0401\u043d &ndash; \u0433\u044d\u0442\u0430 \u0441\u0430\u043c\u043e \u0436\u044b\u0446\u0446\u0451, \u0441\u0432\u044f\u0442\u043b\u043e, \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0434\u0430\u0431\u0440\u044b\u043d\u044f, \u0432\u0435\u0447\u043d\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u0456 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c; \u0401\u043d \u0451\u0441\u0446\u044c \u043f\u0430\u045e\u0441\u044e\u043b\u044c \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u043c\u043e\u0439 \u0411\u043e\u0436\u0430, \u043c\u043e\u0439 \u0441\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0456 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u0435\u043b\u044c, \u0441\u043a\u0430\u0436\u044b \u043c\u0430\u0451\u0439 \u043f\u0440\u0430\u0433\u043d\u0430\u0439 \u0434\u0443\u0448\u044b, \u0446\u0456 \u0451\u0441\u0446\u044c \u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u044f\u043a \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c, \u043a\u0430\u0431 \u044f\u043d\u0430 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0431\u0430\u0447\u044b\u043b\u0430 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0435. \u042f\u043d\u0430 \u0441\u0442\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448, \u0430\u043b\u0435 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c, \u043d\u0456\u0447\u043e\u0433\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u0446\u0435\u043c\u0440\u044b. \u0422\u044b\u043c \u043d\u0435 \u043c\u0435\u043d\u0448, \u044f\u043d\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u0446\u0435\u043c\u0440\u044b, \u044f\u043a\u043e\u0439 \u043d\u044f\u043c\u0430 \u045e \u0422\u0430\u0431\u0435, \u0430\u043b\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435, \u0448\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u0430\u0447\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0451\u0439 \u0446\u0435\u043c\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0422\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0436\u044b\u0432\u0435\u0448 \u0443 \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u0435, \u0456 \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430, \u0448\u0442\u043e \u0431 \u043c\u0430\u0433\u043b\u043e \u043f\u0440\u0430\u043d\u0456\u043a\u043d\u0443\u0446\u044c \u0443 \u0433\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u043b\u043e, \u043a\u0430\u0431 \u0442\u0430\u043c \u0426\u044f\u0431\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c. \u0422\u0430\u043c\u0443 \u044f \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0435 \u0431\u0430\u0447\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u0431\u043e \u044f\u043d\u043e \u0437\u0430\u043d\u0430\u0434\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0434\u043b\u044f \u043c\u044f\u043d\u0435; \u0430\u0434\u043d\u0430\u043a \u0443\u0441\u0451, \u0448\u0442\u043e \u0431\u0430\u0447\u0443, \u0431\u0430\u0447\u0443 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043c\u0443; \u0442\u0430\u043a \u044f\u043a \u0441\u043b\u0430\u0431\u0430\u0435 \u0432\u043e\u043a\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c, \u0431\u0430\u0447\u044b\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u043e\u043d\u0435\u0447\u043d\u0430\u043c\u0443 \u0441\u0432\u044f\u0442\u043b\u0443, \u044f\u043a\u043e\u0433\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u0443 \u0441\u0430\u043c\u0456\u043c \u0441\u043e\u043d\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043e\u0439 \u0440\u043e\u0437\u0443\u043c \u043d\u0435 \u043c\u043e\u0436\u0430 \u0430\u0445\u0430\u043f\u0456\u0446\u044c \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0442\u0430\u043a\u043e\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430: \u044f\u043d\u043e \u0437\u0430\u043d\u0430\u0434\u0442\u0430 \u044f\u0440\u043a\u0430\u0435; \u0430 \u0432\u043e\u043a\u0430 \u043c\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0434\u043e\u045e\u0433\u0430 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u044f\u0433\u043e. \u042f\u043d\u043e \u0430\u0441\u043b\u044f\u043f\u043b\u044f\u0435 \u0431\u043b\u044f\u0441\u043a\u0430\u043c, \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0435 \u0432\u0435\u043b\u0456\u0447\u0447\u0443, \u0437\u0430\u043b\u0456\u0432\u0430\u0435 \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u0441\u0446\u044e, \u0443\u0440\u0430\u0436\u0432\u0430\u0435 \u043d\u0435\u0430\u0431\u0441\u044f\u0436\u043d\u0430\u0441\u0446\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0435 \u0456 \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0435 \u0421\u0432\u044f\u0442\u043b\u043e! \u041e \u043f\u043e\u045e\u043d\u0430\u044f \u0456 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u041f\u0440\u0430\u045e\u0434\u0430, \u044f\u043a \u0434\u0430\u043b\u0451\u043a\u0430 \u0422\u044b \u0430\u0434 \u043c\u044f\u043d\u0435, \u0430 \u044f \u0442\u0430\u043a \u0431\u043b\u0456\u0437\u043a\u0430 \u0434\u0430 \u0426\u044f\u0431\u0435! \u042f\u043a \u0436\u0430 \u0422\u044b \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u043c\u0430\u0439\u0433\u043e \u043f\u043e\u0437\u0456\u0440\u043a\u0443, \u0445\u043e\u0446\u044c \u044f \u045e \u0426\u044f\u0431\u0435 \u043d\u0430\u0432\u0456\u0434\u0430\u0432\u043e\u043a\u0443!<br \/>\u0422\u044b \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435\u0448 \u043f\u0430\u045e\u0441\u044e\u043b\u044c, \u0430 \u044f \u0426\u044f\u0431\u0435 \u043d\u0435 \u0431\u0430\u0447\u0443. \u0423 \u0422\u0430\u0431\u0435 \u0440\u0443\u0445\u0430\u044e\u0441\u044f \u0456 \u045e \u0422\u0430\u0431\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0443\u0441\u044f, \u0430 \u043d\u0435 \u043c\u0430\u0433\u0443 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u0446\u0430 \u0434\u0430 \u0426\u044f\u0431\u0435. \u0422\u044b \u045e\u043d\u0443\u0442\u0440\u044b \u043c\u044f\u043d\u0435 \u0456 \u0432\u0430\u043a\u043e\u043b \u043c\u044f\u043d\u0435, \u0430 \u044f \u043d\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u044e \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0448\u0443 \u0426\u044f\u0431\u0435, \u0411\u043e\u0436\u0430, \u043d\u044f\u0445\u0430\u0439 \u044f \u043f\u0430\u0437\u043d\u0430\u044e \u0426\u044f\u0431\u0435 \u0456 \u043f\u0430\u043b\u044e\u0431\u043b\u044e, \u043a\u0430\u0431 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0422\u0430\u0431\u0435. \u0410 \u043a\u0430\u043b\u0456 \u043d\u0435 \u043c\u0430\u0433\u0443 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u045e \u043f\u043e\u045e\u043d\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u044f \u0431\u0443\u0434\u0443 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0456 \u0437 \u043a\u043e\u0436\u043d\u044b\u043c \u0434\u043d\u0451\u043c, \u043f\u0430\u043a\u0443\u043b\u044c \u044f\u043d\u043e \u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u043f\u0430\u045e\u043d\u0430\u0442\u044b; \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0433\u043b\u044b\u0431\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0426\u044f\u0431\u0435 \u0456 \u0441\u0442\u0430\u043d\u0435 \u043f\u043e\u045e\u043d\u044b\u043c \u0442\u0430\u043c, \u0443 \u043d\u0435\u0431\u0435; \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u043c\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0426\u044f\u0431\u0435, \u0456 \u0442\u0430\u043c \u0441\u0442\u0430\u043d\u0435 \u043f\u043e\u045e\u043d\u0430\u0439, \u043a\u0430\u0431 \u0442\u0443\u0442, \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0443 \u043c\u044f\u043d\u0435 \u0431\u044b\u043b\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043d\u0430\u0434\u0437\u0435\u0456, \u0430 \u0442\u0430\u043c \u0431\u044b\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0430\u043b\u043e\u0434\u0430\u043d\u043d\u044e \u0422\u0430\u0431\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0422\u044b \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0448 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0456 \u043d\u0430\u0432\u0430\u0442 \u0440\u0430\u0456\u0448 \u043f\u0440\u0430\u0441\u0456\u0446\u044c, \u0456 \u0430\u0431\u044f\u0446\u0430\u0435\u0448 \u0437\u0440\u0430\u0431\u0456\u0446\u044c, \u0448\u0442\u043e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430 \u0431\u0443\u0434\u0437\u0435 \u043f\u043e\u045e\u043d\u0430\u0439. \u041f\u0430\u043d\u0435, \u043f\u0440\u0430\u0448\u0443 \u045e \u0426\u044f\u0431\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0422\u044b \u0440\u0430\u0456\u0448 \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0433\u0430 \u0414\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430; \u043d\u044f\u0445\u0430\u0439 \u044f \u0430\u0442\u0440\u044b\u043c\u0430\u044e \u0442\u043e\u0435, \u0448\u0442\u043e \u0422\u044b \u0430\u0431\u044f\u0446\u0430\u0435\u0448 \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439, \u043a\u0430\u0431 \u043c\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0431\u044b\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u0439. \u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0411\u043e\u0436\u0430, \u043f\u0440\u0430\u0448\u0443, \u0434\u0430\u0437\u0432\u043e\u043b\u044c, \u043a\u0430\u0431 \u043c\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0431\u044b\u043b\u0430 \u043f\u043e\u045e\u043d\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u043c \u0447\u0430\u0441\u0430\u043c \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435 \u043c\u043e\u0439 \u0440\u043e\u0437\u0443\u043c \u0456 \u043a\u0430\u0436\u0430 \u043c\u043e\u0439 \u044f\u0437\u044b\u043a. \u041d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0456 \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043a\u0430\u0436\u0443\u0446\u044c \u043c\u0430\u0435 \u0432\u0443\u0441\u043d\u044b. \u041d\u044f\u0445\u0430\u0439 \u0436\u0430\u0434\u0430\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u0430\u044f \u0434\u0443\u0448\u0430, \u043d\u044f\u0445\u0430\u0439 \u0441\u043c\u0430\u0433\u043d\u0435 \u043c\u0430\u0451 \u0446\u0435\u043b\u0430, \u043d\u044f\u0445\u0430\u0439 \u0436\u0430\u0434\u0430\u0435 \u045e\u0441\u044f \u043c\u0430\u044f \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c, \u043f\u0430\u043a\u0443\u043b\u044c \u044f \u043d\u0435 \u045e\u0432\u0430\u0439\u0434\u0443 \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0422\u0440\u043e\u0439\u0446\u0430\u0439 \u0456 \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0411\u043e\u0433\u0430\u043c, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u043c \u043d\u0430\u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0432\u044f\u0442\u044b \u0410\u043d\u0437\u044d\u043b\u044c\u043c, \u0441\u043b\u0430\u045e\u043d\u044b \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u044b \u041b\u044f\u043d\u0444\u0440\u0430\u043d\u043a\u0430\u043c, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u0430\u0439\u0446\u0435\u0446 \u043c\u0430\u043d\u0430\u0445\u0430\u045e, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0434\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u0441\u043a\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456, <span style=\"color: #ff0000;\">*<\/span> \u043c\u0443\u0436\u043d\u0430 \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u0437\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u0443 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u044f\u0437\u043b\u043e\u043c\u043d\u0430 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u045e, \u0448\u0442\u043e \u041a\u0430\u0441\u0446\u0451\u043b &ndash; \u0433\u044d\u0442\u0430 \u043d\u0435 \u0441\u043b\u0443\u0433\u0430, \u0430\u043b\u0435 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u044f \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0443\u0436\u043d\u0430 \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f<span style=\"text-align: justify;\">\u0437\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u0443 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"724","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u0414\u0430\u043c&rsquo;\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 3, De sancto Georgio: PL 144, 567-571)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u0435\u043f\u0435\u0440\u0430\u043c\u043e\u0436\u043d\u0430 \u0430\u0431\u0430\u0440\u043e\u043d\u0435\u043d\u044b \u0448\u0442\u0430\u043d\u0434\u0430\u0440\u0430\u043c \u043a\u0440\u044b\u0436\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u044f \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b, \u044f\u043a \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u043f\u044f\u0440\u043b\u0456\u043d\u0430, \u0448\u0442\u043e \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044e \u0430\u0437\u0434\u0430\u0431\u043b\u044f\u0435 \u0437\u043e\u043b\u0430\u0442\u0430, \u044f\u043a\u0456\u043c \u0430\u043f\u0440\u0430\u045e\u043b\u0435\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0451\u043d \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0434\u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u0430. \u0401\u043d \u0437\u043c\u044f\u043d\u0456\u045e \u0441\u043b\u0443\u0436\u0431\u0443 \u0442\u0440\u044b\u0431\u0443\u043d\u0430 \u043d\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435. \u0423 \u043d\u043e\u0432\u044b\u044f \u0448\u044d\u0440\u0430\u0433\u0456 \u0451\u043d \u0441\u0442\u0430\u045e \u044f\u043a \u043c\u0443\u0436\u043d\u044b \u0436\u0430\u045e\u043d\u0435\u0440. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0440\u0430\u0437\u0434\u0430\u045e \u0443\u0441\u0451 \u0441\u0432\u0430\u0451 \u0431\u0435\u0434\u043d\u044b\u043c \u0456 \u0442\u0430\u043a, \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b, \u0430\u043f\u0440\u0430\u043d\u0443\u045e\u0448\u044b \u0434\u0430\u0441\u043f\u0435\u0445\u0456 \u0432\u0435\u0440\u044b, \u0441\u0442\u0430\u045e \u0443 \u0446\u0435\u0441\u043d\u044b \u0431\u0430\u044f\u0432\u044b \u0441\u0442\u0440\u043e\u0439 \u044f\u043a \u0430\u0434\u0432\u0430\u0436\u043d\u044b \u0436\u0430\u045e\u043d\u0435\u0440 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u043c\u044b \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0431\u0430\u0456\u0446\u0446\u0430 \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u0446\u0446\u0430 \u0437\u044f\u043c\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u043c\u0443\u0436\u043d\u0430 \u0456 \u0430\u0434\u0434\u0430\u043d\u0430 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0441\u0432. \u042e\u0440\u044b\u0439, \u0437\u0430\u043f\u0430\u043b\u0435\u043d\u044b \u0430\u0433\u043d\u0451\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u043d\u0435\u043f\u0435\u0440\u0430\u043c\u043e\u0436\u043d\u0430 \u0430\u0431\u0430\u0440\u043e\u043d\u0435\u043d\u044b \u0448\u0442\u0430\u043d\u0434\u0430\u0440\u0430\u043c \u043a\u0440\u044b\u0436\u0430, \u0442\u0430\u043a \u0431\u0456\u045e\u0441\u044f \u0437 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044b\u043c \u043a\u0430\u0440\u0430\u043b\u0451\u043c, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430 \u045e\u0441\u0456\u0445 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445 \u0456 \u043f\u0430\u0434\u043d\u044f\u045e \u0434\u0443\u0445 \u0443\u0441\u0456\u0445 \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u0445 \u0434\u043b\u044f \u043c\u0443\u0436\u043d\u0430\u0439 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430 \u0431\u0456\u0442\u0432\u0430\u0439 \u043d\u0430\u0437\u0456\u0440\u0430\u045e \u043d\u044f\u0431\u0430\u0447\u043d\u044b \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0421\u0443\u0434\u0434\u0437\u044f, \u044f\u043a\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0451\u0439 \u0437\u0430\u0434\u0443\u043c\u044b, \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u043b\u044e\u0442\u0430\u0432\u0430\u0446\u044c \u0440\u0443\u043a\u0430\u043c \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430\u045e. \u0406 \u0445\u043e\u0446\u044c \u0401\u043d \u0430\u0434\u0434\u0430\u045e \u0446\u0435\u043b\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430 \u045e \u0440\u0443\u043a\u0456 \u043aa\u0442\u0430\u045e, \u0430\u0434\u043d\u0430\u043a \u0434\u0443\u0448\u0443, \u043d\u044f\u0437\u043b\u043e\u043c\u043d\u0430 \u0430\u0434\u0434\u0430\u043d\u0443\u044e \u043d\u0435\u043f\u0435\u0440\u0430\u043c\u043e\u0436\u043d\u0430\u0439 \u0432\u0435\u0440\u044b, \u0430\u0431\u044f\u0440\u043e\u0433 \u0441\u0432\u0430\u0451\u0439 \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430\u0439 \u0430\u043f\u0435\u043a\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u043c\u0443 \u0436\u0430\u045e\u043d\u0435\u0440\u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0432\u043e\u0439\u0441\u043a\u0430, \u0430\u043b\u0435 \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u044f\u0433\u043e. \u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0448 \u0434\u0443\u0445 \u0443\u0436\u043e \u0446\u044f\u043f\u0435\u0440 \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b. \u0410\u0434\u043d\u0430\u043a, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0430\u0448\u0430 \u0441\u044d\u0440\u0446\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0430\u0434 \u0456\u043c, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0441\u0430\u0447\u044b\u0446\u044c, \u043a\u0430\u0431 \u043d\u0435 \u0434\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0437\u0432\u0435\u0441\u0446\u0456 \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u044b\u043c\u0456 \u0441\u043f\u0430\u043a\u0443\u0441\u0430\u043c\u0456 \u0441\u0432\u0435\u0442\u0443 \u0446\u0456 \u0437\u0430\u043f\u0430\u043b\u043e\u0445\u0430\u0446\u044c \u043f\u0430\u0433\u0440\u043e\u0437\u0430\u043c\u0456 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0430\u0447\u044b\u0441\u0446\u0456\u043c \u0441\u044f\u0431\u0435, \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0431\u0440\u0443\u0434\u0443 \u0446\u0435\u043b\u0430 \u0456 \u0434\u0443\u0445\u0430, \u043a\u0430\u0431 \u043c\u044b \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u045e\u0434\u0430\u0441\u0442\u043e\u0456\u043b\u0456\u0441\u044f \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0448\u0447\u0430\u0441\u0446\u044f, \u0443 \u044f\u043a\u0443\u044e \u043f\u0430\u043a\u0443\u043b\u044c \u0437\u0430\u0437\u0456\u0440\u0430\u0435\u043c \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u0430\u043a\u0430\u045e\u043a\u0430\u0439 \u0440\u043e\u0437\u0443\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043d\u0430\u043c\u0435\u0440\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0411\u043e\u0433\u0443 \u045e \u0442\u0430\u0431\u044d\u0440\u043d\u0430\u043a\u0443\u043b\u044e\u043c\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0430\u0431\u043c\u044b\u0446\u0446\u0430 \u045e \u0441\u0432\u044f\u0442\u043e\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0446\u043d\u043e\u0442\u0430\u045e, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0440\u044b \u0422\u0432\u0430\u0435 \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c&raquo; (\u041f\u0441 132 [131], 9).<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u045e\u0441\u0451\u0434\u044b, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u043d\u043e\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0451\u043d \u0443\u0436\u043e \u0430\u043f\u0440\u0430\u043d\u0430\u0435\u0446\u0446\u0430 \u043d\u0435 \u045e \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456, \u0430\u043b\u0435, \u0430\u0434\u043a\u043b\u0430\u045e\u0448\u044b \u0441\u0442\u0430\u0440\u0443\u044e \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0430\u0441\u0446\u044c, \u043f\u0435\u0440\u0430\u0430\u043f\u0440\u0430\u043d\u0430\u0435\u0446\u0446\u0430 \u045e \u043d\u043e\u0432\u0430\u0435 \u0456 \u0436\u044b\u0432\u0435 \u045e \u0456\u043c, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u043d\u043e\u0432\u044b \u043b\u0430\u0434 \u0436\u044b\u0446\u0446\u044f \u0447\u044b\u0441\u0442\u044b\u043c \u0456 \u0441\u0432\u044f\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043b\u0430\u0441\u043d\u0430 \u0442\u0430\u043a, \u0430\u0447\u044b\u0441\u0446\u0456\u045e\u0448\u044b\u0441\u044f \u0430\u0434 \u0431\u0440\u0443\u0434\u0443 \u0441\u0442\u0430\u0440\u043e\u0439 \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0430\u0441\u0446\u0456 \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u045e \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u0430\u0435 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u043d\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0433\u043e\u0434\u043d\u0430 \u045e\u0448\u0430\u043d\u0443\u0435\u043c \u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430-\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u0441\u0432\u044f\u0442\u044b, \u044f\u043a\u0456 \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u045e \u0430\u0431\u0430\u0440\u043e\u043d\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0437\u0430\u043a\u043e\u043d\u0443 \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u043d\u0435 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u045e\u0441\u044f \u043f\u0430\u0433\u0440\u043e\u0437 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u0445, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0451\u043d \u0441\u0442\u0430\u044f\u045e \u043d\u0430 \u0446\u0432\u0451\u0440\u0434\u0430\u0439 \u0441\u043a\u0430\u043b\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0441\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u0436\u044b\u0446\u0446\u0451\u043c \u0443 \u0441\u0432\u0435\u0446\u0435 \u0456 \u0434\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0451\u043d<span style=\"text-align: justify;\">\u0441\u0442\u0430\u044f\u045e \u043d\u0430 \u0446\u0432\u0451\u0440\u0434\u0430\u0439 \u0441\u043a\u0430\u043b\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"725","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0416\u044b\u0446\u0446\u044f\u0440\u044b\u0441, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u044b \u0442\u0430\u0433\u0430\u0447\u0430\u0441\u043d\u044b\u043c \u0430\u045e\u0442\u0430\u0440\u0430\u043c<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Acta Sanctorum, Aprilis, III, pp. 186-187)<\/span><br \/><span style=\"color: #ff0000;\">\u0410\u0431\u043d\u044f\u045e \u043a\u0440\u044b\u0436 \u0443\u0441\u0456\u043c \u0446\u0435\u043b\u0430\u043c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0443\u0441\u044e\u043b\u044c \u0437\u0431\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u0431\u044f\u0437\u0434\u0437\u0435\u0439\u043d\u0430\u044f \u0447\u044d\u0440\u043d\u044c \u0456 \u0437 \u0436\u0443\u0434\u0430\u0441\u043d\u044b\u043c \u043a\u0440\u044b\u043a\u0430\u043c \u0456 \u0441\u0430\u0431\u0430\u0447\u044b\u043c \u0440\u044b\u043a\u0430\u043c \u0447\u0430\u043a\u0430\u0435, \u0448\u0442\u043e \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u043f\u0430\u0441\u0435\u043b\u0456\u0448\u0447\u0430 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0431\u0456\u0446\u044c \u0441\u0430 \u0441\u0432. \u0410\u0434\u0430\u043b\u044c\u0431\u044d\u0440\u0442\u0430\u043c. \u0422\u0430\u0434\u044b \u045e \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u043c\u0443\u0436\u0430 \u0441\u043f\u044b\u0442\u0430\u043b\u0456\u0441\u044f, \u0445\u0442\u043e \u0451\u043d \u0456 \u0430\u0434\u043a\u0443\u043b\u044c \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c. \u0401\u043d \u0443 \u0430\u0434\u043a\u0430\u0437 \u043f\u0430\u043a\u043e\u0440\u043b\u0456\u0432\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0430\u0435: &laquo;\u0410\u0434 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u044f \u0447\u044d\u0445, \u043c\u044f\u043d\u0435 \u0437\u0430\u0432\u0443\u0446\u044c \u0410\u0434\u0430\u043b\u044c\u0431\u044d\u0440\u0442\u0430\u043c, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f &ndash; \u043c\u0430\u043d\u0430\u0445, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0430\u043d\u0443 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0431\u044b\u045e \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0443 &ndash; \u0432\u0430\u0448 \u0430\u043f\u043e\u0441\u0442\u0430\u043b. \u041f\u0440\u044b\u0447\u044b\u043d\u0430 \u043c\u0430\u0439\u0433\u043e \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430 &ndash; \u0432\u0430\u0448\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u043a\u0430\u0431, \u043f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0441\u0432\u0430\u0456\u0445 \u0433\u043b\u0443\u0445\u0430\u043d\u044f\u043c\u044b\u0445 \u0456\u0434\u0430\u043b\u0430\u045e, \u0432\u044b \u043f\u0440\u044b\u0437\u043d\u0430\u043b\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0411\u043e\u0433\u0430\u043c \u0456 \u0430\u043a\u0440\u0430\u043c\u044f \u042f\u0433\u043e \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430; \u043a\u0430\u0431, \u043f\u0430\u0432\u0435\u0440\u044b\u045e\u0448\u044b \u045e \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435, \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0436\u044b\u0446\u0446\u0451 \u0456 \u045e\u0434\u0430\u0441\u0442\u043e\u0456\u043b\u0456\u0441\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u045e \u043d\u0435\u045e\u0432\u044f\u0434\u0430\u043b\u044c\u043d\u044b\u0445 \u043f\u0430\u043d\u0430\u0434\u0432\u043e\u0440\u043a\u0430\u0445 \u041f\u0430\u043d\u0430&raquo;. \u0422\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0432. \u0410\u0434\u0430\u043b\u044c\u0431\u044d\u0440\u0442. \u042f\u043d\u044b \u0436, \u0440\u0430\u0437\u0437\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u044f\u0448\u0447\u044d \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430, \u0441\u0442\u0430\u043b\u0456 \u0437 \u043a\u0440\u044b\u043a\u0430\u043c \u0430\u0431\u0440\u0430\u0436\u0430\u0446\u044c \u044f\u0433\u043e \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0447\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0456 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0446\u044c \u044f\u043c\u0443 \u0441\u043c\u0435\u0440\u0446\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u0437\u044b\u0447\u043d\u0456\u0446\u043a\u0430\u044f \u043b\u044e\u0442\u0430\u0441\u0446\u044c \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456, \u044f\u043d\u044b \u0440\u044b\u043d\u0443\u043b\u0456\u0441\u044f \u043d\u0430 \u0441\u0432. \u0410\u0434\u0430\u043b\u044c\u0431\u044d\u0440\u0442\u0430 \u0456 \u044f\u0433\u043e\u043d\u044b\u0445 \u043f\u0430\u043f\u043b\u0435\u0447\u043d\u0456\u043a\u0430\u045e \u0456 \u0437\u0430\u043a\u0443\u043b\u0456 \u045e\u0441\u0456\u0445 \u0443 \u043a\u0430\u0439\u0434\u0430\u043d\u044b. \u0421\u0432. \u0410\u0434\u0430\u043b\u044c\u0431\u044d\u0440\u0442, \u0441\u0442\u043e\u044f\u0447\u044b \u043f\u0435\u0440\u0430\u0434 \u0413\u0430\u045e\u0434\u044d\u043d\u0442\u044b\u0435\u043c \u0456 \u0456\u043d\u0448\u044b\u043c \u0437\u0432\u044f\u0437\u0430\u043d\u044b\u043c \u0431\u0440\u0430\u0442\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0411\u0440\u0430\u0442\u044b, \u043d\u0435 \u0441\u043c\u0443\u0442\u043a\u0443\u0439\u0446\u0435! \u0412\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u043c\u044b \u0437\u043d\u043e\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u044f \u043f\u0430\u043a\u0443\u0442\u044b \u0434\u0437\u0435\u043b\u044f \u0456\u043c\u0435\u043d\u0456 \u041f\u0430\u043d\u0430, \u044f\u043a\u043e\u043c\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0445\u0432\u0430\u043b\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0439 \u0445\u0432\u0430\u043b\u043e\u0439, \u043a\u0440\u0430\u0441\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0439 \u043a\u0440\u0430\u0441\u043e\u044e, \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u044f \u043c\u043e\u0446 \u0456 \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e. \u0411\u043e \u0448\u0442\u043e \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u043c\u0443\u0436\u043d\u044b\u043c, \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u043c, \u044f\u043a \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0437\u0430 \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0436\u0443\u0434\u0430\u0441\u043d\u0430\u0433\u0430 \u043d\u0430\u0442\u043e\u045e\u043f\u0443 \u0432\u044b\u0441\u043a\u0430\u0447\u044b\u045e \u0440\u0443\u0434\u044b \u0421\u0456\u0433\u043e\u043d \u0456, \u0437 \u0443\u0441\u044f\u0435 \u043c\u043e\u0446\u044b \u0440\u0430\u0437\u043c\u0430\u0445\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u0432\u044f\u043b\u0456\u0437\u043d\u0430\u044e \u0434\u0437\u0456\u0434\u0430\u0439, \u043f\u0440\u0430\u0431\u0456\u045e \u043d\u0430\u0441\u043a\u0440\u043e\u0437\u044c \u044f\u0433\u043e\u043d\u044b\u044f \u0433\u0440\u0443\u0434\u0437\u0456. \u041f\u0443\u043d\u0441\u043e\u0432\u0430\u044f \u043a\u0440\u043e\u045e \u043f\u0430\u043b\u0456\u043b\u0430\u0441\u044f \u0437 \u0430\u0431\u043e\u0434\u0432\u0443\u0445 \u0431\u0430\u043a\u043e\u045e. \u0421\u0432. \u0410\u0434\u0430\u043b\u044c\u0431\u044d\u0440\u0442 \u0441\u0442\u0430\u0456\u0446\u044c \u0456 \u043c\u043e\u043b\u0456\u0446\u0446\u0430, \u043f\u0430\u0434\u043d\u044f\u045e\u0448\u044b \u0432\u043e\u0447\u044b \u0456 \u0440\u0443\u043a\u0456 \u0434\u0430 \u043d\u0435\u0431\u0430. \u0412\u044b\u0446\u0435\u043a \u0447\u044b\u0440\u0432\u043e\u043d\u044b \u0441\u0442\u0440\u0443\u043c\u0435\u043d\u044c \u0437 \u0431\u0430\u0433\u0430\u0442\u0430\u0439 \u0432\u0435\u043d\u044b, \u0430 \u043a\u0430\u043b\u0456 \u0432\u044b\u0446\u044f\u0433\u043d\u0443\u043b\u0456 \u0434\u0437\u0456\u0434\u0443, \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u0441\u0435\u043c \u0432\u044f\u043b\u0456\u0437\u043d\u044b\u0445 \u0440\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u044f\u043c\u0443 \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u043b\u0456 \u0440\u0443\u043a\u0456, \u0451\u043d \u0440\u0430\u0441\u043f\u0430\u0441\u0446\u0451\u0440 \u0456\u0445 \u043d\u0430 \u045e\u0437\u043e\u0440 \u043a\u0440\u044b\u0436\u0430 \u0456, \u043f\u0430\u043a\u043e\u0440\u043d\u0430 \u045e\u0437\u043d\u0451\u0441\u0448\u044b \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0437\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0451 \u0456 \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u044f\u045e, \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e \u0434\u0430 \u041f\u0430\u043d\u0430. \u0422\u0430\u043a \u044f\u0433\u043e\u043d\u0430\u044f \u0441\u0432\u044f\u0442\u0430\u044f \u0434\u0443\u0448\u0430 \u0432\u044b\u043b\u0435\u0446\u0435\u043b\u0430 \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u044f\u0437\u043d\u0456\u0446\u044b, \u0442\u0430\u043a \u0441\u043b\u0430\u045e\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u043a\u0440\u044b\u0436, \u0437\u0430\u043d\u044f\u043b\u043e \u0437\u044f\u043c\u043b\u044e, \u0456 \u0442\u0430\u043a, \u0430\u0434\u0434\u0430\u045e\u0448\u044b \u0436\u044b\u0446\u0446\u0451 \u045e \u043a\u0440\u044b\u0432\u0430\u0432\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u044b, \u0451\u043d \u0443 \u0448\u0447\u0430\u0441\u043d\u044b\u0445 \u0441\u044f\u0434\u0437\u0456\u0431\u0430\u0445, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u0443\u0441\u0446\u0435\u0448\u044b\u045e\u0441\u044f \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u044b\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u0426\u0456\u043c 1, 8; \u0413\u0430\u043b 4, 19<\/span><br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u044b \u0433\u043e\u0440\u0430\u0447\u0430 \u0436\u0430\u0434\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u0432\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 \u0456 \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b, <span style=\"color: #ff0000;\">*&nbsp; <\/span>\u0431\u043e \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u044b\u043c\u0456 \u0434\u043b\u044f \u043d\u0430\u0441, \u0430\u043b\u043b\u0435\u043b\u044e\u044f. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0437\u0435\u0446\u0456 \u043c\u0430\u0435, \u044f \u0437\u043d\u043e\u045e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e \u0432\u0430\u0441 \u0443 \u043f\u0430\u043a\u0443\u0442\u0430\u0445, \u043f\u0430\u043a\u0443\u043b\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0441\u0444\u0430\u0440\u043c\u0443\u0435\u0446\u0446\u0430 \u045e \u0432\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e \u0432\u044b<span style=\"text-align: justify;\">\u0441\u0442\u0430\u043b\u0456 \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u044b\u043c\u0456 \u0434\u043b\u044f \u043d\u0430\u0441, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"726","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0445\u0432\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0440\u0430\u043c\u043e\u0432\u0430 \u045e \u0433\u043e\u043d\u0430\u0440 \u0441\u0432. \u0424\u0456\u0434\u044d\u043b\u044f, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0432\u0435\u0440\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0456\u043c\u0435\u043d\u0456 \u0456 \u0441\u043f\u0440\u0430\u0432\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043f\u0430 \u0411\u044d\u043d\u044d\u0434\u044b\u043a\u0442 \u0425\u0406V \u0442\u0430\u043a\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u045e\u0448\u0430\u043d\u0430\u0432\u0430\u045e \u0441\u0432. \u0424\u0456\u0434\u044d\u043b\u044f: &laquo;\u0401\u043d \u0432\u044b\u043b\u0456\u045e \u043f\u0430\u045e\u043d\u0430\u0442\u0443 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0437\u0435\u043b\u044f \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0456 \u0431\u043b\u0456\u0436\u043d\u0456\u0445. \u0423\u0441\u0456\u0445 \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u0445 \u0451\u043d \u0431\u0440\u0430\u045e \u0443 \u0441\u0432\u0430\u0435 \u0430\u0439\u0446\u043e\u045e\u0441\u043a\u0456\u044f \u0430\u0431\u0434\u044b\u043c\u043a\u0456, \u0430\u0434\u0443\u0441\u044e\u043b\u044c \u0437\u0431\u0456\u0440\u0430\u045e \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443 \u0456 \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u045e \u044f\u0435 \u043d\u0430\u0442\u043e\u045e\u043f\u0430\u043c \u0443\u0431\u043e\u0433\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u0441\u0430\u043c\u043e\u0442\u043d\u044b\u0445 \u0441\u0456\u0440\u043e\u0442\u0430\u045e \u0456 \u045e\u0434\u043e\u0432\u0430\u045e, \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u044e\u0447\u044b \u0434\u043b\u044f \u0456\u0445 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0430\u0434 \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u0445 \u0456 \u0437\u0430\u043c\u043e\u0436\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u0410\u043a\u0430\u0437\u0432\u0430\u045e \u0443\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u0456 \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u0443\u044e \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0443 \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b\u043c \u0443 \u0432\u044f\u0437\u043d\u0456\u0446\u0430\u0445, \u043a\u043b\u0430\u043f\u0430\u0442\u043b\u0456\u0432\u0430 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u045e \u0445\u0432\u043e\u0440\u044b\u0445, \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u045e \u0456\u0445, \u044f\u0434\u043d\u0430\u045e \u0437 \u0411\u043e\u0433\u0430\u043c \u0456 \u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0434\u0430 \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430 \u0431\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u044b\u043c \u0440\u043e\u0434\u0437\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043c\u0435\u045e \u0431\u043e\u043b\u044c\u0448 \u043f\u043b\u0451\u043d\u043d\u0430\u0433\u0430 \u043f\u043e\u043b\u044f \u0434\u043b\u044f \u0437\u0430\u0441\u043b\u0443\u0433 \u044f\u043a \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0430\u045e\u0441\u0442\u0440\u044b\u0439\u0441\u043a\u0430\u0435 \u0432\u043e\u0439\u0441\u043a\u0430, \u0440\u0430\u0441\u043a\u0432\u0430\u0442\u0430\u0440\u0430\u0432\u0430\u043d\u0430\u0435 \u045e \u0432\u0430\u043a\u043e\u043b\u0456\u0446\u0430\u0445 \u0420\u044d\u0442\u044b\u0456, \u0431\u044b\u043b\u043e \u0430\u043c\u0430\u043b\u044c \u0446\u0430\u043b\u043a\u0430\u043c \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430\u0435 \u044d\u043f\u0456\u0434\u044d\u043c\u0456\u044f\u0439 \u0456 \u0441\u0442\u0430\u043b\u0430, \u0432\u0430\u0440\u0442\u0430\u0439 \u0436\u0430\u043b\u044e, \u043f\u0430\u0448\u0430\u0439 \u0434\u043b\u044f \u0445\u0432\u0430\u0440\u043e\u0431 \u0456 \u0441\u043c\u0435\u0440\u0446\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0437\u0430\u043c \u0437 \u0433\u044d\u0442\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0441\u0432. \u0424\u0456\u0434\u044d\u043b\u044c, \u0432\u0435\u0440\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0456\u043c\u0435\u043d\u0456 \u0456 \u0441\u043f\u0440\u0430\u0432\u044b, \u0432\u044b\u043b\u0443\u0447\u0430\u045e\u0441\u044f \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u045e \u0430\u0431\u0430\u0440\u043e\u043d\u0435 \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0430\u0439 \u0432\u0435\u0440\u044b, \u044f\u043a\u0443\u044e \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u045e. \u0417\u0430 \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u0434\u0437\u0451\u043d \u0434\u0430 \u043f\u0440\u0430\u043b\u0456\u0446\u0446\u044f \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0456 \u0451\u043d \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0443 \u0430\u043f\u043e\u0448\u043d\u0456\u043c \u043a\u0430\u0437\u0430\u043d\u043d\u0456 \u044f\u043a \u0431\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0443 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445:&nbsp;&laquo;\u041e \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0430\u044f \u0432\u0435\u0440\u0430, \u044f\u043a\u0430\u044f \u0442\u044b \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u044f, \u044f\u043a\u0430\u044f \u043c\u043e\u0446\u043d\u0430\u044f, \u044f\u043a \u0434\u043e\u0431\u0440\u0430 \u045e\u043a\u0430\u0440\u0430\u043d\u0451\u043d\u0430\u044f, \u044f\u043a \u0434\u043e\u0431\u0440\u0430 &ldquo;\u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u0430\u044f \u043d\u0430 \u043c\u043e\u0446\u043d\u0430\u0439 \u0441\u043a\u0430\u043b\u0435&rdquo; (\u043f\u0430\u0440. \u041c\u0446 7, 25). \u041d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044f \u043f\u0440\u0430\u043c\u0456\u043d\u0443\u0446\u044c, \u0430 \u0442\u044b \u043d\u0435 \u043f\u0440\u0430\u043c\u0456\u043d\u0435\u0448 \u043d\u0456\u043a\u043e\u043b\u0456. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0442\u0430\u0431\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u045e\u0441\u044f \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442, \u0430\u043b\u0435 \u0442\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u0441\u043b\u0430\u045e\u043d\u044b \u0442\u0440\u044b\u0443\u043c\u0444 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456.<br \/>&ldquo;\u0406 \u0433\u044d\u0442\u0430\u0439 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430\u0439, \u044f\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u0430 \u0441\u0432\u0435\u0442, \u0451\u0441\u0446\u044c \u043d\u0430\u0448\u0430 \u0432\u0435\u0440\u0430&rdquo; (1 \u042f\u043d 5, 4). \u042f\u043d\u0430 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043b\u0430 \u045e\u043b\u0430\u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u0441\u0430\u043c\u044b\u0445 \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u0445 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u045e, \u044f\u043d\u0430 \u0437\u0434\u0430\u0431\u044b\u043b\u0430 \u043d\u0430\u0440\u043e\u0434\u044b \u0434\u043b\u044f \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u043b\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0456\u0441\u0446\u0456 \u043d\u0430 \u0441\u0443\u0440\u043e\u0432\u0443\u044e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0443 \u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u044f \u043f\u0430\u043a\u0443\u0442\u044b, \u044f\u043a \u043d\u0435 \u0432\u0435\u0440\u0430, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0432\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435?<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u043b\u0430 \u043f\u0443\u0441\u0442\u044d\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0446\u044c \u0432\u044b\u0433\u043e\u0434\u0430\u043c\u0456, \u0430\u0434\u043a\u0456\u0434\u0430\u0446\u044c \u0441\u043b\u0430\u0432\u0443, \u0442\u0430\u043f\u0442\u0430\u0446\u044c \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0456 \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u0446\u0446\u0430 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u044e \u0432\u0435\u0441\u0446\u0456 \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u0430\u0435 \u0441\u0430\u043c\u043e\u0442\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u044f\u043a \u043d\u0435 \u0436\u044b\u0432\u0430\u044f \u0432\u0435\u0440\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0441\u0451\u043d\u043d\u044f \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u0445 \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0434\u043a\u0456\u0434\u0430\u0446\u044c \u0441\u043b\u043e\u0434\u044b\u0447 \u0440\u0430\u0441\u043a\u043e\u0448\u044b \u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0441\u043a\u043b\u0430\u0434\u0430\u043d\u0430\u0441\u0446\u0456 \u043c\u0430\u0437\u043e\u043b\u044c\u043d\u0430\u0439 \u043f\u0440\u0430\u0446\u044b?<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0436\u044b\u0432\u0430\u044f \u0432\u0435\u0440\u0430, &ldquo;\u044f\u043a\u0430\u044f \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e&rdquo; (\u043f\u0430\u0440. \u0413\u0430\u043b 5, 6). \u0413\u044d\u0442\u0430 \u044f\u043d\u0430 \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u0435 \u043b\u044e\u0434\u0437\u0435\u0439 \u043f\u0430\u043a\u0456\u0434\u0430\u0446\u044c \u0446\u044f\u043f\u0435\u0440\u0448\u0430\u043d\u0456\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b \u045e \u043d\u0430\u0434\u0437\u0435\u0456 \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u044f \u0456 \u0437\u0430\u043c\u044f\u043d\u044f\u0446\u044c \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0435 \u043d\u0430 \u0432\u0435\u0447\u043d\u0430\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 2 \u0426\u0456\u043c 4, 7-8\u0430; \u043f\u0430\u0440. \u0424\u043b\u043f 3, 8b. 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0434\u043e\u0431\u0440\u0430\u0439 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435 \u044f \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f, \u0431\u0435\u0433 \u0441\u043a\u043e\u043d\u0447\u044b\u045e, \u0432\u0435\u0440\u0443 \u0437\u0430\u0445\u0430\u0432\u0430\u045e; <span style=\"color: #ff0000;\">*<\/span> \u0432\u043e\u0441\u044c \u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u045e\u0441\u0451 \u043b\u0456\u0447\u0443 \u0441\u0442\u0440\u0430\u0442\u0430\u044e \u0434\u0437\u0435\u043b\u044f \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u042f\u0433\u043e\u043d\u044b\u0445, \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u044e\u0447\u044b\u0441\u044f \u0434\u0430 \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c<span style=\"text-align: justify;\">\u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"727","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u044f\u045e&raquo; \u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 1, 10, 1-3: PG 7, 550-554)<\/span><br \/><span style=\"color: #ff0000;\">\u0410\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0441\u0446\u0451\u043b, \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0430\u0436 \u0434\u0430 \u043a\u0440\u0430\u0451\u045e \u0437\u044f\u043c\u043b\u0456, \u043f\u0440\u044b\u043d\u044f\u045e \u0430\u0434 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u0432\u0435\u0440\u0443 \u045e \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, &laquo;\u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0435\u0431\u0430, \u0456 \u0437\u044f\u043c\u043b\u044e, \u0456 \u043c\u043e\u0440\u0430, \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u0456\u0445 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435&raquo; (\u043f\u0430\u0440. \u0414\u0437 4, 24); \u0432\u0435\u0440\u0443 \u045e \u0430\u0434\u043d\u0430\u0433\u043e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0443\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0433\u0430 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0456 \u045e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0437\u0430\u0434\u0443\u043c\u044b \u0411\u043e\u0436\u044b\u044f \u0456 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u043f\u0440\u0430\u0437 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0430\u0434 \u0414\u0437\u0435\u0432\u044b, \u0456 \u043c\u0443\u043a\u0443, \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435 \u045e\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u0435 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430, \u0456 \u042f\u0433\u043e\u043d\u0430\u0435 \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u0437 \u043d\u0435\u0431\u0430 \u045e \u0441\u043b\u0430\u0432\u0435 \u0410\u0439\u0446\u0430, &laquo;\u043a\u0430\u0431 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0443\u0441\u0451&raquo; (\u042d\u0444 1, 10) \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u0446\u044c \u0443\u0441\u044f\u043a\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u043a\u0430\u0431 \u0415\u0437\u0443\u0441\u0443 \u0425\u0440\u044b\u0441\u0442\u0443, \u043d\u0430\u0448\u0430\u043c\u0443 \u041f\u0430\u043d\u0443, \u0411\u043e\u0433\u0443, \u0417\u0431\u0430\u045e\u0446\u0443 \u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, &laquo;\u0441\u0445\u0456\u043b\u0456\u043b\u0430\u0441\u044f \u043a\u043e\u0436\u043d\u0430\u0435 \u043a\u0430\u043b\u0435\u043d\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445, \u0437\u044f\u043c\u043d\u044b\u0445 \u0456 \u043f\u0430\u0434\u0437\u0435\u043c\u043d\u044b\u0445; \u0456 \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u044f\u0437\u044b\u043a \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u045e \u042f\u0433\u043e&raquo; (\u043f\u0430\u0440. \u0424\u043b\u043f 2, 10) \u0456 \u043a\u0430\u0431 \u0401\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0441\u0443\u0434 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0442\u0440\u044b\u043c\u0430\u045e \u0433\u044d\u0442\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0456 \u0433\u044d\u0442\u0443\u044e \u0432\u0435\u0440\u0443, \u044f\u043a \u043c\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u043b\u0456, \u041a\u0430\u0441\u0446\u0451\u043b, \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435. \u0401\u043d \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u044f\u0435, \u044f\u043a \u0431\u044b \u0436\u044b\u0432\u0443\u0447\u044b \u045e \u0430\u0434\u043d\u044b\u043c \u0434\u043e\u043c\u0435. \u041f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0432\u0435\u0440\u044b\u0446\u044c, \u043d\u0456\u0431\u044b\u0442\u0430 \u043c\u0430\u0435 \u0430\u0434\u043d\u0443 \u0434\u0443\u0448\u0443 \u0456 \u0430\u0434\u043d\u043e \u0441\u044d\u0440\u0446\u0430. \u0417\u0433\u043e\u0434\u043d\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0432\u0435\u0440\u0443, \u043d\u0430\u0432\u0443\u0447\u0430\u0435 \u0451\u0439 \u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u0435, \u043d\u0456\u0431\u044b\u0442\u0430 \u043c\u0430\u044e\u0447\u044b \u0430\u0434\u043d\u044b \u0432\u0443\u0441\u043d\u044b. \u0411\u043e \u0445\u043e\u0446\u044c \u043d\u0430 \u0441\u0432\u0435\u0446\u0435 \u0451\u0441\u0446\u044c \u0440\u043e\u0437\u043d\u044b\u044f \u043c\u043e\u0432\u044b, \u0430\u0434\u043d\u0430\u043a \u0430\u0434\u043d\u0430 \u0456 \u0442\u0430\u044f \u0436 \u043c\u043e\u0446 \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043d\u0435 \u043f\u0430-\u0456\u043d\u0448\u0430\u043c\u0443 \u0432\u0435\u0440\u0430\u0446\u044c, \u0456 \u043d\u0435 \u043f\u0430-\u0456\u043d\u0448\u0430\u043c\u0443 \u0432\u0443\u0447\u0430\u0446\u044c \u0442\u044b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u044b, \u0448\u0442\u043e \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u044b \u045e \u0413\u0435\u0440\u043c\u0430\u043d\u0456\u0456, \u0406\u0440\u043b\u0430\u043d\u0434\u044b\u0456, \u0441\u044f\u0440\u043e\u0434 \u043a\u0435\u043b\u044c\u0442\u0430\u045e, \u043d\u0430 \u0423\u0441\u0445\u043e\u0434\u0437\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0415\u0433\u0456\u043f\u0446\u0435, \u0443 \u041b\u0456\u0432\u0456\u0456 \u0456 \u0442\u044b\u044f, \u0448\u0442\u043e \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u0446\u044d\u043d\u0442\u0440\u044b \u0441\u0432\u0435\u0442\u0443. \u042f\u043a \u0441\u043e\u043d\u0446\u0430, \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0435, \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0430\u0434\u043d\u043e \u0456 \u0442\u043e\u0435 \u0436, \u0442\u0430\u043a \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0430\u045e\u0441\u044e\u043b\u044c, \u0434\u0437\u0435 \u0437\u0437\u044f\u0435, \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u0445\u043e\u0447\u0443\u0446\u044c \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043d\u0430\u0432\u0430\u0442 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u044b \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u043f\u0440\u0430\u043c\u043e\u045e\u0446\u0430 \u043d\u0435 \u0441\u043a\u0430\u0436\u0430 \u0456\u043d\u0448\u0430\u0433\u0430, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430 (\u0431\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0431\u043e\u043b\u044c\u0448\u044b \u0437\u0430 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430), \u0430 \u0441\u043b\u0430\u0431\u0435\u0439\u0448\u044b \u043f\u0440\u0430\u043c\u043e\u045e\u0446\u0430 \u043d\u0435 \u0437\u043c\u043e\u0436\u0430 \u043f\u0430\u043c\u0435\u043d\u0448\u044b\u0446\u044c \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u0456. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u0440\u0430 \u0430\u0434\u043d\u0430 \u0456 \u0442\u0430\u044f \u0436, \u043d\u0435 \u043f\u0430\u0448\u044b\u0440\u044b\u0446\u044c \u044f\u0435 \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u044f\u0435 \u0448\u043c\u0430\u0442, \u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043a\u0430\u0436\u0430 \u043c\u0430\u043b\u0430, \u043d\u0435 \u043f\u0430\u043c\u0435\u043d\u0448\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 1, 17-18. 21<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0414\u043e\u0431\u0440\u0443\u044e \u041d\u0430\u0432\u0456\u043d\u0443, \u0456 \u043d\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043c\u0430\u0440\u043d\u044b\u043c \u043a\u0440\u044b\u0436\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u0456\u043d\u0435, \u0441\u043b\u043e\u0432\u0430 \u0430\u0431 \u043a\u0440\u044b\u0436\u044b &ndash; \u0433\u044d\u0442\u0430 \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430, \u0430\u043b\u0435 \u0434\u043b\u044f \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u0437\u0431\u0430\u045e\u043b\u044f\u0435\u043c\u0441\u044f, &ndash; \u0433\u044d\u0442\u0430 \u043c\u043e\u0446 \u0411\u043e\u0436\u0430\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0432\u0435\u0442 \u0441\u0432\u0430\u0451\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e \u0411\u043e\u0433\u0430 \u045e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0439, \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0411\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0434\u043b\u044f \u0442\u044b\u0445<span style=\"text-align: justify;\">, \u0445\u0442\u043e \u0433\u0456\u043d\u0435, \u0441\u043b\u043e\u0432\u0430 \u0430\u0431 \u043a\u0440\u044b\u0436\u044b &ndash; \u0433\u044d\u0442\u0430 \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430, \u0430\u043b\u0435 \u0434\u043b\u044f \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u0437\u0431\u0430\u045e\u043b\u044f\u0435\u043c\u0441\u044f, &ndash; \u0433\u044d\u0442\u0430 \u043c\u043e\u0446 \u0411\u043e\u0436\u0430\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"728","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0445\u0432\u0430\u043b\u044c\u043d\u0430\u044f \u043f\u0440\u0430\u043c\u043e\u0432\u0430 \u045e \u0433\u043e\u043d\u0430\u0440 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041a\u0440\u043e\u045e \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e &ndash; \u043d\u0430\u0441\u0435\u043d\u043d\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u041f\u0451\u0442\u0440 \u0443\u0441\u0442\u0443\u043f\u0456\u045e \u0443 \u0422\u0430\u0432\u0430\u0440\u044b\u0441\u0442\u0432\u0430 \u041c\u0430\u0440\u044b\u0456, \u044f\u0433\u043e \u0430\u0434\u0440\u0430\u0437\u0443 \u043f\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043f\u0440\u043e\u0441\u044c\u0431\u0435 \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u043b\u0456 \u043d\u0430 \u043c\u0456\u0441\u0456\u044e \u045e \u0410\u043a\u0456\u044f\u043d\u0456\u044e. \u0401\u043d \u043f\u0440\u044b\u0431\u044b\u0432\u0430\u0435 \u043d\u0430 \u0432\u043e\u0441\u0442\u0440\u0430\u045e \u0424\u0443\u0442\u0443\u043d\u0430 \u045e \u0426\u0456\u0445\u0456\u043c \u0430\u043a\u0456\u044f\u043d\u0435, \u0434\u0437\u0435 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u044f\u0448\u0447\u044d \u043d\u0435 \u0431\u044b\u043b\u043e \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430. \u0411\u0440\u0430\u0442-\u0437\u0430\u043a\u043e\u043d\u043d\u0456\u043a, \u044f\u043a\u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u045e \u044f\u043c\u0443, \u0442\u0430\u043a \u0430\u043f\u0456\u0441\u0432\u0430\u0435 \u044f\u0433\u043e\u043d\u0430\u0435 \u043c\u0456\u0441\u0456\u044f\u043d\u0435\u0440\u0441\u043a\u0430\u0435 \u0436\u044b\u0446\u0446\u0451:&nbsp;&laquo;\u0410\u0431\u043f\u0430\u043b\u0435\u043d\u044b \u043f\u0440\u043e\u043c\u043d\u044f\u043c\u0456 \u0441\u043e\u043d\u0446\u0430 \u043f\u0430\u0434\u0447\u0430\u0441 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0446\u044b, \u0447\u0430\u0441\u0442\u0430 \u0433\u0430\u043b\u043e\u0434\u043d\u044b, \u0451\u043d \u0432\u044f\u0440\u0442\u0430\u045e\u0441\u044f \u0434\u0430\u0434\u043e\u043c\u0443 \u0430\u0431\u043b\u0456\u0442\u044b \u043f\u043e\u0442\u0430\u043c, \u0437\u043c\u0443\u0447\u0430\u043d\u044b \u0441\u0442\u043e\u043c\u0430\u044e, \u0430\u043b\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u043e\u0446\u043d\u044b \u0434\u0443\u0445\u0430\u043c, \u0436\u0432\u0430\u0432\u044b \u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u044b, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0432\u044f\u0440\u0442\u0430\u045e\u0441\u044f \u0437 \u043c\u0435\u0441\u0446\u0430 \u0437\u0430\u0431\u0430\u0432\u0430\u045e. \u0406 \u0442\u0430\u043a \u0431\u044b\u043b\u043e \u043d\u0435 \u0440\u0430\u0437, \u0430\u043b\u0435 \u0430\u043c\u0430\u043b\u044c \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0416\u044b\u0445\u0430\u0440\u0430\u043c \u0432\u043e\u0441\u0442\u0440\u0430\u0432\u0430 \u0451\u043d, \u044f\u043a \u043f\u0440\u0430\u0432\u0456\u043b\u0430, \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u045e, \u043d\u0430\u0432\u0430\u0442 \u0442\u044b\u043c, \u044f\u043a\u0456\u044f \u044f\u0433\u043e \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043b\u0456, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u0430\u0440\u0430\u0432\u0430\u045e \u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u045e, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0431\u044b\u043b\u0456 \u043f\u0440\u043e\u0441\u0442\u044b\u044f \u0456 \u043d\u0430\u0437\u043e\u0439\u043b\u0456\u0432\u044b\u044f. \u0414\u0430 \u045e\u0441\u0456\u0445 \u0431\u0435\u0437 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u044f \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u045e \u043d\u0430\u0434\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0443\u044e \u0437\u044b\u0447\u043b\u0456\u0432\u0430\u0441\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u0434\u0437\u0456\u045e\u043d\u0430\u0433\u0430 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0436\u044b\u0445\u0430\u0440\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0456 \u044f\u0433\u043e &laquo;\u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430&raquo;, \u0430 \u0451\u043d \u0447\u0430\u0441\u0430\u043c \u043a\u0430\u0437\u0430\u045e \u0431\u0440\u0430\u0442\u0443: &laquo;\u041d\u0430 \u0442\u0430\u043a\u043e\u0439 \u0446\u044f\u0436\u043a\u0430\u0439 \u043c\u0456\u0441\u0456\u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u0441\u0432\u044f\u0442\u044b\u043c\u0456&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u0440\u044b\u0445\u0443 \u043f\u0430\u0447\u0430\u045e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0430\u043b\u0435 \u0437\u0431\u0456\u0440\u0430\u045e \u043c\u0456\u0437\u044d\u0440\u043d\u044b \u043f\u043b\u0451\u043d. \u0410\u0434\u043d\u0430\u043a \u0441\u0432\u0430\u044e \u043c\u0456\u0441\u0456\u044f\u043d\u0435\u0440\u0441\u043a\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443 \u044f\u043a \u0443 \u0433\u0443\u043c\u0430\u043d\u0456\u0442\u0430\u0440\u043d\u044b\u043c, \u0442\u0430\u043a \u0456 \u0440\u044d\u043b\u0456\u0433\u0456\u0439\u043d\u044b\u043c \u0430\u0441\u043f\u0435\u043a\u0446\u0435 \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u0456\u045e \u0437 \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430\u0439 \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044e, \u0432\u0435\u0440\u0430\u0447\u044b \u045e \u0441\u043b\u043e\u0432\u044b \u0425\u0440\u044b\u0441\u0442\u0430: &laquo;\u0410\u0434\u0437\u0456\u043d \u0441\u0435\u0435, \u0430 \u0434\u0440\u0443\u0433\u0456 \u0436\u043d\u0435&raquo; (\u043f\u0430\u0440. \u042f\u043d 4, 37), &ndash; \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u043e\u0441\u044f\u0447\u044b \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0456 \u045e \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044b, \u044f\u043a\u0443\u044e \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u0430 \u0448\u0430\u043d\u0430\u0432\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u0433\u043e\u043d\u0430\u044f \u043f\u0440\u043e\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0432\u0435\u0440\u044b \u0437\u043d\u0456\u0448\u0447\u044b\u043b\u0430 \u043a\u0443\u043b\u044c\u0442 \u0437\u043b\u044b\u0445 \u0434\u0443\u0445\u0430\u045e, \u044f\u043a\u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u0448\u0430\u043c\u0430\u043d\u044b \u0424\u0443\u0442\u0443\u043d\u044b, \u043a\u0430\u0431 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u0422\u0430\u043c\u0443 \u044f\u043d\u044b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0456 \u044f\u043c\u0443 \u0436\u043e\u0440\u0441\u0442\u043a\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c, \u0441\u043f\u0430\u0434\u0437\u0435\u044e\u0447\u044b\u0441\u044f, \u0448\u0442\u043e \u0441\u0430 \u0441\u043c\u0435\u0440\u0446\u044e \u041f\u044f\u0442\u0440\u0430 \u0437\u043d\u0456\u043a\u043d\u0443\u0446\u044c \u043f\u0430\u0441\u0435\u044f\u043d\u044b\u044f \u0456\u043c \u0437\u044f\u0440\u043d\u044f\u0442\u044b \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0432\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043d\u0430\u043f\u044f\u0440\u044d\u0434\u0430\u0434\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0451\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u044f \u043f\u0430\u043c\u0440\u0443, \u0433\u044d\u0442\u0430 \u043d\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c, \u0431\u043e \u0432\u0435\u0440\u0430 \u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u043a\u0430\u0440\u0430\u043d\u0456\u043b\u0430\u0441\u044f \u043d\u0430 \u0432\u043e\u0441\u0442\u0440\u0430\u0432\u0435, \u0448\u0442\u043e \u043c\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c \u044f\u0435 \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0440\u043e\u045e \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u043f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451 \u0441\u0430\u043c\u0456\u043c \u0436\u044b\u0445\u0430\u0440\u0430\u043c \u0424\u0443\u0442\u0443\u043d\u044b, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0437 \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u0433\u0430\u0434\u043e\u045e \u0443\u0441\u0435 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0432\u0435\u0440\u0443 \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u043c \u0430\u0441\u0442\u0440\u0430\u0432\u0430\u043c \u0410\u043a\u0456\u044f\u043d\u0456\u0456, \u0434\u0437\u0435 \u0446\u044f\u043f\u0435\u0440 \u0443\u0437\u043d\u0456\u043a\u0430\u044e\u0446\u044c \u043a\u0432\u0456\u0442\u043d\u0435\u044e\u0447\u044b\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u044b, \u044f\u043a\u0456\u044f \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u041f\u044f\u0442\u0440\u0430 \u0456 \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u044c \u044f\u0433\u043e \u0441\u0432\u0430\u0456\u043c \u043f\u0435\u0440\u0448\u044b\u043c \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 10, 2; \u0414\u0437 1, 8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0416\u043d\u0456\u0432\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u0430 \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043c\u0430\u043b\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u0435 \u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0436\u043d\u0456\u0432\u0430, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u0430\u045e \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043d\u0430 \u0436\u043d\u0456\u0432\u043e \u0441\u0432\u0430\u0451, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u043c\u0435\u0446\u0435 \u043c\u043e\u0446 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u043d\u0430 \u0432\u0430\u0441 \u0441\u044b\u0434\u0437\u0435, \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u0430\u0456\u043c\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456 \u0430\u0436\u043d\u043e \u0434\u0430 \u043a\u0440\u0430\u044e \u0437\u044f\u043c\u043b\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u0435<span style=\"text-align: justify;\">\u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0436\u043d\u0456\u0432\u0430, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u0430\u045e \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043d\u0430 \u0436\u043d\u0456\u0432\u043e \u0441\u0432\u0430\u0451, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"729","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u0435 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0414\u0437\u0435\u0432\u0435&raquo; \u0441\u0432. \u041b\u044e\u0434\u0432\u0456\u043a\u0430 \u041c. \u0413\u0440\u044b\u043d\u044c\u0451\u043d\u0430 \u0434\u044d \u041c\u0430\u043d\u0444\u043e\u0440\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(nn. 120-121. 125-126: &OElig;vres completes, Seuil, Paris 1966, pp. 562-563. 566-567)<\/span><br \/><span style=\"color: #ff0000;\">\u0426\u0430\u043b\u043a\u0430\u043c \u043d\u0430\u043b\u0435\u0436\u0443 \u0442\u0430\u0431\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044f\u0440\u0448\u044b\u043d\u044f \u043d\u0430\u0448\u0430\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u043c\u044b, \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0435\u043d\u044b\u044f \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u0406\u043c \u0441\u0442\u0430\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b\u043c\u0456. \u0422\u0430\u043c\u0443, \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u043d\u0430\u0439\u0432\u044f\u043b\u0456\u043a\u0448\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u044f \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u0435 \u043d\u0430\u0441 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u0434\u043d\u0430\u0435 \u0437 I\u043c \u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u0435. \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u044f \u041c\u0430\u0440\u044b\u044f \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0431\u044b\u043b\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0439 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u0430\u043c\u0443 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0456\u043d\u0448\u044b\u043c\u0456 \u0444\u043e\u0440\u043c\u0430\u043c\u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u044f\u043a\u0456\u044f \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u044c \u0434\u0443\u0448\u0443 \u0432\u0435\u0440\u043d\u0456\u043a\u0430 \u0456 \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u044e\u0446\u044c \u044f\u0435 \u0434\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430, \u0451\u0441\u0446\u044c \u0448\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0414\u0437\u0435\u0432\u044b, \u041c\u0430\u0446\u0456 \u042f\u0433\u043e\u043d\u0430\u0439. \u0406 \u0447\u044b\u043c \u0433\u043b\u044b\u0431\u0435\u0439 \u0434\u0443\u0448\u0430 \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0435 \u0441\u044f\u0431\u0435 \u041c\u0430\u0440\u044b\u0456, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u044f\u043d\u0430 \u0430\u0441\u0432\u044f\u0447\u0430\u0435\u0446\u0446\u0430 \u0415\u0437\u0443\u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0441\u044f\u0431\u0435 \u0415\u0437\u0443\u0441\u0443 \u0425\u0440\u044b\u0441\u0442\u0443 &ndash; \u0433\u044d\u0442\u0430 \u043d\u0435 \u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u044f\u043a \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0435 \u0456 \u043f\u043e\u045e\u043d\u0430\u0435 \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0441\u044f\u0431\u0435 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0414\u0437\u0435\u0432\u0435, \u0456 \u043f\u0440\u0430 \u0442\u0430\u043a\u043e\u0435 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u0435 \u044f \u043d\u0430\u0432\u0443\u0447\u0430\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0443\u044e \u0444\u043e\u0440\u043c\u0443 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u043d\u0430\u0439\u043b\u0435\u043f\u0448 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0437\u0432\u0430\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u045e \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0445\u0440\u043e\u0441\u0442\u0443. \u0423 \u0433\u044d\u0442\u0430\u0439 \u0444\u043e\u0440\u043c\u0435 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u043d\u0456\u043a \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0434\u0434\u0430\u0435 \u0441\u044f\u0431\u0435 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u041c\u0430\u0440\u044b\u0456, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u041c\u0430\u0440\u044b\u044e \u0446\u0430\u043b\u043a\u0430\u043c \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0435 \u0441\u044f\u0431\u0435 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u041c\u0430\u0440\u044b\u0456, \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0435 \u0441\u044f\u0431\u0435 \u0456 \u0415\u0437\u0443\u0441\u0443 \u0425\u0440\u044b\u0441\u0442\u0443: \u0414\u0437\u0435\u0432\u0435 \u041c\u0430\u0440\u044b\u0456 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u042f\u043d\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043d\u0430\u0439\u0437\u0440\u0443\u0447\u043d\u0435\u0439\u0448\u044b \u0448\u043b\u044f\u0445, \u044f\u043a\u0456 \u0441\u0430\u043c \u0415\u0437\u0443\u0441 \u0430\u0431\u0440\u0430\u045e \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u044f\u0434\u043d\u0430\u0446\u0446\u0430 \u0437 \u043d\u0430\u043c\u0456 \u0456 \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u0446\u044c \u043d\u0430\u0441 \u0437 \u0441\u0430\u0431\u043e\u044e. \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u043d\u0430\u0448 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c \u0456 \u0411\u043e\u0433, \u0456 \u045e \u0406\u043c &ndash; \u043d\u0430\u0448\u0430 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u044f \u043c\u044d\u0442\u0430 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0448\u043b\u044f\u0445\u0443, \u0442\u0430\u043c\u0443 \u045e\u0441\u0451, \u0447\u044b\u043c \u043c\u044b \u0451\u0441\u0446\u044c, \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u042f\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0442\u0440\u044d\u0431\u0430 \u0437\u0430\u0434\u0443\u043c\u0430\u0446\u0446\u0430 \u043d\u0430\u0434 \u0442\u044b\u043c, \u0448\u0442\u043e \u043f\u0430\u0434\u0447\u0430\u0441 \u0445\u0440\u043e\u0441\u0442\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u043b\u0430\u0441\u043d\u044b\u043c\u0456 \u0446\u0456 \u0431\u0430\u0446\u044c\u043a\u0430\u0432\u044b\u043c\u0456 \u0430\u0431\u043e \u043c\u0430\u0442\u0447\u044b\u043d\u044b\u043c\u0456 \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u0432\u044b\u0440\u0430\u043a\u0430\u0435\u0446\u0446\u0430 \u0441\u0430\u0442\u0430\u043d\u044b, \u044f\u0433\u043e\u043d\u044b\u0445 \u0441\u043f\u0430\u043a\u0443\u0441\u0430\u045e \u0456 \u0441\u043f\u0440\u0430\u045e, \u0456 \u0430\u0431\u0456\u0440\u0430\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0441\u0432\u0430\u0456\u043c \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c, \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u041f\u0430\u043d\u0430\u043c, \u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u042f\u043c\u0443 \u044f\u043a \u0441\u043b\u0443\u0433\u0430. \u041d\u0430\u0441\u0430\u043c\u0440\u044d\u0447, \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0456 \u045e \u0433\u044d\u0442\u0430\u0439 \u0444\u043e\u0440\u043c\u0435 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u044f: \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d \u0432\u044b\u0440\u0430\u043a\u0430\u0435\u0446\u0446\u0430 \u0437\u043b\u043e\u0433\u0430 \u0434\u0443\u0445\u0430, \u0441\u0432\u0435\u0442\u0443, \u0433\u0440\u0430\u0445\u0443 \u0456 \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430, \u0430 \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0434\u0434\u0430\u0435 \u0441\u044f\u0431\u0435 \u0415\u0437\u0443\u0441\u0443 \u0425\u0440\u044b\u0441\u0442\u0443 \u043f\u0440\u0430\u0437 \u0440\u0443\u043a\u0456 \u041c\u0430\u0440\u044b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0447\u0430\u0441 \u0445\u0440\u043e\u0441\u0442\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0445\u043e\u0446\u044c \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430 \u043d\u0435 \u0430\u0434\u0434\u0430\u0435 \u0441\u044f\u0431\u0435 \u0415\u0437\u0443\u0441\u0443 \u0425\u0440\u044b\u0441\u0442\u0443 \u043f\u0440\u0430\u0437 \u0440\u0443\u043a\u0456 \u041c\u0430\u0440\u044b\u0456 \u0456 \u043d\u0435 \u0441\u043a\u043b\u0430\u0434\u0430\u0435 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0437\u0430\u0441\u043b\u0443\u0433\u0456 \u0441\u0432\u0430\u0456\u0445 \u0434\u043e\u0431\u0440\u044b\u0445 \u0441\u043f\u0440\u0430\u045e, \u0430\u0434\u043d\u0430\u043a \u043f\u0430\u0441\u043b\u044f \u0445\u0440\u043e\u0441\u0442\u0443 \u0446\u0430\u043b\u043a\u0430\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430 \u043c\u043e\u0436\u0430 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c, \u0431\u043e \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0443\u044e \u0444\u043e\u0440\u043c\u0443 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u043d\u0456\u043a \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0430\u0434\u0434\u0430\u0435 \u0441\u044f\u0431\u0435 \u043d\u0430\u0448\u0430\u043c\u0443 \u041f\u0430\u043d\u0443 \u043f\u0440\u0430\u0437 \u0440\u0443\u043a\u0456 \u041c\u0430\u0440\u044b\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u042f\u043c\u0443 \u0446\u0430\u043b\u043a\u0430\u043c \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0435 \u043c\u043e\u0446 \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 116 (115), 16-18<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d\u0435, \u044f \u0422\u0432\u043e\u0439 \u0441\u043b\u0443\u0433\u0430, \u0441\u044b\u043d \u0441\u043b\u0443\u0433\u0456 \u0422\u0432\u0430\u0451\u0439. <span style=\"color: #ff0000;\">*<\/span> \u042f \u043f\u0440\u044b\u043d\u044f\u0441\u0443 \u0422\u0430\u0431\u0435 \u0430\u0445\u0432\u044f\u0440\u0443 \u0445\u0432\u0430\u043b\u044b. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b\u043a\u0430\u043d\u0430\u044e \u0441\u0432\u0430\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456 \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c \u042f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043f\u0440\u044b\u043d\u044f\u0441\u0443<span style=\"text-align: justify;\">\u0422\u0430\u0431\u0435 \u0430\u0445\u0432\u044f\u0440\u0443 \u0445\u0432\u0430\u043b\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"730","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u044b\u044f\u043b\u043e\u0433 &laquo;\u041f\u0440\u0430 \u0411\u043e\u0436\u044b \u041f\u0440\u043e\u0432\u0456\u0434&raquo; \u0441\u0432. \u041a\u0430\u0446\u044f\u0440\u044b\u043d\u044b \u0421\u0456\u0435\u043d\u0441\u043a\u0430\u0439<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 167, Gratiarum actio ad Trinitatem: ed. lat., Ingolstadii 1583, f. 290v-291)<\/span><br \/><span style=\"color: #ff0000;\">\u042f \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u043b\u0430 \u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0432\u0435\u0447\u043d\u0430\u0435 \u0411\u043e\u0441\u0442\u0432\u0430, \u043e \u0432\u0435\u0447\u043d\u0430\u044f \u0422\u0440\u043e\u0439\u0446\u0430, \u0422\u044b \u045e\u0447\u044b\u043d\u0456\u043b\u0430, \u0448\u0442\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u044e \u0437 \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u0430\u0439 \u043a\u0440\u043e\u045e \u0422\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u043d\u0430\u0431\u044b\u043b\u0430 \u0442\u0430\u043a\u0443\u044e \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044c! \u0422\u044b, \u0432\u0435\u0447\u043d\u0430\u044f \u0422\u0440\u043e\u0439\u0446\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0435 \u043c\u043e\u0440\u0430, \u0456 \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u044f \u0448\u0443\u043a\u0430\u044e \u045e \u0456\u043c, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0443, \u0430 \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0443, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0448\u0443\u043a\u0430\u044e \u0426\u044f\u0431\u0435. \u0422\u044b \u043d\u0435\u0439\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043d\u0435\u043d\u0430\u0441\u044b\u0447\u0430\u043b\u044c\u043d\u0430 \u043d\u0430\u0441\u044b\u0447\u0430\u0435\u0448 \u0434\u0443\u0448\u0443; \u0443 \u0441\u0432\u0430\u0451\u0439 \u0431\u044f\u0437\u0434\u043e\u043d\u043d\u0430\u0441\u0446\u0456 \u0422\u044b \u0442\u0430\u043a \u043d\u0430\u0441\u044b\u0447\u0430\u0435\u0448 \u0434\u0443\u0448\u0443, \u0448\u0442\u043e \u044f\u043d\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u0430\u0433\u043d\u0435 \u0426\u044f\u0431\u0435, \u0432\u0435\u0447\u043d\u0430\u044f \u0422\u0440\u043e\u0439\u0446\u0430, \u0456 \u0433\u043e\u0440\u0430\u0447\u0430 \u0436\u0430\u0434\u0430\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0426\u044f\u0431\u0435, \u0421\u0432\u044f\u0442\u043b\u043e, \u0443 \u0422\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u043b\u0430 \u0456 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0440\u043e\u0437\u0443\u043c\u0443 \u045e\u0431\u0430\u0447\u044b\u043b\u0430 \u045e \u0422\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u0435 \u0422\u0432\u0430\u044e \u0431\u044f\u0437\u0434\u043e\u043d\u043d\u0443\u044e \u0433\u043b\u044b\u0431\u0456\u043d\u044e, \u0432\u0435\u0447\u043d\u0430\u044f \u0422\u0440\u043e\u0439\u0446\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0422\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f. \u0410 \u0442\u0430\u043c\u0443, \u0430\u043f\u0440\u0430\u043d\u0430\u044e\u0447\u044b\u0441\u044f \u045e \u0426\u044f\u0431\u0435, \u044f \u045e\u0431\u0430\u0447\u044b\u043b\u0430, \u0448\u0442\u043e \u044f &ndash; \u0433\u044d\u0442\u0430 \u0422\u0432\u043e\u0439 \u0432\u043e\u0431\u0440\u0430\u0437. \u0411\u043e \u0422\u044b \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u045e\u0441\u044f \u0441\u0430 \u043c\u043d\u043e\u0439 \u0441\u0432\u0430\u0451\u044e \u043c\u043e\u0446\u0430\u044e, \u0432\u0435\u0447\u043d\u044b \u041e\u0439\u0447\u0430, \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e, \u044f\u043a\u043e\u044e \u0451\u0441\u0446\u044c \u0422\u0432\u043e\u0439 \u0421\u044b\u043d. \u0410 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u044f\u043a\u0456 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0426\u044f\u0431\u0435, \u0410\u0439\u0446\u0430, \u0456 \u0430\u0434 \u0421\u044b\u043d\u0430, \u0434\u0430\u045e \u043c\u043d\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u043b\u044e\u0431\u0456\u0446\u044c \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u0447\u043d\u0430\u044f \u0422\u0440\u043e\u0439\u0446\u0430, \u0422\u044b &ndash; \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c, \u0430 \u044f &ndash; \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435. \u0423 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0456, \u044f\u043a\u043e\u0435 \u0422\u044b \u045e\u0447\u044b\u043d\u0456\u043b\u0430 \u045e\u0432\u0430 \u043c\u043d\u0435 \u043f\u0440\u0430\u0437 \u043a\u0440\u043e\u045e \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u044f \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u045e \u0422\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u0435, \u0448\u0442\u043e \u0422\u044b \u0437\u0430\u043a\u0430\u0445\u0430\u043b\u0430\u0441\u044f \u045e \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0431\u0435\u0437\u0434\u0430\u043d\u044c, \u043e \u0432\u0435\u0447\u043d\u0430\u044f \u0422\u0440\u043e\u0439\u0446\u0430, \u043e \u0411\u043e\u0441\u0442\u0432\u0430, \u043e \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0435 \u043c\u043e\u0440\u0430! \u0428\u0442\u043e \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0430\u0434 \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0439 \u0422\u044b \u043c\u0430\u0433\u043b\u0430 \u043c\u043d\u0435 \u0434\u0430\u0446\u044c? \u0422\u044b \u0430\u0433\u043e\u043d\u044c, \u044f\u043a\u0456 \u0437\u0430\u045e\u0436\u0434\u044b \u043f\u0430\u043b\u0430\u0435 \u0456 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0433\u0430\u0441\u043d\u0435. \u0422\u044b \u0430\u0433\u043e\u043d\u044c, \u044f\u043a\u0456 \u0441\u043f\u0430\u043b\u044c\u0432\u0430\u0435 \u0441\u0432\u0430\u0456\u043c \u0436\u0430\u0440\u0430\u043c \u0443\u0441\u044f\u043a\u0443\u044e \u045e\u043b\u0430\u0441\u043d\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0443\u0448\u044b. \u0417\u043d\u043e\u045e \u0436\u0430, \u0422\u044b \u0430\u0433\u043e\u043d\u044c, \u044f\u043a\u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u045e\u0441\u044f\u043a\u0443\u044e \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u0430\u0441\u0446\u044c \u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0440\u043e\u0437\u0443\u043c\u044b \u0441\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c. \u0423 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u0435 \u0422\u044b \u0434\u0430\u045e \u043c\u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u045e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0437\u0437\u044f\u043d\u043d\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430 \u044f \u043f\u0430\u0437\u043d\u0430\u044e \u0426\u044f\u0431\u0435, \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0435 \u0434\u0430\u0431\u0440\u043e, \u0434\u0430\u0431\u0440\u043e \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0451 \u0434\u0430\u0431\u0440\u043e, \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0435, \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u0430\u0435, \u0431\u044f\u0441\u0446\u044d\u043d\u043d\u0430\u0435 \u0434\u0430\u0431\u0440\u043e, \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u044f\u043a\u0443\u044e \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c, \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u044f\u043a\u0443\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0431\u043e \u0422\u044b \u0456 \u0451\u0441\u0446\u044c \u0441\u0430\u043c\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0422\u044b \u0445\u043b\u0435\u0431 \u0430\u043d\u0451\u043b\u0430\u045e, \u044f\u043a\u0456 \u0437 \u0430\u0433\u043d\u0451\u043c \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u043b\u044e\u0434\u0437\u044f\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0430\u0434\u0437\u0435\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0440\u044b\u043a\u0440\u044b\u0432\u0430\u0435 \u043c\u0430\u044e \u0433\u0430\u043b\u0435\u0447\u0443. \u0422\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a, \u044f\u043a\u0456 \u043d\u0430\u0441\u044b\u0447\u0430\u0435 \u043d\u0430\u0441, \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u0445, \u0441\u043b\u043e\u0434\u044b\u0447\u0447\u0443 \u0441\u0432\u0430\u0451\u0439 \u0431\u0435\u0437 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0434\u0430\u043c\u0435\u0448\u043a\u0443 \u0433\u043e\u0440\u044b\u0447\u044b. \u041e \u0432\u0435\u0447\u043d\u0430\u044f \u0422\u0440\u043e\u0439\u0446\u0430!<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u043a\u0440\u044b\u0439 \u043c\u043d\u0435, \u043c\u0430\u044f \u0441\u044f\u0441\u0442\u0440\u0430, \u044f\u043a\u0430\u044f \u0441\u0442\u0430\u043b\u0430 \u0441\u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u0446\u0430\u0439 \u043c\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0441\u044f\u0431\u0440\u043e\u045e\u043a\u0430 \u043c\u0430\u044f, \u044f\u043a\u0430\u044f \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u043c\u0430\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0423\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u043d\u0430\u044f \u0434\u0430\u0440\u0430\u043c \u043c\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430, \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u0430\u044f \u043c\u0430\u0451\u044e \u043a\u0440\u044b\u0432\u0451\u0439 \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0439 \u0437\u0430\u0433\u0430\u043d\u044b, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b\u0439\u0434\u0437\u0456 \u0441\u0430 \u0441\u043f\u0430\u043a\u043e\u044e \u043a\u0430\u043d\u0442\u044d\u043c\u043f\u043b\u044f\u0446\u044b\u0456 \u0456 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0434\u0430\u0432\u0430\u0439 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043c\u0430\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u043d\u0430\u044f<span style=\"text-align: justify;\">\u0434\u0430\u0440\u0430\u043c \u043c\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430, \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u0430\u044f \u043c\u0430\u0451\u044e \u043a\u0440\u044b\u0432\u0451\u0439 \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0439 \u0437\u0430\u0433\u0430\u043d\u044b, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"731","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 124, 5: CCL 36, 684-685)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0430\u0441\u0446\u0451\u043b \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u0421\u043a\u0430\u043b\u0435, \u044f\u043a\u0443\u044e \u0432\u044b\u0437\u043d\u0430\u045e \u041f\u0451\u0442\u0440<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043a\u0440\u0430\u043c\u044f \u0456\u043d\u0448\u044b\u0445 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f\u045e, \u044f\u043a\u0456\u044f \u0411\u043e\u0433 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u043c\u0443 \u0440\u043e\u0434\u0443, \u043a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0447\u0430\u0441\u0443, \u043f\u0440\u0430\u0434\u0443\u0433\u043b\u0435\u0434\u0436\u0430\u043d\u0430\u044f \u0406\u043c \u0441\u0430\u043c\u0456\u043c, \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0451, \u043a\u0430\u0431, \u0437\u0430\u0441\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u043e\u0439, \u0411\u043e\u0433 \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0456 \u0431\u044b\u045e &laquo;\u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u043c \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456: \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441&raquo; (1 \u0426\u0456\u043c 2, 5).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f, \u0445\u0442\u043e \u045e \u042f\u0433\u043e \u0432\u0435\u0440\u044b\u0446\u044c, \u043f\u0440\u0430\u0437 \u043a\u0443\u043f\u0435\u043b\u044c \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u044e\u0446\u0446\u0430 \u0430\u0434 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u044f, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u0443 \u0432\u0435\u0440\u044b, \u043d\u0430\u0434\u0437\u0435\u0456 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456, \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u044e\u0447\u044b \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435 \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0436\u043a\u0456\u0445 \u0456 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b\u0445 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e. \u0417\u0430\u0430\u0445\u0432\u043e\u0447\u0430\u043d\u044b\u044f \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439 \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0430\u0439 \u0411\u043e\u0433\u0430, \u044f\u043d\u044b \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b\u0441\u044f \u0434\u0430\u0440\u043e\u0433\u0456, \u044f\u043a\u043e\u0439 \u0434\u043b\u044f \u0456\u0445 \u0441\u0442\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456, \u043d\u0430\u0432\u0430\u0442 \u0456\u0434\u0443\u0447\u044b \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u044f\u043d\u044b \u043d\u0435 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0433\u0440\u0430\u0445\u043e\u045e, \u044f\u043a\u0456\u044f \u043f\u0430\u0434\u043a\u0440\u0430\u0434\u0430\u044e\u0446\u0446\u0430 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0456\u0445 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456, \u0411\u043e\u0433 \u0434\u0430\u045e \u0456\u043c \u0437\u0431\u0430\u045e\u0447\u044b \u043b\u0435\u043a \u0443 \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u044b, \u043a\u0430\u0431 \u044f\u043d\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0430 \u0456\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u0456\u0445 \u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u0430\u0434\u043f\u0443\u0441\u0446\u0456 \u043d\u0430\u043c \u043f\u0440\u0430\u0432\u0456\u043d\u044b \u043d\u0430\u0448\u044b, \u044f\u043a \u0456 \u043c\u044b \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0435\u043c \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b\u043c \u043d\u0430\u0448\u044b\u043c&raquo; (\u041c\u0446 6, 12).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0440\u043e\u0431\u0456\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b, \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b \u0441\u0432\u044f\u0442\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0443 \u0433\u044d\u0442\u044b\u043c \u0446\u044f\u0436\u043a\u0456\u043c \u0436\u044b\u0446\u0446\u0456. \u0410 \u045e\u0432\u0430\u0441\u0430\u0431\u043b\u0435\u043d\u043d\u0435\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0431\u044b\u045e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0439\u043c\u0443 \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u0443 \u0441\u044f\u0440\u043e\u0434 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0441\u0432\u044f\u0442\u044b \u041f\u0451\u0442\u0440.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u044f\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u0430, \u0434\u044b\u043a \u043f\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0451\u043d \u0431\u044b\u045e \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0437 \u043b\u0430\u0441\u043a\u0456 &ndash; \u0430\u0434\u043d\u044b\u043c \u0437 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e, \u0437 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u043b\u0430\u0441\u043a\u0456 &ndash; \u0430\u0434\u043d\u044b\u043c \u0437 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u043f\u0435\u0440\u0448\u044b\u043c \u0437 \u0456\u0445. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u044f\u043c\u0443 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u042f \u0434\u0430\u043c \u0442\u0430\u0431\u0435 \u043a\u043b\u044e\u0447\u044b \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430, \u0456 \u0448\u0442\u043e \u0437\u0432\u044f\u0436\u0430\u0448 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0442\u043e\u0435 \u0431\u0443\u0434\u0437\u0435 \u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u045e \u043d\u0435\u0431\u0435, \u0430 \u0448\u0442\u043e \u0440\u0430\u0437\u0432\u044f\u0436\u0430\u0448 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0442\u043e\u0435 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u045e \u043d\u0435\u0431\u0435&raquo; (\u041c\u0446 16, 19), \u043c\u0435\u045e\u0441\u044f \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u045e\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435 \u0441\u0430\u0442\u0440\u0430\u0441\u0430\u044e\u0446\u044c \u0440\u043e\u0437\u043d\u044b\u044f \u0441\u043f\u0430\u043a\u0443\u0441\u044b, \u0431\u044b\u0446\u0446\u0430\u043c \u043d\u0430\u0432\u0430\u043b\u044c\u043d\u0456\u0446\u044b, \u043f\u0430\u0442\u043e\u043f\u044b \u0456 \u0431\u0443\u0440\u044b. \u0410\u043b\u0435 \u0451\u043d \u043d\u0435 \u043f\u0430\u0434\u0430\u0435, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u0421\u043a\u0430\u043b\u0435, \u0430\u0434 \u044f\u043a\u043e\u0439 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0456\u043c\u044f \u041f\u0451\u0442\u0440.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u041f\u0451\u0442\u0440 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0422\u044b &ndash; \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0421\u044b\u043d \u0411\u043e\u0433\u0430 \u0416\u044b\u0432\u043e\u0433\u0430&raquo; (\u041c\u0446 16, 16), \u041f\u0430\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0441\u043a\u0430\u043b\u0435 \u042f \u043f\u0430\u0431\u0443\u0434\u0443\u044e \u041a\u0430\u0441\u0446\u0451\u043b \u041c\u043e\u0439&raquo; (\u041c\u0446 16, 18). &laquo;\u041d\u0430 \u0442\u043e\u0439 \u0441\u043a\u0430\u043b\u0435, &ndash; \u043a\u0430\u0436\u0430 \u0415\u0437\u0443\u0441, &ndash; \u044f\u043a\u0443\u044e \u0442\u044b \u0432\u044b\u0437\u043d\u0430\u045e, \u042f \u043f\u0430\u0431\u0443\u0434\u0443\u044e \u041a\u0430\u0441\u0446\u0451\u043b \u041c\u043e\u0439&raquo;. &laquo;\u0421\u043a\u0430\u043b\u043e\u044e \u0431\u044b\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441&raquo;, \u0456 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443 \u0431\u044b\u045e \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u041f\u0451\u0442\u0440. &laquo;\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0430\u043a\u043b\u0430\u0441\u0446\u0456 \u0456\u043d\u0448\u0430\u0433\u0430 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443, \u0430\u043a\u0440\u0430\u043c\u044f \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441&raquo; (1 \u041a\u0430\u0440 3, 11).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u041a\u0430\u0441\u0446\u0451\u043b, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u044b \u043d\u0430 \u0425\u0440\u044b\u0441\u0446\u0435, \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0434 \u042f\u0433\u043e \u045e \u0430\u0441\u043e\u0431\u0435 \u041f\u044f\u0442\u0440\u0430 \u043a\u043b\u044e\u0447\u044b \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430, \u0433. \u0437\u043d. \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0437\u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0456 \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0446\u044c \u0433\u0440\u0430\u0445\u0456. \u0422\u0430\u043c\u0443 \u0433\u044d\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u043b\u044e\u0431\u044f\u0447\u044b \u0456 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0447\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434 \u0437\u043b\u043e\u0433\u0430. \u0406 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u042f\u0433\u043e \u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043f\u0440\u0430\u045e\u0434\u0443 \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0437\u0445 3, 21; 1 \u0426\u0456\u043c 4, 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0442\u044b \u0430\u0441\u0446\u0435\u0440\u0430\u0436\u044d\u0448 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430, \u043a\u0430\u0431 \u0451\u043d \u043d\u0435 \u0433\u0440\u0430\u0448\u044b\u045e, \u0456 \u0451\u043d \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u0446\u044c, <span style=\"color: #ff0000;\">*<\/span> \u0442\u043e \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c, \u0431\u043e \u0442\u044b \u0430\u0441\u0446\u044f\u0440\u043e\u0433 \u044f\u0433\u043e, \u0456 \u0442\u044b \u0441\u0430\u043c \u0443\u0440\u0430\u0442\u0443\u0435\u0448 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u0432\u0430\u0436\u0430\u0439 \u043d\u0430 \u0441\u044f\u0431\u0435 \u0456 \u043d\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u0435, \u0442\u0440\u044b\u0432\u0430\u0439 \u0443 \u0433\u044d\u0442\u044b\u043c, \u0431\u043e, \u0440\u043e\u0431\u044f\u0447\u044b \u0442\u0430\u043a, \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0437\u0431\u0430\u0432\u0456\u0448 \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0446\u044f\u0431\u0435 \u0441\u043b\u0443\u0445\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u043e \u043d\u0430\u043f\u044d\u045e\u043d\u0430<span style=\"text-align: justify;\">\u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c, \u0431\u043e \u0442\u044b \u0430\u0441\u0446\u044f\u0440\u043e\u0433 \u044f\u0433\u043e, \u0456 \u0442\u044b \u0441\u0430\u043c \u0443\u0440\u0430\u0442\u0443\u0435\u0448 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"732","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u043c \u0441\u0432\u0435\u0446\u0435 &laquo;Gaudium et spes&raquo;\u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 33-34)<\/span><br \/><span style=\"color: #ff0000;\">\u0410\u043a\u0442\u044b\u045e\u043d\u0430\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0456\u043c\u043a\u043d\u0443\u045e\u0441\u044f \u043f\u0430\u043b\u044f\u043f\u0448\u0430\u0446\u044c \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0446\u0430\u0439 \u0456 \u0442\u0430\u043b\u0435\u043d\u0442\u0430\u043c. \u0410\u0434\u043d\u0430\u043a \u0441\u0451\u043d\u043d\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0431\u0430\u0433\u0430\u0442\u044b\u043c \u0432\u0435\u0434\u0430\u043c \u0456 \u0442\u044d\u0445\u043d\u0456\u0446\u044b \u0451\u043d \u043f\u0430\u0448\u044b\u0440\u044b\u045e \u0441\u0432\u0430\u0451 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u043f\u0430\u0448\u044b\u0440\u0430\u0435 \u044f\u0433\u043e \u0430\u043c\u0430\u043b\u044c \u043d\u0430 \u045e\u0441\u044e \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c. \u0422\u0430\u043a, \u043f\u0435\u0440\u0430\u0432\u0430\u0436\u043d\u0430 \u043f\u0440\u0430\u0437 \u043f\u0430\u0432\u0435\u043b\u0456\u0447\u044d\u043d\u043d\u0435 \u0441\u043f\u043e\u0441\u0430\u0431\u0430\u045e \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0430\u0433\u0430 \u043a\u0430\u043d\u0442\u0430\u043a\u0442\u0443 \u043f\u0430\u043c\u0456\u0436 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u0441\u044f\u043c&rsquo;\u044f \u043f\u0430\u0441\u0442\u0443\u043f\u043e\u0432\u0430 \u045e\u0441\u0432\u044f\u0434\u043e\u043c\u0456\u043b\u0430 \u0456 \u045e\u0442\u0432\u0430\u0440\u044b\u043b\u0430 \u0430\u0434\u0437\u0456\u043d\u0443\u044e \u0441\u0443\u0441\u0432\u0435\u0442\u043d\u0443\u044e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u0436\u043e \u045e\u043b\u0430\u0441\u043d\u0430\u044e \u043f\u0440\u0430\u0446\u0430\u044e \u0441\u0442\u0432\u0430\u0440\u0430\u0435 \u0448\u043c\u0430\u0442 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u044f\u043a\u0456\u0445 \u0440\u0430\u043d\u0435\u0439 \u0447\u0430\u043a\u0430\u045e \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0430\u0434 \u0432\u044b\u0448\u044d\u0439\u0448\u044b\u0445 \u0441\u0456\u043b\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0430\u0434 \u0442\u0430\u043a\u0456\u043c \u0432\u044f\u043b\u0456\u0437\u043d\u044b\u043c \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0435\u043c, \u044f\u043a\u043e\u0435 \u045e\u0436\u043e \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u045e\u0432\u0435\u0441\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0440\u043e\u0434, \u0443 \u043b\u044e\u0434\u0437\u0435\u0439 \u0443\u0437\u043d\u0456\u043a\u0430\u044e\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u044f \u043f\u044b\u0442\u0430\u043d\u043d\u0456. \u042f\u043a\u0456 \u0441\u044d\u043d\u0441 \u0456 \u0432\u0430\u0440\u0442\u0430\u0441\u0446\u044c \u0433\u044d\u0442\u044b\u0445 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e? \u042f\u043a \u0442\u0440\u044d\u0431\u0430 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0446\u044c \u0443\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0440\u044d\u0447\u044b? \u0414\u0430 \u044f\u043a\u043e\u0439 \u043c\u044d\u0442\u044b \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u045e\u0441\u0451\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456? \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a\u0456 \u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u043a\u0430\u0440\u0431 \u0411\u043e\u0436\u0430\u0433\u0430 \u0441\u043b\u043e\u0432\u0430, \u0437 \u044f\u043a\u043e\u0433\u0430 \u0447\u044d\u0440\u043f\u0430\u0435 \u043f\u0440\u044b\u043d\u0446\u044b\u043f\u044b \u0440\u044d\u043b\u0456\u0433\u0456\u0439\u043d\u0430\u0433\u0430 \u0456 \u043c\u0430\u0440\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u043f\u0430\u0440\u0430\u0434\u043a\u0443, \u043d\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u0430\u0435 \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u0430\u0434\u043a\u0430\u0437\u044b \u043d\u0430 \u0430\u0441\u043e\u0431\u043d\u044b\u044f \u043f\u044b\u0442\u0430\u043d\u043d\u0456, \u0442\u0430\u043c\u0443 \u0436\u0430\u0434\u0430\u0435 \u0441\u043f\u0430\u043b\u0443\u0447\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0437 \u0434\u043e\u0441\u0432\u0435\u0434\u0430\u043c \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u0430\u0431 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0446\u044c \u0448\u043b\u044f\u0445, \u043d\u0430 \u044f\u043a\u0456 \u043d\u044f\u0434\u0430\u045e\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u0440\u0443\u044e\u0447\u044b\u044f \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b\u044f \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0456\u043d\u0434\u044b\u0432\u0456\u0434\u0443\u0430\u043b\u044c\u043d\u0430\u044f \u0456 \u043a\u0430\u043b\u0435\u043a\u0442\u044b\u045e\u043d\u0430\u044f \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u044b\u044f \u0432\u044f\u043b\u0456\u0437\u043d\u044b\u044f \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u044f\u043a\u0456\u044f \u043b\u044e\u0434\u0437\u0456 \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0432\u044f\u043a\u043e\u045e \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u044e\u0446\u044c \u0434\u043b\u044f \u043f\u0430\u043b\u044f\u043f\u0448\u044d\u043d\u043d\u044f \u045e\u043c\u043e\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f, \u0441\u0430\u043c\u0456 \u043f\u0430 \u0441\u0430\u0431\u0435 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u044e\u0446\u044c \u0411\u043e\u0436\u0430\u043c\u0443 \u043f\u043b\u0430\u043d\u0443. \u0411\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430, \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043d\u0430\u043a\u0430\u0437 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u0435\u0442\u0430\u043c \u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0441\u0430\u0431\u0435 \u0437\u044f\u043c\u043b\u044e \u0437 \u0443\u0441\u0456\u043c, \u0448\u0442\u043e \u043d\u0430 \u0451\u0439 \u0451\u0441\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043f\u0440\u044b\u0437\u043d\u0430\u044e\u0447\u044b \u0411\u043e\u0433\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c \u0443\u0441\u044f\u0433\u043e, \u0441\u0443\u0430\u0434\u043d\u043e\u0441\u0456\u0446\u044c \u0437 \u0406\u043c \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0456 \u045e\u0441\u0435 \u0440\u044d\u0447\u044b, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u045e\u0441\u044f\u0433\u043e, \u0411\u043e\u0436\u0430\u0435 \u0456\u043c\u044f \u0431\u044b\u043b\u043e \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u0445 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u045e. \u041c\u0443\u0436\u0447\u044b\u043d\u044b \u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u044f\u043a\u0456\u044f, \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u044e\u0447\u044b \u0441\u0440\u043e\u0434\u043a\u0456 \u043d\u0430 \u045e\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0435 \u0441\u0432\u0430\u0451 \u0456 \u0441\u0432\u0430\u0456\u0445 \u0441\u044f\u043c\u0435\u0439, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u0446\u0443 \u0442\u0430\u043a, \u043a\u0430\u0431 \u043d\u0430\u043b\u0435\u0436\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u0442\u0432\u0443, \u043c\u043e\u0433\u0443\u0446\u044c \u0441\u043b\u0443\u0448\u043d\u0430 \u043b\u0456\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0446\u0430\u0439 \u0440\u0430\u0437\u0432\u0456\u0432\u0430\u044e\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u0443 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f, \u043a\u043b\u0430\u043f\u043e\u0446\u044f\u0447\u044b\u0441\u044f \u043f\u0440\u0430 \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u0441\u0432\u0430\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0456 \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430 \u0441\u043f\u0440\u044b\u044f\u044e\u0447\u044b \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044e \u045e \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0456 \u0411\u043e\u0436\u0430\u0439 \u0437\u0430\u0434\u0443\u043c\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u043d\u0435 \u043b\u0456\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044b, \u044f\u043a\u0456\u044f \u0441\u043f\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456 \u0442\u0430\u043b\u0435\u043d\u0442\u044b \u0456 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u0430\u0446\u044c \u0411\u043e\u0436\u0430\u0439 \u043c\u043e\u0446\u044b \u0446\u0456 \u0448\u0442\u043e \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0447\u0430\u0435 \u0441\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c. \u041d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u044f\u043d\u044b \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u044b\u044f, \u0448\u0442\u043e \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u044f\u0432\u044b \u0411\u043e\u0436\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b \u0456 \u043f\u043b\u0451\u043d \u042f\u0433\u043e \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0433\u0430 \u043d\u0430\u043c\u0435\u0440\u0443. \u0410\u0434\u043d\u0430\u043a, \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0440\u0430\u0441\u0446\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c, \u0442\u044b\u043c \u0448\u044b\u0440\u044d\u0439\u0448\u0430\u0439 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0430\u0434\u043a\u0430\u0437\u043d\u0430\u0441\u0446\u044c \u0430\u0441\u043e\u0431\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044f\u045e. \u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435, \u0448\u0442\u043e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u043d\u0435 \u0430\u0434\u0432\u0430\u0440\u043e\u0447\u0432\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0430\u0434 \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443 \u0456 \u043d\u0435 \u0441\u0445\u0456\u043b\u044f\u0435 \u044f\u0433\u043e \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u043a\u043b\u043e\u043f\u0430\u0442 \u043f\u0440\u0430 \u0434\u0430\u0431\u0440\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0430\u043b\u0435 \u0445\u0443\u0442\u0447\u044d\u0439 \u0437\u0430\u0431\u0430\u0432\u044f\u0437\u0432\u0430\u0435 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0440\u0443\u043f\u043b\u0456\u0432\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u044b\u044f \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0411\u044b\u0446 2, 15<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u043d \u0411\u043e\u0433 \u0443\u0437\u044f\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u043e\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044b\u045e, \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u045e \u044f\u0433\u043e \u045e \u0441\u0430\u0434\u0437\u0435 \u042d\u0434\u044d\u043d, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0451\u043d \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e \u0456 \u0434\u0430\u0433\u043b\u044f\u0434\u0430\u045e \u044f\u0433\u043e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0430\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u0437\u0430\u0434\u0430\u043d\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0451\u043d<span style=\"text-align: justify;\">\u043f\u0440\u0430\u0446\u0430\u0432\u0430\u045e \u0456 \u0434\u0430\u0433\u043b\u044f\u0434\u0430\u045e \u044f\u0433\u043e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"734","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio de incarnatione Verbi, 8-9: PG 25, 110-11)<\/span><br \/><span style=\"color: #ff0000;\">\u0423\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0421\u043b\u043e\u0432\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0435\u0441\u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435, \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0435 \u0456 \u043d\u0435\u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u043e \u043d\u0430 \u043d\u0430\u0448\u0443 \u0437\u044f\u043c\u043b\u044e, \u0445\u043e\u0446\u044c \u0456 \u0440\u0430\u043d\u0435\u0439 \u043d\u0435 \u0431\u044b\u043b\u043e \u0434\u0430\u043b\u0451\u043a\u0430, \u0431\u043e \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u044f \u0447\u0430\u0441\u0442\u043a\u0430 \u0441\u0432\u0435\u0442\u0443 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u044b\u043b\u0430 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u0430 \u042f\u0433\u043e, \u0430\u043b\u0435, \u0456\u0441\u043d\u0443\u044e\u0447\u044b \u045e \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0410\u0439\u0446\u043e\u043c, \u042f\u043d\u043e \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u043b\u0430 \u045e\u0441\u0451 \u0456 \u0431\u044b\u043b\u043e \u043f\u0430\u045e\u0441\u044e\u043b\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0448\u043b\u043e \u045e \u0441\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456 \u0434\u0430 \u043d\u0430\u0441 \u0456 \u0430\u0434\u043a\u0440\u044b\u043b\u0430 \u0441\u044f\u0431\u0435 \u043d\u0430\u043c. \u0417\u043b\u0456\u0442\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u043d\u0430\u0434 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044e \u043d\u0430\u0448\u0430\u0433\u0430 \u0440\u043e\u0434\u0443 \u0456, \u0443\u0437\u0440\u0443\u0448\u0430\u043d\u0430\u0435 \u043d\u0430\u0448\u0430\u0439 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u044e, \u043d\u0435 \u0437\u043c\u0430\u0433\u043b\u043e \u0441\u0446\u044f\u0440\u043f\u0435\u0446\u044c \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456. \u041a\u0430\u0431 \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430, \u0456 \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u043b\u0430 \u043c\u0430\u0440\u043d\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0441\u0430\u043c\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u043e \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u043d\u0435 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u043b\u0430\u0441\u044f \u0430\u0434 \u043d\u0430\u0448\u0430\u0433\u0430. \u042f\u043d\u043e \u043d\u0435 \u0445\u0430\u0446\u0435\u043b\u0430 \u0431\u044b\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0446\u0435\u043b\u0435 \u0446\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u0446\u0430 \u043d\u0430\u043c \u0443 \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u043a\u0430\u043b\u0456 \u0431 \u0445\u0430\u0446\u0435\u043b\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u0446\u0430, \u043c\u0430\u0433\u043b\u043e \u0431 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u0446\u0435\u043b\u0430, \u0430\u0434\u043d\u0430\u043a \u043f\u0440\u044b\u043d\u044f\u043b\u043e \u043d\u0430\u0448\u0430\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0414\u0437\u0435\u0432\u0435 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0430 \u0441\u0430\u0431\u0435 \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0433. \u0437\u043d. \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0430 \u044f\u043a \u0431\u044b \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043c: \u0443 \u0456\u043c \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0456 \u0436\u044b\u043b\u043e. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e\u0441\u0435 \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u043b\u0456 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044e, \u0421\u043b\u043e\u0432\u0430 \u0430\u0434\u0434\u0430\u043b\u043e \u0446\u0435\u043b\u0430 \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u045e\u0441\u0456\u0445 \u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043b\u0430 \u044f\u0433\u043e \u0410\u0439\u0446\u0443 \u0437 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044e. \u0423 \u0432\u044b\u043d\u0456\u043a\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u045e\u0441\u0435, \u0445\u0442\u043e \u045e \u0406\u043c \u043f\u0430\u043c\u0456\u0440\u0430\u0435, \u043d\u0435 \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u044e\u0446\u044c \u0437\u0430\u043a\u043e\u043d\u0443 \u0441\u043c\u0435\u0440\u0446\u0456, \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u043c\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439. \u0413\u044d\u0442\u044b \u0437\u0430\u043a\u043e\u043d \u0432\u044b\u0447\u0430\u0440\u043f\u0430\u045e \u0441\u0432\u0430\u044e \u043c\u043e\u0446 \u0443 \u0446\u0435\u043b\u0435 \u041f\u0430\u043d\u0430 \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0446\u0446\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439, \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u0445 \u0434\u0430 \u042f\u0433\u043e. \u0421\u043b\u043e\u0432\u0430 \u0437\u043d\u043e\u045e \u0437\u0440\u0430\u0431\u0456\u043b\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c\u0456 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u043b\u0456 \u0441\u043c\u0435\u0440\u0446\u0456, \u0456 \u0437\u043d\u043e\u045e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u0456\u0445 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f. \u0417 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u044e \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u0441\u0430\u043c\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u043e, \u0456 \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u042f\u043d\u043e, \u0431\u044b\u0446\u0446\u0430\u043c \u0430\u0433\u043e\u043d\u044c, \u044f\u043a\u0456 \u0441\u043f\u0430\u043b\u044c\u0432\u0430\u0435 \u0441\u0430\u043b\u043e\u043c\u0443, \u0446\u0430\u043b\u043a\u0430\u043c \u043f\u0440\u044b\u0431\u0440\u0430\u043b\u0430 \u0430\u0434 \u0456\u0445 \u0441\u043c\u0435\u0440\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u043e\u0432\u0430 \u043f\u0440\u044b\u043d\u044f\u043b\u043e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u044f\u043d\u043e, \u0441\u0442\u0430\u045e\u0448\u044b \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u045e\u0437\u043d\u0430\u0447\u0430\u043b\u044c\u0432\u0430\u0435 \u045e\u0441\u0451, \u043c\u0430\u0433\u043b\u043e \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0437\u0430 \u045e\u0441\u0456\u0445; \u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0421\u043b\u043e\u0432\u0443, \u044f\u043a\u043e\u0435 \u0436\u044b\u0432\u0435 \u045e \u0456\u043c, \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f \u043d\u0435\u043f\u0430\u0448\u043a\u043e\u0434\u0436\u0430\u043d\u044b\u043c, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0430\u0434\u0432\u0435\u0441\u0446\u0456 \u0430\u0434 \u0443\u0441\u0456\u0445 \u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u043e\u0432\u0430 \u0430\u0434\u0434\u0430\u043b\u043e \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u0435 \u0446\u0435\u043b\u0430 \u044f\u043a \u0447\u044b\u0441\u0442\u0443\u044e \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u0437\u0430 \u045e\u0441\u0456\u0445 \u0456 \u0430\u0434\u0440\u0430\u0437\u0443 \u043f\u0440\u0430\u0433\u043d\u0430\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0430\u0434 \u0443\u0441\u0456\u0445 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u0445 \u0434\u0430 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u0451, \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0437\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u045e\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 \u0456 \u0442\u0430\u043a \u0440\u0430\u0441\u043f\u043b\u0430\u0446\u0456\u043b\u0430\u0441\u044f \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u044e \u0437\u0430 \u043d\u0430\u0448 \u0434\u043e\u045e\u0433. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0411\u043e\u0436\u044b \u0421\u044b\u043d, \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b \u0437 \u0443\u0441\u0456\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u0434\u0437\u0435\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0443\u0441\u0456\u0445 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c\u0456, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0433\u0443\u0431\u043d\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c \u0443\u0436\u043e \u043d\u0435 \u043c\u0430\u0435 \u043d\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u043d\u0456\u044f\u043a\u0430\u0439 \u0443\u043b\u0430\u0434\u044b \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0421\u043b\u043e\u0432\u0443, \u044f\u043a\u043e\u0435 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u0456\u0445 \u0443 \u043b\u044e\u0434\u0441\u043a\u0456\u043c \u0446\u0435\u043b\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0415\u0440 15, 19. 29; 2 \u041f 2, 1<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0442\u0430\u043d\u0435\u0448 \u043d\u0456\u0431\u044b \u041c\u0430\u0435 \u0432\u0443\u0441\u043d\u044b, \u0456 \u0437\u0440\u0430\u0431\u043b\u044e \u0446\u044f\u0431\u0435 \u0434\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0442\u0440\u044b\u0432\u0430\u043b\u044b\u043c \u043c\u0435\u0434\u043d\u044b\u043c \u043c\u0443\u0440\u0430\u043c. <span style=\"color: #ff0000;\">*<\/span> \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443\u0446\u044c \u0446\u044f\u0431\u0435, \u0431\u043e \u042f \u0437 \u0442\u0430\u0431\u043e\u044e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0443\u0434\u0443\u0446\u044c \u0456\u043b\u0436\u044b\u0432\u044b\u044f \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u043f\u0430\u0441\u0435\u044e\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441 \u0437\u0433\u0443\u0431\u043d\u044b\u044f \u0435\u0440\u0430\u0441\u0456; \u0456 \u044f\u043d\u044b \u0430\u0434\u0440\u0430\u043a\u0443\u0446\u0446\u0430 \u0430\u0434 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c<span style=\"text-align: justify;\">\u0432\u0430\u044f\u0432\u0430\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443\u0446\u044c \u0446\u044f\u0431\u0435, \u0431\u043e \u042f \u0437 \u0442\u0430\u0431\u043e\u044e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"735","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0410\u0431 \u0432\u0443\u0447\u044d\u043d\u043d\u0456 \u0435\u0440\u044d\u0442\u044b\u043a\u043e\u045e&raquo; \u0422\u044d\u0440\u0442\u0443\u043b\u0456\u044f\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 20, 1-9; 21, 3; 22, 8-10: CCL 1, 201-204)<\/span><br \/><span style=\"color: #ff0000;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u044f \u043f\u0440\u043e\u043f\u0430\u0432\u0435\u0434\u0437\u044c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043d\u0430\u0448 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u045e\u0441\u044f \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0401\u043d \u0441\u0430\u043c \u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0442\u043e\u0435, \u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0456 \u043a\u0456\u043c \u0431\u044b\u045e, \u044f\u043a\u043e\u0435 \u0437\u0430\u0434\u0430\u043d\u043d\u0435 \u0410\u0439\u0446\u0435\u0446 \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u042f\u043c\u0443, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0440\u0430\u0431\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0430\u0431\u043e \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u045e \u0441\u0430\u043c-\u043d\u0430\u0441\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0432\u0443\u0447\u043d\u044f\u043c, \u0441\u044f\u0440\u043e\u0434 \u044f\u043a\u0456\u0445 \u0432\u044b\u0431\u0440\u0430\u045e \u0414\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0433\u0430\u043b\u043e\u045e\u043d\u044b\u0445, \u043a\u0430\u0431 \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u043b\u0456 \u042f\u043c\u0443 \u0456 \u0441\u0442\u0430\u043b\u0456 \u043f\u043e\u0442\u044b\u043c \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0437 \u0456\u0445 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u045e\u0441\u044f, \u0415\u0437\u0443\u0441, \u0432\u044f\u0440\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0434\u0430 \u0410\u0439\u0446\u0430, \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u043c \u0410\u0434\u0437\u0456\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u0456\u0441\u0446\u0456 \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u044b, \u0445\u0440\u044b\u0441\u0446\u044f\u0447\u044b \u0456\u0445 \u0443 \u0456\u043c\u044f \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430, \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b (\u0448\u0442\u043e \u0437\u043d\u0430\u0447\u044b\u0446\u044c &laquo;\u043f\u0430\u0441\u043b\u0430\u043d\u044b\u044f&raquo;) \u0430\u0434\u0440\u0430\u0437\u0443 \u0432\u044b\u0431\u0440\u0430\u043b\u0456 \u043b\u0451\u0441\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u041c\u0430\u0446\u0432\u0435\u044f \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0442\u044b\u043c \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c \u0437\u0430\u043c\u0435\u0441\u0442 \u042e\u0434\u044b, \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b\u0441\u044f \u0430\u045e\u0442\u0430\u0440\u044b\u0442\u044d\u0442\u0443 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430, \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u0430\u0433\u0430 \u045e \u043f\u0441\u0430\u043b\u044c\u043c\u0435 \u0414\u0430\u0432\u0456\u0434\u0430. \u0410\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u0443\u044e \u043c\u043e\u0446 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e\u0434\u0437\u044f\u043b\u0456\u045e \u0456\u043c \u0434\u0430\u0440 \u0446\u0443\u0434\u0430\u0442\u0432\u043e\u0440\u0441\u0442\u0432\u0430 \u0456 \u043c\u043e\u0432\u0430\u045e. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u045e \u042e\u0434\u044d\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0432\u0435\u0440\u0443 \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0437\u0430\u0441\u043d\u043e\u045e\u0432\u0430\u043b\u0456 \u0442\u0430\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u044b. \u0410 \u043f\u043e\u0442\u044b\u043c, \u043f\u0430\u0439\u0448\u043e\u045e\u0448\u044b \u045e \u0441\u0432\u0435\u0442, \u0443\u0441\u044e\u0434\u044b \u043f\u0430\u0448\u044b\u0440\u0430\u043b\u0456 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0442\u043e\u0439 \u0436\u0430 \u0432\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043a\u043e\u0436\u043d\u044b\u043c \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0437\u0430\u0441\u043d\u043e\u045e\u0432\u0430\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u044b, \u0437 \u044f\u043a\u0456\u0445 \u043f\u0430\u0441\u043b\u044f \u0456\u043d\u0448\u044b\u044f \u0431\u0440\u0430\u043b\u0456 \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0456 \u0432\u0435\u0440\u044b \u0456 \u043d\u0430\u0441\u0435\u043d\u043d\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u044f, \u0456 \u0441\u0451\u043d\u043d\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u043e\u0431\u044f\u0446\u044c \u0433\u044d\u0442\u0430\u043a, \u043a\u0430\u0431 \u0443\u0437\u043d\u0456\u043a\u0430\u043b\u0456 \u043d\u043e\u0432\u044b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u044b. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u0456 \u0442\u044b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456\u043c\u0456 \u044f\u043a \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456\u0445 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u0443\u044e \u0440\u044d\u0447 \u0442\u0440\u044d\u0431\u0430 \u0430\u0446\u044d\u043d\u044c\u0432\u0430\u0446\u044c, \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u044f\u0435 \u0432\u044b\u0442\u043e\u043a\u0456. \u0422\u0430\u043c\u0443 \u045e\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u044b, \u0442\u0430\u043a\u0456\u044f \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0456 \u0442\u0430\u043a\u0456\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f, \u0443\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0456 \u0442\u043e\u0439 \u0436\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b, \u0437 \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0443\u0441\u0435. \u0422\u0430\u043c\u0443 \u045e\u0441\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043f\u0435\u0440\u0448\u044b\u043c\u0456 \u0456 \u045e\u0441\u0435 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456\u043c\u0456, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u045e\u0441\u0435 \u045e\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u041a\u0430\u0441\u0446\u0451\u043b. \u042f\u043d\u044b \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u044e \u0435\u0434\u043d\u0430\u0441\u0446\u044c, \u043f\u0435\u0440\u0430\u0434\u0430\u044e\u0447\u044b \u0441\u043f\u0430\u043a\u043e\u0439, \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0447\u044b \u0441\u044f\u0431\u0435 \u0431\u0440\u0430\u0442\u0430\u043c\u0456 \u0456 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u044e\u0447\u044b \u0433\u0430\u0441\u0446\u0456\u043d\u043d\u0430\u0441\u0446\u044c. \u0413\u044d\u0442\u044b\u043c\u0456 \u0437\u0430\u043a\u043e\u043d\u0430\u043c\u0456 \u043a\u0456\u0440\u0443\u0435 \u043d\u0435 \u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u044f\u043a \u0430\u0434\u043d\u0430 \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u044f \u0430\u0434\u043d\u043e\u0439 \u0456 \u0442\u043e\u0439 \u0436\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b, \u0433. \u0437\u043d. \u0448\u0442\u043e \u0456\u043c \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0446\u044c \u043d\u0435 \u0456\u043d\u0430\u043a\u0448, \u044f\u043a \u043f\u0440\u0430\u0437 \u041a\u0430\u0441\u0446\u0451\u043b\u044b, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u044b\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u043d\u0430\u0432\u0443\u0447\u0430\u043b\u0456 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430, \u0430 \u043f\u043e\u0442\u044b\u043c \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u041f\u0430\u043d \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f\u0448\u0447\u044d \u0448\u043c\u0430\u0442 \u0447\u0430\u0433\u043e \u043c\u0430\u044e \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0432\u0430\u043c, \u0430\u043b\u0435 \u0446\u044f\u043f\u0435\u0440 \u0432\u0430\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0437\u043d\u0435\u0441\u0446\u0456&raquo;. \u0410\u0434\u043d\u0430\u043a \u0434\u0430\u0434\u0430\u045e: &laquo;\u041a\u0430\u043b\u0456 \u0436 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0401\u043d, \u0414\u0443\u0445 \u043f\u0440\u0430\u045e\u0434\u044b, \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u0437\u0435&raquo; (\u042f\u043d 16, 12-13). \u0422\u0430\u043a \u041f\u0430\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u043d\u044f\u043c\u0430 \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u0431 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456, \u0431\u043e \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c &laquo;\u0443\u0441\u044e \u043f\u0440\u0430\u045e\u0434\u0443&raquo; \u0430\u0434 \u0414\u0443\u0445\u0430 \u043f\u0440\u0430\u045e\u0434\u044b. \u0406 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0430\u0441\u0430\u043c\u0440\u044d\u0447 \u0441\u043f\u043e\u045e\u043d\u0456\u045e \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435, \u044f\u043a \u0433\u044d\u0442\u0430 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e\u0446\u044c \u0414\u0437\u0435\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0430\u043f\u0430\u0432\u044f\u0434\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042f\u043d 12, 21-22; \u0420\u044b\u043c 9, 26 (\u043f\u0430\u0440. \u041e\u0441 2, 1b)<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u043f\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0434\u0430 \u0424\u0456\u043b\u0456\u043f\u0430 \u0456 \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u044f\u0433\u043e: \u041f\u0430\u043d\u0435, \u043c\u044b \u0445\u043e\u0447\u0430\u043c \u0431\u0430\u0447\u044b\u0446\u044c \u0415\u0437\u0443\u0441\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0424\u0456\u043b\u0456\u043f \u043f\u0430\u0439\u0448\u043e\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0410\u043d\u0434\u0440\u044d\u044e. \u0406 \u043f\u0430\u0439\u0448\u043b\u0456 \u0410\u043d\u0434\u0440\u044d\u0439 \u0437 \u0424\u0456\u043b\u0456\u043f\u0430\u043c, \u0456 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0415\u0437\u0443\u0441\u0443, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0456\u043c: \u0412\u044b, \u043d\u0435 \u043c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434, \u0442\u0430\u043c \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u044b\u044f \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0424\u0456\u043b\u0456\u043f<span style=\"text-align: justify;\">\u043f\u0430\u0439\u0448\u043e\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0410\u043d\u0434\u0440\u044d\u044e. \u0406 \u043f\u0430\u0439\u0448\u043b\u0456 \u0410\u043d\u0434\u0440\u044d\u0439 \u0437 \u0424\u0456\u043b\u0456\u043f\u0430\u043c, \u0456 \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0415\u0437\u0443\u0441\u0443, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><\/p>"}, {"GCH_CH_2_ID":"736","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u043d\u0430 \u0434\u0437\u0435\u043d\u044c \u041f\u0435\u0440\u0430\u043c\u044f\u043d\u0435\u043d\u043d\u044f \u041f\u0430\u043d\u0430\u00bb \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u044f \u0421\u0456\u043d\u0430\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 6-10: M\u00e9langes d\u2019arch\u00e9ologie et d\u2019histoire 67 [1955], 241-244)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0414\u043e\u0431\u0440\u0430 \u043d\u0430\u043c \u0442\u0443\u0442 \u0431\u044b\u0446\u044c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0415\u0437\u0443\u0441 \u0430\u0431\u2019\u044f\u0432\u0456\u045e \u0432\u0443\u0447\u043d\u044f\u043c \u0433\u044d\u0442\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u043d\u0430 \u0433\u0430\u0440\u044b \u0422\u0430\u0431\u043e\u0440. \u041a\u0430\u043b\u0456 \u0432\u0430\u043d\u0434\u0440\u0430\u0432\u0430\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456, \u0432\u0443\u0447\u044b\u045e \u043f\u0440\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0456 \u043f\u0440\u0430 \u0441\u0432\u0430\u0451 \u043f\u0430\u045e\u0442\u043e\u0440\u043d\u0430\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u045e \u0445\u0432\u0430\u043b\u0435. \u0410\u0434\u043d\u0430\u043a \u044f\u043d\u044b, \u044f\u043a \u0432\u044b\u0434\u0430\u0435\u0446\u0446\u0430, \u043d\u0435 \u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u043a\u0430\u0437\u0430\u045e \u0456\u043c \u043f\u0440\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u041a\u0430\u0431 \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0433\u044d\u0442\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u043a\u0430\u0431 \u0433\u044d\u0442\u044b\u044f \u043f\u0430\u0434\u0437\u0435\u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u043b\u0456 \u0456\u043c \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0431\u0443\u0434\u0443\u0447\u044b\u044f, \u0415\u0437\u0443\u0441 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0430\u0434\u043a\u0440\u044b\u045e \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456 \u0441\u0432\u0430\u044e \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044c \u043d\u0430 \u0433\u0430\u0440\u044b \u0422\u0430\u0431\u043e\u0440 \u044f\u043a \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435 \u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u0411\u043e\u0436\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0411\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u043a\u0430\u0437\u0430\u045e: \u00ab\u041a\u0430\u0431 \u0447\u0430\u0441 \u0447\u0430\u043a\u0430\u043d\u043d\u044f, \u044f\u043a\u0456 \u043c\u0456\u043d\u0430\u0435, \u043d\u0435 \u0441\u0442\u0430\u045e \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u044e \u0432\u0430\u0448\u0430\u0433\u0430 \u0431\u044f\u0437\u0432\u0435\u0440\u2019\u044f, \u0443\u0436\u043e \u0446\u044f\u043f\u0435\u0440, \u0443 \u0433\u044d\u0442\u0443\u044e \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u201c\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043a\u0430\u0436\u0443 \u0432\u0430\u043c, \u0448\u0442\u043e \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u0442\u044b\u0445, \u0445\u0442\u043e \u0442\u0443\u0442 \u0441\u0442\u0430\u0456\u0446\u044c, \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u0456, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430, \u044f\u043a\u0456 \u0456\u0434\u0437\u0435 \u045e \u0445\u0432\u0430\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0439\u0446\u0430\u201d (\u041c\u0446 16, 28)\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043c\u043e\u0433 \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u0445\u0430\u0446\u0435\u045e, \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442 \u0434\u0430\u0434\u0430\u0435: \u00ab\u041f\u0440\u0430\u0437 \u0448\u044d\u0441\u0446\u044c \u0434\u0437\u0451\u043d \u0443\u0437\u044f\u045e \u0415\u0437\u0443\u0441 \u041f\u044f\u0442\u0440\u0430, \u042f\u043a\u0443\u0431\u0430 \u0456 \u042f\u043d\u0430, \u0431\u0440\u0430\u0442\u0430 \u044f\u0433\u043e\u043d\u0430\u0433\u0430, \u0456 \u043f\u0430\u0432\u0451\u045e \u0456\u0445 \u0430\u0434\u043d\u044b\u0445 \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u0443\u044e \u0433\u0430\u0440\u0443, \u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456. \u0410\u0431\u043b\u0456\u0447\u0447\u0430 \u042f\u0433\u043e\u043d\u0430\u0435 \u0437\u0430\u0437\u0437\u044f\u043b\u0430, \u044f\u043a \u0441\u043e\u043d\u0446\u0430, \u0456 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u042f\u0433\u043e\u043d\u0430\u0435 \u0441\u0442\u0430\u043b\u0430 \u0431\u0435\u043b\u0430\u0435, \u044f\u043a \u0441\u0432\u044f\u0442\u043b\u043e. \u0406 \u0432\u043e\u0441\u044c, \u0437\u2019\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u0456\u043c \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0406\u043b\u043b\u044f, \u0456 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u043b\u0456 \u0437 \u0406\u043c\u00bb (\u041c\u0446 17, 1-3).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u0411\u043e\u0436\u044b\u044f \u0446\u0443\u0434\u044b \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0439 \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456, \u0432\u043e\u0441\u044c \u0437\u0431\u0430\u045e\u0447\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u044b\u044f \u0441\u0451\u043d\u043d\u044f \u0434\u043b\u044f \u043d\u0430\u0441 \u043d\u0430 \u0433\u0430\u0440\u044b; \u043d\u0430\u0441 \u0437\u0431\u0456\u0440\u0430\u0435 \u0440\u0430\u0437\u0430\u043c \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430. \u041a\u0430\u0431 \u043c\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c\u0456 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u0445 \u0411\u043e\u0433\u0430\u043c \u0432\u0443\u0447\u043d\u044f\u045e \u043c\u0430\u0433\u043b\u0456 \u0437\u0430\u0433\u043b\u044b\u0431\u0456\u0446\u0446\u0430 \u045e \u0433\u044d\u0442\u044b\u044f \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b\u044f \u0441\u0432\u044f\u0442\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u0435\u043c\u0441\u044f \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0433\u043e\u043b\u0430\u0441\u0443, \u044f\u043a\u0456 \u0437 \u0432\u044b\u0448\u044b\u043d\u044f\u045e, \u0437 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0433\u0430\u0440\u044b, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043a\u043b\u0456\u0447\u0430 \u043d\u0430\u0441 \u0434\u0430 \u0441\u044f\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u0433\u0430\u0440\u044b, \u2013 \u0430\u0441\u043c\u0435\u043b\u044e\u0441\u044f \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u2013 \u044f\u043a \u0415\u0437\u0443\u0441, \u044f\u043a\u0456 \u0442\u0430\u043c, \u0443 \u043d\u0435\u0431\u0435, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0448\u044b\u043c \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u043c \u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c. \u0420\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u043c\u044b \u0437\u0430\u0437\u0437\u044f\u0435\u043c \u0431\u043b\u044f\u0441\u043a\u0430\u043c, \u043d\u0430 \u044f\u043a\u0456 \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u043e\u0447\u044b \u0434\u0443\u0445\u0430. \u0410\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u044f \u0434\u0443\u0445\u0430\u043c, \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0435\u043d\u044b\u044f \u0434\u0430 \u042f\u0433\u043e \u0432\u043e\u0431\u0440\u0430\u0437\u0430, \u044f\u043a \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0456 \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u044b\u0437\u0432\u044b\u0447\u0430\u0439\u0432\u0430\u0446\u0446\u0430 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0431\u044f\u0436\u044b\u043c \u0442\u0443\u0434\u044b \u0437 \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044e: \u0443\u0432\u043e\u0439\u0434\u0437\u0435\u043c \u0443 \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u044f\u043a \u041c\u0430\u0439\u0441\u0435\u0439 \u0434\u044b \u0406\u043b\u043b\u044f, \u044f\u043a \u042f\u043a\u0443\u0431 \u0434\u044b \u042f\u043d. \u0411\u0443\u0434\u0437\u0435\u043c \u044f\u043a \u041f\u0451\u0442\u0440, \u0437\u0430\u043d\u0443\u0440\u0430\u043d\u044b\u044f \u045e \u0431\u0430\u0447\u0430\u043d\u043d\u0435 \u0456 \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430, \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0435\u043d\u044b\u044f \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u044b\u043c \u041f\u0435\u0440\u0430\u043c\u044f\u043d\u0435\u043d\u043d\u0435\u043c, \u0430\u0434\u0434\u0430\u043b\u0435\u043d\u044b\u044f \u0430\u0434 \u0441\u0432\u0435\u0442\u0443, \u0430\u0434\u0430\u0440\u0432\u0430\u043d\u044b\u044f \u0430\u0434 \u0437\u044f\u043c\u043b\u0456. \u041f\u0430\u043a\u0456\u043d\u0435\u043c \u0446\u0435\u043b\u0430, \u043f\u0430\u043a\u0456\u043d\u0435\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456 \u0456 \u0437\u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f, \u044f\u043a\u043e\u043c\u0443 \u041f\u0451\u0442\u0440 \u0443 \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u0456 \u043a\u0430\u0437\u0430\u045e: \u00ab\u041f\u0430\u043d\u0435, \u0434\u043e\u0431\u0440\u0430 \u043d\u0430\u043c \u0442\u0443\u0442 \u0431\u044b\u0446\u044c\u00bb (\u041c\u0446 17, 4).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u041f\u0451\u0442\u0440, \u00ab\u0434\u043e\u0431\u0440\u0430 \u043d\u0430\u043c \u0442\u0443\u0442 \u0431\u044b\u0446\u044c\u00bb \u0437 \u0415\u0437\u0443\u0441\u0430\u043c \u0456 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b. \u0428\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0435, \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u043d\u0451\u0441\u043b\u0430\u0435, \u0431\u043e\u043b\u044c\u0448 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435 \u0437\u0430 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u043d\u043d\u0435 \u0437 \u0411\u043e\u0433\u0430\u043c, \u0437\u0430 \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u0435\u043d\u043d\u0435 \u0434\u0430 \u042f\u0433\u043e \u0456 \u0442\u0440\u044b\u0432\u0430\u043d\u043d\u0435 \u045e \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043b\u0435? \u0412\u043e\u0441\u044c \u0436\u0430, \u043a\u043e\u0436\u043d\u044b \u0437 \u043d\u0430\u0441, \u043c\u0430\u044e\u0447\u044b \u0411\u043e\u0433\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b, \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0435\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430, \u043d\u044f\u0445\u0430\u0439 \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0435 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e: \u00ab\u0434\u043e\u0431\u0440\u0430 \u043d\u0430\u043c \u0442\u0443\u0442 \u0431\u044b\u0446\u044c\u00bb, \u0434\u0437\u0435 \u045e\u0441\u0451 \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0434\u0437\u0435 \u043f\u0430\u043d\u0443\u0435 \u0448\u0447\u0430\u0441\u0446\u0435, \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044c, \u0434\u0437\u0435 \u045e\u0441\u0451 \u045e \u043d\u0430\u0448\u044b\u043c \u0441\u044d\u0440\u0446\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u043f\u0430\u043a\u043e\u0435\u043c, \u0437\u0433\u043e\u0434\u0430\u044e \u0456 \u0430\u0441\u0430\u043b\u043e\u0434\u0430\u044e, \u0434\u0437\u0435 \u043c\u044b \u0431\u0430\u0447\u044b\u043c \u0411\u043e\u0433\u0430 (\u0425\u0440\u044b\u0441\u0442\u0430), \u0434\u0437\u0435 \u0401\u043d \u0441\u0430\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u0439\u0446\u043e\u043c \u0440\u044b\u0445\u0442\u0443\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0436\u044b\u043b\u043b\u0451 \u0456, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b, \u043a\u0430\u0436\u0430: \u00ab\u0421\u0451\u043d\u043d\u044f \u043f\u0440\u044b\u0439\u0448\u043b\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e \u0434\u043e\u043c \u0433\u044d\u0442\u044b\u00bb (\u041b\u043a 19, 9); \u0434\u0437\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u0456 \u0437\u0431\u0456\u0440\u0430\u044e\u0446\u0446\u0430 \u0441\u043a\u0430\u0440\u0431\u044b \u0432\u0435\u0447\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u0434\u0437\u0435 \u043d\u0456\u0431\u044b \u045e \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0443 \u043f\u0430\u045e\u0441\u0442\u0430\u044e\u0446\u044c \u0430\u0431\u0440\u044b\u0441\u044b \u0456 \u0432\u043e\u0431\u0440\u0430\u0437\u044b \u0431\u0443\u0434\u0443\u0447\u044b\u0445 \u0432\u044f\u043a\u043e\u045e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041c\u0446 17, 2. 3; \u043f\u0430\u0440. \u041b\u043a 9, 32. 34&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0410\u0431\u043b\u0456\u0447\u0447\u0430 \u0415\u0437\u0443\u0441\u0430 \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u044f\u043a \u0441\u043e\u043d\u0446\u0430,&nbsp;<\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0430 \u0432\u0443\u0447\u043d\u0456, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u042f\u0433\u043e \u0441\u043b\u0430\u0432\u0443, \u0443\u043f\u0430\u043b\u0456 \u043d\u0456\u0446\u043c\u0430 \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u043b\u0456\u0441\u044f.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0417\u2019\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u0456\u043c \u041c\u0430\u0439\u0441\u0435\u0439 \u0456 \u0406\u043b\u043b\u044f, \u0456 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u043b\u0456 \u0437 \u0406\u043c. <\/span><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0410 \u0432\u0443\u0447\u043d\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"737","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 80: CSEL 3, 839-840)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0416\u0430\u045e\u043d\u0435\u0440\u044b \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0433\u0456\u043d\u0443\u0446\u044c, \u0430\u043b\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u0431\u0440\u0430\u0442, \u044f \u043d\u0435 \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0432\u0430\u043c \u0430\u0434\u0440\u0430\u0437\u0443, \u0431\u043e \u045e\u0441\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u0445 \u0433\u0430\u043d\u0435\u043d\u043d\u044f\u045e \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0430\u0434\u044b\u0441\u0446\u0456 \u0430\u0434\u0441\u044e\u043b\u044c \u0456 \u0431\u044b\u043b\u0456 \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u043a\u043e\u0448\u0442\u0430\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0430\u0434 \u0411\u043e\u0433\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0443\u044e \u0445\u0432\u0430\u043b\u0443. \u0410\u043b\u0435 \u0446\u044f\u043f\u0435\u0440 \u044f \u0445\u0430\u0447\u0443 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u0446\u044c \u0432\u0430\u043c, \u0448\u0442\u043e \u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u045e\u0436\u043e \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u044f \u043f\u0430\u0441\u043b\u0430\u045e \u0443 \u0420\u044b\u043c \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430 \u043f\u0440\u0430 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u043d\u0430\u043a\u043e\u043d\u0442 \u043d\u0430\u0441. \u042f\u043d\u044b \u0440\u0430\u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u043c\u043d\u0435 \u045e\u0441\u044e \u043f\u0440\u0430\u045e\u0434\u0443. \u0411\u043e \u0448\u043c\u0430\u0442 \u0437\u2019\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u0430 \u0433\u044d\u0442\u0443\u044e \u0442\u044d\u043c\u0443 \u0440\u043e\u0437\u043d\u044b\u0445 \u0456 \u043d\u0435\u043f\u0440\u0430\u0432\u0435\u0440\u0430\u043d\u044b\u0445 \u0447\u0443\u0442\u0430\u043a.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u044f\u043a \u0443\u0441\u0451 \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0435: \u0456\u043c\u043f\u0435\u0440\u0430\u0442\u0430\u0440 \u0412\u0430\u043b\u0435\u0440\u044b\u044f\u043d \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0434\u043b\u044f \u0441\u0435\u043d\u0430\u0442\u0430 \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u043d\u0435, \u043a\u0430\u0431 \u0431\u0456\u0441\u043a\u0443\u043f\u044b, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u044b \u0456 \u0434\u044b\u044f\u043a\u0430\u043d\u044b \u043d\u0435\u0430\u0434\u043a\u043b\u0430\u0434\u043d\u0430 \u0431\u044b\u043b\u0456 \u045e\u0437\u044f\u0442\u044b\u044f \u043f\u0430\u0434 \u0432\u0430\u0440\u0442\u0443; \u0440\u044b\u043c\u0441\u043a\u0456\u044f \u0441\u0435\u043d\u0430\u0442\u0430\u0440\u044b, \u0437\u043d\u0430\u0442\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u0456 \u0440\u044b\u043c\u0441\u043a\u0456\u044f \u0432\u0435\u0440\u0448\u043d\u0456\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0441\u0430\u0434\u0430\u045e, \u0430\u043b\u0435 \u0456 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u0456. \u041a\u0430\u043b\u0456 \u0436 \u043d\u0430\u0432\u0430\u0442 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u0442\u0432\u0430, \u043a\u0430\u0440\u0430\u0446\u044c \u0456\u0445 \u0430\u0434\u0441\u044f\u0447\u044d\u043d\u043d\u0435\u043c \u0433\u0430\u043b\u0430\u0432\u044b. \u0412\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b\u0445 \u0436\u0430\u043d\u0447\u044b\u043d \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u044f\u0446\u044c \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e \u0456 \u0430\u0434\u043f\u0440\u0430\u045e\u043b\u044f\u0446\u044c \u0443 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0435. \u041f\u0440\u044b\u0434\u0432\u043e\u0440\u043d\u044b\u044f, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456 \u0446\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0456\u043c\u0456 \u0446\u044f\u043f\u0435\u0440, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u0456 \u0456 \u0432\u044b\u0441\u043b\u0430\u043d\u044b\u044f \u0432\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0456 \u0456\u043c\u043f\u0435\u0440\u0430\u0442\u0430\u0440\u0430 \u044f\u043a \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0414\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0412\u0430\u043b\u0435\u0440\u044b\u044f\u043d \u0434\u0430\u043b\u0443\u0447\u044b\u045e \u0441\u043f\u0456\u0441, \u0432\u044b\u0441\u043b\u0430\u043d\u044b \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c \u043f\u0440\u0430\u0432\u0456\u043d\u0446\u044b\u0439, \u044f\u043a\u0456 \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u043d\u0430\u0441. \u041a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u043c\u044b \u0447\u0430\u043a\u0430\u0435\u043c, \u043a\u0430\u043b\u0456 \u0451\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435. \u0417 \u043c\u043e\u0446\u043d\u0430\u0439 \u0432\u0435\u0440\u0430\u0439 \u0440\u044b\u0445\u0442\u0443\u0435\u043c\u0441\u044f \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0456 \u0447\u0430\u043a\u0430\u0435\u043c \u0430\u0434 \u0448\u0447\u043e\u0434\u0440\u0430\u0433\u0430 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0416\u0430\u0434\u0430\u044e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u0446\u044c \u0432\u0430\u043c, \u0448\u0442\u043e 6 \u0436\u043d\u0456\u045e\u043d\u044f \u043d\u0430 \u043c\u043e\u0433\u0456\u043b\u043a\u0430\u0445 \u0431\u044b\u045e \u0441\u0445\u043e\u043f\u043b\u0435\u043d\u044b \u0421\u0456\u043a\u0441\u0442 \u0440\u0430\u0437\u0430\u043c \u0437 \u0447\u0430\u0442\u044b\u0440\u043c\u0430 \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u043c\u0456. \u0420\u044b\u043c\u0441\u043a\u0456\u044f \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456 \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0437\u0430\u0439\u043c\u0430\u044e\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u043c \u0456 \u0431\u044f\u0440\u0443\u0446\u044c \u043f\u0430\u0434 \u0432\u0430\u0440\u0442\u0443 \u0442\u044b\u0445, \u043d\u0430 \u043a\u0430\u0433\u043e \u0434\u0430\u043d\u0435\u0441\u043b\u0456, \u0456 \u0430\u0434\u043f\u0456\u0441\u0432\u0430\u044e\u0446\u044c \u0456\u0445 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u044c \u0443 \u0434\u0437\u044f\u0440\u0436\u0430\u045e\u043d\u0443\u044e \u043a\u0430\u0437\u043d\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0448\u0443, \u0441\u043a\u0430\u0436\u044b \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u043c \u0431\u0440\u0430\u0442\u0430\u043c \u0443 \u0431\u0456\u0441\u043a\u0443\u043f\u0441\u0442\u0432\u0435, \u043a\u0430\u0431 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0456\u0445 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u044e \u0431\u0440\u0430\u0442\u044b \u045e\u0441\u044e\u0434\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0443 \u0456 \u0431\u044b\u043b\u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u0434\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u044b. \u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435 \u0431\u043e\u043b\u044c\u0448 \u0434\u0443\u043c\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u0447\u044b\u043c \u043f\u0440\u0430 \u0441\u043c\u0435\u0440\u0446\u044c: \u0430\u0434\u0434\u0430\u043d\u044b\u044f \u0411\u043e\u0433\u0443 \u0437 \u0443\u0441\u0451\u0439 \u0432\u0435\u0440\u0430\u044e \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044e \u043d\u044f\u0445\u0430\u0439 \u043b\u0435\u043f\u0448 \u0446\u0435\u0448\u0430\u0446\u0446\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u0432\u0435\u0440\u044b, \u0447\u044b\u043c \u0431\u0430\u044f\u0446\u0446\u0430. \u0411\u043e \u044f\u043d\u044b \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044e \u0436\u0430\u045e\u043d\u0435\u0440\u044b \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0411\u043e\u0433\u0430 \u043d\u0435 \u0433\u0456\u043d\u0443\u0446\u044c, \u0430\u043b\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0416\u0430\u0434\u0430\u044e \u0442\u0430\u0431\u0435, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u0431\u0440\u0430\u0446\u0435, \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u043f\u043e\u0441\u043f\u0435\u0445\u0443 \u045e \u041f\u0430\u043d\u0443.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">2 \u041a\u0430\u0440 4, 11; \u041f\u0441 44 (43), 23\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u041c\u044b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0456\u0434\u0437\u0451\u043c \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0415\u0437\u0443\u0441\u0430,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u043a\u0430\u0431 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0415\u0437\u0443\u0441\u0430 \u0430\u0431\u2019\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0448\u044b\u043c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0446\u0435\u043b\u0435.<\/span><span style=\"color: #ff0000; font-weight: bold;\"><span style=\"font-size: 0.6em; vertical-align: super;\"><\/span><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0417-\u0437\u0430 \u0426\u044f\u0431\u0435 \u043d\u0430\u0441 \u0448\u0442\u043e\u0434\u043d\u044f \u0437\u0430\u0431\u0456\u0432\u0430\u044e\u0446\u044c \u0456 \u043b\u0456\u0447\u0430\u0446\u044c \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u043c\u0456 \u043d\u0430 \u0437\u0430\u0440\u044d\u0437. <\/span><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u041a\u0430\u0431 \u0456 \u0436\u044b\u0446\u0446\u0451.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"738","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041a\u0430\u044f\u0442\u0430\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. Ad Elisabeth Porto: Studi e Testi 177, Citt\u00e0 del Vaticano 1954, pp. 50-51)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u043d\u044f\u0445\u0430\u0439 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0433\u0440\u044d\u0448\u043d\u0456\u043a \u0456 \u043c\u0430\u043b\u0430 \u0448\u0442\u043e \u0437\u043d\u0430\u0447\u0443, \u0430\u043b\u0435 \u0437\u0432\u044f\u0440\u0442\u0430\u044e\u0441\u044f \u0434\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u0437\u0430 \u0446\u044f\u0431\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u0443 \u0456 \u042f\u0433\u043e \u041c\u0430\u0446\u0456. \u0410\u0434\u043d\u0430\u043a \u043f\u0430\u043c\u044f\u0442\u0430\u0439, \u0448\u0442\u043e \u043d\u0430\u0432\u0430\u0442 \u0443\u0441\u0435 \u0441\u0432\u044f\u0442\u044b\u044f \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u0434\u0430\u0440\u043e\u0433\u0430\u044e \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u0441\u0430\u043c. \u0413\u044d\u0442\u0430 \u0442\u0432\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430. \u0410 \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448, \u043a\u0430\u0431 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043b\u044e\u0431\u0456\u045e \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u0446\u044f\u0431\u0435, \u0442\u043e \u0456 \u0442\u044b \u043b\u044e\u0431\u0456 \u042f\u0433\u043e, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0432\u043e\u0434\u0437\u044c \u0441\u044f\u0431\u0435 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u042f\u0433\u043e \u0432\u043e\u043b\u044f\u0439 \u0456 \u0431\u0443\u0434\u0437\u044c \u0443\u043f\u044d\u045e\u043d\u0435\u043d\u044b, \u0448\u0442\u043e \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0446\u044f\u0431\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0443\u0441\u0435 \u0441\u0432\u044f\u0442\u044b\u044f \u0456 \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u0401\u043d \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u0437 \u0442\u0430\u0431\u043e\u0439 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0442\u0432\u0430\u0456\u0445 \u043f\u0430\u0442\u0440\u044d\u0431\u0430\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0435\u0434\u0430\u0439, \u0448\u0442\u043e \u0442\u0443\u0442, \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043c\u044b \u0447\u0443\u0436\u044b\u044f \u0456 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0456. \u041d\u0430\u0448\u0430 \u0430\u0439\u0447\u044b\u043d\u0430 \u2013 \u043d\u0435\u0431\u0430. \u0425\u0442\u043e \u043f\u044b\u0445\u043b\u0456\u0432\u044b, \u0442\u043e\u0439 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0456 \u0456 \u0456\u0434\u0437\u0435 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456. \u0416\u044b\u0432\u0443\u0447\u044b \u0442\u0443\u0442, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0410\u0434\u043d\u0430\u043a \u0443\u043b\u0430\u0441\u043d\u044b\u043c\u0456 \u0441\u0456\u043b\u0430\u043c\u0456 \u043c\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0437\u0440\u043e\u0431\u0456\u043c, \u0431\u043e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0433\u0440\u0430\u0445\u043e\u045e \u043c\u044b \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0430\u043b\u0435 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u044f\u0440\u043d\u0443\u045e \u044f\u0433\u043e \u043d\u0430\u043c. \u0422\u0430\u043c\u0443 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u042f\u043c\u0443, \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e, \u0431\u044b\u0446\u044c \u042f\u043c\u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0456, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u0446\u044c \u0437 \u0406\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u043d \u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u043d\u0430\u043c \u044f\u043a \u0435\u0436\u0443; \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435 \u0442\u0430\u043a\u043e\u0433\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0434\u0430\u0440\u0443; \u043d\u0430\u043c \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u043c\u0435\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u0421\u044b\u043d\u0430 \u041f\u0430\u043d\u043d\u044b \u041c\u0430\u0440\u044b\u0456, \u0430 \u043c\u044b \u043d\u0435 \u0445\u043e\u0447\u0430\u043c; \u0433\u043e\u0440\u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043d\u0435 \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u042f\u0433\u043e \u043f\u0440\u044b\u043d\u044f\u0446\u044c. \u041c\u0430\u044f \u0434\u0430\u0447\u043a\u0430, \u0448\u0447\u0430\u0441\u0446\u0435, \u044f\u043a\u043e\u0433\u0430 \u044f \u043f\u0440\u0430\u0433\u043d\u0443, \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u044e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043b\u044f \u0446\u044f\u0431\u0435; \u043a\u0430\u0431 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u044f\u0433\u043e, \u043d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u0448\u043b\u044f\u0445\u0443, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u041f\u0430\u043d\u043d\u0443 \u041c\u0430\u0440\u044b\u044e. \u041d\u044f\u0445\u0430\u0439 \u042f\u043d\u0430 \u043f\u0430\u0436\u0430\u0434\u0430\u0435 \u043d\u0430\u0432\u0435\u0434\u0430\u0446\u044c \u0446\u044f\u0431\u0435 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u044b\u043c \u0421\u044b\u043d\u0430\u043c. \u041c\u0430\u0439 \u0436\u0430 \u0430\u0434\u0432\u0430\u0433\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u042f\u0435, \u043a\u0430\u0431 \u0434\u0430\u043b\u0430 \u0442\u0430\u0431\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0430\u043c \u0434\u043b\u044f \u0434\u0443\u0448\u044b \u045e \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u044b\u043c \u0421\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0446\u0435 \u0410\u043b\u0442\u0430\u0440\u0430. \u042f\u043d\u0430 \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0434\u0430\u0441\u0446\u044c \u042f\u0433\u043e \u0442\u0430\u0431\u0435. \u0401\u043d \u0436\u0430 \u044f\u0448\u0447\u044d \u0430\u0445\u0432\u043e\u0442\u043d\u0435\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u0442\u044b \u043c\u0430\u0433\u043b\u0430 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u0456\u0441\u0446\u0456 \u043f\u0440\u0430\u0437 \u0446\u0451\u043c\u043d\u044b \u043b\u0435\u0441, \u0443 \u044f\u043a\u0456\u043c \u0442\u0430\u043a \u0448\u043c\u0430\u0442 \u0432\u043e\u0440\u0430\u0433\u0430\u045e \u0441\u0442\u0430\u0432\u044f\u0446\u044c \u043d\u0430 \u043d\u0430\u0441 \u043f\u0430\u0441\u0442\u043a\u0456. \u0410\u0434\u043d\u0430\u043a \u044f\u043d\u044b \u0442\u0440\u044b\u043c\u0430\u044e\u0446\u0446\u0430 \u0437\u0434\u0430\u043b\u0451\u043a, \u043a\u0430\u043b\u0456 \u0431\u0430\u0447\u0430\u0446\u044c \u043d\u0430\u0441 \u043f\u0430\u0434 \u0442\u0430\u043a\u043e\u0439 \u0430\u043f\u0435\u043a\u0430\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u0430\u044f \u0434\u0430\u0447\u043a\u0430, \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0439 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456. \u0425\u0430\u0447\u0443, \u043a\u0430\u0431 \u0442\u044b \u0434\u0430\u0432\u0435\u0440\u044b\u043b\u0430\u0441\u044f \u042f\u043c\u0443 \u0446\u0430\u043b\u043a\u0430\u043c, \u043a\u0430\u0431 \u0401\u043d \u043f\u0440\u044b\u043d\u044f\u045e \u0446\u044f\u0431\u0435 \u0456 \u043a\u0430\u0431 \u0401\u043d, \u0442\u0432\u043e\u0439 \u0411\u043e\u0433 \u0456 \u0417\u0431\u0430\u045e\u0446\u0430, \u0443\u0447\u044b\u043d\u0456\u045e \u0437 \u0442\u0430\u0431\u043e\u044e \u0456 \u045e \u0442\u0430\u0431\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430\u0445\u043e\u0447\u0430. \u0413\u044d\u0442\u0430\u0433\u0430 \u0436\u0430\u0434\u0430\u044e, \u0430\u0431 \u0433\u044d\u0442\u044b\u043c \u0446\u044f\u0431\u0435 \u043f\u0440\u0430\u0448\u0443 \u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u0430\u0433\u0443.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0424\u043b\u043f 1, 21\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u0432\u044f\u0442\u044b, \u0433\u043e\u0434\u043d\u044b \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043f\u0430\u0445\u0432\u0430\u043b\u044b, \u043f\u043e\u045e\u043d\u044b \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0414\u043b\u044f \u044f\u0433\u043e \u0436\u044b\u0446\u0446\u0451 \u2013 \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u2013 \u0433\u044d\u0442\u0430 \u0432\u044b\u0433\u0430\u0434\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"739","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u0413\u0456\u0441\u0442\u043e\u0440\u044b\u044f \u041e\u0440\u0434\u044d\u043d\u0443 \u041f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e\u00bb&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Libellus de principiis O. P.: Acta canonizationis sancti Dominici:&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">Monumenta O. P. Mist. 16, Romae 1935, pp. 30ss., 146-147)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0420\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u0439 \u0430\u0431\u043e \u0437 \u0411\u043e\u0433\u0430\u043c, \u0430\u0431\u043e \u043f\u0440\u0430 \u0411\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0430\u043c\u0456\u043d\u0456\u043a \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u045e\u0441\u044f \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044e \u0456 \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u0430\u0439 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0430\u0431 \u0411\u043e\u0436\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445, \u0448\u0442\u043e \u0431\u0435\u0437 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u045e \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0443 \u0456\u043c \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0435 \u043d\u0430\u0447\u044b\u043d\u043d\u0435 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0456 \u043b\u0430\u0441\u043a\u0456. \u0410\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u043b\u0430 \u044f\u0433\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u044f \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u0440\u0430\u045e\u043d\u0430\u0432\u0430\u0433\u0430 \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u044b\u0445 \u0445\u0432\u0456\u043b\u0456\u043d\u0430\u045e, \u043a\u0430\u043b\u0456 \u044f\u0433\u043e \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u043b\u0430 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u0435 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0431\u0430\u0447\u043d\u0430\u0435 \u045e \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u044b, \u0442\u043e \u043f\u043e\u045e\u043d\u0430\u044f \u0441\u043f\u0430\u043a\u043e\u044e \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0430\u044f \u043f\u0430\u0441\u0442\u0430\u0432\u0430 \u0437\u043d\u0435\u0448\u043d\u0435 \u0432\u044b\u044f\u045e\u043b\u044f\u043b\u0430\u0441\u044f \u045e \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430\u0441\u0446\u0456 \u0456 \u0432\u044f\u0441\u0451\u043b\u044b\u043c \u043f\u043e\u0437\u0456\u0440\u043a\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u043d \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u045e \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c: \u0443 \u0441\u043b\u043e\u0432\u0430\u0445 \u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u0445. \u0423\u0434\u0437\u0435\u043d\u044c \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0431\u044b\u045e \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u044f\u0433\u043e \u043c\u0456\u043b\u044b\u043c \u0456 \u0437\u044b\u0447\u043b\u0456\u0432\u044b\u043c \u0434\u0430 \u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f\u045e \u0456 \u0431\u0440\u0430\u0442\u043e\u045e; \u043d\u043e\u0447\u0447\u0443 \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0456\u043a\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u0434\u0430\u043d\u0430\u0433\u0430 \u0447\u0443\u0432\u0430\u043d\u043d\u044e \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0435. \u0421\u0442\u0440\u044b\u043c\u0430\u043d\u044b \u045e \u0441\u043b\u043e\u0432\u0430\u0445, \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u045e \u0430\u0431\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u0411\u043e\u0433\u0430\u043c \u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u0430\u0431\u043e \u043f\u0440\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0440\u0430\u0456\u045e \u0431\u0440\u0430\u0442\u0430\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0427\u0430\u0441\u0442\u0430 \u0456 \u0433\u043e\u0440\u0430\u0447\u0430 \u043f\u0440\u0430\u0441\u0456\u045e \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0401\u043d \u0434\u0430\u045e \u044f\u043c\u0443 \u043b\u044e\u0431\u043e\u045e, \u0437\u0434\u043e\u043b\u044c\u043d\u0443\u044e \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u0446\u044c \u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u0432\u0430\u0446\u044c \u043b\u044e\u0434\u0437\u044f\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u041b\u0456\u0447\u044b\u045e, \u0448\u0442\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u043d\u043d\u044e \u0434\u0443\u0448 \u0442\u0430\u043a, \u044f\u043a \u0417\u0431\u0430\u045e\u0446\u0430 \u045e\u0441\u0456\u0445, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0441\u044f\u0431\u0435 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0414\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043d\u0430\u043c\u0435\u0440\u0430\u043c \u0411\u043e\u0436\u0430\u0433\u0430 \u041f\u0440\u043e\u0432\u0456\u0434\u0443, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u045e \u041e\u0440\u0434\u044d\u043d \u0411\u0440\u0430\u0442\u043e\u045e \u041f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0443\u0441\u043d\u0430 \u0456 \u043f\u0456\u0441\u044c\u043c\u043e\u0432\u0430 \u0447\u0430\u0441\u0442\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u045e \u0431\u0440\u0430\u0442\u043e\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0417\u0430\u043a\u043e\u043d\u0443, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u043f\u0430\u0433\u043b\u044b\u0431\u043b\u044f\u043b\u0456 \u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0421\u0442\u0430\u0440\u043e\u0433\u0430 \u0456 \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443. \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u043d\u0430\u0441\u0456\u045e \u0437 \u0441\u0430\u0431\u043e\u044e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041c\u0430\u0446\u0432\u0435\u044f \u0456 \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u041f\u0430\u045e\u043b\u0430. \u0422\u0430\u043a \u0447\u0430\u0441\u0442\u0430 \u0456\u0445 \u0447\u044b\u0442\u0430\u045e, \u0448\u0442\u043e \u0432\u0435\u0434\u0430\u045e \u0456\u0445 \u0430\u043c\u0430\u043b\u044c \u043d\u0430\u043f\u0430\u043c\u044f\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0432\u0430 \u0446\u0456 \u0442\u0440\u044b \u0440\u0430\u0437\u044b \u0432\u044b\u0431\u0456\u0440\u0430\u045e\u0441\u044f \u043d\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u0441\u043a\u0456 \u043f\u0430\u0441\u0430\u0434. \u041a\u043e\u0436\u043d\u044b \u0440\u0430\u0437 \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u045e\u0441\u044f, \u0430\u0434\u0434\u0430\u044e\u0447\u044b \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0443 \u0436\u044b\u0446\u0446\u044e \u0432\u0430 \u045e\u0431\u043e\u0441\u0442\u0432\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0431\u0440\u0430\u0442\u0430\u043c\u0456. \u0410\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0443\u044e \u0445\u0432\u0430\u043b\u0443 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456. \u0417\u0430 \u0432\u0435\u0440\u0443 \u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0436\u0430\u0434\u0430\u045e \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0431\u0456\u0447\u0430\u0432\u0430\u043d\u043d\u0435, \u0447\u0430\u0446\u0432\u0435\u0440\u0442\u0430\u0432\u0430\u043d\u043d\u0435 \u0456 \u0441\u043c\u0435\u0440\u0446\u044c. \u0421\u0432\u044f\u0442\u044b \u0410\u0439\u0446\u0435\u0446 \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u0439 \u0425 \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u044f\u0433\u043e: \u00ab\u042f \u0432\u0435\u0434\u0430\u045e \u044f\u0433\u043e \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u0432\u0435\u0440\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u045e \u0443\u043a\u0430\u0437\u0430\u043d\u043d\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0456 \u043d\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u044e\u0441\u044f, \u0448\u0442\u043e \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456 \u043f\u0430\u0434\u0437\u044f\u043b\u044f\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u0443\u044e \u0445\u0432\u0430\u043b\u0443\u00bb.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0421\u0456\u0440 48, 1; \u041c\u0430\u043b 2, 6\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u043f\u0440\u0430\u0440\u043e\u043a, \u044f\u043a \u0430\u0433\u043e\u043d\u044c, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0441\u043b\u043e\u0432\u0430 \u044f\u0433\u043e\u043d\u0430\u0435 \u043f\u0430\u043b\u0430\u043b\u0430, \u044f\u043a \u043f\u0430\u0445\u043e\u0434\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0417\u0430\u043a\u043e\u043d \u043f\u0440\u0430\u045e\u0434\u044b \u0431\u044b\u045e \u0443 \u044f\u0433\u043e\u043d\u044b\u0445 \u0432\u0443\u0441\u043d\u0430\u0445, \u0456 \u043d\u044f\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0430 \u044f\u0433\u043e\u043d\u044b\u043c \u044f\u0437\u044b\u043a\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0441\u043b\u043e\u0432\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"740","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041d\u0430\u0432\u0443\u043a\u0430 \u041a\u0440\u044b\u0436\u0430\u00bb \u0441\u0432. \u0422\u044d\u0440\u044d\u0437\u044b \u0411\u044d\u043d\u044d\u0434\u044b\u043a\u0442\u044b \u0430\u0434 \u041a\u0440\u044b\u0436\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Edith Steins Werke, Ed. L. Gelber-R. Leuven, Tom. I, Freiburg 1983, pp. 15-16)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u0440\u0430\u043c\u0430 \u0436\u044b\u0446\u0446\u044f \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0432\u0430 \u0423\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0437\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u0446\u044f\u0436\u0430\u0440 \u0417\u0430\u043a\u043e\u043d\u0443, \u0446\u0430\u043b\u043a\u0430\u043c \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b \u044f\u0433\u043e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b \u0437\u0430 \u044f\u0433\u043e \u0456 \u0437-\u0437\u0430 \u044f\u0433\u043e. \u0422\u0430\u043c\u0443 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0443\u045e \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451. \u0410\u0434\u043d\u0430\u043a \u044f\u043d\u044b \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u044f\u0433\u043e \u0456\u043d\u0430\u043a\u0448, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0447\u044b \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u043b\u0430\u0441\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u00ab\u0423\u0441\u0435 \u043c\u044b, \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u044f \u043f\u0440\u0430\u0437 \u0430\u043a\u0443\u043d\u0430\u043d\u043d\u0435 \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0441\u043c\u0435\u0440\u0446\u044c \u042f\u0433\u043e\u043d\u0443\u044e \u0430\u043a\u0443\u043d\u0443\u043b\u0456\u0441\u044f\u00bb (\u043f\u0430\u0440. \u0420\u044b\u043c 6, 3). \u0410\u043a\u0443\u043d\u0430\u044e\u0446\u0446\u0430 \u045e \u042f\u0433\u043e \u0436\u044b\u0446\u0446\u0451, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u0447\u043b\u0435\u043d\u0430\u043c\u0456 \u042f\u0433\u043e \u0446\u0435\u043b\u0430 \u0456 \u044f\u043a \u042f\u0433\u043e \u0447\u043b\u0435\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0456 \u043f\u0430\u043c\u0435\u0440\u0446\u0456. \u0413\u044d\u0442\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0446\u0435 \u043d\u0430\u0434\u044b\u0434\u0437\u0435 \u045e \u0434\u0437\u0435\u043d\u044c \u0445\u0432\u0430\u043b\u044b. \u0410\u043b\u0435 \u045e\u0436\u043e \u0446\u044f\u043f\u0435\u0440, \u0437\u0430\u0441\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u045e \u0446\u0435\u043b\u0435, \u043c\u044b \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0435\u043c \u0443 \u0456\u043c \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u043a\u0430\u043b\u0456 \u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u043d\u0430\u0441, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u043d\u0430\u043c \u0436\u044b\u0446\u0446\u0451. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u0439 \u0432\u0435\u0440\u044b \u043c\u044b, \u044f\u043a \u0447\u043b\u0435\u043d\u044b, \u044f\u0434\u043d\u0430\u0435\u043c\u0441\u044f \u045e \u0406\u043c \u044f\u043a \u0437 \u0413\u0430\u043b\u0430\u0432\u043e\u044e. \u0413\u044d\u0442\u0430\u044f \u0432\u0435\u0440\u0430 \u045e\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0441 \u0443 \u0441\u0442\u044b\u043b\u044c \u042f\u0433\u043e \u0436\u044b\u0446\u0446\u044f. \u0422\u0430\u043c\u0443 \u0432\u0435\u0440\u0430, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0432\u0430 \u0423\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b\u043c, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0436\u044b\u0432\u0430\u044f \u0432\u0435\u0440\u0430, \u0441\u043f\u0430\u043b\u0443\u0447\u0430\u043d\u0430\u044f \u0437 \u043f\u0430\u043a\u043e\u0440\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e, \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u0431\u0440\u0430\u043c\u0430\u0439 \u0436\u044b\u0446\u0446\u044f \u0456 \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u0431\u0443\u0434\u0443\u0447\u0430\u0439 \u0445\u0432\u0430\u043b\u044b. \u0422\u0430\u043c\u0443 \u043a\u0440\u044b\u0436 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043d\u0430\u0448\u044b\u043c \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0433\u043e\u043d\u0430\u0440\u0430\u043c: \u00ab\u041d\u044f\u0445\u0430\u0439 \u043c\u043d\u0435 \u043d\u0435 \u0434\u0430\u0432\u044f\u0434\u0437\u0435\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0456\u0447\u044b\u043c, \u0430\u043a\u0440\u0430\u043c\u044f \u043a\u0440\u044b\u0436\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0441\u0432\u0435\u0442 \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0434\u043b\u044f \u043c\u044f\u043d\u0435, \u0430 \u044f \u2013 \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443\u00bb (\u0413\u0430\u043b 6, 14).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0442\u043e \u0432\u044b\u0431\u0440\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u043e\u0439 \u043f\u0430\u043c\u0451\u0440 \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443, \u0430 \u0441\u0432\u0435\u0442 \u0434\u043b\u044f \u044f\u0433\u043e. \u0401\u043d \u043d\u043e\u0441\u0456\u0446\u044c \u0443 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u0437\u043d\u044f\u0432\u0430\u0433\u0456, \u043f\u0440\u044b\u043d\u044f\u0442\u044b\u044f \u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0401\u043d \u0441\u043b\u0430\u0431\u044b \u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043d\u044b \u043b\u044e\u0434\u0437\u044c\u043c\u0456. \u0410\u043b\u0435 \u043f\u0430 \u0442\u043e\u0439 \u0436\u0430 \u043f\u0440\u044b\u0447\u044b\u043d\u0435 \u043c\u043e\u0446\u043d\u044b \u0442\u043e\u0439, \u0443 \u043a\u0456\u043c \u0411\u043e\u0436\u0430\u044f \u043c\u043e\u0446 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0442\u0430\u043a\u043e\u043c\u0443 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044e \u0432\u0443\u0447\u0430\u043d\u044c \u0415\u0437\u0443\u0441\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b\u043c\u0430\u0435 \u045e\u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430 \u044f\u0433\u043e \u043a\u0440\u044b\u0436, \u0430\u043b\u0435 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0443\u043a\u0440\u044b\u0436\u043e\u045e\u0432\u0430\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435: \u00ab\u0422\u044b\u044f, \u0445\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443, \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043b\u0456 \u0446\u0435\u043b\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u043c\u0456 \u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e\u00bb (\u0413\u0430\u043b 5, 24). \u0421\u0443\u0442\u044b\u043a\u043d\u0443\u043b\u0456\u0441\u044f \u045e \u0436\u043e\u0440\u0441\u0442\u043a\u0430\u0439 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u043a\u0430\u0431 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043c\u0451\u0440\u0442\u0432\u044b\u043c \u0443 \u0441\u0430\u0431\u0435 \u0436\u044b\u0446\u0446\u0451 \u0433\u0440\u0430\u0445\u0443 \u0456 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c. \u0423 \u0433\u044d\u0442\u0430\u0439 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044c. \u041a\u0440\u044b\u0436 \u2013 \u0433\u044d\u0442\u0430 \u043d\u0435 \u043a\u0430\u043d\u0435\u0446. \u0423\u0437\u043d\u0435\u0441\u0435\u043d\u044b \u043a\u0440\u044b\u0436 \u0451\u0441\u0446\u044c \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0435\u0431\u0430. \u0401\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u043d\u0430\u043a, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435\u043f\u0435\u0440\u0430\u043c\u043e\u0436\u043d\u0430\u044f \u0437\u0431\u0440\u043e\u044f \u0425\u0440\u044b\u0441\u0442\u0430: \u043a\u0456\u0439 \u043f\u0430\u0441\u0442\u044b\u0440\u0430, \u044f\u043a\u0456\u043c \u043f\u0430\u0431\u043e\u0436\u043d\u044b \u0414\u0430\u0432\u0456\u0434 \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0433\u0430 \u0413\u0430\u043b\u0456\u044f\u0442\u0430. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043c\u043e\u0446\u043d\u0430 \u0441\u0442\u0443\u043a\u0430\u0435 \u0456\u043c \u0443 \u0431\u0440\u0430\u043c\u044b \u043d\u0435\u0431\u0430 \u0456 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0456\u0445. \u0410 \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u0442\u043e \u0433\u044d\u0442\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0437\u0430\u044f\u0441\u043d\u0435\u0435 \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0443\u0441\u0456\u0445, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u0437\u0430 \u0423\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b\u043c.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0413\u0430\u043b 2, 19b-20\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0456 \u045e\u0436\u043e \u043d\u0435 \u044f \u0436\u044b\u0432\u0443, \u0430 \u0436\u044b\u0432\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u044f\u043a\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043c\u044f\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410 \u0448\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u0436\u044b\u0432\u0443 \u045e \u0446\u0435\u043b\u0435, \u0442\u043e \u0436\u044b\u0432\u0443 \u0432\u0435\u0440\u0430\u044e \u045e \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u042f\u043a\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"741","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 304, 1-4: PL 38, 1395-1397)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0420\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u041a\u0440\u044b\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0420\u044b\u043c\u0441\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0443\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0435 \u0441\u044f\u0433\u043e\u043d\u043d\u044f \u0434\u0437\u0435\u043d\u044c \u0442\u0440\u044b\u0443\u043c\u0444\u0443 \u0441\u0432. \u041b\u0430\u045e\u0440\u044d\u043d\u0446\u0456\u044f&nbsp; \u2013 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0451\u043d \u0441\u0442\u0430\u043f\u0442\u0430\u045e \u0448\u0430\u043b\u0451\u043d\u044b \u0441\u0432\u0435\u0442, \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u044f\u0433\u043e \u043b\u0456\u0441\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0456 \u0433\u044d\u0442\u044b\u043c \u0434\u0432\u043e\u0439\u0447\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0441\u0430\u0442\u0430\u043d\u0443. \u0423 \u0420\u044b\u043c\u0441\u043a\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u044f\u043a \u0447\u0430\u0441\u0442\u0430 \u0447\u0443\u0435\u043c, \u0451\u043d \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u045e \u043f\u0430\u0441\u043b\u0443\u0433\u0443 \u0434\u044b\u044f\u043a\u0430\u043d\u0430. \u0423 \u0456\u043c \u0431\u044b\u045e \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u043c \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u041a\u0440\u044b\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0456\u043c \u0437\u0430 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0440\u0430\u043b\u0456\u045e \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e. \u0422\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0412\u044f\u0447\u044d\u0440\u044b \u041f\u0430\u043d\u0430 \u0442\u0440\u0430\u043f\u043d\u0430 \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u045e \u0441\u0432. \u042f\u043d, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0401\u043d \u0430\u0434\u0434\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451. \u0406 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0431\u0440\u0430\u0442\u043e\u045e\u00bb (1 \u042f\u043d 3, 16). \u0417\u0440\u0430\u0437\u0443\u043c\u0435\u045e \u0433\u044d\u0442\u0430, \u0431\u0440\u0430\u0442\u044b, \u0441\u0432. \u041b\u0430\u045e\u0440\u044d\u043d\u0446\u0456\u0439, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e \u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u045e; \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u044b\u043c\u0430\u045e \u043b\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u0441\u0442\u0430\u043b\u0430. \u041f\u0430\u043b\u044e\u0431\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0456, \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u042f\u0433\u043e \u045e \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u043c\u044b, \u0431\u0440\u0430\u0442\u044b, \u043a\u0430\u043b\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043b\u044e\u0431\u0456\u043c, \u0442\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435\u043c \u0417\u0431\u0430\u045e\u0446\u0443. \u041c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0433\u0430 \u043f\u043b\u0451\u043d\u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u0437\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430. \u00ab\u0411\u043e \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0446\u044f\u0440\u043f\u0435\u045e \u0437\u0430 \u0432\u0430\u0441, \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0447\u044b \u0432\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u043a\u0430\u0431 \u0432\u044b \u0456\u0448\u043b\u0456 \u0441\u043b\u0435\u0434\u0430\u043c \u0437\u0430 \u0406\u043c\u00bb (1 \u041f 2, 21). \u0423 \u0433\u044d\u0442\u044b\u043c \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0456, \u044f\u043a \u043f\u0430\u0434\u0430\u0435\u0446\u0446\u0430, \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0445\u0430\u0446\u0435\u045e \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0446\u044f\u0440\u043f\u0435\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u0441\u043b\u0435\u0434\u0430\u043c \u0437\u0430 \u0406\u043c, \u0456 \u0448\u0442\u043e \u041c\u0443\u043a\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043c\u043e\u0436\u0430 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0447\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u0437\u0430 \u0406\u043c. \u0422\u0430\u043a \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430 \u0406\u043c \u0441\u0432\u044f\u0442\u044b\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456 \u0430\u0436 \u0434\u0430 \u043f\u0440\u0430\u043b\u0456\u0446\u0446\u044f \u043a\u0440\u044b\u0432\u0456, \u0430\u0436 \u0434\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u0437 \u043f\u0430\u043a\u0443\u0442\u044b. \u0410\u043b\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u044b. \u0428\u043b\u044f\u0445 \u043d\u0435 \u0437\u0430\u043a\u0440\u044b\u045e\u0441\u044f, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u043f\u0440\u0430\u0439\u0448\u043b\u0456, \u0456 \u043d\u0435 \u0432\u044b\u0441\u0430\u0445\u043b\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u0437 \u044f\u0435 \u0437\u0430\u0447\u044d\u0440\u043f\u043d\u0443\u043b\u0456. \u0401\u0441\u0446\u044c, \u0431\u0440\u0430\u0442\u044b \u043c\u0430\u0435, \u0451\u0441\u0446\u044c \u0443 \u0441\u0430\u0434\u0437\u0435 \u041f\u0430\u043d\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0443\u0436\u044b \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e, \u0430\u043b\u0435 \u0456 \u043b\u0456\u043b\u0435\u0456 \u0434\u0437\u0435\u0432\u0430\u045e, \u043f\u043b\u044e\u0448\u0447 \u0441\u0443\u0436\u044d\u043d\u0446\u0430\u045e, \u0444\u0456\u044f\u043b\u043a\u0456 \u045e\u0434\u043e\u0432\u0430\u045e. \u041d\u0456\u0445\u0442\u043e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0456. \u0411\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0446\u044f\u0440\u043f\u0435\u045e \u0437\u0430 \u045e\u0441\u0456\u0445. \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043f\u0440\u0430 \u042f\u0433\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u00ab\u0401\u043d \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u0443\u0441\u0435 \u043b\u044e\u0434\u0437\u0456 \u0431\u044b\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0456 \u0434\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u045e\u0434\u044b\u00bb (1 \u0426\u0456\u043c 2, 4).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043c\u044b \u0436\u0430\u0434\u0430\u0435\u043c \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u044f\u043a \u044f\u0448\u0447\u044d, \u0430\u043a\u0440\u0430\u043c\u044f \u043f\u0440\u0430\u043b\u0456\u0446\u0446\u044f \u043a\u0440\u044b\u0432\u0456 \u0456 \u043c\u0443\u043a\u0430\u044e, \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430. \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0430 \u041f\u0430\u043d\u0430: \u00ab\u0401\u043d, \u0431\u0443\u0434\u0443\u0447\u044b \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0411\u043e\u0433\u0430, \u043d\u0435 \u0441\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u045e \u0437 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u043d\u0430\u0440\u043e\u045e\u043d\u0456 \u0437 \u0411\u043e\u0433\u0430\u043c\u00bb. \u042f\u043a\u0430\u044f \u0432\u0435\u043b\u0456\u0447! \u00ab\u0410\u043b\u0435 \u0432\u044b\u0440\u0430\u043a\u0441\u044f \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456, \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u045e\u0448\u044b\u0441\u044f \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439. \u0406 \u0437 \u0432\u044b\u0433\u043b\u044f\u0434\u0443 \u0441\u0442\u0430\u045e\u0448\u044b \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u2026\u00bb (\u0424\u043b\u043f 2, 6-8). \u0428\u0442\u043e \u0437\u0430 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435!<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435: \u0432\u043e\u0441\u044c, \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d, \u0442\u044b \u043c\u0430\u0435\u0448 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0434\u043b\u044f \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0442\u0430\u045e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c. \u0427\u0430\u043c\u0443 \u0436 \u0442\u044b \u045e\u0437\u0432\u044b\u0448\u0430\u0435\u0448\u0441\u044f? \u0423\u0440\u044d\u0448\u0446\u0435, \u043f\u0440\u0430\u0439\u0448\u043e\u045e\u0448\u044b \u045e\u0441\u0435 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u044f \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043d\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430: \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0437\u0430 \u0406\u043c. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430: \u00ab\u041a\u0430\u043b\u0456 \u0436 \u0432\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430\u00bb (\u041a\u043b\u0441 3, 1).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 18 (17), 3b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u0432\u044f\u0442\u044b \u041b\u0430\u045e\u0440\u044d\u043d\u0446\u0456\u0439 \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u045e: \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430 \u0456 \u042f\u043c\u0443 \u0430\u0434\u043d\u0430\u043c\u0443 \u0441\u043b\u0443\u0436\u0443, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0442\u0430\u043c\u0443 \u043d\u0435 \u0431\u0430\u044e\u0441\u044f \u0442\u0432\u0430\u0456\u0445 \u043a\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u044f\u045e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u043e\u0433 \u043c\u043e\u0439 \u2013 \u0430\u0431\u0430\u0440\u043e\u043d\u0430 \u043c\u0430\u044f, \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043c\u0443.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"742","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u0410\u0433\u043d\u0435\u0448\u043a\u0456 \u041f\u0440\u0430\u0436\u0441\u043a\u0430\u0439\u00bb \u0441\u0432. \u041a\u043b\u0430\u0440\u044b, \u043f\u0430\u043d\u043d\u044b<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Edit. I. Omaechevarria, Escritos de Santa Clara, Madrid 1970, pp. 339-341)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0420\u0430\u0437\u0432\u0430\u0436\u0430\u0439 \u043f\u0440\u0430 \u045e\u0431\u043e\u0441\u0442\u0432\u0430, \u043f\u0430\u043a\u043e\u0440\u0443 \u0456 \u043b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b, \u043a\u0430\u043c\u0443 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u043e\u0439 \u0433\u0430\u0441\u0446\u0456\u043d\u0435 \u0456 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u043f\u0440\u044b\u0445\u0456\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0447\u044b\u0451\u0439 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044e \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u044e\u0446\u0446\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u0430\u043d\u0451\u043b\u044c\u0441\u043a\u0456\u044f \u0445\u043e\u0440\u044b. \u042f\u0433\u043e \u043b\u044e\u0431\u043e\u045e \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e\u0433\u043b\u044b\u0431, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u042f\u0433\u043e \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435, \u042f\u0433\u043e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c \u043d\u0430\u0441\u044b\u0447\u0430\u0435, \u0430 \u0441\u043b\u043e\u0434\u044b\u0447 \u0437\u0430\u0447\u0430\u0440\u043e\u045e\u0432\u0430\u0435, \u0443\u0441\u043f\u0430\u043c\u0456\u043d \u043f\u0440\u0430 \u042f\u0433\u043e \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435, \u042f\u0433\u043e \u0432\u043e\u0434\u0430\u0440 \u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c, \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0435 \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u0435 \u042f\u0433\u043e \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0448\u0447\u0430\u0441\u0446\u0435\u043c \u0443\u0441\u0456\u0445 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430. \u0401\u043d \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0431\u043b\u044f\u0441\u043a\u0430\u043c \u0432\u0435\u0447\u043d\u0430\u0439 \u0445\u0432\u0430\u043b\u044b, \u0437\u0437\u044f\u043d\u043d\u0435\u043c \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0430\u043c (\u043f\u0430\u0440. \u041c\u0434\u0440 7, 26). \u0422\u0430\u043c\u0443, \u043e \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430, \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0443\u0433\u043b\u044f\u0434\u0430\u0439\u0441\u044f \u045e \u0433\u044d\u0442\u0430\u0435 \u043b\u044e\u0441\u0442\u0440\u044d\u0440\u043a\u0430, \u043a\u0430\u0431 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0442\u044b \u043c\u0430\u0433\u043b\u0430 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u0437\u043d\u0435\u0448\u043d\u044e\u044e \u0456 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0443\u044e \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c, \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u0437\u0456\u0445\u043e\u0442\u043a\u0443\u044e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443 \u0456 \u045e \u043a\u0432\u0435\u0446\u0435\u043d\u044c \u0440\u043e\u0437\u043d\u044b\u0445 \u0446\u043d\u043e\u0442\u0430\u045e, \u044f\u043a \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430\u0447\u0446\u044d \u0456 \u043d\u0430\u0439\u0447\u044b\u0441\u0446\u0435\u0439\u0448\u0430\u0439 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u041a\u0430\u0440\u0430\u043b\u044f. \u0413\u044d\u0442\u0430\u0435 \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0430 \u045e \u043a\u043e\u0436\u043d\u0430\u0439 \u0441\u0432\u0430\u0451\u0439 \u0447\u0430\u0441\u0442\u0446\u044b \u0432\u044b\u044f\u045e\u043b\u044f\u0435 \u042f\u0433\u043e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u045e\u0431\u043e\u0441\u0442\u0432\u0430, \u0441\u0432\u044f\u0442\u0443\u044e \u043f\u0430\u043a\u043e\u0440\u0443, \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0456\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u0446\u044b \u0442\u044b \u043c\u043e\u0436\u0430\u0448 \u0431\u0430\u0447\u044b\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0432\u0435\u0440\u0445\u043d\u044e\u044e \u0447\u0430\u0441\u0442\u043a\u0443 \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0430, \u043d\u0430 \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u045e \u044f\u0441\u043b\u044f\u0445 \u0456 \u0441\u043f\u0430\u0432\u0456\u0442\u0430\u0433\u0430 \u045e \u043f\u044f\u043b\u044e\u0448\u043a\u0456. \u041e \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u043f\u0430\u043a\u043e\u0440\u0430, \u043e \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u043b\u044c\u043d\u0430\u0435 \u045e\u0431\u043e\u0441\u0442\u0432\u0430! \u041a\u0430\u0440\u043e\u043b\u044c \u0430\u043d\u0451\u043b\u0430\u045e, \u041f\u0430\u043d \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u0456 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0435 \u045e \u044f\u0441\u043b\u044f\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0435 \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439 \u043f\u0440\u0430 \u043f\u0430\u043a\u043e\u0440\u0443, \u0448\u0442\u043e \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0441\u0432\u044f\u0442\u044b\u043c \u0443\u0431\u043e\u0441\u0442\u0432\u0435, \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u0445 \u0447\u044b\u043d\u0430\u0445 \u0456 \u043f\u0430\u043a\u0443\u0442\u0430\u0445, \u044f\u043a\u0456\u044f \u0401\u043d \u0437\u0432\u0435\u0434\u0430\u045e \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0440\u043e\u0434\u0443. \u0413\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u043d\u0456\u0436\u043d\u044e\u044e \u0447\u0430\u0441\u0442\u043a\u0443 \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439 \u043f\u0440\u0430 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u0401\u043d \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u043d\u0430 \u0434\u0440\u044d\u0432\u0435 \u043a\u0440\u044b\u0436\u0430 \u0456 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0441\u0430\u043c\u0430\u0439 \u0433\u0430\u043d\u0435\u0431\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0456\u0431\u044b \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0430, \u0401\u043d, \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u043c\u0456\u043d\u0430\u043a\u043e\u045e \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c\u0456: \u00ab\u041f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u044c\u0446\u0435\u0441\u044f \u0456 \u045e\u0431\u0430\u0447\u0446\u0435, \u0446\u0456 \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0456 \u0431\u043e\u043b\u044c \u044f\u043a \u043c\u043e\u0439\u00bb (\u041f\u043b 1, 12). \u0410\u0434\u043a\u0430\u0436\u044b \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0442\u0430\u043a \u043f\u0430\u043a\u0443\u0442\u0443\u0435 \u0456 \u043a\u043b\u0456\u0447\u0430, \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430\u043b\u043e\u0441\u043d\u0430, \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430: \u00ab\u041d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u043c\u0430\u044f \u0434\u0443\u0448\u0430\u00bb (\u041f\u043b 3, 20). \u0420\u043e\u0431\u044f\u0447\u044b \u0442\u0430\u043a, \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0437\u0430\u043f\u0430\u043b\u0430\u0435\u0448 \u0430\u0433\u043d\u0451\u043c \u043b\u044e\u0431\u043e\u0432\u0456, \u043e \u043a\u0430\u0440\u0430\u043b\u0435\u0432\u0430, \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u041a\u0430\u0440\u0430\u043b\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u042f\u0433\u043e \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b\u044f \u0441\u043a\u0430\u0440\u0431\u044b, \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u0456 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0443\u044e \u0445\u0432\u0430\u043b\u0443, \u0443\u0437\u0434\u044b\u0445\u0430\u044e\u0447\u044b \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043f\u044f\u043a\u0443\u0447\u0430\u0433\u0430 \u0441\u0443\u043c\u0443 \u0456 \u0433\u0430\u0440\u0430\u0447\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u043a\u043b\u0456\u0447: \u00ab\u201d\u041f\u0440\u044b\u0446\u044f\u0433\u043d\u0456 \u043c\u044f\u043d\u0435, \u0456 \u043c\u044b \u043f\u0430\u0431\u044f\u0436\u044b\u043c \u0437\u0430 \u0432\u043e\u0434\u0430\u0440\u0430\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u043b\u0435\u044e\u201d (\u041f\u043f 1, 3 Vlg), \u043e \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a. \u042f \u043f\u0430\u0431\u044f\u0433\u0443 \u0456 \u043d\u0435 \u0441\u0442\u0430\u043c\u043b\u044e\u0441\u044f, \u043f\u0430\u043a\u0443\u043b\u044c \u201c\u043d\u0435 \u045e\u0432\u044f\u0434\u0437\u0435\u0448 \u043c\u044f\u043d\u0435 \u045e \u0434\u043e\u043c \u0432\u0456\u043d\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0442\u0432\u0430\u044f \u043b\u0435\u0432\u0430\u044f \u0440\u0443\u043a\u0430 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0434 \u043c\u0430\u0451\u0439 \u0433\u0430\u043b\u0430\u0432\u043e\u0439, \u0430 \u043f\u0440\u0430\u0432\u0430\u044f \u043b\u0430\u0433\u043e\u0434\u043d\u0430 \u043d\u0435 \u0430\u0431\u0434\u044b\u043c\u0435 \u043c\u044f\u043d\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u0446\u0430\u043b\u0443\u0435\u0448 \u043c\u044f\u043d\u0435 \u0441\u0430\u043c\u044b\u043c \u0441\u0430\u043b\u043e\u0434\u043a\u0456\u043c \u043f\u0430\u0446\u0430\u043b\u0443\u043d\u043a\u0430\u043c \u0422\u0432\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u045e\u201d (\u041f\u043f 2, 4. 6)\u00bb. \u0420\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430, \u0443\u0441\u043f\u043e\u043c\u043d\u0456 \u0441\u0432\u0430\u044e \u0431\u0435\u0434\u043d\u0443\u044e \u043c\u0430\u0446\u0456 \u0456 \u0432\u0435\u0434\u0430\u0439, \u0448\u0442\u043e \u045e \u043c\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b \u043d\u0430\u0432\u0435\u043a\u0456 \u0437\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u0442\u0432\u0430\u0451 \u0456\u043c\u044f, \u0431\u043e \u0442\u044b \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0434\u0430\u0440\u0430\u0436\u044d\u0439 \u0437\u0430 \u045e\u0441\u0456\u0445 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u0445.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 73 (72), 26; \u0424\u043b\u043f 3, 8b. 9\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0417\u043d\u0435\u043c\u0430\u0433\u0430\u0435 \u043c\u0430\u0451 \u0446\u0435\u043b\u0430 \u0456 \u0441\u044d\u0440\u0446\u0430 \u043c\u0430\u0451, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0430\u043b\u0435 \u0411\u043e\u0433 \u2013 \u0441\u043a\u0430\u043b\u0430 \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0456 \u043c\u043e\u0439 \u043b\u0451\u0441 \u043d\u0430\u0432\u0435\u043a\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u045e\u0441\u0451 \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0430 \u0456 \u043b\u0456\u0447\u0443 \u0441\u043c\u0435\u0446\u0446\u0435\u043c, \u043a\u0430\u0431 \u043d\u0430\u0431\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0430\u043f\u044b\u043d\u0443\u0446\u0446\u0430 \u045e \u0406\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u043b\u0435 \u0411\u043e\u0433.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"743","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u0423\u0441\u043f\u0430\u043c\u0456\u043d\u044b\u00bb, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u044b\u044f \u0441\u0430\u043a\u0440\u0430\u0442\u0430\u0440\u043a\u0430\u0439 \u0441\u0432. \u0416\u0430\u043d\u043d\u044b \u0424\u0440\u0430\u043d\u0441\u0443\u0430\u0437\u044b<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Fran\u00e7oise-Madeleine de Chaugy, M\u00e9moires sur la vie et les vertus de Sainte J.-F. de Chantal, III, 3:&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">3e \u00e9dit., Paris 1853, pp. 306-307)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041b\u044e\u0431\u043e\u045e, \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u044f \u044f\u043a \u0441\u043c\u0435\u0440\u0446\u044c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u043e\u0439\u0447\u044b \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u044f \u0416\u0430\u043d\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u0442\u0430\u043a\u0456\u044f \u0441\u043b\u043e\u0432\u044b, \u043f\u043e\u045e\u043d\u044b\u044f \u0437\u0430\u043f\u0430\u043b\u0443, \u0456 \u0437 \u043f\u0430\u0448\u0430\u043d\u0430\u044e \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u043f\u0435\u0440\u0448\u044b\u0445 \u0441\u044f\u0441\u0446\u0451\u0440: \u00ab\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0434\u043e\u0447\u043a\u0456, \u0448\u043c\u0430\u0442 \u0441\u0432\u044f\u0442\u044b\u0445 \u043c\u0443\u0436\u0447\u044b\u043d \u0456 \u043a\u0430\u043b\u043e\u043d\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430. \u0427\u0430\u043c\u0443 \u0442\u0430\u043a \u0441\u0442\u0430\u043b\u0430\u0441\u044f? \u0410\u0431 \u0447\u044b\u043c \u0433\u044d\u0442\u0430 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c?\u00bb \u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u0432\u044b\u043a\u0430\u0437\u0430\u043b\u0456\u0441\u044f \u045e \u0430\u0434\u043a\u0430\u0437, \u0442\u0430\u0434\u044b \u043d\u0430\u0448\u0430\u044f \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u044f \u041c\u0430\u0446\u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430: \u00ab\u0414\u0443\u043c\u0430\u044e, \u0442\u0430\u043a \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0456\u0441\u043d\u0443\u0435 \u044f\u0448\u0447\u044d \u0430\u0434\u0437\u0456\u043d \u0432\u0456\u0434 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430: \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0437 \u043b\u044e\u0431\u043e\u0432\u0456. \u0423 \u0433\u044d\u0442\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u0411\u043e\u0433 \u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0433\u0430\u043c \u0456 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0456\u043c \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u042f\u0433\u043e \u0445\u0432\u0430\u043b\u044b, \u0456 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u044f\u043d\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u043c\u0456 \u0456 \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0430\u043c\u0456. \u0412\u0435\u0434\u0430\u044e, \u2013 \u0434\u0430\u0434\u0430\u043b\u0430 \u044f\u043d\u0430, \u2013 \u0448\u0442\u043e \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a\u043e\u0435 \u0436\u044b\u0446\u0446\u0451 \u0432\u044f\u0434\u0443\u0446\u044c \u0414\u043e\u0447\u043a\u0456 \u0410\u0434\u0432\u0435\u0434\u0437\u0456\u043d\u0430\u045e, \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u0446\u044b \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u043f\u0440\u043e\u0439\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u0437 \u0442\u043e\u0435, \u0430\u0431 \u0447\u044b\u043c \u043f\u0440\u0430\u0441\u0456\u043b\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0436 \u0430\u0434\u043d\u0430 \u0437 \u0441\u044f\u0441\u0446\u0451\u0440 \u0441\u043f\u044b\u0442\u0430\u043b\u0430\u0441\u044f, \u044f\u043a \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0435 \u0442\u0430\u043a\u043e\u0435 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430, \u041c\u0430\u0446\u0456 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430: \u00ab\u0422\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0446\u044c \u0411\u043e\u0433\u0443, \u0456 \u0441\u0430\u043c\u0456 \u0433\u044d\u0442\u0430 \u0430\u0434\u0447\u0443\u0435\u0446\u0435. \u0411\u043e\u0436\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435, \u044f\u043a \u043c\u0435\u0447, \u0443 \u043d\u0430\u0439\u0433\u043b\u044b\u0431\u0435\u0439\u0448\u044b\u044f \u043a\u0443\u0442\u043a\u0456 \u043d\u0430\u0448\u0430\u0439 \u0434\u0443\u0448\u044b \u0456 \u0430\u0434\u0434\u0437\u044f\u043b\u044f\u0435 \u043d\u0430\u0441 \u0430\u0434 \u043d\u0430\u0441 \u0436\u0430 \u0441\u0430\u043c\u0456\u0445. \u042f \u0432\u0435\u0434\u0430\u043b\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0433\u044d\u0442\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0430\u0434\u0430\u0440\u0432\u0430\u043b\u0430 \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u043d\u0430\u0439\u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u0430\u0433\u0430 \u043d\u0456\u0431\u044b \u045e\u0434\u0430\u0440 \u0431\u044f\u0437\u043b\u0456\u0442\u0430\u0441\u043d\u0430\u0433\u0430 \u043c\u044f\u0447\u0430, \u044f\u043a\u0456 \u0440\u0430\u0441\u0441\u0435\u043a \u0446\u0435\u043b\u0430 \u0456 \u0434\u0443\u0448\u0443 \u0433\u044d\u0442\u0430\u0439 \u0430\u0441\u043e\u0431\u044b\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u043c\u044b \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456, \u0448\u0442\u043e \u044f\u043d\u0430 \u043a\u0430\u0437\u0430\u043b\u0430 \u043f\u0440\u0430 \u0441\u044f\u0431\u0435. \u041a\u0430\u043b\u0456 \u0436 \u0434\u0440\u0443\u0433\u0430\u044f \u0441\u044f\u0441\u0442\u0440\u0430 \u0441\u043f\u044b\u0442\u0430\u043b\u0430 \u044f\u0435, \u044f\u043a \u0434\u043e\u045e\u0433\u0430 \u0442\u0440\u044b\u0432\u0430\u0435 \u0442\u0430\u043a\u043e\u0435 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0437 \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043d\u0430 \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430: \u00ab\u0410\u0434 \u043c\u043e\u043c\u0430\u043d\u0442\u0443 \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f \u0441\u044f\u0431\u0435 \u0411\u043e\u0433\u0443 \u0430\u0436 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u0436\u044b\u0446\u0446\u044f. \u0410\u043b\u0435 \u0433\u044d\u0442\u0430 \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u044b\u0445 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u043d\u0456\u0447\u043e\u0433\u0430 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u043d\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0456 \u0437\u0430\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u0432\u0435\u0440\u043d\u044b\u043c\u0456 \u043b\u044e\u0431\u043e\u0432\u0456. \u0411\u043e \u0441\u043b\u0430\u0431\u044b\u0445 \u0411\u043e\u0433 \u043d\u0435 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u0442\u0430\u043a\u0456\u043c \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0439 \u0456 \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0430\u043b\u0435 \u0432\u044f\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u043b\u0451\u0433\u043a\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u0439, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0435 \u0430\u0434\u044b\u0448\u043b\u0456 \u0430\u0434 \u042f\u0433\u043e. \u0401\u043d \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0430\u0440\u0443\u0448\u0430\u0435 \u0432\u043e\u043b\u044c\u043d\u0430\u0439 \u0432\u043e\u043b\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u0434 \u0442\u044b\u043c, \u0446\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u043c\u043e\u0436\u043d\u0430 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u0446\u044c \u0437 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0446\u0435\u043b\u0430. \u0406 \u041c\u0430\u0446\u0456 \u0441\u043a\u0430\u0437\u0430\u043b\u0430: \u00ab\u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0448\u0443\u043a\u0430\u0446\u044c \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u044f, \u0445\u043e\u0446\u044c \u044f \u0434\u0443\u043c\u0430\u044e, \u0448\u0442\u043e \u0456 \u0430\u0434\u043d\u043e, \u0456 \u0434\u0440\u0443\u0433\u043e\u0435 \u043d\u0435 \u0441\u0430\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u043c\u0443, \u0431\u043e \u201c\u043b\u044e\u0431\u043e\u045e \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u044f, \u044f\u043a \u0441\u043c\u0435\u0440\u0446\u044c\u201d (\u041f\u043f 8, 6)\u00bb. \u041c\u0443\u0447\u0430\u043d\u0456\u043a\u0456 \u043b\u044e\u0431\u043e\u0432\u0456 \u0446\u0435\u0440\u043f\u044f\u0446\u044c \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0430 \u0431\u043e\u043b\u044c\u0448 \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0440\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0411\u043e\u0433, \u0431\u043e \u0456\u0445 \u0436\u044b\u0446\u0446\u0451 \u043c\u043a\u043d\u0435 \u0434\u0430 \u042f\u0433\u043e; \u043d\u0430\u0432\u0430\u0442 \u0431\u043e\u043b\u044c\u0448, \u0447\u044b\u043c \u043a\u0430\u043b\u0456 \u0431 \u044f\u043d\u044b \u0442\u044b\u0441\u044f\u0447\u044b \u0440\u0430\u0437\u043e\u045e \u043c\u0435\u043b\u0456\u0441\u044f \u0430\u0434\u0434\u0430\u0446\u044c \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u044f\u043a \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0432\u0435\u0440\u044b, \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0424\u043b\u043f 4, 8-9\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0428\u0442\u043e \u0451\u0441\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435, \u0448\u0442\u043e \u0433\u043e\u0434\u043d\u0430\u0435, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0435, \u0448\u0442\u043e \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435, \u0448\u0442\u043e \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0435, \u0448\u0442\u043e \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0435, \u0442\u043e\u0435 \u0447\u044b\u043d\u0456\u0446\u0435,<\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0411\u043e\u0433 \u0441\u043f\u0430\u043a\u043e\u044e \u0431\u0443\u0434\u0437\u0435 \u0437 \u0432\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u043d\u0435\u0439\u043a\u0430\u044f \u0446\u043d\u043e\u0442\u0430 \u0430\u0431\u043e \u043d\u0435\u0448\u0442\u0430 \u0433\u043e\u0434\u043d\u0430\u0435 \u043f\u0430\u0445\u0432\u0430\u043b\u044b \u2013 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0434\u0443\u043c\u0430\u0439\u0446\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0411\u043e\u0433.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"744","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 10, 2-3. 5: CSEL 3, 491-492. 494-495)<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u0441\u0446\u044c \u0432\u0435\u0440\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a \u0436\u0430 \u044f \u043c\u0430\u0433\u0443 \u043f\u0430\u0445\u0432\u0430\u043b\u0456\u0446\u044c \u0432\u0430\u0441, \u0441\u0430\u043c\u044b\u044f \u043c\u0443\u0436\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b? \u042f\u043a\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u043c\u0430\u0433\u0443 \u045e\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0433\u0430\u0440\u0442 \u0432\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e \u0456 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u0441\u0446\u044c \u0432\u0435\u0440\u044b? \u0412\u044b \u0433\u043e\u0434\u043d\u0430 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043d\u0430\u0439\u0446\u044f\u0436\u044d\u0439\u0448\u0430\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0435; \u043d\u0435 \u0432\u044b \u0441\u0430\u0441\u0442\u0443\u043f\u0456\u043b\u0456 \u043f\u0430\u043a\u0443\u0442\u0430\u043c, \u0430\u043b\u0435 \u044f\u043d\u044b \u0441\u0430\u0441\u0442\u0443\u043f\u0456\u043b\u0456 \u0432\u0430\u043c. \u041d\u0435 \u043a\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0456 \u0441\u0442\u0430\u043b\u0456 \u043a\u0430\u043d\u0446\u043e\u043c \u0432\u0430\u0448\u044b\u0445 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e, \u0430\u043b\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430. \u041f\u0430\u043a\u0443\u0442\u044b \u0431\u044b\u043b\u0456 \u0434\u043e\u045e\u0433\u0456\u043c\u0456 \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0437\u043b\u0430\u043c\u0430\u0446\u044c \u043c\u043e\u0446\u043d\u0443\u044e \u0432\u0435\u0440\u0443, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0445\u0443\u0442\u0447\u044d\u0439 \u043f\u0430\u0441\u043b\u0430\u0446\u044c \u0434\u0430 \u041f\u0430\u043d\u0430 \u0411\u043e\u0436\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u0421\u0430 \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0433\u043b\u044f\u0434\u0437\u0435\u045e \u043d\u0430\u0442\u043e\u045e\u043f \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u044b\u0445 \u043d\u0430 \u043d\u0435\u0437\u044f\u043c\u043d\u043e\u0435 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0430 \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0443 \u0425\u0440\u044b\u0441\u0442\u0430. \u042f\u0433\u043e\u043d\u044b\u044f \u0441\u043b\u0443\u0433\u0456 \u0432\u044b\u0439\u0448\u043b\u0456 \u0437 \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u0434\u0443\u043c\u043a\u0430\u043c\u0456, \u0441\u0432\u044f\u0442\u043e\u0439 \u0430\u0434\u0432\u0430\u0433\u0430\u0439, \u0431\u0435\u0437 \u0437\u044f\u043c\u043d\u043e\u0439 \u0437\u0431\u0440\u043e\u0456, \u0430\u043b\u0435 \u045e\u0437\u0431\u0440\u043e\u0435\u043d\u044b\u044f \u0432\u0435\u0440\u0430\u044e. \u041a\u0430\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u0441\u0442\u0430\u043b\u0456 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u044b\u043c\u0456 \u0437\u0430 \u043a\u0430\u0442\u0430\u045e; \u0437\u043d\u044f\u0432\u0435\u0447\u0430\u043d\u0430\u0435 \u0456 \u0437\u0430\u0431\u0456\u0442\u0430\u0435 \u0446\u0435\u043b\u0430 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u043b\u043e \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u0433\u043e \u0431\u0456\u045e \u0456 \u043a\u0430\u043b\u0435\u0447\u044b\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u0456 \u043b\u044e\u0442\u044b\u044f \u045e\u0434\u0430\u0440\u044b \u043d\u0435 \u0437\u043c\u0430\u0433\u043b\u0456 \u0430\u0434\u043e\u043b\u0435\u0446\u044c \u043d\u0435\u043f\u0435\u0440\u0430\u043c\u043e\u0436\u043d\u0443\u044e \u0432\u0435\u0440\u0443, \u0445\u043e\u0446\u044c \u043f\u0430\u0441\u043b\u044f \u0440\u0430\u0437\u0434\u0437\u0456\u0440\u0430\u043d\u043d\u044f \u0446\u0435\u043b\u0430 \u045e\u0436\u043e \u043d\u0435 \u0447\u043b\u0435\u043d\u044b \u0411\u043e\u0436\u044b\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u0437\u0432\u0435\u0434\u0432\u0430\u043b\u0456 \u043a\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0435, \u0430\u043b\u0435 \u0441\u0430\u043c\u0456 \u0440\u0430\u043d\u044b. \u0420\u0443\u0447\u0430\u044f\u043c\u0456 \u0446\u044f\u043a\u043b\u0430 \u043a\u0440\u043e\u045e, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u0430 \u043f\u0430\u0433\u0430\u0441\u0456\u0446\u044c \u0430\u0433\u043e\u043d\u044c \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443 \u0456 \u0436\u0430\u0440 \u043f\u0435\u043a\u043b\u0430. \u0428\u0442\u043e \u0437\u0430 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0435 \u0432\u0456\u0434\u043e\u0432\u0456\u0448\u0447\u0430 \u0434\u043b\u044f \u041f\u0430\u043d\u0430! \u042f\u043a \u0443\u0437\u043d\u0451\u0441\u043b\u0430, \u044f\u043a \u0446\u0443\u0434\u043e\u045e\u043d\u0430, \u044f\u043a \u043f\u0440\u044b\u0435\u043c\u043d\u0430 \u0434\u043b\u044f \u0411\u043e\u0436\u044b\u0445 \u0432\u0430\u0447\u044d\u0439 \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0435 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u043c \u0456 \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044c \u042f\u0433\u043e \u0436\u0430\u045e\u043d\u0435\u0440\u0430. \u0423 \u043f\u0441\u0430\u043b\u044c\u043c\u0435, \u0443 \u044f\u043a\u0456\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043d\u0430\u0432\u0443\u0447\u0430\u0435 \u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435, \u0442\u0430\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: \u00ab\u041a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u0445\u00bb (\u041f\u0441 116&nbsp;[115], 15). \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u0442\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c, \u044f\u043a\u0430\u044f \u043a\u043e\u0448\u0442\u0430\u043c \u043f\u0440\u0430\u043b\u0456\u0442\u0430\u0439 \u043a\u0440\u044b\u0432\u0456 \u0434\u0430\u0435 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0437\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u0430\u0434\u0432\u0430\u0433\u0443 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0430\u0434 \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a\u0456 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0431\u044b\u045e \u0442\u0430\u0434\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f \u0456 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u045e \u0443 \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u0445. \u0401\u043d \u2013 \u0430\u0431\u0430\u0440\u043e\u043d\u0446\u0430 \u0432\u0435\u0440\u044b. \u0401\u043d \u0434\u0430\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u043a\u043e\u043b\u044c\u043a\u0456 \u043a\u043e\u0436\u043d\u044b \u0437\u0434\u043e\u043b\u044c\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u0446\u044c. \u0401\u043d \u0431\u044b\u045e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u044b \u045e \u0447\u0430\u0441 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e; \u0401\u043d \u043f\u0430\u0434\u043d\u044f\u045e, \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u045e, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0437\u043c\u0430\u0433\u0430\u0440\u043e\u045e \u0456 \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0430\u045e \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0456\u043c\u044f. \u0401\u043d, \u044f\u043a\u0456 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441 \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0441\u043c\u0435\u0440\u0446\u044c, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435 \u045e \u043d\u0430\u0441.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041e \u044f\u043a\u0456 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u043d\u0430\u0448 \u041a\u0430\u0441\u0446\u0451\u043b, \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b \u0431\u043b\u044f\u0441\u043a\u0430\u043c \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u044f\u043a\u0456 \u045e \u043d\u0430\u0448 \u0447\u0430\u0441 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e. \u0414\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0431\u044b\u045e \u0441\u043d\u0435\u0436\u043d\u0430\u0431\u0435\u043b\u044b\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u045e\u0447\u044b\u043d\u043a\u0430\u043c \u0431\u0440\u0430\u0442\u043e\u045e, \u0446\u044f\u043f\u0435\u0440 \u0443 \u043a\u0440\u044b\u0432\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0441\u0442\u0430\u045e \u043f\u0443\u0440\u043f\u0443\u0440\u043e\u0432\u044b\u043c. \u0421\u044f\u0440\u043e\u0434 \u043a\u0432\u0435\u0442\u0430\u043a \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0451\u0441\u0446\u044c \u0440\u0443\u0436\u044b, \u0451\u0441\u0446\u044c \u043b\u0456\u043b\u0435\u0456. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u0456 \u0442\u043e\u0439, \u0456 \u0434\u0440\u0443\u0433\u043e\u0439 \u0445\u0432\u0430\u043b\u044b. \u041d\u044f\u0445\u0430\u0439 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0431\u0435\u043b\u0443\u044e \u043a\u0430\u0440\u043e\u043d\u0443 \u0437\u0430 \u0441\u0432\u0430\u0435 \u045e\u0447\u044b\u043d\u043a\u0456 \u0430\u0431\u043e \u043f\u0443\u0440\u043f\u0443\u0440\u043e\u0432\u0443\u044e \u0437\u0430 \u0441\u0432\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u043b\u0456 \u043c\u044b \u043f\u0430\u043a\u0443\u0442\u0443\u0435\u043c \u0456 \u0437\u043c\u0430\u0433\u0430\u0435\u043c\u0441\u044f \u0437\u0430 \u0432\u0435\u0440\u0443, \u043d\u0430 \u043d\u0430\u0441 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u0411\u043e\u0433, \u0433\u043b\u044f\u0434\u0437\u044f\u0446\u044c \u042f\u0433\u043e \u0430\u043d\u0451\u043b\u044b, \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u042f\u043a\u0430\u044f \u0436 \u0433\u044d\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u0456 \u044f\u043a\u043e\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u045e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0411\u043e\u0433\u0430 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043a\u0430\u0440\u043e\u043d\u0443 \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430-\u0421\u0443\u0434\u0434\u0437\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0423\u0437\u0431\u0440\u043e\u0456\u043c\u0441\u044f \u045e\u0441\u0456\u043c\u0456 \u0441\u0456\u043b\u0430\u043c\u0456 \u0456 \u0437 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430\u0439 \u0432\u0435\u0440\u0430\u0439 \u0456 \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u0440\u0430\u0441\u043f\u0430\u0447\u043d\u0451\u043c \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435. <\/span><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u042f\u043a\u0430\u044f.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"745","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"margin-left: -14px; text-indent: -14.15pt; padding: 0pt 0pt 0pt 14.15pt;\"><span>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041c\u0430\u043a\u0441\u0456\u043c\u0456\u043b\u044c\u044f\u043d\u0430 \u041c\u0430\u0440\u044b\u0456 \u041a\u043e\u043b\u044c\u0431\u044d<\/span><span><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(O. Joachim Roman Bar, O.F.M. Conv., ed., Wyb\u00f3r Pism, Warszawa 1973, 41-42; 226)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u0435\u0446 \u0432\u044b\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u044f \u0434\u0443\u0448 \u0456 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0432\u0435\u043b\u044c\u043c\u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f, \u0434\u0430\u0440\u0430\u0433\u0456 \u0431\u0440\u0430\u0442, \u0442\u0432\u0430\u0451\u0439 \u043f\u0430\u043b\u044b\u043c\u044f\u043d\u0430\u0439 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u045e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0411\u043e\u0433\u0430. \u041d\u0430\u0432\u0430\u0442 \u0443 \u043d\u0430\u0448 \u0447\u0430\u0441 \u043c\u044b \u0437 \u0441\u0443\u043c\u0430\u043c \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435\u043c \u043d\u0435\u0439\u043a\u0443\u044e \u0445\u0432\u0430\u0440\u043e\u0431\u0443, \u044f\u043a\u0443\u044e \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u044c \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u0430\u0441\u0446\u044e. \u042f\u043d\u0430 \u043f\u0430\u0448\u044b\u0440\u044b\u043b\u0430\u0441\u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u0435\u0446\u043a\u0456\u0445, \u0430\u043b\u0435 \u0456 \u0441\u044f\u0440\u043e\u0434 \u0440\u044d\u043b\u0456\u0433\u0456\u0439\u043d\u044b\u0445 \u0434\u0437\u0435\u044f\u0447\u043e\u045e, \u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435 \u043f\u0430\u0448\u044b\u0440\u0430\u0446\u0446\u0430, \u043d\u0430\u0431\u044b\u0432\u0430\u044e\u0447\u044b \u0440\u043e\u0437\u043d\u044b\u044f \u0444\u043e\u0440\u043c\u044b. \u0406 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u045e\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u043d\u044b \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0439 \u0441\u043b\u0430\u0432\u0430\u0439, \u0442\u043e \u043f\u0435\u0440\u0448\u044b\u043c \u0456 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u044b\u043c \u0434\u043b\u044f \u043d\u0430\u0441, \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0430\u0448\u0430\u0439 \u0433\u0430\u043b\u0435\u0447\u044b, \u0431\u0443\u0434\u0437\u0435 \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u042f\u043c\u0443 \u0433\u044d\u0442\u0443\u044e \u0441\u043b\u0430\u0432\u0443. \u0406 \u0445\u043e\u0446\u044c \u043c\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u045e\u0431\u043e\u0433\u0456\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c, \u0430\u043b\u0435, \u043a\u0430\u043b\u0456 \u0431 \u043c\u044b \u0437\u043c\u0430\u0433\u043b\u0456 \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u0446\u044c \u042f\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u0430, \u0442\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0437\u043c\u043e\u0436\u0430\u043c \u0430\u0434\u0443\u0434\u0437\u044f\u0447\u044b\u0446\u044c \u042f\u043c\u0443 \u0437\u0430 \u0433\u044d\u0442\u0430. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u044f \u0441\u043b\u0430\u0432\u0430 \u043d\u0430\u0439\u044f\u0440\u0447\u044d\u0439 \u0437\u0437\u044f\u0435 \u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0434\u0443\u0448, \u044f\u043a\u0456\u0445 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0441\u0432\u0430\u0451\u0439 \u041a\u0440\u044b\u0432\u0451\u044e, \u0442\u043e \u043d\u044f\u0445\u0430\u0439 \u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0456 \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u044b\u043c \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0435\u043c \u0434\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0441\u0442\u0430\u043d\u0435 \u043a\u043b\u043e\u043f\u0430\u0442 \u043f\u0440\u0430 \u0434\u0430\u0431\u0440\u043e \u044f\u043a \u043c\u0430\u0433\u0430 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456 \u0434\u0443\u0448 \u0456 \u043f\u0440\u0430 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0435 \u0441\u0432\u044f\u0442\u043e\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435. \u042f \u043d\u044f\u043c\u043d\u043e\u0433\u0456\u043c \u0441\u043a\u0430\u0436\u0443, \u044f\u043a\u043e\u0439 \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0434\u0430\u0440\u043e\u0433\u0430 \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u043c\u044d\u0442\u044b, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u2013 \u0434\u0430 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430\u0439 \u0411\u043e\u0436\u0430\u0439 \u0441\u043b\u0430\u0432\u044b \u0456 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u043d\u044f\u043c\u043d\u043e\u0433\u0456\u0445 \u0434\u0443\u0448. \u0411\u043e\u0433, \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u044b\u044f \u0412\u0435\u0434\u044b \u0456 \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u0446\u0430 \u042f\u0433\u043e \u0441\u043b\u0430\u0432\u0430, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u043c\u0456, \u0431\u043e \u0401\u043d \u0432\u0435\u0434\u0430\u0435 \u045e\u0441\u0451 \u0456 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443 \u043f\u0440\u0430\u0437 \u0448\u044d\u0440\u0430\u0433 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0441\u043f\u0440\u0430\u045e, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u044b\u0445 \u0406\u043c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406\u0441\u043d\u0443\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u2013 \u0430\u0434\u0437\u0456\u043d\u0430\u0435, \u0443 \u0447\u044b\u043c \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u0411\u043e\u0436\u0430\u044f \u0432\u043e\u043b\u044f. \u0422\u043e\u0439, \u0445\u0442\u043e \u045e\u0437\u0432\u044b\u0448\u0430\u0435\u0446\u0446\u0430, \u043c\u043e\u0436\u0430 \u043f\u0430\u043c\u044b\u043b\u0456\u0446\u0446\u0430; \u0430\u043b\u0435 \u043a\u0430\u0431 \u043c\u044b, \u044f\u043a\u0456\u044f \u0436\u044b\u0432\u0451\u043c \u0443 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456, \u0442\u0440\u0430\u043f\u0456\u043b\u0456 \u045e \u043f\u0430\u043c\u044b\u043b\u043a\u0456, \u2013 \u0442\u0430\u043a\u043e\u0433\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c. \u0422\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456, \u0434\u0430\u0437\u0432\u043e\u043b\u0435\u043d\u0430 \u043f\u0430\u0434\u043d\u044f\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u045e\u0437\u0432\u044b\u0448\u0430\u0435\u0446\u0446\u0430, \u043f\u0430\u0447\u043d\u0435 \u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0435 \u0411\u043e\u0436\u044b \u0437\u0430\u043a\u043e\u043d \u0446\u0456, \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456, \u0437\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u0432\u043e\u043b\u044e \u0411\u043e\u0433\u0430. \u0423 \u0430\u0434\u0432\u0430\u0440\u043e\u0442\u043d\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443, \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u043d\u0435 \u0431\u044b\u045e \u0431\u044b \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u043c \u042f\u0433\u043e \u0432\u043e\u043b\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e\u0433 \u2013 \u0430\u0434\u0437\u0456\u043d\u044b \u0456 \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u044b, \u043d\u0430\u0439\u043c\u0443\u0434\u0440\u044d\u0439\u0448\u044b, \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u044b \u0456 \u043d\u0430\u0439\u043b\u0430\u0441\u043a\u0430\u0432\u0435\u0439\u0448\u044b, \u041f\u0430\u043d, \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0456 \u043d\u0430\u0448 \u0410\u0439\u0446\u0435\u0446, \u041f\u0430\u0447\u0430\u0442\u0430\u043a \u0456 \u041a\u0430\u043d\u0435\u0446, \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u041c\u043e\u0446 \u0456 \u041b\u044e\u0431\u043e\u045e \u2013 \u0443\u0441\u0451 \u0433\u044d\u0442\u0430 \u0411\u043e\u0433. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0443\u0441\u0451, \u0448\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043f\u0430-\u0437\u0430 \u0411\u043e\u0433\u0430\u043c, \u043c\u0430\u0435 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430, \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u045e\u0441\u044f\u0433\u043e \u0456 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0434\u0430 \u043c\u044d\u0442\u044b \u045e\u0441\u044f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f. \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u043c \u0441\u0432\u0430\u044e \u0432\u043e\u043b\u044e \u043f\u0440\u0430\u0437 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0441\u0432\u0430\u0456\u0445 \u0447\u044b\u043d\u0430\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u0435 \u043d\u0430\u0441 \u0434\u0430 \u0441\u044f\u0431\u0435, \u043c\u0430\u044e\u0447\u044b \u043d\u0430\u043c\u0435\u0440 \u043f\u0440\u0430\u0437 \u043d\u0430\u0441 \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443\u0446\u044c \u0434\u0430 \u0441\u044f\u0431\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u044f \u0434\u0443\u0448\u044b \u0456 \u0437\u043b\u0443\u0447\u044b\u0446\u044c \u0456\u0445 \u0437 \u0441\u0430\u0431\u043e\u044e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u043b\u044f\u0434\u0437\u0456, \u0431\u0440\u0430\u0442, \u044f\u043a\u0443\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u043c\u0430\u0435 \u043d\u0430\u0448 \u0441\u0442\u0430\u043d \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u041f\u0440\u0430\u0437 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456 \u043c\u044b \u0434\u0430\u0441\u044f\u0433\u0430\u0435\u043c \u043c\u0435\u0436\u0430\u045e \u043d\u0430\u0448\u0430\u0439 \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u0430\u0441\u0446\u0456 \u0456 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0435\u043c; \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u0434\u0431\u0430\u0447\u043b\u0456\u0432\u0430\u044f \u0432\u043e\u043b\u044f, \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u044f \u045e \u0441\u0432\u0430\u0451\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0432\u044f\u0434\u0437\u0435 \u043d\u0430\u0441 \u0432\u0435\u0440\u043d\u044b\u043c \u0448\u043b\u044f\u0445\u0430\u043c. \u041d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u044f \u0433\u044d\u0442\u0430\u0439 \u0432\u043e\u043b\u0456, \u0431\u0435\u0437 \u044f\u043a\u043e\u0439 \u043d\u0456\u0448\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430 \u0456 \u044f\u043a\u0443\u044e \u043d\u0456\u0448\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u043f\u044b\u043d\u0456\u0446\u044c, \u043c\u044b \u0441\u0442\u0430\u043d\u0435\u043c \u0431\u043e\u043b\u044c\u0448 \u043c\u043e\u0446\u043d\u044b\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u044b \u0448\u043b\u044f\u0445 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u2013 \u0430\u0434\u0437\u0456\u043d\u044b \u0448\u043b\u044f\u0445, \u043d\u0430 \u044f\u043a\u0456\u043c \u043c\u044b \u0437\u043c\u043e\u0436\u0430\u043c \u0430\u0434\u0434\u0430\u0446\u044c \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0443\u044e \u0445\u0432\u0430\u043b\u0443 \u0411\u043e\u0433\u0443. \u041a\u0430\u043b\u0456 \u0456 \u0451\u0441\u0446\u044c \u0456\u043d\u0448\u0430\u044f, \u043b\u0435\u043f\u0448\u0430\u044f \u0434\u0430\u0440\u043e\u0433\u0430, \u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c, \u0431\u0435\u0437\u0443\u043c\u043e\u045e\u043d\u0430, \u043d\u0430\u043c \u0431\u044b \u044f\u0435 \u043f\u0430\u043a\u0430\u0437\u0430\u045e. \u042f\u0433\u043e \u0441\u043f\u043e\u0441\u0430\u0431 \u0436\u044b\u0446\u0446\u044f \u045e \u041d\u0430\u0437\u0430\u0440\u044d\u0446\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u0430\u043f\u0456\u0441\u0432\u0430\u0435 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c: \u00ab\u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b i\u043c\u00bb (\u041b\u043a 2, 51). \u0413\u044d\u0442\u044b \u0436\u044b\u0446\u0446\u044f\u043f\u0456\u0441 \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043d\u0430\u0441 \u0437\u043d\u0430\u043a\u0430\u043c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456, \u044f\u043a\u043e\u0439 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u045e\u0441\u044f \u0401\u043d, \u044f\u043a\u0456 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u043f\u0430 \u0440\u043e\u0437\u043d\u044b\u0445 \u043c\u0435\u0441\u0446\u0430\u0445, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b \u0432\u043e\u043b\u044e \u0410\u0439\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u044b\u043a \u0443\u0441\u043b\u0430\u0432\u0456\u043c, \u0431\u0440\u0430\u0442\u044b, \u0443\u0441\u043b\u0430\u0432\u0456\u043c \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, \u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u0448\u0430\u044f \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0441\u0442\u0430\u043d\u0435 \u0434\u043e\u043a\u0430\u0437\u0430\u043c \u043f\u0430\u0448\u0430\u043d\u044b \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u0434\u0430 \u044f\u043a\u043e\u0439 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430; \u044f\u043d\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0446\u0430 \u0430\u0434 \u043d\u0430\u0441 \u043f\u0430 \u043f\u0430\u0448\u0430\u0439 \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u0432\u043e\u043b\u0456 \u044f\u043a \u043d\u0430\u0448 \u0430\u0445\u0432\u044f\u0440\u043d\u044b \u0434\u0430\u0440. \u0406 \u043c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u043d\u0451\u0441\u043b\u0430\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u043d\u0430\u043c \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0446\u0446\u0430 \u045e \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0447\u044b\u043c \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0431\u043e\u043b\u044c\u0448 \u043f\u043e\u045e\u043d\u0430 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u0446\u0430 \u045e\u0441\u0456\u043c \u043f\u0440\u0430\u0437 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0443\u044e \u041f\u0430\u043d\u043d\u0443, \u044f\u043a\u0443\u044e \u0411\u043e\u0433 \u0432\u0435\u043b\u044c\u043c\u0456 \u0448\u0447\u043e\u0434\u0440\u0430 \u0430\u0434\u0430\u0440\u044b\u045e \u0441\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e. \u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u043d\u0430\u0439\u0433\u043b\u044b\u0431\u0435\u0439\u0448\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u041c\u0430\u0440\u044b\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0430\u043c\u044b\u043c \u043f\u0430\u0442\u0430\u0435\u043c\u043d\u044b\u043c \u0411\u043e\u0436\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c. \u0406 \u043a\u0430\u043b\u0456 \u0431\u0430\u0447\u044b\u043c, \u0448\u0442\u043e \u043c\u044b \u2013 \u043f\u0440\u044b\u043b\u0430\u0434\u0430 \u045e \u0440\u0443\u043a\u0430\u0445 \u0411\u043e\u0433\u0430, \u0442\u043e \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e \u043d\u0430\u0441 \u0431\u043e\u043b\u044c\u0448 \u043f\u043b\u0451\u043d\u043d\u0430. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043c\u044b \u045e\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u0435\u043c, \u0448\u0442\u043e \u042f\u043d\u0430 \u043a\u0456\u0440\u0443\u0435 \u043d\u0430\u043c\u0456, \u0456 \u043c\u044b, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b\u044f \u0456 \u0431\u0435\u0441\u0442\u0443\u0440\u0431\u043e\u0442\u043d\u044b\u044f, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c\u0441\u044f \u043f\u0430\u0434 \u042f\u0435 \u0430\u043f\u0435\u043a\u0430\u0439. \u042f\u043d\u0430 \u043d\u0430\u0433\u043b\u044f\u0434\u0430\u0435 \u0437\u0430 \u043d\u0430\u043c\u0456, \u0441\u0430\u043c\u0430 \u0430\u0431\u0435\u0440\u0430\u0433\u0430\u0435 \u043d\u0430\u0441, \u0433\u0430\u0442\u043e\u0432\u0430\u044f \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443 \u0446\u0435\u043b\u0443 \u0456 \u043d\u0430\u0448\u0430\u0439 \u0434\u0443\u0448\u044b, \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u0456 \u0456 \u0432\u044b\u0440\u0430\u045e\u043d\u043e\u045e\u0432\u0430\u0435 \u043d\u044f\u0440\u043e\u045e\u043d\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0444 5, 1-2; 6, 6b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u041d\u0430\u0441\u043b\u0435\u0434\u0443\u0439\u0446\u0435 \u0411\u043e\u0433\u0430, \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043d\u0430\u0441 <\/span><span style=\"color: #ff00ff;\">*<\/span><span> \u044f\u043a \u0434\u0430\u0440 \u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u0411\u043e\u0433\u0443 \u043d\u0430 \u043f\u0440\u044b\u0435\u043c\u043d\u044b \u043f\u0430\u0445.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0421\u043b\u0443\u0436\u044b\u0446\u0435, \u044f\u043a \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u044f \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0456, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b \u0411\u043e\u0436\u0443\u044e \u0432\u043e\u043b\u044e \u0430\u0434 \u0434\u0443\u0448\u044b. <\/span><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u042f\u043a \u0434\u0430\u0440.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"746","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u00abMunificent\u00edssimus Deus\u00bb \u043f\u0430\u043f\u044b \u041f\u0456\u044f \u0425\u0406\u0406<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(AAS 42 [1950], 760-762. 767-769)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0426\u0435\u043b\u0430 \u0422\u0432\u0430\u0451 \u2013 \u0441\u0432\u044f\u0442\u043e\u0435 \u0456 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0439\u0446\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0456 \u045e \u0433\u0430\u043c\u0456\u043b\u0456\u044f\u0445 \u0456 \u043a\u0430\u0437\u0430\u043d\u043d\u044f\u0445, \u044f\u043a\u0456\u044f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434\u0443 \u0437 \u043d\u0430\u0433\u043e\u0434\u044b \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0441\u0432\u044f\u0442\u0430, \u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0440\u0430 \u045e\u043d\u0435\u0431\u0430\u045e\u0437\u044f\u0446\u0446\u0435 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044b \u044f\u043a \u0430\u0431 \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0432\u044f\u0434\u043e\u043c\u0430\u0439 \u0432\u0435\u0440\u043d\u044b\u043c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c, \u044f\u043a\u0443\u044e \u044f\u043d\u044b \u043f\u0440\u044b\u043c\u0430\u044e\u0446\u044c. \u0422\u043b\u0443\u043c\u0430\u0447\u044b\u043b\u0456 \u044f\u0435 \u043f\u0430\u0434\u0440\u0430\u0431\u044f\u0437\u043d\u0430 \u0456 \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0433\u0440\u0443\u043d\u0442\u043e\u045e\u043d\u044b\u0445 \u0442\u044d\u0430\u043b\u0430\u0433\u0456\u0447\u043d\u044b\u0445 \u0434\u043e\u043a\u0430\u0437\u0430\u045e \u0440\u0430\u0441\u043a\u0440\u044b\u0432\u0430\u043b\u0456 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0456 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u0430\u045e\u0434\u044b. \u0413\u044d\u0442\u0430\u0435 \u0441\u0432\u044f\u0442\u0430 \u2013 \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0432\u0430\u043b\u0456 \u044f\u043d\u044b \u045e \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443 \u2013 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0446\u0435\u043b\u0430 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u041f\u0430\u043d\u043d\u044b \u041c\u0430\u0440\u044b\u0456 \u0431\u044b\u043b\u043e \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u0430\u0435 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0442\u043b\u0435\u043d\u043d\u044f, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u0430\u0435 \u0441\u0432\u044f\u0442\u0430 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u042f\u0435 \u0442\u0440\u044b\u0443\u043c\u0444 \u043d\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e \u043d\u0435\u0431\u0435 \u043d\u0430 \u045e\u0437\u043e\u0440 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0441\u0432. \u042f\u043d \u0414\u0430\u043c\u0430\u0441\u043a\u0456\u043d, \u0441\u0430\u043c\u044b \u0441\u043b\u0430\u0432\u0443\u0442\u044b \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u0430\u045e\u0434\u044b, \u043f\u0430\u0440\u0430\u045e\u043d\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435 \u0423\u043d\u0435\u0431\u0430\u045e\u0437\u044f\u0446\u0446\u0435 \u041c\u0430\u0446\u0456 \u0411\u043e\u0436\u0430\u0439 \u0437 \u042f\u0435 \u0456\u043d\u0448\u044b\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456 \u0456 \u043f\u0440\u044b\u0432\u0456\u043b\u0435\u044f\u043c\u0456, \u0433\u043e\u0440\u0430\u0447\u0430 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435: \u00ab\u041d\u0430\u043b\u0435\u0436\u0430\u043b\u0430, \u043a\u0430\u0431 \u0422\u0430\u044f, \u044f\u043a\u0430\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0417\u0431\u0430\u045e\u0446\u0443, \u0437\u0430\u0445\u0430\u0432\u0430\u045e\u0448\u044b \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430, \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0442\u043b\u0435\u043d\u043d\u044f \u0446\u0435\u043b\u0430. \u041d\u0430\u043b\u0435\u0436\u0430\u043b\u0430, \u043a\u0430\u0431 \u0422\u0430\u044f, \u044f\u043a\u0430\u044f \u045e \u0441\u0432\u0430\u0456\u043c \u0443\u043b\u043e\u043d\u043d\u0456 \u043d\u0430\u0441\u0456\u043b\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u044f\u043a \u041d\u0435\u043c\u0430\u045e\u043b\u044f, \u0431\u044b\u043b\u0430 \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u044f \u045e \u0411\u043e\u0436\u044b\u044f \u0441\u044f\u043b\u0456\u0431\u044b. \u041d\u0430\u043b\u0435\u0436\u0430\u043b\u0430, \u043a\u0430\u0431 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430 \u0410\u0439\u0446\u0430 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u043f\u0430\u043a\u043e\u044f\u0445. \u041d\u0430\u043b\u0435\u0436\u0430\u043b\u0430, \u043a\u0430\u0431 \u041c\u0430\u0446\u0456, \u044f\u043a\u0430\u044f \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0430 \u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u043f\u0440\u044b\u0431\u0456\u0442\u0430\u0433\u0430 \u0434\u0430 \u043a\u0440\u044b\u0436\u0430, \u0456 \u0441\u044d\u0440\u0446\u0430 \u044f\u043a\u043e\u0439 \u043f\u0440\u0430\u0446\u044f\u045e \u043c\u0435\u0447 \u0431\u043e\u043b\u044e, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b \u0401\u0439 \u0443 \u043c\u043e\u043c\u0430\u043d\u0442 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0417\u0431\u0430\u045e\u0446\u044b, \u0443\u0431\u0430\u0447\u044b\u043b\u0430, \u044f\u043a \u0401\u043d \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u0439\u0446\u043e\u043c \u0443 \u043d\u0435\u0431\u0435. \u041d\u0430\u043b\u0435\u0436\u0430\u043b\u0430, \u043a\u0430\u0431 \u041c\u0430\u0446\u0456 \u0411\u043e\u0433\u0430 \u043c\u0435\u043b\u0430 \u045e\u0441\u0451 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u042f\u0435 \u0421\u044b\u043d\u0443, \u043a\u0430\u0431 \u044f\u043a \u041c\u0430\u0446\u0456 \u0456 \u0421\u043b\u0443\u0433\u0443 \u0411\u043e\u0433\u0430 \u042f\u0435 \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u043b\u0430 \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0432. \u0413\u0435\u0440\u043c\u0430\u043d \u041a\u0430\u043d\u0441\u0442\u0430\u043d\u0442\u044b\u043d\u043e\u043f\u0430\u043b\u044c\u0441\u043a\u0456 \u043b\u0456\u0447\u044b\u045e, \u0448\u0442\u043e \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0430\u0434 \u0442\u043b\u0435\u043d\u043d\u044f \u0446\u0435\u043b\u0430 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044b \u0456 \u042f\u0435 \u045e\u043d\u0435\u0431\u0430\u045e\u0437\u044f\u0446\u0446\u0435 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u042f\u0435 \u0411\u043e\u0436\u0430\u043c\u0443 \u043c\u0430\u0446\u044f\u0440\u044b\u043d\u0441\u0442\u0432\u0443, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u042f\u0435 \u0434\u0437\u044f\u0432\u043e\u0447\u0430\u0433\u0430 \u0446\u0435\u043b\u0430. \u00ab\u0422\u044b, \u2013 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u041f\u0456\u0441\u0430\u043d\u043d\u044f, \u2013 \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u0448 \u043f\u043e\u045e\u043d\u0430\u044f \u0441\u043b\u0430\u0432\u044b (\u043f\u0430\u0440. \u041f\u0441 45 [44], 14). \u0422\u0432\u0430\u0451 \u0434\u0437\u044f\u0432\u043e\u0447\u0430\u0435 \u0446\u0435\u043b\u0430 \u045e\u0441\u0451 \u0441\u0432\u044f\u0442\u043e\u0435, \u0443\u0441\u0451 \u0447\u044b\u0441\u0442\u0430\u0435, \u0443\u0441\u0451 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0436\u044b\u043b\u043b\u0451\u043c \u0411\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u0446\u0430 \u045e \u043f\u044b\u043b, \u0430\u043b\u0435 \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u0435\u043d\u0430 \u0434\u0430 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0413\u044d\u0442\u0430 \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u0436\u044b\u0432\u043e\u0435 \u0446\u0435\u043b\u0430, \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0435, \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0435, \u0430\u0434\u043e\u0440\u0430\u043d\u0430\u0435 \u0432\u0435\u0447\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u043d\u043e\u045e \u0436\u0430, \u0456\u043d\u0448\u044b \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u044b \u0430\u045e\u0442\u0430\u0440 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435: \u00ab\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u041c\u0430\u0440\u044b\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0439\u0441\u043b\u0430\u045e\u043d\u0435\u0439\u0448\u0430\u0439 \u041c\u0430\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b \u0456 \u0411\u043e\u0433\u0430, \u0414\u0430\u045e\u0446\u044b \u0436\u044b\u0446\u0446\u044f \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456, \u0442\u0430\u043c\u0443 \u0430\u0434 \u042f\u0433\u043e \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0456 \u0437 \u0406\u043c \u043d\u0430 \u0432\u044f\u043a\u0456 \u043f\u0430\u0434\u0437\u044f\u043b\u044f\u0435 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c \u0446\u0435\u043b\u0430. \u0413\u044d\u0442\u0430 \u0401\u043d \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u042f\u0435 \u0437 \u0433\u0440\u043e\u0431\u0443 \u0456 \u043f\u0440\u044b\u043d\u044f\u045e \u0434\u0430 \u0441\u044f\u0431\u0435 \u0432\u044f\u0434\u043e\u043c\u044b\u043c \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0430\u0431\u0435 \u0447\u044b\u043d\u0430\u043c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0434\u043e\u043a\u0430\u0437\u044b \u0456 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0456 \u0441\u0432\u044f\u0442\u044b\u0445 \u0410\u0439\u0446\u043e\u045e \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u044e\u0446\u0446\u0430 \u043d\u0430 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u044f\u043a \u043d\u0430 \u043f\u0435\u0440\u0448\u0430\u043a\u0440\u044b\u043d\u0456\u0446\u0443. \u042f\u043d\u043e \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0448\u044b\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430 \u041c\u0430\u0446\u0456 \u0411\u043e\u0433\u0430, \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u0443\u044e \u0441\u0430\u043c\u044b\u043c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0437 \u0411\u043e\u0436\u044b\u043c \u0421\u044b\u043d\u0430\u043c, \u044f\u043a\u0430\u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0434\u0437\u044f\u043b\u044f\u0435 \u042f\u0433\u043e\u043d\u044b \u043b\u0451\u0441.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u0448\u0442\u043e \u0437 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0441\u0442\u0430\u0433\u043e\u0434\u0434\u0437\u044f \u0410\u0439\u0446\u044b \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0414\u0437\u0435\u0432\u0443 \u041c\u0430\u0440\u044b\u044e \u044f\u043a \u043d\u043e\u0432\u0443\u044e \u0415\u0432\u0443; \u0445\u043e\u0446\u044c \u0456 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0443\u044e \u043d\u043e\u0432\u0430\u043c\u0443 \u0410\u0434\u0430\u043c\u0443, \u0430\u0434\u043d\u0430\u043a \u0432\u0435\u043b\u044c\u043c\u0456 \u043c\u043e\u0446\u043d\u0430 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u0443\u044e \u0437 \u0406\u043c \u0443 \u042f\u0433\u043e \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0437 \u0432\u0435\u0447\u043d\u044b\u043c \u0432\u043e\u0440\u0430\u0433\u0430\u043c. \u0413\u044d\u0442\u0430\u0435 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u0435\u043c \u041f\u0440\u043e\u0442\u0430\u0435\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u0446\u0446\u0430 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0439 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430\u0439 \u043d\u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u043c \u0456 \u0441\u043c\u0435\u0440\u0446\u044e, \u044f\u043a\u0456\u044f \u045e \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f\u0445 \u0441\u0432. \u041f\u0430\u045e\u043b\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0432\u044b\u0441\u0442\u0443\u043f\u0430\u044e\u0446\u044c \u0440\u0430\u0437\u0430\u043c. \u0422\u0430\u043c\u0443, \u044f\u043a \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u043b\u0430\u0441\u044f \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044e \u0456 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0439 \u0437\u0434\u0430\u0431\u044b\u0447\u0430\u0439 \u0433\u044d\u0442\u0430\u0439 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456, \u0442\u0430\u043a \u0456 \u045e\u0434\u0437\u0435\u043b \u0414\u0437\u0435\u0432\u044b \u045e \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0421\u044b\u043d\u0430 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u0446\u0446\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0434\u0437\u044f\u0432\u043e\u0447\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430: \u00ab\u041a\u0430\u043b\u0456 \u0436 \u0442\u043b\u0435\u043d\u043d\u0430\u0435 \u0430\u043f\u0440\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c, \u0442\u0430\u0434\u044b \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u0435 \u0441\u043b\u043e\u0432\u0430: \u201c\u041f\u0435\u0440\u0430\u043c\u043e\u0433\u0430 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u044c\u201d\u00bb (1 \u041a\u0430\u0440 15, 54).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u041c\u0430\u0446\u0456 \u0411\u043e\u0433\u0430, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u043d\u0430\u043c\u0435\u0440\u0430\u043c \u041f\u0440\u043e\u0432\u0456\u0434\u0443 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0431\u044b\u043b\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u0430\u044f \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439 \u0443 \u0437\u0430\u0447\u0430\u0446\u0446\u0456, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439 \u0414\u0437\u0435\u0432\u0430\u0439 \u0443 \u0411\u043e\u0441\u043a\u0456\u043c \u043c\u0430\u0446\u044f\u0440\u044b\u043d\u0441\u0442\u0432\u0435, \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0441\u044f\u0431\u0440\u043e\u045e\u043a\u0430\u0439 \u0411\u043e\u0441\u043a\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b, \u044f\u043a\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043f\u043e\u045e\u043d\u0443\u044e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043d\u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u043c \u0456 \u044f\u0433\u043e \u043d\u0430\u0441\u0442\u0443\u043f\u0441\u0442\u0432\u0430\u043c\u0456. \u042f\u043d\u0430 \u0437\u0434\u0430\u0431\u044b\u043b\u0430, \u044f\u043a \u043d\u0430\u0439\u0446\u0443\u0434\u043e\u045e\u043d\u0435\u0439\u0448\u0430\u0435 \u045e\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u045e\u0434\u0437\u0435\u043b\u0435\u043d\u044b\u0445 \u0451\u0439 \u043f\u0440\u044b\u0432\u0456\u043b\u0435\u044f\u045e, \u0434\u0430\u0440 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456 \u0446\u0435\u043b\u0430, \u0456 \u0442\u0430\u043a \u044f\u043a \u0421\u044b\u043d, \u043f\u0430\u0441\u043b\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456 \u043d\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u0431\u044b\u043b\u0430 \u0437 \u0446\u0435\u043b\u0430\u043c \u0456 \u0434\u0443\u0448\u043e\u044e \u045e\u0437\u043d\u0435\u0441\u0435\u043d\u0430\u044f \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0445\u0432\u0430\u043b\u044b, \u043a\u0430\u0431 \u0442\u0430\u043c \u0437\u0430\u0437\u0437\u044f\u0446\u044c \u044f\u043a \u041a\u0430\u0440\u0430\u043b\u0435\u0432\u0430, \u044f\u043a\u0430\u044f \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u041a\u0430\u0440\u0430\u043b\u044f \u0432\u044f\u043a\u043e\u045e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0412\u043e\u0441\u044c \u043d\u0430\u0441\u0442\u0430\u045e \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u0414\u0437\u0435\u0432\u0430 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0430 \u0431\u044b\u043b\u0430 \u045e\u0437\u044f\u0442\u0430\u044f \u045e \u043d\u0435\u0431\u0430; \u0441\u043b\u0430\u0432\u044f\u0447\u044b, \u042f\u0435, \u0443\u0441\u0435 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c:&nbsp;<\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0422\u044b \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043f\u043b\u043e\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u0422\u044b, \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u044f \u041f\u0430\u043d\u043d\u0430 \u041c\u0430\u0440\u044b\u044f, \u0456 \u0433\u043e\u0434\u043d\u0430\u044f \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0445\u0432\u0430\u043b\u044b, \u0431\u043e \u0437 \u0426\u044f\u0431\u0435 \u0432\u044b\u0439\u0448\u043b\u0430 \u0421\u043e\u043d\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043d\u0430\u0448 \u0411\u043e\u0433. <\/span><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"747","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u0432. \u0421\u0442\u044d\u0444\u0430\u043d\u0430 \u0434\u043b\u044f \u0441\u044b\u043d\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 1. 2. 10: PL 151, 1236-1237. 1242-1244)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0441\u044b\u043d\u0435, \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0439\u0446\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c, \u043c\u043e\u0439 \u0434\u0430\u0440\u0430\u0433\u0456 \u0441\u044b\u043d, \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u044e, \u0440\u0430\u044e, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u044e: \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0445\u0432\u0430\u043b\u0443 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0439 \u043a\u0430\u0440\u043e\u043d\u0435, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0443\u044e \u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0443\u044e \u0432\u0435\u0440\u0443 \u0437 \u0442\u0430\u043a\u0456\u043c \u0430\u0434\u0434\u0430\u043d\u043d\u0435\u043c \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0441\u0446\u044e, \u043a\u0430\u0431 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u043f\u0430\u0434\u0434\u0430\u043d\u044b\u0445 \u0442\u044b \u0431\u044b\u045e \u0443 \u0411\u043e\u0433\u0443 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c, \u0456 \u043a\u0430\u0431 \u0443\u0441\u0435 \u043b\u044e\u0434\u0437\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0431\u0430\u0447\u044b\u043b\u0456 \u045e \u0442\u0430\u0431\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u0435\u0437 \u0447\u0430\u0433\u043e, \u044f\u043a \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0435\u0448, \u0442\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u0448 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u0446\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430\u043c \u0456 \u0441\u044b\u043d\u0430\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0423 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u043c \u043f\u0430\u043b\u0430\u0446\u044b \u0434\u0440\u0443\u0433\u043e\u0435 \u043c\u0435\u0441\u0446\u0430 \u043f\u0430\u0441\u043b\u044f \u0432\u0435\u0440\u044b \u0437\u0430\u0439\u043c\u0430\u0435 \u041a\u0430\u0441\u0446\u0451\u043b, \u043f\u0430\u0441\u0430\u0434\u0436\u0430\u043d\u044b \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u0430\u0448\u044b\u043c \u0413\u0430\u043b\u0430\u0432\u043e\u0439, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0430 \u043f\u0430\u0441\u043b\u044f, \u043f\u0440\u044b\u0448\u0447\u044d\u043f\u043b\u0435\u043d\u044b \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0447\u043b\u0435\u043d\u0430\u043c\u0456, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456 \u0456 \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0410\u0439\u0446\u0430\u043c\u0456, \u043c\u043e\u0446\u043d\u0430 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u0456 \u043f\u0430\u0448\u044b\u0440\u0430\u043d\u044b \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435. \u0406 \u0445\u043e\u0446\u044c \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u0451\u043d \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u043d\u043e\u0432\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439, \u0430\u0434\u043d\u0430\u043a \u0443 \u043f\u044d\u045e\u043d\u044b\u0445 \u043c\u0435\u0441\u0446\u0430\u0445 \u043c\u043e\u0436\u0430 \u0437\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0441\u0442\u0430\u0440\u044b\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u0434\u0430\u0440\u0430\u0433\u0456 \u043c\u043e\u0439 \u0441\u044b\u043d\u0435, \u0443 \u043d\u0430\u0448\u044b\u043c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u044f\u0448\u0447\u044d \u043c\u0430\u043b\u0430\u0434\u044b\u043c, \u0431\u043e \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0435 \u044f\u0448\u0447\u044d \u043d\u0435 \u0442\u0430\u043a \u0434\u0430\u045e\u043d\u043e. \u0422\u0430\u043c\u0443 \u043f\u0456\u043b\u044c\u043d\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0432\u0435\u043b\u044c\u043c\u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u044b\u0445 \u0456 \u045e\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u0445 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u043e\u045e. \u0413\u043b\u044f\u0434\u0437\u0456, \u043a\u0430\u0431 \u0434\u0430\u0431\u0440\u043e, \u044f\u043a\u043e\u0435 \u045e\u0434\u0437\u044f\u043b\u044f\u0435 \u043d\u0430\u043c \u0411\u043e\u0436\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0431\u0435\u0437 \u043d\u0430\u0448\u044b\u0445 \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u045e, \u043d\u0435 \u0431\u044b\u043b\u043e \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u043d\u0430 \u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0442\u0432\u0430\u0439\u0433\u043e \u0431\u044f\u0437\u0434\u0437\u0435\u044f\u043d\u043d\u044f, \u043b\u044f\u043d\u043e\u0442\u044b \u0456 \u043d\u044f\u0434\u0431\u0430\u0439\u043d\u0430\u0441\u0446\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u0441\u044b\u043d\u0435, \u0430\u0441\u0430\u043b\u043e\u0434\u0430 \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u043d\u0430\u0434\u0437\u0435\u044f \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430, \u043f\u0440\u0430\u0448\u0443 \u0446\u044f\u0431\u0435 \u0456 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u044e, \u043a\u0430\u0431 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0456 \u0430\u0431\u0441\u0442\u0430\u0432\u0456\u043d\u0430\u0445 \u0442\u044b \u043a\u0456\u0440\u0430\u0432\u0430\u045e\u0441\u044f \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u044e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430 \u0440\u043e\u0434\u043d\u044b\u0445, \u043a\u043d\u044f\u0437\u0451\u045e, \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u045e, \u0437\u0430\u043c\u043e\u0436\u043d\u044b\u0445, \u0431\u043b\u0456\u0437\u043a\u0456\u0445 \u0456 \u0441\u0443\u0430\u0439\u0447\u044b\u043d\u043d\u0456\u043a\u0430\u045e, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430 \u0447\u0443\u0436\u044b\u0445 \u0456 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435. \u0417\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u0435 \u0434\u0430\u0431\u0440\u0430 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f. \u0411\u0443\u0434\u0437\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0434\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0433\u0432\u0430\u043b\u0442, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u0430\u044e\u0447\u044b \u045e \u0441\u044d\u0440\u0446\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b \u041f\u0430\u043d\u0430\u043c: \u00ab\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0445\u0430\u0447\u0443, \u0430 \u043d\u0435 \u0430\u0445\u0432\u044f\u0440\u044b\u00bb (\u041c\u0446 9, 13). \u0411\u0443\u0434\u0437\u044c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b \u0434\u0430 \u045e\u0441\u0456\u0445, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430 \u043c\u043e\u0446\u043d\u044b\u0445, \u0430\u043b\u0435 \u0456 \u0434\u0430 \u0441\u043b\u0430\u0431\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0440\u044d\u0448\u0446\u0435, \u0431\u0443\u0434\u0437\u044c \u043c\u0443\u0436\u043d\u044b\u043c; \u043d\u044f\u0445\u0430\u0439 \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442 \u043d\u0435 \u0437\u0440\u043e\u0431\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u043f\u044b\u0445\u043b\u0456\u0432\u044b\u043c, \u0430 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b \u043d\u0435 \u0437\u043b\u0430\u043c\u0430\u044e\u0446\u044c \u0442\u0432\u043e\u0439 \u0434\u0443\u0445. \u0411\u0443\u0434\u0437\u044c \u043f\u0430\u043a\u043e\u0440\u043d\u044b, \u043a\u0430\u0431 \u0411\u043e\u0433 \u0443\u0437\u0432\u044b\u0441\u0456\u045e \u0446\u044f\u0431\u0435 \u0446\u044f\u043f\u0435\u0440 \u0456 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u0456. \u0411\u0443\u0434\u0437\u044c \u043f\u0430\u043c\u044f\u0440\u043a\u043e\u045e\u043d\u044b. \u041d\u0456\u043a\u043e\u0433\u0430 \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430 \u043d\u0435 \u043a\u0430\u0440\u0430\u0439 \u0456 \u043d\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u0439. \u0411\u0443\u0434\u0437\u044c \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u044b, \u043a\u0430\u0431 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0430\u0440\u0443\u0448\u044b\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0411\u0443\u0434\u0437\u044c \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b, \u043a\u0430\u0431 \u043d\u0456\u043a\u0456\u043c \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u0446\u044c, \u043f\u0430\u0434\u0434\u0430\u045e\u0448\u044b\u0441\u044f \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u043c. \u0411\u0443\u0434\u0437\u044c \u0447\u044b\u0441\u0442\u044b, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c \u0430\u0434\u0434\u0430\u043b\u0456\u0446\u044c \u0443\u0441\u0435 \u0441\u043f\u0430\u043a\u0443\u0441\u044b \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0433\u044d\u0442\u044b\u044f \u0448\u044b\u043f\u044b \u0441\u043c\u0435\u0440\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0434\u043e\u0431\u0440\u044b\u044f \u044f\u043a\u0430\u0441\u0446\u0456 \u045e\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0443\u044e \u043a\u0430\u0440\u043e\u043d\u0443; \u0431\u0435\u0437 \u0456\u0445 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0430\u043d\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0442\u0443\u0442 \u044f\u043a \u0442\u0440\u044d\u0431\u0430, \u0430\u043d\u0456 \u0434\u0430\u0439\u0441\u0446\u0456 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff00ff;\"> <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440.<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\">\u0422\u043e\u0431 4, 8; \u0421\u0456\u0440 35, 11\u0430. 12\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u041a\u0430\u043b\u0456 \u045e \u0446\u044f\u0431\u0435 \u0431\u0443\u0434\u0437\u0435 \u043b\u0456\u0448\u0430\u043a, \u0434\u0430\u0432\u0430\u0439 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443, <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0456 \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u043c\u0435\u0446\u044c \u043c\u0430\u043b\u0430, \u043d\u0435 \u0431\u043e\u0439\u0441\u044f \u0434\u0430\u0432\u0430\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443 \u0456 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u041f\u0440\u044b \u043a\u043e\u0436\u043d\u044b\u043c \u0434\u0430\u0440\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0432\u044f\u0441\u0451\u043b\u044b\u043c \u0442\u0432\u0430\u0440 \u0441\u0432\u043e\u0439; \u0434\u0430\u0439 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u043c\u0443, \u044f\u043a \u0401\u043d \u0434\u0430\u0435 \u0442\u0430\u0431\u0435. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406 \u043a\u0430\u043b\u0456.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"748","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u041f\u0440\u0430 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0435 \u0421\u044d\u0440\u0446\u0430 \u0415\u0437\u0443\u0441\u0430\u00bb \u0441\u0432. \u042f\u043d\u0430 \u042d\u0434\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 1, 5: Opera omnia 6, 107. 113-115)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u0440\u044b\u043d\u0456\u0446\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0448\u0443 \u0446\u044f\u0431\u0435, \u043f\u0430\u043c\u044f\u0442\u0430\u0439, \u0448\u0442\u043e \u043d\u0430\u0448 \u041f\u0430\u043d, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u0432\u0430\u0451\u0439 \u0413\u0430\u043b\u0430\u0432\u043e\u0439, \u0430 \u0442\u044b \u2013 \u0430\u0434\u043d\u044b\u043c \u0437 \u042f\u0433\u043e \u0447\u043b\u0435\u043d\u0430\u045e. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0442\u0430\u0431\u0435, \u044f\u043a \u0433\u0430\u043b\u0430\u0432\u0430 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0446\u0435\u043b\u0443. \u0423\u0441\u0451, \u0448\u0442\u043e \u0401\u043d \u043c\u0430\u0435, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0442\u0432\u0430\u0456\u043c: \u0434\u0443\u0445, \u0441\u044d\u0440\u0446\u0430, \u0446\u0435\u043b\u0430, \u0434\u0443\u0448\u0430, \u0443\u0441\u0435 \u0447\u0430\u0441\u0442\u043a\u0456 \u0446\u0435\u043b\u0430 \u0456 \u045e\u0441\u0435 \u043d\u0430\u0432\u044b\u043a\u0456. \u0422\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u0456\u043c\u0456, \u044f\u043a \u0441\u0432\u0430\u0456\u043c\u0456, \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u041f\u0430\u043d\u0443, \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u042f\u0433\u043e, \u043b\u044e\u0431\u0456\u0446\u044c \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b \u043d\u0430\u043b\u0435\u0436\u044b\u0448 \u042f\u043c\u0443, \u044f\u043a \u0446\u0435\u043b\u0430 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0433\u0430\u043b\u0430\u0432\u0435. \u0422\u0430\u043c\u0443 \u0456 \u0401\u043d \u043f\u0440\u0430\u0433\u043d\u0435 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u045e\u0441\u0456\u043c\u0456 \u0442\u0432\u0430\u0456\u043c\u0456 \u0447\u043b\u0435\u043d\u0430\u043c\u0456 \u044f\u043a \u0441\u0432\u0430\u0456\u043c\u0456, \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0410\u0439\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0442\u0430\u0431\u0435, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0433\u043d\u0435 \u0431\u044b\u0446\u044c \u0443 \u0442\u0430\u0431\u0435, \u043f\u0440\u0430\u0433\u043d\u0435 \u0436\u044b\u0446\u044c \u0443 \u0442\u0430\u0431\u0435 \u0456 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u0446\u0430 \u0442\u0430\u0431\u043e\u044e, \u044f\u043a \u0433\u0430\u043b\u0430\u0432\u0430 \u0436\u044b\u0432\u0435 \u0456 \u043f\u0430\u043d\u0443\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u0447\u043b\u0435\u043d\u0430\u0445. \u0425\u043e\u0447\u0430, \u043a\u0430\u0431 \u0443\u0441\u0451, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0443 \u0406\u043c, \u0436\u044b\u043b\u043e \u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0430 \u045e \u0442\u0430\u0431\u0435: \u042f\u0433\u043e \u0434\u0443\u0445 \u0443 \u0442\u0432\u0430\u0456\u043c \u0434\u0443\u0445\u0443, \u042f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u045e \u0442\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b, \u0443\u0441\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0456 \u042f\u0433\u043e \u0434\u0443\u0448\u044b \u0434\u0443\u0448\u044b \u0432\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u0445 \u0442\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b, \u043a\u0430\u0431 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u045e \u0442\u0430\u0431\u0435 \u0441\u043b\u043e\u0432\u044b: \u00ab\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0411\u043e\u0433\u0430 \u045e \u0446\u0435\u043b\u0435 \u0432\u0430\u0448\u044b\u043c\u00bb (1 \u041a\u0430\u0440 6, 20), \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u00ab\u0416\u044b\u0446\u0446\u0451 \u0415\u0437\u0443\u0441\u0430 \u043d\u044f\u0445\u0430\u0439 \u0430\u0431\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0432\u0430\u0441\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0442\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u043b\u0435\u0436\u044b\u0448 \u0411\u043e\u0436\u0430\u043c\u0443 \u0421\u044b\u043d\u0443, \u0430\u043b\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0406\u043c, \u044f\u043a \u0446\u0435\u043b\u0430 \u0442\u0440\u044b\u0432\u0430\u0435 \u0456 \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434 \u0433\u0430\u043b\u0430\u0432\u044b. \u0423\u0441\u0451, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0443 \u0442\u0430\u0431\u0435, \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u0446\u044c \u042f\u043c\u0443; \u0430\u0434 \u042f\u0433\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043c\u043e\u0446 \u0436\u044b\u0446\u0446\u044f \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0422\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u043c\u043e\u0436\u0430 \u0434\u0430\u0446\u044c \u0442\u0430\u0431\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0431\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u041f\u0430-\u0437\u0430 \u0406\u043c \u0442\u044b \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435. \u041d\u044f\u0445\u0430\u0439 \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0437\u0456\u043d\u0430\u0439 \u043c\u044d\u0442\u0430\u0439 \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u0442\u0432\u0430\u0456\u0445 \u0437\u0430\u0434\u0443\u043c\u0430\u045e, \u0434\u0437\u0435\u044f\u043d\u043d\u044f\u045e \u0456 \u0436\u044b\u0446\u0446\u0451\u0432\u044b\u0445 \u0441\u0456\u043b\u0430\u045e. \u0422\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0436\u044b\u0446\u044c \u0434\u043b\u044f \u042f\u0433\u043e \u0456 \u045e \u0406\u043c, \u043a\u0430\u0431 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u0441\u043b\u043e\u0432\u044b: \u00ab\u041d\u0456\u0445\u0442\u043e \u0437 \u043d\u0430\u0441 \u043d\u0435 \u0436\u044b\u0432\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435. \u0411\u043e \u043a\u0430\u043b\u0456 \u0436\u044b\u0432\u0451\u043c, \u0442\u043e \u0436\u044b\u0432\u0451\u043c \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u043a\u0430\u043b\u0456 \u0436 \u043f\u0430\u043c\u0456\u0440\u0430\u0435\u043c \u2013 \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u043f\u0430\u043c\u0456\u0440\u0430\u0435\u043c. \u0422\u0430\u043c\u0443 \u0446\u0456 \u0436\u044b\u0432\u0451\u043c, \u0446\u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u0435\u043c, \u043c\u044b \u043d\u0430\u043b\u0435\u0436\u044b\u043c \u041f\u0430\u043d\u0443. \u0411\u043e \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0456 \u043f\u0430\u043c\u0451\u0440, \u0456 \u0430\u0436\u044b\u045e, \u043a\u0430\u0431 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u0456 \u043d\u0430\u0434 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c\u0456, \u0456 \u043d\u0430\u0434 \u0436\u044b\u0432\u044b\u043c\u0456\u00bb (\u0420\u044b\u043c 14, 7-9).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0440\u044d\u0448\u0446\u0435, \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u044b \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u044f\u043a \u0446\u0435\u043b\u0430 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u0430 \u0437 \u0433\u0430\u043b\u0430\u0432\u043e\u044e. \u0422\u0430\u043c\u0443 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043c\u0435\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445, \u0430\u0434\u043d\u0443 \u0434\u0443\u0448\u0443, \u0430\u0434\u043d\u043e \u0436\u044b\u0446\u0446\u0451, \u0430\u0434\u043d\u0443 \u0432\u043e\u043b\u044e, \u0430\u0434\u043d\u043e \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0456 \u0430\u0434\u043d\u043e \u0441\u044d\u0440\u0446\u0430. \u0401\u043d \u0441\u0430\u043c \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0442\u0432\u0430\u0456\u043c \u0434\u0443\u0445\u0430\u043c, \u0441\u044d\u0440\u0446\u0430\u043c, \u043b\u044e\u0431\u043e\u045e\u044e, \u0436\u044b\u0446\u0446\u0451\u043c \u0456 \u045e\u0441\u0456\u043c \u0443 \u0442\u0430\u0431\u0435. \u0423\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0431\u044f\u0440\u0443\u0446\u044c \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0443 \u0445\u0440\u043e\u0441\u0446\u0435 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u0445. \u041f\u0430\u043c\u043d\u0430\u0436\u0430\u044e\u0446\u0446\u0430 \u0456 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u043a\u0430\u043d\u0444\u0456\u0440\u043c\u0430\u0446\u044b\u044e \u0456 \u043f\u0440\u0430\u0437 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0435 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043d\u043d\u0435 \u0456\u043d\u0448\u044b\u0445 \u043b\u0430\u0441\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u045e\u0434\u0437\u044f\u043b\u044f\u0435 \u0411\u043e\u0433, \u0430 \u043f\u043e\u045e\u043d\u0430\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u0434\u0430\u0441\u044f\u0433\u0430\u044e\u0446\u044c \u0443 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0456.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0420\u044b\u043c 14, 9. 8\u0430. 7\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0456 \u043f\u0430\u043c\u0451\u0440, \u0456 \u0430\u0436\u044b\u045e, \u043a\u0430\u0431 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u0456 \u043d\u0430\u0434 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c\u0456, \u0456 \u043d\u0430\u0434 \u0436\u044b\u0432\u044b\u043c\u0456. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u041a\u0430\u043b\u0456 \u0436\u044b\u0432\u0451\u043c, \u0442\u043e \u0436\u044b\u0432\u0451\u043c \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u043a\u0430\u043b\u0456 \u0436 \u043f\u0430\u043c\u0456\u0440\u0430\u0435\u043c \u2013 \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u043f\u0430\u043c\u0456\u0440\u0430\u0435\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u041d\u0456\u0445\u0442\u043e \u0437 \u043d\u0430\u0441 \u043d\u0435 \u0436\u044b\u0432\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u043b\u0456 \u0436\u044b\u0432\u0451\u043c.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"749","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u041f\u0435\u0441\u043d\u044f \u043f\u0435\u0441\u043d\u044f\u045e\u00bb \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430, \u0430\u0431\u0430\u0442\u0430 \u0456 \u0434\u043e\u043a\u0442\u0430\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 83, 4-6: Opera omnia, Edit. Cisterc. 2 [1958], 300-302)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041b\u044e\u0431\u043b\u044e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u043b\u044e\u0431\u043b\u044e \u0456 \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043b\u044e\u0431\u0456\u0446\u044c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041b\u044e\u0431\u043e\u045e \u0441\u0430\u043c\u0430\u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430\u044f; \u0441\u0430\u043c\u0430 \u045e \u0441\u0430\u0431\u0435 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u044f \u0456 \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0441\u044f\u0431\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435. \u042f\u043d\u0430 \u2013 \u0437\u0430\u0441\u043b\u0443\u0433\u0430, \u044f\u043d\u0430 \u2013 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0441\u0430\u043c\u0430 \u0434\u043b\u044f \u0441\u044f\u0431\u0435. \u041d\u0435 \u0448\u0443\u043a\u0430\u0435 \u043f\u0430-\u0437\u0430 \u0441\u0430\u0431\u043e\u0439 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u043d\u0456 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u043d\u0456 \u0430\u0431\u0433\u0440\u0443\u043d\u0442\u0430\u0432\u0430\u043d\u043d\u044f. \u042f\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u2013 \u043b\u044e\u0431\u043e\u045e. \u041b\u044e\u0431\u0456\u0446\u044c \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c; \u043b\u044e\u0431\u0456\u0446\u044c \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043b\u044e\u0431\u0456\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a\u043e\u0439 \u0436\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u044d\u0447\u0447\u0443 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043b\u044e\u0431\u043e\u045e, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u0430 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b, \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u043a\u0430\u043b\u0456, \u0432\u044f\u0440\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u0447\u044d\u0440\u043f\u0430\u0435 \u0430\u0434\u0442\u0443\u043b\u044c \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430, \u043a\u0430\u0431 \u0437\u043d\u043e\u045e \u0437\u0430\u0431\u0440\u0443\u0456\u0446\u044c. \u0417 \u0443\u0441\u0456\u0445 \u0440\u0443\u0445\u0430\u045e \u0434\u0443\u0448\u044b, \u0437 \u0443\u0441\u0456\u0445 \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u045e \u0456 \u043f\u0435\u0440\u0430\u0436\u044b\u0432\u0430\u043d\u043d\u044f\u045e, \u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u044e\u0431\u043e\u045e \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044e \u0430\u0434\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u0432\u0430\u0439\u043c\u0443 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044e \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0441\u0446\u044e, \u0445\u043e\u0446\u044c \u0456 \u043d\u0435 \u0442\u0430\u043a\u043e\u0439 \u0436\u0430, \u0430\u043b\u0435 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0439. \u0411\u043e, \u043a\u0430\u043b\u0456 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433, \u0401\u043d \u043d\u0435 \u0436\u0430\u0434\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u0456\u043d\u0448\u0430\u0433\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u042f\u0433\u043e \u043b\u044e\u0431\u0456\u043b\u0456. \u041b\u044e\u0431\u0456\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043b\u044e\u0431\u0456\u043b\u0456 \u042f\u0433\u043e, \u0456 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u043b\u044e\u0431\u044f\u0447\u044b\u044f \u043c\u043e\u0446\u0430\u044e \u0433\u044d\u0442\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0448\u0447\u0430\u0441\u0446\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u043a\u0430\u044f \u043b\u044e\u0431\u043e\u045e, \u0430\u0431\u043e \u043b\u0435\u043f\u0448, \u041b\u044e\u0431\u043e\u045e, \u044f\u043a\u0430\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430\u043c, \u043d\u0435 \u0436\u0430\u0434\u0430\u0435 \u043d\u0456\u0447\u043e\u0433\u0430 \u0456\u043d\u0448\u0430\u0433\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0435\u043d\u0430 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0439 \u0430\u0434\u0443\u0434\u0437\u044f\u0447\u044b\u0446\u044c \u043b\u044e\u0431\u043e\u045e\u044e. \u042f\u043a \u0436\u0430 \u044f\u043d\u0430 \u043c\u043e\u0436\u0430 \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430, \u0456 \u043f\u0440\u044b \u0433\u044d\u0442\u044b\u043c \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430 \u041b\u044e\u0431\u043e\u0432\u0456? \u0427\u0430\u043c\u0443 \u0431 \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u041b\u044e\u0431\u043e\u0432\u0456?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0432\u044b\u0440\u0430\u043a\u0430\u044e\u0447\u044b\u0441\u044f \u045e\u0441\u0456\u0445 \u0456\u043d\u0448\u044b\u0445 \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u045e, \u044f\u043d\u0430 \u0446\u0430\u043b\u043a\u0430\u043c \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0435 \u0441\u044f\u0431\u0435 \u043b\u044e\u0431\u043e\u0432\u0456, \u0456\u043c\u043a\u043d\u0443\u0447\u044b\u0441\u044f \u0430\u0434\u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0430 \u043b\u044e\u0431\u043e\u045e \u0443\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e. \u0406 \u043a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0443\u0441\u044f \u0446\u0430\u043b\u043a\u0430\u043c \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u0446\u0430 \u045e \u043b\u044e\u0431\u043e\u045e, \u0442\u043e \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043f\u0435\u0440\u0430\u0434 \u043d\u0435\u0432\u044b\u0447\u044d\u0440\u043f\u043d\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u041b\u044e\u0431\u043e\u0432\u0456? \u0411\u043e \u043d\u0435 \u0437 \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u044b\u043c \u0430\u0434\u0434\u0430\u043d\u043d\u0435\u043c \u043b\u044e\u0431\u044f\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c, \u0456 \u041b\u044e\u0431\u043e\u045e, \u0434\u0443\u0448\u0430 \u0456 \u0421\u043b\u043e\u0432\u0430, \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430 \u0456 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a, \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0456 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c. \u0420\u043e\u0437\u043d\u0456\u0446\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u043d\u0435 \u043c\u0435\u043d\u0448\u0430\u044f, \u0447\u044b\u043c \u043f\u0430\u043c\u0456\u0436 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u044f\u043a\u0456 \u043c\u0430\u0435 \u043f\u0440\u0430\u0433\u0443, \u0456 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0432\u0430\u0434\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0442\u043e \u0436 \u0434\u0430\u043b\u0435\u0439? \u0426\u0456 \u0441\u043f\u044b\u043d\u0456\u0446\u0446\u0430 \u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u0437\u043d\u0456\u043a\u043d\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0442\u043e\u0439, \u044f\u043a\u0430\u044f \u0447\u0430\u043a\u0430\u0435 \u0432\u044f\u0441\u0435\u043b\u043b\u044f; \u0446\u0456 \u0437\u043d\u0456\u043a\u043d\u0435 \u0442\u0443\u0433\u0430 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u0430\u0439, \u0446\u0456 \u0437\u0433\u0430\u0441\u043d\u0435 \u0436\u0430\u0440 \u043b\u044e\u0431\u044f\u0447\u0430\u0439, \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0442\u043e\u0439, \u044f\u043a\u0430\u044f \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u044f\u043d\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0431\u0435\u0433\u0443 \u0437 \u0432\u043e\u043b\u0430\u0442\u0430\u043c, \u0443 \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u0437 \u043c\u0451\u0434\u0430\u043c, \u0443 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u044f\u0433\u043d\u0451\u043c, \u0443 \u0431\u0435\u043b\u0456 \u0437 \u043b\u0456\u043b\u0435\u044f\u0439, \u0443 \u0431\u043b\u044f\u0441\u043a\u0443 \u0437 \u0441\u043e\u043d\u0446\u0430\u043c, \u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u0437 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041b\u044e\u0431\u043e\u045e\u044e? \u0425\u043e\u0446\u044c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u043c\u0435\u043d\u0448 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0451\u0439 \u0430\u0431\u043c\u0435\u0436\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456, \u0430\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u043b\u044e\u0431\u0456\u0446\u044c \u0437 \u0443\u0441\u0451\u0439 \u0441\u0456\u043b\u044b, \u0442\u043e \u0442\u0430\u043a\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u043d\u0435 \u043c\u0430\u0435 \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443. \u042f\u043d\u0430 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u045e\u0441\u0451. \u0422\u0430\u043c\u0443 \u0442\u0430\u043a \u043b\u044e\u0431\u0456\u0446\u044c \u2013 \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0431\u0430\u043d\u043a\u0435\u0442\u0430\u0432\u0430\u0446\u044c \u043d\u0430 \u0432\u044f\u0441\u0435\u043b\u043b\u0456, \u0431\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u0442\u0430\u043a \u043c\u043e\u0446\u043d\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0456 \u0431\u044b\u0446\u044c \u043c\u0435\u043d\u0448 \u043b\u044e\u0431\u0456\u043c\u044b\u043c. \u0411\u043e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0441\u0430\u044e\u0437, \u044f\u043a\u0456 \u043c\u0430\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u044e \u043f\u0430\u045e\u043d\u0430\u0442\u0443, \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u0432\u0430 \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0441\u0446\u0456 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430 \u0456 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b. \u041a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043d\u0435 \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u0421\u043b\u043e\u0432\u0430 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0430 \u0434\u0443\u0448\u0443 \u0440\u0430\u043d\u0435\u0439 \u0456 \u0431\u043e\u043b\u044c\u0448.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 31 (30), 20\u0430; 36 (35), 9\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u042f\u043a\u0430\u044f \u0436 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0422\u0432\u0430\u044f \u0434\u0430\u0431\u0440\u044b\u043d\u044f, \u041f\u0430\u043d\u0435,&nbsp;<\/span><span style=\"color: #ff0000;\">*<\/span><span> \u044f\u043a\u0443\u044e \u0422\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0426\u044f\u0431\u0435 \u0431\u0430\u0456\u0446\u0446\u0430.<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u041d\u0430\u0441\u044b\u0447\u0430\u044e\u0446\u0446\u0430 \u0442\u0443\u043a\u0430\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u043c\u0443, \u0422\u044b \u043f\u043e\u0456\u0448 \u0456\u0445 \u043f\u0430\u0442\u043e\u043a\u0430\u043c \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u0441\u0432\u0430\u0451\u0439. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f\u043a\u0443\u044e \u0422\u044b.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"750","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u00abDiv\u00edno affl\u00e1tu\u00bb \u0441\u0432. \u041f\u0456\u044f \u0425, \u043f\u0430\u043f\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(AAS 3 [1911], 633-635)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0413\u043e\u043b\u0430\u0441 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u043a\u0456 \u0430\u043f\u044f\u0432\u0430\u0435 \u0441\u043b\u0430\u0432\u0443 \u0411\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0441\u0430\u043b\u044c\u043c\u044b, \u0437\u0431\u043e\u0440 \u044f\u043a\u0456\u0445 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0421\u0432\u044f\u0442\u044b\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0456, \u0431\u044b\u043b\u0456 \u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b \u043f\u0430\u0434 \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0435\u043c \u0411\u043e\u0433\u0430. \u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0436\u044b\u0446\u0446\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u044f\u043d\u044b \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0430\u0431\u0443\u0434\u0436\u044d\u043d\u043d\u044f \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u043d\u044b\u0445, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u00ab\u0430\u0445\u0432\u044f\u0440\u0443 \u0445\u0432\u0430\u043b\u044b \u0411\u043e\u0433\u0443, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043f\u043b\u0451\u043d \u0432\u0443\u0441\u043d\u0430\u045e, \u044f\u043a\u0456\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0446\u044c \u042f\u0433\u043e\u043d\u0430\u043c\u0443 \u0456\u043c\u0435\u043d\u0456\u00bb (\u0413\u0431\u0440 13, 15), \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0437\u0432\u044b\u0447\u0430\u0435\u043c, \u043f\u0440\u044b\u043d\u044f\u0442\u044b\u043c \u0443\u0436\u043e \u045e \u0421\u0442\u0430\u0440\u044b\u043c \u0417\u0430\u043a\u043e\u043d\u0435, \u0437\u0430\u0439\u043c\u0430\u043b\u0456 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 \u045e \u0441\u0430\u043c\u043e\u0439 \u0441\u0432\u044f\u0442\u043e\u0439 \u041b\u0456\u0442\u0443\u0440\u0433\u0456\u0456 \u0456 \u0411\u043e\u0436\u044b\u043c \u0410\u0444\u0456\u0446\u044b\u0456. \u0410\u0434 \u0456\u0445 \u0431\u044f\u0440\u044d \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0442\u043e\u0439 \u00ab\u0433\u043e\u043b\u0430\u0441 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u00bb, \u043f\u0440\u0430 \u044f\u043a\u0456 \u043a\u0430\u0436\u0430 \u0441\u0432. \u0411\u0430\u0437\u044b\u043b\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u043e\u0434\u044b\u044f, \u044f\u043a\u0443\u044e \u043d\u0430\u0448 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u043a \u0423\u0440\u0431\u0430\u043d VIII \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0434\u0430\u0447\u043a\u043e\u0439 \u0445\u0432\u0430\u043b\u0430\u0441\u043f\u0435\u0432\u0430\u045e, \u044f\u043a\u0456\u044f \u00ab\u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0433\u0443\u0447\u0430\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c \u0411\u043e\u0433\u0430 \u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0430\u00bb. \u041f\u0441\u0430\u043b\u044c\u043c\u043e\u0434\u044b\u044f, \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u0439, \u0432\u0443\u0447\u044b\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0435 \u0441\u044f\u0431\u0435 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u044e \u0411\u043e\u0433\u0443, \u00ab\u044f\u043a \u044f\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u042f\u0433\u043e, \u044f\u043a \u0433\u043e\u0434\u043d\u0430 \u042f\u0433\u043e \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0446\u044c\u00bb. \u041d\u0430\u043a\u043e\u043d\u0442 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u0435\u043b\u044c\u043c\u0456 \u0442\u0440\u0430\u043f\u043d\u0430 \u0432\u044b\u043a\u0430\u0437\u0430\u045e\u0441\u044f \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d: \u00ab\u041a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043c\u043e\u0433 \u0433\u043e\u0434\u043d\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0411\u043e\u0433\u0430, \u0411\u043e\u0433 \u0441\u0430\u043c \u0441\u044f\u0431\u0435 \u045e\u0441\u043b\u0430\u0432\u0456\u045e; \u0430 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0430\u043c \u0441\u044f\u0431\u0435 \u045e\u0441\u043b\u0430\u0432\u0456\u045e, \u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0434\u0430\u0432\u0435\u0434\u0430\u045e\u0441\u044f, \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u042f\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043f\u0441\u0430\u043b\u044c\u043c\u044b \u043c\u0430\u044e\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u0443\u044e \u043c\u043e\u0446 \u0430\u0431\u0443\u0434\u0436\u0430\u0446\u044c \u0443 \u0434\u0443\u0448\u0430\u0445 \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0446\u043d\u043e\u0442\u0430\u045e. \u00ab\u0425\u043e\u0446\u044c \u0443\u0441\u0451 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u044f\u043a \u0421\u0442\u0430\u0440\u044b, \u0442\u0430\u043a \u0456 \u041d\u043e\u0432\u044b \u0417\u0430\u043f\u0430\u0432\u0435\u0442, \u201c\u043d\u0430\u0442\u0445\u043d\u0451\u043d\u0430\u0435 \u0411\u043e\u0433\u0430\u043c \u0456 \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0435 \u0434\u043b\u044f \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u044f\u201d (2 \u0426\u0456\u043c 3, 16), \u0430\u0434\u043d\u0430\u043a \u043a\u043d\u0456\u0433\u0430 \u041f\u0441\u0430\u043b\u044c\u043c\u0430\u045e, \u043d\u0456\u0431\u044b \u0440\u0430\u0439\u0441\u043a\u0456 \u0441\u0430\u0434, \u0443 \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u043f\u043b\u0430\u0434\u044b \u045e\u0441\u0456\u0445 \u043a\u043d\u0456\u0433, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u045e \u043f\u0441\u0430\u043b\u044c\u043c\u043e\u0434\u044b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u043f\u043b\u0430\u0434\u0430\u043c\u0456 \u0456\u043d\u0448\u044b\u0445 \u043a\u043d\u0456\u0433 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0432\u0430\u0435 \u043f\u043b\u0430\u0434\u044b\u00bb. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a \u0432\u0443\u0447\u044b\u0446\u044c \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u0439 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0434\u0430\u0434\u0430\u0435: \u00ab\u041c\u043d\u0435 \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u043f\u0441\u0430\u043b\u044c\u043c\u044b \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0456\u0445 \u0441\u043f\u044f\u0432\u0430\u0435, \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043d\u0456\u0431\u044b \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0430\u043c, \u0443 \u044f\u043a\u0456\u043c \u0451\u043d \u043c\u043e\u0436\u0430 \u0431\u0430\u0447\u044b\u0446\u044c \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0456 \u0440\u0443\u0445\u0456 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b, \u0456 \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435 \u0456\u0445 \u0447\u044b\u0442\u0430\u0446\u044c\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d \u0443 \u00ab\u0421\u043f\u043e\u0432\u0435\u0434\u0437\u0456\u00bb \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0430\u0436\u0430: \u00ab\u042f\u043a \u0436\u0430 \u044f \u043f\u043b\u0430\u043a\u0430\u045e, \u043a\u0430\u043b\u0456 \u0441\u043f\u044f\u0432\u0430\u045e \u0433\u0456\u043c\u043d\u044b \u0456 \u043f\u0435\u0441\u043d\u0456, \u0443\u0437\u0440\u0443\u0448\u0430\u043d\u044b \u0434\u0430 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0441\u0430\u043b\u043e\u0434\u043a\u0456\u043c\u0456 \u043c\u0435\u043b\u043e\u0434\u044b\u044f\u043c\u0456, \u044f\u043a\u0456\u044f \u0441\u043f\u044f\u0432\u0430\u045e \u0422\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b. \u041c\u0435\u043b\u043e\u0434\u044b\u0456 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u043b\u0456 \u045e \u043c\u0430\u0435 \u0432\u0443\u0448\u044b, \u043f\u0440\u0430\u045e\u0434\u0430 \u043b\u0456\u043b\u0430\u0441\u044f \u045e \u0441\u044d\u0440\u0446\u0430 \u0456 \u0440\u0430\u0441\u043f\u0430\u043b\u044c\u0432\u0430\u043b\u0430 \u043f\u0430\u0447\u0443\u0446\u0446\u0451 \u043b\u044e\u0431\u043e\u0432\u0456; \u0446\u044f\u043a\u043b\u0456 \u0441\u043b\u0451\u0437\u044b, \u0456 \u043c\u043d\u0435 \u0431\u044b\u043b\u043e \u0437 \u0456\u043c\u0456 \u0434\u043e\u0431\u0440\u0430\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u044b, \u0443\u0440\u044d\u0448\u0446\u0435, \u043a\u0430\u0433\u043e \u043d\u0435 \u045e\u0437\u0440\u0443\u0448\u0430\u0446\u044c \u0442\u044b\u044f \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f \u043c\u0435\u0441\u0446\u044b \u045e \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u0445, \u0434\u0437\u0435 \u0442\u0430\u043a \u0443\u0437\u043d\u0451\u0441\u043b\u0430 \u0430\u043f\u044f\u0432\u0430\u0435\u0446\u0446\u0430 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u044f \u0432\u0435\u043b\u0456\u0447 \u0411\u043e\u0433\u0430, \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c, \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0434\u0430\u0431\u0440\u044b\u043d\u044f, \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u044c \u0434\u044b \u0456\u043d\u0448\u044b\u044f \u043d\u0435\u0432\u044b\u043c\u0435\u0440\u043d\u044b\u044f \u0411\u043e\u0436\u044b\u044f \u0440\u044b\u0441\u044b! \u041a\u0430\u0433\u043e \u0436 \u043d\u0435 \u043d\u0430\u0442\u0445\u043d\u0456\u0446\u044c \u043d\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u043f\u0430\u0447\u0443\u0446\u0446\u0456 \u0433\u044d\u0442\u0430\u044f \u043f\u0430\u0434\u0437\u044f\u043a\u0430 \u0437\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u044f \u0430\u0434 \u0411\u043e\u0433\u0430 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u0446\u0456 \u0434\u0430\u0432\u0435\u0440\u043b\u0456\u0432\u044b\u044f \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0430\u0431 \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435, \u0430\u0431\u043e \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0456 \u0434\u0443\u0448\u044b, \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u0430\u0439 \u0433\u0440\u0430\u0445\u0430\u043c\u0456? \u0425\u0442\u043e \u0436 \u043d\u0435 \u0437\u0430\u043f\u0430\u043b\u0430\u0435 \u043b\u044e\u0431\u043e\u045e\u044e \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u043a\u0456\u043c \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430 \u043d\u0430\u043c\u0430\u043b\u044f\u0432\u0430\u043d\u044b\u043c \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f, \u0447\u044b\u0439 \u0433\u043e\u043b\u0430\u0441 \u0432\u0430 \u045e\u0441\u0456\u0445 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u0445 \u0447\u0443\u045e \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d? \u0413\u044d\u0442\u044b \u0433\u043e\u043b\u0430\u0441 \u0441\u043f\u044f\u0432\u0430\u045e, \u0441\u043a\u0430\u0440\u0434\u0437\u0456\u045e\u0441\u044f, \u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0430\u0434\u0437\u0435\u0456 \u0430\u0431\u043e \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u045e\u0441\u044f \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u0422\u044d\u0441 2, 4. 3\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u042f\u043a \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u044b\u044f \u0411\u043e\u0433\u0430\u043c \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0440\u0443\u0447\u044d\u043d\u043d\u044f \u043d\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u043c\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0442\u0430\u043a, <\/span><span style=\"color: #ff00ff;\">* <\/span><span>\u043a\u0430\u0431 \u0434\u0430\u0433\u0430\u0434\u0437\u0456\u0446\u044c \u043d\u0435 \u043b\u044e\u0434\u0437\u044f\u043c, \u0430\u043b\u0435 \u0411\u043e\u0433\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u041d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435 \u043d\u0435 \u0437 \u043f\u0430\u043c\u044b\u043b\u043a\u0456, \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0446\u0456 \u043f\u0430\u0434\u043c\u0430\u043d\u0443. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u0431.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"751","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u0410\u043c\u0430\u0434\u044d\u044f \u041b\u0430\u0437\u0430\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">&nbsp;(Hom. 7: SCh 72, 188. 190. 192. 200)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u0430\u0440\u0430\u043b\u0435\u0432\u0430 \u0441\u0432\u0435\u0442\u0443 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0434\u0443\u043c\u0430\u0439, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0431\u044b\u043b\u043e, \u0448\u0442\u043e \u044f\u0448\u0447\u044d \u043f\u0435\u0440\u0430\u0434 \u0423\u043d\u0435\u0431\u0430\u045e\u0437\u044f\u0446\u0446\u0435\u043c \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435 \u0456\u043c\u044f \u041c\u0430\u0440\u044b\u0456 \u0437\u0430\u044f\u0441\u043d\u0435\u043b\u0430 \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456; \u0448\u0442\u043e \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u0432\u0435\u043b\u0456\u0447 \u041c\u0430\u0440\u044b\u0456 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0430 \u043d\u0435\u0431\u0430, \u042f\u0435 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u044f \u0441\u043b\u0430\u0432\u0430 \u0440\u0430\u0437\u044b\u0448\u043b\u0430\u0441\u044f \u043f\u0430\u045e\u0441\u044e\u043b\u044c. \u041d\u0430\u043b\u0435\u0436\u0430\u043b\u0430, \u043a\u0430\u0431 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0445\u0432\u0430\u043b\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u041c\u0430\u0446\u0456 \u0414\u0437\u0435\u0432\u0430 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0437\u0430\u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u043b\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0430 \u043f\u0430\u0441\u043b\u044f \u045e\u0432\u0430\u0439\u0448\u043b\u0430 \u045e \u043d\u044f\u0431\u0435\u0441\u043d\u0443\u044e \u0445\u0432\u0430\u043b\u0443; \u043a\u0430\u0431 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0437\u2019\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e\u043d\u0456\u0437\u0435, \u0430 \u043f\u0430\u0441\u043b\u044f \u045e\u0432\u0430\u0439\u0448\u043b\u0430 \u043d\u0430 \u0432\u044b\u0448\u044b\u043d\u0456 \u0441\u0432\u044f\u0442\u043e\u0439 \u043f\u0430\u045e\u043d\u0430\u0442\u044b, \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u0435\u043d\u0430\u044f \u0437 \u00ab\u044f\u0441\u043d\u0430\u0441\u0446\u0456 \u045e \u044f\u0441\u043d\u0430\u0441\u0446\u044c\u00bb \u0442\u0430\u043a, \u044f\u043a \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u043b\u0430\u0441\u044f \u0430\u0434 \u0446\u043d\u043e\u0442\u044b \u0434\u0430 \u0446\u043d\u043e\u0442\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0443\u0434\u0443\u0447\u044b \u045e \u0446\u0435\u043b\u0435, \u044f\u043d\u0430 \u0434\u0430\u043b\u0430 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0431\u0443\u0434\u0443\u0447\u0430\u043c\u0443 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0443, \u0446\u0456 \u0442\u043e \u045e\u0437\u043d\u043e\u0441\u044f\u0447\u044b\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430 \u045e \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b\u043c \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0456 \u0441\u044d\u0440\u0446\u0430, \u0446\u0456 \u0442\u043e \u0441\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u0456\u0445 \u0443 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u0410\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0430 \u043f\u0430\u0448\u0430\u043d\u0443 \u0430\u0434 \u0430\u043d\u0451\u043b\u0430\u045e, \u0430\u0434\u0447\u0443\u0432\u0430\u043b\u0430 \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0443\u044e \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439. \u0410\u0440\u0445\u0430\u043d\u0451\u043b \u0413\u0430\u0431\u0440\u044b\u044d\u043b\u044c \u0441\u0442\u0430\u045e \u043f\u0440\u044b \u0401\u0439 \u0437 \u0430\u043d\u0451\u043b\u0430\u043c\u0456; \u042f\u043d, \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b, \u0448\u0442\u043e \u043f\u0430\u0434 \u043a\u0440\u044b\u0436\u043e\u043c \u044f\u043c\u0443 \u0434\u0430\u0440\u0443\u0447\u044b\u043b\u0456 \u0414\u0437\u0435\u0432\u0443 \u041c\u0430\u0440\u044b\u0456, \u0441\u043b\u0443\u0436\u044b\u045e \u0401\u0439 \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456. \u0423\u0441\u0435 \u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f: \u0430\u0434\u043d\u044b \u2013 \u0431\u043e \u0431\u0430\u0447\u044b\u043b\u0456 \u045e \u0401\u0439 \u041a\u0430\u0440\u0430\u043b\u0435\u0432\u0443, \u0434\u0440\u0443\u0433\u0456\u044f \u2013 \u0431\u043e \u0431\u0430\u0447\u044b\u043b\u0456 \u045e \u0401\u0439 \u0441\u0432\u0430\u044e \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u043a\u0443. \u0406 \u0430\u0434\u043d\u044b\u044f, \u0456 \u0434\u0440\u0443\u0433\u0456\u044f \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0401\u0439 \u043f\u0430\u0431\u043e\u0436\u043d\u0430 \u0456 \u0437 \u043b\u044e\u0431\u043e\u045e\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043d\u0430 \u0436, \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u045e\u0448\u044b \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u044b\u0445 \u0432\u044f\u0440\u0448\u044b\u043d\u044f\u045e \u0446\u043d\u043e\u0442\u044b, \u0430\u043a\u0440\u0443\u0436\u0430\u043d\u0430\u044f \u0430\u043a\u0456\u044f\u043d\u0430\u043c \u0411\u043e\u0436\u044b\u0445 \u043b\u0430\u0441\u043a\u0430\u045e, \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u043b\u0430 \u0434\u043b\u044f \u0441\u043f\u0440\u0430\u0433\u043d\u0451\u043d\u0430\u0433\u0430 \u0456 \u0432\u0435\u0440\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0448\u0447\u043e\u0434\u0440\u044b\u044f \u0441\u0442\u0440\u0443\u043c\u044f\u043d\u0456 \u043b\u0430\u0441\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u045e \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456 \u043c\u0435\u043b\u0430 \u0441\u0430\u043c\u0430. \u041f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0430 \u0437\u0434\u0430\u0440\u043e\u045e\u0435 \u0434\u043b\u044f \u0446\u0435\u043b\u0430 \u0456 \u043b\u0435\u043a \u0434\u043b\u044f \u0434\u0443\u0448\u044b. \u041c\u0435\u043b\u0430 \u043c\u043e\u0446 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u0441\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0446\u0435\u043b\u0430 \u0456 \u0434\u0443\u0448\u044b. \u0425\u0442\u043e \u0430\u0434\u044b\u0448\u043e\u045e \u0430\u0434 \u042f\u0435 \u0445\u0432\u043e\u0440\u044b\u043c \u0446\u0456 \u0441\u0443\u043c\u043d\u044b\u043c, \u0430\u0431\u043e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0447\u044b \u0411\u043e\u0436\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b? \u0425\u0442\u043e \u0436 \u043d\u0435 \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u045e \u0448\u0447\u0430\u0441\u0446\u0456 \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u045e, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0430\u0434 \u041c\u0430\u0446\u0456 \u0414\u0437\u0435\u0432\u044b \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0436\u0430\u0434\u0430\u045e?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430, \u0430\u0434\u043e\u0440\u0430\u043d\u0430\u044f \u0442\u0430\u043a\u0456\u043c\u0456 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c\u0456 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456, \u041c\u0430\u0446\u0456 \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430, \u043d\u0430\u0439\u0441\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u0430\u044f \u0456 \u0447\u0430\u0440\u0443\u044e\u0447\u0430\u044f \u0433\u0440\u0430\u0446\u044b\u0451\u0437\u043d\u0430\u0441\u0446\u044e \u043d\u0456\u0431\u044b \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u0445 \u0441\u0430\u0434\u043e\u045e, \u043a\u0430\u043b\u043e\u0434\u0437\u0435\u0436 \u0436\u044b\u0432\u043e\u0439 \u0456 \u0433\u0430\u044e\u0447\u0430\u0439 \u0432\u0430\u0434\u044b, \u0448\u0442\u043e \u0441\u0446\u044f\u043a\u0430\u0435 \u0437 \u0411\u043e\u0436\u0430\u0433\u0430 \u041b\u0456\u0431\u0430\u043d\u0430, \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u043b\u0430 \u0437 \u0433\u0430\u0440\u044b \u0421\u0456\u043d\u0430\u0439 \u043d\u0430 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0431\u043b\u0456\u0437\u043a\u0456\u044f \u0456 \u0434\u0430\u043b\u0451\u043a\u0456\u044f, \u043f\u043b\u044b\u043d\u044c \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u043b\u0430\u0441\u043a\u0430\u045e. \u041a\u0430\u043b\u0456 \u0436 \u041a\u0430\u0440\u0430\u043b\u0435\u0432\u0430 \u041f\u0430\u043d\u043d\u0430\u045e \u0441\u044f\u0440\u043e\u0434 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0430\u043d\u0451\u043b\u0430\u045e, \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u0456 \u0430\u0440\u0445\u0430\u043d\u0451\u043b\u0430\u045e, \u0432\u043e\u043a\u043b\u0456\u0447\u0430\u045e \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u043d\u0435\u0431\u0430 \u0431\u044b\u043b\u0430 \u045e\u0437\u044f\u0442\u0430\u044f \u045e \u043d\u0435\u0431\u0430 \u0411\u043e\u0433\u0430\u043c \u0456 \u0441\u0432\u0430\u0456\u043c \u0421\u044b\u043d\u0430\u043c, \u041a\u0430\u0440\u0430\u043b\u0451\u043c \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u0442\u0430\u0434\u044b \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442\u0430, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d\u0443: \u00ab\u041a\u0430\u0440\u0430\u043b\u0435\u0432\u0430 \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0426\u044f\u0431\u0435, \u0432\u0430 \u045e\u0437\u043e\u0440\u0447\u0430\u0442\u0430\u0439 \u0448\u0430\u0446\u0435, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u0430\u044f \u0437\u043e\u043b\u0430\u0442\u0430\u043c\u00bb (\u041f\u0441 45 [44], 10 Vlg).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\">&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff00ff;\"> <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0410\u043f 12, 1; \u043f\u0430\u0440. \u041f\u0441 45 (44), 10b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0412\u044f\u043b\u0456\u043a\u0456 \u0437\u043d\u0430\u043a \u0437\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u043d\u0430 \u043d\u0435\u0431\u0435: \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u0430\u044f \u045e \u0441\u043e\u043d\u0446\u0430, \u0456 \u043c\u0435\u0441\u044f\u0446 \u043f\u0430\u0434 \u044f\u0435 \u043d\u0430\u0433\u0430\u043c\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0430 \u043d\u0430\u0434 \u044f\u0435 \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u0432\u044f\u043d\u043e\u043a \u0437 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u0437\u043e\u0440\u0430\u043a.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u041a\u0430\u0440\u0430\u043b\u0435\u0432\u0430 \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0446\u044f\u0431\u0435, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u0430\u044f \u0437\u043e\u043b\u0430\u0442\u0430\u043c \u0437 \u0410\u0444\u0456\u0440\u0430. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0410 \u043d\u0430\u0434 \u044f\u0435.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"752","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0420\u0443\u0436\u044b \u041b\u0456\u043c\u0441\u043a\u0430\u0439, \u043f\u0430\u043d\u043d\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ad medicum Castillo: edit. L. Getino, La Patrona de Am\u00e9rica, Madrid 1928, pp. 54-55)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u0437\u043d\u0430\u0439\u043c\u0430 \u043b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0432\u0435\u0434\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u0456 \u0417\u0431\u0430\u045e\u0446\u0430 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0443 \u0441\u0432\u0430\u0451\u0439 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b: \u00ab\u0423\u0441\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u0435\u0434\u0430\u0446\u044c, \u0448\u0442\u043e \u043f\u0430\u0441\u043b\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043b\u0430\u0441\u043a\u0430. \u041d\u044f\u0445\u0430\u0439 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0431\u0435\u0437 \u0446\u044f\u0436\u0430\u0440\u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u043d\u0435\u043b\u044c\u0433\u0430 \u045e\u0437\u044b\u0441\u0446\u0456 \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u043b\u0430\u0441\u043a\u0456; \u043d\u044f\u0445\u0430\u0439 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0446\u044c, \u0448\u0442\u043e \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c \u043b\u0430\u0441\u043a \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u0435\u043c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u0435 \u0431\u043b\u0443\u043a\u0430\u0435 \u0456 \u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0441\u044f\u0431\u0435 \u0430\u0448\u0443\u043a\u0430\u0446\u044c. \u0411\u043e \u0433\u044d\u0442\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u044f \u0456 \u0430\u0434\u0437\u0456\u043d\u044b\u044f \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u043a\u0456 \u0434\u0430 \u043d\u0435\u0431\u0430, \u0456 \u043d\u044f\u043c\u0430 \u0434\u0430\u0440\u043e\u0433\u0456, \u0448\u0442\u043e \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u044f\u0433\u043e, \u0431\u0435\u0437 \u043a\u0440\u044b\u0436\u0430\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u044f \u043f\u0430\u0447\u0443\u043b\u0430 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0440\u0430\u043f\u0442\u0430\u043c \u0430\u0434\u0447\u0443\u043b\u0430 \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u044b \u0437\u0430\u043a\u043b\u0456\u043a \u0441\u0442\u0430\u0446\u044c \u044f\u043a \u0431\u044b \u043f\u0430\u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u0435 \u0432\u0443\u043b\u0456\u0446\u044b \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0443\u0441\u0456\u0445, \u043c\u0443\u0436\u0447\u044b\u043d \u0456 \u0436\u0430\u043d\u0447\u044b\u043d \u0440\u043e\u0437\u043d\u0430\u0433\u0430 \u045e\u0437\u0440\u043e\u0441\u0442\u0443 \u0456 \u0441\u0442\u0430\u043d\u0443: \u00ab\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u043d\u0430\u0440\u043e\u0434\u0437\u0435, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b: \u043f\u0430 \u0437\u0430\u0433\u0430\u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u044f \u043f\u0440\u044b\u0433\u0430\u0434\u0432\u0430\u044e \u0432\u0430\u043c \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u0432\u044b\u0448\u043b\u0456 \u0437 \u042f\u0433\u043e\u043d\u044b\u0445 \u0432\u0443\u0441\u043d\u0430\u045e: \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043b\u0430\u0441\u043a\u0456, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437\u0432\u0435\u0434\u0430\u0435\u043c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e. \u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0448\u043c\u0430\u0442 \u0446\u044f\u0440\u043f\u0435\u0446\u044c, \u043a\u0430\u0431 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u0411\u043e\u0436\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0445\u0432\u0430\u043b\u0435 \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u0434\u0443\u0448\u044b\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u043e\u0439 \u0441\u0430\u043c\u044b \u0437\u0430\u043a\u043b\u0456\u043a \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456. \u0410\u0434\u0447\u0443\u0432\u0430\u044e \u0434\u0443\u0445\u0430\u0442\u0443, \u043d\u0430 \u0447\u0430\u043b\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u043e\u0442, \u0456 \u044f \u0434\u044b\u0445\u0430\u044e \u0447\u0430\u0441\u0446\u0435\u0439. \u041c\u043d\u0435 \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u0434\u0443\u0448\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u043f\u0430\u043b\u043e\u043d\u0435 \u0446\u0435\u043b\u0430, \u0448\u0442\u043e, \u043f\u0430\u0440\u0432\u0430\u045e\u0448\u044b \u043f\u0443\u0442\u044b, \u044f\u043d\u0430, \u0432\u043e\u043b\u044c\u043d\u0430\u044f \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u044f, \u0431\u043e\u043b\u044c\u0448 \u043b\u0451\u0433\u043a\u0430 \u043f\u043e\u0439\u0434\u0437\u0435 \u043f\u0430 \u0441\u0432\u0435\u0446\u0435, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e\u0447\u044b: \u00ab\u041a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u0441\u0435 \u043b\u044e\u0434\u0437\u0456 \u043c\u0430\u0433\u043b\u0456 \u043f\u0430\u0437\u043d\u0430\u0446\u044c, \u044f\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u044d\u0447\u0447\u0443 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0436\u0430\u044f \u043b\u0430\u0441\u043a\u0430, \u044f\u043a\u043e\u0439 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0439, \u0448\u043b\u044f\u0445\u0435\u0442\u043d\u0430\u0439 \u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0439, \u044f\u043a \u0448\u043c\u0430\u0442 \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u043f\u043b\u0451\u043d\u0443, \u044f\u043a \u0448\u043c\u0430\u0442 \u0441\u043a\u0430\u0440\u0431\u0430\u045e, \u044f\u043a \u0448\u043c\u0430\u0442 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u0448\u0447\u0430\u0441\u0446\u044f. \u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0441\u0446\u044e \u044f\u043d\u044b \u0431 \u0456\u043c\u043a\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f \u0456 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u044f. \u041f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456, \u0437\u0430\u043c\u0435\u0441\u0442 \u0437\u044f\u043c\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e \u0448\u0443\u043a\u0430\u043b\u0456 \u0431 \u0443\u0446\u0456\u0441\u043a\u0443, \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f, \u043a\u0430\u0431 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u0431\u044f\u0441\u0446\u044d\u043d\u043d\u044b \u0441\u043a\u0430\u0440\u0431 \u043b\u0430\u0441\u043a\u0456 \u2013 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b \u043d\u0430\u0431\u044b\u0442\u0430\u043a \u0456 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0437\u0430 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043d\u0430\u0440\u0430\u043a\u0430\u045e \u0431\u044b \u043d\u0456 \u043d\u0430 \u043a\u0440\u044b\u0436, \u043d\u0456 \u043d\u0430 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u0456, \u044f\u043a\u0456\u044f \u044f\u0433\u043e \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u044e\u0446\u044c, \u043a\u0430\u043b\u0456 \u0431 \u0432\u0435\u0434\u0430\u045e, \u044f\u043a\u0443\u044e \u0433\u044d\u0442\u0430 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0456 \u044f\u043a\u043e\u0439 \u043c\u0435\u0440\u0430\u044e \u044f\u043d\u044b \u0430\u0434\u043c\u0435\u0440\u0432\u0430\u044e\u0446\u0446\u0430\u00bb.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u041a\u0430\u0440 1, 27\u0430. 28b-29; \u041f\u0441 138 (137), 6\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0411\u043e\u0433 \u0432\u044b\u0431\u0440\u0430\u045e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0435 \u0441\u0432\u0435\u0442\u0443, \u043a\u0430\u0431 \u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u044c \u043c\u0443\u0434\u0440\u044b\u0445, \u0456 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u044f\u043c\u0430, \u0432\u044b\u0431\u0440\u0430\u045e \u0411\u043e\u0433, \u043a\u0430\u0431 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0456\u0441\u043d\u0430\u0435, <\/span><span style=\"color: #ff0000;\">*<\/span><span style=\"color: #ff00ff;\"> <\/span><span>\u043a\u0430\u0431 \u043d\u0456\u044f\u043a\u0430\u0435 \u0446\u0435\u043b\u0430 \u043d\u0435 \u0432\u044b\u0445\u0432\u0430\u043b\u044f\u043b\u0430\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b<\/span><span style=\"color: #ff00ff;\"> <\/span><span>\u041f\u0430\u043d \u0431\u0430\u0447\u044b\u0446\u044c \u043f\u0430\u043a\u043e\u0440\u043d\u0430\u0433\u0430, \u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u0430\u0433\u0430 \u043f\u0430\u0437\u043d\u0430\u0435 \u0437\u0434\u0430\u043b\u0451\u043a\u0443. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u0431.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"753","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u041f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e\u00bb \u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 4, 3. 4: PG 61, 34-36)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0422\u043e\u0435, \u0448\u0442\u043e \u0441\u043b\u0430\u0431\u043e\u0435 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u0435 \u0437\u0430 \u043b\u044e\u0434\u0437\u0435\u0439&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0437 \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u043a\u0440\u044b\u0436 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443, \u0456 \u043f\u0440\u044b \u0433\u044d\u0442\u044b\u043c \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435. \u041d\u0430\u0432\u0443\u043a\u0430 \u043a\u0440\u044b\u0436\u0430 \u043d\u0435 \u0434\u0430\u0442\u044b\u0447\u044b\u043b\u0430 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u045e, \u0430\u043b\u0435 \u0411\u043e\u0433\u0430, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0440\u044d\u043b\u0456\u0433\u0456\u0456, \u0436\u044b\u0446\u0446\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0456 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0441\u0443\u0434\u0430. \u0423\u0441\u0456\u0445 \u043d\u0435\u0430\u0434\u0443\u043a\u0430\u0432\u0430\u043d\u044b\u0445 \u0456 \u043f\u0440\u043e\u0441\u0442\u044b\u0445 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u043b\u0430 \u045e \u043c\u0443\u0434\u0440\u0430\u0446\u043e\u045e. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u044f\u043a \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430\u043c \u0443 \u0411\u043e\u0433\u0430, \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u0435 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u043b\u044e\u0434\u0437\u0435\u0439, \u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043b\u0430\u0431\u043e\u0435 \u045e \u0411\u043e\u0433\u0430, \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u0435 \u0437\u0430 \u043b\u044e\u0434\u0437\u0435\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u0435? \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a\u0456\u043c, \u0448\u0442\u043e \u043a\u0440\u044b\u0436 \u043f\u0430\u0448\u044b\u0440\u044b\u045e\u0441\u044f \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435, \u0448\u0442\u043e \u0430\u0432\u0430\u043b\u043e\u0434\u0430\u045e \u0443\u0441\u0456\u043c\u0456, \u0448\u0442\u043e \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u044f \u0432\u043e\u0440\u0430\u0433\u0456, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u0441\u0446\u0435\u0440\u0446\u0456 \u0456\u043c\u044f \u0423\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430, \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u043b\u0435\u0433\u043b\u0430\u0433\u0430. \u0413\u044d\u0442\u0430\u0435 \u0456\u043c\u044f \u044f\u0441\u043d\u0435\u043b\u0430 \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448, \u0430 \u044f\u043d\u044b \u045e\u043f\u0430\u043b\u0456 \u0456 \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0456. \u0422\u0430\u043a, \u0437\u043c\u0430\u0433\u0430\u044e\u0447\u044b\u0441\u044f \u0437 \u041f\u0430\u043c\u0435\u0440\u043b\u044b\u043c, \u0436\u044b\u0432\u044b\u044f \u0430\u043a\u0430\u0437\u0430\u043b\u0456\u0441\u044f \u0431\u044f\u0441\u0441\u0456\u043b\u044c\u043d\u044b\u043c\u0456. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0433\u0440\u044d\u043a \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u044f \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b, \u0433\u044d\u0442\u044b\u043c \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435, \u0448\u0442\u043e \u0441\u0430\u043c \u0451\u043d \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b; \u044f \u0436, \u043f\u0440\u044b\u0437\u043d\u0430\u043d\u044b \u0456\u043c \u043d\u044f\u043c\u0443\u0434\u0440\u044b\u043c, \u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0441\u044f \u0431\u043e\u043b\u044c\u0448 \u043c\u0443\u0434\u0440\u044b\u043c \u0437\u0430 \u0432\u0443\u0447\u043e\u043d\u0430\u0433\u0430. \u041a\u0430\u043b\u0456 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u043c\u044f\u043d\u0435 \u0441\u043b\u0430\u0431\u044b\u043c, \u0434\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u0448\u0442\u043e \u0441\u0430\u043c \u0441\u043b\u0430\u0431\u0435\u0439\u0448\u044b. \u0422\u043e\u0435, \u0447\u0430\u0433\u043e \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0456 \u0456 \u043c\u044b\u0442\u043d\u0456\u043a\u0456 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u0446\u044b, \u0442\u0430\u0433\u043e \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u0443\u044f\u0432\u0456\u0446\u044c \u0441\u0430\u0431\u0435 \u0432\u0443\u0447\u043e\u043d\u044b\u044f, \u043a\u0430\u0440\u0430\u043b\u0456 \u0456 \u043d\u0430\u043e\u0433\u0443\u043b \u0443\u0441\u0435 \u043b\u044e\u0434\u0437\u0456 \u045e \u043c\u0456\u0442\u0443\u0441\u043d\u0456 \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0420\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u0433\u044d\u0442\u0430, \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0421\u043b\u0430\u0431\u043e\u0435 \u045e \u0411\u043e\u0433\u0430 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u0435 \u0437\u0430 \u043b\u044e\u0434\u0437\u0435\u0439\u00bb (1 \u041a\u0430\u0440 1, 25). \u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u2013 \u0433\u044d\u0442\u0430 \u0411\u043e\u0436\u0430\u044f \u0441\u043f\u0440\u0430\u0432\u0430. \u0414\u044b\u043a \u044f\u043a \u0436\u0430 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u0456 \u043d\u0435\u0430\u0434\u0443\u043a\u0430\u0432\u0430\u043d\u044b\u043c \u043b\u044e\u0434\u0437\u044f\u043c, \u044f\u043a\u0456\u044f \u0436\u044b\u043b\u0456 \u0441\u044f\u0440\u043e\u0434 \u0430\u0437\u0451\u0440\u0430\u045e, \u0440\u044d\u043a \u0456 \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456, \u043c\u0430\u0433\u043b\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u043d\u0430 \u0434\u0443\u043c\u043a\u0443 \u045e\u0437\u044f\u0446\u0446\u0430 \u0437\u0430 \u0442\u0430\u043a\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443? \u0422\u044b\u044f, \u0445\u0442\u043e, \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u044b\u045e \u0443 \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u0446\u0456 \u043d\u0430 \u0440\u044b\u043d\u043a\u0443, \u044f\u043a \u0436\u0430 \u043c\u0430\u0433\u043b\u0456 \u0434\u0443\u043c\u0430\u0446\u044c \u043f\u0440\u0430 \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u043d\u043d\u0435 \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443? \u0422\u043e\u0439, \u0445\u0442\u043e \u043f\u0456\u0441\u0430\u045e \u043f\u0440\u0430 \u0456\u0445, \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435, \u0448\u0442\u043e \u044f\u043d\u044b \u0447\u0430\u0441\u0430\u043c \u0431\u044b\u043b\u0456 \u0431\u0430\u044f\u0437\u043b\u0456\u0432\u044b\u043c\u0456 \u0456 \u043c\u0430\u043b\u0430\u0434\u0443\u0448\u043d\u044b\u043c\u0456. \u041d\u0435 \u0430\u0441\u043f\u0440\u044d\u0447\u0432\u0430\u0435 \u0456 \u043d\u0435 \u0436\u0430\u0434\u0430\u0435 \u0445\u0430\u0432\u0430\u0446\u044c \u0456\u0445\u043d\u0456\u044f \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u044b, \u0448\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u044b\u043c \u0434\u043e\u043a\u0430\u0437\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0441\u0446\u0456. \u0428\u0442\u043e \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0456\u0445? \u041a\u0430\u0436\u0430, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0441\u0445\u0430\u043f\u0456\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u0430\u0434\u044b, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u044b\u044f \u0406\u043c \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u044f \u0446\u0443\u0434\u044b, \u043c\u043d\u043e\u0433\u0456\u044f \u045e\u0446\u044f\u043a\u043b\u0456, \u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0431\u044b\u045e \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u043f\u0435\u0440\u0448\u044b\u043c, \u0432\u044b\u0440\u0430\u043a\u0441\u044f \u0415\u0437\u0443\u0441\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u044b\u043a \u0430\u0434\u043a\u0443\u043b\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0440\u044b \u0436\u044b\u0446\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u043c\u0435\u045e \u0441\u0456\u043b \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u0433\u0430\u0431\u0440\u044d\u044f\u043c, \u043f\u0430\u0441\u043b\u044f \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0441\u0456\u043b\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u0443\u0441\u044f\u043c\u0443 \u0441\u0432\u0435\u0442\u0443, \u043a\u0430\u043b\u0456, \u044f\u043a \u043a\u0430\u0436\u0430\u0446\u0435, \u0401\u043d \u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0456 \u043d\u0435 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0434\u0430 \u0456\u0445, \u043d\u0435 \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u0456\u0445 \u0430\u0434\u0432\u0430\u0433\u0430\u0439? \u0426\u0456 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u043b\u0456 \u044f\u043d\u044b \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u0430\u0431\u0435: \u00ab\u0414\u044b\u043a \u0448\u0442\u043e \u0436? \u0401\u043d \u0441\u0430\u043c \u0441\u044f\u0431\u0435 \u043d\u0435 \u0437\u043c\u043e\u0433 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c, \u0430 \u043d\u0430\u0441 \u0430\u0431\u0430\u0440\u043e\u043d\u0456\u0446\u044c? \u041d\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0433 \u0441\u0430\u0431\u0435 \u043f\u0440\u044b \u0436\u044b\u0446\u0446\u0456, \u0430 \u043d\u0430\u043c \u0434\u0430\u043f\u0430\u043c\u043e\u0436\u0430 \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456? \u041a\u0430\u043b\u0456 \u0436\u044b\u045e, \u043d\u0435 \u0437\u0434\u0430\u0431\u044b\u045e \u0441\u0430\u0431\u0435 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u0430 \u043c\u044b, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u042f\u0433\u043e \u0456\u043c\u044f, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u0443\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442? \u0426\u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u0431 \u0448\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0441\u043f\u0430\u0447\u044b\u043d\u0430\u0446\u044c \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0442\u0430\u043a\u043e\u0435, \u0430\u043b\u0435 \u043d\u0430\u0432\u0430\u0442 \u0434\u0443\u043c\u0430\u0446\u044c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430?\u00bb<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u043a\u0430\u043d\u0435\u0448\u043d\u0435, \u043a\u0430\u043b\u0456 \u0431 \u044f\u043d\u044b \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456 \u0423\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u0430\u0433\u0430, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0431\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b\u044f \u045e \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u0456\u043b\u0435, \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0431, \u043d\u0435 \u045e\u0437\u044f\u043b\u0456\u0441\u044f \u0437\u0430 \u0442\u0430\u043a\u043e\u0435 \u0437\u0430\u0434\u0430\u043d\u043d\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u041a\u0430\u0440 1, 23-24; 2 \u041a\u0430\u0440 4, 8\u0430; \u0420\u044b\u043c 8, 37\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u041c\u044b \u0436 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u0434\u043b\u044f \u044e\u0434\u044d\u044f\u045e \u2013 \u0437\u0433\u0430\u0440\u0448\u044d\u043d\u043d\u0435, \u0434\u043b\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u2013 \u0433\u043b\u0443\u043f\u0441\u0442\u0432\u0430, \u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, <\/span><span style=\"color: #ff0000;\">*<\/span><span style=\"color: #ff00ff;\"> <\/span><span>\u0401\u043d \u2013 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0411\u043e\u0436\u0430\u044f \u043c\u043e\u0446 \u0456 \u0411\u043e\u0436\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0423\u0441\u044f\u043b\u044f\u043a \u0443\u0446\u0456\u0441\u043a\u0430\u044e\u0446\u044c \u043d\u0430\u0441, \u0430\u043b\u0435 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u043f\u043e\u045e\u043d\u0443\u044e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0401\u043d.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"754","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0414\u0443\u0445\u043e\u045e\u043d\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0434\u043b\u044f \u0441\u044b\u043d\u0430\u00bb \u0441\u0432. \u041b\u044e\u0434\u0432\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Acta Sanctorum Augusti 5 [1868], 546)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442 \u043a\u0440\u0430\u0456\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0430\u0440\u0430\u0433\u0456 \u0441\u044b\u043d\u0435, \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0440\u0430\u044e \u0442\u0430\u0431\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0442\u0432\u0430\u0456\u043c \u0456 \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b\u0430\u045e \u0442\u0432\u0430\u0456\u0445. \u0411\u0435\u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u044f\u043c\u0430 \u0437\u0430\u0431\u045e\u043b\u0435\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u044b\u043d\u0435, \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0446\u044c \u0443\u0441\u044f\u0433\u043e, \u0448\u0442\u043e, \u044f\u043a \u0442\u044b \u0432\u0435\u0434\u0430\u0435\u0448, \u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0443, \u0430 \u0442\u0430\u043c\u0443 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u0435\u0433\u0447\u044b \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443 \u0442\u0430\u043a \u0434\u0430\u043b\u0451\u043a\u0430, \u043a\u0430\u0431 \u0436\u0430\u0434\u0430\u0446\u044c \u043b\u0435\u043f\u0448 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u043a\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u044e, \u0447\u044b\u043c \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u044f\u043a\u0456-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0433\u0440\u044d\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043a\u0440\u0430\u043c\u044f \u0433\u044d\u0442\u0430\u0433\u0430, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u0441\u043f\u0430\u0448\u043b\u0435 \u0442\u0430\u0431\u0435 \u043d\u0435\u0439\u043a\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435, \u0437\u043d\u043e\u0441\u044c \u044f\u0433\u043e \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430 \u0456 \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u044f\u043d\u043e \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0435 \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u0456 \u0448\u0442\u043e \u0442\u044b, \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u045e \u044f\u0433\u043e. \u041a\u0430\u043b\u0456 \u0436 \u041f\u0430\u043d \u0441\u043f\u0430\u0448\u043b\u0435 \u0442\u0430\u0431\u0435 \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442, \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u0437 \u043f\u0430\u043a\u043e\u0440\u0430\u044e, \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u044e\u0447\u044b\u0441\u044f, \u043a\u0430\u0431 \u0445\u0432\u0430\u043b\u044f\u0447\u044b\u0441\u044f \u0446\u0456 \u0440\u043e\u0431\u044f\u0447\u044b \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0435 \u043d\u0435 \u0441\u0442\u0430\u0446\u044c \u0433\u043e\u0440\u0448\u044b\u043c. \u0422\u0430\u0431\u0435 \u043d\u0435\u043b\u044c\u0433\u0430 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437 \u0411\u043e\u0433\u0430\u043c \u0446\u0456 \u0430\u0431\u0440\u0430\u0436\u0430\u0446\u044c \u042f\u0433\u043e, \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u042f\u0433\u043e \u0434\u0430\u0440\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0445\u0432\u043e\u0442\u043d\u0430 \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430 \u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0431\u0430\u0436\u044d\u043d\u0441\u0442\u0432\u044b \u045e \u043a\u0430\u0441\u0446\u0451\u043b\u0435; \u0431\u0443\u0434\u0437\u044c \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u045e \u0434\u0443\u043c\u043a\u0430\u0445. \u041d\u0435 \u0433\u0430\u0432\u0430\u0440\u044b \u043d\u0435\u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u045e, \u043f\u0430\u043a\u0443\u043b\u044c \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0448\u0441\u044f \u045e \u043a\u0430\u0441\u0446\u0451\u043b\u0435, \u0430\u043b\u0435 \u043c\u0430\u043b\u0456\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430 \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0430\u0431\u043e \u0441\u044d\u0440\u0446\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u0430\u0439 \u0441\u043f\u0430\u0433\u0430\u0434\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0434\u0430 \u045e\u0431\u043e\u0433\u0456\u0445, \u043d\u0435\u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u0445, \u0437\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u0456 \u043f\u0430 \u043c\u0435\u0440\u044b \u0441\u0432\u0430\u0456\u0445 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044f\u045e \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0456\u043c \u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0439. \u0414\u0437\u044f\u043a\u0443\u0439 \u0411\u043e\u0433\u0443 \u0437\u0430 \u045e\u0441\u0435 \u042f\u0433\u043e \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u044b\u043c \u0431\u043e\u043b\u044c\u0448\u044b\u0445 \u0434\u0430\u0440\u043e\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0430 \u0441\u0432\u0430\u0456\u0445 \u043f\u0430\u0434\u0434\u0430\u043d\u044b\u0445 \u0431\u0443\u0434\u0437\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u043d\u0435 \u0437\u0431\u043e\u0447\u0432\u0430\u0439 \u043d\u0456 \u043d\u0430\u043f\u0440\u0430\u0432\u0430 \u043d\u0456 \u043d\u0430\u043b\u0435\u0432\u0430. \u0423 \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u0441\u043f\u0440\u044d\u0447\u0430\u043a \u043f\u0430\u043c\u0456\u0436 \u0431\u0435\u0434\u043d\u044b\u043c \u0456 \u0431\u0430\u0433\u0430\u0442\u044b\u043c, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u0435\u0448\u0441\u044f \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0431\u0443\u0434\u0437\u044c \u0445\u0443\u0442\u0447\u044d\u0439 \u043d\u0430 \u0431\u0430\u043a\u0443 \u045e\u0431\u043e\u0433\u0430\u0433\u0430, \u0430 \u043d\u0435 \u0431\u0430\u0433\u0430\u0442\u0430\u0433\u0430. \u0406\u043c\u043a\u043d\u0456\u0441\u044f, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0442\u0432\u0430\u0435 \u043f\u0430\u0434\u0434\u0430\u043d\u044b\u044f \u0442\u0440\u044b\u043c\u0430\u043b\u0456\u0441\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0430\u0441\u043e\u0431\u044b \u0456 \u043c\u0430\u043d\u0430\u0445\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0443\u0434\u0437\u044c \u0430\u0434\u0434\u0430\u043d\u044b\u043c \u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u043d\u0430\u0448\u0430\u0439 \u041c\u0430\u0446\u0456, \u0420\u044b\u043c\u0441\u043a\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u0456 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u043c\u0443 \u0421\u0432\u044f\u0442\u0430\u0440\u0443 \u044f\u043a \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u043c\u0443 \u0430\u0439\u0446\u0443. \u0406\u043c\u043a\u043d\u0456\u0441\u044f \u0432\u044b\u043a\u0430\u0440\u0430\u043d\u0456\u0446\u044c \u0443 \u0441\u0432\u0430\u0451\u0439 \u0434\u0437\u044f\u0440\u0436\u0430\u0432\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0437\u043b\u043e, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u0430 \u0456 \u0435\u0440\u0430\u0441\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0440\u044d\u0448\u0446\u0435, \u0434\u0430\u0440\u0430\u0433\u0456 \u0441\u044b\u043d\u0435, \u0443\u0434\u0437\u044f\u043b\u044f\u044e \u0442\u0430\u0431\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0430\u0431\u043e\u0436\u043d\u044b \u0431\u0430\u0446\u044c\u043a\u0430 \u043c\u043e\u0436\u0430 \u045e\u0434\u0437\u044f\u043b\u0456\u0446\u044c \u0441\u044b\u043d\u0443. \u0421\u0432\u044f\u0442\u0430\u044f \u0422\u0440\u043e\u0439\u0446\u0430 \u0456 \u045e\u0441\u0435 \u0441\u0432\u044f\u0442\u044b\u044f \u043d\u044f\u0445\u0430\u0439 \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u044e\u0446\u044c \u0446\u044f\u0431\u0435 \u0430\u0434 \u0437\u043b\u0430. \u041d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d \u0430\u0434\u043e\u0440\u044b\u0446\u044c \u0446\u044f\u0431\u0435 \u043b\u0430\u0441\u043a\u0430\u044e \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u042f\u0433\u043e \u0432\u043e\u043b\u0456, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u0430\u0434 \u0446\u044f\u0431\u0435 \u043f\u0430\u0448\u0430\u043d\u0443 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0422\u0430\u043a \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u043c\u044b \u0437\u043c\u043e\u0436\u0430\u043c \u0441\u0443\u0441\u0442\u0440\u044d\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c, \u043a\u0430\u0431 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u042f\u0433\u043e, \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">2 \u0412\u0430\u043b 18, 3\u0430. 5b. 6\u0430. 7b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0420\u0430\u0431\u0456\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u0456\u043b\u0430\u0435 \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430; \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0433\u0430 \u044f\u043c\u0443 \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u043a\u0430\u0440\u0430\u043b\u0451\u045e:&nbsp;<\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0451\u043d \u0442\u0440\u044b\u043c\u0430\u045e\u0441\u044f \u041f\u0430\u043d\u0430 \u0456 \u043d\u0435 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0430\u0434 \u042f\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0412\u044b\u043a\u043e\u043d\u0432\u0430\u045e \u042f\u0433\u043e \u043d\u0430\u043a\u0430\u0437\u044b, \u0456 \u041f\u0430\u043d \u0431\u044b\u045e \u0437 \u0456\u043c. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0401\u043d \u0442\u0440\u044b\u043c\u0430\u045e\u0441\u044f.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"755","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0422\u0432\u043e\u0440 \u0441\u0432. \u042e\u0437\u0430\u0444\u0430 \u041a\u0430\u043b\u0430\u0441\u0430\u043d\u0441\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Memoriale al Card. M. A. Tonti, 1621: Ephem. Calas. 36, 9-10: Rom\u00e6 1967, pp. 473-474; L. Picanyol, Epistolario di S. Giuseppe Calasanzio, 9 vol., ediz. Calas., Rom\u00e6 1951-1956)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442 \u043a\u0440\u0430\u0456\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u0456 \u0431\u0430\u0433\u0430\u0442\u044b\u043c \u043d\u0430 \u0437\u0430\u0441\u043b\u0443\u0433\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u0435 \u0441\u0432\u044f\u0442\u043e\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u2013 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0434\u0437\u044f\u0446\u0435\u0439, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0431\u0435\u0434\u043d\u044b\u0445, \u043a\u0430\u0431 \u043d\u0430\u043b\u0435\u0436\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0441\u0444\u0430\u0440\u043c\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u044f, \u044f\u043d\u044b \u043c\u0430\u0433\u043b\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043f\u0440\u0430\u0437 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u045e \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0456 \u045e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u043d\u0430\u0432\u0443\u0446\u044b \u043f\u0440\u0430 \u0437\u0434\u0430\u0440\u043e\u045e\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0443\u0448\u044b, \u0430\u043b\u0435 \u0456 \u0446\u0435\u043b\u0430, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u045e \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0434\u0437\u044f\u0446\u0435\u0439 \u043d\u0456\u0431\u044b \u0442\u043e\u0435 \u0436 \u0437\u0430\u0434\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u0456\u0445 \u0430\u043d\u0451\u043b\u0430\u043c-\u0430\u043f\u0435\u043a\u0443\u043d\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u043f\u0430\u0441\u043b\u0443\u0433\u0430 \u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043c\u043e\u043b\u0430\u0434\u0437\u044c, \u044f\u043a\u043e\u0433\u0430 \u0431 \u044f\u043d\u0430 \u043d\u0435 \u0431\u044b\u043b\u0430 \u0441\u0442\u0430\u043d\u0443 \u0456 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u044f, \u0430\u0431\u0435\u0440\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0437\u043b\u0430, \u0430\u043b\u0435 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u043f\u043b\u0451\u043d\u043d\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u0434\u0430\u0431\u0440\u0430. \u041a\u0430\u043b\u0456 \u0434\u0437\u0435\u0446\u044f\u043c \u0456 \u043c\u043e\u043b\u0430\u0434\u0437\u0456 \u0431\u0443\u0434\u0437\u0435 \u0430\u043a\u0430\u0437\u0430\u043d\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a\u0430\u044f \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430, \u043c\u043e\u0436\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0441\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u0446\u044c, \u044f\u043a \u044f\u043d\u044b \u0437\u043c\u044f\u043d\u044f\u044e\u0446\u0446\u0430 \u045e \u043b\u0435\u043f\u0448\u044b \u0431\u043e\u043a \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u0448\u0442\u043e \u0437 \u0447\u0430\u0441\u0430\u043c \u043d\u0435\u043b\u044c\u0433\u0430 \u043f\u0430\u0437\u043d\u0430\u0446\u044c, \u044f\u043a\u0456\u043c\u0456 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0440\u0430\u043d\u0435\u0439. \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u043c\u0430\u043b\u0430\u0434\u044b\u044f \u0433\u0430\u043b\u0456\u043d\u043a\u0456, \u0442\u0430\u043a \u0456 \u0440\u043e\u0437\u0443\u043c \u043c\u0430\u043b\u0430\u0434\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u043b\u0451\u0433\u043a\u0430 \u043f\u0430\u0434\u0434\u0430\u0435\u0446\u0446\u0430 \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0430\u043c. \u0410\u0434\u043d\u0430\u043a \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u0435\u043c, \u043a\u0430\u043b\u0456 \u0434\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0446\u0446\u0430 \u0436\u043e\u0440\u0441\u0442\u043a\u0430\u0441\u0446\u044c, \u0442\u043e \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0444\u0430\u0440\u043c\u0456\u0440\u0430\u0432\u0430\u043d\u043d\u044f \u0437\u043c\u044f\u043d\u0448\u0430\u0435\u0446\u0446\u0430 \u0430\u0431\u043e \u045e\u0432\u043e\u0433\u0443\u043b\u0435 \u0437\u043d\u0456\u043a\u0430\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0435 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0434\u0437\u044f\u0446\u0435\u0439, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u045e\u0431\u043e\u0433\u0456\u0445, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043f\u0440\u044b\u044f\u0435 \u0440\u0430\u0437\u0432\u0456\u0446\u0446\u044e \u0456\u0445 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0430\u043b\u0435\u0436\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0430\u0446\u044d\u043d\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044e. \u0413\u044d\u0442\u0430 \u0446\u044d\u043d\u044f\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u0430\u0446\u044c\u043a\u0456, \u044f\u043a\u0456\u044f \u043d\u0435\u0432\u044b\u043c\u0435\u0440\u043d\u0430 \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0431\u0430\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439 \u0432\u044f\u0434\u0443\u0446\u044c \u0448\u043b\u044f\u0445\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u043a\u0456\u044f \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044b\u0445 \u0456 \u0434\u043e\u0431\u0440\u044b\u0445 \u0433\u0440\u0430\u043c\u0430\u0434\u0437\u044f\u043d\u0430\u045e, \u0430\u043b\u0435 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b, \u0443 \u0447\u044b\u0435 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u044f \u0441\u0444\u0435\u0440\u044b \u0436\u044b\u0446\u0446\u044f \u0456 \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456 \u044f\u043d\u044b \u043c\u043e\u0433\u0443\u0446\u044c \u043f\u043b\u0451\u043d\u043d\u0430 \u0456 \u0441\u0442\u0430\u043b\u0430 \u045e\u043a\u043b\u044e\u0447\u044b\u0446\u0446\u0430 \u044f\u043a \u043f\u0440\u044b\u044f\u0446\u0435\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0430\u0431\u0430\u0440\u043e\u043d\u0446\u044b \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b\u044f, \u0443 \u043a\u0430\u0433\u043e \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u044b\u043c \u0437\u0430\u0434\u0430\u043d\u043d\u0435\u043c, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0446\u0446\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e, \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0456 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0439 \u043f\u0430\u043a\u043e\u0440\u0430\u044e. \u0422\u0430\u0434\u044b \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0433\u043e\u0434\u043d\u044b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u041f\u0430\u043d, \u044f\u043a\u043e\u0433\u0430 \u0437 \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u0441\u0456\u0446\u044c, \u0443\u0447\u044b\u043d\u0456\u045e \u0456\u0445 \u043f\u043b\u0451\u043d\u043d\u044b\u043c\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u043f\u0440\u0430\u045e\u0434\u044b, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0443 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0456 \u0442\u0430\u043a\u043e\u0433\u0430 \u045e\u0437\u043d\u0451\u0441\u043b\u0430\u0433\u0430 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0443, \u0456, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u0430\u0434\u0430\u0440\u044b\u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043d\u0435\u0431\u0430 \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: \u00ab\u0422\u044b\u044f, \u0445\u0442\u043e \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0437\u0437\u044f\u0446\u044c \u044f\u043a \u0437\u043e\u0440\u043a\u0456 \u043d\u0430 \u0432\u0435\u0447\u043d\u0443\u044e \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c\u00bb (\u0414\u0430\u043d 12, 3).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0437 \u043b\u0451\u0433\u043a\u0430\u0441\u0446\u044e, \u043a\u0430\u043b\u0456, \u0430\u0434\u0434\u0430\u045e\u0448\u044b \u0441\u044f\u0431\u0435 \u0446\u0430\u043b\u043a\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f, \u0431\u0443\u0434\u0443\u0446\u044c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0437\u2019\u044f\u0434\u043d\u0430\u0446\u0446\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0456 \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0422\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0430\u0434\u043d\u0430\u043c\u0443 \u0437 \u0433\u044d\u0442\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u041c\u0430\u0456\u0445 \u043c\u0435\u043d\u0448\u044b\u0445, \u0432\u044b \u041c\u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0456\u00bb (\u041c\u0446 25, 40).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff00ff;\"> <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u0422\u044d\u0441 2, 8; \u0413\u0430\u043b 4, 19\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u041c\u044b \u0437 \u0447\u0443\u043b\u0430\u0441\u0446\u0456 \u0434\u0430 \u0432\u0430\u0441 \u043f\u0430\u0436\u0430\u0434\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u0432\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0430\u043b\u0435 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0414\u0437\u0435\u0446\u0456 \u043c\u0430\u0435, \u044f \u0437\u043d\u043e\u045e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e \u0432\u0430\u0441 \u0443 \u043f\u0430\u043a\u0443\u0442\u0430\u0445, \u043f\u0430\u043a\u0443\u043b\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0441\u0444\u0430\u0440\u043c\u0443\u0435\u0446\u0446\u0430 \u045e \u0432\u0430\u0441. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u0430\u043c\u0443.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"757","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0421\u043f\u043e\u0432\u0435\u0434\u0437\u044c\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 9, 10-11: CSEL 33, 215-219)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0414\u0430\u043a\u0440\u0430\u043d\u0430\u0435\u043c\u0441\u044f \u0434\u0430 \u0430\u0434\u0432\u0435\u0447\u043d\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u045e\u0441\u044f \u0434\u0437\u0435\u043d\u044c \u044f\u0435 \u0430\u0434\u044b\u0445\u043e\u0434\u0443 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0434\u0437\u0435\u043d\u044c, \u043f\u0440\u0430 \u044f\u043a\u0456 \u0422\u044b \u0432\u0435\u0434\u0430\u045e, \u0430\u043b\u0435 \u043c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0456, \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u2013 \u0434\u0443\u043c\u0430\u044e, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u044f\u0437\u0432\u0435\u0434\u0430\u043d\u0430\u0433\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u043c\u0435\u0440\u0443, \u2013 \u0448\u0442\u043e \u0430\u043f\u044b\u043d\u0443\u043b\u0456\u0441\u044f \u043c\u044b \u0440\u0430\u0437\u0430\u043c. \u0410\u0431\u0430\u043f\u0451\u0440\u0448\u044b\u0441\u044f \u043d\u0430 \u043f\u0430\u0434\u0432\u0430\u043a\u043e\u043d\u043d\u0435, \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u043c\u044b \u0437 \u0430\u043a\u043d\u0430 \u043d\u0430 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u044b \u0441\u0430\u0434 \u043d\u0430\u0448\u0430\u0433\u0430 \u0434\u043e\u043c\u0443, \u0434\u0437\u0435 \u043c\u044b \u0436\u044b\u043b\u0456 \u045e \u041e\u0441\u0442\u044b\u0456. \u0421\u0442\u043e\u043c\u043b\u0435\u043d\u044b\u044f \u0434\u043e\u045e\u0433\u0456\u043c \u0432\u0430\u043d\u0434\u0440\u0430\u0432\u0430\u043d\u043d\u0435\u043c, \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u043c\u0456\u0442\u0443\u0441\u043d\u0456, \u043c\u044b \u043d\u0430\u0431\u0456\u0440\u0430\u043b\u0456\u0441\u044f \u0441\u0456\u043b\u0430\u045e \u0434\u043b\u044f \u043c\u0430\u0440\u0441\u043a\u043e\u0433\u0430 \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430. \u041c\u044b \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u043b\u0456 \u045e\u0434\u0432\u0430\u0456\u0445 \u0456, \u00ab\u0437\u0430\u0431\u044b\u0432\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u043c\u0456\u043d\u0443\u043b\u0430\u0435 \u0456 \u0456\u043c\u043a\u043d\u0443\u0447\u044b\u0441\u044f \u043d\u0430\u043f\u0435\u0440\u0430\u0434\u00bb, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043b\u0456 \u045e \u0441\u0432\u044f\u0442\u043b\u0435 \u041f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a\u043e\u0439 \u0422\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0448\u0441\u044f, \u0448\u0442\u043e \u0442\u0430\u043a\u043e\u0435 \u0441\u0432\u044f\u0442\u043e\u0435 \u0436\u044b\u0446\u0446\u0451, \u0442\u043e\u0435 \u0436\u044b\u0446\u0446\u0451, \u044f\u043a\u043e\u0433\u0430 \u00ab\u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430, \u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430, \u0456 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0441\u044d\u0440\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u00bb (1 \u041a\u0430\u0440 2, 9). \u0412\u0443\u0441\u043d\u0430\u043c\u0456 \u0441\u044d\u0440\u0446\u0430 \u043c\u044b \u043f\u0440\u0430\u0433\u043d\u0443\u043b\u0456 \u043f\u0440\u044b\u043f\u0430\u0441\u0446\u0456 \u0434\u0430 \u0441\u0442\u0440\u0443\u043c\u044f\u043d\u0451\u045e \u0422\u0432\u0430\u0451\u0439 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0436\u044b\u0446\u0446\u044f, \u0448\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0422\u0430\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0433\u044d\u0442\u0430, \u0445\u043e\u0446\u044c \u0456 \u043d\u0435 \u0442\u0430\u043a \u0456 \u043d\u0435 \u0442\u0430\u043a\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0430\u043b\u0435 \u0422\u044b \u0432\u0435\u0434\u0430\u0435\u0448, \u041f\u0430\u043d\u0435, \u0448\u0442\u043e \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u043a\u0430\u043b\u0456 \u043c\u044b \u0442\u0430\u043a \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u043b\u0456, \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u044b\u043c \u043d\u0430\u043c \u0437\u0434\u0430\u045e\u0441\u044f \u043f\u0430\u0434\u0447\u0430\u0441 \u0440\u0430\u0437\u043c\u043e\u0432\u044b \u0433\u044d\u0442\u044b \u0441\u0432\u0435\u0442 \u0437 \u0443\u0441\u0456\u043c\u0456 \u044f\u0433\u043e \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044f\u043c\u0456, \u0456 \u044f\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u043c\u043d\u0435: \u00ab\u0421\u044b\u043d\u0435, \u044f\u043a \u0434\u0430 \u043c\u044f\u043d\u0435, \u0442\u043e \u043d\u0456\u0448\u0442\u043e \u043d\u0435 \u0440\u0430\u0434\u0443\u0435 \u043c\u044f\u043d\u0435 \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435. \u042f \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u043c\u043d\u0435 \u044f\u0448\u0447\u044d \u0442\u0443\u0442 \u0440\u0430\u0431\u0456\u0446\u044c \u0456 \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u0442\u0443\u0442 \u0431\u044b\u0446\u044c. \u042f \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0447\u0430\u043a\u0430\u044e \u0430\u0434 \u0441\u0432\u0435\u0442\u0443. \u0422\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043d\u043e \u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u043c\u044f\u043d\u0435 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c: \u044f \u0445\u0430\u0446\u0435\u043b\u0430, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u043f\u0430\u043c\u0440\u0443, \u0431\u0430\u0447\u044b\u0446\u044c \u0446\u044f\u0431\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430\u043c-\u043a\u0430\u0442\u043e\u043b\u0456\u043a\u0430\u043c. \u0411\u043e\u0433 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043c\u044f\u043d\u0435 \u0430\u0434\u0430\u0440\u044b\u045e: \u044f \u045e\u0431\u0430\u0447\u044b\u043b\u0430 \u0446\u044f\u0431\u0435 \u042f\u0433\u043e \u0441\u043b\u0443\u0433\u043e\u044e, \u044f\u043a\u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u0437\u044f\u043c\u043d\u044b\u043c \u0448\u0447\u0430\u0441\u0446\u0435\u043c. \u0428\u0442\u043e \u043c\u043d\u0435 \u044f\u0448\u0447\u044d \u0442\u0443\u0442 \u0440\u0430\u0431\u0456\u0446\u044c?\u00bb<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u044e \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430, \u0448\u0442\u043e \u044f \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u0451\u0439, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u043f\u044f\u0446\u044c \u0434\u0437\u0451\u043d, \u0430 \u043c\u043e\u0436\u0430 \u0456 \u0431\u043e\u043b\u044c\u0448, \u044f\u043d\u0430 \u0437\u043b\u044f\u0433\u043b\u0430 \u0430\u0434 \u043b\u0456\u0445\u0430\u043c\u0430\u043d\u043a\u0456. \u041f\u0430\u0434\u0447\u0430\u0441 \u0445\u0432\u0430\u0440\u043e\u0431\u044b \u045e \u043d\u0435\u0439\u043a\u0456 \u0434\u0437\u0435\u043d\u044c \u044f\u043d\u0430 \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0430 \u043f\u0440\u044b\u0442\u043e\u043c\u043d\u0430\u0441\u0446\u044c \u0456 \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043b\u0430 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u044b\u0445. \u041a\u0430\u043b\u0456 \u043c\u044b \u043f\u0440\u044b\u0431\u0435\u0433\u043b\u0456, \u044f\u043d\u0430 \u045e\u0436\u043e \u0430\u043f\u0440\u044b\u0442\u043e\u043c\u043d\u0435\u043b\u0430 \u0456, \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e\u0448\u044b \u043d\u0430 \u0431\u0440\u0430\u0442\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u044f\u045e \u043f\u043e\u0431\u0430\u0447, \u0456 \u043d\u0430 \u043c\u044f\u043d\u0435, \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u043d\u0430\u043c \u043d\u0456\u0431\u044b \u043f\u044b\u0442\u0430\u044e\u0447\u044b\u0441\u044f: \u00ab\u0414\u0437\u0435 \u044f \u0431\u044b\u043b\u0430?\u00bb<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u044f, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u043d\u0430\u0448 \u0433\u043b\u044b\u0431\u043e\u043a\u0456 \u0441\u0443\u043c, \u0441\u043a\u0430\u0437\u0430\u043b\u0430: \u00ab\u0422\u0443\u0442 \u043f\u0430\u0445\u0430\u0432\u0430\u0439\u0446\u0435 \u0441\u0432\u0430\u044e \u043c\u0430\u0446\u0456\u00bb. \u042f \u043c\u0430\u045e\u0447\u0430\u045e, \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u0441\u043b\u0451\u0437\u044b. \u041c\u043e\u0439 \u0431\u0440\u0430\u0442 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0441\u043a\u0430\u0437\u0430\u045e, \u0436\u0430\u0434\u0430\u044e\u0447\u044b, \u043a\u0430\u0431 \u044f\u043d\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u0430 \u043d\u0435 \u043d\u0430 \u0447\u0443\u0436\u044b\u043d\u0435, \u0430\u043b\u0435 \u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u0430\u0456\u0445. \u041f\u0430\u0447\u0443\u045e\u0448\u044b \u0433\u044d\u0442\u0430, \u044f\u043d\u0430 \u0437\u0430\u043d\u0435\u043f\u0430\u043a\u043e\u0456\u043b\u0430\u0441\u044f \u0442\u0430\u043a\u0456\u043c\u0456 \u044f\u0433\u043e\u043d\u044b\u043c\u0456 \u0434\u0443\u043c\u043a\u0430\u043c\u0456 \u0456 \u043a\u0456\u043d\u0443\u043b\u0430 \u043d\u0430 \u044f\u0433\u043e \u043d\u0435\u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0435\u043d\u044b \u043f\u043e\u0437\u0456\u0440\u043a. \u0417\u0430\u0442\u044b\u043c, \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u045e\u0448\u044b \u043d\u0430 \u043c\u044f\u043d\u0435, \u0441\u043a\u0430\u0437\u0430\u043b\u0430: \u00ab\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0448\u0442\u043e \u0451\u043d \u043a\u0430\u0436\u0430\u00bb. \u041f\u0430\u0441\u043b\u044f \u0441\u043a\u0430\u0437\u0430\u043b\u0430 \u043d\u0430\u043c \u0430\u0431\u043e\u0434\u0432\u0443\u043c: \u00ab\u041f\u0430\u043a\u043b\u0430\u0434\u0437\u0456\u0446\u0435 \u0433\u044d\u0442\u0430\u0435 \u0446\u0435\u043b\u0430 \u0445\u043e\u0446\u044c \u0434\u0437\u0435, \u043d\u0435 \u0442\u0443\u0440\u0431\u0443\u0439\u0446\u0435\u0441\u044f \u043f\u0440\u0430 \u044f\u0433\u043e; \u043f\u0440\u0430\u0448\u0443 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0431 \u0430\u0434\u043d\u044b\u043c: \u043f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u043c\u044f\u043d\u0435 \u043b\u044f \u0430\u043b\u0442\u0430\u0440\u0430 \u041f\u0430\u043d\u0430 \u045e\u0441\u044e\u0434\u044b, \u0434\u0437\u0435 \u0431 \u0432\u044b \u043d\u0435 \u0431\u044b\u043b\u0456\u00bb. \u0421\u043a\u0430\u0437\u0430\u045e\u0448\u044b \u0433\u044d\u0442\u0430 \u0437 \u0430\u043f\u043e\u0448\u043d\u0456\u0445 \u0441\u0456\u043b, \u0437\u0430\u0446\u0456\u0445\u043b\u0430, \u0446\u0435\u0440\u043f\u044f\u0447\u044b \u0430\u0434 \u0430\u0442\u0430\u043a\u0430\u045e \u0445\u0432\u0430\u0440\u043e\u0431\u044b.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u041a\u0430\u0440 7, 29b. 30b. 31; 2, 12\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0427\u0430\u0441 \u043a\u0430\u0440\u043e\u0442\u043a\u0456, \u0442\u0430\u043c\u0443 \u0442\u044b\u044f, \u0445\u0442\u043e \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430, \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u0435\u0442\u0430\u043c, \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u043c\u0456\u043d\u0430\u0435 \u0432\u043e\u0431\u0440\u0430\u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u041c\u044b \u0436 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043d\u0435 \u0434\u0443\u0445\u0430 \u0441\u0432\u0435\u0442\u0443. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e \u043c\u0456\u043d\u0430\u0435.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"758","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0421\u043f\u043e\u0432\u0435\u0434\u0437\u044c\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 7, 10. 18; 10, 27: CSEL 33, 157-163. 255)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">&nbsp;\u0432\u0435\u0447\u043d\u0430\u044f \u041f\u0440\u0430\u045e\u0434\u0430, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u044f \u041b\u044e\u0431\u043e\u045e, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u044f \u0412\u0435\u0447\u043d\u0430\u0441\u0446\u044c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0437\u043d\u0430\u0439\u0448\u043e\u045e \u0441\u044f\u0431\u0435, \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u043f\u0430\u0434 \u0422\u0432\u0430\u0456\u043c \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0443 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430. \u042f \u0437\u043c\u043e\u0433 \u0433\u044d\u0442\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c, \u0431\u043e \u0422\u044b \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u044e (\u043f\u0430\u0440. \u041f\u0441 30 [29], 11). \u042f \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0456 \u045e\u0431\u0430\u0447\u044b\u045e \u043d\u0456\u0431\u044b \u0432\u0430\u0447\u044b\u043c\u0430 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b, \u043f\u0430-\u043d\u0430\u0434 \u0442\u044b\u043c\u0456 \u0436 \u0432\u0430\u0447\u044b\u043c\u0430, \u043f\u0430-\u043d\u0430\u0434 \u043c\u0430\u0456\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u043d\u044f\u0437\u0433\u0430\u0441\u043d\u0430\u0435 \u0421\u0432\u044f\u0442\u043b\u043e. \u0413\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u043d\u0435 \u0442\u043e\u0435 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u044f\u043a\u043e\u0435 \u0431\u0430\u0447\u0430\u0446\u044c \u0443\u0441\u0435, \u0456 \u043d\u0435 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u044f\u0433\u043e, \u0430\u043b\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u0435, \u0431\u043e\u043b\u044c\u0448 \u044f\u0440\u043a\u0430\u0435, \u044f\u043a\u043e\u0435 \u045e\u0441\u0451 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0441\u0432\u0430\u0456\u043c \u0437\u0437\u044f\u043d\u043d\u0435\u043c. \u041d\u0435, \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u043d\u0435 \u0442\u043e\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0430\u043b\u0435 \u0456\u043d\u0448\u0430\u0435, \u0432\u0435\u043b\u044c\u043c\u0456 \u043d\u0435\u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u0442\u0430\u0433\u043e \u0441\u0432\u044f\u0442\u043b\u0430. \u042f\u043d\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u043d\u0430\u0434 \u043c\u0430\u0456\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c, \u044f\u043a \u0430\u043b\u0435\u0439 \u043d\u0430\u0434 \u0432\u0430\u0434\u043e\u0439 \u0446\u0456 \u043d\u0435\u0431\u0430 \u043d\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u0439. \u042f\u043d\u043e \u0431\u044b\u043b\u043e \u0432\u044b\u0448\u044d\u0439, \u0431\u043e \u043c\u044f\u043d\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u043b\u0430, \u0430 \u044f \u0431\u044b\u045e \u043d\u0456\u0436\u044d\u0439, \u0431\u043e \u044f \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0456\u043c. \u0422\u043e\u0439, \u0445\u0442\u043e \u0432\u0435\u0434\u0430\u0435 \u041f\u0440\u0430\u045e\u0434\u0443, \u0432\u0435\u0434\u0430\u0435 \u0433\u044d\u0442\u0430\u0435 \u0421\u0432\u044f\u0442\u043b\u043e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041e \u0432\u0435\u0447\u043d\u0430\u044f \u041f\u0440\u0430\u045e\u0434\u0430, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u041b\u044e\u0431\u043e\u045e, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u044f \u0412\u0435\u0447\u043d\u0430\u0441\u0446\u044c! \u0422\u044b \u2013 \u043c\u043e\u0439 \u0411\u043e\u0433. \u0414\u0430 \u0426\u044f\u0431\u0435 \u044f \u045e\u0437\u0434\u044b\u0445\u0430\u044e \u0434\u043d\u0451\u043c \u0456 \u043d\u043e\u0447\u0447\u0443. \u042f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u044f \u043f\u0430\u0437\u043d\u0430\u045e \u0426\u044f\u0431\u0435, \u0422\u044b \u0437\u0430\u0431\u0440\u0430\u045e \u043c\u044f\u043d\u0435 \u0434\u0430 \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u044f \u045e\u0431\u0430\u0447\u044b\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c, \u0430\u043b\u0435 \u044f \u043d\u0435 \u0431\u044b\u045e \u044f\u0448\u0447\u044d \u0437\u0434\u043e\u043b\u044c\u043d\u044b \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430. \u0422\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u043c\u0430\u0439\u0433\u043e \u0437\u0440\u043e\u043a\u0443 \u0441\u0456\u043b\u0430\u044e \u0422\u0432\u0430\u0456\u0445 \u043f\u0440\u043e\u043c\u043d\u044f\u045e, \u044f \u0437\u0430\u0434\u0440\u044b\u0436\u044d\u045e \u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0441\u0442\u0440\u0430\u0445\u0443. \u042f \u043f\u0430\u0437\u043d\u0430\u045e, \u0448\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0443\u0441\u044f \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u0426\u044f\u0431\u0435, \u0443 \u0447\u0443\u0436\u043e\u0439 \u043a\u0440\u0430\u0456\u043d\u0435, \u0456 \u043f\u0430\u0447\u0443\u045e \u043d\u0456\u0431\u044b \u0422\u0432\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u0437 \u0432\u044b\u0448\u044b\u043d\u0456: \u00ab\u042f \u0435\u0436\u0430 \u0434\u043b\u044f \u043c\u043e\u0446\u043d\u044b\u0445; \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0439, \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u041c\u044f\u043d\u0435. \u0406 \u043d\u0435 \u0442\u044b \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u0448 \u041c\u044f\u043d\u0435 \u045e \u0441\u044f\u0431\u0435 \u043d\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439 \u0435\u0436\u044b, \u0430\u043b\u0435 \u042f \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044e \u0446\u044f\u0431\u0435 \u045e \u0441\u044f\u0431\u0435\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u0448\u0443\u043a\u0430\u045e \u0434\u0430\u0440\u043e\u0433\u0456, \u044f\u043a\u0430\u044f \u0431 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u043b\u0430 \u043c\u043d\u0435 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e, \u0456 \u043d\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u045e, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0441\u0445\u0430\u043f\u0456\u045e\u0441\u044f \u0437\u0430 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430 \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u2013 \u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 (\u043f\u0430\u0440. 1 \u0426\u0456\u043c 2, 5), \u0411\u043e\u0433\u0430 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0433\u0430 \u043d\u0430\u0432\u0435\u043a\u0456 (\u043f\u0430\u0440. \u0420\u044b\u043c 9, 5). \u0401\u043d \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043c\u044f\u043d\u0435 \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u042f \u2014 \u0434\u0430\u0440\u043e\u0433\u0430, \u0456 \u043f\u0440\u0430\u045e\u0434\u0430, \u0456 \u0436\u044b\u0446\u0446\u0451\u00bb (\u042f\u043d 14, 6), \u0456 \u0435\u0436\u0430, \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044c \u044f\u043a\u0443\u044e \u045e \u043c\u044f\u043d\u0435 \u043d\u0435 \u0445\u0430\u043f\u0430\u043b\u0430 \u0441\u0456\u043b\u0430\u045e. \u0401\u043d \u0437\u043c\u044f\u0448\u0430\u045e \u044f\u0435 \u0437 \u0446\u0435\u043b\u0430\u043c, \u0431\u043e \u00ab\u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c\u00bb (\u042f\u043d 1, 14), \u043a\u0430\u0431 \u0422\u0432\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u044f\u043a\u043e\u0439 \u0422\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0451, \u0434\u043b\u044f \u043d\u0430\u0441, \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442, \u043c\u0430\u0433\u043b\u0430 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u0446\u0446\u0430 \u045e \u043c\u0430\u043b\u0430\u043a\u043e.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u043e\u0437\u043d\u0430 \u044f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0426\u044f\u0431\u0435, \u041f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0434\u0430\u045e\u043d\u044f\u044f \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043d\u043e\u0432\u0430\u044f! \u041f\u043e\u0437\u043d\u0430 \u044f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0426\u044f\u0431\u0435! \u0422\u044b \u0431\u044b\u045e \u0443\u0432\u0430 \u043c\u043d\u0435, \u0430 \u044f \u0431\u044b\u045e \u0437\u0432\u043e\u043d\u043a\u0443 \u0456 \u0437\u0432\u043e\u043d\u043a\u0443 \u0448\u0443\u043a\u0430\u045e \u0426\u044f\u0431\u0435. \u0421\u0430\u043c, \u043f\u043e\u045e\u043d\u044b \u0431\u0440\u044b\u0434\u043e\u0442\u044b, \u044f \u0431\u0435\u0433 \u0437\u0430 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044e, \u044f\u043a\u0443\u044e \u0422\u044b \u0441\u0442\u0432\u0430\u0440\u044b\u045e. \u0422\u044b \u0431\u044b\u045e \u0441\u0430 \u043c\u043d\u043e\u044e, \u0430\u043b\u0435 \u044f \u043d\u0435 \u0431\u044b\u045e \u0437 \u0422\u0430\u0431\u043e\u044e. \u0417\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0426\u044f\u0431\u0435 \u045e\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u043c\u044f\u043d\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456, \u044f\u043a\u0456\u044f \u0431 \u0443\u0432\u043e\u0433\u0443\u043b\u0435 \u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0456, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0456 \u045e \u0422\u0430\u0431\u0435. \u0422\u044b \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u043c\u0430\u044e \u043d\u0435\u043c\u0430\u0442\u0443. \u0417\u0430\u0456\u0441\u043d\u0430\u0432\u0430\u045e, \u0422\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e \u0437\u043d\u0456\u0448\u0447\u044b\u043b\u0430 \u043c\u0430\u044e \u0441\u043b\u0435\u043f\u0430\u0442\u0443. \u0422\u044b \u0440\u0430\u0441\u0441\u0435\u044f\u045e \u043d\u0430\u0432\u043e\u043a\u0430\u043b \u0432\u043e\u0434\u0430\u0440, \u0430 \u044f \u043f\u0430\u0447\u0443\u045e \u0456 \u045e\u0434\u044b\u0445\u0430\u044e \u0426\u044f\u0431\u0435. \u0410\u0434\u043d\u043e\u0439\u0447\u044b \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u045e, \u0430 \u0446\u044f\u043f\u0435\u0440 \u0430\u0434\u0447\u0443\u0432\u0430\u044e \u043d\u0435\u0434\u0430\u0445\u043e\u043f \u0456 \u043f\u0440\u0430\u0433\u043d\u0443; \u0422\u044b \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0441\u044f, \u0456 \u044f \u043f\u0430\u043b\u0430\u044e \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0435\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u0441\u043f\u0430\u043a\u043e\u044e.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff00ff;\"> <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u041e \u041f\u0440\u0430\u045e\u0434\u0430, \u0441\u0432\u044f\u0442\u043b\u043e \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430, \u0433\u044d\u0442\u0430 \u043d\u0435 \u043c\u0430\u044f \u0446\u0435\u043c\u0440\u0430 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0434\u0430 \u043c\u044f\u043d\u0435. \u042f \u0431\u043b\u0443\u043a\u0430\u045e, \u0430\u043b\u0435 \u045e\u0441\u043f\u043e\u043c\u043d\u0456\u045e \u043f\u0440\u0430 \u0426\u044f\u0431\u0435.&nbsp;<\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0406 \u0432\u043e\u0441\u044c, \u043f\u0430\u043b\u0430\u044e\u0447\u044b \u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u0447\u044b, \u0432\u044f\u0440\u0442\u0430\u044e\u0441\u044f \u0434\u0430 \u0426\u044f\u0431\u0435, \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u043c\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u041d\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0436\u044b\u0446\u0446\u0451 \u043c\u0430\u0451, \u0431\u043e \u0436\u044b\u0446\u0446\u0451 \u043c\u0430\u0451 \u0434\u0440\u044d\u043d\u043d\u0430\u0435, \u0430\u043b\u0435 \u045e \u0422\u0430\u0431\u0435 \u044f \u0430\u0436\u044b\u045e. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406 \u0432\u043e\u0441\u044c.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"759","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u0411\u044d\u0434\u044b \u0412\u044f\u043b\u0435\u0431\u043d\u0430\u0433\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/span><span><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 23: CCL 122, 354. 356-357)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u044f\u0441\u0442\u0443\u043d \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0456 \u0441\u043c\u0435\u0440\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0432\u044f\u0442\u044b \u0432\u0435\u0441\u043d\u0456\u043a \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f, \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0456 \u0441\u043c\u0435\u0440\u0446\u0456 \u041f\u0430\u043d\u0430 \u043f\u0440\u0430\u044f\u0432\u0456\u045e \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044c, \u0433\u043e\u0434\u043d\u0443\u044e \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u044f \u0437 \u0432\u044b\u0448\u044b\u043d\u044f\u045e, \u0456 \u044f\u043a \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u00ab\u0445\u043e\u0446\u044c \u0443 \u0432\u0430\u0447\u0430\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u044f\u043d\u044b \u0437\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b\u043c\u0456, \u0456\u0445 \u043d\u0430\u0434\u0437\u0435\u044f \u043f\u043e\u045e\u043d\u0430\u044f \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456\u00bb (\u041c\u0434\u0440 3, 4). \u0422\u0430\u043c\u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u0448\u0442\u043e \u043c\u044b \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u043c \u0434\u0437\u0435\u043d\u044c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0434\u043b\u044f \u043d\u0435\u0431\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u044e \u045e\u0432\u0435\u043a\u0430\u0432\u0435\u0447\u044b\u045e \u044f\u0433\u043e \u0434\u043b\u044f \u043d\u0430\u0441, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u044e\u0447\u044b \u043f\u0443\u0440\u043f\u0443\u0440\u0430\u043c \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0456; \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u0448\u0442\u043e \u043c\u044b \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u045e\u0441\u043f\u0430\u043c\u0456\u043d \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u043a\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u044e \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u045e \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0441\u0432. \u042f\u043d \u0431\u044b\u045e \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b \u0456 \u0437\u0430\u0431\u0456\u0442\u044b \u0437\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u043d\u0430\u0448\u0430\u043c\u0443 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044e, \u044f\u043a\u043e\u0433\u0430 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e. \u0414\u0437\u0435\u043b\u044f \u042f\u0433\u043e \u043f\u0440\u044b\u043d\u044f\u045e \u0441\u043c\u0435\u0440\u0446\u044c. \u041f\u0430\u043c\u0451\u0440 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0445\u043e\u0446\u044c \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a \u043d\u0435 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u045e \u0432\u044b\u0440\u0430\u043a\u0430\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u0430\u045e\u0447\u0430\u0446\u044c \u0430\u0431 \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u042f\u043d \u043f\u0440\u0430\u043b\u0456\u045e \u043a\u0440\u043e\u045e \u0437\u0430 \u043f\u0440\u0430\u045e\u0434\u0443, \u043f\u0440\u0430\u043b\u0456\u045e \u044f\u0435 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u042f \u2013 \u043f\u0440\u0430\u045e\u0434\u0430\u00bb (\u042f\u043d 14, 6). \u042f\u043a \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435\u043c, \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0456 \u0445\u0440\u044b\u0448\u0447\u044d\u043d\u043d\u0435\u043c \u042f\u043d \u0441\u0432\u0435\u0434\u0447\u044b\u045e, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430, \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c, \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c, \u0442\u0430\u043a \u0456 \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0435\u0440\u0448\u044b\u043c, \u0451\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0443\u0434\u0437\u0435 \u0446\u044f\u0440\u043f\u0435\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043d, \u0442\u0430\u043a\u0456 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b \u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u045e \u0437\u044f\u043c\u043d\u043e\u0435 \u0436\u044b\u0446\u0446\u0451, \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u043a\u0440\u043e\u045e \u043f\u0430\u0441\u043b\u044f \u0434\u043e\u045e\u0433\u0430\u0439 \u043f\u0430\u043a\u0443\u0442\u044b \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u043d\u044f. \u0401\u043d, \u044f\u043a\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443 \u043f\u0440\u0430 \u0441\u0432\u0430\u0431\u043e\u0434\u0443 \u045e \u0432\u0435\u0447\u043d\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0456, \u0431\u044b\u045e \u043a\u0456\u043d\u0443\u0442\u044b \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u043c\u0456 \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u0443; \u0451\u043d, \u044f\u043a\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0421\u0432\u044f\u0442\u043b\u043e \u0456 \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u045e \u043d\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0432\u0435\u0447\u043d\u0430\u0435 \u0421\u0432\u044f\u0442\u043b\u043e, \u043d\u0430\u0437\u0432\u0430\u045e \u044f\u0433\u043e \u043f\u0430\u0445\u043e\u0434\u043d\u044f\u0439, \u0448\u0442\u043e \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u0456 \u043f\u0430\u043b\u0430\u0435, \u0451\u043d \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0431\u044b\u045e \u0437\u0430\u043c\u043a\u043d\u0451\u043d\u044b \u045e \u0442\u0443\u0440\u044d\u043c\u043d\u0430\u0439 \u0446\u0435\u043c\u0440\u044b. \u0423\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0431\u044b\u045e \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b \u0442\u043e\u0439, \u043a\u0430\u043c\u0443 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0431\u044b\u043b\u043e \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c \u0417\u0431\u0430\u045e\u0446\u0443 \u0441\u0432\u0435\u0442\u0443, \u044f\u043a\u0456 \u0447\u0443\u045e \u0433\u043e\u043b\u0430\u0441 \u0410\u0439\u0446\u0430, \u0448\u0442\u043e \u0433\u0443\u0447\u0430\u045e \u043d\u0430\u0434 \u0406\u043c, \u044f\u043a\u0456 \u0431\u0430\u0447\u044b\u045e \u0441\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u0443\u044e \u043d\u0430 \u042f\u0433\u043e \u043b\u0430\u0441\u043a\u0443 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u0422\u0430\u043a\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c, \u044f\u043a \u042f\u043d, \u043d\u044f\u0446\u044f\u0436\u043a\u0430 \u0431\u044b\u043b\u043e \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0447\u0430\u0441\u043e\u0432\u044b\u044f \u043f\u0430\u043a\u0443\u0442\u044b \u0434\u0437\u0435\u043b\u044f \u0430\u0431\u0430\u0440\u043e\u043d\u044b \u043f\u0440\u0430\u045e\u0434\u044b. \u0413\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u043d\u0430\u0432\u0430\u0442 \u043b\u0451\u0433\u043a\u0456\u043c \u0456 \u0436\u0430\u0434\u0430\u043d\u044b\u043c, \u0431\u043e \u044f\u043d\u044b \u0431\u0430\u0447\u044b\u043b\u0456, \u0448\u0442\u043e \u0437\u0430 \u0433\u044d\u0442\u0430 \u0447\u0430\u043a\u0430\u0435 \u0456\u0445 \u0432\u0435\u0447\u043d\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u043c\u0435\u0440\u0446\u044c, \u043d\u0435\u043f\u0430\u0437\u0431\u0435\u0436\u043d\u0443\u044e \u043f\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456, \u044f\u043d\u044b \u043f\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0445\u0432\u043e\u0442\u043d\u0430, \u0431\u043e \u043f\u0430\u043c\u0456\u0440\u0430\u043b\u0456 \u0437\u0430 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0451\u0439 \u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0422\u0430\u043c\u0443 \u0441\u043b\u0443\u0448\u043d\u0430 \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: \u00ab\u0412\u0430\u043c \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u0430\u043b\u0435 \u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u0430 \u042f\u0433\u043e\u00bb (\u0424\u043b\u043f 1, 29). \u0401\u043d \u043b\u0456\u0447\u044b\u0446\u044c \u043b\u0430\u0441\u043a\u0430\u044e, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0439 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0448\u0442\u043e \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u044f \u043c\u043e\u0433\u0443\u0446\u044c \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437\u0430 \u042f\u0433\u043e, \u0431\u043e \u043a\u0430\u0436\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u00ab\u0426\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0433\u0430 \u0447\u0430\u0441\u0443 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f \u0442\u043e\u0439 \u0441\u043b\u0430\u0432\u044b, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0432\u044b\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441\u00bb (\u0420\u044b\u043c 8, 18).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u043a 6, 17. 27\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0406\u0440\u0430\u0434 \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0445\u0430\u043f\u0456\u0446\u044c \u042f\u043d\u0430 \u0456 \u0437\u0430\u043a\u0430\u0432\u0430\u045e \u044f\u0433\u043e \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u044b <\/span><span style=\"color: #ff0000;\">*<\/span><span style=\"color: #ff00ff;\"> <\/span><span>\u0437-\u0437\u0430 \u0406\u0440\u0430\u0434\u044b\u044f\u0434\u044b, \u0436\u043e\u043d\u043a\u0456 \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0424\u0456\u043b\u0456\u043f\u0430, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0451\u043d \u0430\u0436\u0430\u043d\u0456\u045e\u0441\u044f \u0437 \u0451\u0439.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u041a\u0430\u0440\u043e\u043b\u044c \u043f\u0430\u0441\u043b\u0430\u045e \u043a\u00e1\u0442\u0430 \u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0433\u0430\u043b\u0430\u0432\u0443 \u042f\u043d\u0430. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417-\u0437\u0430 \u0406\u0440\u0430\u0434\u044b\u044f\u0434\u044b.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"760","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u042d\u0437\u044d\u0445\u0456\u044d\u043b\u044f\u00bb \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 1, 11, 4-6: CCL 142, 170-172)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0417 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u044f \u043d\u0435 \u0448\u043a\u0430\u0434\u0443\u044e \u0441\u044f\u0431\u0435 \u045e \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0421\u044b\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u042f \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0446\u044f\u0431\u0435 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u043e\u043c \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f\u00bb (\u042d\u0437\u0445 3, 16). \u0422\u0440\u044d\u0431\u0430 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c, \u0448\u0442\u043e \u041f\u0430\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u043e\u043c \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u0437 \u043f\u0430\u0441\u043b\u0443\u0433\u0430\u0439 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f. \u0412\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u0442\u0430\u0456\u0446\u044c \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u0456\u043c \u043c\u0435\u0441\u0446\u044b, \u043a\u0430\u0431 \u0437\u0434\u0430\u043b\u0451\u043a \u0431\u0430\u0447\u044b\u0446\u044c, \u0446\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043d\u0435 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430. \u0422\u0430\u043c\u0443 \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0431\u044b\u045e \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u043e\u043c \u043d\u0430\u0440\u043e\u0434\u0443, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u0442\u0430\u044f\u0446\u044c \u0432\u044b\u0441\u043e\u043a\u0430 \u045e \u0441\u044d\u043d\u0441\u0435 \u043c\u0430\u0440\u0430\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0436\u044b\u0446\u0446\u044f, \u043a\u0430\u0431 \u043c\u043e\u0433 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0456\u0448\u043d\u044b\u043c, \u0430\u0441\u0446\u0435\u0440\u0430\u0433\u0430\u044e\u0447\u044b \u0456\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a \u0436\u0430 \u0441\u0443\u0440\u043e\u0432\u0430 \u0433\u0443\u0447\u0430\u0446\u044c \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u043a\u0430\u0436\u0443. \u0422\u0430\u043a\u043e\u0439 \u043c\u043e\u0432\u0430\u044e \u044f \u0440\u0430\u043d\u044e \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u0431\u043e \u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u044f\u043a \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c, \u0456 \u0445\u043e\u0446\u044c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u044f\u043a \u0443\u043c\u0435\u044e, \u0430\u0434\u043d\u0430\u043a \u0436\u044b\u0446\u0446\u0451 \u043c\u0430\u0451 \u043d\u0435 \u0456\u0434\u0437\u0435 \u0437\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u0441\u043f\u0440\u0430\u0447\u0430\u044e\u0441\u044f \u2013 \u044f \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b. \u0411\u0430\u0447\u0443 \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0456 \u043d\u044f\u0434\u0431\u0430\u0439\u043d\u0430\u0441\u0446\u044c. \u041c\u043e\u0436\u0430, \u043f\u0440\u044b\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u043c\u0430\u0451\u0439 \u0432\u0456\u043d\u044b \u0432\u044b\u043f\u0440\u0430\u0448\u0443 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u045e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0433\u0430 \u0421\u0443\u0434\u0434\u0437\u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435. \u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u043a\u0430\u043b\u0456 \u044f \u0431\u044b\u045e \u0443 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u044b, \u044f \u045e\u043c\u0435\u045e \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0441\u0432\u043e\u0439 \u044f\u0437\u044b\u043a \u0430\u0434 \u043d\u0435\u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e \u0456 \u0430\u043c\u0430\u043b\u044c \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u0430\u043b\u0456\u045e\u0441\u044f. \u0410\u043b\u0435 \u043f\u0430\u0437\u043d\u0435\u0439, \u043a\u0430\u043b\u0456 \u045e\u0441\u043a\u043b\u0430\u045e \u043d\u0430 \u0441\u044f\u0431\u0435 \u0446\u044f\u0436\u0430\u0440 \u043f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u0433\u0430 \u043a\u043b\u043e\u043f\u0430\u0442\u0443, \u044f \u0440\u0430\u0437\u0440\u044b\u0432\u0430\u044e\u0441\u044f \u043f\u0430\u043c\u0456\u0436 \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456 \u0456 \u043d\u0435 \u043c\u0430\u0433\u0443 \u043d\u0430\u043b\u0435\u0436\u043d\u0430 \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0437\u0430\u0439\u043c\u0430\u0446\u0446\u0430 \u0442\u043e \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0442\u043e \u0437\u043d\u043e\u045e \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u0430. \u0417\u0434\u0430\u0440\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0430\u0446\u044d\u043d\u044c\u0432\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0456 \u045e\u0447\u044b\u043d\u043a\u0456 \u043a\u0430\u043d\u043a\u0440\u044d\u0442\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430 \u0447\u0430\u0441\u0430\u043c \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u043a\u0456\u044f \u0437\u0430\u0434\u0430\u043d\u043d\u0456 \u0446\u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043a\u0440\u044b\u0432\u0430\u0432\u044b\u0445 \u043d\u0430\u0431\u0435\u0433\u0430\u045e \u0432\u0430\u0440\u0432\u0430\u0440\u0430\u045e, \u0446\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0430\u044f\u0446\u0446\u0430 \u0432\u0430\u045e\u043a\u043e\u045e, \u044f\u043a\u0456\u044f \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u044e\u0446\u044c \u043c\u0430\u0451\u0439 \u0430\u045e\u0447\u0430\u0440\u043d\u0456. \u042f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430, \u043a\u0430\u0431 \u0431\u044b\u043b\u0430 \u0430\u043a\u0430\u0437\u0430\u043d\u0430 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u044f \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0440\u044d\u0433\u0443\u043b\u044b, \u0430\u0431\u043e \u0437\u043d\u043e\u045e \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0430\u0434 \u0440\u043e\u0437\u043d\u044b\u0445 \u0440\u0430\u0431\u0430\u045e\u043d\u0456\u043a\u043e\u045e, \u0446\u0456, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u0437\u043b\u0443, \u0441\u0442\u0430\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u043f\u0440\u044b \u0433\u044d\u0442\u044b\u043c \u043d\u0435 \u0437\u0433\u0440\u0430\u0448\u044b\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043b\u044e\u0431\u043e\u0432\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0440\u043e\u0437\u0443\u043c \u0440\u0430\u0437\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0456\u043c\u0456 \u0432\u0430\u0436\u043d\u044b\u043c\u0456 \u0456 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456, \u044f\u043a \u0436\u0430 \u0451\u043d \u0437\u043c\u043e\u0436\u0430 \u0437\u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u0446\u0430\u043b\u043a\u0430\u043c \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043d\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0456 \u0456 \u043d\u0435 \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u043f\u0430\u0441\u043b\u0443\u0433\u0456 \u0441\u043b\u043e\u0432\u0430? \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0437\u0430\u0434\u0430\u043d\u0430\u043d\u043d\u044f \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u0446\u0446\u0430 \u0437 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u0441\u0432\u0435\u0442\u0443, \u0437\u0434\u0430\u0440\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u044f \u0447\u0430\u0441\u0430\u043c \u0434\u0430\u044e \u0441\u0432\u0430\u0431\u043e\u0434\u0443 \u0441\u0432\u0430\u0439\u043c\u0443 \u044f\u0437\u044b\u043a\u0443. \u041a\u0430\u043b\u0456 \u0436 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0441\u0430\u0447\u0443 \u0437\u0430 \u0441\u0430\u0431\u043e\u044e, \u0442\u043e \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e, \u0448\u0442\u043e \u0441\u043b\u0430\u0431\u044b\u044f \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u044e\u0446\u044c \u043c\u044f\u043d\u0435; \u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u044f \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0456\u0445 \u0442\u0443\u0434\u044b, \u043a\u0443\u0434\u044b \u0445\u0430\u0446\u0435\u045e \u0431\u044b. \u0422\u0430\u043c\u0443 \u0431\u044b\u0432\u0430\u0435, \u0448\u0442\u043e \u044f \u0447\u0430\u0441\u0442\u0430 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0441\u043b\u0443\u0445\u0430\u044e \u043d\u0435\u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u044f \u0440\u0430\u0437\u043c\u043e\u0432\u044b. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f \u0441\u0430\u043c \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b, \u0442\u0430\u043c\u0443 \u043f\u0430\u0441\u0442\u0443\u043f\u043e\u0432\u0430 \u045e\u0446\u044f\u0433\u0432\u0430\u044e\u0441\u044f \u045e \u0433\u044d\u0442\u044b\u044f \u043d\u0435\u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u044f \u0440\u0430\u0437\u043c\u043e\u0432\u044b, \u043f\u0430\u0447\u044b\u043d\u0430\u044e \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0456\u0445, \u0445\u043e\u0446\u044c \u043d\u0430\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u043b\u0443\u0445\u0430\u045e \u0456\u0445 \u0437 \u0430\u0433\u0456\u0434\u0430\u0439. \u0423 \u0432\u044b\u043d\u0456\u043a\u0443, \u0442\u0430\u043c, \u043a\u0443\u0434\u044b \u044f \u0431\u0430\u044f\u045e\u0441\u044f \u045e\u043f\u0430\u0441\u0446\u0456, \u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0443 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044c. \u042f\u043a\u0456 \u0436 \u0437 \u043c\u044f\u043d\u0435 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a, \u043a\u0430\u043b\u0456 \u044f \u043d\u0435 \u0441\u0442\u0430\u044e \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0443, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0443\u0441\u044f \u045e \u0434\u0430\u043b\u0456\u043d\u0435 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456. \u0410\u0434\u043d\u0430\u043a \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0456 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u043c\u0430\u0435 \u043c\u043e\u0446 \u0443\u0434\u0437\u044f\u043b\u0456\u0446\u044c \u043c\u043d\u0435, \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u043c\u0443, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0436\u044b\u0446\u0446\u044f, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u043b\u0451\u043d \u0441\u043b\u043e\u0432\u0430, \u0431\u043e \u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u042f\u0433\u043e \u044f \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u044e \u0441\u044f\u0431\u0435 \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044e \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u0430.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0417 \u041f\u0456\u0441\u0430\u043d\u043d\u044f\u045e \u0447\u044d\u0440\u043f\u0430\u045e \u043f\u0440\u044b\u043d\u0446\u044b\u043f\u044b \u043c\u0430\u0440\u0430\u043b\u0456 \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u044b\u0445 \u0442\u0430\u044f\u043c\u043d\u0456\u0446, \u0432\u044b\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u043d\u0430 \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0430\u0442\u043e\u043a\u0456 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f.&nbsp;<\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0425\u043e\u0446\u044c \u0456 \u043f\u0430\u043c\u0451\u0440, \u0430\u043b\u0435 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0435 \u0456 \u0441\u0451\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u041f\u043e\u0437\u0456\u0440\u043a\u0430\u043c \u0430\u0440\u043b\u0430 \u0430\u0445\u0430\u043f\u0456\u045e \u0441\u0432\u0435\u0442, \u0430 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u2013 \u043c\u0430\u043b\u044b\u0445 \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u0445. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0425\u043e\u0446\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"762","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u0441\u0432. \u0410\u043d\u0434\u0440\u044d\u044f \u041a\u0440\u044b\u0446\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 1: PG 97, 806-810)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u0442\u0430\u0440\u043e\u0435 \u043c\u0456\u043d\u0443\u043b\u0430, \u0456 \u0432\u043e\u0441\u044c \u2013 \u0443\u0441\u0451 \u043d\u043e\u0432\u0430\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0412\u044f\u0440\u0448\u044b\u043d\u044f\u0439 \u0436\u0430 \u0417\u0430\u043a\u043e\u043d\u0443 \u0451\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441\u00bb (\u0420\u044b\u043c 10, 4). \u0401\u043d, \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u044e\u0447\u044b \u043d\u0430\u0441 \u0430\u0434 \u0417\u0430\u043a\u043e\u043d\u0443, \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430 \u0434\u0443\u0445\u0430. \u0423 \u0406\u043c \u0441\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u045e\u0441\u0451, \u0431\u043e \u044f\u043a \u041f\u0440\u0430\u0432\u0430\u0434\u044b\u0440, \u044f\u043a\u0456 \u045e\u0441\u0451 \u0441\u043f\u043e\u045e\u043d\u0456\u045e \u0456 \u0434\u0430\u0432\u0451\u045e \u0434\u0430 \u043a\u0430\u043d\u0446\u0430, \u0437\u0430\u043c\u044f\u043d\u0456\u045e \u043b\u0456\u0442\u0430\u0440\u0443 \u0417\u0430\u043a\u043e\u043d\u0443 \u0434\u0443\u0445\u0430\u043c \u0456 \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443\u045e \u0443\u0441\u0451 \u0434\u0430 \u0441\u044f\u0431\u0435 \u044f\u043a \u0413\u0430\u043b\u0430\u0432\u0430. \u0417\u0430\u043a\u043e\u043d \u0431\u044b\u045e \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b \u043b\u0430\u0441\u043a\u0430\u0439 \u0456 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b \u0451\u0439. \u0410 \u043b\u0430\u0441\u043a\u0430 \u0433\u0430\u0440\u043c\u0430\u043d\u0456\u0447\u043d\u0430 \u0437\u043b\u0443\u0447\u044b\u043b\u0430\u0441\u044f \u0437 \u0417\u0430\u043a\u043e\u043d\u0430\u043c \u0456 \u0437\u2019\u044f\u0434\u043d\u0430\u043b\u0430\u0441\u044f \u0437 \u0456\u043c. \u0413\u044d\u0442\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e \u0437\u043c\u044f\u0448\u0430\u043d\u043d\u0435\u043c \u0446\u0456 \u0437\u043b\u0456\u0446\u0446\u0451\u043c \u0443\u043b\u0430\u0441\u0446\u0456\u0432\u0430\u0441\u0446\u0456 \u0417\u0430\u043a\u043e\u043d\u0443 \u0437 \u0443\u043b\u0430\u0441\u0446\u0456\u0432\u0430\u0441\u0446\u044e \u043b\u0430\u0441\u043a\u0456, \u0430\u043b\u0435 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0430\u0439, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u0430\u0439 \u043f\u0440\u0430\u0437 \u0411\u043e\u0436\u0443\u044e \u043c\u043e\u0446. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0451\u0439, \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0417\u0430\u043a\u043e\u043d\u0435 \u0431\u044b\u043b\u043e \u0446\u044f\u0436\u043a\u0456\u043c, \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0432\u0430\u043b\u0430 \u0456 \u0433\u043d\u044f\u043b\u043e, \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u043b\u0430\u0441\u044f \u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u043b\u0451\u0433\u043a\u0430\u0435 \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0435, \u043a\u0430\u0431 \u043c\u044b \u045e\u0436\u043e \u043d\u0435 \u00ab\u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0441\u0442\u044b\u0445\u0456\u044f\u043c \u0441\u0432\u0435\u0442\u0443\u00bb (\u0413\u0430\u043b 4, 3) \u0456 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u043f\u0430\u0434 \u044f\u0440\u043c\u043e\u043c \u043b\u0456\u0442\u0430\u0440\u044b \u0417\u0430\u043a\u043e\u043d\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u045e \u0433\u044d\u0442\u044b\u043c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b\u0445 \u0434\u043b\u044f \u043d\u0430\u0441 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u045e, \u0443 \u0433\u044d\u0442\u044b\u043c \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u043c\u0435\u0440 \u0411\u043e\u0433\u0430, \u0443 \u0433\u044d\u0442\u044b\u043c \u2013 \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435 \u0411\u043e\u0441\u043a\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u2013 \u0411\u043e\u0433 \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0443 \u0433\u044d\u0442\u044b\u043c \u2013 \u0430\u0431\u0430\u0433\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u0433\u0430 \u0421\u043b\u043e\u0432\u0430\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0422\u0430\u043c\u0443 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430, \u043a\u0430\u0431 \u0442\u0430\u043a\u043e\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435 \u0456 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0411\u043e\u0433\u0430 \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439 \u0431\u044b\u043b\u043e \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0430\u043d\u0430 \u043f\u044d\u045e\u043d\u044b\u043c \u0443\u0432\u044f\u0434\u0437\u0435\u043d\u043d\u0435\u043c \u0443 \u0433\u044d\u0442\u0443\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0445\u0432\u0456\u043b\u0456\u043d\u0430\u0439, \u044f\u043a\u0430\u044f \u0434\u0430\u043b\u0430 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0442\u0430\u043a\u043e\u043c\u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u043c\u0443 \u0434\u043b\u044f \u043d\u0430\u0441 \u0434\u0430\u0440\u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u043c\u044b \u045e\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0435\u043c \u043f\u0430\u0434\u0447\u0430\u0441 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0441\u0432\u044f\u0442\u0430. \u041d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c, \u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c \u0456 \u043c\u044d\u0442\u0430\u044e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u0421\u043b\u043e\u0432\u0430 \u0437 \u0446\u0435\u043b\u0430\u043c. \u0412\u043e\u0441\u044c \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u0432\u0435\u0442 \u0414\u0437\u0435\u0432\u0430, \u043f\u0440\u044b\u043c\u0430\u0435 \u0435\u0436\u0443 \u0456 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0435, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u041c\u0430\u0446\u0456 \u0411\u043e\u0433\u0430, \u041a\u0430\u0440\u0430\u043b\u044f \u0432\u044f\u043a\u043e\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u0441\u044e\u043b\u044c \u0434\u043b\u044f \u043d\u0430\u0441 \u0432\u044b\u043f\u043b\u044b\u0432\u0430\u0435 \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u0430\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u044c. \u041c\u0430\u0440\u044b\u044f \u0432\u044f\u0434\u0437\u0435 \u043d\u0430\u0441 \u0434\u0430 \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u0430\u0434\u0440\u044b\u0432\u0430\u0435 \u0430\u0434 \u0436\u044b\u0446\u0446\u044f \u045e \u043d\u044f\u0432\u043e\u043b\u0456 \u0417\u0430\u043a\u043e\u043d\u0443. \u042f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c? \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0447\u0430\u043c\u0443? \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0446\u0435\u043c\u0440\u0430 \u0441\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u0430\u043c\u0443 \u0441\u0432\u044f\u0442\u043b\u0443, \u0448\u0442\u043e \u043b\u0430\u0441\u043a\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0432\u0430\u0431\u043e\u0434\u0443 \u0437\u0430\u043c\u0435\u0441\u0442 \u043b\u0456\u0442\u0430\u0440\u044b \u0417\u0430\u043a\u043e\u043d\u0443. \u0421\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u044f \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u0435 \u043c\u0435\u0436\u044b \u0433\u044d\u0442\u044b\u0445 \u0447\u0430\u0441\u043e\u045e. \u041f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0441\u0443\u0432\u044f\u0437\u044c \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u0456 \u0437 \u0441\u0456\u043c\u0432\u0430\u043b\u0430\u043c\u0456 \u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u044f\u043c\u0456, \u0437\u0430\u043c\u044f\u043d\u044f\u044e\u0447\u044b \u0421\u0442\u0430\u0440\u044b \u0417\u0430\u043f\u0430\u0432\u0435\u0442 \u041d\u043e\u0432\u044b\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0443\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0441\u043f\u044f\u0432\u0430\u0435, \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0456 \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435 \u0432\u044f\u0441\u0435\u043b\u043b\u0435 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0434\u043d\u044f. \u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435 \u0436\u044b\u0445\u0430\u0440\u044b \u0437\u044f\u043c\u043b\u0456 \u0456 \u043d\u0435\u0431\u0430 \u0441\u0451\u043d\u043d\u044f \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c. \u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435 \u0440\u0430\u0437\u0430\u043c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u045e \u043d\u0435\u0431\u0435 \u0441\u0432\u044f\u0442\u043a\u0443\u044e\u0446\u044c. \u0411\u043e \u0441\u0451\u043d\u043d\u044f \u0431\u044b\u043b\u0430 \u045e\u0437\u043d\u0435\u0441\u0435\u043d\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044e \u0441\u0443\u0441\u0432\u0435\u0442\u0443, \u0441\u0451\u043d\u043d\u044f \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0441\u0456\u043b\u0430\u044e \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0433\u0430 \u043d\u0430\u043c\u0435\u0440\u0443 \u0411\u043e\u0433\u0430 \u0440\u044b\u0445\u0442\u0443\u0435 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044e \u043d\u043e\u0432\u0430\u0435 \u0436\u044b\u043b\u043b\u0451.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0413\u043e\u0434\u043d\u0430 \u045e\u0448\u0430\u043d\u0443\u0435\u043c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044b \u041c\u0430\u0440\u044b\u0456, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u041f\u0430\u043d\u043d\u044b. <\/span><span style=\"color: #ff0000;\">*<\/span><span style=\"color: #ff00ff;\"> <\/span><span>\u042f\u0435 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u045e\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0421\u044d\u0440\u0446\u0430\u043c \u0456 \u0434\u0443\u0448\u043e\u044e \u0441\u043f\u044f\u0432\u0430\u0435\u043c \u0445\u0432\u0430\u043b\u0443 \u0425\u0440\u044b\u0441\u0442\u0443 \u045e \u0433\u044d\u0442\u0430\u0435 \u0441\u0432\u044f\u0442\u043e\u0435 \u0441\u0432\u044f\u0442\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0439 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u044b \u041c\u0430\u0440\u044b\u0456. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"764","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u041a\u043b\u044f\u0432\u044d\u0440\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. Diei 31 maii 1627: A. Valtierra, S. I., San Pedro Claver, Cartagena 1964, pp. 140-141)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0443\u0431\u043e\u0433\u0456\u043c, \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u0446\u044c \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u043c,&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u043f\u0430\u043b\u043e\u043d\u043d\u044b\u043c \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0447\u043e\u0440\u0430, 30 \u043c\u0430\u044f \u0433\u044d\u0442\u0430\u0433\u0430 1627 \u0433\u043e\u0434\u0430, \u0432\u0430 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0422\u0440\u043e\u0439\u0446\u044b, \u0441\u044b\u0448\u043b\u043e \u043d\u0430 \u0431\u0435\u0440\u0430\u0433 \u0437 \u0432\u044f\u043b\u0456\u0437\u043d\u0430\u0433\u0430 \u043a\u0430\u0440\u0430\u0431\u043b\u044f \u0448\u043c\u0430\u0442 \u043d\u0435\u0433\u0440\u0430\u045e, \u044f\u043a\u0456\u0445 \u0441\u0445\u0430\u043f\u0456\u043b\u0456 \u043b\u044f \u0430\u0444\u0440\u044b\u043a\u0430\u043d\u0441\u043a\u0456\u0445 \u0440\u044d\u043a. \u041c\u044b \u043f\u0430\u0431\u0435\u0433\u043b\u0456 \u0434\u0430 \u0456\u0445, \u043d\u0435\u0441\u0443\u0447\u044b \u045e \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u044b\u0445 \u043a\u0430\u0448\u0430\u0445 \u0437\u0430\u043b\u0430\u0446\u0456\u0441\u0442\u044b\u044f \u0430\u043f\u0435\u043b\u044c\u0441\u0456\u043d\u044b, \u043b\u0456\u043c\u043e\u043d\u044b, \u043f\u0435\u0447\u044b\u0432\u0430 \u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u044f\u0448\u0447\u044d. \u041c\u044b \u043f\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0434\u0430 \u0456\u0445 \u0431\u0430\u0440\u0430\u043a\u0430\u045e. \u041d\u0430\u043c \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u043c\u044b \u0442\u0440\u0430\u043f\u0456\u043b\u0456 \u045e \u0434\u0440\u0443\u0433\u0443\u044e \u0413\u0432\u0456\u043d\u0435\u044e. \u0422\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u043f\u0440\u0430\u0431\u0456\u0432\u0430\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u043d\u0430\u0442\u043e\u045e\u043f, \u043a\u0430\u0431 \u0434\u0430\u0431\u0440\u0430\u0446\u0446\u0430 \u0434\u0430 \u0445\u0432\u043e\u0440\u044b\u0445, \u044f\u043a\u0456\u0445 \u0431\u044b\u043b\u043e \u0432\u0435\u043b\u044c\u043c\u0456 \u0448\u043c\u0430\u0442. \u042f\u043d\u044b \u043b\u044f\u0436\u0430\u043b\u0456 \u043d\u0430 \u0441\u044b\u0440\u043e\u0439 \u0437\u044f\u043c\u043b\u0456, \u0430 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0435\u0439, \u0443 \u0433\u0440\u0430\u0437\u0456. \u041a\u0430\u0431 \u0430\u0431\u043b\u0435\u0433\u0447\u044b\u0446\u044c \u0456\u0445 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u043d\u0430\u043c \u0443\u0434\u0430\u043b\u043e\u0441\u044f \u0437 \u043a\u0430\u0432\u0430\u043b\u043a\u0430\u045e \u0446\u044d\u0433\u043b\u044b \u0456 \u0430\u0431\u043b\u043e\u043c\u043a\u0430\u045e \u0447\u0430\u0440\u0430\u043f\u0456\u0446\u044b \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0435\u0432\u044f\u043b\u0456\u043a\u0456 \u043d\u0430\u0441\u0446\u0456\u043b, \u0456 \u044f\u043d\u044b \u045e\u0436\u043e \u043d\u0435 \u043b\u044f\u0436\u0430\u043b\u0456 \u043d\u0430 \u043c\u043e\u043a\u0440\u0430\u0439 \u0437\u044f\u043c\u043b\u0456. \u041d\u0430\u0441\u0446\u0456\u043b \u0437\u0430\u043c\u044f\u043d\u0456\u045e \u0456\u043c \u043b\u043e\u0436\u0430\u043a, \u0430\u043b\u0435 \u0431\u044b\u045e, \u043d\u0430 \u0436\u0430\u043b\u044c, \u0432\u0435\u043b\u044c\u043c\u0456 \u043d\u044f\u0437\u0440\u0443\u0447\u043d\u044b\u043c \u044f\u0448\u0447\u044d \u0456 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u044f\u043d\u044b \u043b\u044f\u0436\u0430\u043b\u0456 \u0433\u043e\u043b\u044b\u044f, \u043d\u0435 \u043c\u0430\u044e\u0447\u044b \u043d\u0456\u044f\u043a\u0430\u0439 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0456 \u0456 \u043a\u043e\u045e\u0434\u0440\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u043d\u044f\u045e\u0448\u044b \u043f\u043b\u0430\u0448\u0447\u044b, \u043c\u044b \u043f\u0430\u0447\u0430\u043b\u0456 \u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0430\u0441\u0446\u0456\u043b\u044b \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u045e \u043a\u043b\u0430\u0434\u043e\u045e\u0446\u044b. \u0422\u0430\u043a \u043c\u044b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0456 \u043c\u0435\u0441\u0446\u044b \u0434\u043b\u044f \u0445\u0432\u043e\u0440\u044b\u0445, \u043a\u0443\u0434\u044b \u0456\u0445 \u0456 \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u043b\u0456, \u043f\u0440\u0430\u0431\u0456\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u043f\u0440\u0430\u0437 \u0446\u0435\u0441\u043d\u044b \u043d\u0430\u0442\u043e\u045e\u043f. \u0417\u0430\u0442\u044b\u043c \u043c\u044b \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u043b\u0456\u0441\u044f \u043d\u0430 \u0434\u0437\u0432\u0435 \u0433\u0440\u0443\u043f\u044b: \u0443 \u0430\u0434\u043d\u043e\u0439 \u0431\u044b\u045e \u043c\u043e\u0439 \u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044c \u0437 \u043f\u0435\u0440\u0430\u043a\u043b\u0430\u0434\u0447\u044b\u043a\u0430\u043c, \u0443 \u0434\u0440\u0443\u0433\u043e\u0439 \u044f. \u0414\u0432\u043e\u0435 \u0437 \u043d\u0456\u0433\u0435\u0440\u044b\u0439\u0446\u0430\u045e \u0443\u0436\u043e \u043f\u0430\u043c\u0456\u0440\u0430\u043b\u0456, \u0431\u044b\u043b\u0456 \u0430\u043c\u0430\u043b\u044c \u0445\u0430\u043b\u043e\u0434\u043d\u044b\u044f, \u0446\u044f\u0436\u043a\u0430 \u0431\u044b\u043b\u043e \u043d\u0430\u0432\u0430\u0442 \u043d\u0430\u0448\u0447\u0443\u043f\u0430\u0446\u044c \u043f\u0443\u043b\u044c\u0441. \u0417 \u0441\u0430\u0431\u0440\u0430\u043d\u044b\u0445 \u0440\u044d\u0448\u0442\u0430\u043a \u0434\u0430\u0445\u0443 \u043c\u044b \u0437\u043b\u0430\u0434\u0437\u0456\u043b\u0456 \u0432\u043e\u0433\u043d\u0456\u0448\u0447\u0430 \u0456 \u0437\u0430\u043f\u0430\u043b\u0456\u043b\u0456 \u044f\u0433\u043e \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0445\u0432\u043e\u0440\u044b\u0445. \u0423 \u0430\u0433\u043e\u043d\u044c \u043a\u0456\u043d\u0443\u043b\u0456 \u045e\u0441\u0435 \u0437\u0451\u043b\u043a\u0456, \u0448\u0442\u043e \u043c\u0435\u043b\u0456 \u045e \u043a\u0456\u0448\u044d\u043d\u044f\u0445. \u041f\u0430\u0441\u043b\u044f \u043f\u0440\u044b\u043a\u0440\u044b\u043b\u0456 \u0445\u0432\u043e\u0440\u044b\u0445 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u043b\u0430\u0448\u0447\u0430\u043c\u0456, \u0431\u043e \u045e \u0456\u0445 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0431\u044b\u043b\u043e, \u0430 \u0456\u0445 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0434\u0430\u0432\u0430\u043b\u0456. \u0422\u0430\u043a \u044f\u043d\u044b \u0430\u0434\u0430\u0433\u0440\u044d\u043b\u0456\u0441\u044f \u0456 \u043f\u0430\u0436\u0432\u0430\u0432\u0435\u043b\u0456. \u0423 \u0456\u0445\u043d\u0456\u0445 \u0432\u0430\u0447\u0430\u0445 \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0431\u0430\u0447\u044b\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0437 \u044f\u043a\u043e\u0439 \u044f\u043d\u044b \u0433\u043b\u044f\u0434\u0437\u0435\u043b\u0456 \u043d\u0430 \u043d\u0430\u0441.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043c\u044b \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u043b\u0456 \u0434\u0430 \u0456\u0445 \u2013 \u043d\u0435 \u0441\u043b\u043e\u0432\u0430\u043c, \u0430\u043b\u0435 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u043d\u0430\u0448\u044b\u0445 \u0440\u0443\u043a. \u042f\u043a\u0430\u044f-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0456\u043d\u0448\u0430\u044f \u043c\u043e\u0432\u0430 \u043d\u0435 \u0437\u0430\u043a\u0440\u0430\u043d\u0443\u043b\u0430 \u0431 \u0456\u0445, \u0431\u043e \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b\u044f, \u0448\u0442\u043e \u0456\u0445 \u043f\u0440\u044b\u0432\u0435\u0437\u043b\u0456 \u043d\u0430 \u0437\u2019\u044f\u0434\u0437\u0435\u043d\u043d\u0435. \u041c\u044b \u0436 \u0441\u0430\u0434\u0437\u0456\u043b\u0456\u0441\u044f \u0430\u0431\u043e \u043a\u043b\u0435\u043d\u0447\u044b\u043b\u0456 \u043a\u0430\u043b\u044f \u0456\u0445, \u0430\u0431\u043c\u044b\u0432\u0430\u044e\u0447\u044b \u0432\u0456\u043d\u043e\u043c \u0456\u0445 \u0442\u0432\u0430\u0440\u044b \u0456 \u0446\u0435\u043b\u044b, \u0441\u0442\u0430\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0456\u0445 \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0433\u0430\u0434\u0432\u0430\u044e\u0447\u044b \u0440\u043e\u0437\u043d\u044b\u044f \u0436\u044b\u0446\u0446\u0451\u0432\u044b\u044f \u0441\u0456\u0442\u0443\u0430\u0446\u044b\u0456, \u044f\u043a\u0456\u044f \u0431 \u043c\u0430\u0433\u043b\u0456 \u0445\u043e\u0446\u044c \u043d\u0435\u044f\u043a \u045e\u0437\u043d\u044f\u0446\u044c \u043d\u0430\u0441\u0442\u0440\u043e\u0439 \u0445\u0432\u043e\u0440\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0441\u043b\u044f \u043c\u044b \u043f\u0430\u0447\u0430\u043b\u0456 \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u0456\u043c \u0437 \u043a\u0430\u0442\u044d\u0445\u0456\u0437\u0456\u0441\u0430 \u043f\u0430\u043d\u044f\u0446\u0446\u0435 \u0445\u0440\u043e\u0441\u0442\u0443, \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u044f\u0433\u043e \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u043f\u043b\u0451\u043d \u0434\u043b\u044f \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u0430. \u0410 \u043a\u0430\u043b\u0456 \u0437 \u0456\u0445 \u0430\u0434\u043a\u0430\u0437\u0443 \u043d\u0430 \u043d\u0430\u0448\u044b\u044f \u043f\u044b\u0442\u0430\u043d\u043d\u0456 \u0432\u044b\u043d\u0456\u043a\u0430\u043b\u0430, \u0448\u0442\u043e \u044f\u043d\u044b \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456, \u043c\u044b \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u0431\u043e\u043b\u044c\u0448 \u0448\u044b\u0440\u043e\u043a\u0456\u0445 \u0442\u044d\u043c\u0430\u045e, \u043a\u0430\u0436\u0443\u0447\u044b \u043f\u0440\u0430 \u0410\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0434\u0430\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0430\u0431\u043e \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435, \u0443 \u0437\u0430\u043b\u0435\u0436\u043d\u0430\u0441\u0446\u0456 \u0430\u0434 \u043d\u0430\u0448\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e. \u0417\u0430\u043a\u0440\u0430\u043d\u0430\u043b\u0456 \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u044f \u043f\u044b\u0442\u0430\u043d\u043d\u0456. \u0423\u0440\u044d\u0448\u0446\u0435, \u0437\u0432\u044f\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0437 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u0439, \u043a\u0430\u0431 \u044f\u043d\u044b \u0430\u0431\u0443\u0434\u0437\u0456\u043b\u0456 \u0430\u043a\u0442 \u0436\u0430\u043b\u044e \u0456 \u0430\u0434\u0447\u0443\u043b\u0456 \u0430\u0433\u0456\u0434\u0443 \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e. \u041a\u0430\u043b\u0456 \u0431\u0430\u0447\u043d\u0430 \u0431\u044b\u043b\u043e, \u0448\u0442\u043e \u044f\u043d\u044b \u045e\u0436\u043e \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u044f, \u043c\u044b \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u043b\u0456 \u0456\u043c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0422\u0440\u043e\u0439\u0446\u044b, \u0423\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u041c\u0443\u043a\u0456. \u0423\u0440\u044d\u0448\u0446\u0435, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u0432\u044b\u044f\u0432\u0443 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u0430\u0433\u0430 \u043d\u0430\u0434 \u043a\u0443\u043f\u0435\u043b\u043b\u044e \u0445\u0440\u043e\u0441\u0442\u0443, \u0443 \u044f\u043a\u0443\u044e \u0441\u0446\u044f\u043a\u0430\u043b\u0430 \u043a\u0440\u043e\u045e \u0437 \u0440\u0430\u043d\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u043c\u044b \u043f\u0440\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u0456\u043c \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0430 \u0441\u0432\u0430\u0451\u0439 \u043c\u043e\u0432\u0435 \u0441\u043b\u043e\u0432\u044b \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0446 25, 35. 40; \u042f\u043d 15, 12\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u042f \u0431\u044b\u045e \u0433\u0430\u043b\u043e\u0434\u043d\u044b, \u0456 \u0432\u044b \u0434\u0430\u043b\u0456 \u041c\u043d\u0435 \u0435\u0441\u0446\u0456; \u043f\u0440\u0430\u0433\u043d\u0443\u045e, \u0456 \u0432\u044b \u043d\u0430\u043f\u0430\u0456\u043b\u0456 \u041c\u044f\u043d\u0435; \u0431\u044b\u045e \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u044b\u043c, \u0456 \u0432\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u041c\u044f\u043d\u0435;<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043a\u0430\u0436\u0443 \u0432\u0430\u043c: \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0430\u0434\u043d\u0430\u043c\u0443 \u0437 \u0433\u044d\u0442\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u041c\u0430\u0456\u0445 \u043c\u0435\u043d\u0448\u044b\u0445, \u0432\u044b \u041c\u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0412\u043e\u0441\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u041c\u0430\u044f, \u043a\u0430\u0431 \u0432\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"766","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ante exsilium, nn. 1-3: PG 52, 427*-430)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0414\u043b\u044f \u043c\u044f\u043d\u0435 \u044b\u0446\u0446\u0451 \u2013 \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u2013 \u0433\u044d\u0442\u0430 \u0432\u044b\u0433\u0430\u0434\u0430<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt;\"><span>\u0412\u043e\u0441\u044c \u0443\u0437\u0434\u044b\u043c\u0430\u044e\u0446\u0446\u0430 \u043c\u043e\u0446\u043d\u044b\u044f \u0445\u0432\u0430\u043b\u0456 \u0456 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u044e\u0446\u0446\u0430 \u0433\u0440\u043e\u0437\u043d\u044b\u044f \u0431\u0443\u0440\u044b, \u0430\u0434\u043d\u0430\u043a \u043c\u044b \u043d\u0435 \u0431\u0430\u0456\u043c\u0441\u044f \u0433\u0456\u0431\u0435\u043b\u0456; \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u0435\u043c\u0441\u044f \u043d\u0430 \u0441\u043a\u0430\u043b\u0443. \u041d\u044f\u0445\u0430\u0439 \u0448\u0430\u043b\u0435\u0435 \u043c\u043e\u0440\u0430, \u044f\u043d\u043e \u043d\u0435 \u0437\u043c\u043e\u0436\u0430 \u0441\u043a\u0440\u044b\u0448\u044b\u0446\u044c \u0441\u043a\u0430\u043b\u0443; \u043d\u044f\u0445\u0430\u0439 \u0443\u0437\u0434\u044b\u043c\u0430\u044e\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u0456, \u044f\u043d\u044b \u043d\u0435 \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0430\u0442\u0430\u043f\u0456\u0446\u044c \u0415\u0437\u0443\u0441\u0430\u0432\u044b \u0447\u043e\u0432\u0435\u043d. \u0427\u0430\u0433\u043e \u0436 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u0430\u044f\u0446\u0446\u0430? \u0421\u043c\u0435\u0440\u0446\u0456? \u00ab\u0414\u043b\u044f \u043c\u044f\u043d\u0435 \u0436\u044b\u0446\u0446\u0451 \u2013 \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u2013 \u0433\u044d\u0442\u0430 \u0432\u044b\u0433\u0430\u0434\u0430\u00bb (\u0424\u043b\u043f 1, 21). \u0421\u043a\u0430\u0436\u044b, \u043c\u043e\u0436\u0430 \u0431\u0430\u044f\u0446\u0446\u0430 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u044f? \u00ab\u041f\u0430\u043d\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0437\u044f\u043c\u043b\u044f \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0430 \u0451\u0439\u00bb (\u041f\u0441 24 [23], 1). \u041c\u043e\u0436\u0430 \u0431\u0430\u044f\u0446\u0446\u0430 \u0441\u0442\u0440\u0430\u0442\u044b \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u0456? \u00ab\u041c\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043c \u0443 \u0441\u0432\u0435\u0442 \u0456 \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043d\u0456\u0447\u043e\u0433\u0430 \u0432\u044b\u043d\u0435\u0441\u0446\u0456\u00bb (1 \u0426\u0456\u043c 6, 7). \u042f \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u044e \u043f\u0430\u0433\u0440\u043e\u0437\u0430\u043c\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0456 \u0433\u0440\u044d\u0431\u0443\u044e \u043f\u0430\u0445\u0432\u0430\u043b\u043e\u044e. \u041d\u0435 \u0431\u0430\u044e\u0441\u044f \u0431\u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0443 \u0431\u0430\u0433\u0430\u0446\u0446\u044f, \u043d\u0435 \u0434\u0440\u044b\u0436\u0443 \u043f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u0430 \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0433\u043d\u0443 \u0436\u044b\u0446\u0446\u044f, \u0442\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0432\u0430\u0448\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443 \u043a\u0430\u0436\u0443 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430, \u0456 \u043f\u0440\u0430\u0448\u0443, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u0433\u0443\u0431\u043b\u044f\u043b\u0456 \u043d\u0430\u0434\u0437\u0435\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt;\"><span>\u0426\u0456 \u0442\u044b \u043d\u0435 \u0447\u0443\u0435\u0448 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430: \u00ab\u0414\u0437\u0435 \u0434\u0432\u043e\u0435 \u0446\u0456 \u0442\u0440\u043e\u0435 \u0441\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f \u045e \u0456\u043c\u044f \u041c\u0430\u0451, \u0442\u0430\u043c \u042f \u0451\u0441\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0456\u0445\u00bb (\u041c\u0446 18, 20). \u0426\u0456 \u0436 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u042f\u0433\u043e \u0442\u0430\u043c, \u0434\u0437\u0435 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u044b \u043f\u043e\u0432\u044f\u0437\u044f\u043c\u0456 \u043b\u044e\u0431\u043e\u0432\u0456? \u041c\u0430\u044e\u0447\u044b \u042f\u0433\u043e \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435, \u0446\u0456 \u0431\u0443\u0434\u0443 \u044f \u0440\u0430\u0437\u043b\u0456\u0447\u0432\u0430\u0446\u044c \u043d\u0430 \u045e\u043b\u0430\u0441\u043d\u044b\u044f \u0441\u0456\u043b\u044b? \u042f \u043c\u0430\u044e \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u0430. \u0412\u043e\u0441\u044c \u043c\u0430\u044f \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0430, \u0432\u043e\u0441\u044c \u0430\u0431\u0430\u0440\u043e\u043d\u0430, \u0432\u043e\u0441\u044c \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430\u0435 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043f\u0440\u044b\u0441\u0442\u0430\u043d\u0456\u0448\u0447\u0430. \u0425\u043e\u0446\u044c \u0431\u044b \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u043f\u0430\u045e\u0441\u0442\u0430\u045e \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435, \u044f \u0442\u0440\u044b\u043c\u0430\u044e\u0441\u044f \u042f\u0433\u043e \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f, \u0441\u043b\u0443\u0445\u0430\u044e \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u0430; \u0432\u043e\u0441\u044c \u043c\u0430\u044f \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044f, \u0432\u043e\u0441\u044c \u043c\u0430\u044f \u0430\u0431\u0430\u0440\u043e\u043d\u0430. \u042f\u043a\u0456\u044f \u0436 \u0433\u044d\u0442\u0430 \u0441\u043b\u043e\u0432\u044b? \u00ab\u0412\u043e\u0441\u044c \u042f \u0437 \u0432\u0430\u043c\u0456 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456, \u0430\u0436 \u0434\u0430 \u0441\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u044f \u0432\u0435\u043a\u0443\u00bb (\u041c\u0446 28, 20).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt;\"><span>\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0430 \u043c\u043d\u043e\u044e, \u043a\u0430\u0433\u043e \u0436 \u043c\u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430? \u0425\u043e\u0446\u044c \u0431\u044b \u045e\u0437\u043d\u044f\u043b\u0456\u0441\u044f \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435 \u0445\u0432\u0430\u043b\u0456, \u0446\u0456 \u043c\u043e\u0440\u0430, \u0446\u0456 \u0433\u043d\u0435\u045e \u043c\u043e\u0446\u043d\u044b\u0445 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u2013 \u0443\u0441\u0451 \u0433\u044d\u0442\u0430 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043d\u0456\u0448\u0442\u043e, \u043d\u0430\u0432\u0430\u0442 \u043c\u0435\u043d\u0448 \u0437\u0430 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0435 \u043f\u0430\u0432\u0443\u0446\u0456\u043d\u043d\u0435. \u041a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0443\u044e \u043c\u0430\u044e \u0434\u0430 \u0432\u0430\u0441, \u2013 \u0443\u0436\u043e \u0441\u0451\u043d\u043d\u044f \u044f \u0432\u044b\u0440\u0443\u0448\u044b\u045e \u0431\u044b \u045e \u0434\u0430\u0440\u043e\u0433\u0443. \u0410\u043b\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043a\u0430\u0436\u0443: \u00ab\u041f\u0430\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0432\u043e\u043b\u044f \u0422\u0432\u0430\u044f\u00bb (\u043f\u0430\u0440. \u041c\u0446 26, 42). \u042f \u0432\u044b\u043a\u0430\u043d\u0430\u044e \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0445\u043e\u0447\u0430\u0448 \u0422\u044b, \u0430 \u043d\u0435 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043f\u0440\u0430\u0433\u043d\u0435 \u0442\u043e\u0439 \u0446\u0456 \u0456\u043d\u0448\u044b. \u0412\u043e\u0441\u044c \u043c\u0430\u044f \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044f, \u0432\u043e\u0441\u044c \u043c\u0430\u044f \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u044f \u0441\u043a\u0430\u043b\u0430, \u0432\u043e\u0441\u044c \u043d\u0430\u0434\u0437\u0435\u0439\u043d\u0430\u044f \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u0442\u0430\u043a \u0445\u043e\u0447\u0430 \u0411\u043e\u0433, \u043d\u044f\u0445\u0430\u0439 \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435. \u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u044f \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u0442\u0443\u0442, \u044f \u0434\u0437\u044f\u043a\u0443\u044e \u042f\u043c\u0443. \u0406 \u043a\u0443\u0434\u044b \u0431 \u0451\u043d \u043d\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043f\u0430\u0441\u043b\u0430\u0446\u044c \u043c\u044f\u043d\u0435, \u044f \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e \u042f\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt;\"><span>\u0414\u0437\u0435 \u044f, \u0442\u0430\u043c \u0456 \u0432\u044b; \u0434\u0437\u0435 \u0432\u044b, \u0442\u0430\u043c \u0456 \u044f. \u041c\u044b \u0441\u0442\u0432\u0430\u0440\u0430\u0435\u043c \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430, \u0442\u0430\u043c\u0443 \u043d\u0456 \u0446\u0435\u043b\u0430 \u0430\u0434 \u0433\u0430\u043b\u0430\u0432\u044b \u043d\u0435 \u043c\u043e\u0436\u0430 \u0430\u0434\u043b\u0443\u0447\u044b\u0446\u0446\u0430, \u043d\u0456 \u0433\u0430\u043b\u0430\u0432\u0430 \u0430\u0434 \u0446\u0435\u043b\u0430. \u041d\u0430\u0441 \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u044f\u0435 \u0430\u0434\u043b\u0435\u0433\u043b\u0430\u0441\u0446\u044c, \u0430\u043b\u0435 \u044f\u0434\u043d\u0430\u0435 \u043b\u044e\u0431\u043e\u045e. \u0422\u0430\u043a\u043e\u0439 \u043f\u043e\u0432\u044f\u0437\u0456 \u043d\u0430\u0432\u0430\u0442 \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0435 \u043c\u043e\u0436\u0430 \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u0446\u044c. \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u043f\u0430\u043c\u0440\u044d \u043c\u0430\u0451 \u0446\u0435\u043b\u0430, \u0434\u0443\u0448\u0430 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0456 \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt;\"><span>\u0412\u044b \u2013 \u043c\u0430\u0435 \u0441\u0443\u0433\u0440\u0430\u043c\u0430\u0434\u0437\u044f\u043d\u0435, \u0432\u044b \u2013 \u043c\u0430\u0435 \u0431\u0430\u0446\u044c\u043a\u0456, \u0431\u0440\u0430\u0442\u044b, \u0441\u044b\u043d\u044b, \u0447\u043b\u0435\u043d\u044b, \u043c\u0430\u0451 \u0446\u0435\u043b\u0430, \u0432\u044b \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0430 \u043d\u0430\u0432\u0430\u0442 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0441\u0432\u044f\u0442\u043b\u043e. \u0412\u0430\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0434\u0430\u0435 \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0430 \u0431\u043e\u043b\u044c\u0448 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0447\u044b\u043c \u043f\u0440\u043e\u043c\u043d\u0456 \u0441\u043e\u043d\u0446\u0430. \u0421\u043e\u043d\u0446\u0430 \u043c\u043d\u0435 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0434\u043b\u044f \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0430 \u0432\u0430\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0440\u044b\u0445\u0442\u0443\u0435 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0436\u044b\u0446\u0446\u0456.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">2 \u0426\u0456\u043c 2, 9-10\u0430; \u041f\u0441 27 (26), 1\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0417\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u044f \u0446\u044f\u0440\u043f\u043b\u044e \u043d\u044f\u0434\u043e\u043b\u044e \u0430\u0436 \u0434\u0430 \u043a\u0430\u0439\u0434\u0430\u043d\u0430\u045e, \u043d\u0456\u0431\u044b \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430. \u0410\u043b\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0441\u043b\u043e\u0432\u0430 \u043d\u0435 \u0437\u043d\u044f\u0432\u043e\u043b\u0456\u0448, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0442\u0430\u043c\u0443 \u044f \u045e\u0441\u0451 \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e \u0434\u0437\u0435\u043b\u044f \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u041f\u0430\u043d \u2013 \u043c\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u043c\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435: \u043a\u0430\u0433\u043e \u0436 \u043c\u043d\u0435 \u0431\u0430\u044f\u0446\u0446\u0430? <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u0430\u043c\u0443.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"767","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u0441\u0432. \u0410\u043d\u0434\u0440\u044d\u044f \u041a\u0440\u044b\u0446\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 10 in Exaltatione sanct\u00e6 crucis: PG 97, 1018-1019. 1022-1023)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0425\u0432\u0430\u043b\u043e\u044e \u0456 \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043a\u0440\u044b\u0436<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u0421\u0451\u043d\u043d\u044f \u043c\u044b \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u043c \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u043a\u0440\u044b\u0436\u0430, \u044f\u043a\u0456 \u0440\u0430\u0441\u0441\u0435\u044f\u045e \u0446\u0435\u043c\u0440\u0443 \u0456 \u0432\u044f\u0440\u043d\u0443\u045e \u0441\u0432\u044f\u0442\u043b\u043e. \u0410\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u043c \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u043a\u0440\u044b\u0436\u0430 \u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0423\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b\u043c \u0443\u0437\u043d\u043e\u0441\u0456\u043c\u0441\u044f \u045e\u0433\u0430\u0440\u0443, \u043a\u0430\u0431, \u043f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0437\u044f\u043c\u043b\u044e \u0456 \u0433\u0440\u0430\u0445\u0456, \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b. \u0412\u043e\u0441\u044c \u044f\u043a\u043e\u0439 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0439 \u0456 \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0430\u0439 \u0440\u044d\u0447\u0447\u0443 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u0430\u043b\u043e\u0434\u0430\u043d\u043d\u0435 \u043a\u0440\u044b\u0436\u043e\u043c. \u0425\u0442\u043e \u043c\u0430\u0435 \u043a\u0440\u044b\u0436, \u0442\u043e\u0439 \u043c\u0430\u0435 \u0441\u043a\u0430\u0440\u0431. \u042f \u0441\u043b\u0443\u0448\u043d\u0430 \u043d\u0430\u0437\u0432\u0430\u045e \u0441\u043a\u0430\u0440\u0431\u0430\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0437 \u043d\u0430\u0437\u0432\u044b \u0456 \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0439\u0446\u0443\u0434\u043e\u045e\u043d\u0435\u0439\u0448\u044b\u043c \u0437 \u0443\u0441\u0456\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e. \u0411\u043e \u043f\u0440\u0430\u0437 \u044f\u0433\u043e, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043c\u0443 \u0456 \u045e \u0456\u043c \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u0434\u0430 \u043f\u0435\u0440\u0448\u0430\u0441\u043d\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u043a\u0440\u044b\u0436\u0430, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0431\u044b\u045e \u0431\u044b \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b. \u041a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u043a\u0440\u044b\u0436\u0430, \u0416\u044b\u0446\u0446\u0451 \u043d\u0435 \u0431\u044b\u043b\u043e \u0431 \u043f\u0440\u044b\u0431\u0456\u0442\u0430 \u0446\u0432\u0456\u043a\u0430\u043c\u0456 \u0434\u0430 \u0434\u0440\u044d\u0432\u0430. \u041a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0440\u044b\u0431\u0456\u0442\u0430\u0435 \u0446\u0432\u0456\u043a\u0430\u043c\u0456, \u0437 \u0431\u043e\u043a\u0443 \u043d\u0435 \u0432\u044b\u0446\u044f\u043a\u043b\u0430 \u0431 \u043a\u0440\u043e\u045e \u0456 \u0432\u0430\u0434\u0430 \u0434\u0437\u0435\u043b\u044f \u0430\u0447\u044b\u0448\u0447\u044d\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443, \u043d\u0435 \u0431\u044b\u045e \u0431\u044b \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b \u0437\u0430\u043f\u0456\u0441 \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u043c\u044b \u0431 \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u0443, \u043d\u0435 \u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0431 \u0434\u0440\u044d\u0432\u0443 \u0436\u044b\u0446\u0446\u044f, \u0430 \u0440\u0430\u0439 \u0431\u044b \u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u045e\u0441\u044f. \u041a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u0431\u044b\u043b\u043e \u043a\u0440\u044b\u0436\u0430, \u043d\u0435 \u0431\u044b\u043b\u0430 \u0431 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u043f\u0435\u043a\u043b\u0430 \u043d\u0435 \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0430 \u0431 \u0441\u0432\u0430\u0451\u0439 \u043c\u043e\u0446\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0439 \u0440\u044d\u0447\u0447\u0443 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043a\u0440\u044b\u0436. \u0412\u044f\u043b\u0456\u043a\u0430\u0439, \u0431\u043e \u043f\u0440\u0430\u0437 \u044f\u0433\u043e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0448\u043c\u0430\u0442 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u043c\u0430\u0442, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043e\u043b\u044c\u0448\u0430\u0441\u0446\u044c \u0437 \u0456\u0445 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u043b\u0451\u043d\u0430\u043c \u0446\u0443\u0434\u0430\u045e \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u0425\u0440\u044b\u0441\u0442\u0430. \u041a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0439, \u0431\u043e \u043a\u0440\u044b\u0436 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u043d\u0430\u043a\u0430\u043c \u043c\u0443\u043a\u0456 \u0456 \u0442\u0440\u044b\u0443\u043c\u0444\u0443 \u0411\u043e\u0433\u0430: \u0437\u043d\u0430\u043a\u0430\u043c \u043c\u0443\u043a\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0434\u0430\u0431\u0440\u0430\u0432\u043e\u043b\u044c\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456 \u045e \u043f\u0430\u043a\u0443\u0442\u0430\u0445; \u0437\u043d\u0430\u043a\u0430\u043c \u0442\u0440\u044b\u0443\u043c\u0444\u0443, \u0431\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043c\u0443 \u0431\u044b\u045e \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u044b \u0441\u0430\u0442\u0430\u043d\u0430, \u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c; \u0431\u043e \u0431\u044b\u043b\u0456 \u0440\u0430\u0437\u0431\u0443\u0440\u0430\u043d\u044b \u0431\u0440\u0430\u043c\u044b \u043f\u0435\u043a\u043b\u0430, \u0430 \u043a\u0440\u044b\u0436 \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443 \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u044b\u043c \u0437\u043d\u0430\u043a\u0430\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u041a\u0440\u044b\u0436 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u043e\u044e \u0456 \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430. \u0413\u044d\u0442\u0430 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b \u043a\u0435\u043b\u0456\u0445, \u044f\u043a\u0456 \u0437\u0431\u0456\u0440\u0430\u0435 \u045e\u0441\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u044f\u043a\u0456\u044f \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u0437\u0430 \u043d\u0430\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0410\u0431 \u0442\u044b\u043c, \u0448\u0442\u043e \u043a\u0440\u044b\u0436 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u043e\u044e \u0425\u0440\u044b\u0441\u0442\u0430, \u0434\u0430\u0432\u0435\u0434\u0430\u0439\u0441\u044f \u0437 \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u045e: \u00ab\u0426\u044f\u043f\u0435\u0440 \u0443\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u0430 \u0411\u043e\u0433 \u0443\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u045e \u0406\u043c, \u0456 \u0445\u0443\u0442\u043a\u0430 \u045e\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u042f\u0433\u043e\u00bb (\u042f\u043d 13, 31. 32). \u0406 \u0437\u043d\u043e\u045e \u0436\u0430: \u00ab\u041e\u0439\u0447\u0430, \u0443\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435 \u045e \u0441\u0430\u0431\u0435 \u0445\u0432\u0430\u043b\u043e\u044e, \u044f\u043a\u0443\u044e \u043c\u0435\u045e \u042f \u045e \u0426\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0441\u0432\u0435\u0442\u0443\u00bb (\u042f\u043d 12, 28). \u0406 \u044f\u0448\u0447\u044d: \u00ab\u201c\u041e\u0439\u0447\u0430, \u0443\u0441\u043b\u0430\u045e \u0456\u043c\u044f \u0441\u0432\u0430\u0451!\u201d \u0406 \u043f\u0430\u0447\u0443\u045e\u0441\u044f \u0437 \u043d\u0435\u0431\u0430 \u0433\u043e\u043b\u0430\u0441: \u201c\u0423\u0441\u043b\u0430\u0432\u0456\u045e \u0456 \u045e\u0441\u043b\u0430\u045e\u043b\u044e \u0437\u043d\u043e\u045e!\u201d\u00bb (\u042f\u043d 12, 28). \u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u045e\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u043d\u0430 \u0441\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u0401\u043d \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043d\u0430 \u043a\u0440\u044b\u0436\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u0410\u0431 \u0442\u044b\u043c, \u0448\u0442\u043e \u043a\u0440\u044b\u0436 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0448\u0442\u043e \u0401\u043d \u0441\u0430\u043c \u043a\u0430\u0436\u0430: \u00ab\u042f, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u045e\u0437\u043d\u044f\u0442\u044b \u043d\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u044e, \u0443\u0441\u0456\u0445 \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443 \u0434\u0430 \u0441\u044f\u0431\u0435\u00bb (\u042f\u043d 12, 32). \u0422\u0430\u043c\u0443 \u0431\u0430\u0447\u044b\u0448: \u043a\u0440\u044b\u0436 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u043e\u044e \u0456 \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u041e \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u043a\u0440\u044b\u0436, \u0443 \u044f\u043a\u0456\u043c \u0443\u0442\u043e\u0435\u043d\u044b \u0441\u043a\u0430\u0440\u0431 \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b\u0445, <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u043f\u0440\u0430\u0437 \u044f\u043a\u0456 \u0441\u0432\u0435\u0442 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u043f\u0440\u0430\u0437 \u043a\u0440\u043e\u045e \u044f\u0433\u043e \u041f\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0412\u0456\u0442\u0430\u0439, \u043a\u0440\u044b\u0436, \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b \u0446\u0435\u043b\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430; \u044f\u0433\u043e \u0447\u043b\u0435\u043d\u044b \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u043b\u0456 \u0446\u044f\u0431\u0435 \u043d\u0456\u0431\u044b \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456. <\/span><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u041f\u0440\u0430\u0437 \u044f\u043a\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"768","GCH_CH_2_Text":"&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430, \u0430\u0431\u0430\u0442\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo in dom. infra oct. Assumptionis, 14-15: Opera omnia, Edit. Cisterc. 5 [1968], 273-274)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410 \u043f\u0430\u0434 \u043a\u044b\u0436\u0430\u043c \u041c\u0430\u0446\u0456 \u0441\u0442\u0430\u043b\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456 \u043a\u0430\u0436\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u0421\u0456\u043c\u044f\u043e\u043d\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u043f\u0430\u0432\u044f\u0434\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u043c\u0443\u043a\u0443 \u041f\u0430\u043d\u0430. \u00ab\u0412\u043e\u0441\u044c \u0433\u044d\u0442\u044b, \u2013 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0414\u0437\u0456\u0446\u044f\u0442\u043a\u0430 \u0415\u0437\u0443\u0441 \u0441\u0442\u0430\u0440\u0430\u0446 \u0421\u0456\u043c\u044f\u043e\u043d, \u2013\u0437\u043d\u0430\u043a, \u044f\u043a\u043e\u043c\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0446\u0446\u0430 \u0431\u0443\u0434\u0443\u0446\u044c\u00bb. \u041c\u0430\u0440\u044b\u0456 \u0436 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0410 \u043f\u0440\u0430\u0437 \u0422\u0432\u0430\u044e \u0434\u0443\u0448\u0443 \u043f\u0440\u043e\u0439\u0434\u0437\u0435 \u043c\u0435\u0447, \u043a\u0430\u0431 \u0432\u044b\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u0434\u0443\u043c\u043a\u0456 \u043c\u043d\u043e\u0433\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u045e\u00bb (\u041b\u043a 2, 34-35).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041e \u0441\u0432\u044f\u0442\u0430\u044f \u041c\u0430\u0446\u0456! \u041c\u0435\u0447 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u0430\u0446\u044f\u045e \u0422\u0432\u0430\u044e \u0434\u0443\u0448\u0443. \u0401\u043d \u043d\u0435 \u0437\u043c\u043e\u0433 \u0431\u044b \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0446\u0435\u043b\u0430 \u0421\u044b\u043d\u0430, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u043f\u0440\u0430\u0446\u044f\u045e \u0434\u0443\u0448\u0443 \u041c\u0430\u0446\u0456. \u041a\u0430\u043b\u0456 \u0436 \u0422\u0432\u043e\u0439 \u0415\u0437\u0443\u0441 \u2013 \u0443\u0441\u0456\u0445, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0430\u043b\u0435 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0422\u0432\u043e\u0439, \u2013 \u0432\u044b\u043f\u0443\u0441\u0446\u0456\u045e \u0434\u0443\u0445, \u0436\u043e\u0440\u0441\u0442\u043a\u0430\u044f \u0434\u0437\u0456\u0434\u0430 \u043d\u0435 \u043f\u0440\u0430\u0431\u0456\u043b\u0430 \u042f\u0433\u043e \u0434\u0443\u0448\u0443. \u041f\u0430\u043c\u0435\u0440\u043b\u0430\u043c\u0443, \u044f\u043a\u043e\u043c\u0443 \u045e\u0436\u043e \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u043f\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0435\u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u044f \u0434\u0437\u0456\u0434\u0430, \u044f\u043d\u0430 \u043f\u0440\u0430\u0431\u0456\u043b\u0430 \u0431\u043e\u043a, \u0430 \u0422\u0430\u0431\u0435 \u2013 \u0441\u044d\u0440\u0446\u0430. \u0422\u0430\u043c \u0443\u0436\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u042f\u0433\u043e \u0434\u0443\u0448\u044b, \u0430\u043b\u0435 \u0422\u0432\u0430\u044f \u045e\u0436\u043e \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u045e\u0446\u044f\u0447\u044b \u0430\u0434\u0442\u0443\u043b\u044c. \u0421\u0442\u0440\u0430\u0448\u043d\u044b \u0431\u043e\u043b\u044c \u043f\u0440\u0430\u0446\u044f\u045e \u0422\u0432\u0430\u044e \u0434\u0443\u0448\u0443, \u0442\u0430\u043c\u0443 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043c\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u043c \u0426\u044f\u0431\u0435 \u0431\u043e\u043b\u044c\u0448 \u0447\u044b\u043c \u041c\u0443\u0447\u0430\u043d\u0456\u0446\u0430\u0439, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0431\u043e\u043b\u044c \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u044f \u0431\u043e\u043b\u044c\u0448\u044b \u0437\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0446\u0435\u043b\u0430. \u0426\u0456 \u0436 \u043d\u0435 \u0431\u044b\u043b\u0456 \u0434\u043b\u044f \u0426\u044f\u0431\u0435 \u0447\u044b\u043c\u0441\u044c\u0446\u0456 \u0431\u043e\u043b\u044c\u0448\u044b\u043c \u0437\u0430 \u043c\u0435\u0447 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0440\u0430\u043d\u0456\u043b\u0456 \u0434\u0443\u0448\u0443 \u0430\u0436 \u0434\u0430 \u0430\u0434\u0434\u0437\u044f\u043b\u0435\u043d\u043d\u044f \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u0430: \u00ab\u0416\u0430\u043d\u0447\u044b\u043d\u0430, \u0432\u043e\u0441\u044c \u0441\u044b\u043d \u0422\u0432\u043e\u0439\u00bb (\u042f\u043d 19, 26). \u0428\u0442\u043e \u0437\u0430 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b \u0430\u0431\u043c\u0435\u043d! \u0417\u0430\u043c\u0435\u0441\u0442 \u0415\u0437\u0443\u0441\u0430 \u0431\u044b\u045e \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0422\u0430\u0431\u0435 \u042f\u043d, \u0441\u043b\u0443\u0433\u0430 \u0437\u0430\u043c\u0435\u0441\u0442 \u041f\u0430\u043d\u0430, \u0432\u0443\u0447\u0430\u043d\u044c \u0437\u0430\u043c\u0435\u0441\u0442 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430, \u0441\u044b\u043d \u0417\u044d\u0431\u044d\u0434\u044d\u044f \u0437\u0430\u0441\u043c\u0435\u0441\u0442 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0430\u043c\u0435\u0441\u0442 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0411\u043e\u0433\u0430. \u0422\u0432\u0430\u0451\u0439, \u043d\u0430\u0434\u0437\u0432\u044b\u0447\u0430\u0439 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u0439 \u0434\u0443\u0448\u044b, \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u043d\u0435 \u0437\u0440\u0430\u043d\u0456\u0446\u044c \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u0445 \u0441\u0430\u043c\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b\u0433\u0430\u0434\u0432\u0430\u043d\u043d\u0435 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0436\u0430\u043b\u0435\u043c \u043d\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b, \u0445\u043e\u0446\u044c \u044f\u043d\u044b \u0437 \u043a\u0430\u043c\u0435\u043d\u043d\u044f \u0456 \u0436\u0430\u043b\u0435\u0437\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430, \u0448\u0442\u043e \u041c\u0430\u0440\u044b\u044f \u0441\u0442\u0430\u043b\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0430\u0439 \u0443 \u0434\u0443\u0445\u0443. \u041c\u043e\u0436\u0430 \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u043c\u044f\u0442\u0430\u0435, \u0448\u0442\u043e \u041f\u0430\u0432\u0435\u043b \u0441\u044f\u0440\u043e\u0434 \u0441\u0430\u043c\u044b\u0445 \u0446\u044f\u0436\u043a\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u043d\u044f\u0447\u0443\u043b\u0430\u0441\u0446\u044c. \u0421\u044d\u0440\u0446\u0430 \u041c\u0430\u0440\u044b\u0456 \u0431\u044b\u043b\u043e \u0434\u0430\u043b\u0451\u043a\u0430\u0435 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430, \u0434\u0430\u043b\u0451\u043a\u0430\u0435 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0430\u0434 \u042f\u0435 \u0441\u043b\u0443\u0433\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a, \u0445\u0442\u043e \u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u0425\u0456\u0431\u0430 \u042f\u043d\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u043b\u0430 \u0440\u0430\u043d\u0435\u0439, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u043f\u0430\u043c\u0440\u044d?\u00bb \u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430. \u00ab\u0425\u0456\u0431\u0430 \u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u043b\u0430\u0441\u044f, \u0448\u0442\u043e \u0445\u0443\u0442\u043a\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0435?\u00bb \u041d\u0430\u043f\u044d\u045e\u043d\u0430. \u00ab\u0406 \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0433\u044d\u0442\u0430 \u0446\u044f\u0440\u043f\u0435\u043b\u0430, \u0431\u0430\u0447\u0443\u0447\u044b \u0423\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430?\u00bb \u0412\u0435\u043b\u044c\u043c\u0456. \u0410\u043b\u0435 \u0445\u0442\u043e \u0442\u044b, \u0448\u0442\u043e \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u0448, \u043a\u0430\u043b\u0456 \u0442\u0430\u0431\u0435 \u0446\u044f\u0436\u044d\u0439 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u0435 \u041c\u0430\u0440\u044b\u0456 \u0437\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435 \u0421\u044b\u043d\u0430 \u041c\u0430\u0440\u044b\u0456? \u0401\u043d \u043c\u043e\u0433 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u045e \u0446\u0435\u043b\u0435, \u0430 \u042f\u043d\u0430 \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u0446\u044c \u0443 \u0434\u0443\u0445\u0443? \u0423 \u0425\u0440\u044b\u0441\u0446\u0435 \u045e\u0447\u044b\u043d\u0456\u043b\u0430 \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u043e\u045e, \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0437\u0430 \u044f\u043a\u0443\u044e \u043d\u0435 \u043c\u0435\u045e \u043d\u0456\u0445\u0442\u043e. \u0423 \u041c\u0430\u0440\u044b\u0456 \u2013 \u043b\u044e\u0431\u043e\u045e, \u0437 \u044f\u043a\u043e\u0439 \u043d\u0456\u044f\u043a\u0430\u044f \u0456\u043d\u0448\u0430\u044f, \u043f\u0430-\u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439, \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u045e\u043d\u044f\u0446\u0446\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041b\u043a 23, 33; \u043f\u0430\u0440. \u042f\u043d 19, 25; \u043f\u0430\u0440. \u041b\u043a 2, 35\r\n<p><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u043d\u0430 \u043c\u0435\u0441\u0446\u0430, \u0437\u0432\u0430\u043d\u0430\u0435 \u0427\u044d\u0440\u0430\u043f, \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043b\u0456 \u0442\u0430\u043c \u042f\u0433\u043e. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u041a\u0430\u043b\u044f \u043a\u0440\u044b\u0436\u0430 \u0415\u0437\u0443\u0441\u0430 \u0441\u0442\u0430\u044f\u043b\u0430 \u042f\u0433\u043e\u043d\u0430\u044f \u041c\u0430\u0446\u0456.&nbsp;<\/span><\/p>\r\n<p><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0422\u0430\u0434\u044b \u042f\u0435 \u0441\u0432\u044f\u0442\u0443\u044e \u0434\u0443\u0448\u0443 \u043f\u0440\u0430\u0446\u044f\u045e \u043c\u0435\u0447 \u0431\u043e\u043b\u044e. <\/span><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u041a\u0430\u043b\u044f \u043a\u0440\u044b\u0436\u0430.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"769","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 60, 1-2. 5: CSEL 3, 691-692. 694-695)<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u044f \u0456 \u0440\u0430\u0448\u0443\u0447\u0430\u044f \u0432\u0435\u0440\u0430<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u0456\u043f\u0440\u044b\u044f\u043d \u041a\u0430\u0440\u043d\u044d\u043b\u0456\u044e, \u0441\u0432\u0430\u0439\u043c\u0443 \u0431\u0440\u0430\u0442\u0443 \u045e \u0431\u0456\u0441\u043a\u0443\u043f\u0441\u0442\u0432\u0435. \u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u043c\u044b \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430 \u0432\u0430\u0448\u0430\u0435 \u0432\u0435\u043b\u044c\u043c\u0456 \u0441\u043b\u0430\u045e\u043d\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0432\u0435\u0440\u044b \u0456 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456. \u0413\u043e\u043d\u0430\u0440 \u0432\u0430\u0448\u0430\u0433\u0430 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f \u043c\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0437 \u0432\u044f\u043b\u0456\u0437\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0448\u0442\u043e \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435 \u043c\u044b \u043b\u0456\u0447\u044b\u043c \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0456 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u045e\u0441\u0456\u0445 \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u045e \u0456 \u0441\u043b\u0430\u0432\u044b. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u0437\u0456\u043d \u0451\u0441\u0446\u044c \u043d\u0430\u0448 \u041a\u0430\u0441\u0446\u0451\u043b, \u0430\u0434\u0437\u0456\u043d \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u044b \u0434\u0443\u0445, \u0430\u0434\u043d\u0430 \u043d\u0435\u043f\u0430\u0434\u0437\u0435\u043b\u044c\u043d\u0430\u044f \u0433\u0430\u0440\u043c\u043e\u043d\u0456\u044f \u0441\u044d\u0440\u0446\u0430\u045e, \u0442\u043e \u044f\u043a\u0456 \u0436 \u0441\u0432\u044f\u0442\u0430\u0440, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0447\u044b \u0445\u0432\u0430\u043b\u0443 \u0456\u043d\u0448\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0451\u0439 \u044f\u043a \u0441\u0432\u0430\u0451\u0439 \u0443\u043b\u0430\u0441\u043d\u0430\u0439?<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041d\u0435\u043b\u044c\u0433\u0430 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0443\u0441\u044e \u043d\u0430\u0448\u0443\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0448\u0447\u0430\u0441\u0446\u0435, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443 \u043f\u0440\u0430 \u0432\u0430\u0448\u0443\u044e \u0430\u0434\u0432\u0430\u0433\u0443. \u0422\u044b \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u0431\u0440\u0430\u0442\u043e\u045e \u043f\u0440\u0430\u0432\u0430\u0434\u043d\u0456\u043a\u043e\u043c \u0443 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0456 \u0432\u0435\u0440\u044b, \u0430\u043b\u0435 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u0431\u0440\u0430\u0442\u043e\u045e \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043b\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430. \u0422\u0430\u043a, \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b \u0456\u043d\u0448\u044b\u0445 \u043d\u0430 \u0448\u043b\u044f\u0445\u0443 \u0434\u0430 \u0445\u0432\u0430\u043b\u044b, \u0442\u044b \u043c\u043d\u043e\u0433\u0456\u0445 \u0443\u0447\u044b\u043d\u0456\u045e \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0433\u044d\u0442\u0430\u0439 \u0445\u0432\u0430\u043b\u044b. \u0411\u0443\u0434\u0443\u0447\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0433\u0430\u0442\u043e\u0432\u044b\u043c \u0432\u044b\u0437\u043d\u0430\u0446\u044c \u043f\u0435\u0440\u0448\u044b\u043c \u0456 \u0437\u0430 \u045e\u0441\u0456\u0445, \u0442\u044b \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u045e \u0443\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0434\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u045e \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443 \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0443 \u0432\u0430\u0441: \u0446\u0456 \u0442\u0432\u0430\u044e \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0443\u044e \u0456 \u043f\u043e\u045e\u043d\u0443\u044e \u0433\u0430\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u0443, \u0446\u0456 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0431\u0440\u0430\u0442\u043e\u045e. \u041c\u0443\u0436\u043d\u0430\u0441\u0446\u044c \u0431\u0456\u0441\u043a\u0443\u043f\u0430, \u044f\u043a\u0456 \u0456\u0434\u0437\u0435 \u043d\u0430 \u0447\u0430\u043b\u0435, \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u0432\u0430 \u045e\u0441\u0451\u0439 \u043f\u0430\u045e\u043d\u0430\u0446\u0435; \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430 \u0431\u0430\u0447\u043d\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0431\u0440\u0430\u0442\u043e\u045e, \u044f\u043a\u0456\u044f \u0456\u0434\u0443\u0446\u044c \u0441\u043b\u0435\u0434\u0430\u043c \u0437\u0430 \u0456\u043c. \u0423\u0432\u0435\u0441\u044c \u0420\u044b\u043c\u0441\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u043f\u0440\u0430\u0437 \u0432\u0430\u0441 \u0434\u0430\u045e \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435, \u0431\u043e \u0432\u044b \u043f\u0430\u043a\u0430\u0437\u0430\u043b\u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0443 \u0441\u043b\u043e\u0432\u0430\u0445 \u0456 \u0434\u0443\u043c\u043a\u0430\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u0431\u0440\u0430\u0442, \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u045e \u0432\u0430\u0448\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0442\u0430\u044f \u0432\u0435\u0440\u0430, \u044f\u043a\u0443\u044e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u045e \u0441\u0432\u044f\u0442\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b. \u0423\u0436\u043e \u0442\u0430\u0434\u044b \u0451\u043d \u0431\u0430\u0447\u044b\u045e \u0443 \u0434\u0443\u0445\u0443 \u0445\u0432\u0430\u043b\u0443 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456 \u0456 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0443\u044e \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u044c \u0456, \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e\u0447\u044b \u045e \u0441\u043b\u043e\u0432\u0430\u0445 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u0432\u0430\u0448\u044b\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u0456 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0430\u0439\u0446\u043e\u045e, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0441\u044b\u043d\u043e\u045e \u0434\u0430 \u0432\u0435\u0440\u044b. \u0421\u0432\u0430\u0456\u043c \u0430\u0434\u0437\u0456\u043d\u0430\u0434\u0443\u043c\u0441\u0442\u0432\u0430\u043c \u0456 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u044e \u0432\u044b \u0434\u0430\u043b\u0456 \u0431\u0440\u0430\u0442\u0430\u043c \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0437\u0433\u043e\u0434\u044b \u0456 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041c\u044b \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435\u043c \u0432\u0430\u0441, \u044f\u043a \u0443\u043c\u0435\u0435\u043c, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u0431\u0440\u0430\u0442, \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0430\u044f \u044f\u0434\u043d\u0430\u0435 \u043d\u0430\u0441; \u0431\u043e \u0411\u043e\u0436\u044b \u041f\u0440\u043e\u0432\u0456\u0434 \u0432\u0443\u0447\u044b\u0446\u044c, \u0430 \u0411\u043e\u0433 \u0443 \u0441\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0437\u0431\u0430\u045e\u0447\u044b\u043c\u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u043c\u0456 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435, \u0448\u0442\u043e \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u045e\u0436\u043e \u0434\u043b\u044f \u043d\u0430\u0441 \u0434\u0437\u0435\u043d\u044c \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u044b \u0456 \u0430\u043f\u043e\u0448\u043d\u0456\u0445 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f\u045e, \u0442\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u044b\u043c\u0456 \u045e \u043f\u043e\u0441\u0446\u0435, \u0447\u0443\u0432\u0430\u043d\u043d\u0456, \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445 \u0440\u0430\u0437\u0430\u043c \u0437 \u0443\u0441\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c. \u0413\u044d\u0442\u0430 \u043d\u0430\u0448\u0430\u044f \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u044f \u0437\u0431\u0440\u043e\u044f, \u044f\u043a\u0430\u044f \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u043d\u0430\u043c \u043c\u0443\u0436\u043d\u0430 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0456 \u0432\u044b\u0441\u0442\u0430\u044f\u0446\u044c. \u0413\u044d\u0442\u0430 \u043d\u0430\u0448\u044b\u044f \u0430\u0431\u0430\u0440\u043e\u043d\u0447\u044b\u044f \u043c\u0443\u0440\u044b \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0441\u0442\u0440\u044d\u043b\u044b, \u044f\u043a\u0456\u044f \u043d\u0430\u0441 \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u044e\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0411\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u0430\u0434\u043d\u044b\u044f \u043f\u0440\u0430 \u0434\u0440\u0443\u0433\u0456\u0445; \u0431\u0443\u0434\u0437\u0435\u043c \u043c\u0435\u0446\u044c \u0430\u0434\u043d\u043e \u0441\u044d\u0440\u0446\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445; \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0430\u0434\u0437\u0456\u043d \u0437\u0430 \u0430\u0434\u043d\u0430\u0433\u043e, \u0430 \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0430\u0431\u043b\u0435\u0433\u0447\u044b\u043c \u0441\u0430\u0431\u0435 \u045e\u0446\u0456\u0441\u043a \u0456 \u0441\u043c\u0443\u0442\u0430\u043a.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span style=\"color: #ff0000;\">\u0410\u0431\u043e:<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0440\u0430\u043a\u043e\u043d\u0441\u0443\u043b\u044c\u0441\u043a\u0456\u044f \u0430\u043a\u0442\u044b \u00ab\u041f\u0440\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u00bb&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Acta, 3-6: CSEL 3, 112-114)<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0431 \u0442\u0430\u043a\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0439 \u0440\u044d\u0447\u044b \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0434\u0443\u043c\u0430\u0446\u044c<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0420\u0430\u043d\u0456\u0446\u0430\u0439 14 \u0432\u0435\u0440\u0430\u0441\u043d\u044f \u0432\u044f\u043b\u0456\u0437\u043d\u044b \u043d\u0430\u0442\u043e\u045e\u043f \u043f\u0430 \u0437\u0430\u0433\u0430\u0434\u0437\u0435 \u0413\u0430\u043b\u0435\u0440\u044b\u044f \u041c\u0430\u043a\u0441\u0456\u043c\u0443\u0441\u0430, \u043f\u0440\u0430\u043a\u043e\u043d\u0441\u0443\u043b\u0430, \u0441\u0430\u0431\u0440\u0430\u045e\u0441\u044f \u043d\u0430 \u0421\u0456\u043a\u0441\u0442\u044b\u043d\u0441\u043a\u0456\u043c \u043f\u043e\u043b\u0456. \u0406 \u0442\u0430\u0434\u044b, \u0442\u043e\u0439 \u0436\u0430 \u043f\u0440\u0430\u043a\u043e\u043d\u0441\u0443\u043b, \u0413\u0430\u043b\u0435\u0440\u044b\u0439 \u041c\u0430\u043a\u0441\u0456\u043c\u0443\u0441, \u0441\u0435\u045e\u0448\u044b \u045e \u0437\u0430\u043b\u0435 \u043f\u0440\u0430\u0441\u043b\u0443\u0445\u043e\u045e\u0432\u0430\u043d\u043d\u044f\u045e, \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430. \u041a\u0430\u043b\u0456 \u0431\u0456\u0441\u043a\u0443\u043f \u041a\u0456\u043f\u0440\u044b\u044f\u043d \u0441\u0442\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0413\u0430\u043b\u0435\u0440\u044b\u0435\u043c, \u0442\u043e\u0439 \u0437\u0430\u043f\u044b\u0442\u0430\u045e\u0441\u044f: \u00ab\u0426\u0456 \u0442\u044b \u0422\u0430\u0446\u044b\u0439 \u041a\u0456\u043f\u0440\u044b\u044f\u043d?\u00bb \u0411\u0456\u0441\u043a\u0443\u043f \u041a\u0456\u043f\u0440\u044b\u044f\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u042f\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0440\u0430\u043a\u043e\u043d\u0441\u0443\u043b \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0413\u044d\u0442\u0430 \u0442\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0448 \u0441\u044f\u0431\u0435 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u0432\u044b\u0437\u043d\u0430\u044e\u0446\u044c \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u044b\u044f \u0432\u0443\u0447\u044d\u043d\u043d\u0456?\u00bb \u0411\u0456\u0441\u043a\u0443\u043f \u041a\u0456\u043f\u0440\u044b\u044f\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0422\u0430\u043a, \u044f\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0413\u0430\u043b\u0435\u0440\u044b\u0439 \u041c\u0430\u043a\u0441\u0456\u043c\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041d\u0430\u0439\u0434\u0430\u0441\u0442\u043e\u0439\u043d\u0435\u0439\u0448\u044b\u044f \u0456\u043c\u043f\u0435\u0440\u0430\u0442\u0430\u0440\u044b \u0437\u0430\u0433\u0430\u0434\u0430\u043b\u0456 \u0442\u0430\u0431\u0435 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u044b\u00bb. \u0411\u0456\u0441\u043a\u0443\u043f \u041a\u0456\u043f\u0440\u044b\u044f\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u042f \u043d\u0456\u043a\u043e\u043b\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0437\u0440\u0430\u0431\u043b\u044e\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0413\u0430\u043b\u0435\u0440\u044b\u0439 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041f\u0430\u0434\u0443\u043c\u0430\u0439 \u0434\u043e\u0431\u0440\u0430\u00bb. \u0411\u0456\u0441\u043a\u0443\u043f \u041a\u0456\u043f\u0440\u044b\u044f\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0420\u0430\u0431\u0456, \u0448\u0442\u043e \u0442\u0430\u0431\u0435 \u0437\u0430\u0433\u0430\u0434\u0430\u043b\u0456; \u0430\u0431 \u0442\u0430\u043a\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0434\u0443\u043c\u0430\u0446\u044c\u00bb.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u044f \u043d\u0430\u0440\u0430\u0434\u044b \u0437 \u0447\u043b\u0435\u043d\u0430\u043c\u0456 \u043a\u0430\u043b\u0435\u0433\u0456\u0456 \u0413\u0430\u043b\u0435\u0440\u044b\u0439 \u041c\u0430\u043a\u0441\u0456\u043c\u0443\u0441 \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0443\u0440\u044d\u0448\u0446\u0435 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u0446\u044c \u043f\u0440\u044b\u0441\u0443\u0434 \u0442\u0430\u043a\u0456\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: \u00ab\u0422\u044b \u045e\u0436\u043e \u0434\u043e\u045e\u0433\u0430 \u0436\u044b\u045e \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430 \u0456 \u043c\u043d\u043e\u0433\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u045e \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0442\u0432\u0430\u0451 \u0431\u0443\u043d\u0442\u0430\u0440\u0441\u043a\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435, \u0442\u044b \u0441\u0442\u0430\u045e \u0432\u043e\u0440\u0430\u0433\u0430\u043c \u0440\u044b\u043c\u0441\u043a\u0456\u0445 \u0431\u0430\u0433\u043e\u045e \u0456 \u0441\u0432\u044f\u0442\u044b\u0445 \u0437\u0430\u043a\u043e\u043d\u0430\u045e; \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u044f \u0456 \u0441\u0432\u044f\u0442\u044b\u044f \u0456\u043c\u043f\u0435\u0440\u0430\u0442\u0430\u0440\u044b \u0412\u0430\u043b\u0435\u0440\u044b\u044f\u043d \u0456 \u0413\u0430\u043b\u0456\u0435\u043d \u0410\u045e\u0433\u0443\u0441\u0442, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u044f\u043b\u044c\u043c\u043e\u0436\u043d\u044b \u0412\u0430\u043b\u0435\u0440\u044b\u044f\u043d, \u0456\u043c\u043f\u0435\u0440\u0430\u0442\u0430\u0440, \u043d\u0435 \u0437\u043c\u0430\u0433\u043b\u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u0446\u044c \u0446\u044f\u0431\u0435 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043a\u0443\u043b\u044c\u0442, \u044f\u043a\u0456 \u0441\u0430\u043c\u0456 \u0432\u044b\u0437\u043d\u0430\u044e\u0446\u044c. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u044b \u043f\u0440\u044b\u0437\u043d\u0430\u043d\u044b \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0430\u043c \u0456 \u043f\u0430\u0448\u044b\u0440\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0441\u0430\u043c\u044b\u0445 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430\u045e, \u0442\u043e \u0441\u0442\u0430\u043d\u0435\u0448 \u043f\u0435\u0440\u0430\u0441\u0446\u044f\u0440\u043e\u0433\u0430\u0439 \u0434\u043b\u044f \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0441\u043f\u0430\u043a\u0443\u0441\u0456\u045e \u0441\u0432\u0430\u0456\u043c\u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456: \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u043a\u0456 \u043f\u0430\u0440\u0430\u0434\u0430\u043a \u0431\u0443\u0434\u0437\u0435 \u045e\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u043a\u043e\u0448\u0442\u0430\u043c \u0442\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0456\u00bb. \u0421\u043a\u0430\u0437\u0430\u045e\u0448\u044b \u0433\u044d\u0442\u0430, \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u045e \u0437 \u0434\u0430\u0448\u0447\u044d\u0447\u043a\u0456 \u043f\u0440\u044b\u0441\u0443\u0434: \u00ab\u041f\u0430\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u044f\u0435\u043c, \u043a\u0430\u0431 \u0422\u0430\u0446\u044b\u044e \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0443 \u043c\u0435\u0447\u0430\u043c \u0430\u0434\u0441\u0435\u043a\u043b\u0456 \u0433\u0430\u043b\u0430\u0432\u0443\u00bb. \u0422\u0430\u0434\u044b \u0431\u0456\u0441\u043a\u0443\u043f \u041a\u0456\u043f\u0440\u044b\u044f\u043d \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0414\u0437\u044f\u043a\u0443\u044e \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0430\u0447\u0443\u045e\u0448\u044b \u043f\u0440\u044b\u0441\u0443\u0434, \u0440\u044d\u0448\u0442\u0430 \u0431\u0440\u0430\u0442\u043e\u045e \u043a\u0440\u044b\u0447\u0430\u043b\u0430: \u00ab\u0406 \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0436\u0430\u0434\u0430\u0435\u043c \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u00bb. \u0423\u0437\u043d\u0456\u043a\u043b\u0430 \u0437\u0430\u043c\u044f\u0448\u0430\u043d\u043d\u0435, \u0456 \u045e\u0432\u0435\u0441\u044c \u043d\u0430\u0442\u043e\u045e\u043f \u0432\u044b\u0440\u0443\u0448\u044b\u045e \u0437\u0430 \u0456\u043c. \u0422\u0430\u043a \u0432\u044b\u0432\u0435\u043b\u0456 \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430 \u043d\u0430 \u043f\u043e\u043b\u0435 \u0421\u0456\u043a\u0441\u0442\u0430. \u0422\u0430\u043c \u0451\u043d \u0441\u043a\u0456\u043d\u0443\u045e \u0437 \u0441\u044f\u0431\u0435 \u0432\u0435\u0440\u0445\u043d\u044e\u044e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443 \u0456, \u0441\u0442\u0430\u045e\u0448\u044b \u043d\u0430 \u043a\u0430\u043b\u0435\u043d\u0456, \u0433\u043e\u0440\u0430\u0447\u0430 \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430. \u0417\u0430\u0442\u044b\u043c \u0437\u043d\u044f\u045e \u0434\u0430\u043b\u043c\u0430\u0442\u044b\u043a\u0443 \u0456 \u0430\u0434\u0434\u0430\u045e \u0434\u044b\u044f\u043a\u0430\u043d\u0443, \u0430 \u0441\u0430\u043c \u0443 \u043b\u044c\u043d\u044f\u043d\u043e\u0439 \u0442\u0443\u043d\u0456\u0446\u044b \u0441\u0442\u0430\u044f\u045e \u0456 \u0447\u0430\u043a\u0430\u045e \u043a\u0430\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0442\u043e\u0439 \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u041a\u0456\u043f\u0440\u044b\u044f\u043d \u043f\u0430\u043f\u0440\u0430\u0441\u0456\u045e \u0431\u0440\u0430\u0442\u043e\u045e \u0434\u0430\u0446\u044c \u044f\u043c\u0443 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c \u043f\u044f\u0446\u044c \u0437\u0430\u043b\u0430\u0442\u044b\u0445 \u043c\u0430\u043d\u0435\u0442. \u0411\u0440\u0430\u0442\u044b \u0436 \u043f\u0430\u0441\u0446\u044f\u043b\u0456\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u043f\u0430\u043b\u043e\u0442\u043d\u044b \u0456 \u0445\u0443\u0441\u0442\u044b. \u0417\u0430\u0442\u044b\u043c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u041a\u0456\u043f\u0440\u044b\u044f\u043d \u0443\u043b\u0430\u0441\u043d\u0430\u0440\u0443\u0447\u043d\u0430 \u0437\u0430\u0432\u044f\u0437\u0430\u045e \u0441\u0430\u0431\u0435 \u0432\u043e\u0447\u044b. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u043c\u043e\u0433 \u0437\u0432\u044f\u0437\u0430\u0446\u044c \u0441\u0430\u0431\u0435 \u0440\u0443\u043a\u0456, \u0437\u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u0430\u0440 \u042e\u043b\u0456\u044f\u043d \u0456 \u0441\u0443\u0431\u0434\u044b\u044f\u043a\u0430\u043d, \u044f\u043a\u0456 \u043c\u0435\u045e \u0442\u0430\u043a\u043e\u0435 \u0436 \u0456\u043c\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043a \u043f\u0440\u044b\u043d\u044f\u045e \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u043a\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u041a\u0456\u043f\u0440\u044b\u044f\u043d. \u0426\u0435\u043b\u0430 \u044f\u0433\u043e \u0431\u044b\u043b\u043e \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u0430 \u043d\u0435\u043f\u0430\u0434\u0430\u043b\u0451\u043a, \u043a\u0430\u0431 \u0437\u0430\u0434\u0430\u0432\u043e\u043b\u0456\u0446\u044c \u0446\u0456\u043a\u0430\u045e\u043d\u0430\u0441\u0446\u044c \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e. \u0410\u0434\u0442\u0443\u043b\u044c \u0437\u0430\u0431\u0440\u0430\u043b\u0456 \u044f\u0433\u043e \u043d\u043e\u0447\u0447\u0443 \u0456 \u043f\u0440\u044b \u0441\u0432\u044f\u0442\u043b\u0435 \u0441\u0432\u0435\u0447\u0430\u043a \u0456 \u043f\u0430\u0445\u043e\u0434\u043d\u044f\u045e \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u043b\u0456 \u044f\u0433\u043e \u0432\u0435\u043b\u044c\u043c\u0456 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430 \u0432\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0456 \u043f\u0440\u0430\u043a\u0443\u0440\u0430\u0442\u0430\u0440\u0430 \u041c\u0430\u043a\u0440\u043e\u0431\u0456\u044f \u041a\u0430\u043d\u0434\u0437\u0456\u0434\u044b \u043b\u044f \u041c\u0430\u043f\u0430\u043b\u0456\u0439\u0441\u043a\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0456, \u043d\u0435\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0441\u0430\u0434\u0436\u0430\u043b\u0430\u043a. \u041f\u0440\u0430\u0437 \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456 \u0434\u0437\u0451\u043d \u043f\u0430\u043c\u0451\u0440 \u043f\u0440\u0430\u043a\u043e\u043d\u0441\u0443\u043b \u0413\u0430\u043b\u0435\u0440\u044b\u0439 \u041c\u0430\u043a\u0441\u0456\u043c\u0443\u0441<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0421\u0432\u044f\u0442\u044b \u043c\u0443\u0447\u0430\u043d\u0456\u043a \u041a\u0456\u043f\u0440\u044b\u044f\u043d \u043f\u0430\u043c\u0451\u0440 14 \u0432\u0435\u0440\u0430\u0441\u043d\u044f \u043f\u0440\u044b \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0456 \u0456\u043c\u043f\u0435\u0440\u0430\u0442\u0430\u0440\u0430\u045e \u0412\u0430\u043b\u0435\u0440\u044b\u044f\u043d\u0430 \u0456 \u0413\u0430\u043b\u0456\u0435\u043d\u0430, \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u045e \u041f\u0430\u043d \u043d\u0430\u0448, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u043e\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u0456 \u043f\u0430\u0448\u0430\u043d\u0430 \u043d\u0430\u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439&nbsp;&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041a\u0430\u043b\u0456 \u043c\u044b \u0437\u043c\u0430\u0433\u0430\u0435\u043c\u0441\u044f \u0437\u0430 \u0432\u0435\u0440\u0443, \u043d\u0430 \u043d\u0430\u0441 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u0411\u043e\u0433, \u0433\u043b\u044f\u0434\u0437\u044f\u0446\u044c \u0430\u043d\u0451\u043b\u044b, \u0456 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441. <\/span><span style=\"color: #ff00ff;\">*<\/span><span> \u0413\u044d\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u0456 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043a\u0430\u0440\u043e\u043d\u0443 \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430 \u0421\u0443\u0434\u0434\u0437\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423\u0437\u0431\u0440\u043e\u0456\u043c\u0441\u044f \u0432\u0430 \u045e\u0441\u0435 \u043d\u0430\u0448\u044b\u044f \u0441\u0456\u043b\u044b, \u0443 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0441\u044d\u0440\u0446\u0430, \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0443\u044e \u0432\u0435\u0440\u0443 \u0456 \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u043a\u0430\u0431 \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0456\u0446\u044c \u0434\u0430 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0413\u044d\u0442\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"770","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u0423\u0437\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u0434\u0443\u043c\u0430\u043a \u0434\u0430 \u0411\u043e\u0433\u0430\u00bb \u0441\u0432. \u0420\u043e\u0431\u044d\u0440\u0442\u0430 \u0411\u044d\u043b\u044f\u0440\u043c\u0456\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Grad. 1: Opera omnia 6, edit. 1862, 214)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u0445\u0456\u043b\u0456 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0434\u0430 \u0422\u0432\u0430\u0456\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u00ab\u0422\u044b, \u041f\u0430\u043d\u0435, \u0434\u043e\u0431\u0440\u044b \u0456 \u0432\u044b\u0431\u0430\u0447\u043b\u0456\u0432\u044b, \u0448\u043c\u0430\u0442\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u044b \u0434\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0426\u044f\u0431\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435\u00bb (\u041f\u0441 86 [85], 5). \u0425\u0442\u043e \u0436 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0422\u0430\u0431\u0435 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u043a\u0430\u043b\u0456 \u0431 \u0445\u043e\u0446\u044c \u043a\u0440\u044b\u0445\u0443 \u043d\u0435 \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u045e \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u0422\u0432\u0430\u0451\u0439 \u0431\u0430\u0446\u044c\u043a\u043e\u045e\u0441\u043a\u0430\u0439 \u0443\u043b\u0430\u0434\u044b? \u0428\u0442\u043e \u0436 \u0422\u044b \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435\u0448, \u041f\u0430\u043d\u0435, \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0433\u0430\u043c? \u00ab\u0412\u0430\u0437\u044c\u043c\u0456\u0446\u0435, \u2013 \u043a\u0430\u0436\u0430\u0448, \u2013 \u044f\u0440\u043c\u043e \u041c\u0430\u0451 \u043d\u0430 \u0441\u044f\u0431\u0435\u00bb (\u041c\u0446 11, 29). \u042f\u043a\u043e\u0435 \u0436 \u0422\u0432\u0430\u0451 \u044f\u0440\u043c\u043e? \u00ab\u042f\u0440\u043c\u043e \u041c\u0430\u0451, \u2013 \u043a\u0430\u0436\u0430\u0448, \u2013 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435, \u0456 \u0446\u044f\u0436\u0430\u0440 \u041c\u043e\u0439 \u043b\u0451\u0433\u043a\u0456\u00bb (\u041c\u0446 11, 30). \u0425\u0442\u043e \u0436 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0431\u044b \u043c\u0435\u0446\u044c \u044f\u0440\u043c\u0430, \u044f\u043a\u043e\u0435 \u043d\u0435 \u0430\u0434\u0431\u0456\u0440\u0430\u0435 \u0441\u0456\u043b\u044b, \u0430\u043b\u0435 \u0434\u0430\u0435 \u0431\u0430\u0434\u0437\u0451\u0440\u0430\u0441\u0446\u044c, \u043d\u0435 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0435, \u0430\u043b\u0435 \u043f\u0430\u0434\u044b\u043c\u0430\u0435? \u0422\u0430\u043c\u0443 \u0422\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0434\u0430\u0434\u0430\u045e: \u00ab\u0417\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u0441\u043f\u0430\u043a\u043e\u0439 \u0434\u043b\u044f \u0441\u0432\u0430\u0456\u0445 \u0434\u0443\u0448\u0430\u045e\u00bb (\u041c\u0446 11, 29). \u0428\u0442\u043e \u0436 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u044b\u043c \u044f\u0440\u043c\u043e\u043c, \u044f\u043a\u043e\u0435 \u043d\u0435 \u0441\u0442\u0430\u043c\u043b\u044f\u0435, \u0430\u043b\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u043f\u0430\u043a\u043e\u0439? \u0417\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0456\u043c \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0433\u044d\u0442\u0430\u044f \u043f\u0435\u0440\u0448\u0430\u044f \u0456 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c: \u00ab\u041b\u044e\u0431\u0456 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0442\u0432\u0430\u0456\u043c\u00bb (\u041c\u0446 22, 37). \u0428\u0442\u043e \u0436 \u0431\u043e\u043b\u044c\u0448 \u043b\u0451\u0433\u043a\u0430\u0435, \u0431\u043e\u043b\u044c\u0448 \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u0435 \u0456 \u0431\u043e\u043b\u044c\u0448 \u043b\u044e\u0431\u0430\u0435 \u0437\u0430 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u043d\u0435 \u0434\u0430\u0431\u0440\u044b\u043d\u0456, \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u0456 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456? \u0423\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0448\u0441\u044f \u0422\u044b, \u041f\u0430\u043d\u0435, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435; \u0432\u043e\u0441\u044c \u0422\u044b \u0430\u0431\u044f\u0446\u0430\u0435\u0448 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u044f \u0437\u0430 \u043d\u0430\u0439\u0447\u044b\u0441\u0446\u0435\u0439\u0448\u0430\u0435 \u0437\u043e\u043b\u0430\u0442\u0430, \u0441\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u044b\u044f \u0437\u0430 \u043c\u0451\u0434 \u0441\u043e\u0442\u0430\u0432\u044b. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0430\u0431\u044f\u0446\u0430\u0435\u0448 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443, \u0456 \u043f\u0440\u044b \u0433\u044d\u0442\u044b\u043c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0443\u044e, \u044f\u043a \u043a\u0430\u0436\u0430 \u0422\u0432\u043e\u0439 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u042f\u043a\u0443\u0431: \u00ab\u0412\u044f\u043d\u0435\u0446 \u0436\u044b\u0446\u0446\u044f \u0411\u043e\u0433 \u0430\u0431\u044f\u0446\u0430\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e\u00bb (\u043f\u0430\u0440. \u042f\u043a 1, 12). \u0427\u044b\u043c \u0436\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u044b \u0432\u044f\u043d\u0435\u0446 \u0436\u044b\u0446\u0446\u044f? \u0421\u0432. \u041f\u0430\u0432\u0435\u043b \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0406\u0441\u0430\u0456: \u00ab\u0427\u0430\u0433\u043e \u0432\u043e\u043a\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430, \u0456 \u0432\u0443\u0445\u0430 \u043d\u0435 \u0447\u0443\u043b\u0430, \u0456 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0441\u044d\u0440\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0442\u043e\u0435 \u0411\u043e\u0433 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e\u00bb (1 \u041a\u0430\u0440 2, 9; \u043f\u0430\u0440. \u0406\u0441 64, 1-3; 65, 17).<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456. \u0406 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430\u044f \u043f\u0435\u0440\u0448\u0430\u044f \u0456 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u044f\u043a\u0456 \u0441\u043b\u0443\u0445\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u043d\u0448\u044b\u044f \u0411\u043e\u0436\u044b\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u044e\u0446\u044c \u0442\u0430\u043a\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0444\u0430\u0440\u043c\u0456\u0440\u0443\u044e\u0446\u044c, \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c, \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u044e\u0446\u044c \u0456, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u0440\u043e\u0431\u044f\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0456 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0442\u044b \u0440\u0430\u0437\u0443\u043c\u043d\u044b, \u043f\u0430\u043c\u044f\u0442\u0430\u0439, \u0448\u0442\u043e \u0442\u044b \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0436\u0430\u0439 \u0445\u0432\u0430\u043b\u044b \u0456 \u0434\u043b\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0413\u044d\u0442\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0432\u0430\u044f \u043c\u044d\u0442\u0430, \u0433\u044d\u0442\u0430 \u0430\u0441\u044f\u0440\u043e\u0434\u0430\u043a \u0442\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b, \u0433\u044d\u0442\u0430 \u0441\u043a\u0430\u0440\u0431 \u0442\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430. \u041a\u0430\u043b\u0456 \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u0448 \u0433\u044d\u0442\u0430\u0439 \u043c\u044d\u0442\u044b, \u0431\u0443\u0434\u0437\u0435\u0448 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b, \u043a\u0430\u043b\u0456 \u0430\u0434\u044b\u0434\u0437\u0435\u0448 \u0430\u0434 \u044f\u0435, \u0431\u0443\u0434\u0437\u0435\u0448 \u043d\u0435\u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0434\u0430\u0431\u0440\u043e\u043c \u043b\u0456\u0447\u044b \u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u044f\u0434\u0437\u0435 \u0446\u044f\u0431\u0435 \u0434\u0430 \u043c\u044d\u0442\u044b, \u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0437\u043b\u043e\u043c, \u0448\u0442\u043e \u0430\u0434\u0434\u0430\u043b\u044f\u0435 \u0446\u044f\u0431\u0435 \u0430\u0434 \u044f\u0435. \u041c\u0443\u0434\u0440\u044b \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0435 \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442\u0443 \u0446\u0456 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f, \u0431\u0430\u0433\u0430\u0446\u0446\u044f \u0446\u0456 \u0431\u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u0437\u0434\u0430\u0440\u043e\u045e\u044f \u0446\u0456 \u0445\u0432\u0430\u0440\u043e\u0431\u044b, \u0433\u043e\u043d\u0430\u0440\u0443 \u0446\u0456 \u0437\u043d\u044f\u0432\u0430\u0433\u0456, \u0436\u044b\u0446\u0446\u044f \u0446\u0456 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0437\u0435\u043b\u044f \u0456\u0445 \u0441\u0430\u043c\u0456\u0445, \u0456 \u043d\u0435 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0435 \u0456\u0445 \u0434\u0437\u0435\u043b\u044f \u0456\u0445 \u0441\u0430\u043c\u0456\u0445. \u041a\u0430\u043b\u0456 \u044f\u043d\u044b \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u0411\u043e\u0436\u0430\u0439 \u0445\u0432\u0430\u043b\u0435 \u0456 \u0442\u0432\u0430\u0439\u043c\u0443 \u0432\u0435\u0447\u043d\u0430\u043c\u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044e, \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0434\u043e\u0431\u0440\u044b\u043c\u0456, \u0456 \u0442\u0440\u044d\u0431\u0430 \u0456\u0445 \u0436\u0430\u0434\u0430\u0446\u044c. \u041a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u044e\u0446\u044c, \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0437\u043b\u043e\u043c, \u0456 \u0442\u0440\u044d\u0431\u0430 \u0456\u0445 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0446\u044c.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0430\u043b 2, 7; \u0426\u0456\u0442 1, 7\u0430. 9b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u0443\u0441\u043d\u044b \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0432\u0435\u0434\u0430\u045e, \u0456 \u0442\u0430\u0434\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0448\u0443\u043a\u0430\u0446\u044c \u0443 \u044f\u0433\u043e \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u045e,<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0431\u043e \u0451\u043d \u0432\u0435\u0441\u043d\u0456\u043a \u041f\u0430\u043d\u0430 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u0456\u0441\u043a\u0443\u043f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b, \u043a\u0430\u0431 \u043c\u043e\u0433 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0446\u044c \u0443 \u0437\u0434\u0430\u0440\u043e\u0432\u044b\u043c \u0432\u0443\u0447\u044d\u043d\u043d\u0456. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e \u0451\u043d.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"771","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0423\u0440\u044b\u0432\u0430\u043a \u00ab\u0413\u0430\u0434\u0430\u0432\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u0430\u0437\u0434\u0430\u0447\u044b \u043f\u0440\u0430 \u0441\u0442\u0430\u043d \u043a\u0430\u043b\u0435\u0433\u0456\u0443\u043c\u0430 \u045e \u0412\u0435\u043d\u0435\u00bb<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Archiv. S. I., Epist. Germaniae, 140 nn. 1975)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0414\u043d\u0451\u043c \u0456 \u043d\u043e\u0447\u0447\u0443 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e \u043f\u0440\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0456 \u0422\u0430\u0432\u0430\u0440\u044b\u0441\u0442\u0432\u0430 \u0415\u0437\u0443\u0441\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u0437\u0456\u043d \u043c\u0430\u043b\u0430\u0434\u044b \u043f\u0430\u043b\u044f\u043a \u0441\u0430 \u0448\u043b\u044f\u0445\u0435\u0446\u0430\u0433\u0430 \u0440\u043e\u0434\u0443, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0448\u043b\u044f\u0445\u0435\u0442\u043d\u044b \u0446\u043d\u043e\u0442\u0430\u044e, \u0431\u044b\u045e \u0443 \u043d\u0430\u0441 \u0443 \u0412\u0435\u043d\u0435 \u0434\u0432\u0430 \u0433\u0430\u0434\u044b \u0456 \u043d\u0430\u0441\u0442\u043e\u0439\u0432\u0430\u045e, \u043a\u0430\u0431 \u044f\u0433\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u045e \u0437\u0430\u043a\u043e\u043d. \u0410\u0434\u043d\u0430\u043a \u044f\u043c\u0443 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u043b\u0456; \u043d\u0435\u043b\u044c\u0433\u0430 \u0431\u044b\u043b\u043e \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u044f\u0433\u043e \u0431\u0435\u0437 \u0437\u0433\u043e\u0434\u044b \u0431\u0430\u0446\u044c\u043a\u043e\u045e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0451\u043d \u0431\u044b\u045e \u043d\u0430\u0448\u044b\u043c \u043a\u0430\u043d\u0432\u0456\u043a\u0442\u0430\u0440\u0430\u043c \u0456 \u0432\u0443\u0447\u043d\u0435\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u043a\u0430\u043b\u0435\u0433\u0456\u0443\u043c\u0430. \u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e \u0437\u2019\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u0456 \u0456\u043d\u0448\u044b\u044f \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0430\u0434\u043c\u043e\u0432\u044b. \u041d\u0435 \u043c\u0430\u044e\u0447\u044b \u043d\u0430\u0434\u0437\u0435\u0456 \u043d\u0430 \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0456\u0445 \u043c\u0430\u0440\u0430\u045e, \u0451\u043d \u043f\u0440\u0430\u0437 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b \u0447\u0430\u0441 \u0432\u044b\u0440\u0443\u0448\u044b\u045e \u0443 \u043d\u0435\u0432\u044f\u0434\u043e\u043c\u044b\u043c \u043d\u0430\u043f\u0440\u0430\u043c\u043a\u0443, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u0434\u0430\u043c\u0430\u0433\u0447\u044b\u0441\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u0437\u0435\u0441\u044c\u0446\u0456 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0401\u043d \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u0456 \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456; \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0431\u044b\u045e \u0434\u0430\u0440\u0430\u0433\u0456\u043c, \u043d\u0456\u043a\u043e\u043c\u0443 \u043d\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u043f\u0440\u044b\u043a\u0440\u0430\u0441\u0446\u0456, \u043c\u0430\u043b\u0430\u0434\u044b, \u0430\u043b\u0435 \u0434\u0430\u0440\u043e\u0441\u043b\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0451\u0439 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043c\u0430\u043b\u044b \u0440\u043e\u0441\u0442\u0430\u043c, \u0430\u043b\u0435 \u0432\u044f\u043b\u0456\u043a\u0456 \u0434\u0443\u0445\u0430\u043c. \u0428\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u045e \u0443 \u0441\u0432. \u0406\u043c\u0448\u044b, \u0447\u0430\u0441\u0446\u0435\u0439 \u0437\u0430 \u045e\u0441\u0456\u0445 \u0441\u043f\u0430\u0432\u044f\u0434\u0430\u045e\u0441\u044f \u0456 \u043f\u0440\u044b\u043c\u0430\u045e \u0441\u0432. \u041a\u0430\u043c\u0443\u043d\u0456\u044e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043e\u045e\u0433\u0430 \u043c\u0430\u043b\u0456\u045e\u0441\u044f. \u0412\u044b\u0432\u0443\u0447\u0430\u045e \u0440\u044b\u0442\u043e\u0440\u044b\u043a\u0443 \u0456 \u045e \u0432\u0443\u0447\u043e\u0431\u0435 \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u0430 \u0431\u044b\u045e \u043d\u0430\u0440\u043e\u045e\u043d\u0456 \u0437 \u0456\u043d\u0448\u044b\u043c\u0456, \u0430\u043b\u0435 \u0456 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u0434\u0430 \u043d\u044f\u0434\u0430\u045e\u043d\u044f\u0433\u0430 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0443\u0441\u0456\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0437\u0435\u043d\u044c \u0456 \u043d\u043e\u0447 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u045e \u043f\u0440\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0456 \u043f\u0440\u0430 \u0422\u0430\u0432\u0430\u0440\u044b\u0441\u0442\u0432\u0430 \u0415\u0437\u0443\u0441\u0430. \u0421\u0430 \u0441\u043b\u044f\u0437\u044c\u043c\u0456 \u043f\u0440\u0430\u0441\u0456\u045e \u043d\u0430\u0441\u0442\u0430\u044f\u0446\u0435\u043b\u044f\u045e \u0430\u0431 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u0456, \u043f\u0456\u0441\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043b\u0456\u0441\u0442\u044b \u0434\u0430 \u043f\u0430\u043f\u0441\u043a\u0430\u0433\u0430 \u043b\u0435\u0433\u0430\u0442\u0430, \u043a\u0430\u0431 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u045e \u0443 \u0433\u044d\u0442\u044b\u043c \u043d\u0430\u0448\u044b\u0445. \u0410\u043b\u0435 \u045e\u0441\u0451 \u0431\u044b\u043b\u043e \u0434\u0430\u0440\u044d\u043c\u043d\u0430. \u0422\u0430\u043c\u0443 \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u0432\u043e\u043b\u0456 \u0431\u0430\u0446\u044c\u043a\u043e\u045e, \u0431\u0440\u0430\u0442\u043e\u045e, \u0437\u043d\u0430\u0451\u043c\u044b\u0445 \u0456 \u0441\u0432\u0430\u044f\u043a\u043e\u045e \u0443 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0456 \u043d\u0430 \u0456\u043d\u0448\u0430\u0439 \u0434\u0430\u0440\u043e\u0437\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u0434\u043e\u0441\u0442\u0443\u043f\u0443 \u0434\u0430 \u0422\u0430\u0432\u0430\u0440\u044b\u0441\u0442\u0432\u0430 \u0415\u0437\u0443\u0441\u0430. \u0410 \u043a\u0430\u043b\u0456 \u0456 \u0433\u044d\u0442\u0430 \u044f\u043c\u0443 \u043d\u0435 \u045e\u0434\u0430\u043b\u043e\u0441\u044f, \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0443\u0441\u0451 \u0436\u044b\u0446\u0446\u0451 \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0430\u0432\u0430\u0446\u044c, \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043d\u044b \u0456 \u045e\u0431\u043e\u0433\u0456, \u0434\u0437\u0435\u043b\u044f \u043b\u044e\u0431\u043e\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u043d\u0430\u0448\u044b\u044f, \u043a\u0430\u043b\u0456 \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f \u043f\u0440\u0430 \u044f\u0433\u043e \u0437\u0430\u0434\u0443\u043c\u044b, \u043f\u0430\u0447\u0430\u043b\u0456 \u044f\u0433\u043e \u0430\u0434\u0433\u0430\u0432\u043e\u0440\u0432\u0430\u0446\u044c \u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043b\u0456 \u0432\u044b\u0440\u0443\u0448\u044b\u0446\u044c \u0443 \u0434\u0430\u0440\u043e\u0433\u0443 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0431\u0440\u0430\u0442\u0430\u043c, \u044f\u043a\u0456 \u045e \u0445\u0443\u0442\u043a\u0456\u043c \u0447\u0430\u0441\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u043d\u0430 \u0440\u0430\u0434\u0437\u0456\u043c\u0443. \u0417\u0430\u043f\u044d\u045e\u043d\u0456\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u0431\u0430\u0446\u044c\u043a\u0456 \u0437\u0433\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u043d\u0430 \u044f\u0433\u043e \u043f\u043b\u0430\u043d\u044b, \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u044f\u0433\u043e \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u0430\u0441\u0446\u044c. \u0401\u043d \u0436\u0430 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u045e \u0430\u0434\u0432\u0430\u0440\u043e\u0442\u043d\u0430\u0435, \u0448\u0442\u043e \u043b\u0435\u043f\u0448 \u0437\u0430 \u0456\u043d\u0448\u044b\u0445 \u0432\u0435\u0434\u0430\u0435 \u0441\u0432\u0430\u0456\u0445 \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u0456 \u0448\u0442\u043e \u043d\u0435 \u0432\u0430\u0440\u0442\u0430 \u0447\u0430\u043a\u0430\u0446\u044c \u0430\u0434 \u0456\u0445 \u0433\u044d\u0442\u0430\u0433\u0430, \u0442\u0430\u043c\u0443 \u043b\u0456\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0431\u044f\u0446\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043d\u0456\u0432\u043e\u0434\u0437\u0456\u043d \u0432\u044b\u0445\u0430\u0432\u0430\u045e\u0446\u0430, \u043d\u0456 \u0441\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a \u043d\u0435 \u0437\u043c\u0430\u0433\u043b\u0456 \u0430\u0434\u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u044f\u0433\u043e \u0430\u0434 \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u0433\u0430 \u0440\u0430\u0448\u044d\u043d\u043d\u044f, \u0443 \u0430\u0434\u043d\u0443 \u0440\u0430\u043d\u0456\u0446\u0443, \u043f\u0430\u0441\u043b\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u044f \u0441\u0432. \u041a\u0430\u043c\u0443\u043d\u0456\u0456, \u0451\u043d \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0412\u0435\u043d\u0443 \u0431\u0435\u0437 \u0432\u0435\u0434\u0430\u043c\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u043f\u0435\u043a\u0443\u043d\u0430 \u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0431\u0440\u0430\u0442\u0430. \u0412\u044b\u0440\u0430\u043a\u0441\u044f \u0434\u0430\u0432\u043e\u043b\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0447\u0430\u0441\u0442\u043a\u0456 \u0441\u0432\u0430\u0451\u0439 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b, \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0430\u0434\u0437\u0435\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043c\u0435\u045e \u0434\u043e\u043c\u0430 \u0456 \u045e \u0448\u043a\u043e\u043b\u0435, \u0456, \u0430\u043f\u0440\u0430\u043d\u0443\u045e\u0448\u044b \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0443\u044e \u043f\u0430\u043b\u0430\u0442\u043d\u044f\u043d\u0443\u044e \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443, \u0437 \u043a\u0456\u0435\u043c \u0443 \u0440\u0443\u043a\u0430\u0445 \u0432\u044b\u0440\u0443\u0448\u044b\u045e \u0443 \u0434\u0430\u0440\u043e\u0433\u0443 \u044f\u043a \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b \u043f\u0440\u043e\u0441\u0442\u044b \u0431\u044f\u0434\u043d\u044f\u043a. \u0422\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0437 \u0456\u043c \u0434\u0430\u043b\u0435\u0439, \u0430\u0434\u043d\u0430\u043a \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043d\u0435 \u0431\u0435\u0437 \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u044f. \u0401\u043d \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u045e \u0432\u0435\u0440\u043d\u044b \u0441\u0432\u0430\u0456\u043c \u0440\u0430\u0448\u044d\u043d\u043d\u044f\u043c, \u0442\u0430\u043c\u0443 \u043d\u0430\u043c \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u0451\u043d \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u045e \u043f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u043b\u0430\u0441\u043a\u0456, \u0430 \u043d\u0435 \u0437 \u044f\u043a\u043e\u0439-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0445\u043b\u0430\u043f\u0435\u0447\u0430\u0439 \u0432\u044b\u0433\u0430\u0434\u044b.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. 1 \u041a\u0430\u0440 7, 29. 30. 31; 2, 12\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0427\u0430\u0441 \u043a\u0430\u0440\u043e\u0442\u043a\u0456, \u0442\u0430\u043c\u0443 \u0442\u044b\u044f, \u0445\u0442\u043e \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430; \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u0435\u0442\u0430\u043c, \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430, <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0431\u043e \u043c\u0456\u043d\u0430\u0435 \u0432\u043e\u0431\u0440\u0430\u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u041c\u044b \u0436 \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043d\u0435 \u0434\u0443\u0445\u0430 \u0441\u0432\u0435\u0442\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u043c\u0456\u043d\u0430\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"772","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 340, 1: PL 38, 1483-1484)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0414\u043b\u044f \u0432\u0430\u0441 \u044f \u2013 \u0431\u0456\u0441\u043a\u0443\u043f, \u0437 \u0432\u0430\u043c\u0456 \u2013 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443, \u043a\u0430\u043b\u0456 \u043d\u0430 \u043c\u0430\u0435 \u043f\u043b\u0435\u0447\u044b \u043b\u0451\u0433 \u0446\u044f\u0436\u0430\u0440, \u0437 \u044f\u043a\u043e\u0433\u0430 \u0442\u0440\u044d\u0431\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u044f\u043b\u0451\u0433\u043a\u0456 \u0440\u0430\u0445\u0443\u043d\u0430\u043a, \u043c\u044f\u043d\u0435 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u043a\u043b\u043e\u043f\u0430\u0442 \u0430\u0431 \u0433\u043e\u0434\u043d\u044b\u043c \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0443. \u0427\u0430\u0433\u043e \u0436 \u044f \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0431\u0430\u044e\u0441\u044f \u043f\u0440\u044b \u044f\u0433\u043e \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0456? \u041a\u0430\u0431 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430\u0435, \u043d\u0435 \u0432\u0430\u0431\u0456\u043b\u0430 \u043c\u044f\u043d\u0435 \u045e \u0456\u043c \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u043b\u044f \u0432\u0430\u0441 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u044b\u043c. \u0425\u043e\u0446\u044c \u0437 \u0430\u0434\u043d\u0430\u0433\u043e \u0431\u043e\u043a\u0443 \u043f\u0430\u043b\u043e\u0445\u0430\u0435 \u043c\u044f\u043d\u0435 \u0442\u043e\u0435, \u0445\u0442\u043e \u044f \u0434\u043b\u044f \u0432\u0430\u0441, \u0437 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0441\u0443\u0446\u044f\u0448\u0430\u0435 \u043c\u044f\u043d\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u044f \u0437 \u0432\u0430\u043c\u0456. \u0414\u043b\u044f \u0432\u0430\u0441 \u044f \u2013 \u0431\u0456\u0441\u043a\u0443\u043f, \u0437 \u0432\u0430\u043c\u0456 \u2013 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d. \u0422\u043e\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0437\u0432\u0430\u0439 \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u0433\u0430 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0443, \u0430 \u0433\u044d\u0442\u0430\u0435 \u2013 \u0456\u043c\u0435\u043c \u043b\u0430\u0441\u043a\u0456; \u0442\u043e\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0443, \u0433\u044d\u0442\u0430\u0435, \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u2013 \u0440\u0430\u0442\u0443\u043d\u0430\u043a. \u0421\u0446\u0456\u0441\u043b\u0430 \u043a\u0430\u0436\u0443\u0447\u044b, \u043d\u0430\u0441 \u043d\u0456\u0431\u044b \u043a\u0456\u0434\u0430\u0435 \u0431\u0443\u0440\u0430 \u043d\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u043c\u043e\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u0439 \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456. \u041a\u0430\u043b\u0456 \u0436 \u043c\u044b \u045e\u0441\u0432\u044f\u0434\u043e\u043c\u0456\u043c \u0441\u0430\u0431\u0435, \u0447\u044b\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u043c\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u044f, \u043c\u044b \u043d\u0456\u0431\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u043c \u0443 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b \u043f\u043e\u0440\u0442 \u043f\u0430\u0434 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0443\u0446\u044f\u0448\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f. \u0406 \u0445\u043e\u0446\u044c \u043c\u044b \u0441\u0442\u043e\u043c\u043b\u0435\u043d\u044b\u044f \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u043c, \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0435\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u0432\u0430\u043c\u0456. \u041a\u0430\u043b\u0456 \u0436 \u0430\u0434\u0447\u0443\u0432\u0430\u044e \u0441\u044f\u0431\u0435 \u0431\u043e\u043b\u044c\u0448 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c \u043f\u0430 \u0442\u043e\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u0435, \u0448\u0442\u043e \u044f \u0431\u044b\u045e \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0430\u043c\u0456, \u0447\u044b\u043c \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0431\u044b\u045e \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b \u0434\u043b\u044f \u0432\u0430\u0441, \u0442\u0430\u0434\u044b, \u2013 \u044f\u043a \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u041f\u0430\u043d, \u2013 \u044f \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430\u0433\u043d\u0443 \u0431\u044b\u0446\u044c \u0432\u0430\u0448\u044b\u043c \u0441\u043b\u0443\u0433\u043e\u044e, \u043a\u0430\u0431 \u0432\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u0430 \u043d\u0435 \u0431\u044b\u0446\u044c \u043d\u044f\u045e\u0434\u0437\u044f\u0447\u043d\u044b\u043c, \u044f\u043a\u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043f\u043b\u0430\u0442\u044b, \u044f\u043a\u0430\u044f \u0437\u0440\u0430\u0431\u0456\u043b\u0430 \u043c\u044f\u043d\u0435 \u0441\u043b\u0443\u0433\u043e\u044e \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0430\u043c\u0456. \u0422\u0430\u043c\u0443 \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043b\u044e\u0431\u0456\u0446\u044c \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u044e \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u044b, \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u044f \u0434\u0430 \u041f\u044f\u0442\u0440\u0430: \u00ab\u0426\u0456 \u043b\u044e\u0431\u0456\u0448 \u0442\u044b \u041c\u044f\u043d\u0435? \u041f\u0430\u0441\u0456 \u0430\u0432\u0435\u0447\u0430\u043a \u041c\u0430\u0456\u0445\u00bb (\u042f\u043d 21, 17). \u0421\u043a\u0430\u0437\u0430\u045e \u0433\u044d\u0442\u0430 \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437, \u0434\u0440\u0443\u0433\u0456 \u0456 \u0442\u0440\u044d\u0446\u0456. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f \u043f\u0440\u0430 \u043b\u044e\u0431\u043e\u045e, \u0437\u0430\u0442\u044b\u043c \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u0437\u0430\u0434\u0430\u043d\u043d\u0435, \u0431\u043e \u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u045e, \u0442\u0430\u043c \u043c\u0435\u043d\u0448\u044b \u0446\u044f\u0436\u0430\u0440.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0427\u044b\u043c \u0430\u0434\u0434\u0437\u044f\u0447\u0443 \u044f \u041f\u0430\u043d\u0443 \u0437\u0430 \u045e\u0441\u0435 \u042f\u0433\u043e \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u0434\u043b\u044f \u043c\u044f\u043d\u0435?\u00bb (\u041f\u0441 116&nbsp;[115], 12). \u041a\u0430\u043b\u0456 \u0441\u043a\u0430\u0436\u0443, \u0448\u0442\u043e \u0430\u0434\u0434\u0437\u044f\u0447\u0432\u0430\u044e, \u0431\u043e \u043f\u0430\u0441\u0443 \u042f\u0433\u043e \u0430\u0432\u0435\u0447\u0430\u043a, \u0442\u043e \u0456 \u0442\u0430\u043a \u00ab\u043d\u0435 \u044f, \u0430 \u043b\u0430\u0441\u043a\u0430 \u0411\u043e\u0436\u0430\u044f, \u0448\u0442\u043e \u0441\u0430 \u043c\u043d\u043e\u044e\u00bb (1 \u041a\u0430\u0440 15, 10). \u042f\u043a \u0436\u0430 \u044f \u043c\u0430\u0433\u0443 \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c, \u043a\u0430\u043b\u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0435? \u0410\u0434\u043d\u0430\u043a, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043b\u044e\u0431\u0456\u043c \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043b\u0456\u0432\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0441\u0432\u0456\u043c \u0430\u0432\u0435\u0447\u0430\u043a, \u0447\u0430\u043a\u0430\u0435\u043c \u043f\u043b\u0430\u0442\u044b. \u042f\u043a \u0433\u044d\u0442\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430? \u042f\u043a \u0441\u043f\u0430\u043b\u0443\u0447\u044b\u0446\u044c \u0433\u044d\u0442\u044b\u044f \u0434\u0437\u0432\u0435 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u0456? \u041b\u044e\u0431\u043b\u044e \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043b\u0456\u0432\u0430, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0431\u044b\u0446\u044c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c, \u0456 \u0447\u0430\u043a\u0430\u044e \u043f\u043b\u0430\u0442\u044b, \u0431\u043e \u044f \u2013 \u043f\u0430\u0441\u0442\u044b\u0440. \u0413\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0431 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u044b\u043c \u0456 \u043d\u0435\u043b\u044c\u0433\u0430 \u0431\u044b\u043b\u043e \u0431 \u0447\u0430\u043a\u0430\u0446\u044c \u043f\u043b\u0430\u0442\u044b \u0430\u0434 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043b\u044e\u0431\u0456\u043c \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043b\u0456\u0432\u0430, \u043a\u0430\u043b\u0456 \u0431 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u0441\u0430\u043c \u043d\u0435 \u0431\u044b\u045e \u043f\u043b\u0430\u0442\u0430\u0439. \u0411\u043e \u043a\u0430\u043b\u0456 \u0437\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u043c\u044b \u043f\u0430\u0441\u0432\u0456\u043c \u042f\u0433\u043e \u0430\u0432\u0435\u0447\u0430\u043a, \u0448\u0442\u043e \u0436 \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u0446\u044c \u042f\u043c\u0443 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u043d\u0430\u0441 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456? \u041a\u0430\u043b\u0456 \u0436 \u043c\u044b \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u043f\u0430\u0441\u0442\u044b\u0440\u044b, \u2013 \u0430\u0434 \u0447\u0430\u0433\u043e \u0441\u0446\u0435\u0440\u0430\u0436\u044b \u043d\u0430\u0441, \u0411\u043e\u0436\u0430, \u2013 \u0442\u043e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043d\u0430\u0448\u0430\u0439 \u0437\u043b\u043e\u0441\u0446\u0456; \u043a\u0430\u043b\u0456 \u0434\u043e\u0431\u0440\u044b\u044f, \u2013 \u0448\u0442\u043e \u0434\u0430\u0439, \u0411\u043e\u0436\u0430, \u2013 \u0442\u043e \u043d\u0435 \u0456\u043d\u0430\u043a\u0448, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u0433\u043e \u043b\u0430\u0441\u0446\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u043c\u0430\u0435 \u0431\u0440\u0430\u0442\u044b, \u00ab\u043c\u044b \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435\u043c, \u043a\u0430\u0431 \u0432\u044b \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u043b\u0456 \u0434\u0430\u0440\u044d\u043c\u043d\u0430 \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u043a\u0456\u00bb (2 \u041a\u0430\u0440 6, 1). \u0427\u044b\u043d\u0456\u0446\u0435 \u043f\u043b\u0451\u043d\u043d\u0430\u0439 \u043d\u0430\u0448\u0443\u044e \u043f\u0430\u0441\u043b\u0443\u0433\u0443. \u00ab\u0412\u044b \u2013 \u043d\u0456\u0432\u0430 \u0411\u043e\u0436\u0430\u044f\u00bb (1 \u041a\u0430\u0440 3, 9). \u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u0437\u0432\u043e\u043d\u043a\u0443 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0435\u0435 \u0456 \u043f\u0430\u043b\u0456\u0432\u0430\u0435, \u0430 \u045e\u043d\u0443\u0442\u0440\u044b \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0434\u0430\u0435 \u045e\u0437\u0440\u043e\u0441\u0442. \u041f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439\u0446\u0435 \u043d\u0430\u0441 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439 \u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044e, \u043a\u0430\u0431 \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u0446\u0435\u0448\u044b\u043b\u0456\u0441\u044f \u0442\u044b\u043c, \u0448\u0442\u043e \u0441\u043b\u0443\u0436\u044b\u043c \u0432\u0430\u043c, \u0430 \u043d\u0435 \u0442\u044b\u043c, \u0448\u0442\u043e \u043a\u0456\u0440\u0443\u0435\u043c \u0432\u0430\u043c\u0456.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041c\u0434\u0440 10, 10\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0413\u044d\u0442\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u043c\u0443\u0447\u0430\u043d\u0456\u043a, \u044f\u043a\u0456 \u0434\u0437\u0435\u043b\u044f \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0435 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0401\u043d \u043d\u0435 \u0431\u0430\u044f\u045e\u0441\u044f \u0433\u043d\u0435\u0432\u0443 \u0441\u0443\u0434\u0434\u0437\u044f\u045e \u0456 \u043d\u0435 \u0448\u0443\u043a\u0430\u045e \u043f\u0440\u044b\u0437\u043d\u0430\u043d\u043d\u044f \u045e \u0437\u044f\u043c\u043d\u044b\u0445 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u043e\u045e, \u0430\u043b\u0435 \u0456\u043c\u043a\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0433\u0430 \u041f\u0430\u043d \u043d\u0430\u043a\u0456\u0440\u0430\u0432\u0430\u045e \u043d\u0430 \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u044b \u0448\u043b\u044f\u0445 \u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443 \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0401\u043d.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"773","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u0410\u043f\u043e\u0448\u043d\u044f\u0435 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u043d\u0434\u0440\u044d\u044f \u041a\u0456\u043c \u0422\u044d\u0430\u0433\u043e\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Pro Corea. Documenta., ed. Mission Catholique S\u00e9oul, S\u00e9oul-Paris 1938, Vol. I, 74-75)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0432\u0435\u0440\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043b\u044e\u0431\u043e\u045e \u0456 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b \u0456 \u0441\u044f\u0431\u0440\u044b! \u041f\u0430\u0434\u0443\u043c\u0430\u0439\u0446\u0435 \u0456 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435: \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0432\u0435\u0442\u0443 \u0411\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0435\u0431\u0430, \u0437\u044f\u043c\u043b\u044e \u0456 \u043d\u0430\u043e\u0433\u0443\u043b \u0443\u0441\u0451; \u043f\u0430\u0434\u0443\u043c\u0430\u0439\u0446\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0447\u0430\u043c\u0443 \u0456 \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0401\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u0441\u0432\u043e\u0439 \u0432\u043e\u0431\u0440\u0430\u0437 \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u043f\u043e\u045e\u043d\u044b\u043c \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0456 \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e, \u043c\u044b \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435\u043c \u0456 \u043d\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u0435\u043c \u0411\u043e\u0433\u0430-\u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f, \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0448\u0430\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435, \u043d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u0446\u044b \u043c\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e \u0441\u0432\u0435\u0442, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u0430\u0441\u0446\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0445\u0440\u043e\u0441\u0442 \u0456 \u045e\u0432\u0430\u0439\u0448\u043b\u0456 \u045e \u041a\u0430\u0441\u0446\u0451\u043b, \u0456, \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0432\u0443\u0447\u043d\u044f\u043c\u0456 \u041f\u0430\u043d\u0430, \u043c\u044b \u043d\u043e\u0441\u0456\u043c \u042f\u0433\u043e \u0433\u0430\u043d\u0430\u0440\u043e\u0432\u0430\u0435 \u0456\u043c\u044f, \u0442\u043e \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u043d\u0430\u043c \u0456\u043c\u044f, \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u0430\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435? \u041a\u0430\u043b\u0456 \u0431 \u0442\u0430\u043a \u0431\u044b\u043b\u043e, \u0442\u043e \u043c\u044b \u0434\u0430\u0440\u044d\u043c\u043d\u0430 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e \u0441\u0432\u0435\u0442, \u0434\u0430\u0440\u044d\u043c\u043d\u0430 \u043d\u0430\u043b\u0435\u0436\u044b\u043c \u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u041a\u0430\u043d\u0435\u0448\u043d\u0435, \u0442\u0430\u043a\u0430\u044f \u043f\u0430\u0441\u0442\u0430\u0432\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u043b\u0430 \u0431 \u0430\u0434\u044b\u0445\u043e\u0434 \u0430\u0434 \u041f\u0430\u043d\u0430 \u0456 \u042f\u0433\u043e \u043b\u0430\u0441\u043a\u0456. \u0422\u0430\u0434\u044b \u043b\u0435\u043f\u0448 \u0431\u044b\u043b\u043e \u0431 \u043d\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u0446\u0430, \u0447\u044b\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043b\u0430\u0441\u043a\u0443 \u041f\u0430\u043d\u0430 \u0456 \u0437\u0433\u0440\u0430\u0448\u044b\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u044c\u0446\u0435\u0441\u044f \u0434\u0430 \u0437\u0435\u043c\u043b\u044f\u0440\u043e\u0431\u0430, \u044f\u043a\u0456 \u0441\u0435\u0435 \u0437\u0435\u0440\u043d\u0435 \u043d\u0430 \u043f\u043e\u043b\u0456: \u0443 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441 \u0430\u0440\u044d \u0437\u044f\u043c\u043b\u044e, \u0434\u0430\u0433\u043b\u044f\u0434\u0430\u0435, \u0430\u0431\u0435\u0440\u0430\u0433\u0430\u0435 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0435 \u0437\u0435\u0440\u043d\u0435 \u0456 \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u0435 \u043d\u0430 \u0446\u044f\u0436\u0430\u0440 \u043f\u0440\u0430\u0446\u044b \u043f\u0430\u0434 \u043f\u0440\u043e\u043c\u043d\u044f\u043c\u0456 \u0441\u043e\u043d\u0446\u0430. \u041a\u0430\u043b\u0456 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0447\u0430\u0441 \u0436\u043d\u0456\u0432\u0430, \u043a\u0430\u043b\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043d\u0430\u043b\u0456\u0442\u044b\u044f \u043a\u0430\u043b\u0430\u0441\u044b, \u0451\u043d \u0437\u0430\u0431\u044b\u0432\u0430\u0435 \u043f\u0440\u0430 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044c \u043f\u0440\u0430\u0446\u044b \u0456, \u043f\u043e\u045e\u043d\u044b \u0448\u0447\u0430\u0441\u0446\u044f, \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0456 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430. \u041a\u0430\u043b\u0456 \u0436 \u043a\u0430\u043b\u0430\u0441\u044b \u043f\u0443\u0441\u0442\u044b\u044f \u0456 \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u0441\u0430\u043b\u043e\u043c\u044b \u0456 \u043f\u0443\u0441\u0442\u0430\u0437\u0435\u043b\u043b\u044f, \u0437\u0435\u043c\u043b\u044f\u0440\u043e\u0431 \u0443\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0435 \u0446\u044f\u0436\u0430\u0440 \u043f\u0440\u0430\u0446\u044b \u0456 \u0432\u044b\u0441\u0456\u043b\u043a\u0456; \u044f\u0448\u0447\u044d \u0445\u0443\u0442\u0447\u044d\u0439 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0456 \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u0435 \u043f\u043e\u043b\u0435, \u044f\u043a\u043e\u0435 \u0442\u0430\u043a \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0430\u043f\u0440\u0430\u0446\u043e\u045e\u0432\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u0441\u0432\u0435\u0442 \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u043b\u0435\u0431\u0430\u0439, \u043c\u044b, \u043b\u044e\u0434\u0437\u0456, \u2013 \u043d\u0456\u0431\u044b \u0440\u044b\u0441, \u0430 \u043b\u0430\u0441\u043a\u0430 \u2013 \u0432\u0456\u043b\u044c\u0433\u0430\u0446\u044c. \u0413\u044d\u0442\u0430 \u0401\u043d \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0423\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044e \u0456 \u0410\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044e \u0430\u0431\u0432\u0430\u0434\u043d\u044f\u0435 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u0456 \u0441\u043f\u0435\u0446\u044c. \u0423 \u0434\u0437\u0435\u043d\u044c \u0441\u0443\u0434\u0430, \u043a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0447\u0430\u0441 \u0437\u0431\u0456\u0440\u0430\u0446\u044c \u0443\u0440\u0430\u0434\u0436\u0430\u0439, \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043b\u0430\u0441\u0446\u044b \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0435\u043b\u044b\u043c, \u044f\u043a \u0443\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u0435 \u0434\u0437\u0456\u0446\u0451 \u0411\u043e\u0436\u0430\u0435, \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u043c\u0443 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0443; \u0445\u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0435\u043b\u044b\u043c, \u0445\u043e\u0446\u044c \u0431\u044b\u045e \u0443\u0436\u043e \u045e\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u043c \u0434\u0437\u0456\u0446\u0435\u043c, \u0441\u0442\u0430\u043d\u0435 \u044f\u043a \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044c \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435 \u043d\u0430\u0432\u0435\u043a\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0432\u0435\u0434\u0430\u0439\u0446\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u0448 \u041f\u0430\u043d, \u0415\u0437\u0443\u0441, \u043f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b \u045e \u0441\u0432\u0435\u0442, \u0446\u044f\u0440\u043f\u0435\u045e \u0440\u043e\u0437\u043d\u044b\u044f \u043c\u0443\u0447\u044d\u043d\u043d\u0456. \u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043c\u0443\u043a\u0443 \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u045e \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u0456 \u045e\u0437\u0440\u043e\u0448\u0447\u0432\u0430\u0435 \u044f\u0433\u043e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435\u043c \u0432\u0435\u0440\u043d\u044b\u0445. \u0425\u043e\u0446\u044c \u0441\u0456\u043b\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u044e\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u0456 \u0437\u043c\u0430\u0433\u0430\u044e\u0446\u0446\u0430 \u0437 \u0456\u043c, \u0430\u0434\u043d\u0430\u043a \u043d\u0456\u043a\u043e\u043b\u0456 \u044f\u043d\u044b \u043d\u0435 \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0447\u044b \u044f\u0433\u043e. \u041f\u0430\u0441\u043b\u044f \u0423\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u044f, \u0437 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456\u0445 \u0447\u0430\u0441\u043e\u045e \u0430\u0436 \u0434\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0447\u0430\u0441\u0443, \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u0443\u0441\u044e\u0434\u044b \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0435 \u0441\u044f\u0440\u043e\u0434 \u0443\u0446\u0456\u0441\u043a\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u0446\u044f\u043f\u0435\u0440, \u043f\u0430\u0441\u043b\u044f \u043f\u044f\u0446\u0456 \u0446\u0456 \u0448\u0430\u0441\u0446\u0456 \u0434\u0437\u0435\u0441\u044f\u0442\u043a\u0430\u045e \u0433\u0430\u0434\u043e\u045e, \u044f\u043a \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u043f\u0430\u0447\u0430\u045e \u0456\u0441\u043d\u0430\u0432\u0430\u0446\u044c \u0443 \u043d\u0430\u0448\u0430\u0439 \u041a\u0430\u0440\u044d\u0456, \u0432\u0435\u0440\u043d\u0456\u043a\u0456 \u0437 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u0446\u0435\u0440\u043f\u044f\u0446\u044c \u0443\u0446\u0456\u0441\u043a, \u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0451\u043d\u043d\u044f \u0448\u0430\u043b\u0435\u0435 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434. \u0428\u043c\u0430\u0442 \u0431\u0440\u0430\u0442\u043e\u045e \u0443 \u0432\u0435\u0440\u044b, \u0441\u044f\u0440\u043e\u0434 \u0456\u0445 \u0456 \u044f, \u0431\u044b\u043b\u0456 \u043a\u0456\u043d\u0443\u0442\u044b\u044f \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u0443. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0432\u044b \u0436\u044b\u0432\u044f\u0446\u0435 \u0441\u044f\u0440\u043e\u0434 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0437\u0430\u043c \u043c\u044b \u0441\u0442\u0432\u0430\u0440\u0430\u0435\u043c \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430, \u044f\u043a \u0436\u0430 \u0448\u0447\u044b\u0440\u0430 \u043d\u0435 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u0446\u0446\u0430 \u0433\u044d\u0442\u044b\u043c? \u042f\u043a \u0436\u0430 \u043d\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u0446\u044c \u043f\u0430-\u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0431\u043e\u043b\u044c \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043f\u0430\u0434\u0437\u0435\u043b\u0443?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a, \u044f\u043a \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0411\u043e\u0433 \u0443 \u0441\u0432\u0430\u0456\u043c \u041f\u0440\u043e\u0432\u0456\u0434\u0437\u0435 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0443\u044e \u0432\u0430\u043b\u0430\u0441\u0456\u043d\u043a\u0443 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0435. \u0422\u0430\u043c\u0443, \u0446\u0456 \u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u0431\u0430\u0447\u044b\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0437\u0435 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437\u0430\u0433\u0430\u0434 \u041f\u0430\u043d\u0430, \u042f\u0433\u043e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0430\u0431\u043e, \u0443\u0440\u044d\u0448\u0446\u0435, \u042f\u0433\u043e \u043a\u0430\u0440\u0443?&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u044f\u0439, \u0443\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0437\u043c\u0430\u0433\u0430\u0439\u0446\u0435\u0441\u044f \u043f\u0430\u0434 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0415\u0437\u0443\u0441\u0430, \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430, \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0439\u0446\u0435 \u0441\u0456\u043b\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0443\u0436\u043e \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043d\u044b\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u043d\u0435 \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u0439\u0446\u0435 \u0431\u0440\u0430\u0442\u043d\u044f\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0430\u043b\u0435 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439\u0446\u0435 \u0441\u0430\u0431\u0435 \u045e\u0437\u0430\u0435\u043c\u043d\u0430. \u0412\u044b\u0442\u0440\u044b\u043c\u0430\u0439\u0446\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u041f\u0430\u043d \u043d\u0435 \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456 \u0456 \u043d\u0435 \u0430\u0434\u0445\u0456\u043b\u0456\u0446\u044c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u0441 \u0442\u0443\u0442 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u044c, \u0456 \u045e\u0441\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0433\u0443 \u0442\u0440\u044b\u043c\u0430\u044e\u0446\u0446\u0430 \u0434\u043e\u0431\u0440\u0430. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u0431\u0456\u0442\u044b, \u043f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435, \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u043f\u0440\u0430 \u044f\u0433\u043e \u0441\u044f\u043c\u2019\u044e. \u0428\u043c\u0430\u0442 \u044f\u0448\u0447\u044d \u0445\u0430\u0447\u0443 \u0432\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0430\u043b\u0435 \u044f\u043a \u0436\u0430 \u0433\u044d\u0442\u0430 \u0432\u044b\u0440\u0430\u0437\u0456\u0446\u044c \u043d\u0430 \u043f\u0456\u0441\u044c\u043c\u0435? \u0422\u0430\u043c\u0443 \u0437\u0430\u043a\u0430\u043d\u0447\u0432\u0430\u044e \u043b\u0456\u0441\u0442. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u043c\u0441\u044f \u0434\u0430 \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u044f, \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043f\u0440\u044b\u043d\u0446\u044b\u043f\u0430\u043c\u0456 \u0432\u0435\u0440\u044b, \u043a\u0430\u0431, \u0442\u0440\u0430\u043f\u0456\u045e\u0448\u044b \u045e \u043d\u0435\u0431\u0430, \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0430\u0432\u0456\u043d\u0448\u0430\u0432\u0430\u0446\u044c. \u041f\u0430\u043a\u0456\u0434\u0430\u044e \u0432\u0430\u043c \u043f\u0430\u0446\u0430\u043b\u0443\u043d\u0430\u043a \u043b\u044e\u0431\u043e\u0432\u0456.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. 2 \u041a\u0430\u0440 6, 9-10\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u043e\u0441\u044c \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043d\u0435 \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u043f\u0430\u0433\u0440\u043e\u0437\u0430\u045e. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041a\u0440\u043e\u045e \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0441\u0442\u0430\u043b\u0430 \u043d\u0430\u0441\u0435\u043d\u043d\u0435\u043c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u0442\u0432\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f\u043d\u044b \u0431\u044b\u043b\u0456 \u043d\u0456\u0431\u044b \u043d\u0435\u0432\u044f\u0434\u043e\u043c\u044b\u044f, \u0430\u043b\u0435 \u0456\u0445 \u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c; \u043d\u0456\u0431\u044b \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b\u044f, \u0430\u043b\u0435 \u0432\u043e\u0441\u044c \u0436\u044b\u0432\u0443\u0446\u044c, \u043d\u0456\u0431\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043c\u0430\u044e\u0446\u044c, \u0430\u043b\u0435 \u045e\u0441\u0456\u043c \u0432\u0430\u043b\u043e\u0434\u0430\u044e\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0440\u043e\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"774","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u0411\u044d\u0434\u044b \u0412\u044f\u043b\u0435\u0431\u043d\u0430\u0433\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 21: CCL 122, 149-151)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423\u0431\u0430\u0447\u044b\u045e \u044f\u0433\u043e \u0415\u0437\u0443\u0441, \u0437\u043c\u0456\u043b\u0430\u0432\u0430\u045e\u0441\u044f \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u044f\u0433\u043e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041a\u0430\u043b\u0456 \u0415\u0437\u0443\u0441 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u045e \u0430\u0434\u0442\u0443\u043b\u044c, \u0443\u0431\u0430\u0447\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0435\u045e \u043d\u0430 \u043c\u044b\u0442\u043d\u0456, \u044f\u043a\u043e\u0433\u0430 \u0437\u0432\u0430\u043b\u0456 \u041c\u0430\u0446\u0432\u0435\u0439, \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: \u201d\u0406\u0434\u0437\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e\u201d\u00bb (\u041c\u0446 9, 9). \u0423\u0431\u0430\u0447\u044b\u045e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430, \u0430\u043b\u0435 \u0431\u0430\u0447\u0430\u043d\u043d\u0435\u043c \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u0423\u0431\u0430\u0447\u044b\u045e \u043c\u044b\u0442\u043d\u0456\u043a\u0430, \u0430 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u044b\u045e \u0433\u044d\u0442\u0430 \u043f\u043e\u0437\u0456\u0440\u043a \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0432\u044b\u0431\u0430\u0440\u0443, \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: \u00ab\u0406\u0434\u0437\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e\u00bb, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c: \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0439 \u041c\u044f\u043d\u0435. \u0421\u043a\u0430\u0437\u0430\u045e: \u00ab\u0406\u0434\u0437\u0456\u00bb \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0456 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0433\u0430 \u0432\u0430\u043d\u0434\u0440\u0430\u0432\u0430\u043d\u043d\u044f, \u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0437\u0432\u044b\u0447\u0430\u044f\u045e. \u00ab\u0425\u0442\u043e \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0406\u043c, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0442\u0430\u043a, \u044f\u043a \u0401\u043d \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u045e\u00bb (1 \u042f\u043d 2, 6).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0422\u043e\u0439 \u0443\u0441\u0442\u0430\u045e, \u2013 \u043a\u0430\u0436\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u2013 \u0456 \u043f\u0430\u0439\u0448\u043e\u045e \u0437\u0430 \u0406\u043c\u00bb (\u041c\u0446 9, 9). \u041d\u0456\u0447\u043e\u0433\u0430 \u0434\u0437\u0456\u045e\u043d\u0430\u0433\u0430, \u0448\u0442\u043e \u043d\u0430 \u0433\u043e\u043b\u0430\u0441 \u041f\u0430\u043d\u0430 \u043c\u044b\u0442\u043d\u0456\u043a \u0442\u0443\u0442 \u0436\u0430 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0437\u044f\u043c\u043d\u044b\u044f \u0432\u044b\u0433\u043e\u0434\u044b, \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c \u0456 \u043f\u0440\u044b\u043f\u0430\u045e \u0434\u0430 \u0442\u0430\u0433\u043e, \u043f\u0440\u0430 \u0447\u044b\u0451 \u045e\u0431\u043e\u0441\u0442\u0432\u0430 \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u045e. \u041d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u041f\u0430\u043d, \u044f\u043a\u0456 \u0437\u0432\u043e\u043d\u043a\u0443 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0441\u043b\u043e\u0432\u0430\u043c, \u0443\u043d\u0443\u0442\u0440\u044b \u043d\u044f\u0431\u0430\u0447\u043d\u044b\u043c \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0435\u043c \u0437\u0430\u0430\u0445\u0432\u043e\u0446\u0456\u045e \u0456\u0441\u0446\u0456 \u0437\u0430 \u0441\u0430\u0431\u043e\u044e. \u0410\u0441\u0432\u044f\u0446\u0456\u045e \u0440\u043e\u0437\u0443\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u043c\u044b\u0442\u043d\u0456\u043a \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0434\u043a\u043b\u0456\u043a\u0430\u045e \u044f\u0433\u043e \u0430\u0434 \u0437\u044f\u043c\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u043c\u0430\u0435 \u043c\u043e\u0446 \u0434\u0430\u0446\u044c \u044f\u043c\u0443 \u045e \u043d\u0435\u0431\u0435 \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041a\u0430\u043b\u0456 \u0415\u0437\u0443\u0441 \u0431\u044b\u045e \u0437\u0430 \u0441\u0442\u0430\u043b\u043e\u043c \u0443 \u0434\u043e\u043c\u0435, \u043c\u043d\u043e\u0433\u0456\u044f \u043c\u044b\u0442\u043d\u0456\u043a\u0456 \u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0456 \u0437\u0430\u043d\u044f\u043b\u0456 \u043c\u0435\u0441\u0446\u0430 \u0437\u0430 \u0441\u0442\u0430\u043b\u043e\u043c \u0437 \u0406\u043c \u0456 \u0432\u0443\u0447\u043d\u044f\u043c\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456\u00bb (\u041c\u0446 9, 10). \u041d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u0430\u0434\u043d\u0430\u0433\u043e \u043c\u044b\u0442\u043d\u0456\u043a\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u043b\u0430 \u0434\u0430\u0440\u043e\u0433\u0443 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f \u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u044f \u0434\u043b\u044f \u043c\u043d\u043e\u0433\u0456\u0445 \u043c\u044b\u0442\u043d\u0456\u043a\u0430\u045e \u0456 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e. \u0422\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0437\u043d\u0435\u0439 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0441\u0442\u0430\u0446\u044c \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u045e\u0437\u043d\u0451\u0441\u043b\u044b\u043c \u0456 \u0431\u0435\u0441\u043f\u0430\u043c\u044b\u043b\u043a\u043e\u0432\u044b\u043c \u043f\u0430\u0447\u0443\u0446\u0446\u0451\u043c, \u0443\u0436\u043e \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443\u045e \u043d\u0430 \u0434\u0430\u0440\u043e\u0433\u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e; \u0430\u0434 \u0441\u0430\u043c\u0430\u0433\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u0440\u044b \u043f\u0440\u044b\u043d\u044f\u045e \u0437\u0430\u0434\u0430\u043d\u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u044f\u043a\u043e\u0435 \u043f\u0430 \u043c\u0435\u0440\u044b \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u044f \u045e \u0446\u043d\u043e\u0442\u0430\u0445, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u043f\u0430\u0437\u043d\u0435\u0439 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c. \u041a\u0430\u043b\u0456 \u0437\u0430\u0445\u043e\u0447\u0430\u043c \u0431\u043e\u043b\u044c\u0448 \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435 \u0433\u044d\u0442\u044b\u0445 \u043f\u0430\u0434\u0437\u0435\u0439, \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u043c, \u0448\u0442\u043e \u041c\u0430\u0446\u0432\u0435\u0439 \u0443 \u0441\u0432\u0430\u0456\u043c \u0437\u044f\u043c\u043d\u044b\u043c \u0434\u043e\u043c\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u0443\u044e \u0433\u0430\u0441\u0446\u0456\u043d\u0443, \u0430\u043b\u0435 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0456 \u043b\u044e\u0431\u043e\u045e \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u043d\u0430\u0448\u043c\u0430\u0442 \u043f\u0440\u044b\u0435\u043c\u043d\u0435\u0439\u0448\u0443\u044e \u0433\u0430\u0441\u0446\u0456\u043d\u0443. \u041f\u0440\u0430 \u0442\u0430\u043a\u0443\u044e \u0433\u0430\u0441\u0446\u0456\u043d\u0443 \u043a\u0430\u0436\u0430 \u0441\u0430\u043c \u0415\u0437\u0443\u0441: \u00ab\u0412\u043e\u0441\u044c \u0441\u0442\u0430\u044e \u043a\u0430\u043b\u044f \u0434\u0437\u0432\u044f\u0440\u044d\u0439 \u0456 \u0441\u0442\u0443\u043a\u0430\u044e. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043f\u0430\u0447\u0443\u0435 \u041c\u043e\u0439 \u0433\u043e\u043b\u0430\u0441 \u0456 \u0430\u0434\u0447\u044b\u043d\u0456\u0446\u044c \u0434\u0437\u0432\u0435\u0440\u044b, \u0443\u0432\u0430\u0439\u0434\u0443 \u0434\u0430 \u044f\u0433\u043e \u0456 \u0431\u0443\u0434\u0443 \u0432\u044f\u0447\u044d\u0440\u0430\u0446\u044c \u0437 \u0456\u043c, \u0430 \u0451\u043d \u0441\u0430 \u041c\u043d\u043e\u044e\u00bb (\u0410\u043f 3, 20).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u0431 \u042f\u0433\u043e \u043f\u0440\u044b\u043d\u044f\u0446\u044c, \u043c\u044b \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435\u043c \u0434\u0437\u0432\u0435\u0440\u044b \u043d\u0430 \u042f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0441. \u0410\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043c\u044b \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0441\u043b\u0443\u0445\u0430\u0435\u043c\u0441\u044f \u042f\u0433\u043e \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u044b\u0445 \u0446\u0456 \u0437\u043d\u0435\u0448\u043d\u0456\u0445 \u043d\u0430\u043f\u0430\u043c\u0456\u043d\u0430\u045e, \u043a\u0430\u043b\u0456 \u0440\u044d\u0430\u043b\u0456\u0437\u043e\u045e\u0432\u0430\u0435\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u044f\u043a \u0437\u0430\u0434\u0430\u043d\u043d\u0435 \u0434\u043b\u044f \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f. \u041f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u043a\u0430\u0431 \u0432\u044f\u0447\u044d\u0440\u0430\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u043c\u0456, \u0430 \u043d\u0430\u043c \u0437 \u0406\u043c, \u0431\u043e \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0401\u043d \u0441\u0435\u043b\u0456\u0446\u0446\u0430 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0456\u0445 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u044f\u043d\u044b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u044e\u0446\u044c \u0443 \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u045e, \u0430 \u0401\u043d \u043d\u0430\u0441\u044b\u0447\u0430\u0435\u0446\u0446\u0430 \u0456\u043c\u0456 \u043d\u0456\u0431\u044b \u0432\u044b\u0442\u0430\u043d\u0447\u0430\u043d\u0430\u0439 \u0435\u0436\u0430\u0439.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0430\u0442\u0445\u043d\u0451\u043d\u044b \u0430\u045e\u0442\u0430\u0440 \u0456 \u0437\u043d\u0430\u045e\u0446\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0417\u0430\u043a\u043e\u043d\u0443 <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u0431 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0417\u0430\u043a\u043e\u043d\u0430 \u041f\u0430\u043d\u0430, \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0456 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0431\u043e \u0440\u0443\u043a\u0430 \u0411\u043e\u0436\u0430\u044f \u0431\u044b\u043b\u0430 \u043d\u0430\u0434 \u0456\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f\u043c\u0443 \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430 \u0431\u044b\u043b\u043e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0445\u0432\u0430\u043b\u044b \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"775","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041b\u0456\u0441\u0442\u044b \u0441\u0432. \u041f\u0456\u043e \u0437 \u041f\u2019\u0435\u0442\u0440\u044d\u043b\u044c\u0447\u044b\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Editio 1994: II, 87-90, n. 8)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u0430\u043c\u044f\u043d\u0456 \u0432\u0435\u0447\u043d\u0430\u0439 \u0431\u0443\u0434\u043e\u045e\u043b\u0456&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e\u0441\u043a\u0456 \u0411\u0443\u0434\u0430\u045e\u043d\u0456\u043a \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u044b\u044f \u045e\u0434\u0430\u0440\u044b \u0437\u0431\u0430\u045e\u0447\u0430\u0433\u0430 \u0434\u043e\u043b\u0430\u0442\u0430 \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0435 \u0430\u0431\u0447\u044d\u0441\u0432\u0430\u043d\u043d\u0435 \u043d\u0430\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u043a\u0430\u043c\u044f\u043d\u0456, \u0437 \u044f\u043a\u0456\u0445 \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0432\u0435\u0447\u043d\u0443\u044e \u0431\u0443\u0434\u043e\u045e\u043b\u044e, \u044f\u043a \u0441\u043f\u044f\u0432\u0430\u0435 \u043d\u0430\u0448\u0430\u044f \u043d\u0430\u0439\u043b\u0430\u0441\u043a\u0430\u0432\u0435\u0439\u0448\u0430\u044f \u041c\u0430\u0446\u0456, \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0433\u0456\u043c\u043d\u0435 \u0437 \u0411\u0440\u044d\u0432\u0456\u044f\u0440\u044b\u044f \u043d\u0430 \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u043a\u0430\u0441\u0446\u0451\u043b\u0430. \u0406 \u0442\u0430\u043a \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0451\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u043e\u0436\u043d\u0430\u044f \u0434\u0443\u0448\u0430, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430\u044f \u0434\u043b\u044f \u0432\u0435\u0447\u043d\u0430\u0439 \u0445\u0432\u0430\u043b\u044b, \u043c\u043e\u0436\u0430 \u0441\u043b\u0443\u0448\u043d\u0430 \u043d\u0430\u0437\u0432\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u043a\u0430\u043c\u0435\u043d\u0435\u043c, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b\u043c \u0434\u043b\u044f \u045e\u0437\u043d\u044f\u0441\u0435\u043d\u043d\u044f \u0432\u0435\u0447\u043d\u0430\u0439 \u0431\u0443\u0434\u043e\u045e\u043b\u0456. \u0410\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u043c \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a\u0430, \u044f\u043a\u0456 \u0445\u043e\u0447\u0430 \u044f\u043a \u043d\u0430\u0439\u043b\u0435\u043f\u0448 \u0443\u0437\u043d\u0435\u0441\u0446\u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0430\u0431\u0447\u044d\u0441\u0432\u0430\u043d\u043d\u0435 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u0437 \u044f\u043a\u0456\u0445 \u044f\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u045e\u0437\u0432\u0435\u0434\u0437\u0435\u043d\u0430. \u0420\u043e\u0431\u0456\u0446\u044c \u0451\u043d \u0433\u044d\u0442\u0430 \u045e\u0434\u0430\u0440\u0430\u043c\u0456 \u043c\u043e\u043b\u0430\u0442\u0430 \u0456 \u0434\u043e\u043b\u0430\u0442\u0430. \u0422\u0430\u043a \u0436\u0430 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0410\u0439\u0446\u0435\u0446 \u0437 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c\u0456 \u0434\u0443\u0448\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u045e\u0436\u043e \u0434\u0430\u045e\u043d\u043e, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u0433\u043e \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u041f\u0440\u043e\u0432\u0456\u0434\u0443, \u0431\u044b\u043b\u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0434\u043b\u044f \u045e\u0437\u043d\u044f\u0441\u0435\u043d\u043d\u044f \u0432\u0435\u0447\u043d\u0430\u0439 \u0431\u0443\u0434\u043e\u045e\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0443\u0448\u0430, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430\u044f \u0434\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043d\u043d\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0445\u0432\u0430\u043b\u0435, \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0430\u0431\u0447\u044d\u0441\u0430\u043d\u0430\u044f \u045e\u0434\u0430\u0440\u0430\u043c\u0456 \u043c\u043e\u043b\u0430\u0442\u0430 \u0456 \u0434\u043e\u043b\u0430\u0442\u0430, \u044f\u043a\u0456\u043c\u0456 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0411\u043e\u0441\u043a\u0456 \u0411\u0443\u0434\u0430\u045e\u043d\u0456\u043a, \u043a\u0430\u0431 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u043a\u0430\u043c\u0435\u043d\u043d\u0435, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u044f \u0434\u0443\u0448\u044b. \u0410 \u0447\u044b\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0433\u044d\u0442\u044b\u044f \u045e\u0434\u0430\u0440\u044b \u043c\u043e\u043b\u0430\u0442\u0430 \u0456 \u0434\u043e\u043b\u0430\u0442\u0430? \u0413\u044d\u0442\u0430 \u0446\u0435\u043c\u0440\u0430, \u043c\u0430\u044f \u0441\u044f\u0441\u0442\u0440\u0430, \u0441\u0442\u0440\u0430\u0445\u0456, \u0441\u043f\u0430\u043a\u0443\u0441\u044b, \u0431\u043e\u043b\u044c \u0434\u0443\u0448\u044b \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u0431\u043e\u044f\u0437\u044c, \u044f\u043a\u0456\u044f \u0441\u0432\u0435\u0434\u0447\u0430\u0446\u044c \u043f\u0440\u0430 \u043d\u0435\u0439\u043a\u0443\u044e \u0445\u0432\u0430\u0440\u043e\u0431\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u043a\u0443\u0442\u044b \u0446\u0435\u043b\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0434\u0437\u044f\u043a\u0443\u0439\u0446\u0435 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0434\u0431\u0430\u0435 \u043f\u0440\u0430 \u0432\u0430\u0448\u0443\u044e \u0434\u0443\u0448\u0443, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0443\u044e \u0434\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0427\u0430\u043c\u0443 \u0436 \u0432\u044b \u043d\u0435 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0435\u0441\u044f \u0433\u044d\u0442\u044b\u043c\u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u043c\u0456 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u0433\u0430 \u0437 \u0443\u0441\u0456\u0445 \u0430\u0439\u0446\u043e\u045e? \u0410\u0434\u043a\u0440\u044b\u0439\u0446\u0435 \u0441\u044d\u0440\u0446\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u043c\u0443 \u041b\u0435\u043a\u0430\u0440\u0443 \u0434\u0443\u0448 \u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u0434\u0430\u0432\u0435\u0440\u0446\u0435\u0441\u044f \u0437 \u043f\u043e\u045e\u043d\u044b\u043c \u0434\u0430\u0432\u0435\u0440\u0430\u043c \u042f\u0433\u043e \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u044b\u043c \u0440\u0443\u043a\u0430\u043c: \u0401\u043d \u0441\u0442\u0430\u0432\u0456\u0446\u0446\u0430 \u0434\u0430 \u0432\u0430\u0441 \u044f\u043a \u0434\u0430 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445, \u043a\u0430\u0431 \u0432\u044b \u0430\u0434\u0440\u0430\u0437\u0443 \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430 \u0415\u0437\u0443\u0441\u0430\u043c \u043d\u0430 \u0433\u0430\u0440\u0443 \u041a\u0430\u043b\u044c\u0432\u0430\u0440\u044b\u044e. \u042f \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u044b\u043c \u0445\u0432\u0430\u043b\u044f\u0432\u0430\u043d\u043d\u0435\u043c \u0431\u0443\u0434\u0443 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0443 \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0446\u044c \u043b\u0430\u0441\u043a\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0439\u0446\u0435\u0441\u044f, \u0448\u0442\u043e \u045e\u0441\u0451, \u0448\u0442\u043e \u0441\u0443\u0441\u0442\u0440\u044d\u043b\u0430 \u0432\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b, \u0443\u0447\u044b\u043d\u0456\u045e \u041f\u0430\u043d. \u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0442\u0430\u043a \u043c\u043e\u0446\u043d\u0430, \u0448\u0442\u043e \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u0446\u0435 \u045e \u0437\u043b\u043e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0437\u043d\u044f\u0432\u0430\u0436\u044b\u0446\u0435 \u0411\u043e\u0433\u0430. \u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0432\u0430 \u045e\u0441\u0456\u043c \u0432\u0430\u0448\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0432\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0437\u0456\u043b\u0456 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456, \u0434\u0430\u0440\u044d\u0447\u044b, \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448 \u0443\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u044b \u043d\u0430\u0439\u043b\u0430\u0441\u043a\u0430\u0432\u0435\u0439\u0448\u044b \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a \u0432\u0430\u0448\u0430\u0439 \u0434\u0443\u0448\u044b \u045e\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430, \u0442\u043e \u0440\u043e\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u0432\u044b \u0434\u0443\u043c\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0445\u043e\u0447\u0430 \u0432\u0430\u0441 \u043f\u0430\u043a\u0430\u0440\u0430\u0446\u044c \u0437\u0430 \u0432\u0430\u0448\u0443\u044e \u043d\u044f\u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c, \u0430\u043b\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e\u0441\u0451 \u0431\u043e\u043b\u044c\u0448 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u0435 \u0432\u0430\u0448\u0443\u044e \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u0441\u0442\u0432\u0430. \u0401\u043d \u0430\u0434\u043d\u0430\u0437\u043d\u0430\u0447\u043d\u0430 \u0445\u043e\u0447\u0430 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u0432\u0430\u0448\u0443\u044e \u0434\u0443\u0448\u0443 \u043d\u0430\u0432\u0430\u0442 \u0430\u0434 \u0434\u0440\u0430\u0431\u043d\u0435\u0439\u0448\u0430\u0439 \u043f\u0430\u0447\u0443\u0446\u0446\u0451\u0432\u0430\u0439 \u043f\u0440\u044b\u0432\u044f\u0437\u0430\u043d\u0430\u0441\u0446\u0456, \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0439 \u0434\u043b\u044f \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u0445 \u0432\u0430\u0447\u044d\u0439; \u043c\u0430\u044e \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0442\u0443\u044e \u043f\u0440\u044b\u0432\u044f\u0437\u0430\u043d\u0430\u0441\u0446\u044c \u0456 \u0442\u044b\u044f \u043f\u0440\u0430\u0432\u0456\u043d\u044b, \u044f\u043a\u0456\u044f \u043c\u0430\u0435 \u043d\u0430\u0432\u0430\u0442 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u0411\u043e \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u043c\u043e\u0436\u0430 \u045e\u043f\u0430\u0441\u0446\u0456 \u0441\u0435\u043c \u0440\u0430\u0437\u043e\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u0432\u0435\u0440\u0446\u0435 \u043c\u043d\u0435, \u043a\u0430\u043b\u0456 \u0431 \u044f \u043d\u0435 \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u0432\u044b \u0442\u0430\u043a \u0446\u0435\u0440\u043f\u0456\u0446\u0435, \u0442\u043e \u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0431 \u043c\u0435\u043d\u0448, \u0431\u043e \u0440\u0430\u0437\u0443\u043c\u0435\u045e \u0431\u044b, \u0448\u0442\u043e \u041f\u0430\u043d \u0434\u0430\u045e \u0432\u0430\u043c \u043c\u0435\u043d\u0448 \u043f\u044f\u0440\u043b\u0456\u043d\u0430\u045e\u2026 \u0410\u0434\u043a\u0456\u043d\u044c\u0446\u0435, \u044f\u043a \u0441\u043f\u0430\u043a\u0443\u0441\u044b, \u0432\u0430\u0440\u043e\u0436\u044b\u044f \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0456\u2026 \u0410\u0434\u043a\u0456\u043d\u044c\u0446\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0445\u0432\u0435\u0439\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u0441\u043f\u043e\u0441\u0430\u0431\u0443 \u0432\u0430\u0448\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u0448\u0442\u043e \u0432\u044b \u043d\u0435 \u0447\u0443\u0435\u0446\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0437\u0430\u043a\u043b\u0456\u043a\u0443 \u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u0456\u045e\u043b\u044f\u0435\u0446\u0435\u0441\u044f \u0441\u0430\u043b\u043e\u0434\u043a\u0456\u043c \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u044f\u043c \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430. \u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0435 \u0430\u0434 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0434\u0443\u0445\u0430, \u0430\u043b\u0435 \u0430\u0434 \u0437\u043b\u043e\u0433\u0430. \u0413\u044d\u0442\u0430 \u0434\u2019\u044f\u0431\u0430\u043b\u044c\u0441\u043a\u0456\u044f \u043f\u0430\u0441\u0442\u043a\u0456, \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u044f \u043d\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0432\u044b \u0430\u0434\u044b\u0448\u043b\u0456 \u0430\u0434 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u0430\u0431\u043e \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456\u0441\u044f \u045e \u0434\u0430\u0440\u043e\u0437\u0435 \u0434\u0430 \u044f\u0435. \u041d\u0435 \u0433\u0430\u0441\u0456\u0446\u0435 \u0434\u0443\u0445\u0430!<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0415\u0437\u0443\u0441 \u0430\u0431\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430, \u0434\u0437\u044f\u043a\u0443\u0439\u0446\u0435 \u042f\u043c\u0443; \u043a\u0430\u043b\u0456 \u045e\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430, \u0442\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u042f\u043c\u0443 \u0434\u0437\u044f\u043a\u0443\u0439\u0446\u0435: \u0443\u0441\u0451 \u0433\u044d\u0442\u0430 \u0440\u0430\u0441\u043a\u043e\u0448\u0430 \u043b\u044e\u0431\u043e\u0432\u0456. \u041f\u0440\u0430\u0433\u043d\u0443, \u043a\u0430\u0431 \u0432\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0415\u0437\u0443\u0441\u0430\u043c \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u0430\u0434\u0434\u0430\u043b\u0456 \u0441\u0432\u043e\u0439 \u0434\u0443\u0445 \u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u043b\u0456: \u00ab\u0417\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f!\u00bb (\u042f\u043d 19, 30).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0444 2, 21-22\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0423 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435 \u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b \u0431\u0443\u0434\u044b\u043d\u0430\u043a \u0432\u044b\u0440\u0430\u0441\u0442\u0430\u0435 <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u044f\u043a \u0441\u0432\u044f\u0442\u0430\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u045e \u041f\u0430\u043d\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0423 \u0456\u043c \u0456 \u0432\u044b \u0440\u0430\u0437\u0430\u043c \u0431\u0443\u0434\u0443\u0435\u0446\u0435\u0441\u044f, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0436\u044b\u043b\u043b\u0451\u043c \u0411\u043e\u0433\u0430 \u045e \u0414\u0443\u0445\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u042f\u043a.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"776","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 329, 1-2: PL 38, 1454-1455)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0430\u043f\u043b\u0430\u0447\u0430\u043d\u0430 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u044e \u0425\u0440\u044b\u0441\u0442\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0441\u0432\u044f\u0442\u044b\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u043c\u0456 \u045e \u043a\u043e\u0436\u043d\u0430\u0439 \u043c\u044f\u0441\u0446\u0456\u043d\u0435 \u043a\u0432\u0456\u0442\u043d\u0435\u0435 \u041a\u0430\u0441\u0446\u0451\u043b, \u043c\u044b \u0431\u0430\u0447\u043d\u0430 \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0435\u043c\u0441\u044f \u045e \u0441\u043b\u0443\u0448\u043d\u0430\u0441\u0446\u0456 \u0441\u043f\u044f\u0432\u0430\u043d\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e: \u00ab\u041a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u0445\u00bb (\u041f\u0441 116&nbsp;[115], 15). \u0411\u043e \u044f\u043d\u0430 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u0456 \u045e \u043d\u0430\u0448\u044b\u0445 \u0432\u0430\u0447\u0430\u0445, \u0456 \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0442\u0430\u0433\u043e, \u0434\u0437\u0435\u043b\u044f \u043a\u0430\u0433\u043e \u044f\u043d\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f. \u0410\u043b\u0435 \u043f\u043b\u0430\u0442\u0430\u044e \u0437\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0456\u0445 \u0443\u0441\u0456\u0445 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0410\u0434\u043d\u0430\u0433\u043e. \u0421\u043c\u0435\u0440\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u0445 \u043d\u0430\u0431\u044b\u045e, \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b, \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u043a\u0430\u043b\u0456 \u0431 \u0401\u043d \u043d\u0435 \u043f\u0430\u043c\u0451\u0440, \u0442\u043e \u043f\u0448\u0430\u043d\u0456\u0447\u043d\u0430\u0435 \u0437\u0435\u0440\u043d\u0435 \u043d\u0435 \u043f\u0440\u0430\u0440\u0430\u0441\u043b\u043e \u0431. \u0412\u044b \u0447\u0443\u043b\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u044f \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0431\u043b\u0456\u0436\u044d\u043d\u043d\u0435\u043c \u043c\u0443\u043a\u0456, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f: \u00ab\u041a\u0430\u043b\u0456 \u043f\u0448\u0430\u043d\u0456\u0447\u043d\u0430\u0435 \u0437\u0435\u0440\u043d\u0435, \u0443\u043f\u0430\u045e\u0448\u044b \u045e \u0437\u044f\u043c\u043b\u044e, \u043d\u0435 \u043f\u0430\u043c\u0440\u044d, \u0442\u043e \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0430\u0434\u043d\u043e, \u0430 \u043a\u0430\u043b\u0456 \u043f\u0430\u043c\u0440\u044d, \u0442\u043e \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0431\u0430\u0433\u0430\u0442\u044b \u043f\u043b\u0451\u043d\u00bb (\u042f\u043d 12, 26).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u0430\u0431\u043c\u0435\u043d; \u0442\u0430\u043c \u0431\u044b\u043b\u0430 \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u0430 \u0437 \u043f\u043b\u0430\u0442\u0430\u0439 \u0437\u0430 \u043d\u0430\u0441; \u043a\u0430\u043b\u0456 \u0434\u0437\u0456\u0434\u0430 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0430 \u0430\u0434\u043a\u0440\u044b\u043b\u0430 \u042f\u0433\u043e\u043d\u044b \u0431\u043e\u043a, \u0430\u0434\u0442\u0443\u043b\u044c \u0432\u044b\u043f\u043b\u044b\u043b\u0430 \u043d\u0430 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435. \u0422\u0430\u043a \u0431\u044b\u043b\u0456 \u043d\u0430\u0431\u044b\u0442\u044b\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456 \u0456 \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u044b. \u0412\u0435\u0440\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0431\u044b\u043b\u0430 \u0434\u0430\u043a\u0430\u0437\u0430\u043d\u0430: \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043a\u0440\u043e\u045e. \u042f\u043d\u044b \u0430\u0434\u0434\u0430\u043b\u0456 \u0442\u043e\u0435, \u0447\u044b\u043c \u0431\u044b\u043b\u0456 \u0430\u0434\u043e\u0440\u0430\u043d\u044b\u044f, \u0456 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0456 \u0441\u043b\u043e\u0432\u044b \u0441\u0432. \u042f\u043d\u0430: \u00ab\u0401\u043d \u0430\u0434\u0434\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451. \u0406 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0431\u0440\u0430\u0442\u043e\u045e\u00bb (1 \u042f\u043d 3, 16).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: \u00ab\u041a\u0430\u043b\u0456 \u0442\u044b \u0441\u044f\u0434\u0437\u0435\u0448 \u0437\u0430 \u0431\u0430\u0433\u0430\u0442\u044b \u0441\u0442\u043e\u043b, \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0433\u043b\u044f\u0434\u0437\u0456, \u0448\u0442\u043e \u0441\u0442\u0430\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0442\u0430\u0431\u043e\u044e, \u0431\u043e \u0456 \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u0446\u044c\u00bb (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 23, 1-2). \u042f\u043a\u0456 \u0436 \u0433\u044d\u0442\u0430 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b \u0441\u0442\u043e\u043b, \u0437\u0430 \u044f\u043a\u0456\u043c \u0441\u0430\u043c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0435\u0436\u0430\u0439. \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0434\u0434\u0430\u0435 \u0441\u044f\u0431\u0435 \u044f\u043a \u0435\u0436\u0443; \u0442\u0430\u043a \u0440\u043e\u0431\u0456\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d. \u0401\u043d \u0441\u0430\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u0430\u043f\u0440\u0430\u0448\u0430\u0435, \u0401\u043d \u0441\u0430\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0435\u0436\u0430\u0439 \u0456 \u043d\u0430\u043f\u043e\u0435\u043c. \u041c\u0443\u0447\u0430\u043d\u0456\u043a\u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456, \u0448\u0442\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043b\u0456 \u0456 \u043f\u0456\u043b\u0456, \u0431\u043e \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u043b\u0456 \u0442\u044b\u043c \u0436\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u044f\u043a \u0431\u044b \u043c\u0430\u0433\u043b\u0456 \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c, \u043a\u0430\u043b\u0456 \u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u0430\u043f\u043b\u0430\u0446\u0456\u045e \u043f\u0435\u0440\u0448\u044b\u043c, \u043d\u0435 \u0434\u0430\u045e \u0456\u043c \u0442\u043e\u0435, \u0447\u044b\u043c \u044f\u043d\u044b \u0437\u043c\u0430\u0433\u043b\u0456 \u0431 \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c? \u00ab\u0427\u044b\u043c \u0430\u0434\u0434\u0437\u044f\u0447\u0443 \u044f \u041f\u0430\u043d\u0443 \u0437\u0430 \u045e\u0441\u0435 \u042f\u0433\u043e \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u0434\u043b\u044f \u043c\u044f\u043d\u0435? \u041a\u0435\u043b\u0456\u0445 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0437\u043d\u0456\u043c\u0443\u00bb (\u041f\u0441 116&nbsp;[115], 12-13). \u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0430 \u043a\u0435\u043b\u0456\u0445? \u0417\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0456\u043c \u0433\u043e\u0440\u043a\u0456, \u0430\u043b\u0435 \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u044b \u043a\u0435\u043b\u0456\u0445 \u043c\u0443\u043a\u0456: \u043a\u0435\u043b\u0456\u0445, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u0445\u0432\u043e\u0440\u044b \u0431\u0430\u044f\u045e\u0441\u044f \u0431 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0431 \u0440\u0430\u043d\u0435\u0439 \u044f\u0433\u043e \u043d\u0435 \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u045e \u043b\u0435\u043a\u0430\u0440. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u044b \u043a\u0435\u043b\u0456\u0445 \u043c\u044b \u0447\u0443\u0435\u043c \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430: \u00ab\u041e\u0439\u0447\u0430 \u041c\u043e\u0439, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043d\u044f\u0445\u0430\u0439 \u0430\u0431\u043c\u0456\u043d\u0435 \u0433\u044d\u0442\u044b \u043a\u0435\u043b\u0456\u0445 \u041c\u044f\u043d\u0435\u00bb (\u041c\u0446 26, 39). \u041f\u0440\u0430 \u0433\u044d\u0442\u044b \u0436 \u043a\u0435\u043b\u0456\u0445 \u043a\u0430\u0437\u0430\u043b\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456: \u00ab\u041a\u0435\u043b\u0456\u0445 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0437\u043d\u0456\u043c\u0443 \u0456 \u0431\u0443\u0434\u0443 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0456\u043c\u044f \u041f\u0430\u043d\u0430\u00bb (\u041f\u0441 116 [115], 13).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u0446\u0456 \u043d\u0435 \u0431\u0430\u0456\u0448\u0441\u044f \u0442\u044b, \u0448\u0442\u043e \u043f\u0430\u0434\u0432\u044f\u0434\u0437\u0435\u0448? \u041d\u0435 \u043f\u0430\u0434\u0432\u044f\u0434\u0443, \u2013 \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435. \u0410 \u0447\u0430\u043c\u0443? \u0411\u043e \u00ab\u0431\u0443\u0434\u0443 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0456\u043c\u044f \u041f\u0430\u043d\u0430\u00bb. \u042f\u043a \u0436\u0430 \u043c\u0430\u0433\u043b\u0456 \u0431 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0446\u044c \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u045e \u0443 \u0456\u0445 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0430\u0434\u0432\u0430\u0436\u043d\u044b\u043c\u0456: \u042f \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0441\u0432\u0435\u0442\u00bb (\u042f\u043d 16, 33). \u0421\u0430\u043c \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u043d\u0435\u0431\u0430 \u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0456\u0445 \u0434\u0443\u043c\u043a\u0430\u043c\u0456 \u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u043f\u0440\u0430\u0437 \u0456\u0445 \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0441\u0430\u0442\u0430\u043d\u0443 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0430 \u045e \u043d\u0435\u0431\u0435 \u0434\u0430\u045e \u0456\u043c \u0432\u044f\u043d\u043e\u043a \u0445\u0432\u0430\u043b\u044b. \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f, \u0445\u0442\u043e \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0432\u044b\u043f\u0456\u045e \u043a\u0435\u043b\u0456\u0445. \u0426\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u043f\u0440\u0430\u0439\u0448\u043b\u0456, \u0456 \u043d\u0430\u0441\u0442\u0430\u045e \u0447\u0430\u0441 \u0445\u0432\u0430\u043b\u044b.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u042d\u0444 4, 4. 5\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u0432\u044f\u0442\u044b\u044f \u043c\u0443\u0436\u044b \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430 \u043f\u0440\u0430\u043b\u0456\u043b\u0456 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u042f\u0433\u043e \u045e\u0441\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u0456 \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u043b\u0456\u0441\u044f \u0434\u0430 \u042f\u0433\u043e \u045e \u0441\u043c\u0435\u0440\u0446\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0442\u0430\u043c\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0432\u044f\u043d\u043e\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f\u043d\u044b \u043c\u0435\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445 \u0456 \u0430\u0434\u043d\u0443 \u0432\u0435\u0440\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043c\u0443.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"777","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0412\u0456\u043d\u0446\u044d\u043d\u0442\u0430 \u0434\u044d \u041f\u043e\u043b\u044f, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cf. Correspondance, Entretiens, Documents, ed. P. Coste Paris 1920-1925, passim)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u045e\u0431\u043e\u0433\u0456\u043c&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0446\u044d\u043d\u044c\u0432\u0430\u0446\u044c \u0443\u0431\u043e\u0433\u0456\u0445 \u043f\u0430 \u0456\u0445 \u0432\u043e\u043f\u0440\u0430\u0442\u0446\u044b, \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0446\u0456 \u043f\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u0445 \u044f\u043a\u0430\u0441\u0446\u044f\u0445, \u044f\u043a\u0456\u044f, \u044f\u043a \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u044f\u043d\u044b \u043c\u0430\u044e\u0446\u044c, \u0431\u043e \u043d\u0430\u0439\u0447\u0430\u0441\u0446\u0435\u0439 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u043d\u0435\u0430\u0434\u0443\u043a\u0430\u0432\u0430\u043d\u044b\u043c\u0456 \u0456 \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0456. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u0456\u0445 \u0443 \u0441\u0432\u044f\u0442\u043b\u0435 \u0432\u0435\u0440\u044b, \u0442\u0430\u0434\u044b \u045e\u0431\u0430\u0447\u044b\u0446\u0435, \u0448\u0442\u043e \u044f\u043d\u044b \u0437\u0430\u043c\u044f\u043d\u044f\u044e\u0446\u044c \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0431\u044b\u0446\u044c \u0443\u0431\u043e\u0433\u0456\u043c. \u0423 \u0447\u0430\u0441 \u0441\u0432\u0430\u0451\u0439 \u043c\u0443\u043a\u0456 \u0401\u043d \u0430\u043c\u0430\u043b\u044c \u043d\u0435 \u043c\u0435\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0432\u044b\u0433\u043b\u044f\u0434\u0443. \u042f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c \u0437\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0448\u0430\u043b\u0451\u043d\u044b\u043c, \u0434\u043b\u044f \u0433\u0430\u0431\u0440\u044d\u044f\u045e \u0431\u044b\u045e \u043a\u0430\u043c\u0435\u043d\u0435\u043c \u0441\u043f\u0430\u0442\u044b\u043a\u043d\u0435\u043d\u043d\u044f, \u0430\u043b\u0435 \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0433\u044d\u0442\u0430 \u043d\u0430\u0437\u0432\u0430\u045e \u0441\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456 \u0432\u0435\u0441\u0442\u0443\u043d\u043e\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0434\u043b\u044f \u045e\u0431\u043e\u0433\u0456\u0445: \u00ab\u041f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0414\u043e\u0431\u0440\u0443\u044e \u041d\u0430\u0432\u0456\u043d\u0443 \u045e\u0431\u043e\u0433\u0456\u043c\u00bb (\u041b\u043a 4, 18). \u0412\u043e\u0441\u044c \u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043c\u0435\u0446\u044c \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0451 \u0456 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u0430: \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u045e\u0431\u043e\u0433\u0456\u0445, \u0441\u0443\u0446\u044f\u0448\u0430\u0446\u044c \u0456\u0445 \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0445\u0430\u0446\u0435\u045e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u045e\u0431\u043e\u0433\u0456\u043c. \u0411\u043e\u0433, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043b\u044e\u0431\u0456\u0446\u044c \u0443\u0431\u043e\u0433\u0456\u0445, \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0456\u0445 \u043b\u044e\u0431\u0456\u0446\u044c. \u0406 \u043c\u044b \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043b\u044e\u0431\u0456\u043c \u0443\u0431\u043e\u0433\u0456\u0445, \u0442\u043e \u043d\u0430\u0441 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433. \u0422\u0430\u043c\u0443, \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u044e\u0447\u044b \u0456\u0445, \u043c\u044b \u0441\u0442\u0430\u0440\u0430\u0435\u043c\u0441\u044f \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0443\u0431\u043e\u0433\u0456\u0445 \u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u0445 \u0456 \u0442\u0430\u043a \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456, \u043a\u0430\u0431 \u0430\u0434\u0447\u0443\u0446\u044c \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435, \u0448\u0442\u043e \u0430\u0434\u0447\u0443\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u043a\u0430\u043b\u0456 \u043a\u0430\u0437\u0430\u045e: \u00ab\u0414\u043b\u044f \u045e\u0441\u0456\u0445 \u044f \u0441\u0442\u0430\u045e \u0443\u0441\u0456\u043c\u00bb (1 \u041a\u0430\u0440 9, 22). \u041f\u043e\u045e\u043d\u044b\u044f \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u044f \u0434\u0430 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u045e \u0456 \u0441\u043c\u0443\u0442\u043a\u0443 \u0431\u043b\u0456\u0436\u043d\u0456\u0445, \u043f\u0440\u043e\u0441\u0456\u043c \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0430\u0434\u0430\u0440\u044b\u045e \u043d\u0430\u0441 \u043f\u0430\u0447\u0443\u0446\u0446\u0451\u043c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0456 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u0441\u0446\u0456, \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0456\u043c \u043d\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u0456\u0445 \u0442\u0430\u043a\u0456\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0421\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u045e\u0431\u043e\u0433\u0456\u043c \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0441\u0442\u0430\u0432\u0456\u0446\u0446\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u0456\u043d\u0448\u0443\u044e \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u044c \u0456 \u043d\u0435\u0430\u0434\u043a\u043b\u0430\u0434\u043d\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u0446\u0430. \u041a\u0430\u043b\u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0434\u0430\u0446\u044c \u043b\u0435\u043a\u0456 \u0446\u0456 \u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0456\u043d\u0448\u0443\u044e \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u0430\u043c\u0443, \u0456\u0434\u0437\u0456\u0446\u0435 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430, \u0430\u0445\u0432\u044f\u0440\u0443\u044e\u0447\u044b \u0411\u043e\u0433\u0443 \u0441\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0447\u044b\u043d, \u044f\u043a \u0431\u044b\u0446\u0446\u0430\u043c \u0432\u044b \u0442\u0440\u044b\u0432\u0430\u043b\u0456 \u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0435. \u041d\u044f\u0445\u0430\u0439 \u0434\u0443\u0445 \u0432\u0430\u0448 \u043d\u0435 \u0442\u0443\u0440\u0431\u0443\u0435\u0446\u0446\u0430 \u0456 \u043d\u0435 \u0434\u0430\u043a\u0430\u0440\u0430\u0439\u0446\u0435 \u0441\u044f\u0431\u0435 \u0437\u0430 \u0433\u0440\u044d\u0445, \u0431\u043e \u0432\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u043f\u0430\u0441\u043b\u0443\u0433\u0443 \u0434\u043b\u044f \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u0430\u0433\u0430. \u0411\u043e\u0433 \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u043f\u0430\u043a\u0456\u0434\u0430\u0435\u0446\u0435 \u042f\u0433\u043e \u0434\u0437\u0435\u043b\u044f \u042f\u0433\u043e \u0436 \u0441\u0430\u043c\u043e\u0433\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043a\u0430\u043b\u0456 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0430\u0434\u043d\u0443 \u0441\u043f\u0440\u0430\u0432\u0443 \u0411\u043e\u0433\u0430, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0456\u043d\u0448\u044b\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0432\u044b \u043f\u0430\u043a\u0456\u0434\u0430\u0435\u0446\u0435 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u0430\u043c\u0443, \u043f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u0432\u044b \u0441\u043b\u0443\u0436\u044b\u0446\u0435 \u0441\u0430\u043c\u043e\u043c\u0443 \u0411\u043e\u0433\u0443. \u0411\u043e \u043b\u044e\u0431\u043e\u045e \u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0430\u044f \u0437\u0430 \u045e\u0441\u0435 \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u043d\u0456. \u0414\u0430\u0440\u044d\u0447\u044b, \u0443\u0441\u0435 \u043f\u0440\u0430\u0434\u043f\u0456\u0441\u0430\u043d\u043d\u0456 \u0456\u0441\u043d\u0443\u044e\u0446\u044c \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u043b\u044e\u0431\u043e\u0432\u0456. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043b\u044e\u0431\u043e\u045e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c, \u0443\u0441\u0451, \u0448\u0442\u043e \u044f\u043d\u0430 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435, \u0442\u0440\u044d\u0431\u0430 \u0441\u043f\u0430\u045e\u043d\u044f\u0446\u044c. \u0417 \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u0441\u044d\u0440\u0446\u0430 \u043c\u044b \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0435\u043c \u0441\u044f\u0431\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044e \u045e\u0431\u043e\u0433\u0456\u043c; \u0431\u0443\u0434\u0437\u0435\u043c \u0448\u0443\u043a\u0430\u0446\u044c \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u0445, \u0431\u043e \u044f\u043d\u044b \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b \u043d\u0430\u0434 \u043d\u0430\u043c\u0456 \u044f\u043a \u043d\u0430\u0448\u044b\u044f \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u044b \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u041a\u0430\u0440 9, 19\u0430. 22; \u0401\u045e 29, 15-16\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u0443\u0434\u0443\u0447\u044b \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c \u0430\u0434 \u0443\u0441\u0456\u0445, \u044f \u0441\u0442\u0430\u045e \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0443\u0441\u0456\u0445. \u0414\u043b\u044f \u043d\u044f\u0434\u0443\u0436\u044b\u0445 \u044f \u0441\u0442\u0430\u045e \u044f\u043a \u043d\u044f\u0434\u0443\u0436\u044b, \u043a\u0430\u0431 \u0437\u0434\u0430\u0431\u044b\u0446\u044c \u043d\u044f\u0434\u0443\u0436\u044b\u0445. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0414\u043b\u044f \u045e\u0441\u0456\u0445 \u044f \u0441\u0442\u0430\u045e \u0443\u0441\u0456\u043c, \u043a\u0430\u0431 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u0431\u044b\u045e \u0432\u0430\u0447\u0430\u043c\u0456 \u0434\u043b\u044f \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u0430\u0433\u0430, \u043d\u0430\u0433\u0430\u043c\u0456 \u0434\u043b\u044f \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u0430\u0433\u0430, \u0431\u044b\u045e \u0430\u0439\u0446\u043e\u043c \u0434\u043b\u044f \u045e\u0431\u043e\u0433\u0456\u0445.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0414\u043b\u044f \u045e\u0441\u0456\u0445.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"778","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041f\u0435\u0440\u0448\u0430\u044f \u0441\u0442\u0430\u0440\u0430\u0441\u043b\u0430\u0432\u044f\u043d\u0441\u043a\u0430\u044f \u043b\u0435\u0433\u0435\u043d\u0434\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Edit. M. Weingart, Prag\u00e6 1934, 974-983)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u0430\u0440\u043e\u043b\u044c, \u044f\u043a\u0456 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0434\u0430 \u045e\u0431\u043e\u0433\u0456\u0445, \u0443\u043c\u0430\u0446\u0443\u0435 \u0441\u0432\u043e\u0439 \u0442\u0440\u043e\u043d \u043d\u0430\u0432\u0435\u043a\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u0412\u0440\u0430\u0442\u044b\u0441\u043b\u0430\u0432\u0430 \u0447\u044d\u0445\u0456 \u0432\u044b\u0431\u0440\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430\u043c \u044f\u0433\u043e \u0441\u044b\u043d\u0430 \u0412\u0430\u0446\u043b\u0430\u0432\u0430. \u041f\u0440\u0430\u0437 \u0411\u043e\u0436\u0443\u044e \u043b\u0430\u0441\u043a\u0443 \u0431\u044b\u045e \u0451\u043d \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0443 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u0456 \u0432\u0435\u0440\u044b. \u041f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u0443\u0441\u0456\u0445 \u0443\u0431\u043e\u0433\u0456\u0445, \u0430\u043f\u0440\u0430\u043d\u0430\u045e, \u043a\u0430\u0440\u043c\u0456\u045e \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u0445, \u043f\u0440\u044b\u043c\u0430\u045e \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u043a\u0430\u045e \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043d\u0430\u043a\u0430\u0437\u0430\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f. \u041d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u045e \u043a\u0440\u044b\u045e\u0434\u0437\u0456\u0446\u044c \u0443\u0434\u043e\u0432\u0430\u045e, \u043b\u044e\u0431\u0456\u045e \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0431\u0435\u0434\u043d\u044b\u0445 \u0456 \u0431\u0430\u0433\u0430\u0442\u044b\u0445. \u041f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u0411\u043e\u0436\u044b\u0445 \u0441\u043b\u0443\u0433\u0430\u045e, \u0443\u043b\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u045e \u043a\u0430\u0441\u0446\u0451\u043b\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0447\u044d\u0445\u0456 \u045e\u0437\u0431\u0443\u043d\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0456 \u043f\u0430\u0434\u0431\u0443\u0445\u0442\u043e\u0440\u044b\u043b\u0456 \u043c\u0430\u043b\u043e\u0434\u0448\u0430\u0433\u0430 \u0431\u0440\u0430\u0442\u0430 \u0411\u0430\u043b\u044f\u0441\u043b\u0430\u0432\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0411\u0440\u0430\u0442 \u0412\u0430\u0446\u043b\u0430\u045e \u0445\u043e\u0447\u0430 \u0437\u0430\u0431\u0456\u0446\u044c \u0446\u044f\u0431\u0435, \u0437\u043c\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u043c\u0430\u0446\u0456 \u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0430\u0434\u0431\u044b\u0432\u0430\u043b\u0456\u0441\u044f \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f \u043a\u0430\u0441\u0446\u0451\u043b\u0430\u045e \u0443 \u0440\u043e\u0437\u043d\u044b\u0445 \u0433\u0430\u0440\u0430\u0434\u0430\u0445, \u0412\u0430\u0446\u043b\u0430\u045e \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u045e \u0443\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u043c\u044f\u0441\u0446\u0456\u043d\u044b. \u0423 \u043d\u044f\u0434\u0437\u0435\u043b\u044e, \u0432\u0430 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u041a\u043e\u0441\u043c\u044b \u0456 \u0414\u0430\u043c\u2019\u044f\u043d\u0430, \u043f\u0440\u044b\u0431\u044b\u045e \u0443 \u0433\u043e\u0440\u0430\u0434 \u0411\u0430\u043b\u044f\u0441\u043b\u0430\u0432\u0430. \u041f\u0430\u0441\u043b\u044f \u0441\u0432. \u0406\u043c\u0448\u044b \u0445\u0430\u0446\u0435\u045e \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u045e \u041f\u0440\u0430\u0433\u0443. \u0410\u0434\u043d\u0430\u043a \u0411\u0430\u043b\u044f\u0441\u043b\u0430\u045e \u0437\u0430\u0434\u0443\u043c\u0430\u045e \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430 \u0456 \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u045e \u044f\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c\u0456: \u00ab\u0427\u0430\u043c\u0443 \u0442\u044b \u043d\u0430\u0441 \u043f\u0430\u043a\u0456\u0434\u0430\u0435\u0448, \u0431\u0440\u0430\u0442?\u00bb \u041d\u0430\u0437\u0430\u045e\u0442\u0440\u0430 \u0440\u0430\u043d\u0456\u0446\u0430\u0439 \u043f\u0430\u0437\u0432\u0430\u043d\u0456\u043b\u0456 \u043d\u0430 \u042e\u0442\u0440\u0430\u043d\u044c. \u041f\u0430\u0447\u0443\u045e\u0448\u044b \u0433\u043e\u043b\u0430\u0441 \u0437\u0432\u0430\u043d\u043e\u045e, \u0412\u0430\u0446\u043b\u0430\u045e \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0411\u0443\u0434\u0437\u044c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b, \u041f\u0430\u043d\u0435, \u044f\u043a\u0456 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u043c\u043d\u0435 \u0434\u0430\u0436\u044b\u0446\u044c \u0430\u0436 \u0434\u0430 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0439 \u0440\u0430\u043d\u0456\u0446\u044b\u00bb. \u0423\u0441\u0442\u0430\u045e \u0456 \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u045e\u0441\u044f \u043d\u0430 \u0440\u0430\u043d\u0456\u0448\u043d\u044e\u044e \u043c\u0430\u043b\u0456\u0442\u0432\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u0440\u0430\u0437\u0443 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0411\u0430\u043b\u044f\u0441\u043b\u0430\u045e \u043f\u0430\u0434\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u044f\u0433\u043e \u043b\u044f \u0434\u0437\u0432\u044f\u0440\u044d\u0439. \u0412\u0430\u0446\u043b\u0430\u045e, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u044f\u0433\u043e, \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0411\u0440\u0430\u0442, \u0442\u044b \u045e\u0447\u043e\u0440\u0430 \u0431\u044b\u045e \u0434\u043e\u0431\u0440\u044b\u043c \u0434\u043b\u044f \u043d\u0430\u0441\u00bb. \u0410\u0434\u043d\u0430\u043a \u0441\u0430\u0442\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u043f\u0442\u0430\u045e \u0411\u0430\u043b\u044f\u0441\u043b\u0430\u0432\u0443, \u0437\u0440\u0430\u0431\u0456\u045e \u043b\u0456\u0445\u0456\u043c \u044f\u0433\u043e\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0456 \u0451\u043d, \u0432\u044b\u0446\u044f\u0433\u043d\u0443\u045e\u0448\u044b \u043c\u0435\u0447, \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0426\u044f\u043f\u0435\u0440 \u0436\u0430\u0434\u0430\u044e \u0431\u044b\u0446\u044c \u044f\u0448\u0447\u044d \u043b\u0435\u043f\u0448\u044b\u043c\u00bb. \u0421\u043a\u0430\u0437\u0430\u045e\u0448\u044b \u0433\u044d\u0442\u0430, \u0443\u0434\u0430\u0440\u044b\u045e \u044f\u0433\u043e \u043c\u0435\u0447\u0430\u043c \u043f\u0430 \u0433\u0430\u043b\u0430\u0432\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0430\u0446\u043b\u0430\u045e, \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u0434\u0430 \u044f\u0433\u043e, \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0428\u0442\u043e \u0442\u044b \u0440\u043e\u0431\u0456\u0448, \u0431\u0440\u0430\u0442?\u00bb \u0406 \u0441\u0445\u0430\u043f\u0456\u045e\u0448\u044b \u044f\u0433\u043e, \u043a\u0456\u043d\u0443\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e. \u0422\u0443\u0442 \u0436\u0430 \u043f\u0430\u0434\u0431\u0435\u0433 \u0430\u0434\u0437\u0456\u043d \u0437 \u0441\u0430\u044e\u0437\u043d\u0456\u043a\u0430\u045e \u0411\u0430\u043b\u044f\u0441\u043b\u0430\u0432\u0430 \u0456 \u043f\u0430\u0440\u0430\u043d\u0456\u045e \u0440\u0443\u043a\u0443 \u0412\u0430\u0446\u043b\u0430\u0432\u0430. \u0422\u043e\u0439, \u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0431\u0440\u0430\u0442\u0430, \u0437 \u043f\u0430\u0440\u0430\u043d\u0435\u043d\u0430\u0439 \u0440\u0443\u043a\u043e\u044e \u045e\u0446\u0451\u043a \u0443 \u043a\u0430\u0441\u0446\u0451\u043b. \u0423 \u0434\u0437\u0432\u044f\u0440\u0430\u0445 \u043a\u0430\u0441\u0446\u0451\u043b\u0430 \u0437\u0430\u0431\u0456\u043b\u0456 \u044f\u0433\u043e \u0434\u0432\u043e\u0435 \u0437\u043b\u0430\u043c\u044b\u0441\u043d\u0456\u043a\u0430\u045e. \u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0431\u0435\u0433 \u0442\u0440\u044d\u0446\u0456, \u0442\u043e \u043f\u0440\u0430\u0431\u0456\u045e \u044f\u043c\u0443 \u0431\u043e\u043a. \u0422\u0430\u0434\u044b \u0412\u0430\u0446\u043b\u0430\u045e \u0432\u044b\u043f\u0443\u0441\u0446\u0456\u045e \u0430\u043f\u043e\u0448\u043d\u044f\u0435 \u0434\u044b\u0445\u0430\u043d\u043d\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0423 \u0440\u0443\u043a\u0456 \u0422\u0432\u0430\u0435, \u041f\u0430\u043d\u0435, \u0430\u0434\u0434\u0430\u044e \u044f \u0434\u0443\u0445 \u043c\u043e\u0439\u00bb (\u041f\u0441 31 [30], 6).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440.<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\">\u041e\u0441 14, 6; \u043f\u0430\u0440. \u041f\u0441 92 (91), 13\u0430. 14\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0440\u0430\u0441\u043a\u0432\u0456\u0442\u043d\u0435\u0435, \u044f\u043a \u043b\u0456\u043b\u0435\u044f. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u043a\u0432\u0456\u0442\u043d\u0435\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u041f\u0430\u0441\u0430\u0434\u0436\u0430\u043d\u044b\u044f \u045e \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430, \u044f\u043d\u044b \u0437\u0430\u043a\u0432\u0456\u0442\u043d\u0435\u044e\u0446\u044c \u043d\u0430 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u0430\u0445 \u043d\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417\u0430\u045e\u0441\u0451\u0434\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"779","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0441\u0432. \u042f\u043d\u0430 \u041f\u0430\u045e\u043b\u0430 \u0406\u0406, \u043f\u0430\u043f\u044b, \u043f\u0430\u0434\u0447\u0430\u0441 \u0431\u0435\u0430\u0442\u044b\u0444\u0456\u043a\u0430\u0446\u044b\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(AAS 73, 1981, 340-342)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u042f\u043d\u044b \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0447\u044b\u043d \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u044f \u0456 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430, \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0456\u043c \u0410\u0439\u0446\u043e\u043c \u0443 \u043d\u0435\u0431\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u044b\u0437\u043d\u0430\u045e \u0456\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0432\u044b\u0437\u043d\u0430\u043b\u0456 \u042f\u0433\u043e \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u0456\u043c\u043d \u0445\u0432\u0430\u043b\u044b, \u044f\u043a\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u0442\u043e \u043f\u0440\u0430\u0441\u043f\u044f\u0432\u0430\u045e \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b \u043d\u0430\u0442\u043e\u045e\u043f, \u043d\u0456\u0431\u044b \u0440\u044d\u0445\u0430 \u0433\u0456\u043c\u043d\u0430 \u00abTe Deum\u00bb, \u044f\u043a\u0456 \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u045e \u043a\u0430\u0441\u0446\u0451\u043b\u0435 \u0441\u0432. \u0414\u0430\u043c\u2019\u044f\u043d\u0430 \u0432\u0435\u0447\u0430\u0440\u0430\u043c, 27 \u0441\u043d\u0435\u0436\u043d\u044f 1637 \u0433\u043e\u0434\u0430, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0432\u0435\u0441\u0442\u043a\u0430 \u043f\u0440\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0448\u044d\u0441\u0446\u044f\u0440\u044b\u0445 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e \u0437 \u041d\u0430\u0433\u0430\u0441\u0430\u043a\u0456. \u0421\u044f\u0440\u043e\u0434 \u0456\u0445 \u0431\u044b\u043b\u0456: \u043d\u0430\u0441\u0442\u0430\u044f\u0446\u0435\u043b\u044c \u043c\u0456\u0441\u0456\u0456 \u0430\u0439\u0446\u0435\u0446 \u0410\u043d\u0442\u043e\u043d\u0456\u0439 \u0413\u0430\u043d\u0441\u0430\u043b\u0435\u0441, \u0456\u0441\u043f\u0430\u043d\u0441\u043a\u0456 \u0434\u0430\u043c\u0456\u043d\u0456\u043a\u0430\u043d\u0456\u043d \u0437 \u0414\u044d\u0451\u043d\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u041b\u0430\u045e\u0440\u044d\u043d\u0446\u0456\u0439 \u0420\u0443\u0456\u0441, \u0430\u0439\u0446\u0435\u0446 \u0441\u044f\u043c\u2019\u0456, \u0448\u0442\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0437 \u041c\u0430\u043d\u0456\u043b\u044b, \u0437 \u043f\u0440\u0430\u0434\u043c\u0435\u0441\u0446\u044f \u0411\u0456\u043d\u043e\u043d\u0434\u0430. \u0413\u044d\u0442\u044b\u044f \u0441\u0432\u0435\u0434\u043a\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u043f\u0441\u0430\u043b\u044c\u043c\u044b \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u043c\u0443 \u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u043c\u0443 \u0411\u043e\u0433\u0443, \u043a\u0430\u043b\u0456 \u0456\u0445 \u0437\u043d\u044f\u0432\u043e\u043b\u0456\u043b\u0456 \u0456 \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u043f\u0440\u044b\u043c\u0430\u043b\u0456 \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0430\u0441\u043b\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u0442\u0440\u044b\u0432\u0430\u043b\u0430 \u0442\u0440\u044b \u0434\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0435\u0440\u0430 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435 \u0441\u0432\u0435\u0442. \u0410\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u0435 \u0432\u0435\u0440\u044b, \u044f\u043a \u0441\u043e\u043d\u0446\u0430, \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0443. \u0425\u043e\u0446\u044c \u0451\u0441\u0446\u044c \u0440\u043e\u0437\u043d\u044b\u044f \u043c\u043e\u0432\u044b \u043d\u0430 \u0441\u0432\u0435\u0446\u0435, \u0456\u0441\u043d\u0443\u0435 \u0430\u0434\u043d\u0430 \u0456 \u0442\u0430\u044f \u0436 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u044f \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u044f. \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e, \u0437\u0431\u0456\u0440\u0430\u044e\u0447\u044b \u0456\u0445 \u0437 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f, \u043c\u043e\u0432\u044b, \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u043f\u043b\u0435\u043c\u0435\u043d\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0434\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0430\u0441\u043d\u0430\u0446\u0446\u0430\u0446\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0447\u044b \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0443\u044e \u043f\u0430\u0441\u043b\u0443\u0433\u0443, \u044f\u043a\u0430\u044f \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u0445\u0440\u043e\u0441\u0442\u0443 \u0430\u0431\u043e \u0437 \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f, \u0430\u0436\u044b\u0446\u0446\u044f\u0432\u0456\u043b\u0456 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u044b \u0430\u043a\u0442 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u044f \u0456 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0411\u043e\u0433\u0430, \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0447\u044b \u0430\u0445\u0432\u044f\u0440\u0443 \u0437 \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0456, \u0441\u043f\u0430\u043b\u0443\u0447\u0430\u043d\u0443\u044e \u0437 \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b, \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0447\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u0456 \u0430\u0445\u0432\u044f\u0440\u0443, \u0441\u0430\u043c\u044b\u043c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0447\u044b\u043d\u0430\u043c, \u044f\u043a\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0436\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a. \u0411\u044b\u045e \u0433\u044d\u0442\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u043a\u0442 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e. \u041c\u044b \u045e\u0441\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0437\u0430 \u0431\u0440\u0430\u0442\u043e\u045e \u043d\u0430 \u045e\u0437\u043e\u0440 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0437\u0430 \u043d\u0430\u0441.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u045e\u0447\u044b\u043d\u0456\u045e \u041b\u0430\u045e\u0440\u044d\u043d\u0446\u0456\u0439 \u0420\u0443\u0456\u0441. \u041a\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0434\u0430 \u043d\u0435\u0447\u0430\u043a\u0430\u043d\u0430\u0433\u0430 \u043a\u0430\u043d\u0446\u0430, \u043f\u0430\u0441\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430, \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0456, \u0432\u044b\u0437\u043d\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0441\u0443\u0434\u0434\u0437\u044f\u043c\u0456, \u0448\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430\u043c \u0456 \u043f\u0430\u043c\u0440\u044d \u0434\u043b\u044f \u0411\u043e\u0433\u0430: \u00ab\u042f \u0433\u0430\u0442\u043e\u0432\u044b \u0430\u0434\u0434\u0430\u0446\u044c \u0437\u0430 \u042f\u0433\u043e \u0436\u044b\u0446\u0446\u0451 \u0442\u044b\u0441\u044f\u0447\u0443 \u0440\u0430\u0437\u043e\u045e. \u041d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0432\u044b\u0440\u0430\u043a\u0443\u0441\u044f \u0432\u0435\u0440\u044b. \u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0446\u0435, \u043c\u043e\u0436\u0430\u0446\u0435 \u043c\u044f\u043d\u0435 \u0437\u0430\u0431\u0456\u0446\u044c. \u0425\u0430\u0447\u0443 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0437\u0430 \u0411\u043e\u0433\u0430\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u0430 \u044f\u0433\u043e \u0436\u044b\u0446\u0446\u0451, \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435 \u044f\u0433\u043e \u0432\u0435\u0440\u044b \u0456 \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u044f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u0456. \u0423 \u0433\u044d\u0442\u044b \u043c\u043e\u043c\u0430\u043d\u0442 \u043c\u0430\u043b\u0430\u0434\u044b \u0430\u0439\u0446\u0435\u0446 \u0441\u044f\u043c\u2019\u0456 \u0432\u044b\u0437\u043d\u0430\u045e \u0456 \u0441\u043f\u043e\u045e\u043d\u0456\u045e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0443\u044e \u043a\u0430\u0442\u044d\u0445\u0435\u0437\u0443, \u044f\u043a\u0443\u044e \u043f\u0440\u0430\u0439\u0448\u043e\u045e \u0443 \u0448\u043a\u043e\u043b\u0435 \u0434\u0430\u043c\u0456\u043d\u0456\u043a\u0430\u043d\u0430\u045e \u0443 \u0411\u0456\u043d\u043e\u043d\u0434\u0430. \u041a\u0430\u0442\u044d\u0445\u0435\u0437\u0443, \u0446\u044d\u043d\u0442\u0440\u0430\u043c \u044f\u043a\u043e\u0439 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0431\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u2013 \u044f\u0435 \u0437\u043c\u0435\u0441\u0442, \u0456 \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u0443\u0447\u044b\u0446\u044c \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0432\u0435\u0441\u0442\u0443\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u044b\u043a\u043b\u0430\u0434 \u041b\u0430\u045e\u0440\u044d\u043d\u0446\u0456\u044f \u0420\u0443\u0456\u0441\u0430, \u0441\u044b\u043d\u0430 \u043a\u0456\u0442\u0430\u0439\u0446\u0430 \u0456 \u043c\u0430\u043b\u0430\u0439\u043a\u0456, \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043d\u0430\u043c, \u0448\u0442\u043e \u045e\u0441\u0451 \u0436\u044b\u0446\u0446\u0451 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u043d\u0430\u0441 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u044b\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430\u043c \u2013 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u044f\u043a \u0430\u0434\u043a\u0430\u0437 \u043d\u0430 \u0434\u0430\u0440 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0430 \u0441\u0432\u0435\u0442, \u043a\u0430\u0431 \u0443\u0441\u0435 \u00ab\u043c\u0435\u043b\u0456 \u0436\u044b\u0446\u0446\u0451 \u0456 \u043c\u0435\u043b\u0456 \u045e \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u0443\u00bb (\u042f\u043d 10, 10).&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u042d\u0444 4, 4. 5\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u0432\u044f\u0442\u044b\u044f \u043c\u0443\u0436\u044b \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430 \u043f\u0440\u0430\u043b\u0456\u043b\u0456 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u042f\u0433\u043e \u045e\u0441\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u0456 \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u043b\u0456\u0441\u044f \u0434\u0430 \u042f\u0433\u043e \u045e \u0441\u043c\u0435\u0440\u0446\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0442\u0430\u043c\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0432\u044f\u043d\u0435\u0446 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f\u043d\u044b \u043c\u0435\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445 \u0456 \u0430\u0434\u043d\u0443 \u0432\u0435\u0440\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043c\u0443.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"780","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f\u00bb \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 34, 8-9: PL 76, 1250-1251)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0406\u043c\u044f \u00ab\u0430\u043d\u0451\u043b\u00bb \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0437\u0430\u0434\u0430\u043d\u043d\u0435, \u0430 \u043d\u0435 \u043d\u0430\u0442\u0443\u0440\u0443<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0440\u044d\u0431\u0430 \u0432\u0435\u0434\u0430\u0446\u044c, \u0448\u0442\u043e \u0456\u043c\u044f \u00ab\u0430\u043d\u0451\u043b\u00bb \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0437\u0430\u0434\u0430\u043d\u043d\u0435, \u0430 \u043d\u0435 \u043d\u0430\u0442\u0443\u0440\u0443. \u0421\u0432\u044f\u0442\u044b\u044f \u0434\u0443\u0445\u0456 \u045e \u043d\u0435\u0431\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0434\u0443\u0445\u0430\u043c\u0456, \u0430\u043b\u0435 \u043d\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0456\u0445 \u043c\u043e\u0436\u043d\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u0430\u043d\u0451\u043b\u0430\u043c\u0456, \u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430, \u043a\u0430\u0431 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u0446\u044c. \u0414\u0443\u0445\u0456, \u044f\u043a\u0456\u044f \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u043c\u0435\u043d\u0448 \u0437\u043d\u0430\u0447\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u0446\u0430 \u0430\u043d\u0451\u043b\u0430\u043c\u0456, \u0430 \u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u043d\u0451\u0441\u043b\u044b\u044f \u043f\u0430\u0434\u0437\u0435\u0456, \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u0446\u0430 \u0430\u0440\u0445\u0430\u043d\u0451\u043b\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0414\u0430 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456 \u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u043d\u0435 \u044f\u043a\u0456-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0430\u043d\u0451\u043b, \u0430\u043b\u0435 \u0430\u0440\u0445\u0430\u043d\u0451\u043b \u0413\u0430\u0431\u0440\u044b\u044d\u043b\u044c. \u0414\u043b\u044f \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0437\u0430\u0434\u0430\u043d\u043d\u044f \u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u043d\u0430\u0439\u0432\u0430\u0436\u043d\u0435\u0439\u0448\u044b \u0430\u043d\u0451\u043b, \u043a\u0430\u0431 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0437\u043d\u0430\u0447\u043d\u0443\u044e \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u043f\u0430\u0434\u0437\u0435\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437 \u0456\u0445 \u043c\u0430\u044e\u0446\u044c \u0443\u043b\u0430\u0441\u043d\u044b\u044f \u0456\u043c\u0451\u043d\u044b, \u043a\u0430\u0431 \u0443\u0436\u043e \u0443 \u0441\u0430\u043c\u0456\u0445 \u0456\u043c\u0451\u043d\u0430\u0445 \u0431\u044b\u043b\u0430 \u0431\u0430\u0447\u043d\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c, \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430\u0439 \u0456\u043c \u043f\u0430\u0441\u043b\u0443\u0433\u0456. \u0414\u0430\u0440\u044d\u0447\u044b, \u0443\u043b\u0430\u0441\u043d\u044b\u044f \u0456\u043c\u0451\u043d\u044b \u044f\u043d\u044b \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0413\u043e\u0440\u0430\u0434\u0437\u0435, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0456 \u0431\u0435\u0437 \u0433\u044d\u0442\u044b\u0445 \u0456\u043c\u0451\u043d\u0430\u045e \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0431 \u0442\u0430\u043c \u043f\u0430\u0437\u043d\u0430\u043d\u044b\u044f. \u0411\u043e \u0442\u0430\u043c \u0456\u0441\u043d\u0443\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430. \u0406\u043c\u0451\u043d\u044b, \u044f\u043a\u0456\u044f \u045e\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u043d\u0430 \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u044f \u0434\u043b\u044f \u0456\u0445 \u0437\u0430\u0434\u0430\u043d\u043d\u0456, \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0430\u0434 \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430, \u043a\u0430\u0431 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0434\u043b\u044f \u043d\u0430\u0441 \u043d\u0435\u0439\u043a\u0443\u044e \u043f\u0430\u0441\u043b\u0443\u0433\u0443. \u0406\u043c\u044f \u041c\u0456\u0445\u0430\u043b \u0430\u0437\u043d\u0430\u0447\u0430\u0435: \u00ab\u0425\u0442\u043e \u044f\u043a \u0411\u043e\u0433\u00bb; \u0413\u0430\u0431\u0440\u044b\u044d\u043b\u044c \u2013 \u00ab\u0411\u043e\u0436\u0430\u044f \u043c\u043e\u0446\u00bb; \u0420\u0430\u0444\u0430\u043b \u2013 \u00ab\u0411\u043e\u0433 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u0435\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u043a\u043e\u0436\u043d\u044b \u0440\u0430\u0437, \u043a\u0430\u043b\u0456 \u045e\u0437\u043d\u0456\u043a\u0430\u0435 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u043f\u0430\u0441\u044b\u043b\u0430\u0435\u0446\u0446\u0430 \u041c\u0456\u0445\u0430\u043b, \u043a\u0430\u0431 \u0437 \u0441\u0430\u043c\u043e\u0433\u0430 \u045e\u0447\u044b\u043d\u043a\u0443 \u0456 \u0437 \u0456\u043c\u044f \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0448\u0442\u043e \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0441\u0430\u043c\u043e\u043c\u0443 \u0411\u043e\u0433\u0443. \u0421\u0442\u0430\u0440\u0430\u0434\u0430\u045e\u043d\u0456 \u0432\u043e\u0440\u0430\u0433, \u044f\u043a\u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0441\u0432\u0430\u0451\u0439 \u043f\u044b\u0445\u0456 \u0436\u0430\u0434\u0430\u045e \u0431\u044b\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0423\u0437\u044b\u0434\u0443 \u043d\u0430 \u043d\u0435\u0431\u0430, \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u0437\u043e\u0440\u043a\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044e \u0441\u0432\u043e\u0439 \u0442\u0440\u043e\u043d, \u0431\u0443\u0434\u0443 \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430\u00bb (\u043f\u0430\u0440. \u0406\u0441 14, 13-14), \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b \u043d\u0430\u043f\u0440\u044b\u043a\u0430\u043d\u0446\u044b \u0441\u0432\u0435\u0442\u0443 \u0441\u0430\u043c \u0441\u0430\u0431\u0435, \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u043a\u0430\u043d\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435, \u0431\u0443\u0434\u0437\u0435 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437 \u0430\u0440\u0445\u0430\u043d\u0451\u043b\u0430\u043c \u041c\u0456\u0445\u0430\u043b\u0430\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u042f\u043d\u0430: \u00ab\u0423\u0437\u043d\u044f\u043b\u0430\u0441\u044f \u0431\u0456\u0442\u0432\u0430 \u043d\u0430 \u043d\u0435\u0431\u0435. \u041c\u0456\u0445\u0430\u043b \u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0430\u043d\u0451\u043b\u044b \u0437\u043c\u0430\u0433\u0430\u043b\u0456\u0441\u044f \u0437 \u0446\u043c\u043e\u043a\u0430\u043c\u00bb (\u0410\u043f 12, 7).<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u0414\u0430 \u041c\u0430\u0440\u044b\u0456 \u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0430\u0440\u0445\u0430\u043d\u0451\u043b \u043f\u0430 \u0456\u043c\u0435\u043d\u0456 \u0413\u0430\u0431\u0440\u044b\u044d\u043b\u044c, \u044f\u043a\u043e\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u00ab\u0411\u043e\u0436\u0430\u044f \u043c\u043e\u0446\u00bb. \u0401\u043d \u0437\u2019\u044f\u0432\u0456\u045e\u0441\u044f, \u043a\u0430\u0431 \u0437\u0432\u0435\u0441\u0442\u0430\u0432\u0430\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0441\u043b\u0443\u0433\u0456, \u043a\u0430\u0431 \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0441\u0456\u043b\u0430\u043c\u0456 \u0437\u043b\u0430. \u0422\u0430\u043a, \u00ab\u0411\u043e\u0436\u0430\u044f \u043c\u043e\u0446\u00bb \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u044f\u043a \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e \u0456 \u043c\u043e\u0446\u043d\u044b \u045e \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 14.2pt; text-align: justify;\"><span>\u042f\u043a \u0443\u0436\u043e \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430, \u0456\u043c\u044f \u0420\u0430\u0444\u0430\u043b \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u00ab\u0411\u043e\u0433 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u0435\u00bb, \u0431\u043e \u0430\u0440\u0445\u0430\u043d\u0451\u043b \u0432\u044b\u043b\u0435\u0447\u044b\u045e \u0430\u0434 \u0441\u043b\u0435\u043f\u0430\u0442\u044b \u0432\u043e\u0447\u044b \u0422\u043e\u0431\u0456\u044f, \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u0434\u0430 \u0456\u0445, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0451\u043d \u0433\u044d\u0442\u044b\u043c \u0436\u044d\u0441\u0442\u0430\u043c \u0430\u0437\u0434\u0430\u0440\u0430\u0432\u0456\u045e \u0456\u0445. \u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0432\u044b\u043b\u0435\u0447\u044b\u0446\u044c \u0445\u0432\u0430\u0440\u043e\u0431\u0443, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u00ab\u0411\u043e\u0433 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u0435\u00bb.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff00ff;\"> <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0410\u043f 8, 3. 4; \u0414\u0430\u043d 7, 10b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0410\u043d\u0451\u043b \u0441\u0442\u0430\u045e \u043f\u0440\u044b \u0430\u043b\u0442\u0430\u0440\u044b \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u043c\u0430\u044e\u0447\u044b \u0437\u0430\u043b\u0430\u0442\u0443\u044e \u043a\u0430\u0434\u0437\u0456\u043b\u044c\u043d\u0456\u0446\u0443 \u045e \u0441\u0432\u0430\u0456\u0445 \u0440\u0443\u043a\u0430\u0445, \u0456 \u0431\u044b\u043b\u043e \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u044f\u043c\u0443 \u0448\u043c\u0430\u0442 \u043a\u0430\u0434\u0437\u0456\u043b\u0430.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0406 \u0434\u044b\u043c \u043a\u0430\u0434\u0437\u0456\u043b\u0430 \u045e\u0437\u043d\u044f\u045e\u0441\u044f \u0437 \u0440\u0443\u043a\u0456 \u0430\u043d\u0451\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0422\u044b\u0441\u044f\u0447\u044b \u0442\u044b\u0441\u044f\u0447\u0430\u045e \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u042f\u043c\u0443, \u0456 \u0434\u0437\u0435\u0441\u044f\u0446\u044c \u0442\u044b\u0441\u044f\u0447 \u0434\u0437\u0435\u0441\u044f\u0442\u043a\u0430\u045e \u0442\u044b\u0441\u044f\u0447 \u0441\u0442\u0430\u044f\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0406 \u0434\u044b\u043c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"781","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u0423\u0441\u0442\u0443\u043f \u0434\u0430 \u043a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u044f \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430 \u0406\u0441\u0430\u0456\u00bb \u0441\u0432. \u0413\u0435\u0440\u0430\u043d\u0456\u043c\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 1. 2: CCL 73, 1-3)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u044f \u2013 \u0433\u044d\u0442\u0430 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u0437\u0430\u0433\u0430\u0434\u0443 \u0425\u0440\u044b\u0441\u0442\u0430: \u00ab\u0414\u0430\u0441\u043b\u0435\u0434\u0443\u0439\u0446\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0456\u00bb (\u043f\u0430\u0440. \u042f\u043d 5, 39), \u0456: \u00ab\u0428\u0443\u043a\u0430\u0439\u0446\u0435, \u0456 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435\u00bb (\u041c\u0446 7, 7), \u044f \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e \u0441\u0432\u043e\u0439 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a, \u043a\u0430\u0431 \u0432\u044b\u043f\u0430\u0434\u043a\u0430\u043c \u043d\u0435 \u043f\u0430\u0447\u0443\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0433\u0430\u0431\u0440\u044d\u044f\u043c\u0456: \u00ab\u0412\u044b \u043f\u0430\u043c\u044b\u043b\u044f\u0435\u0446\u0435\u0441\u044f, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0447\u044b \u043d\u0456 \u041f\u0456\u0441\u0430\u043d\u043d\u044f, \u043d\u0456 \u0441\u0456\u043b\u044b \u0411\u043e\u0436\u0430\u0439\u00bb (\u041c\u0446 22, 29). \u0411\u043e \u043a\u0430\u043b\u0456, \u044f\u043a \u043a\u0430\u0436\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0436\u0430\u0439 \u043c\u043e\u0446\u0430\u044e \u0456 \u0411\u043e\u0436\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e, \u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u044f, \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043d\u0456 \u043c\u043e\u0446\u044b \u0411\u043e\u0436\u0430\u0439, \u043d\u0456 \u042f\u0433\u043e \u043b\u044e\u0431\u043e\u0432\u0456: \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u044f \u2013 \u0433\u044d\u0442\u0430 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.25pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0443 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0430\u0439\u0446\u0430 \u0441\u044f\u043c\u2019\u0456, \u044f\u043a\u0456 \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u044b \u0434\u0430\u0441\u0442\u0430\u0435 \u0440\u044d\u0447\u044b \u0441\u0442\u0430\u0440\u044b\u044f \u0456 \u043d\u043e\u0432\u044b\u044f, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0443, \u044f\u043a\u0430\u044f \u045e \u041f\u0435\u0441\u043d\u0456 \u043f\u0435\u0441\u043d\u044f\u045e \u043a\u0430\u0436\u0430: \u00ab\u0421\u0442\u0430\u0440\u044b\u0445 \u0456 \u043c\u0430\u043b\u0430\u0434\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a, \u043b\u044e\u0431\u044b \u043c\u043e\u0439, \u044f \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0430 \u0434\u043b\u044f \u0446\u044f\u0431\u0435\u00bb (\u041f\u043f 7, 14 Vlg). \u041d\u0430\u043c\u0435\u0440\u0432\u0430\u044e\u0441\u044f \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u0406\u0441\u0430\u044e \u0442\u0430\u043a, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u044f\u0433\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u043a \u043f\u0440\u0430\u0440\u043e\u043a\u0430, \u0430\u043b\u0435 \u044f\u043a \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442\u0430 \u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430. \u0414\u0430\u0440\u044d\u0447\u044b, \u0451\u043d \u0441\u0430\u043c \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0441\u044f\u0431\u0435 \u0456 \u043f\u0440\u0430 \u0456\u043d\u0448\u044b\u0445 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442\u0430\u045e: \u00ab\u042f\u043a\u0456\u044f \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u044f \u043d\u0430 \u0433\u0430\u0440\u0430\u0445 \u043d\u043e\u0433\u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u0446\u0430, \u044f\u043a\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u043c\u0456\u0440\u00bb (\u0406\u0441 52, 7). \u042f\u043c\u0443 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u044f\u043a \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0443, \u0411\u043e\u0433 \u043a\u0430\u0436\u0430: \u00ab\u041a\u0430\u0433\u043e \u041c\u043d\u0435 \u043f\u0430\u0441\u043b\u0430\u0446\u044c, \u0445\u0442\u043e \u043f\u043e\u0439\u0434\u0437\u0435 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443?\u00bb \u0410 \u0451\u043d \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435: \u00ab\u0412\u043e\u0441\u044c \u044f, \u043f\u0430\u0448\u043b\u0456 \u043c\u044f\u043d\u0435\u00bb (\u043f\u0430\u0440. \u0406\u0441 6, 8).<\/span><\/p>\r\n<p style=\"text-indent: 21.25pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u043d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0434\u0443\u043c\u0430\u0435, \u0448\u0442\u043e \u045e \u043d\u0435\u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u044f \u043d\u0430\u043c\u0435\u0440\u0432\u0430\u044e\u0441\u044f \u0437\u043c\u044f\u0441\u0446\u0456\u0446\u044c \u0443\u0432\u0435\u0441\u044c \u0437\u043c\u0435\u0441\u0442 \u043a\u043d\u0456\u0433\u0456, \u0431\u043e \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u044f\u043d\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0443 \u0411\u043e\u0436\u044b\u0445 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u045e. \u041f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u042d\u043c\u0430\u043d\u0443\u044d\u043b\u044f, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0437 \u0414\u0437\u0435\u0432\u044b, \u0417\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u044c\u043d\u0456\u043a\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u0445 \u0437\u043d\u0430\u043a\u0430\u045e \u0456 \u0446\u0443\u0434\u0430\u045e, \u044f\u043a\u0456 \u043f\u0430\u043c\u0451\u0440 \u0456 \u0431\u044b\u045e \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0417\u0431\u0430\u045e\u0446\u0430\u043c \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e. \u0410 \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u043f\u0440\u044b\u0440\u043e\u0434\u0443, \u044d\u0442\u044b\u043a\u0443, \u043b\u043e\u0433\u0456\u043a\u0443? \u0423\u0441\u0451, \u0448\u0442\u043e \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f, \u0443\u0441\u0451, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u044f\u0437\u044b\u043a \u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c, \u0430 \u0440\u043e\u0437\u0443\u043c \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0443\u0441\u0451 \u0433\u044d\u0442\u0430 \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u0430 \u045e \u0433\u044d\u0442\u0430\u0439 \u043a\u043d\u0456\u0437\u0435. \u041f\u0440\u0430 \u044f\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u043a\u0430\u0436\u0430 \u0441\u0430\u043c \u0430\u045e\u0442\u0430\u0440: \u00ab\u041a\u043e\u0436\u043d\u0430\u0435 \u0431\u0430\u0447\u0430\u043d\u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u043d\u0456\u0431\u044b \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0437\u0430\u043f\u044f\u0447\u0430\u0442\u0430\u043d\u0430\u0439 \u043a\u043d\u0456\u0433\u0456. \u041a\u0430\u043b\u0456 \u044f\u0435 \u0434\u0430\u0434\u0443\u0446\u044c \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u045e\u043c\u0435\u0435 \u0447\u044b\u0442\u0430\u0446\u044c, \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: \u201c\u0427\u044b\u0442\u0430\u0439 \u043a\u043d\u0456\u0433\u0443\u201d, \u0442\u043e \u0451\u043d \u0430\u0434\u043a\u0430\u0436\u0430: \u201c\u041d\u0435 \u043c\u0430\u0433\u0443, \u0431\u043e \u044f\u043d\u0430 \u0437\u0430\u043f\u044f\u0447\u0430\u0442\u0430\u043d\u0430\u201d. \u041a\u0430\u043b\u0456 \u0436 \u044f\u0435 \u0434\u0430\u0434\u0443\u0446\u044c \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043d\u0435 \u045e\u043c\u0435\u0435 \u0447\u044b\u0442\u0430\u0446\u044c, \u043a\u0430\u0436\u0443\u0447\u044b: \u201c\u0427\u044b\u0442\u0430\u0439\u201d, \u0442\u043e\u0439 \u0430\u0434\u043a\u0430\u0436\u0430: \u201c\u041d\u0435 \u045e\u043c\u0435\u044e \u0447\u044b\u0442\u0430\u0446\u044c\u201d\u00bb (\u0406\u0441 29, 11-12).<\/span><\/p>\r\n<p style=\"text-indent: 21.25pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043a\u0430\u043c\u0443\u0441\u044c\u0446\u0456 \u0433\u044d\u0442\u0430 \u0432\u044b\u0434\u0430\u0435\u0446\u0446\u0430 \u043c\u0430\u043b\u0430 \u0432\u0430\u0436\u043d\u044b\u043c, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430: \u00ab\u041f\u0440\u0430\u0440\u043e\u043a\u0456 \u043d\u044f\u0445\u0430\u0439 \u0433\u0430\u0432\u043e\u0440\u0430\u0446\u044c \u043f\u0430 \u0434\u0432\u043e\u0435 \u0446\u0456 \u043f\u0430 \u0442\u0440\u043e\u0435, \u0456\u043d\u0448\u044b\u044f \u043d\u044f\u0445\u0430\u0439 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0446\u044c. \u041a\u0430\u043b\u0456 \u0436 \u0434\u0440\u0443\u0433\u043e\u043c\u0443 \u0437 \u0441\u0435\u0434\u0437\u044f\u0447\u044b\u0445 \u0431\u0443\u0434\u0437\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0430\u0431\u2019\u044f\u045e\u043b\u0435\u043d\u043d\u0435, \u0442\u043e \u043f\u0435\u0440\u0448\u044b \u043d\u044f\u0445\u0430\u0439 \u043c\u0430\u045e\u0447\u044b\u0446\u044c\u00bb (1 \u041a\u0430\u0440 14, 29-30). \u042f\u043a \u0436\u0430, \u0430\u0434\u043d\u0430\u043a, \u044f\u043d\u044b \u043c\u043e\u0433\u0443\u0446\u044c \u0437\u0430\u043c\u043e\u045e\u043a\u043d\u0443\u0446\u044c, \u043a\u0430\u043b\u0456 \u0433\u0430\u0432\u043e\u0440\u043a\u0430 \u0456 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435 \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e? \u041a\u0430\u043b\u0456 \u0436 \u044f\u043d\u044b \u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0456, \u0442\u043e \u0456\u0445 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0456 \u0431\u044b\u043b\u0456 \u043f\u043e\u045e\u043d\u044b\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0440\u043e\u0437\u0443\u043c\u0443. \u0414\u0430 \u0456\u0445 \u0432\u0443\u0448\u044d\u0439 \u0434\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u0443\u043a\u0456 \u045e\u0441\u043a\u0430\u043b\u044b\u0445\u0430\u043d\u0430\u0433\u0430 \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u043f\u0430\u0432\u0435\u0442\u0440\u0430, \u0430\u043b\u0435 \u0441\u0430\u043c \u0411\u043e\u0433 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0434\u0430 \u0441\u044d\u0440\u0446\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u045e \u0430\u0434\u043d\u0430\u0433\u043e \u0437 \u0456\u0445: \u00ab\u0410\u043d\u0451\u043b \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0441\u0430 \u043c\u043d\u043e\u044e\u00bb (\u043f\u0430\u0440. \u0417\u0430\u0445 1, 9), \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u00ab\u0414\u0443\u0445 \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0435 \u045e \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445: \u201c\u0410\u0431\u0431\u0430, \u041e\u0439\u0447\u0430\u201d\u00bb, \u0456 \u044f\u0448\u0447\u044d: \u00ab\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u044e, \u0448\u0442\u043e \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u041f\u0430\u043d \u0411\u043e\u0433\u00bb (\u041f\u0441 85 [84], 9).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">2 \u0426\u0456\u043c 3, 16-17; \u041f\u0440\u044b\u043f 28, 7\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0423\u0441\u0451 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u0430\u0435 \u0411\u043e\u0433\u0430\u043c \u0456 \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0435 \u0434\u043b\u044f \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u044f, \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u045e \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u0411\u043e\u0436\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u044b\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b, \u0434\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b \u0433\u0430\u0442\u043e\u0432\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0425\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0417\u0430\u043a\u043e\u043d, \u0442\u043e\u0439 \u0441\u044b\u043d \u0440\u0430\u0437\u0443\u043c\u043d\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"782","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u0410\u045e\u0442\u0430\u0431\u0456\u044f\u0433\u0440\u0430\u0444\u0456\u044f\u00bb, \u0441\u0432. \u0422\u044d\u0440\u044d\u0437\u044b \u0430\u0434 \u0414\u0437\u044f\u0446\u044f\u0442\u043a\u0430 \u0415\u0437\u0443\u0441, \u043f\u0430\u043d\u043d\u044b<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Manuscrits autobiographiques, Lisieux 1957, 227-229)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423 \u0441\u044d\u0440\u0446\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u044f \u0431\u0443\u0434\u0443 \u043b\u044e\u0431\u043e\u045e\u044e<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u043c\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u043f\u0430\u0447\u0430\u043b\u0456 \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u0446\u0446\u0430 \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u043f\u0430\u043a\u0443\u0442\u0430\u044e, \u044f \u0430\u0434\u043a\u0440\u044b\u043b\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u0441\u0432. \u041f\u0430\u045e\u043b\u0430, \u043a\u0430\u0431 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0442\u0430\u043c \u043d\u0435\u0439\u043a\u0456 \u0430\u0434\u043a\u0430\u0437. \u0412\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u0430 \u043c\u043e\u0439 \u0437\u0440\u043e\u043a \u0441\u043f\u044b\u043d\u0456\u045e\u0441\u044f \u043d\u0430 \u0434\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0442\u044b\u043c \u0456 \u0442\u0440\u044b\u043d\u0430\u0446\u0446\u0430\u0442\u044b\u043c \u0440\u0430\u0437\u0434\u0437\u0435\u043b\u0430\u0445 \u041f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e. \u042f \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u043b\u0430, \u0448\u0442\u043e \u043d\u0435 \u045e\u0441\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0431\u044b\u0446\u044c \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u043d\u0435 \u045e\u0441\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456, \u043d\u0435 \u045e\u0441\u0435 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u041a\u0430\u0441\u0446\u0451\u043b \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0437 \u0440\u043e\u0437\u043d\u044b\u0445 \u0447\u043b\u0435\u043d\u0430\u045e \u0456 \u0448\u0442\u043e \u0432\u043e\u043a\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0440\u0443\u043a\u043e\u044e. \u0410\u0434\u043a\u0430\u0437 \u0431\u044b\u045e \u0432\u044b\u0440\u0430\u0437\u043d\u044b, \u0430\u043b\u0435 \u043d\u0435 \u0442\u0430\u043a\u0456, \u043a\u0430\u0431 \u0441\u0443\u043d\u044f\u0446\u044c \u043c\u0430\u044e \u0442\u0443\u0433\u0443 \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u043c\u044f\u043d\u0435 \u0441\u043f\u0430\u043a\u043e\u0435\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u044e\u0447\u044b, \u0447\u044b\u0442\u0430\u043b\u0430 \u0434\u0430\u043b\u0435\u0439 \u0456 \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u043b\u0430 \u043d\u0430 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u043c\u044f\u043d\u0435 \u043d\u0430 \u0434\u0443\u0445\u0443: \u00ab\u0414\u0431\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u0431\u043e\u043b\u044c\u0448\u044b\u044f \u0434\u0430\u0440\u044b, \u0456 \u044f \u043f\u0430\u043a\u0430\u0436\u0443 \u0432\u0430\u043c \u044f\u0448\u0447\u044d \u043b\u0435\u043f\u0448\u044b \u0448\u043b\u044f\u0445\u00bb (1 \u041a\u0430\u0440 12, 31). \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u043d\u0430\u0432\u0430\u0442 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u044b\u044f \u0434\u0430\u0440\u044b \u2013 \u043d\u0456\u0448\u0442\u043e \u0431\u0435\u0437 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0448\u0442\u043e \u043b\u044e\u0431\u043e\u045e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u044b\u043c \u0448\u043b\u044f\u0445\u0430\u043c, \u044f\u043a\u0456 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0411\u043e\u0433\u0430. \u0422\u0430\u0434\u044b \u043d\u0430\u0440\u044d\u0448\u0446\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u0441\u043f\u0430\u043a\u043e\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043b\u0430 \u043f\u0440\u0430 \u041c\u0456\u0441\u0442\u044b\u0447\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0430 \u0441\u044f\u0431\u0435 \u045e \u043d\u0456\u0432\u043e\u0434\u043d\u044b\u043c \u0441\u044f\u0440\u043e\u0434 \u0430\u043f\u0456\u0441\u0430\u043d\u044b\u0445 \u041f\u0430\u045e\u043b\u0430\u043c \u0447\u043b\u0435\u043d\u0430\u045e, \u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u0445\u0430\u0446\u0435\u043b\u0430 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0441\u044f\u0431\u0435 \u0432\u0430 \u045e\u0441\u0456\u0445. \u0406 \u0432\u043e\u0441\u044c \u043b\u044e\u0431\u043e\u045e \u0430\u0431\u2019\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043c\u043d\u0435 \u044f\u043a \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u043c\u0430\u0439\u0433\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f. \u042f \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u2013 \u0433\u044d\u0442\u0430 \u0446\u0435\u043b\u0430, \u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u0437 \u043c\u043d\u043e\u0433\u0456\u0445 \u0447\u043b\u0435\u043d\u0430\u045e, \u0442\u043e \u043d\u044f\u043c\u0430 \u045e \u0456\u043c \u043d\u044f\u0441\u0442\u0430\u0447\u044b \u045e \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u043d\u0451\u0441\u043b\u044b\u043c \u0456 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u043c; \u044f \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0448\u0442\u043e \u041a\u0430\u0441\u0446\u0451\u043b \u043c\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u0456 \u0448\u0442\u043e \u0433\u044d\u0442\u0430\u0435 \u0441\u044d\u0440\u0446\u0430 \u043f\u0430\u043b\u0430\u0435 \u0433\u0430\u0440\u0430\u0447\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e. \u042f \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0448\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u044e\u0431\u043e\u045e \u043a\u0456\u0440\u0443\u0435 \u0447\u043b\u0435\u043d\u0430\u043c\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0456 \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0431 \u044f\u043d\u0430 \u0437\u043d\u0456\u043a\u043b\u0430, \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0431 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456 \u043d\u0435 \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u043b\u0456 \u0431 \u043a\u0440\u043e\u045e. \u042f \u045e\u0431\u0430\u0447\u044b\u043b\u0430 \u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0448\u0442\u043e \u043b\u044e\u0431\u043e\u045e \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u043a\u043e\u0436\u043d\u0430\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435, \u0448\u0442\u043e \u043b\u044e\u0431\u043e\u045e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0441\u0456\u043c, \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u043a\u043e\u0436\u043d\u044b \u0447\u0430\u0441 \u0456 \u043c\u0435\u0441\u0446\u0430; \u0430\u0434\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u043b\u044e\u0431\u043e\u045e \u2013 \u0432\u0435\u0447\u043d\u0430\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u044f, \u0443 \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u0456, \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0443\u043b\u0430 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e: \u00ab\u041e \u0415\u0437\u0443, \u043c\u0430\u044f \u041b\u044e\u0431\u043e\u045e, \u043d\u0430\u0440\u044d\u0448\u0446\u0435 \u044f \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u0441\u0432\u0430\u0451 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435: \u043c\u0430\u0456\u043c \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043b\u044e\u0431\u043e\u045e. \u041e \u0442\u0430\u043a, \u044f \u045e\u0436\u043e \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u0441\u0432\u0430\u0451 \u043c\u0435\u0441\u0446\u0430 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435; \u0456 \u0433\u044d\u0442\u0430\u0435 \u043c\u0435\u0441\u0446\u0430 \u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0422\u044b, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430. \u0423 \u0441\u044d\u0440\u0446\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043c\u0430\u0451\u0439 \u041c\u0430\u0446\u0456, \u044f \u0431\u0443\u0434\u0443 \u043b\u044e\u0431\u043e\u045e\u044e. \u0422\u0430\u043a \u044f \u0431\u0443\u0434\u0443 \u045e\u0441\u0456\u043c \u0456 \u043c\u0430\u0451 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0430\u0436\u044b\u0446\u0446\u044f\u0432\u0456\u0446\u0446\u0430\u00bb.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440<\/span><span style=\"color: #ff0000;\">. \u041f\u0441 21 (20), 4; \u043f\u0430\u0440. \u0401\u045e 31, 18; \u043f\u0430\u0440. \u042d\u0444 3, 18; \u041f\u0441 31 (30), 20\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0411\u043e\u0436\u0430, \u0422\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u044f\u043d\u0435<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u0456 \u0437 \u0434\u0437\u044f\u0446\u0456\u043d\u0441\u0442\u0432\u0430 \u043c\u0430\u0439\u0433\u043e \u0432\u0430\u0434\u0437\u0456\u045e \u043c\u044f\u043d\u0435. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0414\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u043c\u0430\u0433\u0443 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0422\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f\u043a\u0430\u044f \u0436 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0422\u0432\u0430\u044f \u0434\u0430\u0431\u0440\u044b\u043d\u044f, \u044f\u043a\u0443\u044e \u0422\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0426\u044f\u0431\u0435 \u0431\u0430\u0456\u0446\u0446\u0430. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0414\u0430\u0433\u044d\u0442\u0443\u043b\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"783","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430, \u0430\u0431\u0430\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 12 in psalmum Qui habitat, 3. 6-8: Opera omnia, Edit. Cisterc. 4 [1966], 458-462)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0446\u044f\u0431\u0435 \u043d\u0430 \u045e\u0441\u0456\u0445 \u0448\u043b\u044f\u0445\u0430\u0445 \u0442\u0432\u0430\u0456\u0445<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0410\u043d\u0451\u043b\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u0435 \u043d\u0430\u043a\u043e\u043d\u0442 \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u044f\u043d\u044b \u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u0446\u044f\u0431\u0435 \u043d\u0430 \u045e\u0441\u0456\u0445 \u0448\u043b\u044f\u0445\u0430\u0445 \u0442\u0432\u0430\u0456\u0445\u00bb (\u041f\u0441 91 [90], 11). \u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u041f\u0430\u043d\u0430 \u0437\u0430 \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0446\u0443\u0434\u044b, \u044f\u043a\u0456\u044f \u0401\u043d \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u0434\u043b\u044f \u0441\u044b\u043d\u043e\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445. \u041d\u044f\u0445\u0430\u0439 \u0441\u043b\u0430\u0432\u044f\u0446\u044c \u0456 \u043a\u0430\u0436\u0443\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0448\u0442\u043e \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0434\u043b\u044f \u0456\u0445 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u044f \u0440\u044d\u0447\u044b. \u041e \u041f\u0430\u043d\u0435, \u0445\u0442\u043e \u0442\u0430\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0448\u0442\u043e \u0422\u044b \u0430\u0434\u043a\u0440\u044b\u045e\u0441\u044f \u044f\u043c\u0443 \u0456 \u0448\u0442\u043e \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0448 \u0434\u0430 \u044f\u0433\u043e \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430. \u0421\u0445\u0456\u043b\u044f\u0435\u0448\u0441\u044f \u0434\u0430 \u044f\u0433\u043e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u0442\u0443\u0440\u0431\u0443\u0435\u0448\u0441\u044f \u0430\u0431 \u0456\u043c \u0456 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0448\u0441\u044f. \u041f\u0430\u0441\u044b\u043b\u0430\u0435\u0448 \u0434\u0430 \u044f\u0433\u043e \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u0434\u0430\u0435\u0448 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u0456 \u0430\u0431\u044f\u0446\u0430\u0435\u0448 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u044f\u043c\u0443 \u0441\u0432\u0430\u0451 \u0430\u0431\u043b\u0456\u0447\u0447\u0430. \u041f\u0430\u0441\u044b\u043b\u0430\u0435\u0448 \u0441\u0432\u044f\u0442\u044b\u0445 \u0434\u0443\u0445\u0430\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u043d\u0430\u043c, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u0435\u0448 \u0456\u0445 \u044f\u043a \u043d\u0430\u0448\u044b\u0445 \u0430\u043f\u0435\u043a\u0443\u043d\u043e\u045e, \u0434\u0430\u0440\u0443\u0447\u0430\u0435\u0448 \u0456\u043c \u0431\u044b\u0446\u044c \u043d\u0430\u0448\u044b\u043c\u0456 \u0432\u044b\u0445\u0430\u0432\u0430\u0446\u0435\u043b\u044f\u043c\u0456. \u0420\u043e\u0431\u0456\u0448 \u0442\u0430\u043a, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0436\u044b\u0445\u0430\u0440\u043e\u045e \u043d\u0435 \u0431\u044b\u045e \u0432\u043e\u043b\u044c\u043d\u044b \u0430\u0434 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0443 \u0430\u043f\u0435\u043a\u0430\u0432\u0430\u0446\u0446\u0430 \u043d\u0430\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0410\u043d\u0451\u043b\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u0435 \u043d\u0430\u043a\u043e\u043d\u0442 \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u044f\u043d\u044b \u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u0446\u044f\u0431\u0435 \u043d\u0430 \u045e\u0441\u0456\u0445 \u0448\u043b\u044f\u0445\u0430\u0445 \u0442\u0432\u0430\u0456\u0445\u00bb. \u042f\u043a\u0443\u044e \u0436 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043f\u0430\u0448\u0430\u043d\u0443 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0431\u0443\u0434\u0437\u0456\u0446\u044c \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0443\u044e \u0436 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u0436 \u043d\u0430\u0434\u0437\u0435\u044e? \u041f\u0430\u0448\u0430\u043d\u0443 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456, \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0441\u0446\u0456, \u043d\u0430\u0434\u0437\u0435\u044e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0430\u043f\u0435\u043a\u0456. \u0411\u043e \u044f\u043d\u044b, \u0431\u043e \u044f\u043d\u044b \u043f\u0440\u044b \u0442\u0430\u0431\u0435, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u0442\u0430\u0431\u043e\u044e, \u0430\u043b\u0435 \u0456 \u0434\u043b\u044f \u0446\u044f\u0431\u0435. \u0406\u0441\u043d\u0443\u044e\u0446\u044c, \u043a\u0430\u0431 \u0446\u044f\u0431\u0435 \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0446\u044c, \u0456\u0441\u043d\u0443\u044e\u0446\u044c, \u043a\u0430\u0431 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0446\u044c. \u0425\u043e\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u0434\u0430\u0435 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0456, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0411\u043e\u0433, \u0430\u0434\u043d\u0430\u043a \u043d\u0435\u043b\u044c\u0433\u0430 \u043d\u0435 \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u0456\u043c, \u0431\u043e \u044f\u043d\u044b \u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c \u042f\u0433\u043e \u0437 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e, \u0430 \u0434\u0430 \u043d\u0430\u0441 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0443 \u043c\u043d\u043e\u0433\u0456\u0445 \u043f\u0430\u0442\u0440\u044d\u0431\u0430\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u043c\u0456, \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u045e\u0434\u0437\u044f\u0447\u043d\u044b\u043c\u0456 \u0442\u0430\u043a\u0456\u043c \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u0430\u043f\u0435\u043a\u0443\u043d\u0430\u043c. \u0410\u0434\u0434\u0437\u044f\u0447\u044b\u043c \u0456\u043c \u043b\u044e\u0431\u043e\u044e, \u0431\u0443\u0434\u0437\u0435\u043c \u0448\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u0456\u0445, \u044f\u043a \u0443\u043c\u0435\u0435\u043c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b. \u0410\u0434\u043d\u0430\u043a \u0443\u0441\u044f \u043d\u0430\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u045e, \u0443\u0441\u044f \u043f\u0430\u0448\u0430\u043d\u0430 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0430\u0434 \u043a\u0430\u0433\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u044b, \u044f\u043a \u0456 \u044f\u043d\u044b, \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043b\u0430\u0441\u043a\u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u043f\u0430\u0448\u0430\u043d\u044b, \u043f\u0440\u0430\u0437 \u0448\u0442\u043e \u0441\u0430\u043c\u0456 \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435\u043c \u043f\u0430\u0448\u0430\u043d\u044b \u0456 \u043b\u044e\u0431\u043e\u0432\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u0406\u043c \u043c\u044b \u0433\u043e\u0440\u0430\u0447\u0430 \u043b\u044e\u0431\u0456\u043c \u042f\u0433\u043e \u0430\u043d\u0451\u043b\u0430\u045e \u044f\u043a \u043d\u0430\u0448\u044b\u0445 \u0441\u044f\u0431\u0440\u043e\u045e \u0443 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u0456, \u0446\u044f\u043f\u0435\u0440 \u0436\u0430 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u045e \u0456 \u0430\u043f\u0435\u043a\u0443\u043d\u043e\u045e, \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u0445 \u043d\u0430\u043c \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u0445 \u0410\u0439\u0446\u043e\u043c. \u0411\u043e \u0446\u044f\u043f\u0435\u0440 \u043c\u044b \u0441\u044b\u043d\u044b \u0411\u043e\u0436\u044b\u044f, \u0445\u043e\u0446\u044c \u044f\u0448\u0447\u044d \u043d\u0435 \u0431\u0430\u0447\u043d\u0430 \u0433\u044d\u0442\u0430 \u045e\u043f\u043e\u045e\u043d\u0456, \u0431\u043e \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043c\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0434\u0437\u0435\u0446\u044c\u043c\u0456, \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b\u043c\u0456 \u0430\u043f\u0435\u043a\u0443\u043d\u0430\u043c \u0456 \u0432\u044b\u0445\u0430\u0432\u0430\u0446\u0435\u043b\u044f\u043c, \u043d\u0456\u0431\u044b \u043d\u0456 \u045e\u0447\u044b\u043c \u043d\u0435 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u0430\u0434 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406 \u0434\u0430\u0440\u044d\u0447\u044b, \u0445\u043e\u0446\u044c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0441\u043b\u0430\u0431\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456, \u0456 \u0445\u043e\u0446\u044c \u0447\u0430\u043a\u0430\u0435 \u043d\u0430\u0441 \u0434\u043e\u045e\u0433\u0430\u044f \u0434\u0430\u0440\u043e\u0433\u0430, \u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043e\u045e\u0433\u0430\u044f, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430\u044f, \u0447\u0430\u0433\u043e \u0436 \u043d\u0430\u043c \u0431\u0430\u044f\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u043d\u0430\u0441 \u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0442\u0430\u043a\u0456\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0430\u0445\u043e\u045e\u043d\u0456\u043a\u0456? \u041d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0430\u0434\u0434\u0430\u0446\u0446\u0430 \u0432\u043e\u0440\u0430\u0433\u0430\u043c, \u043d\u0456 \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u0446\u044c, \u043d\u0456 \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0441\u0445\u0456\u0431\u0456\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0430\u0441 \u0441\u0446\u0435\u0440\u0430\u0436\u044d \u043d\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0448\u044b\u0445 \u0434\u0430\u0440\u043e\u0433\u0430\u0445. \u042f\u043d\u044b \u0432\u0435\u0440\u043d\u044b\u044f, \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u044f \u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u044f \u2013 \u0447\u0430\u0433\u043e \u0436 \u043d\u0430\u043c \u0431\u0430\u044f\u0446\u0446\u0430? \u041a\u0430\u0431 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u0456\u0448\u043b\u0456 \u0437\u0430 \u0456\u043c\u0456, \u043f\u0440\u044b\u0445\u0456\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u0456\u0445, \u0456 \u0442\u0430\u0434\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0434 \u0430\u043f\u0435\u043a\u0430\u044e \u0411\u043e\u0433\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u045e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 91 (90), 11-12. 10\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043e\u0433 \u0430\u043d\u0451\u043b\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u0435 \u043d\u0430\u043a\u043e\u043d\u0442 \u0446\u044f\u0431\u0435, \u043a\u0430\u0431 \u044f\u043d\u044b \u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u0446\u044f\u0431\u0435 \u043d\u0430 \u045e\u0441\u0456\u0445 \u0448\u043b\u044f\u0445\u0430\u0445 \u0442\u0432\u0430\u0456\u0445. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041d\u0430 \u0440\u0443\u043a\u0430\u0445 \u0446\u044f\u0431\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0441\u0456\u0446\u044c, \u043a\u0430\u0431 \u043d\u0435 \u0441\u043f\u0430\u0442\u044b\u043a\u043d\u0443\u045e\u0441\u044f \u0442\u044b \u0430\u0431 \u043a\u0430\u043c\u0435\u043d\u044c \u0441\u0432\u0430\u0451\u0439 \u043d\u0430\u0433\u043e\u044e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u0446\u044f\u0431\u0435, \u0456 \u0433\u043e\u0440\u0430 \u043d\u0435 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u0446\u0446\u0430 \u0434\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u0448\u0430\u0442\u0440\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041d\u0430 \u0440\u0443\u043a\u0430\u0445.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"784","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u045e\u0441\u0456\u0445 \u0432\u0435\u0440\u043d\u044b\u0445\u00bb \u0441\u0432. \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u043a\u0430 \u0410\u0441\u0456\u0437\u0441\u043a\u0430\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Opuscula, edit. Quaracchi 1949, 87-94)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0456, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456 \u0456 \u0447\u044b\u0441\u0442\u044b\u043c\u0456&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0410\u0439\u0446\u0435\u0446 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0430\u0440\u0445\u0430\u043d\u0451\u043b\u0430 \u0413\u0430\u0431\u0440\u044b\u044d\u043b\u044f, \u0448\u0442\u043e \u042f\u0433\u043e \u0421\u043b\u043e\u0432\u0430, \u043d\u0435\u0432\u044b\u043c\u0435\u0440\u043d\u0430 \u0433\u043e\u0434\u043d\u0430\u0435, \u0441\u0432\u044f\u0442\u043e\u0435 \u0456 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0435, \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u045e \u0441\u0432\u0435\u0442 \u0437 \u043d\u0435\u0431\u0430. \u0410\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0433\u044d\u0442\u0430 \u0441\u043b\u0430\u045e\u043d\u0430\u0439 \u0414\u0437\u0435\u0432\u0435 \u041c\u0430\u0440\u044b\u0456, \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u044f\u043a\u043e\u0439 \u0421\u043b\u043e\u0432\u0430 \u043f\u0440\u044b\u043d\u044f\u043b\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0446\u0435\u043b\u0430 \u043d\u0430\u0448\u0430\u0439 \u0441\u043b\u0430\u0431\u043e\u0439 \u043d\u0430\u0442\u0443\u0440\u044b. \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0421\u044b\u043d, \u0431\u0430\u0433\u0430\u0442\u044b \u0437\u0432\u044b\u0448 \u043c\u0435\u0440\u044b, \u043f\u0430\u0436\u0430\u0434\u0430\u045e, \u0430\u0434\u043d\u0430\u043a, \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u041c\u0430\u0446\u0456 \u0432\u044b\u0431\u0440\u0430\u0446\u044c \u0443\u0431\u043e\u0441\u0442\u0432\u0430. \u041a\u0430\u043b\u0456 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u043b\u0430\u0441\u044f \u042f\u0433\u043e \u043c\u0443\u043a\u0430, \u0401\u043d \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u045e \u041f\u0430\u0441\u0445\u0443 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0432\u0443\u0447\u043d\u044f\u043c\u0456. \u041f\u0430\u0441\u043b\u044f \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0434\u0430 \u0410\u0439\u0446\u0430: \u00ab\u041e\u0439\u0447\u0430 \u041c\u043e\u0439, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043d\u044f\u0445\u0430\u0439 \u0430\u0431\u043c\u0456\u043d\u0435 \u0433\u044d\u0442\u044b \u043a\u0435\u043b\u0456\u0445 \u041c\u044f\u043d\u0435\u00bb (\u041c\u0446 26, 39).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0434\u043d\u0430\u043a \u0441\u0432\u0430\u044e \u0432\u043e\u043b\u044e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u045e \u0432\u043e\u043b\u0456 \u0410\u0439\u0446\u0430. \u0410 \u0432\u043e\u043b\u044f\u0439 \u0410\u0439\u0446\u0430 \u0431\u044b\u043b\u043e \u0442\u043e\u0435, \u043a\u0430\u0431 \u042f\u0433\u043e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u0421\u044b\u043d, \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430\u043c \u0456 \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0434\u043b\u044f \u043d\u0430\u0441, \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0441\u044f\u0431\u0435 \u043f\u0440\u0430\u0437 \u0443\u043b\u0430\u0441\u043d\u0443\u044e \u043a\u0440\u043e\u045e \u043d\u0430 \u0430\u043b\u0442\u0430\u0440\u044b \u043a\u0440\u044b\u0436\u0430 \u044f\u043a \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435 \u0456 \u0430\u0445\u0432\u044f\u0440\u0443; \u043d\u0435 \u0437\u0430 \u0441\u044f\u0431\u0435, \u0431\u043e \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u045e\u0441\u0451 \u0441\u0442\u0430\u043b\u0430\u0441\u044f, \u0430\u043b\u0435 \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u0433\u0440\u0430\u0445\u0456, \u0434\u0430\u044e\u0447\u044b \u043d\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u043a\u0430\u0431 \u043c\u044b \u0456\u0448\u043b\u0456 \u0441\u043b\u0435\u0434\u0430\u043c \u0437\u0430 \u0406\u043c. \u0401\u043d \u043f\u0440\u0430\u0433\u043d\u0435, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u045e\u0441\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u043f\u0440\u044b\u043c\u0430\u043b\u0456 \u042f\u0433\u043e \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0447\u044b\u0441\u0442\u044b\u043c \u0446\u0435\u043b\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041e, \u044f\u043a\u0456\u044f \u0436 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u0442\u044b\u044f, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u041f\u0430\u043d\u0430 \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u042f\u0433\u043e \u0437\u0430\u0433\u0430\u0434\u044b, \u0437\u043c\u0435\u0448\u0447\u0430\u043d\u044b\u044f \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456: \u00ab\u041b\u044e\u0431\u0456 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u0439 \u0442\u0432\u0430\u0451\u0439, \u0456 \u045e\u0441\u0451\u0439 \u043c\u043e\u0446\u0430\u044e \u0442\u0432\u0430\u0451\u0439, \u0456 \u045e\u0441\u0456\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u0442\u0432\u0430\u0456\u043c, \u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435\u00bb (\u041b\u043a 10, 27). \u0411\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u0443\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0447\u044b\u0441\u0442\u044b\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c, \u0431\u043e \u0401\u043d \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u043f\u0440\u0430\u0433\u043d\u0435, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u0410\u0439\u0446\u0443 \u045e \u0414\u0443\u0445\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435\u00bb (\u042f\u043d 4, 23). \u0423\u0441\u0435, \u0445\u0442\u043e \u042f\u0433\u043e \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0433\u044d\u0442\u0430 \u0440\u0430\u0431\u0456\u0446\u044c \u0443 \u0434\u0443\u0445\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u0414\u0430 \u042f\u0433\u043e \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0446\u044c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u043a\u0430\u0436\u0443\u0447\u044b \u045e\u0434\u0437\u0435\u043d\u044c \u0456 \u045e\u043d\u043e\u0447\u044b: \u00ab\u041e\u0439\u0447\u0430 \u043d\u0430\u0448, \u043a\u0430\u0442\u043e\u0440\u044b \u0451\u0441\u0446\u044c \u0443 \u043d\u0435\u0431\u0435\u00bb, \u0431\u043e \u00ab\u0442\u0440\u044d\u0431\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0456 \u043d\u0435 \u043f\u0430\u0434\u0430\u0446\u044c \u0434\u0443\u0445\u0430\u043c\u00bb (\u041b\u043a 18, 1).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0433\u043e\u0434\u043d\u044b \u043f\u043b\u0451\u043d \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f. \u0411\u0443\u0434\u0437\u0435\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u0456\u0445 \u044f\u043a \u0441\u044f\u0431\u0435. \u0411\u0443\u0434\u0437\u0435\u043c \u043c\u0435\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u043b\u044e\u0431\u043e\u045e \u0456 \u043f\u0430\u043a\u043e\u0440\u0443, \u0431\u0443\u0434\u0437\u0435\u043c \u0447\u044b\u043d\u0456\u0446\u044c \u0443\u0447\u044b\u043d\u043a\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u0431\u043e \u044f\u043d\u044b \u0437\u043c\u044b\u0432\u0430\u044e\u0446\u044c \u0437 \u0434\u0443\u0448\u044b \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u044b \u0431\u0440\u0443\u0434. \u0423\u0441\u0451, \u0448\u0442\u043e \u043b\u044e\u0434\u0437\u0456 \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0446\u044c \u043d\u0430 \u0441\u0432\u0435\u0446\u0435, \u0433\u0443\u0431\u043b\u044f\u044e\u0446\u044c \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b. \u0417 \u0441\u0430\u0431\u043e\u044e \u0437\u0430\u0431\u0456\u0440\u0430\u044e\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u043b\u0430\u0442\u0443 \u0437\u0430 \u043b\u044e\u0431\u043e\u045e \u0456 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443, \u044f\u043a\u0443\u044e \u0434\u0430\u0432\u0430\u043b\u0456. \u041f\u0430\u043d \u0434\u0430\u0441\u0446\u044c \u0456\u043c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0443\u044e \u043f\u043b\u0430\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043c\u0443\u0434\u0440\u044b\u043c\u0456 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u043c\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0456, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456 \u0456 \u0447\u044b\u0441\u0442\u044b\u043c\u0456. \u041c\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u045e\u0437\u0432\u044b\u0448\u0430\u0446\u0446\u0430 \u043d\u0430\u0434 \u0456\u043d\u0448\u044b\u043c\u0456, \u0430\u043b\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0431\u044b\u0446\u044c \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0456 \u043f\u0430\u0434\u0434\u0430\u043d\u044b\u043c\u0456 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u0411\u043e\u0433\u0430. \u041d\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u043a \u0440\u0430\u0431\u0456\u0446\u044c \u0456 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0435 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430, \u0441\u043f\u0430\u0447\u043d\u0435 \u0414\u0443\u0445 \u041f\u0430\u043d\u0430, \u043f\u0430\u0441\u0435\u043b\u0456\u0446\u0446\u0430 \u0456 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0443 \u0456\u0445. \u042f\u043d\u044b \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0441\u044b\u043d\u0430\u043c\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, \u0441\u043f\u0440\u0430\u0432\u0443 \u044f\u043a\u043e\u0433\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c; \u044f\u043d\u044b \u2013 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0456, \u0431\u0440\u0430\u0442\u044b \u0456 \u043c\u0430\u0446\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0446 5, 3. 5. 6\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u045e\u0431\u043e\u0433\u0456\u044f \u0434\u0443\u0445\u0430\u043c, \u0431\u043e \u0456\u0445 \u0451\u0441\u0446\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043b\u0430\u0433\u043e\u0434\u043d\u044b\u044f, \u0431\u043e \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0437\u044f\u043c\u043b\u044e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u044f \u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u0447\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0431\u043e \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0441\u044b\u0447\u0430\u043d\u044b. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043b\u0430\u0433\u043e\u0434\u043d\u044b\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"785","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u0441\u044b\u043d\u043e\u045e \u043a\u0430\u0440\u0442\u0443\u0437\u0430\u045e\u00bb \u0441\u0432. \u0411\u0440\u0443\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 1-3: SCh 88, 82-84)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0434\u0443\u0445 \u043c\u043e\u0439 \u0443 \u041f\u0430\u043d\u0443<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417 \u0447\u0430\u0441\u0442\u044b\u0445 \u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u0445 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u043b\u0435\u043d\u043d\u044f\u045e \u043d\u0430\u0448\u0430\u0433\u0430 \u0448\u0430\u043d\u043e\u045e\u043d\u0430\u0433\u0430 \u0431\u0440\u0430\u0442\u0430, \u041b\u0430\u043d\u0434\u0443\u0456\u043d\u0430, \u044f \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u044e\u0441\u044f \u043f\u0440\u0430 \u0432\u0430\u0448\u0443\u044e \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0443\u044e \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044c \u0443 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0433\u0430 \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0433\u0430 \u0441\u043f\u043e\u0441\u0430\u0431\u0443 \u0436\u044b\u0446\u0446\u044f. \u041f\u0430\u0447\u0443\u045e\u0448\u044b \u043f\u0440\u0430 \u0432\u0430\u0448\u0443\u044e \u0441\u0432\u044f\u0442\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0456 \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0443\u044e \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u0447\u044b\u0441\u0442\u044b\u0445 \u0456 \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445, \u0443\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0434\u0443\u0445 \u043c\u043e\u0439 \u0443 \u041f\u0430\u043d\u0443. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0440\u0430\u0434\u0443\u044e\u0441\u044f, \u043f\u0440\u0430\u0433\u043d\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u041f\u0430\u043d\u0430 \u0456 \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u042f\u043c\u0443, \u0430\u043b\u0435 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0441\u0443\u043c\u0443\u044e. \u042f \u0440\u0430\u0434\u0443\u044e\u0441\u044f, \u0448\u0442\u043e \u0432\u044b \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0435\u0446\u0435 \u045e \u0446\u043d\u043e\u0442\u0430\u0445, \u0430\u043b\u0435 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b \u0456 \u0441\u0430\u0440\u043e\u043c\u0435\u044e\u0441\u044f, \u0448\u0442\u043e \u044f \u0441\u0430\u043c \u0431\u044f\u0437\u0434\u0437\u0435\u0439\u043d\u0430 \u0456 \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u0430 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u044e \u045e \u0430\u0433\u0456\u0434\u0437\u0435 \u0441\u0432\u0430\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u044f \u0440\u0430\u0434\u0443\u044e\u0441\u044f, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0448\u0447\u0430\u0441\u0446\u044e, \u044f\u043a\u043e\u0435 \u0432\u0430\u043c \u0432\u044b\u043f\u0430\u043b\u0430, \u0456 \u0448\u0447\u0430\u0434\u0440\u043e\u0442\u0430\u043c \u043b\u0430\u0441\u043a\u0456, \u044f\u043a\u0456\u044f \u0434\u0430\u0435 \u0432\u0430\u043c \u0411\u043e\u0433. \u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u0448\u0442\u043e \u0432\u044b \u043f\u0430\u0437\u0431\u0435\u0433\u043b\u0456 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u0445 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u045e \u0456 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0456 \u045e \u0432\u0456\u0440\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f, \u0448\u0442\u043e \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430\u0435 \u0456 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430\u0435 \u043f\u0440\u044b\u0441\u0442\u0430\u043d\u0456\u0448\u0447\u0430 \u045e \u043f\u043e\u0440\u0446\u0435, \u044f\u043a\u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0430\u0445\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430; \u043c\u043d\u043e\u0433\u0456\u044f \u0436\u0430\u0434\u0430\u044e\u0446\u044c \u0442\u0440\u0430\u043f\u0456\u0446\u044c \u0442\u0443\u0434\u044b, \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u043c\u0430\u0433\u0430\u044e\u0446\u0446\u0430, \u0430\u0434\u043d\u0430\u043a \u043d\u0435 \u0434\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c. \u0410 \u043c\u043d\u043e\u0433\u0456\u044f, \u0445\u0442\u043e \u0434\u0430\u0439\u0448\u043e\u045e, \u0431\u044b\u043b\u0456 \u0432\u044b\u043a\u0456\u043d\u0443\u0442\u044b\u044f, \u0431\u043e \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043b\u0430\u0441\u043a\u0456 \u0437 \u0432\u044b\u0448\u044b\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b \u043c\u0430\u0435, \u0432\u0435\u0434\u0430\u0439\u0446\u0435 \u0456 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b\u044f, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u045e\u0436\u043e \u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0442\u0430\u043a\u043e\u043c\u0443 \u0436\u0430\u0434\u0430\u043d\u0430\u043c\u0443 \u0434\u0430\u0431\u0440\u0443, \u0430\u043b\u0435 \u0437\u0433\u0443\u0431\u0456\u045e \u044f\u0433\u043e \u043f\u0430 \u043d\u0435\u0439\u043a\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u0435, \u0431\u0443\u0434\u0437\u0435 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 \u0448\u043a\u0430\u0434\u0430\u0432\u0430\u0446\u044c, \u043a\u0430\u043b\u0456 \u0451\u043d \u0441\u0443\u0440\u2019\u0451\u0437\u043d\u0430 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0430\u043c \u0436\u0430, \u043c\u0430\u0435 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b-\u043f\u0440\u0430\u0446\u0430\u045e\u043d\u0456\u043a\u0456, \u043a\u0430\u0436\u0443: \u00ab\u0412\u0435\u043b\u0456\u0447\u0430\u0435 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u041f\u0430\u043d\u0430\u00bb (\u041b\u043a 1, 46). \u042f \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0431\u0430\u0447\u0443 \u0432\u0435\u043b\u0456\u0447 \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0434\u0430 \u0432\u0430\u0441, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0432\u0430\u0448\u0430\u0433\u0430 \u0430\u0431\u0430\u0442\u0430 \u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0430\u0439\u0446\u0430, \u044f\u043a\u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0432\u0430\u043c\u0456 \u0456 \u0446\u0435\u0448\u044b\u0446\u0446\u0430. \u0420\u0430\u0434\u0443\u0435\u043c\u0441\u044f \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043c\u044b, \u0431\u043e, \u0445\u043e\u0446\u044c \u0432\u044b \u043d\u0435 \u0432\u044b\u043b\u0443\u0447\u0430\u0435\u0446\u0435\u0441\u044f \u0430\u0434\u0443\u043a\u0430\u0446\u044b\u044f\u0439, \u0411\u043e\u0433 \u0441\u0430\u043c \u0443\u043f\u0456\u0441\u0432\u0430\u0435 \u045e \u0432\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u044e\u0431\u043e\u045e, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0435\u0434\u0430\u043d\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0437\u0430\u043a\u043e\u043d\u0443. \u0423\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0432\u044b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u0435 \u0456 \u0448\u0442\u043e \u0432\u0435\u0434\u0430\u0435\u0446\u0435. \u041a\u0430\u043b\u0456 \u0436 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044e \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0435\u043c \u0432\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u0446\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0443\u044e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c, \u0442\u043e \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0437\u0431\u0456\u0440\u0430\u0435\u0446\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0456 \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u044b \u043f\u043b\u0451\u043d \u0411\u043e\u0436\u0430\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 55 (54), 7-8; 1 \u042f\u043d 2, 17\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0425\u0442\u043e \u0434\u0430\u045e \u0431\u044b \u043c\u043d\u0435 \u043a\u0440\u044b\u043b\u044b, \u044f\u043a \u0443 \u0433\u043e\u043b\u0443\u0431\u0430, \u043a\u0430\u0431 \u043f\u0430\u043b\u044f\u0446\u0435\u0446\u044c \u0456 \u0441\u043f\u0430\u0447\u044b\u0446\u044c? <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0422\u0430\u0434\u044b \u0431 \u044f \u045e\u0446\u0451\u043a \u0434\u0430\u043b\u0451\u043a\u0430 \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u0431 \u0443 \u043f\u0443\u0441\u0442\u044b\u043d\u0456.<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0421\u0432\u0435\u0442 \u043c\u0456\u043d\u0430\u0435 \u0456 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u044f\u0433\u043e\u043d\u0430\u044f, \u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0411\u043e\u0436\u0443\u044e \u0432\u043e\u043b\u044e, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u0432\u0435\u0447\u043d\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u0434\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"786","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430, \u0430\u0431\u0430\u0442\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo de Aqu\u00e6ductu: Opera omnia, Edit. Cisterc. 5 [1968], 282-283)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u043c \u043f\u0440\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0421\u0432\u044f\u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0430\u0434 \u0426\u044f\u0431\u0435, \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0437\u0432\u0430\u043d\u0430 \u0421\u044b\u043d\u0430\u043c \u0411\u043e\u0436\u044b\u043c\u00bb (\u043f\u0430\u0440. \u041b\u043a 1, 35). \u041a\u0440\u044b\u043d\u0456\u0446\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0421\u043b\u043e\u0432\u0430 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0410\u0439\u0446\u0430! \u0413\u044d\u0442\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u043f\u0440\u0430\u0437 \u0426\u044f\u0431\u0435, \u043e \u0441\u0432\u044f\u0442\u0430\u044f \u0414\u0437\u0435\u0432\u0430, \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0446\u0435\u043b\u0430\u043c, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u043a\u0430\u0436\u0430: \u00ab\u0410\u0439\u0446\u0435\u0446 \u0443\u0432\u0430 \u041c\u043d\u0435, \u0430 \u042f \u045e \u0406\u043c\u00bb (\u042f\u043d 10, 38), \u043c\u043e\u0433 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u042f \u0432\u044b\u0439\u0448\u0430\u045e \u0430\u0434 \u0410\u0439\u0446\u0430 \u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0441\u0432\u0435\u0442\u00bb (\u042f\u043d 16, 28).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u043b\u043e \u0421\u043b\u043e\u0432\u0430\u00bb. \u0423\u0436\u043e \u0442\u0430\u0434\u044b \u0431\u0456\u043b\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0441\u0430\u0431\u0435. \u0422\u0430\u043c\u0443 \u00ab\u0421\u043b\u043e\u0432\u0430 \u0431\u044b\u043b\u043e \u045e \u0411\u043e\u0433\u0430\u00bb (\u042f\u043d 1, 1) \u0456 \u0436\u044b\u043b\u043e \u045e \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u0435. \u0410 \u041f\u0430\u043d \u043a\u0430\u0437\u0430\u045e \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443: \u00ab\u041c\u0430\u0435 \u043d\u0430\u043c\u0435\u0440\u044b, \u0433\u044d\u0442\u0430 \u043d\u0430\u043c\u0435\u0440\u044b \u043c\u0456\u0440\u0443, \u0430 \u043d\u0435 \u045e\u0446\u0456\u0441\u043a\u0443\u00bb (\u043f\u0430\u0440. \u0415\u0440 29, 11). \u0410\u0434\u043d\u0430\u043a \u0422\u0432\u0430\u044f \u0434\u0443\u043c\u043a\u0430 \u0431\u044b\u043b\u0430 \u045e \u0422\u0430\u0431\u0435, \u0456 \u043c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u044f\u043a\u0430\u044f \u044f\u043d\u0430: \u00ab\u0411\u043e \u0445\u0442\u043e \u0441\u043f\u0430\u0437\u043d\u0430\u045e \u0440\u043e\u0437\u0443\u043c \u041f\u0430\u043d\u0430? \u0410\u0431\u043e \u0445\u0442\u043e \u0431\u044b\u045e \u0434\u0430\u0440\u0430\u0434\u0446\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u043c?\u00bb (\u0420\u044b\u043c 11, 34).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0443\u043c\u043a\u0430 \u0441\u043f\u0430\u043a\u043e\u044e \u0430\u0436\u044b\u0446\u0446\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u0441\u043f\u0440\u0430\u0432\u0435 \u0441\u043f\u0430\u043a\u043e\u044e: \u00ab\u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c\u00bb (\u042f\u043d 1, 14) \u0456 \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441. \u041f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0436\u044b\u0432\u0435 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445, \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0448\u0430\u0439 \u043f\u0430\u043c\u044f\u0446\u0456 \u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0436 \u0434\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u045e\u044f\u045e\u043b\u0435\u043d\u043d\u044f. \u0411\u043e \u0448\u0442\u043e \u044f\u0448\u0447\u044d \u043c\u043e\u0433 \u043f\u0430\u0434\u0443\u043c\u0430\u0446\u044c \u0440\u0430\u043d\u0435\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0440\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0442\u0432\u043e\u0440\u0430\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430? \u0411\u043e\u0433 \u0431\u044b\u045e \u043d\u0435\u0434\u0430\u0441\u044f\u0436\u043d\u044b \u0434\u043b\u044f \u0440\u043e\u0437\u0443\u043c\u0443, \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u044b, \u043d\u044f\u0431\u0430\u0447\u043d\u044b \u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b. \u0426\u044f\u043f\u0435\u0440 \u0436\u0430 \u043f\u0430\u0436\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u042f\u0433\u043e \u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u043a\u0430\u0431 \u042f\u0433\u043e \u045e\u0431\u0430\u0447\u044b\u045e, \u043a\u0430\u0431 \u0430\u0445\u0430\u043f\u0456\u045e \u0434\u0443\u043c\u043a\u0430\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b \u0441\u043f\u044b\u0442\u0430\u0435\u0448\u0441\u044f: \u0414\u0437\u0435? \u041a\u0430\u043b\u0456? \u0414\u044b\u043a \u0432\u043e\u0441\u044c, \u043a\u0430\u043b\u0456 \u043b\u044f\u0436\u044b\u0446\u044c \u0443 \u044f\u0441\u043b\u044f\u0445, \u043a\u0430\u043b\u0456 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0435 \u043d\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u041c\u0430\u0446\u0456, \u043a\u0430\u043b\u0456 \u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430 \u0433\u0430\u0440\u044b, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u043e\u0447 \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0446\u0456 \u043a\u0430\u043b\u0456 \u0432\u0456\u0441\u0456\u0446\u044c \u043d\u0430 \u043a\u0440\u044b\u0436\u044b, \u043a\u0430\u043b\u0456 \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u043f\u0430\u043a\u0440\u044b\u0432\u0430\u0435 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u044f \u0431\u0435\u043b\u044c, \u043a\u0430\u043b\u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u044f\u043a \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043a\u0430\u043b\u0456 \u043f\u0430\u043d\u0443\u0435 \u043d\u0430\u0434 \u043f\u044f\u043a\u0435\u043b\u044c\u043d\u044b\u043c\u0456 \u0441\u0456\u043b\u0430\u043c\u0456 \u0456, \u0443\u0440\u044d\u0448\u0446\u0435, \u043a\u0430\u043b\u0456 \u043d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0430\u0435, \u043a\u0430\u043b\u0456 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c \u0441\u043b\u044f\u0434\u044b \u0430\u0434 \u0446\u0432\u0456\u043a\u043e\u045e \u2013 \u0437\u043d\u0430\u043a\u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456, \u0456 \u044f\u0448\u0447\u044d, \u043a\u0430\u043b\u0456 \u043d\u0430 \u0456\u0445\u043d\u0456\u0445 \u0432\u0430\u0447\u0430\u0445 \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u043d\u0435\u0431\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0426\u0456 \u0436 \u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u043d\u0435 \u043f\u0430\u0431\u043e\u0436\u043d\u044b \u0456 \u043d\u0435 \u0441\u0432\u044f\u0442\u044b \u0447\u044b\u043d \u2013 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043d\u0430\u0434 \u0433\u044d\u0442\u044b\u043c\u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u043c\u0456? \u041a\u0430\u043b\u044f \u044f \u0434\u0443\u043c\u0430\u044e \u043f\u0440\u0430 \u0433\u044d\u0442\u044b\u044f \u043f\u0430\u0434\u0437\u0435\u0456, \u0434\u0443\u043c\u0430\u044e \u043f\u0440\u0430 \u0411\u043e\u0433\u0430; \u0432\u0430 \u045e\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u0401\u043d, \u043c\u043e\u0439 \u0411\u043e\u0433. \u0420\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0435 \u043f\u0440\u0430 \u0433\u044d\u0442\u044b\u044f \u0440\u044d\u0447\u044b \u044f \u043d\u0430\u0437\u044b\u0432\u0430\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e, \u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u043b\u0456\u0447\u0443 \u043f\u0435\u0440\u0430\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435 \u0441\u043b\u043e\u0434\u044b\u0447\u044b, \u044f\u043a\u0430\u044f \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u043f\u043b\u044b\u0432\u0430\u0435, \u0441\u043b\u043e\u0434\u044b\u0447\u044b, \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0439 \u0434\u0430 \u0442\u043e\u0439, \u0448\u0442\u043e \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u043f\u0440\u0430\u0437 \u043f\u043e\u0441\u0430\u0445 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u0441\u043b\u043e\u0434\u044b\u0447, \u044f\u043a\u0443\u044e \u041c\u0430\u0440\u044b\u044f \u0448\u0447\u043e\u0434\u0440\u0430 \u0447\u044d\u0440\u043f\u0430\u043b\u0430 \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e, \u043a\u0430\u0431 \u044f\u0435 \u045e\u0434\u0437\u044f\u043b\u044f\u0446\u044c \u043d\u0430\u043c.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041b\u043a 1, 42. 28\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0430\u043d\u043d\u0430 \u041c\u0430\u0440\u044b\u044f, \u043d\u044f\u043c\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0439 \u0434\u0430 \u0426\u044f\u0431\u0435 \u0441\u044f\u0440\u043e\u0434 \u0434\u0430\u0447\u043e\u043a \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430: \u0422\u044b \u2013 \u041c\u0430\u0446\u0456 \u041a\u0430\u0440\u0430\u043b\u044f \u043a\u0430\u0440\u0430\u043b\u0451\u045e, \u0422\u044b \u2013 \u041a\u0430\u0440\u0430\u043b\u0435\u0432\u0430 \u0430\u043d\u0451\u043b\u0430\u045e, \u0422\u044b \u2013 \u041a\u0430\u0440\u0430\u043b\u0435\u0432\u0430 \u043d\u0435\u0431\u0430. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0422\u044b \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043f\u043b\u043e\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0412\u0456\u0442\u0430\u0439, \u043f\u043e\u045e\u043d\u0430\u044f \u043b\u0430\u0441\u043a\u0456, \u041f\u0430\u043d \u0437 \u0422\u0430\u0431\u043e\u044e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"787","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430 118\u00bb \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 20, 47-50: CSEL 62, 467-469)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u0443\u0434\u0437\u044c \u043c\u0443\u0436\u043d\u044b\u043c \u0456 \u0432\u0435\u0440\u043d\u044b\u043c \u0441\u0432\u0435\u0434\u043a\u0430\u043c<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0440\u043e\u0437\u043d\u044b\u044f \u0451\u0441\u0446\u044c \u0441\u043f\u043e\u0441\u0430\u0431\u044b \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443, \u0442\u0430\u043c\u0443 \u0440\u043e\u0437\u043d\u044b\u044f \u0451\u0441\u0446\u044c \u0432\u0456\u0434\u044b \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430. \u041a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0442\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0448\u0441\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u043c \u2013 \u0441\u0432\u0435\u0434\u043a\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430. \u0426\u044f\u0431\u0435 \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u045e \u0434\u0443\u0445 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456, \u0430\u043b\u0435 \u0431\u0430\u044e\u0447\u044b\u0441\u044f \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0441\u0443\u0434\u0430, \u0442\u044b \u043f\u0430\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0443\u044e \u0447\u044b\u0441\u0446\u0456\u043d\u044e \u0434\u0443\u0448\u044b \u0456 \u0446\u0435\u043b\u0430, \u0456 \u0433\u044d\u0442\u044b\u043c \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0426\u044f\u0431\u0435 \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u045e \u0434\u0443\u0445 \u0445\u0446\u0456\u0432\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u0437\u0430\u0445\u0430\u043f\u0456\u0446\u044c \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u044c \u0441\u043b\u0430\u0431\u0430\u0433\u0430, \u043a\u0430\u0431 \u043f\u0430\u0440\u0443\u0448\u044b\u0446\u044c \u043f\u0440\u0430\u0432\u044b \u0431\u0435\u0437\u0430\u0431\u0430\u0440\u043e\u043d\u043d\u0430\u0439 \u0443\u0434\u0430\u0432\u044b, \u0430\u0434\u043d\u0430\u043a, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430\u0434 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u043c\u0456, \u0442\u044b \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u0448\u0442\u043e \u043b\u0435\u043f\u0448 \u043d\u0435\u0441\u0446\u0456 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0443\u044e \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443, \u0447\u044b\u043c \u043f\u0440\u044b\u0447\u044b\u043d\u044f\u0446\u044c \u043a\u0440\u044b\u045e\u0434\u0443, \u0456 \u0433\u044d\u0442\u044b\u043c \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a\u0456\u0445 \u0441\u0432\u0435\u0434\u043a\u0430\u045e \u043f\u0440\u0430\u0433\u043d\u0435 \u043c\u0435\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u041f\u0456\u0441\u0430\u043d\u043d\u044f: \u00ab\u201c\u0410\u0431\u0430\u0440\u0430\u043d\u044f\u0439\u0446\u0435 \u0441\u0456\u0440\u0430\u0442\u0443, \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435\u0441\u044f \u0437\u0430 \u045e\u0434\u0430\u0432\u0443. \u041f\u0440\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435 \u0456 \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u0456\u043c\u201d, \u2013 \u043a\u0430\u0436\u0430 \u041f\u0430\u043d\u00bb (\u0406\u0441 1, 17-18). \u0426\u044f\u0431\u0435 \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u045e \u0434\u0443\u0445 \u043f\u044b\u0445\u0456, \u0430\u043b\u0435, \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u045e\u0431\u043e\u0433\u0430\u0433\u0430, \u0430\u0434\u0447\u0443\u0432\u0430\u044e\u0447\u044b \u0448\u043b\u044f\u0445\u0435\u0442\u043d\u0443\u044e \u0441\u043f\u0430\u0433\u0430\u0434\u0443, \u0437\u0430\u043c\u0435\u0441\u0442 \u043d\u0430\u0445\u0430\u0431\u0441\u0442\u0432\u0430 \u0442\u044b \u0432\u044b\u0431\u0440\u0430\u045e \u043f\u0430\u043a\u043e\u0440\u0443, \u0456 \u0433\u044d\u0442\u044b\u043c \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0425\u0442\u043e \u0436 \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u0432\u0435\u0440\u0430\u0433\u043e\u0434\u043d\u044b\u043c \u0441\u0432\u0435\u0434\u043a\u0430\u043c, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u043d\u0430\u043a\u0430\u0437\u044b \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u00ab\u0432\u044b\u0437\u043d\u0430\u0435, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0446\u0435\u043b\u0435\u00bb (1 \u042f\u043d 4, 2). \u0411\u043e \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u0435, \u0430 \u043d\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435, \u0432\u044b\u0440\u0430\u043a\u0430\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0421\u043b\u043e\u0432\u0430\u043c\u0456 \u0432\u044b\u0437\u043d\u0430\u0435, \u0430 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0456\u043d\u0448\u0430\u0435. \u042f\u043a \u0448\u043c\u0430\u0442 \u0451\u0441\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043a\u0456\u044f \u043a\u0430\u0436\u0443\u0446\u044c: \u00ab\u041f\u0430\u043d\u0435, \u041f\u0430\u043d\u0435, \u0446\u0456 \u043d\u0435 \u0430\u0434 \u0422\u0432\u0430\u0439\u0433\u043e \u0456\u043c\u044f \u043c\u044b \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u043b\u0456, \u0456 \u0446\u0456 \u043d\u0435 \u0422\u0432\u0430\u0456\u043c \u0456\u043c\u0435\u043c \u0432\u044b\u0433\u0430\u043d\u044f\u043b\u0456 \u0437\u043b\u044b\u0445 \u0434\u0443\u0445\u0430\u045e, \u0456 \u0446\u0456 \u043d\u0435 \u0422\u0432\u0430\u0456\u043c \u0456\u043c\u0435\u043c \u043c\u043d\u043e\u0433\u0456\u044f \u0446\u0443\u0434\u044b \u0447\u044b\u043d\u0456\u043b\u0456?\u00bb, \u0430 \u0401\u043d \u0430\u0434\u043a\u0430\u0436\u0430 \u0456\u043c \u0443 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c: \u00ab\u042f \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u045e \u0432\u0430\u0441, \u0430\u0434\u044b\u0434\u0437\u0456\u0446\u0435 \u0430\u0434 \u041c\u044f\u043d\u0435 \u0432\u044b, \u0448\u0442\u043e \u0447\u044b\u043d\u0456\u0446\u0435 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435\u00bb (\u041c\u0446 7, 22-23). \u0422\u0430\u043c\u0443 \u0441\u0432\u0435\u0434\u043a\u0430\u043c \u0451\u0441\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0443\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u043f\u0440\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041a\u043e\u043b\u044c\u043a\u0456 \u0446\u0456\u0445\u0456\u0445 \u0441\u0432\u0435\u0434\u043a\u0430\u045e \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0432\u044b\u0437\u043d\u0430\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430! \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0432\u0435\u0434\u0430\u045e \u0442\u0430\u043a\u043e\u0435 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430 \u0456 \u0442\u0430\u043a\u043e\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435, \u0431\u043e \u043a\u0430\u0436\u0430: \u00ab\u0425\u0432\u0430\u043b\u0430 \u043d\u0430\u0448\u0430\u044f \u2013 \u0433\u044d\u0442\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430\u00bb (2 \u041a\u0430\u0440 1, 12). \u041a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u043b\u0430 \u0437\u043d\u0435\u0448\u043d\u0435, \u0430\u043b\u0435 \u045e\u043d\u0443\u0442\u0440\u044b \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u043b\u0456 \u0442\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456! \u00ab\u041d\u0435 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0434\u0443\u0445\u0443 \u0432\u0435\u0440\u0446\u0435 (1 \u042f\u043d 4, 1), \u2013 \u043a\u0430\u0436\u0430 \u0451\u043d. \u2013 \u041f\u0430 \u0456\u0445\u043d\u0456\u0445 \u043f\u043b\u0430\u0434\u0430\u0445 \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435 (\u041c\u0446 7, 16)\u00bb, \u043a\u0430\u043c\u0443 \u0432\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u0435\u0440\u044b\u0446\u044c. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u044c \u0432\u0435\u0440\u043d\u044b \u0456 \u043c\u0443\u0436\u043d\u044b \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0443\u043d\u0443\u0442\u0440\u0430\u043d\u0430\u0433\u0430 \u0431\u0443\u043d\u0442\u0443, \u043a\u0430\u0431 \u043c\u043e\u0433 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u0437\u043d\u0435\u0448\u043d\u0456\u043c \u0433\u0430\u043d\u0435\u043d\u043d\u044f\u043c. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0430 \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u044b\u0445 \u0433\u0430\u043d\u0435\u043d\u043d\u044f\u0445 \u043c\u044b \u0441\u0443\u0442\u044b\u043a\u0430\u0435\u043c\u0441\u044f \u0437 \u043a\u0430\u0440\u0430\u043b\u044f\u043c\u0456 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043c\u0456, \u0437 \u0441\u0443\u0434\u0434\u0437\u044f\u043c\u0456 \u0441\u0442\u0440\u0430\u0448\u043d\u044b\u043c\u0456 \u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u043c\u0456. \u041c\u0430\u0435\u0448 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0443 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u0445, \u044f\u043a\u0456\u044f \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0437\u043d\u0435\u0441\u0446\u0456 \u041f\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0447\u044b\u0442\u0430\u0435\u043c: \u00ab\u041d\u044f\u0445\u0430\u0439 \u0433\u0440\u044d\u0445 \u043d\u0435 \u043f\u0430\u043d\u0443\u0435 \u045e \u0432\u0430\u0448\u044b\u043c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0446\u0435\u043b\u0435\u00bb (\u0420\u044b\u043c 6, 12). \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u043f\u0435\u0440\u0430\u0434 \u044f\u043a\u0456\u043c\u0456 \u043a\u0430\u0440\u0430\u043b\u044f\u043c\u0456 \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u0442\u0430\u0446\u044c, \u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043f\u0435\u0440\u0430\u0434 \u044f\u043a\u0456\u043c\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043c\u0456 \u0433\u0440\u0430\u0445\u043e\u045e, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u044b \u0433\u0440\u044d\u0445 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0442\u0430\u0431\u0435 \u043a\u0430\u0440\u0430\u043b\u0451\u043c. \u041a\u043e\u043b\u044c\u043a\u0456 \u0437\u0430\u0433\u0430\u043d\u0430\u045e, \u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u0440\u0430\u0445\u043e\u045e \u2013 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043a\u0430\u0440\u0430\u043b\u0451\u045e. \u0406 \u043d\u0430\u0441 \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u0456\u0445, \u043c\u044b \u0441\u0442\u0430\u0456\u043c \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456. \u0413\u044d\u0442\u044b\u044f \u043a\u0430\u0440\u0430\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043c\u0430\u044e\u0446\u044c \u0442\u0440\u043e\u043d \u0443 \u0440\u043e\u0437\u0443\u043c\u0430\u0445 \u043c\u043d\u043e\u0433\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u0432\u044b\u0437\u043d\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u0443\u0442 \u0436\u0430 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435 \u0442\u0430\u043a\u043e\u0433\u0430 \u043a\u0430\u0440\u0430\u043b\u044f, \u0441\u043a\u0456\u0434\u0430\u0435 \u044f\u0433\u043e \u0437 \u0442\u0440\u043e\u043d\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0440\u043e\u0437\u0443\u043c\u0435. \u0411\u043e \u0446\u0456 \u043c\u043e\u0436\u0430 \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0442\u0440\u043e\u043d \u0441\u0430\u0442\u0430\u043d\u044b \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u0443 \u044f\u043a\u0456\u043c \u0443\u0437\u043d\u0435\u0441\u0435\u043d\u044b \u0442\u0440\u043e\u043d \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430?<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u0432\u044f\u0442\u044b\u044f \u0411\u043e\u0433\u0430 \u0437\u043c\u0430\u0433\u0430\u043b\u0456\u0441\u044f \u0437\u0430 \u0432\u0435\u0440\u0443, \u043f\u0440\u0430\u0439\u0448\u043b\u0456 \u043f\u0440\u0430\u0437 \u0430\u0433\u043e\u043d\u044c \u0456 \u0432\u0430\u0434\u0443 \u0456 \u0431\u044b\u043b\u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u044b\u044f; <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043a\u0430\u0440\u043e\u043d\u0443 \u0430\u0434 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u0413\u044d\u0442\u044b\u044f \u0441\u0432\u044f\u0442\u044b\u044f \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456 \u043f\u0440\u0430 \u0411\u043e\u0433\u0430 \u043f\u0440\u0430\u0437 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"788","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u043f\u0430\u043f\u044b \u041f\u0430\u045e\u043b\u0430 V\u00bb \u0441\u0432. \u042f\u043d\u0430 \u041b\u0435\u0430\u043d\u0430\u0440\u0434\u0437\u0456, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. Pro universali totius Ecclesi\u00e6 reformatione: in archivo Ordinis Clericorum Regularium Matris Dei)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435, \u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0447\u0430\u0433\u043e \u041f\u0430\u043d \u0430\u0434 \u0446\u044f\u0431\u0435 \u0447\u0430\u043a\u0430\u0435&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b\u044f, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0432\u044b\u043f\u0440\u0430\u0432\u0456\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u0437\u0432\u044b\u0447\u0430\u0456, \u0443 \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443 \u0456 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0436\u0430\u0439 \u0445\u0432\u0430\u043b\u044b. \u0410\u0434 \u042f\u0433\u043e, \u0414\u0430\u045e\u0446\u044b \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430, \u043d\u044f\u0445\u0430\u0439 \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u0456 \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u044e\u0446\u044c \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u045e \u0433\u044d\u0442\u0430\u0439 \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u0430\u0439 \u0456 \u0446\u044f\u0436\u043a\u043e\u0439 \u043f\u0440\u0430\u0446\u044b. \u041f\u0430\u0441\u043b\u044f \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u043a\u0430\u0436\u0443\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c\u0456, \u043a\u0430\u0433\u043e \u0445\u043e\u0447\u0443\u0446\u044c \u0437\u043c\u044f\u043d\u0456\u0446\u044c, \u044f\u043a \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u0446\u043d\u043e\u0442\u0430\u045e, \u044f\u043a \u0441\u0432\u0435\u0442\u0430\u0447\u044b, \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b\u044f \u043d\u0430 \u0441\u0432\u0435\u0447\u043d\u0456\u043a\u0443. \u0425\u0430\u0439 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u0456 \u0437\u0437\u044f\u043d\u043d\u0435\u043c \u0437\u0432\u044b\u0447\u0430\u044f\u045e \u0441\u0432\u0435\u0446\u044f\u0446\u044c \u0443\u0441\u0456\u043c, \u0445\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0411\u043e\u0436\u044b\u043c \u0434\u043e\u043c\u0435, \u043a\u0430\u0431 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0431\u0435\u0437 \u043f\u0440\u044b\u043c\u0443\u0441\u0443, \u0437 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044e \u0432\u0435\u0441\u0446\u0456 \u0456\u0445 \u0434\u0430 \u0432\u044b\u043f\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0411\u043e \u043d\u0435\u043b\u044c\u0433\u0430, \u2013 \u044f\u043a \u043d\u0430\u0432\u0443\u0447\u0430\u0435 \u0422\u0440\u044b\u0434\u044d\u043d\u0446\u043a\u0456 \u0421\u0430\u0431\u043e\u0440, \u2013 \u043f\u0430\u0442\u0440\u0430\u0431\u0430\u0432\u0430\u0446\u044c \u0430\u0434 \u0446\u0435\u043b\u0430 \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u043d\u044f\u043c\u0430 \u045e \u0433\u0430\u043b\u0430\u0432\u0435, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0442\u0430\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0440\u0443\u0448\u0430\u043d\u044b \u043f\u0430\u0440\u0430\u0434\u0430\u043a \u0456 \u0433\u0430\u0440\u043c\u043e\u043d\u0456\u044f \u045e\u0441\u0451\u0439 \u0441\u044f\u043c\u2019\u0456 \u041f\u0430\u043d\u0430. \u0423\u0440\u044d\u0448\u0446\u0435, \u044f\u043a \u043c\u0443\u0434\u0440\u044b\u044f \u043b\u0435\u043a\u0430\u0440\u044b, \u043d\u044f\u0445\u0430\u0439 \u0441\u0442\u0430\u0440\u0430\u044e\u0446\u0446\u0430 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0443\u0441\u0435 \u0445\u0432\u0430\u0440\u043e\u0431\u044b \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b\u044f \u0441\u0440\u043e\u0434\u043a\u0456 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456, \u043a\u0430\u0431 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u0439 \u0445\u0432\u0430\u0440\u043e\u0431\u044b \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u044c \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u0434\u0430\u0442\u043d\u044b \u043b\u0435\u043a.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043c\u0430\u044e\u0446\u0446\u0430 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0430\u0433\u0443\u043b\u044c\u043d\u044b\u044f \u0441\u0440\u043e\u0434\u043a\u0456 \u043b\u044f\u0447\u044d\u043d\u043d\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0442\u043e \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0440\u044d\u0444\u043e\u0440\u043c\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0456\u0441\u0446\u0456 \u0456 \u0432\u044b\u0448\u044d\u0439, \u0456 \u043d\u0456\u0436\u044d\u0439, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u044f\u043a \u0441\u044f\u0440\u043e\u0434 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e, \u0442\u0430\u043a \u0456 \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u0434\u043d\u0430\u0447\u0430\u043b\u0435\u043d\u044b\u0445, \u043d\u0430\u0439\u043f\u0435\u0440\u0448 \u0442\u0440\u044d\u0431\u0430 \u0437\u0432\u044f\u0440\u043d\u0443\u0446\u044c \u0443\u0432\u0430\u0433\u0443 \u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0441\u0442\u0430\u044f\u0446\u0435\u043b\u0435\u043c, \u043a\u0430\u0431 \u0440\u044d\u0444\u043e\u0440\u043c\u0430 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u043b\u0430\u0441\u044f \u0430\u0434 \u0456\u0445, \u0456 \u0430\u0434 \u0456\u0445 \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u0430 \u043d\u0430 \u0456\u043d\u0448\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u0440\u0434\u044b\u043d\u0430\u043b\u044b, \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0456, \u0430\u0440\u0446\u044b\u0431\u0456\u0441\u043a\u0443\u043f\u044b, \u0431\u0456\u0441\u043a\u0443\u043f\u044b \u0456 \u043f\u0440\u043e\u0431\u0430\u0448\u0447\u044b \u043d\u0435\u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0430 \u0430\u043f\u044f\u043a\u0443\u044e\u0446\u0446\u0430 \u0434\u0443\u0448\u0430\u043c\u0456. \u0422\u0430\u043c\u0443 \u0437 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0441\u0446\u044e \u0442\u0440\u044d\u0431\u0430 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u0434\u0430\u0440\u0443\u0447\u044b\u0446\u044c \u0456\u043c \u0432\u0435\u0441\u0446\u0456 \u0430\u045e\u0447\u0430\u0440\u043d\u044e \u041f\u0430\u043d\u0430. \u0410\u0434\u043d\u0430\u043a \u0441\u043f\u0443\u0441\u0446\u0456\u043c\u0441\u044f \u0430\u0434 \u043f\u0435\u0440\u0448\u044b\u0445 \u0434\u0430 \u0430\u043f\u043e\u0448\u043d\u0456\u0445, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0430\u0434 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u0434\u0430 \u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u0445. \u0422\u043e\u0439, \u0445\u0442\u043e \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0431\u043e\u043b\u044c\u0448 \u0432\u044b\u0441\u043e\u043a\u0456 \u045e\u0437\u0440\u043e\u0432\u0435\u043d\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043d\u0456\u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043d\u0435 \u043c\u043e\u0436\u0430 \u0456\u0445 \u0430\u0431\u043c\u0456\u043d\u0443\u0446\u044c. \u041d\u0435\u043b\u044c\u0433\u0430 \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0433\u0430 \u0432\u044b\u0441\u0456\u043b\u043a\u0443 \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0434\u0437\u0435\u0446\u0456 \u0437 \u043c\u0430\u043b\u044b\u0445 \u0433\u0430\u0434\u043e\u045e \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u043b\u0456\u0441\u044f \u045e \u0447\u044b\u0441\u0446\u0456\u043d\u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0432\u0435\u0440\u044b \u0456 \u045e \u0441\u0432\u044f\u0442\u044b\u0445 \u0437\u0432\u044b\u0447\u0430\u044f\u0445. \u0414\u043b\u044f \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0433\u044d\u0442\u0430\u0439 \u043c\u044d\u0442\u044b \u043d\u0456\u0448\u0442\u043e \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u043f\u043b\u0451\u043d\u043d\u044b\u043c \u0437\u0430 \u0441\u0432\u044f\u0442\u043e\u0435 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0434\u0430\u043a\u0442\u0440\u044b\u043d\u0435 \u0456 \u0434\u0430\u0440\u0443\u0447\u044d\u043d\u043d\u0435 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0434\u0437\u044f\u0446\u0435\u0439 \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u0430 \u0434\u043e\u0431\u0440\u044b\u043c \u043b\u044e\u0434\u0437\u044f\u043c, \u044f\u043a\u0456\u044f \u0431\u0430\u044f\u0446\u0446\u0430 \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0432\u044f\u0442\u044b \u043e\u0439\u0447\u0430, \u0432\u043e\u0441\u044c \u0448\u0442\u043e \u043f\u0430\u0434\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435 \u0446\u044f\u043f\u0435\u0440 \u0443 \u0433\u044d\u0442\u0430\u0439 \u0432\u0430\u0436\u043d\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u041f\u0430\u043d. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0446\u044f\u0436\u043a\u0456\u043c, \u0430\u043b\u0435, \u043a\u0430\u043b\u0456 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u0446\u044c \u0433\u044d\u0442\u044b\u044f \u0441\u0440\u043e\u0434\u043a\u0456 \u0441\u0430 \u0437\u043d\u0430\u0447\u043d\u0430\u0441\u0446\u044e \u0441\u043f\u0440\u0430\u0432\u044b, \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u043c\u044b \u0433\u0430\u0432\u043e\u0440\u044b\u043c, \u0442\u043e \u0433\u044d\u0442\u0430 \u0441\u0442\u0430\u043d\u0435 \u0432\u0435\u043b\u044c\u043c\u0456 \u043b\u0451\u0433\u043a\u0456\u043c. \u0414\u0430\u0440\u044d\u0447\u044b, \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0446\u0446\u0430 \u043f\u0440\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0441\u0440\u043e\u0434\u043a\u0430\u045e, \u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u044e\u0446\u044c \u0456\u0445 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u043b\u044e\u0434\u0437\u0456.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0413\u044d\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u0440\u0430\u0431\u0456\u045e \u0443\u0441\u0451, \u0448\u0442\u043e \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u044f\u043c\u0443 \u0411\u043e\u0433, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0442\u0430\u043c\u0443 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: \u0423\u0432\u0430\u0439\u0434\u0437\u0456 \u045e \u043c\u043e\u0439 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a, \u0431\u043e \u042f \u0431\u0430\u0447\u044b\u045e \u0442\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0434\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0412\u043e\u0441\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e \u0436\u044b\u0446\u0446\u0451\u043c \u0441\u0432\u0435\u0442\u0443 \u0456 \u0434\u0430\u0439\u0448\u043e\u045e \u0434\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043c\u0443.&nbsp;<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"790","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 32pt; text-align: justify;\"><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u0414\u0430 \u0424\u0430\u0440\u0442\u0443\u043d\u0430\u0442\u0430\u00bb \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-indent: 32pt; text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 13: CSEL 3, 346-347)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423 \u0447\u0430\u0441 \u0441\u043f\u0430\u043a\u043e\u044e \u045e\u0432\u0435\u043d\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0426\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0433\u0430 \u0447\u0430\u0441\u0443 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u044f \u0442\u043e\u0439 \u0441\u043b\u0430\u0432\u044b, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0432\u044b\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441\u00bb (\u0420\u044b\u043c 8, 18). \u0425\u0442\u043e \u0436 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0437 \u0443\u0441\u044f\u0435 \u0441\u0456\u043b\u044b \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0442\u043e\u0439 \u0445\u0432\u0430\u043b\u044b, \u044f\u043a\u0430\u044f \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u044f\u0433\u043e \u043f\u0440\u044b\u044f\u0446\u0435\u043b\u0435\u043c \u0411\u043e\u0433\u0430, \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0430\u0434\u0440\u0430\u0437\u0443 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0430 \u043f\u0430\u0441\u043b\u044f \u0437\u044f\u043c\u043d\u044b\u0445 \u043d\u044f\u0433\u043e\u0434\u0430\u045e \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u0434\u0430\u0441\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u043d\u0435\u0431\u0430? \u0414\u043b\u044f \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u045e \u0441\u043b\u0430\u0432\u0430\u044e \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0442\u0440\u044b\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430\u0435 \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u0434\u0430 \u0430\u0439\u0447\u044b\u043d\u044b \u043f\u0430\u0441\u043b\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456 \u043d\u0430\u0434 \u0432\u043e\u0440\u0430\u0433\u0430\u043c. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0431\u043e\u043b\u044c\u0448 \u0432\u0435\u043b\u0456\u0447\u043d\u0430\u0439 \u0456 \u0433\u043e\u0434\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u0430\u0439, \u043f\u0430\u0441\u043b\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456 \u043d\u0430\u0434 \u0441\u0430\u0442\u0430\u043d\u043e\u0439, \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u0437 \u0442\u0440\u044b\u0443\u043c\u0444\u0430\u043c \u0443 \u0440\u0430\u0439, \u0437 \u044f\u043a\u043e\u0433\u0430 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456, \u044f\u043a \u0433\u0440\u044d\u0448\u043d\u0456\u043a, \u0431\u044b\u045e \u0432\u044b\u0433\u043d\u0430\u043d\u044b \u0410\u0434\u0430\u043c; \u0441\u043a\u043b\u0430\u0434\u0432\u0430\u043d\u043d\u0435 \u0442\u0430\u043c \u0430\u0434\u0437\u043d\u0430\u043a\u0430\u045e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456 \u043f\u0430\u0441\u043b\u044f \u043f\u0435\u0440\u0430\u0430\u0434\u043e\u043b\u0435\u043d\u043d\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0435\u0440\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0437\u0432\u0451\u045e \u043d\u0430\u0441; \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0443 \u045e \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0434\u0430\u0440\u044b \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439 \u0432\u0435\u0440\u044b, \u043d\u044f\u0437\u043b\u043e\u043c\u043d\u0430\u0439 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456, \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0433\u043e\u0434\u043d\u0430\u0439 \u043f\u0430\u0445\u0432\u0430\u043b\u044b; \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0443, \u043a\u0430\u043b\u0456 \u0401\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0430\u0434\u043f\u043e\u043c\u0441\u0446\u0456\u0446\u044c \u0441\u0432\u0430\u0456\u043c \u0432\u043e\u0440\u0430\u0433\u0430\u043c; \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435 \u043f\u0440\u044b \u0406\u043c, \u043a\u0430\u043b\u0456 \u0401\u043d \u0441\u044f\u0434\u0437\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c; \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u043c\u0441\u044f \u0441\u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0440\u043e\u045e\u043d\u044b\u043c\u0456 \u0441\u0430\u043c\u0456\u043c \u0430\u043d\u0451\u043b\u0430\u043c; \u0448\u0442\u043e \u043c\u044b \u0440\u0430\u0434\u0443\u0435\u043c\u0441\u044f \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0432\u0430\u043b\u043e\u0434\u0430\u0435\u043c \u041d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0430\u043c\u0456, \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456. \u042f\u043a\u043e\u0435 \u0433\u0430\u043d\u0435\u043d\u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0447\u044b \u0433\u044d\u0442\u044b\u044f \u0434\u0443\u043c\u043a\u0456? \u042f\u043a\u0456\u044f \u0437\u0434\u0437\u0435\u043a\u0456 \u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0435\u0440\u0430\u0430\u0434\u043e\u043b\u0435\u0446\u044c \u0456\u0445?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0443\u0448\u0430, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u0430\u044f \u0442\u0430\u043a\u0456\u043c\u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u043c\u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f\u043c\u0456, \u043c\u043e\u0436\u0430 \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u043d\u044f\u0437\u043b\u043e\u043c\u043d\u0430\u0439 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u043d\u0430\u043f\u0430\u0434\u044b \u0441\u0430\u0442\u0430\u043d\u044b \u0456 \u043f\u0430\u0433\u0440\u043e\u0437\u044b \u0441\u0432\u0435\u0442\u0443; \u0434\u0443\u0445 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u044b\u043c, \u043a\u0430\u043b\u0456 \u043f\u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u044f\u0433\u043e \u043d\u0430\u0434\u0437\u0435\u0439\u043d\u0430\u044f \u0456 \u043c\u043e\u0446\u043d\u0430\u044f \u0432\u0435\u0440\u0430 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b. \u041f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0447\u044b, \u0441\u0432\u0435\u0442 \u043a\u0456\u0434\u0430\u0435 \u045e \u0432\u044f\u0437\u043d\u0456\u0446\u0443, \u0430\u043b\u0435 \u043d\u0435\u0431\u0430 \u0430\u0434\u043a\u0440\u044b\u0442\u0430\u0435. \u0410\u043d\u0442\u044b\u0445\u0440\u044b\u0441\u0442 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0435, \u0430\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0435. \u0421\u043c\u0435\u0440\u0446\u044c \u0437\u0430\u0431\u0456\u0440\u0430\u0435, \u0430\u043b\u0435 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c \u0456\u0434\u0437\u0435 \u0437\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c. \u042f\u043a\u0456 \u0436 \u0433\u044d\u0442\u0430 \u0433\u043e\u043d\u0430\u0440 \u2013 \u0432\u044b\u0439\u0441\u0446\u0456 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0443\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0445\u0432\u0430\u043b\u0443 \u0441\u044f\u0440\u043e\u0434 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e \u0456 \u045e\u0446\u0456\u0441\u043a\u0443, \u0437\u0430\u043a\u0440\u044b\u0446\u044c \u043d\u0430 \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u0432\u043e\u0447\u044b, \u044f\u043a\u0456\u044f \u0431\u0430\u0447\u044b\u043b\u0456 \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0441\u0432\u0435\u0442, \u0456 \u043f\u0430\u0441\u043b\u044f \u0430\u0434\u0440\u0430\u0437\u0443 \u0430\u0434\u043a\u0440\u044b\u0446\u044c, \u043a\u0430\u0431 \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430 \u0456 \u0425\u0440\u044b\u0441\u0442\u0430. \u042f\u043a\u0430\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0445\u0443\u0442\u043a\u0430\u0441\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0433\u0430 \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430. \u0410\u0434\u043d\u0430 \u0445\u0432\u0456\u043b\u0456\u043d\u0430 \u2013 \u0456 \u0442\u044b \u0437\u0430\u0431\u0440\u0430\u043d\u044b \u0437 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u0430\u043f\u044b\u043d\u0443\u0446\u0446\u0430 \u045e \u041d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u0442\u0440\u044d\u0431\u0430 \u0430\u0445\u0430\u043f\u0456\u0446\u044c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0434\u0443\u043c\u043a\u0430\u043c\u0456, \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0434\u043d\u0451\u043c \u0456 \u043d\u043e\u0447\u0447\u0443. \u041a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434 \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0435 \u0442\u0430\u043a \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0436\u0430\u045e\u043d\u0435\u0440\u0430 \u0411\u043e\u0433\u0430, \u0442\u043e \u043d\u0435 \u0437\u043b\u043e\u043c\u0456\u0446\u044c \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456 \u0433\u0430\u0442\u043e\u0432\u0430\u0433\u0430 \u0434\u0430 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u044b. \u041a\u0430\u043b\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u043f\u0440\u0430\u0433\u0443\u0447\u044b\u0446\u044c \u0440\u0430\u043d\u0435\u0439 \u0437\u0430 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434, \u0442\u043e \u0432\u0435\u0440\u0430, \u0433\u0430\u0442\u043e\u0432\u0430\u044f \u0434\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430, \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0431\u0435\u0437 \u043f\u043b\u0430\u0442\u044b. \u0411\u043e\u0433 \u0421\u0443\u0434\u0434\u0437\u044f \u0431\u0435\u0437 \u043f\u0440\u0430\u043c\u0430\u0440\u0443\u0434\u0436\u0432\u0430\u043d\u043d\u044f \u0434\u0430\u0441\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443. \u0423 \u0447\u0430\u0441 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443 \u045e\u0432\u0435\u043d\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u043d\u0430\u044f \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0430, \u0443 \u0447\u0430\u0441 \u0441\u043f\u0430\u043a\u043e\u044e \u2013 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0414\u0437 20, 28; 1 \u041a\u0430\u0440 4, 2\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0417\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043d\u0430 \u045e\u0432\u0435\u0441\u044c \u0441\u0442\u0430\u0442\u0430\u043a, \u0443 \u044f\u043a\u0456\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0432\u0430\u0441 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u0432\u0456\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0401\u043d \u043f\u0440\u044b\u0434\u0431\u0430\u045e \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0410\u0434 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u045e \u0436\u0430 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u0430\u043a\u0430\u0437\u0430\u045e\u0441\u044f \u0432\u0435\u0440\u043d\u044b\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431 \u0432\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"791","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u043d\u0456\u0433\u0430 \u0441\u0432. \u0422\u044d\u0440\u044d\u0437\u044b \u0430\u0434 \u0415\u0437\u0443\u0441\u0430, \u043f\u0430\u043d\u043d\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Opusc. De libro vit\u00e6, cap. 22, 6-7. 14)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439\u043c\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u0430 \u043b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u043e\u0439, \u0434\u043b\u044f \u043a\u0430\u0433\u043e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u044f\u0431\u0440\u0430\u043c \u0456 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u044b\u043c \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c, \u0443\u0441\u0451 \u043c\u043e\u0436\u0430 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0446\u044c. \u0415\u0437\u0443\u0441 \u0441\u0430\u043c \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439, \u0434\u0430\u0434\u0430\u0435 \u0441\u0456\u043b\u044b, \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435, \u0401\u043d \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u0456 \u0448\u0447\u044b\u0440\u044b \u0441\u044f\u0431\u0440\u0430. \u042f \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0431\u0430\u0447\u0443, \u0448\u0442\u043e \u0411\u043e\u0436\u0430\u044f \u0432\u043e\u043b\u044f \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u043c\u044b, \u043a\u0430\u043b\u0456 \u0436\u0430\u0434\u0430\u0435\u043c \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u0411\u043e\u0433\u0443 \u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0430\u0434 \u042f\u0433\u043e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u043b\u0430\u0441\u043a\u0456, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u0456\u0445 \u043f\u0440\u0430\u0437 \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0443\u044e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u044f\u043a\u043e\u0439 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u044b \u0411\u043e\u0433, \u044f\u043a \u0441\u0430\u043c \u043a\u0430\u0436\u0430, \u043c\u0430\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0435\u043b\u044c\u043c\u0456 \u0447\u0430\u0441\u0442\u0430 \u044f \u0441\u0430\u043c\u0430 \u0433\u044d\u0442\u0430 \u0437\u0432\u0435\u0434\u0432\u0430\u043b\u0430: \u041f\u0430\u043d \u043c\u043d\u0435 \u0433\u044d\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u045e. \u0411\u0430\u0447\u044b\u043b\u0430, \u043d\u0456\u0431\u044b \u043d\u0430 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043c\u044b \u0445\u043e\u0447\u0430\u043c, \u043a\u0430\u0431 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u044b \u0411\u043e\u0433 \u0430\u0434\u043a\u0440\u044b\u045e \u043d\u0430\u043c \u0441\u0432\u0430\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0443\u044e \u0431\u0440\u0430\u043c\u0443. \u041d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0448\u0443\u043a\u0430\u0446\u044c \u0456\u043d\u0448\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0456, \u043d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u0432\u044f\u0440\u0448\u044b\u043d\u044f\u045e \u043a\u0430\u043d\u0442\u044d\u043c\u043f\u043b\u044f\u0446\u044b\u0456. \u0413\u044d\u0442\u044b \u0448\u043b\u044f\u0445 \u0432\u044f\u0434\u0437\u0435 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u0456 \u043d\u0430\u0434\u0437\u0435\u0439\u043d\u0430. \u0410\u0434 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0440\u0430\u0437 \u041f\u0430\u043d\u0430 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b. \u0401\u043d \u2013 \u043d\u0430\u0448 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a. \u041f\u0430-\u0437\u0430 \u0406\u043c \u043c\u044b \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u043c \u0431\u043e\u043b\u044c\u0448 \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0443 \u0434\u043b\u044f \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u044b\u043a \u0447\u0430\u0433\u043e \u0436 \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u043f\u043e\u0431\u0430\u0447 \u0442\u0430\u043a\u043e\u0433\u0430 \u0432\u0435\u0440\u043d\u0430\u0433\u0430 \u0441\u044f\u0431\u0440\u0430, \u044f\u043a\u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435 \u043d\u0430\u0441 \u0443 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u0445 \u0456 \u0441\u043c\u0443\u0442\u043a\u0443, \u044f\u043a \u0433\u044d\u0442\u0430 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u0440\u043e\u0431\u044f\u0446\u044c \u0437\u044f\u043c\u043d\u044b\u044f \u0441\u044f\u0431\u0440\u044b. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430 \u0456 \u0448\u0447\u044b\u0440\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0456 \u0445\u0442\u043e \u0437 \u0406\u043c \u0437\u0430\u045e\u0441\u0451\u0434\u044b. \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u043d\u0430 \u0441\u043b\u0430\u045e\u043d\u0430\u0433\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430, \u0443 \u044f\u043a\u043e\u0433\u0430 \u043d\u0430 \u0432\u0443\u0441\u043d\u0430\u0445 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u043b\u043e \u0456\u043c\u044f \u0415\u0437\u0443\u0441\u0430, \u0431\u043e \u0451\u043d \u043c\u0435\u045e \u044f\u0433\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u044b\u0441\u0435\u0447\u0430\u043d\u044b\u043c \u0456 \u0432\u044b\u0431\u0456\u0442\u044b\u043c \u043d\u0430 \u0441\u044d\u0440\u0446\u044b. \u041a\u0430\u043b\u0456 \u044f \u0433\u044d\u0442\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043b\u0430 \u043d\u0430\u0434 \u0433\u044d\u0442\u044b\u043c \u0456 \u0441\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u043b\u0430, \u0448\u0442\u043e \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0441\u0432\u044f\u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u0432\u044b\u043b\u0443\u0447\u0430\u044e\u0446\u0446\u0430 \u043a\u0430\u043d\u0442\u044d\u043c\u043f\u043b\u044f\u0446\u044b\u0439\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u044f\u043a \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u0430\u043a \u0410\u0441\u0456\u0437\u0441\u043a\u0456, \u0410\u043d\u0442\u043e\u043d\u0456\u0439 \u041f\u0430\u0434\u0443\u0430\u043d\u0441\u043a\u0456, \u0411\u044d\u0440\u043d\u0430\u0440\u0434, \u041a\u0430\u0446\u044f\u0440\u044b\u043d\u0430 \u0421\u0456\u0435\u043d\u0441\u043a\u0430\u044f \u0456\u0434\u0443\u0446\u044c \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u0439. \u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0456\u0441\u0446\u0456 \u0433\u044d\u0442\u044b\u043c \u0448\u043b\u044f\u0445\u0430\u043c \u0446\u0430\u043b\u043a\u0430\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430, \u0446\u0430\u043b\u043a\u0430\u043c \u0434\u0430\u0432\u044f\u0440\u0430\u044e\u0447\u044b \u0441\u044f\u0431\u0435 \u0411\u043e\u0433\u0443. \u041a\u0430\u043b\u0456 \u0401\u043d \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0434\u0430\u043b\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0434\u0430 \u043b\u0456\u043a\u0443 \u0441\u0432\u0430\u0456\u0445 \u0441\u0430\u043c\u044b\u0445 \u0431\u043b\u0456\u0437\u043a\u0456\u0445 \u0441\u044f\u0431\u0440\u043e\u045e, \u043c\u044b \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0440\u044b\u043c\u0435\u043c \u0433\u044d\u0442\u0443\u044e \u043b\u0430\u0441\u043a\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u043e\u0436\u043d\u044b \u0440\u0430\u0437, \u043a\u0430\u043b\u0456 \u0434\u0443\u043c\u0430\u0435\u043c \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u043c\u044f\u0442\u0430\u0439\u043c\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u0430 \u042f\u0433\u043e \u043b\u044e\u0431\u043e\u045e, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u0430\u0441\u043a\u0430\u045e \u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0443\u044e \u043d\u0430\u043c \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u0410\u0439\u0446\u0435\u0446, \u043a\u0430\u043b\u0456 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u043d\u0430\u043c \u0442\u0430\u043a\u0443\u044e \u0446\u0443\u0434\u043e\u045e\u043d\u0443\u044e \u0437\u0430\u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u043d\u0430\u0441. \u041b\u044e\u0431\u043e\u045e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u043b\u044e\u0431\u043e\u0432\u0456. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0442\u0430\u0440\u0430\u0446\u0446\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u0435\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u0433\u044d\u0442\u0443\u044e \u043f\u0440\u0430\u045e\u0434\u0443 \u0456 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0434\u0430 \u043b\u044e\u0431\u043e\u0432\u0456. \u041a\u0430\u043b\u0456 \u041f\u0430\u043d \u0434\u0430\u0441\u0446\u044c \u043d\u0430\u043c \u0442\u0430\u043a\u0443\u044e \u043b\u0430\u0441\u043a\u0443 \u0456 \u0430\u0431\u0443\u0434\u0437\u0456\u0446\u044c \u0443 \u043d\u0430\u0448\u044b\u043c \u0441\u044d\u0440\u0446\u044b \u0442\u0430\u043a\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u0443\u0441\u0451 \u0430\u0434\u0440\u0430\u0437\u0443 \u0441\u0442\u0430\u043d\u0435 \u043c\u0430\u0433\u0447\u044b\u043c\u044b\u043c, \u0456 \u0448\u043c\u0430\u0442 \u0448\u0442\u043e \u043c\u044b \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043c \u0437 \u043b\u0451\u0433\u043a\u0430\u0441\u0446\u044e.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 73 (72), 27a. 28a; 1 \u041a\u0430\u0440 6, 17\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0412\u043e\u0441\u044c \u0433\u0456\u043d\u0443\u0446\u044c \u0442\u044b\u044f, \u0448\u0442\u043e \u0430\u0434\u0434\u0430\u043b\u044f\u044e\u0446\u0446\u0430 \u0430\u0434 \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u041c\u043d\u0435 \u0434\u043e\u0431\u0440\u0430 \u0431\u044b\u0446\u044c \u0431\u043b\u0456\u0437\u043a\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430, \u0443 \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u044f \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u0430\u0431\u0435 \u043f\u0440\u044b\u0442\u0443\u043b\u0430\u043a.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0425\u0442\u043e \u0437\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0437 \u041f\u0430\u043d\u0430\u043c, \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0437 \u0406\u043c \u0430\u0434\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041c\u043d\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"792","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0416\u044b\u0446\u0446\u0451 \u0441\u0432. \u042f\u0434\u0432\u0456\u0433\u0456\u00bb, \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u0435 \u0442\u0430\u0433\u0430\u0447\u0430\u0441\u043d\u044b\u043c \u0430\u045e\u0442\u0430\u0440\u0430\u043c&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Acta Sanctorum Octobris 8 [1853], 201-202)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0412\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u0430 \u0456\u043c\u043a\u043d\u0443\u043b\u0430\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0436\u044b\u0432\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456, \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u044f \u0434\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u0430\u0431\u0447\u044d\u0441\u0430\u043d\u044b\u044f \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435 \u045e\u0434\u0430\u0440\u0430\u043c\u0456 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u045e \u0456 \u045e\u0446\u0456\u0441\u043a\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u043c\u043d\u043e\u0433\u0456\u044f \u043f\u0430\u043a\u0443\u0442\u044b \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0445\u0432\u0430\u043b\u044b \u0456 \u0441\u043b\u0430\u045e\u043d\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u044b, \u0411\u043e\u0436\u0430\u044f \u0441\u043b\u0443\u0433\u0430, \u042f\u0434\u0432\u0456\u0433\u0430, \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0440\u044b\u043c\u0430\u043b\u0430 \u043d\u0430\u0446\u0456\u0441\u043a \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u045e, \u0456 \u043d\u0435 \u0448\u043a\u0430\u0434\u0430\u0432\u0430\u043b\u0430 \u0441\u044f\u0431\u0435, \u0443\u0442\u0430\u0439\u043c\u043e\u045e\u0432\u0430\u043b\u0430 \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u0447\u0430\u0441\u0442\u044b\u043c \u0431\u0456\u0447\u0430\u0432\u0430\u043d\u043d\u0435\u043c. \u0428\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0456\u0448\u0447\u044b\u043b\u0430 \u0441\u044f\u0431\u0435 \u043f\u043e\u0441\u0442\u0430\u043c \u0456 \u045e\u0441\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0435\u043c, \u0448\u0442\u043e \u043c\u043d\u043e\u0433\u0456\u044f \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u043b\u0456\u0441\u044f, \u044f\u043a \u043c\u043e\u0436\u0430 \u0441\u043b\u0430\u0431\u0430\u044f \u0456 \u043a\u0440\u043e\u0445\u043a\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0432\u044b\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0442\u0430\u043a\u0456\u044f \u043f\u0430\u043a\u0443\u0442\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0427\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0443\u0442\u0430\u0439\u043c\u043e\u045e\u0432\u0430\u043b\u0430 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u0430, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043b\u0430 \u045e \u043c\u043e\u0446\u044b \u0434\u0443\u0445\u0430 \u0456 \u045e \u0431\u0430\u0433\u0430\u0446\u0446\u0456 \u043b\u0430\u0441\u043a\u0456, \u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u045e \u0443 \u0451\u0439 \u0437\u0430\u043f\u0430\u043b \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0456 \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u0412\u0435\u043b\u044c\u043c\u0456 \u0447\u0430\u0441\u0442\u0430 \u0437\u0432\u044f\u0440\u0442\u0430\u043b\u0430\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430 \u0437 \u0442\u0430\u043a\u043e\u0439 \u0433\u0430\u0440\u0430\u0447\u0430\u0439 \u0442\u0443\u0433\u043e\u0439, \u0448\u0442\u043e \u043d\u0456\u0431\u044b \u043d\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u043b\u0430 \u0456 \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u043b\u0430, \u0448\u0442\u043e \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u0432\u043e\u043a\u0430\u043b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u0442\u0430\u043c\u0443, \u0437 \u044f\u043a\u043e\u0439 \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044e \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0456\u043c\u043a\u043d\u0443\u043b\u0430\u0441\u044f \u0434\u0430 \u0411\u043e\u0433\u0430, \u0442\u0430\u043a \u0437 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u043b\u0430 \u0431\u043b\u0456\u0436\u043d\u0456\u043c, \u0448\u0447\u043e\u0434\u0440\u0430 \u045e\u0434\u0437\u044f\u043b\u044f\u044e\u0447\u044b \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u043c. \u0410\u043a\u0430\u0437\u0432\u0430\u043b\u0430 \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u043d\u0443\u044e \u0430\u043f\u0435\u043a\u0443 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044f\u043c \u0456 \u043a\u0430\u043d\u043a\u0440\u044d\u0442\u043d\u044b\u043c \u0437\u0430\u043a\u043e\u043d\u043d\u044b\u043c \u0430\u0441\u043e\u0431\u0430\u043c, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u045e \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u044b \u0446\u0456 \u043f\u0430-\u0437\u0430 \u0456\u043c, \u0443\u0434\u043e\u0432\u0430\u043c \u0456 \u0441\u0456\u0440\u043e\u0442\u0430\u043c, \u0441\u043b\u0430\u0431\u044b\u043c \u0456 \u0445\u0432\u043e\u0440\u044b\u043c, \u043f\u0440\u0430\u043a\u0430\u0436\u043e\u043d\u044b\u043c \u0456 \u0432\u044f\u0437\u043d\u044f\u043c, \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u044b\u043c, \u043c\u0430\u0446\u0456, \u044f\u043a\u0456\u044f \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u043c\u0430\u043b\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439. \u041d\u0456\u043a\u043e\u043c\u0443 \u0437 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0440\u0430\u0441\u0456\u045e \u044f\u0435 \u0430\u0431 \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435, \u044f\u043d\u0430 \u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u043b\u0430 \u0430\u0434\u044b\u0441\u0446\u0456 \u0431\u0435\u0437 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u044f \u0441\u043b\u0443\u0433\u0430 \u043d\u0435 \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u043b\u0430 \u043d\u0456\u0432\u043e\u0434\u043d\u0430\u0433\u0430 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0447\u044b\u043d\u0443, \u044f\u043a\u0456 \u043c\u0430\u0433\u043b\u0430 \u0431 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c, \u0411\u043e\u0433 \u0430\u0434\u0430\u0440\u044b\u045e \u044f\u0435 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0439. \u041a\u0430\u043b\u0456 \u0451\u0439 \u043d\u0435 \u0445\u0430\u043f\u0430\u043b\u0430 \u0437\u044f\u043c\u043d\u044b\u0445 \u0441\u0440\u043e\u0434\u043a\u0430\u045e \u0434\u043b\u044f \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456 \u0456 \u0430\u0434\u0447\u0443\u0432\u0430\u043b\u0430 \u0441\u044f\u0431\u0435 \u0437\u043d\u044f\u0441\u0456\u043b\u0435\u043d\u0430\u0439, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0439 \u043c\u043e\u0446\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043c\u0443\u043a\u0456 \u044f\u043d\u0430 \u0431\u044b\u043b\u0430 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u044f \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0443\u0441\u0451, \u0447\u0430\u0433\u043e \u0447\u0430\u043a\u0430\u043b\u0456 \u0430\u0434 \u044f\u0435 \u0431\u043b\u0456\u0436\u043d\u0456\u044f, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0434\u0430 \u044f\u0435 \u0437 \u044f\u043a\u043e\u0439-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043f\u0430\u0442\u0440\u044d\u0431\u0430\u0439. \u0423\u0441\u0456\u043c, \u0445\u0442\u043e \u043f\u0440\u0430\u0441\u0456\u045e \u044f\u0435 \u0430\u0431 \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435, \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0430\u0431\u043e \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439, \u044f\u043d\u0430 \u0430\u043a\u0430\u0437\u0432\u0430\u043b\u0430 \u044f\u0435 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0439 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u044f\u0439.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 31,<\/span><span style=\"color: #ff0000;\"> 17. 18\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u042f\u043d\u0430 \u043f\u0430\u0434\u043f\u044f\u0440\u044d\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u043c\u043e\u0446\u0430\u0439 \u0456 \u045e\u043c\u0430\u0446\u043e\u0432\u0430\u0435 \u0440\u0443\u043a\u0456 \u0441\u0432\u0430\u0435. <\/span><span style=\"color: #ff0000;\">*<\/span><span style=\"color: #ff00ff;\"> <\/span><span>\u042f\u0435 \u043b\u044f\u043c\u043f\u0430 \u043d\u0435 \u0433\u0430\u0441\u043d\u0435 \u045e\u043d\u0430\u0447\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0414\u0430\u043b\u043e\u043d\u044c \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435 \u045e\u0431\u043e\u0433\u0430\u043c\u0443 \u0456 \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u043f\u0430\u0434\u0430\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u0430\u043c\u0443. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"793","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041c\u0430\u0440\u0433\u0430\u0440\u044b\u0442\u044b \u041c\u0430\u0440\u044b\u0456 \u0410\u043b\u044f\u043a\u043e\u043a, \u043f\u0430\u043d\u043d\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Vie et \u0152uvres 2, Paris 1915, 321. 336. 493. 554)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u0437\u043d\u0430\u0451\u043c \u043b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0430\u044f \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0443\u043c\u0430\u044e, \u0448\u0442\u043e \u043d\u0430\u0448 \u041f\u0430\u043d \u0433\u043e\u0440\u0430\u0447\u0430 \u0436\u0430\u0434\u0430\u0435, \u043a\u0430\u0431 \u042f\u0433\u043e \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u043c\u0443 \u0421\u044d\u0440\u0446\u0443 \u0430\u043a\u0430\u0437\u0432\u0430\u043b\u0430\u0441\u044f \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u044f \u043f\u0430\u0448\u0430\u043d\u0430 \u0434\u0437\u0435\u043b\u044f \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u0448\u0430\u0445 \u043f\u043b\u0430\u0434\u043e\u045e \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f. \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0435 \u0421\u044d\u0440\u0446\u0430 \u0415\u0437\u0443\u0441\u0430 \u2013 \u0433\u044d\u0442\u0430 \u043d\u0435\u0432\u044b\u0447\u044d\u0440\u043f\u043d\u0430\u044f \u043a\u0440\u044b\u043d\u0456\u0446\u0430, \u044f\u043a\u0430\u044f \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0435 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0441\u0430\u0431\u043e\u044e \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u044f \u0441\u044d\u0440\u0446\u044b, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u044f \u0456 \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0439 \u0432\u043e\u043b\u044f\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u0411\u043e\u0441\u043a\u0430\u0433\u0430 \u0421\u044d\u0440\u0446\u0430 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0432\u044b\u0446\u044f\u043a\u0430\u044e\u0446\u044c \u0442\u0440\u044b \u043f\u0430\u0442\u043e\u043a\u0456: \u043f\u0435\u0440\u0448\u044b \u2013 \u043f\u0430\u0442\u043e\u043a \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0434\u043b\u044f \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e, \u0448\u0442\u043e \u0434\u0430\u0435 \u0434\u0443\u0445\u0430 \u0436\u0430\u043b\u044e \u0456 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u044f; \u0434\u0440\u0443\u0433\u0456 \u2013 \u043f\u0430\u0442\u043e\u043a \u043b\u044e\u0431\u043e\u0432\u0456, \u0448\u0442\u043e \u043d\u044f\u0441\u0435 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u045e\u0441\u0456\u043c \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u043c\u0430\u0433\u043b\u0456 \u0437\u043d\u0430\u0439\u0441\u0446\u0456 \u0441\u0456\u043b\u044b \u0434\u043b\u044f \u043f\u0435\u0440\u0430\u0430\u0434\u043e\u043b\u0435\u043d\u043d\u044f \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u045e. \u0417 \u0442\u0440\u044d\u0446\u044f\u0433\u0430 \u043f\u0430\u0442\u043e\u043a\u0443 \u0432\u044b\u0446\u044f\u043a\u0430\u0435 \u043b\u044e\u0431\u043e\u045e \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u043b\u044f \u042f\u0433\u043e \u0432\u0435\u0440\u043d\u044b\u0445 \u0441\u044f\u0431\u0440\u043e\u045e, \u044f\u043a\u0456\u0445 \u0401\u043d \u043f\u0440\u0430\u0433\u043d\u0435 \u0437\u2019\u044f\u0434\u043d\u0430\u0446\u044c \u0437 \u0441\u0430\u0431\u043e\u044e, \u043f\u0435\u0440\u0430\u0434\u0430\u044e\u0447\u044b \u0456\u043c \u0441\u0432\u0430\u0451 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u043f\u0430-\u0441\u0432\u043e\u0435\u043c\u0443 \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u045e \u0441\u044f\u0431\u0435 \u0446\u0430\u043b\u043a\u0430\u043c \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044e \u042f\u0433\u043e \u0445\u0432\u0430\u043b\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0421\u044d\u0440\u0446\u0430 \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u0431\u0435\u0437\u043b\u0456\u0447 \u0440\u043e\u0437\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e, \u0434\u0430 \u042f\u0433\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0432\u044f\u0440\u0442\u0430\u0446\u0446\u0430 \u045e\u0431\u043e\u0433\u0456\u044f \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u043f\u0430\u0442\u0440\u044d\u0431\u0430\u0445. \u0413\u044d\u0442\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0443 \u044f\u043a\u043e\u0439 \u0437\u043d\u0456\u043a\u0430\u0435 \u045e\u0441\u044f \u043d\u0430\u0448\u0430\u044f \u0442\u0443\u0433\u0430. \u0413\u044d\u0442\u0430 \u0431\u0435\u0437\u0434\u0430\u043d\u044c \u043f\u0430\u043a\u043e\u0440\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043d\u0430\u0448\u0430\u0439 \u043f\u044b\u0445\u0456; \u0433\u044d\u0442\u0430 \u0431\u0435\u0437\u0434\u0430\u043d\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0434\u043b\u044f \u043d\u0435\u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u0445, \u0433\u044d\u0442\u0430, \u0443\u0440\u044d\u0448\u0446\u0435, \u0431\u0435\u0437\u0434\u0430\u043d\u044c \u043b\u044e\u0431\u043e\u0432\u0456, \u0443 \u044f\u043a\u043e\u0439 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0441\u0445\u0430\u0432\u0430\u0446\u044c \u0443\u0441\u044e \u043d\u0430\u0448\u0443\u044e \u0433\u0430\u043b\u0435\u0447\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0430 \u045e\u0441\u0456\u043c, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u0435, \u0456\u043c\u043a\u043d\u0456\u0446\u0435\u0441\u044f \u044f\u0434\u043d\u0430\u0446\u0446\u0430 \u0437 \u0421\u044d\u0440\u0446\u0430\u043c \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0421\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u2013 \u043a\u0430\u0431 \u043d\u0430\u043b\u0435\u0436\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u0441\u044f\u0431\u0435, \u043f\u0430\u0441\u043b\u044f \u2013 \u043a\u0430\u0431 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435. \u041d\u044f\u043c\u0430 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0440\u0430\u0437\u0432\u0456\u0446\u0446\u044f \u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0435? \u0410\u0445\u0432\u044f\u0440\u0443\u0439\u0446\u0435 \u0411\u043e\u0433\u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u044f\u043a\u0443\u044e \u0411\u043e\u0441\u043a\u0456 \u0417\u0431\u0430\u045e\u0446\u0430 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0437\u0430 \u043d\u0430\u0441 \u0443 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u044b\u043c \u0421\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0446\u0435 \u0410\u043b\u0442\u0430\u0440\u0430. \u0410\u0445\u0432\u044f\u0440\u0443\u0439\u0446\u0435 \u042f\u0433\u043e \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044c \u044f\u043a \u043a\u0430\u043c\u043f\u0435\u043d\u0441\u0430\u0446\u044b\u044e \u0437\u0430 \u0432\u0430\u0448\u0443\u044e \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u0430\u0441\u0446\u044c. \u0412\u0430 \u045e\u0441\u0456\u043c, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u0435, \u043a\u0430\u0436\u044b\u0446\u0435: \u00ab\u0411\u043e\u0436\u0430 \u043c\u043e\u0439, \u0440\u0430\u0431\u043b\u044e \u0433\u044d\u0442\u0430 \u0430\u0431\u043e \u0446\u044f\u0440\u043f\u043b\u044e \u045e \u0421\u044d\u0440\u0446\u044b \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e, \u044f\u043a\u0456\u044f \u0430\u0445\u0432\u044f\u0440\u0443\u044e \u0422\u0430\u0431\u0435 \u044f\u043a \u043a\u0430\u043c\u043f\u0435\u043d\u0441\u0430\u0446\u044b\u044e \u0437\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0433\u0440\u044d\u0448\u043d\u0430\u0435 \u0456 \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u045e \u043c\u0430\u0456\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u0445\u00bb. \u0422\u0430\u043a \u0440\u0430\u0431\u0456\u0446\u0435 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0430\u0431\u0441\u0442\u0430\u0432\u0456\u043d\u0430\u0445 \u0436\u044b\u0446\u0446\u044f. \u041a\u0430\u043b\u0456 \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0435 \u0432\u0430\u0441 \u043d\u0435\u0439\u043a\u0430\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435, \u0441\u043c\u0443\u0442\u0430\u043a \u0446\u0456 \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043a\u0430\u0436\u044b\u0446\u0435 \u0441\u0430\u0431\u0435: \u00ab\u041f\u0440\u044b\u043c\u0430\u044e \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u043b\u044f \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u044f \u0437 \u0442\u0430\u0431\u043e\u044e \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u0442\u0430\u0431\u0435 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0435 \u0421\u044d\u0440\u0446\u0430 \u0415\u0437\u0443\u0441\u0430\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c, \u0437\u0430\u0445\u0430\u0432\u0430\u0439\u0446\u0435 \u0441\u043f\u0430\u043a\u043e\u0439 \u0441\u044d\u0440\u0446\u0430, \u044f\u043a\u0456 \u0431\u043e\u043b\u044c\u0448\u044b \u0437\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456 \u0441\u043a\u0430\u0440\u0431. \u041d\u0456\u0448\u0442\u043e \u0442\u0430\u043a \u043d\u0435 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u044f\u0433\u043e \u0437\u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c, \u044f\u043a \u0432\u044b\u0440\u0430\u0447\u044d\u043d\u043d\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u0432\u043e\u043b\u0456 \u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u0435 \u0437\u0430\u043c\u0435\u0441\u0442 \u044f\u0435 \u0432\u043e\u043b\u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044d\u0440\u0446\u0430, \u043a\u0430\u0431 \u044f\u043d\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u0430 \u045e \u043d\u0430\u0441 \u0443\u0441\u0451, \u0448\u0442\u043e \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u042f\u0433\u043e \u0445\u0432\u0430\u043b\u0435, \u0430 \u043c\u044b \u043a\u0430\u0431 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u043b\u0456\u0441\u044f \u0451\u0439 \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u0451\u0439 \u0434\u0430\u0432\u044f\u0440\u0430\u043b\u0456.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0446 11, 25-26; \u041f\u0441 73 (72), 26b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e \u0426\u044f\u0431\u0435, \u041e\u0439\u0447\u0430, \u041f\u0430\u043d\u0435 \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u0456, \u0448\u0442\u043e \u0422\u044b \u0437\u0430\u043a\u0440\u044b\u045e \u0433\u044d\u0442\u0430 \u0430\u0434 \u043c\u0443\u0434\u0440\u044b\u0445 \u0456 \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445 \u0456 \u0430\u0434\u043a\u0440\u044b\u045e \u0433\u044d\u0442\u0430 \u0434\u0437\u0435\u0446\u044f\u043c. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0422\u0430\u043a, \u041e\u0439\u0447\u0430, \u0431\u043e \u0442\u0430\u043a \u0431\u044b\u043b\u043e \u0422\u0430\u0431\u0435 \u0434\u0430\u0441\u043f\u0430\u0434\u043e\u0431\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u043e\u0433 \u2013 \u0441\u043a\u0430\u043b\u0430 \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0456 \u043c\u0430\u044f \u0434\u043e\u043b\u044f \u043d\u0430\u0432\u0435\u043a\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043a.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"794","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u0420\u044b\u043c\u043b\u044f\u043d\u0430\u045e\u00bb \u0441\u0432. \u0406\u0433\u043d\u0430\u0446\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 4, 1-2; 6, 1 \u2014 8, 3: Funk 1, 217-223)&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u042f \u2013 \u0411\u043e\u0436\u0430\u044f \u043f\u0448\u0430\u043d\u0456\u0446\u0430: \u0437\u043c\u0435\u043b\u044e\u0446\u044c \u043c\u044f\u043d\u0435 \u0437\u0443\u0431\u044b \u0437\u0432\u044f\u0440\u043e\u045e&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0456\u0448\u0443 \u045e\u0441\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e \u045e\u0441\u0456\u043c, \u0448\u0442\u043e \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0430\u043c\u0440\u0443 \u0437\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u043c\u043d\u0435 \u045e \u0433\u044d\u0442\u044b\u043c \u043d\u0435 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u0446\u0435. \u041f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441: \u043d\u0435 \u0430\u043a\u0430\u0437\u0432\u0430\u0439\u0446\u0435 \u043c\u043d\u0435 \u0437\u0430\u045e\u0447\u0430\u0441\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u0414\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u043c\u043d\u0435 \u0441\u0442\u0430\u0446\u044c \u0435\u0436\u0430\u044e \u0434\u043b\u044f \u0437\u0432\u044f\u0440\u043e\u045e, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u0456\u043c \u044f \u0434\u0430\u0439\u0434\u0443 \u0434\u0430 \u0411\u043e\u0433\u0430. \u042f \u2013 \u0411\u043e\u0436\u0430\u044f \u043f\u0448\u0430\u043d\u0456\u0446\u0430: \u043d\u044f\u0445\u0430\u0439 \u0440\u0430\u0441\u0442\u0440\u0443\u0448\u0447\u0430\u0446\u044c \u043c\u044f\u043d\u0435 \u0437\u0443\u0431\u044b \u0437\u0432\u044f\u0440\u043e\u045e, \u043a\u0430\u0431 \u044f \u0441\u0442\u0430\u045e \u0447\u044b\u0441\u0442\u044b\u043c \u0445\u043b\u0435\u0431\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430. \u041f\u0440\u0430\u0441\u0456\u0446\u0435 \u0437\u0430 \u043c\u044f\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u044b\u0445 \u0437\u0432\u044f\u0440\u043e\u045e \u044f \u0441\u0442\u0430\u045e \u0430\u0445\u0432\u044f\u0440\u043d\u044b\u043c \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u0435\u043c \u0434\u043b\u044f \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0456\u044f\u043a\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u043d\u0435 \u043f\u0440\u044b\u043d\u044f\u0441\u0443\u0446\u044c \u043c\u043d\u0435 \u0437\u044f\u043c\u043d\u044b\u044f \u0437\u0430\u0434\u0430\u0432\u0430\u043b\u044c\u043d\u0435\u043d\u043d\u0456 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u041b\u0435\u043f\u0448 \u043c\u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0447\u044b\u043c \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0443\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0451\u0439. \u042f \u0448\u0443\u043a\u0430\u044e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u043d\u0430\u0441; \u043f\u0440\u0430\u0433\u043d\u0443 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441. \u041d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u043c\u0430\u0451 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435. \u041f\u0440\u0430\u0431\u0430\u0447\u0446\u0435 \u043c\u043d\u0435, \u0431\u0440\u0430\u0442\u044b! \u041d\u0435 \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0439\u0446\u0435 \u043c\u043d\u0435 \u0436\u044b\u0446\u044c, \u043d\u0435 \u0436\u0430\u0434\u0430\u0439\u0446\u0435, \u043a\u0430\u0431 \u043f\u0430\u043c\u0451\u0440. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f \u0436\u0430\u0434\u0430\u044e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0411\u043e\u0433\u0443, \u043d\u0435 \u0430\u0434\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u043c\u044f\u043d\u0435 \u0441\u0432\u0435\u0442\u0443 \u0456 \u043d\u0435 \u0437\u0432\u043e\u0434\u0437\u044c\u0446\u0435 \u043c\u044f\u043d\u0435 \u0442\u044b\u043c, \u0448\u0442\u043e \u0437\u044f\u043c\u043d\u043e\u0435. \u0414\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u043c\u043d\u0435 \u043d\u0430\u0441\u044b\u0447\u0430\u0446\u0446\u0430 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c. \u041a\u0430\u043b\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u044e \u044f\u0433\u043e, \u0431\u0443\u0434\u0443 \u043f\u043e\u045e\u043d\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c. \u0414\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u043c\u043d\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u043c\u0443\u043a\u0443 \u043c\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043c\u0430\u0435 \u042f\u0433\u043e \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435, \u0447\u0430\u0433\u043e \u044f \u043f\u0440\u0430\u0433\u043d\u0443, \u0456 \u0430\u043a\u0430\u0436\u0430 \u043c\u043d\u0435 \u0441\u0432\u0430\u0451 \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u0435, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u043c\u044f\u043d\u0435 \u0442\u0443\u0440\u0431\u0443\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u043d\u044f\u0437\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0445\u043e\u0447\u0430 \u0441\u0445\u0430\u043f\u0456\u0446\u044c \u043c\u044f\u043d\u0435 \u0456 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u0446\u044c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430. \u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u0437 \u0432\u0430\u0441 \u044f\u0433\u043e \u043d\u0435 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435. \u041b\u0435\u043f\u0448 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u043d\u0430 \u043c\u0430\u0456\u043c \u0431\u0430\u043a\u0443, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u0430 \u0431\u0430\u043a\u0443 \u0411\u043e\u0433\u0430. \u041d\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u043b\u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0456\u043c\u043a\u043d\u0456\u0446\u0451\u0441\u044f \u0431\u044b\u0446\u044c \u0443 \u0441\u0432\u0435\u0446\u0435. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e \u0432\u0430\u0441 \u0437\u0430\u0439\u0437\u0434\u0440\u0430\u0441\u0446\u0456. \u041d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u0431 \u044f \u043f\u0440\u0430\u0441\u0456\u045e, \u0431\u0443\u0434\u0443\u0447\u044b \u045e \u0432\u0430\u0441, \u043d\u0435 \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435; \u043f\u0430\u0432\u0435\u0440\u0446\u0435 \u043b\u0435\u043f\u0448 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u043f\u0456\u0448\u0443 \u0432\u0430\u043c. \u0410 \u043f\u0456\u0448\u0443, \u0431\u0443\u0434\u0443\u0447\u044b \u0436\u044b\u0432\u044b\u043c, \u0430\u043b\u0435 \u043f\u0440\u0430\u0433\u043d\u0443 \u0441\u043c\u0435\u0440\u0446\u0456. \u041c\u0430\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0456 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b\u044f, \u0456 \u043d\u044f\u043c\u0430 \u0431\u043e\u043b\u044c\u0448 \u0443\u0432\u0430 \u043c\u043d\u0435 \u0437\u044f\u043c\u043d\u043e\u0439 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0422\u043e\u043b\u044c\u043a\u0456 \u0436\u044b\u0432\u0430\u044f \u0432\u0430\u0434\u0430 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u0434\u0430 \u043c\u044f\u043d\u0435 \u0437 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0441\u044d\u0440\u0446\u0430 \u0456 \u043a\u0430\u0436\u0430: \u00ab\u0406\u0434\u0437\u0456 \u0434\u0430 \u0410\u0439\u0446\u0430\u00bb. \u041d\u0435 \u0440\u0430\u0434\u0443\u0435 \u043c\u044f\u043d\u0435 \u0442\u043b\u0435\u043d\u043d\u0430\u044f \u0435\u0436\u0430 \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0435\u0442\u0443. \u042f \u0436\u0430\u0434\u0430\u044e \u0411\u043e\u0436\u0430\u0433\u0430 \u0445\u043b\u0435\u0431\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0426\u0435\u043b\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437 \u0440\u043e\u0434\u0443 \u0414\u0430\u0432\u0456\u0434\u0430, \u0456 \u043d\u0430\u043f\u043e\u044e, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u042f\u0433\u043e \u041a\u0440\u043e\u045e \u2013 \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u0445\u0430\u0447\u0443 \u0431\u043e\u043b\u044c\u0448 \u0436\u044b\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0406 \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435, \u043a\u0430\u043b\u0456 \u0432\u044b \u0437\u0430\u0445\u043e\u0447\u0430\u0446\u0435. \u0423 \u0433\u044d\u0442\u044b\u0445 \u043a\u0430\u0440\u043e\u0442\u043a\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u043f\u0430\u0432\u0435\u0440\u0446\u0435 \u043c\u043d\u0435: \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0432\u0430\u043c \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u0448\u0447\u044b\u0440\u0430 \u043a\u0430\u0436\u0443. \u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0432\u0443\u0441\u043d\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e \u0410\u0439\u0446\u0435\u0446. \u041c\u0430\u043b\u0456\u0446\u0435\u0441\u044f \u0437\u0430 \u043c\u044f\u043d\u0435, \u043a\u0430\u0431 \u044f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u042f\u0433\u043e. \u042f \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0432\u0430\u043c, \u043a\u0456\u0440\u0443\u044e\u0447\u044b\u0441\u044f \u043d\u0435 \u043b\u044e\u0434\u0441\u043a\u0456\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c, \u0430\u043b\u0435 \u0411\u043e\u0436\u044b\u043c. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u0446\u044f\u0440\u043f\u0435\u0446\u044c, \u0433\u044d\u0442\u0430 \u0441\u0442\u0430\u043d\u0435 \u0437\u043d\u0430\u043a\u0430\u043c \u0432\u0430\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u043c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b, \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0430\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0432\u0430\u0448\u0443\u044e \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0456\u0448\u0442\u043e \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0430\u0434 \u0432\u0430\u0441, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043c\u0435\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u0432\u0435\u0440\u0443 \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0456\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u0456 \u043c\u044d\u0442\u0430\u044e \u0436\u044b\u0446\u0446\u044f. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u041f\u0430\u0447\u0430\u0442\u0430\u043a \u2013 \u0433\u044d\u0442\u0430 \u0432\u0435\u0440\u0430, \u043c\u044d\u0442\u0430 \u2013 \u043b\u044e\u0431\u043e\u045e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u0410\u043f\u0440\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u045e \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u0435\u0441\u044f \u045e \u0432\u0435\u0440\u044b, \u044f\u043a\u043e\u0439 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0426\u0435\u043b\u0430 \u041f\u0430\u043d\u0430, \u0456 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u044f\u043a\u043e\u0439 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041a\u0440\u043e\u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. <\/span><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041f\u0430\u0447\u0430\u0442\u0430\u043a.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"795","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f\u00bb \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 17, 1-3: PL 76, 1139)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u043d \u0456\u0434\u0437\u0435 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u043c\u0456<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u043d\u0430\u0448 \u041f\u0430\u043d \u0456 \u0417\u0431\u0430\u045e\u0446\u0430 \u0434\u0430\u0435 \u043d\u0430\u043c \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0447\u0430\u0441\u0430\u043c \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0430 \u0447\u0430\u0441\u0430\u043c \u0443\u0447\u044b\u043d\u043a\u0430\u043c\u0456. \u0422\u0430\u043c\u0443 \u042f\u0433\u043e \u045e\u0447\u044b\u043d\u043a\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043d\u0430\u043a\u0430\u0437\u0430\u043c\u0456, \u0431\u043e \u043a\u0430\u043b\u0456 \u0401\u043d \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0440\u043e\u0431\u0456\u0446\u044c, \u0442\u043e \u043c\u043e\u045e\u0447\u043a\u0456 \u0434\u0430\u0435 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0448\u0442\u043e \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0440\u0430\u0431\u0456\u0446\u044c. \u0412\u043e\u0441\u044c \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u043f\u0430 \u0434\u0432\u043e\u0435 \u0432\u0443\u0447\u043d\u044f\u045e \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c, \u0431\u043e \u0451\u0441\u0446\u044c \u0434\u0437\u0432\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u043b\u044e\u0431\u043e\u0432\u0456: \u0411\u043e\u0433\u0430 \u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043d \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u0432\u0443\u0447\u043d\u044f\u045e \u043f\u0430 \u0434\u0432\u043e\u0435 \u0437 \u043f\u0430\u0441\u043b\u0443\u0433\u0430\u0439 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f, \u043a\u0430\u0431 \u043d\u0430\u043c \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430 \u045e\u0441\u0432\u044f\u0434\u043e\u043c\u0456\u0446\u044c, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u043d\u0456\u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0437\u0430\u0439\u043c\u0430\u0446\u0446\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0441\u043a\u0430\u0437\u0430\u043d\u0430, \u0448\u0442\u043e \u0401\u043d \u00ab\u043f\u0430\u0441\u043b\u0430\u045e \u0456\u0445 \u043f\u0430 \u0434\u0432\u043e\u0435 \u043f\u0435\u0440\u0430\u0434 \u0441\u0430\u0431\u043e\u044e \u045e \u043a\u043e\u0436\u043d\u044b \u0433\u043e\u0440\u0430\u0434 \u0456 \u043c\u0435\u0441\u0446\u0430, \u043a\u0443\u0434\u044b \u0441\u0430\u043c \u043c\u0435\u045e\u0441\u044f \u043f\u0430\u0439\u0441\u0446\u0456\u00bb (\u041b\u043a 10, 1). \u0411\u043e \u041f\u0430\u043d \u0456\u0434\u0437\u0435 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u043c\u0456 \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0436\u044b\u043b\u043b\u0451 \u0440\u043e\u0437\u0443\u043c\u0443, \u043a\u0430\u043b\u0456 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u0447\u0430\u044e\u0446\u044c \u042f\u043c\u0443 \u0441\u043b\u043e\u0432\u044b \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f, \u043a\u0430\u043b\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0440\u043e\u0437\u0443\u043c \u043f\u0440\u044b\u043c\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0443. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043c\u0443 \u043f\u0440\u0430\u0440\u043e\u043a \u0406\u0441\u0430\u044f \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e: \u00ab\u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439\u0446\u0435 \u0434\u0430\u0440\u043e\u0433\u0443 \u041f\u0430\u043d\u0443, \u0440\u0430\u045e\u043d\u044f\u0439\u0446\u0435 \u045e \u0441\u0442\u044d\u043f\u0435 \u0448\u043b\u044f\u0445 \u043d\u0430\u0448\u0430\u043c\u0443 \u0411\u043e\u0433\u0443!\u00bb (\u0406\u0441 40, 3). \u0410 \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442 \u043a\u0430\u0436\u0430: \u00ab\u041f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439\u0446\u0435 \u0448\u043b\u044f\u0445 \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c, \u0445\u0442\u043e \u045e\u0437\u043d\u0451\u0441\u0441\u044f \u0432\u044b\u0448\u044d\u0439 \u0437\u0430\u0445\u0430\u0434\u0443\u00bb (\u041f\u0441 68 [67], 5 Vlg). \u041f\u0430\u043d \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u045e\u0437\u043d\u0451\u0441\u0441\u044f \u0432\u044b\u0448\u044d\u0439 \u0437\u0430\u0445\u0430\u0434\u0443, \u0431\u043e \u044f\u043a \u043f\u0440\u0430\u0437 \u043c\u0443\u043a\u0443 \u0401\u043d \u0430\u043a\u0443\u043d\u0443\u045e\u0441\u044f \u045e \u0441\u043c\u0435\u0440\u0446\u044c, \u0442\u0430\u043a \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0430\u0431\u2019\u044f\u0432\u0456\u045e \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0445\u0432\u0430\u043b\u0443. \u0423\u0437\u043d\u0451\u0441\u0441\u044f \u0432\u044b\u0448\u044d\u0439 \u0437\u0430\u0445\u0430\u0434\u0443, \u0431\u043e \u0441\u0432\u0430\u0456\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435\u043c \u043f\u0430\u0442\u0430\u043f\u0442\u0430\u045e \u0441\u043c\u0435\u0440\u0446\u044c, \u044f\u043a\u0443\u044e \u0441\u043f\u0430\u0437\u043d\u0430\u045e. \u041c\u044b \u0436 \u0440\u044b\u0445\u0442\u0443\u0435\u043c \u0434\u0430\u0440\u043e\u0433\u0443 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u045e\u0437\u043d\u0451\u0441\u0441\u044f \u043f\u0430-\u043d\u0430\u0434 \u0437\u0430\u0445\u0430\u0434\u0430\u043c, \u043a\u0430\u043b\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0432\u0430\u043c \u042f\u0433\u043e \u0445\u0432\u0430\u043b\u0443, \u043a\u0430\u0431 \u0401\u043d, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0432\u0430\u0441 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044e \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c, \u0448\u0442\u043e \u0401\u043d \u043a\u0430\u0436\u0430, \u043f\u0430\u0441\u044b\u043b\u0430\u044e\u0447\u044b \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e: \u00ab\u0416\u043d\u0456\u0432\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0435, \u0434\u044b \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043c\u0430\u043b\u0430; \u0442\u0430\u043c\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u0435 \u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0436\u043d\u0456\u0432\u0430, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u0430\u045e \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043d\u0430 \u0436\u043d\u0456\u0432\u043e \u0441\u0432\u0430\u0451\u00bb (\u041c\u0446 9, 37-38). \u041c\u0430\u043b\u0430 \u043f\u0440\u0430\u0446\u0430\u045e\u043d\u0456\u043a\u043e\u045e \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0436\u043d\u0456\u0432\u0435! \u041d\u0435 \u043c\u043e\u0436\u0430\u043c \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u0431\u0435\u0437 \u0433\u043e\u0440\u044b\u0447\u044b, \u0431\u043e, \u0445\u043e\u0446\u044c \u0456 \u0451\u0441\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u045e \u0431\u044b \u0434\u043e\u0431\u0440\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u0430\u0434\u043d\u0430\u043a \u043d\u044f\u043c\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0456\u0445 \u043c\u043e\u0433 \u0431\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c. \u0423 \u0441\u0432\u0435\u0446\u0435 \u0448\u043c\u0430\u0442 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e, \u0430\u043b\u0435 \u043d\u0430 \u0436\u043d\u0456\u0432\u0435 \u041f\u0430\u043d\u0430 \u0432\u0435\u043b\u044c\u043c\u0456 \u0440\u044d\u0434\u043a\u0430 \u043c\u043e\u0436\u043d\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u043f\u0440\u0430\u0446\u0430\u045e\u043d\u0456\u043a\u043e\u045e. \u0411\u043e \u043c\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043f\u0430\u0441\u043b\u0443\u0433\u0443 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u0430\u043b\u0435 \u043d\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u043c \u0437\u0430\u0434\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u0451\u0439. \u0422\u0430\u043c\u0443 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043d\u0430\u0434 \u0433\u044d\u0442\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: \u00ab\u041f\u0440\u0430\u0441\u0456\u0446\u0435 \u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0436\u043d\u0456\u0432\u0430, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u0430\u045e \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e \u043d\u0430 \u0436\u043d\u0456\u0432\u043e \u0441\u0432\u0430\u0451\u00bb. \u0412\u044b \u043f\u0440\u0430\u0441\u0456\u0446\u0435 \u0437\u0430 \u043d\u0430\u0441, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u043d\u0430\u043b\u0435\u0436\u043d\u0430 \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0434\u043b\u044f \u0432\u0430\u0441; \u043a\u0430\u0431 \u043d\u0430\u0448 \u044f\u0437\u044b\u043a \u043d\u0435 \u0441\u0442\u0430\u043c\u043b\u044f\u045e\u0441\u044f \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0446\u044c; \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0437\u0430\u0434\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430, \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u0448\u0430\u0435 \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0435 \u043d\u0435 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u0435 \u043d\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c \u0421\u0443\u0434\u0434\u0437\u0451\u044e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440<\/span><span style=\"color: #ff0000;\">. \u041b\u043a 1, 3. 4; \u0414\u0437 1, 1\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041b\u0443\u043a\u0430 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430 \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u0443\u0441\u0451 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0456 \u0430\u043f\u0456\u0441\u0430\u045e \u0443\u0441\u0451 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0441\u0446\u044c \u0442\u0430\u0433\u043e, \u0447\u0430\u043c\u0443 \u0431\u044b\u043b\u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0420\u0430\u0441\u043a\u0430\u0437\u0430\u045e<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u043f\u0440\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0440\u0430\u0431\u0456\u045e \u0415\u0437\u0443\u0441 \u0456 \u0447\u0430\u043c\u0443 \u0432\u0443\u0447\u044b\u045e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431 \u043c\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"796","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u0414\u0443\u0445\u043e\u045e\u043d\u044b \u0434\u0437\u0451\u043d\u043d\u0456\u043a\u00bb \u0441\u0432. \u0416\u0430\u043d\u0430 \u0434\u044d \u0411\u0440\u044d\u0431\u0451\u0444\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">&nbsp;(The Jesuit Relations and Allied Documents, The Burrow Brothers Co, Cleveland 1898, 164. 166)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041a\u0430\u0431 \u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0456\u043d\u0430\u043a\u0448, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0426\u044f\u0431\u0435, \u0415\u0437\u0443, \u044f\u043a\u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0434\u0437\u0435\u043b\u044f \u043c\u044f\u043d\u0435&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0426\u044f\u0433\u0430\u043c \u0434\u0432\u0443\u0445 \u0434\u0437\u0451\u043d \u044f \u0433\u043e\u0440\u0430\u0447\u0430 \u0436\u0430\u0434\u0430\u045e \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u043a\u0443\u044e \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0437\u043d\u0435\u0441\u0446\u0456 \u045e\u0441\u0435 \u043a\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0456, \u044f\u043a\u0456\u044f \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u043b\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u043e\u0439 \u0415\u0437\u0443, \u041f\u0430\u043d\u0435 \u0456 \u0417\u0431\u0430\u045e\u0446\u0430, \u0447\u044b\u043c \u0436\u0430 \u044f \u043c\u0430\u0433\u0443 \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u0437\u0430 \u045e\u0441\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b, \u044f\u043a\u0456\u043c\u0456 \u0422\u044b \u043c\u044f\u043d\u0435 \u0430\u0434\u043e\u0440\u0432\u0430\u0435\u0448? \u00ab\u041a\u0435\u043b\u0456\u0445\u00bb \u0422\u0432\u0430\u0456\u0445 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u0437 \u0422\u0432\u0430\u0451\u0439 \u0440\u0443\u043a\u0456 \u043f\u0440\u044b\u043c\u0443 \u00ab\u0456 \u0431\u0443\u0434\u0443 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0456\u043c\u044f \u041f\u0430\u043d\u0430\u00bb (\u043f\u0430\u0440. \u041f\u0441 116 [115], 13). \u041f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0430 \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043f\u0435\u0440\u0430\u0434 \u0422\u0432\u0430\u0451\u0439 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u041c\u0430\u0446\u0456 \u0456 \u042f\u0435 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u044b\u043c \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430\u043c, \u043f\u0435\u0440\u0430\u0434 \u0430\u043d\u0451\u043b\u0430\u043c\u0456, \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u043c\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0435\u0440\u0430\u0434 \u043c\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u044b\u043c \u0430\u0439\u0446\u043e\u043c \u0406\u0433\u043d\u0430\u0446\u044b\u0435\u043c, \u0441\u0432\u044f\u0442\u044b\u043c \u0424\u0440\u0430\u043d\u0446\u0456\u0448\u043a\u0430\u043c \u041a\u0441\u0430\u0432\u0435\u0440\u044b\u0435\u043c \u0430\u0431\u044f\u0446\u0430\u044e \u0422\u0430\u0431\u0435 \u0432\u0435\u043b\u044c\u043c\u0456 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430, \u043c\u043e\u0439 \u0415\u0437\u0443, \u0417\u0431\u0430\u045e\u0446\u0430, \u0448\u0442\u043e \u043d\u0435 \u0430\u0434\u043a\u0456\u043d\u0443 \u043b\u0430\u0441\u043a\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434 \u043c\u044f\u043d\u0435 \u0456 \u043a\u0430\u043b\u0456 \u0422\u044b \u045e \u0441\u0432\u0430\u0451\u0439 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u0435\u0448 \u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043c\u044f\u043d\u0435 \u0451\u044e, \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0433\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt;\"><span>\u0410\u0431\u044f\u0446\u0430\u044e, \u0448\u0442\u043e \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u045e\u0441\u044f\u0433\u043e \u043c\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u0435 \u0430\u0434\u0432\u0435\u0434\u0437\u0435\u043d\u0430 \u043c\u043d\u0435, \u044f \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u044e \u0441\u0430\u0431\u0435 \u045e\u0445\u0456\u043b\u044f\u0446\u0446\u0430 \u0430\u0434 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u0456 \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0456 \u043f\u0440\u0430\u043b\u0456\u0446\u044c \u043a\u0440\u043e\u045e \u0437\u0430 \u0426\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u0456\u043d\u0448\u0430\u0435 \u044f \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u0431\u044b \u0431\u043e\u043b\u044c\u0448 \u0433\u043e\u0434\u043d\u044b\u043c \u0422\u0432\u0430\u0451\u0439 \u0445\u0432\u0430\u043b\u044b. \u0410\u0431\u044f\u0446\u0430\u044e \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u044f \u043a\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0456, \u043f\u0440\u044b\u043c\u0443 \u0456\u0445 \u0437 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0437\u0430\u0434\u0430\u0432\u0430\u043b\u044c\u043d\u0435\u043d\u043d\u0435\u043c \u0437 \u0422\u0432\u0430\u0451\u0439 \u0440\u0443\u043a\u0456. \u0422\u0430\u043c\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u0415\u0437\u0443, \u0443\u0436\u043e \u0446\u044f\u043f\u0435\u0440 \u0437 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0430\u0445\u0432\u044f\u0440\u0443\u044e \u0422\u0430\u0431\u0435 \u043c\u0430\u044e \u043a\u0440\u043e\u045e, \u0446\u0435\u043b\u0430 \u0456 \u0436\u044b\u0446\u0446\u0451, \u043a\u0430\u0431 \u0437 \u0422\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456, \u044f\u043a\u0443\u044e, \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043c\u043d\u0435 \u0434\u0430\u0441\u0456, \u044f \u043d\u0435 \u043f\u0430\u043c\u0451\u0440 \u0456\u043d\u0430\u043a\u0448, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u0435\u043b\u044f \u0426\u044f\u0431\u0435, \u0431\u043e \u0422\u044b \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0437\u0430 \u043c\u044f\u043d\u0435. \u0414\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u043c\u043d\u0435 \u0442\u0430\u043a \u0436\u044b\u0446\u044c, \u043a\u0430\u0431 \u044f \u043c\u043e\u0433 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0430\u0434 \u0426\u044f\u0431\u0435 \u0434\u0430\u0440 \u0433\u044d\u0442\u0430\u0439 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456. \u0422\u0430\u043a, \u043c\u043e\u0439 \u0411\u043e\u0433 \u0456 \u0417\u0431\u0430\u045e\u0446\u0430, \u044f \u00ab\u043f\u0440\u044b\u043c\u0443 \u043a\u0435\u043b\u0456\u0445\u00bb \u0422\u0432\u0430\u0439\u0433\u043e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f \u0437 \u0440\u0443\u043a\u0456 \u0422\u0432\u0430\u0451\u0439 \u00ab\u0456 \u0431\u0443\u0434\u0443 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0456\u043c\u044f\u00bb \u0422\u0432\u0430\u0451: \u0415\u0437\u0443, \u0415\u0437\u0443, \u0415\u0437\u0443!<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt;\"><span>\u0411\u043e\u0436\u0430 \u043c\u043e\u0439, \u044f\u043a \u0436\u0430 \u044f \u0446\u044f\u0440\u043f\u043b\u044e, \u0448\u0442\u043e \u044f\u043d\u044b \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0426\u044f\u0431\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u0430\u044f \u043a\u0440\u0430\u0456\u043d\u0430 \u044f\u0448\u0447\u044d \u045e\u0441\u044f \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0434\u0430 \u0426\u044f\u0431\u0435, \u0448\u0442\u043e \u0433\u0440\u044d\u0445 \u044f\u0448\u0447\u044d \u0430\u0434\u0441\u044e\u043b\u044c \u043d\u0435 \u0432\u044b\u043a\u0430\u0440\u0430\u043d\u0435\u043d\u044b! \u0411\u043e\u0436\u0430 \u043c\u043e\u0439, \u043a\u0430\u043b\u0456 \u0431 \u0443\u0432\u0435\u0441\u044c \u0441\u043c\u0443\u0442\u0430\u043a, \u044f\u043a\u0456 \u045e \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u0430\u0456\u043d\u0435 \u0446\u0435\u0440\u043f\u044f\u0446\u044c \u0432\u044f\u0437\u043d\u0456, \u0440\u0430\u0437\u0430\u043c \u0437 \u0441\u0443\u0440\u043e\u0432\u044b\u043c\u0456 \u0437\u0434\u0437\u0435\u043a\u0430\u043c\u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u043b\u0456 \u0431 \u0441\u0443\u0441\u0442\u0440\u044d\u0446\u044c \u043c\u044f\u043d\u0435, \u0442\u043e \u044f \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0437\u0433\u0430\u0434\u0436\u0430\u044e\u0441\u044f \u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0456\u0445 \u0441\u0430\u043c.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0413\u0431\u0440 11, 33a. 34b. \u043f\u0430\u0440. 39; \u041c\u0434\u0440 3, 5b<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0421\u0432\u044f\u0442\u044b\u044f \u0432\u0435\u0440\u0430\u044e \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u043b\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u044b, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456, \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u043b\u0456\u0441\u044f \u043c\u043e\u0446\u043d\u044b\u043c\u0456 \u043d\u0430 \u0432\u0430\u0439\u043d\u0435. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0423\u0441\u0435 \u044f\u043d\u044b \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u043e\u0433 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0456\u0445 \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u045e \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u0441\u044f\u0431\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0423\u0441\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"797","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041f\u0430\u045e\u043b\u0430 \u0430\u0434 \u041a\u0440\u044b\u0436\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 1, 43; 2, 440. 825)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0412\u0435\u043b\u044c\u043c\u0456 \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u044f \u0456 \u0441\u0432\u044f\u0442\u0430\u044f \u0440\u044d\u0447 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043f\u0440\u0430 \u043c\u0443\u043a\u0443 \u041f\u0430\u043d\u0430 \u0456 \u043c\u0435\u0434\u044b\u0442\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0451\u0439, \u0431\u043e \u0433\u044d\u0442\u044b \u0448\u043b\u044f\u0445 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0437\u0432\u044b\u0448\u043f\u0440\u044b\u0440\u043e\u0434\u043d\u0430\u0439 \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u0456 \u0437 \u0411\u043e\u0433\u0430\u043c. \u0423 \u0433\u044d\u0442\u0430\u0439 \u0441\u0432\u044f\u0442\u043e\u0439 \u0448\u043a\u043e\u043b\u0435 \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c. \u0422\u0430\u043c \u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u045e\u0441\u0435 \u0441\u0432\u044f\u0442\u044b\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u043a\u0440\u044b\u0436 \u043d\u0430\u0439\u0441\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u0437\u0430\u043a\u0430\u0440\u0430\u043d\u0456\u0446\u0446\u0430 \u045e \u0432\u0430\u0448\u044b\u043c \u0441\u044d\u0440\u0446\u044b, \u0442\u0430\u0434\u044b \u0432\u044b \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0430\u043a\u043b\u0456\u0447\u0430\u0446\u0435: \u00ab\u0426\u044f\u0440\u043f\u0435\u0446\u044c \u0456 \u043d\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c\u00bb, \u0430\u0431\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u00ab\u0426\u044f\u0440\u043f\u0435\u0446\u044c \u0446\u0456 \u043f\u0430\u043c\u0435\u0440\u0446\u0456\u00bb, \u0446\u0456 \u0431\u043e\u043b\u044c\u0448: \u00ab\u041d\u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c, \u043d\u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c, \u0430\u043b\u0435 \u044f\u043a \u043c\u0430\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u043e\u045e\u0432\u0430\u0446\u0446\u0430 \u0434\u0430 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041b\u044e\u0431\u043e\u045e \u2013 \u0433\u044d\u0442\u0430 \u0446\u043d\u043e\u0442\u0430, \u044f\u043a\u0430\u044f \u044f\u0434\u043d\u0430\u0435, \u044f\u043a\u0430\u044f \u0440\u043e\u0431\u0456\u0446\u044c \u0442\u0430\u043a, \u0448\u0442\u043e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0414\u0430\u0431\u0440\u0430 \u0430\u0434\u0447\u0443\u0432\u0430\u044e\u0446\u0446\u0430 \u043d\u0456\u0431\u044b \u045e\u043b\u0430\u0441\u043d\u044b\u044f. \u042f\u0435 \u0430\u0433\u043e\u043d\u044c \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e\u0433\u043b\u044b\u0431 \u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435 \u043b\u044e\u0431\u044f\u0447\u0430\u0433\u0430 \u045e \u043b\u044e\u0431\u0456\u043c\u0430\u0433\u0430. \u041b\u044e\u0431\u043e\u045e, \u044f\u0434\u043d\u0430\u044e\u0447\u044b\u0441\u044f \u043d\u0435\u0439\u043a\u0456\u043c \u0443\u0437\u043d\u0451\u0441\u043b\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0437 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435\u043c, \u0441\u0442\u0432\u0430\u0440\u0430\u0435 \u0442\u0430\u043a\u043e\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f, \u0448\u0442\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u045e\u0436\u043e \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0446\u044c \u043b\u044e\u0431\u043e\u045e \u0430\u0434 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f, \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435 \u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456. \u0422\u0430\u043c\u0443 \u043b\u044e\u0431\u044f\u0447\u0430\u044f \u0434\u0443\u0448\u0430 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u043c\u0443\u0442\u043a\u0443 \u0456 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u045e\u044e, \u043f\u043e\u045e\u043d\u0430\u0439 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u043b\u044b\u043c\u0456, \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0447\u044b \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0430\u0439\u0441\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430, \u0431\u043e \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u044f\u0439 \u0447\u044b\u0441\u0442\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u041f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435 \u0442\u0430\u043a, \u043a\u0430\u0431 \u0443\u0441\u0456\u043c \u0431\u044b\u043b\u043e \u0432\u044f\u0434\u043e\u043c\u0430, \u0448\u0442\u043e \u0432\u044b \u043d\u043e\u0441\u0456\u0446\u0435 \u0432\u043e\u0431\u0440\u0430\u0437 \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e\u043d\u0443\u0442\u0440\u044b, \u0430\u043b\u0435 \u0456 \u0437\u0432\u043e\u043d\u043a\u0443. \u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u045e\u043d\u0443\u0442\u0440\u0430\u043d\u0430 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u044b \u0437 \u0421\u044b\u043d\u0430\u043c \u0436\u044b\u0432\u043e\u0433\u0430 \u0411\u043e\u0433\u0430, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u043d\u0435\u0448\u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u042f\u0433\u043e \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u043f\u0440\u0430\u0437 \u043f\u0430\u043c\u043d\u0430\u0436\u044d\u043d\u043d\u0435 \u0433\u0435\u0440\u0430\u0456\u0447\u043d\u0430\u0439 \u0446\u043d\u043e\u0442\u044b, \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043c\u0443\u0436\u043d\u0430\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u044f\u043a\u0430\u044f \u043d\u0435 \u0441\u043a\u0430\u0440\u0434\u0437\u0456\u0446\u0446\u0430 \u043d\u0456 \u044f\u045e\u043d\u0430, \u043d\u0456 \u045e\u043f\u043e\u0442\u0430\u0439. \u0422\u0430\u043c\u0443 \u045e\u043a\u0440\u044b\u0439\u0446\u0435\u0441\u044f \u0432\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b\u043c \u0425\u0440\u044b\u0441\u0446\u0435, \u043d\u0435 \u043f\u0440\u0430\u0433\u043d\u0443\u0447\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u0456\u043d\u0448\u0430\u0433\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0432\u0430 \u045e\u0441\u0456\u043c \u0431\u044b\u043b\u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u044f \u042f\u0433\u043e \u0432\u043e\u043b\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043b\u044e\u0431\u0456\u045e\u0448\u044b \u0423\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430, \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0439\u0446\u0435 \u045e \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u043a\u0440\u044b\u0436\u0430, \u0446\u0435\u0440\u043f\u044f\u0447\u044b \u045e \u043c\u0430\u045e\u0447\u0430\u043d\u043d\u0456 \u0431\u0435\u0437 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0456 \u0437 \u0431\u043e\u043a\u0443 \u044f\u043a\u043e\u0433\u0430-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f. \u0423\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0442\u0440\u044d\u0431\u0430 \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u043d\u0430, \u0442\u0430\u043c\u0443 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0423\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u0430 \u043a\u0440\u044b\u0436\u0430 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044e \u0442\u0430\u043a, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e \u0433\u044d\u0442\u0430 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0430\u0434 \u043b\u044e\u0434\u0437\u0435\u0439, \u0430 \u0431\u0430\u0447\u043d\u044b\u043c \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430. \u0423 \u0447\u0430\u0441\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0434\u0431\u044b\u0432\u0430\u044e\u0446\u0446\u0430 \u0433\u0430\u0441\u0446\u0456\u043d\u044b, \u0430 \u0435\u0436\u0430\u044e \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0443, \u044f\u043a\u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0430 \u043d\u0430\u043c \u0423\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u044f \u041b\u044e\u0431\u043e\u045e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0413\u0430\u043b 6, 14; \u0410\u0431\u043a 3, 18\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u044f\u0445\u0430\u0439 \u043c\u043d\u0435 \u043d\u0435 \u0434\u0430\u0432\u044f\u0434\u0437\u0435\u0446\u0446\u0430 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0456\u0447\u044b\u043c, \u0430\u043a\u0440\u0430\u043c\u044f \u043a\u0440\u044b\u0436\u0430 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0441\u0432\u0435\u0442 \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0434\u043b\u044f \u043c\u044f\u043d\u0435, \u0430 \u044f \u2013 \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u042f \u0431\u0443\u0434\u0443 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0443, \u0431\u0443\u0434\u0443 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u0411\u043e\u0433\u0443, \u043c\u0430\u0456\u043c \u0417\u0431\u0430\u045e\u0446\u044b. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u0440\u0430\u0437.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"798","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0417 \u0433\u0430\u043c\u0456\u043b\u0456\u0456 \u0441\u0432. \u042f\u043d\u0430 \u041f\u0430\u045e\u043b\u0430 \u0406\u0406, \u043f\u0430\u043f\u044b,&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0443 \u0434\u0437\u0435\u043d\u044c \u0456\u043d\u0430\u045e\u0433\u0443\u0440\u0430\u0446\u044b\u0456 \u043f\u0430\u043d\u0442\u044b\u0444\u0456\u043a\u0430\u0442\u0443<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">&nbsp;(Die 22 octobris 1978: AAS 70 [1978], 945-947)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f! \u0410\u0434\u0447\u044b\u043d\u0456\u0446\u0435 \u0434\u0437\u0432\u0435\u0440\u044b \u0425\u0440\u044b\u0441\u0442\u0443!<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0451\u0442\u0440 \u043f\u0440\u044b\u0431\u044b\u045e \u0443 \u0420\u044b\u043c! \u0428\u0442\u043e \u043d\u0430\u043a\u0456\u0440\u0430\u0432\u0430\u043b\u0430 \u044f\u0433\u043e \u0456 \u043f\u0440\u044b\u0432\u044f\u043b\u043e \u045e \u0433\u044d\u0442\u044b \u0433\u043e\u0440\u0430\u0434, \u0443 \u0441\u044d\u0440\u0446\u0430 \u0420\u044b\u043c\u0441\u043a\u0430\u0439 \u0456\u043c\u043f\u0435\u0440\u044b\u0456, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u044e, \u044f\u043a\u043e\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0434 \u041f\u0430\u043d\u0430? \u041c\u043e\u0436\u0430 \u0433\u044d\u0442\u044b \u0440\u044b\u0431\u0430\u043a \u0437 \u0413\u0430\u043b\u0456\u043b\u0435\u0456 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0456\u0441\u0446\u0456 \u0430\u0436 \u0441\u044e\u0434\u044b. \u041c\u043e\u0436\u0430 \u0445\u0430\u0446\u0435\u045e \u0437\u0430\u0441\u0442\u0430\u0446\u0446\u0430 \u0442\u0430\u043c, \u043d\u0430 \u0431\u0435\u0440\u0430\u0437\u0435 \u0413\u0430\u043b\u0456\u043b\u0435\u0439\u0441\u043a\u0430\u0433\u0430 \u0432\u043e\u0437\u0435\u0440\u0430, \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0447\u043e\u045e\u043d\u0430\u043c, \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u0435\u0442\u043a\u0430\u043c\u0456. \u0410\u043b\u0435 \u044f\u0433\u043e \u0432\u0451\u045e \u041f\u0430\u043d, \u0456 \u0451\u043d, \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u042f\u0433\u043e \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u044e, \u043f\u0440\u044b\u0431\u044b\u045e \u0441\u044e\u0434\u044b!<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u0430\u0439 \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u0456, \u043f\u0430\u0434\u0447\u0430\u0441 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443 \u043f\u0440\u044b \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0456 \u041d\u0435\u0440\u043e\u043d\u0430, \u041f\u0451\u0442\u0440 \u0445\u0430\u0446\u0435\u045e \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0420\u044b\u043c. \u0410\u043b\u0435 \u041f\u0430\u043d \u0443\u043c\u044f\u0448\u0430\u045e\u0441\u044f: \u0432\u044b\u0439\u0448\u0430\u045e \u044f\u043c\u0443 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447. \u041f\u0451\u0442\u0440 \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u042f\u0433\u043e \u0456 \u0441\u043f\u044b\u0442\u0430\u045e\u0441\u044f: \u00abQuo vadis Domine? \u2013 \u041a\u0443\u0434\u044b \u0456\u0434\u0437\u0435\u0448, \u041f\u0430\u043d\u0435?\u00bb \u0410 \u041f\u0430\u043d \u0430\u0434\u0440\u0430\u0437\u0443 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u044f\u043c\u0443: \u00ab\u0406\u0434\u0443 \u045e \u0420\u044b\u043c, \u043a\u0430\u0431 \u041c\u044f\u043d\u0435 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043b\u0456 \u0434\u0440\u0443\u0433\u0456 \u0440\u0430\u0437\u00bb. \u041f\u0451\u0442\u0440 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u045e \u0420\u044b\u043c \u0456 \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u0442\u0443\u0442 \u0430\u0436\u043d\u043e \u0434\u0430 \u043c\u043e\u043c\u0430\u043d\u0442\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u043d\u044f.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u0448 \u0447\u0430\u0441 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435, \u0441\u0445\u0456\u043b\u044f\u0435, \u0430\u0431\u0430\u0432\u044f\u0437\u0432\u0430\u0435 \u043d\u0430\u0441 \u0443\u0433\u043b\u044f\u0434\u0430\u0446\u0446\u0430 \u045e \u041f\u0430\u043d\u0430 \u0456 \u0430\u043a\u0443\u043d\u0443\u0446\u0446\u0430 \u045e \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0456 \u045e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0443\u043b\u0430\u0434\u044b \u0441\u0430\u043c\u043e\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u043e\u0439, \u044f\u043a\u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456, \u0441\u044b\u043d \u0446\u0435\u0441\u043b\u044f\u0440\u0430 \u2013 \u044f\u043a \u0434\u0443\u043c\u0430\u043b\u0456, \u0421\u044b\u043d \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430 \u2013 \u044f\u043a \u0432\u044b\u0437\u043d\u0430\u045e \u041f\u0451\u0442\u0440, \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043a\u0430\u0431 \u043d\u0430\u0441 \u0443\u0441\u0456\u0445 \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u00ab\u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430\u043c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0440\u0443\u0433\u0456 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0456 \u0421\u0430\u0431\u043e\u0440 \u043d\u0430\u0433\u0430\u0434\u0430\u045e \u043d\u0430\u043c \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0433\u044d\u0442\u0430\u0439 \u0443\u043b\u0430\u0434\u044b \u0456 \u0444\u0430\u043a\u0442, \u0448\u0442\u043e \u043c\u0456\u0441\u0456\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u2013 \u0421\u0432\u044f\u0442\u0430\u0440\u0430, \u041f\u0440\u0430\u0440\u043e\u043a\u0430-\u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430, \u041a\u0430\u0440\u0430\u043b\u044f \u2013 \u0442\u0440\u044b\u0432\u0430\u0435 \u0434\u0430\u043b\u0435\u0439 \u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0435. \u041a\u043e\u0436\u043d\u044b, \u0443\u0432\u0435\u0441\u044c \u0411\u043e\u0436\u044b \u043d\u0430\u0440\u043e\u0434 \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0435 \u045e \u0433\u044d\u0442\u0430\u0439 \u043f\u0430\u0442\u0440\u043e\u0439\u043d\u0430\u0439 \u043c\u0456\u0441\u0456\u0456. \u0420\u0430\u043d\u0435\u0439 \u043d\u0430 \u0433\u0430\u043b\u0430\u0432\u0443 \u043f\u0430\u043f\u044b \u045e\u0441\u043a\u043b\u0430\u0434\u0430\u043b\u0456 \u0442\u044b\u044f\u0440\u0443: \u043f\u0430\u0442\u0440\u043e\u0439\u043d\u0443\u044e \u043a\u0430\u0440\u043e\u043d\u0443, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u044b \u0441\u0456\u043c\u0432\u0430\u043b, \u0448\u0442\u043e \u045e\u0432\u0435\u0441\u044c \u0456\u0435\u0440\u0430\u0440\u0445\u0456\u0447\u043d\u044b \u043b\u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0443\u0441\u044f \u044f\u0433\u043e \u00ab\u0441\u0432\u044f\u0442\u0430\u044f \u045e\u043b\u0430\u0434\u0430\u00bb, \u044f\u043a\u0443\u044e \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0456\u0447\u044b\u043c \u0456\u043d\u0448\u044b\u043c \u044f\u043a \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435\u043c, \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435\u043c, \u044f\u043a\u043e\u0435 \u043c\u0430\u0435 \u043d\u0430 \u043c\u044d\u0446\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043d\u043e: \u043a\u0430\u0431 \u0443\u0432\u0435\u0441\u044c \u0411\u043e\u0436\u044b \u043d\u0430\u0440\u043e\u0434 \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u045e \u0443 \u0433\u044d\u0442\u0430\u0439 \u043f\u0430\u0442\u0440\u043e\u0439\u043d\u0430\u0439 \u043c\u0456\u0441\u0456\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0434 \u0443\u043b\u0430\u0434\u0430\u0439 \u041f\u0430\u043d\u0430, \u044f\u043a\u0430\u044f \u0431\u044f\u0440\u044d \u0441\u0432\u043e\u0439 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u043d\u0435 \u0437 \u043c\u043e\u0446\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0430\u043b\u0435 \u0430\u0434 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u041a\u0440\u044b\u0436\u0430 \u0456 \u0423\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u0430\u044f \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430\u044f, \u0430\u043b\u0435 \u0430\u0434\u043d\u0430\u043a \u043c\u0456\u043b\u0430\u044f \u0456 \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u044f \u045e\u043b\u0430\u0434\u0430 \u041f\u0430\u043d\u0430 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u045e\u0441\u0451\u0439 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0441\u0430\u043c\u044b\u043c \u0443\u0437\u043d\u0451\u0441\u043b\u044b\u043c \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u044f\u043c \u044f\u0433\u043e \u0440\u043e\u0437\u0443\u043c\u0443, \u0432\u043e\u043b\u0456 \u0456 \u0441\u044d\u0440\u0446\u0430. \u042f\u043d\u0430 \u043d\u0435 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435 \u043c\u043e\u0432\u0430\u0439 \u0441\u0456\u043b\u044b, \u0430\u043b\u0435 \u0432\u044b\u0440\u0430\u0436\u0430\u0435\u0446\u0446\u0430 \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u043e\u0432\u044b \u041d\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a \u041f\u044f\u0442\u0440\u0430 \u043d\u0430 \u0440\u044b\u043c\u0441\u043a\u0430\u0439 \u0421\u0442\u0430\u043b\u0456\u0446\u044b \u0432\u044b\u043c\u0430\u045e\u043b\u044f\u0435 \u0441\u0451\u043d\u043d\u044f \u0433\u0430\u0440\u0430\u0447\u0443\u044e, \u043f\u0430\u043a\u043e\u0440\u043d\u0443\u044e, \u043f\u043e\u045e\u043d\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0443: \u00ab\u041e \u0425\u0440\u044b\u0441\u0442\u044d! \u0423\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u044f \u043c\u043e\u0433 \u0441\u0442\u0430\u0446\u044c \u0456 \u0431\u044b\u0446\u044c \u0441\u043b\u0443\u0433\u043e\u044e \u0422\u0432\u0430\u0451\u0439 \u0430\u0434\u0437\u0456\u043d\u0430\u0439 \u0443\u043b\u0430\u0434\u044b! \u0421\u043b\u0443\u0433\u043e\u044e \u0422\u0432\u0430\u0451\u0439 \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u0439 \u0443\u043b\u0430\u0434\u044b! \u0421\u043b\u0443\u0433\u043e\u044e \u0422\u0432\u0430\u0451\u0439 \u0443\u043b\u0430\u0434\u044b, \u044f\u043a\u0430\u044f \u043d\u0435 \u043f\u0440\u0430\u043c\u0456\u043d\u0430\u0435! \u0423\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u043c\u043e\u0433 \u0431\u044b\u0446\u044c \u0441\u043b\u0443\u0433\u043e\u044e! \u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0441\u043b\u0443\u0433\u043e\u044e \u0422\u0432\u0430\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e!\u00bb<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0440\u0430\u0442\u044b \u0456 \u0441\u0451\u0441\u0442\u0440\u044b! \u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0437\u0433\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u043d\u0430 \u042f\u0433\u043e \u045e\u043b\u0430\u0434\u0443!<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0430\u043f\u0430\u043c\u0430\u0436\u044b\u0446\u0435 \u041f\u0430\u043f\u0443 \u0456 \u045e\u0441\u0456\u043c, \u0445\u0442\u043e \u0436\u0430\u0434\u0430\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443 \u0456 \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u0443\u043b\u0430\u0434\u044b \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u0456 \u045e\u0441\u044f\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0443!<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f! \u0410\u0434\u0447\u044b\u043d\u0456\u0446\u0435, \u0430\u0434\u0447\u044b\u043d\u0456\u0446\u0435 \u0434\u0437\u0432\u0435\u0440\u044b \u0425\u0440\u044b\u0441\u0442\u0443! \u0414\u043b\u044f \u042f\u0433\u043e \u0437\u0431\u0430\u045e\u0447\u0430\u0439 \u0443\u043b\u0430\u0434\u044b \u0430\u0434\u043a\u0440\u044b\u0439\u0446\u0435 \u043c\u0435\u0436\u044b \u0434\u0437\u044f\u0440\u0436\u0430\u045e, \u044d\u043a\u0430\u043d\u0430\u043c\u0456\u0447\u043d\u044b\u0445 \u0456 \u043f\u0430\u043b\u0456\u0442\u044b\u0447\u043d\u044b\u0445 \u0441\u0456\u0441\u0442\u044d\u043c, \u0448\u044b\u0440\u043e\u043a\u0456\u0445 \u0441\u0444\u0435\u0440\u0430\u045e \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u044b, \u0446\u044b\u0432\u0456\u043b\u0456\u0437\u0430\u0446\u044b\u0456, \u0440\u0430\u0437\u0432\u0456\u0446\u0446\u044e. \u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f! \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0432\u0435\u0434\u0430\u0435, \u00ab\u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443\u00bb. \u0422\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u0433\u044d\u0442\u0430 \u0432\u0435\u0434\u0430\u0435!<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0451\u043d\u043d\u044f \u0442\u0430\u043a \u0447\u0430\u0441\u0442\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u043d\u043e\u0441\u0456\u0446\u044c \u0443 \u0441\u0430\u0431\u0435, \u0443 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b, \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430. \u0422\u0430\u043a \u0447\u0430\u0441\u0442\u0430 \u0451\u043d \u043d\u044f\u045e\u043f\u044d\u045e\u043d\u0435\u043d\u044b \u045e \u0441\u044d\u043d\u0441\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0437\u044f\u043c\u043b\u0456. \u042f\u0433\u043e \u0442\u0430\u043a \u0447\u0430\u0441\u0442\u0430 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0440\u043e\u0441\u043f\u0430\u0447. \u0422\u0430\u043c\u0443 \u0434\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435, \u2013 \u043f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u0443\u043f\u0440\u043e\u0448\u0432\u0430\u044e \u0432\u0430\u0441 \u0437 \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0456 \u043d\u0430\u0434\u0437\u0435\u044f\u0439, \u2013 \u0434\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u0425\u0440\u044b\u0441\u0442\u0443 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0422\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u043c\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0436\u044b\u0446\u0446\u044f, \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f: \u0417\u0431\u0430\u045e\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0430\u0431\u2019\u044f\u0432\u0456\u045e \u043c\u043e\u0446 \u043a\u0440\u044b\u0436\u0430 \u0456 \u0430\u0434\u0434\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451! <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0410\u0434\u0447\u044b\u043d\u0456\u0446\u0435 \u0434\u0437\u0432\u0435\u0440\u044b \u0425\u0440\u0443\u0441\u0442\u0443!<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041c\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0441\u0442\u0430\u0446\u044c \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u042f\u0433\u043e \u045e\u043b\u0430\u0434\u044b. <\/span><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0410\u0434\u0447\u044b\u043d\u0456\u0446\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"799","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u00ab\u041b\u044e\u0441\u0442\u0440\u0430 \u0434\u0443\u0445\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430\u00bb \u0441\u0432. \u042f\u043d\u0430 \u041a\u0430\u043f\u0456\u0441\u0442\u0440\u0430\u043d\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Pars I, Veneti\u00e6 1580, 2)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423\u0437\u043e\u0440\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0434\u0443\u0445\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0441\u043f\u0430\u043a\u043e\u0435\u043c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0434\u0430 \u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u043d\u0430, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0437\u044f\u0446\u044c \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0433\u0430 \u0456 \u043c\u0430\u0440\u0430\u043b\u044c\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0431\u0435\u0437 \u0437\u0430\u0433\u0430\u043d\u0430\u045e \u0456 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456. \u0416\u044b\u0432\u0443\u0447\u044b \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0430, \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u043e\u043b\u043b\u044e \u0437\u044f\u043c\u043b\u0456, \u0434\u0437\u0435\u043b\u044f \u0441\u044f\u0431\u0435 \u0456 \u0434\u0437\u0435\u043b\u044f \u0456\u043d\u0448\u044b\u0445, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u044e\u0447\u044b \u0456\u043d\u0448\u044b\u0445 \u0432\u044b\u0440\u0430\u0437\u043d\u044b\u043c \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u0435\u043c, \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0441\u0432\u0435\u0442\u0443, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u043c\u044f\u0442\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043d\u0430\u0448 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c \u0456 \u0432\u0443\u0447\u043d\u044f\u043c, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u0456\u043c \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430\u043c, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u043c \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0412\u044b \u2013 \u0441\u043e\u043b\u044c \u0437\u044f\u043c\u043b\u0456. \u041a\u0430\u043b\u0456 \u0436 \u0441\u043e\u043b\u044c \u0441\u0442\u0440\u0430\u0446\u0456\u0446\u044c \u0441\u043c\u0430\u043a, \u0442\u043e \u0447\u044b\u043c \u043f\u0430\u0441\u043e\u043b\u0456\u0448 \u044f\u0435? \u042f\u043d\u0430 \u045e\u0436\u043e \u043d\u0456 \u043d\u0430 \u0448\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u0434\u0430\u0441\u0446\u0430, \u0445\u0456\u0431\u0430 \u0448\u0442\u043e \u0432\u044b\u043a\u0456\u043d\u0443\u0446\u044c \u044f\u0435 \u0432\u043e\u043d \u043d\u0430 \u043f\u0430\u0442\u0430\u043f\u0442\u0430\u043d\u043d\u0435 \u043b\u044e\u0434\u0437\u044f\u043c\u00bb (\u041c\u0446 5, 13).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u043f\u0430\u0433\u0430\u043d\u0435\u043d\u0430\u0435 \u0456 \u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u0434\u0443\u0445\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430, \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430\u0435 \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0430\u043c\u0456, \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u0430\u0435 \u043f\u0443\u0442\u0430\u043c\u0456 \u0433\u0440\u0430\u0445\u0443, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0442\u043e\u043f\u0447\u0443\u0446\u044c \u043b\u044e\u0434\u0437\u0456 \u044f\u043a \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0435 \u0431\u0430\u043b\u043e\u0442\u0430. \u0422\u0430\u043a\u043e\u0435 \u0434\u0443\u0445\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430 \u043d\u0435 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430 \u043d\u0435 \u0456\u043c \u0441\u0430\u043c\u0456\u043c, \u043d\u0456 \u0456\u043d\u0448\u044b\u043c, \u0431\u043e, \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u0439, \u00ab\u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0430\u0434\u043c\u043e\u045e\u043d\u0430, \u0430\u0434\u043a\u0456\u0434\u0430\u044e\u0446\u044c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u041f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e, \u044f\u043a\u0456\u044f \u0434\u043e\u0431\u0440\u0430 \u043a\u0456\u0440\u0443\u044e\u0446\u044c, \u0430\u043a\u0440\u0443\u0436\u0430\u0439\u0446\u0435 \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u0430\u0439 \u043f\u0430\u0448\u0430\u043d\u0430\u0439, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0446\u044f\u0436\u043a\u0430 \u043f\u0440\u0430\u0446\u0443\u0435, \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u044e\u0447\u044b \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0447\u044b\u00bb (1 \u0426\u0456\u043c 5, 17). \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0441\u0432\u044f\u0442\u044b\u044f \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u044b \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u0430\u0439 \u043f\u0430\u0448\u0430\u043d\u044b, \u0437\u0430 \u0441\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u0437\u0430 \u0441\u044f\u0431\u0435 \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430, \u0430\u0431\u043e \u0456\u043d\u0430\u043a\u0448: \u043d\u0430 \u043f\u0430\u0448\u0430\u043d\u0443 \u0437\u044f\u043c\u043d\u0443\u044e \u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e, \u0447\u0430\u0441\u043e\u0432\u0443\u044e \u0456 \u0432\u0435\u0447\u043d\u0443\u044e. \u0425\u043e\u0446\u044c \u044f\u043d\u044b \u0436\u044b\u0432\u0443\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c\u0456 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u043c\u0456 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b\u044f \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u043f\u0440\u044b\u0440\u043e\u0434\u044b, \u0430\u0434\u043d\u0430\u043a \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0431\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0430\u043d\u0451\u043b\u0430\u043c\u0456 \u045e \u043d\u0435\u0431\u0435, \u043a\u0430\u0431 \u044f\u043a \u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u044f \u0441\u043b\u0443\u0433\u0456 \u0431\u044b\u0446\u044c \u043c\u0456\u043b\u044b\u043c\u0456 \u0434\u043b\u044f \u041a\u0430\u0440\u0430\u043b\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u044f\u043a \u0441\u043e\u043d\u0446\u0430 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u043d\u0430 \u0432\u044b\u0441\u043e\u043a\u0456\u043c \u043d\u0435\u0431\u0435, \u0442\u0430\u043a \u043d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u0443\u0445\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430 \u0442\u0430\u043a \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u0430\u0447\u044b\u043b\u0456 \u0456\u0445 \u0434\u043e\u0431\u0440\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445 (\u043f\u0430\u0440. \u041c\u0446 5, 16).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0412\u044b \u2013 \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0442\u0443\u00bb (\u041c\u0446 5, 14). \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0441\u0432\u044f\u0442\u043b\u043e \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u044f\u0431\u0435, \u0430\u043b\u0435, \u043f\u0430\u0441\u044b\u043b\u0430\u044e\u0447\u044b \u043f\u0440\u043e\u043c\u043d\u0456, \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u045e\u0441\u0451 \u0431\u0430\u0447\u043d\u0430\u0435, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0437\u043e\u0440\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u0445 \u0430\u0441\u043e\u0431\u0430\u045e \u0431\u043b\u044f\u0441\u043a\u0430\u043c \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0456\u0445. \u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0437\u0430\u0434\u0430\u043d\u043d\u0435 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0456\u043d\u0448\u044b\u0445, \u0441\u0430\u043c \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c, \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0443 \u0411\u043e\u0436\u044b\u043c \u0434\u043e\u043c\u0435.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0421\u0456\u0440 4, 28-29; 2 \u0426\u0456\u043c 4, 2\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041d\u0435 \u0448\u043a\u0430\u0434\u0443\u0439 \u0441\u043b\u043e\u0432\u0430, \u043a\u0430\u043b\u0456 \u044f\u043d\u043e \u043c\u043e\u0436\u0430 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0447\u044b, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u043f\u0430 \u0441\u043b\u043e\u0432\u0435 \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0446\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0430 \u043f\u0430 \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u043c \u2013 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0439 \u0441\u043b\u043e\u0432\u0430, \u0431\u0443\u0434\u0437\u044c \u043d\u0430\u0441\u0442\u043e\u0439\u043b\u0456\u0432\u044b \u045e \u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0456 \u043d\u0435\u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0447\u0430\u0441, \u0430\u0441\u043f\u0440\u044d\u0447\u0432\u0430\u0439, \u043f\u0430\u043f\u0440\u0430\u045e\u043b\u044f\u0439, \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0439 \u0437 \u0443\u0441\u0451\u0439 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u045e \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0411\u043e \u043f\u0430 \u0441\u043b\u043e\u0432\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"800","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u0422\u0432\u043e\u0440 \u0441\u0432. \u0410\u043d\u0442\u043e\u043d\u0456\u044f \u041c\u0430\u0440\u044b\u0456 \u041a\u043b\u044f\u0440\u044d\u0442\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(L\u2019Egoismo vinto, Rom\u00e6 1869, 60)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u043d\u0430\u0441&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0432\u044f\u0442\u044b\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b, \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b\u044f \u0430\u0433\u043d\u0451\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043f\u0440\u0430\u0439\u0448\u043b\u0456 \u045e\u0441\u044e \u0437\u044f\u043c\u043b\u044e. \u041c\u0456\u0441\u0456\u044f\u043d\u0435\u0440\u044b, \u0448\u0442\u043e \u0433\u0430\u0440\u044d\u043b\u0456 \u0430\u0433\u043d\u0451\u043c \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u0442\u0432\u0430, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u0448\u043b\u0456, \u0456\u0434\u0443\u0446\u044c \u0456 \u043f\u043e\u0439\u0434\u0443\u0446\u044c \u0430\u0436 \u0434\u0430 \u043a\u0440\u0430\u0451\u045e \u0437\u044f\u043c\u043b\u0456, \u0430\u0434 \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u043e\u043b\u044e\u0441\u0430 \u0434\u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u0430, \u043a\u0430\u0431 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430. \u0422\u0430\u043c\u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043c\u043e\u0433\u0443\u0446\u044c \u0430\u0434\u043d\u0435\u0441\u0446\u0456 \u0434\u0430 \u0441\u044f\u0431\u0435 \u0441\u043b\u043e\u0432\u044b \u0441\u0432. \u041f\u0430\u045e\u043b\u0430: \u00ab\u041b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u043d\u0430\u0441\u00bb (2 \u041a\u0430\u0440 5, 14).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u043d\u0430\u0441 \u0456 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435, \u043a\u0430\u0431 \u043c\u044b \u043b\u044f\u0442\u0430\u043b\u0456 \u043d\u0456\u0431\u044b \u043d\u0430 \u043a\u0440\u044b\u043b\u0430\u0445 \u0441\u0432\u044f\u0442\u043e\u0439 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0422\u043e\u0439, \u0445\u0442\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430. \u0427\u0430\u043b\u0430\u0432\u0435\u043a, \u043f\u0430-\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u0440\u0443\u043f\u043b\u0456\u0432\u044b, \u043b\u044e\u0431\u0456\u0446\u044c, \u0430\u043b\u0435 \u043d\u0430\u0448\u043c\u0430\u0442 \u0431\u043e\u043b\u044c\u0448, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u044b \u043b\u044e\u0431\u043e\u0432\u0456, \u0456 \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043b\u044e\u0431\u0456\u0446\u044c, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0440\u0443\u043f\u043b\u0456\u0432\u044b. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0442\u043e \u0433\u044d\u0442\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u045e \u044f\u0433\u043e\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u044b \u0437\u0433\u0430\u0441\u043b\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u044f \u043b\u044e\u0431\u043e\u045e. \u0425\u0442\u043e \u043c\u0430\u0435 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043f\u0440\u0430\u0433\u043d\u0435 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0456\u0445 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435. \u0406\u043c\u043a\u043d\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u0411\u043e\u0433\u0430 \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u043b\u0456, \u043b\u044e\u0431\u0456\u043b\u0456, \u0448\u0430\u043d\u0430\u0432\u0430\u043b\u0456 \u044f\u043a \u0443 \u0433\u044d\u0442\u044b\u043c, \u0442\u0430\u043a \u0456 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u0431\u043e \u0442\u0430\u043a\u0430\u044f \u0441\u0432\u044f\u0442\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043c\u0435\u0436\u0430\u045e. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0437 \u0431\u043b\u0456\u0436\u043d\u0456\u043c: \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0456 \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0431\u044b\u043b\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u044f \u0456 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u0430 \u045e \u0432\u0435\u0447\u043d\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0431\u044b\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u044f, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0437\u0430\u0433\u0456\u043d\u0443\u045e \u043d\u0430\u0432\u0435\u043a\u0456, \u043d\u0435 \u043a\u0440\u044b\u045e\u0434\u0437\u0456\u045e \u0411\u043e\u0433\u0430 \u0456 \u043d\u0456 \u043d\u0430 \u0445\u0432\u0456\u043b\u0456\u043d\u0443 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u045e \u0433\u0440\u0430\u0445\u0443. \u0413\u044d\u0442\u0430 \u043c\u044b \u0431\u0430\u0447\u044b\u043c \u0443 \u0441\u0432\u044f\u0442\u044b\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0456\u0448\u043e\u045e \u0437\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456\u043c \u0434\u0443\u0445\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u0436\u0443 \u0441\u0430\u0431\u0435: \u0421\u044b\u043d \u0411\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0433\u0430 \u0421\u044d\u0440\u0446\u0430 \u041c\u0430\u0440\u044b\u0456 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u044f\u043a\u0456 \u043f\u0430\u043b\u0430\u0435 \u043b\u044e\u0431\u043e\u045e\u044e \u0456 \u0437\u0430\u043f\u0430\u043b\u044c\u0432\u0430\u0435 \u0433\u044d\u0442\u044b\u043c \u043f\u043e\u043b\u044b\u043c\u0435\u043c \u0443\u0441\u0451, \u0434\u0437\u0435 \u0431 \u043d\u0456 \u0434\u0430\u0432\u044f\u043b\u043e\u0441\u044f \u044f\u043c\u0443 \u0431\u044b\u0446\u044c. \u0401\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0433\u043e\u0440\u0430\u0447\u0430 \u0436\u0430\u0434\u0430\u0435 \u0456 \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b\u0430\u045e \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0432\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u044f\u0445 \u0440\u0430\u0441\u043f\u0430\u043b\u0456\u0446\u044c \u0430\u0433\u043e\u043d\u044c \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. \u041d\u0456\u0448\u0442\u043e \u044f\u0433\u043e \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u0435, \u0451\u043d \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u043d\u044f\u0441\u0442\u0430\u0447\u044b, \u0437\u0433\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u0456, \u043f\u0440\u044b\u043c\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456. \u0421\u044f\u0440\u043e\u0434 \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u0445 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u043d\u043d\u044f\u045e \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b, \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f \u0440\u0430\u0434\u0430\u0441\u043d\u044b. \u041d\u0435 \u0434\u0443\u043c\u0430\u0435 \u043d\u0456 \u043f\u0440\u0430 \u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u044f\u043a \u0456\u0441\u0446\u0456 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0456 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u043f\u0440\u0430\u0446\u044b \u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445, \u0443 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u044b\u043c \u0456 \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u044b\u043c \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u0411\u043e\u0436\u0430\u0439 \u0445\u0432\u0430\u043b\u044b \u0456 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043b\u044e\u0434\u0437\u0435\u0439.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u0422\u044d\u0441 2, 8; \u0413\u0430\u043b 4, 19\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041c\u044b \u0437 \u0447\u0443\u043b\u0430\u0441\u0446\u0456 \u0434\u0430 \u0432\u0430\u0441 \u043f\u0430\u0436\u0430\u0434\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u0432\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0430\u043b\u0435 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0414\u0437\u0435\u0446\u0456 \u043c\u0430\u0435, \u044f \u0437\u043d\u043e\u045e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e \u0432\u0430\u0441 \u0443 \u043f\u0430\u043a\u0443\u0442\u0430\u0445, \u043f\u0430\u043a\u0443\u043b\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0441\u0444\u0430\u0440\u043c\u0443\u0435\u0446\u0446\u0430 \u045e \u0432\u0430\u0441.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043c\u0443 \u0448\u0442\u043e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"801","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041b\u0456\u0441\u0442 \u0431\u043b. \u0426\u044d\u043b\u0456\u043d\u044b \u0411\u0430\u0436\u044d\u043d\u0446\u043a\u0430\u0439<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Manuscripta, Archivum Generale Congregatio Sororum a Sancta Resurrectione Domini Nostri Jesu Christi,&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">Roma, Hist. S VIIJ, T3, Nr 11\/6 [4326])<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u044f, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 \u0431\u0430\u0447\u044b\u0446\u044c&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0432\u0430\u0448\u044b\u044f \u0434\u043e\u0431\u0440\u044b\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0456 \u043d\u0430\u043c\u0435\u0440\u044b<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0443\u0434\u0437\u0435\u043c \u0430\u0434\u043b\u0456\u0447\u0432\u0430\u0446\u044c \u0433\u0430\u0434\u044b \u0436\u044b\u0446\u0446\u044f, \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u0440\u044b\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u0430\u0434 \u044f\u0433\u043e \u0456 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u044e\u0447\u044b\u0441\u044f \u0434\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0434\u043d\u044f \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f. \u042f\u043a\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u2013 \u0431\u044b\u0446\u044c \u0443\u0436\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0432\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0456. \u0422\u0430\u043c\u0443 \u0442\u0440\u044b\u0432\u0430\u0439\u0446\u0435 \u045e \u0456\u043c, \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430, \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u044e\u0447\u044b \u0442\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0430\u044e\u0447\u044b \u0434\u0430 \u0436\u044b\u0446\u0446\u044f, \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448 \u0437\u0432\u044b\u0448\u043f\u0440\u044b\u0440\u043e\u0434\u043d\u0430\u0433\u0430. \u041d\u0435\u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u043b\u0430\u0441\u043a\u0443 \u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u043e\u0437\u0443\u043c\u0430\u043c, \u0442\u0440\u044d\u0431\u0430 \u044f\u0448\u0447\u044d \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u0441\u0430\u0431\u043e\u044e \u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u0443\u0447\u044b\u043d\u043a\u0456, \u044f\u043a\u0456\u044f \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u044c \u0434\u0443\u0448\u0443 \u0456 \u0433\u0440\u0443\u043d\u0442\u0443\u044e\u0446\u0446\u0430 \u043d\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043f\u0430\u043a\u043e\u0440\u044b \u0456 \u045e\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u0456 \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0448\u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0432\u044b \u045e\u0436\u043e \u043f\u0440\u044b \u0436\u044b\u0446\u0446\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0434\u0443\u0445\u0430\u043c, \u043a\u0430\u043b\u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0442\u0430\u043a\u0443\u044e \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u043b\u0430\u0441\u043a\u0443 \u0431\u044b\u0446\u044c \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u043c\u0456 \u0434\u0430 \u0442\u0430\u043a\u043e\u0439 \u0432\u0435\u043b\u0456\u0447\u043d\u0430\u0439 \u0456 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b. \u041f\u0440\u044b\u0433\u0430\u0434\u0430\u0435\u043c \u0441\u043b\u043e\u0432\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430: \u00abC\u043f\u0430\u043a\u043e\u0439 \u041c\u043e\u0439 \u0434\u0430\u044e \u0432\u0430\u043c\u00bb (\u042f\u043d 14, 27). \u0422\u0430\u043c\u0443 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u044f\u0433\u043e \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u0432\u0430\u0446\u044c \u0443\u0441\u0456\u043c \u0432\u0430\u043a\u043e\u043b \u043d\u0430\u0441, \u0430 \u0433\u044d\u0442\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u0451\u0441\u0446\u044c \u0434\u043e\u0431\u0440\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0442\u0430\u044f \u043b\u044e\u0431\u043e\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435 \u0434\u0430\u043a\u0430\u0440\u0430\u0439\u0446\u0435 \u0441\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0456 \u0456 \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u044b\u044f \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u0456 \u0432\u044b \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u0435 \u043f\u0430\u043a\u0443\u043b\u044c \u0432\u044b\u043d\u0456\u043a\u0430\u045e. \u0412\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0448\u044b\u0445 \u043f\u0440\u0430\u0446\u0430\u0445 \u0456 \u043d\u0430\u043c\u0435\u0440\u0430\u0445 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u0430 \u0441\u043b\u043e\u0432\u044b \u0411\u043e\u0433\u0430: \u00ab\u0426\u0435\u0440\u043d\u0456 \u0456 \u0430\u0441\u043e\u0442 \u0437\u044f\u043c\u043b\u044f \u0442\u0432\u0430\u044f \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u0431\u0435 \u0440\u0430\u0441\u0446\u0456\u0446\u044c\u00bb (\u043f\u0430\u0440. \u0411\u044b\u0446 3, 15). \u0422\u0430\u043a\u0456 \u043d\u0430\u0448 \u043b\u0451\u0441, \u0456 \u0442\u0430\u043a \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c. \u042f\u043a \u043b\u044e\u0434\u0437\u0456 \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u044f, \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430 \u0440\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043c \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c, \u0430 \u0432\u044b\u043d\u0456\u043a\u0456 \u0456 \u043d\u0430\u0441\u0442\u0443\u043f\u0441\u0442\u0432\u044b \u043d\u0430\u0448\u0430\u0439 \u043f\u0440\u0430\u0446\u044b \u043f\u0430\u043a\u0456\u043d\u0435\u043c \u0411\u043e\u0433\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0426\u0456 \u0436 \u043c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u044f\u043a\u0456\u044f \u042f\u0433\u043e \u043f\u043b\u0430\u043d\u044b \u0456 \u043d\u0430\u043c\u0435\u0440\u044b \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u0448, \u0441\u043f\u0440\u0430\u045e \u0441\u0432\u0435\u0442\u0443 \u0456 \u043d\u0430\u0448\u0430\u0439 \u043f\u0440\u0430\u0446\u044b? \u0422\u043e\u0435, \u0446\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u043c\u044b \u0432\u0435\u0434\u0430\u0446\u044c \u0456\u0445, \u0446\u0456 \u043d\u0435, \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434 \u0411\u043e\u0433\u0430. \u0422\u0430\u043c\u0443 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0437\u043d\u043e\u045e \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0434\u043b\u044f \u042f\u0433\u043e, \u043d\u0435 \u043f\u0430\u0434\u0430\u044e\u0447\u044b \u0434\u0443\u0445\u0430\u043c. \u0413\u044d\u0442\u0430 \u043f\u043e\u043b\u0435 \u043d\u0430\u0448\u0430\u0439 \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456: \u043c\u0435\u0446\u044c \u0437\u0430\u043a\u0440\u044b\u0442\u044b\u044f \u0432\u043e\u0447\u044b \u043d\u0430 \u0432\u044b\u043d\u0456\u043a\u0456 \u043d\u0430\u0448\u0430\u0439 \u043f\u0440\u0430\u0446\u044b, \u0430\u043b\u0435 \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0440\u044b\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0437\u043d\u043e\u045e \u0434\u0430 \u043f\u0440\u0430\u0446\u044b, \u043a\u0430\u0431 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u045e \u043d\u0430\u0448\u044b\u0445 \u0441\u0456\u043b\u0430\u0445. \u0422\u0430\u043a \u0440\u0430\u0431\u0456\u045e \u043d\u0430\u0448 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a, \u0411\u043e\u0433.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u044f \u0456 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b\u044f, \u0411\u043e\u0433 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0432\u0430\u0448\u044b\u044f \u0434\u043e\u0431\u0440\u044b\u044f \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u0456, \u043d\u0430 \u0432\u0430\u0448\u044b\u044f \u043d\u0430\u043c\u0435\u0440\u044b, \u0456 \u045e \u0441\u0432\u043e\u0439 \u0447\u0430\u0441 \u0432\u044b \u045e\u0431\u0430\u0447\u044b\u0446\u0435 \u0432\u044b\u043d\u0456\u043a\u0456 \u0433\u044d\u0442\u0430\u0433\u0430. \u041a\u043e\u0436\u043d\u0430\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u0430 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0432\u0430\u0448\u0430\u0439 \u0434\u0443\u0448\u044b, \u0431\u043e \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u0432\u0430\u0441 \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0441\u0430\u043c\u0430\u0432\u044b\u0440\u0430\u0447\u044d\u043d\u043d\u044f. \u0428\u0442\u043e \u0434\u0430 \u043c\u044f\u043d\u0435, \u0442\u043e \u043d\u044f\u043c\u0430 \u0434\u043d\u044f, \u043a\u0430\u0431, \u0434\u0430\u0440\u0443\u0447\u0430\u044e\u0447\u044b \u0432\u0430\u0441 \u041f\u0430\u043d\u0443, \u044f \u043d\u0435 \u043a\u0430\u0437\u0430\u043b\u0430: \u00ab\u041f\u0430\u043d\u0435, \u0440\u0430\u0431\u0456 \u0437 \u043d\u0430\u043c\u0456, \u0448\u0442\u043e \u0445\u043e\u0447\u0430\u0448, \u0445\u043e\u0446\u044c \u0431\u044b \u043d\u0430\u0432\u0430\u0442 \u0445\u0430\u0446\u0435\u045e \u0443\u0441\u0451 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c! \u0417 \u0422\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0439 \u0440\u0443\u043a\u0456 \u044f \u0433\u0430\u0442\u043e\u0432\u0430\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0443\u0441\u0451 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u045e\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e\u00bb. \u0422\u0430\u043c\u0443 \u043d\u0435 \u0442\u0443\u0440\u0431\u0443\u044e\u0441\u044f, \u043d\u0435 \u043f\u0435\u0440\u0430\u0436\u044b\u0432\u0430\u044e \u0456 \u043f\u0440\u0430\u0448\u0443 \u045e \u041f\u0430\u043d\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u2013 \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043d\u043d\u044f \u045e \u0446\u043d\u043e\u0442\u0430\u0445 \u0441\u044f\u0441\u0446\u0451\u0440 \u043d\u0430\u0448\u0430\u0439 \u0421\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u0431\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u0448 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u0446\u0446\u0430 \u045e\u0436\u043e \u043f\u0430\u0434\u0447\u0430\u0441 \u043d\u0430\u0448\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0431\u043e \u043c\u044b \u043d\u0435 \u0434\u0430\u0440\u044d\u043c\u043d\u0430 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0435\u043c \u0443 \u0432\u0435\u043b\u044c\u043c\u0456 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430\u0439 \u0422\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041a\u043b\u0441 3, 1-2\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041a\u0430\u043b\u0456 \u0436 \u0432\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430; <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0430 \u043d\u0435 \u043f\u0440\u0430 \u0437\u044f\u043c\u043d\u043e\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u043e\u0433 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0430; \u0442\u0430\u043c\u0443 \u043d\u0430\u0448\u0430\u044f \u0432\u0435\u0440\u0430 \u0456 \u043d\u0430\u0434\u0437\u0435\u044f \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u044b\u044f \u0434\u0430 \u042f\u0433\u043e.<\/span><span style=\"color: #ff0000;\"> \u041d.<\/span><span> \u041f\u0440\u0430 \u0442\u043e\u0435.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"802","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430\u00bb \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 12, 1: PG 74, 707-710)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u042f\u043a \u041c\u044f\u043d\u0435 \u043f\u0430\u0441\u043b\u0430\u045e \u0410\u0439\u0446\u0435\u0446, \u0442\u0430\u043a \u0456 \u042f \u043f\u0430\u0441\u044b\u043b\u0430\u044e \u0432\u0430\u0441<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u0448 \u041f\u0430\u043d, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443 \u0434\u0432\u0443\u0445 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u045e, \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u045e \u0456 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0411\u043e\u0436\u044b\u0445 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u045e. \u0414\u0430\u0440\u0443\u0447\u044b\u045e \u0456\u043c \u0441\u0432\u044f\u0446\u0456\u0446\u044c, \u044f\u043a \u043f\u0430\u0445\u043e\u0434\u043d\u044f, \u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043a\u0440\u0430\u0456\u043d\u0443 \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u0430\u043b\u0435 \u043a\u043e\u0436\u043d\u0443\u044e \u0456\u043d\u0448\u0443\u044e, \u044f\u043a\u0430\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043f\u0430\u0434 \u043d\u0435\u0431\u0430\u043c, \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0448\u0442\u043e \u0436\u044b\u0432\u0443\u0446\u044c \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456. \u0422\u0430\u043c\u0443 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043a\u0430\u0436\u0430: \u00ab\u041d\u0456\u0445\u0442\u043e \u0441\u0430\u043c \u043d\u0435 \u0431\u044f\u0440\u044d \u0441\u0430\u0431\u0435 \u0433\u044d\u0442\u0430\u0433\u0430 \u0433\u043e\u043d\u0430\u0440\u0443, \u0430\u043f\u0440\u043e\u0447 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430\u043c\u00bb (\u0413\u0431\u0440 5, 4). \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u043d\u0430\u0448 \u041f\u0430\u043d, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u043f\u0435\u0440\u0448 \u0437\u0430 \u043c\u043d\u043e\u0433\u0456\u0445 \u0456\u043d\u0448\u044b\u0445 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u045e\u0437\u043d\u0451\u0441\u043b\u0430\u0433\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0432\u044f\u0442\u044b\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0441\u0442\u0430\u043b\u0456 \u043a\u0430\u043b\u043e\u043d\u0430\u043c\u0456 \u0456 \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u043f\u0440\u0430\u045e\u0434\u044b. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435, \u0448\u0442\u043e \u043f\u0430\u0441\u043b\u0430\u045e \u0456\u0445, \u044f\u043a \u0456 \u0441\u0430\u043c \u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0410\u0439\u0446\u043e\u043c. \u0413\u044d\u0442\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0456 \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0443\u044e \u0445\u0432\u0430\u043b\u0443 \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430\u0439 \u0456\u043c \u0443\u043b\u0430\u0434\u044b. \u0410\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u045e\u043a\u0430\u0437\u0432\u0430\u0435 \u2013 \u044f\u043a \u0431\u0430\u0447\u043d\u0430 \u2013 \u0441\u043f\u043e\u0441\u0430\u0431 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u0433\u044d\u0442\u0430\u0439 \u043f\u0430\u0441\u043b\u0443\u0433\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u0441\u0432\u0430\u0456\u043c \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u043c \u043f\u0430\u0441\u043b\u0430\u0446\u044c \u0432\u0443\u0447\u043d\u044f\u045e, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0441\u043b\u0430\u045e \u042f\u0433\u043e, \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0431\u044b\u043b\u043e, \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0441\u0442\u0430\u0446\u044c \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430\u043c, \u0432\u0435\u0434\u0430\u043b\u0456, \u0434\u0437\u0435\u043b\u044f \u0447\u0430\u0433\u043e \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0441\u043b\u0430\u045e \u0421\u044b\u043d\u0430. \u0412\u043e\u0441\u044c \u0447\u0430\u043c\u0443 \u0401\u043d \u0448\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u045e \u043d\u0430\u043c \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f: \u00ab\u042f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u043d\u0435 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e, \u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e\u00bb (\u041c\u0446 9, 13). \u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b: \u00ab\u042f \u0441\u044b\u0439\u0448\u043e\u045e \u0437 \u043d\u0435\u0431\u0430 \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0447\u044b\u043d\u0456\u0446\u044c \u0441\u0432\u0430\u044e \u0432\u043e\u043b\u044e, \u0430\u043b\u0435 \u0432\u043e\u043b\u044e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u041c\u044f\u043d\u0435 \u043f\u0430\u0441\u043b\u0430\u045e\u00bb (\u042f\u043d 6, 38). \u0406 \u044f\u0448\u0447\u044d: \u00ab\u0411\u043e \u043d\u0435 \u043f\u0430\u0441\u043b\u0430\u045e \u0411\u043e\u0433 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e \u0441\u0432\u0435\u0442, \u043a\u0430\u0431 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u0435\u0442, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0441\u0432\u0435\u0442 \u0431\u044b\u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043f\u0440\u0430\u0437 \u042f\u0433\u043e\u00bb (\u042f\u043d 3, 17).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u043d\u0435\u043a\u0430\u043b\u044c\u043a\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f, \u043a\u0430\u0436\u0443\u0447\u044b, \u0448\u0442\u043e \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u0456\u0445 \u0442\u0430\u043a, \u044f\u043a \u042f\u0433\u043e \u043f\u0430\u0441\u043b\u0430\u045e \u0410\u0439\u0446\u0435\u0446, \u043a\u0430\u0431 \u044f\u043d\u044b \u0432\u0435\u0434\u0430\u043b\u0456, \u0448\u0442\u043e \u0456\u0445 \u0437\u0430\u0434\u0430\u043d\u043d\u0435 \u2013 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e \u0434\u0430 \u043d\u0430\u0432\u044f\u0440\u0442\u0430\u043d\u043d\u044f, \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u0446\u044c \u0445\u0432\u043e\u0440\u044b\u0445 \u0446\u0435\u043b\u0430\u043c \u0456 \u0434\u0443\u0448\u043e\u044e, \u043d\u0435 \u0448\u0443\u043a\u0430\u0446\u044c \u0443 \u043f\u0430\u0441\u043b\u0443\u0437\u0435 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456, \u0430\u043b\u0435 \u0432\u043e\u043b\u0456 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0456\u0445 \u043f\u0430\u0441\u043b\u0430\u045e, \u0456, \u0443\u0440\u044d\u0448\u0446\u0435, \u0437\u0431\u0430\u045e\u043b\u044f\u0446\u044c \u0441\u0432\u0435\u0442 \u043f\u0430 \u043c\u0435\u0440\u044b \u0442\u0430\u0433\u043e, \u044f\u043a \u0451\u043d \u043f\u0440\u044b\u043c\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430. \u0417 \u044f\u043a\u0456\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u043c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0456\u043c\u043a\u043d\u0443\u043b\u0456\u0441\u044f \u0433\u044d\u0442\u0430 \u045e\u0441\u0451 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c, \u043c\u043e\u0436\u043d\u0430 \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430, \u043f\u0440\u0430\u0447\u044b\u0442\u0430\u045e\u0448\u044b \u0414\u0437\u0435\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u045e \u0446\u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u0441\u0432. \u041f\u0430\u045e\u043b\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042f\u043d 15, 16. 8&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041d\u0435 \u0432\u044b \u041c\u044f\u043d\u0435 \u0432\u044b\u0431\u0440\u0430\u043b\u0456, \u0430\u043b\u0435 \u042f \u0432\u044b\u0431\u0440\u0430\u045e \u0432\u0430\u0441 \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e, \u043a\u0430\u0431 \u0432\u044b \u0456\u0448\u043b\u0456 \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u043f\u043b\u0451\u043d, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u043a\u0430\u0431 \u043f\u043b\u0451\u043d \u0432\u0430\u0448 \u0442\u0440\u044b\u0432\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0413\u044d\u0442\u044b\u043c \u0431\u0443\u0434\u0437\u0435 \u045e\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u0410\u0439\u0446\u0435\u0446 \u041c\u043e\u0439, \u043a\u0430\u043b\u0456 \u0432\u044b \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u0446\u0435 \u0431\u0430\u0433\u0430\u0442\u044b \u043f\u043b\u0451\u043d.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u043a\u0430\u0431.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"803","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430, \u0430\u0431\u0430\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 2: Opera omnia, Edit. Cisterc. 5 [1968], 364-368)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u043f\u044f\u0448\u0430\u0439\u043c\u0430\u0441\u044f \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e, \u044f\u043a\u0456\u044f \u043d\u0430\u0441 \u0447\u0430\u043a\u0430\u044e\u0446\u044c<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0441\u0432\u044f\u0442\u044b\u043c \u0445\u0432\u0430\u043b\u0430, \u044f\u043a\u0443\u044e \u043c\u044b \u045e\u0437\u043d\u043e\u0441\u0456\u043c, \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u0456\u043c \u043d\u0430\u0448\u0430\u044f \u043f\u0430\u0448\u0430\u043d\u0430, \u0456 \u043d\u0430\u0432\u043e\u0448\u0442\u0430, \u0443\u0440\u044d\u0448\u0446\u0435, \u0443\u0441\u044f \u0433\u044d\u0442\u0430\u044f \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c? \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0456\u043c \u0437\u044f\u043c\u043d\u0430\u044f \u0445\u0432\u0430\u043b\u0430, \u043a\u0430\u043b\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u0435\u0440\u043d\u0430\u0433\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f \u0421\u044b\u043d\u0430 \u0441\u0430\u043c \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0410\u0439\u0446\u0435\u0446 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u0456\u0445 \u0445\u0432\u0430\u043b\u043e\u044e? \u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u0456\u043c \u043d\u0430\u0448\u044b\u044f \u0441\u043f\u0435\u0432\u044b? \u0421\u0432\u044f\u0442\u044b\u044f \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0446\u044c \u043d\u0430\u0448\u0430\u0439 \u043f\u0430\u0445\u0432\u0430\u043b\u044b, \u0456 \u043d\u0456\u0447\u043e\u0433\u0430 \u0456\u043c \u043d\u0435 \u0434\u0430\u0435 \u043d\u0430\u0448\u0430\u0435 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u0435. \u041d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435, \u043a\u0430\u043b\u0456 \u043c\u044b \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u043c \u0456\u0445 \u0443\u0441\u043f\u0430\u043c\u0456\u043d, \u0442\u043e \u0441\u0430\u043c\u0456 \u043c\u0430\u0435\u043c \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c, \u043d\u0435 \u044f\u043d\u044b. \u0428\u0442\u043e \u0434\u0430 \u043c\u044f\u043d\u0435, \u0442\u043e \u043f\u0440\u044b\u0437\u043d\u0430\u044e\u0441\u044f, \u0448\u0442\u043e \u043a\u043e\u043b\u044c\u043a\u0456 \u0431 \u044f \u043d\u0435 \u0434\u0443\u043c\u0430\u045e \u043f\u0440\u0430 \u0441\u0432\u044f\u0442\u044b\u0445, \u0430\u0434\u0447\u0443\u0432\u0430\u044e, \u044f\u043a \u0443\u0432\u0430 \u043c\u043d\u0435 \u0440\u0430\u0437\u0433\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u043f\u043e\u043b\u044b\u043c\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0435\u0440\u0448\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u0430\u0431\u043e \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u045e \u043d\u0430\u0441 \u0443\u0441\u043f\u0430\u043c\u0456\u043d \u0441\u0432\u044f\u0442\u044b\u0445, \u2013 \u0433\u044d\u0442\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0431\u044b\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0456\u0445, \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0435 \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0442\u043e\u0435, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u0441\u0443\u0433\u0440\u0430\u043c\u0430\u0434\u0437\u044f\u043d\u0430\u043c\u0456 \u0456 \u0441\u0443\u0441\u0435\u0434\u0437\u044f\u043c\u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u0445 \u0434\u0443\u0445\u0430\u045e, \u0433\u044d\u0442\u0430 \u043d\u0430\u0434\u0437\u0435\u044f \u0434\u0430\u043b\u0443\u0447\u044b\u0446\u0446\u0430 \u0434\u0430 \u0441\u0445\u043e\u0434\u0443 \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0430\u045e, \u0434\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0434\u0430 \u0448\u044d\u0440\u0430\u0433\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0434\u0430 \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u0430\u0439 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e, \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0430\u045e, \u0434\u0430 \u0445\u043e\u0440\u0443 \u0434\u0437\u0435\u0432\u0430\u045e, \u0443\u0440\u044d\u0448\u0446\u0435, \u0437\u2019\u044f\u0434\u043d\u0430\u0446\u0446\u0430 \u0456 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0443\u0441\u0456\u043c\u0456 \u0441\u0432\u044f\u0442\u044b\u043c\u0456. \u00ab\u041a\u0430\u0441\u0446\u0451\u043b \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u0445\u00bb \u0445\u043e\u0447\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u043d\u0430\u0441, \u0430\u043b\u0435 \u043d\u0430\u0441 \u0433\u044d\u0442\u0430 \u043c\u0430\u043b\u0430 \u0445\u0432\u0430\u043b\u044e\u0435; \u043d\u0430\u0441 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u0441\u0443\u0441\u0442\u0440\u044d\u0446\u044c \u0441\u0432\u044f\u0442\u044b\u044f, \u0430 \u043c\u044b \u043d\u0435 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u043c \u043d\u0430 \u0433\u044d\u0442\u0430 \u045e\u0432\u0430\u0433\u0456; \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u043d\u0430\u0441 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f, \u0430 \u043c\u044b \u043c\u0430\u0440\u0443\u0434\u0437\u0456\u043c. \u0410\u0431\u0443\u0434\u0437\u0456\u043c\u0441\u044f, \u0443\u0440\u044d\u0448\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u0443\u0441\u0442\u0430\u043d\u0435\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u0428\u0443\u043a\u0430\u0439\u043c\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e\u0433\u0430\u0440\u044b. \u0414\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0431\u0443\u0434\u0437\u0435\u043c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430. \u0411\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u0443\u043c\u0443\u0435 \u043f\u0430 \u043d\u0430\u0441, \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u044f\u0448\u0430\u0446\u0446\u0430 \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430\u0441 \u0447\u0430\u043a\u0430\u0435, \u0430\u0445\u043e\u043f\u0456\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u043f\u0440\u0430\u0433\u043d\u0435\u043d\u043d\u0435\u043c \u0442\u044b\u0445, \u0445\u0442\u043e \u0432\u044b\u0433\u043b\u044f\u0434\u0430\u0435 \u043d\u0430\u0441. \u0410\u043b\u0435 \u043d\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u0431\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0443 \u0456\u0445 \u0448\u0447\u0430\u0441\u0446\u0456. \u041a\u0430\u043b\u0456 \u043f\u0440\u0430\u0433\u043d\u0435\u043c \u0456\u0445 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456, \u0437 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0431\u0443\u0434\u0437\u0435\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0434\u0430\u0431\u044b\u0432\u0430\u0446\u044c \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0443\u044e \u0437 \u0456\u043c\u0456 \u0445\u0432\u0430\u043b\u0443. \u0422\u0430\u043a\u0430\u044f \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0435 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0437\u0433\u0443\u0431\u044b, \u0456 \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0435 \u0434\u0430 \u0442\u0430\u043a\u043e\u0439 \u0441\u043b\u0430\u0432\u044b \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a\u0430\u0439.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0440\u0443\u0433\u043e\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u045e \u043d\u0430\u0441 \u0443\u0441\u043f\u0430\u043c\u0456\u043d \u0441\u0432\u044f\u0442\u044b\u0445, \u2013 \u0433\u044d\u0442\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u0435, \u043a\u0430\u0431 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0430\u0434\u043a\u0440\u044b\u045e\u0441\u044f \u043d\u0430\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u044f\u043a \u0456\u043c, \u043a\u0430\u0431 \u0456 \u043c\u044b \u0430\u043f\u044b\u043d\u0443\u043b\u0456\u0441\u044f \u0437 \u0406\u043c \u0443 \u0445\u0432\u0430\u043b\u0435. \u0426\u044f\u043f\u0435\u0440 \u043d\u0430\u0448\u0430\u044f \u0413\u0430\u043b\u0430\u0432\u0430, \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430\u0431\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u043c \u043d\u0435 \u0442\u0430\u043a\u0456\u043c, \u044f\u043a\u0456 \u0401\u043d \u0451\u0441\u0446\u044c, \u0430\u043b\u0435 \u044f\u043a\u0456\u043c \u0441\u0442\u0430\u045e\u0441\u044f \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441 \u2013 \u0443\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u043d\u044b \u043d\u0435 \u0445\u0432\u0430\u043b\u043e\u0439, \u0430\u043b\u0435 \u0446\u0435\u0440\u043d\u044f\u043c\u0456 \u043d\u0430\u0448\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e. \u041d\u0435\u0434\u0430\u0440\u044d\u0447\u043d\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u0413\u0430\u043b\u0430\u0432\u044b, \u0443\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u043d\u0430\u0439 \u0446\u0435\u0440\u043d\u0435\u043c, \u0448\u0443\u043a\u0430\u045e \u043b\u0451\u0433\u043a\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0431\u043e \u043f\u0443\u0440\u043f\u0443\u0440 \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u044f\u0433\u043e \u0437\u043d\u0430\u043a\u0430\u043c \u0445\u0432\u0430\u043b\u044b, \u0430\u043b\u0435 \u0433\u0430\u043d\u044c\u0431\u044b. \u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0443\u0436\u043e \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c. \u0422\u0430\u0434\u044b \u043f\u0430\u0437\u043d\u0430\u0435\u043c, \u0448\u0442\u043e \u0456 \u043c\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0430 \u043d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0431\u0443\u0434\u0437\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u044b\u043c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435. \u0413\u0430\u043b\u0430\u0432\u0430 \u0430\u0431\u2019\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u0445\u0432\u0430\u043b\u0435, \u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0451\u0439 \u0437\u0430\u044f\u0441\u043d\u0435\u044e\u0446\u044c \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b\u044f \u0447\u043b\u0435\u043d\u044b. \u0422\u0430\u0434\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u043d\u043e\u0432\u0456\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u044e\u0447\u044b \u044f\u0433\u043e \u0434\u0430 \u0445\u0432\u0430\u043b\u044b \u0413\u0430\u043b\u0430\u0432\u044b, \u044f\u043a\u043e\u0439 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0401\u043d \u0441\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u044b \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0456\u0434\u0437\u0451\u043c \u0434\u0430 \u0442\u043e\u0439 \u0445\u0432\u0430\u043b\u044b. \u0410\u043b\u0435, \u043a\u0430\u0431 \u043c\u044b \u043f\u0440\u0430\u0433\u043d\u0443\u043b\u0456 \u0434\u044b \u0456\u043c\u043a\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u0442\u0430\u043a\u043e\u0433\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456 \u0441\u0432\u044f\u0442\u044b\u0445. \u041f\u0440\u0430\u0437 \u0456\u0445 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u0435 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0448\u044b\u044f \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0410\u043f 19, 5b. 6b; \u041f\u0441 33 (32), 1\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0425\u0432\u0430\u043b\u0456\u0446\u0435 \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430, \u0443\u0441\u0435 \u0441\u043b\u0443\u0433\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u042f\u0433\u043e \u0431\u0430\u0456\u0446\u0446\u0430, \u043c\u0430\u043b\u044b\u044f \u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0431\u043e \u0437\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u045e \u041f\u0430\u043d \u0411\u043e\u0433 \u043d\u0430\u0448 \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0420\u0430\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u041f\u0430\u043d\u0443, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f, \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u043c \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0441\u043f\u0435\u045e \u0445\u0432\u0430\u043b\u044b.<\/span><span style=\"color: #ff0000;\"> \u041d.<\/span><span> \u0411\u043e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"804","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u043d\u0456\u0433\u0430 \u00ab\u041f\u0440\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0431\u0440\u0430\u0442\u0430 \u0421\u0430\u0442\u044b\u0440\u0430\u00bb \u0441\u0432. \u0410\u043c\u0431\u0440\u043e\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 2, 40. 41. 46. 47. 132. 133: CSEL 73, 270-274, 323-324)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041c\u044b \u043f\u0430\u043c\u0456\u0440\u0430\u0435\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u0434\u0430 \u0436\u044b\u0446\u0446\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u0430\u0447\u044b\u043c, \u0448\u0442\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u2013 \u0433\u044d\u0442\u0430 \u0432\u044b\u0433\u0430\u0434\u0430, \u0430 \u0436\u044b\u0446\u0446\u0451 \u2013 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435. \u0422\u0430\u043c\u0443 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430: \u00ab\u0414\u043b\u044f \u043c\u044f\u043d\u0435 \u0436\u044b\u0446\u0446\u0451 \u2013 \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u2013 \u0433\u044d\u0442\u0430 \u0432\u044b\u0433\u0430\u0434\u0430\u00bb (\u0424\u043b\u043f 1, 21). \u0427\u044b\u043c \u0436\u0430 \u0451\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0441\u043c\u0435\u0440\u0446\u044e \u0446\u0435\u043b\u0430 \u0456 \u0434\u0443\u0445\u0430\u043c, \u044f\u043a\u0456 \u0434\u0430\u0435 \u0436\u044b\u0446\u0446\u0451? \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u043a\u0430\u0431 \u0443 \u0406\u043c \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u043f\u0430\u045e\u0441\u0442\u0430\u0446\u044c \u0434\u0430 \u0436\u044b\u0446\u0446\u044f. \u041a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u0446\u0430 \u0456 \u043f\u0440\u044b\u0437\u0432\u044b\u0447\u0430\u0439\u0432\u0430\u0446\u0446\u0430 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u043a\u0430\u0431 \u0434\u0443\u0448\u0430, \u0430\u0434\u0440\u044b\u0432\u0430\u044e\u0447\u044b\u0441\u044f \u0430\u0434 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043c\u0430\u0433\u043b\u0430 \u0441\u0442\u0430\u0446\u044c \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0439 \u0456, \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u045e\u0448\u044b \u0432\u044f\u0440\u0448\u044b\u043d\u044f\u045e, \u043a\u0443\u0434\u044b \u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u0430\u044e\u0446\u044c \u0443\u0436\u043e \u0437\u044f\u043c\u043d\u044b\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456, \u0448\u0442\u043e \u043d\u044f\u0441\u0443\u0446\u044c \u0437\u0433\u0443\u0431\u0443, \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u0446\u044c \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u044e. \u0417\u0430\u043a\u043e\u043d \u0446\u0435\u043b\u0430 \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0437 \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u0434\u0443\u0445\u0430, \u0441\u0442\u0430\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u0437\u0430\u043a\u043e\u043d\u0443 \u0433\u0440\u0430\u0445\u0443. \u042f\u043a\u0456 \u0451\u0441\u0446\u044c \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u043b\u0435\u043a? \u00ab\u0425\u0442\u043e \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043c\u044f\u043d\u0435 \u0430\u0434 \u0433\u044d\u0442\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u0456?\u00bb (\u0420\u044b\u043c 7, 24). \u041b\u0430\u0441\u043a\u0430 \u0411\u043e\u0433\u0430 \u00ab\u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430\u00bb (\u0420\u044b\u043c 7, 25).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u0430\u0435\u043c \u043b\u0435\u043a\u0430\u0440\u0430, \u0442\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0436\u0430 \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u043b\u0435\u043a\u0456. \u041d\u0430\u0448\u044b\u043c \u043b\u0435\u043a\u0430\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043b\u0430\u0441\u043a\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u043d\u0430\u0448\u0430\u0435 \u0446\u0435\u043b\u0430 \u2013 \u0433\u044d\u0442\u0430 \u0446\u0435\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u0456. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u0446\u044c \u0437\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430. \u0425\u043e\u0446\u044c \u043c\u044b \u045e \u0446\u0435\u043b\u0435, \u043d\u0435 \u043f\u043e\u0439\u0434\u0437\u0435\u043c \u0437\u0430 \u0442\u044b\u043c, \u0448\u0442\u043e \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0443\u0446\u044f\u043a\u0430\u0446\u044c \u0430\u0434 \u0437\u0430\u043a\u043e\u043d\u0430\u045e \u043f\u0440\u044b\u0440\u043e\u0434\u044b, \u0430\u043b\u0435 \u043d\u0430 \u043f\u0435\u0440\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u043c \u0434\u0430\u0440\u044b \u043b\u0430\u0441\u043a\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0442\u043e \u044f\u0448\u0447\u044d? \u0421\u0432\u0435\u0442 \u0431\u044b\u045e \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c \u0410\u0434\u043d\u0430\u0433\u043e. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043c\u043e\u0433 \u0431\u044b \u043d\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c, \u043a\u0430\u043b\u0456 \u0431 \u0437\u0430\u0445\u0430\u0446\u0435\u045e. \u0410\u0434\u043d\u0430\u043a \u043f\u0430\u043b\u0456\u0447\u044b\u045e, \u0448\u0442\u043e \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u045e\u043d\u0456\u043a\u0430\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u0456 \u044f\u043a \u0447\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u043d\u0435\u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0433\u0430. \u0401\u043d \u043d\u0435 \u043c\u043e\u0433 \u043d\u0430\u0441 \u0437\u0431\u0430\u0432\u0456\u0446\u044c \u043b\u0435\u043f\u0448, \u0447\u044b\u043c \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c. \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u0436\u044b\u0446\u0446\u0451 \u045e\u0441\u0456\u043c. \u041c\u044b \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044e. \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u043c\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u043c \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0435\u043c \u043f\u0430\u0434\u0447\u0430\u0441 \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u043d\u043d\u044f \u0430\u0445\u0432\u044f\u0440\u044b. \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u2013 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430, \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u2013 \u0433\u044d\u0442\u0430 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442. \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0448\u0442\u043e\u0433\u0430\u0434\u043e\u0432\u0430\u0439 \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044e \u0441\u0432\u0435\u0442\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0428\u0442\u043e \u044f\u0448\u0447\u044d \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u0430 \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c, \u043a\u0430\u043b\u0456 \u045e\u043c\u0435\u0435\u043c \u043f\u0430 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0443 \u0411\u043e\u0433\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u0448\u0442\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u0441\u044f\u0431\u0435 \u0430\u0434\u043a\u0443\u043f\u0456\u043b\u0430? \u0422\u0430\u043c\u0443 \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0441\u043c\u0443\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0441\u043c\u0435\u0440\u0446\u0456, \u0431\u043e \u044f\u043d\u0430 \u2013 \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0441\u0456\u0445. \u041d\u0435 \u0442\u0440\u044d\u0431\u0430 \u045e\u0446\u044f\u043a\u0430\u0446\u044c \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456, \u0431\u043e \u0456 \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u043d\u0435 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u045e \u0456 \u043d\u0435 \u0430\u0434\u043a\u0456\u0434\u0430\u045e \u044f\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0435 \u0431\u044b\u043b\u0430 \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u043f\u0440\u044b\u0440\u043e\u0434\u0437\u0435, \u0442\u0430\u043a\u043e\u0439 \u044f\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u043f\u0430\u0441\u043b\u044f. \u041d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0411\u043e\u0433 \u043d\u0435 \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u043c\u0435\u0440\u0446\u044c, \u0430\u043b\u0435 \u0434\u0430\u045e \u044f\u0435 \u044f\u043a \u043b\u0435\u043a. \u041f\u0430\u0441\u043b\u044f \u045e\u043f\u0430\u0434\u043a\u0443 \u0436\u044b\u0446\u0446\u0451 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0441\u0442\u0430\u043b\u0430 \u043f\u043e\u045e\u043d\u044b\u043c \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u045e \u0456 \u043f\u0440\u0430\u0446\u044b \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0441\u043c\u0443\u0442\u043a\u0430\u043c. \u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u043f\u0430\u043a\u043b\u0430\u0441\u0446\u0456 \u043a\u0430\u043d\u0435\u0446 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u043c, \u043a\u0430\u0431 \u0441\u043c\u0435\u0440\u0446\u044c \u0430\u0434\u0434\u0430\u043b\u0430 \u043d\u0430\u0437\u0430\u0434 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0433\u0443\u0431\u0456\u043b\u0430 \u0436\u044b\u0446\u0446\u0451. \u0411\u0435\u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456 \u043b\u0430\u0441\u043a\u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0445\u0443\u0442\u0447\u044d\u0439 \u0446\u044f\u0436\u0430\u0440\u0430\u043c, \u0430 \u043d\u0435 \u0432\u044b\u0433\u0430\u0434\u0430\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0434\u0443\u0448\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0432\u044b\u0439\u0441\u0446\u0456 \u0437 \u043b\u0430\u0431\u0456\u0440\u044b\u043d\u0442\u0430 \u0436\u044b\u0446\u0446\u044f, \u0437 \u043f\u044b\u043b\u0443 \u0446\u0435\u043b\u0430 \u0456 \u0456\u0441\u0446\u0456 \u0434\u0430 \u0442\u043e\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u045e \u043d\u0435\u0431\u0435, \u0445\u043e\u0446\u044c \u0433\u044d\u0442\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0441\u0432\u044f\u0442\u044b\u0445. \u041c\u043e\u0436\u0430 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0445\u0432\u0430\u043b\u0443 \u0411\u043e\u0433\u0443, \u044f\u043a\u0443\u044e, \u044f\u043a \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f \u0437 \u043f\u0440\u0430\u0440\u043e\u0446\u043a\u0456\u0445 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u044f\u045e, \u0441\u043f\u044f\u0432\u0430\u044e\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u0433\u0440\u0430\u0435 \u043d\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0446\u044b\u0442\u0440\u0430\u0445: \u00ab\u0412\u044f\u043b\u0456\u043a\u0456\u044f \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0422\u0432\u0430\u0435, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b. \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0448\u043b\u044f\u0445\u0456 \u0422\u0432\u0430\u0435, \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443 \u043d\u0430\u0440\u043e\u0434\u0430\u045e! \u0425\u0442\u043e \u0436 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0431\u0430\u044f\u0446\u0446\u0430, \u041f\u0430\u043d\u0435, \u0456 \u043d\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0456\u043c\u0435\u043d\u0456 \u0422\u0432\u0430\u0439\u0433\u043e? \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0422\u044b \u0430\u0434\u0437\u0456\u043d \u0421\u0432\u044f\u0442\u044b, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0456 \u043f\u0430\u043a\u043b\u043e\u043d\u044f\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e\u00bb (\u0410\u043f 15, 3-4). \u0414\u0443\u0448\u0430 \u043c\u043e\u0436\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0422\u0432\u0430\u0451 \u0432\u044f\u0441\u0435\u043b\u043b\u0435, \u043e \u0415\u0437\u0443, \u043f\u0430\u0434\u0447\u0430\u0441 \u044f\u043a\u043e\u0433\u0430 \u0441\u044f\u0440\u043e\u0434 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u0445 \u0432\u043e\u043a\u043b\u0456\u0447\u0430\u045e \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u0426\u044f\u0431\u0435 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0443, \u0437 \u0437\u044f\u043c\u043b\u0456 \u0434\u0430 \u043d\u0435\u0431\u0430, \u044f\u043a\u0430\u044f \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u0441\u0430 \u0441\u0432\u0435\u0442\u0430\u043c, \u0430\u043b\u0435 \u0437\u043b\u0443\u0447\u0430\u043d\u0430\u044f \u0437 \u0434\u0443\u0445\u0430\u043c, \u00ab\u0434\u0430 \u0426\u044f\u0431\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043a\u043e\u0436\u043d\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u00bb (\u041f\u0441 65 [64]), 3).<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0421\u0432\u044f\u0442\u044b \u043a\u0430\u0440\u043e\u043b\u044c \u0414\u0430\u0432\u0456\u0434 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0456\u0445 \u043f\u0440\u0430\u0433\u043d\u0443\u045e \u0431\u0430\u0447\u044b\u0446\u044c \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430. \u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: \u00ab\u0410\u0434\u043d\u0430\u0433\u043e \u044f \u043f\u0440\u0430\u0448\u0443 \u045e \u041f\u0430\u043d\u0430 \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u0430\u0434\u0430\u044e, \u043a\u0430\u0431 \u0436\u044b\u0446\u044c \u043c\u043d\u0435 \u045e \u0434\u043e\u043c\u0435 \u041f\u0430\u043d\u0430 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0436\u044b\u0446\u0446\u044f \u043c\u0430\u0439\u0433\u043e. \u041a\u0430\u0431 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u0445\u0430\u0440\u0430\u0441\u0442\u0432\u043e \u041f\u0430\u043d\u0430\u00bb (\u041f\u0441 27 [26]), 4).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. 2 \u041c\u0430\u043a 12, 45b; \u041c\u0446 13, 43\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u044b\u044f, \u0445\u0442\u043e \u0437\u0430\u0441\u043d\u0443\u045e \u0443 \u0432\u0435\u0440\u044b, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0448\u0447\u043e\u0434\u0440\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041f\u0440\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0456 \u0437\u0430\u0437\u0437\u044f\u044e\u0446\u044c, \u044f\u043a \u0441\u043e\u043d\u0446\u0430, \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u0456\u0445 \u0410\u0439\u0446\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0410\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"805","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u043f\u0430\u043f\u044b \u042f\u043d\u0430 \u0425\u0425\u0406\u0406\u0406 \u043f\u0430\u0434\u0447\u0430\u0441 \u043a\u0430\u043d\u0430\u043d\u0456\u0437\u0430\u0446\u044b\u0456 \u0441\u0432. \u041c\u0430\u0440\u0446\u0456\u043d\u0430 \u0434\u044d \u041f\u043e\u0440\u044d\u0441\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Die 6 maii 1962: AAS 54 [1962], 306-309)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u00ab<\/span><span style=\"color: #ff0000; font-style: italic;\">\u041c\u0430\u0440\u0446\u0456\u043d \u043b\u044e\u0431\u043e\u0432\u0456<\/span><span style=\"color: #ff0000;\">\u00bb<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u044b\u0446\u0446\u044f \u0441\u0432. \u041c\u0430\u0440\u0446\u0456\u043d \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u0448\u0442\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u043c\u043e\u0436\u043d\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u043d\u0430 \u0448\u043b\u044f\u0445\u0443, \u044f\u043a\u0456 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u043c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u043a\u0430\u043b\u0456, \u043f\u0430-\u043f\u0435\u0440\u0448\u0430\u0435, \u043c\u044b \u043b\u044e\u0431\u0456\u043c \u0411\u043e\u0433\u0430 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u0443\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u0439 \u0456 \u045e\u0441\u0456\u043c \u0440\u043e\u0437\u0443\u043c\u0430\u043c, \u0456 \u043f\u0430-\u0434\u0440\u0443\u0433\u043e\u0435, \u043f\u0430\u0434\u043e\u0431\u043d\u0430 \u0434\u0430 \u043f\u0435\u0440\u0448\u0430\u0433\u0430: \u043a\u0430\u043b\u0456 \u043b\u044e\u0431\u0456\u043c \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 (\u043f\u0430\u0440. \u041c\u0446 22, 37-39).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0414\u0430\u0432\u0435\u0434\u0430\u045e\u0448\u044b\u0441\u044f, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0430\u043c \u0446\u044f\u0440\u043f\u0435\u045e \u0437\u0430 \u043d\u0430\u0441 \u0456 \u045e \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u045e\u0437\u043d\u0451\u0441 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f \u043d\u0430 \u0434\u0440\u044d\u0432\u0430 \u043a\u0440\u044b\u0436\u0430 (\u043f\u0430\u0440. 1 \u041f 2, 24), \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u045e \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430. \u0420\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u042f\u0433\u043e \u0436\u0430\u0445\u043b\u0456\u0432\u044b\u044f \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u043d\u0435 \u043c\u043e\u0433 \u0441\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043f\u0430\u0442\u043e\u043a\u0443 \u0441\u043b\u0451\u0437. \u0413\u043e\u0440\u0430\u0447\u0430 \u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0439\u0441\u043b\u0430\u045e\u043d\u0435\u0439\u0448\u044b \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0456. \u0422\u0430\u043c\u0443 \u0447\u0430\u0441\u0442\u0430, \u0441\u0445\u0430\u0432\u0430\u045e\u0448\u044b\u0441\u044f \u045e \u043a\u0430\u0441\u0446\u0451\u043b\u044c\u043d\u0430\u0439 \u0441\u0430\u043a\u0440\u044b\u0441\u0442\u044b\u0456, \u0448\u043c\u0430\u0442 \u0433\u0430\u0434\u0437\u0456\u043d\u0430\u045e \u0430\u0434\u0430\u0440\u0430\u0432\u0430\u045e \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u044b \u0421\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442; \u043f\u0440\u0430\u0433\u043d\u0443\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u042f\u0433\u043e \u044f\u043a \u043c\u0430\u0433\u0430 \u0447\u0430\u0441\u0446\u0435\u0439, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u044b\u043b\u043e \u043c\u0430\u0433\u0447\u044b\u043c\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0441\u0432. \u041c\u0430\u0440\u0446\u0456\u043d, \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u043d\u0430\u043a\u0430\u0437\u0430\u043c \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430, \u0430\u0442\u0430\u0447\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e, \u044f\u043a\u0430\u044f \u0432\u044b\u043f\u043b\u044b\u0432\u0430\u043b\u0430 \u0437 \u043d\u044f\u0437\u043b\u043e\u043c\u043d\u0430\u0439 \u0432\u0435\u0440\u044b \u0456 \u0437 \u043f\u0430\u043a\u043e\u0440\u043b\u0456\u0432\u0430\u0433\u0430 \u0434\u0443\u0445\u0430. \u041b\u044e\u0431\u0456\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0431\u043e \u0448\u0447\u044b\u0440\u0430 \u0431\u0430\u0447\u044b\u045e \u0443 \u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445 \u0456 \u0441\u0432\u0430\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e, \u0456 \u043b\u044e\u0431\u0456\u045e \u0456\u0445 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0441\u044f\u0431\u0435 \u0441\u0430\u043c\u043e\u0433\u0430, \u0431\u043e \u045e \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u043a\u043e\u0440\u044b \u043b\u0456\u0447\u044b\u045e \u0456\u043d\u0448\u044b\u0445 \u0431\u043e\u043b\u044c\u0448 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c\u0456 \u0456 \u043b\u0435\u043f\u0448\u044b\u043c\u0456 \u0437\u0430 \u0441\u044f\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0431\u0430\u0447\u0430\u045e \u043f\u0430\u043c\u044b\u043b\u043a\u0456 \u0456\u043d\u0448\u044b\u0445 \u0456 \u0434\u0430\u0440\u0430\u0432\u0430\u045e \u043d\u0430\u0432\u0430\u0442 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0443\u044e \u043a\u0440\u044b\u045e\u0434\u0443; \u0431\u044b\u045e \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u044b, \u0448\u0442\u043e \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e \u0441\u0430\u043c \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435 \u0431\u043e\u043b\u044c\u0448 \u0446\u044f\u0436\u043a\u043e\u0433\u0430 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f. \u0421\u0430 \u0448\u0447\u044b\u0440\u044b\u043c \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u043c \u0432\u044f\u0440\u0442\u0430\u045e \u0437\u0430\u0431\u043b\u0443\u043a\u0430\u043b\u044b\u0445 \u043d\u0430 \u043d\u0430\u043b\u0435\u0436\u043d\u044b \u0448\u043b\u044f\u0445; \u0441\u043f\u0430\u0433\u0430\u0434\u043d\u0430 \u0430\u043f\u0435\u043a\u0430\u0432\u0430\u045e\u0441\u044f \u0445\u0432\u043e\u0440\u044b\u043c\u0456, \u0443\u0431\u043e\u0433\u0456\u043c \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u045e \u0435\u0436\u0443, \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0443 \u0456 \u043b\u0435\u043a\u0456. \u042f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u043e\u0433, \u0447\u0443\u043b\u0430 \u0430\u043f\u0435\u043a\u0430\u0432\u0430\u045e\u0441\u044f \u0456 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u045e\u0441\u044f \u043f\u0440\u0430 \u0432\u044f\u0441\u043a\u043e\u045e\u0446\u0430\u045e, \u043d\u0435\u0433\u0440\u0430\u045e, \u043c\u0435\u0442\u044b\u0441\u0430\u045e, \u044f\u043a\u0456\u044f \u0442\u0430\u0434\u044b \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u0456 \u043d\u0430\u0439\u043f\u0440\u0430\u0441\u0446\u0435\u0439\u0448\u044b\u044f \u043f\u0430\u0441\u043b\u0443\u0433\u0456. \u0422\u0430\u043c\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043c\u044f\u043d\u0443\u0448\u043a\u0443 \u00ab\u041c\u0430\u0440\u0446\u0456\u043d \u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u044b \u0441\u0432\u044f\u0442\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u0435\u043c, \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0456 \u0446\u043d\u043e\u0442\u0430\u044e \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u045e \u0434\u0430 \u0432\u0435\u0440\u044b \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u044e\u0434\u0437\u0435\u0439, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0446\u044f\u043f\u0435\u0440 \u043c\u043e\u0436\u0430 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u043d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u045e. \u041d\u0430 \u0436\u0430\u043b\u044c, \u043d\u0435 \u045e\u0441\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0446\u044c \u0433\u044d\u0442\u044b\u044f \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0434\u0430\u0440\u044b \u044f\u043a \u0442\u0440\u044d\u0431\u0430, \u043d\u0435 \u045e\u0441\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u044e\u0446\u044c \u0456\u0445 \u0432\u0435\u043b\u0456\u0447. \u041c\u043d\u043e\u0433\u0456\u044f \u043b\u044e\u0434\u0437\u0456, \u0437\u0432\u0430\u0431\u043b\u0435\u043d\u044b\u044f \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u044e \u0433\u0440\u0430\u0445\u0443, \u043b\u0456\u0447\u0430\u0446\u044c \u0456\u0445 \u043d\u044f\u0437\u043d\u0430\u0447\u043d\u044b\u043c\u0456, \u0430\u0434\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u0434\u0430 \u0456\u0445 \u0432\u0430\u0440\u043e\u0436\u0430 \u0446\u0456 \u043f\u0440\u043e\u0441\u0442\u0430 \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u0430. \u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0441\u0432. \u041c\u0430\u0440\u0446\u0456\u043d\u0430 \u043f\u0430\u043a\u0430\u0436\u0430 \u043c\u043d\u043e\u0433\u0456\u043c, \u044f\u043a\u043e\u0439 \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u0439 \u0456 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0439 \u0440\u044d\u0447\u0447\u0443 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043a\u0440\u043e\u0447\u0430\u043d\u043d\u0435 \u0437\u0430 \u042f\u0433\u043e \u0411\u043e\u0441\u043a\u0456\u043c\u0456 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u043c\u0456.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u0421\u0456\u0440 31, 8. 11\u0430. 9\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u043d\u0435 \u043c\u0430\u0435 \u0432\u0456\u043d\u044b \u0456 \u044f\u043a\u0456 \u043d\u0435 \u0433\u043e\u043d\u0456\u0446\u0446\u0430 \u0437\u0430 \u0437\u043e\u043b\u0430\u0442\u0430\u043c, \u0456 \u043d\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u0441\u0432\u0430\u0451 \u0431\u0430\u0433\u0430\u0446\u0446\u0435. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0422\u0430\u043c\u0443 \u044f\u0433\u043e \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u041f\u0430\u043d\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0425\u0442\u043e \u0436 \u0433\u044d\u0442\u0430? \u041f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043c \u044f\u0433\u043e, \u0431\u043e \u0451\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0446\u0443\u0434\u044b \u043c\u0456\u0436 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0422\u0430\u043c\u0443.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"806","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041a\u0430\u0440\u0430\u043b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430, \u043f\u0430\u0434\u0447\u0430\u0441 \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430 \u0441\u0456\u043d\u043e\u0434\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Acta Ecclesi\u00e6 Mediolanensis, Mediolani 1599, 1177-1178)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041d\u0435 \u0431\u0443\u0434\u0437\u044c \u044f\u043a \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0434\u043d\u043e \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0435, \u0430 \u0434\u0440\u0443\u0433\u043e\u0435 \u0440\u043e\u0431\u0456\u0446\u044c&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0433\u043e\u0434\u043d\u044b, \u0443\u0441\u0435 \u043c\u044b \u0441\u043b\u0430\u0431\u044b\u044f, \u0430\u043b\u0435 \u041f\u0430\u043d \u0411\u043e\u0433 \u0434\u0430\u045e \u043d\u0430\u043c \u0441\u0440\u043e\u0434\u043a\u0456, \u0437 \u044f\u043a\u0456\u0445, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u0437\u0430\u0445\u043e\u0447\u0430\u043c, \u043c\u043e\u0436\u0430\u043c \u0441\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u044c. \u041f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u0456\u043c\u0441\u044f \u0434\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430, \u044f\u043a\u0456 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0430\u0434 \u044f\u0433\u043e \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0436\u044b\u0446\u0446\u044f, \u0443\u0441\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u0456 \u0430\u043d\u0451\u043b\u044c\u0441\u043a\u0456\u0445 \u0437\u0432\u044b\u0447\u0430\u044f\u045e \u0443 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u0445. \u0401\u043d \u0431\u044b \u0456 \u0445\u0430\u0446\u0435\u045e \u0443\u0441\u044f\u0433\u043e \u0433\u044d\u0442\u0430\u0433\u0430, \u0430\u043b\u0435 \u043d\u0435 \u0434\u0443\u043c\u0430\u0435 \u043f\u0440\u0430 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u043d\u043d\u0435 \u0441\u0440\u043e\u0434\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0432\u044f\u0434\u0443\u0446\u044c \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430: \u043f\u0440\u0430 \u043f\u043e\u0441\u0442, \u043c\u0430\u043b\u0456\u0442\u0432\u0443, \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u043d\u043d\u0435 \u0434\u0440\u044d\u043d\u043d\u044b\u0445 \u0456 \u0448\u043a\u043e\u0434\u043d\u044b\u0445 \u0440\u0430\u0437\u043c\u043e\u0432\u0430\u045e \u0456 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0447\u043d\u044b\u0445 \u0437\u043d\u0430\u0451\u043c\u0441\u0442\u0432\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0406\u043d\u0448\u044b \u043d\u0430\u0440\u0430\u043a\u0430\u0435, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u0451\u043d \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u0430\u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0446\u0456 \u0441\u043a\u043b\u0430\u0441\u0446\u0456 \u0430\u0445\u0432\u044f\u0440\u0443 \u0441\u0432. \u0406\u043c\u0448\u044b, \u0430\u0434\u0440\u0430\u0437\u0443 \u043b\u0435\u0437\u0443\u0446\u044c \u044f\u043c\u0443 \u045e \u0433\u0430\u043b\u0430\u0432\u0443 \u0442\u044b\u0441\u044f\u0447\u044b \u0441\u043f\u0440\u0430\u0432\u0430\u045e, \u044f\u043a\u0456\u044f \u0430\u0434\u0440\u044b\u0432\u0430\u044e\u0446\u044c \u044f\u0433\u043e \u0430\u0434 \u0411\u043e\u0433\u0430. \u0410\u043b\u0435 \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0445\u043e\u0440, \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u045e \u0441\u0432. \u0406\u043c\u0448\u0443, \u0448\u0442\u043e \u0440\u0430\u0431\u0456\u045e \u0443 \u0441\u0430\u043a\u0440\u044b\u0441\u0442\u044b\u0456, \u044f\u043a \u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e\u0441\u044f, \u044f\u043a\u0456\u044f \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u0430\u045e \u0441\u0440\u043e\u0434\u043a\u0456, \u043a\u0430\u0431 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0441\u0446\u044c?<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u043e\u0447\u0430\u0448, \u043a\u0430\u0431 \u044f \u0446\u044f\u0431\u0435 \u043f\u0430\u0432\u0443\u0447\u044b\u045e, \u044f\u043a \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u0446\u0446\u0430 \u045e \u0446\u043d\u043e\u0446\u0435, \u044f\u043a \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u043c \u0440\u0430\u0437\u0430\u043c, \u043a\u0430\u043b\u0456 \u0431\u044b\u045e \u0437\u0430\u0441\u044f\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u045e \u0445\u043e\u0440\u044b, \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u0443\u044e \u045e\u0432\u0430\u0433\u0443, \u0430 \u0442\u0432\u0430\u044e \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043c\u0456\u043b\u0430\u0439 \u0411\u043e\u0433\u0443? \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439, \u0448\u0442\u043e \u044f \u0441\u043a\u0430\u0436\u0443. \u041a\u0430\u043b\u0456 \u043f\u0440\u043e\u043c\u0435\u043d\u044c \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u045e\u0436\u043e \u0437\u0430\u044f\u0441\u043d\u0435\u0435 \u045e \u0442\u0430\u0431\u0435, \u043d\u0435 \u0456\u043c\u043a\u043d\u0456\u0441\u044f \u0430\u0434\u0440\u0430\u0437\u0443 \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u044f\u0433\u043e, \u043d\u0435 \u0432\u044b\u0441\u0442\u0430\u045e\u043b\u044f\u0439 \u044f\u0433\u043e \u043d\u0430 \u0432\u0435\u0446\u0435\u0440. \u041f\u0456\u043b\u044c\u043d\u0443\u0439 \u0430\u0433\u043e\u043d\u044c, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0433\u0430\u0441 \u0456 \u043d\u0435 \u0437\u0433\u0443\u0431\u0456\u045e \u0446\u044f\u043f\u043b\u0430. \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0443\u0446\u044f\u043a\u0430\u0439, \u2013 \u0442\u0430\u043a \u0434\u0430\u043b\u0451\u043a\u0430, \u044f\u043a \u043c\u043e\u0436\u0430\u0448, \u2013 \u0430\u0434 \u043d\u044f\u045e\u0432\u0430\u0436\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0442\u0440\u044b\u0432\u0430\u0439 \u0443 \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u0456 \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0439 \u043f\u0443\u0441\u0442\u044b\u0445 \u0440\u0430\u0437\u043c\u043e\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0431\u0435 \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c? \u0412\u0443\u0447\u044b \u0456 \u0441\u0430\u043c \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0439\u0441\u044f \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0434\u043b\u044f \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u0433\u044d\u0442\u0430\u0439 \u043f\u0430\u0441\u043b\u0443\u0433\u0456; \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0456\u043c\u043a\u043d\u0456\u0441\u044f \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451\u043c \u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456, \u043a\u0430\u0431 \u0456\u043d\u0448\u044b\u044f \u043d\u0435 \u0441\u043c\u044f\u044f\u043b\u0456\u0441\u044f \u0437 \u0442\u0432\u0430\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u045e \u0456 \u043d\u0435 \u043a\u0456\u0432\u0430\u043b\u0456 \u0433\u0430\u043b\u0430\u0432\u043e\u0439, \u043a\u0430\u043b\u0456 \u045e\u0431\u0430\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u0442\u044b \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u0435\u0448 \u0430\u0434\u043d\u043e, \u0430 \u0440\u043e\u0431\u0456\u0448 \u0434\u0440\u0443\u0433\u043e\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u044b \u043f\u0430\u0441\u0442\u044b\u0440? \u041d\u0435 \u0456\u043c\u043a\u043d\u0456\u0441\u044f \u0437 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d \u0437\u0430\u043d\u044f\u0434\u0431\u043e\u045e\u0432\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0456 \u043d\u0435 \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u0439 \u0441\u044f\u0431\u0435 \u045e\u0441\u0456\u043c \u043d\u0430\u0432\u043e\u043a\u0430\u043b, \u043a\u0430\u0431 \u0442\u0430\u0431\u0435 \u0437\u0443\u0441\u0456\u043c \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043b\u043e\u0441\u044f. \u0411\u043e \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c \u043f\u0440\u0430 \u0434\u0443\u0448\u044b, \u044f\u043a\u0456\u044f \u0442\u044b \u0432\u044f\u0434\u0437\u0435\u0448, \u0430\u043b\u0435 \u043d\u0435 \u0442\u0430\u043a, \u043a\u0430\u0431 \u0437\u0430\u0431\u044b\u0446\u044c \u043f\u0440\u0430 \u0441\u0432\u0430\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435, \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u043d\u0456\u0448\u0442\u043e \u0442\u0430\u043a \u043d\u0435 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430 \u043b\u044e\u0434\u0437\u044f\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u043a \u043c\u0435\u0434\u044b\u0442\u0430\u0446\u044b\u044f. \u042f\u043d\u0430 \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u0435 \u045e\u0441\u0435 \u043d\u0430\u0448\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u0435 \u0456\u043c \u0456 \u0456\u0434\u0437\u0435 \u0437\u0430 \u0456\u043c\u0456. \u00ab\u0411\u0443\u0434\u0443 \u0441\u043f\u044f\u0432\u0430\u0446\u044c, \u2013 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0440\u043e\u043a, \u2013 \u0456 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c\u00bb (\u043f\u0430\u0440. \u041f\u0441 101 [100], 1-2). \u041a\u0430\u043b\u0456 \u045e\u0434\u0437\u044f\u043b\u044f\u0435\u0448 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u044b, \u0434\u0443\u043c\u0430\u0439, \u0431\u0440\u0430\u0446\u0435, \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u0448. \u041a\u0430\u043b\u0456 \u0446\u044d\u043b\u0435\u0431\u0440\u0443\u0435\u0448 \u0441\u0432. \u0406\u043c\u0448\u0443, \u043f\u0430\u0434\u0443\u043c\u0430\u0439, \u0448\u0442\u043e \u0430\u0445\u0432\u044f\u0440\u0443\u0435\u0448. \u0421\u043f\u044f\u0432\u0430\u0435\u0448 \u0443 \u0445\u043e\u0440\u044b, \u0437\u0430\u0434\u0443\u043c\u0430\u0439\u0441\u044f, \u0437 \u043a\u0456\u043c \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u0435\u0448 \u0456 \u043f\u0440\u0430 \u0448\u0442\u043e \u043a\u0430\u0436\u0430\u0448. \u041a\u0430\u043b\u0456 \u0442\u044b \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a \u0434\u0443\u0448, \u043f\u0430\u043c\u044f\u0442\u0430\u0439, \u0447\u044b\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b\u044f, \u0456 \u00ab\u045e\u0441\u0451 \u045e \u0432\u0430\u0441 \u043d\u044f\u0445\u0430\u0439 \u0440\u043e\u0431\u0456\u0446\u0446\u0430 \u045e \u043b\u044e\u0431\u043e\u0432\u0456\u00bb (1 \u041a\u0430\u0440 16, 14). \u0422\u0430\u043a \u043c\u044b \u043b\u0451\u0433\u043a\u0430 \u0437\u043c\u043e\u0436\u0430\u043c \u043f\u0435\u0440\u0430\u0430\u0434\u043e\u043b\u0435\u0446\u044c \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u044f \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u044b, \u044f\u043a\u0456\u044f \u043d\u0430\u0441 \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u044e\u0446\u044c \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c (\u0431\u043e \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u044b \u0456 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b) \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c \u0441\u0456\u043b\u0443 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u043d\u0430\u0441 \u0441\u0430\u043c\u0456\u0445 \u0456 \u045e \u0456\u043d\u0448\u044b\u0445.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">1 \u0426\u0456\u043c 6<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\">, 11b; 4, 11. 12b. 6a<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0406\u043c\u043a\u043d\u0456\u0441\u044f \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0432\u0435\u0440\u044b, \u043b\u044e\u0431\u043e\u0432\u0456, \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0417\u0430\u0433\u0430\u0434\u0432\u0430\u0439 \u0433\u044d\u0442\u0430 \u0456 \u0433\u044d\u0442\u0430\u043c\u0443 \u043d\u0430\u0432\u0443\u0447\u0430\u0439; \u0441\u0442\u0430\u043d\u044c \u0434\u043b\u044f \u0432\u0435\u0440\u043d\u044b\u0445 \u0443\u0437\u043e\u0440\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u041a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0448 \u0431\u0440\u0430\u0442\u0430\u043c, \u0441\u0442\u0430\u043d\u0435\u0448 \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u043b\u0443\u0433\u043e\u044e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0417\u0430\u0433\u0430\u0434\u0432\u0430\u0439.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"807","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0426\u044d\u0437\u0430\u0440\u044b\u044f \u0410\u0440\u043b\u044c\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 229, 1-3: CCL 104, 905-908)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442 \u043c\u044b \u045e\u0441\u0435 \u0441\u0442\u0430\u043b\u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u043c\u0456 \u0411\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u043c\u044b \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u043c \u0441\u0451\u043d\u043d\u044f \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044e \u0433\u0430\u0434\u0430\u0432\u0456\u043d\u0443 \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f \u0433\u044d\u0442\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456. \u0410\u0434\u043d\u0430\u043a \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0456 \u0436\u044b\u0432\u043e\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043c\u044b \u0441\u0430\u043c\u0456. \u0417\u0440\u044d\u0448\u0442\u044b, \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u044e\u0446\u044c \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u041c\u0430\u0446\u0456-\u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0431\u043e \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u045e \u0456\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u043f\u0435\u0440\u0448\u0430\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u043c\u044b \u0431\u044b\u043b\u0456 \u043d\u0430\u0447\u044b\u043d\u043d\u044f\u043c\u0456, \u044f\u043a\u0456\u044f \u0437\u0430\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u043b\u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u0433\u043d\u0435\u0432\u0443, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0434\u0440\u0443\u0433\u043e\u043c\u0443 \u043c\u044b \u0441\u0442\u0430\u043b\u0456 \u043d\u0430\u0447\u044b\u043d\u043d\u044f\u043c\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u041f\u0435\u0440\u0448\u0430\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u043d\u0430\u043c \u0441\u043c\u0435\u0440\u0446\u044c, \u0434\u0440\u0443\u0433\u043e\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u043d\u0430\u0437\u0430\u0434 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043f\u0435\u0440\u0430\u0434 \u0445\u0440\u043e\u0441\u0442\u0430\u043c \u0443\u0441\u0435 \u043c\u044b \u0431\u044b\u043b\u0456 \u0436\u044b\u043b\u043b\u0451\u043c \u0441\u0430\u0442\u0430\u043d\u044b, \u043f\u0430\u0441\u043b\u044f \u0445\u0440\u043e\u0441\u0442\u0443 \u043c\u044b \u0441\u0442\u0430\u043b\u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439 \u0425\u0440\u044b\u0441\u0442\u0430. \u0410 \u043a\u0430\u043b\u0456 \u0431\u043e\u043b\u044c\u0448 \u0443\u0432\u0430\u0436\u043b\u0456\u0432\u0430 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u043c \u043d\u0430\u0434 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u043d\u0430\u0448\u0430\u0439 \u0434\u0443\u0448\u044b, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435\u043c, \u0448\u0442\u043e \u043c\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0436\u044b\u0432\u043e\u0439 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439 \u0411\u043e\u0433\u0430. \u0411\u043e\u0433 \u0436\u044b\u0432\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u00ab\u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0445, \u0437\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b\u0445 \u0440\u0443\u043a\u0430\u043c\u0456\u00bb (\u0414\u0437 17, 24), \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0434\u043e\u043c\u0435, \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b\u043c \u0437 \u0434\u0440\u044d\u0432\u0430 \u0456 \u043a\u0430\u043c\u0435\u043d\u044f, \u0430\u043b\u0435 \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0443 \u0434\u0443\u0448\u044b, \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0439 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0411\u043e\u0433\u0430 \u0440\u0443\u043a\u043e\u044e \u0441\u0430\u043c\u043e\u0433\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f. \u0411\u043e \u0442\u0430\u043a \u043a\u0430\u0437\u0430\u045e \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b: \u00ab\u0421\u0432\u044f\u0442\u044b\u043d\u044f \u0411\u043e\u0433\u0430 \u0441\u0432\u044f\u0442\u0430\u044f, \u0430 \u0451\u0439 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0435\u0441\u044f \u0432\u044b\u00bb (1 \u041a\u0430\u0440 3, 17).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0456 \u0432\u044b\u043a\u0456\u043d\u0443\u045e \u0441\u0430\u0442\u0430\u043d\u0443 \u0437 \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e, \u043a\u0430\u0431 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u0443 \u043d\u0430\u0441 \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0434\u043b\u044f \u0441\u044f\u0431\u0435. \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u043c\u043e\u0436\u0430\u043c, \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437 \u042f\u0433\u043e \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u044e \u0436\u044b\u0446\u044c \u0442\u0430\u043a, \u043a\u0430\u0431 \u043d\u0435 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0448\u043a\u043e\u0434\u044b \u0433\u044d\u0442\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0434\u0440\u044d\u043d\u043d\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456. \u0425\u0442\u043e \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0434\u0440\u044d\u043d\u043d\u0430, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0448\u043a\u043e\u0434\u0443 \u0425\u0440\u044b\u0441\u0442\u0443. \u0410 \u0442\u0430\u043c\u0443, \u044f\u043a \u044f \u0443\u0436\u043e \u0441\u043a\u0430\u0437\u0430\u045e, \u043f\u0435\u0440\u0448 \u0447\u044b\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441, \u043c\u044b \u0431\u044b\u043b\u0456 \u0436\u044b\u043b\u043b\u0451\u043c \u0441\u0430\u0442\u0430\u043d\u044b; \u043f\u0430\u0441\u043b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043b\u0430\u0441\u043a\u0443 \u0441\u0442\u0430\u0446\u044c \u0436\u044b\u043b\u043b\u0451\u043c \u0411\u043e\u0433\u0430; \u0411\u043e\u0433 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0443 \u043d\u0430\u0441 \u0436\u044b\u043b\u043b\u0451 \u0434\u043b\u044f \u0441\u044f\u0431\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u043c \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0446\u044c \u0433\u0430\u0434\u0430\u0432\u0456\u043d\u0443 \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u043d\u0430\u043c \u043d\u0435\u043b\u044c\u0433\u0430 \u0434\u0440\u044d\u043d\u043d\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456 \u0440\u0443\u0439\u043d\u0430\u0432\u0430\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u0436\u044b\u0432\u0443\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0411\u043e\u0433\u0430. \u0421\u043a\u0430\u0436\u0443 \u0442\u0430\u043a, \u043a\u0430\u0431 \u0443\u0441\u0435 \u043c\u0430\u0433\u043b\u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c: \u044f\u043a\u0456\u043c \u043c\u044b \u0445\u043e\u0447\u0430\u043c \u0431\u0430\u0447\u044b\u0446\u044c \u043a\u0430\u0441\u0446\u0451\u043b \u043a\u043e\u0436\u043d\u044b \u0440\u0430\u0437, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u043c \u0434\u0430 \u044f\u0433\u043e, \u0442\u0430\u043a \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u043e\u0447\u0430\u0448, \u043a\u0430\u0431 \u0431\u0430\u0437\u044b\u043b\u0456\u043a\u0430 \u0431\u044b\u043b\u0430 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0439? \u041d\u0435 \u0437\u0430\u0441\u043c\u0435\u0447\u0432\u0430\u0439 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b \u0431\u0440\u0443\u0434\u0430\u043c \u0433\u0440\u0430\u0445\u043e\u045e. \u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448, \u043a\u0430\u0431 \u0431\u0430\u0437\u044b\u043b\u0456\u043a\u0430 \u0437\u0437\u044f\u043b\u0430, \u043f\u0430\u043c\u044f\u0442\u0430\u0439, \u0448\u0442\u043e \u0411\u043e\u0433 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u0442\u0432\u0430\u044f \u0434\u0443\u0448\u0430 \u043d\u0435 \u0431\u044b\u043b\u0430 \u0430\u0437\u043c\u0440\u043e\u0447\u0430\u043d\u0430. \u041d\u044f\u0445\u0430\u0439, \u2013 \u044f\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u2013 \u0442\u0430\u043a \u0437\u0437\u044f\u0435 \u045e \u0432\u0430\u0441 \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u043a\u0430\u0431 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u0431\u044b\u045e \u0442\u043e\u0439, \u0445\u0442\u043e \u0451\u0441\u0446\u044c \u0443 \u043d\u0435\u0431\u0435. \u042f\u043a \u0442\u044b \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0448 \u0443 \u0433\u044d\u0442\u044b \u043a\u0430\u0441\u0446\u0451\u043b, \u0442\u0430\u043a \u0411\u043e\u0433 \u043f\u0440\u0430\u0433\u043d\u0435 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0442\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f: \u00ab\u041f\u0430\u0441\u044f\u043b\u044e\u0441\u044f \u0456 \u0431\u0443\u0434\u0443 \u0436\u044b\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0456\u0445\u00bb (\u043f\u0430\u0440. \u041b\u0435\u0432 26, 11. 12).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u042d\u0437\u0445 47, 1. 9\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u045e\u0431\u0430\u0447\u044b\u045e<\/span><span style=\"color: #ff0000;\"> <\/span><span>\u0432\u0430\u0434\u0443, \u044f\u043a\u0430\u044f \u0432\u044b\u0446\u044f\u043a\u0430\u043b\u0430 \u0437-\u043f\u0430\u0434 \u043f\u0440\u0430\u0432\u0430\u0433\u0430 \u0431\u043e\u043a\u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f; \u0456 \u043a\u0430\u0433\u043e \u0434\u0430\u0441\u044f\u0433\u0430\u043b\u0430 \u0433\u044d\u0442\u0430\u044f \u0432\u0430\u0434\u0430, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u043e\u0436\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u043a\u0430\u0437\u0430\u045e: \u0410\u043b\u043b\u0435\u043b\u044e\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u041f\u0430\u0434\u0447\u0430\u0441 \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u043d\u0430\u0440\u043e\u0434 \u0441\u043f\u044f\u0432\u0430\u045e \u0433\u0456\u043c\u043d\u044b, \u0456 \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u044f\u0433\u043e \u0433\u0443\u0447\u0430\u045e \u0445\u0432\u0430\u043b\u0430\u0441\u043f\u0435\u045e.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u043e\u0436\u043d\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"808","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 4, 1-2: PL 54, 148-149)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u043f\u0435\u0446\u044b\u044f\u043b\u044c\u043d\u0430\u0435 \u0437\u0430\u0434\u0430\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0425\u043e\u0446\u044c \u0443\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u0443\u043b\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b \u0456\u0435\u0440\u0430\u0440\u0445\u0456\u0447\u043d\u0430, \u043a\u0430\u0431 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0430\u0441\u0446\u044c \u0447\u043b\u0435\u043d\u0430\u045e \u0441\u043b\u0443\u0436\u044b\u043b\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u044e \u0446\u044d\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u0456 \u041c\u0456\u0441\u0442\u044b\u0447\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u0430\u0434\u043d\u0430\u043a, \u2013 \u044f\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u2013 \u0443\u0441\u0435 \u043c\u044b \u0430\u0434\u043d\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435 (\u043f\u0440\u0430. \u0413\u0430\u043b 3, 28). \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0434\u0434\u0437\u0435\u043b\u0435\u043d\u044b \u0430\u0434 \u0456\u043d\u0448\u044b\u0445 \u043f\u0430\u0441\u043b\u0443\u0433\u0430\u044e, \u044f\u043a\u0443\u044e \u0451\u043d \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u043a\u0430\u0431 \u043d\u0430\u0432\u0430\u0442 \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0430\u044f \u0447\u0430\u0441\u0442\u043a\u0430 \u0446\u0435\u043b\u0430 \u0431\u044b\u043b\u0430 \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u0430 \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u0456 \u0437 \u0413\u0430\u043b\u0430\u0432\u043e\u044e. \u0422\u0430\u043c\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u044b \u0456 \u0445\u0440\u043e\u0441\u0442\u0443 \u043c\u044b \u0433\u0430\u043d\u0430\u0440\u044b\u043c\u0441\u044f \u0430\u0434\u043d\u043e\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044e \u0456 \u0430\u0434\u043d\u043e\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u044f\u0442\u0440\u0430: \u00ab\u0412\u044b \u0441\u0430\u043c\u0456, \u044f\u043a \u0436\u044b\u0432\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456, \u0431\u0443\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u0434\u043e\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b, \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u044f\u0442\u043e\u0435, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u044f \u0411\u043e\u0433\u0443, \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430\u00bb (1 \u041f 2, 5), \u0456 \u0434\u0430\u043b\u0435\u0439: \u00ab\u0412\u044b \u0436 \u2013 \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u0440\u043e\u0434, \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b, \u043b\u044e\u0434, \u0443\u0437\u044f\u0442\u044b \u0411\u043e\u0433\u0430\u043c \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c\u00bb (1 \u041f 2, 9).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0441\u0456\u043c, \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u043c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u0437\u043d\u0430\u043a \u043a\u0440\u044b\u0436\u0430 \u043d\u0430\u0434\u0430\u0435 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0443\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0430 \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u043f\u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u043d\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e. \u0422\u0430\u043c\u0443 \u045e\u0441\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435, \u043f\u043e\u045e\u043d\u044b\u044f \u0414\u0443\u0445\u0430 \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u045e\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u0446\u044c, \u0448\u0442\u043e \u0456\u043c \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c, \u0437\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435\u043c \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0433\u0430 \u0437\u0430\u0434\u0430\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f, \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u044f \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0434\u0437\u0435\u043b \u0443 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0430\u0439 \u043f\u0430\u0441\u043b\u0443\u0437\u0435. \u0428\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0435 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0434\u0443\u0448\u0430, \u0430\u0434\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u044f \u0411\u043e\u0433\u0443, \u043c\u043e\u0436\u0430 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0430\u043c? \u0406 \u0448\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0430\u0435 \u0437\u0430 \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u041f\u0430\u043d\u0443 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f \u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u043d\u043d\u044f \u043d\u0430 \u0430\u043b\u0442\u0430\u0440\u044b \u0441\u044d\u0440\u0446\u0430 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u044b \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456? \u0406 \u0445\u043e\u0446\u044c \u043f\u0440\u0430\u0437 \u0411\u043e\u0436\u0443\u044e \u043b\u0430\u0441\u043a\u0443 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044e \u045e\u0441\u0456\u0445, \u0430\u0434\u043d\u0430\u043a \u0441\u0432\u044f\u0442\u044b\u043c \u0456 \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u044b\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0432\u044b \u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0433\u0430\u0434\u0430\u0432\u0456\u043d\u0435 \u043c\u0430\u0439\u0433\u043e \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u044f \u043d\u0456\u0431\u044b \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u0435. \u0412\u0430 \u045e\u0441\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u043d\u043d\u0435\u043c \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0430\u043b\u0435\u044e \u0448\u0447\u043e\u0434\u0440\u0430 \u0441\u044b\u0448\u043b\u043e \u043d\u0430 \u0432\u044b\u0448\u044d\u0439\u0448\u044b\u044f \u0441\u0442\u0443\u043f\u0435\u043d\u0456, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043d\u0435 \u043c\u0435\u043d\u0448 \u0448\u0447\u043e\u0434\u0440\u0430 \u043d\u0430 \u043d\u0456\u0436\u044d\u0439\u0448\u044b\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043a\u0430\u043b\u0456 \u045e\u0434\u0437\u0435\u043b \u0443 \u0433\u044d\u0442\u044b\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0434\u0430\u0440\u044b \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0442\u043e \u043d\u0430\u0448\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0456 \u045e\u0437\u043d\u0451\u0441\u043b\u0430\u0439, \u043a\u0430\u043b\u0456 \u0432\u044b \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0437\u0432\u044f\u0440\u0442\u0430\u0446\u044c \u0443\u0432\u0430\u0433\u0443 \u043d\u0430 \u043d\u0430\u0448\u0443\u044e \u0441\u0446\u0456\u043f\u043b\u0443\u044e \u0430\u0441\u043e\u0431\u0443, \u0430\u043b\u0435 \u0445\u0443\u0442\u0447\u044d\u0439 \u0443\u0441\u0451\u0439 \u0431\u044b\u0441\u0442\u0440\u0430\u0442\u043e\u0439 \u0440\u043e\u0437\u0443\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0446\u044c \u043f\u0440\u0430 \u0445\u0432\u0430\u043b\u0443 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430. \u041d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u0441\u0432\u0435\u0447\u0430\u043d\u044b \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0442\u0430\u043c\u0443, \u043d\u0430 \u043a\u0430\u0433\u043e \u041a\u0440\u044b\u043d\u0456\u0446\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u0445 \u043b\u0430\u0441\u043a\u0430\u045e \u0432\u044b\u043b\u0456\u043b\u0430 \u0441\u0432\u0430\u0435 \u0448\u0447\u043e\u0434\u0440\u044b\u044f \u0434\u0430\u0440\u044b. \u0428\u043c\u0430\u0442 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0451\u043d \u0441\u0430\u043c, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0447\u0430\u0433\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0431\u0435\u0437 \u044f\u0433\u043e \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u045e\u0436\u043e \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441 \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0443\u0436\u043e \u0441\u044f\u0431\u0435 \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041c\u0430\u0446 16, 18; \u041f\u0441 48 (47), 9d<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0415\u0437\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e \u0421\u044b\u043c\u043e\u043d\u0443: \u0422\u044b \u2014 \u041f\u0451\u0442\u0440, \u0441\u043a\u0430\u043b\u0430, \u0456 \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0441\u043a\u0430\u043b\u0435 \u042f \u043f\u0430\u0431\u0443\u0434\u0443\u044e \u041a\u0430\u0441\u0446\u0451\u043b \u041c\u043e\u0439, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0456 \u0431\u0440\u0430\u043c\u044b \u043f\u044f\u043a\u0435\u043b\u044c\u043d\u044b\u044f \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443\u0446\u044c \u044f\u0433\u043e.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u0411\u043e\u0433 \u0443\u043c\u0430\u0446\u0443\u0435 \u044f\u0433\u043e \u043d\u0430\u0432\u0435\u043a\u0456.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0406 \u0431\u0440\u0430\u043c\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"809","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0421\u0443\u043b\u044c\u043f\u0456\u0446\u044b\u044f \u0421\u044d\u0432\u044d\u0440\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 3, 6. 9-10. 11. 14-17. 21: SCh 133, 336-344)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423\u0431\u043e\u0433\u0456 \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u041c\u0430\u0440\u0446\u0456\u043d<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417\u0430\u0434\u043e\u045e\u0433\u0430 \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u0456 \u041c\u0430\u0440\u0446\u0456\u043d \u0432\u0435\u0434\u0430\u045e \u044f\u0435 \u0434\u0437\u0435\u043d\u044c \u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u045e \u0431\u0440\u0430\u0442\u0430\u043c, \u0448\u0442\u043e \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u044f\u0433\u043e \u0440\u0430\u0437\u0432\u0456\u0442\u0430\u043d\u043d\u0435 \u0437 \u0446\u0435\u043b\u0430\u043c. \u0423 \u0442\u043e\u0439 \u0447\u0430\u0441 \u0443\u0437\u043d\u0456\u043a\u043b\u0430 \u043f\u0430\u0442\u0440\u044d\u0431\u0430 \u043d\u0430\u0432\u0435\u0434\u0430\u0446\u044c \u041a\u0430\u043d\u0434\u0441\u043a\u0443\u044e \u0434\u044b\u044f\u0446\u044d\u0437\u0456\u044e, \u0431\u043e \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043f\u0430\u0434\u0437\u044f\u043b\u0456\u043b\u0456\u0441\u044f. \u041c\u0430\u0440\u0446\u0456\u043d \u0445\u0430\u0446\u0435\u045e \u0443\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u0446\u044c \u0442\u0430\u043c \u043c\u0456\u0440. \u0425\u043e\u0446\u044c \u0434\u043e\u0431\u0440\u0430 \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u044f\u0433\u043e \u043a\u0430\u043d\u0435\u0446, \u0430\u0434\u043d\u0430\u043a \u0433\u044d\u0442\u0430 \u043d\u0435 \u0441\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u044f\u0433\u043e \u0430\u0434 \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430 \u0434\u0437\u0435\u043b\u044f \u0432\u044b\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u0433\u044d\u0442\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b. \u0414\u0443\u043c\u0430\u045e, \u0448\u0442\u043e \u0432\u044f\u0440\u0442\u0430\u043d\u043d\u0435 \u043c\u0456\u0440\u0443 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0441\u0442\u0430\u043d\u0435 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c \u0434\u0430\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435\u043c \u044f\u0433\u043e \u0446\u043d\u043e\u0442\u0430\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435\u043a\u0430\u0442\u043e\u0440\u044b \u0447\u0430\u0441 \u0451\u043d \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u045e \u0433\u044d\u0442\u0430\u0439 \u043c\u044f\u0441\u0446\u043e\u0432\u0430\u0441\u0446\u0456, \u0445\u0443\u0442\u0447\u044d\u0439 \u0443 \u043a\u0430\u0441\u0446\u0451\u043b\u0435, \u0443 \u044f\u043a\u0456\u043c \u0441\u043f\u044b\u043d\u0456\u045e\u0441\u044f. \u041f\u0430\u0441\u043b\u044f \u045e\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u043d\u043d\u044f \u043c\u0456\u0440\u0443 \u0441\u044f\u0440\u043e\u0434 \u0434\u0443\u0445\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430, \u043a\u0430\u043b\u0456 \u043f\u043b\u0430\u043d\u0430\u0432\u0430\u045e \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u045e\u0436\u043e \u045e \u043a\u043b\u044f\u0448\u0442\u0430\u0440, \u0440\u0430\u043f\u0442\u0430\u043c \u043f\u0430\u0447\u0430\u045e \u0433\u0443\u0431\u043b\u044f\u0446\u044c \u0441\u0456\u043b\u044b. \u0422\u0430\u043c\u0443 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0431\u0440\u0430\u0442\u043e\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u0447\u0430\u0441 \u044f\u0433\u043e\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456 \u0431\u043b\u0456\u0437\u043a\u0456. \u0416\u0430\u043b\u044c \u0456 \u043f\u043b\u0430\u0447 \u0430\u0445\u0430\u043f\u0456\u043b\u0456 \u045e\u0441\u0456\u0445, \u0456 \u045e\u0441\u0435 \u0441\u0430 \u0441\u043b\u044f\u0437\u044c\u043c\u0456 \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430\u043b\u043e\u0441\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u043b\u0456: \u00ab\u0427\u0430\u043c\u0443 \u043f\u0430\u043a\u0456\u0434\u0430\u0435\u0448 \u043d\u0430\u0441, \u043e\u0439\u0447\u0430? \u041d\u0430 \u043a\u0430\u0433\u043e \u0442\u044b \u043f\u0430\u043a\u0456\u0434\u0430\u0435\u0448 \u043d\u0430\u0441, \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u0445? \u0423 \u0442\u0432\u0430\u044e \u0430\u045e\u0447\u0430\u0440\u043d\u044e \u045e\u0432\u0430\u0440\u0432\u0443\u0446\u0446\u0430 \u0434\u0440\u0430\u043f\u0435\u0436\u043d\u044b\u044f \u0432\u0430\u045e\u043a\u0456; \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u0441\u0442\u044b\u0440\u0430, \u0445\u0442\u043e \u0430\u0431\u0430\u0440\u043e\u043d\u0456\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u0456\u0445 \u043d\u0430\u043f\u0430\u0434\u0430\u045e? \u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0442\u044b \u0445\u043e\u0447\u0430\u0448 \u0431\u044b\u0446\u044c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0430\u043b\u0435 \u0442\u0432\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u043d\u0430\u0434\u0437\u0435\u0439\u043d\u0430\u044f \u0456 \u043d\u0435 \u0441\u0442\u0430\u043d\u0435 \u043c\u0435\u043d\u0448\u0430\u0439, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043f\u044f\u0448\u0430\u0446\u0446\u0430; \u0437\u043b\u0456\u0442\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u0442\u044b\u043c\u0456, \u043a\u0430\u0433\u043e \u043f\u0430\u043a\u0456\u0434\u0430\u0435\u0448\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u0434\u044b \u041c\u0430\u0440\u0446\u0456\u043d, \u0443\u0437\u0440\u0443\u0448\u0430\u043d\u044b \u0441\u043b\u044f\u0437\u044c\u043c\u0456, \u2013 \u0431\u043e \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u045e \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u044b \u0437 \u041f\u0430\u043d\u0430\u043c \u0443 \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u2013 \u0437\u0430\u043f\u043b\u0430\u043a\u0430\u045e \u0456, \u0437\u0432\u044f\u0440\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u0434\u0430 \u042f\u0433\u043e, \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u043b\u0430\u0447\u0443\u0447\u044b\u043c: \u00ab\u041f\u0430\u043d\u0435, \u043a\u0430\u043b\u0456 \u044f \u044f\u0448\u0447\u044d \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b \u0422\u0432\u0430\u0439\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443, \u043d\u0435 \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u044e\u0441\u044f \u0430\u0434 \u043f\u0440\u0430\u0446\u044b. \u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0422\u0432\u0430\u044f \u0432\u043e\u043b\u044f\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u042f\u043a\u0456 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a! \u041d\u0435\u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043d\u044b \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u043c\u0456, \u043d\u0435\u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043d\u044b \u043d\u0430\u0432\u0430\u0442 \u0441\u043c\u0435\u0440\u0446\u044e. \u041d\u0435 \u0445\u0456\u0441\u0442\u0430\u045e\u0441\u044f \u043d\u0456 \u045e \u0430\u0434\u0437\u0456\u043d, \u043d\u0456 \u045e \u0434\u0440\u0443\u0433\u0456 \u0431\u043e\u043a: \u043d\u0435 \u0431\u0430\u044f\u045e\u0441\u044f \u0441\u043c\u0435\u0440\u0446\u0456, \u043d\u0435 \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u045e\u0441\u044f \u0436\u044b\u0446\u044c. \u0423\u0437\u043d\u044f\u045e\u0448\u044b \u0432\u043e\u0447\u044b \u0456 \u0440\u0443\u043a\u0456 \u0434\u0430 \u043d\u0435\u0431\u0430, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0442\u0440\u044b\u0432\u0430\u045e \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c. \u0421\u0432\u044f\u0442\u0430\u0440\u044b, \u044f\u043a\u0456\u044f \u0441\u0430\u0431\u0440\u0430\u043b\u0456\u0441\u044f \u0432\u0430\u043a\u043e\u043b \u044f\u0433\u043e, \u043f\u0440\u0430\u0441\u0456\u043b\u0456, \u043a\u0430\u0431 \u0451\u043d \u0434\u0430\u045e \u0430\u0434\u043f\u0430\u0447\u044b\u0446\u044c \u0446\u0435\u043b\u0443 \u0456 \u043b\u0451\u0433 \u043d\u0430 \u0431\u043e\u043a. \u0410\u0434\u043d\u0430\u043a \u0451\u043d \u0430\u0434\u043a\u0430\u0437\u0430\u045e: \u00ab\u0414\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u043c\u043d\u0435, \u0431\u0440\u0430\u0442\u044b, \u0434\u0430\u0437\u0432\u043e\u043b\u044c\u0446\u0435 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0443 \u043d\u0435\u0431\u0430, \u0430 \u043d\u0435 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u043a\u0430\u0431 \u043c\u0430\u044f \u0434\u0443\u0448\u0430, \u044f\u043a\u0430\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u0446\u0446\u0430 \u0434\u0430 \u041f\u0430\u043d\u0430, \u043f\u0430\u0439\u0448\u043b\u0430 \u045e \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u044b\u043c \u043a\u0456\u0440\u0443\u043d\u043a\u0443\u00bb. \u0421\u043a\u0430\u0437\u0430\u045e\u0448\u044b \u0433\u044d\u0442\u0430, \u0451\u043d \u0443\u0431\u0430\u0447\u044b\u045e \u0441\u0430\u0442\u0430\u043d\u0443, \u0448\u0442\u043e \u0441\u0442\u0430\u044f\u045e \u043f\u043e\u0431\u0430\u0447. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0427\u0430\u0433\u043e \u0447\u0430\u043a\u0430\u0435\u0448, \u043a\u0440\u044b\u0432\u0430\u0436\u044d\u0440\u043d\u044b \u0437\u0432\u0435\u0440? \u041d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u0443\u0432\u0430 \u043c\u043d\u0435, \u043f\u0440\u0430\u043a\u043b\u044f\u0442\u044b; \u043c\u044f\u043d\u0435 \u043f\u0440\u044b\u043c\u0435 \u045e\u043b\u043e\u043d\u043d\u0435 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0417 \u0433\u044d\u0442\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0430\u0434\u0434\u0430\u045e \u043d\u0435\u0431\u0443 \u0434\u0443\u0445\u0430. \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u041c\u0430\u0440\u0446\u0456\u043d \u043f\u0440\u044b\u043d\u044f\u0442\u044b \u043d\u0430 \u045e\u043b\u043e\u043d\u043d\u0435 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u0443\u0431\u043e\u0433\u0456 \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u041c\u0430\u0440\u0446\u0456\u043d \u0431\u0430\u0433\u0430\u0442\u044b\u043c \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u043d\u0435\u0431\u0430.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b, \u0431\u043e \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0430\u0434\u043c\u0430\u043d\u0443 \u045e \u0442\u0432\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u0445, \u0442\u044b \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u0441\u0443\u0434\u0437\u0456\u045e \u0456 \u043d\u0456\u043a\u043e\u0433\u0430 \u043d\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u045e! <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0423 \u0442\u0432\u0430\u0456\u0445 \u0432\u0443\u0441\u043d\u0430\u0445 \u0431\u044b\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043f\u0430\u043a\u043e\u0439, \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a. <\/span><span>\u041e \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u044b \u045e \u043f\u0440\u0430\u0446\u044b, \u043d\u0435\u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0430\u043d\u044b \u0441\u043c\u0435\u0440\u0446\u044e, \u044f\u043a\u0456 \u043d\u0435 \u0431\u0430\u044f\u045e\u0441\u044f \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0456 \u043d\u0435 \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u045e\u0441\u044f \u0436\u044b\u0446\u044c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u0423 \u0442\u0432\u0430\u0456\u0445.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"810","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u042d\u043d\u0446\u044b\u043a\u043b\u0456\u043a\u0430 <\/span><span style=\"font-style: italic;\">Eccl\u00e9siam Dei<\/span><span> \u043f\u0430\u043f\u044b \u041f\u0456\u044f \u0425\u0406&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(AAS 15 [1923], 573. 576-577)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430\u043b\u0456\u045e \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0437\u0430 \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0433\u0430 \u043d\u0430\u043c\u0435\u0440\u0443 \u0411\u043e\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u0442\u0430\u043a, \u043a\u0430\u0431 \u0443 \u043f\u043e\u045e\u043d\u0456 \u0447\u0430\u0441\u0443 \u043c\u043e\u0433 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u044f\u043a \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0441\u044f\u043c\u2019\u044f, \u0448\u0442\u043e \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u045e\u0441\u0451 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430. \u0412\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456 \u0432\u044b\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0451\u043d, \u0430\u043a\u0440\u0430\u043c\u044f \u0456\u043d\u0448\u044b\u0445 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u0445 \u0440\u044b\u0441\u0430\u045e, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u044d\u043a\u0443\u043c\u0435\u043d\u0456\u0447\u043d\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u044e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0414\u0430\u0434\u0437\u0435\u043d\u0430 \u041c\u043d\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u044f \u045e\u043b\u0430\u0434\u0430 \u043d\u0430 \u043d\u0435\u0431\u0435 \u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0414\u044b\u043a \u0456\u0434\u0437\u0456\u0446\u0435 \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u0439\u0446\u0435 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b\u00bb (\u041c\u0446 28, 18-19), \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u0437\u0430\u0434\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0441\u0430\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0434 \u0410\u0439\u0446\u0430, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0436\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u043a\u0430\u043b\u0435\u0433\u0456\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0443\u0442\u0432\u0430\u0440\u0430\u043b\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u0435\u0434\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u0443\u043d\u0443\u0442\u0440\u0430\u043d\u0430 \u0431\u044b\u043b\u0430 \u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u0441\u0430\u043c\u044b\u043c \u043c\u043e\u0446\u043d\u044b\u043c \u043f\u0430\u0434\u0432\u043e\u0439\u043d\u044b\u043c \u0432\u0443\u0437\u043b\u043e\u043c: \u0442\u043e\u0439 \u0441\u0430\u043c\u0430\u0439 \u0432\u0435\u0440\u0430\u0439 \u0456 \u0442\u043e\u0439 \u0441\u0430\u043c\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e, \u044f\u043a\u0430\u044f \u00ab\u0432\u044b\u043b\u0456\u043b\u0430\u0441\u044f \u045e \u0441\u044d\u0440\u0446\u044b \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430\u00bb (\u043f\u0430\u0440. \u0420\u044b\u043c 5, 5), \u0430 \u0437\u043d\u0435\u0448\u043d\u0435: \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0430\u0434\u043d\u0430\u0433\u043e \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u043f\u0440\u0430\u0437 \u0434\u0430\u0440\u0443\u0447\u044d\u043d\u043d\u0435 \u041f\u044f\u0442\u0440\u0443 \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u0430 \u0441\u044f\u0440\u043e\u0434 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u044f\u043a \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0433\u0430 \u043f\u0440\u044b\u043d\u0446\u044b\u043f\u0443 \u0456 \u0444\u0443\u043d\u0434\u0430\u043c\u0435\u043d\u0442\u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456. \u041a\u0430\u0431 \u0433\u044d\u0442\u0430\u044f \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u0437\u0433\u043e\u0434\u0430 \u0442\u0440\u044b\u0432\u0430\u043b\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u0411\u043e\u0433 \u0443 \u0441\u0432\u0430\u0456\u043c \u041f\u0440\u043e\u0432\u0456\u0434\u0437\u0435 \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u044f\u0435 \u043d\u0456\u0431\u044b \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043f\u044f\u0447\u0430\u0442\u043a\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0442\u0430\u043a\u0443\u044e \u0445\u0432\u0430\u043b\u0443 \u0431\u044b\u045e \u0433\u043e\u0434\u043d\u044b \u0430\u0440\u0446\u044b\u0431\u0456\u0441\u043a\u0443\u043f \u041f\u043e\u043b\u0430\u0446\u043a\u0430, \u042f\u0437\u0430\u0444\u0430\u0442, \u0443\u0441\u0445\u043e\u0434\u043d\u044f\u0433\u0430 \u0441\u043b\u0430\u0432\u044f\u043d\u0441\u043a\u0430\u0433\u0430 \u0430\u0431\u0440\u0430\u0434\u0443, \u0443 \u044f\u043a\u0456\u043c \u043c\u044b \u0431\u0430\u0447\u044b\u043c \u0446\u0443\u0434\u043e\u045e\u043d\u0443\u044e \u0445\u0432\u0430\u043b\u0443 \u0456 \u0430\u043f\u0456\u0440\u044b\u0448\u0447\u0430 \u045e\u0441\u0445\u043e\u0434\u043d\u0456\u0445 \u0441\u043b\u0430\u0432\u044f\u043d\u0430\u045e. \u0411\u043e \u043d\u0456\u0445\u0442\u043e \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u044f\u0433\u043e, \u043d\u0430\u043f\u044d\u045e\u043d\u0430, \u043d\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u0456\u0445 \u0456\u043c\u044f \u0456 \u043d\u0435 \u043f\u0440\u044b\u0447\u044b\u043d\u0456\u045e\u0441\u044f \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0442\u044b\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u044f\u043a \u0433\u044d\u0442\u044b \u043f\u0430\u0441\u0442\u044b\u0440 \u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u043b\u0456\u045e \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0437\u0430 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u041f\u0430\u0434 \u0443\u043f\u043b\u044b\u0432\u0430\u043c \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u044f \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u0448\u0442\u043e \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0437\u043c\u043e\u0436\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0434\u043b\u044f \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 \u045e \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0437\u0430\u0445\u0430\u0432\u0430\u0435 \u045e\u0441\u0445\u043e\u0434\u043d\u0456 \u0441\u043b\u0430\u0432\u044f\u043d\u0441\u043a\u0456 \u0430\u0431\u0440\u0430\u0434 \u0456 \u0431\u0430\u0437\u044b\u043b\u0456\u044f\u043d\u0441\u043a\u0443\u044e \u0440\u044d\u0433\u0443\u043b\u0443 \u043c\u0430\u043d\u0430\u0441\u043a\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423 \u043a\u043b\u043e\u043f\u0430\u0446\u0435 \u043d\u0430\u0439\u043f\u0435\u0440\u0448 \u0430\u0431 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0456\u0445 \u0437\u0435\u043c\u043b\u044f\u043a\u043e\u045e \u0437 \u043f\u0430\u0441\u0430\u0434\u0430\u043c \u0441\u0432. \u041f\u044f\u0442\u0440\u0430, \u0443\u0441\u044e\u0434\u044b \u0448\u0443\u043a\u0430\u045e \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u0456 \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0433\u044d\u0442\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u044f\u0435 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u044f. \u0410\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u045e \u043b\u0456\u0442\u0443\u0440\u0433\u0456\u0447\u043d\u044b\u044f \u043a\u043d\u0456\u0433\u0456, \u044f\u043a\u0456\u044f, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0440\u044d\u043a\u0430\u043c\u0435\u043d\u0434\u0430\u0446\u044b\u0439 \u0410\u0439\u0446\u043e\u045e, \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u043b\u0456\u0441\u044f \u043d\u0430 \u0423\u0441\u0445\u043e\u0434\u0437\u0435, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434\u043b\u0443\u0447\u0430\u043d\u044b\u043c\u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u043c\u0456. \u041f\u0430\u0441\u043b\u044f \u0442\u0430\u043a\u043e\u0439 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0439 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u043e\u045e\u043a\u0456 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u045e \u0441\u043f\u0440\u0430\u0432\u0443 \u043f\u0430 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u0456. \u0420\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430 \u0437 \u0442\u0430\u043a\u043e\u0439 \u043c\u043e\u0446\u0430\u044e, \u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e, \u0456 \u0442\u0430\u043a \u043f\u043b\u0451\u043d\u043d\u0430, \u0448\u0442\u043e \u044f\u0433\u043e\u043d\u044b\u044f \u0432\u043e\u0440\u0430\u0433\u0456 \u043d\u0430\u0437\u0432\u0430\u043b\u0456 \u044f\u0433\u043e \u00ab\u0434\u0443\u0448\u0430\u0445\u0432\u0430\u0442\u0430\u043c\u00bb.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042f\u043d 17, 11b. 23. 22a<\/span><\/p>\r\n<p style=\"text-indent: 32pt; text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0415\u0437\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e: \u041e\u0439\u0447\u0430 \u0441\u0432\u044f\u0442\u044b, \u0437\u0430\u0445\u0430\u0432\u0430\u0439 \u0456\u0445 \u0443 \u0456\u043c\u0435\u043d\u0456 \u0422\u0432\u0430\u0456\u043c, \u044f\u043a\u043e\u0435 \u0422\u044b \u0434\u0430\u045e \u041c\u043d\u0435, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u0431\u044b\u043b\u0456 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u045e \u0430\u0434\u043d\u043e, \u043a\u0430\u0431 \u0441\u0432\u0435\u0442 \u043f\u0430\u0437\u043d\u0430\u045e, \u0448\u0442\u043e \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u0421\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u0422\u044b \u0434\u0430\u045e \u041c\u043d\u0435, \u042f \u0434\u0430\u045e \u0456\u043c.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431 \u0431\u044b\u043b\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"811","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041b\u0443\u043a\u0456\u00bb \u0441\u0432. \u0410\u043b\u044c\u0431\u044d\u0440\u0442\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(22, 19; Opera omnia, Parisiis 1890-1899, 23, 672-674)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u0441\u0442\u044b\u0440 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a \u0443 \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0446\u0435\u043b\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u00ab\u0413\u044d\u0442\u0430 \u0447\u044b\u043d\u0456\u0446\u0435 \u043d\u0430 \u041c\u0430\u044e \u043f\u0430\u043c\u044f\u0446\u044c\u00bb (\u041b\u043a 22, 19). \u0423 \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u0442\u0440\u044d\u0431\u0430 \u0430\u0434\u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434\u0437\u0432\u0435 \u0440\u044d\u0447\u044b. \u041f\u0430-\u043f\u0435\u0440\u0448\u0430\u0435, \u0433\u044d\u0442\u0430 \u043d\u0430\u043a\u0430\u0437 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0443, \u0448\u0442\u043e \u0431\u0430\u0447\u043d\u0430 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: \u00ab\u0413\u044d\u0442\u0430 \u0447\u044b\u043d\u0456\u0446\u0435\u00bb. \u041f\u0430-\u0434\u0440\u0443\u0433\u043e\u0435, \u0433\u044d\u0442\u0430 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0443\u0441\u043f\u0430\u043c\u0456\u043d \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0430\u0434\u0434\u0430\u0435 \u0441\u044f\u0431\u0435 \u0437\u0430 \u043d\u0430\u0441.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430: \u00ab\u0413\u044d\u0442\u0430 \u0447\u044b\u043d\u0456\u0446\u0435\u00bb. \u041d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0433\u0430, \u043d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u0433\u0430, \u0431\u043e\u043b\u044c\u0448 \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u0430\u0433\u0430, \u0431\u043e\u043b\u044c\u0448 \u043c\u0456\u043b\u0430\u0433\u0430, \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0433\u0430 \u0432\u0435\u0447\u043d\u0430\u043c\u0443 \u0436\u044b\u0446\u0446\u044e \u043d\u0435\u043b\u044c\u0433\u0430 \u0431\u044b\u043b\u043e \u043d\u0430\u043a\u0430\u0437\u0430\u0446\u044c. \u0420\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u043c \u043f\u0430 \u0447\u0430\u0440\u0437\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0413\u044d\u0442\u044b \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u043a\u0430\u0440\u044b\u0441\u043d\u044b \u0434\u043b\u044f \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u044f \u0433\u0440\u0430\u0445\u043e\u045e, \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b \u045e \u043d\u0430\u0448\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0434\u043b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u043b\u0430\u0441\u043a\u0456. \u00ab\u0401\u043d, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0410\u0439\u0446\u0435\u0446 \u0434\u0443\u0445\u0430\u045e, \u0432\u044f\u0434\u0437\u0435 \u043d\u0430\u0441 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043a\u0430\u0440\u044b\u0441\u043d\u0430\u0435 \u0434\u043b\u044f \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456\u00bb. \u0410 \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u0430 \u045e \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0456, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u0456 \u0437\u0430 \u043d\u0430\u0441 \u0410\u0439\u0446\u0443 \u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0446\u0435 \u0456 \u045e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u0456 \u043d\u0430\u043c \u0443 \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0443. \u00ab\u0406 \u0437\u0430 \u0456\u0445 \u042f \u043f\u0430\u0441\u0432\u044f\u0447\u0430\u044e \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u0456 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b\u044f \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435\u00bb (\u042f\u043d 17, 19). \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0441\u044f\u0431\u0435 \u0411\u043e\u0433\u0443 \u044f\u043a \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443, \u00ab\u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435 \u0430\u0434 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u045e \u0434\u0437\u0435\u043b\u044f \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0436\u044b\u0432\u043e\u043c\u0443 \u0411\u043e\u0433\u0443\u00bb (\u0413\u0431\u0440 9, 14).<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0456\u0447\u043e\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0433\u0430 \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0437\u0440\u0430\u0431\u0456\u0446\u044c. \u0428\u0442\u043e \u0436 \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435 \u0437\u0430 \u0442\u043e\u0435, \u0443 \u0447\u044b\u043c \u0411\u043e\u0433 \u0432\u044b\u044f\u0432\u0456\u0446\u044c \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u0441\u044e \u0441\u0432\u0430\u044e \u0441\u043b\u043e\u0434\u044b\u0447? \u00ab\u0422\u044b \u0434\u0430\u045e \u0456\u043c, \u0431\u0435\u0437 \u044f\u043a\u043e\u0433\u0430-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u0456\u0445\u043d\u044f\u0433\u0430 \u0432\u044b\u0441\u0456\u043b\u043a\u0443, \u0433\u0430\u0442\u043e\u0432\u044b \u0445\u043b\u0435\u0431 \u0437 \u043d\u0435\u0431\u0430, \u044f\u043a\u0456 \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u0440\u0430\u0441\u043a\u043e\u0448\u0443 \u0456 \u0441\u043b\u043e\u0434\u044b\u0447 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0441\u043c\u0430\u043a\u0443. \u0422\u0432\u043e\u0439 \u0434\u0430\u0440 \u0434\u0430\u0432\u0430\u045e \u0430\u0434\u0447\u0443\u0446\u044c \u0422\u0432\u0430\u044e \u0434\u0430\u0431\u0440\u044b\u043d\u044e \u0434\u0430 \u0422\u0432\u0430\u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439 \u0456, \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u0432\u043e\u043b\u0456 \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u045e\u0441\u044f \u045e \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043a\u043e\u0436\u043d\u044b \u0436\u0430\u0434\u0430\u0435\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0456\u0447\u043e\u0433\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u043e\u043b\u044c\u0448 \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u0430\u0433\u0430 \u043d\u0435\u043b\u044c\u0433\u0430 \u0431\u044b\u043b\u043e \u043f\u0430\u0440\u0430\u0456\u0446\u044c. \u0413\u044d\u0442\u044b \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u043b\u0451\u043d\u0430\u043c \u0414\u0440\u044d\u0432\u0430 \u0436\u044b\u0446\u0446\u044f. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u043f\u0440\u044b\u043c\u0430\u0435 \u044f\u0433\u043e \u043f\u0430\u0431\u043e\u0436\u043d\u0430 \u0456 \u0437 \u0436\u044b\u0432\u043e\u0439 \u0432\u0435\u0440\u0430\u044e, \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u043d\u0456\u043a\u043e\u043b\u0456 \u0441\u043c\u0435\u0440\u0446\u0456. \u00ab\u0401\u043d \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u0440\u044d\u0432\u0430\u043c \u0436\u044b\u0446\u0446\u044f \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u044f\u0433\u043e; \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u044f\u0433\u043e \u043c\u0430\u0435\u00bb (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 3, 18). \u00ab\u0425\u0442\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435 \u041c\u044f\u043d\u0435, \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u041c\u044f\u043d\u0435\u00bb (\u042f\u043d 6, 57).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0456\u0432\u043e\u0434\u043d\u044b \u0456\u043d\u0448\u044b \u043d\u0430\u043a\u0430\u0437 \u043d\u0435 \u043c\u043e\u0433 \u0431\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u043c\u0456\u043b\u044b\u043c. \u0411\u043e \u0433\u044d\u0442\u0430 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043b\u044e\u0431\u043e\u045e \u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u044c. \u0417\u043d\u0430\u043a \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u2013 \u0433\u044d\u0442\u0430 \u0434\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u044f\u043a \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a: \u00ab\u0426\u0456 \u043d\u0435 \u043a\u0430\u0437\u0430\u043b\u0456 \u045e \u043c\u0430\u0456\u043c \u0448\u0430\u0442\u0440\u044b: \u201c\u0425\u0442\u043e \u0434\u0430\u0441\u0446\u044c \u043d\u0430\u043c \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u043c\u044b \u043d\u0430\u0441\u044b\u0446\u0456\u043b\u0456\u0441\u044f?\u201d\u00bb (\u0401\u045e 31, 31). \u041d\u0456\u0431\u044b \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u042f \u0442\u0430\u043a \u043c\u043e\u0446\u043d\u0430 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0456\u0445, \u0430 \u044f\u043d\u044b \u041c\u044f\u043d\u0435, \u0448\u0442\u043e \u044f \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0431\u044b\u0446\u044c \u0443 \u0456\u0445\u043d\u0456\u0445 \u0441\u044d\u0440\u0446\u0430\u0445, \u0430 \u044f\u043d\u044b \u043f\u0430\u0436\u0430\u0434\u0430\u043b\u0456 \u0442\u0430\u043a \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u041c\u044f\u043d\u0435, \u043a\u0430\u0431, \u0443\u043a\u043b\u044e\u0447\u0430\u043d\u044b\u044f \u045e \u041c\u044f\u043d\u0435, \u043c\u0430\u0433\u043b\u0456 \u0441\u0442\u0430\u0446\u044c \u043c\u0430\u0456\u043c\u0456 \u0447\u043b\u0435\u043d\u0430\u043c\u0456. \u0411\u043e\u043b\u044c\u0448 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u0430 \u0456 \u0431\u043e\u043b\u044c\u0448 \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u044f\u043d\u044b \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0437\u2019\u044f\u0434\u043d\u0430\u0446\u0446\u0430 \u0441\u0430 \u041c\u043d\u043e\u044e, \u043d\u0456 \u042f \u0437 \u0456\u043c\u0456\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0423\u0440\u044d\u0448\u0446\u0435, \u043d\u0456\u0432\u043e\u0434\u0437\u0456\u043d \u043d\u0430\u043a\u0430\u0437 \u043d\u0435 \u043c\u043e\u0433 \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u043c\u0443 \u0436\u044b\u0446\u0446\u044e. \u041d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u0435 \u0442\u0440\u044b\u0432\u0430\u043d\u043d\u0435 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0411\u043e\u0433 \u0437 \u0443\u0441\u0451\u0439 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u043e\u0434\u044b\u0447\u0447\u0443 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u0435 \u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0432\u0435\u0447\u043d\u044b\u043c \u0448\u0447\u0430\u0441\u0446\u0456.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041b\u043a 22, 29-30a; \u042f\u043d 15, 16a<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u042f \u043f\u0435\u0440\u0430\u0434\u0430\u044e \u0432\u0430\u043c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u044f\u043a \u041c\u043d\u0435 \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u044f\u0433\u043e \u0410\u0439\u0446\u0435\u0446 \u041c\u043e\u0439, <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u043a\u0430\u0431 \u0432\u044b \u0435\u043b\u0456 \u0456 \u043f\u0456\u043b\u0456 \u0437\u0430 \u041c\u0430\u0456\u043c \u0441\u0442\u0430\u043b\u043e\u043c \u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u041c\u0430\u0456\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u042f \u0432\u044b\u0431\u0440\u0430\u045e \u0432\u0430\u0441 \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e, \u043a\u0430\u0431 \u0432\u044b \u0456\u0448\u043b\u0456 \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u043f\u043b\u0451\u043d.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041a\u0430\u0431 \u0432\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"812","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0411\u044d\u0440\u043d\u0430\u0440\u0434\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 32pt; text-align: center;\"><span style=\"color: #ff0000;\">(Serm. 4, In Assumptionem Beatae Mariae Virginis)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0414\u0430 \u0426\u044f\u0431\u0435 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u043c\u0441\u044f, \u041f\u0430\u043d\u043d\u0430 \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u044f \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u044f<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0414\u0437\u0435\u0432\u0430! \u041d\u044f\u0445\u0430\u0439 \u0430\u0441\u043f\u0440\u044d\u0447\u044b\u0446\u044c \u0422\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0426\u044f\u0431\u0435 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0456 \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456, \u2013 \u043a\u0430\u043b\u0456 \u0442\u0430\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0446\u0430. \u0410\u043b\u0435 \u043c\u044b, \u0422\u0432\u0430\u0435 \u0441\u043b\u0443\u0433\u0456, \u0440\u0430\u0437\u0430\u043c \u0437 \u0422\u0430\u0431\u043e\u044e \u0440\u0430\u0434\u0443\u0435\u043c\u0441\u044f \u0434\u0430\u0440\u0430\u043c, \u044f\u043a\u0456\u043c\u0456 \u0430\u0434\u0430\u0440\u044b\u045e \u0426\u044f\u0431\u0435 \u041f\u0430\u043d. \u041d\u0430\u0441 \u0436\u0430 \u0441\u0430\u043c\u0456\u0445 \u0440\u0430\u0434\u0443\u0435 \u0422\u0432\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c. \u041c\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0422\u0432\u0430\u0451 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430, \u0437\u0430\u0445\u0430\u043f\u043b\u044f\u0435\u043c\u0441\u044f \u043f\u0430\u043a\u043e\u0440\u0430\u0439, \u0430\u043b\u0435 \u043d\u0430\u043c, \u043d\u0456\u043a\u0447\u044d\u043c\u043d\u044b\u043c, \u0441\u0430\u043b\u0430\u0434\u0437\u0435\u0439\u0448\u0430\u0439 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c; \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u0447\u0430\u0441\u0442\u0430 \u0437\u0433\u0430\u0434\u0432\u0430\u0435\u043c \u043f\u0440\u0430 \u044f\u0435, \u0447\u0430\u0441\u0446\u0435\u0439 \u043f\u0440\u043e\u0441\u0456\u043c \u0430\u0431 \u0451\u0439, \u044f\u043d\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u043d\u0430\u043c \u0434\u0430\u0440\u0430\u0433\u0430\u044f. \u042f\u043d\u0430 \u0441\u043f\u0440\u044b\u044f\u043b\u0430 \u0430\u0434\u043d\u043e\u0432\u0435 \u0441\u0432\u0435\u0442\u0443 \u0456 \u045e\u0441\u0456\u043c \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0437\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u0442\u0430\u044f, \u044f\u043a\u043e\u0439 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u041d\u0435 \u0431\u043e\u0439\u0441\u044f, \u041c\u0430\u0440\u044b\u044f, \u0431\u043e \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u0422\u044b \u043b\u0430\u0441\u043a\u0443 \u045e \u041f\u0430\u043d\u0430\u00bb (\u041b\u043a 1, 30), \u0442\u0443\u044e, \u044f\u043a\u043e\u0439 \u0442\u044b \u043f\u0440\u0430\u0433\u043d\u0443\u045e. \u0425\u0442\u043e \u0437\u043c\u043e\u0436\u0430 \u0430\u0445\u0430\u043f\u0456\u0446\u044c \u0448\u0447\u043e\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u0431\u0435\u0437\u043b\u0456\u0447, \u0456 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c, \u0456 \u0433\u043b\u044b\u0431\u0456\u043d\u044e \u0422\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456? \u0422\u044b \u043d\u044f\u0441\u0435\u0448 \u0448\u0447\u043e\u0434\u0440\u0443\u044e \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u045e\u0441\u0456\u043c, \u0445\u0442\u043e \u0426\u044f\u0431\u0435 \u043a\u043b\u0456\u0447\u0430, \u0456 \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435 \u0430\u0436 \u0434\u0430 \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430 \u0434\u043d\u044f. \u0417\u044f\u043c\u043b\u044f \u043f\u043e\u045e\u043d\u0430\u044f \u0422\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u0456 \u0441\u044f\u0433\u0430\u0435 \u044f\u043d\u0430 \u0430\u0436 \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456, \u043d\u044f\u0441\u0435 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u043c\u0443 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0443 \u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0437\u043c\u0440\u043e\u043a\u0443 \u0456 \u045e \u0446\u0435\u043d\u0456 \u0441\u043c\u0435\u0440\u0446\u0456. \u0411\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u0437\u0430\u0441\u044f\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435\u0431\u0430 \u0456 \u043f\u0443\u0441\u0446\u0435\u0435 \u0430\u0434\u0445\u043b\u0430\u043d\u044c, \u043f\u0430\u045e\u0441\u0442\u0430\u0435 \u0437 \u0440\u0443\u0456\u043d\u0430\u045e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043d\u0435\u0431\u0430, \u0430 \u0437\u0430\u0433\u0443\u0431\u043b\u0435\u043d\u044b\u043c \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u045e \u0441\u0432\u0430\u0456\u043c \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0456 \u0447\u0430\u043a\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0436\u044b\u0446\u0446\u0451. \u041f\u043e\u045e\u043d\u0430\u044f \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u043d\u043d\u044f \u0456 \u043b\u0456\u0442\u0430\u0441\u0446\u0456, \u0422\u044b \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0448 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u044e, \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u044f \u0456 \u0434\u0430 \u0430\u0434\u043d\u044b\u0445 \u0456 \u0434\u0430 \u0434\u0440\u0443\u0433\u0456\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u043d\u0430\u0448\u0430\u044f \u0441\u043f\u0440\u0430\u0433\u043d\u0435\u043d\u0430\u044f \u0434\u0443\u0448\u0430, \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u043d\u0435\u0432\u044b\u0447\u044d\u0440\u043f\u043d\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u043c\u044b \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u043c\u0441\u044f \u045e \u043d\u0430\u0448\u0430\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456. \u041f\u0430\u043a\u0430\u0436\u044b \u0441\u0432\u0435\u0442\u0443 \u043b\u0430\u0441\u043a\u0443 \u0437\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u043d\u044f, \u044f\u043a\u0443\u044e \u0422\u044b \u0437\u043d\u0430\u0439\u0448\u043b\u0430 \u045e \u0411\u043e\u0433\u0430: \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0435 \u0441\u0432\u044f\u0442\u044b\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0432\u044b\u043f\u0440\u0430\u0441\u0456 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435 \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u044b\u043c, \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0445\u0432\u043e\u0440\u044b\u043c, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u0435 \u0441\u043b\u0430\u0431\u044b\u043c, \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u0437\u043c\u0443\u0447\u0430\u043d\u044b\u043c, \u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0433\u0456\u043d\u0435, \u2013&nbsp; &nbsp; \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0456 \u0440\u0430\u0442\u0443\u043d\u0430\u043a. \u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u0437 \u0426\u044f\u0431\u0435, \u043b\u0430\u0441\u043a\u0430\u0432\u0430\u044f \u041a\u0430\u0440\u0430\u043b\u0435\u0432\u0430, \u0422\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0433\u0430\u043c, \u044f\u043a\u0456\u044f \u0437 \u043f\u0430\u0448\u0430\u043d\u0430\u044e \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u0435 \u0456\u043c\u044f \u041c\u0430\u0440\u044b\u0456, \u0443\u0434\u0437\u0435\u043b\u0456\u0446\u044c \u0434\u0430\u0440\u044b \u043b\u0430\u0441\u043a\u0456 \u0422\u0432\u043e\u0439 \u0421\u044b\u043d \u0456 \u041f\u0430\u043d \u043d\u0430\u0448, \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0456\u043c, \u0411\u043e\u0433 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043d\u0430\u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-indent: 32pt; text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041b\u043a 1, 48-50\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u043c\u044f\u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0443\u0441\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456, \u0431\u043e \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u045e\u0447\u044b\u043d\u0456\u045e \u043c\u043d\u0435 \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, <\/span><span style=\"color: #ff0000;\">*&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0430 \u0456\u043c\u044f \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u042f\u0433\u043e \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u045e \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u0434 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u042f\u0433\u043e \u0431\u0430\u0456\u0446\u0446\u0430. <\/span><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0410 \u0456\u043c\u044f.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"813","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0441\u0443\u0447\u0430\u0441\u043d\u044b\u043c \u0441\u0432\u0435\u0446\u0435<\/span><\/p>\r\n<p><span>\u00abG\u00e1udium et spes\u00bb \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 48)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0421\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u0441\u0443\u0436\u044d\u043d\u0441\u0442\u0432\u0430 \u0456 \u0441\u044f\u043c\u2019\u0456<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041c\u0443\u0436\u0447\u044b\u043d\u0430 \u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u0430, \u044f\u043a\u0456\u044f \u045e \u0441\u0443\u0436\u044d\u043d\u0441\u043a\u0456\u043c \u0441\u0430\u044e\u0437\u0435 \u00ab\u045e\u0436\u043e \u043d\u0435 \u0434\u0432\u043e\u0435, \u0430\u043b\u0435 \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430\u00bb (\u041c\u0446 19, 6), \u043f\u0440\u0430\u0437 \u0441\u0430\u043c\u0430\u0435 \u0446\u0435\u0441\u043d\u0430\u0435 \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u0430\u0441\u043e\u0431 \u0456 \u0441\u043f\u0440\u0430\u045e \u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u043c\u0443 \u045e\u0437\u0430\u0435\u043c\u043d\u0443\u044e \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0443 \u0456 \u043f\u0430\u0441\u043b\u0443\u0433\u0443, \u0437\u0432\u0435\u0434\u0432\u0430\u044e\u0446\u044c \u0441\u044d\u043d\u0441 \u0441\u0432\u0430\u0451\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u0437 \u043a\u043e\u0436\u043d\u044b\u043c \u0434\u043d\u0451\u043c \u043f\u0430\u045e\u043d\u0435\u0439 \u0434\u0430\u0441\u044f\u0433\u0430\u044e\u0446\u044c \u044f\u0435. \u0413\u044d\u0442\u044b \u0433\u043b\u044b\u0431\u043e\u043a\u0456 \u0441\u0430\u044e\u0437 \u0456 \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u044f \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u043c\u0443 \u0434\u0437\u0432\u044e\u0445 \u0430\u0441\u043e\u0431, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0430\u0431\u0440\u043e \u0434\u0437\u044f\u0446\u0435\u0439 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0446\u044c \u0446\u0430\u043b\u043a\u0430\u0432\u0456\u0442\u0430\u0439 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456 \u0430\u0434 \u0441\u0443\u0436\u044d\u043d\u0446\u0430\u045e \u0456 \u043d\u0435\u0440\u0430\u0437\u0440\u044b\u045e\u043d\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d \u0448\u0447\u043e\u0434\u0440\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u0433\u044d\u0442\u0443 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0430\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0437 \u0411\u043e\u0436\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0431\u044b\u043b\u0430 \u045e\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u0430 \u043d\u0430 \u045e\u0437\u043e\u0440 \u042f\u0433\u043e \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c. \u042f\u043a \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0411\u043e\u0433 \u0432\u044b\u0439\u0448\u0430\u045e \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0441\u0432\u0430\u0439\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u0437 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0430\u043c \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456, \u0442\u0430\u043a \u0456 \u0446\u044f\u043f\u0435\u0440 \u0417\u0431\u0430\u045e\u0446\u0430 \u0456 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a \u041a\u0430\u0441\u0446\u0451\u043b\u0430&nbsp;\u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456\u043c \u0441\u0443\u0436\u044d\u043d\u0446\u0430\u043c \u043f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0441\u0443\u0436\u044d\u043d\u0441\u0442\u0432\u0430 \u0456 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0437 \u0456\u043c\u0456 \u043d\u0430\u0434\u0430\u043b\u0435\u0439, \u043a\u0430\u0431, \u044f\u043a \u0401\u043d \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u041a\u0430\u0441\u0446\u0451\u043b \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u044f\u0433\u043e, \u0442\u0430\u043a \u0456 \u0441\u0443\u0436\u044d\u043d\u0446\u044b \u0432\u0430 \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u0456 \u0456 \u045e \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430\u0439 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456 \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u0433\u043e. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u0441\u0443\u0436\u044d\u043d\u0441\u043a\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0443\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0411\u043e\u0436\u0443\u044e \u043b\u044e\u0431\u043e\u045e, \u043a\u0456\u0440\u0443\u0435\u0446\u0446\u0430 \u0456 \u045e\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u0435\u0446\u0446\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u0447\u0430\u044e \u043c\u043e\u0446\u0430\u0439 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0437\u0431\u0430\u045e\u0447\u044b\u043c \u0434\u0437\u0435\u044f\u043d\u043d\u0435\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043a\u0430\u0431 \u043f\u0430\u0441\u043f\u044f\u0445\u043e\u0432\u0430 \u0432\u0435\u0441\u0446\u0456 \u0441\u0443\u0436\u044d\u043d\u0446\u0430\u045e \u0434\u0430 \u0411\u043e\u0433\u0430, \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u0456 \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u0446\u044c \u0456\u0445 \u0432\u0430 \u045e\u0437\u043d\u0451\u0441\u043b\u044b\u043c \u0437\u0430\u0434\u0430\u043d\u043d\u0456 \u0431\u0430\u0446\u044c\u043a\u0456 \u0456 \u043c\u0430\u0446\u0456. \u0422\u0430\u043c\u0443 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456\u044f \u0441\u0443\u0436\u044d\u043d\u0446\u044b \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u0446\u0430 \u0434\u043b\u044f \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u045e \u0456 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0442\u0430\u043d\u0443 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u043c \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043c. \u041d\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0447\u044b \u044f\u0433\u043e \u043c\u043e\u0446\u0430\u0439 \u0441\u0432\u043e\u0439 \u0441\u0443\u0436\u044d\u043d\u0441\u043a\u0456 \u0456 \u0441\u044f\u043c\u0435\u0439\u043d\u044b \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a, \u044f\u043d\u044b \u0441\u0430\u043c\u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u044e\u0446\u0446\u0430 \u0434\u0443\u0445\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u045e\u0441\u0451 \u0456\u0445 \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0440\u0430\u0439, \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u0456 \u043b\u044e\u0431\u043e\u045e\u044e; \u0443\u0441\u0451 \u0431\u043e\u043b\u044c\u0448 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u044e\u0446\u0446\u0430 \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u0456 \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0433\u0430 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f, \u0430 \u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u0434\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0433\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0411\u043e\u0433\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u0434\u0437\u0435\u0446\u0456, \u0430 \u043d\u0430\u0432\u0430\u0442 \u0443\u0441\u0435, \u0445\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0441\u044f\u043c\u0435\u0439\u043d\u044b\u043c \u043a\u043e\u043b\u0435, \u043b\u044f\u0433\u0447\u044d\u0439 \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u044c \u0448\u043b\u044f\u0445 \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456, \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c\u0456 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0441\u0430\u043c\u0456\u0445 \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u0456 \u0441\u044f\u043c\u0435\u0439\u043d\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430. \u0422\u0430\u043a \u0441\u0443\u0436\u044d\u043d\u0446\u044b, \u0430\u0437\u0434\u043e\u0431\u043b\u0435\u043d\u044b\u044f \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e \u0456 \u0437\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u0431\u0430\u0446\u044c\u043a\u043e\u045e\u0441\u0442\u0432\u0430 \u0456 \u043c\u0430\u0446\u044f\u0440\u044b\u043d\u0441\u0442\u0432\u0430, \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u043d\u044f, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0440\u044d\u043b\u0456\u0433\u0456\u0439\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u045e \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443 \u0456\u043c \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0414\u0437\u0435\u0446\u0456 \u044f\u043a \u0436\u044b\u0432\u044b\u044f \u0447\u043b\u0435\u043d\u044b \u0441\u044f\u043c\u2019\u0456 \u043f\u0430-\u0441\u0432\u043e\u0439\u043c\u0443 \u0441\u043f\u0440\u044b\u044f\u044e\u0446\u044c \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044e \u0431\u0430\u0446\u044c\u043a\u043e\u045e. \u041f\u0430\u0447\u0443\u0446\u0446\u0451\u043c \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u0456, \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0434\u0430\u0432\u0435\u0440\u0443 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u0437\u0430 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u0431\u0430\u0446\u044c\u043a\u043e\u045e \u0456 \u043f\u0430-\u0441\u044b\u043d\u043e\u045e\u0441\u043a\u0443 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0456\u0445 \u0443 \u043d\u0435\u0441\u043f\u0440\u044b\u044f\u043b\u044c\u043d\u044b \u0447\u0430\u0441 \u0456 \u045e \u0430\u0434\u0437\u0456\u043d\u043e\u0446\u0435 \u0441\u0442\u0430\u0440\u0430\u0441\u0446\u0456. \u0423\u0434\u0430\u045e\u0441\u0442\u0432\u043e, \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u0435 \u043c\u0443\u0436\u043d\u0430 \u044f\u043a \u043f\u0440\u0430\u0446\u044f\u0433 \u0441\u0443\u0436\u044d\u043d\u0441\u043a\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f, \u0431\u0443\u0434\u0437\u0435 \u0448\u0430\u043d\u0430\u0432\u0430\u0446\u0446\u0430 \u045e\u0441\u0456\u043c\u0456. \u0421\u044f\u043c\u2019\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430 \u0434\u0437\u044f\u043b\u0456\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0431\u0430\u0433\u0430\u0446\u0446\u0435\u043c \u0437 \u0456\u043d\u0448\u044b\u043c\u0456 \u0441\u0435\u043c\u2019\u044f\u043c\u0456. \u0422\u0430\u043c\u0443 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u044f \u0441\u044f\u043c\u2019\u044f, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e\u0437\u043d\u0456\u043a\u0430\u0435 \u0437 \u0441\u0443\u0436\u044d\u043d\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0456 \u045e\u0434\u0437\u0435\u043b\u0430\u043c \u0443 \u0437\u0430\u043f\u0430\u0432\u0435\u0446\u0435 \u043b\u044e\u0431\u043e\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u043a \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e \u0441\u0443\u0436\u044d\u043d\u0446\u0430\u045e, \u0430\u0445\u0432\u044f\u0440\u043d\u0443\u044e \u043f\u043b\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c, \u0442\u0430\u043a \u0456 \u043f\u0440\u0430\u0437 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u0446\u0442\u0432\u0430 \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u045e\u0441\u0456\u0445 \u0447\u043b\u0435\u043d\u0430\u045e \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u0443\u0441\u0456\u043c \u0436\u044b\u0432\u0443\u044e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0417\u0431\u0430\u045e\u0446\u044b \u045e \u0441\u0432\u0435\u0446\u0435 \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0443\u044e \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0440\u044b\u043f 31, 30b. 25\u0430. 31\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0416\u0430\u043d\u0447\u044b\u043d\u0430, \u044f\u043a\u0430\u044f \u0431\u0430\u0456\u0446\u0446\u0430 \u041f\u0430\u043d\u0430, \u0433\u043e\u0434\u043d\u0430\u044f&nbsp; \u043f\u0430\u0445\u0432\u0430\u043b\u044b. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u041c\u043e\u0446 \u0456 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u2013 \u044f\u0435 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u0410\u0434\u0434\u0430\u0432\u0430\u0439\u0446\u0435 \u0451\u0439 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u0446\u044b \u0440\u0443\u043a \u044f\u0435, \u043d\u044f\u0445\u0430\u0439 \u0445\u0432\u0430\u043b\u044f\u0446\u044c \u0443 \u0431\u0440\u0430\u043c\u0430\u0445 \u0447\u044b\u043d\u044b \u044f\u0435.<\/span><span style=\"color: #ff0000;\"> \u041d. <\/span><span>\u041c\u043e\u0446.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"814","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u0410\u0431\u2019\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456\u00bb \u0441\u0432. \u0413\u0435\u0440\u0442\u0440\u0443\u0434\u044b, \u043f\u0430\u043d\u043d\u044b<\/span><\/p>\r\n<p style=\"text-indent: 32pt; text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 2, 23, 1. 3. 5. 8. 10: SCh 139, 330-340)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0414\u0443\u043c\u0430\u044e\u0447\u044b \u043f\u0440\u0430 \u043c\u044f\u043d\u0435, \u0422\u044b \u043c\u0435\u045e \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u043c\u044f\u043d\u0435 \u0434\u0443\u043c\u043a\u0456 \u0441\u043f\u0430\u043a\u043e\u044e<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u043c\u043e\u0439 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c. \u041d\u044f\u0445\u0430\u0439 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u0426\u044f\u0431\u0435 \u043c\u0430\u044f \u0434\u0443\u0448\u0430 \u0456 \u0437 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0426\u044f\u0431\u0435 \u0422\u0432\u0430\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b, \u044f\u043a\u0456\u043c\u0456 \u0442\u0430\u043a \u043d\u0435\u0437\u0430\u0441\u043b\u0443\u0436\u0430\u043d\u0430 \u0430\u0431\u0441\u044b\u043f\u0430\u043b\u0430 \u043c\u044f\u043d\u0435 \u0422\u0432\u0430\u044f \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e. \u042f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u0437\u043c\u0430\u0433\u0443, \u0431\u0443\u0434\u0443 \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u0422\u0432\u0430\u0451\u0439 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456. \u0423\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u044e \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e \u0426\u044f\u0431\u0435 \u0437\u0430 \u0422\u0432\u0430\u044e \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0443\u044e \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0434\u0430 \u043c\u044f\u043d\u0435. \u041c\u0430\u0451 \u043c\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0430, \u0434\u0437\u044f\u0446\u0456\u043d\u0441\u0442\u0432\u0430 \u0456 \u043c\u0430\u043b\u0430\u0434\u043e\u0441\u0446\u044c \u0430\u043c\u0430\u043b\u044c \u0434\u0430 \u0434\u0432\u0430\u0446\u0446\u0430\u0446\u0456 \u043f\u044f\u0446\u0456 \u0433\u0430\u0434\u043e\u045e \u0436\u044b\u0446\u0446\u044f \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u045e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0439 \u0441\u043b\u0435\u043f\u0430\u0446\u0435. \u0422\u0430\u0434\u044b, \u0431\u0435\u0437 \u0434\u0430\u043a\u043e\u0440\u0430\u045e \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f, \u044f\u043a \u043c\u043d\u0435 \u0446\u044f\u043f\u0435\u0440 \u0437\u0434\u0430\u0435\u0446\u0446\u0430, \u0441\u043b\u043e\u0432\u0430\u043c \u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c \u044f \u0440\u0430\u0431\u0456\u043b\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u043c\u043d\u0435 \u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0456 \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043c\u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0435\u043d\u0430. \u042f \u043d\u0435 \u0437\u0432\u044f\u0440\u0442\u0430\u043b\u0430 \u045e\u0432\u0430\u0433\u0456 \u043d\u0430 \u0422\u0432\u0430\u0435 \u043f\u0435\u0440\u0430\u0441\u0446\u044f\u0440\u043e\u0433\u0456, \u044f\u043a\u0456\u044f \u0422\u044b \u0434\u0430\u0432\u0430\u045e \u043c\u043d\u0435 \u0446\u0456 \u0442\u043e \u043f\u0440\u0430\u0437 \u043f\u0440\u044b\u0440\u043e\u0434\u0436\u0430\u043d\u0443\u044e \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0434\u0430 \u0437\u043b\u0430 \u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u043d\u0435 \u0434\u0430\u0431\u0440\u0430, \u0446\u0456 \u0442\u043e \u043f\u0440\u0430\u0437 \u043d\u0430\u043f\u0430\u043c\u0456\u043d, \u0448\u0442\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u045e \u0437\u0432\u043e\u043d\u043a\u0443, \u0430\u0434 \u0431\u043b\u0456\u0436\u043d\u0456\u0445. \u042f \u043d\u0456\u0431\u044b \u0446\u0430\u043b\u043a\u0430\u043c \u0431\u044b\u043b\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u0446\u0430\u0439, \u044f\u043a\u0430\u044f \u0436\u044b\u043b\u0430 \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0430\u044f \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430, \u0448\u0442\u043e \u0422\u044b, \u043c\u043e\u0439 \u0411\u043e\u0436\u0430, \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0436\u0432\u0430\u0435\u0448 \u0437\u0430 \u0434\u0430\u0431\u0440\u043e, \u0430 \u043a\u0430\u0440\u0430\u0435\u0448 \u0437\u0430 \u0437\u043b\u043e. \u0410\u0434\u043d\u0430\u043a \u0437 \u0434\u0437\u044f\u0446\u0456\u043d\u0441\u0442\u0432\u0430, \u0437 \u043f\u044f\u0446\u0456 \u0433\u0430\u0434\u043e\u045e \u0436\u044b\u0446\u0446\u044f, \u0442\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u043c\u044f\u043d\u0435, \u043a\u0430\u0431 \u044f \u0436\u044b\u043b\u0430 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u0434\u0430\u043d\u044b\u0445 \u0422\u0430\u0431\u0435 \u0441\u044f\u0431\u0440\u043e\u045e \u043b\u044f \u0441\u0442\u0430\u043b\u0430 \u0441\u0432\u044f\u0442\u043e\u0439 \u0432\u0435\u0440\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u041e\u0439\u0447\u0430, \u043f\u0440\u044b\u043d\u043e\u0448\u0443 \u0422\u0430\u0431\u0435 \u0430\u0445\u0432\u044f\u0440\u0443 \u044f\u043a \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0437\u0430 \u045e\u0441\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0422\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u043f\u0430\u0447\u0430\u045e\u0448\u044b \u0437 \u0442\u043e\u0439 \u0433\u0430\u0434\u0437\u0456\u043d\u044b, \u043a\u0430\u043b\u0456 \u0401\u043d \u0437\u0430\u043f\u043b\u0430\u043a\u0430\u045e \u043f\u0435\u0440\u0448\u044b \u0440\u0430\u0437, \u043b\u0435\u0436\u0443\u0447\u044b \u043d\u0430 \u0441\u0435\u043d\u0435 \u045e \u044f\u0441\u043b\u044f\u0445, \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0447\u044b \u043d\u0435\u043f\u0430\u0437\u0431\u0435\u0436\u043d\u044b\u044f \u0442\u0443\u0440\u0431\u043e\u0442\u044b \u043c\u0430\u043b\u0435\u043d\u0441\u0442\u0432\u0430, \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0434\u0437\u0456\u0446\u044f\u0446\u0456, \u043f\u0435\u0440\u0430\u0436\u044b\u0432\u0430\u043d\u043d\u0456 \u045e \u043f\u0430\u0434\u043b\u0435\u0442\u043a\u0430\u0432\u044b\u043c \u0443\u0437\u0440\u043e\u0441\u0446\u0435, \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u044e\u043d\u0430\u0446\u0442\u0432\u0430 \u0430\u0436 \u0434\u0430 \u043c\u043e\u043c\u0430\u043d\u0442\u0443, \u043a\u0430\u043b\u0456 \u0441\u0445\u0456\u043b\u0456\u045e \u0433\u0430\u043b\u0430\u0432\u0443 \u0456, \u043a\u043b\u0456\u0447\u0443\u0447\u044b \u043c\u043e\u0446\u043d\u044b\u043c \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u0430\u0434\u0434\u0430\u045e \u0434\u0443\u0448\u0443 \u0411\u043e\u0433\u0443. \u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0434\u0437\u0435\u043b\u044f \u043f\u043b\u0430\u0442\u044b \u0437\u0430 \u045e\u0441\u0435 \u0441\u0432\u0430\u0435 \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u043d\u043d\u0456, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u041e\u0439\u0447\u0430, \u0430\u0445\u0432\u044f\u0440\u0443\u044e \u0422\u0430\u0431\u0435 \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0422\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u0441\u0430\u043c\u0430\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0434\u0443\u043c\u043a\u0430\u0445, \u0441\u043b\u043e\u0432\u0430\u0445 \u0456 \u0447\u044b\u043d\u0430\u0445, \u0437 \u0445\u0432\u0456\u043b\u0456\u043d\u044b, \u043a\u0430\u043b\u0456 \u0401\u043d \u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0442\u0440\u043e\u043d\u0430, \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0430\u0448\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u0430\u0436 \u0434\u0430 \u043c\u043e\u043c\u0430\u043d\u0442\u0443, \u043a\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0422\u0432\u0430\u0456\u043c \u0410\u0439\u0446\u043e\u045e\u0441\u043a\u0456\u043c \u0410\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0401\u043d \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0445\u0432\u0430\u043b\u0443 \u0442\u0440\u044b\u0443\u043c\u0444\u0443\u044e\u0447\u0430\u0433\u0430 \u0446\u0435\u043b\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0417 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u044e, \u0437 \u043d\u0430\u0439\u0432\u044f\u043b\u0456\u043a\u0448\u0430\u0439 \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u044e \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e \u0422\u0432\u0430\u044e \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0443\u044e \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0422\u0432\u0430\u0451\u0439 \u043d\u0435\u0432\u044b\u043c\u043e\u045e\u043d\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0451\u0439, \u0410\u0439\u0446\u0435\u0446 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u0422\u044b \u043c\u0435\u045e \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u043c\u044f\u043d\u0435, \u0445\u043e\u0446\u044c \u044f \u0442\u0430\u043a \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u0430 \u0436\u044b\u043b\u0430, \u0434\u0443\u043c\u043a\u0456 \u0441\u043f\u0430\u043a\u043e\u044e, \u0430 \u043d\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f, \u0443\u0437\u0432\u044b\u0448\u0430\u044e\u0447\u044b \u043c\u044f\u043d\u0435 \u043c\u043d\u043e\u0441\u0442\u0432\u0430\u043c \u0456 \u0432\u0435\u043b\u0456\u0447\u0447\u0443 \u0422\u0432\u0430\u0456\u0445 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0422\u044b \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u0446\u044c \u043c\u043d\u0435 \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0443\u044e \u0441\u0430\u0440\u0434\u044d\u0447\u043d\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u044f\u0431\u0440\u043e\u045e\u0441\u0442\u0432\u0430, \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u044e\u0447\u044b \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0440\u043e\u0437\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0441\u0430\u043c\u044b \u045e\u0437\u043d\u0451\u0441\u043b\u044b \u0441\u0430\u043d\u043a\u0442\u0443\u0430\u0440\u044b\u0439 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456 \u2013 \u0422\u0432\u0430\u0451 \u0411\u043e\u0436\u0430\u0435 \u0421\u044d\u0440\u0446\u0430, \u044f\u043a \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435 \u045e\u0441\u0451\u0439 \u043c\u0430\u0451\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0423\u0440\u044d\u0448\u0446\u0435, \u0422\u044b \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443\u045e \u043c\u0430\u044e \u0434\u0443\u0448\u0443 \u0441\u0432\u0430\u0456\u043c\u0456, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u043f\u0440\u0430\u045e\u0434\u0436\u0430\u043d\u044b\u043c\u0456, \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f\u043c\u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u045e, \u044f\u043a\u0456\u043c\u0456 \u0445\u043e\u0447\u0430\u0448 \u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043c\u044f\u043d\u0435 \u043f\u0430\u0434\u0447\u0430\u0441 \u0456 \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456. \u041d\u0430\u0432\u0430\u0442, \u043a\u0430\u043b\u0456 \u0431 \u044f \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u0434\u0430\u0440\u0443, \u0443\u0436\u043e \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u043f\u0440\u0430\u0433\u043d\u0443\u043b\u0430 \u0431 \u0426\u044f\u0431\u0435 \u0437 \u0436\u044b\u0432\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u044f\u0439.&nbsp;<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-indent: 32pt; text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440.<\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\">\u0415\u0440 31, 3b; \u043f\u0430\u0440. \u041e\u0441 2, 16b. 21\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041b\u044e\u0431\u043e\u045e\u044e \u0432\u0435\u0447\u043d\u0430\u0439 \u041f\u0430\u043d \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0413\u0435\u0440\u0442\u0440\u0443\u0434\u0443, \u0442\u0430\u043c\u0443 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u044f\u0435 \u0437 \u0434\u0437\u044f\u0446\u0456\u043d\u0441\u0442\u0432\u0430 \u0434\u0430 \u0441\u0430\u043c\u043e\u0442\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0406 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0434\u0430 \u044f\u0435 \u0441\u044d\u0440\u0446\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u0417\u0430\u0440\u0443\u0447\u044b\u045e\u0441\u044f \u0437 \u0451\u044e \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u0456. <\/span><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0406 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"815","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041b\u0456\u0441\u0442 \u041a\u043e\u043d\u0440\u0430\u0434\u0430 \u0437 \u041c\u0430\u0440\u0431\u0443\u0440\u0433\u0430, \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430 \u0441\u0432. \u0410\u043b\u044c\u0436\u0431\u0435\u0442\u044b<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ad pontificem anno 1232: A. Wyss, Hessisches Urkundenbuch I, Leipzig 1879, 31-35)&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0410\u043b\u044c\u0436\u0431\u0435\u0442\u0430 \u0440\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0430 \u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0432\u0430 \u045e\u0431\u043e\u0433\u0456\u0445<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0410\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u0410\u043b\u044c\u0436\u0431\u0435\u0442\u0430 \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0447\u0430\u043b\u0430 \u044f\u0441\u043d\u0435\u0446\u044c \u0446\u043d\u043e\u0442\u0430\u043c\u0456. \u0423\u0441\u0451 \u0436\u044b\u0446\u0446\u0451 \u0431\u044b\u043b\u0430 \u0441\u0443\u0446\u044f\u0448\u0430\u043b\u044c\u043d\u0456\u0446\u0430\u0439 \u0443\u0431\u043e\u0433\u0456\u0445; \u0446\u044f\u043f\u0435\u0440 \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u043b\u0430 \u0441\u044f\u0431\u0435 \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u043f\u0435\u0446\u044b \u043d\u0430\u0434 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0447\u044b\u043c\u0456. \u041d\u0435\u043f\u0430\u0434\u0430\u043b\u0451\u043a \u0430\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u0437\u0430\u043c\u043a\u0443 \u0437\u0430\u0433\u0430\u0434\u0430\u043b\u0430 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c \u0448\u043f\u0456\u0442\u0430\u043b\u044c, \u0443 \u044f\u043a\u0456\u043c \u0441\u0430\u0431\u0440\u0430\u043b\u0430 \u0448\u043c\u0430\u0442 \u0445\u0432\u043e\u0440\u044b\u0445 \u0456 \u0441\u043b\u0430\u0431\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u0428\u0447\u043e\u0434\u0440\u0430 \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u043b\u0430 \u0434\u0430\u0440\u044b \u043b\u044e\u0431\u043e\u0432\u0456 \u045e\u0441\u0456\u043c, \u0445\u0442\u043e \u043f\u0440\u0430\u0441\u0456\u045e \u044f\u0435 \u0430\u0431 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0446\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b, \u0430\u043b\u0435 \u045e \u043a\u043e\u0436\u043d\u044b\u043c \u0456\u043d\u0448\u044b\u043c, \u044f\u043a\u043e\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0432\u0430 \u045e\u043b\u0430\u0434\u0430\u043d\u043d\u0456 \u044f\u0435 \u043c\u0443\u0436\u0430. \u0423\u0441\u0435 \u043f\u0440\u044b\u0431\u044b\u0442\u043a\u0456, \u044f\u043a\u0456\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u0437 \u0447\u0430\u0442\u044b\u0440\u043e\u0445 \u043a\u043d\u044f\u0441\u0442\u0432\u0430\u045e \u044f\u0435 \u0441\u0443\u0436\u044d\u043d\u0446\u0430, \u0432\u044b\u0447\u0430\u0440\u043f\u0430\u043b\u0430 \u0434\u0430 \u0442\u0430\u043a\u043e\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456, \u0448\u0442\u043e \u045e\u0440\u044d\u0448\u0446\u0435 \u043d\u0430 \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u045e\u0431\u043e\u0433\u0456\u0445 \u0437\u0430\u0433\u0430\u0434\u0430\u043b\u0430 \u043f\u0440\u0430\u0434\u0430\u0446\u044c \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u043d\u043d\u0456 \u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u044f \u0448\u0430\u0442\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0414\u0432\u0430 \u0440\u0430\u0437\u044b \u045e \u0434\u0437\u0435\u043d\u044c, \u0440\u0430\u043d\u0456\u0446\u0430\u0439 \u0456 \u0432\u0435\u0447\u0430\u0440\u0430\u043c, \u043c\u0435\u043b\u0430 \u0437\u0432\u044b\u0447\u0430\u0439 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u0446\u044c \u0445\u0432\u043e\u0440\u044b\u0445. \u0410\u0441\u0430\u0431\u0456\u0441\u0442\u0430 \u0441\u043b\u0443\u0436\u044b\u043b\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0446\u044f\u0440\u043f\u0435\u045e \u043d\u0430 \u0441\u0442\u0440\u0430\u0448\u043d\u044b\u044f \u0445\u0432\u0430\u0440\u043e\u0431\u044b, \u0430\u0434\u043d\u044b\u043c \u043f\u0430\u0434\u0430\u0432\u0430\u043b\u0430 \u043f\u0430\u0441\u0456\u043b\u0430\u043a, \u0434\u0440\u0443\u0433\u0456\u043c \u043f\u0430\u043f\u0440\u0430\u045e\u043b\u044f\u043b\u0430 \u043b\u043e\u0436\u0430\u043a, \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u0445 \u043f\u0435\u0440\u0430\u043d\u043e\u0441\u0456\u043b\u0430 \u043d\u0430 \u043f\u043b\u044f\u0447\u0430\u0445 \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0430 \u0448\u043c\u0430\u0442 \u0456\u043d\u0448\u044b\u0445 \u0434\u0430\u0431\u0440\u0430\u0447\u044b\u043d\u043d\u044b\u0445 \u043f\u0430\u0441\u043b\u0443\u0433. \u0412\u0430 \u045e\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e \u044f\u0435 \u0441\u0432\u044f\u0442\u043e\u0439 \u043f\u0430\u043c\u044f\u0446\u0456 \u043c\u0443\u0436. \u0423\u0440\u044d\u0448\u0446\u0435, \u043f\u0430\u0441\u043b\u044f \u044f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u0456, \u0456\u043c\u043a\u043d\u0443\u0447\u044b\u0441\u044f \u0434\u0430 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456, \u0441\u0430 \u0441\u043b\u044f\u0437\u044c\u043c\u0456 \u043c\u043e\u0446\u043d\u0430 \u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u043c\u044f\u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u0451\u0439 \u0432\u0430\u043d\u0434\u0440\u0430\u0432\u0430\u0446\u044c \u0430\u0434 \u0434\u0437\u0432\u044f\u0440\u044d\u0439 \u0434\u0430 \u0434\u0437\u0432\u044f\u0440\u044d\u0439 \u0456 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u0423 \u0412\u044f\u043b\u0456\u043a\u0443\u044e \u043f\u044f\u0442\u043d\u0456\u0446\u0443, \u043a\u0430\u043b\u0456 \u0431\u044b\u043b\u0456 \u0430\u0433\u043e\u043b\u0435\u043d\u044b\u044f \u0430\u043b\u0442\u0430\u0440\u044b, \u043f\u0430\u043a\u043b\u0430\u045e\u0448\u044b \u0440\u0443\u043a\u0456 \u043d\u0430 \u0430\u043b\u0442\u0430\u0440, \u0443 \u043a\u0430\u043f\u043b\u0456\u0446\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u0433\u043e\u0440\u0430\u0434\u0430, \u043a\u0443\u0434\u044b \u0437\u0430\u043f\u0440\u0430\u0441\u0456\u043b\u0430 \u041c\u0435\u043d\u0448\u044b\u0445 \u0411\u0440\u0430\u0442\u043e\u045e, \u0443 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u045e \u0432\u044b\u0440\u0430\u043a\u043b\u0430\u0441\u044f \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456 \u0456 \u045e\u0441\u044f\u0433\u043e \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u0417\u0431\u0430\u045e\u0446\u0430. \u041f\u0430\u0441\u043b\u044f, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0448\u0442\u043e \u044f\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0440\u044b\u0432\u0430\u0431\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044b \u0441\u0432\u0435\u0442\u0443 \u0456 \u0437\u044f\u043c\u043d\u043e\u0435 \u0431\u0430\u0433\u0430\u0446\u0446\u0435, \u044f\u043a\u043e\u0435 \u043c\u0435\u043b\u0430, \u0431\u0443\u0434\u0443\u0447\u044b \u045e \u0445\u0432\u0430\u043b\u0435 \u043f\u0440\u044b \u0436\u044b\u0446\u0446\u0456 \u0441\u0443\u0436\u044d\u043d\u0446\u0430, \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u043c\u0430\u0451\u0439 \u0432\u043e\u043b\u0456 \u0430\u0434\u043f\u0440\u0430\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u041c\u0430\u0440\u0431\u0443\u0440\u0433. \u0422\u0443\u0442 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0430 \u0448\u043f\u0456\u0442\u0430\u043b\u044c \u0456 \u0441\u0430\u0431\u0440\u0430\u043b\u0430 \u0445\u0432\u043e\u0440\u044b\u0445 \u0456 \u043a\u0430\u043b\u0435\u043a; \u0437\u0430\u043f\u0440\u0430\u0448\u0430\u043b\u0430 \u0437\u0430 \u0441\u0432\u043e\u0439 \u0441\u0442\u043e\u043b \u0441\u0430\u043c\u044b\u0445 \u0431\u0435\u0434\u043d\u044b\u0445 \u0456 \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e, \u0448\u0442\u043e \u044f \u043d\u0435 \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u045e \u0443 \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0456 \u0436\u0430\u043d\u0447\u044b\u043d, \u044f\u043a \u044f\u043d\u0430, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043e\u0440\u0430\u043d\u044b\u0445 \u0434\u0430\u0440\u0430\u043c \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u044f, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u044f\u0435 \u0430\u043a\u0442\u044b\u045e\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u041d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437\u0430\u043a\u043e\u043d\u043d\u0456\u043a\u0456 \u0456 \u0437\u0430\u043a\u043e\u043d\u043d\u0456\u0446\u044b \u0447\u0430\u0441\u0442\u0430 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u043b\u0456, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u044f\u043d\u0430 \u0432\u044f\u0440\u0442\u0430\u043b\u0430\u0441\u044f \u0437 \u0441\u0430\u043c\u043e\u0442\u043d\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u044f\u0435 \u0442\u0432\u0430\u0440 \u0437\u0437\u044f\u045e \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0430 \u0432\u043e\u0447\u044b \u0431\u043b\u0456\u0448\u0447\u044d\u043b\u0456 \u043d\u0456\u0431\u044b \u043f\u0440\u043e\u043c\u043d\u0456 \u0441\u043e\u043d\u0446\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 17.85pt; text-align: justify;\"><span>\u041f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e \u044f \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u045e \u044f\u0435 \u0441\u043f\u043e\u0432\u0435\u0434\u0437\u044c. \u041a\u0430\u043b\u0456 \u044f \u0437\u0430\u043f\u044b\u0442\u0430\u045e, \u044f\u043a \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u043c\u0430\u0451\u043c\u0430\u0441\u0446\u044e \u0456 \u0445\u0430\u0442\u043d\u0456\u043c\u0456 \u043f\u0440\u044b\u043b\u0430\u0434\u0430\u043c\u0456, \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0430, \u0448\u0442\u043e \u045e\u0441\u0451, \u0448\u0442\u043e \u044f\u043d\u0430 \u044f\u0448\u0447\u044d \u043c\u0430\u0435, \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0443\u0431\u043e\u0433\u0456\u043c. \u041f\u0440\u0430\u0441\u0456\u043b\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u0431 \u044f \u0440\u0430\u0437\u0434\u0430\u045e \u0443\u0441\u0451, \u0437\u0430 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u0435\u043c \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u0442\u0443\u043d\u0456\u043a\u0456, \u044f\u043a\u0443\u044e \u043c\u0435\u043b\u0430 \u043d\u0430 \u0441\u0430\u0431\u0435 \u0456 \u045e \u044f\u043a\u043e\u0439 \u0445\u0430\u0446\u0435\u043b\u0430 \u0431\u044b\u0446\u044c \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u0430\u0439. \u041f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u044b\u0445 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f\u045e \u043f\u0440\u044b\u043d\u044f\u043b\u0430 \u0426\u0435\u043b\u0430 \u041f\u0430\u043d\u0430. \u0417\u0430\u0442\u044b\u043c, \u0430\u0436 \u0434\u0430 \u0432\u0435\u0447\u0430\u0440\u0430 \u0448\u043c\u0430\u0442 \u043a\u0430\u0437\u0430\u043b\u0430 \u043f\u0440\u0430 \u0441\u0430\u043c\u0430\u0435 \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u0435, \u0448\u0442\u043e \u043f\u0430\u0447\u0443\u043b\u0430 \u045e \u043a\u0430\u0437\u0430\u043d\u043d\u044f\u0445. \u0423\u0440\u044d\u0448\u0446\u0435, \u0434\u0430\u0440\u0443\u0447\u044b\u043b\u0430 \u0411\u043e\u0433\u0443 \u0437 \u043d\u0430\u0434\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430\u0439 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044e \u045e\u0441\u0456\u0445 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u044b\u0445, \u0456, \u043d\u0456\u0431\u044b \u0430\u043a\u0443\u043d\u0430\u044e\u0447\u044b\u0441\u044f \u045e \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b \u0441\u043e\u043d, \u0432\u044b\u043f\u0443\u0441\u0446\u0456\u043b\u0430 \u0434\u0443\u0445.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042e\u0434\u0442 15, 11 (Vlg); \u0414\u0437 10, 4\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0422\u044b \u045e\u0447\u044b\u043d\u0456\u043b\u0430 \u0440\u0430\u0448\u0443\u0447\u044b\u043c \u0456 \u043c\u043e\u0446\u043d\u044b\u043c \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u043f\u0430\u043b\u044e\u0431\u0456\u045e\u0448\u044b \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c, <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0442\u0430\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u0442\u0430\u0431\u0435 \u043d\u0430\u0432\u0435\u043a\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0422\u0432\u0430\u0435 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0456 \u0442\u0432\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0430 \u0431\u044b\u043b\u0456 \u0437\u0433\u0430\u0434\u0430\u043d\u044b\u044f \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c. <\/span><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0422\u0430\u043c\u0443.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"816","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u042d\u043d\u0446\u044b\u043a\u043b\u0456\u043a\u0430 &laquo;Mediator Dei&raquo; \u043f\u0430\u043f\u044b \u041f\u0456\u044f XII.<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(AAS 39 [1947], 552-553)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0441\u0432\u044f\u0442\u0430\u0440 i \u0430\u0445\u0432\u044f\u0440\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u0430\u043b\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c \u0434\u043b\u044f \u043d\u0430\u0441, a \u043d\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435, \u0431\u043e \u0430\u0434 \u0456\u043c\u044f \u045e\u0441\u044f\u0433\u043e \u0440\u043e\u0434\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0437\u0430\u043d\u043e\u0441\u0456\u0446\u044c \u0401\u043d \u0421\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u043c\u0443 \u0410\u0439\u0446\u0443 \u043f\u0440\u043e\u0441\u044c\u0431\u044b i \u0440\u044d\u043b\u0456\u0433\u0456\u0439\u043d\u0443\u044e \u043f\u0430\u0448\u0430\u043d\u0443; \u0401\u043d &ndash; \u0430\u0445\u0432\u044f\u0440\u0430, \u0430\u043b\u0435 \u0434\u043b\u044f \u043d\u0430\u0441, \u0431\u043e \u0437\u0430\u043c\u0435\u0441\u0442 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0430\u043d\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0430\u043c\u0456, \u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0441\u044f\u0431\u0435. \u0423\u0436\u043e \u0441\u043b\u043e\u0432\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u044b\u044f \u0434\u0443\u043c\u043a\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u0430\u043a\u0456\u043c\u0456, \u044f\u043a \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435&raquo; (\u0424\u043b\u043f 2, 5) \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0446\u044c \u0430\u0434 \u0443\u0441\u0456\u0445 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e, \u043a\u0430\u0431 \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0430\u0431\u0443\u0434\u0436\u0430\u043b\u0456 \u045e \u0441\u0430\u0431\u0435 &ndash; \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u044e\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u0456 &ndash; \u0442\u044b\u044f \u043f\u0430\u0447\u0443\u0446\u0446\u0456, \u044f\u043a\u0456\u043c\u0456 \u0431\u044b\u043b\u0430 \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430 \u0434\u0443\u0448\u0430 \u0411\u043e\u0441\u043a\u0430\u0433\u0430 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f, \u043a\u0430\u043b\u0456 \u0401\u043d \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u045e \u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435. \u0412\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u043c \u0432\u044b\u043f\u0430\u0434\u043a\u0443 \u043d\u044f\u0445\u0430\u0439 \u0430\u0431\u0443\u0434\u0436\u0430\u044e\u0446\u044c \u043f\u0430\u043a\u043e\u0440\u043b\u0456\u0432\u0443\u044e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0440\u043e\u0437\u0443\u043c\u0443 i \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0443\u044e \u0412\u0435\u043b\u0456\u0447 \u0411\u043e\u0436\u0443\u044e, \u0443\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u044f\u0435, \u0441\u043b\u0430\u0432\u044f\u0446\u044c \u0456 \u045e\u0437\u043d\u043e\u0441\u044f\u0446\u044c \u043f\u0430\u0434\u0437\u044f\u043a\u0443. \u0410\u043a\u0440\u0430\u043c\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u043b\u043e\u0432\u044b \u0433\u044d\u0442\u044b\u044f \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0446\u044c \u0430\u0434 \u0456\u0445, \u043a\u0430\u0431 \u043f\u0440\u044b\u043c\u0430\u043b\u0456 \u043d\u0435\u0439\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0430\u0441\u0442\u0430\u0432\u0443 \u0430\u0445\u0432\u044f\u0440\u043d\u0430\u0439 \u0436\u044d\u0440\u0442\u0432\u044b, \u043a\u0430\u0431 \u0432\u044b\u0440\u0430\u043a\u0430\u043b\u0456\u0441\u044f \u0441\u044f\u0431\u0435 \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u043a\u0430\u0431 \u0437 \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u0432\u043e\u043b\u0456 i \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0447\u044b\u043d\u0456\u043b\u0456 \u043f\u0430\u043a\u0443\u0442\u0443, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u043c\u0435\u045e \u0430\u0433\u0456\u0434\u0443 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e, i \u0437\u0430 \u0433\u044d\u0442\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u0456 \u044d\u043a\u0441\u043f\u0456\u044f\u0446\u044b\u044e. \u0423\u0440\u044d\u0448\u0446\u0435, \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u044e\u0446\u044c, \u043a\u0430\u0431 \u043c\u044b \u045e\u0441\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u0441\u043f\u043e\u0441\u0430\u0431 \u043c\u0456\u0441\u0442\u044b\u0447\u043d\u044b \u043f\u0430\u043c\u0456\u0440\u0430\u043b\u0456 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u043a\u0430\u0431 \u0437\u043c\u0430\u0433\u043b\u0456 \u043f\u0430\u045e\u0442\u0430\u0440\u044b\u0446\u044c \u0437\u0430 \u0441\u0432. \u041f\u0430\u045e\u043b\u0430\u043c: &laquo;\u0420\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u044f \u043f\u0440\u044b\u0431\u0456\u0442\u044b \u0434\u0430 \u043a\u0440\u044b\u0436\u0430&raquo; (\u0413\u0430\u043b 2, 19).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0413\u0430\u043b 2, 20<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0416\u044b\u0432\u0443 \u0432\u0435\u0440\u0430\u044e \u045e \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430,<span style=\"color: #ff0000;\"> *<\/span> \u044f\u043a\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043c\u044f\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0436\u043e \u043d\u0435 \u044f \u0436\u044b\u0432\u0443, \u0430 \u0436\u044b\u0432\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043c\u044f\u043d\u0435 \u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u044f\u0431\u0435 \u0437\u0430 \u043c\u044f\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"817","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 1 \u0430d Serapionem, 28-30: PG 26, 594-595. 599)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u0432\u044f\u0442\u043b\u043e, \u0445\u0432\u0430\u043b\u0430 \u0456 \u043b\u0430\u0441\u043a\u0430 \u045e \u0422\u0440\u043e\u0439\u0446\u044b \u0456 \u0430\u0434 \u0422\u0440\u043e\u0439\u0446\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0440\u044b\u0441\u043d\u0430 \u043f\u0430\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u0443\u044e \u0442\u0440\u0430\u0434\u044b\u0446\u044b\u044e, \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0456 \u0432\u0435\u0440\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u043a\u0443\u044e \u043f\u0435\u0440\u0430\u0434\u0430\u045e \u041f\u0430\u043d, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b, \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u0410\u0439\u0446\u044b. \u041d\u0430 \u0451\u0439 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u0430 \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0430\u0434\u0434\u0430\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0443\u0436\u043e \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0456 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u0446\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u043d\u0430\u044f \u045e \u0410\u0439\u0446\u0443, \u0421\u044b\u043d\u0443 \u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c \u0422\u0440\u043e\u0439\u0446\u0430 \u0441\u0432\u044f\u0442\u0430\u044f \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f. \u041d\u044f\u043c\u0430 \u045e \u0401\u0439 \u043d\u0456\u0447\u043e\u0433\u0430 \u0447\u0443\u0436\u043e\u0433\u0430 \u0456 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0432\u043e\u043d\u043a\u0443. \u041d\u0435 \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0441\u0430 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u0456 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u0430\u043b\u0435 \u045e\u0441\u044f &ndash; \u0441\u0442\u0432\u0430\u0440\u0430\u0435 \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043c\u043e\u0446\u0430\u044e. \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0451\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0442\u043e\u0435\u0441\u043d\u0430\u044f \u0456 \u043d\u0435\u043f\u0430\u0434\u0437\u0435\u043b\u044c\u043d\u0430\u044f, \u0430\u0434\u043d\u0430 \u045e \u043c\u043e\u0446\u044b \u0456 \u0430\u0434\u043d\u0430 \u045e \u0434\u0437\u0435\u044f\u043d\u043d\u0456. \u0411\u043e \u0410\u0439\u0446\u0435\u0446 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u045e\u0441\u0451 \u043f\u0440\u0430\u0437 \u0421\u043b\u043e\u0432\u0430 \u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c, \u0456 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u0430 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0422\u0440\u043e\u0439\u0446\u044b. \u0423 \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435\u0446\u0446\u0430 \u0430\u0434\u0437\u0456\u043d\u044b \u0411\u043e\u0433, &laquo;\u044f\u043a\u0456 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0456 \u043f\u0440\u0430\u0437 \u0443\u0441\u0456\u0445, \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445&raquo;. \u0401\u0441\u0446\u044c &laquo;\u043d\u0430\u0434 \u0443\u0441\u0456\u043c&raquo; \u044f\u043a \u0410\u0439\u0446\u0435\u0446, \u044f\u043a \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0456 \u043a\u0440\u044b\u043d\u0456\u0446\u0430; &laquo;\u043f\u0440\u0430\u0437 \u0443\u0441\u0456\u0445&raquo;, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043f\u0440\u0430\u0437 \u0421\u043b\u043e\u0432\u0430, \u0456 &laquo;\u0432\u0430 \u045e\u0441\u0456\u0445&raquo;, \u0443 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043f\u0456\u0448\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u043c \u043f\u0440\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0434\u0430\u0440\u044b, \u0443\u0441\u0435 \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0430 \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u044f\u043a \u0434\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u044b: &laquo;\u0420\u043e\u0437\u043d\u044b\u044f \u0451\u0441\u0446\u044c \u0434\u0430\u0440\u044b, \u0430\u043b\u0435 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0414\u0443\u0445. \u0420\u043e\u0437\u043d\u044b\u044f \u0451\u0441\u0446\u044c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456, \u0430\u043b\u0435 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u041f\u0430\u043d. \u0420\u043e\u0437\u043d\u044b\u044f \u0451\u0441\u0446\u044c \u0434\u0437\u0435\u044f\u043d\u043d\u0456, \u0430\u043b\u0435 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0443\u0441\u0451 \u0432\u0430 \u045e\u0441\u0456\u0445&raquo; (1 \u041a\u0430\u0440 12, 4-6).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u045e\u0434\u0437\u044f\u043b\u044f\u0435 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0410\u0439\u0446\u0430 \u043f\u0440\u0430\u0437 \u0421\u044b\u043d\u0430. \u0411\u043e \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0410\u0439\u0446\u0443, \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0421\u044b\u043d\u0443. \u0422\u0430\u043c\u0443 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0434\u0437\u0435\u043b\u0435\u043d\u044b\u044f \u0421\u044b\u043d\u0430\u043c \u0443 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0434\u0430\u0440\u0430\u043c\u0456 \u0410\u0439\u0446\u0430. \u041a\u0430\u043b\u0456 \u0436 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0451\u0441\u0446\u044c \u0443 \u043d\u0430\u0441, \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u043d\u0430\u043c \u0434\u0430\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430; \u0443 \u0421\u043b\u043e\u0432\u0435 \u0436 \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0410\u0439\u0446\u0435\u0446. \u0422\u0430\u043a \u0441\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435: &laquo;\u042f \u0456 \u0410\u0439\u0446\u0435\u0446 \u041c\u043e\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u044f\u0433\u043e \u0456 \u0437\u0440\u043e\u0431\u0456\u043c \u0436\u044b\u043b\u043b\u0451 \u045e \u044f\u0433\u043e&raquo; (\u043f\u0430\u0440. \u042f\u043d 14, 23). \u0422\u0430\u043c, \u0434\u0437\u0435 \u0451\u0441\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e, \u0442\u0430\u043c \u0456 \u044f\u0441\u043d\u0430\u0441\u0446\u044c, \u0430 \u0434\u0437\u0435 \u044f\u0441\u043d\u0430\u0441\u0446\u044c, \u0442\u0430\u043c \u044f\u0435 \u043f\u043b\u0451\u043d\u043d\u0430\u0441\u0446\u044c \u0456 \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0430\u044f \u043b\u0430\u0441\u043a\u0430. \u041a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0443 \u0414\u0440\u0443\u0433\u0456\u043c \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e \u0443 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u041b\u0430\u0441\u043a\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0433\u0430, \u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0437 \u0443\u0441\u0456\u043c\u0456 \u0432\u0430\u043c\u0456&raquo; (2 \u041a\u0430\u0440 13, 13). \u041b\u0430\u0441\u043a\u0443 \u0456 \u0434\u0430\u0440, \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u045e \u0422\u0440\u043e\u0439\u0446\u044b, \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0430\u0434 \u0410\u0439\u0446\u0430 \u043f\u0440\u0430\u0437 \u0421\u044b\u043d\u0430 \u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c. \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u043b\u0430\u0441\u043a\u0443 \u0434\u0430\u0435 \u043d\u0430\u043c \u0410\u0439\u0446\u0435\u0446 \u043f\u0440\u0430\u0437 \u0421\u044b\u043d\u0430, \u0442\u0430\u043a \u0456 \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043c\u0435\u0446\u044c \u0443\u0434\u0437\u0435\u043b\u0443 \u045e \u0434\u0430\u0440\u044b, \u044f\u043a \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c. \u041c\u0430\u044e\u0447\u044b \u045e \u0406\u043c \u0443\u0434\u0437\u0435\u043b, \u043c\u0430\u0435\u043c \u043b\u044e\u0431\u043e\u045e \u0410\u0439\u0446\u0430, \u043b\u0430\u0441\u043a\u0443 \u0421\u044b\u043d\u0430 \u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0443 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430, \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<span style=\"color: #ff0000;\"> *<\/span> \u0425\u0432\u0430\u043b\u0456\u043c \u0456 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u043c \u042f\u0433\u043e \u043d\u0430\u0432\u0435\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0422\u044b, \u0411\u043e\u0436\u0430, \u043d\u0430 \u0441\u043a\u043b\u044f\u043f\u0435\u043d\u043d\u0456 \u043d\u0435\u0431\u0430, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u0456 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0430\u043d\u044b \u043d\u0430\u0432\u0435\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0432\u0430\u043b\u0456\u043c \u0456 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u043c \u042f\u0433\u043e \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"818","GCH_CH_2_Text":"\r\n<p><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u0422\u0432\u043e\u0440 \u0441\u0432. \u0422\u0430\u043c\u0430\u0448\u0430 \u0410\u043a\u0432\u0456\u043d\u0441\u043a\u0430\u0433\u0430, \u0434\u043e\u043a\u0442\u0430\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Opusculum 57, in festo Corporis Christi, lect. 1-4)<\/span><br \/><span style=\"color: #ff0000;\">\u041e \u0434\u0437\u0456\u0432\u043e\u0441\u043d\u0430\u044f \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u0433\u0430\u0441\u0446\u0456\u043d\u0430!<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0411\u043e\u0436\u044b \u0421\u044b\u043d, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u0434\u0430\u0446\u044c \u043d\u0430\u043c \u0443\u0434\u0437\u0435\u043b \u0443 \u0441\u0432\u0430\u0456\u043c \u0431\u043e\u0441\u0442\u0432\u0435, \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430\u0448\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443, \u043a\u0430\u0431, \u0441\u0442\u0430\u045e\u0448\u044b\u0441\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0431\u0430\u0433\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0443\u0441\u0451, \u0448\u0442\u043e \u0401\u043d \u043f\u0440\u044b\u043d\u044f\u045e \u0430\u0434 \u043d\u0430\u0441, \u0446\u0430\u043b\u043a\u0430\u043c \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u0434\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0410\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443 \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430 \u043d\u0430\u0441. \u0421\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u043f\u0440\u0430\u043b\u0456\u045e \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u0456 \u0430\u0431\u043c\u044b\u0446\u0446\u044f, \u043a\u0430\u0431 \u043c\u044b, \u0432\u044b\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u044f \u0437 \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u0430\u0439 \u043d\u044f\u0432\u043e\u043b\u0456, \u0431\u044b\u043b\u0456 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u044b\u044f \u0430\u0434 \u0443\u0441\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043a\u0430\u0431 \u043f\u0430\u043c\u044f\u0446\u044c \u043f\u0440\u0430 \u0442\u0430\u043a\u043e\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430 \u0436\u044b\u043b\u0430 \u045e \u043d\u0430\u0441 \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u0401\u043d \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0441\u0432\u0430\u0456\u043c \u0432\u0435\u0440\u043d\u044b\u043c \u0443 \u043f\u043e\u0441\u0442\u0430\u0446\u0456 \u0445\u043b\u0435\u0431\u0430 \u0456 \u0432\u0456\u043d\u0430 \u0441\u0432\u0430\u0451 \u0426\u0435\u043b\u0430 \u044f\u043a \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0456 \u041a\u0440\u043e\u045e \u044f\u043a \u043d\u0430\u043f\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0434\u0437\u0456\u0432\u043e\u0441\u043d\u0430\u044f \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u0433\u0430\u0441\u0446\u0456\u043d\u0430, \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u0430\u044f \u0456 \u043f\u043e\u045e\u043d\u0430\u044f \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0441\u043b\u043e\u0434\u044b\u0447\u044b! \u0428\u0442\u043e \u0436 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c? \u0423\u0436\u043e \u043d\u0435 \u043c\u044f\u0441\u0430 \u043a\u0430\u0437\u043b\u043e\u045e \u0456 \u0446\u044f\u043b\u044c\u0446\u043e\u045e, \u044f\u043a \u0443 \u0421\u0442\u0430\u0440\u044b\u043c \u0417\u0430\u043f\u0430\u0432\u0435\u0446\u0435, \u0430\u043b\u0435 \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0411\u043e\u0433, \u0430\u0445\u0432\u044f\u0440\u0443\u0435\u0446\u0446\u0430 \u044f\u043a \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0456\u0432\u043e\u0434\u0437\u0456\u043d \u0456\u043d\u0448\u044b \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u044b\u043c; \u0451\u043d \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0433\u0440\u0430\u0445\u0456, \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u0435 \u0446\u043d\u043e\u0442\u044b, \u0448\u0447\u043e\u0434\u0440\u0430 \u043d\u0430\u0441\u044b\u0447\u0430\u0435 \u0434\u0443\u0448\u0443 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044f \u0446\u044d\u043b\u0435\u0431\u0440\u0443\u0435\u0446\u0446\u0430 \u044f\u043a \u0437\u0430 \u0436\u044b\u0432\u044b\u0445, \u0442\u0430\u043a \u0456 \u0437\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043a\u0430\u0431 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0446\u044c \u0443\u0441\u0456\u043c, \u0431\u043e \u0431\u044b\u043b\u0430 \u045e\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u0430 \u0434\u0437\u0435\u043b\u044f \u0434\u0430\u0431\u0440\u0430 \u045e\u0441\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0440\u044d\u0448\u0446\u0435, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u043b\u043e\u0434\u044b\u0447\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0443. \u041f\u0440\u0430\u0437 \u044f\u0433\u043e \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0446\u0430 \u0441\u043c\u0430\u043a \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u043a\u0430\u043b\u044f \u0441\u0430\u043c\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b; \u043f\u0440\u0430\u0437 \u044f\u0433\u043e \u045e\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u043c\u044f\u0446\u044c \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u0430\u0439 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u043f\u0430\u0434\u0447\u0430\u0441 \u041c\u0443\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u0432\u0435\u043b\u0456\u0447 \u0433\u044d\u0442\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u043d\u0430\u0439\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0435\u0439 \u0431\u044b\u043b\u0430 \u045e\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u0441\u044d\u0440\u0446\u044b \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e, \u043f\u0430\u0441\u043b\u044f \u0441\u043f\u0430\u0436\u044b\u0446\u0446\u044f \u0410\u043f\u043e\u0448\u043d\u044f\u0439 \u0412\u044f\u0447\u044d\u0440\u044b \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0432\u0443\u0447\u043d\u044f\u043c\u0456, \u043a\u0430\u043b\u0456 \u043d\u0430\u043c\u0435\u0440\u0432\u0430\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0439\u0441\u0446\u0456 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0434\u0430 \u0410\u0439\u0446\u0430, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0433\u044d\u0442\u044b \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u044f\u043a \u0432\u0435\u0447\u043d\u044b \u045e\u0441\u043f\u0430\u043c\u0456\u043d \u0441\u0432\u0430\u0451\u0439 \u041c\u0443\u043a\u0456, \u044f\u043a \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435 \u0434\u0430\u045e\u043d\u0456\u0445 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u044f\u045e, \u044f\u043a \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0443\u044e \u0441\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u0443, \u0456 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u044f\u043a \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0435 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u043c\u0443\u0442\u043a\u0443\u0435 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0430\u0434\u044b\u0445\u043e\u0434\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u0430\u0441\u043f\u0430\u0437\u043d\u0430\u0439\u0446\u0435 \u045e \u0433\u044d\u0442\u044b\u043c \u0445\u043b\u0435\u0431\u0435 \u0446\u0435\u043b\u0430, \u0448\u0442\u043e \u0432\u0456\u0441\u0435\u043b\u0430 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b, \u0430 \u045e \u0432\u0456\u043d\u0435 &ndash; \u043a\u0440\u043e\u045e, \u0448\u0442\u043e \u0432\u044b\u0446\u044f\u043a\u043b\u0430 \u0437 \u0431\u043e\u043a\u0443. \u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u0456 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0439\u0446\u0435 \u0426\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430; \u043f\u0440\u044b\u043c\u0456\u0446\u0435 \u0456 \u043f\u0456\u0446\u0435 \u041a\u0440\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u0432\u044b \u0441\u0430\u043c\u0456 \u045e\u0436\u043e \u0447\u043b\u0435\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u044f. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0437\u0435\u043b\u044f \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0439\u0446\u0435 \u0426\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u043b\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441; \u043a\u0430\u0431 \u043d\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430 \u045e \u0441\u0432\u0430\u0451\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456, \u043f\u0456\u0446\u0435 \u041a\u0440\u043e\u045e &ndash; \u0446\u0430\u043d\u0443 \u0432\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0432\u044b \u0441\u0430\u043c\u0456 \u045e\u0436\u043e \u0447\u043b\u0435\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"819","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>\u0422\u0432\u043e\u0440 \u0441\u0432. \u0411\u0430\u043d\u0430\u0432\u0435\u043d\u0442\u0443\u0440\u044b, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Opusculum 3, Lignum vitae, 29-30. 47)<\/span><br \/><span style=\"color: #ff0000;\">\u0423 \u0422\u0430\u0431\u0435 &ndash; \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0437\u0432\u0430\u0436, \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043a\u0456\u043c \u0451\u0441\u0446\u044c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0456 \u044f\u043a\u0456\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0434\u0437\u0435\u043b\u044f \u0446\u044f\u0431\u0435 \u0432\u0456\u0441\u0456\u0446\u044c \u043d\u0430 \u043a\u0440\u044b\u0436\u044b. \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u0432\u044f\u0440\u0442\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c; \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u042f\u0433\u043e \u0430\u0434\u044b\u0445\u043e\u0434\u0443 \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044f \u0430\u043a\u0443\u043d\u0430\u044e\u0446\u0446\u0430 \u045e \u0441\u043c\u0443\u0442\u0430\u043a, \u0430 \u0446\u0432\u0451\u0440\u0434\u044b\u044f \u0441\u043a\u0430\u043b\u044b \u043a\u0440\u044b\u0448\u0430\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u0437 \u0431\u043e\u043a\u0443 \u043f\u0440\u044b\u0431\u0456\u0442\u0430\u0433\u0430 \u0434\u0430 \u043a\u0440\u044b\u0436\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043c\u043e\u0433 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u041a\u0430\u0441\u0446\u0451\u043b, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430, \u043a\u0430\u0431 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0411\u0443\u0434\u0443\u0446\u044c \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043f\u0440\u0430\u0431\u0456\u043b\u0456&raquo; (\u042f\u043d 19, 37), \u041f\u0430\u043d \u0411\u043e\u0433 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u045e \u0430\u0434\u043d\u0430\u043c\u0443 \u0437 \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u045e \u0443\u0434\u0430\u0440\u0430\u043c \u0434\u0437\u0456\u0434\u044b \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u044b \u0431\u043e\u043a. \u0417 \u044f\u0433\u043e \u0432\u044b\u043f\u043b\u044b\u043b\u0430 \u043a\u0440\u043e\u045e \u0456 \u0432\u0430\u0434\u0430, \u0448\u0442\u043e \u0441\u0442\u0430\u043b\u0456 \u043f\u043b\u0430\u0442\u0430\u0439 \u0437\u0430 \u043d\u0430\u0448\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0412\u044b\u0446\u044f\u043a\u0430\u044e\u0447\u044b \u0437 \u0441\u0430\u043c\u043e\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, \u0437 \u0441\u044d\u0440\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043d\u0430 \u0434\u0430\u043b\u0430 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043c\u043e\u0446 \u0443\u0434\u0437\u044f\u043b\u0435\u043d\u043d\u044f \u0436\u044b\u0446\u0446\u044f \u043b\u0430\u0441\u043a\u0456, \u0430 \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u045e\u0436\u043e \u0436\u044b\u0432\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0441\u0442\u0430\u043b\u0430 \u043d\u0430\u043f\u043e\u0435\u043c \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u044b, &laquo;\u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435&raquo; (\u042f\u043d 4, 14).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u045e\u0441\u0442\u0430\u043d\u044c, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0434\u0443\u0448\u0430! \u0411\u0443\u0434\u0437\u044c, \u044f\u043a \u0442\u0430\u044f \u0433\u0430\u043b\u0443\u0431\u043a\u0430, \u044f\u043a\u0430\u044f &laquo;\u0440\u043e\u0431\u0456\u0446\u044c \u0433\u043d\u044f\u0437\u0434\u043e \u045e \u0440\u0430\u0441\u043a\u043e\u043b\u0456\u043d\u0430\u0445 \u0430\u0431\u0440\u044b\u0432\u0430&raquo; (\u043f\u0430\u0440. \u0415\u0440 48, 28). \u0422\u0440\u044b\u0432\u0430\u0439 \u0442\u0430\u043c \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u044f\u043a &laquo;\u0432\u0435\u0440\u0430\u0431\u0435\u0439, \u0448\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0430\u0431\u0435 \u0434\u043e\u043c&raquo; (\u043f\u0430\u0440. \u041f\u0441 84 [83], 4); \u0442\u0430\u043c, \u044f\u043a \u0442\u0443\u0440\u043a\u0430\u045e\u043a\u0430, \u0441\u0445\u0430\u0432\u0430\u0439 \u0441\u0432\u0430\u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439 \u0447\u044b\u0441\u0442\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456; \u0442\u0430\u043c \u043f\u0440\u044b\u0442\u0443\u043b\u0456\u0441\u044f \u0432\u0443\u0441\u043d\u0430\u043c\u0456, \u043a\u0430\u0431 &laquo;\u0447\u044d\u0440\u043f\u0430\u0446\u044c \u0432\u0430\u0434\u0443 \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f&raquo; (\u0406\u0441 12, 3). \u0411\u043e \u0442\u0443\u0442 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430, \u0448\u0442\u043e &laquo;\u0432\u044b\u0446\u044f\u043a\u0430\u0435 \u0437 \u0441\u044f\u0440\u044d\u0434\u0437\u0456\u043d\u044b \u0440\u0430\u044e \u0456 \u0434\u0437\u0435\u043b\u0456\u0446\u0446\u0430 \u043d\u0430 \u0447\u0430\u0442\u044b\u0440\u044b \u043f\u0430\u0442\u043e\u043a\u0456&raquo; (\u043f\u0430\u0440. \u0411\u044b\u0446 2, 10), \u044f\u043a\u0430\u044f \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u044b \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e, \u043d\u0430\u0432\u0430\u0434\u043d\u044f\u0435 \u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0443\u0440\u0430\u0434\u043b\u0456\u0432\u0430\u0439 \u0443\u0441\u044e \u0437\u044f\u043c\u043b\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u044f\u0436\u044b \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0436\u044b\u0446\u0446\u044f \u0456 \u0441\u0432\u044f\u0442\u043b\u0430, \u043a\u0456\u043c \u0431\u044b \u0442\u044b \u043d\u0456 \u0431\u044b\u043b\u0430, \u0434\u0443\u0448\u0430, \u0430\u0434\u0434\u0430\u043d\u0430\u044f \u0411\u043e\u0433\u0443; \u0437 \u0433\u0430\u0440\u0430\u0447\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c \u0456 \u045e\u0441\u0451\u0439 \u043c\u043e\u0446\u0430\u044e \u043a\u043b\u0456\u0447 \u0437 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0441\u044d\u0440\u0446\u0430: &laquo;\u041e \u043d\u0435\u0432\u044b\u043c\u043e\u045e\u043d\u0430\u044f \u0432\u0435\u043b\u0456\u0447 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u043d\u0430\u0439\u0447\u044b\u0441\u0446\u0435\u0439\u0448\u0430\u044f \u044f\u0441\u043d\u0430\u0441\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430, \u0436\u044b\u0446\u0446\u0451, \u0448\u0442\u043e \u0430\u0436\u044b\u045e\u043b\u044f\u0435 \u043a\u043e\u0436\u043d\u0430\u0435 \u0436\u044b\u0432\u043e\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435, \u0441\u0432\u044f\u0442\u043b\u043e, \u0448\u0442\u043e \u0437\u0430\u043f\u0430\u043b\u044c\u0432\u0430\u0435 \u043a\u043e\u0436\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0431\u043b\u044f\u0441\u043a \u0440\u043e\u0437\u043d\u044b\u0445 \u0441\u0432\u0435\u0442\u0430\u0447\u0430\u045e, \u044f\u043a\u0456\u044f \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0434\u043d\u044f \u043f\u0440\u0430\u043c\u0435\u043d\u044f\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u043f\u0435\u0440\u0430\u0434 \u0442\u0440\u043e\u043d\u0430\u043c \u0422\u0432\u0430\u0451\u0439 \u0411\u043e\u0441\u043a\u0430\u0441\u0446\u0456!<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0432\u0435\u0447\u043d\u044b \u0456 \u043d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u044b, \u044f\u0441\u043d\u044b \u0456 \u0441\u0430\u043b\u043e\u0434\u043a\u0456 \u0441\u0442\u0440\u0443\u043c\u0435\u043d\u044c \u0441\u0445\u0430\u0432\u0430\u043d\u0430\u0439 \u0430\u0434 \u043b\u044e\u0434\u0441\u043a\u0456\u0445 \u0432\u0430\u0447\u044d\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b; \u044f\u0433\u043e \u0433\u043b\u044b\u0431\u0456\u043d\u044f \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u044f, \u0432\u044b\u0448\u044b\u043d\u044f \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u044f, \u0448\u044b\u0440\u044b\u043d\u044f \u0431\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u044f, \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0426\u044f\u0431\u0435 \u0432\u044b\u043f\u043b\u044b\u0432\u0430\u044e\u0446\u044c \u043f\u0430\u0442\u043e\u043a\u0456, \u044f\u043a\u0456\u044f &ldquo;\u0432\u0435\u0441\u044f\u043b\u044f\u0446\u044c \u0433\u043e\u0440\u0430\u0434 \u0411\u043e\u0436\u044b&rdquo; (\u041f\u0441 46 [45], 5), \u043a\u0430\u0431 &ldquo;\u0441\u044f\u0440\u043e\u0434 \u0432\u043e\u043a\u043b\u0456\u0447\u0430\u045e \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u0437 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u044e&rdquo; (\u041f\u0441 42 [41], 5) \u043c\u044b \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u043f\u0435\u0441\u043d\u044e \u0445\u0432\u0430\u043b\u044b, \u0434\u0430\u044e\u0447\u044b \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435, \u0448\u0442\u043e &ldquo;\u045e \u0422\u0430\u0431\u0435 &ndash; \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0436\u044b\u0446\u0446\u044f, \u0456 \u045e \u0422\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u0435 \u043c\u044b \u0431\u0430\u0447\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e&rdquo; (\u041f\u0441 36 [35], 10)&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 103 (102), 2. 4; 34 (33), 9\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456, \u0434\u0443\u0448\u0430 \u043c\u0430\u044f, \u041f\u0430\u043d\u0430, \u0456 \u043d\u0435 \u0437\u0430\u0431\u044b\u0432\u0430\u0439 \u043f\u0440\u0430 \u045e\u0441\u0435 \u042f\u0433\u043e \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u0436\u044b\u0446\u0446\u0451 \u0442\u0432\u0430\u0451 \u0440\u0430\u0442\u0443\u0435 \u0430\u0434 \u0437\u0430\u0433\u0443\u0431\u044b, \u043b\u0456\u0442\u0430\u0441\u0446\u044e \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e \u0446\u044f\u0431\u0435 \u043a\u0430\u0440\u0430\u043d\u0443\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043a\u0430\u0448\u0442\u0443\u0439\u0446\u0435 \u0456 \u045e\u0431\u0430\u0447\u0446\u0435, \u044f\u043a\u0456 \u0434\u043e\u0431\u0440\u044b \u0451\u0441\u0446\u044c \u041f\u0430\u043d.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u0436\u044b\u0446\u0446\u0451 \u0442\u0432\u0430\u0451 \u0440\u0430\u0442\u0443\u0435 \u0430\u0434 \u0437\u0430\u0433\u0443\u0431\u044b, \u043b\u0456\u0442\u0430\u0441\u0446\u044e \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e \u0446\u044f\u0431\u0435 \u043a\u0430\u0440\u0430\u043d\u0443\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"820","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 82, in natali apostolorum Petri et Pauli 1, 6-7: PL 54, 426-428)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0451\u0442\u0440 \u0456 \u041f\u0430\u0432\u0435\u043b, \u043f\u0440\u0430\u0440\u043e\u0441\u0448\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0437\u0435\u0440\u043d\u0435<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u00ab\u041a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u0445\u00bb (\u041f\u0441 114 [115]), 15). \u041d\u0456\u044f\u043a\u0430\u044f \u0436\u043e\u0440\u0441\u0442\u043a\u0430\u0441\u0446\u044c \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0440\u044d\u043b\u0456\u0433\u0456\u0456, \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u0439 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u043a\u0440\u044b\u0436\u0430. \u0423 \u0432\u044b\u043d\u0456\u043a\u0443 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443 \u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0435 \u0437\u043c\u044f\u043d\u0448\u0430\u0435\u0446\u0446\u0430, \u0430\u043b\u0435 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u0446\u0446\u0430, \u0430 \u043a\u0430\u043b\u0456 \u0437\u0435\u0440\u043d\u0435 \u0437\u0440\u044d\u0434\u043a\u0443 \u043f\u0430\u0434\u0430\u0435, \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043f\u043b\u0451\u043d\u043d\u0430, \u0456 \u0448\u0442\u043e\u0440\u0430\u0437 \u0431\u043e\u043b\u044c\u0448\u044b \u043f\u043b\u0451\u043d \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0435 \u043d\u0430 \u0440\u0430\u043b\u043b\u0456 \u041f\u0430\u043d\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0448\u0447\u043e\u0434\u0440\u0430 \u045e\u0437\u0440\u0430\u0441\u043b\u0456 \u0437 \u0411\u043e\u0436\u0430\u0439 \u0441\u044f\u045e\u0431\u044b \u0433\u044d\u0442\u044b\u044f \u0434\u0437\u0432\u0435 \u0433\u0430\u043b\u0456\u043d\u044b, \u0441\u0432\u0435\u0434\u0447\u0430\u0446\u044c \u0442\u044b\u0441\u044f\u0447\u044b \u0441\u0432\u044f\u0442\u044b\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e. \u042f\u043d\u044b, \u0443 \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0446\u0442\u0432\u0435 \u0437 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456 \u045e \u0445\u0432\u0430\u043b\u0435, \u0441\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u0443 \u043d\u0430\u0448\u044b\u043c \u0433\u043e\u0440\u0430\u0434\u0437\u0435 \u044f\u0441\u043d\u0435\u044e\u0447\u044b \u0437\u0434\u0430\u043b\u0451\u043a \u043d\u0430\u0442\u043e\u045e\u043f \u0443 \u043f\u0443\u0440\u043f\u0443\u0440\u043d\u044b\u0445 \u0448\u0430\u0442\u0430\u0445 \u0456 \u0430\u0437\u0434\u0430\u0431\u043b\u044f\u044e\u0446\u044c \u044f\u0433\u043e \u043d\u0456\u0431\u044b \u0430\u0434\u043d\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0434\u044b\u044f\u0434\u044d\u043c\u0430\u0439 \u0441\u0430 \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u0445 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b\u0445 \u043f\u044f\u0440\u043b\u0456\u043d\u0430\u045e.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0442\u0430\u043a\u043e\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430\u0439 \u043d\u0430\u043c \u0411\u043e\u0433\u0430\u043c \u0443 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0437\u0435 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0432\u0430 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u0456 \u045e \u0432\u0435\u0440\u044b \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430, \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u044e\u0447\u044b \u0441\u0432\u044f\u0442\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445. \u0410\u0434\u043d\u0430\u043a \u043d\u0435 \u043c\u0435\u043d\u0448 \u0442\u0440\u044d\u0431\u0430 \u0433\u0430\u043d\u0430\u0440\u044b\u0446\u0446\u0430 \u0432\u0435\u043b\u0456\u0447\u0447\u0443 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0411\u043e\u0436\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0441\u044f\u0440\u043e\u0434 \u0456\u043d\u0448\u044b\u0445 \u0447\u043b\u0435\u043d\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u045e\u0437\u043d\u0435\u0441\u043b\u0430 \u0442\u0430\u043a \u0432\u044b\u0441\u043e\u043a\u0430, \u0448\u0442\u043e \u045e \u0446\u0435\u043b\u0435, \u0413\u0430\u043b\u0430\u0432\u043e\u0439 \u044f\u043a\u043e\u0433\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043d\u044b \u0441\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u043d\u0456\u0431\u044b \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u0432\u0443\u0445 \u0432\u0430\u0447\u044d\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u041a\u0430\u043b\u0456 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u043f\u0440\u0430 \u0456\u0445 \u0437\u0430\u0441\u043b\u0443\u0433\u0456 \u0456 \u0446\u043d\u043e\u0442\u044b, \u044f\u043a\u0456\u044f \u0446\u044f\u0436\u043a\u0430 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c, \u043c\u044b \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u044f\u0446\u044c \u0456\u0445 \u0446\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0446\u044c. \u0411\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0430 \u0456\u0445 \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u044b\u043c\u0456, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u043c\u0430\u044f \u043f\u0440\u0430\u0446\u0430 \u2013 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456, \u043a\u0430\u043d\u0435\u0446 \u0436\u044b\u0446\u0446\u044f \u2013 \u0440\u043e\u045e\u043d\u044b\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt;\"><span>\u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u0434\u043e\u0441\u0432\u0435\u0434\u0443 \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u043e\u0434\u043a\u0430\u045e, \u043c\u044b \u0432\u0435\u0440\u044b\u043c \u0456 \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u0441\u044f\u0440\u043e\u0434 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044f\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u043d\u0430\u0441 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u043d\u0430\u0448\u044b\u0445 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u0445 \u0430\u043f\u0435\u043a\u0443\u043d\u043e\u045e \u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u0456 \u0411\u043e\u0436\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456, \u043a\u0430\u0431 \u0442\u0430\u043a, \u044f\u043a \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u044e\u0446\u044c \u043d\u0430\u0441 \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u0430\u0432\u0456\u043d\u044b, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u043a\u0430\u0431 \u043d\u0435\u0441\u043b\u0456 \u043d\u0430\u0441 \u0437\u0430\u0441\u043b\u0443\u0433\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<h3 style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><\/h3>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u0421\u0432\u044f\u0442\u044b\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0430\u0434\u0434\u0430\u043d\u0430 \u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0443 \u0456 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0430\u0440\u0430\u0441\u0456\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b. <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u041f\u0456\u043b\u0456 \u0437 \u043a\u0435\u043b\u0456\u0445\u0430 \u041f\u0430\u043d\u0430 \u0456 \u0441\u0442\u0430\u043b\u0456 \u0441\u044f\u0431\u0440\u0430\u043c\u0456 \u0411\u043e\u0433\u0430.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span><span> \u0417\u2019\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u043f\u0440\u044b \u0436\u044b\u0446\u0446\u0456, \u0440\u0430\u0437\u0430\u043c \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0456 \u0445\u0432\u0430\u043b\u044b \u043c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430. <\/span><span style=\"color: #ff0000;\">\u041d.<\/span><span> \u041f\u0456\u043b\u0456.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"821","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0414\u0430\u0433\u043c\u0430\u0442\u044b\u0447\u043d\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00abLumen Gentium\u00bb \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 43 \u0456 44)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0415\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u044f \u043f\u0430\u0440\u0430\u0434\u044b \u2013 \u0433\u044d\u0442\u0430 \u0411\u043e\u0436\u044b \u0434\u0430\u0440<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0415\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u044f \u043f\u0430\u0440\u0430\u0434\u044b \u043f\u0440\u044b\u0441\u0432\u0435\u0447\u0430\u043d\u0430\u0439 \u0411\u043e\u0433\u0443 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456, \u0443\u0431\u043e\u0441\u0442\u0432\u0430 \u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u044b\u044f \u043d\u0430 \u0441\u043b\u043e\u0432\u0430\u0445 \u0456 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0437\u0435 \u041f\u0430\u043d\u0430 \u0456 \u0440\u044d\u043a\u0430\u043c\u0435\u043d\u0434\u0430\u0432\u0430\u043d\u044b\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u0410\u0439\u0446\u0430\u043c\u0456, \u0434\u043e\u043a\u0442\u0430\u0440\u0430\u043c\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0456 \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c\u0456, \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0411\u043e\u0436\u044b\u043c \u0434\u0430\u0440\u0430\u043c, \u044f\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0434 \u0441\u0432\u0430\u0439\u0433\u043e \u041f\u0430\u043d\u0430 \u0456 \u0437 \u042f\u0433\u043e \u043b\u0430\u0441\u043a\u0456 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435. \u0421\u0430\u043c\u0430 \u045e\u043b\u0430\u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043f\u0430\u0434 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043f\u0430\u043a\u043b\u0430\u043f\u0430\u0446\u0456\u043b\u0430\u0441\u044f \u043f\u0440\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0456\u0445 \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c, \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u0456\u0445 \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0456, \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0443\u0441\u0442\u0430\u043b\u0451\u045e\u0432\u0430\u0446\u044c \u0441\u0442\u0430\u043b\u044b\u044f, \u0442\u0440\u044b\u0432\u0430\u043b\u044b\u044f \u0444\u043e\u0440\u043c\u044b \u0436\u044b\u0446\u0446\u044f, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u044b\u044f \u043d\u0430 \u0433\u044d\u0442\u044b\u0445 \u043f\u0430\u0440\u0430\u0434\u0430\u0445. \u0422\u0430\u043c\u0443 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u044b\u0440\u0430\u0441\u043b\u0456, \u044f\u043a \u043d\u0430 \u0434\u0440\u044d\u0432\u0435, \u044f\u043a\u043e\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u0430 \u0456 \u0431\u0443\u0439\u043d\u0430 \u0440\u0430\u0441\u043a\u0432\u0456\u0442\u043d\u0435\u043b\u0430 \u043d\u0430 \u043d\u0456\u0432\u0435 \u041f\u0430\u043d\u0430 \u0437 \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430\u043c \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0430, \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u044f \u0444\u043e\u0440\u043c\u044b \u0441\u0430\u043c\u043e\u0442\u043d\u0430\u0433\u0430 \u0446\u0456 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0440\u043e\u0437\u043d\u044b\u044f \u043c\u0430\u043d\u0430\u0441\u043a\u0456\u044f \u0441\u0435\u043c\u2019\u0456, \u044f\u043a\u0456\u044f \u043f\u0430\u043c\u043d\u0430\u0436\u0430\u044e\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u044f\u043a \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u0456\u0445 \u0447\u043b\u0435\u043d\u0430\u045e, \u0442\u0430\u043a \u0456 \u0434\u0430\u0431\u0440\u0443 \u045e\u0441\u044f\u0433\u043e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0446\u0435\u043b\u0430. \u0413\u044d\u0442\u044b\u044f \u0441\u0435\u043c\u2019\u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0456\u043c \u0447\u043b\u0435\u043d\u0430\u043c, \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0456\u0445 \u0443 \u0430\u0431\u0440\u0430\u043d\u044b\u043c \u043b\u0430\u0434\u0437\u0435 \u0436\u044b\u0446\u0446\u044f, \u0443 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u044b\u043c \u0432\u0443\u0447\u044d\u043d\u043d\u0456, \u044f\u043a\u043e\u0435 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456, \u0443 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u043a\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0434\u0437\u0435\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0456 \u045e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0439 \u0441\u0432\u0430\u0431\u043e\u0434\u0437\u0435, \u0442\u0430\u043a \u0448\u0442\u043e \u044f\u043d\u044b \u043c\u043e\u0433\u0443\u0446\u044c \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0435 \u043c\u0430\u043d\u0430\u0441\u043a\u0456\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456 \u0456 \u0432\u0435\u0440\u043d\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0456\u0445, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043a\u0440\u043e\u0447\u044b\u0446\u044c \u0448\u043b\u044f\u0445\u0430\u043c \u043b\u044e\u0431\u043e\u0432\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0437 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456 \u0446\u0456 \u0456\u043d\u0448\u044b\u044f \u0441\u0432\u044f\u0442\u044b\u044f \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u0446\u0435\u043b\u044c\u0441\u0442\u0432\u044b, \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0434\u0430 \u0456\u0445 \u043f\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456, \u044f\u043a\u0456\u044f \u0430\u0431\u0430\u0432\u044f\u0437\u0432\u0430\u044e\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430 \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u0446\u044c \u0442\u0440\u044b \u0432\u044b\u0448\u044d\u0439\u0437\u0433\u0430\u0434\u0430\u043d\u044b\u044f \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u044f \u043f\u0430\u0440\u0430\u0434\u044b, \u0451\u043d \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0434\u0434\u0430\u0435\u0446\u0446\u0430 \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u043c\u0443 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0451, \u0442\u0430\u043a \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0441\u0432\u043e\u0439 \u043d\u043e\u0432\u044b \u0456 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b \u0442\u044b\u0442\u0443\u043b \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0435 \u0441\u044f\u0431\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044e \u0411\u043e\u0433\u0443 \u0456 \u042f\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044e. \u0425\u043e\u0446\u044c \u043f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442 \u0451\u043d \u0443\u0436\u043e \u043f\u0430\u043c\u0451\u0440 \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443 \u0456 \u0431\u044b\u045e \u043f\u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b \u0411\u043e\u0433\u0443, \u0430\u0434\u043d\u0430\u043a \u0434\u0437\u0435\u043b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u043d\u044f \u0431\u0430\u0433\u0430\u0446\u0435\u0439\u0448\u0430\u0433\u0430 \u043f\u043b\u0451\u043d\u0443 \u043b\u0430\u0441\u043a\u0456 \u0445\u0440\u043e\u0441\u0442\u0443 \u0432\u044b\u0440\u0430\u0448\u0430\u0435 \u043f\u0440\u0430\u0437 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u0445 \u043f\u0430\u0440\u0430\u0434 \u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0430\u0434 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434, \u044f\u043a\u0456\u044f \u043c\u0430\u0433\u043b\u0456 \u0431 \u0430\u0434\u0432\u0435\u0441\u0446\u0456 \u044f\u0433\u043e \u0430\u0434 \u0433\u0430\u0440\u0430\u0447\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u0430\u0434 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u043a\u0443\u043b\u044c\u0442\u0443, \u0456 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0435 \u0441\u044f\u0431\u0435 \u0411\u043e\u0436\u0430\u043c\u0443 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044e. \u041f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c, \u0431\u043e \u045e \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u044b\u0445 \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u044b\u0445 \u0441\u0443\u0432\u044f\u0437\u044f\u0445 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0440\u0430\u0437\u043d\u0435\u0439 \u0431\u0430\u0447\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0437\u0432\u044f\u0437\u0430\u043d\u044b \u043d\u0435\u043f\u0430\u0440\u044b\u045e\u043d\u0430\u0439 \u043f\u043e\u0432\u044f\u0437\u0437\u044e \u0437 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c, \u0441\u0432\u0430\u0451\u0439 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u044f \u043f\u0430\u0440\u0430\u0434\u044b \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e, \u0434\u0430 \u044f\u043a\u043e\u0439 \u0432\u044f\u0434\u0443\u0446\u044c, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0430\u0431\u2019\u044f\u0434\u043d\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0437 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0456 \u044f\u0433\u043e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u0439 \u0442\u044b\u0445, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u0456\u043c\u0456, \u0442\u043e \u0456\u0445 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u044b\u0441\u0432\u0435\u0447\u0430\u043d\u0430 \u0434\u0430\u0431\u0440\u0443 \u045e\u0441\u044f\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0417 \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0430\u0431\u043e \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439, \u0430\u0431\u043e \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0439 \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u044e \u043f\u0430 \u043c\u0435\u0440\u044b \u0441\u0456\u043b \u0456 \u045e \u0437\u0430\u043b\u0435\u0436\u043d\u0430\u0441\u0446\u0456 \u0430\u0434 \u0444\u043e\u0440\u043c\u044b \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u045e\u043a\u0430\u0440\u0430\u043d\u0435\u043d\u043d\u044f \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u044f \u045e \u0434\u0443\u0448\u0430\u0445 \u0411\u043e\u0436\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0456 \u043f\u0430\u0448\u044b\u0440\u044d\u043d\u043d\u044f \u044f\u0433\u043e \u043d\u0430 \u045e\u0441\u0435 \u043a\u0440\u0430\u0456\u043d\u044b. \u0422\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b \u0431\u044f\u0440\u044d \u043f\u0430\u0434 \u0430\u043f\u0435\u043a\u0443 \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0430\u0434\u043c\u0435\u0442\u043d\u044b \u0445\u0430\u0440\u0430\u043a\u0442\u0430\u0440 \u0440\u043e\u0437\u043d\u044b\u0445 \u043c\u0430\u043d\u0430\u0441\u043a\u0456\u0445 \u0456\u043d\u0441\u0442\u044b\u0442\u0443\u0442\u0430\u045e.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u0445 \u043f\u0430\u0440\u0430\u0434 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u044f\u043a \u0431\u044b \u0431\u0430\u0447\u043d\u044b\u043c \u0437\u043d\u0430\u043a\u0430\u043c, \u044f\u043a\u0456 \u043c\u043e\u0436\u0430 \u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0434\u0437\u0435\u0439\u0441\u043d\u0430 \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u0446\u044c \u0443\u0441\u0456\u0445 \u0447\u043b\u0435\u043d\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0434\u0430 \u0430\u0445\u0432\u043e\u0442\u043d\u0430\u0433\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044f \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u045e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u044b \u043d\u0430\u0440\u043e\u0434 \u043d\u0435 \u043c\u0430\u0435 \u0442\u0443\u0442 \u0441\u0442\u0430\u043b\u0430\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430, \u0430 \u0448\u0443\u043a\u0430\u0435 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430, \u0442\u043e \u043c\u0430\u043d\u0430\u0441\u043a\u0456 \u0441\u0442\u0430\u043d \u0434\u0430\u0435 \u0431\u043e\u043b\u044c\u0448 \u0441\u0432\u0430\u0431\u043e\u0434\u044b \u0430\u0434 \u0437\u044f\u043c\u043d\u044b\u0445 \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0447\u043b\u0435\u043d\u0430\u043c, \u043d\u0430\u0439\u043b\u0435\u043f\u0448 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u045e\u0441\u0456\u043c \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u043c \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b, \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u044b\u044f \u045e\u0436\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u043d\u043e\u0432\u0430\u0435 \u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0437\u0434\u0430\u0431\u044b\u0442\u0430\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044e \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u0431\u0443\u0434\u0443\u0447\u0430\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u045e \u0441\u043b\u0430\u0432\u0435 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0413\u044d\u0442\u044b \u0441\u0442\u0430\u043d \u0431\u043e\u043b\u044c\u0448 \u0432\u0435\u0440\u043d\u0430 \u043d\u0430\u0441\u043b\u0435\u0434\u0443\u0435 \u0456 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0442\u0443\u044e \u0444\u043e\u0440\u043c\u0443 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u0443\u044e \u0430\u0431\u0440\u0430\u045e \u0411\u043e\u0436\u044b \u0421\u044b\u043d, \u043f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b \u045e \u0441\u0432\u0435\u0442 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0432\u043e\u043b\u044e \u0410\u0439\u0446\u0430, \u0456 \u044f\u043a\u0443\u044e \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u0432\u0443\u0447\u043d\u044f\u043c, \u044f\u043a\u0456\u044f \u043f\u0430\u0439\u0448\u043b\u0456 \u0437\u0430 \u0406\u043c. \u0423\u0440\u044d\u0448\u0446\u0435, \u0433\u044d\u0442\u044b \u0441\u0442\u0430\u043d \u043f\u0430-\u0441\u0432\u043e\u0439\u043c\u0443 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0443 \u0411\u043e\u0436\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0437\u044f\u043c\u043d\u044b\u043c \u0456 \u044f\u0433\u043e \u043d\u0430\u0439\u0432\u0430\u0436\u043d\u0435\u0439\u0448\u044b\u044f \u043f\u0430\u0442\u0440\u044d\u0431\u044b; \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u045e\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0443\u044e \u0432\u0435\u043b\u0456\u0447 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043d\u0435\u0430\u0431\u043c\u0435\u0436\u0430\u0432\u0430\u043d\u0443\u044e \u043c\u043e\u0446 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u0430 \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u042d\u0444 5, 8-9; \u041c\u0446 5, 14. 16\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0412\u044b \u0441\u0432\u044f\u0442\u043b\u043e \u045e \u041f\u0430\u043d\u0443; \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435, \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u0441\u0432\u044f\u0442\u043b\u0430. <\/span><span style=\"color: #ff0000;\">*<\/span><span style=\"color: #ff00ff;\"> <\/span><span>\u041f\u043b\u043e\u0434 \u0441\u0432\u044f\u0442\u043b\u0430 \u0451\u0441\u0446\u044c \u0432\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0412\u044b \u2013 \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0442\u0443; \u043d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u043b\u043e \u0432\u0430\u0448\u0430 \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456. <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u041f\u043b\u043e\u0434.<\/span><span style=\"color: #ff00ff;\"><\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"822","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 25, 7-8: PL 46, 937-938)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u043c\u0430\u0435 \u043d\u0430\u0434\u0437\u0435\u044e, \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0437\u0430\u0447\u0430\u043b\u0430<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041f\u0440\u0430\u0448\u0443, \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043d\u0430\u0434 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u044f\u043a\u0456\u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d, \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u044e\u0447\u044b \u0440\u0443\u043a\u0443 \u0441\u0432\u0430\u044e \u0434\u0430 \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e: \u00ab\u0412\u043e\u0441\u044c \u043c\u0430\u0446\u0456 \u041c\u0430\u044f \u0456 \u0431\u0440\u0430\u0442\u044b \u041c\u0430\u0435\u00bb, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430: \u00ab\u0425\u0442\u043e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0432\u043e\u043b\u044e \u0410\u0439\u0446\u0430 \u041c\u0430\u0439\u0433\u043e, \u044f\u043a\u0456 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445, \u0442\u043e\u0439 \u041c\u043d\u0435 \u0431\u0440\u0430\u0442, \u0456 \u0441\u044f\u0441\u0442\u0440\u0430, \u0456 \u043c\u0430\u0446\u0456\u00bb (\u041c\u0446 12, 49-50). \u0426\u0456 \u0436 \u0414\u0437\u0435\u0432\u0430 \u041c\u0430\u0440\u044b\u044f \u043d\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0430 \u0432\u043e\u043b\u0456 \u0410\u0439\u0446\u0430? \u0426\u0456 \u0436 \u043d\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0430 \u0432\u043e\u043b\u0456 \u0410\u0439\u0446\u0430 \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0434\u0430\u0432\u0435\u0440\u044b\u043b\u0430\u0441\u044f, \u0443 \u0432\u0435\u0440\u044b \u0437\u0430\u0447\u0430\u043b\u0430, \u044f\u043a\u0430\u044f \u0431\u044b\u043b\u0430 \u0430\u0431\u0440\u0430\u043d\u0430\u044f \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0443 \u0401\u0439 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0434\u043b\u044f \u043d\u0430\u0441, \u043b\u044e\u0434\u0437\u0435\u0439, \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u044f\u043a\u0430\u044f \u0431\u044b\u043b\u0430 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u042f\u043d\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430? \u041a\u0430\u043d\u0435\u0448\u043d\u0435 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430! \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u044f \u041c\u0430\u0440\u044b\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430 \u0432\u043e\u043b\u044e \u0410\u0439\u0446\u0430. \u0422\u0430\u043c\u0443 \u0431\u043e\u043b\u044c\u0448 \u0432\u0430\u0436\u043d\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0430\u0439 \u0434\u043b\u044f \u041c\u0430\u0440\u044b\u0456 \u0431\u044b\u043b\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u042f\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u0432\u0443\u0447\u0430\u043d\u0456\u0446\u0430\u0439 \u0425\u0440\u044b\u0441\u0442\u0430, \u0447\u044b\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u042f\u043d\u0430 \u0431\u044b\u043b\u0430 \u043c\u0430\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u0430. \u041d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 \u0431\u044b\u043b\u043e \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u042f\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u0432\u0443\u0447\u0430\u043d\u0456\u0446\u0430\u0439 \u0425\u0440\u044b\u0441\u0442\u0430, \u0447\u044b\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u042f\u043d\u0430 \u0431\u044b\u043b\u0430 \u042f\u0433\u043e \u043c\u0430\u0446\u0456. \u0422\u0430\u043c\u0443 \u041c\u0430\u0440\u044b\u044f \u0431\u044b\u043b\u0430 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0439, \u0431\u043e \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430, \u043d\u0430\u0441\u0456\u043b\u0430 \u042f\u0433\u043e \u0440\u0430\u043d\u0435\u0439 \u0443 \u0441\u0432\u0430\u0456\u043c \u0443\u043b\u043e\u043d\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u0446\u0456 \u0436 \u043d\u0435 \u0442\u0430\u043a \u0443\u0441\u0451 \u0456 \u0451\u0441\u0446\u044c, \u044f\u043a \u044f \u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435. \u041a\u0430\u043b\u0456 \u041f\u0430\u043d, \u0430\u043a\u0440\u0443\u0436\u0430\u043d\u044b \u043d\u0430\u0442\u043e\u045e\u043f\u0430\u043c \u043b\u044e\u0434\u0437\u0435\u0439, \u0456\u0448\u043e\u045e \u0456 \u0447\u044b\u043d\u0456\u045e \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u044f \u0440\u044d\u0447\u044b, \u043d\u0435\u0439\u043a\u0430\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u043a\u0440\u044b\u043a\u043d\u0443\u043b\u0430: \u00ab\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0435 \u045e\u043b\u043e\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043d\u0430\u0441\u0456\u043b\u0430 \u0426\u044f\u0431\u0435, \u0456 \u0433\u0440\u0443\u0434\u0437\u0456, \u044f\u043a\u0456\u044f \u043a\u0430\u0440\u043c\u0456\u043b\u0456 \u0426\u044f\u0431\u0435!\u00bb (\u041b\u043a 11, 27). \u041f\u0430\u043d, \u043a\u0430\u043b\u0456 \u0432\u0443\u0447\u044b\u045e, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0448\u0443\u043a\u0430\u045e \u0448\u0447\u0430\u0441\u0446\u044f \u045e \u0446\u0435\u043b\u0435, \u0448\u0442\u043e \u0436 \u0442\u0430\u0434\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u045e? \u00ab\u0411\u043e\u043b\u044c\u0448 \u0437\u0430 \u0442\u043e\u0435, \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u044f\u0433\u043e!\u00bb (\u041b\u043a 11, 28). \u0422\u0430\u043c\u0443 \u041c\u0430\u0440\u044b\u044f \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f, \u0431\u043e \u0441\u043b\u0443\u0445\u0430\u043b\u0430 \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0430 \u044f\u0433\u043e. \u0411\u043e\u043b\u044c\u0448 \u043f\u0456\u043b\u044c\u043d\u0430\u0432\u0430\u043b\u0430 \u043f\u0440\u0430\u045e\u0434\u0443 \u045e \u0441\u044d\u0440\u0446\u044b, \u0447\u044b\u043c \u0446\u0435\u043b\u0430 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456. \u0425\u0440\u044b\u0441\u0442\u0443 \u2013 \u043f\u0440\u0430\u045e\u0434\u0430, \u0425\u0440\u044b\u0441\u0442\u0443 \u2013 \u0446\u0435\u043b\u0430. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u045e\u0434\u0430\u0439 \u0443 \u0441\u044d\u0440\u0446\u044b \u041c\u0430\u0440\u044b\u0456, \u0430 \u0446\u0435\u043b\u0430\u043c \u0443 \u042f\u0435 \u045e\u043b\u043e\u043d\u043d\u0456. \u0411\u044b\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u044b \u0431\u043e\u043b\u044c\u0448 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0447\u044b\u043c \u0431\u044b\u0446\u044c \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u041c\u0430\u0440\u044b\u044f \u0441\u0432\u044f\u0442\u0430\u044f, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f. \u0410\u043b\u0435 \u041a\u0430\u0441\u0446\u0451\u043b \u0431\u043e\u043b\u044c\u0448. \u0427\u0430\u043c\u0443? \u0411\u043e \u041c\u0430\u0440\u044b\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0447\u0430\u0441\u0442\u043a\u0430\u0439 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u043c \u0447\u043b\u0435\u043d\u0430\u043c, \u0441\u0430\u043c\u044b\u043c \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u043c, \u0441\u0430\u043c\u044b\u043c \u0443\u0437\u043d\u0451\u0441\u043b\u044b\u043c, \u0430\u043b\u0435 \u0430\u0434\u043d\u0430\u043a \u0447\u043b\u0435\u043d\u0430\u043c \u0443\u0441\u044f\u0433\u043e \u0446\u0435\u043b\u0430. \u041a\u0430\u043b\u0456 \u042f\u043d\u0430 \u2013 \u0447\u0430\u0441\u0442\u043a\u0430 \u045e\u0441\u044f\u0433\u043e \u0446\u0435\u043b\u0430, \u0442\u043e \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430 \u0447\u044b\u043c\u0441\u044c\u0446\u0456 \u0431\u043e\u043b\u044c\u0448\u044b\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0441\u0451 \u0446\u0435\u043b\u0430, \u0430 \u043d\u0435 \u044f\u0433\u043e \u0447\u0430\u0441\u0442\u043a\u0430. \u041f\u0430\u043d \u2013 \u0413\u0430\u043b\u0430\u0432\u0430, \u0443\u0432\u0435\u0441\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u2013 \u0433\u044d\u0442\u0430 \u0456 \u0413\u0430\u043b\u0430\u0432\u0430, \u0456 \u0446\u0435\u043b\u0430. \u0421\u0446\u0456\u0441\u043b\u0430 \u043a\u0430\u0436\u0443\u0447\u044b: \u043c\u044b \u043c\u0430\u0435\u043c \u0411\u043e\u0441\u043a\u0443\u044e \u0413\u0430\u043b\u0430\u0432\u0443, \u043c\u0430\u0435\u043c \u0411\u043e\u0433\u0430 \u044f\u043a \u0413\u0430\u043b\u0430\u0432\u0443.<\/span><\/p>\r\n<p style=\"text-indent: 27pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043d\u0430 \u0441\u044f\u0431\u0435: \u0432\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0447\u043b\u0435\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u0432\u044b \u2013 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u041f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435, \u044f\u043a \u0432\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0435\u0441\u044f \u0442\u044b\u043c\u0456, \u043f\u0440\u0430 \u043a\u0430\u0433\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043a\u0430\u0436\u0430 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: \u00ab\u0412\u043e\u0441\u044c \u043c\u0430\u0446\u0456 \u041c\u0430\u044f \u0456 \u0431\u0440\u0430\u0442\u044b \u041c\u0430\u0435\u00bb. \u042f\u043a \u0432\u044b \u043c\u043e\u0436\u0430\u0446\u0435 \u0441\u0442\u0430\u0446\u044c \u043c\u0430\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u0430? \u0425\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u0435 \u0456 \u00ab\u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0432\u043e\u043b\u044e \u0410\u0439\u0446\u0430 \u041c\u0430\u0439\u0433\u043e, \u044f\u043a\u0456 \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445, \u0442\u043e\u0439 \u041c\u043d\u0435 \u0431\u0440\u0430\u0442, \u0456 \u0441\u044f\u0441\u0442\u0440\u0430, \u0456 \u043c\u0430\u0446\u0456\u00bb. \u0414\u043e\u0431\u0440\u0430 \u043a\u0430\u0436\u0443: \u0431\u0440\u0430\u0442, \u0434\u043e\u0431\u0440\u0430 \u043a\u0430\u0436\u0443: \u0441\u044f\u0441\u0442\u0440\u0430, \u0431\u043e \u0456\u0441\u043d\u0443\u0435 \u0430\u0434\u043d\u0430 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430. \u0422\u0430\u043c\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b, \u0443 \u0441\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0431\u044b\u0446\u044c \u0430\u0434\u0437\u0456\u043d\u044b\u043c; \u0445\u0430\u0446\u0435\u045e, \u043a\u0430\u0431 \u043c\u044b \u0431\u044b\u043b\u0456 \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c\u0456 \u0410\u0439\u0446\u0430 \u0456 \u0441\u0443\u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c\u0456 \u042f\u0433\u043e \u0441\u0430\u043c\u043e\u0433\u0430.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u0406\u0441 61, 10; \u041b\u043a 1, 46-47\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0423\u0437\u0440\u0430\u0434\u0443\u044e\u0441\u044f \u045e \u041f\u0430\u043d\u0443, \u0443\u0437\u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u045e \u0411\u043e\u0433\u0443 \u043c\u0430\u0456\u043c; <\/span><span style=\"color: #ff0000;\">*<\/span><span> \u0431\u043e \u0401\u043d \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u043c\u044f\u043d\u0435 \u045e \u0448\u0430\u0442\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u044f\u043a \u043d\u044f\u0432\u0435\u0441\u0442\u0443, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u044b\u045e \u0441\u0432\u0430\u0456\u043c\u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044f\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0412\u0435\u043b\u0456\u0447\u0430\u0435 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u041f\u0430\u043d\u0430, \u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0434\u0443\u0445 \u043c\u043e\u0439 \u0443 \u0411\u043e\u0433\u0443, \u043c\u0430\u0456\u043c \u0417\u0431\u0430\u045e\u0446\u0443. <\/span><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0411\u043e \u0401\u043d.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"823","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e\u00bb \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 32, sermo 1, 7-8: CCL 38, 253-254)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0440\u044b\u0433\u043e\u0436\u0430 \u0441\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0443 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u00ab\u0421\u043b\u0430\u045e\u0446\u0435 \u041f\u0430\u043d\u0430 \u043d\u0430 \u0433\u0443\u0441\u043b\u044f\u0445, \u0433\u0440\u0430\u0439\u0446\u0435 \u042f\u043c\u0443 \u043d\u0430 \u0434\u0437\u0435\u0441\u044f\u0446\u0456\u0441\u0442\u0440\u0443\u043d\u043d\u0430\u0439 \u0430\u0440\u0444\u0435. \u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u042f\u043c\u0443 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e\u00bb (\u041f\u0441 33 [32]), 2-3). \u0410\u0434\u043a\u0456\u043d\u044c\u0446\u0435 \u045e\u0441\u0451 \u0441\u0442\u0430\u0440\u043e\u0435, \u0431\u043e \u0432\u044b \u043f\u0430\u0447\u0443\u043b\u0456 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e. \u041d\u043e\u0432\u044b\u043c \u043b\u044e\u0434\u0437\u044f\u043c \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u041d\u043e\u0432\u044b \u0417\u0430\u043f\u0430\u0432\u0435\u0442 \u0456 \u043d\u043e\u0432\u0430\u044f \u043f\u0435\u0441\u043d\u044f. \u041d\u043e\u0432\u0430\u044f \u043f\u0435\u0441\u043d\u044f \u043d\u0435 \u0434\u043b\u044f \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0412\u0443\u0447\u0430\u0446\u0446\u0430 \u0451\u0439 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u043e\u0432\u044b\u044f \u043b\u044e\u0434\u0437\u0456, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u0437 \u0440\u0430\u043d\u0435\u0439\u0448\u044b\u0445 \u0441\u0442\u0430\u043b\u0456 \u043d\u043e\u0432\u044b\u043c\u0456 \u0456 \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0434\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0414\u0430 \u044f\u0433\u043e \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u045e\u0441\u044f \u043d\u0430\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0430\u044f \u0441\u043f\u044f\u0432\u0430\u0435 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e. \u041d\u044f\u0445\u0430\u0439 \u0441\u043f\u044f\u0432\u0430\u0435 \u044f\u0435 \u043d\u0435 \u044f\u0437\u044b\u043a\u043e\u043c, \u0430\u043b\u0435 \u0436\u044b\u0446\u0446\u0451\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u00ab\u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u042f\u043c\u0443 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e, \u043f\u0440\u044b\u0433\u043e\u0436\u0430 \u0433\u0440\u0430\u0439\u0446\u0435 \u042f\u043c\u0443\u00bb (\u041f\u0441 33 [32]), 3). \u0425\u0442\u043e\u0441\u044c\u0446\u0456 \u0441\u043f\u044b\u0442\u0430\u0435\u0446\u0446\u0430, \u044f\u043a \u043d\u0430\u043c \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0443? \u0421\u043f\u044f\u0432\u0430\u0439, \u0430\u043b\u0435 \u043d\u0435 \u0444\u0430\u043b\u044c\u0448\u044b\u045e. \u041d\u0435\u043b\u044c\u0433\u0430 \u0430\u0431\u0440\u0430\u0436\u0430\u0446\u044c \u042f\u0433\u043e \u0432\u0443\u0448\u044b. \u0421\u043f\u044f\u0432\u0430\u0439 \u043f\u0440\u044b\u0433\u043e\u0436\u0430, \u043c\u043e\u0439 \u0431\u0440\u0430\u0442. \u041a\u0430\u043b\u0456 \u0441\u043f\u044f\u0432\u0430\u0435\u0448 \u043f\u0435\u0440\u0430\u0434 \u043a\u0456\u043c\u0441\u044c\u0446\u0456, \u0445\u0442\u043e \u0440\u0430\u0437\u0431\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u045e \u043c\u0443\u0437\u044b\u0446\u044b, \u0430 \u0442\u0430\u0431\u0435 \u0441\u043a\u0430\u0436\u0443\u0446\u044c \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0442\u0430\u043a, \u043a\u0430\u0431 \u044f\u043c\u0443 \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f, \u0442\u0430\u0434\u044b, \u043d\u0435 \u043c\u0430\u044e\u0447\u044b \u043c\u0443\u0437\u044b\u0447\u043d\u0430\u0439 \u0430\u0434\u0443\u043a\u0430\u0446\u044b\u0456, \u0442\u044b \u0430\u0434\u043c\u043e\u0432\u0456\u0448\u0441\u044f, \u043a\u0430\u0431 \u0432\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u0430 \u043d\u0435 \u043f\u0430\u0447\u0443\u0446\u044c \u043a\u0440\u044b\u0442\u044b\u043a\u0456 \u0437\u043d\u0430\u045e\u0446\u044b. \u0411\u043e \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435\u0434\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u044b \u043d\u0435 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c \u0443 \u0442\u0432\u0430\u0456\u043c \u0441\u043f\u0435\u0432\u0435, \u043c\u0443\u0437\u044b\u043a\u0430\u043d\u0442 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c \u0456 \u0437\u0433\u0430\u043d\u0456\u0446\u044c. \u0410 \u0445\u0442\u043e \u0430\u0434\u0432\u0430\u0436\u044b\u0446\u0446\u0430 \u043f\u0440\u044b\u0433\u043e\u0436\u0430 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c, \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c, \u0445\u0442\u043e \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a \u0430\u0446\u044d\u043d\u044c\u0432\u0430\u0435 \u0441\u043f\u0435\u0432\u0430\u043a\u0430, \u0445\u0442\u043e \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0435 \u045e\u0441\u0451, \u0445\u0442\u043e \u045e\u0441\u0451 \u0447\u0443\u0435? \u041a\u0430\u043b\u0456 \u0436 \u0442\u044b \u0437\u043c\u043e\u0436\u0430\u0448 \u0431\u044b\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u0443 \u0441\u043f\u0435\u0432\u0435, \u043a\u0430\u0431 \u043d\u0456\u0447\u044b\u043c \u043d\u0435 \u0430\u0431\u0440\u0430\u0437\u0456\u0446\u044c \u0442\u0430\u043a\u0456\u0445 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u0445 \u0432\u0443\u0448\u044d\u0439?<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u0412\u043e\u0441\u044c \u0436\u0430 \u0411\u043e\u0433 \u0441\u0430\u043c \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0442\u0430\u0431\u0435 \u043f\u044d\u045e\u043d\u044b \u0441\u043f\u043e\u0441\u0430\u0431 \u0441\u043f\u0435\u0432\u0443. \u041d\u0435 \u0448\u0443\u043a\u0430\u0439 \u0441\u043b\u043e\u0432\u0430\u045e, \u043d\u0456\u0431\u044b \u0442\u044b \u043c\u043e\u0436\u0430\u0448 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u043e\u0435, \u0443 \u0447\u044b\u043c \u0411\u043e\u0433 \u043c\u0430\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u0435. \u0421\u043f\u044f\u0432\u0430\u0439 \u0437 \u0432\u043e\u043a\u043b\u0456\u0447\u0430\u043c\u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u0456. \u041f\u0440\u044b\u0433\u043e\u0436\u0430 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0443, \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u043d\u0430. \u0428\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u043d\u0430? \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0448\u0442\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u0432\u044b\u043a\u0430\u0437\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043f\u044f\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u044d\u0440\u0446\u0430\u043c. \u0422\u044b\u044f, \u0445\u0442\u043e \u0441\u043f\u044f\u0432\u0430\u0435 \u043f\u0430\u0434\u0447\u0430\u0441 \u0436\u043d\u0456\u0432\u0430 \u0446\u0456 \u0437\u0431\u043e\u0440\u0443 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0443, \u0446\u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u043d\u0435\u0439\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b, \u0448\u0442\u043e \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u044f\u043d\u044b \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0432\u044b\u044f\u045e\u043b\u044f\u044e\u0446\u044c \u0441\u0432\u0430\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0443 \u0441\u043b\u043e\u0432\u0430\u0445, \u0430\u0434\u043d\u0430\u043a, \u0430\u0445\u043e\u043f\u043b\u0435\u043d\u044b\u044f \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u043f\u0430\u043a\u0456\u0434\u0430\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c.<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u0420\u0430\u0434\u0430\u0441\u043d\u044b \u0432\u043e\u043a\u043b\u0456\u0447 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u0448\u0442\u043e \u0441\u044d\u0440\u0446\u0430 \u043f\u0435\u0440\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u0430 \u043f\u0430\u0447\u0443\u0446\u0446\u0451\u043c, \u044f\u043a\u043e\u0435 \u043d\u0435\u043b\u044c\u0433\u0430 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u0430\u043c\u0456. \u041a\u0430\u043c\u0443 \u0433\u044d\u0442\u0430 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0443\u043b\u0430\u0441\u0446\u0456\u0432\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0411\u043e\u0433\u0443 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u043c\u0443. \u0411\u043e \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b\u043c \u0451\u0441\u0446\u044c \u0442\u043e\u0439, \u043a\u0430\u0433\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u0437\u0430\u043c\u043a\u043d\u0443\u0446\u044c \u0443 \u0441\u043b\u043e\u0432\u0430\u0445. \u041a\u0430\u043b\u0456 \u043d\u0435 \u043c\u043e\u0436\u0430\u0448 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0430 \u043c\u0430\u045e\u0447\u0430\u0446\u044c \u0442\u0430\u0431\u0435 \u043d\u0435\u043b\u044c\u0433\u0430, \u0448\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u043d\u0435 \u045e\u0437\u043d\u0435\u0441\u0446\u0456 \u043a\u0440\u044b\u043a \u0440\u0430\u0434\u0430\u0441\u0446\u0456? \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0442\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0431\u0435\u0437 \u0441\u043b\u043e\u0432\u0430\u045e, \u043d\u044f\u0445\u0430\u0439 \u0442\u0432\u0430\u044f \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043d\u0435 \u0430\u0431\u043c\u044f\u0436\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456. \u041f\u0440\u044b\u0433\u043e\u0436\u0430 \u0441\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u0437 \u0432\u043e\u043a\u043b\u0456\u0447\u0430\u043c\u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 (\u041f\u0441 33 [32]), 3).<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439&nbsp; <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u041f\u0441 71 (70), 8. 23\u0430; 9, 3\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0412\u0443\u0441\u043d\u044b \u043c\u0430\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0422\u0432\u0430\u0451\u0439 \u0445\u0432\u0430\u043b\u043e\u0439, \u0422\u0432\u0430\u0451\u0439 \u0432\u0435\u043b\u0456\u0447\u0447\u0443 \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c; <\/span><span style=\"color: #ff0000;\">*<\/span><span style=\"color: #ff00ff;\"> <\/span><span>\u0443\u0437\u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u0432\u0443\u0441\u043d\u044b \u043c\u0430\u0435, \u043a\u0430\u043b\u0456 \u044f \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u044e \u0422\u0430\u0431\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0411\u0443\u0434\u0443 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0422\u0430\u0431\u0435 \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430, \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u0456\u043c\u0435\u043d\u0456 \u0422\u0432\u0430\u0439\u043c\u0443, \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b. <\/span><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0423\u0437\u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"824","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041b\u0456\u0441\u0442 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e\u00bb \u0441\u0432. \u041a\u043b\u0456\u043c\u044d\u043d\u0442\u0430 \u0406, \u043f\u0430\u043f\u044b<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 35, 1-5; 36, 1-2; 37, 1. 4-5; 38, 1-2. 4: Funk 1, 105-109)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0426\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0434\u0430\u0440\u044b \u0411\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u044f\u043a\u0456\u044f \u0436 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f, \u044f\u043a\u0456\u044f \u0436 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0434\u0430\u0440\u044b \u0411\u043e\u0433\u0430! \u0416\u044b\u0446\u0446\u0451 \u045e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456, \u0445\u0432\u0430\u043b\u0430 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043f\u0440\u0430\u045e\u0434\u0430 \u045e \u0441\u0432\u0430\u0431\u043e\u0434\u0437\u0435, \u0432\u0435\u0440\u0430 \u045e \u043d\u0430\u0434\u0437\u0435\u0456, \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u043d\u0430\u0434 \u0441\u0430\u0431\u043e\u044e \u045e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456. \u0413\u044d\u0442\u0430 \u045e\u0441\u0451 \u043c\u0430\u0433\u0447\u044b\u043c\u0430 \u0434\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f. \u042f\u043a\u0456\u044f \u0436 \u0434\u0430\u0440\u044b \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b \u0442\u044b\u043c, \u0445\u0442\u043e \u0447\u0430\u043a\u0430\u0435 \u042f\u0433\u043e? \u0406\u0445 \u0432\u0435\u043b\u0456\u0447 \u0456 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0432\u0435\u0434\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u044b \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0456 \u0410\u0439\u0446\u0435\u0446 \u0432\u044f\u043a\u043e\u045e. \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0432\u0430\u0446\u044c \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u043a\u0430\u0431 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0447\u0430\u043a\u0430\u0435 \u042f\u0433\u043e, \u043a\u0430\u0431 \u043c\u0435\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u0430\u0431\u044f\u0446\u0430\u043d\u044b\u0445 \u0434\u0430\u0440\u0430\u0445.<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u044f\u043a \u0433\u044d\u0442\u0430 \u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f? \u0421\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u043d\u0430\u0448\u0430\u0435 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u0430\u0435 \u045e \u0411\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u043a\u0430\u043b\u0456 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0448\u0443\u043a\u0430\u0446\u044c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u0456\u043b\u0430\u0435 \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435 \u0411\u043e\u0433\u0443, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435 \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0439 \u0432\u043e\u043b\u0456, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0456\u0441\u0446\u0456 \u0434\u0430\u0440\u043e\u0433\u0430\u0439 \u043f\u0440\u0430\u045e\u0434\u044b, \u0430\u0434\u043a\u0456\u0434\u0432\u0430\u044e\u0447\u044b \u045e\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u043d\u0435\u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0441\u043f\u0440\u044d\u0447\u043a\u0456, \u0433\u043d\u0435\u045e \u0456 \u043f\u0430\u0434\u043c\u0430\u043d.<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0432\u043e\u0441\u044c \u0434\u0430\u0440\u043e\u0433\u0430, \u043d\u0430 \u044f\u043a\u043e\u0439 \u043c\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0430 \u043d\u0430\u0448\u044b\u0445 \u0430\u0445\u0432\u044f\u0440\u0430\u045e, \u0410\u0431\u0430\u0440\u043e\u043d\u0446\u0443 \u0456 \u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u043c\u0443 \u043c\u044b \u0433\u043b\u044f\u0434\u0437\u0456\u043c \u0443 \u0432\u044b\u0448\u044b\u043d\u0456 \u043d\u0435\u0431\u0430; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u043c\u0443 \u0431\u0430\u0447\u044b\u043c \u043d\u0456\u0431\u044b \u045e \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0443 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0411\u043e\u0433\u0430; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u043c\u0443 \u0430\u0434\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u0432\u043e\u0447\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u043c\u0443 \u043d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c, \u0441\u043b\u0430\u0431\u044b \u0456 \u0437\u0430\u0446\u0435\u043c\u043d\u0435\u043d\u044b, \u0437\u0430\u044f\u0441\u043d\u0435\u045e \u0443 \u0441\u0432\u044f\u0442\u043b\u0435; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u043c\u0443 \u041f\u0430\u043d \u043f\u0430\u0436\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u043b\u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e, \u0431\u0443\u0434\u0443\u0447\u044b \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b, \u0441\u0442\u0430\u045e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0437\u0430 \u0430\u043d\u0451\u043b\u0430\u045e, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043e\u043b\u044c\u0448 \u0441\u043b\u0430\u045e\u043d\u0430\u0435, \u0447\u044b\u043c \u044f\u043d\u044b, \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0456\u043c\u044f (\u043f\u0430\u0440. \u0413\u0431\u0440 1, 3-4).<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b\u0430\u045e \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u043f\u0430\u0434 \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u043c\u0456 \u0437\u0430\u0433\u0430\u0434\u0430\u043c\u0456. \u0412\u044f\u043b\u0456\u043a\u0456\u044f \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0456\u0441\u043d\u0430\u0432\u0430\u0446\u044c \u0431\u0435\u0437 \u043c\u0430\u043b\u044b\u0445, \u0456 \u043c\u0430\u043b\u044b\u044f \u0431\u0435\u0437 \u0432\u044f\u043b\u0456\u043a\u0456\u0445. \u042f\u043d\u044b \u045e\u0441\u0435 \u0437\u0432\u044f\u0437\u0430\u043d\u044b\u044f, \u0430\u0434\u0441\u044e\u043b\u044c \u0456 \u043a\u0430\u0440\u044b\u0441\u0446\u044c. \u041d\u044f\u0445\u0430\u0439 \u0434\u043b\u044f \u043d\u0430\u0441 \u0441\u0442\u0430\u043d\u0435 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u043d\u0430\u0448\u0430\u0435 \u0446\u0435\u043b\u0430. \u0413\u0430\u043b\u0430\u0432\u0430 \u0431\u0435\u0437 \u043d\u043e\u0433 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0432\u0430\u0440\u0442\u0430\u044f, \u0456 \u043d\u043e\u0433\u0456 \u0431\u0435\u0437 \u0433\u0430\u043b\u0430\u0432\u044b; \u043d\u0430\u0432\u0430\u0442 \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u044b\u044f \u0447\u043b\u0435\u043d\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u044f \u0456 \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u044f \u0434\u043b\u044f \u045e\u0441\u044f\u0433\u043e \u0430\u0440\u0433\u0430\u043d\u0456\u0437\u043c\u0430. \u0417\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0443\u0441\u0435 \u044f\u043d\u044b \u045e\u0437\u0430\u0435\u043c\u043d\u0430 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u044b\u044f \u0441\u0430\u0431\u0435, \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u0437\u0434\u0430\u0440\u043e\u045e\u044e \u045e\u0441\u044f\u0433\u043e \u0446\u0435\u043b\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0443\u0441\u0451 \u043d\u0430\u0448\u0430\u0435 \u0446\u0435\u043b\u0430 \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u0430 \u043a\u043e\u0436\u043d\u044b \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u043c\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u0434\u0437\u0435\u043b\u0435\u043d\u0430\u0433\u0430 \u044f\u043c\u0443 \u0434\u0430\u0440\u0443 \u043b\u0430\u0441\u043a\u0456. \u041c\u043e\u0446\u043d\u044b \u043d\u044f\u0445\u0430\u0439 \u0430\u043f\u044f\u043a\u0443\u0435\u0446\u0446\u0430 \u0441\u043b\u0430\u0431\u044b\u043c, \u0441\u043b\u0430\u0431\u044b \u043d\u044f\u0445\u0430\u0439 \u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u043f\u0430\u0448\u0430\u043d\u0443 \u043c\u043e\u0446\u043d\u0430\u043c\u0443, \u0431\u0430\u0433\u0430\u0442\u044b \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u045e\u0431\u043e\u0433\u0430\u0433\u0430, \u0443\u0431\u043e\u0433\u0456 \u043d\u044f\u0445\u0430\u0439 \u0434\u0437\u044f\u043a\u0443\u0435 \u0411\u043e\u0433\u0443, \u044f\u043a\u0456 \u0434\u0430\u045e \u0431\u0430\u0433\u0430\u0442\u0430\u043c\u0443 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0447\u044b \u044f\u043c\u0443 \u045e \u043f\u0430\u0442\u0440\u044d\u0431\u0435. \u041c\u0443\u0434\u0440\u044b \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0441\u0432\u0430\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043d\u0435 \u045e \u0441\u043b\u043e\u0432\u0430\u0445, \u0430\u043b\u0435 \u045e \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u0445. \u041f\u0430\u043a\u043e\u0440\u043d\u044b \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0441\u0430\u043c \u043f\u0440\u0430 \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u043d\u044f\u0445\u0430\u0439 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c, \u043a\u0430\u0431 \u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456 \u043f\u0440\u0430 \u044f\u0433\u043e \u0456\u043d\u0448\u044b\u044f.<\/span><\/p>\r\n<p style=\"text-indent: 11.35pt; text-align: justify;\"><span>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0430\u0434 \u0411\u043e\u0433\u0430, \u0442\u0430\u043c\u0443 \u0437\u0430 \u045e\u0441\u0451 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u042f\u043c\u0443. \u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u043d\u0430\u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439&nbsp; <\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041c\u0446 7, 24; 1 \u041f 2, 22; \u043f\u0430\u0440. 1 \u0421\u0430\u043c 2, 28; \u043f\u0430\u0440. \u0421\u0456\u0440 44, 16. 17&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0412\u043e\u0441\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0440\u0430\u0437\u0443\u043c\u043d\u044b, \u044f\u043a\u0456 \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u0441\u0432\u043e\u0439 \u0434\u043e\u043c \u043d\u0430 \u0441\u043a\u0430\u043b\u0435, \u0456 \u043d\u0435 \u0431\u044b\u043b\u043e \u043f\u0430\u0434\u043c\u0430\u043d\u0443 \u045e \u0432\u0443\u0441\u043d\u0430\u0445 \u042f\u0433\u043e\u043d\u044b\u0445, <\/span><span style=\"color: #ff0000;\">*<\/span><span style=\"color: #ff00ff;\"> <\/span><span>\u0431\u043e \u0432\u044b\u0431\u0440\u0430\u045e \u044f\u0433\u043e \u0411\u043e\u0433 \u0441\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0412\u043e\u0441\u044c \u0432\u044f\u043b\u0456\u043a\u0456 \u0441\u0432\u044f\u0442\u0430\u0440, \u044f\u043a\u0456 \u043f\u0440\u044b \u0436\u044b\u0446\u0446\u0456 \u043f\u0430\u0434\u0430\u0431\u0430\u045e\u0441\u044f \u0411\u043e\u0433\u0443 \u0456 \u0431\u044b\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c. <\/span><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0411\u043e \u0432\u044b\u0431\u0440\u0430\u045e.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"825","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u00ab\u041d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u00bb \u0441\u0432. \u041a\u0430\u043b\u044e\u043c\u0431\u0430\u043d\u0430, \u0430\u0431\u0430\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Instr. 11, 1-2: Opera, Dublin 1957, 106-107)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u041f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0433\u043e\u043d\u0430\u0440\u0430\u043c&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u041c\u0430\u0439\u0441\u0435\u0439 \u043d\u0430\u043f\u0456\u0441\u0430\u045e \u0443 \u0417\u0430\u043a\u043e\u043d\u0435, \u0448\u0442\u043e \u0411\u043e\u0433 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 (\u043f\u0430\u0440. \u0411\u044b\u0446 1, 26. 27). \u041f\u0440\u0430\u0448\u0443, \u0437\u0430\u0434\u0443\u043c\u0430\u0439\u0446\u0435\u0441\u044f \u043d\u0430\u0434 \u0437\u043d\u0430\u0447\u044d\u043d\u043d\u0435\u043c \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e. \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b, \u043d\u044f\u0431\u0430\u0447\u043d\u044b, \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u044b, \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b, \u043d\u0435\u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0442\u044b \u0411\u043e\u0433, \u0441\u0442\u0432\u0430\u0440\u0430\u044e\u0447\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0437 \u0437\u044f\u043c\u043d\u043e\u0439 \u0433\u043b\u0456\u043d\u044b, \u0437\u0440\u0430\u0431\u0456\u045e \u044f\u0433\u043e \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u043f\u0440\u0430\u0437 \u043d\u0430\u0434\u0430\u043d\u043d\u0435 \u044f\u043c\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430. \u0428\u0442\u043e \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430 \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c? \u0428\u0442\u043e \u043c\u0430\u0435 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430 \u0437\u044f\u043c\u043b\u044f \u0456 \u0434\u0443\u0445? \u00ab\u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0414\u0443\u0445\u0430\u043c\u00bb (\u042f\u043d 4, 24). \u042f\u043a\u0456\u043c \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0443\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u0435\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0411\u043e\u0433 \u0430\u0434\u0430\u0440\u044b\u045e \u044f\u0433\u043e \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456 \u0456 \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0441\u0432\u0430\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u045e. \u0413\u044d\u0442\u0430\u0435 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u044f\u043d\u043e \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u0430, \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0433\u043e\u043d\u0430\u0440\u0430\u043c.<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u0411\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u043d\u0430\u043b\u0435\u0436\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044f\u043c\u0456, \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u043c\u0456 \u044f\u0433\u043e \u0434\u0443\u0448\u044b. \u0411\u043e\u0433 \u0437\u0430\u0433\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u043c\u044b \u0432\u044b\u044f\u045e\u043b\u044f\u043b\u0456 \u045e\u0441\u0435 \u0442\u044b\u044f \u0446\u043d\u043e\u0442\u044b, \u044f\u043a\u0456\u044f \u0401\u043d \u0437\u0430\u043a\u043b\u0430\u045e \u0443 \u043d\u0430\u0441 \u0443 \u043c\u043e\u043c\u0430\u043d\u0442 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f. \u041f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043d\u0430\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u00ab\u0431\u043e \u0401\u043d \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441\u00bb (1 \u042f\u043d 4, 19) \u0437 \u0441\u0430\u043c\u0430\u0433\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u043f\u0435\u0440\u0448, \u0447\u044b\u043c \u043c\u044b \u043f\u0430\u0447\u0430\u043b\u0456 \u0456\u0441\u043d\u0430\u0432\u0430\u0446\u044c. \u041b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430 \u2013 \u0433\u044d\u0442\u0430 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u042f\u0433\u043e \u0432\u043e\u0431\u0440\u0430\u0437\u0430. \u0422\u043e\u0439 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u0445\u0442\u043e \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u042f\u0433\u043e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456. \u0411\u043e \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041a\u0430\u043b\u0456 \u043b\u044e\u0431\u0456\u0446\u0435 \u041c\u044f\u043d\u0435, \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u041c\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456\u00bb (\u042f\u043d 14, 15). \u0412\u043e\u0441\u044c \u042f\u0433\u043e\u043d\u0430\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c: \u0443\u0437\u0430\u0435\u043c\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e. \u0411\u043e \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u0412\u043e\u0441\u044c \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u041c\u0430\u044f, \u043a\u0430\u0431 \u0432\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441\u00bb (\u042f\u043d 15, 12).&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 18pt; text-align: justify;\"><span>\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0441\u043b\u043e\u0432\u0430\u0445, \u0430\u043b\u0435 \u0431\u043e\u043b\u044c\u0448 \u0432\u0430 \u045e\u0447\u044b\u043d\u043a\u0430\u0445 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435 (\u043f\u0430\u0440. 1 \u042f\u043d 3, 18). \u0422\u0430\u043c\u0443 \u043c\u044b \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0411\u043e\u0433\u0430 \u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0410\u0439\u0446\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u042f\u0433\u043e \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430, \u0431\u043e \u0401\u043d \u0441\u0432\u044f\u0442\u044b, \u044f\u043a \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: \u00ab\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0431\u043e \u0401\u043d \u0441\u0432\u044f\u0442\u044b\u00bb (\u043f\u0430\u0440. \u041b\u0435\u0432 11, 44). \u041c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e, \u0431\u043e \u0401\u043d \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043b\u044e\u0431\u043e\u045e\u044e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u042f\u043d\u0430: \u00ab\u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u043b\u044e\u0431\u043e\u045e\u00bb (1 \u042f\u043d 4, 8); \u043f\u0440\u0430\u0437 \u0434\u0430\u0431\u0440\u044b\u043d\u044e \u0456 \u043f\u0440\u0430\u045e\u0434\u0443, \u0431\u043e \u0401\u043d \u0434\u043e\u0431\u0440\u044b \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b. \u041d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u043d\u0435\u0439\u043a\u0456 \u0456\u043d\u0448\u044b \u0432\u043e\u0431\u0440\u0430\u0437. \u0422\u043e\u0439, \u0445\u0442\u043e \u0433\u0432\u0430\u043b\u0442\u043e\u045e\u043d\u044b, \u0433\u043d\u044f\u045e\u043b\u0456\u0432\u044b, \u0433\u0430\u043d\u0430\u0440\u043b\u0456\u0432\u044b, \u043b\u044e\u0431\u0456\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u0442\u044b\u0440\u0430\u043d\u0430.<\/span><\/p>\r\n<p style=\"text-indent: 36pt; text-align: justify;\"><span>\u041d\u0435 \u0441\u0442\u0432\u0430\u0440\u0430\u0439\u0446\u0435 \u045e \u0441\u0430\u0431\u0435 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0442\u044b\u0440\u0430\u043d\u0430. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0430\u043c \u043c\u0430\u043b\u044e\u0435 \u045e \u043d\u0430\u0441 \u0441\u0432\u043e\u0439 \u0432\u043e\u0431\u0440\u0430\u0437, \u043a\u0430\u0436\u0443\u0447\u044b: \u00ab\u0421\u043f\u0430\u043a\u043e\u0439 \u043f\u0430\u043a\u0456\u0434\u0430\u044e \u0432\u0430\u043c, \u0441\u043f\u0430\u043a\u043e\u0439 \u041c\u043e\u0439 \u0434\u0430\u044e \u0432\u0430\u043c\u00bb (\u042f\u043d 14, 27). \u0410\u043b\u0435 \u043d\u0430\u0432\u043e\u0448\u0442\u0430 \u0432\u0435\u0434\u0430\u0446\u044c, \u0448\u0442\u043e \u0441\u043f\u0430\u043a\u043e\u0439 \u2013 \u0433\u044d\u0442\u0430 \u0434\u043e\u0431\u0440\u0430\u044f \u0440\u044d\u0447, \u043a\u0430\u043b\u0456 \u044f\u0433\u043e \u0434\u043e\u0431\u0440\u0430 \u043d\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c? \u0422\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u0435, \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u0431\u044b\u0432\u0430\u0435 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u044b\u043c, \u0430 \u045e\u0441\u0451 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0430\u0441\u0446\u044f\u0440\u043e\u0436\u043d\u0430\u0441\u0446\u0456 \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0439 \u0430\u043f\u0435\u043a\u0456. \u0412\u0435\u043b\u044c\u043c\u0456 \u0441\u043b\u0430\u0431\u044b\u043c \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0433\u0456\u043d\u0435 \u0430\u0434 \u043d\u0435\u0440\u0430\u0437\u0432\u0430\u0436\u043b\u0456\u0432\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e \u0446\u0456 \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0430\u0439 \u043a\u0440\u044b\u045e\u0434\u044b \u0431\u0440\u0430\u0442\u0430. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441, \u043d\u0456\u0448\u0442\u043e \u0442\u0430\u043a \u043d\u0435 \u0437\u0432\u0430\u0431\u043b\u0456\u0432\u0430\u0435 \u043b\u044e\u0434\u0437\u0435\u0439 \u044f\u043a \u0440\u0430\u0437\u043c\u043e\u0432\u044b \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u0456\u043d\u0448\u044b\u0445, \u0443\u043c\u044f\u0448\u0430\u043d\u043d\u0435 \u045e \u0447\u0443\u0436\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0443\u0441\u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u045e, \u0430\u0431\u0433\u0430\u0432\u043e\u0440\u0432\u0430\u043d\u043d\u0435 \u0430\u0434\u0441\u0443\u0442\u043d\u044b\u0445. \u0422\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: \u00ab\u041f\u0430\u043d \u0411\u043e\u0433 \u0434\u0430\u045e \u043c\u043d\u0435 \u043c\u043e\u0432\u0443 \u043c\u0443\u0434\u0440\u044b\u0445, \u043a\u0430\u0431 \u044f \u0432\u0435\u0434\u0430\u045e, \u044f\u043a \u0441\u043b\u043e\u0432\u0430\u043c \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0437\u043d\u044f\u0441\u0456\u043b\u0435\u043d\u0430\u0433\u0430\u00bb (\u0406\u0441 50, 4), \u043d\u044f\u0445\u0430\u0439 \u043c\u0430\u045e\u0447\u0430\u0446\u044c; \u0430 \u043a\u0430\u043b\u0456 \u0448\u0442\u043e\u0441\u044c\u0446\u0456 \u043a\u0430\u0436\u0443\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0441\u043b\u043e\u0432\u0430 \u0441\u043f\u0430\u043a\u043e\u044e.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"> <\/span><span style=\"color: #ff0000;\">\u041b\u043a 6, 47-48a; \u0421\u0456\u0440 25, 10. 11\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u041c\u044f\u043d\u0435, \u0441\u043b\u0443\u0445\u0430\u0435 \u041c\u0430\u0451 \u0441\u043b\u043e\u0432\u0430 \u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u044f\u0433\u043e.<\/span><span style=\"color: #ff0000;\"> * <\/span><span>\u0401\u043d \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456, \u0431\u0443\u0434\u0443\u044e\u0447\u044b \u0434\u043e\u043c, \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u0432\u044b\u043a\u0430\u043f\u0430\u045e \u0456 \u0437\u0430\u043a\u043b\u0430\u045e \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a \u043d\u0430 \u0441\u043a\u0430\u043b\u0435.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0431\u0430\u0456\u0446\u0446\u0430 \u041f\u0430\u043d\u0430; \u0431\u043e\u044f\u0437\u044c \u041f\u0430\u043d\u0430 \u045e\u0441\u0451 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u0456 \u043a\u0430\u0433\u043e \u043c\u043e\u0436\u043d\u0430 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u0446\u044c \u0437 \u0442\u044b\u043c, \u0445\u0442\u043e \u044f\u0435 \u043c\u0430\u0435? <\/span><span style=\"color: #ff0000;\">\u041d. <\/span><span>\u0401\u043d \u043f\u0430\u0434\u043e\u0431\u043d\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"826","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041f\u0430\u045e\u043b\u0430 \u041b\u0435-\u0411\u0430\u043e-\u0426\u0456\u043d\u0445\u0430&nbsp;<\/span><\/p>\r\n<p><span>\u0441\u0435\u043c\u0456\u043d\u0430\u0440\u044b\u0441\u0442\u0430\u043c \u041a\u0435-\u0412\u0456\u043d\u0445, \u0432\u044b\u0441\u043b\u0430\u043d\u044b \u045e 1843 \u0433.<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(A. Launay, Le clerg\u00e9 tonkinois et ses pr\u00eatres martyrs, MEP, Paris 1925, pp. 80-83)<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u0423\u0434\u0437\u0435\u043b \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0443 \u043f\u0435\u0440\u0430\u043c\u043e\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u042f, \u041f\u0430\u0432\u0435\u043b, \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b \u0437\u0430 \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0445\u0430\u0447\u0443 \u0430\u043f\u0456\u0441\u0430\u0446\u044c \u0432\u0430\u043c \u0441\u0432\u0430\u0451 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u044e, \u043a\u0430\u0431 \u0432\u044b, \u043f\u0430\u043b\u0430\u044e\u0447\u044b \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430 \u0411\u043e\u0433\u0430, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u042f\u0433\u043e \u0437\u0430 \u043c\u044f\u043d\u0435, \u00ab\u0431\u043e \u043d\u0430\u0432\u0435\u043a\u0456 \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c\u00bb (\u041f\u0441 136 [135]), 3). \u0413\u044d\u0442\u0430\u044f \u0432\u044f\u0437\u043d\u0456\u0446\u0430 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u043c \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u043f\u0435\u043a\u043b\u0430: \u0434\u0430 \u0440\u043e\u0437\u043d\u044b\u0445 \u0436\u0430\u0445\u043b\u0456\u0432\u044b\u0445 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e, \u0442\u0430\u043a\u0456\u0445 \u044f\u043a \u043a\u0430\u0439\u0434\u0430\u043d\u044b, \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u044f \u043b\u0430\u043d\u0446\u0443\u0433\u0456 \u0456 \u043f\u0443\u0442\u044b, \u0434\u0430\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c, \u043f\u043e\u043c\u0441\u0442\u0430, \u0437\u043d\u044f\u0432\u0430\u0433\u0456, \u0437\u043b\u0430\u0441\u043b\u043e\u045e\u0435, \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456, \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u044b\u044f \u043f\u0440\u044b\u0441\u044f\u0433\u0456, \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u044b, \u0456 \u045e \u0434\u0430\u0434\u0430\u0442\u0430\u043a \u0442\u0440\u044b\u0432\u043e\u0433\u0430 \u0456 \u0441\u043c\u0443\u0442\u0430\u043a. \u0411\u043e\u0433, \u044f\u043a\u0456 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0442\u0440\u043e\u0445 \u044e\u043d\u0430\u043a\u043e\u045e \u0437 \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u0430\u0439 \u043f\u0435\u0447\u044b, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u0430 \u043c\u043d\u043e\u044e. \u0401\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043c\u044f\u043d\u0435 \u0430\u0434 \u0433\u044d\u0442\u044b\u0445 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e \u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u045e \u0456\u0445 \u0443 \u0441\u043b\u043e\u0434\u044b\u0447, \u00ab\u0431\u043e \u043d\u0430\u0432\u0435\u043a\u0456 \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0421\u044f\u0440\u043e\u0434 \u0433\u044d\u0442\u044b\u0445 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e, \u044f\u043a\u0456\u044f \u0456\u043d\u0448\u044b\u0445 \u043f\u0430\u043b\u043e\u0445\u0430\u044e\u0446\u044c, \u044f, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u043b\u0430\u0441\u0446\u044b, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044e, \u0431\u043e \u044f \u043d\u0435 \u0441\u0430\u043c\u043e\u0442\u043d\u044b, \u0441\u0430 \u043c\u043d\u043e\u044e \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041d\u0430\u0448 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a \u0441\u0430\u043c \u043d\u044f\u0441\u0435 \u045e\u0432\u0435\u0441\u044c \u0446\u044f\u0436\u0430\u0440 \u043a\u0440\u044b\u0436\u0430, \u0430 \u043c\u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u044f\u0433\u043e \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0443\u044e \u0456 \u043d\u044f\u0437\u043d\u0430\u0447\u043d\u0443\u044e \u0447\u0430\u0441\u0442\u043a\u0443. \u0401\u043d \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0433\u043b\u044f\u0434\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u043c\u0430\u044e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0443, \u0430\u043b\u0435 \u0441\u0430\u043c \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0456 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0435, \u0456 \u045e\u0441\u0451 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0435 \u0434\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u043a\u0430\u043d\u0446\u0430. \u0422\u0430\u043c\u0443 \u043d\u0430 \u042f\u0433\u043e \u0433\u0430\u043b\u0430\u0432\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0432\u044f\u043d\u043e\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456, \u0430 \u045e \u042f\u0433\u043e \u0445\u0432\u0430\u043b\u0435 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u044e\u0446\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u042f\u0433\u043e \u0447\u043b\u0435\u043d\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u042f\u043a \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u0446\u044c \u0433\u044d\u0442\u0430\u0435 \u0432\u0456\u0434\u043e\u0432\u0456\u0448\u0447\u0430, \u0431\u0430\u0447\u0443\u0447\u044b \u043a\u043e\u0436\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0456\u043c\u043f\u0435\u0440\u0430\u0442\u0430\u0440\u0430\u045e, \u0456\u0445 \u043c\u0456\u043d\u0456\u0441\u0442\u0440\u0430\u045e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u0445 \u043f\u0430\u043c\u0430\u0433\u0430\u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u044e\u0446\u044c \u0422\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043e\u0435 \u0456\u043c\u044f, \u041f\u0430\u043d\u0435, \u00ab\u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0456\u0448 \u043d\u0430 \u0445\u0435\u0440\u0443\u0431\u0456\u043c\u0430\u0445\u00bb (\u041f\u0441 80 [79]), 2) \u0456 \u0441\u0435\u0440\u0430\u0444\u0456\u043c\u0430\u0445? \u041a\u0440\u044b\u0436 \u0422\u0432\u043e\u0439 \u0442\u043e\u043f\u0447\u0443\u0446\u044c \u043d\u043e\u0433\u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e! \u0414\u0437\u0435 \u0422\u0432\u0430\u044f \u0445\u0432\u0430\u043b\u0430? \u041a\u0430\u043b\u0456 \u0431\u0430\u0447\u0443 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430, \u043f\u0430\u043b\u0430\u044e\u0447\u044b \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430 \u0426\u044f\u0431\u0435, \u043f\u0440\u0430\u0433\u043d\u0443, \u043f\u0430\u0441\u043b\u044f \u0430\u0434\u0441\u044f\u0447\u044d\u043d\u043d\u044f \u0447\u043b\u0435\u043d\u0430\u045e, \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0434\u0437\u0435\u043b\u044f \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u0430\u0431 \u0422\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041f\u0440\u0430\u044f\u0432\u0456, \u041f\u0430\u043d\u0435, \u0441\u0432\u0430\u044e \u043c\u043e\u0446, \u0437\u0430\u0445\u0430\u0432\u0430\u0439 \u043c\u044f\u043d\u0435 \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0439, \u043a\u0430\u0431 \u043c\u043e\u0446 \u0432\u044b\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u045e \u043c\u0430\u0451\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043b\u0430\u0441\u044f \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u043a\u0430\u0431 \u0422\u0432\u0430\u0435 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u0456 \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u043f\u044b\u0445\u043b\u0456\u0432\u0430 \u043f\u0430\u0434\u043d\u044f\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u0433\u0430\u043b\u0430\u0432\u044b, \u043a\u0430\u043b\u0456 \u044f \u043f\u0430\u0445\u0456\u0441\u043d\u0443\u0441\u044f \u045e \u0434\u0430\u0440\u043e\u0437\u0435.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041d\u0430\u0439\u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0447\u0443\u044e\u0447\u044b \u045e\u0441\u0451 \u0433\u044d\u0442\u0430, \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0434\u0437\u044f\u043a\u0443\u0439\u0446\u0435 \u0411\u043e\u0433\u0443, \u0430\u0434 \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0435 \u0434\u0430\u0431\u0440\u043e, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u0435 \u0441\u0430 \u043c\u043d\u043e\u044e \u041f\u0430\u043d\u0430, \u00ab\u0431\u043e \u043d\u0430\u0432\u0435\u043a\u0456 \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c\u00bb (\u041f\u0441 136 [135]), 3). \u041d\u044f\u0445\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u0430\u0435 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u041f\u0430\u043d\u0430, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0434\u0443\u0445 \u043c\u043e\u0439 \u0443 \u043c\u0430\u0456\u043c \u0411\u043e\u0433\u0443, \u0431\u043e \u0433\u043b\u044f\u043d\u0443\u045e \u043d\u0430 \u043f\u0430\u043a\u043e\u0440\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u043b\u0443\u0433\u0456 \u0456 \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u045e\u0441\u0435 \u0431\u0443\u0434\u0443\u0447\u044b\u044f \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u043c\u044f\u043d\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u043c, \u00ab\u0431\u043e \u043d\u0430\u0432\u0435\u043a\u0456 \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u00ab\u0425\u0432\u0430\u043b\u0456\u0446\u0435 \u041f\u0430\u043d\u0430, \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u042f\u0433\u043e, \u0443\u0441\u0435 \u043f\u043b\u044f\u043c\u0451\u043d\u044b\u00bb (\u041f\u0441 117 [116]), 1), \u0431\u043e \u0432\u044b\u0431\u0440\u0430\u045e \u0411\u043e\u0433 \u0441\u043b\u0430\u0431\u043e\u0435 \u0441\u0432\u0435\u0442\u0443, \u043a\u0430\u0431 \u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u044c \u043c\u043e\u0446\u043d\u044b\u0445 \u0456 \u0431\u044f\u0437\u0440\u043e\u0434\u043d\u0430\u0435 \u0441\u0432\u0435\u0442\u0443, \u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u043d\u0430\u0435 \u0432\u044b\u0431\u0440\u0430\u045e \u0411\u043e\u0433, \u043a\u0430\u0431 \u0430\u0441\u0430\u0440\u043e\u043c\u0456\u0446\u044c \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u0430\u0435 (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 1, 27). \u041f\u0440\u0430\u0437 \u043c\u0430\u0435 \u0432\u0443\u0441\u043d\u044b \u0456 \u043c\u043e\u0439 \u0440\u043e\u0437\u0443\u043c \u0430\u0441\u0430\u0440\u043e\u043c\u0456\u045e \u0444\u0456\u043b\u043e\u0441\u0430\u0444\u0430\u045e, \u044f\u043a\u0456\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0432\u0443\u0447\u043d\u044f\u043c\u0456 \u043c\u0443\u0434\u0440\u044b\u0445 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u00ab\u0431\u043e \u043d\u0430\u0432\u0435\u043a\u0456 \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c\u00bb.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041f\u0456\u0448\u0443 \u0432\u0430\u043c \u0443\u0441\u0451 \u0433\u044d\u0442\u0430, \u043a\u0430\u0431 \u0437\u2019\u044f\u0434\u043d\u0430\u043b\u0430\u0441\u044f \u0432\u0430\u0448\u0430\u044f \u0432\u0435\u0440\u0430 \u0456 \u043c\u0430\u044f. \u0421\u044f\u0440\u043e\u0434 \u0433\u044d\u0442\u0430\u0439 \u0431\u0443\u0440\u044b \u0430\u0436 \u043b\u044f \u0442\u0440\u043e\u043d\u0430 \u0411\u043e\u0433\u0430 \u044f \u043a\u0456\u0434\u0430\u044e \u044f\u043a\u0430\u0440, \u0436\u044b\u0432\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e, \u044f\u043a\u0430\u044f \u0436\u044b\u0432\u0435 \u045e \u043c\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0410 \u0432\u044b, \u043d\u0430\u0439\u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0442\u0430\u043a \u0431\u044f\u0436\u044b\u0446\u0435, \u043a\u0430\u0431 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u044f\u043d\u043e\u043a (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 9, 24), \u0430\u0434\u0437\u0435\u043d\u044c\u0446\u0435 \u043f\u0430\u043d\u0446\u044b\u0440 \u0432\u0435\u0440\u044b \u0456 \u043b\u044e\u0431\u043e\u0432\u0456 (\u043f\u0430\u0440. 1 \u0422\u044d\u0441 5, 8) \u0456 \u0432\u0430\u0437\u044c\u043c\u0456\u0446\u0435 \u0437\u0431\u0440\u043e\u044e \u0425\u0440\u044b\u0441\u0442\u0430 \u045e \u043f\u0440\u0430\u0432\u0443\u044e \u0456 \u043b\u0435\u0432\u0443\u044e \u0440\u0443\u043a\u0443 (\u043f\u0430\u0440. 2 \u041a\u0430\u0440 6, 7), \u044f\u043a \u0432\u0443\u0447\u044b\u045e \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, \u043c\u043e\u0439 \u0430\u043f\u044f\u043a\u0443\u043d. \u041b\u0435\u043f\u0448 \u0432\u0430\u043c \u0437 \u0430\u0434\u043d\u044b\u043c \u0432\u043e\u043a\u0430\u043c \u0430\u0431\u043e \u0431\u0435\u0437 \u0447\u043b\u0435\u043d\u0430\u045e \u0443\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0436\u044b\u0446\u0446\u0451, \u0447\u044b\u043c \u0437 \u0443\u0441\u0456\u043c\u0456 \u0447\u043b\u0435\u043d\u0430\u043c\u0456 \u0431\u044b\u0446\u044c \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b\u043c\u0456.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0414\u0430\u043f\u0430\u043c\u0430\u0436\u044b\u0446\u0435 \u043c\u043d\u0435 \u0441\u0432\u0430\u0456\u043c\u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c\u0456, \u043a\u0430\u0431 \u044f \u043c\u043e\u0433 \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u043a\u043e\u043d\u0443 \u0456 \u0432\u0435\u0441\u0446\u0456 \u0434\u043e\u0431\u0440\u044b \u0431\u043e\u0439 \u0434\u0430 \u043a\u0430\u043d\u0446\u0430 (\u043f\u0430\u0440. \u041c\u0446 18, 8-9), \u043a\u0430\u0431 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430 \u0437\u0430\u043a\u043e\u043d\u0447\u044b\u045e \u0441\u0432\u043e\u0439 \u0431\u0435\u0433; \u043a\u0430\u043b\u0456 \u045e\u0436\u043e \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u043c\u0441\u044f \u045e \u0433\u044d\u0442\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u0443 \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0441\u0432\u0435\u0446\u0435 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u043a\u0430\u043b\u0456, \u0441\u0442\u043e\u044f\u0447\u044b \u043b\u044f \u0442\u0440\u043e\u043d\u0430 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0433\u0430 \u0411\u0430\u0440\u0430\u043d\u043a\u0430, \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430\u043b\u043e\u0441\u043d\u0430 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0443, \u0440\u0430\u0434\u0443\u044e\u0447\u044b\u0441\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0437\u0435 \u043d\u0430\u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439<\/span><span style=\"color: #ff00ff;\"> <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\"> \u0413\u0431\u0440 12, 1-3\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0411\u0443\u0434\u0437\u0435\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0431\u0435\u0433\u0447\u044b \u045e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u043c \u0434\u043b\u044f \u043d\u0430\u0441 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456, <\/span><span style=\"color: #ff0000;\">*<\/span><span style=\"color: #ff00ff;\"> <\/span><span>\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u043f\u0430\u0447\u044b\u043d\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0456 \u0437\u0430\u0432\u044f\u0440\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0432\u0435\u0440\u044b.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u041f\u0430\u0434\u0443\u043c\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0432\u044b\u0442\u0440\u044b\u0432\u0430\u045e \u0442\u0430\u043a\u0456 \u0437\u0434\u0437\u0435\u043a \u043d\u0430\u0434 \u0441\u0430\u0431\u043e\u044e \u0430\u0434 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e, \u043a\u0430\u0431 \u043d\u0435 \u0437\u043d\u0435\u043c\u0430\u0433\u043b\u0456\u0441\u044f \u0432\u044b \u045e \u0441\u0432\u0430\u0456\u0445 \u0434\u0443\u0448\u0430\u0445 \u0456 \u043d\u0435 \u0430\u0441\u043b\u0430\u0431\u043b\u0456. <\/span><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0413\u043b\u0435\u0434\u0437\u044f\u0447\u044b.<\/span><\/p>\r\n"}, {"GCH_CH_2_ID":"827","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0440\u0443\u0433\u043e\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435<\/span><\/p>\r\n<p><span>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0426\u044d\u0437\u0430\u0440\u044b\u044f \u0410\u0440\u043b\u044c\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 159, 1. 3-6: CCL 104, 650. 652-654)&nbsp;<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000; font-style: italic;\">\u042f\u043a \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0417\u0434\u0430\u0435\u0446\u0446\u0430 \u0441\u043a\u043b\u0430\u0434\u0430\u043d\u044b\u043c, \u043d\u0430\u0439\u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u044f \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0446\u044f\u0436\u043a\u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u041f\u0430\u043d \u0443 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456, \u043a\u0430\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u043f\u0430\u0439\u0441\u0446\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e, \u043d\u044f\u0445\u0430\u0439 \u0430\u0434\u0440\u0430\u0447\u044d\u0446\u0446\u0430 \u0430\u0434 \u0441\u044f\u0431\u0435\u00bb (\u041c\u0446 16, 24). \u0410\u043b\u0435 \u043d\u0435 \u0437\u2019\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0446\u044f\u0436\u043a\u0456\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u043a\u0430\u043b\u0456 \u0401\u043d \u0441\u0430\u043c \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u045e \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0456 \u0433\u044d\u0442\u0430\u0433\u0430.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041d\u044f\u0445\u0430\u0439 \u0430\u0434\u0440\u0430\u0447\u044d\u0446\u0446\u0430 \u0456 \u0432\u043e\u0437\u044c\u043c\u0435 \u043a\u0440\u044b\u0436 \u0434\u044b \u0456\u0434\u0437\u0435 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u0410 \u043a\u0443\u0434\u044b \u0442\u0440\u044d\u0431\u0430 \u0456\u0441\u0446\u0456 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0442\u0443\u0434\u044b, \u0430\u0434\u043a\u0443\u043b\u044c \u0432\u044b\u0439\u0448\u0430\u045e? \u041c\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0401\u043d \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0456 \u045e\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430, \u0442\u0430\u043c\u0443 \u0442\u0443\u0434\u044b \u0442\u0440\u044d\u0431\u0430 \u0456\u0441\u0446\u0456. \u0422\u0440\u044d\u0431\u0430 \u0446\u0430\u043b\u043a\u0430\u043c \u0434\u0430\u0432\u0435\u0440\u044b\u0446\u0446\u0430, \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456 \u043d\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435\u0448\u0442\u0430 \u043c\u043e\u0436\u0430, \u0430\u043b\u0435 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a \u043d\u0430\u0434\u0437\u0435\u0456 \u2013 \u0433\u044d\u0442\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u0430. \u041d\u0435\u0431\u0430 \u0431\u044b\u043b\u043e \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u043d\u0430\u0441, \u043f\u0430\u043a\u0443\u043b\u044c \u0442\u0443\u0434\u044b \u045e\u0437\u044b\u0448\u043b\u0430 \u043d\u0430\u0448\u0430\u044f \u0413\u0430\u043b\u0430\u0432\u0430. \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u0447\u043b\u0435\u043d\u044b, \u0437\u2019\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u0437 \u0433\u044d\u0442\u0430\u0439 \u0413\u0430\u043b\u0430\u0432\u043e\u0439, \u0442\u043e \u0447\u0430\u043c\u0443 \u043c\u044b \u0433\u0443\u0431\u043b\u044f\u0435\u043c \u043d\u0430\u0434\u0437\u0435\u044e, \u0448\u0442\u043e \u0456 \u043c\u044b \u0442\u0430\u043c \u0431\u0443\u0434\u0437\u0435\u043c? \u0410\u0434\u043a\u0443\u043b\u044c \u0433\u044d\u0442\u0430\u0435 \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0435? \u0411\u043e \u0442\u0443\u0442, \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043c\u044b \u0446\u0435\u0440\u043f\u0456\u043c \u0430\u0434 \u0440\u043e\u0437\u043d\u044b\u0445 \u0441\u0442\u0440\u0430\u0445\u0430\u045e \u0456 \u043f\u0430\u043a\u0443\u0442\u0430\u045e. \u0406\u0434\u0437\u0451\u043c \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0442\u0443\u0434\u044b, \u0434\u0437\u0435 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0448\u0447\u0430\u0441\u0446\u044f, \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0441\u043f\u0430\u043a\u043e\u044e \u0456 \u0432\u043e\u043b\u044c\u043d\u0430\u044f \u0430\u0434 \u0442\u0443\u0440\u0431\u043e\u0442\u0430\u045e \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0410\u043b\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0456\u0441\u0446\u0456 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435, \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: \u00ab\u0425\u0442\u043e \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0406\u043c, \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0442\u0430\u043a, \u044f\u043a \u0401\u043d \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u045e\u00bb (1 \u042f\u043d 2, 6). \u0425\u043e\u0447\u0430\u0448 \u0456\u0441\u0446\u0456 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c? \u0411\u0443\u0434\u0437\u044c \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u045e \u0442\u044b\u043c, \u0443 \u0447\u044b\u043c \u0401\u043d \u0431\u044b\u045e \u043f\u0430\u043a\u043e\u0440\u043d\u044b: \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439 \u042f\u0433\u043e\u043d\u044b\u043c \u043f\u0440\u044b\u043d\u0456\u0436\u044d\u043d\u043d\u0435\u043c, \u043a\u0430\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0445\u043e\u0447\u0430\u0448 \u0431\u044b\u0446\u044c \u0443\u0437\u0432\u044b\u0448\u0430\u043d\u044b.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041d\u044f\u0440\u043e\u045e\u043d\u0430\u0439 \u0441\u0442\u0430\u043b\u0430 \u0434\u0430\u0440\u043e\u0433\u0430 \u043f\u0430\u0441\u043b\u044f \u0433\u0440\u0430\u0445\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0410\u043b\u0435 \u044f\u043d\u0430 \u045e\u0436\u043e \u0440\u043e\u045e\u043d\u0430\u044f \u0437 \u043c\u043e\u043c\u0430\u043d\u0442\u0443, \u043a\u0430\u043b\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043d\u0430 \u0451\u0439 \u0441\u0432\u0430\u0435 \u0441\u0442\u0443\u043f\u043d\u0456 \u0456 \u0441\u0430 \u0441\u0446\u0435\u0436\u043a\u0456, \u043f\u043e\u045e\u043d\u0430\u0439 \u043a\u0440\u0443\u0442\u044b\u0445 \u043f\u0430\u0432\u0430\u0440\u043e\u0442\u0430\u045e, \u0443\u0447\u044b\u043d\u0456\u045e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456 \u0433\u0430\u0441\u0446\u0456\u043d\u0435\u0446. \u041f\u0430 \u0433\u044d\u0442\u0430\u0439 \u0434\u0430\u0440\u043e\u0437\u0435 \u043c\u043e\u0436\u043d\u0430 \u0431\u0435\u0433\u0447\u044b \u0430\u0431\u0435\u0434\u0437\u0432\u044e\u043c\u0430 \u043d\u0430\u0433\u0430\u043c\u0456, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0456 \u043b\u044e\u0431\u043e\u045e\u044e. \u042f\u0435 \u043f\u0430\u043a\u0440\u0443\u0447\u0430\u0441\u0442\u0430\u0441\u0446\u044c \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u0435 \u045e\u0441\u0456\u0445, \u0430\u043b\u0435 \u043f\u0435\u0440\u0448\u044b\u043c \u043a\u0440\u043e\u043a\u0430\u043c \u043d\u0430 \u0451\u0439 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0441\u0442\u0430\u0446\u044c \u043f\u0430\u043a\u043e\u0440\u0430. \u0427\u0430\u043c\u0443 \u0432\u044b\u0446\u044f\u0433\u0432\u0430\u0435\u0448 \u0441\u0442\u0443\u043f\u043d\u044e \u0434\u0430\u043b\u0435\u0439, \u0447\u044b\u043c \u043c\u043e\u0436\u0430\u0448? \u0425\u043e\u0447\u0430\u0448 \u0445\u0443\u0442\u0447\u044d\u0439 \u0443\u043f\u0430\u0441\u0446\u0456, \u0447\u044b\u043c \u043f\u0430\u0434\u044b\u043c\u0430\u0446\u0446\u0430 \u045e\u0433\u0430\u0440\u0443. \u041f\u0430\u0447\u043d\u0456 \u0437 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u043a\u0440\u043e\u043a\u0443, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0437 \u043f\u0430\u043a\u043e\u0440\u044b, \u0456 \u045e\u0431\u0430\u0447\u044b\u0448, \u0448\u0442\u043e \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0442\u044b \u045e\u0436\u043e \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u045e\u0433\u0430\u0440\u0443.&nbsp;<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u0422\u0430\u043c\u0443 \u043d\u0430\u0448 \u041f\u0430\u043d \u0456 \u0417\u0431\u0430\u045e\u0446\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: \u00ab\u041d\u044f\u0445\u0430\u0439 \u0430\u0434\u0440\u0430\u0447\u044d\u0446\u0446\u0430 \u0430\u0434 \u0441\u044f\u0431\u0435\u00bb, \u0430\u043b\u0435 \u0434\u0430\u0434\u0430\u045e: \u00ab\u041d\u044f\u0445\u0430\u0439 \u0432\u043e\u0437\u044c\u043c\u0435 \u043a\u0440\u044b\u0436 \u0441\u0432\u043e\u0439 \u0456 \u0456\u0434\u0437\u0435 \u0437\u0430 \u041c\u043d\u043e\u044e\u00bb (\u041c\u0446 16, 24). \u0428\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435: \u00ab\u041d\u044f\u0445\u0430\u0439 \u0432\u043e\u0437\u044c\u043c\u0435 \u043a\u0440\u044b\u0436 \u0441\u0432\u043e\u0439\u00bb? \u041d\u044f\u0445\u0430\u0439 \u043d\u044f\u0441\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435\u0432\u044b\u0433\u043e\u0434\u043d\u0430\u0435, \u0456 \u0442\u0430\u043a \u043d\u044f\u0445\u0430\u0439 \u0456\u0434\u0437\u0435 \u0437\u0430 \u041c\u043d\u043e\u044e. \u041a\u0430\u043b\u0456 \u043f\u0430\u0447\u043d\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u041c\u044f\u043d\u0435 \u045e \u0441\u043f\u043e\u0441\u0430\u0431\u0435 \u0436\u044b\u0446\u0446\u044f \u0456 \u045e \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456 \u041c\u0430\u0456\u043c \u043d\u0430\u043a\u0430\u0437\u0430\u043c, \u043f\u0440\u044b\u0434\u0431\u0430\u0435 \u0448\u043c\u0430\u0442 \u0432\u043e\u0440\u0430\u0433\u0430\u045e. \u041c\u043d\u043e\u0433\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u0433\u043e \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c, \u0456 \u0437\u0432\u0435\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u044f\u0433\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0441\u043c\u0435\u0448\u043d\u0456\u043a\u0456, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0433\u0430\u043d\u0456\u0446\u0435\u043b\u0456. \u0406 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u043f\u0430-\u0437\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0442\u044b\u0445, \u044f\u043a\u0456\u044f, \u2013 \u044f\u043a \u0432\u044b\u0434\u0430\u0435\u0446\u0446\u0430, \u2013 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u045e \u0446\u0435\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0434\u043d\u0430\u043a \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u0430\u0441\u0446\u0456 \u045e \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u0445 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u043f\u0430-\u0437\u0430 \u0456\u043c. \u0406 \u0445\u043e\u0446\u044c \u0433\u0430\u043d\u0430\u0440\u0430\u0446\u0446\u0430 \u043f\u0440\u044b\u043d\u0430\u043b\u0435\u0436\u043d\u0430\u0441\u0446\u044e \u0434\u0430 \u0442\u043e\u0439 \u0441\u0430\u043c\u0430\u0439 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0432\u0435\u0440\u044b, \u0430\u0434\u043d\u0430\u043a \u043f\u0430\u0441\u0442\u0430\u044f\u043d\u043d\u0430 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c \u0440\u0443\u043f\u043b\u0456\u0432\u044b\u0445 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e. \u041f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0442\u0430\u043a\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0441\u044f\u0440\u043e\u0434 \u0447\u043b\u0435\u043d\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u044f \u0434\u0430 \u0434\u0443\u0440\u043d\u043e\u0439 \u043a\u0440\u044b\u0432\u0456 \u045e \u0430\u0440\u0433\u0430\u043d\u0456\u0437\u043c\u0435. \u0422\u044b \u0436, \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448 \u0456\u0441\u0446\u0456 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u043d\u0435 \u045e\u0445\u0456\u043b\u044f\u0439\u0441\u044f \u0430\u0434 \u043d\u044f\u0441\u0435\u043d\u043d\u044f \u042f\u0433\u043e \u043a\u0440\u044b\u0436\u0430, \u0437\u043d\u043e\u0441\u044c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0437\u043b\u0430\u0441\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043a\u0440\u044b\u0432\u0430\u0434\u0443\u0448\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u043d\u0435 \u043f\u0430\u0434\u0430\u0439.<\/span><\/p>\r\n<p style=\"text-indent: 21.3pt; text-align: justify;\"><span>\u041a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u043c \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u043d\u0430\u043a\u0430\u0437 \u041f\u0430\u043d\u0430: \u00ab\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u043f\u0430\u0439\u0441\u0446\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e, \u043d\u044f\u0445\u0430\u0439 \u0430\u0434\u0440\u0430\u0447\u044d\u0446\u0446\u0430 \u0430\u0434 \u0441\u044f\u0431\u0435, \u0432\u043e\u0437\u044c\u043c\u0435 \u043a\u0440\u044b\u0436 \u0441\u0432\u043e\u0439 \u0456 \u0456\u0434\u0437\u0435 \u0437\u0430 \u041c\u043d\u043e\u044e\u00bb, \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0442\u0430\u0440\u0430\u0446\u0446\u0430, \u044f\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u044f\u0433\u043e \u0437 \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439. \u041c\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0437\u2019\u0435\u0441\u0446\u0456 \u0456 \u045e \u0448\u0442\u043e \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430, \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u043c\u0443, \u043a\u0430\u0431, \u0456\u0434\u0443\u0447\u044b \u0437\u0430 \u043f\u0440\u0430\u0433\u0430\u044e \u0431\u0430\u0433\u0430\u0446\u0446\u044f \u0456 \u0448\u0443\u043a\u0430\u044e\u0447\u044b \u043f\u0440\u0430\u0437\u043c\u0435\u0440\u043d\u0430\u0433\u0430 \u0437\u0430\u0431\u0435\u0441\u043f\u044f\u0447\u044d\u043d\u043d\u044f \u0437\u044f\u043c\u043d\u044b\u0445 \u043f\u0430\u0442\u0440\u044d\u0431\u0430\u045e, \u043c\u044b \u0432\u044b\u043f\u0430\u0434\u043a\u043e\u0432\u0430 \u043d\u0435 \u0442\u0440\u0430\u043f\u0456\u043b\u0456 \u045e \u0441\u043f\u0430\u043a\u0443\u0441\u0443 \u0456 \u043f\u0430\u0441\u0442\u043a\u0443 \u0434\u2019\u044f\u0431\u043b\u0430 \u0446\u0456 \u045e \u0448\u043c\u0430\u0442\u043b\u0456\u043a\u0456\u044f, \u0430\u043b\u0435 \u043f\u0443\u0441\u0442\u044b\u044f, \u0430 \u043d\u0430\u0432\u0430\u0442 \u0448\u043a\u043e\u0434\u043d\u044b\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456, \u044f\u043a\u0456\u044f \u043a\u0456\u0434\u0430\u044e\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0443 \u0437\u0433\u0430\u0440\u0448\u044d\u043d\u043d\u0435 \u0456 \u0437\u0433\u0443\u0431\u0443. \u041d\u044f\u0445\u0430\u0439 \u041f\u0430\u043d, \u043c\u0430\u044e\u0447\u044b \u043d\u0430\u0441 \u0443 \u0441\u0432\u0430\u0451\u0439 \u0430\u043f\u0435\u0446\u044b, \u043c\u0430\u0435 \u043b\u0430\u0441\u043a\u0443 \u0432\u044b\u0431\u0430\u0432\u0456\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u0433\u044d\u0442\u0430\u0439 \u0441\u043f\u0430\u043a\u0443\u0441\u044b.<\/span><\/p>\r\n<p>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u0439 <\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff00ff;\"><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span style=\"color: #ff0000;\">\u043f\u0430\u0440. \u041f\u0441<\/span><span style=\"color: #ff0000;\"> 4<\/span><span style=\"color: #ff0000;\">5 (44), 15-16. 5\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0412\u044f\u0434\u0443\u0446\u044c \u0437\u0430 \u0451\u0439 \u0434\u0430 \u041a\u0430\u0440\u0430\u043b\u044f \u0434\u0437\u044f\u045e\u0447\u0430\u0442, \u0441\u044f\u0431\u0440\u043e\u0432\u0430\u043a \u044f\u0435. <\/span><span style=\"color: #ff0000;\">* <\/span><span>\u0412\u044f\u0434\u0443\u0446\u044c \u0446\u044f\u0431\u0435 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u045e \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u0456.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.  <\/span><span>\u0412\u044b\u0439\u0434\u0437\u0456 \u045e \u0441\u0432\u0430\u0451\u0439 \u0430\u0437\u0434\u043e\u0431\u0435 \u0456 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u0456 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440, \u043d\u044f\u0445\u0430\u0439 \u0448\u0447\u0430\u0441\u0446\u0456\u0446\u044c \u0442\u0430\u0431\u0435. <\/span><span style=\"color: #ff0000;\">\u041d.  <\/span><span>\u0412\u044f\u0434\u0443\u0446\u044c.<\/span><\/p>"}, {"GCH_CH_2_ID":"903","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ep. 6, 1-2: CSEL 3, 480-482)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041a\u0430\u043b\u0456 \u043c\u044b \u0436\u0430\u0434\u0430\u0435\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435 \u041f\u0430\u043d\u0430\u043c,<\/span><\/em><br \/><em><span style=\"color: #ff0000;\">\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u0430 \u045e\u0441\u0456\u043c \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u042f\u0433\u043e<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0432\u0456\u0442\u0430\u044e \u0432\u0430\u0441, \u0436\u0430\u0434\u0430\u044e\u0447\u044b \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0432\u0430\u0441, \u043a\u0430\u043b\u0456 \u0431 \u0443\u043c\u043e\u0432\u044b \u043c\u0435\u0441\u0446\u0430, \u0434\u0437\u0435 \u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0443\u0441\u044f, \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u043b\u0456 \u0431 \u043c\u043d\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0456 \u0434\u0430 \u0432\u0430\u0441. \u0411\u043e \u0448\u0442\u043e \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0436\u0430\u0434\u0430\u043d\u0430\u0433\u0430 \u0456 \u0440\u0430\u0434\u0430\u0441\u043d\u0430\u0433\u0430 \u0434\u043b\u044f \u043c\u044f\u043d\u0435, \u0447\u044b\u043c \u0431\u044b\u0446\u044c \u0446\u044f\u043f\u0435\u0440 \u0440\u0430\u0437\u0430\u043c \u0437 \u0432\u0430\u043c\u0456? \u042f \u0445\u0430\u0446\u0435\u045e \u0431\u044b, \u043a\u0430\u0431 \u043c\u044f\u043d\u0435 \u0430\u0431\u043d\u044f\u043b\u0456 \u0432\u0430\u0448\u044b \u0447\u044b\u0441\u0442\u044b\u044f \u0456 \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u044b\u044f \u0440\u0443\u043a\u0456, \u044f\u043a\u0456\u044f \u0430\u0434\u043a\u0456\u043d\u0443\u043b\u0456 \u043a\u0430\u0448\u0447\u0443\u043d\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u0431\u043e \u0432\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u041f\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0433\u0430 \u0456 \u045e\u0437\u043d\u0451\u0441\u043b\u0430\u0433\u0430, \u0447\u044b\u043c \u043f\u0430\u0446\u0430\u043b\u0430\u0432\u0430\u0446\u044c \u0446\u044f\u043f\u0435\u0440 \u0432\u0430\u0448\u044b\u044f \u0432\u0443\u0441\u043d\u044b, \u044f\u043a\u0456\u044f \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0430 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u043b\u0456 \u041f\u0430\u043d\u0430, \u0447\u044b\u043c \u0430\u0441\u0430\u0431\u0456\u0441\u0442\u0430 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u0446\u0430 \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0448\u044b\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430, \u044f\u043a\u0456\u044f, \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u045e\u0448\u044b \u0441\u0432\u0435\u0442\u0430\u043c, \u0441\u0442\u0430\u043b\u0456 \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u0431\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u0430\u044f \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u043d\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043c\u043d\u0435, \u044f \u043f\u0430\u0441\u044b\u043b\u0430\u044e \u0432\u0430\u043c \u0441\u0432\u043e\u0439 \u043b\u0456\u0441\u0442, \u044f\u043a\u0456 \u0431\u0443\u0434\u0437\u0435 \u043c\u0430\u0456\u043c \u043d\u0430\u043c\u0435\u0441\u043d\u0456\u043a\u0430\u043c \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0448\u044b\u043c\u0456 \u0432\u0443\u0448\u0430\u043c\u0456 \u0456 \u0432\u0430\u0447\u044b\u043c\u0430. \u0423 \u0456\u043c \u044f \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u044e \u0441\u0432\u0430\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0430\u043d\u043d\u0435, \u043a\u0430\u0431 \u0432\u044b \u0446\u0432\u0451\u0440\u0434\u0430 \u0456 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u043b\u0456 \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u044f\u0431\u0435\u0441\u043d\u0443\u044e \u0441\u043b\u0430\u0432\u0443. \u0421\u0442\u0430\u045e\u0448\u044b \u043d\u0430 \u0411\u043e\u0436\u044b \u0448\u043b\u044f\u0445, \u0437 \u043c\u043e\u0446\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c \u0456\u043c\u043a\u043d\u0456\u0446\u0435\u0441\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u044f\u043d\u043e\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430\u045e, \u043c\u0430\u044e\u0447\u044b \u0430\u0431\u0430\u0440\u043e\u043d\u0446\u0443 \u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430 \u045e \u041f\u0430\u043d\u0443. \u0401\u043d \u043a\u0430\u0436\u0430: &laquo;\u0406 \u0432\u043e\u0441\u044c \u042f \u0437 \u0432\u0430\u043c\u0456 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0430\u0436 \u0434\u0430 \u0441\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u044f \u0432\u0435\u043a\u0443&raquo; (\u041c\u0446 28, 20).<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u0432\u044f\u0437\u043d\u0456\u0446\u0430, \u044f\u043a\u0443\u044e \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0432\u0430\u0448\u0430 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c! \u041e \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u0432\u044f\u0437\u043d\u0456\u0446\u0430, \u044f\u043a\u0430\u044f \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u043b\u044e\u0434\u0437\u0435\u0439 \u0411\u043e\u0436\u044b\u0445 \u0443 \u043d\u0435\u0431\u0430! \u041e \u0437\u043c\u0440\u043e\u043a, \u0441\u0432\u044f\u0442\u043b\u0435\u0439\u0448\u044b \u0437\u0430 \u0441\u0430\u043c\u043e \u0441\u043e\u043d\u0446\u0430 \u0456 \u044f\u0441\u043d\u0435\u0439\u0448\u044b \u0437\u0430 \u0434\u0437\u0451\u043d\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u0434\u0437\u0435 \u0446\u044f\u043f\u0435\u0440 \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u0411\u043e\u0436\u044b\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u0411\u043e\u0433\u0430 \u0447\u0430\u0441\u0442\u043a\u0456 \u0446\u0435\u043b\u0430 \u0432\u0430\u0448\u0430\u0433\u0430!<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u0447\u043e\u0433\u0430 \u0446\u044f\u043f\u0435\u0440 \u043d\u0435 \u0437\u0430\u0439\u043c\u0430\u0435 \u0432\u0430\u0448\u044b \u0441\u044d\u0440\u0446\u044b \u0456 \u0440\u043e\u0437\u0443\u043c, \u0430\u043a\u0440\u0430\u043c\u044f \u0411\u043e\u0436\u044b\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u043d\u0430\u043a\u0430\u0437\u0430\u045e, \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u044f\u043a\u0456\u0445 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043d\u0430\u0442\u0445\u043d\u044f\u045e \u0432\u0430\u0441 \u0434\u0430 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u045e \u043f\u0430\u043a\u0443\u0442\u0430\u0445. \u041d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0434\u0443\u043c\u0430\u0435 \u043d\u0435 \u043f\u0440\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0430 \u043f\u0440\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c; \u043d\u0435 \u043f\u0440\u0430 \u0447\u0430\u0441\u043e\u0432\u0430\u0435 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u0435, \u0430 \u043f\u0440\u0430 \u0432\u0435\u0447\u043d\u0443\u044e \u0441\u043b\u0430\u0432\u0443, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u041a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u042f\u0433\u043e\u043d\u044b\u0445&raquo; (\u043f\u0430\u0440. \u041f\u0441 116 [115], 15). \u0406 \u0437\u043d\u043e\u045e: &laquo;\u0410\u0445\u0432\u044f\u0440\u0430 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 &ndash; \u0434\u0443\u0445 \u043f\u0430\u043a\u043e\u0440\u043d\u044b, \u0441\u044d\u0440\u0446\u0430\u043c \u0437\u043b\u0430\u043c\u0430\u043d\u044b\u043c \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0422\u044b, \u0411\u043e\u0436\u0430, \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0435\u0448&raquo; (\u041f\u0441 51 [50], 19).<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u043f\u0430\u043a\u0443\u0442\u044b, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u044c \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0411\u043e\u0433\u0443, \u0430 \u0456\u0445 \u0441\u0430\u043c\u0456\u0445 \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u044c: &laquo;\u0425\u043e\u0446\u044c \u0443 \u0432\u0430\u0447\u0430\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u044f\u043d\u044b \u0437\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u044b\u043c\u0456, \u0456\u0445 \u043d\u0430\u0434\u0437\u0435\u044f \u043f\u043e\u045e\u043d\u0430\u044f \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456. \u0411\u0443\u0434\u0443\u0446\u044c \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456, \u0430 \u041f\u0430\u043d \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0434 \u0456\u043c\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456&raquo; (\u043f\u0430\u0440. \u041c\u0434\u0440 3, 4. 8).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0434\u0443\u043c\u0430\u0435\u0446\u0435 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u041f\u0430\u043d\u0430\u043c, \u0442\u0440\u044d\u0431\u0430 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u0456 \u0456 \u0437 \u0434\u0443\u043c\u043a\u0430\u0439 \u043f\u0440\u0430 \u044f\u0435 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456\u044f \u043f\u0430\u043a\u0443\u0442\u044b. \u0411\u043e \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0432\u0435\u0442\u0443 \u0442\u0430\u043a \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u0430, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0443 \u0433\u044d\u0442\u0430\u0439 \u0441\u0443\u0442\u044b\u0447\u0446\u044b \u0441\u0430 \u0441\u0432\u0435\u0442\u0430\u043c: \u0430\u0434\u0440\u0430\u0437\u0443 \u043d\u0430 \u0441\u0430\u043c\u044b\u043c \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0410\u0431\u044d\u043b\u044c, \u0430 \u043f\u0430\u0441\u043b\u044f &ndash; \u0456\u043d\u0448\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u044b\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043b\u044f \u045e\u0441\u0456\u0445 \u0456\u0445 \u041f\u0430\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c, \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0434\u0430 \u042f\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043c\u043e\u0433\u0443\u0446\u044c \u0434\u0430\u0439\u0441\u0446\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u043f\u0430 \u042f\u0433\u043e\u043d\u044b\u043c \u0448\u043b\u044f\u0445\u0443: &laquo;\u0425\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451, \u0437\u0430\u0433\u0443\u0431\u0456\u0446\u044c \u044f\u0433\u043e; \u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u0437\u0430\u0445\u0430\u0432\u0430\u0435 \u044f\u0433\u043e \u0434\u043b\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f&raquo; (\u043f\u0430\u0440. \u042f\u043d 12, 25). \u0406 \u0434\u0430\u043b\u0435\u0439: &laquo;\u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0430\u0431\u0456\u0432\u0430\u0435 \u0446\u0435\u043b\u0430, \u0434\u0443\u0448\u044b \u0436 \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0437\u0430\u0431\u0456\u0446\u044c; \u0430 \u0431\u043e\u043b\u044c\u0448 \u0431\u043e\u0439\u0446\u0435\u0441\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u043e\u0436\u0430 \u0456 \u0434\u0443\u0448\u0443, \u0456 \u0446\u0435\u043b\u0430 \u0437\u0430\u0433\u0443\u0431\u0456\u0446\u044c \u0443 \u0433\u0435\u0435\u043d\u0435&raquo; (\u041c\u0446 10, 28).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u043d\u0430\u043c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u043c\u044b \u0436\u0430\u0434\u0430\u0435\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435 \u041f\u0430\u043d\u0430\u043c, \u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u0430 \u045e\u0441\u0456\u043c \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u042f\u0433\u043e: &laquo;\u041c\u044b \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b \u0411\u043e\u0436\u044b\u044f, \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u0446\u0435\u0440\u043f\u0456\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c, \u043a\u0430\u0431 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0456 \u045e\u0441\u043b\u0430\u0432\u0456\u0446\u0446\u0430&raquo; (\u0420\u044b\u043c 8, 16-17).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u043c\u044b \u0431&rsquo;\u0435\u043c\u0441\u044f \u0456 \u0437\u043c\u0430\u0433\u0430\u0435\u043c\u0441\u044f \u0437\u0430 \u0432\u0435\u0440\u0443, \u043d\u0430 \u043d\u0430\u0441 \u0433\u043b\u044f\u0434\u0437\u044f\u0446\u044c \u0411\u043e\u0433, \u042f\u0433\u043e\u043d\u044b\u044f \u0430\u043d\u0451\u043b\u044b \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. <span style=\"color: #ff0000;\">*<\/span> \u0413\u044d\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 &ndash; \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u045e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0411\u043e\u0433\u0430 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u044f\u043d\u043e\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u044b \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430 \u0421\u0443\u0434\u0434\u0437\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0437\u0431\u0440\u043e\u0456\u043c\u0441\u044f \u0432\u0430 \u045e\u0441\u0435 \u043d\u0430\u0448\u044b \u0441\u0456\u043b\u044b \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0435\u043c\u0441\u044f \u0437 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430\u0439 \u0432\u0435\u0440\u0430\u0439 \u0456 \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u0434\u0430 \u0431\u043e\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0445\u0432\u0430\u043b\u0430 \u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435 &ndash; \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u045e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0411\u043e\u0433\u0430 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0432\u044f\u043d\u043e\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u044b \u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u0430 \u0421\u0443\u0434\u0434\u0437\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"904","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 329, In natali martyrum: PL 38, 1454-1456)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u0441\u043c\u0435\u0440\u0446\u044c \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u043d\u0430\u0431\u044b\u0442\u0430 \u0446\u0430\u043d\u043e\u044e \u0441\u043c\u0435\u0440\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0442\u0430\u043a\u0443\u044e \u0441\u043b\u0430\u045e\u043d\u0443\u044e \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u044e \u0441\u0432\u044f\u0442\u044b\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u043c\u0456 \u045e\u0441\u044e\u0434\u044b \u043a\u0432\u0456\u0442\u043d\u0435\u0435 \u041a\u0430\u0441\u0446\u0451\u043b, \u043c\u044b \u043d\u0430 \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0435\u043c\u0441\u044f \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0441\u0446\u0456 \u0441\u043b\u043e\u0432\u0430\u045e, \u044f\u043a\u0456\u044f \u0441\u043f\u044f\u0432\u0430\u0435\u043c: &laquo;\u041a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u0445&raquo; (\u041f\u0441 116 [115], 15). \u042f\u043d\u0430 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u0456 \u045e \u043d\u0430\u0448\u044b\u0445 \u0432\u0430\u0447\u0430\u0445, \u0456 \u045e \u0432\u0430\u0447\u0430\u0445 \u0442\u0430\u0433\u043e, \u0434\u0437\u0435\u043b\u044f \u0447\u044b\u0439\u0433\u043e \u0456\u043c\u044f \u0431\u044b\u043b\u0430 \u043f\u0440\u044b\u043d\u044f\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0441\u043c\u0435\u0440\u0446\u044c \u0433\u044d\u0442\u044b\u0445 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u043d\u0430\u0431\u044b\u0432\u0430\u0435 \u043a\u043e\u0448\u0442, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u043c\u0435\u0440\u0446\u0456 \u0430\u0434\u043d\u0430\u0433\u043e. \u041f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0430\u0431\u044b\u045e \u0441\u043c\u0435\u0440\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u0445, \u0456 \u043a\u0430\u043b\u0456 \u0431 \u0401\u043d \u043d\u0435 \u043f\u0430\u043c\u0451\u0440, \u0442\u043e \u043d\u0435 \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u043b\u0430\u0441\u044f \u0431 \u043f\u0448\u0430\u043d\u0456\u0447\u043d\u0430\u0435 \u0437\u0435\u0440\u043d\u0435. \u0412\u044b \u0447\u0443\u043b\u0456 \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u044b \u043d\u0430\u043f\u044f\u0440\u044d\u0434\u0430\u0434\u043d\u0456 \u041c\u0443\u043a\u0456: &laquo;\u041a\u0430\u043b\u0456 \u043f\u0448\u0430\u043d\u0456\u0447\u043d\u0430\u0435 \u0437\u0435\u0440\u043d\u0435, \u0443\u043f\u0430\u045e\u0448\u044b \u045e \u0437\u044f\u043c\u043b\u044e, \u043d\u0435 \u043f\u0430\u043c\u0440\u044d, \u0442\u043e \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u0430\u0434\u043d\u043e, \u0430 \u043a\u0430\u043b\u0456 \u043f\u0430\u043c\u0440\u044d, \u0442\u043e \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u0431\u0430\u0433\u0430\u0442\u044b \u043f\u043b\u0451\u043d&raquo; (\u042f\u043d 12, 24).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0432\u044f\u043b\u0456\u043a\u0456 \u0430\u0431\u043c\u0435\u043d, \u0442\u0430\u043c \u0430\u0434\u0447\u044b\u043d\u0456\u043b\u0430\u0441\u044f \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u0430, \u0443 \u044f\u043a\u043e\u0439 \u0431\u044b\u045e \u0432\u043e\u0434\u043a\u0443\u043f \u0437\u0430 \u043d\u0430\u0441, \u0456 \u043a\u0430\u043b\u0456 \u0436\u0430\u045e\u043d\u0435\u0440 \u043f\u0440\u0430\u0431\u0456\u045e \u042f\u0433\u043e\u043d\u044b \u0431\u043e\u043a, \u0430\u0434\u0442\u0443\u043b\u044c \u0437\u0430\u0431\u0440\u0443\u0456\u043b\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c \u0431\u044b\u043b\u0456 \u043d\u0430\u0431\u044b\u0442\u044b\u044f \u0432\u0435\u0440\u043d\u044b\u044f \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456, \u0430\u043b\u0435 \u0432\u0435\u0440\u0430 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0431\u044b\u043b\u0430 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u0430\u044f, \u0456 \u043a\u0440\u043e\u045e \u0433\u044d\u0442\u0430\u043c\u0443 \u0441\u0432\u0435\u0434\u043a\u0430. \u042f\u043d\u044b \u0432\u044f\u0440\u043d\u0443\u043b\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u0430 \u0456\u0445 \u0437\u0430\u043f\u043b\u0430\u0446\u0456\u043b\u0456, \u0456 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0456 \u0441\u043b\u043e\u0432\u044b \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u042f\u043d\u0430: &laquo;\u0401\u043d \u0430\u0434\u0434\u0430\u045e \u0437\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451. \u0406 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0431\u0440\u0430\u0442\u043e\u045e&raquo; (\u043f\u0430\u0440. 1 \u042f\u043d 3, 16).<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0441\u044f\u0434\u0430\u0435\u0448 \u0437\u0430 \u0432\u044f\u043b\u0456\u043a\u0456 \u0441\u0442\u043e\u043b, \u043f\u0456\u043b\u044c\u043d\u0430 \u0433\u043b\u044f\u0434\u0437\u0456, \u0448\u0442\u043e \u0441\u0442\u0430\u0432\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u0439, \u0431\u043e \u0456 \u0442\u044b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0442\u0430\u043a\u043e\u0435 \u0436 \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u0446\u044c&raquo; (\u043f\u0430\u0440. \u041f\u0440\u044b\u043f 23, 1). \u0421\u0442\u043e\u043b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0456, \u0430 \u0441\u0430\u043c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043d\u0430 \u0456\u043c \u043f\u0430\u0436\u044b\u0432\u0430\u0439. \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043a\u043e\u0440&shy;\u043c\u0456\u0446\u044c \u0431\u044f\u0441\u0435\u0434\u043d\u0456\u043a\u0430\u045e \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u043e\u0439 &ndash; \u0433\u044d\u0442\u0430 \u0440\u043e\u0431\u0456\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0401\u043d \u0437\u0430\u043f\u0440\u0430\u0448\u0430\u0435, \u0456 \u0401\u043d \u0441\u0430\u043c &ndash; \u0435\u0436\u0430 \u0456 \u043d\u0430\u043f\u043e\u0439. \u0417\u043d\u0430\u0447\u044b\u0446\u044c, \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043b\u0456 \u0456 \u043f\u0456\u043b\u0456, \u043a\u0430\u0431 \u0430\u0434\u0434\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0431\u044b \u044f\u043d\u044b \u043c\u0430\u0433\u043b\u0456 \u0442\u0430\u043a\u043e\u0435 \u0437\u0440\u0430\u0431\u0456\u0446\u044c, \u043a\u0430\u043b\u0456 \u0431 \u0456\u043c \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043d\u0435 \u0434\u0430\u045e \u0442\u043e\u0439, \u044f\u043a\u0456 \u043f\u0435\u0440\u0448\u044b \u0443\u0434\u0437\u044f\u043b\u0456\u045e \u0443\u0441\u0451? \u0428\u0442\u043e \u0436 \u043d\u0430\u043c \u0440\u0430\u0456\u0446\u044c \u043f\u0441\u0430\u043b\u044c\u043c, \u044f\u043a\u0456 \u043c\u044b \u0441\u043f\u044f\u0432\u0430\u0435\u043c? \u041a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u0445 (\u043f\u0430\u0440. \u041f\u0441 116 [115], 15).<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u044b\u043c \u043f\u0441\u0430\u043b\u044c\u043c\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u0434\u0443\u043c\u0430\u045e \u043d\u0430\u0434 \u0443\u0441\u0456\u043c, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0430\u0434 \u0411\u043e\u0433\u0430; \u0443\u0431\u0430\u0447\u044b\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0434\u0430\u0440\u044b \u043b\u0430\u0441\u043a\u0456 \u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u044f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e, \u044f\u043a\u0456 \u0448\u0443\u043a\u0430\u045e \u044f\u0433\u043e \u0433\u0440\u044d\u0448\u043d\u0430\u0433\u0430, \u0430 \u0437\u043d\u0430\u0439\u0448\u043e\u045e\u0448\u044b, \u0434\u0430\u0440\u0430\u0432\u0430\u045e \u044f\u043c\u0443 \u043f\u0440\u0430\u0432\u0456\u043d\u044b; \u044f\u043a\u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0437\u043d\u044f\u0441\u0456\u043b\u0435\u043d\u0430\u0433\u0430 \u045e \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u045e \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b, \u0430\u0434\u0440\u0430\u0437\u0443 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435; \u044f\u043a\u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0436\u0432\u0430\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0443 \u0432\u044f\u043d\u043a\u043e\u043c \u0456 \u0441\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u044f\u0433\u043e\u043d\u0430\u0439 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430\u0439. \u041f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u045e\u0448\u044b \u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c, \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0435: &laquo;\u0427\u044b\u043c \u0430\u0434\u0434\u0437\u044f\u0447\u0443 \u044f \u041f\u0430\u043d\u0443 \u0437\u0430 \u045e\u0441\u0435 \u042f\u0433\u043e \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u0434\u043b\u044f \u043c\u044f\u043d\u0435?&raquo; (\u041f\u0441 116 [115], 12).<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0430 \u043a\u0435\u043b\u0456\u0445? \u0413\u044d\u0442\u0430 \u043a\u0435\u043b\u0456\u0445 \u043c\u0443\u043a\u0456, \u0433\u043e\u0440\u043a\u0456 \u0456 \u043f\u043e\u045e\u043d\u044b \u043c\u043e\u0446\u044b \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u041a\u0435\u043b\u0456\u0445, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u0431\u0430\u044f\u045e\u0441\u044f \u0431 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u0445\u0432\u043e\u0440\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043a\u0430\u043b\u0456 \u0431 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0437 \u044f\u0433\u043e \u043d\u0435 \u0432\u044b\u043f\u0456\u045e \u041b\u0435\u043a\u0430\u0440. \u041f\u0440\u0430 \u0442\u0430\u043a\u0456 \u043a\u0435\u043b\u0456\u0445 \u0442\u0443\u0442 \u0456\u0434\u0437\u0435 \u0433\u0430\u0432\u043e\u0440\u043a\u0430 \u0456 \u043f\u0440\u0430 \u0442\u0430\u043a\u0456 \u043a\u0430\u0437\u0430\u045e \u0415\u0437\u0443\u0441: &laquo;\u041e\u0439\u0447\u0430, \u043a\u0430\u043b\u0456 \u0433\u044d\u0442\u0430 \u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u043d\u044f\u0445\u0430\u0439 \u0430\u0431\u043c\u0456\u043d\u0435 \u0433\u044d\u0442\u044b \u043a\u0435\u043b\u0456\u0445 \u041c\u044f\u043d\u0435&raquo; (\u043f\u0430\u0440. \u041c\u0446 26, 39).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u0433\u044d\u0442\u044b \u043a\u0435\u043b\u0456\u0445 \u043a\u0430\u0437\u0430\u043b\u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456: &laquo;\u041a\u0435\u043b\u0456\u0445 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0437\u043d\u0456\u043c\u0443 \u0456 \u0431\u0443\u0434\u0443 \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0456\u043c\u044f \u041f\u0430\u043d\u0430&raquo; (\u041f\u0441 116 [115], 13). \u0410 \u0446\u0456 \u043d\u0435 \u0431\u0430\u0456\u0448\u0441\u044f, \u0448\u0442\u043e \u0430\u0441\u043b\u0430\u0431\u043d\u0435\u0448? \u0410\u0434\u043a\u0430\u0437\u0432\u0430\u0435: &laquo;\u041d\u0435&raquo;. \u0410 \u0447\u0430\u043c\u0443? \u0422\u0430\u043c\u0443 \u0448\u0442\u043e &laquo;\u043f\u0430\u043a\u043b\u0456\u0447\u0443 \u0456\u043c\u044f \u041f\u0430\u043d\u0430&raquo;. \u042f\u043a \u0431\u044b \u043c\u0430\u0433\u043b\u0456 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u0446\u044c \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456, \u043a\u0430\u043b\u0456 \u0431 \u0443 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u0445 \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u045e \u0442\u043e\u0439, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430: &laquo;\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0430\u0434\u0432\u0430\u0436\u043d\u044b\u043c\u0456: \u042f \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0441\u0432\u0435\u0442&raquo; (\u043f\u0430\u0440. \u042f\u043d 16, 33)? \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0456\u0445 \u0440\u043e\u0437\u0443\u043c\u0430\u043c \u0456 \u043c\u043e\u0432\u0430\u0439 \u0456 \u043f\u0440\u0430\u0437 \u0456\u0445 \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0430\u045e \u0434&rsquo;\u044f\u0431\u043b\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0430 \u045e \u043d\u0435\u0431\u0435 \u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u045e \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0432\u044f\u043d\u043a\u0430\u043c\u0456 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430\u045e. \u041e \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0442\u044b\u044f, \u0445\u0442\u043e \u0432\u044b\u043f\u0456\u045e \u0433\u044d\u0442\u044b \u043a\u0435\u043b\u0456\u0445! \u0421\u043a\u043e\u043d\u0447\u044b\u043b\u0456\u0441\u044f \u0456\u0445 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456, \u0456 \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043f\u0430\u0448\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0432\u044f\u0440\u043d\u0456\u0446\u0435 \u043d\u0430 \u0433\u044d\u0442\u0430 \u045e\u0432\u0430\u0433\u0443, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f: \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0434\u0443\u0445\u0430\u043c \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0430\u0434 \u0432\u0430\u0447\u044d\u0439, \u0456 \u045e\u0431\u0430\u0447\u044b\u0446\u0435, \u0448\u0442\u043e &laquo;\u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u044f \u045e \u0432\u0430\u0447\u0430\u0445 \u041f\u0430\u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u0445&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 2 \u0426\u0456\u043c 4, 7-8; \u0424\u043b\u043f 3, 8-10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0434\u043e\u0431\u0440\u0430\u0439 \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435 \u044f \u0437\u043c\u0430\u0433\u0430\u045e\u0441\u044f, \u0431\u0435\u0433 \u0441\u043a\u043e\u043d\u0447\u044b\u045e, \u0432\u0435\u0440\u0443 \u0437\u0430\u0445\u0430\u0432\u0430\u045e. <span style=\"color: #ff0000;\">*<\/span> \u041d\u0430\u0440\u044d\u0448\u0446\u0435 \u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u045e\u0441\u0451 \u043b\u0456\u0447\u0443 \u0441\u0442\u0440\u0430\u0442\u0430\u044e \u0434\u0437\u0435\u043b\u044f \u043f\u0435\u0440\u0430\u0432\u0430\u0433\u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u042f\u0433\u043e\u043d\u044b\u0445, \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u044e\u0447\u044b\u0441\u044f \u0434\u0430 \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0440\u044d\u0448\u0446\u0435 \u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u043c\u043d\u0435 \u0432\u044f\u043d\u043e\u043a \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"5011","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0422\u0420\u042d\u0426\u042f\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0435 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u041f\u0430\u045e\u043b\u0430 \u0434\u0430 \u0420\u044b\u043c\u043b\u044f\u043d\u0430\u045e <span style=\"color: #ff0000;\">6, 3-11<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u0448\u044b \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0443\u0436\u043e \u043d\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b: \u0426\u0456 \u0436 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u045e\u0441\u0435 \u043c\u044b, \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u044f \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0441\u043c\u0435\u0440\u0446\u044c \u042f\u0433\u043e\u043d\u0443\u044e \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u043b\u0456\u0441\u044f? \u0414\u044b\u043a \u0432\u043e\u0441\u044c, \u043f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442 \u043c\u044b \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443 \u0441\u043c\u0435\u0440\u0446\u044c, \u043a\u0430\u0431, \u044f\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0434\u0437\u0435\u043b\u044f \u0441\u043b\u0430\u0432\u044b \u0410\u0439\u0446\u0430, \u0442\u0430\u043a \u0456 \u043d\u0430\u043c \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0430\u0431\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456. \u0411\u043e \u043a\u0430\u043b\u0456 \u043c\u044b \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u0437 \u0406\u043c \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u0441\u043c\u0435\u0440\u0446\u0456 \u042f\u0433\u043e\u043d\u0430\u0439, \u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u0446\u044c \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0431\u044b\u043b\u044b \u043d\u0430\u0448 \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0437 \u0406\u043c \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0431\u044b\u043b\u043e \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0433\u0440\u044d\u0448\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u043d\u0430\u043c \u043d\u0435 \u0431\u044b\u0446\u044c \u0443\u0436\u043e \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0433\u0440\u0430\u0445\u0443; \u0431\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u043c\u0451\u0440, \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e\u0441\u044f \u0430\u0434 \u0433\u0440\u0430\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0436 \u043c\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0442\u043e \u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0456 \u0436\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435\u043c \u0437 \u0406\u043c, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u0448\u044b \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0443\u0436\u043e \u043d\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u0435, \u0441\u043c\u0435\u0440\u0446\u044c \u0443\u0436\u043e \u043d\u0435 \u043c\u0430\u0435 \u043d\u0430\u0434 \u0406\u043c \u0443\u043b\u0430\u0434\u044b. \u0411\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u043f\u0430\u043c\u0451\u0440, \u0434\u044b\u043a \u043f\u0430\u043c\u0451\u0440 \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443, \u0430 \u0448\u0442\u043e \u0436\u044b\u0432\u0435, \u0434\u044b\u043a \u0436\u044b\u0432\u0435 \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0433\u0430. \u0422\u0430\u043a \u0456 \u0432\u044b \u043b\u0456\u0447\u044b\u0446\u0435 \u0441\u044f\u0431\u0435 \u043c\u0451\u0440\u0442\u0432\u044b\u043c\u0456 \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443, \u0430 \u0436\u044b\u0432\u044b\u043c\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0410\u043d\u0442.<\/span> \u0410\u043b\u043b\u0435\u043b\u044e\u044f, <span style=\"color: #ff0000;\">*<\/span> \u0430\u043b\u043b\u0435\u043b\u044e\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0441\u0430\u043b\u044c\u043c 118 (117), 1-2. 16ab-17. 22-23<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0432\u0430\u043b\u0456\u0446\u0435 \u041f\u0430\u043d\u0430, \u0431\u043e \u0401\u043d \u0434\u043e\u0431\u0440\u044b, *<br \/>\u0431\u043e \u043d\u0430\u0432\u0435\u043a\u0456 \u042f\u0433\u043e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0441\u043a\u0430\u0436\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044c: *<br \/>&laquo;\u041d\u0430\u0432\u0435\u043a\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u042f\u0433\u043e\u043d\u0430\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0440\u0430\u0432\u0456\u0446\u0430 \u041f\u0430\u043d\u0430 \u045e\u0437\u043d\u044f\u043b\u0430\u0441\u044f \u0432\u044b\u0441\u043e\u043a\u0430, *<br \/>\u043f\u0440\u0430\u0432\u0456\u0446\u0430 \u041f\u0430\u043d\u0430 \u0447\u044b\u043d\u0456\u0446\u044c \u0446\u0443\u0434\u044b!&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043f\u0430\u043c\u0440\u0443, \u0430\u043b\u0435 \u0436\u044b\u0446\u044c \u0431\u0443\u0434\u0443 *<br \/>\u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044b \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043c\u0435\u043d\u044c, \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456, *<br \/>\u0441\u0442\u0430\u045e \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u0432\u0443\u0433\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0442\u0430\u043a, &ndash; *<br \/>\u0456 \u0434\u0437\u0456\u045e\u043d\u0430 \u0433\u044d\u0442\u0430 \u045e \u0432\u0430\u0447\u0430\u0445 \u043d\u0430\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0410\u043d\u0442.<\/span> \u0410\u043b\u043b\u0435\u043b\u044e\u044f, <span style=\"color: #ff0000;\">*<\/span> \u0430\u043b\u043b\u0435\u043b\u044e\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0427\u0410\u0426\u0412\u0401\u0420\u0422\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0421\u0432\u044f\u0442\u043e\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u041c\u0430\u0446\u0432\u0435\u044f <span style=\"color: #ff0000;\">28, 1-10<\/span><\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u0401\u043d \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0456 \u0432\u043e\u0441\u044c \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u0435 \u0432\u0430\u0441 \u0443 \u0413\u0430\u043b\u0456\u043b\u0435\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043c\u0456\u043d\u0443\u045e \u0448\u0430\u0431\u0430\u0442, \u043d\u0430 \u0441\u0432\u0456\u0442\u0430\u043d\u043d\u0456 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0434\u043d\u044f \u0442\u044b\u0434\u043d\u044f, \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u041c\u0430\u0440\u044b\u044f \u041c\u0430\u0433\u0434\u0430\u043b\u0435\u043d\u0430 \u0456 \u0434\u0440\u0443\u0433\u0430\u044f \u041c\u0430\u0440\u044b\u044f \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043c\u0430\u0433\u0456\u043b\u0443. \u0406 \u0432\u043e\u0441\u044c \u0441\u0442\u0430\u045e\u0441\u044f \u0432\u044f\u043b\u0456\u043a\u0456 \u0437\u0435\u043c\u043b\u044f\u0442\u0440\u0443\u0441, \u0431\u043e \u0430\u043d\u0451\u043b \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0441\u044b\u0448\u043e\u045e \u0437 \u043d\u0435\u0431\u0430, \u043f\u0430\u0434\u044b\u0448\u043e\u045e, \u0430\u0434\u0441\u0443\u043d\u0443\u045e \u043a\u0430\u043c\u0435\u043d\u044c \u0456 \u0441\u0435\u045e \u043d\u0430 \u0456\u043c. \u0412\u044b\u0433\u043b\u044f\u0434 \u0436\u0430 \u044f\u0433\u043e\u043d\u044b \u0431\u044b\u045e, \u044f\u043a \u043c\u0430\u043b\u0430\u043d\u043a\u0430, \u0456 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u044f\u0433\u043e\u043d\u0430\u0435 \u0431\u044b\u043b\u043e \u0431\u0435\u043b\u0430\u0435, \u044f\u043a \u0441\u043d\u0435\u0433. \u0410\u0434 \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0437\u0430\u0434\u0440\u044b\u0436\u044d\u043b\u0456 \u0432\u0430\u0440\u0442\u0430\u045e\u043d\u0456\u043a\u0456 \u0456 \u0441\u0442\u0430\u043b\u0456 \u044f\u043a \u043c\u0451\u0440\u0442\u0432\u044b\u044f. \u0410\u043d\u0451\u043b \u0436\u0430, \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u0434\u0430 \u0436\u0430\u043d\u0447\u044b\u043d, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f! \u0412\u0435\u0434\u0430\u044e, \u0448\u0442\u043e \u0432\u044b \u0448\u0443\u043a\u0430\u0435\u0446\u0435 \u0415\u0437\u0443\u0441\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430. \u042f\u0433\u043e \u0442\u0443\u0442 \u043d\u044f\u043c\u0430, \u0401\u043d \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u044f\u043a \u0441\u043a\u0430\u0437\u0430\u045e. \u041f\u0430\u0434\u044b\u0434\u0437\u0456\u0446\u0435, \u043f\u0430\u0431\u0430\u0447\u0446\u0435 \u043c\u0435\u0441\u0446\u0430, \u0434\u0437\u0435 \u0431\u044b\u045e \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u044b, \u0434\u044b \u0456\u0434\u0437\u0456\u0446\u0435 \u0445\u0443\u0442\u0447\u044d\u0439, \u0441\u043a\u0430\u0436\u044b\u0446\u0435 \u0432\u0443\u0447\u043d\u044f\u043c \u042f\u0433\u043e\u043d\u044b\u043c, \u0448\u0442\u043e \u0401\u043d \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0456 \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u0435 \u0432\u0430\u0441 \u0443 \u0413\u0430\u043b\u0456\u043b\u0435\u0456. \u0422\u0430\u043c \u042f\u0433\u043e \u045e\u0431\u0430\u0447\u044b\u0446\u0435. \u0413\u044d\u0442\u0430 \u044f \u0441\u043a\u0430\u0437\u0430\u045e \u0432\u0430\u043c&raquo;. \u0406, \u0445\u0443\u0442\u043a\u0430 \u0430\u0434\u044b\u0448\u043e\u045e\u0448\u044b \u0430\u0434 \u043c\u0430\u0433\u0456\u043b\u044b, \u0441\u0430 \u0441\u0442\u0440\u0430\u0445\u0430\u043c \u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u044f\u043d\u044b \u043f\u0430\u0431\u0435\u0433\u043b\u0456 \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u0446\u044c \u0432\u0443\u0447\u043d\u044f\u043c \u042f\u0433\u043e\u043d\u044b\u043c. \u0406 \u0432\u043e\u0441\u044c, \u0415\u0437\u0443\u0441, \u0432\u044b\u0439\u0448\u0430\u045e\u0448\u044b \u0456\u043c \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0412\u0456\u0442\u0430\u0439\u0446\u0435&raquo;. \u042f\u043d\u044b \u0436, \u043f\u0430\u0434\u044b\u0448\u043e\u045e\u0448\u044b, \u0430\u0431\u043d\u044f\u043b\u0456 \u043d\u043e\u0433\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0456 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u043b\u0456\u0441\u044f \u042f\u043c\u0443. \u0422\u0430\u0434\u044b \u0415\u0437\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f. \u0406\u0434\u0437\u0456\u0446\u0435, \u043f\u0430\u0432\u0435\u0434\u0430\u043c\u0456\u0446\u0435 \u0431\u0440\u0430\u0442\u0430\u043c \u041c\u0430\u0456\u043c, \u043a\u0430\u0431 \u0456\u0448\u043b\u0456 \u045e \u0413\u0430\u043b\u0456\u043b\u0435\u044e, \u0442\u0430\u043c \u041c\u044f\u043d\u0435 \u045e\u0431\u0430\u0447\u0430\u0446\u044c&raquo;.<\/p>\r\n"}, {"GCH_CH_2_ID":"5012","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u044f \u0433\u0430\u043c\u0456\u043b\u0456\u044f&raquo; \u041c\u044d\u043b\u0456\u0442\u043e\u043d\u0430 \u0421\u0430\u0440\u0434\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 2-7, 100-103: SC 123, 60-64. 120-122)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0440\u0430\u0437\u0443\u043c\u0435\u0439\u0446\u0435, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f: \u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0451\u0441\u0446\u044c \u043d\u043e\u0432\u0430\u0439 \u0456 \u0441\u0442\u0430\u0440\u043e\u0439, \u0432\u0435\u0447\u043d\u0430\u0439 \u0456 \u0447\u0430\u0441\u043e\u0432\u0430\u0439, \u0442\u043b\u0435\u043d\u043d\u0430\u0439 \u0456 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0439, \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0439 \u0456 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u0440\u0430\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443, \u043d\u043e\u0432\u0430\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0421\u043b\u043e\u0432\u0430; \u0447\u0430\u0441\u043e\u0432\u0430\u044f \u044f\u043a \u0432\u043e\u0431\u0440\u0430\u0437, \u0432\u0435\u0447\u043d\u0430\u044f \u044f\u043a \u043b\u0430\u0441\u043a\u0430; \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u044f\u043a \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u044f\u0433\u043d\u044f\u0446\u0456, \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u044f \u044f\u043a \u0436\u044b\u0446\u0446\u0451 \u041f\u0430\u043d\u0430; \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u044f \u044f\u043a \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 \u045e \u0437\u044f\u043c\u043b\u0456, \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u044f \u044f\u043a \u042f\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u0417\u0430\u043a\u043e\u043d \u0441\u0442\u0430\u0440\u044b, \u0430\u043b\u0435 \u0421\u043b\u043e\u0432\u0430 \u043d\u043e\u0432\u0430\u0435; \u0445\u043e\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u0447\u0430\u0441\u043e\u0432\u044b, \u0430\u043b\u0435 \u043b\u0430\u0441\u043a\u0430 \u0432\u0435\u0447\u043d\u0430\u044f; \u0445\u043e\u0446\u044c \u0442\u043b\u0435\u043d\u043d\u0430\u0435 \u044f\u0433\u043d\u0451, \u0430\u043b\u0435 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u044b \u041f\u0430\u043d, \u044f\u043a\u0456 \u0431\u044b\u045e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b \u044f\u043a \u044f\u0433\u043d\u0451, \u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u044f\u043a \u0411\u043e\u0433.<br \/>\u042f\u043a \u044f\u0433\u043d\u044f, \u0432\u044f\u043b\u0456 \u042f\u0433\u043e \u043d\u0430 \u0437\u0430\u0431\u043e\u0439, \u0430\u043b\u0435 \u0401\u043d \u043d\u0435 \u0431\u044b\u045e \u044f\u0433\u043d\u0451\u043c, \u0456, \u044f\u043a \u0430\u0432\u0435\u0447\u043a\u0430, \u043c\u0430\u045e\u0447\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u0441\u0442\u0440\u044b\u0436\u044d \u044f\u0435, \u0430\u0434\u043d\u0430\u043a \u043d\u0435 \u0431\u044b\u045e \u0430\u0432\u0435\u0447\u043a\u0430\u0439. \u0412\u043e\u0431\u0440\u0430\u0437 \u043c\u0456\u043d\u0443\u045e \u0456 \u0437\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043f\u0440\u0430\u045e\u0434\u0430: \u0437\u0430\u043c\u0435\u0441\u0442 \u044f\u0433\u043d\u044f\u0446\u0456 &ndash; \u0411\u043e\u0433, \u0437\u0430\u043c\u0435\u0441\u0442 \u0430\u0432\u0435\u0447\u043a\u0456 &ndash; \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0430 \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 &ndash; \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u0437\u043c\u044f\u0448\u0447\u0430\u0435 \u045e\u0441\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u044f\u0433\u043d\u044f\u0446\u0456, \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u043d\u043d\u0435 \u041f\u0430\u0441\u0445\u0456 \u0456 \u043a\u043d\u0456\u0433\u0456 \u0417\u0430\u043a\u043e\u043d\u0443 \u043c\u0435\u043b\u0456 \u0437\u0430 \u043c\u044d\u0442\u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0415\u0437\u0443\u0441\u0430, \u0434\u0437\u0435\u043b\u044f \u044f\u043a\u043e\u0433\u0430 \u045e\u0441\u0451 \u0430\u0434\u0431\u044b\u0432\u0430\u043b\u0430\u0441\u044f \u045e \u0441\u0442\u0430\u0440\u044b\u043c \u0417\u0430\u043a\u043e\u043d\u0435, \u0430 \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0456 \u045e \u043d\u043e\u0432\u044b\u043c \u043f\u0430\u0440\u0430\u0434\u043a\u0443.<br \/>\u0417\u0430\u043a\u043e\u043d \u0441\u0442\u0430\u045e \u0421\u043b\u043e\u0432\u0430\u043c, \u0456 \u0441\u0442\u0430\u0440\u043e\u0435 \u0441\u0442\u0430\u043b\u0430 \u043d\u043e\u0432\u044b\u043c (\u0430\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435 \u0432\u044b\u0439\u0448\u043b\u0430 \u0437 \u0421\u0456\u0451\u043d\u0430 \u0456 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430), \u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u045e \u043b\u0430\u0441\u043a\u0443, \u0432\u043e\u0431\u0440\u0430\u0437 &ndash; \u0443 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044c, \u044f\u0433\u043d\u0451 &ndash; \u0443 \u0421\u044b\u043d\u0430, \u0430\u0432\u0435\u0447\u043a\u0430 &ndash; \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a &ndash; \u0443 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d, \u0445\u043e\u0446\u044c \u0431\u044b\u045e \u0411\u043e\u0433\u0430\u043c, \u0430\u043f\u0440\u0430\u043d\u0443\u045e\u0441\u044f \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u0446\u044f\u0440\u043f\u0435\u045e \u043f\u0430\u043a\u0443\u0442\u044b \u0437\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043a\u0443\u0442\u0430\u0432\u0430\u045e, \u0431\u044b\u045e \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b \u0437\u0430 \u0432\u044f\u0437\u043d\u044f, \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u044b \u0437\u0430 \u0432\u0456\u043d\u0430\u0432\u0430\u0442\u0430\u0433\u0430, \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b \u0437\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u0430\u0433\u0430, \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0456 \u0433\u0443\u0447\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0425\u0442\u043e \u0430\u0441\u0443\u0434\u0437\u0456\u0446\u044c \u041c\u044f\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0434\u044b\u0434\u0437\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435 (\u043f\u0430\u0440. \u0406\u0441 50, 8). \u0413\u044d\u0442\u0430 \u042f \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0430\u0441\u0443\u0434\u0436\u0430\u043d\u0430\u0433\u0430, \u0430\u0436\u044b\u0432\u0456\u045e \u043c\u0451\u0440\u0442\u0432\u0430\u0433\u0430, \u042f \u043f\u0430\u0434\u043d\u044f\u045e \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u0430\u0433\u0430. \u0425\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c \u041c\u043d\u0435? \u042f, \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u045e \u0441\u043c\u0435\u0440\u0446\u044c, \u0442\u0440\u044b\u0443\u043c\u0444\u0430\u043b\u044c\u043d\u0430 \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0432\u043e\u0440\u0430\u0433\u0430, \u0440\u0430\u0441\u0442\u0430\u043f\u0442\u0430\u045e \u043f\u0435\u043a\u043b\u0430, \u0437\u0432\u044f\u0437\u0430\u045e \u0432\u043e\u043b\u0430\u0442\u0430 \u0456 \u0437\u0430\u0431\u0440\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043d\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0432\u044b\u0441\u0456. \u042f &ndash; \u0442\u043e\u0439, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0441\u043a\u0430\u0432\u0430\u043d\u044b\u044f \u0433\u0440\u0430\u0445\u0430\u043c\u0456, \u0456 \u043f\u0440\u044b\u043c\u0456\u0446\u0435 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e. \u0411\u043e \u042f &ndash; \u0432\u0430\u0448\u0430 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435, \u042f &ndash; \u041f\u0430\u0441\u0445\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u042f &ndash; \u0411\u0430\u0440\u0430\u043d\u0430\u043a, \u0437\u0430\u0440\u044d\u0437\u0430\u043d\u044b \u0437\u0430 \u0432\u0430\u0441, \u0432\u0430\u0448\u0430 \u043a\u0443\u043f\u0435\u043b\u044c, \u0432\u0430\u0448\u0430 \u0436\u044b\u0446\u0446\u0451, \u0432\u0430\u0448\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435, \u0432\u0430\u0448\u0430 \u0441\u0432\u044f\u0442\u043b\u043e, \u0432\u0430\u0448\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0432\u0430\u0448 \u0412\u0430\u043b\u0430\u0434\u0430\u0440. \u042f \u045e\u0437\u043d\u043e\u0448\u0443 \u0432\u0430\u0441 \u043d\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0432\u044b\u0441\u0456; \u042f \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u0443 \u0432\u0430\u0441 \u0456 \u043f\u0430\u043a\u0430\u0436\u0443 \u0432\u0430\u043c \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u045e \u043d\u0435\u0431\u0435; \u042f \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u0443 \u0432\u0430\u0441 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0432\u0456\u0446\u0430\u0439&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0437 13, 32b-33a; 10, 42b; 2, 36b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0431\u044f\u0446\u0430\u043d\u043d\u0435, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u0430\u0439\u0446\u0430\u043c \u043d\u0430\u0448\u044b\u043c, \u0411\u043e\u0433 \u0432\u044b\u043a\u0430\u043d\u0430\u045e, \u043a\u0430\u043b\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0415\u0437\u0443\u0441\u0430: <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c \u0441\u0443\u0434\u0434\u0437\u044f \u0436\u044b\u0432\u044b\u0445 \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u044d\u0442\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043b\u0456, \u0411\u043e\u0433 \u0437\u0440\u0430\u0431\u0456\u045e \u041f\u0430\u043d\u0430\u043c \u0456 \u041c\u0435\u0441\u0456\u044f\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c \u0441\u0443\u0434\u0434\u0437\u044f \u0436\u044b\u0432\u044b\u0445 \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5013","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u044f \u0410\u043d\u0442\u044b\u0451\u0445\u0441\u043a\u0430\u0433\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 4, 1-2: PG 89, 1347-1349)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0442\u0430\u043a \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0456 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u0456 \u0441\u043f\u0440\u0430\u0432\u044b, \u0448\u0442\u043e \u0401\u043d \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0411\u043e\u0433 \u0456 \u041f\u0430\u043d \u0441\u0443\u0441\u0432\u0435\u0442\u0443, \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0432\u0443\u0447\u043d\u044f\u043c, \u043c\u0430\u044e\u0447\u044b \u043d\u0430\u043c\u0435\u0440 \u0456\u0441\u0446\u0456 \u045e \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c: &laquo;\u041c\u044b \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u043c \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c, \u0456 \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0434\u0430\u0434\u0437\u0435\u043d\u044b \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c, \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c \u0456 \u043a\u043d\u0456\u0436\u043d\u0456\u043a\u0430\u043c \u043d\u0430 \u0437\u0434\u0437\u0435\u043a, \u0431\u0456\u0447\u0430\u0432\u0430\u043d\u043d\u0435 \u0456 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u043d\u0435&raquo; (\u043f\u0430\u0440. \u041c\u0446 20, 18-19). \u0415\u0437\u0443\u0441 \u043a\u0430\u0437\u0430\u045e \u0433\u044d\u0442\u0430 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0430\u043d\u043d\u044f\u043c\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u042f\u0433\u043e \u0431\u0443\u0434\u0443\u0447\u044b \u0430\u0434\u044b\u0445\u043e\u0434 \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0435. \u0422\u0430\u043a, \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u042f\u0433\u043e \u043c\u0443\u043a\u0443 \u043f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0437 \u042f\u0433\u043e \u0446\u0435\u043b\u0430\u043c \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u0411\u043e\u0433, \u0437 \u044f\u043a\u0456\u043c \u0433\u044d\u0442\u0430 \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f, \u043d\u0435 \u043f\u0430\u0434\u0443\u043b\u0430\u0434\u043d\u044b \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044e \u0456 \u0441\u043c\u0435\u0440\u0446\u0456. \u0406\u043d\u0430\u043a\u0448 \u0401\u043d \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0431\u044b\u045e \u0431\u044b \u0411\u043e\u0433\u0430\u043c, \u043a\u0430\u043b\u0456 \u0431 \u043c\u044b, \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u042f\u0433\u043e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u043b\u0443\u0448\u043d\u044b\u0445 \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u0445 \u043f\u0430\u0434\u0441\u0442\u0430\u045e \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u0446\u044c \u0430\u0431\u0435\u0434\u0437\u0432\u0435 \u0440\u044d\u0447\u044b: \u042f\u0433\u043e \u043c\u0443\u043a\u0443 \u0456 \u042f\u0433\u043e \u043d\u0435\u043f\u0430\u0434\u0443\u043b\u0430\u0434\u043d\u0430\u0441\u0446\u044c \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044e. \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435, \u0448\u0442\u043e \u043d\u0435 \u043f\u0430\u0434\u043b\u044f\u0433\u0430\u0435 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044e, \u0437\u0432\u0435\u0434\u0430\u043b\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0437 \u0442\u043e\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043d\u0435 \u043c\u043e\u0433 \u0437\u0431\u0430\u0432\u0456\u0446\u0446\u0430 \u0456\u043d\u0448\u044b\u043c \u0447\u044b\u043d\u0430\u043c. \u0413\u044d\u0442\u0430 \u0432\u0435\u0434\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0456 \u0442\u044b\u044f, \u043a\u0430\u043c\u0443 \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u045e, \u0431\u043e \u0432\u0435\u0434\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0410\u0439\u0446\u0443, \u0456 \u044f\u043a \u0414\u0443\u0445 \u043f\u0440\u0430\u043d\u0456\u043a\u0430\u0435 \u045e \u043d\u0430\u0439\u0433\u043b\u044b\u0431\u0435\u0439\u0448\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 2, 10).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u0425\u0440\u044b\u0441\u0442\u0443 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0446\u044f\u0440\u043f\u0435\u0446\u044c, \u0456 \u043c\u0443\u043a\u0430 \u0431\u044b\u043b\u0430 \u0430\u0431\u0441\u0430\u043b\u044e\u0442\u043d\u0430 \u043d\u0435\u043f\u0430\u0437\u0431\u0435\u0436\u043d\u0430\u0439. \u0421\u0430\u043c \u0415\u0437\u0443\u0441 \u0441\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u045e \u0433\u044d\u0442\u0430, \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0447\u044b \u043c\u0430\u0440\u0443\u0434\u043d\u044b\u043c\u0456 \u0456 \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u043c\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0456 \u0442\u0430\u043a \u0443\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443. \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u043f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0441\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u043c\u0435\u045e \u0443 \u0410\u0439\u0446\u0430 \u0434\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443. \u0410 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0431\u044b\u043b\u043e \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435\u043c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u043e \u0430\u0434\u0431\u044b\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u043c\u0443\u043a\u0443 \u0434\u0430\u045e\u0446\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u041a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b: &laquo;\u0411\u043e\u0433 \u0443\u0447\u044b\u043d\u0456\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u043f\u0440\u0430\u0437 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u0434\u0430\u045e\u0446\u0443 \u0436\u044b\u0446\u0446\u044f&raquo; (\u043f\u0430\u0440. \u0413\u0431\u0440 2, 10). \u0421\u043b\u0430\u0432\u0430 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430, \u044f\u043a\u043e\u0439 \u0401\u043d \u043d\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441 \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u045e\u0441\u044f \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441, \u0431\u044b\u043b\u0430 \u0432\u0435\u0440\u043d\u0443\u0442\u0430 \u042f\u043c\u0443 \u043f\u0440\u0430\u0437 \u043a\u0440\u044b\u0436 \u0456 \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u0430 \u045e \u042f\u0433\u043e\u043d\u044b\u043c \u0446\u0435\u043b\u0435. \u0421\u0432. \u042f\u043d \u043a\u0430\u0436\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u0456, \u0447\u044b\u043c \u0431\u044b\u043b\u0430 \u0432\u0430\u0434\u0430, \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u0417\u0431\u0430\u045e\u0446\u0430: &laquo;\u0425\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u041c\u044f\u043d\u0435, \u0443 \u0442\u0430\u0433\u043e \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u043f\u0430\u0446\u044f\u043a\u0443\u0446\u044c \u0440\u044d\u043a\u0456 \u0432\u0430\u0434\u044b \u0436\u044b\u0432\u043e\u0439&raquo;. \u0413\u044d\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u043d \u043f\u0440\u0430 \u0414\u0443\u0445\u0430, \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u043b\u0456 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0443 \u042f\u0433\u043e: \u0431\u043e \u044f\u0448\u0447\u044d \u043d\u0435 \u0431\u044b\u045e \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u044f\u0448\u0447\u044d \u043d\u0435 \u045e\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f (\u043f\u0430\u0440. \u042f\u043d 7, 38-39). \u0421\u043b\u0430\u0432\u0430\u0439 \u0436\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0430 \u043a\u0440\u044b\u0436\u044b. \u0422\u0430\u043c\u0443 \u041f\u0430\u043d, \u043c\u043e\u043b\u044f\u0447\u044b\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u043f\u0440\u0430\u0441\u0456\u045e \u0410\u0439\u0446\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u042f\u0433\u043e \u0442\u043e\u0439 \u0441\u043b\u0430\u0432\u0430\u0439, \u044f\u043a\u0443\u044e \u043c\u0435\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0434\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0431\u0440 2, 10; \u0410\u043f 1, 6b; \u041b\u043a 24, 26<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u043b\u0435\u0436\u0430\u043b\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0434\u0437\u0435\u043b\u044f \u044f\u043a\u043e\u0433\u0430 \u045e\u0441\u0451 \u0456 \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u045e\u0441\u0451, \u044f\u043a\u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0434\u0430 \u0441\u043b\u0430\u0432\u044b \u043c\u043d\u043e\u0433\u0456\u0445 \u0441\u044b\u043d\u043e\u045e, \u0443\u0447\u044b\u043d\u0456\u045e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c \u043f\u0440\u0430\u0437 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u0456 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456\u0445\u043d\u044f\u0433\u0430. <span style=\"color: #ff0000;\">*<\/span> \u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u0456 \u043c\u043e\u0446 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u041c\u0435\u0441\u0456\u0456 \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0443\u0441\u0451 \u0433\u044d\u0442\u0430, \u043a\u0430\u0431 \u0443\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043c\u0443 \u0445\u0432\u0430\u043b\u0430 \u0456 \u043c\u043e\u0446 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5014","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u044f \u0433\u0430\u043c\u0456\u043b\u0456\u044f&raquo; \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u0430\u0433\u0430 \u0430\u045e\u0442\u0430\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 35, 6-9: PL 17 [ed. 1879], 696-697)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f \u0456 \u0436\u044b\u0446\u0446\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0433\u0430\u0434\u0432\u0430\u044e\u0447\u044b \u0448\u0447\u0430\u0441\u0446\u0435 \u043d\u0430\u0431\u044b\u0442\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0435: &laquo;\u042f\u043a \u043f\u0440\u0430\u0437 \u0410\u0434\u0430\u043c\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u045e \u0433\u044d\u0442\u044b \u0441\u0432\u0435\u0442, \u0442\u0430\u043a \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0431\u044b\u043b\u043e \u0432\u0435\u0440\u043d\u0443\u0442\u0430 \u0441\u0432\u0435\u0442\u0443&raquo; (\u043f\u0430\u0440. \u0420\u044b\u043c 5, 12). \u0406 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0434\u0430\u0434\u0430\u0435: &laquo;\u041f\u0435\u0440\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a &ndash; \u0437 \u043f\u044b\u043b\u0443, \u0437\u044f\u043c\u043d\u044b, \u0430 \u0434\u0440\u0443\u0433\u0456 \u0427\u0430\u043b\u0430\u0432\u0435\u043a &ndash; \u0437 \u043d\u0435\u0431\u0430, \u043d\u044f\u0431\u0435\u0441\u043d\u044b&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 15, 47).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u0451\u043d \u0434\u0430\u0434\u0430\u0435: &laquo;\u042f\u043a \u043c\u044b \u043d\u0430\u0441\u0456\u043b\u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u0437\u044f\u043c\u043d\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u0456\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 15, 49), \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043f\u0435\u0440\u0430\u0442\u0432\u043e\u0440\u044b\u043c\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u045e \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u0433\u0430 \u0411\u043e\u0433\u0430\u043c, \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u0430\u0433\u0430, \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0456 \u0430\u0447\u044b\u0448\u0447\u0430\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0422\u043e\u0439 \u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0434\u0430\u0434\u0430\u0435: &laquo;\u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0430\u0447\u0430\u0442\u0430\u043a, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u044c\u043d\u0456\u043a \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0456 \u0436\u044b\u0446\u0446\u044f&raquo;. \u041f\u043e\u0442\u044b\u043c \u0456\u0434\u0443\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0436\u044b\u0432\u0443\u0446\u044c \u043d\u0430 \u045e\u0437\u043e\u0440 \u042f\u0433\u043e\u043d\u0430\u0439 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456, \u0430\u0431\u0430\u043f\u0456\u0440\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u044e \u0442\u0440\u044b\u0432\u0430\u043b\u0443\u044e \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u042f\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435. \u042f\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u041f\u0430\u043d\u0430\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u0443\u044e \u0441\u043b\u0430\u0432\u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0430\u043c \u041f\u0430\u043d \u0443 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456: &laquo;\u0425\u0442\u043e \u043f\u043e\u0439\u0434\u0437\u0435 \u0437\u0430 \u041c\u043d\u043e\u0439, \u0442\u043e\u0439 \u043d\u0435 \u0437\u0433\u0456\u043d\u0435, \u0430\u043b\u0435 \u043f\u044f\u0440\u043e\u0439\u0434\u0437\u0435 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f&raquo; (\u043f\u0430\u0440. \u042f\u043d 5, 24).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0443\u043a\u0430 \u0417\u0431\u0430\u045e\u0446\u044b &ndash; \u0433\u044d\u0442\u0430 \u0440\u0430\u0442\u0443\u043d\u0430\u043a \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0401\u043d \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043f\u0430\u043c\u0435\u0440\u0446\u0456 \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043c\u044b, \u044f\u043a\u0456\u044f \u0432\u0435\u0440\u044b\u043c \u0443 \u042f\u0433\u043e, \u0436\u044b\u043b\u0456 \u0432\u0435\u0447\u043d\u0430. \u0401\u043d \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0447\u0430\u0441\u043e\u0432\u0430 \u0441\u0442\u0430\u0446\u044c \u0442\u044b\u043c, \u0447\u044b\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u043c\u044b, \u043a\u0430\u0431, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u042f\u0433\u043e\u043d\u0430\u0439 \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456, \u043c\u044b \u0432\u0435\u0447\u043d\u0430 \u0436\u044b\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0442\u0430\u043a\u043e\u0439 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043b\u0430\u0441\u043a\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0442\u0430\u044f\u043c\u043d\u0456\u0446, \u0442\u0430\u043a\u0456 \u0434\u0430\u0440 \u041f\u0430\u0441\u0445\u0456, \u0442\u0430\u043a\u043e\u0435 \u0436\u0430\u0434\u0430\u043d\u0430\u0435 \u0448\u0442\u043e\u0433\u0430\u0434\u043e\u0432\u0430\u0435 \u0441\u0432\u044f\u0442\u0430, \u0442\u0430\u043a\u0456\u044f \u043f\u0430\u0447\u0430\u0442\u043a\u0456 \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u044e\u0447\u0430\u0439 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u044b, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f \u0441\u0432\u044f\u0442\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c \u0443 \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u0430\u0439 \u043a\u0443\u043f\u0435\u043b\u0456 \u0456 \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f \u045e \u0434\u0437\u0456\u0446\u044f\u0447\u0430\u0439 \u0448\u0447\u044b\u0440\u0430\u0441\u0446\u0456, \u0433\u0443\u0447\u043d\u0430 \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u0437 \u0432\u043e\u043a\u043b\u0456\u0447\u0430\u043c\u0456 \u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u044b\u044f \u0431\u0430\u0446\u044c\u043a\u0456 \u0456 \u0441\u0446\u0456\u043f\u043b\u044b\u044f \u043c\u0430\u0446\u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u0430\u0435 \u043d\u043e\u0432\u0430\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0430\u0434 \u0434\u0440\u044d\u0432\u0430\u043c \u0432\u0435\u0440\u044b \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u0430\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0437\u0437\u044f\u0435 \u0430\u0437\u0434\u043e\u0431\u0430 \u0441\u0432\u0435\u0447\u0430\u043a. \u0422\u0430\u043c\u0443 \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u044f \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u0446\u0430 \u0434\u0430\u0440\u0430\u043c \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0437\u0430\u0441\u043b\u0443\u0433\u0456 \u0456 \u043d\u0430\u0441\u044b\u0447\u0430\u044e\u0446\u0446\u0430 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u0439 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u043a\u0430\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443 \u0411\u043e\u0436\u0430\u0433\u0430, \u0443\u0441\u043a\u043e\u0440\u043c\u043b\u0435\u043d\u0430\u044f \u043d\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u0446\u0446\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u0456 \u043f\u0430\u0442\u0440\u043e\u0439\u043d\u0430\u043c\u0443 \u0456\u043c\u0435\u043d\u0456 \u043c\u043e\u0446\u044b, \u0441\u043f\u044f\u0432\u0430\u044e\u0447\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u043f\u0441\u0430\u043b\u044c\u043c \u0433\u044d\u0442\u0430\u0439 \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456: &laquo;\u0412\u043e\u0441\u044c \u0434\u0437\u0435\u043d\u044c, \u044f\u043a\u0456 \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e, \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u0456\u043c \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430&raquo; (\u041f\u0441 118 [117], 24).<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0430 \u0434\u0437\u0435\u043d\u044c? \u0413\u044d\u0442\u044b\u043c \u0434\u043d\u0451\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u0436\u044b\u0446\u0446\u044f, \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0456 \u0422\u0432\u043e\u0440\u0446\u0430\u043c \u0441\u0432\u044f\u0442\u043b\u0430. \u0401\u043d \u043a\u0430\u0436\u0430 \u0441\u0430\u043c \u043f\u0440\u0430 \u0441\u044f\u0431\u0435: &laquo;\u042f \u0434\u0437\u0435\u043d\u044c; \u0445\u0442\u043e \u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u043d\u0451\u043c, \u0442\u043e\u0439 \u043d\u0435 \u0441\u043f\u0430\u0442\u044b\u043a\u0430\u0435\u0446\u0446\u0430&raquo; (\u043f\u0430\u0440. \u042f\u043d 8, 12). \u041c\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u0430 \u045e\u0441\u0456\u043c \u0456\u0434\u0437\u0435 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0434\u043e\u0439\u0434\u0437\u0435 \u043f\u0430 \u042f\u0433\u043e\u043d\u044b\u0445 \u0441\u043b\u044f\u0434\u0430\u0445 \u0430\u0436 \u0434\u0430 \u043f\u0430\u0440\u043e\u0433\u0443 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430. \u0410\u0431 \u0433\u044d\u0442\u044b\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043c\u0430\u043b\u0456\u045e\u0441\u044f \u0437\u0430 \u043d\u0430\u0441 \u0434\u0430 \u0410\u0439\u0446\u0430, \u0431\u0443\u0434\u0443\u0447\u044b \u045e \u0437\u044f\u043c\u043d\u044b\u043c \u0446\u0435\u043b\u0435: &laquo;\u041e\u0439\u0447\u0430, \u0445\u0430\u0447\u0443, \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u045e \u041c\u044f\u043d\u0435 \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u0431\u044b\u043b\u0456 \u0442\u0430\u043c, \u0434\u0437\u0435 \u0456 \u042f. \u0406 \u044f\u043a \u0422\u044b \u045e\u0432\u0430 \u041c\u043d\u0435, \u0430 \u042f \u045e \u0422\u0430\u0431\u0435, \u0442\u0430\u043a \u043d\u044f\u0445\u0430\u0439 \u0456 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0443 \u041d\u0430\u0441&raquo; (\u043f\u0430\u0440. \u042f\u043d 17, 20 \u0456 \u043d\u0430\u0441\u0442.).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 15, 47. 49. 48<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0435\u0440\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a &ndash; \u0437 \u043f\u044b\u043b\u0443, \u0437\u044f\u043c\u043d\u044b; \u0434\u0440\u0443\u0433\u0456 \u0427\u0430\u043b\u0430\u0432\u0435\u043a &ndash; \u0437 \u043d\u0435\u0431\u0430, \u043d\u044f\u0431\u0435\u0441\u043d\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u044f\u043a \u043c\u044b \u043d\u0430\u0441\u0456\u043b\u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u0437\u044f\u043c\u043d\u043e\u0433\u0430, \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u0456\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043a\u0456 \u0431\u044b\u045e \u0437\u044f\u043c\u043d\u044b, \u0442\u0430\u043a\u0456\u044f \u0456 \u0437\u044f\u043c\u043d\u044b\u044f; \u044f\u043a\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b, \u0442\u0430\u043a\u0456\u044f \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u044f\u043a \u043c\u044b \u043d\u0430\u0441\u0456\u043b\u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u0437\u044f\u043c\u043d\u043e\u0433\u0430, \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u0456\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5015","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0456\u044f \u043a\u0430\u0442\u044d\u0445\u0435\u0437\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cat. 20, Mystagogica 2, 4-6: PG 33, 1079-1082)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u043e\u0441\u0442 \u044f\u043a \u0437\u043d\u0430\u043a \u043c\u0443\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0430\u0434 \u0441\u0432\u044f\u0442\u043e\u0439 \u043a\u0443\u043f\u0435\u043b\u043b\u044e \u0445\u0440\u043e\u0441\u0442\u0443 \u0432\u044b \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u044f \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0437\u043d\u044f\u0442\u0430\u0433\u0430 \u0437 \u043a\u0440\u044b\u0436\u0430 \u0456 \u043f\u0430\u043a\u043b\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u0434 \u043c\u0430\u0433\u0456\u043b\u0430\u0439. \u0423 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0437 \u0432\u0430\u0441 \u043f\u044b\u0442\u0430\u043b\u0456\u0441\u044f, \u0446\u0456 \u0432\u0435\u0440\u044b\u0446\u0435 \u045e \u0456\u043c\u044f \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430, \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u0412\u044b \u0437\u0440\u0430\u0431\u0456\u043b\u0456 \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u0430\u0435 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435, \u0431\u044b\u043b\u0456 \u0442\u0440\u043e\u0439\u0447\u044b \u0437\u0430\u043d\u0443\u0440\u0430\u043d\u044b\u044f \u045e \u0432\u0430\u0434\u0443 \u0456 \u0437\u043d\u043e\u045e \u0432\u044b\u043d\u0443\u0440\u0430\u043d\u044b\u044f \u0437 \u044f\u0435. \u0413\u044d\u0442\u044b \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0447\u043d\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u0435 \u0442\u0440\u043e\u0445\u0434\u0437\u0451\u043d\u043d\u0430\u0435 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430 \u0431\u044b\u045e \u0442\u0440\u044b \u0434\u043d\u0456 \u0456 \u0442\u0440\u044b \u043d\u043e\u0447\u044b \u045e \u043d\u0435\u0442\u0440\u0430\u0445 \u0437\u044f\u043c\u043b\u0456, \u0442\u0430\u043a \u0456 \u0432\u044b \u043f\u0435\u0440\u0448\u044b\u043c \u0432\u044b\u043d\u0443\u0440\u044d\u043d\u043d\u0435\u043c \u043f\u0435\u0440\u0430\u0439\u043c\u0430\u043b\u0456 \u043f\u0435\u0440\u0448\u044b \u0434\u0437\u0435\u043d\u044c, \u044f\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u0430\u0432\u0451\u045e \u0443 \u0437\u044f\u043c\u043b\u0456, \u0430 \u043f\u0435\u0440\u0448\u044b\u043c \u0437\u0430\u043d\u0443\u0440\u044d\u043d\u043d\u0435\u043c &ndash; \u043f\u0435\u0440\u0448\u0443\u044e \u043d\u043e\u0447. \u0411\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e\u043d\u0430\u0447\u044b, \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430, \u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e\u0434\u0437\u0435\u043d\u044c, \u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u043b\u0435. \u0422\u0430\u043a \u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u0437\u0430\u043d\u0443\u0440\u044d\u043d\u043d\u044f, \u043d\u0456\u0431\u044b \u045e\u043d\u0430\u0447\u044b, \u0432\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456, \u0430 \u043f\u0430\u0434\u0447\u0430\u0441 \u0432\u044b\u043d\u0443\u0440\u044d\u043d\u043d\u044f \u0432\u044b \u043d\u0456\u0431\u044b \u0432\u044b\u0439\u0448\u043b\u0456 \u043d\u0430 \u0434\u0437\u0451\u043d\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e. \u0423 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u043c\u043e\u043c\u0430\u043d\u0442 \u0432\u044b \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456\u0441\u044f, \u0456 \u0437\u0431\u0430\u045e\u0447\u0430\u044f \u0432\u0430\u0434\u0430 \u0445\u0440\u043e\u0441\u0442\u0443 \u0441\u0442\u0430\u043b\u0430 \u0434\u043b\u044f \u0432\u0430\u0441 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0456 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435\u043c, \u0456 \u043c\u0430\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435, \u0448\u0442\u043e \u0421\u0430\u043b\u0430\u043c\u043e\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0456\u043d\u0448\u044b\u044f \u0440\u044d\u0447\u044b, \u0432\u044b\u0434\u0430\u0442\u043d\u0430 \u043f\u0430\u0441\u0443\u0435 \u0434\u0430 \u0432\u0430\u0441, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430: &laquo;\u0427\u0430\u0441 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u0446\u0430 \u0456 \u0447\u0430\u0441 \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c&raquo; (\u042d\u043a\u043b 3, 2). \u0422\u043e\u043b\u044c\u043a\u0456 \u0437 \u0432\u0430\u043c\u0456 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442: \u0447\u0430\u0441 \u043f\u0430\u043c\u0456\u0440\u0430\u0446\u044c \u0456 \u0447\u0430\u0441 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u0446\u0430. \u0410\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0456\u0441\u044f \u0434\u0437\u0432\u0435 \u0440\u044d\u0447\u044b, \u0456 \u0432\u0430\u0448\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0441\u0443\u043f\u0430\u043b\u0430 \u0437 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0430\u044f \u043d\u043e\u0432\u0430\u044f \u0456 \u043d\u0435\u0447\u0443\u0432\u0430\u043d\u0430\u044f \u0440\u044d\u0447! \u0425\u043e\u0446\u044c \u043c\u044b \u043d\u0430 \u0441\u0430\u043c\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u043d\u0435 \u0431\u044b\u043b\u0456 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f, \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b\u044f \u0456 \u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456, \u0430\u0434\u043d\u0430\u043a \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0433\u044d\u0442\u044b\u0445 \u0440\u044d\u0447\u0430\u045e \u0443 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u0445 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u0445 \u0432\u044b\u044f\u0432\u0456\u043b\u0430 \u043f\u0440\u0430\u045e\u0434\u0443, \u0430 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0431\u044b\u045e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u045e\u0434\u0437\u0435\u043b\u0435\u043d\u0430 \u043d\u0430\u043c \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u043c\u044b \u0441\u0442\u0430\u043b\u0456 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u044b\u0445 \u043f\u0430\u043a\u0443\u0442\u0430\u045e \u0456 \u043f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u044f \u0437\u043d\u0430\u043a\u0456 \u043d\u0430\u0431\u044b\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0430\u044f \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u043b\u044e\u0434\u0437\u0435\u0439! \u0423 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u044f \u0440\u0443\u043a\u0456 \u0456 \u043d\u043e\u0433\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0431\u044b\u043b\u0456 \u045e\u0431\u0456\u0442\u044b \u0446\u0432\u0456\u043a\u0456, \u0456 \u0401\u043d \u0446\u044f\u0440\u043f\u0435\u045e \u0431\u043e\u043b\u044c, \u0430 \u043c\u043d\u0435, \u044f\u043a\u0456 \u043d\u0435 \u0437\u0432\u0435\u0434\u0430\u045e \u043d\u0456 \u0431\u043e\u043b\u044e, \u043d\u0456 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u045e, \u0437\u0430\u0434\u0430\u0440\u043c\u0430 \u0434\u0430\u0435\u0446\u0446\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0440\u0430\u0437 \u0443\u0434\u0437\u0435\u043b \u0443 \u042f\u0433\u043e\u043d\u044b\u0445 \u043f\u0430\u043a\u0443\u0442\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043b\u0456\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0445\u0440\u043e\u0441\u0442 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0456 \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u045e \u043b\u0430\u0441\u0446\u044b \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u044f\u043a \u0431\u044b\u043b\u043e \u0437 \u042f\u043d\u0430\u0432\u044b\u043c \u0445\u0440\u043e\u0441\u0442\u0430\u043c, \u0448\u0442\u043e \u0434\u0430\u0432\u0430\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e. \u041c\u044b \u0436 \u0434\u0430\u043a\u043b\u0430\u0434\u043d\u0430 \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u043d\u0430\u0448 \u0445\u0440\u043e\u0441\u0442 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u045e\u0434\u0437\u044f\u043b\u044f\u0435 \u0434\u0430\u0440 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0430\u043b\u0435 \u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0456\u043c\u0432\u0430\u043b\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u0445 \u043f\u0430\u043a\u0443\u0442. \u0422\u0430\u043c\u0443 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0456 \u0441\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u045e: &laquo;\u0426\u0456 \u0436 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u045e\u0441\u0435 \u043c\u044b, \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u044f \u045e \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0441\u043c\u0435\u0440\u0446\u044c \u042f\u0433\u043e\u043d\u0443\u044e \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u043b\u0456\u0441\u044f? \u0414\u044b\u043a \u0432\u043e\u0441\u044c, \u043c\u044b \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0445\u0440\u044b\u0448\u0447\u044d\u043d\u043d\u0435\u043c \u0443 \u0441\u043c\u0435\u0440\u0446\u044c&raquo; (\u0420\u044b\u043c 6, 3-4\u0430).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0410\u043f 7, 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u043d\u043e\u0432\u044b\u044f \u044f\u0433\u043d\u044f\u0442\u044b, \u044f\u043a\u0456\u044f \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u043b\u0456: \u0430\u043b\u043b\u0435\u043b\u044e\u044f; \u044f\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0448\u0442\u043e \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u043a\u0440\u044b\u043d\u0456\u0446 <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0411\u0430\u0440\u0430\u043d\u043a\u0430 \u044f\u043d\u044b \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u044f \u045e \u0431\u0435\u043b\u044b\u044f \u0448\u0430\u0442\u044b, \u0456 \u0433\u0430\u043b\u0456\u043d\u043a\u0456 \u043f\u0430\u043b\u044c\u043c\u0430\u045e \u0443 \u0456\u0445\u043d\u0456\u0445 \u0440\u0443\u043a\u0430\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5016","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0456\u044f \u043a\u0430\u0442\u044d\u0445\u0435\u0437\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cat. 21, Mystagogica 3, 1-3: PG 33, 1087-1091)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0430\u043f\u0440\u0430\u043d\u0443\u0442\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0432\u044b \u043d\u0430\u0431\u044b\u043b\u0456 \u043d\u0430\u0442\u0443\u0440\u0443, \u043f\u0430\u0434\u043e\u0431\u043d\u0443\u044e \u0434\u0430 \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430. \u0411\u043e\u0433, \u044f\u043a\u0456 \u043f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u044b\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0430\u0441 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u045e\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0421\u0442\u0430\u045e\u0448\u044b \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u0432\u044b \u0437\u0430\u0441\u043b\u0443\u0436\u0430\u043d\u0430 \u0437\u0430\u0432\u0435\u0446\u0435\u0441\u044f &laquo;\u043f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430\u043c\u0456&raquo;, \u0456 \u043f\u0440\u0430 \u0432\u0430\u0441 \u0441\u043a\u0430\u0437\u0430\u045e \u0411\u043e\u0433: &laquo;\u041d\u0435 \u0447\u0430\u043f\u0430\u0439\u0446\u0435 \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u0456\u043a\u0430\u045e \u041c\u0430\u0456\u0445&raquo; (\u041f\u0441 105 [104], 15).<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b \u0441\u0442\u0430\u043b\u0456 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044e \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0437\u043d\u0430\u043a \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0430 \u045e\u0441\u0451 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u0434\u043b\u044f \u0432\u0430\u0441 \u043f\u0440\u0430\u0437 \u0441\u0456\u043c\u0432\u0430\u043b, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0435\u0441\u044f \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430. \u0401\u043d \u0436\u0430 \u0431\u044b\u045e \u0430\u0431\u043c\u044b\u0442\u044b \u045e \u0432\u043e\u0434\u0430\u0445 \u042f\u0440\u0434\u0430\u043d\u0430 \u0456 \u0432\u044b\u0439\u0448\u0430\u045e \u0437 \u0456\u0445, \u043d\u0430\u0434\u0430\u045e\u0448\u044b \u0456\u043c \u0434\u0443\u0445\u043c\u044f\u043d\u044b \u0432\u043e\u0434\u0430\u0440 \u0441\u0432\u0430\u0451\u0439 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456. \u041f\u043e\u0442\u044b\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0441\u0443\u0442\u043d\u0430\u0441\u043d\u0430 \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u042f\u0433\u043e, \u0456 \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0441\u043f\u0430\u0447\u044b\u045e \u043d\u0430 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u043a \u0456 \u0432\u0430\u043c, \u043f\u0430\u0441\u043b\u044f \u0442\u0430\u0433\u043e \u044f\u043a \u0432\u044b \u0432\u044b\u0439\u0448\u043b\u0456 \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u0432\u043e\u0434\u0430\u045e \u043a\u0443\u043f\u0435\u043b\u0456, \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0431\u044b\u043b\u043e \u0445\u0440\u044b\u0437\u043c\u0430, \u044f\u043a\u043e\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u043d\u0430\u043a\u0430\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456\u043c \u0431\u044b\u045e \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u041f\u0440\u0430 \u042f\u0433\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0406\u0441\u0430\u044f \u045e \u0441\u0432\u0430\u0456\u043c \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0435 \u043f\u0440\u0430 \u0430\u0441\u043e\u0431\u0443 \u041f\u0430\u043d\u0430: &laquo;\u0414\u0443\u0445 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u043d\u0430 \u043c\u043d\u0435, \u0431\u043e \u041f\u0430\u043d \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u043c\u044f\u043d\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0434\u043e\u0431\u0440\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443 \u045e\u0431\u043e\u0433\u0456\u043c&raquo; (\u0406\u0441 61, 1).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u043d\u0435 \u043b\u044e\u0434\u0437\u0456 \u043f\u0430\u043c\u0430\u0437\u0430\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u043b\u0435\u0435\u043c, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043c\u0430\u0437\u0437\u044e \u0434\u043b\u044f \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0410\u0439\u0446\u0435\u0446, \u0443\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u042f\u0433\u043e \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0443\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443, \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u042f\u0433\u043e \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u044f\u043a \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u0432. \u041f\u0451\u0442\u0440: &laquo;\u0415\u0437\u0443\u0441\u0430 \u0437 \u041d\u0430\u0437\u0430\u0440\u044d\u0442\u0430 \u0411\u043e\u0433 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c&raquo; (\u043f\u0430\u0440. \u0414\u0437 10, 38). \u041f\u0440\u0430\u0440\u043e\u043a \u0414\u0430\u0432\u0456\u0434 \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u045e: &laquo;\u0422\u0440\u043e\u043d \u0422\u0432\u043e\u0439, \u0411\u043e\u0436\u0430, \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0435 \u0436\u0430\u0437\u043b\u043e &ndash; \u0436\u0430\u0437\u043b\u043e \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0422\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0437\u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0435\u045e \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435, \u0442\u0430\u043c\u0443 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0446\u044f\u0431\u0435 \u0411\u043e\u0433, \u0442\u0432\u043e\u0439 \u0411\u043e\u0433, \u0430\u043b\u0435\u0435\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0442\u0432\u0430\u0456\u0445&raquo; (\u041f\u0441 45 [44], 7-8).<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0431\u044b\u045e \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u043d\u044b \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0430\u043b\u0435\u0435\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u044f\u043a\u0456 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u043b\u0435\u0435\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0431\u043e \u0441\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u0456. \u0410 \u0432\u044b, \u043f\u0430\u043c\u0430\u0437\u0430\u043d\u044b\u044f \u0445\u0440\u044b\u0437\u043c\u0430\u043c, \u0441\u0442\u0430\u043b\u0456 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0456 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u043d\u0435 \u043b\u0456\u0447\u044b\u0446\u0435 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c \u0456 \u043d\u044f\u0432\u0430\u0440\u0442\u044b\u043c \u0433\u044d\u0442\u044b \u0430\u043b\u0435\u0439. \u0413\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u044b \u0430\u043b\u0435\u0439, \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b. \u041f\u0430\u0441\u043b\u044f \u0437\u0430\u043a\u043b\u0456\u043a\u0443 \u0451\u043d \u0443\u0436\u043e \u043d\u0435 \u043f\u0440\u043e\u0441\u0442\u044b \u0430\u043b\u0435\u0439, \u0430\u043b\u0435 \u0433\u044d\u0442\u0430 \u045e\u0436\u043e \u0434\u0430\u0440 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0434\u0437\u0435\u0439\u0441\u043d\u044b\u043c, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0411\u043e\u0441\u0442\u0432\u0430. \u0422\u0432\u0430\u0451 \u0447\u0430\u043b\u043e \u0456 \u0442\u0432\u0430\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0456 \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0447\u043d\u0430 \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u044e\u0446\u0446\u0430 \u0430\u043b\u0435\u0435\u043c. \u0423 \u0442\u043e\u0439 \u0447\u0430\u0441, \u044f\u043a \u0456\u043c \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u0435\u0446\u0446\u0430 \u0431\u0430\u0447\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u0434\u0443\u0448\u0430 \u0430\u0441\u0432\u044f\u0447\u0430\u0435\u0446\u0446\u0430 \u0436\u044b\u0432\u0430\u0442\u0432\u043e\u0440\u043d\u044b\u043c \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 1, 13b-14; 2 \u041a\u0430\u0440 1, 21b-22<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0432\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456, \u0431\u044b\u043b\u0456 \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u044f \u043f\u044f\u0447\u0430\u0446\u0446\u044e \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0433\u0430 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0437\u0430\u0434\u0430\u0442\u043a\u0430\u043c \u043d\u0430\u0448\u0430\u0439 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b, <span style=\"color: #ff0000;\">*<\/span> \u0434\u0437\u0435\u043b\u044f \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043d\u0430\u0431\u044b\u0442\u043a\u0443, \u0434\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0456 \u043f\u0430\u0437\u043d\u0430\u0447\u044b\u045e \u043d\u0430\u0441, \u0434\u0430\u044e\u0447\u044b \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0414\u0443\u0445\u0430 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u043d\u0430\u0448\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0437\u0435\u043b\u044f \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u043d\u0430\u0431\u044b\u0442\u043a\u0443, \u0434\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5017","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0456\u044f \u043a\u0430\u0442\u044d\u0445\u0435\u0437\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cat. 22, Mystagogica 4, 1. 3-6. 9: PG 33, 1098-1106)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u044f\u0431\u0435\u0441\u043d\u044b \u0445\u043b\u0435\u0431 \u0456 \u043a\u0435\u043b\u0456\u0445 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0443 \u0442\u0443\u044e \u043d\u043e\u0447, \u043a\u0430\u043b\u0456 \u0431\u044b\u045e \u0432\u044b\u0434\u0430\u0434\u0437\u0435\u043d\u044b, \u0443\u0437\u044f\u045e \u0445\u043b\u0435\u0431, \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u0432\u0430\u045e, \u043f\u0430\u043b\u0430\u043c\u0430\u045e \u0456 \u0434\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u043c \u0441\u0432\u0430\u0456\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: &ldquo;\u0411\u044f\u0440\u044b\u0446\u0435, \u0435\u0448\u0446\u0435; \u0433\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u0426\u0435\u043b\u0430 \u041c\u0430\u0451. \u0413\u044d\u0442\u0430 \u0447\u044b\u043d\u0456\u0446\u0435 \u043d\u0430 \u041c\u0430\u044e \u043f\u0430\u043c\u044f\u0446\u044c&rdquo;. \u0423\u0437\u044f\u045e\u0448\u044b \u043a\u0435\u043b\u0456\u0445 \u0456 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u0432\u0430\u045e\u0448\u044b, \u0441\u043a\u0430\u0437\u0430\u045e: &ldquo;\u0411\u044f\u0440\u044b\u0446\u0435, \u043f\u0456\u0446\u0435; \u0433\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u041a\u0440\u043e\u045e \u041c\u0430\u044f&rdquo;&raquo; (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 11, 23). \u041a\u0430\u043b\u0456 \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0445\u043b\u0435\u0431: &laquo;\u0413\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u0426\u0435\u043b\u0430 \u041c\u0430\u0451&raquo;, \u0445\u0442\u043e \u0436 \u0430\u0441\u043c\u0435\u043b\u0456\u0446\u0446\u0430 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430? \u041a\u0430\u043b\u0456 \u0441\u0430\u043c \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u045e \u0456 \u0441\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u045e: &laquo;\u0413\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u041a\u0440\u043e\u045e \u041c\u0430\u044f&raquo;, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430, \u043a\u0430\u0436\u0443\u0447\u044b, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u043d\u0435 \u042f\u0433\u043e\u043d\u0430\u044f \u041a\u0440\u043e\u045e?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u044b \u0437 \u0443\u0441\u0451\u0439 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u0430\u0441\u0446\u044e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435\u043c \u0456\u0445 \u044f\u043a \u0426\u0435\u043b\u0430 \u0456 \u041a\u0440\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430. \u0423 \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0445\u043b\u0435\u0431\u0430 \u0442\u0430\u0431\u0435 \u0434\u0430\u0435\u0446\u0446\u0430 \u0426\u0435\u043b\u0430, \u0430 \u045e \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0432\u0456\u043d\u0430 \u0442\u0430\u0431\u0435 \u0434\u0430\u0435\u0446\u0446\u0430 \u041a\u0440\u043e\u045e, \u043a\u0430\u0431 \u043f\u0430\u0434\u0447\u0430\u0441 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043d\u043d\u044f \u0426\u0435\u043b\u0430 \u0456 \u041a\u0440\u044b\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0442\u044b \u0441\u0442\u0430\u045e \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u042f\u0433\u043e \u0426\u0435\u043b\u0430 \u0456 \u041a\u0440\u044b\u0432\u0456. \u0422\u0430\u043a \u043c\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u043c\u0441\u044f \u043d\u043e\u0441\u044c\u0431\u0456\u0442\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u045e \u043d\u0430\u0448\u044b\u0445 \u0446\u0435\u043b\u0430\u0445 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u042f\u0433\u043e \u0426\u0435\u043b\u0430 \u0456 \u041a\u0440\u043e\u045e. \u0422\u0430\u043a, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430, \u043c\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u043c\u0441\u044f \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0431\u043e\u0441\u043a\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0430\u043b\u0435\u043c\u0456\u0437\u0443\u044e\u0447\u044b \u0437 \u044e\u0434\u044d\u044f\u043c\u0456, \u043a\u0430\u0437\u0430\u045e: &laquo;\u041a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u041c\u0430\u0439\u0433\u043e \u0426\u0435\u043b\u0430 \u0456 \u043f\u0456\u0446\u044c \u041c\u0430\u0451\u0439 \u041a\u0440\u044b\u0432\u0456, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043c\u0435\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u0436\u044b\u0446\u0446\u044f&raquo; (\u043f\u0430\u0440. \u042f\u043d 6, 53). \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u044b \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0441\u044d\u043d\u0441\u0443 \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0433\u0430, \u0430\u0434\u044b\u0448\u043b\u0456 \u043f\u0430\u043a\u0440\u044b\u045e\u0434\u0436\u0430\u043d\u044b\u044f, \u0434\u0443\u043c\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0401\u043d \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u0456\u0445 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0446\u0435\u043b\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0421\u0442\u0430\u0440\u044b\u043c \u0417\u0430\u043f\u0430\u0432\u0435\u0446\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0456 \u0430\u0445\u0432\u044f\u0440\u043d\u044b\u044f \u0445\u043b\u044f\u0431\u044b, \u0430\u043b\u0435 \u0441\u043a\u043e\u043d\u0447\u044b\u043b\u0456\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0434\u0437\u0435\u044f\u043d\u043d\u0435\u043c \u0421\u0442\u0430\u0440\u043e\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443. \u0423 \u041d\u043e\u0432\u044b\u043c \u0417\u0430\u043f\u0430\u0432\u0435\u0446\u0435 \u0445\u043b\u0435\u0431 &ndash; \u043d\u044f\u0431\u0435\u0441\u043d\u044b, \u0430 \u043a\u0435\u043b\u0456\u0445 &ndash; \u0437\u0431\u0430\u0432\u0435\u043d\u043d\u044b, \u0456 \u044f\u043d\u044b \u0430\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u044c \u0434\u0443\u0448\u0443 \u0456 \u0446\u0435\u043b\u0430. \u0411\u043e \u044f\u043a \u0445\u043b\u0435\u0431 &ndash; \u0433\u044d\u0442\u0430 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0434\u043b\u044f \u0446\u0435\u043b\u0430, \u0442\u0430\u043a \u0456 \u0421\u043b\u043e\u0432\u0430 \u043f\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u043b\u044f \u0434\u0443\u0448\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0433\u043b\u044f\u0434\u0437\u0456, \u043d\u0435 \u043b\u0456\u0447\u044b \u044d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0447\u043d\u0430\u0433\u0430 \u0445\u043b\u0435\u0431\u0430 \u0456 \u0432\u0456\u043d\u0430 \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0456 \u0456 \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u043c\u0456 \u0440\u044d\u0447\u044b\u0432\u0430\u043c\u0456, \u0431\u043e \u0433\u044d\u0442\u0430 \u0426\u0435\u043b\u0430 \u0456 \u041a\u0440\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u041f\u0430\u043d. \u041a\u0430\u043b\u0456 \u043d\u0430\u0432\u0430\u0442 \u043f\u0430\u0447\u0443\u0446\u0446\u0456 \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u044e\u0446\u044c \u0446\u044f\u0431\u0435 \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u0446\u0446\u0430, \u0442\u043e \u0432\u0435\u0440\u0430 \u043f\u0435\u0440\u0430\u043a\u043e\u043d\u0432\u0430\u0435 \u0446\u044f\u0431\u0435 \u0456 \u0434\u0430\u0435 \u045e\u043f\u044d\u045e\u043d\u0435\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0434\u043e\u0431\u0440\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u045e \u0456 \u0446\u0432\u0451\u0440\u0434\u0430 \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u0448\u0442\u043e \u044d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0447\u043d\u044b \u0445\u043b\u0435\u0431, \u0445\u043e\u0446\u044c \u043c\u0430\u0435 \u0441\u043c\u0430\u043a \u0445\u043b\u0435\u0431\u0430, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435 \u0445\u043b\u0435\u0431\u0430\u043c, \u0430\u043b\u0435 \u0426\u0435\u043b\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c. \u0413\u044d\u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u044d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0447\u043d\u0430\u0435 \u0432\u0456\u043d\u043e, \u0445\u043e\u0446\u044c \u043c\u0430\u0435 \u0441\u043c\u0430\u043a \u0432\u0456\u043d\u0430, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435 \u0432\u0456\u043d\u043e\u043c, \u0430\u043b\u0435 \u041a\u0440\u043e\u045e\u044e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439. \u041f\u0440\u0430 \u0433\u044d\u0442\u0430 \u045e\u0436\u043e \u0434\u0430\u045e\u043d\u043e \u043a\u0430\u0437\u0430\u045e \u0414\u0430\u0432\u0456\u0434 \u0443 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u0445: &laquo;\u0410\u043b\u0435\u0439, \u0448\u0442\u043e \u0440\u043e\u0431\u0456\u0446\u044c \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u044b\u043c \u0442\u0432\u0430\u0440, \u0456 \u0445\u043b\u0435\u0431, \u0448\u0442\u043e \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u043b\u044e\u0434\u0441\u043a\u043e\u0435 \u0441\u044d\u0440\u0446\u0430&raquo; (\u041f\u0441 104 [103], 15). \u0423\u043c\u0430\u0446\u0443\u0439 \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430, \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u044e\u0447\u044b \u0433\u044d\u0442\u044b \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0445\u043b\u0435\u0431, \u0456 \u0440\u0430\u0437\u0432\u0435\u0441\u044f\u043b\u0456 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0441\u0432\u0430\u0451\u0439 \u0434\u0443\u0448\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u043c \u0442\u0432\u0430\u0440\u0430\u043c \u0456 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435\u043c \u0441\u0443\u0437\u0456\u0440\u0430\u0439 \u0441\u043b\u0430\u0432\u0443 \u041f\u0430\u043d\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0443, \u0456 \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0437\u044c \u0430\u0434 \u0441\u043b\u0430\u0432\u044b \u0434\u0430 \u0441\u043b\u0430\u0432\u044b \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, \u043d\u0430\u0448\u044b\u043c \u041f\u0430\u043d\u0443, \u044f\u043a\u043e\u043c\u0443 \u043f\u0430\u0448\u0430\u043d\u0430, \u0456 \u045e\u043b\u0430\u0434\u0430, \u0456 \u0441\u043b\u0430\u0432\u0430 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 22, 19; \u0417\u044b\u0445 12, 26-27\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0437\u044f\u045e\u0448\u044b \u0445\u043b\u0435\u0431, \u0415\u0437\u0443\u0441 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u0432\u0430\u045e, \u043f\u0430\u043b\u0430\u043c\u0430\u045e \u0456 \u0434\u0430\u045e \u044f\u0433\u043e \u0432\u0443\u0447\u043d\u044f\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: \u0413\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u0426\u0435\u043b\u0430 \u041c\u0430\u0451, \u044f\u043a\u043e\u0435 \u0437\u0430 \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0434\u0430\u043d\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0413\u044d\u0442\u0430 \u0447\u044b\u043d\u0456\u0446\u0435 \u043d\u0430 \u041c\u0430\u044e \u043f\u0430\u043c\u044f\u0446\u044c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0441\u043f\u044b\u0442\u0430\u044e\u0446\u0446\u0430 \u045e \u0432\u0430\u0441 \u0434\u0437\u0435\u0446\u0456 \u0432\u0430\u0448\u044b\u044f: \u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0430 \u0437\u0432\u044b\u0447\u0430\u0439 \u0443 \u0432\u0430\u0441? \u0412\u044b \u0430\u0434\u043a\u0430\u0436\u0430\u0446\u0435: \u0413\u044d\u0442\u0430 \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430 \u0434\u043b\u044f \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u0447\u044b\u043d\u0456\u0446\u0435 \u043d\u0430 \u041c\u0430\u044e \u043f\u0430\u043c\u044f\u0446\u044c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5021","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 8 in octava Paschae 1. 4: PL 46, 838, 841)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u043e\u0432\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0432\u044f\u0440\u0442\u0430\u044e\u0441\u044f \u0434\u0430 \u0432\u0430\u0441, \u043d\u043e\u0432\u0430\u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f \u0434\u0437\u0435\u0446\u0456, \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442\u044b \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u043d\u043e\u0432\u044b\u044f \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043b\u0430\u0441\u043a\u0430 \u0410\u0439\u0446\u0430, \u043f\u043b\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u041c\u0430\u0446\u0456, \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u044f \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0456, \u043d\u043e\u0432\u0430\u044f \u0433\u0440\u0430\u043c\u0430\u0434\u0430, \u043a\u0432\u0435\u0446\u0435\u043d\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u0433\u043e\u043d\u0430\u0440\u0443 \u0456 \u043f\u043b\u0451\u043d \u043f\u0440\u0430\u0446\u044b, \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456 \u0432\u044f\u043d\u0435\u0446 \u043c\u043e\u0439, \u0443\u0441\u0435 \u0432\u044b, \u044f\u043a\u0456\u044f \u0442\u0440\u044b\u0432\u0430\u0435\u0446\u0435 \u045e \u041f\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0432\u044f\u0440\u0442\u0430\u044e\u0441\u044f \u0434\u0430 \u0432\u0430\u0441 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430: &laquo;\u0410\u043f\u0440\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u045e \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043d\u0435 \u0434\u0430\u0433\u0430\u0434\u0436\u0430\u0439\u0446\u0435 \u0446\u0435\u043b\u0443 \u045e \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456&raquo; (\u0420\u044b\u043c 13, 14), \u043a\u0430\u0431 \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u045e \u0442\u0430\u0433\u043e, \u0443 \u043a\u0430\u0433\u043e \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0456\u0441\u044f \u043f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442. &laquo;\u0423\u0441\u0435 \u0432\u044b, \u0445\u0442\u043e \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u045e\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u043f\u0440\u0430\u043d\u0443\u043b\u0456\u0441\u044f. \u041d\u044f\u043c\u0430 \u045e\u0436\u043e \u043d\u0456 \u044e\u0434\u044d\u044f, \u043d\u0456 \u0433\u0440\u044d\u043a\u0430; \u043d\u044f\u043c\u0430 \u043d\u0456 \u0440\u0430\u0431\u0430, \u043d\u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u0430\u0433\u0430; \u043d\u044f\u043c\u0430 \u043d\u0456 \u043c\u0443\u0436\u0447\u044b\u043d\u044b, \u043d\u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u0431\u043e \u045e\u0441\u0435 \u0432\u044b \u0430\u0434\u043d\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435&raquo; (\u0413\u0430\u043b 3, 27-28).<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u044b\u043c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u043c\u043e\u0446 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0443, \u0431\u043e \u0433\u044d\u0442\u0430 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u043d\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u0435 \u043f\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u045e \u0433\u044d\u0442\u044b \u0447\u0430\u0441 \u0437 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u044f \u045e\u0441\u0456\u0445 \u043c\u0456\u043d\u0443\u043b\u044b\u0445 \u0433\u0440\u0430\u0445\u043e\u045e, \u0430 \u0437\u0430\u0432\u044f\u0440\u0448\u0430\u0435\u0446\u0446\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435\u043c \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. &laquo;\u041c\u044b \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0445\u0440\u044b\u0448\u0447\u044d\u043d\u043d\u0435\u043c \u0443 \u0441\u043c\u0435\u0440\u0446\u044c, \u043a\u0430\u0431, \u044f\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0442\u0430\u043a \u0456 \u043d\u0430\u043c \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0430\u0431\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456&raquo; (\u043f\u0430\u0440. \u0420\u044b\u043c 6, 4).<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u043f\u0435\u0440 \u0432\u044b \u0456\u0434\u0437\u0435\u0446\u0435 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u043f\u0430\u043a\u0443\u043b\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0446\u0435\u043b\u0435 \u0432\u0430\u043d\u0434\u0440\u0443\u0435\u0446\u0435 \u044f\u0448\u0447\u044d \u0434\u0430\u043b\u0451\u043a\u0430 \u0430\u0434 \u041f\u0430\u043d\u0430, \u0430\u043b\u0435 \u0434\u0430\u0440\u043e\u0433\u0430 \u0432\u0430\u0448\u0430 \u043f\u044d\u045e\u043d\u0430\u044f \u0456 \u0451\u0441\u0446\u044c \u0451\u044e \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435\u0446\u0435\u0441\u044f \u0456 \u044f\u043a\u0456 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0441\u0442\u0430\u0446\u044c \u0434\u0437\u0435\u043b\u044f \u0432\u0430\u0441 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c. \u041f\u0430\u043d \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043a\u0430\u0440\u0431\u044b \u0434\u043b\u044f \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u0430\u0456\u0446\u0446\u0430 \u042f\u0433\u043e. \u0401\u043d \u0430\u0434\u043a\u0440\u044b\u0435 \u0456\u0445 \u0456 \u0430\u0441\u044b\u043f\u043b\u0435 \u0456\u043c\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u042f\u0433\u043e, \u043a\u0430\u043b\u0456 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u043c \u0443 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0441\u0446\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0446\u044f\u043f\u0435\u0440 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e \u043d\u0430\u0434\u0437\u0435\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f \u0432\u043e\u0441\u044c\u043c\u044b \u0434\u0437\u0435\u043d\u044c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0432\u0430\u0448\u0430\u0433\u0430, \u0441\u0451\u043d\u043d\u044f \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u045e \u0432\u0430\u0441 \u0437\u043d\u0430\u043a \u0432\u0435\u0440\u044b. \u0423 \u043d\u0430\u0448\u044b\u0445 \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u044b\u0445 \u0430\u0439\u0446\u043e\u045e \u0433\u044d\u0442\u044b\u043c \u0437\u043d\u0430\u043a\u0430\u043c \u0431\u044b\u043b\u043e \u0430\u0431\u0440\u0430\u0437\u0430\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0440\u0430\u0431\u0456\u043b\u0430\u0441\u044f \u043d\u0430 \u0432\u043e\u0441\u044c\u043c\u044b \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u0441\u043b\u044f \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u0456 \u0441\u0430\u043c \u041f\u0430\u043d, \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u043f\u0430\u0437\u0431\u044b\u045e\u0448\u044b\u0441\u044f \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e\u0448\u044b \u044f\u0433\u043e \u045e\u0436\u043e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c, \u043f\u0430\u0437\u043d\u0430\u0447\u044b\u045e \u043d\u044f\u0434\u0437\u0435\u043b\u044e \u0441\u0432\u0430\u0456\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435\u043c. \u0413\u044d\u0442\u0430 \u0431\u044b\u045e \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u0441\u043b\u044f \u042f\u0433\u043e \u043c\u0443\u043a\u0456, \u0430 \u0432\u043e\u0441\u044c\u043c\u044b \u043f\u0430\u0441\u043b\u044f \u0448\u0430\u0431\u0430\u0442\u0443, \u0456 \u0451\u043d \u0436\u0430 \u0434\u0437\u0435\u043d\u044c \u043f\u0435\u0440\u0448\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0456 \u0432\u044b \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0435\u0446\u0435 \u045e \u0433\u044d\u0442\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u0446\u0430\u043b\u043a\u0430\u043c, \u0430\u043b\u0435 \u045e \u0446\u0432\u0451\u0440\u0434\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456, \u0431\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0414\u0443\u0445\u0430. &laquo;\u041a\u0430\u043b\u0456 \u0436 \u0432\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430; \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0430 \u043d\u0435 \u043f\u0440\u0430 \u0437\u044f\u043c\u043d\u043e\u0435, \u0431\u043e \u0432\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0456 \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u0411\u043e\u0433\u0443. \u041a\u0430\u043b\u0456 \u0436 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435, \u0442\u0430\u0434\u044b \u0456 \u0432\u044b \u0437&rsquo;\u044f\u0432\u0456\u0446\u0435\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443 \u0445\u0432\u0430\u043b\u0435&raquo; (\u041a\u043b\u0441 3, 1-4).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 3, 3-4; \u0420\u044b\u043c 6, 11<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0456 \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435 \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u0411\u043e\u0433\u0443. <span style=\"color: #ff0000;\">*<\/span> \u041a\u0430\u043b\u0456 \u0436 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435, \u0442\u0430\u0434\u044b \u0456 \u0432\u044b \u0437&rsquo;\u044f\u0432\u0456\u0446\u0435\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443 \u0445\u0432\u0430\u043b\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041b\u0456\u0447\u044b\u0446\u0435 \u0441\u044f\u0431\u0435 \u043c\u0451\u0440\u0442\u0432\u044b\u043c\u0456 \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443, \u0430 \u0436\u044b\u0432\u044b\u043c\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0436 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430\u0435, \u0442\u0430\u0434\u044b \u0456 \u0432\u044b \u0437&rsquo;\u044f\u0432\u0456\u0446\u0435\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443 \u0445\u0432\u0430\u043b\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5022","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u044f \u0433\u0430\u043c\u0456\u043b\u0456\u044f&raquo; \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u0430\u0433\u0430 \u0430\u045e\u0442\u0430\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(PG 59; 723-724)<\/span><br \/><span style=\"color: #ff0000;\">\u0414\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u041f\u0430\u0441\u0445\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u0445\u0430, \u044f\u043a\u0443\u044e \u043c\u044b \u0430\u0434\u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u043b\u0456, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u044e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u043f\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b \u0430\u0434 \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u0431\u044b\u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0456 \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b \u0432\u0430 \u045e\u0441\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u0441\u0442\u043a\u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u0445 \u0440\u044d\u0447\u0430\u045e \u0456 \u0442\u044b\u044f \u0447\u0430\u0441\u043e\u0432\u044b\u044f \u0440\u044d\u0447\u044b \u0431\u044b\u043b\u0456 \u0437\u0430\u0434\u0443\u043c\u0430\u043d\u044b\u044f \u0440\u0430\u043d\u0435\u0439 \u044f\u043a \u0432\u043e\u0431\u0440\u0430\u0437\u044b \u0456 \u0441\u0456\u043c\u0432\u0430\u043b\u044b \u0432\u0435\u0447\u043d\u044b\u0445 \u0440\u044d\u0447\u0430\u045e, \u043a\u0430\u0431 \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0443, \u044f\u043a\u0430\u044f \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0446\u044f\u043f\u0435\u0440. \u0410 \u045e \u0442\u043e\u0439 \u0447\u0430\u0441, \u043a\u0430\u043b\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u045e\u0434\u0430, \u0441\u0456\u043c\u0432\u0430\u043b \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u0430\u0441\u0442\u0443\u043f\u0456\u0446\u044c, \u0431\u043e \u043f\u0430\u0434\u0447\u0430\u0441 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u043a\u0430\u0440\u0430\u043b\u044f \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0430\u0441\u043c\u0435\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0430\u043a\u0456\u043d\u0443\u0446\u044c \u044f\u0433\u043e, \u0436\u044b\u0432\u043e\u0433\u0430, \u043a\u0430\u0431 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u044f\u0433\u043e\u043d\u0430\u043c\u0443 \u0432\u043e\u0431\u0440\u0430\u0437\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0443\u0442 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u044f\u0441\u043d\u0430, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u0456\u043c\u0432\u0430\u043b \u0441\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0431\u043e \u0441\u0456\u043c\u0432\u0430\u043b \u0430\u0437\u043d\u0430\u0447\u0430\u045e \u043a\u0430\u0440\u043e\u0442\u043a\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u044e\u0434\u044d\u0439\u0441\u043a\u0456\u0445 \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u0445, \u0430 \u043f\u0440\u0430\u045e\u0434\u0430 &ndash; \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u043d\u0430 \u043a\u0430\u0440\u043e\u0442\u043a\u0456 \u0447\u0430\u0441 \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0435 \u0441\u043c\u0435\u0440\u0446\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0445\u0443\u0442\u043a\u0430 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u0443\u0434\u0437\u0435 \u043f\u0430\u043c\u0435\u0440\u0446\u0456. \u0412\u0435\u043b\u0456\u0447 \u0443\u043b\u0430\u0441\u043d\u0430 \u045e \u0442\u044b\u043c, \u043a\u0430\u0431 \u043f\u0430\u0437\u0431\u0435\u0433\u043d\u0443\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u0456 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0433\u044d\u0442\u0430 \u0437\u0434\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u0437 \u043d\u0430\u043c\u0456, \u0434\u0437\u0435\u043b\u044f \u044f\u043a\u0456\u0445 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0431\u044b\u045e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b \u044f\u043a \u041f\u0430\u0441\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043c\u0430 \u043d\u0430\u0437\u0432\u0430 \u0441\u0432\u044f\u0442\u0430, \u043a\u0430\u043b\u0456 \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u044f\u0433\u043e \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u0430\u0439 \u0443 \u0456\u043c \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u0437 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044e. \u041f\u0430\u0441\u0445\u0430 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u043f\u0440\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435 \u043c\u0456\u043c\u0430, \u043f\u0430\u0434\u0447\u0430\u0441 \u044f\u043a\u043e\u0433\u0430 \u0430\u043d\u0451\u043b \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f \u0430\u0431\u043c\u0456\u043d\u0443\u045e \u0434\u0430\u043c\u044b \u0433\u0430\u0431\u0440\u044d\u044f\u045e, \u0430 \u043f\u0430\u0437\u0430\u0431\u0456\u0432\u0430\u045e \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u0445 \u0415\u0433\u0456\u043f\u0442\u0430. \u041f\u0440\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435 \u043c\u0456\u043c\u0430 \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0441\u0442\u0430\u043b\u0430 \u043f\u0440\u0430\u045e\u0434\u0430\u044e \u0456 \u045e \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u043d\u0430\u0441, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0451\u043d \u043f\u0440\u0430\u0439\u0448\u043e\u045e \u043c\u0456\u043c\u0430, \u043d\u0435 \u0437\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0448\u044b \u043d\u0430\u0441, \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0448\u0430\u043d\u044b\u0445 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u0430 \u041f\u0430\u0441\u0445\u0456 \u0456 \u0432\u044b\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u044f \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u0445 \u043b\u0456\u0447\u044b\u043b\u0430\u0441\u044f \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u043d\u043e\u0432\u0430\u0433\u0430 \u0433\u043e\u0434\u0430. \u0428\u0442\u043e \u0436 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0433\u044d\u0442\u0430 \u045e \u0434\u0430\u0447\u044b\u043d\u0435\u043d\u043d\u0456 \u0434\u0430 \u043f\u0440\u0430\u045e\u0434\u044b? \u0410\u0437\u043d\u0430\u0447\u0430\u0435, \u0448\u0442\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u0430\u0445\u0432\u044f\u0440\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u041f\u0430\u0441\u0445\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u043d\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u043e\u0434 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0456\u043c\u0432\u0430\u043b\u0430\u043c \u0432\u0435\u043a\u0443, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e, \u0430\u0431\u044f\u0433\u0430\u044e\u0447\u044b \u043a\u043e\u043b\u0430, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0456 \u043d\u0435 \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0435 \u045e \u043a\u0430\u043d\u0446\u044b. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a \u0410\u0439\u0446\u0435\u0446 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0432\u0435\u043a\u0443, \u0431\u044b\u045e \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u044b \u0437\u0430 \u043d\u0430\u0441 \u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u0456, \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u045e\u0448\u044b \u043d\u0430\u0448\u0430\u0435 \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0434\u0430\u045e \u043d\u0430\u043c \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u043d\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u043f\u0440\u0430\u0437 \u043a\u0443\u043f\u0435\u043b\u044c \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f &ndash; \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u042f\u0433\u043e \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043a\u043e\u0436\u043d\u044b \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u043f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430 \u0431\u044b\u043b\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u0430 \u0437\u0430 \u044f\u0433\u043e, \u0456 \u043d\u044f\u0445\u0430\u0439 \u0430\u0434\u043b\u0456\u0447\u0432\u0430\u0435 \u0441\u0432\u0430\u0451 \u043d\u043e\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0430\u0434 \u043c\u043e\u043c\u0430\u043d\u0442\u0443, \u043a\u0430\u043b\u0456 \u0437\u0430 \u043d\u0430\u0441 \u0431\u044b\u045e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0421\u0430\u043c\u0430 \u0430\u0445\u0432\u044f\u0440\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0437\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0451\u043d \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u043b\u0430\u0441\u043a\u0443 \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0437\u043d\u0430\u045e\u0448\u044b \u0433\u044d\u0442\u0430, \u0442\u0440\u044d\u0431\u0430 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0437\u0430\u0447\u0430\u0442\u0430\u043a \u043d\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0432\u044f\u0440\u0442\u0430\u0446\u0446\u0430 \u0434\u0430 \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u043c\u0443 \u043d\u0430\u0441\u0442\u0430\u045e \u043a\u0430\u043d\u0435\u0446. &laquo;\u041a\u0430\u043b\u0456 \u043c\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443, \u044f\u043a \u0436\u0430 \u043c\u043e\u0436\u0430\u043c \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0436\u044b\u0446\u044c \u0443 \u0456\u043c?&raquo; (\u0420\u044b\u043c 6, 2).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 5, 7-8\u0430; \u0420\u044b\u043c 4, 25<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0447\u044b\u0441\u0446\u0456\u0446\u0435 \u0441\u0442\u0430\u0440\u0443\u044e \u0437\u0430\u043a\u0432\u0430\u0441\u043a\u0443, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0432\u0430\u043c \u043d\u043e\u0432\u044b\u043c \u0446\u0435\u0441\u0442\u0430\u043c, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u041f\u0430\u0441\u0445\u0430 \u043d\u0430\u0448\u0430\u044f, \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b \u0437\u0430 \u043d\u0430\u0441. <span style=\"color: #ff0000;\">*<\/span> \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u0443 \u041f\u0430\u043d\u0443, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d \u0431\u044b\u045e \u0432\u044b\u0434\u0430\u0434\u0437\u0435\u043d\u044b \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0448\u0430\u043d\u044b \u0434\u0437\u0435\u043b\u044f \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u0443 \u041f\u0430\u043d\u0443, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5023","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 &laquo;\u0414\u0430 \u041c\u0430\u043d\u0456\u043c\u0430&raquo; \u0441\u0432. \u0424\u0443\u043b\u044c\u0433\u0435\u043d\u0442\u044b\u044f \u0420\u0443\u0441\u043f\u0435\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 2, 11-12: CCL 91, 46-48)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u0431\u0443\u0434\u043e\u045e\u043b\u044f \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456, \u044f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0451\u0442\u0440: &laquo;\u0416\u044b\u0432\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456 \u0431\u0443\u0434\u0443\u044e\u0446\u0446\u0430 \u045e \u0434\u043e\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b, \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u044f\u0442\u043e\u0435, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u044f \u0411\u043e\u0433\u0443&raquo; (1 \u041f 2, 5). \u0423\u043b\u0430\u0441\u0446\u0456\u0432\u0430\u0439 \u043c\u044d\u0442\u0430\u0439 \u0433\u044d\u0442\u0430\u0439 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0431\u0443\u0434\u043e\u045e\u043b\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0435 \u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u044f\u043a \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u043d\u043d\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b, \u0443 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u044b \u0426\u0435\u043b\u0430 \u0456 \u041a\u0440\u044b\u0432\u0456, \u0431\u043e &laquo;\u043a\u0435\u043b\u0456\u0445 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u044f\u043a\u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c, \u0446\u0456 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0434\u0437\u0435\u043b\u0430\u043c \u0443 \u041a\u0440\u044b\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430? \u0425\u043b\u0435\u0431, \u044f\u043a\u0456 \u043b\u0430\u043c\u0430\u0435\u043c, \u0446\u0456 \u0436 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0434\u0437\u0435\u043b\u0430\u043c \u0443 \u0426\u0435\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0430? \u0410\u0434\u0437\u0456\u043d \u0451\u0441\u0446\u044c \u0445\u043b\u0435\u0431, \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430 &ndash; \u043c\u044b \u043c\u043d\u043e\u0433\u0456\u044f. \u0411\u043e \u043c\u044b \u045e\u0441\u0435 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u0445\u043b\u0435\u0431\u0430&raquo; (1 \u041a\u0430\u0440 10, 16-17).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u0442\u0430\u044f \u0436 \u043b\u0430\u0441\u043a\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c \u0446\u0435\u043b\u0430\u043c, \u0443\u0447\u044b\u043d\u0456\u043b\u0430, \u043a\u0430\u0431 \u0456 \u045e\u0441\u0435 \u0447\u043b\u0435\u043d\u044b \u043b\u044e\u0431\u043e\u0432\u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u044c \u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u0456 \u045e \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0436 \u0433\u043e\u0434\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u0433\u044d\u0442\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u045e \u043d\u0430\u0441, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0434\u0430\u0440\u0443 \u0414\u0443\u0445\u0430, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0414\u0443\u0445\u0430\u043c \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430. \u0421\u0432\u044f\u0442\u0430\u044f \u0422\u0440\u043e\u0439\u0446\u0430 \u043f\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0451\u0441\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044e, \u0440\u043e\u045e\u043d\u0430\u0441\u0446\u044e \u0456 \u043b\u044e\u0431\u043e\u045e\u044e. \u0421\u0432\u044f\u0442\u0430\u044f \u0422\u0440\u043e\u0439\u0446\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0430\u0434\u0437\u0456\u043d \u0456 \u0430\u0434\u0437\u0456\u043d\u044b \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u0441\u0432\u0430\u0451\u0439 \u043d\u0435\u043f\u0430\u0434\u0437\u0435\u043b\u044c\u043d\u0430\u0439 \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u044e \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430: &laquo;\u041b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u0432\u044b\u043b\u0456\u043b\u0430\u0441\u044f \u045e \u0441\u044d\u0440\u0446\u044b \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430\u043c&raquo; (\u0420\u044b\u043c 5, 5).<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b &ndash; \u0433\u044d\u0442\u0430 \u0430\u0434\u0437\u0456\u043d\u044b \u0414\u0443\u0445 \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430; \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u045e \u0442\u044b\u0445, \u043a\u0430\u043c\u0443 \u0434\u0430\u0435 \u043b\u0430\u0441\u043a\u0443 \u0411\u043e\u0436\u0430\u0433\u0430 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0442\u0430\u043a \u044f\u043a \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u045e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0442\u044b\u0445, \u0445\u0442\u043e, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430 \u045e \u043a\u043d\u0456\u0437\u0435 \u0414\u0437\u0435\u044f\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456\u0445, \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0442\u0430\u0433\u043e \u0436 \u0414\u0443\u0445\u0430. \u041f\u0440\u0430 \u0456\u0445 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430: &laquo;\u0423\u0441\u0435 \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e, \u0431\u044b\u043b\u0456 \u0430\u0434\u0437\u0456\u043d\u044b\u044f \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u0434\u0443\u0448\u043e\u044e&raquo; (\u0414\u0437 4, 32).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0456 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0440\u0443\u043f\u043b\u0456\u0432\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0414\u0443\u0445\u0430 \u0456 \u043f\u043e\u0432\u044f\u0437\u044c \u0441\u043f\u0430\u043a\u043e\u044e, \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0447\u044b \u042d\u0444\u0435\u0441\u0446\u0430\u045e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: &laquo;\u041c\u0430\u043b\u044e \u0432\u0430\u0441 \u044f, \u0432\u044f\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430, \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0433\u043e\u0434\u043d\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f, \u044f\u043a\u0456\u043c \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b, \u0437 \u0443\u0441\u0451\u044e \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e, \u0437 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0446\u0435\u0440\u043f\u044f\u0447\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0441\u0442\u0430\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e&raquo; (\u043f\u0430\u0440. \u042d\u0444 4, 1-4).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u0432\u0430\u044e \u043b\u044e\u0431\u043e\u045e, \u043f\u0430\u0448\u044b\u0440\u0430\u043d\u0443\u044e \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0430\u044e\u0447\u044b \u044f\u0433\u043e \u045e \u043f\u0440\u044b\u0435\u043c\u043d\u0443\u044e \u0441\u0430\u0431\u0435 \u0430\u0445\u0432\u044f\u0440\u0443. \u041d\u044f\u0445\u0430\u0439 \u041a\u0430\u0441\u0446\u0451\u043b \u0437\u0430\u045e\u0436\u0434\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0433\u044d\u0442\u0443\u044e \u043b\u0430\u0441\u043a\u0443 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u043f\u0440\u0430\u0437 \u044f\u0435 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0432\u043e\u0439, \u0441\u0432\u044f\u0442\u043e\u0439 \u0456 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0439 \u0411\u043e\u0433\u0443 \u0430\u0445\u0432\u044f\u0440\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 17, 20b. 21\u0430. 22. 18<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u0448\u0443, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e, \u044f\u043a \u0422\u044b, \u041e\u0439\u0447\u0430, \u0443\u0432\u0430 \u041c\u043d\u0435, \u0456 \u042f \u045e \u0422\u0430\u0431\u0435. \u0406 \u0441\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u0422\u044b \u0434\u0430\u045e \u041c\u043d\u0435, \u042f \u0434\u0430\u045e \u0456\u043c, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e, \u044f\u043a \u0456 \u041c\u044b \u0430\u0434\u043d\u043e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043a \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u043c\u044f\u043d\u0435 \u045e \u0441\u0432\u0435\u0442, \u0442\u0430\u043a \u0456 \u042f \u043f\u0430\u0441\u043b\u0430\u045e \u0456\u0445 \u0443 \u0441\u0432\u0435\u0442.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e, \u044f\u043a \u0456 \u041c\u044b \u0430\u0434\u043d\u043e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5024","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 12 de Passione, 3, 6-7: PL 54, 355-357)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0436\u044b\u0432\u0435 \u045e \u0441\u0432\u0430\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043d\u0435 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u044f\u045e, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430, \u043f\u0440\u044b\u043d\u044f\u0442\u0430\u044f \u0411\u043e\u0436\u044b\u043c \u0421\u044b\u043d\u0430\u043c, \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0442\u0430\u043a\u043e\u0439 \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u0456 \u0437 \u0406\u043c, \u0448\u0442\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0406\u043c, \u044f\u043a \u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u0443\u0441\u044f\u0433\u043e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u0430\u043b\u0435 \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445 \u042f\u0433\u043e \u0451\u0441\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0456 \u0442\u043e\u0439 \u0436\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0406 \u044f\u043a \u043d\u0435\u043b\u044c\u0433\u0430 \u0430\u0434\u0434\u0437\u044f\u043b\u0456\u0446\u044c \u0433\u0430\u043b\u0430\u0432\u0443 \u0430\u0434 \u0440\u044d\u0448\u0442\u044b \u0446\u0435\u043b\u0430, \u0442\u0430\u043a \u0456 \u0446\u0435\u043b\u0430 \u043d\u0435\u043b\u044c\u0433\u0430 \u0430\u0434\u0434\u0437\u044f\u043b\u0456\u0446\u044c \u0430\u0434 \u0433\u0430\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u045e\u0441\u0451 \u0432\u0430 \u045e\u0441\u0456\u043c \u043d\u0435 \u045e \u0433\u044d\u0442\u044b\u043c, \u0430\u043b\u0435 \u045e \u0432\u0435\u0447\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u0430\u0434\u043d\u0430\u043a \u0456 \u0446\u044f\u043f\u0435\u0440 \u0401\u043d \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0436\u044b\u0432\u0435 \u045e \u0441\u0432\u0430\u0451\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u044f\u043a\u043e\u0439 \u0451\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b, \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435\u043c: &laquo;\u042f \u0437 \u0432\u0430\u043c\u0456 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0430\u0436 \u0434\u0430 \u0441\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u044f \u0432\u0435\u043a\u0443&raquo; (\u041c\u0446 28, 20).<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451, \u0448\u0442\u043e \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u0434\u043b\u044f \u043f\u0440\u044b\u043c\u0456\u0440\u044d\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443 \u0456 \u0447\u0430\u043c\u0443 \u0432\u0443\u0447\u044b\u045e, \u043c\u044b \u0432\u0435\u0434\u0430\u0435\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0437 \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0456, \u0430\u043b\u0435 \u0456 \u0430\u0434\u0447\u0443\u0432\u0430\u0435\u043c \u0443 \u043c\u043e\u0446\u044b \u042f\u0433\u043e\u043d\u044b\u0445 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0401\u043d, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u0430\u0434 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0446\u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0441\u0432\u043e\u0439 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u043f\u043b\u0451\u043d\u0430\u043c \u0442\u0430\u0433\u043e \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u044f, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0445\u0440\u043e\u0441\u0442\u0443 \u043f\u0430\u045e\u0441\u0442\u0430\u043b\u0430 \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u0430\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445, \u043f\u0440\u0430 \u044f\u043a\u0456\u0445 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430: &laquo;\u0425\u0442\u043e \u043d\u0435 \u0430\u0434 \u043a\u0440\u044b\u0432\u0456, \u0456 \u043d\u0435 \u0430\u0434 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u0446\u0435\u043b\u0430, \u0456 \u043d\u0435 \u0430\u0434 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u043c\u0443\u0436\u0430, \u0430\u043b\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f&raquo; (\u042f\u043d 1, 13).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u045e \u0406\u043c \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0456 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0430 \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0431\u0430\u0446\u044c\u043a\u0430\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0441\u044b\u043d\u044b \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e\u0446\u0446\u0430 \u0430\u0434 \u0432\u0435\u0440\u044b, \u0430 \u043d\u0435 \u0430\u0434 \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0401\u043d \u0440\u043e\u0431\u0456\u0446\u044c \u0431\u0435\u0437 \u0432\u044b\u043a\u043b\u044e\u0447\u044d\u043d\u043d\u044f \u0437 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u043f\u0430\u0434 \u0441\u043e\u043d\u0446\u0430\u043c, \u0430\u0434\u043d\u0443 \u0441\u0432\u044f\u0442\u0443\u044e \u0430\u045e\u0447\u0430\u0440\u043d\u044e, \u0456 \u0442\u0430\u043a \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0431\u044f\u0446\u0430\u045e: &laquo;\u0401\u0441\u0446\u044c \u0443 \u041c\u044f\u043d\u0435 \u0456 \u0456\u043d\u0448\u044b\u044f \u0430\u0432\u0435\u0447\u043a\u0456, \u044f\u043a\u0456\u044f \u043d\u0435 \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0432\u0430\u0440\u0430. \u0406 \u0433\u044d\u0442\u044b\u0445 \u041c\u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456, \u0456 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u041c\u043e\u0439, \u0456 \u0431\u0443\u0434\u0437\u0435 \u0430\u0434\u0437\u0456\u043d \u0441\u0442\u0430\u0442\u0430\u043a \u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u0430\u0441\u0442\u044b\u0440&raquo; (\u042f\u043d 10, 16).<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0446\u044c \u0433\u0430\u043b\u043e\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043a\u0430\u0437\u0430\u045e \u0441\u0432. \u041f\u044f\u0442\u0440\u0443: &laquo;\u041f\u0430\u0441\u0456 \u0430\u0432\u0435\u0447\u0430\u043a \u041c\u0430\u0456\u0445&raquo; (\u042f\u043d 21, 17), \u0430\u0434\u043d\u0430\u043a \u0401\u043d \u0441\u0430\u043c \u043a\u0456\u0440\u0443\u0435 \u043f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0456\u043c \u043a\u043b\u043e\u043f\u0430\u0442\u0430\u043c, \u0430 \u043a\u043e\u0436\u043d\u0430\u0433\u0430, \u0445\u0442\u043e \u043f\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0433\u044d\u0442\u0430\u0439 \u0441\u043a\u0430\u043b\u044b, \u043a\u043e\u0440\u043c\u0456\u0446\u044c \u043d\u0430 \u045e\u0440\u0430\u0434\u043b\u0456\u0432\u044b\u0445 \u0456 \u0441\u0430\u043a\u0430\u0432i\u0442\u044b\u0445 \u043f\u0430\u0448\u0430\u0445, \u043a\u0430\u0431 \u043d\u0435\u0437\u043b\u0456\u0447\u043e\u043d\u044b\u044f \u0430\u0432\u0435\u0447\u043a\u0456, \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0442\u0443\u043a\u0430\u043c \u0411\u043e\u0436\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0431\u0435\u0437 \u0432\u0430\u0433\u0430\u043d\u043d\u044f\u045e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043b\u0456 \u0441\u044f\u0431\u0435 \u0434\u0437\u0435\u043b\u044f \u041f\u0430\u0441\u0442\u044b\u0440\u0430 \u0442\u0430\u043a, \u044f\u043a \u0441\u0430\u043c \u0414\u043e\u0431\u0440\u044b \u041f\u0430\u0441\u0442\u044b\u0440 \u0430\u0434\u0434\u0430\u045e \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u042f\u0433\u043e\u043d\u044b\u0445 \u043f\u0430\u043a\u0443\u0442\u0430\u0445 \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u044e\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u043b\u0430\u045e\u043d\u044b\u044f \u0456 \u043c\u0443\u0436\u043d\u044b\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0456, \u0430\u043b\u0435 \u0456 \u045e\u0441\u0435 \u0432\u0435\u0440\u043d\u044b\u044f, \u044f\u043a\u0456\u044f, \u0430\u0434\u0440\u0430\u0434\u0437\u0456\u045e\u0448\u044b\u0441\u044f \u045e \u0406\u043c, \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u043d\u043e\u0432\u044b\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u041f\u0430\u0441\u0445\u0430 \u041f\u0430\u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0441\u0432\u044f\u0442\u043a\u0443\u0435\u0446\u0446\u0430 \u0437 \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u0430\u043c\u0456 \u0448\u0447\u044b\u0440\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u044b, \u043a\u0430\u043b\u0456 \u043c\u044b, \u0430\u0434\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0437\u0430\u043a\u0432\u0430\u0441\u043a\u0443 \u0441\u0442\u0430\u0440\u043e\u0439 \u0433\u0440\u044d\u0448\u043d\u0430\u0441\u0446\u0456, \u043d\u0430\u0442\u0430\u043b\u044f\u0435\u043c\u0441\u044f \u0456 \u043d\u0430\u0441\u044b\u0447\u0430\u0435\u043c\u0441\u044f \u0441\u0430\u043c\u0456\u043c \u041f\u0430\u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u044e\u0447\u044b \u045e\u0434\u0437\u0435\u043b \u0443 \u0426\u0435\u043b\u0435 \u0456 \u041a\u0440\u044b\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u043c\u044b \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0430\u0435\u043c\u0441\u044f \u045e \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435\u043c. \u0422\u0430\u043c\u0443 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0435\u0440\u0430\u0434\u0443\u0441\u0456\u043c \u043d\u0430\u0441\u0456\u0446\u044c \u0443 \u0434\u0443\u0445\u0443 \u0456 \u0446\u0435\u043b\u0435 \u0442\u0430\u0433\u043e, \u0440\u0430\u0437\u0430\u043c \u0437 \u043a\u0456\u043c \u043c\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456, \u0431\u044b\u043b\u0456 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0448\u0430\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 10, 14; \u042d\u0437\u0445 34, 11. 13\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f &ndash; \u0434\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440 \u0456 \u0432\u0435\u0434\u0430\u044e \u0441\u0432\u0430\u0456\u0445,<span style=\"color: #ff0000;\"> *<\/span> \u0430 \u041c\u0430\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u041c\u044f\u043d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0441\u0430\u043c \u0431\u0443\u0434\u0443 \u0448\u0443\u043a\u0430\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a \u041c\u0430\u0456\u0445, \u0456 \u042f \u043f\u0435\u0440\u0430\u0433\u043b\u0435\u0434\u0436\u0443 \u0456\u0445, \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u044e \u0437 \u0443\u0441\u0456\u0445 \u043c\u0435\u0441\u0446\u0430\u045e, \u0432\u044b\u0432\u0435\u0434\u0443 \u0437 \u043d\u0430\u0440\u043e\u0434\u0430\u045e \u0456 \u0431\u0443\u0434\u0443 \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410 \u041c\u0430\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u041c\u044f\u043d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5025","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u0441\u0432. \u0413\u0430\u045e\u0434\u044d\u043d\u0446\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0411\u0440\u044d\u0448\u044b\u0456<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 2: CSEL 68, 30-32)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u043f\u0430\u0434\u0447\u044b\u043d\u043d\u044b \u0434\u0430\u0440 \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0431\u0435\u0441\u043d\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430, \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u043c, &ndash; \u0433\u044d\u0442\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u043d\u044b \u0434\u0430\u0440 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u044f\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0430\u043c \u044f\u043a \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u045e \u0442\u0443\u044e \u043d\u043e\u0447, \u043a\u0430\u043b\u0456 \u042f\u0433\u043e \u0430\u0434\u0434\u0430\u0432\u0430\u043b\u0456 \u043d\u0430 \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0448\u044b\u043c \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0430\u043c \u0443 \u0434\u0430\u0440\u043e\u0437\u0435, \u044f\u043a\u0456\u043c \u043c\u044b \u043a\u043e\u0440\u043c\u0456\u043c\u0441\u044f \u0456 \u0441\u0456\u043b\u043a\u0443\u0435\u043c\u0441\u044f \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0448\u043b\u044f\u0445\u0443, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0434\u043e\u0439\u0434\u0437\u0435\u043c \u0434\u0430 \u041f\u0430\u043d\u0430, \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0422\u0430\u043c\u0443 \u0441\u0430\u043c \u041f\u0430\u043d \u043a\u0430\u0437\u0430\u045e: &laquo;\u041a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0435\u0441\u0446\u0456 \u0426\u0435\u043b\u0430 \u041c\u0430\u0439\u0433\u043e \u0456 \u043f\u0456\u0446\u044c \u041a\u0440\u044b\u0432\u0456 \u041c\u0430\u0451\u0439, \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u043c\u0435\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u0436\u044b\u0446\u0446\u044f&raquo; (\u043f\u0430\u0440. \u042f\u043d 6, 53).<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0445\u0430\u0446\u0435\u045e, \u043a\u0430\u0431 \u042f\u0433\u043e \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b \u0437\u0430\u045e\u0436\u0434\u044b \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u045e \u043d\u0430\u0441. \u0401\u043d \u0445\u0430\u0446\u0435\u045e, \u043a\u0430\u0431 \u0434\u0443\u0448\u044b, \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u044f \u042f\u0433\u043e \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0439 \u041a\u0440\u044b\u0432\u0451\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0441\u0432\u044f\u0447\u0430\u043b\u0456\u0441\u044f \u044f\u043a \u0443\u0441\u043f\u0430\u043c\u0456\u043d \u042f\u0433\u043e\u043d\u0430\u0439 \u043c\u0443\u043a\u0456. \u0422\u0430\u043c\u0443 \u0434\u0430\u0440\u0443\u0447\u0430\u0435 \u0441\u0432\u0430\u0456\u043c \u0432\u0435\u0440\u043d\u044b\u043c \u0432\u0443\u0447\u043d\u044f\u043c, \u044f\u043a\u0456\u0445 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u043f\u0435\u0440\u0448\u044b\u043c\u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u043b\u0456 \u0433\u044d\u0442\u044b\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u0456\u044f \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0446\u044d\u043b\u0435\u0431\u0440\u0430\u0432\u0430\u0446\u044c \u0443\u0441\u0456\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c \u0432\u0430 \u045e\u0441\u0456\u0445 \u043a\u0430\u0441\u0446\u0451\u043b\u0430\u0445 \u0446\u044d\u043b\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u043f\u0430\u043a\u0443\u043b\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u043f\u0430\u045e\u0442\u043e\u0440\u043d\u0430 \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e. \u0413\u044d\u0442\u0430\u043a \u0456 \u0441\u0430\u043c\u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u044b, \u0456 \u045e\u0441\u0435 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u0430 \u043c\u0430\u044e\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u0447\u044b\u043c\u0430 \u0432\u043e\u0431\u0440\u0430\u0437 \u043c\u0443\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0430. \u041d\u043e\u0441\u044f\u0447\u044b \u044f\u0435 \u045e \u0440\u0443\u043a\u0430\u0445 \u0456 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u044e\u0447\u044b \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0456 \u0441\u044d\u0440\u0446\u0430\u043c, \u043c\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u043c \u043d\u0435\u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u0430\u043c\u044f\u0446\u044c \u043f\u0440\u0430 \u043d\u0430\u0448\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043b\u0435\u0431 \u0432\u044b\u0440\u0430\u0431\u043b\u044f\u0435\u0446\u0446\u0430 \u0437 \u043c\u043d\u043e\u0433\u0456\u0445 \u0437\u044f\u0440\u043d\u044f\u0442 \u043f\u0448\u0430\u043d\u0456\u0446\u044b, \u0437\u043c\u043e\u043b\u0430\u0442\u044b\u0445 \u0443 \u043c\u0443\u043a\u0443, \u044f\u043a\u0430\u044f \u0440\u0430\u0437\u0432\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0432\u0430\u0434\u043e\u044e \u0456 \u0432\u044b\u043f\u044f\u043a\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0430\u0433\u043d\u0456. \u0423 \u0433\u044d\u0442\u044b\u043c \u0432\u043e\u0431\u0440\u0430\u0437\u0435 \u0441\u043b\u0443\u0448\u043d\u0430 \u043c\u043e\u0436\u043d\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0426\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430, \u044f\u043a\u043e\u0435, \u044f\u043a \u0432\u0435\u0434\u0430\u0435\u043c, \u0443\u0442\u0432\u0430\u0440\u0430\u0435 \u0437 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u043b\u044e\u0434\u0437\u0435\u0439 \u0443\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0440\u043e\u0434\u0443 \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u0430\u0433\u043e\u043d\u044c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0434\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0430\u0434 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u042f\u043c\u0443 \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0443\u0441\u0451 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0435, \u0401\u043d \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0432\u043e\u0434\u044b \u0445\u0440\u043e\u0441\u0442\u0443, \u043a\u0430\u0431 \u0430\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0456\u0445, \u0430 \u043f\u043e\u0442\u044b\u043c, \u043f\u043e\u045e\u043d\u044b \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u042f\u0433\u043e \u045e \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0433\u043e\u043b\u0443\u0431\u0430, \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0437 \u042f\u0440\u0434\u0430\u043d\u0430, \u044f\u043a \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442: &laquo;\u0415\u0437\u0443\u0441, \u043d\u0430\u043fo\u045e\u043d\u0435\u043d\u044b \u0414\u0443\u0445a\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0437 \u042f\u0440\u0434a\u043d\u0430&raquo; (\u041b\u043a 4, 1).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0456 \u043f\u0440\u0430 \u0432\u0456\u043d\u043e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u041a\u0440\u044b\u0432\u0456. \u0421\u0430\u0431\u0440\u0430\u043d\u0430\u044f \u0437 \u043c\u043d\u043e\u0433\u0456\u0445 \u0433\u0440\u043e\u043d\u0430\u043a \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a\u0443, \u043f\u0430\u0441\u0430\u0434\u0436\u0430\u043d\u0430\u0433\u0430 \u0406\u043c, \u0456 \u0432\u044b\u0446\u0456\u0441\u043d\u0443\u0442\u0430\u044f \u045e \u0434\u0430\u0432\u0456\u043b\u0435 \u043a\u0440\u044b\u0436\u0430, \u044f\u043d\u0430 \u0431\u0440\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043c\u043e\u0446\u044b \u0432\u0430 \u045e\u043c\u044f\u0448\u0447\u0430\u043b\u044c\u043d\u044b\u043c \u043f\u043e\u0441\u0443\u0434\u0437\u0435 \u0432\u0435\u0440\u043d\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u044f\u0435 \u043f\u0440\u044b\u043c\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u0432\u044b, \u0448\u0442\u043e \u0432\u044b\u0439\u0448\u043b\u0456 \u0437-\u043f\u0430\u0434 \u0443\u043b\u0430\u0434\u044b \u0415\u0433\u0456\u043f\u0442\u0430 \u0456 \u0444\u0430\u0440\u0430\u043e\u043d\u0430-\u0434&rsquo;\u044f\u0431\u043b\u0430, \u0437 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u044e \u043f\u0440\u0430\u0433\u043d\u0430\u0441\u0446\u044e \u0441\u044d\u0440\u0446\u0430 \u043f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0439\u0446\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u043c\u0456 \u043d\u0430\u0434 \u0433\u044d\u0442\u0430\u0439 \u0437\u0431\u0430\u045e\u0447\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u0439 \u041f\u0430\u0441\u0445\u0456, \u043a\u0430\u0431 \u043d\u0430\u0448 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456, \u044f\u043a \u0432\u0435\u0440\u044b\u043c, \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u045e \u0441\u0432\u0430\u0456\u0445 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u0445, \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u043d\u0430\u0448\u0430\u0439 \u0434\u0443\u0448\u044b. \u042f\u0433\u043e \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0430\u044f \u043c\u043e\u0446 \u0442\u0440\u044b\u0432\u0430\u0435 \u0432\u0430 \u045e\u0441\u0435 \u0432\u044f\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041b\u043a 22, 19; \u042f\u043d 6, 58<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0437\u0443\u0441, \u0443\u0437\u044f\u045e\u0448\u044b \u0445\u043b\u0435\u0431, \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u0432\u0430\u045e, \u043f\u0430\u043b\u0430\u043c\u0430\u045e \u0456 \u0434\u0430\u045e \u0456\u043c, \u043a\u0430\u0436\u0443\u0447\u044b:<span style=\"color: #ff0000;\"> *<\/span> \u0413\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u0426\u0435\u043b\u0430 \u041c\u0430\u0451, \u044f\u043a\u043e\u0435 \u0437\u0430 \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0434\u0430\u043d\u0430; \u0433\u044d\u0442\u0430 \u0447\u044b\u043d\u0456\u0446\u0435 \u043d\u0430 \u041c\u0430\u044e \u043f\u0430\u043c\u044f\u0446\u044c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u044d\u0442\u0430 \u0436\u044b\u0432\u044b \u0445\u043b\u0435\u0431, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043d\u0435\u0431\u0430. \u0425\u0442\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435 \u0433\u044d\u0442\u044b \u0445\u043b\u0435\u0431, \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u0426\u0435\u043b\u0430 \u041c\u0430\u0451, \u044f\u043a\u043e\u0435 \u0437\u0430 \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0434\u0430\u043d\u0430; \u0433\u044d\u0442\u0430 \u0447\u044b\u043d\u0456\u0446\u0435 \u043d\u0430 \u041c\u0430\u044e \u043f\u0430\u043c\u044f\u0446\u044c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5026","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041c\u0430\u043b\u0456\u0442\u0432\u0430 \u0441\u0432. \u0422\u044d\u0430\u0434\u043e\u0440\u0430 \u0421\u0442\u0443\u0434\u044b\u0442\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio in adorationem crucis: PG 99; 691-694. 695. 698-699)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0430\u0448\u0442\u043e\u045e\u043d\u044b \u0456 \u0436\u044b\u0432\u0430\u0442\u0432\u043e\u0440\u043d\u044b \u043a\u0440\u044b\u0436 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041e \u043d\u0430\u0439\u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0435\u0439\u0448\u044b \u0434\u0430\u0440 \u043a\u0440\u044b\u0436\u0430! \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456, \u044f\u043a\u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0432\u044b\u0433\u043b\u044f\u0434 \u044f\u0433\u043e! \u0401\u043d \u043d\u0435 \u043c\u0430\u0435 \u045e \u0441\u0432\u0430\u0456\u043c \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0441\u0443\u043c\u0435\u0441\u0456 \u0434\u0430\u0431\u0440\u0430 \u0456 \u0437\u043b\u0430, \u044f\u043a \u0432\u044f\u0434\u043e\u043c\u0430\u0435 \u0434\u0440\u044d\u0432\u0430 \u045e \u042d\u0434\u044d\u043d\u0435, \u0430\u043b\u0435 \u045e\u0441\u044e \u044f\u0433\u043e \u043a\u0440\u0430\u0441\u0443 \u0456 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u043b\u044e\u0431\u0430 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u0456 \u0430\u0434\u0447\u0443\u0432\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0433\u044d\u0442\u0430 \u0434\u0440\u044d\u0432\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0430 \u043d\u0435 \u0441\u043c\u0435\u0440\u0446\u044c; \u044f\u043d\u043e \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435, \u0430 \u043d\u0435 \u0437\u0430\u0446\u044f\u043d\u044f\u0435; \u044f\u043d\u043e \u045e\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0440\u0430\u0439, \u0430 \u043d\u0435 \u0432\u044b\u0433\u0430\u043d\u044f\u0435. \u041d\u0430 \u0433\u044d\u0442\u0430 \u0434\u0440\u044d\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0437\u044b\u0448\u043e\u045e, \u044f\u043a \u043d\u0430 \u043a\u0430\u043b\u044f\u0441\u043d\u0456\u0446\u0443, \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0434&rsquo;\u044f\u0431\u043b\u0430, \u044f\u043a\u0456 \u043c\u0435\u045e \u043c\u043e\u0446 \u0441\u043c\u0435\u0440\u0446\u0456, \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0440\u043e\u0434 \u0430\u0434 \u0442\u044b\u0440\u0430\u043d\u0456\u0447\u043d\u0430\u0433\u0430 \u0440\u0430\u0431\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430 \u0433\u044d\u0442\u044b\u043c \u0434\u0440\u044d\u0432\u0435 \u041f\u0430\u043d \u044f\u043a \u0441\u0430\u043c\u044b \u0434\u0430\u0441\u0432\u0435\u0434\u0447\u0430\u043d\u044b \u0432\u043e\u0456\u043d: \u0437\u0440\u0430\u043d\u0435\u043d\u044b \u043f\u0430\u0434\u0447\u0430\u0441 \u0431\u043e\u044e \u045e \u0440\u0443\u043a\u0456, \u043d\u043e\u0433\u0456 \u0456 \u0431\u043e\u0441\u043a\u0456 \u0431\u043e\u043a, \u0430\u043b\u0435 \u0456\u043c\u0456 \u0401\u043d \u0432\u044b\u043b\u0435\u0447\u044b\u045e \u043d\u0430\u0448\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443, \u0437\u0440\u0430\u043d\u0435\u043d\u0443\u044e \u0430\u0442\u0440\u0443\u0442\u0430\u0439 \u0437\u043c\u0435\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0434\u0440\u044d\u0432\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u043d\u0430\u043c \u0437\u0433\u0443\u0431\u0443, \u0430 \u0446\u044f\u043f\u0435\u0440, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0434\u0440\u044d\u0432\u0443, \u043d\u0430\u043c \u0431\u044b\u043b\u043e \u0432\u0435\u0440\u043d\u0443\u0442\u0430 \u0436\u044b\u0446\u0446\u0451. \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0437-\u0437\u0430 \u0434\u0440\u044d\u0432\u0430 \u043d\u0430\u0441 \u043f\u0430\u0434\u043c\u0430\u043d\u0443\u043b\u0456, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043c\u044b \u0430\u0434\u043a\u0456\u043d\u0443\u043b\u0456 \u043d\u0430 \u0434\u0440\u044d\u0432\u0435 \u0441\u0442\u0430\u0440\u0430\u0434\u0430\u045e\u043d\u044f\u0433\u0430 \u0437\u043c\u0435\u044f. \u0413\u044d\u0442\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u043e\u0432\u044b\u044f \u0456 \u043d\u0435\u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b\u044f \u0437\u0430\u043c\u0435\u043d\u044b. \u0417\u0430\u043c\u0435\u0441\u0442 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430\u0435\u0446\u0446\u0430 \u0436\u044b\u0446\u0446\u0451, \u0437\u0430\u043c\u0435\u0441\u0442 \u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456 &ndash; \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c, \u0437\u0430\u043c\u0435\u0441\u0442 \u0433\u0430\u043d\u044c\u0431\u044b &ndash; \u0441\u043b\u0430\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0434\u0430\u0440\u044d\u0447\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u045e \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b: &laquo;\u041d\u044f\u0445\u0430\u0439 \u044f \u043d\u0435 \u0431\u0443\u0434\u0443 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043d\u0456\u0447\u044b\u043c, \u0430\u043a\u0440\u0430\u043c\u044f \u043a\u0440\u044b\u0436\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0441\u0432\u0435\u0442 \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0434\u043b\u044f \u043c\u044f\u043d\u0435, \u0430 \u044f &ndash; \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443&raquo; (\u0413\u0430\u043b 6, 14). \u0411\u043e \u0433\u044d\u0442\u0430 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u044f \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0431\u044b\u0446\u0446\u0430\u043c \u0440\u0430\u0441\u0446\u0432\u0456\u043b\u0430 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b, \u0430\u0441\u043f\u0440\u044d\u0447\u044b\u043b\u0430 \u043f\u044b\u0445\u0443 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0456 \u044f\u0435 \u0433\u0430\u043d\u0430\u0440\u044b\u0441\u0442\u0443\u044e \u0433\u043b\u0443\u043f\u043e\u0442\u0443. \u0410 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u043e\u0442\u044b, \u044f\u043a\u0456\u044f \u0431\u044f\u0440\u0443\u0446\u044c \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0443 \u043a\u0440\u044b\u0436\u044b, \u0432\u044b\u0440\u0432\u0430\u043b\u0456 \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0456 \u0437\u043b\u0430 \u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0432\u0435\u0442\u0443 \u0442\u043e\u043b\u044c\u043a\u0456 \u0441\u0456\u043c\u0432\u0430\u043b\u044b \u0456 \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0440\u044d\u0432\u0430 \u0431\u044b\u043b\u0456 \u0437\u043d\u0430\u043a\u0430\u043c\u0456 \u0456 \u043f\u0440\u0430\u0434\u0432\u0435\u0441\u0446\u0435\u043c \u043d\u0435\u0432\u0435\u0440\u0430\u0433\u043e\u0434\u043d\u044b\u0445 \u0431\u0443\u0434\u0443\u0447\u044b\u0445 \u0446\u0443\u0434\u0430\u045e. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u044c \u043a\u043e\u0436\u043d\u044b, \u043a\u0430\u0433\u043e \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u043f\u0440\u0430\u0433\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f. \u0426\u0456 \u0436 \u043d\u0435 \u043d\u0430 \u043c\u0430\u043b\u044b\u043c \u0434\u0440\u044d\u0432\u0435 \u043a\u0430\u045e\u0447\u044d\u0433\u0430 \u041d\u043e\u0439 \u0440\u0430\u0437\u0430\u043c \u0437 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0456 \u0436\u044b\u0432\u0451\u043b\u0430\u043c\u0456 \u045e\u0441\u044f\u043a\u0430\u0433\u0430 \u0440\u043e\u0434\u0443 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u0437 \u0411\u043e\u0436\u0430\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0430\u0434 \u0437\u0433\u0443\u0431\u044b \u043f\u0430\u0442\u043e\u043f\u0443?<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0448\u0442\u043e \u043d\u0430\u043a\u043e\u043d\u0442 \u0436\u0430\u0437\u043b\u0430 \u041c\u0430\u0439\u0441\u0435\u044f? \u0426\u0456 \u0436 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0432\u043e\u0431\u0440\u0430\u0437 \u043a\u0440\u044b\u0436\u0430? \u041d\u0430 \u044f\u0433\u043e \u045e\u0437\u043c\u0430\u0445 \u0432\u0430\u0434\u0430 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u045e \u043a\u0440\u043e\u045e, \u0433\u044d\u0442\u0430\u0435 \u0436\u0430\u0437\u043b\u043e \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u0437\u043c\u0435\u044f\u045e \u0435\u0433\u0456\u043f\u0435\u0446\u043a\u0456\u0445 \u0447\u0430\u0440\u0430\u0434\u0437\u0435\u044f\u045e; \u0441\u0432\u0430\u0456\u043c \u0443\u0434\u0430\u0440\u0430\u043c \u044f\u043d\u043e \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u0456\u043b\u0430 \u043c\u043e\u0440\u0430, \u0430 \u043f\u043e\u0442\u044b\u043c \u0432\u044f\u0440\u043d\u0443\u043b\u0430 \u043c\u0430\u0440\u0441\u043a\u0456\u044f \u043f\u043b\u044b\u043d\u0456 \u0456 \u0437\u0430\u0442\u0430\u043f\u0456\u043b\u0430 \u0432\u043e\u0440\u0430\u0433\u0430\u045e, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u044b\u045e \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u043a\u0440\u044b\u0436\u0430 \u0431\u044b\u043b\u043e \u0456 \u0436\u0430\u0437\u043b\u043e \u0410\u0430\u0440\u043e\u043d\u0430: \u0437\u0430 \u0430\u0434\u0437\u0456\u043d \u0434\u0437\u0435\u043d\u044c \u0440\u0430\u0441\u0446\u0432\u0456\u043b\u043e, \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u0437\u0430\u043a\u043e\u043d\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0410\u0431\u0440\u0430\u0433\u0430\u043c \u0443\u043a\u0430\u0437\u0432\u0430\u045e \u043d\u0430 \u0434\u0440\u044d\u0432\u0430 \u043a\u0440\u044b\u0436\u0430, \u043a\u0430\u043b\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0437\u0432\u044f\u0437\u0430\u043d\u0430\u0433\u0430 \u0441\u044b\u043d\u0430 \u043f\u0430\u043a\u043b\u0430\u045e \u043d\u0430 \u0441\u0442\u043e\u0441\u0435 \u0434\u0440\u044d\u0432\u0430. \u041d\u0430 \u043a\u0440\u044b\u0436\u044b \u0441\u043c\u0435\u0440\u0446\u044c \u0431\u044b\u043b\u0430 \u0437\u0430\u0431\u0456\u0442\u0430, \u0430 \u0410\u0434\u0430\u043c \u0432\u0435\u0440\u043d\u0443\u0442\u044b \u0436\u044b\u0446\u0446\u044e. \u041a\u0440\u044b\u0436\u0430\u043c \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u043a\u043e\u0436\u043d\u044b \u0430\u043f\u043e\u0441\u0442\u0430\u043b, \u043a\u0440\u044b\u0436 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0432\u044f\u043d\u043e\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u043f\u0430\u043a\u0443\u0442\u043d\u0456\u043a\u0443, \u043a\u0440\u044b\u0436\u043e\u043c \u0430\u0441\u0432\u044f\u0447\u0430\u0435\u0446\u0446\u0430 \u043a\u043e\u0436\u043d\u044b \u0441\u0432\u044f\u0442\u044b. \u0417 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u043a\u0440\u044b\u0436\u0430 \u043c\u044b \u0430\u043f\u0440\u0430\u043d\u0430\u0435\u043c\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0437\u0434\u044b\u043c\u0430\u0435\u043c \u0437 \u0441\u044f\u0431\u0435 \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043a\u0440\u044b\u0436\u0443 \u043c\u044b, \u0430\u0432\u0435\u0447\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b, \u0441\u0430\u0431\u0440\u0430\u043d\u044b \u045e \u0430\u0434\u0437\u0456\u043d \u0441\u0442\u0430\u0442\u0430\u043a \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0434\u043b\u044f \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0430\u045e\u0447\u0430\u0440\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u043e\u0441\u044c \u043d\u0430\u0439\u0446\u0443\u0434\u043e\u045e\u043d\u0435\u0439\u0448\u0430\u0435 \u0434\u0440\u044d\u0432\u0430, \u0440\u0430\u0437\u043c\u0435\u0448\u0447\u0430\u043d\u0430\u0435 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0440\u0430\u044e. <span style=\"color: #ff0000;\">*<\/span> \u041d\u0430 \u0456\u043c \u0434\u0430\u045e\u0446\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0441\u0432\u0430\u0451\u044e \u0441\u043c\u0435\u0440\u0446\u044e \u043d\u0430\u0448\u0443 \u0441\u043c\u0435\u0440\u0446\u044c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043d\u043e \u043d\u0430\u0439\u0441\u043b\u0430\u045e\u043d\u0435\u0439\u0448\u0430\u0435 \u0437\u0430 \u045e\u0441\u0435 \u0434\u0440\u044d\u0432\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430 \u0456\u043c \u0434\u0430\u045e\u0446\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0441\u0432\u0430\u0451\u044e \u0441\u043c\u0435\u0440\u0446\u044e \u043d\u0430\u0448\u0443 \u0441\u043c\u0435\u0440\u0446\u044c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5027","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u0441\u0432\u044f\u0442\u0443\u044e \u041b\u0456\u0442\u0443\u0440\u0433\u0456\u044e &laquo;Sacrosanctum Concilium&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 5-6)<\/span><br \/><span style=\"color: #ff0000;\">\u042d\u043a\u0430\u043d\u043e\u043c\u0456\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433, &laquo;\u044f\u043a\u0456 \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u0443\u0441\u0435 \u043b\u044e\u0434\u0437\u0456 \u0431\u044b\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0456 \u0434\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u045e\u0434\u044b&raquo; (1 \u0426\u0456\u043c 2, 4), &laquo;\u0448\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e \u0456 \u043f\u0430-\u0440\u043e\u0437\u043d\u0430\u043c\u0443 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0434\u0430 \u0430\u0439\u0446\u043e\u045e \u043d\u0430\u0448\u044b\u0445 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e&raquo; (\u0413\u0431\u0440 1, 1), \u0430 \u043a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0447\u0430\u0441\u0443, \u043f\u0430\u0441\u043b\u0430\u045e \u044f\u043a &laquo;\u043b\u0435\u043a\u0430\u0440\u0430 \u0446\u0435\u043b\u0430\u045e \u0456 \u0434\u0443\u0448&raquo; \u0456 \u041f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430 \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u0443\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u0421\u043b\u043e\u0432\u0430, \u043d\u0430\u043c\u0430\u0448\u0447\u0430\u043d\u0430\u0433\u0430 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u045e\u0431\u043e\u0433\u0456\u043c \u0456 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u0446\u044c \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u043c. \u042f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u043d\u0430\u0441\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u0430\u0441\u043e\u0431\u0430\u0439 \u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0422\u0430\u043c\u0443 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 &laquo;\u0430\u0434\u0431\u044b\u043b\u043e\u0441\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435 \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u043f\u0440\u044b\u043c\u0456\u0440\u044d\u043d\u043d\u044f, \u0456 \u043d\u0430\u043c \u0431\u044b\u043b\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u043a\u0443\u043b\u044c\u0442\u0443&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0440\u0430\u0432\u0443 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0411\u043e\u0433\u0430, \u044f\u043a\u0443\u044e \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0411\u043e\u0436\u044b\u044f \u0446\u0443\u0434\u044b, \u0441\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u044f \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0443 \u0421\u0442\u0430\u0440\u043e\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043f\u0440\u0430\u0437 \u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0441\u0432\u0430\u0451\u0439 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0439 \u041c\u0443\u043a\u0456, \u0423\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0456 \u0441\u043b\u0430\u045e\u043d\u0430\u0433\u0430 \u0423\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u044f. \u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0401\u043d, &laquo;\u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b, \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u043d\u0430\u0448\u0443 \u0441\u043c\u0435\u0440\u0446\u044c \u0456, \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0430\u044e\u0447\u044b, \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u0436\u044b\u0446\u0446\u0451&raquo;, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0437 \u0431\u043e\u043a\u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0441\u043f\u0430\u0447\u044b\u045e \u043d\u0430 \u043a\u0440\u044b\u0436\u044b, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0443\u0441\u044f\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0441\u043b\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u0430\u043a \u0456 \u0401\u043d \u043f\u0430\u0441\u043b\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u043d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u0445 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c. \u0410\u043b\u0435 \u0437\u0440\u0430\u0431\u0456\u045e \u0433\u044d\u0442\u0430 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b, \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0443\u044e\u0447\u044b \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u045e\u0441\u044f\u043a\u0430\u043c\u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044e, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456, \u0448\u0442\u043e \u0411\u043e\u0436\u044b \u0421\u044b\u043d \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u044e \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435\u043c \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u043d\u0430\u0441 \u0430\u0434 \u0443\u043b\u0430\u0434\u044b \u0441\u0430\u0442\u0430\u043d\u044b \u0456 \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u043f\u0435\u0440\u0430\u043d\u0451\u0441 \u0443 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0410\u0439\u0446\u0430, \u0430\u043b\u0435 \u0456 \u043a\u0430\u0431 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u043b\u0456 \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u0430\u0437 \u0410\u0445\u0432\u044f\u0440\u0443 \u0456 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u044b, \u044f\u043a\u0456\u044f \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0441\u0442\u0440\u044b\u0436\u043d\u0435\u043c \u0443\u0441\u044f\u0433\u043e \u043b\u0456\u0442\u0443\u0440\u0433\u0456\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u041f\u0440\u0430\u0437 \u0445\u0440\u043e\u0441\u0442 \u043b\u044e\u0434\u0437\u0456 \u0434\u0430\u043b\u0443\u0447\u0430\u044e\u0446\u0446\u0430 \u0434\u0430 \u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0425\u0440\u044b\u0441\u0442\u0430: \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f, \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u044b\u044f, \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0434\u0443\u0445\u0430 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f, &laquo;\u0443 \u044f\u043a\u0456\u043c \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u043c &bdquo;\u0410\u0431\u0431\u0430, \u041e\u0439\u0447\u0430&ldquo;&raquo; (\u0420\u044b\u043c 8, 15), \u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c\u0456 \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u0448\u0443\u043a\u0430\u0435 \u0410\u0439\u0446\u0435\u0446. \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u0437\u0430\u045e\u0436\u0434\u044b, \u043a\u0430\u043b\u0456 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u044e\u0446\u044c \u0412\u044f\u0447\u044d\u0440\u0443 \u041f\u0430\u043d\u0430, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u044c \u041f\u0430\u043d\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u0401\u043d \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435. \u0422\u0430\u043c\u0443 \u045e \u0441\u0430\u043c \u0434\u0437\u0435\u043d\u044c \u041f\u044f\u0446\u0456\u0434\u0437\u0435\u0441\u044f\u0442\u043d\u0456\u0446\u044b, \u043a\u0430\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0430\u0431&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0441\u0432\u0435\u0442\u0443, \u0442\u044b\u044f, &laquo;\u0445\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u045e \u0441\u043b\u043e\u0432\u0430&raquo; \u041f\u044f\u0442\u0440\u0430, &laquo;\u0430\u0445\u0440\u044b\u0441\u0446\u0456\u043b\u0456\u0441\u044f&raquo;. &laquo;\u0406 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0432\u0435\u0440\u043d\u044b\u043c\u0456 \u0432\u0443\u0447\u044d\u043d\u043d\u044e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456, \u043b\u0430\u043c\u0430\u043d\u043d\u044e \u0445\u043b\u0435\u0431\u0430 \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c... \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u0411\u043e\u0433\u0430 \u0456 \u043c\u0430\u044e\u0447\u044b \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0443\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443&raquo; (\u0414\u0437 2, 41-42, 47). \u0410\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0432\u0430\u045e \u0437\u0431\u0456\u0440\u0430\u0446\u0446\u0430 \u043d\u0430 \u0446\u044d\u043b\u0435\u0431\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b, \u0447\u044b\u0442\u0430\u044e\u0447\u044b &laquo;\u0442\u043e\u0435, \u0448\u0442\u043e \u0432\u0430 \u045e\u0441\u0456\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0456 \u0434\u0430\u0442\u044b\u0447\u044b\u043b\u0430 \u042f\u0433\u043e&raquo; (\u041b\u043a 24, 27), \u0446\u044d\u043b\u0435\u0431\u0440\u0443\u044e\u0447\u044b \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044e, \u0443 \u044f\u043a\u043e\u0439 &laquo;\u0443\u0432\u0430\u0441\u0430\u0431\u043b\u044f\u044e\u0446\u0446\u0430 \u042f\u0433\u043e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430 \u0456 \u0442\u0440\u044b\u0443\u043c\u0444 \u043d\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e&raquo;, \u0456 \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b &laquo;\u0411\u043e\u0433\u0443 \u0437\u0430 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b \u0434\u0430\u0440&raquo; (2 \u041a\u0430\u0440 9, 15) \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, &laquo;\u0434\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u042f\u0433\u043e\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b&raquo; (\u042d\u0444 1, 12) \u043f\u0440\u0430\u0437 \u043c\u043e\u0446 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042f\u043d 15, 5. 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f &ndash; \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u044f \u043b\u0430\u0437\u0430, \u0432\u044b &ndash; \u0433\u0430\u043b\u0456\u043d\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0425\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u045e\u0432\u0430 \u041c\u043d\u0435, \u0430 \u042f \u045e \u0456\u043c, \u0442\u043e\u0439 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0431\u0430\u0433\u0430\u0442\u044b \u043f\u043b\u0451\u043d, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043a \u041c\u044f\u043d\u0435 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0410\u0439\u0446\u0435\u0446, \u0442\u0430\u043a \u0456 \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441; \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u045e \u041c\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u045e\u0432\u0430 \u041c\u043d\u0435, \u0430 \u042f \u045e \u0456\u043c, \u0442\u043e\u0439 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0431\u0430\u0433\u0430\u0442\u044b \u043f\u043b\u0451\u043d, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5031","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041f\u0435\u0440\u0448\u0430\u044f \u0430\u043f\u0430\u043b\u043e\u0433\u0456\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e&raquo; \u0441\u0432. \u042e\u0441\u0442\u044b\u043d\u0430, \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 66-67: PG 6, 427-431)<\/span><br \/><span style=\"color: #ff0000;\">\u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0447\u043d\u0430\u044f \u0446\u044d\u043b\u0435\u0431\u0440\u0430\u0446\u044b\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0456 \u043c\u043e\u0436\u0430 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0441\u0446\u044c \u0442\u0430\u0433\u043e, \u0447\u0430\u043c\u0443 \u0432\u0443\u0447\u044b\u043c, \u0445\u0442\u043e \u0431\u044b\u045e \u0430\u0431\u043c\u044b\u0442\u044b \u045e \u043a\u0443\u043f\u0435\u043b\u0456 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u044f \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f, \u0430 \u0436\u044b\u0432\u0435 \u0442\u0430\u043a, \u044f\u043a \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043d\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u044f\u043a \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b \u0445\u043b\u0435\u0431 \u0446\u0456 \u044f\u043a \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u044b \u043d\u0430\u043f\u043e\u0439. \u042f\u043a \u043f\u0440\u0430\u0437 \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u043d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0442\u0430\u045e \u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0456 \u043f\u0440\u044b\u043d\u044f\u045e \u0446\u0435\u043b\u0430 \u0456 \u043a\u0440\u043e\u045e \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0442\u0430\u043a \u0456 \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a, \u043d\u0430\u0434 \u044f\u043a\u0456\u043c \u0443\u0437\u043d\u043e\u0441\u0456\u043b\u0430\u0441\u044f \u043f\u0430\u0434\u0437\u044f\u043a\u0430 \u045e \u042f\u0433\u043e \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0435, \u0430\u0436\u044b\u045e\u043b\u044f\u0435 \u043f\u0440\u0430\u0437 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0443 \u043d\u0430\u0448\u0430\u0435 \u0446\u0435\u043b\u0430 \u0456 \u043a\u0440\u043e\u045e. \u041c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0432\u0443\u0447\u044d\u043d\u043d\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u044b \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0426\u0435\u043b\u0430\u043c \u0456 \u041a\u0440\u044b\u0432\u0451\u044e \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u045e \u0441\u0432\u0430\u0456\u0445 \u0443\u0441\u043f\u0430\u043c\u0456\u043d\u0430\u0445, \u044f\u043a\u0456\u044f \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u0446\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f\u043c\u0456, \u043f\u0435\u0440\u0430\u0434\u0430\u043b\u0456, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u0456\u043c \u0433\u044d\u0442\u0430. \u0423\u0437\u044f\u045e\u0448\u044b \u0445\u043b\u0435\u0431, \u0401\u043d \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u0432\u0430\u045e \u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0413\u044d\u0442\u0430 \u0447\u044b\u043d\u0456\u0446\u0435 \u043d\u0430 \u041c\u0430\u044e \u043f\u0430\u043c\u044f\u0446\u044c&raquo;. \u041f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c, \u0443\u0437\u044f\u045e\u0448\u044b \u043a\u0435\u043b\u0456\u0445 \u0456 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u0432\u0430\u045e\u0448\u044b, \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0413\u044d\u0442\u0430 \u043c\u0430\u044f \u041a\u0440\u043e\u045e&raquo;, &ndash; \u0456 \u0440\u0430\u0437\u0434\u0430\u0432\u0430\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u0456\u043c. \u0417 \u0442\u0430\u0433\u043e \u0447\u0430\u0441\u0443 \u043c\u044b \u0440\u043e\u0431\u0456\u043c \u0442\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u043d\u0430 \u042f\u0433\u043e \u045e\u0441\u043f\u0430\u043c\u0456\u043d, \u0430 \u0445\u0442\u043e \u043c\u0430\u0435 \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c, \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u045e\u0441\u0456\u043c \u0431\u0435\u0434\u043d\u044b\u043c; \u0442\u0430\u043a \u043c\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u043c \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430. \u041f\u0440\u044b \u043a\u043e\u0436\u043d\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u044b \u043c\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u0441\u0443\u0441\u0432\u0435\u0442\u0443 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0421\u044b\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u045e \u0433\u044d\u0442\u0430\u043a \u0437\u0432\u0430\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0421\u043e\u043d\u0446\u0430, \u0443\u0441\u0435 \u0436\u044b\u0445\u0430\u0440\u044b \u0433\u0430\u0440\u0430\u0434\u043e\u045e \u0446\u0456 \u0432\u0451\u0441\u0430\u043a \u0437\u0431\u0456\u0440\u0430\u044e\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0443 \u0430\u0434\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u0456 \u0447\u044b\u0442\u0430\u044e\u0446\u044c \u0443\u0441\u043f\u0430\u043c\u0456\u043d\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0430\u0431\u043e \u043f\u0456\u0441\u0430\u043d\u043d\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0447\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043b\u0435\u043a\u0442\u0430\u0440 \u0441\u043a\u043e\u043d\u0447\u044b\u0446\u044c \u0447\u044b\u0442\u0430\u0446\u044c, \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u044b\u044f \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0440\u044d\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u044f \u045e\u0441\u0435 \u043c\u044b \u0440\u0430\u0437\u0430\u043c \u043f\u0430\u0434\u044b\u043c\u0430\u0435\u043c\u0441\u044f \u0456 \u045e\u0437\u043d\u043e\u0441\u0456\u043c \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u0430 \u043f\u043e\u0442\u044b\u043c, \u044f\u043a \u043c\u044b \u045e\u0436\u043e \u0441\u043a\u0430\u0437\u0430\u043b\u0456, \u043a\u0430\u043b\u0456 \u0441\u043a\u043e\u043d\u0447\u044b\u043c \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0445\u043b\u0435\u0431\u0430 \u0456 \u0432\u0456\u043d\u0430. \u041a\u0456\u0440\u0430\u045e\u043d\u0456\u043a \u0433\u043e\u0440\u0430\u0447\u0430 \u0434\u0437\u044f\u043a\u0443\u0435, \u0430 \u043d\u0430\u0440\u043e\u0434 \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0435: &laquo;\u0410\u043c\u044d\u043d&raquo;. \u0422\u0430\u0434\u044b \u0442\u043e\u0435, \u043d\u0430\u0434 \u0447\u044b\u043c \u0443\u0437\u043d\u043e\u0441\u0456\u043b\u0430\u0441\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430 \u043f\u0430\u0434\u0437\u044f\u043a\u0456, \u0434\u0437\u0435\u043b\u0456\u0446\u0446\u0430 \u0456 \u0440\u0430\u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u043c\u0443, \u0430\u0434\u0441\u0443\u0442\u043d\u044b\u043c \u0436\u0430 \u0440\u0430\u0441\u0441\u044b\u043b\u0430\u0435\u0446\u0446\u0430 \u0437 \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u0445\u0442\u043e \u043c\u0430\u0435 \u0434\u0430\u0441\u0442\u0430\u0442\u0430\u043a \u0456 \u0436\u0430\u0434\u0430\u0435, \u0434\u0430\u0435 \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043a\u043e\u043b\u044c\u043a\u0456 \u0445\u043e\u0447\u0430, \u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0437\u0431\u0456\u0440\u0430\u0435\u0446\u0446\u0430, \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u045e \u0440\u0443\u043a\u0456 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430. \u0401\u043d \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0441\u0456\u0440\u043e\u0442\u0430\u043c, \u0443\u0434\u043e\u0432\u0430\u043c \u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437-\u0437\u0430 \u043d\u0435\u043c\u0430\u0447\u044b \u0446\u0456 \u0437 \u0456\u043d\u0448\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u043d\u044f\u0441\u0442\u0430\u0447\u0443, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u044f\u0437\u043d\u044f\u043c \u0456 \u043f\u0440\u044b\u0448\u043b\u044b\u043c \u0437\u0434\u0430\u043b\u0451\u043a \u0456\u043d\u0448\u0430\u0437\u0435\u043c\u0446\u0430\u043c. \u0410\u0434\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u0451\u043d \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u0430\u0431 \u0443\u0441\u0456\u0445, \u0445\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u043f\u0430\u0442\u0440\u044d\u0431\u0435.<br \/>\u0423\u0441\u0435 \u043c\u044b \u0437\u0431\u0456\u0440\u0430\u0435\u043c\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0443 \u0434\u0437\u0435\u043d\u044c \u0421\u043e\u043d\u0446\u0430, \u0431\u043e \u045e \u0433\u044d\u0442\u044b \u043f\u0435\u0440\u0448\u044b \u0434\u0437\u0435\u043d\u044c \u0411\u043e\u0433 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u045e \u0437\u043c\u0440\u043e\u043a \u0443 \u043c\u0430\u0442\u044d\u0440\u044b\u044e \u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0441\u0432\u0435\u0442. \u0423 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445. \u041f\u0435\u0440\u0430\u0434 \u0434\u043d\u0451\u043c \u0421\u0430\u0442\u0443\u0440\u043d\u0430 \u042f\u0433\u043e \u045e\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043b\u0456, \u0430 \u043d\u0430\u0437\u0430\u045e\u0442\u0440\u0430 \u043f\u0430\u0441\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443 \u0434\u0437\u0435\u043d\u044c \u0421\u043e\u043d\u0446\u0430, \u0401\u043d \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u0441\u0432\u0430\u0456\u043c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c \u0456 \u0432\u0443\u0447\u043d\u044f\u043c \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u0456\u0445 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u043c\u044b \u043f\u0435\u0440\u0430\u0434\u0430\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u0430\u043c \u0434\u043b\u044f \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0435\u0440\u0430\u0434 \u0430\u0434\u044b\u0445\u043e\u0434\u0430\u043c \u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0434\u0430 \u0410\u0439\u0446\u0430 \u0415\u0437\u0443\u0441 \u043d\u0430 \u045e\u0441\u043f\u0430\u043c\u0456\u043d \u043f\u0440\u0430 \u0441\u0432\u0430\u044e \u0441\u043c\u0435\u0440\u0446\u044c <span style=\"color: #ff0000;\">*<\/span> \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0441\u0432\u0430\u0439\u0433\u043e \u0426\u0435\u043b\u0430 \u0456 \u041a\u0440\u044b\u0432\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0420\u0430\u0437\u0434\u0430\u044e\u0447\u044b \u0426\u0435\u043b\u0430 \u044f\u043a \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a, \u0430 \u041a\u0440\u043e\u045e &ndash; \u044f\u043a \u043d\u0430\u043f\u043e\u0439, \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e: \u0413\u044d\u0442\u0430 \u0447\u044b\u043d\u0456\u0446\u0435 \u043d\u0430 \u041c\u0430\u044e \u043f\u0430\u043c\u044f\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0441\u0432\u0430\u0439\u0433\u043e \u0426\u0435\u043b\u0430 \u0456 \u041a\u0440\u044b\u0432\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5032","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u041f\u0435\u0440\u0448\u0430\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0441\u0432. \u041f\u044f\u0442\u0440\u0430&raquo; \u0411\u044d\u0434\u044b \u0412\u044f\u043b\u0435\u0431\u043d\u0430\u0433\u0430, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 2: PL 93, 50-51)<\/span><br \/><span style=\"color: #ff0000;\">\u0420\u043e\u0434 \u0432\u044b\u0431\u0440\u0430\u043d\u044b, \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0412\u044b \u0436 &ndash; \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u0440\u043e\u0434, \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430&raquo; (1 \u041f 2, 9). \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e \u0433\u044d\u0442\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0445\u0432\u0430\u043b\u044b \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u0430\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u0411\u043e\u0436\u0430\u043c\u0443. \u0426\u044f\u043f\u0435\u0440 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0451\u0442\u0440 \u0441\u043b\u0443\u0448\u043d\u0430 \u0434\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c, \u0431\u043e \u044f\u043d\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0425\u0440\u044b\u0441\u0442\u0430. \u0401\u043d \u0436\u0430, \u044f\u043a \u0432\u0443\u0433\u043b\u0430\u0432\u044b \u043a\u0430\u043c\u0435\u043d\u044c, \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u045e \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0434\u0430\u044e\u0447\u044b \u0456\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043c\u0435\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432. \u041f\u0451\u0442\u0440 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0456\u0445 &laquo;\u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u0440\u043e\u0434\u0430\u043c&raquo; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b, \u043a\u0430\u0431 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0446\u044c \u0430\u0434 \u0442\u044b\u0445, \u0448\u0442\u043e \u0430\u0434\u043a\u0456\u043d\u0443\u043b\u0456 \u0432\u0443\u0433\u043b\u0430\u0432\u044b \u043a\u0430\u043c\u0435\u043d\u044c \u0456 \u0431\u044b\u043b\u0456 \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b\u044f \u0441\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430&raquo;, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u044f\u043d\u044b \u0437&rsquo;\u044f\u0434\u043d\u0430\u043b\u0456\u0441\u044f \u0437 \u0446\u0435\u043b\u0430\u043c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u043a\u0430\u0440\u0430\u043b\u0451\u043c \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c. \u042f\u043a \u043a\u0430\u0440\u043e\u043b\u044c \u0401\u043d \u0434\u0430\u0435 \u045e\u0434\u0437\u0435\u043b \u0443 \u0441\u0432\u0430\u0456\u043c \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435, \u0430 \u044f\u043a \u0441\u0432\u044f\u0442\u0430\u0440 \u0430\u0447\u044b\u0448\u0447\u0430\u0435 \u0456\u0445 \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e, \u043f\u0440\u0430\u043b\u0456\u0442\u0430\u0439 \u0443 \u0430\u0445\u0432\u044f\u0440\u044b. \u0421\u0432. \u041f\u0451\u0442\u0440 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0456\u0445 &laquo;\u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u043c \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430\u043c&raquo;, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u043b\u0456 \u0456 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u0446\u0446\u0430 \u043d\u0430 \u0432\u0435\u0447\u043d\u0430\u0435 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0456 \u043a\u0430\u0431 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u0411\u043e\u0433\u0443 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u0406\u0445 \u044f\u0448\u0447\u044d \u043d\u0430\u0437\u044b\u0432\u0430\u044e\u0446\u044c &laquo;\u0441\u0432\u044f\u0442\u044b\u043c \u0440\u043e\u0434\u0430\u043c \u0456 \u043b\u044e\u0434\u0430\u043c, \u0443\u0437\u044f\u0442\u044b\u043c \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c&raquo;. \u0413\u044d\u0442\u0430 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0442\u044b\u043c, \u0448\u0442\u043e \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430 \u0434\u043b\u044f \u0440\u0430\u0437&rsquo;\u044f\u0441\u043d\u0435\u043d\u043d\u044f \u043f\u0440\u0430\u0440\u043e\u0446\u043a\u0430\u0439 \u043c\u0456\u0441\u0456\u0456: &laquo;\u041c\u043e\u0439 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b, \u0456, \u043a\u0430\u043b\u0456 \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u0446\u0446\u0430, \u043d\u0435 \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u0435 \u044f\u0433\u043e \u0434\u0443\u0448\u0430 \u043c\u0430\u044f&raquo;. &laquo;\u0410\u043b\u0435 \u043c\u044b, &ndash; \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, &ndash; \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u043c \u0434\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0434\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0441\u0430\u0431\u0435 \u043d\u0430 \u0437\u0433\u0443\u0431\u0443, \u0430\u043b\u0435 \u0434\u0430 \u0432\u0435\u0440\u043d\u044b\u0445, \u044f\u043a\u0456\u044f \u0437\u0431\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0434\u0443\u0448\u0443&raquo; (\u043f\u0430\u0440. \u0413\u0431\u0440 10, 38). \u0427\u044b\u0442\u0430\u0435\u043c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0414\u0437\u0435\u044f\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e: &laquo;\u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0432\u0430\u0441 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c\u0456, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u0432\u0456\u043b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0401\u043d \u043f\u0440\u044b\u0434\u0431\u0430\u045e \u0443\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u0439&raquo; (\u0414\u0437 20, 28).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u044b \u0441\u0442\u0430\u043b\u0456 &laquo;\u043b\u044e\u0434\u0430\u043c, \u0443\u0437\u044f\u0442\u044b\u043c \u0411\u043e\u0433\u0430\u043c \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c&raquo; \u0443 \u043a\u0440\u044b\u0432\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f, \u044f\u043a \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0431\u044b\u045e \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b \u0437 \u0415\u0433\u0456\u043f\u0442\u0430 \u043a\u0440\u044b\u0432\u0451\u044e \u044f\u0433\u043d\u044f\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0442\u0430\u043c\u0443 \u045e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u043c \u0432\u0435\u0440\u0448\u044b, \u043f\u0430\u0441\u043b\u044f \u0437\u0433\u0430\u0434\u043a\u0456 \u043c\u0456\u0441\u0442\u044b\u0447\u043d\u044b\u0445 \u0441\u0442\u0430\u0440\u0430\u0436\u044b\u0442\u043d\u044b\u0445 \u043f\u0430\u0434\u0437\u0435\u0439, \u0430\u045e\u0442\u0430\u0440 \u043f\u0430\u0432\u0443\u0447\u0430\u0435, \u0448\u0442\u043e \u044f\u043d\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430 \u045e \u043d\u043e\u0432\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0437\u0435 \u0411\u043e\u0436\u044b\u043c: &laquo;\u041a\u0430\u0431 \u0432\u044b \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u0446\u043d\u043e\u0442\u044b \u042f\u0433\u043e&raquo; (\u043f\u0430\u0440. 1 \u041f 2, 9). \u041a\u0430\u043b\u0456 \u041c\u0430\u0439\u0441\u0435\u0439 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0440\u043e\u0434 \u0437 \u043d\u044f\u0432\u043e\u043b\u0456 \u0415\u0433\u0456\u043f\u0442\u0430 \u0456 \u043f\u0435\u0440\u0430\u0432\u0451\u045e \u044f\u0433\u043e \u043f\u0440\u0430\u0437 \u0427\u044b\u0440\u0432\u043e\u043d\u0430\u0435 \u043c\u043e\u0440\u0430, \u0443 \u0445\u0432\u0430\u043b\u044f\u0445 \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0442\u0430\u043d\u0443\u043b\u0456 \u0432\u043e\u0439\u0441\u043a\u0456 \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u0443\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u045e \u043f\u0435\u0441\u043d\u044e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456. \u0422\u0430\u043a \u0456 \u043c\u044b, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u045e \u0445\u0440\u043e\u0441\u0446\u0435 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0434\u0430\u0446\u044c \u043d\u0430\u043b\u0435\u0436\u043d\u0443\u044e \u043f\u0430\u0434\u0437\u044f\u043a\u0443 \u0437\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0433\u0456\u043f\u0446\u044f\u043d\u0435, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u043b\u0456 \u043d\u0430\u0440\u043e\u0434 \u0411\u043e\u0436\u044b, \u0431\u044b\u043b\u0456 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0437\u043c\u0440\u043e\u043a\u0443 \u0456 \u045e\u0446\u0456\u0441\u043a\u0443. \u0422\u0430\u043c\u0443 \u0433\u044d\u0442\u0430 \u0442\u0440\u0430\u043f\u043d\u044b \u0441\u0456\u043c\u0432\u0430\u043b \u0433\u0440\u0430\u0445\u043e\u045e, \u044f\u043a\u0456\u044f \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043b\u0456 \u043d\u0430\u0441, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u0442\u0430\u043d\u0443\u043b\u0456 \u045e \u0445\u0440\u043e\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u0441\u044b\u043d\u043e\u045e \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0456 \u045e\u0432\u044f\u0434\u0437\u0435\u043d\u043d\u0435 \u0456\u0445 \u0443 \u0430\u0431\u044f\u0446\u0430\u043d\u0443\u044e \u0437\u044f\u043c\u043b\u044e &ndash; \u0433\u044d\u0442\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u043d\u0430\u0435 \u045e\u0432\u0430\u0441\u0430\u0431\u043b\u0435\u043d\u043d\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f. \u041f\u0440\u0430\u0437 \u044f\u0435 \u043b\u0430\u0441\u043a\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u043d\u0430\u0441 \u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0441\u0432\u044f\u0442\u043b\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0436\u044b\u043b\u043b\u044f. \u0421\u0432\u044f\u0442\u043b\u043e \u0433\u044d\u0442\u0430\u0439 \u043b\u0430\u0441\u043a\u0456 \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u045e \u0432\u043e\u0433\u043d\u0435\u043d\u043d\u044b \u0441\u043b\u0443\u043f \u0432\u043e\u0431\u043b\u0430\u043a\u0430, \u044f\u043a\u0456 \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u045e \u0433\u0430\u0431\u0440\u044d\u044f\u043c \u043f\u0430\u0434\u0447\u0430\u0441 \u0443\u0441\u0451\u0439 \u0456\u0445 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043a\u0456. \u0401\u043d \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u045e \u0456\u0445 \u0430\u0434 \u043d\u0430\u0447\u043d\u043e\u0433\u0430 \u0437\u043c\u0440\u043e\u043a\u0443 \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0456\u0445 \u0446\u0443\u0434\u0430\u0434\u0437\u0435\u0439\u043d\u0430\u0439 \u0441\u0446\u044f\u0436\u044b\u043d\u0430\u0439 \u0434\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 2, 9; \u043f\u0430\u0440. \u0414\u0440\u0433 7, 7-8<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u0436 &ndash; \u0432\u044b\u0431\u0440\u0430\u043d\u044b \u0440\u043e\u0434, \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u044f\u0442\u044b, \u043b\u044e\u0434, \u0443\u0437\u044f\u0442\u044b \u0411\u043e\u0433\u0430\u043c \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0446\u043d\u043e\u0442\u044b \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u0437 \u0446\u0435\u043c\u0440\u044b \u045e \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0430\u0451, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0432\u044b\u0431\u0440\u0430\u045e \u0432\u0430\u0441 \u0456 \u0432\u044b\u043a\u0443\u043f\u0456\u045e \u0432\u0430\u0441 \u0437 \u0434\u043e\u043c\u0443 \u043d\u044f\u0432\u043e\u043b\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0446\u043d\u043e\u0442\u044b \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u0437 \u0446\u0435\u043c\u0440\u044b \u045e \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0430\u0451, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5033","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 34, 1-3. 5-6: CCL 41, 424-426)<\/span><br \/><span style=\"color: #ff0000;\">\u0417\u0430\u0441\u043f\u044f\u0432\u0430\u0435\u043c \u041f\u0430\u043d\u0443 \u043f\u0435\u0441\u043d\u044e \u043b\u044e\u0431\u043e\u0432\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0443 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e, \u0445\u0432\u0430\u043b\u0430 \u042f\u043c\u0443 \u043d\u0430 \u0441\u0445\u043e\u0434\u0437\u0435 \u0441\u0432\u044f\u0442\u044b\u0445&raquo; (\u041f\u0441 149, 1).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c \u043d\u0430\u0441 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u041f\u0430\u043d\u0443 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e. \u041d\u043e\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437\u043c\u043e\u0436\u0430 \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u0446\u044c \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e. \u0417 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u044e \u043f\u0435\u0441\u043d\u0456 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0456, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u0456\u043c\u0441\u044f \u0431\u043e\u043b\u044c\u0448 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430, \u043b\u044e\u0431\u043e\u045e. \u0425\u0442\u043e \u0437\u043c\u043e\u0436\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u043d\u043e\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0442\u043e\u0439 \u0437\u043c\u043e\u0436\u0430 \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u0446\u044c \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e. \u0410 \u0447\u044b\u043c \u0451\u0441\u0446\u044c \u043d\u043e\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u043d\u0430\u0441 \u043f\u0430\u0432\u0443\u0447\u0430\u0435 \u043d\u043e\u0432\u0430\u044f \u043f\u0435\u0441\u043d\u044f. \u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u0430\u0434\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430 \u0430\u0434\u043d\u0430\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430: \u043d\u043e\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043d\u043e\u0432\u0430\u044f \u043f\u0435\u0441\u043d\u044f \u0456 \u043d\u043e\u0432\u044b \u0437\u0430\u043f\u0430\u0432\u0435\u0442. \u0422\u0430\u043c\u0443 \u043d\u043e\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e \u0456 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0434\u0430 \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u043c\u0430 \u043d\u0456\u043a\u043e\u0433\u0430, \u0445\u0442\u043e \u0431 \u043d\u0435 \u043b\u044e\u0431\u0456\u045e, \u0430\u043b\u0435 \u043f\u044b\u0442\u0430\u043d\u043d\u0435 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0451\u043d \u043b\u044e\u0431\u0456\u0446\u044c. \u041d\u0430\u043c \u043d\u0435 \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u044e\u0446\u044c \u043f\u0430\u043a\u0456\u0434\u0430\u0446\u044c \u043b\u044e\u0431\u043e\u0432\u0456, \u0430\u043b\u0435 \u0432\u044b\u0431\u0440\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435\u043c \u043b\u044e\u0431\u0456\u0446\u044c. \u0410\u043b\u0435 \u0448\u0442\u043e \u043c\u043e\u0436\u0430\u043c \u0432\u044b\u0431\u0440\u0430\u0446\u044c, \u043a\u0430\u043b\u0456 \u0441\u043f\u044f\u0440\u0448\u0430 \u0441\u0430\u043c\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u043c \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u044f? \u041f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u043b\u044e\u0431\u0456\u0446\u044c, \u043a\u0430\u043b\u0456 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u043d\u0430\u0441 \u043d\u0435 \u043f\u0430\u043b\u044e\u0431\u044f\u0446\u044c, \u043a\u0430\u0436\u0430 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u042f\u043d: &laquo;\u041c\u044b \u043b\u044e\u0431\u0456\u043c, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0401\u043d \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441&raquo; (\u043f\u0430\u0440. 1 \u042f\u043d 4, 10). \u0421\u043f\u044b\u0442\u0430\u0439\u0441\u044f, \u0430\u0434\u043a\u0443\u043b\u044c \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u045e\u0437\u044f\u043b\u0430\u0441\u044f \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0411\u043e\u0433\u0430, \u0456 \u043d\u0435 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u0456\u043d\u0448\u0430\u0433\u0430 \u0430\u0434\u043a\u0430\u0437\u0443 \u044f\u043a \u0442\u043e\u0435, \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0435\u0440\u0448\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u044f\u0433\u043e. \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u0442\u043e\u0435, \u0437\u0430 \u0448\u0442\u043e \u043c\u043e\u0436\u0430\u043c \u042f\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u044c. \u041f\u0440\u0430 \u0442\u043e\u0435, \u0437\u0430 \u0448\u0442\u043e \u043c\u043e\u0436\u0430\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e, \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u043d\u0430\u043c \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b: &laquo;\u041b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u0432\u044b\u043b\u0456\u043b\u0430\u0441\u044f \u045e \u0441\u044d\u0440\u0446\u044b \u043d\u0430\u0448\u044b\u044f&raquo;. \u0410\u0434\u043a\u0443\u043b\u044c? \u041c\u043e\u0436\u0430, \u0430\u0434 \u043d\u0430\u0441? \u041d\u0435. \u0414\u044b\u043a \u0430\u0434\u043a\u0443\u043b\u044c \u0436\u0430? &laquo;\u041f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430\u043c&raquo; (\u0420\u044b\u043c 5, 5).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0430\u044e\u0447\u044b \u0442\u0430\u043a\u0456 \u0434\u0430\u0432\u0435\u0440, \u0431\u0443\u0434\u0437\u0435\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430 \u0430\u0434 \u0411\u043e\u0433\u0430. \u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0441\u0432. \u042f\u043d: &laquo;\u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u043b\u044e\u0431\u043e\u045e, \u0456 \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0442\u043e\u0439 \u0436\u044b\u0432\u0435 \u045e \u0411\u043e\u0433\u0443, \u0456 \u0411\u043e\u0433 \u0443 \u0456\u043c&raquo; (1 \u042f\u043d 4, 16). \u041d\u0435\u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u041b\u044e\u0431\u043e\u045e \u0430\u0434 \u0411\u043e\u0433\u0430&raquo; (1 \u042f\u043d 4, 7). \u0425\u0442\u043e \u0437 \u043d\u0430\u0441 \u0430\u0441\u043c\u0435\u043b\u0456\u045e\u0441\u044f \u0431 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u043b\u044e\u0431\u043e\u045e?&raquo; \u0421\u043a\u0430\u0437\u0430\u045e \u0433\u044d\u0442\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u0432\u0435\u0434\u0430\u045e, \u0448\u0442\u043e \u043c\u0435\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u0430\u0434\u0434\u0430\u0435 \u043d\u0430\u043c \u0441\u044f\u0431\u0435 \u0446\u0430\u043b\u043a\u0430\u043c. \u0401\u043d \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435 \u043d\u0430\u0441: &laquo;\u041b\u044e\u0431\u0456\u0446\u0435 \u041c\u044f\u043d\u0435, \u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u041c\u044f\u043d\u0435 \u043c\u0435\u0446\u044c, \u0431\u043e \u043d\u0435 \u043c\u043e\u0436\u0430\u0446\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u041c\u044f\u043d\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043c\u0430\u0435\u0446\u0435 \u041c\u044f\u043d\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0431\u0440\u0430\u0442\u044b, \u043e \u0441\u044b\u043d\u044b, \u043e \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456\u044f \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0456, \u043e \u0441\u0432\u044f\u0442\u044b\u044f \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u043d\u0430\u0448\u0447\u0430\u0434\u043a\u0456, \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0456 \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f \u0437\u0432\u044b\u0448, \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u043c\u044f\u043d\u0435, \u0430 \u0445\u0443\u0442\u0447\u044d\u0439 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0437 \u043c\u044f\u043d\u0435: &laquo;\u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0443 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e&raquo;. \u0412\u043e\u0441\u044c \u0442\u044b \u0433\u0430\u0432\u043e\u0440\u044b\u0448: &laquo;\u042f \u0441\u043f\u044f\u0432\u0430\u044e&raquo;. \u0422\u0430\u043a, \u0442\u044b \u0441\u043f\u044f\u0432\u0430\u0435\u0448, \u0441\u043f\u044f\u0432\u0430\u0435\u0448 \u0432\u044b\u0440\u0430\u0437\u043d\u0430, \u0456 \u044f \u0447\u0443\u044e. \u0410\u043b\u0435 \u043d\u044f\u0445\u0430\u0439 \u0436\u044b\u0446\u0446\u0451 \u043d\u0435 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u044f\u0437\u044b\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u0433\u043e\u043b\u0430\u0441\u0430\u043c, \u0441\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u0441\u044d\u0440\u0446\u0430\u043c, \u0441\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u0432\u0443\u0441\u043d\u0430\u043c\u0456, \u0441\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u0437\u0432\u044b\u0447\u0430\u044f\u043c\u0456: &laquo;\u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0443 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e&raquo;. \u0421\u043f\u044b\u0442\u0430\u0435\u0446\u0435\u0441\u044f, \u0448\u0442\u043e \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u043f\u0440\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u0435, \u0431\u043e \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u0445\u043e\u0447\u0430\u0446\u0435 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u043f\u0440\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043b\u044e\u0431\u0456\u0446\u0435? \u0428\u0443\u043a\u0430\u0435\u0446\u0435, \u044f\u043a\u0443\u044e \u043f\u0430\u0445\u0432\u0430\u043b\u0443 \u042f\u043c\u0443 \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u0446\u044c? \u0412\u044b \u0447\u0443\u043b\u0456: &laquo;\u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0443 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e&raquo;. \u0428\u0443\u043a\u0430\u0435\u0446\u0435 \u043f\u0430\u0445\u0432\u0430\u043b\u044b? &laquo;\u042f\u0433\u043e \u0445\u0432\u0430\u043b\u0430 \u043d\u0430 \u0441\u0445\u043e\u0434\u0437\u0435 \u0441\u0432\u044f\u0442\u044b\u0445&raquo;. \u041f\u0430\u0445\u0432\u0430\u043b\u0430 \u0441\u043f\u0435\u0432\u0443 &ndash; \u0441\u0430\u043c \u0441\u043f\u044f\u0432\u0430\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u043e\u0447\u0430\u0446\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u0411\u043e\u0433\u0430? \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0442\u044b\u043c, \u043f\u0440\u0430 \u0448\u0442\u043e \u0441\u043f\u044f\u0432\u0430\u0435\u0446\u0435. \u042f\u0433\u043e\u043d\u0430\u044f \u0445\u0432\u0430\u043b\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0432\u044b, \u043a\u0430\u043b\u0456 \u0434\u043e\u0431\u0440\u0430 \u0436\u044b\u0432\u044f\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 6, 4b; 1 \u042f\u043d 3, 23b; \u043f\u0430\u0440. \u042e\u0434\u0442 16, 13<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0434\u0437\u0435\u043b\u044f \u0441\u043b\u0430\u0432\u044b \u0410\u0439\u0446\u0430, \u0442\u0430\u043a \u0456 \u043d\u0430\u043c \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0430\u0431\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0411\u0443\u0434\u0437\u0435\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u0401\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043d\u0430\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u0456\u043c\u043d \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u0435\u043c \u041f\u0430\u043d\u0443, \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u0435\u043c \u043d\u043e\u0432\u044b \u0433\u0456\u043c\u043d \u043d\u0430\u0448\u0430\u043c\u0443 \u0411\u043e\u0433\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0437\u0435\u043c \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u0401\u043d \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u043d\u0430\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5034","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041f\u0435\u0440\u0448\u0430\u044f \u0430\u043f\u0430\u043b\u043e\u0433\u0456\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e&raquo; \u0441\u0432. \u042e\u0441\u0442\u044b\u043d\u0430, \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 61: PG 6, 419-422) <\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0443\u043f\u0435\u043b\u044c \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u0442\u0430\u0433\u043e, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043c\u044b, \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u044f \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u0435\u043c \u0441\u044f\u0431\u0435 \u0411\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0437 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u043d\u043d\u0435\u043c \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f \u0456 \u0441\u043b\u043e\u045e, \u0430\u0431\u044f\u0446\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u0442\u0430\u043a \u0436\u044b\u0446\u044c. \u0422\u0430\u0434\u044b \u0432\u0443\u0447\u044b\u043c \u0456\u0445 \u043c\u0430\u043b\u0456\u0446\u0446\u0430 \u0456 \u043f\u0440\u0430\u0437 \u043f\u043e\u0441\u0442 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0443 \u0411\u043e\u0433\u0430 \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u043d\u044f \u0433\u0440\u0430\u0445\u043e\u045e. \u0410\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043c\u044b \u0441\u0430\u043c\u0456 \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0456 \u043f\u043e\u0441\u0446\u0456\u043c\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u043e\u0442\u044b\u043c \u0432\u044f\u0434\u0437\u0435\u043c \u0456\u0445 \u0442\u0443\u0434\u044b, \u0434\u0437\u0435 \u0451\u0441\u0446\u044c \u0432\u0430\u0434\u0430, \u0456 \u0442\u0430\u043c \u044f\u043d\u044b \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u044e\u0446\u0446\u0430 \u0442\u0430\u043a\u0456\u043c \u0436\u0430 \u0447\u044b\u043d\u0430\u043c, \u044f\u043a \u0431\u044b\u043b\u0456 \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u043c\u044b \u0441\u0430\u043c\u0456. \u0411\u043e \u044f\u043d\u044b \u043f\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0430\u0431\u043c\u044b\u0446\u0446\u0451 \u0432\u0430\u0434\u043e\u044e \u045e \u0456\u043c\u044f \u0410\u0439\u0446\u0430 \u0441\u0443\u0441\u0432\u0435\u0442\u0443 \u0456 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0417\u0431\u0430\u045e\u0446\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f, \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u045e \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435&raquo; (\u043f\u0430\u0440. \u041c\u0446 18, 3). \u0423\u0441\u0456\u043c \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0448\u0442\u043e \u0430\u0434\u0437\u0456\u043d \u0440\u0430\u0437 \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f \u044f\u043d\u044b \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0435 \u043c\u0430\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0440\u043e\u043a \u0406\u0441\u0430\u044f \u0441\u043a\u0430\u0437\u0430\u045e, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0430\u0437\u0431\u0430\u0432\u044f\u0446\u0446\u0430 \u0441\u0432\u0430\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e \u0442\u044b\u044f, \u0445\u0442\u043e \u0437\u0433\u0440\u0430\u0448\u044b\u045e, \u0430\u043b\u0435 \u043f\u0430\u043a\u0430\u044f\u045e\u0441\u044f. \u0401\u043d \u043a\u0430\u0436\u0430 \u0442\u0430\u043a: &laquo;\u0410\u0431\u043c\u044b\u0439\u0446\u0435\u0441\u044f, \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0447\u044b\u0441\u0442\u044b\u043c\u0456, \u0430\u0434\u0434\u0430\u043b\u0456\u0446\u0435 \u0430\u0434 \u0432\u0430\u0447\u044d\u0439 \u041c\u0430\u0456\u0445 \u0434\u0440\u044d\u043d\u043d\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456 \u0432\u0430\u0448\u044b\u044f, \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u0435\u0441\u044f \u0440\u0430\u0431\u0456\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0439\u0446\u0435 \u0441\u0456\u0440\u0430\u0442\u0443, \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435\u0441\u044f \u0437\u0430 \u045e\u0434\u0430\u0432\u0443. \u041f\u0440\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435 \u0456 \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u0456\u043c, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u041a\u0430\u043b\u0456 \u0433\u0440\u0430\u0445\u0456 \u0432\u0430\u0448\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u044f\u043a \u0447\u044b\u0440\u0432\u0430\u043d\u044c, \u0437\u0431\u044f\u043b\u0435\u044e\u0446\u044c \u044f\u043a \u0441\u043d\u0435\u0433; \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0430\u0440\u0432\u043e\u0432\u044b\u044f \u044f\u043a \u043f\u0443\u0440\u043f\u0443\u0440, \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u044f\u043a \u0432\u043e\u045e\u043d\u0430. \u041a\u0430\u043b\u0456 \u0436 \u0430\u0434\u043c\u043e\u0432\u0456\u0446\u0435\u0441\u044f \u0456 \u0441\u0442\u0430\u043d\u0435\u0446\u0435 \u0431\u0443\u043d\u0442\u0430\u0432\u0430\u0446\u044c, \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u043c\u0435\u0447, \u0431\u043e \u0442\u0430\u043a \u0441\u043a\u0430\u0437\u0430\u043b\u0456 \u0432\u0443\u0441\u043d\u044b \u041f\u0430\u043d\u0430&raquo; (\u043f\u0430\u0440. \u0406\u0441 1, 16-20).<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0432\u043e\u0441\u044c \u0442\u043b\u0443\u043c\u0430\u0447\u044d\u043d\u043d\u0435 \u0433\u044d\u0442\u0430\u0433\u0430, \u044f\u043a\u043e\u0435 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0434 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e. \u041c\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u045e \u0441\u0432\u0435\u0442 \u043d\u0435\u0441\u0432\u044f\u0434\u043e\u043c\u044b\u043c\u0456, \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0448\u044b\u0441\u044f \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u0431\u043b\u0456\u0437\u043a\u0430\u0441\u0446\u0456 \u043d\u0430\u0448\u044b\u0445 \u0431\u0430\u0446\u044c\u043a\u043e\u045e. \u041c\u044b \u0431\u044b\u043b\u0456 \u0432\u044b\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u043d\u044b\u0445 \u0456 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u0437\u0432\u044b\u0447\u0430\u044f\u0445. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u043d\u0435\u043f\u0430\u0437\u0431\u0435\u0436\u043d\u0430\u0441\u0446\u0456 \u0456 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u044f, \u0430\u043b\u0435 \u0441\u0442\u0430\u043b\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0441\u0432\u044f\u0434\u043e\u043c\u0430\u0433\u0430 \u0432\u044b\u0431\u0430\u0440\u0443 \u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e \u0432\u0430\u0434\u0437\u0435 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e, \u044f\u043a\u0456\u044f \u045e\u0447\u044b\u043d\u0456\u043b\u0456, \u043c\u044b \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435\u043c \u043d\u0430\u0434 \u0442\u044b\u043c, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0430\u0434\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u0456 \u043a\u0430\u0435\u0446\u0446\u0430, \u0456\u043c\u044f \u0410\u0439\u0446\u0430 \u0441\u0443\u0441\u0432\u0435\u0442\u0443 \u0456 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430. \u0422\u043e\u043b\u044c\u043a\u0456 \u0456\u043c\u044f \u042f\u0433\u043e \u0430\u0434\u043d\u0430\u0433\u043e \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435\u043c \u043d\u0430\u0434 \u0442\u044b\u043c, \u043a\u0430\u0433\u043e \u0432\u044f\u0434\u0437\u0435\u043c \u0434\u0430 \u0445\u0440\u043e\u0441\u043d\u0430\u0439 \u043a\u0443\u043f\u0435\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0432\u044b\u043c\u0430\u0432\u0456\u0446\u044c \u0456\u043c\u0435\u043d\u0456 \u043d\u0435\u0432\u044b\u043c\u043e\u045e\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0430 \u043a\u0430\u043b\u0456 \u0431 \u0445\u0442\u043e \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u045e, \u0448\u0442\u043e \u044f\u043d\u043e \u044f\u043c\u0443 \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u0430, \u0442\u043e\u0439 \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0448\u0430\u043b\u0435\u043d\u0435\u0446.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u044f \u043a\u0443\u043f\u0435\u043b\u044c \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0441\u0432\u044f\u0442\u043b\u0435\u043d\u043d\u0435\u043c, \u0431\u043e \u0440\u043e\u0437\u0443\u043c\u044b \u0442\u044b\u0445, \u0445\u0442\u043e \u0433\u044d\u0442\u0430\u043c\u0443 \u0432\u0443\u0447\u044b\u0446\u0446\u0430, \u0437\u0432\u0435\u0434\u0432\u0430\u044e\u0446\u044c \u0430\u0441\u0432\u044f\u0442\u043b\u0435\u043d\u043d\u0435. \u0410 \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435\u0446\u0446\u0430, \u0430\u0431\u043c\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0456\u043c\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u045e \u0447\u0430\u0441\u044b \u041f\u043e\u043d\u0446i\u044f \u041f\u0456\u043b\u0430\u0442\u0430, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0456\u043c\u044f \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u0443\u0441\u0451, \u0448\u0442\u043e \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 3, 5-6<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0437\u0443\u0441 \u0430\u0434\u043a\u0430\u0437\u0430\u045e \u041d\u0456\u043a\u0430\u0434\u044d\u043c\u0443: \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0432\u0430\u0434\u044b \u0456 \u0414\u0443\u0445\u0430, \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0435 \u0437 \u0446\u0435\u043b\u0430, \u0451\u0441\u0446\u044c \u0446\u0435\u043b\u0430\u043c, \u0430 \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0435 \u0437 \u0414\u0443\u0445\u0430, \u0451\u0441\u0446\u044c \u0434\u0443\u0445\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0432\u0430\u0434\u044b \u0456 \u0414\u0443\u0445\u0430, \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5035","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u044f\u045e&raquo; \u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 5, 2, 2-3: SC 153, 30-38)<\/span><br \/><span style=\"color: #ff0000;\">\u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044f &ndash; \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0446\u0435\u043b\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0431\u0430\u0432\u0456\u0446\u0446\u0430, \u0442\u043e \u0456 \u041a\u0440\u043e\u045e \u041f\u0430\u043d\u0430 \u043d\u0435 \u0430\u0434\u043a\u0443\u043f\u043b\u044f\u0435 \u043d\u0430\u0441, \u0456 \u043a\u0435\u043b\u0456\u0445 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0456 \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0434\u0437\u0435\u043b\u0430\u043c \u0443 \u041a\u0440\u044b\u0432\u0456 \u042f\u0433\u043e, \u0456 \u0425\u043b\u0435\u0431, \u044f\u043a\u0456 \u043c\u044b \u043b\u0430\u043c\u0430\u0435\u043c, \u043d\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0434\u0437\u0435\u043b\u0430\u043c \u0443 \u042f\u0433\u043e \u0426\u0435\u043b\u0435. \u0411\u043e \u043a\u0440\u043e\u045e \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u043b\u0430\u0445 \u0456 \u0446\u0435\u043b\u0435 \u0456 \u045e \u0442\u044b\u043c \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430, \u0448\u0442\u043e \u0441\u043a\u043b\u0430\u0434\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0446\u0435\u043b\u0430. \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c \u0456 \u0430\u0434\u043a\u0443\u043f\u0456\u043b\u0430 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e, \u044f\u043a \u043f\u0456\u0448\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u0423 \u0406\u043c \u043c\u044b \u043c\u0430\u0435\u043c \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u043d\u0435 \u042f\u0433\u043e\u043d\u0430\u044e \u043a\u0440\u044b\u0432\u0451\u044e, \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e, \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e&raquo; (\u043f\u0430\u0440. \u042d\u0444 1, 7).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043c\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u042f\u0433\u043e \u0447\u0430\u0441\u0442\u043a\u0430\u043c\u0456, \u0430 \u043a\u043e\u0440\u043c\u0456\u043c\u0441\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u043c\u0443 \u0441\u0432\u0435\u0442\u0443, \u0401\u043d \u0441\u0430\u043c \u0434\u0430\u0435 \u043d\u0430\u043c \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c, \u043f\u0430\u0434\u044b\u043c\u0430\u044e\u0447\u044b \u0441\u043e\u043d\u0446\u0430 \u0456 \u043f\u0430\u0441\u044b\u043b\u0430\u044e\u0447\u044b \u0434\u043e\u0436\u0434\u0436. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430, \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u043a\u0435\u043b\u0456\u0445, \u0441\u043a\u0430\u0437\u0430\u045e\u0448\u044b, \u0448\u0442\u043e \u042f\u0433\u043e\u043d\u0430\u044f \u041a\u0440\u043e\u045e \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u043d\u0430\u0448\u0443\u044e \u043a\u0440\u043e\u045e. \u041f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0456 \u0445\u043b\u0435\u0431, \u044f\u043a\u0456 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0430 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u043d\u0430\u0437\u0432\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0426\u0435\u043b\u0430\u043c, \u044f\u043a\u0456\u043c \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u043d\u0430\u0448\u044b\u044f \u0446\u0435\u043b\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u043a\u0435\u043b\u0456\u0445 \u0441\u0430 \u0437\u043c\u044f\u0448\u0430\u043d\u044b\u043c \u0432\u0456\u043d\u043e\u043c \u0456 \u0433\u0430\u0442\u043e\u0432\u044b \u0445\u043b\u0435\u0431 \u043f\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044f\u0439 \u041a\u0440\u044b\u0432\u0456 \u0456 \u0426\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u0437 \u0456\u0445 \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0456 \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u043c\u0430\u0442\u044d\u0440\u044b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0446\u0435\u043b\u0430. \u0414\u044b\u043a \u0447\u0430\u043c\u0443 \u0436 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0430\u0434\u043c\u0430\u045e\u043b\u044f\u044e\u0446\u044c, \u0448\u0442\u043e \u0446\u0435\u043b\u0430 \u043c\u043e\u0436\u0430 \u0437\u043c\u044f\u0441\u0446\u0456\u0446\u044c \u0434\u0430\u0440 \u0411\u043e\u0436\u044b, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0448\u0442\u043e \u0436\u044b\u0432\u0456\u0446\u0446\u0430 \u041a\u0440\u044b\u0432\u0451\u044e \u0456 \u0426\u0435\u043b\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0447\u0430\u0441\u0442\u043a\u0430\u0439 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0441\u0432. \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b \u043f\u0456\u0448\u0430 \u045e \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u0456 \u0434\u0430 \u042d\u0444\u0435\u0441\u0446\u0430\u045e, \u0448\u0442\u043e &laquo;\u043c\u044b \u0447\u0430\u0441\u0442\u043a\u0456 \u0446\u0435\u043b\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u0437 \u0446\u0435\u043b\u0430 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0456 \u043a\u0430\u0441\u0446\u0435\u0439 \u042f\u0433\u043e\u043d\u044b\u0445&raquo; (\u043f\u0430\u0440. \u042d\u0444 5, 30), \u0451\u043d \u043c\u0430\u0435 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u043d\u0435 \u043f\u044d\u045e\u043d\u0430\u0433\u0430 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0433\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0431\u043e &laquo;\u0434\u0443\u0445 \u043d\u0435 \u043c\u0430\u0435 \u043d\u0456 \u0446\u0435\u043b\u0430, \u043d\u0456 \u043a\u0430\u0441\u0446\u0435\u0439&raquo; (\u043f\u0430\u0440. \u041b\u043a 24, 39). \u0401\u043d \u043c\u0430\u0435 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0437 \u0446\u0435\u043b\u0430, \u0436\u044b\u043b \u0456 \u043a\u0430\u0441\u0446\u0435\u0439 \u0456 \u044f\u043a\u0456 \u0436\u044b\u0432\u0456\u0446\u0446\u0430 \u043a\u0435\u043b\u0456\u0445\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u041a\u0440\u044b\u0432\u0456 \u0456 \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0445\u043b\u0435\u0431\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0426\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u044f \u043b\u0430\u0437\u0430, \u043f\u0430\u0441\u0430\u0434\u0436\u0430\u043d\u0430\u044f \u045e \u0437\u044f\u043c\u043b\u044e, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u043b\u0451\u043d \u0443 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441, \u0456 \u0437\u0435\u0440\u043d\u0435 \u0437\u0431\u0430\u0436\u044b\u043d\u044b, \u043f\u0430\u0434\u0430\u044e\u0447\u044b \u045e \u0437\u044f\u043c\u043b\u044e \u0456 \u043f\u0440\u0430\u0440\u0430\u0441\u0442\u0430\u044e\u0447\u044b, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0443 \u0448\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e \u0431\u043e\u043b\u044c\u0448\u044b \u043f\u043b\u0451\u043d \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0414\u0443\u0445\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u044f\u043a\u0456 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u045e\u0441\u0451. \u041f\u0430\u0441\u043b\u044f, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0443\u0441\u0451 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443, \u0430 \u043f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430, \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044f\u0439, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0426\u0435\u043b\u0430\u043c \u0456 \u041a\u0440\u044b\u0432\u0451\u0439 \u0425\u0440\u044b\u0441\u0442\u0430. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u043d\u0430\u0448\u044b\u044f \u0446\u0435\u043b\u044b, \u044f\u043a\u0456\u044f \u0436\u044b\u0432\u044f\u0446\u0446\u0430 \u0456\u043c\u0456, \u0441\u043f\u0430\u0447\u043d\u0443\u0446\u044c \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u045e \u0437\u044f\u043c\u043b\u0456 \u0456 \u043f\u0440\u0430\u0440\u0430\u0441\u0442\u0443\u0446\u044c \u0443 \u0451\u0439, \u0430\u043b\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u0443 \u0441\u0432\u043e\u0439 \u0447\u0430\u0441, \u043a\u0430\u043b\u0456 \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435 \u0434\u0430\u0441\u0446\u044c \u0456\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0445\u0432\u0430\u043b\u044b \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435 \u0430\u043f\u0440\u0430\u043d\u0430\u0435 \u045e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u0430 \u0442\u043b\u0435\u043d\u043d\u0430\u0435 \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044e, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u044f \u043c\u043e\u0446 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 6, 48-51ab<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f &ndash; \u0445\u043b\u0435\u0431 \u0436\u044b\u0446\u0446\u044f. \u0410\u0439\u0446\u044b \u0432\u0430\u0448\u044b\u044f \u0435\u043b\u0456 \u043c\u0430\u043d\u043d\u0443 \u045e \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0413\u044d\u0442\u0430 &ndash; \u0445\u043b\u0435\u0431, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437&rsquo;\u0435\u0441\u0446\u044c \u044f\u0433\u043e, \u043d\u0435 \u043f\u0430\u043c\u0451\u0440, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f &ndash; \u0445\u043b\u0435\u0431 \u0436\u044b\u0432\u044b, \u044f\u043a\u0456 \u0441\u044b\u0448\u043e\u045e \u0437 \u043d\u0435\u0431\u0430. \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u044b \u0445\u043b\u0435\u0431, \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u0432\u0435\u0447\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 &ndash; \u0445\u043b\u0435\u0431, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043d\u0435\u0431\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437&rsquo;\u0435\u0441\u0446\u044c \u044f\u0433\u043e, \u043d\u0435 \u043f\u0430\u043c\u0451\u0440, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5036","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u042d\u0444\u0440\u044d\u043c\u0430, \u0434\u044b\u044f\u043a\u0430\u043d\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo de Domino nostro, 3-4. 9:Opera edit. Lamy, 1, 152-158. 166-168)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b \u043a\u0440\u044b\u0436 &ndash; \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0440\u043e\u0434\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0431\u044b\u045e \u043a\u0456\u043d\u0443\u0442\u044b \u043f\u0430\u0434 \u043d\u043e\u0433\u0456 \u0441\u043c\u0435\u0440\u0446\u0456, \u0430\u043b\u0435 \u0441\u0430\u043c \u0440\u0430\u0441\u0442\u0430\u043f\u0442\u0430\u045e \u044f\u0435, \u044f\u043a \u0442\u043e\u043f\u0447\u0443\u0446\u044c \u0434\u0430\u0440\u043e\u0433\u0443. \u0401\u043d \u043f\u0430\u0434\u0434\u0430\u045e\u0441\u044f \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u043f\u0440\u044b\u043d\u044f\u045e \u044f\u0435 \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430, \u043a\u0430\u0431 \u044f\u0435 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u044f\u0435 \u0432\u043e\u043b\u0456. \u041d\u0430\u0448 \u041f\u0430\u043d \u043f\u0430\u0439\u0448\u043e\u045e \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u043d\u0435\u0441\u0443\u0447\u044b \u043a\u0440\u044b\u0436, \u0431\u043e \u0441\u043c\u0435\u0440\u0446\u044c \u0433\u044d\u0442\u0430\u0433\u0430 \u0445\u0430\u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0401\u043d \u0437\u0430\u043a\u0440\u044b\u0447\u0430\u045e \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u0456 \u0432\u044b\u0432\u0435\u045e \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0437 \u0430\u0434\u0445\u043b\u0430\u043d\u0456 \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u0436\u0430\u0434\u0430\u043d\u043d\u044e \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043c\u0435\u0440\u0446\u044c \u0437\u0430\u0431\u0456\u043b\u0430 \u041f\u0430\u043d\u0430 \u045e \u042f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c \u0446\u0435\u043b\u0435, \u0430\u043b\u0435 \u0442\u043e\u0439 \u0441\u0430\u043c\u0430\u0439 \u0437\u0431\u0440\u043e\u044f\u0439 \u0401\u043d \u0437\u0434\u0430\u0431\u044b\u045e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043d\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e. \u0411\u043e\u0441\u0442\u0432\u0430 \u045e\u043a\u0440\u044b\u043b\u0430\u0441\u044f \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0456 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u0456\u043b\u0430 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456; \u044f\u043d\u0430 \u0436 \u0437\u0430\u0431\u0456\u043b\u0430 \u0456 \u0441\u0430\u043c\u0430 \u0431\u044b\u043b\u0430 \u0437\u0430\u0431\u0456\u0442\u0430. \u0421\u043c\u0435\u0440\u0446\u044c \u0437\u0430\u0431\u0456\u043b\u0430 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0430\u043b\u0435, \u0443 \u0441\u0432\u0430\u044e \u0447\u0430\u0440\u0433\u0443, \u044f\u0435 \u0437\u0430\u0431\u0456\u043b\u0430 \u0437\u0432\u044b\u0448\u043f\u0440\u044b\u0440\u043e\u0434\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u043f\u0430\u0436\u044d\u0440\u0446\u0456 \u042f\u0433\u043e \u0431\u0435\u0437 \u0446\u0435\u043b\u0430, \u0456 \u0430\u0434\u0445\u043b\u0430\u043d\u044c \u043d\u0435 \u043c\u0430\u0433\u043b\u0430 \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u0446\u044c \u042f\u0433\u043e \u0431\u0435\u0437 \u0446\u0435\u043b\u0430, \u041f\u0430\u043d \u0441\u044b\u0448\u043e\u045e \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0435 \u0414\u0437\u0435\u0432\u044b, \u043a\u0430\u0431 \u0443\u0437\u044f\u0442\u0430\u0435 \u0430\u0434 \u042f\u0435 \u0446\u0435\u043b\u0430 \u043f\u0440\u044b\u0432\u044f\u043b\u043e \u042f\u0433\u043e \u045e \u0430\u0434\u0445\u043b\u0430\u043d\u044c. \u0423 \u043f\u0440\u044b\u043d\u044f\u0442\u044b\u043c \u0446\u0435\u043b\u0435 \u0401\u043d \u0441\u043f\u0443\u0441\u0446\u0456\u045e\u0441\u044f \u045e \u0430\u0434\u0445\u043b\u0430\u043d\u044c, \u0440\u0430\u0441\u043a\u0456\u0434\u0430\u045e \u0456 \u0437\u0440\u0430\u0431\u0430\u0432\u0430\u045e \u0441\u0430\u0431\u0440\u0430\u043d\u044b\u044f \u0442\u0430\u043c \u0441\u043a\u0430\u0440\u0431\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u0415\u0432\u044b, \u043c\u0430\u0446\u0456 \u045e\u0441\u0456\u0445 \u0436\u044b\u0432\u044b\u0445. \u042f\u043d\u0430 &ndash; \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0456\u043a, \u0430\u0433\u0430\u0440\u043e\u0434\u0436\u0443 \u044f\u043a\u043e\u0433\u0430 \u0441\u043c\u0435\u0440\u0446\u044c \u0432\u044b\u043b\u0430\u043c\u0430\u043b\u0430 \u045e\u043b\u0430\u0441\u043d\u044b\u043c\u0456 \u0440\u0443\u043a\u0430\u043c\u0456 \u0415\u0432\u044b, \u043a\u0430\u0431 \u0442\u0430\u044f \u043f\u0430\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u043b\u0430 \u0441\u0432\u043e\u0439 \u043f\u043b\u043e\u0434. \u0422\u0430\u043c\u0443 \u0415\u0432\u0430, \u043c\u0430\u0446\u0456 \u045e\u0441\u0456\u0445 \u0436\u044b\u0432\u044b\u0445, \u0441\u0442\u0430\u043b\u0430 \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a, \u0437\u0430\u043c\u0435\u0441\u0442 \u0441\u0442\u0430\u0440\u043e\u0439 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u0439 \u043b\u0430\u0437\u044b, \u0415\u0432\u044b, \u0440\u0430\u0441\u043a\u0432\u0456\u0442\u043d\u0435\u043b\u0430 \u041c\u0430\u0440\u044b\u044f, \u0443 \u044f\u043a\u043e\u0439 \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u043d\u043e\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451. \u0421\u043c\u0435\u0440\u0446\u044c \u0448\u0443\u043a\u0430\u043b\u0430 \u043f\u0430\u0436\u044b\u0432\u044b \u0456, \u044f\u043a \u0437\u0430\u0437\u0432\u044b\u0447\u0430\u0439, \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u0456\u043b\u0430\u0441\u044f, \u043d\u0435 \u043f\u0430\u0434\u0430\u0437\u0440\u0430\u044e\u0447\u044b \u043d\u0456\u0447\u043e\u0433\u0430. \u0410\u043b\u0435 \u045e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u043f\u043b\u043e\u0434\u0437\u0435 \u0431\u044b\u043b\u043e \u0441\u0445\u0430\u0432\u0430\u043d\u0430 \u0416\u044b\u0446\u0446\u0451, \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0435 \u0434\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456. \u041a\u0430\u043b\u0456 \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0430\u0433\u043b\u044b\u043d\u0443\u043b\u0430 \u042f\u0433\u043e, \u043d\u0435 \u0431\u0430\u044e\u0447\u044b\u0441\u044f \u043d\u0456\u0447\u043e\u0433\u0430, \u044f\u043d\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u043b\u0430 \u0436\u044b\u0446\u0446\u0451 \u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c \u043c\u043d\u043e\u0433\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0432\u044f\u043b\u0456\u043a\u0456 \u0433\u044d\u0442\u044b \u0421\u044b\u043d \u043f\u043b\u043e\u0442\u043d\u0456\u043a\u0430, \u044f\u043a\u0456 \u045e\u0437\u043d\u0451\u0441 \u0441\u0432\u043e\u0439 \u043a\u0440\u044b\u0436 \u043d\u0430\u0434 \u0431\u0435\u0437\u0434\u0430\u043d\u043d\u044e, \u0448\u0442\u043e \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u0435 \u045e\u0441\u0451, \u0456 \u043f\u0435\u0440\u0430\u043d\u0451\u0441 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0440\u043e\u0434 \u0443 \u0434\u043e\u043c \u0436\u044b\u0446\u0446\u044f. \u0417-\u0437\u0430 \u0434\u0440\u044d\u0432\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0440\u043e\u0434 \u0443\u043f\u0430\u045e \u0443 \u0441\u0430\u043c\u044b\u044f \u043d\u0456\u0437\u0456\u043d\u044b \u0456, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0434\u0440\u044d\u0432\u0443, \u043f\u0435\u0440\u0430\u043d\u0451\u0441\u0441\u044f \u045e \u0434\u043e\u043c \u0436\u044b\u0446\u0446\u044f. \u041d\u0430 \u0434\u0440\u044d\u0432\u0435, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u043f\u0440\u044b\u0448\u0447\u0430\u043f\u0456\u043b\u0456 \u0446\u0435\u0440\u043d\u0456, \u043f\u0440\u044b\u0448\u0447\u0430\u043f\u0456\u043b\u0456 \u0456 \u0441\u0430\u043b\u043e\u0434\u043a\u0456 \u043f\u0430\u0440\u0430\u0441\u0442\u0430\u043a, \u044f\u043a\u043e\u043c\u0443 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0432\u0430\u043b\u0430 \u0422\u0430\u0431\u0435! \u0422\u044b \u045e\u0437\u0432\u0451\u045e \u0441\u0432\u043e\u0439 \u043a\u0440\u044b\u0436 \u044f\u043a \u043c\u043e\u0441\u0442 \u043f\u0430-\u043d\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u043a\u0430\u0431 \u0434\u0443\u0448\u044b \u043f\u0435\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0456 \u043f\u0430 \u0456\u043c \u0437 \u043a\u0440\u0430\u0456\u043d\u044b \u0441\u043c\u0435\u0440\u0446\u0456 \u045e \u043a\u0440\u0430\u0456\u043d\u0443 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0432\u0430\u043b\u0430 \u0422\u0430\u0431\u0435! \u0422\u044b \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435 \u043b\u044e\u0434\u0441\u043a\u043e\u0435 \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u0443\u0447\u044b\u043d\u0456\u0446\u044c \u0437 \u044f\u0433\u043e \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u0436\u044b\u0446\u0446\u044f \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0436\u044b\u0432\u0435\u0448, \u0431\u043e \u0422\u0432\u0430\u0435 \u0437\u0430\u0431\u043e\u0439\u0446\u044b \u0430\u0431\u044b\u0448\u043b\u0456\u0441\u044f \u0437 \u0422\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u044f\u043a \u0437\u0435\u043c\u043b\u044f\u0440\u043e\u0431\u044b: \u043f\u0430\u0441\u0435\u044f\u043b\u0456 \u0426\u044f\u0431\u0435, \u044f\u043a \u0437\u0431\u0430\u0436\u044b\u043d\u0443, \u0443 \u0433\u043b\u044b\u0431\u0456\u043d\u044f\u0445, \u043a\u0430\u0431 \u0422\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0430\u0434\u0442\u0443\u043b\u044c \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0440\u0430\u0437\u0430\u043c \u0437 \u0441\u0430\u0431\u043e\u044e \u043c\u043d\u043e\u0433\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0430\u0434\u0437\u0435\u043c\u0446\u0435, \u043f\u0440\u044b\u043d\u044f\u0441\u0451\u043c \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0430\u0433\u0443\u043b\u044c\u043d\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u043d\u0430\u0448\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0448\u0447\u044b\u0440\u0430 \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u0435\u043c \u043f\u0435\u0441\u043d\u0456 \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u0451\u0441 \u0441\u0432\u043e\u0439 \u043a\u0440\u044b\u0436 \u0443 \u0430\u0445\u0432\u044f\u0440\u0443 \u0411\u043e\u0433\u0443, \u043a\u0430\u0431 \u0443\u0437\u0431\u0430\u0433\u0430\u0446\u0456\u0446\u044c \u044f\u0433\u043e\u043d\u0430\u0439 \u043c\u043e\u0446\u0430\u0439 \u043d\u0430\u0441 \u0443\u0441\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 15, 55-56\u0430. 57; \u043f\u0430\u0440. 2 \u041a\u0430\u0440 4, 13. 14<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> C\u043c\u0435\u0440\u0446\u044c, \u0434\u0437\u0435 \u0442\u0432\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430? \u0421\u043c\u0435\u0440\u0446\u044c, \u0434\u0437\u0435 \u0442\u0432\u0430\u0451 \u0434\u0436\u0430\u043b\u0430? \u0414\u0436\u0430\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 &ndash; \u0433\u0440\u044d\u0445. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e\u0433\u0443 \u043f\u0430\u0434\u0437\u044f\u043a\u0430, \u0431\u043e \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u0430\u044e\u0447\u044b \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0434\u0443\u0445 \u0432\u0435\u0440\u044b, \u043c\u044b \u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0442\u043e\u0439, \u0445\u0442\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0415\u0437\u0443\u0441\u0430, \u0456 \u043d\u0430\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433\u0443 \u043f\u0430\u0434\u0437\u044f\u043a\u0430, \u0431\u043e \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5037","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430&raquo; \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 4, 2: PG 73, 563-566)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u0434\u0437\u0435\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u0441\u0432\u0435\u0442\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f \u043f\u0430\u043c\u0456\u0440\u0430\u044e \u0437\u0430 \u045e\u0441\u0456\u0445, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u043a\u0430\u0431 \u0443\u0441\u0456\u0445 \u0430\u0436\u044b\u0432\u0456\u0446\u044c \u043f\u0440\u0430\u0437 \u0441\u044f\u0431\u0435, \u0446\u0435\u043b\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u042f \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0446\u0435\u043b\u044b \u045e\u0441\u0456\u0445. \u0411\u043e \u045e \u041c\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u0456 \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0430\u043c\u0440\u044d, \u0456 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u041c\u043d\u043e\u0439 \u043f\u0430\u045e\u0441\u0442\u0430\u043d\u0435 \u0437 \u0443\u043f\u0430\u0434\u043a\u0443 \u043b\u044e\u0434\u0441\u043a\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u042f \u0441\u0442\u0430\u045e \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u0432\u0430\u0441, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0437 \u0440\u043e\u0434\u0443 \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430, \u043a\u0430\u0431 \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456\u0446\u0446\u0430 \u0432\u0430 \u045e\u0441\u0456\u043c \u0434\u0430 \u0431\u0440\u0430\u0442\u043e\u045e. \u0421\u0432. \u041f\u0430\u0432\u0435\u043b \u0434\u043e\u0431\u0440\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u045e \u0433\u044d\u0442\u0430, \u043a\u0430\u043b\u0456 \u043a\u0430\u0437\u0430\u045e: &laquo;\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0437\u0435\u0446\u0456 \u043c\u0430\u044e\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u0446\u0435\u043b\u0435 \u0456 \u043a\u0440\u044b\u0432\u0456, \u0442\u0430\u043c\u0443 \u045e \u0456\u0445 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0440\u044b\u043d\u044f\u045e \u0443\u0434\u0437\u0435\u043b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0415\u0437\u0443\u0441, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0456\u0437\u0440\u044b\u043d\u0443\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434&rsquo;\u044f\u0431\u043b\u0430&raquo; (\u0413\u0431\u0440 2, 14).<\/p>\r\n<p style=\"text-align: justify;\">\u0406\u043d\u0430\u043a\u0448 \u043d\u0435 \u043c\u043e\u0433 \u0431\u044b \u0431\u044b\u0446\u044c \u043d\u0456\u0437\u0440\u044b\u043d\u0443\u0442\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456 \u0441\u0430\u043c\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u043a\u0430\u043b\u0456 \u0431 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0435 \u0430\u0434\u0434\u0430\u045e \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0437\u0430 \u043d\u0430\u0441, \u0430\u0434\u0437\u0456\u043d \u0434\u0437\u0435\u043b\u044f \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u045e\u0441\u0456\u0445, \u0431\u043e \u0401\u043d \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u045e \u0430\u0434\u043d\u044b\u043c \u0437 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c, \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0447\u044b \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u044f\u043a \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u0411\u043e\u0433\u0443 \u0456 \u0410\u0439\u0446\u0443: &laquo;\u0410\u0445\u0432\u044f\u0440\u044b \u0456 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f \u0422\u044b \u043d\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u045e, \u0430\u043b\u0435 \u0430\u0434\u043a\u0440\u044b\u045e \u043c\u043d\u0435 \u0432\u0443\u0448\u044b. \u0423\u0441\u0435\u0441\u043f\u0430\u043b\u0435\u043d\u043d\u044f \u0456 \u0430\u0445\u0432\u044f\u0440\u044b \u0437\u0430 \u0433\u0440\u044d\u0445 \u0422\u044b \u043d\u0435 \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0448. \u0422\u0430\u0434\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u044f: \u0412\u043e\u0441\u044c \u0456\u0434\u0443&raquo; (\u041f\u0441 40 [39], 7-9).<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443\u0441 \u0431\u044b\u045e \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b \u0437\u0430 \u045e\u0441\u0456\u0445 \u0456 \u0434\u0437\u0435\u043b\u044f \u045e\u0441\u0456\u0445, \u043a\u0430\u0431, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u043c\u0435\u0440\u0446\u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u0437\u0430 \u045e\u0441\u0456\u0445, \u043c\u044b \u045e\u0441\u0435 \u0436\u044b\u043b\u0456 \u045e \u0406\u043c. \u0406 \u043d\u0435 \u043c\u043e\u0433 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u0446\u0446\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0446\u0456 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044e \u0442\u043e\u0439, \u0445\u0442\u043e \u0451\u0441\u0446\u044c \u043f\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0441\u0430\u043c\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c. \u041f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u0434\u0437\u0435\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u0441\u0432\u0435\u0442\u0443, \u043c\u044b \u0437\u043d\u043e\u045e \u0434\u0430\u0432\u0435\u0434\u0432\u0430\u0435\u043c\u0441\u044f \u0437 \u042f\u0433\u043e \u0441\u043b\u043e\u045e, \u043a\u0430\u043b\u0456 \u0401\u043d \u043a\u0430\u0436\u0430: &laquo;\u041e\u0439\u0447\u0430 \u0441\u0432\u044f\u0442\u044b, \u0441\u0446\u0435\u0440\u0430\u0436\u044b \u0456\u0445&raquo; (\u043f\u0430\u0440. \u042f\u043d 17, 11). \u0406 \u0437\u043d\u043e\u045e: &laquo;\u0417\u0430 \u0456\u0445 \u042f \u043f\u0430\u0441\u0432\u044f\u0447\u0430\u044e \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435&raquo; (\u043f\u0430\u0440. \u042f\u043d 17, 19).<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c &laquo;\u043f\u0430\u0441\u0432\u044f\u0447\u0430\u044e \u045e \u0430\u0445\u0432\u044f\u0440\u0443&raquo;, \u0437\u0430\u043c\u0435\u0441\u0442 &laquo;\u0430\u0441\u0432\u044f\u0447\u0430\u044e&raquo; \u0456 &laquo;\u043f\u0440\u044b\u043d\u043e\u0448\u0443&raquo;, \u044f\u043a \u0447\u044b\u0441\u0442\u0443\u044e \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u043d\u0430 \u0441\u0430\u043b\u043e\u0434\u043a\u0456 \u0432\u043e\u0434\u0430\u0440. \u0410\u0441\u0432\u044f\u0447\u0430\u043b\u0430\u0441\u044f \u0430\u0431\u043e \u043d\u0430\u0437\u044b\u0432\u0430\u043b\u0430\u0441\u044f \u0441\u0432\u044f\u0442\u044b\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0417\u0430\u043a\u043e\u043d\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0430\u0441\u044f \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u043d\u0430 \u0430\u043b\u0442\u0430\u0440\u044b. \u0422\u0430\u043c\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u0434\u0430\u045e \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0437\u0430 \u045e\u0441\u0456\u0445, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u044f\u0433\u043e \u0437\u043d\u043e\u045e \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u043d\u0430\u0441 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f. \u0420\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u0443 \u0433\u044d\u0442\u0430, \u044f\u043a \u043c\u0430\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u044f\u043b\u0456\u045e\u0448\u044b\u0441\u044f \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c \u0446\u0435\u043b\u0435, \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0432\u044f\u0440\u043d\u0443\u043b\u0430 \u044f\u0433\u043e \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u0430\u0431\u0440\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0430\u0434\u043d\u0430\u0432\u0456\u043b\u0430 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u0439 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u0439 \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u0456, \u0421\u043b\u043e\u0432\u0430 \u0437\u0440\u0430\u0431\u0456\u043b\u0430 \u044f\u0433\u043e \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u044b\u043c, \u0442\u0430\u043a\u0456\u043c \u0436\u0430 \u044f\u043a \u0456 \u0441\u0430\u043c\u043e \u045e \u0441\u0432\u0430\u0451\u0439 \u0431\u043e\u0441\u043a\u0430\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0436\u044b\u045e\u043b\u044f\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0435 \u045e \u0456\u043c: \u044f\u043d\u043e \u043f\u0440\u0430\u0433\u0430\u043d\u044f\u0435 \u0441\u043c\u0435\u0440\u0446\u044c \u0430\u0434 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c, \u0441\u0442\u0432\u0430\u0440\u0430\u044e\u0447\u044b \u045e \u0441\u0430\u0431\u0435 \u0441\u0430\u043c\u0456\u043c \u0446\u0443\u0434\u043e\u045e\u043d\u0443\u044e \u0441\u0456\u043b\u0443 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 10, 14. 15b. 10b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f &ndash; \u0434\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440 \u0456 \u0432\u0435\u0434\u0430\u044e \u0441\u0432\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a. <span style=\"color: #ff0000;\">*<\/span> \u042f \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0430\u0434\u0434\u0430\u044e \u0437\u0430 \u0430\u0432\u0435\u0447\u0430\u043a \u0441\u0432\u0430\u0456\u0445, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043a\u0430\u0431 \u0432\u044b \u043c\u0435\u043b\u0456 \u0436\u044b\u0446\u0446\u0451 \u0456 \u043c\u0435\u043b\u0456 \u045e \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0430\u0434\u0434\u0430\u044e \u0437\u0430 \u0430\u0432\u0435\u0447\u0430\u043a \u0441\u0432\u0430\u0456\u0445, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5041","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f&raquo; \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 14, 3-6: PL 76, 1129-1130)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0434\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u042f &ndash; \u0434\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440 \u0456 \u0432\u0435\u0434\u0430\u044e \u043c\u0430\u0456\u0445 \u0430\u0432\u0435\u0447\u0430\u043a, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u043b\u044e\u0431\u043b\u044e \u0456\u0445, \u0430 \u041c\u0430\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u041c\u044f\u043d\u0435&raquo; (\u043f\u0430\u0440. \u042f\u043d 10, 14). \u0415\u0437\u0443\u0441 \u043d\u0456\u0431\u044b \u0445\u0430\u0446\u0435\u045e \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c: \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u043b\u044e\u0431\u043e\u0432\u0456. \u0411\u043e \u0445\u0442\u043e \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u044b, \u0442\u043e\u0439 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0432\u044b \u045e\u0436\u043e \u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u043d\u0430\u0448 \u0434\u043e\u0441\u0432\u0435\u0434, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u0434\u0443\u043c\u0430\u0439\u0446\u0435 \u043d\u0430 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0435 \u0441\u043b\u043e\u045e \u041f\u0430\u043d\u0430 \u0456 \u043f\u0440\u0430 \u0441\u0432\u043e\u0439 \u0434\u043e\u0441\u0432\u0435\u0434. \u0421\u043f\u044b\u0442\u0430\u0439\u0446\u0435\u0441\u044f \u045e \u0441\u044f\u0431\u0435, \u0446\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0435\u0441\u044f \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456 \u041f\u0430\u043d\u0430, \u0446\u0456 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u042f\u0433\u043e, \u0446\u0456 \u045e\u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0440\u0430\u045e\u0434\u044b? \u0421\u043a\u0430\u0436\u0443, \u0448\u0442\u043e \u0432\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435 \u043d\u0435 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u043b\u044e\u0431\u043e\u045e. \u0421\u043a\u0430\u0436\u0443, \u0448\u0442\u043e \u0432\u044b \u0432\u0435\u0434\u0430\u0435\u0446\u0435 \u043d\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0434\u0430\u0432\u0435\u0440\u0443, \u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0434\u0437\u0435\u044f\u043d\u043d\u044e. \u0421\u0430\u043c \u042f\u043d \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442 \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0433\u044d\u0442\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: &laquo;\u0425\u0442\u043e \u043a\u0430\u0436\u0430: &ldquo;\u042f \u0432\u0435\u0434\u0430\u044e \u0411\u043e\u0433\u0430&rdquo;, \u0430 \u043d\u0435 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u042f\u0433\u043e\u043d\u044b\u044f, \u0442\u043e\u0439 \u0456\u043b\u0433\u0443\u043d&raquo; (1 \u042f\u043d 2, 4).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u043f\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435 \u0433\u044d\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b: &laquo;\u042f\u043a \u041c\u044f\u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0410\u0439\u0446\u0435\u0446, \u0456 \u042f \u0432\u0435\u0434\u0430\u044e \u0410\u0439\u0446\u0430. \u042f \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0430\u0434\u0434\u0430\u044e \u0437\u0430 \u0430\u0432\u0435\u0447\u0430\u043a&raquo; (\u042f\u043d 10, 15). \u042f\u043a \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u043a\u0430\u0436\u0430: \u043f\u0430 \u0442\u044b\u043c \u0432\u044f\u0434\u043e\u043c\u0430, \u0448\u0442\u043e \u042f \u0432\u0435\u0434\u0430\u044e \u0410\u0439\u0446\u0430 \u0456 \u0410\u0439\u0446\u0435\u0446 \u0432\u0435\u0434\u0430\u0435 \u041c\u044f\u043d\u0435, \u0448\u0442\u043e \u042f \u0430\u0434\u0434\u0430\u044e \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0430\u0432\u0435\u0447\u0430\u043a, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0442\u0430\u044f \u043b\u044e\u0431\u043e\u045e, \u0437 \u044f\u043a\u043e\u0439 \u042f \u043f\u0430\u043c\u0456\u0440\u0430\u044e \u0437\u0430 \u0430\u0432\u0435\u0447\u0430\u043a, \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u042f \u043b\u044e\u0431\u043b\u044e \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0437\u043d\u043e\u045e \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a: &laquo;\u0410\u0432\u0435\u0447\u043a\u0456 \u041c\u0430\u0435 \u0441\u043b\u0443\u0445\u0430\u044e\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u041c\u043e\u0439, \u0456 \u042f \u0432\u0435\u0434\u0430\u044e \u0456\u0445, \u0456 \u044f\u043d\u044b \u0456\u0434\u0443\u0446\u044c \u0437\u0430 \u041c\u043d\u043e\u044e, \u0456 \u042f \u0434\u0430\u044e \u0456\u043c \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451&raquo; (\u043f\u0430\u0440. \u042f\u043d 10, 14-16). \u041a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0456\u0445 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043a\u0440\u044b\u0445\u0443 \u0432\u044b\u0448\u044d\u0439: &laquo;\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u045e\u0432\u043e\u0439\u0434\u0437\u0435 \u043f\u0440\u0430\u0437 \u041c\u044f\u043d\u0435, \u0431\u0443\u0434\u0437\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b, \u0456 \u045e\u0432\u043e\u0439\u0434\u0437\u0435, \u0456 \u0432\u044b\u0439\u0434\u0437\u0435, \u0456 \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u043f\u0430\u0448\u0443&raquo; (\u042f\u043d 10, 9). \u0423\u0432\u043e\u0439\u0434\u0437\u0435 \u0434\u0430 \u0432\u0435\u0440\u044b, \u0432\u044b\u0439\u0434\u0437\u0435 \u0430\u0434 \u0432\u0435\u0440\u044b \u0434\u0430 \u0431\u0430\u0447\u0430\u043d\u043d\u044f \u0411\u043e\u0433\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0430\u0434 \u0432\u0435\u0440\u044b \u0434\u0430 \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u044f, \u0430 \u043f\u0430\u0448\u0443 \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u045e \u0432\u0435\u0447\u043d\u044b\u043c \u043d\u0430\u0441\u044b\u0447\u044d\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0430\u0432\u0435\u0447\u043a\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u043f\u0430\u0448\u0443, \u0431\u043e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0456\u0434\u0437\u0435 \u0437\u0430 \u0406\u043c \u0441\u0430 \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c, \u043a\u043e\u0440\u043c\u0456\u0446\u0446\u0430 \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0430\u043c \u0432\u0435\u0447\u043d\u0430\u0439 \u0437\u0435\u043b\u044f\u043d\u0456\u043d\u044b. \u0410 \u043f\u0430\u0448\u0430\u043c\u0456 \u0433\u044d\u0442\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0451\u0441\u0446\u044c \u043d\u0435 \u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u044f\u043a \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0432\u0435\u0447\u043d\u0430 \u043a\u0432\u0456\u0442\u043d\u0435\u044e\u0447\u0430\u0433\u0430 \u0440\u0430\u044e. \u041f\u0430\u0448\u0430 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 &ndash; \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0411\u043e\u0436\u0430\u0433\u0430. \u041a\u0430\u043b\u0456 \u0433\u043b\u044f\u0434\u0437\u0435\u0446\u044c \u043d\u0430 \u044f\u0433\u043e, \u0431\u0443\u0434\u0443\u0447\u044b \u0431\u0435\u0437 \u0437\u0430\u0433\u0430\u043d\u044b, \u0434\u0443\u0448\u0430 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430 \u043d\u0430\u0441\u044b\u0447\u0430\u0435\u0446\u0446\u0430 \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0430\u043c \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0441\u043a\u0456\u0440\u0443\u0435\u043c\u0441\u044f, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0434\u0430 \u0433\u044d\u0442\u044b\u0445 \u043f\u0430\u0448, \u043d\u0430 \u044f\u043a\u0456\u0445 \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0441\u043f\u0430\u0442\u043a\u0430\u043d\u043d\u044e \u0437 \u0442\u0430\u043a\u0456\u043c\u0456 \u0437\u043d\u0430\u043a\u0430\u043c\u0456\u0442\u044b\u043c\u0456 \u0436\u044b\u0445\u0430\u0440\u0430\u043c\u0456. \u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0441 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u043d\u043d\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u0442\u0430\u043c \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430. \u0420\u0430\u0441\u043f\u0430\u043b\u0456\u043c, \u0431\u0440\u0430\u0442\u044b, \u043d\u0430\u0448\u044b \u0441\u044d\u0440\u0446\u044b, \u043d\u044f\u0445\u0430\u0439 \u0434\u0443\u0448\u0430 \u0441\u0430\u0433\u0440\u0430\u0432\u0430\u0435\u0446\u0446\u0430 \u0442\u044b\u043c, \u0443 \u0448\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c; \u043d\u044f\u0445\u0430\u0439 \u0440\u0430\u0437\u0433\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u0448\u0430 \u0456\u043c\u043a\u043d\u0435\u043d\u043d\u0435 \u0434\u0430 \u043d\u0435\u0431\u0430. \u041b\u044e\u0431\u0456\u0446\u044c \u0442\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c &ndash; \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0456\u0441\u0446\u0456 \u0434\u0430 \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0456\u044f\u043a\u0456\u044f \u043d\u044f\u0433\u043e\u0434\u044b \u043d\u0435 \u0430\u0434\u0446\u044f\u0433\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u0430, \u0431\u043e \u043a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u043f\u0440\u0430\u0433\u043d\u0435 \u0456\u0441\u0446\u0456 \u0434\u0430 \u043f\u0440\u0430\u043f\u0430\u043d\u0430\u0432\u0430\u043d\u0430\u0439 \u044f\u043c\u0443 \u043c\u044d\u0442\u044b, \u0442\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u043d\u0435 \u0437\u043c\u0435\u043d\u0456\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u044f \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u044c \u0434\u0430\u0440\u043e\u0433\u0456. \u0422\u0430\u043c\u0443 \u043d\u044f\u0445\u0430\u0439 \u0432\u0430\u0441 \u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0432\u0430\u0435 \u043f\u0440\u044b\u0432\u0430\u0431\u043d\u0430\u0441\u0446\u044c \u0448\u0447\u0430\u0441\u0446\u044f, \u0431\u043e \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b \u0442\u043e\u0439 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a, \u044f\u043a\u0456, \u0443\u0431\u0430\u0447\u044b\u045e\u0448\u044b \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u043a\u0440\u0430\u044f\u0432\u0456\u0434\u044b \u043b\u0443\u0433\u043e\u045e, \u0437\u0430\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430, \u044f\u043a\u043e\u0439 \u0434\u0430\u0440\u043e\u0433\u0430\u0439 \u0456\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042f\u043d 10, 14. 15; 1 \u041a\u0430\u0440 5, 7b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0434\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440, \u044f\u043a\u0456 \u0430\u0434\u0434\u0430\u045e \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0437\u0430 \u0430\u0432\u0435\u0447\u0430\u043a. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u0441\u0432\u043e\u0439 \u0441\u0442\u0430\u0442\u0430\u043a, \u0430\u043b\u043b\u0435\u043b\u044e\u044f. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u0448\u0430\u044f \u041f\u0430\u0441\u0445\u0430, \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b \u0437\u0430 \u043d\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u0441\u0432\u043e\u0439 \u0441\u0442\u0430\u0442\u0430\u043a, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5042","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u043d\u0456\u0433\u0430 &laquo;\u041f\u0440\u0430 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430&raquo; \u0441\u0432. \u0411\u0430\u0437\u044b\u043b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 15, 35-36: PG 32, 130-131)<\/span><br \/><span style=\"color: #ff0000;\">\u0416\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u044b \u0414\u0443\u0445<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0456\u0440\u0443\u044e\u0447\u044b \u043d\u0430\u0448\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c, \u041f\u0430\u043d \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0437 \u043d\u0430\u043c\u0456 \u0434\u0430\u043c\u043e\u0432\u0443 \u0445\u0440\u043e\u0441\u0442\u0443, \u044f\u043a\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0436\u044b\u0446\u0446\u044f. \u0412\u0430\u0434\u0430 \u045e\u0432\u0430\u0441\u0430\u0431\u043b\u044f\u0435 \u0441\u043c\u0435\u0440\u0446\u044c, \u0430 \u0414\u0443\u0445 \u0434\u0430\u0435 \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0436\u044b\u0446\u0446\u044f. \u0422\u0430\u043c\u0443 \u043d\u0430\u043c \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0443 \u0447\u044b\u043c \u0441\u043f\u0440\u0430\u0432\u0430, \u0456 \u0447\u0430\u043c\u0443 \u0432\u0430\u0434\u0430 \u0431\u044b\u043b\u0430 \u0437\u043b\u0443\u0447\u0430\u043d\u0430 \u0437 \u0414\u0443\u0445\u0430\u043c. \u0425\u0440\u043e\u0441\u0442 \u043c\u0430\u0435 \u045e \u0441\u0430\u0431\u0435 \u0434\u0437\u0432\u0435 \u043c\u044d\u0442\u044b, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430, \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u0430 \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u043a\u0430\u0431 \u043f\u043e\u0442\u044b\u043c \u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0430 \u043f\u043b\u0451\u043d\u0443 \u0441\u043c\u0435\u0440\u0446\u0456, \u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u0436\u044b\u0446\u0446\u0451 \u0414\u0443\u0445\u0430, \u043a\u0430\u0431 \u0451\u043d \u043f\u0440\u044b\u043d\u0451\u0441 \u043f\u043b\u0451\u043d \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f. \u0412\u0430\u0434\u0430 \u045e\u0432\u0430\u0441\u0430\u0431\u043b\u044f\u0435 \u0441\u043c\u0435\u0440\u0446\u044c, \u043f\u0430\u043a\u0440\u044b\u0432\u0430\u044e\u0447\u044b \u0446\u0435\u043b\u0430 \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u043c\u0430\u0433\u0456\u043b\u0435, \u0430 \u0414\u0443\u0445 \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u0443\u044e \u0441\u0456\u043b\u0443, \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u044e\u0447\u044b \u043d\u0430\u0448\u044b\u044f \u0434\u0443\u0448\u044b \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0433\u0440\u0430\u0445\u0443 \u0434\u0430 \u043f\u0435\u0440\u0448\u0430\u043f\u0430\u0447\u0430\u0442\u043a\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0413\u044d\u0442\u0430 \u0456 \u0451\u0441\u0446\u044c \u043f\u0430\u045e\u0442\u043e\u0440\u043d\u0430\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0437 \u0432\u0430\u0434\u044b \u0456 \u0414\u0443\u0445\u0430: \u0441\u043c\u0435\u0440\u0446\u044c \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0432\u0430\u0434\u0437\u0435, \u0430 \u043d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u0414\u0443\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044f\u043b\u0456\u043a\u0430\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0445\u0440\u043e\u0441\u0442\u0443 \u0441\u043f\u0430\u045e\u043d\u044f\u0435\u0446\u0446\u0430 \u045e \u043f\u0430\u0442\u0440\u043e\u0439\u043d\u044b\u043c \u0430\u043a\u0443\u043d\u0430\u043d\u043d\u0456 \u0456 \u043f\u0430\u0442\u0440\u043e\u0439\u043d\u044b\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0443, \u043a\u0430\u0431 \u0432\u044b\u044f\u0432\u0456\u045e\u0441\u044f \u0432\u043e\u0431\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u043a\u0430\u0431 \u0434\u0443\u0448\u0430 \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u0430\u0433\u0430 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u043b\u0430\u0441\u044f \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043f\u0435\u0440\u0430\u0434\u0430\u0447\u044b \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0411\u043e\u0436\u0430\u0433\u0430. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043b\u0430\u0441\u043a\u0430, \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u0430\u044f \u045e \u0432\u0430\u0434\u0437\u0435, \u043d\u0435 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0441\u0430\u043c\u043e\u0439 \u0432\u0430\u0434\u044b, \u0430\u043b\u0435 \u0437 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430. \u0411\u043e \u0432\u0430\u0434\u0430 \u0445\u0440\u043e\u0441\u0442\u0443 &ndash; \u0433\u044d\u0442\u0430 \u043d\u0435 \u0430\u0431\u043c\u044b\u0446\u0446\u0451 \u0430\u0434 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0433\u0430 \u0431\u0440\u0443\u0434\u0443, \u0430\u043b\u0435 \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u043d\u043d\u0435 \u045e \u0411\u043e\u0433\u0430 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f. \u0420\u044b\u0445\u0442\u0443\u044e\u0447\u044b \u043d\u0430\u0441 \u0434\u0430 \u0442\u0430\u0433\u043e \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f, \u041f\u0430\u043d \u0434\u0430\u0435 \u043d\u0430\u043c \u043f\u043e\u045e\u043d\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u043d\u0435 \u0437\u043b\u0430\u0432\u0430\u0446\u0446\u0430, \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0434\u0440\u044d\u043d\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0431\u044b\u0446\u044c \u0447\u044b\u0441\u0442\u044b\u043c\u0456 \u0430\u0434 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u043c\u0456 \u0430\u0434 \u0445\u0446\u0456\u0432\u0430\u0441\u0446\u0456. \u0422\u0430\u043a \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b \u0432\u044b\u0431\u0430\u0440 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0443\u0441\u0451 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0434\u043b\u044f \u043d\u0430\u0441 \u0446\u0430\u043b\u043a\u0430\u043c \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u0443 \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0436\u044b\u0446\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443 \u043d\u0430\u043c \u0434\u0430\u0437\u0432\u043e\u043b\u0435\u043d\u0430 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u045e \u0440\u0430\u0439. \u0414\u043b\u044f \u043d\u0430\u0441 \u0430\u0434\u043a\u0440\u044b\u0442\u044b \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0431\u0440\u0430\u043c\u044b, \u043d\u0430\u043c \u0434\u0430\u0437\u0432\u043e\u043b\u0435\u043d\u0430 \u0434\u0430\u043b\u0443\u0447\u044b\u0446\u0446\u0430 \u0434\u0430 \u043b\u0456\u043a\u0443 \u045e\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445. \u041c\u044b \u043c\u043e\u0436\u0430\u043c \u0441\u043c\u0435\u043b\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u044b\u043c \u0410\u0439\u0446\u043e\u043c, \u043c\u043e\u0436\u0430\u043c \u0441\u0442\u0430\u0446\u044c \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043b\u0430\u0441\u043a\u0456 \u0456 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u0446\u0430 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0441\u0432\u044f\u0442\u043b\u0430, \u0434\u0430\u043b\u0443\u0447\u044b\u045e\u0448\u044b\u0441\u044f \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b. \u0410\u0434\u043d\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e\u0441\u044e \u043f\u0430\u045e\u043d\u0430\u0442\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u044f\u043a \u0433\u044d\u0442\u0430\u0433\u0430, \u0442\u0430\u043a \u0456 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0432\u0435\u043a\u0443 \u0456 \u045e\u0436\u043e \u043c\u043e\u0436\u0430\u043c \u0431\u0430\u0447\u044b\u0446\u044c, \u044f\u043a \u0443 \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0443, \u0443\u0441\u0451 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u0430 \u0456 \u0447\u0430\u0433\u043e \u043c\u044b \u0447\u0430\u043a\u0430\u0435\u043c \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443. \u0411\u043e \u043a\u0430\u043b\u0456 \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0442\u0430\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0456, \u0434\u044b\u043a \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0431\u043e\u043b\u044c\u0448\u0430\u0435 \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0433\u0430? \u041a\u0430\u043b\u0456 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0442\u0430\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0456, \u0434\u044b\u043a \u044f\u043a\u0456\u043c \u0436\u0430 \u0431\u0443\u0434\u0437\u0435 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u0435 \u045e\u0441\u044f\u0433\u043e?<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0430\u0434\u0430 \u0445\u0440\u043e\u0441\u0442\u0443 \u0430\u0431\u043c\u044b\u0432\u0430\u0435 \u043d\u0430\u0441 \u0430\u0434 \u0434\u0430\u045e\u043d\u0456\u0445 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e. <span style=\"color: #ff0000;\">*<\/span> \u0421\u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0437 \u043d\u0435\u0431\u0430 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0434\u0430\u0435 \u043d\u0430\u043c \u0411\u043e\u0436\u044b \u0441\u043f\u0430\u043a\u043e\u0439, \u044f\u043a\u0456 \u0433\u043e\u043b\u0443\u0431 \u043f\u0440\u044b\u043d\u0451\u0441 \u0443 \u041d\u043e\u0435\u045e \u043a\u0430\u045e\u0447\u044d\u0433, \u0448\u0442\u043e \u0431\u044b\u045e \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u043c\u044b, \u0431\u043e \u043c\u0430\u0435\u043c \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0432\u0430\u0434\u044b, \u043f\u0440\u0430\u0437 \u044f\u043a\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435\u043c\u0441\u044f \u0434\u043b\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0437 \u043d\u0435\u0431\u0430 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0434\u0430\u0435 \u043d\u0430\u043c \u0411\u043e\u0436\u044b \u0441\u043f\u0430\u043a\u043e\u0439, \u044f\u043a\u0456 \u0433\u043e\u043b\u0443\u0431 \u043f\u0440\u044b\u043d\u0451\u0441 \u0443 \u041d\u043e\u0435\u045e \u043a\u0430\u045e\u0447\u044d\u0433, \u0448\u0442\u043e \u0431\u044b\u045e \u043f\u0440\u0430\u0432\u043e\u0431\u0440\u0430\u0437\u0430\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5043","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041f\u044f\u0442\u0440\u0430 \u0425\u0440\u044b\u0437\u0430\u043b\u043e\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 108: PL 52, 499-500)<\/span><br \/><span style=\"color: #ff0000;\">\u0411\u0443\u0434\u0437\u044c \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0456 \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441 \u043f\u0440\u0430\u0437 \u043b\u0456\u0442\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0443\u044e&raquo; (\u043f\u0430\u0440. \u0420\u044b\u043c 12, 1). \u0422\u0430\u043a \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u041f\u0430\u0432\u0435\u043b, \u0430 \u0445\u0443\u0442\u0447\u044d\u0439, \u043f\u0440\u0430\u0437 \u041f\u0430\u045e\u043b\u0430 \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0411\u043e\u0433, \u0431\u043e \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u042f\u0433\u043e \u0431\u043e\u043b\u044c\u0448 \u043b\u044e\u0431\u0456\u043b\u0456, \u0447\u044b\u043c \u0431\u0430\u044f\u043b\u0456\u0441\u044f. \u041f\u0440\u043e\u0441\u0456\u0446\u044c \u0411\u043e\u0433, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0445\u043e\u0447\u0430 \u0431\u044b\u0446\u044c \u043d\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u043d\u0430\u043c, \u043a\u043e\u043b\u044c\u043a\u0456 \u0410\u0439\u0446\u043e\u043c. \u041f\u0440\u043e\u0441\u0456\u0446\u044c \u0411\u043e\u0433 \u043f\u0440\u0430\u0437 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u043a\u0430\u0431 \u043d\u0435 \u043a\u0430\u0440\u0430\u0446\u044c \u0441\u0443\u0440\u043e\u0432\u0430\u0441\u0446\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043f\u0440\u043e\u0441\u0456\u0446\u044c: \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435 \u0456 \u045e\u0431\u0430\u0447\u0446\u0435 \u045e\u0432\u0430 \u041c\u043d\u0435 \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430, \u0441\u0432\u0430\u0435 \u0447\u043b\u0435\u043d\u044b, \u0441\u0432\u0430\u0451 \u043d\u0443\u0442\u0440\u043e, \u0441\u0432\u0430\u0435 \u043a\u043e\u0441\u0442\u043a\u0456 \u0456 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e. \u0410 \u043a\u0430\u043b\u0456 \u0431\u0430\u0456\u0446\u0435\u0441\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0411\u043e\u0436\u0430\u0435, \u0447\u0430\u043c\u0443 \u043d\u0435 \u043b\u044e\u0431\u0456\u0446\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435? \u041a\u0430\u043b\u0456 \u045e\u0446\u044f\u043a\u0430\u0435\u0446\u0435 \u0430\u0434 \u041f\u0430\u043d\u0430, \u0447\u0430\u043c\u0443 \u043d\u0435 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0435\u0441\u044f \u0434\u0430 \u0410\u0439\u0446\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043e\u0436\u0430, \u0432\u0430\u0441 \u043d\u0435\u043f\u0430\u043a\u043e\u0456\u0446\u044c \u0442\u0430\u044f \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u043c\u0443\u043a\u0430, \u044f\u043a\u0443\u044e \u0432\u044b \u041c\u043d\u0435 \u043f\u0440\u044b\u0447\u044b\u043d\u0456\u043b\u0456? \u041d\u0435 \u0431\u043e\u0439\u0446\u0435\u0441\u044f. \u0413\u044d\u0442\u044b \u043a\u0440\u044b\u0436 \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435 \u0441\u0432\u0430\u0451 \u0432\u0430\u0441\u0442\u0440\u044b\u0451 \u043d\u0435 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0432\u0430\u0441, \u0430 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u0456. \u0413\u044d\u0442\u044b\u044f \u0446\u0432\u0456\u043a\u0456 \u043d\u0435 \u043f\u0440\u0430\u0446\u0456\u043d\u0430\u044e\u0446\u044c \u041c\u044f\u043d\u0435 \u0431\u043e\u043b\u0435\u043c, \u0430 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0433\u043b\u044b\u0431\u043b\u044f\u044e\u0446\u044c \u041c\u0430\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0432\u0430\u0441. \u0413\u044d\u0442\u044b\u044f \u0440\u0430\u043d\u044b \u043d\u0435 \u043f\u0440\u044b\u043c\u0443\u0448\u0430\u044e\u0446\u044c \u041c\u044f\u043d\u0435 \u0441\u0442\u0430\u0433\u043d\u0430\u0446\u044c, \u0430\u043b\u0435 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0443\u0432\u043e\u0434\u0437\u044f\u0446\u044c \u0432\u0430\u0441 \u0443 \u041c\u0430\u0451 \u043d\u0443\u0442\u0440\u043e. \u041c\u0430\u0451 \u0446\u0435\u043b\u0430 \u0440\u0430\u0441\u043f\u0430\u0441\u0446\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u044b\u0446\u044c \u041c\u0430\u044e \u043c\u0443\u043a\u0443, \u0430 \u043a\u0430\u0431 \u043f\u0440\u044b\u0442\u0443\u043b\u0456\u0446\u044c \u0432\u0430\u0441. \u041c\u0430\u044f \u043a\u0440\u043e\u045e \u043d\u0435 \u043f\u0440\u0430\u043f\u0430\u0434\u0430\u0435 \u0434\u0430\u0440\u044d\u043c\u043d\u0430, \u0430\u043b\u0435 \u043f\u043b\u0430\u0446\u0456\u0446\u044c \u0437\u0430 \u0432\u0430\u0448\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u043d\u0430\u0431\u043b\u0456\u0437\u044c\u0446\u0435\u0441\u044f, \u0432\u044f\u0440\u043d\u0456\u0446\u0435\u0441\u044f \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0439\u0446\u0435 \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u0430\u0434\u043f\u043b\u0430\u0447\u0432\u0430\u0435 \u0434\u0430\u0431\u0440\u043e\u043c \u0437\u0430 \u0437\u043b\u043e, \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e \u0437\u0430 \u0437\u043d\u044f\u0432\u0430\u0433\u0456, \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0437\u0430 \u0442\u0430\u043a\u0456\u044f \u0440\u0430\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c, \u0447\u0430\u0433\u043e \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0410\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u041f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u043f\u0440\u0430\u0437 \u043b\u0456\u0442\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0443\u044e: \u0430\u0434\u0434\u0430\u0439\u0446\u0435 \u0432\u0430\u0448\u044b\u044f \u0446\u0435\u043b\u044b \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0443 \u0436\u044b\u0432\u0443\u044e&raquo; (\u0420\u044b\u043c 12, 1). \u041f\u0440\u043e\u0441\u044f\u0447\u044b \u0433\u044d\u0442\u0430\u043a, \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043f\u0430\u0434\u044b\u043c\u0430\u0435 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0434\u0430 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456: &laquo;\u0410\u0434\u0434\u0430\u0439\u0446\u0435 \u0432\u0430\u0448\u044b\u044f \u0446\u0435\u043b\u044b \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0443 \u0436\u044b\u0432\u0443\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0430\u044f \u043d\u0435\u0447\u0443\u0432\u0430\u043d\u0430\u044f \u0432\u0435\u043b\u0456\u0447 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u043a\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430. \u0427\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0430\u043c \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u043d\u0435 \u0448\u0443\u043a\u0430\u0435 \u043f\u0430-\u0437\u0430 \u0441\u0430\u0431\u043e\u0439 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u043e\u0436\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0443, \u0430\u043b\u0435 \u0437 \u0441\u0430\u0431\u043e\u044e \u0456 \u045e \u0441\u0430\u0431\u0435 \u0456 \u0437\u0430 \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u0446\u044c \u0411\u043e\u0433\u0443 \u0437\u0430 \u0441\u044f\u0431\u0435. \u0423 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0456 \u0430\u0445\u0432\u044f\u0440\u0430, \u0456 \u0441\u0432\u044f\u0442\u0430\u0440. \u0410\u0445\u0432\u044f\u0440\u0443 \u0437\u0430\u0431\u0456\u043b\u0456, \u0430\u043b\u0435 \u044f\u043d\u0430 \u0437\u0430\u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0436\u044b\u0432\u043e\u0439, \u0431\u043e \u0441\u0432\u044f\u0442\u0430\u0440, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0443, \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0430\u0431\u0456\u0446\u044c \u0441\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a\u0430\u044f \u0434\u0437\u0456\u045e\u043d\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430, \u043a\u0430\u043b\u0456 \u0446\u0435\u043b\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0431\u0435\u0437 \u0446\u0435\u043b\u0430, \u0430 \u043a\u0440\u043e\u045e \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0431\u0435\u0437 \u043a\u0440\u044b\u0432\u0456. &laquo;\u041f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, &ndash; \u043a\u0430\u0436\u0430, &ndash; \u043f\u0440\u0430\u0437 \u043b\u0456\u0442\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0443\u044e: \u0430\u0434\u0434\u0430\u0439\u0446\u0435 \u0432\u0430\u0448\u044b\u044f \u0446\u0435\u043b\u044b \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0443 \u0436\u044b\u0432\u0443\u044e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0440\u0430\u0442\u044b, \u0433\u044d\u0442\u0430\u044f \u0430\u0445\u0432\u044f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0442\u043e\u0439, \u043a\u0430\u043b\u0456 \u0401\u043d \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u0437\u0430 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0435\u0442\u0443. \u0401\u043d \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u0436\u044b\u0432\u043e\u0439 \u0430\u0445\u0432\u044f\u0440\u0430\u0439, \u0431\u043e \u0401\u043d \u0436\u044b\u0432\u0435, \u0445\u043e\u0446\u044c \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b. \u041f\u0440\u0430\u0437 \u0442\u0430\u043a\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u0441\u043c\u0435\u0440\u0446\u044c \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0430\u0434\u043f\u043b\u0430\u0442\u0443, \u0430\u0445\u0432\u044f\u0440\u0430 \u0442\u0440\u044b\u0432\u0430\u0435 \u0456 \u0436\u044b\u0432\u0435, \u0441\u043c\u0435\u0440\u0446\u044c \u043a\u0430\u0440\u0430\u0435\u0446\u0446\u0430. \u0422\u0430\u043c\u0443 \u0434\u043b\u044f \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430\u045e \u0441\u043c\u0435\u0440\u0446\u044c &ndash; \u0433\u044d\u0442\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435, \u043a\u0430\u043d\u0435\u0446 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0430\u0447\u0430\u0442\u0430\u043a, \u0437\u0430\u0431\u043e\u0439\u0441\u0442\u0432\u0430 &ndash; \u0436\u044b\u0446\u0446\u0451. \u0406 \u045e \u043d\u0435\u0431\u0435 \u0437\u0437\u044f\u044e\u0446\u044c \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043b\u0456\u0447\u044b\u043b\u0456 \u0437\u0430\u0433\u0456\u043d\u0443\u045e\u0448\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u0431\u0440\u0430\u0442\u044b, \u043f\u0440\u0430\u0437 \u043b\u0456\u0442\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0443\u044e: \u0430\u0434\u0434\u0430\u0439\u0446\u0435 \u0432\u0430\u0448\u044b\u044f \u0446\u0435\u043b\u044b \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0443 \u0436\u044b\u0432\u0443\u044e&raquo; (\u0420\u044b\u043c 12, 1). \u0413\u044d\u0442\u0430 \u0442\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u0441\u043f\u044f\u0432\u0430\u045e \u043f\u0440\u0430\u0440\u043e\u043a: &laquo;\u0422\u044b \u043d\u0435 \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0430\u0445\u0432\u044f\u0440\u044b \u0456 \u043f\u0440\u044b\u043d\u0430\u0448\u044d\u043d\u043d\u044f, \u0430\u043b\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0434\u043b\u044f \u043c\u044f\u043d\u0435 \u0446\u0435\u043b\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0431\u0443\u0434\u0437\u044c, \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430, \u0431\u0443\u0434\u0437\u044c \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0442\u0430\u0431\u0435 \u0434\u0430\u043b\u0430 \u0456 \u045e\u0434\u0437\u044f\u043b\u0456\u043b\u0430 \u0411\u043e\u0441\u043a\u0430\u044f \u045e\u043b\u0430\u0434\u0430. \u0410\u043f\u0440\u0430\u043d\u0456 \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u043f\u0430\u0434\u043f\u0435\u0440\u0430\u0436\u044b\u0441\u044f \u043f\u043e\u044f\u0441\u0430\u043c \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u041d\u044f\u0445\u0430\u0439 \u043f\u043e\u043a\u0440\u044b\u0432\u0430\u043c \u043d\u0430 \u0442\u0432\u0430\u0451\u0439 \u0433\u0430\u043b\u0430\u0432\u0435 \u0431\u0443\u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043d\u044f\u0445\u0430\u0439 \u043a\u0440\u044b\u0436 \u043d\u0430 \u0447\u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435 \u0442\u0432\u0430\u0451\u0439 \u0430\u0445\u043e\u0432\u0430\u0439, \u0430 \u0442\u0432\u0430\u0435 \u0433\u0440\u0443\u0434\u0437\u0456 &ndash; \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u0439 \u0411\u043e\u0436\u0430\u0433\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f. \u0417\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0434\u043f\u0430\u043b\u044c\u0432\u0430\u0439 \u043a\u0430\u0434\u0437\u0456\u043b\u044c\u043d\u044b \u0432\u043e\u0434\u0430\u0440 \u043c\u0430\u043b\u0456\u0442\u0432\u044b, \u0441\u0445\u0430\u043f\u0456 \u043c\u0435\u0447 \u0414\u0443\u0445\u0430, \u043f\u0430\u0441\u0442\u0430\u045e \u0441\u0432\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 \u044f\u043a \u0430\u043b\u0442\u0430\u0440. \u0406 \u0442\u0430\u043a \u0431\u044f\u0441\u0441\u0442\u0440\u0430\u0448\u043d\u0430 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u0441\u0432\u0430\u0451 \u0446\u0435\u043b\u0430 \u043d\u0430 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0411\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u0448\u0443\u043a\u0430\u0435 \u0432\u0435\u0440\u044b, \u0430 \u043d\u0435 \u0441\u043c\u0435\u0440\u0446\u0456, \u0401\u043d \u043f\u0440\u0430\u0433\u043d\u0435 \u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u0456, \u0430 \u043d\u0435 \u043a\u0440\u044b\u0432\u0456, \u042f\u0433\u043e \u045e\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u044f\u0435 \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430\u0441\u0446\u044c, \u0430 \u043d\u0435 \u0437\u0430\u0431\u043e\u0439\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0410\u043f 5, 9bcd. 10\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b, \u041f\u0430\u043d\u0435, \u0433\u043e\u0434\u043d\u044b \u045e\u0437\u044f\u0446\u044c \u043a\u043d\u0456\u0433\u0443 \u0456 \u0437\u043d\u044f\u0446\u044c \u0437 \u044f\u0435 \u043f\u044f\u0447\u0430\u0442\u043a\u0456, \u0431\u043e \u0422\u044b \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0422\u044b \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0411\u043e\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0430\u0441 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e \u0422\u044b \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0411\u043e\u0433\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5044","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0421\u0432\u044f\u0442\u0443\u044e \u0422\u0440\u043e\u0439\u0446\u0443&raquo; \u0441\u0432. \u0413\u0456\u043b\u044f\u0440\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 8, 13-16: PL 10, 246-249)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u0430\u044f \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u0437 \u0411\u043e\u0433\u0430\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044e \u0421\u043b\u043e\u0432\u0430 \u0456 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0443 \u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0421\u043b\u043e\u0432\u0430 \u043d\u0430\u0441\u0430\u043c\u0440\u044d\u0447 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c (\u043f\u0430\u0440. \u042f\u043d 1, 14) \u0456 \u043c\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u044b\u043c\u0430\u0435\u043c \u0443\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u044f\u043a \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a \u041f\u0430\u043d\u0430, \u0434\u044b\u043a \u0446\u0456 \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u044b\u0437\u043d\u0430\u0446\u044c, \u0448\u0442\u043e \u0441\u0443\u0442\u043d\u0430\u0441\u043d\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441 \u0442\u043e\u0439, \u0445\u0442\u043e, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0448\u044b\u0441\u044f \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u043d\u0435\u043f\u0430\u0434\u0437\u0435\u043b\u044c\u043d\u0430 \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430\u0442\u0443\u0440\u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u045e \u044f\u0435 \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u0447\u043d\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u0430\u0439 \u0456 \u045e\u0434\u0437\u044f\u043b\u0456\u045e \u044f\u0435 \u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0446\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0426\u0435\u043b\u0430, \u0443 \u044f\u043a\u0456\u043c \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0446\u044c? \u0422\u0430\u043a \u0443\u0441\u0435 \u043c\u044b \u0430\u0434\u0437\u0456\u043d\u044b\u044f, \u0431\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0451\u0441\u0446\u044c \u0410\u0439\u0446\u0435\u0446, \u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0451\u0441\u0446\u044c \u0443 \u043d\u0430\u0441. \u0401\u043d \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u0426\u0435\u043b\u0430, \u0430 \u043c\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c\u0441\u044f \u045e \u0406\u043c. \u041d\u0430\u0448\u0430 \u043d\u0430\u0442\u0443\u0440\u0430, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u0451\u0441\u0446\u044c \u0443 \u0411\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0441\u0430\u043c \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435, \u043d\u0430\u043a\u043e\u043b\u044c\u043ai \u043c\u044b \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u0437 \u0406\u043c \u043f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u042f\u0433\u043e \u0426\u0435\u043b\u0430 \u0456 \u041a\u0440\u044b\u0432\u0456: &laquo;\u0421\u0432\u0435\u0442 \u0443\u0436\u043e \u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u041c\u044f\u043d\u0435. \u0412\u044b \u0436 \u0431\u0430\u0447\u044b\u0446\u0435 \u041c\u044f\u043d\u0435, \u0431\u043e \u042f \u0436\u044b\u0432\u0443, \u0456 \u0432\u044b \u0436\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435\u0446\u0435. \u0423 \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c \u043f\u0430\u0437\u043d\u0430\u0435\u0446\u0435, \u0448\u0442\u043e \u042f \u045e \u0410\u0439\u0446\u0443 \u041c\u0430\u0456\u043c, \u0456 \u0432\u044b \u045e\u0432\u0430 \u041c\u043d\u0435, \u0456 \u042f \u045e \u0432\u0430\u0441&raquo; (\u042f\u043d 14, 19-20). \u041a\u0430\u043b\u0456 \u0431 \u041f\u0430\u043d \u0445\u0430\u0446\u0435\u045e \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0430\u0434\u0437\u0456\u043d\u0430\u0439 \u0432\u043e\u043b\u0456, \u0401\u043d \u0431\u044b \u043d\u0435 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u045e \u043f\u044d\u045e\u043d\u0430\u0433\u0430 \u043f\u0430\u0440\u0430\u0434\u043a\u0443 \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0433\u044d\u0442\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456. \u0410 \u043a\u0430\u043b\u0456 \u0442\u0430\u043a \u0437\u0440\u0430\u0431\u0456\u045e, \u0434\u044b\u043a \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456, \u0448\u0442\u043e \u0401\u043d \u0451\u0441\u0446\u044c \u0443 \u0410\u0439\u0446\u0443 \u045e \u0430\u0434\u0437\u0456\u043d\u0430\u0439 \u0431\u043e\u0441\u043a\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0430 \u043c\u044b &ndash; \u0443 \u0406\u043c \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435; \u0456 \u0401\u043d \u0437\u043d\u043e\u045e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u045e \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043c\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u0432\u0443\u0447\u0430\u043d\u044b\u044f \u043f\u0440\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0443\u044e \u0435\u0434\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u045e\u0437\u043d\u0456\u043a\u043b\u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u041f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0443. \u041c\u044b \u0437\u0430\u0441\u0442\u0430\u0435\u043c\u0441\u044f \u045e \u0406\u043c, \u0430 \u0401\u043d &ndash; \u0443 \u0410\u0439\u0446\u0443; \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0447\u044b\u0441\u044f \u045e \u0410\u0439\u0446\u0443, \u0401\u043d \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441. \u0422\u0430\u043a \u043c\u044b \u045e\u0437\u0440\u0430\u0441\u0442\u0430\u0435\u043c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u0410\u0439\u0446\u043e\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u0433\u043e \u0430\u0434\u0437\u0456\u043d\u0430\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0437 \u0410\u0439\u0446\u043e\u043c \u0430\u0434 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f. \u041c\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0439 \u0437 \u0406\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0456 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0401\u043d \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0447\u044b\u043c \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u0448\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u0430\u044f \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0437 \u0406\u043c, \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u0441\u0430\u043c \u041f\u0430\u043d: &laquo;\u0425\u0442\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435 \u041c\u0430\u0451 \u0426\u0435\u043b\u0430 \u0456 \u043f&rsquo;\u0435 \u041c\u0430\u044e \u041a\u0440\u043e\u045e, \u0442\u0440\u044b\u0432\u0430\u0435 \u045e\u0432\u0430 \u041c\u043d\u0435, \u0430 \u042f \u045e \u0456\u043c&raquo; (\u042f\u043d 6, 56). \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0406\u043c, \u043a\u0430\u043b\u0456 \u0401\u043d \u043f\u0435\u0440\u0448\u044b \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0456 \u043d\u0435 \u045e\u043a\u043b\u044e\u0447\u044b\u0446\u044c \u0443 \u0441\u0432\u0430\u0451 \u0426\u0435\u043b\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u0430\u0435 \u0426\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0443\u0436\u043e \u0430\u0434\u043a\u0440\u044b\u045e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0433\u044d\u0442\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u045e \u0441\u043a\u0430\u0437\u0430\u043d\u044b\u0445 \u0440\u0430\u043d\u0435\u0439 \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u042f\u043a \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435 \u0410\u0439\u0446\u0435\u0446, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435, \u0430 \u042f \u0436\u044b\u0432\u0443 \u043f\u0440a\u0437 \u0410\u0439\u0446\u0430, \u0442\u0430\u043a \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435 \u041c\u044f\u043d\u0435, \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u043f\u0440\u0430\u0437 \u041c\u044f\u043d\u0435&raquo; (\u042f\u043d 6, 57). \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0436\u044b\u0432\u0435 \u043f\u0440\u0430\u0437 \u0410\u0439\u0446\u0430, \u0456 \u044f\u043a \u0401\u043d \u0436\u044b\u0432\u0435 \u043f\u0440\u0430\u0437 \u0410\u0439\u0446\u0430, \u0442\u0430\u043a \u043c\u044b \u0436\u044b\u0432\u0435\u043c \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0426\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u0430\u0435 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0435 \u0441\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u043d\u0430 \u0442\u043e\u0435, \u043a\u0430\u0431 \u0432\u043e\u0431\u0440\u0430\u0437\u043d\u0430 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0443 \u0430\u0431\u043b\u0435\u0433\u0447\u044b\u0446\u044c \u044f\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435. \u041f\u0440\u044b\u0447\u044b\u043d\u0430\u0439 \u0411\u043e\u0436\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u045e \u043d\u0430\u0441 \u0451\u0441\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u043d\u0430\u0441, \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u0445 \u043b\u044e\u0434\u0437\u044f\u0445, \u0446\u044f\u043b\u0435\u0441\u043d\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u043c\u044b \u0436\u044b\u0432\u0435\u043c \u043f\u0440\u0430\u0437 \u042f\u0433\u043e, \u044f\u043a \u0401\u043d \u0436\u044b\u0432\u0435 \u043f\u0440\u0430\u0437 \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 6, 56; \u043f\u0430\u0440. \u0414\u0440\u0433 4, 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0435\u0441\u0446\u044c \u041c\u0430\u0451 \u0426\u0435\u043b\u0430 \u0456 \u043f&rsquo;\u0435 \u041c\u0430\u044e \u041a\u0440\u043e\u045e, <span style=\"color: #ff0000;\">*<\/span> \u0443\u0432\u0430 \u041c\u043d\u0435 \u0451\u0441\u0446\u044c, \u0430 \u042f &ndash; \u0443 \u0456\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u044f\u043c\u0430 \u0456\u043d\u0448\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043a\u0430\u0431 \u044f\u0433\u043e\u043d\u044b\u044f \u0431\u0430\u0433\u0456 \u0431\u044b\u043b\u0456 \u0442\u0430\u043a \u0431\u043b\u0456\u0437\u043a\u0430, \u044f\u043a \u0431\u043b\u0456\u0437\u043a\u0456 \u0451\u0441\u0446\u044c \u0411\u043e\u0433 \u043d\u0430\u0448 \u0434\u0430 \u043d\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0432\u0430 \u041c\u043d\u0435 \u0451\u0441\u0446\u044c, \u0430 \u042f &ndash; \u0443 \u0456\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5045","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 65, 1-3: C\u0421L 36, 490-492)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u043e\u0432\u0430\u044f \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0434\u0430\u0435 \u0441\u0432\u0430\u0456\u043c \u0432\u0443\u0447\u043d\u044f\u043c \u043d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0443\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456. &laquo;\u041d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0434\u0430\u044e \u0432\u0430\u043c, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, &ndash; \u043a\u0430\u0431 \u0432\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441&raquo; (\u042f\u043d 13, 34).<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u043d\u0435 \u0456\u0441\u043d\u0430\u0432\u0430\u043b\u0430 \u0433\u044d\u0442\u0430\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u045e \u0441\u0442\u0430\u0440\u044b\u043c \u0411\u043e\u0436\u044b\u043c \u0417\u0430\u043a\u043e\u043d\u0435, \u0434\u0437\u0435 \u0431\u044b\u043b\u043e \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u041b\u044e\u0431\u0456 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435&raquo; (\u041b\u0435\u0432 19, 18)? \u0414\u044b\u043a \u0447\u0430\u043c\u0443 \u041f\u0430\u043d \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u043d\u043e\u0432\u044b\u043c \u0442\u043e\u0435, \u0448\u0442\u043e, \u044f\u043a \u0432\u044f\u0434\u043e\u043c\u0430, \u0442\u0430\u043a\u043e\u0435 \u0441\u0442\u0430\u0440\u043e\u0435? \u041c\u043e\u0436\u0430, \u0433\u044d\u0442\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u043d\u043e\u0432\u0430\u044f, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e, \u0437\u043d\u044f\u045e\u0448\u044b \u0437 \u043d\u0430\u0441 \u0441\u0442\u0430\u0440\u0443\u044e \u0433\u0440\u044d\u0448\u043d\u0430\u0441\u0446\u044c, \u0415\u0437\u0443\u0441 \u0430\u043f\u0440\u0430\u043d\u0443\u045e \u043d\u0430\u0441 \u0443 \u043d\u043e\u0432\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430? \u0414\u044b\u043a \u0432\u043e\u0441\u044c, \u043b\u044e\u0431\u043e\u045e \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u0435 \u041f\u0430\u043d\u0430 \u0446\u0456, \u0445\u0443\u0442\u0447\u044d\u0439, \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u042f\u043c\u0443. \u0410\u043b\u0435 \u043c\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u043d\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u044f \u043b\u044e\u0431\u043e\u045e, \u0430 \u0442\u0430\u044f, \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f\u043a \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441&raquo; (\u042f\u043d 13, 34), \u043a\u0430\u0431 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0446\u044c \u044f\u0435 \u0430\u0434 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435 \u043d\u0430\u0441, \u043a\u0430\u0431 \u043c\u044b \u0431\u044b\u043b\u0456 \u043d\u043e\u0432\u044b\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c\u0456 \u043d\u043e\u0432\u0430\u0433\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442\u0443, \u043f\u0435\u0441\u043d\u044f\u0440\u0430\u043c\u0456 \u043d\u043e\u0432\u0430\u0439 \u043f\u0435\u0441\u043d\u0456. \u0413\u044d\u0442\u0430\u044f \u043b\u044e\u0431\u043e\u045e, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u043b\u0430 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0456\u043a\u0430\u045e, \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445\u0430\u045e \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0430 \u043f\u0430\u0437\u043d\u0435\u0439 &ndash; \u0441\u0432\u044f\u0442\u044b\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0446\u044f\u043f\u0435\u0440 \u0436\u0430 \u044f\u043d\u0430 \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u0437 \u0443\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0440\u043e\u0434\u0443, \u044f\u043a\u0456 \u043d\u0430\u0441\u044f\u043b\u044f\u0435 \u0437\u044f\u043c\u043b\u044e, \u0441\u0442\u0432\u0430\u0440\u0430\u0435 \u0456 \u0437\u0431\u0456\u0440\u0430\u0435 \u043d\u043e\u0432\u044b \u043d\u0430\u0440\u043e\u0434 &ndash; \u0446\u0435\u043b\u0430 \u043d\u043e\u0432\u0430\u0439 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b \u0430\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u045e \u041f\u0435\u0441\u043d\u0456 \u043f\u0435\u0441\u043d\u044f\u045e: &laquo;\u0414\u0437\u0435 \u0442\u0430\u044f, \u044f\u043a\u0430\u044f \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0431\u0435\u043b\u044b\u043c \u0431\u043b\u044f\u0441\u043a\u0443?&raquo; (\u043f\u0430\u0440. \u041f\u043f 8, 5). \u0421\u043b\u0443\u0448\u043d\u0430, \u0448\u0442\u043e \u045e \u0431\u0435\u043b\u044b\u043c, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u044f, \u0430 \u0447\u044b\u043c \u0436\u0430 \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u044f, \u044f\u043a \u043d\u0435 \u043d\u043e\u0432\u0430\u0439 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0434\u0437\u044e?<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u043e\u045e\u043d\u044b\u044f \u0433\u044d\u0442\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u045e\u0441\u0435 \u0447\u043b\u0435\u043d\u044b \u045e\u0437\u0430\u0435\u043c\u043d\u0430 \u043a\u043b\u0430\u043f\u043e\u0446\u044f\u0446\u0446\u0430 \u0430\u0434\u0437\u0456\u043d \u0430\u0431 \u0430\u0434\u043d\u044b\u043c, \u0456 \u043a\u0430\u043b\u0456 \u043f\u0430\u043a\u0443\u0442\u0443\u0435 \u0430\u0434\u043d\u0430 \u0447\u0430\u0441\u0442\u043a\u0430 \u0446\u0435\u043b\u0430, \u043f\u0430\u043a\u0443\u0442\u0443\u044e\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0451\u0439 \u0456 \u0430\u0441\u0442\u0430\u0442\u043d\u0456\u044f \u0447\u0430\u0441\u0442\u043a\u0456; \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434\u043d\u0430 \u0447\u0430\u0441\u0442\u043a\u0430, \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u0437 \u0451\u0439 \u0456 \u0456\u043d\u0448\u044b\u044f \u0447\u0430\u0441\u0442\u043a\u0456 (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 12, 25-26). \u0411\u043e \u044f\u043d\u044b \u0447\u0443\u044e\u0446\u044c \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430: &laquo;\u041d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0434\u0430\u044e \u0432\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e&raquo; (\u042f\u043d 13, 34). \u042f\u043d\u044b \u043b\u044e\u0431\u044f\u0446\u044c \u043d\u0435 \u0442\u0430\u043a \u044f\u043a \u0433\u0440\u044d\u0448\u043d\u044b\u044f \u043b\u044e\u0434\u0437\u0456 \u045e \u0441\u0432\u0430\u0451\u0439 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456. \u042f\u043d\u044b \u045e\u0441\u0435 \u0431\u0430\u0433\u0456 \u0456 \u0441\u044b\u043d\u044b \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430, \u0456 \u0431\u0440\u0430\u0442\u044b \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u0442\u0430\u043c\u0443 \u043b\u044e\u0431\u044f\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0442\u0430\u043a\u043e\u0439 \u043b\u044e\u0431\u043e\u045e\u044e, \u044f\u043a\u043e\u0439 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0456\u0445 \u041f\u0430\u043d, \u043a\u0430\u0431 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u0442\u0443\u0434\u044b, \u0434\u0437\u0435 \u045e\u0441\u0435 \u0456\u0445 \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u043d\u0430\u0441\u044b\u0447\u0430\u043d\u044b \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u043c\u0456 (\u043f\u0430\u0440. \u041f\u0441 103 [102], 5). \u0406 \u043a\u043e\u0436\u043d\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0442\u0430\u0434\u044b \u043d\u0430\u0441\u044b\u0447\u0430\u043d\u0430, \u043a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0431\u0443\u0434\u0437\u0435 \u045e\u0441\u0451 \u0432\u0430 \u045e\u0441\u0456\u0445 (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 15, 28).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0430\u0435 \u043d\u0430\u043c \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041a\u0430\u0431 \u0432\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u042f \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441&raquo; (\u042f\u043d 13, 34).<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u043c\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e. \u041b\u044e\u0431\u044f\u0447\u044b \u043d\u0430\u0441, \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u043c\u043e\u0446, \u043a\u0430\u0431 \u043c\u044b \u0437\u0432\u044f\u0437\u0430\u043b\u0456\u0441\u044f \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u0439 \u0443\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0456 \u043a\u0430\u0431, \u0437\u043b\u0443\u0447\u0430\u043d\u044b\u044f \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u0439 \u043f\u043e\u0432\u044f\u0437\u0437\u044e \u043b\u044e\u0431\u043e\u0432\u0456, \u0441\u0442\u0430\u043b\u0456 \u0446\u0435\u043b\u0430\u043c \u0442\u0430\u043a\u043e\u0439 \u0413\u0430\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u042f\u043d 4, 21; \u041c\u0446 22, 40<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b \u043c\u0430\u0435\u043c \u0430\u0434 \u0411\u043e\u0433\u0430 \u0442\u0430\u043a\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c, <span style=\"color: #ff0000;\">*<\/span> \u043a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u043b\u044e\u0431\u0456\u045e \u0456 \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430 \u0433\u044d\u0442\u044b\u0445 \u0434\u0437\u0432\u044e\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u0445 \u0433\u0440\u0443\u043d\u0442\u0443\u0435\u0446\u0446\u0430 \u045e\u0432\u0435\u0441\u044c \u0417\u0430\u043a\u043e\u043d \u0456 \u041f\u0440\u0430\u0440\u043e\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u043b\u044e\u0431\u0456\u045e \u0456 \u0431\u0440\u0430\u0442\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5046","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041b\u0456\u0441\u0442 \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&raquo; \u0441\u0432. \u041a\u043b\u0456\u043c\u044d\u043d\u0442\u0430 \u0406, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 36, 1-2; 37-38: Funk 1, 145-149)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u0446\u0435\u0436\u0430\u043a \u0448\u043c\u0430\u0442, \u0414\u0430\u0440\u043e\u0433\u0430 \u0430\u0434\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0434\u0430\u0440\u043e\u0433\u0430, \u043d\u0430 \u044f\u043a\u043e\u0439 \u043c\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c \u043d\u0430\u0448\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, &ndash; \u0433\u044d\u0442\u0430 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440 \u043d\u0430\u0448\u044b\u0445 \u0430\u0445\u0432\u044f\u0440\u0430\u045e, \u043d\u0430\u0448 \u0430\u043f\u044f\u043a\u0443\u043d \u0443 \u043d\u044f\u0434\u043e\u043b\u0456 \u0456 \u043d\u0430\u0448\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u042f\u0433\u043e \u043c\u044b \u0433\u043b\u044f\u0434\u0437\u0456\u043c \u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0432\u044b\u0441\u0456; \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0441\u0443\u0437\u0456\u0440\u0430\u0435\u043c \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0435 \u0456 \u045e\u0437\u043d\u0451\u0441\u043b\u0430\u0435 \u0411\u043e\u0436\u0430\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430; \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0430\u0434\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u0432\u043e\u0447\u044b \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430; \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u043d\u0430\u0448 \u0440\u043e\u0437\u0443\u043c, \u0437\u0430\u043c\u0433\u043b\u0451\u043d\u044b \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u0435\u043c, \u043a\u0432\u0456\u0442\u043d\u0435\u0435 \u045e \u0441\u0432\u044f\u0442\u043b\u0435; \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u041f\u0430\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u0441\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044c \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0435 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435, \u0430 \u0441\u0430\u043c \u0401\u043d, &laquo;\u0431\u0443\u0434\u0443\u0447\u044b \u0430\u0434\u043b\u044e\u0441\u0442\u0440\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0411\u043e\u0436\u0430\u0439 \u0441\u043b\u0430\u0432\u044b, \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u0448\u044d\u0439\u0448\u044b \u0437\u0430 \u0430\u043d\u0451\u043b\u0430\u045e, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043e\u043b\u044c\u0448 \u0441\u043b\u0430\u045e\u043d\u0430\u0435, \u0447\u044b\u043c \u044f\u043d\u044b, \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0456\u043c\u044f&raquo; (\u043f\u0430\u0440. \u0413\u0431\u0440 1, 3-4).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u0443\u0436\u044b \u0456 \u0431\u0440\u0430\u0442\u044b, \u0434\u044b\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u0437\u043c\u0430\u0433\u0430\u0446\u0446\u0430 \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b\u0430\u045e \u043f\u0430\u0434 \u0437\u043d\u0430\u043a\u0430\u043c \u042f\u0433\u043e \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u0445 \u043d\u0430\u043a\u0430\u0437\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0433\u043b\u0435\u0434\u0437\u0456\u043c\u0441\u044f \u0434\u0430 \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u045e, \u043f\u0430\u0434\u043d\u0430\u0447\u0430\u043b\u0435\u043d\u044b\u0445 \u043d\u0430\u0448\u044b\u043c \u0432\u0430\u0439\u0441\u043a\u0430\u0432\u043e\u0434\u0446\u0430\u043c, \u044f\u043a \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0430, \u044f\u043a \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430 \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u0430 \u044f\u043d\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u0437\u0430\u0433\u0430\u0434\u044b. \u041d\u0435 \u045e\u0441\u0435 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043f\u0440\u044d\u0444\u0435\u043a\u0442\u0430\u043c\u0456 \u0446\u0456 \u0442\u0440\u044b\u0431\u0443\u043d\u0430\u043c\u0456, \u0441\u043e\u0442\u043d\u0456\u043a\u0430\u043c\u0456 \u0446\u0456 \u043f\u044f\u0446\u0456\u0434\u0437\u0435\u0441\u044f\u0442\u043d\u0456\u043a\u0430\u043c\u0456 \u0456 \u0433\u044d\u0442\u0430\u043a \u0434\u0430\u043b\u0435\u0439, \u0430\u043b\u0435 \u043a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u043d\u0430 \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u0441\u0430\u0434\u0437\u0435 \u0456 \u043f\u0430\u0437\u0456\u0446\u044b\u0456 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435 \u0437\u0430\u0433\u0430\u0434\u044b \u0446\u044d\u0437\u0430\u0440\u0430 \u0456 \u0432\u0430\u0439\u0441\u043a\u0430\u0432\u043e\u0434\u0446\u044b. \u041d\u0430\u0447\u0430\u043b\u044c\u043d\u0456\u043a\u0456 \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u0456\u0441\u043d\u0430\u0432\u0430\u0446\u044c \u0431\u0435\u0437 \u043f\u0430\u0434\u043d\u0430\u0447\u0430\u043b\u0435\u043d\u044b\u0445 \u0456 \u043d\u0430\u0430\u0434\u0432\u0430\u0440\u043e\u0442, \u0430 \u045e\u0441\u0435 \u0440\u0430\u0437\u0430\u043c \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0434\u043b\u044f \u043d\u0430\u0441 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u0446\u0435\u043b\u0430. \u0413\u0430\u043b\u0430\u0432\u0430 \u0431\u0435\u0437 \u043d\u043e\u0433 &ndash; \u0433\u044d\u0442\u0430 \u043d\u0456\u0448\u0442\u043e, \u044f\u043a \u0456 \u043d\u043e\u0433\u0456 \u0431\u0435\u0437 \u0433\u0430\u043b\u0430\u0432\u044b; \u043d\u0430\u0432\u0430\u0442 \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u044b\u044f \u0447\u0430\u0441\u0442\u043a\u0456 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b\u044f \u0456 \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u044f \u043d\u0430\u0448\u0430\u043c\u0443 \u0446\u0435\u043b\u0443, \u0443\u0441\u0451 \u0437\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0430\u0434\u043d\u043e \u0430\u0434 \u0430\u0434\u043d\u0430\u0433\u043e, \u0456 \u045e\u0441\u0435 \u0440\u0430\u0437\u0430\u043c \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430, \u043a\u0430\u0431 \u0437\u0430\u0431\u044f\u0441\u043f\u0435\u0447\u044b\u0446\u044c \u0456\u0441\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u045e\u0441\u044f\u0433\u043e \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u043d\u044f\u0445\u0430\u0439 \u0456 \u043d\u0430\u0448\u0430\u0435 \u0446\u0435\u043b\u0430 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0443 \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435, \u0430 \u043a\u043e\u0436\u043d\u044b \u0437 \u043d\u0430\u0441 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0432\u0430\u0439\u043c\u0443 \u0431\u0440\u0430\u0442\u0443 \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u043c \u0434\u0430\u0440\u0430\u043c \u043b\u0430\u0441\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043e\u0446\u043d\u044b \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0441\u043b\u0430\u0431\u043e\u0433\u0430, \u0430 \u0442\u043e\u0439 \u043d\u044f\u0445\u0430\u0439 \u0448\u0430\u043d\u0443\u0435 \u043c\u043e\u0446\u043d\u0430\u0433\u0430; \u0431\u0430\u0433\u0430\u0442\u044b \u043d\u044f\u0445\u0430\u0439 \u0448\u0447\u043e\u0434\u0440\u0430 \u0434\u0437\u0435\u043b\u0456\u0446\u0446\u0430 \u0437 \u0431\u0435\u0434\u043d\u044b\u043c, \u0430 \u0431\u0435\u0434\u043d\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u0411\u043e\u0433\u0430 \u0437\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u045e \u0430\u0441\u043e\u0431\u0435 \u0431\u0430\u0433\u0430\u0442\u0430\u0433\u0430. \u041c\u0443\u0434\u0440\u044b \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0441\u0432\u0430\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u043d\u0435 \u0441\u043b\u043e\u0432\u0430\u043c\u0456, \u0430 \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u045e\u0447\u044b\u043d\u043a\u0430\u043c\u0456; \u043f\u0430\u043a\u043e\u0440\u043d\u044b \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0434\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u043f\u0440\u0430 \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u043f\u0430\u043a\u0456\u043d\u0435 \u044f\u0433\u043e \u0456\u043d\u0448\u044b\u043c. \u0427\u044b\u0441\u0442\u044b \u0446\u0435\u043b\u0430\u043c \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0456 \u043d\u044f\u0445\u0430\u0439 \u0432\u0435\u0434\u0430\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u041f\u0430\u043d \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u044f\u0433\u043e \u0434\u0430\u0440\u0430\u043c \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0440\u0430\u0437\u0432\u0430\u0436\u0430\u0435\u043c, \u0431\u0440\u0430\u0442\u044b, \u0437 \u044f\u043a\u043e\u0439 \u043c\u0430\u0442\u044d\u0440\u044b\u0456 \u043c\u044b \u045e\u0437\u043d\u0456\u043a\u043b\u0456 \u0456 \u044f\u043a\u0456\u043c\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u043d\u0430 \u0441\u0432\u0435\u0442, \u0437 \u044f\u043a\u043e\u0439 \u0437\u043c\u0440\u043e\u0447\u043d\u0430\u0439 \u043c\u0430\u0433\u0456\u043b\u044b \u043d\u0430\u0441 \u0432\u044b\u0432\u0435\u045e \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0456 \u0441\u0444\u0430\u0440\u043c\u0430\u0432\u0430\u045e \u043d\u0430\u0441. \u0401\u043d \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0441\u0432\u0430\u0456\u0445 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u045e \u044f\u0448\u0447\u044d \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0448\u044b\u043c \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435\u043c \u0456 \u043f\u0440\u044b\u0439\u0441\u0446\u0435\u043c \u043d\u0430 \u0441\u0432\u0435\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0443\u0441\u0451, \u0448\u0442\u043e \u045e \u043d\u0430\u0441 \u0451\u0441\u0446\u044c, \u043c\u044b \u043c\u0430\u0435\u043c \u0430\u0434 \u042f\u0433\u043e \u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u0437\u0430 \u045e\u0441\u0451 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u042f\u043c\u0443, \u044f\u043a\u043e\u043c\u0443 \u0441\u043b\u0430\u0432\u0430 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041a\u043b\u0441 1, 18; 2, 12b. 9-10. 12a<\/span> <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d &ndash; \u0413\u0430\u043b\u0430\u0432\u0430 \u0446\u0435\u043b\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0401\u043d &ndash; \u043f\u0430\u0447\u0430\u0442\u0430\u043a, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445. <span style=\"color: #ff0000;\">*<\/span> \u0412\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0406\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u045e \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u0430 \u0436\u044b\u0432\u0435 \u045e \u0406\u043c, \u0456 \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043f\u0430\u045e\u043d\u0430\u0442\u0443 \u045e \u0406\u043c, \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u0445\u0440\u043e\u0441\u0446\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0406\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u045e \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5047","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u041f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0434\u0430 \u0420\u044b\u043c\u043b\u044f\u043d\u0430\u045e&raquo; \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 15, 7: PG 74, 854-855)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0430\u043b\u0456 \u043d\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u0448\u044b\u0440\u044b\u043b\u0430\u0441\u044f \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u044f \u043b\u0430\u0441\u043a\u0430, \u0437\u0431\u0430\u0432\u0456\u045e\u0441\u044f \u0446\u044d\u043b\u044b \u0441\u0432\u0435\u0442<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u043c\u044b \u0440\u0430\u0437\u0430\u043c \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u043c \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430 \u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0447\u043b\u0435\u043d\u0430\u043c\u0456 \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430, \u0430 \u0437\u043b\u0443\u0447\u0430\u0435 \u043d\u0430\u0441 \u0443 \u0430\u0434\u043d\u043e \u043f\u043e\u0432\u044f\u0437\u044c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456: &laquo;\u0401\u043d \u0443\u0447\u044b\u043d\u0456\u045e \u0430\u0434\u043d\u043e \u0456 \u0434\u0440\u0443\u0433\u043e\u0435 \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0456 \u0437\u0440\u0443\u0439\u043d\u0430\u0432\u0430\u045e \u043c\u0443\u0440 \u0432\u0430\u0440\u043e\u0436\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u043f\u0430\u0434\u0437\u044f\u043b\u044f\u045e. \u0410 \u0437\u0430\u043a\u043e\u043d \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u0435\u043c&raquo; (\u043f\u0430\u0440. \u042d\u0444 2, 14). \u0422\u0430\u043c\u0443 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0447\u0443\u0432\u0430\u0446\u044c \u0430\u0434\u043d\u043e \u0456 \u0442\u043e\u0435 \u0436, \u0430 \u043a\u0430\u043b\u0456 \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0430\u0434\u043d\u0430 \u0447\u0430\u0441\u0442\u043a\u0430, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0441\u043f\u0430\u0447\u0443\u0432\u0430\u0446\u044c \u0456 \u0456\u043d\u0448\u044b\u044f \u0447\u0430\u0441\u0442\u043a\u0456 \u0446\u0435\u043b\u0430; \u043a\u0430\u043b\u0456 \u0436 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434\u043d\u0430 \u0447\u0430\u0441\u0442\u043a\u0430 \u0446\u0435\u043b\u0430, \u043d\u044f\u0445\u0430\u0439 \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u045e\u0441\u0435 \u0447\u0430\u0441\u0442\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432. \u041f\u0430\u0432\u0435\u043b \u043a\u0430\u0436\u0430: &laquo;\u041f\u0440\u044b\u043c\u0430\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u044f\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0440\u044b\u043d\u044f\u045e \u0432\u0430\u0441 \u043d\u0430 \u0445\u0432\u0430\u043b\u0443 \u0411\u043e\u0436\u0443\u044e&raquo; (\u0420\u044b\u043c 15, 7). \u041c\u044b \u043f\u0440\u044b\u043c\u0430\u0435\u043c \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u0433\u043e \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u043c \u0430\u0434\u0447\u0443\u0432\u0430\u0446\u044c \u0430\u0434\u043d\u043e \u0456 \u0442\u043e\u0435 \u0436, \u043d\u0435\u0441\u0443\u0447\u044b \u045e\u0437\u0430\u0435\u043c\u043d\u0430 \u0446\u044f\u0436\u0430\u0440 \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0447\u044b &laquo;\u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e&raquo; (\u042d\u0444 4, 3 ). \u0422\u0430\u043a \u043d\u0430\u0441 \u043f\u0440\u044b\u043d\u044f\u045e \u0411\u043e\u0433 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435. \u0411\u043e \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043a\u0430\u0436\u0430: &laquo;\u0411\u043e\u0433 \u0442\u0430\u043a \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0441\u0432\u0435\u0442, \u0448\u0442\u043e \u0430\u0434\u0434\u0430\u045e \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0437\u0430 \u043d\u0430\u0441&raquo; (\u043f\u0430\u0440. \u042f\u043d 3, 16). \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0431\u044b\u045e \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430 \u0432\u043e\u0434\u043a\u0443\u043f \u0437\u0430 \u0436\u044b\u0446\u0446\u0451 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441. \u0406 \u043c\u044b \u0431\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u043d\u0435\u0441\u0435\u043d\u044b\u044f \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u044f \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0433\u0440\u0430\u0445\u0443. \u041c\u044d\u0442\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u043d\u044f \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b, \u043a\u0430\u0436\u0443\u0447\u044b, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0442\u0430\u045e \u0441\u043b\u0443\u0433\u043e\u0439 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445 \u0434\u043b\u044f \u0434\u043e\u043a\u0430\u0437\u0443 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0441\u0446\u0456 \u0411\u043e\u0433\u0430. \u0411\u043e\u0433 \u0430\u0431\u044f\u0446\u0430\u045e \u043f\u0440\u0430\u0430\u0439\u0446\u0430\u043c \u044e\u0434\u044d\u044f\u045e, \u0448\u0442\u043e \u045e \u0456\u0445 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0435 \u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0456 \u0448\u0442\u043e \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u044c \u0456\u0445, \u044f\u043a \u0437\u043e\u0440\u043a\u0456 \u043d\u0430 \u043d\u0435\u0431\u0435. \u0422\u0430\u043c\u0443 \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u045e \u0446\u0435\u043b\u0435 \u0456 \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0442\u043e\u0439, \u0445\u0442\u043e \u0441\u0430\u043c \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c \u0456 \u0421\u043b\u043e\u0432\u0430\u043c, \u0456 \u044f\u043a \u0411\u043e\u0433 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0456 \u0434\u0430\u0435 \u045e\u0441\u0456\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u0401\u043d \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0430 \u0433\u044d\u0442\u044b \u0441\u0432\u0435\u0442 \u0443 \u0446\u0435\u043b\u0435 \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u042f\u043c\u0443 \u0441\u043b\u0443\u0436\u044b\u043b\u0456, \u0430 \u0445\u0443\u0442\u0447\u044d\u0439 \u043a\u0430\u0431, \u044f\u043a \u043a\u0430\u0436\u0430, \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0456 \u0430\u0434\u0434\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u043d\u0430 \u0432\u043e\u0434\u043a\u0443\u043f \u0437\u0430 \u043c\u043d\u043e\u0433\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u045e, \u0448\u0442\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456, \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u044f \u0406\u0437\u0440\u0430\u044d\u043b\u044e: &laquo;\u042f \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0430 \u0437\u0430\u0433\u0456\u043d\u0443\u045e\u0448\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0437 \u0434\u043e\u043c\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f&raquo; (\u041c\u0446 15, 24). \u0422\u0430\u043c\u0443 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0441\u043b\u0443\u0448\u043d\u0430 \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u0442\u0430\u045e \u0441\u043b\u0443\u0433\u043e\u0439 \u0430\u0431\u0440\u044d\u0437\u0430\u043d\u044b\u0445, \u043a\u0430\u0431 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456, \u0434\u0430\u0434\u0437\u0435\u043d\u044b\u044f \u0430\u0439\u0446\u0430\u043c, \u0456 \u0448\u0442\u043e \u0434\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0401\u043d \u0431\u044b\u045e \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c \u0410\u0439\u0446\u043e\u043c. \u0415\u0437\u0443\u0441 \u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0456 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u042f\u0433\u043e \u044f\u043a \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f \u0456 \u0414\u043e\u0439\u043b\u0456\u0434\u0430 \u0441\u0443\u0441\u0432\u0435\u0442\u0443, \u044f\u0433\u043e \u0417\u0430\u0445\u0430\u0432\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0456 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043b\u0430\u0441\u043a\u0430 \u0411\u043e\u0433\u0430 \u043f\u0430\u0448\u044b\u0440\u044b\u043b\u0430\u0441\u044f \u043d\u0430 \u045e\u0441\u0456\u0445 \u0456 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u043d\u0435 \u0430\u0434\u044b\u0448\u043b\u0430 \u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u043c\u044d\u0442\u044b, \u044f\u043a\u043e\u0439 \u0451\u0441\u0446\u044c \u043b\u0430\u0441\u043a\u0430. \u0417\u0430\u043c\u0435\u0441\u0442 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u045e\u0441\u044f, \u0431\u044b\u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0411\u043e\u0436\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0437 13, 46-47<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0430\u043c \u043f\u0435\u0440\u0448\u044b\u043c \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0441\u043b\u043e\u0432\u0430 \u0411\u043e\u0436\u0430\u0435. \u0410\u043b\u0435 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0432\u044b \u0430\u0434\u043a\u0456\u0434\u0432\u0430\u0435\u0446\u0435 \u044f\u0433\u043e \u0456 \u043b\u0456\u0447\u044b\u0446\u0435 \u0441\u0430\u043c\u0456\u0445 \u0441\u044f\u0431\u0435 \u043d\u044f\u0432\u0430\u0440\u0442\u044b\u043c\u0456 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, <span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u043c\u0443 \u043c\u044b \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u043c\u0441\u044f \u0434\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0430\u043a \u043d\u0430\u043c \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u041f\u0430\u043d: \u042f \u0437\u0440\u0430\u0431\u0456\u045e \u0446\u044f\u0431\u0435 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0434\u043b\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u043c\u044b \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u043c\u0441\u044f \u0434\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5051","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041c\u0430\u043a\u0441\u0456\u043c\u0430 \u0422\u0443\u0440\u044b\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 53, 1-2. 4: CCL 23, 214-216)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0433\u044d\u0442\u0430 \u0434\u0437\u0435\u043d\u044c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434\u0445\u043b\u0430\u043d\u044c; \u043f\u0440\u0430\u0437 \u043d\u043e\u0432\u044b\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0437\u044f\u043c\u043b\u044f; \u043d\u0435\u0431\u0430 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0430\u0434\u043a\u0440\u044b\u0442\u0430\u044f \u0431\u0435\u0437\u0434\u0430\u043d\u044c \u0432\u044f\u0440\u0442\u0430\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u0430\u044f \u0437\u044f\u043c\u043b\u044f \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u044b\u0445, \u0430\u0434\u043a\u0440\u044b\u0442\u0430\u0435 \u043d\u0435\u0431\u0430 \u043f\u0440\u044b\u043c\u0430\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0434\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u045e \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0432\u0430\u0442 \u0437\u043b\u043e\u0434\u0437\u0435\u0439 \u043f\u0430\u0434\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u045e \u0440\u0430\u0439, \u0446\u0435\u043b\u044b \u0441\u0432\u044f\u0442\u044b\u0445 \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u044b \u0433\u043e\u0440\u0430\u0434, \u043c\u0451\u0440\u0442\u0432\u044b\u044f \u0432\u044f\u0440\u0442\u0430\u044e\u0446\u0446\u0430 \u0434\u0430 \u0436\u044b\u0432\u044b\u0445. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0432\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u0441\u0451 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430 \u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0439 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0445\u043b\u0430\u043d\u044c \u0430\u0434\u0434\u0430\u0435 \u0441\u0432\u0430\u044e \u045e\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044c \u043d\u044f\u0431\u0451\u0441\u0430\u043c; \u0437\u044f\u043c\u043b\u044f \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0435 \u045e \u043d\u0435\u0431\u0430 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043f\u0430\u0445\u0430\u0432\u0430\u043b\u0430; \u043d\u0435\u0431\u0430 \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u0435 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043f\u0440\u044b\u043d\u044f\u043b\u043e. \u0423\u0441\u0451 \u043f\u0430\u0434\u044b\u043c\u0430\u0435 \u0437 \u043d\u0456\u0437\u0456\u043d\u0430\u045e \u0430\u0434\u043d\u0430 \u0456 \u0442\u0430\u044f \u0436 \u043c\u0443\u043a\u0430 \u0417\u0431\u0430\u045e\u0446\u044b, \u0443\u0437\u043d\u043e\u0441\u0456\u0446\u044c \u0437 \u0437\u044f\u043c\u043b\u0456 \u0456 \u0440\u0430\u0437\u043c\u044f\u0448\u0447\u0430\u0435 \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0436\u044b\u0446\u0446\u0451 \u0434\u043b\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0434\u043b\u044f \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e \u0456 \u0441\u043b\u0430\u0432\u0430 \u0434\u043b\u044f \u0441\u0432\u044f\u0442\u044b\u0445. \u0421\u0432\u044f\u0442\u044b \u043f\u0440\u0430\u0440\u043e\u043a \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435 \u045e\u0441\u044f\u043a\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0436\u0443\u0447\u044b, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u044f\u043a\u0456 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u041f\u0430\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u043b\u043e \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u044b \u0434\u0437\u0435\u043d\u044c, \u044f\u043a\u0456 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043d\u043e\u0447\u044b. \u0410 \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u044b\u043c \u0434\u043d\u0451\u043c \u0451\u0441\u0446\u044c \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b: &laquo;\u041d\u043e\u0447 \u043c\u0456\u043d\u0443\u043b\u0430 \u0456 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u045e\u0441\u044f \u0434\u0437\u0435\u043d\u044c&raquo; (\u0420\u044b\u043c 13, 12). \u041a\u0430\u0436\u0430, \u0448\u0442\u043e &laquo;\u043d\u043e\u0447 \u043c\u0456\u043d\u0443\u043b\u0430&raquo;, \u0430 \u043d\u0435 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u043a\u0430\u0431 \u043c\u044b \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456: \u043a\u0430\u043b\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u043e \u0425\u0440\u044b\u0441\u0442\u0430, \u0440\u0430\u0441\u0441\u0435\u0439\u0432\u0430\u0435\u0446\u0446\u0430 \u0446\u0435\u043c\u0440\u0430 \u0434&rsquo;\u044f\u0431\u043b\u0430, \u0456 \u043d\u0435 \u043f\u0430\u0434\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0446\u0435\u043c\u0440\u0430 \u0433\u0440\u0430\u0445\u0443, \u0431\u043e \u0430\u0434 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430\u0433\u0430 \u0431\u043b\u044f\u0441\u043a\u0443 \u045e\u0446\u044f\u043a\u0430\u044e\u0446\u044c \u0434\u0430\u045e\u043d\u0456\u044f \u0445\u043c\u0430\u0440\u044b \u0456 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0430\u0434\u043a\u0440\u0430\u0441\u0446\u0456\u0441\u044f \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u043c \u0434\u043d\u0451\u043c \u0451\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0456 \u0433\u044d\u0442\u0430 \u042f\u043c\u0443 \u0410\u0439\u0446\u0435\u0446, \u044f\u043a\u0456 \u0441\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043d\u0451\u043c, \u043f\u0435\u0440\u0430\u0434\u0430\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0441\u0432\u0430\u0451\u0439 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456. \u0413\u044d\u0442\u0430 \u0401\u043d \u0442\u043e\u0439 \u0434\u0437\u0435\u043d\u044c, \u044f\u043a\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430: &laquo;\u042f \u045e\u0447\u044b\u043d\u0456\u045e, \u0448\u0442\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043c\u043d\u0435 \u043d\u0430 \u043d\u0435\u0431\u0435 \u045e\u0437\u044b\u0448\u043b\u043e \u043d\u0435\u043f\u0430\u0433\u0430\u0441\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0437\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0434\u043d\u0451\u043c \u043d\u0435 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u044f \u043d\u043e\u0447, \u0442\u0430\u043a \u0456 \u0437\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0425\u0440\u044b\u0441\u0442\u0430 \u043d\u0435 \u0456\u0434\u0437\u0435 \u0446\u0435\u043c\u0440\u0430 \u0433\u0440\u0430\u0445\u0443. \u041d\u044f\u0431\u0435\u0441\u043d\u044b \u0434\u0437\u0435\u043d\u044c \u0437\u0430\u045e\u0436\u0434\u044b \u0437\u0437\u044f\u0435 \u044f\u0441\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u044f\u0433\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0430\u0441\u043b\u0430\u043d\u0456\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u044f \u0446\u0435\u043c\u0440\u0430. \u0422\u0430\u043a \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u044f\u0440\u0447\u044d\u0435 \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u044b\u043c \u043f\u0440\u0430\u043c\u0435\u043d\u043d\u0435\u043c, \u0456 \u044f\u0433\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0430\u0441\u043b\u0430\u043d\u0456\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u044f \u0446\u0435\u043c\u0440\u0430 \u0433\u0440\u0430\u0445\u043e\u045e, \u0442\u0430\u043c\u0443 \u0441\u0432. \u042f\u043d \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442 \u043a\u0430\u0436\u0430: &laquo;\u0410 \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u0443 \u0446\u0435\u043c\u0440\u044b, \u0456 \u0446\u0435\u043c\u0440\u0430 \u043d\u0435 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u044f\u0433\u043e&raquo; (\u043f\u0430\u0440. \u042f\u043d 1, 5).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0443 \u0433\u044d\u0442\u044b \u0441\u0432\u044f\u0442\u044b \u0434\u0437\u0435\u043d\u044c. \u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u0435\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e \u043d\u0435 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043d\u0456\u043a\u043e\u0433\u0430 \u0430\u0434 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u043d\u044f\u0445\u0430\u0439 \u0446\u044f\u0436\u0430\u0440 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e \u043d\u0435 \u0430\u0434\u0446\u044f\u0433\u0432\u0430\u0435 \u043d\u0456\u043a\u043e\u0433\u0430 \u0430\u0434 \u043f\u0443\u0431\u043b\u0456\u0447\u043d\u044b\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u045e. \u0423 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043d\u0430\u0432\u0430\u0442 \u0433\u0440\u044d\u0448\u043d\u0456\u043a \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u0442\u0440\u0430\u0447\u0432\u0430\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u0456 \u043d\u0430 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435. \u0411\u043e \u0451\u0441\u0446\u044c \u0434\u043e\u0431\u0440\u0430\u0435 \u043f\u0440\u0430\u0434\u0432\u0435\u0441\u0446\u0435: \u043a\u0430\u043b\u0456 \u0437\u043b\u043e\u0434\u0437\u0435\u0439 \u0443\u0434\u0430\u0441\u0442\u043e\u0456\u045e\u0441\u044f \u0440\u0430\u044e, \u0434\u044b\u043a \u0447\u0430\u043c\u0443 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u044f?<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 19 (18), 7\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u041f\u0430\u043d\u0430 \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u043e\u0440\u043a\u0456. <span style=\"color: #ff0000;\">*<\/span> \u042f\u0433\u043e \u043a\u0440\u0430\u0441\u0430 \u045e \u0430\u0431\u043b\u043e\u043a\u0430\u0445 \u043d\u0435\u0431\u0430, \u042f\u0433\u043e \u0456\u043c\u044f \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043d\u043e \u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0430\u0434\u043d\u044b\u043c \u043a\u0440\u0430\u0456 \u043d\u0435\u0431\u0430, \u0456 \u0431\u0435\u0433 \u044f\u0433\u043e\u043d\u044b \u0430\u0436 \u0434\u0430 \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u043a\u0440\u0430\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u0433\u043e \u043a\u0440\u0430\u0441\u0430 \u045e \u0430\u0431\u043b\u043e\u043a\u0430\u0445 \u043d\u0435\u0431\u0430, \u042f\u0433\u043e \u0456\u043c\u044f \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5052","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0437 \u041d\u0456\u0441\u044b, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 1 in Christi resurrectionem: PG 46, 603-606. 626-627)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u043d\u043e\u0432\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0441\u0442\u0430\u043b\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0436\u044b\u0446\u0446\u044f, \u0456 \u0441\u043a\u043e\u043d\u0447\u044b\u043b\u0430\u0441\u044f \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 \u0441\u043c\u0435\u0440\u0446\u0456. \u0417&rsquo;\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043d\u043e\u0432\u0430\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435, \u0456\u043d\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0456\u043d\u0448\u044b \u043b\u0430\u0434 \u0436\u044b\u0446\u0446\u044f, \u0437\u043c\u044f\u043d\u0456\u043b\u0430\u0441\u044f \u045e\u0441\u044f \u043d\u0430\u0448\u0430 \u043d\u0430\u0442\u0443\u0440\u0430. \u0428\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0430 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435? &laquo;\u042f\u043a\u043e\u0435 \u043d\u0435 \u0430\u0434 \u043a\u0440\u044b\u0432\u0456, \u043d\u0435 \u0430\u0434 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u0446\u0435\u043b\u0430, \u043d\u0435 \u0430\u0434 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u043c\u0443\u0436\u0430, \u0430\u043b\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f&raquo; (\u043f\u0430\u0440. \u042f\u043d 1, 13).<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u044b\u0442\u0430\u0435\u0446\u0435\u0441\u044f, \u044f\u043a \u0433\u044d\u0442\u0430 \u043c\u0430\u0433\u043b\u043e \u0430\u0434\u0431\u044b\u0446\u0446\u0430? \u041f\u0430\u0441\u043f\u0440\u0430\u0431\u0443\u044e \u043a\u043e\u0440\u0430\u0442\u043a\u0430 \u0440\u0430\u0441\u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c. \u0413\u044d\u0442\u044b \u043f\u043b\u043e\u0434 \u0437\u0430\u0447\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0441\u0432\u0435\u0442 \u043f\u0440\u0430\u0437 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0445\u0440\u043e\u0441\u0442\u0443, \u0433\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c, \u043a\u043e\u0440\u043c\u0456\u0446\u0446\u0430, \u044f\u043a \u0437 \u043c\u0430\u0442\u0447\u044b\u043d\u044b\u0445 \u0433\u0440\u0443\u0434\u0437\u0435\u0439, \u044f\u0433\u043e \u0432\u0443\u0447\u044d\u043d\u043d\u0435\u043c \u0456 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u0430\u043c\u0456 \u0456 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0445\u043b\u0435\u0431. \u041d\u0430\u0431\u044b\u0432\u0430\u0435 \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u044c \u043f\u0440\u0430\u0437 \u0440\u0430\u0437\u0432\u0430\u0436\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0456 \u0436\u044d\u043d\u0456\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0437\u043d\u043e\u0441\u0456\u043d\u044b \u0437 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e. \u042f\u0433\u043e \u0434\u0437\u0435\u0446\u0456 &ndash; \u0433\u044d\u0442\u0430 \u043d\u0430\u0434\u0437\u0435\u044f, \u044f\u0433\u043e \u0434\u043e\u043c &ndash; \u0433\u044d\u0442\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u044f\u0433\u043e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0431\u0430\u0433\u0430\u0446\u0446\u0435, \u044f\u0433\u043e \u0430\u0441\u0430\u043b\u043e\u0434\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0440\u0430\u0439, \u044f\u0433\u043e \u043a\u0430\u043d\u0435\u0446 &ndash; \u0433\u044d\u0442\u0430 \u043d\u0435 \u0441\u043c\u0435\u0440\u0446\u044c, \u0430\u043b\u0435 \u0436\u044b\u0446\u0446\u0451, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u0430\u0435 \u0434\u043b\u044f \u0433\u043e\u0434\u043d\u044b\u0445, \u0432\u0435\u0447\u043d\u0430\u0435 \u0456 \u043f\u043e\u045e\u043d\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0412\u043e\u0441\u044c \u0434\u0437\u0435\u043d\u044c, \u044f\u043a\u0456 \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e, \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u0456\u043c \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430&raquo; (\u041f\u0441 118 [117], 24). \u041d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0442\u044b\u0445 \u0434\u0437\u0451\u043d, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u043b\u0456 \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u0441\u0432\u0435\u0442\u0443 \u0456 \u044f\u043a\u0456\u044f \u0432\u044b\u043c\u044f\u0440\u0430\u044e\u0446\u0446\u0430 \u0447\u0430\u0441\u0430\u043c. \u0410\u043b\u0435 \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0430\u0447\u0430\u0442\u0430\u043a \u0456\u043d\u0448\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f. \u0411\u043e \u045e \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u041f\u0430\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u043e\u0432\u0430\u0435 \u043d\u0435\u0431\u0430 \u0456 \u043d\u043e\u0432\u0443\u044e \u0437\u044f\u043c\u043b\u044e, \u044f\u043a \u043a\u0430\u0436\u0430 \u043f\u0440\u0430\u0440\u043e\u043a. \u042f\u043a\u043e\u0435 \u043d\u0435\u0431\u0430? \u041d\u0435\u0431\u0430\u0441\u0445\u0456\u043b\u0430\u043c \u044f\u0433\u043e \u0451\u0441\u0446\u044c \u0432\u0435\u0440\u0430 \u045e \u0425\u0440\u044b\u0441\u0442\u0430. \u042f\u043a\u0443\u044e \u0437\u044f\u043c\u043b\u044e? \u0422\u0443\u044e, \u044f\u043a\u043e\u0439 \u0451\u0441\u0446\u044c \u0434\u043e\u0431\u0440\u0430\u0435 \u0441\u044d\u0440\u0446\u0430. \u0413\u044d\u0442\u0430\u044f \u0437\u044f\u043c\u043b\u044f, \u044f\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u0435 \u0434\u043e\u0436\u0434\u0436, \u0448\u0442\u043e \u043b\u044c\u0435\u0446\u0446\u0430 \u043d\u0430 \u044f\u0435, \u0456 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u0448\u0447\u043e\u0434\u0440\u044b \u043f\u043b\u0451\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043e\u043d\u0446\u0430 \u045e \u043d\u043e\u0432\u044b\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456 &ndash; \u0433\u044d\u0442\u0430 \u0447\u044b\u0441\u0442\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0437\u043e\u0440\u043a\u0456 &ndash; \u0433\u044d\u0442\u0430 \u0446\u043d\u043e\u0442\u044b, \u043f\u0430\u0432\u0435\u0442\u0440\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u044b, \u043c\u043e\u0440\u0430 &ndash; \u0433\u044d\u0442\u0430 &laquo;\u0433\u043b\u044b\u0431\u0456\u043d\u044f \u0431\u0430\u0433\u0430\u0446\u0446\u044f \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0456 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f&raquo; (\u0420\u044b\u043c 11, 33). \u0422\u0440\u0430\u0432\u044b \u0456 \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0456 &ndash; \u0433\u044d\u0442\u0430 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0435 \u0432\u0443\u0447\u044d\u043d\u043d\u0435 \u0456 \u0411\u043e\u0436\u0430\u0435 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u044f\u043a\u0456\u044f \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u043d\u0430 \u043f\u0430\u0448\u044b, \u0441\u0442\u0430\u0442\u0430\u043a \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443. \u0414\u0440\u044d\u0432\u044b, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u044c \u043f\u043b\u0451\u043d, &ndash; \u0433\u044d\u0442\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e \u0411\u043e\u0436\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043f\u0430-\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0433\u0430. \u0426\u0456 &laquo;\u0434\u0437\u0435\u043d\u044c, \u044f\u043a\u0456 \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e&raquo;, \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0441\u0442\u0430\u0446\u044c \u0434\u043b\u044f \u0446\u044f\u0431\u0435 \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u043d\u043e\u0432\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443? \u0406 \u0446\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d, \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0456\u043d\u0448\u044b\u0445 \u0434\u0437\u0451\u043d \u0456 \u043d\u0430\u0447\u044d\u0439?<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043a\u0430\u0436\u0430: &laquo;\u0423\u0437\u044b\u0445\u043e\u0434\u0436\u0443 \u0434\u0430 \u0410\u0439\u0446\u0430 \u041c\u0430\u0439\u0433\u043e \u0456 \u0410\u0439\u0446\u0430 \u0432\u0430\u0448\u0430\u0433\u0430, \u0434\u0430 \u0411\u043e\u0433\u0430 \u041c\u0430\u0439\u0433\u043e \u0456 \u0411\u043e\u0433\u0430 \u0432\u0430\u0448\u0430\u0433\u0430&raquo; (\u042f\u043d 20, 17). \u042f\u043a\u0430\u044f \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u0456 \u0434\u043e\u0431\u0440\u0430\u044f \u043d\u0430\u0432\u0456\u043d\u0430! \u0422\u043e\u0439, \u0445\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b\u043c, \u0441\u0442\u0430\u045e \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0456 \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0437&rsquo;\u044f\u0432\u0456\u045e\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0410\u0439\u0446\u043e\u043c, \u043a\u0430\u0431 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0430\u0441 \u0441\u0432\u0430\u0456\u043c\u0456 \u0431\u0440\u0430\u0442\u0430\u043c\u0456 \u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0441\u0430\u0431\u043e\u044e \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e, \u044f\u043a \u0401\u043d, \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 15, 21-22; 2 \u041f 3, 13\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u043f\u0440\u0430\u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u043f\u0440\u044b\u0439\u0448\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0442\u0430\u043a \u043f\u0440\u0430\u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 &ndash; \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e, \u044f\u043a \u0443 \u0410\u0434\u0430\u043c\u0435 \u045e\u0441\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0446\u044c, \u0442\u0430\u043a \u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u045e\u0441\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430, \u043c\u044b \u0447\u0430\u043a\u0430\u0435\u043c \u043d\u043e\u0432\u0430\u0433\u0430 \u043d\u0435\u0431\u0430 \u0456 \u043d\u043e\u0432\u0430\u0439 \u0437\u044f\u043c\u043b\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e, \u044f\u043a \u0443 \u0410\u0434\u0430\u043c\u0435 \u045e\u0441\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0446\u044c, \u0442\u0430\u043a \u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u045e\u0441\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5053","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430&raquo;\u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 10, 2: PG 74, 331-334)<\/span><br \/><span style=\"color: #ff0000;\">\u042f &ndash; \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u044f \u043b\u0430\u0437\u0430, \u0432\u044b &ndash; \u0433\u0430\u043b\u0456\u043d\u044b<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043d\u0430\u0437\u0432\u0430\u045e \u0441\u044f\u0431\u0435 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u0439 \u043b\u0430\u0437\u043e\u0439, \u043a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0442\u0440\u044b\u0432\u0430\u043d\u043d\u044f \u045e \u042f\u0433\u043e\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0456 \u043a\u0430\u0431 \u0432\u044b\u044f\u0432\u0456\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0430\u0434 \u043d\u0430\u0448\u0430\u0439 \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u0456 \u0437 \u0406\u043c. \u0417 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u044b\u043c\u0456 \u0433\u0430\u043b\u0456\u043d\u043a\u0430\u043c\u0456 \u041f\u0430\u043d \u043f\u0430\u0440\u0430\u045e\u043d\u043e\u045e\u0432\u0430\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b \u0437 \u0406\u043c, \u044f\u043a \u0431\u044b \u043f\u0440\u044b\u0448\u0447\u044d\u043f\u043b\u0435\u043d\u044b \u0456 \u043f\u0440\u044b\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b \u0434\u0430 \u042f\u0433\u043e, \u0431\u043e \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u042f\u0433\u043e\u043d\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u044f\u043a\u0456 \u0437\u043b\u0443\u0447\u0430\u0435 \u043d\u0430\u0441 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f, \u0445\u0442\u043e \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u0439 \u043b\u0430\u0437\u044b &ndash; \u0440\u043e\u0431\u044f\u0446\u044c \u0433\u044d\u0442\u0430 \u043c\u044d\u0442\u0430\u043d\u0430\u043a\u0456\u0440\u0430\u0432\u0430\u043d\u0430 \u0456 \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430, \u0430 \u042f\u0433\u043e \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u044c \u0437 \u043d\u0430\u043c\u0456 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u042f\u0433\u043e\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u043d\u0430\u0441. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0434\u043e\u0431\u0440\u044b\u043c \u043d\u0430\u043c\u0435\u0440\u0430\u043c \u043c\u044b \u043f\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u043c \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0456 \u0434\u0430\u043b\u0443\u0447\u0430\u0435\u043c\u0441\u044f \u0434\u0430 \u042f\u0433\u043e \u0440\u043e\u0434\u0443, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0443\u0441\u044b\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445. \u042f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b: &laquo;\u0425\u0442\u043e \u0437\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u0437 \u041f\u0430\u043d\u0430\u043c, \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0430\u0434\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c \u0437 \u0406\u043c&raquo; (1 \u041a\u0430\u0440 6, 17).<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u043f\u0440\u0430\u0440\u043e\u043a \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0430\u0439 \u0456 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0430\u043c, \u0431\u043e \u043d\u0430 \u0456\u043c \u043c\u044b \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u044b\u044f \u0456 \u043d\u0430\u0437\u0432\u0430\u043d\u044b\u044f \u0436\u044b\u0432\u044b\u043c\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c\u0456 \u043a\u0430\u043c\u044f\u043d\u044f\u043c\u0456, \u044f\u043a\u0456\u044f \u045e\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u0441\u0432\u044f\u0442\u043e\u0435 \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430, \u0456 \u0436\u044b\u043b\u043b\u0451\u043c \u0411\u043e\u0433\u0430 \u045e \u0414\u0443\u0445\u0443. \u041c\u044b \u043c\u043e\u0436\u0430\u043c \u0431\u044b\u0446\u044c \u0447\u0430\u0441\u0442\u043a\u0430\u043c\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u044b\u043b\u043b\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043d\u0430\u0448\u044b\u043c \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0430\u043c \u0431\u0443\u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0422\u043e\u0435 \u0436 \u043c\u0430\u0435 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043a\u0430\u043b\u0456 \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0441\u044f\u0431\u0435 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u0439 \u043b\u0430\u0437\u043e\u0439, \u044f\u043a\u0430\u044f \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u044f\u043a \u0431\u044b \u043c\u0430\u0446\u0456 \u0456 \u043a\u0430\u0440\u043c\u0456\u0446\u0435\u043b\u044c\u043a\u0430\u0439 \u0433\u0430\u043b\u0456\u043d\u0430\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u043c\u044b \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u044f \u0406\u043c \u0456 \u045e \u0406\u043c, \u0456 \u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u043b\u043e\u0434 \u0436\u044b\u0446\u0446\u044f, \u043d\u0435 \u0434\u0430\u045e\u043d\u044f\u0433\u0430 \u0456 \u0441\u0430\u0441\u0442\u0430\u0440\u044d\u043b\u0430\u0433\u0430, \u0430\u043b\u0435 \u043d\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u041f\u0430\u043d\u0430. \u0410 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435\u043c \u0436\u044b\u0446\u0446\u0451 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0442\u0440\u044b\u0432\u0430\u0435\u043c \u0443 \u0406\u043c \u044f\u043a \u0431\u044b \u043f\u0440\u044b\u0448\u0447\u044d\u043f\u043b\u0435\u043d\u044b\u044f, \u0456 \u0437 \u0443\u0441\u0456\u0445 \u0441\u0456\u043b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0435\u043c \u042f\u0433\u043e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456, \u0441\u0442\u0430\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0434\u0430\u0434\u0437\u0435\u043d\u0443\u044e \u043d\u0430\u043c \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c. \u0406\u043d\u0448\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u0440\u043e\u0431\u0456\u043c \u0443\u0441\u0451, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u0446\u044c \u0414\u0443\u0445\u0430, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430, \u044f\u043a \u0432\u044f\u0434\u043e\u043c\u0430, \u0436\u044b\u0432\u0435 \u045e \u043d\u0430\u0441 \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435, \u044f\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u043c\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c\u0441\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0430 \u0401\u043d \u0443 \u043d\u0430\u0441, \u043c\u0443\u0434\u0440\u0430 \u0456\u043b\u044e\u0441\u0442\u0440\u0443\u0435 \u0441\u0432. \u042f\u043d, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041f\u0430 \u0442\u044b\u043c \u043f\u0430\u0437\u043d\u0430\u0451\u043c, \u0448\u0442\u043e \u043c\u044b \u0436\u044b\u0432\u0451\u043c \u0443 \u0406\u043c, \u0430 \u0401\u043d \u0443 \u043d\u0430\u0441, \u0448\u0442\u043e \u0401\u043d \u0434\u0430\u045e \u043d\u0430\u043c \u0430\u0434 \u0414\u0443\u0445\u0430 \u0441\u0432\u0430\u0439\u0433\u043e&raquo; (1 \u042f\u043d 4, 13).<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043a\u043e\u0440\u0430\u043d\u044c \u043f\u0435\u0440\u0430\u0434\u0430\u0435 \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0430\u043c \u0441\u0432\u0430\u0435 \u043f\u0440\u044b\u0440\u043e\u0434\u043d\u044b\u044f \u044f\u043a\u0430\u0441\u0446\u0456, \u0442\u0430\u043a \u0456 \u0430\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0435 \u0421\u043b\u043e\u0432\u0430 \u0411\u043e\u0433\u0430 \u0456 \u0410\u0439\u0446\u0430 \u043f\u0440\u044b\u0448\u0447\u0430\u043f\u043b\u044f\u0435 \u043d\u0430\u0441 \u0441\u0432\u044f\u0442\u044b\u043c \u0441\u0432\u0430\u044f\u0446\u0442\u0432\u0430\u043c \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0443\u0434\u0437\u044f\u043b\u044f\u044e\u0447\u044b \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b \u0437 \u0406\u043c \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0443\u044e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c. \u0401\u043d \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u045e \u0456\u0445 \u043b\u044e\u0431\u043e\u045e \u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u0456\u043c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0443\u0441\u044f\u043a\u0443\u044e \u0446\u043d\u043e\u0442\u0443 \u0456 \u0434\u0430\u0431\u0440\u044b\u043d\u044e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 15, 4. 16b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u0430\u0441\u0442\u0430\u0432\u0430\u0439\u0446\u0435\u0441\u044f \u045e\u0432\u0430 \u041c\u043d\u0435, \u0430 \u042f \u045e \u0432\u0430\u0441. <span style=\"color: #ff0000;\">*<\/span> \u042f\u043a \u0433\u0430\u043b\u0456\u043d\u043a\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u043f\u043b\u043e\u0434\u0443 \u0441\u0430\u043c\u0430 \u0437 \u0441\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u0439 \u043b\u0430\u0437\u0435, \u0442\u0430\u043a \u0456 \u0432\u044b, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u045e\u0432\u0430 \u041c\u043d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u0432\u044b\u0431\u0440\u0430\u045e \u0432\u0430\u0441 \u0456 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e, \u043a\u0430\u0431 \u0432\u044b \u0456\u0448\u043b\u0456 \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0456 \u043f\u043b\u0451\u043d, \u0456 \u043a\u0430\u0431 \u043f\u043b\u0451\u043d \u0432\u0430\u0448 \u0442\u0440\u044b\u0432\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u0433\u0430\u043b\u0456\u043d\u043a\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u043f\u043b\u043e\u0434\u0443 \u0441\u0430\u043c\u0430 \u0437 \u0441\u044f\u0431\u0435, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u045e \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u0439 \u043b\u0430\u0437\u0435, \u0442\u0430\u043a \u0456 \u0432\u044b, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u045e\u0432\u0430 \u041c\u043d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5054","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0434\u0430 \u0414\u044b\u044f\u0433\u043d\u044d\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 5-6: Funk, 317-321)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u045e \u0441\u0432\u0435\u0446\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u043d\u0435 \u0430\u0434\u0440\u043e\u0437\u0456\u0432\u0430\u044e\u0446\u0446\u0430 \u0430\u0434 \u0456\u043d\u0448\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u043d\u0456 \u043c\u0435\u0441\u0446\u0430\u043c \u0436\u044b\u0445\u0430\u0440\u0441\u0442\u0432\u0430, \u043d\u0456 \u043c\u043e\u0432\u0430\u0439, \u043d\u0456 \u0436\u044b\u0446\u0446\u0451\u0432\u044b\u043c\u0456 \u0437\u0432\u044b\u0447\u0430\u044f\u043c\u0456. \u042f\u043d\u044b \u043d\u0435 \u043c\u0430\u044e\u0446\u044c \u0430\u0441\u043e\u0431\u043d\u044b\u0445 \u0433\u0430\u0440\u0430\u0434\u043e\u045e, \u043d\u0435 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u044f\u043a\u043e\u0439-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043d\u044f\u0437\u0432\u044b\u043a\u043b\u0430\u0439 \u0433\u0430\u0432\u043e\u0440\u043a\u0430\u0439 \u0456 \u043d\u0435 \u0432\u044f\u0434\u0443\u0446\u044c \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0406\u0445 \u0434\u044b\u0441\u0446\u044b\u043f\u043b\u0456\u043d\u0443 \u043d\u0435 \u0432\u044b\u043d\u0430\u0439\u0448\u043b\u0430 \u043d\u0435\u0447\u0430\u044f \u0437\u0430\u0434\u0443\u043c\u0430 \u0446\u0456 \u0440\u0443\u043f\u043d\u0430\u0441\u0446\u044c \u043a\u043b\u0430\u043f\u0430\u0442\u043b\u0456\u0432\u044b\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u044f\u043d\u044b \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u044e\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u044f \u043f\u043e\u0433\u043b\u044f\u0434\u044b, \u044f\u043a \u0433\u044d\u0442\u0430 \u0440\u043e\u0431\u044f\u0446\u044c \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u044b \u043d\u0430\u0441\u044f\u043b\u044f\u044e\u0446\u044c \u0456 \u0433\u0440\u044d\u0446\u043a\u0456\u044f, \u0456 \u0432\u0430\u0440\u0432\u0430\u0440\u0441\u043a\u0456\u044f \u0433\u0430\u0440\u0430\u0434\u044b, \u044f\u043a \u043a\u0430\u043c\u0443 \u0434\u0430\u045e \u043b\u0451\u0441. \u0423 \u0441\u0432\u0430\u0456\u043c \u0430\u0434\u0437\u0435\u043d\u043d\u0456, \u0435\u0436\u044b \u0456 \u0436\u044b\u0446\u0446\u0451\u0432\u044b\u043c \u043b\u0430\u0434\u0437\u0435 \u044f\u043d\u044b \u043f\u0440\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u0446\u0430 \u043c\u044f\u0441\u0446\u043e\u0432\u044b\u0445 \u0437\u0432\u044b\u0447\u0430\u044f\u045e, \u0430\u0434\u043d\u0430\u043a \u0437\u0430 \u0437\u0433\u043e\u0434\u0430\u0439 \u0443\u0441\u0456\u0445 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u044e\u0446\u044c \u0441\u0432\u0430\u044e \u0432\u0430\u0440\u0442\u0443\u044e \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u043d\u0435\u0432\u0435\u0440\u0430\u0433\u043e\u0434\u043d\u0443\u044e \u0436\u044b\u0446\u0446\u0451\u0432\u0443\u044e \u043f\u0430\u0437\u0456\u0446\u044b\u044e. \u042f\u043d\u044b \u0436\u044b\u0432\u0443\u0446\u044c \u043d\u0430 \u0441\u0432\u0430\u0451\u0439 \u0440\u0430\u0434\u0437\u0456\u043c\u0435, \u0430\u043b\u0435 \u044f\u043a \u043f\u0440\u044b\u0448\u043b\u044b\u044f \u0436\u044b\u0445\u0430\u0440\u044b; \u044f\u043d\u044b \u043c\u0430\u044e\u0446\u044c \u0443\u0441\u0451 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0435 \u0437 \u0456\u043d\u0448\u044b\u043c\u0456 \u044f\u043a \u0433\u0440\u0430\u043c\u0430\u0434\u0437\u044f\u043d\u0435, \u0430\u043b\u0435 \u0446\u0435\u0440\u043f\u044f\u0446\u044c \u0443\u0441\u0451, \u044f\u043a \u0456\u043d\u0448\u0430\u0437\u0435\u043c\u0446\u044b. \u041a\u043e\u0436\u043d\u044b \u0447\u0443\u0436\u044b \u043a\u0440\u0430\u0439 \u0434\u043b\u044f \u0456\u0445 &ndash; \u0440\u0430\u0434\u0437\u0456\u043c\u0430, \u0430 \u043a\u043e\u0436\u043d\u0430\u044f \u0440\u0430\u0434\u0437\u0456\u043c\u0430 \u0434\u043b\u044f \u0456\u0445 &ndash; \u0447\u0443\u0436\u044b\u043d\u0430. \u0416\u044d\u043d\u044f\u0446\u0446\u0430, \u044f\u043a \u0443\u0441\u0435, \u0456 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e\u0446\u044c \u0434\u0437\u044f\u0446\u0435\u0439, \u0430\u043b\u0435 \u043d\u0435 \u043a\u0456\u0434\u0430\u044e\u0446\u044c \u043d\u0435\u043c\u0430\u045e\u043b\u044f\u0442. \u0423\u0441\u0435 \u043f\u0430\u0434\u0437\u044f\u043b\u044f\u044e\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0441\u0442\u043e\u043b, \u0430\u043b\u0435 \u043d\u0435 \u0430\u0434\u043d\u043e \u043b\u043e\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u044b\u044f \u045e \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u043d\u0435 \u0436\u044b\u0432\u0443\u0446\u044c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430. \u0416\u044b\u0432\u0443\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0430\u043b\u0435 \u0456\u0445 \u0430\u0439\u0447\u044b\u043d\u0430 \u045e \u043d\u0435\u0431\u0435. \u041f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u045e\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u043c \u0437\u0430\u043a\u043e\u043d\u0430\u043c, \u0430\u043b\u0435 \u0441\u0432\u0430\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0437\u0430\u043a\u043e\u043d\u044b. \u041b\u044e\u0431\u044f\u0446\u044c \u0443\u0441\u0456\u0445, \u0430\u043b\u0435 \u045e\u0441\u0435 \u0456\u0445 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c. \u0406\u0445 \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c, \u0430\u043b\u0435 \u0430\u0441\u0443\u0434\u0436\u0430\u044e\u0446\u044c; \u0456\u0445 \u0430\u0434\u0434\u0430\u044e\u0446\u044c \u043d\u0430 \u0441\u043c\u0435\u0440\u0446\u044c, \u0430 \u044f\u043d\u044b \u0430\u0436\u044b\u0432\u0430\u044e\u0446\u044c. \u042f\u043d\u044b \u0436\u0430\u0431\u0440\u0430\u043a\u0456, \u0430\u043b\u0435 \u045e\u0437\u0431\u0430\u0433\u0430\u0447\u0430\u044e\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u0445; \u0456\u043c \u0448\u043c\u0430\u0442 \u0447\u0430\u0433\u043e \u043d\u0435\u0441\u0442\u0430\u0435, \u0430\u043b\u0435 \u045e\u0441\u044f\u0433\u043e \u044f\u043d\u044b \u043c\u0430\u044e\u0446\u044c \u0443\u0434\u043e\u0441\u0442\u0430\u043b\u044c. \u0406\u043c\u0456 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u044e\u0446\u044c, \u0430\u043b\u0435 \u044f\u043d\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0443 \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0435 \u0441\u043b\u0430\u0432\u0443. \u0406\u0445 \u0437\u043d\u0435\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u043f\u043b\u0451\u0442\u043a\u0430\u043c\u0456, \u0430\u043b\u0435 \u0433\u044d\u0442\u0430 \u0434\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0456\u0445 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456. \u0406\u0445 \u0433\u0430\u043d\u044f\u0446\u044c, \u0430 \u044f\u043d\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0446\u044c. \u0406\u043c\u0456 \u0433\u0440\u044d\u0431\u0443\u044e\u0446\u044c, \u0430 \u044f\u043d\u044b \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u044e\u0446\u044c \u043f\u0430\u0448\u0430\u043d\u0443. \u042f\u043d\u044b \u0440\u043e\u0431\u044f\u0446\u044c \u0434\u0430\u0431\u0440\u043e, \u0430 \u0456\u0445 \u043a\u0430\u0440\u0430\u044e\u0446\u044c \u044f\u043a \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445. \u041a\u0430\u043b\u0456 \u043a\u0430\u0440\u0430\u044e\u0446\u044c, \u044f\u043d\u044b \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0456\u0445 \u0430\u0436\u044b\u045e\u043b\u044f\u044e\u0446\u044c. \u042e\u0434\u044d\u0456 \u0432\u0430\u044e\u044e\u0446\u044c \u0437 \u0456\u043c\u0456 \u044f\u043a \u0437 \u0447\u0443\u0436\u044b\u043d\u0446\u0430\u043c\u0456, \u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u044e\u0446\u044c \u0456\u0445. \u0410\u043b\u0435 \u0456\u0445 \u043d\u0435\u043d\u0430\u0432\u0456\u0441\u043d\u0456\u043a\u0456 \u043d\u0435 \u043c\u043e\u0433\u0443\u0446\u044c \u043d\u0430\u0437\u0432\u0430\u0446\u044c \u043f\u0440\u044b\u0447\u044b\u043d\u0443 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0441\u0446\u0435\u0439 \u043a\u0430\u0436\u0443\u0447\u044b, \u0447\u044b\u043c \u0451\u0441\u0446\u044c \u0434\u0443\u0448\u0430 \u045e \u0446\u0435\u043b\u0435, \u0442\u044b\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u045e \u0441\u0432\u0435\u0446\u0435. \u0414\u0443\u0448\u0430 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u0430\u044f \u043f\u0430 \u045e\u0441\u0456\u0445 \u0447\u0430\u0441\u0442\u043a\u0430\u0445 \u0446\u0435\u043b\u0430, \u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 &ndash; \u043f\u0430 \u045e\u0441\u0456\u0445 \u0437\u0435\u043c\u043b\u044f\u0445. \u0425\u043e\u0446\u044c \u0434\u0443\u0448\u0430 \u0436\u044b\u0432\u0435 \u045e \u0446\u0435\u043b\u0435, \u044f\u043d\u0430 \u043d\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0446\u0435\u043b\u0430. \u0422\u0430\u043a \u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u0436\u044b\u0432\u0443\u0446\u044c \u0443 \u0441\u0432\u0435\u0446\u0435, \u0430\u043b\u0435 \u043d\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u044c \u0430\u0434 \u0441\u0432\u0435\u0442\u0443. \u041d\u044f\u0431\u0430\u0447\u043d\u0430\u044f \u0434\u0443\u0448\u0430 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u0430 \u045e \u0431\u0430\u0447\u043d\u044b\u043c \u0446\u0435\u043b\u0435. \u0422\u0430\u043a \u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u0431\u0430\u0447\u043d\u044b\u044f \u045e \u0441\u0432\u0435\u0446\u0435, \u0430\u043b\u0435 \u0456\u0445 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u0435 \u0411\u043e\u0433\u0443 \u043d\u044f\u0431\u0430\u0447\u043d\u0430\u0435. \u0425\u043e\u0446\u044c \u0434\u0443\u0448\u0430 \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u043b\u0430 \u0446\u0435\u043b\u0443 \u043d\u0456\u044f\u043a\u0430\u0439 \u043a\u0440\u044b\u045e\u0434\u044b, \u044f\u043d\u043e \u0437 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044e \u0437\u043c\u0430\u0433\u0430\u0435\u0446\u0446\u0430 \u0437 \u0451\u0439, \u0431\u043e \u0434\u0443\u0448\u0430 \u043f\u0435\u0440\u0430\u0448\u043a\u0430\u0434\u0436\u0430\u0435 \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043d\u0430\u0442\u0430\u043b\u044f\u0446\u0446\u0430. \u0422\u0430\u043a \u0456 \u0441\u0432\u0435\u0442 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e, \u044f\u043a\u0456\u044f \u043d\u0456\u0447\u044b\u043c \u043d\u0435 \u043d\u0430\u0448\u043a\u043e\u0434\u0437\u0456\u043b\u0456, \u0431\u043e \u044f\u043d\u044b \u0430\u0434\u043a\u0456\u0434\u0430\u044e\u0446\u044c \u043f\u0430\u0436\u0430\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u0448\u0430 \u043b\u044e\u0431\u0456\u0446\u044c \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u044f\u0435 \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0446\u044c, \u0456 \u044f\u0433\u043e\u043d\u044b\u044f \u0447\u0430\u0441\u0442\u043a\u0456. \u0410 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u043b\u044e\u0431\u044f\u0446\u044c \u043d\u0435\u043d\u0430\u0432\u0456\u0441\u043d\u0456\u043a\u0430\u045e. \u0414\u0443\u0448\u0430 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043d\u0430 \u045e \u0446\u0435\u043b\u0435, \u0430\u043b\u0435 \u0441\u0430\u043c\u0430 \u0437\u043c\u044f\u0448\u0447\u0430\u0435 \u0446\u0435\u043b\u0430. \u0422\u0430\u043a \u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u0437\u0430\u043c\u043a\u043d\u0451\u043d\u044b\u044f \u045e \u0441\u0432\u0435\u0446\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u0430\u0434 \u0432\u0430\u0440\u0442\u0430\u0439, \u0430\u043b\u0435 \u0441\u0430\u043c\u0456 \u0437\u043c\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u0441\u0432\u0435\u0442. \u041d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u044f \u0434\u0443\u0448\u0430 \u0436\u044b\u0432\u0435 \u045e \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u043c \u0446\u0435\u043b\u0435, \u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435 \u0432\u0430\u043d\u0434\u0440\u0443\u044e\u0446\u044c \u0443 \u0442\u043b\u0435\u043d\u043d\u044b\u0445 \u0446\u0435\u043b\u0430\u0445, \u0447\u0430\u043a\u0430\u044e\u0447\u044b \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456. \u0414\u0443\u0448\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043b\u0435\u043f\u0448\u0430\u0439, \u043a\u0430\u043b\u0456 \u0437\u0430\u0433\u0430\u0440\u0442\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0434\u0430\u043c \u0456 \u0441\u043c\u0430\u0433\u0430\u0439, \u0430 \u043b\u0456\u0447\u0431\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0435 \u043f\u0440\u0430\u0437 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u044b \u043f\u0440\u044b\u0433\u043d\u0451\u0442. \u0411\u043e\u0433 \u0434\u0430\u045e \u0456\u043c \u0442\u0430\u043a\u0443\u044e \u043f\u0430\u0437\u0456\u0446\u044b\u044e, \u0437 \u044f\u043a\u043e\u0439 \u043d\u044f\u0433\u043e\u0436\u0430 \u045e\u0446\u044f\u043a\u0430\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 8, 12b; \u0421\u0456\u0440 24, 25<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f &ndash; \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0442\u0443. <span style=\"color: #ff0000;\">*<\/span> \u0425\u0442\u043e \u0456\u0434\u0437\u0435 \u0437\u0430 \u041c\u043d\u043e\u044e, \u0442\u043e\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0446\u0435\u043c\u0440\u044b, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u0436\u044b\u0446\u0446\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0432\u0430 \u043c\u043d\u0435 \u043b\u0430\u0441\u043a\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u0434\u0430\u0440\u043e\u0433\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u044b, \u0443\u0432\u0430 \u041c\u043d\u0435 \u045e\u0441\u044f \u043d\u0430\u0434\u0437\u0435\u044f \u0436\u044b\u0446\u0446\u044f \u0456 \u0446\u043d\u043e\u0442\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u0456\u0434\u0437\u0435 \u0437\u0430 \u041c\u043d\u043e\u044e, \u0442\u043e\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u0443 \u0446\u0435\u043c\u0440\u044b, \u0430\u043b\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u0436\u044b\u0446\u0446\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5055","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 \u0441\u0432. \u0413\u0430\u045e\u0434\u044d\u043d\u0446\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0411\u0440\u044d\u0448\u044b\u0456<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 2: CSEL 68, 26. 29-30)<\/span><br \/><span style=\"color: #ff0000;\">\u042d\u045e\u0445\u0430\u0440\u044b\u0441\u0442\u044b\u044f &ndash; \u041f\u0430\u0441\u0445\u0430 \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u0437\u0456\u043d \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0456\u0445. \u0401\u043d \u0430\u0434\u0437\u0456\u043d \u0456 \u0442\u043e\u0439 \u0436\u0430 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0445 \u0443\u0441\u0456\u0445 \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u045e, \u0443 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0445\u043b\u0435\u0431\u0430 \u0456 \u0432\u0456\u043d\u0430. \u0401\u043d \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0456 \u0430\u0436\u044b\u045e\u043b\u044f\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u045e \u042f\u0433\u043e \u0432\u0435\u0440\u044b\u0446\u044c, \u0456 \u0441\u0432\u0430\u0451\u044e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044e \u0430\u0441\u0432\u044f\u0447\u0430\u0435 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u0430\u0445\u0432\u044f\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0426\u0435\u043b\u0430 \u0411\u0430\u0440\u0430\u043d\u043a\u0430, \u0430 \u0432\u043e\u0441\u044c \u042f\u0433\u043e \u041a\u0440\u043e\u045e. \u0425\u043b\u0435\u0431, \u044f\u043a\u0456 \u0441\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043d\u0435\u0431\u0430, \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0425\u043b\u0435\u0431, \u044f\u043a\u0456 \u042f \u0434\u0430\u044e, &ndash; \u0433\u044d\u0442\u0430 \u0426\u0435\u043b\u0430 \u041c\u0430\u0451 \u0434\u0437\u0435\u043b\u044f \u0436\u044b\u0446\u0446\u044f \u0441\u0432\u0435\u0442\u0443&raquo; (\u043f\u0430\u0440. \u042f\u043d 6, 51). \u0421\u043b\u0443\u0448\u043d\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u042f\u0433\u043e\u043d\u0430\u044f \u041a\u0440\u043e\u045e \u0432\u044b\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0432\u0456\u043d\u0430, \u0431\u043e \u0441\u0430\u043c \u041f\u0430\u043d \u043a\u0430\u0436\u0430 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456: &laquo;\u042f &ndash; \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u044f \u043b\u0430\u0437\u0430&raquo; (\u042f\u043d 15, 1). \u0413\u044d\u0442\u0430\u0433\u0430 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0430, \u043a\u0430\u0431 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u041a\u0440\u044b\u0432\u0451\u044e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e\u0441\u044f\u043a\u0430\u0435 \u0432\u0456\u043d\u043e, \u044f\u043a\u043e\u0435 \u0430\u0445\u0432\u044f\u0440\u0443\u0435\u0446\u0446\u0430 \u045e \u0437\u043d\u0430\u043a \u042f\u0433\u043e \u043c\u0443\u043a\u0456. \u0422\u0430\u043c\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043f\u0430\u0442\u0440\u044b\u044f\u0440\u0445 \u042f\u043a\u0443\u0431 \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u045e \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0401\u043d \u0430\u0431\u043c\u044b\u045e \u0443 \u0432\u0456\u043d\u0435 \u0441\u0432\u0430\u0451 \u0430\u0434\u0437\u0435\u043d\u043d\u0435, \u0430 \u045e \u043a\u0440\u044b\u0432\u0456 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0443 &ndash; \u0441\u0432\u043e\u0439 \u043f\u043b\u0430\u0448\u0447&raquo; (\u0411\u044b\u0446 49, 11). \u0410\u043f\u0440\u0430\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u045e \u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u0415\u0437\u0443\u0441 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0430\u0431\u043c\u044b\u0446\u044c \u044f\u0433\u043e \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0451\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0443\u0441\u044f\u0433\u043e, \u044f\u043a\u0456 \u0432\u044b\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0437\u044f\u043c\u043b\u0456 \u0445\u043b\u0435\u0431, \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0430\u0435 \u0445\u043b\u0435\u0431 \u0432\u0430 \u045e\u043b\u0430\u0441\u043d\u0430\u0435 \u0426\u0435\u043b\u0430 (\u0431\u043e \u0401\u043d \u043c\u043e\u0436\u0430 \u0433\u044d\u0442\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0456 \u0430\u0431\u044f\u0446\u0430\u045e \u0433\u044d\u0442\u0430). \u0422\u043e\u0439, \u0445\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e \u0437 \u0432\u0430\u0434\u044b \u0432\u0456\u043d\u043e, \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0430\u0435 \u045e \u0432\u0456\u043d\u043e \u0456 \u045e\u043b\u0430\u0441\u043d\u0443\u044e \u041a\u0440\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0413\u044d\u0442\u0430 \u041f\u0430\u0441\u0445\u0430 \u041f\u0430\u043d\u0430&raquo; (\u0417\u044b\u0445 12, 11), \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u042f\u0433\u043e \u043f\u0440\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435. \u0422\u0430\u043c\u0443 \u043d\u0435 \u043b\u0456\u0447\u044b \u0437\u044f\u043c\u043d\u044b\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u0442\u0430\u043b\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u0439\u0448\u043e\u045e \u0443 \u0445\u043b\u0435\u0431 \u0456 \u0432\u0456\u043d\u043e \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0456\u0445 \u0441\u0432\u0430\u0456\u043c\u0456 \u0426\u0435\u043b\u0430\u043c \u0456 \u041a\u0440\u044b\u0432\u0451\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435, \u0448\u0442\u043e \u043c\u044b \u043f\u0440\u044b\u043c\u0430\u0435\u043c, &ndash; \u0433\u044d\u0442\u0430 \u0426\u0435\u043b\u0430 \u0442\u0430\u0433\u043e \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0445\u043b\u0435\u0431\u0430 \u0456 \u041a\u0440\u043e\u045e \u0442\u043e\u0439 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u043d\u0430\u0439 \u043b\u0430\u0437\u044b. \u041f\u0435\u0440\u0430\u0434\u0430\u044e\u0447\u044b \u0432\u0443\u0447\u043d\u044f\u043c \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b \u0445\u043b\u0435\u0431 \u0456 \u0432\u0456\u043d\u043e, \u0401\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0442\u0430\u043a: &laquo;\u0413\u044d\u0442\u0430 \u0426\u0435\u043b\u0430 \u041c\u0430\u0451; \u0433\u044d\u0442\u0430 \u041a\u0440\u043e\u045e \u041c\u0430\u044f&raquo; (\u041c\u0446 26, 26-27). \u041f\u0440\u0430\u0448\u0443 \u0432\u0430\u0441, \u0434\u0430\u0432\u0435\u0440\u044b\u043c\u0441\u044f \u0442\u0430\u043c\u0443, \u043a\u0430\u043c\u0443 \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456. \u041f\u0440\u0430\u045e\u0434\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043a\u0430\u0437\u0430\u045e \u043d\u0430\u0442\u043e\u045e\u043f\u0430\u043c \u043f\u0440\u0430 \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u043d\u043d\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0426\u0435\u043b\u0430 \u0456 \u043f\u0456\u0446\u0446\u0451 \u042f\u0433\u043e \u041a\u0440\u044b\u0432\u0456. \u042f\u043d\u044b \u0437\u0434\u0437\u0456\u045e\u043b\u044f\u043b\u0456\u0441\u044f \u0456 \u043d\u0430\u0440\u0430\u043a\u0430\u043b\u0456: &laquo;\u0426\u044f\u0436\u043a\u0430\u044f \u0433\u044d\u0442\u0430\u044f \u043c\u043e\u0432\u0430! \u0425\u0442\u043e \u043c\u043e\u0436\u0430 \u044f\u0435 \u0441\u043b\u0443\u0445\u0430\u0446\u044c?&raquo; (\u042f\u043d 6, 60). \u0410 \u043f\u043e\u0442\u044b\u043c, \u043a\u0430\u0431 \u0432\u044b\u043f\u0430\u043b\u0456\u0446\u044c \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0430\u0433\u043d\u0451\u043c \u0442\u0430\u043a\u0456\u044f \u0456\u0445 \u0434\u0443\u043c\u043a\u0456, \u044f\u043a\u0456\u0445 (\u044f\u043a \u044f \u0440\u0430\u043d\u0435\u0439 \u0441\u043a\u0430\u0437\u0430\u045e) \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0437\u0431\u044f\u0433\u0430\u0446\u044c, \u041f\u0430\u043d \u0434\u0430\u0434\u0430\u0435: &laquo;\u0414\u0443\u0445 \u0430\u0436\u044b\u045e\u043b\u044f\u0435, \u0446\u0435\u043b\u0430 \u0436 \u043d\u0456 \u043d\u0430 \u0448\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u0434\u0430\u0442\u043d\u0430\u0435. \u0421\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u044f \u042f \u043a\u0430\u0436\u0443 \u0432\u0430\u043c, \u0451\u0441\u0446\u044c \u0414\u0443\u0445\u0430\u043c \u0456 \u0436\u044b\u0446\u0446\u0451\u043c&raquo; (\u042f\u043d 6, 63).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 6, 57; \u041b\u043a 22, 19b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435 \u0436\u044b\u0432\u044b \u0410\u0439\u0446\u0435\u0446, \u0456 \u042f \u0436\u044b\u0432\u0443 \u0410\u0439\u0446\u043e\u043c, <span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u043a \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0435\u0441\u0446\u044c \u041c\u044f\u043d\u0435, \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u041c\u043d\u043e\u044e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u0426\u0435\u043b\u0430 \u041c\u0430\u0451, \u044f\u043a\u043e\u0435 \u0437\u0430 \u0432\u0430\u0441 \u0431\u0443\u0434\u0437\u0435 \u0432\u044b\u0434\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043a \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0435\u0441\u0446\u044c \u041c\u044f\u043d\u0435, \u0431\u0443\u0434\u0437\u0435 \u0436\u044b\u0446\u044c \u041c\u043d\u043e\u044e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5056","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0431\u043b. \u0406\u0441\u0430\u0430\u043a\u0430, \u0430\u0431\u0430\u0442\u0430 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u0430 \u0421\u0442\u044d\u043b\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 42: PL 194, 1831-1832)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u0441\u044f\u0440\u043e\u0434 \u043c\u043d\u043e\u0433\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0433\u0430\u043b\u0430\u0432\u0430 \u0456 \u0446\u0435\u043b\u0430 \u045e\u0442\u0432\u0430\u0440\u0430\u044e\u0446\u044c \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0442\u0430\u043a \u0456 \u0421\u044b\u043d \u0414\u0437\u0435\u0432\u044b \u045e\u0442\u0432\u0430\u0440\u0430\u0435 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c\u0456 \u0447\u043b\u0435\u043d\u0430\u043c\u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u0434\u043d\u0430\u0433\u043e \u0421\u044b\u043d\u0430 \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430. \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0443\u0432\u0435\u0441\u044c \u0456 \u0446\u044d\u043b\u044b, \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0433\u0430\u043b\u0430\u0432\u043e\u0439 \u0456 \u0446\u0435\u043b\u0430\u043c. \u0423\u0441\u0435 \u0447\u0430\u0441\u0442\u043a\u0456 \u0440\u0430\u0437\u0430\u043c &ndash; \u0433\u044d\u0442\u0430 \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430, \u044f\u043a\u043e\u0435 \u0441\u0430 \u0441\u0432\u0430\u0451\u0439 \u0413\u0430\u043b\u0430\u0432\u043e\u0439 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u0434\u043d\u044b\u043c \u0421\u044b\u043d\u0430\u043c \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c. \u0401\u043d \u0441\u043a\u043b\u0430\u0434\u0430\u0435 \u0430\u0434\u043d\u043e \u0437 \u0421\u044b\u043d\u0430\u043c \u0411\u043e\u0436\u044b\u043c, \u044f\u043a\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0411\u043e\u0433\u0430\u043c \u0451\u0441\u0446\u044c \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0411\u043e\u0433\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0446\u044d\u043b\u0430\u0435 \u0446\u0435\u043b\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0433\u0430\u043b\u0430\u0432\u043e\u0439 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0421\u044b\u043d\u0430\u043c \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c, \u0421\u044b\u043d\u0430\u043c \u0411\u043e\u0436\u044b\u043c \u0456 \u0411\u043e\u0433\u0430\u043c. \u0422\u0430\u043c\u0443 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0456 \u043a\u0430\u0436\u0430: &laquo;\u041e\u0439\u0447\u0430, \u044f\u043a \u042f \u0456 \u0422\u044b \u0430\u0434\u043d\u043e, \u0442\u0430\u043a \u043d\u044f\u0445\u0430\u0439 \u0456 \u044f\u043d\u044b \u0431\u0443\u0434\u0443\u0446\u044c \u0430\u0434\u043d\u043e \u0440\u0430\u0437\u0430\u043c \u0437 \u041d\u0430\u043c\u0456&raquo; (\u043f\u0430\u0440. \u042f\u043d 17, 21).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u0430\u045e\u043d\u044b\u0445 \u0441\u043b\u043e\u045e \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f, \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u043d\u0456 \u0446\u0435\u043b\u0430 \u0431\u0435\u0437 \u0433\u0430\u043b\u0430\u0432\u044b, \u043d\u0456 \u0433\u0430\u043b\u0430\u0432\u044b \u0431\u0435\u0437 \u0446\u0435\u043b\u0430, \u043d\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0435\u0437 \u0411\u043e\u0433\u0430 \u0433\u0430\u043b\u0430\u0432\u044b \u0456 \u0446\u0435\u043b\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0446\u044d\u043b\u0430\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<br \/>\u0423\u0441\u0451 \u0437 \u0411\u043e\u0433\u0430\u043c \u0451\u0441\u0446\u044c \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0411\u043e\u0433\u0430\u043c: \u0421\u044b\u043d \u0411\u043e\u0436\u044b \u0437 \u0411\u043e\u0433\u0430\u043c &ndash; \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c, \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0437 \u0406\u043c &ndash; \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u0430\u0441\u043e\u0431\u0443, \u042f\u0433\u043e \u0446\u0435\u043b\u0430 \u0437 \u0406\u043c &ndash; \u043f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0432\u0435\u0440\u043d\u0430 \u0456 \u0440\u0430\u0437\u0443\u043c\u043d\u0430 \u0447\u043b\u0435\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u044f \u043c\u043e\u0433\u0443\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u043d\u0430\u0437\u044b\u0432\u0430\u0446\u0446\u0430 \u0442\u044b\u043c, \u0447\u044b\u043c \u0401\u043d \u0441\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0411\u043e\u0436\u044b\u043c \u0421\u044b\u043d\u0430\u043c \u0456 \u0411\u043e\u0433\u0430\u043c. \u0410\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0406\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043d\u0430\u0442\u0443\u0440\u044b, \u0430 \u0447\u0430\u0441\u0442\u043a\u0456 \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 &ndash; \u043f\u0440\u0430\u0437 \u0443\u0434\u0437\u0435\u043b. \u0401\u043d &ndash; \u0411\u043e\u0436\u044b \u0421\u044b\u043d \u0430\u0434 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f, \u044f\u0433\u043e\u043d\u044b\u044f \u0447\u043b\u0435\u043d\u044b &ndash; \u043f\u0440\u0430\u0437 \u0443\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u044f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0412\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0414\u0443\u0445\u0430 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0443 \u044f\u043a\u0456\u043c \u043c\u044b \u043a\u043b\u0456\u0447\u0430\u043c: \u0410\u0431\u0431\u0430, \u041e\u0439\u0447\u0430&raquo; (\u0420\u044b\u043c 8, 15).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430\u0433\u0430 \u0414\u0443\u0445\u0430 \u0411\u043e\u0433 &laquo;\u0434\u0430\u045e \u0456\u043c \u0443\u043b\u0430\u0434\u0443 \u0441\u0442\u0430\u0446\u044c \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456&raquo; (\u043f\u0430\u0440. \u042f\u043d 1, 12), \u043a\u0430\u0431 &laquo;\u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u0441\u044f\u0440\u043e\u0434 \u043c\u043d\u043e\u0433\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e&raquo; \u043d\u0430\u0432\u0443\u0447\u044b\u045e \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u043f\u0430\u0430\u0441\u043e\u0431\u043a\u0443 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c: &laquo;\u041e\u0439\u0447\u0430 \u043d\u0430\u0448, \u043a\u0430\u0442\u043e\u0440\u044b \u0451\u0441\u0446\u044c \u0443 \u043d\u0435\u0431\u0435&raquo;. \u0410 \u043f\u0430\u0437\u043d\u0435\u0439: &laquo;\u0423\u0437\u044b\u0445\u043e\u0434\u0436\u0443 \u0434\u0430 \u0410\u0439\u0446\u0430 \u041c\u0430\u0439\u0433\u043e \u0456 \u0410\u0439\u0446\u0430 \u0432\u0430\u0448\u0430\u0433\u0430&raquo; (\u042f\u043d 20, 17).<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b, \u043d\u0430\u0448\u0430 \u0413\u0430\u043b\u0430\u0432\u0430, \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u0414\u0437\u0435\u0432\u044b \u0430\u0434 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u0417 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0433\u044d\u0442\u0430\u0433\u0430 \u0436 \u0414\u0443\u0445\u0430 \u043c\u044b \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u0435\u043c\u0441\u044f \u045e \u043a\u0443\u043f\u0435\u043b\u0456 \u0445\u0440\u043e\u0441\u0442\u0443 \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u0411\u043e\u0433\u0430 \u0456 \u042f\u0433\u043e\u043d\u0430\u0435 \u0446\u0435\u043b\u0430. \u042f\u043a \u0401\u043d \u0431\u0435\u0437 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u0443, \u0442\u0430\u043a \u0456 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u043c \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u0433\u0440\u0430\u0445\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u043d\u0451\u0441 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u045e\u0441\u0435 \u0433\u0440\u0430\u0445\u0456 \u0446\u044d\u043b\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u0442\u0430\u043a \u0401\u043d \u0434\u0430\u045e \u0443\u0441\u044f\u043c\u0443 \u041c\u0456\u0441\u0442\u044b\u0447\u043d\u0430\u043c\u0443 \u0446\u0435\u043b\u0443 \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u0435 \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f. \u042f\u043a \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430: &laquo;\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u043e\u043c\u0443 \u041f\u0430\u043d \u043d\u0435 \u043f\u0430\u043b\u0456\u0447\u044b\u045e \u0432\u0456\u043d\u044b&raquo; (\u041f\u0441 32 [31], 2). \u0413\u044d\u0442\u044b\u043c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u0451\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u0456\u0432\u044b \u0441\u0430\u043c \u043f\u0430 \u0441\u0430\u0431\u0435. \u0401\u043d \u0430\u0434\u0437\u0456\u043d \u0417\u0431\u0430\u045e\u0446\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b. \u0423 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435 \u0401\u043d \u043f\u0430\u043d\u0451\u0441 \u043d\u0430 \u043a\u0440\u044b\u0436 \u0433\u0440\u0430\u0445\u0456, \u0430\u0434 \u044f\u043a\u0456\u0445 \u0430\u0431\u043c\u044b\u045e \u0441\u0432\u0430\u0451 \u041c\u0456\u0441\u0442\u044b\u0447\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u045e \u0432\u0430\u0434\u0437\u0435 \u0445\u0440\u043e\u0441\u0442\u0443. \u0401\u043d \u0437\u0431\u0430\u045e\u043b\u044f\u0435 \u043f\u0440\u0430\u0437 \u0434\u0440\u044d\u0432\u0430 \u0456 \u0432\u0430\u0434\u0443, \u044f\u043a \u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0411\u043e\u0436\u044b \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0433\u0440\u0430\u0445\u0456 \u0441\u0432\u0435\u0442\u0443, \u044f\u043a\u0456\u044f \u045e\u0437\u044f\u045e \u043d\u0430 \u0441\u044f\u0431\u0435. \u0401\u043d \u0441\u0432\u044f\u0442\u0430\u0440 \u0456 \u0430\u0445\u0432\u044f\u0440\u0430. \u0401\u043d \u0411\u043e\u0433, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u0451\u0441 \u0441\u044f\u0431\u0435 \u045e \u0430\u0445\u0432\u044f\u0440\u0443 \u0441\u0430\u043c\u043e\u043c\u0443 \u0441\u0430\u0431\u0435 \u0456 \u043f\u0440\u0430\u0437 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u045e \u0441\u044f\u0431\u0435 \u0437 \u0441\u0430\u0431\u043e\u0439, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 12, 5; \u041a\u043b\u0441 2, 9-10\u0430; 1, 18<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b, \u043c\u043d\u043e\u0433\u0456\u044f, \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u043c \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0430 \u043f\u0430\u0430\u0441\u043e\u0431\u043a\u0443 \u0430\u0434\u0437\u0456\u043d \u0434\u043b\u044f \u0430\u0434\u043d\u0430\u0433\u043e &ndash; \u0447\u0430\u0441\u0442\u043a\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0423\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u0430 \u0436\u044b\u0432\u0435 \u045e \u0406\u043c, \u0456 \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043f\u0430\u045e\u043d\u0430\u0442\u0443 \u045e \u0406\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0401\u043d &ndash; \u0413\u0430\u043b\u0430\u0432\u0430 \u0446\u0435\u043b\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0401\u043d &ndash; \u043f\u0430\u0447\u0430\u0442\u0430\u043a, \u043f\u0435\u0440\u0448\u0430\u0440\u043e\u0434\u043d\u044b \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u043a\u0430\u0431 \u0401\u043d \u0432\u0430 \u045e\u0441\u0456\u043c \u043c\u0435\u045e \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u0430 \u0436\u044b\u0432\u0435 \u045e \u0406\u043c, \u0456 \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043f\u0430\u045e\u043d\u0430\u0442\u0443 \u045e \u0406\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5057","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u043f\u0441\u0430\u043b\u044c\u043c\u0430\u045e&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Ps 148, 1-2: CCL 40, 2165-2166)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u0441\u0445\u0430\u043b\u044c\u043d\u0430\u0435 &laquo;\u0410\u043b\u043b\u0435\u043b\u044e\u044f&raquo;<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u0435 \u043d\u0430\u0434 \u043d\u0430\u0448\u044b\u043c \u043b\u044e\u0434\u0441\u043a\u0456\u043c \u0436\u044b\u0446\u0446\u0451\u043c \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0445\u0432\u0430\u043b\u0435 \u0411\u043e\u0436\u0430\u0439, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0432\u0435\u0447\u043d\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0431\u0443\u0434\u0437\u0435 \u0445\u0432\u0430\u043b\u043e\u0439 \u0411\u043e\u0436\u0430\u0439. \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0437\u0434\u0430\u0442\u043d\u044b\u043c \u0434\u0430 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0435\u0446\u0446\u0430 \u0434\u0430 \u044f\u0433\u043e \u0446\u044f\u043f\u0435\u0440. \u0422\u0430\u043c\u0443 \u0446\u044f\u043f\u0435\u0440 \u043c\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 \u0456 \u043f\u0440\u043e\u0441\u0456\u043c \u042f\u0433\u043e. \u0425\u0432\u0430\u043b\u0443 \u043c\u044b \u045e\u0437\u043d\u043e\u0441\u0456\u043c \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 &ndash; \u0437 \u0443\u0437\u0434\u044b\u0445\u0430\u043d\u043d\u044f\u043c\u0456. \u041d\u0430\u043c \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u043d\u0430 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043c\u044b \u044f\u0448\u0447\u044d \u043d\u0435 \u043c\u0430\u0435\u043c; \u0430\u043b\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e, \u0442\u0430\u043c\u0443 \u043c\u044b \u0440\u0430\u0434\u0443\u0435\u043c\u0441\u044f \u045e \u043d\u0430\u0434\u0437\u0435\u0456. \u0422\u0430\u043a, \u043c\u044b \u045e\u0437\u0434\u044b\u0445\u0430\u0435\u043c \u0430\u0434 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u045e \u043d\u0430\u0441 \u044f\u0448\u0447\u044d \u043d\u044f\u043c\u0430. \u0406 \u0433\u044d\u0442\u0430 \u0434\u043e\u0431\u0440\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 &ndash; \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0447\u0430\u043a\u0430\u0446\u044c, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0437\u0431\u0443\u0434\u0437\u0435\u0446\u0446\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435, \u0431\u043e \u0442\u0430\u0434\u044b \u043f\u0440\u0430\u043c\u0456\u043d\u0443\u0446\u044c \u0441\u0442\u043e\u0433\u043d\u044b \u0456 \u043d\u0430\u0441\u0442\u0430\u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u044b\u0445 \u0434\u0432\u0443\u0445 \u043f\u0435\u0440\u044b\u044f\u0434\u0430\u045e, \u0430\u0434\u0437\u0456\u043d \u0437 \u044f\u043a\u0456\u0445 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u0445 \u0456 \u043d\u044f\u0434\u043e\u043b\u044f\u0445 \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0430 \u0434\u0440\u0443\u0433\u0456 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043d\u0430\u0434\u044b\u0434\u0437\u0435 \u045e \u0432\u0435\u0447\u043d\u0430\u0439 \u0431\u044f\u0441\u043f\u0435\u0446\u044b \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0434\u043b\u044f \u043d\u0430\u0441 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0432\u0430 \u043f\u0435\u0440\u044b\u044f\u0434\u044b: \u043d\u0430\u043f\u044f\u0440\u044d\u0434\u0430\u0434\u043d\u0456 \u041f\u0430\u0441\u0445\u0456 \u0456 \u043f\u0430\u0441\u043b\u044f \u044f\u0435. \u041f\u0435\u0440\u044b\u044f\u0434 \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u0441\u0445\u0430\u0439 \u0443\u0432\u0430\u0441\u0430\u0431\u043b\u044f\u0435 \u043d\u044f\u0434\u043e\u043b\u044e, \u0443 \u044f\u043a\u043e\u0439 \u043c\u044b \u0446\u044f\u043f\u0435\u0440 \u0436\u044b\u0432\u0451\u043c. \u0410 \u043f\u0435\u0440\u044b\u044f\u0434 \u043f\u0430\u0441\u043b\u044f \u041f\u0430\u0441\u0445\u0456 \u0430\u0437\u043d\u0430\u0447\u0430\u0435 \u0448\u0447\u0430\u0441\u0446\u0435, \u0443 \u044f\u043a\u0456\u043c \u043c\u044b \u0430\u043f\u044b\u043d\u0435\u043c\u0441\u044f \u043f\u0430\u0441\u043b\u044f. \u041f\u0435\u0440\u0430\u0434 \u041f\u0430\u0441\u0445\u0430\u0439 \u043c\u044b \u0446\u044d\u043b\u0435\u0431\u0440\u0443\u0435\u043c \u043d\u0430\u0448 \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u0456 \u043b\u0451\u0441, \u0430 \u043f\u0430\u0441\u043b\u044f \u041f\u0430\u0441\u0445\u0456 &ndash; \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u044f\u0448\u0447\u044d \u043d\u0435 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456. \u0422\u0430\u043c\u0443 \u043f\u0435\u0440\u0448\u044b \u043f\u0435\u0440\u044b\u044f\u0434 \u043c\u044b \u043f\u0440\u0430\u0432\u043e\u0434\u0437\u0456\u043c \u0443 \u043f\u043e\u0441\u0446\u0435 \u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0445, \u0430 \u0434\u0440\u0443\u0433\u0456 &ndash; \u0443 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443 \u0430\u0434 \u043f\u043e\u0441\u0442\u0443 \u0456 \u045e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456. \u0412\u043e\u0441\u044c \u0442\u0430\u043c\u0443 \u043c\u044b \u0456 \u0441\u043f\u044f\u0432\u0430\u0435\u043c: &laquo;\u0410\u043b\u043b\u0435\u043b\u044e\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u044f \u0434\u0432\u0430 \u043f\u0435\u0440\u044b\u044f\u0434\u044b \u043f\u0430\u043a\u0430\u0437\u0430\u043d\u044b\u044f \u043d\u0430\u043c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 &ndash; \u0413\u0430\u043b\u0430\u0432\u0435 \u043d\u0430\u0448\u0430\u0439. \u041c\u0443\u043a\u0430 \u041f\u0430\u043d\u0430 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430\u043c \u043d\u044f\u0434\u043e\u043b\u044e \u0446\u044f\u043f\u0435\u0440\u0430\u0448\u043d\u044f\u0433\u0430 \u0436\u044b\u0446\u0446\u044f: \u043f\u0440\u0430\u0446\u0443, \u043f\u0430\u043a\u0443\u0442\u044b \u0456, \u043d\u0430\u0440\u044d\u0448\u0446\u0435, \u0441\u043c\u0435\u0440\u0446\u044c. \u0410 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0456 \u045e\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430\u043c \u0436\u044b\u0446\u0446\u0451, \u044f\u043a\u043e\u0435 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u0431\u0440\u0430\u0442\u044b, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0432\u0430\u0441 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0411\u043e\u0433\u0430. \u0414\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u043c\u044b \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u0435\u043c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u043a\u0430\u043b\u0456 \u0441\u043f\u044f\u0432\u0430\u0435\u043c: &laquo;\u0410\u043b\u043b\u0435\u043b\u044e\u044f&raquo;. &laquo;\u0425\u0432\u0430\u043b\u0456\u0446\u0435 \u041f\u0430\u043d\u0430&raquo;, &ndash; \u0441\u043a\u0430\u0436\u0430\u0446\u0435 \u0432\u044b \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u043c\u0443 \u0456 \u043f\u0430\u0447\u0443\u0435\u0446\u0435 \u0442\u043e\u0435 \u0436. \u0423 \u0433\u044d\u0442\u0430\u0439 \u0430\u0442\u043c\u0430\u0441\u0444\u0435\u0440\u044b \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0433\u0430 \u0437\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u044f \u045e\u0441\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u0440\u0430\u0431\u0456\u0446\u044c \u0442\u043e\u0435, \u0434\u0430 \u0447\u0430\u0433\u043e \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e\u0446\u044c. \u0410\u0434\u043d\u0430\u043a \u0445\u0432\u0430\u043b\u0456\u0446\u0435 \u0411\u043e\u0433\u0430 \u045e\u0441\u0451\u0439 \u0441\u0432\u0430\u0451\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0430\u0448 \u044f\u0437\u044b\u043a \u0456 \u0433\u043e\u043b\u0430\u0441 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u0411\u043e\u0433\u0430, \u0430\u043b\u0435 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u0435 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0432\u0430\u0448\u0430, \u0456 \u045e\u0447\u044b\u043d\u043a\u0456 \u0432\u0430\u0448\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u043f\u0435\u0440 \u043c\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0411\u043e\u0433\u0430, \u0441\u0430\u0431\u0440\u0430\u043d\u044b\u044f \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0430 \u043a\u0430\u043b\u0456 \u043a\u043e\u0436\u043d\u044b \u043f\u043e\u0439\u0434\u0437\u0435 \u0434\u0430 \u0441\u044f\u0431\u0435, \u043c\u044b \u044f\u043a \u0431\u044b \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0435\u043c \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u0411\u043e\u0433\u0430. \u0414\u044b\u043a \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0432\u0430\u0439\u0446\u0435 \u0434\u043e\u0431\u0440\u0430 \u0436\u044b\u0446\u044c \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0411\u043e\u0433\u0430. \u0412\u044b \u0442\u0430\u0434\u044b \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u044f\u0446\u0435 \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u043a\u0430\u043b\u0456 \u0430\u0434\u0445\u0456\u043b\u044f\u0435\u0446\u0435\u0441\u044f \u0430\u0434 \u042f\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0430\u0434 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043f\u0430\u0434\u0430\u0431\u0430\u0435\u0446\u0446\u0430 \u042f\u043c\u0443. \u0410 \u043a\u0430\u043b\u0456 \u0432\u044b \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u0435 \u0430\u0434 \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0442\u0430\u0434\u044b \u0432\u0430\u0448 \u044f\u0437\u044b\u043a \u043c\u0430\u045e\u0447\u044b\u0446\u044c, \u0430\u043b\u0435 \u043a\u0440\u044b\u0447\u044b\u0446\u044c \u0441\u0430\u043c\u043e \u0436\u044b\u0446\u0446\u0451, \u0430 \u0432\u0443\u0448\u044b \u0411\u043e\u0433\u0430 \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u0434\u0430 \u0432\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u045e. \u042f\u043a \u043d\u0430\u0448\u044b\u044f \u0432\u0443\u0448\u044b \u043f\u0440\u044b\u0437\u0432\u044b\u0447\u0430\u0435\u043d\u044b \u0447\u0443\u0446\u044c \u043d\u0430\u0448\u044b \u0433\u0430\u043b\u0430\u0441\u044b, \u0442\u0430\u043a \u0432\u0443\u0448\u044b \u0411\u043e\u0433\u0430 \u0447\u0443\u044e\u0446\u044c \u043d\u0430\u0448\u044b\u044f \u0437\u0430\u0434\u0443\u043c\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 16, 20b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043c\u0443\u0442\u0430\u043a \u0432\u0430\u0448 <span style=\"color: #ff0000;\">*<\/span> \u0430\u0431\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u0432\u0435\u0442 \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430, \u0430 \u0432\u044b \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u043c\u0443\u0442\u043a\u0430\u0432\u0430\u0446\u044c, \u0430\u043b\u0435 \u0441\u043c\u0443\u0442\u0430\u043a \u0432\u0430\u0448.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0431\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5061","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0434\u0430 \u041a\u0430\u0440\u044b\u043d\u0446\u044f\u043d\u0430\u045e&raquo; \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 5, 5 &ndash; 6, 2: PG 74, 942-943)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0411\u043e\u0433 \u043f\u0430\u044f\u0434\u043d\u0430\u045e \u043d\u0430\u0441 \u0437 \u0441\u0430\u0431\u043e\u044e \u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f, \u0445\u0442\u043e \u043c\u0430\u0435 \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0414\u0443\u0445\u0430 \u0456 \u0430\u0434\u043e\u0440\u0430\u043d\u044b \u043d\u0430\u0434\u0437\u0435\u044f\u0439 \u043d\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435, \u043b\u0456\u0447\u0430\u0446\u044c \u044f\u043a \u0431\u044b \u043d\u0430\u044f\u045e\u043d\u044b\u043c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u043a\u0430\u044e\u0446\u044c, \u0456 \u043a\u0430\u0436\u0443\u0446\u044c, \u0448\u0442\u043e \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u043d\u0435 \u0432\u0435\u0434\u0430\u044e\u0446\u044c \u043d\u0456\u043a\u043e\u0433\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u0431\u043e \u045e\u0441\u0435 \u043c\u044b \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0456 \u043d\u0435\u043f\u0430\u0434\u0443\u043b\u0430\u0434\u043d\u044b\u044f \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439 \u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u0441 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b, \u043c\u044b \u045e\u0441\u0435 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435\u043c\u0441\u044f \u045e \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0430\u0436\u044b\u045e\u043b\u044f\u0435 \u045e\u0441\u0451. \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456, \u0443 \u0447\u0430\u0441\u044b \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u0433\u0440\u0430\u0445\u0443, \u043d\u0430\u0441 \u0437\u0432\u044f\u0437\u0432\u0430\u043b\u0456 \u043f\u0443\u0442\u044b \u0441\u043c\u0435\u0440\u0446\u0456, \u0430\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u045e\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u043b\u0430\u0441\u044f \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u043c\u044b \u0430\u0434\u043a\u0456\u043d\u0443\u043b\u0456 \u045e\u0441\u044f\u043a\u0443\u044e \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u043c\u044b \u045e\u0436\u043e \u043d\u0435 \u0436\u044b\u0432\u0435\u043c \u0443 \u0446\u0435\u043b\u0435, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0443 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456, \u044f\u043a\u0430\u044f, \u043c\u0456\u0436 \u0456\u043d\u0448\u044b\u043c, \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456 \u0433\u0440\u0430\u0445\u043e\u043c. \u0421\u0432. \u041f\u0430\u0432\u0435\u043b \u043f\u0456\u0448\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0436 \u0456 \u0432\u0435\u0434\u0430\u043b\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0446\u0435\u043b\u0430, \u0442\u043e \u0441\u0451\u043d\u043d\u044f \u045e\u0436\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c&raquo; (2 \u041a\u0430\u0440 5, 16). \u0401\u043d \u044f\u043a \u0431\u044b \u0445\u0430\u0446\u0435\u045e \u0441\u043a\u0430\u0437\u0430\u0446\u044c: &laquo;\u0421\u043b\u043e\u0432\u0430 \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u0446\u0435\u043b\u0430\u043c \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u043c\u0456&raquo; (\u042f\u043d 1, 14), \u0456 \u043f\u0430\u0434\u043b\u0435\u0433\u043b\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u045e \u0446\u0435\u043b\u0435, \u043a\u0430\u0431 \u043c\u044b \u045e\u0441\u0435 \u043c\u0435\u043b\u0456 \u0436\u044b\u0446\u0446\u0451; \u0442\u0430\u043a \u043c\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u042f\u0433\u043e, \u0430\u043b\u0435 \u0430\u0434\u0433\u044d\u0442\u0443\u043b\u044c \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c. \u0425\u043e\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0446\u0435\u043b\u0430, \u0431\u043e \u0401\u043d \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u043d\u0430 \u0442\u0440\u044d\u0446\u0456 \u0434\u0437\u0435\u043d\u044c \u0456 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0410\u0439\u0446\u043e\u043c \u0443 \u043d\u0435\u0431\u0435, \u0430\u043b\u0435, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0401\u043d \u043f\u0430-\u043d\u0430\u0434 \u0446\u0435\u043b\u0430\u043c. &laquo;\u041f\u0430\u043c\u0451\u0440\u0448\u044b \u0440\u0430\u0437, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0436\u043e \u043d\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u0435, \u0441\u043c\u0435\u0440\u0446\u044c \u0443\u0436\u043e \u043d\u0435 \u043c\u0430\u0435 \u043d\u0430\u0434 \u0406\u043c \u0443\u043b\u0430\u0434\u044b. \u0411\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u043f\u0430\u043c\u0451\u0440, \u0434\u044b\u043a \u043f\u0430\u043c\u0451\u0440 \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443, \u0430 \u0448\u0442\u043e \u0436\u044b\u0432\u0435, \u0434\u044b\u043a \u0436\u044b\u0432\u0435 \u0434\u0437\u0435\u043b\u044f \u0411\u043e\u0433\u0430&raquo; (\u043f\u0430\u0440. \u0420\u044b\u043c 6, 8-9).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0442\u0430\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0436\u044b\u0446\u0446\u044f \u0434\u043b\u044f \u043d\u0430\u0441, \u043d\u0430\u043c \u0442\u0440\u044d\u0431\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0456\u0441\u0446\u0456 \u043f\u0430 \u042f\u0433\u043e\u043d\u044b\u0445 \u0441\u043b\u044f\u0434\u0430\u0445 \u0434\u044b \u0441\u0442\u0430\u0440\u0430\u0446\u0446\u0430 \u0436\u044b\u0446\u044c \u043d\u0435 \u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0446\u0435\u043b\u0435, \u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0430-\u043d\u0430\u0434 \u0446\u0435\u043b\u0430\u043c. \u0422\u0430\u043c\u0443 \u0432\u0435\u043b\u044c\u043c\u0456 \u0441\u043b\u0443\u0448\u043d\u0430 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b: &laquo;\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0442\u043e\u0439 \u043d\u043e\u0432\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435; \u0434\u0430\u045e\u043d\u044f\u0435 \u043c\u0456\u043d\u0443\u043b\u0430, \u0432\u043e\u0441\u044c \u0441\u0442\u0430\u043b\u0430\u0441\u044f \u043d\u043e\u0432\u0430\u0435&raquo; (2 \u041a\u0430\u0440 5, 17). \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0435\u0440\u044b \u043c\u044b \u0431\u044b\u043b\u0456 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0456 \u0441\u043f\u044b\u043d\u0456\u043b\u0430\u0441\u044f \u043c\u043e\u0446 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0443. \u041a\u0430\u043b\u0456 \u0436 \u0401\u043d \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441, \u0443\u043b\u0430\u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0431\u044b\u043b\u0430 \u0440\u0430\u0441\u0442\u0430\u043f\u0442\u0430\u043d\u0430\u044f, \u0430 \u043c\u044b \u043f\u0430-\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u043e\u043c\u0443 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u043c\u0441\u044f \u045e \u0434\u0443\u0445\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u045e\u0434\u0437\u044f\u043b\u044f\u0435 \u0441\u0432\u0435\u0442\u0443 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0430\u0434 \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0435\u043b\u044c\u043c\u0456 \u043c\u0443\u0434\u0440\u0430 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u043a\u043e\u043d\u0442 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b: &laquo;\u0423\u0441\u0451 \u0430\u0434 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0430\u044f\u0434\u043d\u0430\u045e \u043d\u0430\u0441 \u0437 \u0441\u0430\u0431\u043e\u044e&raquo; (2 \u041a\u0430\u0440 5, 18). \u0411\u043e \u043d\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435 \u043d\u0435 \u0431\u0435\u0437 \u0432\u043e\u043b\u0456 \u0410\u0439\u0446\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0437 \u044f\u0435. \u041c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u0430 \u0410\u0439\u0446\u0430, \u0431\u043e, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u045e \u0441\u0430\u043c\u043e\u0433\u0430 \u0415\u0437\u0443\u0441\u0430, \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0410\u0439\u0446\u0430 \u0456\u043d\u0430\u043a\u0448, \u044f\u043a \u043f\u0440\u0430\u0437 \u042f\u0433\u043e. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, &laquo;\u0443\u0441\u0451 \u0430\u0434 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0430\u044f\u0434\u043d\u0430\u045e \u043d\u0430\u0441 \u0437 \u0441\u0430\u0431\u043e\u044e \u0456 \u0434\u0430\u045e \u043d\u0430\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u044f&raquo; (\u043f\u0430\u0440. 2 \u041a\u0430\u0440 5, 18).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0420\u044b\u043c 5, 11; \u041a\u043b\u0441 1, 19-20\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u0430\u043d\u0430\u0440\u044b\u043c\u0441\u044f \u045e \u0411\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0441\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u043c\u0443 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f. <br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u0410\u0439\u0446\u0443, \u043a\u0430\u0431 \u0443 \u0406\u043c \u0436\u044b\u043b\u0430 \u045e\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0456 \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u0446\u044c \u0437 \u0441\u0430\u0431\u043e\u044e \u045e\u0441\u0451.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u043c\u0443 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0446\u044f\u043f\u0435\u0440 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5062","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0421\u0432\u044f\u0442\u0443\u044e \u0422\u0440\u043e\u0439\u0446\u0443&raquo; \u0414\u044b\u0434\u044b\u043c\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 2, 12: PG 39, 667-674)<\/span><br \/><span style=\"color: #ff0000;\">\u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u0435 \u043d\u0430\u0441 \u0443 \u0445\u0440\u043e\u0441\u0446\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0421\u044b\u043d\u0430\u043c \u0430\u0434\u0437\u0456\u043d\u044b \u0411\u043e\u0433, \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u0435 \u043d\u0430\u0441 \u0443 \u0445\u0440\u043e\u0441\u0446\u0435 \u0456 \u0432\u044f\u0440\u0442\u0430\u0435 \u043d\u0430\u043c \u043f\u0435\u0440\u0448\u0430\u0441\u043d\u0443\u044e \u043a\u0440\u0430\u0441\u0443, \u0448\u0442\u043e \u0431\u044b\u043b\u0430 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430 \u0433\u0440\u0430\u0445\u043e\u043c. \u0401\u043d \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0430\u0439 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u0448\u0442\u043e \u043c\u044b \u045e\u0436\u043e \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0437\u043c\u044f\u0441\u0446\u0456\u0446\u044c \u043d\u0456\u0447\u043e\u0433\u0430, \u0447\u0430\u0433\u043e \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0436\u0430\u0434\u0430\u0446\u044c. \u0401\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435 \u043d\u0430\u0441 \u0430\u0434 \u0433\u0440\u0430\u0445\u0443 \u0456 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0430\u0434\u0443\u0445\u0430\u045e\u043b\u044f\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u045e\u0441\u0442\u0430\u045e \u0437 \u0437\u044f\u043c\u043b\u0456 \u0456 \u043f\u043e\u043f\u0435\u043b\u0443. \u0401\u043d \u0440\u043e\u0431\u0456\u0446\u044c \u0456\u0445 \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0445\u0432\u0430\u043b\u044b \u0411\u043e\u0436\u0430\u0439, \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0456 \u0441\u043f\u0430\u0434\u043a\u0430\u0435\u043c\u0446\u0430\u043c\u0456 \u0411\u043e\u0433\u0430 \u0456 \u0410\u0439\u0446\u0430, \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u0435 \u0456\u0445 \u0434\u0430 \u0432\u043e\u0431\u0440\u0430\u0437\u0430 \u0421\u044b\u043d\u0430, \u0440\u043e\u0431\u0456\u0446\u044c \u0456\u0445 \u0441\u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0430\u043c\u0456 \u0456 \u0431\u0440\u0430\u0442\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u0446\u0430 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c. \u0417\u0430\u043c\u0435\u0441\u0442 \u0437\u044f\u043c\u043b\u0456 \u0401\u043d \u0437\u043d\u043e\u045e \u0434\u0430\u0435 \u0456\u043c \u043d\u0435\u0431\u0430 \u0456 \u0432\u0435\u043b\u0456\u043a\u0430\u0434\u0443\u0448\u043d\u0430 \u0430\u0434\u0447\u044b\u043d\u044f\u0435 \u0440\u0430\u0439, \u043d\u0430\u0434\u0437\u044f\u043b\u044f\u0435 \u0456\u0445 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044e \u0437\u0430 \u0430\u043d\u0451\u043b\u0430\u045e, \u0430 \u043f\u0430\u0442\u043e\u043a\u0430\u043c\u0456 \u0411\u043e\u0436\u0430\u0439 \u0432\u0430\u0434\u044b \u0433\u0430\u0441\u0456\u0446\u044c \u043d\u0435\u043f\u0430\u0433\u0430\u0441\u043d\u0430\u0435 \u043f\u043e\u043b\u044b\u043c\u044f \u043f\u0435\u043a\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0432\u0430\u0456\u0441\u0442\u0430\u0435: \u0430\u0434\u043d\u043e &ndash; \u0437 \u043d\u0430\u0448\u044b\u0445 \u0446\u0435\u043b\u0430\u045e, \u0434\u0440\u0443\u0433\u043e\u0435 &ndash; \u0430\u0434 \u0411\u043e\u0436\u0430\u0433\u0430 \u0414\u0443\u0445\u0430. \u041f\u0440\u0430 \u0430\u0431\u043e\u0434\u0432\u0430 \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u0430 \u043f\u0456\u0441\u0430\u043b\u0456 \u0442\u044d\u043e\u043b\u0430\u0433\u0456. \u042f \u0436 \u0441\u043f\u0430\u0448\u043b\u044e\u0441\u044f \u043d\u0430 \u0456\u0445 \u0456\u043c\u044f \u0456 \u0432\u0443\u0447\u044d\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432. \u042f\u043d \u043a\u0430\u0436\u0430: &laquo;\u0410 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u045e \u0421\u043b\u043e\u0432\u0430, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435, \u0445\u0442\u043e \u043d\u0456 \u0430\u0434 \u043a\u0440\u044b\u0432\u0456, \u043d\u0456 \u0430\u0434 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u0446\u0435\u043b\u0430, \u043d\u0456 \u0430\u0434 \u0436\u0430\u0434\u0430\u043d\u043d\u044f \u043c\u0443\u0436\u0430, \u0430\u043b\u0435 \u0430\u0434 \u0411\u043e\u0433\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f, \u042f\u043d\u043e \u0434\u0430\u043b\u043e \u045e\u043b\u0430\u0434\u0443 \u0441\u0442\u0430\u0446\u044c \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456&raquo; (\u043f\u0430\u0440. \u042f\u043d 1, 13).<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432. \u042f\u043d \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043c\u043e\u0446 \u0441\u0442\u0430\u0446\u044c \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0411\u043e\u0433\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0456 \u0434\u0430\u043b\u0443\u0447\u044b\u0446\u0446\u0430 \u0434\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0411\u043e\u0436\u0430\u0439. \u041a\u0430\u0431 \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u0456\u0445 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u0421\u0432\u044f\u0442\u044b \u0414\u0443\u0445 \u0411\u043e\u0436\u044b, \u0434\u0430\u0434\u0430\u0435 \u0441\u043b\u043e\u0432\u044b \u0425\u0440\u044b\u0441\u0442\u0430: &laquo;\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043a\u0430\u0436\u0443 \u0442\u0430\u0431\u0435, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0432\u0430\u0434\u044b \u0456 \u0414\u0443\u0445\u0430, \u043d\u0435 \u043c\u043e\u0436\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430&raquo; (\u042f\u043d 3, 5).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0443\u043f\u0435\u043b\u044c \u0445\u0440\u043e\u0441\u0442\u0443 \u0431\u0430\u0447\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435 \u043d\u0430\u0448\u0430\u0435 \u0431\u0430\u0447\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u043a\u0430\u043b\u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u044b \u0446\u044d\u043b\u0435\u0431\u0440\u0443\u044e\u0446\u044c \u0430\u0431\u0440\u0430\u0434; \u0430\u0434\u043d\u0430\u043a \u0434\u0443\u0445\u043e\u045e\u043d\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c \u0443 \u0441\u0430\u043c\u0456\u043c \u0441\u0430\u0431\u0435 \u0456 \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u0435 \u043d\u0430\u0448\u0430 \u0446\u0435\u043b\u0430 \u0456 \u0434\u0443\u0448\u0443 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0430\u043d\u0451\u043b\u0430\u045e \u0414\u0443\u0445 \u0411\u043e\u0436\u044b, \u044f\u043a\u043e\u0433\u0430 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0430\u045e\u0432\u0430\u0436\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u042f\u043d \u0425\u0440\u044b\u0441\u0446\u0456\u0446\u0435\u043b\u044c \u0443 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u043c\u043e\u043c\u0430\u043d\u0442 \u0433\u0456\u0441\u0442\u043e\u0440\u044b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0437\u0433\u043e\u0434\u043d\u0430 \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u043c\u0456 &laquo;\u0437 \u0432\u0430\u0434\u044b \u0456 \u0414\u0443\u0445\u0430&raquo;, \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430: &laquo;\u0401\u043d \u0431\u0443\u0434\u0437\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c \u0432\u0430\u0441 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0456 \u0430\u0433\u043d\u0451\u043c&raquo; (\u041c\u0446 3, 11; \u041b\u043a 3, 16). \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a &ndash; \u0433\u044d\u0442\u0430 \u0433\u043b\u0456\u043d\u044f\u043d\u044b \u043f\u043e\u0441\u0443\u0434, \u044f\u0433\u043e \u0442\u0440\u044d\u0431\u0430 \u0441\u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u0432\u0430\u0434\u043e\u0439, \u0430 \u043f\u043e\u0442\u044b\u043c \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u0456 \u0430\u043f\u0440\u0430\u0446\u0430\u0432\u0430\u0446\u044c \u043f\u0430\u0433\u043b\u044b\u043d\u0430\u044e\u0447\u044b\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0430\u0433\u043d\u0451\u043c \u0411\u043e\u0436\u044b\u043c. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0443 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u044f\u043a\u043e\u0433\u0430 \u0451\u043d \u0437\u043c\u043e\u0436\u0430 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u0446\u0446\u0430 \u0456 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u0446\u0430. \u0413\u044d\u0442\u044b \u0434\u0443\u0445\u043e\u045e\u043d\u044b \u0430\u0433\u043e\u043d\u044c \u043c\u043e\u0436\u0430 \u043d\u0430\u0432\u0430\u0442 \u0430\u0440\u0430\u0441\u0456\u0446\u044c, \u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u0432\u0430\u0434\u0430 \u043c\u043e\u0436\u0430 \u043d\u0430\u0432\u0430\u0442 \u043f\u0435\u0440\u0430\u0442\u0430\u043f\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 44, 3. 4; \u042f\u043d 4, 14b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u0440\u0430\u0437\u0430\u043b\u044c\u044e \u0432\u0430\u0434\u0443 \u043f\u0430 \u0432\u044b\u0441\u0430\u0445\u043b\u0430\u0439 \u0433\u043b\u0435\u0431\u0435 \u0456 \u043f\u0430\u0442\u043e\u043a\u0456 &ndash; \u043f\u0430 \u043f\u0435\u0440\u0430\u0441\u043e\u0445\u043b\u0430\u0439 \u0437\u044f\u043c\u043b\u0456; \u043f\u0440\u0430\u043b\u044c\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430,<span style=\"color: #ff0000;\"> *<\/span> \u0456 \u0440\u0430\u0441\u043a\u0432\u0456\u0442\u043d\u0435\u044e\u0446\u044c \u044f\u043d\u044b, \u044f\u043a \u0442\u0430\u043f\u043e\u043b\u0456, \u043d\u0430\u0434 \u0432\u043e\u0434\u043d\u044b\u043c\u0456 \u043f\u043b\u044b\u043d\u044f\u043c\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0430\u0434\u0430 \u0441\u0442\u0430\u043d\u0435 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0432\u0430\u0434\u044b, \u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0440\u0430\u0441\u043a\u0432\u0456\u0442\u043d\u0435\u044e\u0446\u044c \u044f\u043d\u044b, \u044f\u043a \u0442\u0430\u043f\u043e\u043b\u0456, \u043d\u0430\u0434 \u0432\u043e\u0434\u043d\u044b\u043c\u0456 \u043f\u043b\u044b\u043d\u044f\u043c\u0456, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5063","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430&raquo; \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 11, 11: PG 74, 559-562)<\/span><br \/><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0433\u044d\u0442\u0430 \u043f\u043e\u0432\u044f\u0437\u044c \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432. \u041f\u0430\u0432\u0435\u043b \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u0435, \u0448\u0442\u043e \u043c\u044b \u0434\u0430\u0441\u044f\u0433\u0430\u0435\u043c \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u043c\u0430\u0435\u043c \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u043e\u0435 \u0426\u0435\u043b\u0430. \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0433\u044d\u0442\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456: &laquo;\u042f\u043d\u0430 \u043d\u0435 \u0431\u044b\u043b\u0430 \u0430\u0434\u043a\u0440\u044b\u0442\u0430 \u0441\u044b\u043d\u0430\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c \u0443 \u043c\u0456\u043d\u0443\u043b\u044b\u0445 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u0445, \u0442\u0430\u043a \u044f\u043a \u0446\u044f\u043f\u0435\u0440 \u0430\u0434\u043a\u0440\u044b\u043b\u0430\u0441\u044f \u0441\u0432\u044f\u0442\u044b\u043c \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u043c \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430. \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0456 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0441\u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0430\u043c\u0456 \u0456 \u0447\u043b\u0435\u043d\u0430\u043c\u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u0446\u0435\u043b\u0430, \u0456 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u044f \u045e \u0415\u0437\u0443\u0441\u0435 \u0425\u0440\u044b\u0441\u0446\u0435&raquo; (\u042d\u0444 3, 5-6).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043c\u044b \u0437\u0432\u044f\u0437\u0430\u043d\u044b\u044f \u045e \u0430\u0434\u043d\u044b\u043c \u0446\u0435\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c \u0443\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u0441\u0443\u0432\u044f\u0437\u0437\u044e, \u0430 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 &ndash; \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u044e \u0437 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u0426\u0435\u043b\u0430, \u0447\u0430\u043c\u0443 \u0442\u0430\u0434\u044b \u043c\u044b \u043d\u0435 \u045e\u0442\u0432\u0430\u0440\u0430\u0435\u043c \u0442\u0430\u043a\u043e\u0439 \u0432\u044b\u0440\u0430\u0437\u043d\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u043f\u0430\u043c\u0456\u0436 \u043d\u0430\u043c\u0456 \u045e\u0441\u0456\u043c\u0456? \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u0433\u044d\u0442\u0430 \u043f\u043e\u0432\u044f\u0437\u044c \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430, \u0431\u043e \u0401\u043d \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u0411\u043e\u0433 \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u0442\u043e, \u0456\u0434\u0443\u0447\u044b \u0442\u044b\u043c \u0441\u0430\u043c\u044b\u043c \u0448\u043b\u044f\u0445\u0430\u043c, \u0437\u043d\u043e\u045e \u0441\u043a\u0430\u0436\u0430\u043c, \u0448\u0442\u043e \u045e\u0441\u0435 \u043c\u044b, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0430\u0434\u043d\u0430\u0433\u043e \u0456 \u0442\u0430\u0433\u043e \u0436 \u0414\u0443\u0445\u0430, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043f\u044d\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0437\u043b\u0443\u0447\u0430\u043d\u044b\u044f \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u044e \u0456 \u0437 \u0411\u043e\u0433\u0430\u043c. \u0425\u043e\u0446\u044c \u043f\u0430\u0430\u0441\u043e\u0431\u043a\u0443 \u043d\u0430\u0441 \u0448\u043c\u0430\u0442 \u0456 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0437 \u043d\u0430\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0434\u0430\u045e \u0410\u0439\u0446\u043e\u045e\u0441\u043a\u0430\u0433\u0430 \u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430, \u0430\u0434\u043d\u0430\u043a \u0433\u044d\u0442\u044b \u0414\u0443\u0445 \u0430\u0434\u0437\u0456\u043d\u044b \u043d\u0435\u043f\u0430\u0434\u0437\u0435\u043b\u044c\u043d\u044b. \u0422\u0430\u043c\u0443 \u0401\u043d \u0437\u0431\u0456\u0440\u0430\u0435 \u045e \u0430\u0434\u043d\u043e \u043f\u0430\u0430\u0441\u043e\u0431\u043d\u044b\u044f \u0434\u0443\u0445\u0456, \u043a\u043e\u0436\u043d\u044b \u0437 \u044f\u043a\u0456\u0445 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u0441\u0430\u0431\u043e\u0439, \u0456 \u0430\u0431&rsquo;\u044f\u0434\u043d\u043e\u045e\u0432\u0430\u0435 \u043d\u0430\u0441 \u0443 \u0441\u0430\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043e\u0446 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0426\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0440\u043e\u0431\u0456\u0446\u044c \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0447\u0430\u0441\u0442\u043a\u0430\u043c\u0456 \u045e\u0441\u0456\u0445 \u0442\u044b\u0445, \u0443 \u043a\u0456\u043c \u044f\u043d\u043e \u0451\u0441\u0446\u044c. \u0414\u0443\u043c\u0430\u044e, \u0448\u0442\u043e \u0442\u0430\u043a\u0456\u043c \u0436\u0430 \u0447\u044b\u043d\u0430\u043c \u043d\u0435\u043f\u0430\u0434\u0437\u0435\u043b\u044c\u043d\u044b \u0414\u0443\u0445 \u0411\u043e\u0436\u044b, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435 \u0432\u0430 \u045e\u0441\u0456\u0445, \u0437\u0431\u0456\u0440\u0430\u0435 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u045e \u0434\u0443\u0445\u043e\u045e\u043d\u0443\u044e \u0435\u0434\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u0437\u043d\u043e\u045e \u043d\u0430\u0432\u0443\u0447\u0430\u0435 \u043d\u0430\u0441 &laquo;\u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0441\u0442\u0430\u0440\u0430\u044e\u0447\u044b\u0441\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e. \u0410\u0434\u043d\u043e \u0446\u0435\u043b\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445, \u044f\u043a \u0456 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u045e \u0430\u0434\u043d\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0432\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f. \u0410\u0434\u0437\u0456\u043d \u041f\u0430\u043d, \u0430\u0434\u043d\u0430 \u0432\u0435\u0440\u0430, \u0430\u0434\u0437\u0456\u043d \u0445\u0440\u043e\u0441\u0442, \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433 \u0456 \u0410\u0439\u0446\u0435\u0446 \u0443\u0441\u0456\u0445, \u044f\u043a\u0456 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0456 \u043f\u0440\u0430\u0437 \u0443\u0441\u0456\u0445, \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u0441&raquo; (\u043f\u0430\u0440. \u042d\u0444 4, 2-6). \u0410\u0434\u0437\u0456\u043d \u0414\u0443\u0445 \u0436\u044b\u0432\u0435 \u045e \u043a\u043e\u0436\u043d\u044b\u043c \u0437 \u043d\u0430\u0441, \u0442\u0430\u043c\u0443 \u0430\u0434\u0437\u0456\u043d \u0410\u0439\u0446\u0435\u0446 \u0456 \u0411\u043e\u0433 \u0443\u0441\u0456\u0445 \u0431\u0443\u0434\u0437\u0435 \u045e \u043d\u0430\u0441 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u044f\u0447\u044b \u0434\u0430 \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u0406\u043c \u0443\u0441\u0456\u0445, \u0445\u0442\u043e \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u0435 \u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430 \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0443\u0434\u0437\u0435\u043b \u043c\u044b \u0437\u043b\u0443\u0447\u0430\u0435\u043c\u0441\u044f \u0437 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c. \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043c\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0456 \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0437\u0430\u043a\u043e\u043d\u0430\u043c \u0414\u0443\u0445\u0430. \u0414\u044b\u043a \u0446\u0456 \u0436 \u043d\u0435 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430 \u043d\u0430\u043c \u0443\u0441\u0456\u043c, \u0448\u0442\u043e, \u043f\u044d\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u043d\u0430\u0448\u0430 \u0436\u044b\u0446\u0446\u0451 \u0456 \u0437\u043b\u0443\u0447\u044b\u045e\u0448\u044b\u0441\u044f \u0437 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u043c\u044b \u0437\u0430\u0437\u043d\u0430\u043b\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u0456 \u043d\u0430\u0448\u0430 \u043d\u0430\u0442\u0443\u0440\u0430 \u043f\u044d\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0437\u043c\u044f\u043d\u0456\u043b\u0430\u0441\u044f. \u0421\u0442\u0430\u045e\u0448\u044b \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u043c\u044b \u045e\u0436\u043e \u0437\u0430\u0432\u0451\u043c\u0441\u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u045e\u0441\u0435 \u043c\u044b \u0430\u0434\u043d\u043e \u045e \u0410\u0439\u0446\u0443, \u0456 \u0421\u044b\u043d\u0435, \u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c. \u041f\u0430\u045e\u0442\u0430\u0440\u0443, \u0448\u0442\u043e \u043c\u044b \u0430\u0434\u043d\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0443 \u0441\u0442\u0430\u043d\u0443, \u0430\u0434\u043d\u043e \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u0435\u043d\u043d\u044e \u0434\u0430 \u043b\u044e\u0431\u043e\u0432\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u0456 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u043c \u0446\u0435\u043b\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u0430\u0441\u0446\u0456 \u0430\u0434\u043d\u044b\u043c \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u041a\u0430\u0440 10, 17; \u043f\u0430\u0440. \u041f\u0441 68 (67), 11b. 7a<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434\u0437\u0456\u043d \u0451\u0441\u0446\u044c \u0445\u043b\u0435\u0431, \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430 &ndash; \u043c\u044b \u043c\u043d\u043e\u0433\u0456\u044f. <span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u043c\u044b \u045e\u0441\u0435 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u0445\u043b\u0435\u0431\u0430 \u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u043a\u0435\u043b\u0456\u0445\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0436\u0430, \u0443 \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456 \u0422\u044b \u0434\u0430\u045e \u0431\u0435\u0434\u043d\u0430\u043c\u0443 \u0434\u043e\u043c, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b \u0434\u043b\u044f \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u043c\u044b \u045e\u0441\u0435 \u0441\u0430\u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u0445\u043b\u0435\u0431\u0430 \u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u043a\u0435\u043b\u0456\u0445\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5064","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo I de Ascensione, 2-4: PL 54, 395-396)<\/span><br \/><span style=\"color: #ff0000;\">\u0414\u043d\u0456 \u043f\u0430\u043c\u0456\u0436 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435\u043c \u0456 \u045e\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u0435\u043c \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0433\u044d\u0442\u044b\u044f \u0434\u043d\u0456 \u043f\u0430\u043c\u0456\u0436 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435\u043c \u041f\u0430\u043d\u0430 \u0456 \u045e\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u0435\u043c \u043d\u0435 \u043f\u0440\u0430\u0439\u0448\u043b\u0456 \u0434\u0430\u0440\u044d\u043c\u043d\u0430, \u0430\u043b\u0435 \u045e \u0433\u044d\u0442\u044b \u0447\u0430\u0441 \u043f\u0430\u0446\u0432\u0435\u0440\u0434\u0437\u0456\u043b\u0456\u0441\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0456 \u0430\u0431&rsquo;\u044f\u0432\u0456\u043b\u0456\u0441\u044f \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b\u044f \u0434\u043d\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u044e\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u0441\u0442\u0440\u0430\u0445\u0443 \u043f\u0435\u0440\u0430\u0434 \u0437\u043b\u0430\u0432\u0435\u0441\u043d\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u044e \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0443\u0448\u044b, \u0430\u043b\u0435 \u0456 \u0446\u0435\u043b\u0430. \u0423 \u0433\u044d\u0442\u044b\u044f \u0434\u043d\u0456 \u043f\u0440\u0430\u0437 \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 \u045e\u0441\u0456\u043c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c \u0434\u0430\u0435\u0446\u0446\u0430 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b. \u0422\u0430\u0434\u044b \u0436 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u043c\u0443 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0443 \u041f\u044f\u0442\u0440\u0443, \u044f\u043a\u0456 \u045e\u0436\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043a\u043b\u044e\u0447\u044b \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, \u0431\u044b\u045e \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u044b \u043a\u043b\u043e\u043f\u0430\u0442 \u043f\u0440\u0430 \u0430\u045e\u0447\u0430\u0440\u043d\u044e \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u044b\u044f \u0434\u043d\u0456 \u041f\u0430\u043d \u044f\u043a \u0442\u0440\u044d\u0446\u0456 \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u043a \u0434\u0430\u043b\u0443\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0434\u0430\u0440\u043e\u0437\u0435 \u0434\u0430 \u0434\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e, \u043f\u043e\u045e\u043d\u044b\u0445 \u0441\u0442\u0440\u0430\u0445\u0443 \u0456 \u043d\u0435\u043f\u0430\u043a\u043e\u044e, \u0456 \u0434\u0430\u043a\u0430\u0440\u0430\u0435 \u0456\u0445 \u0443 \u043b\u044f\u043d\u043e\u0446\u0435 \u0432\u0435\u0440\u044b, \u043a\u0430\u0431 \u0440\u0430\u0441\u0441\u0435\u044f\u0446\u044c \u0437\u043c\u0440\u043e\u043a \u043d\u0430\u0448\u044b\u0445 \u0441\u0443\u043c\u043d\u0435\u043d\u043d\u044f\u045e. \u0423 \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u0445 \u0406\u043c \u0441\u044d\u0440\u0446\u0430\u0445 \u0440\u0430\u0437\u0433\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u0430\u0433\u043e\u043d\u044c \u0432\u0435\u0440\u044b \u0456, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u0456\u043c \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u0430\u0441\u0442\u044b\u043b\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u043f\u0430\u043b\u043a\u0456\u043c\u0456. \u041f\u0430\u0434\u0447\u0430\u0441 \u043b\u0430\u043c\u0430\u043d\u043d\u044f \u0445\u043b\u0435\u0431\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u044e\u0446\u0446\u0430 \u0432\u043e\u0447\u044b \u0432\u0443\u0447\u043d\u044f\u045e. \u0412\u043e\u0447\u044b, \u044f\u043a\u0456\u043c \u043f\u0430\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044f \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430, \u043d\u0430\u0448\u043c\u0430\u0442 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0435\u0439\u0448\u044b\u044f, \u0447\u044b\u043c \u0432\u043e\u0447\u044b \u043f\u0430\u0447\u044b\u043d\u0430\u043b\u044c\u043d\u0456\u043a\u0430\u045e \u043d\u0430\u0448\u0430\u0433\u0430 \u0440\u043e\u0434\u0443, \u044f\u043a\u0456\u044f \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456 \u0441\u0432\u0430\u0451 \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u0430 \u0456 \u043f\u0430\u043a\u0440\u044b\u043b\u0456\u0441\u044f \u0441\u043e\u0440\u0430\u043c\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u045e\u0441\u044f\u0433\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u0447\u0430\u0441\u0443 \u043f\u0430\u043c\u0456\u0436 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435\u043c \u041f\u0430\u043d\u0430 \u0456 \u045e\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u0435\u043c \u0411\u043e\u0436\u044b \u041f\u0440\u043e\u0432\u0456\u0434 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u045e\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0431 \u0442\u044b\u043c, \u043d\u0430\u0432\u0443\u0447\u0430\u045e \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043c\u0443 \u0456 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u045e \u0432\u0430\u0447\u0430\u043c \u0456 \u0441\u044d\u0440\u0446\u0430\u043c \u0441\u0432\u0430\u0456\u0445 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0442\u0440\u044d\u0431\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u044b\u0437\u043d\u0430\u0446\u044c \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u044b\u045e \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b, \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u043c\u0443\u043a\u0443 \u0456 \u043f\u0430\u043c\u0451\u0440.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0456 \u045e\u0441\u0435 \u0432\u0443\u0447\u043d\u0456, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0441\u0442\u0432\u043e\u0440\u0430\u043d\u044b \u043a\u0440\u044b\u0436\u043e\u0432\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u044e \u041f\u0430\u043d\u0430 \u0456 \u044f\u043a\u0456\u044f \u0441\u0443\u043c\u043d\u044f\u0432\u0430\u043b\u0456\u0441\u044f \u045e \u042f\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0456, \u0431\u044b\u043b\u0456 \u0442\u0430\u043a \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0430\u0441\u0446\u044e \u043f\u0440\u0430\u045e\u0434\u044b, \u0448\u0442\u043e, \u043a\u0430\u043b\u0456 \u041f\u0430\u043d \u043f\u0430\u0434\u044b\u043c\u0430\u045e\u0441\u044f \u043d\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0432\u044b\u0441\u0456, \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043d\u0435 \u0437\u0430\u0441\u043c\u0443\u0446\u0456\u043b\u0456\u0441\u044f, \u0430\u043b\u0435 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0456 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u044f \u043f\u0440\u044b\u0447\u044b\u043d\u0430 \u0434\u043b\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u043c\u043d\u043e\u0441\u0442\u0432\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430 \u043f\u0430\u0434\u044b\u043c\u0430\u043b\u0430\u0441\u044f \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u045e\u0441\u044f\u043a\u0443\u044e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e, \u044f\u043d\u0430 \u045e\u0437\u043d\u043e\u0441\u0456\u043b\u0430\u0441\u044f \u043d\u0430\u0434 \u0432\u043e\u0439\u0441\u043a\u0430\u043c\u0456 \u0430\u043d\u0451\u043b\u0430\u045e \u0456 \u045e\u0437\u043b\u044f\u0442\u0430\u043b\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0432\u044b\u0448\u044b\u043d\u044f\u043c\u0456 \u0430\u0440\u0445\u0430\u043d\u0451\u043b\u0430\u045e, \u043d\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u043c\u044f\u0436\u044b \u0441\u0432\u0430\u0439\u043c\u0443 \u045e\u0437\u043d\u044f\u0441\u0435\u043d\u043d\u044e. \u0423\u0440\u044d\u0448\u0446\u0435, \u044f\u043d\u0430 \u0431\u044b\u043b\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u0430\u044f \u0437\u0430\u043d\u044f\u0446\u044c \u043c\u0435\u0441\u0446\u0430 \u043f\u0440\u044b \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b\u043c \u0410\u0439\u0446\u0443 \u0456 \u0434\u0430\u043b\u0443\u0447\u044b\u043b\u0430\u0441\u044f \u0434\u0430 \u042f\u0433\u043e \u0441\u043b\u0430\u0432\u044b \u043d\u0430 \u0442\u0440\u043e\u043d\u0435, \u0431\u043e \u045e \u0421\u044b\u043d\u0435 \u0411\u043e\u0436\u044b\u043c \u0431\u044b\u043b\u0430 \u0437\u043b\u0443\u0447\u0430\u043d\u0430 \u0437 \u042f\u0433\u043e\u043d\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 14, 2b. 3b. 16. 18<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0439\u0434\u0443, \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u044e \u0432\u0430\u043c \u043c\u0435\u0441\u0446\u0430 \u0456 \u043f\u0440\u044b\u0439\u0434\u0443 \u0437\u043d\u043e\u045e, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0437\u0430\u0431\u044f\u0440\u0443 \u0432\u0430\u0441 \u0434\u0430 \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u0456 \u0432\u044b \u0431\u044b\u043b\u0456 \u0442\u0430\u043c, \u0434\u0437\u0435 \u042f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u043f\u0430\u043f\u0440\u0430\u0448\u0443 \u0410\u0439\u0446\u0430, \u0456 \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c \u0456\u043d\u0448\u0430\u0433\u0430 \u0421\u0443\u0446\u044f\u0448\u044b\u0446\u0435\u043b\u044f, \u043a\u0430\u0431 \u0431\u044b\u045e \u0437 \u0432\u0430\u043c\u0456 \u043d\u0430\u0432\u0435\u043a\u0456. \u041d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443 \u0432\u0430\u0441 \u0441\u0456\u0440\u043e\u0442\u0430\u043c\u0456, \u043f\u0440\u044b\u0439\u0434\u0443 \u0434\u0430 \u0432\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0437\u0430\u0431\u044f\u0440\u0443 \u0432\u0430\u0441 \u0434\u0430 \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u0456 \u0432\u044b \u0431\u044b\u043b\u0456 \u0442\u0430\u043c, \u0434\u0437\u0435 \u042f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5065","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo de Ascensione Domini, Mai 98, 1-2: PLS 2, 494-495)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u045e\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u044b\u0448\u043e\u045e \u0437 \u043d\u0435\u0431\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0451\u043d\u043d\u044f \u043d\u0430\u0448 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430, \u0434\u044b\u043a \u043d\u044f\u0445\u0430\u0439 \u0441\u043a\u0456\u0440\u0443\u0435\u0446\u0446\u0430 \u0437\u0430 \u0406\u043c \u0456 \u043d\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0436 \u0432\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430; \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0443\u043c\u0430\u0439\u0446\u0435&raquo; (\u041a\u043b\u0441 3, 1-2). \u042f\u043a \u0401\u043d \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u045e \u043d\u0435\u0431\u0430 \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u043d\u0430\u0441, \u0442\u0430\u043a \u0456 \u043c\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c\u0441\u044f \u0442\u0430\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c, \u0445\u043e\u0446\u044c \u044f\u0448\u0447\u044d \u043d\u0435 \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u045e \u0446\u0435\u043b\u0430\u0445 \u043d\u0430\u0448\u044b\u0445 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043d\u0430\u043c \u0430\u0431\u044f\u0446\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0436\u043e \u045e\u0437\u043d\u044f\u0442\u044b \u043f\u0430-\u043d\u0430\u0434 \u043d\u044f\u0431\u0451\u0441\u044b, \u0430\u0434\u043d\u0430\u043a \u0401\u043d \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u045e\u0441\u0435 \u043f\u0430\u043a\u0443\u0442\u044b, \u044f\u043a\u0456\u044f \u0432\u044b\u043f\u0430\u0434\u0430\u044e\u0446\u044c \u043d\u0430\u043c \u044f\u043a \u0447\u0430\u0441\u0442\u043a\u0430\u043c \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430. \u0401\u043d \u0441\u0430\u043c \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0433\u044d\u0442\u0430, \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u044e\u0447\u044b \u0437 \u043d\u0435\u0431\u0430: &laquo;\u0421\u0430\u045e\u043b, \u0421\u0430\u045e\u043b, \u0447\u0430\u043c\u0443 \u0442\u044b \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0443\u0435\u0448 \u041c\u044f\u043d\u0435?&raquo; (\u0414\u0437 9, 4). \u0406 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b: &laquo;\u042f \u0431\u044b\u045e \u0433\u0430\u043b\u043e\u0434\u043d\u044b, \u0456 \u0432\u044b \u0434\u0430\u043b\u0456 \u041c\u043d\u0435 \u0435\u0441\u0446\u0456&raquo; (\u041c\u0446 25, 35).<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u0430\u043c\u0443 \u0436 \u0456 \u043c\u044b \u0442\u0443\u0442, \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043d\u0435 \u043d\u0430\u043c\u0430\u0433\u0430\u0435\u043c\u0441\u044f \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u043d\u0430\u0434\u0437\u0435\u044e \u0456 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0456\u044f \u0437\u0432\u044f\u0437\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u0441 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0430\u0434\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443 \u043d\u044f\u0431\u0451\u0441\u0430\u0445? \u0425\u043e\u0446\u044c \u0401\u043d \u0442\u0430\u043c, \u0430\u0434\u043d\u0430\u043a \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u043c\u0456. \u0406 \u043c\u044b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0443\u0442, \u0430\u043b\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c\u0441\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c. \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u043d\u0435\u0431\u0435 \u045e \u0441\u0432\u0430\u0451\u0439 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456, \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0456 \u043b\u044e\u0431\u043e\u0432\u0456. \u041c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0431\u044b\u0446\u044c \u0442\u0430\u043c, \u044f\u043a \u0401\u043d, \u0430\u0434\u043d\u0430\u043a \u043c\u0430\u0435\u043c \u043b\u044e\u0431\u043e\u045e, \u0456 \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0435\u0431\u0430, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0430\u0434\u0442\u0443\u043b\u044c \u0434\u0430 \u043d\u0430\u0441, \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u045e \u043d\u0435\u0431\u0430. \u041f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u045e\u0441\u044f \u0442\u0430\u043c, \u0431\u0443\u0434\u0443\u0447\u044b \u0437 \u043d\u0430\u043c\u0456 \u0442\u0443\u0442, \u0401\u043d \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u044b\u043c\u0456 \u0441\u043b\u043e\u0432\u0430\u043c\u0456: &laquo;\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u045e\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0437 \u043d\u0435\u0431\u0430 \u0441\u044b\u0448\u043e\u045e, &mdash; \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b&raquo; (\u042f\u043d 3, 13).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430, \u043a\u0430\u0431 \u043f\u0430\u0434\u043a\u0440\u044d\u0441\u043b\u0456\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c, \u0431\u043e \u0401\u043d &ndash; \u043d\u0430\u0448\u0430 \u0413\u0430\u043b\u0430\u0432\u0430, \u0430 \u043c\u044b &ndash; \u042f\u0433\u043e \u0446\u0435\u043b\u0430. \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u045e\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430, \u0430\u043a\u0440\u0430\u043c\u044f \u042f\u0433\u043e, \u0431\u043e \u0456 \u043c\u044b \u0436\u044b\u0432\u0451\u043c \u0437 \u0406\u043c \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0401\u043d \u0441\u0442\u0430\u045e \u0421\u044b\u043d\u0430\u043c \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0441, \u0430 \u043c\u044b &ndash; \u0411\u043e\u0436\u044b\u043c\u0456 \u0434\u0437\u0435\u0446\u044c\u043c\u0456 \u0434\u0437\u0435\u043b\u044f \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0442\u0430\u043a \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u042f\u043a \u0446\u0435\u043b\u0430 \u0430\u0434\u043d\u043e, \u0430\u043b\u0435 \u043c\u0430\u0435 \u0448\u043c\u0430\u0442 \u0447\u0430\u0441\u0442\u0430\u043a, \u044f\u043a\u0456\u044f, \u0445\u043e\u0446\u044c \u0456\u0445 \u0448\u043c\u0430\u0442, \u0441\u043a\u043b\u0430\u0434\u0430\u044e\u0446\u044c \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430, \u0442\u0430\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441&raquo; (1 \u041a\u0430\u0440 12, 12). \u041d\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0422\u0430\u043a \u0425\u0440\u044b\u0441\u0442\u0443\u0441&raquo;, \u0430\u043b\u0435: &laquo;\u0422\u0430\u043a \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441&raquo;. \u0417\u043d\u0430\u0447\u044b\u0446\u044c, \u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0448\u043c\u0430\u0442 \u0447\u0430\u0441\u0442\u0430\u043a, \u0430\u043b\u0435 \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u044b\u0448\u043e\u045e \u0437 \u043d\u0435\u0431\u0430 \u043f\u0440\u0430\u0437 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u0443\u0437\u044b\u0448\u043e\u045e \u043d\u0430 \u043d\u0435\u0431\u0430, \u0430 \u043c\u044b \u045e \u0406\u043c \u043f\u0440\u0430\u0437 \u043b\u0430\u0441\u043a\u0443. \u0422\u0430\u043c\u0443 \u0442\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u044b\u0448\u043e\u045e, \u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0437\u044b\u0448\u043e\u045e. \u0406 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c \u0413\u0430\u043b\u0430\u0432\u044b \u043f\u0430\u0448\u044b\u0440\u044b\u043b\u0430\u0441\u044f \u043d\u0430 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043d\u0435\u043f\u0430\u0434\u0437\u0435\u043b\u044c\u043d\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0446\u0435\u043b\u0430 \u0456 \u0413\u0430\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0414\u0437 1, 3. 9. 4<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0441\u0430\u0440\u0430\u043a\u0430 \u0434\u0437\u0451\u043d \u0430\u0431&rsquo;\u044f\u045e\u043b\u044f\u045e\u0441\u044f \u0456\u043c \u0456 \u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0401\u043d \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0456\u0445\u043d\u0456\u0445, \u0456 \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u0437\u0430\u0431\u0440\u0430\u043b\u0430 \u042f\u0433\u043e \u0437 \u0456\u0445\u043d\u0456\u0445 \u0432\u0430\u0447\u044d\u0439, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u043a\u0430\u0437\u0430\u045e \u0456\u043c \u043d\u0435 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430, \u0430\u043b\u0435 \u0447\u0430\u043a\u0430\u0446\u044c \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u043e\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0401\u043d \u043f\u0430\u0434\u043d\u044f\u045e\u0441\u044f \u043d\u0430 \u0432\u0430\u0447\u0430\u0445 \u0456\u0445\u043d\u0456\u0445, \u0456 \u0432\u043e\u0431\u043b\u0430\u043a\u0430 \u0437\u0430\u0431\u0440\u0430\u043b\u0430 \u042f\u0433\u043e \u0437 \u0456\u0445\u043d\u0456\u0445 \u0432\u0430\u0447\u044d\u0439, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5066","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 2 de Ascensione, 1-4: PL 54, 397-399)<\/span><br \/><span style=\"color: #ff0000;\">\u0423\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u0435 \u041f\u0430\u043d\u0430 \u043f\u0430\u0433\u043b\u044b\u0431\u043b\u044f\u0435 \u043d\u0430\u0448\u0443 \u0432\u0435\u0440\u0443<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043f\u0430\u0434\u0447\u0430\u0441 \u0432\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b\u0445 \u0441\u0432\u044f\u0442\u0430\u045e \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u041f\u0430\u043d\u0430 \u0431\u044b\u043b\u043e \u0434\u043b\u044f \u043d\u0430\u0441 \u043f\u0440\u044b\u0447\u044b\u043d\u0430\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0442\u0430\u043a \u042f\u0433\u043e \u045e\u0437\u044b\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435 \u043d\u0430 \u043d\u0435\u0431\u0430 \u0446\u0435\u0448\u044b\u0446\u044c \u043d\u0430\u0441 \u0446\u044f\u043f\u0435\u0440, \u043a\u0430\u043b\u0456 \u043c\u044b \u0437 \u043d\u0430\u043b\u0435\u0436\u043d\u0430\u044e \u043f\u0430\u0448\u0430\u043d\u0430\u0439 \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u0435\u043c \u0434\u0437\u0435\u043d\u044c, \u0443 \u044f\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0437\u043d\u044f\u045e \u043d\u0430\u0448\u0443\u044e \u0441\u043b\u0430\u0431\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443 \u043d\u0430 \u0442\u0440\u043e\u043d \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0435 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0432\u043e\u0439\u0441\u043a\u0456, \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0435 \u0448\u044d\u0440\u0430\u0433\u0456 \u0430\u043d\u0451\u043b\u0430\u045e \u0456 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0435 \u0432\u044b\u0448\u044b\u043d\u0456 \u043c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u0422\u0430\u043a\u0456 \u043f\u0430\u0440\u0430\u0434\u0430\u043a \u0411\u043e\u0436\u044b\u0445 \u0441\u043f\u0440\u0430\u045e \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0456 \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u045e \u043d\u0430\u0441, \u043a\u0430\u0431 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u0439 \u0441\u0442\u0430\u043b\u0430 \u0411\u043e\u0436\u0430\u044f \u043b\u0430\u0441\u043a\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u043d\u0435 \u0430\u0441\u043b\u0430\u0431\u0435\u043b\u0430 \u043d\u0430\u0448\u0430\u044f \u0432\u0435\u0440\u0430, \u043d\u0435 \u043f\u0430\u0445\u0456\u0441\u043d\u0443\u043b\u0430\u0441\u044f \u043d\u0430\u0434\u0437\u0435\u044f \u0456 \u043d\u0435 \u0430\u0441\u0442\u044b\u043b\u0430 \u043b\u044e\u0431\u043e\u045e, \u043a\u0430\u043b\u0456 \u0437 \u043d\u0430\u0448\u044b\u0445 \u0432\u0430\u0447\u044d\u0439 \u0431\u044b\u043b\u043e \u0437\u0430\u0431\u0440\u0430\u043d\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0430\u0431\u0443\u0434\u0436\u0430\u043b\u0430 \u043d\u0430\u0448\u0443\u044e \u043f\u0430\u0448\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u0441\u0456\u043b\u0430 \u0434\u0443\u0445\u0430 \u0456 \u044f\u0440\u043a\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u045e \u0434\u0443\u0448\u0430\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e, \u043a\u0430\u043b\u0456 \u044f\u043d\u044b \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430 \u0432\u0435\u0440\u0430\u0446\u044c \u0443 \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u043c \u0437\u0440\u043e\u043a\u0430\u043c, \u0456 \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u0430\u0435 \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u043d\u0435\u043b\u044c\u0433\u0430 \u045e\u0431\u0430\u0447\u044b\u0446\u044c. \u0426\u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0431 \u0442\u0430\u043a\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0443 \u043d\u0430\u0448\u044b\u0445 \u0441\u044d\u0440\u0446\u0430\u0445 \u0456 \u0446\u0456 \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u045e\u0441\u044f \u0431 \u0445\u0442\u043e-\u043d\u0435\u0431\u0443\u0434\u0437\u044c \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u043a\u0430\u043b\u0456 \u0431 \u043d\u0430\u0448\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u043b\u0430\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u043b\u044f\u0436\u0430\u043b\u0430 \u0431 \u043f\u0435\u0440\u0430\u0434 \u043d\u0430\u0448\u044b\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u0431\u0430\u0447\u043d\u044b\u043c \u0443 \u043d\u0430\u0448\u044b\u043c \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044e, \u043f\u0435\u0440\u0430\u0439\u0448\u043b\u043e \u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u044b. \u041a\u0430\u0431 \u0432\u0435\u0440\u0430 \u0431\u044b\u043b\u0430 \u0433\u043b\u044b\u0431\u0435\u0439\u0448\u0430\u0439 \u0456 \u043c\u0430\u0446\u043d\u0435\u0439\u0448\u0430\u0439, \u0431\u0430\u0447\u0430\u043d\u043d\u0435 \u0441\u0430\u0441\u0442\u0443\u043f\u0456\u043b\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044e, \u0430 \u044f\u0433\u043e \u0430\u045e\u0442\u0430\u0440\u044b\u0442\u044d\u0442 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0441\u044d\u0440\u0446\u044b \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e, \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u044f \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u043f\u0440\u043e\u043c\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u0439 \u0432\u0435\u0440\u044b, \u043f\u0430\u0433\u043b\u044b\u0431\u043b\u0435\u043d\u0430\u0439 \u0443\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u0435\u043c \u041f\u0430\u043d\u0430 \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u0430\u0439 \u0434\u0430\u0440\u0430\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043d\u0435 \u0437\u043b\u0430\u043c\u0430\u043b\u0456 \u043d\u0456 \u043a\u0430\u0439\u0434\u0430\u043d\u044b, \u043d\u0456 \u0432\u044f\u0437\u043d\u0456\u0446\u044b, \u043d\u0456 \u0433\u043e\u043b\u0430\u0434, \u043d\u0456 \u0430\u0433\u043e\u043d\u044c, \u043d\u0456 \u0440\u0430\u0437\u0430\u0440\u0432\u0430\u043d\u043d\u0435 \u0434\u0437\u0456\u043a\u0456\u043c\u0456 \u0437\u0432\u044f\u0440\u0430\u043c\u0456, \u043d\u0456 \u0456\u043d\u0448\u044b\u044f \u0432\u044b\u0442\u0430\u043d\u0447\u0430\u043d\u044b\u044f \u043a\u0430\u0442\u0430\u0432\u0430\u043d\u043d\u0456, \u043f\u0440\u044b\u0434\u0443\u043c\u0430\u043d\u044b\u044f \u0436\u043e\u0440\u0441\u043a\u0456\u043c\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0430\u043c\u0456. \u0417\u0430 \u0433\u044d\u0442\u0443\u044e \u0432\u0435\u0440\u0443 \u0437\u043c\u0430\u0433\u0430\u043b\u0456\u0441\u044f, \u043d\u0435 \u0448\u043a\u0430\u0434\u0443\u044e\u0447\u044b \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043a\u0440\u044b\u0432\u0456, \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043c\u0443\u0436\u0447\u044b\u043d\u044b, \u0430\u043b\u0435 \u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u044e\u043d\u0430\u043a\u0456 \u0456 \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u044b\u044f \u0434\u0437\u0435\u0432\u044b. \u0413\u044d\u0442\u0430\u044f \u0432\u0435\u0440\u0430 \u0432\u044b\u0433\u0430\u043d\u044f\u043b\u0430 \u0437\u043b\u044b\u0445 \u0434\u0443\u0445\u0430\u045e, \u043b\u044f\u0447\u044b\u043b\u0430 \u0445\u0432\u0430\u0440\u043e\u0431\u044b \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u0430\u043b\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0456 \u0441\u0432\u044f\u0442\u044b\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b, \u0445\u043e\u0446\u044c \u0431\u044b\u043b\u0456 \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0441\u0442\u043e\u043b\u044c\u043a\u0456\u043c\u0456 \u0446\u0443\u0434\u0430\u043c\u0456 \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b\u044f \u0441\u0442\u043e\u043b\u044c\u043a\u0456\u043c\u0456 \u043a\u0430\u0437\u0430\u043d\u043d\u044f\u043c\u0456, \u0441\u043f\u0430\u043b\u043e\u0445\u0430\u043b\u0456\u0441\u044f, \u0431\u0430\u0447\u0430\u0447\u044b \u0436\u0443\u0434\u0430\u0441\u043d\u044b\u044f \u043f\u0430\u043a\u0443\u0442\u044b \u041f\u0430\u043d\u0430, \u0456 \u043d\u0435 \u0431\u0435\u0437 \u0432\u0430\u0433\u0430\u043d\u043d\u044f\u045e \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u043f\u0440\u0430\u045e\u0434\u0443 \u043f\u0440\u0430 \u042f\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435. \u0410\u0434\u043d\u0430\u043a \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0437 \u0443\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u044f \u041f\u0430\u043d\u0430, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0440\u0430\u043d\u0435\u0439 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u043b\u0430 \u0456\u043c \u0441\u0442\u0440\u0430\u0445, \u0430\u0431\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0431\u043e \u044f\u043d\u044b \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u043c\u0456 \u0432\u0430\u0447\u044b\u043c\u0430 \u0441\u0443\u0437\u0456\u0440\u0430\u043b\u0456 \u0431\u043e\u0441\u0442\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0435\u045e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0410\u0439\u0446\u0430. \u0406 \u045e\u0436\u043e \u043d\u0435 \u0437\u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u0437\u0440\u043e\u043a\u0443 \u043d\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c \u0446\u0435\u043b\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u043b\u0435 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0456 \u045e \u0434\u0443\u0445\u0443 \u0442\u043e\u0435, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u045e \u0410\u0439\u0446\u0430, \u0441\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0434\u0430 \u0456\u0445, \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u0432\u0443\u0447\u043d\u044f\u045e, \u0443\u0437\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u044b \u0434\u0430 \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0436, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0421\u044b\u043d \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u0441\u044f\u0431\u0435 \u044f\u043a \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0431\u043e\u043b\u044c\u0448 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430 \u0456 \u0441\u0432\u044f\u0442\u0430, \u043a\u0430\u043b\u0456 \u0432\u044f\u0440\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0441\u043b\u0430\u0432\u044b \u0410\u0439\u0446\u043e\u045e\u0441\u043a\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b, \u0456 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0441\u0442\u0430\u045e \u0431\u043b\u0456\u0436\u044d\u0439\u0448\u044b\u043c \u0434\u0430 \u043d\u0430\u0441 \u044f\u043a \u0411\u043e\u0433, \u0445\u043e\u0446\u044c \u0456 \u0430\u0434\u0434\u0430\u043b\u0456\u045e\u0441\u044f \u0430\u0434 \u043d\u0430\u0441 \u044f\u043a \u0447\u0430\u043b\u0430\u0432\u0435\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u044f \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u0432\u0435\u0440\u0430 \u043f\u0430\u0447\u0430\u043b\u0430 \u043d\u0430\u0431\u043b\u0456\u0436\u0430\u0446\u0446\u0430 \u0434\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0440\u043e\u045e\u043d\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430 \u0456 \u045e\u0436\u043e \u043d\u0435 \u043c\u0435\u043b\u0430 \u043f\u0430\u0442\u0440\u044d\u0431\u044b \u0434\u0430\u043a\u0440\u0430\u043d\u0430\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0435 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0437-\u0437\u0430 \u0447\u0430\u0433\u043e \u0401\u043d \u0437\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u043d\u0456\u0436\u044d\u0439\u0448\u044b\u043c \u0437\u0430 \u0410\u0439\u0446\u0430. \u0413\u044d\u0442\u0430\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u0432\u0430\u044e \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c, \u0430\u043b\u0435 \u043d\u0430\u0448\u0430 \u0432\u0435\u0440\u0430 \u0431\u044b\u043b\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u0430 \u0442\u0443\u0434\u044b, \u0434\u0437\u0435 \u0434\u0430 \u0440\u043e\u045e\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0443 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u043c\u043e\u0436\u043d\u0430 \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u0446\u0446\u0430 \u043d\u0435 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u0439 \u0440\u0443\u043a\u043e\u0439, \u0430\u043b\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u0432\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0413\u0431\u0440 8, 1b; 10, 22. 23<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u043d\u0430\u0441 \u0451\u0441\u0446\u044c \u0442\u0430\u043a\u0456 \u043f\u0435\u0440\u0448\u0430\u0441\u0432\u044f\u0442\u0430\u0440, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0442\u0440\u043e\u043d\u0430 \u0412\u0435\u043b\u0456\u0447\u044b \u045e \u043d\u044f\u0431\u0451\u0441\u0430\u0445. <span style=\"color: #ff0000;\">*<\/span> \u041d\u0430\u0431\u043b\u0456\u0437\u0456\u043c\u0441\u044f \u0434\u0430 \u042f\u0433\u043e \u0441\u0430 \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u045e \u043f\u0430\u045e\u043d\u0430\u0446\u0435 \u0432\u0435\u0440\u044b, \u0430\u043a\u0440\u0430\u043f\u0456\u045e\u0448\u044b \u0441\u044d\u0440\u0446\u044b \u0430\u0434 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0443\u0434\u0437\u0435\u043c \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430 \u0442\u0440\u044b\u043c\u0430\u0446\u0446\u0430 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u044f \u043d\u0430\u0434\u0437\u0435\u0456, \u0431\u043e \u0432\u0435\u0440\u043d\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u0431\u044f\u0446\u0430\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0431\u043b\u0456\u0437\u0456\u043c\u0441\u044f \u0434\u0430 \u042f\u0433\u043e \u0441\u0430 \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u045e \u043f\u0430\u045e\u043d\u0430\u0446\u0435 \u0432\u0435\u0440\u044b, \u0430\u043a\u0440\u0430\u043f\u0456\u045e\u0448\u044b \u0441\u044d\u0440\u0446\u044b \u0430\u0434 \u043d\u044f\u0447\u044b\u0441\u0442\u0430\u0433\u0430 \u0441\u0443\u043c\u043b\u0435\u043d\u043d\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5067","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430&raquo; \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Tract. 124, 5. 7: CCL 36, 685-687)<\/span><br \/><span style=\"color: #ff0000;\">\u0414\u0432\u0430 \u0436\u044b\u0446\u0446\u0456<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0441\u0446\u0451\u043b \u0432\u0435\u0434\u0430\u0435 \u0434\u0432\u0430 \u0436\u044b\u0446\u0446\u0456, \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u044b\u044f \u044f\u043c\u0443 \u0456 \u043d\u0430\u043a\u0430\u0437\u0430\u043d\u044b\u044f \u0411\u043e\u0433\u0430\u043c. \u0410\u0434\u043d\u043e &ndash; \u0433\u044d\u0442\u0430 \u0436\u044b\u0446\u0446\u0451 \u045e \u0432\u0435\u0440\u044b, \u0434\u0440\u0443\u0433\u043e\u0435 &ndash; \u0436\u044b\u0446\u0446\u0451 \u045e \u0431\u0430\u0447\u0430\u043d\u043d\u0456. \u0410\u0434\u043d\u043e &ndash; \u0443 \u0447\u0430\u0441\u0435 \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u0430, \u0434\u0440\u0443\u0433\u043e\u0435 &ndash; \u0443 \u0432\u0435\u0447\u043d\u044b\u043c \u0436\u044b\u043b\u043b\u0456. \u0410\u0434\u043d\u043e &ndash; \u0443 \u043f\u0440\u0430\u0446\u044b, \u0434\u0440\u0443\u0433\u043e\u0435 &ndash; \u0443 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443. \u0410\u0434\u043d\u043e &ndash; \u0443 \u0434\u0430\u0440\u043e\u0437\u0435, \u0434\u0440\u0443\u0433\u043e\u0435 &ndash; \u043d\u0430 \u0440\u0430\u0434\u0437\u0456\u043c\u0435. \u0410\u0434\u043d\u043e &ndash; \u0443 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u0456 \u0441\u043f\u0440\u0430\u0432\u044b, \u0434\u0440\u0443\u0433\u043e\u0435 &ndash; \u0432\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0435 \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0456\u043c\u0432\u0430\u043b\u0430\u043c \u043f\u0435\u0440\u0448\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0451\u0442\u0440, \u0434\u0440\u0443\u0433\u043e\u0433\u0430 &ndash; \u042f\u043d. \u041f\u0435\u0440\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u043f\u0440\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0434\u0430 \u0441\u0430\u043c\u0430\u0433\u0430 \u043a\u0430\u043d\u0446\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u0456 \u0442\u0430\u043c \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0435 \u043a\u0430\u043d\u0435\u0446. \u0410 \u0434\u0440\u0443\u0433\u043e\u0435 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u043c\u0456\u043d\u0435 \u0433\u044d\u0442\u044b \u0441\u0432\u0435\u0442, \u0430\u043b\u0435 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043c\u0435\u0446\u044c \u043a\u0430\u043d\u0446\u0430. \u0422\u0430\u043c\u0443 \u043f\u0435\u0440\u0448\u0430\u043c\u0443 \u0441\u043a\u0430\u0437\u0430\u043d\u0430: &laquo;\u0406\u0434\u0437\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e&raquo; (\u042f\u043d 21, 19), &ndash; \u0430 \u0434\u0440\u0443\u0433\u043e\u043c\u0443: &laquo;\u041a\u0430\u043b\u0456 \u042f \u0445\u0430\u0447\u0443, \u043a\u0430\u0431 \u0451\u043d \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f, \u043f\u0430\u043a\u0443\u043b\u044c \u042f \u043f\u0440\u044b\u0439\u0434\u0443, \u0448\u0442\u043e \u0442\u0430\u0431\u0435 \u0434\u0430 \u0442\u0430\u0433\u043e? \u0422\u044b \u0456\u0434\u0437\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e&raquo; (\u042f\u043d 21, 22).<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043d\u0456\u0431\u044b\u0442\u0430 \u043a\u0430\u0436\u0430: &laquo;\u0422\u044b \u0456\u0434\u0437\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e \u0456 \u0432\u0430\u0437\u044c\u043c\u0456, \u044f\u043a \u042f, \u0437\u043b\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0430 \u0451\u043d \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0432\u044f\u0440\u043d\u0443\u0441\u044f, \u043a\u0430\u0431 \u0430\u0434\u043f\u043b\u0430\u0446\u0456\u0446\u044c \u044f\u043c\u0443 \u0432\u0435\u0447\u043d\u044b\u043c \u0434\u0430\u0431\u0440\u043e\u043c. \u041a\u0430\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u043b\u0430, \u0434\u044b\u043a \u043d\u044f\u0445\u0430\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u045e\u0447\u044b\u043d\u0430\u043a \u0456\u0434\u0437\u0435 \u0437\u0430 \u041c\u043d\u043e\u044e, \u0441\u0444\u0430\u0440\u043c\u0456\u0440\u0430\u0432\u0430\u043d\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u041c\u0430\u0451\u0439 \u043c\u0443\u043a\u0456, \u0443 \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435\u0446\u0446\u0430 \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u042f \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0443, \u043a\u0430\u0431 \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u0446\u044c \u044f\u0433\u043e&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0435\u0440\u0430\u0439\u043c\u0430\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430, \u0456\u0434\u0443\u0447\u044b \u0437\u0430 \u0406\u043c \u0434\u0430 \u0441\u0430\u043c\u0430\u0439 \u0441\u043c\u0435\u0440\u0446\u0456, &ndash; \u0432\u043e\u0441\u044c \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f. \u0422\u0440\u044b\u0432\u0430\u0446\u044c, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, &ndash; \u0433\u044d\u0442\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0432\u0435\u0434\u0430\u045e, \u044f\u043a\u0456\u044f \u0434\u0430\u0437\u0432\u043e\u043b\u044f\u0446\u044c \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u042f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u043b\u043e \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443 \u043c\u044b \u0446\u0435\u0440\u043f\u0456\u043c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b\u0445, \u0430 \u0442\u0430\u043c \u0443\u0431\u0430\u0447\u044b\u043c \u0434\u0430\u0431\u0440\u043e \u041f\u0430\u043d\u0430 \u045e \u043a\u0440\u0430\u0456\u043d\u0435 \u0436\u044b\u0432\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043b\u043e\u0432\u044b &laquo;\u0445\u0430\u0447\u0443, \u043a\u0430\u0431 \u0451\u043d \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f, \u043f\u0430\u043a\u0443\u043b\u044c \u042f \u043f\u0440\u044b\u0439\u0434\u0443&raquo; (\u042f\u043d 21, 23) \u043d\u0435 \u0442\u0440\u044d\u0431\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0431\u044b\u0446\u0446\u0430\u043c \u0431\u044b \u043c\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435 &laquo;\u0432\u044b\u0442\u0440\u044b\u0432\u0430\u0446\u044c&raquo; \u0446\u0456 &laquo;\u043f\u0435\u0440\u0430\u0446\u044f\u0440\u043f\u0435\u0446\u044c&raquo;, \u0430\u043b\u0435 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u043f\u0440\u0430 \u0447\u0430\u043a\u0430\u043d\u043d\u0435, \u0431\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0443\u0435 \u042f\u043d, \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u043d\u0435 \u0446\u044f\u043f\u0435\u0440, \u0430 \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0422\u043e\u0435 \u0436\u044b\u0446\u0446\u0451, \u0448\u0442\u043e \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0443\u0435 \u041f\u0451\u0442\u0440, \u044f\u043a\u043e\u043c\u0443 \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0406\u0434\u0437\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e&raquo; (\u042f\u043d 21, 22), \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u0446\u0430 \u0446\u044f\u043f\u0435\u0440, \u043a\u0430\u0431 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0441\u0432\u0430\u0451\u0439 \u043c\u044d\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u043d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0434\u0437\u044f\u043b\u044f\u0435 \u0433\u044d\u0442\u044b\u0445 \u0434\u0432\u0443\u0445 \u0441\u043b\u0430\u045e\u043d\u044b\u0445 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0431\u043e \u044f\u043d\u044b \u0430\u0431\u043e\u0434\u0432\u0430 \u0436\u044b\u043b\u0456 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u045e \u041f\u0451\u0442\u0440; \u0430 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u045e \u042f\u043d, \u0430\u0431\u043e\u0434\u0432\u0430 \u0431\u0443\u0434\u0443\u0446\u044c. \u041f\u0451\u0442\u0440 \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0437\u0430\u0432\u0430\u045e \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0430, \u0430 \u042f\u043d &ndash; \u0437\u043d\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u0435 \u045e \u0406\u043c. \u0410\u0431\u043e\u0434\u0432\u0430 \u0437 \u0432\u0435\u0440\u0430\u0439 \u0446\u044f\u0440\u043f\u0435\u043b\u0456 \u043d\u044f\u0433\u043e\u0434\u044b \u0447\u0430\u0441\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0430\u0431\u043e\u0434\u0432\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0447\u0430\u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0447\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u044f\u043d\u044b \u0430\u0434\u043d\u044b, \u0430\u043b\u0435 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0440\u043e\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430, \u0447\u0430\u043a\u0430\u044e\u0447\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u043d\u044f \u0437 \u0433\u044d\u0442\u044b\u0445 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e \u0456 \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u043d\u043d\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f. \u0413\u044d\u0442\u044b\u044f \u0434\u0432\u0430 \u0436\u044b\u0446\u0446\u0456 \u0432\u043e\u0431\u0440\u0430\u0437\u043d\u0430 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u041f\u0451\u0442\u0440 \u0456 \u042f\u043d, \u043a\u043e\u0436\u043d\u044b \u0441\u0432\u0430\u0451. \u0410\u0434\u043d\u0430\u043a \u0430\u0431\u043e\u0434\u0432\u0430 \u043d\u0430\u0440\u043e\u045e\u043d\u0456 \u0432\u0430\u043d\u0434\u0440\u0430\u0432\u0430\u043b\u0456 \u0437 \u0432\u0435\u0440\u0430\u0439 \u0443 \u0447\u0430\u0441\u043e\u0432\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u0456 \u0430\u0431\u043e\u0434\u0432\u0430 \u0431\u0443\u0434\u0443\u0446\u044c \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0431\u0430\u0447\u0430\u043d\u043d\u0435\u043c \u0411\u043e\u0433\u0430 \u045e \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0451\u0442\u0440, \u043f\u0435\u0440\u0448\u044b \u0437 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043a\u043b\u044e\u0447\u044b \u0430\u0434 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u0451\u043d \u0437\u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0446\u0456 \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0435 \u0433\u0440\u0430\u0445\u0456 \u045e\u0441\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445, \u044f\u043a\u0456\u044f \u043d\u0435\u0430\u0434\u0440\u044b\u045e\u043d\u0430 \u0437\u043b\u0443\u0447\u0430\u043d\u044b \u0437 \u0446\u0435\u043b\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c (\u043f\u0430\u0440. \u041c\u0446 16, 19), \u0456 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u043c \u043f\u0440\u0430\u0432\u0456\u043b\u044c\u043d\u044b \u0448\u043b\u044f\u0445 \u0441\u044f\u0440\u043e\u0434 \u0431\u0443\u0440\u043d\u044b\u0445 \u0445\u0432\u0430\u043b\u044f\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0414\u0437\u0435\u043b\u044f \u0442\u044b\u0445 \u0436\u0430 \u0441\u0432\u044f\u0442\u044b\u0445 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u0456\u0441\u0442 \u042f\u043d \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u045e \u043d\u0430 \u0433\u0440\u0443\u0434\u0437\u044f\u0445 \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u044f\u043d\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043d\u0430\u0439\u0433\u043b\u044b\u0431\u0435\u0439\u0448\u044b \u0441\u043f\u0430\u043a\u043e\u0439 \u0441\u0430\u043c\u0430\u0433\u0430 \u0442\u0430\u0435\u043c\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u041f\u0451\u0442\u0440, \u0430\u043b\u0435 \u0456 \u045e\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u0437\u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0446\u0456 \u0430\u0434\u043f\u0443\u0441\u043a\u0430\u0435 \u0433\u0440\u0430\u0445\u0456. \u0406 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u042f\u043d \u0447\u044d\u0440\u043f\u0430\u045e \u0437 \u043a\u0440\u044b\u043d\u0456\u0446\u044b \u0441\u044d\u0440\u0446\u0430 \u041f\u0430\u043d\u0430, \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u045e \u0456 \u043f\u0430\u0448\u044b\u0440\u0430\u045e \u0442\u044b\u044f \u045e\u0437\u043d\u0451\u0441\u043b\u044b\u044f \u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0440\u0430 \u0421\u043b\u043e\u0432\u0430, \u044f\u043a\u043e\u0435 \u0431\u044b\u043b\u043e \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443, \u0456 \u0431\u044b\u043b\u043e \u045e \u0411\u043e\u0433\u0430, \u0456 \u0431\u044b\u043b\u043e \u0411\u043e\u0433\u0430\u043c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043f\u0440\u0430 \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u044b\u0445 \u0410\u0441\u043e\u0431 \u0422\u0440\u043e\u0439\u0446\u044b. \u0426\u044f\u043f\u0435\u0440 \u043c\u044b \u0431\u0430\u0447\u044b\u043c \u0433\u044d\u0442\u044b\u044f \u043f\u0440\u0430\u045e\u0434\u044b \u0446\u044c\u043c\u044f\u043d\u0430, \u0431\u044b\u0446\u0446\u0430\u043c \u0443 \u043b\u044e\u0441\u0442\u044d\u0440\u043a\u0443, \u0430\u043b\u0435 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u041f\u0430\u043d, \u0443\u0431\u0430\u0447\u044b\u043c \u0442\u0432\u0430\u0440\u0430\u043c \u0443 \u0442\u0432\u0430\u0440. \u0421\u0430\u043c \u041f\u0430\u043d \u0440\u0430\u0437\u043b\u0456\u045e \u0441\u0432\u0430\u0451 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435, \u0456 \u043a\u043e\u0436\u043d\u044b \u043c\u043e\u0436\u0430 \u0447\u044d\u0440\u043f\u0430\u0446\u044c \u0456 \u043f\u0456\u0446\u044c \u0437 \u044f\u0433\u043e, \u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u0434\u043e\u043b\u0435\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. 1 \u041f 5, 10; 2 \u041a\u0430\u0440 4, 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u044f\u043a\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0432\u0430\u0441 \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435, <span style=\"color: #ff0000;\">*<\/span> \u043f\u0430\u0441\u043b\u044f \u0441\u0430\u043c \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u0446\u044c, \u0437\u0430\u0433\u0430\u0440\u0442\u0443\u0435 \u0456 \u045e\u043c\u0430\u0446\u0443\u0435 \u0432\u0430\u0441, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u043e\u0439, \u0445\u0442\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0415\u0437\u0443\u0441\u0430, \u0456 \u043d\u0430\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0441\u043b\u044f \u0441\u0430\u043c \u0443\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0456\u0446\u044c, \u0437\u0430\u0433\u0430\u0440\u0442\u0443\u0435 \u0456 \u045e\u043c\u0430\u0446\u0443\u0435 \u0432\u0430\u0441, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5071","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <br \/>&laquo;\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u041f\u0435\u0441\u043d\u0456 \u043f\u0435\u0441\u043d\u044f\u045e&raquo; \u0441\u0432. \u0413\u0440\u044b\u0433\u043e\u0440\u044b\u044f \u0437 \u041d\u0456\u0441\u044b, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Hom. 15: PG 44, 1115-1118)<\/span><br \/><span style=\"color: #ff0000;\">\u0421\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u0422\u044b \u0434\u0430\u045e \u041c\u043d\u0435, \u042f \u0434\u0430\u045e \u0406\u043c<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u043b\u044e\u0431\u043e\u045e \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0435\u0440\u0430\u0430\u0434\u043e\u043b\u044c\u0432\u0430\u0435 \u0441\u0442\u0440\u0430\u0445, \u0456 \u0451\u043d \u043f\u0430\u0441\u043b\u044f \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0430\u0435\u0446\u0446\u0430 \u045e \u043b\u044e\u0431\u043e\u045e, \u0442\u0430\u0434\u044b \u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0446\u0446\u0430, \u0448\u0442\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u045e \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0435. \u0417\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u043d\u0430\u0441\u0430\u043c\u0440\u044d\u0447, \u0443 \u0442\u044b\u043c, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u043b\u0456 \u0441\u044f\u0431\u0435 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b\u043c\u0456 \u045e \u043b\u044e\u0431\u043e\u0432\u0456 \u0437 \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0434\u043e\u0431\u0440\u043e\u043c \u043f\u0440\u044b \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0442\u043e\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456, \u044f\u043a\u0430\u044f \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u0441\u043b\u044b\u043d\u043d\u0430\u0439 \u0433\u0430\u043b\u0443\u0431\u0446\u044b \u0437 \u043a\u043d\u0456\u0433\u0456 \u041f\u0435\u0441\u043d\u0456 \u043f\u0435\u0441\u043d\u044f\u045e. \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0410\u0434\u043d\u0430 \u043c\u0430\u044f \u0433\u0430\u043b\u0443\u0431\u043a\u0430, \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f \u043c\u0430\u044f. \u042f\u043d\u0430 \u0430\u0434\u043d\u0430 \u0434\u043b\u044f \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u0446\u0456, \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u044f \u0434\u043b\u044f \u0442\u043e\u0439, \u0448\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u044f\u0435&raquo; (\u041f\u043f 6, 9).<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0451 \u0433\u044d\u0442\u0430 \u041f\u0430\u043d \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u045e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456. \u0415\u0437\u0443\u0441 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e, \u043d\u0430\u0434\u0437\u044f\u043b\u044f\u0435 \u0456\u0445 \u043f\u0430\u045e\u043d\u0430\u0442\u043e\u0439 \u0443\u043b\u0430\u0434\u044b \u0456 \u0434\u0430\u0435 \u0456\u043c \u0443\u0441\u0435 \u0441\u0432\u0430\u0435 \u0434\u0430\u0431\u0440\u043e\u0442\u044b. \u0422\u0440\u044d\u0431\u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0437\u0433\u0430\u0434\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u044b\u044f \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u043c\u0456 \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0410\u0439\u0446\u0430. \u0410\u043b\u0435 \u0441\u044f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u0441\u043b\u043e\u045e, \u044f\u043a\u0456\u044f \u043a\u0430\u0436\u0430, \u0456 \u0441\u044f\u0440\u043e\u0434 \u043b\u0430\u0441\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u045e\u0434\u0437\u044f\u043b\u044f\u0435, \u0451\u0441\u0446\u044c \u0430\u0434\u043d\u043e \u043d\u0430\u0439\u0432\u0430\u0436\u043d\u0435\u0439\u0448\u0430\u0435, \u0448\u0442\u043e \u044f\u043a \u0431\u044b \u043f\u0430\u0434\u0441\u0443\u043c\u043e\u045e\u0432\u0430\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0435. \u0413\u044d\u0442\u0430 \u0441\u043b\u043e\u0432\u044b, \u044f\u043a\u0456\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u0432\u0443\u0447\u0430\u0435 \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0442\u0440\u044b\u0432\u0430\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u043f\u0440\u044b \u0432\u044b\u0440\u0430\u0448\u044d\u043d\u043d\u0456 \u043f\u044b\u0442\u0430\u043d\u043d\u044f\u045e \u0456 \u045e \u0430\u0446\u044d\u043d\u0446\u044b \u0434\u0430\u0431\u0440\u0430, \u044f\u043a\u043e\u0435 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0437\u0440\u0430\u0431\u0456\u0446\u044c; \u043c\u0435\u0446\u044c \u0430\u0434\u043d\u043e \u0441\u044d\u0440\u0446\u0430 \u0456 \u0430\u0434\u043d\u0443 \u0434\u0443\u0448\u0443 \u0456 \u0440\u0430\u0437\u0433\u043b\u044f\u0434\u0430\u0446\u044c \u0433\u044d\u0442\u0443\u044e \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u044f\u043a \u0430\u0434\u0437\u0456\u043d\u0430\u0435 \u0434\u0430\u0431\u0440\u043e; \u0437\u043b\u0443\u0447\u0430\u0446\u0446\u0430 \u045e \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0456 \u043f\u043e\u0432\u044f\u0437\u0456 \u0441\u043f\u0430\u043a\u043e\u044e, \u0443\u0442\u0432\u0430\u0440\u0430\u0446\u044c \u0430\u0434\u043d\u043e \u0446\u0435\u043b\u0430 \u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u0434\u0443\u0445\u0430; \u0440\u0430\u0437\u0430\u043c \u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u043d\u0430 \u0430\u0434\u043d\u043e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0456 \u0431\u044b\u0446\u044c \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u043c\u0456 \u0430\u0434\u043d\u043e\u0439 \u043d\u0430\u0434\u0437\u0435\u044f\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u043b\u0435\u043f\u0448 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0430\u0441\u043b\u0430\u0446\u0446\u0430 \u043d\u0430 \u0411\u043e\u0436\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0441\u0430\u043c\u043e\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f: &laquo;\u041a\u0430\u0431 \u0443\u0441\u0435 \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e, \u044f\u043a \u0422\u044b, \u041e\u0439\u0447\u0430, \u0443\u0432\u0430 \u041c\u043d\u0435, \u0456 \u042f \u045e \u0422\u0430\u0431\u0435, \u043a\u0430\u0431 \u0456 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u045e \u041d\u0430\u0441, \u043a\u0430\u0431 \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0441\u0432\u0435\u0442, \u0448\u0442\u043e \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u041c\u044f\u043d\u0435&raquo; (\u042f\u043d 17, 21).<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u0441\u043b\u0430\u0432\u0430. \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0430\u0441\u043f\u0440\u044d\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u045e\u0441\u044f &laquo;\u0441\u043b\u0430\u0432\u0430\u0439&raquo;. \u0422\u0430\u043a, \u041f\u0430\u043d \u043a\u0430\u0436\u0430: &laquo;\u0421\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u0422\u044b \u0434\u0430\u045e \u041c\u043d\u0435, \u042f \u0434\u0430\u045e \u0456\u043c&raquo; (\u042f\u043d 17, 22). \u0406 \u0401\u043d \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0434\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u043c \u0442\u0443\u044e \u0436 \u0441\u043b\u0430\u0432\u0443, \u043a\u0430\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043f\u0440\u0430\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443, \u0415\u0437\u0443\u0441 \u043f\u0440\u044b\u043d\u044f\u045e \u0442\u0443\u044e \u0441\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u043c\u0435\u045e \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u043d\u0430\u0432\u0430\u0442 \u0434\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443 \u044f\u043d\u0430 \u0431\u044b\u043b\u0430 \u045e\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u044f, \u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0437\u0432\u044f\u0437\u0430\u043d\u0430 \u0437 \u0433\u044d\u0442\u0430\u0439 \u0441\u043b\u0430\u0432\u0430\u0439, \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u0437 \u0443\u0434\u0437\u0435\u043b \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u041f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u0433\u044d\u0442\u0430\u0439 \u0441\u043b\u0430\u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0433\u044d\u0442\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043a\u0430\u0436\u0430: &laquo;\u0421\u043b\u0430\u0432\u0443, \u044f\u043a\u0443\u044e \u0422\u044b \u0434\u0430\u045e \u041c\u043d\u0435, \u042f \u0434\u0430\u045e \u0456\u043c, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u043d\u043e, \u044f\u043a \u0456 \u041c\u044b \u0430\u0434\u043d\u043e. \u042f \u045e \u0456\u0445, \u0430 \u0422\u044b \u045e\u0432\u0430 \u041c\u043d\u0435. \u041a\u0430\u0431 \u0431\u044b\u043b\u0456 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u045e \u0430\u0434\u043d\u043e&raquo; (\u042f\u043d 17, 22-23). \u0422\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u0437 \u0434\u0437\u0456\u0446\u044f\u0446\u0456 \u0432\u044b\u0440\u0430\u0441 \u0443 \u043c\u0443\u0436\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430, \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u045e\u0448\u044b \u043f\u043e\u045e\u043d\u0430\u0439 \u0441\u0442\u0430\u043b\u0430\u0441\u0446\u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u0430\u043f\u044b\u043d\u0430\u0435\u0446\u0446\u0430 \u045e \u0442\u0430\u043a\u0456\u043c \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u043c \u0441\u0442\u0430\u043d\u0435, \u044f\u043a\u0456 \u043c\u043e\u0436\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0440\u043e\u0437\u0443\u043c, \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b \u0432\u0435\u0440\u0430\u0439. \u041d\u0430\u0440\u044d\u0448\u0446\u0435, \u0451\u043d \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u043c \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0441\u043b\u0430\u0432\u0443 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u043c\u0443 \u0436\u044b\u0446\u0446\u044e \u0456 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0433\u044d\u0442\u0430 \u0456 \u0451\u0441\u0446\u044c \u0442\u0430\u044f \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f \u0433\u0430\u043b\u0443\u0431\u043a\u0430, \u043d\u0430 \u044f\u043a\u0443\u044e \u043f\u0430\u0437\u0456\u0440\u0430\u0435 \u043c\u0430\u043b\u0430\u0434\u044b, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0410\u0434\u0437\u0456\u043d\u0430\u044f \u0433\u0430\u043b\u0443\u0431\u043a\u0430 \u043c\u0430\u044f, \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u044f \u043c\u0430\u044f&raquo;.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042f\u043d 15, 15; 14, 26; 15, 14<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0436\u043e \u043d\u0435 \u043d\u0430\u0437\u044b\u0432\u0430\u044e \u0432\u0430\u0441 \u0441\u043b\u0443\u0433\u0430\u043c\u0456, \u0430\u043b\u0435 \u0441\u044f\u0431\u0440\u0430\u043c\u0456 \u041c\u0430\u0456\u043c\u0456; \u0431\u043e \u0432\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u042f \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0421\u0443\u0446\u044f\u0448\u044b\u0446\u0435\u043b\u044f, \u044f\u043a\u043e\u0433\u0430 \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0448\u043b\u0435 \u0432\u0430\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b \u0441\u044f\u0431\u0440\u044b \u041c\u0430\u0435, \u043a\u0430\u043b\u0456 \u0440\u043e\u0431\u0456\u0446\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e \u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u044b\u043c\u0456\u0446\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0421\u0443\u0446\u044f\u0448\u044b\u0446\u0435\u043b\u044f, \u044f\u043a\u043e\u0433\u0430 \u0410\u0439\u0446\u0435\u0446 \u043f\u0430\u0448\u043b\u0435 \u0432\u0430\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5072","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0442\u044d\u0445\u0435\u0437\u0430 \u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cat. 16, De Spiritu Sancto 1, 11-12. 16: PG 33, 931-935. 939-942)<\/span><br \/><span style=\"color: #ff0000;\">\u0416\u044b\u0432\u0430\u044f \u0432\u0430\u0434\u0430 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0412\u0430\u0434\u0430, \u044f\u043a\u0443\u044e \u0434\u0430\u043c \u044f\u043c\u0443, \u0441\u0442\u0430\u043d\u0435 \u045e \u0456\u043c \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0432\u0430\u0434\u044b, \u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435&raquo; (\u042f\u043d 4, 14). \u0413\u044d\u0442\u0430 \u043d\u043e\u0432\u044b \u0440\u043e\u0434 \u0432\u0430\u0434\u044b, \u044f\u043a\u0430\u044f \u0436\u044b\u0432\u0435 \u0456 \u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0456\u0446\u044c, \u0456 \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0430 \u0433\u043e\u0434\u043d\u044b\u0445. \u0427\u0430\u043c\u0443 \u0436 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u043a\u0440\u044d\u0441\u043b\u0456\u0432\u0430\u0435 \u043b\u0430\u0441\u043a\u0443 \u0414\u0443\u0445\u0430 \u043f\u0440\u0430\u0437 \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043d\u043d\u0435 \u0437 \u0432\u0430\u0434\u043e\u044e? \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u045e\u0441\u0451 \u0456\u0441\u043d\u0443\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0432\u0430\u0434\u0437\u0435. \u0412\u0430\u0434\u0430 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0436\u044b\u0446\u0446\u0451\u043c \u0440\u0430\u0441\u043b\u0456\u043d\u044b \u0456 \u0436\u044b\u0432\u0451\u043b\u044b, \u0432\u0430\u0434\u0430 \u0456\u0434\u0437\u0435 \u0437 \u043d\u0435\u0431\u0430 \u045e \u0432\u044b\u0433\u043b\u044f\u0434\u0437\u0435 \u0434\u0430\u0436\u0434\u0436\u0443. \u0412\u0430\u0434\u0430 \u043f\u0430\u0434\u0430\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430 \u0456 \u045e \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430\u0439 \u0444\u043e\u0440\u043c\u0435, \u0430\u0434\u043d\u0430\u043a \u044f\u043d\u0430 \u0434\u0430\u0435 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u044f \u0432\u044b\u043d\u0456\u043a\u0456: \u0430\u0434\u0437\u0456\u043d &ndash; \u0443 \u043f\u0430\u043b\u044c\u043c\u0430\u0445, \u0434\u0440\u0443\u0433\u0456 &ndash; \u0443 \u0432\u0456\u043d\u0430\u0433\u0440\u0430\u0434\u0437\u0435 \u0456 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0456\u043d\u0448\u044b\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445, \u0431\u043e \u044f\u043d\u0430 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043c\u0430\u0435 \u0430\u0434\u0437\u0456\u043d\u0443\u044e \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0456 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0446\u0446\u0430 \u0430\u0434 \u0441\u0430\u043c\u043e\u0439 \u0441\u044f\u0431\u0435. \u041d\u0430\u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u0434\u043e\u0436\u0434\u0436 \u043d\u0435 \u0431\u044b\u0432\u0430\u0435 \u0440\u043e\u0437\u043d\u044b\u043c \u0456 \u043d\u0435 \u0430\u0434\u0440\u043e\u0437\u043d\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u0430\u043b\u0435 \u043f\u0440\u044b\u0441\u0442\u0430\u0441\u043e\u045e\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0431\u0443\u0434\u0437\u0435 \u044f\u0433\u043e \u043f\u0440\u044b\u043c\u0430\u0446\u044c, \u0456 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0434\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u044f\u043c\u0443 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0436\u0430 \u0447\u044b\u043d\u0430\u043c \u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u0431\u0443\u0434\u0443\u0447\u044b \u0430\u0434\u043d\u044b\u043c, \u0430\u0434\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u043c \u0456 \u043d\u0435\u043f\u0430\u0434\u0437\u0435\u043b\u044c\u043d\u044b\u043c, \u0440\u0430\u0437\u0434\u0430\u0435 \u045e\u0441\u0456\u043c \u043b\u0430\u0441\u043a\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0433\u0430 \u0436\u0430\u0434\u0430\u043d\u043d\u044f. \u0406 \u044f\u043a \u0441\u0443\u0445\u043e\u0435 \u0434\u0440\u044d\u0432\u0430, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0432\u0430\u0434\u0443, \u043f\u0443\u0441\u043a\u0430\u0435 \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0456, \u0442\u0430\u043a \u0456 \u0433\u0440\u044d\u0448\u043d\u0430\u044f \u0434\u0443\u0448\u0430, \u043a\u0430\u043b\u0456 \u043f\u0440\u0430\u0437 \u043f\u0430\u043a\u0443\u0442\u0443 \u0441\u0442\u0430\u043d\u0435 \u0433\u043e\u0434\u043d\u0430\u0439 \u0434\u0430\u0440\u0443 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u043b\u0430\u0434\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435 \u0437 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456 \u0456 \u045e \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043c\u0443 \u045e\u0434\u0437\u044f\u043b\u044f\u0435 \u0434\u0430\u0440 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0441\u043b\u043e\u0432\u0430, \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0430\u0434\u043e\u0440\u0432\u0430\u0435 \u043f\u0440\u0430\u0440\u043e\u0446\u043a\u0456\u043c \u0431\u0430\u0447\u0430\u043d\u043d\u0435\u043c, \u0456\u043d\u0448\u0430\u043c\u0443 \u0434\u0430\u0435 \u045e\u043b\u0430\u0434\u0443 \u0432\u044b\u0433\u0430\u043d\u044f\u0446\u044c \u0437\u043b\u044b\u0445 \u0434\u0443\u0445\u0430\u045e, \u044f\u0448\u0447\u044d \u043d\u0435\u043a\u0430\u043c\u0443 \u043b\u0430\u0441\u043a\u0443 \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435. \u0410\u0434\u043d\u0430\u0433\u043e \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u0434\u0430\u0440\u0430\u043c \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0441\u0446\u0456, \u0434\u0440\u0443\u0433\u043e\u0433\u0430 \u0432\u0443\u0447\u044b\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u0456; \u0430\u0434\u043d\u0430\u0433\u043e \u0432\u0443\u0447\u044b\u0446\u044c \u0432\u044b\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u043f\u043e\u0441\u0442 \u0456 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u0456 \u0430\u0441\u043a\u0435\u0442\u044b\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f; \u0434\u0440\u0443\u0433\u043e\u0433\u0430 &ndash; \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0446\u044c \u0436\u0430\u0434\u0430\u043d\u043d\u044f\u043c\u0456 \u0446\u0435\u043b\u0430; \u0456\u043d\u0448\u0430\u0433\u0430 \u0440\u044b\u0445\u0442\u0443\u0435 \u0434\u0430 \u043f\u0430\u043a\u0443\u0442\u043d\u0456\u0446\u0442\u0432\u0430. \u0420\u043e\u0437\u043d\u044b \u045e \u0440\u043e\u0437\u043d\u044b\u0445, \u0430\u043b\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0434\u0437\u0456\u043d\u044b \u045e \u0441\u0432\u0430\u0451\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456, \u044f\u043a \u043a\u0430\u0436\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u0435: &laquo;\u041a\u043e\u0436\u043d\u0430\u043c\u0443 \u0434\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u043d\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c&raquo; (1 \u041a\u0430\u0440 12, 7).<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u0433\u043e \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0446\u0456\u0445\u0430\u0435 \u0456 \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0435, \u0441\u0430\u043b\u043e\u0434\u043a\u0456 \u0456 \u0434\u0443\u0445\u043c\u044f\u043d\u044b \u042f\u0433\u043e \u0432\u043e\u0434\u0430\u0440, \u043b\u0451\u0433\u043a\u0430\u0435 \u044f\u0440\u043c\u043e. \u042f\u0433\u043e\u043d\u0430\u043c\u0443 \u043f\u0440\u044b\u0439\u0441\u0446\u044e \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u0456\u0447\u0430\u044e\u0446\u044c \u043f\u0440\u043e\u043c\u043d\u0456 \u0441\u0432\u044f\u0442\u043b\u0430 \u0456 \u0432\u0435\u0434\u0430\u045e. \u0401\u043d \u043f\u0440\u044b\u0431\u044b\u0432\u0430\u0435 \u044f\u043a \u0431\u0440\u0430\u0442\u044d\u0440\u0441\u043a\u0456 \u0430\u043f\u044f\u043a\u0443\u043d \u043d\u0430\u0448\u0430\u0433\u0430 \u043d\u0443\u0442\u0440\u0430, \u0431\u043e \u0401\u043d \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u044f\u0446\u044c, \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u0446\u044c, \u0432\u0443\u0447\u044b\u0446\u044c, \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0446\u044c, \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0446\u044c, \u0441\u0443\u0446\u044f\u0448\u0430\u0446\u044c, \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0446\u044c \u0440\u043e\u0437\u0443\u043c \u043d\u0430\u0439\u043f\u0435\u0440\u0448 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u042f\u0433\u043e \u043f\u0440\u044b\u043c\u0430\u0435, \u0430 \u043f\u043e\u0442\u044b\u043c, \u043f\u0440\u0430\u0437 \u044f\u0433\u043e \u0456 \u0456\u043d\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0441\u043e\u043d\u0446\u0430 \u0437&rsquo;\u044f\u0432\u0456\u0446\u0446\u0430 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u0440\u0430\u043d\u0435\u0439 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u045e\u0441\u044f \u045e \u0437\u043c\u0440\u043e\u043a\u0443, \u0451\u043d \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u043b\u044f \u0441\u0432\u0430\u0456\u0445 \u0446\u044f\u043b\u0435\u0441\u043d\u044b\u0445 \u0432\u0430\u0447\u044d\u0439 \u0456 \u0432\u044b\u0440\u0430\u0437\u043d\u0430 \u0431\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u0440\u0430\u043d\u0435\u0439 \u043d\u0435 \u0431\u0430\u0447\u044b\u045e. \u0422\u0430\u043a \u0456 \u0442\u043e\u0439, \u0445\u0442\u043e \u0430\u043a\u0430\u0437\u0430\u045e\u0441\u044f \u0433\u043e\u0434\u043d\u044b\u043c \u0434\u0430\u0440\u0443 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0430\u0441\u0432\u044f\u0447\u0430\u0435\u0446\u0446\u0430 \u045e \u0434\u0443\u0448\u044b \u0456, \u0443\u0437\u043d\u0435\u0441\u0435\u043d\u044b \u0432\u044b\u0448\u044d\u0439 \u0437\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c, \u0431\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 12, 6-7. 27<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0420\u043e\u0437\u043d\u044b\u044f \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456, \u0430\u043b\u0435 \u0430\u0434\u0437\u0456\u043d \u0456 \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0411\u043e\u0433, \u044f\u043a\u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u0443\u0441\u0451 \u0432\u0430 \u045e\u0441\u0456\u0445.<span style=\"color: #ff0000;\"> *<\/span> \u041a\u043e\u0436\u043d\u0430\u043c\u0443 \u0434\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u043d\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b \u0436 &ndash; \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0435, \u0430 \u043f\u0430\u0430\u0441\u043e\u0431\u043a\u0443 &ndash; \u0447\u0430\u0441\u0442\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u043e\u0436\u043d\u0430\u043c\u0443 \u0434\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u043d\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5073","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430&raquo; \u0441\u0432. \u0411\u0430\u0437\u044b\u043b\u044f \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Cap. 9, 22-23: PG 32, 107-110)<\/span><br \/><span style=\"color: #ff0000;\">\u0414\u0437\u0435\u044f\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u0451\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u043e\u0433\u0430 \u0456\u043c\u0451\u043d\u044b \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043d\u0435 \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u044e\u0446\u044c \u0443 \u0434\u0443\u0445\u0443 \u0456 \u043d\u0435 \u0441\u0445\u0456\u043b\u044f\u044e\u0446\u044c \u0434\u0430 \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u043d\u043d\u044f\u045e \u043d\u0430\u0434 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u044e? \u0411\u043e \u0401\u043d \u0437\u0430\u0432\u0435\u0446\u0446\u0430 \u0414\u0443\u0445\u0430\u043c \u0411\u043e\u0436\u044b\u043c, \u0414\u0443\u0445\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a\u0456 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0410\u0439\u0446\u0430, \u0414\u0443\u0445\u0430\u043c \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u044b\u043c, \u0433\u0430\u043b\u043e\u045e\u043d\u044b\u043c \u0414\u0443\u0445\u0430\u043c. \u0410 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b &ndash; \u0433\u044d\u0442\u0430 \u042f\u0433\u043e \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0435 \u0456\u043c\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430 \u042f\u0433\u043e \u0437\u0432\u044f\u0440\u0442\u0430\u044e\u0446\u0446\u0430 \u045e\u0441\u0435, \u0445\u0442\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f; \u0434\u0430 \u042f\u0433\u043e \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u045e\u0441\u0435, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u0430. \u0421\u0432\u0430\u0456\u043c \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0435\u043c \u0401\u043d \u043f\u043e\u0456\u0446\u044c \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0456\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u0434\u0430\u0439\u0448\u043b\u0456 \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0443\u043b\u0430\u0441\u0446\u0456\u0432\u0430\u0439 \u0456 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u0430\u0439 \u043c\u044d\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430 \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u043b\u044f \u0440\u043e\u0437\u0443\u043c\u0443. \u041a\u043e\u0436\u043d\u0430\u0439 \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0439 \u0456\u0441\u0442\u043e\u0446\u0435 \u0401\u043d \u0434\u0430\u0435 \u044f\u043a \u0431\u044b \u0441\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u043b\u044f \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435\u0434\u0430\u0441\u0442\u0443\u043f\u043d\u044b \u045e \u0441\u0432\u0430\u0451\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0401\u043d \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0441\u0445\u0430\u043f\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0451\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456. \u0401\u043d \u0443\u0441\u0451 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0441\u0432\u0430\u0451\u0439 \u043c\u043e\u0446\u0430\u0439, \u0430\u043b\u0435 \u0434\u0430\u0435 \u0441\u044f\u0431\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u0430\u0440\u0442\u044b\u043c \u0433\u044d\u0442\u0430\u0433\u0430. \u0414\u0430\u0435 \u0441\u044f\u0431\u0435 \u043d\u0435 \u045e \u0430\u0434\u043d\u043e\u043b\u044c\u043a\u0430\u0432\u0430\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456, \u0430\u043b\u0435 \u043f\u0430 \u0432\u0435\u0440\u044b \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u045e\u0434\u0437\u044f\u043b\u044f\u0435 \u0456\u043c \u0441\u0432\u0430\u044e \u0441\u0456\u043b\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0442\u044b \u045e \u0441\u0432\u0430\u0451\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456, \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0434\u0437\u0435\u044f\u043d\u043d\u044f, \u0401\u043d \u0443\u0441\u0451\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044e \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0456 \u045e\u0441\u0451\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u043f\u0430\u045e\u0441\u044e\u043b\u044c. \u0401\u043d \u0440\u0430\u0437\u0434\u0430\u0435 \u0441\u044f\u0431\u0435 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0442\u0430\u043a, \u0448\u0442\u043e \u0441\u0430\u043c \u043d\u0435 \u0437\u0430\u0437\u043d\u0430\u0435 \u0441\u0442\u0440\u0430\u0442\u044b; \u0443\u0441\u0435 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u044e\u0446\u044c \u0443 \u0406\u043c \u0442\u0430\u043a, \u0448\u0442\u043e \u0401\u043d \u0441\u0430\u043c \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u0430\u043d\u044b\u043c. \u0422\u0430\u043a\u0456\u043c \u0436\u0430 \u0447\u044b\u043d\u0430\u043c \u0456 \u0441\u043e\u043d\u0435\u0447\u043d\u044b \u043f\u0440\u0430\u043c\u0435\u043d\u044c \u0437\u0437\u044f\u0435 \u043a\u043e\u0436\u043d\u0430\u043c\u0443, \u0456 \u043a\u043e\u0436\u043d\u044b \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0456\u043c, \u0431\u044b\u0446\u0446\u0430\u043c \u0451\u043d \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u044f\u0433\u043e \u0430\u0434\u043d\u0430\u0433\u043e, \u0430\u043b\u0435 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0441\u043e\u043d\u0435\u0447\u043d\u044b \u043f\u0440\u0430\u043c\u0435\u043d\u044c \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0437\u044f\u043c\u043b\u044e \u0456 \u043c\u043e\u0440\u0430 \u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u0437\u0437\u044f\u043d\u043d\u0435\u043c \u043f\u0440\u0430\u0441\u0442\u043e\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0456\u0447\u0430\u0435 \u045e \u043a\u043e\u0436\u043d\u044b\u043c, \u0445\u0442\u043e \u0437\u0434\u043e\u043b\u044c\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u042f\u0433\u043e, \u044f\u043a \u0431\u044b \u045e \u0430\u0434\u043d\u044b\u043c, \u0456 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0434\u0430\u0435 \u0434\u0430\u0441\u0442\u0430\u0442\u043a\u043e\u0432\u0443\u044e \u0456 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0443\u044e \u043b\u0430\u0441\u043a\u0443 \u045e\u0441\u0456\u043c. \u0422\u044b\u043c, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u0434\u0437\u0435\u043b \u0443 \u042f\u0433\u043e\u043d\u0430\u0439 \u043b\u0430\u0441\u0446\u044b, \u0434\u0430\u0435 \u0441\u044f\u0431\u0435 \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456, \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435 \u0456\u0445 \u0443\u043b\u0430\u0441\u043d\u0430\u044f \u043d\u0430\u0442\u0443\u0440\u0430, \u0430 \u043d\u0435 \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u043c\u043e\u0436\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u042f\u043c\u0443 \u0441\u044d\u0440\u0446\u044b \u045e\u0437\u043d\u043e\u0441\u044f\u0446\u0446\u0430 \u045e\u0433\u043e\u0440\u0443, \u043f\u0430\u0434\u044b\u043c\u0430\u044e\u0446\u0446\u0430 \u043d\u044f\u0434\u0443\u0436\u044b\u044f \u0440\u0443\u043a\u0456 \u0456 \u045e\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044c\u0432\u0430\u044e\u0446\u0446\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0456\u043c\u043a\u043d\u0435 \u043d\u0430\u043f\u0435\u0440\u0430\u0434. \u0401\u043d \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0447\u044b\u0441\u0446\u0456\u045e\u0441\u044f \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0431\u0440\u0443\u0434\u0443; \u0456 \u043f\u0440\u0430\u0437 \u0435\u0434\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0443\u044e \u043c\u0430\u0435 \u0437 \u0456\u043c\u0456, \u0440\u043e\u0431\u0456\u0446\u044c \u0456\u0445 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c\u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u044f\u043a \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u044b\u044f \u0456 \u043d\u0430\u0439\u0441\u0432\u044f\u0442\u043b\u0435\u0439\u0448\u044b\u044f \u0446\u0435\u043b\u044b, \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u045e\u0448\u044b \u043f\u0430\u0434 \u043f\u0440\u043e\u043c\u0435\u043d\u044c \u0441\u0432\u044f\u0442\u043b\u0430, \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0431\u043b\u0456\u0441\u043a\u0443\u0447\u044b\u043c\u0456 \u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u044e\u0446\u044c \u0441\u0432\u0430\u0456\u043c \u0437\u0437\u044f\u043d\u043d\u0435\u043c \u0456\u043d\u0448\u044b\u0445, \u0442\u0430\u043a \u0456 \u0434\u0443\u0448\u044b, \u044f\u043a\u0456\u044f \u043d\u043e\u0441\u044f\u0446\u044c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u044e\u0446\u0446\u0430 \u0414\u0443\u0445\u0430\u043c \u0456 \u0441\u0430\u043c\u0456 \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c\u0456, \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u044e\u0447\u044b \u043b\u0430\u0441\u043a\u0430\u044e \u0456\u043d\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0442\u0443\u043b\u044c \u0431\u044f\u0440\u044d\u0446\u0446\u0430 \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u044f\u0435 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u0456, \u043f\u0430\u0433\u043b\u044b\u0431\u043b\u0435\u043d\u043d\u0435 \u045e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 \u045e\u043a\u0440\u044b\u0442\u0430\u0433\u0430, \u0443\u0434\u0437\u044f\u043b\u0435\u043d\u043d\u0435 \u0434\u0430\u0440\u043e\u045e, \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0456 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u044f \u0437 \u0430\u043d\u0451\u043b\u0430\u043c\u0456 \u0432\u0435\u0441\u044f\u043b\u043e\u0441\u0446\u044c. \u0410\u0434\u0442\u0443\u043b\u044c \u0431\u044f\u0440\u044d\u0446\u0446\u0430 \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0442\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c \u0443 \u0411\u043e\u0433\u0443 \u0456 \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u0435\u043d\u043d\u0435 \u0434\u0430 \u042f\u0433\u043e, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u044f\u043a\u0456\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456, &ndash; \u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0441\u0446\u044c \u0441\u0442\u0430\u0446\u044c \u044f\u043a \u0411\u043e\u0433.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042f\u043d 14, 27b; 16, 22b; 14, 16\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0442\u0440\u044b\u0432\u043e\u0436\u044b\u0446\u0446\u0430 \u0441\u044d\u0440\u0446\u0430 \u0432\u0430\u0448\u0430\u0435: \u042f \u0456\u0434\u0443 \u0434\u0430 \u0410\u0439\u0446\u0430, \u0456 \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u0437\u0430\u0431\u0440\u0430\u043d\u044b \u0430\u0434 \u0432\u0430\u0441, \u0441\u043f\u0430\u0448\u043b\u044e \u0432\u0430\u043c \u0414\u0443\u0445\u0430 \u043f\u0440\u0430\u045e\u0434\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u045e\u0437\u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0432\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u043f\u0430\u043f\u0440\u0430\u0448\u0443 \u0410\u0439\u0446\u0430, \u0456 \u0401\u043d \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c \u0456\u043d\u0448\u0430\u0433\u0430 \u0421\u0443\u0446\u044f\u0448\u044b\u0446\u0435\u043b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u045e\u0437\u0440\u0430\u0434\u0443\u0435\u0446\u0446\u0430 \u0432\u0430\u0448\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5074","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0430\u0433\u043c\u0430\u0442\u044b\u0447\u043d\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u041a\u0430\u0441\u0446\u0451\u043b &laquo;Lumen gentium&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 4 et 12)<\/span><br \/><span style=\"color: #ff0000;\">\u041c\u0456\u0441\u0456\u044f \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u0441\u043f\u0440\u0430\u0432\u0430, \u044f\u043a\u0443\u044e \u0410\u0439\u0446\u0435\u0446 \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u0421\u044b\u043d\u0443 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 (\u043f\u0430\u0440. \u042f\u043d 17, 4), \u0443 \u0434\u0437\u0435\u043d\u044c \u041f\u044f\u0446\u0456\u0434\u0437\u0435\u0441\u044f\u0442\u043d\u0456\u0446\u044b \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0430\u0441\u0432\u044f\u0447\u0430\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b, \u043a\u0430\u0431 \u0432\u0435\u0440\u043d\u0456\u043a\u0456 \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u043c\u0435\u043b\u0456 \u045e \u0430\u0434\u043d\u044b\u043c \u0414\u0443\u0445\u0443 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u0430 \u0410\u0439\u0446\u0430 (\u043f\u0430\u0440. \u042d\u0444 2, 18). \u0401\u043d \u0441\u0430\u043c \u0451\u0441\u0446\u044c \u0434\u0443\u0445\u0430\u043c \u0436\u044b\u0446\u0446\u044f, \u0430\u0431\u043e \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u0439 \u0432\u0430\u0434\u044b, \u044f\u043a\u0430\u044f \u0446\u044f\u0447\u044d \u045e \u0436\u044b\u0446\u0446\u0451 \u0432\u0435\u0447\u043d\u0430\u0435 (\u043f\u0430\u0440. \u042f\u043d 4, 14; 7, 38-39); \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0410\u0439\u0446\u0435\u0446 \u0430\u0436\u044b\u045e\u043b\u044f\u0435 \u043b\u044e\u0434\u0437\u0435\u0439, \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u043f\u0440\u0430\u0437 \u0433\u0440\u044d\u0445, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u0446\u044c \u0456\u0445 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u044f \u0446\u0435\u043b\u044b \u045e \u0425\u0440\u044b\u0441\u0446\u0435 (\u043f\u0430\u0440. \u0420\u044b\u043c 8, 10-11). \u0414\u0443\u0445 \u0436\u044b\u0432\u0435 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e, \u044f\u043a \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 3, 16; 6, 19), \u0443 \u0456\u0445 \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0456 \u0434\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u045e\u0441\u044b\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f (\u043f\u0430\u0440. \u0413\u0430\u043b 4, 6; \u0420\u044b\u043c 8, 15-16 \u0456 26). \u0412\u0435\u0434\u0443\u0447\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u0434\u0430 \u045e\u0441\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u044b (\u043f\u0430\u0440. \u042f\u043d 16, 13) \u0456 \u044f\u0434\u043d\u0430\u044e\u0447\u044b \u044f\u0433\u043e \u045e \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0456 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456, \u043d\u0430\u0434\u0437\u044f\u043b\u044f\u0435 \u044f\u0433\u043e \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u0456\u0435\u0440\u0430\u0440\u0445\u0456\u0447\u043d\u044b\u043c\u0456 \u0456 \u0445\u0430\u0440\u044b\u0437\u043c\u0430\u0442\u044b\u0447\u043d\u044b\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456, \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435 \u044f\u0433\u043e \u0456 \u0430\u0437\u0434\u0430\u0431\u043b\u044f\u0435 \u0441\u0432\u0430\u0456\u043c\u0456 \u043f\u043b\u0430\u0434\u0430\u043c\u0456 (\u043f\u0430\u0440. \u042d\u0444 4, 11-12; 1 \u041a\u0430\u0440 12, 4; \u0413\u0430\u043b 5, 22). \u041c\u043e\u0446\u0430\u0439 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u0401\u043d \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u041a\u0430\u0441\u0446\u0451\u043b \u043c\u0430\u043b\u0430\u0434\u044b\u043c, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0430\u0431\u043d\u0430\u045e\u043b\u044f\u0435 \u044f\u0433\u043e \u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430\u043c. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0414\u0443\u0445 \u0456 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430 \u043a\u0430\u0436\u0443\u0446\u044c \u041f\u0430\u043d\u0443 \u0415\u0437\u0443\u0441\u0443: &laquo;\u041f\u0440\u044b\u0439\u0434\u0437\u0456!&raquo; (\u043f\u0430\u0440. \u0410\u043f 22, 17).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0443\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u043f\u0430\u045e\u0441\u0442\u0430\u0435 \u044f\u043a &laquo;\u043d\u0430\u0440\u043e\u0434, \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b \u0435\u0434\u043d\u0430\u0441\u0446\u044e \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430, \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u044f \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u0430\u044e\u0446\u044c \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435 \u0430\u0434 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 (\u043f\u0430\u0440. 1 \u042f\u043d 2, 20 \u0456 27), \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0430\u043c\u044b\u043b\u0456\u0446\u0446\u0430 \u045e \u0432\u0435\u0440\u044b \u0456 \u0432\u044b\u044f\u045e\u043b\u044f\u0435 \u0441\u0432\u0430\u044e \u0430\u0434\u043c\u0435\u0442\u043d\u0430\u0441\u0446\u044c \u043f\u0440\u0430\u0437 \u0437\u0432\u044b\u0448\u043f\u0440\u044b\u0440\u043e\u0434\u043d\u0430\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0451 \u0432\u0435\u0440\u044b \u045e\u0441\u044f\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u043a\u0430\u043b\u0456, &laquo;\u043f\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b \u0430\u0434 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e \u0430\u0436 \u0434\u0430 \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430 \u0441\u0430 \u0441\u0432\u0435\u0446\u043a\u0456\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e&raquo;, \u044f\u043d\u0430 \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435 \u0441\u0432\u0430\u044e \u045e\u0441\u0435\u0430\u0433\u0443\u043b\u044c\u043d\u0443\u044e \u0437\u0433\u043e\u0434\u0443 \u045e \u043f\u044b\u0442\u0430\u043d\u043d\u044f\u0445 \u0432\u0435\u0440\u044b \u0456 \u0437\u0432\u044b\u0447\u0430\u044f\u045e. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u043c\u0443 \u043f\u0430\u0447\u0443\u0446\u0446\u044e \u0432\u0435\u0440\u044b, \u044f\u043a\u043e\u0435 \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u0414\u0443\u0445 \u043f\u0440\u0430\u045e\u0434\u044b, \u0411\u043e\u0436\u044b \u043d\u0430\u0440\u043e\u0434 \u043f\u0430\u0434 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u0446\u043a\u0430\u0433\u0430 \u0406\u043d\u0441\u0442\u044b\u0442\u0443\u0442\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043f\u0440\u044b\u043c\u0430\u0435 \u045e\u0436\u043e \u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435, \u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0411\u043e\u0436\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 (\u043f\u0430\u0440. 1 \u0422\u044d\u0441 2, 13), \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430 \u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u0432\u0435\u0440\u044b, \u0430\u0434\u043d\u043e\u0439\u0447\u044b \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043c (\u043f\u0430\u0440. \u042e\u0434 3), \u0433\u043b\u044b\u0431\u0435\u0439 \u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u0435 \u044f\u0435 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0441\u043b\u0443\u0448\u043d\u0430\u0439 \u0430\u0446\u044d\u043d\u043a\u0456 \u0456 \u043f\u0430\u045e\u043d\u0435\u0439 \u0432\u044b\u043a\u0430\u0440\u044b\u0441\u0442\u043e\u045e\u0432\u0430\u0435 \u044f\u0435 \u045e \u0436\u044b\u0446\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0441\u0430\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u044b \u0456 \u043f\u0430\u0441\u043b\u0443\u0433\u0456 \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0430\u0441\u0432\u044f\u0447\u0430\u0435, \u0432\u044f\u0434\u0437\u0435 \u0456 \u0430\u0437\u0434\u0430\u0431\u043b\u044f\u0435 \u0446\u043d\u043e\u0442\u0430\u043c\u0456 \u0411\u043e\u0436\u044b \u043d\u0430\u0440\u043e\u0434, \u0430\u043b\u0435, &laquo;\u0443\u0434\u0437\u044f\u043b\u044f\u044e\u0447\u044b \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u043f\u0430\u0430\u0441\u043e\u0431\u043a\u0443, \u044f\u043a \u0436\u0430\u0434\u0430\u0435&raquo; (1 \u041a\u0430\u0440 12, 11) \u0441\u0432\u0430\u0435 \u0434\u0430\u0440\u044b, \u0440\u0430\u0437\u043c\u044f\u0440\u043a\u043e\u045e\u0432\u0430\u0435 \u0441\u044f\u0440\u043e\u0434 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u0443 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u044f \u043b\u0430\u0441\u043a\u0456, \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u044f\u043a\u0456\u0445 \u0440\u043e\u0431\u0456\u0446\u044c \u0456\u0445 \u0437\u0434\u0430\u0442\u043d\u044b\u043c\u0456 \u0456 \u0433\u0430\u0442\u043e\u0432\u044b\u043c\u0456 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0440\u043e\u0437\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0456, \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u044f \u0434\u043b\u044f \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0434\u0430\u043b\u0435\u0439\u0448\u0430\u0433\u0430 \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430\u0433\u0430: &laquo;\u041a\u043e\u0436\u043d\u0430\u043c\u0443 \u0434\u0430\u0435\u0446\u0446\u0430 \u043f\u0440\u0430\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u043d\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u044c&raquo; (1 \u041a\u0430\u0440 12, 7). \u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0433\u044d\u0442\u044b\u044f \u0445\u0430\u0440\u044b\u0437\u043c\u044b &mdash; \u044f\u043a \u043d\u0430\u0439\u0441\u043b\u0430\u045e\u043d\u0435\u0439\u0448\u044b\u044f, \u0442\u0430\u043a \u0456 \u0441\u0430\u043c\u044b\u044f \u043f\u0440\u043e\u0441\u0442\u044b\u044f \u0456 \u0431\u043e\u043b\u044c\u0448 \u0440\u0430\u0441\u043f\u0430\u045e\u0441\u044e\u0434\u0436\u0430\u043d\u044b\u044f &mdash; \u043d\u0430\u0434\u0437\u0432\u044b\u0447\u0430\u0439 \u0430\u0434\u043f\u0430\u0432\u044f\u0434\u0430\u044e\u0446\u044c \u043f\u0430\u0442\u0440\u044d\u0431\u0430\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c\u0456, \u0456\u0445 \u0442\u0440\u044d\u0431\u0430 \u043f\u0440\u044b\u043c\u0430\u0446\u044c \u0437 \u0443\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044e \u0456 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 7, 37\u0430. 38. 39\u0430<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423 \u0430\u043f\u043e\u0448\u043d\u0456, \u0432\u044f\u043b\u0456\u043a\u0456 \u0434\u0437\u0435\u043d\u044c \u0441\u0432\u044f\u0442\u0430, \u0415\u0437\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e: \u0425\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u041c\u044f\u043d\u0435, \u0443 \u0442\u0430\u0433\u043e \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u043f\u0430\u0446\u044f\u043a\u0443\u0446\u044c \u0440\u044d\u043a\u0456 \u0432\u0430\u0434\u044b \u0436\u044b\u0432\u043e\u0439. <span style=\"color: #ff0000;\">*<\/span> \u0413\u044d\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u043d \u043f\u0440\u0430 \u0414\u0443\u0445\u0430, \u044f\u043a\u043e\u0433\u0430 \u043c\u0435\u043b\u0456\u0441\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0443 \u042f\u0433\u043e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u041c\u044f\u043d\u0435 \u0456 \u043f&rsquo;\u0435, \u0430 \u0437 \u0443\u043b\u043e\u043d\u043d\u044f \u044f\u0433\u043e \u043f\u0430\u0446\u044f\u043a\u0443\u0446\u044c \u0440\u044d\u043a\u0456 \u0432\u0430\u0434\u044b \u0436\u044b\u0432\u043e\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u0441\u043a\u0430\u0437\u0430\u045e \u0401\u043d \u043f\u0440\u0430 \u0414\u0443\u0445\u0430, \u044f\u043a\u043e\u0433\u0430 \u043c\u0435\u043b\u0456\u0441\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u0443 \u042f\u0433\u043e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5075","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u042f\u043d\u0430&raquo;\u0441\u0432. \u041a\u0456\u0440\u044b\u043b\u0430 \u0410\u043b\u0435\u043a\u0441\u0430\u043d\u0434\u0440\u044b\u0439\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 10, 16, 6-7: PG 74, 434)<\/span><br \/><span style=\"color: #ff0000;\">\u041a\u0430\u043b\u0456 \u043d\u0435 \u0430\u0434\u044b\u0434\u0443, \u0421\u0443\u0446\u044f\u0448\u044b\u0446\u0435\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u0432\u0430\u0441<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u045e\u0441\u0451, \u0448\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u043e \u0430\u0434\u0431\u044b\u0446\u0446\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0430\u043b\u0435 \u043d\u0430\u043c \u043d\u0430\u043b\u0435\u0436\u0430\u043b\u0430 \u044f\u0448\u0447\u044d \u0441\u0442\u0430\u0446\u044c \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0431\u043e\u0441\u043a\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0421\u043b\u043e\u0432\u0430. \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043f\u0430\u043a\u0456\u043d\u0443\u045e\u0448\u044b \u0440\u0430\u043d\u0435\u0439\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0431\u044b\u043b\u0456 \u043f\u0435\u0440\u0430\u0439\u0441\u0446\u0456 \u0456 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u0446\u0430 \u0434\u0430 \u0456\u043d\u0448\u0430\u0433\u0430, \u043d\u043e\u0432\u0430\u0433\u0430 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0410\u0434\u0431\u044b\u0446\u0446\u0430 \u0433\u044d\u0442\u0430 \u043c\u0430\u0433\u043b\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0437 \u0443\u0434\u0437\u0435\u043b \u0443 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0439\u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0439 \u043f\u0430\u0440\u043e\u0439 \u0434\u043b\u044f \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u043d\u044f \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u042f\u0433\u043e \u0441\u044b\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u044f \u043d\u0430 \u043d\u0430\u0441 \u0431\u044b\u045e \u0447\u0430\u0441 \u043f\u0430\u0441\u043b\u044f \u0430\u0434\u044b\u0445\u043e\u0434\u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u043f\u0430\u043a\u0443\u043b\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0432\u0435\u0440\u043d\u044b\u043c\u0456 \u045e \u0446\u0435\u043b\u0435, \u0401\u043d \u0431\u044b\u045e \u0434\u043b\u044f \u045e\u0441\u0456\u0445, \u044f\u043a \u043c\u044f\u0440\u043a\u0443\u044e, \u0434\u0430\u045e\u0446\u0430\u043c \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430. \u0410\u0434\u043d\u0430\u043a, \u043a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u045e \u0447\u0430\u0441 \u0456 \u0415\u0437\u0443\u0441 \u0437 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0443\u0437\u044b\u0441\u0446\u0456 \u0434\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e, \u043a\u0430\u0431 \u0401\u043d \u0437\u0430\u0441\u0442\u0430\u045e\u0441\u044f \u0441\u0430 \u0441\u0432\u0430\u0456\u043c\u0456 \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0430\u043c\u0456 \u043f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u045e\u0441\u044f \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e. \u041c\u0430\u044e\u0447\u044b \u042f\u0433\u043e \u045e \u043d\u0430\u0441, \u043c\u044b \u0437 \u0434\u0430\u0432\u0435\u0440\u0430\u043c \u043c\u043e\u0436\u0430\u043c \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u0446\u044c: &laquo;\u0410\u0431\u0431\u0430, \u041e\u0439\u0447\u0430&raquo;. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0430\u043c\u0443 \u0414\u0443\u0445\u0443, \u044f\u043a\u043e\u0433\u0430 \u043c\u0430\u0435\u043c, \u0446\u0456 \u0436 \u043d\u0435 \u043b\u044f\u0433\u0447\u044d\u0439 \u043d\u0430\u043c \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u0446\u043d\u043e\u0442\u044b \u0456 \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u0446\u0446\u0430 \u043d\u0435\u043f\u0435\u0440\u0430\u043c\u043e\u0436\u043d\u044b\u043c\u0456 \u043d\u0430\u0441\u0443\u043f\u0435\u0440\u0430\u043a \u043f\u0430\u0441\u0442\u043a\u0430\u043c \u0434&rsquo;\u044f\u0431\u043b\u0430 \u0456 \u043b\u044e\u0434\u0441\u043a\u0456\u043c \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u0430\u043c?<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0456 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u041f\u0456\u0441\u0430\u043d\u043d\u044f, \u044f\u043a \u0421\u0442\u0430\u0440\u043e\u0433\u0430, \u0442\u0430\u043a \u0456 \u041d\u043e\u0432\u0430\u0433\u0430 \u0417\u0430\u043f\u0430\u0432\u0435\u0442\u0430\u045e, \u043f\u0435\u0440\u0430\u043a\u0430\u043d\u0430\u045e\u0447\u0430 \u0441\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u0435, \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435 \u0456 \u0434\u0430\u0435 \u043d\u043e\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0442\u044b\u043c, \u0443 \u043a\u0456\u043c \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0456 \u0436\u044b\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b \u0421\u0430\u043c\u0443\u044d\u043b\u044c \u043a\u0430\u0437\u0430\u045e \u0421\u0430\u045e\u043b\u0443: &laquo;\u0421\u044b\u0434\u0437\u0435 \u043d\u0430 \u0446\u044f\u0431\u0435 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0456 \u0442\u044b \u0441\u0442\u0430\u043d\u0435\u0448 \u043d\u043e\u0432\u044b\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c&raquo; (\u043f\u0430\u0440. 1 \u0421\u0430\u043c 10, 6). \u0410 \u0441\u0432. \u041f\u0430\u0432\u0435\u043b \u043f\u0456\u0448\u0430: &laquo;\u0423\u0441\u0435 \u043c\u044b \u0437 \u0430\u0434\u043a\u0440\u044b\u0442\u044b\u043c \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0443\u0433\u043b\u044f\u0434\u0430\u0435\u043c\u0441\u044f \u045e \u0441\u043b\u0430\u0432\u0443 \u041f\u0430\u043d\u0430 \u0456 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0435\u043c\u0441\u044f \u045e \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0430\u0434 \u0441\u043b\u0430\u0432\u044b \u045e \u0441\u043b\u0430\u0432\u0443, \u0442\u0430\u043a \u044f\u043a \u043f\u0440\u0430\u0437 \u0414\u0443\u0445 \u041f\u0430\u043d\u0430. \u0411\u043e \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0414\u0443\u0445\u0430\u043c&raquo; (\u043f\u0430\u0440. 2 \u041a\u0430\u0440 3, 17-18).<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0430\u0447\u044b\u0446\u0435, \u044f\u043a \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u044d\u045e\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u0430\u0435 \u045e \u0456\u043d\u0448\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0442\u044b\u0445, \u0443 \u043a\u0456\u043c \u0436\u044b\u0432\u0435? \u0401\u043d \u0431\u0435\u0437 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u0456 \u043f\u0435\u0440\u0430\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0434 \u0437\u0430\u043d\u044f\u0442\u0430\u0441\u0446\u0456 \u0437\u044f\u043c\u043d\u044b\u043c\u0456 \u0441\u043f\u0440\u0430\u0432\u0430\u043c\u0456 \u0434\u0430 \u0441\u0443\u0437\u0456\u0440\u0430\u043d\u043d\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u043d\u0435\u0431\u0435, \u0430\u0434 \u043d\u0435\u043c\u0430\u0447\u043d\u0430\u0439 \u0431\u043e\u044f\u0437\u0456 \u0434\u0430 \u0430\u0434\u0432\u0430\u0436\u043d\u0430\u0439 \u0456 \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u0430\u0439 \u0441\u0456\u043b\u044b \u0434\u0443\u0445\u0430. \u0422\u0430\u043a\u0456\u043c\u0456 \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430 \u0441\u0442\u0430\u043b\u0456 \u0432\u0443\u0447\u043d\u0456, \u044f\u043a\u0456\u044f, \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u0414\u0443\u0445\u0430\u043c, \u043d\u0435 \u0434\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u043d\u0456\u043a\u0430\u043c \u043f\u0435\u0440\u0430\u043c\u0430\u0433\u0447\u044b \u0456\u0445 \u0456 \u0446\u0432\u0451\u0440\u0434\u0430 \u0442\u0440\u044b\u043c\u0430\u043b\u0456\u0441\u044f \u043b\u044e\u0431\u043e\u0432\u0456 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0440\u0430\u045e\u0434\u0443 \u0441\u043a\u0430\u0437\u0430\u045e \u0417\u0431\u0430\u045e\u0446\u0430: &laquo;\u041b\u0435\u043f\u0448 \u0434\u043b\u044f \u0432\u0430\u0441, \u043a\u0430\u0431 \u042f \u0430\u0434\u044b\u0448\u043e\u045e&raquo; (\u042f\u043d 16, 7). \u0411\u043e \u0433\u044d\u0442\u0430 \u0431\u044b\u045e \u0447\u0430\u0441, \u043a\u0430\u043b\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u045e \u0441\u044b\u0441\u0446\u0456 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 16, 7b. 13<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u042f \u043d\u0435 \u0430\u0434\u044b\u0434\u0443, \u0421\u0443\u0446\u044f\u0448\u044b\u0446\u0435\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u0432\u0430\u0441; \u0430 \u043a\u0430\u043b\u0456 \u0430\u0434\u044b\u0434\u0443, \u043f\u0430\u0448\u043b\u044e \u042f\u0433\u043e \u0434\u0430 \u0432\u0430\u0441. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u043a\u0430\u043b\u0456 \u0401\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0435 \u0430\u0434 \u0441\u044f\u0431\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c, \u0430 \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0437\u0430\u0446\u044c \u0432\u0430\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0447\u0443\u0435, \u0456 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u044e \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043a\u0430\u043b\u0456 \u0401\u043d \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u0437\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5076","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0421\u0432\u044f\u0442\u0443\u044e \u0422\u0440\u043e\u0439\u0446\u0443&raquo; \u0441\u0432. \u0413\u0456\u043b\u044f\u0440\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 2, 1, 33. 35: PL 10, 50-51. 73-75)<\/span><br \/><span style=\"color: #ff0000;\">\u0414\u0430\u0440 \u0410\u0439\u0446\u0430 \u045e \u0425\u0440\u044b\u0441\u0446\u0435<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u044c \u0443 \u0456\u043c\u044f \u0410\u0439\u0446\u0430, \u0456 \u0421\u044b\u043d\u0430, \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0432\u044b\u0437\u043d\u0430\u044e\u0447\u044b \u0456 \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044f, \u0456 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430, \u0456 \u0414\u0430\u0440.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0437\u0456\u043d \u0451\u0441\u0446\u044c \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0443\u0441\u044f\u0433\u043e, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0430\u0434\u0437\u0456\u043d \u0411\u043e\u0433 \u0410\u0439\u0446\u0435\u0446, \u0437 \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u0451; \u0456 \u0430\u0434\u0437\u0456\u043d \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b, \u041f\u0430\u043d \u043d\u0430\u0448 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u045e\u0441\u0451; \u0430\u0434\u0437\u0456\u043d \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0414\u0443\u0445, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0434\u0430\u0440\u0430\u043c \u0432\u0430 \u045e\u0441\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0443\u0441\u0451 \u045e\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0430 \u045e \u0441\u0432\u0430\u0451\u0439 \u043c\u043e\u0446\u044b \u0456 \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u0445: \u0430\u0434\u043d\u0430 \u043c\u043e\u0446, \u0430\u0434 \u044f\u043a\u043e\u0439 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u0451, \u0430\u0434\u0437\u0456\u043d \u043d\u0430\u0448\u0447\u0430\u0434\u0430\u043a, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u045e\u0441\u0451, \u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0430\u0440 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456. \u0406 \u0433\u044d\u0442\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u043d\u0430\u0441\u0446\u044c \u043d\u0435 \u043c\u0430\u0435 \u043d\u0456 \u045e \u0447\u044b\u043c \u043d\u0435\u0434\u0430\u0445\u043e\u043f\u0443, \u0431\u043e \u044f\u043d\u0430 \u0437\u043c\u044f\u0448\u0447\u0430\u0435 \u045e \u0410\u0439\u0446\u0443, \u0456 \u0421\u044b\u043d\u0443, \u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c \u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0441\u0446\u044c \u0443 \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456, \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u044c \u0443 \u0432\u043e\u0431\u0440\u0430\u0437\u0435 \u0456 \u043a\u0430\u0440\u044b\u0441\u0446\u044c \u0443 \u0434\u0430\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u043b\u0443\u0445\u0430\u0435\u043c, \u0448\u0442\u043e \u0441\u043b\u043e\u0432\u044b \u041f\u0430\u043d\u0430 \u043a\u0430\u0436\u0443\u0446\u044c \u043f\u0440\u0430 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u045e \u043d\u0430\u0441: &laquo;\u042f\u0448\u0447\u044d \u0448\u043c\u0430\u0442 \u0447\u0430\u0433\u043e \u043c\u0430\u044e \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0432\u0430\u043c, \u0430\u043b\u0435 \u0446\u044f\u043f\u0435\u0440 \u0432\u0430\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u043d\u0435 \u0437\u043d\u0435\u0441\u0446\u0456&raquo; (\u042f\u043d 16, 12). &laquo;\u041b\u0435\u043f\u0448 \u0434\u043b\u044f \u0432\u0430\u0441, \u043a\u0430\u0431 \u042f \u0430\u0434\u044b\u0448\u043e\u045e. \u0410 \u043a\u0430\u043b\u0456 \u0430\u0434\u044b\u0434\u0443, \u043f\u0430\u0448\u043b\u044e \u0434\u0430 \u0432\u0430\u0441 \u0421\u0443\u0446\u044f\u0448\u044b\u0446\u0435\u043b\u044f&raquo; (\u043f\u0430\u0440. \u042f\u043d 16, 7).<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u045e \u0456\u043d\u0448\u044b\u043c \u043c\u0435\u0441\u0446\u044b: &laquo;\u042f \u043f\u0430\u043f\u0440\u0430\u0448\u0443 \u0410\u0439\u0446\u0430, \u0456 \u0434\u0430\u0441\u0446\u044c \u0432\u0430\u043c \u0456\u043d\u0448\u0430\u0433\u0430 \u0421\u0443\u0446\u044f\u0448\u044b\u0446\u0435\u043b\u044f, \u043a\u0430\u0431 \u0431\u044b\u045e \u0437 \u0432\u0430\u043c\u0456 \u043d\u0430\u0432\u0435\u043a\u0456, \u0414\u0443\u0445\u0430 \u043f\u0440\u0430\u045e\u0434\u044b&raquo; (\u042f\u043d 14, 16-17). &laquo;\u0401\u043d \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u0411\u043e \u043d\u0435 \u0430\u0434 \u0441\u044f\u0431\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0446\u044c, \u0430 \u0431\u0443\u0434\u0437\u0435 \u043a\u0430\u0437\u0430\u0446\u044c \u0432\u0430\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u0447\u0443\u0435, \u0456 \u0431\u0443\u0434\u0443\u0447\u044b\u043d\u044e \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u0432\u0430\u043c. \u0401\u043d \u0443\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u041c\u044f\u043d\u0435, \u0431\u043e \u0430\u0434 \u041c\u0430\u0439\u0433\u043e \u0432\u043e\u0437\u044c\u043c\u0435&raquo; (\u043f\u0430\u0440. \u042f\u043d 16, 13-14).<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u044b\u0445 \u0441\u043b\u043e\u0432\u0430\u0445 \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0448\u043c\u0430\u0442 \u0434\u043b\u044f \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u043d\u0430\u043c\u0435\u0440\u0430\u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430\u043c \u0433\u044d\u0442\u044b \u0434\u0430\u0440, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0456 \u0441\u0442\u0430\u043d\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0430\u0440\u0443. \u0417-\u0437\u0430 \u043d\u0430\u0448\u0430\u0439 \u0430\u0431\u043c\u0435\u0436\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456 \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430, \u0430\u043b\u0435 \u0434\u0430\u0440 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u045e\u0441\u0442\u0430\u043b\u0451\u045e\u0432\u0430\u0435 \u043f\u0430\u043c\u0456\u0436 \u043d\u0430\u043c\u0456 \u0456 \u0411\u043e\u0433\u0430\u043c \u043f\u044d\u045e\u043d\u0443\u044e \u0434\u0430\u043c\u043e\u0432\u0443 \u0456 \u0433\u044d\u0442\u0430\u043a \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0435 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u0456 \u043d\u0430\u0448\u0430\u0439 \u0432\u0435\u0440\u044b \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0411\u043e\u0436\u0430\u0433\u0430 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u044b \u043f\u0440\u044b\u043c\u0430\u0435\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043a\u0430\u0431 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0411\u043e\u0433\u0430. \u041f\u0430\u0440\u0430\u045e\u043d\u0430\u0435\u043c \u0433\u044d\u0442\u0430 \u0437 \u043f\u0430\u0447\u0443\u0446\u0446\u044f\u043c\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c\u0456, \u043a\u0430\u043b\u0456 \u043d\u044f\u043c\u0430 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u0430\u0433\u0430 \u0441\u0442\u044b\u043c\u0443\u043b\u0443. \u041d\u0430\u043f\u0440\u044b\u043a\u043b\u0430\u0434, \u0430\u0434 \u0432\u0430\u0447\u044d\u0439 \u043d\u044f\u043c\u0430 \u043d\u0456\u044f\u043a\u0430\u0439 \u043a\u0430\u0440\u044b\u0441\u0446\u0456, \u043a\u0430\u043b\u0456 \u043d\u044f\u043c\u0430 \u0441\u0432\u044f\u0442\u043b\u0430 \u0446\u0456 \u043c\u0456\u043d\u0443\u045e \u0434\u0437\u0435\u043d\u044c; \u043d\u044f\u043c\u0430 \u043a\u0430\u0440\u044b\u0441\u0446\u0456 \u0430\u0434 \u0441\u043b\u044b\u0445\u0443, \u043a\u0430\u043b\u0456 \u0434\u0430 \u0432\u0443\u0448\u044d\u0439 \u043d\u0435 \u0434\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0456\u044f\u043a\u0456 \u0433\u043e\u043b\u0430\u0441 \u0446\u0456 \u0448\u0443\u043c; \u043d\u0435\u043f\u0430\u0442\u0440\u044d\u0431\u043d\u044b\u043c \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u043d\u044e\u0445, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0430\u0434\u0447\u0443\u0432\u0430\u0435 \u043d\u0456\u044f\u043a\u0430\u0433\u0430 \u043f\u0430\u0445\u0443. \u0406 \u0433\u044d\u0442\u0430 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0435 \u0437 \u0432\u0456\u043d\u044b \u043f\u0440\u044b\u0440\u043e\u0434\u044b, \u0430 \u0437-\u0437\u0430 \u0430\u0434\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0441\u0442\u044b\u043c\u0443\u043b\u0443. \u041f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0456 \u0440\u043e\u0437\u0443\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0445\u043e\u0446\u044c \u043c\u0430\u0435 \u0437\u0434\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0411\u043e\u0433\u0430, \u0430\u0434\u043d\u0430\u043a \u043d\u0435 \u043c\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u043c\u0435 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0434\u0430\u0440 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u0434\u0430\u0440, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435, \u0430\u0434\u0437\u0456\u043d \u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0434\u043a\u0440\u044b\u0442\u044b \u0434\u043b\u044f \u045e\u0441\u0456\u0445. \u0425\u043e\u0446\u044c \u0451\u043d \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0435 \u0431\u044b\u0446\u044c \u0443\u0441\u044e\u0434\u044b\u0456\u0441\u043d\u044b\u043c, \u0443\u0434\u0437\u044f\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0442\u0430\u043a\u043e\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456, \u0443 \u044f\u043a\u043e\u0439 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0445\u043e\u0447\u0430 \u044f\u0433\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c, \u0456 \u0437\u0430\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u045e \u0442\u0430\u043a\u043e\u0439 \u0441\u0442\u0443\u043f\u0435\u043d\u0456, \u0443 \u044f\u043a\u043e\u0439 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0436\u0430\u0434\u0430\u0435 \u044f\u0433\u043e \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u0446\u044c. \u0401\u043d \u0437 \u043d\u0430\u043c\u0456 \u0434\u0430 \u0441\u0430\u043c\u0430\u0433\u0430 \u043a\u0430\u043d\u0446\u0430 \u0432\u044f\u043a\u043e\u045e, \u0433\u044d\u0442\u0430 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456. \u042f\u0433\u043e \u0434\u0437\u0435\u044f\u043d\u043d\u0435 &ndash; \u0433\u044d\u0442\u0430 \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0442\u0430\u0433\u043e, \u0447\u0430\u0433\u043e \u043c\u044b \u0447\u0430\u043a\u0430\u0435\u043c, \u0430 \u0441\u0430\u043c \u0401\u043d &ndash; \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u043b\u044f \u043d\u0430\u0448\u044b\u0445 \u0440\u043e\u0437\u0443\u043c\u0430\u045e \u0456 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u043d\u0435 \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u0448.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u042f\u043d 14, 27; 17, 11; 16, 7<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0441\u0442\u0430\u045e \u0447\u0430\u0441 \u041c\u043d\u0435 \u0432\u044f\u0440\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u041c\u044f\u043d\u0435 \u043f\u0430\u0441\u043b\u0430\u045e, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u041d\u0435 \u0441\u043c\u0443\u0442\u043a\u0443\u0439\u0446\u0435, \u0456 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0442\u0443\u0440\u0431\u0443\u0435\u0446\u0446\u0430 \u0441\u044d\u0440\u0446\u0430 \u0432\u0430\u0448\u0430\u0435. <span style=\"color: #ff0000;\">*<\/span> \u0411\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0437\u0430 \u0432\u0430\u0441 \u0410\u0439\u0446\u0430, \u043a\u0430\u0431 \u0401\u043d \u0430\u0445\u043e\u045e\u0432\u0430\u045e \u0432\u0430\u0441, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u043d\u0435 \u0430\u0434\u044b\u0434\u0443, \u0421\u0443\u0446\u044f\u0448\u044b\u0446\u0435\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0435; \u043a\u0430\u043b\u0456 \u0430\u0434\u044b\u0434\u0443, \u043f\u0430\u0448\u043b\u044e \u042f\u0433\u043e \u0434\u0430 \u0432\u0430\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0443 \u043f\u0440\u0430\u0441\u0456\u0446\u044c \u0437\u0430 \u0432\u0430\u0441 \u0410\u0439\u0446\u0430, \u043a\u0430\u0431 \u0401\u043d \u0430\u0445\u043e\u045e\u0432\u0430\u045e \u0432\u0430\u0441, \u0430\u043b\u043b\u0435\u043b\u044e\u044f<\/p>\r\n"}, {"GCH_CH_2_ID":"5077","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0430\u0444\u0440\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0430\u045e\u0442\u0430\u0440\u0430 VI \u0441\u0442\u0430\u0433\u043e\u0434\u0434\u0437\u044f<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 8, 1-3: PL 65, 743-744)<\/span><br \/><span style=\"color: #ff0000;\">\u0410\u0434\u0437\u0456\u043d\u044b \u041a\u0430\u0441\u0446\u0451\u043b \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u043d\u0430 \u045e\u0441\u0456\u0445 \u043c\u043e\u0432\u0430\u0445<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0447\u0430\u043b\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u043d\u0430 \u045e\u0441\u0456\u0445 \u043c\u043e\u0432\u0430\u0445. \u0411\u043e\u0433\u0443 \u0441\u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0430\u0441\u044f \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0442\u0430\u043a \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u042f\u0433\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e, \u0433\u0430\u0432\u0430\u0440\u044b\u045e \u043d\u0430 \u0440\u043e\u0437\u043d\u044b\u0445 \u043c\u043e\u0432\u0430\u0445. \u041c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c, \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0451\u0441\u0446\u044c \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u044f\u043a\u0456 \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u043d\u0430\u0448\u044b \u0441\u044d\u0440\u0446\u044b \u043b\u044e\u0431\u043e\u045e\u044e \u0411\u043e\u0436\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0411\u043e\u0436\u0430\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u043b\u0430 \u0441\u0430\u0431\u0440\u0430\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435. \u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0430\u0434\u0437\u0456\u043d \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0447\u044b \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043c\u043e\u0433 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u045e\u0441\u0456\u0445 \u043c\u043e\u0432\u0430\u0445, \u0430 \u0446\u044f\u043f\u0435\u0440 \u043d\u0430 \u045e\u0441\u0456\u0445 \u043c\u043e\u0432\u0430\u0445 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b, \u0441\u0430\u0431\u0440\u0430\u043d\u044b \u0442\u044b\u043c \u0436\u0430 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0445\u0442\u043e\u0441\u044c\u0446\u0456 \u0441\u043a\u0430\u0436\u0430 \u0430\u0434\u043d\u0430\u043c\u0443 \u0437 \u043d\u0430\u0441: &laquo;\u0422\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0447\u0430\u043c\u0443 \u043d\u0435 \u0433\u0430\u0432\u043e\u0440\u044b\u0448 \u043d\u0430 \u0440\u043e\u0437\u043d\u044b\u0445 \u043c\u043e\u0432\u0430\u0445?&raquo; &ndash; \u043d\u044f\u0445\u0430\u0439 \u0430\u0434\u043a\u0430\u0436\u0430: &laquo;\u0427\u0430\u043c\u0443 \u0436, \u044f \u0433\u0430\u0432\u0430\u0440\u0443 \u043d\u0430 \u0440\u043e\u0437\u043d\u044b\u0445 \u043c\u043e\u0432\u0430\u0445, \u0431\u043e \u043d\u0430\u043b\u0435\u0436\u0443 \u0434\u0430 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u0434\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u043a\u0456 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u043d\u0430 \u0440\u043e\u0437\u043d\u044b\u0445 \u043c\u043e\u0432\u0430\u0445. \u0426i \u0436 \u0411\u043e\u0433 \u0432\u043e\u0431\u0440\u0430\u0437\u043d\u0430 \u043d\u0435 \u043f\u0430\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430\u0437 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u045e\u043b\u0430\u0441\u043d\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u042f\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b \u0431\u0443\u0434\u0437\u0435 \u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0440\u043e\u0437\u043d\u044b\u0445 \u043c\u043e\u0432\u0430\u0445?&raquo;<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u043e\u045e\u043d\u0456\u043b\u0430\u0441\u044f \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0431\u044f\u0446\u0430\u045e \u041f\u0430\u043d: &laquo;\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043d\u0430\u043b\u0456\u0432\u0430\u0435 \u043d\u043e\u0432\u0430\u0433\u0430 \u0432\u0456\u043d\u0430 \u045e \u0441\u0442\u0430\u0440\u044b\u044f \u043c\u044f\u0445\u0456, \u0430\u043b\u0435 \u043d\u043e\u0432\u0430\u0435 \u0432\u0456\u043d\u043e \u0442\u0440\u044d\u0431\u0430 \u043d\u0430\u043b\u0456\u0432\u0430\u0446\u044c \u0443 \u043d\u043e\u0432\u044b\u044f \u043c\u044f\u0445\u0456, \u043a\u0430\u0431 \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0456 \u0442\u043e\u0435, \u0456 \u0434\u0440\u0443\u0433\u043e\u0435&raquo; (\u043f\u0430\u0440. \u041b\u043a 5, 37-38).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u043b\u0443\u0448\u043d\u0430 \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u043a\u0430\u0437\u0430\u043b\u0456, \u043f\u0430\u0447\u0443\u045e\u0448\u044b, \u044f\u043a \u0432\u0443\u0447\u043d\u0456 \u0433\u0430\u0432\u043e\u0440\u0430\u0446\u044c \u043d\u0430 \u0440\u043e\u0437\u043d\u044b\u0445 \u043c\u043e\u0432\u0430\u0445: &laquo;\u042f\u043d\u044b \u043d\u0430\u043f\u0456\u043b\u0456\u0441\u044f \u043c\u0430\u043b\u0430\u0434\u043e\u0433\u0430 \u0432\u0456\u043d\u0430&raquo; (\u0414\u0437 2, 13). \u0413\u044d\u0442\u044b\u044f \u0432\u0443\u0447\u043d\u0456, \u0430\u0434\u043d\u043e\u045e\u043b\u0435\u043d\u044b\u044f \u043b\u0430\u0441\u043a\u0430\u044e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u0441\u0442\u0430\u043b\u0456 \u044f\u043a \u0431\u044b \u043d\u043e\u0432\u044b\u043c\u0456 \u043c\u044f\u0445\u0430\u043c\u0456. \u041d\u0430\u043f\u043e\u045e\u043d\u0435\u043d\u044b\u044f, \u0431\u044b\u0446\u0446\u0430\u043c \u0432\u0456\u043d\u043e\u043c, \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u044f\u043d\u044b \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u0430 \u0433\u0430\u0432\u0430\u0440\u044b\u043b\u0456 \u043d\u0430 \u045e\u0441\u0456\u0445 \u043c\u043e\u0432\u0430\u0445 \u0456 \u0433\u044d\u0442\u044b\u043c \u043d\u0430\u0439\u0432\u0456\u0434\u0430\u0432\u043e\u0447\u043d\u0435\u0439\u0448\u044b\u043c \u0446\u0443\u0434\u0430\u043c \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456, \u0448\u0442\u043e \u041a\u0430\u0441\u0446\u0451\u043b \u0441\u0442\u0430\u043d\u0435 \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u044b\u043c \u043f\u0440\u0430\u0437 \u043c\u043e\u0432\u044b \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0441\u0432\u044f\u0442\u043a\u0443\u0439\u0446\u0435 \u0436 \u0433\u044d\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u044f\u043a \u0447\u0430\u0441\u0442\u043a\u0456 \u0430\u0434\u043d\u0430\u0433\u043e \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430. \u0411\u043e \u043d\u0435 \u0434\u0430\u0440\u043c\u0430 \u0441\u0432\u044f\u0442\u043a\u0443\u0435\u0446\u0435, \u043a\u0430\u043b\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0435\u0441\u044f \u0442\u044b\u043c, \u0448\u0442\u043e \u0441\u0432\u044f\u0442\u043a\u0443\u0435\u0446\u0435, \u0431\u0443\u0434\u0443\u0447\u044b \u0447\u0430\u0441\u0442\u043a\u0430\u043c\u0456 \u0442\u0430\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u043a\u0456 \u041f\u0430\u043d \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0456 \u044f\u043a\u0456 \u043f\u0430\u0448\u044b\u0440\u0430\u0435\u0446\u0446\u0430 \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456. \u041f\u0430\u043d \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u044f\u0433\u043e \u0441\u0432\u0430\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c, \u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u0411\u043e\u0433\u0430 \u0441\u0432\u0430\u0456\u043c \u041f\u0430\u043d\u0430\u043c. \u041f\u0430\u043d, \u044f\u043a \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a, \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0441\u0432\u0430\u0451\u0439 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b, \u0456 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u0435 \u042f\u043c\u0443 \u0456\u043d\u0448\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0430\u043c, \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c \u0443\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u0447\u0430\u0441\u0442\u043a\u0430\u043c \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0441\u0430\u043c\u043e\u043c\u0443 \u0446\u0435\u043b\u0443, \u042f\u0433\u043e \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u044b, \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b: &laquo;\u0426\u044f\u0440\u043f\u0456\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u045e \u043b\u044e\u0431\u043e\u0432\u0456, \u0441\u0442\u0430\u0440\u0430\u0439\u0446\u0435\u0441\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0434\u0443\u0445\u0430 \u045e \u0441\u0430\u044e\u0437\u0435 \u0441\u043f\u0430\u043a\u043e\u044e&raquo; (\u043f\u0430\u0440. \u042d\u0444 4, 2).<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0431\u0430\u0447\u0446\u0435, \u0442\u0430\u043c, \u0434\u0437\u0435 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u043d\u0430\u043c \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e, \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043b\u044e\u0431\u043e\u045e; \u0430 \u0442\u0430\u043c, \u0434\u0437\u0435 \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0435\u0434\u043d\u0430\u0441\u0446\u0456, \u0437\u0433\u0430\u0434\u0430\u045e \u043f\u0440\u0430 \u0441\u0430\u044e\u0437 \u0441\u043f\u0430\u043a\u043e\u044e. \u0422\u0430\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0434\u043e\u043c \u0411\u043e\u0436\u044b, \u0443\u0437\u043d\u0435\u0441\u0435\u043d\u044b \u0437 \u0436\u044b\u0432\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e: \u0431\u0430\u0446\u044c\u043a\u0430 \u0441\u044f\u043c\u0435\u0439\u0441\u0442\u0432\u0430 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0436\u044b\u0432\u0435 \u045e \u0456\u043c, \u0430 \u0440\u0443\u0456\u043d\u044b, \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u043f\u0430\u0434\u0437\u0435\u043b\u0430\u043c\u0456, \u043d\u0435 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u0446\u044c \u044f\u0433\u043e \u0432\u0430\u0447\u044d\u0439.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0414\u0437 15, 8-9; 11, 18b<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0433, \u044f\u043a\u0456 \u0432\u0435\u0434\u0430\u0435 \u0441\u044d\u0440\u0446\u044b, \u0434\u0430\u045e \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c, \u044f\u043a \u0456 \u043d\u0430\u043c, \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430; <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0456\u044f\u043a\u0430\u0439 \u0440\u043e\u0437\u043d\u0456\u0446\u044b \u043f\u0430\u043c\u0456\u0436 \u043d\u0430\u043c\u0456 \u0434\u044b \u0456\u043c\u0456 \u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0430\u0447\u044b\u0441\u0446\u0456\u045e \u0456\u0445\u043d\u0456\u044f \u0441\u044d\u0440\u0446\u044b, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u043c \u0434\u0430\u045e \u0411\u043e\u0433 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0436\u044b\u0446\u0446\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043d\u0435 \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0456\u044f\u043a\u0430\u0439 \u0440\u043e\u0437\u043d\u0456\u0446\u044b \u043f\u0430\u043c\u0456\u0436 \u043d\u0430\u043c\u0456 \u0434\u044b \u0456\u043c\u0456 \u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0430\u0447\u044b\u0441\u0446\u0456\u045e \u0456\u0445\u043d\u0456\u044f \u0441\u044d\u0440\u0446\u044b, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"5081","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u0421\u0443\u043f\u0440\u0430\u0446\u044c \u0435\u0440\u0430\u0441\u044f\u045e&raquo; \u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Lib. 3, 17, 1-3: SC 34, 302-306)<\/span><br \/><span style=\"color: #ff0000;\">\u041c\u0456\u0441\u0456\u044f \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u044e\u0447\u044b \u0432\u0443\u0447\u043d\u044f\u043c \u0443\u043b\u0430\u0434\u0443 \u0430\u0434\u0440\u0430\u0434\u0436\u0430\u0446\u044c \u0443 \u0411\u043e\u0433\u0443, \u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u0456\u043c: &laquo;\u0414\u044b\u043a \u0456\u0434\u0437\u0456\u0446\u0435 \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u0439\u0446\u0435 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u0435 \u0456\u0445 \u0443 \u0456\u043c\u044f \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430, \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430&raquo; (\u041c\u0446 28, 19).<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u0433\u0430 \u0414\u0443\u0445\u0430 \u0411\u043e\u0433 \u044f\u0448\u0447\u044d \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e \u0430\u0431\u044f\u0446\u0430\u045e \u0441\u043f\u0430\u0441\u043b\u0430\u0446\u044c \u0443 \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0447\u0430\u0441\u044b \u043d\u0430 \u0441\u043b\u0443\u0433\u0430\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0440\u0430\u0440\u043e\u0447\u044b\u043b\u0456. \u0422\u0430\u043c\u0443 \u0411\u043e\u0433 \u0441\u044b\u0448\u043e\u045e \u0456 \u043d\u0430 \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e \u0421\u044b\u043d\u0430\u043c \u0427\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u043c, \u0456 \u0437\u0430\u0445\u0430\u0446\u0435\u045e \u0431\u044b\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430, \u0441\u043f\u0430\u0447\u044b\u0432\u0430\u0446\u044c \u043d\u0430 \u043b\u044e\u0434\u0437\u044f\u0445 \u0456 \u0436\u044b\u0446\u044c \u0441\u044f\u0440\u043e\u0434 \u0441\u0432\u0430\u0440\u044d\u043d\u043d\u044f \u0411\u043e\u0436\u0430\u0433\u0430, \u043a\u0430\u0431 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0432\u043e\u043b\u044e \u0410\u0439\u0446\u0430 \u0456 \u0430\u0434\u0440\u0430\u0434\u0437\u0456\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0430\u0434 \u0441\u0442\u0430\u0440\u044d\u0447\u044b \u0433\u0440\u0430\u0445\u0443 \u0434\u0430 \u043d\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u045e \u0425\u0440\u044b\u0441\u0446\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u043a\u0430\u0436\u0430 \u0441\u0432. \u041b\u0443\u043a\u0430, \u043f\u0430\u0441\u043b\u044f \u045e\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u044f \u041f\u0430\u043d\u0430 \u045e \u0434\u0437\u0435\u043d\u044c \u041f\u044f\u0446\u0456\u0434\u0437\u0435\u0441\u044f\u0442\u043d\u0456\u0446\u044b \u043d\u0430 \u0432\u0443\u0447\u043d\u044f\u045e \u0441\u044b\u0448\u043e\u045e \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u044f\u043a\u0456 \u043c\u0430\u0435 \u045e\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456, \u043a\u0430\u0431 \u043f\u0440\u044b\u0432\u0435\u0441\u0446\u0456 \u0456\u0445 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u0456\u043c \u041d\u043e\u0432\u044b \u0417\u0430\u043f\u0430\u0432\u0435\u0442. \u0422\u0430\u043c\u0443 \u044f\u043d\u044b \u0456 \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u043d\u0430 \u045e\u0441\u0456\u0445 \u043c\u043e\u0432\u0430\u0445 \u0433\u0456\u043c\u043d \u0411\u043e\u0433\u0443, \u0430 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0430\u0431&rsquo;\u044f\u0434\u043d\u043e\u045e\u0432\u0430\u045e \u0430\u0434\u0434\u0430\u043b\u0435\u043d\u044b\u044f \u043f\u043b\u044f\u043c\u0451\u043d\u044b \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u045e \u0456\u0445 \u0410\u0439\u0446\u0443 \u044f\u043a \u043f\u0435\u0440\u0448\u0443\u044e \u0430\u0445\u0432\u044f\u0440\u0443 \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u041f\u0430\u043d \u0456 \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u043d\u0430\u043c \u043f\u0430\u0441\u043b\u0430\u0446\u044c \u0421\u0443\u0446\u044f\u0448\u044b\u0446\u0435\u043b\u044f, \u043a\u0430\u0431 \u0401\u043d \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0432\u0430\u0432\u0430\u045e \u043d\u0430\u0441 \u0434\u043b\u044f \u0411\u043e\u0433\u0430. \u0411\u043e \u044f\u043a \u0431\u0435\u0437 \u0432\u0430\u0434\u044b \u043d\u0435\u043b\u044c\u0433\u0430 \u0440\u0430\u0448\u0447\u044b\u043d\u0456\u0446\u044c \u0441\u0443\u0445\u043e\u0439 \u043c\u0443\u043a\u0456 \u0456 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0437 \u044f\u0435 \u0430\u0434\u043d\u043e \u0446\u0435\u0441\u0442\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d \u0445\u043b\u0435\u0431, \u0442\u0430\u043a \u0456 \u043c\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u043c \u0441\u0442\u0430\u0446\u044c \u0430\u0434\u043d\u044b\u043c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435 \u0431\u0435\u0437 \u0432\u0430\u0434\u044b, \u044f\u043a\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u043d\u0435\u0431\u0430. \u0406 \u044f\u043a \u0441\u0443\u0445\u0430\u044f \u0437\u044f\u043c\u043b\u044f \u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u043b\u0451\u043d\u0443 \u0431\u0435\u0437 \u0432\u0456\u043b\u044c\u0433\u0430\u0446\u0456, \u0442\u0430\u043a \u0456 \u043c\u044b, \u044f\u043a\u0456\u044f \u0431\u044b\u043b\u0456 \u0437\u0430\u0441\u043e\u0445\u043b\u044b\u043c \u0434\u0440\u044d\u0432\u0430\u043c, \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0456 \u0431 \u043f\u043b\u0430\u0434\u043e\u045e \u0436\u044b\u0446\u0446\u044f \u0431\u0435\u0437 \u0434\u0430\u0436\u0434\u0436\u0443, \u0441\u043f\u0430\u0441\u043b\u0430\u043d\u0430\u0433\u0430 \u0432\u043e\u043b\u044f\u0439 \u043d\u044f\u0431\u0451\u0441\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448\u044b\u044f \u0446\u0435\u043b\u044b \u043f\u0440\u0430\u0437 \u043a\u0443\u043f\u0435\u043b\u044c, \u044f\u043a\u0430\u044f \u0434\u0430\u0435 \u043d\u0430\u043c \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c, \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u044c, \u0430 \u0434\u0443\u0448\u044b \u043d\u0430\u0448\u044b\u044f \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u045e \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0443\u0445 \u0411\u043e\u0436\u044b \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u041f\u0430\u043d\u0430, &laquo;\u0414\u0443\u0445 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f, \u0414\u0443\u0445 \u043f\u0430\u0440\u0430\u0434\u044b \u0456 \u043c\u0443\u0436\u043d\u0430\u0441\u0446\u0456, \u0414\u0443\u0445 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u044f \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u0456, \u0414\u0443\u0445 \u0431\u043e\u044f\u0437\u0456 \u0411\u043e\u0436\u0430\u0439&raquo; (\u043f\u0430\u0440. \u0406\u0441 11, 2). \u041f\u0430\u043d \u0434\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u0433\u044d\u0442\u0430\u0433\u0430 \u0414\u0443\u0445\u0430, \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u044e\u0447\u044b \u0434\u043b\u044f \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456 \u0421\u0443\u0446\u044f\u0448\u044b\u0446\u0435\u043b\u044f \u0437 \u043d\u0435\u0431\u0430 \u0442\u0443\u0434\u044b, \u043a\u0443\u0434\u044b, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u045e \u041f\u0430\u043d\u0430, &laquo;\u0434&rsquo;\u044f\u0431\u0430\u043b \u043f\u0430\u0434\u0430\u045e, \u044f\u043a \u043c\u0430\u043b\u0430\u043d\u043a\u0430&raquo; (\u043f\u0430\u0440. \u041b\u043a 10, 18). \u0422\u0430\u043c\u0443 \u043d\u0430\u043c \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u0433\u044d\u0442\u0430\u044f \u0411\u043e\u0436\u0430\u044f \u0440\u0430\u0441\u0430, \u043a\u0430\u0431 \u043c\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u0441\u043f\u0430\u043b\u0435\u043d\u044b\u044f \u0456 \u043d\u0435 \u0430\u043a\u0430\u0437\u0430\u043b\u0456\u0441\u044f \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c\u0456. \u0410 \u043a\u0430\u043b\u0456 \u045e \u043d\u0430\u0441 \u0451\u0441\u0446\u044c \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u045e\u0446\u0430, \u0451\u0441\u0446\u044c \u0456 \u0410\u0431\u0430\u0440\u043e\u043d\u0446\u0430. \u041f\u0430\u043d \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u043f\u0430\u0442\u0440\u0430\u043f\u0456\u045e \u0443 \u0440\u0443\u043a\u0456 \u0437\u043b\u043e\u0434\u0437\u0435\u044f\u045e. \u041f\u0430\u043d \u0441\u0430\u043c \u043f\u0430\u0448\u043a\u0430\u0434\u0430\u0432\u0430\u045e \u044f\u0433\u043e, \u043f\u0435\u0440\u0430\u0432\u044f\u0437\u0430\u045e \u044f\u0433\u043e\u043d\u044b\u044f \u0440\u0430\u043d\u044b, \u0434\u0430\u045e \u044f\u043c\u0443 \u0434\u0432\u0430 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0456\u044f \u0434\u044b\u043d\u0430\u0440\u044b. \u0410 \u043c\u044b, \u0430\u0442\u0440\u044b\u043c\u0430\u045e\u0448\u044b \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443 \u0432\u043e\u0431\u0440\u0430\u0437 \u0456 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u043c\u043d\u043e\u0436\u044b\u0446\u044c \u0434\u0430\u0434\u0437\u0435\u043d\u044b \u043d\u0430\u043c \u0434\u044b\u043d\u0430\u0440, \u0430 \u043f\u0430\u043c\u043d\u043e\u0436\u0430\u043d\u044b \u0432\u044f\u0440\u043d\u0443\u0446\u044c \u041f\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u0414\u0437 2, 1-2<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u045e \u0434\u0437\u0435\u043d\u044c \u041f\u044f\u0446\u0456\u0434\u0437\u0435\u0441\u044f\u0442\u043d\u0456\u0446\u044b, \u0443\u0441\u0435 \u0431\u044b\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u043d\u0430 \u0430\u0434\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b. \u0406 \u0440\u0430\u043f\u0442\u0430\u043c \u0443\u0437\u043d\u044f\u045e\u0441\u044f \u0448\u0443\u043c \u0437 \u043d\u0435\u0431\u0430, <span style=\"color: #ff0000;\">*<\/span> \u043d\u0456\u0431\u044b \u043f\u0430\u0432\u0435\u045e \u043c\u043e\u0446\u043d\u0430\u0433\u0430 \u0432\u0435\u0442\u0440\u0443, \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0443\u0432\u0435\u0441\u044c \u0434\u043e\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0432\u0443\u0447\u043d\u0456 \u0431\u044b\u043b\u0456 \u0440\u0430\u0437\u0430\u043c, \u0440\u0430\u043f\u0442\u0430\u043c \u0441\u044b\u0448\u043e\u045e \u043d\u0430 \u0456\u0445 \u0448\u0443\u043c \u0437 \u043d\u0435\u0431\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u043d\u0456\u0431\u044b \u043f\u0430\u0432\u0435\u045e \u043c\u043e\u0446\u043d\u0430\u0433\u0430 \u0432\u0435\u0442\u0440\u0443, \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0443\u0432\u0435\u0441\u044c \u0434\u043e\u043c, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"9001","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430&raquo; \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430 \u0410\u0440\u044b\u0433\u0435\u043d\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Homilia 9, 1-2: PG 12. 871-872)<\/span><br \/><em><span style=\"color: #ff0000;\">\u042f\u043a \u0436\u044b\u0432\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456 \u043c\u044b \u045e\u0442\u0432\u0430\u0440\u0430\u0435\u043c \u0434\u043e\u043c \u0456 \u0430\u043b\u0442\u0430\u0440 \u0411\u043e\u0436\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u043c\u044b, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u0437\u0430\u0432\u0435\u043c\u0441\u044f &laquo;\u0436\u044b\u0432\u044b\u043c\u0456 \u043a\u0430\u043c\u044f\u043d\u044f\u043c\u0456&raquo; \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u045e \u0441\u043b\u043e\u0432\u0430\u0445: &laquo;\u0412\u044b \u0441\u0430\u043c\u0456, \u044f\u043a \u0436\u044b\u0432\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456, \u0431\u0443\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u0434\u043e\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b, \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u044f\u0442\u043e\u0435, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u044f \u0411\u043e\u0433\u0443, \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430&raquo; (1 \u041f 2, 5).<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044f\u0434\u043e\u043c\u0430, \u043f\u0435\u0440\u0448\u044b\u043c\u0456 \u045e \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0456 \u043a\u043b\u0430\u0434\u0443\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0442\u0440\u044b\u0432\u0430\u043b\u044b\u044f \u0456 \u043c\u043e\u0446\u043d\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456, \u043a\u0430\u0431 \u043d\u0430 \u0456\u0445 \u043c\u043e\u0436\u043d\u0430 \u0431\u044b\u043b\u043e \u0437 \u043f\u044d\u045e\u043d\u0430\u0441\u0446\u044e \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0446\u044f\u0436\u0430\u0440 \u0443\u0441\u044f\u0433\u043e \u0431\u0443\u0434\u044b\u043d\u043a\u0430. \u0422\u043e\u0435 \u0441\u0430\u043c\u0430\u0435 \u0434\u0430\u0442\u044b\u0447\u044b\u0446\u044c \u0456 \u0436\u044b\u0432\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e: \u043d\u0435\u043a\u0430\u0442\u043e\u0440\u044b\u044f \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u044f\u0446\u0446\u0430 \u045e \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0430\u0445 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0431\u0443\u0434\u044b\u043d\u043a\u0430. \u0413\u044d\u0442\u044b\u043c\u0456 \u043a\u0430\u043c\u044f\u043d\u044f\u043c\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456. \u0422\u0430\u043a \u043d\u0430\u0432\u0443\u0447\u0430\u0435 \u041f\u0430\u0432\u0435\u043b, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0412\u044b \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u043d\u0430 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0434\u0437\u0435 \u0441\u0430\u043c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0432\u0443\u0433\u043b\u0430\u0432\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u0435\u043c&raquo; (\u042d\u0444 2, 20).<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0441\u043b\u0443\u0445\u0430\u0447, \u043a\u0430\u043b\u0456 \u0442\u044b \u0445\u043e\u0447\u0430\u0448 \u043b\u0435\u043f\u0448 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u0446\u0430 \u0434\u0430 \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0443 \u0433\u044d\u0442\u044b\u043c \u0431\u0443\u0434\u044b\u043d\u043a\u0443 \u0441\u0442\u0430\u0446\u044c \u0431\u043b\u0456\u0436\u044d\u0439\u0448\u044b\u043c \u0434\u0430 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443 \u043a\u0430\u043c\u0435\u043d\u0435\u043c, \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0439, \u0448\u0442\u043e \u0441\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a \u0433\u044d\u0442\u0430\u0433\u0430 \u0431\u0443\u0434\u044b\u043d\u043a\u0430. \u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b: &laquo;\u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0456\u043d\u0448\u0430\u0433\u0430 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443, \u044f\u043a \u0442\u043e\u0439, \u044f\u043a\u0456 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b \u0456 \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441&raquo; (1 \u041a\u0430\u0440 3, 11). \u0422\u0430\u043c\u0443 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f \u0442\u044b\u044f, \u0445\u0442\u043e \u045e\u0437\u043d\u0451\u0441 \u043f\u0430\u0431\u043e\u0436\u043d\u044b\u044f \u0456 \u0441\u0432\u044f\u0442\u044b\u044f \u0431\u0443\u0434\u044b\u043d\u043a\u0456 \u043d\u0430 \u0442\u0430\u043a\u0456\u043c \u0432\u044b\u0441\u0430\u043a\u0430\u0440\u043e\u0434\u043d\u044b\u043c \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u044b\u043c \u0431\u0443\u0434\u044b\u043d\u043a\u0443 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0456 \u0430\u043b\u0442\u0430\u0440. \u041c\u044f\u0440\u043a\u0443\u044e, \u0448\u0442\u043e \u0430\u043b\u0442\u0430\u0440 \u0431\u0443\u0434\u0443\u0435\u0446\u0446\u0430 \u0437 \u0442\u044b\u0445 \u0441\u044f\u0440\u043e\u0434 \u0432\u0430\u0441, \u0436\u044b\u0432\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u044f\u043a\u0456\u044f \u0437\u0434\u0430\u0442\u043d\u044b\u044f \u0434\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0456 \u0433\u0430\u0442\u043e\u0432\u044b\u044f \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u044e\u0447\u044b \u045e\u0434\u0437\u0435\u043d\u044c \u0456 \u045e\u043d\u0430\u0447\u044b \u0434\u0430 \u041f\u0430\u043d\u0430 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0447\u044b \u0430\u0445\u0432\u044f\u0440\u044b \u0441\u0432\u0430\u0456\u0445 \u043f\u0440\u043e\u0441\u044c\u0431\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u0439\u0441\u044f, \u0448\u0442\u043e \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u0445\u0432\u0430\u043b\u044b \u0433\u044d\u0442\u044b\u0445 \u0430\u043b\u0442\u0430\u0440\u043d\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e. \u041c\u0430\u0439\u0441\u0435\u0439, \u0437\u0430\u043a\u0430\u043d\u0430\u0434\u0430\u045e\u0446\u0430, \u0437\u0430\u0433\u0430\u0434\u0432\u0430\u045e, \u043a\u0430\u0431 \u0430\u043b\u0442\u0430\u0440 \u0431\u0443\u0434\u0430\u0432\u0430\u045e\u0441\u044f \u0437 \u0446\u044d\u043b\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u043d\u0435 \u0430\u0431\u0447\u0430\u0441\u0430\u043d\u044b\u0445 \u0436\u0430\u043b\u0435\u0437\u0430\u043c. \u0428\u0442\u043e \u0436 \u0433\u044d\u0442\u0430 \u0437\u0430 \u0446\u044d\u043b\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456? \u041d\u0430\u043f\u044d\u045e\u043d\u0430, \u043f\u0430\u0434 \u0442\u0430\u043a\u0456\u043c\u0456 \u0446\u044d\u043b\u044b\u043c\u0456 \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u043a\u0430\u043c\u044f\u043d\u044f\u043c\u0456 \u0440\u0430\u0437\u0443\u043c\u0435\u044e\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u044b\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b, \u044f\u043a\u0456\u044f, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u0437\u0433\u043e\u0434\u0437\u0435, \u0443\u0441\u0435 \u0440\u0430\u0437\u0430\u043c \u0441\u043a\u043b\u0430\u0434\u0430\u044e\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u043b\u0442\u0430\u0440. \u0426\u0456 \u0436 \u043d\u0435 \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u043f\u0440\u0430 \u0456\u0445, \u0448\u0442\u043e \u045e\u0441\u0435 \u044f\u043d\u044b, \u0430\u0434\u043d\u0430\u0434\u0443\u0448\u043d\u0430 \u043c\u043e\u043b\u044f\u0447\u044b\u0441\u044f \u0456 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u044e\u0447\u044b \u0441\u0432\u0430\u0435 \u0432\u0443\u0441\u043d\u044b, \u043a\u0430\u0437\u0430\u043b\u0456: &laquo;\u0422\u044b, \u041f\u0430\u043d\u0435, \u0432\u0435\u0434\u0430\u0435\u0448 \u0441\u044d\u0440\u0446\u044b \u045e\u0441\u0456\u0445&raquo; (\u0414\u0437 1, 24).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0442\u044b\u044f, \u0445\u0442\u043e \u043c\u043e\u0433 \u0430\u0434\u043d\u0430\u043c\u044b\u0441\u043d\u0430, \u0430\u0434\u043d\u0430\u0433\u0430\u043b\u043e\u0441\u043d\u0430 \u0456 \u045e \u0430\u0434\u043d\u044b\u043c \u0434\u0443\u0445\u0443 \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u043d\u0430\u043f\u044d\u045e\u043d\u0430 \u0456 \u0451\u0441\u0446\u044c \u0433\u043e\u0434\u043d\u044b\u044f \u0441\u043a\u043b\u0430\u0434\u0430\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0430\u0434\u0437\u0456\u043d \u0430\u043b\u0442\u0430\u0440, \u043d\u0430 \u044f\u043a\u0456\u043c \u0415\u0437\u0443\u0441 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0430\u0445\u0432\u044f\u0440\u0443 \u0410\u0439\u0446\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u044b\u043a\u043b\u0430\u0441\u0446\u0456 \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u043a\u0430\u0431 \u0430\u0434\u043d\u043e \u0456 \u0442\u043e\u0435 \u0436 \u0437\u0433\u043e\u0434\u043d\u0430 \u043a\u0430\u0437\u0430\u043b\u0456, \u0430\u0434\u043d\u043e \u0430\u0434\u0447\u0443\u0432\u0430\u043b\u0456, \u043d\u0435 \u0440\u043e\u0431\u044f\u0447\u044b \u043d\u0456\u0447\u043e\u0433\u0430 \u0434\u0437\u0435\u043b\u044f \u0437\u0432\u0430\u0434\u044b \u0446\u0456 \u043c\u0430\u0440\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b, \u0430\u043b\u0435 \u0442\u0440\u044b\u043c\u0430\u044e\u0447\u044b\u0441\u044f \u0430\u0434\u043d\u0430\u0433\u043e \u0434\u0443\u0445\u0443 \u0456 \u0430\u0434\u043d\u043e\u0439 \u0434\u0443\u043c\u043a\u0456, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u043f\u0440\u044b\u0434\u0430\u0442\u043d\u044b\u043c \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u0430\u043c \u0434\u043b\u044f \u0430\u043b\u0442\u0430\u0440\u043d\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u0406\u0441 2, 2. 3; \u041f\u0441 126 (125), 6<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u043e\u043c \u041f\u0430\u043d\u0430 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b \u043d\u0430 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0433\u043e\u0440 \u0456 \u045e\u0437\u0432\u044b\u0441\u0456\u045e\u0441\u044f \u043f\u0430-\u043d\u0430\u0434 \u043f\u0430\u0433\u043e\u0440\u043a\u0430\u043c\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u043f\u043e\u0439\u0434\u0443\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u0441\u043a\u0430\u0436\u0443\u0446\u044c: \u0425\u0432\u0430\u043b\u0430 \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0435\u0440\u043d\u0443\u0446\u0446\u0430 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e, \u043d\u0435\u0441\u0443\u0447\u044b \u0441\u043d\u0430\u043f\u044b \u0441\u0432\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043f\u043e\u0439\u0434\u0443\u0446\u044c \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b \u0456 \u0441\u043a\u0430\u0436\u0443\u0446\u044c: \u0425\u0432\u0430\u043b\u0430 \u0422\u0430\u0431\u0435, \u041f\u0430\u043d\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"9002","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 336, 1. 6: PL 38 [edit. 1861], 1471-1472. 1475)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0423\u0437\u0432\u044f\u0434\u0437\u0435\u043d\u043d\u0435 \u0456 \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0439 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u045e \u043d\u0430\u0441<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u044b \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u044b \u0441\u0445\u043e\u0434 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0437 \u043d\u0430\u0433\u043e\u0434\u044b \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f \u0434\u043e\u043c\u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u044b. \u0421\u0432\u044f\u0442\u044b\u043d\u044f &ndash; \u0433\u044d\u0442\u0430 \u043c\u0435\u0441\u0446\u0430 \u043d\u0430\u0448\u044b\u0445 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u045e, \u0430\u043b\u0435 \u0456 \u043c\u044b \u0441\u0430\u043c\u0456 &ndash; \u0411\u043e\u0436\u0430\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f. \u041a\u0430\u043b\u0456 \u0411\u043e\u0436\u0430\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f &ndash; \u0433\u044d\u0442\u0430 \u043c\u044b, \u0442\u043e \u043c\u044b \u0431\u0443\u0434\u0443\u0435\u043c\u0441\u044f \u0446\u044f\u043f\u0435\u0440, \u043a\u0430\u0431 \u043d\u0430\u043f\u0440\u044b\u043a\u0430\u043d\u0446\u044b \u0436\u044b\u0446\u0446\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435. \u0411\u0443\u0434\u044b\u043d\u0430\u043a, \u0430 \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u044f\u0433\u043e \u045e\u0437\u0432\u044f\u0434\u0437\u0435\u043d\u043d\u0435, \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0446\u044f\u0436\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b, \u0430\u043b\u0435 \u044f\u0433\u043e \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435, \u0448\u0442\u043e \u0430\u0434\u0431\u044b\u0432\u0430\u043b\u0430\u0441\u044f \u043f\u0430\u0434\u0447\u0430\u0441 \u044f\u0433\u043e \u043f\u0430\u0431\u0443\u0434\u043e\u0432\u044b, \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0456 \u0446\u044f\u043f\u0435\u0440, \u043a\u0430\u043b\u0456 \u0437\u0431\u0456\u0440\u0430\u044e\u0446\u0446\u0430 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0442\u0430. \u041f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u0432\u0435\u0440\u0443, \u044f\u043d\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u044f\u0446\u0446\u0430 \u044f\u043a \u0437\u0440\u044d\u0437\u0430\u043d\u044b\u044f \u045e \u043b\u0435\u0441\u0435 \u0434\u0440\u044d\u0432\u044b \u0456 \u0430\u0434\u043a\u043e\u043b\u0430\u0442\u044b\u044f \u0430\u0434 \u0433\u043e\u0440 \u043a\u0430\u043c\u044f\u043d\u0456, \u0430 \u043a\u0430\u043b\u0456 \u0456\u0445 \u043d\u0430\u0432\u0443\u0447\u0430\u044e\u0446\u044c, \u0445\u0440\u044b\u0441\u0446\u044f\u0446\u044c \u0456 \u0432\u044b\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c, \u044f\u043d\u044b, \u043d\u0456\u0431\u044b \u045e \u0440\u0443\u043a\u0430\u0445 \u0440\u0430\u0431\u043e\u0447\u044b\u0445 \u0456 \u0440\u0430\u043c\u0435\u0441\u043d\u0456\u043a\u0430\u045e, \u0430\u0431\u0447\u044d\u0441\u0432\u0430\u044e\u0446\u0446\u0430, \u0430\u043f\u0440\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u0456 \u0432\u044b\u0440\u0430\u045e\u043d\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u043c\u043e\u0433\u0443\u0446\u044c \u0443\u0442\u0432\u0430\u0440\u044b\u0446\u044c \u0411\u043e\u0436\u0443\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0456\u0445 \u0437\u043b\u0443\u0447\u044b\u0446\u044c \u043c\u043e\u0446\u043d\u0430\u044f \u043f\u043e\u0432\u044f\u0437\u044c \u043b\u044e\u0431\u043e\u0432\u0456. \u041d\u0456\u0445\u0442\u043e \u0431 \u0442\u0443\u0434\u044b \u043d\u0435 \u045e\u0432\u0430\u0439\u0448\u043e\u045e, \u043a\u0430\u043b\u0456 \u0431 \u0433\u044d\u0442\u044b\u044f \u0431\u044d\u043b\u044c\u043a\u0456 \u0456 \u043a\u0430\u043c\u044f\u043d\u0456 \u043d\u0435 \u0431\u044b\u043b\u0456 \u043f\u0440\u044b\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f \u045e \u043f\u044d\u045e\u043d\u044b\u043c \u043f\u0430\u0440\u0430\u0434\u043a\u0443, \u043a\u0430\u043b\u0456 \u0431 \u044f\u043d\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u0442\u0440\u044b\u0432\u0430\u043b\u0430 \u0437\u0432\u044f\u0437\u0430\u043d\u044b\u044f. \u0417\u0440\u044d\u0448\u0442\u044b, \u043a\u0430\u043b\u0456 \u0431\u0430\u0447\u044b\u0448, \u0448\u0442\u043e \u043d\u0430 \u043d\u0435\u0439\u043a\u0430\u0439 \u0431\u0443\u0434\u043e\u0432\u0435 \u043a\u0430\u043c\u043d\u0456 \u0456 \u0431\u044d\u043b\u044c\u043a\u0456 \u0434\u043e\u0431\u0440\u0430 \u0437\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u044b\u044f, \u0442\u044b \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430 \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0448, \u043d\u0435 \u0431\u0430\u044e\u0447\u044b\u0441\u044f \u0430\u0431\u0432\u0430\u043b\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0456 \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u0456 \u043f\u0430\u0441\u044f\u043b\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441, \u0434\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u043a\u0430\u0437\u0430\u045e: &laquo;\u041d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0434\u0430\u044e \u0432\u0430\u043c, \u043a\u0430\u0431 \u0432\u044b \u043b\u044e\u0431\u0456\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e&raquo; (\u042f\u043d 13, 34). \u041d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c \u0434\u0430\u044e \u0432\u0430\u043c. \u0411\u043e \u0432\u044b \u0431\u044b\u043b\u0456 \u0441\u0442\u0430\u0440\u044b\u043c\u0456 \u0456 \u044f\u0448\u0447\u044d \u043d\u0435 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0456 \u043c\u043d\u0435 \u0434\u043e\u043c\u0443, \u0432\u044b \u043b\u044f\u0436\u0430\u043b\u0456 \u045e \u0440\u0443\u0456\u043d\u0430\u0445. \u0422\u0430\u043c\u0443, \u043a\u0430\u0431 \u043f\u0430\u0434\u043d\u044f\u0446\u0446\u0430 \u0441\u0430 \u0441\u0442\u0430\u0440\u044d\u0447\u044b \u0432\u0430\u0448\u044b\u0445 \u0440\u0443\u0456\u043d\u0430\u045e, \u043b\u044e\u0431\u0456\u0446\u0435 \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0432\u0430\u0448\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u043c\u0430\u0435 \u043d\u0430 \u045e\u0432\u0430\u0437\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u044b \u0434\u043e\u043c, \u044f\u043a \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u0430, \u044f\u0448\u0447\u044d \u0431\u0443\u0434\u0443\u0435\u0446\u0446\u0430 \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435. \u041a\u0430\u043b\u0456 \u043f\u0430\u0441\u043b\u044f \u0431\u0430\u0431\u0456\u043b\u0451\u043d\u0441\u043a\u0430\u0439 \u043d\u044f\u0432\u043e\u043b\u0456 \u0430\u0434\u0431\u0443\u0434\u043e\u045e\u0432\u0430\u043b\u0430\u0441\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f, \u0443\u0432\u0435\u0441\u044c \u043d\u0430\u0440\u043e\u0434 \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u045e: &laquo;\u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0443 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e, \u0445\u0432\u0430\u043b\u0430 \u042f\u043c\u0443 \u043d\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456&raquo; (\u043f\u0430\u0440. \u041f\u0441 149, 1). \u0423 \u043f\u0441\u0430\u043b\u044c\u043c\u0435 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430 \u043f\u0440\u0430 \u043d\u043e\u0432\u0443\u044e \u043f\u0435\u0441\u043d\u044e, \u0430 \u0442\u0443\u0442 \u041f\u0430\u043d \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u043d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044c. \u0410 \u0448\u0442\u043e \u0436 \u0442\u0430\u043a\u043e\u0435 \u043d\u043e\u0432\u0430\u044f \u043f\u0435\u0441\u043d\u044f, \u043a\u0430\u043b\u0456 \u043d\u0435 \u043d\u043e\u0432\u0430\u044f \u043b\u044e\u0431\u043e\u045e? \u0421\u043f\u044f\u0432\u0430\u0435 \u0442\u043e\u0439, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c. \u0413\u043e\u043b\u0430\u0441 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u043f\u0435\u0432\u0430\u043a\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0436\u0430\u0440 \u0441\u0432\u044f\u0442\u043e\u0439 \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0435, \u0448\u0442\u043e \u043c\u0430\u0442\u044d\u0440\u044b\u044f\u043b\u044c\u043d\u0430 \u043f\u0430\u045e\u0441\u0442\u0430\u043b\u0430 \u045e \u043c\u0443\u0440\u0430\u0445, \u043d\u044f\u0445\u0430\u0439 \u0434\u0443\u0445\u043e\u045e\u043d\u0430 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u0446\u0430 \u045e \u0434\u0443\u0448\u0430\u0445; \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0430\u045e\u0441\u0442\u0430\u043b\u0430 \u045e \u043a\u0430\u043c\u044f\u043d\u044f\u0445 \u0456 \u0434\u0440\u044d\u0432\u0430\u0445, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u0431\u0443\u0434\u0443\u044e\u0447\u0430\u0439 \u043b\u0430\u0441\u043a\u0456 \u0411\u043e\u0436\u0430\u0439 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u0446\u0430 \u045e \u0432\u0430\u0448\u044b\u0445 \u0446\u0435\u043b\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u0435\u0440\u0448 \u0437\u0430 \u045e\u0441\u0451 \u0442\u0440\u044d\u0431\u0430 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u0432\u0430\u0446\u044c \u041f\u0430\u043d\u0443 \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443, \u0430\u0434 \u044f\u043a\u043e\u0433\u0430 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443\u0441\u0451 \u0434\u043e\u0431\u0440\u0430\u0435 \u0456 \u045e\u0441\u044f\u043a\u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0434\u0430\u0440. \u0417 \u0443\u0441\u0451\u044e \u0433\u0430\u0442\u043e\u0432\u0430\u0441\u0446\u044e \u0441\u044d\u0440\u0446\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043c \u042f\u0433\u043e \u0434\u0430\u0431\u0440\u044b\u043d\u044e, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u043f\u0430\u0431\u0443\u0434\u043e\u0432\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043e\u043c\u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0401\u043d \u043d\u0430\u0432\u0435\u0434\u0430\u045e \u0434\u0443\u0445 \u0441\u0432\u0430\u0456\u0445 \u0432\u0435\u0440\u043d\u044b\u0445, \u0430\u0431\u0443&shy;\u0434\u0437\u0456\u045e \u043b\u044e\u0431\u043e\u045e, \u0434\u0430\u045e \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443, \u043d\u0430\u0442\u0445\u043d\u0456\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u043c\u0435\u045e \u0436\u0430\u0434\u0430\u043d\u043d\u044f, \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u045e \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0434\u043e\u0431\u0440\u0430\u0439 \u0432\u043e\u043b\u0456 \u0434\u043b\u044f \u043f\u0440\u0430\u0446\u044b. \u0406 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u0430 \u0411\u043e\u0433, &laquo;\u044f\u043a\u0456 \u0447\u044b\u043d\u0456\u0446\u044c&raquo; \u0443 \u0441\u0432\u0430\u0456\u0445 &laquo;\u0436\u0430\u0434\u0430\u043d\u043d\u0435 \u0456 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043f\u0430\u0434\u0430\u0431\u0430\u043d\u043d\u044f&raquo; (\u0424\u043b\u043f 2, 13), \u0443\u0441\u0451 \u0433\u044d\u0442\u0430 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u045e \u0456 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041f\u0441 84 (83), 2-3. 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f\u043a\u0456\u044f \u043c\u0456\u043b\u044b\u044f \u0422\u0432\u0430\u0435 \u0448\u0430\u0442\u0440\u044b, \u041f\u0430\u043d\u0435 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: <span style=\"color: #ff0000;\">*<\/span> \u0437\u043d\u0435\u043c\u0430\u0433\u0430\u0435 \u0456 \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u045e \u0434\u0432\u0430\u0440\u044b \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0434\u043e\u043c\u0435 \u0422\u0432\u0430\u0456\u043c, \u044f\u043d\u044b \u0432\u0435\u0447\u043d\u0430 \u0441\u043f\u044f\u0432\u0430\u044e\u0446\u044c \u0422\u0430\u0431\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417\u043d\u0435\u043c\u0430\u0433\u0430\u0435 \u0456 \u0456\u043c\u043a\u043d\u0435\u0446\u0446\u0430 \u0434\u0443\u0448\u0430 \u043c\u0430\u044f \u045e \u0434\u0432\u0430\u0440\u044b \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"9011","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0421\u0430\u0444\u0440\u043e\u043d\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 2, In sanctissimae D\u0435iparae Annuntiatione,<\/span><br \/><span style=\"color: #ff0000;\"> 21-22. 26: PG 87, 3, 3242. 3250)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0440\u0430\u0437 \u041c\u0430\u0440\u044b\u044e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0410\u0439\u0446\u0430 \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0443<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0412\u0456\u0442\u0430\u0439, \u041c\u0430\u0440\u044b\u044f, \u043f\u043e\u045e\u043d\u0430\u044f \u043b\u0430\u0441\u043a\u0456, \u041f\u0430\u043d \u0437 \u0422\u0430\u0431\u043e\u044e&raquo; (\u043f\u0430\u0440. \u041b\u043a 1, 28). \u0428\u0442\u043e \u0436 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c, \u0447\u044b\u043c \u0433\u044d\u0442\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u043e \u0414\u0437\u0435\u0432\u0430 \u041c\u0430\u0446\u0456? \u0428\u0442\u043e \u0436 \u043c\u043e&not;\u0436\u0430 \u0431\u044b\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u0432\u044b\u0434\u0430\u0442\u043d\u044b\u043c, \u0447\u044b\u043c \u0442\u0430\u044f \u043b\u0430\u0441\u043a\u0430, \u044f\u043a\u043e\u0439 \u0430\u0434\u043d\u0430 \u0422\u044b \u045e\u0434\u0430\u0441\u0442\u043e\u0456\u043b\u0430\u0441\u044f \u0437 \u0411\u043e\u0436\u0430\u0439 \u0432\u043e\u043b\u0456? \u0428\u0442\u043e \u0436 \u043c\u043e\u0436\u043d\u0430 \u043f\u0440\u044b\u0434\u0443\u043c\u0430\u0446\u044c \u0431\u043e\u043b\u044c\u0448 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435 \u0456 \u0441\u043b\u0430\u045e\u043d\u0430\u0435? \u0423\u0441\u0451 \u0434\u0430\u043b\u0451\u043a\u0430\u0435 \u0430\u0434 \u0442\u0430\u0433\u043e \u0446\u0443\u0434\u0443, \u0448\u0442\u043e \u0437\u0434\u0430\u0440\u044b\u045e\u0441\u044f \u0437 \u0422\u0430\u0431\u043e\u044e, \u0443\u0441\u0451 \u043d\u0435\u043f\u0430\u0440\u0430\u045e\u043d\u0430\u043b\u044c\u043d\u0430\u0435 \u0437 \u0430\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u044e \u0422\u0430\u0431\u043e\u044e \u043b\u0430\u0441\u043a\u0430\u0439; \u0443\u0441\u0451 \u0441\u0442\u0430\u0456\u0446\u044c \u043d\u0430 \u0434\u0440\u0443\u0433\u0456\u043c \u043c\u0435\u0441\u0446\u044b \u0456 \u043d\u0430\u0432\u0430\u0442 \u0441\u0430\u043c\u0430\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430&shy;\u043b\u0430\u0435 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0437\u0430\u0446\u044c\u043c\u0456\u0446\u044c \u044f\u0435 \u0441\u0432\u0430\u0456\u043c \u0431\u043b\u044f\u0441\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041f\u0430\u043d \u0437 \u0422\u0430\u0431\u043e\u044e&raquo;, \u0456 \u0445\u0442\u043e \u0431 \u0430\u0434\u0432\u0430\u0436\u044b\u045e\u0441\u044f \u043f\u0430\u0440\u0430\u045e\u043d\u0430\u0446\u0446\u0430 \u0437 \u0422\u0430\u0431\u043e\u044e? \u0411\u043e\u0433 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0430\u0434 \u0426\u044f\u0431\u0435, \u0442\u0430\u043c\u0443 \u0445\u0442\u043e \u0431 \u043d\u0435 \u0445\u0430\u0446\u0435\u045e \u0443\u0441\u0442\u0443\u043f\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0422\u0430\u0431\u043e\u044e \u0456 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u044b\u0437\u043d\u0430\u0446\u044c \u0422\u0432\u0430\u0451 \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u043e? \u0420\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430\u0434 \u0422\u0432\u0430\u0456\u043c\u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u043c\u0456 \u043f\u0440\u044b\u0432\u0456\u043b\u0435\u044f\u043c\u0456 \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u043c\u0456, \u044f \u0437 \u043d\u0430\u0439\u0431\u043e\u043b\u044c\u0448\u044b\u043c \u0437\u0430\u0445\u0430\u043f\u043b\u0435\u043d\u043d\u0435\u043c \u0443\u0441\u043a\u043b\u0456\u043a\u0430\u044e: &laquo;\u0412\u0456\u0442\u0430\u0439, \u043f\u043e\u045e\u043d\u0430\u044f \u043b\u0430\u0441\u043a\u0456, \u041f\u0430\u043d \u0437 \u0422\u0430\u0431\u043e\u044e&raquo;. \u0411\u043e \u043f\u0440\u0430\u0437 \u0426\u044f\u0431\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0431\u044b\u043b\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u044f \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0443, \u0430\u043b\u0435 \u044f\u043d\u0430 \u043f\u0435\u0440\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0456 \u0437\u0432\u044b\u0448\u043f\u0440\u044b\u0440\u043e\u0434\u043d\u044b\u043c \u043c\u043e\u0446\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b &laquo;\u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430&shy;\u043c\u0456&raquo;, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0437\u043c\u044f\u043d\u0456\u043b\u0430 \u043f\u0440\u0430\u043a\u043b\u0451\u043d \u0415\u0432\u044b \u045e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435; \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b \u0422\u0432\u0430\u0451\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0437\u0435 \u0410\u0434\u0430\u043c, \u044f\u043a\u0456 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u045e\u043f\u0430\u045e \u0456 \u0431\u044b\u045e \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0410\u0439\u0446\u0430 \u043f\u0440\u0430\u0437 \u0426\u044f\u0431\u0435 \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0443 \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u043b\u0430 \u044f\u0433\u043e \u0430\u0434 \u0441\u0442\u0430\u0440\u043e\u0433\u0430 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456, \u0431\u043e \u043f\u0440\u0430\u0437 \u0446\u044f\u0431\u0435 \u0422\u0432\u0430\u0435 \u043f\u0440\u043e\u0434\u043a\u0456 \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435; \u0422\u044b \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0448 \u0456\u043c \u0417\u0431\u0430\u045e\u0446\u0443, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0456\u043c \u0411\u043e\u0436\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0431\u0435\u0437 \u043d\u0430\u0441\u0435\u043d\u043d\u044f \u0422\u044b \u0437\u0430\u0447\u0430\u043b\u0430 \u043f\u043b\u043e\u0434, \u044f\u043a\u0456 \u0430\u0434\u0430\u0440\u0430\u0435 \u0441\u0432\u0435\u0442 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0456 \u0430\u0434\u043a\u0443\u043f\u043b\u044f\u0435 \u044f\u0433\u043e \u0430\u0434 \u043f\u0440\u0430\u043a\u043b\u0451\u043d\u0443, \u0446\u0435\u0440\u043d\u0456 \u044f\u043a\u043e\u0433\u0430 \u043f\u0440\u0430\u0440\u0430\u0441\u0442\u0430\u044e\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456, \u0431\u043e, \u0445\u043e\u0446\u044c \u0422\u044b \u0456 \u0431\u044b\u043b\u0430 \u0437 \u043d\u0430\u0442\u0443\u0440\u044b \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u0439, \u0430\u0434\u043d\u0430\u043a \u0441\u0442\u0430\u043b\u0430 \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0430\u0439. \u0406 \u0442\u0430\u043c\u0443 \u0442\u043e\u0439, \u0445\u0442\u043e \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0430\u0434 \u0426\u044f\u0431\u0435, \u0433\u044d\u0442\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0411\u043e\u0433, \u0430 \u0441\u0430\u043c\u0443 \u0426\u044f\u0431\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0437\u0430\u0432\u0443\u0446\u044c \u0411\u0430\u0433\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0430\u0439, \u0431\u043e \u0422\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0448 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0441\u0432\u0430\u0456\u043c \u0443\u043b\u043e\u043d\u043d\u0456 \u0422\u044b \u043d\u043e\u0441\u0456\u0448 \u0441\u0430\u043c\u043e\u0433\u0430 \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0446\u044f\u043b\u0435\u0441\u043d\u0430 \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0422\u0430\u0431\u0435. \u0401\u043d \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0426\u044f\u0431\u0435, \u044f\u043a \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a, \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0443\u0441\u0456\u043c \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u044e\u0447\u044b \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0411\u043e\u0436\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0422\u0430\u0431\u0435, \u043e \u0414\u0437\u0435\u0432\u0430, \u044f\u043a \u0443 \u043d\u0430\u0439\u0447\u044b\u0441\u0446\u0435\u0439\u0448\u044b\u043c \u0456 \u0431\u043b\u0456\u0441\u043a\u0443&shy;\u0447\u044b\u043c \u043d\u0435\u0431\u0435, \u0411\u043e\u0433 &laquo;\u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u0441\u0432\u043e\u0439 \u0448\u0430\u0446\u0451\u0440&raquo; \u0456 \u0437 \u0426\u044f\u0431\u0435 &laquo;\u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u044f\u043a \u043c\u0430\u043b\u0430\u0434\u044b \u0441\u0430 \u0448\u043b\u044e\u0431\u043d\u0430\u0433\u0430 \u043f\u0430\u043a\u043e\u044f&raquo; (\u043f\u0430\u0440. \u041f\u0441 19 [18], 6). \u042f\u043a \u0430\u0441\u0456\u043b\u0430\u043a, \u0401\u043d \u043f\u0440\u0430\u0431\u044f\u0433\u0430\u0435 \u0441\u0432\u043e\u0439 \u0448\u043b\u044f\u0445, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0435 \u045e\u0441\u0456\u043c \u0436\u044b\u0432\u044b\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u0456 \u0440\u0430\u0441\u043f\u0430\u0441\u0446\u0456\u0440\u0430\u0435\u0446\u0446\u0430 \u0430\u0434 \u043a\u0440\u0430\u044e \u0434\u0430 \u043a\u0440\u0430\u044e \u043d\u044f\u0431\u0451\u0441\u0430\u045e, \u0401\u043d \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u045e\u0441\u0451 \u0411\u043e\u0436\u044b\u043c \u0436\u0430\u0440\u0430\u043c \u0456 \u045e \u0442\u043e\u0439 \u0436\u0430 \u0447\u0430\u0441 \u0436\u044b\u0432\u0430\u0442\u0432\u043e\u0440\u043d\u044b\u043c \u0431\u043b\u044f\u0441\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456, \u0431\u043e \u0437\u043c\u044f\u043d\u0456\u043b\u0430 \u043f\u0440\u0430\u043a\u043b\u0451\u043d \u0415\u0432\u044b \u045e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435. <span style=\"color: #ff0000;\">*<\/span> \u041f\u0440\u0430\u0437 \u0426\u044f\u0431\u0435 \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0410\u0439\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u0430\u0437 \u0426\u044f\u0431\u0435 \u043f\u0440\u043e\u0434\u043a\u0456 \u0422\u0432\u0430\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u0430\u0437 \u0426\u044f\u0431\u0435 \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0443 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0410\u0439\u0446\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"9012","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0431\u043b. \u042d\u043b\u044c\u0440\u044d\u0434\u0430, \u0430\u0431\u0430\u0442\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 20, In Nativitate beatae Mariae: PL 195, 322-324)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u0430\u0440\u044b\u044f &ndash; \u041c\u0430\u0446\u0456 \u043d\u0430\u0448\u0430\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u044b\u0434\u0437\u0435\u043c \u0434\u0430 \u042f\u0433\u043e\u043d\u0430\u0439 \u043d\u044f\u0432\u0435\u0441\u0442\u044b, \u043f\u0430\u0434\u044b\u0434\u0437\u0435\u043c \u0434\u0430 \u042f\u0433\u043e\u043d\u0430\u0439 \u041c\u0430\u0446\u0456, \u043f\u0430\u0434\u044b\u0434\u0437\u0435\u043c \u0434\u0430 \u042f\u0433\u043e \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u0439 \u0441\u043b\u0443\u0433\u0456. \u0423\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u044f \u041c\u0430\u0440\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0448\u0442\u043e \u043c\u044b \u043c\u043e\u0436\u0430\u043c \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0434\u043b\u044f \u042f\u0435? \u042f\u043a\u0456\u044f \u0434\u0430\u0440\u044b \u043c\u043e\u0436\u0430\u043c \u043f\u0440\u044b\u043d\u0435\u0441\u0446\u0456 \u0401\u0439? \u041a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0430\u0434\u0434\u0430\u0446\u044c \u0401\u0439 \u0445\u043e\u0446\u044c \u043c\u0430\u043b\u0443\u044e \u0447\u0430\u0441\u0442\u043a\u0443 \u0442\u0430\u0433\u043e, \u0447\u044b\u043c \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043d\u044b\u044f! \u041c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0434\u0430\u0432\u0430\u0446\u044c \u0401\u0439 \u043f\u0430\u0448\u0430\u043d\u0443, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0401\u0439, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0435, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u042f\u0435. \u041c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u0434\u0430\u0432\u0430\u0446\u044c \u0401\u0439 \u043f\u0430\u0448\u0430\u043d\u0443, \u0431\u043e \u0433\u044d\u0442\u0430 \u041c\u0430\u0446\u0456 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430. \u0411\u043e \u0445\u0442\u043e \u043d\u0435 \u0448\u0430\u043d\u0443\u0435 \u041c\u0430\u0446\u0456, \u0442\u043e\u0439, \u043d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u043d\u0435 \u0448\u0430\u043d\u0443\u0435 \u0456 \u0421\u044b\u043d\u0430. \u041f\u0440\u0430 \u0433\u044d\u0442\u0430 \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u041f\u0456\u0441\u0430\u043d\u043d\u0435: &laquo;\u0428\u0430\u043d\u0443\u0439 \u0431\u0430\u0446\u044c\u043a\u0443 \u0441\u0432\u0430\u0439\u0433\u043e \u0456 \u043c\u0430\u0446\u0456&raquo; (\u0417\u044b\u0445 20, 12 \u0456 \u0456\u043d\u0448.).<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u0448\u0442\u043e \u0436 \u043c\u044b \u0441\u043a\u0430\u0436\u0430\u043c, \u0431\u0440\u0430\u0442\u044b? \u0426\u0456 \u0436 \u042f\u043d\u0430 \u043d\u0435 \u043d\u0430\u0448\u0430\u044f \u041c\u0430\u0446\u0456? \u041a\u0430\u043d\u0435\u0448\u043d\u0435, \u0431\u0440\u0430\u0442\u044b, \u042f\u043d\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u044f \u041c\u0430\u0446\u0456 \u043d\u0430\u0448\u0430\u044f. \u041f\u0440\u0430\u0437 \u042f\u0435 \u043c\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456\u0441\u044f, \u0430\u043b\u0435 \u043d\u0435 \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u0443, \u0430 \u0434\u043b\u044f \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u043c\u044b, \u044f\u043a \u0432\u044b \u0432\u0435\u0440\u044b\u0446\u0435 \u0456 \u0432\u0435\u0434\u0430\u0435\u0446\u0435, \u0431\u044b\u043b\u0456 \u045e \u0441\u043c\u0435\u0440\u0446\u0456, \u0443 \u0437\u0430\u043a\u0430\u0440\u0430\u043d\u0435\u043b\u044b\u043c \u0433\u0440\u0430\u0445\u0443, \u0443 \u0437\u043c\u0440\u043e\u043a\u0443, \u0443 \u043d\u044f\u0434\u043e\u043b\u0456. \u0423 \u0441\u043c\u0435\u0440\u0446\u0456, \u0431\u043e \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0456 \u0411\u043e\u0433\u0430; \u0443 \u0437\u0430\u043a\u0430\u0440\u0430\u043d\u0435\u043b\u044b\u043c \u0433\u0440\u0430\u0445\u0443, \u0431\u043e \u0431\u044b\u043b\u0456 \u0442\u043b\u0435\u043d\u043d\u044b\u044f; \u0443 \u0446\u0435\u043c\u0440\u044b, \u0431\u043e \u0437\u0433\u0443\u0431\u0456\u043b\u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456, \u0456 \u0442\u0430\u043a \u0446\u0430\u043b\u043a\u0430\u043c \u0437\u0430\u0433\u0456\u043d\u0443\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u043d\u0430\u043a \u043d\u0430\u0448\u0430 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u0430\u0434 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0439 \u041c\u0430\u0440\u044b\u0456 \u0441\u0442\u0430\u043b\u0430 \u043d\u0430\u0448\u043c\u0430\u0442 \u043b\u0435\u043f\u0448\u044b\u043c, \u0447\u044b\u043c \u0430\u0434 \u0415\u0432\u044b, \u0431\u043e \u041c\u0430\u0440\u044b\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0417\u0430\u043c\u0435\u0441\u0442 \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u0456 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0434\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435, \u0437\u0430\u043c\u0435\u0441\u0442 \u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456 &ndash; \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u044c, \u0437\u0430\u043c\u0435\u0441\u0442 \u0446\u0435\u043c\u0440\u044b &ndash; \u0441\u0432\u044f\u0442\u043b\u043e.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043d\u0430 &ndash; \u041c\u0430\u0446\u0456 \u043d\u0430\u0448\u0430\u044f, \u041c\u0430\u0446\u0456 \u0436\u044b\u0446\u0446\u044f \u043d\u0430\u0448\u0430\u0433\u0430, \u041c\u0430\u0446\u0456 \u043d\u044f\u0442\u043b\u0435\u043d\u043d\u0430\u0441\u0446\u0456 \u043d\u0430\u0448\u0430\u0439, \u041c\u0430\u0446\u0456 \u0441\u0432\u044f\u0442\u043b\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430: &laquo;\u0401\u043d \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e \u0430\u0434 \u0411\u043e\u0433\u0430, \u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0456 \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435\u043c, \u0456 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435\u043c&raquo; (1 \u041a\u0430\u0440 1, 30).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u041c\u0430\u0446\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u0433\u044d\u0442\u0430 \u041c\u0430\u0446\u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456 \u043d\u0430\u0448\u0430\u0439, \u041c\u0430\u0446\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u043d\u0430\u0448\u0430\u0439, \u041c\u0430\u0446\u0456 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0448\u0430\u0433\u0430. \u0422\u0430\u043c\u0443 \u042f\u043d\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u0431\u043e\u043b\u044c\u0448\u0430\u044f \u041c\u0430\u0446\u0456, \u0447\u044b\u043c \u043d\u0430\u0448\u0430 \u0446\u044f\u043b\u0435\u0441\u043d\u0430\u044f \u043c\u0430\u0446\u0456. \u0422\u0430\u043c\u0443 \u043d\u0430\u0440\u0430&not;\u0434\u0436\u044d\u043d\u043d\u0435 \u0430\u0434 \u042f\u0435 \u043b\u0435\u043f\u0448\u0430\u0435, \u0431\u043e \u0437 \u042f\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u043d\u0430\u0448\u0430 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c, \u043d\u0430\u0448\u0430 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u043d\u0430\u0448\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043d\u0430\u0448\u0430 \u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u0435, \u043d\u0430\u0448\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u043a\u0430\u0436\u0430: &laquo;\u0425\u0432\u0430\u043b\u0456\u0446\u0435 \u041f\u0430\u043d\u0430 \u045e \u042f\u0433\u043e \u0441\u0432\u044f\u0442\u044b\u0445&raquo; (\u043f\u0430\u0440. \u041f\u0441 150, 1). \u041a\u0430\u043b\u0456 \u041f\u0430\u043d\u0430 \u0442\u0440\u044d\u0431\u0430 \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u0443 \u0442\u044b\u0445 \u0441\u0432\u044f\u0442\u044b\u0445, \u043f\u0440\u0430\u0437 \u044f\u043a\u0456\u0445 \u0401\u043d \u0447\u044b\u043d\u0456\u045e \u043c\u0430\u0433\u0443\u0442\u043d\u044b\u044f \u0446\u0443\u0434\u044b, \u0442\u043e \u043d\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0436 \u0442\u0440\u044d\u0431\u0430 \u042f\u0433\u043e \u0445\u0432\u0430\u043b\u0456\u0446\u044c \u0443 \u0442\u043e\u0439, \u0437 \u044f\u043a\u043e\u0439 \u0401\u043d, \u0433\u043e\u0434\u043d\u044b \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u044f, \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0446\u0435\u043b\u0430!<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u0422\u044b, \u0441\u0432\u044f\u0442\u0430\u044f \u0414\u0437\u0435\u0432\u0430 \u041c\u0430\u0440\u044b\u044f, \u0456 \u0433\u043e\u0434\u043d\u0430\u044f \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0445\u0432\u0430\u043b\u044b. <span style=\"color: #ff0000;\">*<\/span> \u0417 \u0426\u044f\u0431\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0441\u043e\u043d\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043d\u0430\u0448 \u0411\u043e\u0433, \u044f\u043a\u0456 \u043d\u0430\u0441 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0456 \u0437\u0431\u0430\u0432\u0456\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0430\u0434\u0437\u043d\u0430\u0447\u044b\u043c \u0441\u0432\u044f\u0442\u0430 \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0439 \u041f\u0430\u043d\u043d\u044b \u041c\u0430\u0440\u044b\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0417 \u0426\u044f\u0431\u0435 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430\u0441\u044f \u0441\u043e\u043d\u0446\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043d\u0430\u0448 \u0411\u043e\u0433, \u044f\u043a\u0456 \u043d\u0430\u0441 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0456 \u0437\u0431\u0430\u0432\u0456\u045e.<\/p>\r\n"}, {"GCH_CH_2_ID":"9013","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0430\u0433\u043c\u0430\u0442\u044b\u0447\u043d\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u0430\u0431 \u041a\u0430\u0441\u0446\u0451\u043b\u0435 &laquo;Lumen Gentium&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 61-62)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041c\u0430\u0446\u044f\u0440\u044b\u043d\u0441\u0442\u0432\u0430 \u041c\u0430\u0440\u044b\u0456 \u045e \u044d\u043a\u0430\u043d\u043e\u043c\u0456\u0456 \u043b\u0430\u0441\u043a\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0414\u0437\u0435\u0432\u0430, \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443 \u043f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u0430\u044f \u0440\u0430\u0437\u0430\u043c \u0437 \u0443\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u043b\u043e\u0432\u0430 \u044f\u043a \u0411\u043e\u0436\u0430\u044f \u041c\u0430\u0446\u0456, \u0431\u044b\u043b\u0430 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0437 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0411\u043e&shy;\u0436\u0430\u0433\u0430 \u041f\u0440\u043e\u0432\u0456\u0434\u0443, \u041c\u0430\u0446\u0456&not;\u043a\u0430\u0440\u043c\u0456\u0446\u0435\u043b\u044c\u043a\u0430\u0439 \u0411\u043e\u0441\u043a\u0430\u0433\u0430 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u045e\u0437\u0432\u044f\u043b\u0456\u0447\u0430\u043d\u0430\u0439 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0456\u043d&shy;\u0448\u044b\u043c\u0456, \u043f\u0430\u043f\u043b\u0435\u0447\u043d\u0456\u0446\u0430\u0439 \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u0430\u0439 \u0441\u043b\u0443\u0433\u043e\u0439 \u041f\u0430\u043d\u0430. \u0417\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b, \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e\u0447\u044b, \u043a\u043e\u0440\u043c\u044f\u0447\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u042f\u0433\u043e \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456 \u0410\u0439\u0446\u0443 \u0456 \u0446\u0435\u0440\u043f\u044f\u0447\u044b \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u0430&shy;\u0456\u043c \u0421\u044b\u043d\u0430\u043c \u043f\u0430\u0434\u0447\u0430\u0441 \u042f\u0433\u043e \u043a\u0430\u043d\u0430\u043d\u043d\u044f \u043d\u0430 \u043a\u0440\u044b\u0436\u044b, \u042f\u043d\u0430 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u0447\u0430\u043b\u0430 \u045e \u0441\u043f\u0440\u0430\u0432\u0435 \u0417\u0431\u0430\u045e\u0446\u044b \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443, \u043d\u0430\u0434\u0437\u0435\u044e \u0456 \u0430\u0434\u0434\u0430\u043d\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0434\u0437\u0435\u043b\u044f \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0437\u0432\u044b\u0448\u043f\u0440\u044b\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b\u0445 \u0434\u0443\u0448. \u0422\u0430\u043c\u0443 \u044f\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u0434\u043b\u044f \u043d\u0430\u0441 \u041c\u0430\u0446\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043b\u0430\u0441\u043a\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u0435 \u043c\u0430\u0446\u044f\u0440\u044b\u043d\u0441\u0442\u0432\u0430 \u041c\u0430\u0440\u044b\u0456 \u045e \u044d\u043a\u0430\u043d\u043e\u043c\u0456\u0456 \u043b\u0430\u0441\u043a\u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430, \u043f\u0430\u0447\u044b\u043d\u0430\u044e\u0447\u044b \u0430\u0434 \u0430\u043a\u0442\u0443 \u0437\u0433\u043e\u0434\u044b, \u044f\u043a\u0443\u044e \u043f\u0440\u044b \u0437\u0432\u0435\u0441\u0442\u0430\u0432\u0430\u043d\u043d\u0456 \u042f\u043d\u0430 \u0432\u0435\u0440\u043d\u0430 \u0432\u044b\u043a\u0430\u0437\u0430\u043b\u0430 \u0456 \u044f\u043a\u0443\u044e \u0431\u0435\u0437 \u0432\u0430\u0433\u0430\u043d\u043d\u044f \u0437\u0430\u0445\u0430\u0432\u0430\u043b\u0430 \u043f\u0430\u0434 \u043a\u0440\u044b\u0436\u0430\u043c, \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u0435\u043d\u043d\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0441\u0456\u0445 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445. \u0423\u0437\u044f\u0442\u0430\u044f \u045e \u043d\u0435\u0431\u0430, \u042f\u043d\u0430 \u043d\u0435 \u0441\u043f\u044b\u043d\u0456\u043b\u0430 \u0433\u044d\u0442\u0430\u0435 \u0437\u0431\u0430\u045e\u0447\u0430\u0435 \u0434\u0437\u0435\u044f\u043d\u043d\u0435, \u0430\u043b\u0435 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0430\u0435 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0432\u044b\u043f\u0440\u043e\u0448\u0432\u0430\u0435 \u043d\u0430\u043c \u0434\u0430\u0440\u044b \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0451\u0439 \u043c\u0430\u0446\u044f\u0440\u044b\u043d\u0441\u043a\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u042f\u043d\u0430 \u0430\u043f\u044f\u043a\u0443\u0435\u0446\u0446\u0430 \u0431\u0440\u0430\u0442\u0430\u043c\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456\u044f \u044f\u0448\u0447\u044d \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0443\u044e\u0446\u044c, \u0441\u044f\u0440\u043e\u0434 \u043f\u0440\u0430\u0446\u044b \u0456 \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u043a, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u044b\u0432\u0435\u0434\u0437\u0435\u043d\u044b \u0434\u0430 \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u044b. \u0422\u0430\u043c\u0443 \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0443\u044e \u0414\u0437\u0435\u0432\u0443 \u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0417\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0430\u0439, \u0410\u043f\u044f\u043a\u0443\u043d\u043a\u0430\u0439, \u041f\u0430\u043c\u043e\u0447\u043d\u0456\u0446\u0430\u0439, \u041f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0430\u0439. \u0410\u0434\u043d\u0430\u043a \u0433\u044d\u0442\u0430 \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0446\u0446\u0430 \u045e \u0442\u0430\u043a\u0456\u043c \u0441\u044d\u043d\u0441\u0435, \u0448\u0442\u043e \u0430\u0434 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u044d\u0444\u0435\u043a\u0442\u044b\u045e\u043d\u0430\u0441\u0446\u0456 \u0434\u0437\u0435\u044f\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u041f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430, \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435 \u0430\u0434\u044b\u043c\u0430\u0435\u0446\u0446\u0430 \u0456 \u043d\u0435 \u0434\u0430\u0434\u0430\u0435\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0456\u044f\u043a\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435 \u043d\u0435 \u043c\u043e\u0436\u0430 \u043d\u0456\u043a\u043e\u043b\u0456 \u0441\u0442\u0430\u044f\u0446\u044c \u043d\u0430\u0440\u043e\u045e\u043d\u0456 \u0437 \u0423\u0446\u0435\u043b\u0430\u045e\u043b\u0451\u043d\u044b\u043c \u0421\u043b\u043e\u0432\u0430\u043c \u0456 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u0435\u043c; \u0430\u043b\u0435 \u044f\u043a \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0430-\u0440\u043e\u0437\u043d\u0430\u043c\u0443 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u045e\u0434\u0437\u0435\u043b\u0430\u043c \u0441\u0432\u044f\u0442\u044b\u0445 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u045e \u0456 \u0432\u0435\u0440\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043a \u0435\u0434\u043d\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430 \u043f\u0430-\u0440\u043e\u0437\u043d\u0430\u043c\u0443 \u0440\u044d\u0430\u043b\u044c\u043d\u0430 \u043f\u0430\u0448\u044b\u0440\u0430\u0435\u0446\u0446\u0430 \u045e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u0445, \u0442\u0430\u043a \u0456 \u0430\u0434\u0437\u0456\u043d\u0430\u0435 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f \u043d\u0435 \u0432\u044b\u043a\u043b\u044e\u0447\u0430\u0435, \u0430\u043b\u0435 \u0430\u0431\u0443\u0434\u0436\u0430\u0435 \u045e \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u0445 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0430\u0435 \u045e\u0437\u0430\u0435\u043c\u0430\u0434\u0437\u0435\u044f\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0443\u0434\u0437\u0435\u043b\u0443 \u045e \u0430\u0434\u043d\u043e\u0439 \u043a\u0440\u044b\u043d\u0456\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b \u0431\u0435\u0437 \u0432\u0430\u0433\u0430\u043d\u043d\u044f \u0432\u044b\u0437\u043d\u0430\u0435 \u0442\u0430\u043a\u0443\u044e \u043f\u0430\u0434\u043f\u0430\u0440\u0430\u0434\u043a\u0430\u0432\u0430\u043d\u0443\u044e \u0440\u043e\u043b\u044e \u041c\u0430\u0440\u044b\u0456; \u0432\u0435\u0434\u0430\u0435 \u043f\u0440\u0430 \u044f\u0435 \u0441\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0434\u043e\u0441\u0432\u0435\u0434\u0443 \u0456 \u0441\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u044b \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e, \u043a\u0430\u0431 \u044f\u043d\u044b, \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u044f \u0433\u044d\u0442\u0430\u0439 \u043c\u0430\u0446\u044f\u0440\u044b\u043d\u0441\u043a\u0430\u0439 \u0430\u043f\u0435\u043a\u0430\u0439, \u044f\u0448\u0447\u044d \u043c\u0430\u0446\u043d\u0435\u0439 \u0433\u0430\u0440\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0430 \u041f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u043f\u0430\u0440. \u041b\u043a 1, 42<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0432\u044f\u0442\u0430\u044f \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u044f \u0414\u0437\u0435\u0432\u0430, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e, \u044f\u043a\u0456\u043c\u0456 \u043f\u0430\u0445\u0432\u0430\u043b\u0430\u043c\u0456 \u0426\u044f\u0431\u0435 \u0441\u043b\u0430\u0432\u0456\u0446\u044c, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0437\u043c\u044f\u0441\u0446\u0456\u0446\u044c \u043d\u044f\u0431\u0451\u0441\u044b, \u0422\u044b \u043d\u0430\u0441\u0456\u043b\u0430 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u044f \u0422\u044b \u043c\u0456\u0436 \u0436\u0430\u043d\u0447\u044b\u043d\u0430\u043c\u0456 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u043f\u043b\u043e\u0434 \u0443\u043b\u043e\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u043d\u0435 \u043c\u0430\u0433\u043b\u0456 \u0437\u043c\u044f\u0441\u0446\u0456\u0446\u044c \u043d\u044f\u0431\u0451\u0441\u044b, \u0422\u044b \u043d\u0430\u0441\u0456\u043b\u0430 \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"9051","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u041b\u044c\u0432\u0430 \u0412\u044f\u043b\u0456\u043a\u0430\u0433\u0430, \u043f\u0430\u043f\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 3 de natali ipsius, 2-3: Pl 54, 145-146)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0422\u0440\u044b\u0432\u0430\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u041f\u044f\u0442\u0440\u0430 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u044f \u045e\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u044e \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0456 \u0441\u0432\u0430\u044e \u043c\u0430\u0440\u0443\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0443 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u0456 \u043c\u0430\u0439\u0433\u043e \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0443. \u0411\u043e \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u043c\u044b \u0433\u043e\u0440\u0430\u0447\u0430 \u0436\u0430\u0434\u0430\u0435\u043c \u0440\u0430\u0431\u0456\u0446\u044c \u043d\u0435\u0448\u0442\u0430, \u0456 \u0442\u0430\u0434\u044b \u043a\u0440\u043e\u0445\u043a\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0430\u0431\u0446\u044f\u0436\u0430\u0440\u0432\u0430\u0435 \u043d\u0430\u0441. \u0410\u043b\u0435, \u043d\u044f\u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0433\u044d\u0442\u0430, \u0442\u0440\u044d\u0431\u0430 \u0433\u043e\u0434\u043d\u0430 \u0456 \u043f\u0430\u0431\u043e\u0436\u043d\u0430 \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0442\u0430\u043c\u0443, \u0448\u0442\u043e \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0411\u043e\u0433, \u0431\u043e \u0401\u043d \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043d\u0430\u0441. \u0401\u043d, \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0456 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b \u0421\u0432\u044f\u0442\u0430\u0440, \u0431\u0443\u0434\u0443\u0447\u044b \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c \u0434\u0430 \u043d\u0430\u0441 \u0456 \u0440\u043e\u045e\u043d\u044b\u043c \u0410\u0439\u0446\u0443, \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u0432\u0430\u044e \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u044c \u0430\u0436 \u0434\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0456 \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c, \u043a\u0430\u0431 \u0441\u0430\u043c\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0443\u0437\u0432\u044b\u0441\u0456\u0446\u044c \u0434\u0430 \u0411\u043e\u0433\u0430. \u0406 \u0445\u043e\u0446\u044c \u0401\u043d \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u043c\u043d\u043e\u0433\u0456\u043c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u0430\u043f\u0435\u043a\u0443 \u043d\u0430\u0434 \u0441\u0432\u0430\u0456\u043c\u0456 \u0430\u0432\u0435\u0447\u043a\u0430\u043c\u0456, \u0430\u0434\u043d\u0430\u043a \u0441\u0430\u043c \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0456\u043b\u044c\u043d\u0443\u0435 \u0441\u0432\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b \u0441\u0442\u0430\u0442\u0430\u043a.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043d\u0430\u0441, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0443\u0447\u044b \u0437 \u043d\u0430\u043c\u0456, \u0456 \u0437 \u042f\u0433\u043e\u043d\u0430\u0439 \u0432\u043e\u043b\u0456 \u043c\u044b \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u043c \u043d\u0430\u0434\u0437\u0435\u0439\u043d\u0430\u0435 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e. \u041d\u0430 \u0433\u044d\u0442\u044b\u043c \u0446\u0432\u0451\u0440\u0434\u044b\u043c \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0432\u044b\u0441\u043e\u043a\u0456 \u0431\u0443\u0434\u044b\u043d\u0430\u043a \u0443\u0441\u044f\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0456 \u0451\u043d \u043d\u0435 \u043f\u0430\u0445\u0456\u0441\u043d\u0435\u0446\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0440\u044b\u0432\u0430\u043b\u0430\u0441\u0446\u044c \u0432\u0435\u0440\u044b, \u044f\u043a\u0443\u044e \u041f\u0430\u043d \u043f\u0430\u0445\u0432\u0430\u043b\u0456\u045e \u0443 \u043a\u043d\u044f\u0437\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0432\u0435\u0447\u043d\u0430\u044f. \u0406 \u044f\u043a \u0442\u0440\u044b\u0432\u0430\u0435 \u0442\u043e\u0435, \u0443 \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u043f\u0430\u0432\u0435\u0440\u044b\u045e \u041f\u0451\u0442\u0440, \u0442\u0430\u043a \u0442\u0440\u044b\u0432\u0430\u0435 \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u041f\u044f\u0442\u0440\u0430 \u045e\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0443\u0441. \u0422\u0430\u043c\u0443 \u0442\u0440\u044b\u0432\u0430\u0435 \u0437\u0430\u0434\u0443\u043c\u0430\u043d\u0430\u0435 \u0442\u044b\u043c, \u0445\u0442\u043e \u0451\u0441\u0446\u044c \u041f\u0440\u0430\u045e\u0434\u0430\u0439, \u0430 \u041f\u0451\u0442\u0440, \u043d\u0430\u0431\u044b\u045e\u0448\u044b \u043c\u043e\u0446 \u0441\u043a\u0430\u043b\u044b, \u043d\u0435 \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430\u0433\u0430 \u044f\u043c\u0443 \u0441\u0442\u044b\u0440\u043d\u0430 \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043f\u0435\u0440\u0448\u044b\u043d\u0441\u0442\u0432\u043e \u043d\u0430\u0434 \u0456\u043d\u0448\u044b\u043c\u0456, \u0431\u044b\u045e \u043d\u0430\u0437\u0432\u0430\u043d\u044b \u0441\u043a\u0430\u043b\u043e\u044e \u0456 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u044b \u044f\u043a \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a, \u0443\u0441\u0442\u0430\u043d\u043e\u045e\u043b\u0435\u043d\u044b \u043a\u043b\u044e\u0447\u043d\u0456\u043a\u0430\u043c \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0456 \u0441\u0443\u0434\u0434\u0437\u0451\u044e, \u044f\u043a\u0456 \u0437\u0432\u044f\u0437\u0432\u0430\u0435 \u0456 \u0440\u0430\u0437\u0432\u044f\u0437\u0432\u0430\u0435, \u0430 \u044f\u0433\u043e \u043f\u0440\u044b\u0441\u0443\u0434\u044b \u0442\u0440\u044b\u0432\u0430\u044e\u0446\u044c \u0443 \u043d\u044f\u0431\u0451\u0441\u0430\u0445. \u041f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u0441\u0456\u043c\u0432\u0430\u043b\u0456\u0447\u043d\u044b\u044f \u043d\u0430\u0437\u0432\u044b \u043c\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u0435\u043c, \u044f\u043a\u0456\u044f \u0431\u043b\u0456\u0437\u043a\u0456\u044f \u0430\u0434\u043d\u043e\u0441\u0456\u043d\u044b \u043b\u0443\u0447\u044b\u043b\u0456 \u044f\u0433\u043e \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u043f\u0435\u0440 \u044f\u0448\u0447\u044d \u043f\u0430\u045e\u043d\u0435\u0439 \u0456 \u043c\u0430\u0446\u043d\u0435\u0439 \u0430\u0434\u0447\u0443\u0432\u0430\u0435\u0446\u0446\u0430 \u0433\u044d\u0442\u0430\u044f \u043c\u043e\u0446, \u044f\u043a\u0430\u044f \u0434\u0437\u0435\u0439\u043d\u0456\u0447\u0430\u0435 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0437\u0430\u0434\u0430\u043d\u043d\u044f\u0445 \u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u0445 \u043d\u0430\u0448\u0430\u0439 \u043f\u0430\u0441\u0430\u0434\u044b, \u0430 \u0437\u0430\u043a\u043b\u044e\u0447\u0430\u0435\u0446\u0446\u0430 \u044f\u043d\u0430 \u045e \u0442\u044b\u043c \u0456 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0442\u0430\u043c\u0443, \u043f\u0440\u0430\u0437 \u043a\u0430\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u041f\u0451\u0442\u0440.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u043a\u0430\u043b\u0456 \u043c\u044b \u043d\u0435\u0448\u0442\u0430 \u0441\u043b\u0443\u0448\u043d\u0430 \u0437\u0440\u043e\u0431\u0456\u043c \u0456 \u0441\u043b\u0443\u0448\u043d\u0430 \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0435\u043c, \u043a\u0430\u043b\u0456 \u043d\u0435\u0447\u0430\u0433\u0430 \u0432\u044b\u043f\u0440\u0430\u0441\u0456\u043c \u0443 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0433\u0430 \u0411\u043e\u0433\u0430 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u044b\u043c\u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u043c\u0456, &ndash; \u0433\u044d\u0442\u0430 \u0431\u0443\u0434\u0437\u0435 \u0441\u043f\u0440\u0430\u0432\u0430\u0439 \u0456 \u0437\u0430\u0441\u043b\u0443\u0433\u0430\u0439 \u041f\u044f\u0442\u0440\u0430, \u0431\u043e \u044f\u0433\u043e\u043d\u0430\u044f \u045e\u043b\u0430\u0434\u0430 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u0436\u044b\u0432\u0435 \u045e \u044f\u0433\u043e\u043d\u0430\u0439 \u0441\u044f\u0434\u0437\u0456\u0431\u0435 \u0456 \u044f\u0433\u043e \u0430\u045e\u0442\u0430\u0440\u044b\u0442\u044d\u0442 \u043d\u0430\u0434\u0430\u043b\u0435\u0439 \u043f\u0435\u0440\u0430\u0432\u044b\u0448\u0430\u0435 \u045e\u0441\u0451 \u0456\u043d\u0448\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u044f, \u0451\u043d \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0433\u044d\u0442\u0430 \u0432\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0437\u0430 \u0442\u043e\u0435 \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435, \u043d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u0430\u0435 \u045e \u0441\u044d\u0440\u0446\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430 \u0437 \u043d\u0430\u0445\u0442\u043d\u0435\u043d\u043d\u044f \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430. \u042f\u043d\u043e \u045e\u0437\u0432\u044b\u0448\u0430\u0435\u0446\u0446\u0430 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0437\u043c\u0435\u043d\u043b\u0456\u0432\u044b\u043c\u0456 \u043b\u044e\u0434\u0441\u043a\u0456\u043c\u0456 \u043c\u0435\u0440\u043a\u0430\u0432\u0430\u043d\u043d\u044f\u043c\u0456, \u044f\u043a \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u0430\u044f \u0441\u043a\u0430\u043b\u0430, \u0456 \u043d\u0456\u0448\u0442\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u044f\u0433\u043e \u043f\u0430\u0445\u0456\u0441\u043d\u0443\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0430 \u045e\u0441\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u041f\u0451\u0442\u0440 \u043f\u0430\u045e\u0442\u0430\u0440\u0430\u0435 \u0448\u0442\u043e\u0434\u043d\u044f: &laquo;\u0422\u044b &ndash; \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0421\u044b\u043d \u0411\u043e\u0433\u0430 \u0416\u044b\u0432\u043e\u0433\u0430&raquo; (\u041c\u0446 16, 16). \u0410 \u043a\u043e\u0436\u043d\u044b \u044f\u0437\u044b\u043a, \u044f\u043a\u0456 \u0432\u044b\u0437\u043d\u0430\u0435 \u041f\u0430\u043d\u0430, \u043a\u0456\u0440\u0443\u0435\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441\u0430\u043c \u0433\u044d\u0442\u0430\u0433\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 16, 18; \u041f\u0441 48 (47), 9<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0415\u0437\u0443\u0441 \u0441\u043a\u0430\u0437\u0430\u045e \u0421\u044b\u043c\u043e\u043d\u0443: \u0422\u044b &ndash; \u041f\u0451\u0442\u0440, \u0441\u043a\u0430\u043b\u0430, \u0456 \u043d\u0430 \u0433\u044d\u0442\u0430\u0439 \u0441\u043a\u0430\u043b\u0435 \u042f \u043f\u0430\u0431\u0443\u0434\u0443\u044e \u041a\u0430\u0441\u0446\u0451\u043b \u041c\u043e\u0439, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0431\u0440\u0430\u043c\u044b \u043f\u044f\u043a\u0435\u043b\u044c\u043d\u044b\u044f \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443\u0446\u044c \u044f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u045e \u044f\u0433\u043e \u043d\u0430\u0432\u0435\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0431\u0440\u0430\u043c\u044b \u043f\u044f\u043a\u0435\u043b\u044c\u043d\u044b\u044f \u043d\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443\u0446\u044c \u044f\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"9052","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u041a\u0430\u043c\u0435\u043d\u0442\u0430\u0440\u044b\u0439 \u0434\u0430 127 \u043f\u0441\u0430\u043b\u044c\u043c\u0430&raquo; \u0441\u0432. \u0413\u0456\u043b\u044f\u0440\u044b\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 7-10: PL 9, 696-697)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0411\u043e\u0433 \u0431\u0443\u0434\u0443\u0435 \u0456 \u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0441\u0432\u043e\u0439 \u0433\u043e\u0440\u0430\u0434<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041a\u0430\u043b\u0456 \u043d\u0435 \u041f\u0430\u043d \u0431\u0443\u0434\u0443\u0435 \u0434\u043e\u043c, \u0442\u043e \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a\u0456 \u043f\u0440\u0430\u0446\u0443\u044e\u0446\u044c \u0434\u0430\u0440\u044d\u043c\u043d\u0430&raquo; (\u041f\u0441 127 [128], 1). \u0412\u044b \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0411\u043e\u0436\u0430\u044f, \u0456 \u0411\u043e\u0436\u044b \u0414\u0443\u0445 \u0436\u044b\u0432\u0435 \u045e \u0432\u0430\u0441 (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 3, 16). \u0413\u044d\u0442\u0430 \u0434\u043e\u043c \u0456 \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0411\u043e\u0433\u0430, \u043f\u043e\u045e\u043d\u0430\u044f \u042f\u0433\u043e \u0432\u0443\u0447\u044d\u043d\u043d\u044f \u0456 \u043c\u043e\u0446\u044b \u0411\u043e\u0436\u0430\u0439, \u0456 \u0433\u044d\u0442\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u044f\u043a\u0456 \u0437\u0434\u043e\u043b\u044c\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u041f\u0430\u043d\u0430 \u045e \u0430\u0441\u0432\u044f\u0447\u0430\u043d\u0430\u0435 \u0441\u044d\u0440\u0446\u0430. \u041f\u0440\u0430 \u044f\u0433\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0441\u0430\u043b\u044c\u043c\u0456\u0441\u0442: &laquo;\u0421\u0432\u044f\u0442\u0430\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u0422\u0432\u0430\u044f, \u0433\u043e\u0434\u043d\u0430\u044f \u0437\u0434\u0437\u0456\u045e\u043b\u0435\u043d\u043d\u044f \u045e \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439&raquo; (\u043f\u0430\u0440. \u041f\u0441 65 [64], 5-6). \u0421\u0432\u044f\u0442\u0430\u0441\u0446\u044c, \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0441\u0446\u044c, \u043b\u044e\u0434\u0441\u043a\u0430\u044f \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0441\u0446\u044c &ndash; \u0432\u043e\u0441\u044c \u0448\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439 \u0434\u043b\u044f \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0430\u044f \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u0443\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u0411\u043e\u0433\u0430\u043c. \u041a\u0430\u043b\u0456 \u044f\u0435 \u045e\u0437\u0432\u044f\u0434\u0443\u0446\u044c \u043b\u044e\u0434\u0441\u043a\u0456\u044f \u0440\u0443\u043a\u0456, \u044f\u043d\u0430 \u043d\u0435 \u0432\u044b\u0441\u0442\u0430\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0432\u0443\u0447\u044d\u043d\u043d\u044f\u043c\u0456 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443, \u0430 \u043d\u0430\u0448\u044b\u044f \u043c\u0430\u0440\u043d\u044b\u044f \u043d\u0430\u043c\u0430\u0433\u0430\u043d\u043d\u0456 \u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u044b\u044f \u043a\u043b\u043e\u043f\u0430\u0442\u044b \u043d\u0435 \u0437\u0431\u0435\u0440\u0430\u0433\u0443\u0446\u044c \u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u0435 \u0442\u0440\u044d\u0431\u0430 \u0456\u043d\u0430\u043a\u0448 \u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c, \u0456\u043d\u0430\u043a\u0448 \u0437\u0431\u0435\u0440\u0430\u0433\u0430\u0446\u044c. \u042f\u0435 \u0442\u0440\u044d\u0431\u0430 \u0437\u0430\u0441\u043d\u043e\u045e\u0432\u0430\u0446\u044c \u043d\u0435 \u043d\u0430 \u0437\u044b\u0431\u043a\u0456\u043c \u0456 \u0440\u044b\u0445\u043b\u044b\u043c \u043f\u044f\u0441\u043a\u0443, \u0430\u043b\u0435 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u044f\u0435 \u043f\u0430\u0434\u043c\u0443\u0440\u0430\u043a \u043d\u0430 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u0445 \u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0413\u044d\u0442\u0443\u044e \u0441\u0432\u044f\u0442\u044b\u043d\u044e \u0442\u0440\u044d\u0431\u0430 \u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c \u0437 \u0436\u044b\u0432\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e \u0456 \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u0446\u044c \u044f\u0435 \u043d\u0430 \u0432\u0443\u0433\u043b\u0430\u0432\u044b\u043c \u043a\u0430\u043c\u0435\u043d\u0456. \u041d\u0430 \u0456\u043c, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u045e\u0437\u0430\u0435\u043c\u043d\u0430\u0439 \u043f\u043e\u0432\u044f\u0437\u0456, \u044f\u043d\u0430 \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u045e\u0437\u043d\u043e\u0441\u0456\u0446\u0446\u0430 \u0434\u0430 \u043c\u0435\u0440\u044b \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430, \u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u043b\u0430\u0441\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u0446\u044c \u044f\u0435 \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u0430\u0441\u043e\u044e \u0456 \u0445\u0430\u0440\u0430\u0441\u0442\u0432\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u044b\u043d\u044f \u043d\u0435 \u045e\u043f\u0430\u0434\u0437\u0435, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435 \u0433\u044d\u0442\u0430\u043a \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u0430\u044f \u0411\u043e\u0433\u0430\u043c \u0456 \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u0430\u044f \u043d\u0430 \u042f\u0433\u043e\u043d\u044b\u043c \u0432\u0443\u0447\u044d\u043d\u043d\u0456. \u041a\u043e\u0436\u043d\u044b \u0432\u0435\u0440\u043d\u0456\u043a &ndash; \u0434\u043e\u043c \u0411\u043e\u0436\u044b, \u0430 \u045e\u0441\u0435 \u044f\u043d\u044b \u0440\u0430\u0437\u0430\u043c \u0440\u0430\u0437\u0440\u0430\u0441\u0442\u0430\u044e\u0446\u0446\u0430 \u045e \u043f\u0440\u044b\u0433\u043e\u0436\u0443\u044e \u0456 \u0448\u044b\u0440\u043e\u043a\u0443\u044e \u0437\u0430\u0431\u0443\u0434\u043e\u0432\u0443 \u0437\u043d\u0430\u043a\u0430\u043c\u0456\u0442\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043f\u0456\u043b\u044c\u043d\u0443\u0435 \u0433\u044d\u0442\u044b \u0433\u043e\u0440\u0430\u0434 \u0443\u0436\u043e \u0434\u0430\u045e\u043d\u043e: \u0401\u043d \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u045e \u0410\u0431\u0440\u0430\u0433\u0430\u043c\u0430 \u045e \u044f\u0433\u043e \u043f\u0430\u0434\u0430\u0440\u043e\u0436\u0436\u044b; \u0437\u0430\u0445\u0430\u0432\u0430\u045e \u0406\u0441\u0430\u0430\u043a\u0430 \u0430\u0434 \u043f\u0440\u044b\u043d\u044f\u0441\u0435\u043d\u043d\u044f \u044f\u0433\u043e \u045e \u0430\u0445\u0432\u044f\u0440\u0443; \u0430\u0434\u0430\u0440\u044b\u045e \u042f\u043a\u0443\u0431\u0430, \u043a\u0430\u043b\u0456 \u0442\u043e\u0439 \u0431\u044b\u045e \u0441\u043b\u0443\u0433\u043e\u044e; \u0443\u0437\u0432\u044b\u0441\u0456\u045e \u042e\u0437\u0430\u0444\u0430, \u043f\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0433\u0430 \u045e \u0415\u0433\u0456\u043f\u0435\u0442; \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u041c\u0430\u0439\u0441\u0435\u044f \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0444\u0430\u0440\u0430\u043e\u043d\u0430; \u0432\u044b\u0431\u0440\u0430\u045e \u0415\u0437\u0443\u0441\u0430 \u041d\u0430\u0432\u0456\u043d\u0430 \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u043e\u043c \u0443 \u0432\u043e\u0439\u043d\u0430\u0445, \u0432\u044b&not;\u0437\u0432\u0430\u043b\u0456\u045e \u0414\u0430\u0432\u0456\u0434\u0430 \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0439 \u043f\u0430\u0433\u0440\u043e\u0437\u044b; \u0443\u0437\u0431\u0430\u0433\u0430\u0446\u0456\u045e \u0421\u0430\u043b\u0430\u043c\u043e\u043d\u0430 \u0434\u0430\u0440\u0430\u043c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u0456; \u0431\u044b\u045e \u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u043c\u0456; \u0443\u0437\u043d\u044f\u045e \u0443 \u043d\u0435\u0431\u0430 \u0406\u043b\u043b\u044e, \u0430 \u044f\u0433\u043e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430\u043c \u0432\u044b\u0431\u0440\u0430\u045e \u0415\u043b\u0456\u0441\u0435\u044f; \u043f\u0430\u0434\u0441\u0456\u043b\u043a\u043e\u045e\u0432\u0430\u045e \u0414\u0430\u043d\u0456\u044d\u043b\u044f; \u0442\u0440\u043e\u0445 \u0445\u043b\u0430\u043f\u0446\u043e\u045e \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u0443 \u0432\u043e\u0433&shy;\u043d\u0435\u043d\u043d\u0430\u0439 \u043f\u0435\u0447\u044b \u0432\u0456\u043b\u044c\u0433\u0430\u0446\u0446\u044e \u0440\u0430\u0441\u044b \u0456 \u044f\u043a \u0447\u0430\u0446\u0432\u0451\u0440\u0442\u044b \u0441\u0443\u043f\u0440\u0430\u0432\u0430\u0434\u0436\u0430\u045e \u0456\u0445; \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0414\u0437\u0435\u0432\u044b \u0456 \u043f\u0440\u0430\u0437 \u0430\u043d\u0451\u043b\u0430 \u0440\u0430\u0441\u0441\u0435\u044f\u045e \u043d\u0435\u0441\u043f\u0430\u043a\u043e\u0439 \u042e\u0437\u0430\u0444\u0430; \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u041c\u0430\u0440\u044b\u044e; \u043f\u0430\u0441\u043b\u0430\u045e \u043f\u0435\u0440\u0430\u0434 \u0441\u0430\u0431\u043e\u0439 \u042f\u043d\u0430; \u0432\u044b\u0431\u0440\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e; \u043c\u0430\u043b\u0456\u045e \u0410\u0439\u0446\u0430, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041e\u0439\u0447\u0430 \u0441\u0432\u044f\u0442\u044b, \u0437\u0430\u0445\u0430\u0432\u0430\u0439 \u0456\u0445. \u041a\u0430\u043b\u0456 \u042f \u0431\u044b\u045e \u0437 \u0456\u043c\u0456, \u042f \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u045e \u0456\u0445 \u0443 \u0456\u043c\u0435\u043d\u0456 \u0422\u0432\u0430\u0456\u043c&raquo; (\u043f\u0430\u0440. \u042f\u043d 17, 11-12). \u0410 \u043f\u0430\u0441\u043b\u044f \u0441\u0432\u0430\u0451\u0439 \u043c\u0443\u043a\u0456 \u0401\u043d \u0430\u0431\u044f\u0446\u0430\u0435 \u043d\u0430\u043c \u0441\u0432\u0430\u044e \u0432\u0435\u0447\u043d\u0443\u044e \u0430\u043f\u0435\u043a\u0443, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0406 \u0432\u043e\u0441\u044c \u042f \u0437 \u0432\u0430\u043c\u0456 \u0432\u0430 \u045e\u0441\u0435 \u0434\u043d\u0456 \u0430\u0436 \u0434\u0430 \u0441\u043a\u0430\u043d\u0447\u044d\u043d\u043d\u044f \u0432\u0435\u043a\u0443&raquo; (\u041c\u0446 28, 20).<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043d\u0435 \u043f\u0435\u0440\u0430\u0441\u0442\u0430\u0435 \u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u044b \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u044b \u0456 \u0432\u0435\u0447\u043d\u044b \u0433\u043e\u0440\u0430\u0434. \u0401\u043d \u0451\u0441\u0446\u044c \u0443 \u043a\u043e\u0436\u043d\u044b\u043c \u0437 \u043d\u0430\u0441 \u0456 \u043f\u0430\u0448\u044b\u0440\u0430\u0435\u0446\u0446\u0430, \u043a\u0430\u043b\u0456 \u0437 \u043c\u043d\u043e\u0433\u0456\u0445 \u043c\u044b \u0437\u043b\u0443\u0447\u0430\u0435\u043c\u0441\u044f \u045e \u0430\u0434\u043d\u043e. \u0411\u043e\u0433 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0431\u0443\u0434\u0443\u0435 \u0433\u043e\u0440\u0430\u0434, \u0456 \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u0440\u0430\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u0446\u0430, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456. \u0414\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c \u043d\u0430\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u043d\u0435 \u0430\u0434\u0440\u0430\u0437\u0443 \u043f\u0430\u0441\u043b\u044f \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u0443\u0434\u043e\u045e\u043b\u0456, \u0430 \u043d\u0430 \u044f\u0435 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0456 \u043f\u0430 \u043c\u0435\u0440\u044b \u044f\u0435 \u0437\u0430\u0432\u044f\u0440\u0448\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 2, 4-5; \u041f\u0441 118 (117), 22<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u044b\u0441\u0442\u0443\u043f\u0430\u044e\u0447\u044b \u0434\u0430 \u041f\u0430\u043d\u0430, \u0436\u044b\u0432\u043e\u0433\u0430 \u043a\u0430\u043c\u0435\u043d\u044f, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u0432\u044b \u0441\u0430\u043c\u0456, \u044f\u043a \u0436\u044b\u0432\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456, \u0431\u0443\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u0434\u043e\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b, \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u044f\u0442\u043e\u0435, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u044f \u0411\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u044d\u0442\u0430 \u043a\u0430\u043c\u0435\u043d\u044c, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u0432\u0443\u0433\u043b\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0432\u044b \u0441\u0430\u043c\u0456, \u044f\u043a \u0436\u044b\u0432\u044b\u044f \u043a\u0430\u043c\u044f\u043d\u0456, \u0431\u0443\u0434\u0443\u0439\u0446\u0435\u0441\u044f \u045e \u0434\u043e\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u044b, \u0441\u0432\u044f\u0442\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u044f\u0442\u043e\u0435, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u044f \u0430\u0445\u0432\u044f\u0440\u044b, \u043f\u0440\u044b\u0435\u043c\u043d\u044b\u044f \u0411\u043e\u0433\u0443 \u043f\u0440\u0430\u0437 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"9053","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0424\u0443\u043b\u044c\u0433\u0435\u043d\u0442\u044b\u044f \u0420\u0443\u0441\u043f\u0435\u043d\u0441\u043a\u0430\u0433\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 1, 2-3: CCL 91 A, 889-890)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0412\u0435\u0440\u043d\u044b \u0456 \u0440\u0430\u0437\u0443\u043c\u043d\u044b \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0416\u0430\u0434\u0430\u044e\u0447\u044b \u043f\u0430\u043a\u0430\u0437\u0430\u0446\u044c \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b \u0430\u0431\u0432\u044f\u0437\u0430\u043a \u0442\u044b\u0445 \u0441\u043b\u0443\u0433\u0430\u045e, \u044f\u043a\u0456\u0445 \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0434\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443, \u041f\u0430\u043d \u043a\u0430\u0436\u0430: &laquo;\u0425\u0442\u043e \u0436 \u0432\u0435\u0440\u043d\u044b \u0456 \u0440\u0430\u0437\u0443\u043c\u043d\u044b \u044d\u043a\u0430\u043d\u043e\u043c, \u044f\u043a\u043e\u0433\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u045e \u043d\u0430\u0434 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u043c\u0456 \u0434\u0430\u0432\u0430\u0446\u044c \u0456\u043c \u0443 \u0441\u0432\u043e\u0439 \u0447\u0430\u0441 \u043c\u0435\u0440\u0443 \u0445\u043b\u0435\u0431\u0430? \u0428\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0442\u043e\u0439 \u0441\u043b\u0443\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440 \u044f\u0433\u043e\u043d\u044b, \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435, \u0437\u0430\u0441\u0442\u0430\u043d\u0435, \u0448\u0442\u043e \u0451\u043d \u0442\u0430\u043a \u0440\u043e\u0431\u0456\u0446\u044c&raquo; (\u041b\u043a 12, 42-43).<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0436 \u0433\u044d\u0442\u044b \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440, \u0431\u0440\u0430\u0442\u044b? \u041d\u0435\u0441\u0443\u043c\u043d\u0435\u043d\u043d\u0430, \u0433\u044d\u0442\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430 \u0441\u0432\u0430\u0456\u043c \u0432\u0443\u0447\u043d\u044f\u043c: &laquo;\u0412\u044b \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0446\u0435 \u041c\u044f\u043d\u0435 \u041d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u043a\u0430\u043c \u0456 \u041f\u0430\u043d\u0430\u043c \u0456 \u0434\u043e\u0431\u0440\u0430 \u043a\u0430\u0436\u0430\u0446\u0435, \u0431\u043e \u042f \u0456\u043c \u0451\u0441\u0446\u044c&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0437 \u043a\u0430\u0433\u043e \u0441\u043a\u043b\u0430\u0434\u0430\u0435\u0446\u0446\u0430 \u0441\u044f\u043c&rsquo;\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430? \u0413\u044d\u0442\u0430 \u0442\u044b\u044f, \u043a\u0430\u0433\u043e \u0441\u0430\u043c \u041f\u0430\u043d \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0437 \u0440\u0443\u043a \u0432\u043e\u0440\u0430\u0433\u0430 \u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u0432\u0430\u0451\u0439 \u0443\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044e. \u0413\u044d\u0442\u0430 \u0441\u0432\u044f\u0442\u044b \u043f\u0430\u045e\u0441\u044e\u0434\u043d\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a\u0456 \u0442\u0430\u043a \u0431\u0430\u0433\u0430\u0442\u0430 \u0456 \u043f\u043b\u0451\u043d\u043d\u0430 \u043f\u0430\u0448\u044b\u0440\u0430\u0435\u0446\u0446\u0430 \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0456 \u0445\u0432\u0430\u043b\u0456\u0446\u0446\u0430 \u0442\u044b\u043c, \u0448\u0442\u043e \u0451\u043d \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b \u043d\u0430\u0439\u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u0430\u0439 \u041a\u0440\u044b\u0432\u0451\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u041f\u0430\u043d\u0430. \u0401\u043d \u0441\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u042f \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0435 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u041c\u043d\u0435 \u0441\u043b\u0443\u0436\u044b\u043b\u0456, \u0430\u043b\u0435 \u043a\u0430\u0431 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0456 \u0430\u0434\u0434\u0430\u0446\u044c \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451 \u0434\u0437\u0435\u043b\u044f \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u043c\u043d\u043e\u0433\u0456\u0445&raquo; (\u043f\u0430\u0440. \u041c\u0446 20, 28).<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d &ndash; \u0414\u043e\u0431\u0440\u044b \u041f\u0430\u0441\u0442\u044b\u0440, \u044f\u043a\u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0437\u0430 \u0430\u0432\u0435\u0447\u0430\u043a. \u0410 \u0441\u0442\u0430\u0442\u0430\u043a \u0434\u043e\u0431\u0440\u0430\u0433\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0441\u044f\u043c&rsquo;\u044f \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0445\u0442\u043e \u0433\u044d\u0442\u044b \u0432\u0435\u0440\u043d\u044b \u0456 \u0440\u0430\u0437\u0443\u043c\u043d\u044b \u044d\u043a\u0430\u043d\u043e\u043c? \u041f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u043d\u0430\u043c \u044f\u0433\u043e \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b, \u044f\u043a\u0456 \u043a\u0430\u0436\u0430 \u043f\u0440\u0430 \u0441\u044f\u0431\u0435 \u0456 \u0441\u0432\u0430\u0456\u0445 \u043f\u0430\u043f\u043b\u0435\u0447\u043d\u0456\u043a\u0430\u045e: &laquo;\u041d\u044f\u0445\u0430\u0439 \u043b\u044e\u0434\u0437\u0456 \u043b\u0456\u0447\u0430\u0446\u044c \u043d\u0430\u0441 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u043c\u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446 \u0411\u043e\u0436\u044b\u0445. \u0410\u0434 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u045e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435\u0446\u0446\u0430, \u043a\u0430\u0431 \u043a\u043e\u0436\u043d\u044b \u0437 \u0456\u0445 \u0430\u043a\u0430\u0437\u0430\u045e\u0441\u044f \u0432\u0435\u0440\u043d\u044b\u043c&raquo; (1 \u041a\u0430\u0440 4, 1-2).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u043d\u044f\u0445\u0430\u0439 \u043d\u0456\u0445\u0442\u043e \u0437 \u0432\u0430\u0441 \u043d\u0435 \u0434\u0443\u043c\u0430\u0435, \u0448\u0442\u043e \u0442\u043e\u043b\u044c\u043a\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0433\u044d\u0442\u044b\u043c\u0456 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u043c\u0456, \u0456 \u043d\u0435 \u0437\u0430\u0441\u044b\u043d\u0430\u0435, \u0437\u0430\u043d\u044f\u0434\u0431\u0430\u045e\u0448\u044b \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f, \u044f\u043a \u043d\u044f\u0432\u0435\u0440\u043d\u044b \u0456 \u043d\u044f\u0434\u0431\u0430\u0439\u043d\u044b \u0441\u043b\u0443\u0433\u0430. \u0421\u0432\u044f\u0442\u044b \u041f\u0430\u0432\u0435\u043b \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u043c\u0456 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u0411\u0456\u0441\u043a\u0443\u043f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0431\u044b\u0446\u044c \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c \u044f\u043a \u0440\u0430\u0441\u043f\u0430\u0434\u0447\u044b\u043a \u0411\u043e\u0436\u044b&raquo; (\u0426\u0456\u0442 1, 7).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c, \u043c\u044b \u043d\u0430\u043b\u0435\u0436\u044b\u043c \u0434\u0430 \u0441\u044f\u043c&rsquo;\u0456 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u043c\u0441\u044f \u0411\u043e\u0436\u044b\u043c\u0456 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u043c\u0456, \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043c\u0435\u0440\u0443 \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0443, \u044f\u043a\u0443\u044e \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0432\u044b\u0434\u0430\u0432\u0430\u0446\u044c \u0432\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043a\u0430\u043b\u0456 \u0441\u043f\u044b\u0442\u0430\u0435\u043c\u0441\u044f, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0437\u0430 \u043c\u0435\u0440\u0430 \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0443, \u0442\u043e \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0432\u044f\u0442\u044b \u0430\u043f\u043e\u0441\u0442\u0430\u043b \u041f\u0430\u0432\u0435\u043b \u0442\u043b\u0443\u043c\u0430\u0447\u044b\u0446\u044c \u043d\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041a\u043e\u0436\u043d\u0430\u043c\u0443 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u0435\u0440\u044b, \u044f\u043a\u0443\u044e \u0411\u043e\u0433 \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u044b\u045e&raquo; (\u0420\u044b\u043c 12, 3).<br \/>\u0422\u0443\u044e \u043c\u0435\u0440\u0443 \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0443, \u043f\u0440\u0430 \u044f\u043a\u0443\u044e \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u041f\u0430\u0432\u0435\u043b \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u043c\u0435\u0440\u0430\u044e \u0432\u0435\u0440\u044b, \u043a\u0430\u0431 \u043c\u044b \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f, \u0448\u0442\u043e \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0430\u043c \u0432\u0435\u0440\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0456\u0448\u0442\u043e \u0456\u043d\u0448\u0430\u0435, \u044f\u043a \u0433\u043e\u0434\u043d\u0430\u044f \u043f\u0430\u0448\u0430\u043d\u044b \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0430\u0439 \u0432\u0435\u0440\u044b. \u0413\u044d\u0442\u0443\u044e \u043c\u0435\u0440\u0443 \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0443 \u043c\u044b \u045e\u0434\u0437\u044f\u043b\u044f\u0435\u043c \u0432\u0430\u043c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u045e \u0456\u043c\u044f \u041f\u0430\u043d\u0430, \u043a\u0430\u043b\u0456 \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u044f \u0434\u0430\u0440\u0430\u043c \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0456, \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435\u043c \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043f\u0440\u0430\u0432\u0456\u043b\u0430\u043c \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0439 \u0432\u0435\u0440\u044b, \u0430 \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0446\u0435 \u0430\u0434 \u044f\u0435 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u045e \u041f\u0430\u043d\u0441\u043a\u0456\u0445, \u043a\u0430\u043b\u0456 \u0448\u0442\u043e\u0434\u043d\u044f \u0441\u043b\u0443\u0445\u0430\u0435\u0446\u0435 \u0441\u043b\u043e\u0432\u0430 \u043f\u0440\u0430\u045e\u0434\u044b, \u044f\u043a\u043e\u0435 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c \u0432\u0430\u043c \u0411\u043e\u0436\u044b\u044f \u0441\u043b\u0443\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 25, 21. 20<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u043e\u0431\u0440\u0430, \u0441\u043b\u0443\u0433\u0430 \u0434\u043e\u0431\u0440\u044b \u0456 \u0432\u0435\u0440\u043d\u044b, \u0443 \u043c\u0430\u043b\u044b\u043c \u0442\u044b \u0431\u044b\u045e \u0432\u0435\u0440\u043d\u044b, \u043d\u0430\u0434 \u043c\u043d\u043e\u0433\u0456\u043c \u0446\u044f\u0431\u0435 \u043f\u0430\u0441\u0442\u0430\u045e\u043b\u044e. <span style=\"color: #ff0000;\">*<\/span> \u0423\u0432\u0430\u0439\u0434\u0437\u0456 \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0442\u0432\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0413\u0430\u0441\u043f\u0430\u0434\u0430\u0440, \u043f\u044f\u0446\u044c \u0442\u0430\u043b\u0430\u043d\u0442\u0430\u045e \u0442\u044b \u0434\u0430\u045e \u043c\u043d\u0435, \u0432\u043e\u0441\u044c \u044f\u0448\u0447\u044d \u043f\u044f\u0446\u044c \u0442\u0430\u043b\u0430\u043d\u0442\u0430\u045e \u044f \u0437\u0430\u0440\u0430\u0431\u0456\u045e \u043d\u0430 \u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0432\u0430\u0439\u0434\u0437\u0456 \u045e \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430 \u0442\u0432\u0430\u0439\u0433\u043e.<\/p>\r\n"}, {"GCH_CH_2_ID":"9054","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u044d\u043a\u0440\u044d\u0442 \u043f\u0440\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u0456 \u0436\u044b\u0446\u0446\u0451 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e &laquo;Presbyterorum ordinis&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(N. 12)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u044b \u043f\u0440\u044b\u043f\u0430\u0434\u0430\u0431\u043d\u044f\u044e\u0446\u0446\u0430 \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0421\u0432\u044f\u0442\u0430\u0440\u0430 \u044f\u043a \u0441\u043b\u0443\u0433\u0456 \u0413\u0430\u043b\u0430\u0432\u044b, \u043a\u0430\u0431, \u0431\u0443\u0434\u0443\u0447\u044b \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u043a\u0430\u043c\u0456 \u0431\u0456\u0441\u043a\u0443\u043f\u0441\u043a\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u0443, \u0431\u0443\u0434\u0430\u0432\u0430\u0446\u044c \u0456 \u0441\u0442\u0432\u0430\u0440\u0430\u0446\u044c \u042f\u0433\u043e \u0446\u0435\u043b\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b. \u0423\u0436\u043e \u045e \u043a\u0430\u043d\u0441\u044d\u043a\u0440\u0430\u0446\u044b\u0456 \u0445\u0440\u043e\u0441\u0442\u0443 \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456, \u044f\u043a \u0456 \u045e\u0441\u0435 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0435, \u0437\u043d\u0430\u043a \u0456 \u0434\u0430\u0440 \u0442\u0430\u043a\u043e\u0433\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0433\u0430 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u044f \u0456 \u043b\u0430\u0441\u043a\u0456, \u043a\u0430\u0431 \u043d\u0430\u0432\u0430\u0442 \u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456 \u044f\u043d\u044b \u043c\u0430\u0433\u043b\u0456 \u0456 \u0431\u044b\u043b\u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043d\u044b \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u045e \u041f\u0430\u043d\u0430: &laquo;\u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456, \u044f\u043a \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b \u0410\u0439\u0446\u0435\u0446 \u0432\u0430\u0448 \u041d\u044f\u0431\u0435\u0441\u043d\u044b&raquo; (M\u0446 5, 48). \u0414\u0430 \u0433\u044d\u0442\u0430\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u044b \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043d\u044b \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430, \u0431\u043e \u044f\u043d\u044b, \u043f\u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b\u044f \u0411\u043e\u0433\u0443 \u043d\u043e\u0432\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0443 \u043c\u043e\u043c\u0430\u043d\u0442 \u043f\u0440\u044b\u043d\u044f\u0446\u0446\u044f \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f, \u0441\u0442\u0430\u043b\u0456 \u0436\u044b\u0432\u044b\u043c\u0456 \u043f\u0440\u044b\u043b\u0430\u0434\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430, \u0412\u0435\u0447\u043d\u0430\u0433\u0430 \u0421\u0432\u044f\u0442\u0430\u0440\u0430, \u043a\u0430\u0431 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0446\u044c \u0443 \u0447\u0430\u0441\u0435 \u042f\u0433\u043e \u0446\u0443\u0434\u043e\u045e\u043d\u0443\u044e \u0441\u043f\u0440\u0430\u0432\u0443, \u043f\u0440\u0430\u0437 \u044f\u043a\u0443\u044e \u0401\u043d \u0441\u0432\u0430\u0451\u0439 \u043c\u043e\u0446\u0430\u044e \u0437 \u0432\u044b\u0448\u044b\u043d\u0456 \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u0443\u0441\u0451 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043a\u043e\u0436\u043d\u044b \u0441\u0432\u044f\u0442\u0430\u0440 \u0443\u043b\u0430\u0441\u0446\u0456\u0432\u044b\u043c \u044f\u043c\u0443 \u0447\u044b\u043d\u0430\u043c \u0443\u0432\u0430\u0441\u0430\u0431\u043b\u044f\u0435 \u0441\u0430\u043c\u043e\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0451\u043d \u0430\u0434\u043e\u0440\u0430\u043d\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0439, \u043a\u0430\u0431, \u0441\u043b\u0443\u0436\u0430\u0447\u044b \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u0430\u043c\u0443 \u044f\u043c\u0443 \u043b\u044e\u0434\u0443 i \u045e\u0441\u044f\u043c\u0443 \u0411\u043e\u0436\u0430\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443, \u044f\u043c\u0443 \u0431\u044b\u043b\u043e \u043b\u044f\u0433\u0447\u044d\u0439 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u0442\u0430\u0433\u043e, \u043a\u0430\u0433\u043e \u0451\u043d \u043f\u0440\u0430\u0434\u0441\u0442\u0430\u045e\u043b\u044f\u0435, i \u043a\u0430\u0431 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 \u0431\u044b\u043b\u0430 \u0432\u044b\u043b\u0435\u0447\u0430\u043d\u0430 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0442\u0430\u045e \u0434\u043b\u044f \u043d\u0430\u0441 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u0421\u0432\u044f\u0442\u0430\u0440\u043e\u043c, \u0441\u0432\u044f\u0442\u044b\u043c, \u043d\u044f\u0432\u0456\u043d\u043d\u044b\u043c, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c, \u0430\u0434\u043b\u0443\u0447\u0430\u043d\u044b\u043c \u0430\u0434 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e (\u043f\u0430\u0440. \u0413\u0431\u0440 7, 26).<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u044f\u043a\u043e\u0433\u0430 \u0410\u0439\u0446\u0435\u0446 \u0430\u0441\u0432\u044f\u0446\u0456\u045e, \u0433. \u0437\u043d. \u043a\u0430\u043d\u0441\u044d\u043a\u0440\u0430\u0432\u0430\u045e, \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0443 \u0441\u0432\u0435\u0442, \u0456 &laquo;\u044f\u043a\u0456 \u0430\u0434\u0434\u0430\u045e \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435 \u0437\u0430 \u043d\u0430\u0441, \u043a\u0430\u0431 \u0430\u0434\u043a\u0443\u043f\u0456\u0446\u044c \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u044f \u0456 \u0430\u0447\u044b\u0441\u0446\u0456\u0446\u044c \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u043d\u0430\u0440\u043e\u0434 \u0432\u044b\u0431\u0440\u0430\u043d\u044b, \u0440\u0443\u043f\u043b\u0456\u0432\u044b \u045e \u0434\u043e\u0431\u0440\u044b\u0445 \u0443\u0447\u044b\u043d\u043a\u0430\u0445&raquo; (\u0426\u0456\u0442 2, 14), \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u043f\u0440\u0430\u0437 \u043c\u0443\u043a\u0443 \u045e \u0441\u0432\u0430\u044e \u0445\u0432\u0430\u043b\u0443. \u0422\u0430\u043a\u0456\u043c \u0436\u0430 \u0447\u044b\u043d\u0430\u043c \u0456 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u044b, \u043a\u0430\u043d\u0441\u044d\u043a\u0440\u0430\u0432\u0430\u043d\u044b\u044f \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u043f\u0430\u0441\u043b\u0430\u043d\u044b\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0443\u0442\u0430\u0439\u043c\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u045e\u0447\u044b\u043d\u043a\u0456 \u0446\u0435\u043b\u0430 \u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u0430\u0434\u0434\u0430\u044e\u0446\u0446\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044e \u043b\u044e\u0434\u0437\u044f\u043c, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0447\u0430\u043c\u0443 \u043c\u043e\u0433\u0443\u0446\u044c \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456, \u044f\u043a\u043e\u0439 \u0431\u044b\u043b\u0456 \u0430\u0434\u043e\u0440\u0430\u043d\u044b \u045e \u0425\u0440\u044b\u0441\u0446\u0435, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u044b\u043c\u0456 \u043c\u0443\u0436\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b \u043f\u0430\u0441\u043b\u0443\u0433\u0443 \u0414\u0443\u0445\u0430 i \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u044b \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u044e\u0446\u0446\u0430 \u045e \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0432\u044b\u043a\u0430\u0437\u0432\u0430\u044e\u0446\u044c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u044c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u043c\u0443 \u0414\u0443\u0445\u0443, \u044f\u043a\u0456 \u0456\u0445 \u0430\u0436\u044b\u045e\u043b\u044f\u0435 \u0456 \u0432\u044f\u0434\u0437\u0435. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0430\u043c\u0456\u043c \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u044b\u043c \u0441\u0430\u043a\u0440\u0430\u043b\u044c\u043d\u044b\u043c \u0434\u0437\u0435\u044f\u043d\u043d\u044f\u043c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0437 \u0443\u0441\u0451 \u0441\u0432\u0430\u0451 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435, \u044f\u043a\u043e\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0437 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u043c i \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u043c\u0456, \u044f\u043d\u044b \u0456\u0434\u0443\u0446\u044c \u0434\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456 \u0436\u044b\u0446\u0446\u044f. \u0421\u0430\u043c\u0430 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e \u0437\u043d\u0430\u0447\u043d\u0430 \u0441\u043f\u0440\u044b\u044f\u0435 \u043f\u043b\u0451\u043d\u043d\u0430\u043c\u0443 \u0432\u044b\u043a\u0430\u043d\u0430\u043d\u043d\u044e \u0456\u0445 \u043f\u0430\u0441\u043b\u0443\u0433\u0456. \u0425\u043e\u0446\u044c \u0411\u043e\u0436\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u043c\u043e\u0436\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u0443 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043f\u0440\u0430\u0437 \u043f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u0446\u0442\u0432\u0430 \u043d\u044f\u0433\u043e\u0434\u043d\u044b\u0445 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u045e, \u0430\u0434\u043d\u0430\u043a \u0437\u0432\u044b\u0447\u0430\u0439\u043d\u0430 \u0411\u043e\u0433 \u0436\u0430\u0434\u0430\u0435 \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0446\u044c \u0441\u0432\u0430\u0435 \u0446\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u043f\u0440\u0430\u0437 \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u044b\u045e \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u044f\u043c \u0456 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u0446\u0442\u0432\u0443 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u0445\u0442\u043e \u043c\u043e\u0436\u0430 \u0437 \u0443\u0432\u0430\u0433\u0456 \u043d\u0430 \u0441\u0432\u0430\u0451 \u0446\u0435\u0441\u043d\u0430\u0435 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u043d\u0435 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c i \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u0436\u044b\u0446\u0446\u044f \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c: &laquo;\u0423\u0436\u043e \u043d\u0435 \u044f \u0436\u044b\u0432\u0443, \u0430 \u0436\u044b\u0432\u0435 \u045e\u0432\u0430 \u043c\u043d\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441&raquo; (\u0413\u0430\u043b 2, 20).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u0422\u044d\u0441 2, 8; \u0413\u0430\u043b 4, 19<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u044b \u0437 \u0447\u0443\u043b\u0430\u0441\u0446\u0456 \u0434\u0430 \u0432\u0430\u0441 \u043f\u0430\u0436\u0430\u0434\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u0432\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0436\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0430\u043b\u0435 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0451, <span style=\"color: #ff0000;\">*<\/span> \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0437\u0435\u0446\u0456 \u043c\u0430\u0435, \u044f \u0437\u043d\u043e\u045e \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u044e \u0432\u0430\u0441 \u0443 \u043c\u0443\u043a\u0430\u0445, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0432\u0430\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0432\u044b \u0441\u0442\u0430\u043b\u0456 \u0434\u043b\u044f \u043d\u0430\u0441 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u043c\u0456.<\/p>\r\n"}, {"GCH_CH_2_ID":"9055","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u044d\u043a\u0440\u044d\u0442 \u043f\u0440\u0430 \u043c\u0456\u0441\u0456\u044f\u043d\u0435\u0440\u0441\u043a\u0443\u044e \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0430 &laquo;Ad gentes&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 4-5)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0406\u0434\u0437\u0456\u0446\u0435 \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u0439\u0446\u0435 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0430\u043c \u0436\u0430 \u041f\u0430\u043d \u0415\u0437\u0443\u0441, \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c \u044f\u043a \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u0430\u0434\u0434\u0430\u0446\u044c \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u0437\u0430 \u0441\u0432\u0435\u0442, \u0443\u0441\u0442\u0430\u043d\u0430\u0432\u0456\u045e \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c&not;\u0441\u043a\u0430\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 i \u043f\u0430\u0430\u0431\u044f\u0446\u0430\u045e \u0441\u043f\u0430\u0441\u043b\u0430\u0446\u044c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u043a\u0430\u0431 \u0456 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435, \u0456 \u0414\u0443\u0445 \u0431\u044b\u043b\u0456 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b\u044f \u045e \u0441\u043f\u0440\u0430\u0432\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u044f\u043a\u043e\u0435 \u045e\u0441\u044e\u0434\u044b \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0441\u0442\u0430\u043d\u0430\u0432\u0456\u0446\u0446\u0430 \u0431\u043e\u043b\u044c\u0448 \u043f\u043b\u0451\u043d\u043d\u044b\u043c. \u0412\u0430 \u045e\u0441\u0435 \u0447\u0430\u0441\u044b \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0430\u0431&rsquo;\u044f\u0434\u043d\u043e\u045e\u0432\u0430\u0435 \u045e\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u0443 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 i \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 i \u045e\u0434\u0437\u044f\u043b\u044f\u0435 \u044f\u043c\u0443 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u044b\u044f \u0456\u0435\u0440\u0430\u0440\u0445\u0456\u0447\u043d\u044b\u044f \u0456 \u0445\u0430\u0440\u044b\u0437\u043c\u0430\u0442\u044b\u0447\u043d\u044b\u044f \u0434\u0430\u0440\u044b, \u0430\u0436\u044b\u045e\u043b\u044f\u0435 \u043a\u0430\u0441\u0446\u0451\u043b\u044c\u043d\u044b\u044f \u045e\u0441\u0442\u0430\u043d\u043e\u0432\u044b, \u043d\u0456\u0431\u044b \u0434\u0443\u0448\u0430, i \u045e\u043b\u0456\u0432\u0430\u0435 \u045e \u0441\u044d\u0440\u0446\u044b \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u0442\u043e\u0439 \u0441\u0430\u043c\u044b \u043c\u0456\u0441\u0456\u0439\u043d\u044b \u0434\u0443\u0445, \u044f\u043a\u0456 \u0432\u0451\u045e \u0441\u0430\u043c\u043e\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0427\u0430\u0441\u0430\u043c \u043d\u0430\u0432\u0430\u0442 \u0431\u0430\u0447\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0401\u043d \u0430\u043f\u044f\u0440\u044d\u0434\u0436\u0432\u0430\u0435 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0443\u044e \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u043e\u0439 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0430-\u0440\u043e\u0437\u043d\u0430\u043c\u0443 \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u0447\u0430\u0435 i \u043a\u0456\u0440\u0443\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0437 \u0441\u0430\u043c\u0430\u0433\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 &laquo;\u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u0441\u044f\u0431\u0435 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0441\u0430\u043c \u0445\u0430\u0446\u0435\u045e... \u0456 \u0432\u044b\u0431\u0440\u0430\u045e \u0414\u0432\u0430\u043d\u0430\u0446\u0446\u0430\u0446\u044c, \u044f\u043a\u0456\u0445 \u0456 \u043d\u0430\u0437\u0432\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u0437 \u0406\u043c, \u043a\u0430\u0431 \u043f\u0430\u0441\u043b\u0430\u0446\u044c \u0456\u0445 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c&raquo; (M\u043a 3, 13-14). \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0441\u0442\u0430\u043b\u0456 \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0430\u043c\u0456 \u043d\u043e\u0432\u0430\u0433\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044f i \u0430\u0434\u043d\u0430\u0447\u0430\u0441\u043e\u0432\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0430\u043c \u043d\u043e\u0432\u0430\u0439 \u0456\u0435\u0440\u0430\u0440\u0445\u0456\u0456. \u0417\u0430\u0442\u044b\u043c, \u0440\u0430\u0437 \u0456 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u044e i \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435\u043c \u0441\u043f\u043e\u045e\u043d\u0456\u045e\u0448\u044b \u045e \u0441\u0430\u0431\u0435 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f i \u0430\u0434\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0441\u044f\u0433\u043e, \u041f\u0430\u043d, \u044f\u043a\u043e\u043c\u0443 \u0431\u044b\u043b\u0430 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u044f \u045e\u043b\u0430\u0434\u0430 \u045e \u043d\u0435\u0431\u0435 i \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u043f\u0435\u0440\u0430\u0434 \u0442\u044b\u043c, \u044f\u043a \u0431\u044b\u045e \u0443\u0437\u044f\u0442\u044b \u045e \u043d\u0435\u0431\u0430, \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u045e \u0441\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b \u044f\u043a \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u0406 \u043f\u0430\u0441\u043b\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435, \u044f\u043a \u0456 \u0441\u0430\u043c \u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0430\u043d\u044b \u0410\u0439\u0446\u043e\u043c, \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u044e\u0447\u044b \u0456\u043c: &laquo;\u0406\u0434\u0437\u0456\u0446\u0435 \u0456 \u043d\u0430\u0432\u0443\u0447\u0430\u0439\u0446\u0435 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u0446\u0435 \u0456\u0445 \u0443 \u0456\u043c\u044f \u0410\u0439\u0446\u0430 \u0456 \u0421\u044b\u043d\u0430, \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u0412\u0443\u0447\u044b\u0446\u0435 \u0456\u0445 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0443\u0441\u0451, \u0448\u0442\u043e \u042f \u0437\u0430\u0433\u0430\u0434\u0430\u045e \u0432\u0430\u043c&raquo; (M\u0446 28, 19&not;20).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u044b \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0440\u0430\u0441\u043f\u0430\u045e\u0441\u044e\u0434\u0436\u0432\u0430\u0446\u044c \u0432\u0435\u0440\u0443 i \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435: \u044f\u043a \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0432\u044b\u0440\u0430\u0437\u043d\u0430\u0433\u0430 \u043d\u0430\u043a\u0430\u0437\u0443, \u044f\u043a\u0456 \u043f\u0430\u0441\u043b\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0441\u0442\u0430\u043d \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e, \u044f\u043a\u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u044f\u0442\u0430\u0440\u044b i \u044f\u043a\u0456 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b \u0437 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430\u043c \u041f\u044f\u0442\u0440\u0430, \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b\u043c \u041f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0442\u0430\u043a \u0456 \u0437 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0436\u044b\u0446\u0446\u044f, \u044f\u043a\u043e\u0435 \u043f\u0435\u0440\u0430\u0434\u0430\u0435 \u0441\u0432\u0430\u0456\u043c \u0447\u043b\u0435\u043d\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0443\u0441.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043c\u0456\u0441\u0456\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u0435\u0446\u0446\u0430 \u045e \u0442\u043e\u0439 \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u0456, \u043f\u0440\u0430\u0437 \u044f\u043a\u0443\u044e \u0451\u043d, \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u043d\u0430\u043a\u0430\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b \u043b\u0430\u0441\u043a\u0430\u0439 i \u043b\u044e\u0431\u043e\u045e\u044e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0446\u0430\u043b\u043a\u0430\u043c \u043f\u0430\u043a\u0430\u0437\u0432\u0430\u0435 \u0441\u0432\u0430\u044e \u0434\u0437\u0435\u0439\u0441\u043d\u0443\u044e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0443\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c \u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0436\u044b\u0446\u0446\u044f \u0456 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u0430\u0437 \u0441\u0432\u044f\u0442\u044b\u044f \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u044b i \u0456\u043d\u0448\u044b\u044f \u0441\u0440\u043e\u0434\u043a\u0456 \u043b\u0430\u0441\u043a\u0456 \u0434\u0430\u0432\u0435\u0441\u0446\u0456 \u0456\u0445 \u0434\u0430 \u0432\u0435\u0440\u044b, \u0441\u0432\u0430\u0431\u043e\u0434\u044b i \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0441\u043f\u0430\u043a\u043e\u044e, \u043a\u0430\u0431 \u0456\u043c \u0430\u0434\u043a\u0440\u044b\u045e\u0441\u044f \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b i \u043f\u044d\u045e\u043d\u044b \u0448\u043b\u044f\u0445 \u0434\u0430 \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u043a 16, 15-16; \u042f\u043d 3, 5<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406\u0434\u0437\u0456\u0446\u0435 \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0456 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0439\u0446\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u045e\u0441\u044f\u043a\u0430\u043c\u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044e.<span style=\"color: #ff0000;\"> *<\/span> \u0425\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c \u0456 \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u0446\u0446\u0430, \u0431\u0443\u0434\u0437\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u043d\u0435 \u043d\u0430\u0440\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u0437 \u0432\u0430\u0434\u044b \u0456 \u0414\u0443\u0445\u0430, \u043d\u0435 \u0437\u043c\u043e\u0436\u0430 \u045e\u0432\u0430\u0439\u0441\u0446\u0456 \u045e \u0411\u043e\u0436\u0430\u0435 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u0446\u044c \u0456 \u0430\u0445\u0440\u044b\u0441\u0446\u0456\u0446\u0446\u0430, \u0431\u0443\u0434\u0437\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b.<\/p>\r\n"}, {"GCH_CH_2_ID":"9061","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0432\u043e\u0440 &laquo;\u041b\u044e\u0441\u0442\u044d\u0440\u043a\u0430 \u0432\u0435\u0440\u044b&raquo; \u0412\u0456\u043b\u044c\u0433\u0435\u043b\u044c\u043c\u0430, \u0430\u0431\u0430\u0442\u0430 \u043a\u043b\u044f\u0448\u0442\u0430\u0440\u0430 \u0441\u0432. \u0422\u044d\u0430\u0434\u043e\u0440\u044b\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(PL 180, 384)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0420\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 \u0432\u0435\u0440\u044b \u0434\u0430\u0435 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0434\u0443\u0448\u0430, \u0432\u0435\u0440\u043d\u0430\u044f \u0411\u043e\u0433\u0443, \u043a\u0430\u043b\u0456 \u0442\u044b \u0437 \u0432\u0435\u0440\u0430\u044e \u0456 \u0442\u0440\u0430\u043f\u044f\u0442\u0430\u043d\u043d\u0435\u043c \u0441\u0432\u0430\u0451\u0439 \u043d\u0430\u0442\u0443\u0440\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0448\u0441\u044f \u043f\u0435\u0440\u0430\u0434 \u043d\u0435\u0441\u043f\u0430\u0441\u0446\u0456\u0433\u0430\u043b\u044c\u043d\u044b\u043c\u0456 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u043c\u0456, \u043d\u0435 \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0439 \u0456\u0445 \u0440\u043e\u0437\u0443\u043c\u0430\u043c, \u0430\u043b\u0435 \u0430\u0434\u0432\u0430\u0436\u0441\u044f \u0456 \u0441\u043a\u0430\u0436\u044b \u0437 \u043b\u044e\u0431\u043e\u045e\u044e: \u042f\u043a \u0433\u044d\u0442\u0430 \u043c\u043e\u0436\u0430 \u0430\u0434\u0431\u044b\u0432\u0430\u0446\u0446\u0430?<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u0442\u0432\u0430\u0451 \u043f\u044b\u0442\u0430\u043d\u043d\u0435 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0442\u0432\u0430\u0451\u0439 \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439, \u0431\u0443\u0434\u0437\u0435 \u043b\u044e\u0431\u043e\u045e\u044e, \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044e, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0436\u0430\u0434\u0430\u043d\u043d\u0435\u043c. \u041d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u0433\u043b\u044b\u0431\u043e\u043a\u0456\u043c \u0434\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0411\u043e\u0436\u0430\u0439 \u0432\u0435\u043b\u0456\u0447\u044b, \u0430\u043b\u0435 \u043f\u043e\u0448\u0443\u043a\u0430\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u0441\u0430\u043c \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043d\u0430\u0448\u044b\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c. \u0406 \u0442\u0430\u0431\u0435 \u0430\u0434\u043a\u0430\u0436\u0430 \u0430\u043d\u0451\u043b \u0434\u043e\u0431\u0440\u0430\u0439 \u043f\u0430\u0440\u0430\u0434\u044b: &laquo;\u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0421\u0443\u0446\u044f\u0448\u044b\u0446\u0435\u043b\u044c, \u044f\u043a\u043e\u0433\u0430 \u042f \u043f\u0430\u0448\u043b\u044e \u0432\u0430\u043c \u0430\u0434 \u0410\u0439\u0446\u0430, \u0451\u043d \u043f\u0430\u0434\u043a\u0430\u0436\u0430 \u0432\u0430\u043c \u0443\u0441\u0451, \u0456 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0432\u0430\u0441 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u0437\u0435&raquo; (\u043f\u0430\u0440. \u042f\u043d 14, 26; 16, 13). \u0411\u043e \u0445\u0442\u043e \u0437 \u043b\u044e\u0434\u0437\u0435\u0439 \u0432\u0435\u0434\u0430\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435, \u0430\u043a\u0440\u0430\u043c\u044f \u0434\u0443\u0445\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u044f\u043a\u0456 \u045e \u0456\u043c \u0441\u0430\u043c\u0456\u043c? \u0422\u0430\u043a \u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u043d\u0456\u0445\u0442\u043e, \u0430\u043a\u0440\u0430\u043c\u044f \u0414\u0443\u0445\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 2, 11).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0441\u043f\u044f\u0448\u0430\u0439\u0441\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c. \u0401\u043d \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u043a\u0430\u043b\u0456 \u042f\u0433\u043e \u043a\u043b\u0456\u0447\u0443\u0446\u044c; \u0456 \u0442\u044b \u043d\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0431\u044b, \u043a\u0430\u043b\u0456 \u0431 \u042f\u0433\u043e \u045e \u0442\u0430\u0431\u0435 \u045e\u0436\u043e \u043d\u0435 \u0431\u044b\u043b\u043e. \u0410 \u043a\u0430\u043b\u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u043f\u0440\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c, \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0437 \u0441\u0430\u0431\u043e\u0439 \u0448\u0447\u043e\u0434\u0440\u044b\u044f \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0456 \u0411\u043e\u0436\u044b\u044f. \u0401\u043d \u0431\u044b\u0446\u0446\u0430\u043c \u043f\u043b\u044b\u043d\u044c \u0440\u0430\u043a\u0456, \u044f\u043a\u0430\u044f \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u044c \u0433\u043e\u0440\u0430\u0434 \u0411\u043e\u0436\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043a\u0430\u043b\u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0456 \u0437\u043d\u043e\u0439\u0434\u0437\u0435 \u0446\u044f\u0431\u0435 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b\u043c, \u0437 \u0442\u0440\u0430\u043f\u044f\u0442\u043a\u043e\u044e \u043f\u0430\u0448\u0430\u043d\u0430\u0439 \u0434\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0441\u043b\u043e\u0432\u0430, \u0401\u043d \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u043d\u0430 \u0442\u0430\u0431\u0435. \u0406 \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u0422\u0430\u0431\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0411\u043e\u0433 \u0410\u0439\u0446\u0435\u0446 \u0445\u0430\u0432\u0430\u0435 \u0430\u0434 \u043c\u0443\u0434\u0440\u044b\u0445 \u0456 \u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445 \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443. \u0422\u0430\u0434\u044b \u0442\u044b \u043f\u0430\u0447\u043d\u0435\u0448 \u0437\u0430\u045e\u0432\u0430\u0436\u0430\u0446\u044c \u043f\u0440\u0430\u044f\u0432\u044b \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u041c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0437\u043c\u0430\u0433\u043b\u0430 \u0441\u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0443\u0442, \u043d\u0430 \u0437\u044f\u043c\u043b\u0456, \u0441\u0432\u0430\u0456\u043c \u0432\u0443\u0447\u043d\u044f\u043c. \u0410\u0434\u043d\u0430\u043a \u044f\u043d\u044b \u043d\u0435 \u0431\u044b\u043b\u0456 \u0437\u0434\u043e\u043b\u044c\u043d\u044b\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0443\u0441\u0451, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0414\u0443\u0445 \u043f\u0440\u0430\u045e\u0434\u044b, \u043a\u0430\u0431 \u043d\u0430\u0432\u0443\u0447\u044b\u0446\u044c \u0456\u0445 \u0443\u0441\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0434\u0430\u0440\u044d\u043c\u043d\u0430 \u0448\u0443\u043a\u0430\u043b\u0456 \u0431 \u0443 \u043b\u044e\u0434\u0437\u0435\u0439 \u0432\u0443\u0447\u044d\u043d\u043d\u044f \u0456 \u0432\u0435\u0434\u0430\u045e, \u044f\u043a\u0456\u0445 \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u0456 \u043d\u0435 \u043d\u0430\u0432\u0443\u0447\u044b\u043b\u0456\u0441\u044f \u0441\u0430 \u0441\u043b\u043e\u0432\u0430\u045e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0441\u0430\u043c \u0451\u0441\u0446\u044c \u043f\u0440\u0430\u045e\u0434\u0430\u0439. \u0401\u043d \u0441\u0430\u043c \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u0411\u043e\u0433 \u0451\u0441\u0446\u044c \u0414\u0443\u0445\u0430\u043c&raquo; (\u042f\u043d 4, 24).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f, \u0445\u0442\u043e \u042f\u043c\u0443 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u0446\u0446\u0430, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0440\u0430\u0431\u0456\u0446\u044c \u0433\u044d\u0442\u0430 \u045e \u0434\u0443\u0445\u0443 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0434\u0430\u0432\u0435\u0434\u0430\u0446\u0446\u0430 \u043f\u0440\u0430 \u042f\u0433\u043e \u0456 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u042f\u0433\u043e, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0442\u043e\u043b\u044c\u043a\u0456 \u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c \u0448\u0443\u043a\u0430\u0446\u044c \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044f \u0432\u0435\u0440\u044b, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0447\u044b\u0441\u0442\u0430\u0439 \u0456 \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u0439 \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043b\u044f \u045e\u0431\u043e\u0433\u0456\u0445 \u0434\u0443\u0445\u0430\u043c \u0401\u043d \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u044f\u043a\u043e\u0435 \u0437\u0437\u044f\u0435 \u0437 \u0446\u0435\u043c\u0440\u044b \u0456 \u043d\u044f\u0432\u0435\u0434\u0430\u043d\u043d\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u0401\u043d \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043b\u044e\u0431\u043e\u045e\u044e, \u044f\u043a\u0430\u044f \u043f\u0440\u044b\u0432\u0430\u0431\u043b\u0456\u0432\u0430\u0435, \u0456 \u0441\u043b\u043e\u0434\u044b\u0447\u0447\u0443, \u044f\u043a\u0430\u044f \u045e\u0437\u0440\u0443\u0448\u0432\u0430\u0435. \u0401\u043d \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u0434\u043e\u0441\u0442\u0443\u043f\u0430\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430 \u0411\u043e\u0433\u0430, \u043b\u044e\u0431\u043e\u045e\u044e \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c, \u0401\u043d &ndash; \u0433\u044d\u0442\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u043b\u044e\u0431\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0435 \u0432\u0435\u0440\u043d\u044b\u043c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0411\u043e\u0433\u0430, \u044f\u043a\u0430\u044f \u043f\u0440\u0430\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u045e \u0432\u0435\u0440\u044b \u0456 \u0432\u044f\u0434\u0437\u0435 \u0434\u0430 \u044f\u0435, \u043a\u0430\u043b\u0456 \u0434\u0430\u0435 \u043d\u0430\u043c \u043b\u0430\u0441\u043a\u0443 \u0437\u0430 \u043b\u0430\u0441\u043a\u0430\u0439 \u0456 \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u0443\u044e \u0432\u0435\u0440\u0443 \u045e \u0434\u0430\u0434\u0430\u0442\u0430\u043a \u0434\u0430 \u0432\u0435\u0440\u044b, \u044f\u043a\u0430\u044f \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0435\u0446\u0446\u0430 \u0441\u0430 \u0441\u043b\u0443\u0445\u0430\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u041c\u0446 13, 52; \u043f\u0430\u0440. \u041f\u0440\u044b\u043f 14, 33<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u044f\u043b\u044f\u043a\u0456 \u043a\u043d\u0456\u0436\u043d\u0456\u043a, \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b \u043f\u0440\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u041d\u044f\u0431\u0435\u0441\u043d\u0430\u0435, <span style=\"color: #ff0000;\">*<\/span> \u043f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430, \u044f\u043a\u0456 \u0432\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0430 \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u044b \u0441\u0432\u0430\u0451\u0439 \u043d\u043e\u0432\u0430\u0435 \u0456 \u0441\u0442\u0430\u0440\u043e\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u0441\u044d\u0440\u0446\u044b \u0440\u0430\u0437\u0443\u043c\u043d\u0430\u0433\u0430 \u0451\u0441\u0446\u044c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0451\u043d \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0432\u0443\u0447\u0430\u0446\u044c \u043d\u0435\u0440\u0430\u0437\u0443\u043c\u043d\u044b\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0434\u043e\u0431\u043d\u044b \u0434\u0430 \u0433\u0430\u0441\u043f\u0430\u0434\u0430\u0440\u0430, \u044f\u043a\u0456 \u0432\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u0441\u0430 \u0441\u043a\u0430\u0440\u0431\u043d\u0456\u0446\u044b \u0441\u0432\u0430\u0451\u0439 \u043d\u043e\u0432\u0430\u0435 \u0456 \u0441\u0442\u0430\u0440\u043e\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"9062","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u0430\u0433\u043c\u0430\u0442\u044b\u0447\u043d\u0430\u044f \u043a\u0430\u043d\u0441\u0442\u044b\u0442\u0443\u0446\u044b\u044f \u043f\u0440\u0430 \u0411\u043e\u0436\u0430\u0435 \u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 &laquo;Dei verbum&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 7-8)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0435\u0440\u0430\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0435 \u0411\u043e\u0436\u0430\u0433\u0430 \u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u041f\u0430\u043d, \u0443 \u044f\u043a\u0456\u043c \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u045e\u0441\u0451 \u0410\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c \u043f\u0435\u0440\u0430\u0434\u0430\u0432\u0430\u0446\u044c \u0431\u043e\u0441\u043a\u0456\u044f \u0434\u0430\u0440\u044b \u0456 \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0443\u0441\u0456\u043c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435, \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435 \u0440\u0430\u043d\u0435\u0439 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0441\u043f\u043e\u045e\u043d\u0435\u043d\u0430\u0435 \u0406\u043c \u0456 \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430\u0435 \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u044f\u043a \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u0437\u0431\u0430\u045e\u0447\u0430\u0439 \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u0434\u044b\u0441\u0446\u044b\u043f\u043b\u0456\u043d\u044b \u0437\u0432\u044b\u0447\u0430\u044f\u045e. \u0413\u044d\u0442\u044b \u0437\u0430\u0433\u0430\u0434 \u0432\u0435\u0440\u043d\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u043b\u0456 \u044f\u043a \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b, \u044f\u043a\u0456\u044f \u0432\u0443\u0441\u043d\u0430\u0439 \u043f\u0440\u043e\u043f\u0430\u0432\u0435\u0434\u0434\u0437\u044e, \u043f\u0440\u044b\u043a\u043b\u0430\u0434\u0430\u043c \u0456 \u043d\u0430\u0441\u0442\u0430\u045e\u043b\u0435\u043d\u043d\u044f\u043c\u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437 \u0432\u0443\u0441\u043d\u0430\u045e, \u0433\u0443\u0442\u0430\u0440\u0430\u043a \u0456 \u0441\u043f\u0440\u0430\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u043f\u0440\u0430 \u0448\u0442\u043e \u0434\u0430\u0432\u0435\u0434\u0430\u043b\u0456\u0441\u044f \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u044b\u044f \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0442\u0430\u043a \u0456 \u0456\u043d\u0448\u044b\u044f \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456\u044f \u043c\u0443\u0436\u044b, \u044f\u043a\u0456\u044f \u043f\u0430\u0434 \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0435\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0437\u0430\u043f\u0456\u0441\u0430\u043b\u0456 \u0437\u0431\u0430\u045e\u0447\u0443\u044e \u043d\u0430\u0432\u0456\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u0431 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0430\u0441\u044f \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u043d\u0435\u043f\u0430\u0440\u0443\u0448\u043d\u044b\u043c \u0456 \u0436\u044b\u0432\u044b\u043c, \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u043b\u0456 \u044f\u043a \u0441\u0432\u0430\u0456\u0445 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u043a\u0430\u045e \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e, &laquo;\u043f\u0435\u0440\u0430\u0434\u0430\u044e\u0447\u044b \u0456\u043c \u0441\u0432\u0430\u044e \u043d\u0430\u0441\u0442\u0430\u045e\u043d\u0456\u0446\u043a\u0443\u044e \u043f\u0430\u0441\u0430\u0434\u0443&raquo;. \u041f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456 \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u045e\u0441\u0451, \u0448\u0442\u043e \u0441\u043f\u0440\u044b\u044f\u0435 \u0436\u044b\u0446\u0446\u044e \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u045e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0456 \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u043d\u043d\u044e \u044f\u0433\u043e \u0432\u0435\u0440\u044b. \u0422\u0430\u043a \u041a\u0430\u0441\u0446\u0451\u043b \u0442\u0440\u044b\u0432\u0430\u0435 \u045e \u0441\u0432\u0430\u0456\u043c \u0432\u0443\u0447\u044d\u043d\u043d\u0456, \u0436\u044b\u0446\u0446\u0456 \u0456 \u043a\u0443\u043b\u044c\u0446\u0435 \u0456 \u043f\u0435\u0440\u0430\u0434\u0430\u0435 \u045e\u0441\u0456\u043c \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f\u043c \u0442\u043e\u0435, \u0447\u044b\u043c \u0451\u0441\u0446\u044c \u0441\u0430\u043c, \u0456 \u0442\u043e\u0435, \u0443\u0432\u0430 \u0448\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0440\u0430\u0434\u044b\u0446\u044b\u044f, \u044f\u043a\u0430\u044f \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0430\u0434 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0440\u0430\u0437\u0432\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0431\u043e \u0440\u0430\u0441\u0446\u0435 \u045e\u0441\u043f\u0440\u044b\u043c\u0430\u043d\u043d\u0435 \u044f\u043a \u043f\u0435\u0440\u0430\u0434\u0430\u0434\u0437\u0435\u043d\u044b\u0445 \u0441\u043f\u0440\u0430\u045e, \u0442\u0430\u043a \u0456 \u0441\u043b\u043e\u045e. \u0413\u044d\u0442\u0430 \u0430\u0434\u0431\u044b\u0432\u0430\u0435\u0446\u0446\u0430 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043a\u0430\u043d\u0442\u044d\u043c\u043f\u043b\u044f\u0446\u044b\u0456 \u0456 \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0440\u0430\u0437\u0432\u0430\u0436\u0430\u044e\u0446\u044c \u043f\u0440\u0430 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u045e \u0441\u0432\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u044b; \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u043b\u044b\u0431\u043e\u043a\u0430\u043c\u0443 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u044e \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0439 \u0440\u044d\u0447\u0430\u0456\u0441\u043d\u0430\u0441\u0446\u0456, \u044f\u043a\u0443\u044e \u044f\u043d\u044b \u0437\u0432\u0435\u0434\u0432\u0430\u044e\u0446\u044c, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0440\u043e\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0440\u0430\u0437\u0430\u043c \u0437 \u0431\u0456\u0441\u043a\u0443\u043f\u0441\u043a\u0430\u0439 \u0441\u0443\u043a\u0446\u044d\u0441\u0456\u044f\u0439 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043d\u0435\u0430\u0434&rsquo;\u0435\u043c\u043d\u044b \u0434\u0430\u0440 \u043f\u0440\u0430\u045e\u0434\u044b. \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0446\u044f\u0433\u0430\u043c \u0432\u044f\u043a\u043e\u045e \u041a\u0430\u0441\u0446\u0451\u043b \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0456\u0434\u0437\u0435 \u0434\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u0411\u043e\u0436\u0430\u0439 \u043f\u0440\u0430\u045e\u0434\u044b, \u043f\u0430\u043a\u0443\u043b\u044c \u0443 \u0406\u043c \u043d\u0435 \u0441\u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u0411\u043e\u0436\u044b\u044f \u0441\u043b\u043e\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u044b\u043a\u0430\u0437\u0432\u0430\u043d\u043d\u0456 \u0441\u0432\u044f\u0442\u044b\u0445 \u0430\u0439\u0446\u043e\u045e \u0441\u0432\u0435\u0434\u0447\u0430\u0446\u044c \u043f\u0440\u0430 \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u0443\u044e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0433\u044d\u0442\u0430\u0439 \u0422\u0440\u0430\u0434\u044b\u0446\u044b\u0456, \u0431\u0430\u0433\u0430\u0446\u0446\u0435 \u044f\u043a\u043e\u0439 \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u044c \u0456 \u0436\u044b\u0446\u0446\u0451 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u044f\u043a\u0456 \u0432\u0435\u0440\u044b\u0446\u044c \u0456 \u043c\u043e\u043b\u0456\u0446\u0446\u0430. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0433\u044d\u0442\u0430\u0439 \u0422\u0440\u0430\u0434\u044b\u0446\u044b\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u043c\u0430\u0435 \u045e\u0432\u0435\u0441\u044c \u043a\u0430\u043d\u043e\u043d \u0421\u0432\u044f\u0442\u044b\u0445 \u041a\u043d\u0456\u0433, \u0430 \u0441\u0430\u043c\u043e \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435 \u045e \u0451\u0439 \u0433\u043b\u044b\u0431\u0435\u0439 \u0440\u0430\u0437\u0443\u043c\u0435\u0435\u0446\u0446\u0430 \u0456 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0446\u0430 \u0434\u0437\u0435\u0439\u0441\u043d\u044b\u043c. \u0422\u0430\u043a \u0411\u043e\u0433, \u044f\u043a\u0456 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u043f\u0440\u0430\u043c\u043e\u0432\u0456\u045e, \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0440\u0430\u0437\u043c\u0430\u045e\u043b\u044f\u0435 \u0437 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430\u0439 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430. \u0406 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b, \u043f\u0440\u0430\u0437 \u044f\u043a\u043e\u0433\u0430 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u0430 \u043f\u0440\u0430\u0437 \u044f\u0433\u043e \u0456 \u0432\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0433\u0443\u0447\u044b\u0446\u044c \u0436\u044b\u0432\u044b \u0433\u043e\u043b\u0430\u0441 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f, \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u0434\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u043f\u0440\u0430\u045e\u0434\u044b \u0456 \u0448\u0447\u043e\u0434\u0440\u0430 \u043f\u0430\u0441\u044f\u043b\u044f\u0435 \u045e \u0456\u0445 \u0441\u043b\u043e\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041f 1, 25; \u041b\u043a 1, 2<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0442\u0440\u044b\u0432\u0430\u0435 \u043d\u0430\u0432\u0435\u043a\u0456. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0433\u044d\u0442\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0451\u0441\u0446\u044c \u0414\u043e\u0431\u0440\u0430\u044f \u041d\u0430\u0432\u0456\u043d\u0430, \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430\u044f \u0432\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043a \u043f\u0435\u0440\u0430\u0434\u0430\u043b\u0456 \u043d\u0430\u043c \u0442\u044b\u044f, \u0445\u0442\u043e \u0430\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0431\u044b\u045e \u0432\u0456\u0434\u0430\u0432\u043e\u0447\u0446\u0430\u043c \u0456 \u0441\u043b\u0443\u0433\u043e\u044e \u0441\u043b\u043e\u0432\u0430<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0433\u044d\u0442\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c \u0451\u0441\u0446\u044c \u0414\u043e\u0431\u0440\u0430\u044f \u041d\u0430\u0432\u0456\u043d\u0430, \u0430\u0431\u0432\u0435\u0448\u0447\u0430\u043d\u0430\u044f \u0432\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"9071","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0422\u0440\u0430\u043a\u0442\u0430\u0442 &laquo;\u041f\u0440\u0430 \u0441\u0442\u0430\u043d \u043f\u0430\u043d\u043d\u0430\u045e&raquo; \u0441\u0432. \u041a\u0456\u043f\u0440\u044b\u044f\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0456 \u043c\u0443\u0447\u0430\u043d\u0456\u043a\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 3-4, 22. 23: CSEL 3, 189-190. 202-204)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0427\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043f\u0430\u043d\u043d\u0430\u045e, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0426\u044f\u043f\u0435\u0440 \u043c\u044b \u0437\u0432\u044f\u0440\u0442\u0430\u0435\u043c\u0441\u044f \u0434\u0430 \u043f\u0430\u043d\u043d\u0430\u045e, \u044f\u043a\u0456\u044f \u0442\u044b\u043c \u0434\u0430\u0440\u0430\u0436\u044d\u0439\u0448\u044b\u044f \u0434\u043b\u044f \u043d\u0430\u0441, \u0447\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0456\u0445 \u0448\u0430\u043d\u0443\u044e\u0446\u044c. \u0413\u044d\u0442\u0430 \u043a\u0432\u0435\u0446\u0435\u043d\u044c \u043a\u0430\u0441\u0446\u0451\u043b\u044c\u043d\u044b\u0445 \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0430\u045e, \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u044f \u043a\u0440\u0430\u0441\u0430 \u0456 \u0430\u0437\u0434\u043e\u0431\u0430, \u0440\u0430\u0434\u0430\u0441\u043d\u044b \u0434\u0430\u0440 \u0446\u043d\u043e\u0442\u044b, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b \u0456 \u043d\u0435\u043f\u0430\u0448\u043a\u043e\u0434\u0436\u0430\u043d\u044b \u0442\u0432\u043e\u0440, \u0433\u043e\u0434\u043d\u044b \u0441\u043b\u0430\u0432\u044b \u0456 \u043f\u0430\u0448\u0430\u043d\u044b, \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430, \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u044f \u0447\u0430\u0441\u0442\u043a\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0439 \u0430\u045e\u0447\u0430\u0440\u043d\u0456. \u042f\u043d\u044b &ndash; \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0456 \u043a\u0440\u0430\u0441\u0430\u043c\u043e\u045e\u043d\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u044f\u0433\u043e\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f, \u0456 \u0433\u044d\u0442\u0430\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0435, \u043a\u0430\u043b\u0456 \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u0456\u0445 \u043a\u043e\u043b\u044c\u043a\u0430\u0441\u0446\u044c. \u041c\u044b \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u0435\u043c \u0434\u0430 \u0456\u0445 \u0456 \u043f\u0430\u0434\u0431\u0430\u0434\u0437\u0451\u0440\u0432\u0430\u0435\u043c \u043d\u0435 \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043c\u0430\u0435 \u045e\u043b\u0430\u0434\u0443, \u0430\u043b\u0435 \u043f\u043e\u045e\u043d\u044b\u044f \u043f\u0430\u0447\u0443\u0446\u0446\u044f. \u041c\u044b \u0432\u0435\u043b\u044c\u043c\u0456 \u0434\u043e\u0431\u0440\u0430 \u045e\u0441\u0432\u0435\u0434\u0430\u043c\u043b\u044f\u0435\u043c \u043d\u0430\u0448\u0443 \u043d\u0435\u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u044c \u0456, \u044f\u043a \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0456 \u043d\u0430\u0439\u043c\u0435\u043d\u0448\u044b\u044f, \u043d\u0435 \u0445\u043e\u0447\u0430\u043c \u0442\u0443\u0442 \u0443\u0434\u0430\u0432\u0430\u0446\u044c \u0437 \u0441\u044f\u0431\u0435 \u0446\u044d\u043d\u0437\u0430\u0440\u0430\u045e \u0456\u0445\u043d\u0456\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d, \u0430\u043b\u0435 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u043d\u0430\u043c \u0434\u0430\u0440\u0443\u0447\u0430\u043d\u044b \u043f\u0430\u0441\u0442\u044b\u0440\u0441\u043a\u0456 \u043a\u043b\u043e\u043f\u0430\u0442, \u043c\u044b \u0431\u043e\u043b\u044c\u0448 \u0447\u0443\u0439\u043d\u044b\u044f \u0434\u0430 \u045e\u0441\u0456\u0445 \u043d\u0430\u043f\u0430\u0434\u0430\u045e \u0434&rsquo;\u044f\u0431\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043d\u0430\u0448\u0430 \u0430\u0441\u0446\u044f\u0440\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u0456 \u043d\u0435\u043f\u0430\u043a\u043e\u0439 \u043d\u0435\u0431\u0435\u0441\u043f\u0430\u0434\u0441\u0442\u0430\u045e\u043d\u044b\u044f, \u0431\u043e \u0433\u0430\u0432\u043e\u0440\u043a\u0430 \u0456\u0434\u0437\u0435 \u043f\u0440\u0430 \u0448\u043b\u044f\u0445 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u043f\u0440\u0430 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u041f\u0430\u043d\u0441\u043a\u0456\u0445 \u0456 \u0436\u044b\u0446\u0446\u0451\u0432\u044b\u0445 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u044f\u045e. \u0412\u044f\u043b\u0456\u043a\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0447\u0430\u043a\u0430\u0435 \u0442\u044b\u0445 \u043f\u0430\u043d\u043d\u0430\u045e, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u043b\u0456 \u0441\u044f\u0431\u0435 \u0425\u0440\u044b\u0441\u0442\u0443, \u044f\u043a\u0456\u044f \u0430\u0434\u0440\u0430\u043a\u043b\u0456\u0441\u044f \u0430\u0434 \u0441\u043f\u0440\u0430\u0432\u0430\u045e \u0446\u0435\u043b\u0430 \u0456 \u0446\u0430\u043b\u043a\u0430\u043c \u043d\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u0411\u043e\u0433\u0443. \u0422\u0430\u043c\u0443 \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u044f\u043d\u044b \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0432\u0435\u0440\u043d\u044b\u043c\u0456, \u043a\u0430\u0431 \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0432\u0430\u043b\u0456\u0441\u044f \u0434\u043b\u044f \u041f\u0430\u043d\u0430 \u0456 \u043f\u0430\u0434\u0430\u0431\u0430\u043b\u0456\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0442\u0430\u043c\u0443, \u0430\u0434 \u043a\u0430\u0433\u043e \u0447\u0430\u043a\u0430\u044e\u0446\u044c \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u044b \u0437\u0430 \u0441\u0432\u0430\u0451 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0441\u0442\u0430\u043d\u044c\u0446\u0435\u0441\u044f, \u043f\u0430\u043d\u043d\u044b, \u0437\u0430\u0441\u0442\u0430\u043d\u044c\u0446\u0435\u0441\u044f \u0442\u0430\u043a\u0456\u043c\u0456, \u044f\u043a\u0456\u043c\u0456 \u043f\u0430\u0447\u0430\u043b\u0456 \u0431\u044b\u0446\u044c. \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u0442\u0430\u043a\u0456\u043c\u0456, \u044f\u043a\u0456\u043c\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435. \u0412\u0430\u0441 \u0447\u0430\u043a\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0430\u044f \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430 \u0456 \u0432\u044f\u043b\u0456\u043a\u0456 \u0434\u0430\u0440 \u0437\u0430 \u0432\u0430\u0448\u0443 \u0446\u043d\u043e\u0442\u0443, \u0437\u0430 \u043d\u0430\u0439\u0432\u044f\u043b\u0456\u043a\u0448\u044b \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u044f \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456. \u0427\u044b\u043c \u043c\u044b \u0431\u0443\u0434\u0437\u0435\u043c, \u0432\u044b \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0435\u0441\u044f \u045e\u0436\u043e \u0446\u044f\u043f\u0435\u0440. \u0412\u044b \u045e\u0436\u043e \u0446\u044f\u043f\u0435\u0440 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435\u0446\u0435 \u0445\u0432\u0430\u043b\u0443 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f, \u0443\u0436\u043e \u0446\u044f\u043f\u0435\u0440 \u0441\u0432\u0430\u0431\u043e\u0434\u043d\u044b\u044f \u0430\u0434 \u0437\u0430\u0433\u0430\u043d\u0430\u045e \u0433\u044d\u0442\u0430\u0433\u0430 \u0441\u0432\u0435\u0442\u0443; \u0430 \u0437\u0430\u0441\u0442\u0430\u044e\u0447\u044b\u0441\u044f \u045e \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0456 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0435, \u0432\u044b \u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0446\u0435\u0441\u044f \u0440\u043e\u045e\u043d\u044b\u043c\u0456 \u0411\u043e\u0436\u044b\u043c \u0430\u043d\u0451\u043b\u0430\u043c. \u041d\u044f\u0445\u0430\u0439 \u0442\u0440\u044b\u0432\u0430\u0435 \u0456 \u0437\u0430\u0441\u0442\u0430\u043d\u0435\u0446\u0446\u0430 \u043d\u0435\u043a\u0440\u0430\u043d\u0443\u0442\u044b\u043c \u0432\u0430\u0448\u0430 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430, \u0456 \u044f\u043a \u0432\u044b \u043c\u0443\u0436\u043d\u0430 \u0440\u0430\u0441\u043f\u0430\u0447\u0430\u043b\u0456, \u0442\u0430\u043a \u0456 \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0439\u0446\u0435, \u043d\u0435 \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u043f\u0440\u044b\u0433\u0430\u0436\u043e\u0441\u0446\u0456 \u045e \u0448\u0430\u0442\u0430\u0445 \u0456 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0430\u0441\u0446\u044f\u0445, \u0430\u043b\u0435 \u045e \u0436\u044b\u0446\u0446\u0451\u0432\u044b\u0445 \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u043d\u0430\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0448\u0442\u043e \u043a\u0430\u0436\u0430 \u0410\u043f\u043e\u0441\u0442\u0430\u043b, \u044f\u043a\u043e\u0433\u0430 \u041f\u0430\u043d \u0437\u0440\u0430\u0431\u0456\u045e \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u043c \u043d\u0430\u0447\u044b\u043d\u043d\u0435\u043c \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u043d\u0430\u043a\u0430\u0437\u044b: &laquo;\u041f\u0435\u0440\u0448\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u043a &ndash; \u0437 \u043f\u044b\u043b\u0443, \u0437\u044f\u043c\u043d\u044b; \u0434\u0440\u0443\u0433\u0456 \u0427\u0430\u043b\u0430\u0432\u0435\u043a &ndash; \u0437 \u043d\u0435\u0431\u0430. \u042f\u043a\u0456 \u0431\u044b\u045e \u0437\u044f\u043c\u043d\u044b, \u0442\u0430\u043a\u0456\u044f \u0456 \u0437\u044f\u043c\u043d\u044b\u044f; \u044f\u043a\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b, \u0442\u0430\u043a\u0456\u044f \u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f. \u0406 \u044f\u043a \u043c\u044b \u043d\u0430\u0441\u0456\u043b\u0456 \u0432\u043e\u0431\u0440\u0430\u0437 \u0437\u044f\u043c\u043d\u043e\u0433\u0430, \u0442\u0430\u043a \u0431\u0443\u0434\u0437\u0435\u043c \u043d\u0430\u0441\u0456\u0446\u044c \u0432\u043e\u0431\u0440\u0430\u0437 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430&raquo; (1 \u041a\u0430\u0440 15, 47-49). \u0414\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430 \u043d\u043e\u0441\u0456\u0446\u044c \u0443 \u0441\u0430\u0431\u0435 \u0433\u044d\u0442\u044b \u0432\u043e\u0431\u0440\u0430\u0437 \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0441\u0432\u0430\u0451\u0439 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0441\u0446\u0456, \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u041a\u0430\u0440 7, 34; \u041f\u0441 73 (72), 26<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435\u0437\u0430\u043c\u0443\u0436\u043d\u044f\u044f \u0436\u0430\u043d\u0447\u044b\u043d\u0430 \u0456 \u0434\u0437\u0435\u0432\u0430<span style=\"color: #ff0000;\"> *<\/span> \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0441\u0432\u044f\u0442\u043e\u044e \u0456 \u0446\u0435\u043b\u0430\u043c, \u0456 \u0434\u0443\u0445\u0430\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0433 &ndash; \u0441\u043a\u0430\u043b\u0430 \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u0456 \u043c\u043e\u0439 \u043b\u0451\u0441 \u043d\u0430\u0432\u0435\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u043b\u0430\u043f\u043e\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0441\u0432\u044f\u0442\u043e\u044e \u0456 \u0446\u0435\u043b\u0430\u043c, \u0456 \u0434\u0443\u0445\u0430\u043c.<\/p>\r\n"}, {"GCH_CH_2_ID":"9072","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u0414\u044d\u043a\u0440\u044d\u0442 \u043f\u0440\u0430 \u0430\u0431\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043c\u0430\u043d\u0430\u0441\u043a\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f &laquo;Perfectae caritatis&raquo; \u0414\u0440\u0443\u0433\u043e\u0433\u0430 \u0412\u0430\u0442\u044b\u043a\u0430\u043d\u0441\u043a\u0430\u0433\u0430 \u0421\u0430\u0431\u043e\u0440\u0443<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Nn. 1. 5. 6. 12)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041a\u0430\u0441\u0446\u0451\u043b \u0456\u0434\u0437\u0435 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c &ndash; \u0430\u0434\u0437\u0456\u043d\u044b\u043c \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430\u043c<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0435 \u0431\u044b\u043b\u0456 \u043c\u0443\u0436\u0447\u044b\u043d\u044b \u0456 \u0436\u0430\u043d\u0447\u044b\u043d\u044b, \u044f\u043a\u0456\u044f \u0445\u0430\u0446\u0435\u043b\u0456 \u043f\u0440\u0430\u0437 \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u043d\u043d\u0435 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u0445 \u043f\u0430\u0440\u0430\u0434 \u0437 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0441\u0432\u0430\u0431\u043e\u0434\u0430\u0439 \u0456\u0441\u0446\u0456 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0456 \u0431\u043e\u043b\u044c\u0448 \u042f\u0433\u043e \u043d\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u0446\u044c. \u041a\u043e\u0436\u043d\u044b \u043f\u0430-\u0441\u0432\u043e\u0439\u043c\u0443 \u0432\u0451\u045e \u0436\u044b\u0446\u0446\u0451, \u043f\u0440\u044b\u0441\u0432\u0435\u0447\u0430\u043d\u0430\u0435 \u0411\u043e\u0433\u0443. \u041c\u043d\u043e\u0433\u0456\u044f \u0437 \u0456\u0445 \u043f\u0430 \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0432\u044f\u043b\u0456 \u043f\u0443\u0441\u0442\u044d\u043b\u044c\u043d\u0456\u0446\u043a\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0446\u0456 \u0437\u0430\u0441\u043d\u043e\u045e\u0432\u0430\u043b\u0456 \u043c\u0430\u043d\u0430\u0441\u043a\u0456\u044f \u0441\u0435\u043c&rsquo;\u0456, \u044f\u043a\u0456\u044f \u041a\u0430\u0441\u0446\u0451\u043b \u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0440\u044b\u043c\u0430\u045e \u0456 \u0437\u0430\u0446\u0432\u044f\u0440\u0434\u0436\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0430\u045e\u0442\u0430\u0440\u044b\u0442\u044d\u0442\u0430\u043c. \u0422\u0430\u043a, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0411\u043e\u0436\u044b\u043c \u043d\u0430\u043c\u0435\u0440\u0430\u043c, \u0443\u0437\u043d\u0456\u043a\u043b\u0430 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0430\u0441\u0446\u044c \u043c\u0430\u043d\u0430\u0441\u043a\u0456\u0445 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044f\u045e, \u044f\u043a\u0456\u044f \u0456\u0441\u0442\u043e\u0442\u043d\u0430 \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456, \u0448\u0442\u043e \u041a\u0430\u0441\u0446\u0451\u043b \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u044b\u0441\u0442\u0430\u0441\u0430\u0432\u0430\u043d\u044b \u0434\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043d\u044b \u0434\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f \u0434\u0437\u0435\u043b\u044f \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u045e\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u044b \u0440\u043e\u0437\u043d\u044b\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456 \u0441\u0432\u0430\u0456\u0445 \u0434\u0437\u044f\u0446\u0435\u0439, &laquo;\u0431\u044b\u0446\u0446\u0430\u043c \u043d\u044f\u0432\u0435\u0441\u0442\u0430, \u043f\u0440\u044b\u0431\u0440\u0430\u043d\u0430\u044f \u0434\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0436\u0430\u043d\u0456\u0445\u0430&raquo; (\u0410\u043f 21, 2), \u0456 \u043f\u0440\u0430\u0437 \u044f\u0433\u043e \u043c\u043e\u0436\u043d\u0430 \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c &laquo;\u0431\u044f\u0441\u043a\u043e\u043d\u0446\u0443\u044e \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0411\u043e\u0436\u0443\u044e&raquo; (\u042d\u0444 3, 10).<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0442\u0430\u043a\u043e\u0439 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0440\u0430\u0437\u043d\u0430\u0441\u0442\u0430\u0439\u043d\u0430\u0441\u0446\u0456 \u0434\u0430\u0440\u043e\u045e \u0443\u0441\u0435, \u0445\u0442\u043e \u0431\u044b\u045e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c \u0434\u0430 \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u043d\u043d\u044f \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u0445 \u043f\u0430\u0440\u0430\u0434 \u0456 \u0432\u0435\u0440\u043d\u0430 \u0456\u0445 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435, \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u0430 \u043f\u0440\u044b\u0441\u0432\u044f\u0447\u0430\u044e\u0446\u044c \u0441\u044f\u0431\u0435 \u0411\u043e\u0433\u0443, \u0456\u0434\u0443\u0447\u044b \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u044b\u043c, \u0443\u0431\u043e\u0433\u0456\u043c \u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c &laquo;\u0430\u0436\u043d\u043e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u043a\u0440\u044b\u0436\u043e\u0432\u0430\u0439&raquo; (\u0424\u043b\u043f 2, 8), \u044f\u043a\u0456 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0456 \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u043b\u044e\u0434\u0437\u0435\u0439. \u0423\u0437\u0440\u0443\u0448\u0430\u043d\u044b\u044f \u043b\u044e\u0431\u043e\u045e\u044e, \u044f\u043a\u043e\u0439 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0456\u0445\u043d\u0456\u044f \u0441\u044d\u0440\u0446\u044b, \u044f\u043d\u044b \u045e\u0441\u0451 \u0431\u043e\u043b\u044c\u0448 \u0436\u044b\u0432\u0443\u0446\u044c \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0434\u043b\u044f \u042f\u0433\u043e\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u044f\u043a\u0456\u043c \u0451\u0441\u0446\u044c \u041a\u0430\u0441\u0446\u0451\u043b. \u0427\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u0430\u0434\u0434\u0430\u043d\u0430 \u044f\u043d\u044b \u044f\u0434\u043d\u0430\u044e\u0446\u0446\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u043f\u0440\u0430\u0437 \u0442\u0430\u043a\u0443\u044e \u0441\u0430\u043c\u0430\u0430\u0434\u0434\u0430\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0430\u044f \u0430\u0445\u043e\u043f\u043b\u0456\u0432\u0430\u0435 \u045e\u0441\u0451 \u0436\u044b\u0446\u0446\u0451, \u0442\u044b\u043c \u0431\u043e\u043b\u044c\u0448 \u043a\u0440\u0430\u0441\u0443\u0435 \u0436\u044b\u0446\u0446\u0451 \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0456 \u044f\u0433\u043e \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u0442\u0432\u0430 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448\u044b \u043f\u043b\u0451\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u043b\u0435\u043d\u044b \u045e\u0441\u0456\u0445 \u0456\u043d\u0441\u0442\u044b\u0442\u0443\u0442\u0430\u045e \u0443 \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u043c\u044f\u0442\u0430\u0446\u044c, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u0445 \u043f\u0430\u0440\u0430\u0434 \u044f\u043d\u044b \u0430\u0434\u043a\u0430\u0437\u0430\u043b\u0456 \u043d\u0430 \u0411\u043e\u0436\u044b \u0437\u0430\u043a\u043b\u0456\u043a \u0443 \u0442\u044b\u043c \u0441\u044d\u043d\u0441\u0435, \u0448\u0442\u043e \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u0434\u043b\u044f \u0433\u0440\u0430\u0445\u0443, \u0430\u043b\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0432\u044b\u0440\u0430\u043a\u043b\u0456\u0441\u044f \u0441\u0432\u0435\u0442\u0443 \u0456 \u0436\u044b\u0432\u0443\u0446\u044c \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430. \u0423\u0441\u0451 \u0441\u0432\u0430\u0451 \u0436\u044b\u0446\u0446\u0451 \u044f\u043d\u044b \u0430\u0434\u0434\u0430\u043b\u0456 \u043d\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0435 \u042f\u043c\u0443, \u0448\u0442\u043e \u0437&rsquo;\u044f\u045e\u043b\u044f\u0435\u0446\u0446\u0430 \u043f\u044d\u045e\u043d\u0430\u0433\u0430 \u0440\u043e\u0434\u0443 \u043a\u0430\u043d\u0441\u044d\u043a\u0440\u0430\u0446\u044b\u044f\u0439, \u0433\u043b\u044b\u0431\u043e\u043a\u0430 \u045e\u043a\u0430\u0440\u0430\u043d\u0451\u043d\u0430\u0439 \u0443 \u043a\u0430\u043d\u0441\u044d\u043a\u0440\u0430\u0446\u044b\u0456 \u0445\u0440\u043e\u0441\u0442\u0443, \u044f\u043a\u0443\u044e \u0431\u043e\u043b\u044c\u0448 \u043f\u043e\u045e\u043d\u0430 \u0432\u044b\u044f\u045e\u043b\u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u044f, \u0445\u0442\u043e \u0430\u0431\u0430\u0432\u044f\u0437\u0432\u0430\u0435\u0446\u0446\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u044f \u043f\u0430\u0440\u0430\u0434\u044b, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u045e \u043f\u0435\u0440\u0448\u0443\u044e \u0447\u0430\u0440\u0433\u0443 \u0448\u0443\u043a\u0430\u0446\u044c \u0456 \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u043f\u0435\u0440\u0448\u044b \u043d\u0430\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e, \u0456 \u0432\u0430 \u045e\u0441\u044f\u043a\u0456\u0445 \u0430\u0431\u0441\u0442\u0430\u0432\u0456\u043d\u0430\u0445 \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u045e\u043a\u0440\u044b\u0442\u0430\u0433\u0430 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0443 \u0411\u043e\u0433\u0443 \u0436\u044b\u0446\u0446\u044f, \u0437 \u044f\u043a\u043e\u0433\u0430 \u0432\u044b\u043d\u0456\u043a\u0430\u0435 \u0456 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0435 \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0435 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430 \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0441\u0432\u0435\u0442\u0443 \u0456 \u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u041a\u0430\u0441\u0446\u0451\u043b\u0430. \u0413\u044d\u0442\u0430\u044f \u043b\u044e\u0431\u043e\u045e \u0430\u0436\u044b\u045e\u043b\u044f\u0435 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0430\u043c\u043e \u043f\u0440\u0430\u043a\u0442\u044b\u043a\u0430\u0432\u0430\u043d\u043d\u0435 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0456\u0445 \u043f\u0430\u0440\u0430\u0434 \u0456 \u043a\u0456\u0440\u0443\u0435 \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0427\u044b\u0441\u0442\u0430\u0441\u0446\u044c &laquo;\u0434\u0437\u0435\u043b\u044f \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0411\u043e\u0436\u0430\u0433\u0430&raquo; (\u043f\u0430\u0440. \u041c\u0446 19, 12), \u044f\u043a\u0443\u044e \u0430\u0431\u044f\u0446\u0430\u044e\u0446\u044c \u043a\u0430\u043d\u0441\u044d\u043a\u0440\u0430\u0432\u0430\u043d\u044b\u044f \u0430\u0441\u043e\u0431\u044b, \u0442\u0440\u044d\u0431\u0430 \u0446\u0430\u043d\u0456\u0446\u044c \u044f\u043a \u0432\u044b\u043a\u043b\u044e\u0447\u043d\u0430 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b \u0434\u0430\u0440. \u0411\u043e \u044f\u043d\u0430 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u0431 \u044f\u043d\u043e \u0433\u0430\u0440\u0430\u0447\u044d\u0439 \u0440\u0430\u0437\u0433\u0430\u0440\u0430\u043b\u0430\u0441\u044f \u043b\u044e\u0431\u043e\u045e\u044e \u0434\u0430 \u0411\u043e\u0433\u0430 \u0456 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439. \u0422\u0430\u043c\u0443 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c &mdash; \u0433\u044d\u0442\u0430 \u0430\u0441\u0430\u0431\u043b\u0456\u0432\u044b \u0437\u043d\u0430\u043a \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e \u0456 \u0432\u0435\u043b\u044c\u043c\u0456 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0441\u0440\u043e\u0434\u0430\u043a, \u044f\u043a\u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u043a\u0430\u043d\u0441\u044d\u043a\u0440\u0430\u0432\u0430\u043d\u044b\u043c \u0430\u0441\u043e\u0431\u0430\u043c \u0434\u043e\u0431\u0440\u0430\u0430\u0445\u0432\u043e\u0442\u043d\u0430 \u043f\u0440\u044b\u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044e \u0411\u043e\u0433\u0443 \u0456 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456\u043c \u0441\u043f\u0440\u0430\u0432\u0430\u043c. \u0422\u0430\u043a\u0456\u043c \u0447\u044b\u043d\u0430\u043c \u044f\u043d\u044b \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u044e\u0446\u044c \u0443\u0441\u0456\u043c \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u0433\u044d\u0442\u044b \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0448\u043b\u044e\u0431, \u044f\u043a\u0456 \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0446\u0430\u043b\u043a\u0430\u043c \u0432\u044b\u044f\u0432\u0456\u0446\u0446\u0430 \u045e \u0431\u0443\u0434\u0443\u0447\u044b\u043c \u0441\u0432\u0435\u0446\u0435; \u0448\u043b\u044e\u0431, \u043f\u0440\u0430\u0437 \u044f\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u043c\u0430\u0435 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041e, \u044f\u043a\u0430\u044f \u0442\u044b \u043f\u0440\u044b\u0433\u043e\u0436\u0430\u044f, \u0434\u0437\u0435\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0422\u044b \u0430\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044f \u0433\u043e\u0434\u043d\u0430\u0439 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0432\u044f\u043d\u043e\u043a \u041f\u0430\u043d\u0430, \u0432\u044f\u043d\u043e\u043a \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0456\u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0437\u0431\u0430\u0432\u0456\u0446\u044c \u0446\u044f\u0431\u0435 \u043f\u0430\u043b\u044c\u043c\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456 \u0456 \u043d\u0435 \u0430\u0434\u043b\u0443\u0447\u044b\u0446\u044c \u0430\u0434 \u043b\u044e\u0431\u043e\u0432\u0456 \u0411\u043e\u0436\u0430\u0433\u0430 \u0421\u044b\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u0430\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044f \u0433\u043e\u0434\u043d\u0430\u0439 \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0432\u044f\u043d\u043e\u043a \u041f\u0430\u043d\u0430, \u0432\u044f\u043d\u043e\u043a \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0434\u0437\u044f\u0432\u043e\u0446\u0442\u0432\u0430.<\/p>\r\n"}, {"GCH_CH_2_ID":"9081","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>&laquo;\u0413\u0430\u043c\u0456\u043b\u0456\u044f \u0434\u0430 \u043a\u043d\u0456\u0433\u0456 \u0414\u0437\u0435\u044f\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e&raquo; \u0441\u0432. \u042f\u043d\u0430 \u0425\u0440\u044b\u0437\u0430\u0441\u0442\u043e\u043c\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Homilia 20, 4: PG 60, 162-164)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0421\u0432\u044f\u0442\u043b\u043e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u0441\u0445\u0430\u0432\u0430\u043d\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043b\u044f \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430 \u043d\u044f\u043c\u0430 \u0431\u043e\u043b\u044c\u0448\u0430\u0439 \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u0430\u0441\u0446\u0456, \u0447\u044b\u043c \u043d\u0435 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u043f\u0440\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u0448 \u043f\u0440\u044b\u043a\u0440\u044b\u0432\u0430\u0446\u0446\u0430 \u045e\u0431\u043e\u0441\u0442\u0432\u0430\u043c, \u0431\u043e \u0446\u044f\u0431\u0435 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0446\u0456\u0446\u044c \u0443\u0434\u0430\u0432\u0430, \u044f\u043a\u0430\u044f \u045e\u043a\u0456\u043d\u0443\u043b\u0430 \u045e \u0441\u043a\u0430\u0440\u0431\u043e\u043d\u043a\u0443 \u0434\u0432\u0430 \u0433\u0440\u043e\u0448\u044b. \u0422\u0430\u043a\u0441\u0430\u043c\u0430 \u041f\u0451\u0442\u0440 \u043a\u0430\u0437\u0430\u045e: &laquo;\u0421\u0440\u044d\u0431\u0440\u0430 \u0456 \u0437\u043e\u043b\u0430\u0442\u0430 \u043d\u0435 \u043c\u0430\u044e&raquo; (\u0414\u0437 3, 6). \u041f\u0430\u0432\u0435\u043b \u0436\u0430 \u0431\u044b\u045e \u043d\u0430\u0441\u0442\u043e\u043b\u044c\u043a\u0456 \u0431\u0435\u0434\u043d\u044b, \u0448\u0442\u043e \u0447\u0430\u0441\u0442\u0430 \u0433\u0430\u043b\u0430\u0434\u0430\u045e \u0456 \u0431\u044b\u045e \u043f\u0430\u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430\u0433\u0430 \u0441\u043f\u0430\u0436\u044b\u0442\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043d\u0435 \u043c\u043e\u0436\u0430\u0448 \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u0446\u0446\u0430 \u043d\u0430 \u0441\u0432\u0430\u044e \u043d\u044f\u0437\u043d\u0430\u0442\u043d\u0430\u0441\u0446\u044c, \u0431\u043e \u0456 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u043d\u044f\u0437\u043d\u0430\u0442\u043d\u0430\u0433\u0430 \u043f\u0430\u0445\u043e\u0434\u0436\u0430\u043d\u043d\u044f. \u041d\u0435 \u043c\u043e\u0436\u0430\u0448 \u0430\u043f\u0440\u0430\u045e\u0434\u0432\u0430\u0446\u0446\u0430 \u0456 \u0441\u0432\u0430\u0451\u0439 \u043d\u0435\u0430\u0434\u0443\u043a\u0430\u0432\u0430\u043d\u0430\u0441\u0446\u044e, \u0431\u043e \u0456 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u043d\u0435\u043f\u0456\u0441\u044c\u043c\u0435\u043d\u043d\u044b\u044f. \u041d\u0435 \u043c\u043e\u0436\u0430\u0448 \u0430\u0434\u0433\u0430\u0432\u043e\u0440\u0432\u0430\u0446\u0446\u0430 \u0441\u043b\u0430\u0431\u044b\u043c \u0437\u0434\u0430\u0440\u043e\u045e\u0435\u043c, \u0431\u043e \u0456 \u0426\u0456\u043c\u0430\u0444\u0435\u0439 \u0431\u044b\u045e \u0441\u043b\u0430\u0431\u044b \u0456 \u0447\u0430\u0441\u0442\u0430 \u0445\u0432\u0430\u0440\u044d\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043e\u0436\u043d\u044b \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u043d\u044b \u0434\u043b\u044f \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u043a\u0430\u043b\u0456 \u0442\u043e\u043b\u044c\u043a\u0456 \u0445\u043e\u0447\u0430 \u0432\u044b\u043a\u0430\u043d\u0430\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u044f\u043c\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0456 \u043d\u0435 \u0431\u0430\u0447\u044b\u0448 \u0431\u044f\u0441\u043f\u043b\u043e\u0434\u043d\u044b\u0445 \u0434\u0440\u044d\u0432\u0430\u045e, \u044f\u043a\u0456\u044f \u044f\u043d\u044b \u043f\u0440\u044b\u0433\u043e\u0436\u044b\u044f, \u0432\u044b\u0441\u043e\u043a\u0456\u044f, \u0441\u0442\u0440\u043e\u0439\u043d\u044b\u044f \u0456 \u0433\u043b\u0430\u0434\u043a\u0456\u044f? \u0406 \u045e\u0441\u0451 \u0436 \u043b\u0435\u043f\u0448, \u043a\u0430\u0431 \u0443 \u043d\u0430\u0448\u044b\u043c \u0441\u0430\u0434\u0437\u0435 \u0431\u044b\u043b\u0456 \u044f\u0431\u043b\u044b\u043d\u0456 \u0456 \u0430\u043b\u0456\u045e\u043a\u0456, \u044f\u043a\u0456\u044f \u043f\u0440\u044b\u043d\u043e\u0441\u044f\u0446\u044c \u043f\u043b\u0430\u0434\u044b, \u0431\u043e \u0442\u044b\u044f \u0434\u0440\u044d\u0432\u044b \u0434\u043b\u044f \u0430\u0441\u0430\u043b\u043e\u0434\u044b, \u0456 \u043a\u0430\u043b\u0456 \u0451\u0441\u0446\u044c \u0430\u0434 \u0456\u0445 \u043d\u0435\u0439\u043a\u0430\u044f \u043a\u0430\u0440\u044b\u0441\u0446\u044c, \u0434\u044b\u043a \u043c\u0430\u043b\u0430\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a\u0456\u043c\u0456 \u0437&rsquo;\u044f\u045e\u043b\u044f\u044e\u0446\u0446\u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0434\u0443\u043c\u0430\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430 \u0441\u044f\u0431\u0435. \u042f\u043d\u044b \u043f\u0440\u044b\u0434\u0430\u0442\u043d\u044b\u044f \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u043a\u0430\u0431 \u0456\u0445 \u0432\u044b\u043a\u0456\u043d\u0443\u0446\u044c. \u0414\u0440\u044d\u0432\u044b \u043f\u0440\u044b\u0434\u0430\u0442\u043d\u044b\u044f \u0434\u043b\u044f \u0431\u0443\u0434\u043e\u045e\u043b\u0456 \u0456 \u0434\u043b\u044f \u0430\u0433\u0430\u0440\u043e\u0434\u0436\u044b. \u0422\u0430\u043a\u0456\u043c\u0456 \u0431\u044b\u043b\u0456 \u0442\u044b\u044f \u0441\u043b\u0430\u0432\u0443\u0442\u044b\u044f \u0434\u0437\u0435\u0432\u044b, \u0447\u044b\u0441\u0442\u044b\u044f, \u0443\u043f\u0440\u044b\u0433\u043e\u0436\u0430\u043d\u044b\u044f, \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u044b\u044f, \u0430\u043b\u0435 \u0431\u0435\u0441\u043a\u0430\u0440\u044b&shy;\u0441\u043d\u044b\u044f, \u0442\u0430\u043c\u0443 \u0456\u0445 \u0432\u044b\u043a\u0456\u043d\u0443\u043b\u0456 \u0432\u043e\u043d. \u0422\u0430\u043a\u0456\u044f \u0456 \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u0434\u0431\u0430\u0435 \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0432\u044f\u0440\u043d\u0456 \u045e\u0432\u0430\u0433\u0443, \u0448\u0442\u043e \u043d\u0456\u0445\u0442\u043e \u0437 \u0456\u0445 \u043d\u0435 \u0430\u0431\u0432\u0456\u043d\u0430\u0432\u0430\u0447\u0432\u0430\u0435\u0446\u0446\u0430 \u045e \u0433\u0440\u0430\u0445\u0430\u0445: \u043d\u0456 \u045e \u0447\u0443\u0436\u0430\u043b\u043e\u0441\u0442\u0432\u0435, \u043d\u0456 \u045e \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430\u0439 \u043f\u0440\u044b\u0441\u044f\u0437\u0435, \u043d\u0456 \u045e \u0447\u044b\u043c \u0456\u043d\u0448\u044b\u043c, \u0430\u043b\u0435 \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u043d\u0435 \u0431\u044b\u045e \u043a\u0430\u0440\u044b\u0441\u043d\u044b \u0456\u043d\u0448\u0430\u043c\u0443. \u0422\u0430\u043a\u0456 \u0431\u044b\u045e \u0442\u043e\u0439, \u0445\u0442\u043e \u0437\u0430\u043a\u0430\u043f\u0430\u045e \u0442\u0430\u043b\u0435\u043d\u0442: \u044f\u0433\u043e \u0436\u044b\u0446\u0446\u0451 \u0431\u044b\u043b\u043e \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u043c, \u0430\u043b\u0435 \u0431\u0435\u0441\u043a\u0430\u0440\u044b\u0441\u043d\u044b\u043c \u0434\u043b\u044f \u0456\u043d\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u043f\u044b\u0442\u0430\u044e\u0441\u044f, \u0446\u0456 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d \u0442\u0430\u043a\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a? \u0426\u0456 \u0437\u0430\u043a\u0432\u0430\u0441\u043a\u0430, \u043a\u0456\u043d\u0443\u0442\u0430\u044f \u045e \u0446\u0435\u0441\u0442\u0430, \u0431\u0443\u0434\u0437\u0435 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0437\u0430\u043a\u0432\u0430\u0441\u043a\u0430\u0439, \u043a\u0430\u043b\u0456 \u043d\u0435 \u0437\u043c\u0435\u043d\u0456\u0446\u044c \u0443\u0441\u044f\u0433\u043e \u0434\u0430 \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430\u0433\u0430 \u0441\u0442\u0430\u043d\u0443? \u0426\u0456 \u043d\u0430\u0437\u0430\u0432\u0435\u043c \u0434\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u043d\u0430\u043c\u0430\u0448\u0447\u044d\u043d\u043d\u0435\u043c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u0432\u043e\u0434\u0430\u0440\u0443?<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u043a\u0430\u0436\u044b: &laquo;\u041d\u0435 \u043c\u0430\u0433\u0443 \u043f\u0430\u0432\u0435\u0441\u0446\u0456 \u0437\u0430 \u0441\u0430\u0431\u043e\u0439 \u0456\u043d\u0448\u044b\u0445&raquo;, &ndash; \u0431\u043e \u043a\u0430\u043b\u0456 \u0442\u044b \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d, \u0442\u0430\u043a \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0431\u044b\u0446\u044c. \u042f\u043a \u0442\u043e\u0435, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0443 \u043f\u0440\u044b\u0440\u043e\u0434\u0437\u0435, \u043d\u0435 \u0441\u0443\u043f\u044f\u0440\u044d\u0447\u044b\u0446\u044c \u0430\u0434\u043d\u043e \u0430\u0434\u043d\u0430\u043c\u0443, \u0442\u0430\u043a \u0456 \u043d\u0430\u0442\u0443\u0440\u044b \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u0442\u0432\u0430 \u045e\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u0432\u0435\u0441\u0446\u0456 \u0437\u0430 \u0441\u0430\u0431\u043e\u0439 \u0456\u043d\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0439 \u0411\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u0431 \u0442\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u043e\u043d\u0446\u0443, \u0448\u0442\u043e \u044f\u043d\u043e \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u0432\u044f\u0446\u0456\u0446\u044c, \u0442\u044b \u0430\u0431\u0440\u0430\u0437\u0456\u045e \u0431\u044b \u044f\u0433\u043e. \u0410 \u043a\u0430\u043b\u0456 \u043a\u0430\u0436\u0430\u0448, \u0448\u0442\u043e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d \u043d\u0435 \u043c\u043e\u0436\u0430 \u0431\u044b\u0446\u044c \u043a\u0430\u0440\u044b\u0441\u043d\u044b, \u0442\u043e \u0437\u043d\u0435\u0432\u0430\u0436\u0430\u0435\u0448 \u0411\u043e\u0433\u0430 \u0456 \u043d\u0430\u0437\u044b\u0432\u0430\u0435\u0448 \u042f\u0433\u043e \u0456\u043b\u0433\u0443\u043d\u043e\u043c. \u0411\u043e \u043b\u044f\u0433\u0447\u044d\u0439 \u0441\u043e\u043d\u0446\u0443 \u043d\u0435 \u0433\u0440\u044d\u0446\u044c \u0456 \u043d\u0435 \u0441\u0432\u044f\u0446\u0456\u0446\u044c, \u0447\u044b\u043c \u043d\u0435 \u0441\u0432\u044f\u0446\u0456\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0443. \u0422\u0430\u0434\u044b \u0431 \u0445\u0443\u0442\u0447\u044d\u0439 \u0441\u0432\u044f\u0442\u043b\u043e \u043f\u0435\u0440\u0430\u0442\u0432\u0430\u0440\u044b\u043b\u0430\u0441\u044f \u045e \u0437\u043c\u0440\u043e\u043a, \u0447\u044b\u043c \u0437 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430\u043c \u0433\u044d\u0442\u0430\u043a \u0441\u0442\u0430\u043b\u0430\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043d\u0435 \u043a\u0430\u0436\u044b, \u0448\u0442\u043e \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430, \u0431\u043e \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0439 \u0451\u0441\u0446\u044c \u0431\u044f\u0437\u0434\u0437\u0435\u0439\u043d\u0430\u0441\u0446\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430. \u041d\u0435 \u0430\u0431\u0440\u0430\u0436\u0430\u0439 \u0411\u043e\u0433\u0430. \u041a\u0430\u043b\u0456 \u043c\u044b \u0434\u043e\u0431\u0440\u0430 \u0441\u043a\u043b\u0430\u0434\u0437\u0435\u043c \u0441\u0430\u0431\u0435 \u043d\u0430\u0448\u044b \u043f\u043b\u0430\u043d\u044b, \u0442\u0430\u0434\u044b \u045e\u0441\u0451 \u0456\u0434\u0437\u0435 \u043d\u0430\u0442\u0443\u0440\u0430\u043b\u044c\u043d\u0430. \u0421\u0432\u044f\u0442\u043b\u043e \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0456\u043d\u0430 \u043d\u0435 \u043c\u043e\u0436\u0430 \u0441\u0445\u0430\u0432\u0430\u0446\u0446\u0430, \u043d\u0435\u043b\u044c\u0433\u0430 \u0437\u0430\u0441\u043b\u0430\u043d\u0456\u0446\u044c \u0442\u0430\u043a\u0456 \u044f\u0440\u043a\u0456 \u0441\u0432\u0435\u0442\u0430\u0447.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042d\u0444 5, 8-9; \u041c\u0446 5, 14. 16<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044b \u0441\u0432\u044f\u0442\u043b\u043e \u045e \u041f\u0430\u043d\u0443: \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435, \u044f\u043a \u0434\u0437\u0435\u0446\u0456 \u0441\u0432\u044f\u0442\u043b\u0430.<span style=\"color: #ff0000;\">*<\/span> \u0411\u043e \u043f\u043b\u043e\u0434 \u0441\u0432\u044f\u0442\u043b\u0430 \u0451\u0441\u0446\u044c \u0432\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u044b &ndash; \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u0432\u0435\u0442\u0443. \u041d\u044f\u0445\u0430\u0439 \u0441\u0432\u044f\u0442\u043b\u043e \u0432\u0430\u0448\u0430\u0435 \u0442\u0430\u043a \u0441\u0432\u0435\u0446\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043b\u044e\u0434\u0437\u044c\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u043f\u043b\u043e\u0434 \u0441\u0432\u044f\u0442\u043b\u0430 \u0451\u0441\u0446\u044c \u0432\u0430 \u045e\u0441\u044f\u043b\u044f\u043a\u0430\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456, \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/p>\r\n"}, {"GCH_CH_2_ID":"9082","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u045e\u0433\u0443\u0441\u0442\u044b\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Sermo 96, 1. 4. 9: PL 38, 584. 586. 588)<\/span><br \/><em><span style=\"color: #ff0000;\">\u041f\u0430\u045e\u0441\u044e\u0434\u043d\u0430\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435 \u0434\u0430 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u043f\u0430\u0439\u0441\u0446\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e, \u043d\u044f\u0445\u0430\u0439 \u0430\u0434\u0440\u0430\u0447\u044d\u0446\u0446\u0430 \u0430\u0434 \u0441\u044f\u0431\u0435, \u0432\u043e\u0437\u044c\u043c\u0435 \u043a\u0440\u044b\u0436 \u0441\u0432\u043e\u0439, \u0456 \u0456\u0434\u0437\u0435 \u0437\u0430 \u041c\u043d\u043e\u044e&raquo; (\u041c\u0446 16, 24). \u0413\u044d\u0442\u044b \u0437\u0430\u0433\u0430\u0434 \u041f\u0430\u043d\u0430, \u043a\u0430\u0431 \u0442\u043e\u0439, \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u043f\u0430\u0439\u0441\u0446\u0456 \u0437\u0430 \u0406\u043c, \u0430\u0434\u043c\u043e\u0432\u0456\u045e\u0441\u044f \u0430\u0434 \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u043d\u0430\u043c \u0446\u044f\u0436\u043a\u0456\u043c. \u0410\u043b\u0435 \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0435, \u043d\u0435 \u0441\u043a\u043b\u0430\u0434\u0430\u043d\u0430\u0435 \u0456 \u043d\u0435 \u0446\u044f\u0436\u043a\u0430\u0435, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0435 \u043d\u0430\u043c \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u0433\u044d\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b\u044f \u0441\u043b\u043e\u0432\u044b \u0441\u043a\u0430\u0437\u0430\u043d\u044b \u045e \u043f\u0441\u0430\u043b\u044c\u043c\u0435: &laquo;\u041f\u0430\u0432\u043e\u0434\u043b\u0435 \u0441\u043b\u043e\u0432\u0430\u045e \u0432\u0443\u0441\u043d\u0430\u045e \u0422\u0432\u0430\u0456\u0445 \u044f \u0441\u0446\u044f\u0440\u043e\u0433\u0441\u044f \u0430\u0434 \u0448\u043b\u044f\u0445\u043e\u045e \u043d\u0430\u0441\u0456\u043b\u043b\u044f&raquo; (\u043f\u0430\u0440. \u041f\u0441 17 [16], 4). \u041f\u0440\u0430\u045e\u0434\u0430 \u0456 \u0442\u043e\u0435, \u0448\u0442\u043e \u0441\u043a\u0430\u0437\u0430\u045e \u0441\u0430\u043c \u041f\u0430\u043d: &laquo;\u042f\u0440\u043c\u043e \u041c\u0430\u0451 \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435, \u0456 \u0446\u044f\u0436\u0430\u0440 \u041c\u043e\u0439 \u043b\u0451\u0433\u043a\u0456&raquo; (\u041c\u0446 11, 30). \u041b\u044e\u0431\u043e\u045e \u0440\u043e\u0431\u0456\u0446\u044c \u043b\u0451\u0433\u043a\u0456\u043c \u0443\u0441\u0451, \u0448\u0442\u043e \u0446\u044f\u0436\u043a\u0430\u0435 \u045e \u043d\u0430\u043a\u0430\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0442\u043e \u0430\u0437\u043d\u0430\u0447\u0430\u0435 &laquo;\u043d\u044f\u0445\u0430\u0439 \u0432\u043e\u0437\u044c\u043c\u0435 \u043a\u0440\u044b\u0436 \u0441\u0432\u043e\u0439&raquo; (\u041c\u0446 16, 24)? \u0413\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u043d\u044f\u0445\u0430\u0439 \u0446\u0435\u0440\u043f\u0456\u0446\u044c \u0443\u0441\u044f\u043a\u0430\u0435 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u0435 \u0456 \u0433\u044d\u0442\u0430\u043a \u0456\u0434\u0437\u0435 \u0437\u0430 \u041f\u0430\u043d\u0430\u043c. \u0411\u043e \u043a\u0430\u043b\u0456 \u043d\u0435\u0445\u0442\u0430 \u043f\u0430\u0447\u043d\u0435 \u0456\u0441\u0446\u0456 \u0437\u0430 \u0406\u043c \u0456 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u042f\u0433\u043e\u043d\u044b\u044f \u043d\u0430\u043a\u0430\u0437\u044b, \u0442\u043e \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0435 \u0448\u043c\u0430\u0442 \u043f\u0440\u0430\u0446\u0456\u045e\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0446\u044c \u044f\u0433\u043e \u0456 \u0441\u0442\u0430\u0440\u0430\u0446\u0446\u0430 \u0430\u0434\u0433\u0430\u0432\u0430\u0440\u044b\u0446\u044c, \u0456 \u0433\u044d\u0442\u0430 \u043d\u0430\u0432\u0430\u0442 \u0441\u044f\u0440\u043e\u0434 \u0442\u044b\u0445, \u0448\u0442\u043e \u043b\u0456\u0447\u044b\u0446\u044c \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u0445\u0456\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0425\u0440\u044b\u0441\u0442\u0430. \u0420\u0430\u0437\u0430\u043c \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c \u0445\u0430\u0434\u0437\u0456\u043b\u0456 \u0456 \u0442\u0430\u043a\u0456\u044f, \u0448\u0442\u043e \u0437\u0430\u0431\u0430\u0440\u0430\u043d\u044f\u043b\u0456 \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u044b\u043c \u043a\u0440\u044b\u0447\u0430\u0446\u044c \u0434\u0430 \u041f\u0430\u043d\u0430. \u0422\u0430\u043c\u0443, \u043a\u0430\u043b\u0456 \u0445\u043e\u0447\u0430\u0448 \u043f\u0430\u0439\u0441\u0446\u0456 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u043a\u0440\u044b\u0436\u0430\u043c \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0430\u0433\u0440\u043e\u0437\u044b, \u043b\u0456\u0441\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u045e\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u0437\u0430\u0431\u0430\u0440\u043e\u043d\u044b. \u0410\u0434\u043d\u0430\u043a \u0446\u044f\u0440\u043f\u0456 \u0433\u044d\u0442\u0430, \u043d\u044f\u0441\u0456 \u0456 \u043d\u0435 \u0437\u0433\u0456\u043d\u0430\u0439\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043a \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u0434\u043e\u0431\u0440\u044b\u043c, \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u044b\u043c, \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b\u043c \u0446\u0456, \u043f\u0440\u044b\u043d\u0430\u043c\u0441\u0456, \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u043c \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f (\u0431\u043e &laquo;\u043c\u044b \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u043f\u0440\u0430\u0437 \u043d\u0430\u0434\u0437\u0435\u044e&raquo; [\u0420\u044b\u043c 8, 24]) &ndash; \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u041a\u0430\u0441\u0446\u0451\u043b\u0435, \u044f\u043a\u0456 \u0456\u0434\u0437\u0435 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0401\u043d \u043a\u0430\u0436\u0430 \u0434\u043b\u044f \u045e\u0441\u0456\u0445: &laquo;\u041a\u0430\u043b\u0456 \u0445\u0442\u043e \u0445\u043e\u0447\u0430 \u0456\u0441\u0446\u0456 \u0437\u0430 \u041c\u043d\u043e\u044e, \u043d\u044f\u0445\u0430\u0439 \u0430\u0434\u0440\u0430\u0447\u044d\u0446\u0446\u0430 \u0430\u0434 \u0441\u044f\u0431\u0435&raquo; (\u043f\u0430\u0440. \u041c\u0446 16, 24).<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u043d\u0435 \u043a\u0430\u0436\u0430 \u0433\u044d\u0442\u0430 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0430\u043d\u043d\u0430\u043c, \u0430 \u043f\u0430\u0448\u043b\u044e\u0431\u0430\u0432\u0430\u043d\u044b\u043c \u043d\u0435; \u0443\u0434\u043e\u0432\u0430\u043c, \u0430 \u0437\u0430\u043c\u0443\u0436\u043d\u0456\u043c \u043d\u0435; \u043f\u0430\u0441\u0432\u044f\u0447\u0430\u043d\u044b\u043c \u0411\u043e\u0433\u0443, \u0430 \u0442\u044b\u043c, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0441\u0443\u0436\u044d\u043d\u0441\u0442\u0432\u0435, \u043d\u0435; \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c, \u0430 \u0441\u0432\u0435\u0446\u043a\u0456\u043c \u043d\u0435. \u0423\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b, \u0443\u0441\u0451 \u042f\u0433\u043e \u0446\u0435\u043b\u0430, \u0443\u0441\u0435 \u044f\u0433\u043e\u043d\u044b\u044f \u0447\u0430\u0441\u0442\u043a\u0456, \u043a\u043e\u0436\u043d\u0430\u044f \u043d\u0430 \u0441\u0432\u0430\u0456\u043c \u043c\u0435\u0441\u0446\u044b \u0456 \u045e \u0441\u0432\u0430\u0456\u0445 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u0445, \u0443\u0441\u0435 \u044f\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0456\u0441\u0446\u0456 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0426\u0430\u043b\u043a\u0430\u043c \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0456\u0441\u0446\u0456 \u042f\u0433\u043e \u0430\u0434\u0437\u0456\u043d\u0430\u044f, \u042f\u0433\u043e \u0433\u0430\u043b\u0443\u0431\u043a\u0430, \u042f\u0433\u043e \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430, \u042f\u0433\u043e \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u0430\u044f \u0456 \u0430\u0434\u043e\u0440\u0430\u043d\u0430\u044f \u043f\u0430\u0441\u0430\u0433\u0430\u043c \u043a\u0440\u044b\u0432\u0456 \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a\u0430. \u0406 \u0442\u0430\u043c \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0446\u0430 \u043c\u0435\u0441\u0446\u0430 \u0434\u043b\u044f \u045e\u0441\u044f\u0433\u043e: \u044f\u043a \u0434\u043b\u044f \u0434\u0437\u044f\u0432\u043e\u0447\u0430\u0439 \u0446\u043d\u0430\u0442\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0441\u0446\u0456 \u045e\u0434\u043e\u0432\u0430\u045e, \u0442\u0430\u043a \u0456 \u0434\u043b\u044f \u0441\u0443\u0436\u044d\u043d\u0441\u043a\u0430\u0439 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u045e\u0441\u0435 \u0433\u044d\u0442\u044b\u044f \u0447\u0430\u0441\u0442\u043a\u0456 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0446\u0435\u043b\u0430, \u044f\u043a\u0456\u044f \u0437\u0430\u0439\u043c\u0430\u044e\u0446\u044c \u0430\u0441\u043e\u0431\u043d\u044b\u044f \u043c\u0435\u0441\u0446\u044b \u0456 \u043f\u0430-\u0441\u0432\u043e\u0439\u043c\u0443 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u0440\u043e\u0437\u043d\u044b\u044f \u0444\u0443\u043d\u043a\u0446\u044b\u0456, \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043f\u0430\u0439\u0441\u0446\u0456 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u043e\u043c. \u042f\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0430\u0434\u043c\u043e\u0432\u0456\u0446\u0446\u0430 \u0430\u0434 \u0441\u044f\u0431\u0435 \u0456 \u045e\u0437\u044f\u0446\u044c \u0441\u0432\u043e\u0439 \u043a\u0440\u044b\u0436, \u0433\u044d\u0442\u0430 \u0437\u043d\u0430\u0447\u044b\u0446\u044c, \u0446\u044f\u0440\u043f\u0435\u0446\u044c \u0443 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435&shy;\u0446\u0435 \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u0441\u0432\u0435\u0442 \u0456\u043c \u043f\u0440\u044b\u0447\u044b\u043d\u0456\u0446\u044c. \u042f\u043d\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0430\u0434\u0437\u0456\u043d \u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u0435. \u041f\u0430\u0432\u0456\u043d\u043d\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e, \u0431\u043e \u0401\u043d \u0430\u0434\u0437\u0456\u043d \u043d\u0435 \u043f\u0430\u0434\u0432\u044f\u0434\u0437\u0435. \u041f\u0430\u0432\u0456\u043d\u043d\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e, \u0431\u043e \u0442\u043e\u0435, \u0448\u0442\u043e \u0401\u043d \u043a\u0430\u0436\u0430, \u043f\u0440\u0430\u045e\u0434\u0430. \u0410\u043b\u0435 \u043a\u0430\u043b\u0456 \u043d\u0435 \u0434\u0430\u0435 \u045e\u0436\u043e \u0446\u044f\u043f\u0435\u0440, \u0432\u0435\u0440\u0430 \u0445\u0456\u0441\u0442\u0430\u0435\u0446\u0446\u0430. \u0426\u0432\u0451\u0440\u0434\u0430 \u0442\u0440\u044b\u0432\u0430\u0439, \u0437\u043d\u043e\u0441\u044c, \u0446\u044f\u0440\u043f\u0456, \u0447\u0430\u043a\u0430\u0439 \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0433\u0430 \u0456 \u043d\u044f\u0441\u0456 \u043a\u0440\u044b\u0436.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0413\u044d\u0442\u0430 \u0442\u043e\u0439, \u0445\u0442\u043e \u045e\u0447\u044b\u043d\u0456\u045e \u0432\u044f\u043b\u0456\u043a\u0456\u044f \u0441\u043f\u0440\u0430\u0432\u044b \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0456 \u0430\u0434 \u0443\u0441\u044f\u0433\u043e \u0441\u044d\u0440\u0446\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u041f\u0430\u043d\u0430. <span style=\"color: #ff0000;\">*<\/span> \u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e \u0443\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0441\u044c \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u0435\u0437 \u0437\u0430\u0433\u0430\u043d\u044b, \u044f\u043a\u0456 \u043f\u0430-\u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u043c\u0443 \u0448\u0430\u043d\u0430\u0432\u0430\u045e \u0411\u043e\u0433\u0430, \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u045e\u0441\u044f \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430 \u0456 \u0442\u0440\u044b\u0432\u0430\u045e \u0443 \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0451\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u0433\u0440\u044d\u0448\u043d\u0456\u043a\u0430\u045e \u0443\u0441\u044f\u0433\u043e \u0441\u0432\u0435\u0442\u0443.<\/p>\r\n"}, {"GCH_CH_2_ID":"9251","GCH_CH_2_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041a\u0430\u0437\u0430\u043d\u043d\u0435 \u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u044f, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0410\u043d\u0442\u044b\u0451\u0445\u0456\u0456<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Oratio 5, de Resurrectione Christi, 6-7. 9:<\/span><br \/><span style=\"color: #ff0000;\">PG 89, 1358-1359. 1361-1362)<\/span><br \/><em><span style=\"color: #ff0000;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430\u0435 \u0446\u0435\u043b\u0430<\/span><\/em><\/p>\r\n<p style=\"text-align: justify;\">&laquo;\u0414\u0437\u0435\u043b\u044f \u0433\u044d\u0442\u0430\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0456 \u043f\u0430\u043c\u0451\u0440, \u0456 \u0430\u0436\u044b\u045e, \u043a\u0430\u0431 \u043f\u0430\u043d\u0430\u0432\u0430\u0446\u044c \u0456 \u043d\u0430\u0434 \u043c\u0451\u0440\u0442\u0432\u044b\u043c\u0456, \u0456 \u043d\u0430\u0434 \u0436\u044b\u0432\u044b\u043c\u0456&raquo; (\u0420\u044b\u043c 14, 9). \u0410\u043b\u0435 \u0401\u043d &ndash; \u0411\u043e\u0433 \u043d\u0435 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0430\u043b\u0435 \u0436\u044b\u0432\u044b\u0445 (\u043f\u0430\u0440. \u041c\u0446 22, 32). \u0422\u0430\u043c\u0443 \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f, \u043d\u0430\u0434 \u044f\u043a\u0456\u043c\u0456 \u0401\u043d \u043f\u0430\u043d\u0443\u0435, \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u043c\u0451\u0440\u0442\u0432\u044b\u044f, \u0430\u043b\u0435 \u0436\u044b\u0432\u044b\u044f. \u0406 \u0434\u043b\u044f \u0442\u0430\u0433\u043e \u0436\u044b\u0446\u0446\u0451 \u043f\u0430\u043d\u0443\u0435 \u043d\u0430\u0434 \u0456\u043c\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u0431\u0430\u044f\u043b\u0456\u0441\u044f \u0441\u043c\u0435\u0440\u0446\u0456, \u0442\u0430\u043a \u044f\u043a &laquo;\u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u0448\u044b \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0443\u0436\u043e \u043d\u0435 \u043f\u0430\u043c\u0456\u0440\u0430\u0435&raquo; (\u0420\u044b\u043c 6, 9).<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0432\u0430\u0441\u043a\u0440\u044d\u0448\u0430\u043d\u044b\u044f \u0456 \u045e\u0440\u0430\u0442\u0430\u0432\u0430\u043d\u044b\u044f \u0430\u0434 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f \u0431\u043e\u043b\u044c\u0448 \u043d\u0435 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0441\u043c\u0435\u0440\u0446\u0456 \u044f\u043a \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0456 \u0431\u0443\u0434\u0443\u0447\u0430\u0433\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u043e \u0401\u043d \u0431\u044b\u045e \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c \u0456\u0445 \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0434\u0437\u0435\u043b\u044f \u0442\u0430\u0433\u043e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u044f\u043a\u0430\u044f \u043c\u0435\u043b\u0430 \u0432\u0435\u0447\u043d\u044b\u044f \u0431\u0440\u0443\u0441\u044b \u0437\u0430\u0441\u043e\u0432\u0430\u045e, \u043a\u0430\u0431 \u0440\u0430\u0437\u0431\u0456\u0446\u044c \u0431\u0440\u043e\u043d\u0437\u0430\u0432\u044b\u044f \u0431\u0440\u0430\u043c\u044b \u0456 \u0437\u043b\u0430\u043c\u0430\u0446\u044c \u0436\u0430\u043b\u0435\u0437\u043d\u044b\u044f \u0437\u0430\u0441\u043e\u0432\u044b (\u043f\u0430\u0440. \u0406\u0441 45, 2; \u041f\u0441 107 [106], 16), \u0430 \u043d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u0432\u044b\u0432\u0435\u0441\u0446\u0456 \u0434\u0430 \u0441\u044f\u0431\u0435 \u0441\u0430 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u044f \u0456 \u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0441\u0432\u0430\u0431\u043e\u0434\u0430\u0439 \u0437\u0430\u043c\u0435\u0441\u0442 \u0440\u0430\u0431\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0441\u043f\u0440\u0430\u0432\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u043d\u0430\u043c\u0435\u0440\u0443 \u0437\u0434\u0430\u0435\u0446\u0446\u0430 \u044f\u0448\u0447\u044d \u043d\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0430\u043d\u0430\u0439, \u0431\u043e \u043b\u044e\u0434\u0437\u0456 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0446\u044c \u0456 \u0446\u0435\u043b\u044b \u0440\u0430\u0441\u043a\u043b\u0430\u0434\u0430\u044e\u0446\u0446\u0430 \u045e \u0432\u044b\u043d\u0456\u043a\u0443 \u0441\u043c\u0435\u0440\u0446\u0456, \u043d\u044f\u0445\u0430\u0439 \u0443 \u043d\u0430\u0441 \u043d\u0435 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0434\u043b\u044f \u043d\u0435\u0434\u0430\u0432\u0435\u0440\u0443. \u0411\u043e \u045e\u0436\u043e \u043f\u0435\u0440\u0430\u0434 \u0443\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0443\u0441\u0456\u0445 \u0434\u0430\u0431\u0440\u043e\u0442\u0430\u045e \u043f\u0440\u0430\u0437 \u043d\u0430\u0448\u044b\u044f \u043f\u0435\u0440\u0448\u044b\u044f \u0434\u0430\u0440\u044b. \u0414\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0456\u043c \u043c\u044b \u045e\u0437\u043d\u044f\u043b\u0456\u0441\u044f \u045e \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u044f \u0432\u044b\u0448\u044b\u043d\u0456 \u0456 \u0441\u0435\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0430\u0434\u043d\u044f\u045e \u043d\u0430\u0441 \u0443\u0433\u043e\u0440\u0443, \u044f\u043a \u0433\u044d\u0442\u0430 \u043a\u0430\u0436\u0430 \u045e \u043f\u044d\u045e\u043d\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u041f\u0430\u0432\u0435\u043b: &laquo;\u0401\u043d \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0456 \u043f\u0430\u0441\u0430\u0434\u0437\u0456\u045e \u043d\u0430\u0441 \u043d\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u0445 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435&raquo; (\u042d\u0444 2, 6).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0434\u0430\u0441\u044f\u0433\u043d\u0435\u043c \u043f\u0430\u045e\u043d\u0430\u0442\u044b, \u043a\u0430\u043b\u0456 \u043d\u0430\u0434\u044b\u0434\u0437\u0435 \u0447\u0430\u0441, \u043f\u0440\u0430\u0434\u0432\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0410\u0439\u0446\u043e\u043c, \u0456 \u0442\u0430\u0434\u044b \u043c\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u043c\u0441\u044f \u0430\u0434 \u0434\u0437\u0456\u0446\u044f\u0447\u044b\u0445 \u0440\u044b\u0441\u0430\u045e \u0456 \u043f\u0435\u0440\u0430\u0442\u0432\u043e\u0440\u044b\u043c\u0441\u044f \u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0433\u0430. \u0411\u043e \u0442\u0430\u043a \u0432\u044b\u0440\u0430\u0448\u044b\u045e \u0410\u0439\u0446\u0435\u0446 \u0432\u044f\u043a\u043e\u045e, \u043a\u0430\u0431 \u0443\u0434\u0437\u0435\u043b\u0435\u043d\u044b \u0434\u0430\u0440 \u0431\u044b\u045e \u0442\u0440\u044b\u0432\u0430\u043b\u044b \u0456 \u043a\u0430\u0431 \u043c\u044b \u0456\u043c \u0437\u043d\u043e\u045e \u043d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0456\u043b\u0456 \u043f\u0440\u0430\u0437 \u0443\u0441\u0451 \u044f\u0448\u0447\u044d \u0434\u0437\u0456\u0446\u044f\u0447\u0443\u044e \u043d\u044f\u0441\u0442\u0430\u043b\u0430\u0441\u0446\u044c \u0440\u043e\u0437\u0443\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0432\u043e\u0448\u0442\u0430 \u043a\u0430\u0437\u0430\u0446\u044c, \u0448\u0442\u043e \u0446\u0435\u043b\u0430 \u041f\u0430\u043d\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0430 \u044f\u043a \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435, \u043a\u0430\u043b\u0456 \u041f\u0430\u0432\u0435\u043b \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0446\u0435\u043b\u044b: &laquo;\u0421\u0435\u0435\u0446\u0446\u0430 \u0446\u0435\u043b\u0430 \u0437\u044f\u043c\u043d\u043e\u0435, \u0443\u0441\u0442\u0430\u0435 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0446\u0435\u043b\u0430&raquo; (1 \u041a\u0430\u0440 15, 44), \u0433. \u0437\u043d. \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0435\u043d\u0430\u0435 \u043d\u0430 \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0441\u043b\u0430\u045e\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0435\u043d\u043d\u044f \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u043f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430, \u044f\u043a\u0456 \u0456\u0434\u0437\u0435 \u043d\u0430\u043f\u0435\u0440\u0430\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043a\u0440\u0430\u043c\u044f \u0442\u0430\u0433\u043e, \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430, \u0448\u0442\u043e \u043f\u0430\u0434\u0437\u0435\u0456, \u0434\u043e\u0431\u0440\u0430 \u0432\u044f\u0434\u043e\u043c\u044b\u044f \u044f\u043c\u0443, \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u044f\u0446\u0446\u0430 \u0437 \u0443\u0441\u0456\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430\u043c \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, &laquo;\u044f\u043a\u0456 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0456\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u043f\u0440\u044b\u043d\u0456\u0436\u0430\u043d\u0430\u0435 \u0446\u0435\u043b\u0430 \u045e \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0426\u0435\u043b\u0430&raquo; (\u0424\u043b\u043f 3, 21).<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0430\u043b\u0456, \u0443\u0440\u044d\u0448\u0446\u0435, \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0435\u043d\u043d\u0435 \u0446\u0435\u043b\u0430 &ndash; \u0433\u044d\u0442\u0430 \u0437\u043c\u0435\u043d\u0430 \u043d\u0430 \u0434\u0443\u0445\u043e\u045e\u043d\u0430\u0435 \u0446\u0435\u043b\u0430, \u0430 \u044f\u043d\u043e \u043f\u0430\u0434\u043e\u0431\u043d\u0430\u0435 \u0434\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0442\u0430\u043c\u0443 \u0456 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0443 \u0434\u0443\u0445\u043e\u045e\u043d\u044b\u043c \u0446\u0435\u043b\u0435. \u0406 \u0433\u044d\u0442\u0430 \u0442\u043e\u0435 \u0436 \u0446\u0435\u043b\u0430, \u0448\u0442\u043e \u0431\u044b\u043b\u043e \u043f\u0430\u0441\u0435\u044f\u043d\u0430 \u045e \u043f\u0430\u0433\u0430\u0440\u0434\u0437\u0435 (\u043f\u0430\u0440. 1 \u041a\u0430\u0440 15, 43), \u0430\u043b\u0435 \u043f\u0435\u0440\u0430\u043c\u0435\u043d\u0435\u043d\u0430\u0435 \u045e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410 \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0401\u043d \u043f\u0440\u044b\u0432\u0451\u045e \u0434\u0430 \u0410\u0439\u0446\u0430 \u043f\u0435\u0440\u0448\u044b\u044f \u043f\u043b\u0451\u043d\u044b \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b, \u0442\u043e \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0456 \u044f\u0435 \u0446\u0430\u043b\u043a\u0430\u043c. \u0401\u043d \u0442\u0430\u043a \u0456 \u0430\u0431\u044f\u0446\u0430\u045e, \u043a\u0430\u043b\u0456 \u0441\u043a\u0430\u0437\u0430\u045e: &laquo;\u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443 \u045e\u0437\u043d\u044f\u0442\u044b \u043d\u0430\u0434 \u0437\u044f\u043c\u043b\u0451\u044e, \u0443\u0441\u0456\u0445 \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0443 \u0434\u0430 \u0441\u044f\u0431\u0435&raquo; (\u042f\u043d 12, 32).<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 \u042f\u043d 5, 28-29; 1 \u041a\u0430\u0440 15, 52<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0423\u0441\u0435, \u0445\u0442\u043e \u045e \u043c\u0430\u0433\u0456\u043b\u0430\u0445, \u043f\u0430\u0447\u0443\u044e\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u0421\u044b\u043d\u0430 \u0411\u043e\u0436\u0430\u0433\u0430. <span style=\"color: #ff0000;\">*<\/span> \u0406 \u0442\u044b\u044f, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u045e \u0434\u0430\u0431\u0440\u043e, \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u0434\u043b\u044f \u0436\u044b\u0446\u0446\u044f, \u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0440\u0430\u0431\u0456\u045e \u0437\u043b\u043e, \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u0434\u043b\u044f \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423 \u043c\u043e\u043c\u0430\u043d\u0442, \u0443 \u0456\u043c\u0433\u043d\u0435\u043d\u043d\u0435 \u0432\u043e\u043a\u0430, \u043d\u0430 \u0433\u0443\u043a \u0430\u043f\u043e\u0448\u043d\u044f\u0439 \u0442\u0440\u0443\u0431\u044b \u043c\u0451\u0440\u0442\u0432\u044b\u044f \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0442\u044b\u044f, \u0445\u0442\u043e \u0447\u044b\u043d\u0456\u045e \u0434\u0430\u0431\u0440\u043e, \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u0434\u043b\u044f \u0436\u044b\u0446\u0446\u044f, \u0430 \u0442\u044b\u044f, \u0445\u0442\u043e \u0440\u0430\u0431\u0456\u045e \u0437\u043b\u043e, \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u0434\u043b\u044f \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u044f.<\/p>\r\n"}, {"GCH_CH_2_ID":"9252","GCH_CH_2_Text":"\r\n<p><span style=\"color: #ff0000;\">\u0414\u0420\u0423\u0413\u041e\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span><br \/>\u041b\u0456\u0441\u0442 \u0441\u0432. \u0411\u0440\u0430\u045e\u043b\u0456\u0451\u043d\u0430, \u0431\u0456\u0441\u043a\u0443\u043f\u0430 \u0421\u0430\u0440\u0430\u0433\u043e\u0441\u044b<\/p>\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">(Epist. 19: PL 80, 665-666)<\/span><br \/><span style=\"color: #ff0000;\">\u0423\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u044b \u0425\u0440\u044b\u0441\u0442\u0443\u0441 &ndash; \u043d\u0430\u0434\u0437\u0435\u044f \u045e\u0441\u0456\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u043d\u0430\u0434\u0437\u0435\u044f \u045e\u0441\u0456\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e, \u043d\u0430\u0437\u044b\u0432\u0430\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0434\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u0430 \u0441\u0432\u0435\u0442\u0443, \u0441\u043f\u044f\u0447\u044b\u043c\u0456, \u0430 \u043d\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c\u0456, \u043a\u0430\u0436\u0443\u0447\u044b: &laquo;\u041d\u0430\u0448 \u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044c \u041b\u0430\u0437\u0430\u0440 \u0437\u0430\u0441\u043d\u0443\u045e&raquo; (\u042f\u043d 11, 11).<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u043b\u0435 \u0456 \u0441\u0432\u044f\u0442\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043d\u0435 \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u043c\u044b \u0441\u043c\u0443\u0442\u043a\u0430\u0432\u0430\u043b\u0456 \u043f\u0430 \u0442\u044b\u0445, \u0448\u0442\u043e \u0437\u0430\u0441\u043d\u0443\u043b\u0456 (\u043f\u0430\u0440. 1 \u0422\u044d\u0441 4, 12). \u0406 \u043a\u0430\u043b\u0456 \u043c\u044b \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0442\u0440\u044b\u043c\u0430\u0435\u043c\u0441\u044f \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e\u0441\u0435 \u0432\u0435\u0440\u0443\u044e\u0447\u044b\u044f \u045e \u0425\u0440\u044b\u0441\u0442\u0430, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0435\u0432\u0430\u043d\u0433\u0435\u043b\u044c\u0441\u043a\u0430\u0433\u0430 \u0441\u043b\u043e\u0432\u0430 \u043d\u0435 \u043f\u0430\u043c\u0440\u0443\u0446\u044c \u043d\u0430\u0432\u0435\u043a\u0456, \u0442\u043e \u043c\u044b \u043d\u0430 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0435 \u0432\u0435\u0440\u044b \u0432\u0435\u0434\u0430\u0435\u043c, \u0448\u0442\u043e \u0456 \u0401\u043d \u043d\u0435 \u043c\u0451\u0440\u0442\u0432\u044b, \u0456 \u0448\u0442\u043e \u043c\u044b \u043d\u0435 \u043f\u0430\u043c\u0440\u044d\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0441\u0430\u043c \u041f\u0430\u043d \u043d\u0430 \u0437\u0430\u043a\u043b\u0456\u043a \u0456 \u043d\u0430 \u0433\u043e\u043b\u0430\u0441 \u0430\u0440\u0445\u0430\u043d\u0451\u043b\u0430 \u0456 \u0442\u0440\u0443\u0431\u044b \u0411\u043e\u0436\u0430\u0439 \u0441\u044b\u0434\u0437\u0435 \u0437 \u043d\u0435\u0431\u0430, \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f, \u0448\u0442\u043e \u045e \u0406\u043c, \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0441 \u0430\u0436\u044b\u0432\u0456\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044f \u043d\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435, \u0448\u0442\u043e \u0437\u043d\u043e\u045e \u0443\u0431\u0430\u0447\u044b\u043c \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0441\u0442\u0440\u0430\u0447\u0432\u0430\u0435\u043c \u0442\u0443\u0442. \u0422\u043e\u043b\u044c\u043a\u0456 \u0442\u0440\u044d\u0431\u0430, \u043a\u0430\u0431 \u043c\u044b \u043c\u043e\u0446\u043d\u0430 \u045e \u042f\u0433\u043e \u0432\u0435\u0440\u044b\u043b\u0456, \u0430 \u043c\u0435\u043d\u0430\u0432\u0456\u0442\u0430 \u0441\u043b\u0443\u0445\u0430\u043b\u0456\u0441\u044f \u043d\u0430\u043a\u0430\u0437\u0430\u045e \u042f\u0433\u043e\u043d\u044b\u0445, \u0430 \u042f\u0433\u043e \u043d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u044f \u043c\u043e\u0446 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u0430\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u043b\u044f\u0433\u0447\u044d\u0439, \u0447\u044b\u043c \u043c\u044b \u0431\u0443\u0434\u0437\u0456\u043c \u043a\u0430\u0433\u043e\u0441\u044c\u0446\u0456 \u0430\u0434 \u0441\u043d\u0443. \u0412\u043e\u0441\u044c \u043c\u044b \u0442\u0430\u043a \u043a\u0430\u0436\u0430\u043c, \u0430 \u045e\u0441\u0451 \u0436 \u043d\u0435\u0439\u043a\u0430\u0435, \u043d\u0435 \u0432\u0435\u0434\u0430\u044e \u044f\u043a\u043e\u0435, \u043f\u0430\u0447\u0443\u0446\u0446\u0451 \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u0435 \u045e \u043d\u0430\u0441 \u0441\u043b\u0451\u0437\u044b. \u0406 \u0433\u044d\u0442\u0430\u0435 \u0442\u0443\u0436\u043b\u0456\u0432\u0430\u0435 \u043f\u0430\u0447\u0443\u0446\u0446\u0451 \u043b\u0430\u043c\u0430\u0435 \u043d\u0430\u0448 \u0434\u0430\u0432\u0435\u0440\u043b\u0456\u0432\u044b \u0434\u0443\u0445. \u041d\u0430 \u0436\u0430\u043b\u044c, \u0433\u0430\u0440\u043e\u0442\u043d\u044b \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u043b\u0451\u0441, \u0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u043c\u044b \u043f\u0435\u0440\u0430\u0436\u044b\u0432\u0430\u0435\u043c \u0431\u0435\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u043c\u0430\u0440\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0441\u043c\u0435\u0440\u0446\u044c, \u0442\u044b \u0440\u0430\u0437\u0434\u0437\u044f\u043b\u044f\u0435\u0448 \u0437\u043b\u0443\u0447\u0430\u043d\u044b\u0445 \u0456, \u0431\u0443\u0434\u0443\u0447\u044b \u043d\u044f\u045e\u043c\u043e\u043b\u044c\u043d\u0430\u0439 \u0456 \u0436\u043e\u0440\u0441\u0442\u043a\u0430\u0439, \u0440\u0430\u0437\u043b\u0443\u0447\u0430\u0435\u0448 \u0437&rsquo;\u044f\u0434\u043d\u0430\u043d\u044b\u0445! \u0423\u0436\u043e, \u0443\u0436\u043e \u0437\u043b\u0430\u043c\u0430\u043d\u044b\u044f \u0442\u0432\u0430\u0435 \u0441\u0456\u043b\u044b. \u0422\u0432\u0430\u0451 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0430\u0435 \u044f\u0440\u043c\u043e \u045e\u0436\u043e \u0440\u0430\u0441\u0442\u0440\u0443\u0448\u0447\u044b\u045e \u0442\u043e\u0439, \u0445\u0442\u043e \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u045e \u0442\u0430\u0431\u0435 \u043f\u0440\u0430\u0437 \u043a\u0440\u044b\u043a\u0456 \u041e\u0441\u0456\u0456: &laquo;\u041e \u0441\u043c\u0435\u0440\u0446\u044c, \u044f \u0441\u0442\u0430\u043d\u0443 \u0422\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u044e&raquo;. \u0422\u0430\u043c\u0443 \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c \u043c\u044b \u043a\u043f\u0456\u043c: &laquo;C\u043c\u0435\u0440\u0446\u044c, \u0434\u0437\u0435 \u0442\u0432\u0430\u044f \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0430? \u0421\u043c\u0435\u0440\u0446\u044c, \u0434\u0437\u0435 \u0442\u0432\u0430\u0451 \u0434\u0436\u0430\u043b\u0430?&raquo; (1 \u041a\u0430\u0440 15, 55).<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u0445\u0442\u043e \u0446\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u043c\u043e\u0433, \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043d\u0430\u0441. \u0401\u043d \u0430\u0434\u0434\u0430\u045e \u0441\u0432\u0430\u044e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0443\u044e \u0434\u0443\u0448\u0443 \u045e \u0440\u0443\u043a\u0456 \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430\u045e, \u043a\u0430\u0431 \u0437\u0440\u0430\u0431\u0456\u0446\u044c \u0431\u044f\u0437\u0431\u043e\u0436\u043d\u0456\u043a\u0430\u045e \u0441\u0432\u0430\u0456\u043c\u0456 \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b\u043c\u0456. \u0421\u0430\u043f\u0440\u0430\u045e\u0434\u044b, \u0442\u0440\u044d\u0431\u0430 \u0431\u044b\u043b\u043e \u0431 \u0434\u043e\u045e\u0433\u0430 \u0456 \u0448\u043c\u0430\u0442 \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u0446\u0446\u0430 \u043d\u0430 \u0421\u0432\u044f\u0442\u043e\u0435 \u041f\u0456\u0441\u0430\u043d\u043d\u0435, \u043a\u0430\u0431 \u043d\u0430\u0441 \u0443\u0441\u0456\u0445 \u0441\u0443\u0446\u0435\u0448\u044b\u0446\u044c. \u0410\u043b\u0435 \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u043c \u0445\u043e\u043f\u0456\u0446\u044c \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u043c\u044b \u0441\u043a\u0456\u0440\u0443\u0435\u043c \u0441\u0432\u0430\u0435 \u0432\u043e\u0447\u044b \u043d\u0430 \u0441\u043b\u0430\u0432\u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f. \u0423 \u0456\u043c \u043c\u044b \u043d\u0430 \u043f\u0430\u0434\u0441\u0442\u0430\u0432\u0435 \u0432\u0435\u0440\u044b \u045e\u0436\u043e \u043b\u0456\u0447\u044b\u043c \u0441\u044f\u0431\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u044b\u043c\u0456, \u043f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0410\u043f\u043e\u0441\u0442\u0430\u043b \u043a\u0430\u0436\u0430: &laquo;\u041a\u0430\u043b\u0456 \u0436 \u043c\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0442\u043e \u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0456 \u0436\u044b\u0446\u044c \u0431\u0443\u0434\u0437\u0435\u043c \u0437 \u0406\u043c&raquo; (\u0420\u044b\u043c 6, 8).<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b \u0436 \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u043c \u0441\u0430\u0431\u0435, \u0430\u043b\u0435 \u0442\u0430\u043c\u0443, \u0445\u0442\u043e \u043d\u0430\u0441 \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0456 \u0430\u0434 \u0447\u044b\u0451\u0439 \u0432\u043e\u043b\u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u0430 \u0437\u0430\u043b\u0435\u0436\u0430\u0446\u044c \u043d\u0430\u0448\u0430\u044f \u0432\u043e\u043b\u044f. \u0422\u0430\u043c\u0443 \u043c\u044b \u043a\u0430\u0436\u0430\u043c \u0443 \u043c\u0430\u043b\u0456\u0442\u0432\u0435: &laquo;\u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0432\u043e\u043b\u044f \u0422\u0432\u0430\u044f&raquo; (\u041c\u0446 6, 10). \u0422\u0430\u043c\u0443 \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u0430 \u043d\u0430 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0456 \u043a\u0430\u0437\u0430\u0446\u044c \u0440\u0430\u0437\u0430\u043c \u0437 \u0401\u0432\u0430\u043c: &laquo;\u041f\u0430\u043d \u0434\u0430\u045e, \u0456 \u041f\u0430\u043d \u0437\u0430\u0431\u0440\u0430\u045e. \u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0435 \u0456\u043c\u044f \u041f\u0430\u043d\u0430&raquo; (\u0401\u045e 1, 21). \u0411\u0443\u0434\u0437\u0435\u043c \u043a\u0430\u0437\u0430\u0446\u044c \u0442\u0430\u043a \u0437 \u0401\u0432\u0430\u043c \u0443 \u043d\u0430\u0448\u0430\u0439 \u0441\u0456\u0442\u0443\u0430\u0446\u044b\u0456, \u043a\u0430\u0431 \u0443\u0436\u043e \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435 \u0441\u0442\u0430\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419 1 \u0422\u044d\u0441 4, 13-14; \u0415\u0440 22, 10<\/span><br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u0442\u0443\u0436\u044b\u0446\u0435 \u043f\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u044f\u043a \u0442\u044b\u044f, \u0445\u0442\u043e \u043d\u0435 \u043c\u0430\u0435 \u043d\u0430\u0434\u0437\u0435\u0456, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u043a\u0430\u043b\u0456 \u043c\u044b \u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u0442\u043e \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0443 \u0415\u0437\u0443\u0441\u0435 \u0411\u043e\u0433 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0435 \u043f\u043b\u0430\u0447\u0446\u0435 \u043f\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0456 \u043d\u0435 \u0433\u0430\u043b\u0430\u0441\u0456\u0446\u0435 \u043f\u0430 \u0456\u0445.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u043a\u0430\u043b\u0456 \u043c\u044b \u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0415\u0437\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441, \u0442\u043e \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0443 \u0415\u0437\u0443\u0441\u0435 \u0411\u043e\u0433 \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0435 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c.<\/p>\r\n"}]
