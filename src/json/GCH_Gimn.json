\u0442\u0430\u045e\u0448\u044b \u0430\u0434\u043d\u044b\u043c \u0437 \u043d\u0430\u0441, \u043f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u0446\u0435\u043b\u0430.<br \/>\u0420\u043e\u0437\u0443\u043c \u0456 \u0441\u044d\u0440\u0446\u0430 \u043d\u0430\u043c \u0430\u0434\u043d\u0430\u0432\u0456<br \/>\u0411\u043b\u044f\u0441\u043a\u0430\u043c \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p>\u0420\u0430\u0437\u0430\u043c \u0437 \u0430\u043d\u0451\u043b\u0430\u043c\u0456 \u043c\u044b \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u0435\u043c,<br \/>\u0413\u0456\u043c\u043d\u044b \u0445\u0432\u0430\u043b\u044b \u045e\u0437\u043d\u044f\u0441\u0451\u043c \u0434\u0430 \u043d\u044f\u0431\u0451\u0441\u0430\u045e,<br \/>\u0421\u043b\u0430\u0432\u044f\u0447\u044b \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430, \u044f\u043a \u0456 \u0414\u0443\u0445\u0430,<br \/>\u0417 \u0421\u044b\u043d\u0430\u043c \u0443 \u043b\u044e\u0431\u043e\u0432\u0456 \u0440\u043e\u045e\u043d\u044b\u043c. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"GCH_Gimn_ID":"446","GCH_Gimn_Text":"\r\n<p>\u0414\u0430 \u041d\u0435\u043c\u0430\u045e\u043b\u044f\u0446\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u043c\u0443\u0434\u0440\u0430\u0446\u044b,<br \/>\u041f\u0430\u0434\u043d\u0435\u0441\u043b\u0456 \u0434\u0430\u0440\u044b \u042f\u043c\u0443 \u045e \u043d\u0456\u0437\u043a\u0456\u043c \u043f\u0430\u043a\u043b\u043e\u043d\u0435.<br \/>\u041a\u0430\u0434\u0437\u0456\u043b\u0430, \u0456 \u043c\u0456\u0440\u0430, \u0456 \u0437\u043e\u043b\u0430\u0442\u0430 \u2013 \u0443\u0441\u0451<br \/>\u0417 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043f\u0430\u0448\u0430\u043d\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043b\u0456.<\/p>\r\n<p>\u0426\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0437\u043d\u0430\u043a\u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u043f\u0440\u044b\u043c\u0456,<br \/>\u042f\u043a \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0432\u0435\u0440\u044b \u045e \u0422\u0432\u0430\u0451 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430,<br \/>\u041e \u0425\u043b\u043e\u043f\u0447\u0430, \u044f\u043a\u043e\u0433\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0410\u0439\u0446\u0435\u0446<br \/>\u0421\u043f\u0430\u045e\u043d\u0430 \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u0442\u0440\u044b\u0430\u0434\u0437\u0456\u043d\u0430\u0439 \u0443\u043b\u0430\u0434\u0430\u0439.<\/p>\r\n<p>\u0422\u043e\u0439 \u0432\u043e\u0434\u0430\u0440 \u0434\u0443\u0445\u043c\u044f\u043d\u044b, \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u044b \u0441\u043a\u0430\u0440\u0431<br \/>\u041d\u0430\u043c \u0411\u043e\u0433\u0430, \u045e\u043b\u0430\u0434\u0430\u0440\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c,<br \/>\u0410 \u043c\u0456\u0440\u0430 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u043c\u0443\u043a\u0443 \u0456 \u0441\u043c\u0435\u0440\u0446\u044c,<br \/>\u042f\u043a\u0456\u044f \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0417\u0431\u0430\u0432\u0456\u0446\u0435\u043b\u044c \u0441\u0443\u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p>\u041e \u0441\u043b\u0430\u045e\u043d\u044b \u043d\u0430 \u0446\u044d\u043b\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u0411\u044d\u0442\u043b\u0435\u0435\u043c!<br \/>\u0417 \u0443\u0441\u0456\u0445 \u0433\u0430\u0440\u0430\u0434\u043e\u045e \u0442\u044b \u0430\u0434\u0437\u0456\u043d \u043d\u0430\u0439\u0432\u044f\u043b\u0456\u043a\u0448\u044b.<br \/>\u0422\u044b \u0441\u0432\u0435\u0434\u043a\u0430 \u0437\u2019\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u041f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430,<br \/>\u042f\u043a\u0456 \u045e\u0446\u0435\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u0434\u0437\u0435\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430.<\/p>\r\n<p>\u041d\u0430\u0448 \u0414\u0430\u045e\u0446\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0422\u0432\u043e\u0440\u0446\u0430 \u045e\u0441\u044f\u0433\u043e<br \/>\u0416\u0430\u0434\u0430\u0435, \u043a\u0430\u0431 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u042f\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<br \/>\u0401\u043d \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u0430\u045e\u0436\u0434\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0441\u0443\u0434,<br \/>\u041f\u0440\u0430 \u0448\u0442\u043e \u045e \u041f\u0456\u0441\u0430\u043d\u043d\u044f\u0445 \u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456.<\/p>\r\n<p>\u042f\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u0435 \u045e\u0441\u0446\u044f\u0436.<br \/>\u0406 \u0431\u043b\u044f\u043a\u043d\u0435 \u043f\u0440\u0430\u0434 \u0406\u043c \u0443\u0441\u044f \u0432\u0435\u043b\u0456\u0447 \u0437\u044f\u043c\u043d\u0430\u044f.<br \/>\u0406 \u0437\u0434\u0430\u0441\u0446\u0430 \u043c\u0456\u0437\u044d\u0440\u043d\u044b\u043c \u043f\u0440\u0430\u0434 \u0406\u043c \u0430\u043a\u0456\u044f\u043d,<br \/>\u0406 \u043a\u0440\u043e\u043f\u0435\u043b\u044c\u043a\u0430\u0439 \u0437\u0434\u0430\u0441\u0446\u0430 \u043b\u044e\u0431\u0430\u044f \u0434\u0437\u044f\u0440\u0436\u0430\u0432\u0430.<\/p>\r\n<p>\u041e \u0415\u0437\u0443, \u0448\u0442\u043e \u0437 \u043d\u0435\u0431\u0430 \u0430\u0434\u043d\u043e\u0439\u0447\u044b \u0441\u044b\u0448\u043e\u045e,<br \/>\u042f\u043a \u0417\u0431\u0430\u045e\u0446\u0430 \u0437\u044f\u043c\u043d\u044b \u0430\u0431\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u043c,<br \/>\u0425\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0445\u0432\u0430\u043b\u0430 \u0456 \u0422\u0430\u0431\u0435, \u0456 \u0410\u0439\u0446\u0443,<br \/>\u0406 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443 \u0437\u0430\u045e\u0436\u0434\u044b \u0456 \u043d\u0430\u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"GCH_Gimn_ID":"451","GCH_Gimn_Text":"\r\n<p>\u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0448\u044b \u0441\u044d\u0440\u0446\u044b \u045e\u0437\u0440\u0443\u0448\u0430\u0446\u0446\u0430 \u0441\u0451\u043d\u043d\u044f<br \/>\u0406 \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u044e\u0446\u044c \u0445\u0432\u0430\u043b\u0435\u0431\u043d\u0443\u044e \u043f\u0435\u0441\u043d\u044e,<br \/>\u041a\u0430\u043b\u0456 \u043f\u0440\u044b\u0433\u0430\u0434\u0430\u0435\u043c \u043c\u044b \u0434\u043e\u043c \u0437 \u041d\u0430\u0437\u0430\u0440\u044d\u0442\u0430,<br \/>\u0414\u0437\u0435 \u045e\u0431\u043e\u0433\u0430 \u0436\u044b\u045e \u0415\u0437\u0443\u0441 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456.<\/p>\r\n<p>\u041f\u0430\u043a\u043e\u0440\u043d\u0430 \u0432\u0443\u0447\u044b\u045e\u0441\u044f \u0456 \u0431\u044b\u045e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b<br \/>\u042e\u0437\u0430\u0444\u0443, \u0441\u044b\u043d\u0430\u043c \u044f\u043a\u043e\u0433\u0430 \u0401\u043d \u0437\u0432\u0430\u045e\u0441\u044f.<br \/>\u0420\u0443\u043f\u043b\u0456\u0432\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u045e \u0446\u044f\u0441\u043b\u044f\u0440\u0441\u043a\u0443\u044e \u043f\u0440\u0430\u0446\u0443,<br \/>\u042f\u043a\u043e\u0439 \u043d\u0430\u0432\u0443\u0447\u044b\u045e\u0441\u044f \u0430\u0434 \u0431\u0430\u0446\u044c\u043a\u0456 \u0437\u044f\u043c\u043d\u043e\u0433\u0430.<\/p>\r\n<p>\u041f\u0430\u0431\u043e\u0436\u043d\u0430\u044f \u041c\u0430\u0446\u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0440\u044b \u0421\u044b\u043d\u0435<br \/>\u0406 \u0437 \u0434\u0430\u0431\u0440\u044b\u043d\u0451\u0439 \u043f\u0440\u044b\u0441\u043b\u0443\u0433\u043e\u045e\u0432\u0430\u0435 \u043c\u0443\u0436\u0443,<br \/>\u041a\u0430\u0431 \u043a\u043b\u043e\u043f\u0430\u0442 \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u044b \u0456 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u0456 \u043f\u0440\u0430\u0446\u044b<br \/>\u0410\u0431\u043b\u0435\u0433\u0447\u044b\u0446\u044c \u043b\u044e\u0431\u043e\u045e\u044e \u0441\u0432\u0430\u0451\u044e \u0456 \u043b\u0430\u0441\u043a\u0430\u0439.<\/p>\r\n<p>\u0421\u0432\u044f\u0442\u044b\u044f \u0431\u0430\u0446\u044c\u043a\u0456 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044f \u0441\u0432\u0435\u0442\u0443,<br \/>\u0412\u044b, \u0448\u0442\u043e \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u043d\u044f\u0441\u0442\u0430\u0447\u0443 \u0456 \u045e\u0431\u043e\u0441\u0442\u0432\u0430,<br \/>\u041f\u0430\u0447\u0443\u0439\u0446\u0435 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u0430\u0433\u0430 \u043b\u044e\u0434\u0443,<br \/>\u042f\u043a\u0456 \u045e \u043f\u0430\u043a\u043e\u0440\u044b \u0441\u0442\u0430\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0432\u0430\u043c\u0456.<\/p>\r\n<p>\u0422\u0430\u0431\u0435, \u0411\u043e\u0436\u0430, \u0434\u0437\u044f\u043a\u0443\u0435\u043c \u0441\u0451\u043d\u043d\u044f \u043c\u044b \u0448\u0447\u044b\u0440\u0430,<br \/>\u0428\u0442\u043e \u0434\u0430\u045e \u043d\u0430\u043c \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0441\u044f\u043c\u0435\u0439\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f.<br \/>\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u044b \u0431\u0443\u0434\u0437\u044c \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443 \u043b\u044e\u0431\u043e\u0432\u0456<br \/>\u0423 \u0422\u0440\u043e\u0439\u0446\u044b \u0421\u0432\u044f\u0442\u043e\u0439 \u0456 \u0430\u0434\u0437\u0456\u043d\u0430\u0439 \u043d\u0430\u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"GCH_Gimn_ID":"458","GCH_Gimn_Text":"\r\n<p>\u041f\u0430\u0440\u0430\u0441\u0442\u0430\u043a \u0432\u044b\u0440\u0430\u0441 \u0415\u0441\u044d\u044f,<br \/>\u041f\u043b\u043e\u0434 \u043d\u0430\u043c \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u0433\u0430\u043b\u0456\u043d\u043a\u0430,<br \/>\u0411\u043e \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u044f \u0414\u0437\u0435\u0432\u0430<br \/>\u041d\u0430\u043c \u041d\u0435\u043c\u0430\u045e\u043b\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430.<\/p>\r\n<p>\u0422\u043e\u0439, \u0445\u0442\u043e \u0437 \u0410\u0439\u0446\u043e\u043c \u0431\u044b\u045e \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443<br \/>\u0422\u0432\u043e\u0440\u0446\u0430\u043c \u0441\u0432\u044f\u0442\u043b\u0430 \u0456 \u043d\u044f\u0431\u0451\u0441\u0430\u045e,<br \/>\u0426\u0435\u0440\u043f\u0456\u0446\u044c \u043d\u044f\u0441\u0442\u0430\u0447\u0443 \u0456 \u0445\u043e\u043b\u0430\u0434,<br \/>\u041d\u0430 \u0441\u0432\u0435\u0442 \u043f\u0440\u044b\u0439\u0448\u043e\u045e\u0448\u044b \u045e \u0441\u0442\u0430\u0439\u043d\u0456.<\/p>\r\n<p>\u0413\u044d\u0442\u0430\u043c\u0443 \u0441\u0432\u0435\u0442\u0443 \u0437\u0430\u043a\u043e\u043d \u0434\u0430\u045e:<br \/>\u0417\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u043f\u0440\u0430\u0437 \u041c\u0430\u0439\u0441\u0435\u044f.<br \/>\u041f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0446\u0435\u043b\u0430 \u043b\u044e\u0434\u0441\u043a\u043e\u0435,<br \/>\u0421\u0430\u043c \u0441\u0442\u0430\u045e \u043f\u0430\u0434\u043b\u0435\u0433\u043b\u044b \u0437\u0430\u043a\u043e\u043d\u0443.<\/p>\r\n<p>\u0417\u0437\u044f\u0435 \u0437\u0430\u0440\u0430 \u045e\u0436\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f,<br \/>\u041d\u043e\u0447 \u0433\u0456\u043d\u0435, \u0441\u043c\u0435\u0440\u0446\u044c \u0430\u0434\u0441\u0442\u0443\u043f\u0456\u043b\u0430.<br \/>\u0411\u0443\u0434\u0437\u0435\u043c \u0443\u0434\u0437\u044f\u0447\u043d\u044b \u041c\u0430\u0440\u044b\u0456:<br \/>\u0411\u043e\u0433\u0430 \u042f\u043d\u0430 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0430.<\/p>\r\n<p>\u041e \u0415\u0437\u0443, \u0421\u044b\u043d\u0435 \u041c\u0430\u0440\u044b\u0456,<br \/>\u0425\u0430\u0439 \u0436\u0430 \u0445\u0432\u0430\u043b\u0430 \u0422\u0430\u0431\u0435 \u0431\u0443\u0434\u0437\u0435<br \/>\u0420\u0430\u0437\u0430\u043c \u0437 \u0410\u0439\u0446\u043e\u043c, \u0421\u0432\u044f\u0442\u044b\u043c \u0414\u0443\u0445\u0430\u043c<br \/>\u041d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"GCH_Gimn_ID":"466","GCH_Gimn_Text":"\r\n<p>\u0414\u0430 \u041d\u0435\u043c\u0430\u045e\u043b\u044f\u0446\u0456 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u043c\u0443\u0434\u0440\u0430\u0446\u044b,<br \/>\u041f\u0430\u0434\u043d\u0435\u0441\u043b\u0456 \u0434\u0430\u0440\u044b \u042f\u043c\u0443 \u045e \u043d\u0456\u0437\u043a\u0456\u043c \u043f\u0430\u043a\u043b\u043e\u043d\u0435.<br \/>\u041a\u0430\u0434\u0437\u0456\u043b\u0430, \u0456 \u043c\u0456\u0440\u0430, \u0456 \u0437\u043e\u043b\u0430\u0442\u0430 \u2013 \u0443\u0441\u0451<br \/>\u0417 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u043f\u0430\u0448\u0430\u043d\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043b\u0456.<\/p>\r\n<p>\u0426\u0443\u0434\u043e\u045e\u043d\u044b\u044f \u0437\u043d\u0430\u043a\u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u043f\u0440\u044b\u043c\u0456,<br \/>\u042f\u043a \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u0432\u0435\u0440\u044b \u045e \u0422\u0432\u0430\u0451 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430,<br \/>\u041e \u0425\u043b\u043e\u043f\u0447\u0430, \u044f\u043a\u043e\u0433\u0430 \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u0410\u0439\u0446\u0435\u0446<br \/>\u0421\u043f\u0430\u045e\u043d\u0430 \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u0442\u0440\u044b\u0430\u0434\u0437\u0456\u043d\u0430\u0439 \u0443\u043b\u0430\u0434\u0430\u0439.<\/p>\r\n<p>\u0422\u043e\u0439 \u0432\u043e\u0434\u0430\u0440 \u0434\u0443\u0445\u043c\u044f\u043d\u044b, \u043f\u0440\u044b\u043d\u0435\u0441\u0435\u043d\u044b \u0441\u043a\u0430\u0440\u0431<br \/>\u041d\u0430\u043c \u0411\u043e\u0433\u0430, \u045e\u043b\u0430\u0434\u0430\u0440\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u044e\u0446\u044c,<br \/>\u0410 \u043c\u0456\u0440\u0430 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u0435 \u043c\u0443\u043a\u0443 \u0456 \u0441\u043c\u0435\u0440\u0446\u044c,<br \/>\u042f\u043a\u0456\u044f \u0441\u043f\u0430\u0437\u043d\u0430\u0435 \u0417\u0431\u0430\u0432\u0456\u0446\u0435\u043b\u044c \u0441\u0443\u0441\u0432\u0435\u0442\u0443.<\/p>\r\n<p>\u041e \u0441\u043b\u0430\u045e\u043d\u044b \u043d\u0430 \u0446\u044d\u043b\u0430\u0439 \u0437\u044f\u043c\u043b\u0456 \u0411\u044d\u0442\u043b\u0435\u0435\u043c!<br \/>\u0417 \u0443\u0441\u0456\u0445 \u0433\u0430\u0440\u0430\u0434\u043e\u045e \u0442\u044b \u0430\u0434\u0437\u0456\u043d \u043d\u0430\u0439\u0432\u044f\u043b\u0456\u043a\u0448\u044b.<br \/>\u0422\u044b \u0441\u0432\u0435\u0434\u043a\u0430 \u0437\u2019\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u041f\u0440\u0430\u0432\u0430\u0434\u044b\u0440\u0430,<br \/>\u042f\u043a\u0456 \u045e\u0446\u0435\u043b\u0430\u0432\u0456\u045e\u0441\u044f \u0434\u0437\u0435\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430.<\/p>\r\n<p>\u041d\u0430\u0448 \u0414\u0430\u045e\u0446\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0422\u0432\u043e\u0440\u0446\u0430 \u045e\u0441\u044f\u0433\u043e<br \/>\u0416\u0430\u0434\u0430\u0435, \u043a\u0430\u0431 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u043b\u0430\u0441\u044f \u042f\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<br \/>\u0401\u043d \u0447\u044b\u043d\u0456\u0446\u044c \u0437\u0430\u045e\u0436\u0434\u044b \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0441\u0443\u0434,<br \/>\u041f\u0440\u0430 \u0448\u0442\u043e \u045e \u041f\u0456\u0441\u0430\u043d\u043d\u044f\u0445 \u043a\u0430\u0437\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456.<\/p>\r\n<p>\u042f\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0431\u044f\u0437\u043c\u0435\u0436\u043d\u0430\u0435 \u045e\u0441\u0446\u044f\u0436.<br \/>\u0406 \u0431\u043b\u044f\u043a\u043d\u0435 \u043f\u0440\u0430\u0434 \u0406\u043c \u0443\u0441\u044f \u0432\u0435\u043b\u0456\u0447 \u0437\u044f\u043c\u043d\u0430\u044f.<br \/>\u0406 \u0437\u0434\u0430\u0441\u0446\u0430 \u043c\u0456\u0437\u044d\u0440\u043d\u044b\u043c \u043f\u0440\u0430\u0434 \u0406\u043c \u0430\u043a\u0456\u044f\u043d,<br \/>\u0406 \u043a\u0440\u043e\u043f\u0435\u043b\u044c\u043a\u0430\u0439 \u0437\u0434\u0430\u0441\u0446\u0430 \u043b\u044e\u0431\u0430\u044f \u0434\u0437\u044f\u0440\u0436\u0430\u0432\u0430.<\/p>\r\n<p>\u041e \u0415\u0437\u0443, \u0448\u0442\u043e \u0437 \u043d\u0435\u0431\u0430 \u0430\u0434\u043d\u043e\u0439\u0447\u044b \u0441\u044b\u0448\u043e\u045e,<br \/>\u042f\u043a \u0417\u0431\u0430\u045e\u0446\u0430 \u0437\u044f\u043c\u043d\u044b \u0430\u0431\u2019\u044f\u0432\u0456\u045e\u0441\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u043c,<br \/>\u0425\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0445\u0432\u0430\u043b\u0430 \u0456 \u0422\u0430\u0431\u0435, \u0456 \u0410\u0439\u0446\u0443,<br \/>\u0406 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443 \u0437\u0430\u045e\u0436\u0434\u044b \u0456 \u043d\u0430\u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"GCH_Gimn_ID":"473","GCH_Gimn_Text":"\r\n<p>\u042f\u043a \u042f\u043d \u0437\u0434\u0437\u044f\u0439\u0441\u043d\u044f\u045e \u0441\u0432\u043e\u0439 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a,<br \/>\u040e \u042f\u0440\u0434\u0430\u043d \u0437\u0430\u0439\u0448\u043e\u045e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0441\u0432\u0435\u0442\u0443<br \/>\u0406, \u0434\u0430\u043a\u0440\u0430\u043d\u0443\u045e\u0448\u044b\u0441\u044f \u0434\u0430 \u043f\u043b\u044b\u043d\u0456,<br \/>\u0410\u0434\u0440\u0430\u0437\u0443 \u0432\u043e\u0434\u044b \u045e\u0441\u0435 \u0430\u0447\u044b\u0441\u0446\u0456\u045e.<\/p>\r\n<p>\u041d\u0430\u0440\u043e\u0434\u0436\u0430\u043d\u044b \u