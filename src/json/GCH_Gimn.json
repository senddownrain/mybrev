u0430\u045e \u0431\u0430\u0440\u043e\u043d\u0456\u0448,<br \/>\u0422\u044b\u0445, \u043a\u0430\u0433\u043e \u0441\u0430\u043c \u0433\u043d\u0430\u045e \u0437\u0430 \u0432\u0435\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430 \u043d\u0430\u0441 \u043d\u0435 \u0437\u0430\u0431\u0443\u0434\u0437\u044c, \u0446\u044f\u0431\u0435 \u043f\u0440\u043e\u0441\u0456\u043c,<br \/>\u0423 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0439,<br \/>\u041a\u0430\u0431 \u043c\u044b, \u0441\u043b\u0430\u0431\u044b\u044f, \u0437\u043d\u043e\u045e \u043c\u0435\u043b\u0456<br \/>\u041d\u0430\u0434\u0437\u0435\u044e \u043b\u0430\u0441\u043a\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430 \u043d\u0430\u0441 \u0437\u0430\u0441\u0442\u0443\u043f\u0456\u0441\u044f, \u0410\u043f\u043e\u0441\u0442\u0430\u043b,<br \/>\u041c\u0456\u0436 \u043d\u0430\u0441 \u0445\u0430\u0439 \u043b\u044e\u0431\u043e\u045e \u0437\u0430\u043a\u0432\u0456\u0442\u043d\u0435\u0435,<br \/>\u041d\u044f\u0445\u0430\u0439 \u0430\u0434\u0441\u0442\u0443\u043f\u044f\u0446\u0446\u0430 \u0441\u043f\u0440\u044d\u0447\u043a\u0456,<br \/>\u0414\u0430\u0432\u0435\u0440\u0430\u043c \u0445\u0430\u0439 \u043f\u043e\u045e\u043d\u044f\u0446\u0446\u0430 \u0441\u044d\u0440\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0435\u043c\u043d\u0430\u044f \u043d\u0435\u0431\u0443 \u0430\u0445\u0432\u044f\u0440\u0430,<br \/>\u0421\u0432\u044f\u0442\u043b\u043e \u0434\u043b\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e \u0441\u0432\u0435\u0442\u0443,<br \/>\u0423\u0441\u0456\u0445 \u0430\u0431\u0430\u0440\u043e\u043d\u0446\u0430, \u041f\u0430\u045e\u043b\u0435,<br \/>\u041c\u044b \u043f\u0440\u043e\u0441\u0456\u043c, \u0437\u0430 \u043d\u0430\u0441 \u0437\u0430\u0441\u0442\u0443\u043f\u0456\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0437\u0456\u043d\u0430\u0433\u0430 \u045e \u0422\u0440\u043e\u0439\u0446\u044b \u0411\u043e\u0433\u0430<br \/>\u041f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043c \u043c\u044b \u0445\u0432\u0430\u043b\u0430\u0441\u043f\u0435\u0432\u0430\u043c.<br \/>\u041a\u0430\u0431 \u043d\u0430\u0441 \u0437 \u0442\u0430\u0431\u043e\u044e \u045e \u043d\u0435\u0431\u0435<br \/>\u040e\u0432\u044f\u043d\u0447\u0430\u045e \u043a\u0430\u0440\u043e\u043d\u0430\u0439 \u043d\u0430\u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"GCH_Gimn_ID":"634","GCH_Gimn_Text":"\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u044b\u043c \u0430\u0431\u0440\u0430\u0434\u0430\u043c \u0456 \u0417\u0430\u043a\u043e\u043d\u0443 \u043f\u0440\u043e\u0434\u043a\u0430\u045e,<br \/>\u041f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u043c \u041c\u0430\u0439\u0441\u0435\u0435\u043c \u0434\u043b\u044f \u043d\u0430\u0440\u043e\u0434\u0443,<br \/>\u0411\u044b\u045e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b \u0442\u043e\u0439, \u0445\u0442\u043e \u045e \u0410\u0439\u0446\u043e\u045e\u0441\u043a\u0456\u043c \u0434\u043e\u043c\u0435<br \/>\u0421\u0430\u043c \u043a\u0456\u0440\u0430\u0432\u0430\u045e \u0430\u043d\u0451\u043b\u044c\u0441\u043a\u0456\u043c \u0432\u043e\u0439\u0441\u043a\u0430\u043c<br \/>\u0406 \u0431\u044b\u045e \u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u0435\u043c \u0437\u044f\u043c\u043b\u0456, \u043d\u044f\u0431\u0451\u0441\u0430\u045e, \u043c\u043e\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0447\u0430\u0441\u043b\u0456\u0432\u0430\u044f \u043d\u044f\u0441\u0435 \u045e \u0430\u0431\u0434\u044b\u043c\u043a\u0430\u0445 \u041c\u0430\u0446\u0456<br \/>\u0421\u0430\u043c\u043e\u0433\u0430 \u0411\u043e\u0433\u0430, \u0443\u0442\u043e\u0435\u043d\u0430\u0433\u0430 \u045e \u0446\u0435\u043b\u0435.<br \/>\u041f\u044f\u0448\u0447\u043e\u0442\u043d\u0430 \u0442\u0443\u043b\u0456\u0446\u044c \u0434\u0430 \u0441\u044f\u0431\u0435 \u0414\u0437\u0456\u0446\u044f\u0442\u043a\u0430,<br \/>\u0423 \u043f\u0430\u0446\u0430\u043b\u0443\u043d\u043a\u0430\u0445 \u043f\u0435\u0441\u0446\u0456\u0446\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430,<br \/>\u042f\u043a\u0456 \u045e \u043f\u043e\u045e\u043d\u0456 \u0411\u043e\u0433\u0430\u043c \u0451\u0441\u0446\u044c \u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u043b\u043e \u0401\u043d \u0434\u043b\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u0446\u043a\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e,<br \/>\u0425\u0432\u0430\u043b\u0430 \u0432\u044b\u0431\u0440\u0430\u043d\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 &ndash; \u0406\u0437\u0440\u0430\u044d\u043b\u044f. <br \/>\u041f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0401\u043d \u043d\u0430 \u043f\u0430\u0434\u0437\u0435\u043d\u043d\u0435 \u043c\u043d\u043e\u0433\u0456\u0445,<br \/>\u0423\u0441\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0401\u043d \u043d\u044f\u0441\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435,<br \/>\u041f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0432\u044b\u044f\u0432\u044f\u0446\u0446\u0430 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b \u0441\u044d\u0440\u0446\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0432\u0430\u043b\u0430 \u0410\u0439\u0446\u0443 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u043c\u0443 \u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435,<br \/>\u041f\u0430\u0448\u0430\u043d\u0430 \u0456 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435 &ndash; \u042f\u0433\u043e \u0421\u044b\u043d\u0443,<br \/>\u0426\u044f\u043f\u0435\u0440 \u0456 \u0432\u0435\u0447\u043d\u0430 \u0414\u0443\u0445\u0443 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<br \/>\u041f\u0430\u0434\u0437\u044f\u043a\u0430 \u045e \u0421\u0432\u044f\u0442\u043e\u0439 \u0422\u0440\u043e\u0439\u0446\u044b \u0411\u043e\u0433\u0443,<br \/>\u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443 \u0456 \u041f\u0430\u043d\u0443 \u043d\u0430\u0437\u0430\u045e\u0441\u0451\u0434\u044b. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"GCH_Gimn_ID":"645","GCH_Gimn_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0451\u0442\u0440, \u0434\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440, \u043f\u0430\u0447\u0443\u0439 \u043d\u0430\u0448\u044b \u043f\u0440\u043e\u0441\u044c\u0431\u044b<br \/>\u0406 \u0440\u0430\u0437\u0430\u0440\u0432\u0456 \u043a\u0430\u0439\u0434\u0430\u043d\u044b \u0437\u043b\u0430 \u0456 \u0433\u0440\u044d\u0445\u0443,<br \/>\u0411\u043e \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0442\u044b \u0430\u0434 \u041f\u0430\u043d\u0430 \u045e\u043b\u0430\u0434\u0443<br \/>\u041d\u0435\u0431\u0430 \u0437\u0430\u043c\u043a\u043d\u0443\u0446\u044c \u0446\u0456 \u0430\u0434\u043a\u0440\u044b\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u043a\u043e\u0436\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0440\u043e\u0439\u0446\u044b \u0421\u0432\u044f\u0442\u043e\u0439 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0432\u0435\u043a\u0456<br \/>\u0421\u043b\u0430\u0432\u0430, \u043f\u0430\u0448\u0430\u043d\u0430 \u0456 \u045e\u0434\u0437\u044f\u0447\u043d\u044b\u044f \u0441\u043f\u0435\u0432\u044b,<br \/>\u0410 \u043c\u043e\u0446 \u042f\u0435, \u0448\u0442\u043e \u0442\u0440\u044b\u0432\u0430\u0435 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443,<br \/>\u041b\u0430\u0441\u043a\u0430\u0439 \u043d\u0430\u0441 \u0441\u0451\u043d\u043d\u044f \u043d\u044f\u0445\u0430\u0439 \u0443\u043c\u0430\u0446\u0443\u0435. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"GCH_Gimn_ID":"654","GCH_Gimn_Text":"\r\n<p style=\"text-align: justify;\">\u041c\u0430\u0446\u0435\u0439, \u0442\u044b \u0431\u044b\u045e \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b<br \/>\u0426\u0443\u0434\u043e\u045e\u043d\u0430\u0439 \u0411\u043e\u0436\u0430\u0439 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044e<br \/>\u0414\u0430 \u0448\u044d\u0440\u0430\u0433\u0443 \u0441\u043b\u0430\u0432\u0443\u0442\u0430\u0433\u0430<br \/>\u0421\u043b\u0430\u045e\u043d\u044b\u0445 \u043c\u0443\u0436\u043e\u045e &ndash; \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0432\u0443\u0447\u0430\u043d\u044c, \u0437\u0434\u0440\u0430\u0434\u043d\u0456\u043a \u0415\u0437\u0443\u0441\u0430,<br \/>\u041f\u0430\u043a\u0456\u043d\u0443\u045e \u043c\u0435\u0441\u0446\u0430 \u0432\u043e\u043b\u044c\u043d\u0430\u0435,<br \/>\u041b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0434\u043a\u0456\u043d\u0443\u045e\u0448\u044b,<br \/>\u0410\u0434\u0440\u043e\u043a\u0441\u044f \u0433\u044d\u0442\u0430\u0439 \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0432\u043e\u0441\u044c \u043b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u044f<br \/>\u0426\u044f\u0431\u0435, \u041c\u0430\u0446\u0435\u0439, \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043b\u0430,<br \/>\u0410 \u043b\u0430\u0441\u043a\u0430 \u0414\u0443\u0445\u0430 \u0411\u043e\u0436\u0430\u0433\u0430<br \/>\u0426\u044f\u0431\u0435 \u043f\u0440\u0430\u0437 \u043b\u0451\u0441\u044b \u0432\u044b\u0431\u0440\u0430\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0441\u043b\u0443\u0436\u0431\u0443 \u0433\u044d\u0442\u0443\u044e,<br \/>\u0422\u044b \u043d\u0451\u0441 \u0441\u0432\u044f\u0442\u043b\u043e \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u045e\u0441\u0456\u043c;<br \/>\u041d\u044f\u0437\u043b\u043e\u043c\u043d\u044b \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0431\u044b\u045e, <br \/>\u041a\u0440\u044b\u0432\u0451\u044e \u0432\u044b\u0437\u043d\u0430\u045e \u0415\u0437\u0443\u0441\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u040e\u0447\u044b\u043d\u0456, \u0441\u0432\u044f\u0442\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0435,<br \/>\u041a\u0430\u0431 \u0437 \u0441\u044d\u0440\u0446\u0430\u043c\u0456 \u0433\u0430\u0442\u043e\u0432\u044b\u043c\u0456<br \/>\u0406\u0448\u043b\u0456 \u043c\u044b \u0441\u0446\u0435\u0436\u043a\u0430\u0439 \u043f\u0440\u0430\u0432\u0435\u0434\u043d\u0430\u0439,<br \/>\u042f\u043a\u0443\u044e \u0414\u0443\u0445 \u043f\u0430\u043a\u0430\u0436\u0430 \u043d\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0430\u0439 \u043f\u0440\u0430\u0437 \u0442\u0432\u0430\u0451 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430<br \/>\u0411\u043e\u0433 \u0434\u0430\u0441\u0446\u044c \u043d\u0430\u043c \u0441\u043b\u0430\u0432\u0443 \u0432\u0435\u0447\u043d\u0443\u044e,<br \/>\u041a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0441\u043f\u044f\u0432\u0430\u0446\u044c \u042f\u043c\u0443<br \/>\u0411\u044f\u0441\u043a\u043e\u043d\u0446\u0430 \u0433\u0456\u043c\u043d\u044b \u045e\u0437\u043d\u0451\u0441\u043b\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"GCH_Gimn_ID":"655","GCH_Gimn_Text":"\r\n<p style=\"text-align: justify;\">\u041e \u0410\u043d\u0434\u0440\u044d\u044e, \u0441\u043b\u0430\u045e\u043d\u044b \u0431\u0440\u0430\u0446\u0435,<br \/>\u041c\u043e\u0446 \u0442\u0432\u0430\u044f \u0437\u043c\u0430\u0433\u043b\u0430 \u045e\u0441\u0456\u0445 \u043a\u0430\u0442\u0430\u045e.<br \/>\u041c\u0443\u0447\u0430\u043d\u0456\u0446\u0442\u0432\u0430\u043c \u0441\u0442\u0430\u045e\u0441\u044f \u0441\u043b\u0430\u045e\u043d\u044b\u043c,<br \/>\u0428\u0442\u043e \u043f\u0440\u044b\u043d\u044f\u045e \u0442\u044b \u0437 \u0440\u0443\u043a \u043a\u0430\u0437\u0430\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433 \u0446\u044f\u0431\u0435 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0437 \u043d\u0435\u0431\u0430,<br \/>\u041a\u0430\u0431 \u0442\u044b \u0441\u0442\u0430\u045e \u0436\u0430\u045e\u043d\u0435\u0440\u0430\u043c \u0411\u043e\u0436\u044b\u043c.<br \/>\u0406 \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0434\u0443\u0448\u0430\u045e<br \/>\u041a\u0440\u043e\u045e \u0441\u0432\u0430\u044e \u0442\u044b \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u0435\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u043e\u0431\u0440\u044b \u043f\u0430\u0441\u0442\u044b\u0440 \u0441\u0432\u0430\u0451\u0439 \u043f\u0430\u0441\u0442\u0432\u044b,<br \/>\u041c\u0443\u0436\u043d\u044b \u0430\u0431\u0430\u0440\u043e\u043d\u0446\u0430 \u043f\u0440\u0430\u045e\u0434\u044b.<br \/>\u0422\u044b\u043c, \u0448\u0442\u043e \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0456 \u043d\u0430\u0434\u0437\u0435\u044e,<br \/>\u0421\u043b\u043e\u0432\u044b \u0411\u043e\u0436\u044b\u044f \u0437\u0430\u043d\u043e\u0441\u0456\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u0428\u0447\u044b\u0440\u044b \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430,<br \/>\u0417 \u0420\u044b\u043c\u0430\u043c \u0446\u0435\u0441\u043d\u0430 \u0431\u044b\u045e \u0437\u0432\u044f\u0437\u0430\u043d\u044b.<br \/>\u041f\u043e\u0432\u044f\u0437\u0437\u044e \u043b\u044e\u0431\u043e\u0432\u0456 \u0432\u0435\u0440\u043d\u044b\u0445<br \/>\u0422\u044b \u043f\u0430\u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u0439 \u0437\u043b\u0443\u0447\u0430\u0435\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0430\u0439 \u0425\u0440\u044b\u0441\u0442\u0443 \u0437\u0430\u0433\u0443\u0447\u044b\u0446\u044c \u0441\u043b\u0430\u0432\u0430,<br \/>\u0406 \u0410\u0439\u0446\u0443, \u0456 \u0414\u0443\u0445\u0443 \u0440\u0430\u0437\u0430\u043c,<br \/>\u0428\u0442\u043e \u045e \u0447\u0430\u0441\u0456\u043d\u0443 \u043c\u0443\u043a\u0456 \u0441\u0442\u0440\u0430\u0448\u043d\u0430\u0439<br \/>\u041c\u043e\u0446 \u0432\u044b\u0437\u043d\u0430\u045e\u0446\u0430\u043c \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u044e\u0446\u044c. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"GCH_Gimn_ID":"663","GCH_Gimn_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456, \u043d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u044f \u041f\u0430\u043d\u043d\u0430,<br \/>\u041d\u0430\u0432\u0435\u0434\u0430\u0439 \u043d\u0430\u0441, \u0411\u043e\u0436\u0430\u044f \u041c\u0430\u0446\u0456,<br \/>\u042f\u043a\u0430\u044f \u0441\u0432\u0430\u044f\u0447\u0446\u044b \u0410\u043b\u044c\u0436\u0431\u0435\u0446\u0435<br \/>\u041f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u043d\u044f\u0437\u043c\u0435\u0440\u043d\u0443\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456, \u0410\u043f\u044f\u043a\u0443\u043d\u043a\u0430 \u0441\u0443\u0441\u0432\u0435\u0442\u0443,<br \/>\u0410\u0431\u043c\u044b\u0439 \u043d\u0430\u0441 \u0430\u0434 \u0433\u0440\u044d\u0448\u043d\u0430\u0433\u0430 \u0431\u0440\u0443\u0434\u0443,<br \/>\u041d\u0430\u0432\u0435\u0434\u0430\u0439 \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u043b\u0456 \u043a\u0430\u0440\u0430<br \/>\u0417\u0430 \u0433\u0440\u044d\u0445 \u044f\u043c\u0443 \u043f\u0430\u0433\u0440\u0430\u0436\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456, \u0430\u0441\u0432\u044f\u0442\u043b\u0456, \u0417\u043e\u0440\u043a\u0430 \u043c\u043e\u0440\u0430,<br \/>\u041f\u0440\u0430\u043b\u0456 \u0441\u0443\u043f\u0430\u043a\u043e\u044e \u043f\u0440\u0430\u043c\u0435\u043d\u043d\u0456,<br \/>\u0412\u044f\u0440\u043d\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0431\u0456\u045e\u0441\u044f \u0437 \u0434\u0430\u0440\u043e\u0433\u0456,<br \/>\u0416\u044b\u0446\u0446\u0451\u043c \u0430\u0434\u0430\u0440\u044b \u045e\u0441\u0456\u0445 \u043d\u044f\u0432\u0456\u043d\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456, \u043c\u044b \u0426\u044f\u0431\u0435 \u043c\u043e\u0446\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c,<br \/>\u041d\u0430\u0432\u0435\u0434\u0430\u0439 \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439 \u0433\u0430\u0440\u043e\u0442\u043d\u044b,<br \/>\u0406 \u043d\u0430\u0441 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u0439 \u0411\u043e\u0436\u0430\u0439 \u043c\u043e\u0446\u0430\u0439,<br \/>\u041a\u0430\u0431 \u043c\u044b \u043d\u0435 \u0445\u0456\u0441\u0442\u0430\u043b\u0456\u0441\u044f \u0434\u0443\u0445\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456 \u0437 \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0430\u044e \u043c\u043e\u0446\u0430\u0439<br \/>\u0406 \u0433\u043b\u044f\u043d\u044c \u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0431\u043b\u0443\u043a\u0430\u0435,<br \/>\u0412\u044f\u0440\u043d\u0456 \u0456\u0445 \u0434\u0430 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0432\u0435\u0440\u044b,<br \/>\u042f\u043a\u043e\u044e \u043c\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u0431\u0443\u0434\u0437\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456, \u043a\u0430\u0431 \u043c\u0430\u0433\u043b\u0456 \u043c\u044b \u0437 \u0422\u0430\u0431\u043e\u044e<br \/>\u041d\u0430\u0432\u0435\u043a\u0456 \u045e\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0442\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430,<br \/>\u0410\u0439\u0446\u0430 \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430,<br \/>\u0428\u0442\u043e \u043d\u0430\u043c \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u044e\u0446\u044c. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"GCH_Gimn_ID":"671","GCH_Gimn_Text":"\r\n<p style=\"text-align: justify;\">\u0411\u0430\u0440\u043d\u0430\u0431\u0430, \u0432\u0435\u0440\u043d\u044b \u0441\u043f\u0430\u0434\u0430\u0440\u043e\u0436\u043d\u0456\u043a,<br \/>\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u043f\u0430\u043c\u043e\u0447\u043d\u0456\u043a \u0440\u0443\u043f\u043d\u044b<br \/>\u0412\u0430 \u045e\u0441\u0456\u0445 \u0456\u0445 \u043f\u0440\u0430\u0446\u0430\u0445 \u0456 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456,<br \/>\u041f\u0440\u044b\u043c\u0456 \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0456 \u043f\u0430\u0448\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0433\u044d\u0442\u044b\u0445 \u0432\u0435\u0441\u0442\u0443\u043d\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u0445<br \/>\u0417\u0430\u0437\u0437\u044f\u045e \u0447\u0430\u0441 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u044b,<br \/>\u0423\u0441\u044e \u0437\u044f\u043c\u043b\u044e \u0441\u043f\u0430\u043a\u043e\u0439 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e,<br \/>\u0406 \u043d\u043e\u0432\u044b\u044f \u0432\u044f\u043a\u0456 \u043d\u0430\u0441\u0442\u0430\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0432\u0435\u0447\u043d\u044b\u043c \u043d\u0435\u0431\u0430\u043c \u0431\u044b\u045e \u0430\u0431\u0440\u0430\u043d\u044b,<br \/>\u041a\u0430\u0431 \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456 \u0446\u044f\u0436\u0430\u0440 \u043d\u0435\u0441\u0446\u0456,<br \/>\u0422\u0430\u043c\u0443 \u0442\u0430\u043a\u0443\u044e \u0436 \u0441\u043b\u0430\u0432\u0443 \u043c\u0430\u0435\u0448,<br \/>\u042f\u043a\u043e\u0439 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u0437\u0430\u0437\u0437\u044f\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u043b\u0430 \u043d\u044f\u0437\u0433\u0430\u0441\u043d\u0430\u0433\u0430 \u0442\u044b \u0441\u0435\u0439\u0431\u0456\u0442,<br \/>\u0417\u0440\u0430\u0431\u0456, \u043a\u0430\u0431 \u043f\u0430\u0434 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c \u0441\u043e\u043d\u0446\u0430\u043c<br \/>\u0423\u0441\u044e\u0434\u044b \u043f\u0430\u0440\u0430\u0441\u0442\u043a\u0456 \u0430\u0436\u044b\u043b\u0456<br \/>\u041d