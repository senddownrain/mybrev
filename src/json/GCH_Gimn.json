0435 \u045e \u0422\u0440\u043e\u0439\u0446\u044b \u0432\u044b\u0437\u043d\u0430\u044e\u0446\u044c \u0430\u0434\u0437\u0456\u043d\u0430\u0439<br \/>\u0422\u0432\u0430\u0435 \u0430\u0431\u0440\u0430\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0406 \u0422\u0432\u0430\u044e \u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0437\u0440\u0430\u0437\u0443\u043c\u0435\u0446\u044c \u043d\u0430\u043c \u0446\u044f\u0436\u043a\u0430,<br \/>\u0410\u043b\u0435 \u0441\u0432\u044f\u0442\u044b\u043c, \u0448\u0442\u043e \u0426\u044f\u0431\u0435 \u0441\u043b\u0430\u0432\u044f\u0446\u044c \u0432\u0435\u0447\u043d\u0430,<br \/>\u0414\u0430\u0435\u0448 \u0422\u044b \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u043a\u0430\u043b\u0456 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0435\u0448<br \/>\u0406\u043c \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u0426\u044f\u0431\u0435 \u045e \u043d\u0435\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0441\u0432\u0435\u0442\u0443 &ndash; \u0437\u044f\u043c\u043b\u0456 \u0456 \u043d\u044f\u0431\u0451\u0441\u0430\u045e,<br \/>\u0422\u044b \u045e\u0441\u0456\u043c \u043a\u0456\u0440\u0443\u0435\u0448 \u0443 \u0441\u0432\u044f\u0442\u043b\u0435 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b\u043c,<br \/>\u0421\u0430\u0433\u0440\u044d\u0439 \u043b\u044e\u0431\u043e\u045e\u044e \u0414\u0443\u0445\u0430 \u0441\u044d\u0440\u0446\u044b \u043d\u0430\u0448\u044b,<br \/>\u0426\u044f\u0431\u0435 \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u043b\u0443\u0447\u043d\u0430\u0441\u0446\u0456 \u043c\u044b \u0437 \u0436\u044b\u0445\u0430\u0440\u0430\u043c\u0456 \u043d\u0435\u0431\u0430<br \/>\u041f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043c \u0433\u0456\u043c\u043d\u0430\u043c \u0422\u0432\u0430\u044e \u0432\u0435\u043b\u0456\u0447, \u0411\u043e\u0436\u0430.<br \/>\u041f\u0430\u043a\u043e\u0440\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c, \u0430\u0434\u0430\u0440\u044b \u0441\u043f\u0430\u043a\u043e\u0435\u043c <br \/>\u041d\u0430\u0441 \u045e \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u0422\u0432\u0430\u0456\u043c. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"GCH_Gimn_ID":"818","GCH_Gimn_Text":"\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0443\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u0440\u0430\u0434\u0430\u0441\u0446\u044e,<br \/>\u0417 \u0432\u0443\u0441\u043d\u0430\u045e \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0433\u0443\u0447\u0430\u0446\u044c \u0445\u0432\u0430\u043b\u0430\u0441\u043f\u0435\u0432\u044b.<br \/>\u041d\u044f\u0445\u0430\u0439 \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u043d\u043e\u0432\u044b\u043c\u0456 \u043d\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b,<br \/>\u0423\u0447\u044b\u043d\u043a\u0456 \u043d\u0430\u0448\u044b \u0456 \u0440\u043e\u0437\u0443\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u043e\u0447 \u0443\u0437\u0433\u0430\u0434\u0430\u0435\u043c \u0410\u043f\u043e\u0448\u043d\u044f\u0439 \u0412\u044f\u0447\u044d\u0440\u044b,<br \/>\u041a\u0430\u043b\u0456, \u044f\u043a \u0432\u0435\u0440\u044b\u043c, \u043d\u0430\u0448 \u041f\u0430\u043d \u0415\u0437\u0443\u0441 \u0425\u0440\u044b\u0441\u0442\u0443\u0441<br \/>\u0410\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u045e \u0441\u044f\u0431\u0435, \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u043b\u0430\u0441\u043a\u0430\u0439, <br \/>\u0411\u0440\u0430\u0442\u0430\u043c, \u044f\u043a \u0411\u0430\u0440\u0430\u043d\u0430\u043a, \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0437\u0430\u043a\u043e\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0434\u0430\u045e \u0441\u043b\u0430\u0431\u044b\u043c \u0446\u0435\u043b\u0430\u043c \u0441\u044f\u0431\u0435 \u043d\u0430 \u0441\u043f\u0430\u0436\u044b\u0442\u0430\u043a,<br \/>\u0414\u0430\u045e \u0437\u043c\u0443\u0447\u0430\u043d\u044b\u043c \u043a\u0435\u043b\u0456\u0445 \u041a\u0440\u044b\u0432\u0456, \u043a\u0430\u0431 \u043d\u0430\u043f\u0456\u0446\u0446\u0430:<br \/>&laquo;\u0411\u044f\u0440\u044b\u0446\u0435 \u041c\u043e\u0439 \u043a\u0435\u043b\u0456\u0445, \u043a\u0430\u0431 \u043c\u0435\u043b\u0456 \u0432\u044b \u0441\u0456\u043b\u044b;<br \/>\u0423\u0441\u0435 \u043f\u0456\u0446\u0435 \u0437 \u044f\u0433\u043e \u0456 \u0436\u044b\u0432\u0456\u0446\u0435&raquo;.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0442\u0430\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c \u0433\u044d\u0442\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u044b <br \/>\u0401\u043d \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u043f\u0435\u0440\u0430\u0434\u0430\u0446\u044c \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a<br \/>\u0421\u0430\u043c\u0456\u043c \u0441\u043f\u0430\u0436\u044b\u0432\u0430\u0446\u044c \u0456 \u0434\u0430\u0432\u0430\u0446\u044c \u044f\u0435 \u0456\u043d\u0448\u044b\u043c<br \/>\u0421\u043b\u0443\u0433\u0430\u043c \u0441\u0432\u0430\u0456\u043c \u0430\u0431\u0440\u0430\u043d\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u045e \u0445\u043b\u0435\u0431 \u0430\u043d\u0451\u043b\u0430\u045e \u0445\u043b\u0435\u0431\u0430\u043c \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430;<br \/>\u041d\u044f\u0431\u0435\u0441\u043d\u044b \u0445\u043b\u0435\u0431 \u0441\u0442\u0430\u045e \u0432\u044f\u0440\u0448\u044b\u043d\u044f\u044e \u0432\u043e\u0431\u0440\u0430\u0437\u0430\u045e.<br \/>\u041e \u0441\u043f\u0440\u0430\u0432\u0430 \u0446\u0443\u0434\u043e\u045e\u043d\u0430\u044f: \u041f\u0430\u043d\u0430 \u043f\u0440\u044b\u043c\u0430\u0435<br \/>\u041f\u0430\u043a\u043e\u0440\u043d\u044b \u0441\u043b\u0443\u0433\u0430 \u0456 \u045e\u0431\u043e\u0433\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u0411\u043e\u0436\u0430 \u045e \u0421\u0432\u044f\u