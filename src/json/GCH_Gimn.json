43 \u0432\u043e\u0434\u0430\u0445 \u042f\u0440\u0434\u0430\u043d\u0430<br \/>\u0422\u0430\u0433\u043e, \u0445\u0442\u043e \u0437\u043c\u044b\u0432\u0430\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430 \u0430\u0434\u0437\u0456\u043d\u044b \u045e \u0422\u0440\u043e\u0439\u0446\u044b \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439,<br \/>\u0410\u043d\u0451\u043b\u044b \u0433\u0456\u043c\u043d\u0430\u043c \u0426\u044f\u0431\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0446\u044c.<br \/>\u0414\u0430\u0439 \u043d\u0430\u043c \u0441\u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0422\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c,<br \/>\u0411\u044f\u0441\u043a\u043e\u043d\u0446\u0430\u0441\u0446\u044c \u043b\u0430\u0441\u043a\u0456 \u0422\u0432\u0430\u0451\u0439 \u043d\u0430\u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"GCH_Gimn_ID":"681","GCH_Gimn_Text":"\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0434\u0437\u0435\u043d\u044c \u0448\u0447\u0430\u0441\u043b\u0456\u0432\u044b \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0441\u0432\u044f\u0442\u0430,<br \/>\u0417\u0437\u044f\u043d\u043d\u0435\u043c \u0441\u0432\u0430\u0456\u043c \u043d\u0430\u043f\u0430\u045e\u043d\u044f\u0435 \u043d\u044f\u0431\u0451\u0441\u044b.<br \/>\u0412\u043e\u0441\u044c \u041f\u0451\u0442\u0440 \u0456 \u041f\u0430\u0432\u0435\u043b \u0443 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456 \u0456 \u0441\u043b\u0430\u0432\u0435 <br \/>\u041a\u0440\u043e\u045e \u0437\u0430 \u0425\u0440\u044b\u0441\u0442\u0430 \u0441\u0432\u0430\u044e \u043f\u0440\u0430\u043b\u0456\u0432\u0430\u044e\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0434\u0437\u0432\u0435 \u0430\u043b\u0456\u0432\u044b \u043f\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u041f\u04