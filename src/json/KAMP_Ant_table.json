

[{"KAMP_Ant_ID":"10","KAMP_Ant_Text1":"\r\n<p><span style=\"color: #ff0000;\">1 \u0430\u043d\u0442.<\/span> \u0417\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e, \u0411\u043e\u0436\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0456 \u043f\u0430\u0447\u0443\u0439 \u043c\u0430\u044e \u043c\u0430\u043b\u0456\u0442\u0432\u0443.<\/p>\r\n","KAMP_Ant_Text2":"\r\n<p><span style=\"color: #ff0000;\">2 \u0430\u043d\u0442<\/span>. \u0421\u044f\u0440\u043e\u0434 \u043d\u0430\u0447\u044b <span style=\"color: #ff0000;\">*<\/span> \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u041f\u0430\u043d\u0430.<\/p>\r\n"}, {"KAMP_Ant_ID":"11","KAMP_Ant_Text1":"\r\n<p><span style=\"color: #ff0000;\">\u0410\u043d\u0442.<\/span> \u0421\u0445\u0430\u0432\u0430\u0435\u0448\u0441\u044f \u043f\u0430\u0434 \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u043a\u0440\u044b\u043b\u0430\u043c\u0456, <span style=\"color: #ff0000;\">*<\/span> \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0448 \u0431\u0430\u044f\u0446\u0446\u0430 \u0441\u0442\u0440\u0430\u0445\u0443 \u043d\u0430\u0447\u043d\u043e\u0433\u0430.<\/p>\r\n","KAMP_Ant_Text2":""}, {"KAMP_Ant_ID":"12","KAMP_Ant_Text1":"\r\n<p><span style=\"color: #ff0000;\">\u0410\u043d\u0442.<\/span> \u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0422\u044b \u0448\u043c\u0430\u0442\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u044b \u0456 \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b.<\/p>\r\n","KAMP_Ant_Text2":""}, {"KAMP_Ant_ID":"13","KAMP_Ant_Text1":"\r\n<p><span style=\"color: #ff0000;\">\u0410\u043d\u0442.<\/span> \u041d\u0435 \u0445\u0430\u0432\u0430\u0439, \u0411\u043e\u0436\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0430\u0434 \u043c\u044f\u043d\u0435, <span style=\"color: #ff0000;\">*<\/span> \u0431\u043e \u044f \u043d\u0430 \u0426\u044f\u04