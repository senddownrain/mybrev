[{"KAMP_Mal_ID":"12","KAMP_Mal_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0434\u0430\u0439 \u043d\u0430\u043c \u0437\u0431\u0430\u045e\u0447\u044b \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u045e\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u0437\u0435\u0440\u043d\u0435 \u043d\u0430\u0448\u0430\u0439 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0439 \u043f\u0440\u0430\u0446\u044b \u0434\u0430\u043b\u043e \u043f\u043b\u0451\u043d \u0443 \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"KAMP_Mal_ID":"13","KAMP_Mal_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u043f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u0430\u0441\u0432\u044f\u0442\u043b\u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u0433\u044d\u0442\u0443\u044e \u043d\u043e\u0447 \u0456 \u045e\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u043c\u044b, \u0422\u0432\u0430\u0435 \u0441\u043b\u0443\u0433\u0456, \u0437\u0430\u0441\u043d\u0443\u043b\u0456 \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u0430 \u0456 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u0430\u0447\u043d\u0443\u043b\u0456\u0441\u044f \u0434\u0437\u0435\u043b\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u0456\u043c\u044f \u045e \u044f\u0441\u043d\u0430\u0441\u0446\u0456 \u043d\u043e\u0432\u0430\u0433\u0430 \u0434\u043d\u044f. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"KAMP_Mal_ID":"14","KAMP_Mal_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0446\u0456\u0445\u0456 \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u044b, \u0422\u044b \u0434\u0430\u0435\u0448 \u0441\u0432\u0430\u0456\u043c \u043f\u0430\u0441\u043b\u044f\u0434\u043e\u045e\u043d\u0456\u043a\u0430\u043c \u0441\u0430\u043b\u043e\u0434\u043a\u0430\u0435 \u044f\u0440\u043c\u043e \u0456 \u043b\u0451\u0433\u043a\u0456 \u0446\u044f\u0436\u0430\u0440. \u041f\u0440\u044b\u043c\u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u043d\u0430\u0448\u044b\u044f \u043f\u0430\u043c\u043a\u043d\u0435\u043d\u043d\u0456 \u0456 \u0441\u043f\u0440\u0430\u0432\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f \u0456 \u0430\u0434\u0430\u0440\u044b \u043d\u0430\u0441 \u0441\u043f\u0430\u043a\u043e\u0435\u043c, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u043b\u0435\u043f\u0448 \u0422\u0430\u0431\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c. \u042f\u043a\u0456 \u0436\u044b\u0432\u0435\u0448 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0448 \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"KAMP_Mal_ID":"15","KAMP_Mal_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u043d\u0430\u0448 \u0411\u043e\u0436\u0430, \u0430\u0442\u0443\u043b\u0456 \u043d\u0430\u0441, \u0437\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u043f\u0440\u0430\u0446\u0430\u0439 \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f, \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b\u043c \u0441\u043d\u043e\u043c, \u043a\u0430\u0431 \u0443\u0437\u043c\u043e\u0446\u043d\u0435\u043d\u044b\u044f \u0422\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0430\u0439, \u043c\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u044b\u043b\u0456 \u0430\u0434\u0434\u0430\u043d\u044b\u044f \u0422\u0430\u0431\u0435 \u0446\u0435\u043b\u0430\u043c \u0456 \u0434\u0443\u0445\u0430\u043c. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"KAMP_Mal_ID":"16","KAMP_Mal_Text":"\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0411\u043e\u0436\u0430, \u0422\u0432\u043e\u0439 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u044b \u0421\u044b\u043d \u043f\u0430\u043c\u0451\u0440 \u0456 \u0431\u044b\u045e \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b, \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u043d\u0430\u043c \u0441\u0442\u0430\u0446\u044c \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u042f\u0433\u043e, \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0440\u0430\u0437\u0430\u043c \u0437 \u0406\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c \u0434\u043b\u044f \u043d\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u042f\u043a\u0456 \u0436\u044b\u0432\u0435\u0448 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0448 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"KAMP_Mal_ID":"100","KAMP_Mal_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0431\u0443\u0434\u0437\u044c \u0437 \u043d\u0430\u043c\u0456 \u045e \u0433\u044d\u0442\u0443\u044e \u043d\u043e\u0447, \u043a\u0430\u0431 \u0437 \u0422\u0432\u0430\u0451\u0439 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u044e \u043c\u044b \u0437\u0430\u045e\u0442\u0440\u0430 \u045e\u0441\u0442\u0430\u043b\u0456 \u0456 \u0440\u0430\u0434\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044e \u0425\u0440\u044b\u0441\u0442\u0430. \u042f\u043a\u0456 \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"KAMP_Mal_ID":"101","KAMP_Mal_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u043d\u0430\u0432\u0435\u0434\u0430\u0439 \u0433\u044d\u0442\u044b \u0434\u043e\u043c \u0456 \u0430\u0434\u0434\u0430\u043b\u0456 \u0430\u0434 \u044f\u0433\u043e \u045e\u0441\u0435 \u0432\u0430\u0440\u043e\u0436\u044b\u044f \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u044b. \u041d\u044f\u0445\u0430\u0439 \u0422\u0432\u0430\u0435 \u0441\u0432\u044f\u0442\u044b\u044f \u0430\u043d\u0451\u043b\u044b \u0430\u043f\u044f\u043a\u0443\u044e\u0446\u0446\u0430 \u0456\u043c \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u0441 \u0443 \u0441\u043f\u0430\u043a\u043e\u0456, \u0430 \u0422\u0432\u0430\u0451 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"KAMP_Mal_ID":"111","KAMP_Mal_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u043f\u0430\u043a\u043e\u0440\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u043d\u0430\u043f\u0440\u044b\u043a\u0430\u043d\u0446\u044b \u0433\u044d\u0442\u0430\u0433\u0430 \u0434\u043d\u044f, \u043a\u0430\u043b\u0456 \u043c\u044b \u0430\u0434\u0437\u043d\u0430\u0447\u0430\u043b\u0456 \u0422\u0432\u0430\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435, \u0434\u0430\u0439 \u043d\u0430\u043c \u0441\u043f\u0430\u043a\u043e\u0439\u043d\u044b \u0441\u043e\u043d \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u0439 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0437\u043b\u0430, \u043a\u0430\u0431 \u043c\u044b, \u0430\u0431\u0443\u0434\u0437\u0456\u045e\u0448\u044b\u0441\u044f, \u0440\u0430\u0434\u0430\u0441\u043d\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u0426\u044f\u0431\u0435. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"KAMP_Mal_ID":"112","KAMP_Mal_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u043d\u0430\u0432\u0435\u0434\u0430\u0439 \u0433\u044d\u0442\u044b \u0434\u043e\u043c \u0456 \u0430\u0434\u0434\u0430\u043b\u0456 \u0430\u0434 \u044f\u0433\u043e \u045e\u0441\u0435 \u0432\u0430\u0440\u043e\u0436\u044b\u044f \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u044b. \u041d\u044f\u0445\u0430\u0439 \u0422\u0432\u0430\u0435 \u0441\u0432\u044f\u0442\u044b\u044f \u0430\u043d\u0451\u043b\u044b \u0430\u043f\u044f\u043a\u0443\u044e\u0446\u0446\u0430 \u0456\u043c \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u043d\u0430\u0441 \u0443 \u0441\u043f\u0430\u043a\u043e\u0456, \u0430 \u0422\u0432\u0430\u0451 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0431\u0443\u0434\u0437\u0435 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}]
