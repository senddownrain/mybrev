c \u043d\u0430 \u0440\u0443\u043a\u0430\u0445. \u0422\u0430\u0434\u044b \u045e\u0431\u0430\u0447\u044b\u0448 \u0442\u044b \u0456 \u0437\u0430\u0437\u0437\u044f\u0435\u0448, \u0437\u0430\u0442\u0440\u0430\u043f\u0435\u0447\u0430 \u0430\u0434 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0441\u044d\u0440\u0446\u0430 \u0442\u0432\u0430\u0451, \u0431\u043e \u0431\u0430\u0433\u0430\u0446\u0446\u0456 \u043c\u043e\u0440\u0430 \u043f\u0430\u043f\u043b\u044b\u0432\u0443\u0446\u044c \u0434\u0430 \u0446\u044f\u0431\u0435, \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0434\u0430 \u0446\u044f\u0431\u0435 \u0441\u043a\u0430\u0440\u0431 \u043d\u0430\u0440\u043e\u0434\u0430\u045e<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.\u2005<\/span>\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435, \u043d\u0430\u0440\u043e\u0434\u044b, \u043d\u0430\u0448\u0430\u0433\u0430 \u0411\u043e\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span>\u2005\u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u0447\u0443\u0435\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441 \u042f\u0433\u043e\u043d\u0430\u0439 \u0445\u0432\u0430\u043b\u044b.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"471","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0430\u0440\u043e\u0442\u043a\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435 \u0417\u0430\u0445 8, 7-8<\/span><br \/>\u0412\u043e\u0441\u044c \u042f \u045e\u0440\u0430\u0442\u0443\u044e \u043d\u0430\u0440\u043e\u0434 \u041c\u043e\u0439 \u0437 \u043a\u0440\u0430\u0456\u043d\u044b \u045e\u0441\u0445\u043e\u0434\u0443 \u0456 \u0437 \u043a\u0440\u0430\u0456\u043d\u044b \u0437\u0430\u0445\u0430\u0434\u0443 \u0441\u043e\u043d\u0446\u0430. \u0406 \u043f\u0440\u044b\u0432\u044f\u0434\u0443 \u0456\u0445, \u0456 \u043f\u0430\u0441\u0435\u043b\u044f\u0446\u0446\u0430 \u043f\u0430\u0441\u044f\u0440\u043e\u0434 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c\u0430. \u0406 