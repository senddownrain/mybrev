46\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"5015","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u043f\u0430\u0440. \u041a\u043b\u0441 1, 12-14<\/span><br \/>\u041c\u044b \u0434\u0437\u044f\u043a\u0443\u0435\u043c \u0410\u0439\u0446\u0443, \u044f\u043a\u0456 \u0437\u0440\u0430\u0431\u0456\u045e \u043d\u0430\u0441 \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u045e\u0434\u0437\u0435\u043b\u0443 \u045e \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0435 \u0441\u0432\u044f\u0442\u044b\u0445 \u0443 \u0441\u0432\u044f\u0442\u043b\u0435, \u044f\u043a\u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0437-\u043f\u0430\u0434 \u0443\u043b\u0430\u0434\u044b \u0446\u0435\u043c\u0440\u044b \u0456 \u043f\u0440\u044b\u0432\u0451\u045e \u0443 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u0443 \u044f\u043a\u0456\u043c \u043c\u044b \u043c\u0430\u0435\u043c \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u0456 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u043e\u0441\u044c \u0434\u0437\u0435\u043d\u044c, \u044f\u043a\u0456 \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e, \u0430\u043b\u043b\u0435\u043b\u044e\u044f. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u0456\u043c \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"5016","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\