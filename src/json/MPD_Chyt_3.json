45e \u0443 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u0443 \u044f\u043a\u0456\u043c \u043c\u044b \u043c\u0430\u0435\u043c \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u0456 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u0430\u0441\u0442\u0430\u043d\u044c\u0441\u044f \u0437 \u043d\u0430\u043c\u0456, \u041f\u0430\u043d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u045e\u0436\u043e \u0432\u0435\u0447\u0430\u0440\u044d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"5076","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 1 \u041a\u0430\u0440 5, 7-8<\/span><br \/>\u0410\u0447\u044b\u0441\u0446\u0456\u0446\u0435 \u0441\u0442\u0430\u0440\u0443\u044e \u0437\u0430\u043a\u0432\u0430\u0441\u043a\u0443, \u043a\u0430\u0431 \u0431\u044b\u0446\u044c \u0432\u0430\u043c \u043d\u043e\u0432\u044b\u043c \u0446\u0435\u0441\u0442\u0430\u043c, \u0431\u043e \u0432\u044b \u043f\u0440\u044d\u0441\u043d\u044b\u044f; \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u041f\u0430\u0441\u0445\u0430 \u043d\u0430\u0448\u0430\u044f, \u0425\u0440\u044b\u0441\u0442\u0443\u0441, \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b \u0437\u0430 \u043d\u0430\u0441! \u0422\u0430\u043c\u0443 \u0431\u0443\u0434\u0437\u0435\u043c \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u043d\u0435 \u045e \u0441\u0442\u0430\u0440\u043e\u0439 \u0437\u0430\u043a\u0432\u0430\u0441\u0446\u044b &ndash; \u0437\u0430\u043a\u0432\u0430\u0441\u0446\u044b \u0437\u043b\u0430 \u0456 \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u0443 &ndash; \u0430\u043b\u0435 \u045e \u043f\u0440\u044d\u0441\u043d\u044b\u043c \u0445\u043b\u0435\u0431\u0435 \u0447\u044b\u0441\u0442\u0430\u0441\u0446\u0456 \u0456 \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u0430\u0441\u0442\u0430\u043d\u044c\u0441\u044f \u0437 \u043d\u0430\u043c\u0456, \u041f\u0430\u043d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u045e\u0436\u043e \u0432\u0435\u0447\u0430\u0440\u044d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"5077","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 2 \u041a\u0430\u0440 5, 14-15<\/span><br \/>\u041b\u044e\u0431\u043e\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u043d\u0430\u0441, \u044f\u043a\u0456\u044f \u0434\u0443\u043c\u0430\u044e\u0446\u044c, \u0448\u0442\u043e \u043a\u0430\u043b\u0456 \u0430\u0434\u0437\u0456\u043d \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0456\u0445, \u0442\u043e \u045e\u0441\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u0456. \u0410 \u0415\u0437\u0443\u0441 \u043f\u0430\u043c\u0451\u0440 \u0437\u0430 \u045e\u0441\u0456\u0445, \u043a\u0430\u0431 \u0442\u044b\u044f, \u0445\u0442\u043e \u0436\u044b\u0432\u0435, \u0443\u0436\u043e \u043d\u0435 \u0434\u0437\u0435\u043b\u044f \u0441\u044f\u0431\u0435 \u0436\u044b\u043b\u0456, \u0430 \u0434\u0437\u0435\u043b\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u0430\u0433\u0430 \u0437\u0430 \u0456\u0445 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0430\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u0430\u0441\u0442\u0430\u043d\u044c\u0441\u044f \u0437 \u043d\u0430\u043c\u0456, \u041f\u0430\u043d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u045e\u0436\u043e \u0432\u0435\u0447\u0430\u0440\u044d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"5081","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 2 \u041a\u0430\u0440 1, 21-22<\/span><br \/>\u0422\u043e\u0439 \u0436\u0430, \u0445\u0442\u043e \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0435 \u043d\u0430\u0441 \u0437 \u0432\u0430\u043c\u0456 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0456 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u043d\u0430\u0441, \u0451\u0441\u0446\u044c \u0411\u043e\u0433, \u044f\u043a\u0456 \u043f\u0430\u0437\u043d\u0430\u0447\u044b\u045e \u043d\u0430\u0441 \u0456 \u0434\u0430\u045e \u0437\u0430\u0434\u0430\u0442\u0430\u043a \u0414\u0443\u0445\u0430 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u043d\u0430\u0448\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456 \u043d\u0430 \u0440\u043e\u0437\u043d\u044b\u0445 \u043c\u043e\u0432\u0430\u0445, \u0430\u043b\u043b\u0435\u043b\u044e\u044f. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044f\u043b\u0456\u043a\u0456\u044f \u0411\u043e\u0436\u044b\u044f \u0441\u043f\u0440\u0430\u0432\u044b, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"9001","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0430\u0440\u043e\u0442\u043a\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435 \u0415\u0440 7, 2b. 4-5a. 7a<\/span><br \/>C\u043b\u0443\u0445\u0430\u0439\u0446\u0435 \u0441\u043b\u043e\u0432\u0430 \u041f\u0430\u043d\u0430 \u0432\u044b, \u044f\u043a\u0456\u044f \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0435 \u043f\u0440\u0430\u0437 \u0433\u044d\u0442\u044b\u044f \u0431\u0440\u0430\u043c\u044b, \u043a\u0430\u0431 \u043f\u0430\u043a\u043b\u0430\u043d\u0456\u0446\u0446\u0430 \u041f\u0430\u043d\u0443. \u041d\u0435 \u0432\u0435\u0440\u0446\u0435 \u043f\u0430\u0434\u043c\u0430\u043d\u043b\u0456\u0432\u044b\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u043a\u0430\u0436\u0443\u0447\u044b: \u0421\u0432\u044f\u0442\u044b\u043d\u044f \u041f\u0430\u043d\u0430, \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u041f\u0430\u043d\u0430, \u0441\u0432\u044f\u0442\u044b\u043d\u044f \u041f\u0430\u043d\u0430. \u0411\u043e \u043a\u0430\u043b\u0456 \u0432\u044b \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u044b \u043f\u0430\u043f\u0440\u0430\u0432\u0456\u0446\u0435 \u0448\u043b\u044f\u0445\u0456 \u0432\u0430\u0448\u044b\u044f \u0456 \u045e\u0447\u044b\u043d\u043a\u0456 \u0432\u0430\u0448\u044b\u044f; \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u044f\u0433\u043e \u0431\u043b\u0456\u0436\u043d\u044f\u0433\u0430, \u0442\u0430\u0434\u044b \u042f \u0434\u0430\u0437\u0432\u043e\u043b\u044e \u0432\u0430\u043c \u0436\u044b\u0446\u044c \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span>\u2005\u0423\u0432\u0430\u0445\u043e\u0434\u0437\u044c\u0446\u0435 \u045e \u0431\u0440\u0430\u043c\u044b \u041f\u0430\u043d\u0430 \u0437 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span>\u2005\u0406 \u045e \u043f\u0430\u043d\u0430\u0434\u0432\u043e\u0440\u043a\u0456 \u042f\u0433\u043e &ndash; \u0437 \u0445\u0432\u0430\u043b\u0430\u0441\u043f\u0435\u0432\u0430\u043c.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"9002","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0430\u0440\u043e\u0442\u043a\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435 \u0410\u0433 2, 6\u0430. 7. 9<\/span><br \/>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e: \u042f \u045e\u0437\u0440\u0443\u0448\u0443 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0456 \u043f\u0440\u044b\u043d\u044f\u0441\u0443\u0446\u044c \u0441\u043a\u0430\u0440\u0431\u044b \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u044e \u0434\u043e\u043c \u0433\u044d\u0442\u044b \u0441\u043b\u0430\u0432\u0430\u044e, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e. \u0406 \u0441\u043b\u0430\u0432\u0430 \u0433\u044d\u0442\u0430\u0433\u0430 \u0430\u043f\u043e\u0448\u043d\u044f\u0433\u0430 \u0434\u043e\u043c\u0443 \u0431\u0443\u0434\u0437\u0435 \u0431\u043e\u043b\u044c\u0448\u0430\u0439, \u0447\u044b\u043c \u043f\u0430\u043f\u044f\u0440\u044d\u0434\u043d\u044f\u0433\u0430. \u041d\u0430 \u0433\u044d\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u042f \u0434\u0430\u043c \u0441\u043f\u0430\u043a\u043e\u0439, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span>\u2005\u0423\u0432\u0430\u0445\u043e\u0434\u0437\u044c\u0446\u0435 \u045e \u0431\u0440\u0430\u043c\u044b \u041f\u0430\u043d\u0430 \u0437 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span>\u2005\u0406 \u045e \u043f\u0430\u043d\u0430\u0434\u0432\u043e\u0440\u043a\u0456 \u042f\u0433\u043e &ndash; \u0437 \u0445\u0432\u0430\u043b\u0430\u0441\u043f\u0435\u0432\u0430\u043c.<\/p>\r\n"}]
