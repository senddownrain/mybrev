044f\u0446\u044c \u0431\u0443\u0434\u0443\u0446\u044c \u0411\u043e\u0433\u0430 \u043d\u0430\u0432\u0435\u043a\u0456 \u045e \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456. \u0423\u0441\u0435 \u0441\u044b\u043d\u044b \u0406\u0437\u0440\u0430\u044d\u043b\u044f, \u044f\u043a\u0456\u044f \u045e\u0440\u0430\u0442\u0443\u044e\u0446\u0446\u0430 \u045e \u0442\u044b\u044f \u0434\u043d\u0456, \u0443\u0437\u0433\u0430\u0434\u0432\u0430\u0446\u044c \u0431\u0443\u0434\u0443\u0446\u044c \u0411\u043e\u0433\u0430 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435. \u0417\u0431\u044f\u0440\u0443\u0446\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0456 \u043f\u0440\u044b\u0439\u0434\u0443\u0446\u044c \u0443 \u0415\u0440\u0443\u0437\u0430\u043b\u0435\u043c. \u0406 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0431\u0443\u0434\u0443\u0446\u044c \u0442\u044b\u044f, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u0411\u043e\u0433\u0430 \u045e \u043f\u0440\u0430\u045e\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u0441\u0443\u0441\u0442\u0440\u044d\u043d\u0443\u0446\u0446\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u043f\u0430\u0446\u0430\u043b\u0443\u044e\u0446\u0446\u0430, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"457","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0406\u0441 65, 1<\/span><br \/>\u042f \u0434\u0430\u045e \u0430\u0434\u0448\u0443\u043a\u0430\u0446\u044c \u0441\u044f\u0431\u0435 \u0442\u