3\u043b\u044f\u0434\u0436\u0443, \u044f\u043a \u0433\u043b\u044f\u0434\u0437\u044f\u0446\u044c \u043b\u044e\u0434\u0437\u0456, \u0431\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u0431\u0430\u0447\u044b\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u043d\u0430\u0432\u0456\u0434\u0430\u0432\u043e\u043a\u0443, \u0430 \u041f\u0430\u043d \u0437\u0430\u0433\u043b\u044f\u0434\u0430\u0435 \u045e \u0441\u044d\u0440\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0430\u0441\u043b\u0435\u0434\u0443\u0439 \u043c\u044f\u043d\u0435, \u0411\u043e\u0436\u0430, \u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u0439 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u044f\u0434\u0437\u0456 \u043c\u044f\u043d\u0435 \u0448\u043b\u044f\u0445\u0430\u043c \u0430\u0434\u0432\u0435\u0447\u043d\u044b\u043c.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"25","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0413\u0430\u043b 5, 22. 23\u0430. 25<\/span><br \/>\u041f\u043b\u0451\u043d \u0434\u0443\u0445\u0430 &ndash; \u0433\u044d\u0442\u0430 \u043b\u044e\u0431\u043e\u045e, \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0441\u043f\u0430\u043a\u043e\u0439, \u0434\u043e\u045e\u0433\u0430\u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c, \u043b\u0430\u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0434\u0430\u0431\u0440\u044b\u043d\u044f, \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c, \u0434\u0430\u043b\u0456\u043a\u0430\u0442\u043d\u0430\u0441\u0446\u044c, \u0441\u0442\u0440\u044b\u043c\u0430\u043d\u0430\u0441\u0446\u044c. \u041a\u0430\u043b\u0456 \u043c\u044b \u0436\u044b\u0432\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0414\u0443\u0445\u0430, \u0442\u043e \u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u0414\u0443\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043a\u0430\u0436\u044b \u043c\u043d\u0435, \u041f\u0430\u043d\u0435, \u0448\u043b\u044f\u0445, \u044f\u043a\u0456\u043c \u044f \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u0456\u0441\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u044f\u0445\u0430\u0439 \u0422\u0432\u043e\u0439 \u0434\u043e\u0431\u0440\u044b \u0434\u0443\u0445 \u0432\u044f\u0434\u0437\u0435 \u043c\u044f\u043d\u0435 \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430\u0439 \u0440\u0430\u045e\u043d\u0456\u043d\u0430\u0439.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"26","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u041c\u0434\u0440 1, 13-15<\/span><br \/>\u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u0411\u043e\u0433 \u043d\u0435 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0441\u043c\u0435\u0440\u0446\u0456, \u0401\u043d \u043d\u0435 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0441\u0430 \u0437\u0433\u0443\u0431\u044b \u0436\u044b\u0432\u043e\u0433\u0430. \u0411\u043e \u0401\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0443\u0441\u0451 \u0434\u043b\u044f \u0436\u044b\u0446\u0446\u044f, \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0456 \u0441\u0432\u0435\u0442\u0443 \u043c\u0430\u044e\u0446\u044c \u045e \u0441\u0430\u0431\u0435 \u0437\u0434\u0430\u0440\u043e\u045e\u0435, \u043d\u044f\u043c\u0430 \u045e \u0456\u0445 \u0437\u043d\u0456\u0448\u0447\u0430\u043b\u044c\u043d\u0430\u0439 \u0430\u0442\u0440\u0443\u0442\u044b, \u043d\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456. \u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0437\u0431\u0430\u0432\u0456\u045e \u0434\u0443\u0448\u0443 \u043c\u0430\u044e \u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041a\u0430\u0431 \u0445\u0430\u0434\u0437\u0456\u045e \u044f \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u0411\u043e\u0436\u044b\u043c \u0443 \u0441\u0432\u044f\u0442\u043b\u0435 \u0436\u044b\u0432\u044b\u0445.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"27","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0415\u0440 6, 16<\/span><br \/>\u0421\u0442\u0430\u043d\u044c\u0446\u0435 \u043d\u0430 \u0434\u0430\u0440\u043e\u0433\u0430\u0445 \u0456 \u0433\u043b\u044f\u0434\u0437\u0456\u0446\u0435, \u043f\u044b\u0442\u0430\u0439\u0446\u0435\u0441\u044f \u043f\u0440\u0430 \u0434\u0430\u045e\u043d\u0456\u044f \u0441\u0446\u0435\u0436\u043a\u0456, \u0434\u0437\u0435 \u0451\u0441\u0446\u044c \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u044f \u0434\u0430\u0440\u043e\u0433\u0430, \u0456\u0434\u0437\u0456\u0446\u0435 \u043f\u0430 \u0451\u0439, \u0456 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0446\u0435 \u0434\u043b\u044f \u0441\u044f\u0431\u0435 \u043f\u0430\u043b\u0451\u0433\u043a\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0422\u0432\u0430\u0435 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0456 &ndash; \u043c\u0430\u044f \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0430 \u043d\u0430\u0432\u0435\u043a\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u044f\u043d\u044b &ndash; \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043c\u0430\u0439\u0433\u043e \u0441\u044d\u0440\u0446\u0430.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"31","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 2 \u0426\u0456\u043c 1, 9<\/span><br \/>\u0411\u043e\u0433 \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u043d\u0430\u0441 \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0441\u0432\u044f\u0442\u044b\u043c \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0435\u043c \u043d\u0435 \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u045e\u0447\u044b\u043d\u043a\u0456, \u0430\u043b\u0435 \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u045e\u043b\u0430\u0441\u043d\u0430\u0439 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b \u0456 \u043b\u0430\u0441\u043a\u0456, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0439 \u043d\u0430\u043c \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435 \u043f\u0435\u0440\u0430\u0434 \u0432\u0435\u0447\u043d\u044b\u043c\u0456 \u0447\u0430\u0441\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0412\u0451\u045e \u0456\u0445 \u041f\u0430\u043d \u0431\u044f\u0441\u043f\u0435\u0447\u043d\u0430, \u0456 \u043d\u0435 \u043f\u0430\u043b\u043e\u0445\u0430\u043b\u0456\u0441\u044f \u044f\u043d\u044b. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0440\u044b\u0432\u0451\u045e \u0456\u0445 \u0443 \u0437\u044f\u043c\u043b\u044e \u0441\u0432\u0430\u044e \u0441\u0432\u044f\u0442\u0443\u044e.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"32","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u041a\u043b\u0441 1, 21-22<\/span><br \/>\u0412\u044b \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0431\u044b\u043b\u0456 \u0430\u0434\u0447\u0443\u0436\u0430\u043d\u044b\u044f \u0456 \u0432\u0430\u0440\u043e\u0436\u044b\u044f \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043c\u044b\u0441\u043b\u0435\u043d\u043d\u044f \u0456 \u0441\u0432\u0430\u0456\u0445 \u043b\u0456\u0445\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u045e, \u0446\u044f\u043f\u0435\u0440 \u0401\u043d \u043f\u0440\u044b\u043c\u0456\u0440\u044b\u045e \u0432\u0430\u0441 \u0443 \u0441\u0432\u0430\u0456\u043c \u0437\u044f\u043c\u043d\u044b\u043c \u0446\u0435\u043b\u0435 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u0441\u043c\u0435\u0440\u0446\u044c, \u043a\u0430\u0431 \u043f\u0430\u0441\u0442\u0430\u0432\u0456\u0446\u044c \u0432\u0430\u0441 \u043f\u0435\u0440\u0430\u0434 \u0441\u0430\u0431\u043e\u044e \u0441\u0432\u044f\u0442\u044b\u043c\u0456, \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u044b\u043c\u0456 \u0456 \u0431\u0435\u0437\u0434\u0430\u043a\u043e\u0440\u043d\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043f\u044f\u0432\u0430\u0439\u0446\u0435 \u041f\u0430\u043d\u0443 \u0432\u044b, \u042f\u0433\u043e\u043d\u044b\u044f \u0432\u0435\u0440\u043d\u044b\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043f\u0430\u043c\u044f\u0442\u0430\u0439\u0446\u0435 \u043f\u0440\u0430 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u042f\u0433\u043e\u043d\u0443\u044e.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"33","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u041f\u0440\u044b\u043f 22, 22-23<\/span><br \/>\u041d\u0435 \u0430\u0431\u043a\u0440\u0430\u0434\u0430\u0439 \u0431\u0435\u0434\u043d\u0430\u0433\u0430, \u0431\u043e \u0451\u043d \u0431\u0435\u0434\u043d\u044b, \u0456 \u043d\u0435 \u045e\u0446\u0456\u0441\u043a\u0430\u0439 \u0443\u0431\u043e\u0433\u0430\u0433\u0430 \u045e \u0431\u0440\u0430\u043c\u0435, \u0431\u043e \u041f\u0430\u043d \u0437\u0430\u0441\u0442\u0443\u043f\u0456\u0446\u0446\u0430 \u0437\u0430 \u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0443, \u0437\u0430\u0431\u044f\u0440\u044d \u045e \u0456\u0445\u043d\u0456\u0445 \u0437\u043b\u043e\u0434\u0437\u0435\u044f\u045e \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u0431\u0435\u0434\u043d\u0430\u0433\u0430, \u044f\u043a\u0456 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0456 \u043d\u0435 \u043c\u0430\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0434\u0443\u0448\u044b \u045e\u0431\u043e\u0433\u0456\u0445 \u0443\u0440\u0430\u0442\u0443\u0435.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"34","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u041a\u043b\u0441 3, 14-15<\/span><br \/>\u0410 \u043f\u0430-\u043d\u0430\u0434 \u0443\u0441\u0456\u043c \u0433\u044d\u0442\u044b\u043c \u0430\u043f\u0440\u0430\u043d\u0456\u0446\u0435\u0441\u044f \u045e \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0430\u044f \u0451\u0441\u0446\u044c \u043f\u043e\u0432\u044f\u0437\u0437\u044e \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0441\u0446\u0456. \u0406 \u043d\u044f\u0445\u0430\u0439 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0430\u0448\u044b\u0445 \u0441\u043f\u0430\u043a\u043e\u0439 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b, \u0434\u0430 \u044f\u043a\u043e\u0433\u0430 \u0432\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u044b\u044f \u045e \u0430\u0434\u043d\u044b\u043c \u0446\u0435\u043b\u0435. \u0406 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u045e\u0434\u0437\u044f\u0447\u043d\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043a\u043e\u0440\u043d\u044b\u044f \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443 \u0437\u044f\u043c\u043b\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0431\u0443\u0434\u0443\u0446\u044c \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0432\u044f\u043b\u0456\u043a\u0456\u043c \u0441\u043f\u0430\u043a\u043e\u0435\u043c.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"35","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u042d\u0441\u0442 10, 3f<\/span><br \/>\u041c\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 &ndash; \u0433\u044d\u0442\u0430 \u0406\u0437\u0440\u0430\u044d\u043b\u044c, \u044f\u043a\u0456 \u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u0411\u043e\u0433\u0430. \u041f\u0430\u043d \u0443\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u043d\u0430\u0440\u043e\u0434 \u0441\u0432\u043e\u0439 \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u045e \u043d\u0430\u0441 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f, \u0456 \u045e\u0447\u044b\u043d\u0456\u045e \u0411\u043e\u0433 \u0437\u043d\u0430\u043a\u0456 \u0456 \u0446\u0443\u0434\u044b, \u044f\u043a\u0456\u044f \u043d\u0435 \u0431\u044b\u043b\u0456 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0435\u043d\u0435\u043d\u044b \u0441\u044f\u0440\u043e\u0434 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0421\u043b\u0430\u045e\u043b\u044e \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0431\u043e \u0422\u044b \u043c\u044f\u043d\u0435 \u043f\u0430\u0447\u0443\u045e. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u0441\u0442\u0430\u045e \u043c\u0430\u0456\u043c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435\u043c.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"36","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u042d\u0444 2, 8-9<\/span><br \/>\u041b\u0430\u0441\u043a\u0430\u044e \u0432\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443. \u0406 \u0433\u044d\u0442\u0430 \u043d\u0435 \u0430\u0434 \u0432\u0430\u0441, \u0433\u044d\u0442\u0430 \u0411\u043e\u0436\u044b \u0434\u0430\u0440. \u0406 \u043d\u0435 \u0430\u0434 \u0443\u0447\u044b\u043d\u043a\u0430\u045e, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0445\u0432\u0430\u043b\u0456\u045e\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0430\u0439, \u041f\u0430\u043d\u0435, \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u0422\u0432\u0430\u044e \u0434\u0430\u0440\u043e\u0433\u0443. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u0456\u0436 \u0443\u0441\u0456\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456 \u042f\u0433\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"37","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u041c\u0456\u0445 6, 8<\/span><br \/>\u041e \u0447\u0430\u043b\u0430\u0432\u0435\u043a, \u0441\u043a\u0430\u0437\u0430\u043d\u0430 \u0442\u0430\u0431\u0435, \u0448\u0442\u043e \u0451\u0441\u0446\u044c \u0434\u0430\u0431\u0440\u043e\u043c, \u0456 \u0447\u0430\u0433\u043e \u043f\u0430\u0442\u0440\u0430\u0431\u0443\u0435 \u0430\u0434 \u0446\u044f\u0431\u0435 \u041f\u0430\u043d: \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0446\u044c \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u043b\u044e\u0431\u0456\u0446\u044c \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u0430 \u0445\u0430\u0434\u0437\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0442\u0432\u0430\u0456\u043c \u0411\u043e\u0433\u0430\u043c?<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0428\u043b\u044f\u0445\u0443 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f\u045e \u0422\u0432\u0430\u0456\u0445 \u044f \u0440\u0430\u0434\u0443\u044e\u0441\u044f, \u041f\u0430\u043d\u0435. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u043b\u043e\u0432\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u0437\u0430\u0431\u0443\u0434\u0443.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"41","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u041f\u043f 8, 6b-7\u0430<\/span><br \/>\u041a\u0430\u0445\u0430\u043d\u043d\u0435 \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0435, \u044f\u043a \u0441\u043c\u0435\u0440\u0446\u044c, \u0440\u044d\u045e\u043d\u0430\u0441\u0446\u044c \u0431\u044f\u0437\u043b\u0456\u0442\u0430\u0441\u043d\u0430\u044f, \u044f\u043a \u0430\u0434\u0445\u043b\u0430\u043d\u044c. \u042f\u0433\u043e \u043f\u043e\u043b\u044b\u043c\u044f &ndash; \u0433\u044d\u0442\u0430 \u043f\u043e\u043b\u044b\u043c\u044f \u0430\u0433\u043d\u044e, \u044f\u043a \u0411\u043e\u0436\u0430\u0435 \u043f\u043e\u043b\u044b\u043c\u044f. \u0412\u044f\u043b\u0456\u043a\u0456\u044f \u0432\u043e\u0434\u044b \u043d\u0435 \u0437\u043c\u043e\u0433\u0443\u0446\u044c \u043f\u0430\u0433\u0430\u0441\u0456\u0446\u044c \u043a\u0430\u0445\u0430\u043d\u043d\u044f, \u0456 \u0440\u044d\u043a\u0456 \u043d\u0435 \u0437\u0430\u0442\u043e\u043f\u044f\u0446\u044c \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u0443\u0434\u0443 \u043b\u044e\u0431\u0456\u0446\u044c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u043c\u043e\u0446 \u043c\u0430\u044f. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u0448\u0447\u044b\u0442 \u043c\u043e\u0439, \u043c\u043e\u0446 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043c\u0430\u0439\u0433\u043e.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"42","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0411\u0430\u0440 4, 21b-22<\/span><br \/>\u0414\u0437\u0435\u0446\u0456, \u043a\u043b\u0456\u0447\u0446\u0435 \u0411\u043e\u0433\u0430, \u0456 \u0401\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u0432\u0430\u0441 \u0430\u0434 \u0443\u0446\u0456\u0441\u043a\u0443, \u0430\u0434 \u0440\u0443\u043a\u0456 \u043d\u0435\u043f\u0440\u044b\u044f\u0446\u0435\u043b\u044f. \u042f \u0436 \u0437 \u0434\u0430\u0432\u0435\u0440\u0430\u043c \u0430\u0434\u0434\u0430\u045e \u0421\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u043c\u0443 \u0432\u044b\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0432\u0430\u0448\u0430\u0435, \u0456 \u045e\u0437\u0440\u0430\u0434\u0430\u0432\u0430\u045e \u043c\u044f\u043d\u0435 \u0421\u0432\u044f\u0442\u044b \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e, \u044f\u043a\u0443\u044e \u043f\u0440\u0430\u044f\u0432\u0456\u045e \u0434\u0430 \u0432\u0430\u0441 \u043d\u0435\u045e\u0437\u0430\u0431\u0430\u0432\u0435 \u0421\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u044b, \u0432\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0423\u0437\u0433\u0430\u0434\u0430\u0439 \u043f\u0440\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0441\u0432\u0430\u044e, \u041f\u0430\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0406 \u043f\u0440\u0430 \u043b\u0430\u0441\u043a\u0443 \u0441\u0432\u0430\u044e, \u0431\u043e \u044f\u043d\u044b \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"43","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0406\u0441 55, 10-11<\/span><br \/>\u041f\u0430\u0434\u043e\u0431\u043d\u0430 \u044f\u043a \u0434\u043e\u0436\u0434\u0436 \u0456 \u0441\u043d\u0435\u0433 \u043f\u0430\u0434\u0430\u0435 \u0437 \u043d\u0435\u0431\u0430 \u0456 \u0442\u0443\u0434\u044b \u043d\u0435 \u0432\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430, \u0430\u043b\u0435 \u043f\u043e\u0456\u0446\u044c \u0437\u044f\u043c\u043b\u044e \u0456 \u0440\u043e\u0431\u0456\u0446\u044c \u044f\u0435 \u045e\u0440\u0430\u0434\u043b\u0456\u0432\u0430\u0439, \u0456 \u044f\u043d\u0430 \u0440\u043e\u0434\u0437\u0456\u0446\u044c, \u0456 \u043f\u0440\u044b\u043d\u043e\u0441\u0456\u0446\u044c \u043f\u043b\u0451\u043d \u0441\u0435\u0439\u0431\u0456\u0442\u0443 \u0456 \u0445\u043b\u0435\u0431 \u0434\u043b\u044f \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0435\u0441\u0446\u044c, \u0442\u0430\u043a \u0456 \u0441\u043b\u043e\u0432\u0430 \u041c\u0430\u0451, \u044f\u043a\u043e\u0435 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u041c\u0430\u0456\u0445, \u043d\u0435 \u0432\u0435\u0440\u043d\u0435\u0446\u0446\u0430 \u0434\u0430 \u041c\u044f\u043d\u0435 \u0431\u0435\u0437 \u043f\u043b\u0451\u043d\u0443, \u043f\u0430\u043a\u0443\u043b\u044c \u043d\u0435 \u0441\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u0442\u043e\u0435, \u0448\u0442\u043e \u042f \u0445\u0430\u0446\u0435\u045e, \u0456 \u0437 \u043f\u043e\u0441\u043f\u0435\u0445\u0430\u043c \u043d\u0435 \u0434\u0430\u0441\u044f\u0433\u043d\u0435 \u0442\u0430\u0433\u043e, \u0434\u0437\u0435\u043b\u044f \u0447\u0430\u0433\u043e \u042f \u043f\u0430\u0441\u043b\u0430\u045e \u044f\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d \u043f\u0430\u0441\u044b\u043b\u0430\u0435 \u0441\u043b\u043e\u0432\u0430 \u0441\u0432\u0430\u0451 \u043d\u0430 \u0437\u044f\u043c\u043b\u044e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0412\u0435\u043b\u044c\u043c\u0456 \u0445\u0443\u0442\u043a\u0430 \u043b\u044f\u0446\u0456\u0446\u044c \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u0430.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"44","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u041a\u043b\u0441 3, 23-24<\/span><br \/>\u0423\u0441\u0451, \u0448\u0442\u043e \u0431 \u0432\u044b \u043d\u0435 \u0440\u0430\u0431\u0456\u043b\u0456, \u0440\u0430\u0431\u0456\u0446\u0435 \u0430\u0434 \u0434\u0443\u0448\u044b, \u044f\u043a \u0434\u043b\u044f \u041f\u0430\u043d\u0430, \u0430 \u043d\u0435 \u0434\u043b\u044f \u043b\u044e\u0434\u0437\u0435\u0439, \u0432\u0435\u0434\u0430\u044e\u0447\u044b, \u0448\u0442\u043e \u0430\u0434 \u041f\u0430\u043d\u0430 \u0430\u0442\u0440\u044b\u043c\u0430\u0435\u0446\u0435 \u0432\u0430 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u0443. \u0411\u0443\u0434\u0437\u044c\u0446\u0435 \u043d\u044f\u0432\u043e\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0430\u043d &ndash; \u0447\u0430\u0441\u0442\u043a\u0430 \u0441\u043f\u0430\u0434\u0447\u044b\u043d\u044b \u043c\u0430\u0451\u0439 \u0456 \u043a\u0435\u043b\u0456\u0445\u0430 \u043c\u0430\u0439\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0422\u044b \u043b\u0451\u0441 \u043c\u043e\u0439 \u0442\u0440\u044b\u043c\u0430\u0435\u0448.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"45","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0413\u0431\u0440 12, 1b-2<\/span><br \/>\u0421\u043a\u0456\u043d\u0435\u043c \u0437 \u0441\u044f\u0431\u0435 \u045e\u0441\u044f\u043b\u044f\u043a\u0456 \u0446\u044f\u0436\u0430\u0440 \u0456 \u0433\u0440\u044d\u0445, \u044f\u043a\u0456 \u043b\u0451\u0433\u043a\u0430 \u0430\u0431\u043b\u044b\u0442\u0432\u0430\u0435 \u043d\u0430\u0441, \u0456 \u0431\u0443\u0434\u0437\u0435\u043c \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0431\u0435\u0433\u0447\u044b \u045e \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u043c \u0434\u043b\u044f \u043d\u0430\u0441 \u0437\u043c\u0430\u0433\u0430\u043d\u043d\u0456, \u0433\u043b\u0435\u0434\u0437\u044f\u0447\u044b \u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u043f\u0430\u0447\u044b\u043d\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0456 \u0437\u0430\u0432\u044f\u0440\u0448\u0430\u043b\u044c\u043d\u0456\u043a\u0430 \u0432\u0435\u0440\u044b. \u0417\u0430\u043c\u0435\u0441\u0442 \u0440\u0430\u0434\u0430\u0441\u0446\u0456, \u0448\u0442\u043e \u0431\u044b\u043b\u0430 \u043f\u0435\u0440\u0430\u0434 \u0406\u043c, \u0401\u043d, \u043d\u0435 \u0437\u0432\u0430\u0436\u0430\u044e\u0447\u044b \u043d\u0430 \u0433\u0430\u043d\u044c\u0431\u0443, \u0432\u044b\u0446\u0435\u0440\u043f\u0435\u045e \u043a\u0440\u044b\u0436 \u0456 \u0441\u0435\u045e \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0436\u0430\u0433\u0430 \u0442\u0440\u043e\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0414\u0443\u0448\u0430 \u043c\u0430\u044f, \u0441\u043f\u0430\u0434\u0437\u044f\u0435\u0446\u0446\u0430 \u043d\u0430 \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0443\u0448\u0430 \u043c\u0430\u044f \u0434\u0430\u0432\u044f\u0440\u0430\u0435 \u042f\u0433\u043e \u0441\u043b\u043e\u0432\u0443.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"46","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 1 \u042f\u043d 4, 9-11<\/span> <br \/>\u041b\u044e\u0431\u043e\u045e \u0411\u043e\u0433\u0430 \u0434\u0430 \u043d\u0430\u0441 \u0430\u0434\u043a\u0440\u044b\u043b\u0430\u0441\u044f \u045e \u0442\u044b\u043c, \u0448\u0442\u043e \u0411\u043e\u0433 \u043f\u0430\u0441\u043b\u0430\u045e \u0443 \u0441\u0432\u0435\u0442 \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430, \u043a\u0430\u0431 \u043c\u044b \u0436\u044b\u043b\u0456 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e. \u0423 \u0442\u044b\u043c \u043f\u0440\u0430\u044f\u0432\u0456\u043b\u0430\u0441\u044f \u043b\u044e\u0431\u043e\u045e, \u0448\u0442\u043e \u043d\u0435 \u043c\u044b \u043f\u0430\u043b\u044e\u0431\u0456\u043b\u0456 \u0411\u043e\u0433\u0430, \u0430 \u0401\u043d \u0441\u0430\u043c \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0421\u044b\u043d\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u044f\u043a \u0443\u043c\u0456\u043b\u0430\u0441\u0446\u0456\u045e\u043b\u0435\u043d\u043d\u0435 \u0437\u0430 \u0433\u0440\u0430\u0445\u0456 \u043d\u0430\u0448\u044b\u044f. \u041a\u0430\u043b\u0456 \u0411\u043e\u0433 \u0442\u0430\u043a \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441, \u0434\u044b\u043a \u0456 \u043c\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0436\u0430, \u0430\u0431\u0430\u0440\u043e\u043d\u0430 \u043d\u0430\u0448\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u044