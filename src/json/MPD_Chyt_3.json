c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u0430\u0441\u0442\u0430\u043d\u044c\u0441\u044f \u0437 \u043d\u0430\u043c\u0456, \u041f\u0430\u043d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u045e\u0436\u043e \u0432\u0435\u0447\u0430\u0440\u044d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"5073","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u041a\u043b\u0441 3, 1-2<\/span><br \/>\u041a\u0430\u043b\u0456 \u0436 \u0432\u044b \u045e\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043b\u0456 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u043c, \u0448\u0443\u043a\u0430\u0439\u0446\u0435 \u0442\u0430\u0433\u043e, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0437\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0411\u043e\u0433\u0430; \u043f\u0440\u0430 \u0442\u043e\u0435, \u0448\u0442\u043e \u045e \u0432\u044b\u0448\u044b\u043d\u044f\u0445, \u0434\u0443\u043c\u0430\u0439\u0446\u0435, \u0430 \u043d\u0435 \u043f\u0440\u0430 \u0437\u044f\u043c\u043d\u043e\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0417\u0430\u0441\u0442\u0430\u043d\u044c\u0441\u044f \u0437 \u043d\u0430\u043c\u0456, \u041f\u0430\u043d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e \u045e\u0436\u043e \u0432\u0435\u0447\u0430\u0440\u044d\u0435, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"5074","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u04