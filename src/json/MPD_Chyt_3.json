r \/><span style=\"color: #ff0000;\">\u041d.\u2005<\/span>\u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u0447\u0443\u0435\u0446\u0446\u0430 \u0433\u043e\u043b\u0430\u0441 \u042f\u0433\u043e\u043d\u0430\u0439 \u0445\u0432\u0430\u043b\u044b.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"473","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0430\u0440\u043e\u0442\u043a\u0430\u0435 \u0447\u044b\u0442\u0430\u043d\u043d\u0435 \u0406\u0441 49, 6<\/span><br \/>\u041f\u0430\u043d \u0441\u043a\u0430\u0437\u0430\u045e \u043c\u043d\u0435: \u0422\u0430\u0433\u043e \u043c\u0430\u043b\u0430, \u043a\u0430\u0431 \u0442\u044b \u0431\u044b\u045e \u0441\u043b\u0443\u0433\u043e\u0439 \u041c\u0430\u0456\u043c, \u043a\u0430\u0431 \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430 \u042f\u043a\u0443\u0431\u0430, \u043a\u0430\u0431 \u0432\u044f\u0440\u043d\u0443\u045e \u0440\u044d\u0448\u0442\u0443 \u0406\u0437\u0440\u0430\u044d\u043b\u044f. \u042f \u0437\u0440\u0430\u0431\u043b\u044e \u0446\u044f\u0431\u0435 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u045e, \u043a\u0430\u0431 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u041c\u0430\u0451 \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0430 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span>\u2005\u041f\u0430\u0448\u043b\u044e \u0414\u0443\u0445\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430 \u042f\u0433\u043e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span>\u2005\u0406 \u0401\u043d \u0430\u0431\u0432\u0435\u0441\u0446\u0456\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u043f\u0440\u044b\u0441\u0443\u0434.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"504","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u043f\u0430\u0440. \u0414\u0430\u043d 4, 24b<\/span><br \/>\u0410\u0434\u043a\u0443\u043f\u0456 \u0441\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0430 \u0441\u0432\u0430\u0451 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 &ndash; \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e \u0434\u0430 \u045e\u0431\u043e\u0433\u0456\u0445; \u0432\u043e\u0441\u044c \u0442\u0430\u0434\u044b \u0442\u0432\u043e\u0439 \u0441\u043f\u0430\u043a\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044b\u0432\u0430\u043b\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0445\u0432\u044f\u0440\u0430 \u0411\u043e\u0433\u0443 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b \u0434\u0443\u0445. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439, \u0411\u043e\u0436\u0430, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"505","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415<\/span> <span style=\"color: #ff0000;\">\u0413\u0431\u0440 10, 35-36<\/span><br \/>\u041d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439\u0446\u0435 \u0430\u0434\u0432\u0430\u0433\u0456 \u0432\u0430\u0448\u0430\u0439, \u044f\u043a\u0430\u044f \u043c\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443. \u0410 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430 \u0