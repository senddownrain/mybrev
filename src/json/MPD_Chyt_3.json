434\u043e\u043b\u0456, \u043a\u0430\u043b\u0456 \u0446\u044f\u0431\u0435 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0441\u043f\u0430\u0442\u043a\u0430\u0435 \u045e \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456, \u0442\u043e \u0437\u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u042f\u0433\u043e\u043d\u044b. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, &ndash; \u0411\u043e\u0433 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b, \u0401\u043d \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435 \u0446\u044f\u0431\u0435, \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0456 \u043d\u0435 \u0437\u0430\u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u044f\u043a\u0456\u043c \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0442\u0432\u0430\u0456\u043c \u043f\u0440\u043e\u0434\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0445\u0432\u044f\u0440\u0430 \u0411\u043e\u0433\u0443 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b \u0434\u0443\u0445. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439, \u0411\u043e\u0436\u0430, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"532","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0406\u0441 58, 6\u0430. 7<\/span><br \/>\u0426\u0456 \u0436 \u043d\u0435 \u0442\u0430\u043a\u0456 \u0451\u0441\u0446\u044c \u043f\u043e\u0441\u0442, \u044f\u043a\u0456 \u042f \u0432\u044b\u0431\u0440\u0430\u045e: \u0434\u0437\u044f\u043b\u0456\u0446\u0446\u0430 \u0437 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u043c \u0445\u043b\u0435\u0431\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u043f\u0443\u0441\u043a\u0430\u0446\u044c \u0443 \u0434\u043e\u043c \u0431\u0435\u0434\u043d\u044b\u0445 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0430\u045e; \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u044c \u0433\u043e\u043b\u0430\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u045e\u0431\u0430\u0447\u044b\u0448, \u0456 \u0430\u0434 \u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u0445\u0430\u0432\u0430\u0446\u0446\u0430?<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0445\u0432\u044f\u0440\u0430 \u0411\u043e\u0433\u0443 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b \u0434\u0443\u0445. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439, \u0411\u043e\u0436\u0430, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"533","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0406\u0441 58, 1-2\u0430<\/span><br \/>\u041a\u0440\u044b\u0447\u044b \u043d\u0430 \u045e\u0441\u044e \u043c\u043e\u0446, \u043d\u0435 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439\u0441\u044f. \u041f\u0430\u0434\u044b\u043c\u0456 \u0433\u043e\u043b\u0430\u0441 \u0441\u0432\u043e\u0439, \u0431\u044b\u0446\u0446\u0430\u043c \u0440\u043e\u0433, \u0456 \u0440\u0430\u0441\u043a\u0430\u0436\u044b \u043d\u0430\u0440\u043e\u0434\u0443 \u041c\u0430\u0439\u043c\u0443 \u043f\u0440\u0430 \u044f\u0433\u043e \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b \u0456 \u0434\u043e\u043c\u0443 \u042f\u043a\u0443\u0431\u0430 \u043f\u0440\u0430 \u044f\u0433\u043e \u0433\u0440\u0430\u0445\u0456. \u0417 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u044f\u043d\u044b \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u041c\u044f\u043d\u0435 \u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0448\u043b\u044f\u0445\u0456 \u041c\u0430\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0437\u0430\u043a\u043e\u043d\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0445\u0432\u044f\u0440\u0430 \u0411\u043e\u0433\u0443 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b \u0434\u0443\u0445. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439, \u0411\u043e\u0436\u0430, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"534","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u043f\u0430\u0440. \u0414\u0430\u043d 4, 24b<\/span><br \/>\u0410\u0434\u043a\u0443\u043f\u0456 \u0441\u0432\u0430\u0435 \u0433\u0440\u0430\u0445\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u044e, \u0430 \u0441\u0432\u0430\u0451 \u0431\u0435\u0437\u0437\u0430\u043a\u043e\u043d\u043d\u0435 &ndash; \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044e \u0434\u0430 \u045e\u0431\u043e\u0433\u0456\u0445; \u0432\u043e\u0441\u044c \u0442\u0430\u0434\u044b \u0442\u0432\u043e\u0439 \u0441\u043f\u0430\u043a\u043e\u0439 \u0431\u0443\u0434\u0437\u0435 \u0442\u0440\u044b\u0432\u0430\u043b\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0445\u0432\u044f\u0440\u0430 \u0411\u043e\u0433\u0443 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b \u0434\u0443\u0445. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439, \u0411\u043e\u0436\u0430, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"535","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0413\u0431\u0440 10, 35-36<\/span><br \/>\u041d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439\u0446\u0435 \u0430\u0434\u0432\u0430\u0433\u0456 \u0432\u0430\u0448\u0430\u0439, \u044f\u043a\u0430\u044f \u043c\u0430\u0435 \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443. \u0410 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043f\u0430\u0442\u0440\u044d\u0431\u043d\u0430 \u0432\u0430\u043c, \u043a\u0430\u0431, \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0447\u044b \u0432\u043e\u043b\u044e \u0411\u043e\u0436\u0443\u044e, \u0432\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0430\u0431\u044f\u0446\u0430\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0445\u0432\u044f\u0440\u0430 \u0411\u043e\u0433\u0443 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b \u0434\u0443\u0445. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439, \u0411\u043e\u0436\u0430, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"536","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u042f\u043a 1, 27<\/span><br \/>\u0427\u044b\u0441\u0442\u0430\u044f \u0456 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u044f \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u0411\u043e\u0433\u0430\u043c \u0456 \u0410\u0439\u0446\u043e\u043c &ndash; \u0433\u044d\u0442\u0430 \u043d\u0430\u0432\u0435\u0434\u0432\u0430\u043d\u043d\u0435 \u0441\u0456\u0440\u043e\u0442\u0430\u045e \u0456 \u045e\u0434\u043e\u0432\u0430\u045e \u0443 \u043d\u044f\u0434\u043e\u043b\u0456 \u0456\u0445\u043d\u044f\u0439 \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0441\u044f\u0431\u0435 \u043d\u0435\u0437\u0430\u043f\u043b\u044f\u043c\u043b\u0435\u043d\u044b\u043c \u0441\u0432\u0435\u0442\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0445\u0432\u044f\u0440\u0430 \u0411\u043e\u0433\u0443 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b \u0434\u0443\u0445. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439, \u0411\u043e\u0436\u0430, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"537","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0413\u0430\u043b 6, 7b-8<\/span><br \/>\u0411\u043e\u0433 \u043d\u0435 \u0434\u0430\u0437\u0432\u043e\u043b\u0456\u0446\u044c \u043d\u0430\u0441\u043c\u0456\u0445\u0430\u0446\u0446\u0430 \u0437 \u0441\u044f\u0431\u0435; \u0431\u043e \u0448\u0442\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u043a \u043f\u0430\u0441\u0435\u0435, \u0442\u043e\u0435 \u0456 \u043f\u0430\u0436\u043d\u0435. \u0425\u0442\u043e \u0441\u0435\u0435 \u045e \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435, \u0442\u043e\u0439 \u0437 \u0446\u0435\u043b\u0430 \u043f\u0430\u0436\u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044d\u043d\u043d\u0435, \u0430 \u0445\u0442\u043e \u0441\u0435\u0435 \u045e \u0434\u0443\u0445\u0443, \u0442\u043e\u0439 \u0437 \u0434\u0443\u0445\u0430 \u043f\u0430\u0436\u043d\u0435 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0445\u0432\u044f\u0440\u0430 \u0411\u043e\u0433\u0443 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b \u0434\u0443\u0445. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439, \u0411\u043e\u0436\u0430, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"541","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0414\u0440\u0433 4, 29-31<\/span><br \/>\u0422\u0430\u0434\u044b \u0431\u0443\u0434\u0437\u0435\u0448 \u0448\u0443\u043a\u0430\u0446\u044c \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0456 \u0437\u043d\u043e\u0439\u0434\u0437\u0435\u0448 \u042f\u0433\u043e, \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0456\u043c\u043a\u043d\u0443\u0446\u0446\u0430 \u0434\u0430 \u042f\u0433\u043e \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0456 \u045e\u0441\u0451\u0439 \u0434\u0443\u0448\u043e\u0439. \u041a\u0430\u043b\u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0443 \u043d\u044f\u0434\u043e\u043b\u0456, \u043a\u0430\u043b\u0456 \u0446\u044f\u0431\u0435 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0441\u043f\u0430\u0442\u043a\u0430\u0435 \u045e \u0430\u043f\u043e\u0448\u043d\u0456\u044f \u0434\u043d\u0456, \u0442\u043e \u0437\u0432\u0435\u0440\u043d\u0435\u0448\u0441\u044f \u0434\u0430 \u041f\u0430\u043d\u0430, \u0411\u043e\u0433\u0430 \u0442\u0432\u0430\u0439\u0433\u043e, \u0456 \u0431\u0443\u0434\u0437\u0435\u0448 \u0441\u043b\u0443\u0445\u0430\u0446\u044c \u0433\u043e\u043b\u0430\u0441 \u042f\u0433\u043e\u043d\u044b. \u041f\u0430\u043a\u043e\u043b\u044c\u043a\u0456 \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, &ndash; \u0411\u043e\u0433 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b, \u0401\u043d \u043d\u0435 \u043f\u0430\u043a\u0456\u043d\u0435 \u0446\u044f\u0431\u0435, \u043d\u0435 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0456 \u043d\u0435 \u0437\u0430\u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430 \u0437\u0430\u043f\u0430\u0432\u0435\u0442, \u044f\u043a\u0456\u043c \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u0442\u0432\u0430\u0456\u043c \u043f\u0440\u043e\u0434\u043a\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0445\u0432\u044f\u0440\u0430 \u0411\u043e\u0433\u0443 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b \u0434\u0443\u0445. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439, \u0411\u043e\u0436\u0430, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"542","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0406\u0441 58, 6\u0430. 7<\/span><br \/>\u0426\u0456 \u0436 \u043d\u0435 \u0442\u0430\u043a\u0456 \u0451\u0441\u0446\u044c \u043f\u043e\u0441\u0442, \u044f\u043a\u0456 \u042f \u0432\u044b\u0431\u0440\u0430\u045e: \u0434\u0437\u044f\u043b\u0456\u0446\u0446\u0430 \u0437 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u043c \u0445\u043b\u0435\u0431\u0430\u043c \u0441\u0432\u0430\u0456\u043c, \u043f\u0443\u0441\u043a\u0430\u0446\u044c \u0443 \u0434\u043e\u043c \u0431\u0435\u0434\u043d\u044b\u0445 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043d\u0456\u043a\u0430\u045e; \u0430\u043f\u0440\u0430\u043d\u0443\u0446\u044c \u0433\u043e\u043b\u0430\u0433\u0430, \u044f\u043a\u043e\u0433\u0430 \u045e\u0431\u0430\u0447\u044b\u0448, \u0456 \u0430\u0434 \u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0435 \u0445\u0430\u0432\u0430\u0446\u0446\u0430?<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0445\u0432\u044f\u0440\u0430 \u0411\u043e\u0433\u0443 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b \u0434\u0443\u0445. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439, \u0411\u043e\u0436\u0430, \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u043c \u0456 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c.<\/p>\r\n"}, {"MPD_Chyt_3_ID":"543","MPD_Chyt_3_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0406\u0441 58, 1-2\u0430<\/span><br \/>\u041a\u0440\u044b\u0447\u044b \u043d\u0430 \u045e\u0441\u044e \u043c\u043e\u0446, \u043d\u0435 \u0441\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439\u0441\u044f. \u041f\u0430\u0434\u044b\u043c\u0456 \u0433\u043e\u043b\u0430\u0441 \u0441\u0432\u043e\u0439, \u0431\u044b\u0446\u0446\u0430\u043c \u0440\u043e\u0433, \u0456 \u0440\u0430\u0441\u043a\u0430\u0436\u044b \u043d\u0430\u0440\u043e\u0434\u0443 \u041c\u0430\u0439\u043c\u0443 \u043f\u0440\u0430 \u044f\u0433\u043e \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b \u0456 \u0434\u043e\u043c\u0443 \u042f\u043a\u0443\u0431\u0430 \u043f\u0440\u0430 \u044f\u0433\u043e \u0433\u0440\u0430\u0445\u0456. \u0417 \u0434\u043d\u044f \u045e \u0434\u0437\u0435\u043d\u044c \u044f\u043d\u044b \u0448\u0443\u043a\u0430\u044e\u0446\u044c \u041c\u044f\u043d\u0435 \u0456 \u043f\u0440\u0430\u0433\u043d\u0443\u0446\u044c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0448\u043b\u044f\u0445\u0456 \u041c\u0430\u0435, \u0431\u044b\u0446\u0446\u0430\u043c \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u043f\u0430\u0441\u0442\u0443\u043f\u0430\u0435 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0435 \u0437\u0430\u043a\u043e\u043d\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0445\u0432\u044f\u0440\u0430 \u0411\u043e\u0433\u0443 &ndash; \u0433\u044d\u0442\u0430 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u044b \u0434\u0443\u0445. <br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0435 \u043f\u0430\u0433\u0430\u0440\u0434\u0436\u0430\u0439, \u0411\u043e\u0436\u0430, \u043f\u0430\u043a\u043e\u