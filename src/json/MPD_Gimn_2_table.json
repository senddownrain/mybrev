0434 \u0441\u043c\u0435\u0440\u0446\u044e \u0441\u0432\u0430\u0451\u044e<br \/>\u0422\u044b \u0434\u0430\u045e \u043d\u0430\u043c \u041c\u0430\u0446\u0456 \u0421\u0432\u044f\u0442\u0443\u044e,<br \/>\u041a\u0430\u0431 \u0437 \u0442\u044b\u043c\u0456, \u0445\u0442\u043e \u043f\u0430\u043c\u0456\u0440\u0430\u0435,<br \/>\u042f\u043d\u0430 \u0431\u044b\u043b\u0430 \u045e \u0447\u0430\u0441 \u043a\u0430\u043d\u0430\u043d\u043d\u044f.<\/p>\r\n<p>\u0414\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u043d\u0430\u043c, \u043e \u041f\u0430\u043d\u0435,<br \/>\u0421\u0443\u043c \u043f\u0435\u0440\u0430\u0430\u0434\u043e\u043b\u0435\u0446\u044c \u043d\u0430\u0434\u0437\u0435\u044f\u0439.<br \/>\u041a\u0440\u043e\u045e \u0422\u0432\u0430\u044f \u043d\u0430\u0441 \u0430\u0434\u043a\u0443\u043f\u0456\u043b\u0430,<br \/>\u0422\u0430\u043c\u0443 \u043c\u0430\u0435\u043c \u0432\u0435\u0447\u043d\u0443\u044e \u0440\u0430\u0434\u0430\u0441\u0446\u044c.<\/p>\r\n<p>\u0421\u044f\u0441\u0442\u0440\u0443 \u043f\u0430\u043a\u043b\u0456\u0447 \u0422\u044b, \u043e \u0411\u043e\u0436\u0430,<br \/>\u0428\u0442\u043e \u0433\u044d\u0442\u044b \u0441\u0432\u0435\u0442 \u043f\u0430\u043a\u0456\u0434\u0430\u0435.<br \/>\u041d\u044f\u0445\u0430\u0439 \u0443 \u0436\u044b\u0446\u0446\u044f \u043a\u0440\u0430\u0456\u043d\u0435<br \/>\u0426\u044f\u0431\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435 \u0432\u0435\u0447\u043d\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"MPD_Gimn_2_ID":"9253","MPD_Gimn_2_Text":"\r\n<p>\u041f\u0430\u043d\u0435, \u0422\u044b \u043f\u043b\u0430\u043a\u0430\u045e \u043d\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e<br \/>\u0420\u0430\u0437\u0430\u043c \u0437 \u0441\u0451\u0441\u0442\u0440\u0430\u043c\u0456 \u041b\u0430\u0437\u0430\u0440\u0430<br \/>\u0406 \u045e\u0447\u044b\u043d\u0456\u045e \u0437 \u0411\u043e\u0436\u0430\u0439 \u043c\u043e\u0446\u0430\u044e,<br \/>\u0428\u0442\u043e \u0451\u043d \u0436\u044b\u0432\u044b \u0432\u044b\u0439\u0448\u0430\u045