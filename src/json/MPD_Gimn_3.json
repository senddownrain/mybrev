[{"MPD_Gimn_3_ID":"41","MPD_Gimn_3_Text":"\r\n<p>\u0411\u043e\u0436\u0430 \u043c\u043e\u0446\u043d\u044b, \u0443\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435<br \/>\u0423 \u0422\u0432\u0430\u0456\u0445 \u0440\u0443\u043a\u0430\u0445 \u0442\u0440\u044b\u0432\u0430\u0435.<br \/>\u0414\u0437\u0451\u043d\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430 \u0433\u0430\u0434\u0437\u0456\u043d\u0430\u045e<br \/>\u0422\u044b \u043f\u0430\u0440\u0430\u0434\u0430\u043a \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u0435\u0448.<\/p>\r\n<p>\u0412\u0435\u0447\u0430\u0440 \u043d\u0430\u0448 \u043d\u0430\u043f\u043e\u045e\u043d\u0456 \u0437\u0437\u044f\u043d\u043d\u0435\u043c,<br \/>\u041a\u0430\u0431 \u0441\u0432\u044f\u0442\u043b\u043e \u0436\u044b\u0446\u0446\u044f \u043d\u0435 \u0437\u0433\u0430\u0441\u043b\u0430,<br \/>\u0406 \u043f\u0430\u0441\u043b\u044f \u0437\u044f\u043c\u043d\u043e\u0439 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043a\u0456<br \/>\u041c\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p>\u0414\u0430\u0439 \u043d\u0430\u043c \u0433\u044d\u0442\u0430, \u0434\u043e\u0431\u0440\u044b \u041e\u0439\u0447\u0430, <br \/>\u0423 \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0435 \u0437 \u0422\u0432\u0430\u0456\u043c \u0421\u044b\u043d\u0430\u043c,<br \/>\u0420\u0430\u0437\u0430\u043c \u0437 \u0414\u0443\u0445\u0430\u043c \u0421\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f,<br \/>\u0422\u044b, \u0448\u0442\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0448 \u0432\u0435\u0447\u043d\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"MPD_Gimn_3_ID":"42","MPD_Gimn_3_Text":"\r\n<p>\u041c\u0456\u043d\u0430\u0435 \u045e\u0436\u043e \u0434\u0437\u0435\u0432\u044f\u0442\u0430\u044f \u0433\u0430\u0434\u0437\u0456\u043d\u0430,<br \/>\u0442\u0430\u043c\u0443 \u0437 \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0441\u043f\u044f\u0432\u0430\u0439\u043c\u0430 \u041f\u0430\u043d\u0443. <br \/>\u0417 \u0430\u0434\u0434\u0430\u043d\u0430\u044e \u0434\u0443\u0448\u043e\u044e, \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c <br \/>\u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043c \u0411\u043e\u0433\u0430 \u045e \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0422\u0440\u043e\u0439\u0446\u044b.<\/p>\r\n<p>\u041f\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u0441\u0432\u044f\u0442\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443,<br \/>\u044f\u0435 \u045e \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u0435\u043c.<br \/>\u042f\u0435 \u0430\u0434\u043a\u0440\u044b\u045e \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u041f\u0451\u0442\u0440 \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 <br \/>\u043f\u0440\u0430\u0437 \u0446\u0443\u0434\u044b &ndash; \u0437\u043d\u0430\u043a \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u043c \u0430\u0434 \u041f\u0430\u043d\u0430.<\/p>\r\n<p>\u0422\u0430\u043c\u0443 \u0434\u0430\u043b\u0443\u0447\u044b\u043c \u0440\u043e\u0437\u0443\u043c \u0441\u0432\u043e\u0439 \u0456 \u0432\u043e\u043b\u044e <br \/>\u0434\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u0456 \u0434\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f<br \/>\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0448\u0442\u043e \u045e \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430<br \/>\u0432\u044f\u0434\u0443\u0446\u044c \u043d\u0430\u0441 \u042f\u0433\u043e \u043c\u043e\u0446\u0430\u0439 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p>\u041d\u044f\u0445\u0430\u0439 \u0422\u0430\u0431\u0435, \u043e \u0425\u0440\u044b\u0441\u0442\u044d \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u044b<br \/>\u0406 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443 \u043a\u043e\u0436\u043d\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f,<br \/>\u0420\u0430\u0437\u0430\u043c \u0437 \u0410\u0439\u0446\u043e\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f<br \/>\u0425\u0432\u0430\u043b\u0430 \u0433\u0443\u0447\u044b\u0446\u044c \u0443\u0441\u044e\u0434\u044b \u0456 \u043d\u0430\u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"MPD_Gimn_3_ID":"43","MPD_Gimn_3_Text":"\r\n<p>\u0411\u043e\u0436\u0430 \u043c\u043e\u0446\u043d\u044b, \u045e\u0441\u0451 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435<br \/>\u0423 \u0422\u0432\u0430\u0456\u0445 \u0440\u0443\u043a\u0430\u0445 \u0442\u0440\u044b\u0432\u0430\u0435.<br \/>\u0414\u0437\u0451\u043d\u043d\u0430\u0433\u0430 \u0441\u0432\u044f\u0442\u043b\u0430 \u0433\u0430\u0434\u0437\u0456\u043d\u0430\u045e<br \/>\u0422\u044b \u043f\u0430\u0440\u0430\u0434\u0430\u043a \u0432\u044b\u0437\u043d\u0430\u0447\u0430\u0435\u0448.<\/p>\r\n<p>\u0412\u0435\u0447\u0430\u0440 \u043d\u0430\u0448 \u043d\u0430\u043f\u043e\u045e\u043d\u0456 \u0437\u0437\u044f\u043d\u043d\u0435\u043c,<br \/>\u041a\u0430\u0431 \u0441\u0432\u044f\u0442\u043b\u043e \u0436\u044b\u0446\u0446\u044f \u043d\u0435 \u0437\u0433\u0430\u0441\u043b\u0430,<br \/>\u0406 \u043f\u0430\u0441\u043b\u044f \u0437\u044f\u043c\u043d\u043e\u0439 \u0432\u0430\u043d\u0434\u0440\u043e\u045e\u043a\u0456<br \/>\u041c\u044b \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p>\u0414\u0430\u0439 \u043d\u0430\u043c \u0433\u044d\u0442\u0430, \u0434\u043e\u0431\u0440\u044b \u041e\u0439\u0447\u0430, <br \/>\u0423 \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0435 \u0437 \u0422\u0432\u0430\u0456\u043c \u0421\u044b\u043d\u0430\u043c,<br \/>\u0420\u0430\u0437\u0430\u043c \u0437 \u0414\u0443\u0445\u0430\u043c \u0421\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u044f,<br \/>\u0422\u044b, \u0448\u0442\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0448 \u0432\u0435\u0447\u043d\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"MPD_Gimn_3_ID":"46","MPD_Gimn_3_Text":"\r\n<p>\u041c\u0456\u043d\u0430\u0435 \u045e\u0436\u043e \u0434\u0437\u0435\u0432\u044f\u0442\u0430\u044f \u0433\u0430\u0434\u0437\u0456\u043d\u0430,<br \/>\u0422\u0430\u043c\u0443 \u0437 \u043f\u0430\u043a\u043e\u0440\u0430\u044e \u0441\u043f\u044f\u0432\u0430\u0439\u043c\u0430 \u041f\u0430\u043d\u0443. <br \/>\u0417 \u0430\u0434\u0434\u0430\u043d\u0430\u044e \u0434\u0443\u0448\u043e\u044e, \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c <br \/>\u041f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u043c \u0411\u043e\u0433\u0430 \u045e \u041d\u0430\u0439\u0441\u0432\u044f\u0446\u0435\u0439\u0448\u0430\u0439 \u0422\u0440\u043e\u0439\u0446\u044b.<\/p>\r\n<p>\u0422\u0440\u044b\u043c\u0430\u044e\u0447\u044b \u0441\u0432\u044f\u0442\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443,<br \/>\u042f\u0435 \u045e \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u044b \u0437\u0430\u0445\u0430\u0432\u0430\u0435\u043c.<br \/>\u042f\u0435 \u0430\u0434\u043a\u0440\u044b\u045e \u0434\u043b\u044f \u045e\u0441\u0456\u0445 \u041f\u0451\u0442\u0440 \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u0456 <br \/>\u041f\u0440\u0430\u0437 \u0446\u0443\u0434\u044b &ndash; \u0437\u043d\u0430\u043a \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u043c \u0430\u0434 \u041f\u0430\u043d\u0430.<\/p>\r\n<p>\u0422\u0430\u043c\u0443 \u0434\u0430\u043b\u0443\u0447\u044b\u043c \u0440\u043e\u0437\u0443\u043c \u0441\u0432\u043e\u0439 \u0456 \u0432\u043e\u043b\u044e <br \/>\u0414\u0430 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f \u0456 \u0432\u0435\u0440\u043d\u0430\u0433\u0430 \u0432\u0443\u0447\u044d\u043d\u043d\u044f<br \/>\u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e, \u0448\u0442\u043e \u045e \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430<br \/>\u0412\u044f\u0434\u0443\u0446\u044c \u043d\u0430\u0441 \u042f\u0433\u043e \u043c\u043e\u0446\u0430\u0439 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p>\u0422\u0430\u0431\u0435, \u043d\u0430\u0448 \u043d\u0430\u0439\u043c\u0456\u043b\u0435\u0439\u0448\u044b \u0425\u0440\u044b\u0441\u0442\u044d, \u041f\u0430\u043d\u0435,<br \/>\u0406 \u0432\u0435\u0447\u043d\u044b \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443 \u045e\u0441\u0456\u0445 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f\u045e,<br \/>\u0417 \u0410\u0439\u0446\u043e\u043c \u0456 \u0414\u0443\u0445\u0430\u043c \u0440\u0430\u0437\u0430\u043c \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435,<br \/>\u0425\u0432\u0430\u043b\u0430 \u043d\u0430\u0432\u0435\u043a\u0456 \u0456 \u043f\u0430\u0448\u0430\u043d\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"MPD_Gimn_3_ID":"501","MPD_Gimn_3_Text":"\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0441\u043f\u0430\u0447\u0430\u043b\u0430\u0441\u044f \u0441\u0432\u044f\u0442\u0430\u044f \u0433\u0430\u0434\u0437\u0456\u043d\u0430,<br \/>\u0417\u0431\u0430\u045e\u0446\u0430 \u044f\u0435 \u0430\u0441\u0432\u044f\u0446\u0456\u045e \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u044e;<br \/>\u041c\u044b, \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u044e\u0447\u044b \u0456\u043c\u044f \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430,<br \/>\u041f\u0440\u043e\u0441\u0456\u043c \u043f\u0430\u043a\u043e\u0440\u043d\u0430 \u0430\u0431 \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0443 \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u043f\u0440\u0430\u0431\u0430\u0447\u044b\u045e,<br \/>\u0423\u0437\u0440\u0443\u0448\u0430\u043d\u044b \u0448\u0447\u044b\u0440\u044b\u043c \u044f\u0433\u043e\u043d\u044b\u043c \u0432\u044b\u0437\u043d\u0430\u043d\u043d\u0435\u043c.<br \/>\u0425\u0430\u0439 \u0436\u0430 \u0456 \u043d\u0430\u0448\u0430 \u0430\u0445\u0432\u044f\u0440\u043d\u0430\u0441\u0446\u044c, \u043c\u0430\u043b\u0456\u0442\u0432\u044b<br \/>\u0412\u044b\u043f\u0440\u0430\u0441\u044f\u0446\u044c \u043d\u0430\u043c \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u0435 \u043f\u0440\u0430\u0432\u0456\u043d\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u043a\u0440\u044b\u0436\u0430\u043c \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0446\u0435\u043c\u0440\u0443;<br \/>\u0417\u043c\u0440\u043e\u043a \u0430\u0434\u044b\u0448\u043e\u045e, \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u045e\u0436\u043e \u0437\u0430\u0437\u0437\u044f\u043b\u0430.<br \/>\u0416\u0443\u0434\u0430\u0441\u043d\u044b \u0433\u0440\u044d\u0445 \u043d\u044f\u0445\u0430\u0439 \u0437\u043d\u0456\u0448\u0447\u0430\u043d\u044b \u0431\u0443\u0434\u0437\u0435,<br \/>\u0410 \u0447\u044b\u0441\u0442\u044b \u0431\u043b\u044f\u0441\u043a \u043d\u0430\u0448\u044b \u0434\u0443\u0448\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u0410\u0439\u0446\u0430 \u0440\u0430\u0437\u0430\u043c \u0437 \u0414\u0443\u0445\u0430\u043c &ndash;<br \/>\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u0443\u044e \u0422\u0440\u043e\u0439\u0446\u0443 \u0421\u0432\u044f\u0442\u0443\u044e,<br \/>\u041a\u0430\u0431 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u043b\u0430 \u045e\u0441\u0456\u0445 \u0411\u043e\u0436\u0430\u044e \u043b\u0430\u0441\u043a\u0430\u0439,<br \/>\u0425\u0442\u043e \u045e \u043c\u0430\u043b\u0456\u0442\u0432\u0435 \u0441\u0442\u0430\u0456\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"MPD_Gimn_3_ID":"561","MPD_Gimn_3_Text":"\r\n<p style=\"text-align: justify;\">\u0412\u0435\u0440\u043d\u044b \u0441\u0443\u0441\u0432\u0435\u0442 \u0445\u0430\u0439 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c<br \/>\u0420\u0430\u0434\u0430\u0441\u0446\u044c \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430.<br \/>\u0412\u0435\u0447\u043d\u044b \u040e\u043b\u0430\u0434\u0430\u0440, \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c \u043d\u0430\u0448<br \/>\u0417\u043d\u0456\u0448\u0447\u044b\u045e \u0443\u043b\u0430\u0434\u044b \u043f\u044f\u043a\u0435\u043b\u044c\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0442\u043e\u045e\u043f, \u0425\u0440\u044b\u0441\u0442\u0430 \u0441\u0443\u0441\u0442\u0440\u0430\u043a\u0430\u044e\u0447\u044b,<br \/>\u0421\u0446\u0435\u043b\u0456\u0446\u044c \u0433\u0430\u043b\u0456\u043d\u044b \u043f\u0430\u043b\u044c\u043c\u043e\u0432\u044b\u044f;<br \/>\u0413\u0440\u043e\u043d\u043a\u0456 \u0430\u043b\u0456\u045e\u043a\u0430\u045e \u043f\u0430\u0434 \u043d\u043e\u0433\u0456<br \/>\u0421\u044b\u043d\u0443 \u0414\u0430\u0432\u0456\u0434\u0430 \u043a\u0456\u0434\u0430\u044e\u0447\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u044b\u043a \u043f\u0430\u0431\u044f\u0436\u044b\u043c \u043c\u044b \u0442\u0430\u043a\u0441\u0430\u043c\u0430<br \/>\u0421\u0443\u0441\u0442\u0440\u044d\u0446\u044c \u040e\u043b\u0430\u0434\u0430\u0440\u0430 \u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u0430\u0433\u0430.<br \/>\u0417 \u043f\u0435\u0441\u043d\u044f\u0439 \u0445\u0432\u0430\u043b\u044b \u043f\u0430\u043b\u044c\u043c\u044b \u0440\u0430\u0434\u0430\u0441\u0446\u0456<br \/>\u041a\u0456\u043d\u0435\u043c \u043f\u0430\u0434 \u043d\u043e\u0433\u0456 \u0421\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0430\u0456\u0445 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e<br \/>\u040e\u043c\u0430\u0446\u0443\u0435 \u0434\u0430\u0440\u0430\u043c\u0456 \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u043c\u0456,<br \/>\u041a\u0430\u0431 \u043c\u044b, \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0448\u044b \u045e\u0441\u0435 \u0446\u044f\u0436\u043a\u0430\u0441\u0446\u0456,<br \/>\u0417\u0431\u0430\u0432\u0456\u0446\u0435\u043b\u044e \u045e\u0434\u0437\u044f\u0447\u043d\u0430\u0441\u0446\u044c \u0437\u0430\u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0433\u0443 \u0410\u0439\u0446\u0443 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435<br \/>\u0425\u0432\u0430\u043b\u0430 \u0439 \u043f\u0430\u0448\u0430\u043d\u0430 \u045e \u0441\u0432\u0435\u0446\u0435<br \/>\u0417 \u0421\u044b\u043d\u0430\u043c \u042f\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u044b\u043c<br \/>\u0406 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u043d\u0430\u0432\u0435\u043a\u0456. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"MPD_Gimn_3_ID":"566","MPD_Gimn_3_Text":"\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d, \u0426\u044f\u0431\u0435 \u043c\u044b \u043f\u0440\u043e\u0441\u0456\u043c<br \/>\u041f\u0440\u0430\u0437 \u043a\u0440\u044b\u0436 \u0434\u0430\u0439 \u0436\u044b\u0446\u0446\u0451 \u0441\u0432\u0435\u0442\u0443<br \/>\u0406 \u045e\u0441\u0456\u043c, \u043a\u0430\u0433\u043e \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0422\u044b,<br \/>\u041a\u0430\u043b\u0456 \u0431\u044b\u045e \u0434\u0430 \u0434\u0440\u044d\u0432\u0430 \u043f\u0440\u044b\u0431\u0456\u0442\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u043a\u043e\u043d \u0422\u0432\u043e\u0439 \u0437\u043d\u0456\u0448\u0447\u0430\u0435 \u0434\u043e\u045e\u0433 \u0441\u0432\u0435\u0442\u0443,<br \/>\u040e \u0456\u043c \u0433\u0456\u043d\u0435 \u0434\u0430\u045e\u043d\u044f\u0435 \u0440\u0430\u0431\u0441\u0442\u0432\u0430,<br \/>\u0412\u044f\u0440\u0442\u0430\u0435\u0446\u0446\u0430 \u0437\u043d\u043e\u045e \u0441\u0432\u0430\u0431\u043e\u0434\u0430<br \/>\u0421\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0433\u0430 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0431\u0435, \u0415\u0437\u0443 \u043d\u0430\u0448 \u0417\u0431\u0430\u0432\u0456\u0446\u0435\u043b\u044c,<br \/>\u0425\u0432\u0430\u043b\u0430 \u043d\u044f\u0445\u0430\u0439 \u0432\u0435\u0447\u043d\u0430\u044f \u0431\u0443\u0434\u0437\u0435<br \/>\u0417\u0430 \u0434\u0430\u0440 \u0422\u0432\u043e\u0439 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u044b \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f,<br \/>\u0417\u0430 \u043c\u043e\u0446, \u0448\u0442\u043e \u0437 \u043a\u0440\u044b\u0436\u0430 \u043c\u044b \u043c\u0430\u0435\u043c. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"MPD_Gimn_3_ID":"5011","MPD_Gimn_3_Text":"\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0431\u043b\u044f\u0441\u043a\u0430\u043c \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u0433\u0430\u0434\u0437\u0456\u043d\u0430,<br \/>\u0428\u0442\u043e \u043a\u0440\u044b\u0436\u0430 \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0430 \u0446\u0435\u043c\u0440\u0443,<br \/>\u0417\u044f\u043c\u043b\u044e \u0432\u044f\u0440\u043d\u0443\u043b\u0430 \u0441\u0430 \u0437\u043c\u0440\u043e\u043a\u0443,<br \/>\u041d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0430\u0441\u0432\u044f\u0446\u0456\u045e\u0448\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442\u0443 \u0433\u0430\u0434\u0437\u0456\u043d\u0443 \u041f\u0430\u043d \u0415\u0437\u0443\u0441<br \/>\u0412\u044f\u0440\u043d\u0443\u045e \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u045e\u0441\u0456\u0445 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445.<br \/>\u0406, \u0432\u044b\u0432\u0435\u045e\u0448\u044b \u0446\u0435\u043b\u044b \u0437 \u043c\u0430\u0433\u0456\u043b\u0430\u045e,<br \/>\u0414\u0430\u045e \u0456\u043c \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u0430\u0433\u0430 \u0434\u0443\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0434\u044b \u0430\u0431\u043d\u0430\u0432\u0456\u045e\u0441\u044f \u0441\u0432\u0435\u0442 \u0446\u044d\u043b\u044b,<br \/>\u0406 \u0441\u043c\u0435\u0440\u0446\u044c \u0441\u0432\u0430\u044e \u0441\u0442\u0440\u0430\u0446\u0456\u043b\u0430 \u0441\u0456\u043b\u0443,<br \/>\u041f\u0430\u0447\u0430\u045e\u0441\u044f \u0447\u0430\u0441 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0432\u0435\u0447\u043d\u0430\u0439<br \/>\u0406 \u043b\u0430\u0441\u043a\u0430\u045e \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041e \u0415\u0437\u0443, \u0422\u044b, \u0441\u043c\u0435\u0440\u0446\u044c \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0448\u044b,<br \/>\u0425\u0432\u0430\u043b\u043e\u044e \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u043d\u0430\u043c \u0437\u0437\u044f\u0435\u0448;<br \/>\u0422\u0430\u0431\u0435 \u0456 \u0410\u0439\u0446\u0443 \u0440\u0430\u0437\u0430\u043c \u0437 \u0414\u0443\u0445\u0430\u043c<br \/>\u041d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u0432\u0435\u0447\u043d\u0430\u044f \u0441\u043b\u0430\u0432\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"MPD_Gimn_3_ID":"5066","MPD_Gimn_3_Text":"\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u0431\u043b\u044f\u0441\u043a\u0430\u043c \u0437\u0430\u0437\u0437\u044f\u043b\u0430 \u0433\u0430\u0434\u0437\u0456\u043d\u0430,<br \/>\u0428\u0442\u043e \u043a\u0440\u044b\u0436\u0430 \u0440\u0430\u0441\u0441\u0435\u044f\u043b\u0430 \u0446\u0435\u043c\u0440\u0443,<br \/>\u0417\u044f\u043c\u043b\u044e \u0432\u044f\u0440\u043d\u0443\u043b\u0430 \u0441\u0430 \u0437\u043c\u0440\u043e\u043a\u0443,<br \/>\u041d\u044f\u0431\u0435\u0441\u043d\u044b\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0430\u0441\u0432\u044f\u0446\u0456\u045e\u0448\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0433\u044d\u0442