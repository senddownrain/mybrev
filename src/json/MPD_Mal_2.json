D_Mal_2_Text":"\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0432\u0435\u0447\u043d\u044b \u0411\u043e\u0436\u0430, \u0443 \u0422\u0430\u0431\u0435 \u043d\u044f\u043c\u0430 \u043d\u0456 \u0446\u0435\u043c\u0440\u044b, \u043d\u0456 \u0437\u043c\u044f\u0440\u043a\u0430\u043d\u043d\u044f. \u0410\u0437\u0430\u0440\u044b \u043d\u0430\u0441 \u0422\u0432\u0430\u0456\u043c \u0441\u0432\u044f\u0442\u043b\u043e\u043c, \u043a\u0430\u0431 \u043c\u044b, \u0430\u0441\u0432\u0435\u0442\u043b\u0435\u043d\u044b\u044f \u0422\u0432\u0430\u0456\u043c \u0441\u043b\u043e\u0432\u0430\u043c, \u0456\u0448\u043b\u0456 \u0434\u0430 \u0426\u044f\u0431\u0435 \u0441\u0430 \u0448\u0447\u044b\u0440\u044b\u043c \u0456 \u0432\u0435\u0440\u043d\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"MPD_Mal_2_ID":"46","MPD_Mal_2_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0430 \u0448\u043e\u0441\u0442\u0430\u0439 \u0433\u0430\u0434\u0437\u0456\u043d\u0435, \u043a\u0430\u043b\u0456 \u0441\u0432\u0435\u0442 \u0430\u0445\u0430\u043f\u0456\u043b\u0430 \u0446\u0435\u043c\u0440\u0430, \u0422\u044b \u0431\u044b\u045e \u043f\u0440\u044b\u0431\u0456\u0442\u044b \u0434\u0430 \u0434\u0440\u044d\u0432\u0430 \u043a\u0440\u044b\u0436\u0430 \u0456 \u0441\u0442\u0430\u045e \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439 \u0430\u0445\u0432\u044f\u0440\u0430\u0439 \u0434\u0437\u0435\u043b\u044f \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, \u0434\u0430\u0432\u0430\u0439 \u043d\u0430\u043c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0422\u0432\u0430\u0451 \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u0432\u044f\u0434\u0437\u0456 \u043b\u044e\u0434\u0437\u0435\u0439 \u043f\u0430 \u0448\u043b\u044f\u0445\u0443 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f. \u042f\u043a\u0456 \u0436\u044b\u0432\u0435\u0448 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0448 \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"MPD_Mal_2_ID":"47","MPD_Mal_2_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0441\u0432\u044f\u0442\u043b\u043e \u0432\u0435\u0447\u043d\u0430\u0439 \u043b\u044e\u0431\u043e\u0432\u0456, \u0430\u0434\u0430\u0440\u044b \u043d\u0430\u0441 \u043f\u0430\u043b\u044b\u043c\u044f\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c \u0456 \u043d\u0430\u0432\u0443\u0447\u044b \u043b\u044e\u0431\u0456\u0446\u044c \u0426\u044f\u0431\u0435 \u0431\u043e\u043b\u044c\u0448 \u0437\u0430 \u045e\u0441\u0451 \u043d\u0430 \u0441\u0432\u0435\u0446\u0435, \u0430 \u0431\u0440\u0430\u0442\u043e\u045e \u043d\u0430\u0448\u044b\u0445 &ndash; \u0422\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u045e\u044e. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"413","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u043d\u0430\u0448 \u0411\u043e\u0436\u0430, \u043b\u0456\u0442\u0430\u0441\u0446\u0456\u0432\u0430 \u043f\u0440\u044b\u043c\u0456 \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0456 \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u045e \u0436\u044b\u0446\u0446\u0451\u0432\u044b\u0445 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u0445, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u045e\u0437\u043c\u043e\u0446\u043d\u0456\u0446\u044c \u043d\u0430\u0441 \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u0435 \u0430\u0434 \u0433\u0440\u0430\u0445\u0443. \u041f\u0440\u0430\u0437 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"414","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u043d\u0430\u0448 \u0411\u043e\u0436\u0430, \u0422\u0432\u0430\u0451\u044e \u0411\u043e\u0436\u0430\u044e \u043c\u043e\u0446\u0430\u044e \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0443\u0439 \u043d\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0434\u0430 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u043a\u0430\u0431 \u043c\u044b \u0431\u044b\u043b\u0456 \u0433\u043e\u0434\u043d\u044b\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0436\u044b\u0446\u0446\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0456 \u045e\u0434\u0430\u0441\u0442\u043e\u0456\u043b\u0456\u0441\u044f \u043f\u0440\u044b\u043d\u044f\u0446\u044c \u0437 \u042f\u0433\u043e \u0440\u0443\u043a \u043f\u0430\u0441\u0456\u043b\u0430\u043a \u043d\u044f\u0431\u0435\u0441\u043d\u044b. \u041f\u0440\u0430\u0437 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"415","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430, \u043d\u0430\u0448 \u041e\u0439\u0447\u0430, \u0430\u0431&rsquo;\u044f\u0432\u0456 \u0441\u0432\u0430\u044e \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u043d\u0430\u0441 \u0441\u0432\u0430\u0451\u044e \u0411\u043e\u0441\u043a\u0430\u044e \u043c\u043e\u0446\u0430\u0439, \u043d\u044f\u0445\u0430\u0439 \u0422\u0432\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u044f \u043b\u0430\u0441\u043a\u0430 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u043d\u0430\u0441 \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e \u0456 \u043f\u0440\u044b\u0441\u043f\u0435\u0448\u044b\u0446\u044c \u043d\u0430\u0448\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435. \u041f\u0440\u0430\u0437 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"416","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u0415\u0437\u0443, \u043f\u0440\u0430\u044f\u0432\u0456 \u0441\u0432\u0430\u044e \u043c\u0430\u0433\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0456 \u043f\u0440\u044b\u0439\u0434\u0437\u0456, \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0422\u0432\u0430\u044f \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043d\u0430\u0441 \u0430\u0434 \u0433\u0440\u0430\u0445\u043e\u045e, \u0430 \u0422\u0432\u0430\u044f \u043c\u043e\u0446 \u043d\u044f\u0445\u0430\u0439 \u043d\u0430\u0441 \u0437\u0431\u0430\u0432\u0456\u0446\u044c. \u042f\u043a\u0456 \u0436\u044b\u0432\u0435\u0448 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0448 \u0437 \u0411\u043e\u0433\u0430\u043c \u0410\u0439\u0446\u043e\u043c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"417","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430, \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430 \u0433\u044d\u0442\u044b \u0441\u0432\u0435\u0442 \u0441\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u043a\u0430\u0431 \u0401\u043d \u0432\u044b\u0440\u0430\u0442\u0430\u0432\u0430\u045e \u043b\u044e\u0434\u0437\u0435\u0439 \u0437 \u043d\u044f\u0432\u043e\u043b\u0456 \u0433\u0440\u0430\u0445\u0443, \u0434\u0430\u0439 \u043d\u0430\u043c \u0443\u0441\u0456\u043c, \u0445\u0442\u043e \u0437 \u0432\u0435\u0440\u0430\u044e \u0447\u0430\u043a\u0430\u0435 \u0422\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456, \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u0430\u0439 \u0441\u0432\u0430\u0431\u043e\u0434\u044b. \u041f\u0440\u0430\u0437 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"422","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430, \u043d\u0430\u0448 \u041e\u0439\u0447\u0430, \u043f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u043d\u044f\u0445\u0430\u0439 \u0443\u0437\u043d\u044f\u0441\u0435\u0446\u0446\u0430 \u0434\u0430 \u0426\u044f\u0431\u0435 \u043d\u0430\u0448\u0430\u044f \u043f\u0430\u043a\u043e\u0440\u043d\u0430\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430, \u043a\u0430\u0431 \u043c\u044b \u045e \u0430\u0434\u0434\u0430\u043d\u044b\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456 \u0456 \u0437 \u0447\u044b\u0441\u0442\u0430\u0439 \u0434\u0443\u0448\u043e\u044e \u043c\u0430\u0433\u043b\u0456 \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u0432\u044f\u043b\u0456\u043a\u0443\u044e \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430. \u042f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"423","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0411\u043e\u0436\u0430, \u0422\u044b \u0430\u0431\u044f\u0446\u0430\u045e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u043c\u044b \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0447\u0430\u043a\u0430\u043b\u0456 \u0441\u0432\u044f\u0442\u0430 \u041d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430. \u042f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"424","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0411\u043e\u0436\u0430, \u0422\u044b \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0448 \u043d\u0430\u043c \u0440\u044b\u0445\u0442\u0430\u0432\u0430\u0446\u044c \u0448\u043b\u044f\u0445 \u041f\u0430\u043d\u0443, \u0443\u0447\u044b\u043d\u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u0430, \u043a\u0430\u0431 \u043d\u0435 \u0431\u044b\u043b\u0456 \u043c\u044b \u045e \u043f\u0430\u043b\u043e\u043d\u0435 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u0456, \u0447\u0430\u043a\u0430\u044e\u0447\u044b \u0441\u0443\u0446\u044f\u0448\u0430\u043b\u044c\u043d\u0430\u0439 \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u041b\u0435\u043a\u0430\u0440\u0430 \u0437 \u043d\u0435\u0431\u0430 &mdash; \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u042f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"425","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0411\u043e\u0436\u0430, \u0430\u0431\u0443\u0434\u0437\u0456 \u043d\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b, \u043a\u0430\u0431 \u043c\u044b \u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0456 \u0448\u043b\u044f\u0445\u0456 \u0422\u0432\u0430\u0439\u043c\u0443 \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u043c\u0443 \u0421\u044b\u043d\u0443 \u0456 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e\u043d\u0430\u0435 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u043c\u0430\u0433\u043b\u0456 \u0441\u043b\u0443\u0436\u044b\u0446\u044c \u0422\u0430\u0431\u0435 \u0437 \u0447\u044b\u0441\u0442\u0430\u0439 \u0434\u0443\u0448\u043e\u044e. \u041f\u0440\u0430\u0437 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"426","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0411\u043e\u0436\u0430, \u0434\u0430\u0439 \u043d\u0430\u0440\u043e\u0434\u0443 \u0422\u0432\u0430\u0439\u043c\u0443 \u045e \u0434\u0431\u0430\u0439\u043d\u044b\u043c \u0447\u0443\u0432\u0430\u043d\u043d\u0456 \u0447\u0430\u043a\u0430\u0446\u044c \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430, \u043a\u0430\u0431 \u0437 \u0437\u0430\u043f\u0430\u043b\u0435\u043d\u044b\u043c\u0456 \u0441\u0432\u0435\u0442\u0430\u0447\u0430\u043c\u0456 \u0432\u044b\u0439\u0448\u043b\u0456 \u042f\u043c\u0443 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447, \u044f\u043a \u0401\u043d \u0441\u0430\u043c \u0432\u0443\u0447\u044b\u0446\u044c \u043d\u0430\u0441 \u0443 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0456. \u042f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"427","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0411\u043e\u0436\u0430, \u043d\u044f\u0445\u0430\u0439 \u0443 \u0441\u044d\u0440\u0446\u0430\u0445 \u043d\u0430\u0448\u044b\u0445 \u0437\u0430\u0437\u0437\u044f\u0435 \u0441\u0432\u044f\u0442\u043b\u043e \u0422\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b \u0456 \u0437\u043d\u0456\u0448\u0447\u044b\u0446\u044c \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0443\u044e \u0446\u0435\u043c\u0440\u0443, \u043a\u0430\u0431 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0422\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0432\u044b\u044f\u0432\u0456\u043b\u0430, \u0448\u0442\u043e \u043c\u044b \u2014 \u0434\u0437\u0435\u0446\u0456 \u0441\u0432\u044f\u0442\u043b\u0430. \u041f\u0440\u0430\u0437 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"432","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u041e\u0439\u0447\u0430, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u043d\u0430\u0448\u044b\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0456 \u043f\u0440\u044b\u0439\u0441\u0446\u0435\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0430\u0441\u0432\u044f\u0442\u043b\u0456 \u0446\u0435\u043c\u0440\u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u0441\u044d\u0440\u0446\u0430. \u041f\u0440\u0430\u0437 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"433","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430, \u0422\u044b \u045e\u0447\u044b\u043d\u0456\u045e \u0442\u0430\u043a, \u0448\u0442\u043e \u043f\u0440\u0430\u0437 \u0422\u0432\u0430\u0439\u0433\u043e \u0410\u0434\u0437\u0456\u043d\u0430\u0440\u043e\u0434\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u043c\u044b \u0441\u0442\u0430\u043b\u0456\u0441\u044f \u043d\u043e\u0432\u044b\u043c \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435\u043c, \u0433\u043b\u044f\u043d\u044c \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u043d\u0430 \u0441\u043f\u0440\u0430\u0432\u044b \u0422\u0432\u0430\u0451\u0439 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0439 \u043b\u0430\u0441\u043a\u0456 \u0456 \u043f\u0440\u0430\u0437 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0430\u0447\u044b\u0441\u0446\u0456 \u043d\u0430\u0441 \u0430\u0434 \u0443\u0441\u044f\u043b\u044f\u043a\u0430\u0433\u0430 \u0433\u0440\u0430\u0445\u043e\u045e\u043d\u0430\u0433\u0430 \u0431\u0440\u0443\u0434\u0443. \u041f\u0440\u0430\u0437 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"434","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0411\u043e\u0436\u0430, \u0434\u0430\u0439, \u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u043d\u0430\u0434\u044b\u0445\u043e\u0434\u0437\u044f\u0447\u0430\u044f \u045e\u0440\u0430\u0447\u044b\u0441\u0442\u0430\u0441\u0446\u044c \u041d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u044f \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u043b\u0430 \u043d\u0430\u043c \u0443 \u0436\u044b\u0446\u0446\u0456 \u043d\u0430 \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435, \u0430 \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0430 \u043d\u0430\u0441 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f. \u041f\u0440\u0430\u0437 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"450","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430, \u0422\u044b \u0434\u0437\u0456\u0432\u043e\u0441\u043d\u044b\u043c \u0447\u044b\u043d\u0430\u043c \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430 \u0456 \u044f\u0448\u0447\u044d \u0431\u043e\u043b\u044c\u0448 \u0434\u0437\u0456\u0432\u043e\u0441\u043d\u0430 \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u044f\u0433\u043e \u0433\u043e\u0434\u043d\u0430\u0441\u0446\u044c, \u0434\u0430\u0439 \u043d\u0430\u043c \u0443\u0434\u0437\u0435\u043b \u0443 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456 \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u044f\u045e \u043d\u0430\u0448\u0443 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443. \u042f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"460","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0411\u043e\u0436\u0430, \u043c\u044b \u0432\u0435\u0440\u044b\u043c, \u0448\u0442\u043e \u0422\u0432\u043e\u0439 \u0421\u044b\u043d, \u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u0430 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u0435 \u0437 \u0422\u0430\u0431\u043e\u044e \u045e \u0445\u0432\u0430\u043b\u0435, \u0441\u0442\u0430\u045e \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430\u043c \u0456 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u041f\u0430\u043d\u043d\u044b \u041c\u0430\u0440\u044b\u0456, \u0434\u0430\u0439, \u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u043c\u044b \u043d\u0435\u043f\u0430\u0445\u0456\u0441\u043d\u0430 \u0442\u0440\u044b\u0432\u0430\u043b\u0456 \u045e \u0433\u044d\u0442\u0430\u0439 \u0432\u0435\u0440\u044b \u0456, \u0432\u044b\u0437\u0432\u0430\u043b\u0435\u043d\u044b\u044f \u0430\u0434 \u0437\u044f\u043c\u043d\u044b\u0445 \u043f\u0435\u0440\u0430\u0448\u043a\u043e\u0434\u0430\u045e, \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u043b\u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u0456 \u0432\u0435\u0447\u043d\u0430\u0439. \u041f\u0440\u0430\u0437 \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u044f\u043a\u0456 \u0437 \u0422\u0430\u0431\u043e\u044e \u0436\u044b\u0432\u0435 \u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u0446\u044c \u0443 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0411\u043e\u0433, \u043f\u0440\u0430\u0437 \u0443\u0441\u0435 \u0432\u044f\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"574","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0411\u043e\u0436\u0430, \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u041a\u0430\u0441\u0446\u0451\u043b \u0422\u0432\u043e\u0439, \u0441\u0430\u0431\u0440\u0430\u043d\u044b \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c, \u0443\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0431\u044b\u045e \u0422\u0430\u0431\u0435 \u0430\u0434\u0434\u0430\u043d\u044b \u0456 \u0448\u0447\u044b\u0440\u0430 \u0456\u043c\u043a\u043d\u0443\u045e\u0441\u044f \u0434\u0430 \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0456 \u0437\u0433\u043e\u0434\u044b. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"5026","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430, \u0422\u044b &ndash; \u043d\u0430\u0434\u0437\u0435\u044f \u0456 \u0441\u0432\u044f\u0442\u043b\u043e \u0448\u0447\u044b\u0440\u044b\u0445 \u0434\u0443\u0448, \u0443\u0447\u044b\u043d\u0456, \u043f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u043c\u044b \u0433\u043e\u0434\u043d\u0430 \u045e\u0437\u043d\u043e\u0441\u0456\u043b\u0456 \u0434\u0430 \u0426\u044f\u0431\u0435 \u043d\u0430\u0448\u044b\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u044b \u0456 \u045e\u0441\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0426\u044f\u0431\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u043b\u0456. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"5037","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430, \u0422\u044b \u045e\u0441\u0456\u043c, \u0445\u0442\u043e \u045e \u0426\u044f\u0431\u0435 \u0432\u0435\u0440\u044b\u0446\u044c, \u0434\u0430\u045e \u043d\u043e\u0432\u0430\u0435 \u0436\u044b\u0446\u0446\u0451 \u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0446\u0435 \u0445\u0440\u043e\u0441\u0442\u0443, \u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0430\u0434\u0440\u043e\u0434\u0436\u0430\u043d\u044b\u0445 \u0443 \u0425\u0440\u044b\u0441\u0446\u0435 \u0422\u0432\u0430\u0451\u044e \u043d\u044f\u0441\u0442\u043e\u043c\u043d\u0430\u044e \u0430\u043f\u0435\u043a\u0430\u044e, \u043a\u0430\u0431 \u044f\u043d\u044b \u043c\u0430\u0433\u043b\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u044c\u0441\u0442\u0430\u044f\u0446\u044c \u0441\u043f\u0430\u043a\u0443\u0441\u0430\u043c \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u043b\u0430\u0441\u043a\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"5046","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0411\u043e\u0436\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u0422\u0430\u0431\u0435 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0441\u0432\u0430\u0431\u043e\u0434\u0443 \u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435; \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0422\u044b \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u043a\u0440\u044b\u0432\u0451\u044e \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430, \u0456 \u0431\u0443\u0434\u0437\u044c \u0434\u043b\u044f \u0456\u0445 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u044e \u0436\u044b\u0446\u0446\u044f \u0456 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0448\u0447\u0430\u0441\u0446\u044f. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"MPD_Mal_2_ID":"5062","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u041c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0411\u043e\u0436\u0430, \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u0443 \u043d\u0430\u0448\u044b\u043c \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u044b\u043c \u0436\u044b\u0446\u0446\u0456 \u0432\u044b\u044f\u045e\u043b\u044f\u045e\u0441\u044f \u043f\u043b\u0451\u043d \u043b\u0430\u0441\u043a\u0456, \u044f\u043a\u043e\u044e \u0422\u044b \u043d\u0430\u0441 \u043d\u0430\u0434\u0437\u044f\u043b\u0456\u045e \u0443 \u0432\u0435\u043b\u0456\u043a\u043e\u0434\u043d\u044b\u0445 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0430\u0445. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"MPD_Mal_2_ID":"5073","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u044b \u0411\u043e\u0436\u0430, \u043f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u043d\u044f\u0445\u0430\u0439 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u0441\u044b\u0434\u0437\u0435 \u0456 \u043f\u0440\u0430\u0431\u044b\u0432\u0430\u0435 \u045e \u043d\u0430\u0441, \u0456 \u045e\u0447\u044b\u043d\u0456\u0446\u044c \u043d\u0430\u0441 \u0441\u0432\u044f\u0442\u044b\u043d\u044f\u0439 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>\r\n"}, {"MPD_Mal_2_ID":"5075","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u0443\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0411\u043e\u0436\u0430, \u043d\u044f\u0445\u0430\u0439 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u044c \u043d\u0430\u0441 \u0441\u0432\u0430\u0456\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456 \u0456 \u0441\u0442\u0432\u043e\u0440\u044b\u0446\u044c \u0443 \u043d\u0430\u0441 \u043d\u043e\u0432\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, \u043a\u0430\u0431 \u043c\u044b \u0441\u0442\u0430\u043b\u0456 \u043c\u0456\u043b\u044b\u043c\u0456 \u0422\u0430\u0431\u0435 \u0456 \u0437\u0430\u045e\u0436\u0434\u044b \u0431\u044b\u043b\u0456 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u0422\u0432\u0430\u0451\u0439 \u0432\u043e\u043b\u0456. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>"}, {"MPD_Mal_2_ID":"5081","MPD_Mal_2_Text":"<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430, \u0422\u044b \u043f\u0440\u0430\u0437 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0441\u0451\u043d\u043d\u044f\u0448\u043d\u044f\u0433\u0430 \u0441\u0432\u044f\u0442\u0430 \u0430\u0441\u0432\u044f\u0447\u0430\u0435\u0448 \u0441\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a\u0456 \u044f\u0434\u043d\u0430\u0435 \u045e\u0441\u0435 \u043f\u043b\u044f\u043c\u0451\u043d\u044b \u0456 \u043d\u0430\u0440\u043e\u0434\u044b; \u043d\u0430\u043f\u043e\u045e\u043d\u0456 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0434\u0430\u0440\u0430\u043c\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0456 \u0430\u0434\u043d\u0430\u0432\u0456 \u045e \u0441\u044d\u0440\u0446\u0430\u0445 \u0432\u0435\u0440\u043d\u044b\u0445 \u043f\u043b\u0451\u043d \u0422\u0432\u0430\u0451\u0439 \u043b\u0430\u0441\u043a\u0456, \u044f\u043a\u0443\u044e \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0430\u0431\u0432\u044f\u0448\u0447\u044d\u043d\u043d\u044f \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f. \u041f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430, \u041f\u0430\u043d\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0410\u043c\u044d\u043d.<\/p>"}]
