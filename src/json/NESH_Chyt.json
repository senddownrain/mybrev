u044f, \u043d\u0430\u0432\u0430\u0442 \u043a\u0430\u043b\u0456 \u0446\u044f\u043f\u0435\u0440 \u0456 \u0434\u0430\u0432\u044f\u0434\u0437\u0435\u0446\u0446\u0430 \u0442\u0440\u043e\u0445\u0456 \u043f\u0430\u0441\u0443\u043c\u0430\u0432\u0430\u0446\u044c \u043f\u0430\u0434\u0447\u0430\u0441 \u0440\u043e\u0437\u043d\u044b\u0445 \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u045e, \u043a\u0430\u0431 \u043f\u0440\u0430\u0432\u0435\u0440\u0430\u043d\u0430\u044f \u0432\u0430\u0448\u0430\u044f \u0432\u0435\u0440\u0430 \u0430\u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044f \u043d\u0430\u0448\u043c\u0430\u0442 \u043a\u0430\u0448\u0442\u043e\u045e\u043d\u0435\u0439\u0448\u0430\u0439 \u0437\u0430 \u0442\u043b\u0435\u043d\u043d\u0430\u0435 \u0437\u043e\u043b\u0430\u0442\u0430, \u044f\u043a\u043e\u0435 \u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u044e\u0446\u044c \u0430\u0433\u043d\u0451\u043c, \u043d\u0430 \u0441\u043b\u0430\u0432\u0443, \u0456 \u0445\u0432\u0430\u043b\u0443, \u0456 \u043f\u0430\u0448\u0430\u043d\u0443 \u043f\u0430\u0434\u0447\u0430\u0441 \u0430\u0431&rsquo;\u044f\u045e\u043b\u0435\u043d\u043d\u044f \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430. \u0425\u043e\u0446\u044c \u0432\u044b \u043d\u0435 \u0431\u0430\u0447\u044b\u043b\u0456, \u043b\u044e\u0431\u0456\u0446\u0435 \u042f\u0433\u043e \u0456, \u0445\u043e\u0446\u044c \u0446\u044f\u043f\u0435\u0440 \u043d\u0435 \u0431\u0430\u0447\u044b\u0446\u0435 \u042f\u0433\u043e, \u0432\u0435\u0440\u044b\u0446\u0435 \u045e \u042f\u0433\u043e. \u0412\u0435\u0441\u044f\u043b\u0456\u0446\u0435\u0441\u044f \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u0430\u044e \u0456 \u043d\u0430\u0439\u0441\u043b\u0430\u045e\u043d\u0435\u0439\u0448\u0430\u044e, \u0434\u0430\u0441\u044f\u0433\u0430\u044e\u0447\u044b \u043c\u044d\u0442\u044b \u0432\u0435\u0440\u044b \u0432\u0430\u0448\u0430\u0439 &ndash; \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0434\u0443\u0448.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041d\u0430\u043a\u0430\u0440\u043c\u0456\u045e \u043d\u0430\u0441 \u041f\u0430\u043d <span style=\"color: #ff0000;\">*<\/span> \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u0439 \u043f\u0448\u0430\u043d\u0456\u0446\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u043a\u0430\u0440\u043c\u0456\u045e \u043d\u0430\u0441 \u041f\u0430\u043d <span style=\"color: #ff0000;\">*<\/span> \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u0439 \u043f\u0448\u0430\u043d\u0456\u0446\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u043d\u0430\u0441\u044b\u0446\u0456\u045e \u043d\u0430\u0441 \u043c\u0451\u0434\u0430\u043c \u0441\u0430 \u0441\u043a\u0430\u043b\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u0439 \u043f\u0448\u0430\u043d\u0456\u0446\u0430\u0439.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0432\u0430\u043b\u0430 \u0410\u0439\u0446\u0443 \u0456 \u0421\u044b\u043d\u0443, \u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041d\u0430\u043a\u0430\u0440\u043c\u0456\u045e \u043d\u0430\u0441 \u041f\u0430\u043d <span style=\"color: #ff0000;\">*<\/span> \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u0439 \u043f\u0448\u0430\u043d\u0456\u0446\u0430\u0439.<\/p>\r\n"}, {"NESH_Chyt_ID":"16","NESH_Chyt_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0420\u044b\u043c 15, 1-3<\/span><br \/>\u041c\u044b, \u043c\u043e\u0446\u043d\u044b\u044f, \u043f\u0430