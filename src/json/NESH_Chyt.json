30\u0434\u0430\u0440\u0441\u0442\u0432\u0430\u043c \u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u0430\u043c\u0456 \u0434\u043b\u044f \u0411\u043e\u0433\u0430 \u043d\u0430\u0448\u0430\u0433\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0421\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0432\u0430\u043b\u0430 \u0410\u0439\u0446\u0443 \u0456 \u0421\u044b\u043d\u0443, \u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u043d\u0430\u0441 \u0456 \u0430\u0431\u043c\u044b\u045e<span style=\"color: #ff0000;\"> *<\/span> \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e.<\/p>\r\n"}, {"NESH_Chyt_ID":"20","NESH_Chyt_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u041a\u043b\u0441 1, 2b-6\u0430<\/span><br \/>\u041b\u0430\u0441\u043a\u0430 \u0432\u0430\u043c \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0430\u0434 \u0411\u043e\u0433\u0430, \u0410\u0439\u0446\u0430 \u043d\u0430\u0448\u0430\u0433\u0430. \u0414\u0437\u044f\u043a\u0443\u0435\u043c \u0411\u043e\u0433\u0443, \u0410\u0439\u0446\u0443 \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0437\u0430\u045e\u0441\u0451\u0434\u044b, \u043a\u0430\u043b\u0456 \u043c\u043e\u043b\u0456\u043c\u0441\u044f \u0437\u0430 \u0432\u0430\u0441, \u0431\u043e \u043c\u044b \u043f\u0430\u0447\u0443\u043b\u0456 \u043f\u0440\u0430 \u0432\u0430\u0448\u0443\u044e \u0432\u0435\u0440\u0443 \u045e \u0425\u0440\u044b\u0441\u0446\u0435 \u0415\u0437\u0443\u0441\u0435 \u0456 \u043f\u0440\u0430 \u043b\u044e\u0431\u043e\u045e, \u044f\u043a\u0443\u044e \u043c\u0430\u0435\u0446\u0435 \u