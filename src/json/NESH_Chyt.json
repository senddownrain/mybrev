3\u0441\u0430 \u0456, \u043a\u0430\u043b\u0456 \u0430\u0441\u0443\u0434\u0437\u0456\u043b\u0456 \u042f\u0433\u043e, \u0441\u043f\u043e\u045e\u043d\u0456\u043b\u0456 \u0441\u043b\u043e\u0432\u044b \u043f\u0440\u0430\u0440\u043e\u043a\u0430\u045e, \u0448\u0442\u043e \u0447\u044b\u0442\u0430\u043b\u0456\u0441\u044f \u043a\u043e\u0436\u043d\u044b \u0448\u0430\u0431\u0430\u0442. \u0406 \u0445\u043e\u0446\u044c \u043d\u0435 \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u043d\u0456\u044f\u043a\u0430\u0439 \u043f\u0440\u044b\u0447\u044b\u043d\u044b \u0434\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456, \u043f\u0440\u0430\u0441\u0456\u043b\u0456 \u041f\u0456\u043b\u0430\u0442\u0430 \u0437\u0430\u0431\u0456\u0446\u044c \u042f\u0433\u043e. \u0410 \u043a\u0430\u043b\u0456 \u0432\u044b\u043a\u0430\u043d\u0430\u043b\u0456 \u045e\u0441\u0451 \u043d\u0430\u043f\u0456\u0441\u0430\u043d\u0430\u0435 \u043f\u0440\u0430 \u042f\u0433\u043e, \u0437\u043d\u044f\u043b\u0456 \u042f\u0433\u043e \u0437 \u043a\u0440\u044b\u0436\u0430 \u0456 \u043f\u0430\u043a\u043b\u0430\u043b\u0456 \u045e \u043c\u0430\u0433\u0456\u043b\u0443. \u0410\u043b\u0435 \u0411\u043e\u0433 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"text-align: justify; color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u041f\u0440\u044b\u0441\u043b\u0443\u0445\u0430\u0439\u0441\u044f, \u041f\u0430\u043d\u0435, \u0456 \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f,&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">*<\/span><span style=\"text-align: justify;\">&nbsp;\u0431\u043e \u043c\u044b \u0437\u0433\u0440\u0430\u0448\u044b\u043b\u0456 \u043f\u04