3\u044d\u0442\u0430\u0433\u0430 \u0432\u0435\u043a\u0443, \u0430\u043b\u0435 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u044f\u0439\u0446\u0435\u0441\u044f \u043f\u0440\u0430\u0437 \u0430\u0431\u043d\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0440\u043e\u0437\u0443\u043c\u0443 \u0432\u0430\u0448\u0430\u0433\u0430, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0437\u043d\u0430\u043b\u0456, \u044f\u043a\u0430\u044f \u0432\u043e\u043b\u044f \u0411\u043e\u0436\u0430\u044f, \u0448\u0442\u043e \u0434\u043e\u0431\u0440\u0430\u0435, \u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0435 \u0456 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"text-align: justify; color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u042f \u0441\u043a\u0430\u0437\u0430\u045e:<\/span><span style=\"text-align: justify; color: #ff0000;\">&nbsp;*<\/span><span style=\"text-align: justify;\">&nbsp;\u041f\u0430\u043d\u0435, \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041d.<\/span><span style=\"text-align: justify;\">&nbsp;\u042f \u0441\u043a\u0430\u0437\u0430\u045e:&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">*<\/span><span style=\"text-align: justify;\">&nbsp;\u041f\u0430\u043d\u0435, \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434\u0430 \u043c\u043d\u043e\u044e.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u0410\u0437\u0434\u0430\u0440\u0430\u0432\u0456 \u043c\u0430\u044e \u0434\u0443\u0448\u0443, \u043