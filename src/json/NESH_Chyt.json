0430 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0456\u044f\u043a\u0430\u0435 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u045e \u041f\u0456\u0441\u0430\u043d\u043d\u0456 \u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0434\u0430 \u043f\u0440\u044b\u0432\u0430\u0442\u043d\u0430\u0433\u0430 \u0442\u043b\u0443\u043c\u0430\u0447\u044d\u043d\u043d\u044f. \u0411\u043e \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u043f\u0430\u0445\u043e\u0434\u0437\u0456\u043b\u0430 \u0437 \u0432\u043e\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u043a\u0430, \u0430\u043b\u0435 \u0430\u0434 \u0456\u043c\u044f \u0411\u043e\u0433\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u043b\u0456 \u044f\u0433\u043e \u043b\u044e\u0434\u0437\u0456, \u043d\u0430\u0442\u0445\u043d\u0451\u043d\u044b\u044f \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0434 \u0443\u0441\u0445\u043e\u0434\u0443 \u0434\u0430 \u0437\u0430\u0445\u0430\u0434\u0443 \u0441\u043e\u043d\u0446\u0430 <span style=\"color: #ff0000;\">*<\/span> \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430 \u0456\u043c\u044f \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0410\u0434 \u0443\u0441\u0445\u043e\u0434\u0443 \u0434\u0430 \u0437\u0430\u0445\u0430\u0434\u0443 \u0441\u043e\u043d\u0446\u0430 <span style=\"color: #ff0000;\">*<\/span> \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0437\u0435 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430 \u0456\u043c\u044f \u041f\u0430\u043d\u0430.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\