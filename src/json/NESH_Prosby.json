br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u043c\u044b \u0431\u044b\u043b\u0456 \u042f\u0433\u043e\u043d\u044b\u043c\u0456 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456 \u043f\u0430 \u045e\u0441\u0451\u0439 \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041e\u0439\u0447\u0430, \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0414\u043e\u0431\u0440\u0443\u044e \u041d\u0430\u0432\u0456\u043d\u0443 \u045e\u0431\u043e\u0433\u0456\u043c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u043d\u0430\u043c \u0443\u0441\u0456\u043c \u043f\u0440\u0430\u043f\u0430\u0432\u0435\u0434\u0430\u0432\u0430\u0446\u044c \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041e\u0439\u0447\u0430, \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0441\u0435\u044f\u0446\u044c \u0437\u0435\u0440\u043d\u0435 \u0441\u043b\u043e\u0432\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u0443\u0441\u0456\u043c, \u0445\u0442\u043e \u043f\u0440\u0430\u0446\u0430\u0432\u0456\u0442\u0430 \u0441\u0435\u0435 \u0441\u043b\u043e\u0432\u0430, \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0437\u0431\u0456\u0440\u0430\u0446\u044c \u043f\u043b\u0451\u043d.<\/p>\r\n<p style=\"text-align: justify;\">\u041e\u0439\u0447\u0430, \u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u043f\u0430\u044f\u0434\u043d\u0430\u0446\u044c \u0437 \u0441\u0430\u0431\u043e\u044e \u0441\u0432\u0435\u0442 \u043f\u0440\u0430\u0437 \u042f\u0433\u043e\u043d\u0443\u044e \u043a\u0440\u043e\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0