043a\u0430\u0439, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0445\u0432\u0430\u043b\u0443 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441 \u0422\u0432\u0430\u044f \u041c\u0430\u0446\u0456, \u0421\u0443\u0446\u044f\u0448\u0430\u043b\u044c\u043d\u0456\u0446\u0430 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0446\u044c \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u0442\u0430\u043a, \u044f\u043a \u0422\u044b \u043d\u0430\u0441 \u0441\u0443\u0446\u044f\u0448\u0430\u0435\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u0432\u0435\u0440\u043d\u044b\u043c, \u043a\u0430\u0431 \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0422\u0432\u0430\u0451\u0439 \u043c\u0443\u043a\u0456<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456 \u043f\u0440\u0430 \u0422\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435, \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0430\u0436\u043d\u043e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u0441\u043c\u0435\u0440\u0446\u0456 \u043a\u0440\u044b\u0436\u043e\u0432\u0430\u0439,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0433\u0430\u043c \u0431\u044b\u0446\u044c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u0456 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0447\u044b\u043d\u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u043f\u0430\u0434\u043e\u0431\u043d\u044b\u043c\u0456 \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043d\u0430\u0441 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0434\u0430\u043b\u0443\u0447\u044b \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n"}, {"NESH_Prosby_ID":"565","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u043c\u0441\u044f \u043d\u0430\u0448\u0430\u043c\u0443 \u0417\u0431\u0430\u045e\u0446\u0443, \u044f\u043a\u0456 \u043f\u0430\u0434\u0447\u0430\u0441 \u0410\u043f\u043e\u0448\u043d\u044f\u0439 \u0412\u044f\u0447\u044d\u0440\u044b, \u0443 \u043d\u043e\u0447, \u043a\u0430\u043b\u0456 \u0431\u044b\u045e \u0432\u044b\u0434\u0430\u0434\u0437\u0435\u043d\u044b, \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u0432\u0435\u0447\u043d\u0430 \u0441\u0432\u044f\u0442\u043a\u0430\u0432\u0430\u0446\u044c \u0443\u0441\u043f\u0430\u043c\u0456\u043d \u0441\u0432\u0430\u0451\u0439 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f, \u0456 \u043f\u0440\u043e\u0441\u0456\u043c: <br \/><em>\u0410\u0441\u0432\u044f\u0447\u0430\u0439 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0422\u044b \u0430\u0434\u043a\u0443\u043f\u0456\u045e \u0441\u0432\u0430\u0451\u0439 \u043a\u0440\u044b\u0432\u0451\u044e.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c, \u0434\u0430\u0439 \u043d\u0430\u043c \u043f\u0440\u0430\u0437 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0435 \u0437&rsquo;\u044f\u0434\u043d\u0430\u0446\u0446\u0430 \u0437 \u0422\u0432\u0430\u0451\u0439 \u043c\u0443\u043a\u0430\u0439,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043c\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0445\u0432\u0430\u043b\u0443 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441 \u0422\u0432\u0430\u044f \u041c\u0430\u0446\u0456, \u0421\u0443\u0446\u044f\u0448\u0430\u043b\u044c\u043d\u0456\u0446\u0430 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043c\u044b \u043c\u0430\u0433\u043b\u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0446\u044c \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u0445 \u0442\u0430\u043a, \u044f\u043a \u0422\u044b \u043d\u0430\u0441 \u0441\u0443\u0446\u044f\u0448\u0430\u0435\u0448.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u0432\u0435\u0440\u043d\u044b\u043c, \u043a\u0430\u0431 \u0443 \u0446\u044f\u0440\u043f\u0435\u043d\u043d\u044f\u0445 \u044f\u043d\u044b \u0431\u044b\u043b\u0456 \u045e\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u043a\u0430\u043c\u0456 \u0422\u0432\u0430\u0451\u0439 \u043c\u0443\u043a\u0456 <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u043b\u0456 \u043f\u0440\u0430 \u0422\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u044f\u0431\u0435, \u0441\u0442\u0430\u045e\u0448\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0430\u0436\u043d\u043e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456, \u0441\u043c\u0435\u0440\u0446\u0456 \u043a\u0440\u044b\u0436\u043e\u0432\u0430\u0439,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u0441\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0433\u0430\u043c \u0431\u044b\u0446\u044c \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c\u0456 \u0456 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0430\u0440\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0445\u0432\u0430\u043b\u043e\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0446\u0435\u043b\u0430<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043d\u0430\u0441 \u043a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0434\u0430\u043b\u0443\u0447\u044b \u0434\u0430 \u0422\u0432\u0430\u0451\u0439 \u0432\u0435\u0447\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n"}, {"NESH_Prosby_ID":"566","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044e \u0437\u0433\u0430\u0434\u0432\u0430\u044e\u0447\u044b \u0441\u043c\u0435\u0440\u0446\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u041f\u0430\u043d\u0430 \u0415\u0437\u0443\u0441\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u044f\u043a\u043e\u0439 \u0441\u0432\u0435\u0442 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u0436\u044b\u0446\u0446\u0451, \u043f\u0440\u043e\u0441\u0456\u043c \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430:<br \/><em>\u041f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431&rsquo;\u044f\u0434\u043d\u043e\u045e\u0432\u0430\u0439 \u0441\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u043b\u0430\u043f\u0430\u0446\u0456\u0441\u044f \u043f\u0440\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043f\u0443 <span style=\"color: #ff0000;\">N.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span>\u0410\u0441\u0432\u044f\u0447\u0430\u0439 \u0441\u0432\u0430\u0456\u043c \u0414\u0443\u0445\u0430\u043c \u0443\u0441\u0435 \u0441\u0442\u0430\u043d\u044b \u0434\u0443\u0445\u0430\u0432\u0435\u043d\u0441\u0442\u0432\u0430 \u0456 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0439 \u0432\u0435\u0440\u0443 \u0456 \u043f\u0430\u0433\u043b\u044b\u0431\u043b\u044f\u0439 \u0440\u0430\u0437\u0443\u043c\u0435\u043d\u043d\u0435 \u0422\u0432\u0430\u0456\u0445 \u043f\u0440\u0430\u045e\u0434 \u0443 \u043a\u0430\u0442\u044d\u0445\u0443\u043c\u044d\u043d\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0431&rsquo;\u044f\u0434\u043d\u043e\u045e\u0432\u0430\u0439 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u044e\u0434\u044d\u044f\u045e \u0434\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0441\u0432\u044f\u0442\u043b\u0456 \u044f\u0441\u043d\u0430\u0441\u0446\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u0441\u0432\u044f\u0442\u043b\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0425\u0440\u044b\u0441\u0442\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u0430\u0436\u044b \u0437\u043d\u0430\u043a\u0456 \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0435 \u043f\u0440\u044b\u043c\u0430\u0435 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041a\u0456\u0440\u0443\u0439 \u043d\u0430\u043c\u0435\u0440\u0430\u043c\u0456 \u0456 \u0441\u044d\u0440\u0446\u0430\u043c\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043a\u0456\u0440\u0443\u0435 \u0434\u0437\u044f\u0440\u0436\u0430\u0432\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0443\u0446\u044f\u0448\u0430\u0439 \u0443\u0441\u0456\u0445 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0445\u043e\u0434\u0437\u044c \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c.<\/p>\r\n"}, {"NESH_Prosby_ID":"567","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0421\u0430 \u0448\u0447\u044b\u0440\u0430\u0439 \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044e \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0435\u043c\u0441\u044f \u043d\u0430\u0448\u0430\u043c\u0443 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044e, \u044f\u043a\u0456 \u0446\u044f\u0440\u043f\u0435\u045e \u0437\u0430 \u043d\u0430\u0441 \u0456 \u0431\u044b\u045e \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b, \u043a\u0430\u0431 \u0443\u0432\u0430\u0441\u043a\u0440\u044d\u0441\u043d\u0443\u0446\u044c, \u0456 \u043f\u0430\u043a\u043e\u0440\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u042f\u0433\u043e: <br \/><em>\u0417\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456, \u041f\u0430\u043d\u0435.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u0415\u0437\u0443, \u0437 \u0422\u0432\u0430\u0439\u0433\u043e \u0431\u043e\u043a\u0443, \u043f\u0440\u0430\u0431\u0456\u0442\u0430\u0433\u0430 \u0434\u0437\u0456\u0434\u0430\u0439, \u0432\u044b\u0446\u044f\u043a\u043b\u0430 \u043a\u0440\u043e\u045e \u0456 \u0432\u0430\u0434\u0430 &ndash; \u0446\u0443\u0434\u043e\u045e\u043d\u044b \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442 \u0443\u0441\u044f\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u0441\u043c\u0435\u0440\u0446\u044c, \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0430\u0436\u044b\u045e\u043b\u044f\u0439 \u041a\u0430\u0441\u0446\u0451\u043b, \u0441\u0432\u0430\u044e \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u0415\u0437\u0443, \u043f\u0430\u043c\u044f\u0442\u0430\u0439 \u043f\u0440\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0430\u0431\u044b\u045e\u0441\u044f \u043f\u0440\u0430 \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0456 \u0422\u0432\u0430\u0439\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0422\u0432\u0430\u0439\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0456 \u0436\u044b\u0432\u0435 \u0431\u0435\u0437 \u043d\u0430\u0434\u0437\u0435\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u0430\u0440\u0430\u043d\u0430\u043a \u0411\u043e\u0436\u044b, \u043d\u0430\u0448\u0430\u044f \u041f\u0430\u0441\u0445\u0430, \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u0430\u044f \u0437\u0430 \u045e\u0441\u0456\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u044b\u0446\u044f\u0433\u043d\u0456 \u0434\u0430 \u0441\u044f\u0431\u0435 \u045e\u0441\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430 \u045e\u0441\u044f\u0433\u043e \u0441\u0443\u0441\u0432\u0435\u0442\u0443, \u0422\u044b \u043f\u0435\u0440\u0430\u045e\u0437\u044b\u0445\u043e\u0434\u0437\u0456\u0448 \u0443\u0441\u044f\u043b\u044f\u043a\u0456\u044f \u043c\u0435\u0436\u044b, \u0430\u043b\u0435 \u043f\u0430\u0436\u0430\u0434\u0430\u045e \u0431\u044b\u0446\u044c \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u043c \u0443 \u043c\u0430\u0433\u0456\u043b\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0432\u044b\u0437\u0432\u0430\u043b\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0440\u043e\u0434 \u0430\u0434 \u043f\u0430\u043a\u0430\u0440\u0430\u043d\u043d\u044f \u0456 \u0430\u0434\u0430\u0440\u044b \u044f\u0433\u043e \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0439 \u0441\u043b\u0430\u0432\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d, \u0421\u044b\u043d\u0435 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, \u0422\u044b \u043d\u0430 \u043a\u0440\u044b\u0436\u044b \u0430\u0434\u043a\u0440\u044b\u045e \u0437\u043b\u0430\u0447\u044b\u043d\u0446\u0443 \u0440\u0430\u0439,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043b\u0443\u0447\u044b \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u045e \u0441\u043b\u0430\u0432\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0435\u043d\u044b\u0445 \u0441\u0432\u0430\u0451\u044e \u0441\u043c\u0435\u0440\u0446\u044e \u0456 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u043d\u0435\u043c \u0434\u0430 \u0426\u044f\u0431\u0435.<\/p>\r\n"}, {"NESH_Prosby_ID":"601","NESH_Prosby_Text":"\r\n<p>\u041c\u043e\u043b\u0456\u043c\u0441\u044f \u0434\u0430 \u045e\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043