043e\u043c\u0443 \u042e\u0437\u0430\u0444\u0443 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0425\u0440\u044b\u0441\u0442\u0430, \u0441\u0445\u0430\u0432\u0430\u043d\u0443\u044e \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u043d\u0430\u043c \u0433\u043b\u044b\u0431\u0435\u0439 \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u044f\u043a \u0411\u043e\u0433\u0430 \u0456 \u0427\u0430\u043b\u0430\u0432\u0435\u043a\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0431\u0435\u0441\u043d\u044b \u041e\u0439\u0447\u0430, \u0422\u044b \u043a\u043e\u0440\u043c\u0456\u0448 \u043f\u0442\u0443\u0448\u0430\u043a \u043d\u044f\u0431\u0435\u0441\u043d\u044b\u0445 \u0456 \u0430\u043f\u0440\u0430\u043d\u0430\u0435\u0448 \u043f\u0430\u043b\u044f\u0432\u0443\u044e \u0442\u0440\u0430\u0432\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0448\u0447\u043e\u0434\u0440\u0430 \u045e\u0434\u0437\u044f\u043b\u044f\u0439 \u0443\u0441\u0456\u043c \u043b\u044e\u0434\u0437\u044f\u043c \u0448\u0442\u043e\u0434\u0437\u0451\u043d\u043d\u044b \u0445\u043b\u0435\u0431, \u043d\u0435\u0430\u0431\u0445\u043e\u0434\u043d\u044b \u0434\u043b\u044f \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0432\u0430\u0440\u044b\u0446\u0435\u043b\u044c \u0443\u0441\u044f\u0433\u043e, \u0422\u044b \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u043d\u0430\u043c \u0441\u043f\u0440\u0430\u0432\u0443 \u0441\u0432\u0430\u0456\u0445 \u0440\u0443\u043a,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u043f\u0440\u0430\u0446\u0430\u045e\u043d\u0456\u043a\u0430\u043c \u0433\u043e\u0434\u043d\u0430 \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0446\u0446\u0430 \u043f\u043b\u0451\u043d\u0430\u043c \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b, \u0422\u044b \u0445\u043e\u0447\u0430\u0448, \u043a\u0430\u0431 \u043b\u044e\u0434\u0437\u0456 \u0441\u0442\u0430\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u043c\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u043d\u0430\u043c \u043f\u0440\u0430\u0437 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u042e\u0437\u0430\u0444\u0430 \u0436\u044b\u0446\u044c \u0442\u0430\u043a, \u043a\u0430\u0431 \u0437\u0430\u045e\u0436\u0434\u044b \u043f\u0430\u0434\u0430\u0431\u0430\u0446\u0446\u0430 \u0422\u0430\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b\u043c, \u0445\u0442\u043e \u043f\u0430\u043c\u0456\u0440\u0430\u0435 \u0446\u0456 \u045e\u0436\u043e \u043f\u0430\u043c\u0451\u0440, \u043f\u0440\u0430\u0437 \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0456 \u043f\u0440\u0430\u0437 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430 \u041c\u0430\u0440\u044b\u0456, \u041c\u0430\u0446\u0456 \u042f\u0433\u043e\u043d\u0430\u0439, \u0456 \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u042e\u0437\u0430\u0444\u0430<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u045e\u0434\u0437\u044f\u043b\u0456 \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u0422\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n"}, {"NESH_Prosby_ID":"7161","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0434\u0430\u0432\u0435\u0440\u0430\u043c \u043f\u0440\u043e\u0441\u0456\u043c \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u0441\u0451\u043d\u043d\u044f \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u043d\u0451\u043b\u0430 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u041c\u0430\u0440\u044b\u0456 \u043f\u0440\u0430 \u043d\u0430\u0448\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435:<br \/><em>\u041f\u0430\u043d\u0435, \u0448\u0447\u043e\u0434\u0440\u0430 \u0430\u0434\u0430\u0440\u044b \u043d\u0430\u0441 \u0441\u0432\u0430\u0451\u044e \u043b\u0430\u0441\u043a\u0430\u044e.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0432\u044b\u0431\u0440\u0430\u045e \u041f\u0430\u043d\u043d\u0443 \u041c\u0430\u0440\u044b\u044e, \u043a\u0430\u0431 \u042f\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u041c\u0430\u0446\u0456 \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456, \u0445\u0442\u043e \u0447\u0430\u043a\u0430\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u0443\u0441\u043d\u0430\u043c\u0456 \u0413\u0430\u0431\u0440\u044b\u044d\u043b\u044f \u0422\u044b \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u041c\u0430\u0440\u044b\u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u0430\u043f\u043e\u045e\u043d\u0456 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0437\u0433\u043e\u0434\u0443 \u0441\u043b\u0443\u0433\u0456 \u0422\u0432\u0430\u0451\u0439 \u0456 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0422\u044b \u045e\u0447\u044b\u043d\u0456\u045e, \u0448\u0442\u043e \u0422\u0432\u0430\u0451 \u0421\u043b\u043e\u0432\u0430 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u043c\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0434\u043a\u0440\u044b\u0439 \u043d\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u043c\u044b \u043f\u0440\u044b\u043c\u0430\u043b\u0456 \u042f\u0433\u043e, \u044f\u043a \u0414\u0437\u0435\u0432\u0430 \u041c\u0430\u0440\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0448\u0441\u044f \u043f\u0440\u0430 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u0445 \u0456 \u043d\u0430\u0441\u044b\u0447\u0430\u0435\u0448 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u043c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0430\u0434\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u0445, \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0443\u0431\u043e\u0433\u0456\u043c \u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0439 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430, \u0434\u043b\u044f \u0426\u044f\u0431\u0435 \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0433\u0430 \u0456 \u0422\u044b \u0430\u0434\u0437\u0456\u043d \u0447\u044b\u043d\u0456\u0448 \u0446\u0443\u0434\u044b,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0431\u0430\u045e \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u0448 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0443 \u0430\u043f\u043e\u0448\u043d\u0456 \u0434\u0437\u0435\u043d\u044c.<\/p>\r\n"}, {"NESH_Prosby_ID":"7162","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0434\u0430\u0432\u0435\u0440\u0430\u043c \u043f\u0440\u043e\u0441\u0456\u043c \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u0441\u0451\u043d\u043d\u044f \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u043d\u0451\u043b\u0430 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u041c\u0430\u0440\u044b\u0456 \u043f\u0440\u0430 \u043d\u0430\u0448\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435:<br \/><em>\u041f\u0430\u043d\u0435, \u0448\u0447\u043e\u0434\u0440\u0430 \u0430\u0434\u0430\u0440\u044b \u043d\u0430\u0441 \u0441\u0432\u0430\u0451\u044e \u043b\u0430\u0441\u043a\u0430\u044e.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0432\u044b\u0431\u0440\u0430\u045e \u041f\u0430\u043d\u043d\u0443 \u041c\u0430\u0440\u044b\u044e, \u043a\u0430\u0431 \u042f\u043d\u0430 \u0441\u0442\u0430\u043b\u0430 \u041c\u0430\u0446\u0456 \u0422\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456, \u0445\u0442\u043e \u0447\u0430\u043a\u0430\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0413\u0430\u0431\u0440\u044b\u044d\u043b\u044f \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u045e \u041c\u0430\u0440\u044b\u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c,<br \/><span style=\"color: #ff0000;\">&ndash;&nbsp;<\/span> \u043d\u0430\u043f\u043e\u045e\u043d\u0456 \u045e\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0456 \u0441\u0430\u043f\u0440\u0430\u045e\u0434\u043d\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0435\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u0430\u0437 \u0437\u0433\u043e\u0434\u0443 \u0441\u043b\u0443\u0433\u0456 \u0422\u0432\u0430\u0451\u0439 \u0456 \u0434\u0437\u0435\u044f\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u045e\u0447\u044b\u043d\u0456\u045e, \u0448\u0442\u043e \u0422\u0432\u0430\u0451 \u0421\u043b\u043e\u0432\u0430 \u043f\u0430\u0441\u044f\u043b\u0456\u043b\u0430\u0441\u044f \u043c\u0456\u0436 \u043d\u0430\u043c\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0434\u043a\u0440\u044b\u0439 \u043d\u0430\u0448\u044b\u044f \u0441\u044d\u0440\u0446\u044b \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0430\u0431 \u043c\u044b \u043f\u0440\u044b\u043c\u0430\u043b\u0456 \u042f\u0433\u043e, \u044f\u043a \u041f\u0430\u043d\u043d\u0430 \u041c\u0430\u0440\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043a\u043b\u0430\u043f\u043e\u0446\u0456\u0448\u0441\u044f \u043f\u0440\u0430 \u043f\u0430\u043a\u043e\u0440\u043d\u044b\u0445 \u0456 \u043d\u0430\u0441\u044b\u0447\u0430\u0435\u0448 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u0445 \u0434\u0430\u0431\u0440\u043e\u043c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0430\u0434\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u044b\u0445, \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0443\u0431\u043e\u0433\u0456\u043c \u0456 \u0441\u0443\u0446\u044f\u0448\u0430\u0439 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430, \u0434\u043b\u044f \u0426\u044f\u0431\u0435 \u043d\u044f\u043c\u0430 \u043d\u0456\u0447\u043e\u0433\u0430 \u043d\u0435\u043c\u0430\u0433\u0447\u044b\u043c\u0430\u0433\u0430 \u0456 \u0422\u044b \u0430\u0434\u0437\u0456\u043d \u0447\u044b\u043d\u0456\u0448 \u0446\u0443\u0434\u044b,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0431\u0430\u045e \u043d\u0430\u0441, \u043a\u0430\u043b\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u0448 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0443 \u0430\u043f\u043e\u0448\u043d\u0456 \u0434\u0437\u0435\u043d\u044c.<\/p>\r\n"}, {"NESH_Prosby_ID":"7361","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\"><span>\u0414\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b, \u044f\u043a\u0456 \u0446\u0443\u0434\u043e\u045e\u043d\u0430 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0456\u045e\u0441\u044f \u043d\u0430 \u0433\u0430\u0440\u044b \u045e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e, \u0437 \u0434\u0430\u0432\u0435\u0440\u0430\u043c \u0443\u0437\u043d\u043e\u0441\u0456\u043c \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b:&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"font-style: italic;\">\u0411\u043e\u0436\u0430 \u043d\u0430\u0448, \u0440\u0430\u0441\u0441\u0435\u0439 \u043d\u0430\u0448\u0443\u044e \u0446\u0435\u043c\u0440\u0443.<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span>\u0425\u0440\u044b\u0441\u0442\u044d, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u043f\u0435\u0440\u0430\u043c\u044f\u043d\u0435\u043d\u043d\u0435 \u0430\u0431\u2019\u044f\u0432\u0456\u045e \u0432\u0443\u0447\u043d\u044f\u043c \u043f\u0435\u0440\u0430\u0434 \u0441\u0432\u0430\u0451\u0439 \u043c\u0443\u043a\u0430\u0439 \u0445\u0432\u0430\u043b\u0443 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f,&nbsp;<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u2013<\/span><span><span class=\"Apple-tab-span\" style=\"white-space: pre;\"> <\/span><\/span><span>\u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u0422\u0432\u043e\u0439 \u041a\u0430\u0