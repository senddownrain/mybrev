p>\r\n<p>\u0422\u044b \u045e \u0441\u0432\u0430\u0456\u0445 \u0434\u0430\u043b\u043e\u043d\u044f\u0445 \u0442\u0440\u044b\u043c\u0430\u0435\u0448 \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0456 \u0456\u0445 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c \u043f\u0440\u044b\u0437\u043d\u0430\u0446\u044c \u0422\u0432\u0430\u044e \u043a\u0430\u0440\u0430\u043b\u0435\u045e\u0441\u043a\u0443\u044e \u045e\u043b\u0430\u0434\u0443.<\/p>\r\n<p>\u0422\u044b \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u045e\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u0442\u0430\u045e \u0432\u0435\u0447\u043d\u044b\u043c \u0421\u0432\u044f\u0442\u0430\u0440\u043e\u043c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456 \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0434\u043e\u0431\u0440\u044b\u043c\u0456 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p>\u0422\u044b \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456 \u0437\u0430\u043a\u043b\u044e\u0447\u044b\u045e \u043c\u0456\u0441\u0442\u044b\u0447\u043d\u044b \u0441\u0430\u044e\u0437 \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430 \u0456 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456 \u0434\u0437\u0435\u0432\u0430\u045e, \u0437\u0430\u0440\u0443\u0447\u0430\u043d\u044b\u0445 \u0437 \u0422\u0430\u0431\u043e\u044e.<\/p>\r\n<p>\u0422\u044b, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u043d\u0430\u0448\u0443 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0443\u044e \u0441\u0443\u0442\u043d\u0430\u0441\u04