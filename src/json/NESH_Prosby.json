0443 \u045e \u0432\u044b\u043f\u0440\u0430\u0431\u0430\u0432\u0430\u043d\u043d\u044f\u0445.<\/p>\r\n<p>\u041f\u0440\u0430\u0437 \u0437\u0430\u043c\u0443\u0436\u043d\u0456\u0445 \u0436\u0430\u043d\u0447\u044b\u043d, \u044f\u043a\u0456\u044f, \u0436\u044b\u0432\u0443\u0447\u044b \u045e \u0441\u0432\u044f\u0442\u044b\u043c \u0441\u0443\u0436\u044d\u043d\u0441\u0442\u0432\u0435, \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u043b\u0456 \u045e \u043b\u0430\u0441\u0446\u044b,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u0441\u0432\u0430\u0439\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0443\u044e \u043f\u043b\u0451\u043d\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p>\u041f\u0440\u0430\u0437 \u0443\u0434\u043e\u0432\u0430\u045e, \u044f\u043a\u0456\u044f \u043c\u0430\u043b\u0456\u0442\u0432\u0430\u0439 \u0456 \u0433\u0430\u0441\u0446\u0456\u043d\u043d\u0430\u0441\u0446\u044e \u0430\u0441\u0432\u044f\u0446\u0456\u043b\u0456 \u0441\u0432\u0430\u044e \u0430\u0434\u0437\u0456\u043d\u043e\u0442\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u0441\u0432\u0430\u0439\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u0430\u0434\u043a\u0440\u044b\u0432\u0430\u0446\u044c \u0441\u0432\u0435\u0442\u0443 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u0443 \u0422\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p>\u041f\u0440\u0430\u0437 \u043c\u0430\u0446\u0456, \u044f\u043a\u0456\u044f \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u043b\u0456 \u0456 \u0432\u044b\u0445\u0430\u0432\u0430\u043b\u0456 \u0434\u0437\u044f\u0446\u0435\u0439 \u0434\u043b\u044f \u0411\u043e\u0436\u0430\u0433\u0430 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0456 \u0434\u043b\u044f \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u0441\u0432\u0430\u0439\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u043d\u0430\u0440\u0430\u0434\u0436\u0430\u0446\u044c \u043b\u044e\u0434\u0437\u0435\u0439 \u0434\u043b\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p>\u041f\u0440\u0430\u0437 \u0441\u0432\u044f\u0442\u044b\u0445 \u0436\u0430\u043d\u0447\u044b\u043d, \u044f\u043a\u0456\u044f \u0437\u0430\u0441\u043b\u0443\u0436\u044b\u043b\u0456 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u0441\u0432\u044f\u0442\u043b\u043e \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0437\u0432\u043e\u043b\u044c \u0443\u0441\u0456\u043c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u043d\u0430\u0432\u0435\u043a\u0456 \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u0442\u044b\u043c \u0436\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c.<\/p>\r\n"}]
