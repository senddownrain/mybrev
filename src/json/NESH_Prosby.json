0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u045e\u0441\u044f \u0456 \u0431\u044b\u045e \u043c\u0430\u043b\u0430\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u0441\u043f\u044f\u0432\u0430\u044e\u0446\u044c \u0422\u0430\u0431\u0435 \u044f\u043a \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0443 \u0456 \u0411\u043e\u0433\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u044f\u0445\u0430\u0439 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u0442\u0430\u043a\u0441\u0430\u043c\u0430 \u0441\u0442\u0430\u043d\u0435 \u0422\u0432\u0430\u0451\u0439 \u0443\u043b\u0430\u0441\u043d\u0430\u0441\u0446\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0432\u044b\u0433\u0430\u043d\u044f\u045e \u0437\u043b\u044b\u0445 \u0434\u0443\u0445\u0430\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0434\u0432\u044f\u0434\u0437\u0456 \u0430\u0434 \u043d\u0430\u0441 \u0441\u043f\u0430\u043a\u0443\u0441\u044b \u0456 \u043f\u043e\u0434\u0441\u0442\u0443\u043f\u044b \u0441\u0430\u0442\u0430\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0423 \u0434\u0437\u0435\u043d\u044c \u041f\u044f\u0446\u0456\u0434\u0437\u0435\u0441\u044f\u0442\u043d\u0456\u0446\u044b \u0422\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0440\u0430\u0437\u043d\u0430\u043c\u043e\u045e\u0435 \u0411\u0430\u0431\u0456\u043b\u0451\u043d\u0430, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0414\u0443\u0445\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u0439 \u0443\u0441\u0456\u0445 \u0443 \u0432\u0435\u0440\u044b \u0456 \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0422\u0432\u043e\u0439 \u0414\u0443\u0445 \u043f\u0430\u0441\u0435\u043b\u0456\u0446\u0446\u0430 \u045e \u043d\u0430\u0441,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0430\u0436\u044b\u045e\u043b\u044f\u0446\u044c \u043d\u0430\u0448\u044b\u044f \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b\u044f \u0446\u0435\u043b\u044b.<\/p>\r\n"}, {"NESH_Prosby_ID":"5071","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041c\u044b \u043d\u0435 \u0432\u0435\u0434\u0430\u0435\u043c, \u044f\u043a \u0442\u0440\u044d\u0431\u0430 \u043c\u0430\u043b\u0456\u0446\u0446\u0430, \u0430\u043b\u0435 \u0441\u0430\u043c \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043f\u0440\u043e\u0441\u0456\u0446\u044c \u0437\u0430 \u043d\u0430\u0441 \u043d\u0435\u0432\u044b\u043a\u0430\u0437\u043d\u044b\u043c\u0456 \u0441\u0442\u0430\u0433\u043d\u0430\u043d\u043d\u044f\u043c\u0456. \u0422\u0430\u043c\u0443 \u043a\u0430\u0436\u0430\u043c:<br \/><em>\u041d\u044f\u0445\u0430\u0439 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b \u043c\u043e\u043b\u0456\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d, \u043d\u044f\u0431\u0435\u0441\u043d\u044b \u043f\u0430\u0441\u0442\u044b\u0440, \u0443\u0434\u0437\u044f\u043b\u044f\u0439 \u043d\u0430\u0448\u044b\u043c \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u043c \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c \u0456 \u043f\u0430\u0440\u0430\u0434\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0430\u0441\u043f\u044f\u0445\u043e\u0432\u0430 \u0432\u044f\u043b\u0456 \u0422\u0432\u043e\u0439 \u0441\u0442\u0430\u0442\u0430\u043a \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0431\u0430\u0433\u0430\u0442\u044b \u043d\u0430 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435\u0448 \u0443 \u0432\u044b\u0448\u044b\u043d\u044f\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0431\u0435\u0434\u043d\u044b\u0445 \u0456 \u045e\u0431\u043e\u0433\u0456\u0445 \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0417 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u044e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0422\u044b \u0431\u044b\u045e \u0437\u0430\u0447\u0430\u0442\u044b \u0432\u0430 \u045e\u043b\u043e\u043d\u043d\u0456 \u0414\u0437\u0435\u0432\u044b \u041c\u0430\u0440\u044b\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u0434\u0437\u0435\u0432\u0430\u045e \u0443 \u0434\u0443\u0445\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u043f\u0430\u0441\u0432\u044f\u0447\u044d\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448 \u0421\u0432\u044f\u0442\u0430\u0440, \u0422\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u0448 \u0410\u0439\u0446\u0430 \u045e \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u0439 \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0443 \u043f\u0430\u043a\u043b\u0430\u043d\u0435\u043d\u043d\u0456 \u0422\u0430\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f \u0434\u0430\u0441\u044f\u0433\u043d\u0443\u0446\u044c \u0441\u0432\u0430\u0431\u043e\u0434\u044b \u0456 \u0441\u043b\u0430\u0432\u044b \u0434\u0437\u044f\u0446\u0435\u0439 \u0411\u043e\u0436\u044b\u0445<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043f\u043e\u045e\u043d\u0430\u0433\u0430 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f \u0441\u0432\u0430\u0456\u0445 \u0446\u0435\u043b\u0430\u045e.<\/p>\r\n"}, {"NESH_Prosby_ID":"5072","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0437\u0430\u043c \u0437 \u0443\u0441\u0456\u043c\u0456 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u043c\u0456 \u0434\u0437\u044f\u043a\u0443\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0443, \u044f\u043a\u0456 \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u045e\u0432\u0435\u0441\u044c \u041a\u0430\u0441\u0446\u0451\u043b \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435\u043c \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430, \u0456 \u043f\u0440\u043e\u0441\u0456\u043c: <br \/><em>\u041f\u0430\u043d\u0435, \u0441\u0443\u0446\u044f\u0448\u0430\u0439 \u0441\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a \u043f\u0430\u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456, \u0422\u044b \u0432\u044b\u0431\u0440\u0430\u045e \u0441\u0432\u044f\u0442\u0430\u0440\u043e\u045e \u0441\u0432\u0430\u0456\u043c\u0456 \u0441\u0443\u043f\u0440\u0430\u0446\u043e\u045e\u043d\u0456\u043a\u0430\u043c\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0440\u0430\u0431\u0456, \u043a\u0430\u0431 \u0443\u0441\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u043f\u0440\u0430\u0437 \u0456\u0445 \u0434\u0430 \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u0431\u0435\u0434\u043d\u044b\u044f \u0456 \u0431\u0430\u0433\u0430\u0442\u044b\u044f \u0432\u044b\u0439\u0448\u043b\u0456 \u043d\u0430\u0441\u0443\u0441\u0442\u0440\u0430\u0447 \u0422\u0430\u0431\u0435, \u0431\u043e \u0422\u044b \u0411\u043e\u0433 \u0443\u0441\u0456\u0445;<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u044f\u0445\u0430\u0439 \u0431\u0430\u0433\u0430\u0442\u044b\u044f \u043d\u0435 \u0445\u0432\u0430\u043b\u044f\u0446\u0446\u0430 \u0437\u0430\u043c\u043e\u0436\u043d\u0430\u0441\u0446\u044e \u0441\u0432\u0430\u0451\u0439, \u0430\u043b\u0435 \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u044e\u0446\u044c \u0431\u043b\u0456\u0436\u043d\u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u0430\u0436\u044b \u0441\u0432\u0430\u0451 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435 \u045e\u0441\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0443\u0441\u0435 \u043f\u0440\u044b\u0439\u0448\u043b\u0456 \u0434\u0430 \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u0430\u0441\u0446\u0456 \u045e \u0432\u0435\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0448\u043b\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430, \u043d\u0430\u0439\u043b\u0435\u043f\u0448\u0430\u0433\u0430 \u0421\u0443\u0446\u044f\u0448\u044b\u0446\u0435\u043b\u044f,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0401\u043d \u0432\u044b\u0446\u0435\u0440 \u0441\u043b\u0451\u0437\u044b \u045e\u0441\u0456\u0445 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0447\u044b\u0441\u0446\u0456 \u0434\u0443\u0448\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043f\u0440\u044b\u043c\u0456 \u0456\u0445 \u0443 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u044c \u0422\u0432\u0430\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445 \u0456 \u0432\u044b\u0431\u0440\u0430\u043d\u044b\u0445.<\/p>\r\n"}, {"NESH_Prosby_ID":"5073","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0448\u0430\u043d\u0430 \u0456 \u0441\u043b\u0430\u0432\u0430 \u0425\u0440\u044b\u0441\u0442\u0443, \u044f\u043a\u0456 \u0434\u0430\u045e \u0441\u0432\u0430\u0456\u043c \u0432\u0435\u0440\u043d\u044b\u043c \u0443\u0434\u0437\u0435\u043b \u0443 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c, \u0442\u0430\u043c\u0443 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u043c: <br \/><em>\u0425\u0440\u044b\u0441\u0442\u044d, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0448\u043b\u0456 \u0430\u0434 \u0410\u0439\u0446\u0430 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043d\u0430 \u041a\u0430\u0441\u0446\u0451\u043b,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0401\u043d \u0430\u0447\u044b\u0448\u0447\u0430\u045e \u044f\u0433\u043e, \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u045e \u0456 \u043f\u0430\u0448\u044b\u0440\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0432\u044f\u0434\u0437\u0456 \u0441\u0432\u0430\u0456\u043c \u0414\u0443\u0445\u0430\u043c \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0436\u044b\u0446\u0446\u044f\u045e\u043b\u044f\u0435 \u045e\u043b\u0430\u0434\u0443 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u044f\u043d\u044b \u0441\u0442\u0430\u043b\u0456 \u0441\u043b\u0443\u0433\u0430\u043c\u0456 \u0422\u0432\u0430\u0456\u043c\u0456 \u0434\u043b\u044f \u0434\u0430\u0431\u0440\u0430 \u045e\u0441\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041e\u0439\u0447\u0430 \u045e\u0431\u043e\u0433\u0456\u0445, \u0441\u043f\u0430\u0448\u043b\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0401\u043d \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u045e \u0443\u0441\u0456\u0445 \u0431\u0435\u0434\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0437\u0430 \u045e\u0441\u0456\u0445 \u0440\u0430\u0441\u043f\u0430\u0440\u0430\u0434\u0447\u044b\u043a\u0430\u045e \u0422\u0432\u0430\u0456\u0445 \u0442\u0430\u044f\u043c\u043d\u0456\u0446,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u044f\u043d\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0432\u0435\u0440\u043d\u044b\u043c\u0456 \u0422\u0430\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0434\u0437\u0435\u0439\u0441\u043d\u0456 \u0441\u0432\u0430\u0451 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u045e \u0434\u0443\u0448\u0430\u0445 \u0456 \u0446\u0435\u043b\u0430\u0445 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u044f\u043a\u043e\u0435 \u0422\u044b \u045e\u0436\u043e \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u045e \u0441\u0432\u0430\u0451\u0439 \u043c\u0443\u043a\u0430\u0439, \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435\u043c \u0456 \u045e\u043d\u0435\u0431\u0430\u045e\u0448\u044d\u0441\u0446\u0435\u043c.<\/p>\r\n"}, {"NESH_Prosby_ID":"5074","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0411\u043e\u0433\u0430 \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0440\u0430\u0437\u0430\u043c \u0437 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u043c\u0456 \u0456 \u045e\u0441\u0456\u043c\u0456, \u0445\u0442\u043e \u043a\u0430\u0440\u044b\u0441\u0442\u0430\u0435\u0446\u0446\u0430 \u043f\u0435\u0440\u0448\u044b\u043c\u0456 \u0434\u0430\u0440\u0430\u043c\u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430: <br \/><em>\u041f\u0430\u043d\u0435, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0411\u043e\u0436\u0430, \u0422\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u0432\u0456\u045e \u0443 \u043d\u0435\u0431\u0435 \u0425\u0440\u044b\u0441\u0442\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u0443\u0441\u0435 \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u042f\u0433\u043e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0432\u044f\u0442\u044b \u041e\u0439\u0447\u0430, \u0422\u044b \u0441\u043a\u0430\u0437\u0430\u045e \u043f\u0440\u0430 \u0425\u0440\u044b\u0441\u0442\u0430: &laquo;\u0413\u044d\u0442\u0430 \u0421\u044b\u043d \u043c\u043e\u0439 \u0443\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u044b, \u042f\u0433\u043e \u0441\u043b\u0443\u0445\u0430\u0439\u0446\u0435&raquo;,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u0443\u0441\u0435 \u043f\u0430\u0447\u0443\u043b\u0456 \u042f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0441 \u0456 \u0437\u0431\u0430\u0432\u0456\u043b\u0456\u0441\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0448\u043b\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u045e \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u0445 \u0432\u0435\u0440\u043d\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0401\u043d \u0430\u0431\u043c\u044b\u045e \u0442\u043e\u0435, \u0448\u0442\u043e \u0431\u0440\u0443\u0434\u043d\u0430\u0435, \u0456 \u0430\u0440\u0430\u0441\u0456\u045e, \u0442\u043e\u0435 \u0448\u0442\u043e \u0441\u0430\u0441\u043c\u044f\u0433\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u043f\u0440\u044b\u0439\u0434\u0437\u0435 \u0414\u0443\u0445 \u0422\u0432\u043e\u0439, \u043a\u0430\u0431 \u043a\u0456\u0440\u0430\u0432\u0430\u0446\u044c \u043d\u0430\u0448\u044b\u043c \u0447\u0430\u0441\u0430\u043c<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0430\u0434\u043d\u0430\u0432\u0456\u0446\u044c \u0437\u044f\u043c\u043b\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0431\u0435 \u0434\u0430\u0440\u0443\u0447\u0430\u0435\u043c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u043a\u0430\u0431 \u0422\u044b \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u045e \u043d\u0430\u0448\u0443 \u043d\u0430\u0434\u0437\u0435\u044e \u043d\u0430 \u0431\u0443\u0434\u0443\u0447\u0430\u0435 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435.<\/p>\r\n"}, {"NESH_Prosby_ID":"5075","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0451\u043d\u0430\u0433\u0430 \u043d\u0430\u0432\u0435\u043a\u0456, \u043a\u0430\u0431 \u0401\u043d \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430 \u045e\u0441\u0456\u0445 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u0445 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430: <br \/><em>\u041f\u0430\u043d\u0435, \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u045e\u0441\u0456\u0445, \u043a\u0430\u0433\u043e \u0422\u044b \u0430\u0434\u043a\u0443\u043f\u0456\u045e.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0448\u043b\u0456 \u043d\u0430 \u041a\u0430\u0441\u0446\u0451\u043b \u0414\u0443\u0445\u0430 \u0430\u0434\u0437\u0456\u043d\u0441\u0442\u0432\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0437\u043d\u0456\u043a\u043b\u0456 \u043d\u044f\u0437\u0433\u043e\u0434\u0430, \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0456 \u043f\u0430\u0434\u0437\u0435\u043b\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u045e \u043b\u044e\u0434\u0437\u0435\u0439 \u0437-\u043f\u0430\u0434 \u0443\u043b\u0430\u0434\u044b \u0437\u043b\u044b\u0445 \u0434\u0443\u0445\u0430\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0432\u044b\u0437\u0432\u0430\u043b\u0456 \u0441\u0432\u0435\u0442 \u0430\u0434 \u0437\u043b\u0430, \u044f\u043a\u043e\u0435 \u044f\u0433\u043e \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u0430\u0437 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u045e \u043c\u043e\u0446 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0434\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u0437\u0431\u0430\u045e\u0447\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u0441\u0432\u044f\u0442\u0430\u0440\u044b \u043f\u0440\u0430\u0437 \u043c\u0430\u043b\u0456\u0442\u0432\u0443 \u0430\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u043b\u0456 \u043d\u0430\u0442\u0445\u043d\u0435\u043d\u043d\u0435 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u045e \u0441\u043f\u0430\u045e\u043d\u0435\u043d\u043d\u0456 \u0441\u0432\u0430\u0456\u0445 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0456\u0445 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0422\u0432\u043e\u0439 \u0414\u0443\u0445 \u043a\u0456\u0440\u0443\u0435 \u045e\u0441\u0456\u043c\u0456, \u0445\u0442\u043e \u0430\u0436\u044b\u0446\u0446\u044f\u045e\u043b\u044f\u0435 \u045e\u043b\u0430\u0434\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u044f\u043d\u044b \u0448\u0443\u043a\u0430\u043b\u0456 \u0430\u0433\u0443\u043b\u044c\u043d\u0430\u0433\u0430 \u0434\u0430\u0431\u0440\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0436\u044b\u0432\u0435\u0448 \u0443 \u0441\u043b\u0430\u0432\u0435 \u0410\u0439\u0446\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0430\u043a\u043b\u0456\u0447 \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445.<\/p>\r\n"}, {"NESH_Prosby_ID":"5076","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u0441\u043f\u0430\u0441\u043b\u0430\u045e \u043d\u0430 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u043b\u0430\u0441\u043a\u0443 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430. \u041f\u0440\u043e\u0441\u0456\u043c, \u043a\u0430\u0431 \u043c\u044b \u0437 \u043a\u043e\u0436\u043d\u044b\u043c \u0434\u043d\u0451\u043c \u043f\u0435\u0440\u0430\u043f\u0430\u045e\u043d\u044f\u043b\u0456\u0441\u044f \u0451\u0439: <br \/><em>\u041f\u0430\u043d\u0435, \u043d\u044f\u0445\u0430\u0439 \u043f\u0430\u0448\u044b\u0440\u044b\u0446\u0446\u0430 \u043b\u0430\u0441\u043a\u0430 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0422\u044b \u0437\u0440\u0430\u0431\u0456\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u043c\u0456\u043b\u0430\u0432\u0430\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0434\u043a\u0440\u044b\u0439 \u0432\u043e\u0447\u044b \u043d\u0435\u0432\u0456\u0434\u0443\u0448\u0447\u044b\u043c \u0456 \u0432\u044b\u0432\u0435\u0434\u0437\u0456 \u0437 \u0434\u043e\u043c\u0443 \u043d\u044f\u0432\u043e\u043b\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u0443 \u0446\u0435\u043c\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u043c\u043e\u0446\u0430\u044e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u0447\u0430\u0433\u0430 \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u044f,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u0401\u043d \u0437\u043d\u043e\u045e \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u043d\u0430 \u0437\u044f\u043c\u043b\u044e, \u0440\u043e\u0431\u044f\u0447\u044b \u0434\u0430\u0431\u0440\u043e \u0456 \u0430\u0437\u0434\u0430\u0440\u0430\u045e\u043b\u044f\u044e\u0447\u044b \u045e\u0441\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0448\u043b\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430, \u0441\u0432\u044f\u0442\u043b\u043e \u0441\u044d\u0440\u0446\u0430\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0401\u043d \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u043c\u0430\u0435 \u0441\u043b\u0430\u0431\u0443\u044e \u0432\u0435\u0440\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0430\u0448\u043b\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430, \u044f\u043a\u0456 \u0451\u0441\u0446\u044c \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0430\u043c \u0443 \u043f\u0440\u0430\u0446\u044b,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0401\u043d \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u0430\u045e \u0437\u043d\u044f\u0441\u0456\u043b\u0435\u043d\u044b\u0445 \u0456 \u0437\u043b\u0430\u043c\u0430\u043d\u044b\u0445 \u0434\u0443\u0445\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u043e\u045e\u043d\u0456 \u043d\u0430\u0434\u0437\u0435\u044e \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043f\u0430\u0434\u0447\u0430\u0441 \u043f\u0440\u044b\u0439\u0441\u0446\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435.<\/p>\r\n"}, {"NESH_Prosby_ID":"5080","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0411\u043e\u0433\u0430, \u0433\u043e\u0434\u043d\u0430\u0433\u0430 \u0432\u044f\u043b\u0456\u043a\u0430\u0439 \u0445\u0432\u0430\u043b\u044b, \u044f\u043a\u0456 \u045e \u0434\u0437\u0435\u043d\u044c \u041f\u044f\u0446\u0456\u0434\u0437\u0435\u0441\u044f\u0442\u043d\u0456\u0446\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0437 \u043d\u044f\u0431\u0451\u0441\u0430\u045e, \u0456 \u045e \u043f\u0430\u043a\u043e\u0440\u044b \u0456 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u043e\u0441\u0456\u043c: <br \/><em>\u0421\u043f\u0430\u0448\u043b\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u0456 \u0430\u0434\u043d\u0430\u0432\u0456 \u0437\u044f\u043c\u043b\u044e.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043d\u0430 \u043f\u0430\u0447\u0430\u0442\u043a\u0443 \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0435\u0431\u0430 \u0456 \u0437\u044f\u043c\u043b\u044e, \u0430 \u043a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u043b\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u0430 \u0447\u0430\u0441\u0443, \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u0443\u0441\u0451 \u045e \u0425\u0440\u044b\u0441\u0446\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;&nbsp; <\/span>\u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0439 \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0437\u044f\u043c\u043b\u0456 \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u045e\u0434\u044b\u0445\u043d\u0443\u045e \u0443 \u0410\u0434\u0430\u043c\u0430 \u043f\u043e\u0434\u044b\u0445 \u0436\u044b\u0446\u0446\u044f,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0441\u043f\u0430\u0448\u043b\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u045e \u041a\u0430\u0441\u0446\u0451\u043b, \u043a\u0430\u0431 \u0401\u043d \u0443 \u0406\u043c \u0436\u044b\u045e \u0456 \u0430\u0436\u044b\u045e\u043b\u044f\u045e \u0441\u0432\u0435\u0442.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0441\u0432\u044f\u0442\u043b\u044f\u0439 \u0441\u0432\u044f\u0442\u043b\u043e\u043c \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0456 \u0440\u0430\u0441\u0441\u0435\u0439\u0432\u0430\u0439 \u0437\u043c\u0440\u043e\u043a \u043d\u0430\u0448\u0430\u0433\u0430 \u0447\u0430\u0441\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043d\u044f\u043d\u0430\u0432\u0456\u0441\u0446\u044c \u0430\u0431\u044f\u0440\u043d\u0443\u043b\u0430\u0441\u044f \u045e \u043b\u044e\u0431\u043e\u045e, \u0441\u043c\u0443\u0442\u0430\u043a &ndash; \u0443 \u0440\u0430\u0434\u0430\u0441\u0446\u044c, \u0430 \u0432\u0430\u0439\u043d\u0430 &ndash; \u0443 \u0436\u0430\u0434\u0430\u043d\u044b \u0441\u043f\u0430\u043a\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0440\u0430\u0441\u0456 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u044b \u0440\u043e\u0434 \u0432\u0430\u0434\u043e\u044e \u0414\u0443\u0445\u0430 \u0441\u0432\u0430\u0439\u0433\u043e, \u044f\u043a\u0430\u044f \u0432\u044b\u0446\u044f\u043a\u0430\u0435 \u0437 \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u0430\u0433\u0430 \u0431\u043e\u043a\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u044f\u043d\u0430 \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u043b\u0430 \u043d\u0430\u0448\u0443 \u0437\u044f\u043c\u043b\u044e \u0430\u0434 \u0443\u0441\u044f\u043a\u0456\u0445 \u0446\u0435\u0440\u043d\u044f\u045e \u0433\u0440\u0430\u0445\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0422\u044b \u043f\u0440\u044b\u0432\u043e\u0434\u0437\u0456\u0448 \u043b\u044e\u0434\u0437\u0435\u0439 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u0430\u0437 \u042f\u0433\u043e \u0434\u0430\u0439 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c \u0446\u0435\u0448\u044b\u0446\u0446\u0430 \u045e \u043d\u044f\u0431\u0435\u0441\u043d\u0430\u0439 \u0430\u0439\u0447\u044b\u043d\u0435 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n"}, {"NESH_Prosby_ID":"5081","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u043e\u0441\u0456\u043c \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0425\u0440\u044b\u0441\u0442\u0430 \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u045e \u0441\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b: <br \/><em>\u0421\u043f\u0430\u0448\u043b\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043d\u0430 \u041a\u0430\u0441\u0446\u0451\u043b.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0445\u043e\u0447\u0430\u0448 \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u0446\u044c \u0443 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u044b\u043c \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b\u0445 \u0443 \u0445\u0440\u043e\u0441\u0446\u0435 \u0456\u043c\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u043e\u0432\u044b\u043c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0432\u0435\u0440\u043d\u044b\u0445 \u0431\u044b\u043b\u043e \u0430\u0434\u043d\u043e \u0441\u044d\u0440\u0446\u0430 \u0456 \u0430\u0434\u0437\u0456\u043d \u0434\u0443\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u045e \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0443\u0441\u044e \u0437\u044f\u043c\u043b\u044e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u043a\u0430\u0431 \u044f\u043d\u044b \u0431\u0443\u0434\u0430\u0432\u0430\u043b\u0456 \u0433\u044d\u0442\u044b \u0441\u0432\u0435\u0442 \u0443 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u0411\u043e\u0436\u0430, \u041e\u0439\u0447\u0430 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439, \u0422\u044b \u0445\u043e\u0447\u0430\u0448 \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u0446\u044c \u0443 \u0432\u0435\u0440\u044b \u045e\u0441\u0456\u0445 \u0440\u0430\u0441\u0441\u0435\u044f\u043d\u044b\u0445 \u0434\u0437\u044f\u0446\u0435\u0439,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0439 \u0441\u0432\u0435\u0442 \u043b\u0430\u0441\u043a\u0430\u044e \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435\u0448 \u0443\u0441\u0451 \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u044e \u0414\u0443\u0445