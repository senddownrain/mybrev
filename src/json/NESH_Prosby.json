\u0417\u0431\u0430\u045e\u0446\u044b.<\/p>\r\n<p>\u0417\u0430 \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0430\u045e, \u044f\u043a\u0456\u044f \u0446\u0435\u0440\u043f\u044f\u0446\u044c \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0446\u044f\u0440\u043f\u043b\u0456\u0432\u0430 \u0437\u043d\u043e\u0441\u0456\u043b\u0456 \u043a\u0440\u044b\u045e\u0434\u044b \u0434\u0437\u0435\u043b\u044f \u0456\u043c\u0435\u043d\u0456 \u0417\u0431\u0430\u045e\u0446\u044b.<\/p>\r\n<p>\u0417\u0430 \u043d\u0430\u0448\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e, \u044f\u043a\u0456\u044f \u043f\u0430\u043c\u0435\u0440\u043b\u0456 \u0437 \u0432\u0456\u043d\u044b \u043b\u044e\u0434\u0437\u0435\u0439,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u0422\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n"}, {"NESH_Prosby_ID":"461","NESH_Prosby_Text":"\r\n<p>\u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u043f\u0440\u044b\u0439\u0441\u0446\u0435 \u0425\u0440\u044b\u0441\u0442\u0443\u0441 \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u0441\u0432\u044f\u0442\u044b \u043d\u0430\u0440\u043e\u0434 \u0411\u043e\u0436\u044b. \u0422\u0430\u043c\u0443 \u0437 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u0439 \u0437\u0432\u0435\u0440\u043d\u0435\u043c\u0441\u044f \u0434\u0430 \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u044b: <br \/><em>\u041d\u044f\u0445\u0430\u0439 \u0422\u0432\u0430\u0451 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u045e\u0437\u0440\u0430\u0434\u0443\u0435 \u0441\u0432\u0435\u0442.<\/em><\/p>\r\n<p>\u0425\u0440\u044b\u0441\u0442\u044d, \u043d\u0430\u0448\u0430\u0435 \u0436\u044b\u0446\u0446\u0451, \u0422\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043a\u0430\u0431 \u0441\u0442\u0430\u0446\u044c \u0413\u0430\u043b\u0430\u0432\u043e\u044e \u041a\u0430\u0441\u0446\u0451\u043b\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u044f\u0445\u0430\u0439 \u041a\u0430\u0441\u0446\u0451\u043b, \u0422\u0432\u0430\u0451 \u0446\u0435\u043b\u0430, \u0443\u0437\u0440\u0430\u0441\u0442\u0430\u0435 \u045e \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p>\u0422\u044b \u043f\u0430\u043a\u0456\u043d\u0443\u045e \u043d\u0430\u043c \u043d\u0430\u043a\u0430\u0437 \u043f\u0430\u043a\u043b\u0430\u043d\u044f\u0446\u0446\u0430 \u0422\u0430\u0431\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0436\u044b \u043d\u0430\u043c \u0430\u0442\u0440\u044b\u043c\u0430\u0446\u044c \u0443\u0434\u0437\u0435\u043b \u0443 \u0422\u0432\u0430\u0451\u0439 \u0431\u043e\u0441\u043a\u0430\u0441\u0446\u0456.<\/p>\r\n<p>\u0422\u044b \u043f\u0440\u0430\u0437 \u0443\u0446\u0435\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0441\u0442\u0430\u045e \u041f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u043c \u043c\u0456\u0436 \u0411\u043e\u0433\u0430\u043c \u0456 \u043b\u044e\u0434\u0437\u044c\u043c\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u044f\u0445\u0430\u0439 \u043f\u0440\u0430\u0437 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c \u0436\u044b\u0446\u0446\u044f \u0441\u043b\u0443\u0433\u0456 \u041a\u0430\u0441\u0446\u0451\u043b\u0430 \u0434\u0437\u0435\u0439\u0441\u043d\u0430 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u044e\u0446\u044c \u0441\u0432\u043e\u0439 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a.<\/p>\r\n<p>\u0422\u044b \u0441\u0432\u0430\u0456\u043c \u043f\u0440\u044b\u0439\u0441\u0446\u0435\u043c \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u0441\u0432\u0435\u0442, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u045e