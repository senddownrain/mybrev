u0439\u0446\u0435\u0446 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0426\u044f\u0431\u0435 \u045e \u043d\u043e\u0432\u044b\u043c \u0437\u0430\u043f\u0430\u0432\u0435\u0446\u0435 \u0434\u043b\u044f \u0430\u0441\u0432\u044f\u0442\u043b\u0435\u043d\u043d\u044f \u043d\u0430\u0440\u043e\u0434\u0430\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0434\u043a\u0440\u044b\u0439 \u0432\u043e\u0447\u044b \u0441\u043b\u044f\u043f\u044b\u0445 \u0432\u0430\u0434\u043e\u044e \u0445\u0440\u043e\u0441\u0442\u0443.<\/p>\r\n<p>\u0425\u0440\u044b\u0441\u0442\u044d, \u0417\u0431\u0430\u045e\u0446\u0430 \u043b\u044e\u0434\u0437\u0435\u0439, \u0410\u0439\u0446\u0435\u0446 \u043d\u0430\u043c\u0430\u0441\u0446\u0456\u045e \u0426\u044f\u0431\u0435 \u0414\u0443\u0445\u0430\u043c \u0421\u0432\u044f\u0442\u044b\u043c \u0434\u043b\u044f \u043f\u0430\u0441\u043b\u0443\u0433\u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435 \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0426\u044f\u0431\u0435 \u0456 \u043f\u0440\u0430\u0437 \u0432\u0435\u0440\u0443 \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u0432\u0435\u0447\u043d\u0430\u0435 \u0436\u044b\u0446\u0446\u0451.<\/p>\r\n<p>\u0425\u0440\u044b\u0441\u0442\u044d, \u043d\u0430\u0448\u0430 \u043d\u0430\u0434\u0437\u0435\u044f, \u0422\u044b \u0432\u044b\u0432\u043e\u0434\u0437\u0456\u0448 \u043b\u044e\u0434\u0437\u0435\u0439 \u0441\u0430 \u0437\u043c\u0440\u043e\u043a\u0443 \u0434\u0430 \u0441\u0432\u044f\u0442\u043b\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u044b\u043c\u0456 \u043d\u0430\u0448\u044b\u0445 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0443 \u0441\u0432\u0430\u0451 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n"}, {"NESH_Prosby_ID":"5011","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043f\u0430\u043c\u0451\u0440, \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441: <br \/><em>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u0412\u0430\u043b\u0430\u0434\u0430\u0440-\u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d, \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u043f\u0430\u043b\u0456 \u0430\u0433\u043e\u043d\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0422\u0432\u0430\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u045e \u0422\u0430\u0431\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u041c\u0435\u0441\u0456\u044e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u045e\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u0422\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u043d\u0430\u0441 \u0443 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0422\u0432\u0430\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0434\u0430\u0439 \u043d\u0430\u043c \u0430\u0434\u043f\u0430\u0447\u044b\u0446\u044c \u0430\u0434 \u043d\u0430\u0448\u0430\u0439 \u043f\u0440\u0430\u0446\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0440\u0430\u0437\u0431\u0456\u045e \u0443 \u043d\u0430\u0441 \u044f\u0435 \u0432\u0430\u0440\u043e\u0436\u0430\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043c\u044b \u0436\u044b\u043b\u0456 \u0434\u043b\u044f \u0426\u044f\u0431\u0435, \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d \u0417\u0431\u0430\u045e\u0446\u0430, \u0422\u044b \u0441\u0442\u0430\u045e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0430\u0436 \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0431\u044b\u045e \u0443\u0437\u0432\u044b\u0448\u0430\u043d\u044b \u0434\u0430 \u043f\u0440\u0430\u0432\u0456\u0446\u044b \u0410\u0439\u0446\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u043f\u0440\u044b\u043c\u0456 \u0441\u0432\u0430\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0443 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n"}, {"NESH_Prosby_ID":"5012","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443 \u044f\u043a\u043e\u0433\u0430 \u0430\u0436\u044b\u045e\u043b\u044f\u045e \u0456 \u0440\u0430\u0431\u0456\u045e \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u0430\u0439 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b: <br \/><em>\u041f\u0430\u043d\u0435, \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0439 \u0456 \u0430\u0436\u044b\u045e\u043b\u044f\u0439 \u0443\u0441\u0451.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d, \u0417\u0431\u0430\u045e\u0446\u0430 \u0441\u0432\u0435\u0442\u0443, \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u043d\u043e\u0432\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u0441\u043a\u0456\u0440\u0443\u0439 \u043d\u0430\u0448\u044b\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0434\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0437\u0435 \u0422\u044b \u0441\u044f\u0434\u0437\u0456\u0448 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0422\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0436\u044b\u0432\u0435\u0448 \u0443 \u0441\u0432\u0430\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0439 \u044f\u0433\u043e \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0434\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u044f\u0432\u0456 \u0441\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0445\u0432\u043e\u0440\u044b\u0445, \u0446\u0435\u0440\u043f\u044f\u0447\u044b\u0445 \u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0443\u0441\u0435 \u0441\u0443\u0446\u0435\u0448\u044b\u043b\u0456\u0441\u044f \u0456 \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0422\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u045e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d, \u043d\u0435\u043f\u0430\u0433\u0430\u0441\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u043d\u0430 \u0441\u0445\u0456\u043b\u0435 \u0434\u043d\u044f \u043c\u044b \u0430\u0445\u0432\u044f\u0440\u0443\u0435\u043c \u0422\u0430\u0431\u0435 \u0441\u0432\u0430\u044e \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u0446\u044c \u043f\u0440\u0430\u043c\u0435\u043d\u043d\u0435\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u043d\u0430\u0448\u044b\u0445 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e.<\/p>\r\n"}, {"NESH_Prosby_ID":"5013","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0434\u0430\u0441\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0443, \u044f\u043a\u0456, \u0432\u044b\u0439\u0448\u0430\u045e\u0448\u044b \u0437 \u043d\u0435\u0442\u0440\u0430\u045e \u0437\u044f\u043c\u043b\u0456, \u0443\u0431\u0430\u0447\u044b\u045e \u0441\u0432\u044f\u0442\u043b\u043e \u043d\u043e\u0432\u0430\u0439 \u0441\u043b\u0430\u0432\u044b:<br \/><em>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0441\u043b\u0430\u0432\u044b.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0437\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e \u0456 \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u045e, \u043a\u0430\u0431 \u0437 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u0441\u0432\u043e\u0439 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0456 \u0422\u0430\u0431\u0435 \u043d\u0430\u0440\u043e\u0434, \u0440\u0443\u043f\u043bi\u0432\u044b \u0432\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0437\u0430 \u0432\u0443\u0447\u043e\u043d\u044b\u0445, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u0422\u0432\u0430\u0439\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0437 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0448\u0443\u043a\u0430\u043b\u0456 \u0422\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0437\u0430 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043a\u0430\u0431 \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u043b\u0456 \u045e \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0446\u0442\u0432\u0435 \u0432\u0435\u0440\u044b<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456, \u0437\u0430\u0432\u044f\u0440\u0448\u0430\u044e\u0447\u044b \u0431\u0435\u0433, \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u044b\u0431\u0456\u045e \u043d\u0430 \u043a\u0440\u044b\u0436 \u043d\u0430\u0448 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b \u043f\u0440\u044b\u0441\u0443\u0434 \u0456 \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u045e \u044f\u0433\u043e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0440\u0430\u0437\u0430\u0440\u0432\u0456 \u043d\u0430\u0448\u044b\u044f \u043a\u0430\u0439\u0434\u0430\u043d\u044b \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456 \u043d\u0430\u0441 \u0437 \u0446\u0435\u043c\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0437\u044b\u0448\u043e\u045e \u0443 \u0430\u0434\u0445\u043b\u0430\u043d\u044c \u0456 \u0430\u0434\u043a\u0440\u044b\u045e \u044f\u0435 \u0431\u0440\u0430\u043c\u044b,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0443\u0441\u0446\u0456 \u043d\u0430\u0448\u044b\u0445 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n"}, {"NESH_Prosby_ID":"5014","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u0440\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0456 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0410\u0439\u0446\u0430:<br \/><em>\u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0436\u044b\u0432\u044b, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439, \u041f\u0430\u043d\u0435, \u043f\u0440\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0422\u0430\u0431\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u044f\u043d\u044b \u0434\u0430\u0432\u0430\u043b\u0456 \u0422\u0432\u0430\u0439\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0436\u044b\u0446\u0446\u044f \u045e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0434\u0437\u044f\u043b\u0456 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c \u0434\u0437\u044f\u0440\u0436\u0430\u045e \u0434\u0443\u0445\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e,<br \/><span style=\"color: #ff0000;\">&ndash; <\/span>\u043a\u0430\u0431 \u0443\u0441\u0451 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u0442\u0432\u0430 \u0436\u044b\u043b\u043e \u045e \u0437\u0433\u043e\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0430\u0440\u044b \u043d\u0430\u0441 \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442\u0430\u043c \u0443 \u043d\u0430\u0448\u044b\u043c \u0447\u0430\u0441\u043e\u0432\u044b\u043c \u0436\u044b\u0446\u0446\u0456<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0437\u0440\u0430\u0431\u0456 \u0437\u044f\u043c\u043b\u044e \u045e\u0440\u0430\u0434\u043b\u0456\u0432\u0430\u0439, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0446\u044f\u0440\u043f\u0435\u045e \u043d\u044f\u0441\u0442\u0430\u0447\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d \u0417\u0431\u0430\u045e\u0446\u0430, \u0422\u044b \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u0443\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u043a\u043e\u0436\u043d\u0430\u0435 \u0442\u043b\u0435\u043d\u043d\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u043d\u0430\u0448\u044b\u043c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c \u0431\u0440\u0430\u0442\u0430\u043c \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0422\u0432\u0430\u0451 \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e.<\/p>\r\n"}, {"NESH_Prosby_ID":"5015","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0456 \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u044f\u043a \u043f\u0435\u0440\u0448\u044b\u043d\u0435\u0446 \u0441\u044f\u0440\u043e\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u043f\u0430\u0447\u044b\u045e:<br \/><em>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439, \u0425\u0440\u044b\u0441\u0442\u044d, \u043f\u0440\u0430 \u0441\u0432\u043e\u0439 \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a\u0456 \u0422\u044b \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u043d\u0430 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u043f\u0430\u0448\u044b\u0440\u044b\u045e \u0430\u0436 \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u0435\u043a\u0430\u0440 \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u0448 \u0456 \u0446\u0435\u043b\u0430\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u0430\u0432\u0435\u0434\u0430\u0439 \u043d\u0430\u0441 \u0456 \u0437\u0431\u0430\u045e \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u045e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u0456 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0439 \u0445\u0432\u043e\u0440\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0439 \u0456\u0445 \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0431\u043e\u043b\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u043d\u044f\u043c\u043e\u0433 \u0430\u0434 \u0441\u043c\u0443\u0442\u043a\u0443 \u0456 \u043f\u0440\u044b\u0433\u043d\u0451\u0442\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u0446\u0435\u0440\u043f\u044f\u0447\u044b\u0445 \u0456 \u045e\u0431\u043e\u0433\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u0432\u043e\u0439 \u043a\u0440\u044b\u0436 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0422\u044b \u0430\u0434\u043a\u0440\u044b\u045e \u0443\u0441\u0456\u043c \u0448\u043b\u044f\u0445 \u0434\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u043d\u0430\u0448\u044b\u043c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c \u0431\u0440\u0430\u0442\u0430\u043c \u0441\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u0446\u044f\u045e \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n"}, {"NESH_Prosby_ID":"5016","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u0434\u0430\u0440\u043e\u0433\u0443, \u043f\u0440\u0430\u045e\u0434\u0443 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0434\u0430 \u042f\u0433\u043e:<br \/><em>\u0421\u044b\u043d\u0435 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u045e\u0441\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u0422\u0432\u0430\u0439\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043a\u0430\u0431, \u0434\u0437\u0435\u043b\u044f\u0447\u044b\u0441\u044f \u0437 \u0431\u0440\u0430\u0442\u0430\u043c\u0456 \u0445\u043b\u0435\u0431\u0430\u043c \u0436\u044b\u0446\u0446\u044f,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u044f\u043d\u044b \u0436\u044b\u0432\u0456\u043b\u0456\u0441\u044f \u0456 \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u043b\u0456\u0441\u044f \u0441\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0437\u0430 \u045e\u0432\u0435\u0441\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456 \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u0431 \u0451\u043d \u0433\u043e\u0434\u043d\u0430 \u0436\u044b\u045e \u0443 \u0422\u0432\u0430\u0456\u043c \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0456<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0441\u043b\u0443\u0436\u044b\u045e \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u045e \u043f\u043e\u0432\u044f\u0437\u0456 \u0441\u043f\u0430\u043a\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0437\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u043a\u0456\u0440\u0443\u0435 \u043d\u0430\u043c\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043f\u0430\u043c\u0456\u0436 \u0443\u0441\u0456\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456 \u045e\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u043b\u0430\u0441\u044f \u0437\u0433\u043e\u0434\u0430 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u0437\u0440\u0430\u0431\u0456 \u043d\u0430\u0441 \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435 \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0443 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u044f\u0442\u044b\u0445<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u0448\u044b\u043c\u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c\u0456 \u0431\u0440\u0430\u0442\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u043c\u044b \u0434\u0430\u0440\u0443\u0447\u0430\u0435\u043c \u0422\u0432\u0430\u0451\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456.<\/p>\r\n"}, {"NESH_Prosby_ID":"5020","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0430\u0431\u043d\u0430\u0432\u0456\u045e \u0436\u044b\u0446\u0446\u0451:<br \/><em>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u0425\u0440\u044b\u0441\u0442\u044d, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435\u0448 \u043d\u0430\u0432\u0435\u043a\u0456.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043a\u0430\u043c\u0435\u043d\u044c, \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u0432\u0443\u0433\u043b\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0431\u0443\u0434\u0443\u0439 \u0437 \u043d\u0430\u0441, \u0436\u044b\u0432\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u0441\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0432\u0435\u0434\u043a\u0430 \u0432\u0435\u0440\u043d\u044b \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b, \u043f\u0435\u0440\u0448\u044b\u043d\u0435\u0446 \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0441\u0432\u0430\u0439\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0430\u0434\u0437\u0456\u043d\u044b \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0448\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0422\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0431\u0456\u0442\u0430\u0433\u0430 \u0431\u043e\u043a\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0440\u0430\u0431\u0456 \u043d\u0430\u0441 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456 \u0433\u044d\u0442\u0430\u0439 \u0432\u044f\u0441\u0435\u043b\u044c\u043d\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0435\u0440\u0448\u044b \u0456 \u0430\u043f\u043e\u0448\u043d\u0456, \u0431\u044b\u045e \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c, \u0456 \u0436\u044b\u0432\u0435\u0448,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0432\u0435\u0440\u0443 \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0432\u044f\u043d\u043e\u043a \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u043f\u0430\u0445\u043e\u0434\u043d\u044f \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0439 \u043d\u0430\u0448\u044b\u0445 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u043b\u0456 \u0437 \u0422\u0430\u0431\u043e\u0439 \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n"}, {"NESH_Prosby_ID":"5021","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u0440\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u045e\u0437\u043d\u0451\u0441 \u042f\u0433\u043e \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0432\u0456\u0446\u044b:<br \/><em>\u041f\u0430\u043d\u0435, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u043f\u0440\u0430\u0437 \u0441\u043b\u0430\u0432\u0443 \u0425\u0440\u044b\u0441\u0442\u0430.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u041e\u0439\u0447\u0430, \u0422\u044b \u045e\u0437\u0432\u044b\u0441\u0456\u045e \u0415\u0437\u0443\u0441\u0430 \u043f\u0440\u0430\u0437 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043a\u0440\u044b\u0436\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0440\u0430\u0431\u0456, \u043a\u0430\u0431 \u0401\u043d \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u045e \u0434\u0430 \u0441\u044f\u0431\u0435 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0421\u044b\u043d\u0430, \u0443\u0437\u0432\u044b\u0448\u0430\u043d\u0430\u0433\u0430 \u0422\u0430\u0431\u043e\u0439, \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u0439 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043d\u0430 \u041a\u0430\u0441\u0446\u0451\u043b, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0451\u043d \u0441\u0442\u0430\u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043c \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u045e\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u043e\u0432\u0430\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u0422\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u043f\u0440\u0430\u0437 \u0432\u0430\u0434\u0443 \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0432\u0435\u0440\u043d\u044b\u043c \u043b\u0430\u0441\u0446\u044b \u0445\u0440\u043e\u0441\u0442\u0443 \u0434\u043b\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u0445, \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0439 \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b\u0445 \u0456 \u043b\u044f\u0447\u044b \u0445\u0432\u043e\u0440\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0440\u0430\u0434\u0443\u0439 \u0441\u0432\u0435\u0442 \u0441\u0432\u0430\u0456\u043c\u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u044f\u043a\u0456\u043c \u0422\u044b \u0434\u0430\u0432\u0430\u045e \u0426\u0435\u043b\u0430 \u0456 \u041a\u0440\u043e\u045e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e\u0434\u0437\u0435\u043b \u0443 \u042f\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0456.<\/p>\r\n"}, {"NESH_Prosby_ID":"5022","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u0441\u0432\u0435\u0442 \u0441\u0432\u0430\u0456\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435\u043c:<br \/><em>\u0425\u0440\u044b\u0441\u0442\u044d, \u0436\u044b\u0446\u0446\u0451 \u043d\u0430\u0448\u0430, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0422\u044b \u0434\u0430\u043b\u0443\u0447\u044b\u045e\u0441\u044f \u0434\u0430 \u0432\u0443\u0447\u043d\u044f\u045e \u043f\u0430 \u0434\u0430\u0440\u043e\u0437\u0435 \u045e \u042d\u043c\u0430\u0443\u0441,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0431\u0443\u0434\u0437\u044c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0443\u044e\u0447\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0439 \u0441\u0432\u0430\u0456\u043c \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u043c \u0431\u044b\u0446\u044c \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u044b\u043c\u0456 \u0434\u0430 \u0432\u0435\u0440\u044b,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u043b\u0456 \u0426\u044f\u0431\u0435 \u044f\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0443 \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u0430\u0441\u043a\u0430\u0432\u0430 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e \u0426\u044f\u0431\u0435 \u045e \u0434\u0430\u0440\u043e\u0437\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0434\u0430\u0439 \u0456\u043c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0426\u044f\u0431\u0435 \u044f\u043a \u0417\u0431\u0430\u045e\u0446\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u043a\u0440\u044b\u0436 \u0422\u044b \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u045e \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0443 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u0443\u0441\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0443\u0434\u0434\u0437\u044f \u0436\u044b\u0432\u044b\u0445 \u0456 \u043c\u0451\u0440\u0442\u0432\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0434\u0437\u044f\u043b\u0456 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c, \u0448\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0426\u044f\u0431\u0435.<\/p>\r\n"}, {"NESH_Prosby_ID":"5023","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u043d\u0430\u0434\u0437\u0435\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443:<br \/><em>\u0425\u0440\u044b\u0441\u0442\u044d, \u0432\u0435\u0447\u043d\u0430 \u0436\u044b\u0432\u044b, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u0415\u0437\u0443, \u0437 \u0422\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0431\u0456\u0442\u0430\u0433\u0430 \u0431\u043e\u043a\u0443 \u0432\u044b\u0446\u0435\u043a\u043b\u0456 \u043a\u0440\u043e\u045e \u0456 \u0432\u0430\u0434\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0441\u0432\u0430\u0451\u0439 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u041f\u0430\u0441\u0442\u044b\u0440, \u043f\u0430\u0441\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0422\u044b \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a \u041f\u044f\u0442\u0440\u0443, \u044f\u043a\u0456 \u0432\u044b\u0437\u043d\u0430\u045e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0426\u044f\u0431\u0435;<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0439 \u043b\u044e\u0431\u043e\u045e \u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043f\u044b <span style=\"color: #ff0000;\">N.<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0434\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u043c, \u044f\u043a\u0456\u044f \u0440\u044b\u0431\u0430\u0447\u044b\u043b\u0456 \u043d\u0430 \u0432\u043e\u0437\u0435\u0440\u044b, \u0432\u044f\u043b\u0456\u043a\u0456 \u045e\u043b\u043e\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;&nbsp; <\/span>\u043f\u0430\u0448\u043b\u0456 \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0446\u044c \u0456\u0445 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0443\u044e \u043c\u0456\u0441\u0456\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u043c \u043d\u0430 \u0431\u0435\u0440\u0430\u0437\u0435 \u0432\u043e\u0437\u0435\u0440\u0430 \u0445\u043b\u0435\u0431 \u0456 \u0440\u044b\u0431\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;&nbsp; <\/span>\u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0439, \u043a\u0430\u0431 \u043b\u044e\u0434\u0437\u0456 \u0433\u0456\u043d\u0443\u043b\u0456 \u0430\u0434 \u0433\u043e\u043b\u0430\u0434\u0443 \u0437 \u043d\u0430\u0448\u0430\u0439 \u0432\u0456\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443, \u0430\u043f\u043e\u0448\u043d\u0456 \u0410\u0434\u0430\u043c \u0456 \u0436\u044b\u0432\u0430\u0442\u0432\u043e\u0440\u043d\u044b \u0414\u0443\u0445, \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456 \u0434\u0430 \u0441\u044f\u0431\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u043e\u0439 \u0422\u0432\u0430\u0451\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456.<\/p>\r\n"}, {"NESH_Prosby_ID":"5024","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e \u0441\u0432\u0430\u0456\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u044b\u043c \u0421\u044b\u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u045e \u043d\u0430\u043c \u0448\u043b\u044f\u0445 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f:<br \/><em>\u041f\u0440\u0430\u0437 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u0431\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u0445.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430 \u043d\u0430\u0448\u044b\u0445 \u043f\u0440\u043e\u0434\u043a\u0430\u045e, \u0422\u044b \u045e\u0441\u043b\u0430\u0432\u0456\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u0430\u044e\u0447\u044b \u042f\u0433\u043e \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0430\u0431\u0443\u0434\u0437\u0456 \u045e \u043d\u0430\u0441 \u0448\u0447\u044b\u0440\u0430\u0435 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u0447\u0430\u043b\u0456 \u0436\u044b\u0446\u044c \u043d\u043e\u0432\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u044b\u0432\u0451\u045e \u0437\u0430\u0433\u0443\u0431\u043b\u0435\u043d\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0434\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430 \u0456 \u0430\u0445\u043e\u045e\u043d\u0456\u043a\u0430 \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u0448,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u043d\u0430\u0441 \u0432\u0435\u0440\u043d\u044b\u043c\u0456, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u044e \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0432\u044b\u0431\u0440\u0430\u045e \u043f\u0435\u0440\u0448\u044b\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0441\u044f\u0440\u043e\u0434 \u044e\u0434\u044d\u0439\u0441\u043a\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0434\u043a\u0440\u044b\u0439 \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u0456\u0445 \u0430\u0439\u0446\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439 \u043f\u0440\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u0445, \u0441\u0456\u0440\u043e\u0442\u0430\u045e \u0456 \u045e\u0434\u043e\u0432\u0430\u045e<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0422\u0432\u043e\u0439 \u0421\u044b\u043d \u043f\u0430\u044f\u0434\u043d\u0430\u045e \u0437 \u0441\u0430\u0431\u043e\u044e \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u0441\u044f\u0431\u0435 \u0421\u0442\u044d\u0444\u0430\u043d\u0430, \u044f\u043a\u0456 \u0432\u044b\u0437\u043d\u0430\u045e, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0426\u044f\u0431\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u044b\u043c\u0456 \u043d\u0430\u0448\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e, \u0448\u0442\u043e \u0447\u0430\u043a\u0430\u043b\u0456 \u0426\u044f\u0431\u0435 \u0437 \u0432\u0435\u0440\u0430\u0439 \u0456 \u043b\u044e\u0431\u043e\u045e\u044e.<\/p>\r\n"}, {"NESH_Prosby_ID":"5025","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0435\u043c \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u043e\u0433\u0430 \u0411\u043e\u0433 \u0437\u0440\u0430\u0431\u0456\u045e \u0437\u0430\u0434\u0430\u0442\u043a\u0430\u043c \u0443\u0441\u0451\u0439 \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f:<br \/><em>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0445\u0432\u0430\u043b\u044b.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u0415\u0437\u0443, \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0422\u044b \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u043d\u0430\u0441 \u0434\u0430 \u0441\u043b\u0430\u0432\u044b \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0422\u044b \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u0443 \u0432\u0435\u0440\u044b \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0456\u0445 \u0443 \u0441\u0432\u0435\u0442,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e \u0456 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e \u0432\u0435\u0440\u043d\u044b\u043c\u0456 \u0432\u0435\u0441\u0442\u0443\u043d\u0430\u043c\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0422\u044b \u0441\u0442\u0430\u045e \u043d\u0430\u0448\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u0456 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u0435\u043c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0432\u0435\u0440\u043d\u044b\u043c \u044f\u0434\u043d\u0430\u0446\u0446\u0430 \u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u043f\u043e\u0432\u044f\u0437\u0437\u044e \u0432\u0435\u0440\u044b \u0456 \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0422\u044b \u0430\u0437\u0434\u0430\u0440\u0430\u0432\u0456\u045e \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u0430\u0433\u0430 \u043f\u0440\u044b \u0431\u0440\u0430\u043c\u0430\u0445 \u0441\u0432\u044f\u0442\u044b\u043d\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0445\u0432\u043e\u0440\u044b\u0445 \u0456 \u043f\u0430\u043a\u0430\u0436\u044b \u0456\u043c \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0435\u0440\u0448\u044b\u043c \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439 \u0430\u0434\u043e\u043b\u0435\u045e \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0430 \u0426\u044f\u0431\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u045e\u0441\u044f, \u0443\u0434\u0437\u0435\u043b \u0443 \u0422\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u0435.<\/p>\r\n"}, {"NESH_Prosby_ID":"5026","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0423\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u045e\u0441\u044f\u043a\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u043c\u043e\u0446\u044b:<br \/><em>\u041f\u0430\u043d\u0435, \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0439 \u0443 \u0441\u0432\u0435\u0446\u0435 \u0441\u0432\u0430\u0451 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443 \u0417\u0431\u0430\u045e\u0446\u0430, \u0422\u044b \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b \u045e \u0446\u0435\u043b\u0435, \u0430\u043b\u0435 \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b \u045e \u0414\u0443\u0445\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u043d\u0430\u043c, \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c \u0434\u043b\u044f \u0433\u0440\u044d\u0445\u0443, \u0436\u044b\u0446\u044c \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u044e \u0414\u0443\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0414\u043e\u0431\u0440\u0443\u044e \u041d\u0430\u0432\u0456\u043d\u0443 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0436\u044b\u0446\u044c \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0422\u0432\u0430\u0456\u043c \u0414\u0443\u0445\u0430\u043c \u0442\u044b\u043c, \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0431\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u045e\u0441\u044f \u045e\u043b\u0430\u0434\u0430 \u043d\u0430 \u043d\u0435\u0431\u0435 \u0456 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u0422\u044b \u0434\u0430\u045e \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0443 \u0434\u0443\u0445\u0443 \u043f\u0440\u0430\u045e\u0434\u044b \u0441\u044d\u0440\u0446\u044b \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430\u043c\u0456 \u043a\u0456\u0440\u0443\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435\u0448 \u0443\u0441\u0451 \u0456 \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0448 \u043d\u0430\u043c \u0447\u0443\u0439\u043d\u0430 \u0447\u0430\u043a\u0430\u0446\u044c \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u043d\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0433\u043d\u0430 \u0447\u0430\u043a\u0430\u0446\u044c \u043d\u043e\u0432\u0430\u0433\u0430 \u043d\u0435\u0431\u0430 \u0456 \u043d\u043e\u0432\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u0430\u043b\u0435 \u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u0430 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u0430\u0431 \u0433\u044d\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u044b\u0448\u043e\u045e \u0443 \u0430\u0434\u0445\u043b\u0430\u043d\u044c, \u043a\u0430\u0431 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u0446\u044c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c \u0414\u043e\u0431\u0440\u0443\u044e \u041d\u0430\u0432\u0456\u043d\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0431\u0443\u0434\u0437\u044c \u0434\u043b\u044f \u0456\u0445 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u0441\u043b\u0430\u045e\u043d\u0430\u044e \u043d\u0430\u0434\u0437\u0435\u044f\u0439.<\/p>\r\n"}, {"NESH_Prosby_ID":"5030","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0432\u0435\u0440\u0430\u044e \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u043c, \u043f\u0440\u043e\u0441\u044f\u0447\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u0436\u044b\u0446\u0446\u0451 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435:<br \/><em>\u0421\u044b\u043d\u0435 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0441\u044f \u043f\u0440\u0430 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u0422\u0432\u043e\u0439 \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0441\u0432\u044f\u0447\u0430\u0439 \u044f\u0433\u043e, \u043a\u0430\u0431 \u0451\u043d \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u045e \u0422\u0432\u0430\u0451 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0437\u0430 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0435 \u0445\u0432\u0430\u0440\u043e\u0431\u0430, \u0441\u043c\u0443\u0442\u0430\u043a, \u043d\u044f\u0432\u043e\u043b\u044f \u0446\u0456 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u044f\u0445\u0430\u0439 \u044f\u043d\u044b \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u0422\u0430\u0431\u0435 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u0456 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0431\u0456\u045e\u0441\u044f \u0437 \u0422\u0432\u0430\u0451\u0439 \u0434\u0430\u0440\u043e\u0433\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u044f\u0445\u0430\u0439 \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u043b\u0430\u0441\u043a\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u044f \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043d\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430, \u0422\u044b \u0431\u044b\u045e \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b, \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0456 \u0437\u043d\u043e\u045e \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u0448 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u0435\u0442,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0431\u0443\u0434\u0437\u044c \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u044b \u0434\u0430 \u043d\u0430\u0441, \u0433\u0440\u044d\u0448\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0437\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0430\u0434\u044b\u0448\u043e\u045e \u0430\u0434 \u043d\u0430\u0441 \u0443 \u043d\u0430\u0434\u0437\u0435\u0456 \u043d\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435.<\/p>\r\n"}, {"NESH_Prosby_ID":"5031","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043f\u0430\u043c\u0451\u0440, \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441: <br \/><em>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u0412\u0430\u043b\u0430\u0434\u0430\u0440-\u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d, \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u043f\u0430\u043b\u0456 \u0430\u0433\u043e\u043d\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0422\u0432\u0430\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u045e \u0422\u0430\u0431\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u041c\u0435\u0441\u0456\u044e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u045e\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u0422\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u043d\u0430\u0441 \u0443 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0422\u0432\u0430\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0434\u0430\u0439 \u043d\u0430\u043c \u0430\u0434\u043f\u0430\u0447\u044b\u0446\u044c \u0430\u0434 \u043d\u0430\u0448\u0430\u0439 \u043f\u0440\u0430\u0446\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0440\u0430\u0437\u0431\u0456\u045e \u0443 \u043d\u0430\u0441 \u044f\u0435 \u0432\u0430\u0440\u043e\u0436\u0430\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043c\u044b \u0436\u044b\u043b\u0456 \u0434\u043b\u044f \u0426\u044f\u0431\u0435, \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d \u0417\u0431\u0430\u045e\u0446\u0430, \u0422\u044b \u0441\u0442\u0430\u045e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0430\u0436\u043d\u043e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0431\u044b\u045e \u0443\u0437\u0432\u044b\u0448\u0430\u043d\u044b \u0434\u0430 \u043f\u0440\u0430\u0432\u0456\u0446\u044b \u0410\u0439\u0446\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u043f\u0440\u044b\u043c\u0456 \u0441\u0432\u0430\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0443 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n"}, {"NESH_Prosby_ID":"5032","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443 \u044f\u043a\u043e\u0433\u0430 \u0430\u0436\u044b\u045e\u043b\u044f\u045e \u0456 \u0440\u0430\u0431\u0456\u045e \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u0430\u0439 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b: <br \/><em>\u041f\u0430\u043d\u0435, \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0439 \u0456 \u0430\u0436\u044b\u045e\u043b\u044f\u0439 \u0443\u0441\u0451.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d, \u0417\u0431\u0430\u045e\u0446\u0430 \u0441\u0432\u0435\u0442\u0443, \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u043d\u043e\u0432\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u0441\u043a\u0456\u0440\u0443\u0439 \u043d\u0430\u0448\u044b\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0434\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0437\u0435 \u0422\u044b \u0441\u044f\u0434\u0437\u0456\u0448 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0422\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0436\u044b\u0432\u0435\u0448 \u0443 \u0441\u0432\u0430\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0439 \u044f\u0433\u043e \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0434\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u044f\u0432\u0456 \u0441\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0445\u0432\u043e\u0440\u044b\u0445, \u0446\u0435\u0440\u043f\u044f\u0447\u044b\u0445 \u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0443\u0441\u0435 \u0441\u0443\u0446\u0435\u0448\u044b\u043b\u0456\u0441\u044f \u0456 \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0422\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u045e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d, \u043d\u0435\u043f\u0430\u0433\u0430\u0441\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u043d\u0430 \u0441\u0445\u0456\u043b\u0435 \u0434\u043d\u044f \u043c\u044b \u0430\u0445\u0432\u044f\u0440\u0443\u0435\u043c \u0422\u0430\u0431\u0435 \u0441\u0432\u0430\u044e \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u0446\u044c \u043f\u0440\u0430\u043c\u0435\u043d\u043d\u0435\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u043d\u0430\u0448\u044b\u0445 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e.<\/p>\r\n"}, {"NESH_Prosby_ID":"5033","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0434\u0430\u0441\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0443, \u044f\u043a\u0456, \u0432\u044b\u0439\u0448\u0430\u045e\u0448\u044b \u0437 \u043d\u0435\u0442\u0440\u0430\u045e \u0437\u044f\u043c\u043b\u0456, \u0443\u0431\u0430\u0447\u044b\u045e \u0441\u0432\u044f\u0442\u043b\u043e \u043d\u043e\u0432\u0430\u0439 \u0441\u043b\u0430\u0432\u044b:<br \/><em>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0441\u043b\u0430\u0432\u044b.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0437\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e \u0456 \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u045e, \u043a\u0430\u0431 \u0437 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u0441\u0432\u043e\u0439 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0456 \u0422\u0430\u0431\u0435 \u043d\u0430\u0440\u043e\u0434, \u0440\u0443\u043f\u043bi\u0432\u044b \u0432\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0437\u0430 \u043d\u0430\u0432\u0443\u043a\u043e\u045e\u0446\u0430\u045e, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u0422\u0432\u0430\u0439\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0437 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0448\u0443\u043a\u0430\u043b\u0456 \u0422\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0437\u0430 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043a\u0430\u0431 \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u043b\u0456 \u045e \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0446\u0442\u0432\u0435 \u0432\u0435\u0440\u044b<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456, \u0437\u0430\u0432\u044f\u0440\u0448\u0430\u044e\u0447\u044b \u0431\u0435\u0433, \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u044b\u0431\u0456\u045e \u0434\u0430 \u043a\u0440\u044b\u0436\u0430 \u043d\u0430\u0448 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b \u043f\u0440\u044b\u0441\u0443\u0434 \u0456 \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u045e \u044f\u0433\u043e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0440\u0430\u0437\u0430\u0440\u0432\u0456 \u043d\u0430\u0448\u044b\u044f \u043a\u0430\u0439\u0434\u0430\u043d\u044b \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456 \u043d\u0430\u0441 \u0437 \u0446\u0435\u043c\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0437\u044b\u0448\u043e\u045e \u0443 \u0430\u0434\u0445\u043b\u0430\u043d\u044c \u0456 \u0430\u0434\u043a\u0440\u044b\u045e \u044f\u0435 \u0431\u0440\u0430\u043c\u044b,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0443\u0441\u0446\u0456 \u043d\u0430\u0448\u044b\u0445 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n"}, {"NESH_Prosby_ID":"5034","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u0440\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0456 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0410\u0439\u0446\u0430:<br \/><em>\u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0436\u044b\u0432\u044b, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439, \u041f\u0430\u043d\u0435, \u043f\u0440\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0422\u0430\u0431\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u044f\u043d\u044b \u0434\u0430\u0432\u0430\u043b\u0456 \u0422\u0432\u0430\u0439\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0436\u044b\u0446\u0446\u044f \u045e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0434\u0437\u044f\u043b\u0456 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c \u0434\u0437\u044f\u0440\u0436\u0430\u045e \u0434\u0443\u0445\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0443\u0441\u0451 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u0442\u0432\u0430 \u0436\u044b\u043b\u043e \u045e \u0437\u0433\u043e\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0430\u0440\u044b \u043d\u0430\u0441 \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442\u0430\u043c \u0443 \u043d\u0430\u0448\u044b\u043c \u0447\u0430\u0441\u043e\u0432\u044b\u043c \u0436\u044b\u0446\u0446\u0456<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0437\u0440\u0430\u0431\u0456 \u0437\u044f\u043c\u043b\u044e \u045e\u0440\u0430\u0434\u043b\u0456\u0432\u0430\u0439, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0446\u044f\u0440\u043f\u0435\u045e \u043d\u044f\u0441\u0442\u0430\u0447\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d \u0417\u0431\u0430\u045e\u0446\u0430, \u0422\u044b \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u0443\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u043a\u043e\u0436\u043d\u0430\u0435 \u0442\u043b\u0435\u043d\u043d\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u043d\u0430\u0448\u044b\u043c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c \u0431\u0440\u0430\u0442\u0430\u043c \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0422\u0432\u0430\u0451 \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e.<\/p>\r\n"}, {"NESH_Prosby_ID":"5035","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0456 \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u044f\u043a \u043f\u0435\u0440\u0448\u044b\u043d\u0435\u0446 \u0441\u044f\u0440\u043e\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u043f\u0430\u0447\u044b\u045e:<br \/><em>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439, \u0425\u0440\u044b\u0441\u0442\u044d, \u043f\u0440\u0430 \u0441\u0432\u043e\u0439 \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a\u0456 \u0422\u044b \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u043d\u0430 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u043f\u0430\u0448\u044b\u0440\u044b\u045e \u0430\u0436\u043d\u043e \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u0435\u043a\u0430\u0440 \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u0448 \u0456 \u0446\u0435\u043b\u0430\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u0430\u0432\u0435\u0434\u0430\u0439 \u043d\u0430\u0441 \u0456 \u0437\u0431\u0430\u045e \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u045e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u0456 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0439 \u0445\u0432\u043e\u0440\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0439 \u0456\u0445 \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0431\u043e\u043b\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u043d\u044f\u043c\u043e\u0433 \u0430\u0434 \u0441\u043c\u0443\u0442\u043a\u0443 \u0456 \u043f\u0440\u044b\u0433\u043d\u0451\u0442\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u0446\u0435\u0440\u043f\u044f\u0447\u044b\u0445 \u0456 \u045e\u0431\u043e\u0433\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u0432\u043e\u0439 \u043a\u0440\u044b\u0436 i \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0422\u044b \u0430\u0434\u043a\u0440\u044b\u045e \u0443\u0441\u0456\u043c \u0448\u043b\u044f\u0445 \u0434\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u043d\u0430\u0448\u044b\u043c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c \u0431\u0440\u0430\u0442\u0430\u043c \u0441\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u0446\u044f\u045e \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n"}, {"NESH_Prosby_ID":"5036","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u0434\u0430\u0440\u043e\u0433\u0443, \u043f\u0440\u0430\u045e\u0434\u0443 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0434\u0430 \u042f\u0433\u043e:<br \/><em>\u0421\u044b\u043d\u0435 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u045e\u0441\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u0422\u0432\u0430\u0439\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043a\u0430\u0431, \u0434\u0437\u0435\u043b\u044f\u0447\u044b\u0441\u044f \u0437 \u0431\u0440\u0430\u0442\u0430\u043c\u0456 \u0445\u043b\u0435\u0431\u0430\u043c \u0436\u044b\u0446\u0446\u044f,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u044f\u043d\u044b \u0436\u044b\u0432\u0456\u043b\u0456\u0441\u044f \u0456 \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u043b\u0456\u0441\u044f \u0441\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0437\u0430 \u045e\u0432\u0435\u0441\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456 \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u0431 \u0451\u043d \u0433\u043e\u0434\u043d\u0430 \u0436\u044b\u045e \u0443 \u0422\u0432\u0430\u0456\u043c \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0456<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0441\u043b\u0443\u0436\u044b\u045e \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u045e \u043f\u043e\u0432\u044f\u0437\u0456 \u0441\u043f\u0430\u043a\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0437\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u043a\u0456\u0440\u0443\u0435 \u043d\u0430\u043c\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043f\u0430\u043c\u0456\u0436 \u0443\u0441\u0456\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456 \u045e\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u043b\u0430\u0441\u044f \u0437\u0433\u043e\u0434\u0430 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u0437\u0440\u0430\u0431\u0456 \u043d\u0430\u0441 \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435 \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0443 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u044f\u0442\u044b\u0445<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u0448\u044b\u043c\u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c\u0456 \u0431\u0440\u0430\u0442\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u043c\u044b \u0434\u0430\u0440\u0443\u0447\u0430\u0435\u043c \u0422\u0432\u0430\u0451\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456.<\/p>\r\n"}, {"NESH_Prosby_ID":"5040","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0430\u0431\u043d\u0430\u0432\u0456\u045e \u0436\u044b\u0446\u0446\u0451:<br \/><em>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u0425\u0440\u044b\u0441\u0442\u044d, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435\u0448 \u043d\u0430\u0432\u0435\u043a\u0456.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043a\u0430\u043c\u0435\u043d\u044c, \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u0432\u0443\u0433\u043b\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;&nbsp; <\/span>\u0431\u0443\u0434\u0443\u0439 \u0437 \u043d\u0430\u0441, \u0436\u044b\u0432\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u0441\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0432\u0435\u0434\u043a\u0430 \u0432\u0435\u0440\u043d\u044b \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b, \u043f\u0435\u0440\u0448\u044b\u043d\u0435\u0446 \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0441\u0432\u0430\u0439\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0430\u0434\u0437\u0456\u043d\u044b \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0448\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0422\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0431\u0456\u0442\u0430\u0433\u0430 \u0431\u043e\u043a\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0440\u0430\u0431\u0456 \u043d\u0430\u0441 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456 \u0433\u044d\u0442\u0430\u0439 \u0432\u044f\u0441\u0435\u043b\u044c\u043d\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0435\u0440\u0448\u044b \u0456 \u0430\u043f\u043e\u0448\u043d\u0456, \u0431\u044b\u045e \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c, \u0456 \u0436\u044b\u0432\u0435\u0448,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0432\u0435\u0440\u0443 \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0432\u044f\u043d\u043e\u043a \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u043f\u0430\u0445\u043e\u0434\u043d\u044f \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0439 \u043d\u0430\u0448\u044b\u0445 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u043b\u0456 \u0437 \u0422\u0430\u0431\u043e\u0439 \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n"}, {"NESH_Prosby_ID":"5041","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u0440\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u045e\u0437\u043d\u0451\u0441 \u042f\u0433\u043e \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0432\u0456\u0446\u044b:<br \/><em>\u041f\u0430\u043d\u0435, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u043f\u0440\u0430\u0437 \u0441\u043b\u0430\u0432\u0443 \u0425\u0440\u044b\u0441\u0442\u0430.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u041e\u0439\u0447\u0430, \u0422\u044b \u045e\u0437\u0432\u044b\u0441\u0456\u045e \u0415\u0437\u0443\u0441\u0430 \u043f\u0440\u0430\u0437 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043a\u0440\u044b\u0436\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0440\u0430\u0431\u0456, \u043a\u0430\u0431 \u0401\u043d \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u045e \u0434\u0430 \u0441\u044f\u0431\u0435 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0421\u044b\u043d\u0430, \u0443\u0437\u0432\u044b\u0448\u0430\u043d\u0430\u0433\u0430 \u0422\u0430\u0431\u043e\u0439, \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u0439 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043d\u0430 \u041a\u0430\u0441\u0446\u0451\u043b, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0451\u043d \u0441\u0442\u0430\u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043c \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u045e\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u043e\u0432\u0430\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u0422\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u043f\u0440\u0430\u0437 \u0432\u0430\u0434\u0443 \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0432\u0435\u0440\u043d\u044b\u043c \u043b\u0430\u0441\u0446\u044b \u0445\u0440\u043e\u0441\u0442\u0443 \u0434\u043b\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u0445, \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0439 \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b\u0445 \u0456 \u043b\u044f\u0447\u044b \u0445\u0432\u043e\u0440\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0440\u0430\u0434\u0443\u0439 \u0441\u0432\u0435\u0442 \u0441\u0432\u0430\u0456\u043c\u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u044f\u043a\u0456\u043c \u0422\u044b \u0434\u0430\u0432\u0430\u045e \u0426\u0435\u043b\u0430 \u0456 \u041a\u0440\u043e\u045e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e\u0434\u0437\u0435\u043b \u0443 \u042f\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0456.<\/p>\r\n"}, {"NESH_Prosby_ID":"5042","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u0441\u0432\u0435\u0442 \u0441\u0432\u0430\u0456\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435\u043c:<br \/><em>\u0425\u0440\u044b\u0441\u0442\u044d, \u0436\u044b\u0446\u0446\u0451 \u043d\u0430\u0448\u0430, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0422\u044b \u0434\u0430\u043b\u0443\u0447\u044b\u045e\u0441\u044f \u0434\u0430 \u0432\u0443\u0447\u043d\u044f\u045e \u043f\u0430 \u0434\u0430\u0440\u043e\u0437\u0435 \u045e \u042d\u043c\u0430\u0443\u0441,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0431\u0443\u0434\u0437\u044c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0443\u044e\u0447\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0439 \u0441\u0432\u0430\u0456\u043c \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u043c \u0431\u044b\u0446\u044c \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u044b\u043c\u0456 \u0434\u0430 \u0432\u0435\u0440\u044b,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u043b\u0456 \u0426\u044f\u0431\u0435 \u044f\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0443 \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u0430\u0441\u043a\u0430\u0432\u0430 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e \u0426\u044f\u0431\u0435 \u045e \u0434\u0430\u0440\u043e\u0437\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;&nbsp; <\/span>\u0456 \u0434\u0430\u0439 \u0456\u043c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0426\u044f\u0431\u0435 \u044f\u043a \u0417\u0431\u0430\u045e\u0446\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u043a\u0440\u044b\u0436 \u0422\u044b \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u045e \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0443 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u0443\u0441\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0443\u0434\u0434\u0437\u044f \u0436\u044b\u0432\u044b\u0445 \u0456 \u043c\u0451\u0440\u0442\u0432\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0434\u0437\u044f\u043b\u0456 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c, \u0448\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0426\u044f\u0431\u0435.<\/p>\r\n"}, {"NESH_Prosby_ID":"5043","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u043d\u0430\u0434\u0437\u0435\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443:<br \/><em>\u0425\u0440\u044b\u0441\u0442\u044d, \u0432\u0435\u0447\u043d\u0430 \u0436\u044b\u0432\u044b, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u0415\u0437\u0443, \u0437 \u0422\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0431\u0456\u0442\u0430\u0433\u0430 \u0431\u043e\u043a\u0443 \u0432\u044b\u0446\u0435\u043a\u043b\u0456 \u043a\u0440\u043e\u045e \u0456 \u0432\u0430\u0434\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0441\u0432\u0430\u0451\u0439 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u041f\u0430\u0441\u0442\u044b\u0440, \u043f\u0430\u0441\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0422\u044b \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a \u041f\u044f\u0442\u0440\u0443, \u044f\u043a\u0456 \u0432\u044b\u0437\u043d\u0430\u045e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0426\u044f\u0431\u0435;<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0439 \u043b\u044e\u0431\u043e\u045e \u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043f\u044b <span style=\"color: #ff0000;\">N.<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0434\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u043c, \u044f\u043a\u0456\u044f \u0440\u044b\u0431\u0430\u0447\u044b\u043b\u0456 \u043d\u0430 \u0432\u043e\u0437\u0435\u0440\u044b, \u0432\u044f\u043b\u0456\u043a\u0456 \u045e\u043b\u043e\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0430\u0448\u043b\u0456 \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0446\u044c \u0456\u0445 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0443\u044e \u043c\u0456\u0441\u0456\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u043c \u043d\u0430 \u0431\u0435\u0440\u0430\u0437\u0435 \u0432\u043e\u0437\u0435\u0440\u0430 \u0445\u043b\u0435\u0431 \u0456 \u0440\u044b\u0431\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0439, \u043a\u0430\u0431 \u043b\u044e\u0434\u0437\u0456 \u0433\u0456\u043d\u0443\u043b\u0456 \u0430\u0434 \u0433\u043e\u043b\u0430\u0434\u0443 \u0437 \u043d\u0430\u0448\u0430\u0439 \u0432\u0456\u043d\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443, \u0430\u043f\u043e\u0448\u043d\u0456 \u0410\u0434\u0430\u043c \u0456 \u0436\u044b\u0432\u0430\u0442\u0432\u043e\u0440\u043d\u044b \u0414\u0443\u0445, \u043f\u0440\u044b\u043f\u0430\u0434\u043e\u0431\u043d\u0456 \u0434\u0430 \u0441\u044f\u0431\u0435 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u044f\u043d\u044b \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u043b\u0456\u0441\u044f \u043f\u0430\u045e\u043d\u0430\u0442\u043e\u0439 \u0422\u0432\u0430\u0451\u0439 \u0440\u0430\u0434\u0430\u0441\u0446\u0456.<\/p>\r\n"}, {"NESH_Prosby_ID":"5044","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0411\u043e\u0433\u0430, \u044f\u043a\u0456 \u045e \u0441\u0432\u0430\u0456\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441\u043b\u044b\u043c \u0421\u044b\u043d\u0435 \u0430\u0434\u043a\u0440\u044b\u045e \u043d\u0430\u043c \u0448\u043b\u044f\u0445 \u0434\u0430 \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f:<br \/><em>\u041f\u0440\u0430\u0437 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u0425\u0440\u044b\u0441\u0442\u0430 \u0437\u0431\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u0445.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e\u0436\u0430 \u043d\u0430\u0448\u044b\u0445 \u043f\u0440\u043e\u0434\u043a\u0430\u045e, \u0422\u044b \u045e\u0441\u043b\u0430\u0432\u0456\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0415\u0437\u0443\u0441\u0430, \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u0430\u044e\u0447\u044b \u042f\u0433\u043e \u0437 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u0430\u0431\u0443\u0434\u0437\u0456 \u045e \u043d\u0430\u0441 \u0448\u0447\u044b\u0440\u0430\u0435 \u043f\u0430\u043a\u0430\u044f\u043d\u043d\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043c\u044b \u043f\u0430\u0447\u0430\u043b\u0456 \u0436\u044b\u0446\u044c \u043d\u043e\u0432\u044b\u043c \u0436\u044b\u0446\u0446\u0451\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u044b\u0432\u0451\u045e \u0437\u0430\u0433\u0443\u0431\u043b\u0435\u043d\u044b\u0445 \u0430\u0432\u0435\u0447\u0430\u043a \u0434\u0430 \u043f\u0430\u0441\u0442\u044b\u0440\u0430 \u0456 \u0430\u0445\u043e\u045e\u043d\u0456\u043a\u0430 \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u0448,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u043d\u0430\u0441 \u0432\u0435\u0440\u043d\u044b\u043c\u0456, \u0434\u0437\u044f\u043a\u0443\u044e\u0447\u044b \u043d\u0430\u0432\u0443\u0447\u0430\u043d\u043d\u044e \u043f\u0430\u0441\u0442\u044b\u0440\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0432\u044b\u0431\u0440\u0430\u045e \u043f\u0435\u0440\u0448\u044b\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u0441\u0432\u0430\u0439\u0433\u043e \u0421\u044b\u043d\u0430 \u0441\u044f\u0440\u043e\u0434 \u044e\u0434\u044d\u0439\u0441\u043a\u0430\u0433\u0430 \u043d\u0430\u0440\u043e\u0434\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0434\u043a\u0440\u044b\u0439 \u0441\u044b\u043d\u0430\u043c \u0406\u0437\u0440\u0430\u044d\u043b\u044f \u0430\u0431\u044f\u0446\u0430\u043d\u043d\u0435, \u0434\u0430\u0434\u0437\u0435\u043d\u0430\u0435 \u0456\u0445 \u0430\u0439\u0446\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439 \u043f\u0440\u0430 \u045e\u0441\u0456\u0445 \u043f\u0430\u043a\u0456\u043d\u0443\u0442\u044b\u0445, \u0441\u0456\u0440\u043e\u0442\u0430\u045e \u0456 \u045e\u0434\u043e\u0432\u0430\u045e<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043d\u0435 \u043f\u0430\u043a\u0456\u0434\u0430\u0439 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0422\u0432\u043e\u0439 \u0421\u044b\u043d \u043f\u0430\u044f\u0434\u043d\u0430\u045e \u0437 \u0441\u0430\u0431\u043e\u044e \u043f\u0440\u0430\u0437 \u0441\u043c\u0435\u0440\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u0441\u044f\u0431\u0435 \u0421\u0442\u044d\u0444\u0430\u043d\u0430, \u044f\u043a\u0456 \u0432\u044b\u0437\u043d\u0430\u045e, \u0448\u0442\u043e \u0431\u0430\u0447\u044b\u0446\u044c \u0415\u0437\u0443\u0441\u0430, \u044f\u043a\u0456 \u0441\u0442\u0430\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0426\u044f\u0431\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u044b\u043c\u0456 \u043d\u0430\u0448\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e, \u0448\u0442\u043e \u0447\u0430\u043a\u0430\u043b\u0456 \u0426\u044f\u0431\u0435 \u0437 \u0432\u0435\u0440\u0430\u0439 \u0456 \u043b\u044e\u0431\u043e\u045e\u044e.<\/p>\r\n"}, {"NESH_Prosby_ID":"5045","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u045e\u0441\u043a\u043b\u0456\u043a\u043d\u0435\u043c \u0434\u0430 \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u043e\u0433\u0430 \u0411\u043e\u0433 \u0437\u0440\u0430\u0431\u0456\u045e \u0437\u0430\u0434\u0430\u0442\u043a\u0430\u043c \u0443\u0441\u0451\u0439 \u043d\u0430\u0448\u0430\u0439 \u043d\u0430\u0434\u0437\u0435\u0456 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u044f:<br \/><em>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0445\u0432\u0430\u043b\u044b.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u0415\u0437\u0443, \u043f\u0440\u0430\u0437 \u0441\u0432\u0430\u044e \u043a\u0440\u043e\u045e \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0422\u044b \u045e\u0432\u0430\u0439\u0448\u043e\u045e \u0443 \u0421\u0432\u044f\u0442\u043e\u0435 \u0421\u0432\u044f\u0442\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u043d\u0430\u0441 \u0434\u0430 \u0441\u043b\u0430\u0432\u044b \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0422\u044b \u045e\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u0443 \u0432\u0435\u0440\u044b \u0456 \u043f\u0430\u0441\u043b\u0430\u045e \u0456\u0445 \u0443 \u0441\u0432\u0435\u0442,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e \u0456 \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e \u0432\u0435\u0440\u043d\u044b\u043c\u0456 \u0432\u0435\u0441\u0442\u0443\u043d\u0430\u043c\u0456 \u0441\u0432\u0430\u0439\u0433\u043e \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0422\u044b \u0441\u0442\u0430\u045e \u043d\u0430\u0448\u044b\u043c \u0441\u043f\u0430\u043a\u043e\u0435\u043c \u0456 \u043f\u0430\u044f\u0434\u043d\u0430\u043d\u043d\u0435\u043c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0432\u0435\u0440\u043d\u044b\u043c \u044f\u0434\u043d\u0430\u0446\u0446\u0430 \u043c\u0456\u0436 \u0441\u0430\u0431\u043e\u0439 \u0434\u0430\u0441\u043a\u0430\u043d\u0430\u043b\u0430\u0439 \u043f\u043e\u0432\u044f\u0437\u0437\u044e \u0432\u0435\u0440\u044b \u0456 \u043b\u044e\u0431\u043e\u0432\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0422\u044b \u0430\u0437\u0434\u0430\u0440\u0430\u0432\u0456\u045e \u043a\u0443\u043b\u044c\u0433\u0430\u0432\u0430\u0433\u0430 \u043f\u0440\u044b \u0431\u0440\u0430\u043c\u0430\u0445 \u0441\u0432\u044f\u0442\u044b\u043d\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0445\u0432\u043e\u0440\u044b\u0445 \u0456 \u043f\u0430\u043a\u0430\u0436\u044b \u0456\u043c \u0441\u0432\u0430\u044e \u0441\u043b\u0430\u0432\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0435\u0440\u0448\u044b\u043c \u0441\u044f\u0440\u043e\u0434 \u043b\u044e\u0434\u0437\u0435\u0439 \u0430\u0434\u043e\u043b\u0435\u045e \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u0442\u044b\u043c, \u0445\u0442\u043e \u043d\u0430 \u0426\u044f\u0431\u0435 \u0441\u043f\u0430\u0434\u0437\u044f\u0432\u0430\u045e\u0441\u044f, \u0443\u0434\u0437\u0435\u043b \u0443 \u0422\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u0435.<\/p>\r\n"}, {"NESH_Prosby_ID":"5046","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0423\u0448\u0430\u043d\u043e\u045e\u0432\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u043a\u0440\u044b\u043d\u0456\u0446\u0443 \u045e\u0441\u044f\u043a\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f \u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u043c\u043e\u0446\u044b:<br \/><em>\u041f\u0430\u043d\u0435, \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0439 \u0443 \u0441\u0432\u0435\u0446\u0435 \u0441\u0432\u0430\u0451 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443 \u0417\u0431\u0430\u045e\u0446\u0430, \u0422\u044b \u0431\u044b\u045e \u0437\u0430\u0431\u0456\u0442\u044b \u045e \u0446\u0435\u043b\u0435, \u0430\u043b\u0435 \u0430\u0436\u044b\u045e\u043b\u0435\u043d\u044b \u045e \u0414\u0443\u0445\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u043d\u0430\u043c, \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c \u0434\u043b\u044f \u0433\u0440\u044d\u0445\u0443, \u0436\u044b\u0446\u044c \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u044e \u0414\u0443\u0445\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0430\u0441\u043b\u0430\u045e \u043f\u0430 \u045e\u0441\u0456\u043c \u0441\u0432\u0435\u0446\u0435 \u0441\u0432\u0430\u0456\u0445 \u0432\u0443\u0447\u043d\u044f\u045e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u0414\u043e\u0431\u0440\u0443\u044e \u041d\u0430\u0432\u0456\u043d\u0443 \u043a\u043e\u0436\u043d\u0430\u043c\u0443 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0436\u044b\u0446\u044c \u0437\u0433\u043e\u0434\u043d\u0430 \u0437 \u0422\u0432\u0430\u0456\u043c \u0414\u0443\u0445\u0430\u043c \u0442\u044b\u043c, \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0415\u0432\u0430\u043d\u0433\u0435\u043b\u043b\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u0430\u0431\u0435 \u0434\u0430\u0434\u0437\u0435\u043d\u0430 \u045e\u0441\u044f \u045e\u043b\u0430\u0434\u0430 \u043d\u0430 \u043d\u0435\u0431\u0435 \u0456 \u0437\u044f\u043c\u043b\u0456, \u043a\u0430\u0431 \u0422\u044b \u0434\u0430\u045e \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u0435 \u043f\u0440\u0430\u045e\u0434\u0437\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0443 \u0434\u0443\u0445\u0443 \u043f\u0440\u0430\u045e\u0434\u044b \u0441\u044d\u0440\u0446\u044b \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0430\u043c\u0456 \u043a\u0456\u0440\u0443\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0435\u0448 \u0443\u0441\u0451 \u0456 \u043d\u0430\u043a\u0430\u0437\u0432\u0430\u0435\u0448 \u043d\u0430\u043c \u0447\u0443\u0439\u043d\u0430 \u0447\u0430\u043a\u0430\u0446\u044c \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u043d\u0430\u043c \u043d\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u043f\u0440\u0430\u0433\u043d\u0430 \u0447\u0430\u043a\u0430\u0446\u044c \u043d\u043e\u0432\u0430\u0433\u0430 \u043d\u0435\u0431\u0430 \u0456 \u043d\u043e\u0432\u0430\u0439 \u0437\u044f\u043c\u043b\u0456, \u0430\u043b\u0435 \u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u0430 \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0446\u0446\u0430 \u0430\u0431 \u0433\u044d\u0442\u044b\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u044b\u0448\u043e\u045e \u0443 \u0430\u0434\u0445\u043b\u0430\u043d\u044c, \u043a\u0430\u0431 \u0430\u0431\u0432\u044f\u0441\u0446\u0456\u0446\u044c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c \u0414\u043e\u0431\u0440\u0443\u044e \u041d\u0430\u0432\u0456\u043d\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0431\u0443\u0434\u0437\u044c \u0434\u043b\u044f \u0456\u0445 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0456 \u0441\u043b\u0430\u045e\u043d\u0430\u044e \u043d\u0430\u0434\u0437\u0435\u044f\u0439.<\/p>\r\n"}, {"NESH_Prosby_ID":"5050","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0432\u0435\u0440\u0430\u044e \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u043c, \u043f\u0440\u043e\u0441\u044f\u0447\u044b \u0425\u0440\u044b\u0441\u0442\u0430, \u0436\u044b\u0446\u0446\u0451 \u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435 \u043d\u0430\u0448\u0430\u0435:<br \/><em>\u0421\u044b\u043d\u0435 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, \u043a\u043b\u0430\u043f\u0430\u0446\u0456\u0441\u044f \u043f\u0440\u0430 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u0422\u0432\u043e\u0439 \u043a\u0430\u0442\u0430\u043b\u0456\u0446\u043a\u0456 \u041a\u0430\u0441\u0446\u0451\u043b,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0441\u0432\u044f\u0447\u0430\u0439 \u044f\u0433\u043e, \u043a\u0430\u0431 \u0451\u043d \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u045e \u0422\u0432\u0430\u0451 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0437\u0430 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u043f\u0440\u044b\u0433\u043d\u044f\u0442\u0430\u0435 \u0445\u0432\u0430\u0440\u043e\u0431\u0430, \u0441\u043c\u0443\u0442\u0430\u043a, \u043d\u044f\u0432\u043e\u043b\u044f \u0446\u0456 \u0432\u044b\u0433\u043d\u0430\u043d\u043d\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u044f\u0445\u0430\u0439 \u044f\u043d\u044b \u0437\u043d\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u0422\u0430\u0431\u0435 \u0441\u0443\u0446\u044f\u0448\u044d\u043d\u043d\u0435 \u0456 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0431\u0456\u045e\u0441\u044f \u0437 \u0422\u0432\u0430\u0451\u0439 \u0434\u0430\u0440\u043e\u0433\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u044f\u0445\u0430\u0439 \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u044e\u0446\u044c \u043b\u0430\u0441\u043a\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0431\u0430\u0447\u044d\u043d\u043d\u044f \u0456 \u0440\u0430\u0434\u0430\u0441\u0446\u044c \u043d\u043e\u0432\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448 \u0417\u0431\u0430\u045e\u0446\u0430, \u0422\u044b \u0431\u044b\u045e \u0443\u043a\u0440\u044b\u0436\u0430\u0432\u0430\u043d\u044b, \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0456 \u0437\u043d\u043e\u045e \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u0448 \u0441\u0443\u0434\u0437\u0456\u0446\u044c \u0441\u0432\u0435\u0442,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0431\u0443\u0434\u0437\u044c \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u044b \u0434\u0430 \u043d\u0430\u0441, \u0433\u0440\u044d\u0448\u043d\u044b\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0437\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0433\u044d\u0442\u044b\u043c \u0441\u0432\u0435\u0446\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0437\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0430\u0434\u044b\u0448\u043e\u045e \u0430\u0434 \u043d\u0430\u0441 \u0443 \u043d\u0430\u0434\u0437\u0435\u0456 \u043d\u0430 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0448\u044d\u043d\u043d\u0435.<\/p>\r\n"}, {"NESH_Prosby_ID":"5051","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u043f\u0430\u043c\u0451\u0440, \u0443\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0435\u0446\u0446\u0430 \u0437\u0430 \u043d\u0430\u0441: <br \/><em>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u0412\u0430\u043b\u0430\u0434\u0430\u0440-\u041f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0430.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d, \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u045e\u0441\u0456\u0445 \u043d\u0430\u0440\u043e\u0434\u0430\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u043f\u0430\u043b\u0456 \u0430\u0433\u043e\u043d\u044c \u0441\u0432\u0430\u0439\u0433\u043e \u0414\u0443\u0445\u0430 \u045e \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0435 \u0422\u0432\u0430\u0451 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0406\u0437\u0440\u0430\u044d\u043b\u044c \u043f\u0440\u044b\u0437\u043d\u0430\u0435 \u045e \u0422\u0430\u0431\u0435 \u0441\u0432\u0430\u0439\u0433\u043e \u041c\u0435\u0441\u0456\u044e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u045e\u0441\u044f \u0437\u044f\u043c\u043b\u044f \u043d\u0430\u043f\u043e\u045e\u043d\u0456\u0446\u0446\u0430 \u043f\u0430\u0437\u043d\u0430\u043d\u043d\u0435\u043c \u0422\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u043d\u0430\u0441 \u0443 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0422\u0432\u0430\u0456\u0445 \u0441\u0432\u044f\u0442\u044b\u0445<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0434\u0430\u0439 \u043d\u0430\u043c \u0430\u0434\u043f\u0430\u0447\u044b\u0446\u044c \u0430\u0434 \u043d\u0430\u0448\u0430\u0439 \u043f\u0440\u0430\u0446\u044b \u0440\u0430\u0437\u0430\u043c \u0437 \u0456\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0435\u0440\u0430\u043c\u043e\u0433 \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0440\u0430\u0437\u0431\u0456\u045e \u0443 \u043d\u0430\u0441 \u044f\u0435 \u0432\u0430\u0440\u043e\u0436\u0430\u0435 \u043f\u0430\u043d\u0430\u0432\u0430\u043d\u043d\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043c\u044b \u0436\u044b\u043b\u0456 \u0434\u043b\u044f \u0426\u044f\u0431\u0435, \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0433\u0430 \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d \u0417\u0431\u0430\u045e\u0446\u0430, \u0422\u044b \u0441\u0442\u0430\u045e \u043f\u0430\u0441\u043b\u0443\u0445\u043c\u044f\u043d\u044b\u043c \u0430\u0436\u043d\u043e \u0434\u0430 \u0441\u043c\u0435\u0440\u0446\u0456 \u0456 \u0431\u044b\u045e \u0443\u0437\u0432\u044b\u0448\u0430\u043d\u044b \u0434\u0430 \u043f\u0440\u0430\u0432\u0456\u0446\u044b \u0410\u0439\u0446\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043b\u0430\u0441\u043a\u0430\u0432\u0430 \u043f\u0440\u044b\u043c\u0456 \u0441\u0432\u0430\u0456\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0443 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430 \u0441\u0432\u0430\u0451\u0439 \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n"}, {"NESH_Prosby_ID":"5052","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c \u0434\u0443\u0445\u0430\u043c \u0437\u0430\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443 \u044f\u043a\u043e\u0433\u0430 \u0430\u0436\u044b\u045e\u043b\u044f\u045e \u0456 \u0440\u0430\u0431\u0456\u045e \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u0430\u0439 \u0414\u0443\u0445 \u0421\u0432\u044f\u0442\u044b: <br \/><em>\u041f\u0430\u043d\u0435, \u0430\u0434\u043d\u0430\u045e\u043b\u044f\u0439 \u0456 \u0430\u0436\u044b\u045e\u043b\u044f\u0439 \u0443\u0441\u0451.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d, \u0417\u0431\u0430\u045e\u0446\u0430 \u0441\u0432\u0435\u0442\u0443, \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u043d\u043e\u0432\u0430\u0433\u0430 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u044f, \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u0441\u043a\u0456\u0440\u0443\u0439 \u043d\u0430\u0448\u044b\u044f \u0436\u0430\u0434\u0430\u043d\u043d\u0456 \u0434\u0430 \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0437\u0435 \u0422\u044b \u0441\u044f\u0434\u0437\u0456\u0448 \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0410\u0439\u0446\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u0422\u044b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0436\u044b\u0432\u0435\u0448 \u0443 \u0441\u0432\u0430\u0456\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u0430\u043a\u0456\u0440\u043e\u045e\u0432\u0430\u0439 \u044f\u0433\u043e \u0437 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430\u0439 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0434\u0430 \u043f\u0430\u045e\u043d\u0430\u0442\u044b \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u044f\u0432\u0456 \u0441\u0432\u0430\u044e \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c \u0434\u0430 \u0445\u0432\u043e\u0440\u044b\u0445, \u0446\u0435\u0440\u043f\u044f\u0447\u044b\u0445 \u0456 \u043f\u0430\u043c\u0456\u0440\u0430\u044e\u0447\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0443\u0441\u0435 \u0441\u0443\u0446\u0435\u0448\u044b\u043b\u0456\u0441\u044f \u0456 \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u043b\u0456\u0441\u044f \u0422\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u045e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d, \u043d\u0435\u043f\u0430\u0433\u0430\u0441\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e, \u043d\u0430 \u0441\u0445\u0456\u043b\u0435 \u0434\u043d\u044f \u043c\u044b \u0430\u0445\u0432\u044f\u0440\u0443\u0435\u043c \u0422\u0430\u0431\u0435 \u0441\u0432\u0430\u044e \u043f\u0430\u0431\u043e\u0436\u043d\u0430\u0441\u0446\u044c<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u0446\u044c \u043f\u0440\u0430\u043c\u0435\u043d\u043d\u0435\u043c \u0422\u0432\u0430\u0439\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u043d\u0430\u0448\u044b\u0445 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e.<\/p>\r\n"}, {"NESH_Prosby_ID":"5053","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0420\u0430\u0434\u0430\u0441\u043d\u0430 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0443, \u044f\u043a\u0456, \u0432\u044b\u0439\u0448\u0430\u045e\u0448\u044b \u0437 \u043d\u0435\u0442\u0440\u0430\u045e \u0437\u044f\u043c\u043b\u0456, \u0443\u0431\u0430\u0447\u044b\u045e \u0441\u0432\u044f\u0442\u043b\u043e \u043d\u043e\u0432\u0430\u0439 \u0441\u043b\u0430\u0432\u044b:<br \/><em>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0441\u043b\u0430\u0432\u044b.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0437\u0430 \u0431\u0456\u0441\u043a\u0443\u043f\u0430\u045e, \u043f\u0440\u044d\u0437\u0431\u0456\u0442\u044d\u0440\u0430\u045e \u0456 \u0434\u044b\u044f\u043a\u0430\u043d\u0430\u045e, \u043a\u0430\u0431 \u0437 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044e \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u0441\u0432\u043e\u0439 \u0430\u0431\u0430\u0432\u044f\u0437\u0430\u043a<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043f\u0430\u0434\u0440\u044b\u0445\u0442\u0430\u0432\u0430\u043b\u0456 \u0422\u0430\u0431\u0435 \u043d\u0430\u0440\u043e\u0434, \u0440\u0443\u043f\u043bi\u0432\u044b \u0432\u0430 \u045e\u0441\u044f\u043a\u0430\u0439 \u0434\u043e\u0431\u0440\u0430\u0439 \u0441\u043f\u0440\u0430\u0432\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0437\u0430 \u043d\u0430\u0432\u0443\u043a\u043e\u045e\u0446\u0430\u045e, \u044f\u043a\u0456\u044f \u0441\u0442\u0430\u0440\u0430\u043d\u043d\u0430 \u0441\u043b\u0443\u0436\u0430\u0446\u044c \u0422\u0432\u0430\u0439\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0437 \u0447\u044b\u0441\u0442\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0448\u0443\u043a\u0430\u043b\u0456 \u0422\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u045e\u0434\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u041f\u0430\u043d\u0435, \u0437\u0430 \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u045e \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043a\u0430\u0431 \u0443\u0434\u0437\u0435\u043b\u044c\u043d\u0456\u0447\u0430\u043b\u0456 \u045e \u0434\u043e\u0431\u0440\u044b\u043c \u0441\u043f\u0430\u0431\u043e\u0440\u043d\u0456\u0446\u0442\u0432\u0435 \u0432\u0435\u0440\u044b<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456, \u0437\u0430\u0432\u044f\u0440\u0448\u0430\u044e\u0447\u044b \u0431\u0435\u0433, \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u044b\u0431\u0456\u045e \u0434\u0430 \u043a\u0440\u044b\u0436\u0430 \u043d\u0430\u0448 \u0441\u043c\u044f\u0440\u043e\u0442\u043d\u044b \u043f\u0440\u044b\u0441\u0443\u0434 \u0456 \u0441\u043a\u0430\u0441\u0430\u0432\u0430\u045e \u044f\u0433\u043e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0440\u0430\u0437\u0430\u0440\u0432\u0456 \u043d\u0430\u0448\u044b\u044f \u043a\u0430\u0439\u0434\u0430\u043d\u044b \u0456 \u0432\u044b\u0437\u0432\u0430\u043b\u0456 \u043d\u0430\u0441 \u0437 \u0446\u0435\u043c\u0440\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0437\u044b\u0448\u043e\u045e \u0443 \u0430\u0434\u0445\u043b\u0430\u043d\u044c \u0456 \u0430\u0434\u043a\u0440\u044b\u045e \u044f\u0435 \u0431\u0440\u0430\u043c\u044b,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0443\u0441\u0446\u0456 \u043d\u0430\u0448\u044b\u0445 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0431\u0440\u0430\u0442\u043e\u045e \u0434\u0430 \u0441\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n"}, {"NESH_Prosby_ID":"5054","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u0440\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0456 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043f\u0440\u0430\u0432\u0430\u0440\u0443\u0447 \u0410\u0439\u0446\u0430:<br \/><em>\u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0436\u044b\u0432\u044b, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439, \u041f\u0430\u043d\u0435, \u043f\u0440\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0422\u0430\u0431\u0435 \u0441\u043b\u0443\u0436\u044b\u0446\u044c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u044f\u043d\u044b \u0434\u0430\u0432\u0430\u043b\u0456 \u0422\u0432\u0430\u0439\u043c\u0443 \u043d\u0430\u0440\u043e\u0434\u0443 \u043f\u0440\u044b\u043a\u043b\u0430\u0434 \u0436\u044b\u0446\u0446\u044f \u045e \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0434\u0437\u044f\u043b\u0456 \u043a\u0456\u0440\u0430\u045e\u043d\u0456\u043a\u0430\u043c \u0434\u0437\u044f\u0440\u0436\u0430\u045e \u0434\u0443\u0445\u0430 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430\u0441\u0446\u0456 \u0456 \u0441\u043f\u0430\u043a\u043e\u044e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0443\u0441\u0451 \u0433\u0440\u0430\u043c\u0430\u0434\u0441\u0442\u0432\u0430 \u0436\u044b\u043b\u043e \u045e \u0437\u0433\u043e\u0434\u0437\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0410\u0434\u0430\u0440\u044b \u043d\u0430\u0441 \u0434\u0430\u0431\u0440\u0430\u0431\u044b\u0442\u0430\u043c \u0443 \u043d\u0430\u0448\u044b\u043c \u0447\u0430\u0441\u043e\u0432\u044b\u043c \u0436\u044b\u0446\u0446\u0456<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0437\u0440\u0430\u0431\u0456 \u0437\u044f\u043c\u043b\u044e \u045e\u0440\u0430\u0434\u043b\u0456\u0432\u0430\u0439, \u043a\u0430\u0431 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0446\u044f\u0440\u043f\u0435\u045e \u043d\u044f\u0441\u0442\u0430\u0447\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d \u0417\u0431\u0430\u045e\u0446\u0430, \u0422\u044b \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u0443\u0432\u0435\u0441\u044c \u0441\u0432\u0435\u0442 \u0456 \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u045e \u0434\u0430 \u0436\u044b\u0446\u0446\u044f \u043a\u043e\u0436\u043d\u0430\u0435 \u0442\u043b\u0435\u043d\u043d\u0430\u0435 \u0441\u0442\u0432\u0430\u0440\u044d\u043d\u043d\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u043d\u0430\u0448\u044b\u043c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c \u0431\u0440\u0430\u0442\u0430\u043c \u0443\u0431\u0430\u0447\u044b\u0446\u044c \u0422\u0432\u0430\u0451 \u0432\u0435\u0447\u043d\u0430\u0435 \u0441\u0432\u044f\u0442\u043b\u043e.<\/p>\r\n"}, {"NESH_Prosby_ID":"5055","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0456 \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u044f\u043a \u043f\u0435\u0440\u0448\u044b\u043d\u0435\u0446 \u0441\u044f\u0440\u043e\u0434 \u0442\u044b\u0445, \u0445\u0442\u043e \u0441\u043f\u0430\u0447\u044b\u045e:<br \/><em>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u041f\u0430\u043d\u0435, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u043e\u0441 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043c\u044f\u0442\u0430\u0439, \u0425\u0440\u044b\u0441\u0442\u044d, \u043f\u0440\u0430 \u0441\u0432\u043e\u0439 \u0441\u0432\u044f\u0442\u044b \u041a\u0430\u0441\u0446\u0451\u043b, \u044f\u043a\u0456 \u0422\u044b \u043f\u0430\u0431\u0443\u0434\u0430\u0432\u0430\u045e \u043d\u0430 \u043f\u0430\u0434\u043c\u0443\u0440\u043a\u0443 \u0410\u043f\u043e\u0441\u0442\u0430\u043b\u0430\u045e \u0456 \u043f\u0430\u0448\u044b\u0440\u044b\u045e \u0430\u0436\u043d\u043e \u0434\u0430 \u043c\u0435\u0436\u0430\u045e \u0437\u044f\u043c\u043b\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u0435\u043a\u0430\u0440 \u043d\u0430\u0448\u044b\u0445 \u0434\u0443\u0448 \u0456 \u0446\u0435\u043b\u0430\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u0430\u0432\u0435\u0434\u0430\u0439 \u043d\u0430\u0441 \u0456 \u0437\u0431\u0430\u045e \u0441\u0432\u0430\u0451\u0439 \u043b\u044e\u0431\u043e\u045e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u0456 \u045e\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0439 \u0445\u0432\u043e\u0440\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0439 \u0456\u0445 \u0430\u0434 \u0443\u0441\u044f\u043a\u0430\u0433\u0430 \u0431\u043e\u043b\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0414\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u043d\u044f\u043c\u043e\u0433 \u0430\u0434 \u0441\u043c\u0443\u0442\u043a\u0443 \u0456 \u043f\u0440\u044b\u0433\u043d\u0451\u0442\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u0432\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u0446\u0435\u0440\u043f\u044f\u0447\u044b\u0445 \u0456 \u045e\u0431\u043e\u0433\u0456\u0445.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u0432\u043e\u0439 \u043a\u0440\u044b\u0436 i \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0422\u044b \u0430\u0434\u043a\u0440\u044b\u045e \u0443\u0441\u0456\u043c \u0448\u043b\u044f\u0445 \u0434\u0430 \u043d\u0435\u0441\u043c\u044f\u0440\u043e\u0442\u043d\u0430\u0441\u0446\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u043d\u0430\u0448\u044b\u043c \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c \u0431\u0440\u0430\u0442\u0430\u043c \u0441\u043a\u0430\u0448\u0442\u0430\u0432\u0430\u0446\u044c \u0440\u0430\u0434\u0430\u0441\u0446\u044f\u045e \u0422\u0432\u0430\u0439\u0433\u043e \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0430.<\/p>\r\n"}, {"NESH_Prosby_ID":"5056","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u0425\u0440\u044b\u0441\u0442\u0430 &ndash; \u0434\u0430\u0440\u043e\u0433\u0443, \u043f\u0440\u0430\u045e\u0434\u0443 \u0456 \u0436\u044b\u0446\u0446\u0451 \u0456 \u045e\u0441\u043a\u043b\u0456\u043a\u0430\u0435\u043c \u0434\u0430 \u042f\u0433\u043e:<br \/><em>\u0421\u044b\u043d\u0435 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u0425\u0440\u044b\u0441\u0442\u044d, \u0437\u0430 \u045e\u0441\u0456\u0445 \u0441\u043b\u0443\u0433\u0430\u045e \u0422\u0432\u0430\u0439\u0433\u043e \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u043a\u0430\u0431, \u0434\u0437\u0435\u043b\u044f\u0447\u044b\u0441\u044f \u0437 \u0431\u0440\u0430\u0442\u0430\u043c\u0456 \u0445\u043b\u0435\u0431\u0430\u043c \u0436\u044b\u0446\u0446\u044f,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u044f\u043d\u044b \u0436\u044b\u0432\u0456\u043b\u0456\u0441\u044f \u0456 \u043f\u0430\u0434\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u043b\u0456\u0441\u044f \u0441\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0437\u0430 \u045e\u0432\u0435\u0441\u044c \u0445\u0440\u044b\u0441\u0446\u0456\u044f\u043d\u0441\u043a\u0456 \u043d\u0430\u0440\u043e\u0434, \u043a\u0430\u0431 \u0451\u043d \u0433\u043e\u0434\u043d\u0430 \u0436\u044b\u045e \u0443 \u0422\u0432\u0430\u0456\u043c \u043f\u0430\u043a\u043b\u0456\u043a\u0430\u043d\u043d\u0456<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0441\u043b\u0443\u0436\u044b\u045e \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u0414\u0443\u0445\u0430 \u045e \u043f\u043e\u0432\u044f\u0437\u0456 \u0441\u043f\u0430\u043a\u043e\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435 \u0437\u0430 \u045e\u0441\u0456\u0445, \u0445\u0442\u043e \u043a\u0456\u0440\u0443\u0435 \u043d\u0430\u043c\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u043b\u0456 \u0430\u0431\u0430\u0432\u044f\u0437\u043a\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430 \u0456 \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u043f\u0430\u043c\u0456\u0436 \u0443\u0441\u0456\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456 \u045e\u0441\u0442\u0430\u043b\u044f\u0432\u0430\u043b\u0430\u0441\u044f \u0437\u0433\u043e\u0434\u0430 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0426\u044f\u0431\u0435, \u0437\u0440\u0430\u0431\u0456 \u043d\u0430\u0441 \u0433\u043e\u0434\u043d\u044b\u043c\u0456 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0446\u044c \u0426\u044f\u0431\u0435 \u0448\u0447\u044b\u0440\u044b\u043c \u0441\u044d\u0440\u0446\u0430\u043c \u0443 \u0441\u0443\u043f\u043e\u043b\u044c\u043d\u0430\u0441\u0446\u0456 \u0441\u0432\u044f\u0442\u044b\u0445<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0440\u0430\u0437\u0430\u043c \u0437 \u043d\u0430\u0448\u044b\u043c\u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c\u0456 \u0431\u0440\u0430\u0442\u0430\u043c\u0456, \u044f\u043a\u0456\u0445 \u043c\u044b \u0434\u0430\u0440\u0443\u0447\u0430\u0435\u043c \u0422\u0432\u0430\u0451\u0439 \u0434\u0430\u0431\u0440\u044b\u043d\u0456.<\/p>\r\n"}, {"NESH_Prosby_ID":"5060","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445 \u0437\u043d\u0456\u0448\u0447\u044b\u045e \u0441\u043c\u0435\u0440\u0446\u044c \u0456 \u0430\u0431\u043d\u0430\u0432\u0456\u045e \u0436\u044b\u0446\u0446\u0451:<br \/><em>\u0412\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441, \u0425\u0440\u044b\u0441\u0442\u044d, \u044f\u043a\u0456 \u0436\u044b\u0432\u0435\u0448 \u043d\u0430\u0432\u0435\u043a\u0456.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043a\u0430\u043c\u0435\u043d\u044c, \u0430\u0434\u043a\u0456\u043d\u0443\u0442\u044b \u0431\u0443\u0434\u0430\u045e\u043d\u0456\u043a\u0430\u043c\u0456, \u044f\u043a\u0456 \u0441\u0442\u0430\u045e \u0433\u0430\u043b\u0430\u0432\u043e\u044e \u0432\u0443\u0433\u043b\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0431\u0443\u0434\u0443\u0439 \u0437 \u043d\u0430\u0441, \u0436\u044b\u0432\u044b\u0445 \u043a\u0430\u043c\u044f\u043d\u0451\u045e, \u0441\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0432\u0435\u0434\u043a\u0430 \u0432\u0435\u0440\u043d\u044b \u0456 \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u044b, \u043f\u0435\u0440\u0448\u044b\u043d\u0435\u0446 \u0441\u044f\u0440\u043e\u0434 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439 \u0441\u0432\u0430\u0439\u043c\u0443 \u041a\u0430\u0441\u0446\u0451\u043b\u0443 \u043d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c \u043f\u0440\u0430 \u0426\u044f\u0431\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0430\u0434\u0437\u0456\u043d\u044b \u0410\u0431\u0440\u0430\u043d\u043d\u0456\u043a \u041a\u0430\u0441\u0446\u0451\u043b\u0430, \u0448\u0442\u043e \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e\u0441\u044f \u0437 \u0422\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0431\u0456\u0442\u0430\u0433\u0430 \u0431\u043e\u043a\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0440\u0430\u0431\u0456 \u043d\u0430\u0441 \u0441\u0432\u0435\u0434\u043a\u0430\u043c\u0456 \u0433\u044d\u0442\u0430\u0439 \u0432\u044f\u0441\u0435\u043b\u044c\u043d\u0430\u0439 \u0442\u0430\u044f\u043c\u043d\u0456\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0435\u0440\u0448\u044b \u0456 \u0430\u043f\u043e\u0448\u043d\u0456, \u0431\u044b\u045e \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c, \u0456 \u0436\u044b\u0432\u0435\u0448,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0432\u0435\u0440\u0443 \u0430\u0445\u0440\u044b\u0448\u0447\u0430\u043d\u044b\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u0432\u044f\u043d\u043e\u043a \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0441\u0432\u044f\u0442\u043b\u043e \u0456 \u043f\u0430\u0445\u043e\u0434\u043d\u044f \u0441\u0432\u044f\u0442\u043e\u0433\u0430 \u0411\u043e\u0436\u0430\u0433\u0430 \u0433\u043e\u0440\u0430\u0434\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0441\u0432\u044f\u0442\u043b\u044f\u0439 \u043d\u0430\u0448\u044b\u0445 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445, \u043a\u0430\u0431 \u044f\u043d\u044b \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u044b\u043b\u0456 \u0437 \u0422\u0430\u0431\u043e\u0439 \u043d\u0430\u0432\u0435\u043a\u0456.<\/p>\r\n"}, {"NESH_Prosby_ID":"5061","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043a\u043e\u0440\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u0411\u043e\u0433\u0430 \u0410\u0439\u0446\u0430, \u044f\u043a\u0456 \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0425\u0440\u044b\u0441\u0442\u0430 \u0456 \u045e\u0437\u043d\u0451\u0441 \u042f\u0433\u043e \u0434\u0430 \u0441\u0432\u0430\u0451\u0439 \u043f\u0440\u0430\u0432\u0456\u0446\u044b:<br \/><em>\u041f\u0430\u043d\u0435, \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0441\u0432\u043e\u0439 \u043d\u0430\u0440\u043e\u0434 \u043f\u0440\u0430\u0437 \u0441\u043b\u0430\u0432\u0443 \u0425\u0440\u044b\u0441\u0442\u0430.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u0421\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b \u041e\u0439\u0447\u0430, \u0422\u044b \u045e\u0437\u0432\u044b\u0441\u0456\u045e \u0415\u0437\u0443\u0441\u0430 \u043f\u0440\u0430\u0437 \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0443 \u043a\u0440\u044b\u0436\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0440\u0430\u0431\u0456, \u043a\u0430\u0431 \u0401\u043d \u043f\u0440\u044b\u0446\u044f\u0433\u0432\u0430\u045e \u0434\u0430 \u0441\u044f\u0431\u0435 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0421\u044b\u043d\u0430, \u0443\u0437\u0432\u044b\u0448\u0430\u043d\u0430\u0433\u0430 \u0422\u0430\u0431\u043e\u0439, \u0441\u043f\u0430\u0441\u044b\u043b\u0430\u0439 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u043d\u0430 \u041a\u0430\u0441\u0446\u0451\u043b, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043a\u0430\u0431 \u0451\u043d \u0441\u0442\u0430\u045e \u0441\u0430\u043a\u0440\u0430\u043c\u044d\u043d\u0442\u0430\u043c \u0435\u0434\u043d\u0430\u0441\u0446\u0456 \u045e\u0441\u044f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0446\u0442\u0432\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u043e\u0432\u0430\u0435 \u043f\u0430\u0442\u043e\u043c\u0441\u0442\u0432\u0430, \u044f\u043a\u043e\u0435 \u0422\u044b \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u045e \u043f\u0440\u0430\u0437 \u0432\u0430\u0434\u0443 \u0456 \u0414\u0443\u0445\u0430 \u0421\u0432\u044f\u0442\u043e\u0433\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0439 \u0432\u0435\u0440\u043d\u044b\u043c \u043b\u0430\u0441\u0446\u044b \u0445\u0440\u043e\u0441\u0442\u0443 \u0434\u043b\u044f \u0432\u0435\u0447\u043d\u0430\u0433\u0430 \u0436\u044b\u0446\u0446\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0421\u044b\u043d\u0430 \u043f\u0430\u0434\u0442\u0440\u044b\u043c\u043b\u0456\u0432\u0430\u0439 \u043d\u044f\u0448\u0447\u0430\u0441\u043d\u044b\u0445, \u0432\u044b\u0437\u0432\u0430\u043b\u044f\u0439 \u0437\u043d\u044f\u0432\u043e\u043b\u0435\u043d\u044b\u0445 \u0456 \u043b\u044f\u0447\u044b \u0445\u0432\u043e\u0440\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;&nbsp; <\/span>\u0440\u0430\u0434\u0443\u0439 \u0441\u0432\u0435\u0442 \u0441\u0432\u0430\u0456\u043c\u0456 \u0434\u0430\u0431\u0440\u0430\u0434\u0437\u0435\u0439\u0441\u0442\u0432\u0430\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u043f\u0430\u0445\u0430\u0432\u0430\u043d\u044b\u044f \u0431\u0440\u0430\u0442\u044b, \u044f\u043a\u0456\u043c \u0422\u044b \u0434\u0430\u0432\u0430\u045e \u0426\u0435\u043b\u0430 \u0456 \u041a\u0440\u043e\u045e \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u0430\u0433\u0430 \u0425\u0440\u044b\u0441\u0442\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0442\u0440\u044b\u043c\u0430\u043b\u0456 \u045e\u0434\u0437\u0435\u043b \u0443 \u042f\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0456.<\/p>\r\n"}, {"NESH_Prosby_ID":"5062","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430 \u041f\u0430\u043d\u0430, \u044f\u043a\u0456 \u0430\u0441\u0432\u044f\u0442\u043b\u0456\u045e \u0441\u0432\u0435\u0442 \u0441\u0432\u0430\u0456\u043c \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435\u043c:<br \/><em>\u0425\u0440\u044b\u0441\u0442\u044d, \u0436\u044b\u0446\u0446\u0451 \u043d\u0430\u0448\u0430, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u0415\u0437\u0443 \u0425\u0440\u044b\u0441\u0442\u044d, \u0422\u044b \u0434\u0430\u043b\u0443\u0447\u044b\u045e\u0441\u044f \u0434\u0430 \u0432\u0443\u0447\u043d\u044f\u045e \u043f\u0430 \u0434\u0430\u0440\u043e\u0437\u0435 \u045e \u042d\u043c\u0430\u0443\u0441,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0431\u0443\u0434\u0437\u044c \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0441\u0430 \u0441\u0432\u0430\u0456\u043c \u043f\u0456\u043b\u0456\u0433\u0440\u044b\u043c\u0443\u044e\u0447\u044b\u043c \u041a\u0430\u0441\u0446\u0451\u043b\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0439 \u0441\u0432\u0430\u0456\u043c \u0432\u0435\u0440\u043d\u0456\u043a\u0430\u043c \u0431\u044b\u0446\u044c \u0430\u0431\u044b\u044f\u043a\u0430\u0432\u044b\u043c\u0456 \u0434\u0430 \u0432\u0435\u0440\u044b,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u044f\u043d\u044b \u0432\u044b\u0437\u043d\u0430\u0432\u0430\u043b\u0456 \u0426\u044f\u0431\u0435 \u044f\u043a \u043f\u0435\u0440\u0430\u043c\u043e\u0436\u0446\u0443 \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u041b\u0430\u0441\u043a\u0430\u0432\u0430 \u043f\u0430\u0433\u043b\u044f\u0434\u0437\u0456 \u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u045e \u0426\u044f\u0431\u0435 \u045e \u0434\u0430\u0440\u043e\u0437\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0456 \u0434\u0430\u0439 \u0456\u043c \u043f\u0430\u0437\u043d\u0430\u0446\u044c \u0441\u044f\u0431\u0435, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0440\u044b\u043d\u044f\u043b\u0456 \u0426\u044f\u0431\u0435 \u044f\u043a \u0417\u0431\u0430\u045e\u0446\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0437 \u043a\u0440\u044b\u0436 \u0422\u044b \u0430\u0431&rsquo;\u044f\u0434\u043d\u0430\u045e \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0443 \u0441\u0432\u0430\u0456\u043c \u0446\u0435\u043b\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0434\u0430\u0439 \u0443\u0441\u0456\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c \u0441\u043f\u0430\u043a\u043e\u0439 \u0456 \u0435\u0434\u043d\u0430\u0441\u0446\u044c.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0443\u0434\u0434\u0437\u044f \u0436\u044b\u0432\u044b\u0445 \u0456 \u043c\u0451\u0440\u0442\u0432\u044b\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0434\u0437\u044f\u043b\u0456 \u0430\u0434\u043f\u0443\u0448\u0447\u044d\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u043c, \u0448\u0442\u043e \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0426\u044f\u0431\u0435.<\/p>\r\n"}, {"NESH_Prosby_ID":"5063","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0441\u043f\u044b\u043d\u043d\u0430 \u043f\u0440\u043e\u0441\u0456\u043c \u0425\u0440\u044b\u0441\u0442\u0430, \u044f\u043a\u0456 \u043f\u0440\u0430\u0437 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u0435 \u043f\u0430\u0434\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u043d\u0430\u0434\u0437\u0435\u044e \u0441\u0432\u0430\u0439\u0433\u043e \u043d\u0430\u0440\u043e\u0434\u0443:<br \/><em>\u0425\u0440\u044b\u0441\u0442\u044d, \u0432\u0435\u0447\u043d\u0430 \u0436\u044b\u0432\u044b, \u0432\u044b\u0441\u043b\u0443\u0445\u0430\u0439 \u043d\u0430\u0441.<\/em><\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435 \u0415\u0437\u0443, \u0437 \u0422\u0432\u0430\u0439\u0433\u043e \u043f\u0440\u0430\u0431\u0456\u0442\u0430\u0433\u0430 \u0431\u043e\u043a\u0443 \u0432\u044b\u0446\u0435\u043a\u043b\u0456 \u043a\u0440\u043e\u045e \u0456 \u0432\u0430\u0434\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456 \u041a\u0430\u0441\u0446\u0451\u043b \u0441\u0432\u0430\u0451\u0439 \u0431\u0435\u0437\u0437\u0430\u0433\u0430\u043d\u043d\u0430\u0439 \u0430\u0431\u0440\u0430\u043d\u043d\u0456\u0446\u0430\u0439.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0439\u0432\u044b\u0448\u044d\u0439\u0448\u044b \u041f\u0430\u0441\u0442\u044b\u0440, \u043f\u0430\u0441\u043b\u044f \u0441\u0432\u0430\u0439\u0433\u043e \u045e\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0435\u043d\u043d\u044f \u0422\u044b \u0434\u0430\u0440\u0443\u0447\u044b\u045e \u043f\u0430\u0441\u0432\u0456\u0446\u044c \u0430\u0432\u0435\u0447\u0430\u043a \u041f\u044f\u0442\u0440\u0443, \u044f\u043a\u0456 \u0432\u044b\u0437\u043d\u0430\u045e \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0426\u044f\u0431\u0435;<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u043f\u0430\u0432\u044f\u043b\u0456\u0447\u0432\u0430\u0439 \u043b\u044e\u0431\u043e\u045e \u0456 \u0440\u0443\u043f\u043b\u0456\u0432\u0430\u0441\u0446\u044c \u043d\u0430\u0448\u0430\u0433\u0430 \u043f\u0430\u043f\u044b <span style=\"color: #ff0000;\">N.<\/span><\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u0434\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u043c, \u044f\u043a\u0456\u044f \u0440\u044b\u0431\u0430\u0447\u044b\u043b\u0456 \u043d\u0430 \u0432\u043e\u0437\u0435\u0440\u044b, \u0432\u044f\u043b\u0456\u043a\u0456 \u045e\u043b\u043e\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0430\u0448\u043b\u0456 \u0440\u0430\u0431\u043e\u0442\u043d\u0456\u043a\u0430\u045e, \u044f\u043a\u0456\u044f \u0431\u0443\u0434\u0443\u0446\u044c \u043f\u0440\u0430\u0446\u044f\u0433\u0432\u0430\u0446\u044c \u0456\u0445 \u0430\u043f\u043e\u0441\u0442\u0430\u043b\u044c\u0441\u043a\u0443\u044e \u043c\u0456\u0441\u0456\u044e.<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u044b \u043f\u0440\u044b\u0433\u0430\u0442\u0430\u0432\u0430\u045e \u0432\u0443\u0447\u043d\u044f\u043c \u043d\u0430 \u0431\u0435\u0440\u0430\u0437\u0435 \u0432\u043e\u0437\u0435\u0440\u0430 \u0445\u043b\u0435\u0431 \u0456 \u0440\u044b\u0431\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u0435 \u0434\u0430\u0437\u0432\u0430\u043b\u044f\u0439, \u043a\u0430\u0431 \u043b\u044e\u0434\u0437\u0456 \u0433\u0456\u043d\u0443\u043b\u0456 \u0430\