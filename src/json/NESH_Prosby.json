d\u0441\u043a\u0443\u044e \u043b\u044e\u0431\u043e\u045e \u0442\u044b\u043c, \u0445\u0442\u043e \u0437\u043d\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b.<\/p>\r\n<p>\u0422\u044b \u043f\u0430\u0436\u0430\u0434\u0430\u045e, \u043a\u0430\u0431 \u0443 \u0434\u043e\u043c\u0435 \u0415\u0437\u0443\u0441\u0430 \u0456 \u042e\u0437\u0430\u0444\u0430 \u041c\u0430\u0440\u044b\u044f \u0441\u0442\u0430\u043b\u0430 \u041c\u0430\u0446\u0456 \u0441\u044f\u043c&rsquo;\u0456,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u043f\u0440\u0430\u0437 \u042f\u0435 \u0437\u0430\u0441\u0442\u0443\u043f\u043d\u0456\u0446\u0442\u0432\u0430 \u045e\u0441\u0435 \u043c\u0430\u0446\u0456 \u0430\u0445\u043e\u045e\u0432\u0430\u043b\u0456 \u045e \u0441\u0435\u043c&rsquo;\u044f\u0445 \u043b\u044e\u0431\u043e\u045e \u0456 \u0441\u0432\u044f\u0442\u0430\u0441\u0446\u044c.<\/p>\r\n<p>\u0422\u044b \u045e\u043a\u0430\u0440\u0430\u043d\u0430\u0432\u0430\u045e \u041c\u0430\u0440\u044b\u044e \u043d\u0430 \u0423\u043b\u0430\u0434\u0430\u0440\u043a\u0443 \u043d\u0435\u0431\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u044f \u0432\u0435\u0447\u043d\u0430 \u0446\u0435\u0448\u044b\u043b\u0456\u0441\u044f \u045e \u0422\u0432\u0430\u043c\u0456 \u0432\u0430\u043b\u0430\u0434\u0430\u0440\u0441\u0442\u0432\u0435 \u0440\u0430\u0437\u0430\u043c \u0441\u0430 \u0441\u0432\u044f\u0442\u044b\u043c\u0456.<\/p>\r\n"}, {"NESH_Prosby_ID":"6341","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u0423\u0441\u043b\u0430\u0432\u0456\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u0443, \u044f\u043a\u0456 \u0431\u044b\u045e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b \u0411\u043e\u0433\u0443 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0456 \u045e\u0437\u043d\u044f\u0441\u0451\u043c \u0434\u0430 \u042f\u0433\u043e \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b:<br \/><em>\u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0448\u044b\u044f \u0432\u043e\u0447\u044b \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0422\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/em><\/p>\r\n<p style=\"text-align: justify;\"><em><\/em>\u0425\u0440\u044b\u0441\u0442\u044d \u0417\u0431\u0430\u045e\u0446\u0430, \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u043b\u044f \u0430\u0441\u0432\u044f\u0442\u043b\u0435\u043d\u043d\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0441\u0432\u044f\u0442\u043b\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0426\u044f\u0431\u0435, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0426\u044f\u0431\u0435, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c, \u0445\u0432\u0430\u043b\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u0406\u0437\u0440\u0430\u044d\u043b\u044f,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u044f\u0445\u0430\u0439 \u0422\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b \u0437\u0430\u044f\u0441\u043d\u0435\u0435 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443, \u044f\u043a\u043e\u0433\u0430 \u0447\u0430\u043a\u0430\u043b\u0456 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0426\u044f\u0431\u0435 \u044f\u043a \u0417\u0431\u0430\u045e\u0446\u0443 \u045e\u0431\u0430\u0447\u044b\u045e \u0421\u0456\u043c\u044f\u043e\u043d,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u043f\u0430\u0434\u0447\u0430\u0441 \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u044f \u041c\u0430\u0440\u044b\u044f, \u0422\u0432\u0430\u044f \u041c\u0430\u0446\u0456, \u043f\u0430\u0447\u0443\u043b\u0430 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u043f\u0440\u0430 \u043c\u0435\u0447 \u0431\u043e\u043b\u044e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u043c\u0430\u0446\u0443\u0439 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0432\u0435\u0434\u0432\u0430\u0435 \u043d\u0435\u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456 \u045e \u0422\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d, \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0448\u0447\u0430\u0441\u0446\u044f \u0441\u0432\u044f\u0442\u044b\u0445, \u0426\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e \u045e\u0431\u0430\u0447\u044b\u045e \u0421\u0456\u043c\u044f\u043e\u043d, \u0431\u043e \u0433\u043e\u0440\u0430\u0447\u0430 \u0436\u0430\u0434\u0430\u045e \u0433\u044d\u0442\u0430\u0433\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437&rsquo;\u044f\u0432\u0456\u0441\u044f \u045e \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435 \u0441\u0443\u0437\u0456\u0440\u0430\u0446\u044c \u0426\u044f\u0431\u0435 \u043f\u0430\u0441\u043b\u044f \u0441\u043c\u0435\u0440\u0446\u0456.<\/p>\r\n"}, {"NESH_Prosby_ID":"6342","NESH_Prosby_Text":"\r\n<p style=\"text-align: justify;\">\u041f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435\u043c \u043d\u0430\u0448\u0430\u0433\u0430 \u0417\u0431\u0430\u045e\u0446\u0443, \u044f\u043a\u0456 \u0431\u044b\u045e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u044b \u0411\u043e\u0433\u0443 \u045e \u0441\u0432\u044f\u0442\u044b\u043d\u0456, \u0456 \u045e\u0437\u043d\u043e\u0441\u0456\u043c \u0434\u0430 \u042f\u0433\u043e \u043d\u0430\u0448\u044b\u044f \u043f\u0440\u043e\u0441\u044c\u0431\u044b:<br \/><em>\u041d\u044f\u0445\u0430\u0439 \u043d\u0430\u0448\u044b\u044f \u0432\u043e\u0447\u044b \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u0422\u0432\u0430\u0451 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435, \u041f\u0430\u043d\u0435.<\/em><\/p>\r\n<p style=\"text-align: justify;\"><em><\/em>\u0425\u0440\u044b\u0441\u0442\u044d \u0417\u0431\u0430\u045e\u0446\u0430, \u0441\u0432\u044f\u0442\u043b\u043e \u0434\u043b\u044f \u0430\u0441\u0432\u044f\u0442\u043b\u0435\u043d\u043d\u044f \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0441\u0432\u044f\u0442\u043b\u0456 \u0442\u044b\u0445, \u0445\u0442\u043e \u043d\u0435 \u0432\u0435\u0434\u0430\u0435 \u0426\u044f\u0431\u0435, \u043a\u0430\u0431 \u044f\u043d\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456 \u045e \u0426\u044f\u0431\u0435, \u043f\u0440\u0430\u045e\u0434\u0437\u0456\u0432\u0430\u0433\u0430 \u0411\u043e\u0433\u0430.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u0430\u0448 \u0410\u0434\u043a\u0443\u043f\u0456\u0446\u0435\u043b\u044c, \u0445\u0432\u0430\u043b\u0430 \u043d\u0430\u0440\u043e\u0434\u0443 \u0422\u0432\u0430\u0439\u0433\u043e \u0406\u0437\u0440\u0430\u044d\u043b\u044f,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043d\u044f\u0445\u0430\u0439 \u0422\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b \u0437\u0430\u044f\u0441\u043d\u0435\u0435 \u0441\u044f\u0440\u043e\u0434 \u043d\u0430\u0440\u043e\u0434\u0430\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0415\u0437\u0443, \u044f\u043a\u043e\u0433\u0430 \u0447\u0430\u043a\u0430\u043b\u0456 \u045e\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0426\u044f\u0431\u0435 \u044f\u043a \u0417\u0431\u0430\u045e\u0446\u0443 \u045e\u0431\u0430\u0447\u044b\u045e \u0421\u0456\u043c\u044f\u043e\u043d,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u045e\u0441\u0456\u0445 \u043b\u044e\u0434\u0437\u0435\u0439 \u0434\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0435, \u043f\u0430\u0434\u0447\u0430\u0441 \u0422\u0432\u0430\u0439\u0433\u043e \u0430\u0445\u0432\u044f\u0440\u0430\u0432\u0430\u043d\u043d\u044f \u041c\u0430\u0440\u044b\u044f, \u0422\u0432\u0430\u044f \u041c\u0430\u0446\u0456, \u043f\u0430\u0447\u0443\u043b\u0430 \u043f\u0440\u0430\u0440\u043e\u0446\u0442\u0432\u0430 \u043f\u0440\u0430 \u043c\u0435\u0447 \u0431\u043e\u043b\u044e,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u043c\u0430\u0446\u0443\u0439 \u0442\u044b\u0445, \u0445\u0442\u043e \u0437\u0432\u0435\u0434\u0432\u0430\u0435 \u043d\u0435\u043f\u0440\u044b\u0435\u043c\u043d\u0430\u0441\u0446\u0456 \u045e \u0422\u0432\u0430\u0456\u043c \u0441\u043b\u0443\u0436\u044d\u043d\u043d\u0456.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0440\u044b\u0441\u0442\u044d, \u043a\u0440\u044b\u043d\u0456\u0446\u0430 \u0448\u0447\u0430\u0441\u0446\u044f \u0441\u0432\u044f\u0442\u044b\u0445, \u0426\u044f\u0431\u0435 \u043f\u0435\u0440\u0430\u0434 \u0441\u043c\u0435\u0440\u0446\u044e \u045e\u0431\u0430\u0447\u044b\u045e \u0421\u0456\u043c\u044f\u043e\u043d, \u0431\u043e \u0433\u043e\u0440\u0430\u0447\u0430 \u0436\u0430\u0434\u0430\u045e \u0433\u044d\u0442\u0430\u0433\u0430,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437&rsquo;\u044f\u0432\u0456\u0441\u044f \u045e \u0432\u0435\u0447\u043d\u0430\u0441\u0446\u0456 \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0440\u0430\u0433\u043d\u0435 \u0441\u