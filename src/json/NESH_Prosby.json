00;\">&ndash;<\/span> \u043a\u0430\u0431 \u0443\u0441\u0435 \u043b\u044e\u0434\u0437\u0456 \u0437\u043d\u0430\u0439\u0448\u043b\u0456 \u0434\u0430\u0440\u043e\u0433\u0443 \u0434\u0430 \u0426\u044f\u0431\u0435.<\/p>\r\n<p>\u0422\u044b \u043f\u0435\u0440\u0448\u044b \u0440\u0430\u0437 \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0430 \u043d\u0430\u0441, \u043a\u0430\u0431 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u0441\u0432\u0435\u0442\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u044b\u0439\u0434\u0437\u0456 \u043f\u0430\u045e\u0442\u043e\u0440\u043d\u0430 \u0456 \u0437\u0430\u0445\u0430\u0432\u0430\u0439 \u0441\u0432\u0430\u0456\u0445 \u0432\u0435\u0440\u043d\u044b\u0445 \u0430\u0434 \u0430\u0441\u0443\u0434\u0436\u044d\u043d\u043d\u044f.<\/p>\r\n<p>\u0422\u044b \u043f\u0440\u0430\u0437 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u0435 \u0434\u0430\u045e \u043d\u0430\u043c \u0441\u0432\u0430\u0431\u043e\u0434\u0443,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0437\u0430\u0445\u0430\u0432\u0430\u0439 \u0433\u044d\u0442\u044b \u0434\u0430\u0440, \u044f\u043a\u0456 \u0422\u044b \u0437\u0434\u0430\u0431\u044b\u045e \u0446\u0430\u043d\u043e\u0439 \u0441\u0432\u0430\u0451\u0439 \u041a\u0440\u044b\u0432\u0456.<\/p>\r\n<p>\u041a\u0430\u043b\u0456\u0441\u044c\u0446\u0456 \u0422\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043a\u0430\u0431 \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430 \u045e \u0446\u0435\u043b\u0435, \u0456 \u0437\u043d\u043e\u045e \u043f\u0440\u044b\u0439\u0434\u0437\u0435\u0448 \u0437\u0434\u0437\u0435\u0439\u0441\u043d\u0456\u0446\u044c \u0441\u0443\u0434, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0430\u0434\u0430\u0440\u044b \u0442\u0430\u0434\u044b \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445 \u0432\u0435\u0447\u043d\u0430\u0439 \u0443\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0430\u0439.<\/p>\r\n"}, {"NESH_Prosby_ID":"449","NESH_Prosby_Text":"\r\n<p>\u041f\u0430\u043a\u043b\u043e\u043d\u0456\u043c\u0441\u044f \u0425\u0440\u044b\u0441\u0442\u0443, \u044f\u043a\u0456 \u043f\u0440\u044b\u043d\u0456\u0437\u0456\u045e \u0441\u0430\u043c\u043e\u0433\u0430 \u0441\u044f\u0431\u0435, \u043f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u043f\u043e\u0441\u0442\u0430\u0446\u044c \u0441\u043b\u0443\u0433\u0456, \u0456 \u045e \u0441\u0432\u0430\u0456\u043c \u043f\u0430\u0434\u0430\u0431\u0435\u043d\u0441\u0442\u0432\u0435 \u0434\u0430 \u043d\u0430\u0441 \u0437\u0432\u0435\u0434\u0430\u045e \u0443\u0441\u0451, \u0430\u043a\u0440\u0430\u043c\u044f \u0433\u0440\u0430\u0445\u0443. \u0417 \u0433\u0430\u0440\u0430\u0447\u0430\u044e \u0432\u0435\u0440\u0430\u0439 \u043f\u0440\u043e\u0441\u0456\u043c \u042f\u0433\u043e:<br \/><em>\u041f\u0440\u0430\u0437 \u0441\u0432\u0430\u0451 \u043d\u0430\u0440\u0430\u0434\u0436\u044d\u043d\u043d\u0435 \u043f\u0440\u044b\u0439\u0434\u0437\u0456 \u043d\u0430 \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0443 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u043c.<\/em><\/p>\r\n<p>\u0422\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0443 \u0441\u0432\u0435\u0442 \u0456 \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u045e \u043d\u043e\u0432\u044b \u043b\u0430\u0434, \u044f\u043a\u0456 \u043f\u0440\u0430\u0434\u043a\u0430\u0437\u0432\u0430\u043b\u0456 \u043f\u0440\u0430\u0440\u043e\u043a\u0456, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0443\u0447\u044b\u043d\u0456, \u043a\u0430\u0431 \u0422\u0432\u043e\u0439 \u041a\u0430\u0441\u0446\u0451\u043b \u0437\u0430\u045e\u0441\u0451\u0434\u044b \u0437\u0430\u0441\u0442\u0430\u0432\u0430\u045e\u0441\u044f \u043c\u0430\u043b\u0430\u0434\u044b\u043c.<\/p>\r\n<p>\u0422\u044b \u043f\u0440\u044b\u043d\u044f\u045e \u043b\u044e\u0434\u0441\u043a\u0443\u044e \u0441\u043b\u0430\u0431\u0430\u0441\u0446\u044c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0431\