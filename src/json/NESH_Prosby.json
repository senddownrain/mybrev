2\u0430\u0431\u043e\u0434\u0443 \u0456 \u0441\u043f\u0430\u043a\u043e\u0439 \u043f\u0430\u043c\u0456\u0436 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456.<\/p>\r\n<p>\u0423\u0441\u0435\u043c\u0430\u0433\u0443\u0442\u043d\u044b \u0412\u0430\u043b\u0430\u0434\u0430\u0440, \u0446\u0432\u044f\u0440\u0434\u044b\u043d\u044f \u0441\u043b\u0430\u0431\u044b\u0445, \u0443\u043c\u0430\u0446\u043e\u045e\u0432\u0430\u0439 \u0442\u044b\u0445, \u043a\u0430\u0433\u043e \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u044e\u0446\u044c, \u043f\u0430\u0434\u044b\u043c\u0430\u0439 \u0442\u044b\u0445, \u0445\u0442\u043e \u045e\u043f\u0430\u045e, \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0439 \u0442\u044b\u0445, \u0445\u0442\u043e \u0430\u043f\u044b\u043d\u0443\u045e\u0441\u044f \u045e \u043d\u0435\u0431\u044f\u0441\u043f\u0435\u0446\u044b, <br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u0441\u0443\u0446\u0435\u0448 \u043f\u0430\u0434\u043c\u0430\u043d\u0443\u0442\u044b\u0445 \u0456 \u0440\u0430\u0441\u0447\u0430\u0440\u0430\u0432\u0430\u043d\u044b\u0445, \u0443\u043c\u0430\u0446\u0443\u0439 \u043f\u0435\u0440\u0430\u0441\u043b\u0435\u0434\u0430\u0432\u0430\u043d\u044b\u0445 \u0437\u0430 \u0432\u0435\u0440\u0443.<\/p>\r\n<p>\u0421\u0443\u0446\u044f\u0448\u044b\u0446\u0435\u043b\u044c \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u043d\u044b\u0445, \u0434\u0430\u0439 \u0441\u0456\u043b\u044b \u0442\u044b\u043c, \u0445\u0442\u043e \u043f\u0430\u043c\u0456\u0440\u0430\u0435,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u0456\u0445 \u0434\u0430 \u0436\u044b\u0446\u0446\u044f\u0434\u0430\u0439\u043d\u044b\u0445 \u043a\u0440\u044b\u043d\u0456\u0446\u0430\u045e.<\/p>\r\n"}, {"NESH_Prosby_ID":"460","NESH_Prosby_Text":"\r\n<p>\u0411\u043e\u0433 \u0448\u043c\u0430\u0442 \u0440\u0430\u0437\u043e\u045e \u0456 \u043f\u0430-\u0440\u043e\u0437\u043d\u0430\u043c\u0443 \u043f\u0440\u0430\u043c\u0430\u045e\u043b\u044f\u045e \u0434\u0430 \u043