4f\u0440\u043e\u0434 \u0443\u0441\u0456\u0445 \u043b\u044e\u0434\u0441\u043a\u0456\u0445 \u043d\u044f\u0448\u0447\u0430\u0441\u0446\u044f\u045e \u0422\u044b \u043d\u0430 \u043f\u0440\u0430\u0446\u044f\u0433\u0443 \u0432\u044f\u043a\u043e\u045e \u0431\u044b\u045e \u043d\u0430\u0448\u044b\u043c \u041f\u0430\u0441\u0440\u044d\u0434\u043d\u0456\u043a\u0430\u043c,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u045e\u0441\u0451 \u0434\u0430 \u0441\u044f\u0431\u0435 &ndash; \u0411\u043e\u0433\u0430 \u0456 \u0417\u0431\u0430\u045e\u0446\u044b.<\/p>\r\n<p>\u0426\u044f\u0431\u0435 \u0447\u0430\u043a\u0430\u043b\u0456 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443, \u0456 \u0422\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e, \u043a\u0430\u043b\u0456 \u043d\u0430\u0441\u0442\u0430\u045e \u0447\u0430\u0441,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0430\u043a\u0430\u0436\u044b \u0441\u0432\u0430\u044e \u043f\u0440\u044b\u0441\u0443\u0442\u043d\u0430\u0441\u0446\u044c \u0442\u044b\u043c, \u0445\u0442\u043e \u0426\u044f\u0431\u0435 \u0434\u0430\u0433\u044d\u0442\u0443\u043b\u044c \u0447\u0430\u043a\u0430\u0435.<\/p>\r\n<p>\u0422\u044b \u043f\u0440\u044b\u0439\u0448\u043e\u045e \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u045e\u0441\u0456\u0445,<br \/><span style=\"color: #ff0000;\">&ndash;<\/span> \u043f\u0440\u044b\u0432\u044f\u0434\u0437\u0456 \u0434\u0430 \u043b\u0430\u0441\u043a\u0456 \u0445\u0440\u043e\u0441\u0442\u0443 \u0442\u044b\u0445, \u0445\u0442\u043e \u043f\u0430\u0432\u0456\u043d\u0435\u043d \u043d\u0430\u0440\u0430\u0434\u0437\u0456\u0446\u0446\u0430.<\/p>\r\n<p>\u041f\u0440\u044b\u043d\u044f\u045e\u0448\u044b \u0446\u0435\u043b\u0430, \u0422\u044b \u0430\u0434\u043d\u0430\u0432\u0456\u045e \u043b\u044e\u0434\u0441\u043a\u0443\u044e \u043d\u0430\u0442\u0443\u0440\u0443, \u0441\u0430\u043f\u0441\u0430\u0432\u0430\u043d\u0443\u044e \u0433