[{"UTR_Chyt_ID":"11","UTR_Chyt_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0410\u043f 7, 10b. 12<\/span><br \/>\u0417\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443, \u044f\u043a\u0456 \u0441\u044f\u0434\u0437\u0456\u0446\u044c \u043d\u0430 \u0442\u0440\u043e\u043d\u0435, \u0456 \u0411\u0430\u0440\u0430\u043d\u043a\u0443. \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0456 \u0441\u043b\u0430\u0432\u0430, \u0456 \u043c\u0443\u0434\u0440\u0430\u0441\u0446\u044c, \u0456 \u043f\u0430\u0434\u0437\u044f\u043a\u0430, \u0456 \u043f\u0430\u0448\u0430\u043d\u0430, \u0456 \u0441\u0456\u043b\u0430, \u0456 \u043c\u043e\u0446 \u0411\u043e\u0433\u0443 \u043d\u0430\u0448\u0430\u043c\u0443 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u044f\u043a\u043e\u045e. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0440\u044b\u0441\u0442\u044d, \u0421\u044b\u043d\u0435 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0425\u0440\u044b\u0441\u0442\u044d, \u0421\u044b\u043d\u0435 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, <span style=\"color: #ff0000;\">*<\/span> \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f\u043a\u0456 \u0441\u044f\u0434\u0437\u0456\u0448 \u043f\u0