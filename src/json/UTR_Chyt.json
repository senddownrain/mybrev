0430\u0437\u0430\u045e \u043d\u0430\u043c \u0430\u0431\u0432\u044f\u0448\u0447\u0430\u0446\u044c \u043d\u0430\u0440\u043e\u0434\u0443 \u0456 \u0441\u0432\u0435\u0434\u0447\u044b\u0446\u044c, \u0448\u0442\u043e \u0401\u043d \u043f\u0440\u044b\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u0411\u043e\u0433\u0430\u043c \u0441\u0443\u0434\u0434\u0437\u044f \u0436\u044b\u0432\u044b\u0445 \u0456 \u043f\u0430\u043c\u0435\u0440\u043b\u044b\u0445. \u041f\u0440\u0430 \u042f\u0433\u043e \u045e\u0441\u0435 \u043f\u0440\u0430\u0440\u043e\u043a\u0456 \u0441\u0432\u0435\u0434\u0447\u0430\u0446\u044c, \u0448\u0442\u043e \u043a\u043e\u0436\u043d\u044b, \u0445\u0442\u043e \u0432\u0435\u0440\u044b\u0446\u044c \u0443 \u042f\u0433\u043e, \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0434\u0430\u0440\u0430\u0432\u0430\u043d\u043d\u0435 \u0433\u0440\u0430\u0445\u043e\u045e \u043f\u0440\u0430\u0437 \u0456\u043c\u044f \u042f\u0433\u043e\u043d\u0430\u0435.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"text-align: justify; color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u0425\u0440\u044b\u0441\u0442\u044d, \u0421\u044b\u043d\u0435 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430, \u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456,&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">*<\/span><span style=\"text-align: justify;\">&nbsp;\u0430\u043b\u043b\u0435\u043b\u044e\u044f, \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041d.<\/span><span style=\"text-align: justify;\">&nbsp;\u0425\u0440\u044b\u0441\u0442\u044d, \u0421\u044b\u043d\u0435 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u04