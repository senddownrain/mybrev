u0430\u0431\u0440\u043e. \u0428\u0443\u043a\u0430\u0439\u0446\u0435 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u044f, \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439\u0446\u0435 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u0430\u043c\u0443, \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0439\u0446\u0435 \u0441\u0456\u0440\u0430\u0442\u0443, \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435\u0441\u044f \u0437\u0430 \u045e\u0434\u0430\u0432\u0443. \u041f\u0440\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435, \u0456 \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u0456\u043c, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. &ndash; \u041a\u0430\u043b\u0456 \u0433\u0440\u0430\u0445\u0456 \u0432\u0430\u0448\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c, \u044f\u043a \u0447\u044b\u0440\u0432\u0430\u043d\u044c, &ndash; \u0437\u0431\u044f\u043b\u0435\u044e\u0446\u044c \u044f\u043a \u0441\u043d\u0435\u0433; \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0430\u0440\u0432\u043e\u0432\u044b\u044f, \u044f\u043a \u043f\u0443\u0440\u043f\u0443\u0440, &ndash; \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u044f\u043a \u0432\u043e\u045e\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"text-align: justify; color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u041f\u0430\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043c\u044f\u043d\u0435<\/span><span style=\"text-align: justify; color: #ff0000;\">&nbsp;*<\/span><span style=\"text-align: justify;\">&nbsp;\u0430\u0434 \u043f\u0430\u0441\u0442\u043a\u0456 \u043f\u0430\u043b\u044f\u045e\u043d\u0456\u0447\u044b\u0445.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff000