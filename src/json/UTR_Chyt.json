0437\u044f\u043c\u043b\u0456, \u0442\u044b \u0431\u044b\u045e \u042f\u0433\u043e \u045e\u043b\u0430\u0441\u043d\u044b\u043c \u043d\u0430\u0440\u043e\u0434\u0430\u043c, \u0442\u0430\u043c\u0443 \u0448\u0442\u043e \u041f\u0430\u043d \u043f\u0430\u043b\u044e\u0431\u0456\u045e \u0432\u0430\u0441. \u0406 \u043a\u0430\u0431 \u0437\u0430\u0445\u0430\u0432\u0430\u0446\u044c \u043f\u0440\u044b\u0441\u044f\u0433\u0443, \u0434\u0430\u0434\u0437\u0435\u043d\u0443\u044e \u0432\u0430\u0448\u044b\u043c \u043f\u0440\u043e\u0434\u043a\u0430\u043c, \u0432\u044b\u0432\u0435\u045e \u0432\u0430\u0441 \u043c\u043e\u0446\u043d\u0430\u044e \u0440\u0443\u043a\u043e\u044e \u0456 \u0432\u044b\u043a\u0443\u043f\u0456\u045e \u0432\u0430\u0441 \u0437 \u0434\u043e\u043c\u0443 \u043d\u044f\u0432\u043e\u043b\u0456, \u0437 \u0440\u0443\u043a \u0444\u0430\u0440\u0430\u043e\u043d\u0430, \u043a\u0430\u0440\u0430\u043b\u044f \u0415\u0433\u0456\u043f\u0442\u0430. \u0422\u0430\u043c\u0443 \u0432\u0435\u0434\u0430\u0439, \u0448\u0442\u043e \u041f\u0430\u043d, \u0411\u043e\u0433 \u0442\u0432\u043e\u0439, \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, \u0411\u043e\u0433\u0430\u043c \u0432\u0435\u0440\u043d\u044b\u043c, \u044f\u043a\u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0442 \u0456 \u043b\u044e\u0431\u043e\u045e \u0434\u0430 \u0442\u044b\u0441\u044f\u0447\u043d\u0430\u0433\u0430 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u0430\u0434\u043d\u043e\u0441\u043d\u0430 \u0442\u044b\u0445, \u0445\u0442\u043e \u043b\u044e\u0431\u0456\u0446\u044c \u042f\u0433\u043e \u0456 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0435 \u0437\u0430\u043f\u0430\u0432\u0435\u0434\u0437\u0456 \u042f\u0433\u043e\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"text-align: justify; color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br style=\"text-align: