"UTR_Chyt_ID":"13","UTR_Chyt_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0420\u044b\u043c 13, 11b. 12-13\u0430<\/span><br \/>\u041d\u0430\u0441\u0442\u0430\u043b\u0430 \u045e\u0436\u043e \u043f\u0430\u0440\u0430, \u043a\u0430\u0431 \u0432\u044b \u0430\u0431\u0443\u0434\u0437\u0456\u043b\u0456\u0441\u044f \u0441\u0430 \u0441\u043d\u0443, \u0431\u043e \u0446\u044f\u043f\u0435\u0440 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0431\u043b\u0456\u0436\u044d\u0439 \u0434\u0430 \u043d\u0430\u0441, \u0447\u044b\u043c \u0442\u0430\u0434\u044b, \u043a\u0430\u043b\u0456 \u043c\u044b \u043f\u0430\u0432\u0435\u0440\u044b\u043b\u0456. \u041d\u043e\u0447 \u043c\u0456\u043d\u0443\u043b\u0430 \u0456 \u043d\u0430\u0431\u043b\u0456\u0437\u0456\u045e\u0441\u044f \u0434\u0437\u0435\u043d\u044c. \u0422\u0430\u043c\u0443 \u0430\u0434\u043a\u0456\u043d\u0435\u043c \u0443\u0447\u044b\u043d\u043a\u0456 \u0446\u0435\u043c\u0440\u044b \u0456 \u0430\u043f\u0440\u0430\u043d\u0435\u043c\u0441\u044f \u045e \u0437\u0431\u0440\u043e\u044e \u0441\u0432\u044f\u0442\u043b\u0430. \u042f\u043a \u0443 \u0434\u0437\u0435\u043d\u044c, \u0431\u0443\u0434\u0437\u0435\u043c \u043f\u0430\u0432\u043e\u0434\u0437\u0456\u0446\u044c \u0441\u044f\u0431\u0435 \u043f\u0440\u044b\u0441\u0442\u043e\u0439\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041c\u043e\u0439 \u0411\u043e\u0433 &ndash; \u043c\u0430\u044f \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430,<span style=\"color: #ff0000;\"> *<\/span> \u044f \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u043e\u0439 \u0411\u043e\u0433 &ndash; \u043c\u0430\u044f \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430, <span style=\"color: #ff0000;\">*<\/span> \u044f \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u041f\u0440\u044b\u0441\u0442\u0430\u043d\u0456\u0448\u0447\u0430 \u043c\u0430\u0451 \u0456 \u043c\u043e\u0439 \u0417\u0431\u0430\u045e\u0446\u0430.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0432\u0430\u043b\u0430 \u0410\u0439\u0446\u0443 \u0456 \u0421\u044b\u043d\u0443, \u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041c\u043e\u0439 \u0411\u043e\u0433 &ndash; \u043c\u0430\u044f \u0434\u0430\u043f\u0430\u043c\u043e\u0433\u0430, <span style=\"color: #ff0000;\">*<\/span> \u044f \u043d\u0430 \u042f\u0433\u043e \u0441\u043f\u0430\u0434\u0437\u044f\u044e\u0441\u044f.<\/p>\r\n"}, {"UTR_Chyt_ID":"14","UTR_Chyt_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0422\u043e\u0431 4, 14-15\u0430. 16\u0430b. 19<\/span><br \/>C\u044b\u043d\u0435, \u0437\u0432\u0430\u0436\u0430\u0439 \u043d\u0430 \u0441\u044f\u0431\u0435 \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0441\u043f\u0440\u0430\u0432\u0430\u0445 \u0456 \u0431\u0443\u0434\u0437\u044c \u043c\u0443\u0434\u0440\u044b \u0432\u0430 \u045e\u0441\u0456\u0445 \u0441\u0432\u0430\u0456\u0445 \u0441\u043b\u043e\u0432\u0430\u0445. \u0428\u0442\u043e \u0441\u0430\u043c \u043d\u0435\u043d\u0430\u0432\u0456\u0434\u0437\u0456\u0448, \u0442\u0430\u0433\u043e \u043d\u0435 \u0440\u0430\u0431\u0456 \u043d\u0456\u043a\u043e\u043c\u0443. \u0417 \u0433\u0430\u043b\u043e\u0434\u043d\u044b\u043c \u0434\u0437\u044f\u043b\u0456\u0441\u044f \u0441\u0432\u0430\u0456\u043c \u0445\u043b\u0435\u0431\u0430\u043c \u0456 \u0437 \u043d\u0430\u0433\u0456\u043c\u0456 \u0441\u0432\u0430\u0451\u0439 \u0432\u043e\u043f\u0440\u0430\u0442\u043a\u0430\u0439. \u0417 \u0443\u0441\u044f\u0433\u043e, \u0448\u0442\u043e \u043c\u0430\u0435\u0448 \u0443\u0434\u043e\u0441\u0442\u0430\u043b\u044c, \u0434\u0430\u0432\u0430\u0439 \u043c\u0456\u043b\u0430\u0441\u0446\u0456\u043d\u0443. \u0411\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456 \u041f\u0430\u043d\u0430 \u0411\u043e\u0433\u0430 \u045e \u043a\u043e\u0436\u043d\u044b \u0447\u0430\u0441 \u0456 \u043f\u0440\u0430\u0441\u0456 \u045e \u042f\u0433\u043e, \u043a\u0430\u0431 \u0448\u043b\u044f\u0445\u0456 \u0442\u0432\u0430\u0435 \u0431\u044b\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u044b\u044f \u0456 \u045e\u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u044b \u0456 \u043d\u0430\u043c\u0435\u0440\u044b \u0442\u0432\u0430\u0435 \u043f\u0430\u0441\u043f\u044f\u0445\u043e\u0432\u044b\u043c\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0411\u043e\u0436\u0430, \u0441\u0445\u0456\u043b\u0456 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 <span style=\"color: #ff0000;\">*<\/span> \u0434\u0430 \u0422\u0432\u0430\u0456\u0445 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f\u045e.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0436\u0430, \u0441\u0445\u0456\u043b\u0456 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 <span style=\"color: #ff0000;\">*<\/span> \u0434\u0430 \u0422\u0432\u0430\u0456\u0445 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0410\u0436\u044b\u0432\u0456 \u043c\u044f\u043d\u0435 \u043d\u0430 \u0448\u043b\u044f\u0445\u0443 \u0422\u0432\u0430\u0456\u043c.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0414\u0430 \u0422\u0432\u0430\u0456\u0445 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f\u045e.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0432\u0430\u043b\u0430 \u0410\u0439\u0446\u0443 \u0456 \u0421\u044b\u043d\u0443, \u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u0411\u043e\u0436\u0430, \u0441\u0445\u0456\u043b\u0456 \u043c\u0430\u0451 \u0441\u044d\u0440\u0446\u0430 <span style=\"color: #ff0000;\">*<\/span> \u0434\u0430 \u0422\u0432\u0430\u0456\u0445 \u0441\u0432\u0435\u0434\u0447\u0430\u043d\u043d\u044f\u045e.<\/p>\r\n"}, {"UTR_Chyt_ID":"15","UTR_Chyt_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0406\u0441 66, 1-2<\/span><br \/>\u0422\u0430\u043a \u043a\u0430\u0436\u0430 \u041f\u0430\u043d: \u041d\u0435\u0431\u0430 &ndash; \u0442\u0440\u043e\u043d \u043c\u043e\u0439, \u0430 \u0437\u044f\u043c\u043b\u044f &ndash; \u043f\u0430\u0434\u043d\u043e\u0436\u0436\u0430 \u041c\u0430\u0456\u0445 \u043d\u043e\u0433; \u0434\u0437\u0435 \u0436 \u0432\u044b \u043f\u0430\u0431\u0443\u0434\u0443\u0435\u0446\u0435 \u0434\u043b\u044f \u041c\u044f\u043d\u0435 \u0434\u043e\u043c \u0456 \u0434\u0437\u0435 \u043c\u0435\u0441\u0446\u0430 \u041c\u0430\u0439\u0433\u043e \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u043a\u0443? \u0411\u043e \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u045e\u0447\u044b\u043d\u0456\u043b\u0430 \u041c\u0430\u044f \u0440\u0443\u043a\u0430, \u0456 \u045e\u0441\u0451 \u0433\u044d\u0442\u0430 \u0431\u044b\u043b\u043e, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. \u0406 \u0432\u043e\u0441\u044c \u043d\u0430 \u043a\u0430\u0433\u043e \u042f \u043f\u0430\u0433\u043b\u044f\u0434\u0436\u0443: \u043d\u0430 \u043f\u0430\u043a\u043e\u0440\u043d\u0430\u0433\u0430 \u0456 \u0441\u043a\u0440\u0443\u0448\u0430\u043d\u0430\u0433\u0430 \u0434\u0443\u0445\u0430\u043c \u0456 \u043d\u0430 \u0442\u0430\u0433\u043e, \u0445\u0442\u043e \u0434\u0440\u044b\u0436\u044b\u0446\u044c \u043f\u0435\u0440\u0430\u0434 \u041c\u0430\u0456\u043c \u0441\u043b\u043e\u0432\u0430\u043c.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u042f \u043a\u043b\u0456\u0447\u0443 \u045e\u0441\u0456\u043c \u043c\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c: <span style=\"color: #ff0000;\">*<\/span> \u043f\u0430\u0447\u0443\u0439 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043a\u043b\u0456\u0447\u0443 \u045e\u0441\u0456\u043c \u043c\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c: <span style=\"color: #ff0000;\">*<\/span> \u043f\u0430\u0447\u0443\u0439 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0406 \u0431\u0443\u0434\u0443 \u0437\u0430\u0445\u043e\u045e\u0432\u0430\u0446\u044c \u0422\u0432\u0430\u0435 \u043f\u0430\u0441\u0442\u0430\u043d\u043e\u0432\u044b.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u041f\u0430\u0447\u0443\u0439 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435.<br \/><span style=\"color: #ff0000;\">\u041a.<\/span> \u0425\u0432\u0430\u043b\u0430 \u0410\u0439\u0446\u0443 \u0456 \u0421\u044b\u043d\u0443, \u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443.<br \/><span style=\"color: #ff0000;\">\u041d.<\/span> \u042f \u043a\u043b\u0456\u0447\u0443 \u045e\u0441\u0456\u043c \u043c\u0430\u0456\u043c \u0441\u044d\u0440\u0446\u0430\u043c: <span style=\"color: #ff0000;\">*<\/span> \u043f\u0430\u0447\u0443\u0439 \u043c\u044f\u043d\u0435, \u041f\u0430\u043d\u0435.<\/p>\r\n"}, {"UTR_Chyt_ID":"16","UTR_Chyt_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u042d\u0444 4, 29-32<\/span><br \/>\u0423\u0441\u044f\u043a\u0430\u0435 \u043b\u0456\u0445\u043e\u0435 \u0441\u043b\u043e\u0432\u0430 \u043d\u044f\u0445\u0430\u0439 \u043d\u0435 \u0432\u044b\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0437 \u0432\u0443\u0441\u043d\u0430\u045e \u0432\u0430\u0448\u044b\u0445, \u0430\u043b\u0435 \u0442\u043e\u043b\u044c\u043a\u0456 \u0434\u043e\u0431\u0440\u0430\u0435, \u0434\u0437\u0435\u043b\u044f \u0437\u0431\u0443\u0434\u0430\u0432\u0430\u043d\u043d\u044f, \u043a\u0430\u0431 \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u043b\u0430\u0441\u043a\u0443 \u0442\u044b\u043c, \u0445\u0442\u043e \u0441\u043b\u0443\u0445\u0430\u0435. \u041d\u0435 \u0437\u0430\u0441\u043c\u0443\u0447\u0430\u0439\u0446\u0435 \u0421\u0432\u044f\u0442\u043e\u0433\u0430 \u0414\u0443\u0445\u0430 \u0411\u043e\u0436\u0430\u0433\u0430, \u044f\u043a\u0456\u043c \u0432\u044b \u043f\u0430\u0437\u043d\u0430\u0447\u0430\u043d\u044b \u043d\u0430 \u0434\u0437\u0435\u043d\u044c \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u043d\u044f. \u0423\u0441\u044f\u043a\u0430\u044f \u0433\u043e\u0440\u044b\u0447 \u0456 \u0440\u0430\u0437\u0434\u0440\u0430\u0436\u043d\u0435\u043d\u043d\u0435, \u0456 \u0433\u043d\u0435\u045e, \u0456 \u043a\u0440\u044b\u043a, \u0456 \u0431\u043b\u044e\u0437\u043d\u0435\u0440\u0441\u0442\u0432\u0430 \u043d\u044f\u0445\u0430\u0439 \u0431\u0443\u0434\u0443\u0446\u044c \u0432\u044b\u0434\u0430\u043b\u0435\u043d\u044b \u0430\u0434 \u0432\u0430\u0441 \u0440\u0430\u0437\u0430\u043c \u0437 \u0443\u0441\u044f\u043a\u0430\u0439 \u0437\u043b\u043e\u0441\u0446\u044e. \u0412\u044b \u0436 \u0431\u0443\u0434\u0437\u044c\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0434\u0430 \u0430\u0434\u0