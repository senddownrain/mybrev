428\u0443\u043a\u0430\u0439\u0446\u0435 \u043f\u0440\u0430\u0432\u0430\u0441\u0443\u0434\u0434\u0437\u044f, \u0434\u0430\u043f\u0430\u043c\u0430\u0433\u0430\u0439\u0446\u0435 \u043f\u0440\u044b\u0433\u043d\u0435\u0447\u0430\u043d\u0430\u043c\u0443, \u0430\u0431\u0430\u0440\u0430\u043d\u044f\u0439\u0446\u0435 \u0441\u0456\u0440\u0430\u0442\u0443, \u0437\u0430\u0441\u0442\u0443\u043f\u0430\u0439\u0446\u0435\u0441\u044f \u0437\u0430 \u045e\u0434\u0430\u0432\u0443. \u041f\u0440\u044b\u0445\u043e\u0434\u0437\u044c\u0446\u0435, \u0456 \u0440\u0430\u0441\u0441\u0443\u0434\u0437\u0456\u043c, &ndash; \u043a\u0430\u0436\u0430 \u041f\u0430\u043d. &ndash; \u041a\u0430\u043b\u0456 \u0433\u0440\u0430\u0445\u0456 \u0432\u0430\u0448\u044b\u044f \u0431\u0443\u0434\u0443\u0446\u044c, \u044f\u043a \u0447\u044b\u0440\u0432\u0430\u043d\u044c, &ndash; \u0437\u0431\u044f\u043b\u0435\u044e\u0446\u044c \u044f\u043a \u0441\u043d\u0435\u0433; \u043a\u0430\u043b\u0456 \u0431\u0443\u0434\u0443\u0446\u044c \u0431\u0430\u0440\u0432\u043e\u0432\u044b\u044f, \u044f\u043a \u043f\u0443\u0440\u043f\u0443\u0440, &ndash; \u0441\u0442\u0430\u043d\u0443\u0446\u044c \u044f\u043a \u0432\u043e\u045e\u043d\u0430.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"text-align: justify; color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u041f\u0430\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043c\u044f\u043d\u0435<\/span><span style=\"text-align: justify; color: #ff0000;\">&nbsp;*<\/span><span style=\"text-align: justify;\">&nbsp;\u0430\u0434 \u043f\u0430\u0441\u0442\u043a\u0456 \u043f\u0430\u043b\u044f\u045e\u043d\u0456\u0447\u044b\u0445.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041d.<\/span><span style=\"text-align: justify;\">&nbsp;\u041f\u0430\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043c\u044f\u043d\u0435&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">*<\/span><span style=\"text-align: justify;\">&nbsp;\u0430\u0434 \u043f\u0430\u0441\u0442\u043a\u0456 \u043f\u0430\u043b\u044f\u045e\u043d\u0456\u0447\u044b\u0445.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u0406 \u0430\u0434 \u0437\u043b\u043e\u0433\u0430 \u0441\u043b\u043e\u0432\u0430.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041d.<\/span><span style=\"text-align: justify;\">&nbsp;\u0410\u0434 \u043f\u0430\u0441\u0442\u043a\u0456 \u043f\u0430\u043b\u044f\u045e\u043d\u0456\u0447\u044b\u0445.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u0425\u0432\u0430\u043b\u0430 \u0410\u0439\u0446\u0443 \u0456 \u0421\u044b\u043d\u0443, \u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041d.<\/span><span style=\"text-align: justify;\">&nbsp;\u041f\u0430\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043c\u044f\u043d\u0435&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">*<\/span><span style=\"text-align: justify;\">&nbsp;\u0430\u0434 \u043f\u0430\u0441\u0442\u043a\u0456 \u043f\u0430\u043b\u044f\u045e\u043d\u0456\u0447\u044b\u0445.<\/span><\/p>\r\n"}, {"UTR_Chyt_ID":"551","UTR_Chyt_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u041b\u0435\u0432 23, 4-7<\/span><br \/>\u0412\u043e\u0441\u044c \u0441\u0432\u044f\u0442\u044b \u041f\u0430\u043d\u0430, \u0441\u0445\u043e\u0434\u044b \u0441\u0432\u044f\u0442\u044b\u044f, \u044f\u043a\u0456\u044f \u0432\u044b \u043f\u0430\u0432\u0456\u043d\u043d\u044b \u0441\u043a\u043b\u0456\u043a\u0430\u0446\u044c \u0443 \u0430\u0434\u043f\u0430\u0432\u0435\u0434\u043d\u044b \u0447\u0430\u0441. \u0423 \u043f\u0435\u0440\u0448\u044b \u043c\u0435\u0441\u044f\u0446, \u0443 \u0447\u0430\u0442\u044b\u0440\u043d\u0430\u0446\u0446\u0430\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u043c\u0435\u0441\u044f\u0446\u0430 \u043f\u0430\u0434 \u0432\u0435\u0447\u0430\u0440 &ndash; \u041f\u0430\u0441\u0445\u0430 \u041f\u0430\u043d\u0430. \u0410 \u045e \u043f\u044f\u0442\u043d\u0430\u0446\u0446\u0430\u0442\u044b \u0434\u0437\u0435\u043d\u044c \u0442\u0430\u0433\u043e \u0441\u0430\u043c\u0430\u0433\u0430 \u043c\u0435\u0441\u044f\u0446\u0430 &ndash; \u0441\u0432\u044f\u0442\u0430 \u041f\u0440\u0430\u0441\u043d\u0430\u043a\u043e\u045e \u0434\u043b\u044f \u041f\u0430\u043d\u0430. \u0421\u0435\u043c \u0434\u0437\u0451\u043d \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0435\u0441\u0446\u0456 \u043f\u0440\u0430\u0441\u043d\u0430\u043a\u0456. \u0423 \u043f\u0435\u0440\u0448\u044b \u0434\u0437\u0435\u043d\u044c \u0431\u0443\u0434\u0437\u0435 \u0441\u043a\u043b\u0456\u043a\u0430\u043d\u044b \u0434\u043b\u044f \u0432\u0430\u0441 \u0441\u0432\u044f\u0442\u044b \u0441\u0445\u043e\u0434; \u043d\u0435 \u0431\u0443\u0434\u0437\u0435\u0446\u0435 \u0432\u044b\u043a\u043e\u043d\u0432\u0430\u0446\u044c \u043d\u0456\u044f\u043a\u0430\u0439 \u043f\u0440\u0430\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u0425\u0440\u044b\u0441\u0442\u044d, \u0421\u044b\u043d\u0435 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430,&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">*<\/span><span style=\"text-align: justify;\">&nbsp;\u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041d.<\/span><span style=\"text-align: justify;\">&nbsp;\u0425\u0440\u044b\u0441\u0442\u044d, \u0421\u044b\u043d\u0435 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430,&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">*<\/span><span style=\"text-align: justify;\">&nbsp;\u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u0422\u044b \u0446\u044f\u0440\u043f\u0435\u045e \u0437\u0430 \u043d\u0430\u0448\u044b\u044f \u0437\u043b\u0430\u0447\u044b\u043d\u0441\u0442\u0432\u044b.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041d.<\/span><span style=\"text-align: justify;\">&nbsp;\u0417\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u0425\u0432\u0430\u043b\u0430 \u0410\u0439\u0446\u0443 \u0456 \u0421\u044b\u043d\u0443, \u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041d.<\/span><span style=\"text-align: justify;\">&nbsp;\u0425\u0440\u044b\u0441\u0442\u044d, \u0421\u044b\u043d\u0435 \u0411\u043e\u0433\u0430 \u0436\u044b\u0432\u043e\u0433\u0430,&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">*<\/span><span style=\"text-align: justify;\">&nbsp;\u0437\u043c\u0456\u043b\u0443\u0439\u0441\u044f \u043d\u0430\u0434 \u043d\u0430\u043c\u0456.<\/span><\/p>\r\n"}, {"UTR_Chyt_ID":"552","UTR_Chyt_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0415\u0440 11, 19-20<\/span><br \/>\u042f \u0431\u044b\u045e, \u044f\u043a \u043f\u0440\u044b\u0440\u0443\u0447\u0430\u043d\u0430\u0435 \u044f\u0433\u043d\u044f, \u044f\u043a\u043e\u0435 \u0432\u044f\u0434\u0443\u0446\u044c \u043d\u0430 \u0437\u0430\u0431\u043e\u0439, \u0456 \u043d\u0435 \u0440\u0430\u0437\u0443\u043c\u0435\u045e, \u0448\u0442\u043e \u044f\u043d\u044b \u0437\u0430\u0434\u0443\u043c\u0430\u043b\u0456 \u0437\u043c\u043e\u0432\u0443 \u0441\u0443\u043f\u0440\u0430\u0446\u044c \u043c\u044f\u043d\u0435: &laquo;\u0417\u043d\u0456\u0448\u0447\u044b\u043c \u0434\u0440\u044d\u0432\u0430 \u045e \u043f\u043e\u045e\u043d\u0430\u0439 \u0441\u0456\u043b\u0435, \u0432\u044b\u0440\u0432\u0435\u043c \u044f\u0433\u043e \u0437 \u0437\u044f\u043c\u043b\u0456 \u0436\u044b\u0432\u044b\u0445, \u043a\u0430\u0431 \u043d\u0435 \u0437\u0433\u0430\u0434\u0432\u0430\u043b\u0456 \u0431\u043e\u043b\u044c\u0448 \u0456\u043c\u044f \u044f\u0433\u043e&raquo;. \u0410\u043b\u0435 \u0422\u044b, \u041f\u0430\u043d\u0435 \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u044f\u043a\u0456 \u0441\u0443\u0434\u0437\u0456\u0448 \u0441\u043f\u0440\u0430\u0432\u044f\u0434\u043b\u0456\u0432\u0430, \u044f\u043a\u0456 \u0434\u0430\u0441\u043b\u0435\u0434\u0443\u0435\u0448 \u043d\u0443\u0442\u0440\u043e \u0456 \u0441\u044d\u0440\u0446\u0430, \u0434\u0430\u0437\u0432\u043e\u043b\u044c \u043c\u043d\u0435 \u045e\u0431\u0430\u0447\u044b\u0446\u044c \u0422\u0432\u0430\u044e \u043f\u043e\u043c\u0441\u0442\u0443 \u043d\u0430\u0434 \u0456\u043c\u0456, \u0431\u043e \u0422\u0430\u0431\u0435 \u044f \u0434\u0430\u0432\u044f\u0440\u0430\u044e \u0441\u0432\u0430\u044e \u0441\u043f\u0440\u0430\u0432\u0443.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"text-align: justify; color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u041f\u0430\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043c\u044f\u043d\u0435<\/span><span style=\"text-align: justify; color: #ff0000;\">&nbsp;*<\/span><span style=\"text-align: justify;\">&nbsp;\u0430\u0434 \u043f\u0430\u0441\u0442\u043a\u0456 \u043f\u0430\u043b\u044f\u045e\u043d\u0456\u0447\u044b\u0445.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041d.<\/span><span style=\"text-align: justify;\">&nbsp;\u041f\u0430\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043c\u044f\u043d\u0435&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">*<\/span><span style=\"text-align: justify;\">&nbsp;\u0430\u0434 \u043f\u0430\u0441\u0442\u043a\u0456 \u043f\u0430\u043b\u044f\u045e\u043d\u0456\u0447\u044b\u0445.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u0406 \u0430\u0434 \u0437\u043b\u043e\u0433\u0430 \u0441\u043b\u043e\u0432\u0430.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041d.<\/span><span style=\"text-align: justify;\">&nbsp;\u0410\u0434 \u043f\u0430\u0441\u0442\u043a\u0456 \u043f\u0430\u043b\u044f\u045e\u043d\u0456\u0447\u044b\u0445.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u0425\u0432\u0430\u043b\u0430 \u0410\u0439\u0446\u0443 \u0456 \u0421\u044b\u043d\u0443, \u0456 \u0414\u0443\u0445\u0443 \u0421\u0