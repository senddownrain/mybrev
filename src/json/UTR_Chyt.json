\u0415\u0437\u0443\u0441 \u0451\u0441\u0446\u044c \u041f\u0430\u043d\u0430\u043c, \u0456 \u045e \u0441\u044d\u0440\u0446\u044b \u0441\u0432\u0430\u0456\u043c \u0432\u0435\u0440\u044b\u0446\u044c, \u0448\u0442\u043e \u0411\u043e\u0433 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u042f\u0433\u043e \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445, \u0431\u0443\u0434\u0437\u0435\u0448 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u044b. \u0411\u043e \u0441\u044d\u0440\u0446\u0430\u043c \u0432\u0435\u0440\u0430\u0446\u044c \u0434\u043b\u044f \u0430\u043f\u0440\u0430\u045e\u0434\u0430\u043d\u043d\u044f, \u0430 \u0432\u0443\u0441\u043d\u0430\u043c\u0456 \u0432\u044b\u0437\u043d\u0430\u044e\u0446\u044c \u0434\u043b\u044f \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u0417\u0430\u043c\u0435\u0441\u0442 \u0440\u044d\u0441\u043f\u0430\u043d\u0441\u043e\u0440\u044b\u044f \u0433\u0430\u0432\u043e\u0440\u044b\u0446\u0446\u0430:<\/span><br \/><span style=\"color: #ff0000;\">\u0410\u043d\u0442.<\/span> \u0412\u043e\u0441\u044c \u0434\u0437\u0435\u043d\u044c, \u044f\u043a\u0456 \u041f\u0430\u043d \u0443\u0447\u044b\u043d\u0456\u045e, <span style=\"color: #ff0000;\">*<\/span> \u0431\u0443\u0434\u0437\u0435\u043c \u0440\u0430\u0434\u0430\u0432\u0430\u0446\u0446\u0430 \u045e \u0456\u043c \u0456 \u0432\u0435\u0441\u044f\u043b\u0456\u0446\u0446\u0430, <span style=\"color: #ff0000;\">\/<\/span> \u0430\u043b\u043b\u0435\u043b\u044e\u044f.<\/p>\r\n"}, {"UTR_Chyt_ID":"5013","UTR_Chyt_Text":"\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0410\u0415 \u0427\u042b\u0422\u0410\u041d\u041d\u0415 \u0414\u0437 13, 30-33<\/span><br \/>\u0411\u043e\u0433 \u0443\u0432\u0430\u0441\u043a\u0440\u0430\u0441\u0456\u045e \u0415\u0437\u0443\u0441\u0430 \u0437 \u043c\u0451\u0440\u0442\u0432\u044b\u0445. \u0428\u043c\u0430\u0442 \u0434\u0437\u0451\u043d