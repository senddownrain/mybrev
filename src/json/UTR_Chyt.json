0446\u044c \u044f\u0433\u043e \u043d\u0435 \u043d\u0430\u0433\u0430\u0434\u0432\u0430\u043b\u0430 \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439, \u0442\u0430\u043a \u0437\u0434\u0437\u0456\u0432\u0456\u0446\u044c \u0451\u043d \u043c\u043d\u043e\u0433\u0456\u044f \u043d\u0430\u0440\u043e\u0434\u044b, \u043a\u0430\u0440\u0430\u043b\u0456 \u043f\u0435\u0440\u0430\u0434 \u0456\u043c \u0437\u0430\u043a\u0440\u044b\u044e\u0446\u044c \u0432\u0443\u0441\u043d\u044b \u0441\u0432\u0430\u0435, \u0431\u043e \u045e\u0431\u0430\u0447\u0430\u0446\u044c \u044f\u043d\u044b \u0442\u043e\u0435, \u043f\u0440\u0430 \u0448\u0442\u043e \u0456\u043c \u043d\u0435 \u0431\u044b\u043b\u043e \u0441\u043a\u0430\u0437\u0430\u043d\u0430, \u0456 \u0441\u043f\u0430\u0437\u043d\u0430\u044e\u0446\u044c \u0442\u043e\u0435, \u0447\u0430\u0433\u043e \u043d\u0456\u043a\u043e\u043b\u0456 \u043d\u0435 \u0447\u0443\u043b\u0456.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"text-align: justify; color: #ff0000;\">\u041a\u0410\u0420\u041e\u0422\u041a\u0406 \u0420\u042d\u0421\u041f\u0410\u041d\u0421\u041e\u0420\u042b\u0419<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041a.<\/span><span style=\"text-align: justify;\">&nbsp;\u041f\u0430\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043c\u044f\u043d\u0435<\/span><span style=\"text-align: justify; color: #ff0000;\">&nbsp;*<\/span><span style=\"text-align: justify;\">&nbsp;\u0430\u0434 \u043f\u0430\u0441\u0442\u043a\u0456 \u043f\u0430\u043b\u044f\u045e\u043d\u0456\u0447\u044b\u0445.<\/span><br style=\"text-align: justify;\" \/><span style=\"text-align: justify; color: #ff0000;\">\u041d.<\/span><span style=\"text-align: justify;\">&nbsp;\u041f\u0430\u043d \u0432\u044b\u0437\u0432\u0430\u043b\u0456\u0446\u044c \u043c\u044f\u043d\u0435&nbsp;<\/span><span style=\"text-align: justify; color: #ff0000;\">*<\/span><span style=\"text-align: justify;\">&nbsp;\u0430\u0434 \u043f\u0430\u04