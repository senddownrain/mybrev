[
    {
        "Zakl_PS_ID": "1",
        "Zakl_PS_Text1": "\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0441\u0430\u043b\u044c\u043c 95 (94)<\/span><br \/><span style=\"color: #ff0000;\">\u0417\u0430\u0430\u0445\u0432\u043e\u0447\u0432\u0430\u043d\u043d\u0435 \u0434\u0430 \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u044f \u0411\u043e\u0433\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><em>\u041d\u0430\u0441\u0442\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0430\u0434\u0437\u0456\u043d \u0430\u0434\u043d\u0430\u0433\u043e \u0448\u0442\u043e\u0434\u043d\u044f, \u043f\u0430\u043a\u0443\u043b\u044c \u043c\u043e\u0436\u043d\u0430 \u043a\u0430\u0437\u0430\u0446\u044c &laquo;\u0441\u0451\u043d\u043d\u044f&raquo; (\u0413\u0431\u0440 3, 13)<\/em>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u0437\u0430\u0441\u043f\u044f\u0432\u0430\u0435\u043c \u041f\u0430\u043d\u0443, *<br \/>\u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0435\u043c \u0411\u043e\u0433\u0443 &ndash; \u0441\u043a\u0430\u043b\u0435 \u043d\u0430\u0448\u0430\u0433\u0430 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u043d\u0435\u043c \u0437 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u044e \u043f\u0435\u0440\u0430\u0434 \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c \u042f\u0433\u043e\u043d\u044b\u043c, *<br \/>\u0443 \u043f\u0435\u0441\u043d\u044f\u0445 \u0443\u0441\u043a\u043b\u0456\u043a\u043d\u0435\u043c \u042f\u043c\u0443.<\/p>\r\n",
        "Zakl_PS_Text2": "\r\n<p style=\"text-align: justify;\">\u0422\u0430\u043c\u0443 \u0448\u0442\u043e \u0411\u043e\u0433 &ndash; \u0432\u044f\u043b\u0456\u043a\u0456 \u041f\u0430\u043d *<br \/>\u0456 \u0412\u0430\u043b\u0430\u0434\u0430\u0440 \u0432\u044f\u043b\u0456\u043a\u0456 \u043d\u0430\u0434 \u0443\u0441\u0456\u043c\u0456 \u0431\u0430\u0433\u0430\u043c\u0456,<\/p>\r\n<p style=\"text-align: justify;\">\u0443 \u0440\u0443\u0446\u044d \u042f\u0433\u043e\u043d\u0430\u0439 \u0433\u043b\u044b\u0431\u0456\u043d\u0456 \u0437\u044f\u043c\u043b\u0456, *<br \/>\u0456 \u0432\u044f\u0440\u0448\u044b\u043d\u0456 \u0433\u043e\u0440 &ndash; \u042f\u0433\u043e\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u043e\u0440\u0430 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u042f\u043c\u0443, \u0456 \u0401\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u044f\u0433\u043e, *<br \/>\u0456 \u0441\u0443\u0448\u0443 \u0441\u0442\u0432\u0430\u0440\u044b\u043b\u0456 \u042f\u0433\u043e\u043d\u044b\u044f \u0440\u0443\u043a\u0456.<\/p>\r\n",
        "Zakl_PS_Text3": "\r\n<p style=\"text-align: justify;\">\u041f\u0440\u044b\u0439\u0434\u0437\u0456\u0446\u0435, \u043f\u0430\u043a\u043b\u043e\u043d\u0456\u043c\u0441\u044f \u0456 \u045e\u043f\u0430\u0434\u0437\u0435\u043c, *<br \/>\u0443\u043a\u043b\u0435\u043d\u0447\u044b\u043c \u043f\u0435\u0440\u0430\u0434 \u041f\u0430\u043d\u0430\u043c, \u044f\u043a\u0456 \u043d\u0430\u0441 \u0441\u0442\u0432\u0430\u0440\u044b\u045e.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0401\u043d &ndash; \u043d\u0430\u0448 \u0411\u043e\u0433, *<br \/>\u0430 \u043c\u044b &ndash; \u043d\u0430\u0440\u043e\u0434 \u042f\u0433\u043e\u043d\u0430\u0439 \u043f\u0430\u0448\u044b \u0456 \u0430\u0432\u0435\u0447\u043a\u0456 \u0440\u0443\u043a\u0456 \u042f\u0433\u043e\u043d\u0430\u0439.<\/p>\r\n",
        "Zakl_PS_Text4": "\r\n<p style=\"text-align: justify;\">\u041e, \u043a\u0430\u0431 \u0432\u044b \u043f\u0430\u0441\u043b\u0443\u0445\u0430\u043b\u0456 \u0441\u0451\u043d\u043d\u044f \u042f\u0433\u043e\u043d\u044b \u0433\u043e\u043b\u0430\u0441: &dagger;<br \/>&laquo;\u041d\u0435 \u0440\u0430\u0431\u0456\u0446\u0435 \u0436\u043e\u0440\u0441\u0442\u043a\u0456\u043c\u0456 \u0441\u044d\u0440\u0446\u044b \u0432\u0430\u0448\u044b\u044f, *<br \/>\u044f\u043a \u0443 \u041c\u044d\u0440\u044b\u0431\u0435, \u044f\u043a \u043d\u0430 \u043f\u0443\u0441\u0442\u044b\u043d\u0456 \u045e \u0434\u0437\u0435\u043d\u044c \u041c\u0430\u0441\u044b,<\/p>\r\n<p style=\"text-align: justify;\">\u0434\u0437\u0435 \u041c\u044f\u043d\u0435 \u0441\u043f\u0430\u043a\u0443\u0448\u0430\u043b\u0456 \u0430\u0439\u0446\u044b \u0432\u0430\u0448\u044b\u044f, *<br \/>\u0432\u044b\u043f\u0440\u0430\u0431\u043e\u045e\u0432\u0430\u043b\u0456 \u041c\u044f\u043d\u0435, \u0445\u043e\u0446\u044c \u0456 \u0431\u0430\u0447\u044b\u043b\u0456 \u0441\u043f\u0440\u0430\u0432\u044b \u041c\u0430\u0435.<\/p>\r\n",
        "Zakl_PS_Text5": "\r\n<p style=\"text-align: justify;\">\u0421\u043e\u0440\u0430\u043a \u0433\u0430\u0434\u043e\u045e \u0432\u044b\u043a\u043b\u0456\u043a\u0430\u043b\u0430 \u0430\u0433\u0456\u0434\u0443 \u045e\u0432\u0430 \u041c\u043d\u0435 \u0433\u044d\u0442\u0430\u0435 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435, *<br \/>\u0456 \u042f \u0441\u043a\u0430\u0437\u0430\u045e: \u0413\u044d\u0442\u0430 \u043d\u0430\u0440\u043e\u0434, \u044f\u043a\u0456 \u0431\u043b\u0443\u043a\u0430\u0435 \u0441\u044d\u0440\u0446\u0430\u043c,<\/p>\r\n<p style=\"text-align: justify;\">\u044f\u043d\u044b \u043d\u0435 \u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u041c\u0430\u0456\u0445 \u0434\u0430\u0440\u043e\u0433, &dagger;<br \/>\u0442\u0430\u043c\u0443 \u043f\u0430\u043a\u043b\u044f\u045e\u0441\u044f \u042f \u045e \u0433\u043d\u0435\u0432\u0435 \u0441\u0432\u0430\u0456\u043c, *<br \/>\u0448\u0442\u043e \u044f\u043d\u044b \u043d\u0435 \u045e\u0432\u043e\u0439\u0434\u0443\u0446\u044c \u0443 \u041c\u043e\u0439 \u0430\u0434\u043f\u0430\u0447\u044b\u043d\u0430\u043a&raquo;.<\/p>\r\n",
        "Zakl_PS_Text6": "\r\n<p style=\"text-align: justify;\">\u0425\u0432\u0430\u043b\u0430 \u0410\u0439\u0446\u0443 \u0456 \u0421\u044b\u043d\u0443, *<br \/>\u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0431\u044b\u043b\u0430 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443, \u0446\u044f\u043f\u0435\u0440 \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b, *<br \/>\u0456 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n"
    },
    {
        "Zakl_PS_ID": "2",
        "Zakl_PS_Text1": "\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0441\u0430\u043b\u044c\u043c 100 (99)<\/span><br \/><span style=\"color: #ff0000;\">\u0420\u0430\u0434\u0430\u0441\u0446\u044c \u0442\u044b\u0445, \u0445\u0442\u043e \u045e\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u044e<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><em>\u041f\u0430\u043d \u0445\u043e\u0447\u0430, \u043a\u0430\u0431 \u0430\u0434\u043a\u0443\u043f\u043b\u0435\u043d\u044b\u044f \u0441\u043f\u044f\u0432\u0430\u043b\u0456 \u043f\u0435\u0441\u043d\u044e \u043f\u0435\u0440\u0430\u043c\u043e\u0433\u0456 (\u0441\u0432. \u0410\u0442\u0430\u043d\u0430\u0437\u0456\u0439)<\/em>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\">\u0423\u0441\u043a\u043b\u0456\u043a\u0430\u0439 \u041f\u0430\u043d\u0443, \u0443\u0441\u044f \u0437\u044f\u043c\u043b\u044f. *<br \/>\u0417 \u0440\u0430\u0434\u0430\u0441\u0446\u044e \u0441\u043b\u0443\u0436\u044b\u0446\u0435 \u041f\u0430\u043d\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u0421\u0442\u0430\u043d\u044c\u0446\u0435 \u043f\u0435\u0440\u0430\u0434 \u042f\u0433\u043e \u0430\u0431\u043b\u0456\u0447\u0447\u0430\u043c *<br \/>\u0437 \u0440\u0430\u0434\u0430\u0441\u043d\u044b\u043c \u0441\u043f\u0435\u0432\u0430\u043c.<\/p>\r\n",
        "Zakl_PS_Text2": "\r\n<p style=\"text-align: justify;\">\u0412\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0411\u043e\u0433\u0430\u043c, *<br \/>\u0401\u043d \u0441\u0442\u0432\u0430\u0440\u044b\u045e \u043d\u0430\u0441, \u0456 \u043c\u044b \u042f\u0433\u043e\u043d\u044b\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u041c\u044b &ndash; \u042f\u0433\u043e \u043d\u0430\u0440\u043e\u0434 *<br \/>\u0456 \u0430\u0432\u0435\u0447\u043a\u0456 \u042f\u0433\u043e\u043d\u0430\u0439 \u043f\u0430\u0448\u044b.<\/p>\r\n",
        "Zakl_PS_Text3": "\r\n<p style=\"text-align: justify;\">\u0423\u0432\u0430\u0445\u043e\u0434\u0437\u044c\u0446\u0435 \u045e \u0431\u0440\u0430\u043c\u044b \u042f\u0433\u043e \u0437 \u043f\u0430\u0434\u0437\u044f\u043a\u0430\u044e, &dagger;<br \/>\u043d\u0430 \u0434\u0437\u044f\u0434\u0437\u0456\u043d\u0446\u044b \u042f\u0433\u043e\u043d\u044b\u044f \u0437 \u0433\u0456\u043c\u043d\u0430\u043c \u0445\u0432\u0430\u043b\u044b, *<br \/>\u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0439\u0446\u0435 \u042f\u0433\u043e \u0456\u043c\u044f.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u041f\u0430\u043d \u0451\u0441\u0446\u044c \u0434\u043e\u0431\u0440\u044b, &dagger;<br \/>\u043d\u0430\u0432\u0435\u043a\u0456 \u042f\u0433\u043e\u043d\u0430\u044f \u043c\u0456\u043b\u0430\u0441\u044d\u0440\u043d\u0430\u0441\u0446\u044c, *<br \/>\u0456 \u0432\u0435\u0440\u043d\u0430\u0441\u0446\u044c \u042f\u0433\u043e \u0437 \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u044f \u045e \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n",
        "Zakl_PS_Text4": "\r\n<p style=\"text-align: justify;\">\u0425\u0432\u0430\u043b\u0430 \u0410\u0439\u0446\u0443 \u0456 \u0421\u044b\u043d\u0443, *<br \/>\u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0431\u044b\u043b\u0430 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443, \u0446\u044f\u043f\u0435\u0440 \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b, *<br \/>\u0456 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n<p style=\"text-align: justify;\"><span style=\"background-color: transparent;\"><\/span><\/p>\r\n",
        "Zakl_PS_Text5": "",
        "Zakl_PS_Text6": ""
    },
    {
        "Zakl_PS_ID": "3",
        "Zakl_PS_Text1": "\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0441\u0430\u043b\u044c\u043c 67 (66)<\/span><br \/><span style=\"color: #ff0000;\">\u041d\u044f\u0445\u0430\u0439 \u0443\u0441\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0440\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u044e\u0446\u044c \u041f\u0430\u043d\u0430<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><em>\u0412\u0435\u0434\u0430\u0439\u0446\u0435, \u0448\u0442\u043e \u0433\u044d\u0442\u0430 \u0411\u043e\u0436\u0430\u0435 \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u043f\u0430\u0441\u043b\u0430\u043d\u0430 \u0434\u0430 \u044f\u0437\u044b\u0447\u043d\u0456\u043a\u0430\u045e (\u0414\u0437 28, 28)<\/em>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0411\u043e\u0433 \u0437\u043c\u0456\u043b\u0443\u0435\u0446\u0446\u0430 \u043d\u0430\u0434 \u043d\u0430\u043c\u0456 \u0456 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u0432\u0456\u0446\u044c \u043d\u0430\u0441, *<br \/>\u043d\u044f\u0445\u0430\u0439 \u0437\u0430\u0437\u0437\u044f\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u042f\u0433\u043e \u043d\u0430\u0434 \u043d\u0430\u043c\u0456,<\/p>\r\n<p style=\"text-align: justify;\">\u043a\u0430\u0431 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043c\u044b \u0441\u043f\u0430\u0437\u043d\u0430\u043b\u0456 \u042f\u0433\u043e\u043d\u0443\u044e \u0434\u0430\u0440\u043e\u0433\u0443, *<br \/>\u043c\u0456\u0436 \u0443\u0441\u0456\u043c\u0456 \u043d\u0430\u0440\u043e\u0434\u0430\u043c\u0456 \u042f\u0433\u043e \u0437\u0431\u0430\u045e\u043b\u0435\u043d\u043d\u0435.<\/p>\r\n",
        "Zakl_PS_Text2": "\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0441\u043b\u0430\u0432\u044f\u0446\u044c \u0426\u044f\u0431\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0411\u043e\u0436\u0430, *<br \/>\u043d\u044f\u0445\u0430\u0439 \u0441\u043b\u0430\u0432\u044f\u0446\u044c \u0426\u044f\u0431\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u045e\u0441\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0432\u0435\u0441\u044f\u043b\u044f\u0446\u0446\u0430 \u0456 \u0440\u0430\u0434\u0443\u044e\u0446\u0446\u0430 \u045e\u0441\u0435 \u043f\u043b\u044f\u043c\u0451\u043d\u044b, &dagger;<br \/>\u0431\u043e \u0422\u044b \u0441\u0443\u0434\u0437\u0456\u0448 \u043d\u0430\u0440\u043e\u0434\u044b \u043f\u0430\u0432\u043e\u0434\u043b\u0435 \u043f\u0440\u0430\u045e\u0434\u044b *<br \/>\u0456 \u043f\u043b\u044f\u043c\u0451\u043d\u0430\u043c\u0456 \u043d\u0430 \u0437\u044f\u043c\u043b\u0456 \u043a\u0456\u0440\u0443\u0435\u0448.<\/p>\r\n",
        "Zakl_PS_Text3": "\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0441\u043b\u0430\u0432\u044f\u0446\u044c \u0426\u044f\u0431\u0435 \u043d\u0430\u0440\u043e\u0434\u044b, \u0411\u043e\u0436\u0430, *<br \/>\u043d\u044f\u0445\u0430\u0439 \u0441\u043b\u0430\u0432\u044f\u0446\u044c \u0426\u044f\u0431\u0435 \u043d\u0430\u0440\u043e\u0434\u044b \u045e\u0441\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u0417\u044f\u043c\u043b\u044f \u043f\u0440\u044b\u043d\u0435\u0441\u043b\u0430 \u0441\u0432\u043e\u0439 \u043f\u043b\u0451\u043d; *<br \/>\u043d\u044f\u0445\u0430\u0439 \u0411\u043e\u0433, \u043d\u0430\u0448 \u0411\u043e\u0433 \u043d\u0430\u0441 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435.<\/p>\r\n<p style=\"text-align: justify;\">\u041d\u044f\u0445\u0430\u0439 \u0411\u043e\u0433 \u043d\u0430\u0441 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u044f\u0435, *<br \/>\u043d\u044f\u0445\u0430\u0439 \u0431\u0430\u044f\u0446\u0446\u0430 \u042f\u0433\u043e \u045e\u0441\u0435 \u043c\u0435\u0436\u044b \u0437\u044f\u043c\u043b\u0456.<\/p>\r\n",
        "Zakl_PS_Text4": "\r\n<p style=\"text-align: justify;\">\u0425\u0432\u0430\u043b\u0430 \u0410\u0439\u0446\u0443 \u0456 \u0421\u044b\u043d\u0443, *<br \/>\u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0431\u044b\u043b\u0430 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443, \u0446\u044f\u043f\u0435\u0440 \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b, *<br \/>\u0456 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.<\/p>\r\n",
        "Zakl_PS_Text5": "",
        "Zakl_PS_Text6": ""
    },
    {
        "Zakl_PS_ID": "4",
        "Zakl_PS_Text1": "\r\n<p style=\"text-align: center;\"><span style=\"color: #ff0000;\">\u041f\u0441\u0430\u043b\u044c\u043c 24 (23)<\/span><br \/><span style=\"color: #ff0000;\">\u041f\u0430\u043d \u0443\u0432\u0430\u0445\u043e\u0434\u0437\u0456\u0446\u044c \u0443 \u0441\u0432\u044f\u0442\u044b\u043d\u044e<\/span><\/p>\r\n<p style=\"text-align: justify;\"><span style=\"color: #ff0000;\"><\/span><em>\u0411\u0440\u0430\u043c\u044b \u043d\u044f\u0431\u0451\u0441\u0430\u045e \u0430\u0434\u0447\u044b\u043d\u0456\u043b\u0456\u0441\u044f \u0434\u043b\u044f \u0425\u0440\u044b\u0441\u0442\u0430 \u0434\u0437\u0435\u043b\u044f \u045e\u0437\u0432\u044b\u0448\u044d\u043d\u043d\u044f \u042f\u0433\u043e \u0447\u0430\u043b\u0430\u0432\u0435\u0447\u0430\u0439 \u043d\u0430\u0442\u0443\u0440\u044b (\u0441\u0432. \u0406\u0440\u044d\u043d\u044d\u0439)<\/em>&nbsp;<\/p>\r\n<p style=\"text-align: justify;\">\u041f\u0430\u043d\u0443 \u043d\u0430\u043b\u0435\u0436\u044b\u0446\u044c \u0437\u044f\u043c\u043b\u044f \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u043d\u0430 \u0451\u0439, *<br \/>\u0441\u0443\u0441\u0432\u0435\u0442 \u0456 \u045e\u0441\u0451, \u0448\u0442\u043e \u0436\u044b\u0432\u0435 \u045e \u0456\u043c.<\/p>\r\n<p style=\"text-align: justify;\">\u0411\u043e \u0401\u043d \u0437\u0430\u0441\u043d\u0430\u0432\u0430\u045e \u044f\u0433\u043e \u043d\u0430 \u043c\u043e\u0440\u0430\u0445 *<br \/>\u0456 \u043d\u0430 \u0440\u044d\u043a\u0430\u0445 \u0443\u043c\u0430\u0446\u0430\u0432\u0430\u045e \u044f\u0433\u043e.<\/p>\r\n",
        "Zakl_PS_Text2": "\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u045e\u0437\u044b\u0434\u0437\u0435 \u043d\u0430 \u0433\u0430\u0440\u0443 \u041f\u0430\u043d\u0430, *<br \/>\u0456 \u0445\u0442\u043e \u0441\u0442\u0430\u043d\u0435 \u043d\u0430 \u0441\u0432\u044f\u0442\u044b\u043c \u043c\u0435\u0441\u0446\u044b \u042f\u0433\u043e\u043d\u044b\u043c?<\/p>\r\n<p style=\"text-align: justify;\">\u0422\u043e\u0439, \u0443 \u043a\u0430\u0433\u043e \u0440\u0443\u043a\u0456 \u0431\u044f\u0437\u0432\u0456\u043d\u043d\u044b\u044f \u0456 \u0447\u044b\u0441\u0442\u0430\u0435 \u0441\u044d\u0440\u0446\u0430, &dagger;<br \/>\u0445\u0442\u043e \u043d\u0435 \u0441\u0445\u0456\u043b\u044f\u045e \u0434\u0443\u0448\u044b \u0434\u0430 \u043c\u0430\u0440\u043d\u0430\u0441\u0446\u0456 *<br \/>\u0456 \u043d\u0435 \u043f\u0440\u044b\u0441\u044f\u0433\u0430\u045e \u0444\u0430\u043b\u044c\u0448\u044b\u0432\u0430.<\/p>\r\n",
        "Zakl_PS_Text3": "\r\n<p style=\"text-align: justify;\">\u0401\u043d \u0430\u0442\u0440\u044b\u043c\u0430\u0435 \u0431\u043b\u0430\u0433\u0430\u0441\u043b\u0430\u045e\u043b\u0435\u043d\u043d\u0435 \u0430\u0434 \u041f\u0430\u043d\u0430 *<br \/>\u0456 \u045e\u0437\u043d\u0430\u0433\u0430\u0440\u043e\u0434\u0443 &ndash; \u0430\u0434 \u0411\u043e\u0433\u0430, \u0441\u0432\u0430\u0439\u0433\u043e \u0417\u0431\u0430\u045e\u0446\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0412\u043e\u0441\u044c \u043f\u0430\u043a\u0430\u043b\u0435\u043d\u043d\u0435 \u0442\u044b\u0445, \u0445\u0442\u043e \u042f\u0433\u043e \u0448\u0443\u043a\u0430\u0435, *<br \/>\u0445\u0442\u043e \u0448\u0443\u043a\u0430\u0435 \u0430\u0431\u043b\u0456\u0447\u0447\u0430 \u0422\u0432\u0430\u0439\u0433\u043e, \u0411\u043e\u0433 \u042f\u043a\u0443\u0431\u0430.<\/p>\r\n",
        "Zakl_PS_Text4": "\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u044b\u043c\u0456\u0446\u0435 \u0432\u044f\u0440\u0445\u0456 \u0432\u0430\u0448\u044b\u044f, \u0431\u0440\u0430\u043c\u044b, &dagger;<br \/>\u0443\u0437\u043d\u0456\u043c\u0456\u0446\u0435\u0441\u044f, \u0430\u0434\u0432\u0435\u0447\u043d\u044b\u044f \u0432\u0430\u0440\u043e\u0442\u044b, *<br \/>\u043a\u0430\u0431 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0436 \u0433\u044d\u0442\u044b \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u043b\u0430\u0432\u044b? &dagger;<br \/>\u041f\u0430\u043d, \u043c\u043e\u0446\u043d\u044b \u0456 \u043c\u0430\u0433\u0443\u0442\u043d\u044b, *<br \/>\u041f\u0430\u043d, \u043c\u0430\u0433\u0443\u0442\u043d\u044b \u045e \u0431\u0430\u0440\u0430\u0446\u044c\u0431\u0435.<\/p>\r\n",
        "Zakl_PS_Text5": "\r\n<p style=\"text-align: justify;\">\u041f\u0430\u0434\u044b\u043c\u0456\u0446\u0435 \u0432\u044f\u0440\u0445\u0456 \u0432\u0430\u0448\u044b\u044f, \u0431\u0440\u0430\u043c\u044b, &dagger;<br \/>\u0443\u0437\u043d\u0456\u043c\u0456\u0446\u0435\u0441\u044f, \u0430\u0434\u0432\u0435\u0447\u043d\u044b\u044f \u0432\u0430\u0440\u043e\u0442\u044b, *<br \/>\u043a\u0430\u0431 \u0443\u0432\u0430\u0439\u0448\u043e\u045e \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n<p style=\"text-align: justify;\">\u0425\u0442\u043e \u0401\u043d, \u0433\u044d\u0442\u044b \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u043b\u0430\u0432\u044b? *<br \/>\u041f\u0430\u043d \u041c\u0430\u0433\u0443\u0446\u0446\u044f\u045e, \u0401\u043d \u041a\u0430\u0440\u043e\u043b\u044c \u0441\u043b\u0430\u0432\u044b.<\/p>\r\n",
        "Zakl_PS_Text6": "\r\n<p style=\"text-align: justify;\">\u0425\u0432\u0430\u043b\u0430 \u0410\u0439\u0446\u0443 \u0456 \u0421\u044b\u043d\u0443, *<br \/>\u0456 \u0414\u0443\u0445\u0443 \u0421\u0432\u044f\u0442\u043e\u043c\u0443.<\/p>\r\n<p style=\"text-align: justify;\">\u042f\u043a \u0431\u044b\u043b\u0430 \u0441\u043f\u0440\u0430\u0434\u0432\u0435\u043a\u0443, \u0446\u044f\u043f\u0435\u0440 \u0456 \u0437\u0430\u045e\u0441\u0451\u0434\u044b, *<br \/>\u0456 \u043d\u0430 \u0432\u0435\u043a\u0456 \u0432\u0435\u0447\u043d\u044b\u044f. \u0410\u043c\u044d\u043d.&nbsp;<\/p>"
    }
